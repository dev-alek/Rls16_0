     2484   procedure xmllib-clear-parse-data :
     2485   do
     2486   on error undo, return error
     2487   :
     2488       empty temp-table temp_xmllib_rec-list.
     2489       empty temp-table temp_xmllib_rec-fld-list.
     2490       empty temp-table temp_xmllib_rec.
     2491       empty temp-table temp_xmllib_rec-fld.
     2492   end.
     2493   end procedure.
     2494   procedure xmllib-add-rec-fld :
     2495   define input parameter p-rec-name       as character        no-undo.
     2496   define input parameter p-rec-fld-name   as character        no-undo.
     2497       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2498       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2499   do
     2500   for buf_rec-list
     2501     , buf_rec-fld-list
     2502   on error undo, return error
     2503   :
     2504       find first buf_rec-list
     2505            where buf_rec-list.recName = p-rec-name
     2506       no-error.
     2507       if not available buf_rec-list
     2508       then do:
     2509           create buf_rec-list.
     2510           assign
     2511               buf_rec-list.recName        = p-rec-name
     2512               buf_rec-list.recOpenLine    = 0
     2513               buf_rec-list.recCloseLine   = 0
     2514               buf_rec-list.closed         = yes
     2515           .
     2516       end.
     2517       find first buf_rec-fld-list
     2518            where buf_rec-fld-list.recName = p-rec-name
     2519              and buf_rec-fld-list.fldName = p-rec-fld-name
     2520       no-error.
     2521       if not available buf_rec-fld-list
     2522       then do:
     2523           create buf_rec-fld-list.
     2524           assign
     2525               buf_rec-fld-list.recName        = p-rec-name
     2526               buf_rec-fld-list.fldName        = p-rec-fld-name
     2527               buf_rec-fld-list.fldOpenLine    = 0
     2528               buf_rec-fld-list.fldCloseLine   = 0
     2529               buf_rec-fld-list.closed         = yes
     2530           .
     2531       end.
     2532   end.
     2533   end procedure.
     2534   procedure xmllib-tag-open:
     2535   define input parameter v-tag-level  as integer      no-undo.
     2536   define input parameter v-tag-name   as character    no-undo.
     2537   define input parameter v-tag-value  as character    no-undo.
     2538   do
     2539   on error undo, return error
     2540   :
     2541       assign
     2542           v-tag-name = trim( v-tag-name )
     2543       .
     2544       put stream stmXMLOut unformatted
     2545           substitute( "&1&2<&3&4&5>"
     2546               , chr(10)
     2547               , fill(" ", 4 * v-tag-level)
     2548               , v-tag-name
     2549               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     2550               , v-tag-value
     2551           )
     2552       .
     2553   end.
     2554   end procedure.
     2555   procedure xmllib-tag-put:
     2556   define input parameter v-tag-level      as integer      no-undo.
     2557   define input parameter v-tag-name       as character    no-undo.
     2558   define input parameter v-tag-value      as character    no-undo.
     2559   define input parameter v-empty-mode     as integer      no-undo.
     2560   do
     2561   on error undo, return error
     2562   :
     2563       assign
     2564           v-tag-name = trim( v-tag-name )
     2565       .
     2566       if  v-empty-mode = 1
     2567       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     2568       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     2569       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     2570       then do:
     2571           run xmlchar-encode in this-procedure (
     2572                 input v-tag-value
     2573               , output v-tag-value
     2574           ).
     2575           put stream stmXMLOut unformatted
     2576               substitute( "&1&2<&3>&4</&3>"
     2577                   , chr(10)
     2578                   , fill(" ":U, 4 * v-tag-level)
     2579                   , v-tag-name
     2580                   , v-tag-value
     2581               )
     2582           .
     2583       end.
     2584   end.
     2585   end procedure.
     2586   procedure xmllib-tag-put-null :
     2587   define input parameter p-tag-level  as integer      no-undo.
     2588   define input parameter p-tag-name   as character    no-undo.
     2589   do
     2590   on error undo, return error
     2591   :
     2592       assign
     2593           p-tag-name = trim( p-tag-name )
     2594       .
     2595       put stream stmXMLOut unformatted
     2596           substitute( '&1&2<&3 nil="true" /&3>'
     2597               , chr(10)
     2598               , fill(" ":U, 4 * p-tag-level)
     2599               , p-tag-name
     2600           )
     2601       .
     2602   end.
     2603   end procedure.
     2604   procedure xmllib-tag-close:
     2605   define input parameter v-tag-level as integer      no-undo.
     2606   define input parameter v-tag-name  as character    no-undo.
     2607   do
     2608   on error undo, return error
     2609   :
     2610       assign
     2611           v-tag-name = trim( v-tag-name )
     2612       .
     2613       put stream stmXMLOut unformatted
     2614           substitute( "&1&2</&3>"
     2615               , chr(10)
     2616               , fill( " ":U, 4 * v-tag-level)
     2617               , v-tag-name
     2618           )
     2619       .
     2620   end.
     2621   end procedure.
     2622   procedure xmllib-write-log:
     2623   define input parameter v-filename   as character    no-undo.
     2624   define input parameter v-log-level  as integer      no-undo.
     2625   define input parameter v-out-string as character    no-undo.
     2626   do
     2627   on error undo, return error
     2628   :
     2629       output stream stmXMLLog to value( v-filename ) append.
     2630       put stream stmXMLLog unformatted
     2631           chr(10)
     2632       .
     2633       put stream stmXMLLog unformatted
     2634           ( if v-log-level = 0
     2635             or v-out-string = "&DLine":U
     2636             or v-out-string = "&Line":U
     2637             then "":U
     2638             else cur-time-string-sec() + " ":U )
     2639       .
     2640       put stream stmXMLLog unformatted
     2641           ( if v-out-string = "&Line":U
     2642             then fill( "-":U, 80 )
     2643             else if v-out-string = "&DLine":U
     2644                  then fill( "=":U, 80 )
     2645                  else v-out-string )
     2646       .
     2647       output stream stmXMLLog close.
     2648   end.
     2649   end procedure.
     2650   procedure xmllib-write-edt:
     2651   define input parameter v-editor-handle    as handle       no-undo.
     2652   define input parameter v-log-level        as integer      no-undo.
     2653   define input parameter v-out-string       as character    no-undo.
     2654   do
     2655   on error undo, return error
     2656   :
     2657       if valid-handle ( v-editor-handle )
     2658       then do:
     2659           v-editor-handle :move-to-eof().
     2660           v-editor-handle :insert-string( ( if v-log-level = 0
     2661                                             or v-out-string = "&DLine":U
     2662                                             or v-out-string = "&Line":U
     2663                                             then "":U
     2664                                             else cur-time-string-sec() + " ":U
     2665                                         ) ).
     2666           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     2667                                             then fill( "-":U, 80 )
     2668                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     2669                                             else fill( " ":U, v-log-level) + v-out-string
     2670                                         ) ).
     2671           v-editor-handle :insert-string( chr(10) ).
     2672       end.
     2673   end.
     2674   end procedure.
     2675   procedure xmllib-show-cnt:
     2676   define input parameter v-fillin-handle     as handle   no-undo.
     2677   do
     2678   on error undo, return error
     2679   :
     2680       if valid-handle( v-fillin-handle )
     2681       then do:
     2682           assign
     2683               v-fillin-handle :visible = true
     2684           .
     2685       end.
     2686   end.
     2687   end procedure.
     2688   procedure xmllib-hide-cnt:
     2689   define input parameter v-fillin-handle     as handle   no-undo.
     2690   do
     2691   on error undo, return error
     2692   :
     2693       if valid-handle( v-fillin-handle )
     2694       then do:
     2695           assign v-fillin-handle :visible = false.
     2696       end.
     2697   end.
     2698   end procedure.
     2699   procedure xmllib-write-cnt:
     2700   define input parameter v-fillin-handle    as handle       no-undo.
     2701   define input parameter v-fillin-string    as character    no-undo.
     2702   do
     2703   on error undo, return error
     2704   :
     2705       if valid-handle( v-fillin-handle )
     2706       then do:
     2707           assign
     2708               v-fillin-handle :SCREEN-value = v-fillin-string
     2709           .
     2710       end.
     2711   end.
     2712   end procedure.
     2713   procedure xmllib-write-header:
     2714   define input parameter p-first-file     as logical      no-undo.
     2715   define input parameter p-xml-file-name  as character    no-undo.
     2716   define input parameter p-list-file-name as character    no-undo.
     2717   define input parameter p-file-number    as integer      no-undo.
     2718   define input parameter p-have-prev      as logical      no-undo.
     2719   define input parameter p-prev-filename  as character    no-undo.
     2720   define input parameter p-parameter-list as character    no-undo.
     2721       define variable v-counter    as integer        no-undo.
     2722   do
     2723   on error undo, return error
     2724   :
     2725       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2726       put stream stmXMLOut unformatted
     2727           "<?xml version='1.0' encoding='windows-1251'?>"
     2728       .
     2729       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2730       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2731       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2732       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2733       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2734       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2735       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2736       :
     2737           run xmllib-tag-put(
     2738                 input 1
     2739               , input entry( 2 * v-counter, p-parameter-list )
     2740               , input entry( 2 * v-counter + 1, p-parameter-list )
     2741               , input 0
     2742           ).
     2743       end.
     2744       run xmllib-tag-close( input 0, input "THheader" ).
     2745       output stream stmXMLOut close.
     2746       if p-list-file-name <> "":U
     2747       then do:
     2748           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2749           if p-first-file = yes
     2750           then do:
     2751               put stream stmXMLOut unformatted
     2752                   "<?xml version='1.0' encoding='windows-1251'?>"
     2753               .
     2754               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2755           end.
     2756           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2757           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2758           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2759           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2760           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2761           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2762           :
     2763               run xmllib-tag-put(
     2764                   input 2
     2765                   , input entry( 2 * v-counter, p-parameter-list )
     2766                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2767                   , input 0
     2768               ).
     2769           end.
     2770           run xmllib-tag-close( input 1, input "THfile" ).
     2771           output stream stmXMLOut close.
     2772       end.
     2773   end.
     2774   end procedure.
     2775   procedure xmllib-write-footer:
     2776   define input parameter p-last-file      as logical      no-undo.
     2777   define input parameter p-xml-file-name  as character    no-undo.
     2778   define input parameter p-list-file-name as character    no-undo.
     2779   define input parameter p-have-next      as logical      no-undo.
     2780   define input parameter p-next-file-name as character    no-undo.
     2781       define variable v-error-num     as integer           no-undo.
     2782   do
     2783   on error undo, return error
     2784   :
     2785       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2786       if p-have-next = yes
     2787       then do:
     2788           run xmllib-tag-open( input 0, input "footer", "" ).
     2789           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2790           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2791           run xmllib-tag-close( input 0, input "footer" ).
     2792       end.
     2793       run xmllib-tag-close( input 0, input "root" ).
     2794       output stream stmXMLOut close.
     2795       run bge/os_copy.p (
     2796             input "M"
     2797           , input p-xml-file-name + "tmp"
     2798           , input p-xml-file-name + "xml"
     2799           , output v-error-num
     2800       ).
     2801       if p-last-file = yes
     2802       and p-list-file-name <> "":U
     2803       then do:
     2804           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2805               run xmllib-tag-close( input 0, input "OpenXML" ).
     2806           output stream stmXMLOut close.
     2807           run bge/os_copy.p (
     2808                 input "M"
     2809               , input p-list-file-name + "tmp"
     2810               , input p-list-file-name + "xml":U
     2811               , output v-error-num
     2812           ).
     2813       end.
     2814   end.
     2815   end procedure.
     2816   procedure xmllib-filename :
     2817   define input parameter p-subdir             as character        no-undo.
     2818   define input parameter p-prefix             as character    no-undo.
     2819   define output parameter p-xml-file-name     as character    no-undo.
     2820   define output parameter p-log-file-name     as character    no-undo.
     2821   define output parameter p-list-file-name    as character    no-undo.
     2822       define variable v-home-dir  as character    no-undo.
     2823       define variable v-error-num as integer      no-undo.
     2824   do
     2825   on error undo, return error
     2826   :
     2827       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2828       if v-home-dir = ?
     2829       then do:
     2830           message
     2831             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2832             skip "Нет параметра oxml-dir в секции [OXML]."
     2833             skip(1)
     2834             skip "Обратитесь к администратору."
     2835           view-as alert-box error.
     2836           undo, return error .
     2837       end.
     2838       if p-subdir <> "":U
     2839       then do:
     2840           assign
     2841               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2842           .
     2843       end.
     2844       run gbl/dir-cre.p (
     2845           input v-home-dir
     2846       ) no-error.
     2847       if error-status :error
     2848       then do:
     2849           message
     2850             skip "Неверно задан каталог экспорта в ini-файле."
     2851             skip "Не удаётся создать каталог, указанный параметром"
     2852             skip "oxml-dir в секции [OXML]."
     2853             skip(1)
     2854             skip "Обратитесь к администратору."
     2855           view-as alert-box error.
     2856           undo, return error .
     2857       end.
     2858       run bge/genfname.p (
     2859             input v-home-dir
     2860           , input p-prefix
     2861           , input ""
     2862           , input "xml"
     2863           , input "tmp"
     2864           , output p-xml-file-name
     2865       ).
     2866       assign
     2867           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2868           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2869           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2870       .
     2871   end.
     2872   end procedure.
     2873   procedure xmllib-check-file-size :
     2874   define input parameter p-out-filename   as character    no-undo.
     2875   define output parameter p-is-big        as logical      no-undo.
     2876       define variable v-current-position    as integer        no-undo.
     2877   do
     2878   on error undo, return error
     2879   :
     2880       assign
     2881           v-current-position = seek( stmXMLOut )
     2882       .
     2883       if v-current-position / 1024 / 1024  >= 100
     2884       then do:
     2885           assign
     2886               p-is-big = yes
     2887           .
     2888       end.
     2889   end.
     2890   end procedure.
     2891   procedure xmllib-parse-file :
     2892   define input parameter p-full-filename      as character        no-undo.
     2893       define variable v-num-dirs              as integer      no-undo .
     2894       define variable v-str                   as character    no-undo .
     2895       define variable v-str-count             as int64        no-undo .
     2896   do
     2897   on error undo, return error
     2898   :
     2899       assign
     2900           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2901           v-xmllib-error-status   = no
     2902       .
     2903       if v-num-dirs > 1
     2904       then do:
     2905           assign
     2906               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2907               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2908           .
     2909       end.
     2910       else do:
     2911           assign
     2912               v-xmllib-filename = p-full-filename
     2913               v-xmllib-dirname  = "":U
     2914           .
     2915       end.
     2916       if valid-handle(v-xmllib-prg-bar-handle)
     2917       then do:
     2918   if session :set-wait-state( "compiler" ) then.
     2919         input stream strXMLIn from value(p-full-filename) .
     2920         repeat
     2921         :
     2922           import stream strXMLIn unformatted v-str no-error .
     2923           assign
     2924             v-str-count = v-str-count + 1
     2925           .
     2926         end.
     2927         input stream strXMLIn close .
     2928   if session :set-wait-state( "" ) then.
     2929         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2930         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2931         run prg-bar_show in this-procedure .
     2932       end.
     2933       create sax-reader v-xmllib-sax-reader-handle.
     2934       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2935       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2936       if error-status :error
     2937       then do:
     2938           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2939                                                                       ,vss-workfile
     2940                                                                       ,vss-revision
     2941                                                                       ,vss-description
     2942                                                                       ,chr(10)
     2943                                                                       ,return-value
     2944                                                                       ,trim(error-status :get-message(1))
     2945                                                                       ,trim(error-status :get-message(2))
     2946                                                                       ,trim(error-status :get-message(3)))
     2947                                                     ).
     2948           undo, return error .
     2949       end.
     2950       if v-xmllib-error-status <> no
     2951       then do:
     2952           run xmllib-parse-error in this-procedure (
     2953               input "*** При обработке XML файла были ошибки."
     2954           ).
     2955           delete object v-xmllib-sax-reader-handle.
     2956       end.
     2957       delete object v-xmllib-sax-reader-handle.
     2958       if valid-handle(v-xmllib-prg-bar-handle)
     2959       then do:
     2960         run prg-bar_delete in this-procedure .
     2961       end.
     2962   end.
     2963   end procedure.
     2964   procedure xmllib-parse-progressive :
     2965   define input parameter p-full-filename      as character no-undo .
     2966   define input parameter p-pack-data          as memptr no-undo .
     2967   define input parameter p-parse-first        as logical no-undo .
     2968   define input parameter p-first-err          as logical no-undo .
     2969   define output parameter p-parse-status as integer no-undo .
     2970   define variable v-num-dirs              as integer no-undo .
     2971   define variable glog                    as logical no-undo .
     2972   define variable v-pack-size             as int64 no-undo .
     2973   do
     2974   on error undo, return error
     2975   :
     2976     if p-parse-first then do:
     2977       if valid-handle(v-xmllib-sax-reader-handle)
     2978       then do:
     2979       end.
     2980       assign
     2981           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2982           v-xmllib-error-status   = no
     2983       .
     2984       if v-num-dirs > 1
     2985       then do:
     2986           assign
     2987               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2988               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2989           .
     2990       end.
     2991       else do:
     2992           assign
     2993               v-xmllib-filename = p-full-filename
     2994               v-xmllib-dirname  = "":U
     2995           .
     2996       end.
     2997       create sax-reader v-xmllib-sax-reader-handle.
     2998       v-pack-size = get-size (p-pack-data) .
     2999       if v-pack-size > 0 then
     3000         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     3001       else
     3002         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     3003       if error-status :error
     3004       or not glog
     3005       then do:
     3006         delete object v-xmllib-sax-reader-handle.
     3007         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3008                                                                     ,vss-workfile
     3009                                                                     ,vss-revision
     3010                                                                     ,vss-description
     3011                                                                     ,chr(10)
     3012                                                                     ,return-value
     3013                                                                     ,trim(error-status :get-message(1))
     3014                                                                     ,trim(error-status :get-message(2))
     3015                                                                     ,trim(error-status :get-message(3)) )
     3016                                                   ).
     3017         undo, return error .
     3018       end.
     3019       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     3020     end.
     3021     else do:
     3022       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     3023     end.
     3024     if error-status :error
     3025     then do:
     3026       delete object v-xmllib-sax-reader-handle.
     3027       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3028                                                                   ,vss-workfile
     3029                                                                   ,vss-revision
     3030                                                                   ,vss-description
     3031                                                                   ,chr(10)
     3032                                                                   ,return-value
     3033                                                                   ,trim(error-status :get-message(1))
     3034                                                                   ,trim(error-status :get-message(2))
     3035                                                                   ,trim(error-status :get-message(3)) )
     3036                                                 ).
     3037       undo, return error .
     3038     end.
     3039     if v-xmllib-error-status <> no
     3040     then do:
     3041       run xmllib-parse-error in this-procedure (
     3042           input "*** При обработке XML файла были ошибки."
     3043       ).
     3044       if p-first-err then do:
     3045         delete object v-xmllib-sax-reader-handle.
     3046       end.
     3047       else do:
     3048         v-xmllib-error-status = no.
     3049       end.
     3050     end.
     3051     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     3052       p-parse-status = SAX-COMPLETE.
     3053       delete object v-xmllib-sax-reader-handle.
     3054       return '':U.
     3055     end.
     3056     else do:
     3057       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     3058       return '':U.
     3059     end.
     3060   end.
     3061   end procedure.
     3062   procedure StartElement :
     3063   define input parameter p-name-space     as character        no-undo.
     3064   define input parameter p-local-name     as character        no-undo.
     3065   define input parameter p-q-name         as character        no-undo.
     3066   define input parameter p-attributes     as handle           no-undo.
     3067       define buffer buf_rec             for temp_xmllib_rec.
     3068       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3069       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3070       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3071   do
     3072   for buf_rec
     3073     , buf_rec-fld
     3074     , buf_rec-list
     3075     , buf_rec-fld-list
     3076   on error undo, return error
     3077   :
     3078       if valid-handle(v-xmllib-prg-bar-handle)
     3079       then do:
     3080         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     3081       end.
     3082       find first buf_rec-list
     3083            where buf_rec-list.recName = p-q-name
     3084       no-error.
     3085       if available buf_rec-list
     3086       then do:
     3087           if buf_rec-list.closed = no
     3088           then do:
     3089               find first buf_rec-fld-list
     3090                    where buf_rec-fld-list.recName = buf_rec-list.recName
     3091                      and buf_rec-fld-list.fldName = p-q-name
     3092               no-error.
     3093               if available buf_rec-fld-list
     3094               and buf_rec-list.recName = buf_rec-fld-list.recName
     3095               then do:
     3096                   if buf_rec-fld-list.closed = no
     3097                   then do:
     3098                       run xmllib-parse-error in this-procedure (
     3099                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     3100                                           , p-q-name
     3101                                           , p-q-name
     3102                                           , buf_rec-fld-list.fldOpenLine
     3103                                           )
     3104                       ).
     3105                   end.
     3106                   else do:
     3107                       run xmllib-parse-rec-fld-open in this-procedure (
     3108                             input buf_rec-list.recName
     3109                           , input buf_rec-list.recLevel
     3110                           , input buf_rec-fld-list.fldName
     3111                       ).
     3112                       assign
     3113                           buf_rec-fld-list.closed         = no
     3114                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3115                           buf_rec-fld-list.fldCloseLine   = 0
     3116                       .
     3117                   end.
     3118               end.
     3119               else do:
     3120                   assign
     3121                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     3122                   .
     3123                   run xmllib-parse-rec-open in this-procedure (
     3124                         input buf_rec-list.recName
     3125                       , input buf_rec-list.recLevel
     3126                   ).
     3127                   assign
     3128                       buf_rec-list.closed         = no
     3129                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3130                       buf_rec-list.recCloseLine   = 0
     3131                   .
     3132               end.
     3133           end.
     3134           else do:
     3135               run xmllib-parse-rec-open in this-procedure (
     3136                     input buf_rec-list.recName
     3137                   , input buf_rec-list.recLevel
     3138               ).
     3139               assign
     3140                   buf_rec-list.closed         = no
     3141                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3142                   buf_rec-list.recCloseLine   = 0
     3143               .
     3144           end.
     3145       end.
     3146       else do:
     3147           open-record:
     3148           for each buf_rec-fld-list
     3149              where buf_rec-fld-list.fldName = p-q-name
     3150           :
     3151               find first buf_rec-list
     3152                    where buf_rec-list.recName = buf_rec-fld-list.recName
     3153                      and buf_rec-list.closed  = no
     3154               no-error.
     3155               if available buf_rec-list
     3156               then do:
     3157                   run xmllib-parse-rec-fld-open in this-procedure (
     3158                         input buf_rec-list.recName
     3159                       , input buf_rec-list.recLevel
     3160                       , input buf_rec-fld-list.fldName
     3161                   ).
     3162                   assign
     3163                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     3164                       buf_rec-fld-list.closed         = no
     3165                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3166                       buf_rec-fld-list.fldCloseLine   = 0
     3167                   .
     3168                   leave open-record.
     3169               end.
     3170           end.
     3171       end.
     3172   end.
     3173   end procedure.
     3174   procedure Characters :
     3175   define input parameter p-char-data  as memptr.
     3176   define input parameter p-numchars   as integer.
     3177       define variable v-data-string    as character    no-undo.
     3178       define variable v-cp-utf8           as integer no-undo init 65001 .
     3179       define variable v-cp-windows1251    as integer no-undo init 1251 .
     3180       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     3181       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     3182       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     3183       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     3184   do
     3185   for buf_xmllib_rec
     3186     , buf_xmllib_rec-fld
     3187     , buf_xmllib_rec-list
     3188     , buf_xmllib_rec-fld-list
     3189   on error undo, return error
     3190   :
     3191       find first buf_xmllib_rec-list
     3192            where buf_xmllib_rec-list.closed = no
     3193       no-error.
     3194       if available buf_xmllib_rec-list
     3195       then do:
     3196           find first buf_xmllib_rec-fld-list
     3197                where buf_xmllib_rec-fld-list.closed = no
     3198           no-error.
     3199           if available buf_xmllib_rec-fld-list
     3200           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     3201           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     3202           then do:
     3203               find last buf_xmllib_rec
     3204                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     3205                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     3206                     and buf_xmllib_rec.closed   = no
     3207               use-index nm
     3208               no-error.
     3209               if available buf_xmllib_rec
     3210               then do:
     3211                   find last buf_xmllib_rec-fld
     3212                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     3213                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     3214                         and buf_xmllib_rec-fld.closed = no
     3215                   use-index nm
     3216                   no-error.
     3217                   if available buf_xmllib_rec-fld
     3218                   then do:
     3219                       assign
     3220                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     3221                       .
     3222                       if v-xmllib-codepage-convert = yes
     3223                       then do:
     3224                         assign
     3225                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     3226                         .
     3227                       end.
     3228                       run xmlchar-decode in this-procedure (
     3229                           input v-data-string
     3230                           , output v-data-string
     3231                       ).
     3232                       assign
     3233                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     3234                       .
     3235                   end.
     3236               end.
     3237           end.
     3238       end.
     3239   end.
     3240   end procedure.
     3241   procedure EndElement :
     3242   define input parameter p-name-space     as character        no-undo.
     3243   define input parameter p-local-name     as character        no-undo.
     3244   define input parameter p-q-name         as character        no-undo.
     3245       define buffer buf_rec             for temp_xmllib_rec.
     3246       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3247       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3248       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3249   do
     3250   for buf_rec
     3251     , buf_rec-fld
     3252     , buf_rec-list
     3253     , buf_rec-fld-list
     3254   on error undo, return error
     3255   :
     3256       find last buf_rec-list
     3257           where buf_rec-list.recName = p-q-name
     3258       use-index pi
     3259       no-error.
     3260       if available buf_rec-list
     3261       then do:
     3262           if buf_rec-list.closed = yes
     3263           then do:
     3264               run xmllib-parse-error in this-procedure (
     3265                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     3266                                   , p-q-name
     3267                                   )
     3268               ).
     3269           end.
     3270           else do:
     3271               find last buf_rec
     3272                   where buf_rec.recName  = buf_rec-list.recName
     3273                     and buf_rec.recLevel = buf_rec-list.recLevel
     3274                     and buf_rec.closed   = no
     3275               use-index nm
     3276               no-error.
     3277               if not available buf_rec
     3278               then do:
     3279                   run xmllib-parse-error in this-procedure (
     3280                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     3281                                       , p-q-name
     3282                                       , buf_rec-list.recLevel
     3283                                       )
     3284                   ).
     3285               end.
     3286               else do:
     3287                   find first buf_rec-fld-list
     3288                        where buf_rec-fld-list.recName  = buf_rec.recName
     3289                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     3290                          and buf_rec-fld-list.fldName  = p-q-name
     3291                          and buf_rec-fld-list.closed   = no
     3292                   no-error.
     3293                   if not available buf_rec-fld-list
     3294                   then do:
     3295                       if buf_rec.recName <> p-q-name
     3296                       then do:
     3297                           run xmllib-parse-error in this-procedure (
     3298                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     3299                                               , buf_rec.recName
     3300                                               )
     3301                           ).
     3302                       end.
     3303                       else do:
     3304                           assign
     3305                               buf_rec.closed              = yes
     3306                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3307                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3308                           .
     3309                           if buf_rec-list.recLevel > 0
     3310                           then do:
     3311                               assign
     3312                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     3313                               .
     3314                               for each buf_rec-fld-list
     3315                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     3316                               :
     3317                                   assign
     3318                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     3319                                   .
     3320                               end.
     3321                           end.
     3322                           else do:
     3323                               assign
     3324                                   buf_rec-list.closed         = yes
     3325                               .
     3326                           end.
     3327                       end.
     3328                   end.
     3329                   else do:
     3330                       find last buf_rec-fld
     3331                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3332                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3333                             and buf_rec-fld.closed  = no
     3334                       use-index nm
     3335                       no-error.
     3336                       if not available buf_rec-fld
     3337                       then do:
     3338                           run xmllib-parse-error in this-procedure (
     3339                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3340                                               , buf_rec-fld-list.fldName
     3341                                               , buf_rec.recName
     3342                                               , buf_rec.recLevel
     3343                                               )
     3344                           ).
     3345                       end.
     3346                       else do:
     3347                           assign
     3348                               buf_rec-fld.closed              = yes
     3349                               buf_rec-fld-list.closed         = yes
     3350                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3351                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3352                           .
     3353                       end.
     3354                   end.
     3355               end.
     3356           end.
     3357       end.
     3358       else do:
     3359           close-field-rec:
     3360           for each buf_rec-fld-list
     3361              where buf_rec-fld-list.fldName = p-q-name
     3362           :
     3363               find first buf_rec-list
     3364                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     3365                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     3366                      and buf_rec-list.closed   = no
     3367               no-error.
     3368               if available buf_rec-list
     3369               then do:
     3370                   find last buf_rec
     3371                       where buf_rec.recName  = buf_rec-list.recName
     3372                         and buf_rec.recLevel = buf_rec-list.recLevel
     3373                         and buf_rec.closed   = no
     3374                   use-index nm
     3375                   no-error.
     3376                   if not available buf_rec
     3377                   then do:
     3378                       run xmllib-parse-error in this-procedure (
     3379                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     3380                                           , p-q-name
     3381                                           )
     3382                       ).
     3383                   end.
     3384                   else do:
     3385                       find last buf_rec-fld
     3386                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3387                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3388                             and buf_rec-fld.closed  = no
     3389                       use-index nm
     3390                       no-error.
     3391                       if not available buf_rec-fld
     3392                       then do:
     3393                           run xmllib-parse-error in this-procedure (
     3394                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3395                                               , buf_rec-fld-list.fldName
     3396                                               , buf_rec.recName
     3397                                               , buf_rec.recLevel
     3398                                               )
     3399                           ).
     3400                       end.
     3401                       else do:
     3402                           assign
     3403                               buf_rec-fld.closed              = yes
     3404                               buf_rec-fld-list.closed         = yes
     3405                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3406                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3407                           .
     3408                       end.
     3409                   end.
     3410                   leave close-field-rec.
     3411               end.
     3412           end.
     3413       end.
     3414   end.
     3415   end procedure.
     3416   procedure Error :
     3417   define input parameter p-error-message     as character        no-undo.
     3418   do
     3419   on error undo, return error
     3420   :
     3421       run xmllib-parse-error in this-procedure (
     3422           input p-error-message
     3423       ).
     3424       assign
     3425           v-xmllib-error-status = yes
     3426       .
     3427   end.
     3428   end procedure.
     3429   procedure xmllib-parse-error :
     3430   define input parameter p-err-message    as character        no-undo.
     3431   do
     3432   on error undo, return error
     3433   :
     3434       if valid-handle(v-xmllib-log-handle) then do:
     3435         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     3436                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     3437                                    ,chr(10)
     3438                                    ,v-xmllib-dirname
     3439                                    ,v-xmllib-filename
     3440                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     3441                                      then v-xmllib-sax-reader-handle :locator-line-number
     3442                                      else ?)
     3443                                    ,p-err-message)).
     3444       end.
     3445       else do:
     3446         if v-xmllib-log-filename = "":U
     3447         then do:
     3448             message
     3449                     vss-workfile vss-revision vss-description
     3450                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     3451                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     3452                                  then v-xmllib-sax-reader-handle :locator-line-number
     3453                                  else ?)
     3454                 skip(1)
     3455                 skip p-err-message
     3456                 skip return-value
     3457                 skip trim( error-status :get-message( 1 ) )
     3458                     trim( error-status :get-message( 2 ) )
     3459                     trim( error-status :get-message( 3 ) )
     3460             view-as alert-box error.
     3461             undo, return error.
     3462         end.
     3463         else do:
     3464           output to value( v-xmllib-log-filename ).
     3465           put unformatted
     3466               substitute( "&1&2", chr(10), p-err-message )
     3467           .
     3468           output close.
     3469         end.
     3470       end.
     3471   end.
     3472   end procedure.
     3473   procedure xmllib-set-log-filename :
     3474   define input parameter p-log-filename   as character        no-undo.
     3475   do
     3476   on error undo, return error
     3477   :
     3478       run gbl/fileapnd.p (
     3479             input p-log-filename
     3480           , input "":U
     3481           , input 10
     3482       ) no-error.
     3483       if error-status :error
     3484       then do:
     3485           assign
     3486               v-xmllib-log-filename = "":U
     3487           .
     3488       end.
     3489       else do:
     3490           assign
     3491               v-xmllib-log-filename = p-log-filename
     3492           .
     3493       end.
     3494   end.
     3495   end procedure.
     3496   procedure xmllib-set-log-handle :
     3497   define input parameter p-log-handle    as handle        no-undo.
     3498   define input parameter p-log-proc-name as character no-undo .
     3499   do
     3500   on error undo, return error
     3501   :
     3502       if valid-handle(p-log-handle)
     3503       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     3504       then do:
     3505         assign
     3506         v-xmllib-log-handle    = p-log-handle
     3507         v-xmllib-log-proc-name = p-log-proc-name
     3508         .
     3509       end.
     3510       else do:
     3511         assign
     3512         v-xmllib-log-handle    = ?
     3513         v-xmllib-log-proc-name = '':U
     3514         .
     3515       end.
     3516   end.
     3517   end procedure.
     3518   procedure xmllib-set-prg-bar-handle :
     3519   define input parameter p-handle    as handle        no-undo.
     3520   do
     3521   on error undo, return error
     3522   :
