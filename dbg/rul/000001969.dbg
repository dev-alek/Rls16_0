     3904                           .
     3905                       end.
     3906                       when chr(9)
     3907                       then do:
     3908                           assign
     3909                               p-out-string = p-out-string + " ":U
     3910                           .
     3911                       end.
     3912                       when chr(29)
     3913                       then do:
