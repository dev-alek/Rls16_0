     3887                       end.
     3888                       when chr(6)
     3889                       then do:
     3890                           assign
     3891                               p-out-string = p-out-string + " ":U
     3892                           .
     3893                       end.
     3894                       when chr(7)
     3895                       then do:
     3896                           assign
     3897                               p-out-string = p-out-string + " ":U
