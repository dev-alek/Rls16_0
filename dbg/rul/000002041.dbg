      944     index ie2 obj-name
      945   .
      946   procedure create_obj-list :
      947      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      948      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      949      do
      950      on error undo, return error return-value
      951      :
      952         define buffer cli-obj for ub.clients .
      953         define variable p-var as integer no-undo .
      954         define buffer buf_obj-list for obj-list .
      955         find last buf_obj-list  use-index pi no-error .
      956         if available buf_obj-list
      957         then
      958            p-var = buf_obj-list.obj-id + 1.
      959         else
      960            p-var = 1.
      961         find first cli-obj where
      962                   cli-obj.obj-type = p-obj-type
      963               and cli-obj.obj-code = p-obj-code
      964         no-lock no-error.
      965         if available cli-obj
      966         then do:
      967            create buf_obj-list.
      968            assign
      969               buf_obj-list.obj-id   = p-var
      970               buf_obj-list.obj-code = cli-obj.obj-code
      971               buf_obj-list.obj-type = cli-obj.obj-type
      972               buf_obj-list.obj-name = cli-obj.obj-name
      973               buf_obj-list.db-num   = cli-obj.db-num
      974            .
      975         end.
      976      end.
      977   end.
      978   define new shared temp-table X-init_obj-list no-undo
      979   field obj-type like ub.clients.obj-type
      980   field obj-code like ub.clients.obj-code
      981   index pi is unique primary obj-type obj-code.
      982   define variable p1 like ub.gds-obj.prod-type no-undo.
      983   define variable p2 like ub.gds-obj.prod-code no-undo.
      984   define variable p3 like ub.gds-obj.artic     no-undo.
      985   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      986   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   define variable to-day       as date no-undo .
      988   define new shared variable str1   as character  no-undo.
      989   define new shared variable str2   as character  no-undo.
      990   define new shared variable str3   as character  no-undo.
      991   define new shared variable str4   as character  no-undo.
      992   define new shared variable ReportNAme   as character  no-undo.
      993   define new shared variable ReportProc   as character  no-undo.
      994   define new shared variable ReportHeader as character  no-undo.
