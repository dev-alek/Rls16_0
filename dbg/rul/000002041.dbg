      933   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   def
      935   new shared
      936   temp-table  obj-list no-undo
      937     field obj-type like ub.clients.obj-type
      938     field obj-code like ub.clients.obj-code
      939     field obj-name like ub.clients.obj-name
      940     field obj-id   as integer
      941     field db-num   as integer
