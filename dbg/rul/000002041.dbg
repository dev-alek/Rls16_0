     1463   end.
     1464   if not this-procedure:persistent then do:
     1465     run proc-main in this-procedure no-error .
     1466     if error-status:error then do:
     1467       v-es = error-status:error .
     1468       v-rv = return-value .
     1469     end.
     1470     if v-es then do:
     1471         run garbcoll_clear in this-procedure .
     1472         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1473     end.
     1474     run garbcoll_clear in this-procedure .
     1475   end.
     1476   procedure proc-main :
     1477   DEFINE VARIABLE v-today as date no-undo .
     1478   DEFINE VARIABLE v-time as integer no-undo .
     1479   define variable v-date1 as date no-undo .
     1480   define variable v-date2 as date no-undo .
     1481   _main:
     1482   do
     1483   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1484   :
     1485     run cur-time in this-procedure ( output v-today, output v-time).
     1486     case p-period-type:
     1487       when 'yesterday':U then do:
     1488         assign
     1489           v-date1 = v-today - 1
     1490           v-date2 = v-today - 1
     1491         .
     1492       end.
     1493       when 'week-last':U then do:
     1494       assign
     1495         v-date1 = (v-today - ((weekday(today) + 5) modulo 7) - 7)
     1496         v-date2   = (v-today - ((weekday(today) + 5) modulo 7))
     1497       .
     1498       end.
     1499       when 'month-last':U then do:
     1500         assign
     1501           v-date1 = if month(v-today) = 1
     1502                         then  date( 12, 1, year(v-today) - 1 )
     1503                         else  date( month(v-today) - 1, 1, year(v-today) )
     1504           v-date2 = date( month(v-today), 1, year(v-today))
     1505         .
     1506       end.
     1507       otherwise do:
     1508         undo, return error substitute("Не заданы ни даты ни тип периода").
     1509       end.
     1510     end case.
     1511     run rep/r-ctrasm.p (
     1512                          input parparentproc
     1513                         ,input this-procedure :handle
     1514                         ,input yes
     1515                         ,input v-date1
     1516                         ,input v-date2
     1517                         ,input p-gds-by-am
     1518                         ,input p-group-by-order
     1519                         ,input p-group-by-post
     1520                         ,input p-critical-qnty-balance
     1521                         ,input p-critical-qnty-sale
     1522                         ,input p-critical-qnty-order
     1523                         ,input p-days-wt-goods
     1524                         ,input entry(1, v-dirs, chr(124))
     1525                         ,input v-current-rep-code
     1526                         ,input yes
     1527                         ,input no
     1528                         ,input no
     1529                         ,input no
     1530                         ,input no
     1531                         ,input no
     1532                         ) no-error.
     1533     if error-status:error then do:
     1534       v-esm = error-status :get-message (1).
     1535       v-rv = return-value .
     1536       if p-ruleset-id = 1
     1537       then do:
     1538         run write-log  in p-log-handle (
     1539                                         input 0
     1540                                       , "&DLine").
     1541               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Расчет отчета &1 закончился ошибкой", p-rule-id)).
     1542               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-esm)).
     1543               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-rv)).
     1544         v-rv = v-esm + chr(10) + v-rv.
     1545       end.
     1546       return error v-rv.
     1547     end.
     1548   end.
     1549   end procedure.
     1550   procedure load-ruleset-context :
     1551   define input parameter p-ruleset-id as integer no-undo .
     1552   define buffer buf_rule-call-param for ub.rule-call-param.
     1553   do
     1554   on error undo, return error
     1555   :
     1556   for each buf_temp-rule-call-param:
     1557     delete buf_temp-rule-call-param.
     1558   end.
     1559     find first buf_rule-call-param no-lock where
     1560   buf_rule-call-param.codex_id = p-codex-id
     1561   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1562   and buf_rule-call-param.call_id = p-call-id
     1563   and buf_rule-call-param.order_id = p-order-id
     1564   and buf_rule-call-param.rule_id = p-rule-id
     1565   and buf_rule-call-param.param-name = "p-period-type"
     1566    no-error.
     1567   if available buf_rule-call-param then do:
     1568   assign p-period-type = buf_rule-call-param.param-value-character.
     1569   end.
     1570   for each buf_rule-call-param no-lock where
     1571   buf_rule-call-param.codex_id = p-codex-id
     1572   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1573   and buf_rule-call-param.call_id = p-call-id
     1574   and buf_rule-call-param.order_id = p-order-id
     1575   and buf_rule-call-param.rule_id = p-rule-id
     1576   and buf_rule-call-param.param-name = "p-objects"
     1577   and buf_rule-call-param.p-index > 0:
     1578     create buf_temp-rule-call-param.
     1579     buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1580     release buf_temp-rule-call-param.
     1581   end.
     1582     find first buf_rule-call-param no-lock where
     1583   buf_rule-call-param.codex_id = p-codex-id
     1584   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1585   and buf_rule-call-param.call_id = p-call-id
     1586   and buf_rule-call-param.order_id = p-order-id
     1587   and buf_rule-call-param.rule_id = p-rule-id
     1588   and buf_rule-call-param.param-name = "p-gds-by-am"
     1589    no-error.
     1590   if available buf_rule-call-param then do:
     1591   assign p-gds-by-am = buf_rule-call-param.param-value-logical.
     1592   end.
     1593     find first buf_rule-call-param no-lock where
     1594   buf_rule-call-param.codex_id = p-codex-id
     1595   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1596   and buf_rule-call-param.call_id = p-call-id
     1597   and buf_rule-call-param.order_id = p-order-id
     1598   and buf_rule-call-param.rule_id = p-rule-id
     1599   and buf_rule-call-param.param-name = "p-group-by-post"
     1600    no-error.
     1601   if available buf_rule-call-param then do:
     1602   assign p-group-by-post = buf_rule-call-param.param-value-logical.
     1603   end.
     1604     find first buf_rule-call-param no-lock where
     1605   buf_rule-call-param.codex_id = p-codex-id
     1606   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1607   and buf_rule-call-param.call_id = p-call-id
     1608   and buf_rule-call-param.order_id = p-order-id
     1609   and buf_rule-call-param.rule_id = p-rule-id
     1610   and buf_rule-call-param.param-name = "p-critical-qnty-balance"
     1611    no-error.
     1612   if available buf_rule-call-param then do:
     1613   assign p-critical-qnty-balance = buf_rule-call-param.param-value-decimal.
     1614   end.
     1615     find first buf_rule-call-param no-lock where
     1616   buf_rule-call-param.codex_id = p-codex-id
     1617   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1618   and buf_rule-call-param.call_id = p-call-id
     1619   and buf_rule-call-param.order_id = p-order-id
     1620   and buf_rule-call-param.rule_id = p-rule-id
     1621   and buf_rule-call-param.param-name = "p-critical-qnty-sale"
     1622    no-error.
     1623   if available buf_rule-call-param then do:
     1624   assign p-critical-qnty-sale = buf_rule-call-param.param-value-decimal.
     1625   end.
     1626     find first buf_rule-call-param no-lock where
     1627   buf_rule-call-param.codex_id = p-codex-id
     1628   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1629   and buf_rule-call-param.call_id = p-call-id
     1630   and buf_rule-call-param.order_id = p-order-id
     1631   and buf_rule-call-param.rule_id = p-rule-id
     1632   and buf_rule-call-param.param-name = "p-critical-qnty-order"
     1633    no-error.
     1634   if available buf_rule-call-param then do:
     1635   assign p-critical-qnty-order = buf_rule-call-param.param-value-decimal.
     1636   end.
     1637     find first buf_rule-call-param no-lock where
     1638   buf_rule-call-param.codex_id = p-codex-id
     1639   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1640   and buf_rule-call-param.call_id = p-call-id
     1641   and buf_rule-call-param.order_id = p-order-id
     1642   and buf_rule-call-param.rule_id = p-rule-id
     1643   and buf_rule-call-param.param-name = "p-days-wt-goods"
     1644    no-error.
     1645   if available buf_rule-call-param then do:
     1646   assign p-days-wt-goods = buf_rule-call-param.param-value-integer.
     1647   end.
     1648       case p-ruleset-id:
     1649         when 1
     1650         then do:
     1651           assign
     1652           v-sign = 0
     1653           v-current-host-code = p0-host-code
     1654           v-current-obj-type = p-obj-type
     1655           v-current-obj-code = p-obj-code
     1656           v-current-db-num = g#db-num
     1657           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1658           v-dirs  = p-process-dirs
     1659           v-current-rep-code  = p-doc-code
     1660           .
     1661         end.
     1662      end case.
     1663   end.
     1664   end procedure.
     1665   procedure cb_get-objects :
     1666   define input parameter p-caller-handle as handle no-undo .
     1667   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1668   do
     1669   on error undo, return error
     1670   :
     1671     for each buf_temp-rule-call-param no-lock
     1672       where buf_temp-rule-call-param.param-name = "p-objects"
     1673       and buf_temp-rule-call-param.p-index > 0 :
     1674       run cb_set-objects in p-caller-handle ( input buf_temp-rule-call-param.param-value-character ).
     1675     end.
     1676   end.
     1677   end procedure.
