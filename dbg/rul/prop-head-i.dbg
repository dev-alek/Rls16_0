      528       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      529            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      530            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      531   DEFINE FRAME Dialog-Frame
      532        cb-select-general AT ROW 16 COL 1 NO-LABEL WIDGET-ID 32
      533        b-general-add AT ROW 17 COL 1 WIDGET-ID 44
      534        b-general-del AT ROW 17 COL 15.5 WIDGET-ID 48
      535        list-general-view AT ROW 17 COL 75.5 NO-LABEL WIDGET-ID 38
      536        tt-prop-head.ref-type AT ROW 18.87 COL 1.5 NO-LABEL WIDGET-ID 102
      537             VIEW-AS RADIO-SET VERTICAL
      538             RADIO-BUTTONS
      539                       "Item 1", "1":U,
      540   "Item 2", "2":U
      541             SIZE 23.5 BY 4.4
      542        cb-select-general-view AT ROW 19 COL 51 NO-LABEL WIDGET-ID 36
      543        b-general-view-add AT ROW 19.93 COL 51 WIDGET-ID 46
      544        b-general-view-del AT ROW 19.93 COL 65.5 WIDGET-ID 50
      545        "Описание" VIEW-AS TEXT
      546             SIZE 17.5 BY 1 AT ROW 4.83 COL 2.5 WIDGET-ID 10
      547        "Предназначение" VIEW-AS TEXT
      548             SIZE 24 BY 1 AT ROW 15 COL 1 WIDGET-ID 40
      549             FGCOLOR 3
      550        "Представление" VIEW-AS TEXT
      551             SIZE 24 BY 1 AT ROW 18 COL 51 WIDGET-ID 42
      552             FGCOLOR 3
      553        "Тип итогов/срезов" VIEW-AS TEXT
      554             SIZE 24 BY 1 AT ROW 18.07 COL 1 WIDGET-ID 106
      555             FGCOLOR 3
      556        SPACE(74.69) SKIP(4.20)
      557       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      558            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      559            TITLE "Объект rule-машины"
      560            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      561   ASSIGN
      562          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      563          FRAME Dialog-Frame:HIDDEN           = TRUE.
      564   ASSIGN
      565          f-get-hist-from-nws:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      566   ASSIGN
      567          f-hist-from-prim:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      568   ASSIGN
      569          f-hist-to-nws:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      570   ASSIGN
      571          f-nws-to-cd:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      572   ASSIGN
      573          f-nws-to-hist:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      574   ASSIGN
      575          f-smart-nws:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      576   ON GO OF FRAME Dialog-Frame
      577   DO:
      578       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      579     IF ERROR-STATUS:ERROR THEN DO:
      580         RETURN NO-APPLY.
      581     END.
      582   END.
      583   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      584   DO:
      585     APPLY "END-ERROR":U TO SELF.
      586   END.
      587   ON CHOOSE OF b-general-add IN FRAME Dialog-Frame
      588   DO:
      589     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      590     IF cb-select-general = '':U THEN DO:
      591       MESSAGE
      592       "Нечего добавлять"
      593       VIEW-AS ALERT-BOX ERROR.
      594       RETURN  NO-APPLY.
      595     END.
      596     IF LOOKUP(cb-select-general, list-general) > 0 THEN DO:
      597         MESSAGE
      598         "Объект уже имеет данное предназначение"
      599         VIEW-AS ALERT-BOX ERROR.
      600         RETURN  NO-APPLY.
      601     END.
      602       glog = list-general:ADD-LAST((if lookup (cb-select-general, 'dis-card-type,Loyalty,dc-storage,dc-prop,goods':U) > 0 then entry (lookup (cb-select-general, 'dis-card-type,Loyalty,dc-storage,dc-prop,goods':U), 'Типы ДК,Система Лояльности,Св-ва и итоги по ДК,Св-ва ДК,Товары':U) else cb-select-general), cb-select-general) NO-ERROR.
      603     IF ERROR-STATUS:ERROR THEN DO:
      604        RETURN NO-APPLY.
      605     END.
      606     DISPLAY
      607     list-general
      608     WITH FRAME Dialog-Frame.
      609   END.
      610   ON CHOOSE OF b-general-del IN FRAME Dialog-Frame
      611   DO:
      612     IF list-general:SCREEN-VALUE  = '':U
      613     OR list-general:SCREEN-VALUE  = ?
      614     OR list-general:IS-SELECTED(INPUT FRAME Dialog-Frame list-general) = NO
      615     THEN DO:
      616        MESSAGE
      617        "Нечего удалять"
      618        VIEW-AS ALERT-BOX .
      619        RETURN NO-APPLY.
      620     END.
      621     list-general:DELETE(INPUT FRAME Dialog-Frame list-general).
      622   END.
      623   ON CHOOSE OF b-general-view-add IN FRAME Dialog-Frame
      624   DO:
      625       DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      626       IF cb-select-general-view = '':U THEN DO:
      627         MESSAGE
      628         "Нечего добавлять"
      629         VIEW-AS ALERT-BOX ERROR.
      630         RETURN  NO-APPLY.
      631       END.
      632       IF LOOKUP(cb-select-general-view, list-general-view) > 0 THEN DO:
      633           MESSAGE
      634           "Объект уже имеет данное предназначение"
      635           VIEW-AS ALERT-BOX ERROR.
      636           RETURN  NO-APPLY.
      637       END.
      638           glog = list-general-view:ADD-LAST((if lookup (cb-select-general-view, 'dis-card-type,Loyalty,Loyalty2,dc-storage,dc-prop,goods':U) > 0 then entry (lookup (cb-select-general-view, 'dis-card-type,Loyalty,Loyalty2,dc-storage,dc-prop,goods':U), 'Типы ДК,Система Лояльности,Система Лояльности,Св-ва и итоги по ДК,Св-ва ДК,Товары':U) else cb-select-general-view), cb-select-general-view) NO-ERROR.
      639       IF ERROR-STATUS:ERROR THEN DO:
      640         RETURN NO-APPLY.
      641       END.
      642       DISPLAY
      643       list-general-view
      644       WITH FRAME Dialog-Frame.
      645   END.
      646   ON CHOOSE OF b-general-view-del IN FRAME Dialog-Frame
      647   DO:
      648     IF list-general-view:SCREEN-VALUE = '':U
      649     OR list-general-view:SCREEN-VALUE  = ?
      650     OR list-general-view:IS-SELECTED(INPUT FRAME Dialog-Frame list-general-view) = NO
      651     THEN DO:
      652        MESSAGE
      653        "Нечего удалять"
      654        VIEW-AS ALERT-BOX .
      655        RETURN NO-APPLY.
      656     END.
      657     list-general-view:DELETE(INPUT FRAME Dialog-Frame list-general-view).
      658   END.
      659   ON VALUE-CHANGED OF cb-select-general IN FRAME Dialog-Frame
      660   DO:
      661     ASSIGN
      662     cb-select-general.
      663   END.
      664   ON VALUE-CHANGED OF cb-select-general-view IN FRAME Dialog-Frame
      665   DO:
      666     ASSIGN
      667     cb-select-general-view.
      668   END.
      669   ON VALUE-CHANGED OF tt-prop-head.ref-type IN FRAME Dialog-Frame
      670   DO:
      671     ASSIGN
      672     tt-prop-head.ref-type.
      673   END.
      674   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      675   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      676   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   on help of frame Dialog-Frame
      678   do:
      679     run gbl/app_help.p
      680       (input this-procedure :file-name
      681       ,input ''
      682       ,input ?
      683       ) no-error.
      684     if error-status :error then do:
      685       message
      686         "Ошибка при вызове помощи"
      687         error-status :get-message(1)
      688         view-as alert-box .
      689     end.
      690   end.
      691   run minbtn-set in this-procedure .
      692   on choose of b-help in frame Dialog-Frame
      693   do:
      694     apply "help":u to frame Dialog-Frame .
      695   end.
      696   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   procedure minbtn-set :
      698       do
      699           on error undo, return error return-value
      700           :
      701           define variable ii              as integer       no-undo .
      702           define variable fh              as widget-handle no-undo .
      703           define variable hh              as widget-handle no-undo .
      704           define variable v-h             as handle        extent 4 no-undo .
      705           define variable v-name-button   as character     no-undo .
      706           define variable v-help-old-x    as decimal       no-undo .
      707           define variable v-help-old-y    as decimal       no-undo .
      708           define variable v-help-old-size as decimal       no-undo .
      709           define variable v-frame-width   as decimal       no-undo .
      710           define variable jj              as integer       no-undo .
      711           do
      712               on error undo, return error
      713               :
      714               assign
      715                   v-frame-width = frame Dialog-Frame:width - 0.3
      716                   fh            = frame Dialog-Frame:first-child
      717                   hh            = fh:first-child
      718                   ii            = 1
      719                   .
      720               do while valid-handle(hh):
      721                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      722                   do:
      723                       case lc(hh:name) :
      724                           when "b-help" then
      725                               do:
      726                                   hh:load-image-up("cmp/b-help.bmp":u) .
      727                                   hh:load-image-down("cmp/b-help.bmp":u) .
      728                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      729                                   hh:TOOLTIP = "Помощь" .
      730                                   v-help-old-x = hh:column .
      731                                   v-help-old-y = hh:row    .
      732                                   v-help-old-size = hh:width .
      733                                   hh:width-chars = 2.5 .
      734                               end.
      735                           when "b-print" then
      736                               do:
      737                                   hh:load-image("cmp/b-print.bmp":u) .
      738                                   hh:TOOLTIP = "Печать" .
      739                                   v-h[ii] = hh:handle .
      740                                   ii = ii + 1 .
      741                                   hh:width-chars = 3 .
      742                               end.
      743                           when "b-history" or
      744                           when "b-hist" then
      745                               do:
      746                                   hh:load-image("cmp/b-hist.bmp":u) .
      747                                   hh:TOOLTIP = "История" .
      748                                   v-h[ii] = hh:handle .
      749                                   ii = ii + 1 .
      750                                   hh:width-chars = 3 .
      751                               end.
      752                           when "b-sch" then
      753                               do:
      754                                   hh:load-image("cmp/b-sch.bmp":u) .
      755                                   hh:TOOLTIP = "Установка Фильтра" .
      756                                   v-h[ii] = hh:handle .
      757                                   ii = ii + 1 .
      758                                   hh:width-chars = 3 .
      759                               end.
      760                           when "b-hist-user" then
      761                               do:
      762                                   hh:load-image("cmp/b-hist.bmp":u) .
      763                                   hh:TOOLTIP = "История пользователя" .
      764                                   ii = ii + 1 .
      765                               end.
      766                       end case.
      767                   end.
      768                   hh = hh:next-sibling.
      769               end.
      770               b-help:column = v-frame-width - b-help:width-chars.
      771               jj = 0.
      772               repeat ii = 4 to 1 by -1 :
      773                   if valid-handle (v-h[ii] ) then
      774                   do:
      775                       jj  = jj + 1 .
      776                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      777                       v-h[ii]:row    = v-help-old-y .
      778                   end.
      779               end.
      780           end.
      781       end.
      782   end procedure.
      783   MAIN-BLOCK:
      784   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      785      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      786      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      787     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      788       FIND FIRST first_prop-head EXCLUSIVE-LOCK.
      789       CREATE tt-prop-head.
      790     END.
      791     else do:
      792       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      793         FIND FIRST LOCKED_prop-head EXCLUSIVE-LOCK WHERE
      794                   LOCKED_prop-head.dtm-code = p-dtm-code .
      795       END.
      796       IF p-mode = 'ПРОСМОТР':U THEN DO:
      797           FIND FIRST LOCKED_prop-head no-LOCK WHERE
      798                     LOCKED_prop-head.dtm-code = p-dtm-code NO-ERROR.
      799       END.
      800       create tt-prop-head.
      801       buffer-copy locked_prop-head to tt-prop-head.
      802     end.
      803     RUN Myenable.
      804     WAIT-FOR GO OF FRAME Dialog-Frame.
      805   END.
      806   RUN disable_UI.
      807   PROCEDURE disable_UI :
      808     HIDE FRAME Dialog-Frame.
      809   END PROCEDURE.
      810   PROCEDURE enable_UI :
      811     OPEN QUERY Dialog-Frame FOR EACH tt-prop-head SHARE-LOCK.
      812     GET FIRST Dialog-Frame.
      813     DISPLAY f-hist-from-prim f-hist-to-nws f-nws-to-hist f-smart-nws
      814             f-get-hist-from-nws list-general f-nws-to-cd cb-select-general
      815             list-general-view cb-select-general-view
      816         WITH FRAME Dialog-Frame.
      817     IF AVAILABLE tt-prop-head THEN
      818       DISPLAY tt-prop-head.dtm-code tt-prop-head.prop-name tt-prop-head.prop-label
      819             tt-prop-head.prop-des tt-prop-head.hist-from-prim
      820             tt-prop-head.storage-place tt-prop-head.hist-to-nws
      821             tt-prop-head.storage-place-host tt-prop-head.nws-to-hist
      822             tt-prop-head.storage-place-obj tt-prop-head.smart-nws
      823             tt-prop-head.get-hist-from-nws tt-prop-head.nws-to-cd
      824             tt-prop-head.ref-type
      825         WITH FRAME Dialog-Frame.
      826     ENABLE B-exit b-quit tt-prop-head.dtm-code B-Help tt-prop-head.prop-name
      827            tt-prop-head.prop-label tt-prop-head.prop-des f-hist-from-prim
      828            tt-prop-head.hist-from-prim tt-prop-head.storage-place f-hist-to-nws
      829            tt-prop-head.hist-to-nws tt-prop-head.storage-place-host f-nws-to-hist
      830            tt-prop-head.nws-to-hist tt-prop-head.storage-place-obj f-smart-nws
      831            tt-prop-head.smart-nws f-get-hist-from-nws
      832            tt-prop-head.get-hist-from-nws list-general f-nws-to-cd
      833            tt-prop-head.nws-to-cd cb-select-general b-general-add b-general-del
      834            list-general-view tt-prop-head.ref-type cb-select-general-view
      835            b-general-view-add b-general-view-del
      836         WITH FRAME Dialog-Frame.
      837     VIEW FRAME Dialog-Frame.
      838   END PROCEDURE.
      839   PROCEDURE MyEnable :
      840   DEFINE VARIABLE v-general AS character  NO-UNDO.
      841   DEFINE VARIABLE v-general-view AS character  NO-UNDO.
      842   DEFINE VARIABLE v-ii AS integer  NO-UNDO.
      843   DEFINE VARIABLE v-dop AS CHARACTER.
      844   v-dop = "Не предусмотрено,,".
      845   DO v-ii = 1 TO NUM-ENTRIES('blank,period,sel-goods,one-ptrl':U):
      846      ASSIGN
      847      v-dop = v-dop + ENTRY(v-ii, '_,Период дат,Опред.товары,Вид топлива':U) + chr(44) +
      848              ENTRY(v-ii, 'blank,period,sel-goods,one-ptrl':U) + chr(44).
      849   END.
      850   ASSIGN
      851   v-dop = TRIM(v-dop, chr(44)).
      852   ASSIGN
      853   tt-prop-head.ref-type:radio-buttons IN FRAME Dialog-Frame = v-dop.
      854   ASSIGN
      855   tt-prop-head.get-hist-from-nws:RADIO-BUTTONS IN FRAME Dialog-Frame = 'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      856   tt-prop-head.hist-from-prim:RADIO-BUTTONS IN FRAME Dialog-Frame = 'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      857   tt-prop-head.hist-to-nws:RADIO-BUTTONS IN FRAME Dialog-Frame =  'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      858   tt-prop-head.nws-to-cd:RADIO-BUTTONS IN FRAME Dialog-Frame =  'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      859   tt-prop-head.nws-to-hist:RADIO-BUTTONS IN FRAME Dialog-Frame =  'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      860   tt-prop-head.smart-nws:RADIO-BUTTONS IN FRAME Dialog-Frame = 'Всегда,10,Да,0,Нет,-1,Смарт2,1,Никогда,-10':U
      861   .
      862   DO v-ii = 1 TO NUM-ENTRIES(tt-prop-head.general):
      863     assign
      864     v-general = v-general + chr(44) +
      865                 (if lookup (ENTRY(v-ii, tt-prop-head.general), 'dis-card-type,Loyalty,dc-storage,dc-prop,goods':U) > 0 then entry (lookup (ENTRY(v-ii, tt-prop-head.general), 'dis-card-type,Loyalty,dc-storage,dc-prop,goods':U), 'Типы ДК,Система Лояльности,Св-ва и итоги по ДК,Св-ва ДК,Товары':U) else ENTRY(v-ii, tt-prop-head.general)) + chr(44) +
      866                  ENTRY(v-ii, tt-prop-head.general).
      867   END.
      868   v-general = LEFT-TRIM(v-general, chr(44)).
      869   DO v-ii = 1 TO NUM-ENTRIES(tt-prop-head.general-view):
      870     assign
      871     v-general-view = v-general-view + chr(44) +
      872                 (if lookup (ENTRY(v-ii, tt-prop-head.general-view), 'dis-card-type,Loyalty,Loyalty2,dc-storage,dc-prop,goods':U) > 0 then entry (lookup (ENTRY(v-ii, tt-prop-head.general-view), 'dis-card-type,Loyalty,Loyalty2,dc-storage,dc-prop,goods':U), 'Типы ДК,Система Лояльности,Система Лояльности,Св-ва и итоги по ДК,Св-ва ДК,Товары':U) else ENTRY(v-ii, tt-prop-head.general-view)) + chr(44) +
      873                  ENTRY(v-ii, tt-prop-head.general-view).
      874   END.
      875   v-general-view = LEFT-TRIM(v-general-view, chr(44)).
      876   IF v-general <> '':U THEN DO:
      877     ASSIGN
      878     list-general:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-general.
      879   END.
      880   ELSE DO:
      881     ASSIGN
      882     list-general:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = ",".
      883   END.
      884   IF v-general-view <> '':U THEN DO:
      885     ASSIGN
      886     list-general-view:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = v-general-view.
      887   END.
      888   ELSE DO:
      889     ASSIGN
      890     list-general-view:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = ",".
      891   END.
      892   ASSIGN
      893   cb-select-general:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = 'Типы ДК,dis-card-type,Система Лояльности,Loyalty,Св-ва и итоги по ДК,dc-storage,Св-ва ДК,dc-prop,Товары,goods':U
      894   cb-select-general-view:LIST-ITEM-PAIRS IN FRAME Dialog-Frame = 'Типы ДК,dis-card-type,Система Лояльности,Loyalty,Система Лояльности,Loyalty2,Св-ва и итоги по ДК,dc-storage,Св-ва ДК,dc-prop,Товары,goods':U
      895   .
      896   DISPLAY
      897   f-get-hist-from-nws
      898   f-hist-from-prim
      899   f-hist-to-nws
      900   f-nws-to-cd
      901   f-nws-to-hist
      902   f-smart-nws
      903   WITH FRAME Dialog-Frame.
      904   IF AVAILABLE tt-prop-head THEN
      905   DISPLAY
      906   tt-prop-head.dtm-code
      907   tt-prop-head.prop-name
      908   tt-prop-head.prop-label
      909   tt-prop-head.prop-des
      910   tt-prop-head.storage-place
      911   tt-prop-head.storage-place-host
      912   tt-prop-head.storage-place-obj
      913   tt-prop-head.hist-from-prim
      914   tt-prop-head.hist-to-nws
      915   tt-prop-head.nws-to-hist
      916   tt-prop-head.nws-to-cd
      917   tt-prop-head.smart-nws
      918   tt-prop-head.get-hist-from-nws
      919   tt-prop-head.ref-type
      920   WITH FRAME Dialog-Frame.
      921   ENABLE
      922   B-exit WHEN p-mode <> 'ПРОСМОТР':U
      923   b-quit
      924   B-Help
      925   tt-prop-head.dtm-code  WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      926   tt-prop-head.prop-name  WHEN p-mode <> 'ПРОСМОТР':U
      927   tt-prop-head.prop-label  WHEN p-mode <> 'ПРОСМОТР':U
      928   tt-prop-head.prop-des    WHEN p-mode <> 'ПРОСМОТР':U
      929   tt-prop-head.storage-place WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      930   tt-prop-head.storage-place-host WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      931   tt-prop-head.storage-place-obj  WHEN p-mode = 'ДОБАВЛЕНИЕ':U
      932   tt-prop-head.hist-from-prim    WHEN (p-mode <> 'ПРОСМОТР':U AND (
      933        tt-prop-head.hist-from-prim <> INTEGER('10':U)
      934    AND tt-prop-head.hist-from-prim <> INTEGER('-10':U) ))
      935   tt-prop-head.hist-to-nws       WHEN (p-mode <> 'ПРОСМОТР':U AND (
      936       tt-prop-head.hist-to-nws <> INTEGER('10':U)
      937    AND tt-prop-head.hist-to-nws <> INTEGER('-10':U) ))
      938   tt-prop-head.nws-to-hist       WHEN (p-mode <> 'ПРОСМОТР':U AND (
      939       tt-prop-head.nws-to-hist <> INTEGER('10':U)
      940    AND tt-prop-head.nws-to-hist <> INTEGER('-10':U) ))
      941   tt-prop-head.nws-to-cd         WHEN (p-mode <> 'ПРОСМОТР':U AND (
      942       tt-prop-head.nws-to-cd <> INTEGER('10':U)
      943    AND tt-prop-head.nws-to-cd <> INTEGER('-10':U) ))
      944   tt-prop-head.smart-nws         WHEN (p-mode <> 'ПРОСМОТР':U AND (
      945       tt-prop-head.smart-nws <> INTEGER('10':U)
      946    AND tt-prop-head.smart-nws <> INTEGER('-10':U) ))
      947   tt-prop-head.get-hist-from-nws WHEN (p-mode <> 'ПРОСМОТР':U AND (
      948       tt-prop-head.get-hist-from-nws <> INTEGER('10':U)
      949    AND tt-prop-head.get-hist-from-nws <> INTEGER('-10':U) ))
      950   b-general-add WHEN p-mode <> 'ПРОСМОТР':U
      951   b-general-del WHEN p-mode <> 'ПРОСМОТР':U
      952   b-general-view-add WHEN p-mode <> 'ПРОСМОТР':U
      953   b-general-view-del WHEN p-mode <> 'ПРОСМОТР':U
      954   CB-select-general WHEN p-mode <> 'ПРОСМОТР':U
      955   CB-select-general-view WHEN p-mode <> 'ПРОСМОТР':U
      956   tt-prop-head.ref-type WHEN p-mode <> 'ПРОСМОТР':U
      957   list-general
      958   list-general-view
      959   WITH FRAME Dialog-Frame .
      960   VIEW FRAME Dialog-Frame .
      961   IF p-mode = 'ПРОСМОТР':U THEN DO:
      962     HIDE
      963     b-general-add
      964     b-general-view-add
      965     b-general-del
      966     b-general-view-del
      967     cb-select-general
      968     cb-select-general-view
      969     b-exit
      970     IN FRAME Dialog-Frame.
      971     ASSIGN
      972     b-quit:LABEL = "&Отмена"
      973     b-quit:COLUMN = 1.
      974   END.
      975   END PROCEDURE.
      976   PROCEDURE proc-save :
      977   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
      978   DEFINE VARIABLE v-general AS character  NO-UNDO.
      979   DEFINE VARIABLE v-general-view AS character  NO-UNDO.
      980   DEFINE VARIABLE v-ii AS integer  NO-UNDO.
      981   IF p-mode = 'ПРОСМОТР':U THEN DO:
      982       RETURN.
      983   END.
      984   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      985     v-rec = p-rec.
      986   END.
      987   ASSIGN
      988   FRAME Dialog-Frame
      989   tt-prop-head.dtm-code
      990   tt-prop-head.prop-name
      991   tt-prop-head.prop-label
      992   tt-prop-head.prop-des
      993   tt-prop-head.ref-type
      994   tt-prop-head.storage-place
      995   tt-prop-head.storage-place-host
      996   tt-prop-head.storage-place-obj
      997   .
      998   IF  tt-prop-head.hist-from-prim <> INTEGER('10':U)
      999   AND tt-prop-head.hist-from-prim <> INTEGER('-10':U) THEN DO:
     1000    ASSIGN
     1001    tt-prop-head.hist-from-prim .
     1002   END.
     1003   IF  tt-prop-head.hist-to-nws <> INTEGER('10':U)
     1004   AND tt-prop-head.hist-to-nws <> INTEGER('-10':U) THEN DO:
     1005    ASSIGN
     1006    tt-prop-head.hist-to-nws .
     1007   END.
     1008   IF  tt-prop-head.nws-to-cd <> INTEGER('10':U)
     1009   AND tt-prop-head.nws-to-cd <> INTEGER('-10':U) THEN DO:
     1010    ASSIGN
     1011    tt-prop-head.nws-to-cd .
     1012   END.
     1013   IF  tt-prop-head.nws-to-hist <> INTEGER('10':U)
     1014   AND tt-prop-head.nws-to-hist <> INTEGER('-10':U) THEN DO:
     1015    ASSIGN
     1016    tt-prop-head.nws-to-hist.
     1017   END.
     1018   IF  tt-prop-head.smart-nws <> INTEGER('10':U)
     1019   AND tt-prop-head.smart-nws <> INTEGER('-10':U) THEN DO:
     1020    ASSIGN
     1021    tt-prop-head.smart-nws .
     1022   END.
     1023   IF  tt-prop-head.get-hist-from-nws <> INTEGER('10':U)
     1024   AND tt-prop-head.get-hist-from-nws <> INTEGER('-10':U) THEN DO:
     1025    ASSIGN
     1026    tt-prop-head.get-hist-from-nws .
     1027   END.
     1028   DO v-ii = 1 TO NUM-ENTRIES(list-general:LIST-ITEM-PAIRS IN FRAME Dialog-Frame) BY 2:
     1029     v-general = v-general + chr(44) +  entry(v-ii + 1, list-general:LIST-ITEM-PAIRS IN FRAME Dialog-Frame).
     1030   END.
     1031   v-general = TRIM(v-general, chr(44)).
     1032   tt-prop-head.general = v-general.
     1033    .
     1034   DO v-ii = 1 TO NUM-ENTRIES(list-general-view:LIST-ITEM-PAIRS IN FRAME Dialog-Frame)  BY 2:
     1035     v-general-view = v-general-view + chr(44) +  entry(v-ii + 1, list-general-view:LIST-ITEM-PAIRS IN FRAME Dialog-Frame).
     1036   END.
     1037   v-general-view = TRIM(v-general-view, chr(44)).
     1038   tt-prop-head.general-view = v-general-view.
     1039    .
     1040   run rul/prop-head1.p ( INPUT p-mode
     1041                   ,INPUT NO
     1042                   ,INPUT-OUTPUT v-rec
     1043                   ,INPUT tt-prop-head.dtm-code
     1044                   ,INPUT tt-prop-head.prop-name
     1045                   ,INPUT tt-prop-head.prop-label
     1046                   ,INPUT tt-prop-head.prop-des
     1047                   ,INPUT tt-prop-head.ref-type
     1048                   ,INPUT tt-prop-head.storage-place
     1049                   ,INPUT tt-prop-head.storage-place-host
     1050                   ,INPUT tt-prop-head.storage-place-obj
     1051                   ,INPUT tt-prop-head.hist-from-prim
     1052                   ,INPUT tt-prop-head.hist-to-nws
     1053                   ,INPUT tt-prop-head.get-hist-from-nws
     1054                   ,INPUT tt-prop-head.nws-to-hist
     1055                   ,INPUT tt-prop-head.smart-nws
     1056                   ,INPUT tt-prop-head.nws-to-cd
     1057                   ,INPUT tt-prop-head.general
     1058                   ,INPUT tt-prop-head.general-view
     1059   ) no-error.
     1060   if error-status:error then do:
     1061   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   define variable fh as widget-handle no-undo .
     1063   define variable hh as widget-handle no-undo .
     1064   define variable rv as character no-undo .
     1065   assign
     1066   rv = entry(1, return-value , chr(4)).
     1067   if rv <> "":U then do:
     1068     assign
     1069     fh = frame Dialog-Frame:first-child
     1070     hh = fh:first-child
     1071     .
     1072     do while valid-handle(hh):
     1073       if hh:name = rv then do:
     1074         APPLY "ENTRY" to hh.
     1075         undo ,
     1076         return error.
     1077       end.
     1078       hh = hh:next-sibling.
     1079     end.
     1080   end.
     1081     undo, return error.
     1082   end.
     1083   p-rec = v-rec.
     1084   END PROCEDURE.
