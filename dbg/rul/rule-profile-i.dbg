        1   DEFINE BUFFER locked_rule-profile FOR ub.rule-profile.
        2   DEFINE BUFFER locked_ruledict FOR ub.ruledict.
        3   DEFINE TEMP-TABLE tt-rule-profile NO-UNDO LIKE ub.rule-profile.
        4   DEFINE NEW SHARED TEMP-TABLE tt-ruledict-param NO-UNDO LIKE ub.ruledict-param.
        5   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        6   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-profile-id AS INTEGER NO-UNDO.
        8   DEFINE INPUT-OUTPUT PARAMETER p-rec AS RECID NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Карточка rule-profile".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define new global shared variable g#language as character no-undo .
      320   if g#language <> '' and g#language <> 'rus':U then do:
      321     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      322   end.
      323   procedure proc-alt-shift-f2:
      324     if not ibs.th.gbl.gbl-var:rcode
      325   then
      326     run gbl\inidebug.p .
      327   end.
      328   procedure proc-alt-shift-f3:
      329     run gbl/prvssinf.p
      330       ( input this-procedure
      331       ) .
      332   end.
      333   define variable v-inform-launched as logical no-undo initial false .
      334   procedure proc-alt-shift-f4:
      335     define variable v-action as character no-undo .
      336     if v-inform-launched = false then do:
      337       assign
      338         v-inform-launched = true
      339       .
      340       run gbl/d-inform.w
      341         (  input self
      342         ,  input this-procedure
      343         , output v-action
      344         ) no-error .
      345       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      346       assign
      347         v-inform-launched = false
      348       .
      349     end.
      350   end.
      351   procedure proc-alt-f1:
      352     run gbl/corrhelp.p
      353       (input this-procedure
      354       ) .
      355   end .
      356   on alt-shift-f2 anywhere do:
      357     run proc-alt-shift-f2.
      358   end.
      359   on alt-shift-f3 anywhere do:
      360     run proc-alt-shift-f3 in this-procedure .
      361   end.
      362   on alt-shift-f4 anywhere do:
      363     run proc-alt-shift-f4 in this-procedure.
      364   end.
      365   on alt-f1 anywhere do:
      366     run proc-alt-f1 in this-procedure .
      367   end.
      368   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   procedure gen-key-rec :
      370     define input  parameter p-tbl-name    as character no-undo.
      371     define input  parameter p-bh_tbl-name as handle    no-undo.
      372     define output parameter p-key-rec     as character no-undo.
      373     do
      374     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      375     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      377     :
      378       define variable fh               as handle    no-undo .
      379       define variable v-ok             as logical   no-undo .
      380       define variable v-inform         as character no-undo .
      381       define variable v-ind            as integer   no-undo .
      382       define variable v-idx-field-qnty as integer   no-undo .
      383       if p-tbl-name = ?
      384         or p-tbl-name = "":U
      385       then do:
      386         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      387       end.
      388       if not p-bh_tbl-name:available then do:
      389         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      390       end.
      391       assign
      392         p-key-rec = p-tbl-name
      393         v-inform  = p-bh_tbl-name:index-information(1)
      394         v-ind     = 2
      395       .
      396       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      397       on error undo, return error
      398       :
      399         assign
      400           v-inform = p-bh_tbl-name:index-information( v-ind )
      401           v-ind    = v-ind + 1
      402         .
      403       end.
      404       if v-inform = ?
      405         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      406         or entry( 3, v-inform, ",":U ) <> "1":U
      407       then do:
      408         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      409       end.
      410       else do:
      411         assign
      412           v-idx-field-qnty = num-entries( v-inform ) - 4
      413         .
      414         if v-idx-field-qnty < 2 then do:
      415           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      416         end.
      417         do v-ind = 1 to v-idx-field-qnty by 2
      418         on error undo, return error
      419         :
      420           assign
      421             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      422             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      423           .
      424         end.
      425       end.
      426       if p-key-rec = ? then do:
      427         assign
      428           p-key-rec = "":U
      429         .
      430         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      431       end.
      432     end.
      433     return.
      434   end procedure.
      435   procedure gen-where-keyr-tab :
      436     define input  parameter i-tableSerach as character no-undo.
      437     define input  parameter i-tablekey   as character  no-undo.
      438     define input  parameter p-key-rec    as character  no-undo.
      439     define input  parameter p-key-handle as handle     no-undo .
      440     define input  parameter p-db-name    as character  no-undo .
      441     define input  parameter p-tt-handle  as handle     no-undo .
      442     define output parameter o-Where      as character  no-undo.
      443     do
      444     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      445     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      446     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      447     :
      448       define variable v-full-tbl-name  as character no-undo .
      449       define variable bh_tbl-name      as handle    no-undo .
      450       define variable fh_key           as handle    no-undo .
      451       define variable fh_search        as handle    no-undo .
      452       define variable v-field-num      as integer   no-undo .
      453       define variable v-count-fld      as integer   no-undo .
      454       define variable v-inform         as character no-undo .
      455       define variable v-ind            as integer   no-undo .
      456       define variable v-idx-field-qnty as integer   no-undo .
      457       define variable v-field-name     as character no-undo .
      458       define variable v-field-val      as character no-undo .
      459       define variable v-word-link      as character no-undo .
      460       define variable vTable           as character no-undo.
      461       define variable bh_tbl-key       as handle    no-undo .
      462       assign
      463         p-key-rec = trim( p-key-rec )
      464       .
      465       if p-key-handle <> ? then do:
      466         if not valid-handle(p-key-handle)
      467            or p-key-handle:type <> "buffer"
      468         then do:
      469           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      470         end.
      471         if num-entries( p-key-rec, chr(3) ) > 1
      472           or p-key-rec = ?
      473           or p-key-rec = "":U
      474         then do:
      475           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      476         end.
      477       end.
      478       else do:
      479         if p-key-rec = ?
      480           or p-key-rec = "":U
      481         then do:
      482           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      483         end.
      484       end.
      485       assign
      486         vTable = entry( 1 , p-key-rec, chr(3) )
      487       .
      488       if p-tt-handle <> ?
      489         and ( not valid-handle(p-tt-handle)
      490               or p-tt-handle:type <> "buffer"
      491             )
      492       then do:
      493         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      494       end.
      495       if p-tt-handle = ? then do:
      496         assign
      497           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      498         .
      499         create buffer bh_tbl-name for table v-full-tbl-name .
      500       end.
      501       else do:
      502         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      503       end.
      504       assign
      505         v-inform = bh_tbl-name:index-information(1)
      506         v-ind    = 2
      507       .
      508       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      509       on error undo, return error
      510       :
      511         assign
      512           v-inform = bh_tbl-name:index-information( v-ind )
      513           v-ind    = v-ind + 1
      514         .
      515       end.
      516       if v-inform = ?
      517         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      518         or entry( 3, v-inform, ",":U ) <> "1":U
      519       then do:
      520         delete object bh_tbl-name no-error.
      521         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      522       end.
      523       assign
      524         v-idx-field-qnty = num-entries( v-inform ) - 4
      525       .
      526       if v-idx-field-qnty < 2 then do:
      527         delete object bh_tbl-name no-error.
      528         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      529       end.
      530       assign
      531         o-where     = "where":U
      532         v-word-link = "":U
      533         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      534         v-count-fld = 0
      535       .
      536       if i-tablekey ne "" and i-tablekey ne ?
      537       then do:
      538         assign
      539           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      540         .
      541         create buffer bh_tbl-key for table v-full-tbl-name .
      542       end.
      543       if i-tableSerach ne "" and i-tableSerach ne ?
      544       then do:
      545         delete object bh_tbl-name no-error.
      546         assign
      547           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      548         .
      549         create buffer bh_tbl-name for table v-full-tbl-name .
      550       end.
      551       block_where:
      552       do v-ind = 1 to v-idx-field-qnty by 2
      553       on error undo, return error
      554       :
      555         assign
      556           v-count-fld = v-count-fld + 1
      557         .
      558         if p-key-handle = ?
      559           and v-count-fld > v-field-num
      560         then do:
      561           leave block_where.
      562         end.
      563         define variable VfieldKeyTable as handle no-undo.
      564         assign
      565           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      566           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      567         .
      568         if     bh_tbl-key ne ?
      569         then do:
      570            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      571            if VfieldKeyTable eq ?
      572            then next block_where.
      573         end.
      574         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      575         then
      576            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      577         else
      578            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      579         if p-key-handle = ? then do:
      580           assign
      581             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      582           .
      583         end.
      584         else do:
      585           assign
      586             fh_key = p-key-handle:buffer-field( v-field-name )
      587           .
      588           if fh_key = ?
      589             or not valid-handle( fh_key )
      590           then do:
      591             delete object bh_tbl-name.
      592             if     bh_tbl-key ne ?
      593             then
      594                delete object bh_tbl-key.
      595             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      596           end.
      597           assign
      598             v-field-val = fh_key:buffer-value
      599           .
      600         end.
      601         if fh_search:data-type ="character":U then do:
      602           assign
      603             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      604             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      605             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      606             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      607             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      608             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      609             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      610             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      611             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      612             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      613             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      614             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      615             v-field-val = substitute( '"&1"', v-field-val )
      616           .
      617         end.
      618         assign
      619           o-where = substitute( "&1 &2", o-where, v-field-val )
      620         .
      621         if v-word-link = "":U then do:
      622           assign
      623             v-word-link = "and":U
      624           .
      625         end.
      626       end.
      627       delete object bh_tbl-name.
      628       if     bh_tbl-key ne ?
      629       then
      630          delete object bh_tbl-key.
      631       if p-key-handle = ?
      632         and v-count-fld <> v-field-num
      633       then do:
      634         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      635       end.
      636     end.
      637   end procedure.
      638   procedure gen-hn-keyr-tab :
      639     define input  parameter i-tableSerach as character no-undo.
      640     define input  parameter i-tablekey   as character no-undo.
      641     define input  parameter p-key-rec    as character no-undo.
      642     define input  parameter p-key-handle as handle    no-undo .
      643     define input  parameter p-db-name    as character no-undo .
      644     define input  parameter p-tt-handle  as handle    no-undo .
      645     define input  parameter p-stts-lock  as integer   no-undo .
      646     define output parameter o-hn         as handle    no-undo.
      647     define variable v-full-tbl-name as character no-undo.
      648     define variable v-where         as character no-undo.
      649     define variable bh_tbl-name     as handle    no-undo.
      650     define variable vTable          as character no-undo.
      651     do
      652     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      653     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      654     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      655         run gen-where-keyr-tab(i-tableSerach,
      656                                i-tablekey,
      657                                p-key-rec,
      658                                p-key-handle,
      659                                p-db-name,
      660                                p-tt-handle,
      661                                output v-where).
      662         if i-tableSerach ne "" and i-tableSerach ne ?
      663         then do:
      664            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      665            create buffer bh_tbl-name for table v-full-tbl-name .
      666         end.
      667         else do:
      668            if p-tt-handle = ? then do:
      669               assign
      670                  vTable = entry( 1 , p-key-rec, chr(3) )
      671               .
      672               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      673               create buffer bh_tbl-name for table v-full-tbl-name .
      674            end.
      675            else do:
      676               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      677            end.
      678         end.
      679         if p-tt-handle = ? then do:
      680            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      681         end.
      682         else do:
      683            bh_tbl-name:find-first( v-where ) no-error .
      684         end.
      685         o-hn = bh_tbl-name.
      686      end.
      687   end procedure.
      688   procedure gen-hn-keyr :
      689     define input  parameter p-key-rec    as character no-undo.
      690     define input  parameter p-key-handle as handle    no-undo .
      691     define input  parameter p-db-name    as character no-undo .
      692     define input  parameter p-tt-handle  as handle    no-undo .
      693     define input  parameter p-stts-lock  as integer   no-undo .
      694     define output parameter o-hn         as handle    no-undo.
      695     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      696   end.
      697   procedure gen-row-keyr :
      698     define input  parameter p-key-rec    as character no-undo.
      699     define input  parameter p-key-handle as handle    no-undo .
      700     define input  parameter p-db-name    as character no-undo .
      701     define input  parameter p-tt-handle  as handle    no-undo .
      702     define input  parameter p-stts-lock  as integer   no-undo .
      703     define output parameter p-tbl-row    as rowid     no-undo.
      704     define output parameter p-tbl-name   as character no-undo.
      705     define variable vHn as handle no-undo.
      706       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      707       p-tbl-row = if vHn:available then vHn:rowid else ?.
      708       p-tbl-name =  vHn:table.
      709       delete object vHn no-error.
      710     if p-tbl-row = ? then do:
      711       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      712     end.
      713     else do:
      714       return.
      715     end.
      716   end procedure.
      717   procedure gen-key-fv :
      718     define input  parameter p-key-rec    as character no-undo .
      719     define output parameter p-field-list as character no-undo .
      720     define output parameter p-value-list as character no-undo.
      721     do
      722     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      723     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      724     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      725     :
      726       define variable v-full-tbl-name  as character no-undo .
      727       define variable bh_tbl-name      as handle    no-undo .
      728       define variable v-tbl-name       as character no-undo .
      729       define variable v-field-num      as integer   no-undo .
      730       define variable v-count-fld      as integer   no-undo .
      731       define variable v-inform         as character no-undo .
      732       define variable v-ind            as integer   no-undo .
      733       define variable v-idx-field-qnty as integer   no-undo .
      734       define variable v-delim-key      as character no-undo .
      735       if p-key-rec = ?
      736         or p-key-rec = "":U
      737       then do:
      738         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      739       end.
      740       assign
      741         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      742         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      743       .
      744       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      745       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      746       assign
      747         v-inform = bh_tbl-name:index-information(1)
      748         v-ind    = 2
      749       .
      750       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      751       on error undo, return error
      752       :
      753         assign
      754           v-inform = bh_tbl-name:index-information( v-ind )
      755           v-ind    = v-ind + 1
      756         .
      757       end.
      758       if v-inform = ?
      759         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      760         or entry( 3, v-inform, ",":U ) <> "1":U
      761       then do:
      762         delete object bh_tbl-name no-error.
      763         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      764       end.
      765       assign
      766         v-idx-field-qnty = num-entries( v-inform ) - 4
      767       .
      768       if v-idx-field-qnty < 2 then do:
      769         delete object bh_tbl-name no-error.
      770         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      771       end.
      772       assign
      773         p-field-list = "":U
      774         p-value-list = "":U
      775         v-delim-key  = "":U
      776         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      777         v-count-fld  = 0
      778       .
      779       block_where:
      780       do v-ind = 1 to v-idx-field-qnty by 2
      781       on error undo, return error
      782       :
      783         assign
      784           v-count-fld = v-count-fld + 1
      785         .
      786         if v-count-fld > v-field-num then do:
      787           leave block_where.
      788         end.
      789         assign
      790           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      791           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      792         .
      793         if v-ind = 1 then do:
      794           assign
      795             v-delim-key = chr(3)
      796           .
      797         end.
      798       end.
      799       delete object bh_tbl-name.
      800       if v-count-fld <> v-field-num then do:
      801         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      802       end.
      803     end.
      804   end procedure.
      805   procedure gen-key-field :
      806     define input  parameter p-table      as character no-undo .
      807     define output parameter p-field-list as character no-undo .
      808     do
      809     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      810     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      811     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      812     :
      813       define variable v-full-tbl-name  as character no-undo .
      814       define variable bh_tbl-name      as handle    no-undo .
      815       define variable v-tbl-name       as character no-undo .
      816       define variable v-field-num      as integer   no-undo .
      817       define variable v-count-fld      as integer   no-undo .
      818       define variable v-inform         as character no-undo .
      819       define variable v-ind            as integer   no-undo .
      820       define variable v-idx-field-qnty as integer   no-undo .
      821       define variable v-delim-key      as character no-undo .
      822       if p-table = ?
      823         or p-table = "":U
      824       then do:
      825         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      826       end.
      827       assign
      828         v-tbl-name      = p-table
      829         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      830       .
      831       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      832       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      833       assign
      834         v-inform = bh_tbl-name:index-information(1)
      835         v-ind    = 2
      836       .
      837       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      838       on error undo, return error
      839       :
      840         assign
      841           v-inform = bh_tbl-name:index-information( v-ind )
      842           v-ind    = v-ind + 1
      843         .
      844       end.
      845       if v-inform = ?
      846         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      847         or entry( 3, v-inform, ",":U ) <> "1":U
      848       then do:
      849         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      850       end.
      851       assign
      852         v-idx-field-qnty = num-entries( v-inform ) - 4
      853       .
      854       if v-idx-field-qnty < 2 then do:
      855         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      856       end.
      857       assign
      858         p-field-list = "":U
      859         v-delim-key  = "":U
      860         v-count-fld  = 0
      861       .
      862       block_where:
      863       do v-ind = 1 to v-idx-field-qnty by 2
      864       on error undo, return error
      865       :
      866         assign
      867           v-count-fld = v-count-fld + 1
      868         .
      869         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      870         if v-ind = 1 then do:
      871           assign
      872             v-delim-key = chr(3)
      873           .
      874         end.
      875       end.
      876       delete object bh_tbl-name.
      877     end.
      878   end procedure.
      879   DEFINE VARIABLE v-param-num-list AS CHARACTER NO-UNDO.
      880   DEFINE BUFFER FIRST_rule-profile FOR ub.rule-profile.
      881   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
      882   DEFINE BUTTON b-action-item-id
      883        IMAGE-UP FILE "btn-down-arrow":U
      884        IMAGE-DOWN FILE "btn-down-arrow":U
      885        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      886        LABEL "Btn 1"
      887        SIZE 3.5 BY 1.33.
      888   DEFINE BUTTON B-exit AUTO-GO
      889        LABEL "&Ввод"
      890        SIZE 10 BY 1
      891        BGCOLOR 8 .
      892   DEFINE BUTTON B-Help
      893        LABEL "Помо&щь"
      894        SIZE 3 BY 1
      895        BGCOLOR 8 .
      896   DEFINE BUTTON b-params
      897        LABEL "Параметры"
      898        SIZE 10 BY 1.
      899   DEFINE BUTTON b-quit AUTO-END-KEY
      900        LABEL "&Отмена"
      901        SIZE 10 BY 1
      902        BGCOLOR 8 .
