      904        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      905        SIZE 46.5 BY 2.13 NO-UNDO.
      906   DEFINE VARIABLE f-action-item-name AS CHARACTER FORMAT "X(256)":U
      907         VIEW-AS TEXT
      908        SIZE 81 BY .67 NO-UNDO.
      909   DEFINE VARIABLE T-parent-feature AS LOGICAL INITIAL no
      910        LABEL "Только в составе комб.профайла"
      911        VIEW-AS TOGGLE-BOX
      912        SIZE 32 BY 1.33 NO-UNDO.
      913   DEFINE QUERY Dialog-Frame FOR
      914         tt-rule-profile SCROLLING.
      915   DEFINE FRAME Dialog-Frame
      916        B-exit AT ROW 1 COL 1
      917        b-quit AT ROW 1 COL 11
      918        b-params AT ROW 1 COL 41 WIDGET-ID 30
      919        B-Help AT ROW 1 COL 95
      920        T-parent-feature AT ROW 2.33 COL 66 WIDGET-ID 64
      921        tt-rule-profile.profile_id AT ROW 2.57 COL 14 COLON-ALIGNED WIDGET-ID 4
      922             LABEL "Профайл"
      923             VIEW-AS FILL-IN NATIVE
      924             SIZE 10 BY 1
      925        tt-rule-profile.short-name AT ROW 2.57 COL 48.5 COLON-ALIGNED WIDGET-ID 36
      926             LABEL "Псевдоним"
      927             VIEW-AS FILL-IN NATIVE
      928             SIZE 11 BY 1
      929        tt-rule-profile.profile-type AT ROW 4.2 COL 14 COLON-ALIGNED WIDGET-ID 14
      930             LABEL "Тип" FORMAT "x(32)"
      931             VIEW-AS COMBO-BOX INNER-LINES 5
      932             LIST-ITEMS "Item 1"
      933             DROP-DOWN-LIST
      934             SIZE 34 BY 1
      935        tt-rule-profile.is_dynamic AT ROW 4.2 COL 50.5 HELP
      936             "" NO-LABEL WIDGET-ID 60
      937             VIEW-AS RADIO-SET HORIZONTAL
      938             RADIO-BUTTONS
      939                       "Редактир", yes,
      940   "Нередактир", no,
      941   "Условно", ?
      942             SIZE 48.5 BY 1
      943        tt-rule-profile.param-code AT ROW 5.27 COL 48.5 COLON-ALIGNED WIDGET-ID 32
      944             LABEL "Конф.параметр, необходимый для включения"
      945             VIEW-AS FILL-IN NATIVE
      946             SIZE 9 BY 1
      947        tt-rule-profile.param-value AT ROW 6.33 COL 48.5 COLON-ALIGNED WIDGET-ID 34
      948             LABEL "Значение параметра"
      949             VIEW-AS FILL-IN NATIVE
      950             SIZE 46.5 BY 1
      951        e-param-value AT ROW 7.4 COL 50.5 NO-LABEL WIDGET-ID 66
      952        tt-rule-profile.action-item-id AT ROW 9.53 COL 48.5 COLON-ALIGNED WIDGET-ID 38
      953             LABEL "Идентификатор права" FORMAT "X(55)"
      954             VIEW-AS FILL-IN NATIVE
      955             SIZE 35.5 BY 1
      956        b-action-item-id AT ROW 9.53 COL 87 WIDGET-ID 50
      957        tt-rule-profile.action-item-context AT ROW 11.67 COL 50.5 NO-LABEL WIDGET-ID 42
      958             VIEW-AS RADIO-SET HORIZONTAL
      959             RADIO-BUTTONS
      960                       "Item 1", "1":U,
      961   "Item 2", "2":U,
      962   "Item 3", "3":U
      963             SIZE 34.5 BY 1.07
      964        tt-rule-profile.custom-param-form AT ROW 12.73 COL 2.5 NO-LABEL WIDGET-ID 54
      965             VIEW-AS RADIO-SET HORIZONTAL
      966             RADIO-BUTTONS
      967                       "Item 1", 1,
      968   "Item 2", 2
      969             SIZE 68 BY 1
      970        tt-rule-profile.reusable-params AT ROW 13.8 COL 49 COLON-ALIGNED WIDGET-ID 58
      971             LABEL "Повторно используемо" FORMAT "x(20)"
      972             VIEW-AS FILL-IN
      973             SIZE 20 BY 1
      974        tt-rule-profile.name AT ROW 15.13 COL 1 NO-LABEL WIDGET-ID 8
      975             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      976             SIZE 98 BY 1.7
      977        tt-rule-profile.documentation AT ROW 17 COL 1 NO-LABEL WIDGET-ID 16
      978             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      979             SIZE 98 BY 3.27
      980        f-action-item-name AT ROW 10.87 COL 15 COLON-ALIGNED NO-LABEL WIDGET-ID 52
      981        "Название" VIEW-AS TEXT
      982             SIZE 14.5 BY .77 AT ROW 10.87 COL 1 WIDGET-ID 10
      983        SPACE(83.99) SKIP(8.95)
      984       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      985            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      986            TITLE ""
      987            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      988   ASSIGN
      989          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      990          FRAME Dialog-Frame:HIDDEN           = TRUE.
      991   ASSIGN
      992          e-param-value:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE.
      993   ON GO OF FRAME Dialog-Frame
      994   DO:
      995     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      996     IF ERROR-STATUS:ERROR THEN DO:
      997         RETURN NO-APPLY.
      998     END.
      999   END.
     1000   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1001   DO:
     1002     APPLY "END-ERROR":U TO SELF.
     1003   END.
     1004   ON CHOOSE OF b-action-item-id IN FRAME Dialog-Frame
     1005   DO:
     1006   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1007   DEFINE BUFFER buf_action-item FOR ub.action-item.
     1008   FIND FIRST buf_action-item NO-LOCK WHERE
     1009            buf_action-item.action-head-code = tt-rule-profile.action-head-code
     1010        AND buf_action-item.action-item-id = tt-rule-profile.action-item-id
     1011       AND buf_action-item.action-item-context = tt-rule-profile.action-item-context NO-ERROR.
     1012     IF AVAILABLE buf_action-item  THEN DO:
     1013         v-rid-list = STRING(RECID(buf_action-item)).
     1014     END.
     1015     run adm/actnitem.w ( INPUT parparentproc
     1016                         ,INPUT "b-sel"
     1017                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1018     IF v-rid-list <> '' THEN DO:
     1019       FIND FIRST buf_action-item NO-LOCK WHERE
     1020                 recid(buf_action-item) = integer(v-rid-list) NO-ERROR.
     1021       IF AVAILABLE buf_action-item THEN DO:
     1022           ASSIGN
     1023           tt-rule-profile.action-head-code = buf_action-item.action-head-code
     1024           tt-rule-profile.action-item-id = buf_action-item.action-item-id
     1025           tt-rule-profile.action-item-context = buf_action-item.action-item-context
     1026           .
     1027           DISPLAY
     1028           tt-rule-profile.action-item-id
     1029           tt-rule-profile.action-item-context
     1030           buf_action-item.action-item-name @ f-action-item-name
     1031           WITH FRAME Dialog-Frame.
     1032       END.
     1033     END.
     1034     ELSE DO:
     1035       BELL.
     1036     END.
     1037   END.
     1038   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1039   DO:
     1040     RUN proc-b-params IN THIS-PROCEDURE NO-ERROR.
     1041     IF ERROR-STATUS:ERROR THEN DO:
     1042         UNDO, RETURN NO-APPLY.
     1043     END.
     1044   END.
     1045   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1046   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1047   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   on help of frame Dialog-Frame
     1049   do:
     1050     run gbl/app_help.p
     1051       (input this-procedure :file-name
     1052       ,input ''
     1053       ,input ?
     1054       ) no-error.
     1055     if error-status :error then do:
     1056       message
     1057         "Ошибка при вызове помощи"
     1058         error-status :get-message(1)
     1059         view-as alert-box .
     1060     end.
     1061   end.
     1062   run minbtn-set in this-procedure .
     1063   on choose of b-help in frame Dialog-Frame
     1064   do:
     1065     apply "help":u to frame Dialog-Frame .
     1066   end.
     1067   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068   procedure minbtn-set :
     1069       do
     1070           on error undo, return error return-value
     1071           :
     1072           define variable ii              as integer       no-undo .
     1073           define variable fh              as widget-handle no-undo .
     1074           define variable hh              as widget-handle no-undo .
     1075           define variable v-h             as handle        extent 4 no-undo .
     1076           define variable v-name-button   as character     no-undo .
     1077           define variable v-help-old-x    as decimal       no-undo .
     1078           define variable v-help-old-y    as decimal       no-undo .
     1079           define variable v-help-old-size as decimal       no-undo .
     1080           define variable v-frame-width   as decimal       no-undo .
     1081           define variable jj              as integer       no-undo .
     1082           do
     1083               on error undo, return error
     1084               :
     1085               assign
     1086                   v-frame-width = frame Dialog-Frame:width - 0.3
     1087                   fh            = frame Dialog-Frame:first-child
     1088                   hh            = fh:first-child
     1089                   ii            = 1
     1090                   .
     1091               do while valid-handle(hh):
     1092                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1093                   do:
     1094                       case lc(hh:name) :
     1095                           when "b-help" then
     1096                               do:
     1097                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1098                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1099                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1100                                   hh:TOOLTIP = "Помощь" .
     1101                                   v-help-old-x = hh:column .
     1102                                   v-help-old-y = hh:row    .
     1103                                   v-help-old-size = hh:width .
     1104                                   hh:width-chars = 2.5 .
     1105                               end.
     1106                           when "b-print" then
     1107                               do:
     1108                                   hh:load-image("cmp/b-print.bmp":u) .
     1109                                   hh:TOOLTIP = "Печать" .
     1110                                   v-h[ii] = hh:handle .
     1111                                   ii = ii + 1 .
     1112                                   hh:width-chars = 3 .
     1113                               end.
     1114                           when "b-history" or
     1115                           when "b-hist" then
     1116                               do:
     1117                                   hh:load-image("cmp/b-hist.bmp":u) .
     1118                                   hh:TOOLTIP = "История" .
     1119                                   v-h[ii] = hh:handle .
     1120                                   ii = ii + 1 .
     1121                                   hh:width-chars = 3 .
     1122                               end.
     1123                           when "b-sch" then
     1124                               do:
     1125                                   hh:load-image("cmp/b-sch.bmp":u) .
     1126                                   hh:TOOLTIP = "Установка Фильтра" .
     1127                                   v-h[ii] = hh:handle .
     1128                                   ii = ii + 1 .
     1129                                   hh:width-chars = 3 .
     1130                               end.
     1131                           when "b-hist-user" then
     1132                               do:
     1133                                   hh:load-image("cmp/b-hist.bmp":u) .
     1134                                   hh:TOOLTIP = "История пользователя" .
     1135                                   ii = ii + 1 .
     1136                               end.
     1137                       end case.
     1138                   end.
     1139                   hh = hh:next-sibling.
     1140               end.
     1141               b-help:column = v-frame-width - b-help:width-chars.
     1142               jj = 0.
     1143               repeat ii = 4 to 1 by -1 :
     1144                   if valid-handle (v-h[ii] ) then
     1145                   do:
     1146                       jj  = jj + 1 .
     1147                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1148                       v-h[ii]:row    = v-help-old-y .
     1149                   end.
     1150               end.
     1151           end.
     1152       end.
     1153   end procedure.
     1154   MAIN-BLOCK:
     1155   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1156      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1157      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1158     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1159       FIND FIRST first_rule-profile EXCLUSIVE-LOCK.
     1160       CREATE tt-rule-profile.
     1161       ASSIGN
     1162       tt-rule-profile.action-head-code = 0
     1163       .
     1164     END.
     1165     else do:
     1166       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1167         FIND FIRST LOCKED_rule-profile EXCLUSIVE-LOCK WHERE
     1168                   LOCKED_rule-profile.profile_id = p-profile-id .
     1169       END.
     1170       IF p-mode = 'ПРОСМОТР':U THEN DO:
     1171           FIND FIRST LOCKED_rule-profile no-LOCK WHERE
     1172                     LOCKED_rule-profile.profile_id = p-profile-id  NO-ERROR.
     1173       END.
     1174       create tt-rule-profile.
     1175       buffer-copy locked_rule-profile to tt-rule-profile.
     1176     end.
     1177     RUN fill-table  IN THIS-PROCEDURE.
     1178     RUN Myenable.
     1179     WAIT-FOR GO OF FRAME Dialog-Frame.
     1180   END.
     1181   RUN disable_UI.
     1182   PROCEDURE disable_UI :
     1183     HIDE FRAME Dialog-Frame.
     1184   END PROCEDURE.
     1185   PROCEDURE enable_UI :
     1186     OPEN QUERY Dialog-Frame FOR EACH tt-rule-profile SHARE-LOCK.
     1187     GET FIRST Dialog-Frame.
     1188     DISPLAY T-parent-feature e-param-value f-action-item-name
     1189         WITH FRAME Dialog-Frame.
     1190     IF AVAILABLE tt-rule-profile THEN
     1191       DISPLAY tt-rule-profile.profile_id tt-rule-profile.short-name
     1192             tt-rule-profile.profile-type tt-rule-profile.is_dynamic
     1193             tt-rule-profile.param-code tt-rule-profile.param-value
     1194             tt-rule-profile.action-item-id tt-rule-profile.action-item-context
     1195             tt-rule-profile.custom-param-form tt-rule-profile.reusable-params
     1196             tt-rule-profile.name tt-rule-profile.documentation
     1197         WITH FRAME Dialog-Frame.
     1198     ENABLE B-exit b-quit b-params B-Help T-parent-feature
     1199            tt-rule-profile.profile_id tt-rule-profile.short-name
     1200            tt-rule-profile.profile-type tt-rule-profile.is_dynamic
     1201            tt-rule-profile.param-code e-param-value
     1202            tt-rule-profile.action-item-id b-action-item-id
     1203            tt-rule-profile.action-item-context tt-rule-profile.custom-param-form
     1204            tt-rule-profile.reusable-params tt-rule-profile.name
     1205            tt-rule-profile.documentation f-action-item-name
     1206         WITH FRAME Dialog-Frame.
     1207     VIEW FRAME Dialog-Frame.
     1208   END PROCEDURE.
     1209   PROCEDURE fill-table :
     1210   DEFINE BUFFER buf_tt-ruledict-param FOR tt-ruledict-param.
     1211   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     1212   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     1213   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     1214   FOR EACH tt-ruledict-param:
     1215     DELETE tt-ruledict-param.
     1216   END.
     1217   CASE p-mode:
     1218     WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
     1219     END.
     1220     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     1221       run gen-key-rec in this-procedure (
     1222                                           input 'rule-profile':U
     1223                                           ,input  buffer locked_rule-profile:handle
     1224                                           ,output v-uniq-key-rec
     1225                                           ).
     1226       FIND FIRST locked_ruledict EXCLUSIVE-LOCK WHERE
     1227                 locked_ruledict.ENTRY-type = 'rule-profile':U
     1228           AND locked_ruledict.uniq-key-rec = v-uniq-key-rec NO-ERROR.
     1229       FOR EACH buf_ruledict-param NO-LOCK WHERE
     1230             buf_ruledict-param.entry-id = locked_ruledict.ENTRY-id:
     1231         CREATE buf_tt-ruledict-param.
     1232         BUFFER-COPY buf_ruledict-param TO buf_tt-ruledict-param.
     1233       END.
     1234     END.
     1235     WHEN 'ПРОСМОТР':U THEN DO:
     1236         run gen-key-rec in this-procedure (
     1237                                             input 'rule-profile':U
     1238                                             ,input  buffer locked_rule-profile:handle
     1239                                             ,output v-uniq-key-rec
     1240                                             ).
     1241         FIND FIRST locked_ruledict no-LOCK WHERE
     1242                   locked_ruledict.ENTRY-type = 'rule-profile':U
     1243             AND locked_ruledict.uniq-key-rec = v-uniq-key-rec NO-ERROR.
     1244         FOR EACH buf_ruledict-param NO-LOCK WHERE
     1245               buf_ruledict-param.entry-id = locked_ruledict.ENTRY-id:
     1246           CREATE buf_tt-ruledict-param.
     1247           BUFFER-COPY buf_ruledict-param TO buf_tt-ruledict-param.
     1248         END.
     1249     END.
     1250   END CASE.
     1251   END PROCEDURE.
     1252   PROCEDURE fill-tt-ruledict-param :
     1253   DEFINE INPUT PARAMETER p-bh AS HANDLE NO-UNDO.
     1254   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1255   FOR EACH tt-ruledict-param
     1256   ON error  UNDO, RETURN ERROR
     1257   ON stop  UNDO, RETURN ERROR:
     1258     ASSIGN
     1259     glog = p-bh:BUFFER-CREATE() NO-ERROR.
     1260     IF NOT glog THEN DO:
     1261        UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1262     END.
     1263     ASSIGN
     1264     glog = p-bh:BUFFER-Copy( BUFFER tt-ruledict-param:HANDLE) NO-ERROR.
     1265     IF NOT glog THEN DO:
     1266        UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1267     END.
     1268   END.
     1269   END PROCEDURE.
     1270   PROCEDURE MyEnable :
     1271   DEFINE BUFFER buf_action-item FOR ub.action-item.
     1272   IF tt-rule-profile.action-item-id <> '' THEN DO:
     1273     FIND FIRST buf_action-item NO-LOCK WHERE
     1274                buf_action-item.action-head-code = tt-rule-profile.action-head-code
     1275            AND buf_action-item.action-item-id = tt-rule-profile.action-item-id
     1276           AND buf_action-item.action-item-context = tt-rule-profile.action-item-context NO-ERROR.
     1277   END.
     1278   ASSIGN
     1279   tt-rule-profile.profile-type:LIST-ITEMS IN FRAME Dialog-Frame = 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U
     1280   e-param-value:SCREEN-VALUE = replace(tt-rule-profile.param-value, chr(4), chr(10))
     1281   tt-rule-profile.action-item-context:RADIO-BUTTONS in FRAME Dialog-Frame =
     1282   'global':U + chr(44) + 'global':U + chr(44) +
     1283   'firm':U + chr(44) + 'firm':U +  chr(44) +
     1284   'object':U + chr(44) + 'object':U
     1285   tt-rule-profile.custom-param-form:RADIO-BUTTONS in FRAME Dialog-Frame =
     1286   "Станд. форма для ввода параметров" + chr(44) + "0" + chr(44) +
     1287   "Спец. форма для ввода параметров" + chr(44) + "1"
     1288   .
     1289   t-parent-feature = (if tt-rule-profile.parent-feature = integer('1':U)
     1290                       then  yes
     1291                       else no ).
     1292   IF AVAILABLE tt-rule-profile THEN
     1293   DISPLAY
     1294   t-parent-feature
     1295   tt-rule-profile.profile-type
     1296   tt-rule-profile.profile_id
     1297   tt-rule-profile.name
     1298   tt-rule-profile.is_dynamic
     1299   tt-rule-profile.param-code
     1300   tt-rule-profile.param-value
     1301   tt-rule-profile.short-name
     1302   tt-rule-profile.documentation
     1303   tt-rule-profile.action-item-context
     1304   tt-rule-profile.action-item-id
     1305   tt-rule-profile.custom-param-form
     1306   tt-rule-profile.reusable-param
     1307   WITH FRAME Dialog-Frame .
     1308   IF available buf_action-item THEN DO:
     1309     DISPLAY
     1310     buf_action-item.action-item-name @ f-action-item-name
     1311     WITH FRAME Dialog-Frame .
     1312   END.
     1313   ELSE DO:
     1314     IF p-mode = 'ПРОСМОТР':U THEN
     1315     HIDE
     1316     tt-rule-profile.action-item-context
     1317     tt-rule-profile.action-item-id
     1318     f-action-item-name
     1319     b-action-item-id
     1320     IN FRAME Dialog-Frame.
     1321   END.
     1322   ENABLE
     1323   B-exit  when p-mode <> 'ПРОСМОТР':U
     1324   b-quit
     1325   B-Help
     1326   b-params WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     1327   t-parent-feature when p-mode <> 'ПРОСМОТР':U
     1328   tt-rule-profile.profile-type  when p-mode <> 'ПРОСМОТР':U
     1329   tt-rule-profile.profile_id when p-mode = 'ДОБАВЛЕНИЕ':U
     1330   tt-rule-profile.name      when p-mode <> 'ПРОСМОТР':U
     1331   tt-rule-profile.short-name when p-mode <> 'ПРОСМОТР':U
     1332   tt-rule-profile.is_dynamic when p-mode <> 'ПРОСМОТР':U
     1333   tt-rule-profile.documentation
     1334   tt-rule-profile.param-code when p-mode <> 'ПРОСМОТР':U
     1335   tt-rule-profile.action-item-context when p-mode <> 'ПРОСМОТР':U
     1336   tt-rule-profile.action-item-id when p-mode <> 'ПРОСМОТР':U
     1337   b-action-item-id when p-mode <> 'ПРОСМОТР':U
     1338   tt-rule-profile.custom-param-form when p-mode <> 'ПРОСМОТР':U
     1339   tt-rule-profile.reusable-param when p-mode <> 'ПРОСМОТР':U
     1340   e-param-value
     1341   WITH FRAME Dialog-Frame .
     1342   if p-mode = 'ПРОСМОТР':U then do:
     1343     assign
     1344     b-quit:label = "&Выход"
     1345     b-quit:column = 1
     1346     tt-rule-profile.NAME:READ-ONLY = YES
     1347     tt-rule-profile.documentation:READ-ONLY = YES
     1348     e-param-value:READ-ONLY = YES
     1349     .
     1350     hide
     1351     b-exit
     1352     tt-rule-profile.reusable-param
     1353     in frame Dialog-Frame .
     1354   end.
     1355   VIEW FRAME Dialog-Frame .
     1356   END PROCEDURE.
     1357   PROCEDURE proc-b-params :
     1358   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1359   define variable v-return-value as character no-undo .
     1360   DEFINE BUFFER buf_tt-ruledict-param FOR tt-ruledict-param.
     1361   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1362     FIND FIRST buf_tt-ruledict-param NO-ERROR.
     1363     IF NOT AVAILABLE buf_tt-ruledict-param THEN DO:
     1364       MESSAGE
     1365       "У этого профайла нет параметров"
     1366       VIEW-AS ALERT-BOX.
     1367       RETURN.
     1368     END.
     1369   END.
     1370   ELSE DO:
     1371     v-param-num-list = '':U.
     1372   END.
     1373   run rul/ruledict-param-s.w ( INPUT parparentproc
     1374                               ,input this-procedure:handle
     1375                               ,INPUT (IF p-mode = 'ИЗМЕНЕНИЕ':U
     1376                                       OR p-mode = 'ДОБАВЛЕНИЕ':U
     1377                                       THEN "b-add"
     1378                                       ELSE "":U)
     1379                               ,INPUT (if p-mode = 'ПРОСМОТР':U
     1380                                       then "entry-id"
     1381                                       else 'ИЗМЕНЕНИЕ':U)
     1382                               ,INPUT (if p-mode = 'ИЗМЕНЕНИЕ':U
     1383                                       or p-mode = 'ПРОСМОТР':U
     1384                                       then locked_ruledict.entry-id
     1385                                       else 0)
     1386                               ,input 'rule-profile':U
     1387                               ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1388   IF ERROR-STATUS:ERROR THEN DO:
     1389      message error-status:get-message(1) view-as alert-box .
     1390      UNDO, RETURN ERROR.
     1391   END.
     1392   v-return-value = return-value .
     1393   if (p-mode = 'ИЗМЕНЕНИЕ':U
     1394   or p-mode = 'ДОБАВЛЕНИЕ':U)
     1395   and v-return-value <> "quit" then do:
     1396     FOR EACH tt-ruledict-param:
     1397       IF LOOKUP(string(tt-ruledict-param.param-num), v-param-num-list) = 0 THEN DO:
     1398           DELETE tt-ruledict-param.
     1399       END.
     1400     END.
     1401   end.
     1402   END PROCEDURE.
     1403   PROCEDURE proc-save :
     1404   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
     1405   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1406       RETURN.
     1407   END.
     1408   v-rec = p-rec.
     1409   ASSIGN
     1410   FRAME Dialog-Frame
     1411   t-parent-feature
     1412   tt-rule-profile.profile-type
     1413   tt-rule-profile.profile_id
     1414   tt-rule-profile.NAME
     1415   tt-rule-profile.is_dynamic
     1416   tt-rule-profile.param-code
     1417   tt-rule-profile.param-value = replace(e-param-value:SCREEN-VALUE, chr(10), chr(4))
     1418   tt-rule-profile.short-name
     1419   tt-rule-profile.action-item-context
     1420   tt-rule-profile.action-item-id
     1421   tt-rule-profile.custom-param-form
     1422   tt-rule-profile.reusable-params
     1423   tt-rule-profile.parent-feature = (if t-parent-feature
     1424                                     then integer('1':U)
     1425                                     else integer('0':U))
     1426   .
     1427   run rul/rule-profile1.p ( INPUT p-mode
     1428                   ,INPUT NO
     1429                   ,INPUT-OUTPUT v-rec
     1430                   ,INPUT tt-rule-profile.profile_id
     1431                   ,INPUT tt-rule-profile.profile-type
     1432                   ,INPUT tt-rule-profile.name
     1433                   ,INPUT tt-rule-profile.is_dynamic
     1434                   ,INPUT tt-rule-profile.documentation:screen-value
     1435                   ,INPUT tt-rule-profile.param-code
     1436                   ,INPUT tt-rule-profile.param-value
     1437                   ,INPUT tt-rule-profile.short-name
     1438                   ,INPUT tt-rule-profile.action-head-code
     1439                   ,INPUT tt-rule-profile.action-item-id
     1440                   ,INPUT tt-rule-profile.action-item-context
     1441                   ,INPUT tt-rule-profile.custom-param-form
     1442                   ,input tt-rule-profile.reusable-params
     1443                   ,input tt-rule-profile.parent-feature
     1444                   ,input table tt-ruledict-param
     1445                   ) no-error.
     1446   if error-status:error then do:
     1447   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   define variable fh as widget-handle no-undo .
     1449   define variable hh as widget-handle no-undo .
     1450   define variable rv as character no-undo .
     1451   assign
     1452   rv = entry(1, return-value , chr(4)).
     1453   if rv <> "":U then do:
     1454     assign
     1455     fh = frame Dialog-Frame:first-child
     1456     hh = fh:first-child
     1457     .
     1458     do while valid-handle(hh):
     1459       if hh:name = rv then do:
     1460         APPLY "ENTRY" to hh.
     1461         undo ,
     1462         return error.
     1463       end.
     1464       hh = hh:next-sibling.
     1465     end.
     1466   end.
     1467     undo, return error.
     1468   end.
     1469   p-rec = v-rec.
     1470   END PROCEDURE.
     1471   PROCEDURE save-tt-ruledict-param :
     1472   DEFINE INPUT PARAMETER p-bh AS HANDLE NO-UNDO.
     1473   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1474   FIND FIRST tt-ruledict-param WHERE
     1475              tt-ruledict-param.param-num = p-bh::param-num NO-ERROR.
     1476   IF NOT AVAILABLE tt-ruledict-param THEN DO:
     1477      CREATE tt-ruledict-param.
     1478   END.
     1479   ASSIGN
     1480   glog = BUFFER tt-ruledict-param:handle:BUFFER-Copy( p-bh) NO-ERROR.
     1481   IF NOT glog THEN DO:
     1482     UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1483   END.
     1484   v-param-num-list = v-param-num-list + chr(44) + STRING( tt-ruledict-param.param-num).
     1485   END PROCEDURE.
