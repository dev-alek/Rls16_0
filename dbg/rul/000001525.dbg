     1749   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1750   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1751   define buffer buf_temp-cmd for temp-cmd.
     1752   define buffer buf_dis-card-sale_obj for temp-d-card.
     1753   define variable vh_dis-card-sale_obj as handle no-undo .
     1754    define variable p-r-b as character no-undo.
     1755    define variable p-is-over as logical no-undo.
     1756    define variable p-rule-num as integer no-undo.
     1757    define variable p-prev-rule-num as integer no-undo.
     1758    define variable p-tot-caller-id as character no-undo.
     1759    define variable p-nd-caller-id as character no-undo.
     1760   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1762   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1763   procedure dis-hsth_write-dis-host-rul :
     1764   define parameter buffer buf_dis-host for ub.dis-host .
     1765   define input parameter p-type as character no-undo .
     1766   define input parameter p-emitent-host-code as integer no-undo .
     1767   define input parameter p-dtm-code as integer no-undo .
     1768   define input parameter p-action as integer no-undo .
     1769   define variable v-date as date      no-undo.
     1770   define variable v-time  as integer   no-undo.
     1771   define variable v-rec-ord1 as integer no-undo .
     1772   define variable v-rec-ord2 as integer no-undo .
     1773   define variable v-rec-ord3 as integer no-undo .
     1774   define variable v-rec-hno as integer no-undo .
     1775   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1776   define buffer buf_c-dis-host for ub.c-dis-host.
     1777   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1778   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1779   do
     1780   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1781   :
     1782     if not available buf_dis-host then do:
     1783       message
     1784         vss-workfile vss-revision vss-description skip
     1785         "Ошибка задания входных параметров" skip
     1786         "Не определена ДК" skip
     1787         view-as alert-box error .
     1788       undo, return error .
     1789     end.
     1790     find first buf_temp-hist-nws-option where
     1791               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1792           and buf_temp-hist-nws-option.db-num = g#db-num
     1793           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1794           and buf_temp-hist-nws-option.charkey_one = p-type
     1795           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1796     if not available buf_temp-hist-nws-option then do:
     1797       find first last_temp-hist-nws-option where
     1798                last_temp-hist-nws-option.db-num = g#db-num
     1799            and last_temp-hist-nws-option.hn-id < 0 no-error.
     1800       create buf_temp-hist-nws-option.
     1801       assign
     1802       buf_temp-hist-nws-option.db-num = g#db-num
     1803       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1804                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1805                                   else -1 )
     1806       buf_temp-hist-nws-option.table-name = 'dis-host':U
     1807       buf_temp-hist-nws-option.key#_one = p-dtm-code
     1808       buf_temp-hist-nws-option.charkey_one = p-type
     1809       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1810       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1811       .
     1812   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1813   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1814     (input  g#db-num
     1815     ,input  buffer buf_temp-hist-nws-option:handle
     1816     )  .
     1817     end.
     1818     if not g#news
     1819     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1820       return.
     1821     end.
     1822     if g#news
     1823     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1824       return.
     1825     end.
     1826     run cur-time in this-procedure(output v-date, output v-time).
     1827     create buf_c-dis-host.
     1828     buffer-copy buf_dis-host to buf_c-dis-host
     1829     assign
     1830     buf_c-dis-host.d-card             = buf_dis-host.d-card
     1831     buf_c-dis-host.host-code          = buf_dis-host.host-code
     1832     buf_c-dis-host.card-num           = buf_dis-host.card-num
     1833     buf_c-dis-host.dt-code            = buf_dis-host.dt-code
     1834     buf_c-dis-host.main-card          = buf_dis-host.main-card
     1835     buf_c-dis-host.first-main-card    = buf_dis-host.first-main-card
     1836     buf_c-dis-host.first-card         = buf_dis-host.first-card
     1837     buf_c-dis-host.chip-num           = next-value (s-dc-chip, ub)
     1838     buf_c-dis-host.corr-time          = v-time
     1839     buf_c-dis-host.corr-user-db-num   = g#db-num
     1840     buf_c-dis-host.corr-user-name     = (if g#news
     1841                                         then (chr(4) +  'СПН':U)
     1842                                         else (if g#esys
     1843                                               then (chr(4) +  'ВС':U)
     1844                                               else g#userid)
     1845                                         )
     1846     buf_c-dis-host.corr-date          = v-date
     1847     .
     1848     create buf_c-dc-hist.
     1849     buffer-copy buf_c-dis-host to buf_c-dc-hist
     1850     assign
     1851     buf_c-dc-hist.action = p-action
     1852     buf_c-dc-hist.subject = 'dis-host':U
     1853     buf_c-dc-hist.host-code =  buf_dis-host.host-code
     1854     buf_c-dc-hist.is-news = g#news
     1855     buf_c-dc-hist.source-type = p-doc-type
     1856     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1857                                  then '':U
     1858                                  else p-doc-code)
     1859     .
     1860     if g#db-num > 0
     1861     or (g#db-num = 0
     1862     and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1863     then do:
     1864       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-host':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-host:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-host':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
