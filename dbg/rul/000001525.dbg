     2624           assign
     2625           v-string[v-jj] = v-string[v-jj]  + (if v-string[v-jj] = '' then '' else "|") +  string(buf_term-dis-rule.tot-sum)
     2626           v-dis-kat-string[v-jj] = v-dis-kat-string[v-jj]  + (if v-dis-kat-string[v-jj] = '' then '' else "|") +  string(buf_term-dis-rule.dis-kat)
     2627           .
     2628         end.
     2629         if buf_term-dis-rule.tot-sum <= p-tot-sum then do:
     2630           if v-start
     2631           or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
     2632           then do:
     2633             assign
     2634             v-start = no
     2635             v-delta = p-tot-sum - buf_term-dis-rule.tot-sum
     2636             v-sum-step[v-jj] = buf_term-dis-rule.tot-sum
     2637             .
     2638           end.
     2639         end.
     2640       end.
     2641       v-step[v-jj] = lookup(string(v-sum-step[v-jj]), v-string[v-jj], "|").
     2642     end.
     2643   end.
     2644   if v-step[2] - v-step[1]  >= 0 then do:
     2645     if v-step[1] > 0 then do:
     2646     v-dis-kat-value = integer(entry(v-step[1], v-dis-kat-string[1], "|")).
     2647   end.
     2648   end.
     2649   else do:
     2650     if v-step[1] > 1 then do:
     2651       v-dis-kat-value = integer(entry(v-step[1] - 1, v-dis-kat-string[1], "|")).
     2652     end.
     2653   end.
     2654   return v-dis-kat-value.
     2655   end function.
     2656   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2657   FUNCTION get_current_nd_sum-id_by-date returns character(
     2658                                                       input p-date as date
     2659                                                     , input p-caller-id as character ):
     2660   define buffer buf_prop-ref for ub.prop-ref.
     2661   define variable v-date-char as character no-undo .
     2662   define buffer buf_dis-card-type for ub.dis-card-type.
     2663   assign
     2664   v-date-char = string(year(p-date), "9999") + "/" +
     2665                 string(month(p-date), "99") + "/" +
     2666               string(day(p-date), "99")
     2667   v-date-char = v-date-char + "-" + v-date-char
     2668   .
     2669   find last buf_prop-ref no-lock where
     2670             buf_prop-ref.dtm-code = 7
     2671         and buf_prop-ref.sum-id <= v-date-char
     2672         and buf_prop-ref.caller_id = p-caller-id use-index idtsum
     2673         no-error .
     2674   if not available buf_prop-ref then do:
     2675     return chr(63).
     2676   end.
     2677   return buf_prop-ref.sum-id.
     2678   end function.
