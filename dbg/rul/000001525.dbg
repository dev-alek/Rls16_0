     1214   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   procedure get-gate-file-name :
     1216   define input parameter p-gate-rec as character no-undo .
     1217   define output  parameter p-gate-file-name as character no-undo .
     1218   define buffer buf_clob-data for ub.clob-data.
     1219   define variable v-tbl-row as rowid no-undo .
     1220   define variable v-tbl-name as character no-undo .
     1221   run gen-row-keyr in this-procedure ( input p-gate-rec
     1222                                       ,input ?
     1223                                       ,input "ub"
     1224                                       ,input ?
     1225                                       ,input no-lock
     1226                                       ,output v-tbl-row
     1227                                       ,output v-tbl-name) no-error.
     1228   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1229                                                           ,vss-include-info13
     1230                                                           ,p-gate-rec).
     1231   find first buf_clob-data no-lock where
     1232             rowid(buf_clob-data) = v-tbl-row no-error.
     1233   if not available buf_clob-data then do:
     1234     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1235                                                             ,vss-include-info13
     1236                                                             ,p-gate-rec).
     1237   end.
     1238   p-gate-file-name = buf_clob-data.file-name.
     1239   end procedure.
     1240   procedure get-gate-rec :
     1241   define input  parameter p-gate-name as character no-undo .
     1242   define output parameter p-gate-rec as character no-undo .
     1243   define buffer buf_clob-bind for ub.clob-bind.
     1244   define buffer buf_clob-data for ub.clob-data.
     1245   main-block:
     1246   do
     1247   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1248   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1249   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1250   :
     1251       find first buf_clob-bind no-lock where
     1252                 buf_clob-bind.uniq-key-rec = p-gate-name
     1253             and buf_clob-bind.field-name = '':U
     1254             and buf_clob-bind.part-num = 1
     1255             and buf_clob-bind.resource-type = 'gate':U
     1256             no-error.
     1257       if not available buf_clob-bind then do:
     1258         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1259                                         , p-gate-name
     1260                                         ).
     1261       end.
     1262       find first buf_clob-data no-lock where
     1263                 buf_clob-data.db-num = buf_clob-bind.db-num
     1264             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1265       if not available buf_clob-data then do:
     1266         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1267                                         , buf_clob-bind.db-num
     1268                                         , buf_clob-bind.int64-id
     1269                                         , p-gate-name
     1270                                         ).
     1271       end.
     1272       run gen-key-rec in this-procedure ( input 'clob-data':U
     1273                                 ,input buffer buf_clob-data:handle
     1274                                 ,output p-gate-rec).
     1275   end.
     1276   end procedure.
     1277   procedure get-gate-by-name :
     1278   define input  parameter p-gate-name as character no-undo .
     1279   define output parameter p-gate-rec as character no-undo .
     1280   define output parameter p-dsh as handle no-undo .
     1281   define input-output  parameter p-xmlh as handle no-undo .
     1282   define variable v-ii as integer   no-undo .
     1283   define variable glog as logical   no-undo .
     1284   define variable v-longchar as longchar no-undo .
     1285   define variable v-txmlh as handle no-undo .
     1286   define variable v-db-num as integer no-undo .
     1287   define variable v-int64-id as int64 no-undo .
     1288   define buffer buf_clob-bind for ub.clob-bind.
     1289   define buffer buf_clob-data for ub.clob-data.
     1290   main-block:
     1291   do
     1292   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1293   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1294   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1295   :
     1296       find first buf_clob-bind no-lock where
     1297                 buf_clob-bind.uniq-key-rec = p-gate-name
     1298             and buf_clob-bind.field-name = '':U
     1299             and buf_clob-bind.part-num = 1
     1300             and buf_clob-bind.resource-type = 'gate':U
     1301             no-error.
     1302       if not available buf_clob-bind then do:
     1303         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1304                                         , p-gate-name
     1305                                         ).
     1306       end.
     1307       find first buf_clob-data no-lock where
     1308                 buf_clob-data.db-num = buf_clob-bind.db-num
     1309             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1310       if not available buf_clob-data then do:
     1311         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1312                                         , buf_clob-bind.db-num
     1313                                         , buf_clob-bind.int64-id
     1314                                         , p-gate-name
     1315                                         ).
     1316       end.
     1317       assign
     1318       v-longchar = buf_clob-data.cdata
     1319       .
     1320       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1321       if error-status :error then do:
     1322         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1323       end.
     1324       create dataset p-dsh .
     1325       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1326                                     , v-longchar
     1327                                     , ?
     1328                                     , ?
     1329                                     , ?
     1330                                     ) no-error.
     1331       v-longchar = '':U.
     1332       if error-status :error
     1333       or not glog
     1334       then do:
     1335         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1336       end.
     1337       if not valid-handle(p-xmlh)
     1338       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1339         create temp-table v-txmlh.
     1340         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1341         v-txmlh:temp-table-prepare("temp-xml-tables").
     1342         p-xmlh = v-txmlh:default-buffer-handle.
     1343       end.
     1344       run gen-key-rec in this-procedure ( input 'clob-data':U
     1345                                 ,input buffer buf_clob-data:handle
     1346                                 ,output p-gate-rec).
     1347       do v-ii = 1 to p-dsh:num-buffers:
     1348         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1349         if not p-xmlh:available then do:
     1350           p-xmlh:buffer-create().
     1351           assign
     1352           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1353           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1354           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1355           p-xmlh::gate-handle_ = p-dsh
     1356           p-xmlh::uniq-gate-rec = p-gate-rec
     1357           p-xmlh::gate-name = p-dsh:name
     1358           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1359           .
     1360           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1361             assign
     1362             p-xmlh::order = -3.
     1363           end.
     1364         end.
     1365       end.
     1366   end.
     1367   end procedure.
     1368   procedure get-gate-by-rec :
     1369   define input  parameter p-gate-rec as character no-undo .
     1370   define output parameter p-dsh as handle no-undo .
     1371   define input-output  parameter p-xmlh as handle no-undo .
     1372   define input-output parameter p-longchar  as longchar no-undo .
     1373   define variable v-ii as integer   no-undo .
     1374   define variable glog as logical   no-undo .
     1375   define variable v-rowid as rowid no-undo .
     1376   define variable v-tbl-name as character no-undo .
     1377   define variable v-longchar as longchar no-undo .
     1378   define variable v-txmlh as handle no-undo .
     1379   define buffer buf_clob-data for ub.clob-data.
     1380   main-block:
     1381   do
     1382   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1383   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1384   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1385   :
     1386     run gen-row-keyr in this-procedure (
     1387                                           input  p-gate-rec
     1388                                           ,input  ?
     1389                                           ,input  "ub"
     1390                                           ,input  ?
     1391                                           ,input  NO-LOCK
     1392                                           ,output v-rowid
     1393                                           ,output v-tbl-name   ) no-error.
     1394       find first buf_clob-data no-lock where
     1395                 rowid(buf_clob-data) = v-rowid  no-error.
     1396       if not available buf_clob-data then do:
     1397         undo, return error substitute("Не найден CLOB  &1"
     1398                                         , p-gate-rec
     1399                                         ).
     1400       end.
     1401       assign
     1402       v-longchar = buf_clob-data.cdata
     1403       .
     1404       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1405       if error-status :error then do:
     1406         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1407       end.
     1408       create dataset p-dsh .
     1409       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1410                                     , v-longchar
     1411                                     , ?
     1412                                     , ?
     1413                                     , ?
     1414                                     ) no-error.
     1415       define variable v-esm as character no-undo .
     1416       v-esm = error-status:get-message(1) .
     1417       if p-longchar <> ? then do:
     1418         p-longchar = v-longchar.
     1419       end.
     1420       v-longchar = '':U.
     1421       if error-status :error
     1422       or not glog
     1423       then do:
     1424         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1425                                      , p-gate-rec
     1426                                      , p-gate-rec
     1427                                      , v-esm
     1428                                      ).
     1429       end.
     1430       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1431       if not valid-handle(p-xmlh)
     1432       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1433         create temp-table v-txmlh.
     1434         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1435         v-txmlh:temp-table-prepare("temp-xml-tables").
     1436         p-xmlh = v-txmlh:default-buffer-handle.
     1437       end.
     1438       do v-ii = 1 to p-dsh:num-buffers:
     1439         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1440         if not p-xmlh:available then do:
     1441           p-xmlh:buffer-create().
     1442           assign
     1443           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1444           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1445           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1446           p-xmlh::gate-handle_ = p-dsh
     1447           p-xmlh::uniq-gate-rec = p-gate-rec
     1448           p-xmlh::gate-name = p-dsh:name
     1449           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1450           .
     1451           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1452             assign
     1453             p-xmlh::order = -3.
     1454           end.
     1455           p-xmlh:buffer-release().
     1456         end.
     1457       end.
     1458   end.
     1459   end procedure.
     1460   procedure get-gate-by-file :
     1461   define input  parameter p-schema-file-name as character no-undo .
     1462   define input  parameter p-gate-rec as character no-undo .
     1463   define output parameter p-dsh as handle no-undo .
     1464   define input-output  parameter p-xmlh as handle no-undo .
     1465   define variable v-ii as integer   no-undo .
     1466   define variable glog as logical   no-undo .
     1467   define variable v-rowid as rowid no-undo .
     1468   define variable v-tbl-name as character no-undo .
     1469   define variable v-longchar as longchar no-undo .
     1470   define variable v-txmlh as handle no-undo .
     1471   main-block:
     1472   do
     1473   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1))
     1474   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info13 )
     1475   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info13 )
     1476   :
     1477       COPY-LOB
     1478       FROM  FILE p-schema-file-name
     1479       TO  OBJECT v-longchar
     1480       no-convert
     1481       NO-ERROR .
     1482       if error-status :error then do:
     1483           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1484                                     , p-schema-file-name
     1485                                 , chr(10)
     1486                                 , error-status:get-message(1) ).
     1487       end.
     1488       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1489       if error-status :error then do:
     1490         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1491       end.
     1492       create dataset p-dsh .
     1493       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1494                                     , v-longchar
     1495                                     , ?
     1496                                     , ?
     1497                                     , ?
     1498                                     ) no-error.
     1499       v-longchar = ''.
     1500       if error-status :error
     1501       or not glog
     1502       then do:
     1503         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1504                                      , p-schema-file-name
     1505                                      ,chr(10)
     1506                                      , error-status:get-message(1)
     1507                                      ).
     1508       end.
     1509       if not valid-handle(p-xmlh)
     1510       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1511         create temp-table v-txmlh.
     1512         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1513         v-txmlh:temp-table-prepare("temp-xml-tables").
     1514         p-xmlh = v-txmlh:default-buffer-handle.
     1515       end.
     1516       do v-ii = 1 to p-dsh:num-buffers:
     1517         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1518                                      ,p-dsh:get-buffer-handle(v-ii):name
     1519                                      ,p-gate-rec
     1520                                      )) no-error.
     1521         if not p-xmlh:available then do:
     1522           p-xmlh:buffer-create().
     1523           assign
     1524           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1525           p-xmlh::uniq-gate-rec = p-gate-rec
     1526           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1527           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1528           p-xmlh::gate-handle_ = p-dsh
     1529           p-xmlh::gate-name = p-dsh:name
     1530           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1531           .
     1532           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1533             assign
     1534             p-xmlh::order = -3.
     1535           end.
     1536           p-xmlh:buffer-release().
     1537         end.
     1538       end.
     1539   end.
     1540   end procedure.
     1541   procedure gate-clear :
     1542   define input  parameter p-dsh as handle no-undo .
     1543   define input  parameter p-xmlh as handle no-undo .
     1544   define variable v-dsh as handle no-undo .
     1545   define variable v-th as handle no-undo .
     1546     do
     1547     on error undo, return error return-value
     1548     :
     1549       if valid-handle(p-dsh) then do:
     1550         delete object p-dsh.
     1551         v-dsh = p-dsh.
     1552         p-dsh = ?.
     1553       end.
     1554       repeat while true:
     1555         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1556                            , share-lock) no-error.
     1557         if p-xmlh:available then do:
     1558           assign
     1559           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1560           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1561           and valid-handle(v-th)
     1562           and v-th:dynamic = yes
     1563           then do:
     1564             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1565             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1566           end.
     1567           p-xmlh:buffer-delete().
     1568         end.
     1569         else do:
     1570           leave.
     1571         end.
     1572       end.
     1573       if p-xmlh:dynamic = yes
     1574       and valid-handle(p-xmlh)
     1575       then do:
     1576         delete object p-xmlh:table-handle.
     1577         p-xmlh = ?.
     1578       end.
     1579       v-dsh = ?.
     1580     end.
     1581   end procedure.
     1582   procedure all-gates-clear :
     1583   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1584   do
     1585   on error undo, return error
     1586   :
     1587     for each buf_temp-xml-tables
     1588     break
     1589     by buf_temp-xml-tables.uniq-gate-rec
     1590     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1591     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1592     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1593     :
     1594         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1595           delete object buf_temp-xml-tables.gate-handle_.
     1596           buf_temp-xml-tables.gate-handle_ = ?.
     1597         end.
     1598         if valid-handle(buf_temp-xml-tables.table-handle_)
     1599         and buf_temp-xml-tables.table-handle_:dynamic = no
     1600         then do:
     1601           delete object buf_temp-xml-tables.table-handle_.
     1602           buf_temp-xml-tables.table-handle_ = ?.
     1603         end.
     1604         delete buf_temp-xml-tables.
     1605     end.
     1606   end.
     1607   end procedure.
     1608   procedure fix-schemalocation :
     1609   define input-output  parameter p-longchar as longchar no-undo .
     1610   DEFINE VARIABLE hdoc AS HANDLE.
     1611   DEFINE VARIABLE hroot AS HANDLE.
     1612   DEFINE VARIABLE hnode-child AS HANDLE.
     1613   DEFINE VARIABLE hnode-attr AS HANDLE.
     1614   define variable v-jj as integer   no-undo .
     1615   define variable ok as logical   no-undo .
     1616   define variable v-path1                    as character                no-undo .
     1617   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1618   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1619   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1620   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1621   define variable v-schema-location          as character                no-undo .
     1622   do
     1623   on error undo, return error return-value
     1624   :
     1625     CREATE X-DOCUMENT hdoc.
     1626     CREATE X-noderef hroot.
     1627     CREATE X-noderef hnode-child.
     1628     CREATE X-noderef hnode-attr.
     1629     hdoc:load("longchar", p-longchar, no) no-error.
     1630     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1631     hdoc:get-document-element(hroot).
     1632     _repeat:
     1633     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1634       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1635       if not ok then next.
     1636       if hNode-Child:local-name = "include"
     1637       then do:
     1638         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1639           v-schema-location = hnode-attr:node-value.
     1640           run gbl/filename.p (
     1641                           input "exe/" + hnode-attr:node-value
     1642                         ,output v-full-path1
     1643                         ,output v-path1
     1644                         ,output v-file-name1
     1645                         ,output v-file-name-no-ext1
     1646                         ,output v-file-name-ext1
     1647                         ) no-error .
     1648           if error-status :error then do:
     1649             delete object hnode-attr.
     1650             delete object hnode-child.
     1651             delete object hroot.
     1652             delete object hdoc.
     1653             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1654           end.
     1655         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1656         leave  _repeat.
     1657       end.
     1658     END.
     1659     hdoc:save("longchar", p-longchar).
     1660     delete object hnode-attr.
     1661     delete object hnode-child.
     1662     delete object hroot.
     1663     delete object hdoc.
     1664   end.
     1665   end procedure.
     1666   procedure gate-clb_fill-xml-tables :
     1667   define input parameter p-dsh as handle no-undo .
     1668   define input-output parameter p-xmlh as handle no-undo .
     1669   define variable v-ii as integer no-undo .
     1670     do
     1671     on error undo, return error
     1672     :
     1673       do v-ii = 1 to p-dsh:num-buffers:
     1674         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1675         if not p-xmlh:available then do:
     1676           p-xmlh:buffer-create().
     1677           assign
     1678           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1679           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1680           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1681           p-xmlh::gate-handle_ = p-dsh
     1682           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1683           p-xmlh::gate-name = p-dsh:name
     1684           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1685           .
     1686           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1687             assign
     1688             p-xmlh::order = -3.
     1689           end.
     1690           p-xmlh:buffer-release().
     1691         end.
     1692       end.
     1693     end.
     1694   end procedure.
     1695   procedure all-gates-empty :
     1696   define buffer buf_temp-xml-tables for temp-xml-tables.
     1697   do
     1698   on error undo, return error
     1699   :
     1700     for each buf_temp-xml-tables
     1701     break
     1702     by buf_temp-xml-tables.uniq-gate-rec
     1703     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1704     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1705     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1706     :
     1707       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1708         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1709       end.
     1710     end.
     1711   end.
     1712   end procedure.
     1713   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
