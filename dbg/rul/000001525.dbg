     2732   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2733   FUNCTION get_sum-id_by-date_dct returns character
     2734                              ( input p-date as date
     2735                               , input p-caller-id as character
     2736                               , input p-emitent-host-code as integer
     2737                               , input p-type as character
     2738                               ):
     2739   define variable v-date-char as character no-undo .
     2740   define buffer buf_prop-ref-call for ub.prop-ref-call.
     2741   define buffer buf_prop-ref for ub.prop-ref.
     2742   define buffer buf_dis-card-type for ub.dis-card-type.
     2743   assign
     2744   v-date-char = string(year(p-date), "9999") + "/" +
     2745                 string(month(p-date), "99") + "/" +
     2746               string(day(p-date), "99")
     2747   v-date-char = v-date-char + "-" + v-date-char
     2748   .
     2749   find last buf_prop-ref no-lock where
     2750             buf_prop-ref.dtm-code = 5
     2751         and buf_prop-ref.sum-id <= v-date-char
     2752         and buf_prop-ref.caller_id = p-caller-id use-index idtsum
     2753         no-error .
     2754   if not available buf_prop-ref then do:
     2755    return chr(63).
     2756   end.
     2757   find first buf_dis-card-type no-lock where
     2758             buf_Dis-card-type.type = p-type
     2759         and buf_Dis-card-type.emitent-host-code = p-emitent-host-code
     2760         and buf_Dis-card-type.host-code = 0
     2761         and buf_Dis-card-type.obj-type = '':U
     2762         and buf_Dis-card-type.obj-code = 0 no-error.
     2763   if not available buf_dis-card-type then do:
     2764    return chr(63).
     2765   end.
     2766   find first buf_prop-ref-call no-lock where
     2767             buf_prop-ref-call.call_id = buf_Dis-card-type.uniq-key-rec
     2768         and buf_prop-ref-call.dt-code = buf_prop-ref.dt-code no-error.
     2769   if not available buf_prop-ref-call then do:
     2770     return chr(63).
     2771   end.
     2772   return  buf_prop-ref.sum-id.
     2773   end FUNCTION.
