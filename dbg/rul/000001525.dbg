     2711                 string(month(p-date), "99") + "/" +
     2712               string(day(p-date), "99")
     2713   v-date-char = v-date-char + "-" + v-date-char
     2714   .
     2715   find last buf_prop-ref no-lock where
     2716             buf_prop-ref.dtm-code = 5
     2717         and buf_prop-ref.sum-id <= v-date-char
     2718         and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
     2719   if not available buf_prop-ref then do:
