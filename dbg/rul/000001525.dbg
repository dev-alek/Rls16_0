     3076    find first buf_rule-call-param no-lock where
     3077   buf_rule-call-param.codex_id = p-codex-id
     3078   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3079   and buf_rule-call-param.call_id = p-call-id
     3080   and buf_rule-call-param.order_id = p-order-id
     3081   and buf_rule-call-param.rule_id = p-rule-id
     3082   and buf_rule-call-param.param-name = "p-r-b"
     3083    no-error.
     3084   if available buf_rule-call-param then do:
     3085   assign p-r-b = buf_rule-call-param.param-value-character.
     3086   end.
     3087    find first buf_rule-call-param no-lock where
     3088   buf_rule-call-param.codex_id = p-codex-id
     3089   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3090   and buf_rule-call-param.call_id = p-call-id
     3091   and buf_rule-call-param.order_id = p-order-id
     3092   and buf_rule-call-param.rule_id = p-rule-id
     3093   and buf_rule-call-param.param-name = "p-is-over"
     3094    no-error.
     3095   if available buf_rule-call-param then do:
     3096   assign p-is-over = buf_rule-call-param.param-value-logical.
     3097   end.
     3098    find first buf_rule-call-param no-lock where
     3099   buf_rule-call-param.codex_id = p-codex-id
     3100   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3101   and buf_rule-call-param.call_id = p-call-id
     3102   and buf_rule-call-param.order_id = p-order-id
     3103   and buf_rule-call-param.rule_id = p-rule-id
     3104   and buf_rule-call-param.param-name = "p-rule-num"
     3105    no-error.
     3106   if available buf_rule-call-param then do:
     3107   assign p-rule-num = buf_rule-call-param.param-value-integer.
     3108   end.
     3109    find first buf_rule-call-param no-lock where
     3110   buf_rule-call-param.codex_id = p-codex-id
     3111   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3112   and buf_rule-call-param.call_id = p-call-id
     3113   and buf_rule-call-param.order_id = p-order-id
     3114   and buf_rule-call-param.rule_id = p-rule-id
     3115   and buf_rule-call-param.param-name = "p-prev-rule-num"
     3116    no-error.
     3117   if available buf_rule-call-param then do:
     3118   assign p-prev-rule-num = buf_rule-call-param.param-value-integer.
     3119   end.
     3120    find first buf_rule-call-param no-lock where
     3121   buf_rule-call-param.codex_id = p-codex-id
     3122   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3123   and buf_rule-call-param.call_id = p-call-id
     3124   and buf_rule-call-param.order_id = p-order-id
     3125   and buf_rule-call-param.rule_id = p-rule-id
     3126   and buf_rule-call-param.param-name = "p-tot-caller-id"
     3127    no-error.
     3128   if available buf_rule-call-param then do:
     3129   assign p-tot-caller-id = buf_rule-call-param.param-value-character.
     3130   end.
     3131    find first buf_rule-call-param no-lock where
     3132   buf_rule-call-param.codex_id = p-codex-id
     3133   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3134   and buf_rule-call-param.call_id = p-call-id
     3135   and buf_rule-call-param.order_id = p-order-id
     3136   and buf_rule-call-param.rule_id = p-rule-id
     3137   and buf_rule-call-param.param-name = "p-nd-caller-id"
     3138    no-error.
     3139   if available buf_rule-call-param then do:
     3140   assign p-nd-caller-id = buf_rule-call-param.param-value-character.
     3141   end.
     3142       assign
     3143       vh_dis-card-sale_obj = buffer temp-d-card:handle
     3144       v-save = p-save
     3145       v-current-doc-type = p-doc-type
     3146       .
     3147       case p-ruleset-id:
     3148         when 1 then do:
     3149           assign
     3150           v-sign = 1
     3151           v-current-host-code = p-host-code
     3152           v-current-obj-type = p-obj-type
     3153           v-current-obj-code = p-obj-code
     3154           v-current-db-num = g#db-num
     3155           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3156           v-current-doc-code = p-doc-code
     3157           v-current-doc-date = p-doc-date
     3158           v-current-doc-fact-date = p-fact-date
     3159           v-current-date = p-doc-date
     3160           v-current-fact-date = p-fact-date
     3161           .
     3162         end.
     3163         when 2 then do:
     3164           assign
     3165           v-sign = -1
     3166           v-current-host-code = p-host-code
     3167           v-current-obj-type = p-obj-type
     3168           v-current-obj-code = p-obj-code
     3169           v-current-db-num = g#db-num
     3170           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3171           v-current-doc-code = p-doc-code
     3172           v-current-doc-date = p-doc-date
     3173           v-current-doc-fact-date = p-fact-date
     3174           v-current-date = p-doc-date
     3175           v-current-fact-date = p-fact-date
     3176           .
     3177         end.
     3178         when 3 or
     3179         when 6 then do:
     3180           assign
     3181           v-sign = 1
     3182           v-current-host-code = p-host-code
     3183           v-current-obj-type = p-obj-type
     3184           v-current-obj-code = p-obj-code
     3185           v-current-db-num = g#db-num
     3186           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3187           v-current-doc-code = p-doc-code
     3188           v-current-doc-date = p-doc-date
     3189           v-current-doc-time = 0
     3190           v-current-doc-fact-date = p-fact-date
     3191           v-current-date = p-doc-date
     3192           v-current-fact-date = p-fact-date
     3193           .
     3194         end.
     3195         when 4 then do:
     3196           assign
     3197           v-sign = -1
     3198           v-current-host-code = p-host-code
     3199           v-current-obj-type = p-obj-type
     3200           v-current-obj-code = p-obj-code
     3201           v-current-db-num = g#db-num
     3202           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3203           v-current-doc-code = p-doc-code
     3204           v-current-doc-date = p-doc-date
     3205           v-current-doc-time = 0
     3206           v-current-doc-fact-date = p-fact-date
     3207           v-current-date = p-doc-date
     3208           v-current-fact-date = p-fact-date
     3209           .
     3210         end.
     3211         when 5 then do:
     3212           assign
     3213           v-sign = 1
     3214           v-current-host-code = p-host-code
     3215           v-current-obj-type = p-obj-type
     3216           v-current-obj-code = p-obj-code
     3217           v-current-db-num = g#db-num
     3218           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3219           v-current-doc-code = p-doc-code
     3220           v-current-doc-date = p-doc-date
     3221           v-current-doc-time = 0
     3222           v-current-doc-fact-date = p-fact-date
     3223           v-current-date = p-doc-date
     3224           v-current-fact-date = p-fact-date
     3225           .
     3226         end.
     3227         when 7
     3228         or when 9
     3229         then do:
     3230           assign
     3231           v-sign = 1
     3232           v-current-host-code = p-host-code
     3233           v-current-obj-type = p-obj-type
     3234           v-current-obj-code = p-obj-code
     3235           v-current-db-num = g#db-num
     3236           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3237           v-current-doc-code = p-doc-code
     3238           v-current-doc-date = p-doc-date
     3239           v-current-doc-time = 0
     3240           v-current-doc-fact-date = p-fact-date
     3241           v-current-date = p-doc-date
     3242           v-current-fact-date = p-fact-date
     3243           .
     3244         end.
     3245       end case.
     3246     end.
     3247   end procedure.
     3248   procedure delete-procedure :
     3249     do
     3250     on error undo, return error
     3251     :
     3252         run garbcoll_clear in this-procedure .
     3253     end.
     3254   end procedure.
