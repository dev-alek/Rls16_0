     1729   define variable v-last-error-message as character no-undo .
     1730   define variable v-emitent-host-code as integer no-undo .
     1731   define variable v-type as character no-undo .
     1732   define variable v-esys-cmd-proc-handle as handle no-undo .
     1733   define variable v-esys-cmd-code as integer no-undo .
     1734   define variable v-sign as integer no-undo .
