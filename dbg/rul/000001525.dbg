     2059   procedure get-db-list-for-d-card2 :
     2060   define input parameter p-d-card as character no-undo .
     2061   define variable v-current-db-processed as logical no-undo .
     2062   define buffer buf_clients  for ub.clients.
     2063   define buffer buf_dis-obj for ub.dis-obj.
     2064   define buffer buf_temp-smart-route for temp-smart-route.
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       for each buf_dis-obj no-lock where
     2069               buf_dis-obj.d-card = p-d-card,
     2070          first buf_clients no-lock where
     2071               buf_clients.obj-type = buf_dis-obj.obj-type
     2072           and buf_clients.obj-code = buf_dis-obj.obj-code
     2073       break by
     2074       buf_clients.db-num:
     2075         if first-of(buf_Clients.db-num) then do:
     2076           find first buf_temp-smart-route no-lock where
     2077                 buf_temp-smart-route.key-field = p-d-card
     2078             and buf_temp-smart-route.db-num = buf_clients.db-num
     2079                 no-error.
     2080           if available buf_temp-smart-route then return.
     2081           create buf_temp-smart-route.
     2082           assign
     2083           buf_temp-smart-route.key-field = p-d-card
     2084           buf_temp-smart-route.db-num = buf_clients.db-num
     2085           .
     2086           if buf_clients.db-num = g#db-num then do:
     2087             v-current-db-processed = yes.
     2088           end.
     2089         end.
     2090       end.
     2091       if not v-current-db-processed then do:
     2092         find first buf_temp-smart-route no-lock where
     2093               buf_temp-smart-route.key-field = p-d-card
     2094           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2095         if not available buf_temp-smart-route then do:
     2096           create buf_temp-smart-route.
     2097           assign
     2098           buf_temp-smart-route.key-field = p-d-card
     2099           buf_temp-smart-route.db-num = g#db-num
     2100           .
     2101         end.
     2102       end.
     2103     end.
     2104   end procedure.
