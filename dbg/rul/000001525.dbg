     2606             buf_dis-rule.rule-num = v-rule-num no-error.
     2607     if available buf_dis-rule
     2608     and (v-jj = 2 or (buf_dis-rule.sts = integer('0':U)
     2609                   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))))
     2610     then do:
     2611       for each buf_term-dis-rule no-lock where
     2612               buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     2613         v-found = no.
     2614         _v-ii:
     2615         do v-ii = 1 to num-entries(v-string[v-jj], "|":U):
     2616            if buf_term-dis-rule.tot-sum <= decimal(entry(v-ii, v-string[v-jj], "|":U)) then do:
     2617              entry(v-ii, v-string[v-jj], "|":U) = string(buf_term-dis-rule.tot-sum) + "|" +  entry(v-ii, v-string[v-jj], "|":U) .
