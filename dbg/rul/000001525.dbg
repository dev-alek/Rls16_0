     2345   procedure get-db-list-for-d-card3 :
     2346   define input parameter p-d-card as character no-undo .
     2347   define variable v-current-db-processed as logical no-undo .
     2348   define buffer buf_clients  for ub.clients.
     2349   define buffer buf_dis-obj for ub.dis-obj.
     2350   define buffer buf_temp-smart-route for temp-smart-route.
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       for each buf_dis-obj no-lock where
     2355               buf_dis-obj.d-card = p-d-card,
     2356          first buf_clients no-lock where
     2357               buf_clients.obj-type = buf_dis-obj.obj-type
     2358           and buf_clients.obj-code = buf_dis-obj.obj-code
     2359       break by
     2360       buf_clients.db-num:
     2361         if first-of(buf_Clients.db-num) then do:
     2362           find first buf_temp-smart-route no-lock where
     2363                 buf_temp-smart-route.key-field = p-d-card
     2364             and buf_temp-smart-route.db-num = buf_clients.db-num
     2365                 no-error.
     2366           if available buf_temp-smart-route then return.
     2367           create buf_temp-smart-route.
     2368           assign
     2369           buf_temp-smart-route.key-field = p-d-card
     2370           buf_temp-smart-route.db-num = buf_clients.db-num
     2371           .
     2372           if buf_clients.db-num = g#db-num then do:
     2373             v-current-db-processed = yes.
     2374           end.
     2375         end.
     2376       end.
     2377       if not v-current-db-processed then do:
     2378         find first buf_temp-smart-route no-lock where
     2379               buf_temp-smart-route.key-field = p-d-card
     2380           and buf_temp-smart-route.db-num = g#db-num
     2381               no-error.
     2382         if not available buf_temp-smart-route then do:
     2383           create buf_temp-smart-route.
     2384           assign
     2385           buf_temp-smart-route.key-field = p-d-card
     2386           buf_temp-smart-route.db-num = g#db-num
     2387           .
     2388         end.
     2389       end.
     2390     end.
     2391   end procedure.
