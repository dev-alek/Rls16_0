     2584   define variable v-step as integer no-undo extent 2.
     2585   define variable v-sum-step as decimal no-undo extent 2.
     2586   define variable v-string as character no-undo  extent 2.
     2587   define variable v-dis-kat-string as character no-undo  extent 2.
     2588   define variable v-ii as integer no-undo .
     2589   define variable v-jj as integer no-undo .
     2590   define variable v-rule-num as integer no-undo .
