     2703   FUNCTION get_prev_sum-id_by-date returns character(
     2704                                                       input p-date as date
     2705                                                     , input p-caller-id as character):
     2706   define buffer buf_prop-ref for ub.prop-ref.
     2707   define variable v-date-char as character no-undo .
