     1975     find first buf_temp-hist-nws-option where
     1976               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1977           and buf_temp-hist-nws-option.db-num = g#db-num
     1978           and buf_temp-hist-nws-option.key#_one = p-dtm-code
