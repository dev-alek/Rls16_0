        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p0-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-process-dirs as character no-undo .
       19   define input parameter p-save       as integer no-undo .
       20   define input parameter v-curr-r-b   as character no-undo .
       21   define input parameter p-cmd-proc-handle as handle no-undo .
       22   define input parameter p-cmd-code  as integer no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 22, набор 2".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define shared temp-table temp-hist-nws-option no-undo
      360   like ub.hist-nws-option
      361   .
      362   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure gen-key-rec :
      364     define input  parameter p-tbl-name    as character no-undo.
      365     define input  parameter p-bh_tbl-name as handle    no-undo.
      366     define output parameter p-key-rec     as character no-undo.
      367     do
      368     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      369     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      370     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      371     :
      372       define variable fh               as handle    no-undo .
      373       define variable v-ok             as logical   no-undo .
      374       define variable v-inform         as character no-undo .
      375       define variable v-ind            as integer   no-undo .
      376       define variable v-idx-field-qnty as integer   no-undo .
      377       if p-tbl-name = ?
      378         or p-tbl-name = "":U
      379       then do:
      380         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      381       end.
      382       if not p-bh_tbl-name:available then do:
      383         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      384       end.
      385       assign
      386         p-key-rec = p-tbl-name
      387         v-inform  = p-bh_tbl-name:index-information(1)
      388         v-ind     = 2
      389       .
      390       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      391       on error undo, return error
      392       :
      393         assign
      394           v-inform = p-bh_tbl-name:index-information( v-ind )
      395           v-ind    = v-ind + 1
      396         .
      397       end.
      398       if v-inform = ?
      399         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      400         or entry( 3, v-inform, ",":U ) <> "1":U
      401       then do:
      402         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      403       end.
      404       else do:
      405         assign
      406           v-idx-field-qnty = num-entries( v-inform ) - 4
      407         .
      408         if v-idx-field-qnty < 2 then do:
      409           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      410         end.
      411         do v-ind = 1 to v-idx-field-qnty by 2
      412         on error undo, return error
      413         :
      414           assign
      415             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      416             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      417           .
      418         end.
      419       end.
      420       if p-key-rec = ? then do:
      421         assign
      422           p-key-rec = "":U
      423         .
      424         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      425       end.
      426     end.
      427     return.
      428   end procedure.
      429   procedure gen-where-keyr-tab :
      430     define input  parameter i-tableSerach as character no-undo.
      431     define input  parameter i-tablekey   as character  no-undo.
      432     define input  parameter p-key-rec    as character  no-undo.
      433     define input  parameter p-key-handle as handle     no-undo .
      434     define input  parameter p-db-name    as character  no-undo .
      435     define input  parameter p-tt-handle  as handle     no-undo .
      436     define output parameter o-Where      as character  no-undo.
      437     do
      438     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      439     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      440     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      441     :
      442       define variable v-full-tbl-name  as character no-undo .
      443       define variable bh_tbl-name      as handle    no-undo .
      444       define variable fh_key           as handle    no-undo .
      445       define variable fh_search        as handle    no-undo .
      446       define variable v-field-num      as integer   no-undo .
      447       define variable v-count-fld      as integer   no-undo .
      448       define variable v-inform         as character no-undo .
      449       define variable v-ind            as integer   no-undo .
      450       define variable v-idx-field-qnty as integer   no-undo .
      451       define variable v-field-name     as character no-undo .
      452       define variable v-field-val      as character no-undo .
      453       define variable v-word-link      as character no-undo .
      454       define variable vTable           as character no-undo.
      455       define variable bh_tbl-key       as handle    no-undo .
      456       assign
      457         p-key-rec = trim( p-key-rec )
      458       .
      459       if p-key-handle <> ? then do:
      460         if not valid-handle(p-key-handle)
      461            or p-key-handle:type <> "buffer"
      462         then do:
      463           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      464         end.
      465         if num-entries( p-key-rec, chr(3) ) > 1
      466           or p-key-rec = ?
      467           or p-key-rec = "":U
      468         then do:
      469           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      470         end.
      471       end.
      472       else do:
      473         if p-key-rec = ?
      474           or p-key-rec = "":U
      475         then do:
      476           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      477         end.
      478       end.
      479       assign
      480         vTable = entry( 1 , p-key-rec, chr(3) )
      481       .
      482       if p-tt-handle <> ?
      483         and ( not valid-handle(p-tt-handle)
      484               or p-tt-handle:type <> "buffer"
      485             )
      486       then do:
      487         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      488       end.
      489       if p-tt-handle = ? then do:
      490         assign
      491           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      492         .
      493         create buffer bh_tbl-name for table v-full-tbl-name .
      494       end.
      495       else do:
      496         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      497       end.
      498       assign
      499         v-inform = bh_tbl-name:index-information(1)
      500         v-ind    = 2
      501       .
      502       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      503       on error undo, return error
      504       :
      505         assign
      506           v-inform = bh_tbl-name:index-information( v-ind )
      507           v-ind    = v-ind + 1
      508         .
      509       end.
      510       if v-inform = ?
      511         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      512         or entry( 3, v-inform, ",":U ) <> "1":U
      513       then do:
      514         delete object bh_tbl-name no-error.
      515         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      516       end.
      517       assign
      518         v-idx-field-qnty = num-entries( v-inform ) - 4
      519       .
      520       if v-idx-field-qnty < 2 then do:
      521         delete object bh_tbl-name no-error.
      522         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      523       end.
      524       assign
      525         o-where     = "where":U
      526         v-word-link = "":U
      527         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      528         v-count-fld = 0
      529       .
      530       if i-tablekey ne "" and i-tablekey ne ?
      531       then do:
      532         assign
      533           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      534         .
      535         create buffer bh_tbl-key for table v-full-tbl-name .
      536       end.
      537       if i-tableSerach ne "" and i-tableSerach ne ?
      538       then do:
      539         delete object bh_tbl-name no-error.
      540         assign
      541           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      542         .
      543         create buffer bh_tbl-name for table v-full-tbl-name .
      544       end.
      545       block_where:
      546       do v-ind = 1 to v-idx-field-qnty by 2
      547       on error undo, return error
      548       :
      549         assign
      550           v-count-fld = v-count-fld + 1
      551         .
      552         if p-key-handle = ?
      553           and v-count-fld > v-field-num
      554         then do:
      555           leave block_where.
      556         end.
      557         define variable VfieldKeyTable as handle no-undo.
      558         assign
      559           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      560           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      561         .
      562         if     bh_tbl-key ne ?
      563         then do:
      564            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      565            if VfieldKeyTable eq ?
      566            then next block_where.
      567         end.
      568         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      569         then
      570            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      571         else
      572            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      573         if p-key-handle = ? then do:
      574           assign
      575             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      576           .
      577         end.
      578         else do:
      579           assign
      580             fh_key = p-key-handle:buffer-field( v-field-name )
      581           .
      582           if fh_key = ?
      583             or not valid-handle( fh_key )
      584           then do:
      585             delete object bh_tbl-name.
      586             if     bh_tbl-key ne ?
      587             then
      588                delete object bh_tbl-key.
      589             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      590           end.
      591           assign
      592             v-field-val = fh_key:buffer-value
      593           .
      594         end.
      595         if fh_search:data-type ="character":U then do:
      596           assign
      597             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      598             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      599             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      600             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      601             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      602             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      603             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      604             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      605             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      606             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      607             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      608             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      609             v-field-val = substitute( '"&1"', v-field-val )
      610           .
      611         end.
      612         assign
      613           o-where = substitute( "&1 &2", o-where, v-field-val )
      614         .
      615         if v-word-link = "":U then do:
      616           assign
      617             v-word-link = "and":U
      618           .
      619         end.
      620       end.
      621       delete object bh_tbl-name.
      622       if     bh_tbl-key ne ?
      623       then
      624          delete object bh_tbl-key.
      625       if p-key-handle = ?
      626         and v-count-fld <> v-field-num
      627       then do:
      628         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      629       end.
      630     end.
      631   end procedure.
      632   procedure gen-hn-keyr-tab :
      633     define input  parameter i-tableSerach as character no-undo.
      634     define input  parameter i-tablekey   as character no-undo.
      635     define input  parameter p-key-rec    as character no-undo.
      636     define input  parameter p-key-handle as handle    no-undo .
      637     define input  parameter p-db-name    as character no-undo .
      638     define input  parameter p-tt-handle  as handle    no-undo .
      639     define input  parameter p-stts-lock  as integer   no-undo .
      640     define output parameter o-hn         as handle    no-undo.
      641     define variable v-full-tbl-name as character no-undo.
      642     define variable v-where         as character no-undo.
      643     define variable bh_tbl-name     as handle    no-undo.
      644     define variable vTable          as character no-undo.
      645     do
      646     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      647     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      648     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      649         run gen-where-keyr-tab(i-tableSerach,
      650                                i-tablekey,
      651                                p-key-rec,
      652                                p-key-handle,
      653                                p-db-name,
      654                                p-tt-handle,
      655                                output v-where).
      656         if i-tableSerach ne "" and i-tableSerach ne ?
      657         then do:
      658            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      659            create buffer bh_tbl-name for table v-full-tbl-name .
      660         end.
      661         else do:
      662            if p-tt-handle = ? then do:
      663               assign
      664                  vTable = entry( 1 , p-key-rec, chr(3) )
      665               .
      666               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      667               create buffer bh_tbl-name for table v-full-tbl-name .
      668            end.
      669            else do:
      670               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      671            end.
      672         end.
      673         if p-tt-handle = ? then do:
      674            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      675         end.
      676         else do:
      677            bh_tbl-name:find-first( v-where ) no-error .
      678         end.
      679         o-hn = bh_tbl-name.
      680      end.
      681   end procedure.
      682   procedure gen-hn-keyr :
      683     define input  parameter p-key-rec    as character no-undo.
      684     define input  parameter p-key-handle as handle    no-undo .
      685     define input  parameter p-db-name    as character no-undo .
      686     define input  parameter p-tt-handle  as handle    no-undo .
      687     define input  parameter p-stts-lock  as integer   no-undo .
      688     define output parameter o-hn         as handle    no-undo.
      689     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      690   end.
      691   procedure gen-row-keyr :
      692     define input  parameter p-key-rec    as character no-undo.
      693     define input  parameter p-key-handle as handle    no-undo .
      694     define input  parameter p-db-name    as character no-undo .
      695     define input  parameter p-tt-handle  as handle    no-undo .
      696     define input  parameter p-stts-lock  as integer   no-undo .
      697     define output parameter p-tbl-row    as rowid     no-undo.
      698     define output parameter p-tbl-name   as character no-undo.
      699     define variable vHn as handle no-undo.
      700       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      701       p-tbl-row = if vHn:available then vHn:rowid else ?.
      702       p-tbl-name =  vHn:table.
      703       delete object vHn no-error.
      704     if p-tbl-row = ? then do:
      705       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      706     end.
      707     else do:
      708       return.
      709     end.
      710   end procedure.
      711   procedure gen-key-fv :
      712     define input  parameter p-key-rec    as character no-undo .
      713     define output parameter p-field-list as character no-undo .
      714     define output parameter p-value-list as character no-undo.
      715     do
      716     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      717     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      718     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      719     :
      720       define variable v-full-tbl-name  as character no-undo .
      721       define variable bh_tbl-name      as handle    no-undo .
      722       define variable v-tbl-name       as character no-undo .
      723       define variable v-field-num      as integer   no-undo .
      724       define variable v-count-fld      as integer   no-undo .
      725       define variable v-inform         as character no-undo .
      726       define variable v-ind            as integer   no-undo .
      727       define variable v-idx-field-qnty as integer   no-undo .
      728       define variable v-delim-key      as character no-undo .
      729       if p-key-rec = ?
      730         or p-key-rec = "":U
      731       then do:
      732         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      733       end.
      734       assign
      735         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      736         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      737       .
      738       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      739       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      740       assign
      741         v-inform = bh_tbl-name:index-information(1)
      742         v-ind    = 2
      743       .
      744       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      745       on error undo, return error
      746       :
      747         assign
      748           v-inform = bh_tbl-name:index-information( v-ind )
      749           v-ind    = v-ind + 1
      750         .
      751       end.
      752       if v-inform = ?
      753         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      754         or entry( 3, v-inform, ",":U ) <> "1":U
      755       then do:
      756         delete object bh_tbl-name no-error.
      757         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      758       end.
      759       assign
      760         v-idx-field-qnty = num-entries( v-inform ) - 4
      761       .
      762       if v-idx-field-qnty < 2 then do:
      763         delete object bh_tbl-name no-error.
      764         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      765       end.
      766       assign
      767         p-field-list = "":U
      768         p-value-list = "":U
      769         v-delim-key  = "":U
      770         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      771         v-count-fld  = 0
      772       .
      773       block_where:
      774       do v-ind = 1 to v-idx-field-qnty by 2
      775       on error undo, return error
      776       :
      777         assign
      778           v-count-fld = v-count-fld + 1
      779         .
      780         if v-count-fld > v-field-num then do:
      781           leave block_where.
      782         end.
      783         assign
      784           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      785           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      786         .
      787         if v-ind = 1 then do:
      788           assign
      789             v-delim-key = chr(3)
      790           .
      791         end.
      792       end.
      793       delete object bh_tbl-name.
      794       if v-count-fld <> v-field-num then do:
      795         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      796       end.
      797     end.
      798   end procedure.
      799   procedure gen-key-field :
      800     define input  parameter p-table      as character no-undo .
      801     define output parameter p-field-list as character no-undo .
      802     do
      803     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      804     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      805     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      806     :
      807       define variable v-full-tbl-name  as character no-undo .
      808       define variable bh_tbl-name      as handle    no-undo .
      809       define variable v-tbl-name       as character no-undo .
      810       define variable v-field-num      as integer   no-undo .
      811       define variable v-count-fld      as integer   no-undo .
      812       define variable v-inform         as character no-undo .
      813       define variable v-ind            as integer   no-undo .
      814       define variable v-idx-field-qnty as integer   no-undo .
      815       define variable v-delim-key      as character no-undo .
      816       if p-table = ?
      817         or p-table = "":U
      818       then do:
      819         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      820       end.
      821       assign
      822         v-tbl-name      = p-table
      823         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      824       .
      825       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      826       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      827       assign
      828         v-inform = bh_tbl-name:index-information(1)
      829         v-ind    = 2
      830       .
      831       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      832       on error undo, return error
      833       :
      834         assign
      835           v-inform = bh_tbl-name:index-information( v-ind )
      836           v-ind    = v-ind + 1
      837         .
      838       end.
      839       if v-inform = ?
      840         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      841         or entry( 3, v-inform, ",":U ) <> "1":U
      842       then do:
      843         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      844       end.
      845       assign
      846         v-idx-field-qnty = num-entries( v-inform ) - 4
      847       .
      848       if v-idx-field-qnty < 2 then do:
      849         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      850       end.
      851       assign
      852         p-field-list = "":U
      853         v-delim-key  = "":U
      854         v-count-fld  = 0
      855       .
      856       block_where:
      857       do v-ind = 1 to v-idx-field-qnty by 2
      858       on error undo, return error
      859       :
      860         assign
      861           v-count-fld = v-count-fld + 1
      862         .
      863         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      864         if v-ind = 1 then do:
      865           assign
      866             v-delim-key = chr(3)
      867           .
      868         end.
      869       end.
      870       delete object bh_tbl-name.
      871     end.
      872   end procedure.
      873   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   define variable tempcxml_v-num_ as integer no-undo .
      876   define  temp-table temp-xml-tables no-undo
      877   field order as integer
      878   field tbl-name as character
      879   field tbl-handle_ as handle
      880   field table-handle_ as handle
      881   field uniq-gate-rec as character
      882   field gate-name as character
      883   field gate-handle_ as handle
      884   field is-parent as logical
      885   index pi is unique primary
      886   uniq-gate-rec
      887   tbl-name
      888   index iorder
      889   order
      890   index gr
      891   uniq-gate-rec
      892   index gh
      893   gate-handle_
      894   index iparent
      895   is-parent
      896   .
      897   define  temp-table temp-xml-records no-undo
      898   field tbl-name as character
      899   field uniq-key-rec as character
      900   index pi is unique primary
      901   tbl-name
      902   uniq-key-rec
      903   .
      904   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   procedure get-gate-file-name :
      906   define input parameter p-gate-rec as character no-undo .
      907   define output  parameter p-gate-file-name as character no-undo .
      908   define buffer buf_clob-data for ub.clob-data.
      909   define variable v-tbl-row as rowid no-undo .
      910   define variable v-tbl-name as character no-undo .
      911   run gen-row-keyr in this-procedure ( input p-gate-rec
      912                                       ,input ?
      913                                       ,input "ub"
      914                                       ,input ?
      915                                       ,input no-lock
      916                                       ,output v-tbl-row
      917                                       ,output v-tbl-name) no-error.
      918   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      919                                                           ,vss-include-info4
      920                                                           ,p-gate-rec).
      921   find first buf_clob-data no-lock where
      922             rowid(buf_clob-data) = v-tbl-row no-error.
      923   if not available buf_clob-data then do:
      924     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      925                                                             ,vss-include-info4
      926                                                             ,p-gate-rec).
      927   end.
      928   p-gate-file-name = buf_clob-data.file-name.
      929   end procedure.
      930   procedure get-gate-rec :
      931   define input  parameter p-gate-name as character no-undo .
      932   define output parameter p-gate-rec as character no-undo .
      933   define buffer buf_clob-bind for ub.clob-bind.
      934   define buffer buf_clob-data for ub.clob-data.
      935   main-block:
      936   do
      937   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      938   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      939   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      940   :
      941       find first buf_clob-bind no-lock where
      942                 buf_clob-bind.uniq-key-rec = p-gate-name
      943             and buf_clob-bind.field-name = '':U
      944             and buf_clob-bind.part-num = 1
      945             and buf_clob-bind.resource-type = 'gate':U
      946             no-error.
      947       if not available buf_clob-bind then do:
      948         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      949                                         , p-gate-name
      950                                         ).
      951       end.
      952       find first buf_clob-data no-lock where
      953                 buf_clob-data.db-num = buf_clob-bind.db-num
      954             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      955       if not available buf_clob-data then do:
      956         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      957                                         , buf_clob-bind.db-num
      958                                         , buf_clob-bind.int64-id
      959                                         , p-gate-name
      960                                         ).
      961       end.
      962       run gen-key-rec in this-procedure ( input 'clob-data':U
      963                                 ,input buffer buf_clob-data:handle
      964                                 ,output p-gate-rec).
      965   end.
      966   end procedure.
      967   procedure get-gate-by-name :
      968   define input  parameter p-gate-name as character no-undo .
      969   define output parameter p-gate-rec as character no-undo .
      970   define output parameter p-dsh as handle no-undo .
      971   define input-output  parameter p-xmlh as handle no-undo .
      972   define variable v-ii as integer   no-undo .
      973   define variable glog as logical   no-undo .
      974   define variable v-longchar as longchar no-undo .
      975   define variable v-txmlh as handle no-undo .
      976   define variable v-db-num as integer no-undo .
      977   define variable v-int64-id as int64 no-undo .
      978   define buffer buf_clob-bind for ub.clob-bind.
      979   define buffer buf_clob-data for ub.clob-data.
      980   main-block:
      981   do
      982   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      983   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      984   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      985   :
      986       find first buf_clob-bind no-lock where
      987                 buf_clob-bind.uniq-key-rec = p-gate-name
      988             and buf_clob-bind.field-name = '':U
      989             and buf_clob-bind.part-num = 1
      990             and buf_clob-bind.resource-type = 'gate':U
      991             no-error.
      992       if not available buf_clob-bind then do:
      993         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      994                                         , p-gate-name
      995                                         ).
      996       end.
      997       find first buf_clob-data no-lock where
      998                 buf_clob-data.db-num = buf_clob-bind.db-num
      999             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1000       if not available buf_clob-data then do:
     1001         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1002                                         , buf_clob-bind.db-num
     1003                                         , buf_clob-bind.int64-id
     1004                                         , p-gate-name
     1005                                         ).
     1006       end.
     1007       assign
     1008       v-longchar = buf_clob-data.cdata
     1009       .
     1010       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1011       if error-status :error then do:
     1012         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1013       end.
     1014       create dataset p-dsh .
     1015       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1016                                     , v-longchar
     1017                                     , ?
     1018                                     , ?
     1019                                     , ?
     1020                                     ) no-error.
     1021       v-longchar = '':U.
     1022       if error-status :error
     1023       or not glog
     1024       then do:
     1025         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1026       end.
     1027       if not valid-handle(p-xmlh)
     1028       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1029         create temp-table v-txmlh.
     1030         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1031         v-txmlh:temp-table-prepare("temp-xml-tables").
     1032         p-xmlh = v-txmlh:default-buffer-handle.
     1033       end.
     1034       run gen-key-rec in this-procedure ( input 'clob-data':U
     1035                                 ,input buffer buf_clob-data:handle
     1036                                 ,output p-gate-rec).
     1037       do v-ii = 1 to p-dsh:num-buffers:
     1038         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1039         if not p-xmlh:available then do:
     1040           p-xmlh:buffer-create().
     1041           assign
     1042           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1043           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1044           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1045           p-xmlh::gate-handle_ = p-dsh
     1046           p-xmlh::uniq-gate-rec = p-gate-rec
     1047           p-xmlh::gate-name = p-dsh:name
     1048           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1049           .
     1050           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1051             assign
     1052             p-xmlh::order = -3.
     1053           end.
     1054         end.
     1055       end.
     1056   end.
     1057   end procedure.
     1058   procedure get-gate-by-rec :
     1059   define input  parameter p-gate-rec as character no-undo .
     1060   define output parameter p-dsh as handle no-undo .
     1061   define input-output  parameter p-xmlh as handle no-undo .
     1062   define input-output parameter p-longchar  as longchar no-undo .
     1063   define variable v-ii as integer   no-undo .
     1064   define variable glog as logical   no-undo .
     1065   define variable v-rowid as rowid no-undo .
     1066   define variable v-tbl-name as character no-undo .
     1067   define variable v-longchar as longchar no-undo .
     1068   define variable v-txmlh as handle no-undo .
     1069   define buffer buf_clob-data for ub.clob-data.
     1070   main-block:
     1071   do
     1072   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1073   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1074   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1075   :
     1076     run gen-row-keyr in this-procedure (
     1077                                           input  p-gate-rec
     1078                                           ,input  ?
     1079                                           ,input  "ub"
     1080                                           ,input  ?
     1081                                           ,input  NO-LOCK
     1082                                           ,output v-rowid
     1083                                           ,output v-tbl-name   ) no-error.
     1084       find first buf_clob-data no-lock where
     1085                 rowid(buf_clob-data) = v-rowid  no-error.
     1086       if not available buf_clob-data then do:
     1087         undo, return error substitute("Не найден CLOB  &1"
     1088                                         , p-gate-rec
     1089                                         ).
     1090       end.
     1091       assign
     1092       v-longchar = buf_clob-data.cdata
     1093       .
     1094       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1095       if error-status :error then do:
     1096         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1097       end.
     1098       create dataset p-dsh .
     1099       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1100                                     , v-longchar
     1101                                     , ?
     1102                                     , ?
     1103                                     , ?
     1104                                     ) no-error.
     1105       define variable v-esm as character no-undo .
     1106       v-esm = error-status:get-message(1) .
     1107       if p-longchar <> ? then do:
     1108         p-longchar = v-longchar.
     1109       end.
     1110       v-longchar = '':U.
     1111       if error-status :error
     1112       or not glog
     1113       then do:
     1114         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1115                                      , p-gate-rec
     1116                                      , p-gate-rec
     1117                                      , v-esm
     1118                                      ).
     1119       end.
     1120       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1121       if not valid-handle(p-xmlh)
     1122       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1123         create temp-table v-txmlh.
     1124         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1125         v-txmlh:temp-table-prepare("temp-xml-tables").
     1126         p-xmlh = v-txmlh:default-buffer-handle.
     1127       end.
     1128       do v-ii = 1 to p-dsh:num-buffers:
     1129         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1130         if not p-xmlh:available then do:
     1131           p-xmlh:buffer-create().
     1132           assign
     1133           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1134           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1135           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1136           p-xmlh::gate-handle_ = p-dsh
     1137           p-xmlh::uniq-gate-rec = p-gate-rec
     1138           p-xmlh::gate-name = p-dsh:name
     1139           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1140           .
     1141           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1142             assign
     1143             p-xmlh::order = -3.
     1144           end.
     1145           p-xmlh:buffer-release().
     1146         end.
     1147       end.
     1148   end.
     1149   end procedure.
     1150   procedure get-gate-by-file :
     1151   define input  parameter p-schema-file-name as character no-undo .
     1152   define input  parameter p-gate-rec as character no-undo .
     1153   define output parameter p-dsh as handle no-undo .
     1154   define input-output  parameter p-xmlh as handle no-undo .
     1155   define variable v-ii as integer   no-undo .
     1156   define variable glog as logical   no-undo .
     1157   define variable v-rowid as rowid no-undo .
     1158   define variable v-tbl-name as character no-undo .
     1159   define variable v-longchar as longchar no-undo .
     1160   define variable v-txmlh as handle no-undo .
     1161   main-block:
     1162   do
     1163   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1164   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1165   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1166   :
     1167       COPY-LOB
     1168       FROM  FILE p-schema-file-name
     1169       TO  OBJECT v-longchar
     1170       no-convert
     1171       NO-ERROR .
     1172       if error-status :error then do:
     1173           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1174                                     , p-schema-file-name
     1175                                 , chr(10)
     1176                                 , error-status:get-message(1) ).
     1177       end.
     1178       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1179       if error-status :error then do:
     1180         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1181       end.
     1182       create dataset p-dsh .
     1183       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1184                                     , v-longchar
     1185                                     , ?
     1186                                     , ?
     1187                                     , ?
     1188                                     ) no-error.
     1189       v-longchar = ''.
     1190       if error-status :error
     1191       or not glog
     1192       then do:
     1193         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1194                                      , p-schema-file-name
     1195                                      ,chr(10)
     1196                                      , error-status:get-message(1)
     1197                                      ).
     1198       end.
     1199       if not valid-handle(p-xmlh)
     1200       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1201         create temp-table v-txmlh.
     1202         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1203         v-txmlh:temp-table-prepare("temp-xml-tables").
     1204         p-xmlh = v-txmlh:default-buffer-handle.
     1205       end.
     1206       do v-ii = 1 to p-dsh:num-buffers:
     1207         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1208                                      ,p-dsh:get-buffer-handle(v-ii):name
     1209                                      ,p-gate-rec
     1210                                      )) no-error.
     1211         if not p-xmlh:available then do:
     1212           p-xmlh:buffer-create().
     1213           assign
     1214           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1215           p-xmlh::uniq-gate-rec = p-gate-rec
     1216           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1217           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1218           p-xmlh::gate-handle_ = p-dsh
     1219           p-xmlh::gate-name = p-dsh:name
     1220           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1221           .
     1222           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1223             assign
     1224             p-xmlh::order = -3.
     1225           end.
     1226           p-xmlh:buffer-release().
     1227         end.
     1228       end.
     1229   end.
     1230   end procedure.
     1231   procedure gate-clear :
     1232   define input  parameter p-dsh as handle no-undo .
     1233   define input  parameter p-xmlh as handle no-undo .
     1234   define variable v-dsh as handle no-undo .
     1235   define variable v-th as handle no-undo .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       if valid-handle(p-dsh) then do:
     1240         delete object p-dsh.
     1241         v-dsh = p-dsh.
     1242         p-dsh = ?.
     1243       end.
     1244       repeat while true:
     1245         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1246                            , share-lock) no-error.
     1247         if p-xmlh:available then do:
     1248           assign
     1249           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1250           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1251           and valid-handle(v-th)
     1252           and v-th:dynamic = yes
     1253           then do:
     1254             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1255             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1256           end.
     1257           p-xmlh:buffer-delete().
     1258         end.
     1259         else do:
     1260           leave.
     1261         end.
     1262       end.
     1263       if p-xmlh:dynamic = yes
     1264       and valid-handle(p-xmlh)
     1265       then do:
     1266         delete object p-xmlh:table-handle.
     1267         p-xmlh = ?.
     1268       end.
     1269       v-dsh = ?.
     1270     end.
     1271   end procedure.
     1272   procedure all-gates-clear :
     1273   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1274   do
     1275   on error undo, return error
     1276   :
     1277     for each buf_temp-xml-tables
     1278     break
     1279     by buf_temp-xml-tables.uniq-gate-rec
     1280     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1281     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1282     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1283     :
     1284         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1285           delete object buf_temp-xml-tables.gate-handle_.
     1286           buf_temp-xml-tables.gate-handle_ = ?.
     1287         end.
     1288         if valid-handle(buf_temp-xml-tables.table-handle_)
     1289         and buf_temp-xml-tables.table-handle_:dynamic = no
     1290         then do:
     1291           delete object buf_temp-xml-tables.table-handle_.
     1292           buf_temp-xml-tables.table-handle_ = ?.
     1293         end.
     1294         delete buf_temp-xml-tables.
     1295     end.
     1296   end.
     1297   end procedure.
     1298   procedure fix-schemalocation :
     1299   define input-output  parameter p-longchar as longchar no-undo .
     1300   DEFINE VARIABLE hdoc AS HANDLE.
     1301   DEFINE VARIABLE hroot AS HANDLE.
     1302   DEFINE VARIABLE hnode-child AS HANDLE.
     1303   DEFINE VARIABLE hnode-attr AS HANDLE.
     1304   define variable v-jj as integer   no-undo .
     1305   define variable ok as logical   no-undo .
     1306   define variable v-path1                    as character                no-undo .
     1307   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1308   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1309   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1310   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1311   define variable v-schema-location          as character                no-undo .
     1312   do
     1313   on error undo, return error return-value
     1314   :
     1315     CREATE X-DOCUMENT hdoc.
     1316     CREATE X-noderef hroot.
     1317     CREATE X-noderef hnode-child.
     1318     CREATE X-noderef hnode-attr.
     1319     hdoc:load("longchar", p-longchar, no) no-error.
     1320     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1321     hdoc:get-document-element(hroot).
     1322     _repeat:
     1323     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1324       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1325       if not ok then next.
     1326       if hNode-Child:local-name = "include"
     1327       then do:
     1328         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1329           v-schema-location = hnode-attr:node-value.
     1330           run gbl/filename.p (
     1331                           input "exe/" + hnode-attr:node-value
     1332                         ,output v-full-path1
     1333                         ,output v-path1
     1334                         ,output v-file-name1
     1335                         ,output v-file-name-no-ext1
     1336                         ,output v-file-name-ext1
     1337                         ) no-error .
     1338           if error-status :error then do:
     1339             delete object hnode-attr.
     1340             delete object hnode-child.
     1341             delete object hroot.
     1342             delete object hdoc.
     1343             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1344           end.
     1345         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1346         leave  _repeat.
     1347       end.
     1348     END.
     1349     hdoc:save("longchar", p-longchar).
     1350     delete object hnode-attr.
     1351     delete object hnode-child.
     1352     delete object hroot.
     1353     delete object hdoc.
     1354   end.
     1355   end procedure.
     1356   procedure gate-clb_fill-xml-tables :
     1357   define input parameter p-dsh as handle no-undo .
     1358   define input-output parameter p-xmlh as handle no-undo .
     1359   define variable v-ii as integer no-undo .
     1360     do
     1361     on error undo, return error
     1362     :
     1363       do v-ii = 1 to p-dsh:num-buffers:
     1364         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1365         if not p-xmlh:available then do:
     1366           p-xmlh:buffer-create().
     1367           assign
     1368           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1369           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1370           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1371           p-xmlh::gate-handle_ = p-dsh
     1372           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1373           p-xmlh::gate-name = p-dsh:name
     1374           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1375           .
     1376           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1377             assign
     1378             p-xmlh::order = -3.
     1379           end.
     1380           p-xmlh:buffer-release().
     1381         end.
     1382       end.
     1383     end.
     1384   end procedure.
     1385   procedure all-gates-empty :
     1386   define buffer buf_temp-xml-tables for temp-xml-tables.
     1387   do
     1388   on error undo, return error
     1389   :
     1390     for each buf_temp-xml-tables
     1391     break
     1392     by buf_temp-xml-tables.uniq-gate-rec
     1393     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1394     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1395     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1396     :
     1397       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1398         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1399       end.
     1400     end.
     1401   end.
     1402   end procedure.
     1403   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1404   define variable v-current-rep-code as character no-undo .
     1405   define variable v-current-doc-code as character no-undo .
     1406   define variable v-current-host-code as integer no-undo .
     1407   define variable v-current-obj-type as character no-undo .
     1408   define variable v-current-obj-code as integer no-undo .
     1409   define variable v-current-lock as integer no-undo .
     1410   define variable v-current-wait as integer no-undo .
     1411   define variable v-save as integer no-undo .
     1412   define variable v-esys-cmd-proc-handle as handle no-undo .
     1413   define variable v-esys-cmd-code as integer no-undo .
     1414   define variable log-file-name                as character      no-undo init "calc-rep.log".
     1415   define variable v-view-log                   as logical        no-undo .
     1416   define variable v-stop                       as logical        no-undo .
     1417   define variable v-current-db-num as integer no-undo .
     1418   define variable v-last-error-message as character no-undo .
     1419   define variable v-dirs as character no-undo .
     1420   define variable v-sign as integer no-undo .
     1421   define variable v-type as character no-undo .
     1422   define variable l-res as integer no-undo .
     1423   define variable v-es as logical no-undo .
     1424   define variable v-esm as character no-undo .
     1425   define variable v-rv as character no-undo .
     1426   define variable v-xmlh as handle no-undo .
     1427   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1428   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1429   define temp-table temp-obj no-undo
     1430   field obj-type as character
     1431   field obj-code as integer
     1432   index pi is unique primary
     1433   obj-type obj-code
     1434   .
     1435   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1436   procedure write-to-screen :
     1437   define input param p-str as character no-undo .
