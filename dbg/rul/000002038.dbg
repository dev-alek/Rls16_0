     1458       , input p-str).
     1459   end procedure.
     1460   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   procedure set-error :
     1462   define input parameter p-mess as character no-undo .
     1463     do
     1464     on error undo, return error
     1465     :
     1466        assign
     1467        v-last-error-message = p-mess.
     1468     end.
     1469   end procedure.
     1470   define variable p-shops-choice as integer no-undo .
     1471   on delete of this-procedure do:
     1472     run garbcoll_clear in this-procedure .
     1473   end.
     1474   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1475   if error-status:error then do:
     1476     undo, return error return-value .
     1477   end.
     1478   if not this-procedure:persistent then do:
     1479     run proc-main in this-procedure no-error .
     1480     if error-status:error then do:
     1481       v-es = error-status:error .
     1482       v-rv = return-value .
     1483     end.
     1484     if v-es then do:
     1485         run garbcoll_clear in this-procedure .
     1486         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1487     end.
     1488     run garbcoll_clear in this-procedure .
     1489   end.
     1490   procedure proc-main :
     1491   define variable v-err-mess as character no-undo .
     1492   define variable glog as logical no-undo .
     1493   define variable v-parameter as character no-undo .
     1494   define buffer buf_temp-obj for temp-obj.
     1495   define buffer buf_clients for ub.clients.
     1496   empty temp-table temp-obj.
     1497   case p-shops-choice:
     1498     when 4 then do:
     1499       for each buf_clients no-lock where
     1500               buf_clients.obj-type = 'маг':U
     1501           and buf_clients.db-num = g#db-num:
     1502         find first buf_temp-obj where
     1503                   buf_temp-obj.obj-type = buf_clients.obj-type
     1504               and buf_temp-obj.obj-code = buf_clients.obj-code no-error.
     1505         if not available buf_temp-obj then do:
     1506           create buf_temp-obj.
     1507           assign
     1508           buf_temp-obj.obj-type = buf_clients.obj-type
     1509           buf_temp-obj.obj-code = buf_clients.obj-code
     1510           .
     1511           release buf_temp-obj.
     1512         end.
     1513       end.
     1514     end.
     1515   end case.
     1516   for each buf_temp-obj :
     1517     assign
     1518     v-parameter =
     1519                     buf_temp-obj.obj-type         + chr(4) +
     1520                     string(buf_temp-obj.obj-code) + chr(4) +
     1521                     string(0)          + chr(4) +
     1522                     string(1).
     1523     run str/get-chkf.p (
     1524                     input parparentproc
     1525                   ,input p-parent-handle
     1526                   ,input p-log-handle
     1527                   ,input v-parameter ) no-error .
     1528     if error-status:error then do:
     1529           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "!!!Ошибка при приеме информации с касс &1&2&3" +                             "&4 &5"                           , buf_temp-obj.obj-type                           , buf_temp-obj.obj-code                            , chr(10)                           , error-status:get-message(1)                           , return-value)).
     1530     end.
     1531       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute( "Обработка спул-файлов по &1&2 завершена"                           , buf_temp-obj.obj-type                           , buf_temp-obj.obj-code)).
     1532   end.
     1533   end procedure.
     1534   procedure load-ruleset-context :
     1535   define input parameter p-ruleset-id as integer no-undo .
     1536   define buffer buf_rule-call-param for ub.rule-call-param.
     1537   do
     1538   on error undo, return error
     1539   :
     1540    find first buf_rule-call-param no-lock where
     1541   buf_rule-call-param.codex_id = p-codex-id
     1542   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1543   and buf_rule-call-param.call_id = p-call-id
     1544   and buf_rule-call-param.order_id = p-order-id
     1545   and buf_rule-call-param.rule_id = p-rule-id
     1546   and buf_rule-call-param.param-name = "p-shops-choice"
     1547    no-error.
     1548   if available buf_rule-call-param then do:
     1549   assign p-shops-choice = buf_rule-call-param.param-value-integer.
     1550   end.
     1551       case p-ruleset-id:
     1552         when 3
     1553         then do:
     1554           assign
     1555           v-sign = 0
     1556           v-current-host-code = p0-host-code
     1557           v-current-obj-type = p-obj-type
     1558           v-current-obj-code = p-obj-code
     1559           v-current-db-num = g#db-num
     1560           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1561           v-dirs  = p-process-dirs
     1562           v-current-rep-code  = p-doc-code
     1563           .
     1564         end.
     1565      end case.
     1566   end.
     1567   end procedure.
