     4661   PROCEDURE proc-save :
     4662   define variable v-ii as integer   no-undo .
     4663   define variable glog as logical no-undo .
     4664   v-ii = 0.
     4665   assign
     4666   frame Dialog-Frame
     4667   f-issue-code
     4668   f-dis-tot-obj-code
     4669   f-category
     4670   f-valid-date
     4671   f-issue-date
     4672   f-lim-cr
     4673   f-cli-grp-code
     4674   t-on-off
     4675   .
     4676   if f-issue-code = 0 then do:
     4677     message
     4678     "Вы не определили код магазина выдачи карты"
     4679     view-as alert-box error .
     4680     undo, return error .
     4681   end.
     4682   if f-dis-tot-obj-code = 0 then do:
     4683     message
     4684     "Вы не определили код магазина для начисления общих итогов"
     4685     view-as alert-box error .
     4686     undo, return error .
     4687   end.
     4688   if f-issue-date = ? then do:
     4689     message
     4690     "Вы не определили дату выдачи карты"
     4691     view-as alert-box error .
     4692     undo, return error .
     4693   end.
     4694   if f-issue-date = ? then do:
     4695     message
     4696     "Вы не определили дату действия карты" skip
     4697     "Вы действительно хотите, чтобы карты НЕ ИМЕЛИ СРОКА ДЕЙСТВИЯ?"
     4698      view-as alert-box question buttons yes-no update glog .
     4699   end.
     4700   if f-cli-grp-code = 0 then do:
     4701     message
     4702     "Вы не определили группу, в которую будут попадать клиенты при создании новой карты"
     4703     view-as alert-box error .
     4704     undo, return error .
     4705   end.
     4706   if t-on-off = yes
     4707   and v-old-on-off = no then do:
     4708     message
     4709     "ПОВТОРНОЕ ВКЛЮЧЕНИЕ ОБСЧЕТА ИТОГОВ ПО ДК НЕВОЗМОЖНО!!!!"
     4710     view-as alert-box error .
     4711     undo, return error .
     4712   end.
     4713   if t-on-off = no
     4714   and v-old-on-off = yes
     4715   then do:
     4716     message
     4717     "ВНИМАНИЕ!!!!" skip(2)
     4718     "Выключение обсчета итогов по картам является НЕОБРАТИМОЙ операцией!" skip(0)
     4719     "Вы действительно хотите продолжить?"
     4720     view-as alert-box question buttons yes-no update glog.
     4721     if not glog then return error.
     4722   end.
