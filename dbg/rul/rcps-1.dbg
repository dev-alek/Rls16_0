     2322   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323   procedure minbtn-set :
     2324       do
     2325           on error undo, return error return-value
     2326           :
     2327           define variable ii              as integer       no-undo .
     2328           define variable fh              as widget-handle no-undo .
     2329           define variable hh              as widget-handle no-undo .
     2330           define variable v-h             as handle        extent 4 no-undo .
     2331           define variable v-name-button   as character     no-undo .
     2332           define variable v-help-old-x    as decimal       no-undo .
     2333           define variable v-help-old-y    as decimal       no-undo .
     2334           define variable v-help-old-size as decimal       no-undo .
     2335           define variable v-frame-width   as decimal       no-undo .
     2336           define variable jj              as integer       no-undo .
     2337           do
     2338               on error undo, return error
     2339               :
     2340               assign
     2341                   v-frame-width = frame Dialog-Frame:width - 0.3
     2342                   fh            = frame Dialog-Frame:first-child
     2343                   hh            = fh:first-child
     2344                   ii            = 1
     2345                   .
     2346               do while valid-handle(hh):
     2347                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2348                   do:
     2349                       case lc(hh:name) :
     2350                           when "b-help" then
     2351                               do:
     2352                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2353                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2354                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2355                                   hh:TOOLTIP = "Помощь" .
     2356                                   v-help-old-x = hh:column .
     2357                                   v-help-old-y = hh:row    .
     2358                                   v-help-old-size = hh:width .
     2359                                   hh:width-chars = 2.5 .
     2360                               end.
     2361                           when "b-print" then
     2362                               do:
     2363                                   hh:load-image("cmp/b-print.bmp":u) .
     2364                                   hh:TOOLTIP = "Печать" .
     2365                                   v-h[ii] = hh:handle .
     2366                                   ii = ii + 1 .
     2367                                   hh:width-chars = 3 .
     2368                               end.
     2369                           when "b-history" or
     2370                           when "b-hist" then
     2371                               do:
     2372                                   hh:load-image("cmp/b-hist.bmp":u) .
     2373                                   hh:TOOLTIP = "История" .
     2374                                   v-h[ii] = hh:handle .
     2375                                   ii = ii + 1 .
     2376                                   hh:width-chars = 3 .
     2377                               end.
     2378                           when "b-sch" then
     2379                               do:
     2380                                   hh:load-image("cmp/b-sch.bmp":u) .
     2381                                   hh:TOOLTIP = "Установка Фильтра" .
     2382                                   v-h[ii] = hh:handle .
     2383                                   ii = ii + 1 .
     2384                                   hh:width-chars = 3 .
     2385                               end.
     2386                           when "b-hist-user" then
     2387                               do:
     2388                                   hh:load-image("cmp/b-hist.bmp":u) .
     2389                                   hh:TOOLTIP = "История пользователя" .
     2390                                   ii = ii + 1 .
     2391                               end.
     2392                       end case.
     2393                   end.
     2394                   hh = hh:next-sibling.
     2395               end.
     2396               b-help:column = v-frame-width - b-help:width-chars.
     2397               jj = 0.
     2398               repeat ii = 4 to 1 by -1 :
     2399                   if valid-handle (v-h[ii] ) then
     2400                   do:
     2401                       jj  = jj + 1 .
     2402                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2403                       v-h[ii]:row    = v-help-old-y .
     2404                   end.
     2405               end.
     2406           end.
     2407       end.
     2408   end procedure.
     2409   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2410   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2411   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2412   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2413   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2414   define variable v-diasize-current-frame-height as decimal   no-undo .
     2415   define variable v-diasize-change-size          as logical   no-undo .
     2416   define variable v-diasize-resize-button        as handle    no-undo .
     2417   define variable v-diasize-wndmax               as logical   no-undo .
     2418   define variable v-diasize-wndstore             as logical   no-undo .
     2419   define variable v-diasize-proc-name            as character no-undo .
     2420   define variable v-diasize-browse-handle        as handle    no-undo .
     2421   define variable v-diasize-browse-number        as integer   no-undo .
     2422   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2423   define temp-table temp-diasize-handle no-undo
     2424     field handle-value  as handle
     2425     field save-position as decimal
     2426     index xpk is primary unique handle-value
     2427     .
     2428   define temp-table temp-browse-handle no-undo
     2429     field browse-type   as character
     2430     field browse-number as integer
     2431     field browse-handle as handle
     2432     field original-size as decimal
     2433     index xpk is primary unique browse-type browse-number
     2434     index xie browse-type browse-handle
     2435   .
     2436   procedure diasize_change-height :
     2437     define input  parameter p-change-value  as decimal   no-undo .
     2438     define input  parameter p-move-resize   as logical   no-undo .
     2439     define variable v-field-group-handle    as handle    no-undo .
     2440     define variable v-object-handle         as handle    no-undo .
     2441     define variable v-frame-height          as decimal   no-undo .
     2442     define variable v-frame-virtual-height  as decimal   no-undo .
     2443     define variable v-browse-height         as decimal   no-undo .
     2444     define variable v-window-height         as decimal   no-undo .
     2445     define variable v-window-virtual-height as decimal   no-undo .
     2446     define variable v-change-sign           as integer   no-undo .
     2447     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2448     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2449     if p-change-value > 0
     2450     then do:
     2451       if frame Dialog-Frame :height + p-change-value
     2452           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2453       then do:
     2454         assign
     2455           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2456                           - (frame Dialog-Frame :height-chars)
     2457         .
     2458         if p-change-value <= 0
     2459         then do:
     2460           run diasize_position-resize-button in this-procedure .
     2461           return .
     2462         end.
     2463       end.
     2464     end.
     2465     if p-change-value < 0
     2466     then do:
     2467       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2468       then do:
     2469         assign
     2470           p-change-value = v-diasize-orig-frame-height
     2471                          - (frame Dialog-Frame :height-chars)
     2472         .
     2473         if p-change-value >= 0
     2474         then do:
     2475           run diasize_position-resize-button in this-procedure .
     2476           return .
     2477         end.
     2478       end.
     2479     end.
     2480     if p-change-value >= 0
     2481     then do:
     2482       assign
     2483         v-change-sign = 1
     2484       .
     2485     end.
     2486     else do:
     2487       assign
     2488         v-change-sign = -1
     2489       .
     2490     end.
     2491     assign
     2492       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2493     .
     2494     if p-change-value = 0
     2495     then do:
     2496       run diasize_position-resize-button in this-procedure .
     2497       return .
     2498     end.
     2499     move_block:
     2500     do
     2501     on error undo move_block, retry move_block
     2502     :
     2503       if retry
     2504       then do:
     2505         do
     2506         on error undo move_block, leave move_block
     2507         :
     2508           if p-change-value > 0
     2509           then do:
     2510             for each buf_temp-diasize-handle
     2511             on error undo, next
     2512             :
     2513               assign
     2514                 v-object-handle = buf_temp-diasize-handle.handle-value
     2515               .
     2516               if v-object-handle <> v-diasize-resize-button
     2517               then do:
     2518                 assign
     2519                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2520                 .
     2521               end.
     2522             end.
     2523             assign
     2524               v-diasize-browse-handle :height = v-browse-height
     2525             .
     2526             for each buf_temp-browse-handle
     2527               where buf_temp-browse-handle.browse-type = 'height':u
     2528             on error undo, next
     2529             :
     2530               assign
     2531                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2532               .
     2533             end.
     2534             assign
     2535               frame Dialog-Frame :height = v-frame-height
     2536             .
     2537             if frame Dialog-Frame :scrollable = true
     2538             then do:
     2539               assign
     2540                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2541               .
     2542             end.
     2543             run diasize_position-resize-button in this-procedure .
     2544           end.
     2545           else do:
     2546             if frame Dialog-Frame :scrollable = true
     2547             then do:
     2548               assign
     2549                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2550               .
     2551             end.
     2552             assign
     2553               frame Dialog-Frame :height = v-frame-height
     2554             .
     2555             assign
     2556               v-diasize-browse-handle :height = v-browse-height
     2557             .
     2558             for each buf_temp-browse-handle
     2559               where buf_temp-browse-handle.browse-type = 'height':u
     2560             on error undo, next
     2561             :
     2562               assign
     2563                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2564               .
     2565             end.
     2566             for each buf_temp-diasize-handle
     2567             on error undo, next
     2568             :
     2569               assign
     2570                 v-object-handle = buf_temp-diasize-handle.handle-value
     2571               .
     2572               if v-object-handle <> v-diasize-resize-button
     2573               then do:
     2574                 assign
     2575                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2576                 .
     2577               end.
     2578             end.
     2579             run diasize_position-resize-button in this-procedure .
     2580           end.
     2581           assign
     2582             v-diasize-change-size = false
     2583           .
     2584           leave move_block .
     2585         end.
     2586       end.
     2587       assign
     2588         v-diasize-need-full-display = true
     2589       .
     2590       if v-diasize-change-size = false
     2591       then do:
     2592         assign
     2593           v-diasize-change-size = true
     2594         .
     2595       end.
     2596       else do:
     2597         return .
     2598       end.
     2599       assign
     2600         v-frame-height = frame Dialog-Frame :height
     2601         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2602         v-browse-height = v-diasize-browse-handle :height
     2603       .
     2604       for each buf_temp-browse-handle
     2605         where buf_temp-browse-handle.browse-type = 'height':u
     2606       :
     2607         assign
     2608           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2609         .
     2610       end.
     2611       for each buf_temp-diasize-handle
     2612       :
     2613         delete buf_temp-diasize-handle .
     2614       end.
     2615       assign
     2616         v-field-group-handle = frame Dialog-Frame :first-child
     2617       .
     2618       do while valid-handle(v-field-group-handle)
     2619       :
     2620         assign
     2621           v-object-handle = v-field-group-handle :first-child
     2622         .
     2623         do while valid-handle(v-object-handle)
     2624         :
     2625           if  v-object-handle <> v-diasize-browse-handle :handle
     2626           and can-query(v-object-handle, "row")
     2627           and can-query(v-object-handle, "height")
     2628           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2629           then do:
     2630             find first buf_temp-browse-handle
     2631               where buf_temp-browse-handle.browse-type   = 'height':u
     2632                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2633               no-error .
     2634             if available buf_temp-browse-handle
     2635             then do:
     2636             end.
     2637             else do:
     2638               create buf_temp-diasize-handle .
     2639               assign
     2640                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2641                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2642               .
     2643             end.
     2644           end.
     2645           assign
     2646             v-object-handle = v-object-handle :next-sibling
     2647           .
     2648         end.
     2649         assign
     2650           v-field-group-handle = v-field-group-handle :next-sibling
     2651         .
     2652       end.
     2653       do with frame Dialog-Frame
     2654       :
     2655         hide v-diasize-resize-button .
     2656         assign
     2657           v-diasize-resize-button :row    = 1
     2658           v-diasize-resize-button :column = 1
     2659         .
     2660       end.
     2661       if p-change-value > 0
     2662       then do:
     2663         if frame Dialog-Frame :scrollable = true
     2664         then do:
     2665           assign
     2666             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2667             no-error .
     2668           if error-status :error
     2669           or error-status :get-message(1) <> ""
     2670           then do:
     2671             undo move_block, retry move_block .
     2672           end.
     2673         end.
     2674         assign
     2675           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2676           no-error .
     2677         if error-status :error
     2678         or error-status :get-message(1) <> ""
     2679         then do:
     2680           undo move_block, retry move_block .
     2681         end.
     2682         assign
     2683           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2684           no-error .
     2685         if error-status :error
     2686         or error-status :get-message(1) <> ""
     2687         then do:
     2688           undo move_block, retry move_block .
     2689         end.
     2690         for each buf_temp-browse-handle
     2691           where buf_temp-browse-handle.browse-type = 'height':u
     2692         on error undo move_block, retry move_block
     2693         :
     2694           assign
     2695             buf_temp-browse-handle.browse-handle :height
     2696               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2697             no-error .
     2698           if error-status :error
     2699           or error-status :get-message(1) <> ""
     2700           then do:
     2701             undo move_block, retry move_block .
     2702           end.
     2703         end.
     2704         for each buf_temp-diasize-handle
     2705         on error undo move_block, retry move_block
     2706         :
     2707           assign
     2708             v-object-handle = buf_temp-diasize-handle.handle-value
     2709           .
     2710           if v-object-handle <> v-diasize-resize-button
     2711           then do:
     2712             assign
     2713               v-object-handle :row = v-object-handle :row + p-change-value
     2714               no-error .
     2715             if error-status :error
     2716             or error-status :get-message(1) <> ""
     2717             then do:
     2718               undo move_block, retry move_block .
     2719             end.
     2720           end.
     2721         end.
     2722       end.
     2723       else do:
     2724         for each buf_temp-diasize-handle
     2725         on error undo move_block, retry move_block
     2726         :
     2727           assign
     2728             v-object-handle = buf_temp-diasize-handle.handle-value
     2729           .
     2730           if v-object-handle <> v-diasize-resize-button
     2731           then do:
     2732             assign
     2733               v-object-handle :row = v-object-handle :row + p-change-value
     2734               no-error .
     2735             if error-status :error
     2736             or error-status :get-message(1) <> ""
     2737             then do:
     2738               undo move_block, retry move_block .
     2739             end.
     2740           end.
     2741         end.
     2742         assign
     2743           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2744           no-error .
     2745         if error-status :error
     2746         or error-status :get-message(1) <> ""
     2747         then do:
     2748           undo move_block, retry move_block .
     2749         end.
     2750         for each buf_temp-browse-handle
     2751           where buf_temp-browse-handle.browse-type = 'height':u
     2752         on error undo move_block, retry move_block
     2753         :
     2754           assign
     2755             buf_temp-browse-handle.browse-handle :height
     2756               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2757             no-error .
     2758           if error-status :error
     2759           or error-status :get-message(1) <> ""
     2760           then do:
     2761             undo move_block, retry move_block .
     2762           end.
     2763         end.
     2764         assign
     2765           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2766           no-error .
     2767         if error-status :error
     2768         or error-status :get-message(1) <> ""
     2769         then do:
     2770           undo move_block, retry move_block .
     2771         end.
     2772         if frame Dialog-Frame :scrollable = true
     2773         then do:
     2774           assign
     2775             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2776             no-error .
     2777           if error-status :error
     2778           or error-status :get-message(1) <> ""
     2779           then do:
     2780             undo move_block, retry move_block .
     2781           end.
     2782         end.
     2783       end.
     2784       if p-move-resize = true
     2785       then do:
     2786         run diasize_position-resize-button in this-procedure .
     2787       end.
     2788       if v-diasize-wndstore = true
     2789       then do:
     2790         if connected("ub") = true
     2791         then do:
     2792           define variable v-cntxt-db-num        as integer   no-undo .
     2793           define variable v-cntxt-userid        as character no-undo .
     2794           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2795                                             , OUTPUT v-cntxt-userid
     2796                                             ) .
     2797           run gbl/wndsizew.p
     2798             (input  v-cntxt-db-num
     2799             ,input  v-cntxt-userid
     2800             ,input  v-diasize-proc-name
     2801             ,input  'height':u
     2802             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2803             ) .
     2804         end.
     2805       end.
     2806     end.
     2807     assign
     2808       v-diasize-change-size = false
     2809     .
     2810   end procedure.
     2811   procedure diasize_set-height :
     2812     define input  parameter p-new-height  as decimal   no-undo .
     2813     define input  parameter p-move-resize as logical   no-undo .
     2814     do
     2815     on error undo, return error return-value
     2816     :
     2817       run diasize_change-height in this-procedure
     2818         (input  (p-new-height - frame Dialog-Frame :height)
     2819         ,input  p-move-resize
     2820         ) .
     2821     end.
     2822   end procedure.
     2823   procedure diasize_change-width :
     2824     define input  parameter p-change-value as decimal   no-undo .
     2825     define input  parameter p-move-resize  as logical   no-undo .
     2826     define variable v-field-group-handle   as handle    no-undo .
     2827     define variable v-object-handle        as handle    no-undo .
     2828     define variable v-frame-width          as decimal   no-undo .
     2829     define variable v-frame-virtual-width  as decimal   no-undo .
     2830     define variable v-browse-width         as decimal   no-undo .
     2831     define variable v-window-width         as decimal   no-undo .
     2832     define variable v-window-virtual-width as decimal   no-undo .
     2833     define variable v-change-sign          as integer   no-undo .
     2834     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2835     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2836     if p-change-value > 0
     2837     then do:
     2838       if frame Dialog-Frame :width + p-change-value >
     2839           session :width-chars
     2840       then do:
     2841         assign
     2842           p-change-value = session :width-chars - frame Dialog-Frame :width
     2843         .
     2844         if p-change-value <= 0
     2845         then do:
     2846           run diasize_position-resize-button in this-procedure .
     2847           return .
     2848         end.
     2849       end.
     2850     end.
     2851     if p-change-value < 0
     2852     then do:
     2853       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2854       then do:
     2855         assign
     2856           p-change-value = v-diasize-orig-frame-width
     2857                          - frame Dialog-Frame :width
     2858         .
     2859         if p-change-value >= 0
     2860         then do:
     2861           run diasize_position-resize-button in this-procedure .
     2862           return .
     2863         end.
     2864       end.
     2865     end.
     2866     if p-change-value >= 0
     2867     then do:
     2868       assign
     2869         v-change-sign = 1
     2870       .
     2871     end.
     2872     else do:
     2873       assign
     2874         v-change-sign = -1
     2875       .
     2876     end.
     2877     assign
     2878       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2879     .
     2880     if p-change-value = 0
     2881     then do:
     2882       run diasize_position-resize-button in this-procedure .
     2883       return .
     2884     end.
     2885     move_block:
     2886     do
     2887     on error undo move_block, leave move_block
     2888     :
     2889       if retry
     2890       then do:
     2891         do
     2892         on error undo move_block, leave move_block
     2893         :
     2894           if p-change-value > 0
     2895           then do:
     2896             for each buf_temp-diasize-handle
     2897             on error undo, next
     2898             :
     2899               assign
     2900                 v-object-handle = buf_temp-diasize-handle.handle-value
     2901               .
     2902               if v-object-handle <> v-diasize-resize-button
     2903               then do:
     2904                 assign
     2905                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2906                 .
     2907               end.
     2908             end.
     2909             assign
     2910               v-diasize-browse-handle :width = v-browse-width
     2911             .
     2912             for each buf_temp-browse-handle
     2913               where buf_temp-browse-handle.browse-type = 'width':u
     2914             on error undo, next
     2915             :
     2916               assign
     2917                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2918               .
     2919             end.
     2920             assign
     2921               frame Dialog-Frame :width = v-frame-width
     2922             .
     2923             if frame Dialog-Frame :scrollable = true
     2924             then do:
     2925               assign
     2926                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2927               .
     2928             end.
     2929             run diasize_position-resize-button in this-procedure .
     2930           end.
     2931           else do:
     2932             if frame Dialog-Frame :scrollable = true
     2933             then do:
     2934               assign
     2935                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2936               .
     2937             end.
     2938             assign
     2939               frame Dialog-Frame :width = v-frame-width
     2940             .
     2941             for each buf_temp-browse-handle
     2942               where buf_temp-browse-handle.browse-type = 'width':u
     2943             on error undo, next
     2944             :
     2945               assign
     2946                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2947               .
     2948             end.
     2949             assign
     2950               v-diasize-browse-handle :width = v-browse-width
     2951             .
     2952             for each buf_temp-diasize-handle
     2953             on error undo, next
     2954             :
     2955               assign
     2956                 v-object-handle = buf_temp-diasize-handle.handle-value
     2957               .
     2958               if v-object-handle <> v-diasize-resize-button
     2959               then do:
     2960                 assign
     2961                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2962                 .
     2963               end.
     2964             end.
     2965             run diasize_position-resize-button in this-procedure .
     2966           end.
     2967           assign
     2968             v-diasize-change-size = false
     2969           .
     2970           leave move_block .
     2971         end.
     2972       end.
     2973       assign
     2974         v-diasize-need-full-display = true
     2975       .
     2976       if v-diasize-change-size = false
     2977       then do:
     2978         assign
     2979           v-diasize-change-size = true
     2980         .
     2981       end.
     2982       else do:
     2983         return .
     2984       end.
     2985       assign
     2986         v-frame-width = frame Dialog-Frame :width
     2987         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2988         v-browse-width = v-diasize-browse-handle :width
     2989       .
     2990       for each buf_temp-browse-handle
     2991         where buf_temp-browse-handle.browse-type = 'width':u
     2992       :
     2993         assign
     2994           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2995         .
     2996       end.
     2997       for each buf_temp-diasize-handle
     2998       :
     2999         delete buf_temp-diasize-handle .
     3000       end.
     3001       assign
     3002         v-field-group-handle = frame Dialog-Frame :first-child
     3003       .
     3004       do while valid-handle(v-field-group-handle)
     3005       :
     3006         assign
     3007           v-object-handle = v-field-group-handle :first-child
     3008         .
     3009         do while valid-handle(v-object-handle)
     3010         :
     3011           if  v-object-handle <> v-diasize-browse-handle :handle
     3012           and v-object-handle <> v-diasize-resize-button
     3013           and can-query(v-object-handle, "row")
     3014           and can-query(v-object-handle, "height")
     3015           and ( v-object-handle :col + v-object-handle :width
     3016                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3017               )
     3018           then do:
     3019             find first buf_temp-browse-handle
     3020               where buf_temp-browse-handle.browse-type   = 'width':u
     3021                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3022               no-error .
     3023             if available buf_temp-browse-handle
     3024             then do:
     3025             end.
     3026             else do:
     3027               create buf_temp-diasize-handle .
     3028               assign
     3029                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3030                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3031               .
     3032             end.
     3033           end.
     3034           assign
     3035             v-object-handle = v-object-handle :next-sibling
     3036           .
     3037         end.
     3038         assign
     3039           v-field-group-handle = v-field-group-handle :next-sibling
     3040         .
     3041       end.
     3042       do with frame Dialog-Frame
     3043       :
     3044         hide v-diasize-resize-button .
     3045         v-diasize-resize-button :row = 1.
     3046         v-diasize-resize-button :column = 1.
     3047       end.
     3048       if p-change-value > 0
     3049       then do:
     3050         if frame Dialog-Frame :scrollable = true
     3051         then do:
     3052           assign
     3053             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3054             no-error .
     3055           if error-status :error
     3056           or error-status :get-message(1) <> ""
     3057           then do:
     3058             undo move_block, retry move_block.
     3059           end.
     3060         end.
     3061         assign
     3062           frame Dialog-Frame :width = v-frame-width + p-change-value
     3063           no-error .
     3064         if error-status :error
     3065         or error-status :get-message(1) <> ""
     3066         then do:
     3067           undo move_block, retry move_block.
     3068         end.
     3069         assign
     3070           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3071         no-error .
     3072         if error-status :error
     3073         or error-status :get-message(1) <> ""
     3074         then do:
     3075           undo move_block, retry move_block.
     3076         end.
     3077         for each buf_temp-browse-handle
     3078           where buf_temp-browse-handle.browse-type = 'width':u
     3079         on error undo move_block, retry move_block
     3080         :
     3081           assign
     3082             buf_temp-browse-handle.browse-handle :width
     3083               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3084             no-error .
     3085           if error-status :error
     3086           or error-status :get-message(1) <> ""
     3087           then do:
     3088             undo move_block, retry move_block .
     3089           end.
     3090         end.
     3091         for each buf_temp-diasize-handle
     3092         on error undo move_block, retry move_block
     3093         :
     3094           assign
     3095             v-object-handle = buf_temp-diasize-handle.handle-value
     3096           .
     3097           if v-object-handle <> v-diasize-resize-button
     3098           then do:
     3099             assign
     3100               v-object-handle :col = v-object-handle :col + p-change-value
     3101               no-error .
     3102             if error-status :error
     3103             or error-status :get-message(1) <> ""
     3104             then do:
     3105               undo move_block, retry move_block .
     3106             end.
     3107           end.
     3108         end.
     3109       end.
     3110       else do:
     3111         for each buf_temp-diasize-handle
     3112         on error undo move_block, retry move_block
     3113         :
     3114           assign
     3115             v-object-handle = buf_temp-diasize-handle.handle-value
     3116           .
     3117           if v-object-handle <> v-diasize-resize-button
     3118           then do:
     3119             assign
     3120               v-object-handle :col = v-object-handle :col + p-change-value
     3121               no-error .
     3122             if error-status :error
     3123             or error-status :get-message(1) <> ""
     3124             then do:
     3125               undo move_block, retry move_block .
     3126             end.
     3127           end.
     3128         end.
     3129         for each buf_temp-browse-handle
     3130           where buf_temp-browse-handle.browse-type = 'width':u
     3131         on error undo move_block, retry move_block
     3132         :
     3133           assign
     3134             buf_temp-browse-handle.browse-handle :width
     3135               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3136             no-error .
     3137           if error-status :error
     3138           or error-status :get-message(1) <> ""
     3139           then do:
     3140             undo move_block, retry move_block .
     3141           end.
     3142         end.
     3143         assign
     3144           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3145           no-error .
     3146         if error-status :error
     3147         or error-status :get-message(1) <> ""
     3148         then do:
     3149           undo move_block, retry move_block.
     3150         end.
     3151         assign
     3152           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3153         no-error .
     3154         if error-status :error
     3155         or error-status :get-message(1) <> ""
     3156         then do:
     3157           undo move_block, retry move_block.
     3158         end.
     3159         if frame Dialog-Frame :scrollable = true
     3160         then do:
     3161           assign
     3162             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3163           no-error .
     3164           if error-status :error
     3165           or error-status :get-message(1) <> ""
     3166           then do:
     3167             undo move_block, retry move_block.
     3168           end.
     3169         end.
     3170       end.
     3171       if p-move-resize
     3172       then do:
     3173         run diasize_position-resize-button in this-procedure .
     3174       end.
     3175       if v-diasize-wndstore = true
     3176       then do:
     3177         if connected("ub") = true
     3178         then do:
     3179           define variable v-cntxt-db-num        as integer   no-undo .
     3180           define variable v-cntxt-userid        as character no-undo .
     3181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3182                                             , OUTPUT v-cntxt-userid
     3183                                             ) .
     3184           run gbl/wndsizew.p
     3185             (input  v-cntxt-db-num
     3186             ,input  v-cntxt-userid
     3187             ,input  v-diasize-proc-name
     3188             ,input  'width':u
     3189             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3190             ) .
     3191         end.
     3192       end.
     3193     end.
     3194     assign
     3195       v-diasize-change-size = false
     3196     .
     3197   end procedure.
     3198   procedure diasize_set-width :
     3199     define input  parameter p-new-width  as decimal   no-undo .
     3200     define input  parameter p-move-resize as logical   no-undo .
     3201     do
     3202     on error undo, return error return-value
     3203     :
     3204       run diasize_change-width in this-procedure
     3205         (input  (p-new-width - frame Dialog-Frame :width)
     3206         ,input  p-move-resize
     3207         ) .
     3208     end.
     3209   end procedure.
     3210   procedure diasize_position-resize-button :
     3211     do with frame Dialog-Frame
     3212     :
     3213       hide v-diasize-resize-button .
     3214       assign
     3215         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3216                     - 1
     3217                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3218         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3219                     - 1
     3220                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3221       .
     3222       view v-diasize-resize-button .
     3223     end.
     3224   end procedure.
     3225   on alt-right anywhere
     3226   do:
     3227     run diasize_change-width in this-procedure
     3228       (input 1
     3229       ,input true
     3230       ) .
     3231     return no-apply .
     3232   end.
     3233   on alt-left anywhere
     3234   do:
     3235     run diasize_change-width in this-procedure
     3236       (input -1
     3237       ,input true
     3238       ) .
     3239     return no-apply .
     3240   end.
     3241   on alt-down anywhere
     3242   do:
     3243     run diasize_change-height in this-procedure
     3244       (input 1
     3245       ,input true
     3246       ) .
     3247     return no-apply .
     3248   end.
     3249   on alt-up anywhere
     3250   do:
     3251     run diasize_change-height in this-procedure
     3252       (input -1
     3253       ,input true
     3254       ) .
     3255     return no-apply .
     3256   end.
     3257   on alt-enter of frame Dialog-Frame
     3258   do:
     3259     run diasize_maximize in this-procedure
     3260       (input  ?
     3261       ).
     3262     return no-apply .
     3263   end.
     3264   procedure diasize_end-move :
     3265     do
     3266     on error undo, return error return-value
     3267     :
     3268       define variable v-row-delta as decimal   no-undo .
     3269       define variable v-col-delta as decimal   no-undo .
     3270       define variable v-new-row as decimal   no-undo .
     3271       define variable v-new-col as decimal   no-undo .
     3272       assign
     3273         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3274         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3275       .
     3276       assign
     3277         v-row-delta = v-new-row - frame Dialog-Frame :height
     3278         v-col-delta = v-new-col - frame Dialog-Frame :width
     3279       .
     3280       run diasize_change-height in this-procedure
     3281         (input v-row-delta
     3282         ,input true
     3283         ) .
     3284       run diasize_change-width in this-procedure
     3285         (input v-col-delta
     3286         ,input true
     3287         ) .
     3288     end.
     3289   end procedure.
     3290   procedure diasize_maximize :
     3291     define input  parameter p-action as logical   no-undo .
     3292     do
     3293     on error undo, return error return-value
     3294     :
     3295       if p-action = ?
     3296       then do:
     3297         if v-diasize-need-maximize = true
     3298         then do:
     3299           assign
     3300             p-action = true
     3301           .
     3302         end.
     3303         else do:
     3304           assign
     3305             p-action = false
     3306           .
     3307         end.
     3308       end.
     3309       if p-action = true
     3310       then do:
     3311         run diasize_change-height in this-procedure
     3312           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3313               - frame Dialog-Frame :height-chars
     3314           ,input true
     3315           ) .
     3316         run diasize_change-width in this-procedure
     3317           (input session :width-chars
     3318               - frame Dialog-Frame :width-chars
     3319           ,input true
     3320           ) .
     3321         assign
     3322           v-diasize-need-maximize = false
     3323         .
     3324       end.
     3325       else do:
     3326         run diasize_change-width in this-procedure
     3327           (input v-diasize-orig-frame-width
     3328               - frame Dialog-Frame :width-chars
     3329           ,input true
     3330           ) .
     3331         run diasize_change-height in this-procedure
     3332           (input v-diasize-orig-frame-height
     3333               - frame Dialog-Frame :height-chars
     3334           ,input true
     3335           ) .
     3336         assign
     3337           v-diasize-need-maximize = true
     3338         .
     3339       end.
     3340     end.
     3341   end procedure.
     3342   procedure diasize_restore-orig-size :
     3343     do
     3344     on error undo, return error return-value
     3345     :
     3346       assign
     3347         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3348         v-diasize-current-frame-height = frame Dialog-Frame :height
     3349       .
     3350       run diasize_set-height in this-procedure
     3351         (input  v-diasize-orig-frame-height
     3352         ,input  true
     3353         ) .
     3354       run diasize_set-width in this-procedure
     3355         (input  v-diasize-orig-frame-width
     3356         ,input  true
     3357         ) .
     3358     end.
     3359   end procedure.
     3360   procedure diasize_restore-current-size :
     3361     do
     3362     on error undo, return error return-value
     3363     :
     3364       run diasize_set-height in this-procedure
     3365         (input  v-diasize-current-frame-height
     3366         ,input  true
     3367         ) .
     3368       run diasize_set-width in this-procedure
     3369         (input  v-diasize-current-frame-width
     3370         ,input  true
     3371         ) .
     3372     end.
     3373   end procedure.
     3374   procedure diasize_set-browse-handle :
     3375     define input  parameter p-browse-handle as handle   no-undo .
     3376     define buffer buf_temp-browse-handle for temp-browse-handle .
     3377     do
     3378     on error undo, return error return-value
     3379     :
     3380       assign
     3381         v-diasize-browse-handle = p-browse-handle
     3382       .
     3383       for each buf_temp-browse-handle
     3384       on error undo, return error return-value
     3385       :
     3386         delete buf_temp-browse-handle .
     3387       end.
     3388     end.
     3389   end procedure.
     3390   procedure diasize_add_browse :
     3391     define input  parameter p-browse-type   as character no-undo .
     3392     define input  parameter p-browse-handle as handle    no-undo .
     3393     define buffer buf_temp-browse-handle for temp-browse-handle .
     3394     do
     3395     on error undo, return error return-value
     3396     :
     3397       assign
     3398         v-diasize-browse-number = v-diasize-browse-number + 1
     3399       .
     3400       create buf_temp-browse-handle .
     3401       assign
     3402         buf_temp-browse-handle.browse-type   = p-browse-type
     3403         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3404         buf_temp-browse-handle.browse-handle = p-browse-handle
     3405       .
     3406     end.
     3407   end procedure.
     3408   procedure diasize_init :
     3409     define variable v-default-value    as logical   no-undo .
     3410     define variable v-restore-saved    as logical   no-undo .
     3411     define variable v-resize-value-str as character no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415       do with frame Dialog-Frame
     3416       :
     3417         assign
     3418           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3419           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3420           v-diasize-browse-handle     = browse BR-rcp :handle
     3421         .
     3422         create button v-diasize-resize-button
     3423         assign
     3424           parent        = frame Dialog-Frame :first-child
     3425           label         = "s"
     3426           height-pixels = 16
     3427           width-pixels  = 16
     3428           visible       = true
     3429           sensitive     = true
     3430           movable       = true
     3431           triggers:
     3432             on end-move persistent run diasize_end-move in this-procedure .
     3433           end triggers.
     3434         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3435         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3436         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3437         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3438         assign
     3439           v-diasize-wndmax = false
     3440         .
     3441         if connected("ub") = true
     3442         then do:
     3443           define variable v-cntxt-db-num        as integer   no-undo .
     3444           define variable v-cntxt-userid        as character no-undo .
     3445           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3446                                             , OUTPUT v-cntxt-userid
     3447                                             ) .
     3448           run gbl/wndpar_r.p
     3449             (input  v-cntxt-db-num
     3450             ,input  v-cntxt-userid
     3451             ,input  'wndmax':U
     3452             ,output v-diasize-wndmax
     3453             ,output v-default-value
     3454             ) .
     3455         end.
     3456         assign
     3457           v-diasize-wndstore = false
     3458         .
     3459         if connected("ub") = true
     3460         then do:
     3461           run gbl/wndpar_r.p
     3462             (input  v-cntxt-db-num
     3463             ,input  v-cntxt-userid
     3464             ,input  'wndstore':U
     3465             ,output v-diasize-wndstore
     3466             ,output v-default-value
     3467             ) .
     3468         end.
     3469         assign
     3470           v-diasize-proc-name = entry(1, program-name(2), '.')
     3471         .
     3472         if v-diasize-wndstore = true
     3473         then do:
     3474           assign
     3475             v-restore-saved = false
     3476           .
     3477           if connected("ub") = true
     3478           then do:
     3479             run gbl/wndsizer.p
     3480               (input  v-cntxt-db-num
     3481               ,input  v-cntxt-userid
     3482               ,input  v-diasize-proc-name
     3483               ,input  'height':u
     3484               ,output v-resize-value-str
     3485               ) .
     3486             if v-resize-value-str <> '':U
     3487             then do:
     3488               run diasize_change-height in this-procedure
     3489                 (input  integer(v-resize-value-str)
     3490                 ,input  true
     3491                 ) .
     3492               assign
     3493                 v-restore-saved = true
     3494               .
     3495             end.
     3496           end.
     3497           if connected("ub") = true
     3498           then do:
     3499             run gbl/wndsizer.p
     3500               (input  v-cntxt-db-num
     3501               ,input  v-cntxt-userid
     3502               ,input  v-diasize-proc-name
     3503               ,input  'width':u
     3504               ,output v-resize-value-str
     3505               ) .
     3506             if v-resize-value-str <> '':U
     3507             then do:
     3508               run diasize_change-width in this-procedure
     3509                 (input  integer(v-resize-value-str)
     3510                 ,input  true
     3511                 ) .
     3512               assign
     3513                 v-restore-saved = true
     3514               .
     3515             end.
     3516           end.
     3517           if v-restore-saved <> true
     3518           then do:
     3519             if v-diasize-wndmax = true
     3520             then do:
     3521               run diasize_maximize in this-procedure
     3522                 (input  true
     3523                 ) .
     3524             end.
     3525           end.
     3526         end.
     3527         else do:
     3528           if v-diasize-wndmax = true
     3529           then do:
     3530             run diasize_maximize in this-procedure
     3531               (input  true
     3532               ) .
     3533           end.
     3534         end.
     3535       end.
     3536     end.
     3537   end procedure.
     3538   procedure diasize_need-full-display :
     3539     define output parameter p-need-full-display as logical   no-undo .
     3540     do
     3541     on error undo, return error return-value
     3542     :
     3543       assign
     3544         p-need-full-display = v-diasize-need-full-display
     3545       .
     3546       assign
     3547         v-diasize-need-full-display = false
     3548       .
     3549     end.
     3550   end procedure.
     3551   procedure get-context :
     3552      define output parameter p-db-num as integer          no-undo.
     3553      define output parameter p-user-id as character        no-undo.
     3554      define variable v-login               as character    no-undo.
     3555      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3556      define buffer buf_user-login  for ub.user-login .
     3557      do
     3558      on error undo, return error
     3559      :
     3560            FIND FIRST buf_sys-ctrl no-lock.
     3561            ASSIGN
     3562               v-login = USERID("ub")
     3563               p-db-num = buf_sys-ctrl.db-num
     3564            .
     3565            FIND FIRST buf_user-login
     3566                 WHERE buf_user-login.db-num = p-db-num
     3567                   AND buf_user-login.user-login = v-login
     3568                 no-lock
     3569                 no-error
     3570                 .
     3571            IF AVAILABLE buf_user-login
     3572            THEN DO:
     3573               assign
     3574                  p-user-id = buf_user-login.user-id
     3575               .
     3576            END.
     3577      end.
     3578   end procedure.
     3579       run diasize_init in this-procedure .
     3580   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3581   procedure rcps_get-profile-id :
     3582   define output parameter p-local-profile-id as integer no-undo .
     3583   do
     3584   on error undo, return error:
     3585   p-local-profile-id = p-profile-id.
     3586   end.
     3587   end procedure.
     3588   PROCEDURE rcps_fill-table :
     3589   define input parameter p-clear-params as logical no-undo .
     3590   if p-clear-params then do:
     3591   FOR EACH tt-rule-call-param:
     3592       DELETE tt-rule-call-param.
     3593   END.
     3594   end.
     3595    FOR EACH tt0-rule-call-param:
     3596      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3597        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3598           NEXT.
     3599        end.
     3600        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3601          NEXT.
     3602        end.
     3603        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3604          NEXT.
     3605        end.
     3606        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3607          NEXT.
     3608        end.
     3609        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3610          NEXT.
     3611        end.
     3612      END.
     3613      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     3614        next.
     3615      end.
     3616      IF p-list-mode = 'rp-rule-param':U
     3617      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3618      THEN DO:
     3619         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3620           NEXT.
     3621         end.
     3622         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3623           NEXT.
     3624         end.
     3625      END.
     3626      CREATE tt-rule-call-param.
     3627      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     3628   END.
     3629   END PROCEDURE.
     3630   procedure rcps_get-value :
     3631   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3632   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3633   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3634   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3635   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     3636   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     3637   DEFINE output parameter p-value-date AS date NO-UNDO.
     3638   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     3639   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     3640   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     3641   define variable v-current-index as integer no-undo init -1.
     3642   define variable v-start as logical no-undo init yes.
     3643   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3644   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3645   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3646   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3647   do
     3648   on error undo, return error
     3649   :
     3650   FOR FIRST buf_rp-rule-param WHERE
     3651         buf_rp-rule-param.profile_id = p-profile-id
     3652     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3653   , each buf_tt-rule-call-param WHERE
     3654      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3655   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3656   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3657   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3658   AND buf_tt-rule-call-param.p-index >= pp-index
     3659    ,each buf_term_tt-rule-call-param where
     3660          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3661      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3662      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3663      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3664      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3665      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     3666     by buf_term_tt-rule-call-param.call_id
     3667     by buf_term_tt-rule-call-param.codex_id
     3668     by buf_term_tt-rule-call-param.ruleset_id
     3669     by buf_term_tt-rule-call-param.order_id
     3670     by buf_term_tt-rule-call-param.param-name
     3671     by buf_term_tt-rule-call-param.p-index :
     3672       if v-start
     3673       then do:
     3674         assign
     3675         pp-index = buf_term_tt-rule-call-param.p-index
     3676         p-value-character = buf_term_tt-rule-call-param.param-value-character
     3677         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     3678         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     3679         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     3680         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     3681         v-start = no
     3682         .
     3683       end.
     3684       else do:
     3685         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     3686           v-current-index = buf_term_tt-rule-call-param.p-index.
     3687           leave.
     3688         end.
     3689             end.
     3690     end.
     3691     pp-index = v-current-index.
     3692   end.
     3693   end procedure.
     3694   PROCEDURE rcps_proc-b-add :
     3695   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3696   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3697   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3698   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3699   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3700   define variable v-ind as integer no-undo .
     3701   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3702   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3703   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3704   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3705   FOR FIRST buf_rp-rule-param WHERE
     3706             buf_rp-rule-param.profile_id = p-profile-id
     3707         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3708       , first buf0_tt-rule-call-param WHERE
     3709          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3710      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3711      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3712      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3713     LEAVE.
     3714   END.
     3715   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3716     BELL.
     3717     RETURN.
     3718   END.
     3719   for each buf_rp-rule-param where
     3720           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3721       and buf_rp-rule-param.profile_id = p-profile-id,
     3722       first buf_tt-rule-call-param where
     3723           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3724       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3725       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3726       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3727       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3728       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3729       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3730       and buf_tt-rule-call-param.p-index = p-index:
     3731     RETURN.
     3732   END.
     3733   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3734   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3735   THEN DO:
     3736     BELL.
     3737     RETURN.
     3738   END.
     3739   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     3740     BELL.
     3741     RETURN.
     3742   END.
     3743   find last buf_tt-rule-call-param where
     3744            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3745        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     3746        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     3747        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     3748        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     3749   if available buf_tt-rule-call-param
     3750   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3751        or
     3752        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3753        )
     3754   and buf_tt-rule-call-param.p-index > 0 then do:
     3755     v-ind = buf_tt-rule-call-param.p-index.
     3756   end.
     3757   for each buf_rp-rule-param where
     3758           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3759       and buf_rp-rule-param.profile_id = p-profile-id,
     3760       first buf_tt-rule-call-param where
     3761           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3762       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3763       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3764       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3765       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3766       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3767       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3768       and buf_tt-rule-call-param.p-index = 0
     3769   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3770   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3771   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3772   :
     3773     create buf2_tt-rule-call-param.
     3774     buffer-copy buf_tt-rule-call-param
     3775     except p-index
     3776     to buf2_tt-rule-call-param
     3777     assign
     3778     buf2_tt-rule-call-param.p-index = v-ind + 1
     3779     .
     3780   end.
     3781   END PROCEDURE.
     3782   PROCEDURE rcps_proc-b-del :
     3783   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3784   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3785   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3786   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3787   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3788   define variable v-ind as integer no-undo .
     3789   define variable v-once-more as integer no-undo .
     3790   define variable v-call-id as character no-undo .
     3791   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3792   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3793   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3794   if pp-index = 0 then do:
     3795     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3796   end.
     3797   FOR first buf_rp-rule-param WHERE
     3798             buf_rp-rule-param.profile_id = p-profile-id
     3799         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3800       , first buf0_tt-rule-call-param WHERE
     3801          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3802      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3803      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3804      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3805      AND buf0_tt-rule-call-param.p-index = pp-index
     3806      :
     3807     LEAVE.
     3808   END.
     3809   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3810     FOR first buf_rp-rule-param WHERE
     3811               buf_rp-rule-param.profile_id = p-profile-id
     3812           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3813         , last buf0_tt-rule-call-param WHERE
     3814           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3815       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3816       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3817       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3818       AND buf0_tt-rule-call-param.p-index > pp-index :
     3819       leave.
     3820     end.
     3821     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3822     return "not-found".
     3823     end.
     3824     else do:
     3825       return ''.
     3826     end.
     3827   END.
     3828   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3829   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3830   THEN DO:
     3831     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3832   END.
     3833   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3834     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3835   END.
     3836   for each buf_rp-rule-param where
     3837           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3838       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3839       each buf_tt-rule-call-param where
     3840           buf_tt-rule-call-param.call_id = p-call-id
     3841       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3842       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3843       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3844       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3845       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3846       and buf_tt-rule-call-param.once-more = p-once-more
     3847       and buf_tt-rule-call-param.p-index = pp-index
     3848   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3849   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3850   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3851       DELETE buf_tt-rule-call-param.
     3852   end.
     3853   return ''.
     3854   END PROCEDURE.
     3855   PROCEDURE rcps_proc-save0 :
     3856   FOR EACH tt-rule-call-param
     3857   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3858   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3859   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3860   :
     3861      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3862               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3863          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3864          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3865          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3866          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3867          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3868      if not available tt0-rule-call-param
     3869      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3870           OR
     3871           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3872           )
     3873      and tt-rule-call-param.p-index > 0 then do:
     3874        create tt0-rule-call-param.
     3875      end.
     3876      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3877   END.
     3878   FOR EACH tt0-rule-call-param
     3879   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3880   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3881   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3882   :
     3883     if tt0-rule-call-param.p-index = 0 then next.
     3884     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3885     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3886             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3887         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3888         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3889         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3890         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3891         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3892     if not available tt-rule-call-param
     3893     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3894         OR
     3895         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3896         )
     3897     and tt0-rule-call-param.p-index > 0
     3898     then do:
     3899        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3900           NEXT.
     3901        end.
     3902        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3903          NEXT.
     3904        end.
     3905        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3906          NEXT.
     3907        end.
     3908        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3909          NEXT.
     3910        end.
     3911        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3912          NEXT.
     3913        end.
     3914       IF p-list-mode = 'rp-rule-param':U
     3915       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3916       THEN DO:
     3917         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3918           NEXT.
     3919         end.
     3920         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3921           NEXT.
     3922         end.
     3923       end.
     3924       delete tt0-rule-call-param.
     3925     end.
     3926   end.
     3927   END PROCEDURE.
     3928   PROCEDURE rcps_set-value :
     3929   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3930   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3931   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3932   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3933   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3934   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3935   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3936   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3937   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3938   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3939   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3940   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3941   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3942   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3943   define variable v-found as logical no-undo .
     3944   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3945   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3946   FOR FIRST buf_rp-rule-param WHERE
     3947             buf_rp-rule-param.profile_id = p-profile-id
     3948         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3949       , first buf_tt-rule-call-param WHERE
     3950          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3951      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3952      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3953      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3954     ASSIGN
     3955     v-codex-id = buf_tt-rule-call-param.codex_id
     3956     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3957     v-order-id = buf_tt-rule-call-param.order_id
     3958     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3959     .
     3960     LEAVE.
     3961   END.
     3962   CASE p-list-mode:
     3963     WHEN 'rp-rule-param':U THEN DO:
     3964       if pp-index > 0
     3965       then do:
     3966         FOR EACH  buf_rp-rule-param NO-LOCK where
     3967             buf_rp-rule-param.profile_id = p-profile-id
     3968             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3969             ,EACH buf_tt-rule-call-param WHERE
     3970                 buf_tt-rule-call-param.profile_id = p-profile-id
     3971             AND buf_tt-rule-call-param.once-more = p-once-more
     3972             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3973             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3974             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3975             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3976             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3977             AND buf_tt-rule-call-param.p-index = pp-index
     3978         ON error undo, return error :
     3979           v-found = yes.
     3980         end.
     3981       end.
     3982       if not v-found then do:
     3983         run rcps_proc-b-add in this-procedure (
     3984                                                  input p-profile-id
     3985                                                 ,input p-once-more
     3986                                                 ,input p-call-id
     3987                                                 ,
     3988                                                  input p-rp-param-name
     3989                                                 ,input pp-index).
     3990       end.
     3991       FOR EACH  buf_rp-rule-param NO-LOCK where
     3992           buf_rp-rule-param.profile_id = p-profile-id
     3993           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3994           ,EACH buf_tt-rule-call-param WHERE
     3995               buf_tt-rule-call-param.profile_id = p-profile-id
     3996           AND buf_tt-rule-call-param.once-more = p-once-more
     3997           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3998           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3999           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4000           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4001           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4002           AND buf_tt-rule-call-param.p-index = pp-index
     4003         ON error undo, return error :
     4004         assign
     4005         buf_tt-rule-call-param.param-value-character = p-value-character
     4006         buf_tt-rule-call-param.param-value-date      = p-value-date
     4007         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4008         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4009         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4010         .
     4011       END.
     4012     END.
     4013     WHEN 'rule-call-param':U THEN DO:
     4014       FIND FIRST buf_tt-rule-call-param WHERE
     4015           buf_tt-rule-call-param.call_id = p-call-id
     4016       AND buf_tt-rule-call-param.codex_id = v-codex-id
     4017       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     4018       AND buf_tt-rule-call-param.order_id = v-order-id
     4019       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     4020       AND buf_tt-rule-call-param.p-index = pp-index.
     4021       assign
     4022       buf_tt-rule-call-param.param-value-character = p-value-character
     4023       buf_tt-rule-call-param.param-value-date      = p-value-date
     4024       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4025       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4026       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4027       .
     4028     END.
     4029   END CASE.
     4030   END PROCEDURE.
     4031   procedure rcps_get-rule-on-off :
     4032   define input parameter p-codex-id as integer no-undo .
     4033   define input parameter p-ruleset-id as integer no-undo .
     4034   define input parameter p-rule-id as integer no-undo .
     4035   define input parameter p-profile-id as integer no-undo .
     4036   define input parameter p-once-more as integer no-undo .
     4037   define output parameter p-on-off as logical no-undo .
     4038   if valid-handle(p-call-handle)
     4039   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     4040     run rcpscont_get-rule-on-off in p-call-handle (
     4041                                              input p-codex-id
     4042                                             ,input p-ruleset-id
     4043                                             ,input p-rule-id
     4044                                             ,input p-profile-id
     4045                                             ,input p-once-more
     4046                                             ,output p-on-off) no-error.
     4047   end.
     4048   end procedure.
     4049   procedure rcps_set-rule-on-off :
     4050   define input parameter p-codex-id as integer no-undo .
     4051   define input parameter p-ruleset-id as integer no-undo .
     4052   define input parameter p-rule-id as integer no-undo .
     4053   define input parameter p-profile-id as integer no-undo .
     4054   define input parameter p-once-more as integer no-undo .
     4055   define input parameter p-on-off as logical no-undo .
     4056   if valid-handle(p-call-handle)
     4057   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     4058     run rcpscont_set-rule-on-off in p-call-handle (
     4059                                              input p-codex-id
     4060                                             ,input p-ruleset-id
     4061                                             ,input p-rule-id
     4062                                             ,input p-profile-id
     4063                                             ,input p-once-more
     4064                                             ,input p-on-off) no-error.
     4065   end.
     4066   end procedure.
     4067   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4068   PROCEDURE rcps_MyEnable0 :
     4069   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     4070   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     4071   ASSIGN
     4072   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     4073   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     4074   .
     4075   ASSIGN
     4076   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     4077   REPEAT WHILE valid-handle(v-ch0):
     4078      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     4079        v-ch[1] = v-ch0.
     4080        v-ch0:VISIBLE = NO.
     4081      END.
     4082      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     4083        v-ch[2] = v-ch0.
     4084        v-ch0:VISIBLE = NO.
     4085      END.
     4086      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     4087        v-ch[3] = v-ch0.
     4088        v-ch0:VISIBLE = NO.
     4089      END.
     4090      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     4091        v-ch[4] = v-ch0.
     4092        v-ch0:VISIBLE = NO.
     4093      END.
     4094      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     4095        v-ch[5] = v-ch0.
     4096        v-ch0:VISIBLE = NO.
     4097      END.
     4098      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     4099        v-ch[6] = v-ch0.
     4100      END.
     4101      IF v-ch0:LABEL = "Значение" THEN
     4102      v-ch0:RESIZABLE = YES.
     4103      v-ch0 = v-ch0:NEXT-COLUMN.
     4104   END.
     4105   assign
     4106   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     4107   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     4108   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     4109   .
     4110   CASE p-list-mode:
     4111     WHEN 'rule-call-param':U THEN DO:
     4112        ASSIGN
     4113        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     4114        .
     4115     END.
     4116     WHEN 'rp-rule-param':U
     4117     or
     4118     when 'rp-rule-param':U + chr(44) + 'все':U
     4119     THEN DO:
     4120       assign
     4121       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     4122       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     4123       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     4124       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     4125       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     4126       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     4127       .
     4128     END.
     4129   END CASE.
     4130    IF p-call-id <> '':U THEN DO:
     4131      v-ch[6]:VISIBLE = NO.
     4132    END.
     4133     IF p-profile-id <> 0 THEN DO:
     4134      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     4135    END.
     4136     IF p-rule-id <> 0 THEN DO:
     4137      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     4138    END.
     4139     IF p-once-more <> 0 THEN DO:
     4140      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     4141    END.
     4142   END PROCEDURE.
     4143   PROCEDURE rcps_Openbr :
     4144   CASE p-list-mode:
     4145     WHEN 'rp-rule-param':U THEN DO:
     4146         OPEN QUERY br-rcp
     4147         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     4148             ,FIRST X_rp-rule-param WHERE
     4149                 X_rp-rule-param.profile_id = p-profile-id
     4150             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     4151           , first tt-rule-call-param WHERE
     4152              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     4153          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     4154          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     4155          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     4156            ,each term_tt-rule-call-param where
     4157                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     4158              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     4159              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     4160              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     4161              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     4162         BY tt-rule-call-param.call_id
     4163         BY tt-rule-call-param.codex_id
     4164         BY tt-rule-call-param.ruleset_id
     4165         BY tt-rule-call-param.order_id
     4166         BY tt-rule-call-param.param-num.
     4167     END.
     4168   END CASE.
     4169   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     4170   APPLy "VALUE-CHANGED" to br-rcp.
     4171   END PROCEDURE.
     4172   PROCEDURE rcps_proc-b-chg PRIVATE :
     4173   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     4174   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     4175   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     4176   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     4177   define variable v-param-data-type as character no-undo .
     4178   define variable v-rid-list as character no-undo .
     4179   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     4180     RETURN ERROR.
     4181   END.
     4182   ASSIGN
     4183   v-rec1 = rowid(X_ruledict-param)
     4184   v-rec2 = rowid(X_rp-rule-param)
     4185   v-rec3 = Rowid(tt-rule-call-param)
     4186   v-rec4 = Rowid(term_tt-rule-call-param)
     4187   .
     4188   run rcps_openbr in this-procedure .
     4189   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     4190   IF ERROR-STATUS:ERROR THEN DO:
     4191     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     4192   END.
     4193   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     4194   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     4195   END PROCEDURE.
     4196   PROCEDURE rcps_set-row-color :
     4197   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     4198   ASSIGN
     4199   v-ch[1]:FGCOLOR = GREY_COLOR
     4200   v-ch[1]:BGCOLOR = GREY_Color
     4201   v-ch[1]:PFCOLOR = GREY_Color
     4202   v-ch[2]:FGCOLOR = GREY_COLOR
     4203   v-ch[2]:BGCOLOR = GREY_Color
     4204   v-ch[2]:PFCOLOR = GREY_Color
     4205   v-ch[3]:FGCOLOR = GREY_COLOR
     4206   v-ch[3]:BGCOLOR = GREY_Color
     4207   v-ch[3]:PFCOLOR = GREY_Color
     4208   v-ch[4]:FGCOLOR = GREY_COLOR
     4209   v-ch[4]:BGCOLOR = GREY_Color
     4210   v-ch[4]:PFCOLOR = GREY_Color
     4211   v-ch[5]:FGCOLOR = GREY_COLOR
     4212   v-ch[5]:BGCOLOR = GREY_Color
     4213   v-ch[5]:PFCOLOR = GREY_Color
     4214   .
     4215   CASE entry(1, p-data-type):
     4216        WHEN 'character':U THEN DO:
     4217         ASSIGN
     4218         v-ch[1]:FGCOLOR = BLACK_COLOR
     4219         v-ch[1]:BGCOLOR = WHITE_Color.
     4220       END.
     4221       WHEN 'decimal':U THEN DO:
     4222         ASSIGN
     4223         v-ch[3]:FGCOLOR = BLACK_COLOR
     4224         v-ch[3]:BGCOLOR = WHITE_Color.
     4225       END.
     4226       WHEN 'integer':U THEN DO:
     4227         ASSIGN
     4228         v-ch[4]:FGCOLOR = BLACK_COLOR
     4229         v-ch[4]:BGCOLOR = WHITE_Color.
     4230       END.
     4231       WHEN 'date':U THEN DO:
     4232         ASSIGN
     4233         v-ch[2]:FGCOLOR = BLACK_COLOR
     4234         v-ch[2]:BGCOLOR = WHITE_Color.
     4235        END.
     4236        WHEN 'logical':U THEN DO:
     4237          ASSIGN
     4238          v-ch[5]:FGCOLOR = BLACK_COLOR
     4239          v-ch[5]:BGCOLOR = WHITE_Color.
     4240        END.
     4241   END CASE.
     4242   END PROCEDURE.
     4243   MAIN-BLOCK:
     4244   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4245      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4246   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4247     run mainmenu_getcntxt in parparentproc
     4248       (output v-cntxt-db-num
     4249       ,output v-cntxt-userid
     4250       ,output v-cntxt-level
     4251       ,output v-cntxt-host-code-obj
     4252       ,output v-cntxt-obj-type
     4253       ,output v-cntxt-obj-code
     4254       ,output v-cntxt-db-num-obj
     4255       ,output v-cntxt-is-admin
     4256       ) .
     4257      run gbl/dftempl.p ( input 'rp-rule-param':U
     4258                        , output v-dflt-rec) no-error.
     4259       if error-status:error then dO:
     4260         message
     4261         vss-workfile vss-revision vss-description skip
     4262         "Невозможно найти recid template записи в таблице rp-rule-param"
     4263         view-as alert-box error .
     4264         return error.
     4265       end.
     4266       run gbl/dftempl.p ( input 'ruledict-param':U
     4267                         , output v-rp-dflt-rec) no-error.
     4268        if error-status:error then dO:
     4269          message
     4270          vss-workfile vss-revision vss-description skip
     4271          "Невозможно найти recid template записи в таблице ruledict-param"
     4272          view-as alert-box error .
     4273          return error.
     4274        end.
     4275     IF p-list-mode = 'rp-rule-param':U
     4276     THEN DO:
     4277       FIND FIRST buf_rule-profile NO-LOCK WHERE
     4278                 buf_rule-profile.profile_id = p-profile-id.
     4279       run gen-key-rec in this-procedure ( input 'rule-profile':U
     4280                                       ,input buffer buf_rule-profile:handle
     4281                                       ,output v-uniq-key-rec).
     4282       FIND FIRST buf_ruledict NO-LOCK WHERE
     4283                 buf_ruledict.entry-type = 'rule-profile':U
     4284          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     4285       v-rcps-entry-id = buf_ruledict.entry-id.
     4286     END.
     4287     ELSE DO:
     4288        MESSAGE
     4289        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     4290        VIEW-AS alert-box.
     4291     END.
     4292     if p-call-id begins 'schedule':U then do:
     4293       v-running-mode = yes.
     4294     end.
     4295     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     4296     RUN Myenable in THIS-PROCEDURE.
     4297     WAIT-FOR GO OF FRAME Dialog-Frame.
     4298   END.
     4299   RUN disable_UI.
     4300   PROCEDURE disable_UI :
     4301     HIDE FRAME Dialog-Frame.
     4302   END PROCEDURE.
     4303   PROCEDURE enable_UI :
     4304     DISPLAY f-issue-code EDITOR-1 f-issue-name f-dis-tot-obj-code
     4305             f-dis-tot-obj-name f-issue-date f-valid-date f-cli-grp-code f-grp-name
     4306             f-category f-lim-cr t-on-off
     4307         WITH FRAME Dialog-Frame.
     4308     ENABLE B-exit b-quit B-Help RECT-1 f-issue-code b-issue-code EDITOR-1
     4309            f-dis-tot-obj-code b-dis-tot-obj-code f-issue-date f-valid-date
     4310            f-cli-grp-code b-cli-grp f-grp-name f-category f-lim-cr t-on-off
     4311            BR-rcp
     4312         WITH FRAME Dialog-Frame.
     4313     VIEW FRAME Dialog-Frame.
     4314   END PROCEDURE.
     4315   PROCEDURE MyEnable :
     4316   define variable v-list as character no-undo .
     4317   define variable glog as logical no-undo .
     4318   define variable v-index-id as integer no-undo .
     4319   define variable v-value-character as character no-undo .
     4320   define variable v-value-date as date no-undo .
     4321   define variable v-value-decimal as decimal no-undo .
     4322   define variable v-value-integer as integer no-undo .
     4323   define variable v-value-logical as logical no-undo .
     4324   define variable v-full-grp-name as character no-undo .
     4325   define variable v-rule-sale-out as logical no-undo .
     4326   define variable v-rule-sale-in as logical no-undo .
     4327   define variable v-rule-trn-out as logical no-undo .
     4328   define variable v-rule-trn-in as logical no-undo .
     4329   define variable v-rule-import as logical no-undo .
     4330   define variable v-rule-sale-out-obj as logical no-undo .
     4331   define variable v-rule-sale-in-obj as logical no-undo .
     4332   define variable v-rule-trn-out-obj as logical no-undo .
     4333   define variable v-rule-trn-in-obj as logical no-undo .
     4334   define variable v-rule-import-obj as logical no-undo .
     4335   define variable v-rule-payment as logical no-undo .
     4336   define buffer buf_dis-rule for ub.dis-rule.
     4337   define buffer buf_cli-grp for ub.cli-grp.
     4338   DEFINE BUFFER buf_clients FOR ub.clients.
     4339   DEFINE BUFFER buf2_clients FOR ub.clients.
     4340   run rcps_Myenable0 in this-procedure .
     4341   v-index-id = 0.
     4342   RUN rcps_get-value IN THIS-PROCEDURE (
     4343                                    INPUT p-profile-id
     4344                                   ,INPUT p-once-more
     4345                                   ,INPUT p-call-id
     4346                                   ,INPUT "p-issue-code"
     4347                                   ,INPUT-output v-index-id
     4348                                   ,output v-value-character
     4349                                   ,output v-value-date
     4350                                   ,output v-value-decimal
     4351                                   ,output f-issue-code
     4352                                   ,output v-value-logical
