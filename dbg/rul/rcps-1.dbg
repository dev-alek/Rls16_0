     1736   END.
     1737   ON CHOOSE OF b-cli-grp IN FRAME Dialog-Frame
     1738   DO:
     1739     DEFINE VARIABLE rid-list as CHARACTER no-undo.
     1740     define variable v-full-name as character no-undo .
     1741     DEFINE BUFFER buf_cli-grp FOR ub.cli-grp.
     1742     if f-cli-grp-code <> 0 then do:
     1743       find first buf_cli-grp no-lock where
     1744                 buf_cli-grp.node-code = f-cli-grp-code no-error.
     1745       if available buf_cli-grp then do:
     1746         rid-list = string(recid(buf_cli-grp)).
     1747       end.
     1748     end.
     1749     run ref/cli-grps.w (
     1750                    input parparentproc
     1751                   ,input ('терм':U + chr(44) + "b-sel")
     1752                   ,input-output rid-list).
     1753     if rid-list <> "" then do:
     1754       FIND FIRST buf_cli-grp NO-LOCK WHERE
     1755                 recid(buf_cli-grp) = integer(rid-list) NO-ERROR.
     1756       IF NOT AVAIL buf_cli-grp then return no-apply.
     1757       assign
     1758       f-cli-grp-code = buf_cli-grp.node-code
     1759       .
     1760       run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code
     1761                                                       ,output v-full-name).
     1762       DISPLAY
     1763       f-cli-grp-code
     1764       v-full-name @ f-grp-name
     1765       WITH FRAME Dialog-Frame.
     1766     end.
     1767   END.
     1768   ON CHOOSE OF b-dis-tot-obj-code IN FRAME Dialog-Frame
     1769   DO:
     1770     DEFINE VARIABLE rid-list as CHARACTER no-undo.
     1771     DEFINE BUFFER buf_shop FOR ub.shop.
     1772     DEFINE BUFFER buf_clients FOR ub.clients.
     1773     if f-dis-tot-obj-code <> 0 then do:
     1774       find first buf_shop no-lock where
     1775                buf_shop.obj-code = f-dis-tot-obj-code no-error.
     1776       if available buf_shop then do:
     1777         rid-list = string(recid(buf_shop)).
     1778       end.
     1779     end.
     1780     run adm/shops.w (
     1781                  input parparentproc
     1782                 ,input "b-sel"
     1783                 ,input-output rid-list
     1784                 ,input no
     1785                 ).
     1786     if rid-list <> "" then do:
     1787        FIND FIRST buf_shop NO-LOCK WHERE recid(buf_shop) = integer(rid-list) NO-ERROR.
     1788        IF NOT AVAILABLE buf_shop then return no-apply.
     1789         FIND FIRST buf_clients No-LOCK WHERE
     1790                   buf_clients.obj-type = 'маг':U
     1791              AND buf_clients.obj-code = buf_shop.obj-code NO-ERROR.
     1792       IF NOT AVAIL buf_clients then return no-apply.
     1793       assign
     1794       f-dis-tot-obj-code = buf_clients.obj-code
     1795       f-dis-tot-obj-name = BUF_clients.obj-name
     1796       .
     1797       DISPLAY
     1798       f-dis-tot-obj-code
     1799       f-dis-tot-obj-name
     1800       WITH FRAME Dialog-Frame.
     1801     end.
     1802   END.
     1803   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1804   DO:
     1805     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1806     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1807   END.
     1808   ON CHOOSE OF b-issue-code IN FRAME Dialog-Frame
     1809   DO:
     1810     DEFINE VARIABLE rid-list as CHARACTER no-undo.
     1811     DEFINE BUFFER buf_shop FOR ub.shop.
     1812     DEFINE BUFFER buf_clients FOR ub.clients.
     1813     if f-issue-code <> 0 then do:
     1814       find first buf_shop no-lock where
     1815                buf_shop.obj-code = f-issue-code no-error.
     1816       if available buf_shop then do:
     1817         rid-list = string(recid(buf_shop)).
     1818       end.
     1819     end.
     1820     run adm/shops.w (
     1821                  input parparentproc
     1822                 ,input "b-sel"
     1823                 ,input-output rid-list
     1824                 ,input no
     1825                 ).
     1826     if rid-list <> "" then do:
     1827        FIND FIRST buf_shop NO-LOCK WHERE recid(buf_shop) = integer(rid-list) NO-ERROR.
     1828        IF NOT AVAILABLE buf_shop then return no-apply.
     1829         FIND FIRST buf_clients No-LOCK WHERE
     1830                   buf_clients.obj-type = 'маг':U
     1831              AND buf_clients.obj-code = buf_shop.obj-code NO-ERROR.
     1832       IF NOT AVAIL buf_clients then return no-apply.
     1833       assign
     1834       f-issue-code = buf_clients.obj-code
     1835       f-issue-name = BUF_clients.obj-name
     1836       .
     1837       DISPLAY
     1838       f-issue-code
     1839       f-issue-name
     1840       WITH FRAME Dialog-Frame.
     1841     end.
     1842   END.
     1843   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
