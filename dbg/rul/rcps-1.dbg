     4534   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     4535   ASSIGN
     4536   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     4537   REPEAT WHILE valid-handle(v-ch0):
     4538      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     4539        v-ch[1] = v-ch0.
     4540        v-ch0:VISIBLE = NO.
     4541      END.
     4542      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     4543        v-ch[2] = v-ch0.
     4544        v-ch0:VISIBLE = NO.
     4545      END.
     4546      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     4547        v-ch[3] = v-ch0.
     4548        v-ch0:VISIBLE = NO.
     4549      END.
     4550      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     4551        v-ch[4] = v-ch0.
     4552        v-ch0:VISIBLE = NO.
     4553      END.
     4554      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     4555        v-ch[5] = v-ch0.
     4556        v-ch0:VISIBLE = NO.
     4557      END.
     4558      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     4559        v-ch[6] = v-ch0.
     4560      END.
     4561      IF v-ch0:LABEL = "Значение" THEN
     4562      v-ch0:RESIZABLE = YES.
     4563      v-ch0 = v-ch0:NEXT-COLUMN.
     4564   END.
