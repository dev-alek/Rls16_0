     1689   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1690   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1691   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1692   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1693   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1694       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
