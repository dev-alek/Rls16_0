        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление ruleset".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable v-mess as character no-undo .
       80   define buffer buf_ruleset  for dictdb.ruleset.
       81   define buffer buf_prop-ruleset  for dictdb.prop-ruleset.
       82   define buffer buf_pscript-ruleset  for dictdb.pscript-ruleset.
       83   define buffer buf_rule  for dictdb.rule.
       84   define buffer buf_rule-by-set  for dictdb.rule-by-set.
       85   define buffer buf_rule-call-param  for dictdb.rule-call-param.
       86   define buffer buf_rule-by-profile  for dictdb.rule-by-profile.
       87   main-block:
       88   do
       89   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       90   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       91   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       92   :
       93     if g#db-num <> 0 then do:
       94       message
       95       vss-workfile vss-revision vss-description skip
       96       "Данная процедуры не может вызываться в УБД"
       97       view-as alert-box error .
       98       undo main-block, return error .
       99     end.
      100     find first buf_ruleset exclusive-lock where
      101           recid(buf_ruleset) = p-rec .
      102     if buf_ruleset.ruleset_id = 0 then do:
      103       find first buf_rule no-lock where
      104                 buf_rule.codex_id = buf_ruleset.codex_id no-error .
      105       if available buf_rule then do:
      106         v-mess = substitute("К данному ruleset привязано правило &1&2Удаление невозможно"
      107                             , buf_rule.rule_id
      108                             , chr(10)
      109                             ).
      110         run err-mess in this-procedure ( input-output v-mess).
      111         return error (if p-silent = yes then v-mess else '':U).
      112       end.
      113     end.
      114     find first buf_rule-by-set no-lock where
      115             buf_rule-by-set.codex_id = buf_ruleset.codex_id
      116         and buf_rule-by-set.ruleset_id = buf_ruleset.ruleset_id
      117             no-error .
      118     if available buf_rule-by-set then do:
      119     v-mess = substitute("К данному ruleset привязано правило &1&2Удаление невозможно"
      120                         , buf_rule-by-set.rule_id
      121                         , chr(10)
      122                         ).
      123     run err-mess in this-procedure ( input-output v-mess).
      124     return error (if p-silent = yes then v-mess else '':U).
      125     end.
      126     find first buf_prop-ruleset no-lock where
      127             buf_prop-ruleset.codex_id = buf_ruleset.codex_id
      128         and buf_prop-ruleset.ruleset_id = buf_ruleset.ruleset_id no-error .
      129     if available buf_prop-ruleset then do:
      130       v-mess = substitute("К данному ruleset привязан объект &1&2Удаление невозможно"
      131                           , buf_prop-ruleset.dtm-code
      132                           , chr(10)
      133                           ).
      134       run err-mess in this-procedure ( input-output v-mess).
      135       return error (if p-silent = yes then v-mess else '':U).
      136     end.
      137    find first buf_pscript-ruleset no-lock where
      138             buf_pscript-ruleset.codex_id = buf_ruleset.codex_id
      139         and buf_pscript-ruleset.ruleset_id = buf_ruleset.ruleset_id no-error .
      140     if available buf_pscript-ruleset then do:
      141       v-mess = substitute("К данному ruleset привязан скрипт &1 для объекта &2&3Удаление невозможно"
      142                           , buf_pscript-ruleset.script-name
      143                           , buf_pscript-ruleset.dtm-code
      144                           , chr(10)
      145                           ).
      146       run err-mess in this-procedure ( input-output v-mess).
      147       return error (if p-silent = yes then v-mess else '':U).
      148     end.
      149     find first buf_rule-by-profile no-lock where
      150               buf_rule-by-profile.codex_id = buf_ruleset.codex_id
      151          and buf_rule-by-profile.ruleset_id = buf_ruleset.ruleset_id no-error .
      152     if available buf_rule-by-profile then do:
      153       v-mess = substitute("К данному ruleset привязано правило &1из профайла &2&3Удаление невозможно"
      154                           , buf_rule-by-profile.rule_id
      155                           , buf_rule-by-profile.profile_id
      156                           , chr(10)
      157                           ).
      158       run err-mess in this-procedure ( input-output v-mess).
      159       return error (if p-silent = yes then v-mess else '':U).
      160     end.
      161     find first buf_rule-call-param no-lock where
      162               buf_rule-call-param.codex_id = buf_ruleset.codex_id
      163          and buf_rule-call-param.ruleset_id = buf_ruleset.ruleset_id no-error .
      164     if available buf_rule-call-param then do:
      165       v-mess = substitute("К данному ruleset привязан параметр вызова из точки &1&4(порядок вызова &2 имя параметра &3)&4Удаление невозможно"
      166                           , buf_rule-call-param.call_id
      167                           , buf_rule-call-param.order_id
      168                           , buf_rule-call-param.param-name
      169                           , chr(10)
      170                           ).
      171       run err-mess in this-procedure ( input-output v-mess).
      172       return error (if p-silent = yes then v-mess else '':U).
      173     end.
      174     delete buf_ruleset.
      175   end.
      176   PROCEDURE err-mess:
      177     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      178     CASE p-silent:
      179       when yes then do:
      180         assign
      181         p-mess = substitute("Набор/кодекс правил: кодекс &1 набор &2: &3"
      182                            , buf_ruleset.codex_id
      183                            , buf_ruleset.ruleset_id
      184                            , p-mess)
      185         .
      186       end.
      187       when no then do:
      188         message
      189         p-mess
      190         view-as alert-box error .
      191       end.
      192     end.
      193   END PROCEDURE.
