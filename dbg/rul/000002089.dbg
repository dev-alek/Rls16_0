     1169   new shared
     1170   temp-table  obj-list no-undo
     1171     field obj-type like ub.clients.obj-type
     1172     field obj-code like ub.clients.obj-code
     1173     field obj-name like ub.clients.obj-name
     1174     field obj-id   as integer
