     1180   procedure create_obj-list :
     1181      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1182      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1183      do
     1184      on error undo, return error return-value
     1185      :
     1186         define buffer cli-obj for ub.clients .
     1187         define variable p-var as integer no-undo .
     1188         define buffer buf_obj-list for obj-list .
     1189         find last buf_obj-list  use-index pi no-error .
     1190         if available buf_obj-list
     1191         then
     1192            p-var = buf_obj-list.obj-id + 1.
     1193         else
     1194            p-var = 1.
     1195         find first cli-obj where
     1196                   cli-obj.obj-type = p-obj-type
     1197               and cli-obj.obj-code = p-obj-code
     1198         no-lock no-error.
     1199         if available cli-obj
     1200         then do:
     1201            create buf_obj-list.
     1202            assign
     1203               buf_obj-list.obj-id   = p-var
     1204               buf_obj-list.obj-code = cli-obj.obj-code
     1205               buf_obj-list.obj-type = cli-obj.obj-type
     1206               buf_obj-list.obj-name = cli-obj.obj-name
     1207               buf_obj-list.db-num   = cli-obj.db-num
     1208            .
     1209         end.
     1210      end.
     1211   end.
