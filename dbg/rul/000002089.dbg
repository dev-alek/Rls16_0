     1620   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1622   define new shared variable RepPathName        as character no-undo .
     1623   define new shared variable PrintRubl          as logical   no-undo .
     1624   define variable v-account as integer init 0 no-undo .
     1625   define variable v-account-lavel as character no-undo .
     1626   define variable v-button-stop as logical no-undo .
     1627   define variable v-kol-spice as integer no-undo .
     1628   define variable v-kol-spice2 as integer no-undo .
     1629   define variable v-kol-spice3 as integer no-undo .
     1630   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1631   DEFINE BUTTON StopBtn AUTO-END-KEY
     1632        LABEL "Стоп"
     1633        SIZE 10 BY 1.
     1634   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1635        LABEL "Обработано записей"
     1636         VIEW-AS TEXT
     1637        SIZE 14 BY .67 NO-UNDO.
     1638   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1639         VIEW-AS TEXT
     1640        SIZE 53.25 BY .67
     1641        FGCOLOR 1  NO-UNDO.
     1642   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1643         VIEW-AS TEXT
     1644        SIZE 53.25 BY .67
     1645        FGCOLOR 1  NO-UNDO.
     1646   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1647         VIEW-AS TEXT
     1648        SIZE 53.25 BY .67
     1649        FGCOLOR 1  NO-UNDO.
     1650   DEFINE RECTANGLE RECT-1
     1651        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1652        SIZE 55.13 BY 4.46.
     1653   DEFINE FRAME InfoFrame
     1654        StopBtn AT ROW 4.25 COL 21.75
     1655        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1656        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1657        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1658        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1659        RECT-1 AT ROW 1 COL 1
     1660       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1661            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1662            TITLE "Процесс"
     1663            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1664   define variable mFrameView      as logical   no-undo init yes.
     1665     define variable mFramHandle as handle no-undo.
     1666     mFramHandle = frame InfoFrame:handle.
     1667     if  log-manager:logfile-name ne ?
     1668     then DO:
     1669         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1670         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1671         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1672     end.
     1673     mFrameView = not session:batch-mode and mFramHandle:visible.
     1674     if mFrameView
     1675     then do:
     1676       ASSIGN
     1677          FRAME InfoFrame:HIDDEN                           = TRUE
     1678          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1679     end.
     1680   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1681   DO:
     1682     IF not StopProcessing THEN
     1683       Message "Вы действительно хотите прервать" SKIP
     1684               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1685                 UPDATE StopProcessing.
     1686     IF StopProcessing THEN do:
     1687        if mFrameView
     1688        then do:
     1689           HIDE FRAME InfoFrame.
     1690        end.
     1691     End.
     1692   END.
