     1749   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1750   define variable v-ii as integer no-undo .
     1751   define buffer buf_sysconf-attr for ub.sysconf-attr .
     1752   define temp-table tt-holyday no-undo
     1753   field holy-date as date
     1754   index pi
     1755   holy-date
     1756   .
     1757   find first buf_sysconf-attr no-lock
     1758        where buf_sysconf-attr.attr-code = "holyday"
     1759          and buf_sysconf-attr.host-code = 0
     1760          and buf_sysconf-attr.attr-value <> "" no-error.
     1761   if available buf_sysconf-attr then do :
     1762     do v-ii = 1 to num-entries(buf_sysconf-attr.attr-value,",") :
     1763       if not can-find(first tt-holyday where tt-holyday.holy-date = date(entry(v-ii, buf_sysconf-attr.attr-value, ",")) ) then do :
     1764         create tt-holyday .
     1765         assign
     1766           tt-holyday.holy-date = date(entry(v-ii, buf_sysconf-attr.attr-value, ","))
     1767         .
     1768       end.
     1769     end.
     1770   end.
     1771   function get-weeks-true returns logical ( input p-from   as date,
     1772                                             input p-repeat as integer,
     1773                                             input p-wday   as integer ):
     1774     define variable v-begin as date    no-undo .
     1775     define variable v-wcnt  as integer no-undo .
     1776     assign
     1777       v-begin = TODAY - p-wday + 1
     1778       v-wcnt = 1
     1779     .
     1780     do while not (TODAY >= v-begin and TODAY <= v-begin + 7) :
     1781         assign
     1782           v-begin = v-begin + 7
     1783           v-wcnt = v-wcnt + 1
     1784         .
     1785     end.
     1786     if not (v-wcnt - 1) / p-repeat = round((v-wcnt - 1) / p-repeat, 0) then return false .
     1787     return true .
     1788   end function.
     1789   function get-period-true returns logical (input p-dates  as character,
     1790                                             input p-wdays  as character,
     1791                                             input p-repeat as integer ):
     1792     define variable v-sdate-from as character no-undo .
     1793     define variable v-sdate-to   as character no-undo .
     1794     define variable v-wday       as integer   no-undo .
     1795     assign
     1796       v-sdate-from = substring(entry(1, p-dates, "-"), 1, 2) + "/" +
     1797                      substring(entry(1, p-dates, "-"), 3, 2) + "/" +
     1798                      substring(entry(1, p-dates, "-"), 5, 4)
     1799       v-sdate-to   = substring(entry(2, p-dates, "-"), 1, 2) + "/" +
     1800                      substring(entry(2, p-dates, "-"), 3, 2) + "/" +
     1801                      substring(entry(2, p-dates, "-"), 5, 4)
     1802       v-wday       = ( if weekday(TODAY) = 1 then 7 else weekday(TODAY) - 1 )
     1803     .
     1804     if TODAY < date(v-sdate-from) or TODAY > date(v-sdate-to) then return false .
     1805     if p-repeat > 1 and not get-weeks-true(date(v-sdate-from), p-repeat, v-wday) then return false .
     1806     if entry(v-wday, p-wdays) = "no" then return false .
     1807     return true .
     1808   end function.
     1809   function get-host-true returns logical (input p-host-code as integer, input p-client as character):
     1810     define variable v-obj-code  as integer   no-undo .
     1811     define variable v-obj-type  as character no-undo .
     1812     define variable v-host-code as integer   no-undo .
     1813     assign
     1814       v-obj-type = substring(p-client, 1, 3)
     1815       v-obj-code = int(substring(p-client, 4))
     1816     .
     1817   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1818   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1819     (input  v-obj-type
     1820     ,input  v-obj-code
     1821     ,output v-host-code
     1822     )  .
     1823     if p-host-code = v-host-code then return true .
     1824     return false .
     1825   end function.
     1826   procedure check-dates-method:
     1827     define input param p-days-do   as integer no-undo .
     1828     define input param p-days-sale as integer no-undo .
     1829     define input-output param p-method as character no-undo .
     1830     define variable v-dbegin as date      no-undo .
     1831     define variable v-from   as date      no-undo .
     1832     define variable v-to     as date      no-undo .
     1833     define variable v-i      as integer   no-undo .
     1834     define variable v-extw   as integer   no-undo .
     1835     define variable v-mth    as character no-undo init "" .
     1836     v-dbegin = TODAY + p-days-do .
     1837     assign v-extw = 0 .
     1838     _check_period:
     1839     repeat:
     1840        if p-days-sale / 7 > truncate(p-days-sale / 7, 0)
     1841        then v-from  = v-dbegin - ((truncate(p-days-sale / 7, 0) + 1 + v-extw) * 7) .
     1842        else v-from  = v-dbegin - ((truncate(p-days-sale / 7, 0) + v-extw) * 7) .
     1843        v-to = v-from + p-days-sale - 1 .
     1844        if TODAY > v-to and
     1845           not can-find (first tt-holyday
     1846               where not tt-holyday.holy-date < v-from
     1847                 and not tt-holyday.holy-date > v-to )
     1848        then leave _check_period .
     1849        else v-extw = v-extw + 1 .
     1850     end.
     1851     do v-i = 1 to num-entries(p-method) :
     1852         case substring(entry(v-i, p-method, ","), 1, 8):
     1853           when "date-p-1" then v-mth = v-mth + "date-p-1=" + string(v-from, "99/99/9999") + "," .
     1854           when "date-p-2" then v-mth = v-mth + "date-p-2=" + string(v-to, "99/99/9999") + "," .
     1855           otherwise do:
     1856               if not entry(v-i, p-method, ",") = "" then v-mth = v-mth + entry(v-i, p-method, ",") + "," .
     1857           end.
     1858         end.
     1859     end.
     1860     assign p-method = v-mth .
     1861   end procedure.
     1862   on delete of this-procedure do:
     1863     run garbcoll_clear in this-procedure .
     1864   end.
     1865   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1866   if error-status:error then do:
     1867     undo, return error return-value .
     1868   end.
     1869   if not this-procedure:persistent then do:
     1870     run proc-main in this-procedure no-error .
     1871     if error-status:error then do:
     1872       v-esm = error-status :get-message (1).
     1873       v-es = error-status:error .
     1874       v-rv = return-value .
     1875     end.
     1876     if p-ruleset-id = 1
     1877     then do:
     1878   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1879   if v-view-log
     1880   and not g#news
     1881   and not g#auto
     1882   then do:
     1883     message
     1884     '!!!При работе произошли ошибки!!!'  skip
     1885     "!!!Внимательно прочитайте Log-file!!"
     1886     view-as alert-box error .
     1887        define variable v-user-action18   as character no-undo .
     1888     define variable v-printed18       as logical   no-undo .
     1889     run gbl/prnfilen.w
     1890       (input  ('!!!При работе произошли ошибки!!!')
     1891       ,input  0
     1892       ,input  (string("./":U) + log-file-name)
     1893       ,input  7
     1894       ,output v-user-action18
     1895       ,output v-printed18
     1896       ) .
     1897   end.
     1898   if v-view-log = true
     1899   and (g#news
     1900   or g#auto)
     1901   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1902   then do:
     1903      run cb_set-view-log in p-parent-handle ( input yes).
     1904   end.
     1905     end.
     1906     if v-es then do:
     1907         run garbcoll_clear in this-procedure .
     1908         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1909     end.
     1910     run garbcoll_clear in this-procedure .
     1911   end.
     1912   procedure proc-main :
     1913   define variable v-i      as integer   no-undo .
     1914   define variable v-method as character no-undo .
     1915   define buffer buf_dis-some-rule for ub.dis-some-rule .
     1916   _main:
     1917   do
     1918   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1919   :
     1920       do v-i = 1 to num-entries(v-clients, chr(4)) :
     1921   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   _buf_dis-some-rule:
     1923   for each buf_dis-some-rule no-lock
     1924   where buf_dis-some-rule.classif-type = "auto-ord-2"
     1925   :
     1926       if buf_dis-some-rule.host-code > 0 and not get-host-true( buf_dis-some-rule.host-code, entry(v-i, v-clients, chr(4)) ) then next _buf_dis-some-rule .
     1927       if buf_dis-some-rule.obj-code > 0 and
     1928       not buf_dis-some-rule.obj-type + string(buf_dis-some-rule.obj-code) = entry(v-i, v-clients, chr(4)) then next _buf_dis-some-rule .
     1929       if not get-period-true( buf_dis-some-rule.charkey_three, entry(4, buf_dis-some-rule.charkey_two, chr(3) ), buf_dis-some-rule.rl-root ) then next _buf_dis-some-rule .
     1930       for each obj-list exclusive-lock:
     1931          delete obj-list .
     1932       end.
     1933       create obj-list .
     1934       assign
     1935         obj-list.obj-code = int(substring( entry(v-i, v-clients, chr(4)), 4 ))
     1936         obj-list.obj-type = substring( entry(v-i, v-clients, chr(4)), 1, 3 )
     1937       .
     1938       assign v-method = buf_dis-some-rule.charkey_one .
     1939       run check-dates-method in this-procedure ( buf_dis-some-rule.key#_one,
     1940                                                  buf_dis-some-rule.key#_two,
     1941                                                  input-output v-method ) .
     1942       run cus/cr-zakaz.p (
     1943         input parparentproc
     1944       , input p-log-handle
     1945       , input buf_dis-some-rule.key#_one
     1946       , input buf_dis-some-rule.key#_two
     1947       , input entry(2, buf_dis-some-rule.charkey_two, chr(3) )
     1948       , input v-method
     1949       , input entry(1, buf_dis-some-rule.charkey_two, chr(3) )
     1950       , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then "no" else entry(7, buf_dis-some-rule.charkey_two, chr(3) )
     1951       , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then "no" else entry(6, buf_dis-some-rule.charkey_two, chr(3) )
     1952       , input int(substring( entry(3, buf_dis-some-rule.charkey_two, chr(3) ), 4 ))
     1953       , input substring( entry(3, buf_dis-some-rule.charkey_two, chr(3) ), 1, 3 )
     1954       , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then 0 else integer(entry(5, buf_dis-some-rule.charkey_two, chr(3) ))
     1955       , input int(substring( entry(v-i, v-clients, chr(4)), 4 ))
     1956       , input substring( entry(v-i, v-clients, chr(4)), 1, 3 )
     1957       , 'ОФ':U
     1958       ) no-error .
     1959   end.
     1960       end.
     1961   end.
     1962   end procedure.
     1963   procedure load-ruleset-context :
     1964   define input parameter p-ruleset-id as integer no-undo .
     1965   define buffer buf_rule-call-param for ub.rule-call-param .
     1966   do
     1967   on error undo, return error
     1968   :
     1969    for each buf_rule-call-param no-lock
     1970     where buf_rule-call-param.codex_id = p-codex-id
     1971       and buf_rule-call-param.ruleset_id = p-ruleset-id
     1972       and buf_rule-call-param.call_id = p-call-id
     1973       and buf_rule-call-param.order_id = p-order-id
     1974       and buf_rule-call-param.rule_id = p-rule-id
     1975       and buf_rule-call-param.param-name = "p-client"
     1976       and buf_rule-call-param.p-index > 0
     1977    :
     1978       if v-clients = '' then v-clients = v-clients + buf_rule-call-param.param-value-character .
     1979       else v-clients = v-clients + chr(4) + buf_rule-call-param.param-value-character .
     1980    end.
     1981       case p-ruleset-id:
     1982         when 1
     1983         then do:
     1984           assign
     1985           v-sign = 2
     1986           v-current-host-code = p-host-code
     1987           v-current-obj-type = p-obj-type
     1988           v-current-obj-code = p-obj-code
     1989           v-current-db-num = g#db-num
     1990           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1991           .
     1992         end.
     1993      end case.
     1994   end.
     1995   end procedure.
