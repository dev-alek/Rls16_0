        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-save       as integer no-undo .
       19   define input parameter v-curr-r-b   as character no-undo .
       20   define input parameter p-cmd-proc-handle as handle no-undo .
       21   define input parameter p-cmd-code  as integer no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision$":U .
       23   define variable vss-author      as character no-undo init "$Author$":U .
       24   define variable vss-date        as character no-undo init "$Date$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       26   define variable vss-archive     as character no-undo init "$Archive$":U .
       27   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 23, набор 1".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define   shared variable g#auto as logical no-undo.
       89   define   shared variable g#news as logical no-undo.
       90   define   shared variable g#oxml as logical no-undo.
       91   define   shared variable g#esys as logical no-undo.
       92   define   shared variable g#news-source-db as integer no-undo.
       93   define   shared variable g#esys-source-esys as integer no-undo.
       94   define   shared variable g#db-num as integer   no-undo .
       95   define   shared variable g#userid as character no-undo .
       96   define   shared variable g#passwd as character no-undo .
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  variable garbcoll_ii as integer no-undo .
       99   define  temp-table temp-gc no-undo
      100   field ii as integer
      101   field obj-r as handle
      102   field cn as character
      103   index pi is unique primary
      104   ii
      105   index icn
      106   cn.
      107   procedure garbcoll_create-gc-entry :
      108   define input parameter p-cn as character no-undo .
      109   define input parameter p-obj-r as handle no-undo .
      110     do
      111     on error undo, return error
      112     :
      113       create temp-gc.
      114       assign
      115       temp-gc.ii = garbcoll_ii
      116       garbcoll_ii = garbcoll_ii + 1
      117       temp-gc.cn = p-cn
      118       temp-gc.obj-r = p-obj-r
      119       .
      120     end.
      121   end procedure.
      122   procedure garbcoll_clear :
      123     do
      124     on error undo, return error
      125     :
      126       for each temp-gc:
      127         delete object temp-gc.obj-r.
      128         delete temp-gc.
      129       end.
      130     end.
      131   end procedure.
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define shared temp-table temp-hist-nws-option no-undo
      359   like ub.hist-nws-option
      360   .
      361   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure gen-key-rec :
      363     define input  parameter p-tbl-name    as character no-undo.
      364     define input  parameter p-bh_tbl-name as handle    no-undo.
      365     define output parameter p-key-rec     as character no-undo.
      366     do
      367     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      368     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      369     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      370     :
      371       define variable fh               as handle    no-undo .
      372       define variable v-ok             as logical   no-undo .
      373       define variable v-inform         as character no-undo .
      374       define variable v-ind            as integer   no-undo .
      375       define variable v-idx-field-qnty as integer   no-undo .
      376       if p-tbl-name = ?
      377         or p-tbl-name = "":U
      378       then do:
      379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      380       end.
      381       if not p-bh_tbl-name:available then do:
      382         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      383       end.
      384       assign
      385         p-key-rec = p-tbl-name
      386         v-inform  = p-bh_tbl-name:index-information(1)
      387         v-ind     = 2
      388       .
      389       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      390       on error undo, return error
      391       :
      392         assign
      393           v-inform = p-bh_tbl-name:index-information( v-ind )
      394           v-ind    = v-ind + 1
      395         .
      396       end.
      397       if v-inform = ?
      398         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      399         or entry( 3, v-inform, ",":U ) <> "1":U
      400       then do:
      401         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      402       end.
      403       else do:
      404         assign
      405           v-idx-field-qnty = num-entries( v-inform ) - 4
      406         .
      407         if v-idx-field-qnty < 2 then do:
      408           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      409         end.
      410         do v-ind = 1 to v-idx-field-qnty by 2
      411         on error undo, return error
      412         :
      413           assign
      414             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      415             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      416           .
      417         end.
      418       end.
      419       if p-key-rec = ? then do:
      420         assign
      421           p-key-rec = "":U
      422         .
      423         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      424       end.
      425     end.
      426     return.
      427   end procedure.
      428   procedure gen-where-keyr-tab :
      429     define input  parameter i-tableSerach as character no-undo.
      430     define input  parameter i-tablekey   as character  no-undo.
      431     define input  parameter p-key-rec    as character  no-undo.
      432     define input  parameter p-key-handle as handle     no-undo .
      433     define input  parameter p-db-name    as character  no-undo .
      434     define input  parameter p-tt-handle  as handle     no-undo .
      435     define output parameter o-Where      as character  no-undo.
      436     do
      437     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      438     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      439     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      440     :
      441       define variable v-full-tbl-name  as character no-undo .
      442       define variable bh_tbl-name      as handle    no-undo .
      443       define variable fh_key           as handle    no-undo .
      444       define variable fh_search        as handle    no-undo .
      445       define variable v-field-num      as integer   no-undo .
      446       define variable v-count-fld      as integer   no-undo .
      447       define variable v-inform         as character no-undo .
      448       define variable v-ind            as integer   no-undo .
      449       define variable v-idx-field-qnty as integer   no-undo .
      450       define variable v-field-name     as character no-undo .
      451       define variable v-field-val      as character no-undo .
      452       define variable v-word-link      as character no-undo .
      453       define variable vTable           as character no-undo.
      454       define variable bh_tbl-key       as handle    no-undo .
      455       assign
      456         p-key-rec = trim( p-key-rec )
      457       .
      458       if p-key-handle <> ? then do:
      459         if not valid-handle(p-key-handle)
      460            or p-key-handle:type <> "buffer"
      461         then do:
      462           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      463         end.
      464         if num-entries( p-key-rec, chr(3) ) > 1
      465           or p-key-rec = ?
      466           or p-key-rec = "":U
      467         then do:
      468           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      469         end.
      470       end.
      471       else do:
      472         if p-key-rec = ?
      473           or p-key-rec = "":U
      474         then do:
      475           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      476         end.
      477       end.
      478       assign
      479         vTable = entry( 1 , p-key-rec, chr(3) )
      480       .
      481       if p-tt-handle <> ?
      482         and ( not valid-handle(p-tt-handle)
      483               or p-tt-handle:type <> "buffer"
      484             )
      485       then do:
      486         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      487       end.
      488       if p-tt-handle = ? then do:
      489         assign
      490           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      491         .
      492         create buffer bh_tbl-name for table v-full-tbl-name .
      493       end.
      494       else do:
      495         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      496       end.
      497       assign
      498         v-inform = bh_tbl-name:index-information(1)
      499         v-ind    = 2
      500       .
      501       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      502       on error undo, return error
      503       :
      504         assign
      505           v-inform = bh_tbl-name:index-information( v-ind )
      506           v-ind    = v-ind + 1
      507         .
      508       end.
      509       if v-inform = ?
      510         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      511         or entry( 3, v-inform, ",":U ) <> "1":U
      512       then do:
      513         delete object bh_tbl-name no-error.
      514         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      515       end.
      516       assign
      517         v-idx-field-qnty = num-entries( v-inform ) - 4
      518       .
      519       if v-idx-field-qnty < 2 then do:
      520         delete object bh_tbl-name no-error.
      521         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      522       end.
      523       assign
      524         o-where     = "where":U
      525         v-word-link = "":U
      526         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      527         v-count-fld = 0
      528       .
      529       if i-tablekey ne "" and i-tablekey ne ?
      530       then do:
      531         assign
      532           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      533         .
      534         create buffer bh_tbl-key for table v-full-tbl-name .
      535       end.
      536       if i-tableSerach ne "" and i-tableSerach ne ?
      537       then do:
      538         delete object bh_tbl-name no-error.
      539         assign
      540           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      541         .
      542         create buffer bh_tbl-name for table v-full-tbl-name .
      543       end.
      544       block_where:
      545       do v-ind = 1 to v-idx-field-qnty by 2
      546       on error undo, return error
      547       :
      548         assign
      549           v-count-fld = v-count-fld + 1
      550         .
      551         if p-key-handle = ?
      552           and v-count-fld > v-field-num
      553         then do:
      554           leave block_where.
      555         end.
      556         define variable VfieldKeyTable as handle no-undo.
      557         assign
      558           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      559           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      560         .
      561         if     bh_tbl-key ne ?
      562         then do:
      563            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      564            if VfieldKeyTable eq ?
      565            then next block_where.
      566         end.
      567         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      568         then
      569            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      570         else
      571            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      572         if p-key-handle = ? then do:
      573           assign
      574             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      575           .
      576         end.
      577         else do:
      578           assign
      579             fh_key = p-key-handle:buffer-field( v-field-name )
      580           .
      581           if fh_key = ?
      582             or not valid-handle( fh_key )
      583           then do:
      584             delete object bh_tbl-name.
      585             if     bh_tbl-key ne ?
      586             then
      587                delete object bh_tbl-key.
      588             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      589           end.
      590           assign
      591             v-field-val = fh_key:buffer-value
      592           .
      593         end.
      594         if fh_search:data-type ="character":U then do:
      595           assign
      596             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      597             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      598             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      599             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      600             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      601             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      602             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      603             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      604             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      605             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      606             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      607             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      608             v-field-val = substitute( '"&1"', v-field-val )
      609           .
      610         end.
      611         assign
      612           o-where = substitute( "&1 &2", o-where, v-field-val )
      613         .
      614         if v-word-link = "":U then do:
      615           assign
      616             v-word-link = "and":U
      617           .
      618         end.
      619       end.
      620       delete object bh_tbl-name.
      621       if     bh_tbl-key ne ?
      622       then
      623          delete object bh_tbl-key.
      624       if p-key-handle = ?
      625         and v-count-fld <> v-field-num
      626       then do:
      627         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      628       end.
      629     end.
      630   end procedure.
      631   procedure gen-hn-keyr-tab :
      632     define input  parameter i-tableSerach as character no-undo.
      633     define input  parameter i-tablekey   as character no-undo.
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter o-hn         as handle    no-undo.
      640     define variable v-full-tbl-name as character no-undo.
      641     define variable v-where         as character no-undo.
      642     define variable bh_tbl-name     as handle    no-undo.
      643     define variable vTable          as character no-undo.
      644     do
      645     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      646     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      647     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      648         run gen-where-keyr-tab(i-tableSerach,
      649                                i-tablekey,
      650                                p-key-rec,
      651                                p-key-handle,
      652                                p-db-name,
      653                                p-tt-handle,
      654                                output v-where).
      655         if i-tableSerach ne "" and i-tableSerach ne ?
      656         then do:
      657            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      658            create buffer bh_tbl-name for table v-full-tbl-name .
      659         end.
      660         else do:
      661            if p-tt-handle = ? then do:
      662               assign
      663                  vTable = entry( 1 , p-key-rec, chr(3) )
      664               .
      665               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      666               create buffer bh_tbl-name for table v-full-tbl-name .
      667            end.
      668            else do:
      669               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      670            end.
      671         end.
      672         if p-tt-handle = ? then do:
      673            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      674         end.
      675         else do:
      676            bh_tbl-name:find-first( v-where ) no-error .
      677         end.
      678         o-hn = bh_tbl-name.
      679      end.
      680   end procedure.
      681   procedure gen-hn-keyr :
      682     define input  parameter p-key-rec    as character no-undo.
      683     define input  parameter p-key-handle as handle    no-undo .
      684     define input  parameter p-db-name    as character no-undo .
      685     define input  parameter p-tt-handle  as handle    no-undo .
      686     define input  parameter p-stts-lock  as integer   no-undo .
      687     define output parameter o-hn         as handle    no-undo.
      688     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      689   end.
      690   procedure gen-row-keyr :
      691     define input  parameter p-key-rec    as character no-undo.
      692     define input  parameter p-key-handle as handle    no-undo .
      693     define input  parameter p-db-name    as character no-undo .
      694     define input  parameter p-tt-handle  as handle    no-undo .
      695     define input  parameter p-stts-lock  as integer   no-undo .
      696     define output parameter p-tbl-row    as rowid     no-undo.
      697     define output parameter p-tbl-name   as character no-undo.
      698     define variable vHn as handle no-undo.
      699       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      700       p-tbl-row = if vHn:available then vHn:rowid else ?.
      701       p-tbl-name =  vHn:table.
      702       delete object vHn no-error.
      703     if p-tbl-row = ? then do:
      704       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      705     end.
      706     else do:
      707       return.
      708     end.
      709   end procedure.
      710   procedure gen-key-fv :
      711     define input  parameter p-key-rec    as character no-undo .
      712     define output parameter p-field-list as character no-undo .
      713     define output parameter p-value-list as character no-undo.
      714     do
      715     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      716     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      717     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      718     :
      719       define variable v-full-tbl-name  as character no-undo .
      720       define variable bh_tbl-name      as handle    no-undo .
      721       define variable v-tbl-name       as character no-undo .
      722       define variable v-field-num      as integer   no-undo .
      723       define variable v-count-fld      as integer   no-undo .
      724       define variable v-inform         as character no-undo .
      725       define variable v-ind            as integer   no-undo .
      726       define variable v-idx-field-qnty as integer   no-undo .
      727       define variable v-delim-key      as character no-undo .
      728       if p-key-rec = ?
      729         or p-key-rec = "":U
      730       then do:
      731         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      732       end.
      733       assign
      734         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      735         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      736       .
      737       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      738       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      739       assign
      740         v-inform = bh_tbl-name:index-information(1)
      741         v-ind    = 2
      742       .
      743       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      744       on error undo, return error
      745       :
      746         assign
      747           v-inform = bh_tbl-name:index-information( v-ind )
      748           v-ind    = v-ind + 1
      749         .
      750       end.
      751       if v-inform = ?
      752         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      753         or entry( 3, v-inform, ",":U ) <> "1":U
      754       then do:
      755         delete object bh_tbl-name no-error.
      756         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      757       end.
      758       assign
      759         v-idx-field-qnty = num-entries( v-inform ) - 4
      760       .
      761       if v-idx-field-qnty < 2 then do:
      762         delete object bh_tbl-name no-error.
      763         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      764       end.
      765       assign
      766         p-field-list = "":U
      767         p-value-list = "":U
      768         v-delim-key  = "":U
      769         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      770         v-count-fld  = 0
      771       .
      772       block_where:
      773       do v-ind = 1 to v-idx-field-qnty by 2
      774       on error undo, return error
      775       :
      776         assign
      777           v-count-fld = v-count-fld + 1
      778         .
      779         if v-count-fld > v-field-num then do:
      780           leave block_where.
      781         end.
      782         assign
      783           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      784           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      785         .
      786         if v-ind = 1 then do:
      787           assign
      788             v-delim-key = chr(3)
      789           .
      790         end.
      791       end.
      792       delete object bh_tbl-name.
      793       if v-count-fld <> v-field-num then do:
      794         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      795       end.
      796     end.
      797   end procedure.
      798   procedure gen-key-field :
      799     define input  parameter p-table      as character no-undo .
      800     define output parameter p-field-list as character no-undo .
      801     do
      802     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      803     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      804     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      805     :
      806       define variable v-full-tbl-name  as character no-undo .
      807       define variable bh_tbl-name      as handle    no-undo .
      808       define variable v-tbl-name       as character no-undo .
      809       define variable v-field-num      as integer   no-undo .
      810       define variable v-count-fld      as integer   no-undo .
      811       define variable v-inform         as character no-undo .
      812       define variable v-ind            as integer   no-undo .
      813       define variable v-idx-field-qnty as integer   no-undo .
      814       define variable v-delim-key      as character no-undo .
      815       if p-table = ?
      816         or p-table = "":U
      817       then do:
      818         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      819       end.
      820       assign
      821         v-tbl-name      = p-table
      822         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      823       .
      824       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      825       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      826       assign
      827         v-inform = bh_tbl-name:index-information(1)
      828         v-ind    = 2
      829       .
      830       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      831       on error undo, return error
      832       :
      833         assign
      834           v-inform = bh_tbl-name:index-information( v-ind )
      835           v-ind    = v-ind + 1
      836         .
      837       end.
      838       if v-inform = ?
      839         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      840         or entry( 3, v-inform, ",":U ) <> "1":U
      841       then do:
      842         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      843       end.
      844       assign
      845         v-idx-field-qnty = num-entries( v-inform ) - 4
      846       .
      847       if v-idx-field-qnty < 2 then do:
      848         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      849       end.
      850       assign
      851         p-field-list = "":U
      852         v-delim-key  = "":U
      853         v-count-fld  = 0
      854       .
      855       block_where:
      856       do v-ind = 1 to v-idx-field-qnty by 2
      857       on error undo, return error
      858       :
      859         assign
      860           v-count-fld = v-count-fld + 1
      861         .
      862         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      863         if v-ind = 1 then do:
      864           assign
      865             v-delim-key = chr(3)
      866           .
      867         end.
      868       end.
      869       delete object bh_tbl-name.
      870     end.
      871   end procedure.
