     2344   procedure get-db-list-for-d-card3 :
     2345   define input parameter p-d-card as character no-undo .
     2346   define variable v-current-db-processed as logical no-undo .
     2347   define buffer buf_clients  for ub.clients.
     2348   define buffer buf_dis-obj for ub.dis-obj.
     2349   define buffer buf_temp-smart-route for temp-smart-route.
     2350     do
     2351     on error undo, return error return-value
     2352     :
     2353       for each buf_dis-obj no-lock where
     2354               buf_dis-obj.d-card = p-d-card,
     2355          first buf_clients no-lock where
     2356               buf_clients.obj-type = buf_dis-obj.obj-type
     2357           and buf_clients.obj-code = buf_dis-obj.obj-code
     2358       break by
     2359       buf_clients.db-num:
     2360         if first-of(buf_Clients.db-num) then do:
     2361           find first buf_temp-smart-route no-lock where
     2362                 buf_temp-smart-route.key-field = p-d-card
     2363             and buf_temp-smart-route.db-num = buf_clients.db-num
     2364                 no-error.
     2365           if available buf_temp-smart-route then return.
     2366           create buf_temp-smart-route.
     2367           assign
     2368           buf_temp-smart-route.key-field = p-d-card
     2369           buf_temp-smart-route.db-num = buf_clients.db-num
     2370           .
     2371           if buf_clients.db-num = g#db-num then do:
     2372             v-current-db-processed = yes.
     2373           end.
     2374         end.
     2375       end.
     2376       if not v-current-db-processed then do:
     2377         find first buf_temp-smart-route no-lock where
     2378               buf_temp-smart-route.key-field = p-d-card
     2379           and buf_temp-smart-route.db-num = g#db-num
     2380               no-error.
     2381         if not available buf_temp-smart-route then do:
     2382           create buf_temp-smart-route.
     2383           assign
     2384           buf_temp-smart-route.key-field = p-d-card
     2385           buf_temp-smart-route.db-num = g#db-num
     2386           .
     2387         end.
     2388       end.
     2389     end.
     2390   end procedure.
