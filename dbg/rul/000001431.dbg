     3046           v-current-obj-type = p-obj-type
     3047           v-current-obj-code = p-obj-code
     3048           v-current-db-num = g#db-num
     3049           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3050           v-current-doc-code = p-doc-code
     3051           v-current-doc-date = p-doc-date
     3052           v-current-doc-time = 0
     3053           v-current-doc-fact-date = p-fact-date
     3054           v-current-date = p-doc-date
     3055           v-current-fact-date = p-fact-date
     3056           .
     3057         end.
     3058         when 7
     3059         or when 9
     3060         then do:
     3061           assign
     3062           v-sign = 1
     3063           v-current-host-code = p-host-code
     3064           v-current-obj-type = p-obj-type
     3065           v-current-obj-code = p-obj-code
     3066           v-current-db-num = g#db-num
     3067           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3068           v-current-doc-code = p-doc-code
     3069           v-current-doc-date = p-doc-date
     3070           v-current-doc-time = 0
     3071           v-current-doc-fact-date = p-fact-date
     3072           v-current-date = p-doc-date
     3073           v-current-fact-date = p-fact-date
     3074           .
     3075         end.
     3076       end case.
     3077     end.
     3078   end procedure.
     3079   procedure delete-procedure :
     3080     do
