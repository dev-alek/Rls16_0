     2911   end procedure.
     2912   procedure load-ruleset-context :
     2913   define input parameter p-ruleset-id as integer no-undo .
     2914   define buffer buf_rule-call-param for ub.rule-call-param.
     2915     do
     2916     on error undo, return error
     2917     :
     2918    find first buf_rule-call-param no-lock where
     2919   buf_rule-call-param.codex_id = p-codex-id
     2920   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2921   and buf_rule-call-param.call_id = p-call-id
     2922   and buf_rule-call-param.order_id = p-order-id
     2923   and buf_rule-call-param.rule_id = p-rule-id
     2924   and buf_rule-call-param.param-name = "p-r-b"
     2925    no-error.
     2926   if available buf_rule-call-param then do:
     2927   assign p-r-b = buf_rule-call-param.param-value-character.
     2928   end.
     2929    find first buf_rule-call-param no-lock where
     2930   buf_rule-call-param.codex_id = p-codex-id
     2931   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2932   and buf_rule-call-param.call_id = p-call-id
     2933   and buf_rule-call-param.order_id = p-order-id
     2934   and buf_rule-call-param.rule_id = p-rule-id
     2935   and buf_rule-call-param.param-name = "p-is-over"
     2936    no-error.
     2937   if available buf_rule-call-param then do:
     2938   assign p-is-over = buf_rule-call-param.param-value-logical.
     2939   end.
     2940    find first buf_rule-call-param no-lock where
     2941   buf_rule-call-param.codex_id = p-codex-id
     2942   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2943   and buf_rule-call-param.call_id = p-call-id
     2944   and buf_rule-call-param.order_id = p-order-id
     2945   and buf_rule-call-param.rule_id = p-rule-id
     2946   and buf_rule-call-param.param-name = "p-rule-num"
     2947    no-error.
     2948   if available buf_rule-call-param then do:
     2949   assign p-rule-num = buf_rule-call-param.param-value-integer.
