      477   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   define new global shared variable g#lib-nws as handle no-undo .
      479   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   procedure gen-key-rec :
      482     define input  parameter p-tbl-name    as character no-undo.
      483     define input  parameter p-bh_tbl-name as handle    no-undo.
      484     define output parameter p-key-rec     as character no-undo.
      485     do
      486     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      487     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      488     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      489     :
      490       define variable fh               as handle    no-undo .
      491       define variable v-ok             as logical   no-undo .
      492       define variable v-inform         as character no-undo .
      493       define variable v-ind            as integer   no-undo .
      494       define variable v-idx-field-qnty as integer   no-undo .
      495       if p-tbl-name = ?
      496         or p-tbl-name = "":U
      497       then do:
      498         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
      499       end.
      500       if not p-bh_tbl-name:available then do:
      501         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
      502       end.
      503       assign
      504         p-key-rec = p-tbl-name
      505         v-inform  = p-bh_tbl-name:index-information(1)
      506         v-ind     = 2
      507       .
      508       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      509       on error undo, return error
      510       :
      511         assign
      512           v-inform = p-bh_tbl-name:index-information( v-ind )
      513           v-ind    = v-ind + 1
      514         .
      515       end.
      516       if v-inform = ?
      517         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      518         or entry( 3, v-inform, ",":U ) <> "1":U
      519       then do:
      520         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
      521       end.
      522       else do:
      523         assign
      524           v-idx-field-qnty = num-entries( v-inform ) - 4
      525         .
      526         if v-idx-field-qnty < 2 then do:
      527           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
      528         end.
      529         do v-ind = 1 to v-idx-field-qnty by 2
      530         on error undo, return error
      531         :
      532           assign
      533             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      534             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      535           .
      536         end.
      537       end.
      538       if p-key-rec = ? then do:
      539         assign
      540           p-key-rec = "":U
      541         .
      542         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
      543       end.
      544     end.
      545     return.
      546   end procedure.
      547   procedure gen-where-keyr-tab :
      548     define input  parameter i-tableSerach as character no-undo.
      549     define input  parameter i-tablekey   as character  no-undo.
      550     define input  parameter p-key-rec    as character  no-undo.
      551     define input  parameter p-key-handle as handle     no-undo .
      552     define input  parameter p-db-name    as character  no-undo .
      553     define input  parameter p-tt-handle  as handle     no-undo .
      554     define output parameter o-Where      as character  no-undo.
      555     do
      556     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      557     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      558     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      559     :
      560       define variable v-full-tbl-name  as character no-undo .
      561       define variable bh_tbl-name      as handle    no-undo .
      562       define variable fh_key           as handle    no-undo .
      563       define variable fh_search        as handle    no-undo .
      564       define variable v-field-num      as integer   no-undo .
      565       define variable v-count-fld      as integer   no-undo .
      566       define variable v-inform         as character no-undo .
      567       define variable v-ind            as integer   no-undo .
      568       define variable v-idx-field-qnty as integer   no-undo .
      569       define variable v-field-name     as character no-undo .
      570       define variable v-field-val      as character no-undo .
      571       define variable v-word-link      as character no-undo .
      572       define variable vTable           as character no-undo.
      573       define variable bh_tbl-key       as handle    no-undo .
      574       assign
      575         p-key-rec = trim( p-key-rec )
      576       .
      577       if p-key-handle <> ? then do:
      578         if not valid-handle(p-key-handle)
      579            or p-key-handle:type <> "buffer"
      580         then do:
      581           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
      582         end.
      583         if num-entries( p-key-rec, chr(3) ) > 1
      584           or p-key-rec = ?
      585           or p-key-rec = "":U
      586         then do:
      587           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
      588         end.
      589       end.
      590       else do:
      591         if p-key-rec = ?
      592           or p-key-rec = "":U
      593         then do:
      594           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      595         end.
      596       end.
      597       assign
      598         vTable = entry( 1 , p-key-rec, chr(3) )
      599       .
      600       if p-tt-handle <> ?
      601         and ( not valid-handle(p-tt-handle)
      602               or p-tt-handle:type <> "buffer"
      603             )
      604       then do:
      605         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
      606       end.
      607       if p-tt-handle = ? then do:
      608         assign
      609           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      610         .
      611         create buffer bh_tbl-name for table v-full-tbl-name .
      612       end.
      613       else do:
      614         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      615       end.
      616       assign
      617         v-inform = bh_tbl-name:index-information(1)
      618         v-ind    = 2
      619       .
      620       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      621       on error undo, return error
      622       :
      623         assign
      624           v-inform = bh_tbl-name:index-information( v-ind )
      625           v-ind    = v-ind + 1
      626         .
      627       end.
      628       if v-inform = ?
      629         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      630         or entry( 3, v-inform, ",":U ) <> "1":U
      631       then do:
      632         delete object bh_tbl-name no-error.
      633         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
      634       end.
      635       assign
      636         v-idx-field-qnty = num-entries( v-inform ) - 4
      637       .
      638       if v-idx-field-qnty < 2 then do:
      639         delete object bh_tbl-name no-error.
      640         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
      641       end.
      642       assign
      643         o-where     = "where":U
      644         v-word-link = "":U
      645         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      646         v-count-fld = 0
      647       .
      648       if i-tablekey ne "" and i-tablekey ne ?
      649       then do:
      650         assign
      651           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      652         .
      653         create buffer bh_tbl-key for table v-full-tbl-name .
      654       end.
      655       if i-tableSerach ne "" and i-tableSerach ne ?
      656       then do:
      657         delete object bh_tbl-name no-error.
      658         assign
      659           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      660         .
      661         create buffer bh_tbl-name for table v-full-tbl-name .
      662       end.
      663       block_where:
      664       do v-ind = 1 to v-idx-field-qnty by 2
      665       on error undo, return error
      666       :
      667         assign
      668           v-count-fld = v-count-fld + 1
      669         .
      670         if p-key-handle = ?
      671           and v-count-fld > v-field-num
      672         then do:
      673           leave block_where.
      674         end.
      675         define variable VfieldKeyTable as handle no-undo.
      676         assign
      677           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      678           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      679         .
      680         if     bh_tbl-key ne ?
      681         then do:
      682            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      683            if VfieldKeyTable eq ?
      684            then next block_where.
      685         end.
      686         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      687         then
      688            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      689         else
      690            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      691         if p-key-handle = ? then do:
      692           assign
      693             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      694           .
      695         end.
      696         else do:
      697           assign
      698             fh_key = p-key-handle:buffer-field( v-field-name )
      699           .
      700           if fh_key = ?
      701             or not valid-handle( fh_key )
      702           then do:
      703             delete object bh_tbl-name.
      704             if     bh_tbl-key ne ?
      705             then
      706                delete object bh_tbl-key.
      707             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
      708           end.
      709           assign
      710             v-field-val = fh_key:buffer-value
      711           .
      712         end.
      713         if fh_search:data-type ="character":U then do:
      714           assign
      715             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      716             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      717             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      718             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      719             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      720             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      721             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      722             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      723             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      724             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      725             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      726             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      727             v-field-val = substitute( '"&1"', v-field-val )
      728           .
      729         end.
      730         assign
      731           o-where = substitute( "&1 &2", o-where, v-field-val )
      732         .
      733         if v-word-link = "":U then do:
      734           assign
      735             v-word-link = "and":U
      736           .
      737         end.
      738       end.
      739       delete object bh_tbl-name.
      740       if     bh_tbl-key ne ?
      741       then
      742          delete object bh_tbl-key.
      743       if p-key-handle = ?
      744         and v-count-fld <> v-field-num
      745       then do:
      746         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
      747       end.
      748     end.
      749   end procedure.
      750   procedure gen-hn-keyr-tab :
      751     define input  parameter i-tableSerach as character no-undo.
      752     define input  parameter i-tablekey   as character no-undo.
      753     define input  parameter p-key-rec    as character no-undo.
      754     define input  parameter p-key-handle as handle    no-undo .
      755     define input  parameter p-db-name    as character no-undo .
      756     define input  parameter p-tt-handle  as handle    no-undo .
      757     define input  parameter p-stts-lock  as integer   no-undo .
      758     define output parameter o-hn         as handle    no-undo.
      759     define variable v-full-tbl-name as character no-undo.
      760     define variable v-where         as character no-undo.
      761     define variable bh_tbl-name     as handle    no-undo.
      762     define variable vTable          as character no-undo.
      763     do
      764     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      765     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      766     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      767         run gen-where-keyr-tab(i-tableSerach,
      768                                i-tablekey,
      769                                p-key-rec,
      770                                p-key-handle,
      771                                p-db-name,
      772                                p-tt-handle,
      773                                output v-where).
      774         if i-tableSerach ne "" and i-tableSerach ne ?
      775         then do:
      776            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      777            create buffer bh_tbl-name for table v-full-tbl-name .
      778         end.
      779         else do:
      780            if p-tt-handle = ? then do:
      781               assign
      782                  vTable = entry( 1 , p-key-rec, chr(3) )
      783               .
      784               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      785               create buffer bh_tbl-name for table v-full-tbl-name .
      786            end.
      787            else do:
      788               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      789            end.
      790         end.
      791         if p-tt-handle = ? then do:
      792            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      793         end.
      794         else do:
      795            bh_tbl-name:find-first( v-where ) no-error .
      796         end.
      797         o-hn = bh_tbl-name.
      798      end.
      799   end procedure.
      800   procedure gen-hn-keyr :
      801     define input  parameter p-key-rec    as character no-undo.
      802     define input  parameter p-key-handle as handle    no-undo .
      803     define input  parameter p-db-name    as character no-undo .
      804     define input  parameter p-tt-handle  as handle    no-undo .
      805     define input  parameter p-stts-lock  as integer   no-undo .
      806     define output parameter o-hn         as handle    no-undo.
      807     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      808   end.
      809   procedure gen-row-keyr :
      810     define input  parameter p-key-rec    as character no-undo.
      811     define input  parameter p-key-handle as handle    no-undo .
      812     define input  parameter p-db-name    as character no-undo .
      813     define input  parameter p-tt-handle  as handle    no-undo .
      814     define input  parameter p-stts-lock  as integer   no-undo .
      815     define output parameter p-tbl-row    as rowid     no-undo.
      816     define output parameter p-tbl-name   as character no-undo.
      817     define variable vHn as handle no-undo.
      818       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      819       p-tbl-row = if vHn:available then vHn:rowid else ?.
      820       p-tbl-name =  vHn:table.
      821       delete object vHn no-error.
      822     if p-tbl-row = ? then do:
      823       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
      824     end.
      825     else do:
      826       return.
      827     end.
      828   end procedure.
      829   procedure gen-key-fv :
      830     define input  parameter p-key-rec    as character no-undo .
      831     define output parameter p-field-list as character no-undo .
      832     define output parameter p-value-list as character no-undo.
      833     do
      834     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      835     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      836     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      837     :
      838       define variable v-full-tbl-name  as character no-undo .
      839       define variable bh_tbl-name      as handle    no-undo .
      840       define variable v-tbl-name       as character no-undo .
      841       define variable v-field-num      as integer   no-undo .
      842       define variable v-count-fld      as integer   no-undo .
      843       define variable v-inform         as character no-undo .
      844       define variable v-ind            as integer   no-undo .
      845       define variable v-idx-field-qnty as integer   no-undo .
      846       define variable v-delim-key      as character no-undo .
      847       if p-key-rec = ?
      848         or p-key-rec = "":U
      849       then do:
      850         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      851       end.
      852       assign
      853         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      854         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      855       .
      856       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      857       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
      858       assign
      859         v-inform = bh_tbl-name:index-information(1)
      860         v-ind    = 2
      861       .
      862       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      863       on error undo, return error
      864       :
      865         assign
      866           v-inform = bh_tbl-name:index-information( v-ind )
      867           v-ind    = v-ind + 1
      868         .
      869       end.
      870       if v-inform = ?
      871         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      872         or entry( 3, v-inform, ",":U ) <> "1":U
      873       then do:
      874         delete object bh_tbl-name no-error.
      875         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      876       end.
      877       assign
      878         v-idx-field-qnty = num-entries( v-inform ) - 4
      879       .
      880       if v-idx-field-qnty < 2 then do:
      881         delete object bh_tbl-name no-error.
      882         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      883       end.
      884       assign
      885         p-field-list = "":U
      886         p-value-list = "":U
      887         v-delim-key  = "":U
      888         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      889         v-count-fld  = 0
      890       .
      891       block_where:
      892       do v-ind = 1 to v-idx-field-qnty by 2
      893       on error undo, return error
      894       :
      895         assign
      896           v-count-fld = v-count-fld + 1
      897         .
      898         if v-count-fld > v-field-num then do:
      899           leave block_where.
      900         end.
      901         assign
      902           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      903           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      904         .
      905         if v-ind = 1 then do:
      906           assign
      907             v-delim-key = chr(3)
      908           .
      909         end.
      910       end.
      911       delete object bh_tbl-name.
      912       if v-count-fld <> v-field-num then do:
      913         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
      914       end.
      915     end.
      916   end procedure.
      917   procedure gen-key-field :
      918     define input  parameter p-table      as character no-undo .
      919     define output parameter p-field-list as character no-undo .
      920     do
      921     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      922     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      923     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      924     :
      925       define variable v-full-tbl-name  as character no-undo .
      926       define variable bh_tbl-name      as handle    no-undo .
      927       define variable v-tbl-name       as character no-undo .
      928       define variable v-field-num      as integer   no-undo .
      929       define variable v-count-fld      as integer   no-undo .
      930       define variable v-inform         as character no-undo .
      931       define variable v-ind            as integer   no-undo .
      932       define variable v-idx-field-qnty as integer   no-undo .
      933       define variable v-delim-key      as character no-undo .
      934       if p-table = ?
      935         or p-table = "":U
      936       then do:
      937         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
      938       end.
      939       assign
      940         v-tbl-name      = p-table
      941         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      942       .
      943       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      944       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
      945       assign
      946         v-inform = bh_tbl-name:index-information(1)
      947         v-ind    = 2
      948       .
      949       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      950       on error undo, return error
      951       :
      952         assign
      953           v-inform = bh_tbl-name:index-information( v-ind )
      954           v-ind    = v-ind + 1
      955         .
      956       end.
      957       if v-inform = ?
      958         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      959         or entry( 3, v-inform, ",":U ) <> "1":U
      960       then do:
      961         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      962       end.
      963       assign
      964         v-idx-field-qnty = num-entries( v-inform ) - 4
      965       .
      966       if v-idx-field-qnty < 2 then do:
      967         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      968       end.
      969       assign
      970         p-field-list = "":U
      971         v-delim-key  = "":U
      972         v-count-fld  = 0
      973       .
      974       block_where:
      975       do v-ind = 1 to v-idx-field-qnty by 2
      976       on error undo, return error
      977       :
      978         assign
      979           v-count-fld = v-count-fld + 1
      980         .
      981         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      982         if v-ind = 1 then do:
      983           assign
      984             v-delim-key = chr(3)
      985           .
      986         end.
      987       end.
      988       delete object bh_tbl-name.
      989     end.
      990   end procedure.
      991   define SHARED temp-table temp-cmd no-undo
      992   field cmd-code as integer
      993   field db-list as character
      994   index pi is unique primary
      995   db-list
      996   index icmd
      997   cmd-code
      998   .
      999   define SHARED temp-table temp-smart-route no-undo
     1000   field key-field as character
     1001   field db-num as integer
     1002   index pi is unique primary
     1003   key-field
     1004   db-num
     1005   .
     1006   define SHARED temp-table temp-no-route no-undo
     1007   field rec-ord as integer
     1008   field db-num as integer
     1009   index pi is unique primary
     1010   db-num
     1011   rec-ord
     1012   index iro
     1013   rec-ord
     1014   .
     1015   define SHARED temp-table temp-smart-link no-undo
     1016   field uniq-key-rec as character
     1017   field key-field as character
     1018   field rec-ord as integer
     1019   field is-smart as logical
     1020   index pi is unique primary
     1021   key-field
     1022   uniq-key-rec
     1023   rec-ord
