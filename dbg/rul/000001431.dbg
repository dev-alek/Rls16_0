     2952   buf_rule-call-param.codex_id = p-codex-id
     2953   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2954   and buf_rule-call-param.call_id = p-call-id
     2955   and buf_rule-call-param.order_id = p-order-id
