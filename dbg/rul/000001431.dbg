     2635   FUNCTION get_current_sum-id_by-date returns character(
     2636                                                       input p-date as date
     2637                                                     , input p-caller-id as character ):
     2638   define buffer buf_prop-ref for ub.prop-ref.
     2639   define variable v-date-char as character no-undo .
     2640   define buffer buf_dis-card-type for ub.dis-card-type.
     2641   assign
     2642   v-date-char = string(year(p-date), "9999") + "/" +
     2643                 string(month(p-date), "99") + "/" +
     2644               string(day(p-date), "99")
     2645   v-date-char = v-date-char + "-" + v-date-char
     2646   .
     2647   find last buf_prop-ref no-lock where
     2648             buf_prop-ref.dtm-code = 5
     2649         and buf_prop-ref.sum-id <= v-date-char
     2650         and buf_prop-ref.caller_id = p-caller-id use-index idtsum
     2651         no-error .
     2652   if not available buf_prop-ref then do:
     2653     return chr(63).
     2654   end.
     2655   return buf_prop-ref.sum-id.
     2656   end function.
     2657   on delete of this-procedure do:
     2658     run garbcoll_clear in this-procedure .
     2659   end.
     2660   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     2661    define variable Card1 as class Dis-card_ no-undo .
     2662   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2663    define variable Next-discount1 as class Next-discount_ no-undo .
     2664   Next-discount1 = new Next-discount_(  input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 7) .
     2665    define variable Tot-period-sum-host1 as class Dis-tot_host no-undo .
     2666   Tot-period-sum-host1 = new Dis-tot_host( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 5) .
     2667    define variable Tot-period-sum1 as class Dis-tot_ no-undo .
     2668   Tot-period-sum1 = new Dis-tot_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 5) .
     2669    define variable v-netto-sum1 as  decimal no-undo .
     2670   if not this-procedure:persistent then do:
     2671     run proc-main in this-procedure ( input p-type
     2672                                 ,input p-emitent-host-code ) no-error .
     2673     if error-status:error then do:
     2674         run garbcoll_clear in this-procedure .
     2675         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2676     end.
     2677     run garbcoll_clear in this-procedure .
     2678   end.
     2679   procedure proc-main :
     2680   define input parameter p-type like ub.dis-card.type no-undo .
     2681   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2682   _main:
     2683   do
     2684   on error undo, return error return-value
     2685   :
     2686   assign
     2687   v-emitent-host-code = p-emitent-host-code
     2688   v-type = p-type.
     2689     _d-card:
     2690     for each temp-d-card where
     2691             temp-d-card.type = p-type
     2692         and temp-d-card.emitent-host-code = p-emitent-host-code
     2693     break
     2694     by temp-d-card.d-card
     2695     On error undo _d-card, retry _d-card:
     2696       if temp-d-card.d-card = '_' then next.
     2697       if retry then do:
     2698         if p-ruleset-id = 5 then do:
     2699           num-rec-calc-err = num-rec-calc-err + 1.
     2700           undo _d-card, next _d-card .
     2701         end.
     2702         else do:
     2703           undo _main, return error return-value .
     2704         end.
     2705       end.
     2706       num-rec = num-rec + 1.
     2707       assign
     2708       v-current-d-card = temp-d-card.d-card
     2709       .
     2710       do transaction
     2711       On end-key undo _d-card, retry _d-card
     2712       On stop undo _d-card, retry _d-card
     2713       On error undo _d-card, retry _d-card:
     2714   _1431:
     2715   do:
     2716   IF  get_current_sum-id_by-date( INPUT v-current-doc-date, INPUT p-tot-caller-id) = "?"  THEN do:
     2717     _1446:
     2718     do:
     2719      leave _1431 .
     2720     end.
     2721   end.
     2722   IF  get_current_nd_sum-id_by-date( INPUT v-current-doc-date, INPUT p-nd-caller-id) = "?"  THEN do:
     2723     _1447:
     2724     do:
     2725      leave _1431 .
     2726     end.
     2727   end.
     2728   IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     2729    v-netto-sum1 = 0 .
     2730     _1433:
     2731     do:
     2732     IF  Card1:emitent-host-code = 0  THEN do:
     2733       _1432:
     2734       do:
     2735       IF  Tot-period-sum1:find_dis-tot_date( INPUT v-current-d-card, INPUT v-current-doc-date, INPUT p-tot-caller-id) = true  THEN do:
     2736         _1438:
     2737         do:
     2738         IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2739           _1437:
     2740           do:
     2741            v-netto-sum1 = Tot-period-sum1:pay-tot-rubl .
     2742           end.
     2743         end.
     2744         IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2745           _1448:
     2746           do:
     2747            v-netto-sum1 = Tot-period-sum1:pay-tot-rubl_byf# .
     2748           end.
     2749         end.
     2750         IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2751           _1444:
     2752           do:
     2753            v-netto-sum1 = Tot-period-sum1:pay-tot-base .
     2754           end.
     2755         end.
     2756         IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2757           _1443:
     2758           do:
     2759            v-netto-sum1 = Tot-period-sum1:pay-tot-base_byf# .
     2760           end.
     2761         end.
     2762         end.
     2763       end.
     2764       end.
     2765     end.
     2766     IF  Card1:emitent-host-code > 0  THEN do:
     2767       _1440:
     2768       do:
     2769       IF  Tot-period-sum-host1:find_dis-tot_host_date( INPUT v-current-d-card, INPUT v-current-host-code, INPUT v-current-doc-date, INPUT p-tot-caller-id) = true  THEN do:
     2770         _1435:
     2771         do:
     2772         IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2773           _1441:
     2774           do:
     2775            v-netto-sum1 = Tot-period-sum-host1:pay-tot-rubl .
     2776           end.
     2777         end.
     2778         IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2779           _1442:
     2780           do:
     2781            v-netto-sum1 = Tot-period-sum-host1:pay-tot-rubl_byf# .
     2782           end.
     2783         end.
     2784         IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2785           _1439:
     2786           do:
     2787            v-netto-sum1 = Tot-period-sum-host1:pay-tot-base .
     2788           end.
     2789         end.
     2790         IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2791           _1434:
     2792           do:
     2793            v-netto-sum1 = Tot-period-sum-host1:pay-tot-base_byf# .
     2794           end.
     2795         end.
     2796         end.
     2797       end.
     2798       end.
     2799     end.
     2800     end.
     2801   end.
     2802   IF  Next-discount1:find_next-discount_date( INPUT v-current-d-card, INPUT v-current-doc-date, INPUT p-nd-caller-id) = false  THEN do:
     2803     _1445:
     2804     do:
     2805     IF  Next-discount1:create_next-discount_date( INPUT v-current-d-card, INPUT v-current-doc-date, INPUT p-nd-caller-id) = false  THEN do:
     2806       _1449:
     2807       do:
     2808        undo _main, return error v-last-error-message .
     2809       end.
     2810     end.
     2811     end.
     2812   end.
     2813    Next-discount1:d-pcnt = dis-rule_00060( INPUT p-rule-num, INPUT v-current-doc-date, INPUT v-current-doc-time, INPUT v-netto-sum1) .
     2814   IF  Next-discount1:next-discount_save( ) = false  THEN do:
     2815     _1436:
