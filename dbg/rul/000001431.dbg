     2961   end.
     2962    find first buf_rule-call-param no-lock where
     2963   buf_rule-call-param.codex_id = p-codex-id
     2964   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2965   and buf_rule-call-param.call_id = p-call-id
     2966   and buf_rule-call-param.order_id = p-order-id
     2967   and buf_rule-call-param.rule_id = p-rule-id
     2968   and buf_rule-call-param.param-name = "p-nd-caller-id"
     2969    no-error.
     2970   if available buf_rule-call-param then do:
     2971   assign p-nd-caller-id = buf_rule-call-param.param-value-character.
     2972   end.
     2973       assign
