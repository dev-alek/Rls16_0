     2857                           ,input temp-d-card.cli-code
     2858                           ,input v-payment-host-code
     2859                           ,input v-sign * vchk-pay.tot-sum
     2860                           ,input v-sign * vchk-pay.tot-base
     2861                           ,input v-sign * vchk-pay.tot-rubl
     2862                           ,input vchk-pay.doc-date
     2863                           ,input vchk-pay.curr-code
     2864                           ,input vchk-pay.exch-rate
     2865                           ,input 1
     2866                           ,input vchk-pay.base-rate
     2867                           ,input 1
     2868                           ,input ?
     2869                           ,input p-fact-date
     2870                           ,input temp-d-card.sale-type
     2871                           ,input p-doc-code
     2872                           ,input temp-d-card.d-card
     2873                           ,input vchk-pay.pay-code
     2874                           ,input 'факт':U
     2875                           ,input '':U
     2876                           ,input g#userid
     2877                           ,input g#userid
     2878                           ) no-error.
     2879               IF ERROR-STATUS:ERROR then do:
