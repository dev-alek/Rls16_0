     1749   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1750   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1751   define buffer buf_temp-cmd for temp-cmd.
     1752   define buffer buf_dis-card-sale_obj for temp-d-card.
     1753   define variable vh_dis-card-sale_obj as handle no-undo .
     1754    define variable p-r-b as character no-undo.
     1755    define variable p-is-over as logical no-undo.
     1756    define variable p-rule-num as integer no-undo.
     1757    define variable p-tot-caller-id as character no-undo.
     1758    define variable p-nd-caller-id as character no-undo.
     1759   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1762   procedure dis-hsth_write-dis-host-rul :
     1763   define parameter buffer buf_dis-host for ub.dis-host .
     1764   define input parameter p-type as character no-undo .
     1765   define input parameter p-emitent-host-code as integer no-undo .
     1766   define input parameter p-dtm-code as integer no-undo .
     1767   define input parameter p-action as integer no-undo .
     1768   define variable v-date as date      no-undo.
     1769   define variable v-time  as integer   no-undo.
     1770   define variable v-rec-ord1 as integer no-undo .
     1771   define variable v-rec-ord2 as integer no-undo .
     1772   define variable v-rec-ord3 as integer no-undo .
     1773   define variable v-rec-hno as integer no-undo .
     1774   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1775   define buffer buf_c-dis-host for ub.c-dis-host.
     1776   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1777   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1778   do
     1779   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1780   :
     1781     if not available buf_dis-host then do:
     1782       message
     1783         vss-workfile vss-revision vss-description skip
     1784         "Ошибка задания входных параметров" skip
     1785         "Не определена ДК" skip
     1786         view-as alert-box error .
     1787       undo, return error .
     1788     end.
     1789     find first buf_temp-hist-nws-option where
     1790               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1791           and buf_temp-hist-nws-option.db-num = g#db-num
     1792           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1793           and buf_temp-hist-nws-option.charkey_one = p-type
     1794           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1795     if not available buf_temp-hist-nws-option then do:
     1796       find first last_temp-hist-nws-option where
     1797                last_temp-hist-nws-option.db-num = g#db-num
     1798            and last_temp-hist-nws-option.hn-id < 0 no-error.
     1799       create buf_temp-hist-nws-option.
     1800       assign
     1801       buf_temp-hist-nws-option.db-num = g#db-num
     1802       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1803                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1804                                   else -1 )
     1805       buf_temp-hist-nws-option.table-name = 'dis-host':U
     1806       buf_temp-hist-nws-option.key#_one = p-dtm-code
     1807       buf_temp-hist-nws-option.charkey_one = p-type
     1808       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1809       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1810       .
     1811   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1812   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1813     (input  g#db-num
     1814     ,input  buffer buf_temp-hist-nws-option:handle
     1815     )  .
     1816     end.
     1817     if not g#news
     1818     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1819       return.
     1820     end.
     1821     if g#news
     1822     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1823       return.
     1824     end.
     1825     run cur-time in this-procedure(output v-date, output v-time).
     1826     create buf_c-dis-host.
     1827     buffer-copy buf_dis-host to buf_c-dis-host
     1828     assign
     1829     buf_c-dis-host.d-card             = buf_dis-host.d-card
     1830     buf_c-dis-host.host-code          = buf_dis-host.host-code
     1831     buf_c-dis-host.card-num           = buf_dis-host.card-num
     1832     buf_c-dis-host.dt-code            = buf_dis-host.dt-code
     1833     buf_c-dis-host.main-card          = buf_dis-host.main-card
     1834     buf_c-dis-host.first-main-card    = buf_dis-host.first-main-card
     1835     buf_c-dis-host.first-card         = buf_dis-host.first-card
     1836     buf_c-dis-host.chip-num           = next-value (s-dc-chip, ub)
     1837     buf_c-dis-host.corr-time          = v-time
     1838     buf_c-dis-host.corr-user-db-num   = g#db-num
     1839     buf_c-dis-host.corr-user-name     = (if g#news
     1840                                         then (chr(4) +  'СПН':U)
     1841                                         else (if g#esys
     1842                                               then (chr(4) +  'ВС':U)
     1843                                               else g#userid)
     1844                                         )
     1845     buf_c-dis-host.corr-date          = v-date
     1846     .
     1847     create buf_c-dc-hist.
     1848     buffer-copy buf_c-dis-host to buf_c-dc-hist
     1849     assign
     1850     buf_c-dc-hist.action = p-action
     1851     buf_c-dc-hist.subject = 'dis-host':U
     1852     buf_c-dc-hist.host-code =  buf_dis-host.host-code
     1853     buf_c-dc-hist.is-news = g#news
     1854     buf_c-dc-hist.source-type = p-doc-type
     1855     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1856                                  then '':U
     1857                                  else p-doc-code)
     1858     .
     1859     if g#db-num > 0
     1860     or (g#db-num = 0
     1861     and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1862     then do:
     1863       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-host':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-host:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-host':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
