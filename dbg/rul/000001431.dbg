     2058   procedure get-db-list-for-d-card2 :
     2059   define input parameter p-d-card as character no-undo .
     2060   define variable v-current-db-processed as logical no-undo .
     2061   define buffer buf_clients  for ub.clients.
     2062   define buffer buf_dis-obj for ub.dis-obj.
     2063   define buffer buf_temp-smart-route for temp-smart-route.
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       for each buf_dis-obj no-lock where
     2068               buf_dis-obj.d-card = p-d-card,
     2069          first buf_clients no-lock where
     2070               buf_clients.obj-type = buf_dis-obj.obj-type
     2071           and buf_clients.obj-code = buf_dis-obj.obj-code
     2072       break by
     2073       buf_clients.db-num:
     2074         if first-of(buf_Clients.db-num) then do:
     2075           find first buf_temp-smart-route no-lock where
     2076                 buf_temp-smart-route.key-field = p-d-card
     2077             and buf_temp-smart-route.db-num = buf_clients.db-num
     2078                 no-error.
     2079           if available buf_temp-smart-route then return.
     2080           create buf_temp-smart-route.
     2081           assign
     2082           buf_temp-smart-route.key-field = p-d-card
     2083           buf_temp-smart-route.db-num = buf_clients.db-num
     2084           .
     2085           if buf_clients.db-num = g#db-num then do:
     2086             v-current-db-processed = yes.
     2087           end.
     2088         end.
     2089       end.
     2090       if not v-current-db-processed then do:
     2091         find first buf_temp-smart-route no-lock where
     2092               buf_temp-smart-route.key-field = p-d-card
     2093           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2094         if not available buf_temp-smart-route then do:
     2095           create buf_temp-smart-route.
     2096           assign
     2097           buf_temp-smart-route.key-field = p-d-card
     2098           buf_temp-smart-route.db-num = g#db-num
     2099           .
     2100         end.
     2101       end.
     2102     end.
     2103   end procedure.
