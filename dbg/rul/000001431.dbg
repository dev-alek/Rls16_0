     1073        buf_temp-smart-link.key-field = p-key-field
     1074        buf_temp-smart-link.rec-ord = p-rec-ord
     1075        buf_temp-smart-link.is-smart = p-is-smart
     1076        .
     1077      end.
     1078     end.
     1079   end procedure.
     1080   procedure create-nws-outline :
     1081   define input parameter p-cmd-proc-handle as handle no-undo .
     1082   define input parameter p-cmd-code as integer no-undo .
     1083   define input parameter p-outline-type as character no-undo .
     1084   define input parameter p-charkey_one as character no-undo .
     1085   define input parameter p-charkey_two as character no-undo .
     1086   define input parameter p-charkey_three as character no-undo .
     1087   define input parameter p-key#_one as integer no-undo .
     1088   define input parameter p-key#_two as integer no-undo .
     1089   define input parameter p-key#_three as integer no-undo .
     1090   define variable v-no-id as integer no-undo .
     1091   define variable v-rec-ord as integer no-undo .
     1092     do
     1093     on error undo, return error return-value
     1094     :
     1095       find last temp-nws-outline use-index pi no-error .
     1096       v-no-id = (if available temp-nws-outline
     1097                  then (temp-nws-outline.no-id  + 1)
     1098                  else 1).
     1099       create temp-nws-outline.
     1100       assign
     1101       temp-nws-outline.charkeY_one = p-charkey_one
     1102       temp-nws-outline.charkeY_two = p-charkey_two
     1103       temp-nws-outline.charkeY_three = p-charkey_three
     1104       temp-nws-outline.key#_one = p-key#_one
     1105       temp-nws-outline.key#_two = p-key#_two
     1106       temp-nws-outline.key#_three = p-key#_three
     1107       temp-nws-outline.no-id = v-no-id
     1108       temp-nws-outline.outline-type = p-outline-type
     1109       .
     1110                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1111       run  create-smart-route in this-procedure (
     1112                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1113                                                  ,input -1).
     1114       run create-smart-route-link in this-procedure (
     1115                                                      input 'nws-outline':U
     1116                                                     ,input (buffer temp-nws-outline:handle)
     1117                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1118                                                     ,input v-rec-ord
     1119                                                     ,input no
     1120                                                     ).
     1121     end.
     1122   end procedure.
     1123   procedure create-no-route :
     1124   define input parameter p-rec-ord as integer no-undo .
     1125   define input parameter p-db-num as integer no-undo .
