     1143   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   procedure set-error :
     1145   define input parameter p-mess as character no-undo .
     1146     do
     1147     on error undo, return error
     1148     :
     1149        assign
     1150        v-last-error-message = p-mess.
     1151     end.
     1152   end procedure.
     1153   define buffer buf_temp-cmd for temp-cmd.
     1154   on delete of this-procedure do:
     1155     run garbcoll_clear in this-procedure .
     1156   end.
     1157   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1158   if error-status:error then do:
     1159     undo, return error return-value .
     1160   end.
     1161   if not this-procedure:persistent then do:
     1162     run proc-main in this-procedure no-error .
     1163     if error-status:error then do:
     1164       v-esm = error-status :get-message (1).
     1165       v-es = error-status:error .
     1166       v-rv = return-value .
     1167     end.
     1168     if p-ruleset-id = 1
     1169     then do:
     1170   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1171   if v-view-log
     1172   and not g#news
     1173   and not g#auto
     1174   then do:
     1175     message
     1176     '!!!При работе произошли ошибки!!!'  skip
     1177     "!!!Внимательно прочитайте Log-file!!"
     1178     view-as alert-box error .
     1179        define variable v-user-action12   as character no-undo .
     1180     define variable v-printed12       as logical   no-undo .
     1181     run gbl/prnfilen.w
     1182       (input  ('!!!При работе произошли ошибки!!!')
     1183       ,input  0
     1184       ,input  (string("./":U) + log-file-name)
     1185       ,input  7
     1186       ,output v-user-action12
     1187       ,output v-printed12
     1188       ) .
     1189   end.
     1190   if v-view-log = true
     1191   and (g#news
     1192   or g#auto)
     1193   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1194   then do:
     1195      run cb_set-view-log in p-parent-handle ( input yes).
     1196   end.
     1197     end.
     1198     if v-es then do:
     1199         run garbcoll_clear in this-procedure .
     1200         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1201     end.
     1202     run garbcoll_clear in this-procedure .
     1203   end.
     1204   procedure proc-main :
     1205   _main:
     1206   do
     1207   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     1208   :
     1209     define variable v-ii as integer no-undo .
     1210     define variable v-err as logical no-undo .
     1211     define variable v-success as logical   no-undo .
     1212     define variable v-parameter as character no-undo .
     1213     DEFINE VARIABLE v-today as date no-undo .
     1214     DEFINE VARIABLE v-time as integer no-undo .
     1215     define variable v-kol-ord as integer   no-undo .
     1216     define buffer buf_clients for ub.clients.
     1217     if p-ruleset-id = 1
     1218     then do:
     1219       run write-log  in p-log-handle (
     1220                                       input 0
     1221                                     , "&DLine").
     1222           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Циклические заказы")).
     1223     end.
     1224   _obj:
     1225     for each buf_clients no-lock where
     1226              buf_clients.db-num = g#db-num
     1227     :
     1228        v-kol-ord = 0 .
     1229        run cus/ord-cyc.p
     1230        ( input buf_clients.obj-type ,
     1231          input buf_clients.obj-code ,
     1232          input p-log-handle,
     1233          output v-kol-ord
     1234        ) .
     1235       num-rec = num-rec + v-kol-ord.
     1236       run get-stop-state in p-log-handle ( output v-stop) no-error .
     1237       if v-stop then do:
     1238           run write-log-and-file in p-log-handle (
     1239               input 1
     1240             , input log-file-name
     1241             , input 1
     1242             , input substitute("Процесс прерван пользователем")
     1243             ).
     1244           leave _obj.
     1245       end.
     1246     end.
     1247     run write-log-and-file in p-log-handle (
     1248           input 1
     1249         , input log-file-name
     1250         , input 1
     1251         , input substitute("Обработано заказов : &1, из них удачно: &2", num-rec, num-rec)).
     1252   end.
     1253   end procedure.
     1254   procedure load-ruleset-context :
     1255   define input parameter p-ruleset-id as integer no-undo .
     1256   define buffer buf_rule-call-param for ub.rule-call-param.
     1257     do
     1258     on error undo, return error
     1259     :
     1260       case p-ruleset-id:
     1261         when 1
     1262         then do:
     1263           assign
     1264           v-sign = 2
     1265           v-current-host-code = p-host-code
     1266           v-current-obj-type = p-obj-type
     1267           v-current-obj-code = p-obj-code
     1268           v-current-db-num = g#db-num
     1269           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1270           .
     1271         end.
     1272       end case.
     1273     end.
     1274   end procedure.
