        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-codex-id as integer no-undo .
        7   define input parameter p-ruleset-id as integer no-undo .
        8   define input parameter p-call-id as character no-undo .
        9   define input parameter p-order-id as integer no-undo .
       10   define input parameter p-rule-id as integer no-undo .
       11   define input parameter p-profile-id as integer no-undo .
       12   define input parameter p-is-dynamic as logical no-undo .
       13   define input parameter p-doc-type as character no-undo .
       14   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       16   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       17   define input parameter p-doc-code as character no-undo .
       18   define input parameter p-save       as integer no-undo .
       19   define input parameter v-curr-r-b   as character no-undo .
       20   define input parameter p-cmd-proc-handle as handle no-undo .
       21   define input parameter p-cmd-code  as integer no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision$":U .
       23   define variable vss-author      as character no-undo init "$Author$":U .
       24   define variable vss-date        as character no-undo init "$Date$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       26   define variable vss-archive     as character no-undo init "$Archive$":U .
       27   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 23, набор 1".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define   shared variable g#auto as logical no-undo.
       89   define   shared variable g#news as logical no-undo.
       90   define   shared variable g#oxml as logical no-undo.
       91   define   shared variable g#esys as logical no-undo.
       92   define   shared variable g#news-source-db as integer no-undo.
       93   define   shared variable g#esys-source-esys as integer no-undo.
       94   define   shared variable g#db-num as integer   no-undo .
       95   define   shared variable g#userid as character no-undo .
       96   define   shared variable g#passwd as character no-undo .
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  variable garbcoll_ii as integer no-undo .
       99   define  temp-table temp-gc no-undo
      100   field ii as integer
      101   field obj-r as handle
      102   field cn as character
      103   index pi is unique primary
      104   ii
      105   index icn
      106   cn.
      107   procedure garbcoll_create-gc-entry :
      108   define input parameter p-cn as character no-undo .
      109   define input parameter p-obj-r as handle no-undo .
      110     do
      111     on error undo, return error
      112     :
      113       create temp-gc.
      114       assign
      115       temp-gc.ii = garbcoll_ii
      116       garbcoll_ii = garbcoll_ii + 1
      117       temp-gc.cn = p-cn
      118       temp-gc.obj-r = p-obj-r
      119       .
      120     end.
      121   end procedure.
      122   procedure garbcoll_clear :
      123     do
      124     on error undo, return error
      125     :
      126       for each temp-gc:
      127         delete object temp-gc.obj-r.
      128         delete temp-gc.
      129       end.
      130     end.
      131   end procedure.
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define new global shared variable g#lib-nws as handle no-undo .
      359   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   procedure gen-key-rec :
      362     define input  parameter p-tbl-name    as character no-undo.
      363     define input  parameter p-bh_tbl-name as handle    no-undo.
      364     define output parameter p-key-rec     as character no-undo.
      365     do
      366     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      367     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      369     :
      370       define variable fh               as handle    no-undo .
      371       define variable v-ok             as logical   no-undo .
      372       define variable v-inform         as character no-undo .
      373       define variable v-ind            as integer   no-undo .
      374       define variable v-idx-field-qnty as integer   no-undo .
      375       if p-tbl-name = ?
      376         or p-tbl-name = "":U
      377       then do:
      378         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      379       end.
      380       if not p-bh_tbl-name:available then do:
      381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      382       end.
      383       assign
      384         p-key-rec = p-tbl-name
      385         v-inform  = p-bh_tbl-name:index-information(1)
      386         v-ind     = 2
      387       .
      388       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      389       on error undo, return error
      390       :
      391         assign
      392           v-inform = p-bh_tbl-name:index-information( v-ind )
      393           v-ind    = v-ind + 1
      394         .
      395       end.
      396       if v-inform = ?
      397         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      398         or entry( 3, v-inform, ",":U ) <> "1":U
      399       then do:
      400         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      401       end.
      402       else do:
      403         assign
      404           v-idx-field-qnty = num-entries( v-inform ) - 4
      405         .
      406         if v-idx-field-qnty < 2 then do:
      407           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      408         end.
      409         do v-ind = 1 to v-idx-field-qnty by 2
      410         on error undo, return error
      411         :
      412           assign
      413             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      414             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      415           .
      416         end.
      417       end.
      418       if p-key-rec = ? then do:
      419         assign
      420           p-key-rec = "":U
      421         .
      422         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      423       end.
      424     end.
      425     return.
      426   end procedure.
      427   procedure gen-where-keyr-tab :
      428     define input  parameter i-tableSerach as character no-undo.
      429     define input  parameter i-tablekey   as character  no-undo.
      430     define input  parameter p-key-rec    as character  no-undo.
      431     define input  parameter p-key-handle as handle     no-undo .
      432     define input  parameter p-db-name    as character  no-undo .
      433     define input  parameter p-tt-handle  as handle     no-undo .
      434     define output parameter o-Where      as character  no-undo.
      435     do
      436     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      437     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      438     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      439     :
      440       define variable v-full-tbl-name  as character no-undo .
      441       define variable bh_tbl-name      as handle    no-undo .
      442       define variable fh_key           as handle    no-undo .
      443       define variable fh_search        as handle    no-undo .
      444       define variable v-field-num      as integer   no-undo .
      445       define variable v-count-fld      as integer   no-undo .
      446       define variable v-inform         as character no-undo .
      447       define variable v-ind            as integer   no-undo .
      448       define variable v-idx-field-qnty as integer   no-undo .
      449       define variable v-field-name     as character no-undo .
      450       define variable v-field-val      as character no-undo .
      451       define variable v-word-link      as character no-undo .
      452       define variable vTable           as character no-undo.
      453       define variable bh_tbl-key       as handle    no-undo .
      454       assign
      455         p-key-rec = trim( p-key-rec )
      456       .
      457       if p-key-handle <> ? then do:
      458         if not valid-handle(p-key-handle)
      459            or p-key-handle:type <> "buffer"
      460         then do:
      461           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      462         end.
      463         if num-entries( p-key-rec, chr(3) ) > 1
      464           or p-key-rec = ?
      465           or p-key-rec = "":U
      466         then do:
      467           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      468         end.
      469       end.
      470       else do:
      471         if p-key-rec = ?
      472           or p-key-rec = "":U
      473         then do:
      474           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      475         end.
      476       end.
      477       assign
      478         vTable = entry( 1 , p-key-rec, chr(3) )
      479       .
      480       if p-tt-handle <> ?
      481         and ( not valid-handle(p-tt-handle)
      482               or p-tt-handle:type <> "buffer"
      483             )
      484       then do:
      485         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      486       end.
      487       if p-tt-handle = ? then do:
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      490         .
      491         create buffer bh_tbl-name for table v-full-tbl-name .
      492       end.
      493       else do:
      494         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      495       end.
      496       assign
      497         v-inform = bh_tbl-name:index-information(1)
      498         v-ind    = 2
      499       .
      500       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      501       on error undo, return error
      502       :
      503         assign
      504           v-inform = bh_tbl-name:index-information( v-ind )
      505           v-ind    = v-ind + 1
      506         .
      507       end.
      508       if v-inform = ?
      509         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      510         or entry( 3, v-inform, ",":U ) <> "1":U
      511       then do:
      512         delete object bh_tbl-name no-error.
      513         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      514       end.
      515       assign
      516         v-idx-field-qnty = num-entries( v-inform ) - 4
      517       .
      518       if v-idx-field-qnty < 2 then do:
      519         delete object bh_tbl-name no-error.
      520         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      521       end.
      522       assign
      523         o-where     = "where":U
      524         v-word-link = "":U
      525         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      526         v-count-fld = 0
      527       .
      528       if i-tablekey ne "" and i-tablekey ne ?
      529       then do:
      530         assign
      531           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      532         .
      533         create buffer bh_tbl-key for table v-full-tbl-name .
      534       end.
      535       if i-tableSerach ne "" and i-tableSerach ne ?
      536       then do:
      537         delete object bh_tbl-name no-error.
      538         assign
      539           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      540         .
      541         create buffer bh_tbl-name for table v-full-tbl-name .
      542       end.
      543       block_where:
      544       do v-ind = 1 to v-idx-field-qnty by 2
      545       on error undo, return error
      546       :
      547         assign
      548           v-count-fld = v-count-fld + 1
      549         .
      550         if p-key-handle = ?
      551           and v-count-fld > v-field-num
      552         then do:
      553           leave block_where.
      554         end.
      555         define variable VfieldKeyTable as handle no-undo.
      556         assign
      557           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      558           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      559         .
      560         if     bh_tbl-key ne ?
      561         then do:
      562            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      563            if VfieldKeyTable eq ?
      564            then next block_where.
      565         end.
      566         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      567         then
      568            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      569         else
      570            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      571         if p-key-handle = ? then do:
      572           assign
      573             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      574           .
      575         end.
      576         else do:
      577           assign
      578             fh_key = p-key-handle:buffer-field( v-field-name )
      579           .
      580           if fh_key = ?
      581             or not valid-handle( fh_key )
      582           then do:
      583             delete object bh_tbl-name.
      584             if     bh_tbl-key ne ?
      585             then
      586                delete object bh_tbl-key.
      587             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      588           end.
      589           assign
      590             v-field-val = fh_key:buffer-value
      591           .
      592         end.
      593         if fh_search:data-type ="character":U then do:
      594           assign
      595             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      596             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      597             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      598             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      599             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      600             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      601             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      602             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      603             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      604             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      605             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      606             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      607             v-field-val = substitute( '"&1"', v-field-val )
      608           .
      609         end.
      610         assign
      611           o-where = substitute( "&1 &2", o-where, v-field-val )
      612         .
      613         if v-word-link = "":U then do:
      614           assign
      615             v-word-link = "and":U
      616           .
      617         end.
      618       end.
      619       delete object bh_tbl-name.
      620       if     bh_tbl-key ne ?
      621       then
      622          delete object bh_tbl-key.
      623       if p-key-handle = ?
      624         and v-count-fld <> v-field-num
      625       then do:
      626         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      627       end.
      628     end.
      629   end procedure.
      630   procedure gen-hn-keyr-tab :
      631     define input  parameter i-tableSerach as character no-undo.
      632     define input  parameter i-tablekey   as character no-undo.
      633     define input  parameter p-key-rec    as character no-undo.
      634     define input  parameter p-key-handle as handle    no-undo .
      635     define input  parameter p-db-name    as character no-undo .
      636     define input  parameter p-tt-handle  as handle    no-undo .
      637     define input  parameter p-stts-lock  as integer   no-undo .
      638     define output parameter o-hn         as handle    no-undo.
      639     define variable v-full-tbl-name as character no-undo.
      640     define variable v-where         as character no-undo.
      641     define variable bh_tbl-name     as handle    no-undo.
      642     define variable vTable          as character no-undo.
      643     do
      644     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      645     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      646     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      647         run gen-where-keyr-tab(i-tableSerach,
      648                                i-tablekey,
      649                                p-key-rec,
      650                                p-key-handle,
      651                                p-db-name,
      652                                p-tt-handle,
      653                                output v-where).
      654         if i-tableSerach ne "" and i-tableSerach ne ?
      655         then do:
      656            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      657            create buffer bh_tbl-name for table v-full-tbl-name .
      658         end.
      659         else do:
      660            if p-tt-handle = ? then do:
      661               assign
      662                  vTable = entry( 1 , p-key-rec, chr(3) )
      663               .
      664               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      665               create buffer bh_tbl-name for table v-full-tbl-name .
      666            end.
      667            else do:
      668               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      669            end.
      670         end.
      671         if p-tt-handle = ? then do:
      672            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      673         end.
      674         else do:
      675            bh_tbl-name:find-first( v-where ) no-error .
      676         end.
      677         o-hn = bh_tbl-name.
      678      end.
      679   end procedure.
      680   procedure gen-hn-keyr :
      681     define input  parameter p-key-rec    as character no-undo.
      682     define input  parameter p-key-handle as handle    no-undo .
      683     define input  parameter p-db-name    as character no-undo .
      684     define input  parameter p-tt-handle  as handle    no-undo .
      685     define input  parameter p-stts-lock  as integer   no-undo .
      686     define output parameter o-hn         as handle    no-undo.
      687     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      688   end.
      689   procedure gen-row-keyr :
      690     define input  parameter p-key-rec    as character no-undo.
      691     define input  parameter p-key-handle as handle    no-undo .
      692     define input  parameter p-db-name    as character no-undo .
      693     define input  parameter p-tt-handle  as handle    no-undo .
      694     define input  parameter p-stts-lock  as integer   no-undo .
      695     define output parameter p-tbl-row    as rowid     no-undo.
      696     define output parameter p-tbl-name   as character no-undo.
      697     define variable vHn as handle no-undo.
      698       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      699       p-tbl-row = if vHn:available then vHn:rowid else ?.
      700       p-tbl-name =  vHn:table.
      701       delete object vHn no-error.
      702     if p-tbl-row = ? then do:
      703       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      704     end.
      705     else do:
      706       return.
      707     end.
      708   end procedure.
      709   procedure gen-key-fv :
      710     define input  parameter p-key-rec    as character no-undo .
      711     define output parameter p-field-list as character no-undo .
      712     define output parameter p-value-list as character no-undo.
      713     do
      714     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      715     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      716     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      717     :
      718       define variable v-full-tbl-name  as character no-undo .
      719       define variable bh_tbl-name      as handle    no-undo .
      720       define variable v-tbl-name       as character no-undo .
      721       define variable v-field-num      as integer   no-undo .
      722       define variable v-count-fld      as integer   no-undo .
      723       define variable v-inform         as character no-undo .
      724       define variable v-ind            as integer   no-undo .
      725       define variable v-idx-field-qnty as integer   no-undo .
      726       define variable v-delim-key      as character no-undo .
      727       if p-key-rec = ?
      728         or p-key-rec = "":U
      729       then do:
      730         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      731       end.
      732       assign
      733         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      734         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      735       .
      736       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      737       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      738       assign
      739         v-inform = bh_tbl-name:index-information(1)
      740         v-ind    = 2
      741       .
      742       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      743       on error undo, return error
      744       :
      745         assign
      746           v-inform = bh_tbl-name:index-information( v-ind )
      747           v-ind    = v-ind + 1
      748         .
      749       end.
      750       if v-inform = ?
      751         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      752         or entry( 3, v-inform, ",":U ) <> "1":U
      753       then do:
      754         delete object bh_tbl-name no-error.
      755         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      756       end.
      757       assign
      758         v-idx-field-qnty = num-entries( v-inform ) - 4
      759       .
      760       if v-idx-field-qnty < 2 then do:
      761         delete object bh_tbl-name no-error.
      762         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      763       end.
      764       assign
      765         p-field-list = "":U
      766         p-value-list = "":U
      767         v-delim-key  = "":U
      768         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      769         v-count-fld  = 0
      770       .
      771       block_where:
      772       do v-ind = 1 to v-idx-field-qnty by 2
      773       on error undo, return error
      774       :
      775         assign
      776           v-count-fld = v-count-fld + 1
      777         .
      778         if v-count-fld > v-field-num then do:
      779           leave block_where.
      780         end.
      781         assign
      782           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      783           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      784         .
      785         if v-ind = 1 then do:
      786           assign
      787             v-delim-key = chr(3)
      788           .
      789         end.
      790       end.
      791       delete object bh_tbl-name.
      792       if v-count-fld <> v-field-num then do:
      793         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      794       end.
      795     end.
      796   end procedure.
      797   procedure gen-key-field :
      798     define input  parameter p-table      as character no-undo .
      799     define output parameter p-field-list as character no-undo .
      800     do
      801     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      802     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      803     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      804     :
      805       define variable v-full-tbl-name  as character no-undo .
      806       define variable bh_tbl-name      as handle    no-undo .
      807       define variable v-tbl-name       as character no-undo .
      808       define variable v-field-num      as integer   no-undo .
      809       define variable v-count-fld      as integer   no-undo .
      810       define variable v-inform         as character no-undo .
      811       define variable v-ind            as integer   no-undo .
      812       define variable v-idx-field-qnty as integer   no-undo .
      813       define variable v-delim-key      as character no-undo .
      814       if p-table = ?
      815         or p-table = "":U
      816       then do:
      817         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      818       end.
      819       assign
      820         v-tbl-name      = p-table
      821         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      822       .
      823       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      824       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      825       assign
      826         v-inform = bh_tbl-name:index-information(1)
      827         v-ind    = 2
      828       .
      829       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      830       on error undo, return error
      831       :
      832         assign
      833           v-inform = bh_tbl-name:index-information( v-ind )
      834           v-ind    = v-ind + 1
      835         .
      836       end.
      837       if v-inform = ?
      838         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      839         or entry( 3, v-inform, ",":U ) <> "1":U
      840       then do:
      841         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      842       end.
      843       assign
      844         v-idx-field-qnty = num-entries( v-inform ) - 4
      845       .
      846       if v-idx-field-qnty < 2 then do:
      847         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      848       end.
      849       assign
      850         p-field-list = "":U
      851         v-delim-key  = "":U
      852         v-count-fld  = 0
      853       .
      854       block_where:
      855       do v-ind = 1 to v-idx-field-qnty by 2
      856       on error undo, return error
      857       :
      858         assign
      859           v-count-fld = v-count-fld + 1
      860         .
      861         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      862         if v-ind = 1 then do:
      863           assign
      864             v-delim-key = chr(3)
      865           .
      866         end.
      867       end.
      868       delete object bh_tbl-name.
      869     end.
      870   end procedure.
      871   define SHARED temp-table temp-cmd no-undo
      872   field cmd-code as integer
      873   field db-list as character
      874   index pi is unique primary
      875   db-list
      876   index icmd
      877   cmd-code
      878   .
      879   define SHARED temp-table temp-smart-route no-undo
      880   field key-field as character
      881   field db-num as integer
      882   index pi is unique primary
      883   key-field
      884   db-num
      885   .
      886   define SHARED temp-table temp-no-route no-undo
      887   field rec-ord as integer
      888   field db-num as integer
      889   index pi is unique primary
      890   db-num
      891   rec-ord
      892   index iro
      893   rec-ord
      894   .
      895   define SHARED temp-table temp-smart-link no-undo
      896   field uniq-key-rec as character
      897   field key-field as character
      898   field rec-ord as integer
      899   field is-smart as logical
      900   index pi is unique primary
      901   key-field
      902   uniq-key-rec
      903   rec-ord
      904   index iu
      905   uniq-key-rec
      906   index iro
      907   rec-ord
      908   .
      909   define SHARED temp-table temp-nws-outline no-undo
      910   like ub.nws-outline.
      911   procedure create-smart-route :
      912   define input parameter p-key-field as character no-undo .
      913   define input parameter p-db-num as integer no-undo .
      914   define buffer buf_temp-smart-route for temp-smart-route.
      915     do
      916     on error undo, return error
      917     :
      918       find first buf_temp-smart-route where
      919                 buf_temp-smart-route.key-field = p-key-field
      920             and buf_temp-smart-route.db-num = p-db-num no-error.
      921       if not available buf_temp-smart-route then do:
      922         create buf_temp-smart-route.
      923         assign
      924         buf_temp-smart-route.key-field = p-key-field
      925         buf_temp-smart-route.db-num = p-db-num
      926         .
      927       end.
      928     end.
      929   end procedure.
      930   procedure create-smart-route-link :
      931   define input parameter p-tbl-name as character no-undo .
      932   define input parameter p-bh_tbl-name as handle no-undo .
      933   define input parameter p-key-field as character no-undo .
      934   define input parameter p-rec-ord as integer no-undo .
      935   define input parameter p-is-smart as logical no-undo .
      936   define variable v-key-rec as character no-undo .
      937   define buffer buf_temp-smart-link for temp-smart-link.
      938     do
      939     on error undo, return error
      940     :
      941       run gen-key-rec in this-procedure ( input p-tbl-name
      942                                          ,input p-bh_tbl-name
      943                                          ,output v-key-rec     ).
      944      find first buf_temp-smart-link where
      945                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      946              and buf_temp-smart-link.key-field = p-key-field
      947              and buf_temp-smart-link.rec-ord = p-rec-ord
      948              no-error .
      949      if not available buf_temp-smart-link then do:
      950        create buf_temp-smart-link.
      951        assign
      952        buf_temp-smart-link.uniq-key-rec = v-key-rec
      953        buf_temp-smart-link.key-field = p-key-field
      954        buf_temp-smart-link.rec-ord = p-rec-ord
      955        buf_temp-smart-link.is-smart = p-is-smart
      956        .
      957      end.
      958     end.
      959   end procedure.
      960   procedure create-nws-outline :
      961   define input parameter p-cmd-proc-handle as handle no-undo .
      962   define input parameter p-cmd-code as integer no-undo .
      963   define input parameter p-outline-type as character no-undo .
      964   define input parameter p-charkey_one as character no-undo .
      965   define input parameter p-charkey_two as character no-undo .
      966   define input parameter p-charkey_three as character no-undo .
      967   define input parameter p-key#_one as integer no-undo .
      968   define input parameter p-key#_two as integer no-undo .
      969   define input parameter p-key#_three as integer no-undo .
      970   define variable v-no-id as integer no-undo .
      971   define variable v-rec-ord as integer no-undo .
      972     do
      973     on error undo, return error return-value
      974     :
      975       find last temp-nws-outline use-index pi no-error .
      976       v-no-id = (if available temp-nws-outline
      977                  then (temp-nws-outline.no-id  + 1)
      978                  else 1).
      979       create temp-nws-outline.
      980       assign
      981       temp-nws-outline.charkeY_one = p-charkey_one
      982       temp-nws-outline.charkeY_two = p-charkey_two
      983       temp-nws-outline.charkeY_three = p-charkey_three
      984       temp-nws-outline.key#_one = p-key#_one
      985       temp-nws-outline.key#_two = p-key#_two
      986       temp-nws-outline.key#_three = p-key#_three
      987       temp-nws-outline.no-id = v-no-id
      988       temp-nws-outline.outline-type = p-outline-type
      989       .
      990                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      991       run  create-smart-route in this-procedure (
      992                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      993                                                  ,input -1).
      994       run create-smart-route-link in this-procedure (
      995                                                      input 'nws-outline':U
      996                                                     ,input (buffer temp-nws-outline:handle)
      997                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      998                                                     ,input v-rec-ord
      999                                                     ,input no
     1000                                                     ).
     1001     end.
     1002   end procedure.
     1003   procedure create-no-route :
     1004   define input parameter p-rec-ord as integer no-undo .
     1005   define input parameter p-db-num as integer no-undo .
     1006   define buffer buf_temp-no-route for temp-no-route.
     1007   do
     1008   on error undo, return error
     1009   :
     1010      find first buf_temp-no-route where
     1011                 buf_temp-no-route.rec-ord = p-rec-ord
     1012              and buf_temp-no-route.db-num = p-db-num no-error .
     1013      if not available buf_temp-no-route then do:
     1014        create buf_temp-no-route.
     1015        assign
     1016        buf_temp-no-route.rec-ord = p-rec-ord
     1017        buf_temp-no-route.db-num = p-db-num
     1018        .
     1019      end.
     1020   end.
     1021   end procedure.
     1022   procedure clear-from-rec-ord :
     1023   define input parameter p-rec-ord as integer no-undo .
     1024   define buffer buf_temp-no-route for temp-no-route.
     1025   define buffer buf_temp-smart-link for temp-smart-link.
     1026   do
     1027   on error undo, return error
     1028   :
     1029   for each buf_temp-no-route where
     1030           buf_temp-no-route.rec-ord > p-rec-ord:
     1031     delete buf_temp-no-route.
     1032   end.
     1033   for each buf_temp-smart-link where
     1034           buf_temp-smart-link.rec-ord > p-rec-ord:
     1035      delete buf_temp-smart-link.
     1036   end.
     1037   end.
     1038   end procedure.
