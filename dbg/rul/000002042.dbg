     1078   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   FUNCTION rum-fn_get-next-file-name returns character (
     1080                                       input p-base-file-name as character
     1081                                     , input p-index as integer):
     1082   define variable v-loc-file-name as character no-undo .
     1083   v-loc-file-name = substitute("&1_&2.&3"
     1084                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1085                                                         then (r-index(p-base-file-name, ".") - 1)
     1086                                                         else length(p-base-file-name)
     1087                                                         )
     1088                                           )
     1089                               ,p-index
     1090                               ,(if r-index(p-base-file-name, ".") > 1
     1091                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1092                                 else '')
     1093                                 )
     1094                                 .
     1095   return v-loc-file-name.
     1096   end function.
     1097   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   define variable v-current-doc-code as character no-undo .
     1099   define variable v-current-host-code as integer no-undo .
     1100   define variable v-current-obj-type as character no-undo .
     1101   define variable v-current-obj-code as integer no-undo .
     1102   define variable v-current-lock as integer no-undo .
     1103   define variable v-current-wait as integer no-undo .
     1104   define variable v-save as integer no-undo .
     1105   define variable log-file-name                as character      no-undo init "calc-ord.txt".
     1106   define variable v-view-log                   as logical        no-undo .
     1107   define variable v-stop                       as logical        no-undo .
     1108   define variable v-current-db-num as integer no-undo .
     1109   define variable v-last-error-message as character no-undo .
     1110   define variable file-name as char.
     1111   define variable v-sign as integer no-undo .
     1112   define variable num-rec as integer no-undo .
     1113   define variable num-rec-ok as integer no-undo .
     1114   define variable v-type as character no-undo .
     1115   define variable v-es as logical no-undo .
     1116   define variable v-esm as character no-undo .
     1117   define variable v-rv as character no-undo .
     1118   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1119   procedure write-to-screen :
     1120   define input param p-str as character no-undo .
