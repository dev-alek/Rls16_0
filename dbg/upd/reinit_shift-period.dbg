      591   procedure placelib_write-attr:
      592   define input  parameter p-code     like ub.place-attr.attr-code .
      593   define input  parameter p-obj-code like ub.place-attr.obj-code .
      594   define input  parameter p-obj-type like ub.place-attr.obj-type .
      595   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      596   define input  parameter p-value    like ub.place-attr.attr-value .
      597   define output parameter p-ok       as logical.
      598   define buffer buf_place-attr for ub.place-attr .
      599     do on error undo, return error return-value :
      600        p-ok = false.
      601        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      602                                                   and buf_place-attr.obj-code    = p-obj-code
      603                                                   and buf_place-attr.obj-type    = p-obj-type
      604                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      605        if not available buf_place-attr then do :
      606           create buf_place-attr.
      607           assign
      608             buf_place-attr.attr-code   = p-code
      609             buf_place-attr.attr-value  = p-value
      610             buf_place-attr.obj-code    = p-obj-code
      611             buf_place-attr.obj-type    = p-obj-type
      612             buf_place-attr.pl-code     = p-pl-code
      613           .
      614           p-ok = true.
      615        end.
      616        else do:
      617           buf_place-attr.attr-value  = p-value .
      618           p-ok = true.
      619        end.
      620     end.
      621   end.
      622   procedure placelib_get-attr:
      623   define input  parameter  p-code     like ub.place-attr.attr-code .
      624   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      625   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      626   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      627   define output parameter  p-value    like ub.place-attr.attr-value .
      628   define output parameter  p-ok       as logical.
      629   define buffer buf_place-attr for ub.place-attr .
      630     do on error undo, return error return-value :
      631        p-ok = false.
      632        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      633                                                   and buf_place-attr.obj-code    = p-obj-code
      634                                                   and buf_place-attr.obj-type    = p-obj-type
      635                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      636        if available buf_place-attr then do :
      637          p-value = buf_place-attr.attr-value.
      638          p-ok = true.
      639        end.
      640        else do :
      641          p-ok = false.
      642        end.
      643     end.
      644   end.
      645   procedure placelib_del-attr:
      646   define input parameter  p-code     like ub.place-attr.attr-code .
      647   define input parameter  p-obj-code like ub.place-attr.obj-code .
      648   define input parameter  p-obj-type like ub.place-attr.obj-type .
      649   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      650   define input parameter  p-value    like ub.place-attr.attr-value .
      651   define output parameter p-ok       as logical.
      652   define buffer buf_place-attr for ub.place-attr .
      653     do on error undo, return error return-value :
      654        p-ok = false.
      655        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      656                                                   and buf_place-attr.obj-code    = p-obj-code
      657                                                   and buf_place-attr.obj-type    = p-obj-type
      658                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      659        if available buf_place-attr then do :
      660           delete buf_place-attr.
      661           p-ok = true.
      662        end.
      663     end.
      664   end.
      665   define buffer buf_shift-period for ub.shift-period .
      666   define buffer buf_place for ub.place .
      667   define buffer buf_pl-gds for ub.pl-gds .
      668   define variable place-list as character no-undo .
      669   define variable v-value as character no-undo .
      670   define variable par-type as character no-undo .
      671   define variable v-ok as logical no-undo .
      672   place_ :
      673   for each buf_place no-lock :
      674     find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
      675     if not available buf_pl-gds then next place_ .
      676       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      677       (input  buf_pl-gds.gds-code
      678       ,input  'fuel-type':U
      679       ,output v-value
      680       ,output par-type) no-error.
      681     if v-value = "lgas"
      682     or v-value = "metan"
      683     or v-value = "propan"
      684     then next place_ .
      685     run placelib_get-attr  ( input "place-com-tanks"
      686                             ,input buf_place.obj-code
      687                             ,input buf_place.obj-type
      688                             ,input buf_place.pl-code
      689                             ,output v-value
      690                             ,output v-ok      ) no-error.
      691     if v-ok
      692     and v-value > ""
      693     then do :
      694       run placelib_get-attr  ( input "place-is-main"
      695                               ,input buf_place.obj-code
      696                               ,input buf_place.obj-type
      697                               ,input buf_place.pl-code
      698                               ,output v-value
      699                               ,output v-ok      ) no-error.
      700       if v-ok
      701       and v-value > ""
      702       and logical(v-value)
      703       then do :
      704       end .
      705       else do :
      706         next place_ .
      707       end .
      708     end .
      709     find first buf_shift-period no-lock where buf_shift-period.obj-type = buf_place.obj-type
      710                                           and buf_shift-period.obj-code = buf_place.obj-code
      711                                           and buf_shift-period.gds-code = buf_pl-gds.gds-code
      712                                           and buf_shift-period.pl-code  = buf_pl-gds.pl-code
      713     no-error .
      714     if not available buf_shift-period
      715     then do :
      716       assign place-list = place-list + string(recid(buf_place)) + "," .
      717     end .
      718   end .
      719   place-list = trim(place-list, ",") .
      720   if place-list > ""
      721   then do :
      722     run utl/init-shift-period.p (input place-list) .
      723   end .
      724   oOk = true.
