        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define input  parameter parparentproc as handle no-undo.
       18   define input  parameter iparam        as character no-undo.
       19   define output parameter oOk           as logical no-undo.
       20   define buffer buf_thbj-attr for thbj-attr.
       21   if g#db-num eq 0
       22   then do:
       23      for each db no-lock:
       24         find first thbj-attr where thbj-attr.upper-prop-code eq 'gisMT':U
       25                              and thbj-attr.obj-type        eq 'ад':U
       26                              and thbj-attr.obj-code        eq db.db-num
       27                              and thbj-attr.prop-code       ne ""
       28         no-lock no-error.
       29         if avail thbj-attr then do:
       30            find first thbj-attr where thbj-attr.upper-prop-code eq 'gisMT':U
       31                              and thbj-attr.obj-type        eq 'ад':U
       32                              and thbj-attr.obj-code        eq db.db-num
       33                              and thbj-attr.prop-code       eq 'crashSituat':U
       34               no-lock no-error.
       35            if not avail thbj-attr then do:
       36               find first buf_thbj-attr where buf_thbj-attr.upper-prop-code eq 'gisMT':U
       37                              and buf_thbj-attr.obj-type    eq ""
       38                              and buf_thbj-attr.obj-code    eq 0
       39                              and buf_thbj-attr.prop-code   eq 'crashSituat':U
       40                  no-lock no-error.
       41               if avail buf_thbj-attr then do:
       42                   do transaction:
       43                       create thbj-attr.
       44                       assign
       45                          thbj-attr.obj-type = 'ад':U
       46                          thbj-attr.obj-code = db.db-num
       47                          .
       48                       buffer-copy buf_thbj-attr except obj-type obj-code to thbj-attr.
       49                   end.
       50               end.
       51            end.
       52         end.
       53      end.
       54   end.
       55   oOk = true.
