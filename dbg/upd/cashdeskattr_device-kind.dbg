        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter iparam        as character no-undo.
        4   define output parameter oOk           as logical no-undo.
        5   define buffer buf_cash-desk for ub.cash-desk .
        6   define buffer buf_cash-desk-attr for ub.cash-desk-attr .
        7   DISABLE TRIGGERS FOR Load OF buf_cash-desk.
        8   DISABLE TRIGGERS FOR Load OF buf_cash-desk-attr
        9   .
       10   for each buf_cash-desk exclusive-lock:
       11       for first buf_cash-desk-attr exclusive-lock where
       12       buf_cash-desk-attr.attr-code = "device-kind" and
       13       buf_cash-desk-attr.db-num = buf_cash-desk.db-num and
       14       buf_cash-desk-attr.obj-code = buf_cash-desk.obj-code and
       15       buf_cash-desk-attr.pos-type = buf_cash-desk.pos-type and
       16       buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num and
       17       buf_cash-desk-attr.upper-attr-code = buf_cash-desk.pos-type + "_operative":U:
       18       buf_cash-desk.device-kind = buf_cash-desk-attr.attr-value-integer .
       19       delete buf_cash-desk-attr .
       20       end.
       21   end.
       22      oOk = yes.
