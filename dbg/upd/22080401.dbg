        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   procedure cur-time :
        8      define output parameter p-today as date      no-undo .
        9      define output parameter p-time  as integer   no-undo .
       10     do
       11     on error undo, return error
       12     :
       13       define variable v-date1 as date      no-undo .
       14       define variable v-date2 as date      no-undo .
       15       define variable v-time  as integer   no-undo .
       16       assign
       17         v-date1 = today
       18         v-time  = time
       19         v-date2 = today
       20       .
       21       if v-date1 <> v-date2
       22       then do:
       23         assign
       24           v-date1 = today
       25           v-time  = v-time
       26         .
       27       end.
       28       assign
       29         p-today = v-date1
       30         p-time  = v-time
       31       .
       32     end.
       33   end.
       34   function cur-time-date returns character
       35   :
       36     return string(today, '99/99/9999':U) .
       37   end.
       38   function cur-time-mjd returns decimal
       39   :
       40     define variable v-date as date      no-undo .
       41     define variable v-time as integer   no-undo .
       42     run cur-time in this-procedure
       43       (output v-date
       44       ,output v-time
       45       ) .
       46     return integer(v-date) - 2400002 + (v-time / 86400) .
       47   end.
       48   function cur-time-get-ending-index returns integer
       49   (input p-number as integer
       50   )
       51   :
       52     if p-number < 0
       53     or p-number = ?
       54     then do:
       55       return 1 .
       56     end.
       57     define variable v-rest as integer   no-undo .
       58     assign
       59       p-number = p-number modulo 100
       60     .
       61     if p-number < 20
       62     then do:
       63       assign
       64         v-rest = p-number
       65       .
       66     end.
       67     else do:
       68       assign
       69         v-rest = p-number modulo 10
       70       .
       71     end.
       72     case v-rest :
       73       when 1
       74       then do:
       75         return 2 .
       76       end.
       77       when 2 or
       78       when 3 or
       79       when 4
       80       then do:
       81         return 3 .
       82       end.
       83       otherwise do:
       84         return 1 .
       85       end.
       86     end case .
       87   end.
       88   procedure cur-time-mjd-to-date :
       89      define input  parameter i-mjd-diff as decimal no-undo.
       90      define output parameter o-Date     as date    no-undo.
       91      define output parameter o-Time     as integer no-undo.
       92      define variable v-day-number as integer   no-undo .
       93      if    i-mjd-diff < 0
       94         or i-mjd-diff = ?
       95      then do:
       96         return "?" .
       97      end.
       98      assign
       99         v-day-number = truncate(i-mjd-diff,0).
      100         o-Date = date(v-day-number + 2400002).
      101         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      102     .
      103   end.
      104   function cur-time-mjd-to-string returns character
      105   (input p-mjd-diff as decimal
      106   )
      107   :
      108     define variable v-day-number as integer   no-undo .
      109     define variable v-seconds    as integer   no-undo .
      110     define variable v-hour       as integer   no-undo .
      111     define variable v-min        as integer   no-undo .
      112     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      113     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      114     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      115     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      116     if p-mjd-diff < 0
      117     or p-mjd-diff = ?
      118     then do:
      119       return "?" .
      120     end.
      121     assign
      122       v-day-number = integer(truncate(p-mjd-diff,0))
      123       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      124     .
      125     if v-seconds > 86400
      126     then do:
      127       assign
      128         v-seconds = 86400 - 1
      129       .
      130     end.
      131     if v-seconds < 0
      132     then do:
      133       assign
      134         v-seconds = 0
      135       .
      136     end.
      137     assign
      138       v-hour = truncate(v-seconds / 3600, 0)
      139     .
      140     assign
      141       v-seconds = v-seconds modulo 3600
      142     .
      143     assign
      144       v-min = truncate(v-seconds / 60, 0)
      145     .
      146     assign
      147       v-seconds = v-seconds modulo 60
      148     .
      149     return
      150         (if v-day-number <> 0
      151           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      152           else ""
      153         )
      154       + (if v-day-number <> 0 or v-hour <> 0
      155           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      156           else ""
      157         )
      158       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      159           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      160           else ""
      161         )
      162       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      163       .
      164   end.
      165   function cur-time-string returns character
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      174   end.
      175   function cur-time-string-sec returns character
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      184   end.
      185   function cur-time-custom  returns character
      186   (input p-prefix as character
      187   ,input p-date-format as character
      188   ,input p-delimiter as character
      189   ,input p-time-format as character
      190   ,input p-suffix as character
      191   )
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     run cur-time in this-procedure
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return
      200       p-prefix
      201       + string(v-date, p-date-format)
      202       + p-delimiter
      203       + string(v-time, p-time-format)
      204       + p-suffix
      205       .
      206   end.
      207   function cur-time-print  returns character
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     run cur-time in this-procedure
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      216   end.
      217   function cur-time-datetime returns datetime
      218   :
      219     define variable v-char as character no-undo .
      220     define variable v-datetime as datetime no-undo .
      221     v-char = cur-time-string().
      222     v-datetime = datetime(v-char).
      223     return  v-datetime.
      224   end.
      225   function cur-time-string-msec returns character
      226   :
      227     define variable v-date as datetime  no-undo .
      228     v-date = now.
      229     return string(v-date) .
      230   end.
      231   run syper-adm-set.
      232   run password-time-set.
      233   procedure syper-adm-set:
      234      define variable vBufUserLogin       as handle no-undo.
      235      define variable vBufUserAccaunt     as handle no-undo.
      236      define variable vBufUserAccauntAttr as handle no-undo.
      237      create buffer vBufUserLogin for table "user-login".
      238      vBufUserLogin:find-first ("where user-login.db-num eq 0 and user-login.user-login = 'адм':U and user-login.user-administrator and user-login.status_    = 0" , no-lock) no-error.
      239      if vBufUserLogin:available
      240      then do:
      241         define variable vuser-id as character no-undo.
      242         vuser-id = vBufUserLogin:buffer-field ("user-id"):buffer-value ().
      243         create buffer vBufUserAccaunt for table "user-account".
      244         vBufUserAccaunt:find-first (substitute ("where user-account.user-id = '&1' and user-account.status_ eq 0 ",vuser-id) , no-lock)no-error.
      245         if vBufUserAccaunt:available
      246         then do transaction:
      247            create buffer vBufUserAccauntAttr for table "user-account-attr".
      248            vBufUserAccauntAttr:find-first (substitute ("where user-account-attr.user-id = '&1' and user-account-attr.attr-code  eq 'superadm'",vuser-id) , exclusive-lock) no-error.
      249            if not vBufUserAccauntAttr:available
      250            then do:
      251               vBufUserAccauntAttr:buffer-create ().
      252               vBufUserAccauntAttr:buffer-field ("user-id"  ):buffer-value () = vuser-id.
      253               vBufUserAccauntAttr:buffer-field ("attr-code"):buffer-value () = "superadm".
      254            end.
      255            vBufUserAccauntAttr:buffer-field ("attr-value"  ):buffer-value ()  = "yes".
      256            vBufUserAccauntAttr:buffer-release ().
      257            delete object vBufUserAccauntAttr.
      258         end.
      259         delete object vBufUserAccaunt.
      260      end.
      261      delete object vBufUserLogin.
      262   end.
      263   procedure password-time-set:
      264      define variable vBufUserLogin   as handle no-undo.
      265      define variable vBufUserAccaunt as handle no-undo.
      266      define variable vBufSysCtrl     as handle no-undo.
      267      define variable vQuery          as handle no-undo.
      268      create buffer vBufSysCtrl for table "sys-ctrl".
      269      vBufSysCtrl:find-first ("" , no-lock) no-error.
      270      if vBufSysCtrl:available
      271      then do:
      272         create buffer vBufUserLogin for table "user-login".
      273         create query vQuery.
      274         vQuery:set-buffers(vBufUserLogin).
      275         vQuery:query-prepare(substitute ("preselect each user-login where user-login.db-num eq &1 and user-login.status_ = 0 and (user-login.user-password-set-mjd eq 0 or user-login.user-password-set-mjd eq ?) no-lock",
      276                                          vBufSysCtrl:buffer-field ("db-num"):buffer-value ()
      277                                          )
      278                              ).
      279         vQuery:query-open().
      280         vQuery:get-first().
      281         do while vBufUserLogin:available:
      282            do transaction:
      283               vBufUserLogin:find-current (exclusive-lock).
      284               vBufUserLogin:buffer-field ("user-password-set-mjd"):buffer-value () = cur-time-mjd().
      285               vBufUserLogin:buffer-release ().
      286            end.
      287            vQuery:get-next().
      288         end.
      289         vQuery:query-close().
      290         delete object vQuery.
      291         delete object vBufUserLogin.
      292      end.
      293      delete object vBufSysCtrl.
      294   end.
