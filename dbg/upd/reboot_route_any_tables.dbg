        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure gen-key-rec :
       68     define input  parameter p-tbl-name    as character no-undo.
       69     define input  parameter p-bh_tbl-name as handle    no-undo.
       70     define output parameter p-key-rec     as character no-undo.
       71     do
       72     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       73     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       74     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       75     :
       76       define variable fh               as handle    no-undo .
       77       define variable v-ok             as logical   no-undo .
       78       define variable v-inform         as character no-undo .
       79       define variable v-ind            as integer   no-undo .
       80       define variable v-idx-field-qnty as integer   no-undo .
       81       if p-tbl-name = ?
       82         or p-tbl-name = "":U
       83       then do:
       84         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       85       end.
       86       if not p-bh_tbl-name:available then do:
       87         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       88       end.
       89       assign
       90         p-key-rec = p-tbl-name
       91         v-inform  = p-bh_tbl-name:index-information(1)
       92         v-ind     = 2
       93       .
       94       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       95       on error undo, return error
       96       :
       97         assign
       98           v-inform = p-bh_tbl-name:index-information( v-ind )
       99           v-ind    = v-ind + 1
      100         .
      101       end.
      102       if v-inform = ?
      103         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      104         or entry( 3, v-inform, ",":U ) <> "1":U
      105       then do:
      106         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      107       end.
      108       else do:
      109         assign
      110           v-idx-field-qnty = num-entries( v-inform ) - 4
      111         .
      112         if v-idx-field-qnty < 2 then do:
      113           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      114         end.
      115         do v-ind = 1 to v-idx-field-qnty by 2
      116         on error undo, return error
      117         :
      118           assign
      119             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      120             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      121           .
      122         end.
      123       end.
      124       if p-key-rec = ? then do:
      125         assign
      126           p-key-rec = "":U
      127         .
      128         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      129       end.
      130     end.
      131     return.
      132   end procedure.
      133   procedure gen-where-keyr-tab :
      134     define input  parameter i-tableSerach as character no-undo.
      135     define input  parameter i-tablekey   as character  no-undo.
      136     define input  parameter p-key-rec    as character  no-undo.
      137     define input  parameter p-key-handle as handle     no-undo .
      138     define input  parameter p-db-name    as character  no-undo .
      139     define input  parameter p-tt-handle  as handle     no-undo .
      140     define output parameter o-Where      as character  no-undo.
      141     do
      142     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      143     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      144     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      145     :
      146       define variable v-full-tbl-name  as character no-undo .
      147       define variable bh_tbl-name      as handle    no-undo .
      148       define variable fh_key           as handle    no-undo .
      149       define variable fh_search        as handle    no-undo .
      150       define variable v-field-num      as integer   no-undo .
      151       define variable v-count-fld      as integer   no-undo .
      152       define variable v-inform         as character no-undo .
      153       define variable v-ind            as integer   no-undo .
      154       define variable v-idx-field-qnty as integer   no-undo .
      155       define variable v-field-name     as character no-undo .
      156       define variable v-field-val      as character no-undo .
      157       define variable v-word-link      as character no-undo .
      158       define variable vTable           as character no-undo.
      159       define variable bh_tbl-key       as handle    no-undo .
      160       assign
      161         p-key-rec = trim( p-key-rec )
      162       .
      163       if p-key-handle <> ? then do:
      164         if not valid-handle(p-key-handle)
      165            or p-key-handle:type <> "buffer"
      166         then do:
      167           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      168         end.
      169         if num-entries( p-key-rec, chr(3) ) > 1
      170           or p-key-rec = ?
      171           or p-key-rec = "":U
      172         then do:
      173           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      174         end.
      175       end.
      176       else do:
      177         if p-key-rec = ?
      178           or p-key-rec = "":U
      179         then do:
      180           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      181         end.
      182       end.
      183       assign
      184         vTable = entry( 1 , p-key-rec, chr(3) )
      185       .
      186       if p-tt-handle <> ?
      187         and ( not valid-handle(p-tt-handle)
      188               or p-tt-handle:type <> "buffer"
      189             )
      190       then do:
      191         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      192       end.
      193       if p-tt-handle = ? then do:
      194         assign
      195           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      196         .
      197         create buffer bh_tbl-name for table v-full-tbl-name .
      198       end.
      199       else do:
      200         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      201       end.
      202       assign
      203         v-inform = bh_tbl-name:index-information(1)
      204         v-ind    = 2
      205       .
      206       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      207       on error undo, return error
      208       :
      209         assign
      210           v-inform = bh_tbl-name:index-information( v-ind )
      211           v-ind    = v-ind + 1
      212         .
      213       end.
      214       if v-inform = ?
      215         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      216         or entry( 3, v-inform, ",":U ) <> "1":U
      217       then do:
      218         delete object bh_tbl-name no-error.
      219         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      220       end.
      221       assign
      222         v-idx-field-qnty = num-entries( v-inform ) - 4
      223       .
      224       if v-idx-field-qnty < 2 then do:
      225         delete object bh_tbl-name no-error.
      226         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      227       end.
      228       assign
      229         o-where     = "where":U
      230         v-word-link = "":U
      231         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      232         v-count-fld = 0
      233       .
      234       if i-tablekey ne "" and i-tablekey ne ?
      235       then do:
      236         assign
      237           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      238         .
      239         create buffer bh_tbl-key for table v-full-tbl-name .
      240       end.
      241       if i-tableSerach ne "" and i-tableSerach ne ?
      242       then do:
      243         delete object bh_tbl-name no-error.
      244         assign
      245           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      246         .
      247         create buffer bh_tbl-name for table v-full-tbl-name .
      248       end.
      249       block_where:
      250       do v-ind = 1 to v-idx-field-qnty by 2
      251       on error undo, return error
      252       :
      253         assign
      254           v-count-fld = v-count-fld + 1
      255         .
      256         if p-key-handle = ?
      257           and v-count-fld > v-field-num
      258         then do:
      259           leave block_where.
      260         end.
      261         define variable VfieldKeyTable as handle no-undo.
      262         assign
      263           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      264           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      265         .
      266         if     bh_tbl-key ne ?
      267         then do:
      268            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      269            if VfieldKeyTable eq ?
      270            then next block_where.
      271         end.
      272         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      273         then
      274            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      275         else
      276            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      277         if p-key-handle = ? then do:
      278           assign
      279             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      280           .
      281         end.
      282         else do:
      283           assign
      284             fh_key = p-key-handle:buffer-field( v-field-name )
      285           .
      286           if fh_key = ?
      287             or not valid-handle( fh_key )
      288           then do:
      289             delete object bh_tbl-name.
      290             if     bh_tbl-key ne ?
      291             then
      292                delete object bh_tbl-key.
      293             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      294           end.
      295           assign
      296             v-field-val = fh_key:buffer-value
      297           .
      298         end.
      299         if fh_search:data-type ="character":U then do:
      300           assign
      301             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      302             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      303             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      304             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      305             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      306             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      307             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      308             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      309             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      310             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      311             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      312             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      313             v-field-val = substitute( '"&1"', v-field-val )
      314           .
      315         end.
      316         assign
      317           o-where = substitute( "&1 &2", o-where, v-field-val )
      318         .
      319         if v-word-link = "":U then do:
      320           assign
      321             v-word-link = "and":U
      322           .
      323         end.
      324       end.
      325       delete object bh_tbl-name.
      326       if     bh_tbl-key ne ?
      327       then
      328          delete object bh_tbl-key.
      329       if p-key-handle = ?
      330         and v-count-fld <> v-field-num
      331       then do:
      332         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      333       end.
      334     end.
      335   end procedure.
      336   procedure gen-hn-keyr-tab :
      337     define input  parameter i-tableSerach as character no-undo.
      338     define input  parameter i-tablekey   as character no-undo.
      339     define input  parameter p-key-rec    as character no-undo.
      340     define input  parameter p-key-handle as handle    no-undo .
      341     define input  parameter p-db-name    as character no-undo .
      342     define input  parameter p-tt-handle  as handle    no-undo .
      343     define input  parameter p-stts-lock  as integer   no-undo .
      344     define output parameter o-hn         as handle    no-undo.
      345     define variable v-full-tbl-name as character no-undo.
      346     define variable v-where         as character no-undo.
      347     define variable bh_tbl-name     as handle    no-undo.
      348     define variable vTable          as character no-undo.
      349     do
      350     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      351     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      352     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      353         run gen-where-keyr-tab(i-tableSerach,
      354                                i-tablekey,
      355                                p-key-rec,
      356                                p-key-handle,
      357                                p-db-name,
      358                                p-tt-handle,
      359                                output v-where).
      360         if i-tableSerach ne "" and i-tableSerach ne ?
      361         then do:
      362            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      363            create buffer bh_tbl-name for table v-full-tbl-name .
      364         end.
      365         else do:
      366            if p-tt-handle = ? then do:
      367               assign
      368                  vTable = entry( 1 , p-key-rec, chr(3) )
      369               .
      370               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      371               create buffer bh_tbl-name for table v-full-tbl-name .
      372            end.
      373            else do:
      374               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      375            end.
      376         end.
      377         if p-tt-handle = ? then do:
      378            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      379         end.
      380         else do:
      381            bh_tbl-name:find-first( v-where ) no-error .
      382         end.
      383         o-hn = bh_tbl-name.
      384      end.
      385   end procedure.
      386   procedure gen-hn-keyr :
      387     define input  parameter p-key-rec    as character no-undo.
      388     define input  parameter p-key-handle as handle    no-undo .
      389     define input  parameter p-db-name    as character no-undo .
      390     define input  parameter p-tt-handle  as handle    no-undo .
      391     define input  parameter p-stts-lock  as integer   no-undo .
      392     define output parameter o-hn         as handle    no-undo.
      393     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      394   end.
      395   procedure gen-row-keyr :
      396     define input  parameter p-key-rec    as character no-undo.
      397     define input  parameter p-key-handle as handle    no-undo .
      398     define input  parameter p-db-name    as character no-undo .
      399     define input  parameter p-tt-handle  as handle    no-undo .
      400     define input  parameter p-stts-lock  as integer   no-undo .
      401     define output parameter p-tbl-row    as rowid     no-undo.
      402     define output parameter p-tbl-name   as character no-undo.
      403     define variable vHn as handle no-undo.
      404       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      405       p-tbl-row = if vHn:available then vHn:rowid else ?.
      406       p-tbl-name =  vHn:table.
      407       delete object vHn no-error.
      408     if p-tbl-row = ? then do:
      409       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      410     end.
      411     else do:
      412       return.
      413     end.
      414   end procedure.
      415   procedure gen-key-fv :
      416     define input  parameter p-key-rec    as character no-undo .
      417     define output parameter p-field-list as character no-undo .
      418     define output parameter p-value-list as character no-undo.
      419     do
      420     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      421     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      422     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      423     :
      424       define variable v-full-tbl-name  as character no-undo .
      425       define variable bh_tbl-name      as handle    no-undo .
      426       define variable v-tbl-name       as character no-undo .
      427       define variable v-field-num      as integer   no-undo .
      428       define variable v-count-fld      as integer   no-undo .
      429       define variable v-inform         as character no-undo .
      430       define variable v-ind            as integer   no-undo .
      431       define variable v-idx-field-qnty as integer   no-undo .
      432       define variable v-delim-key      as character no-undo .
      433       if p-key-rec = ?
      434         or p-key-rec = "":U
      435       then do:
      436         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      437       end.
      438       assign
      439         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      440         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      441       .
      442       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      443       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      444       assign
      445         v-inform = bh_tbl-name:index-information(1)
      446         v-ind    = 2
      447       .
      448       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      449       on error undo, return error
      450       :
      451         assign
      452           v-inform = bh_tbl-name:index-information( v-ind )
      453           v-ind    = v-ind + 1
      454         .
      455       end.
      456       if v-inform = ?
      457         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      458         or entry( 3, v-inform, ",":U ) <> "1":U
      459       then do:
      460         delete object bh_tbl-name no-error.
      461         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      462       end.
      463       assign
      464         v-idx-field-qnty = num-entries( v-inform ) - 4
      465       .
      466       if v-idx-field-qnty < 2 then do:
      467         delete object bh_tbl-name no-error.
      468         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      469       end.
      470       assign
      471         p-field-list = "":U
      472         p-value-list = "":U
      473         v-delim-key  = "":U
      474         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      475         v-count-fld  = 0
      476       .
      477       block_where:
      478       do v-ind = 1 to v-idx-field-qnty by 2
      479       on error undo, return error
      480       :
      481         assign
      482           v-count-fld = v-count-fld + 1
      483         .
      484         if v-count-fld > v-field-num then do:
      485           leave block_where.
      486         end.
      487         assign
      488           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      489           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      490         .
      491         if v-ind = 1 then do:
      492           assign
      493             v-delim-key = chr(3)
      494           .
      495         end.
      496       end.
      497       delete object bh_tbl-name.
      498       if v-count-fld <> v-field-num then do:
      499         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      500       end.
      501     end.
      502   end procedure.
      503   procedure gen-key-field :
      504     define input  parameter p-table      as character no-undo .
      505     define output parameter p-field-list as character no-undo .
      506     do
      507     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      508     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      509     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      510     :
      511       define variable v-full-tbl-name  as character no-undo .
      512       define variable bh_tbl-name      as handle    no-undo .
      513       define variable v-tbl-name       as character no-undo .
      514       define variable v-field-num      as integer   no-undo .
      515       define variable v-count-fld      as integer   no-undo .
      516       define variable v-inform         as character no-undo .
      517       define variable v-ind            as integer   no-undo .
      518       define variable v-idx-field-qnty as integer   no-undo .
      519       define variable v-delim-key      as character no-undo .
      520       if p-table = ?
      521         or p-table = "":U
      522       then do:
      523         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      524       end.
      525       assign
      526         v-tbl-name      = p-table
      527         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      528       .
      529       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      530       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      531       assign
      532         v-inform = bh_tbl-name:index-information(1)
      533         v-ind    = 2
      534       .
      535       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      536       on error undo, return error
      537       :
      538         assign
      539           v-inform = bh_tbl-name:index-information( v-ind )
      540           v-ind    = v-ind + 1
      541         .
      542       end.
      543       if v-inform = ?
      544         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      545         or entry( 3, v-inform, ",":U ) <> "1":U
      546       then do:
      547         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      548       end.
      549       assign
      550         v-idx-field-qnty = num-entries( v-inform ) - 4
      551       .
      552       if v-idx-field-qnty < 2 then do:
      553         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      554       end.
      555       assign
      556         p-field-list = "":U
      557         v-delim-key  = "":U
      558         v-count-fld  = 0
      559       .
      560       block_where:
      561       do v-ind = 1 to v-idx-field-qnty by 2
      562       on error undo, return error
      563       :
      564         assign
      565           v-count-fld = v-count-fld + 1
      566         .
      567         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      568         if v-ind = 1 then do:
      569           assign
      570             v-delim-key = chr(3)
      571           .
      572         end.
      573       end.
      574       delete object bh_tbl-name.
      575     end.
      576   end procedure.
      577   define input  parameter parparentproc as handle no-undo.
      578   define input  parameter iparam        as character no-undo.
      579   define output parameter oOk           as logical no-undo.
      580   define temp-table ttrecid no-undo
      581     field tableName as character
      582     field inumtab as int
      583     field reckey as character
      584     index pi inumtab reckey
      585   .
      586   define variable vi     as integer no-undo.
      587   define variable vv     as integer no-undo.
      588   define variable vTables as character no-undo.
      589   define variable vtable as character no-undo.
      590   define variable vHn as handle no-undo.
      591   vTables = entry(2,iparam,chr(4)).
      592   do trans:
      593     do vi = 1 to num-entries (vTables,"|"):
      594        vtable = entry(vi,vTables,"|").
      595        for each route where route.name-rec eq vtable exclusive-lock:
      596            find first ttrecid where ttrecid.inumtab eq vi
      597                                 and ttrecid.reckey eq route.uniq-key-rec
      598            no-error.
      599            if not available ttrecid
      600            then do:
      601               create  ttrecid.
      602               assign
      603                  ttrecid.inumtab = vi
      604                  ttrecid.reckey  = route.uniq-key-rec
      605                  ttrecid.tableName = route.name-rec
      606               .
      607            end.
      608            delete route.
      609         end.
      610      end.
      611      for each ttrecid:
      612         run gen-hn-keyr(input ttrecid.reckey,input ?,input "ub" , input ? ,input no-lock , output vHn).
      613         if vHn:available
      614         then do:
      615            run str\callnews.p (ttrecid.tableName, vHn) no-error.
      616            if error-status:error then
      617            do:
      618              message
      619               substitute("Ошибка при обновлении записи &1 таблицы &2.", ttrecid.reckey, ttrecid.tableName) skip
      620               error-status :get-message ( 1 ) skip
      621               "Обратитесь к разработчику!"
      622              view-as alert-box.
      623              undo, return error "Ошибка при выполнении reboot_route_any_tables.p".
      624            end.
      625         end.
      626         else
      627            message "Беда нет записи " ttrecid.reckey
      628            view-as alert-box.
      629         delete object vHn no-error.
      630      end.
      631   end.
      632   oOk = true.
