        1   block-level on error undo, throw.
        2   define input  parameter iParam as character no-undo.
        3   define output parameter oOK as logical no-undo.
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define variable vBufUserLogin as handle no-undo.
        9   define variable vBufSysCtrl     as handle no-undo.
       10   create buffer vBufSysCtrl for table "sys-ctrl".
       11   vBufSysCtrl:find-first ("" , no-lock) no-error.
       12   if vBufSysCtrl:available
       13   then do:
       14      create buffer vBufUserLogin for table "user-login".
       15      vBufUserLogin:find-first (substitute ("where user-login.db-num eq &1 and user-login.status_    = 0 and (user-login.user-password-set-mjd eq 0 or user-login.user-password-set-mjd eq ?)",
       16                                            vBufSysCtrl:buffer-field ("db-num"):buffer-value ()
       17                                           ),
       18                                no-lock) no-error.
       19      oOK = not vBufUserLogin:available.
       20   end.
       21   else
       22      oOK = true.
       23   delete object vBufSysCtrl.
