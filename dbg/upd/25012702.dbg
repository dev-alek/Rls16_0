        1   block-level on error undo, throw.
        2   define input  parameter iParam as character no-undo.
        3   define output parameter oOK as logical no-undo.
        4   define variable vBufSysCtrl as handle no-undo.
        5   define variable vBufPlace as handle no-undo.
        6   define variable vBufPlaceAttr as handle no-undo.
        7   define variable vBufPlGds as handle no-undo.
        8   define variable vBufGoodsAttr as handle no-undo.
        9   define variable vBufRvsLine as handle no-undo.
       10   create buffer vBufSysCtrl for table "sys-ctrl".
       11   vBufSysCtrl:find-first ("" , no-lock) no-error.
       12   if (vBufSysCtrl:available
       13   and vBufSysCtrl:buffer-field("db-num"):buffer-value() eq 0)
       14   or not vBufSysCtrl:available
       15   then do :
       16     oOK = true .
       17     delete object vBufSysCtrl .
       18     return .
       19   end .
       20   delete object vBufSysCtrl .
       21   create buffer vBufPlace for table "place" .
       22   vBufPlace:find-first ("" , no-lock) no-error.
       23   if vBufPlace:available
       24   then do:
       25     create buffer vBufPlaceAttr for table "place-attr" .
       26     vBufPlaceAttr:find-first ("where place-attr.attr-code eq 'init-shift-period-rvs'", no-lock) no-error.
       27     oOK = vBufPlaceAttr:available .
       28     delete object vBufPlaceAttr .
       29     if not oOK
       30     then do :
       31       create buffer vBufPlGds for table "pl-gds" .
       32       vBufPlGds:find-first (substitute ("where pl-gds.pl-code eq &1", vBufPlace:buffer-field("pl-code"):buffer-value), no-lock) no-error.
       33       if vBufPlGds:available
       34       then do :
       35         create buffer vBufGoodsAttr for table "goods-attr" .
       36         vBufGoodsAttr:find-first (substitute ("where goods-attr.attr-code eq 'fuel-type' and goods-attr.gds-code eq &1", vBufPlGds:buffer-field("gds-code"):buffer-value), no-lock) no-error.
       37         if vBufGoodsAttr:available
       38         then do :
       39           if vBufGoodsAttr:buffer-field("attr-value"):buffer-value = "lgas"
       40           or vBufGoodsAttr:buffer-field("attr-value"):buffer-value = "metan"
       41           or vBufGoodsAttr:buffer-field("attr-value"):buffer-value = "propan"
       42           then oOK = true .
       43         end .
       44         else
       45           oOK = true .
       46         delete object vBufGoodsAttr .
       47       end .
       48       else
       49         oOK = true .
       50       delete object vBufPlGds .
       51       create buffer vBufRvsLine for table "rvs-line" .
       52       vBufRvsLine:find-first (substitute ("where rvs-line.pl-code eq &1", vBufPlace:buffer-field("pl-code"):buffer-value), no-lock) no-error.
       53       if not vBufRvsLine:available
       54       then
       55         oOK = true .
       56       delete object vBufRvsLine .
       57     end .
       58   end .
       59   else
       60     oOK = true .
       61   delete object vBufPlace .
       62   find first _file no-lock where _file._file-name = "db"  no-error.
       63   if available _file
       64   then do:
       65     find first _field of _file where _field._Field-Name =  "reserve1-char" exclusive-lock no-error.
       66     if available (_field)
       67     then do :
       68       _field._initial = "45" .
       69       release _field.
       70     end .
       71     release _file.
       72   end .
