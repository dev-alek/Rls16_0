        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define input  parameter parparentproc as handle no-undo.
       18   define input  parameter iparam        as character no-undo.
       19   define output parameter oOk           as logical no-undo.
       20   define temp-table x_thbj-attr no-undo like ub.thbj-attr.
       21   function ThbjattrCr return logical
       22       (input p-prop-code as character,
       23        input p-prop-val as character,
       24        input p-prop-type as character):
       25       define variable vOk as logical no-undo.
       26       define buffer buf_thbj-attr for ub.thbj-attr.
       27       vOk = true.
       28       for each x_thbj-attr:
       29           if not can-find( first buf_thbj-attr no-lock where
       30                                  buf_thbj-attr.upper-prop-code eq 'gisMT':U
       31                              and buf_thbj-attr.obj-type        eq x_thbj-attr.obj-type
       32                              and buf_thbj-attr.obj-code        eq x_thbj-attr.obj-code
       33                              and buf_thbj-attr.prop-code       eq p-prop-code
       34                          )
       35           then do:
       36              create buf_thbj-attr.
       37              assign
       38                 buf_thbj-attr.obj-type = x_thbj-attr.obj-type
       39                 buf_thbj-attr.obj-code  = x_thbj-attr.obj-code
       40                 buf_thbj-attr.upper-prop-code = 'gisMT':U
       41                 buf_thbj-attr.prop-code = p-prop-code
       42                 buf_thbj-attr.prop-value-type = p-prop-type
       43                 no-error.
       44              if avail buf_thbj-attr then
       45              case p-prop-type:
       46                  when "character"
       47                     then buf_thbj-attr.property-value-character = p-prop-val.
       48                  when "decimal"
       49                     then  buf_thbj-attr.property-value-decimal = decimal(p-prop-val).
       50                  when "logical"
       51                     then  buf_thbj-attr.property-value-logical = logical(p-prop-val).
       52              end.
       53           end.
       54       end.
       55       return vOk.
       56   end.
       57   PROCEDURE ObjCodeList:
       58      define buffer buf_thbj-attr for ub.thbj-attr.
       59      for each buf_thbj-attr no-lock where
       60               buf_thbj-attr.upper-prop-code = 'gisMT':U
       61           and buf_thbj-attr.prop-code       = '' :
       62         if (g#db-num = 0 and
       63             (buf_thbj-attr.obj-type = 'ад':U or
       64             (buf_thbj-attr.obj-type = "" and buf_thbj-attr.obj-code = 0)))
       65             or
       66             (g#db-num <> 0 and
       67              buf_thbj-attr.obj-type = 'ад':U and
       68              buf_thbj-attr.obj-code = g#db-num)
       69         then do:
       70             find first x_thbj-attr where
       71                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type and
       72                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code no-error .
       73             if not available x_thbj-attr then do:
       74               create  x_thbj-attr.
       75               buffer-copy buf_thbj-attr to X_thbj-attr.
       76             end.
       77         end.
       78      end.
       79   END PROCEDURE.
       80   run ObjCodeList.
       81   oOk = ThbjattrCr('MaxApiToken':U,"","character").
       82   if oOk then
       83   oOk = ThbjattrCr ('AgeConfirm':U,"0","integer").
