        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define input  parameter parparentproc as handle no-undo.
       18   define input  parameter iparam        as character no-undo.
       19   define output parameter oOk           as logical no-undo.
       20   define variable mAddress  as character no-undo.
       21   define variable mCommand as character no-undo.
       22   define variable mIp     as character no-undo .
       23   define variable mPort   as character no-undo .
       24   define variable mLogin  as character no-undo .
       25   define variable mPass   as character no-undo .
       26   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
       27   mAddress = entry(lookup("Address",iparam,chr(4)) + 1,iParam,chr(4)).
       28   mCommand = entry(lookup("Command",iparam,chr(4)) + 1,iParam,chr(4)).
       29   function ChgV1 return logical
       30       (input p-obj-type as char,
       31        input p-obj-code as int) forward.
       32   if mCommand <> "" then
       33   do:
       34       run getSettingsGisMt in this-procedure.
       35       if mLogin = "" or mPass = ""
       36       then do:
       37          oOk = false.
       38          return error "Не заполнены логин и/или пароль в ЛМ ЧЗ".
       39       end.
       40       run runBatLmCHz in this-procedure (output oOk).
       41       if not oOk then
       42          return error "Возникала ошибка при установки ЛМ ЧЗ".
       43   end.
       44   if mAddress <> "" then
       45   do:
       46     oOk = ChgV1('БД':U,g#db-num).
       47     if oOk and g#db-num = 0 then oOk = ChgV1("",g#db-num).
       48   end.
       49   procedure runBatLmCHz:
       50       define output parameter oResult as logical no-undo.
       51       define variable vRunCmd as character no-undo.
       52       assign
       53         vRunCmd = replace(mCommand, "%Адрес прокси%",    mIp)
       54         vRunCmd = replace(vRunCmd, "%Порт прокси%",  mPort)
       55         vRunCmd = replace(vRunCmd, "%Логин ЛМ ЧЗ%", mLogin)
       56         vRunCmd = replace(vRunCmd, "%Пароль ЛМ ЧЗ%",  mPass)
       57       .
       58       os-command value (substitute ("&2 &1 exit" ,chr(38), vRunCmd)).
       59       oResult = os-error = 0.
       60   end procedure.
       61   procedure getSettingsGisMt:
       62       define variable vDbNum          as integer   no-undo.
       63       define variable vValueCharacter as character no-undo .
       64       define variable vValueDate      as date      no-undo .
       65       define variable vValueDecimal   as decimal   no-undo .
       66       define variable vValueInteger   as INTEGER   no-undo .
       67       define variable vValueLogical   as LOGICAL   no-undo .
       68       define variable vParamType      as character no-undo .
       69       define variable vBufferTT       as handle    no-undo .
       70       define buffer sys-ctrl for ub.sys-ctrl.
       71       find first sys-ctrl no-lock no-error.
       72       vDbNum = sys-ctrl.db-num.
       73       vBufferTT      = buffer temp-thbj-attr:table-handle .
       74       run adm/shattri.p (
       75             input "init":U
       76           , input 'БД':U
       77           , input vDbNum
       78           , input 'gisMT':U
       79           , input "":U
       80           , output vValueCharacter
       81           , output vValueDate
       82           , output vValueDecimal
       83           , output vValueInteger
       84           , output vValueLogical
       85           , output vParamType
       86           , input-output TABLE-HANDLE vBufferTT
       87           ) no-error .
       88       for first temp-thbj-attr where
       89                 temp-thbj-attr.prop-code = 'adressPort':U
       90       :
       91         if temp-thbj-attr.property-value-character <> "" then
       92         do:
       93           mIp   = entry(1,temp-thbj-attr.property-value-character,":").
       94           mPort = if num-entries(temp-thbj-attr.property-value-character,":") > 1
       95                   then entry(2,temp-thbj-attr.property-value-character,":") else "".
       96         end.
       97       end.
       98       for first temp-thbj-attr where
       99                 temp-thbj-attr.prop-code = 'OflineLogin':U
      100       :
      101         mLogin = temp-thbj-attr.property-value-character.
      102       end.
      103       for first temp-thbj-attr where
      104                 temp-thbj-attr.prop-code = 'OflinePswd':U
      105       :
      106         mPass  = temp-thbj-attr.property-value-character.
      107       end.
      108   end procedure.
      109   function ChgV1 return logical
      110       (input p-obj-type as char,
      111        input p-obj-code as int):
      112       define variable vOk as logical no-undo.
      113       define buffer thbj-attr for ub.thbj-attr.
      114       do trans:
      115           vOk = true.
      116           find first thbj-attr where thbj-attr.upper-prop-code eq 'gisMT':U
      117                                and thbj-attr.obj-type        eq p-obj-type
      118                                and thbj-attr.obj-code        eq p-obj-code
      119                                and thbj-attr.prop-code       eq 'OflineAdress':U
      120           exclusive-lock no-wait no-error.
      121           if available thbj-attr then do:
      122              thbj-attr.property-value-character = mAddress .
      123           end.
      124           else if locked thbj-attr then vOk = false.
      125       end.
      126       return vOk.
      127   end.
