        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo.
        3   define input  parameter iparam        as character no-undo.
        4   define output parameter oOk           as logical no-undo.
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10     define variable v-cntxt-db-num        as integer   no-undo .
       11     define variable v-cntxt-userid        as character no-undo .
       12     define variable v-cntxt-level         as character no-undo .
       13     define variable v-cntxt-host-code-obj as integer   no-undo .
       14     define variable v-cntxt-obj-type      as character no-undo .
       15     define variable v-cntxt-obj-code      as integer   no-undo .
       16     define variable v-cntxt-db-num-obj    as integer   no-undo .
       17     define variable v-cntxt-is-admin      as logical   no-undo .
       18   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19     run mainmenu_getcntxt in parparentproc
       20       (output v-cntxt-db-num
       21       ,output v-cntxt-userid
       22       ,output v-cntxt-level
       23       ,output v-cntxt-host-code-obj
       24       ,output v-cntxt-obj-type
       25       ,output v-cntxt-obj-code
       26       ,output v-cntxt-db-num-obj
       27       ,output v-cntxt-is-admin
       28       ) .
       29   define buffer cli_shops for ub.clients .
       30   for each cli_shops no-lock where
       31                cli_shops.obj-type = 'маг':U and
       32                cli_shops.db-num = v-cntxt-db-num
       33   :
       34      run str/diallog.w (
       35              input parparentproc
       36            , input this-procedure
       37            , input "str/send-all.p":U
       38            , input ( cli_shops.obj-type + chr(4) + string(cli_shops.obj-code) + chr(4) + 'D':U + chr(4) + 'emrcdel':U + chr(4) + 'Удаление справочника ЕМЦ':U)
       39            , input yes
       40            , input "":U
       41            , input substitute("Отсылка очистки справочника ЕМЦ")
       42        ) no-error.
       43       run str/diallog.w (
       44              input parparentproc
       45            , input this-procedure
       46            , input "str/send-all.p":U
       47            , input ( cli_shops.obj-type + chr(4) + string(cli_shops.obj-code) + chr(4) + 'U':U + chr(4) + 'emrc':U + chr(4) + 'Передача справочника ЕМЦ':U)
       48            , input yes
       49            , input "":U
       50            , input substitute("Отсылка справочника ЕМЦ")
       51        ) no-error.
       52   end.
       53   oOk = true.
