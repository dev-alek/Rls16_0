        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define input  parameter parparentproc as handle no-undo.
       18   define input  parameter iparam        as character no-undo.
       19   define output parameter oOk           as logical no-undo.
       20   define buffer db for ub.db.
       21   define buffer thbj-attr for ub.thbj-attr.
       22   if g#db-num eq 0
       23   then do:
       24      for each db no-lock:
       25         do trans:
       26         for each thbj-attr where thbj-attr.upper-prop-code eq 'gisMT':U
       27                              and thbj-attr.obj-type        eq 'ад':U
       28                              and thbj-attr.obj-code        eq db.db-num
       29                              and thbj-attr.prop-code       ne ""
       30                              and thbj-attr.prop-code       ne 'OflineAdress':U
       31                              and thbj-attr.prop-code       ne 'OflineLogin':U
       32                              and thbj-attr.prop-code       ne 'OflinePswd':U
       33                              and thbj-attr.prop-code       ne 'adressPort':U
       34                              and thbj-attr.prop-code       ne 'dopParam':U
       35                              and thbj-attr.prop-code       ne 'gisAdress':U
       36                              and thbj-attr.prop-code       ne 'proxyLogin':U
       37                              and thbj-attr.prop-code       ne 'proxyPswd':U
       38                              and thbj-attr.prop-code       ne 'regKey':U
       39                              and thbj-attr.prop-code       ne 'waitTime':U
       40                              and thbj-attr.prop-code       ne 'cdnTurnOn':U
       41                              and thbj-attr.prop-code       ne 'cdnAdress':U
       42                              and thbj-attr.prop-code       ne 'crashSituat':U
       43         exclusive-lock:
       44               delete thbj-attr.
       45         end.
       46         end.
       47      end.
       48   end.
       49   oOk = true.
