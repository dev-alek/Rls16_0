        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Триггер на удаление пар-ров объекта TH".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25       assign
       26         p-vss-parameters = substitute('&1|&2'
       27                            , ub.thbj-attr.obj-type
       28                            , ub.thbj-attr.obj-code
       29                            , ub.thbj-attr.upper-prop-code
       30                            , ub.thbj-attr.prop-code
       31                            )
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   define new global shared variable g#lib-nws as handle no-undo .
      311   define variable v-date as date no-undo .
      312   define variable v-time as integer no-undo .
      313   define variable v-host-code like ub.sysconf.host-code no-undo .
      314   define buffer buf_c-thbj-attr for ub.c-thbj-attr.
      315   define buffer buf_c-cli-hist for ub.c-cli-hist.
      316   on DELETE of ub.thbj-attr override do:
      317   main-block:
      318   do
      319   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      320   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      321   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      322   :
      323    if not g#news then do:
      324      if (ub.thbj-attr.obj-type = 'орг':U
      325      or ub.thbj-attr.obj-type = '':U)
      326      or (ub.thbj-attr.obj-type = 'БД':U and  g#db-num <>  ub.thbj-attr.obj-code)
      327      and g#db-num > 0 then do:
      328      end.
      329    end.
      330     if g#news then do:
      331       define variable v-send as integer no-undo .
      332       v-send = integer('0':U).
      333   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      335     (input  g#db-num
      336     ,input  'thbj-attr':U
      337     ,input  0
      338     ,input  '':U
      339     ,input  0
      340     ,input  '':U
      341     ,input  '':U
      342     ,input  '':U
      343     ,input  0
      344     ,input  0
      345     ,input  0
      346     ,input  'nws-to-hist'
      347     ,output v-send
      348     ) no-error .
      349     end.
      350     if not g#news
      351     or v-send >= 0 then do:
      352       run cur-time in this-procedure(output v-date, output v-time).
      353       create buf_c-thbj-attr.
      354       buffer-copy ub.thbj-attr to buf_c-thbj-attr
      355       assign
      356       buf_c-thbj-attr.chip-num           = next-value (s-cli-chip, ub)
      357       buf_c-thbj-attr.corr-time          = v-time
      358       buf_c-thbj-attr.corr-user-db-num   = g#db-num
      359       buf_c-thbj-attr.corr-user-name     = (if g#news
      360                                             then (chr(4) +  'СПН':U)
      361                                             else (if g#esys
      362                                                   then (chr(4) +  'ВС':U)
      363                                                   else g#userid)
      364                                             )
      365       buf_c-thbj-attr.corr-date          = v-date
      366       buf_c-thbj-attr.action = (if new (ub.thbj-attr )
      367                               then integer('1':U)
      368                               else integer('2':U))
      369       buf_c-thbj-attr.subject = 'thbj-attr':U
      370       .
      371       if ub.thbj-attr.obj-type = 'маг':U
      372       or ub.thbj-attr.obj-type = 'скл':U then do:
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      375     (input  ub.thbj-attr.obj-type
      376     ,input  ub.thbj-attr.obj-code
      377     ,output v-host-code
      378     )  .
      379       end.
      380       create buf_c-cli-hist.
      381       buffer-copy buf_c-thbj-attr to buf_c-cli-hist
      382       assign
      383       buf_c-cli-hist.action = integer('99':U)
      384       buf_c-cli-hist.subject = 'thbj-attr':U
      385       buf_c-cli-hist.host-code = v-host-code
      386       buf_c-cli-hist.is-news = g#news
      387       buf_c-cli-hist.source-type = (if g#news then 'db':U else "":U)
      388       buf_c-cli-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      389       .
      390     end.
      391     run nws/cmd-del.p
      392       ( input 'thbj-attr':U
      393         ,input (buffer ub.thbj-attr:handle)
      394         ,input "":U
      395       ) no-error .
      396     if error-status :error then do:
      397       return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      398     end.
      399       if g#oxml = yes
      400       then do:
      401       run str/calloxml.p (
      402             input 'delete':U
      403           , input 'thbj-attr':U
      404           , input ( buffer ub.thbj-attr:handle )
      405       ) no-error.
      406       if error-status :error
      407       then do:
      408           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      409                                , chr(10)
      410                                , vss-workfile
      411                                , return-value
      412                                , error-status :get-message ( 1 ) ).
      413       end.
      414       end.
      415   end.
      416   end.
      417   DEFINE INPUT  PARAMETER parparentproc AS HANDLE    NO-UNDO.
      418   DEFINE INPUT  PARAMETER iparam        AS CHARACTER NO-UNDO.
      419   DEFINE OUTPUT PARAMETER oOk           AS LOGICAL   NO-UNDO.
      420   DEFINE BUFFER db FOR ub.db.
      421   DEFINE BUFFER thbj-attr FOR ub.thbj-attr.
      422   OUTPUT TO "errors.log".
      423       FOR EACH db NO-LOCK:
      424           DO TRANSACTION:
      425               FOR EACH thbj-attr
      426                   WHERE thbj-attr.upper-prop-code EQ "marking"
      427                        AND (thbj-attr.prop-code   EQ "marking-type"
      428                       OR thbj-attr.prop-code      EQ "marking-type-blockCashUnMark"
      429                       OR thbj-attr.prop-code      EQ "marking-type-saleUPD"
      430                       OR thbj-attr.prop-code      EQ "marking-type-onlySale")
      431                   EXCLUSIVE-LOCK:
      432                   DELETE thbj-attr NO-ERROR.
      433                   IF ERROR-STATUS:ERROR THEN  ERROR-STATUS:ERROR = NO.
      434               END.
      435           END.
      436       END.
      437   OUTPUT CLOSE.
      438   oOk = TRUE.
