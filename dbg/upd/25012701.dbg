        1   block-level on error undo, throw.
        2   on write of ub.thbj-attr override do: end.
        3   on write of ub.place-attr override do: end.
        4   define buffer buf_thbj-attr for ub.thbj-attr .
        5   find first sys-ctrl no-lock no-error.
        6   if not avail sys-ctrl
        7   or sys-ctrl.db-num eq 0
        8   then
        9     return
       10   .
       11   for each buf_thbj-attr exclusive-lock where buf_thbj-attr.prop-code = "sec-fields" :
       12     if lookup("pasp-dens", buf_thbj-attr.property-value-character) > 0 then next .
       13     if trim(buf_thbj-attr.property-value-character) = ""
       14     then buf_thbj-attr.property-value-character = "pasp-dens" .
       15     else buf_thbj-attr.property-value-character = buf_thbj-attr.property-value-character + ",pasp-dens" .
       16   end .
       17   for each buf_thbj-attr exclusive-lock where buf_thbj-attr.prop-code = "temp-for-pomi" :
       18     buf_thbj-attr.property-value-integer = 1 .
       19   end .
       20   run utl/init-shift-period.p (input "all") .
