     1749                 ot-full.sum-base       = ?
     1750                 ot-full.sum-rubl       = ?
     1751                 ot-full.vat-base       = ?
     1752                 ot-full.vat-rubl       = ?
     1753                 ot-full.slt-base       = ?
     1754                 ot-full.slt-rubl       = ?
     1755                 ot-full.excise-base    = ?
     1756                 ot-full.excise-rubl    = ?
     1757                 ot-full.road-tax-base  = ?
     1758                 ot-full.road-tax-rubl  = ?
