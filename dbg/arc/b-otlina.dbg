     1785                 ot-full.sum-rubl-sale       = ot-full.sum-rubl-sale       + ub.ot-line.sum-rubl
     1786                 ot-full.vat-base-sale       = ot-full.vat-base-sale       + ub.ot-line.vat-base
     1787                 ot-full.vat-rubl-sale       = ot-full.vat-rubl-sale       + ub.ot-line.vat-rubl
     1788                 ot-full.slt-base-sale       = ot-full.slt-base-sale       + ub.ot-line.slt-base
     1789                 ot-full.slt-rubl-sale       = ot-full.slt-rubl-sale       + ub.ot-line.slt-rubl
     1790                 ot-full.excise-base-sale    = ot-full.excise-base-sale    + ub.ot-line.excise-base
     1791                 ot-full.excise-rubl-sale    = ot-full.excise-rubl-sale    + ub.ot-line.excise-rubl
     1792                 ot-full.road-tax-base-sale  = ot-full.road-tax-base-sale  + ub.ot-line.road-tax-base
     1793                 ot-full.road-tax-rubl-sale  = ot-full.road-tax-rubl-sale  + ub.ot-line.road-tax-rubl
     1794                 ot-full.transport-base-sale = ot-full.transport-base-sale + ub.ot-line.transport-base
     1795                 ot-full.transport-rubl-sale = ot-full.transport-rubl-sale + ub.ot-line.transport-rubl
     1796                 ot-full.other-base-sale     = ot-full.other-base-sale     + ub.ot-line.other-base
     1797                 ot-full.other-rubl-sale     = ot-full.other-rubl-sale     + ub.ot-line.other-rubl .
     1798            END.
