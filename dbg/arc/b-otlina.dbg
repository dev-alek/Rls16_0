     1307          ot-full.ext-doc-type = ub.ot-line.ext-doc-type.
     1308          ot-full.ext-doc-type-full =  entry(lookup(ot-full.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     1309          if available ub.trn-doc then do:
     1310             find  ub.clients where  ub.clients.obj-type = ub.trn-doc.cli-type and
     1311                                 ub.clients.obj-code = ub.trn-doc.cli-code no-lock.
     1312             assign ot-full.cli-name =  ub.clients.obj-name.
     1313          end.
     1314          else ot-full.cli-name = " ".
     1315       END.
     1316       if ot-full.gds-type = 'у':U then do:
     1317         CASE ub.ot-line.sum-type:
     1318            WHEN 'cssr':U THEN DO:
     1319              if g-cost then
     1320                 ASSIGN
     1321                 ot-full.sum-base       = ot-full.sum-base       + ub.ot-line.sum-base
     1322                 ot-full.sum-rubl       = ot-full.sum-rubl       + ub.ot-line.sum-rubl
     1323                 ot-full.vat-base       = ot-full.vat-base       + ub.ot-line.vat-base
     1324                 ot-full.vat-rubl       = ot-full.vat-rubl       + ub.ot-line.vat-rubl
     1325                 ot-full.slt-base       = ot-full.slt-base       + ub.ot-line.slt-base
     1326                 ot-full.slt-rubl       = ot-full.slt-rubl       + ub.ot-line.slt-rubl
     1327                 ot-full.excise-base    = ot-full.excise-base    + ub.ot-line.excise-base
     1328                 ot-full.excise-rubl    = ot-full.excise-rubl    + ub.ot-line.excise-rubl
     1329                 ot-full.road-tax-base  = ot-full.road-tax-base  + ub.ot-line.road-tax-base
     1330                 ot-full.road-tax-rubl  = ot-full.road-tax-rubl  + ub.ot-line.road-tax-rubl
     1331                 ot-full.transport-base = ot-full.transport-base + ub.ot-line.transport-base
     1332                 ot-full.transport-rubl = ot-full.transport-rubl + ub.ot-line.transport-rubl
     1333                 ot-full.other-base     = ot-full.other-base     + ub.ot-line.other-base
     1334                 ot-full.other-rubl     = ot-full.other-rubl     + ub.ot-line.other-rubl.
     1335              else
     1336                 ASSIGN
     1337                 ot-full.sum-base       = ?
     1338                 ot-full.sum-rubl       = ?
     1339                 ot-full.vat-base       = ?
     1340                 ot-full.vat-rubl       = ?
     1341                 ot-full.slt-base       = ?
     1342                 ot-full.slt-rubl       = ?
     1343                 ot-full.excise-base    = ?
     1344                 ot-full.excise-rubl    = ?
     1345                 ot-full.road-tax-base  = ?
     1346                 ot-full.road-tax-rubl  = ?
     1347                 ot-full.transport-base = ?
     1348                 ot-full.transport-rubl = ?
     1349                 ot-full.other-base     = ?
     1350                 ot-full.other-rubl     = ?.
     1351            END.
     1352            WHEN 'sasr':U THEN DO:
     1353                 assign ot-full.fact-qnty = ot-full.fact-qnty + ub.ot-line.fact-qnty.
     1354                 ASSIGN
     1355                 ot-full.sum-base-doc       = ot-full.sum-base-doc       + ub.ot-line.sum-base
     1356                 ot-full.sum-rubl-doc       = ot-full.sum-rubl-doc       + ub.ot-line.sum-rubl
     1357                 ot-full.vat-base-doc       = ot-full.vat-base-doc       + ub.ot-line.vat-base
     1358                 ot-full.vat-rubl-doc       = ot-full.vat-rubl-doc       + ub.ot-line.vat-rubl
     1359                 ot-full.slt-base-doc       = ot-full.slt-base-doc       + ub.ot-line.slt-base
     1360                 ot-full.slt-rubl-doc       = ot-full.slt-rubl-doc       + ub.ot-line.slt-rubl
     1361                 ot-full.excise-base-doc    = ot-full.excise-base-doc    + ub.ot-line.excise-base
     1362                 ot-full.excise-rubl-doc    = ot-full.excise-rubl-doc    + ub.ot-line.excise-rubl
     1363                 ot-full.road-tax-base-doc  = ot-full.road-tax-base-doc  + ub.ot-line.road-tax-base
     1364                 ot-full.road-tax-rubl-doc  = ot-full.road-tax-rubl-doc  + ub.ot-line.road-tax-rubl
     1365                 ot-full.transport-base-doc = ot-full.transport-base-doc + ub.ot-line.transport-base
     1366                 ot-full.transport-rubl-doc = ot-full.transport-rubl-doc + ub.ot-line.transport-rubl
     1367                 ot-full.other-base-doc     = ot-full.other-base-doc     + ub.ot-line.other-base
     1368                 ot-full.other-rubl-doc     = ot-full.other-rubl-doc     + ub.ot-line.other-rubl.
     1369            END.
     1370            WHEN 'cgsr':U THEN DO:
     1371                 ASSIGN
     1372                 ot-full.sum-base-sale       = ot-full.sum-base-sale       + ub.ot-line.sum-base
     1373                 ot-full.sum-rubl-sale       = ot-full.sum-rubl-sale       + ub.ot-line.sum-rubl
     1374                 ot-full.vat-base-sale       = ot-full.vat-base-sale       + ub.ot-line.vat-base
     1375                 ot-full.vat-rubl-sale       = ot-full.vat-rubl-sale       + ub.ot-line.vat-rubl
     1376                 ot-full.slt-base-sale       = ot-full.slt-base-sale       + ub.ot-line.slt-base
     1377                 ot-full.slt-rubl-sale       = ot-full.slt-rubl-sale       + ub.ot-line.slt-rubl
     1378                 ot-full.excise-base-sale    = ot-full.excise-base-sale    + ub.ot-line.excise-base
     1379                 ot-full.excise-rubl-sale    = ot-full.excise-rubl-sale    + ub.ot-line.excise-rubl
     1380                 ot-full.road-tax-base-sale  = ot-full.road-tax-base-sale  + ub.ot-line.road-tax-base
     1381                 ot-full.road-tax-rubl-sale  = ot-full.road-tax-rubl-sale  + ub.ot-line.road-tax-rubl
     1382                 ot-full.transport-base-sale = ot-full.transport-base-sale + ub.ot-line.transport-base
     1383                 ot-full.transport-rubl-sale = ot-full.transport-rubl-sale + ub.ot-line.transport-rubl
     1384                 ot-full.other-base-sale     = ot-full.other-base-sale     + ub.ot-line.other-base
     1385                 ot-full.other-rubl-sale     = ot-full.other-rubl-sale     + ub.ot-line.other-rubl .
     1386            END.
     1387            OTHERWISE DO:
     1388              message "Некорректный sum-type " ub.ot-line.sum-type " при просмотре архива(b-otlina.w)." skip
     1389                      "Ошибка в расчетах."
     1390                      view-as alert-box error.
     1391            END.
     1392         END CASE.
     1393       end.
     1394       else do:
     1395         CASE ub.ot-line.sum-type:
     1396            WHEN 'cost':U THEN DO:
     1397              assign ot-full.fact-qnty = ot-full.fact-qnty + ub.ot-line.fact-qnty.
     1398              if g-cost then
     1399                 ASSIGN
     1400                 ot-full.sum-base       = ot-full.sum-base       + ub.ot-line.sum-base
     1401                 ot-full.sum-rubl       = ot-full.sum-rubl       + ub.ot-line.sum-rubl
