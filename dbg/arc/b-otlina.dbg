        1   DEFINE NEW GLOBAL SHARED TEMP-TABLE tt-clients NO-UNDO LIKE ub.clients.
        2   DEFINE NEW GLOBAL SHARED TEMP-TABLE tt-goods NO-UNDO LIKE ub.goods.
        3   CREATE WIDGET-POOL.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Просмотр оборота по товару".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define shared variable varparentproc as widget-handle no-undo.
      125   define new shared variable line-rec as recid no-undo.
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   procedure dfactord:
      128   define input  parameter parobj-type         like ub.clients.obj-type   no-undo.
      129   define input  parameter parobj-code         like ub.clients.obj-code   no-undo.
      130   define input  parameter paris-calend-day    as   logical            no-undo.
      131   define input  parameter paris-shift-num     as   logical            no-undo.
      132   define input  parameter pardate-start       as   date               no-undo.
      133   define input  parameter pardate-end         as   date               no-undo.
      134   define input  parameter parshift-start      as   integer            no-undo.
      135   define input  parameter parshift-end        as   integer            no-undo.
      136   define output parameter parfact-order-start like ub.stk-tot.fact-order no-undo.
      137   define output parameter parfact-order-end   like ub.stk-tot.fact-order no-undo.
      138   if paris-calend-day then do:
      139      run lastordr
      140          (input  parobj-type,
      141           input  parobj-code,
      142           input  no,
      143           input  ?,
      144           input  pardate-start - 1,
      145           input  ?,
      146           output parfact-order-start) no-error.
      147      if error-status:error then return error.
      148      run lastordr
      149          (input  parobj-type,
      150           input  parobj-code,
      151           input  no,
      152           input  ?,
      153           input  pardate-end,
      154           input  ?,
      155           output parfact-order-end) no-error.
      156      if error-status:error then return error.
      157   end.
      158   else do:
      159      if paris-shift-num then do:
      160         run lastordr
      161             (input  parobj-type,
      162              input  parobj-code,
      163              input  yes,
      164              input  yes,
      165              input  pardate-start,
      166              input  parshift-start - 1,
      167              output parfact-order-start) no-error.
      168         if error-status:error then return error.
      169         run lastordr
      170             (input  parobj-type,
      171              input  parobj-code,
      172              input  yes,
      173              input  yes,
      174              input  pardate-end,
      175              input  parshift-end,
      176              output parfact-order-end) no-error.
      177         if error-status:error then return error.
      178      end.
      179      else do:
      180         run lastordr
      181             (input  parobj-type,
      182              input  parobj-code,
      183              input  yes,
      184              input  no,
      185              input  pardate-start - 1,
      186              input  ?,
      187              output parfact-order-start) no-error.
      188         if error-status:error then return error.
      189         run lastordr
      190             (input  parobj-type,
      191              input  parobj-code,
      192              input  yes,
      193              input  no,
      194              input  pardate-end,
      195              input  ?,
      196              output parfact-order-end) no-error.
      197         if error-status:error then return error.
      198      end.
      199   end.
      200   end procedure.
      201   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   procedure lastordr :
      203     define input  parameter parobj-type     as character no-undo .
      204     define input  parameter parobj-code     as integer   no-undo .
      205     define input  parameter paris-shift     as logical   no-undo .
      206     define input  parameter paris-shift-num as logical   no-undo .
      207     define input  parameter pardate         as date      no-undo .
      208     define input  parameter parshift-num    as integer   no-undo .
      209     define output parameter parfact-order   as decimal   no-undo .
      210     if paris-shift = no
      211     then do:
      212       find last ub.stk-tot no-lock
      213         where ub.stk-tot.obj-type    = parobj-type
      214           and ub.stk-tot.obj-code    = parobj-code
      215           and ub.stk-tot.fact-date <= pardate
      216           and ub.stk-tot.shift-num  = 0
      217         use-index fact-date
      218         no-error .
      219     end.
      220     else do:
      221       if paris-shift-num = no
      222       then do:
      223         find last ub.stk-tot no-lock
      224           where ub.stk-tot.obj-type    = parobj-type
      225             and ub.stk-tot.obj-code    = parobj-code
      226             and ub.stk-tot.shift-date <= pardate
      227             and ub.stk-tot.shift-num   > 0
      228           use-index shift-num
      229           no-error .
      230       end.
      231       else do:
      232         find last ub.stk-tot no-lock
      233           where ub.stk-tot.obj-type   = parobj-type
      234             and ub.stk-tot.obj-code   = parobj-code
      235             and ub.stk-tot.shift-date = pardate
      236             and ub.stk-tot.shift-num  <= parshift-num
      237             and ub.stk-tot.shift-num  > 0
      238           use-index shift-num
      239           no-error .
      240         if not available ub.stk-tot
      241         then do:
      242           find last ub.stk-tot no-lock
      243             where ub.stk-tot.obj-type   = parobj-type
      244               and ub.stk-tot.obj-code   = parobj-code
      245               and ub.stk-tot.shift-date < pardate
      246               and ub.stk-tot.shift-num  > 0
      247             use-index shift-num
      248             no-error .
      249         end.
      250       end.
      251     end.
      252     assign
      253       parfact-order = (if available ub.stk-tot then ub.stk-tot.fact-order else 0)
      254     .
      255   end procedure.
      256   define variable fact-order-start like ub.ot-line.fact-order no-undo.
      257   define variable fact-order-end   like ub.ot-line.fact-order no-undo.
      258   define variable fact-order-min   like ub.ot-line.fact-order no-undo.
      259   define variable fact-order-max   like ub.ot-line.fact-order no-undo.
      260   define variable varh_caller-main as widget-handle no-undo.
      261   define variable varh_arh as widget-handle no-undo.
      262   define variable vardoc-code  as character no-undo.
      263   define variable varfact-date as date      no-undo.
      264   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   define variable varis-calend     as integer   no-undo.
      266   define variable varis-shift-num  as logical   no-undo.
      267   define variable vardate-start    as date      no-undo.
      268   define variable vardate-end      as date      no-undo.
      269   define variable varshift-start   as integer   no-undo.
      270   define variable varshift-end     as integer   no-undo.
      271   define variable varext-doc-type  as character no-undo.
      272   define variable varrubl-base     as integer   no-undo.
      273   define variable varsum-type as character no-undo.
      274   define variable varcontragent as char no-undo.
      275   define variable varsum like ub.ot-line.sum-base no-undo.
      276   define variable varsum-doc like ub.ot-line.sum-base no-undo.
      277   define variable varsum-sale like ub.ot-line.sum-base no-undo.
      278   define variable varprice-doc like ub.ot-line.sum-base no-undo.
      279   define variable varprice-sale like ub.ot-line.sum-base no-undo.
      280   define variable varvat like ub.ot-line.sum-base no-undo.
      281   define variable varvat-doc like ub.ot-line.sum-base no-undo.
      282   define variable varslt like ub.ot-line.sum-base no-undo.
      283   define variable varslt-doc like ub.ot-line.sum-base no-undo.
      284   define variable varroad-tax like ub.ot-line.sum-base no-undo.
      285   define variable varroad-tax-doc like ub.ot-line.sum-base no-undo.
      286   define variable varexcise like ub.ot-line.sum-base no-undo.
      287   define variable varexcise-doc like ub.ot-line.sum-base no-undo.
      288   define variable vartransport like ub.ot-line.sum-base no-undo.
      289   define variable vartransport-doc like ub.ot-line.sum-base no-undo.
      290   define variable varother like ub.ot-line.sum-base no-undo.
      291   define variable varother-doc like ub.ot-line.sum-base no-undo.
      292   define variable rdtaxname as character no-undo.
      293   define variable varext-doc-type-short like ub.ot-line.ext-doc-type no-undo.
      294   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   procedure tax-name:
      296   define input  parameter pardef-tax  as character           no-undo.
      297   define output parameter parname-tax as character initial ? no-undo.
      298   define buffer bf_tax for ub.tax.
      299   do on error undo, return error :
      300      case pardef-tax:
      301         when 'vat':U then do:
      302                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      303         end.
      304         when 'slt':U then do:
      305                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      306         end.
      307         when 'rdt':U then do:
      308                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      309         end.
      310         when 'exc':U then do:
      311                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      312         end.
      313         otherwise do:
      314            return error "Задан неверный параметр " + pardef-tax + " .".
      315         end.
      316      end case.
      317   end.
      318   end procedure.
      319   define buffer rt_tax   for ub.tax.
