      999   otherwise do:
     1000      find first ub.trn-doc where ub.trn-doc.doc-code = ot-full.doc-code no-lock.
     1001      if not available ub.trn-doc then do:
     1002         message "Не найден документ для просмотра" view-as alert-box.
     1003         return error.
     1004      end.
