     1744                 ot-full.transport-rubl = ot-full.transport-rubl + ub.ot-line.transport-rubl
     1745                 ot-full.other-base     = ot-full.other-base     + ub.ot-line.other-base
     1746                 ot-full.other-rubl     = ot-full.other-rubl     + ub.ot-line.other-rubl.
     1747              else
