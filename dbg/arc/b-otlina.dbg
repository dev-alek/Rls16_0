      421   DEFINE BUTTON b-all-docs
      422        LABEL "Все документы"
      423        SIZE 16 BY 1.
      424   DEFINE BUTTON b-lookup
      425        LABEL "Просмотр"
      426        SIZE 14 BY 1.
      427   DEFINE QUERY b-ot-line FOR
      428         ot-full SCROLLING.
      429   DEFINE BROWSE b-ot-line
      430     QUERY b-ot-line NO-LOCK DISPLAY
      431         ot-full.fact-date @ varfact-date column-label "Дата"
      432         ot-full.doc-code @ vardoc-code column-label "Документ"
      433         ot-full.ext-doc-type-full format "x(11)" column-label " "
      434         ot-full.cli-name @ varcontragent format "x(15)" column-label "Контрагент"
      435         ot-full.fact-qnty column-label "Кол-во"
      436         func-sum-doc (buffer ot-full) @ varsum-doc format "->,>>>,>>>,>>9.99" column-label "Сумма(по док)"
      437         func-sum (buffer ot-full) @ varsum format "->,>>>,>>>,>>9.99" column-label "Сумма(учет)"
      438         func-sum-sale (buffer ot-full) @ varsum-sale format "->,>>>,>>>,>>9.99" column-label "Сумма(прод)"
      439         func-other-doc (buffer ot-full) @ varother-doc format "->,>>>,>>>,>>9.99" column-label "Скидка(Прочие расходы)(по док)"
      440         func-VAT-doc (buffer ot-full) @ varvat-doc format "->,>>>,>>>,>>9.99" column-label "НДС(по док)"
      441         func-SLT-doc (buffer ot-full) @ varslt-doc format "->,>>>,>>>,>>9.99" column-label "НП(по док)"
      442         func-VAT (buffer ot-full) @ varvat format "->,>>>,>>>,>>9.99" column-label "НДС(учет)"
      443         func-SLT (buffer ot-full) @ varslt format "->,>>>,>>>,>>9.99" column-label "НП(учет)"
      444         func-excise-doc (buffer ot-full) @ varexcise-doc format "->,>>>,>>>,>>9.99" column-label "Акциз(по док)"
      445         func-excise (buffer ot-full) @ varexcise format "->,>>>,>>>,>>9.99" column-label "Акциз(учет)"
      446         func-road-tax-doc (buffer ot-full) @ varroad-tax-doc format "->,>>>,>>>,>>9.99"
      447         func-road-tax (buffer ot-full) @ varroad-tax format "->,>>>,>>>,>>9.99"
      448         func-transport-doc (buffer ot-full) @ vartransport-doc format "->,>>>,>>>,>>9.99" column-label "Трансп.расх.(по док)"
      449         func-transport (buffer ot-full) @ vartransport format "->,>>>,>>>,>>9.99" column-label "Трансп.расх.(учет)"
      450         func-other (buffer ot-full) @ varother format "->,>>>,>>>,>>9.99" column-label "Прочие расх.(Скидка)(учет)"
      451         func-price-doc (buffer ot-full) @ varprice-doc format "->,>>>,>>>,>>9.99" column-label "Сумма/Кол-во(по док)"
      452         func-price-sale (buffer ot-full) @ varprice-sale format "->,>>>,>>>,>>9.99" column-label "Сумма/Кол-во(учет)"
      453         ot-full.artic
      454         ot-full.prod-type
      455         ot-full.prod-code
      456         ot-full.obj-type
      457         ot-full.obj-code
      458       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 14.08
      459            BGCOLOR 15 .
      460   DEFINE FRAME F-Main
      461        b-lookup AT ROW 1.13 COL 3
      462        b-all-docs AT ROW 1.13 COL 18
      463        b-ot-line AT ROW 2.63 COL 1.13
      464       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
      465            THREE-D
      466            AT COL 1 ROW 1
      467            SIZE 97.25 BY 16.71
      468            BGCOLOR 8 FGCOLOR 0
      469            TITLE "".
      470   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      471   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      472   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      473   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      474   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      475   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      476   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      477   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      478   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      479   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      480   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      481         adm-object-hdl = FRAME F-Main:HANDLE.
      482   RUN ensure-broker.
      483   THIS-PROCEDURE:ADM-DATA =
      484        'ADM1.1~`':U +
      485        'SmartObject~`':U +
      486        '~`':U +
      487        'YES~`':U +
      488        '~`':U +
      489        'ot-full~`':U +
      490        '~`':U +
      491        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      492           + "~`":U +
      493        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      494        'Record-Source,Record-Target,TableIO-Target~`':U +
      495        '~`':U +
      496        '~`~`~`~`~`~`~`~`~`~`~`':U +
      497        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      498            THEN "^^":U
      499        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      500             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      501   PROCEDURE adm-apply-entry :
      502     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      503   END PROCEDURE.
      504   PROCEDURE adm-destroy :
      505    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      506   END PROCEDURE.
      507   PROCEDURE adm-disable :
      508       DISABLE b-lookup b-all-docs b-ot-line WITH FRAME F-Main.
      509       RUN dispatch ('disable-fields':U).
      510       RUN set-attribute-list ('ENABLED=no':U).
      511       RETURN.
      512   END PROCEDURE.
      513   PROCEDURE adm-edit-attribute-list :
      514         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      515         RETURN.
      516   END PROCEDURE.
      517   PROCEDURE adm-enable :
      518       ENABLE UNLESS-HIDDEN b-lookup b-all-docs b-ot-line WITH FRAME F-Main.
      519       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      520       RUN set-attribute-list ('ENABLED=yes':U).
      521       RETURN.
      522   END PROCEDURE.
      523   PROCEDURE adm-exit :
      524        RUN notify ('exit':U).
      525     RETURN.
      526   END PROCEDURE.
      527   PROCEDURE adm-hide :
      528     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      529   END PROCEDURE.
      530   PROCEDURE adm-initialize :
      531     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      532   END PROCEDURE.
      533   PROCEDURE adm-show-errors :
      534       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      535       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      536           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      537       END.
      538       RETURN.
      539   END PROCEDURE.
      540   PROCEDURE adm-UIB-mode :
      541     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      542   END PROCEDURE.
      543   PROCEDURE adm-view :
      544     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      545   END PROCEDURE.
      546   PROCEDURE dispatch :
      547       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      548       RUN broker-dispatch IN adm-broker-hdl
      549           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      550       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      551   END PROCEDURE.
      552   PROCEDURE ensure-broker :
      553   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      554   IF RETURN-VALUE NE "ADM-Broker":U THEN
      555   DO:
      556       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      557       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      558   END.
      559   END PROCEDURE.
      560   PROCEDURE get-attribute :
      561     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      562     RUN broker-get-attribute IN adm-broker-hdl
      563         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      564     RETURN RETURN-VALUE.
      565   END PROCEDURE.
      566   PROCEDURE get-attribute-list :
      567     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      568     RUN broker-get-attribute-list IN adm-broker-hdl
      569         (INPUT THIS-PROCEDURE,
      570          INPUT ?,
      571          OUTPUT p-attr-list) NO-ERROR.
      572     RETURN.
      573   END PROCEDURE.
      574   PROCEDURE new-state :
      575     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      576     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      577     RETURN.
      578   END PROCEDURE.
      579   PROCEDURE notify :
      580     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      581     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      582     IF RETURN-VALUE = "ADM-ERROR":U THEN
      583         RETURN "ADM-ERROR":U.
      584     RETURN.
      585   END PROCEDURE.
      586   PROCEDURE set-attribute-list :
      587     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      588     RUN ensure-broker.
      589     RUN broker-set-attribute-list IN adm-broker-hdl
      590         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      591     RETURN.
      592   END PROCEDURE.
      593   PROCEDURE set-position :
      594       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      595       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      596       IF VALID-HANDLE(adm-object-hdl) THEN
      597       DO:
      598         ASSIGN adm-object-hdl:ROW    =   p-row
      599                adm-object-hdl:COLUMN =   p-col.
      600       END.
      601       RETURN.
      602   END PROCEDURE.
      603     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      604     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      605     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      606     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      607     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      608     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      609     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      610     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      611     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      612     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      613     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      614     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      615     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      616     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      617     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      618     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      619     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      620     IF "":U = "":U THEN
      621       RUN modify-list-attribute IN adm-broker-hdl
      622         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      623     RUN use-create-on-add(?).
      624   PROCEDURE adm-add-record :
      625       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      626          "must have at least one Enabled Table to perform Add.":U
      627          VIEW-AS ALERT-BOX ERROR.
      628       RETURN.
      629   END PROCEDURE.
      630   PROCEDURE adm-assign-record :
      631    MESSAGE
      632          "Object ":U THIS-PROCEDURE:FILE-NAME
      633            "must have at least one Enabled Table to perform Assign.":U
      634              VIEW-AS ALERT-BOX ERROR.
      635      RETURN.
      636     END PROCEDURE.
      637   PROCEDURE adm-assign-statement :
      638     RETURN.
      639   END PROCEDURE.
      640   PROCEDURE adm-cancel-record :
      641      RETURN.
      642     END PROCEDURE.
      643   PROCEDURE adm-copy-record :
      644       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      645        "must have at least one Enabled Table to perform Copy.":U
      646          VIEW-AS ALERT-BOX ERROR.
      647       RETURN.
      648   END PROCEDURE.
      649   PROCEDURE adm-create-record :
      650      RETURN.
      651   END PROCEDURE.
      652   PROCEDURE adm-current-changed :
      653     RETURN.
      654   END PROCEDURE.
      655   PROCEDURE adm-delete-record :
      656    MESSAGE
      657          "Object ":U THIS-PROCEDURE:FILE-NAME
      658            "must have at least one Enabled Table to perform Delete.":U
      659              VIEW-AS ALERT-BOX ERROR.
      660       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      661       RETURN.
      662   END PROCEDURE.
      663   PROCEDURE adm-disable-fields :
      664         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      665       RETURN.
      666   END PROCEDURE.
      667   PROCEDURE adm-enable-fields :
      668       RETURN.
      669   END PROCEDURE.
      670   PROCEDURE adm-end-update :
      671     RETURN.
      672   END PROCEDURE.
      673   PROCEDURE adm-reset-record :
      674       RETURN.
      675   END PROCEDURE.
      676   PROCEDURE adm-update-record :
      677       MESSAGE
      678         "Object ":U THIS-PROCEDURE:FILE-NAME
      679           "must have at least one Enabled Table to perform Update.":U
      680             VIEW-AS ALERT-BOX ERROR.
      681      RETURN.
      682   END PROCEDURE.
      683   PROCEDURE check-modified :
      684   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      685   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      686   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      687   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      688     IF check-state = "check":U THEN
      689     DO:
      690       RUN get-link-handle IN adm-broker-hdl
      691         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      692            OUTPUT group-target-list).
      693       IF group-target-list NE "":U THEN
      694       DO i = 1 TO NUM-ENTRIES(group-target-list):
      695         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      696         RUN check-modified IN curr-widget ('group-check':U).
      697         IF RETURN-VALUE NE "":U THEN
      698         DO:
      699           RUN check-modified-message(RETURN-VALUE).
      700           RETURN "":U.
      701         END.
      702       END.
      703     END.
      704     RETURN "":U.
      705   END PROCEDURE.
      706   PROCEDURE check-modified-message :
      707     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      708        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      709           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      710        IF RETURN-VALUE = "YES":U THEN
      711           RUN notify ('view,CONTAINER-SOURCE':U).
      712        MESSAGE IF p-changed-table NE ? THEN
      713           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      714           ELSE "Current values have been changed."
      715           SKIP "  Do you wish to save those changes?"
      716           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      717        IF ANS THEN
      718        DO:
      719           IF group-assign-target THEN
      720             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      721           ELSE RUN dispatch('update-record':U).
      722           IF RETURN-VALUE = "ADM-ERROR":U THEN
      723           DO:
      724               MESSAGE "Changes to the previous record were not saved."
      725                 VIEW-AS ALERT-BOX ERROR.
      726               IF group-assign-target THEN
      727                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      728               ELSE RUN dispatch ('cancel-record':U).
      729           END.
      730        END.
      731        ELSE DO:
      732          IF group-assign-target THEN
      733             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      734          ELSE RUN dispatch('cancel-record':U).
      735        END.
      736        RETURN.
      737   END PROCEDURE.
      738   PROCEDURE get-rowid :
      739       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      740       ASSIGN
      741       p-table   =   adm-first-table.
      742       RETURN.
      743   END PROCEDURE.
      744   PROCEDURE init-group-assign :
      745       RUN request-attribute IN adm-broker-hdl
      746         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      747       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      748         group-assign-target = yes.
      749       ELSE group-assign-target = no.
      750       RETURN.
      751   END PROCEDURE.
      752   PROCEDURE set-editors :
      753       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      754       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      755       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      756       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      757       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      758       DO WHILE VALID-HANDLE (curr-widget):
      759           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      760              curr-widget:HIDDEN = no THEN DO:
      761             CASE p-field-setting:
      762               WHEN "INITIALIZE":U THEN
      763               DO:
      764                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      765                     read-only-list +
      766                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      767                        STRING(curr-widget).
      768               END.
      769               WHEN "DISABLE":U OR
      770               WHEN "ENABLE":U THEN
      771               DO:
      772                   curr-widget:SENSITIVE = yes.
      773                   RUN get-attribute ('Read-Only-Editors':U).
      774                   IF RETURN-VALUE = ? OR
      775                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      776                       curr-widget:READ-ONLY =
      777                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      778               END.
      779               WHEN "CLEAR":U THEN
      780                   curr-widget:SCREEN-VALUE = "":U.
      781             END CASE.
      782           END.
      783           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      784       END.
      785       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      786         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      787           + '"':U).
      788       RETURN.
      789   END PROCEDURE.
      790   PROCEDURE use-check-modified-all :
      791    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      792     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      793     RETURN.
      794   END PROCEDURE.
      795   PROCEDURE use-create-on-add :
      796   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      797      RETURN.
      798   END PROCEDURE.
      799   PROCEDURE use-initial-lock :
      800     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      801     ASSIGN adm-initial-lock = p-attr-value.
      802     RETURN.
      803   END PROCEDURE.
      804   PROCEDURE adm-display-fields :
      805         IF AVAILABLE ot-full THEN
      806             DISPLAY ot-full.fact-date @ varfact-date ot-full.doc-code @ vardoc-code ot-full.ext-doc-type-full ot-full.cli-name @ varcontragent ot-full.fact-qnty func-sum-doc (buffer ot-full) @ varsum-doc func-sum (buffer ot-full) @ varsum func-sum-sale (buffer ot-full) @ varsum-sale func-other-doc (buffer ot-full) @ varother-doc func-VAT-doc (buffer ot-full) @ varvat-doc func-SLT-doc (buffer ot-full) @ varslt-doc func-VAT (buffer ot-full) @ varvat func-SLT (buffer ot-full) @ varslt func-excise-doc (buffer ot-full) @ varexcise-doc func-excise (buffer ot-full) @ varexcise func-road-tax-doc (buffer ot-full) @ varroad-tax-doc func-road-tax (buffer ot-full) @ varroad-tax func-transport-doc (buffer ot-full) @ vartransport-doc func-transport (buffer ot-full) @ vartransport func-other (buffer ot-full) @ varother func-price-doc (buffer ot-full) @ varprice-doc func-price-sale (buffer ot-full) @ varprice-sale ot-full.artic ot-full.prod-type ot-full.prod-code ot-full.obj-type ot-full.obj-code WITH BROWSE b-ot-line
      807               NO-ERROR.
      808       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      809       RETURN.
      810   END PROCEDURE.
      811   PROCEDURE adm-open-query :
      812               OPEN QUERY b-ot-line FOR EACH ot-full.
      813           adm-query-opened = yes.
      814           IF NUM-RESULTS("b-ot-line":U) = 0 THEN
      815               RUN new-state ('no-record-available,SELF':U).
      816           ELSE DO:
      817               RUN new-state ('record-available,SELF':U).
      818               RUN new-state ('first-record,SELF':U).
      819           END.
      820           IF NOT adm-updating-record THEN
      821               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      822     RETURN.
      823   END PROCEDURE.
      824   PROCEDURE adm-row-changed :
      825         IF VALID-HANDLE(adm-object-hdl) THEN
      826           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      827         RUN notify ('row-available':U).
      828         RETURN.
      829   END PROCEDURE.
      830   PROCEDURE reposition-query :
      831       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      832       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      833       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      834       IF table-name <> ? THEN
      835           REPOSITION b-ot-line TO ROWID table-name NO-ERROR.
      836       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      837       RETURN.
      838   END PROCEDURE.
      839     adm-sts = b-ot-line:SET-REPOSITIONED-ROW
      840       (b-ot-line:DOWN,"CONDITIONAL":U).
      841     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      842   PROCEDURE set-size :
      843     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      844     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      845     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      846     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      847     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      848     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      849     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      850     ASSIGN pd_height = MAX(pd_height, 2.0)
      851            pd_width  = MAX(pd_width, 2.0)
      852            hBrowse     = b-ot-line:HANDLE IN FRAME F-Main
      853            hFieldGroup = hBrowse:PARENT
      854            htmpWidget  = hFieldGroup:FIRST-CHILD
      855            hFrame      = hFieldGroup:PARENT.
      856     Search-For-Siblings:
      857     REPEAT WHILE VALID-HANDLE(htmpWidget):
      858       IF htmpWidget NE hBrowse THEN DO:
      859         IF htmpWidget:TYPE NE "BUTTON" OR
      860            htmpWidget:X    NE 4 OR
      861            htmpWidget:Y    NE 4 THEN DO:
      862           RETURN.
      863         END.
      864       END.
      865       htmpWidget = htmpWidget:NEXT-SIBLING.
      866     END.
      867     IF pd_width < hBrowse:WIDTH THEN
      868       ASSIGN hBrowse:WIDTH = pd_width
      869              hFrame:WIDTH  = pd_width     NO-ERROR.
      870     ELSE
      871       ASSIGN hFrame:WIDTH  = pd_width
      872              hBrowse:WIDTH = pd_width     NO-ERROR.
      873     IF pd_height < hBrowse:HEIGHT THEN
      874       ASSIGN hBrowse:HEIGHT = pd_height
      875              hFrame:HEIGHT  = pd_height     NO-ERROR.
      876     ELSE
      877       ASSIGN hFrame:HEIGHT  = pd_height
      878              hBrowse:HEIGHT = pd_height     NO-ERROR.
      879   END PROCEDURE.
      880   ASSIGN
      881          FRAME F-Main:HIDDEN           = TRUE.
      882   ASSIGN
      883          b-ot-line:NUM-LOCKED-COLUMNS IN FRAME F-Main     = 4.
      884   ON END-ERROR OF FRAME F-Main
      885   DO:
      886        run return-up.
      887      return no-apply.
      888   END.
      889   ON ENDKEY OF FRAME F-Main
      890   DO:
      891        run return-up.
      892      return no-apply.
      893   END.
      894   ON CHOOSE OF b-all-docs IN FRAME F-Main
      895   DO:
      896   run notify ('read_doc-type-all,doctype-target':u).
      897   run show_arh.
      898   END.
      899   ON CHOOSE OF b-lookup IN FRAME F-Main
      900   DO:
      901     if available ot-full then do:
      902        run lookup-doc.
      903      end.
      904   END.
      905   ON MOUSE-SELECT-DBLCLICK OF b-ot-line IN FRAME F-Main
      906   DO:
      907     if available ot-full  then run lookup-doc.
      908   END.
      909   if not this-procedure :persistent
      910   then do:
      911     message
      912       vss-workfile vss-revision vss-description skip
      913       "Ошибка при запуске процедуры" skip
      914       "Данную процедуру следует запускать только с параметром persistent" skip
      915       view-as alert-box error .
      916     undo, return error .
      917   end.
      918   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919     run mainmenu_getcntxt in varparentproc
      920       (output v-cntxt-db-num
      921       ,output v-cntxt-userid
      922       ,output v-cntxt-level
      923       ,output v-cntxt-host-code-obj
      924       ,output v-cntxt-obj-type
      925       ,output v-cntxt-obj-code
      926       ,output v-cntxt-db-num-obj
      927       ,output v-cntxt-is-admin
      928       ) .
      929   run tax-name ('rdt':U, output rdtaxname).
      930   assign varroad-tax-doc :label in browse b-ot-line = rdtaxname
      931          varroad-tax     :label in browse b-ot-line = rdtaxname.
      932   PROCEDURE adm-row-available :
      933     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      934     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      935     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      936     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      937     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      938     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      939     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      940     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      941     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      942     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      943     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      944     IF adm-updating-record THEN RETURN.
      945     RUN get-attribute ('FIELDS-ENABLED':U).
      946     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      947     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      948         OUTPUT link-handle) NO-ERROR.
      949     IF link-handle = "":U THEN
      950         RETURN.
      951     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      952     IF NUM-ENTRIES(link-handle) > 1 THEN
      953         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      954             "encountered more than one RECORD-SOURCE.":U SKIP
      955             "The first - ":U record-source-hdl:file-name " - will be used.":U
      956                VIEW-AS ALERT-BOX ERROR.
      957     RUN get-attribute ('Key-Name':U).
      958     key-name = RETURN-VALUE.
      959     IF key-name = "":U THEN key-name = ?.
      960     IF key-name NE ? THEN DO:
      961       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      962         NO-ERROR.
      963       IF key-value NE ? THEN
      964         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      965     END.
      966   IF VALID-HANDLE (adm-object-hdl) THEN
      967       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      968     IF key-name ne ? OR different-row
      969     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      970     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      971   END PROCEDURE.
      972   PROCEDURE disable_UI :
      973     HIDE FRAME F-Main.
      974     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      975   END PROCEDURE.
      976   PROCEDURE local-initialize :
      977     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      978     run show_arh no-error.
      979   END PROCEDURE.
      980   PROCEDURE lookup-doc :
      981   define variable g-log as logical no-undo.
      982   case ot-full.ext-doc-type:
      983   when 'ot':U then do:
      984      find first ub.price-doc where ub.price-doc.doc-num = ot-full.doc-code no-lock.
      985      if not available ub.price-doc then do:
      986         message "Не найден документ переоценки для просмотра" view-as alert-box.
      987         return error.
      988      end.
      989      find ub.price-list where ub.price-list.doc-num   = ub.price-doc.doc-num  and
      990                            ub.price-list.artic     = ot-full.artic     and
      991                            ub.price-list.prod-type = ot-full.prod-type and
      992                            ub.price-list.prod-code = ot-full.prod-code no-lock no-error.
