     1854                 ot-full.road-tax-rubl-doc  = ot-full.road-tax-rubl-doc  + ub.ot-line.road-tax-rubl
     1855                 ot-full.transport-base-doc = ot-full.transport-base-doc + ub.ot-line.transport-base
     1856                 ot-full.transport-rubl-doc = ot-full.transport-rubl-doc + ub.ot-line.transport-rubl
     1857                 ot-full.other-base-doc     = ot-full.other-base-doc     + ub.ot-line.other-base
     1858                 ot-full.other-rubl-doc     = ot-full.other-rubl-doc     + ub.ot-line.other-rubl.
     1859            END.
     1860            WHEN 'crsa':U THEN DO:
     1861                 ASSIGN
     1862                 ot-full.sum-base-sale       = ot-full.sum-base-sale       + ub.ot-line.sum-base
     1863                 ot-full.sum-rubl-sale       = ot-full.sum-rubl-sale       + ub.ot-line.sum-rubl
     1864                 ot-full.vat-base-sale       = ot-full.vat-base-sale       + ub.ot-line.vat-base
     1865                 ot-full.vat-rubl-sale       = ot-full.vat-rubl-sale       + ub.ot-line.vat-rubl
     1866                 ot-full.slt-base-sale       = ot-full.slt-base-sale       + ub.ot-line.slt-base
     1867                 ot-full.slt-rubl-sale       = ot-full.slt-rubl-sale       + ub.ot-line.slt-rubl
     1868                 ot-full.excise-base-sale    = ot-full.excise-base-sale    + ub.ot-line.excise-base
     1869                 ot-full.excise-rubl-sale    = ot-full.excise-rubl-sale    + ub.ot-line.excise-rubl
     1870                 ot-full.road-tax-base-sale  = ot-full.road-tax-base-sale  + ub.ot-line.road-tax-base
     1871                 ot-full.road-tax-rubl-sale  = ot-full.road-tax-rubl-sale  + ub.ot-line.road-tax-rubl
     1872                 ot-full.transport-base-sale = ot-full.transport-base-sale + ub.ot-line.transport-base
     1873                 ot-full.transport-rubl-sale = ot-full.transport-rubl-sale + ub.ot-line.transport-rubl
     1874                 ot-full.other-base-sale     = ot-full.other-base-sale     + ub.ot-line.other-base
     1875                 ot-full.other-rubl-sale     = ot-full.other-rubl-sale     + ub.ot-line.other-rubl .
     1876            END.
     1877            OTHERWISE DO:
     1878              message "Некорректный sum-type " ub.ot-line.sum-type " при просмотре архива(b-otlina.w)." skip
     1879                      "Ошибка в расчетах."
     1880                      view-as alert-box error.
     1881            END.
     1882         END CASE.
     1883       end.
     1884   END.
     1885         OPEN QUERY b-ot-line FOR EACH ot-full.
     1886      end.
     1887      else do:
     1888   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1889   FOR EACH tt-clients,
     1890       EACH tt-goods,
     1891       EACH ub.ot-line WHERE
     1892            ub.ot-line.obj-code   = tt-clients.obj-code and
     1893            ub.ot-line.obj-type   = tt-clients.obj-type and
     1894            ub.ot-line.artic      = tt-goods.artic      and
     1895            ub.ot-line.prod-type  = tt-goods.prod-type  and
     1896            ub.ot-line.prod-code  = tt-goods.prod-code  and
     1897            ub.ot-line.fact-order > fact-order-min      and
     1898            ub.ot-line.fact-order <= fact-order-max
     1899            and ub.ot-line.sum-type <> 'cost':U
     1900            and ub.ot-line.ext-doc-type = varext-doc-type-short NO-LOCK:
     1901       if ub.ot-line.sum-type begins 'cost':U         and ub.ot-line.cat-id <> '##,##':U then next.
     1902       if ub.ot-line.sum-type begins 'cssr':U and ub.ot-line.cat-id <> '##,##':U then next.
     1903       FIND FIRST ub.trn-doc   WHERE ub.trn-doc.doc-code  = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1904       FIND FIRST ub.price-doc WHERE ub.price-doc.doc-num = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1905       IF AVAILABLE ub.trn-doc THEN
     1906          FIND FIRST ot-full WHERE ot-full.doc-code = ub.trn-doc.doc-code NO-ERROR.
     1907       ELSE
     1908          FIND FIRST ot-full WHERE ot-full.doc-code = ub.price-doc.doc-num NO-ERROR.
     1909       IF NOT AVAILABLE ot-full THEN DO:
     1910          CREATE ot-full.
     1911          ASSIGN
     1912          ot-full.doc-code     = ub.ot-line.doc-code
     1913          ot-full.doc-type     = (if available ub.trn-doc then ub.trn-doc.doc-code else " ")
     1914          ot-full.cli-type     = (if available ub.trn-doc then ub.trn-doc.cli-type else " ")
     1915          ot-full.cli-code     = (if available ub.trn-doc then ub.trn-doc.cli-code else 0)
     1916          ot-full.artic        = tt-goods.artic
     1917          ot-full.prod-type    = tt-goods.prod-type
     1918          ot-full.prod-code    = tt-goods.prod-code
     1919          ot-full.gds-type     = tt-goods.gds-type
     1920          ot-full.obj-type     = tt-clients.obj-type
     1921          ot-full.obj-code     = tt-clients.obj-code
     1922          ot-full.fact-date    = (if available ub.trn-doc then ub.trn-doc.fact-date else ub.price-doc.fact-date)
     1923          ot-full.fact-order   = (if available ub.trn-doc then ub.trn-doc.fact-order else ub.price-doc.fact-order)
     1924          ot-full.ext-doc-type = ub.ot-line.ext-doc-type.
     1925          ot-full.ext-doc-type-full =  entry(lookup(ot-full.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     1926          if available ub.trn-doc then do:
     1927             find  ub.clients where  ub.clients.obj-type = ub.trn-doc.cli-type and
     1928                                 ub.clients.obj-code = ub.trn-doc.cli-code no-lock.
     1929             assign ot-full.cli-name =  ub.clients.obj-name.
     1930          end.
     1931          else ot-full.cli-name = " ".
     1932       END.
     1933       if ot-full.gds-type = 'у':U then do:
     1934         CASE ub.ot-line.sum-type:
     1935            WHEN 'cssr':U THEN DO:
     1936              if g-cost then
     1937                 ASSIGN
     1938                 ot-full.sum-base       = ot-full.sum-base       + ub.ot-line.sum-base
     1939                 ot-full.sum-rubl       = ot-full.sum-rubl       + ub.ot-line.sum-rubl
     1940                 ot-full.vat-base       = ot-full.vat-base       + ub.ot-line.vat-base
     1941                 ot-full.vat-rubl       = ot-full.vat-rubl       + ub.ot-line.vat-rubl
     1942                 ot-full.slt-base       = ot-full.slt-base       + ub.ot-line.slt-base
     1943                 ot-full.slt-rubl       = ot-full.slt-rubl       + ub.ot-line.slt-rubl
     1944                 ot-full.excise-base    = ot-full.excise-base    + ub.ot-line.excise-base
     1945                 ot-full.excise-rubl    = ot-full.excise-rubl    + ub.ot-line.excise-rubl
     1946                 ot-full.road-tax-base  = ot-full.road-tax-base  + ub.ot-line.road-tax-base
     1947                 ot-full.road-tax-rubl  = ot-full.road-tax-rubl  + ub.ot-line.road-tax-rubl
     1948                 ot-full.transport-base = ot-full.transport-base + ub.ot-line.transport-base
     1949                 ot-full.transport-rubl = ot-full.transport-rubl + ub.ot-line.transport-rubl
     1950                 ot-full.other-base     = ot-full.other-base     + ub.ot-line.other-base
     1951                 ot-full.other-rubl     = ot-full.other-rubl     + ub.ot-line.other-rubl.
     1952              else
     1953                 ASSIGN
     1954                 ot-full.sum-base       = ?
     1955                 ot-full.sum-rubl       = ?
     1956                 ot-full.vat-base       = ?
     1957                 ot-full.vat-rubl       = ?
     1958                 ot-full.slt-base       = ?
     1959                 ot-full.slt-rubl       = ?
     1960                 ot-full.excise-base    = ?
     1961                 ot-full.excise-rubl    = ?
     1962                 ot-full.road-tax-base  = ?
     1963                 ot-full.road-tax-rubl  = ?
     1964                 ot-full.transport-base = ?
     1965                 ot-full.transport-rubl = ?
     1966                 ot-full.other-base     = ?
     1967                 ot-full.other-rubl     = ?.
     1968            END.
     1969            WHEN 'sasr':U THEN DO:
     1970                 assign ot-full.fact-qnty = ot-full.fact-qnty + ub.ot-line.fact-qnty.
     1971                 ASSIGN
     1972                 ot-full.sum-base-doc       = ot-full.sum-base-doc       + ub.ot-line.sum-base
     1973                 ot-full.sum-rubl-doc       = ot-full.sum-rubl-doc       + ub.ot-line.sum-rubl
     1974                 ot-full.vat-base-doc       = ot-full.vat-base-doc       + ub.ot-line.vat-base
     1975                 ot-full.vat-rubl-doc       = ot-full.vat-rubl-doc       + ub.ot-line.vat-rubl
     1976                 ot-full.slt-base-doc       = ot-full.slt-base-doc       + ub.ot-line.slt-base
     1977                 ot-full.slt-rubl-doc       = ot-full.slt-rubl-doc       + ub.ot-line.slt-rubl
     1978                 ot-full.excise-base-doc    = ot-full.excise-base-doc    + ub.ot-line.excise-base
     1979                 ot-full.excise-rubl-doc    = ot-full.excise-rubl-doc    + ub.ot-line.excise-rubl
     1980                 ot-full.road-tax-base-doc  = ot-full.road-tax-base-doc  + ub.ot-line.road-tax-base
     1981                 ot-full.road-tax-rubl-doc  = ot-full.road-tax-rubl-doc  + ub.ot-line.road-tax-rubl
     1982                 ot-full.transport-base-doc = ot-full.transport-base-doc + ub.ot-line.transport-base
     1983                 ot-full.transport-rubl-doc = ot-full.transport-rubl-doc + ub.ot-line.transport-rubl
     1984                 ot-full.other-base-doc     = ot-full.other-base-doc     + ub.ot-line.other-base
     1985                 ot-full.other-rubl-doc     = ot-full.other-rubl-doc     + ub.ot-line.other-rubl.
     1986            END.
     1987            WHEN 'cgsr':U THEN DO:
     1988                 ASSIGN
     1989                 ot-full.sum-base-sale       = ot-full.sum-base-sale       + ub.ot-line.sum-base
     1990                 ot-full.sum-rubl-sale       = ot-full.sum-rubl-sale       + ub.ot-line.sum-rubl
     1991                 ot-full.vat-base-sale       = ot-full.vat-base-sale       + ub.ot-line.vat-base
     1992                 ot-full.vat-rubl-sale       = ot-full.vat-rubl-sale       + ub.ot-line.vat-rubl
     1993                 ot-full.slt-base-sale       = ot-full.slt-base-sale       + ub.ot-line.slt-base
     1994                 ot-full.slt-rubl-sale       = ot-full.slt-rubl-sale       + ub.ot-line.slt-rubl
     1995                 ot-full.excise-base-sale    = ot-full.excise-base-sale    + ub.ot-line.excise-base
     1996                 ot-full.excise-rubl-sale    = ot-full.excise-rubl-sale    + ub.ot-line.excise-rubl
     1997                 ot-full.road-tax-base-sale  = ot-full.road-tax-base-sale  + ub.ot-line.road-tax-base
     1998                 ot-full.road-tax-rubl-sale  = ot-full.road-tax-rubl-sale  + ub.ot-line.road-tax-rubl
     1999                 ot-full.transport-base-sale = ot-full.transport-base-sale + ub.ot-line.transport-base
     2000                 ot-full.transport-rubl-sale = ot-full.transport-rubl-sale + ub.ot-line.transport-rubl
     2001                 ot-full.other-base-sale     = ot-full.other-base-sale     + ub.ot-line.other-base
     2002                 ot-full.other-rubl-sale     = ot-full.other-rubl-sale     + ub.ot-line.other-rubl .
     2003            END.
     2004            OTHERWISE DO:
     2005              message "Некорректный sum-type " ub.ot-line.sum-type " при просмотре архива(b-otlina.w)." skip
     2006                      "Ошибка в расчетах."
     2007                      view-as alert-box error.
     2008            END.
     2009         END CASE.
     2010       end.
     2011       else do:
     2012         CASE ub.ot-line.sum-type:
     2013            WHEN 'cost':U THEN DO:
     2014              assign ot-full.fact-qnty = ot-full.fact-qnty + ub.ot-line.fact-qnty.
     2015              if g-cost then
     2016                 ASSIGN
     2017                 ot-full.sum-base       = ot-full.sum-base       + ub.ot-line.sum-base
     2018                 ot-full.sum-rubl       = ot-full.sum-rubl       + ub.ot-line.sum-rubl
     2019                 ot-full.vat-base       = ot-full.vat-base       + ub.ot-line.vat-base
     2020                 ot-full.vat-rubl       = ot-full.vat-rubl       + ub.ot-line.vat-rubl
     2021                 ot-full.slt-base       = ot-full.slt-base       + ub.ot-line.slt-base
     2022                 ot-full.slt-rubl       = ot-full.slt-rubl       + ub.ot-line.slt-rubl
     2023                 ot-full.excise-base    = ot-full.excise-base    + ub.ot-line.excise-base
     2024                 ot-full.excise-rubl    = ot-full.excise-rubl    + ub.ot-line.excise-rubl
     2025                 ot-full.road-tax-base  = ot-full.road-tax-base  + ub.ot-line.road-tax-base
     2026                 ot-full.road-tax-rubl  = ot-full.road-tax-rubl  + ub.ot-line.road-tax-rubl
     2027                 ot-full.transport-base = ot-full.transport-base + ub.ot-line.transport-base
     2028                 ot-full.transport-rubl = ot-full.transport-rubl + ub.ot-line.transport-rubl
     2029                 ot-full.other-base     = ot-full.other-base     + ub.ot-line.other-base
     2030                 ot-full.other-rubl     = ot-full.other-rubl     + ub.ot-line.other-rubl.
     2031              else
     2032                 ASSIGN
     2033                 ot-full.sum-base       = ?
     2034                 ot-full.sum-rubl       = ?
     2035                 ot-full.vat-base       = ?
     2036                 ot-full.vat-rubl       = ?
     2037                 ot-full.slt-base       = ?
     2038                 ot-full.slt-rubl       = ?
     2039                 ot-full.excise-base    = ?
     2040                 ot-full.excise-rubl    = ?
     2041                 ot-full.road-tax-base  = ?
     2042                 ot-full.road-tax-rubl  = ?
     2043                 ot-full.transport-base = ?
     2044                 ot-full.transport-rubl = ?
     2045                 ot-full.other-base     = ?
     2046                 ot-full.other-rubl     = ?.
     2047            END.
     2048            WHEN 'sale':U THEN DO:
     2049                 ASSIGN
     2050                 ot-full.sum-base-doc       = ot-full.sum-base-doc       + ub.ot-line.sum-base
     2051                 ot-full.sum-rubl-doc       = ot-full.sum-rubl-doc       + ub.ot-line.sum-rubl
     2052                 ot-full.vat-base-doc       = ot-full.vat-base-doc       + ub.ot-line.vat-base
     2053                 ot-full.vat-rubl-doc       = ot-full.vat-rubl-doc       + ub.ot-line.vat-rubl
     2054                 ot-full.slt-base-doc       = ot-full.slt-base-doc       + ub.ot-line.slt-base
     2055                 ot-full.slt-rubl-doc       = ot-full.slt-rubl-doc       + ub.ot-line.slt-rubl
     2056                 ot-full.excise-base-doc    = ot-full.excise-base-doc    + ub.ot-line.excise-base
     2057                 ot-full.excise-rubl-doc    = ot-full.excise-rubl-doc    + ub.ot-line.excise-rubl
     2058                 ot-full.road-tax-base-doc  = ot-full.road-tax-base-doc  + ub.ot-line.road-tax-base
     2059                 ot-full.road-tax-rubl-doc  = ot-full.road-tax-rubl-doc  + ub.ot-line.road-tax-rubl
     2060                 ot-full.transport-base-doc = ot-full.transport-base-doc + ub.ot-line.transport-base
     2061                 ot-full.transport-rubl-doc = ot-full.transport-rubl-doc + ub.ot-line.transport-rubl
     2062                 ot-full.other-base-doc     = ot-full.other-base-doc     + ub.ot-line.other-base
     2063                 ot-full.other-rubl-doc     = ot-full.other-rubl-doc     + ub.ot-line.other-rubl.
     2064            END.
     2065            WHEN 'crsa':U THEN DO:
     2066                 ASSIGN
     2067                 ot-full.sum-base-sale       = ot-full.sum-base-sale       + ub.ot-line.sum-base
     2068                 ot-full.sum-rubl-sale       = ot-full.sum-rubl-sale       + ub.ot-line.sum-rubl
     2069                 ot-full.vat-base-sale       = ot-full.vat-base-sale       + ub.ot-line.vat-base
     2070                 ot-full.vat-rubl-sale       = ot-full.vat-rubl-sale       + ub.ot-line.vat-rubl
     2071                 ot-full.slt-base-sale       = ot-full.slt-base-sale       + ub.ot-line.slt-base
     2072                 ot-full.slt-rubl-sale       = ot-full.slt-rubl-sale       + ub.ot-line.slt-rubl
     2073                 ot-full.excise-base-sale    = ot-full.excise-base-sale    + ub.ot-line.excise-base
     2074                 ot-full.excise-rubl-sale    = ot-full.excise-rubl-sale    + ub.ot-line.excise-rubl
     2075                 ot-full.road-tax-base-sale  = ot-full.road-tax-base-sale  + ub.ot-line.road-tax-base
     2076                 ot-full.road-tax-rubl-sale  = ot-full.road-tax-rubl-sale  + ub.ot-line.road-tax-rubl
     2077                 ot-full.transport-base-sale = ot-full.transport-base-sale + ub.ot-line.transport-base
     2078                 ot-full.transport-rubl-sale = ot-full.transport-rubl-sale + ub.ot-line.transport-rubl
     2079                 ot-full.other-base-sale     = ot-full.other-base-sale     + ub.ot-line.other-base
     2080                 ot-full.other-rubl-sale     = ot-full.other-rubl-sale     + ub.ot-line.other-rubl .
     2081            END.
     2082            OTHERWISE DO:
     2083              message "Некорректный sum-type " ub.ot-line.sum-type " при просмотре архива(b-otlina.w)." skip
     2084                      "Ошибка в расчетах."
     2085                      view-as alert-box error.
     2086            END.
     2087         END CASE.
     2088       end.
     2089   END.
     2090         OPEN QUERY b-ot-line FOR EACH ot-full.
     2091      end.
     2092   end.
     2093   END PROCEDURE.
     2094   PROCEDURE state-changed :
     2095     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2096     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2097     CASE p-state:
     2098          when 'detail' then do:
     2099             assign varh_arh = p-issuer-hdl.
     2100          end.
     2101       WHEN "update-begin":U THEN
     2102       DO:
     2103           adm-brs-in-update = yes.
     2104           RUN dispatch ('enable-fields':U).
     2105           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2106           DO:
     2107             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     2108             RUN new-state('update-complete':U).
     2109           END.
     2110           ELSE DO:
     2111             RUN dispatch ('apply-entry':U).
     2112             RUN new-state('update':U).
     2113           END.
     2114       END.
     2115       WHEN "update":U THEN
     2116         DO:
     2117           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
     2118           RUN get-link-handle IN adm-broker-hdl
     2119               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
     2120                   NO-ERROR.
     2121           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
     2122             b-ot-line:SENSITIVE IN FRAME F-Main = no.
     2123         END.
     2124       WHEN "update-complete":U THEN DO:
     2125           b-ot-line:SENSITIVE IN FRAME F-Main = yes.
     2126           adm-brs-in-update = no.
     2127           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
     2128           IF RETURN-VALUE NE "YES":U THEN
     2129           DO:
     2130             IF NUM-RESULTS("b-ot-line":U) NE ? AND
     2131                NUM-RESULTS("b-ot-line":U) NE 0
     2132             THEN DO:
     2133               GET CURRENT b-ot-line.
     2134               RUN dispatch ('row-changed':U).
     2135             END.
     2136           END.
     2137           RUN new-state ('update-complete':U).
     2138       END.
     2139       WHEN "delete-complete":U THEN DO:
     2140          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
     2141          sts = b-ot-line:DELETE-CURRENT-ROW() IN FRAME F-Main.
     2142          IF NUM-RESULTS("b-ot-line":U) = 0 THEN
     2143            RUN notify('row-available':U).
     2144       END.
     2145       WHEN   'first-record':U        OR
     2146         WHEN 'last-record':U         OR
     2147         WHEN 'only-record':U         OR
     2148         WHEN 'not-first-or-last':U   OR
     2149         WHEN 'no-record-available':U OR
     2150         WHEN 'no-external-record-available':U THEN
     2151           RUN set-attribute-list('Query-Position=':U + p-state).
     2152     END CASE.
     2153   END PROCEDURE.
     2154   FUNCTION func-excise RETURNS DECIMAL
     2155         ( buffer bf_ot-full for ot-full ) :
     2156       if varrubl-base = 1 then return bf_ot-full.excise-rubl.
     2157                           else return bf_ot-full.excise-base.
     2158   END FUNCTION.
     2159   FUNCTION func-excise-doc RETURNS DECIMAL
     2160      ( buffer bf_ot-full for ot-full ) :
     2161       if varrubl-base = 1 then return bf_ot-full.excise-rubl-doc.
     2162                           else return bf_ot-full.excise-base-doc.
     2163   END FUNCTION.
     2164   FUNCTION func-other RETURNS DECIMAL
     2165       ( buffer bf_ot-full for ot-full ) :
     2166       if varrubl-base = 1 then return bf_ot-full.other-rubl.
     2167                           else return bf_ot-full.other-base.
     2168   END FUNCTION.
     2169   FUNCTION func-other-doc RETURNS DECIMAL
     2170       ( buffer bf_ot-full for ot-full ) :
     2171       if varrubl-base = 1 then return bf_ot-full.other-rubl-doc.
     2172                           else return bf_ot-full.other-base-doc.
     2173   END FUNCTION.
     2174   FUNCTION func-price-doc RETURNS DECIMAL
     2175     ( buffer bf_ot-full for ot-full ) :
     2176       if varrubl-base = 1 then return (bf_ot-full.sum-rubl-doc / bf_ot-full.fact-qnty).
     2177                           else return (bf_ot-full.sum-base-doc / bf_ot-full.fact-qnty).
     2178   END FUNCTION.
     2179   FUNCTION func-price-sale RETURNS DECIMAL
     2180     ( buffer bf_ot-full for ot-full ) :
