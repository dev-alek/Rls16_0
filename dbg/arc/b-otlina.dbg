     1681   else do:
     1682      if g-cost
     1683      then do:
     1684   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   FOR EACH tt-clients,
     1686       EACH tt-goods,
     1687       EACH ub.ot-line WHERE
     1688            ub.ot-line.obj-code   = tt-clients.obj-code and
     1689            ub.ot-line.obj-type   = tt-clients.obj-type and
     1690            ub.ot-line.artic      = tt-goods.artic      and
     1691            ub.ot-line.prod-type  = tt-goods.prod-type  and
     1692            ub.ot-line.prod-code  = tt-goods.prod-code  and
     1693            ub.ot-line.fact-order > fact-order-min      and
     1694            ub.ot-line.fact-order <= fact-order-max
     1695            and ub.ot-line.ext-doc-type = varext-doc-type-short NO-LOCK:
     1696       if ub.ot-line.sum-type begins 'cost':U         and ub.ot-line.cat-id <> '##,##':U then next.
     1697       if ub.ot-line.sum-type begins 'cssr':U and ub.ot-line.cat-id <> '##,##':U then next.
     1698       FIND FIRST ub.trn-doc   WHERE ub.trn-doc.doc-code  = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1699       FIND FIRST ub.price-doc WHERE ub.price-doc.doc-num = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1700       IF AVAILABLE ub.trn-doc THEN
     1701          FIND FIRST ot-full WHERE ot-full.doc-code = ub.trn-doc.doc-code NO-ERROR.
     1702       ELSE
     1703          FIND FIRST ot-full WHERE ot-full.doc-code = ub.price-doc.doc-num NO-ERROR.
     1704       IF NOT AVAILABLE ot-full THEN DO:
     1705          CREATE ot-full.
     1706          ASSIGN
     1707          ot-full.doc-code     = ub.ot-line.doc-code
     1708          ot-full.doc-type     = (if available ub.trn-doc then ub.trn-doc.doc-code else " ")
     1709          ot-full.cli-type     = (if available ub.trn-doc then ub.trn-doc.cli-type else " ")
     1710          ot-full.cli-code     = (if available ub.trn-doc then ub.trn-doc.cli-code else 0)
     1711          ot-full.artic        = tt-goods.artic
     1712          ot-full.prod-type    = tt-goods.prod-type
     1713          ot-full.prod-code    = tt-goods.prod-code
     1714          ot-full.gds-type     = tt-goods.gds-type
     1715          ot-full.obj-type     = tt-clients.obj-type
     1716          ot-full.obj-code     = tt-clients.obj-code
     1717          ot-full.fact-date    = (if available ub.trn-doc then ub.trn-doc.fact-date else ub.price-doc.fact-date)
     1718          ot-full.fact-order   = (if available ub.trn-doc then ub.trn-doc.fact-order else ub.price-doc.fact-order)
     1719          ot-full.ext-doc-type = ub.ot-line.ext-doc-type.
     1720          ot-full.ext-doc-type-full =  entry(lookup(ot-full.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     1721          if available ub.trn-doc then do:
     1722             find  ub.clients where  ub.clients.obj-type = ub.trn-doc.cli-type and
     1723                                 ub.clients.obj-code = ub.trn-doc.cli-code no-lock.
     1724             assign ot-full.cli-name =  ub.clients.obj-name.
     1725          end.
     1726          else ot-full.cli-name = " ".
     1727       END.
     1728       if ot-full.gds-type = 'у':U then do:
     1729         CASE ub.ot-line.sum-type:
     1730            WHEN 'cssr':U THEN DO:
     1731              if g-cost then
     1732                 ASSIGN
     1733                 ot-full.sum-base       = ot-full.sum-base       + ub.ot-line.sum-base
     1734                 ot-full.sum-rubl       = ot-full.sum-rubl       + ub.ot-line.sum-rubl
     1735                 ot-full.vat-base       = ot-full.vat-base       + ub.ot-line.vat-base
     1736                 ot-full.vat-rubl       = ot-full.vat-rubl       + ub.ot-line.vat-rubl
