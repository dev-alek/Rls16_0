     1409                 ot-full.road-tax-rubl  = ot-full.road-tax-rubl  + ub.ot-line.road-tax-rubl
     1410                 ot-full.transport-base = ot-full.transport-base + ub.ot-line.transport-base
     1411                 ot-full.transport-rubl = ot-full.transport-rubl + ub.ot-line.transport-rubl
     1412                 ot-full.other-base     = ot-full.other-base     + ub.ot-line.other-base
     1413                 ot-full.other-rubl     = ot-full.other-rubl     + ub.ot-line.other-rubl.
     1414              else
     1415                 ASSIGN
     1416                 ot-full.sum-base       = ?
     1417                 ot-full.sum-rubl       = ?
     1418                 ot-full.vat-base       = ?
     1419                 ot-full.vat-rubl       = ?
     1420                 ot-full.slt-base       = ?
     1421                 ot-full.slt-rubl       = ?
     1422                 ot-full.excise-base    = ?
     1423                 ot-full.excise-rubl    = ?
     1424                 ot-full.road-tax-base  = ?
     1425                 ot-full.road-tax-rubl  = ?
     1426                 ot-full.transport-base = ?
     1427                 ot-full.transport-rubl = ?
     1428                 ot-full.other-base     = ?
     1429                 ot-full.other-rubl     = ?.
