     1506          ot-full.prod-code    = tt-goods.prod-code
     1507          ot-full.gds-type     = tt-goods.gds-type
     1508          ot-full.obj-type     = tt-clients.obj-type
     1509          ot-full.obj-code     = tt-clients.obj-code
     1510          ot-full.fact-date    = (if available ub.trn-doc then ub.trn-doc.fact-date else ub.price-doc.fact-date)
