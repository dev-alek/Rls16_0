     1124                          ub.doc-line.artic     = ot-full.artic     and
     1125                          ub.doc-line.prod-type = ot-full.prod-type and
     1126                          ub.doc-line.prod-code = ot-full.prod-code no-lock no-error.
     1127      assign line-rec = recid(ub.doc-line).
     1128      run str/trn-lkp.p (varparentproc, recid(ub.trn-doc), recid(ub.doc-line)).
     1129   end.
     1130   end case.
     1131   END PROCEDURE.
     1132   PROCEDURE return-up :
     1133   END PROCEDURE.
     1134   PROCEDURE send-records :
     1135     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1136     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1137     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1138     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1139     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1140     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1141         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1142         CASE ENTRY(i, p-tbl-list):
     1143       WHEN "ot-full":U THEN p-rowid-list = p-rowid-list +
     1144           IF AVAILABLE ot-full THEN STRING(ROWID(ot-full))
     1145           ELSE "?":U.
     1146           OTHERWISE
     1147           DO:
     1148               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1149                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1150               IF link-handle NE "":U THEN
     1151               DO:
     1152                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1153                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1154                               "encountered more than one RECORD-SOURCE.":U SKIP
     1155                               "The first will be used.":U
     1156                               VIEW-AS ALERT-BOX ERROR.
     1157                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1158                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1159                   p-rowid-list = p-rowid-list + rowid-string.
     1160               END.
     1161               ELSE
     1162               DO:
     1163                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1164                           "does not match tables in send-records":U
     1165                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1166                           "Check that objects are linked properly and that":U
     1167                           "database qualification is consistent.":U
     1168                       VIEW-AS ALERT-BOX ERROR.
     1169                   RETURN ERROR.
     1170               END.
     1171           END.
     1172           END CASE.
     1173       END.
     1174   END PROCEDURE.
     1175   PROCEDURE show_arh :
     1176   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'main-handle':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "main-handle" + " для получения данных." .                    end.
     1178   assign varh_caller-main = widget-handle(return-value).
     1179   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varis-calend':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varis-calend" + " для получения данных." .                    end.
     1180   assign varis-calend = integer(return-value).
     1181   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varis-shift-num':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varis-shift-num" + " для получения данных." .                    end.
     1182   assign varis-shift-num = if return-value = 'yes' then yes else no.
     1183   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'vardate-start':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "vardate-start" + " для получения данных." .                    end.
     1184   assign vardate-start = date(return-value).
     1185   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'vardate-end':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "vardate-end" + " для получения данных." .                    end.
     1186   assign vardate-end = date(return-value).
     1187   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varshift-start':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varshift-start" + " для получения данных." .                    end.
     1188   assign varshift-start = integer(return-value).
     1189   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varshift-end':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varshift-end" + " для получения данных." .                    end.
     1190   assign varshift-end = integer(return-value).
     1191   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varext-doc-type':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varext-doc-type" + " для получения данных." .                    end.
     1192   assign varext-doc-type = return-value.
     1193   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'rubl-base':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "rubl-base" + " для получения данных." .                    end.
     1194   assign varrubl-base = integer(return-value).
     1195   if varext-doc-type = "?" then do:
     1196      message "Не считаны атрибуты для запроса." view-as alert-box error.
     1197      return error.
     1198   end.
     1199   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   assign fact-order-min = 0
     1201          fact-order-max = 0.
     1202   for each tt-clients:
     1203      run dfactord (input  tt-clients.obj-type,
     1204                    input  tt-clients.obj-code,
     1205                    input  (if varis-calend = 1 then yes else no),
     1206                    input  varis-shift-num,
     1207                    input  vardate-start,
     1208                    input  vardate-end,
     1209                    input  varshift-start,
     1210                    input  varshift-end,
     1211                    output fact-order-start,
     1212                    output fact-order-end) no-error.
     1213      if error-status:error then do:
     1214         message "Ошибка при определении диапазона данных."
     1215         view-as alert-box error.
     1216         return no-apply.
     1217      end.
     1218      if fact-order-end = 0 then next.
     1219      if fact-order-start > fact-order-min then assign fact-order-min = fact-order-start.
     1220      if fact-order-end   > fact-order-max then assign fact-order-max = fact-order-end.
     1221   end.
     1222   assign varsum-type = "all".
     1223   for each ot-full:
     1224       delete ot-full.
     1225   end.
     1226   define variable g-cost as logical no-undo.
     1227   assign frame F-Main:title = "Документы: " +
     1228   (if varext-doc-type = 'all' then 'Все' else varext-doc-type).
     1229   if varext-doc-type <> 'all' then
     1230      assign varext-doc-type-short = entry(lookup(varext-doc-type, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U), 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     1231   define variable v-chk-act-host-code as integer   no-undo .
     1232   assign
     1233     g-cost = true
     1234   .
     1235   scan_block:
     1236   for each tt-clients
     1237   on error undo, return error return-value
     1238   :
     1239   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1241     (input  tt-clients.obj-type
     1242     ,input  tt-clients.obj-code
     1243     ,output v-chk-act-host-code
     1244     )  .
     1245   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   do:
     1247     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1248       (input  v-cntxt-db-num
     1249       ,input  v-cntxt-userid
     1250       ,input  0
     1251       ,input  'actn_archive_cost':U
     1252       ,input  'object':U
     1253       ,input  v-chk-act-host-code
     1254       ,input  tt-clients.obj-type
     1255       ,input  tt-clients.obj-code
     1256       ,input  0
     1257       ,input  0
     1258       ,input  0
     1259       ,input  false
     1260       ,output g-cost
     1261       )  .
     1262   end.
     1263     if g-cost <> true
     1264     then do:
     1265       leave scan_block.
     1266     end.
     1267   end.
     1268   if varext-doc-type = 'all'
     1269   then do:
     1270      if g-cost
     1271      then do:
     1272   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   FOR EACH tt-clients,
     1274       EACH tt-goods,
     1275       EACH ub.ot-line WHERE
     1276            ub.ot-line.obj-code   = tt-clients.obj-code and
     1277            ub.ot-line.obj-type   = tt-clients.obj-type and
     1278            ub.ot-line.artic      = tt-goods.artic      and
     1279            ub.ot-line.prod-type  = tt-goods.prod-type  and
     1280            ub.ot-line.prod-code  = tt-goods.prod-code  and
     1281            ub.ot-line.fact-order > fact-order-min      and
     1282            ub.ot-line.fact-order <= fact-order-max
     1283              NO-LOCK:
     1284       if ub.ot-line.sum-type begins 'cost':U         and ub.ot-line.cat-id <> '##,##':U then next.
     1285       if ub.ot-line.sum-type begins 'cssr':U and ub.ot-line.cat-id <> '##,##':U then next.
     1286       FIND FIRST ub.trn-doc   WHERE ub.trn-doc.doc-code  = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1287       FIND FIRST ub.price-doc WHERE ub.price-doc.doc-num = ub.ot-line.doc-code NO-LOCK NO-ERROR.
     1288       IF AVAILABLE ub.trn-doc THEN
     1289          FIND FIRST ot-full WHERE ot-full.doc-code = ub.trn-doc.doc-code NO-ERROR.
     1290       ELSE
     1291          FIND FIRST ot-full WHERE ot-full.doc-code = ub.price-doc.doc-num NO-ERROR.
     1292       IF NOT AVAILABLE ot-full THEN DO:
     1293          CREATE ot-full.
     1294          ASSIGN
     1295          ot-full.doc-code     = ub.ot-line.doc-code
     1296          ot-full.doc-type     = (if available ub.trn-doc then ub.trn-doc.doc-code else " ")
     1297          ot-full.cli-type     = (if available ub.trn-doc then ub.trn-doc.cli-type else " ")
     1298          ot-full.cli-code     = (if available ub.trn-doc then ub.trn-doc.cli-code else 0)
     1299          ot-full.artic        = tt-goods.artic
     1300          ot-full.prod-type    = tt-goods.prod-type
     1301          ot-full.prod-code    = tt-goods.prod-code
