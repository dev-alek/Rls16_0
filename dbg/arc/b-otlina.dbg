     1468                      view-as alert-box error.
     1469            END.
     1470         END CASE.
     1471       end.
     1472   END.
     1473         OPEN QUERY b-ot-line FOR EACH ot-full.
     1474      end.
     1475      else do:
     1476   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   FOR EACH tt-clients,
     1478       EACH tt-goods,
     1479       EACH ub.ot-line WHERE
     1480            ub.ot-line.obj-code   = tt-clients.obj-code and
