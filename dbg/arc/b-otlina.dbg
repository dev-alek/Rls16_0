     1018       ,input  ub.trn-doc.obj-type
     1019       ,input  ub.trn-doc.obj-code
     1020       ,input  0
     1021       ,input  0
     1022       ,input  0
     1023       ,input  true
     1024       ,output g-log
     1025       )  .
     1026   end.
     1027        end.
