     1303          ot-full.obj-type     = tt-clients.obj-type
     1304          ot-full.obj-code     = tt-clients.obj-code
     1305          ot-full.fact-date    = (if available ub.trn-doc then ub.trn-doc.fact-date else ub.price-doc.fact-date)
