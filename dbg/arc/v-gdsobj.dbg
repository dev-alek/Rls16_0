      136         VIEW-AS TEXT
      137        SIZE 7 BY .67
      138        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      139   DEFINE RECTANGLE RECT-1
      140        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      141        SIZE 36.3 BY 5.03.
      142   DEFINE RECTANGLE RECT-2
      143        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      144        SIZE 43.3 BY 5.03.
      145   DEFINE RECTANGLE RECT-3
      146        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      147        SIZE 79.4 BY 2.07.
      148   DEFINE FRAME F-Main
      149        TT-gds-obj.fact-qnty AT ROW 1.53 COL 22 COLON-ALIGNED NO-LABEL
      150             VIEW-AS FILL-IN
