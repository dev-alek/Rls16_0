      152        TT-gds-obj.price-sale AT ROW 2.43 COL 55.5 COLON-ALIGNED NO-LABEL
      153             VIEW-AS FILL-IN
      154             SIZE 22.9 BY 1
      155        TT-gds-obj.fact-cli-qnty AT ROW 2.8 COL 22 COLON-ALIGNED NO-LABEL
      156             VIEW-AS FILL-IN
      157             SIZE 13 BY 1
      158        TT-gds-obj.free-qnty AT ROW 3.93 COL 22 COLON-ALIGNED NO-LABEL
      159             VIEW-AS FILL-IN
      160             SIZE 13 BY 1
      161        TT-gds-obj.fact-sale AT ROW 4 COL 55.6 COLON-ALIGNED NO-LABEL
      162             VIEW-AS FILL-IN
      163             SIZE 23 BY 1
      164        TT-gds-obj.avrg-qnty AT ROW 5.13 COL 22 COLON-ALIGNED NO-LABEL
      165             VIEW-AS FILL-IN
      166             SIZE 13 BY 1
      167        TT-gds-obj.fact-base AT ROW 7.53 COL 23.8 COLON-ALIGNED NO-LABEL
      168             VIEW-AS FILL-IN
      169             SIZE 22.9 BY 1
      170        TT-gds-obj.fact-rubl AT ROW 7.53 COL 52.1 COLON-ALIGNED NO-LABEL
      171             VIEW-AS FILL-IN
      172             SIZE 23 BY 1
      173        FILL-IN-1 AT ROW 6.5 COL 24 COLON-ALIGNED NO-LABEL
      174        FILL-IN-2 AT ROW 6.5 COL 52.5 COLON-ALIGNED NO-LABEL
      175        "Положительные партии" VIEW-AS TEXT
      176             SIZE 21 BY .93 AT ROW 5.13 COL 2.8
      177        "Факт.кол-во" VIEW-AS TEXT
      178             SIZE 21 BY .93 AT ROW 1.67 COL 2.8
      179        "Сумма в прод.ценах" VIEW-AS TEXT
      180             SIZE 18.1 BY .93 AT ROW 4.03 COL 38.9
      181        "Сумма в учетных ценах" VIEW-AS TEXT
      182             SIZE 21.9 BY .93 AT ROW 7.53 COL 2.5
      183        "Продажная цена" VIEW-AS TEXT
      184             SIZE 17.9 BY .93 AT ROW 2.43 COL 39.1
      185        "Факт.кол-во(ед.пост.)" VIEW-AS TEXT
      186             SIZE 21 BY .93 AT ROW 2.8 COL 2.8
      187        "Свободно" VIEW-AS TEXT
      188             SIZE 21 BY .93 AT ROW 4 COL 2.8
      189        RECT-1 AT ROW 1.2 COL 1.1
      190        RECT-2 AT ROW 1.2 COL 37.9
      191        RECT-3 AT ROW 6.93 COL 1.6
      192       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      193            SIDE-LABELS NO-UNDERLINE THREE-D
      194            AT COL 1 ROW 1 SCROLLABLE .
      195   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      196   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      197   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      198   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      199   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      200   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      201   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      202   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      203         adm-object-hdl = FRAME F-Main:HANDLE.
      204   RUN ensure-broker.
      205   THIS-PROCEDURE:ADM-DATA =
      206        'ADM1.1~`':U +
      207        'SmartObject~`':U +
      208        '~`':U +
      209        'NO ~`':U +
      210        '~`':U +
      211        '~`':U +
      212        'TT-gds-obj~`':U +
      213        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      214           + "~`":U +
      215        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      216        'Record-Source,Record-Target,TableIO-Target~`':U +
      217        '~`':U +
      218        '~`~`~`~`~`~`~`~`~`~`~`':U +
      219        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      220            THEN "^^":U
      221        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      222             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      223   PROCEDURE adm-apply-entry :
      224     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      225   END PROCEDURE.
      226   PROCEDURE adm-destroy :
      227    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      228   END PROCEDURE.
      229   PROCEDURE adm-disable :
      230       DISABLE RECT-1 RECT-2 RECT-3 FILL-IN-1 FILL-IN-2 WITH FRAME F-Main.
      231       RUN dispatch ('disable-fields':U).
      232       RUN set-attribute-list ('ENABLED=no':U).
      233       RETURN.
      234   END PROCEDURE.
      235   PROCEDURE adm-edit-attribute-list :
      236         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      237         RETURN.
      238   END PROCEDURE.
      239   PROCEDURE adm-enable :
      240       ENABLE UNLESS-HIDDEN RECT-1 RECT-2 RECT-3 FILL-IN-1 FILL-IN-2 WITH FRAME F-Main.
      241       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      242       RUN set-attribute-list ('ENABLED=yes':U).
      243       RETURN.
      244   END PROCEDURE.
      245   PROCEDURE adm-exit :
      246        RUN notify ('exit':U).
      247     RETURN.
      248   END PROCEDURE.
      249   PROCEDURE adm-hide :
      250     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      251   END PROCEDURE.
      252   PROCEDURE adm-initialize :
      253     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      254   END PROCEDURE.
      255   PROCEDURE adm-show-errors :
      256       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      257       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      258           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      259       END.
      260       RETURN.
      261   END PROCEDURE.
      262   PROCEDURE adm-UIB-mode :
      263     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      264   END PROCEDURE.
      265   PROCEDURE adm-view :
      266     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      267   END PROCEDURE.
      268   PROCEDURE dispatch :
      269       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      270       RUN broker-dispatch IN adm-broker-hdl
      271           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      272       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      273   END PROCEDURE.
      274   PROCEDURE ensure-broker :
      275   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      276   IF RETURN-VALUE NE "ADM-Broker":U THEN
      277   DO:
      278       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      279       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      280   END.
      281   END PROCEDURE.
      282   PROCEDURE get-attribute :
      283     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      284     RUN broker-get-attribute IN adm-broker-hdl
      285         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      286     RETURN RETURN-VALUE.
      287   END PROCEDURE.
      288   PROCEDURE get-attribute-list :
      289     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      290     RUN broker-get-attribute-list IN adm-broker-hdl
      291         (INPUT THIS-PROCEDURE,
      292          INPUT ?,
      293          OUTPUT p-attr-list) NO-ERROR.
      294     RETURN.
      295   END PROCEDURE.
      296   PROCEDURE new-state :
      297     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      298     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      299     RETURN.
      300   END PROCEDURE.
      301   PROCEDURE notify :
      302     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      303     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      304     IF RETURN-VALUE = "ADM-ERROR":U THEN
      305         RETURN "ADM-ERROR":U.
      306     RETURN.
      307   END PROCEDURE.
      308   PROCEDURE set-attribute-list :
      309     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      310     RUN ensure-broker.
      311     RUN broker-set-attribute-list IN adm-broker-hdl
      312         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      313     RETURN.
      314   END PROCEDURE.
      315   PROCEDURE set-position :
      316       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      317       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      318       IF VALID-HANDLE(adm-object-hdl) THEN
      319       DO:
      320         ASSIGN adm-object-hdl:ROW    =   p-row
      321                adm-object-hdl:COLUMN =   p-col.
      322       END.
      323       RETURN.
      324   END PROCEDURE.
      325   PROCEDURE adm-display-fields :
      326       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      327       RETURN.
      328   END PROCEDURE.
      329   PROCEDURE adm-open-query :
      330     RETURN.
      331   END PROCEDURE.
      332   PROCEDURE adm-row-changed :
      333         IF VALID-HANDLE(adm-object-hdl) THEN
      334           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      335         RUN notify ('row-available':U).
      336         RETURN.
      337   END PROCEDURE.
      338   PROCEDURE reposition-query :
      339       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      340       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      341       RETURN.
      342   END PROCEDURE.
      343     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      344     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      345     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      346     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      347     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      348     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      349     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      350     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      351     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      352     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      353     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      354     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      355     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      356     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      357     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      358     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      359     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      360     IF "TT-gds-obj":U = "":U THEN
      361       RUN modify-list-attribute IN adm-broker-hdl
      362         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      363     RUN use-create-on-add(?).
      364   PROCEDURE adm-add-record :
      365      DEFINE VARIABLE trans-hdl-string  AS CHARACTER NO-UNDO.
      366      DEFINE VARIABLE cntr              AS INTEGER   NO-UNDO.
      367      DEFINE VARIABLE temp-rowid        AS ROWID     NO-UNDO.
      368      DEFINE VARIABLE saved-dictdb      AS CHARACTER NO-UNDO.
      369         IF group-assign-target = ? THEN
      370           RUN init-group-assign.
      371         IF NOT group-assign-target THEN
      372           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      373         ASSIGN adm-first-table = ROWID(TT-gds-obj)
      374                adm-new-record = yes
      375                adm-adding-record = yes
      376                adm-query-empty = IF AVAILABLE(TT-gds-obj)
      377                                  THEN no ELSE yes.
      378         RUN set-attribute-list ("ADM-NEW-RECORD=yes,ADM-QUERY-EMPTY-ON-ADD=":U +
      379           IF adm-query-empty THEN "yes":U ELSE "no":U).
      380         RUN dispatch('enable-fields':U).
      381         IF (adm-create-on-add = no) AND (adm-first-tmpl-recid = ?) AND
      382            (DBTYPE(LDBNAME(BUFFER TT-gds-obj)) EQ "PROGRESS":U)
      383         THEN DO:
      384             saved-dictdb = LDBNAME("DICTDB":U).
      385             CREATE ALIAS DICTDB FOR DATABASE
      386               VALUE(LDBNAME(BUFFER TT-gds-obj)).
      387             RUN adm/objects/get-init.p (INPUT "TT-gds-obj":U,
      388               OUTPUT adm-first-tmpl-recid).
      389             CREATE ALIAS DICTDB FOR DATABASE
      390               VALUE(saved-dictdb).
      391           END.
      392             IF adm-create-on-add = no THEN
      393             DO:
      394              IF DBTYPE(LDBNAME(BUFFER TT-gds-obj))
      395                EQ "PROGRESS":U THEN
      396              DO:
      397               FIND TT-gds-obj WHERE
      398                 RECID(TT-gds-obj) = adm-first-tmpl-recid
      399                   NO-LOCK.
      400               DISPLAY UNLESS-HIDDEN TT-gds-obj.fact-qnty TT-gds-obj.price-sale TT-gds-obj.fact-cli-qnty TT-gds-obj.free-qnty TT-gds-obj.fact-sale TT-gds-obj.avrg-qnty TT-gds-obj.fact-base TT-gds-obj.fact-rubl
      401                 WITH FRAME F-Main NO-ERROR.
      402              END.
      403             END.
      404             ELSE DO:
      405              DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
      406                             ON ERROR UNDO, RETURN "ADM-ERROR":U:
      407                adm-create-complete = no.
      408                RUN dispatch ('create-record':U).
      409                IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      410                DISPLAY UNLESS-HIDDEN TT-gds-obj.fact-qnty TT-gds-obj.price-sale TT-gds-obj.fact-cli-qnty TT-gds-obj.free-qnty TT-gds-obj.fact-sale TT-gds-obj.avrg-qnty TT-gds-obj.fact-base TT-gds-obj.fact-rubl
      411                   WITH FRAME F-Main NO-ERROR.
      412              END.
      413              adm-create-complete = yes.
      414             END.
      415         RUN notify ('add-record, GROUP-ASSIGN-TARGET':U).
      416         RUN new-state('update':U).
      417         RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      418       RETURN.
      419   END PROCEDURE.
      420   PROCEDURE adm-assign-record :
      421           IF group-assign-target = ? THEN
      422             RUN init-group-assign.
      423           adm-updating-record = yes.
      424           IF adm-new-record THEN DO:
      425             IF (NOT adm-adding-record) OR
      426                 (NOT adm-create-on-add) THEN
      427             DO:
      428                RUN dispatch ('create-record':U).
      429                IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      430             END.
      431             IF adm-create-on-add = yes THEN
      432             DO:
      433               RUN dispatch ('current-changed':U).
      434               IF RETURN-VALUE = "ADM-ERROR":U THEN
      435                  RETURN "ADM-ERROR":U.
      436             END.
      437           END.
      438           ELSE DO:
      439               RUN dispatch ('current-changed':U).
      440               IF RETURN-VALUE = "ADM-ERROR":U THEN
      441                  RETURN "ADM-ERROR":U.
      442           END.
      443           RUN dispatch ('assign-statement':U).
      444           IF RETURN-VALUE = "ADM-ERROR":U THEN
      445               UNDO, RETURN "ADM-ERROR":U.
      446           RUN notify ('assign-record,GROUP-ASSIGN-TARGET':U).
      447           IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      448           IF adm-new-record THEN
      449           DO:
      450               RUN get-attribute('Query-Position':U).
      451               IF RETURN-VALUE = 'no-record-available':U THEN
      452               DO:
      453                 RUN new-state('record-available':U).
      454                 RUN set-attribute-list('Query-Position = record-available':U).
      455               END.
      456               RUN dispatch('display-fields':U).
      457           END.
      458      RETURN.
      459     END PROCEDURE.
      460   PROCEDURE adm-assign-statement :
      461           ASSIGN FRAME F-Main TT-gds-obj.fact-base TT-gds-obj.fact-rubl
      462                 NO-ERROR.
      463       IF ERROR-STATUS:ERROR THEN
      464       DO:
      465         RUN dispatch('show-errors':U).
      466         UNDO, RETURN "ADM-ERROR":U.
      467       END.
      468     RETURN.
      469   END PROCEDURE.
      470   PROCEDURE adm-cancel-record :
      471     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      472      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      473      IF adm-new-record THEN
      474      DO:
      475         IF (adm-adding-record = yes) AND
      476            (adm-create-on-add = no)
      477         THEN DO:
      478           RELEASE TT-gds-obj NO-ERROR.
      479         END.
      480         ELSE IF (adm-adding-record = yes) AND
      481           (adm-create-on-add = yes) AND
      482             (adm-create-complete = yes)
      483         THEN RUN dispatch ('delete-record':U).
      484             IF adm-new-record THEN
      485             DO:
      486               IF group-assign-target THEN
      487               DO:
      488                 RUN request-attribute IN adm-broker-hdl
      489                   (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U,
      490                    'ADM-QUERY-EMPTY-ON-ADD':U).
      491                 adm-query-empty = IF RETURN-VALUE = "YES":U THEN yes
      492                   ELSE IF RETURN-VALUE = "NO":U THEN no ELSE ?.
      493               END.
      494               IF adm-query-empty THEN
      495               DO:
      496                 RUN dispatch ('disable-fields':U).
      497                 RUN dispatch ('display-fields':U).
      498               END.
      499             END.
      500         adm-new-record = no.
      501         RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
      502      END.
      503      ELSE RUN dispatch ('display-fields':U).
      504      RUN notify ('cancel-record, GROUP-ASSIGN-TARGET':U).
      505      RUN dispatch ('apply-entry':U).
      506      RUN get-link-handle IN adm-broker-hdl
      507          (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
      508      adm-updating-record = no.
      509      IF source-str EQ "":U THEN
      510        RUN new-state('update-complete':U).
      511      RETURN.
      512     END PROCEDURE.
      513   PROCEDURE adm-copy-record :
      514      DEFINE VARIABLE trans-hdl-string AS CHARACTER NO-UNDO.
      515         IF group-assign-target = ? THEN
      516           RUN init-group-assign.
      517         IF NOT group-assign-target THEN
      518           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      519         ASSIGN adm-first-table = ROWID(TT-gds-obj)
      520                adm-new-record = yes
      521                adm-adding-record = no.
      522         RUN set-attribute-list ("ADM-NEW-RECORD=yes":U).
      523         RUN dispatch('enable-fields':U).
      524             RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      525         RUN notify ('copy-record, GROUP-ASSIGN-TARGET':U).
      526         RUN new-state('update':U).
      527       RETURN.
      528   END PROCEDURE.
      529   PROCEDURE adm-create-record :
      530       DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      531       DEFINE VARIABLE source-rowid-str    AS CHARACTER NO-UNDO.
      532          IF group-assign-target = yes THEN
      533          DO:
      534            RUN get-link-handle IN adm-broker-hdl
      535              (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U,
      536                 OUTPUT source-str).
      537            RUN send-records IN WIDGET-HANDLE (source-str)
      538                (INPUT "TT-gds-obj":U,
      539                 OUTPUT source-rowid-str).
      540            FIND TT-gds-obj WHERE
      541                ROWID (TT-gds-obj) =
      542                    TO-ROWID(source-rowid-str) NO-ERROR.
      543            IF ERROR-STATUS:ERROR THEN
      544            DO:
      545              RUN dispatch('show-errors':U).
      546              UNDO, RETURN "ADM-ERROR":U.
      547            END.
      548          END.
      549          ELSE DO:
      550              CREATE TT-gds-obj NO-ERROR.
      551              IF ERROR-STATUS:ERROR THEN
      552              DO:
      553                RUN dispatch('show-errors':U).
      554                UNDO, RETURN "ADM-ERROR":U.
      555              END.
      556          END.
      557      RETURN.
      558   END PROCEDURE.
      559   PROCEDURE adm-current-changed :
      560      ASSIGN adm-first-table = ROWID(TT-gds-obj).
      561     IF NOT group-assign-target THEN
      562     DO:
      563       FIND CURRENT TT-gds-obj EXCLUSIVE-LOCK NO-ERROR NO-WAIT.
      564       IF NOT AVAILABLE TT-gds-obj THEN
      565       DO:
      566         RUN dispatch('show-errors':U).
      567         IF ERROR-STATUS:GET-NUMBER(1) = 138 THEN
      568             RUN dispatch('get-next':U).
      569         ELSE FIND TT-gds-obj WHERE
      570             ROWID(TT-gds-obj) = adm-first-table NO-LOCK NO-ERROR.
      571         RETURN "ADM-ERROR":U.
      572       END.
      573       ELSE IF CURRENT-CHANGED TT-gds-obj THEN
      574       DO:
      575         MESSAGE  SUBSTITUTE
      576             ("Sorry, this &1 has been changed by another user. ",
      577               "TT-gds-obj") SKIP
      578               "Please note any differences and re-enter your changes."
      579                      VIEW-AS ALERT-BOX.
      580         RUN dispatch ('display-fields':U).
      581         UNDO, RETURN "ADM-ERROR":U.
      582       END.
      583     END.
      584     RETURN.
      585   END PROCEDURE.
      586   PROCEDURE adm-delete-record :
      587      DEFINE VARIABLE delete-failed AS LOGICAL NO-UNDO INIT no.
      588      IF group-assign-target = ? THEN
      589        RUN init-group-assign.
      590         DO TRANSACTION ON STOP UNDO, LEAVE ON ERROR UNDO, LEAVE:
      591           IF group-assign-target NE yes THEN
      592           DO:
      593             FIND CURRENT TT-gds-obj EXCLUSIVE-LOCK NO-WAIT
      594               NO-ERROR.
      595             IF ERROR-STATUS:ERROR THEN
      596             DO:
      597               RUN dispatch('show-errors':U).
      598               UNDO, RETURN "ADM-ERROR":U.
      599             END.
      600             DELETE TT-gds-obj NO-ERROR.
      601           END.
      602           IF ERROR-STATUS:ERROR THEN
      603           DO:
      604             RUN dispatch('show-errors':U).
      605             delete-failed = yes.
      606           END.
      607         END.
      608            IF (NOT delete-failed) AND
      609               (NOT adm-new-record) THEN
      610            RUN new-state ('delete-complete':U).
      611         IF delete-failed THEN
      612             UNDO, RETURN "ADM-ERROR":U.
      613       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      614       RETURN.
      615   END PROCEDURE.
      616   PROCEDURE adm-disable-fields :
      617              DISABLE UNLESS-HIDDEN TT-gds-obj.fact-base TT-gds-obj.fact-rubl
      618                WITH FRAME F-Main.
      619              RUN set-editors('DISABLE':U).
      620          RUN set-attribute-list ("FIELDS-ENABLED=no":U).
      621         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      622       RETURN.
      623   END PROCEDURE.
      624   PROCEDURE adm-enable-fields :
      625           RUN get-attribute ("FIELDS-ENABLED":U).
      626           IF RETURN-VALUE NE "YES":U THEN
      627           DO:
      628             IF NOT adm-new-record THEN
      629             DO:
      630               IF AVAILABLE(TT-gds-obj) AND
      631                 adm-initial-lock = "SHARE-LOCK":U OR
      632                   adm-initial-lock = "EXCLUSIVE-LOCK":U THEN
      633               DO:
      634                   IF adm-initial-lock = "SHARE-LOCK":U THEN
      635                     FIND CURRENT TT-gds-obj SHARE-LOCK NO-WAIT
      636                       NO-ERROR.
      637                   ELSE IF AVAILABLE (TT-gds-obj) THEN
      638                   DO TRANSACTION:
      639                     FIND CURRENT TT-gds-obj
      640                      EXCLUSIVE-LOCK NO-WAIT NO-ERROR.
      641                   END.
      642                   IF ERROR-STATUS:ERROR THEN
      643                   DO:
      644                     RUN dispatch('show-errors':U).
      645                     UNDO, RETURN "ADM-ERROR":U.
      646                   END.
      647                   RUN dispatch ('display-fields':U).
      648               END.
      649            END.
      650                   ENABLE UNLESS-HIDDEN TT-gds-obj.fact-base TT-gds-obj.fact-rubl
      651                     WITH FRAME F-Main.
      652                   RUN set-editors('ENABLE':U).
      653               RUN set-attribute-list ("FIELDS-ENABLED=yes":U).
      654           END.
      655           RUN notify ('enable-fields, GROUP-ASSIGN-TARGET':U).
      656           RUN dispatch ('apply-entry':U).
      657       RETURN.
      658   END PROCEDURE.
      659   PROCEDURE adm-end-update :
      660     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      661      IF ERROR-STATUS:ERROR THEN
      662          RUN dispatch('show-errors':U).
      663      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      664      RUN get-link-handle IN adm-broker-hdl
      665         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
      666      IF adm-new-record AND NOT TRANSACTION THEN DO:
      667             adm-new-record = no.
      668             RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
      669             ASSIGN adm-first-table = ROWID(TT-gds-obj).
      670             IF source-str EQ "":U THEN
      671             DO:
      672                 RUN set-link-attribute IN adm-broker-hdl
      673                     (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      674                      'REPOSITION-PENDING=yes':U).
      675                 RUN notify('open-query':U).
      676                 RUN request IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      677                     INPUT 'RECORD-SOURCE':U, INPUT 'reposition-query':U).
      678             END.
      679      END.
      680       FIND CURRENT TT-gds-obj NO-LOCK NO-ERROR.
      681       RUN notify('end-update, GROUP-ASSIGN-TARGET':U).
      682       IF source-str EQ "":U THEN
      683           RUN new-state('update-complete':U).
      684       adm-updating-record = no.
      685       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      686     RETURN.
      687   END PROCEDURE.
      688   PROCEDURE adm-reset-record :
      689        RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      690        RUN notify ('reset-record, GROUP-ASSIGN-TARGET':U).
      691        RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      692       RETURN.
      693   END PROCEDURE.
      694   PROCEDURE adm-update-record :
      695         DEFINE VARIABLE cRecordSrc AS CHARACTER NO-UNDO.
      696         DEFINE VARIABLE hRecordSrc AS HANDLE     NO-UNDO.
      697         DEFINE BUFFER bNewRecord FOR TT-gds-obj.
      698         DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
      699                        ON ERROR UNDO, RETURN "ADM-ERROR":U :
      700           RUN dispatch ('assign-record':U).
      701           IF  RETURN-VALUE = "ADM-ERROR":U THEN
      702               RETURN "ADM-ERROR":U.
      703         END.
      704         RUN dispatch ('end-update':U).
      705         FIND FIRST bNewRecord NO-LOCK NO-ERROR.
      706         IF NOT ERROR-STATUS:ERROR AND ROWID(bNewRecord) = ROWID (TT-gds-obj) THEN
      707         DO:
      708           RUN get-link-handle IN adm-broker-hdl
      709               (INPUT THIS-PROCEDURE,
      710                INPUT "RECORD-SOURCE",
      711                OUTPUT cRecordSrc).
      712           hRecordSrc = WIDGET-HANDLE(cRecordSrc).
      713           IF VALID-HANDLE(hRecordSrc) THEN
      714           DO:
      715               RUN get-attribute IN hRecordSrc ("TYPE":U).
      716               IF RETURN-VALUE = "SmartQuery":U AND
      717                  CAN-DO(hRecordSrc:INTERNAL-ENTRIES,"new-first-record") THEN
      718                  RUN new-first-record IN hRecordSrc (INPUT ROWID (TT-gds-obj)).
      719           END.
      720         END.
      721      RETURN.
      722   END PROCEDURE.
      723   PROCEDURE check-modified :
      724   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      725   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      726   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      727   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      728     IF NOT VALID-HANDLE(adm-object-hdl) THEN RETURN.
      729     IF group-assign-target = ? THEN
      730       RUN init-group-assign.
      731     IF check-state = "check":U AND group-assign-target THEN
      732       RETURN "":U.
      733     ELSE IF check-state = "group-check":U THEN
      734        check-state = "check":U.
      735     IF VALID-HANDLE(FRAME F-Main:HANDLE) AND
      736         AVAILABLE(TT-gds-obj) THEN
      737     DO:
      738       ASSIGN curr-widget = FRAME F-Main:FIRST-CHILD.
      739       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      740       DO WHILE VALID-HANDLE (curr-widget):
      741           IF LOOKUP (curr-widget:TYPE,
      742           "FILL-IN,COMBO-BOX,EDITOR,RADIO-SET,SELECTION-LIST,SLIDER,TOGGLE-BOX":U)
      743               NE 0 AND
      744                    (adm-check-modified-all = yes OR curr-widget:SENSITIVE) AND
      745                    (adm-check-modified-all = yes OR curr-widget:TABLE NE ?)
      746                    AND curr-widget:MODIFIED THEN
      747           DO:
      748               IF check-state = "check":U THEN
      749               DO:
      750                   RUN check-modified-message(curr-widget:TABLE).
      751                   RETURN.
      752               END.
      753               ELSE IF check-state = "clear":U THEN
      754                   curr-widget:MODIFIED = no.
      755           END.
      756           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      757       END.
      758     END.
      759     IF check-state = "check":U THEN
      760     DO:
      761       RUN get-link-handle IN adm-broker-hdl
      762         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      763            OUTPUT group-target-list).
      764       IF group-target-list NE "":U THEN
      765       DO i = 1 TO NUM-ENTRIES(group-target-list):
      766         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      767         RUN check-modified IN curr-widget ('group-check':U).
      768         IF RETURN-VALUE NE "":U THEN
      769         DO:
      770           RUN check-modified-message(RETURN-VALUE).
      771           RETURN "":U.
      772         END.
      773       END.
      774     END.
      775     RETURN "":U.
      776   END PROCEDURE.
      777   PROCEDURE check-modified-message :
      778     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      779        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      780           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      781        IF RETURN-VALUE = "YES":U THEN
      782           RUN notify ('view,CONTAINER-SOURCE':U).
      783        MESSAGE IF p-changed-table NE ? THEN
      784           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      785           ELSE "Current values have been changed."
      786           SKIP "  Do you wish to save those changes?"
      787           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      788        IF ANS THEN
      789        DO:
      790           IF group-assign-target THEN
      791             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      792           ELSE RUN dispatch('update-record':U).
      793           IF RETURN-VALUE = "ADM-ERROR":U THEN
      794           DO:
      795               MESSAGE "Changes to the previous record were not saved."
      796                 VIEW-AS ALERT-BOX ERROR.
      797               IF group-assign-target THEN
      798                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      799               ELSE RUN dispatch ('cancel-record':U).
      800           END.
      801        END.
      802        ELSE DO:
      803          IF group-assign-target THEN
      804             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      805          ELSE RUN dispatch('cancel-record':U).
      806        END.
      807        RETURN.
      808   END PROCEDURE.
      809   PROCEDURE get-rowid :
      810       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      811       ASSIGN
      812       p-table   =   adm-first-table.
      813       RETURN.
      814   END PROCEDURE.
      815   PROCEDURE init-group-assign :
      816       RUN request-attribute IN adm-broker-hdl
      817         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      818       IF LOOKUP("TT-gds-obj":U, RETURN-VALUE, " ":U) NE 0 THEN
      819         group-assign-target = yes.
      820       ELSE group-assign-target = no.
      821       RETURN.
      822   END PROCEDURE.
      823   PROCEDURE set-editors :
      824       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      825       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      826       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      827       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      828       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      829       DO WHILE VALID-HANDLE (curr-widget):
      830           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      831              curr-widget:HIDDEN = no THEN DO:
      832             CASE p-field-setting:
      833               WHEN "INITIALIZE":U THEN
      834               DO:
      835                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      836                     read-only-list +
      837                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      838                        STRING(curr-widget).
      839               END.
      840               WHEN "DISABLE":U OR
      841               WHEN "ENABLE":U THEN
      842               DO:
      843                   curr-widget:SENSITIVE = yes.
      844                   RUN get-attribute ('Read-Only-Editors':U).
      845                   IF RETURN-VALUE = ? OR
      846                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      847                       curr-widget:READ-ONLY =
      848                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      849               END.
      850               WHEN "CLEAR":U THEN
      851                   curr-widget:SCREEN-VALUE = "":U.
      852             END CASE.
      853           END.
      854           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      855       END.
      856       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      857         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      858           + '"':U).
      859       RETURN.
      860   END PROCEDURE.
      861   PROCEDURE use-check-modified-all :
      862    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      863     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      864     RETURN.
      865   END PROCEDURE.
      866   PROCEDURE use-create-on-add :
      867   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      868         ASSIGN adm-create-on-add =
      869             IF (p-attr-value EQ "NO":U) OR
      870                (p-attr-value NE "YES":U AND
      871              DBTYPE(LDBNAME(BUFFER TT-gds-obj)) EQ "PROGRESS":U)
      872             THEN no ELSE yes.
      873      RETURN.
      874   END PROCEDURE.
      875   PROCEDURE use-initial-lock :
      876     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      877     ASSIGN adm-initial-lock = p-attr-value.
      878     RETURN.
      879   END PROCEDURE.
      880     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      881   ASSIGN
      882          FRAME F-Main:SCROLLABLE       = FALSE
      883          FRAME F-Main:HIDDEN           = TRUE.
      884   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885     run mainmenu_getcntxt in varparentproc
      886       (output v-cntxt-db-num
      887       ,output v-cntxt-userid
      888       ,output v-cntxt-level
      889       ,output v-cntxt-host-code-obj
      890       ,output v-cntxt-obj-type
      891       ,output v-cntxt-obj-code
      892       ,output v-cntxt-db-num-obj
      893       ,output v-cntxt-is-admin
      894       ) .
      895   assign
      896     FILL-IN-2 = " РУБЛИ"
      897   .
      898   display
      899     fill-in-1
      900     fill-in-2
      901     with frame F-Main .
      902   if not this-procedure :persistent
      903   then do:
      904     message
      905       vss-workfile vss-revision vss-description skip
      906       "Ошибка при запуске процедуры" skip
      907       "Данную процедуру следует запускать только с параметром persistent" skip
      908       view-as alert-box error .
      909     undo, return error .
      910   end.
      911     for each tt-gds-obj:
      912         delete tt-gds-obj.
      913     end.
      914     assign varqnty = 0.
      915     for each tt-goods,
      916         each tt-clients:
      917         assign varqnty = varqnty + 1.
      918         find first ub.gds-obj where ub.gds-obj.obj-type  = tt-clients.obj-type and
      919                                     ub.gds-obj.obj-code  = tt-clients.obj-code and
      920                                     ub.gds-obj.artic     = tt-goods.artic      and
      921                                     ub.gds-obj.prod-type = tt-goods.prod-type  and
      922                                     ub.gds-obj.prod-code = tt-goods.prod-code  no-lock no-error.
      923         if available ub.gds-obj then do:
      924            find first tt-gds-obj no-lock no-error.
      925            if not available tt-gds-obj then do:
      926               create tt-gds-obj.
      927               buffer-copy gds-obj to tt-gds-obj.
      928            end.
      929            else do:
      930                assign
      931                tt-gds-obj.fact-qnty     = tt-gds-obj.fact-qnty     + ub.gds-obj.fact-qnty
      932                tt-gds-obj.fact-cli-qnty = tt-gds-obj.fact-cli-qnty + ub.gds-obj.fact-cli-qnty
      933                tt-gds-obj.free-qnty     = tt-gds-obj.free-qnty     + ub.gds-obj.free-qnty
      934                tt-gds-obj.avrg-qnty     = tt-gds-obj.avrg-qnty     + ub.gds-obj.avrg-qnty
      935                tt-gds-obj.fact-sale     = tt-gds-obj.fact-sale     + ub.gds-obj.fact-sale
      936                tt-gds-obj.fact-base     = tt-gds-obj.fact-base     + ub.gds-obj.fact-base
      937                tt-gds-obj.fact-rubl     = tt-gds-obj.fact-rubl     + ub.gds-obj.fact-rubl.
      938            end.
      939         end.
      940     end.
      941     if varqnty > 1
      942     then do:
      943       assign tt-gds-obj.price-sale = ?.
      944     end.
      945     if available tt-gds-obj
      946     then do:
      947       display tt-gds-obj.fact-qnty tt-gds-obj.fact-cli-qnty tt-gds-obj.free-qnty tt-gds-obj.avrg-qnty
      948               tt-gds-obj.fact-sale
      949               tt-gds-obj.price-sale
      950               with frame F-Main.
      951       define variable v-chk-act-host-code as integer   no-undo .
      952   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      954     (input  tt-gds-obj.obj-type
      955     ,input  tt-gds-obj.obj-code
      956     ,output v-chk-act-host-code
      957     )  .
      958   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      959   do:
      960     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      961       (input  v-cntxt-db-num
      962       ,input  v-cntxt-userid
      963       ,input  0
      964       ,input  'actn_archive_cost':U
      965       ,input  'object':U
      966       ,input  v-chk-act-host-code
      967       ,input  tt-gds-obj.obj-type
      968       ,input  tt-gds-obj.obj-code
      969       ,input  0
      970       ,input  0
      971       ,input  0
      972       ,input  false
      973       ,output g-log
      974       )  .
      975   end.
      976       if g-log then display tt-gds-obj.fact-base tt-gds-obj.fact-rubl
      977                             with frame F-Main.
      978              else hide tt-gds-obj.fact-base tt-gds-obj.fact-rubl
      979                        in frame F-Main.
      980     end.
      981   PROCEDURE adm-row-available :
      982     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      983     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      984     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      985     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      986     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      987     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      988     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      989     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      990     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      991     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      992     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      993     IF adm-updating-record THEN RETURN.
      994     RUN get-attribute ('FIELDS-ENABLED':U).
      995     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      996     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      997         OUTPUT link-handle) NO-ERROR.
      998     IF link-handle = "":U THEN
      999         RETURN.
     1000     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1001     IF NUM-ENTRIES(link-handle) > 1 THEN
     1002         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1003             "encountered more than one RECORD-SOURCE.":U SKIP
     1004             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1005                VIEW-AS ALERT-BOX ERROR.
     1006     RUN get-attribute ('Key-Name':U).
     1007     key-name = RETURN-VALUE.
     1008     IF key-name = "":U THEN key-name = ?.
     1009     IF key-name NE ? THEN DO:
     1010       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1011         NO-ERROR.
     1012       IF key-value NE ? THEN
     1013         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1014     END.
     1015   IF VALID-HANDLE (adm-object-hdl) THEN
     1016       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1017   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1018   END PROCEDURE.
     1019   PROCEDURE disable_UI :
     1020     HIDE FRAME F-Main.
     1021     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1022   END PROCEDURE.
     1023   PROCEDURE send-records :
     1024   END PROCEDURE.
     1025   PROCEDURE state-changed :
     1026     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1027     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1028     CASE p-state:
     1029       WHEN 'update-begin':U THEN DO:
     1030           RUN dispatch('enable-fields':U).
     1031           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1032           DO:
     1033             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1034             RUN new-state('update-complete':U).
     1035           END.
     1036           ELSE RUN new-state ('update':U).
     1037       END.
     1038       WHEN 'update-complete':U THEN DO:
     1039           RUN new-state ('update-complete':U).
     1040       END.
     1041     END CASE.
     1042   END PROCEDURE.
