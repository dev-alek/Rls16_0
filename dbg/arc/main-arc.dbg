      413   define shared variable varparentproc as widget-handle no-undo.
      414   define variable fact-order-start like ub.stk-tot.fact-order no-undo.
      415   define variable fact-order-end   like ub.stk-tot.fact-order no-undo.
      416   define variable fact-order-min   like ub.stk-tot.fact-order no-undo.
      417   define variable fact-order-max   like ub.stk-tot.fact-order no-undo.
      418   define variable varh_caller-main as widget-handle no-undo.
