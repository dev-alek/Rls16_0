     1689             acc-stk-line.transport-base = acc-stk-line.transport-base + tt-stk-line.transport-base
     1690             acc-stk-line.transport-rubl = acc-stk-line.transport-rubl + tt-stk-line.transport-rubl
     1691             acc-stk-line.other-base     = acc-stk-line.other-base     + tt-stk-line.other-base
     1692             acc-stk-line.other-rubl     = acc-stk-line.other-rubl     + tt-stk-line.other-rubl.
     1693             else
