     1415         varqnty-is-calc-start = no
     1416         varqnty-is-calc-end   = no
     1417       .
     1418       assign
     1419         varcost = (if tt-goods.gds-type = 'у':U then 'cssr':U else 'cost':U)
     1420         varcsdt = (if tt-goods.gds-type = 'у':U then 'sdsr':U else 'csdt':U)
