     1470   find first tt-kind-sum where tt-kind-sum.sum-kind = "Сумма" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "Сумма"                   tt-kind-sum.order    = 1.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .sum-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .sum-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .sum-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .sum-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1471   find first tt-kind-sum where tt-kind-sum.sum-kind = "НДС" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "НДС"                   tt-kind-sum.order    = 2.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .vat-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .vat-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .vat-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .vat-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1472   find first tt-kind-sum where tt-kind-sum.sum-kind = "НП" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "НП"                   tt-kind-sum.order    = 3.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .slt-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .slt-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .slt-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .slt-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1473   find first tt-kind-sum where tt-kind-sum.sum-kind = rdtaxname no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = rdtaxname                   tt-kind-sum.order    = 4.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .road-tax-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .road-tax-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .road-tax-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .road-tax-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1474   find first tt-kind-sum where tt-kind-sum.sum-kind = "Акциз" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "Акциз"                   tt-kind-sum.order    = 5.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .excise-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .excise-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .excise-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .excise-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1475   find first tt-kind-sum where tt-kind-sum.sum-kind = "Трансп.расходы" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "Трансп.расходы"                   tt-kind-sum.order    = 6.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .transport-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .transport-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .transport-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .transport-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1476   find first tt-kind-sum where tt-kind-sum.sum-kind = "Прочие расходы" no-error.       if not available tt-kind-sum  then do:           create tt-kind-sum.           assign tt-kind-sum.sum-kind = "Прочие расходы"                   tt-kind-sum.order    = 7.       end.       CASE varcost :       WHEN 'cost':U OR        WHEN 'cssr':U then do:            if g-cost-arc then            assign            tt-kind-sum.sum-end-base = tt-kind-sum.sum-end-base + (if available tt-stk-line  then tt-stk-line .other-base else 0)            tt-kind-sum.sum-end-rubl = tt-kind-sum.sum-end-rubl + (if available tt-stk-line  then tt-stk-line .other-rubl else 0).            else            assign            tt-kind-sum.sum-end-base = ?            tt-kind-sum.sum-end-rubl = ?.       end.       when 'crsa':U OR       when 'cgsr':U then do:           if v-r-b-base = true then do:             assign tt-kind-sum.sum-end-rubl-sale = ?                    tt-kind-sum.sum-end-base-sale = tt-kind-sum.sum-end-base-sale + (if available tt-stk-line  then tt-stk-line .other-base else 0).           end.           else do:             assign tt-kind-sum.sum-end-rubl-sale = tt-kind-sum.sum-end-rubl-sale + (if available tt-stk-line  then tt-stk-line .other-rubl else 0).                    tt-kind-sum.sum-end-base-sale = ?.           end.       end.       otherwise do:           message "Некорректный sum-type " varcost " при просмотре архива(main-arc.i)." skip                   "Ошибка в расчетах."           view-as alert-box error.       end.       end case.
     1477   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   for each tt-stk-line:
     1479       delete tt-stk-line.
     1480   end.
     1481   run stk-lnrv(
     1482       input  tt-clients.obj-type,
     1483       input  tt-clients.obj-code,
     1484       input  tt-goods.artic,
     1485       input  tt-goods.prod-type,
     1486       input  tt-goods.prod-code,
     1487       input  fact-order-start,
     1488       input  fact-order-end,
     1489       input  varcsdt,
     1490       input  '##,##':U,
     1491       input  varis-shift-num,
     1492       output table tt-stk-line).
     1493   for each tt-stk-line:
     1494       assign varorder = lookup(substring(tt-stk-line.sum-type, length(varcsdt) + 1), 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     1495       find first acc-stk-line where acc-stk-line.order = varorder no-error.
     1496       if not available acc-stk-line then do:
     1497          create acc-stk-line.
     1498          assign
     1499          acc-stk-line.obj-type          = ?
     1500          acc-stk-line.obj-code          = ?
     1501          acc-stk-line.artic             = ?
     1502          acc-stk-line.prod-type         = ?
     1503          acc-stk-line.prod-code         = ?
     1504          acc-stk-line.sum-type          = ?
     1505          acc-stk-line.cat-id            = '##,##':U
     1506          acc-stk-line.order             = varorder
     1507          acc-stk-line.ext-doc-type      = substring(tt-stk-line.sum-type, length(varcsdt) + 1)
     1508          acc-stk-line.ext-doc-type-full = entry(acc-stk-line.order, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     1509       end.
     1510       CASE varcsdt:
     1511          WHEN 'csdt':U or
     1512          WHEN 'sdsr':U then do:
     1513             assign acc-stk-line.fact-qnty = acc-stk-line.fact-qnty + tt-stk-line.fact-qnty.
     1514             if g-cost-arc then
     1515             assign
     1516             acc-stk-line.sum-base       = acc-stk-line.sum-base       + tt-stk-line.sum-base
     1517             acc-stk-line.sum-rubl       = acc-stk-line.sum-rubl       + tt-stk-line.sum-rubl
     1518             acc-stk-line.vat-base       = acc-stk-line.vat-base       + tt-stk-line.vat-base
     1519             acc-stk-line.vat-rubl       = acc-stk-line.vat-rubl       + tt-stk-line.vat-rubl
     1520             acc-stk-line.slt-base       = acc-stk-line.slt-base       + tt-stk-line.slt-base
     1521             acc-stk-line.slt-rubl       = acc-stk-line.slt-rubl       + tt-stk-line.slt-rubl
     1522             acc-stk-line.road-tax-base  = acc-stk-line.road-tax-base  + tt-stk-line.road-tax-base
     1523             acc-stk-line.road-tax-rubl  = acc-stk-line.road-tax-rubl  + tt-stk-line.road-tax-rubl
     1524             acc-stk-line.excise-base    = acc-stk-line.excise-base    + tt-stk-line.excise-base
     1525             acc-stk-line.excise-rubl    = acc-stk-line.excise-rubl    + tt-stk-line.excise-rubl
     1526             acc-stk-line.transport-base = acc-stk-line.transport-base + tt-stk-line.transport-base
     1527             acc-stk-line.transport-rubl = acc-stk-line.transport-rubl + tt-stk-line.transport-rubl
     1528             acc-stk-line.other-base     = acc-stk-line.other-base     + tt-stk-line.other-base
     1529             acc-stk-line.other-rubl     = acc-stk-line.other-rubl     + tt-stk-line.other-rubl.
     1530             else
     1531             assign
     1532             acc-stk-line.sum-base       = ?
     1533             acc-stk-line.sum-rubl       = ?
     1534             acc-stk-line.vat-base       = ?
     1535             acc-stk-line.vat-rubl       = ?
     1536             acc-stk-line.slt-base       = ?
     1537             acc-stk-line.slt-rubl       = ?
     1538             acc-stk-line.road-tax-base  = ?
     1539             acc-stk-line.road-tax-rubl  = ?
     1540             acc-stk-line.excise-base    = ?
     1541             acc-stk-line.excise-rubl    = ?
     1542             acc-stk-line.transport-base = ?
     1543             acc-stk-line.transport-rubl = ?
     1544             acc-stk-line.other-base     = ?
     1545             acc-stk-line.other-rubl     = ?.
     1546          end.
     1547          WHEN 'cgdt':U or
     1548          WHEN 'gdsr':U THEN
     1549          assign
     1550          acc-stk-line.sum-base-sale       = acc-stk-line.sum-base-sale       + tt-stk-line.sum-base
     1551          acc-stk-line.sum-rubl-sale       = acc-stk-line.sum-rubl-sale       + tt-stk-line.sum-rubl
     1552          acc-stk-line.vat-base-sale       = acc-stk-line.vat-base-sale       + tt-stk-line.vat-base
     1553          acc-stk-line.vat-rubl-sale       = acc-stk-line.vat-rubl-sale       + tt-stk-line.vat-rubl
     1554          acc-stk-line.slt-base-sale       = acc-stk-line.slt-base-sale       + tt-stk-line.slt-base
     1555          acc-stk-line.slt-rubl-sale       = acc-stk-line.slt-rubl-sale       + tt-stk-line.slt-rubl
     1556          acc-stk-line.road-tax-base-sale  = acc-stk-line.road-tax-base-sale  + tt-stk-line.road-tax-base
     1557          acc-stk-line.road-tax-rubl-sale  = acc-stk-line.road-tax-rubl-sale  + tt-stk-line.road-tax-rubl
     1558          acc-stk-line.excise-base-sale    = acc-stk-line.excise-base-sale    + tt-stk-line.excise-base
     1559          acc-stk-line.excise-rubl-sale    = acc-stk-line.excise-rubl-sale    + tt-stk-line.excise-rubl
     1560          acc-stk-line.transport-base-sale = acc-stk-line.transport-base-sale + tt-stk-line.transport-base
     1561          acc-stk-line.transport-rubl-sale = acc-stk-line.transport-rubl-sale + tt-stk-line.transport-rubl
     1562          acc-stk-line.other-base-sale     = acc-stk-line.other-base-sale     + tt-stk-line.other-base
     1563          acc-stk-line.other-rubl-sale     = acc-stk-line.other-rubl-sale     + tt-stk-line.other-rubl.
     1564          WHEN 'sadt':U or
     1565          WHEN 'adsr':U THEN
     1566          assign
     1567          acc-stk-line.sum-base-doc       = acc-stk-line.sum-base-doc       + tt-stk-line.sum-base
     1568          acc-stk-line.sum-rubl-doc       = acc-stk-line.sum-rubl-doc       + tt-stk-line.sum-rubl
     1569          acc-stk-line.vat-base-doc       = acc-stk-line.vat-base-doc       + tt-stk-line.vat-base
     1570          acc-stk-line.vat-rubl-doc       = acc-stk-line.vat-rubl-doc       + tt-stk-line.vat-rubl
     1571          acc-stk-line.slt-base-doc       = acc-stk-line.slt-base-doc       + tt-stk-line.slt-base
     1572          acc-stk-line.slt-rubl-doc       = acc-stk-line.slt-rubl-doc       + tt-stk-line.slt-rubl
     1573          acc-stk-line.road-tax-base-doc  = acc-stk-line.road-tax-base-doc  + tt-stk-line.road-tax-base
     1574          acc-stk-line.road-tax-rubl-doc  = acc-stk-line.road-tax-rubl-doc  + tt-stk-line.road-tax-rubl
     1575          acc-stk-line.excise-base-doc    = acc-stk-line.excise-base-doc    + tt-stk-line.excise-base
     1576          acc-stk-line.excise-rubl-doc    = acc-stk-line.excise-rubl-doc    + tt-stk-line.excise-rubl
     1577          acc-stk-line.transport-base-doc = acc-stk-line.transport-base-doc + tt-stk-line.transport-base
     1578          acc-stk-line.transport-rubl-doc = acc-stk-line.transport-rubl-doc + tt-stk-line.transport-rubl
     1579          acc-stk-line.other-base-doc     = acc-stk-line.other-base-doc     + tt-stk-line.other-base
     1580          acc-stk-line.other-rubl-doc     = acc-stk-line.other-rubl-doc     + tt-stk-line.other-rubl.
     1581          otherwise do:
     1582             message "Некорректный sum-type " varcsdt " при просмотре архива(main-arr.i)." skip
     1583                     "Ошибка в расчетах."
     1584             view-as alert-box error.
     1585          end.
     1586       END CASE.
     1587   end.
     1588   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   for each tt-stk-line :
     1590       delete tt-stk-line .
     1591   end.
     1592   run stk-lnst(input  tt-clients.obj-type,
     1593                input  tt-clients.obj-code,
     1594                input  tt-goods.artic,
     1595                input  tt-goods.prod-type,
     1596                input  tt-goods.prod-code,
     1597                input  fact-order-start,
     1598                input  varcrsa,
     1599                input  '##,##':U,
     1600                input  varis-shift-num,
     1601                output table tt-stk-line ).
     1602   find first tt-stk-line  no-lock no-error.
     1603   if not varqnty-is-calc-start then do:
     1604      assign varqnty-start = varqnty-start + (if available tt-stk-line  then tt-stk-line .fact-qnty else 0).
     1605      assign varqnty-is-calc-start = yes.
