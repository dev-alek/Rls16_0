     1861   end.
     1862     end.
     1863   end.
     1864   run waitfram-hide in this-procedure .
     1865   OPEN QUERY b-kind-type FOR EACH tt-kind-sum NO-LOCK.    OPEN QUERY BROWSE-1 FOR EACH acc-stk-line NO-LOCK.
     1866   display varqnty-start varqnty-end with frame F-Main.
     1867   END PROCEDURE.
     1868   PROCEDURE disable_UI :
     1869     HIDE FRAME F-Main.
     1870     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1871   END PROCEDURE.
     1872   PROCEDURE send-records :
     1873     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1874     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1875     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1876     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1877     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1878     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1879         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1880         CASE ENTRY(i, p-tbl-list):
     1881       WHEN "tt-kind-sum":U THEN p-rowid-list = p-rowid-list +
     1882           IF AVAILABLE tt-kind-sum THEN STRING(ROWID(tt-kind-sum))
     1883           ELSE "?":U.
     1884       WHEN "acc-stk-line":U THEN p-rowid-list = p-rowid-list +
     1885           IF AVAILABLE acc-stk-line THEN STRING(ROWID(acc-stk-line))
     1886           ELSE "?":U.
     1887           OTHERWISE
     1888           DO:
     1889               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1890                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1891               IF link-handle NE "":U THEN
     1892               DO:
     1893                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1894                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1895                               "encountered more than one RECORD-SOURCE.":U SKIP
     1896                               "The first will be used.":U
     1897                               VIEW-AS ALERT-BOX ERROR.
     1898                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1899                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1900                   p-rowid-list = p-rowid-list + rowid-string.
     1901               END.
     1902               ELSE
     1903               DO:
     1904                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1905                           "does not match tables in send-records":U
     1906                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1907                           "Check that objects are linked properly and that":U
     1908                           "database qualification is consistent.":U
     1909                       VIEW-AS ALERT-BOX ERROR.
     1910                   RETURN ERROR.
     1911               END.
     1912           END.
     1913           END CASE.
     1914       END.
     1915   END PROCEDURE.
     1916   PROCEDURE show_arh :
     1917   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'main-handle':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "main-handle" + " для получения данных." .                    end.
     1919   assign varh_caller-main = widget-handle(return-value).
     1920   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varis-calend':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varis-calend" + " для получения данных." .                    end.
     1921   assign varis-calend = integer(return-value).
     1922   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varis-shift-num':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varis-shift-num" + " для получения данных." .                    end.
     1923   assign varis-shift-num = if return-value = 'yes' then yes else no.
     1924   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'vardate-start':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "vardate-start" + " для получения данных." .                    end.
     1925   assign vardate-start = date(return-value).
     1926   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'vardate-end':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "vardate-end" + " для получения данных." .                    end.
     1927   assign vardate-end = date(return-value).
     1928   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varshift-start':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varshift-start" + " для получения данных." .                    end.
     1929   assign varshift-start = integer(return-value).
     1930   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varshift-end':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varshift-end" + " для получения данных." .                    end.
     1931   assign varshift-end = integer(return-value).
     1932   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'varext-doc-type':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "varext-doc-type" + " для получения данных." .                    end.
     1933   assign varext-doc-type = return-value.
     1934   RUN request-attribute IN adm-broker-hdl                     (INPUT THIS-PROCEDURE,                                       INPUT 'Container-Source':U,                                 INPUT 'rubl-base':U) NO-ERROR.                        if return-value = "" or return-value = ? or return-value = "?" then do:                        return error "Нет атрибута: " + "rubl-base" + " для получения данных." .                    end.
     1935   assign varrubl-base = integer(return-value).
     1936     run calc-field-frame.
     1937   END PROCEDURE.
     1938   PROCEDURE state-changed :
     1939     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1940     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1941     CASE p-state:
     1942       WHEN 'update-begin':U THEN DO:
     1943           RUN dispatch('enable-fields':U).
     1944           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1945           DO:
     1946             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1947             RUN new-state('update-complete':U).
     1948           END.
     1949           ELSE RUN new-state ('update':U).
     1950       END.
     1951       WHEN 'update-complete':U THEN DO:
     1952           RUN new-state ('update-complete':U).
     1953       END.
     1954     END CASE.
     1955   END PROCEDURE.
     1956   FUNCTION func-excise RETURNS DECIMAL
     1957     ( buffer bf_acc-stk-line for acc-stk-line ) :
     1958     if varrubl-base = 1 then return bf_acc-stk-line.excise-rubl.
     1959                         else return bf_acc-stk-line.excise-base.
     1960   END FUNCTION.
