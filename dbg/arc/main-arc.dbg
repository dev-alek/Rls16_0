     1276          varroad-tax     :label in browse browse-1 = rdtaxname.
     1277   PROCEDURE adm-row-available :
     1278     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1279     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1280     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1281     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1282     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1283     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1284     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1285     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1286     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1287     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1288     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1289     IF adm-updating-record THEN RETURN.
     1290     RUN get-attribute ('FIELDS-ENABLED':U).
     1291     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1292     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1293         OUTPUT link-handle) NO-ERROR.
     1294     IF link-handle = "":U THEN
     1295         RETURN.
     1296     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1297     IF NUM-ENTRIES(link-handle) > 1 THEN
     1298         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1299             "encountered more than one RECORD-SOURCE.":U SKIP
     1300             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1301                VIEW-AS ALERT-BOX ERROR.
     1302     RUN get-attribute ('Key-Name':U).
     1303     key-name = RETURN-VALUE.
     1304     IF key-name = "":U THEN key-name = ?.
     1305     IF key-name NE ? THEN DO:
     1306       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1307         NO-ERROR.
     1308       IF key-value NE ? THEN
     1309         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1310     END.
     1311   IF VALID-HANDLE (adm-object-hdl) THEN
     1312       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1313     IF key-name ne ? OR different-row
     1314     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
     1315     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
     1316   END PROCEDURE.
     1317   PROCEDURE calc-field-frame :
     1318     define variable varqnty-is-calc-start as logical   no-undo initial no .
     1319     define variable varqnty-is-calc-end   as logical   no-undo initial no .
     1320     define variable g-cost-arc            as logical   no-undo .
     1321     define variable varcost               as character no-undo .
     1322     define variable varcsdt               as character no-undo .
     1323     define variable varcrsa               as character no-undo .
     1324     define variable varcgdt               as character no-undo .
     1325     define variable varsadt               as character no-undo .
     1326     for each acc-stk-line
     1327     :
     1328       delete acc-stk-line.
     1329     end.
     1330     for each tt-kind-sum
     1331     :
     1332       delete tt-kind-sum.
     1333     end.
     1334     assign
     1335       varqnty-start = 0
     1336       varqnty-end   = 0
     1337     .
     1338     define variable v-chk-act-host-code as integer   no-undo .
     1339     assign
     1340       g-cost-arc = true
     1341     .
     1342     scan_block:
     1343     for each tt-clients
     1344     on error undo, return error return-value
     1345     :
     1346   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1348     (input  tt-clients.obj-type
     1349     ,input  tt-clients.obj-code
     1350     ,output v-chk-act-host-code
     1351     )  .
