     1439   find first tt-stk-line  no-lock no-error.
     1440   if not varqnty-is-calc-start then do:
     1441      assign varqnty-start = varqnty-start + (if available tt-stk-line  then tt-stk-line .fact-qnty else 0).
     1442      assign varqnty-is-calc-start = yes.
