     1772          assign
     1773          acc-stk-line.obj-type          = ?
     1774          acc-stk-line.obj-code          = ?
     1775          acc-stk-line.artic             = ?
     1776          acc-stk-line.prod-type         = ?
     1777          acc-stk-line.prod-code         = ?
     1778          acc-stk-line.sum-type          = ?
     1779          acc-stk-line.cat-id            = '##,##':U
     1780          acc-stk-line.order             = varorder
     1781          acc-stk-line.ext-doc-type      = substring(tt-stk-line.sum-type, length(varsadt) + 1)
     1782          acc-stk-line.ext-doc-type-full = entry(acc-stk-line.order, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     1783       end.
     1784       CASE varsadt:
     1785          WHEN 'csdt':U or
     1786          WHEN 'sdsr':U then do:
     1787             assign acc-stk-line.fact-qnty = acc-stk-line.fact-qnty + tt-stk-line.fact-qnty.
     1788             if g-cost-arc then
     1789             assign
     1790             acc-stk-line.sum-base       = acc-stk-line.sum-base       + tt-stk-line.sum-base
     1791             acc-stk-line.sum-rubl       = acc-stk-line.sum-rubl       + tt-stk-line.sum-rubl
     1792             acc-stk-line.vat-base       = acc-stk-line.vat-base       + tt-stk-line.vat-base
     1793             acc-stk-line.vat-rubl       = acc-stk-line.vat-rubl       + tt-stk-line.vat-rubl
     1794             acc-stk-line.slt-base       = acc-stk-line.slt-base       + tt-stk-line.slt-base
     1795             acc-stk-line.slt-rubl       = acc-stk-line.slt-rubl       + tt-stk-line.slt-rubl
     1796             acc-stk-line.road-tax-base  = acc-stk-line.road-tax-base  + tt-stk-line.road-tax-base
     1797             acc-stk-line.road-tax-rubl  = acc-stk-line.road-tax-rubl  + tt-stk-line.road-tax-rubl
     1798             acc-stk-line.excise-base    = acc-stk-line.excise-base    + tt-stk-line.excise-base
     1799             acc-stk-line.excise-rubl    = acc-stk-line.excise-rubl    + tt-stk-line.excise-rubl
     1800             acc-stk-line.transport-base = acc-stk-line.transport-base + tt-stk-line.transport-base
     1801             acc-stk-line.transport-rubl = acc-stk-line.transport-rubl + tt-stk-line.transport-rubl
     1802             acc-stk-line.other-base     = acc-stk-line.other-base     + tt-stk-line.other-base
     1803             acc-stk-line.other-rubl     = acc-stk-line.other-rubl     + tt-stk-line.other-rubl.
     1804             else
     1805             assign
     1806             acc-stk-line.sum-base       = ?
     1807             acc-stk-line.sum-rubl       = ?
     1808             acc-stk-line.vat-base       = ?
     1809             acc-stk-line.vat-rubl       = ?
     1810             acc-stk-line.slt-base       = ?
     1811             acc-stk-line.slt-rubl       = ?
     1812             acc-stk-line.road-tax-base  = ?
     1813             acc-stk-line.road-tax-rubl  = ?
     1814             acc-stk-line.excise-base    = ?
     1815             acc-stk-line.excise-rubl    = ?
     1816             acc-stk-line.transport-base = ?
     1817             acc-stk-line.transport-rubl = ?
     1818             acc-stk-line.other-base     = ?
     1819             acc-stk-line.other-rubl     = ?.
     1820          end.
     1821          WHEN 'cgdt':U or
     1822          WHEN 'gdsr':U THEN
     1823          assign
     1824          acc-stk-line.sum-base-sale       = acc-stk-line.sum-base-sale       + tt-stk-line.sum-base
     1825          acc-stk-line.sum-rubl-sale       = acc-stk-line.sum-rubl-sale       + tt-stk-line.sum-rubl
     1826          acc-stk-line.vat-base-sale       = acc-stk-line.vat-base-sale       + tt-stk-line.vat-base
     1827          acc-stk-line.vat-rubl-sale       = acc-stk-line.vat-rubl-sale       + tt-stk-line.vat-rubl
     1828          acc-stk-line.slt-base-sale       = acc-stk-line.slt-base-sale       + tt-stk-line.slt-base
     1829          acc-stk-line.slt-rubl-sale       = acc-stk-line.slt-rubl-sale       + tt-stk-line.slt-rubl
     1830          acc-stk-line.road-tax-base-sale  = acc-stk-line.road-tax-base-sale  + tt-stk-line.road-tax-base
     1831          acc-stk-line.road-tax-rubl-sale  = acc-stk-line.road-tax-rubl-sale  + tt-stk-line.road-tax-rubl
