     1833          acc-stk-line.excise-rubl-sale    = acc-stk-line.excise-rubl-sale    + tt-stk-line.excise-rubl
     1834          acc-stk-line.transport-base-sale = acc-stk-line.transport-base-sale + tt-stk-line.transport-base
     1835          acc-stk-line.transport-rubl-sale = acc-stk-line.transport-rubl-sale + tt-stk-line.transport-rubl
     1836          acc-stk-line.other-base-sale     = acc-stk-line.other-base-sale     + tt-stk-line.other-base
     1837          acc-stk-line.other-rubl-sale     = acc-stk-line.other-rubl-sale     + tt-stk-line.other-rubl.
