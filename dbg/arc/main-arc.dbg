     1353   do:
     1354     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1355       (input  v-cntxt-db-num
     1356       ,input  v-cntxt-userid
     1357       ,input  0
     1358       ,input  'actn_archive_cost':U
     1359       ,input  'object':U
     1360       ,input  v-chk-act-host-code
     1361       ,input  tt-clients.obj-type
     1362       ,input  tt-clients.obj-code
     1363       ,input  0
     1364       ,input  0
     1365       ,input  0
     1366       ,input  false
     1367       ,output g-cost-arc
     1368       )  .
     1369   end.
     1370       if g-cost-arc <> true
     1371       then do:
     1372         leave scan_block.
     1373       end.
     1374     end.
     1375   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   assign fact-order-min = 0
     1377          fact-order-max = 0.
     1378   for each tt-clients:
     1379      run dfactord (input  tt-clients.obj-type,
     1380                    input  tt-clients.obj-code,
     1381                    input  (if varis-calend = 1 then yes else no),
     1382                    input  varis-shift-num,
     1383                    input  vardate-start,
     1384                    input  vardate-end,
     1385                    input  varshift-start,
     1386                    input  varshift-end,
     1387                    output fact-order-start,
     1388                    output fact-order-end) no-error.
     1389      if error-status:error then do:
     1390         message "Ошибка при определении диапазона данных."
     1391         view-as alert-box error.
     1392         return no-apply.
     1393      end.
     1394      if fact-order-end = 0 then next.
     1395      if fact-order-start > fact-order-min then assign fact-order-min = fact-order-start.
     1396      if fact-order-end   > fact-order-max then assign fact-order-max = fact-order-end.
     1397     define variable v-ind as integer   no-undo .
     1398     define variable v-r-b-base as logical   no-undo .
     1399   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1401     (output v-r-b-base
     1402     )  .
     1403     for each tt-goods
     1404     :
