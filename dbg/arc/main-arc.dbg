     1843          acc-stk-line.vat-base-doc       = acc-stk-line.vat-base-doc       + tt-stk-line.vat-base
     1844          acc-stk-line.vat-rubl-doc       = acc-stk-line.vat-rubl-doc       + tt-stk-line.vat-rubl
     1845          acc-stk-line.slt-base-doc       = acc-stk-line.slt-base-doc       + tt-stk-line.slt-base
     1846          acc-stk-line.slt-rubl-doc       = acc-stk-line.slt-rubl-doc       + tt-stk-line.slt-rubl
     1847          acc-stk-line.road-tax-base-doc  = acc-stk-line.road-tax-base-doc  + tt-stk-line.road-tax-base
     1848          acc-stk-line.road-tax-rubl-doc  = acc-stk-line.road-tax-rubl-doc  + tt-stk-line.road-tax-rubl
     1849          acc-stk-line.excise-base-doc    = acc-stk-line.excise-base-doc    + tt-stk-line.excise-base
     1850          acc-stk-line.excise-rubl-doc    = acc-stk-line.excise-rubl-doc    + tt-stk-line.excise-rubl
     1851          acc-stk-line.transport-base-doc = acc-stk-line.transport-base-doc + tt-stk-line.transport-base
     1852          acc-stk-line.transport-rubl-doc = acc-stk-line.transport-rubl-doc + tt-stk-line.transport-rubl
     1853          acc-stk-line.other-base-doc     = acc-stk-line.other-base-doc     + tt-stk-line.other-base
     1854          acc-stk-line.other-rubl-doc     = acc-stk-line.other-rubl-doc     + tt-stk-line.other-rubl.
     1855          otherwise do:
