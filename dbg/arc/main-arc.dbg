      134     run proc-alt-shift-f2.
      135   end.
      136   on alt-shift-f3 anywhere do:
      137     run proc-alt-shift-f3 in this-procedure .
      138   end.
      139   on alt-shift-f4 anywhere do:
      140     run proc-alt-shift-f4 in this-procedure.
      141   end.
      142   on alt-f1 anywhere do:
      143     run proc-alt-f1 in this-procedure .
      144   end.
      145   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define variable varis-calend     as integer   no-undo.
      147   define variable varis-shift-num  as logical   no-undo.
      148   define variable vardate-start    as date      no-undo.
      149   define variable vardate-end      as date      no-undo.
      150   define variable varshift-start   as integer   no-undo.
      151   define variable varshift-end     as integer   no-undo.
      152   define variable varext-doc-type  as character no-undo.
      153   define variable varrubl-base     as integer   no-undo.
      154   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   define variable v-waitfram-action01         as character   no-undo .
      156   define variable v-waitfram-action02         as character   no-undo .
      157   define variable v-waitfram-action03         as character   no-undo .
      158   define variable mWaitFramTextBeg            as character   no-undo.
      159   define variable mWaitFramTextEnd            as character   no-undo.
      160   define variable mWaitFramView               as logical     no-undo.
      161   define variable mWaitProcEvent              as logical     no-undo init yes.
      162   define variable mWaitFramInterval           as integer     no-undo init 1 .
      163   define variable mWaitFramStop               as logical     no-undo.
      164   define variable mWaitFramStopUser           as logical     no-undo.
      165   define variable mWaitFramStopTimeOut        as logical     no-undo.
      166   define variable mWaitFramStartProc          as datetime-tz no-undo.
      167   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      168   define button B-WaitFramStop auto-end-key
      169        label "Стоп"
      170        size 10 by 1 tooltip "Остоновить процесс".
      171   define button B-viewProcInfo
      172        label "Информация"
      173        size 15 by 1 tooltip "Информация о процесс".
      174   define frame waitfram
      175     v-waitfram-action01 format "x(72)" no-label skip
      176     v-waitfram-action02 format "x(72)" no-label skip
      177     v-waitfram-action03 format "x(72)" no-label skip
      178     B-viewProcInfo
      179     B-WaitFramStop at row 4 col 30
      180     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      181     .
      182   define new global shared variable mBatchMode as logical no-undo init ?.
      183   define variable mFramBachModHandle as handle no-undo.
      184   mFramBachModHandle = frame waitfram:handle.
      185   define variable mFameOldVis as logical no-undo.
      186   define variable mVisCUrentVin as logical no-undo.
      187   if session:batch-mode
      188   then
      189      mBatchMode = yes.
      190   if mBatchMode = ? then do:
      191     mVisCUrentVin = current-window:visible.
      192     mFameOldVis = mFramBachModHandle:visible.
      193     mFramBachModHandle:visible  = yes.
      194     mBatchMode = mFramBachModHandle:visible ne yes.
      195     mFramBachModHandle:visible = mFameOldVis.
      196     current-window:visible = mVisCUrentVin.
      197   end.
      198    if  log-manager:logfile-name ne ?
      199     then DO:
      200         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      201         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      202         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      203     end.
      204   on choose of B-WaitFramStop in frame waitfram
      205   do:
      206     mWaitFramStop = yes.
      207     mWaitFramStopUser = yes.
      208   end.
      209   function waitfram-check-timeout returns logical():
      210      define variable vtime as int64 no-undo.
      211      if mWaitFramStopTimeOut
      212      then
      213         return yes.
      214      vtime = ( now - mWaitFramStartProc ) / 1000 .
      215      if     mWaitFramTimeOut ne ?
      216         and mWaitFramTimeOut ne 0
      217         and mWaitFramTimeOut lt vtime
      218      then do:
      219         mWaitFramStopTimeOut = yes.
      220      end.
      221      return mWaitFramStopTimeOut.
      222   end.
      223   procedure waitfram-hide :
      224     if not session:batch-mode
      225     then do
      226     on error undo, return error return-value
      227     :
      228       pause 0 before-hide .
      229       if not mBatchMode then
      230         hide frame waitfram .
      231     if     not mWaitFramView
      232        and mWaitProcEvent
      233     then
      234       process events .
      235     end.
      236   end procedure.
      237   procedure waitfram-show :
      238     define input  parameter p-message as character no-undo .
      239     define variable v-left-margin as integer   no-undo .
      240     if not session:batch-mode
      241     then do
      242     on error undo, return error return-value
      243     :
      244       if length(p-message) <= 70 then do:
      245         assign
      246           v-left-margin = integer((70 - length(p-message)) / 2)
      247         .
      248         assign
      249           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      250         .
      251         assign
      252           v-waitfram-action01 = " "
      253           v-waitfram-action02 = " "
      254                                    + fill(" ", v-left-margin)
      255                                    + p-message
      256           v-waitfram-action03 = " "
      257         .
      258       end.
      259       else do:
      260         define variable vRindex1 as integer no-undo.
      261         define variable vRindex2 as integer no-undo.
      262         vRindex1 = r-index(p-message," ",70).
      263         if vRindex1 = 0
      264         then
      265            vRindex1 = 70.
      266         if length(p-message)  <= vRindex1 + 70 then do:
      267           assign
      268             v-waitfram-action01 = " "
      269             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      270             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      271           .
      272         end.
      273         else do:
      274           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      275           if vRindex2 <= vRindex1
      276           then
      277              vRindex2 = vRindex1 + 70.
      278           assign
      279             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      280             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      281             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      282           .
      283         end.
      284       end.
      285       B-viewProcInfo:visible   in frame waitfram = no.
      286       B-viewProcInfo:sensitive in frame waitfram = no.
      287       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      288       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      289       if  (   mWaitFramView
      290          or  mWaitProcEvent)
      291          and not mBatchMode
      292       then
      293          display
      294             v-waitfram-action01 skip
      295             v-waitfram-action02 skip
      296             v-waitfram-action03 skip
      297          with frame waitfram .
      298       if     mWaitFramView
      299          then do:
      300             if     mWaitFramInterval ne ?
      301                and not mBatchMode
      302             then
      303                wait-for go of frame waitfram pause mWaitFramInterval.
      304          end.
      305          else
      306             if     mWaitProcEvent
      307                and not mBatchMode
      308             then
      309                process events .
      310     end.
      311   end procedure.
      312      procedure waitfram-show-this:
      313         define input  parameter iInterval as int64 no-undo.
      314         define variable vtime as int64 no-undo.
      315         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      316         mWaitFramInterval = iInterval.
      317         run waitfram-show (substitute("&1&2 &3&4" ,
      318                                       mWaitFramTextBeg ,
      319                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      320                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      321                                       mWaitFramTextEnd
      322                                      )
      323                           ).
      324      end.
      325      procedure WaitFramRunPause:
      326         define input  parameter iInterval as dec no-undo.
      327         define variable vStart  as datetime-tz no-undo.
      328         define variable vend    as datetime-tz no-undo.
      329         define variable vint as int64 no-undo.
      330         define variable vOk as logical no-undo.
      331         vStart = now.
      332         vend   = vStart.
      333         publish "WaitFramPause" (iInterval,output vOk).
      334         vend   =  now.
      335         vint = vend - vStart.
      336         vint = iInterval - vint / 1000.
      337         if     not mWaitFramStop
      338            and (   vint > 0
      339                 or (    not vOk
      340                     and iInterval eq ?
      341                     )
      342                 )
      343         then
      344            run waitfram-show-this (iInterval).
      345         vend   =  now.
      346         vint = vend - vStart.
      347         vint = iInterval - vint / 1000.
      348         if     not mWaitFramStop
      349            and vint > 0
      350         then do:
      351            run gbl/pause.p (vint * 1000).
      352         end.
      353         if iInterval ne ?
      354         then
      355            publish "WaitFramStop".
      356         waitfram-check-timeout().
      357      end.
      358      procedure WaitFramWaitFor:
      359         define input  parameter iInterval as dec no-undo.
      360         assign
      361            mWaitFramStartProc   = now
      362            mWaitFramStopUser    = no
      363            mWaitFramStopTimeOut = no
      364         .
      365         block-wait:
      366         do while not mWaitFramStop:
      367            run WaitFramRunPause (iInterval).
      368            if  waitfram-check-timeout()
      369            then do:
      370               leave block-wait.
      371            end.
      372         end.
      373         run waitfram-hide.
      374      end.
      375   procedure waitfram-join :
      376     define input  parameter p-line-1  as character no-undo .
      377     define input  parameter p-line-2  as character no-undo .
      378     define input  parameter p-line-3  as character no-undo .
      379     define output parameter p-message as character no-undo .
      380     do
      381     on error undo, return error return-value
      382     :
      383       assign
      384         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      385                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      386                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      387       .
      388     end.
      389   end procedure.
      390   function waitfram-join-function returns character
      391     (input p-line-1 as character
      392     ,input p-line-2 as character
      393     ,input p-line-3 as character
      394     ).
      395     define variable v-message as character no-undo .
      396     run waitfram-join in this-procedure
      397       (input  p-line-1
      398       ,input  p-line-2
      399       ,input  p-line-3
      400       ,output v-message
      401       ) .
      402     return v-message .
      403   end function .
