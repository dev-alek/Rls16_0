     1695             acc-stk-line.sum-base       = ?
     1696             acc-stk-line.sum-rubl       = ?
     1697             acc-stk-line.vat-base       = ?
     1698             acc-stk-line.vat-rubl       = ?
     1699             acc-stk-line.slt-base       = ?
     1700             acc-stk-line.slt-rubl       = ?
     1701             acc-stk-line.road-tax-base  = ?
