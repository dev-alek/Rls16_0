      436   define new global shared variable g#language as character no-undo .
      437   if g#language <> '' and g#language <> 'rus':U then do:
      438     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      439   end.
      440   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   procedure lastordr :
      442     define input  parameter parobj-type     as character no-undo .
      443     define input  parameter parobj-code     as integer   no-undo .
      444     define input  parameter paris-shift     as logical   no-undo .
      445     define input  parameter paris-shift-num as logical   no-undo .
      446     define input  parameter pardate         as date      no-undo .
      447     define input  parameter parshift-num    as integer   no-undo .
      448     define output parameter parfact-order   as decimal   no-undo .
      449     if paris-shift = no
      450     then do:
      451       find last ub.stk-tot no-lock
      452         where ub.stk-tot.obj-type    = parobj-type
      453           and ub.stk-tot.obj-code    = parobj-code
      454           and ub.stk-tot.fact-date <= pardate
      455           and ub.stk-tot.shift-num  = 0
      456         use-index fact-date
      457         no-error .
      458     end.
      459     else do:
      460       if paris-shift-num = no
      461       then do:
      462         find last ub.stk-tot no-lock
      463           where ub.stk-tot.obj-type    = parobj-type
      464             and ub.stk-tot.obj-code    = parobj-code
      465             and ub.stk-tot.shift-date <= pardate
      466             and ub.stk-tot.shift-num   > 0
      467           use-index shift-num
      468           no-error .
      469       end.
      470       else do:
      471         find last ub.stk-tot no-lock
      472           where ub.stk-tot.obj-type   = parobj-type
      473             and ub.stk-tot.obj-code   = parobj-code
      474             and ub.stk-tot.shift-date = pardate
      475             and ub.stk-tot.shift-num  <= parshift-num
      476             and ub.stk-tot.shift-num  > 0
      477           use-index shift-num
      478           no-error .
      479         if not available ub.stk-tot
      480         then do:
      481           find last ub.stk-tot no-lock
      482             where ub.stk-tot.obj-type   = parobj-type
      483               and ub.stk-tot.obj-code   = parobj-code
      484               and ub.stk-tot.shift-date < pardate
      485               and ub.stk-tot.shift-num  > 0
      486             use-index shift-num
      487             no-error .
      488         end.
      489       end.
      490     end.
      491     assign
      492       parfact-order = (if available ub.stk-tot then ub.stk-tot.fact-order else 0)
      493     .
      494   end procedure.
      495   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   procedure dfactord:
      497   define input  parameter parobj-type         like ub.clients.obj-type   no-undo.
      498   define input  parameter parobj-code         like ub.clients.obj-code   no-undo.
      499   define input  parameter paris-calend-day    as   logical            no-undo.
      500   define input  parameter paris-shift-num     as   logical            no-undo.
      501   define input  parameter pardate-start       as   date               no-undo.
      502   define input  parameter pardate-end         as   date               no-undo.
      503   define input  parameter parshift-start      as   integer            no-undo.
      504   define input  parameter parshift-end        as   integer            no-undo.
      505   define output parameter parfact-order-start like ub.stk-tot.fact-order no-undo.
      506   define output parameter parfact-order-end   like ub.stk-tot.fact-order no-undo.
      507   if paris-calend-day then do:
      508      run lastordr
      509          (input  parobj-type,
      510           input  parobj-code,
      511           input  no,
      512           input  ?,
      513           input  pardate-start - 1,
      514           input  ?,
      515           output parfact-order-start) no-error.
      516      if error-status:error then return error.
      517      run lastordr
      518          (input  parobj-type,
      519           input  parobj-code,
      520           input  no,
      521           input  ?,
      522           input  pardate-end,
      523           input  ?,
      524           output parfact-order-end) no-error.
      525      if error-status:error then return error.
      526   end.
      527   else do:
      528      if paris-shift-num then do:
      529         run lastordr
      530             (input  parobj-type,
      531              input  parobj-code,
      532              input  yes,
      533              input  yes,
      534              input  pardate-start,
      535              input  parshift-start - 1,
      536              output parfact-order-start) no-error.
      537         if error-status:error then return error.
      538         run lastordr
      539             (input  parobj-type,
      540              input  parobj-code,
      541              input  yes,
      542              input  yes,
      543              input  pardate-end,
      544              input  parshift-end,
      545              output parfact-order-end) no-error.
      546         if error-status:error then return error.
      547      end.
      548      else do:
      549         run lastordr
      550             (input  parobj-type,
      551              input  parobj-code,
      552              input  yes,
      553              input  no,
      554              input  pardate-start - 1,
      555              input  ?,
      556              output parfact-order-start) no-error.
      557         if error-status:error then return error.
      558         run lastordr
      559             (input  parobj-type,
      560              input  parobj-code,
      561              input  yes,
      562              input  no,
      563              input  pardate-end,
      564              input  ?,
      565              output parfact-order-end) no-error.
      566         if error-status:error then return error.
      567      end.
      568   end.
      569   end procedure.
      570   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571     define temp-table tt-stk-line no-undo like ub.stk-line.
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   procedure stk-lnst:
      574   define input  parameter parobj-type   like ub.clients.obj-type    no-undo.
      575   define input  parameter parobj-code   like ub.clients.obj-code    no-undo.
      576   define input  parameter parartic      like ub.goods.artic         no-undo.
      577   define input  parameter parprod-type  like ub.goods.prod-type     no-undo.
      578   define input  parameter parprod-code  like ub.goods.prod-code     no-undo.
      579   define input  parameter parfact-order like ub.stk-line.fact-order no-undo.
      580   define input  parameter parsum-type   like ub.stk-line.sum-type   no-undo.
      581   define input  parameter parcat-id     like ub.stk-line.cat-id     no-undo.
      582   define input  parameter paris-shift   as   logical             no-undo.
      583   define output parameter table for tt-stk-line.
      584   if paris-shift then do:
      585     find last ub.stk-line where ub.stk-line.obj-type    = parobj-type   and
      586                              ub.stk-line.obj-code    = parobj-code   and
      587                              ub.stk-line.artic       = parartic      and
      588                              ub.stk-line.prod-type   = parprod-type  and
      589                              ub.stk-line.prod-code   = parprod-code  and
      590                              ub.stk-line.fact-order <= parfact-order and
      591                              ub.stk-line.sum-type    = parsum-type   and
      592                              ub.stk-line.cat-id      = parcat-id     and
      593                              ub.stk-line.shift-date <> ?             use-index category no-lock no-error.
      594   end.
      595   else do:
      596     find last ub.stk-line where ub.stk-line.obj-type    = parobj-type   and
      597                              ub.stk-line.obj-code    = parobj-code   and
      598                              ub.stk-line.artic       = parartic      and
      599                              ub.stk-line.prod-type   = parprod-type  and
      600                              ub.stk-line.prod-code   = parprod-code  and
      601                              ub.stk-line.fact-order <= parfact-order and
      602                              ub.stk-line.sum-type    = parsum-type   and
      603                              ub.stk-line.cat-id      = parcat-id     and
      604                              ub.stk-line.shift-date  = ?             use-index category no-lock no-error.
      605   end.
      606   if available ub.stk-line then do:
      607      create tt-stk-line.
      608      buffer-copy ub.stk-line to tt-stk-line.
      609   end.
      610   end procedure.
      611   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   define temp-table start-stk-line no-undo like ub.stk-line.
      613   define temp-table end-stk-line   no-undo like ub.stk-line.
      614   procedure stk-lnrv:
      615   define input  parameter parobj-type         like ub.clients.obj-type       no-undo.
      616   define input  parameter parobj-code         like ub.clients.obj-code       no-undo.
      617   define input  parameter parartic            like ub.goods.artic            no-undo.
      618   define input  parameter parprod-type        like ub.goods.prod-type        no-undo.
      619   define input  parameter parprod-code        like ub.goods.prod-code        no-undo.
      620   define input  parameter parfact-order-start like ub.stk-line.fact-order no-undo.
      621   define input  parameter parfact-order-end   like ub.stk-line.fact-order no-undo.
      622   define input  parameter parsum-type         like ub.stk-line.sum-type   no-undo.
      623   define input  parameter parcat-id           like ub.stk-line.cat-id     no-undo.
      624   define input  parameter paris-shift         as   logical                no-undo.
      625   define output parameter table for tt-stk-line.
      626   define variable i                as integer no-undo.
      627   define variable varqnty-doc-type as integer no-undo.
      628   define variable varsum-type like ub.stk-line.sum-type no-undo.
      629   do on error undo, return error return-value :
      630   assign varqnty-doc-type = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
      631   do i = 1 to varqnty-doc-type:
      632      assign varsum-type = parsum-type + ENTRY(i, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
      633   if paris-shift then do:
      634     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
      635   end.
      636   else do:
      637     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
      638   end.
      639   if paris-shift then do:
      640     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
      641   end.
      642   else do:
      643     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
      644   end.
      645   if
      646      available end-stk-line   and
      647      (not available start-stk-line or
      648      start-stk-line.fact-order <> end-stk-line.fact-order) then do:
      649         create tt-stk-line.
      650         assign
      651         tt-stk-line.obj-type       = parobj-type
      652         tt-stk-line.obj-code       = parobj-code
      653         tt-stk-line.artic          = parartic
      654         tt-stk-line.prod-type      = parprod-type
      655         tt-stk-line.prod-code      = parprod-code
      656         tt-stk-line.sum-type       = varsum-type
      657         tt-stk-line.cat-id         = parcat-id
      658         tt-stk-line.fact-qnty      = (if available end-stk-line then (end-stk-line.fact-qnty      - (if available start-stk-line then start-stk-line.fact-qnty      else 0)) else 0)
      659         tt-stk-line.sum-base       = (if available end-stk-line then (end-stk-line.sum-base       - (if available start-stk-line then start-stk-line.sum-base       else 0)) else 0)
      660         tt-stk-line.sum-rubl       = (if available end-stk-line then (end-stk-line.sum-rubl       - (if available start-stk-line then start-stk-line.sum-rubl       else 0)) else 0)
      661         tt-stk-line.SLT-base       = (if available end-stk-line then (end-stk-line.SLT-base       - (if available start-stk-line then start-stk-line.SLT-base       else 0)) else 0)
      662         tt-stk-line.SLT-rubl       = (if available end-stk-line then (end-stk-line.SLT-rubl       - (if available start-stk-line then start-stk-line.SLT-rubl       else 0)) else 0)
      663         tt-stk-line.VAT-base       = (if available end-stk-line then (end-stk-line.VAT-base       - (if available start-stk-line then start-stk-line.VAT-base       else 0)) else 0)
      664         tt-stk-line.VAT-rubl       = (if available end-stk-line then (end-stk-line.VAT-rubl       - (if available start-stk-line then start-stk-line.VAT-rubl       else 0)) else 0)
      665         tt-stk-line.excise-base    = (if available end-stk-line then (end-stk-line.excise-base    - (if available start-stk-line then start-stk-line.excise-base    else 0)) else 0)
      666         tt-stk-line.excise-rubl    = (if available end-stk-line then (end-stk-line.excise-rubl    - (if available start-stk-line then start-stk-line.excise-rubl    else 0)) else 0)
      667         tt-stk-line.other-base     = (if available end-stk-line then (end-stk-line.other-base     - (if available start-stk-line then start-stk-line.other-base     else 0)) else 0)
      668         tt-stk-line.other-rubl     = (if available end-stk-line then (end-stk-line.other-rubl     - (if available start-stk-line then start-stk-line.other-rubl     else 0)) else 0)
      669         tt-stk-line.road-tax-base  = (if available end-stk-line then (end-stk-line.road-tax-base  - (if available start-stk-line then start-stk-line.road-tax-base  else 0)) else 0)
      670         tt-stk-line.road-tax-rubl  = (if available end-stk-line then (end-stk-line.road-tax-rubl  - (if available start-stk-line then start-stk-line.road-tax-rubl  else 0)) else 0)
      671         tt-stk-line.transport-base = (if available end-stk-line then (end-stk-line.transport-base - (if available start-stk-line then start-stk-line.transport-base else 0)) else 0)
      672         tt-stk-line.transport-rubl = (if available end-stk-line then (end-stk-line.transport-rubl - (if available start-stk-line then start-stk-line.transport-rubl else 0)) else 0).
      673      end.
      674   end.
      675   end.
      676   end procedure.
      677   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   procedure tax-name:
      679   define input  parameter pardef-tax  as character           no-undo.
      680   define output parameter parname-tax as character initial ? no-undo.
      681   define buffer bf_tax for ub.tax.
      682   do on error undo, return error :
      683      case pardef-tax:
      684         when 'vat':U then do:
      685                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      686         end.
      687         when 'slt':U then do:
      688                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      689         end.
      690         when 'rdt':U then do:
      691                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      692         end.
      693         when 'exc':U then do:
      694                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      695         end.
      696         otherwise do:
      697            return error "Задан неверный параметр " + pardef-tax + " .".
      698         end.
      699      end case.
      700   end.
      701   end procedure.
      702   define variable rdtaxname as character no-undo.
      703   define variable varsum-start like ub.stk-line.sum-base no-undo.
      704   define variable varsum-end like ub.stk-line.sum-base no-undo.
      705   define variable varsum-start-sale like ub.stk-line.sum-base no-undo.
      706   define variable varsum-end-sale like ub.stk-line.sum-base no-undo.
      707   define variable varorder as integer no-undo.
      708   define variable varroad-tax like ub.ot-line.sum-base no-undo.
      709   define variable varroad-tax-doc like ub.ot-line.sum-base no-undo.
      710   RUN set-attribute-list (
      711       'Keys-Accepted = "",
      712        Keys-Supplied = ""':U).
      713   FUNCTION func-excise RETURNS DECIMAL
      714     ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      715   FUNCTION func-excise-doc RETURNS DECIMAL
      716     ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      717   FUNCTION func-other RETURNS DECIMAL
      718      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      719   FUNCTION func-other-doc RETURNS DECIMAL
      720    ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      721   FUNCTION func-price-doc RETURNS DECIMAL
      722   ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      723   FUNCTION func-price-sale RETURNS DECIMAL
      724   ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      725   FUNCTION func-road-tax RETURNS DECIMAL
      726      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      727   FUNCTION func-road-tax-doc RETURNS DECIMAL
      728    ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      729   FUNCTION func-slt RETURNS DECIMAL
      730    ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      731   FUNCTION func-slt-doc RETURNS DECIMAL
      732   ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      733   FUNCTION func-sum RETURNS DECIMAL
      734      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      735   FUNCTION func-sum-doc RETURNS DECIMAL
      736      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      737   FUNCTION func-sum-end RETURNS DECIMAL
      738     ( buffer bf_tt-kind-sum for tt-kind-sum )  FORWARD.
      739   FUNCTION func-sum-end-sale RETURNS DECIMAL
      740     ( buffer bf_tt-kind-sum for tt-kind-sum )  FORWARD.
      741   FUNCTION func-sum-sale RETURNS DECIMAL
      742      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      743   FUNCTION func-sum-start RETURNS DECIMAL
      744     ( buffer bf_tt-kind-sum for tt-kind-sum )  FORWARD.
      745   FUNCTION func-sum-start-sale RETURNS DECIMAL
      746     ( buffer bf_tt-kind-sum for tt-kind-sum )  FORWARD.
      747   FUNCTION func-transport RETURNS DECIMAL
      748      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      749   FUNCTION func-transport-doc RETURNS DECIMAL
      750     ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      751   FUNCTION func-vat RETURNS DECIMAL
      752      ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      753   FUNCTION func-vat-doc RETURNS DECIMAL
      754       ( buffer bf_acc-stk-line for acc-stk-line )  FORWARD.
      755   DEFINE VARIABLE varqnty-end AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
      756        VIEW-AS FILL-IN
      757        SIZE 14 BY 1 NO-UNDO.
      758   DEFINE VARIABLE varqnty-start AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0
      759        VIEW-AS FILL-IN
      760        SIZE 14 BY 1 NO-UNDO.
      761   DEFINE RECTANGLE RECT-11
      762        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      763        SIZE 98 BY 1.83.
      764   DEFINE RECTANGLE RECT-12
      765        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      766        SIZE .38 BY 1.58.
      767   DEFINE RECTANGLE RECT-13
      768        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      769        SIZE .13 BY 1.88.
      770   DEFINE QUERY b-kind-type FOR
      771         tt-kind-sum SCROLLING.
      772   DEFINE QUERY BROWSE-1 FOR
      773         acc-stk-line SCROLLING.
      774   DEFINE BROWSE b-kind-type
      775     QUERY b-kind-type DISPLAY
      776         tt-kind-sum.sum-kind column-label " "
      777         func-sum-start-sale (buffer tt-kind-sum) @ varsum-start-sale column-label "продажные" format " ->>>,>>>,>>>,>>9.99"
      778         func-sum-start (buffer tt-kind-sum) @ varsum-start column-label "учетные" format "->>,>>>>,>>>,>>9.99"
      779         func-sum-end-sale (buffer tt-kind-sum) @ varsum-end-sale column-label "продажные" format " ->>>,>>>,>>>,>>9.99"
      780         func-sum-end (buffer tt-kind-sum) @ varsum-end column-label "учетные" format "->>>,>>>,>>>,>>9.99"
      781       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 98.25 BY 3.92.
      782   DEFINE BROWSE BROWSE-1
      783     QUERY BROWSE-1 DISPLAY
      784         acc-stk-line.ext-doc-type-full COLUMN-LABEL "Оборот по док." FORMAT "X(20)"
      785         acc-stk-line.fact-qnty COLUMN-LABEL "Количество"
      786         func-sum-doc (buffer acc-stk-line) FORMAT "->>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма(по док)"
      787         func-sum (buffer acc-stk-line) FORMAT "->>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма(учет)"
      788         func-sum-sale (buffer acc-stk-line) FORMAT "->>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма(прод)"
      789         func-other-doc(buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Скидка(Проч.расх.)(по док)"
      790         func-VAT-doc (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "НДС(по док)"
      791         func-SLT-doc (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "НП(по док)"
      792         func-VAT (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "НДС(учет)"
      793         func-SLT (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "НП(учет)"
      794         func-excise-doc (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Акциз(по док)"
      795         func-excise (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Акциз(учет)"
      796         func-road-tax-doc (buffer acc-stk-line) @ varroad-tax-doc   FORMAT "->,>>>,>>>,>>9.99"
      797         func-road-tax (buffer acc-stk-line) @ varroad-tax       FORMAT "->,>>>,>>>,>>9.99"
      798         func-transport-doc (buffer acc-stk-line)  FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Транспортные расходы(по док)"
      799         func-transport (buffer acc-stk-line)      FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Транспортные расходы"
      800         func-other (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Проч.расх.(Скидка)(учет)"
      801         func-price-doc (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма/кол-во(по док)"
      802         func-price-sale (buffer acc-stk-line) FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма/кол-во(прод)"
      803       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.25 BY 12.25.
      804   DEFINE FRAME F-Main
      805        varqnty-start AT ROW 1.79 COL 27.88 COLON-ALIGNED NO-LABEL
      806        varqnty-end AT ROW 1.79 COL 72.75 COLON-ALIGNED NO-LABEL
      807        b-kind-type AT ROW 2.96 COL 1
      808        BROWSE-1 AT ROW 6.96 COL 1
      809        "Остаток на конец периода" VIEW-AS TEXT
      810             SIZE 24.63 BY .67 AT ROW 1.04 COL 69
      811             FGCOLOR 3
      812        "Остаток на начало периода" VIEW-AS TEXT
      813             SIZE 25.88 BY .67 AT ROW 1.04 COL 25.5
      814             FGCOLOR 3
      815        "  Количество" VIEW-AS TEXT
      816             SIZE 15.38 BY 1 AT ROW 1.83 COL 1.63
      817             FGCOLOR 3
      818        RECT-13 AT ROW 1 COL 56.38
      819        RECT-11 AT ROW 1.13 COL 1
      820        RECT-12 AT ROW 1.25 COL 17.75
      821       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      822            SIDE-LABELS NO-UNDERLINE THREE-D
      823            AT COL 1 ROW 1 SCROLLABLE .
      824   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      825   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      826   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      827   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      828   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      829   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      830   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      831   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      832   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      833   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      834   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      835         adm-object-hdl = FRAME F-Main:HANDLE.
      836   RUN ensure-broker.
      837   THIS-PROCEDURE:ADM-DATA =
      838        'ADM1.1~`':U +
      839        'SmartObject~`':U +
      840        '~`':U +
      841        'YES~`':U +
      842        '~`':U +
      843        'tt-kind-sum acc-stk-line~`':U +
      844        '~`':U +
      845        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      846           + "~`":U +
      847        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      848        'Record-Source,Record-Target,TableIO-Target~`':U +
      849        '~`':U +
      850        '~`~`~`~`~`~`~`~`~`~`~`':U +
      851        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      852            THEN "^^":U
      853        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      854             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      855   PROCEDURE adm-apply-entry :
      856     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      857   END PROCEDURE.
      858   PROCEDURE adm-destroy :
      859    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      860   END PROCEDURE.
      861   PROCEDURE adm-disable :
      862       DISABLE RECT-13 RECT-11 RECT-12 b-kind-type BROWSE-1 WITH FRAME F-Main.
      863       RUN dispatch ('disable-fields':U).
      864       RUN set-attribute-list ('ENABLED=no':U).
      865       RETURN.
      866   END PROCEDURE.
      867   PROCEDURE adm-edit-attribute-list :
      868         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      869         RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-enable :
      872       ENABLE UNLESS-HIDDEN RECT-13 RECT-11 RECT-12 b-kind-type BROWSE-1 WITH FRAME F-Main.
      873       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      874       RUN set-attribute-list ('ENABLED=yes':U).
      875       RETURN.
      876   END PROCEDURE.
      877   PROCEDURE adm-exit :
      878        RUN notify ('exit':U).
      879     RETURN.
      880   END PROCEDURE.
      881   PROCEDURE adm-hide :
      882     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      883   END PROCEDURE.
      884   PROCEDURE adm-initialize :
      885     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      886   END PROCEDURE.
      887   PROCEDURE adm-show-errors :
      888       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      889       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      890           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      891       END.
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-UIB-mode :
      895     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      896   END PROCEDURE.
      897   PROCEDURE adm-view :
      898     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      899   END PROCEDURE.
      900   PROCEDURE dispatch :
      901       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      902       RUN broker-dispatch IN adm-broker-hdl
      903           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      904       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      905   END PROCEDURE.
      906   PROCEDURE ensure-broker :
      907   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      908   IF RETURN-VALUE NE "ADM-Broker":U THEN
      909   DO:
      910       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      911       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      912   END.
      913   END PROCEDURE.
      914   PROCEDURE get-attribute :
      915     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      916     RUN broker-get-attribute IN adm-broker-hdl
      917         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      918     RETURN RETURN-VALUE.
      919   END PROCEDURE.
      920   PROCEDURE get-attribute-list :
      921     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      922     RUN broker-get-attribute-list IN adm-broker-hdl
      923         (INPUT THIS-PROCEDURE,
      924          INPUT ?,
      925          OUTPUT p-attr-list) NO-ERROR.
      926     RETURN.
      927   END PROCEDURE.
      928   PROCEDURE new-state :
      929     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      930     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      931     RETURN.
      932   END PROCEDURE.
      933   PROCEDURE notify :
      934     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      935     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      936     IF RETURN-VALUE = "ADM-ERROR":U THEN
      937         RETURN "ADM-ERROR":U.
      938     RETURN.
      939   END PROCEDURE.
      940   PROCEDURE set-attribute-list :
      941     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      942     RUN ensure-broker.
      943     RUN broker-set-attribute-list IN adm-broker-hdl
      944         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      945     RETURN.
      946   END PROCEDURE.
      947   PROCEDURE set-position :
      948       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      949       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      950       IF VALID-HANDLE(adm-object-hdl) THEN
      951       DO:
      952         ASSIGN adm-object-hdl:ROW    =   p-row
      953                adm-object-hdl:COLUMN =   p-col.
      954       END.
      955       RETURN.
      956   END PROCEDURE.
      957     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      958     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      959     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      960     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      961     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      962     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      963     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      964     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      965     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      966     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      967     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      968     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      969     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      970     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      971     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      972     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      973     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      974     IF "":U = "":U THEN
      975       RUN modify-list-attribute IN adm-broker-hdl
      976         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      977     RUN use-create-on-add(?).
      978   PROCEDURE adm-add-record :
      979       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      980          "must have at least one Enabled Table to perform Add.":U
      981          VIEW-AS ALERT-BOX ERROR.
      982       RETURN.
      983   END PROCEDURE.
      984   PROCEDURE adm-assign-record :
      985    MESSAGE
      986          "Object ":U THIS-PROCEDURE:FILE-NAME
      987            "must have at least one Enabled Table to perform Assign.":U
      988              VIEW-AS ALERT-BOX ERROR.
      989      RETURN.
      990     END PROCEDURE.
      991   PROCEDURE adm-assign-statement :
      992     RETURN.
      993   END PROCEDURE.
      994   PROCEDURE adm-cancel-record :
      995      RETURN.
      996     END PROCEDURE.
      997   PROCEDURE adm-copy-record :
      998       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      999        "must have at least one Enabled Table to perform Copy.":U
     1000          VIEW-AS ALERT-BOX ERROR.
     1001       RETURN.
     1002   END PROCEDURE.
     1003   PROCEDURE adm-create-record :
     1004      RETURN.
     1005   END PROCEDURE.
     1006   PROCEDURE adm-current-changed :
     1007     RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-delete-record :
     1010    MESSAGE
     1011          "Object ":U THIS-PROCEDURE:FILE-NAME
     1012            "must have at least one Enabled Table to perform Delete.":U
     1013              VIEW-AS ALERT-BOX ERROR.
     1014       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1015       RETURN.
     1016   END PROCEDURE.
     1017   PROCEDURE adm-disable-fields :
     1018         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1019       RETURN.
     1020   END PROCEDURE.
     1021   PROCEDURE adm-enable-fields :
     1022       RETURN.
     1023   END PROCEDURE.
     1024   PROCEDURE adm-end-update :
     1025     RETURN.
     1026   END PROCEDURE.
     1027   PROCEDURE adm-reset-record :
     1028       RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE adm-update-record :
     1031       MESSAGE
     1032         "Object ":U THIS-PROCEDURE:FILE-NAME
     1033           "must have at least one Enabled Table to perform Update.":U
     1034             VIEW-AS ALERT-BOX ERROR.
     1035      RETURN.
     1036   END PROCEDURE.
     1037   PROCEDURE check-modified :
     1038   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1039   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1040   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1041   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1042     IF check-state = "check":U THEN
     1043     DO:
     1044       RUN get-link-handle IN adm-broker-hdl
     1045         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1046            OUTPUT group-target-list).
     1047       IF group-target-list NE "":U THEN
     1048       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1049         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1050         RUN check-modified IN curr-widget ('group-check':U).
     1051         IF RETURN-VALUE NE "":U THEN
     1052         DO:
     1053           RUN check-modified-message(RETURN-VALUE).
     1054           RETURN "":U.
     1055         END.
     1056       END.
     1057     END.
     1058     RETURN "":U.
     1059   END PROCEDURE.
     1060   PROCEDURE check-modified-message :
     1061     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1062        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1063           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1064        IF RETURN-VALUE = "YES":U THEN
     1065           RUN notify ('view,CONTAINER-SOURCE':U).
     1066        MESSAGE IF p-changed-table NE ? THEN
     1067           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1068           ELSE "Current values have been changed."
     1069           SKIP "  Do you wish to save those changes?"
     1070           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1071        IF ANS THEN
     1072        DO:
     1073           IF group-assign-target THEN
     1074             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1075           ELSE RUN dispatch('update-record':U).
     1076           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1077           DO:
     1078               MESSAGE "Changes to the previous record were not saved."
     1079                 VIEW-AS ALERT-BOX ERROR.
     1080               IF group-assign-target THEN
     1081                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1082               ELSE RUN dispatch ('cancel-record':U).
     1083           END.
     1084        END.
     1085        ELSE DO:
     1086          IF group-assign-target THEN
     1087             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1088          ELSE RUN dispatch('cancel-record':U).
     1089        END.
     1090        RETURN.
     1091   END PROCEDURE.
     1092   PROCEDURE get-rowid :
     1093       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1094       ASSIGN
     1095       p-table   =   adm-first-table.
     1096       RETURN.
     1097   END PROCEDURE.
     1098   PROCEDURE init-group-assign :
     1099       RUN request-attribute IN adm-broker-hdl
     1100         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1101       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1102         group-assign-target = yes.
     1103       ELSE group-assign-target = no.
     1104       RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE set-editors :
     1107       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1108       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1109       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1110       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1111       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1112       DO WHILE VALID-HANDLE (curr-widget):
     1113           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1114              curr-widget:HIDDEN = no THEN DO:
     1115             CASE p-field-setting:
     1116               WHEN "INITIALIZE":U THEN
     1117               DO:
     1118                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1119                     read-only-list +
     1120                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1121                        STRING(curr-widget).
     1122               END.
     1123               WHEN "DISABLE":U OR
     1124               WHEN "ENABLE":U THEN
     1125               DO:
     1126                   curr-widget:SENSITIVE = yes.
     1127                   RUN get-attribute ('Read-Only-Editors':U).
     1128                   IF RETURN-VALUE = ? OR
     1129                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1130                       curr-widget:READ-ONLY =
     1131                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1132               END.
     1133               WHEN "CLEAR":U THEN
     1134                   curr-widget:SCREEN-VALUE = "":U.
     1135             END CASE.
     1136           END.
     1137           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1138       END.
     1139       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1140         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1141           + '"':U).
     1142       RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE use-check-modified-all :
     1145    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1146     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1147     RETURN.
     1148   END PROCEDURE.
     1149   PROCEDURE use-create-on-add :
     1150   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1151      RETURN.
     1152   END PROCEDURE.
     1153   PROCEDURE use-initial-lock :
     1154     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1155     ASSIGN adm-initial-lock = p-attr-value.
     1156     RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-display-fields :
     1159         IF AVAILABLE tt-kind-sum THEN
     1160             DISPLAY tt-kind-sum.sum-kind func-sum-start-sale (buffer tt-kind-sum) @ varsum-start-sale func-sum-start (buffer tt-kind-sum) @ varsum-start func-sum-end-sale (buffer tt-kind-sum) @ varsum-end-sale func-sum-end (buffer tt-kind-sum) @ varsum-end WITH BROWSE b-kind-type
     1161               NO-ERROR.
     1162         DISPLAY UNLESS-HIDDEN varqnty-start varqnty-end
     1163             WITH FRAME F-Main NO-ERROR.
     1164       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1165       RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE adm-open-query :
     1168               OPEN QUERY b-kind-type FOR EACH tt-kind-sum NO-LOCK.
     1169           adm-query-opened = yes.
     1170           IF NUM-RESULTS("b-kind-type":U) = 0 THEN
     1171               RUN new-state ('no-record-available,SELF':U).
     1172           ELSE DO:
     1173               RUN new-state ('record-available,SELF':U).
     1174               RUN new-state ('first-record,SELF':U).
     1175           END.
     1176           IF NOT adm-updating-record THEN
     1177               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
     1178     RETURN.
     1179   END PROCEDURE.
     1180   PROCEDURE adm-row-changed :
     1181         IF VALID-HANDLE(adm-object-hdl) THEN
     1182           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1183         RUN notify ('row-available':U).
     1184         RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE reposition-query :
     1187       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1188       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
     1189       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
     1190       IF table-name <> ? THEN
     1191           REPOSITION b-kind-type TO ROWID table-name NO-ERROR.
     1192       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1193       RETURN.
     1194   END PROCEDURE.
     1195     adm-sts = b-kind-type:SET-REPOSITIONED-ROW
     1196       (b-kind-type:DOWN,"CONDITIONAL":U).
     1197     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1198   PROCEDURE set-size :
     1199     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
     1200     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
     1201     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
     1202     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
     1203     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
     1204     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
     1205     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
     1206     ASSIGN pd_height = MAX(pd_height, 2.0)
     1207            pd_width  = MAX(pd_width, 2.0)
     1208            hBrowse     = b-kind-type:HANDLE IN FRAME F-Main
     1209            hFieldGroup = hBrowse:PARENT
     1210            htmpWidget  = hFieldGroup:FIRST-CHILD
     1211            hFrame      = hFieldGroup:PARENT.
     1212     Search-For-Siblings:
     1213     REPEAT WHILE VALID-HANDLE(htmpWidget):
     1214       IF htmpWidget NE hBrowse THEN DO:
     1215         IF htmpWidget:TYPE NE "BUTTON" OR
     1216            htmpWidget:X    NE 4 OR
     1217            htmpWidget:Y    NE 4 THEN DO:
     1218           RETURN.
     1219         END.
     1220       END.
     1221       htmpWidget = htmpWidget:NEXT-SIBLING.
     1222     END.
     1223     IF pd_width < hBrowse:WIDTH THEN
     1224       ASSIGN hBrowse:WIDTH = pd_width
     1225              hFrame:WIDTH  = pd_width     NO-ERROR.
     1226     ELSE
     1227       ASSIGN hFrame:WIDTH  = pd_width
     1228              hBrowse:WIDTH = pd_width     NO-ERROR.
     1229     IF pd_height < hBrowse:HEIGHT THEN
     1230       ASSIGN hBrowse:HEIGHT = pd_height
     1231              hFrame:HEIGHT  = pd_height     NO-ERROR.
     1232     ELSE
     1233       ASSIGN hFrame:HEIGHT  = pd_height
     1234              hBrowse:HEIGHT = pd_height     NO-ERROR.
     1235   END PROCEDURE.
     1236   ASSIGN
     1237          FRAME F-Main:SCROLLABLE       = FALSE
     1238          FRAME F-Main:HIDDEN           = TRUE.
     1239   ASSIGN
     1240          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME F-Main     = 2.
     1241   ON END-ERROR OF FRAME F-Main
     1242   DO:
     1243     return no-apply.
     1244   END.
     1245   ON ENDKEY OF FRAME F-Main
     1246   DO:
     1247       return no-apply.
     1248   END.
     1249   ON MOUSE-SELECT-DBLCLICK OF BROWSE-1 IN FRAME F-Main
     1250   DO:
     1251     run set-attribute-list ('varext-doc-type=' + string(acc-stk-line.ext-doc-type)).
     1252     run notify ('read_doc-type,doctype-target':u).
     1253   END.
     1254   if not this-procedure :persistent
     1255   then do:
     1256     message
     1257       vss-workfile vss-revision vss-description skip
     1258       "Ошибка при запуске процедуры" skip
     1259       "Данную процедуру следует запускать только с параметром persistent" skip
     1260       view-as alert-box error .
     1261     undo, return error .
     1262   end.
     1263   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1264     run mainmenu_getcntxt in varparentproc
     1265       (output v-cntxt-db-num
     1266       ,output v-cntxt-userid
     1267       ,output v-cntxt-level
     1268       ,output v-cntxt-host-code-obj
     1269       ,output v-cntxt-obj-type
     1270       ,output v-cntxt-obj-code
     1271       ,output v-cntxt-db-num-obj
     1272       ,output v-cntxt-is-admin
     1273       ) .
