       38   define variable vss-revision    as character no-undo init "$Revision$":U .
       39   define variable vss-author      as character no-undo init "$Author$":U .
       40   define variable vss-date        as character no-undo init "$Date$":U .
       41   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       42   define variable vss-archive     as character no-undo init "$Archive$":U .
       43   define variable vss-description as character no-undo init "Просмотр складского архива по товару".
       44   procedure vss-get-info :
       45     define output parameter p-vss-revision    like vss-revision    no-undo .
       46     define output parameter p-vss-author      like vss-author      no-undo .
       47     define output parameter p-vss-date        like vss-date        no-undo .
       48     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       49     define output parameter p-vss-archive     like vss-archive     no-undo .
       50     define output parameter p-vss-description like vss-description no-undo .
       51     assign
       52       p-vss-revision    = vss-revision
       53       p-vss-author      = vss-author
       54       p-vss-date        = vss-date
       55       p-vss-workfile    = vss-workfile
       56       p-vss-archive     = vss-archive
       57       p-vss-description = vss-description
       58     .
       59   end procedure.
       60   procedure vss-get-parameters :
       61     define output parameter p-vss-parameters as character no-undo .
       62   end procedure.
       63   define new global shared variable g#vssrevis-logger as handle    no-undo .
       64   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       65   define variable v-vssrevis-logger                   as handle    no-undo .
       66   procedure vss-logevent :
       67     define input  parameter p-extra-paramters as character no-undo .
       68     define variable v-vssrevis-parameters as character no-undo .
       69     do
       70     on error undo, return error return-value
       71     :
       72       if  valid-handle(v-vssrevis-logger)
       73       and v-vssrevis-logger :get-signature("logevent") <> ""
       74       then do:
       75         run vss-get-parameters in this-procedure
       76           (output v-vssrevis-parameters
       77           ).
       78         run logevent in v-vssrevis-logger
       79           (input vss-workfile
       80           ,input vss-revision
       81           ,input v-vssrevis-parameters
       82           ,input p-extra-paramters
       83           ).
       84       end.
       85     end.
       86   end procedure.
       87   assign
       88     v-vssrevis-logger = g#vssrevis-logger
       89   .
       90   if  valid-handle(v-vssrevis-logger)
       91   and v-vssrevis-logger :get-signature("logevent") <> ""
       92   then do:
       93     assign
       94       v-vssrevis-logevent = true
       95     .
       96     run vss-logevent in this-procedure (input vss-description) .
       97   end.
       98   define new global shared variable g#library  as handle no-undo .
       99   define new global shared variable g#library2 as handle no-undo .
      100   procedure proc-alt-shift-f2:
      101     if not ibs.th.gbl.gbl-var:rcode
      102   then
      103     run gbl\inidebug.p .
      104   end.
      105   procedure proc-alt-shift-f3:
      106     run gbl/prvssinf.p
      107       ( input this-procedure
      108       ) .
      109   end.
      110   define variable v-inform-launched as logical no-undo initial false .
      111   procedure proc-alt-shift-f4:
      112     define variable v-action as character no-undo .
      113     if v-inform-launched = false then do:
      114       assign
      115         v-inform-launched = true
      116       .
      117       run gbl/d-inform.w
      118         (  input self
      119         ,  input this-procedure
      120         , output v-action
      121         ) no-error .
      122       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      123       assign
      124         v-inform-launched = false
      125       .
      126     end.
      127   end.
      128   procedure proc-alt-f1:
      129     run gbl/corrhelp.p
      130       (input this-procedure
      131       ) .
      132   end .
