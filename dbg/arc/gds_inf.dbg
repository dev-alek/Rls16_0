     1920   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1921   procedure minbtn-set :
     1922       do
     1923           on error undo, return error return-value
     1924           :
     1925           define variable ii              as integer       no-undo .
     1926           define variable fh              as widget-handle no-undo .
     1927           define variable hh              as widget-handle no-undo .
     1928           define variable v-h             as handle        extent 4 no-undo .
     1929           define variable v-name-button   as character     no-undo .
     1930           define variable v-help-old-x    as decimal       no-undo .
     1931           define variable v-help-old-y    as decimal       no-undo .
     1932           define variable v-help-old-size as decimal       no-undo .
     1933           define variable v-frame-width   as decimal       no-undo .
     1934           define variable jj              as integer       no-undo .
     1935           do
     1936               on error undo, return error
     1937               :
     1938               assign
     1939                   v-frame-width = frame D-Dialog:width - 0.3
     1940                   fh            = frame D-Dialog:first-child
     1941                   hh            = fh:first-child
     1942                   ii            = 1
     1943                   .
     1944               do while valid-handle(hh):
     1945                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1946                   do:
     1947                       case lc(hh:name) :
     1948                           when "b-help" then
     1949                               do:
     1950                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1951                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1952                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1953                                   hh:TOOLTIP = "Помощь" .
     1954                                   v-help-old-x = hh:column .
     1955                                   v-help-old-y = hh:row    .
     1956                                   v-help-old-size = hh:width .
     1957                                   hh:width-chars = 2.5 .
     1958                               end.
     1959                           when "b-print" then
     1960                               do:
     1961                                   hh:load-image("cmp/b-print.bmp":u) .
     1962                                   hh:TOOLTIP = "Печать" .
     1963                                   v-h[ii] = hh:handle .
     1964                                   ii = ii + 1 .
     1965                                   hh:width-chars = 3 .
     1966                               end.
     1967                           when "b-history" or
     1968                           when "b-hist" then
     1969                               do:
     1970                                   hh:load-image("cmp/b-hist.bmp":u) .
     1971                                   hh:TOOLTIP = "История" .
     1972                                   v-h[ii] = hh:handle .
     1973                                   ii = ii + 1 .
     1974                                   hh:width-chars = 3 .
     1975                               end.
     1976                           when "b-sch" then
     1977                               do:
     1978                                   hh:load-image("cmp/b-sch.bmp":u) .
     1979                                   hh:TOOLTIP = "Установка Фильтра" .
     1980                                   v-h[ii] = hh:handle .
     1981                                   ii = ii + 1 .
     1982                                   hh:width-chars = 3 .
     1983                               end.
     1984                           when "b-hist-user" then
     1985                               do:
     1986                                   hh:load-image("cmp/b-hist.bmp":u) .
     1987                                   hh:TOOLTIP = "История пользователя" .
     1988                                   ii = ii + 1 .
     1989                               end.
     1990                       end case.
     1991                   end.
     1992                   hh = hh:next-sibling.
     1993               end.
     1994               b-help:column = v-frame-width - b-help:width-chars.
     1995               jj = 0.
     1996               repeat ii = 4 to 1 by -1 :
     1997                   if valid-handle (v-h[ii] ) then
     1998                   do:
     1999                       jj  = jj + 1 .
     2000                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2001                       v-h[ii]:row    = v-help-old-y .
     2002                   end.
     2003               end.
     2004           end.
     2005       end.
     2006   end procedure.
