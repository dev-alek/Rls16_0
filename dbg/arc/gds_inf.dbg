     1460        'ADM1.1~`':U +
     1461        'SmartDialog~`':U +
     1462        'DIALOG-BOX~`':U +
     1463        'NO ~`':U +
     1464        '~`':U +
     1465        '~`':U +
     1466        '~`':U +
     1467        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1468           + "~`":U +
     1469        'Layout,Hide-on-Init~`':U +
     1470        '~`':U +
     1471        '~`':U +
     1472        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1473        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1474            THEN "^^":U
     1475        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1476             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1477   PROCEDURE adm-apply-entry :
     1478     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1479   END PROCEDURE.
     1480   PROCEDURE adm-destroy :
     1481    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1482   END PROCEDURE.
     1483   PROCEDURE adm-disable :
     1484       DISABLE b-exit b-arh b-print b-start-date b-goods b-object b-help vared-goods vardate-start vardate-end vared-obj r-rb fi-description-1 WITH FRAME D-Dialog.
     1485       RUN dispatch ('disable-fields':U).
     1486       RUN set-attribute-list ('ENABLED=no':U).
     1487       RETURN.
     1488   END PROCEDURE.
     1489   PROCEDURE adm-edit-attribute-list :
     1490         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1491         RETURN.
     1492   END PROCEDURE.
     1493   PROCEDURE adm-enable :
     1494       ENABLE UNLESS-HIDDEN b-exit b-arh b-print b-start-date b-goods b-object b-help vared-goods vardate-start vardate-end vared-obj r-rb fi-description-1 WITH FRAME D-Dialog.
     1495       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1496       RUN set-attribute-list ('ENABLED=yes':U).
     1497       RETURN.
     1498   END PROCEDURE.
     1499   PROCEDURE adm-exit :
     1500        RUN notify ('exit':U).
     1501     RETURN.
     1502   END PROCEDURE.
     1503   PROCEDURE adm-hide :
     1504     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1505   END PROCEDURE.
     1506   PROCEDURE adm-initialize :
     1507     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1508   END PROCEDURE.
     1509   PROCEDURE adm-show-errors :
     1510       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1511       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1512           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1513       END.
     1514       RETURN.
     1515   END PROCEDURE.
     1516   PROCEDURE adm-UIB-mode :
     1517     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1518   END PROCEDURE.
     1519   PROCEDURE adm-view :
     1520     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1521   END PROCEDURE.
     1522   PROCEDURE dispatch :
     1523       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1524       RUN broker-dispatch IN adm-broker-hdl
     1525           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1526       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1527   END PROCEDURE.
     1528   PROCEDURE ensure-broker :
     1529   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1530   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1531   DO:
     1532       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1533       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1534   END.
     1535   END PROCEDURE.
     1536   PROCEDURE get-attribute :
     1537     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1538     RUN broker-get-attribute IN adm-broker-hdl
     1539         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1540     RETURN RETURN-VALUE.
     1541   END PROCEDURE.
     1542   PROCEDURE get-attribute-list :
     1543     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1544     RUN broker-get-attribute-list IN adm-broker-hdl
     1545         (INPUT THIS-PROCEDURE,
     1546          INPUT ?,
     1547          OUTPUT p-attr-list) NO-ERROR.
     1548     RETURN.
     1549   END PROCEDURE.
     1550   PROCEDURE new-state :
     1551     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1552     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1553     RETURN.
     1554   END PROCEDURE.
     1555   PROCEDURE notify :
     1556     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1557     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1558     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1559         RETURN "ADM-ERROR":U.
     1560     RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE set-attribute-list :
     1563     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1564     RUN ensure-broker.
     1565     RUN broker-set-attribute-list IN adm-broker-hdl
     1566         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1567     RETURN.
     1568   END PROCEDURE.
     1569   PROCEDURE set-position :
     1570       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1571       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1572       IF VALID-HANDLE(adm-object-hdl) THEN
     1573       DO:
     1574           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1575           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1576           DO:
     1577             IF p-row = 0 THEN p-row =
     1578               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1579             IF p-col = 0 THEN p-col =
     1580               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1581           END.
     1582           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1583           DO:
     1584             parent-hdl = adm-object-hdl:PARENT.
     1585             IF p-row = 0 THEN p-row =
     1586               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1587                 parent-hdl:ROW.
     1588             IF p-col = 0 THEN p-col =
     1589               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1590                 parent-hdl:COL.
     1591           END.
     1592           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1593           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1594         ASSIGN adm-object-hdl:ROW    =   p-row
     1595                adm-object-hdl:COLUMN =   p-col.
     1596       END.
     1597       RETURN.
     1598   END PROCEDURE.
     1599   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1600       STRING(adm-object-hdl)).
     1601   PAUSE 0 BEFORE-HIDE.
     1602   PROCEDURE adm-change-page :
     1603     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1604     END PROCEDURE.
     1605   PROCEDURE delete-page :
     1606     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1607     RUN broker-delete-page IN adm-broker-hdl
     1608         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1609     END PROCEDURE.
     1610   PROCEDURE init-object :
     1611     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1612     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1613     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1614     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1615     RUN broker-init-object IN adm-broker-hdl
     1616         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1617          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1618     RETURN.
     1619   END PROCEDURE.
     1620   PROCEDURE init-pages :
     1621     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1622     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1623         INPUT p-page-list) NO-ERROR.
     1624     END PROCEDURE.
     1625   PROCEDURE select-page :
     1626     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1627     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1628         INPUT p-page#) NO-ERROR.
     1629     END PROCEDURE.
     1630   PROCEDURE view-page :
     1631     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1632     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1633         INPUT p-page#).
     1634     END PROCEDURE.
     1635   ASSIGN
     1636          FRAME D-Dialog:SCROLLABLE       = FALSE
     1637          FRAME D-Dialog:HIDDEN           = TRUE.
     1638   ASSIGN
     1639          varis-shift-num:HIDDEN IN FRAME D-Dialog           = TRUE.
     1640   ON END-ERROR OF FRAME D-Dialog
     1641   DO:
     1642     return no-apply.
     1643   END.
