      904   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   def
      906   new shared
      907   temp-table  obj-list no-undo
      908     field obj-type like ub.clients.obj-type
      909     field obj-code like ub.clients.obj-code
      910     field obj-name like ub.clients.obj-name
      911     field obj-id   as integer
