     2453   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     2454       MESSAGE "A SmartDialog is not intended ":U SKIP
     2455               "to be run Persistent or to be placed ":U SKIP
     2456               "in another SmartObject at UIB design time.":U
     2457               VIEW-AS ALERT-BOX ERROR.
     2458       RUN disable_UI.
     2459       DELETE PROCEDURE THIS-PROCEDURE.
     2460       RETURN.
     2461   END.
     2462   RUN dispatch ('create-objects':U).
     2463   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     2464   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     2465   MAIN-BLOCK:
     2466   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2467      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2468     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     2469     WAIT-FOR GO OF FRAME D-Dialog.
     2470   END.
     2471   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     2472   PROCEDURE adm-create-objects :
     2473     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     2474     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     2475     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     2476     CASE adm-current-page:
     2477       WHEN 0 THEN DO:
     2478          RUN init-object IN THIS-PROCEDURE (
     2479                INPUT  'adm/objects/folder.w':U ,
     2480                INPUT  FRAME D-Dialog:HANDLE ,
     2481                INPUT  'FOLDER-LABELS = ':U + 'Осн. архивы|Документы|Тек. сост.' + ',
     2482                        FOLDER-TAB-TYPE = 1':U ,
     2483                OUTPUT h_folder ).
     2484          RUN set-position IN h_folder ( 4.29 , 1.00 ) NO-ERROR.
     2485          RUN set-size IN h_folder ( 19.33 , 98.88 ) NO-ERROR.
     2486          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
     2487       END.
     2488       WHEN 1 THEN DO:
     2489          RUN init-object IN THIS-PROCEDURE (
     2490                INPUT  'arc/main-arc.w':U ,
     2491                INPUT  FRAME D-Dialog:HANDLE ,
     2492                INPUT  'Layout = ':U ,
     2493                OUTPUT h_main-arc ).
     2494          RUN set-position IN h_main-arc ( 5.25 , 1.00 ) NO-ERROR.
     2495          RUN set-size IN h_main-arc ( 18.21 , 98.25 ) NO-ERROR.
     2496          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'date-price':U , h_main-arc ).
     2497          RUN add-link IN adm-broker-hdl ( h_main-arc , 'doctype':U , THIS-PROCEDURE ).
     2498       END.
     2499       WHEN 2 THEN DO:
     2500          RUN init-object IN THIS-PROCEDURE (
     2501                INPUT  'arc/b-otlina.w':U ,
     2502                INPUT  FRAME D-Dialog:HANDLE ,
     2503                INPUT  'Layout = ':U ,
     2504                OUTPUT h_b-otlina ).
     2505          RUN set-position IN h_b-otlina ( 5.50 , 1.00 ) NO-ERROR.
     2506          RUN set-size IN h_b-otlina ( 17.92 , 98.88 ) NO-ERROR.
     2507          RUN init-pages IN THIS-PROCEDURE ('1':U) NO-ERROR.
     2508          RUN add-link IN adm-broker-hdl ( h_folder , 'State':U , h_b-otlina ).
     2509          RUN add-link IN adm-broker-hdl ( h_main-arc , 'detail':U , h_b-otlina ).
     2510          RUN add-link IN adm-broker-hdl ( h_main-arc , 'State':U , h_b-otlina ).
     2511          RUN add-link IN adm-broker-hdl ( THIS-PROCEDURE , 'date-price':U , h_b-otlina ).
     2512          RUN add-link IN adm-broker-hdl ( h_b-otlina , 'doctype':U , THIS-PROCEDURE ).
     2513       END.
     2514       WHEN 3 THEN DO:
     2515          RUN init-object IN THIS-PROCEDURE (
     2516                INPUT  'arc/v-gdsobj.w':U ,
     2517                INPUT  FRAME D-Dialog:HANDLE ,
     2518                INPUT  'Layout = ':U ,
     2519                OUTPUT h_v-gdsobj ).
     2520          RUN set-position IN h_v-gdsobj ( 7.88 , 9.63 ) NO-ERROR.
     2521       END.
     2522     END CASE.
     2523     IF adm-current-page eq 0
     2524     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
     2525   END PROCEDURE.
     2526   PROCEDURE adm-row-available :
     2527     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2528     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2529     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2530     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2531     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2532     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2533     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2534     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2535     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2536     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2537     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2538     IF adm-updating-record THEN RETURN.
     2539     RUN get-attribute ('FIELDS-ENABLED':U).
     2540     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2541     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2542         OUTPUT link-handle) NO-ERROR.
     2543     IF link-handle = "":U THEN
     2544         RETURN.
     2545     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2546     IF NUM-ENTRIES(link-handle) > 1 THEN
     2547         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2548             "encountered more than one RECORD-SOURCE.":U SKIP
     2549             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2550                VIEW-AS ALERT-BOX ERROR.
     2551     RUN get-attribute ('Key-Name':U).
     2552     key-name = RETURN-VALUE.
     2553     IF key-name = "":U THEN key-name = ?.
     2554     IF key-name NE ? THEN DO:
     2555       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2556         NO-ERROR.
     2557       IF key-value NE ? THEN
     2558         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2559     END.
     2560   IF VALID-HANDLE (adm-object-hdl) THEN
     2561       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2562   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2563   END PROCEDURE.
     2564   PROCEDURE check-date :
     2565     define input parameter parcheck-shift      as logical no-undo.
     2566     define input parameter parcheck-shift-date as logical no-undo.
     2567     define variable varmemdate-start as date      no-undo .
     2568     define variable varmemdate-end   as date      no-undo .
     2569     define variable varresult        as logical   no-undo .
     2570     define variable varmoreone       as logical   no-undo .
     2571     define variable v-comment        as character no-undo .
     2572     define variable v-can-print      as logical   no-undo .
     2573     do
     2574     on error undo, return error return-value
     2575     :
     2576       find tt-clients no-error.
     2577       if ambiguous tt-clients
     2578       then do:
     2579         assign varmoreone = yes.
     2580       end.
     2581       else do:
     2582         assign varmoreone = no.
     2583       end.
     2584       assign
     2585         varmemdate-start = input frame D-Dialog vardate-start
     2586         varmemdate-end   = input frame D-Dialog vardate-end
     2587       .
     2588       if input frame D-Dialog vardate-start = ?
     2589       then do:
     2590         message
     2591           "Не указана дата 'C'" skip
     2592           view-as alert-box information .
     2593         apply 'entry':u to vardate-start in frame D-Dialog .
     2594         return error.
     2595       end.
     2596       if input frame D-Dialog vardate-end = ?
     2597       then do:
     2598         message
     2599           "Не указана дата 'По'" skip
     2600           view-as alert-box information.
     2601         apply 'entry':u to vardate-end in frame D-Dialog .
     2602         return error.
     2603       end.
     2604       if input frame D-Dialog vardate-start > input frame D-Dialog vardate-end
     2605       then do:
     2606         message
     2607           "Дата 'По' не может быть меньше даты 'C'" skip
     2608           view-as alert-box information .
     2609         apply 'entry':u to vardate-start in frame D-Dialog .
     2610         return error.
     2611       end.
     2612       if  parcheck-shift
     2613       and parcheck-shift-date
     2614       then do:
     2615         if input frame D-Dialog varshift-start < 1
     2616         then do:
     2617           message
     2618             "Не указан номер смены 'C'"
     2619             view-as alert-box information .
     2620           apply 'entry':u to varshift-start in frame D-Dialog .
     2621           return error.
     2622         end.
     2623         if input frame D-Dialog varshift-end < 1
     2624         then do:
     2625           message
     2626             "Не указан номер смены 'По'"
     2627             view-as alert-box information .
     2628           apply 'entry':u to varshift-end in frame D-Dialog .
     2629           return error.
     2630         end.
     2631         if  input frame D-Dialog vardate-start = input frame D-Dialog vardate-end
     2632         and input frame D-Dialog varshift-start > input frame D-Dialog varshift-end
     2633         then do:
     2634           message
     2635             "Смена 'C' не может быть больше смены 'По'"
     2636             view-as alert-box information.
     2637           apply 'entry':u to varshift-start in frame D-Dialog .
     2638           return error.
     2639         end.
     2640       end.
     2641       for each tt-clients
     2642       :
     2643         run rep/chk-ahz.p
     2644           (input        tt-clients.obj-type
     2645           ,input        tt-clients.obj-code
     2646           ,input        false
     2647           ,input        yes
     2648           ,input        no
     2649           ,input        no
     2650           ,input        yes
     2651           ,input        v-cntxt-db-num
     2652           ,input        v-cntxt-userid
     2653           ,input-output varmemdate-start
     2654           ,input-output varmemdate-end
     2655           ,output       varresult
     2656           ,output       v-comment
     2657           ,output       v-can-print
     2658           ) no-error.
     2659         if error-status :error
     2660         then do:
     2661           message
     2662             vss-workfile vss-revision vss-description skip
     2663             "Ошибка при вызове программы chk-ahz.p" skip
     2664             error-status :get-message(1) skip
     2665             return-value skip
     2666             view-as alert-box error .
     2667           return error .
     2668         end.
     2669         if not varresult
     2670         then do:
     2671           if varmoreone
     2672           then do:
     2673             message
     2674               "Объект" tt-clients.obj-type tt-clients.obj-code skip
     2675               "Просмотр архива невозможен" skip
     2676               v-comment skip
     2677               view-as alert-box information .
     2678             apply 'entry':u to vardate-start in frame D-Dialog .
     2679             return error.
     2680           end.
     2681           else do:
     2682             if v-can-print = true
     2683             then do:
     2684               define variable v-ok as logical   no-undo .
     2685               message
     2686                 "Внимание!" skip
     2687                 v-comment skip
     2688                 "Продолжить просмотр архивов?" skip
     2689                 view-as alert-box information buttons yes-no update v-ok .
     2690               if v-ok <> true
     2691               then do:
     2692                 apply 'entry':u to vardate-start in frame D-Dialog .
     2693                 return error .
     2694               end.
     2695             end.
     2696             else do:
     2697               message
     2698                 "Объект" tt-clients.obj-type tt-clients.obj-code skip
     2699                 "Просмотр архива невозможен" skip
     2700                 v-comment skip
     2701                 view-as alert-box information .
     2702               apply 'entry':u to vardate-start in frame D-Dialog .
     2703               return error .
     2704             end.
     2705           end.
     2706         end.
     2707       end.
     2708       assign frame D-Dialog
     2709         varis-calend
     2710         varis-shift-num
     2711         vardate-start
     2712         vardate-end
     2713         varshift-start
     2714         varshift-end
     2715       .
     2716     end.
     2717   END PROCEDURE.
     2718   PROCEDURE disable_UI :
     2719     HIDE FRAME D-Dialog.
     2720   END PROCEDURE.
     2721   PROCEDURE display-goods-list :
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725       assign
     2726         vared-goods = ""
     2727       .
     2728       for each tt-goods
     2729       by tt-goods.artic
     2730       :
     2731         assign
     2732           vared-goods = vared-goods
     2733                       + (if vared-goods <> '' then ', ':u else '')
     2734                       + tt-goods.artic
     2735         .
     2736         if length(vared-goods) > 10000
     2737         then do:
     2738           assign
     2739             vared-goods = vared-goods + " ..."
     2740           .
     2741           leave .
     2742         end.
     2743       end.
     2744       assign
     2745         vared-goods = "Товары: " + vared-goods
     2746       .
     2747       display
     2748         vared-goods
     2749         with frame D-Dialog .
     2750     end.
     2751   END PROCEDURE.
     2752   PROCEDURE display-object-list :
     2753     do
     2754     on error undo, return error return-value
     2755     :
     2756       assign
     2757         vared-obj   = ""
     2758       .
     2759       for each tt-clients
     2760       by tt-clients.obj-type
     2761       by tt-clients.obj-code
     2762       :
     2763         assign
     2764           vared-obj = vared-obj
     2765                     + (if vared-obj <> "" then ', ':u else '':u)
     2766                     + tt-clients.obj-type + " " + string(tt-clients.obj-code)
     2767         .
     2768         if length(vared-obj) > 10000
     2769         then do:
     2770           assign
     2771             vared-obj = vared-obj + " ..."
     2772           .
     2773           leave .
     2774         end.
     2775       end.
     2776       assign
     2777         vared-obj   = "Объекты: " + vared-obj
     2778       .
     2779       display
     2780         vared-obj
     2781         with frame D-Dialog .
     2782     end.
     2783   END PROCEDURE.
     2784   PROCEDURE enable_UI :
     2785     DISPLAY vared-goods varis-calend vardate-start vardate-end vared-obj r-rb
     2786             fi-description-1
     2787         WITH FRAME D-Dialog.
     2788     ENABLE b-exit b-arh b-print b-start-date b-goods b-object b-help vared-goods
     2789            vardate-start vardate-end vared-obj r-rb fi-description-1
     2790         WITH FRAME D-Dialog.
     2791     VIEW FRAME D-Dialog.
     2792   END PROCEDURE.
     2793   PROCEDURE first-date-oper :
     2794     define output parameter parfirst-date as date initial ? no-undo.
     2795     define variable v-attr-value      as character no-undo .
     2796     define variable v-attr-type       as character no-undo .
     2797     define variable v-arh-detail-date as date      no-undo .
     2798     define variable v-arh-start-date  as date      no-undo .
     2799     define variable v-start-date      as date      no-undo .
     2800     define buffer buf_stk-tot for ub.stk-tot .
     2801     for each tt-clients
     2802     :
     2803       run clntattr-value in this-procedure
     2804         (input  tt-clients.obj-type
     2805         ,input  tt-clients.obj-code
     2806         ,input  'arh-detail':U
     2807         ,output v-attr-value
     2808         ,output v-attr-type
     2809         ) .
     2810       assign
     2811         v-arh-detail-date = date(v-attr-value)
     2812       .
     2813       run clntattr-value in this-procedure
     2814         (input  tt-clients.obj-type
     2815         ,input  tt-clients.obj-code
     2816         ,input  'arh-start':U
     2817         ,output v-attr-value
     2818         ,output v-attr-type
     2819         ) .
     2820       assign
     2821         v-arh-start-date = date(v-attr-value)
     2822       .
     2823       assign
     2824         v-start-date = ?
     2825       .
     2826       if v-arh-start-date <> ?
     2827       then do:
     2828         assign
     2829           v-start-date = v-arh-start-date
     2830         .
     2831       end.
     2832       else do:
     2833         find first buf_stk-tot no-lock
     2834           where buf_stk-tot.obj-type  = tt-clients.obj-type
     2835             and buf_stk-tot.obj-code  = tt-clients.obj-code
     2836           no-error .
     2837         if available buf_stk-tot
     2838         then do:
     2839           assign
     2840             v-start-date = buf_stk-tot.fact-date
     2841           .
     2842         end.
     2843       end.
     2844       if v-start-date <> ?
     2845       and (parfirst-date = ?
     2846            or v-start-date < parfirst-date
     2847           )
     2848       then do:
     2849         assign
     2850           parfirst-date = v-start-date
     2851         .
     2852       end.
     2853     end.
     2854   END PROCEDURE.
     2855   PROCEDURE need-read-arh :
     2856     do
     2857     on error undo, return error return-value
     2858     :
     2859       assign
     2860         fi-description-1 = "Нажмите кнопку Просмотр"
     2861       .
     2862       display
     2863         fi-description-1
     2864         with frame D-Dialog .
     2865     end.
     2866   END PROCEDURE.
     2867   PROCEDURE pre-display :
     2868     run display-goods-list in this-procedure .
     2869     run display-object-list in this-procedure .
     2870   END PROCEDURE.
     2871   PROCEDURE read-arh :
     2872     if input frame D-Dialog varis-calend = 2
     2873     then do:
     2874       if  input frame D-Dialog varis-shift-num  <> ""
     2875       and input frame D-Dialog varis-shift-num  <> "no"
     2876       then do:
     2877         run check-date in this-procedure
     2878           (input  yes
     2879           ,input  yes
     2880           ) no-error.
     2881         if error-status :error
     2882         then do:
     2883           return error.
     2884         end.
     2885       end.
     2886       else do:
     2887         run check-date in this-procedure
     2888           (input  yes
     2889           ,input  no
     2890           ) no-error.
     2891         if error-status :error
     2892         then do:
     2893           return error.
     2894         end.
     2895       end.
     2896     end.
     2897     else do:
     2898       run check-date in this-procedure
     2899         (input  no
     2900         ,input  no
     2901         ) no-error.
     2902       if error-status :error
     2903       then do:
     2904         return error.
     2905       end.
     2906     end.
     2907     assign
     2908       frame D-Dialog r-rb
     2909       .
     2910     if varext-doc-type = ""
     2911     or varext-doc-type = ?
     2912     then do:
     2913       assign
     2914         varext-doc-type = "all"
     2915       .
     2916     end.
     2917     run set-attribute-list ('main-handle=' + string(this-procedure)).
     2918     run set-attribute-list ('varis-calend=' + string(varis-calend)).
     2919     run set-attribute-list ('varis-shift-num=' + string(varis-shift-num)).
     2920     run set-attribute-list ('vardate-start=' + string(vardate-start)).
     2921     run set-attribute-list ('vardate-end=' + string(vardate-end)).
     2922     run set-attribute-list ('varshift-start=' + string(varshift-start)).
     2923     run set-attribute-list ('varshift-end=' + string(varshift-end)).
     2924     run set-attribute-list ('varext-doc-type=' + string(varext-doc-type)).
     2925     run set-attribute-list ('rubl-base=' + string(r-rb)).
     2926     run notify ('show_arh,date-price-target':u).
     2927     assign
     2928       fi-description-1 = substitute("&1 &2 С &3 &4 По &5 &6"
     2929                                    ,(if r-rb = 1 then "Руб" else "Вал")
     2930                                    ,(if varis-shift-num then "по сменам" else "" )
     2931                                    ,string(vardate-start, '99/99/9999':u)
     2932                                    ,(if varis-shift-num then string(varshift-start) else "" )
     2933                                    ,string(vardate-end, '99/99/9999':u)
     2934                                    ,(if varis-shift-num then string(varshift-end) else "" )
     2935                                    )
     2936     .
     2937     display
     2938       fi-description-1
     2939       with frame D-Dialog .
     2940   END PROCEDURE.
     2941   PROCEDURE read_doc-type :
     2942     RUN get-attribute IN h_main-arc (INPUT 'varext-doc-type':U).
     2943     if return-value = "" or return-value = ? then do:                        message "Нет атрибута для получения данных." view-as alert-box error.                       return error.                    end.
     2944     assign varext-doc-type = return-value.
     2945     run read-arh in this-procedure .
     2946     RUN select-page (INPUT 2).
     2947   END PROCEDURE.
     2948   PROCEDURE read_doc-type-all :
     2949     assign
     2950       varext-doc-type = "all"
     2951     .
     2952     run read-arh in this-procedure .
     2953   END PROCEDURE.
     2954   PROCEDURE select-goods-list :
     2955     define buffer buf_tt-goods for tt-goods .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       for each gds-list
     2960       :
     2961         delete gds-list .
     2962       end.
     2963       for each buf_tt-goods
     2964       :
     2965         find first ub.goods no-lock
     2966           where ub.goods.artic     = buf_tt-goods.artic
     2967             and ub.goods.prod-type = buf_tt-goods.prod-type
     2968             and ub.goods.prod-code = buf_tt-goods.prod-code
     2969           .
     2970   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2971   find gds-list
     2972     where gds-list.prod-type = goods.prod-type
     2973       and gds-list.prod-code = goods.prod-code
     2974       and gds-list.artic     = goods.artic
     2975     no-error .
     2976   if available gds-list then do:
     2977     assign
     2978       gds-list.to-del = no
     2979     .
     2980   end.
     2981   else do:
     2982     define variable v-last21 as integer no-undo .
     2983     find last gds-list use-index oi no-error.
     2984     if available gds-list then do:
     2985       v-last21 = gds-list.order-num .
     2986     end.
     2987     else do:
     2988       v-last21 = 0 .
     2989     end.
     2990     create gds-list .
     2991     buffer-copy goods to gds-list
     2992     assign
     2993       gds-list.to-del = no
     2994       gds-list.order-num = v-last21 + 1
     2995     .
     2996     assign
     2997       lns-cnt = lns-cnt + 1
     2998       line-rec = recid (gds-list)
     2999     .
     3000   end.
     3001       end.
     3002       run str/gds-list.w (
     3003                        input parparentproc
     3004                       ,input v-host-code
     3005                       ,input p-curr-obj-type
     3006                       ,input p-curr-obj-code)  .
     3007       find first gds-list
     3008         no-error .
     3009       if available gds-list
     3010       then do:
     3011         for each buf_tt-goods
     3012         :
     3013           delete buf_tt-goods .
     3014         end.
     3015         for each gds-list
     3016         :
     3017           find first goods no-lock
     3018             where goods.artic     = gds-list.artic
     3019               and goods.prod-type = gds-list.prod-type
     3020               and goods.prod-code = gds-list.prod-code
     3021             .
     3022           create buf_tt-goods .
     3023           buffer-copy goods to buf_tt-goods .
     3024         end.
     3025         run display-goods-list in this-procedure .
     3026       end.
     3027       else do:
     3028         message
     3029           "Товар не выбран" skip
     3030           view-as alert-box information .
     3031       end.
     3032     end.
     3033   END PROCEDURE.
     3034   PROCEDURE select-object-list :
     3035     do
     3036     on error undo, return error return-value
     3037     :
     3038   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039   run userobjs_clear in this-procedure  .
     3040       for each tt-clients
     3041       :
     3042   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3043   run userobjs_append in this-procedure
     3044     (input  tt-clients.obj-type
     3045     ,input  tt-clients.obj-code
     3046     )  .
     3047       end.
     3048       define variable v-user-select as logical   no-undo .
     3049   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3050   run userobjs_select-many in this-procedure
     3051     (input  parparentproc
     3052     ,input  v-cntxt-db-num
     3053     ,input  v-cntxt-userid
     3054     ,input  v-cntxt-host-code-obj
     3055     ,input  v-cntxt-obj-type
     3056     ,input  v-cntxt-obj-code
     3057     ,output v-user-select
     3058     )  .
     3059       if v-user-select = true
     3060       then do:
     3061         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     3062         for each tt-clients
     3063         :
     3064           delete tt-clients .
     3065         end.
     3066         for each buf_userobjs_temp-user-obj
     3067         on error undo, return error return-value
     3068         :
     3069           create tt-clients .
     3070           assign
     3071             tt-clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     3072             tt-clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     3073           .
     3074         end.
     3075         run display-object-list in this-procedure .
     3076         run need-read-arh in this-procedure .
     3077       end.
     3078     end.
     3079   END PROCEDURE.
     3080   PROCEDURE send-records :
     3081   END PROCEDURE.
     3082   PROCEDURE state-changed :
     3083     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     3084     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3085   END PROCEDURE.
     3086   PROCEDURE val-chg-is-shift-num :
     3087     assign frame D-Dialog varis-shift-num.
     3088     if varis-shift-num
     3089     then do:
     3090       view varshift-start varshift-end in frame D-Dialog.
     3091       display varshift-start varshift-end with frame D-Dialog.
     3092       enable varshift-start varshift-end with frame D-Dialog.
     3093     end.
     3094     else do:
     3095       hide varshift-start varshift-end in frame D-Dialog.
     3096     end.
     3097   END PROCEDURE.
