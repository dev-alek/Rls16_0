      917   procedure create_obj-list :
      918      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      919      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      920      do
      921      on error undo, return error return-value
      922      :
      923         define buffer cli-obj for ub.clients .
      924         define variable p-var as integer no-undo .
      925         define buffer buf_obj-list for obj-list .
      926         find last buf_obj-list  use-index pi no-error .
      927         if available buf_obj-list
      928         then
      929            p-var = buf_obj-list.obj-id + 1.
      930         else
      931            p-var = 1.
      932         find first cli-obj where
      933                   cli-obj.obj-type = p-obj-type
      934               and cli-obj.obj-code = p-obj-code
      935         no-lock no-error.
      936         if available cli-obj
      937         then do:
      938            create buf_obj-list.
      939            assign
      940               buf_obj-list.obj-id   = p-var
      941               buf_obj-list.obj-code = cli-obj.obj-code
      942               buf_obj-list.obj-type = cli-obj.obj-type
      943               buf_obj-list.obj-name = cli-obj.obj-name
      944               buf_obj-list.db-num   = cli-obj.db-num
      945            .
      946         end.
      947      end.
      948   end.
