      644   procedure userobjs_clear :
      645     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      646     do
      647     on error undo, return error return-value
      648     :
      649       for each buf_userobjs_temp-user-obj
      650       on error undo, return error return-value
      651       :
      652         delete buf_userobjs_temp-user-obj .
      653       end.
      654     end.
      655   end .
      656   procedure userobjs_object-count :
      657     define output parameter p-total-count as integer   no-undo .
      658     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      659     do
      660     on error undo, return error return-value
      661     :
      662       assign
      663         p-total-count = 0
      664       .
      665       for each buf_userobjs_temp-user-obj
      666       on error undo, return error return-value
      667       :
      668         assign
      669           p-total-count = p-total-count + 1
      670         .
      671       end.
      672     end.
      673   end.
      674   procedure userobjs_append :
      675      define input  parameter p-obj-type as character no-undo .
      676      define input  parameter p-obj-code as integer   no-undo .
      677     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      678     do
      679     on error undo, return error return-value
      680     :
      681       find first buf_userobjs_temp-user-obj
      682         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      683           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      684         no-error .
      685       if not available buf_userobjs_temp-user-obj
      686       then do:
      687         create buf_userobjs_temp-user-obj .
      688         assign
      689           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      690           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      691         .
      692       end.
      693     end.
      694   end.
      695   procedure userobjs_object-exist :
      696     define output parameter p-object-exist as logical   no-undo .
      697     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      698     do
      699     on error undo, return error return-value
      700     :
      701       find first buf_userobjs_temp-user-obj
      702         no-error .
      703       if not available buf_userobjs_temp-user-obj
      704       then do:
      705         assign
      706           p-object-exist = false
      707         .
      708       end.
      709       else do:
      710         assign
      711           p-object-exist = true
      712         .
      713       end.
      714     end.
      715   end.
      716   procedure userobjs_transfer :
      717     define input  parameter p-callback-handle as handle no-undo .
      718     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      719     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      720     do
      721     on error undo, return error return-value
      722     :
      723       if valid-handle(p-callback-handle) <> true
      724       then do:
      725         message
      726           vss-workfile vss-revision vss-description skip
      727           "Ошибка задания входных параметров" skip
      728           "Неизвестный указатель на процедуру" skip
      729           view-as alert-box error .
      730         undo, return error return-value .
      731       end.
      732       if p-callback-handle :get-signature("userobjs_append") = ""
      733       then do:
      734         message
      735           vss-workfile vss-revision vss-description skip
      736           "Ошибка задания входных параметров" skip
      737           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      738                     ,p-callback-handle :file-name
      739                     ) skip
      740           view-as alert-box error .
      741         undo, return error return-value .
      742       end.
      743       for each buf_userobjs_temp-user-obj
      744       on error undo, return error return-value
      745       :
      746         run userobjs_append in p-callback-handle
      747           (input  buf_userobjs_temp-user-obj.obj-type
      748           ,input  buf_userobjs_temp-user-obj.obj-code
      749           ) .
      750       end.
      751     end.
      752   end procedure.
      753   procedure userobjs_select-one :
      754      define input  parameter parparentproc     as widget-handle no-undo .
      755      define input  parameter p-db-num          as integer   no-undo .
      756      define input  parameter p-user-id         as character no-undo .
      757      define input  parameter p-host-code-obj   as integer   no-undo .
      758      define input  parameter p-obj-type        as character no-undo .
      759      define input  parameter p-obj-code        as integer   no-undo .
      760      define output parameter p-user-select     as logical   no-undo .
      761      define output parameter p-select-obj-type as character no-undo .
      762      define output parameter p-select-obj-code as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       run gbl/userobjs.w
      767         (input  parparentproc
      768         ,input  this-procedure :handle
      769         ,input  p-db-num
      770         ,input  p-user-id
      771         ,input  p-host-code-obj
      772         ,input  p-obj-type
      773         ,input  p-obj-code
      774         ,INPUT  "b-sel"
      775         ,output p-user-select
      776         ,output p-select-obj-type
      777         ,output p-select-obj-code
      778         ) .
      779     end.
      780   end.
