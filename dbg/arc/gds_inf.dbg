     1665     run select-object-list in this-procedure .
     1666   END.
     1667   ON CHOOSE OF b-print IN FRAME D-Dialog
     1668   DO:
     1669     define variable varbase-type like ub.currency.curr-abbr no-undo.
     1670     define variable varbase-code like ub.currency.curr-code no-undo.
     1671   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1673     (input  v-host-code
     1674     ,output varbase-code
     1675     )  .
     1676     find first ub.currency no-lock
     1677       where ub.currency.curr-code = varbase-code
     1678       .
     1679     assign
     1680       varbase-type = ub.currency.curr-abbr
     1681       varbase-code = ub.currency.curr-code
     1682     .
     1683     run read-arh in this-procedure  no-error.
     1684     if error-status :error then do:
     1685       return no-apply.
     1686     end.
     1687     for each gds-list
     1688     :
     1689       delete gds-list.
     1690     end.
     1691     for each obj-list
     1692     :
     1693       delete obj-list.
     1694     end.
     1695     for each tt-goods
     1696     :
     1697       create gds-list.
     1698       buffer-copy tt-goods to gds-list .
     1699     end.
     1700     for each tt-clients
     1701     :
     1702   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1703   run create_obj-list in this-procedure
     1704    ( input tt-clients.obj-type ,
     1705      input tt-clients.obj-code )
     1706     no-error .
     1707     end.
     1708     assign
     1709       x-date-end     = vardate-end
     1710       x-date-start   = vardate-start
     1711       x-tog-shift    = (if varis-calend = 2
     1712                         then yes
     1713                         else no
     1714                        )
     1715       x-shift-end    = (if varis-calend = 2
     1716                         then (if varis-shift-num
     1717                               then varshift-end
     1718                               else ?
     1719                              )
     1720                         else ?
     1721                        )
     1722       x-shift-start  = (if varis-calend = 2
     1723                         then (if varis-shift-num
     1724                               then varshift-start
     1725                               else ?
     1726                              )
     1727                         else ?
     1728                        )
     1729       x-set_val_type = r-rb
     1730     .
     1731     run rep/r-o-good.p
     1732       (input  p-curr-obj-code
     1733       ,input  p-curr-obj-type
     1734       ,input  varbase-type
     1735       ,input  varbase-code
     1736       ,input  'все':U
     1737       ,input  no
     1738       ,input  "no-classify":u
     1739       ,input  ""
     1740       ,input  "goods,no":u
     1741       ).
     1742   END.
     1743   ON CHOOSE OF b-start-date IN FRAME D-Dialog
     1744   DO:
     1745     define variable v-first-date-oper as date no-undo .
     1746     run first-date-oper in this-procedure
     1747       (output v-first-date-oper
     1748       ).
     1749     define variable v-ok as logical   no-undo .
     1750     message
     1751       "По выбранным объектам имеются архивы с даты" string(v-first-date-oper, '99/99/9999':u) skip
     1752       "Подставить эту дату в экранную форму?"
     1753       view-as alert-box question buttons yes-no update v-ok .
     1754     if v-ok = true
     1755     then do:
     1756       assign
     1757         vardate-start = v-first-date-oper
     1758       .
     1759       display
     1760         vardate-start with frame D-Dialog
     1761       .
     1762     end.
     1763   END.
     1764   ON VALUE-CHANGED OF r-rb IN FRAME D-Dialog
     1765   DO:
     1766     assign
     1767       frame D-Dialog r-rb
     1768     .
     1769     run need-read-arh in this-procedure .
     1770   END.
     1771   ON LEAVE OF vardate-end IN FRAME D-Dialog
     1772   DO:
     1773     if vardate-end <> input frame D-Dialog vardate-end
     1774     then do:
     1775       assign
     1776         frame D-Dialog vardate-end
     1777       .
     1778       run need-read-arh in this-procedure .
     1779     end.
     1780   END.
     1781   ON LEAVE OF vardate-start IN FRAME D-Dialog
     1782   DO:
     1783     if vardate-start <> input frame D-Dialog vardate-start
     1784     then do:
     1785       assign
     1786         frame D-Dialog vardate-start
     1787       .
     1788       run need-read-arh in this-procedure .
     1789     end.
     1790   END.
     1791   ON VALUE-CHANGED OF varis-calend IN FRAME D-Dialog
     1792   DO:
     1793     assign
     1794       frame D-Dialog varis-calend
     1795       .
     1796     if varis-calend = 1
     1797     then do:
     1798       assign
     1799         varis-shift-num = false
     1800       .
     1801       display
     1802         varis-shift-num with frame D-Dialog.
     1803       hide varis-shift-num varshift-start varshift-end in frame D-Dialog.
     1804     end.
     1805     else do:
     1806       view varis-shift-num in frame D-Dialog.
     1807       display varis-shift-num with frame D-Dialog.
     1808       enable varis-shift-num with frame D-Dialog.
     1809       run val-chg-is-shift-num in this-procedure .
     1810     end.
     1811     run need-read-arh in this-procedure .
     1812   END.
     1813   ON VALUE-CHANGED OF varis-shift-num IN FRAME D-Dialog
     1814   DO:
     1815     if varis-shift-num <> input frame D-Dialog varis-shift-num
     1816     then do:
     1817       assign
     1818         frame D-Dialog varis-shift-num
     1819       .
     1820       if varis-shift-num = yes
     1821       then do:
     1822         assign
     1823           varshift-start = 1
     1824           varshift-end   = 1
     1825         .
     1826       end.
     1827       run val-chg-is-shift-num in this-procedure
     1828         no-error .
     1829       if error-status :error then do:
     1830         return no-apply.
     1831       end.
     1832       run need-read-arh in this-procedure .
     1833     end.
     1834   END.
     1835   ON LEAVE OF varshift-end IN FRAME D-Dialog
     1836   DO:
     1837     if varshift-end <> input frame D-Dialog varshift-end
     1838     then do:
     1839       assign
     1840         frame D-Dialog varshift-end
     1841       .
     1842       run need-read-arh in this-procedure .
     1843     end.
     1844   END.
     1845   ON LEAVE OF varshift-start IN FRAME D-Dialog
     1846   DO:
     1847     if varshift-start <> input frame D-Dialog varshift-start
     1848     then do:
     1849       assign
     1850         frame D-Dialog varshift-start
     1851       .
     1852       run need-read-arh in this-procedure .
     1853     end.
     1854   END.
     1855   assign
     1856     r-rb :radio-buttons = "&Руб" + chr(44) + '1'
     1857                         + chr(44) + "&Вал" + chr(44) + '2'
     1858   .
     1859   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1861     (input  p-curr-obj-type
     1862     ,input  p-curr-obj-code
     1863     ,output v-host-code
     1864     )  .
     1865   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1866     run mainmenu_getcntxt in parparentproc
     1867       (output v-cntxt-db-num
