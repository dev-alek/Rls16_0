     1209   procedure gds-list-order-num :
     1210     do
     1211     on error undo, return error
     1212     :
     1213   if NOT can-find(first gds-list) then
     1214       RETURN.
     1215   for each gds-list
     1216   by gds-list.order-num
     1217   :
     1218     find ub.goods no-lock
     1219       where ub.goods.prod-type = gds-list.prod-type
     1220         and ub.goods.prod-code = gds-list.prod-code
     1221         and ub.goods.artic = gds-list.artic
     1222     .
     1223     find ub.gds-prt no-lock
     1224       where ub.gds-prt.upper-code = goods.prt-root
     1225     .
     1226     assign
     1227       rootnode_code = ub.gds-prt.node-code
     1228       list-qnty = gds-list.qnty
     1229       v-part-code   = "":U
     1230       v-promo-code  = gds-list.promo-code
     1231       v-ActionId    = gds-list.ActionId
     1232       v-db-num      = gds-list.db-num
     1233     .
     1234     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
     1235       assign
     1236         prn-prt = TRUE
     1237       .
     1238     end.
     1239     else do:
     1240       assign
     1241         prn-prt = FALSE
     1242       .
     1243     end.
