      704                 ,input v-ActionId
      705                 ,input v-db-num
      706                 ) no-error .
      707         end.
      708       end.
      709       when "subs" then do:
      710         for each ub.bar-code no-lock
      711            where ub.bar-code.gds-code = ub.goods.gds-code
      712              and ub.bar-code.unit-cli = unitname
      713              and ub.bar-code.part-code = ""
      714              and ub.bar-code.in-code = ""
      715         on error undo, return error :
      716           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
