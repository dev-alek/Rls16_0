      266           view-as alert-box error title "подрезание кода".
      267         return error.
      268       end.
      269       else do:
      270         assign
      271           full-b-code = pl-pfx + substring( tmp-str5, length( pl-pfx ) + 1, length( tmp-str5 ) - length( pl-pfx ) )
      272           len-code5    = length( full-b-code )
      273         .
      274         define variable v-sum-char5 as character no-undo .
      275         assign
      276           sum5 = 0
      277         .
      278         do i5 = 1 to len-code5 by 2
      279         :
      280           assign
      281             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      282           .
      283           if v-sum-char5 < "0"
