      483     find first  buf_dis-thbj-rule9 No-LOCK  where
      484                 buf_dis-thbj-rule9.obj-type = p-obj-type
      485           AND  buf_dis-thbj-rule9.obj-code = p-obj-code
      486           and  buf_dis-thbj-rule9.pos-type = dflt-cd
      487           and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      488           and  buf_dis-thbj-rule9.nonunique = ''
      489           no-error .
      490     if not available buf_dis-thbj-rule9 then do:
      491   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      493     (input  p-obj-type
      494     ,input  p-obj-code
      495     ,output v-host-code9
      496     )  .
      497       find first  buf_dis-thbj-rule9 No-LOCK  where
      498                   buf_dis-thbj-rule9.obj-code = v-host-code9
      499             AND  buf_dis-thbj-rule9.obj-type = 'орг':U
      500             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      501             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      502             and  buf_dis-thbj-rule9.nonunique = ''
      503             no-error .
      504     end.
      505     if not available buf_dis-thbj-rule9 then do:
      506       find first  buf_dis-thbj-rule9 No-LOCK  where
      507                   buf_dis-thbj-rule9.obj-code = 0
      508             AND  buf_dis-thbj-rule9.obj-type = ''
      509             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      510             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      511             and  buf_dis-thbj-rule9.nonunique = ''
      512             no-error .
      513     end.
      514     if available buf_dis-thbj-rule9 then do:
      515       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule9.rule-num).
      516     end.
      517     else do:
      518       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      519     end.
      520   end.
      521   CASE List-sort:
      522     when "artic":U then do:
      523       run gds-list-artic in this-procedure .
      524     end.
      525     when "b-code":U then do:
      526       run gds-list-b-code in this-procedure .
      527     end.
      528       when "gds-name":U then do:
      529       run gds-list-gds-name in this-procedure .
      530     end.
      531     when "order-num":U then do:
      532       run gds-list-order-num in this-procedure .
      533     end.
      534   END CASE.
      535   procedure gds-list-artic :
      536     do
      537     on error undo, return error
      538     :
      539   if NOT can-find(first gds-list) then
      540       RETURN.
      541   for each gds-list
      542   by gds-list.artic
      543   by gds-list.prod-type
      544   by gds-list.prod-code
      545   :
      546     find ub.goods no-lock
      547       where ub.goods.prod-type = gds-list.prod-type
      548         and ub.goods.prod-code = gds-list.prod-code
      549         and ub.goods.artic = gds-list.artic
      550     .
      551     find ub.gds-prt no-lock
      552       where ub.gds-prt.upper-code = goods.prt-root
      553     .
      554     assign
      555       rootnode_code = ub.gds-prt.node-code
      556       list-qnty = gds-list.qnty
      557       v-part-code   = "":U
      558       v-promo-code  = gds-list.promo-code
      559       v-ActionId    = gds-list.ActionId
      560       v-db-num      = gds-list.db-num
      561     .
      562     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
      563       assign
      564         prn-prt = TRUE
      565       .
      566     end.
      567     else do:
      568       assign
      569         prn-prt = FALSE
      570       .
      571     end.
      572     CASE BCodeType:
      573       when "main" then do:
      574         if TicketType = "уп" then do:
      575           for each ub.bar-code no-lock
      576               where ub.bar-code.gds-code = ub.goods.gds-code
      577                 and ub.bar-code.part-code = ""
      578                 and ub.bar-code.in-code = ""
      579                 and ub.bar-code.unit-cli <> ub.goods.unit-base
      580           on error undo, return error :
      581             if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      582   run rep/ticket.p (
      583                  buffer ub.goods
      584                 ,buffer ub.bar-code
      585                 ,buffer ub.scales-gds
      586                 ,input p-obj-type
      587                 ,input p-obj-code
      588                 ,input Action
      589                 ,input rootnode_code
      590                 ,input TickOnw
      591                 ,input TickOnN
      592                 ,input QntyType
      593                 ,input PriceType
      594                 ,input scaleprice
      595                 ,input nakl-qnty
      596                 ,input list-qnty
      597                 ,input pr-doc-rubl
      598                 ,input pr-doc-rb
      599                 ,input pr-doc-rubl-old
      600                 ,input pr-doc-rb-old
      601                 ,input v-fact-order
      602                 ,input ListProdBc
      603                 ,input curr-rate
      604                 ,input TickPS
      605                 ,input dflt-cd
      606                 ,input how-pcnt-kat
      607                 ,input-output b-count
      608                 ,input v-part-code
      609                 ,input v-doc-code
      610                 ,input v-promo-code
      611                 ,input v-ActionId
      612                 ,input v-db-num
      613                 ) no-error .
      614           end.
      615         end.
      616         else do:
      617           for each ub.bar-code no-lock
      618              where ub.bar-code.gds-code = ub.goods.gds-code
      619                and ub.bar-code.unit-cli = ub.goods.unit-base
      620                and ub.bar-code.part-code = ""
      621                and ub.bar-code.in-code = ""
      622           on error undo, return error :
      623             if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
