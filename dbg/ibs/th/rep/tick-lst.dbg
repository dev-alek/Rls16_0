       98   def new shared var bc-frmt as character no-undo .
       99   def new shared var bc-pfx  as character no-undo .
      100   def var bc-par-type as character no-undo .
      101       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      102       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      103           do:
      104               message "Не задан или не верно задан ТИП собственного бар-кода!"
      105                   view-as alert-box ERROR TITLE "".
      106               return error.
      107           end.
      108       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      109       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      110           do:
      111               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      112                   view-as alert-box ERROR TITLE "".
      113               return error.
      114           end.
      115   PROCEDURE gen-bc:
      116     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      117     def output parameter full-b-code     as character init ""    no-undo .
      118   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable tmp-str4  as character no-undo.
      120     define variable tmp-num4  as character no-undo.
      121     define variable i4        as integer   no-undo.
      122     define variable sum4      as integer   no-undo.
      123     define variable len-code4 as integer   no-undo.
      124     define variable varcont4  as logical   initial yes no-undo.
      125     CASE bc-frmt :
      126       WHEN "EAN13" THEN do:
      127         assign
      128           tmp-str4 = string( internal-b-code, "999999999999" )
      129         .
      130       end.
      131       WHEN "EAN8" THEN do:
      132         assign
      133           tmp-str4 = string( internal-b-code, "9999999" )
      134         .
      135       end.
      136       OTHERWISE DO:
      137           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      138           view-as alert-box error.
      139           return error.
      140       END.
      141     END CASE.
      142     if varcont4 = yes then do:
      143       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      144       then do:
      145         message
      146           "Невозможно сформировать бар-код" SKIP
      147           "для товара с кодом: " internal-b-code
      148           view-as alert-box error title "подрезание кода".
      149         return error.
      150       end.
      151       else do:
      152         assign
      153           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      154           len-code4    = length( full-b-code )
      155         .
      156         define variable v-sum-char4 as character no-undo .
      157         assign
      158           sum4 = 0
      159         .
      160         do i4 = 1 to len-code4 by 2
      161         :
      162           assign
      163             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      164           .
      165           if v-sum-char4 < "0"
      166           or v-sum-char4 > "9"
      167           then do:
      168             message
      169               "Невозможно сформировать бар-код" skip
      170               "для товара с кодом: " internal-b-code skip
      171               view-as alert-box error title "подсчет контрольной суммы".
      172             return error.
      173           end.
      174           assign
      175             sum4 = sum4 + integer(v-sum-char4)
      176           .
      177         end.
      178         if varcont4 = yes then do:
      179           assign
      180             sum4 = sum4 * 3
      181           .
      182           do i4 = 2 to len-code4 by 2
      183           :
      184             assign
      185               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      186             .
      187             if v-sum-char4 < "0"
      188             or v-sum-char4 > "9"
      189             then do:
      190               message
      191                 "Невозможно сформировать бар-код" skip
      192                 "для товара с кодом: " internal-b-code skip
      193                 view-as alert-box error title "подсчет контрольной суммы".
      194               return error.
      195             end.
      196             assign
      197               sum4 = sum4 + integer(v-sum-char4)
      198             .
      199           end.
      200           if varcont4 = yes then do:
      201              if sum4 mod 10 = 0 then do:
      202                assign
      203                  full-b-code = full-b-code + '0'
      204                .
      205              end.
      206              else do:
      207                assign
      208                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      209                .
      210              end.
      211           end.
      212         end.
      213       end.
      214     end.
      215   END PROCEDURE.
      216   def new shared var pl-frmt as character no-undo .
      217   def new shared var pl-pfx  as character no-undo .
      218   def var pl-par-type as character no-undo .
      219       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      220       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      221           do:
      222               message "Не задан или не верно задан ТИП собственного бар-кода!"
      223                   view-as alert-box ERROR TITLE "".
      224               return error.
      225           end.
      226       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      227       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      228           do:
      229               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      230                   view-as alert-box ERROR TITLE "".
      231               return error.
      232           end.
      233   PROCEDURE gen-pl:
      234     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
