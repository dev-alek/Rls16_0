      985   procedure gds-list-gds-name :
      986     do
      987     on error undo, return error
      988     :
      989   if NOT can-find(first gds-list) then
      990       RETURN.
      991   for each gds-list
      992   by gds-list.gds-name
      993   :
      994     find ub.goods no-lock
      995       where ub.goods.prod-type = gds-list.prod-type
      996         and ub.goods.prod-code = gds-list.prod-code
      997         and ub.goods.artic = gds-list.artic
      998     .
      999     find ub.gds-prt no-lock
     1000       where ub.gds-prt.upper-code = goods.prt-root
     1001     .
     1002     assign
     1003       rootnode_code = ub.gds-prt.node-code
     1004       list-qnty = gds-list.qnty
     1005       v-part-code   = "":U
     1006       v-promo-code  = gds-list.promo-code
     1007       v-ActionId    = gds-list.ActionId
     1008       v-db-num      = gds-list.db-num
     1009     .
     1010     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
     1011       assign
     1012         prn-prt = TRUE
     1013       .
     1014     end.
