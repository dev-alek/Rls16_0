      285           then do:
      286             message
      287               "Невозможно сформировать бар-код" skip
      288               "для товара с кодом: " internal-b-code skip
      289               view-as alert-box error title "подсчет контрольной суммы".
      290             return error.
      291           end.
      292           assign
      293             sum5 = sum5 + integer(v-sum-char5)
      294           .
      295         end.
      296         if varcont5 = yes then do:
      297           assign
      298             sum5 = sum5 * 3
      299           .
      300           do i5 = 2 to len-code5 by 2
      301           :
      302             assign
      303               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      304             .
      305             if v-sum-char5 < "0"
      306             or v-sum-char5 > "9"
      307             then do:
      308               message
      309                 "Невозможно сформировать бар-код" skip
      310                 "для товара с кодом: " internal-b-code skip
      311                 view-as alert-box error title "подсчет контрольной суммы".
      312               return error.
      313             end.
      314             assign
      315               sum5 = sum5 + integer(v-sum-char5)
      316             .
      317           end.
      318           if varcont5 = yes then do:
      319              if sum5 mod 10 = 0 then do:
      320                assign
      321                  full-b-code = full-b-code + '0'
      322                .
      323              end.
      324              else do:
      325                assign
      326                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      327                .
      328              end.
      329           end.
      330         end.
      331       end.
      332     end.
      333   END PROCEDURE.
