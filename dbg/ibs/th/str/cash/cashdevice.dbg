        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.TypeMap.
        4   block-level on error undo, throw.
        5   class ibs.th.str.cash.CashDevice inherits TypeMap:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Справлочник типов касс" get.
       12      define public property Standard          as class propmap no-undo get. protected set.
       13      define public property TCOAGC            as class propmap no-undo get. protected set.
       14      define public property Mobile            as class propmap no-undo get. protected set.
       15      define public property GrafCash          as class propmap no-undo get. protected set.
       16      define public property Tanker            as class propmap no-undo get. protected set.
       17      define public property TankerIntegr      as class propmap no-undo get. protected set.
       18      constructor public CashDevice ():
       19         super().
       20         Standard     = crProp(0,  "Standard",             "Стандартная касса").
       21         Tanker       = crProp(1,  "Tanker",               "Autotank стандартный").
       22         TCOAGC       = crProp(2,  "TCOAGC",               "ТСО Auto GC").
       23         Mobile       = crProp(3,  "Mobile",               "Мобильное приложение").
       24         GrafCash     = crProp(4,  "GrafCash",             "Графическая касса").
       25         TankerIntegr = crProp(5,  "TankerIntegr",         "Autotank интегрированный").
       26      end.
       27   end class.
