      281     method public void SetCarVol (arg as char):
      282       def var ii as int no-undo.
      283       def var varauto-tank-par as character no-undo.
      284       empty temp-table tt-section.
      285       find first ub.auto-tank no-lock where ub.auto-tank.auto-num = infoSectionTotal:CarNum no-error.
      286       if not available (ub.auto-tank)
      287         then return.
      288       for each ub.auto-section no-lock where ub.auto-section.auto-num = infoSectionTotal:CarNum and ub.auto-section.section-num = integer (arg) :
      289         assign
      290           CarVol =  ub.auto-section.brutto-qnty
      291           DopVolume =  (if ub.auto-section.add-volume = ? then 0 else ub.auto-section.add-volume)
      292           Shape = entry (ub.auto-tank.type-neck + 1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая")
      293         .
      294         case ub.auto-tank.type-neck:
      295         when 0 then do:
      296           diameter = if ub.auto-section.add-volume = ? then "0" else string(ub.auto-section.add-volume).
      297           for each ub.auto-section-table  no-lock where
      298             ub.auto-section-table.auto-num = ub.auto-section.auto-num and ub.auto-section-table.section-num = ub.auto-section.section-num:
      299             create tt-section.
      300             assign
      301               tt-section.dif     = ub.auto-section-table.error  when ub.auto-section-table.error <> ?
      302               tt-section.volume1 = ub.auto-section-table.volume-error when ub.auto-section-table.volume-error <> ?
      303               tt-section.deltaV  = ub.auto-section-table.volume-between / 100 when ub.auto-section-table.volume-between  <> ?
      304             no-error .
      305             diameter =  diameter + "/" + (if ub.auto-section-table.error = ? then "0" else string(ub.auto-section-table.error)) + chr(6)
      306                      + (if ub.auto-section-table.volume-error = ? then "0" else string(ub.auto-section-table.volume-error)) + chr(6)
      307                      + (if ub.auto-section-table.volume-between = ? then "0" else string(ub.auto-section-table.volume-between / 100))  .
      308           end.
      309         end.
      310         when 1 then do:
      311           diameter = (if ub.auto-section.add-volume = ? then "0" else string(ub.auto-section.add-volume)) + "/"
      312                    + (if ub.auto-section.section-depth = ? then "0" else string(ub.auto-section.section-depth)) + "/"
      313                    + (if ub.auto-section.length = ? then "0" else string(ub.auto-section.length)) + "/"
      314                    + (if ub.auto-section.width = ? then "0" else string(ub.auto-section.width))
      315             .
      316         end.
      317         when 2 then do:
      318           diameter = (if ub.auto-section.add-volume = ? then "0" else string(ub.auto-section.add-volume)) + "/"
      319                    + (if ub.auto-section.section-depth = ? then "0" else string(ub.auto-section.section-depth)) + "/"
      320                    + (if ub.auto-section.diameter-max = ? then "0" else string(ub.auto-section.diameter-max)) + "/"
      321                    + (if ub.auto-section.diameter-min = ? then "0" else string(ub.auto-section.diameter-min))
      322             .
      323         end.
      324         when 3 then do:
      325           diameter = (if ub.auto-section.add-volume = ? then "0" else string(ub.auto-section.add-volume)) + "/"
      326                    + (if ub.auto-section.diameter-max = ? then "0" else string(ub.auto-section.diameter-max)) + "/"
      327                    + (if ub.auto-section.diameter-min = ? then "0" else string(ub.auto-section.diameter-min)) + "/"
      328                    + (if ub.auto-section.length = ? then "0" else string(ub.auto-section.length)) + "/"
      329                    + (if ub.auto-section.section-depth = ? then "0" else string(ub.auto-section.section-depth))
      330             .
      331         end.
      332         end case.
      333       end.
      334       release ub.auto-tank.
      335       release ub.auto-section.
      336       release ub.auto-tank-attr.
      337     end.
      338     method public void FillTTSection (input inPar as char):
      339       def var ii as int no-undo.
      340       def var v-section as char no-undo.
      341       empty temp-table tt-section.
      342       DopVolume = decimal (entry(1, inPar, "/")) no-error .
      343       if error-status:error
      344         then DopVolume = 0.
      345       if lookup (Shape, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") = 1
      346       then do:
      347         do ii = 2 to num-entries (inPar, "/"):
      348             v-section = entry(ii, inPar, "/") .
      349             create tt-section .
      350             tt-section.dif     = integer(entry (1,v-section,chr(6))) no-error .
      351             tt-section.volume1 = decimal(entry (2,v-section,chr(6))) no-error .
      352             tt-section.deltaV  = decimal(entry (3,v-section,chr(6))) no-error .
      353         end.
      354       end.
      355     end.
      356     method public void GetCalibTable (input DeltaH as decimal) :
      357       FillTTSection(Diameter) .
      358       find first tt-section where decimal(tt-section.dif) = (DeltaH / 10) no-error .
      359       if available tt-section
      360       then do :
      361         CalibTable = Substitute("&1=&2", tt-section.dif, tt-section.volume1) + (if tt-section.deltaV > 0 then ("=" + trim(string(tt-section.deltaV, ">>9.9999"))) else "") .
      362         return .
      363       end .
      364       find last tt-section where decimal(tt-section.dif) <= (DeltaH / 10) no-error .
      365       if available tt-section
      366       then do :
      367         CalibTable = Substitute("&1=&2", tt-section.dif, tt-section.volume1) + (if tt-section.deltaV > 0 then ("=" + trim(string(tt-section.deltaV, ">>9.9999"))) else "") .
      368       end .
      369       find first tt-section where decimal(tt-section.dif) > (DeltaH / 10) no-error .
      370       if available tt-section
      371       then do :
      372         if DeltaH < 0
      373         then do :
      374           CalibTable = Substitute("&1=&2", tt-section.dif, tt-section.volume1) + (if tt-section.deltaV > 0 then ("=" + trim(string(tt-section.deltaV, ">>9.9999"))) else "") + chr(10) + CalibTable .
      375         end .
      376         else do :
      377           CalibTable = CalibTable + chr(10) + Substitute("&1=&2", tt-section.dif, tt-section.volume1) + (if tt-section.deltaV > 0 then ("=" + trim(string(tt-section.deltaV, ">>9.9999"))) else "") .
      378         end .
      379       end .
      380     end .
