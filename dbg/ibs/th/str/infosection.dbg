      599               NaturalLoss = decimal (entry (2, inAttrValue)) no-error.
      600               Deficit = decimal (entry (3, inAttrValue)) no-error.
      601               if Deficit < 0
      602                 then
      603                   assign
      604                     Deficit = abs(Deficit)
      605                     Excess = 0.
      606                 else
      607                   assign
      608                     Excess = Deficit
      609                     Deficit = 0.
      610             if error-status:error or inAttrValue = ""
      611               then AccAbsFact = ?.
      612           end.
