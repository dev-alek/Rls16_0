      750     end method.
      751     method public decimal getMouth ( input inABTarir as decimal,  input inArea as decimal ):
      752     def var v-mouth as decimal no-undo.
      753     def var v-diff as decimal no-undo.
      754     def var v-vol2 as decimal no-undo.
      755     if Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая")
      756     then do:
      757       if inABTarir = 0
      758         then v-mouth = 0.
      759       else do:
      760         FillTTSection(Diameter) .
      761         find first tt-section where decimal (tt-section.dif) = decimal (inABTarir) / 10 no-error.
      762         if available tt-section
      763         then do :
      764           v-mouth = tt-section.volume1 .
      765           return v-mouth.
      766         end .
      767         find first tt-section where decimal (tt-section.dif) > decimal (inABTarir) / 10 no-error.
      768         if error-status:error
      769         then do:
      770           return 0.
      771         end.
      772         v-vol2 = tt-section.volume1.
      773         find last tt-section where decimal (tt-section.dif) <= decimal (inABTarir) / 10 no-error.
      774         if error-status:error
      775         then do:
      776           return 0.
      777         end.
      778         v-diff = decimal (inABTarir) - decimal (tt-section.dif) * 10.
      779         v-mouth = tt-section.volume1 + (v-vol2 - tt-section.volume1) / 10 * v-diff.
      780         return v-mouth.
      781       end.
      782     end.
      783     else do:
      784       v-mouth = round ((inABTarir) * inArea, 2).
      785       return v-mouth.
      786     end.
      787     finally:
      788       return v-mouth.
      789     end.
      790     end method.
      791     destructor public InfoSection ( ):
      792     end destructor.
      793   end class.
