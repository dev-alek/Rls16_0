        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.TypeMap.
        4   block-level on error undo, throw.
        5   class ibs.th.str.marking.Types inherits TypeMap:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Типы маркировки" get.
       12     define public property  tabak      as class propmap no-undo get.  protected set.
       13     define public property  shoes      as class propmap no-undo get.  protected set.
       14     define public property  perfume    as class propmap no-undo get.  protected set.
       15     define public property  industry   as class propmap no-undo get.  protected set.
       16     define public property  tires      as class propmap no-undo get.  protected set.
       17     define public property  apteka     as class propmap no-undo get.  protected set.
       18     define public property  photo      as class propmap no-undo get.  protected set.
       19     define public property  milk       as class propmap no-undo get.  protected set.
       20     define public property  water      as class propmap no-undo get.  protected set.
       21     define public property  stiki      as class propmap no-undo get.  protected set.
       22     define public property  milk-40    as class propmap no-undo get.  protected set.
       23     define public property  NSJ        as class propmap no-undo get.  protected set.
       24     define public property  Bad        as class propmap no-undo get.  protected set.
       25     define public property  antiseptic as class propmap no-undo get.  protected set.
       26     define public property  Badd2L7    as class propmap no-undo get.  protected set.
       27     constructor public Types ():
       28       define buffer code for ub.code.
       29       define variable vCode as integer no-undo.
       30       super().
       31       assign
       32          tabak = Unknow
       33          shoes = Unknow
       34          perfume = Unknow
       35          industry = Unknow
       36          tires = Unknow
       37          apteka = Unknow
       38          photo = Unknow
       39          milk = Unknow
       40          water = Unknow
       41          stiki = Unknow
       42          milk-40 = Unknow
       43          NSJ = Unknow
       44          Bad = Unknow
       45          antiseptic = Unknow
       46          Badd2L7 = Unknow
       47       .
       48       for each code no-lock where code.parent = "MarkType":
       49           vCode = int(code.code) no-error.
       50           if vCode <> ? then
       51           do:
       52               if vCode = 1 then
       53                 tabak = crProp(vCode,code.codevalue,code.codename).
       54               else if vCode = 2 then
       55                 shoes = crProp(vCode,code.codevalue,code.codename).
       56               else if vCode = 3 then
       57                 perfume = crProp(vCode,code.codevalue,code.codename).
       58               else if vCode = 4 then
       59                 industry = crProp(vCode,code.codevalue,code.codename).
       60               else if vCode = 5 then
       61                 tires = crProp(vCode,code.codevalue,code.codename).
       62               else if vCode = 6 then
       63                 apteka = crProp(vCode,code.codevalue,code.codename).
       64               else if vCode = 7 then
       65                 photo = crProp(vCode,code.codevalue,code.codename).
       66               else if vCode = 8 then
       67                 milk = crProp(vCode,code.codevalue,code.codename).
       68               else if vCode = 9 then
       69                 water = crProp(vCode,code.codevalue,code.codename).
       70              else if vCode = 10 then
       71                 stiki = crProp(vCode,code.codevalue,code.codename).
       72              else if vCode = 11 then
       73                 milk-40 = crProp(vCode,code.codevalue,code.codename).
       74              else if vCode = 12 then
       75                 NSJ = crProp(vCode,code.codevalue,code.codename).
       76             else if vCode = 13 then
       77                 Bad = crProp(vCode,code.codevalue,code.codename).
       78               else if vCode = 14 then
       79                 antiseptic = crProp(vCode,code.codevalue,code.codename).
       80               else if vCode = 16 then
       81                 Badd2L7 = crProp(vCode,code.codevalue,code.codename).
       82               else
       83                 crProp(vCode,code.codevalue,code.codename).
       84           end.
       85       end.
       86       Unknow:Label_  = "Неизвестный тип маркировки.".
       87     end.
       88   end class.
