        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.TypeMap.
        4   block-level on error undo, throw.
        5   class ibs.th.str.marking.sts.mark inherits TypeMap:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Статусы марок" get.
       12     define public property  PendingVerification as class propmap no-undo get.  protected set.
       13     define public property  CheckContr  as class propmap no-undo get.  protected set.
       14     define public property  DeliveryControl  as class propmap no-undo get.  protected set.
       15     define public property  DemandInfo as class propmap no-undo get.  protected set.
       16     define public property  MarkError as class propmap no-undo get.  protected set.
       17     define public property  NotAvailable as class propmap no-undo get.  protected set.
       18     define public property  Checked_  as class propmap no-undo get.  protected set.
       19     define public property  Received as class propmap no-undo get.  protected set.
       20     define public property  OutZone as class propmap no-undo get.  protected set.
       21     define public property  FreeZone as class propmap no-undo get.  protected set.
       22     define public property  Reserved as class propmap no-undo get.  protected set.
       23     define public property  SaleLock  as class propmap no-undo get.  protected set.
       24     define public property  ReturnLock  as class propmap no-undo get.  protected set.
       25     define public property  SaleWaitLock  as class propmap no-undo get.  protected set.
       26     define public property  ReturnWaitLock  as class propmap no-undo get.  protected set.
       27     define public property  Ungrouped as class propmap no-undo get.  protected set.
       28     define public property  GrayZone as class propmap no-undo get.  protected set.
       29     define public property  UsedInProduction as class propmap no-undo get.  protected set.
       30     define public property  ReservedFromProduction as class propmap no-undo get.  protected set.
       31     define public property  WrittenOff  as class propmap no-undo get.  protected set.
       32     define public property  Moved  as class propmap no-undo get.  protected set.
       33     define public property  OutOfInventory  as class propmap no-undo get.  protected set.
       34     define public property  Returned  as class propmap no-undo get.  protected set.
       35     define public property  UnknowSts as class propmap no-undo get.  protected set.
       36     define public property  EqualChecked as character  no-undo get.  protected set.
       37     define public property  AllChecked   as character  no-undo get.  protected set.
       38     define public property  Sale_Return_Wait as character  no-undo get.  protected set.
       39     define public property  Doc_Status       as character  no-undo get.  protected set.
       40     define public property  FreeStatuses     as character  no-undo get.  protected set.
       41     constructor public mark ():
       42       super().
       43       PendingVerification  = crProp(1,"PendingVerification","Ожидает проверку").
       44       CheckContr   = crProp(2,"CheckContr","Ожидает проверку по договору").
       45       DeliveryControl = crProp(3,"DeliveryControl","Ожидает приемку").
       46       DemandInfo = crProp(4,"DemandInfo","Запрос инфо").
       47       MarkError = crProp(5,"MarkError","Ошибка").
       48       NotAvailable   = crProp(6,"NotAvailable","Отсутствует в поставке").
       49       Checked_   = crProp(7,"Checked_","Проверен").
       50       Received   = crProp(8,"Received","Получен").
       51       OutZone  = crProp(9,"OutZone","Выбыл").
       52       FreeZone  = crProp(10,"FreeZone","Свободная зона").
       53       SaleLock   = crProp(11,"SaleLock","Продан на кассе").
       54       ReturnLock   = crProp(12,"ReturnLock","Возвращен на кассе").
       55       Reserved   = crProp(13,"Reserved","Зарезервирован").
       56       SaleWaitLock   = crProp(14,"SaleWaitLock","Идет продажа").
       57       ReturnWaitLock   = crProp(15,"ReturnWaitLock","Блокировка идет возврат").
       58       WrittenOff   = crProp(16,"WrittenOff","Списан").
       59       UsedInProduction = crProp(17,"ProductionUse","Использован в производство").
       60       ReservedFromProduction = crProp(18,"ReservedFromProduction","Зарезервирован для возврата в оборот").
       61       Moved = crProp(19,"Moved","Перемещен").
       62       Ungrouped  = crProp(20,"Ungrouped","Разгруппирован").
       63       GrayZone  = crProp(21,"GrayZone","Серая зона").
       64       OutOfInventory  = crProp(22,"Retired","Выбыл при инвентаризации марок").
       65       Returned   = crProp(23,"Returned","Возвращен поставщику").
       66       UnknowSts  = crProp(0,"UnknowSts","Неизвестный статус маркированного товара.").
       67       EqualChecked = "7,11,12".
       68       Sale_Return_Wait  = "11,12,14,15".
       69       Doc_Status = "13,16,17,18,19,22,23".
       70       FreeStatuses = "1,3,5,6,7,10".
       71       AllChecked   = substitute("7,&1,&2",Sale_Return_Wait,Doc_Status).
       72     end.
       73   end class.
