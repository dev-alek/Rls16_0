        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.sys.objsrv.
        4   using ibs.th.str.marking.sts.*.
        5   block-level on error undo, throw.
        6   class ibs.th.str.marking.handlers.treeexem inherits objth:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Бибилиотека обработки марок с обращением к БД" get.
       13     method public logical LevelDownUTD(mark as char, doc-id as integer, db-num as integer):
       14       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
       15       define buffer buf_marking           for ub.marking .
       16       define variable vflag as logical no-undo.
       17       find first buf_marking no-lock where buf_marking.mark-parent = mark no-error .
       18       if available (buf_marking) then do:
       19         if can-find(first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = db-num and buf_utd-marking-lines.doc-id = doc-id
       20           and buf_utd-marking-lines.mark = buf_marking.mark )
       21         then vflag = yes .
       22         else vflag = no .
       23       end.
       24       else vflag = no .
       25       release buf_marking.
       26       return vflag.
       27     end method.
       28     method public logical LevelDownDoc(mark as char, obj-code as integer, obj-type as character, in-code as character, out-code as character):
       29       define buffer buf_marking-lines for ub.marking-lines .
       30       define buffer buf_marking           for ub.marking .
       31       find first buf_marking no-lock where buf_marking.mark-parent = mark no-error .
       32       if available (buf_marking) then do:
       33         for first buf_marking-lines no-lock where buf_marking-lines.obj-type = obj-type and buf_marking-lines.obj-code = obj-code
       34           and buf_marking-lines.mark = buf_marking.mark and buf_marking-lines.in-code = in-code and buf_marking-lines.out-code = out-code:
       35           return yes .
       36         end.
       37         return no .
       38       end.
       39       else return no .
       40     end method.
       41     method public logical LevelUpUTD(mark as char, doc-id as integer, db-num as integer):
       42       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
       43       define buffer buf_marking           for ub.marking .
       44       find first buf_marking no-lock where buf_marking.mark = mark no-error .
       45       if available (buf_marking) then do:
       46         if can-find(first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = db-num and buf_utd-marking-lines.doc-id = doc-id
       47           and buf_utd-marking-lines.mark = buf_marking.mark-parent)
       48         then return yes .
       49         else return no .
       50       end.
       51       else return no .
       52     end method.
       53     method public logical StatusDownUTD(mark as char, doc-id as integer, db-num as integer, sts as integer):
       54       do trans:
       55       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
       56       define buffer buf_marking           for ub.marking .
       57       define buffer marking               for ub.marking .
       58       define variable vOk  as logical no-undo init yes.
       59       define variable vBad as logical no-undo.
       60       for each buf_marking no-lock where buf_marking.mark-parent = mark :
       61         for each buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.db-num = db-num and buf_utd-marking-lines.doc-id = doc-id
       62           and buf_utd-marking-lines.mark = buf_marking.mark:
       63             if LevelDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then do:
       64               vOk =  StatusDownUTD(buf_utd-marking-lines.mark,buf_utd-marking-lines.doc-id,buf_utd-marking-lines.db-num,sts) .
       65             end.
       66             else
       67                vOk = yes.
       68             if vOk then do:
       69               if sts ne ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
       70                  or ( sts eq ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
       71                       and buf_marking.sts ne ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
       72                       and buf_marking.sts ne ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
       73                       and buf_marking.sts ne ObjSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
       74                       and buf_marking.sts ne ObjSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB
       75                       and buf_marking.sts ne ObjSrv:Env:Marking:Sts:Mark:SaleWaitLock:KeyIntDB
       76                      )
       77               then do:
       78                  buf_utd-marking-lines.sts = sts .
       79               end.
       80               if sts eq ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
       81                  and (buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB
       82                    or buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:SaleWaitLock:KeyIntDB
       83                    or buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB
       84                    or buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:ReturnWaitLock:KeyIntDB)
       85               then do:
       86                 find first marking exclusive-lock where marking.mark = mark.
       87                 assign
       88                   buf_utd-marking-lines.sts = buf_marking.sts
       89                   marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
       90                 .
       91               end.
       92             end.
       93             else
       94                vBad = yes.
       95         end.
       96       end.
       97       end.
       98       return not vBad .
       99     end method.
      100     method public logical StatusUpUTD(iMark as char, iDbNum as integer, iDocId as integer, iSts as integer):
      101       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
      102       define buffer buf_marking           for ub.marking .
      103       if iMark = "" then
      104         return no.
      105       if checkedAllMarksOfUpakUTD(iMark, iDbNum, iDocId)
      106       then do:
      107         for first buf_utd-marking-lines exclusive-lock where
      108                   buf_utd-marking-lines.mark = iMark
      109               and buf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num
      110               and buf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id
      111         :
      112           buf_utd-marking-lines.sts   = iSts.
      113           for first buf_marking no-lock where
      114                     buf_marking.mark begins buf_utd-marking-lines.mark
      115           :
      116             StatusUpUTD(buf_marking.mark-parent, iDbNum, iDocId, iSts).
      117           end.
      118         end.
      119         return yes.
      120      end.
      121     return no.
      122     end method.
      123     method public integer StatusDownDoc(mark as char, obj-code as integer, obj-type as character, in-code as character, out-code as character, sts as integer):
      124       do trans:
      125       define buffer buf_marking-lines for ub.marking-lines .
      126       define buffer buf_marking           for ub.marking .
      127       define variable qnty-check  as integer no-undo .
      128       for each buf_marking no-lock where buf_marking.mark-parent = mark :
      129         for each buf_marking-lines exclusive-lock where buf_marking-lines.obj-code = obj-code and buf_marking-lines.obj-type = obj-type
      130           and buf_marking-lines.mark = buf_marking.mark and buf_marking-lines.in-code = in-code and buf_marking-lines.out-code = out-code:
      131             buf_marking-lines.sts = sts .
      132             qnty-check = qnty-check + 1 .
      133             if LevelDownDoc(buf_marking-lines.mark, buf_marking-lines.obj-code, buf_marking-lines.obj-type, buf_marking-lines.in-code, buf_marking-lines.out-code) then do:
      134               qnty-check = qnty-check + StatusDownDoc(buf_marking-lines.mark,buf_marking-lines.obj-code,buf_marking-lines.obj-type, buf_marking-lines.in-code, buf_marking-lines.out-code, buf_marking-lines.sts) .
      135             end.
      136         end.
      137       end.
      138       end.
      139       return qnty-check .
      140     end method.
      141     method public integer DeleteDownDoc(mark as char, obj-code as integer, obj-type as character, in-code as character, out-code as character):
      142       do trans:
      143       define buffer buf_marking-lines for ub.marking-lines .
      144       define buffer buf_marking           for ub.marking .
      145       define variable qnty-check  as integer no-undo .
      146       for each buf_marking exclusive-lock where buf_marking.mark-parent = mark :
      147         for each buf_marking-lines exclusive-lock where buf_marking-lines.obj-code = obj-code and buf_marking-lines.obj-type = obj-type
      148           and buf_marking-lines.mark = buf_marking.mark and buf_marking-lines.in-code = in-code and buf_marking-lines.out-code = out-code:
      149             buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB.
      150             if LevelDownDoc(buf_marking-lines.mark, buf_marking-lines.obj-code, buf_marking-lines.obj-type, buf_marking-lines.in-code, buf_marking-lines.out-code) then do:
      151               DeleteDownDoc(buf_marking-lines.mark,buf_marking-lines.obj-code,buf_marking-lines.obj-type, buf_marking-lines.in-code, buf_marking-lines.out-code) .
      152             end.
      153             delete buf_marking-lines .
      154         end.
      155       end.
      156       end.
      157       return qnty-check .
      158     end method.
      159     method public logical UnGroupUTD(mark as char, doc-id as integer, db-num as integer):
      160       do trans:
      161       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
      162       define buffer buf_marking           for ub.marking .
      163       define buffer bf_marking            for ub.marking .
      164       define buffer marking            for ub.marking .
      165       define variable v-is                as logical no-undo.
      166       for first marking where marking.mark = mark no-lock:
      167         for first buf_marking exclusive-lock where buf_marking.mark = marking.mark-parent:
      168           buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB. .
      169           for first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.db-num = db-num and buf_utd-marking-lines.doc-id = doc-id
      170               and buf_utd-marking-lines.mark = buf_marking.mark:
      171                 buf_utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB. .
      172           end.
      173           UnGroupUTD(buf_marking.mark, doc-id, db-num).
      174           v-is = yes .
      175         end.
      176       end.
      177     end.
      178     release marking.
      179     release buf_utd-marking-lines.
      180     release bf_marking.
      181     release buf_marking.
      182     return v-is.
      183     end method.
      184     method public logical UnGroupDoc(mark as char, in-code as character, out-code as character, obj-code as integer, obj-type as character):
      185       define buffer buf_marking-lines for ub.marking-lines .
      186       define buffer buf_marking           for ub.marking .
      187       define buffer bf_marking            for ub.marking .
      188       define buffer marking            for ub.marking .
      189       define variable v-log as logical no-undo.
      190       ff_:
      191       for first marking where marking.mark = mark  no-lock trans:
      192         for first buf_marking exclusive-lock where buf_marking.mark = marking.mark-parent:
      193           for each bf_marking no-lock where bf_marking.mark-parent = buf_marking.mark:
      194             for first buf_marking-lines exclusive-lock where buf_marking-lines.in-code = in-code and buf_marking-lines.out-code = out-code and
      195             buf_marking-lines.obj-code = obj-code and buf_marking-lines.obj-type = obj-type and buf_marking-lines.mark = bf_marking.mark:
      196               buf_marking-lines.doc-level = buf_marking-lines.doc-level - 1 .
      197             end.
      198           end.
      199           buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB. .
      200             for first buf_marking-lines exclusive-lock where buf_marking-lines.in-code = in-code and buf_marking-lines.out-code = out-code and
      201             buf_marking-lines.obj-code = obj-code and buf_marking-lines.obj-type = obj-type and buf_marking-lines.mark = buf_marking.mark:
      202                 buf_marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB. .
      203                 buf_marking-lines.doc-level = 0 .
      204           end.
      205           v-log = true.
      206           leave ff_.
      207         end.
      208       end.
      209       release marking.
      210       release bf_marking.
      211       release buf_marking.
      212       release buf_marking-lines.
      213       return v-log .
      214     end method.
      215     method public logical UnGroupMark(mark as char):
      216       define buffer buf_marking           for ub.marking .
      217       define buffer bf_marking            for ub.marking .
      218       find first bf_marking no-lock where bf_marking.mark = mark.
      219       for each buf_marking exclusive-lock where buf_marking.mark = bf_marking.mark-parent trans:
      220         buf_marking.sts =  ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB.
      221         UnGroupMark (buf_marking.mark).
      222       end.
      223       release buf_marking.
      224       release bf_marking.
      225       return true.
      226     end method.
      227     method public logical LevelDown(mark as char):
      228       do trans:
      229       define buffer buf_marking           for ub.marking .
      230       if can-find (first buf_marking no-lock where buf_marking.mark-parent = mark)
      231         then return true.
      232         else return false.
      233       end.
      234     end method.
      235     method public void LockInvChildeMark (mark as char, doc-code as char):
      236       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
      237       define buffer buf_marking           for ub.marking .
      238       define buffer bf_marking            for ub.marking .
      239       for each buf_marking no-lock where buf_marking.mark-parent = mark trans:
      240         create ub.marking-attr.
      241         ub.marking-attr.mark = buf_marking.mark.
      242         ub.marking-attr.attr-code = "inv-doc".
      243         ub.marking-attr.attr-value = doc-code.
      244         LockInvChildeMark (buf_marking.mark, doc-code).
      245         release ub.marking-attr.
      246       end.
      247     end method.
      248     method public void LockChkChildeMark (Imark as char ):
      249       def buffer buf_marking for ub.marking.
      250       def buffer buf_mark for ub.marking.
      251       find first buf_mark where buf_mark.mark eq Imark
      252       no-lock no-error.
      253       if available buf_mark
      254       then do:
      255         for each buf_marking exclusive-lock where buf_marking.mark-parent = buf_mark.mark trans:
      256            buf_marking.loc-key = buf_mark.loc-key.
      257            buf_marking.sts = buf_mark.sts.
      258            LockChkChildeMark (buf_marking.mark).
      259         end.
      260       end.
      261       release buf_mark.
      262     end method.
      263     method public integer  GetQntySts(mark as char, sts as integer):
      264        define buffer buf_marking for marking.
      265        define variable v-q as integer no-undo.
      266        find first buf_marking where buf_marking.mark = mark no-lock no-error.
      267        if available buf_marking
      268        then do:
      269           if     buf_marking.sts = sts
      270              and buf_marking.box-qnty <> ?
      271           then
      272              v-q = buf_marking.box-qnty.
      273           else do:
      274              for each buf_marking where buf_marking.mark-parent = mark no-lock:
      275                 v-q = v-q + GetQntySts(buf_marking.mark, sts).
      276              end.
      277           end.
      278        end.
      279        return v-q.
      280      end method.
      281     method public integer  GetQntyStsUnit(db-num as integer,doc-id as integer, line-num as integer , sts as integer):
      282        define buffer buf_utd-marking-lines for utd-marking-lines.
      283        define buffer buf_marking  for marking.
      284        define variable v-q as integer no-undo.
      285        for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = db-num
      286             and buf_utd-marking-lines.doc-id = doc-id
      287             and buf_utd-marking-lines.LineNum = line-num
      288             :
      289             find first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark and buf_marking.unit-ext = "UNIT"
      290               and buf_marking.sts = sts no-error.
      291             if available (buf_marking)
      292               then v-q = v-q + 1.
      293         end.
      294         return v-q.
      295     end method.
      296    method public integer  GetQntyCheckMark(db-num as integer,doc-id as integer, line-num as integer):
      297        define buffer bf_utd-marking-lines for ub.utd-marking-lines.
      298        define buffer bf_marking  for ub.marking.
      299        define variable v-q as integer no-undo.
      300        define variable Marking as class mark no-undo .
      301        Marking = ObjSrv:Env:Marking:Sts:Mark.
      302        block-mark-line:
      303        for each bf_utd-marking-lines where bf_utd-marking-lines.db-num    = db-num   and
      304                                            bf_utd-marking-lines.doc-id    = doc-id   and
      305                                            bf_utd-marking-lines.LineNum   = Line-Num  and
      306                                            bf_utd-marking-lines.doc-level = 1
      307        no-lock:
      308           if not isMark(bf_utd-marking-lines.mark)
      309           then
      310              next block-mark-line.
      311           if     bf_utd-marking-lines.sts   = Marking:Checked_:KeyIntDB
      312           then do:
      313              find first bf_marking where bf_marking.mark eq bf_utd-marking-lines.mark no-lock no-error.
      314              v-q =  v-q + if available bf_marking then bf_marking.box-qnty else 1  .
      315           end.
      316           else do:
      317              if LevelDownUTD(bf_utd-marking-lines.mark, bf_utd-marking-lines.doc-id, bf_utd-marking-lines.db-num)
      318              then
      319                 v-q =  v-q + GetQntyCheckMark(db-num, doc-id, line-num, bf_utd-marking-lines.mark).
      320           end.
      321        end.
      322        return v-q.
      323     end method.
      324     method public integer  GetQntyCheckMark(db-num as integer,doc-id as integer, line-num as integer,  imark as character ):
      325        define buffer bf_utd-marking-lines for ub.utd-marking-lines.
      326        define buffer bf_marking  for ub.marking.
      327        define variable Marking as class mark no-undo .
      328        Marking = ObjSrv:Env:Marking:Sts:Mark.
      329        define variable v-q as integer no-undo.
      330        block-mark-line:
      331        for each bf_marking where bf_marking.mark-parent eq imark
      332        no-lock,
      333           first bf_utd-marking-lines where bf_utd-marking-lines.db-num  = db-num   and
      334                                            bf_utd-marking-lines.doc-id  = doc-id   and
      335                                            bf_utd-marking-lines.LineNum = LineNum  and
      336                                            bf_utd-marking-lines.mark    = bf_marking.mark
      337        no-lock:
      338           if     bf_utd-marking-lines.sts   = Marking:Checked_:KeyIntDB
      339           then do:
      340              v-q =  v-q + if available bf_marking then bf_marking.box-qnty else 1  .
      341           end.
      342           else do:
      343              if LevelDownUTD(bf_utd-marking-lines.mark, bf_utd-marking-lines.doc-id, bf_utd-marking-lines.db-num)
      344              then
      345                 v-q =  v-q + GetQntyCheckMark(db-num, doc-id, line-num, bf_utd-marking-lines.mark).
      346           end.
      347        end.
      348        return v-q.
      349     end method.
      350     method public logical checkedAllMarksOfUpakUTD(iMarkUpak as character, iDbNum as integer, iDocId as integer):
      351        define buffer upak_marking                for ub.marking .
      352        define buffer upak_utd-marking-lines      for ub.utd-marking-lines .
      353        define variable Marking as class mark no-undo .
      354        Marking = ObjSrv:Env:Marking:Sts:Mark.
      355        for each upak_marking no-lock where
      356                 upak_marking.mark-parent = iMarkUpak
      357            ,first upak_utd-marking-lines no-lock where
      358                   upak_utd-marking-lines.mark   = upak_marking.mark
      359               and upak_utd-marking-lines.db-num = iDbNum
      360               and upak_utd-marking-lines.doc-id = iDocId
      361               and upak_utd-marking-lines.sts   <> Marking:Checked_:KeyIntDB
      362        :
      363          return no.
      364        end.
      365        return yes.
      366     end method.
      367   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define variable vss-include-info1 as character format "X(65)" no-undo
      369   initial "@(#)$Workfile$ $Revision$".
      370   method private void xmlchar-test (input  p-in-string          as character,
      371                                     output p-out-string-enc     as character,
      372                                     output p-out-string-dec    as character):
      373   do
      374   on error undo, return error
      375   :
      376          xmlchar-encode
      377       (
      378             input p-in-string
      379           , output p-out-string-enc
      380       ).
      381          xmlchar-decode
      382       (
      383             input p-out-string-enc
      384           , output p-out-string-dec
      385       ).
      386   end.
      387   end .
      388   method private void xmlchar-encode (input  p-in-string          as character,
      389                                     output p-out-string         as character):
      390       define variable v-position      as integer      no-undo.
      391       define variable v-current-char  as character    no-undo.
      392   do
      393   on error undo, return error
      394   :
      395       assign
      396           p-out-string = "":U
      397       .
      398       case p-in-string
      399       :
      400           when ?
      401           then do:
      402               assign
      403                   p-out-string = "?":U
      404               .
      405           end.
      406           when "?":U
      407           then do:
      408               assign
      409                   p-out-string = "&#63;":U
      410               .
      411           end.
      412           otherwise do:
      413               do v-position = 1 to length( p-in-string )
      414               :
      415                   assign
      416                       v-current-char = substring( p-in-string, v-position, 1 )
      417                   .
      418                   case v-current-char
      419                   :
      420                       when "&":U
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "&amp;":U
      424                           .
      425                       end.
      426                       when ">":U
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "&gt;":U
      430                           .
      431                       end.
      432                       when "<":U
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "&lt;":U
      436                           .
      437                       end.
      438                       when "'":U
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "&apos;":U
      442                           .
      443                       end.
      444                       when '"':U
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "&quot;":U
      448                           .
      449                       end.
      450                       when chr(1)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "":U
      454                           .
      455                       end.
      456                       when chr(2)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "":U
      460                           .
      461                       end.
      462                       when chr(3)
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "":U
      466                           .
      467                       end.
      468                       when chr(4)
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "":U
      472                           .
      473                       end.
      474                       when chr(5)
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "":U
      478                           .
      479                       end.
      480                       when chr(6)
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "":U
      484                           .
      485                       end.
      486                       when chr(7)
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "":U
      490                           .
      491                       end.
      492                       when chr(8)
      493                       then do:
      494                           assign
      495                               p-out-string = p-out-string + "":U
      496                           .
      497                       end.
      498                       when chr(9)
      499                       then do:
      500                           assign
      501                               p-out-string = p-out-string + "":U
      502                           .
      503                       end.
      504                       when chr(29)
      505                       then do:
      506                           assign
      507                               p-out-string = p-out-string + "":U
      508                           .
      509                       end.
      510                       when chr(10)
      511                       then do:
      512                           assign
      513                               p-out-string = p-out-string + "&#10;":U
      514                           .
      515                       end.
      516                       when chr(13)
      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + "&#13;":U
      520                           .
      521                       end.
      522                       otherwise do:
      523                           assign
      524                               p-out-string = p-out-string + v-current-char
      525                           .
      526                       end.
      527                   end case.
      528               end.
      529           end.
      530       end case.
      531   end.
      532   end .
      533   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      534   define variable p-out-string as character no-undo.
      535       define variable v-position      as integer      no-undo.
      536       define variable v-current-char  as character    no-undo.
      537   do
      538   on error undo, return error
      539   :
      540       assign
      541           p-out-string = "":U
      542       .
      543       case p-in-string
      544       :
      545           when ?
      546           then do:
      547               assign
      548                   p-out-string = "?":U
      549               .
      550           end.
      551           otherwise do:
      552               do v-position = 1 to length( p-in-string )
      553               :
      554                   assign
      555                       v-current-char = substring( p-in-string, v-position, 1 )
      556                   .
      557                   case v-current-char
      558                   :
      559                       when chr(1)
      560                       then do:
      561                           assign
      562                               p-out-string = p-out-string + " ":U
      563                           .
      564                       end.
      565                       when chr(2)
      566                       then do:
      567                           assign
      568                               p-out-string = p-out-string + " ":U
      569                           .
      570                       end.
      571                       when chr(3)
      572                       then do:
      573                           assign
      574                               p-out-string = p-out-string + " ":U
      575                           .
      576                       end.
      577                       when chr(4)
      578                       then do:
      579                           assign
      580                               p-out-string = p-out-string + " ":U
      581                           .
      582                       end.
      583                       when chr(5)
      584                       then do:
      585                           assign
      586                               p-out-string = p-out-string + " ":U
      587                           .
      588                       end.
      589                       when chr(6)
      590                       then do:
      591                           assign
      592                               p-out-string = p-out-string + " ":U
      593                           .
      594                       end.
      595                       when chr(7)
      596                       then do:
      597                           assign
      598                               p-out-string = p-out-string + " ":U
      599                           .
      600                       end.
      601                       when chr(8)
      602                       then do:
      603                           assign
      604                               p-out-string = p-out-string + " ":U
      605                           .
      606                       end.
      607                       when chr(9)
      608                       then do:
      609                           assign
      610                               p-out-string = p-out-string + " ":U
      611                           .
      612                       end.
      613                       when chr(29)
      614                       then do:
      615                           assign
      616                               p-out-string = p-out-string + " ":U
      617                           .
      618                       end.
      619                       when chr(10)
      620                       then do:
      621                           assign
      622                               p-out-string = p-out-string + " ":U
      623                           .
      624                       end.
      625                       when chr(13)
      626                       then do:
      627                           assign
      628                               p-out-string = p-out-string + " ":U
      629                           .
      630                       end.
      631                       otherwise do:
      632                           assign
      633                               p-out-string = p-out-string + v-current-char
      634                           .
      635                       end.
      636                   end case.
      637               end.
      638           end.
      639       end case.
      640   end.
      641   return p-out-string.
      642   end .
      643   method private void xmlchar-decode (input  p-in-string          as character,
      644                                     output p-out-string         as character):
      645       define variable v-position      as integer      no-undo.
      646       define variable v-last-position as integer      no-undo.
      647       define variable v-temp-integer  as integer      no-undo.
      648       define variable v-current-char  as character    no-undo.
      649       define variable v-next-char     as character    no-undo.
      650       define variable v-success       as logical      no-undo.
      651   do
      652   on error undo, return error
      653   :
      654       assign
      655           p-out-string = "":U
      656           v-position   = 0
      657       .
      658       replace-cycle:
      659       do while yes
      660       on error undo, return error
      661       :
      662           assign
      663               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      664           .
      665           if v-last-position <= v-position
      666           then do:
      667               if v-position = 0
      668               then do:
      669                   assign
      670                       p-out-string = p-in-string
      671                   .
      672               end.
      673               else do:
      674                   assign
      675                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      676                   .
      677               end.
      678               leave replace-cycle.
      679           end.
      680           else do:
      681               assign
      682                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      683                   v-position      = v-last-position
      684                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      685               .
      686               if v-current-char = "#":U
      687               then do:
      688                   assign
      689                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      690                   .
      691                   if v-last-position > 0
      692                   then do:
      693                       xmlchar-read-integer
      694                        (
      695                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      696                           , output v-temp-integer
      697                           , output v-success
      698                       ).
      699                       if v-success = yes
      700                       and v-temp-integer >= 1
      701                       and v-temp-integer <= 255
      702                       then do:
      703                           assign
      704                               p-out-string = p-out-string + chr( v-temp-integer )
      705                               v-position   = v-last-position + 1
      706                           .
      707                       end.
      708                       else do:
      709                           assign
      710                               p-out-string = p-out-string + "&":U
      711                               v-position   = v-position   + 1
      712                           .
      713                       end.
      714                   end.
      715                   else do:
      716                       assign
      717                           p-out-string = p-out-string + "&":U
      718                           v-position   = v-position   + 1
      719                       .
      720                   end.
      721               end.
      722               else do:
      723                   case substring( p-in-string, v-position + 1, 3 )
      724                   :
      725                       when "lt;":U
      726                       then do:
      727                           assign
      728                               p-out-string = p-out-string + "<":U
      729                               v-position   = v-position   + 3
      730                           .
      731                       end.
      732                       when "gt;":U
      733                       then do:
      734                           assign
      735                               p-out-string = p-out-string + ">":U
      736                               v-position   = v-position   + 3
      737                           .
      738                       end.
      739                       otherwise do:
      740                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      741                           then do:
      742                               assign
      743                                   p-out-string = p-out-string + "&":U
      744                                   v-position   = v-position   + 4
      745                               .
      746                           end.
      747                           else do:
      748                               case substring( p-in-string, v-position + 1, 5 )
      749                               :
      750                                   when "quot;":U
      751                                   then do:
      752                                       assign
      753                                           p-out-string = p-out-string + '"':U
      754                                           v-position   = v-position   + 5
      755                                       .
      756                                   end.
      757                                   when "apos;":U
      758                                   then do:
      759                                       assign
      760                                           p-out-string = p-out-string + "'":U
      761                                           v-position   = v-position   + 5
      762                                       .
      763                                   end.
      764                                   otherwise do:
      765                                       assign
      766                                           p-out-string = p-out-string + "&":U
      767                                       .
      768                                   end.
      769                               end case.
      770                           end.
      771                       end.
      772                   end case.
      773               end.
      774           end.
      775       end.
      776   end.
      777   end .
      778   method private void xmlchar-read-integer (input  p-input-string       as character,
      779                                             output p-output-integer     as integer,
      780                                             output p-success            as logical):
      781   do
      782   on error undo, return error
      783   :
      784       assign
      785           p-output-integer = integer( p-input-string )
      786       no-error.
      787       if error-status :error
      788       then do:
      789           assign
      790               p-success           = no
      791               p-output-integer    = 0
      792           .
      793       end.
      794       else do:
      795           assign
      796               p-success           = yes
      797           .
      798       end.
      799   end.
      800   end.
      801   method private void getAttrLib ():
      802      define variable g#attr-lib  as handle no-undo .
      803      run gbl/getgattrlib.p (output g#attr-lib).
      804   end.
      805   define variable mMRCCode  as logical    no-undo.
      806   define variable mTypeMark as character  no-undo.
      807   method private logical IS-NeedMark
      808   ( input ib-code as integer  ,
      809     input ib-str as character ):
      810      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      811      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      812                                    and buf_prod-bc-attr.b-str  eq ib-str
      813                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      814        no-lock no-error.
      815      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      816   end.
      817   method private character repTegforDm
      818   (iDM as char ):
      819       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      820       define variable vteg as character no-undo.
      821       define variable oDM as character no-undo.
      822       define variable vi as integer no-undo.
      823       oDM = iDm.
      824       do vi = 1 to num-entries(vTeglist):
      825          vTeg = entry(vi,vTeglist).
      826          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      827       end.
      828       return oDM.
      829   end.
      830   method private character repSpecSimbforDm
      831   (iDM as char ):
      832       define variable oDM as character no-undo.
      833       xmlchar-decode(iDM, output oDM).
      834     return repTegforDm (oDM).
      835   end.
      836   method private logical CheckGtin
      837   (iGtin as char):
      838      define variable bar_code as character no-undo.
      839      define variable vGtin as logical no-undo init "yes".
      840      if length(iGtin) eq 14
      841      then do:
      842         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      843         run str/chk-sum.p
      844          (input-output bar_code ) no-error .
      845         if iGtin ne  bar_code
      846         then
      847            vGtin = no.
      848      end.
      849      else
      850         vGtin = no.
      851      return vgtin.
      852   end.
      853   method private character repSpecSimbforXlm
      854   (iDM as char ):
      855       iDM = replace(iDM,chr(29),"").
      856       return iDM.
      857   end.
      858   method private character getGtinByDM
      859   (IDM as char):
      860      define variable VTXT as char no-undo.
      861      define variable vGtin as char no-undo.
      862      vTXt = IdM.
      863      vGtin = IDM.
      864      if    length(vtxt) > 14
      865      then do:
      866         if   vtxt begins "(01)"
      867                or vtxt begins "(02)"
      868         then
      869            vGtin = substring(vtxt,5,14).
      870         else if   (vtxt begins "01"
      871                or vtxt begins "02" )
      872                and (   (    substring(iDm,17,2) eq "21"
      873                         and length(vtxt) >= 21)
      874                     or substring(iDm,17,2) eq "37"
      875                     or substring(iDm,17,4) eq "(37)" )
      876         then do:
      877            vGtin = substring(vtxt,3,14).
      878            if not checkGtin(vGtin)
      879            then
      880               vGtin = substring(vtxt,1,14).
      881         end.
      882         else if     length(vtxt) eq 14 + 7 + 4 + 4
      883             or length(vtxt) eq 14 + 7 + 4
      884             or length(vtxt) eq 14 + 7
      885         then
      886            vGtin = substring(vtxt,1,14).
      887      end.
      888      if not checkGtin(vGtin)
      889      then
      890         vGtin = "".
      891      return vgtin.
      892   end.
      893   method private integer getGdsCodeByGtin
      894   (iGtin as char):
      895      define buffer prod-bc  for ub.prod-bc.
      896      define buffer bar-code for ub.bar-code.
      897      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      898      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      899      return if avail bar-code then bar-code.gds-code else ?.
      900   end.
      901   method private decimal getQntyCodeByGtin
      902   (iGtin as char):
      903      define buffer prod-bc  for ub.prod-bc.
      904      define buffer bar-code for ub.bar-code.
      905      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      906      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      907      return if avail bar-code then bar-code.cli-base-rate else ?.
      908   end.
      909   method private integer getGdsCodeByDM
      910   (iDm as char):
      911      define variable vGtin as char no-undo.
      912      define buffer prod-bc for ub.prod-bc.
      913      vGtin  = getGtinByDM (IDM ).
      914      return getGdsCodeByGtin (vGtin).
      915   end.
      916   method private logical ChekTypeMarkByGds
      917   (iGds-code as integer ):
      918      define buffer goods-attr for ub.goods-attr.
      919      find first goods-attr where goods-attr.gds-code   = iGds-code
      920                              and goods-attr.attr-code  = 'mark-type':U
      921      no-lock no-error.
      922      if available goods-attr
      923      then do:
      924         mTypeMark = goods-attr.attr-value.
      925         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      926           .
      927      end.
      928      else
      929         return no.
      930   end.
      931   method private logical ChekTypeMarkByDm
      932   (iDM as char ):
      933      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      934   end.
      935   method private logical ChekTypeMarkByGtin
      936   (iGtin as char ):
      937      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      938   end.
      939   method private character  GetNextElement
      940     (input iAllTeg        as logical
      941     ,output oteg          as character
      942     ,output otegval       as character
      943     ,input-output pstr    as character
      944      ):
      945        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      946        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      947        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      948        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      949        define variable vTeg as character no-undo.
      950        define variable vLength as integer no-undo.
      951        define variable vi as integer no-undo.
      952        define variable vj as integer no-undo.
      953        define buffer code for ub.code.
      954        find first code where Code.parent eq "MarkType"
      955                          and Code.CodeValue   eq mTypeMark
      956                          no-lock no-error.
      957        if     available code
      958           and Code.misc1 ne ""
      959           and Code.misc1 ne ?
      960        then do:
      961           integer (Code.misc1) no-error.
      962           if not error-status:error
      963           then
      964             entry (4,vlistleng) = Code.misc1.
      965        end.
      966        if iAllTeg
      967        then
      968           assign
      969              vlistElem     = vlistElem    + vlistElemDop
      970              vlistleng     = vlistleng    + vlistlengDop
      971           .
      972        else if mMRCCode
      973        then
      974           assign
      975              vlistElem     = vlistElem    + ",(8005),8005"
      976              vlistleng     = vlistleng    + ",000006,0006"
      977           .
      978       block-elem:
      979       do vi = 1 to num-entries(vlistElem):
      980          vTeg = entry(vi,vlistElem).
      981          if pstr begins vTeg
      982          then do:
      983             if    vTeg eq "21"
      984             then
      985                vLength = index(pstr,chr(29)) - 2 no-error.
      986             if vLength  <= 0
      987             then
      988                vLength = int(entry(vi,vlistleng)).
      989             otegval = substring (pstr,length(vteg) + 1, vLength).
      990             oteg = replace(replace(vteg,")",""),"(","").
      991             vTeg = vteg + otegval.
      992             otegval = replace(otegval,chr(29),"").
      993             oteg = replace(replace(oteg,")",""),"(","").
      994             pstr = substring (pstr,length(vTeg)+ 1).
      995             vTeg = replace(vTeg,chr(29),"").
      996             leave block-elem.
      997          end.
      998          else
      999             vTeg = "".
     1000       end.
     1001       return vteg.
     1002   end.
     1003   method private character  GetCodeIdent
     1004   (iDm as char):
     1005      define variable Velement   as character no-undo init "first".
     1006      define variable oCodeIdent as character no-undo.
     1007      define variable vteg as character no-undo.
     1008      define variable vtegval as character no-undo.
     1009      define variable vGtin as character no-undo.
     1010      define buffer marking for ub.marking.
     1011      for first marking no-lock where
     1012                marking.mark eq iDm
     1013            and marking.unit-ext = "LEVEL2"
     1014      :
     1015        return iDm.
     1016      end.
     1017      vGtin  = getGtinByDM (iDm ).
     1018      ChekTypeMarkByDm(idm).
     1019      if iDm begins 'tech_':U
     1020      then
     1021         oCodeIdent = iDm.
     1022      else if length(iDm) < 21
     1023      then do:
     1024         find first marking where marking.mark eq idm
     1025         no-lock no-error.
     1026         oCodeIdent = if available marking then marking.mark else  ?.
     1027      end.
     1028      else if     length(iDm) eq 29
     1029         and not iDm begins "01"
     1030         and not iDm begins "02"
     1031      then
     1032         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1033      else  if     length(iDm) >= 24
     1034               and (  iDm begins "01"
     1035                   or iDm begins "02")
     1036               and  substring(iDm,17,2) ne "21"
     1037      then do:
     1038         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1039                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1040         then
     1041            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1042         else
     1043            oCodeIdent = iDM.
     1044      end.
     1045      else  if     (   length(iDm) eq 25
     1046                    or length(iDm) eq 21)
     1047               and (not iDm begins "01"
     1048               and  not iDm begins "02")
     1049      then
     1050         oCodeIdent = substring(iDm,1,21).
     1051      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1052      then
     1053         oCodeIdent = substring(iDm,1,21).
     1054      else do while Velement ne "" and idm ne "":
     1055         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1056         oCodeIdent = oCodeIdent + Velement.
     1057      end.
     1058      return oCodeIdent.
     1059   end.
     1060   method private character  GetTegCod
     1061   (icodeIdent as char, iTeg as char):
     1062      define variable Velement   as character no-undo init "first".
     1063      define variable oTeg as character no-undo init ?.
     1064      define variable vteg as character no-undo.
     1065      define variable vtegval as character no-undo.
     1066      if     ((length(icodeIdent) eq 21
     1067         and not icodeIdent begins "01"
     1068         and not icodeIdent begins "02")
     1069         or
     1070             ( length(icodeIdent) eq 25
     1071               and not icodeIdent begins "01"
     1072               and not icodeIdent begins "02"))
     1073      then do:
     1074         if iTeg eq "01" or iTeg eq "02"
     1075         then
     1076            oTeg = substring(icodeIdent,1,21).
     1077         else  if  iTeg eq "21"
     1078         then
     1079            oTeg = substring(icodeIdent,15,7).
     1080      end.
     1081      else do:
     1082         ChekTypeMarkByDm(icodeIdent).
     1083         block-teg:
     1084            do while Velement ne "" and icodeIdent ne "":
     1085            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1086            if    Velement begins iTeg
     1087               or Velement begins "(" + iTeg + ")"
     1088            then do:
     1089               oTeg = vtegval.
     1090               leave block-teg.
     1091            end.
     1092         end.
     1093      end.
     1094      return oTeg.
     1095   end.
     1096   method private logical isOAD
     1097   (icodeIdent as character):
     1098      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1099   end.
     1100   method private logical isMark
     1101   (icodeIdent as character):
     1102      define buffer buf_marking for ub.marking.
     1103      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1104             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1105   end.
     1106   method private character  addBracketForCode
     1107   (icodeIdent as char):
     1108      define variable Velement   as character no-undo init "first".
     1109      define variable oTeg as character no-undo.
     1110      define variable vteg as character no-undo.
     1111      define variable vtegval as character no-undo.
     1112      define buffer marking for ub.marking.
     1113      find first marking no-lock where
     1114                 marking.mark begins icodeIdent no-error.
     1115      if    not ChekTypeMarkByDm(icodeIdent)
     1116         or length(icodeIdent) le 24
     1117         or (avail marking and marking.unit-ext = "LEVEL2")
     1118      then
     1119         oTeg = icodeIdent.
     1120      else do:
     1121         if (  icodeIdent begins "01"
     1122            or icodeIdent begins "02"
     1123            ) and CheckGtin(substring (icodeIdent,3,14))
     1124            and substring (icodeIdent,17,2) eq "21"
     1125         then do:
     1126            mMRCCode = yes.
     1127            ChekTypeMarkByDm(icodeIdent).
     1128            block-teg:
     1129            do while Velement ne "" and icodeIdent ne "":
     1130               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1131               if vteg ne ""
     1132               then
     1133                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1134            end.
     1135            mMRCCode = no.
     1136         end.
     1137         else do:
     1138            oTeg = icodeIdent.
     1139         end.
     1140      end.
     1141      return oTeg.
     1142   end.
     1143   method private integer getlevelByCodId
     1144   (iCode as char):
     1145      define variable vLength as int no-undo.
     1146      define variable vLevel  as int no-undo.
     1147      if not ChekTypeMarkByDM (icode) then return ?.
     1148      vLength = length(iCode).
     1149      if    vLength eq 18
     1150         or vLength eq 20
     1151      then
     1152         Vlevel = 4.
     1153      else if vLength eq 21
     1154      then
     1155         Vlevel = 1.
     1156      else if vLength eq 25
     1157      then do:
     1158         if  iCode begins "01"
     1159         then
     1160            Vlevel = 3.
     1161         else
     1162            Vlevel = 1.
     1163      end.
     1164      else if     vLength >= 26
     1165              and vLength <= 46
     1166      then do:
     1167         if    substring(iCode,17,2) eq "11"
     1168            or substring(iCode,17,2) eq "13"
     1169            or (    substring(iCode,17,2) eq "21"
     1170                and vLength >= 33
     1171                and substring(iCode,26,4) ne "8005")
     1172         then
     1173            Vlevel = 4.
     1174         else if    vLength eq 31
     1175                 or vLength eq 38
     1176                 or vLength eq 39
     1177                 or vLength eq 45
     1178         then
     1179            Vlevel = 1.
     1180         else if    vLength eq 35
     1181                 or vLength eq 43
     1182         then
     1183            Vlevel = 3.
     1184         else
     1185            Vlevel = ?.
     1186      end.
     1187      else
     1188         Vlevel = ?.
     1189      return Vlevel.
     1190   end.
     1191   method private character  getLevelMotpBycodid
     1192   (iDm as char):
     1193      define variable vLevel as integer no-undo.
     1194      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1195      vLevel = getlevelByCodId(iDm).
     1196      if    vLevel eq ?
     1197         or vLevel < 1
     1198         or vLevel > 6
     1199      then
     1200         return ?.
     1201      else
     1202         return entry(vlevel,vList).
     1203   end.
     1204   method private character    getLevelUTDByLevelMotp
     1205   (iUnit as char):
     1206      define variable vLevel as integer no-undo.
     1207      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1208      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1209      vLevel = lookup(iUnit,vListMOTP).
     1210      if    vLevel eq ?
     1211         or vLevel < 1
     1212         or vLevel > 4
     1213      then
     1214         return ?.
     1215      else
     1216         return entry(vlevel,vListutd).
     1217   end.
     1218   method private character  getLevelMotpByDM
     1219   (iDm as char):
     1220      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1221   end.
     1222   method private character  getLevelUTDByCodId
     1223   (iDm as char):
     1224      define variable vLevel as integer no-undo.
     1225      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1226      vLevel = getlevelByCodId(iDm).
     1227      if    vLevel eq ?
     1228         or vLevel < 1
     1229         or vLevel > 4
     1230      then
     1231         return ?.
     1232      else
     1233         return entry(vlevel,vList).
     1234   end.
     1235   method private character  getLevelUTDByDM
     1236   (iDm as char):
     1237      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1238   end.
     1239   define variable mNotMarkQnty as logical no-undo.
     1240   method private decimal getQntyUTDByCodId
     1241   (iDM as char):
     1242      define variable vLevel as integer no-undo.
     1243      define variable vList as character no-undo init "1,5,10,500".
     1244      define variable vGtin as character no-undo.
     1245      define variable vqnty as decimal no-undo init ?.
     1246      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1247      if vqnty eq ?
     1248      then do:
     1249         if not mNotMarkQnty
     1250         then do:
     1251            define buffer marking for ub.marking.
     1252            define variable vCodident as character no-undo.
     1253            vCodident = GetCodeIdent(idm).
     1254            find first marking where marking.mark begins vCodident no-lock no-error.
     1255            if     available marking
     1256               and marking.box-qnty ne ?
     1257            then
     1258               return marking.box-qnty.
     1259         end.
     1260         vGtin = getGtinByDm(iDM).
     1261         if ChekTypeMarkByGtin (vGtin)
     1262         then do:
     1263            vLevel = getlevelByCodId(iDM).
     1264            if     vLevel >= 1
     1265               and vLevel <= 4
     1266            then
     1267               vqnty = int(entry(vlevel,vList)).
     1268         end.
     1269         else
     1270            vqnty = getQntyCodeByGtin(vgtin).
     1271      end.
     1272      return vqnty.
     1273   end.
     1274   method private decimal getQntyUTDByDM
     1275   (iDm as char):
     1276      define variable vDM as character no-undo.
     1277      if     length (iDm) ne 25
     1278         and length (iDm) ne 29
     1279         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1280      then
     1281         vDM = substring (iDm,1,length (iDm) - 6 ).
     1282      else
     1283         vDM = substring (iDm,1,length (iDm) - 4 ).
     1284      return getQntyUTDByCodId(vDM).
     1285   end.
     1286   method private decimal    getMRC4
     1287   (iMRC as char):
     1288      define variable oMrc     as decimal no-undo init ?.
     1289      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1290      define variable vi       as integer no-undo.
     1291      define variable vfound   as integer no-undo.
     1292      define variable vposStart   as integer no-undo.
     1293      do:
     1294      OMRc = 0.
     1295      do vi = 1 to 4:
     1296         define variable vsimb as character no-undo.
     1297         vsimb = substring(iMRC,vi,1).
     1298         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1299         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1300         if vfound > 0
     1301         then
     1302            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1303         end.
     1304         OMRc = OMRc / 100.
     1305      end.
     1306      return OMRc.
     1307   end.
     1308   method private decimal    getMRCByDM
     1309   (iDm as char):
     1310      define variable vMRC     as character no-undo.
     1311      define variable oMrc     as decimal no-undo init ?.
     1312      define variable Velement as character no-undo init "empty".
     1313      define variable vteg as character no-undo.
     1314      define variable vtegval as character no-undo.
     1315      if    length(idm) eq 14 + 7 + 4 + 4
     1316         or length(idm) eq 14 + 7 + 4
     1317      then do:
     1318         vMRC = substring(idm,22,4).
     1319         omrc = getMRC4(vMRC).
     1320      end.
     1321      else do:
     1322          ChekTypeMarkByDm(iDm).
     1323          block-mrc:
     1324          do while Velement ne "" and idm ne "":
     1325             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1326             if Velement begins "8005"
     1327             then do:
     1328                vMRC = substring(Velement,5,6).
     1329                leave block-mrc.
     1330             end.
     1331             else if Velement begins "(8005)"
     1332             then do:
     1333                vMRC = substring(Velement,7,6).
     1334                leave block-mrc.
     1335             end.
     1336          end.
     1337          if vMRC ne ""
     1338          then
     1339             OMRc = dec(vmrc) / 100 no-error.
     1340      end.
     1341      return OMRc.
     1342   end.
     1343   method private date    MoveDate
     1344   (idate as date,
     1345    iMonth as int64):
     1346      define variable vMonth   as int64 no-undo.
     1347      define variable vYear    as int64 no-undo.
     1348      define variable vDateNew as date  no-undo.
     1349       define variable vDay     as int64 no-undo.
     1350       vMonth = month(iDate) + iMonth.
     1351       vYear =  year(iDate).
     1352       if vMonth <= 0
     1353       then assign
     1354          vMonth = vMonth + 12
     1355           vYear  = vYear - 1
     1356       .
     1357       else if vMonth > 12
     1358       then assign
     1359          vMonth = vMonth - 12
     1360           vYear  = vYear + 1
     1361       .
     1362       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1363       do while error-status:error eq yes:
     1364          VDay = vDay + 1.
     1365          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1366       end.
     1367       if VDay > 0
     1368       then
     1369          vDateNew + 1.
     1370       return vDateNew.
     1371   end.
     1372   method private logical    checkEMRC
     1373   (input  iDm as char,
     1374    output vOk as logical):
     1375      define variable v-value-emrc as character no-undo.
     1376      define variable v-type-emrc  as character no-undo.
     1377      define variable vDateIso     as character no-undo.
     1378      define variable vMRC         as decimal no-undo.
     1379      define variable vqnty        as decimal no-undo.
     1380      define variable vPrice       as decimal no-undo.
     1381      define variable vparent      as character no-undo.
     1382      define variable vgds-code    as integer no-undo.
     1383      define buffer code for ub.code.
     1384      vMRC = getMRCByDM(iDm).
     1385      if vMRC > 0
     1386      then do:
     1387         vgds-code = getGdsCodeByDM(iDm).
     1388         vqnty     = getQntyUTDByDM(iDm).
     1389               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1390            (
     1391             input   vgds-code
     1392            ,input   'emrc-type':U
     1393            ,output   v-value-emrc
     1394            ,output   v-type-emrc
     1395          ) no-error.
     1396          if     v-value-emrc ne ""
     1397             and v-value-emrc ne ?
     1398          then do:
     1399             vDateIso = iso-date(today).
     1400             vPrice = vMRC / vqnty.
     1401             vparent ="emc" + chr(4) + v-value-emrc.
     1402             find last code where Code.parent      eq vparent
     1403                              and Code.code        le vDateIso
     1404                              and code.status_  eq 0
     1405             no-lock no-error.
     1406             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1407             then
     1408                vOk = true .
     1409             else do:
     1410                 define variable vText      as character no-undo.
     1411                 define variable vDate      as date no-undo.
     1412                 define variable vDateLast  as character no-undo.
     1413                 define variable vDateFirst as character no-undo.
     1414                 define variable vDate3     as date no-undo.
     1415                 vdate = date(code.misc1).
     1416                 vDateLast = code.misc1.
     1417                 vDate3 = MoveDate(today, - 3 ).
     1418                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1419                                      string(vDate3  , "99/99/9999"),
     1420                                      string(vDate   , "99/99/9999")
     1421                                      ).
     1422                 vdateIso = iso-date(vdate3).
     1423                 find last code  where Code.parent      eq vparent
     1424                                   and Code.code        le vDateIso
     1425                                   and code.status_  eq 0 no-lock no-error.
     1426                 if available code
     1427                 then
     1428                    vDateIso = code.code.
     1429                 vDateFirst = vDateIso.
     1430                 vDateLast = iso-date(vdate).
     1431                 define variable vGood as logical no-undo.
     1432                 define variable vDateSale as date no-undo.
     1433                 define buffer bcode for code.
     1434                 for last code where Code.parent   eq vparent
     1435                                 and code.status_  eq 0
     1436                                 and code.code     < vDateLast
     1437                                 and code.code     >= vDateFirst
     1438                 no-lock:
     1439                    find first bcode where bCode.parent   eq vparent
     1440                                       and bcode.status_  eq 0
     1441                                       and bcode.code     > code.code no-lock no-error.
     1442                    if available bcode
     1443                    then do:
     1444                       if vPrice < dec(Code.CodeValue)
     1445                       then
     1446                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1447                                                     chr(10),
     1448                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1449                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1450                                                     ).
     1451                       else do:
     1452                          vGood = yes.
     1453                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1454                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1455                                                     chr(10),
     1456                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1457                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1458                                                     string(         vDateSale            ,"99/99/9999"),
     1459                                                     string(vDateSale - today)
     1460                                                     ).
     1461                       end.
     1462                    end.
     1463                 end.
     1464                 if vgood
     1465                 then do:
     1466                    define variable choice as integer no-undo .
     1467                    run gbl/d-askw.w (input "Уточнение"
     1468                           ,input  vText
     1469                           ,input "|"
     1470                           ,input "Принять|Вернуть"
     1471                           ,input "Принять данный товар|Вернуть товар постащику"
     1472                           ,input 1
     1473                           ,input 2
     1474                           ,output choice) no-error.
     1475                    vok = choice eq 1.
     1476                 end.
     1477                 else
     1478                    vok =false.
     1479             end.
     1480          end.
     1481      end.
     1482   end.
     1483   method private character addGs2Mark
     1484   (iMark as char):
     1485      define variable vDM   as character no-undo.
     1486      define variable vIdx  as integer   no-undo.
     1487      if index(iMark,chr(29),1) > 0
     1488      then return iMark.
     1489      if substring(iMark,26,4) = "8005" then
     1490      do:
     1491        vIdx = index(iMark,"93",26 + 4 + 5).
     1492        if vIdx > 1 then do:
     1493          vDM = substitute("&1&4&2&4&3",
     1494                           substring(iMark,1,25),
     1495                           substring(iMark,26,vIdx - 25 - 1),
     1496                           substring(iMark,vIdx),
     1497                           chr(29)) no-error.
     1498          vIdx = index(vDm,"240",vIdx + 4).
     1499          if vIdx > 0 then
     1500          do:
     1501            vDM = substitute("&1&3&2",
     1502                             substring(vDm,1,vIdx - 1),
     1503                             substring(vDm,vIdx),
     1504                             chr(29)) no-error.
     1505          end.
     1506        end.
     1507        else
     1508          vDM = substitute("&1&3&2",
     1509                           substring(iMark,1,25),
     1510                           substring(iMark,26),
     1511                           chr(29)) no-error.
     1512      end.
     1513      else if substring(iMark,32,2) = "91" then
     1514      do:
     1515        vIdx = index(iMark,"92",32).
     1516        if vIdx > 1 then
     1517          vDM = substitute("&1&4&2&4&3",
     1518                           substring(iMark,1,31),
     1519                           substring(iMark,32,vIdx - 31 - 1),
     1520                           substring(iMark,vIdx),
     1521                           chr(29)) no-error.
     1522        else
     1523          vDM = substitute("&1&3&2",
     1524                           substring(iMark,1,31),
     1525                           substring(iMark,32),
     1526                           chr(29)) no-error.
     1527      end.
     1528      else if substring(iMark,39,2) = "91" then
     1529      do:
     1530        vIdx = index(iMark,"92",38).
     1531        if vIdx > 1 then
     1532          vDM = substitute("&1&4&2&4&3",
     1533                           substring(iMark,1,38),
     1534                           substring(iMark,39,vIdx - 38 - 1),
     1535                           substring(iMark,vIdx),
     1536                           chr(29)) no-error.
     1537        else
     1538          vDM = substitute("&1&3&2",
     1539                           substring(iMark,1,38),
     1540                           substring(iMark,39),
     1541                           chr(29)) no-error.
     1542      end.
     1543      else if substring(iMark,25,2) = "93" then
     1544      do:
     1545        vIdx = index(iMark,"92",25).
     1546        if vIdx > 1 then
     1547          vDM = substitute("&1&4&2&4&3",
     1548                           substring(iMark,1,24),
     1549                           substring(iMark,25,vIdx - 24 - 1),
     1550                           substring(iMark,vIdx),
     1551                           chr(29)) no-error.
     1552        else
     1553          vIdx = index(iMark,"3103",25).
     1554          if vIdx > 0 then
     1555          vDM = substitute("&1&4&2&4&3",
     1556                           substring(iMark,1,24),
     1557                           substring(iMark,25,vIdx - 24 - 1),
     1558                           substring(iMark,vIdx),
     1559                           chr(29)) no-error.
     1560          else
     1561            vDM = substitute("&1&3&2",
     1562                             substring(iMark,1,24),
     1563                             substring(iMark,25),
     1564                             chr(29)) no-error.
     1565      end.
     1566      else if substring(iMark,32,2) = "93" then
     1567      do:
     1568        vDM = substitute("&1&3&2",
     1569              substring(iMark,1,31),
     1570              substring(iMark,32),
     1571              chr(29)) no-error.
     1572      end.
     1573      return if vDM <> "" then vDm else iMark.
     1574   end.
     1575   end class.
