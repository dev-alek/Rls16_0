        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.map.mapstring.
        4   using ibs.th.gbl.sys.objth.
        5   using ibs.th.gbl.sys.objsrv.
        6   using ibs.th.gbl.TypeMap.
        7   block-level on error undo, throw.
        8   class ibs.th.str.order.sts.order inherits TypeMap:
        9     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       10     define override public property vss-author      as character no-undo init "$Author:$":U get.
       11     define override public property vss-date        as character no-undo init "$Date:$":U get.
       12     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       13     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       14     define override public property vss-description as character no-undo init "Статусы ЭДО в TH" get.
       15     define public property  NewStatus         as class propmap no-undo get.  protected set.
       16     define public property  Sended            as class propmap no-undo get.  protected set.
       17     define public property  ReceivedProvider  as class propmap no-undo get.  protected set.
       18     define public property  Shipment          as class propmap no-undo get.  protected set.
       19     define public property  Corrected         as class propmap no-undo get.  protected set.
       20     define public property  Cancelled         as class propmap no-undo get.  protected set.
       21     define public property  DeliveryWaiting   as class propmap no-undo get.  protected set.
       22     define public property  DeliveryCompleted as class propmap no-undo get.  protected set.
       23     constructor public order ():
       24       super().
       25       NewStatus  = crProp(1, "NewStatus", "Новый").
       26       Sended     = crProp(2, "Sended", "Отправлен").
       27       Shipment   = crProp(3, "Shipment", "Подтвержден").
       28       Corrected  = crProp(4, "Corrected", "Изменен").
       29       Cancelled  = crProp(5, "Cancelled", "Отклонен").
       30       DeliveryWaiting   = crProp(6,"DeliveryWaiting","Ожидает поставку").
       31       DeliveryCompleted = crProp(7,"DeliveryCompleted","Завершен").
       32       ReceivedProvider  = crProp(8, "ReceivedProvider", "Получен поставщиком").
       33     end.
       34     method public logical CheckStsErr(inKey as int):
       35       if NewStatus:KeyIntDB           = inKey
       36         or Sended:KeyIntDB            = inKey
       37         or ReceivedProvider:KeyIntDB  = inKey
       38         or Shipment:KeyIntDB          = inKey
       39         or Corrected:KeyIntDB         = inKey
       40         or Cancelled:KeyIntDB         = inKey
       41         or DeliveryWaiting:KeyIntDB   = inKey
       42         or DeliveryCompleted:KeyIntDB = inKey
       43         then return true.
       44         else return false.
       45     end method.
       46   end class.
