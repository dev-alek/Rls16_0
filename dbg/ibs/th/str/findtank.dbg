        1   using Progress.Lang.*.
        2   class ibs.th.str.findtank:
        3     define property ReturnMsg as character no-undo
        4       get.
        5       private set.
        6     define variable hndl-proc-key-rec as handle no-undo.
        7     constructor public findtank ():
        8       run str/findtank.p persistent set hndl-proc-key-rec .
        9     end constructor.
       10     destructor public findtank ():
       11       delete object hndl-proc-key-rec .
       12     end destructor.
       13     method public void findtank_ (
       14       input p-obj-type     as character,
       15       input p-obj-code     as integer,
       16       input p-pump-code    as integer,
       17       input p-nozzle-code  as integer,
       18       input p-from-pl-code as integer,
       19       input p-gds-code     as integer,
       20      output p-pl-code      as integer ):
       21       run findtank in hndl-proc-key-rec
       22         (input p-obj-type
       23         ,input p-obj-code
       24         ,input p-pump-code
       25         ,input p-nozzle-code
       26         ,input p-from-pl-code
       27         ,input p-gds-code
       28         ,output p-pl-code
       29         ) .
       30     end method.
       31   end class.
