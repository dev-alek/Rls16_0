        1   using Progress.Lang.*.
        2   using ibs.th.str.utd.sts.*.
        3   using ibs.th.str.marking.sts.*.
        4   using ibs.th.gbl.sys.objth.
        5   block-level on error undo, throw.
        6   class ibs.th.str.utd.sts inherits objth:
        7       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8       define override public property vss-author      as character no-undo init "$Author:$":U get.
        9       define override public property vss-date        as character no-undo init "$Date:$":U get.
       10       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12       define override public property vss-description as character no-undo init "Статусы электронных документов" get.
       13     define public property EDI as class edi no-undo
       14       get.
       15       protected set.
       16     define public property TH as class th no-undo
       17       get.
       18       protected set.
       19     define public property Receipt as class receipt no-undo
       20       get.
       21       protected set.
       22     define public property Direction as class direction no-undo
       23       get.
       24       protected set.
       25     constructor public sts (  ):
       26       super ().
       27   EDI = new edi ().
       28   ObjSrv:Regobj(this-object,EDI,
       29   "EDI"
       30   ) .
       31   TH = new th ().
       32   ObjSrv:Regobj(this-object,TH,
       33   "TH"
       34   ) .
       35   Receipt = new receipt ().
       36   ObjSrv:Regobj(this-object,Receipt,
       37   "Receipt"
       38   ) .
       39   Direction = new direction ().
       40   ObjSrv:Regobj(this-object,Direction,
       41   "Direction"
       42   ) .
       43     end constructor.
       44   end class.
