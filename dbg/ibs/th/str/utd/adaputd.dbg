      122   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   function getattrUtdex returns char
      124   (idb-num   as integer,
      125    idoc-id   as integer,
      126    iattrcode as character,
      127    iExValue  as character  ):
      128      define buffer utd-attr for utd-attr.
      129      find first utd-attr where utd-attr.db-num eq idb-num
      130                            and utd-attr.doc-id eq idoc-id
      131                            and utd-attr.attr-code eq iattrcode
      132      no-lock no-error.
      133      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      134   end.
      135   function getattrUtd returns char
      136   (idb-num   as integer,
      137    idoc-id   as integer,
      138    iattrcode as character ):
      139     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      140   end.
      141   function setattrUtd returns logical
      142   (idb-num   as integer,
      143    idoc-id   as integer,
      144    iattrcode as character,
      145    iattrval  as character ):
      146      define buffer utd-attr for utd-attr.
      147      find first utd-attr where utd-attr.db-num eq idb-num
      148                            and utd-attr.doc-id eq idoc-id
      149                            and utd-attr.attr-code eq iattrcode
      150      no-lock no-error.
      151      if not available utd-attr
      152      then do:
      153         create utd-attr.
      154         assign
      155            utd-attr.db-num    = idb-num
      156            utd-attr.doc-id    = idoc-id
      157            utd-attr.attr-code = iattrcode
      158            utd-attr.attr-value = iattrval
      159         .
      160      end.
      161      else do:
      162         if utd-attr.attr-value ne iattrval
      163         then do:
      164            find current utd-attr exclusive-lock no-error.
      165            if available utd-attr
      166            then
      167               utd-attr.attr-value = iattrval.
      168         end.
      169      end.
      170      release utd-attr.
      171   end.
      172   function GetAttrUtdlinesEx returns char
      173   (idb-num   as integer,
      174    idoc-id   as integer,
      175    ilinenum  as integer,
      176    iattrcode as character,
      177    iExValue  as character  ):
      178      define buffer utd-lines-attr for utd-lines-attr.
      179      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      180                                  and utd-lines-attr.doc-id    eq idoc-id
      181                                  and utd-lines-attr.lineNum   eq ilineNum
      182                                  and utd-lines-attr.attr-code eq iattrcode
      183      no-lock no-error.
      184      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      185   end.
      186   function GetAttrUtdlines returns char
      187   (idb-num   as integer,
      188    idoc-id   as integer,
      189    ilinenum  as integer,
      190    iattrcode as character ):
      191      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      192   end.
      193   function setattrUtdlines returns logical
      194   (idb-num   as integer,
      195    idoc-id   as integer,
      196    ilinenum  as integer,
      197    iattrcode as character,
      198    iattrval  as character ):
      199      define buffer utd-lines-attr for utd-lines-attr.
      200      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      201                                  and utd-lines-attr.doc-id    eq idoc-id
      202                                  and utd-lines-attr.lineNum   eq ilineNum
      203                                  and utd-lines-attr.attr-code eq iattrcode
      204      no-lock no-error.
      205      if not available utd-lines-attr
      206      then do:
      207         if iattrval ne ?
      208            and iattrval ne ""
      209         then do:
      210            create utd-lines-attr.
      211            assign
      212               utd-lines-attr.db-num    = idb-num
      213               utd-lines-attr.doc-id    = idoc-id
      214               utd-lines-attr.lineNum   = ilineNum
      215               utd-lines-attr.attr-code = iattrcode
      216               utd-lines-attr.attr-value = iattrval
      217            .
      218         end.
      219      end.
      220      else do:
      221         if utd-lines-attr.attr-value ne iattrval
      222         then do:
      223            find current utd-lines-attr exclusive-lock no-error.
      224            if available utd-lines-attr
      225            then do:
      226               if    iattrval eq ?
      227                  or iattrval eq ""
      228               then do:
      229                  delete utd-lines-attr.
      230               end.
      231               else do:
      232                  utd-lines-attr.attr-value = iattrval.
      233               end.
      234            end.
      235         end.
      236      end.
      237      release utd-lines-attr.
      238   end.
      239   function GetAttrUtdMarkingLinesEx returns char
      240   (idb-num   as integer,
      241    idoc-id   as integer,
      242    ilinenum  as integer,
      243    imark     as character,
      244    iattrcode as character,
      245    iExValue  as character  ):
      246      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      247      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      248                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      249                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      250                                          and utd-marking-lines-attr.mark      eq imark
      251                                          and utd-marking-lines-attr.attr-code eq iattrcode
      252      no-lock no-error.
      253      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      254   end.
      255   function GetAttrUtdMarkingLines returns char
      256   (idb-num   as integer,
      257    idoc-id   as integer,
      258    ilinenum  as integer,
      259    imark     as character,
      260    iattrcode as character ):
      261      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      262   end.
      263   function setattrUtdMarkingLines returns logical
      264   (idb-num   as integer,
      265    idoc-id   as integer,
      266    ilinenum  as integer,
      267    imark     as character,
      268    iattrcode as character,
      269    iattrval  as character ):
      270      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      271      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      272                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      273                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      274                                          and utd-marking-lines-attr.mark      eq imark
      275                                          and utd-marking-lines-attr.attr-code eq iattrcode
      276      no-lock no-error.
      277      if not available utd-marking-lines-attr
      278      then do:
      279         if iattrval ne ?
      280            and iattrval ne ""
      281         then do:
      282            create utd-marking-lines-attr.
      283            assign
      284               utd-marking-lines-attr.db-num     = idb-num
      285               utd-marking-lines-attr.doc-id     = idoc-id
      286               utd-marking-lines-attr.lineNum    = ilineNum
      287               utd-marking-lines-attr.mark       = imark
      288               utd-marking-lines-attr.attr-code  = iattrcode
      289               utd-marking-lines-attr.attr-value = iattrval
      290            .
      291         end.
      292      end.
      293      else do:
      294         if utd-marking-lines-attr.attr-value ne iattrval
      295         then do:
      296            find current utd-marking-lines-attr exclusive-lock no-error.
      297            if available utd-marking-lines-attr
      298            then do:
      299               if    iattrval eq ?
      300                  or iattrval eq ""
      301               then do:
      302                  delete utd-marking-lines-attr.
      303               end.
      304               else do:
      305                  utd-marking-lines-attr.attr-value = iattrval.
      306               end.
      307            end.
      308         end.
      309      end.
      310      release utd-marking-lines-attr.
      311   end.
