      596   procedure xmlchar-decode :
      597   define input parameter p-in-string      as character        no-undo.
      598   define output parameter p-out-string    as character        no-undo.
      599       define variable v-position      as integer      no-undo.
      600       define variable v-last-position as integer      no-undo.
      601       define variable v-temp-integer  as integer      no-undo.
      602       define variable v-current-char  as character    no-undo.
      603       define variable v-next-char     as character    no-undo.
      604       define variable v-success       as logical      no-undo.
      605   do
      606   on error undo, return error
      607   :
      608       assign
      609           p-out-string = "":U
      610           v-position   = 0
      611       .
      612       replace-cycle:
      613       do while yes
      614       on error undo, return error
      615       :
      616           assign
      617               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      618           .
      619           if v-last-position <= v-position
      620           then do:
      621               if v-position = 0
      622               then do:
      623                   assign
      624                       p-out-string = p-in-string
      625                   .
      626               end.
      627               else do:
      628                   assign
      629                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      630                   .
      631               end.
      632               leave replace-cycle.
      633           end.
      634           else do:
      635               assign
      636                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      637                   v-position      = v-last-position
      638                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      639               .
      640               if v-current-char = "#":U
      641               then do:
      642                   assign
      643                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      644                   .
      645                   if v-last-position > 0
      646                   then do:
      647                       run xmlchar-read-integer in this-procedure
      648                        (
      649                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      650                           , output v-temp-integer
      651                           , output v-success
      652                       ).
      653                       if v-success = yes
      654                       and v-temp-integer >= 1
      655                       and v-temp-integer <= 255
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + chr( v-temp-integer )
      659                               v-position   = v-last-position + 1
      660                           .
      661                       end.
      662                       else do:
      663                           assign
      664                               p-out-string = p-out-string + "&":U
      665                               v-position   = v-position   + 1
      666                           .
      667                       end.
      668                   end.
      669                   else do:
      670                       assign
      671                           p-out-string = p-out-string + "&":U
      672                           v-position   = v-position   + 1
      673                       .
      674                   end.
      675               end.
      676               else do:
      677                   case substring( p-in-string, v-position + 1, 3 )
      678                   :
      679                       when "lt;":U
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + "<":U
      683                               v-position   = v-position   + 3
      684                           .
      685                       end.
      686                       when "gt;":U
      687                       then do:
      688                           assign
      689                               p-out-string = p-out-string + ">":U
      690                               v-position   = v-position   + 3
      691                           .
      692                       end.
      693                       otherwise do:
      694                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      695                           then do:
      696                               assign
      697                                   p-out-string = p-out-string + "&":U
      698                                   v-position   = v-position   + 4
      699                               .
      700                           end.
      701                           else do:
      702                               case substring( p-in-string, v-position + 1, 5 )
      703                               :
      704                                   when "quot;":U
      705                                   then do:
      706                                       assign
      707                                           p-out-string = p-out-string + '"':U
      708                                           v-position   = v-position   + 5
      709                                       .
      710                                   end.
      711                                   when "apos;":U
      712                                   then do:
      713                                       assign
      714                                           p-out-string = p-out-string + "'":U
      715                                           v-position   = v-position   + 5
      716                                       .
      717                                   end.
      718                                   otherwise do:
      719                                       assign
      720                                           p-out-string = p-out-string + "&":U
      721                                       .
      722                                   end.
      723                               end case.
      724                           end.
      725                       end.
      726                   end case.
      727               end.
      728           end.
      729       end.
      730   end.
      731   end .
      732   procedure xmlchar-read-integer :
      733   define input parameter p-input-string      as character        no-undo.
      734   define output parameter p-output-integer   as integer          no-undo.
      735   define output parameter p-success       as logical          no-undo.
      736   do
      737   on error undo, return error
      738   :
      739       assign
      740           p-output-integer = integer( p-input-string )
      741       no-error.
      742       if error-status :error
      743       then do:
      744           assign
      745               p-success           = no
      746               p-output-integer    = 0
      747           .
      748       end.
      749       else do:
      750           assign
      751               p-success           = yes
      752           .
      753       end.
      754   end.
      755   end.
      756   define variable mMRCCode  as logical    no-undo.
      757   define variable mTypeMark as character  no-undo.
      758   function IS-NeedMark returns logical
      759   ( input ib-code as integer  ,
      760     input ib-str as character ):
      761      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      762      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      763                                    and buf_prod-bc-attr.b-str  eq ib-str
      764                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      765        no-lock no-error.
      766      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      767   end.
      768   function repTegforDm return char
      769   (iDM as char ):
      770       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      771       define variable vteg as character no-undo.
      772       define variable oDM as character no-undo.
      773       define variable vi as integer no-undo.
      774       oDM = iDm.
      775       do vi = 1 to num-entries(vTeglist):
      776          vTeg = entry(vi,vTeglist).
      777          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      778       end.
      779       return oDM.
      780   end.
      781   function repSpecSimbforDm return char
      782   (iDM as char ):
      783       define variable oDM as character no-undo.
      784     run
      785       xmlchar-decode(iDM, output oDM).
      786     return repTegforDm (oDM).
      787   end.
      788   function CheckGtin return logical
      789   (iGtin as char):
      790      define variable bar_code as character no-undo.
      791      define variable vGtin as logical no-undo init "yes".
      792      if length(iGtin) eq 14
      793      then do:
      794         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      795         run str/chk-sum.p
      796          (input-output bar_code ) no-error .
      797         if iGtin ne  bar_code
      798         then
      799            vGtin = no.
      800      end.
      801      else
      802         vGtin = no.
      803      return vgtin.
      804   end.
      805   function repSpecSimbforXlm return char
      806   (iDM as char ):
      807       iDM = replace(iDM,chr(29),"").
      808       return iDM.
      809   end.
      810   function getGtinByDM return char
      811   (IDM as char):
      812      define variable VTXT as char no-undo.
      813      define variable vGtin as char no-undo.
      814      vTXt = IdM.
      815      vGtin = IDM.
      816      if    length(vtxt) > 14
      817      then do:
      818         if   vtxt begins "(01)"
      819                or vtxt begins "(02)"
      820         then
      821            vGtin = substring(vtxt,5,14).
      822         else if   (vtxt begins "01"
      823                or vtxt begins "02" )
      824                and (   (    substring(iDm,17,2) eq "21"
      825                         and length(vtxt) >= 21)
      826                     or substring(iDm,17,2) eq "37"
      827                     or substring(iDm,17,4) eq "(37)" )
      828         then do:
      829            vGtin = substring(vtxt,3,14).
      830            if not checkGtin(vGtin)
      831            then
      832               vGtin = substring(vtxt,1,14).
      833         end.
      834         else if     length(vtxt) eq 14 + 7 + 4 + 4
      835             or length(vtxt) eq 14 + 7 + 4
      836             or length(vtxt) eq 14 + 7
      837         then
      838            vGtin = substring(vtxt,1,14).
      839      end.
      840      if not checkGtin(vGtin)
      841      then
      842         vGtin = "".
      843      return vgtin.
      844   end.
      845   function getGdsCodeByGtin return int
      846   (iGtin as char):
      847      define buffer prod-bc  for ub.prod-bc.
      848      define buffer bar-code for ub.bar-code.
      849      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      850      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      851      return if avail bar-code then bar-code.gds-code else ?.
      852   end.
      853   function getQntyCodeByGtin return decimal
      854   (iGtin as char):
      855      define buffer prod-bc  for ub.prod-bc.
      856      define buffer bar-code for ub.bar-code.
      857      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      858      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      859      return if avail bar-code then bar-code.cli-base-rate else ?.
      860   end.
      861   function getGdsCodeByDM return int
      862   (iDm as char):
      863      define variable vGtin as char no-undo.
      864      define buffer prod-bc for ub.prod-bc.
      865      vGtin  = getGtinByDM (IDM ).
      866      return getGdsCodeByGtin (vGtin).
      867   end.
      868   function ChekTypeMarkByGds return logical
      869   (iGds-code as integer ):
      870      define buffer goods-attr for ub.goods-attr.
      871      find first goods-attr where goods-attr.gds-code   = iGds-code
      872                              and goods-attr.attr-code  = 'mark-type':U
      873      no-lock no-error.
      874      if available goods-attr
      875      then do:
      876         mTypeMark = goods-attr.attr-value.
      877         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      878           .
      879      end.
      880      else
      881         return no.
      882   end.
      883   function ChekTypeMarkByDm return logical
      884   (iDM as char ):
      885      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      886   end.
      887   function ChekTypeMarkByGtin return logical
      888   (iGtin as char ):
      889      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      890   end.
      891   function GetNextElement return character
      892     (input iAllTeg        as logical
      893     ,output oteg          as character
      894     ,output otegval       as character
      895     ,input-output pstr    as character
      896      ):
      897        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      898        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      899        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      900        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      901        define variable vTeg as character no-undo.
      902        define variable vLength as integer no-undo.
      903        define variable vi as integer no-undo.
      904        define variable vj as integer no-undo.
      905        define buffer code for ub.code.
      906        find first code where Code.parent eq "MarkType"
      907                          and Code.CodeValue   eq mTypeMark
      908                          no-lock no-error.
      909        if     available code
      910           and Code.misc1 ne ""
      911           and Code.misc1 ne ?
      912        then do:
      913           integer (Code.misc1) no-error.
      914           if not error-status:error
      915           then
      916             entry (4,vlistleng) = Code.misc1.
      917        end.
      918        if iAllTeg
      919        then
      920           assign
      921              vlistElem     = vlistElem    + vlistElemDop
      922              vlistleng     = vlistleng    + vlistlengDop
      923           .
      924        else if mMRCCode
      925        then
      926           assign
      927              vlistElem     = vlistElem    + ",(8005),8005"
      928              vlistleng     = vlistleng    + ",000006,0006"
      929           .
      930       block-elem:
      931       do vi = 1 to num-entries(vlistElem):
      932          vTeg = entry(vi,vlistElem).
      933          if pstr begins vTeg
      934          then do:
      935             if    vTeg eq "21"
      936             then
      937                vLength = index(pstr,chr(29)) - 2 no-error.
      938             if vLength  <= 0
      939             then
      940                vLength = int(entry(vi,vlistleng)).
      941             otegval = substring (pstr,length(vteg) + 1, vLength).
      942             oteg = replace(replace(vteg,")",""),"(","").
      943             vTeg = vteg + otegval.
      944             otegval = replace(otegval,chr(29),"").
      945             oteg = replace(replace(oteg,")",""),"(","").
      946             pstr = substring (pstr,length(vTeg)+ 1).
      947             vTeg = replace(vTeg,chr(29),"").
      948             leave block-elem.
      949          end.
      950          else
      951             vTeg = "".
      952       end.
      953       return vteg.
      954   end.
      955   function GetCodeIdent return character
      956   (iDm as char):
      957      define variable Velement   as character no-undo init "first".
      958      define variable oCodeIdent as character no-undo.
      959      define variable vteg as character no-undo.
      960      define variable vtegval as character no-undo.
      961      define variable vGtin as character no-undo.
      962      define buffer marking for ub.marking.
      963      for first marking no-lock where
      964                marking.mark eq iDm
      965            and marking.unit-ext = "LEVEL2"
      966      :
      967        return iDm.
      968      end.
      969      vGtin  = getGtinByDM (iDm ).
      970      ChekTypeMarkByDm(idm).
      971      if iDm begins 'tech_':U
      972      then
      973         oCodeIdent = iDm.
      974      else if length(iDm) < 21
      975      then do:
      976         find first marking where marking.mark eq idm
      977         no-lock no-error.
      978         oCodeIdent = if available marking then marking.mark else  ?.
      979      end.
      980      else if     length(iDm) eq 29
      981         and not iDm begins "01"
      982         and not iDm begins "02"
      983      then
      984         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      985      else  if     length(iDm) >= 24
      986               and (  iDm begins "01"
      987                   or iDm begins "02")
      988               and  substring(iDm,17,2) ne "21"
      989      then do:
      990         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      991                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      992         then
      993            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      994         else
      995            oCodeIdent = iDM.
      996      end.
      997      else  if     (   length(iDm) eq 25
      998                    or length(iDm) eq 21)
      999               and (not iDm begins "01"
     1000               and  not iDm begins "02")
     1001      then
     1002         oCodeIdent = substring(iDm,1,21).
     1003      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1004      then
     1005         oCodeIdent = substring(iDm,1,21).
     1006      else do while Velement ne "" and idm ne "":
     1007         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1008         oCodeIdent = oCodeIdent + Velement.
     1009      end.
     1010      return oCodeIdent.
     1011   end.
     1012   function GetTegCod return character
     1013   (icodeIdent as char, iTeg as char):
     1014      define variable Velement   as character no-undo init "first".
     1015      define variable oTeg as character no-undo init ?.
     1016      define variable vteg as character no-undo.
     1017      define variable vtegval as character no-undo.
     1018      if     ((length(icodeIdent) eq 21
     1019         and not icodeIdent begins "01"
     1020         and not icodeIdent begins "02")
     1021         or
     1022             ( length(icodeIdent) eq 25
     1023               and not icodeIdent begins "01"
     1024               and not icodeIdent begins "02"))
     1025      then do:
     1026         if iTeg eq "01" or iTeg eq "02"
     1027         then
     1028            oTeg = substring(icodeIdent,1,21).
     1029         else  if  iTeg eq "21"
     1030         then
     1031            oTeg = substring(icodeIdent,15,7).
     1032      end.
     1033      else do:
     1034         ChekTypeMarkByDm(icodeIdent).
     1035         block-teg:
     1036            do while Velement ne "" and icodeIdent ne "":
     1037            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1038            if    Velement begins iTeg
     1039               or Velement begins "(" + iTeg + ")"
     1040            then do:
     1041               oTeg = vtegval.
     1042               leave block-teg.
     1043            end.
     1044         end.
     1045      end.
     1046      return oTeg.
     1047   end.
     1048   function isOAD return logical
     1049   (icodeIdent as character):
     1050      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1051   end.
     1052   function isMark return logical
     1053   (icodeIdent as character):
     1054      define buffer buf_marking for ub.marking.
     1055      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1056             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1057   end.
     1058   function addBracketForCode return character
     1059   (icodeIdent as char):
     1060      define variable Velement   as character no-undo init "first".
     1061      define variable oTeg as character no-undo.
     1062      define variable vteg as character no-undo.
     1063      define variable vtegval as character no-undo.
     1064      define buffer marking for ub.marking.
     1065      find first marking no-lock where
     1066                 marking.mark begins icodeIdent no-error.
     1067      if    not ChekTypeMarkByDm(icodeIdent)
     1068         or length(icodeIdent) le 24
     1069         or (avail marking and marking.unit-ext = "LEVEL2")
     1070      then
     1071         oTeg = icodeIdent.
     1072      else do:
     1073         if (  icodeIdent begins "01"
     1074            or icodeIdent begins "02"
     1075            ) and CheckGtin(substring (icodeIdent,3,14))
     1076            and substring (icodeIdent,17,2) eq "21"
     1077         then do:
     1078            mMRCCode = yes.
     1079            ChekTypeMarkByDm(icodeIdent).
     1080            block-teg:
     1081            do while Velement ne "" and icodeIdent ne "":
     1082               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1083               if vteg ne ""
     1084               then
     1085                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1086            end.
     1087            mMRCCode = no.
     1088         end.
     1089         else do:
     1090            oTeg = icodeIdent.
     1091         end.
     1092      end.
     1093      return oTeg.
     1094   end.
     1095   function getlevelByCodId return int
     1096   (iCode as char):
     1097      define variable vLength as int no-undo.
     1098      define variable vLevel  as int no-undo.
     1099      if not ChekTypeMarkByDM (icode) then return ?.
     1100      vLength = length(iCode).
     1101      if    vLength eq 18
     1102         or vLength eq 20
     1103      then
     1104         Vlevel = 4.
     1105      else if vLength eq 21
     1106      then
     1107         Vlevel = 1.
     1108      else if vLength eq 25
     1109      then do:
     1110         if  iCode begins "01"
     1111         then
     1112            Vlevel = 3.
     1113         else
     1114            Vlevel = 1.
     1115      end.
     1116      else if     vLength >= 26
     1117              and vLength <= 46
     1118      then do:
     1119         if    substring(iCode,17,2) eq "11"
     1120            or substring(iCode,17,2) eq "13"
     1121            or (    substring(iCode,17,2) eq "21"
     1122                and vLength >= 33
     1123                and substring(iCode,26,4) ne "8005")
     1124         then
     1125            Vlevel = 4.
     1126         else if    vLength eq 31
     1127                 or vLength eq 38
     1128                 or vLength eq 39
     1129                 or vLength eq 45
     1130         then
     1131            Vlevel = 1.
     1132         else if    vLength eq 35
     1133                 or vLength eq 43
     1134         then
     1135            Vlevel = 3.
     1136         else
     1137            Vlevel = ?.
     1138      end.
     1139      else
     1140         Vlevel = ?.
     1141      return Vlevel.
     1142   end.
     1143   function getLevelMotpBycodid return character
     1144   (iDm as char):
     1145      define variable vLevel as integer no-undo.
     1146      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1147      vLevel = getlevelByCodId(iDm).
     1148      if    vLevel eq ?
     1149         or vLevel < 1
     1150         or vLevel > 6
     1151      then
     1152         return ?.
     1153      else
     1154         return entry(vlevel,vList).
     1155   end.
     1156   function getLevelUTDByLevelMotp return character
     1157   (iUnit as char):
     1158      define variable vLevel as integer no-undo.
     1159      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1160      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1161      vLevel = lookup(iUnit,vListMOTP).
     1162      if    vLevel eq ?
     1163         or vLevel < 1
     1164         or vLevel > 4
     1165      then
     1166         return ?.
     1167      else
     1168         return entry(vlevel,vListutd).
     1169   end.
     1170   function getLevelMotpByDM return character
     1171   (iDm as char):
     1172      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1173   end.
     1174   function getLevelUTDByCodId return character
     1175   (iDm as char):
     1176      define variable vLevel as integer no-undo.
     1177      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1178      vLevel = getlevelByCodId(iDm).
     1179      if    vLevel eq ?
     1180         or vLevel < 1
     1181         or vLevel > 4
     1182      then
     1183         return ?.
     1184      else
     1185         return entry(vlevel,vList).
     1186   end.
     1187   function getLevelUTDByDM return character
     1188   (iDm as char):
     1189      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1190   end.
     1191   define variable mNotMarkQnty as logical no-undo.
     1192   function getQntyUTDByCodId return decimal
     1193   (iDM as char):
     1194      define variable vLevel as integer no-undo.
     1195      define variable vList as character no-undo init "1,5,10,500".
     1196      define variable vGtin as character no-undo.
     1197      define variable vqnty as decimal no-undo init ?.
     1198      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1199      if vqnty eq ?
     1200      then do:
     1201         if not mNotMarkQnty
     1202         then do:
     1203            define buffer marking for ub.marking.
     1204            define variable vCodident as character no-undo.
     1205            vCodident = GetCodeIdent(idm).
     1206            find first marking where marking.mark begins vCodident no-lock no-error.
     1207            if     available marking
     1208               and marking.box-qnty ne ?
     1209            then
     1210               return marking.box-qnty.
     1211         end.
     1212         vGtin = getGtinByDm(iDM).
     1213         if ChekTypeMarkByGtin (vGtin)
     1214         then do:
     1215            vLevel = getlevelByCodId(iDM).
     1216            if     vLevel >= 1
     1217               and vLevel <= 4
     1218            then
     1219               vqnty = int(entry(vlevel,vList)).
     1220         end.
     1221         else
     1222            vqnty = getQntyCodeByGtin(vgtin).
     1223      end.
     1224      return vqnty.
     1225   end.
     1226   function getQntyUTDByDM return decimal
     1227   (iDm as char):
     1228      define variable vDM as character no-undo.
     1229      if     length (iDm) ne 25
     1230         and length (iDm) ne 29
     1231         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1232      then
     1233         vDM = substring (iDm,1,length (iDm) - 6 ).
     1234      else
     1235         vDM = substring (iDm,1,length (iDm) - 4 ).
     1236      return getQntyUTDByCodId(vDM).
     1237   end.
     1238   function getMRC4 return decimal
     1239   (iMRC as char):
     1240      define variable oMrc     as decimal no-undo init ?.
     1241      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1242      define variable vi       as integer no-undo.
     1243      define variable vfound   as integer no-undo.
     1244      define variable vposStart   as integer no-undo.
     1245      do:
     1246      OMRc = 0.
     1247      do vi = 1 to 4:
     1248         define variable vsimb as character no-undo.
     1249         vsimb = substring(iMRC,vi,1).
     1250         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1251         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1252         if vfound > 0
     1253         then
     1254            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1255         end.
     1256         OMRc = OMRc / 100.
     1257      end.
     1258      return OMRc.
     1259   end.
     1260   function getMRCByDM return decimal
     1261   (iDm as char):
     1262      define variable vMRC     as character no-undo.
     1263      define variable oMrc     as decimal no-undo init ?.
     1264      define variable Velement as character no-undo init "empty".
     1265      define variable vteg as character no-undo.
     1266      define variable vtegval as character no-undo.
     1267      if    length(idm) eq 14 + 7 + 4 + 4
     1268         or length(idm) eq 14 + 7 + 4
     1269      then do:
     1270         vMRC = substring(idm,22,4).
     1271         omrc = getMRC4(vMRC).
     1272      end.
     1273      else do:
     1274          ChekTypeMarkByDm(iDm).
     1275          block-mrc:
     1276          do while Velement ne "" and idm ne "":
     1277             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1278             if Velement begins "8005"
     1279             then do:
     1280                vMRC = substring(Velement,5,6).
     1281                leave block-mrc.
     1282             end.
     1283             else if Velement begins "(8005)"
     1284             then do:
     1285                vMRC = substring(Velement,7,6).
     1286                leave block-mrc.
     1287             end.
     1288          end.
     1289          if vMRC ne ""
     1290          then
     1291             OMRc = dec(vmrc) / 100 no-error.
     1292      end.
     1293      return OMRc.
     1294   end.
     1295   function MoveDate return Date
     1296   (idate as date,
     1297    iMonth as int64):
     1298      define variable vMonth   as int64 no-undo.
     1299      define variable vYear    as int64 no-undo.
     1300      define variable vDateNew as date  no-undo.
     1301       define variable vDay     as int64 no-undo.
     1302       vMonth = month(iDate) + iMonth.
     1303       vYear =  year(iDate).
     1304       if vMonth <= 0
     1305       then assign
     1306          vMonth = vMonth + 12
     1307           vYear  = vYear - 1
     1308       .
     1309       else if vMonth > 12
     1310       then assign
     1311          vMonth = vMonth - 12
     1312           vYear  = vYear + 1
     1313       .
     1314       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1315       do while error-status:error eq yes:
     1316          VDay = vDay + 1.
     1317          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1318       end.
     1319       if VDay > 0
     1320       then
     1321          vDateNew + 1.
     1322       return vDateNew.
     1323   end.
     1324   procedure checkEMRC:
     1325   define input  parameter iDm as character no-undo.
     1326   define output parameter vok as logical   no-undo init yes.
     1327      define variable v-value-emrc as character no-undo.
     1328      define variable v-type-emrc  as character no-undo.
     1329      define variable vDateIso     as character no-undo.
     1330      define variable vMRC         as decimal no-undo.
     1331      define variable vqnty        as decimal no-undo.
     1332      define variable vPrice       as decimal no-undo.
     1333      define variable vparent      as character no-undo.
     1334      define variable vgds-code    as integer no-undo.
     1335      define buffer code for ub.code.
     1336      vMRC = getMRCByDM(iDm).
     1337      if vMRC > 0
     1338      then do:
     1339         vgds-code = getGdsCodeByDM(iDm).
     1340         vqnty     = getQntyUTDByDM(iDm).
     1341               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1342            (
     1343             input   vgds-code
     1344            ,input   'emrc-type':U
     1345            ,output   v-value-emrc
     1346            ,output   v-type-emrc
     1347          ) no-error.
     1348          if     v-value-emrc ne ""
     1349             and v-value-emrc ne ?
     1350          then do:
     1351             vDateIso = iso-date(today).
     1352             vPrice = vMRC / vqnty.
     1353             vparent ="emc" + chr(4) + v-value-emrc.
     1354             find last code where Code.parent      eq vparent
     1355                              and Code.code        le vDateIso
     1356                              and code.status_  eq 0
     1357             no-lock no-error.
     1358             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1359             then
     1360                vOk = true .
     1361             else do:
     1362                 define variable vText      as character no-undo.
     1363                 define variable vDate      as date no-undo.
     1364                 define variable vDateLast  as character no-undo.
     1365                 define variable vDateFirst as character no-undo.
     1366                 define variable vDate3     as date no-undo.
     1367                 vdate = date(code.misc1).
     1368                 vDateLast = code.misc1.
     1369                 vDate3 = MoveDate(today, - 3 ).
     1370                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1371                                      string(vDate3  , "99/99/9999"),
     1372                                      string(vDate   , "99/99/9999")
     1373                                      ).
     1374                 vdateIso = iso-date(vdate3).
     1375                 find last code  where Code.parent      eq vparent
     1376                                   and Code.code        le vDateIso
     1377                                   and code.status_  eq 0 no-lock no-error.
     1378                 if available code
     1379                 then
     1380                    vDateIso = code.code.
     1381                 vDateFirst = vDateIso.
     1382                 vDateLast = iso-date(vdate).
     1383                 define variable vGood as logical no-undo.
     1384                 define variable vDateSale as date no-undo.
     1385                 define buffer bcode for code.
     1386                 for last code where Code.parent   eq vparent
     1387                                 and code.status_  eq 0
     1388                                 and code.code     < vDateLast
     1389                                 and code.code     >= vDateFirst
     1390                 no-lock:
     1391                    find first bcode where bCode.parent   eq vparent
     1392                                       and bcode.status_  eq 0
     1393                                       and bcode.code     > code.code no-lock no-error.
     1394                    if available bcode
     1395                    then do:
     1396                       if vPrice < dec(Code.CodeValue)
     1397                       then
     1398                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1399                                                     chr(10),
     1400                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1401                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1402                                                     ).
     1403                       else do:
     1404                          vGood = yes.
     1405                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1406                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1407                                                     chr(10),
     1408                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1409                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1410                                                     string(         vDateSale            ,"99/99/9999"),
     1411                                                     string(vDateSale - today)
     1412                                                     ).
     1413                       end.
     1414                    end.
     1415                 end.
     1416                 if vgood
     1417                 then do:
     1418                    define variable choice as integer no-undo .
     1419                    run gbl/d-askw.w (input "Уточнение"
     1420                           ,input  vText
     1421                           ,input "|"
     1422                           ,input "Принять|Вернуть"
     1423                           ,input "Принять данный товар|Вернуть товар постащику"
     1424                           ,input 1
     1425                           ,input 2
     1426                           ,output choice) no-error.
     1427                    vok = choice eq 1.
     1428                 end.
     1429                 else
     1430                    vok =false.
     1431             end.
     1432          end.
     1433      end.
     1434   end.
     1435   function addGs2Mark return character
     1436   (iMark as char):
     1437      define variable vDM   as character no-undo.
     1438      define variable vIdx  as integer   no-undo.
     1439      if index(iMark,chr(29),1) > 0
     1440      then return iMark.
     1441      if substring(iMark,26,4) = "8005" then
     1442      do:
     1443        vIdx = index(iMark,"93",26 + 4 + 5).
     1444        if vIdx > 1 then do:
     1445          vDM = substitute("&1&4&2&4&3",
     1446                           substring(iMark,1,25),
     1447                           substring(iMark,26,vIdx - 25 - 1),
     1448                           substring(iMark,vIdx),
     1449                           chr(29)) no-error.
     1450          vIdx = index(vDm,"240",vIdx + 4).
     1451          if vIdx > 0 then
     1452          do:
     1453            vDM = substitute("&1&3&2",
     1454                             substring(vDm,1,vIdx - 1),
     1455                             substring(vDm,vIdx),
     1456                             chr(29)) no-error.
     1457          end.
     1458        end.
     1459        else
     1460          vDM = substitute("&1&3&2",
     1461                           substring(iMark,1,25),
     1462                           substring(iMark,26),
     1463                           chr(29)) no-error.
     1464      end.
     1465      else if substring(iMark,32,2) = "91" then
     1466      do:
     1467        vIdx = index(iMark,"92",32).
     1468        if vIdx > 1 then
     1469          vDM = substitute("&1&4&2&4&3",
     1470                           substring(iMark,1,31),
     1471                           substring(iMark,32,vIdx - 31 - 1),
     1472                           substring(iMark,vIdx),
     1473                           chr(29)) no-error.
     1474        else
     1475          vDM = substitute("&1&3&2",
     1476                           substring(iMark,1,31),
     1477                           substring(iMark,32),
     1478                           chr(29)) no-error.
     1479      end.
     1480      else if substring(iMark,39,2) = "91" then
     1481      do:
     1482        vIdx = index(iMark,"92",38).
     1483        if vIdx > 1 then
     1484          vDM = substitute("&1&4&2&4&3",
     1485                           substring(iMark,1,38),
     1486                           substring(iMark,39,vIdx - 38 - 1),
     1487                           substring(iMark,vIdx),
     1488                           chr(29)) no-error.
     1489        else
     1490          vDM = substitute("&1&3&2",
     1491                           substring(iMark,1,38),
     1492                           substring(iMark,39),
     1493                           chr(29)) no-error.
     1494      end.
     1495      else if substring(iMark,25,2) = "93" then
     1496      do:
     1497        vIdx = index(iMark,"92",25).
     1498        if vIdx > 1 then
     1499          vDM = substitute("&1&4&2&4&3",
     1500                           substring(iMark,1,24),
     1501                           substring(iMark,25,vIdx - 24 - 1),
     1502                           substring(iMark,vIdx),
     1503                           chr(29)) no-error.
     1504        else
     1505          vIdx = index(iMark,"3103",25).
     1506          if vIdx > 0 then
     1507          vDM = substitute("&1&4&2&4&3",
     1508                           substring(iMark,1,24),
     1509                           substring(iMark,25,vIdx - 24 - 1),
     1510                           substring(iMark,vIdx),
     1511                           chr(29)) no-error.
     1512          else
     1513            vDM = substitute("&1&3&2",
     1514                             substring(iMark,1,24),
     1515                             substring(iMark,25),
     1516                             chr(29)) no-error.
     1517      end.
     1518      else if substring(iMark,32,2) = "93" then
     1519      do:
     1520        vDM = substitute("&1&3&2",
     1521              substring(iMark,1,31),
     1522              substring(iMark,32),
     1523              chr(29)) no-error.
     1524      end.
     1525      return if vDM <> "" then vDm else iMark.
     1526   end.
     1527   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1528   procedure gen-key-rec :
     1529     define input  parameter p-tbl-name    as character no-undo.
     1530     define input  parameter p-bh_tbl-name as handle    no-undo.
     1531     define output parameter p-key-rec     as character no-undo.
     1532     do
     1533     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1534     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1535     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1536     :
     1537       define variable fh               as handle    no-undo .
     1538       define variable v-ok             as logical   no-undo .
     1539       define variable v-inform         as character no-undo .
     1540       define variable v-ind            as integer   no-undo .
     1541       define variable v-idx-field-qnty as integer   no-undo .
     1542       if p-tbl-name = ?
     1543         or p-tbl-name = "":U
     1544       then do:
     1545         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
     1546       end.
     1547       if not p-bh_tbl-name:available then do:
     1548         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
     1549       end.
     1550       assign
     1551         p-key-rec = p-tbl-name
     1552         v-inform  = p-bh_tbl-name:index-information(1)
     1553         v-ind     = 2
     1554       .
     1555       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1556       on error undo, return error
     1557       :
     1558         assign
     1559           v-inform = p-bh_tbl-name:index-information( v-ind )
     1560           v-ind    = v-ind + 1
     1561         .
     1562       end.
     1563       if v-inform = ?
     1564         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1565         or entry( 3, v-inform, ",":U ) <> "1":U
     1566       then do:
     1567         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1568       end.
     1569       else do:
     1570         assign
     1571           v-idx-field-qnty = num-entries( v-inform ) - 4
     1572         .
     1573         if v-idx-field-qnty < 2 then do:
     1574           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1575         end.
     1576         do v-ind = 1 to v-idx-field-qnty by 2
     1577         on error undo, return error
     1578         :
     1579           assign
     1580             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1581             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1582           .
     1583         end.
     1584       end.
     1585       if p-key-rec = ? then do:
     1586         assign
     1587           p-key-rec = "":U
     1588         .
     1589         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1590       end.
     1591     end.
     1592     return.
     1593   end procedure.
     1594   procedure gen-where-keyr-tab :
     1595     define input  parameter i-tableSerach as character no-undo.
     1596     define input  parameter i-tablekey   as character  no-undo.
     1597     define input  parameter p-key-rec    as character  no-undo.
     1598     define input  parameter p-key-handle as handle     no-undo .
     1599     define input  parameter p-db-name    as character  no-undo .
     1600     define input  parameter p-tt-handle  as handle     no-undo .
     1601     define output parameter o-Where      as character  no-undo.
     1602     do
     1603     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1604     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1605     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1606     :
     1607       define variable v-full-tbl-name  as character no-undo .
     1608       define variable bh_tbl-name      as handle    no-undo .
     1609       define variable fh_key           as handle    no-undo .
     1610       define variable fh_search        as handle    no-undo .
     1611       define variable v-field-num      as integer   no-undo .
     1612       define variable v-count-fld      as integer   no-undo .
     1613       define variable v-inform         as character no-undo .
     1614       define variable v-ind            as integer   no-undo .
     1615       define variable v-idx-field-qnty as integer   no-undo .
     1616       define variable v-field-name     as character no-undo .
     1617       define variable v-field-val      as character no-undo .
     1618       define variable v-word-link      as character no-undo .
     1619       define variable vTable           as character no-undo.
     1620       define variable bh_tbl-key       as handle    no-undo .
     1621       assign
     1622         p-key-rec = trim( p-key-rec )
     1623       .
     1624       if p-key-handle <> ? then do:
     1625         if not valid-handle(p-key-handle)
     1626            or p-key-handle:type <> "buffer"
     1627         then do:
     1628           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1629         end.
     1630         if num-entries( p-key-rec, chr(3) ) > 1
     1631           or p-key-rec = ?
     1632           or p-key-rec = "":U
     1633         then do:
     1634           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1635         end.
     1636       end.
     1637       else do:
     1638         if p-key-rec = ?
     1639           or p-key-rec = "":U
     1640         then do:
     1641           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1642         end.
     1643       end.
     1644       assign
     1645         vTable = entry( 1 , p-key-rec, chr(3) )
     1646       .
     1647       if p-tt-handle <> ?
     1648         and ( not valid-handle(p-tt-handle)
     1649               or p-tt-handle:type <> "buffer"
     1650             )
     1651       then do:
     1652         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1653       end.
     1654       if p-tt-handle = ? then do:
     1655         assign
     1656           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1657         .
     1658         create buffer bh_tbl-name for table v-full-tbl-name .
     1659       end.
     1660       else do:
     1661         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1662       end.
     1663       assign
     1664         v-inform = bh_tbl-name:index-information(1)
     1665         v-ind    = 2
     1666       .
     1667       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1668       on error undo, return error
     1669       :
     1670         assign
     1671           v-inform = bh_tbl-name:index-information( v-ind )
     1672           v-ind    = v-ind + 1
     1673         .
     1674       end.
     1675       if v-inform = ?
     1676         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1677         or entry( 3, v-inform, ",":U ) <> "1":U
     1678       then do:
     1679         delete object bh_tbl-name no-error.
     1680         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1681       end.
     1682       assign
     1683         v-idx-field-qnty = num-entries( v-inform ) - 4
     1684       .
     1685       if v-idx-field-qnty < 2 then do:
     1686         delete object bh_tbl-name no-error.
     1687         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1688       end.
     1689       assign
     1690         o-where     = "where":U
     1691         v-word-link = "":U
     1692         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1693         v-count-fld = 0
     1694       .
     1695       if i-tablekey ne "" and i-tablekey ne ?
     1696       then do:
     1697         assign
     1698           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1699         .
     1700         create buffer bh_tbl-key for table v-full-tbl-name .
     1701       end.
     1702       if i-tableSerach ne "" and i-tableSerach ne ?
     1703       then do:
     1704         delete object bh_tbl-name no-error.
     1705         assign
     1706           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1707         .
     1708         create buffer bh_tbl-name for table v-full-tbl-name .
     1709       end.
     1710       block_where:
     1711       do v-ind = 1 to v-idx-field-qnty by 2
     1712       on error undo, return error
     1713       :
     1714         assign
     1715           v-count-fld = v-count-fld + 1
     1716         .
     1717         if p-key-handle = ?
     1718           and v-count-fld > v-field-num
     1719         then do:
     1720           leave block_where.
     1721         end.
     1722         define variable VfieldKeyTable as handle no-undo.
     1723         assign
     1724           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1725           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1726         .
     1727         if     bh_tbl-key ne ?
     1728         then do:
     1729            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1730            if VfieldKeyTable eq ?
     1731            then next block_where.
     1732         end.
     1733         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1734         then
     1735            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1736         else
     1737            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1738         if p-key-handle = ? then do:
     1739           assign
     1740             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1741           .
     1742         end.
     1743         else do:
     1744           assign
     1745             fh_key = p-key-handle:buffer-field( v-field-name )
     1746           .
     1747           if fh_key = ?
     1748             or not valid-handle( fh_key )
     1749           then do:
     1750             delete object bh_tbl-name.
     1751             if     bh_tbl-key ne ?
     1752             then
     1753                delete object bh_tbl-key.
     1754             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1755           end.
     1756           assign
     1757             v-field-val = fh_key:buffer-value
     1758           .
     1759         end.
     1760         if fh_search:data-type ="character":U then do:
     1761           assign
     1762             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1763             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1764             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1765             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1766             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1767             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1768             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1769             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1770             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1771             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1772             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1773             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1774             v-field-val = substitute( '"&1"', v-field-val )
     1775           .
     1776         end.
     1777         assign
     1778           o-where = substitute( "&1 &2", o-where, v-field-val )
     1779         .
     1780         if v-word-link = "":U then do:
     1781           assign
     1782             v-word-link = "and":U
     1783           .
     1784         end.
     1785       end.
     1786       delete object bh_tbl-name.
     1787       if     bh_tbl-key ne ?
     1788       then
     1789          delete object bh_tbl-key.
     1790       if p-key-handle = ?
     1791         and v-count-fld <> v-field-num
     1792       then do:
     1793         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1794       end.
     1795     end.
     1796   end procedure.
     1797   procedure gen-hn-keyr-tab :
     1798     define input  parameter i-tableSerach as character no-undo.
     1799     define input  parameter i-tablekey   as character no-undo.
     1800     define input  parameter p-key-rec    as character no-undo.
     1801     define input  parameter p-key-handle as handle    no-undo .
     1802     define input  parameter p-db-name    as character no-undo .
     1803     define input  parameter p-tt-handle  as handle    no-undo .
     1804     define input  parameter p-stts-lock  as integer   no-undo .
     1805     define output parameter o-hn         as handle    no-undo.
     1806     define variable v-full-tbl-name as character no-undo.
     1807     define variable v-where         as character no-undo.
     1808     define variable bh_tbl-name     as handle    no-undo.
     1809     define variable vTable          as character no-undo.
     1810     do
     1811     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1812     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1813     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1814         run gen-where-keyr-tab(i-tableSerach,
     1815                                i-tablekey,
     1816                                p-key-rec,
     1817                                p-key-handle,
     1818                                p-db-name,
     1819                                p-tt-handle,
     1820                                output v-where).
     1821         if i-tableSerach ne "" and i-tableSerach ne ?
     1822         then do:
     1823            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1824            create buffer bh_tbl-name for table v-full-tbl-name .
     1825         end.
     1826         else do:
     1827            if p-tt-handle = ? then do:
     1828               assign
     1829                  vTable = entry( 1 , p-key-rec, chr(3) )
     1830               .
     1831               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1832               create buffer bh_tbl-name for table v-full-tbl-name .
     1833            end.
     1834            else do:
     1835               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1836            end.
     1837         end.
     1838         if p-tt-handle = ? then do:
     1839            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1840         end.
     1841         else do:
     1842            bh_tbl-name:find-first( v-where ) no-error .
     1843         end.
     1844         o-hn = bh_tbl-name.
     1845      end.
     1846   end procedure.
     1847   procedure gen-hn-keyr :
     1848     define input  parameter p-key-rec    as character no-undo.
     1849     define input  parameter p-key-handle as handle    no-undo .
     1850     define input  parameter p-db-name    as character no-undo .
     1851     define input  parameter p-tt-handle  as handle    no-undo .
     1852     define input  parameter p-stts-lock  as integer   no-undo .
     1853     define output parameter o-hn         as handle    no-undo.
     1854     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1855   end.
     1856   procedure gen-row-keyr :
     1857     define input  parameter p-key-rec    as character no-undo.
     1858     define input  parameter p-key-handle as handle    no-undo .
     1859     define input  parameter p-db-name    as character no-undo .
     1860     define input  parameter p-tt-handle  as handle    no-undo .
     1861     define input  parameter p-stts-lock  as integer   no-undo .
     1862     define output parameter p-tbl-row    as rowid     no-undo.
     1863     define output parameter p-tbl-name   as character no-undo.
     1864     define variable vHn as handle no-undo.
     1865       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1866       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1867       p-tbl-name =  vHn:table.
     1868       delete object vHn no-error.
     1869     if p-tbl-row = ? then do:
     1870       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1871     end.
     1872     else do:
     1873       return.
     1874     end.
     1875   end procedure.
     1876   procedure gen-key-fv :
     1877     define input  parameter p-key-rec    as character no-undo .
     1878     define output parameter p-field-list as character no-undo .
     1879     define output parameter p-value-list as character no-undo.
     1880     do
     1881     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1882     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1883     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1884     :
     1885       define variable v-full-tbl-name  as character no-undo .
     1886       define variable bh_tbl-name      as handle    no-undo .
     1887       define variable v-tbl-name       as character no-undo .
     1888       define variable v-field-num      as integer   no-undo .
     1889       define variable v-count-fld      as integer   no-undo .
     1890       define variable v-inform         as character no-undo .
     1891       define variable v-ind            as integer   no-undo .
     1892       define variable v-idx-field-qnty as integer   no-undo .
     1893       define variable v-delim-key      as character no-undo .
     1894       if p-key-rec = ?
     1895         or p-key-rec = "":U
     1896       then do:
     1897         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1898       end.
     1899       assign
     1900         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1901         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1902       .
     1903       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1904       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1905       assign
     1906         v-inform = bh_tbl-name:index-information(1)
     1907         v-ind    = 2
     1908       .
     1909       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1910       on error undo, return error
     1911       :
     1912         assign
     1913           v-inform = bh_tbl-name:index-information( v-ind )
     1914           v-ind    = v-ind + 1
     1915         .
     1916       end.
     1917       if v-inform = ?
     1918         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1919         or entry( 3, v-inform, ",":U ) <> "1":U
     1920       then do:
     1921         delete object bh_tbl-name no-error.
     1922         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1923       end.
     1924       assign
     1925         v-idx-field-qnty = num-entries( v-inform ) - 4
     1926       .
     1927       if v-idx-field-qnty < 2 then do:
     1928         delete object bh_tbl-name no-error.
     1929         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1930       end.
     1931       assign
     1932         p-field-list = "":U
     1933         p-value-list = "":U
     1934         v-delim-key  = "":U
     1935         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1936         v-count-fld  = 0
     1937       .
     1938       block_where:
     1939       do v-ind = 1 to v-idx-field-qnty by 2
     1940       on error undo, return error
     1941       :
     1942         assign
     1943           v-count-fld = v-count-fld + 1
     1944         .
     1945         if v-count-fld > v-field-num then do:
     1946           leave block_where.
     1947         end.
     1948         assign
     1949           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1950           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1951         .
     1952         if v-ind = 1 then do:
     1953           assign
     1954             v-delim-key = chr(3)
     1955           .
     1956         end.
     1957       end.
     1958       delete object bh_tbl-name.
     1959       if v-count-fld <> v-field-num then do:
     1960         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1961       end.
     1962     end.
     1963   end procedure.
     1964   procedure gen-key-field :
     1965     define input  parameter p-table      as character no-undo .
     1966     define output parameter p-field-list as character no-undo .
     1967     do
     1968     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1969     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1970     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1971     :
     1972       define variable v-full-tbl-name  as character no-undo .
     1973       define variable bh_tbl-name      as handle    no-undo .
     1974       define variable v-tbl-name       as character no-undo .
     1975       define variable v-field-num      as integer   no-undo .
     1976       define variable v-count-fld      as integer   no-undo .
     1977       define variable v-inform         as character no-undo .
     1978       define variable v-ind            as integer   no-undo .
     1979       define variable v-idx-field-qnty as integer   no-undo .
     1980       define variable v-delim-key      as character no-undo .
     1981       if p-table = ?
     1982         or p-table = "":U
     1983       then do:
     1984         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1985       end.
     1986       assign
     1987         v-tbl-name      = p-table
     1988         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1989       .
     1990       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1991       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1992       assign
     1993         v-inform = bh_tbl-name:index-information(1)
     1994         v-ind    = 2
     1995       .
     1996       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1997       on error undo, return error
     1998       :
     1999         assign
     2000           v-inform = bh_tbl-name:index-information( v-ind )
     2001           v-ind    = v-ind + 1
     2002         .
     2003       end.
     2004       if v-inform = ?
     2005         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2006         or entry( 3, v-inform, ",":U ) <> "1":U
     2007       then do:
     2008         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     2009       end.
     2010       assign
     2011         v-idx-field-qnty = num-entries( v-inform ) - 4
     2012       .
     2013       if v-idx-field-qnty < 2 then do:
     2014         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     2015       end.
     2016       assign
     2017         p-field-list = "":U
     2018         v-delim-key  = "":U
     2019         v-count-fld  = 0
     2020       .
     2021       block_where:
     2022       do v-ind = 1 to v-idx-field-qnty by 2
     2023       on error undo, return error
     2024       :
     2025         assign
     2026           v-count-fld = v-count-fld + 1
     2027         .
     2028         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2029         if v-ind = 1 then do:
     2030           assign
     2031             v-delim-key = chr(3)
     2032           .
     2033         end.
     2034       end.
     2035       delete object bh_tbl-name.
     2036     end.
     2037   end procedure.
     2038   function AddUtdErrForTab returns logical
     2039   (idb-num         as integer ,
     2040    idoc-id         as integer ,
     2041    iTab            as character,
     2042    iObj            as handle ,
     2043    iCheckType      as character,
     2044    iCodeErr        as character,
     2045    iCheckObj       as character ):
     2046      define buffer utd-err for utd-err.
     2047      define buffer utd for utd.
     2048      find first utd where utd.db-num     eq idb-num
     2049                       and utd.doc-id     eq idoc-id
     2050                       and utd.Direction  eq 'Outbound'
     2051      no-lock no-error.
     2052      if available utd
     2053      then
     2054         return no.
     2055      define variable vRecKey as character no-undo.
     2056            run gen-key-rec (input iTab,
     2057                             input  iObj,
     2058                             output vRecKey).
     2059      find first utd-err where utd-err.db-num     eq idb-num
     2060                           and utd-err.doc-id     eq idoc-id
     2061                           and utd-err.CheckType  eq iCheckType
     2062                           and utd-err.CodeErr    eq iCodeErr
     2063                           and utd-err.CheckObj   eq iCheckObj
     2064      exclusive-lock no-error.
     2065      if not available utd-err
     2066      then do:
     2067         create utd-err.
     2068         assign
     2069            utd-err.db-num         = idb-num
     2070            utd-err.doc-id         = idoc-id
     2071            utd-err.CheckType      = iCheckType
     2072            utd-err.CodeErr        = iCodeErr
     2073            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2074            utd-err.reckey         = vRecKey
     2075            utd-err.qnty           = 1
     2076         .
     2077      end.
     2078      else
     2079         utd-err.qnty = utd-err.qnty + 1.
     2080      return utd-err.qnty eq 1.
     2081   end.
     2082   function AddUtdErr returns logical
     2083   (idb-num         as integer ,
     2084    idoc-id         as integer ,
     2085    iObj            as handle ,
     2086    iCheckType      as character,
     2087    iCodeErr        as character,
     2088    iCheckObj       as character ):
     2089      AddUtdErrForTab
     2090         (idb-num,
     2091          idoc-id,
     2092          iObj:table,
     2093          iObj,
     2094          iCheckType,
     2095          iCodeErr,
     2096          iCheckObj).
     2097   end.
     2098   function ClearUtdErrTypeCode returns logical
     2099   (idb-num         as integer,
     2100    idoc-id         as integer ,
     2101    iCheckType      as character,
     2102    iCodeErr        as character
     2103    ):
     2104      define buffer utd-err for utd-err.
     2105      if    iCheckType eq "*"
     2106         or iCheckType eq ?
     2107      then do:
     2108         if     iCodeErr ne ?
     2109            and iCodeErr ne "*"
     2110         then
     2111            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2112            view-as alert-box.
     2113         else
     2114         for each utd-err where utd-err.db-num  eq idb-num
     2115                            and utd-err.doc-id  eq idoc-id
     2116         exclusive-lock:
     2117            delete utd-err.
     2118         end.
     2119      end.
     2120      else do:
     2121         if    iCodeErr eq ?
     2122            or iCodeErr eq "*"
     2123         then do:
     2124            for each utd-err where utd-err.db-num     eq idb-num
     2125                               and utd-err.doc-id     eq idoc-id
     2126                               and utd-err.CheckType  eq iCheckType
     2127            exclusive-lock:
     2128               delete utd-err.
     2129            end.
     2130         end.
     2131         else do:
     2132            for each utd-err where utd-err.db-num     eq idb-num
     2133                               and utd-err.doc-id     eq idoc-id
     2134                               and utd-err.CheckType  eq iCheckType
     2135                               and ub.utd-err.CodeErr eq iCodeErr
     2136            exclusive-lock:
     2137               delete utd-err.
     2138            end.
     2139         end.
     2140      end.
     2141   end.
     2142   function ClearUtdErr returns logical
     2143   (idb-num         as integer,
     2144    idoc-id         as integer ,
     2145    iCheckType      as character
     2146    ):
     2147      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2148   end.
     2149   function GetMesError returns character
     2150   (itxt as character,
     2151    iobj as character ):
     2152    define variable vi as integer no-undo.
     2153    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2154       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2155    end.
     2156    return itxt.
     2157   end.
     2158   function GetTextErrorType returns character
     2159   (iCheckType as character,
     2160    iCodeErr   as character,
     2161    iChechObj  as character,
     2162    iType      as character  ):
     2163      define buffer code    for code.
     2164      define variable vError as character no-undo.
     2165      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2166                        and code.code   eq iCodeErr
     2167      no-lock no-error.
     2168      if available code
     2169      then do:
     2170         define variable vType as integer no-undo.
     2171         if code.misc3 eq "error"
     2172         then
     2173            vType = 0.
     2174         else if code.misc3 eq "warning"
     2175         then
     2176            vType = 1.
     2177         else if code.misc3 eq "Hiden"
     2178         then
     2179            vType = 2.
     2180         else
     2181            vtype = int(code.misc3) no-error.
     2182         case itype:
     2183            when "error"
     2184            then do:
     2185               if vtype eq 0
     2186               then
     2187                  vError = GetMesError(Code.CodeValue,iChechObj).
     2188            end.
     2189            when "warning"
     2190            then do:
     2191               if vtype <= 1
     2192               then
     2193                  vError = GetMesError(Code.CodeValue,iChechObj).
     2194            end.
     2195            otherwise do:
     2196               vError = GetMesError(Code.CodeValue,iChechObj).
     2197            end.
     2198         end.
     2199      end.
     2200      else
     2201         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2202      return vError.
     2203   end.
     2204   function GetTypeError returns integer
     2205   (iCheckType as character,
     2206    iCodeErr   as character):
     2207      define buffer code    for code.
     2208      define variable vType as integer no-undo.
     2209      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2210                        and code.code   eq iCodeErr
     2211      no-lock no-error.
     2212      if     not available code
     2213         and code.misc3 eq "error"
     2214      then
     2215         vType = 0.
     2216      else if code.misc3 eq "warning"
     2217      then
     2218         vType = 1.
     2219      else if code.misc3 eq "Hiden"
     2220      then
     2221         vType = 2.
     2222      else
     2223         vtype = int(code.misc3) no-error.
     2224      return vtype.
     2225   end.
     2226   function GetTextError returns character
     2227   (iCheckType as character,
     2228    iCodeErr   as character,
     2229    iChechObj  as character ):
     2230      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2231   end.
     2232   function GetErrForUtdStr returns character
     2233   (idb-num     as integer ,
     2234    idoc-id     as integer ,
     2235    iCheckType  as character
     2236    ):
     2237      define buffer utd-err for utd-err.
     2238      define buffer code    for code.
     2239      define variable vHQry as handle no-undo.
     2240      define variable vError as longchar no-undo.
     2241      define variable vErrorOne as longchar  no-undo.
     2242      define variable oError as character no-undo.
     2243      create query vHQry.
     2244      vHQry:set-buffers(buffer utd-err:handle).
     2245      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2246                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2247                               + if    iCheckType eq "*"
     2248                                    or iCheckType eq ?
     2249                                 then       ""
     2250                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2251      vHQry:query-open().
     2252      vHQry:get-first().
     2253      QRY-BLOCK:
     2254      repeat while not vHQry:query-off-end:
     2255         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2256         if     vErrorOne ne ""
     2257            and vErrorOne ne ?
     2258         then
     2259            vError = vError + ", " + vErrorOne.
     2260         vHQry:get-next().
     2261      end.
     2262      oError = substring(vError,3,4002).
     2263      return oError.
     2264   end.
     2265   function GetErrJsonForUtd returns character
     2266   (idb-num         as integer ,
     2267    idoc-id         as integer ,
     2268    iCheckType      as character
     2269    ):
     2270      define buffer utd-err for utd-err.
     2271      define variable vHQry as handle no-undo.
     2272      define variable vError as longchar no-undo.
     2273      define variable oError as character no-undo.
     2274      create query vHQry.
     2275      define variable vi as integer no-undo.
     2276      vHQry:set-buffers(buffer utd-err:handle).
     2277      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2278                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2279                               + if    iCheckType eq "*"
     2280                                    or iCheckType eq ?
     2281                                 then       ""
     2282                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2283      vHQry:query-open().
     2284      vHQry:get-first().
     2285      QRY-BLOCK:
     2286      repeat while not vHQry:query-off-end:
     2287         define variable vErrorOne as character no-undo.
     2288         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2289         if     vErrorOne ne ?
     2290            and vErrorOne ne ""
     2291         then do:
     2292            vi = vi + 1.
     2293            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2294                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2295                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2296         end.
     2297         vHQry:get-next().
     2298      end.
     2299      for first utd where utd.db-num eq idb-num
     2300                      and utd.doc-id eq idoc-id
     2301                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2302      no-lock,
     2303         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2304                                  and utd-marking-lines.doc-id eq idoc-id
     2305                                  and utd-marking-lines.doc-level eq 1
     2306      no-lock,
     2307         first marking where marking.mark eq utd-marking-lines.mark
     2308                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2309      no-lock:
     2310         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2311         if     vErrorOne ne ?
     2312            and vErrorOne ne ""
     2313         then do:
     2314            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2315                            + '","ОбъектОш":"' + marking.mark
     2316                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2317         end.
     2318      end.
     2319      if vError ne ""
     2320      then
     2321         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2322      return oError.
     2323   end.
     2324   function GetErrJsonForUtdReturn returns character
     2325   (idb-num         as integer ,
     2326    idoc-id         as integer ,
     2327    iCheckType      as character
     2328    ):
     2329      define buffer utd-err for utd-err.
     2330      define variable vHQry as handle no-undo.
     2331      define variable vError as longchar no-undo.
     2332      define variable oError as character no-undo.
     2333      define variable vi as integer no-undo.
     2334      create query vHQry.
     2335      vHQry:set-buffers(buffer utd-err:handle).
     2336      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2337                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2338                               + if    iCheckType eq "*"
     2339                                    or iCheckType eq ?
     2340                                 then       ""
     2341                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2342      vHQry:query-open().
     2343      vHQry:get-first().
     2344      QRY-BLOCK:
     2345      repeat while not vHQry:query-off-end:
     2346         define variable vErrorOne as character no-undo.
     2347         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2348         if     vErrorOne ne ?
     2349            and vErrorOne ne ""
     2350         then do:
     2351            vi = vi + 1.
     2352            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2353                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2354                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2355         end.
     2356         vHQry:get-next().
     2357      end.
     2358      if vError ne ""
     2359      then
     2360         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2361      return oError.
     2362   end.
     2363   function GetCodeTextError returns character
     2364   (iCheckType as character,
     2365    iCodeErr   as character,
     2366    iChechObj  as character,
     2367    output oCode as character,
     2368    output ovalue as character ):
     2369      define buffer code    for code.
     2370      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2371                        and code.code   eq iCodeErr
     2372      no-lock no-error.
     2373      if     available code
     2374      then do:
     2375         define variable vi as integer no-undo init ?.
     2376         vi = int(Code.misc3) no-error.
     2377         if    code.misc3 ne "error"
     2378            and vi ne 0
     2379         then
     2380            oCode = ?.
     2381         else if     Code.misc1 ne ?
     2382                 and Code.misc1 ne ""
     2383         then
     2384            assign
     2385               oCode  = GetMesError(Code.misc1,iChechObj)
     2386               ovalue = GetMesError(Code.misc2,iChechObj)
     2387            .
     2388      end.
     2389      return if oCode eq ""
     2390             then ""
     2391             else (oCode + "_" + ovalue).
     2392   end.
     2393   define temp-table TT-err no-undo
     2394     field code_ as character
     2395     field text_ as character
     2396   index code_ code_.
     2397   function GetErrTxtForUtd returns character
     2398   (idb-num         as integer ,
     2399    idoc-id         as integer ,
     2400    iCheckType      as character
     2401    ):
     2402      define buffer utd-err for utd-err.
     2403      define variable vHQry as handle no-undo.
     2404      define variable oError as character no-undo.
     2405      create query vHQry.
     2406      define variable vi as integer no-undo.
     2407      for each tt-err :
     2408         delete tt-err.
     2409      end.
     2410      vHQry:set-buffers(buffer utd-err:handle).
     2411      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2412                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2413                               + if    iCheckType eq "*"
     2414                                    or iCheckType eq ?
     2415                                 then       ""
     2416                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2417      vHQry:query-open().
     2418      vHQry:get-first().
     2419      define variable vcode as character no-undo.
     2420      define variable vvalue as character no-undo.
     2421      QRY-BLOCK:
     2422      repeat while not vHQry:query-off-end:
     2423         vi = vi + 1.
     2424         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2425         if vcode ne ?
     2426         then do:
     2427            find first tt-err where tt-err.code eq vcode
     2428            no-error.
     2429            if not available tt-err
     2430            then do:
     2431               create tt-err.
     2432               assign
     2433                  tt-err.code_ = vcode
     2434                  tt-err.text_ = vvalue
     2435               .
     2436            end.
     2437            else
     2438               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2439         end.
     2440         vHQry:get-next().
     2441      end.
     2442     find first utd where utd.db-num eq idb-num
     2443                         and utd.doc-id eq idoc-id
     2444         no-lock.
     2445      define buffer cancel_utd-lines for utd-lines.
     2446      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2447                                  and cancel_utd-lines.doc-id eq idoc-id
     2448      no-lock:
     2449         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2450         then do:
     2451            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2452                                        and utd-marking-lines.doc-id eq idoc-id
     2453                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2454            no-lock,
     2455               first marking where marking.mark eq utd-marking-lines.mark
     2456                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2457            no-lock:
     2458               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2459               find first tt-err where tt-err.code eq vcode
     2460               no-error.
     2461               if not available tt-err
     2462               then do:
     2463                  create tt-err.
     2464                  assign
     2465                     tt-err.code_ = vcode
     2466                     tt-err.text_ = vvalue
     2467                  .
     2468               end.
     2469               else
     2470                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2471            end.
     2472         end.
     2473         else do:
     2474            define variable vqnty as decimal no-undo.
     2475            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2476            if vqnty eq ? then vqnty = 0.
     2477            if vqnty ne cancel_utd-lines.Quantity
     2478            then do:
     2479               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2480               find first tt-err where tt-err.code eq vcode
     2481               no-error.
     2482               if not available tt-err
     2483               then do:
     2484                  create tt-err.
     2485                  assign
     2486                     tt-err.code_ = vcode
     2487                     tt-err.text_ = vvalue
     2488                  .
     2489               end.
     2490               else
     2491                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2492            end.
     2493         end.
     2494      end.
     2495      for each tt-err:
     2496         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2497      end.
     2498      return oError.
     2499   end.
     2500   define variable mFormatErr as character no-undo init "text".
     2501   function GetErrForUtd returns character
     2502   (idb-num         as integer ,
     2503    idoc-id         as integer ,
     2504    iType           as character
     2505    ):
     2506      if mFormatErr eq "text"
     2507      then
     2508         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2509      else do:
     2510         if itype eq "return"
     2511         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2512         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2513      end.
     2514   end.
     2515   function GetErrComText returns longchar
     2516   (icomment as character,
     2517    itext    as longchar ):
     2518       define variable vText as longchar no-undo.
     2519      if mFormatErr eq "text"
     2520      then do:
     2521         if icomment ne ""
     2522         then
     2523            icomment = substitute("comment:|&1|",icomment).
     2524         vText = icomment + itext.
     2525      end.
     2526      else do:
     2527         icomment = if icomment begins  '"'
     2528                    then icomment
     2529                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2530         vText = icomment + "," + itext.
     2531         vText = "~{" + trim(vText,",") + "~}".
     2532      end.
     2533      return vText.
     2534   end.
     2535   function CheckTypeForMarkLineType returns logical
     2536   (iObj            as handle,
     2537    iCheckType      as character,
     2538    iCodeErr        as character ,
     2539    iTypeErr        as character ):
     2540      define variable vRecKey-markLine as character no-undo.
     2541      define variable vGoodMark        as logical no-undo.
     2542      define variable vdb-num          as integer no-undo.
     2543      define variable vdoc-id          as integer no-undo.
     2544      define variable vlinenum         as integer no-undo.
     2545      define variable vErrorOne as character no-undo.
     2546      define buffer buf_utd-err for utd-err.
     2547      run gen-key-rec (input "utd-marking-lines",
     2548                       input  iObj,
     2549                       output vRecKey-markLine).
     2550      vGoodMark = yes.
     2551      vdb-num = iObj::db-num.
     2552      vdoc-id = iObj::doc-id.
     2553      vlinenum = iObj::linenum.
     2554      block-mark-err:
     2555      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2556                               and buf_utd-err.db-num = vdb-num
     2557                               and buf_utd-err.reckey = vRecKey-markLine
     2558                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2559                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2560      no-lock:
     2561         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2562         if     vErrorOne ne ?
     2563            and vErrorOne ne ""
     2564         then do:
     2565            vGoodMark = no.
     2566            leave block-mark-err.
     2567         end.
     2568      end.
     2569      return not vGoodMark.
     2570   end.
     2571   function CheckErrForMarkLineType returns logical
     2572   (iObj            as handle,
     2573    iType           as character  ):
     2574      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2575   end.
     2576   function CheckErrForMarkLine returns logical
     2577   (iObj            as handle):
     2578      return CheckErrForMarkLineType(iObj,"*").
     2579   end.
     2580   function CheckErrForLineTypeCode returns logical
     2581   (iObj                 as handle,
     2582    iCheckType           as character,
     2583    iCodeErr             as character,
     2584    iTypeErr             as character,
     2585    iOneErr              as logical):
     2586      define variable vRecKey-line     as character no-undo.
     2587      define buffer buf_utd-err for utd-err.
     2588      define variable vUtdlineError as logical no-undo.
     2589      define variable vErrorOne as character no-undo.
     2590            run gen-key-rec (input "utd-lines",
     2591                             input  iObj,
     2592                             output vRecKey-line).
     2593         define variable vdb-num as integer no-undo.
     2594         define variable vdoc-id as integer no-undo.
     2595         define variable vlinenum as integer no-undo.
     2596         vdb-num = iObj::db-num.
     2597         vdoc-id = iObj::doc-id.
     2598         vlinenum = iObj::linenum.
     2599         block-err:
     2600         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2601                                  and buf_utd-err.db-num = vdb-num
     2602                                  and buf_utd-err.reckey = vRecKey-line
     2603                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2604                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2605         no-lock:
     2606            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2607            if     vErrorOne ne ?
     2608               and vErrorOne ne ""
     2609            then do:
     2610               vUtdlineError = yes.
     2611               leave block-err.
     2612            end.
     2613         end.
     2614         if  not vUtdlineError
     2615         then do:
     2616            define variable vGoodMark as logical no-undo.
     2617            vGoodMark = yes.
     2618            block-line-err:
     2619            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2620                                         and utd-marking-lines.doc-id  eq vdoc-id
     2621                                         and utd-marking-lines.LineNum eq vLineNum
     2622            no-lock:
     2623               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2624               if     vGoodMark
     2625                  and iOneErr eq no
     2626               then
     2627                  leave block-line-err.
     2628               if     iOneErr = yes
     2629                  and not vGoodMark
     2630               then
     2631                  leave block-line-err.
     2632            end.
     2633            vUtdlineError = not vGoodMark.
     2634         end.
     2635      return vUtdlineError.
     2636   end.
     2637   function getErrForLineType returns character
     2638   (iObj            as handle,
     2639    iType           as character  ):
     2640      define variable vRecKey-line     as character no-undo.
     2641      define buffer buf_utd-err for utd-err.
     2642      define variable vUtdlineError as logical no-undo.
     2643      define variable vErrorOne as character no-undo.
     2644      define variable oError as character no-undo.
     2645            run gen-key-rec (input "utd-lines",
     2646                             input  iObj,
     2647                             output vRecKey-line).
     2648         define variable vdb-num as integer no-undo.
     2649         define variable vdoc-id as integer no-undo.
     2650         define variable vlinenum as integer no-undo.
     2651         vdb-num = iObj::db-num.
     2652         vdoc-id = iObj::doc-id.
     2653         vlinenum = iObj::linenum.
     2654         block-err:
     2655         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2656                                  and buf_utd-err.db-num = vdb-num
     2657                                  and buf_utd-err.reckey = vRecKey-line
     2658                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2659         no-lock:
     2660            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2661            if     vErrorOne ne ?
     2662               and vErrorOne ne ""
     2663            then do:
     2664               oError = oError + vErrorOne + " ".
     2665            end.
     2666         end.
     2667      return oError.
     2668   end.
     2669   function CheckErrForLineType returns logical
     2670   (iObj            as handle,
     2671    iType           as character  ):
     2672       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2673   end.
     2674   function CheckErrForLine returns logical
     2675   (iObj            as handle):
     2676      return CheckErrForLineType(iobj,"*").
     2677   end.
     2678   function CheckErrForUtd returns logical
     2679   (idb-num         as integer ,
     2680    idoc-id         as integer ):
     2681      for each utd-lines where utd-lines.db-num eq idb-num
     2682                           and utd-lines.doc-id eq idoc-id
     2683      no-lock :
     2684         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2685         then
     2686            return no.
     2687      end.
     2688      return yes.
     2689   end.
     2690   function CheckMarkUtd-28rel return logical
     2691    (input idb-num as integer,
     2692    input idoc-id as integer):
     2693    define buffer utd                   for utd.
     2694    define buffer utd-lines             for utd-lines.
     2695    define buffer utd-marking-lines     for utd-marking-lines.
     2696    define variable v-par-type as character no-undo.
     2697    define variable vgdsNoMark as logical no-undo.
     2698    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2699      define variable v-par-val  as character no-undo.
     2700      find first utd where utd.db-num eq idb-num
     2701                       and utd.doc-id eq idoc-id
     2702      no-lock no-error.
     2703      if available utd
     2704      then do:
     2705         if     utd.obj-code ne ?
     2706            and utd.obj-type ne ?
     2707         then do:
     2708            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2709            Block-utd-lines:
     2710            for each utd-lines where utd-lines.db-num eq idb-num
     2711                                 and utd-lines.doc-id eq idoc-id
     2712            no-lock:
     2713               if     utd-lines.gds-code ne ?
     2714                  and utd-lines.gds-code ne 0
     2715               then do:
     2716                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2717                       ( utd-lines.gds-code,
     2718                         'mark-type':U,
     2719                          output v-par-val,
     2720                          output v-par-type
     2721                       ).
     2722                  if     EDOParSec:IsEdo
     2723                     and EDOParSec:GetIsEDOForType(v-par-val)
     2724                  then do:
     2725                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2726                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2727                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2728                                                    and length(utd-marking-lines.mark) > 13
     2729                     no-lock no-error.
     2730                     if     avail utd-marking-lines
     2731                        and not CheckErrForLine(buffer utd-lines:handle)
     2732                     then
     2733                        leave Block-utd-lines.
     2734                  end.
     2735                  else
     2736                     vgdsNoMark = yes.
     2737               end.
     2738            end.
     2739            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2740            if vgdsNoMark then return available utd-lines . else return yes .
     2741         end.
     2742      end.
     2743      return yes.
     2744   end.
     2745   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2746   function CheckMarkUtd return logical
     2747    (input idb-num  as integer,
     2748     input idoc-id  as integer):
     2749     define buffer utd-lines             for ub.utd-lines.
     2750     block-line:
     2751     for each utd-lines where utd-lines.db-num eq idb-num
     2752                          and utd-lines.doc-id eq idoc-id
     2753     no-lock:
     2754        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2755        then
     2756           leave block-line.
     2757     end.
     2758     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2759     return available utd-lines.
     2760   end.
     2761   function CheckNotMarkUtd return logical
     2762    (input idb-num  as integer,
     2763     input idoc-id  as integer):
     2764     define buffer utd-lines             for ub.utd-lines.
     2765     for each utd-lines where utd-lines.db-num eq idb-num
     2766                          and utd-lines.doc-id eq idoc-id
     2767     no-lock:
     2768        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2769        then
     2770           return yes.
     2771     end.
     2772     return no.
     2773   end.
     2774   function CheckMarkUtdLine return logical
     2775    (input idb-num  as integer,
     2776     input idoc-id  as integer,
     2777     input iLineNum as integer):
     2778    define buffer utd                   for utd.
     2779    define buffer utd-lines             for utd-lines.
     2780    define buffer utd-marking-lines     for utd-marking-lines.
     2781    define variable v-par-type as character no-undo.
     2782    define variable vMarking        as logical no-undo.
     2783    define variable vArtic          as logical no-undo.
     2784    define variable vTransitional   as logical no-undo.
     2785    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2786      define variable v-par-val  as character no-undo.
     2787      find first utd where utd.db-num eq idb-num
     2788                       and utd.doc-id eq idoc-id
     2789      no-lock no-error.
     2790      if available utd
     2791      then do:
     2792         if     utd.obj-code ne ?
     2793            and utd.obj-type ne ?
     2794         then do:
     2795            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2796            Block-utd-lines:
     2797            for each utd-lines where utd-lines.db-num   eq idb-num
     2798                                 and utd-lines.doc-id   eq idoc-id
     2799                                 and utd-lines.LineNum  eq iLineNum
     2800            no-lock:
     2801               if     utd-lines.gds-code ne ?
     2802                  and utd-lines.gds-code ne 0
     2803               then do:
     2804                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2805                       ( utd-lines.gds-code,
     2806                         'mark-type':U,
     2807                          output v-par-val,
     2808                          output v-par-type
     2809                       ).
     2810                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2811                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2812                  if vMarking
     2813                  then do:
     2814                     block-marking:
     2815                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2816                                                    and utd-marking-lines.doc-id   eq idoc-id
     2817                                                    and utd-marking-lines.LineNum  eq iLineNum
     2818                                                    and length(utd-marking-lines.mark) > 13
     2819                     no-lock:
     2820                        if isOAD(utd-marking-lines.mark)
     2821                        then do:
     2822                           assign
     2823                              vArtic   = yes
     2824                              vMarking = no
     2825                           .
     2826                           leave block-marking.
     2827                        end.
     2828                     end.
     2829                  end.
     2830                  if vArtic
     2831                  then do:
     2832                     block-artic:
     2833                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2834                                                    and utd-marking-lines.doc-id   eq idoc-id
     2835                                                    and utd-marking-lines.LineNum  eq iLineNum
     2836                                                    and length(utd-marking-lines.mark) > 13
     2837                     no-lock:
     2838                        if isMark(utd-marking-lines.mark)
     2839                        then do:
     2840                           assign
     2841                              vArtic   = no
     2842                              vMarking = yes
     2843                           .
     2844                           leave block-artic.
     2845                        end.
     2846                     end.
     2847                  end.
     2848                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2849                  if vTransitional
     2850                  then do:
     2851                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2852                                                    and utd-marking-lines.doc-id   eq idoc-id
     2853                                                    and utd-marking-lines.LineNum  eq iLineNum
     2854                                                    and length(utd-marking-lines.mark) > 13
     2855                     no-lock no-error.
     2856                     if not available utd-marking-lines
     2857                     then assign
     2858                        vMarking = no
     2859                        vArtic   = no
     2860                     .
     2861                  end.
     2862               end.
     2863               else
     2864                  assign
     2865                     vMarking      = yes
     2866                     vArtic        = no
     2867                     vTransitional = no
     2868                  .
     2869               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2870               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2871               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2872            end.
     2873         end.
     2874      end.
     2875      return vMarking or vArtic.
     2876   end.
     2877   function getMarkUtdLine return logical
     2878    (input  idb-num  as integer,
     2879     input  idoc-id  as integer,
     2880     input  iLineNum as integer,
     2881     output oMarking        as logical,
     2882     output oArtic          as logical,
     2883     output oTransitional   as logical):
     2884     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2885     oArtic        = not oMarking
     2886            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2887     oTransitional = (oMarking or oArtic)
     2888            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2889   end.
     2890   function CheckMarking return logical
     2891    (input idb-num as integer,
     2892    input idoc-id as integer,
     2893    input iTypeErr as character ):
     2894     define variable vMarkutd as logical no-undo.
     2895     define variable vCrErr   as logical no-undo.
     2896     define buffer utd-lines         for utd-lines.
     2897     define buffer utd-marking-lines for utd-marking-lines.
     2898     define buffer marking           for marking.
     2899     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2900      block-line:
     2901      for each utd-lines where utd-lines.db-num eq idb-num
     2902                           and utd-lines.doc-id eq idoc-id
     2903      no-lock:
     2904         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2905         then do:
     2906            for each utd-marking-lines
     2907                     where utd-marking-lines.db-num  = utd-lines.db-num
     2908                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2909                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2910            no-lock:
     2911               if isMark(utd-marking-lines.mark)
     2912               then do:
     2913                  find first marking where marking.mark eq utd-marking-lines.mark
     2914                  no-lock no-error.
     2915                  if not available marking
     2916                  then do:
     2917                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2918                     vCrErr = yes.
     2919                     next block-line.
     2920                  end.
     2921               end.
     2922            end.
     2923         end.
     2924      end.
     2925      return vCrErr.
     2926   end.
     2927   function CheckMarkForType return logical
     2928    (input idb-num   as integer,
     2929     input idoc-id   as integer):
     2930      define variable vMarking        as logical no-undo.
     2931      define variable vArtic          as logical no-undo.
     2932      define variable vTransitional   as logical no-undo.
     2933      define buffer utd-lines         for utd-lines.
     2934      define buffer utd-marking-lines for utd-marking-lines.
     2935      block-line:
     2936      for each utd-lines where utd-lines.db-num eq idb-num
     2937                           and utd-lines.doc-id eq idoc-id
     2938      no-lock:
     2939         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2940                          output vMarking         , output vArtic          , output vTransitional).
     2941         for each utd-marking-lines
     2942                     where utd-marking-lines.db-num  = utd-lines.db-num
     2943                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2944                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2945         no-lock:
     2946            if length(utd-marking-lines.mark) < 14
     2947            then do:
     2948               if (vMarking or vArtic) and not vTransitional
     2949               then
     2950                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2951            end.
     2952            else if not isMark(utd-marking-lines.mark)
     2953            then do:
     2954               if vMarking
     2955               then
     2956                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2957            end.
     2958            else do:
     2959            end.
     2960         end.
     2961      end.
     2962   end.
     2963   function WeighedProd return logical
     2964      ( input p-gds-code as integer) :
     2965      define variable v-par-val  as character no-undo.
     2966      define variable v-par-type as character no-undo.
     2967              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2968               ( p-gds-code,
     2969                 'weighed-gds':U,
     2970                  output v-par-val,
     2971                  output v-par-type
     2972               ).
     2973      return logical(v-par-val).
     2974   end.
     2975   function WghProdVariable return logical
     2976       (input p-obj-type as char,
     2977        input p-obj-code as integer,
     2978        input p-gds-code as integer) :
     2979      define variable v-wgh-val  as character no-undo.
     2980      define variable v-par-val  as character no-undo.
     2981      define variable v-par-type as character no-undo.
     2982      define variable vMarking        as logical no-undo.
     2983      define variable vArtic          as logical no-undo.
     2984      define variable vTransitional   as logical no-undo.
     2985      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2986         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2987           ( p-gds-code,
     2988             'weighed-gds':U,
     2989              output v-wgh-val,
     2990              output v-par-type
     2991           ).
     2992       if logical(v-wgh-val) = yes then do:
     2993           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2994               ( p-gds-code,
     2995                 'mark-type':U,
     2996                  output v-par-val,
     2997                  output v-par-type
     2998               ).
     2999           if v-par-val <> "" then do:
     3000               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3001               assign
     3002                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3003                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3004                  .
     3005           end.
     3006      end.
     3007      if v-wgh-val > "" and (vMarking or vArtic)
     3008      then return yes.
     3009      else return no.
     3010   end.
     3011   function MarkWeight return decimal
     3012      ( input p-mark as character) :
     3013      define buffer  buf_marking-attr for  ub.marking-attr.
     3014      define variable vMarkWeight as decimal no-undo.
     3015      vMarkWeight = 0.
     3016      if p-mark <> "" and p-mark <> ?
     3017      then do:
     3018          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3019                                        and buf_marking-attr.attr-code eq "weight"
     3020             no-lock no-error.
     3021          if not available buf_marking-attr
     3022          then do :
     3023            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3024                                          and buf_marking-attr.attr-code eq "weight"
     3025               no-lock no-error.
     3026          end .
     3027          if avail buf_marking-attr
     3028          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3029      end.
     3030      return vMarkWeight.
     3031   end.
     3032   define temp-table tt-gtin-qnty no-undo
     3033     field gtin as character
     3034     field qnty as integer
     3035     field qntyDoc as integer
     3036     field order as integer
     3037   .
     3038   define input  parameter  p-db-num as integer no-undo.
     3039   define input  parameter  p-doc-id as integer no-undo.
     3040   define input  parameter  p-userId as character no-undo.
     3041   define variable iDbNum as integer no-undo.
     3042   MAIN-BLOCK:
     3043   do:
     3044     define variable num-rec-ok as logical no-undo.
     3045     define variable ii         as integer no-undo.
     3046     define variable vMarkUtd   as logical no-undo init no .
     3047     define variable v-par-type as character no-undo.
     3048     define variable v-par-val  as character no-undo.
     3049     def buffer buf_utd for ub.utd.
     3050     def buffer buf_utd-attr for ub.utd-attr.
     3051     def buffer buf_utd-lines for ub.utd-lines.
     3052     def buffer buf_utd-marking-lines for ub.utd-marking-lines.
     3053     def buffer buf_utd-marking-lines-attr for ub.utd-marking-lines-attr.
     3054     def buffer buf_mark-lines for ub.marking-lines.
     3055     def buffer buf_marking for ub.marking.
     3056     def buffer buf_bar-code for ub.bar-code.
     3057     define variable vGtin as character no-undo .
     3058     define variable vGtinQnty as integer no-undo .
     3059     define variable vGtinList as character no-undo .
     3060     define variable vGtinDocQntyList as character no-undo .
     3061     define variable vGtinFactQntyList as character no-undo .
     3062     define variable vScanGtin as character no-undo .
     3063     define variable vFullQnty as integer no-undo .
     3064     define variable vGT as integer no-undo .
     3065     define variable vGtinSumDocQnty as integer no-undo .
     3066     define variable vOrder as integer no-undo .
     3067     define variable vIsMarkLine as logical no-undo .
     3068     define variable vIsWeight as logical no-undo .
     3069     define variable vMaxDocLevel as integer no-undo .
     3070     define variable vunit     as int no-undo.
     3071     define variable vunitCode as character no-undo.
     3072     define variable vCount     as int no-undo.
     3073     find first buf_utd where buf_utd.db-num = p-db-num and buf_utd.doc-id = p-doc-id no-error.
     3074     if not available (buf_utd)
     3075       then undo, return error "Не найден УТД - " + string(p-db-num) + "," + string(p-doc-id).
     3076     if     buf_utd.sts ne objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
     3077        and buf_utd.sts ne objSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3078        and buf_utd.sts ne objSrv:Env:Utd:Sts:TH:SignatureRequired   :KeyIntDB
     3079     then do:
     3080       undo, return error substitute ("Неверный статус документа УТД &1,&2 - &3&4Накладные можно создать в статусах: &4&5&4&6&4&7",
     3081                                      p-db-num,
     3082                                      p-doc-id,
     3083                                      objSrv:Env:Utd:Sts:TH:GetLabel(buf_utd.sts),
     3084                                      chr(10),
     3085                                      objSrv:Env:Utd:Sts:TH:Confirmed           :Label_,
     3086                                      objSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:Label_,
     3087                                      objSrv:Env:Utd:Sts:TH:SignatureRequired   :Label_)
     3088                                      .
     3089     end.
     3090     if buf_utd.EDocType ne objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3091     then do:
     3092       undo, return error "Неверный тип документа УТД " + string(p-db-num) + "," +  string(p-doc-id) + " - " + objSrv:Env:Utd:EDocType:GetLabel(buf_utd.EDocType).
     3093     end.
     3094     if buf_utd.doc-code <> "" and can-find (first ub.trn-doc where ub.trn-doc.doc-code = buf_utd.doc-code)
     3095     then do:
     3096       undo, return "Для документа c вн. номером " + string(p-db-num) + "_" + string(p-doc-id) + " уже создана накладная - " + buf_utd.doc-code.
     3097     end.
     3098     create temp_trn-doc.
     3099     assign
     3100       temp_trn-doc.line-num      = ii
     3101       temp_trn-doc.utdDocumentExt = buf_utd.DocumentExt
     3102       temp_trn-doc.utdOrganizationExt = buf_utd.OrganizationExt
     3103       temp_trn-doc.db-num = buf_utd.db-num
     3104       temp_trn-doc.doc-id = buf_utd.doc-id
     3105       temp_trn-doc.doc-date      = buf_utd.DocumentDate
     3106       temp_trn-doc.ps            = buf_utd.comment
     3107       temp_trn-doc.doc-code      = buf_utd.DocumentNumber
     3108       temp_trn-doc.ext-doc-type  = "ie"
     3109       temp_trn-doc.cli-type      = buf_utd.cli-type
     3110       temp_trn-doc.cli-code      = buf_utd.cli-code
     3111       temp_trn-doc.obj-type      = buf_utd.obj-type
     3112       temp_trn-doc.obj-code      = buf_utd.obj-code
     3113       temp_trn-doc.exch-code     = 0
     3114       temp_trn-doc.exch-rate     = 1
     3115       temp_trn-doc.exch-scale    = 1
     3116       temp_trn-doc.contract-code = buf_utd.contract-code
     3117       temp_trn-doc.host-code = buf_utd.host-code
     3118       .
     3119     define variable Tree           as class     tree no-undo .
     3120     Tree = ObjSrv:Lib:MarkingTree .
     3121     fe_:
     3122     for each buf_utd-lines where buf_utd-lines.db-num = buf_utd.db-num
     3123                              and buf_utd-lines.doc-id = buf_utd.doc-id
     3124                              and buf_utd-lines.sts ne objSrv:Env:Utd:Sts:TH:LoadError:KeyIntDB
     3125     no-lock:
     3126       if buf_utd-lines.gds-code eq ?
     3127         then next fe_.
     3128       def var sum-vat as decimal no-undo.
     3129       def var v-q as decimal no-undo.
     3130       def var v-q-doc as decimal no-undo.
     3131       def var v-q-doc-base  as decimal no-undo.
     3132       v-q = 0.
     3133       if buf_utd-lines.TaxRate = -1
     3134       then
     3135         temp_trn-doc.vat-type = 'без':U
     3136       .
     3137           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3138       ( buf_utd-lines.gds-code,
     3139        'mark-type':U,
     3140        output v-par-val,
     3141        output v-par-type
     3142       ).
     3143       assign
     3144         vunitCode = buf_utd-lines.UnitCode when buf_utd-lines.UnitCode ne ? and buf_utd-lines.UnitCode ne ""
     3145         vunit = ?
     3146         vunit = integer (getattrutdlines(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,"unit"))
     3147       no-error.
     3148       if vunit ne 0 and vunit ne ?
     3149       then do:
     3150         find units where units.OKEI eq vunit no-lock no-error.
     3151         if available units
     3152         then
     3153           vunitCode = units.unit-name.
     3154       end.
     3155       vIsWeight = WghProdVariable(buf_utd.obj-type, buf_utd.obj-code, buf_utd-lines.gds-code).
     3156       if logical (getAttrUtdLinesEx(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,"MarkUtdLine","no"))
     3157       then do :
     3158         vIsMarkLine = yes .
     3159         if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_utd.obj-type, buf_utd.obj-code):GetIsMarkingForType(v-par-val)
     3160         then do:
     3161           if vIsWeight then do:
     3162              for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3163                   and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3164                   and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
     3165                   and buf_utd-marking-lines.doc-level = 1
     3166                 no-lock:
     3167                 if buf_utd-marking-lines.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB then
     3168                 v-q = v-q + MarkWeight(buf_utd-marking-lines.mark).
     3169              end.
     3170           end.
     3171           else
     3172           v-q = Tree:GetQntyStsUnit(buf_utd-lines.db-num, buf_utd-lines.doc-id, buf_utd-lines.LineNum,objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB).
     3173         end.
     3174         else do:
     3175           LABEL_1:
     3176           for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3177             and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3178             and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
     3179             and buf_utd-marking-lines.doc-level = 1
     3180             no-lock:
     3181               if vIsWeight then do:
     3182                  if buf_utd-marking-lines.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB then
     3183                  v-q = v-q + MarkWeight(buf_utd-marking-lines.mark).
     3184               end.
     3185               else do:
     3186                find first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark no-lock no-error.
     3187                if buf_utd-marking-lines.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB and
     3188                   buf_marking.box-qnty <> ? then
     3189                do:
     3190                  v-q = v-q + buf_marking.box-qnty.
     3191                end.
     3192                else do:
     3193                  v-q = v-q + Tree:GetQntySts(buf_utd-marking-lines.mark, objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB).
     3194                  do vCount = 1 to num-entries(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait):
     3195                    v-q = v-q + Tree:GetQntySts(buf_utd-marking-lines.mark, int(entry(vCount,objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait))).
     3196                  end.
     3197                  do vCount = 1 to num-entries(objSrv:Env:Marking:Sts:Mark:Doc_Status):
     3198                    v-q = v-q + Tree:GetQntySts(buf_utd-marking-lines.mark, int(entry(vCount,objSrv:Env:Marking:Sts:Mark:Doc_Status))).
     3199                  end.
     3200                end.
     3201               end.
     3202           end.
     3203         end.
     3204         v-q-doc-base = buf_utd-lines.Quantity.
     3205         v-q-doc = decimal(GetAttrUtdlinesex(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.linenum,"Quantity",string(v-q-doc-base))) .
     3206         if v-q-doc = ?
     3207         then do :
     3208           find first buf_bar-code where
     3209                      buf_bar-code.gds-code = buf_utd-lines.gds-code
     3210                  and buf_bar-code.unit-cli = buf_utd-lines.UnitCode
     3211           no-lock no-error.
     3212           v-q-doc = v-q-doc-base / (if avail buf_bar-code then buf_bar-code.cli-base-rate else 1) .
     3213         end .
     3214       end .
     3215       else do :
     3216         vIsMarkLine = no .
     3217         find first buf_bar-code where
     3218                    buf_bar-code.gds-code = buf_utd-lines.gds-code
     3219                and buf_bar-code.unit-cli = vUnitCode
     3220         no-lock no-error.
     3221         v-q = decimal(GetAttrUtdlines(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.linenum,"QuantityBarCode")).
     3222         if v-q = ? then v-q = 0.
     3223         v-q-doc = decimal(GetAttrUtdlinesex(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.linenum,"Quantity",string(buf_utd-lines.Quantity))) .
     3224         v-q-doc-base = v-q-doc * (if avail buf_bar-code then buf_bar-code.cli-base-rate else 1).
     3225         if v-q-doc = ?
     3226         then do :
     3227           v-q-doc = buf_utd-lines.Quantity.
     3228           v-q-doc-base = v-q-doc * (if avail buf_bar-code then buf_bar-code.cli-base-rate else 1).
     3229         end .
     3230       end .
     3231       if CheckErrForLine(buffer buf_utd-lines:handle)
     3232       then
     3233         v-q = 0.
     3234       sum-vat = (buf_utd-lines.Total - buf_utd-lines.TotalWithVatExcluded) / v-q-doc.
     3235       create temp_doc-line.
     3236       assign
     3237         temp_doc-line.line-num   = buf_utd-lines.LineNum
     3238         temp_doc-line.db-num = buf_utd-lines.db-num
     3239         temp_doc-line.doc-id = buf_utd-lines.doc-id
     3240         temp_doc-line.gds-code   = buf_utd-lines.gds-code
     3241         temp_doc-line.fact-qnty  = v-q
     3242         temp_doc-line.doc-qnty   = v-q-doc-base
     3243         temp_doc-line.cli-qnty   = v-q-doc
     3244         temp_doc-line.unit-cli   = vUnitCode
     3245         temp_doc-line.price-cli  = buf_utd-lines.Total / (if vMarkUtd then buf_utd-lines.Quantity else temp_doc-line.cli-qnty)
     3246         temp_doc-line.price-rubl = buf_utd-lines.Total / (if vMarkUtd then buf_utd-lines.Quantity else temp_doc-line.cli-qnty)
     3247         temp_doc-line.doc-code   = temp_trn-doc.doc-code
     3248         temp_doc-line.vat-pc     = 100 * sum-vat / (buf_utd-lines.TotalWithVatExcluded / temp_doc-line.cli-qnty)
     3249         temp_doc-line.isWeight   = vIsWeight
     3250       .
     3251       if buf_utd-lines.TaxRate <> round ( temp_doc-line.vat-pc, 1 )
     3252       and temp_doc-line.price-rubl < 10
     3253       and abs(buf_utd-lines.TaxRate - temp_doc-line.vat-pc) < 1
     3254       then do :
     3255         temp_doc-line.vat-pc = buf_utd-lines.TaxRate .
     3256       end .
     3257       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_utd.obj-type, buf_utd.obj-code):GetIsArticForType(v-par-val)
     3258       or logical(getattrutdlinesex(buf_utd-lines.db-num, buf_utd-lines.doc-id, buf_utd-lines.LineNum, "ArticUtdLine", "no"))
     3259       then do:
     3260         if vIsWeight then do:
     3261            uml_:
     3262            for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3263                                                     and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3264                                                     and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum,
     3265                first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
     3266            :
     3267                vGtin = getGtinByDM(buf_utd-marking-lines.mark) .
     3268                temp_doc-line.gtinline = vGtin.
     3269                leave uml_.
     3270            end.
     3271         end.
     3272         else do:
     3273         assign
     3274           vGtinList = ""
     3275           vGtinDocQntyList = ""
     3276           vGtinFactQntyList = ""
     3277         .
     3278         if vIsMarkLine
     3279         then do :
     3280           vMaxDocLevel = 1 .
     3281           for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3282                                            and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3283                                            and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
     3284           :
     3285             vMaxDocLevel = max(vMaxDocLevel, buf_utd-marking-lines.doc-level) .
     3286           end .
     3287         end .
     3288         utd-marking-lines_ :
     3289         for each buf_utd-marking-lines where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3290                                          and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3291                                          and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum
     3292         :
     3293           if vIsMarkLine then
     3294           do:
     3295             if can-find(first buf_marking where buf_marking.mark-parent = buf_utd-marking-lines.mark) then
     3296             do:
     3297               next utd-marking-lines_ .
     3298             end.
     3299             find first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark no-lock no-error.
     3300             if avail buf_marking and
     3301                not can-do(objSrv:Env:Marking:Sts:Mark:AllChecked, string(buf_marking.sts)) then
     3302             do:
     3303               next utd-marking-lines_ .
     3304             end.
     3305           end.
     3306           vGtin = getGtinByDM(buf_utd-marking-lines.mark) .
     3307           if vGtin > ""
     3308           then do :
     3309             vGtinQnty = 0 .
     3310             find first buf_marking where buf_marking.mark = buf_utd-marking-lines.mark
     3311                                      and buf_marking.box-qnty > 0
     3312             no-lock no-error.
     3313             if available (buf_marking)
     3314             then do :
     3315               vGtinQnty = buf_marking.box-qnty .
     3316             end .
     3317             else do :
     3318               if vIsMarkLine
     3319               then do :
     3320                 next utd-marking-lines_ .
     3321               end .
     3322               vGtinQnty = getQntyUTDByCodId(buf_utd-marking-lines.mark) .
     3323             end .
     3324             if vGtinQnty > 0
     3325             then do :
     3326               if vGtinList > ""
     3327               and lookup(vGtin, vGtinList) > 0
     3328               then do :
     3329                 entry(lookup(vGtin, vGtinList), vGtinDocQntyList) = string(integer(entry(lookup(vGtin, vGtinList), vGtinDocQntyList)) + vGtinQnty) .
     3330                 entry(lookup(vGtin, vGtinList), vGtinFactQntyList) = string(integer(entry(lookup(vGtin, vGtinList), vGtinFactQntyList)) + (if temp_doc-line.fact-qnty = 0 then 0 else vGtinQnty)) .
     3331                 if temp_doc-line.fact-qnty = 0
     3332                 then
     3333                   entry(lookup(vGtin, vGtinList), vGtinDocQntyList) = string(integer(temp_doc-line.doc-qnty))
     3334                 .
     3335               end .
     3336               else do :
     3337                 vGtinList = vGtinList + vGtin + "," .
     3338                 vGtinDocQntyList = vGtinDocQntyList + string(if temp_doc-line.fact-qnty = 0 then temp_doc-line.doc-qnty else vGtinQnty) + "," .
     3339                 vGtinFactQntyList = vGtinFactQntyList + string(if temp_doc-line.fact-qnty = 0 then 0 else vGtinQnty) + "," .
     3340               end .
     3341               if integer(entry(lookup(vGtin, vGtinList), vGtinDocQntyList)) > temp_doc-line.doc-qnty
     3342               then do :
     3343                 entry(lookup(vGtin, vGtinList), vGtinDocQntyList) = string(integer(temp_doc-line.doc-qnty)) .
     3344               end .
     3345             end .
     3346           end .
     3347         end .
     3348         vGtinList = trim(vGtinList, ",") .
     3349         vGtinDocQntyList = trim(vGtinDocQntyList, ",") .
     3350         vGtinFactQntyList = trim(vGtinFactQntyList, ",") .
     3351         if temp_doc-line.fact-qnty <> temp_doc-line.doc-qnty
     3352         and temp_doc-line.fact-qnty > 0
     3353         then do :
     3354           empty temp-table tt-gtin-qnty .
     3355           vFullQnty = temp_doc-line.fact-qnty .
     3356           vScanGtin = getAttrUtdLinesEx(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.LineNum,"ScanGtin","") .
     3357           vOrder = 0 .
     3358           if vScanGtin > ""
     3359           then do :
     3360             vOrder = vOrder + 1 .
     3361             create tt-gtin-qnty .
     3362             assign
     3363               tt-gtin-qnty.gtin = vScanGtin
     3364               tt-gtin-qnty.qnty = 0
     3365               tt-gtin-qnty.order = vOrder
     3366             .
     3367           end .
     3368           do vGT = 1 to num-entries(vGtinList) :
     3369             find first tt-gtin-qnty where tt-gtin-qnty.gtin = entry(vGT, vGtinList) no-error .
     3370             if not available tt-gtin-qnty
     3371             then do :
     3372               vOrder = vOrder + 1 .
     3373               create tt-gtin-qnty .
     3374               assign
     3375                 tt-gtin-qnty.gtin = entry(vGT, vGtinList)
     3376                 tt-gtin-qnty.qnty = 0
     3377                 tt-gtin-qnty.qntyDoc = integer(entry(vGT, vGtinDocQntyList))
     3378                 tt-gtin-qnty.order = vOrder
     3379               .
     3380             end .
     3381             else do :
     3382               tt-gtin-qnty.qntyDoc = integer(entry(vGT, vGtinDocQntyList)) .
     3383             end .
     3384           end .
     3385           for each tt-gtin-qnty by tt-gtin-qnty.order :
     3386             tt-gtin-qnty.qnty = tt-gtin-qnty.qnty + 1 .
     3387             vFullQnty = vFullQnty - 1 .
     3388             if vFullQnty = 0
     3389             then leave .
     3390           end .
     3391           for each tt-gtin-qnty where tt-gtin-qnty.qnty = 0 :
     3392             delete tt-gtin-qnty .
     3393           end .
     3394           if vFullQnty > 0
     3395           then do :
     3396             for each tt-gtin-qnty by tt-gtin-qnty.order :
     3397               if (tt-gtin-qnty.qntyDoc - 1) >= vFullQnty
     3398               then do :
     3399                 tt-gtin-qnty.qnty = tt-gtin-qnty.qnty + vFullQnty .
     3400                 vFullQnty = 0 .
     3401                 leave .
     3402               end .
     3403               else do :
     3404                 tt-gtin-qnty.qnty = tt-gtin-qnty.qntyDoc .
     3405                 vFullQnty = vFullQnty - (tt-gtin-qnty.qntyDoc - 1) .
     3406               end .
     3407             end .
     3408           end .
     3409           assign
     3410             vGtinList = ""
     3411             vGtinDocQntyList = ""
     3412             vGtinFactQntyList = ""
     3413           .
     3414           for each tt-gtin-qnty by tt-gtin-qnty.order :
     3415             vGtinList = vGtinList + tt-gtin-qnty.gtin + "," .
     3416             vGtinDocQntyList = vGtinDocQntyList + string(tt-gtin-qnty.qntyDoc) + "," .
     3417             vGtinFactQntyList = vGtinFactQntyList + string(tt-gtin-qnty.qnty) + "," .
     3418           end .
     3419           vGtinList = trim(vGtinList, ",") .
     3420           vGtinDocQntyList = trim(vGtinDocQntyList, ",") .
     3421           vGtinFactQntyList = trim(vGtinFactQntyList, ",") .
     3422         end .
     3423         vGtinSumDocQnty = 0 .
     3424         do vGT = 1 to num-entries(vGtinList) :
     3425           vGtinSumDocQnty = vGtinSumDocQnty + integer(entry(vGT, vGtinDocQntyList)) .
     3426         end .
     3427         if vGtinSumDocQnty > temp_doc-line.doc-qnty
     3428         and not CheckErrForLine(buffer buf_utd-lines:handle)
     3429         then do :
     3430           if vGtinSumDocQnty <> temp_doc-line.doc-qnty then
     3431           do:
     3432             do vGT = 1 to num-entries(vGtinList) :
     3433               if integer(entry(vGT, vGtinFactQntyList)) >= integer(entry(vGT, vGtinDocQntyList))
     3434               then
     3435                 next .
     3436               entry(vGT, vGtinDocQntyList) = string(integer(entry(vGT, vGtinDocQntyList)) - 1) .
     3437               vGtinSumDocQnty = vGtinSumDocQnty - 1 .
     3438               if vGtinSumDocQnty = temp_doc-line.doc-qnty
     3439               then
     3440                 leave .
     3441             end .
     3442             if vGtinSumDocQnty <> temp_doc-line.doc-qnty then
     3443             do:
     3444               undo, return error substitute("По строке &1 общее кол-во &2 по строке не совпадает с общим кол-вом &3 по всем GTIN.",
     3445                                             temp_doc-line.line-num, temp_doc-line.doc-qnty, vGtinSumDocQnty).
     3446             end.
     3447           end .
     3448         end .
     3449         assign
     3450           temp_doc-line.gtinList = vGtinList
     3451           temp_doc-line.gtinDocQntyList = vGtinDocQntyList
     3452           temp_doc-line.gtinFactQntyList = vGtinFactQntyList
     3453         .
     3454         end .
     3455       end.
     3456     end.
     3457     if not can-find (first temp_doc-line no-lock where temp_doc-line.fact-qnty > 0)
     3458     then do:
     3459       return error substitute ("В УПД &1 от &2 нет позиций для включения в приходную накладную", buf_utd.DocumentNumber, buf_utd.DocumentDate).
     3460     end.
     3461   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3463     (output iDbNum
     3464     )  .
     3465     def var v-msg as character no-undo.
     3466     def var v-gnews as logical no-undo.
     3467     def var v-gesys as logical no-undo.
     3468     v-gnews = g#news.
     3469     v-gesys = g#esys.
     3470     g#news = false.
     3471     run ibs/th/str/utd/trnutd.p (
     3472       input this-procedure ,
     3473       input this-procedure ,
     3474       input table temp_trn-doc ,
     3475       input table temp_doc-line ,
     3476       input table tt-excisemarks,
     3477       output v-msg,
     3478       output num-rec-ok
     3479       ) no-error .
     3480     if error-status:error
     3481       then do:
     3482         g#news = v-gnews.
     3483         g#esys = v-gesys.
     3484         undo, return error (return-value + " " + v-msg).
     3485       end.
     3486     g#news = v-gnews.
     3487     g#esys = v-gesys.
     3488     if iDbNum ne 0
     3489     then do:
     3490       run nws/cmdchgutd.p (buffer buf_utd) no-error.
     3491       if error-status:error
     3492       then do:
     3493         undo, return error return-value.
     3494       end.
     3495     end.
     3496     return v-msg.
     3497   end.
     3498   procedure pcall-log-file:
     3499     define input parameter msg as character no-undo.
     3500   end.
     3501   procedure get-db-num:
     3502     define output parameter pDbNum as integer no-undo.
     3503     pDbNum = iDbNum.
     3504   end.
     3505   procedure get-userid:
     3506     define output parameter pUserId as character no-undo.
     3507     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = p-userId no-error.
     3508     if available ub.user-login
     3509     then
     3510     do:
     3511       assign
     3512         pUserId  = p-userId
     3513         .
     3514     end.
     3515     else
     3516     do:
     3517       assign
     3518         pUserId = p-userId
     3519         .
     3520     end.
     3521   end.
     3522   procedure mainmenu_getcntxt :
     3523   define output parameter p-cntxt-db-num                as integer   no-undo .
     3524   define output parameter p-cntxt-userid                as character no-undo .
     3525   define output parameter p-cntxt-level                 as character no-undo .
     3526   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
     3527   define output parameter p-cntxt-obj-type              as character no-undo .
     3528   define output parameter p-cntxt-obj-code              as integer   no-undo .
     3529   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
     3530   define output parameter p-cntxt-is-admin              as logical   no-undo .
     3531     do
     3532     on error undo, return error return-value
     3533     :
     3534     define variable vt-host-code as integer   no-undo .
     3535     find first temp_trn-doc no-error.
     3536   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3538     (input  temp_trn-doc.obj-type
     3539     ,input  temp_trn-doc.obj-code
     3540     ,output p-cntxt-db-num-obj
     3541     )  .
     3542   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3544     (input  temp_trn-doc.obj-type
     3545     ,input  temp_trn-doc.obj-code
     3546     ,output vt-host-code
     3547     )  .
     3548     assign
     3549       p-cntxt-db-num          =  p-cntxt-db-num-obj
     3550       p-cntxt-userid          =  p-userId
     3551       p-cntxt-level           =  v-cntxt-level
     3552       p-cntxt-host-code-obj   =  vt-host-code
     3553       p-cntxt-obj-type        =  temp_trn-doc.obj-type
     3554       p-cntxt-obj-code        =  temp_trn-doc.obj-code
     3555       p-cntxt-is-admin        =  v-cntxt-is-admin
     3556     .
     3557     end.
     3558   end procedure.
     3559   procedure chk-is-addcharges :
     3560     define output parameter p-enable-item as logical   no-undo .
     3561     define variable v-is-add as character no-undo .
     3562     define variable par-type   as character no-undo .
     3563     do
     3564     on error undo, return error return-value
     3565     :
     3566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3567     (input  'is-addch':u
     3568     ,input  '':u
     3569     ,input  '':u
     3570     ,input  0
     3571     ,input  '':u
     3572     ,input  '':u
     3573     ,input  '':u
     3574     ,input  no
     3575     ,output v-is-add
     3576     ,output par-type
     3577     ) no-error .
     3578       if v-is-add = 'yes'
     3579       then do:
     3580         assign
     3581           p-enable-item = true
     3582         .
     3583       end.
     3584       else do:
     3585         assign
     3586           p-enable-item = false
     3587         .
     3588       end.
     3589     end.
     3590   end procedure.
     3591   procedure get-report-num :
     3592     define output parameter p-report-num as integer no-undo .
     3593      do
     3594      on error undo, return error return-value
     3595      :
     3596       assign
