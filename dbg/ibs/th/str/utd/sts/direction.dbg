        1   using Progress.Lang.*.
        2   using ibs.th.gbl.TypeMap.
        3   using ibs.th.gbl.propmap.
        4   using ibs.th.gbl.map.mapstring.
        5   using ibs.th.gbl.sys.objth.
        6   block-level on error undo, throw.
        7   class ibs.th.str.utd.sts.direction inherits TypeMap:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Направление документов ЭДО" get.
       14     define public property Inbound as class propmap no-undo get.
       15       protected set.
       16     define public property Outbound as class propmap no-undo get.
       17       protected set.
       18     define public property Internal as class propmap no-undo get.
       19       protected set.
       20     define public property DirectionMap as class mapstring no-undo get.
       21       protected set.
       22     define public property CurrDirectionMapProp as class propmap no-undo
       23     get:
       24       def var currP as class propmap no-undo.
       25       currP = cast (DirectionMap:SubjectObjCurr, propmap) no-error.
       26       if currP = ? or error-status:error
       27       then do:
       28         "Залогируем".
       29         return ?.
       30       end.
       31       else return currP.
       32     end.
       33     constructor public direction ():
       34   DirectionMap = new mapstring (true).
       35   ObjSrv:Regobj(this-object,DirectionMap,
       36   "DirectionMap"
       37   ) .
       38       Inbound  = crProp("Inbound", "входящий документ").
       39       Outbound = crProp("Outbound", "исходящий документ").
       40       Internal = crProp("Internal", "внутренний документ").
       41     end.
       42   end class.
