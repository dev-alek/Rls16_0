        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.map.mapstring.
        4   using ibs.th.gbl.sys.objth.
        5   using ibs.th.gbl.TypeMap.
        6   block-level on error undo, throw.
        7   class ibs.th.str.utd.sts.receipt inherits TypeMap:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Статусы документов выбытия" get.
       14     define public property GeneralReceiptStsNotAcceptable as class propmap no-undo get.
       15       protected set.
       16     define public property HaveToCreateReceipt as class propmap no-undo get.
       17       protected set.
       18     define public property WaitingForReceipt  as class propmap no-undo get.
       19       protected set.
       20     define public property Finished  as class propmap no-undo get.
       21       protected set.
       22     constructor public receipt ():
       23       super().
       24       GeneralReceiptStsNotAcceptable  = crProp("GeneralReceiptStsNotAcceptable", "ИОП на документ не запрошен").
       25       HaveToCreateReceipt  = crProp("HaveToCreateReceipt", "нужно подписать ИОП на документ").
       26       WaitingForReceipt  = crProp("WaitingForReceipt", "ожидание подписания ИОПа на документ").
       27       Finished  = crProp("Finished", "ИОП подписано. Действий не требуется").
       28     end.
       29   end class.
