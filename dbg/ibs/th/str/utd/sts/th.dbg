        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.map.mapstring.
        4   using ibs.th.gbl.sys.objth.
        5   using ibs.th.gbl.sys.objsrv.
        6   using ibs.th.gbl.TypeMap.
        7   block-level on error undo, throw.
        8   class ibs.th.str.utd.sts.th inherits TypeMap:
        9     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       10     define override public property vss-author      as character no-undo init "$Author:$":U get.
       11     define override public property vss-date        as character no-undo init "$Date:$":U get.
       12     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       13     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       14     define override public property vss-description as character no-undo init "Статусы ЭДО в TH" get.
       15     define public property  NewStatus  as class propmap no-undo get.  protected set.
       16     define public property  ReceivedFromSupplier  as class propmap no-undo get.  protected set.
       17     define public property  VerificationPassed  as class propmap no-undo get.  protected set.
       18     define public property  RequiresAdjustment  as class propmap no-undo get.  protected set.
       19     define public property  AwaitingDelivery  as class propmap no-undo get.  protected set.
       20     define public property  SignatureRequired as class propmap no-undo get.  protected set.
       21     define public property  AwaitingConfirmation  as class propmap no-undo get.  protected set.
       22     define public property  CorrectionRequested as class propmap no-undo get.  protected set.
       23     define public property  Confirmed as class propmap no-undo get.  protected set.
       24     define public property  CancellationRequest as class propmap no-undo get.  protected set.
       25     define public property  Canceled as class propmap no-undo get.  protected set.
       26     define public property  LackOfMarkingCodesInCirculation as class propmap no-undo get.  protected set.
       27     define public property  DeliveryCodeMismatch as class propmap no-undo get.  protected set.
       28     define public property  InconsistencyWithSupplyContract as class propmap no-undo get.  protected set.
       29     define public property  LoadError as class propmap no-undo get.  protected set.
       30     define public property  edocError as class propmap no-undo get.  protected set.
       31     define public property  RejectionUtd as class propmap no-undo get.  protected set.
       32     define public property  ConfirmedUcd as class propmap no-undo get.  protected set.
       33     define public property  LinesInError as class propmap no-undo get.  protected set.
       34     define public property  Rejection as class propmap no-undo get.  protected set.
       35     define public property  LK_RECEIPT_New as class propmap no-undo get.  protected set.
       36     define public property  LK_RECEIPT_Signed as class propmap no-undo get.  protected set.
       37     define public property  LK_RECEIPT_Sent as class propmap no-undo get.  protected set.
       38     define public property  LK_RECEIPT_Confirmed as class propmap no-undo get.  protected set.
       39     define public property  LK_RECEIPT_Error as class propmap no-undo get.  protected set.
       40     define public property  LK_RECEIPT_NewDelete as class propmap no-undo get.  protected set.
       41     define public property  LK_RECEIPT_SentDelete as class propmap no-undo get.  protected set.
       42     define public property  LK_RECEIPT_DeleteHand as class propmap no-undo get.  protected set.
       43     define public property  LK_RECEIPT_ConfirmedHand as class propmap no-undo get.  protected set.
       44     define public property  RequireFilling as class propmap no-undo get.  protected set.
       45     constructor public th ():
       46       super().
       47       NewStatus            = crProp(0, "NewStatus", "Новый").
       48       ReceivedFromSupplier = crProp(1, "ReceivedFromSupplier", "Получен от поставщика").
       49       VerificationPassed   = crProp(2, "VerificationPassed", "Пройдена проверка МОТП").
       50       RequiresAdjustment   = crProp(3, "RequiresAdjustment", "Требует корректировки").
       51       AwaitingDelivery     = crProp(4, "AwaitingDelivery", "Ожидает поставку").
       52       SignatureRequired    = crProp(5, "SignatureRequired", "Требует подписания").
       53       AwaitingConfirmation = crProp(6, "AwaitingConfirmation", "Ожидает подтверждения МОТП").
       54       CorrectionRequested  = crProp(7, "CorrectionRequested", "Запрошена корректировка").
       55       Confirmed            = crProp(8, "Confirmed", "Подтвержден").
       56       CancellationRequest  = crProp(9, "CancellationRequest", "Запрос аннуляции").
       57       Canceled             = crProp(10, "Canceled", "Аннулирован").
       58       Rejection            = crProp(11, "Rejection", "Отказ").
       59       LackOfMarkingCodesInCirculation = crProp(31, "LackOfMarkingCodesInCirculation", "Отсутствие КМ в обороте").
       60       DeliveryCodeMismatch = crProp(32, "DeliveryCodeMismatch", "Частичная приемка").
       61       InconsistencyWithSupplyContract = crProp(33, "InconsistencyWithTheSupplyContract", "Несоответсвие договору поставки ").
       62       LinesInError         = crProp(38, "LinesInError", "Нет строк для приема").
       63       LoadError            = crProp(34, "LoadError", "Ошибка загрузки ").
       64       edocError            = crProp(35, "edocError", "Ошибка").
       65       RejectionUtd         = crProp(36, "RejectionUtd", "Отказать").
       66       ConfirmedUcd         = crProp(37, "ConfirmedUcd", "Подтвердить").
       67       LK_RECEIPT_New       = crProp(50, "LK_RECEIPT_New", "Требует подписания").
       68       LK_RECEIPT_Signed    = crProp(51, "LK_RECEIPT_Signed", "Подписан и ожидает отправки в ГИС МТ").
       69       LK_RECEIPT_Sent      = crProp(52, "LK_RECEIPT_Sent", "Отправлен и ожидает обработки ГИС МТ").
       70       LK_RECEIPT_Confirmed = crProp(53, "LK_RECEIPT_Confirmed", "Успешно обработан ГИС МТ").
       71       LK_RECEIPT_Error     = crProp(54, "LK_RECEIPT_Error", "Обработан ГИС МТ с ошибкой").
       72       LK_RECEIPT_NewDelete = crProp(55, "LK_RECEIPT_NewDelete", "Удален до отправки в ГИС МТ").
       73       LK_RECEIPT_SentDelete = crProp(56, "LK_RECEIPT_SentDelete", "Удален после отправки в ГИС МТ").
       74       LK_RECEIPT_DeleteHand = crProp(57, "LK_RECEIPT_DeleteHand", "Удален в ГИС МТ вручную").
       75       LK_RECEIPT_ConfirmedHand = crProp(58, "LK_RECEIPT_ConfirmedHand", "Обработан в ГИС МТ вручную").
       76       RequireFilling        = crProp(60, "RequireFilling","Требует заполнения").
       77     end.
       78     method public logical CheckStsErr(inKey as int):
       79       if RequiresAdjustment:KeyIntDB = inKey
       80         or LackOfMarkingCodesInCirculation:KeyIntDB = inKey
       81         or DeliveryCodeMismatch:KeyIntDB = inKey
       82         or InconsistencyWithSupplyContract:KeyIntDB = inKey
       83         or LoadError:KeyIntDB = inKey
       84         then return true.
       85         else return false.
       86     end method.
       87   end class.
