      989   function hvrdtax return logical (input parrecid as recid):
      990   define variable varresult as logical no-undo.
      991   run hvrdtax-proc (input parrecid, output varresult).
      992   return varresult.
      993   end function.
      994   procedure hvrdtax-proc:
      995   define input  parameter parrecid  as recid   no-undo.
      996   define output parameter parresult as logical no-undo.
      997   define buffer bf_goods for ub.goods.
      998   define buffer bf_units for ub.units.
      999   define buffer rt_tax   for ub.tax.
     1000   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1001   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1002   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1003   if available rt_tax and
     1004       can-find(first ub.tax-units No-LOCK WHERE
     1005                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1006                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1007                                                       else assign parresult = no.
     1008   end procedure.
     1009   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   define new global shared variable g#lib-calc as handle no-undo .
     1011   procedure plgdsfnd :
     1012     define input  parameter p-chk-and-chs    as logical               no-undo .
     1013     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1014     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1015     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1016     define output parameter p-reserv-pl-code as   logical             no-undo .
     1017     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1018     define buffer buf_goods         for ub.goods .
     1019     define buffer buf_pl-gds        for ub.pl-gds .
     1020     define buffer buf_second_pl-gds for ub.pl-gds .
     1021     find first buf_goods no-lock where
     1022                buf_goods.gds-code = p-gds-code no-error .
     1023     if not available buf_goods
     1024     then do:
     1025       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1026     end.
     1027   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1029     (input  p-obj-type
     1030     ,input  p-obj-code
     1031     ,input  buf_goods.artic
     1032     ,input  buf_goods.prod-type
     1033     ,input  buf_goods.prod-code
     1034     ,input  'place-rsrv=request'
     1035     ,output p-reserv-pl-code
     1036     ) no-error .
     1037     if error-status :error
     1038     then do:
     1039       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1040     end.
     1041     if p-reserv-pl-code = no
     1042     then do:
     1043       return .
     1044     end.
     1045     if p-chk-and-chs <> yes
     1046     then do:
     1047       return .
     1048     end.
     1049     find first buf_pl-gds no-lock where
     1050                buf_pl-gds.obj-type = p-obj-type and
     1051                buf_pl-gds.obj-code = p-obj-code and
     1052                buf_pl-gds.gds-code = p-gds-code no-error .
     1053     if not available buf_pl-gds
     1054     then do:
     1055       return error "К товару не привязано ни одного места хранения" .
     1056     end.
     1057     find first buf_second_pl-gds no-lock where
     1058                buf_second_pl-gds.obj-type  = p-obj-type          and
     1059                buf_second_pl-gds.obj-code  = p-obj-code          and
     1060                buf_second_pl-gds.gds-code  = p-gds-code          and
     1061                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1062     if not available buf_second_pl-gds
     1063     then do:
     1064       assign
     1065         p-pl-code = buf_pl-gds.pl-code
     1066       .
     1067     end.
     1068     else do:
     1069       if not valid-handle( parparentproc )
     1070       then do:
     1071         return error "Не выбрано место хранения " + chr(10) .
     1072       end.
     1073       run str/plgdssel.p
     1074         (
     1075            input parparentproc
     1076         ,  input p-obj-type
     1077         ,  input p-obj-code
     1078         ,  input p-gds-code
     1079         , output p-pl-code
     1080         ) no-error .
     1081       if error-status :error
     1082       then do:
     1083         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1084                                , 'plgdssel.p':U
     1085                                , chr(10)
     1086                                , error-status :get-message( 1 )
     1087                                , return-value
     1088                                ) .
     1089       end.
     1090       if p-pl-code = ? or
     1091          p-pl-code = 0
     1092       then do:
     1093         return error "Не выбрано место хранения " + chr(10) .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1099   define temp-table tt-doc-line no-undo like ub.doc-line
     1100   field cst-code like ub.trn-doc.cst-code
     1101   .
     1102   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1103   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1104   define temp-table tt-parts    no-undo like ub.parts.
     1105   procedure lib-trn_copy-inqu :
     1106   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1107   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1108   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1109   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1110   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1111   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1112   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1113   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1114   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1115   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1116   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1117   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1118   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1119   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1120   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1121   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1122   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1123   define input parameter parinp-discnt-type as   logical                no-undo.
     1124   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1125   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1126   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1127   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1128   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1129   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1130   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1131   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1132   define input parameter table for tt-doc-line.
     1133   define input parameter table for tt-gds-dtl.
     1134   define input parameter table for tt-parts.
     1135   define input parameter paruse-parts       as   logical                no-undo.
     1136   define input parameter parall-qnty        as   logical                no-undo.
     1137   define input parameter parfix-price       as   logical                no-undo.
     1138   define buffer crt_trn-doc  for ub.trn-doc.
     1139   define buffer crt_goods    for ub.goods.
     1140   define buffer crt_doc-line for ub.doc-line.
     1141   define buffer crt_gds-dtl  for ub.gds-dtl.
     1142   define variable end-price    as   logical              no-undo.
     1143   define variable real-type    like ub.goods.gds-type    no-undo.
     1144   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1145   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1146   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1147   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1148   define variable g-log        as   logical              no-undo.
     1149   define variable mem-qnty like chg-qnty no-undo.
     1150   define variable dflt-cd as character no-undo .
     1151   c-l:
     1152   do on error undo, return error return-value :
     1153   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1154   assign
     1155       paruse-parts = false
     1156       .
     1157   assign
     1158     end-price = no.
     1159   if parinp-discnt-type = yes and
     1160      parinp-discnt-pc   = 0   and
     1161      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1162      then do:
     1163     assign
     1164       crt_trn-doc.tot-calc    = partot-calc
     1165       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1166       crt_trn-doc.discnt-type = pardiscnt-type.
     1167   end.
     1168   if parinp-agnt = ? then do:
     1169     assign
     1170       crt_trn-doc.agnt = paragnt.
     1171   end.
     1172   if parinp-boss = ? then do:
     1173     assign
     1174       crt_trn-doc.boss = parboss.
     1175   end.
     1176   if parinp-wrkr = ? then do:
     1177     assign
     1178       crt_trn-doc.wrkr = parwrkr.
     1179   end.
     1180   if parinp-base-rate  = ? then do:
     1181     assign
     1182       crt_trn-doc.base-rate  = parbase-rate.
     1183   end.
     1184   if parinp-base-scale = ? then do:
     1185     assign
     1186       crt_trn-doc.base-scale = parbase-scale.
     1187   end.
     1188   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1189   if available tt-doc-line then do:
     1190     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1191                      and crt_goods.prod-type = tt-doc-line.prod-type
     1192                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1193     if crt_goods.gds-type = 'у':U and
     1194        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1195       return error "В данный документ нельзя копировать услуги.".
     1196     end.
     1197     assign
     1198       real-type = crt_goods.gds-type.
     1199     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1200     if available crt_doc-line then do:
     1201       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1202                        and crt_goods.prod-type = crt_doc-line.prod-type
     1203                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1204       if crt_goods.gds-type <> real-type then do:
     1205         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1206       end.
     1207     end.
     1208     else do:
     1209       assign
     1210         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1211     end.
     1212   end.
     1213   r-l:
     1214   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1215     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1216                      and crt_goods.prod-type = tt-doc-line.prod-type
     1217                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1218   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1219      (
     1220       input crt_trn-doc.doc-code
     1221      ,input crt_trn-doc.obj-type
     1222      ,input crt_trn-doc.obj-code
     1223      ,input crt_goods.artic
     1224      ,input crt_goods.prod-type
     1225      ,input crt_goods.prod-code
     1226      ,input crt_goods.gds-name
     1227      ,input crt_goods.prt-root
     1228      ,input ?
     1229      ,input ?
     1230      ,input parcash-pay      ) no-error.
     1231     if error-status:error then do:
     1232       undo c-l, return error return-value.
     1233     end.
     1234     if return-value = "next" then do:
     1235       next r-l.
     1236     end.
     1237     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1238                                   crt_doc-line.artic     = crt_goods.artic      and
     1239                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1240                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1241     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1242                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1243                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1244                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1245                               break by tt-gds-dtl.artic
     1246                                     by tt-gds-dtl.prod-type
     1247                                     by tt-gds-dtl.prod-code
     1248                               :
     1249   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1250     ( input  tt-gds-dtl.artic
     1251      ,input  tt-gds-dtl.prod-type
     1252      ,input  tt-gds-dtl.prod-code
     1253      ,input  tt-gds-dtl.prt-code
     1254      ,input  tt-doc-line.obj-type
     1255      ,input  tt-doc-line.obj-code
     1256      ,output legal-node
     1257     ) no-error .
     1258       if error-status:error then do:
     1259          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1260       end.
     1261   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1262     ( input crt_trn-doc.obj-code
     1263      ,input crt_trn-doc.obj-type
     1264      ,input crt_trn-doc.doc-code
     1265      ,input crt_goods.artic
     1266      ,input crt_goods.prod-code
     1267      ,input crt_goods.prod-type
     1268      ,input legal-node
     1269      ,input yes
     1270     ) no-error .
     1271        if error-status:error then do:
     1272           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1273        end.
     1274        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1275                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1276                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1277                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1278                                     crt_gds-dtl.prt-code  = legal-node.
     1279       assign
     1280         crt_gds-dtl.ov             = parfix-price
     1281         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1282         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1283         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1284         .
     1285       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1286         assign
     1287           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1288           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1289           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1290           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1291       end.
     1292       if end-price then do:
     1293         assign
     1294           crt_gds-dtl.ov             = yes
     1295           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1296           crt_gds-dtl.discnt-base    = 0
     1297           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1298           crt_gds-dtl.discnt-rubl    = 0
     1299           crt_gds-dtl.discnt-pc      = 0
     1300           crt_gds-dtl.discnt-type    = yes.
     1301       end.
     1302   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1303   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1304     ( input recid(crt_gds-dtl)
     1305     , input no
     1306     , input ?
     1307     ) no-error.
     1308           if error-status:error then do:
     1309             undo c-l, return error return-value.
     1310           end.
     1311       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1312          crt_gds-dtl.ov then do:
     1313         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1314       end.
     1315       if paruse-parts then do:
     1316          if first-of (tt-gds-dtl.prod-code) then do:
     1317            for each tt-parts :
     1318              assign
     1319                chg-qnty = tt-parts.fact-qnty
     1320                mem-qnty = chg-qnty.
     1321              assign
     1322              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1323              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1324            end.
     1325            assign
     1326              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1327              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1328            assign
     1329              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1330              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1331            if crt_gds-dtl.doc-qnty = 0 then do:
     1332              delete crt_gds-dtl.
     1333            end.
     1334          end.
     1335       end.
     1336       else do:
     1337         assign
     1338           chg-qnty = tt-gds-dtl.fact-qnty
     1339           mem-qnty = chg-qnty.
     1340         assign
     1341           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1342           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1343           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1344           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1345         assign
     1346         varchg-qnty  = varchg-qnty  + chg-qnty
     1347         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1348         if crt_gds-dtl.doc-qnty = 0 then do:
     1349           delete crt_gds-dtl.
     1350         end.
     1351       end.
     1352     end.
     1353     if crt_doc-line.doc-qnty = 0 then do:
     1354       delete crt_doc-line.
     1355     end.
     1356   end.
     1357   end.
     1358   end procedure.
