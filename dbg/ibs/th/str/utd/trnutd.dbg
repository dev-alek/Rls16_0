     4037   MAIN-BLOCK:
     4038   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4039      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4040     for each  temp_trn-doc :
     4041       for each temp_doc-line where temp_doc-line.line-num = temp_trn-doc.line-num :
     4042         if temp_doc-line.doc-code <> temp_trn-doc.doc-code then do:
     4043           assign
     4044             v-end-message =  substitute("Не верно указан doc-code &1 &2  товар &3" ,
     4045                                         temp_doc-line.doc-code ,
     4046                                         temp_trn-doc.doc-code ,
     4047                                         temp_doc-line.gds-code
     4048                                         )
     4049           .
     4050           run pcall-log-file in p-log-handle (input v-end-message) .
     4051           undo, return error v-end-message.
     4052         end.
     4053       end.
     4054     end.
     4055     run get-db-num in parparentproc (output v-cntxt-db-num ) .
     4056     run get-userid in parparentproc (output v-cntxt-userid ) .
     4057     if num-entries (v-cntxt-userid) > 1
     4058     then do:
     4059       v-cntxt-userid = entry (1, v-cntxt-userid).
     4060       is-egais = true.
     4061     end.
     4062   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4064     (output v-curr-r-b
     4065     )  .
     4066     if v-curr-r-b = 'base':U then v-print-rubl = false .
     4067     else v-print-rubl = true .
     4068     p-ok-doc = 0 .
     4069     find first  temp_trn-doc no-lock .
     4070     run clear-tt .
     4071     find first bufo_clients no-lock where
     4072                bufo_clients.obj-type  = temp_trn-doc.obj-type  and
     4073                bufo_clients.obj-code  = temp_trn-doc.obj-code  no-error .
     4074     if error-status :error then do:
     4075             assign
     4076             v-end-message =  substitute(" Не найден объект &1 &2 &3 &4" , temp_trn-doc.obj-type , temp_trn-doc.obj-code , error-status :get-message(1) , return-value )
     4077             .
     4078             run pcall-log-file in p-log-handle (input v-end-message) .
     4079             undo, return error v-end-message.
     4080     end.
     4081   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4083     (input  temp_trn-doc.obj-type
     4084     ,input  temp_trn-doc.obj-code
     4085     ,output temp_trn-doc.host-code
     4086     ) no-error .
     4087     if error-status :error then do:
     4088       assign
     4089           v-end-message =  substitute("Не верно указан объект &1 &2 " ,
     4090           temp_trn-doc.obj-type ,
     4091           temp_trn-doc.obj-code ).
     4092       run pcall-log-file in p-log-handle (input v-end-message) .
     4093       undo, return error v-end-message.
     4094     end.
     4095     assign
     4096       vt-host-code          = temp_trn-doc.host-code
     4097       vt-obj-type           = temp_trn-doc.obj-type
     4098       vt-obj-code           = temp_trn-doc.obj-code
     4099       v-cntxt-host-code-obj = temp_trn-doc.host-code
     4100       v-cntxt-obj-code      = temp_trn-doc.obj-code
     4101       v-cntxt-obj-type      = temp_trn-doc.obj-type
     4102     .
     4103     if temp_trn-doc.vat-type = ""
     4104     or temp_trn-doc.vat-type = ?
     4105     then do:
     4106   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4107   empty temp-table thbjattr_thbj-attr.
     4108   run adm/shattri.p (
     4109      input "get":U
     4110     ,input v-cntxt-obj-type
     4111     ,input v-cntxt-obj-code
     4112     ,input 'nakl_par':U
     4113     ,input  ""
     4114     ,output v-value-character
     4115     ,output v-value-date
     4116     ,output v-value-decimal
     4117     ,output v-value-integer
     4118     ,output v-value-logical
     4119     ,output par-type
     4120     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4121     ) no-error .
     4122       for each thbjattr_thbj-attr :
     4123         if thbjattr_thbj-attr.prop-code = 'type-vat' then v-value-integer = thbjattr_thbj-attr.property-value-integer.
     4124       end.
     4125       case v-value-integer:
     4126         when 1 or when ? then do:
     4127           assign
     4128             temp_trn-doc.vat-type = 'в т. ч.':U.
     4129         end.
     4130         when 2 then do:
     4131           assign
     4132             temp_trn-doc.vat-type = 'нет':U.
     4133         end.
     4134         when 3 then do:
     4135           assign
     4136             temp_trn-doc.vat-type = 'без':U.
     4137         end.
     4138         otherwise do:
     4139             v-end-message =  substitute(" Не верно задан атрибут 'Тип заведения НДС' (type-vat). &1 &2 &3 &4 &5" , temp_trn-doc.obj-type , temp_trn-doc.obj-code , error-status :get-message(1) , return-value , v-value-integer ) .
     4140             run pcall-log-file in p-log-handle (input v-end-message) .
     4141             undo, return error v-end-message.
     4142         end.
     4143       end case.
     4144     end.
     4145   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4147     (input  temp_trn-doc.obj-type
     4148     ,input  temp_trn-doc.obj-code
     4149     ,output to-day
     4150     ) no-error .
     4151     if error-status :error then do:
     4152             assign
     4153             v-end-message =  substitute(" Ошибка &1 &2 &3 &4" , temp_trn-doc.obj-type , temp_trn-doc.obj-code , error-status :get-message(1) , return-value )
     4154             .
     4155             run pcall-log-file in p-log-handle (input v-end-message) .
     4156             undo, return error v-end-message.
     4157     end.
     4158     if vt-host-code <>   v-cntxt-host-code-obj
     4159     then do:
     4160       assign
     4161         v-end-message =  substitute(" Не верно указан код фирмы: &1 ( по объектам должен быть :&2) " , temp_trn-doc.host-code , v-cntxt-host-code-obj  )
     4162       .
     4163       run pcall-log-file in p-log-handle (input v-end-message) .
     4164       undo, return error v-end-message.
     4165     end.
     4166     if temp_trn-doc.ext-doc-type = 'ie':U
     4167     then do:
     4168       if available buf_contract
     4169       then do:
     4170         if buf_contract.curr-code <> temp_trn-doc.exch-code
     4171         then do:
     4172           v-end-message =  substitute("По договору &3   ожидалась валюта &1  пришла &2 " ,
     4173                                       buf_contract.curr-code,
     4174                                       temp_trn-doc.exch-code,
     4175                                       temp_trn-doc.contract-code ) .
     4176           run pcall-log-file in p-log-handle (input v-end-message) .
     4177           undo, return error v-end-message.
     4178         end.
     4179       end.
     4180     end.
     4181     if not (temp_trn-doc.cli-type = 'орг':U or temp_trn-doc.cli-type = 'чел':U or temp_trn-doc.cli-type = 'скл':U or temp_trn-doc.cli-type = 'маг':U)
     4182     then do:
     4183       run who-cli-ora in this-procedure (
     4184          input  temp_trn-doc.cli-code ,
     4185          output temp_trn-doc.cli-type ,
     4186          output temp_trn-doc.cli-code
     4187          ) no-error .
     4188       if error-status :error then return error return-value .
     4189     end.
     4190     else do:
     4191       if not is-egais then is-tsd = true.
     4192     end.
     4193     if temp_trn-doc.ext-doc-type <> 'ie':U then do:
     4194        temp_trn-doc.exch-code = 0 .
     4195        temp_trn-doc.exch-rate  = 1.
     4196        temp_trn-doc.exch-scale = 1.
     4197     end.
     4198     if temp_trn-doc.exch-code = ? then do:
     4199         assign
     4200           temp_trn-doc.exch-code = 0
     4201           temp_trn-doc.exch-rate  = 1
     4202           temp_trn-doc.exch-scale = 1
     4203         .
     4204         v-end-message =  substitute("Предупреждение !!! Не верно введена валюта ПОСТВЩИКА код &1 , меняю на национальную " ,              temp_trn-doc.exch-code   ) .
     4205         run pcall-log-file in p-log-handle (input v-end-message) .
     4206     end.
     4207     if temp_trn-doc.exch-rate  = 0 or
     4208        temp_trn-doc.exch-rate  = ? then do:
     4209             assign
     4210               temp_trn-doc.exch-code = 0
     4211               temp_trn-doc.exch-rate  = 1
     4212               temp_trn-doc.exch-scale = 1
     4213             .
     4214         v-end-message =  substitute("Предупреждение !!! Не верно введен курс = &2 валюты ПОСТВЩИКА код &1 , меняю на национальную " ,              temp_trn-doc.exch-code , temp_trn-doc.exch-rate ) .
     4215         run pcall-log-file in p-log-handle (input v-end-message) .
