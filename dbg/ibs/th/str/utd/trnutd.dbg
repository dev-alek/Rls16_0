     1403   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1404   procedure who-cli-ora :
     1405   define input  parameter p-cli-code-ora as integer   no-undo .
     1406   define output parameter p-cli-type as character no-undo .
     1407   define output parameter p-cli-code as integer   no-undo .
     1408     do
     1409     on error undo, return error return-value
     1410     :
     1411     if length (string(p-cli-code-ora))  <> 9 then do:
     1412        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1413     end.
     1414     if string(p-cli-code-ora) begins "1" or
     1415        string(p-cli-code-ora) begins "2" or
     1416        string(p-cli-code-ora) begins "4" then do:
     1417         p-cli-type = 'орг':U .
     1418         p-cli-code = p-cli-code-ora  .
     1419     end.
     1420     else do:
     1421       if string(p-cli-code-ora) begins "3" then do:
     1422         p-cli-type = 'чел':U .
     1423         p-cli-code = p-cli-code-ora  .
     1424       end.
     1425       else do:
     1426          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1427       end.
     1428     end.
     1429     define buffer buf_clients for ub.clients  .
     1430     find first buf_clients no-lock where
     1431                buf_clients.obj-type = p-cli-type and
     1432                buf_clients.obj-code = p-cli-code
     1433                no-error .
     1434         if error-status :error then do:
     1435             return error substitute
     1436             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1437                 p-cli-code-ora ,
     1438                 p-cli-type ,
     1439                 p-cli-code ) .
     1440         end.
     1441         if ora-icli_ver-stts-client then do:
     1442             if buf_clients.stts > 0 then do:
     1443                 return error substitute
     1444                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1445                     p-cli-code-ora ,
     1446                     p-cli-type ,
     1447                     p-cli-code ) .
     1448             end.
     1449         end.
     1450     end.
     1451   end procedure.
     1452   procedure ora-ver-goods :
     1453   define input  parameter p-gds-code as integer   no-undo .
     1454   define buffer buf_goods for ub.goods  .
     1455   define variable my-message as character no-undo .
     1456     do
     1457     on error undo, return error return-value
     1458     :
     1459           find first buf_goods no-lock where
     1460                      buf_goods.gds-code = p-gds-code no-error .
     1461               if error-status :error then do:
     1462                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1463                   undo, return error my-message.
     1464               end.
     1465             if buf_goods.stts > 0 then do:
     1466               assign
     1467                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1468                 undo, return error my-message.
     1469             end.
     1470     end.
     1471   end procedure.
     1472   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   procedure factord :
     1474     define input  parameter p-fact-date            as date    no-undo .
     1475     define input  parameter p-fact-time            as integer no-undo .
     1476     define input  parameter p-fact-num             as integer no-undo .
     1477     define input  parameter p-shift-date           as date    no-undo .
     1478     define input  parameter p-shift-num            as integer no-undo .
     1479     define input  parameter p-shift-on             as logical no-undo .
     1480     define output parameter p-fact-order           as decimal no-undo .
     1481     define output parameter p-shift-end-fact-order as decimal no-undo .
     1482     define output parameter p-day-end-fact-order   as decimal no-undo .
     1483     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1484     if p-fact-date = ?
     1485     then do:
     1486       return error "Не указана фактическая дата" .
     1487     end.
     1488     define variable v-fact-date-num as integer no-undo .
     1489     assign
     1490       v-fact-date-num = integer(p-fact-date)
     1491     .
     1492     if p-fact-num = ?
     1493     or p-fact-num = 0
     1494     then do:
     1495       return error "Не задан p-fact-num " + string(p-fact-num) .
     1496     end.
     1497     if p-fact-num < 0
     1498     then do:
     1499       return error "Отрицательный fact-num " + string(p-fact-num) .
     1500     end.
     1501     if p-fact-num >= 100000000
     1502     then do:
     1503       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1504     end.
     1505     if p-shift-on = true
     1506     then do:
     1507       if p-shift-date = ?
     1508       then do:
     1509         return error "Не задана дата смены" .
     1510       end.
     1511       if p-shift-num = ?
     1512       or p-shift-num = 0
     1513       then do:
     1514         return error "Не задан номер смены" .
     1515       end.
     1516     end.
     1517     else do:
     1518       assign
     1519         p-shift-date = p-fact-date
     1520         p-shift-num  = 24
     1521       .
     1522     end.
     1523     define variable v-shift-offset as integer no-undo .
     1524     if p-shift-date = p-fact-date
     1525     then do:
     1526       assign
     1527         v-shift-offset = 1
     1528       .
     1529     end.
     1530     if p-shift-date < p-fact-date
     1531     then do:
     1532       assign
     1533         v-shift-offset = 0
     1534       .
     1535     end.
     1536     if p-shift-date > p-fact-date
     1537     then do:
     1538       message
     1539         vss-workfile vss-revision vss-description skip
     1540         "Неправильная дата закрытия смены" skip
     1541         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1542         view-as alert-box error .
     1543       undo, return error
     1544         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1545           ,string(p-fact-date, '99/99/9999':U)
     1546           ,string(p-shift-date, '99/99/9999':U)
     1547           )
     1548       .
     1549     end.
     1550     if p-shift-num < 1
     1551     or p-shift-num > 24
     1552     then do:
     1553       message
     1554         vss-workfile vss-revision vss-description skip
     1555         "Неправильный номер смены" skip
     1556         "p-shift-num" p-shift-num skip
     1557         view-as alert-box error .
     1558       undo, return error return-value .
     1559     end.
     1560     assign
     1561       p-fact-order           = v-fact-date-num
     1562                              + v-shift-offset * 0.5
     1563                              + p-shift-num    * 0.02 - 0.01
     1564                              + p-fact-num     * 0.0000000001
     1565       p-shift-end-fact-order = v-fact-date-num
     1566                              + v-shift-offset * 0.5
     1567                              + p-shift-num    * 0.02
     1568       p-day-end-fact-order   = v-fact-date-num
     1569                              + 0.99
     1570     .
     1571     if p-fact-order           <= v-fact-date-num
     1572     or p-shift-end-fact-order <= v-fact-date-num
     1573     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1574     or p-shift-end-fact-order >= p-day-end-fact-order
     1575     then do:
     1576       message
     1577         vss-workfile vss-revision vss-description skip
     1578         "Внутренняя ошибка при генерации фактического номера" skip
     1579         "p-fact-date"            p-fact-date            skip
     1580         "p-fact-time"            p-fact-time            skip
     1581         "p-fact-num"             p-fact-num             skip
     1582         "p-shift-date"           p-shift-date           skip
     1583         "p-shift-num"            p-shift-num            skip
     1584         "p-shift-on"             p-shift-on             skip
     1585         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1586         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1587         "v-fact-date-num"        v-fact-date-num        skip
     1588         view-as alert-box error .
     1589       undo, return error return-value .
     1590     end.
     1591   end procedure.
     1592   procedure day-begin-fact-order :
     1593     define input  parameter p-fact-date            as date    no-undo .
     1594     define output parameter p-day-begin-fact-order as decimal no-undo .
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       if p-fact-date = ?
     1599       then do:
     1600         assign
     1601           p-day-begin-fact-order = 0
     1602         .
     1603       end.
     1604       else do:
     1605         assign
     1606           p-day-begin-fact-order = integer(p-fact-date)
     1607         .
     1608       end.
     1609     end.
     1610   end procedure.
     1611   procedure factord-max-fact-order :
     1612     define output parameter p-max-fact-order as decimal   no-undo .
     1613     do
     1614     on error undo, return error return-value
     1615     :
     1616       run day-begin-fact-order in this-procedure
     1617         (input  date(1, 1, 5000)
     1618         ,output p-max-fact-order
     1619         ) .
     1620     end.
     1621   end procedure.
     1622   procedure factord-cut-archive :
     1623     define input  parameter p-obj-type             as character no-undo .
     1624     define input  parameter p-obj-code             as integer   no-undo .
     1625     define input  parameter p-fact-date            as date      no-undo .
     1626     define output parameter p-shift-on             as logical   no-undo .
     1627     define output parameter p-shift-date           as date      no-undo .
     1628     define output parameter p-shift-num            as integer   no-undo .
     1629     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1630     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1631     define variable v-fact-order as decimal   no-undo .
     1632     define buffer buf_shift-obj for ub.shift-obj .
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1638     (input  p-obj-type
     1639     ,input  p-obj-code
     1640     ,input  'shift-on=request'
     1641     ,output p-shift-on
     1642     ) no-error .
     1643       if error-status :error
     1644       then do:
     1645         message
     1646           vss-workfile vss-revision vss-description skip
     1647           "Ошибка при определении атрибута объекта" skip
     1648           "Объект" p-obj-type p-obj-code skip
     1649           error-status :get-message(1) skip
     1650           return-value skip
     1651           view-as alert-box error .
     1652         undo, return error return-value .
     1653       end.
     1654       if p-shift-on = false
     1655       then do:
     1656         assign
     1657           p-shift-date               = ?
     1658           p-shift-num                = 0
     1659         .
     1660       end.
     1661       else do:
     1662         find first buf_shift-obj share-lock
     1663           where buf_shift-obj.obj-type   = p-obj-type
     1664             and buf_shift-obj.obj-code   = p-obj-code
     1665             and buf_shift-obj.shift-date > p-fact-date
     1666           use-index pi
     1667           no-error .
     1668         if not available buf_shift-obj
     1669         or buf_shift-obj.status_ <> 'зкр':U
     1670         then do:
     1671           message
     1672             vss-workfile vss-revision vss-description skip
     1673             "Невозможно вычислить последнюю смену" skip
     1674             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1675             "Объект" p-obj-type p-obj-code skip
     1676             "Дата" p-fact-date skip
     1677             view-as alert-box error .
     1678           undo, return error return-value .
     1679         end.
     1680         find last buf_shift-obj share-lock
     1681           where buf_shift-obj.obj-type = p-obj-type
     1682             and buf_shift-obj.obj-code = p-obj-code
     1683             and buf_shift-obj.shift-date <= p-fact-date
     1684           use-index pi
     1685           no-error .
     1686         if available buf_shift-obj
     1687         then do:
     1688           if  buf_shift-obj.status_ = 'зкр':U
     1689           then do:
     1690             assign
     1691               p-shift-date = buf_shift-obj.shift-date
     1692               p-shift-num  = buf_shift-obj.shift-num
     1693             .
     1694           end.
     1695           else do:
     1696             message
     1697               vss-workfile vss-revision vss-description skip
     1698               "Невозможно вычислить последнюю смену" skip
     1699               "Статус смены отличен от статуса" 'зкр':U skip
     1700               "Объект" p-obj-type p-obj-code skip
     1701               "Дата" p-fact-date skip
     1702               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1703               view-as alert-box error .
     1704             undo, return error return-value .
     1705           end.
     1706         end.
     1707         else do:
     1708           assign
     1709             p-shift-date = p-fact-date - 1
     1710             p-shift-num  = 1
     1711           .
     1712         end.
     1713       end.
     1714       run factord in this-procedure
     1715         (input  p-fact-date
     1716         ,input  1
     1717         ,input  1
     1718         ,input  p-shift-date
     1719         ,input  p-shift-num
     1720         ,input  p-shift-on
     1721         ,output v-fact-order
     1722         ,output p-shift-end-fact-order
     1723         ,output p-day-end-fact-order
     1724         ) no-error .
     1725       if error-status :error
     1726       then do:
     1727         message
     1728           vss-workfile vss-revision vss-description skip
     1729           "Ошибка при вызове процедуры factord"
     1730           error-status :get-message(1) skip
     1731           return-value skip
     1732           view-as alert-box error .
     1733         undo, return error return-value .
     1734       end.
     1735     end.
     1736   end procedure.
     1737   procedure factord-lock-shift :
     1738     define input  parameter p-obj-type  as character no-undo .
     1739     define input  parameter p-obj-code  as integer   no-undo .
     1740     define input  parameter p-fact-date as date      no-undo .
     1741     define parameter buffer buf_shift-obj for ub.shift-obj .
     1742     define variable v-shift-on      as logical   no-undo .
     1743     define variable v-extra-message as character no-undo .
     1744     define variable v-error as character no-undo .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1749   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1750     (input  p-obj-type
     1751     ,input  p-obj-code
     1752     ,input  'shift-on=request'
     1753     ,output v-shift-on
     1754     ) no-error .
     1755       if error-status :error
     1756       then do:
     1757         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1758         undo, return error v-error .
     1759       end.
     1760       if v-shift-on = true
     1761       then do:
     1762         find first buf_shift-obj share-lock
     1763           where buf_shift-obj.obj-type   = p-obj-type
     1764             and buf_shift-obj.obj-code   = p-obj-code
     1765             and buf_shift-obj.shift-date > p-fact-date
     1766           use-index pi
     1767           no-error .
     1768         if not available buf_shift-obj
     1769         or buf_shift-obj.status_ <> 'зкр':U
     1770         then do:
     1771           find last buf_shift-obj
     1772             where buf_shift-obj.obj-type = p-obj-type
     1773               and buf_shift-obj.obj-code = p-obj-code
     1774               and buf_shift-obj.status_  = 'зкр':U
     1775             use-index stts
     1776             no-error .
     1777           if available buf_shift-obj
     1778           then do:
     1779             assign
     1780               v-extra-message =
     1781                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1782                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1783                               )
     1784             .
     1785           end.
     1786           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1787           undo, return error v-error .
     1788         end.
     1789       end.
     1790     end.
     1791   end procedure.
     1792   procedure factord-end-day :
     1793     define input  parameter p-fact-date            as date    no-undo .
     1794     define output parameter p-day-end-fact-order   as decimal no-undo .
     1795     do
     1796     on error undo, return error return-value
     1797     :
     1798       if p-fact-date = ?
     1799       then do:
     1800         return error "Не указана фактическая дата" .
     1801       end.
     1802       assign
     1803         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1804       .
     1805     end.
     1806   end procedure.
     1807   procedure factord-to-date :
     1808     define input  parameter p-fact-order as decimal no-undo .
     1809     define output parameter p-fact-date  as date    no-undo .
     1810     define variable v-ref-date  as date      no-undo .
     1811     define variable v-ref-delta as integer   no-undo .
     1812     do
     1813     on error undo, return error return-value
     1814     :
     1815       if p-fact-order = ?
     1816       or p-fact-order = 0
     1817       then do:
     1818         return error "Не указан fact-order" .
     1819       end.
     1820       assign
     1821         v-ref-date  = date(1, 1, 2000)
     1822       .
     1823       assign
     1824         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1825       .
     1826       assign
     1827         p-fact-date = v-ref-date + v-ref-delta
     1828       .
     1829     end.
     1830   end procedure.
     1831   procedure factord-to-fact-num :
     1832     define input  parameter p-fact-order as decimal no-undo .
     1833     define output parameter p-fact-num   as integer no-undo .
     1834     define variable v-fact-order-trunc as decimal no-undo .
     1835     do
     1836     on error undo, return error return-value
     1837     :
     1838       if p-fact-order = ?
     1839       or p-fact-order = 0
     1840       then do:
     1841         return error "Не указан fact-order" .
     1842       end.
     1843       assign
     1844        v-fact-order-trunc = truncate(p-fact-order, 2)
     1845       .
     1846       assign
     1847         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1848       .
     1849     end.
     1850   end procedure.
     1851   procedure factord-to-shift-num :
     1852     define input  parameter p-fact-order as decimal no-undo .
     1853     define output parameter p-shift-num   as integer no-undo .
     1854     define variable  p-shift-numd  as decimal   no-undo .
     1855     define variable v-fact-order-trunc as decimal no-undo .
     1856     do
     1857     on error undo, return error return-value
     1858     :
     1859       if p-fact-order = ?
     1860       or p-fact-order = 0
     1861       then do:
     1862         return error "Не указан fact-order" .
     1863       end.
     1864       assign
     1865        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1866       .
     1867       if v-fact-order-trunc < 0.5 then do:
     1868         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1869       end.
     1870       assign
     1871         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1872         .
     1873        assign
     1874         p-shift-num = truncate (p-shift-numd , 0)
     1875       .
     1876     end.
     1877   end procedure.
