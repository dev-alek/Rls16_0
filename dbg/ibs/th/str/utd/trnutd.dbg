     5589   procedure clear-tt :
     5590     do
     5591     on error undo, return error return-value
     5592     :
     5593       for each tt-trn-doc:
     5594         delete tt-trn-doc.
     5595       end.
     5596       for each tt2-doc-line :
     5597           delete tt2-doc-line .
     5598       end.
     5599       for each tt-doc-line :
     5600           delete tt-doc-line .
     5601       end.
     5602       for each tt-gds-dtl :
     5603           delete tt-gds-dtl .
     5604       end.
     5605       for each tt-parts:
     5606           delete tt-parts .
     5607       end.
     5608       for each lib-trn_ret-doc :
     5609         delete lib-trn_ret-doc.
     5610       end.
     5611       for each lib-trn_ret-line :
     5612         delete lib-trn_ret-line      .
     5613       end.
     5614       for each lib-trn_ret-line-attr :
     5615         delete lib-trn_ret-line.
     5616       end.
     5617       for each lib-trn_ret-dtl :
     5618         delete lib-trn_ret-dtl.
     5619       end.
     5620       for each lib-trn_ret-parts :
     5621         delete lib-trn_ret-parts .
     5622       end.
     5623    end.
     5624   end procedure.
     5625   procedure calc-cost-price :
     5626   define input  parameter p-doc-code as character no-undo .
     5627   define buffer cur-doc-line  for ub.doc-line.
     5628   define buffer cur-goods     for ub.goods.
     5629   define buffer cur-gds-dtl   for ub.gds-dtl.
     5630   define buffer t-doc         for ub.trn-doc  .
     5631   define variable varnew-price like ub.doc-line.price-base no-undo.
     5632   do
     5633   on error undo, return error return-value
     5634   :
     5635     v-end-message = substitute("Просчет учетной цены для расходной накладной &1" , p-doc-code) .
     5636     run pcall-log-file in p-log-handle ( input v-end-message ) .
     5637     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     5638     for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     5639     first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     5640                              cur-goods.prod-type     = cur-doc-line.prod-type and
     5641                              cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     5642     each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     5643                              cur-gds-dtl.artic       = cur-doc-line.artic     and
     5644                              cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     5645                              cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock :
     5646       assign
     5647         line-rec = recid(cur-doc-line)
     5648       .
     5649   assign
     5650     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     5651     price-base-with-tax-loc = cur-doc-line.price-base
     5652   .
     5653   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5655     (output varinvprb
     5656     )  .
     5657      find first in-vatp_doc-attr no-lock
     5658       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     5659         and in-vatp_doc-attr.attr-code = 'envd':U
     5660       no-error .
     5661       if available in-vatp_doc-attr
     5662          then do:
     5663          assign
     5664            in-vatp-have-vat-slt = no.
     5665      end.
     5666      else do:
     5667        assign
     5668          in-vatp-have-vat-slt = yes.
     5669      end.
     5670      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     5671                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     5672                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     5673      if (not t-doc.internal and
     5674              t-doc.doc-type = 'при':U) or
     5675         in-vatp-goods.gds-type = 'у':U then do:
     5676         if varinvprb = "base":u then do:
     5677           assign
     5678             road-tax-base-loc = cur-doc-line.road-tax
     5679             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     5680         end.
     5681         else do:
     5682           ASSIGN
     5683             road-tax-rubl-loc = cur-doc-line.road-tax
     5684             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     5685         end.
     5686         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     5687         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     5688         assign
     5689           road-tax-cli-loc = ?.
     5690         ASSIGN
     5691           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     5692           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     5693           transport-cli-loc  = 0
     5694           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     5695           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     5696           other-cli-loc      = 0
     5697           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     5698           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     5699                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5700               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5701         assign
     5702           vat-cli-loc            = ?
     5703           slt-cli-loc            = ?
     5704           price-cli-with-tax-loc = ?.
     5705      end.
     5706      else do:
     5707                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     5708                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     5709                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     5710                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     5711                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     5712                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     5713                            use-index out-code no-lock:
     5714             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     5715                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     5716                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     5717                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     5718                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     5719                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     5720                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     5721                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     5722                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     5723                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     5724                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     5725                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     5726                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     5727                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     5728                         .
     5729         end.
     5730         ASSIGN
     5731           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5732           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5733           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5734           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5735           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5736           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     5737                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     5738           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     5739                   vat-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     5740           slt-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     5741           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     5742           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     5743         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     5744         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     5745         if transport-base-loc = ? then transport-base-loc = 0.
     5746         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     5747         if other-base-loc     = ? then other-base-loc     = 0.
     5748         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     5749         assign
     5750           transport-cli-loc      = 0
     5751           other-cli-loc          = 0
     5752           road-tax-cli-loc       = ?
     5753           vat-cli-loc            = ?
     5754           slt-cli-loc            = ?
     5755           price-cli-with-tax-loc = ?.
     5756      end.
     5757   ASSIGN
     5758             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5759       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5760   .
     5761       assign
     5762       varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc
     5763                                           else price-base-with-tax-loc ) .
     5764       run str/out-add.p ( this-procedure ,
     5765                       recid (t-doc),
     5766                       recid (cur-doc-line),
     5767                       recid (cur-gds-dtl),
     5768                       recid (cur-goods),
     5769                       "update-sale-price",
     5770                       string(varnew-price)) no-error.
     5771       if error-status :error then do:
     5772         v-end-message = substitute(" Ошибка при вызове программы out-add &1 &2" , error-status :get-message(1)  , return-value) .
     5773         run pcall-log-file in p-log-handle ( input v-end-message ) .
     5774         undo, return error v-end-message.
     5775       end.
     5776     end.
     5777     if not is-tsd then do:
     5778       run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     5779       if error-status :error then do:
     5780         v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     5781         run pcall-log-file in p-log-handle ( input v-end-message ) .
     5782         undo, return error v-end-message.
     5783       end.
     5784     end.
     5785   end.
     5786   end procedure.
     5787   procedure cb_cloce-quest-neg :
     5788   define output parameter p-is-negostmess as logical   no-undo .
     5789   do
     5790   on error undo, return error return-value
     5791   :
     5792    p-is-negostmess = false .
     5793   end.
     5794   end procedure.
     5795   procedure unitqnty1 :
     5796     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     5797     define input parameter  p-artic            like ub.goods.artic     no-undo .
     5798     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     5799     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     5800     define input parameter  p-unit-description as character            no-undo .
     5801     define input parameter  p-qnty             as decimal              no-undo .
     5802     define buffer buf_units for ub.units .
     5803     define buffer buf_goods for ub.goods .
     5804     define variable v-artic as character no-undo .
     5805     define variable v-msg   as character no-undo .
     5806     if p-unit-description = ''
     5807     or p-unit-description = ?
     5808     then do:
     5809       assign
     5810         p-unit-description = "Единица измерения "
     5811       .
     5812     end.
     5813     if  p-unit-name <> ''
     5814     and p-unit-name <> ?
     5815     then do:
     5816       find first buf_units no-lock
     5817         where buf_units.unit-name = p-unit-name
     5818         no-error .
     5819       if not available buf_units
     5820       then do:
     5821         v-msg =
     5822           "Не найдена единица измерения " + chr(10) +
     5823           "p-unit-name" +   p-unit-name + chr(10) +
     5824           "p-artic" +       p-artic +  chr(10) +
     5825           "p-prod-type" +   p-prod-type + chr(10) +
     5826           "p-proc-code" +   string (p-prod-code) + chr(10) +
     5827           "p-qnty" +        string (p-qnty) + chr(10)
     5828            .
     5829         undo, return error v-msg .
     5830       end.
     5831     end.
     5832     else do:
     5833       find first buf_goods no-lock
     5834         where buf_goods.artic     = p-artic
     5835           and buf_goods.prod-type = p-prod-type
     5836           and buf_goods.prod-code = p-prod-code
     5837         no-error .
     5838       if not available buf_goods
     5839       then do:
     5840         v-msg =
     5841           "Не найден товар" + chr(10) +
     5842           "p-unit-name" +   p-unit-name + chr(10) +
     5843           "p-artic" +       p-artic +  chr(10) +
     5844           "p-prod-type" +   p-prod-type + chr(10) +
     5845           "p-proc-code" +   string (p-prod-code) + chr(10) +
     5846           "p-qnty" +        string (p-qnty) + chr(10)
     5847           .
     5848         undo, return error v-msg .
     5849       end.
     5850       find first buf_units no-lock
     5851         where buf_units.unit-name = buf_goods.unit-base
     5852         no-error .
     5853       if not available buf_units
     5854       then do:
     5855         v-msg =
     5856           "Не найдена единица измерения " + chr(10) +
     5857           "p-unit-name" +   p-unit-name + chr(10) +
     5858           "p-artic" +       p-artic +  chr(10) +
     5859           "p-prod-type" +   p-prod-type + chr(10) +
     5860           "p-proc-code" +   string (p-prod-code) + chr(10) +
     5861           "p-qnty" +        string (p-qnty) + chr(10)
     5862           .
     5863         undo, return error v-msg .
     5864       end.
     5865       assign
     5866         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     5867                 + " " + string(p-prod-code)
     5868         p-unit-description = "Базовая единица измерения"
     5869       .
     5870     end.
     5871     if lookup('шту':U, buf_units.type) > 0
     5872     or lookup('сер':U, buf_units.type) > 0
     5873     then do:
     5874       if p-qnty <> truncate(p-qnty, 0)
     5875       then do:
     5876         v-msg =
     5877           "Для штучного и серийного товаров резервируемое количество должно быть целым" + chr(10) +
     5878           v-artic + chr(10) +
     5879           p-unit-description + buf_units.unit-name + chr(10) +
     5880           "Запрошено количество " + string (p-qnty) + chr(10).
     5881         undo, return error v-msg .
     5882       end.
     5883     end.
     5884   end procedure.
     5885   procedure create-line:
     5886     define input parameter p-doc-code as character no-undo.
     5887     define input-output parameter table for tt2-doc-line.
     5888     def var gds-code as int no-undo.
     5889     def var cli-qnty as dec no-undo.
     5890     def var v-root-node as int no-undo.
     5891     def var vat-pc as dec no-undo.
     5892     find first ub.trn-doc no-lock
     5893         where ub.trn-doc.doc-code = p-doc-code
     5894         no-error.
     5895     if error-status:error then
     5896         return error subst("Не найден документ с кодом &1", p-doc-code).
     5897   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     5898   (input ub.trn-doc.doc-code
     5899   ,input tt2-doc-line.artic
     5900   ,input tt2-doc-line.prod-type
     5901   ,input tt2-doc-line.prod-code
     5902   ,input ub.trn-doc.obj-type
     5903   ,input ub.trn-doc.obj-code
     5904   ,input ''
     5905   ,input trn-doc.ext-doc-type
     5906   ,input tt2-doc-line.prt-root
     5907   ,input tt2-doc-line.vat-pc
     5908   ,input 0
     5909   ,input 0
     5910   ) no-error
     5911   .
     5912     if error-status:error then
     5913         return error substitute("Ошибка при создании линии накладной &1, &2", ub.trn-doc.doc-code, return-value).
     5914     find first ub.doc-line
     5915         where ub.doc-line.doc-code = ub.trn-doc.doc-code
     5916         and ub.doc-line.artic = tt2-doc-line.artic
     5917         and ub.doc-line.prod-type = tt2-doc-line.prod-type
     5918         and ub.doc-line.prod-code = tt2-doc-line.prod-code
     5919         share-lock.
     5920     buffer-copy tt2-doc-line to ub.doc-line.
     5921   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5923     (input  ub.doc-line.artic
     5924     ,input  ub.doc-line.prod-type
     5925     ,input  ub.doc-line.prod-code
     5926     ,output v-root-node
     5927     )  .
     5928   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     5929     ( input ub.trn-doc.obj-code
     5930      ,input ub.trn-doc.obj-type
     5931      ,input ub.trn-doc.doc-code
     5932      ,input ub.doc-line.artic
     5933      ,input ub.doc-line.prod-code
     5934      ,input ub.doc-line.prod-type
     5935      ,input v-root-node
     5936      ,input true
     5937     )  .
     5938     find first ub.gds-dtl share-lock
     5939         where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     5940         and ub.gds-dtl.artic = tt2-doc-line.artic
     5941         and ub.gds-dtl.prod-type = tt2-doc-line.prod-type
     5942         and ub.gds-dtl.prod-code = tt2-doc-line.prod-code
     5943         and ub.gds-dtl.prt-code = v-root-node.
     5944     buffer-copy ub.doc-line to ub.gds-dtl.
     5945     for each tt-parts where tt-parts.artic = tt2-doc-line.artic
     5946                         and tt-parts.prod-type = tt2-doc-line.prod-type
     5947                         and tt-parts.prod-code = tt2-doc-line.prod-code:
     5948       create ub.parts.
     5949       buffer-copy tt-parts except tt-parts.supp-type tt-parts.supp-code to ub.parts
     5950       assign ub.parts.pl-code = 0.
     5951     end.
     5952   end.
     5953   procedure addUpak2MarkingLines:
     5954     define input parameter iMark like ub.marking.mark no-undo.
     5955     find first ub.marking-lines no-lock where
     5956                ub.marking-lines.mark = iMark
     5957            and ub.marking-lines.obj-type = tt-parts.obj-type
     5958            and ub.marking-lines.obj-code = tt-parts.obj-code
     5959            and ub.marking-lines.gds-code = temp_doc-line.gds-code
     5960            and ub.marking-lines.in-code = tt-parts.in-code
     5961            and ub.marking-lines.out-code = tt-parts.out-code
     5962            and ub.marking-lines.part-code = tt-parts.part-code no-error.
     5963     if avail ub.marking-lines
     5964       then return.
     5965     find first buf_marking no-lock where
     5966                buf_marking.mark = iMark
     5967            and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5968            and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB no-error.
     5969     if not available (buf_marking)
     5970       then return.
     5971     find first buf_utd-marking-lines no-lock where
     5972                buf_utd-marking-lines.mark   = buf_marking.mark
     5973            and buf_utd-marking-lines.db-num = temp_doc-line.db-num
     5974            and buf_utd-marking-lines.doc-id = temp_doc-line.doc-id
     5975            and buf_utd-marking-lines.gds-code = temp_doc-line.gds-code
     5976            and buf_utd-marking-lines.LineNum = temp_doc-line.line-num no-error.
     5977     if not available (buf_utd-marking-lines)
     5978       then return.
     5979     create ub.marking-lines.
     5980     assign
     5981       ub.marking-lines.obj-type = tt-parts.obj-type
     5982       ub.marking-lines.obj-code = tt-parts.obj-code
     5983       ub.marking-lines.in-code = tt-parts.in-code
     5984       ub.marking-lines.out-code = tt-parts.out-code
     5985       ub.marking-lines.part-code = tt-parts.part-code
     5986       ub.marking-lines.gds-code = temp_doc-line.gds-code
     5987       ub.marking-lines.mark = buf_utd-marking-lines.mark
     5988       ub.marking-lines.doc-level = buf_utd-marking-lines.doc-level
     5989     .
     5990     if buf_marking.mark-parent <> "" then
     5991       run addUpak2MarkingLines in this-procedure (buf_marking.mark-parent).
     5992   end procedure.
