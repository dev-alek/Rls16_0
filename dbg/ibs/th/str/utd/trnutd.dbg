      831   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   function octal-to-char return character
      833   ( p-string as character ) :
      834     def var v-asc     as integer no-undo .
      835     def var v-new-asc as integer no-undo .
      836     def var ind       as integer no-undo .
      837     if length(p-string) <> 3 then do:
      838       return ? .
      839     end.
      840     assign
      841       v-asc = 0
      842     .
      843     do ind = 1 to length(p-string)
      844     :
      845       assign
      846         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      847       .
      848       if v-new-asc < 0 or v-new-asc >= 8 then do:
      849         return ? .
      850       end.
      851       assign
      852         v-asc = v-asc * 8 + v-new-asc
      853       .
      854     end.
      855     return chr(v-asc) .
      856   end function .
      857   function char-to-octal return character
      858   ( p-chr as character ) :
      859     def var v-asc    as integer   no-undo .
      860     def var ind      as integer   no-undo .
      861     def var v-string as character no-undo .
      862     if length(p-chr) <> 1 then do:
      863       return ? .
      864     end.
      865     assign
      866       v-asc    = asc(p-chr)
      867       v-string = ""
      868     .
      869     do ind = 1 to 3
      870     :
      871       assign
      872         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      873       .
      874       assign
      875         v-asc = truncate(v-asc / 8, 0)
      876       .
      877     end.
      878     return v-string .
      879   end.
      880   function str-encode return character
      881   (   p-init-string       as character
      882     , p-encode-char       as character
      883     , p-special-char-list as character
      884   ) :
      885     def var p-encode-string as character no-undo .
      886     def var ind                as integer no-undo .
      887     def var v-num-special-char as integer no-undo .
      888     def var v-special-char     as character no-undo .
      889     if p-encode-char = ?
      890     or p-encode-char = "" then do:
      891       assign
      892         p-encode-char = "~~"
      893       .
      894     end.
      895     if p-init-string = ? then do:
      896       return "?" .
      897     end.
      898     if p-init-string = "?" then do:
      899       return p-encode-char + char-to-octal("?") .
      900     end.
      901     assign
      902       v-num-special-char = length(p-special-char-list)
      903       p-encode-string    = replace(p-init-string
      904                                   ,p-encode-char
      905                                   ,p-encode-char + char-to-octal(p-encode-char)
      906                                   )
      907     .
      908     do ind = 1 to v-num-special-char
      909     :
      910       assign
      911         v-special-char = substring(p-special-char-list, ind, 1)
      912       .
      913       if v-special-char <> p-encode-char then do:
      914         assign
      915           p-encode-string = replace (p-encode-string
      916                                     ,v-special-char
      917                                     ,p-encode-char + char-to-octal(v-special-char)
      918                                     )
      919         .
      920       end.
      921     end.
      922     return p-encode-string .
      923   end.
      924   function str-decode returns character
      925     (p-init-string   as character
      926     ,p-encode-char   as character
      927     ) :
      928     def var p-decode-string as character no-undo .
      929     def var ind                       as integer no-undo .
      930     def var v-num-entries-init-string as integer no-undo .
      931     def var v-sub-phrase              as character no-undo .
      932     def var v-special-char            as character no-undo .
      933     if p-encode-char = ?
      934     or p-encode-char = "" then do:
      935       assign
      936         p-encode-char = "~~"
      937       .
      938     end.
      939     if p-init-string = "?" then do:
      940       return ? .
      941     end.
      942     assign
      943       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      944     .
      945     if v-num-entries-init-string > 1 then do:
      946       assign
      947         p-decode-string = entry(1, p-init-string, p-encode-char)
      948       .
      949       do ind = 2 to v-num-entries-init-string
      950       :
      951         assign
      952           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      953         .
      954         assign
      955           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      956         .
      957         if v-special-char <> ? then do:
      958           assign
      959             p-decode-string = p-decode-string
      960                             + v-special-char
      961                             + substring(v-sub-phrase, 4)
      962           .
      963         end.
      964         else do:
      965           assign
      966             p-decode-string = p-decode-string
      967                             + p-encode-char
      968                             + v-sub-phrase
      969           .
      970         end.
      971       end.
      972     end.
      973     else do:
      974       assign
      975         p-decode-string = p-init-string
      976       .
      977     end.
      978     return p-decode-string .
      979   end.
