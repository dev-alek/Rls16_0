      110       p-vss-author      = vss-author
      111       p-vss-date        = vss-date
      112       p-vss-workfile    = vss-workfile
      113       p-vss-archive     = vss-archive
      114       p-vss-description = vss-description
      115     .
      116   end procedure.
      117   procedure vss-get-parameters :
      118     define output parameter p-vss-parameters as character no-undo .
      119   end procedure.
      120   define new global shared variable g#vssrevis-logger as handle    no-undo .
      121   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      122   define variable v-vssrevis-logger                   as handle    no-undo .
      123   procedure vss-logevent :
      124     define input  parameter p-extra-paramters as character no-undo .
      125     define variable v-vssrevis-parameters as character no-undo .
      126     do
      127     on error undo, return error return-value
      128     :
      129       if  valid-handle(v-vssrevis-logger)
      130       and v-vssrevis-logger :get-signature("logevent") <> ""
      131       then do:
      132         run vss-get-parameters in this-procedure
      133           (output v-vssrevis-parameters
      134           ).
      135         run logevent in v-vssrevis-logger
      136           (input vss-workfile
      137           ,input vss-revision
      138           ,input v-vssrevis-parameters
      139           ,input p-extra-paramters
      140           ).
      141       end.
      142     end.
      143   end procedure.
      144   assign
      145     v-vssrevis-logger = g#vssrevis-logger
      146   .
      147   if  valid-handle(v-vssrevis-logger)
      148   and v-vssrevis-logger :get-signature("logevent") <> ""
      149   then do:
      150     assign
      151       v-vssrevis-logevent = true
      152     .
      153     run vss-logevent in this-procedure (input vss-description) .
      154   end.
      155   define new global shared variable g#language as character no-undo .
      156   if g#language <> '' and g#language <> 'rus':U then do:
      157     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      158   end.
      159   define new global shared variable g#library  as handle no-undo .
      160   define new global shared variable g#library2 as handle no-undo .
      161   define new global shared variable g#lib-trn  as handle no-undo .
      162   define new global shared variable g#lib-trn2 as handle no-undo .
      163   define new global shared variable g#lib-trn3 as handle no-undo .
      164   define new global shared variable g#lib-trn4 as handle no-undo .
      165   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   define variable to-day       as date no-undo .
      167   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure doc-code:
      169   define input  parameter parmode          as   character           no-undo.
      170   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      171   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      172   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      173   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      174   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      175   define variable vardb-remote     as   logical             no-undo.
      176   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      177   define variable v-delimiter as character no-undo .
      178   do
      179   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      180   :
      181   find first buf_sys-ctrl no-lock .
      182   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      183     CASE parmode:
      184       when "main":u then do:
      185         if vardb-remote then do:
      186           assign
      187             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      188         end.
      189         else do:
      190           assign
      191             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      192         end.
      193       end.
      194       when "trio" then do:
      195         assign
      196           pardoc-code = replace (parroot-doc-code, "=", "*").
      197       end.
      198       otherwise do:
      199         assign
      200         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      201         no-error
      202         .
      203         if error-status:error  then do:
      204           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      205                                         ,chr(10)
      206                                         ,parmode
      207                                         ).
      208         end.
      209         if num-entries(parmode) = 1
      210         and parmode <> "chip":U
      211         and parmode <> "chip_s":U
      212         then do:
      213           assign
      214           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      215         end.
      216         else if (lookup("chip":U, parmode) > 0
      217                  or
      218                  lookup("chip_s":U, parmode) > 0) then do:
      219           assign
      220             vartemp-doc-code = parroot-doc-code.
      221           do while true:
      222             if index (vartemp-doc-code , ".") = 0 then
      223               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      224             else
      225               vartemp-doc-code  =
      226               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      227               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      228               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      229             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      230           end.
      231           assign
      232             pardoc-code = vartemp-doc-code.
      233         end.
      234       end.
      235     end CASE.
      236     if pardoc-code = '':U
      237     or (parroot-doc-code <> '':U
      238     and pardoc-code = parroot-doc-code) then do:
      239       undo, return error substitute("Ошибка при генерации номера документа&1"
      240                                     ,chr(10)).
      241     end.
      242   end.
      243   end. // procedure/method
      244   function get-doc-code-int64 returns int64
      245     ( input p-doc-code as character ) :
      246     define variable v-ind              as integer   no-undo .
      247     define variable v-num-entries      as integer   no-undo .
      248     define variable v-doc-code-int64   as int64     no-undo .
      249     define variable v-canonic-doc-code as character no-undo .
      250     assign
      251       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      252       v-canonic-doc-code = p-doc-code
      253     .
      254     do v-ind = 1 to v-num-entries
      255     :
      256       assign
      257         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      258       .
      259     end.
      260     assign
      261       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      262     .
      263     return v-doc-code-int64 .
      264   end. // function/method
      265   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   define variable v-waitfram-action01         as character   no-undo .
      267   define variable v-waitfram-action02         as character   no-undo .
      268   define variable v-waitfram-action03         as character   no-undo .
      269   define variable mWaitFramTextBeg            as character   no-undo.
      270   define variable mWaitFramTextEnd            as character   no-undo.
      271   define variable mWaitFramView               as logical     no-undo.
      272   define variable mWaitProcEvent              as logical     no-undo init yes.
      273   define variable mWaitFramInterval           as integer     no-undo init 1 .
      274   define variable mWaitFramStop               as logical     no-undo.
      275   define variable mWaitFramStopUser           as logical     no-undo.
      276   define variable mWaitFramStopTimeOut        as logical     no-undo.
      277   define variable mWaitFramStartProc          as datetime-tz no-undo.
      278   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      279   define button B-WaitFramStop auto-end-key
      280        label "Стоп"
      281        size 10 by 1 tooltip "Остоновить процесс".
      282   define button B-viewProcInfo
      283        label "Информация"
      284        size 15 by 1 tooltip "Информация о процесс".
      285   define frame waitfram
      286     v-waitfram-action01 format "x(72)" no-label skip
      287     v-waitfram-action02 format "x(72)" no-label skip
      288     v-waitfram-action03 format "x(72)" no-label skip
      289     B-viewProcInfo
      290     B-WaitFramStop at row 4 col 30
      291     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      292     .
      293   define new global shared variable mBatchMode as logical no-undo init ?.
      294   define variable mFramBachModHandle as handle no-undo.
      295   mFramBachModHandle = frame waitfram:handle.
      296   define variable mFameOldVis as logical no-undo.
      297   define variable mVisCUrentVin as logical no-undo.
      298   if session:batch-mode
      299   then
      300      mBatchMode = yes.
      301   if mBatchMode = ? then do:
      302     mVisCUrentVin = current-window:visible.
      303     mFameOldVis = mFramBachModHandle:visible.
      304     mFramBachModHandle:visible  = yes.
      305     mBatchMode = mFramBachModHandle:visible ne yes.
      306     mFramBachModHandle:visible = mFameOldVis.
      307     current-window:visible = mVisCUrentVin.
      308   end.
      309    if  log-manager:logfile-name ne ?
      310     then DO:
      311         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      312         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      313         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      314     end.
      315   on choose of B-WaitFramStop in frame waitfram
      316   do:
      317     mWaitFramStop = yes.
      318     mWaitFramStopUser = yes.
      319   end.
      320   function waitfram-check-timeout returns logical():
      321      define variable vtime as int64 no-undo.
      322      if mWaitFramStopTimeOut
      323      then
      324         return yes.
      325      vtime = ( now - mWaitFramStartProc ) / 1000 .
      326      if     mWaitFramTimeOut ne ?
      327         and mWaitFramTimeOut ne 0
      328         and mWaitFramTimeOut lt vtime
      329      then do:
      330         mWaitFramStopTimeOut = yes.
      331      end.
      332      return mWaitFramStopTimeOut.
      333   end.
      334   procedure waitfram-hide :
      335     if not session:batch-mode
      336     then do
      337     on error undo, return error return-value
      338     :
      339       pause 0 before-hide .
      340       if not mBatchMode then
      341         hide frame waitfram .
      342     if     not mWaitFramView
      343        and mWaitProcEvent
      344     then
      345       process events .
      346     end.
      347   end procedure.
      348   procedure waitfram-show :
      349     define input  parameter p-message as character no-undo .
      350     define variable v-left-margin as integer   no-undo .
      351     if not session:batch-mode
      352     then do
      353     on error undo, return error return-value
      354     :
      355       if length(p-message) <= 70 then do:
      356         assign
      357           v-left-margin = integer((70 - length(p-message)) / 2)
      358         .
      359         assign
      360           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      361         .
      362         assign
      363           v-waitfram-action01 = " "
      364           v-waitfram-action02 = " "
      365                                    + fill(" ", v-left-margin)
      366                                    + p-message
      367           v-waitfram-action03 = " "
      368         .
      369       end.
      370       else do:
      371         define variable vRindex1 as integer no-undo.
      372         define variable vRindex2 as integer no-undo.
      373         vRindex1 = r-index(p-message," ",70).
      374         if vRindex1 = 0
      375         then
      376            vRindex1 = 70.
      377         if length(p-message)  <= vRindex1 + 70 then do:
      378           assign
      379             v-waitfram-action01 = " "
      380             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      381             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      382           .
      383         end.
      384         else do:
      385           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      386           if vRindex2 <= vRindex1
      387           then
      388              vRindex2 = vRindex1 + 70.
      389           assign
      390             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      391             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      392             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      393           .
      394         end.
      395       end.
      396       B-viewProcInfo:visible   in frame waitfram = no.
      397       B-viewProcInfo:sensitive in frame waitfram = no.
      398       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      399       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      400       if  (   mWaitFramView
      401          or  mWaitProcEvent)
      402          and not mBatchMode
      403       then
      404          display
      405             v-waitfram-action01 skip
      406             v-waitfram-action02 skip
      407             v-waitfram-action03 skip
      408          with frame waitfram .
      409       if     mWaitFramView
      410          then do:
      411             if     mWaitFramInterval ne ?
      412                and not mBatchMode
      413             then
      414                wait-for go of frame waitfram pause mWaitFramInterval.
      415          end.
      416          else
      417             if     mWaitProcEvent
      418                and not mBatchMode
      419             then
      420                process events .
      421     end.
      422   end procedure.
      423      procedure waitfram-show-this:
      424         define input  parameter iInterval as int64 no-undo.
      425         define variable vtime as int64 no-undo.
      426         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      427         mWaitFramInterval = iInterval.
      428         run waitfram-show (substitute("&1&2 &3&4" ,
      429                                       mWaitFramTextBeg ,
      430                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      431                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      432                                       mWaitFramTextEnd
      433                                      )
      434                           ).
      435      end.
      436      procedure WaitFramRunPause:
      437         define input  parameter iInterval as dec no-undo.
      438         define variable vStart  as datetime-tz no-undo.
      439         define variable vend    as datetime-tz no-undo.
      440         define variable vint as int64 no-undo.
      441         define variable vOk as logical no-undo.
      442         vStart = now.
      443         vend   = vStart.
      444         publish "WaitFramPause" (iInterval,output vOk).
      445         vend   =  now.
      446         vint = vend - vStart.
      447         vint = iInterval - vint / 1000.
      448         if     not mWaitFramStop
      449            and (   vint > 0
      450                 or (    not vOk
      451                     and iInterval eq ?
      452                     )
      453                 )
      454         then
      455            run waitfram-show-this (iInterval).
      456         vend   =  now.
      457         vint = vend - vStart.
      458         vint = iInterval - vint / 1000.
      459         if     not mWaitFramStop
      460            and vint > 0
      461         then do:
      462            run gbl/pause.p (vint * 1000).
      463         end.
      464         if iInterval ne ?
      465         then
      466            publish "WaitFramStop".
      467         waitfram-check-timeout().
      468      end.
      469      procedure WaitFramWaitFor:
      470         define input  parameter iInterval as dec no-undo.
      471         assign
      472            mWaitFramStartProc   = now
      473            mWaitFramStopUser    = no
      474            mWaitFramStopTimeOut = no
      475         .
      476         block-wait:
      477         do while not mWaitFramStop:
      478            run WaitFramRunPause (iInterval).
      479            if  waitfram-check-timeout()
      480            then do:
      481               leave block-wait.
      482            end.
      483         end.
      484         run waitfram-hide.
      485      end.
      486   procedure waitfram-join :
      487     define input  parameter p-line-1  as character no-undo .
      488     define input  parameter p-line-2  as character no-undo .
      489     define input  parameter p-line-3  as character no-undo .
      490     define output parameter p-message as character no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494       assign
      495         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      496                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      497                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      498       .
      499     end.
      500   end procedure.
      501   function waitfram-join-function returns character
      502     (input p-line-1 as character
      503     ,input p-line-2 as character
      504     ,input p-line-3 as character
      505     ).
      506     define variable v-message as character no-undo .
      507     run waitfram-join in this-procedure
      508       (input  p-line-1
      509       ,input  p-line-2
      510       ,input  p-line-3
      511       ,output v-message
      512       ) .
      513     return v-message .
      514   end function .
      515   function cross-list returns logical (
      516     input parfirst-stream  as character,
      517     input parsecond-stream as character,
      518     input pardelim         as character).
      519     if pardelim = ""
      520     or pardelim = ?
      521     then do:
      522       assign
      523         pardelim = ","
      524       .
      525     end.
      526     define variable vari            as integer no-undo .
      527     define variable varresult-cross as logical no-undo .
      528     assign
      529       varresult-cross = no
      530     .
      531     def var v-num-parfirst-stream as integer no-undo .
      532     assign
      533       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      534     .
      535     do vari = 1 to v-num-parfirst-stream
      536     :
      537       if lookup(entry(vari, parfirst-stream, pardelim)
      538                ,parsecond-stream
      539                ,pardelim
      540                ) > 0 then do:
      541         assign
      542           varresult-cross = yes
      543         .
      544         leave.
      545       end.
      546     end.
      547     return varresult-cross .
      548   end function.
