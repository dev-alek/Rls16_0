     2552   procedure xmlchar-test :
     2553   define input parameter p-in-string          as character        no-undo.
     2554   define output parameter p-out-string-enc    as character        no-undo.
     2555   define output parameter p-out-string-dec    as character        no-undo.
     2556   do
     2557   on error undo, return error
     2558   :
     2559          run xmlchar-encode in this-procedure
     2560       (
     2561             input p-in-string
     2562           , output p-out-string-enc
     2563       ).
     2564          run xmlchar-decode in this-procedure
     2565       (
     2566             input p-out-string-enc
     2567           , output p-out-string-dec
     2568       ).
     2569   end.
     2570   end .
     2571   procedure xmlchar-encode :
     2572   define input parameter p-in-string      as character        no-undo.
     2573   define output parameter p-out-string    as character        no-undo.
     2574       define variable v-position      as integer      no-undo.
     2575       define variable v-current-char  as character    no-undo.
     2576   do
     2577   on error undo, return error
     2578   :
     2579       assign
     2580           p-out-string = "":U
     2581       .
     2582       case p-in-string
     2583       :
     2584           when ?
     2585           then do:
     2586               assign
     2587                   p-out-string = "?":U
     2588               .
     2589           end.
     2590           when "?":U
     2591           then do:
     2592               assign
     2593                   p-out-string = "&#63;":U
     2594               .
     2595           end.
     2596           otherwise do:
     2597               do v-position = 1 to length( p-in-string )
     2598               :
     2599                   assign
     2600                       v-current-char = substring( p-in-string, v-position, 1 )
     2601                   .
     2602                   case v-current-char
     2603                   :
     2604                       when "&":U
     2605                       then do:
     2606                           assign
     2607                               p-out-string = p-out-string + "&amp;":U
     2608                           .
     2609                       end.
     2610                       when ">":U
     2611                       then do:
     2612                           assign
     2613                               p-out-string = p-out-string + "&gt;":U
     2614                           .
     2615                       end.
     2616                       when "<":U
     2617                       then do:
     2618                           assign
     2619                               p-out-string = p-out-string + "&lt;":U
     2620                           .
     2621                       end.
     2622                       when "'":U
     2623                       then do:
     2624                           assign
     2625                               p-out-string = p-out-string + "&apos;":U
     2626                           .
     2627                       end.
     2628                       when '"':U
     2629                       then do:
     2630                           assign
     2631                               p-out-string = p-out-string + "&quot;":U
     2632                           .
     2633                       end.
     2634                       when chr(1)
     2635                       then do:
     2636                           assign
     2637                               p-out-string = p-out-string + "":U
     2638                           .
     2639                       end.
     2640                       when chr(2)
     2641                       then do:
     2642                           assign
     2643                               p-out-string = p-out-string + "":U
     2644                           .
     2645                       end.
     2646                       when chr(3)
     2647                       then do:
     2648                           assign
     2649                               p-out-string = p-out-string + "":U
     2650                           .
     2651                       end.
     2652                       when chr(4)
     2653                       then do:
     2654                           assign
     2655                               p-out-string = p-out-string + "":U
     2656                           .
     2657                       end.
     2658                       when chr(5)
     2659                       then do:
     2660                           assign
     2661                               p-out-string = p-out-string + "":U
     2662                           .
     2663                       end.
     2664                       when chr(6)
     2665                       then do:
     2666                           assign
     2667                               p-out-string = p-out-string + "":U
     2668                           .
     2669                       end.
     2670                       when chr(7)
     2671                       then do:
     2672                           assign
     2673                               p-out-string = p-out-string + "":U
     2674                           .
     2675                       end.
     2676                       when chr(8)
     2677                       then do:
     2678                           assign
     2679                               p-out-string = p-out-string + "":U
     2680                           .
     2681                       end.
     2682                       when chr(9)
     2683                       then do:
     2684                           assign
     2685                               p-out-string = p-out-string + "":U
     2686                           .
     2687                       end.
     2688                       when chr(29)
     2689                       then do:
     2690                           assign
     2691                               p-out-string = p-out-string + "":U
     2692                           .
     2693                       end.
     2694                       when chr(10)
     2695                       then do:
     2696                           assign
     2697                               p-out-string = p-out-string + "&#10;":U
     2698                           .
     2699                       end.
     2700                       when chr(13)
     2701                       then do:
     2702                           assign
     2703                               p-out-string = p-out-string + "&#13;":U
     2704                           .
     2705                       end.
     2706                       otherwise do:
     2707                           assign
     2708                               p-out-string = p-out-string + v-current-char
     2709                           .
     2710                       end.
     2711                   end case.
     2712               end.
     2713           end.
     2714       end case.
     2715   end.
     2716   end .
     2717   procedure xmlchar-encode-1c :
     2718   define input parameter p-in-string      as character        no-undo.
     2719   define output parameter p-out-string    as character        no-undo.
     2720       define variable v-position      as integer      no-undo.
     2721       define variable v-current-char  as character    no-undo.
     2722   do
     2723   on error undo, return error
     2724   :
     2725       assign
     2726           p-out-string = "":U
     2727       .
     2728       case p-in-string
     2729       :
     2730           when ?
     2731           then do:
     2732               assign
     2733                   p-out-string = "?":U
     2734               .
     2735           end.
     2736           otherwise do:
     2737               do v-position = 1 to length( p-in-string )
     2738               :
     2739                   assign
     2740                       v-current-char = substring( p-in-string, v-position, 1 )
     2741                   .
     2742                   case v-current-char
     2743                   :
     2744                       when chr(1)
     2745                       then do:
     2746                           assign
     2747                               p-out-string = p-out-string + " ":U
     2748                           .
     2749                       end.
     2750                       when chr(2)
     2751                       then do:
     2752                           assign
     2753                               p-out-string = p-out-string + " ":U
     2754                           .
     2755                       end.
     2756                       when chr(3)
     2757                       then do:
     2758                           assign
     2759                               p-out-string = p-out-string + " ":U
     2760                           .
     2761                       end.
     2762                       when chr(4)
     2763                       then do:
     2764                           assign
     2765                               p-out-string = p-out-string + " ":U
     2766                           .
     2767                       end.
     2768                       when chr(5)
     2769                       then do:
     2770                           assign
     2771                               p-out-string = p-out-string + " ":U
     2772                           .
     2773                       end.
     2774                       when chr(6)
     2775                       then do:
     2776                           assign
     2777                               p-out-string = p-out-string + " ":U
     2778                           .
     2779                       end.
     2780                       when chr(7)
     2781                       then do:
     2782                           assign
     2783                               p-out-string = p-out-string + " ":U
     2784                           .
     2785                       end.
     2786                       when chr(8)
     2787                       then do:
     2788                           assign
     2789                               p-out-string = p-out-string + " ":U
     2790                           .
     2791                       end.
     2792                       when chr(9)
     2793                       then do:
     2794                           assign
     2795                               p-out-string = p-out-string + " ":U
     2796                           .
     2797                       end.
     2798                       when chr(29)
     2799                       then do:
     2800                           assign
     2801                               p-out-string = p-out-string + " ":U
     2802                           .
     2803                       end.
     2804                       when chr(10)
     2805                       then do:
     2806                           assign
     2807                               p-out-string = p-out-string + " ":U
     2808                           .
     2809                       end.
     2810                       when chr(13)
     2811                       then do:
     2812                           assign
     2813                               p-out-string = p-out-string + " ":U
     2814                           .
     2815                       end.
     2816                       otherwise do:
     2817                           assign
     2818                               p-out-string = p-out-string + v-current-char
     2819                           .
     2820                       end.
     2821                   end case.
     2822               end.
     2823           end.
     2824       end case.
     2825   end.
     2826   end .
     2827   procedure xmlchar-decode :
     2828   define input parameter p-in-string      as character        no-undo.
     2829   define output parameter p-out-string    as character        no-undo.
     2830       define variable v-position      as integer      no-undo.
     2831       define variable v-last-position as integer      no-undo.
     2832       define variable v-temp-integer  as integer      no-undo.
     2833       define variable v-current-char  as character    no-undo.
     2834       define variable v-next-char     as character    no-undo.
     2835       define variable v-success       as logical      no-undo.
     2836   do
     2837   on error undo, return error
     2838   :
     2839       assign
     2840           p-out-string = "":U
     2841           v-position   = 0
     2842       .
     2843       replace-cycle:
     2844       do while yes
     2845       on error undo, return error
     2846       :
     2847           assign
     2848               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2849           .
     2850           if v-last-position <= v-position
     2851           then do:
     2852               if v-position = 0
     2853               then do:
     2854                   assign
     2855                       p-out-string = p-in-string
     2856                   .
     2857               end.
     2858               else do:
     2859                   assign
     2860                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2861                   .
     2862               end.
     2863               leave replace-cycle.
     2864           end.
     2865           else do:
     2866               assign
     2867                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2868                   v-position      = v-last-position
     2869                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2870               .
     2871               if v-current-char = "#":U
     2872               then do:
     2873                   assign
     2874                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2875                   .
     2876                   if v-last-position > 0
     2877                   then do:
     2878                       run xmlchar-read-integer in this-procedure
     2879                        (
     2880                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2881                           , output v-temp-integer
     2882                           , output v-success
     2883                       ).
     2884                       if v-success = yes
     2885                       and v-temp-integer >= 1
     2886                       and v-temp-integer <= 255
     2887                       then do:
     2888                           assign
     2889                               p-out-string = p-out-string + chr( v-temp-integer )
     2890                               v-position   = v-last-position + 1
     2891                           .
     2892                       end.
     2893                       else do:
     2894                           assign
     2895                               p-out-string = p-out-string + "&":U
     2896                               v-position   = v-position   + 1
     2897                           .
     2898                       end.
     2899                   end.
     2900                   else do:
     2901                       assign
     2902                           p-out-string = p-out-string + "&":U
     2903                           v-position   = v-position   + 1
     2904                       .
     2905                   end.
     2906               end.
     2907               else do:
     2908                   case substring( p-in-string, v-position + 1, 3 )
     2909                   :
     2910                       when "lt;":U
     2911                       then do:
     2912                           assign
     2913                               p-out-string = p-out-string + "<":U
     2914                               v-position   = v-position   + 3
     2915                           .
     2916                       end.
     2917                       when "gt;":U
     2918                       then do:
     2919                           assign
     2920                               p-out-string = p-out-string + ">":U
     2921                               v-position   = v-position   + 3
     2922                           .
     2923                       end.
     2924                       otherwise do:
     2925                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2926                           then do:
     2927                               assign
     2928                                   p-out-string = p-out-string + "&":U
     2929                                   v-position   = v-position   + 4
     2930                               .
     2931                           end.
     2932                           else do:
     2933                               case substring( p-in-string, v-position + 1, 5 )
     2934                               :
     2935                                   when "quot;":U
     2936                                   then do:
     2937                                       assign
     2938                                           p-out-string = p-out-string + '"':U
     2939                                           v-position   = v-position   + 5
     2940                                       .
     2941                                   end.
     2942                                   when "apos;":U
     2943                                   then do:
     2944                                       assign
     2945                                           p-out-string = p-out-string + "'":U
     2946                                           v-position   = v-position   + 5
     2947                                       .
     2948                                   end.
     2949                                   otherwise do:
     2950                                       assign
     2951                                           p-out-string = p-out-string + "&":U
     2952                                       .
     2953                                   end.
     2954                               end case.
     2955                           end.
     2956                       end.
     2957                   end case.
     2958               end.
     2959           end.
     2960       end.
     2961   end.
     2962   end .
     2963   procedure xmlchar-read-integer :
     2964   define input parameter p-input-string      as character        no-undo.
     2965   define output parameter p-output-integer   as integer          no-undo.
     2966   define output parameter p-success       as logical          no-undo.
     2967   do
     2968   on error undo, return error
     2969   :
     2970       assign
     2971           p-output-integer = integer( p-input-string )
     2972       no-error.
     2973       if error-status :error
     2974       then do:
     2975           assign
     2976               p-success           = no
     2977               p-output-integer    = 0
     2978           .
     2979       end.
     2980       else do:
     2981           assign
     2982               p-success           = yes
     2983           .
     2984       end.
     2985   end.
     2986   end.
     2987   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2988   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2989   define variable mMRCCode  as logical    no-undo.
     2990   define variable mTypeMark as character  no-undo.
     2991   function IS-NeedMark returns logical
     2992   ( input ib-code as integer  ,
     2993     input ib-str as character ):
     2994      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2995      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2996                                    and buf_prod-bc-attr.b-str  eq ib-str
     2997                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2998        no-lock no-error.
     2999      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3000   end.
     3001   function repTegforDm return char
     3002   (iDM as char ):
     3003       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3004       define variable vteg as character no-undo.
     3005       define variable oDM as character no-undo.
     3006       define variable vi as integer no-undo.
     3007       oDM = iDm.
     3008       do vi = 1 to num-entries(vTeglist):
     3009          vTeg = entry(vi,vTeglist).
     3010          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3011       end.
     3012       return oDM.
     3013   end.
     3014   function repSpecSimbforDm return char
     3015   (iDM as char ):
     3016       define variable oDM as character no-undo.
     3017     run
     3018       xmlchar-decode(iDM, output oDM).
     3019     return repTegforDm (oDM).
     3020   end.
     3021   function CheckGtin return logical
     3022   (iGtin as char):
     3023      define variable bar_code as character no-undo.
     3024      define variable vGtin as logical no-undo init "yes".
     3025      if length(iGtin) eq 14
     3026      then do:
     3027         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3028         run str/chk-sum.p
     3029          (input-output bar_code ) no-error .
     3030         if iGtin ne  bar_code
     3031         then
     3032            vGtin = no.
     3033      end.
     3034      else
     3035         vGtin = no.
     3036      return vgtin.
     3037   end.
     3038   function repSpecSimbforXlm return char
     3039   (iDM as char ):
     3040       iDM = replace(iDM,chr(29),"").
     3041       return iDM.
     3042   end.
     3043   function getGtinByDM return char
     3044   (IDM as char):
     3045      define variable VTXT as char no-undo.
     3046      define variable vGtin as char no-undo.
     3047      vTXt = IdM.
     3048      vGtin = IDM.
     3049      if    length(vtxt) > 14
     3050      then do:
     3051         if   vtxt begins "(01)"
     3052                or vtxt begins "(02)"
     3053         then
     3054            vGtin = substring(vtxt,5,14).
     3055         else if   (vtxt begins "01"
     3056                or vtxt begins "02" )
     3057                and (   (    substring(iDm,17,2) eq "21"
     3058                         and length(vtxt) >= 21)
     3059                     or substring(iDm,17,2) eq "37"
     3060                     or substring(iDm,17,4) eq "(37)" )
     3061         then do:
     3062            vGtin = substring(vtxt,3,14).
     3063            if not checkGtin(vGtin)
     3064            then
     3065               vGtin = substring(vtxt,1,14).
     3066         end.
     3067         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3068             or length(vtxt) eq 14 + 7 + 4
     3069             or length(vtxt) eq 14 + 7
     3070         then
     3071            vGtin = substring(vtxt,1,14).
     3072      end.
     3073      if not checkGtin(vGtin)
     3074      then
     3075         vGtin = "".
     3076      return vgtin.
     3077   end.
     3078   function getGdsCodeByGtin return int
     3079   (iGtin as char):
     3080      define buffer prod-bc  for ub.prod-bc.
     3081      define buffer bar-code for ub.bar-code.
     3082      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3083      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3084      return if avail bar-code then bar-code.gds-code else ?.
     3085   end.
     3086   function getQntyCodeByGtin return decimal
     3087   (iGtin as char):
     3088      define buffer prod-bc  for ub.prod-bc.
     3089      define buffer bar-code for ub.bar-code.
     3090      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3091      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3092      return if avail bar-code then bar-code.cli-base-rate else ?.
     3093   end.
     3094   function getGdsCodeByDM return int
     3095   (iDm as char):
     3096      define variable vGtin as char no-undo.
     3097      define buffer prod-bc for ub.prod-bc.
     3098      vGtin  = getGtinByDM (IDM ).
     3099      return getGdsCodeByGtin (vGtin).
     3100   end.
     3101   function ChekTypeMarkByGds return logical
     3102   (iGds-code as integer ):
     3103      define buffer goods-attr for ub.goods-attr.
     3104      find first goods-attr where goods-attr.gds-code   = iGds-code
     3105                              and goods-attr.attr-code  = 'mark-type':U
     3106      no-lock no-error.
     3107      if available goods-attr
     3108      then do:
     3109         mTypeMark = goods-attr.attr-value.
     3110         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3111           .
     3112      end.
     3113      else
     3114         return no.
     3115   end.
     3116   function ChekTypeMarkByDm return logical
     3117   (iDM as char ):
     3118      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3119   end.
     3120   function ChekTypeMarkByGtin return logical
     3121   (iGtin as char ):
     3122      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3123   end.
     3124   function GetNextElement return character
     3125     (input iAllTeg        as logical
     3126     ,output oteg          as character
     3127     ,output otegval       as character
     3128     ,input-output pstr    as character
     3129      ):
     3130        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3131        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3132        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3133        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3134        define variable vTeg as character no-undo.
     3135        define variable vLength as integer no-undo.
     3136        define variable vi as integer no-undo.
     3137        define variable vj as integer no-undo.
     3138        define buffer code for ub.code.
     3139        find first code where Code.parent eq "MarkType"
     3140                          and Code.CodeValue   eq mTypeMark
     3141                          no-lock no-error.
     3142        if     available code
     3143           and Code.misc1 ne ""
     3144           and Code.misc1 ne ?
     3145        then do:
     3146           integer (Code.misc1) no-error.
     3147           if not error-status:error
     3148           then
     3149             entry (4,vlistleng) = Code.misc1.
     3150        end.
     3151        if iAllTeg
     3152        then
     3153           assign
     3154              vlistElem     = vlistElem    + vlistElemDop
     3155              vlistleng     = vlistleng    + vlistlengDop
     3156           .
     3157        else if mMRCCode
     3158        then
     3159           assign
     3160              vlistElem     = vlistElem    + ",(8005),8005"
     3161              vlistleng     = vlistleng    + ",000006,0006"
     3162           .
     3163       block-elem:
     3164       do vi = 1 to num-entries(vlistElem):
     3165          vTeg = entry(vi,vlistElem).
     3166          if pstr begins vTeg
     3167          then do:
     3168             if    vTeg eq "21"
     3169             then
     3170                vLength = index(pstr,chr(29)) - 2 no-error.
     3171             if vLength  <= 0
     3172             then
     3173                vLength = int(entry(vi,vlistleng)).
     3174             otegval = substring (pstr,length(vteg) + 1, vLength).
     3175             oteg = replace(replace(vteg,")",""),"(","").
     3176             vTeg = vteg + otegval.
     3177             otegval = replace(otegval,chr(29),"").
     3178             oteg = replace(replace(oteg,")",""),"(","").
     3179             pstr = substring (pstr,length(vTeg)+ 1).
     3180             vTeg = replace(vTeg,chr(29),"").
     3181             leave block-elem.
     3182          end.
     3183          else
     3184             vTeg = "".
     3185       end.
     3186       return vteg.
     3187   end.
     3188   function GetCodeIdent return character
     3189   (iDm as char):
     3190      define variable Velement   as character no-undo init "first".
     3191      define variable oCodeIdent as character no-undo.
     3192      define variable vteg as character no-undo.
     3193      define variable vtegval as character no-undo.
     3194      define variable vGtin as character no-undo.
     3195      define buffer marking for ub.marking.
     3196      for first marking no-lock where
     3197                marking.mark eq iDm
     3198            and marking.unit-ext = "LEVEL2"
     3199      :
     3200        return iDm.
     3201      end.
     3202      vGtin  = getGtinByDM (iDm ).
     3203      ChekTypeMarkByDm(idm).
     3204      if iDm begins 'tech_':U
     3205      then
     3206         oCodeIdent = iDm.
     3207      else if length(iDm) < 21
     3208      then do:
     3209         find first marking where marking.mark eq idm
     3210         no-lock no-error.
     3211         oCodeIdent = if available marking then marking.mark else  ?.
     3212      end.
     3213      else if     length(iDm) eq 29
     3214         and not iDm begins "01"
     3215         and not iDm begins "02"
     3216      then
     3217         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3218      else  if     length(iDm) >= 24
     3219               and (  iDm begins "01"
     3220                   or iDm begins "02")
     3221               and  substring(iDm,17,2) ne "21"
     3222      then do:
     3223         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3224                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3225         then
     3226            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3227         else
     3228            oCodeIdent = iDM.
     3229      end.
     3230      else  if     (   length(iDm) eq 25
     3231                    or length(iDm) eq 21)
     3232               and (not iDm begins "01"
     3233               and  not iDm begins "02")
     3234      then
     3235         oCodeIdent = substring(iDm,1,21).
     3236      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3237      then
     3238         oCodeIdent = substring(iDm,1,21).
     3239      else do while Velement ne "" and idm ne "":
     3240         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3241         oCodeIdent = oCodeIdent + Velement.
     3242      end.
     3243      return oCodeIdent.
     3244   end.
     3245   function GetTegCod return character
     3246   (icodeIdent as char, iTeg as char):
     3247      define variable Velement   as character no-undo init "first".
     3248      define variable oTeg as character no-undo init ?.
     3249      define variable vteg as character no-undo.
     3250      define variable vtegval as character no-undo.
     3251      if     ((length(icodeIdent) eq 21
     3252         and not icodeIdent begins "01"
     3253         and not icodeIdent begins "02")
     3254         or
     3255             ( length(icodeIdent) eq 25
     3256               and not icodeIdent begins "01"
     3257               and not icodeIdent begins "02"))
     3258      then do:
     3259         if iTeg eq "01" or iTeg eq "02"
     3260         then
     3261            oTeg = substring(icodeIdent,1,21).
     3262         else  if  iTeg eq "21"
     3263         then
     3264            oTeg = substring(icodeIdent,15,7).
     3265      end.
     3266      else do:
     3267         ChekTypeMarkByDm(icodeIdent).
     3268         block-teg:
     3269            do while Velement ne "" and icodeIdent ne "":
     3270            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3271            if    Velement begins iTeg
     3272               or Velement begins "(" + iTeg + ")"
     3273            then do:
     3274               oTeg = vtegval.
     3275               leave block-teg.
     3276            end.
     3277         end.
     3278      end.
     3279      return oTeg.
     3280   end.
     3281   function isOAD return logical
     3282   (icodeIdent as character):
     3283      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3284   end.
     3285   function isMark return logical
     3286   (icodeIdent as character):
     3287      define buffer buf_marking for ub.marking.
     3288      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3289             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3290   end.
     3291   function addBracketForCode return character
     3292   (icodeIdent as char):
     3293      define variable Velement   as character no-undo init "first".
     3294      define variable oTeg as character no-undo.
     3295      define variable vteg as character no-undo.
     3296      define variable vtegval as character no-undo.
     3297      define buffer marking for ub.marking.
     3298      find first marking no-lock where
     3299                 marking.mark begins icodeIdent no-error.
     3300      if    not ChekTypeMarkByDm(icodeIdent)
     3301         or length(icodeIdent) le 24
     3302         or (avail marking and marking.unit-ext = "LEVEL2")
     3303      then
     3304         oTeg = icodeIdent.
     3305      else do:
     3306         if (  icodeIdent begins "01"
     3307            or icodeIdent begins "02"
     3308            ) and CheckGtin(substring (icodeIdent,3,14))
     3309            and substring (icodeIdent,17,2) eq "21"
     3310         then do:
     3311            mMRCCode = yes.
     3312            ChekTypeMarkByDm(icodeIdent).
     3313            block-teg:
     3314            do while Velement ne "" and icodeIdent ne "":
     3315               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3316               if vteg ne ""
     3317               then
     3318                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3319            end.
     3320            mMRCCode = no.
     3321         end.
     3322         else do:
     3323            oTeg = icodeIdent.
     3324         end.
     3325      end.
     3326      return oTeg.
     3327   end.
     3328   function getlevelByCodId return int
     3329   (iCode as char):
     3330      define variable vLength as int no-undo.
     3331      define variable vLevel  as int no-undo.
     3332      if not ChekTypeMarkByDM (icode) then return ?.
     3333      vLength = length(iCode).
     3334      if    vLength eq 18
     3335         or vLength eq 20
     3336      then
     3337         Vlevel = 4.
     3338      else if vLength eq 21
     3339      then
     3340         Vlevel = 1.
     3341      else if vLength eq 25
     3342      then do:
     3343         if  iCode begins "01"
     3344         then
     3345            Vlevel = 3.
     3346         else
     3347            Vlevel = 1.
     3348      end.
     3349      else if     vLength >= 26
     3350              and vLength <= 46
     3351      then do:
     3352         if    substring(iCode,17,2) eq "11"
     3353            or substring(iCode,17,2) eq "13"
     3354            or (    substring(iCode,17,2) eq "21"
     3355                and vLength >= 33
     3356                and substring(iCode,26,4) ne "8005")
     3357         then
     3358            Vlevel = 4.
     3359         else if    vLength eq 31
     3360                 or vLength eq 38
     3361                 or vLength eq 39
     3362                 or vLength eq 45
     3363         then
     3364            Vlevel = 1.
     3365         else if    vLength eq 35
     3366                 or vLength eq 43
     3367         then
     3368            Vlevel = 3.
     3369         else
     3370            Vlevel = ?.
     3371      end.
     3372      else
     3373         Vlevel = ?.
     3374      return Vlevel.
     3375   end.
     3376   function getLevelMotpBycodid return character
     3377   (iDm as char):
     3378      define variable vLevel as integer no-undo.
     3379      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3380      vLevel = getlevelByCodId(iDm).
     3381      if    vLevel eq ?
     3382         or vLevel < 1
     3383         or vLevel > 6
     3384      then
     3385         return ?.
     3386      else
     3387         return entry(vlevel,vList).
     3388   end.
     3389   function getLevelUTDByLevelMotp return character
     3390   (iUnit as char):
     3391      define variable vLevel as integer no-undo.
     3392      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3393      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3394      vLevel = lookup(iUnit,vListMOTP).
     3395      if    vLevel eq ?
     3396         or vLevel < 1
     3397         or vLevel > 4
     3398      then
     3399         return ?.
     3400      else
     3401         return entry(vlevel,vListutd).
     3402   end.
     3403   function getLevelMotpByDM return character
     3404   (iDm as char):
     3405      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3406   end.
     3407   function getLevelUTDByCodId return character
     3408   (iDm as char):
     3409      define variable vLevel as integer no-undo.
     3410      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3411      vLevel = getlevelByCodId(iDm).
     3412      if    vLevel eq ?
     3413         or vLevel < 1
     3414         or vLevel > 4
     3415      then
     3416         return ?.
     3417      else
     3418         return entry(vlevel,vList).
     3419   end.
     3420   function getLevelUTDByDM return character
     3421   (iDm as char):
     3422      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3423   end.
     3424   define variable mNotMarkQnty as logical no-undo.
     3425   function getQntyUTDByCodId return decimal
     3426   (iDM as char):
     3427      define variable vLevel as integer no-undo.
     3428      define variable vList as character no-undo init "1,5,10,500".
     3429      define variable vGtin as character no-undo.
     3430      define variable vqnty as decimal no-undo init ?.
     3431      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3432      if vqnty eq ?
     3433      then do:
     3434         if not mNotMarkQnty
     3435         then do:
     3436            define buffer marking for ub.marking.
     3437            define variable vCodident as character no-undo.
     3438            vCodident = GetCodeIdent(idm).
     3439            find first marking where marking.mark begins vCodident no-lock no-error.
     3440            if     available marking
     3441               and marking.box-qnty ne ?
     3442            then
     3443               return marking.box-qnty.
     3444         end.
     3445         vGtin = getGtinByDm(iDM).
     3446         if ChekTypeMarkByGtin (vGtin)
     3447         then do:
     3448            vLevel = getlevelByCodId(iDM).
     3449            if     vLevel >= 1
     3450               and vLevel <= 4
     3451            then
     3452               vqnty = int(entry(vlevel,vList)).
     3453         end.
     3454         else
     3455            vqnty = getQntyCodeByGtin(vgtin).
     3456      end.
     3457      return vqnty.
     3458   end.
     3459   function getQntyUTDByDM return decimal
     3460   (iDm as char):
     3461      define variable vDM as character no-undo.
     3462      if     length (iDm) ne 25
     3463         and length (iDm) ne 29
     3464         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3465      then
     3466         vDM = substring (iDm,1,length (iDm) - 6 ).
     3467      else
     3468         vDM = substring (iDm,1,length (iDm) - 4 ).
     3469      return getQntyUTDByCodId(vDM).
     3470   end.
     3471   function getMRC4 return decimal
     3472   (iMRC as char):
     3473      define variable oMrc     as decimal no-undo init ?.
     3474      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3475      define variable vi       as integer no-undo.
     3476      define variable vfound   as integer no-undo.
     3477      define variable vposStart   as integer no-undo.
     3478      do:
     3479      OMRc = 0.
     3480      do vi = 1 to 4:
     3481         define variable vsimb as character no-undo.
     3482         vsimb = substring(iMRC,vi,1).
     3483         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3484         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3485         if vfound > 0
     3486         then
     3487            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3488         end.
     3489         OMRc = OMRc / 100.
     3490      end.
     3491      return OMRc.
     3492   end.
     3493   function getMRCByDM return decimal
     3494   (iDm as char):
     3495      define variable vMRC     as character no-undo.
     3496      define variable oMrc     as decimal no-undo init ?.
     3497      define variable Velement as character no-undo init "empty".
     3498      define variable vteg as character no-undo.
     3499      define variable vtegval as character no-undo.
     3500      if    length(idm) eq 14 + 7 + 4 + 4
     3501         or length(idm) eq 14 + 7 + 4
     3502      then do:
     3503         vMRC = substring(idm,22,4).
     3504         omrc = getMRC4(vMRC).
     3505      end.
     3506      else do:
     3507          ChekTypeMarkByDm(iDm).
     3508          block-mrc:
     3509          do while Velement ne "" and idm ne "":
     3510             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3511             if Velement begins "8005"
     3512             then do:
     3513                vMRC = substring(Velement,5,6).
     3514                leave block-mrc.
     3515             end.
     3516             else if Velement begins "(8005)"
     3517             then do:
     3518                vMRC = substring(Velement,7,6).
     3519                leave block-mrc.
     3520             end.
     3521          end.
     3522          if vMRC ne ""
     3523          then
     3524             OMRc = dec(vmrc) / 100 no-error.
     3525      end.
     3526      return OMRc.
     3527   end.
     3528   function MoveDate return Date
     3529   (idate as date,
     3530    iMonth as int64):
     3531      define variable vMonth   as int64 no-undo.
     3532      define variable vYear    as int64 no-undo.
     3533      define variable vDateNew as date  no-undo.
     3534       define variable vDay     as int64 no-undo.
     3535       vMonth = month(iDate) + iMonth.
     3536       vYear =  year(iDate).
     3537       if vMonth <= 0
     3538       then assign
     3539          vMonth = vMonth + 12
     3540           vYear  = vYear - 1
     3541       .
     3542       else if vMonth > 12
     3543       then assign
     3544          vMonth = vMonth - 12
     3545           vYear  = vYear + 1
     3546       .
     3547       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3548       do while error-status:error eq yes:
     3549          VDay = vDay + 1.
     3550          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3551       end.
     3552       if VDay > 0
     3553       then
     3554          vDateNew + 1.
     3555       return vDateNew.
     3556   end.
     3557   procedure checkEMRC:
     3558   define input  parameter iDm as character no-undo.
     3559   define output parameter vok as logical   no-undo init yes.
     3560      define variable v-value-emrc as character no-undo.
     3561      define variable v-type-emrc  as character no-undo.
     3562      define variable vDateIso     as character no-undo.
     3563      define variable vMRC         as decimal no-undo.
     3564      define variable vqnty        as decimal no-undo.
     3565      define variable vPrice       as decimal no-undo.
     3566      define variable vparent      as character no-undo.
     3567      define variable vgds-code    as integer no-undo.
     3568      define buffer code for ub.code.
     3569      vMRC = getMRCByDM(iDm).
     3570      if vMRC > 0
     3571      then do:
     3572         vgds-code = getGdsCodeByDM(iDm).
     3573         vqnty     = getQntyUTDByDM(iDm).
     3574               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3575            (
     3576             input   vgds-code
     3577            ,input   'emrc-type':U
     3578            ,output   v-value-emrc
     3579            ,output   v-type-emrc
     3580          ) no-error.
     3581          if     v-value-emrc ne ""
     3582             and v-value-emrc ne ?
     3583          then do:
     3584             vDateIso = iso-date(today).
     3585             vPrice = vMRC / vqnty.
     3586             vparent ="emc" + chr(4) + v-value-emrc.
     3587             find last code where Code.parent      eq vparent
     3588                              and Code.code        le vDateIso
     3589                              and code.status_  eq 0
     3590             no-lock no-error.
     3591             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3592             then
     3593                vOk = true .
     3594             else do:
     3595                 define variable vText      as character no-undo.
     3596                 define variable vDate      as date no-undo.
     3597                 define variable vDateLast  as character no-undo.
     3598                 define variable vDateFirst as character no-undo.
     3599                 define variable vDate3     as date no-undo.
     3600                 vdate = date(code.misc1).
     3601                 vDateLast = code.misc1.
     3602                 vDate3 = MoveDate(today, - 3 ).
     3603                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3604                                      string(vDate3  , "99/99/9999"),
     3605                                      string(vDate   , "99/99/9999")
     3606                                      ).
     3607                 vdateIso = iso-date(vdate3).
     3608                 find last code  where Code.parent      eq vparent
     3609                                   and Code.code        le vDateIso
     3610                                   and code.status_  eq 0 no-lock no-error.
     3611                 if available code
     3612                 then
     3613                    vDateIso = code.code.
     3614                 vDateFirst = vDateIso.
     3615                 vDateLast = iso-date(vdate).
     3616                 define variable vGood as logical no-undo.
     3617                 define variable vDateSale as date no-undo.
     3618                 define buffer bcode for code.
     3619                 for last code where Code.parent   eq vparent
     3620                                 and code.status_  eq 0
     3621                                 and code.code     < vDateLast
     3622                                 and code.code     >= vDateFirst
     3623                 no-lock:
     3624                    find first bcode where bCode.parent   eq vparent
     3625                                       and bcode.status_  eq 0
     3626                                       and bcode.code     > code.code no-lock no-error.
     3627                    if available bcode
     3628                    then do:
     3629                       if vPrice < dec(Code.CodeValue)
     3630                       then
     3631                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3632                                                     chr(10),
     3633                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3634                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3635                                                     ).
     3636                       else do:
     3637                          vGood = yes.
     3638                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3639                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3640                                                     chr(10),
     3641                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3642                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3643                                                     string(         vDateSale            ,"99/99/9999"),
     3644                                                     string(vDateSale - today)
     3645                                                     ).
     3646                       end.
     3647                    end.
     3648                 end.
     3649                 if vgood
     3650                 then do:
     3651                    define variable choice as integer no-undo .
     3652                    run gbl/d-askw.w (input "Уточнение"
     3653                           ,input  vText
     3654                           ,input "|"
     3655                           ,input "Принять|Вернуть"
     3656                           ,input "Принять данный товар|Вернуть товар постащику"
     3657                           ,input 1
     3658                           ,input 2
     3659                           ,output choice) no-error.
     3660                    vok = choice eq 1.
     3661                 end.
     3662                 else
     3663                    vok =false.
     3664             end.
     3665          end.
     3666      end.
     3667   end.
     3668   function addGs2Mark return character
     3669   (iMark as char):
     3670      define variable vDM   as character no-undo.
     3671      define variable vIdx  as integer   no-undo.
     3672      if index(iMark,chr(29),1) > 0
     3673      then return iMark.
     3674      if substring(iMark,26,4) = "8005" then
     3675      do:
     3676        vIdx = index(iMark,"93",26 + 4 + 5).
     3677        if vIdx > 1 then do:
     3678          vDM = substitute("&1&4&2&4&3",
     3679                           substring(iMark,1,25),
     3680                           substring(iMark,26,vIdx - 25 - 1),
     3681                           substring(iMark,vIdx),
     3682                           chr(29)) no-error.
     3683          vIdx = index(vDm,"240",vIdx + 4).
     3684          if vIdx > 0 then
     3685          do:
     3686            vDM = substitute("&1&3&2",
     3687                             substring(vDm,1,vIdx - 1),
     3688                             substring(vDm,vIdx),
     3689                             chr(29)) no-error.
     3690          end.
     3691        end.
     3692        else
     3693          vDM = substitute("&1&3&2",
     3694                           substring(iMark,1,25),
     3695                           substring(iMark,26),
     3696                           chr(29)) no-error.
     3697      end.
     3698      else if substring(iMark,32,2) = "91" then
     3699      do:
     3700        vIdx = index(iMark,"92",32).
     3701        if vIdx > 1 then
     3702          vDM = substitute("&1&4&2&4&3",
     3703                           substring(iMark,1,31),
     3704                           substring(iMark,32,vIdx - 31 - 1),
     3705                           substring(iMark,vIdx),
     3706                           chr(29)) no-error.
     3707        else
     3708          vDM = substitute("&1&3&2",
     3709                           substring(iMark,1,31),
     3710                           substring(iMark,32),
     3711                           chr(29)) no-error.
     3712      end.
     3713      else if substring(iMark,39,2) = "91" then
     3714      do:
     3715        vIdx = index(iMark,"92",38).
     3716        if vIdx > 1 then
     3717          vDM = substitute("&1&4&2&4&3",
     3718                           substring(iMark,1,38),
     3719                           substring(iMark,39,vIdx - 38 - 1),
     3720                           substring(iMark,vIdx),
     3721                           chr(29)) no-error.
     3722        else
     3723          vDM = substitute("&1&3&2",
     3724                           substring(iMark,1,38),
     3725                           substring(iMark,39),
     3726                           chr(29)) no-error.
     3727      end.
     3728      else if substring(iMark,25,2) = "93" then
     3729      do:
     3730        vIdx = index(iMark,"92",25).
     3731        if vIdx > 1 then
     3732          vDM = substitute("&1&4&2&4&3",
     3733                           substring(iMark,1,24),
     3734                           substring(iMark,25,vIdx - 24 - 1),
     3735                           substring(iMark,vIdx),
     3736                           chr(29)) no-error.
     3737        else
     3738          vIdx = index(iMark,"3103",25).
     3739          if vIdx > 0 then
     3740          vDM = substitute("&1&4&2&4&3",
     3741                           substring(iMark,1,24),
     3742                           substring(iMark,25,vIdx - 24 - 1),
     3743                           substring(iMark,vIdx),
     3744                           chr(29)) no-error.
     3745          else
     3746            vDM = substitute("&1&3&2",
     3747                             substring(iMark,1,24),
     3748                             substring(iMark,25),
     3749                             chr(29)) no-error.
     3750      end.
     3751      else if substring(iMark,32,2) = "93" then
     3752      do:
     3753        vDM = substitute("&1&3&2",
     3754              substring(iMark,1,31),
     3755              substring(iMark,32),
     3756              chr(29)) no-error.
     3757      end.
     3758      return if vDM <> "" then vDm else iMark.
     3759   end.
     3760   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3761   function getattrUtdex returns char
     3762   (idb-num   as integer,
     3763    idoc-id   as integer,
     3764    iattrcode as character,
     3765    iExValue  as character  ):
     3766      define buffer utd-attr for utd-attr.
     3767      find first utd-attr where utd-attr.db-num eq idb-num
     3768                            and utd-attr.doc-id eq idoc-id
     3769                            and utd-attr.attr-code eq iattrcode
     3770      no-lock no-error.
     3771      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     3772   end.
     3773   function getattrUtd returns char
     3774   (idb-num   as integer,
     3775    idoc-id   as integer,
     3776    iattrcode as character ):
     3777     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     3778   end.
     3779   function setattrUtd returns logical
     3780   (idb-num   as integer,
     3781    idoc-id   as integer,
     3782    iattrcode as character,
     3783    iattrval  as character ):
     3784      define buffer utd-attr for utd-attr.
     3785      find first utd-attr where utd-attr.db-num eq idb-num
     3786                            and utd-attr.doc-id eq idoc-id
     3787                            and utd-attr.attr-code eq iattrcode
     3788      no-lock no-error.
     3789      if not available utd-attr
     3790      then do:
     3791         create utd-attr.
     3792         assign
     3793            utd-attr.db-num    = idb-num
     3794            utd-attr.doc-id    = idoc-id
     3795            utd-attr.attr-code = iattrcode
     3796            utd-attr.attr-value = iattrval
     3797         .
     3798      end.
     3799      else do:
     3800         if utd-attr.attr-value ne iattrval
     3801         then do:
     3802            find current utd-attr exclusive-lock no-error.
     3803            if available utd-attr
     3804            then
     3805               utd-attr.attr-value = iattrval.
     3806         end.
     3807      end.
     3808      release utd-attr.
     3809   end.
     3810   function GetAttrUtdlinesEx returns char
     3811   (idb-num   as integer,
     3812    idoc-id   as integer,
     3813    ilinenum  as integer,
     3814    iattrcode as character,
     3815    iExValue  as character  ):
     3816      define buffer utd-lines-attr for utd-lines-attr.
     3817      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     3818                                  and utd-lines-attr.doc-id    eq idoc-id
     3819                                  and utd-lines-attr.lineNum   eq ilineNum
     3820                                  and utd-lines-attr.attr-code eq iattrcode
     3821      no-lock no-error.
     3822      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     3823   end.
     3824   function GetAttrUtdlines returns char
     3825   (idb-num   as integer,
     3826    idoc-id   as integer,
     3827    ilinenum  as integer,
     3828    iattrcode as character ):
     3829      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     3830   end.
     3831   function setattrUtdlines returns logical
     3832   (idb-num   as integer,
     3833    idoc-id   as integer,
     3834    ilinenum  as integer,
     3835    iattrcode as character,
     3836    iattrval  as character ):
     3837      define buffer utd-lines-attr for utd-lines-attr.
     3838      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     3839                                  and utd-lines-attr.doc-id    eq idoc-id
     3840                                  and utd-lines-attr.lineNum   eq ilineNum
     3841                                  and utd-lines-attr.attr-code eq iattrcode
     3842      no-lock no-error.
     3843      if not available utd-lines-attr
     3844      then do:
     3845         if iattrval ne ?
     3846            and iattrval ne ""
     3847         then do:
     3848            create utd-lines-attr.
     3849            assign
     3850               utd-lines-attr.db-num    = idb-num
     3851               utd-lines-attr.doc-id    = idoc-id
     3852               utd-lines-attr.lineNum   = ilineNum
     3853               utd-lines-attr.attr-code = iattrcode
     3854               utd-lines-attr.attr-value = iattrval
     3855            .
     3856         end.
     3857      end.
     3858      else do:
     3859         if utd-lines-attr.attr-value ne iattrval
     3860         then do:
     3861            find current utd-lines-attr exclusive-lock no-error.
     3862            if available utd-lines-attr
     3863            then do:
     3864               if    iattrval eq ?
     3865                  or iattrval eq ""
     3866               then do:
     3867                  delete utd-lines-attr.
     3868               end.
     3869               else do:
     3870                  utd-lines-attr.attr-value = iattrval.
     3871               end.
     3872            end.
     3873         end.
     3874      end.
     3875      release utd-lines-attr.
     3876   end.
