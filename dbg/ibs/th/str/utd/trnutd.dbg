       94   define output parameter p-ok-doc as integer   no-undo .
       95   define variable vss-revision    as character no-undo init "$Revision: 7162739bf0ea, 3555, rls $":U .
       96   define variable vss-author      as character no-undo init "$Author: ARostovtsev $":U .
       97   define variable vss-date        as character no-undo init "$Date: 2023/11/27 08:31:18 $":U .
       98   define variable vss-workfile    as character no-undo init "$Workfile: trnutd.p $":U .
       99   define variable vss-archive     as character no-undo init "$Archive: ibs/th/str/utd/trnutd.p $":U .
      100   define variable vss-description as character no-undo init "Импорт накладных из временной таблицы".
      101   procedure vss-get-info :
      102     define output parameter p-vss-revision    like vss-revision    no-undo .
      103     define output parameter p-vss-author      like vss-author      no-undo .
      104     define output parameter p-vss-date        like vss-date        no-undo .
      105     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      106     define output parameter p-vss-archive     like vss-archive     no-undo .
      107     define output parameter p-vss-description like vss-description no-undo .
