     5261                 new_parts.road-tax-rubl  = 0
     5262                 new_parts.transport-base = 0
     5263                 new_parts.transport-rubl = 0
     5264                 new_parts.other-base     = 0
     5265                 new_parts.other-rubl     = 0
     5266                 new_parts.purch-code     = new_trn-doc.purch-code
     5267                 new_parts.contract-code  = new_trn-doc.contract-code
     5268               .
     5269             end .
     5270           end .
     5271             run gbl/calc-trn.p ( this-procedure  , recid(new_trn-doc)) no-error .
     5272             if error-status :error then do:
     5273               v-end-message = substitute(" Ошибка пересчета &1 &2 " , error-status :get-message(1)  , return-value ) .
     5274               run pcall-log-file in p-log-handle ( input v-end-message ) .
     5275               undo, return error v-end-message.
     5276             end.
     5277           find current new_trn-doc exclusive-lock .
     5278               new_trn-doc.tot-cli =  new_trn-doc.tot-calc.
     5279         end.
     5280       end case.
     5281       if new_trn-doc.vat-type = "" or new_trn-doc.vat-type = ?
     5282       or new_trn-doc.slt-type = "" or new_trn-doc.slt-type = ?
     5283       then do:
     5284         v-end-message = substitute(" Не настроено значение тип НДС или тип НсП !!! АРМ Администратор/Глобальные параметры/ &1 &2" , error-status :get-message(1)  , return-value) .
     5285         run pcall-log-file in p-log-handle ( input v-end-message ) .
     5286         undo, return error v-end-message.
     5287       end.
     5288       if error-status:error then do :
     5289         v-end-message = substitute(" Ошибка записи атрибута документа &1 &2" , error-status :get-message(1)  , return-value) .
     5290         run pcall-log-file in p-log-handle ( input v-end-message ) .
     5291         undo, return error v-end-message.
     5292       end.
     5293       if temp_trn-doc.cargo-from <> ""
     5294       then do:
     5295         find first ub.doc-attr exclusive-lock where
     5296                  ub.doc-attr.doc-code = new_trn-doc.doc-code and
     5297                  ub.doc-attr.attr-code = 'Shipper':U no-error .
     5298         if not available ub.doc-attr then create ub.doc-attr.
     5299         assign
     5300           ub.doc-attr.doc-code = new_trn-doc.doc-code
     5301           ub.doc-attr.attr-code = 'Shipper':U
     5302           ub.doc-attr.attr-value = temp_trn-doc.cargo-from
     5303         .
     5304       end.
     5305       assign
     5306         v-end-message =  string(temp_trn-doc.obj-type) + string(temp_trn-doc.obj-code)
     5307                       + chr(9) + "Документ:" + string(new_trn-doc.doc-code) + " / " + string(temp_trn-doc.doc-code)
     5308                       + chr(9) + string( k ) + " товаров"
     5309       .
     5310       run pcall-log-file in p-log-handle (input v-end-message) .
     5311       release new_trn-doc.
     5312     end .
     5313     p-ok-doc = p-ok-doc + 1.
     5314     find first new_trn-doc where new_trn-doc.doc-code = n-d.
     5315     v-mercury-prod = false .
     5316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5317     (input  'mercuri':u
     5318     ,input  '':u
     5319     ,input  '':u
     5320     ,input  0
     5321     ,input  '':u
     5322     ,input  '':u
     5323     ,input  '':u
     5324     ,input  no
     5325     ,output v-mercury-value
     5326     ,output v-mercury-type
     5327     ) no-error .
     5328     if  not error-status :error
     5329     and lookup(v-mercury-value, 'no':u) = 0
     5330     then do:
     5331       for each new_doc-line no-lock where new_doc-line.doc-code = new_trn-doc.doc-code,
     5332       first buf_goods no-lock where buf_goods.artic = new_doc-line.artic
     5333                                 and buf_goods.prod-type = new_doc-line.prod-type
     5334                                 and buf_goods.prod-code = new_doc-line.prod-code
     5335                                 :
     5336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     5337     (input  buf_goods.gds-code
     5338     ,input  'mercur_FGIS=request':u
     5339     ,output v-mercury-prod
     5340     ) no-error .
     5341         if error-status :error then v-mercury-prod = false .
     5342         if v-mercury-prod then leave .
     5343       end .
     5344     end .
     5345     if v-mercury-prod
     5346     or v-need-corr-parts
     5347     then do :
     5348       if v-mercury-prod
     5349       and v-need-corr-parts
     5350       then do :
     5351         v-mess-in-doc = "Необходимо уточнение количества частично принятого товара в разрезе GTIN." + chr(10)
     5352                       + "Также в поставке присутствуют товары, подконтрольные ФГИС Меркурий. Для таких товаров необходимо добавить ВСД." .
     5353         v-in-doc-mode = 'ПРОСМОТР':U + '*':U + "vsd_corr-parts" .
     5354       end .
     5355       else
     5356       if v-mercury-prod
     5357       then do :
     5358         v-mess-in-doc = "В поставке присутствуют товары, подконтрольные ФГИС Меркурий. Для таких товаров необходимо добавить ВСД." .
     5359         v-in-doc-mode = 'ПРОСМОТР':U + '*':U + "vsd" .
     5360       end .
     5361       else
     5362       if v-need-corr-parts
     5363       then do :
     5364         v-mess-in-doc = "Необходимо уточнение количества частично принятого товара в разрезе GTIN." .
     5365         v-in-doc-mode = 'ПРОСМОТР':U + '*':U + "corr-parts" .
     5366       end .
     5367       v-doc-rec = recid(new_trn-doc) .
     5368       if mBatchMode
     5369       then do :
     5370         p-msg = "need-user-action" + v-mess-in-doc .
     5371         return .
     5372       end .
     5373       else do :
     5374         message v-mess-in-doc view-as alert-box .
     5375         run str/in-doc.w
     5376           ( input        parparentproc
     5377           , input-output v-doc-rec
     5378           , input        v-in-doc-mode
     5379           , input        'при':U
     5380           , input        no
     5381           , input-output varnext-prev
     5382           , input        new_trn-doc.ext-doc-type
     5383           , input        no
     5384           , input-output varline-rec
     5385           , input        br-handle
     5386           , input        bf-handle
     5387           , input        new_trn-doc.status_)
     5388         .
     5389       end .
     5390     end .
     5391     run clos-trn2 in this-procedure (new_trn-doc.doc-code) no-error .
     5392     if error-status:error
     5393       then p-msg  = "Ошибка закрытия на факт: " + replace (replace (return-value, chr(10), " "), '"', "'").
     5394       else p-msg  = "Накладная закрыта на факт.".
     5395   end.
     5396   procedure clos-trn :
     5397   do
     5398   on error undo, return error return-value
     5399   :
     5400   define input parameter p-trn-code as character no-undo .
     5401   define buffer buf_s-trn-doc for ub.trn-doc.
     5402   define variable varmode            as   character           no-undo.
     5403   define variable varstatus          like ub.trn-doc.status_  no-undo.
     5404   define variable varflag            like ub.trn-doc.flag     no-undo.
     5405   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     5406   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     5407   define variable varcheck-return as logical no-undo .
     5408   define variable varchg-inv      as logical no-undo .
     5409   assign
     5410     varmode         = '<закрытие документа>':U
     5411     varstatus       = 'запрос':U
     5412     varflag         = true
     5413     varcopystatus   = 'новый':U
     5414     varcopyflag     = false
     5415     varcheck-return = true
     5416     varchg-inv      = true
     5417     .
     5418   for each tt2-doc-line where is-tsd and doc-code = p-trn-code no-lock:
     5419     run unitqnty1 (
     5420         input tt2-doc-line.unit-cli,
     5421         input "",
     5422         input "",
     5423         input 0,
     5424         input "",
     5425         input tt2-doc-line.doc-qnty)
     5426     no-error.
     5427     if error-status:error then do:
     5428       run pcall-log-file in p-log-handle (input return-value) .
     5429       is-unit-error  = true.
     5430     end.
     5431     run unitqnty1 (
     5432         input tt2-doc-line.unit-cli,
     5433         input "",
     5434         input "",
     5435         input 0,
     5436         input "",
     5437         input tt2-doc-line.fact-qnty)
     5438     no-error.
     5439     if error-status:error then do:
     5440       run pcall-log-file in p-log-handle (input return-value) .
     5441       is-unit-error  = true.
     5442     end.
     5443   end.
     5444   if is-unit-error then do:
     5445     run pcall-log-file in p-log-handle (input "Невозможно перевести накладную в статус накл") .
     5446     return.
     5447   end.
     5448   run str/trn-graf.p
     5449     ( input  p-trn-code ,
     5450       input  v-cntxt-db-num ,
     5451       input  varmode ,
     5452       output varstatus ,
     5453       output varflag ,
     5454       output varcopystatus ,
     5455       output varcopyflag
     5456     ) no-error .
     5457   if error-status:error then do :
     5458       v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     5459       run pcall-log-file in p-log-handle ( input v-end-message ) .
     5460       undo, return error v-end-message.
     5461   end.
     5462   run str/trn-stat.p (
     5463       input  parparentproc ,
     5464       input  this-procedure ,
     5465       input  varmode,
     5466       input  p-trn-code,
     5467       input  varcheck-return,
     5468       input  v-cntxt-db-num,
     5469       input  v-cntxt-in-ov,
     5470       input  v-cntxt-rsrv-time,
     5471       input  v-cntxt-load-time,
     5472       input  v-cntxt-holidays,
     5473       input  NO,
     5474       output varchg-inv,
     5475       output table gds-list)
     5476       no-error.
     5477   if error-status:error then do :
     5478       v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     5479       run pcall-log-file in p-log-handle ( input v-end-message ) .
     5480       undo, return error v-end-message.
     5481   end.
     5482   end.
     5483   if is-tsd then do:
     5484     for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     5485       find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     5486         ub.doc-line.prod-type = buf_goods.prod-type  and
     5487         ub.doc-line.prod-code = buf_goods.prod-code
     5488         no-lock no-error .
     5489       find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     5490         ub.gds-dtl.artic = buf_goods.artic and
     5491         ub.gds-dtl.prod-type = buf_goods.prod-type  and
     5492         ub.gds-dtl.prod-code = buf_goods.prod-code.
     5493       find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     5494       ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     5495       ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     5496       ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     5497       ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     5498       ub.doc-line.cli-qnty = temp_doc-line.cli-qnty.
     5499     end.
     5500   end.
     5501   end procedure.
     5502   procedure clos-trn2 :
     5503   define input parameter p-trn-code as character no-undo .
     5504   do
     5505   on error undo, return error return-value
     5506   :
     5507     define buffer buf_s-trn-doc for ub.trn-doc.
     5508     define variable varmode            as   character           no-undo.
     5509     define variable varstatus          like ub.trn-doc.status_  no-undo.
     5510     define variable varflag            like ub.trn-doc.flag     no-undo.
     5511     define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     5512     define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     5513     define variable varcheck-return as logical no-undo .
     5514     define variable varchg-inv as logical no-undo .
     5515     if g#news
     5516     then do:
     5517   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-trn-code ,
     5518                          input 'trdcattr-is-not-close-fact-news':U ,
     5519                          input yes ) no-error .
     5520     end.
     5521     run str/trn-stat.p (
     5522         input  parparentproc ,
     5523         input  this-procedure ,
     5524         input  '<закрытие документа на факт>':U ,
     5525         input  p-trn-code,
     5526         input  false  ,
     5527         input  v-cntxt-db-num,
     5528         input  false ,
     5529         input  v-cntxt-rsrv-time,
     5530         input  v-cntxt-load-time,
     5531         input  v-cntxt-holidays,
     5532         input  false ,
     5533         output varchg-inv ,
     5534         output table gds-list)
     5535         no-error.
     5536     if error-status:error
     5537     then do:
     5538       find first ub.doc-attr where ub.doc-attr.doc-code = new_trn-doc.doc-code and ub.doc-attr.attr-code = 'trdcattr-is-not-close-fact-news':U no-error.
     5539       if available (ub.doc-attr)
     5540       then
     5541         delete ub.doc-attr.
     5542       undo, return error return-value.
     5543     end.
     5544     find first ub.doc-attr where ub.doc-attr.doc-code = new_trn-doc.doc-code and ub.doc-attr.attr-code = 'trdcattr-is-not-close-fact-news':U no-error.
     5545     if available (ub.doc-attr)
     5546     then
     5547       delete ub.doc-attr.
     5548   end.
     5549   end procedure.
     5550   procedure mainmenu_getcntxt :
