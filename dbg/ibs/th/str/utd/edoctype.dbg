        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.propmap.
        4   using ibs.th.gbl.map.mapstring.
        5   using ibs.th.gbl.TypeMap.
        6   block-level on error undo, throw.
        7   class ibs.th.str.utd.edoctype inherits TypeMap:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Типы элекронных документов" get.
       14     define public property  UTD  as class propmap no-undo get.  protected set.
       15     define public property  Introduce   as class propmap no-undo get.  protected set.
       16     define public property  Receipt  as class propmap no-undo get.  protected set.
       17     define public property  UCD  as class propmap no-undo get.  protected set.
       18     define public property  returns  as class propmap no-undo get.  protected set.
       19     define public property  AKT  as class propmap no-undo get.  protected set.
       20     define public property  EDoc         as class propmap no-undo get.  protected set.
       21     define public property  LK_RECEIPT   as class propmap no-undo get.  protected set.
       22     define public property  Mark_Collect as class propmap no-undo get.  protected set.
       23     constructor public edoctype ():
       24       super().
       25       UTD       = crProp(1, "UTD", "УПД").
       26       Introduce = crProp(2, "Introduce", "Первоначальный ввод КМ").
       27       Receipt   = crProp(3, "receipt", "Списание (выбытие из оборота)").
       28       UCD       = crProp(4, "UСD", "УКД").
       29       Returns   = crProp(5, "return", "Возврат поставщику").
       30       AKT       = crProp(6, "akt", "Акт приема").
       31       EDoc      = crProp(7, "EDoc", "еУПД").
       32       LK_RECEIPT = crProp(9, "LK_RECEIPT", "Вывод из оборота").
       33       Mark_Collect = crProp(10, "Mark_Collect", "Сбор марок").
       34     end.
       35   end class.
