        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.str.marking.handlers.*.
        4   using ibs.th.str.marking.sts.*.
        5   block-level on error undo, throw.
        6   class ibs.th.str.utd.handlers.introduce inherits objth:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Вспомгательный клас для обработки марок для ТСД" get.
       13   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable vss-include-info1 as character format "X(65)" no-undo
       15   initial "@(#)$Workfile$ $Revision$".
       16   method private void xmlchar-test (input  p-in-string          as character,
       17                                     output p-out-string-enc     as character,
       18                                     output p-out-string-dec    as character):
       19   do
       20   on error undo, return error
       21   :
       22          xmlchar-encode
       23       (
       24             input p-in-string
       25           , output p-out-string-enc
       26       ).
       27          xmlchar-decode
       28       (
       29             input p-out-string-enc
       30           , output p-out-string-dec
       31       ).
       32   end.
       33   end .
       34   method private void xmlchar-encode (input  p-in-string          as character,
       35                                     output p-out-string         as character):
       36       define variable v-position      as integer      no-undo.
       37       define variable v-current-char  as character    no-undo.
       38   do
       39   on error undo, return error
       40   :
       41       assign
       42           p-out-string = "":U
       43       .
       44       case p-in-string
       45       :
       46           when ?
       47           then do:
       48               assign
       49                   p-out-string = "?":U
       50               .
       51           end.
       52           when "?":U
       53           then do:
       54               assign
       55                   p-out-string = "&#63;":U
       56               .
       57           end.
       58           otherwise do:
       59               do v-position = 1 to length( p-in-string )
       60               :
       61                   assign
       62                       v-current-char = substring( p-in-string, v-position, 1 )
       63                   .
       64                   case v-current-char
       65                   :
       66                       when "&":U
       67                       then do:
       68                           assign
       69                               p-out-string = p-out-string + "&amp;":U
       70                           .
       71                       end.
       72                       when ">":U
       73                       then do:
       74                           assign
       75                               p-out-string = p-out-string + "&gt;":U
       76                           .
       77                       end.
       78                       when "<":U
       79                       then do:
       80                           assign
       81                               p-out-string = p-out-string + "&lt;":U
       82                           .
       83                       end.
       84                       when "'":U
       85                       then do:
       86                           assign
       87                               p-out-string = p-out-string + "&apos;":U
       88                           .
       89                       end.
       90                       when '"':U
       91                       then do:
       92                           assign
       93                               p-out-string = p-out-string + "&quot;":U
       94                           .
       95                       end.
       96                       when chr(1)
       97                       then do:
       98                           assign
       99                               p-out-string = p-out-string + "":U
      100                           .
      101                       end.
      102                       when chr(2)
      103                       then do:
      104                           assign
      105                               p-out-string = p-out-string + "":U
      106                           .
      107                       end.
      108                       when chr(3)
      109                       then do:
      110                           assign
      111                               p-out-string = p-out-string + "":U
      112                           .
      113                       end.
      114                       when chr(4)
      115                       then do:
      116                           assign
      117                               p-out-string = p-out-string + "":U
      118                           .
      119                       end.
      120                       when chr(5)
      121                       then do:
      122                           assign
      123                               p-out-string = p-out-string + "":U
      124                           .
      125                       end.
      126                       when chr(6)
      127                       then do:
      128                           assign
      129                               p-out-string = p-out-string + "":U
      130                           .
      131                       end.
      132                       when chr(7)
      133                       then do:
      134                           assign
      135                               p-out-string = p-out-string + "":U
      136                           .
      137                       end.
      138                       when chr(8)
      139                       then do:
      140                           assign
      141                               p-out-string = p-out-string + "":U
      142                           .
      143                       end.
      144                       when chr(9)
      145                       then do:
      146                           assign
      147                               p-out-string = p-out-string + "":U
      148                           .
      149                       end.
      150                       when chr(29)
      151                       then do:
      152                           assign
      153                               p-out-string = p-out-string + "":U
      154                           .
      155                       end.
      156                       when chr(10)
      157                       then do:
      158                           assign
      159                               p-out-string = p-out-string + "&#10;":U
      160                           .
      161                       end.
      162                       when chr(13)
      163                       then do:
      164                           assign
      165                               p-out-string = p-out-string + "&#13;":U
      166                           .
      167                       end.
      168                       otherwise do:
      169                           assign
      170                               p-out-string = p-out-string + v-current-char
      171                           .
      172                       end.
      173                   end case.
      174               end.
      175           end.
      176       end case.
      177   end.
      178   end .
      179   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      180   define variable p-out-string as character no-undo.
      181       define variable v-position      as integer      no-undo.
      182       define variable v-current-char  as character    no-undo.
      183   do
      184   on error undo, return error
      185   :
      186       assign
      187           p-out-string = "":U
      188       .
      189       case p-in-string
      190       :
      191           when ?
      192           then do:
      193               assign
      194                   p-out-string = "?":U
      195               .
      196           end.
      197           otherwise do:
      198               do v-position = 1 to length( p-in-string )
      199               :
      200                   assign
      201                       v-current-char = substring( p-in-string, v-position, 1 )
      202                   .
      203                   case v-current-char
      204                   :
      205                       when chr(1)
      206                       then do:
      207                           assign
      208                               p-out-string = p-out-string + " ":U
      209                           .
      210                       end.
      211                       when chr(2)
      212                       then do:
      213                           assign
      214                               p-out-string = p-out-string + " ":U
      215                           .
      216                       end.
      217                       when chr(3)
      218                       then do:
      219                           assign
      220                               p-out-string = p-out-string + " ":U
      221                           .
      222                       end.
      223                       when chr(4)
      224                       then do:
      225                           assign
      226                               p-out-string = p-out-string + " ":U
      227                           .
      228                       end.
      229                       when chr(5)
      230                       then do:
      231                           assign
      232                               p-out-string = p-out-string + " ":U
      233                           .
      234                       end.
      235                       when chr(6)
      236                       then do:
      237                           assign
      238                               p-out-string = p-out-string + " ":U
      239                           .
      240                       end.
      241                       when chr(7)
      242                       then do:
      243                           assign
      244                               p-out-string = p-out-string + " ":U
      245                           .
      246                       end.
      247                       when chr(8)
      248                       then do:
      249                           assign
      250                               p-out-string = p-out-string + " ":U
      251                           .
      252                       end.
      253                       when chr(9)
      254                       then do:
      255                           assign
      256                               p-out-string = p-out-string + " ":U
      257                           .
      258                       end.
      259                       when chr(29)
      260                       then do:
      261                           assign
      262                               p-out-string = p-out-string + " ":U
      263                           .
      264                       end.
      265                       when chr(10)
      266                       then do:
      267                           assign
      268                               p-out-string = p-out-string + " ":U
      269                           .
      270                       end.
      271                       when chr(13)
      272                       then do:
      273                           assign
      274                               p-out-string = p-out-string + " ":U
      275                           .
      276                       end.
      277                       otherwise do:
      278                           assign
      279                               p-out-string = p-out-string + v-current-char
      280                           .
      281                       end.
      282                   end case.
      283               end.
      284           end.
      285       end case.
      286   end.
      287   return p-out-string.
      288   end .
      289   method private void xmlchar-decode (input  p-in-string          as character,
      290                                     output p-out-string         as character):
      291       define variable v-position      as integer      no-undo.
      292       define variable v-last-position as integer      no-undo.
      293       define variable v-temp-integer  as integer      no-undo.
      294       define variable v-current-char  as character    no-undo.
      295       define variable v-next-char     as character    no-undo.
      296       define variable v-success       as logical      no-undo.
      297   do
      298   on error undo, return error
      299   :
      300       assign
      301           p-out-string = "":U
      302           v-position   = 0
      303       .
      304       replace-cycle:
      305       do while yes
      306       on error undo, return error
      307       :
      308           assign
      309               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      310           .
      311           if v-last-position <= v-position
      312           then do:
      313               if v-position = 0
      314               then do:
      315                   assign
      316                       p-out-string = p-in-string
      317                   .
      318               end.
      319               else do:
      320                   assign
      321                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      322                   .
      323               end.
      324               leave replace-cycle.
      325           end.
      326           else do:
      327               assign
      328                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      329                   v-position      = v-last-position
      330                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      331               .
      332               if v-current-char = "#":U
      333               then do:
      334                   assign
      335                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      336                   .
      337                   if v-last-position > 0
      338                   then do:
      339                       xmlchar-read-integer
      340                        (
      341                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      342                           , output v-temp-integer
      343                           , output v-success
      344                       ).
      345                       if v-success = yes
      346                       and v-temp-integer >= 1
      347                       and v-temp-integer <= 255
      348                       then do:
      349                           assign
      350                               p-out-string = p-out-string + chr( v-temp-integer )
      351                               v-position   = v-last-position + 1
      352                           .
      353                       end.
      354                       else do:
      355                           assign
      356                               p-out-string = p-out-string + "&":U
      357                               v-position   = v-position   + 1
      358                           .
      359                       end.
      360                   end.
      361                   else do:
      362                       assign
      363                           p-out-string = p-out-string + "&":U
      364                           v-position   = v-position   + 1
      365                       .
      366                   end.
      367               end.
      368               else do:
      369                   case substring( p-in-string, v-position + 1, 3 )
      370                   :
      371                       when "lt;":U
      372                       then do:
      373                           assign
      374                               p-out-string = p-out-string + "<":U
      375                               v-position   = v-position   + 3
      376                           .
      377                       end.
      378                       when "gt;":U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + ">":U
      382                               v-position   = v-position   + 3
      383                           .
      384                       end.
      385                       otherwise do:
      386                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      387                           then do:
      388                               assign
      389                                   p-out-string = p-out-string + "&":U
      390                                   v-position   = v-position   + 4
      391                               .
      392                           end.
      393                           else do:
      394                               case substring( p-in-string, v-position + 1, 5 )
      395                               :
      396                                   when "quot;":U
      397                                   then do:
      398                                       assign
      399                                           p-out-string = p-out-string + '"':U
      400                                           v-position   = v-position   + 5
      401                                       .
      402                                   end.
      403                                   when "apos;":U
      404                                   then do:
      405                                       assign
      406                                           p-out-string = p-out-string + "'":U
      407                                           v-position   = v-position   + 5
      408                                       .
      409                                   end.
      410                                   otherwise do:
      411                                       assign
      412                                           p-out-string = p-out-string + "&":U
      413                                       .
      414                                   end.
      415                               end case.
      416                           end.
      417                       end.
      418                   end case.
      419               end.
      420           end.
      421       end.
      422   end.
      423   end .
      424   method private void xmlchar-read-integer (input  p-input-string       as character,
      425                                             output p-output-integer     as integer,
      426                                             output p-success            as logical):
      427   do
      428   on error undo, return error
      429   :
      430       assign
      431           p-output-integer = integer( p-input-string )
      432       no-error.
      433       if error-status :error
      434       then do:
      435           assign
      436               p-success           = no
      437               p-output-integer    = 0
      438           .
      439       end.
      440       else do:
      441           assign
      442               p-success           = yes
      443           .
      444       end.
      445   end.
      446   end.
      447   method private void getAttrLib ():
      448      define variable g#attr-lib  as handle no-undo .
      449      run gbl/getgattrlib.p (output g#attr-lib).
      450   end.
      451   define variable mMRCCode  as logical    no-undo.
      452   define variable mTypeMark as character  no-undo.
      453   method private logical IS-NeedMark
      454   ( input ib-code as integer  ,
      455     input ib-str as character ):
      456      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      457      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      458                                    and buf_prod-bc-attr.b-str  eq ib-str
      459                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      460        no-lock no-error.
      461      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      462   end.
      463   method private character repTegforDm
      464   (iDM as char ):
      465       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      466       define variable vteg as character no-undo.
      467       define variable oDM as character no-undo.
      468       define variable vi as integer no-undo.
      469       oDM = iDm.
      470       do vi = 1 to num-entries(vTeglist):
      471          vTeg = entry(vi,vTeglist).
      472          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      473       end.
      474       return oDM.
      475   end.
      476   method private character repSpecSimbforDm
      477   (iDM as char ):
      478       define variable oDM as character no-undo.
      479       xmlchar-decode(iDM, output oDM).
      480     return repTegforDm (oDM).
      481   end.
      482   method private logical CheckGtin
      483   (iGtin as char):
      484      define variable bar_code as character no-undo.
      485      define variable vGtin as logical no-undo init "yes".
      486      if length(iGtin) eq 14
      487      then do:
      488         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      489         run str/chk-sum.p
      490          (input-output bar_code ) no-error .
      491         if iGtin ne  bar_code
      492         then
      493            vGtin = no.
      494      end.
      495      else
      496         vGtin = no.
      497      return vgtin.
      498   end.
      499   method private character repSpecSimbforXlm
      500   (iDM as char ):
      501       iDM = replace(iDM,chr(29),"").
      502       return iDM.
      503   end.
      504   method private character getGtinByDM
      505   (IDM as char):
      506      define variable VTXT as char no-undo.
      507      define variable vGtin as char no-undo.
      508      vTXt = IdM.
      509      vGtin = IDM.
      510      if    length(vtxt) > 14
      511      then do:
      512         if   vtxt begins "(01)"
      513                or vtxt begins "(02)"
      514         then
      515            vGtin = substring(vtxt,5,14).
      516         else if   (vtxt begins "01"
      517                or vtxt begins "02" )
      518                and (   (    substring(iDm,17,2) eq "21"
      519                         and length(vtxt) >= 21)
      520                     or substring(iDm,17,2) eq "37"
      521                     or substring(iDm,17,4) eq "(37)" )
      522         then do:
      523            vGtin = substring(vtxt,3,14).
      524            if not checkGtin(vGtin)
      525            then
      526               vGtin = substring(vtxt,1,14).
      527         end.
      528         else if     length(vtxt) eq 14 + 7 + 4 + 4
      529             or length(vtxt) eq 14 + 7 + 4
      530             or length(vtxt) eq 14 + 7
      531         then
      532            vGtin = substring(vtxt,1,14).
      533      end.
      534      if not checkGtin(vGtin)
      535      then
      536         vGtin = "".
      537      return vgtin.
      538   end.
      539   method private integer getGdsCodeByGtin
      540   (iGtin as char):
      541      define buffer prod-bc  for ub.prod-bc.
      542      define buffer bar-code for ub.bar-code.
      543      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      544      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      545      return if avail bar-code then bar-code.gds-code else ?.
      546   end.
      547   method private decimal getQntyCodeByGtin
      548   (iGtin as char):
      549      define buffer prod-bc  for ub.prod-bc.
      550      define buffer bar-code for ub.bar-code.
      551      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      552      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      553      return if avail bar-code then bar-code.cli-base-rate else ?.
      554   end.
      555   method private integer getGdsCodeByDM
      556   (iDm as char):
      557      define variable vGtin as char no-undo.
      558      define buffer prod-bc for ub.prod-bc.
      559      vGtin  = getGtinByDM (IDM ).
      560      return getGdsCodeByGtin (vGtin).
      561   end.
      562   method private logical ChekTypeMarkByGds
      563   (iGds-code as integer ):
      564      define buffer goods-attr for ub.goods-attr.
      565      find first goods-attr where goods-attr.gds-code   = iGds-code
      566                              and goods-attr.attr-code  = 'mark-type':U
      567      no-lock no-error.
      568      if available goods-attr
      569      then do:
      570         mTypeMark = goods-attr.attr-value.
      571         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      572           .
      573      end.
      574      else
      575         return no.
      576   end.
      577   method private logical ChekTypeMarkByDm
      578   (iDM as char ):
      579      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      580   end.
      581   method private logical ChekTypeMarkByGtin
      582   (iGtin as char ):
      583      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      584   end.
      585   method private character  GetNextElement
      586     (input iAllTeg        as logical
      587     ,output oteg          as character
      588     ,output otegval       as character
      589     ,input-output pstr    as character
      590      ):
      591        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      592        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      593        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      594        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      595        define variable vTeg as character no-undo.
      596        define variable vLength as integer no-undo.
      597        define variable vi as integer no-undo.
      598        define variable vj as integer no-undo.
      599        define buffer code for ub.code.
      600        find first code where Code.parent eq "MarkType"
      601                          and Code.CodeValue   eq mTypeMark
      602                          no-lock no-error.
      603        if     available code
      604           and Code.misc1 ne ""
      605           and Code.misc1 ne ?
      606        then do:
      607           integer (Code.misc1) no-error.
      608           if not error-status:error
      609           then
      610             entry (4,vlistleng) = Code.misc1.
      611        end.
      612        if iAllTeg
      613        then
      614           assign
      615              vlistElem     = vlistElem    + vlistElemDop
      616              vlistleng     = vlistleng    + vlistlengDop
      617           .
      618        else if mMRCCode
      619        then
      620           assign
      621              vlistElem     = vlistElem    + ",(8005),8005"
      622              vlistleng     = vlistleng    + ",000006,0006"
      623           .
      624       block-elem:
      625       do vi = 1 to num-entries(vlistElem):
      626          vTeg = entry(vi,vlistElem).
      627          if pstr begins vTeg
      628          then do:
      629             if    vTeg eq "21"
      630             then
      631                vLength = index(pstr,chr(29)) - 2 no-error.
      632             if vLength  <= 0
      633             then
      634                vLength = int(entry(vi,vlistleng)).
      635             otegval = substring (pstr,length(vteg) + 1, vLength).
      636             oteg = replace(replace(vteg,")",""),"(","").
      637             vTeg = vteg + otegval.
      638             otegval = replace(otegval,chr(29),"").
      639             oteg = replace(replace(oteg,")",""),"(","").
      640             pstr = substring (pstr,length(vTeg)+ 1).
      641             vTeg = replace(vTeg,chr(29),"").
      642             leave block-elem.
      643          end.
      644          else
      645             vTeg = "".
      646       end.
      647       return vteg.
      648   end.
      649   method private character  GetCodeIdent
      650   (iDm as char):
      651      define variable Velement   as character no-undo init "first".
      652      define variable oCodeIdent as character no-undo.
      653      define variable vteg as character no-undo.
      654      define variable vtegval as character no-undo.
      655      define variable vGtin as character no-undo.
      656      define buffer marking for ub.marking.
      657      for first marking no-lock where
      658                marking.mark eq iDm
      659            and marking.unit-ext = "LEVEL2"
      660      :
      661        return iDm.
      662      end.
      663      vGtin  = getGtinByDM (iDm ).
      664      ChekTypeMarkByDm(idm).
      665      if iDm begins 'tech_':U
      666      then
      667         oCodeIdent = iDm.
      668      else if length(iDm) < 21
      669      then do:
      670         find first marking where marking.mark eq idm
      671         no-lock no-error.
      672         oCodeIdent = if available marking then marking.mark else  ?.
      673      end.
      674      else if     length(iDm) eq 29
      675         and not iDm begins "01"
      676         and not iDm begins "02"
      677      then
      678         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      679      else  if     length(iDm) >= 24
      680               and (  iDm begins "01"
      681                   or iDm begins "02")
      682               and  substring(iDm,17,2) ne "21"
      683      then do:
      684         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      685                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      686         then
      687            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      688         else
      689            oCodeIdent = iDM.
      690      end.
      691      else  if     (   length(iDm) eq 25
      692                    or length(iDm) eq 21)
      693               and (not iDm begins "01"
      694               and  not iDm begins "02")
      695      then
      696         oCodeIdent = substring(iDm,1,21).
      697      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      698      then
      699         oCodeIdent = substring(iDm,1,21).
      700      else do while Velement ne "" and idm ne "":
      701         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      702         oCodeIdent = oCodeIdent + Velement.
      703      end.
      704      return oCodeIdent.
      705   end.
      706   method private character  GetTegCod
      707   (icodeIdent as char, iTeg as char):
      708      define variable Velement   as character no-undo init "first".
      709      define variable oTeg as character no-undo init ?.
      710      define variable vteg as character no-undo.
      711      define variable vtegval as character no-undo.
      712      if     ((length(icodeIdent) eq 21
      713         and not icodeIdent begins "01"
      714         and not icodeIdent begins "02")
      715         or
      716             ( length(icodeIdent) eq 25
      717               and not icodeIdent begins "01"
      718               and not icodeIdent begins "02"))
      719      then do:
      720         if iTeg eq "01" or iTeg eq "02"
      721         then
      722            oTeg = substring(icodeIdent,1,21).
      723         else  if  iTeg eq "21"
      724         then
      725            oTeg = substring(icodeIdent,15,7).
      726      end.
      727      else do:
      728         ChekTypeMarkByDm(icodeIdent).
      729         block-teg:
      730            do while Velement ne "" and icodeIdent ne "":
      731            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      732            if    Velement begins iTeg
      733               or Velement begins "(" + iTeg + ")"
      734            then do:
      735               oTeg = vtegval.
      736               leave block-teg.
      737            end.
      738         end.
      739      end.
      740      return oTeg.
      741   end.
      742   method private logical isOAD
      743   (icodeIdent as character):
      744      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      745   end.
      746   method private logical isMark
      747   (icodeIdent as character):
      748      define buffer buf_marking for ub.marking.
      749      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      750             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      751   end.
      752   method private character  addBracketForCode
      753   (icodeIdent as char):
      754      define variable Velement   as character no-undo init "first".
      755      define variable oTeg as character no-undo.
      756      define variable vteg as character no-undo.
      757      define variable vtegval as character no-undo.
      758      define buffer marking for ub.marking.
      759      find first marking no-lock where
      760                 marking.mark begins icodeIdent no-error.
      761      if    not ChekTypeMarkByDm(icodeIdent)
      762         or length(icodeIdent) le 24
      763         or (avail marking and marking.unit-ext = "LEVEL2")
      764      then
      765         oTeg = icodeIdent.
      766      else do:
      767         if (  icodeIdent begins "01"
      768            or icodeIdent begins "02"
      769            ) and CheckGtin(substring (icodeIdent,3,14))
      770            and substring (icodeIdent,17,2) eq "21"
      771         then do:
      772            mMRCCode = yes.
      773            ChekTypeMarkByDm(icodeIdent).
      774            block-teg:
      775            do while Velement ne "" and icodeIdent ne "":
      776               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      777               if vteg ne ""
      778               then
      779                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      780            end.
      781            mMRCCode = no.
      782         end.
      783         else do:
      784            oTeg = icodeIdent.
      785         end.
      786      end.
      787      return oTeg.
      788   end.
      789   method private integer getlevelByCodId
      790   (iCode as char):
      791      define variable vLength as int no-undo.
      792      define variable vLevel  as int no-undo.
      793      if not ChekTypeMarkByDM (icode) then return ?.
      794      vLength = length(iCode).
      795      if    vLength eq 18
      796         or vLength eq 20
      797      then
      798         Vlevel = 4.
      799      else if vLength eq 21
      800      then
      801         Vlevel = 1.
      802      else if vLength eq 25
      803      then do:
      804         if  iCode begins "01"
      805         then
      806            Vlevel = 3.
      807         else
      808            Vlevel = 1.
      809      end.
      810      else if     vLength >= 26
      811              and vLength <= 46
      812      then do:
      813         if    substring(iCode,17,2) eq "11"
      814            or substring(iCode,17,2) eq "13"
      815            or (    substring(iCode,17,2) eq "21"
      816                and vLength >= 33
      817                and substring(iCode,26,4) ne "8005")
      818         then
      819            Vlevel = 4.
      820         else if    vLength eq 31
      821                 or vLength eq 38
      822                 or vLength eq 39
      823                 or vLength eq 45
      824         then
      825            Vlevel = 1.
      826         else if    vLength eq 35
      827                 or vLength eq 43
      828         then
      829            Vlevel = 3.
      830         else
      831            Vlevel = ?.
      832      end.
      833      else
      834         Vlevel = ?.
      835      return Vlevel.
      836   end.
      837   method private character  getLevelMotpBycodid
      838   (iDm as char):
      839      define variable vLevel as integer no-undo.
      840      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      841      vLevel = getlevelByCodId(iDm).
      842      if    vLevel eq ?
      843         or vLevel < 1
      844         or vLevel > 6
      845      then
      846         return ?.
      847      else
      848         return entry(vlevel,vList).
      849   end.
      850   method private character    getLevelUTDByLevelMotp
      851   (iUnit as char):
      852      define variable vLevel as integer no-undo.
      853      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      854      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      855      vLevel = lookup(iUnit,vListMOTP).
      856      if    vLevel eq ?
      857         or vLevel < 1
      858         or vLevel > 4
      859      then
      860         return ?.
      861      else
      862         return entry(vlevel,vListutd).
      863   end.
      864   method private character  getLevelMotpByDM
      865   (iDm as char):
      866      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      867   end.
      868   method private character  getLevelUTDByCodId
      869   (iDm as char):
      870      define variable vLevel as integer no-undo.
      871      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      872      vLevel = getlevelByCodId(iDm).
      873      if    vLevel eq ?
      874         or vLevel < 1
      875         or vLevel > 4
      876      then
      877         return ?.
      878      else
      879         return entry(vlevel,vList).
      880   end.
      881   method private character  getLevelUTDByDM
      882   (iDm as char):
      883      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      884   end.
      885   define variable mNotMarkQnty as logical no-undo.
      886   method private decimal getQntyUTDByCodId
      887   (iDM as char):
      888      define variable vLevel as integer no-undo.
      889      define variable vList as character no-undo init "1,5,10,500".
      890      define variable vGtin as character no-undo.
      891      define variable vqnty as decimal no-undo init ?.
      892      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      893      if vqnty eq ?
      894      then do:
      895         if not mNotMarkQnty
      896         then do:
      897            define buffer marking for ub.marking.
      898            define variable vCodident as character no-undo.
      899            vCodident = GetCodeIdent(idm).
      900            find first marking where marking.mark begins vCodident no-lock no-error.
      901            if     available marking
      902               and marking.box-qnty ne ?
      903            then
      904               return marking.box-qnty.
      905         end.
      906         vGtin = getGtinByDm(iDM).
      907         if ChekTypeMarkByGtin (vGtin)
      908         then do:
      909            vLevel = getlevelByCodId(iDM).
      910            if     vLevel >= 1
      911               and vLevel <= 4
      912            then
      913               vqnty = int(entry(vlevel,vList)).
      914         end.
      915         else
      916            vqnty = getQntyCodeByGtin(vgtin).
      917      end.
      918      return vqnty.
      919   end.
      920   method private decimal getQntyUTDByDM
      921   (iDm as char):
      922      define variable vDM as character no-undo.
      923      if     length (iDm) ne 25
      924         and length (iDm) ne 29
      925         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      926      then
      927         vDM = substring (iDm,1,length (iDm) - 6 ).
      928      else
      929         vDM = substring (iDm,1,length (iDm) - 4 ).
      930      return getQntyUTDByCodId(vDM).
      931   end.
      932   method private decimal    getMRC4
      933   (iMRC as char):
      934      define variable oMrc     as decimal no-undo init ?.
      935      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      936      define variable vi       as integer no-undo.
      937      define variable vfound   as integer no-undo.
      938      define variable vposStart   as integer no-undo.
      939      do:
      940      OMRc = 0.
      941      do vi = 1 to 4:
      942         define variable vsimb as character no-undo.
      943         vsimb = substring(iMRC,vi,1).
      944         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      945         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      946         if vfound > 0
      947         then
      948            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      949         end.
      950         OMRc = OMRc / 100.
      951      end.
      952      return OMRc.
      953   end.
      954   method private decimal    getMRCByDM
      955   (iDm as char):
      956      define variable vMRC     as character no-undo.
      957      define variable oMrc     as decimal no-undo init ?.
      958      define variable Velement as character no-undo init "empty".
      959      define variable vteg as character no-undo.
      960      define variable vtegval as character no-undo.
      961      if    length(idm) eq 14 + 7 + 4 + 4
      962         or length(idm) eq 14 + 7 + 4
      963      then do:
      964         vMRC = substring(idm,22,4).
      965         omrc = getMRC4(vMRC).
      966      end.
      967      else do:
      968          ChekTypeMarkByDm(iDm).
      969          block-mrc:
      970          do while Velement ne "" and idm ne "":
      971             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      972             if Velement begins "8005"
      973             then do:
      974                vMRC = substring(Velement,5,6).
      975                leave block-mrc.
      976             end.
      977             else if Velement begins "(8005)"
      978             then do:
      979                vMRC = substring(Velement,7,6).
      980                leave block-mrc.
      981             end.
      982          end.
      983          if vMRC ne ""
      984          then
      985             OMRc = dec(vmrc) / 100 no-error.
      986      end.
      987      return OMRc.
      988   end.
      989   method private date    MoveDate
      990   (idate as date,
      991    iMonth as int64):
      992      define variable vMonth   as int64 no-undo.
      993      define variable vYear    as int64 no-undo.
      994      define variable vDateNew as date  no-undo.
      995       define variable vDay     as int64 no-undo.
      996       vMonth = month(iDate) + iMonth.
      997       vYear =  year(iDate).
      998       if vMonth <= 0
      999       then assign
     1000          vMonth = vMonth + 12
     1001           vYear  = vYear - 1
     1002       .
     1003       else if vMonth > 12
     1004       then assign
     1005          vMonth = vMonth - 12
     1006           vYear  = vYear + 1
     1007       .
     1008       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1009       do while error-status:error eq yes:
     1010          VDay = vDay + 1.
     1011          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1012       end.
     1013       if VDay > 0
     1014       then
     1015          vDateNew + 1.
     1016       return vDateNew.
     1017   end.
     1018   method private logical    checkEMRC
     1019   (input  iDm as char,
     1020    output vOk as logical):
     1021      define variable v-value-emrc as character no-undo.
     1022      define variable v-type-emrc  as character no-undo.
     1023      define variable vDateIso     as character no-undo.
     1024      define variable vMRC         as decimal no-undo.
     1025      define variable vqnty        as decimal no-undo.
     1026      define variable vPrice       as decimal no-undo.
     1027      define variable vparent      as character no-undo.
     1028      define variable vgds-code    as integer no-undo.
     1029      define buffer code for ub.code.
     1030      vMRC = getMRCByDM(iDm).
     1031      if vMRC > 0
     1032      then do:
     1033         vgds-code = getGdsCodeByDM(iDm).
     1034         vqnty     = getQntyUTDByDM(iDm).
     1035               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1036            (
     1037             input   vgds-code
     1038            ,input   'emrc-type':U
     1039            ,output   v-value-emrc
     1040            ,output   v-type-emrc
     1041          ) no-error.
     1042          if     v-value-emrc ne ""
     1043             and v-value-emrc ne ?
     1044          then do:
     1045             vDateIso = iso-date(today).
     1046             vPrice = vMRC / vqnty.
     1047             vparent ="emc" + chr(4) + v-value-emrc.
     1048             find last code where Code.parent      eq vparent
     1049                              and Code.code        le vDateIso
     1050                              and code.status_  eq 0
     1051             no-lock no-error.
     1052             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1053             then
     1054                vOk = true .
     1055             else do:
     1056                 define variable vText      as character no-undo.
     1057                 define variable vDate      as date no-undo.
     1058                 define variable vDateLast  as character no-undo.
     1059                 define variable vDateFirst as character no-undo.
     1060                 define variable vDate3     as date no-undo.
     1061                 vdate = date(code.misc1).
     1062                 vDateLast = code.misc1.
     1063                 vDate3 = MoveDate(today, - 3 ).
     1064                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1065                                      string(vDate3  , "99/99/9999"),
     1066                                      string(vDate   , "99/99/9999")
     1067                                      ).
     1068                 vdateIso = iso-date(vdate3).
     1069                 find last code  where Code.parent      eq vparent
     1070                                   and Code.code        le vDateIso
     1071                                   and code.status_  eq 0 no-lock no-error.
     1072                 if available code
     1073                 then
     1074                    vDateIso = code.code.
     1075                 vDateFirst = vDateIso.
     1076                 vDateLast = iso-date(vdate).
     1077                 define variable vGood as logical no-undo.
     1078                 define variable vDateSale as date no-undo.
     1079                 define buffer bcode for code.
     1080                 for last code where Code.parent   eq vparent
     1081                                 and code.status_  eq 0
     1082                                 and code.code     < vDateLast
     1083                                 and code.code     >= vDateFirst
     1084                 no-lock:
     1085                    find first bcode where bCode.parent   eq vparent
     1086                                       and bcode.status_  eq 0
     1087                                       and bcode.code     > code.code no-lock no-error.
     1088                    if available bcode
     1089                    then do:
     1090                       if vPrice < dec(Code.CodeValue)
     1091                       then
     1092                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1093                                                     chr(10),
     1094                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1095                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1096                                                     ).
     1097                       else do:
     1098                          vGood = yes.
     1099                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1100                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1101                                                     chr(10),
     1102                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1103                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1104                                                     string(         vDateSale            ,"99/99/9999"),
     1105                                                     string(vDateSale - today)
     1106                                                     ).
     1107                       end.
     1108                    end.
     1109                 end.
     1110                 if vgood
     1111                 then do:
     1112                    define variable choice as integer no-undo .
     1113                    run gbl/d-askw.w (input "Уточнение"
     1114                           ,input  vText
     1115                           ,input "|"
     1116                           ,input "Принять|Вернуть"
     1117                           ,input "Принять данный товар|Вернуть товар постащику"
     1118                           ,input 1
     1119                           ,input 2
     1120                           ,output choice) no-error.
     1121                    vok = choice eq 1.
     1122                 end.
     1123                 else
     1124                    vok =false.
     1125             end.
     1126          end.
     1127      end.
     1128   end.
     1129   method private character addGs2Mark
     1130   (iMark as char):
     1131      define variable vDM   as character no-undo.
     1132      define variable vIdx  as integer   no-undo.
     1133      if index(iMark,chr(29),1) > 0
     1134      then return iMark.
     1135      if substring(iMark,26,4) = "8005" then
     1136      do:
     1137        vIdx = index(iMark,"93",26 + 4 + 5).
     1138        if vIdx > 1 then do:
     1139          vDM = substitute("&1&4&2&4&3",
     1140                           substring(iMark,1,25),
     1141                           substring(iMark,26,vIdx - 25 - 1),
     1142                           substring(iMark,vIdx),
     1143                           chr(29)) no-error.
     1144          vIdx = index(vDm,"240",vIdx + 4).
     1145          if vIdx > 0 then
     1146          do:
     1147            vDM = substitute("&1&3&2",
     1148                             substring(vDm,1,vIdx - 1),
     1149                             substring(vDm,vIdx),
     1150                             chr(29)) no-error.
     1151          end.
     1152        end.
     1153        else
     1154          vDM = substitute("&1&3&2",
     1155                           substring(iMark,1,25),
     1156                           substring(iMark,26),
     1157                           chr(29)) no-error.
     1158      end.
     1159      else if substring(iMark,32,2) = "91" then
     1160      do:
     1161        vIdx = index(iMark,"92",32).
     1162        if vIdx > 1 then
     1163          vDM = substitute("&1&4&2&4&3",
     1164                           substring(iMark,1,31),
     1165                           substring(iMark,32,vIdx - 31 - 1),
     1166                           substring(iMark,vIdx),
     1167                           chr(29)) no-error.
     1168        else
     1169          vDM = substitute("&1&3&2",
     1170                           substring(iMark,1,31),
     1171                           substring(iMark,32),
     1172                           chr(29)) no-error.
     1173      end.
     1174      else if substring(iMark,39,2) = "91" then
     1175      do:
     1176        vIdx = index(iMark,"92",38).
     1177        if vIdx > 1 then
     1178          vDM = substitute("&1&4&2&4&3",
     1179                           substring(iMark,1,38),
     1180                           substring(iMark,39,vIdx - 38 - 1),
     1181                           substring(iMark,vIdx),
     1182                           chr(29)) no-error.
     1183        else
     1184          vDM = substitute("&1&3&2",
     1185                           substring(iMark,1,38),
     1186                           substring(iMark,39),
     1187                           chr(29)) no-error.
     1188      end.
     1189      else if substring(iMark,25,2) = "93" then
     1190      do:
     1191        vIdx = index(iMark,"92",25).
     1192        if vIdx > 1 then
     1193          vDM = substitute("&1&4&2&4&3",
     1194                           substring(iMark,1,24),
     1195                           substring(iMark,25,vIdx - 24 - 1),
     1196                           substring(iMark,vIdx),
     1197                           chr(29)) no-error.
     1198        else
     1199          vIdx = index(iMark,"3103",25).
     1200          if vIdx > 0 then
     1201          vDM = substitute("&1&4&2&4&3",
     1202                           substring(iMark,1,24),
     1203                           substring(iMark,25,vIdx - 24 - 1),
     1204                           substring(iMark,vIdx),
     1205                           chr(29)) no-error.
     1206          else
     1207            vDM = substitute("&1&3&2",
     1208                             substring(iMark,1,24),
     1209                             substring(iMark,25),
     1210                             chr(29)) no-error.
     1211      end.
     1212      else if substring(iMark,32,2) = "93" then
     1213      do:
     1214        vDM = substitute("&1&3&2",
     1215              substring(iMark,1,31),
     1216              substring(iMark,32),
     1217              chr(29)) no-error.
     1218      end.
     1219      return if vDM <> "" then vDm else iMark.
     1220   end.
     1221     method public character CheckMarkUTD(mark as char, doc-id as integer, db-num as integer):
     1222       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1223       define buffer bf_utd-marking-lines  for ub.utd-marking-lines .
     1224       define variable v-error as character no-undo .
     1225       define variable Tree    as class     tree no-undo .
     1226       define variable ungroup as logical   no-undo .
     1227       Tree = ObjSrv:Lib:MarkingTree .
     1228       find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark begins mark and buf_utd-marking-lines.db-num = db-num
     1229         and buf_utd-marking-lines.doc-id = doc-id no-error .
     1230       if available (buf_utd-marking-lines) then
     1231       do:
     1232         if buf_utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB then
     1233         do:
     1234           v-error = "            Марка уже проверена, просканируйте следующий" .
     1235           return v-error .
     1236         end.
     1237         else
     1238         do:
     1239           if buf_utd-marking-lines.doc-level > 1 then
     1240           do:
     1241             if tree:LevelUpUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     1242             do:
     1243               message "Разгруппировать упаковки?"
     1244                 view-as alert-box question buttons yes-no update ungroup.
     1245               if ungroup then
     1246               do:
     1247                 if tree:UnGroupUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     1248                 do:
     1249                   message "Упаковка с маркой " + buf_utd-marking-lines.mark + " разгруппирована."
     1250                     view-as alert-box.
     1251                 end.
     1252               end.
     1253             end.
     1254           end.
     1255           if tree:LevelDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num) then
     1256           do:
     1257             tree:StatusDownUTD(buf_utd-marking-lines.mark, buf_utd-marking-lines.doc-id, buf_utd-marking-lines.db-num, ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB) .
     1258           end.
     1259           for first bf_utd-marking-lines exclusive-lock where bf_utd-marking-lines.mark = buf_utd-marking-lines.mark and bf_utd-marking-lines.db-num = buf_utd-marking-lines.db-num and
     1260             bf_utd-marking-lines.doc-id = buf_utd-marking-lines.doc-id:
     1261             bf_utd-marking-lines.sts   = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB .
     1262           end.
     1263         end.
     1264       end.
     1265       else
     1266       do:
     1267         find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark begins mark and buf_utd-marking-lines.db-num = db-num
     1268           and buf_utd-marking-lines.doc-id <> doc-id no-error .
     1269         if available (buf_utd-marking-lines) then
     1270         do:
     1271           v-error = "Товар поставлен на АЗС ранее, верните его на склад" .
     1272           return v-error .
     1273         end.
     1274         else
     1275         do:
     1276           v-error = "Товар отсутствует в поставке. Верните товар поставщику" .
     1277           return v-error .
     1278         end.
     1279       end.
     1280   end method.
     1281   method public character CrUTDIntroduce(p-doc-inv as char):
     1282     def buffer bf_trn for ub.trn-doc.
     1283     def buffer bf_utd for ub.utd.
     1284     find first bf_trn where bf_trn.doc-code =  p-doc-inv no-lock no-error.
     1285     if not available (bf_trn)
     1286       then undo, return error "Не найден документ с номером - " + p-doc-inv.
     1287     create bf_utd.
     1288     bf_utd.obj-type = bf_trn.obj-type.
     1289     bf_utd.obj-code = bf_trn.obj-code.
     1290     bf_utd.host-code = bf_trn.host-code.
     1291     bf_utd.DocumentNumber = bf_trn.doc-code.
     1292     bf_utd.doc-code = bf_trn.doc-code.
     1293     bf_utd.DocumentDate = bf_trn.doc-date.
     1294     bf_utd.LoadDate = bf_trn.doc-date.
     1295     bf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:RecipientResponseStatusNotAccep:KeyIntDB.
     1296     bf_utd.EDocType = ObjSrv:Env:Utd:EDocType:Introduce:KeyIntDB.
     1297     return bf_utd.DocumentNumber.
     1298   end.
     1299   method public character AddMarkUTD(input mark as char, input p-doc-inv as char):
     1300     find first ub.utd no-lock where ub.utd.doc-code = p-doc-inv no-error.
     1301     if not available (ub.utd)
     1302       then undo, return error "Не найден документ с номером - " + p-doc-inv.
     1303     AddMarkUTD (mark, ub.utd.doc-id, ub.utd.db-num) no-error.
     1304     if error-status:error
     1305       then undo, return error return-value.
     1306   end.
     1307   method public character AddLineUTD(gds-code as int, doc-id as integer, db-num as integer, output jj as integer):
     1308     define buffer buf_utd               for ub.utd .
     1309     define buffer buf_utd-lines         for ub.utd-lines .
     1310     define buffer buf_goods             for ub.goods .
     1311     find first buf_goods no-lock where buf_goods.gds-code = gds-code no-error .
     1312     if not available (buf_goods) then do:
     1313       return error "Не найден товар с кодом - " + string (gds-code).
     1314     end.
     1315     find first buf_utd no-lock where buf_utd.doc-id = doc-id and buf_utd.db-num = db-num no-error .
     1316     find first buf_utd-lines exclusive-lock where buf_utd-lines.doc-id = doc-id and buf_utd-lines.db-num = db-num
     1317       and buf_utd-lines.gds-code = buf_goods.gds-code no-error .
     1318     if not available (buf_utd-lines) then
     1319     do:
     1320       find last ub.utd-lines where ub.utd-lines.db-num = db-num and ub.utd-lines.doc-id = doc-id no-error .
     1321       if not available (ub.utd-lines) then jj = 0 .
     1322       else jj = ub.utd-lines.LineNum .
     1323       create buf_utd-lines .
     1324       assign
     1325         buf_utd-lines.GdsName  = buf_goods.gds-name
     1326         buf_utd-lines.db-num   = db-num
     1327         buf_utd-lines.doc-id   = doc-id
     1328         buf_utd-lines.LineNum  = jj + 1
     1329         buf_utd-lines.gds-code = buf_goods.gds-code
     1330         buf_utd-lines.sts      = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB
     1331         buf_utd-lines.UnitCode = buf_goods.unit-base
     1332         .
     1333     end.
     1334     else do:
     1335       jj = buf_utd-lines.LineNum .
     1336     end.
     1337   end.
     1338   method public character AddMarkUTD(mark as char, doc-id as integer, db-num as integer):
     1339     AddMarkUTD(mark, doc-id, db-num, "") no-error.
     1340     if error-status:error
     1341       then undo, return error return-value.
     1342   end.
     1343   method public character AddMarkUTD(mark as char, doc-id as integer, db-num as integer, argPar as char):
     1344     define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1345     define buffer bf_utd-marking-lines  for ub.utd-marking-lines .
     1346     define buffer buf_goods             for ub.goods .
     1347     define buffer buf_marking           for ub.marking .
     1348     define buffer buf_utd               for ub.utd .
     1349     define buffer buf_utd-lines         for ub.utd-lines .
     1350     define variable v-error      as character no-undo .
     1351     define variable Tree         as class     tree no-undo .
     1352     define variable Marking      as class     mark no-undo .
     1353     define variable ungroup      as logical   no-undo .
     1354     define variable v-GTIN       as character no-undo .
     1355     define variable v-gds-code   as integer   no-undo .
     1356     define variable v-qnty       as decimal   no-undo .
     1357     define variable jj           as integer   no-undo .
     1358     define variable v-mark-short as character no-undo .
     1359     Tree = ObjSrv:Lib:MarkingTree .
     1360     Marking = ObjSrv:Env:Marking:Sts:Mark.
     1361     v-mark-short = GetCodeIdent(mark).
     1362       v-GTIN = getGtinByDM(mark) .
     1363       if v-GTIN <> "" then
     1364       do:
     1365         v-gds-code = getGdsCodeByGtin(v-GTIN) .
     1366         find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     1367         if available (buf_goods) then
     1368         do:
     1369           find first buf_utd no-lock where buf_utd.doc-id = doc-id and buf_utd.db-num = db-num no-error .
     1370           find first buf_utd-lines exclusive-lock where buf_utd-lines.doc-id = doc-id and buf_utd-lines.db-num = db-num
     1371             and buf_utd-lines.gds-code = buf_goods.gds-code no-error .
     1372           if not available (buf_utd-lines)
     1373           then do:
     1374             AddLineUTD(buf_goods.gds-code, buf_utd.doc-id, buf_utd.db-num, output jj).
     1375             if error-status:error
     1376               then undo, return error "Не созадана линия УТД по марке - " + mark.
     1377             find first buf_utd-lines exclusive-lock where buf_utd-lines.doc-id = doc-id and buf_utd-lines.db-num = db-num
     1378               and buf_utd-lines.gds-code = buf_goods.gds-code no-error .
     1379           end.
     1380           find first buf_utd-marking-lines no-lock where (buf_utd-marking-lines.mark begins v-mark-short and buf_utd-marking-lines.doc-id = doc-id and buf_utd-marking-lines.db-num = db-num) no-error.
     1381           if available ( buf_utd-marking-lines)
     1382           then do:
     1383             find first ub.utd-marking-lines-attr where
     1384                   ub.utd-marking-lines-attr.db-num    = buf_utd-marking-lines.db-num
     1385               and ub.utd-marking-lines-attr.doc-id    = buf_utd-marking-lines.doc-id
     1386               and ub.utd-marking-lines-attr.LineNum   = buf_utd-marking-lines.LineNum
     1387               and ub.utd-marking-lines-attr.mark      = v-mark-short
     1388               and ub.utd-marking-lines-attr.attr-code = "CrTsd" no-lock no-error
     1389             .
     1390             if available (ub.utd-marking-lines-attr)
     1391               then return "".
     1392               else undo, return error "Марка уже была сканирована " + mark.
     1393           end.
     1394           create buf_utd-marking-lines .
     1395           assign
     1396             buf_utd-marking-lines.db-num    = db-num
     1397             buf_utd-marking-lines.doc-id    = doc-id
     1398             buf_utd-marking-lines.gds-code  = buf_goods.gds-code
     1399             buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     1400             buf_utd-marking-lines.doc-level = 1
     1401            .
     1402           if argPar = "CrTsd"
     1403           then do:
     1404             find first ub.utd-marking-lines-attr where
     1405                   ub.utd-marking-lines-attr.db-num    = buf_utd-marking-lines.db-num
     1406               and ub.utd-marking-lines-attr.doc-id    = buf_utd-marking-lines.doc-id
     1407               and ub.utd-marking-lines-attr.LineNum   = buf_utd-marking-lines.LineNum
     1408               and ub.utd-marking-lines-attr.mark      = v-mark-short
     1409               and ub.utd-marking-lines-attr.attr-code = "CrTsd" no-lock no-error
     1410             .
     1411             if not available (ub.utd-marking-lines-attr)
     1412             then do:
     1413               create ub.utd-marking-lines-attr.
     1414               assign
     1415                 ub.utd-marking-lines-attr.db-num    = buf_utd-marking-lines.db-num
     1416                 ub.utd-marking-lines-attr.doc-id    = buf_utd-marking-lines.doc-id
     1417                 ub.utd-marking-lines-attr.LineNum   = buf_utd-marking-lines.LineNum
     1418                 ub.utd-marking-lines-attr.mark       = v-mark-short
     1419                 ub.utd-marking-lines-attr.attr-code  = "CrTsd"
     1420                 ub.utd-marking-lines-attr.attr-value = mark
     1421                .
     1422             end.
     1423           end.
     1424           find first buf_marking exclusive-lock where buf_marking.mark begins v-mark-short no-error .
     1425           if not available (buf_marking) then
     1426           do:
     1427             create buf_marking .
     1428             assign
     1429               buf_marking.gds-code   = buf_utd-marking-lines.gds-code
     1430               buf_marking.mark       = v-mark-short
     1431               buf_marking.sts        = Marking:PendingVerification:KeyIntDB
     1432               buf_marking.gds-ext-id = v-GTIN
     1433               buf_marking.obj-code   = buf_utd.obj-code
     1434               buf_marking.obj-type   = buf_utd.obj-type
     1435               .
     1436             buf_marking.unit-ext  = getLevelMotpByDM(mark) .
     1437             buf_marking.box-qnty  = getQntyUTDByDM(mark) .
     1438             buf_marking.unit  = getLevelUTDByDM(mark) .
     1439             buf_utd-marking-lines.sts       = Marking:PendingVerification:KeyIntDB.
     1440             buf_utd-marking-lines.mark = buf_marking.mark.
     1441           end.
     1442           else
     1443           do:
     1444             buf_utd-marking-lines.mark = buf_marking.mark.
     1445             for each buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.doc-id = doc-id and buf_utd-marking-lines.db-num = db-num and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum:
     1446               find first ub.marking exclusive-lock where ub.marking.mark = buf_utd-marking-lines.mark no-error.
     1447               buf_utd-marking-lines.sts = Marking:PendingVerification:KeyIntDB.
     1448               ub.marking.sts = Marking:PendingVerification:KeyIntDB .
     1449             end.
     1450           end.
     1451           if (buf_marking.box-qnty = ? or buf_marking.box-qnty = 0) then
     1452           do:
     1453             run gbl/d-prompt.w (
     1454               'title=':u + "Ввод количества" + '\':u
     1455               + 'text1=':u + "Введите количество:" + '\':u
     1456               + 'format=' + ">>>>>9.99" + '\':u
     1457               + 'type=' + 'D' + '\':u
     1458               + 'fillin_row=3\':u
     1459               + 'fillin_col=6\':u
     1460               + 'fillin_width=17\':u
     1461               + 'fillin_height=1\':u
     1462               + 'max-chars=17\':u
     1463               + 'readonly=no\':u
     1464               , input-output v-qnty
     1465               ).
     1466             buf_marking.box-qnty = v-qnty .
     1467             buf_marking.unit  = buf_goods.unit-base .
     1468             buf_marking.unit-ext = "UNIT" .
     1469           end.
     1470           buf_utd-lines.Quantity  = buf_utd-lines.Quantity  + buf_marking.box-qnty .
     1471         end.
     1472         else
     1473           do:
     1474             return error "Товара с GTIN - " + v-GTIN + " нет".
     1475           end.
     1476         end.
     1477         else
     1478         do:
     1479           return error "Не определился GTIN".
     1480         end.
     1481     end method.
     1482   end class.
