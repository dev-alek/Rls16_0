        1   using Progress.Lang.*.
        2   using ibs.th.str.mercury.*.
        3   block-level on error undo, throw.
        4   class ibs.th.str.gds.gdssub:
        5     define property GdsCode as integer no-undo
        6       get.
        7       set.
        8     define property Artic as character no-undo
        9       get.
       10       set.
       11     define property ProdType as character no-undo
       12       get.
       13       set.
       14     define property ProdCode as integer no-undo
       15       get.
       16       set.
       17     define property gdsmercs as class gdsmercsubs no-undo
       18       get :
       19         if valid-object (gdsmercs)
       20         then do:
       21           return gdsmercs.
       22         end.
       23         else do:
       24           gdsmercs = new gdsmercsubs().
       25         end.
       26       end.
       27       set.
       28   end class.
