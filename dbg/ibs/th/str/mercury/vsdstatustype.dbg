      102       private set.
      103     method public character StatusLbl (intSts as integer):
      104       define variable v-str as character no-undo.
      105       v-str = entry (intSts + 1, StatusList).
      106       if v-str = ""
      107         then v-str = "Неизвестный".
      108       return v-str.
      109     end.
      110     method public integer StatusInt (charSts as character):
      111       define variable v-int as integer no-undo.
      112       v-int = lookup (charSts, StatusList) - 1.
      113       if v-int <  0
      114         then v-int = ?.
      115       return v-int.
      116     end.
      117     method public Logical PendingRepayment (intSts as integer):
      118       define variable v-int as integer no-undo.
      119       v-int = lookup (string(intSts), PendingRepaymentList).
      120       return v-int ne 0.
      121     end.
      122     method public character VSDTypeLbl (intVSDType as integer):
      123       define variable v-str as character no-undo.
      124       v-str = entry (intVSDType, VSDTypeList).
      125       if v-str = ""
      126         then v-str = "Неизвестный".
      127       return v-str.
      128     end.
      129     method public integer VSDTypeInt (charVSDType as character):
      130       define variable v-int as integer no-undo.
      131       v-int = lookup (charVSDType, VSDTypeList).
      132       if v-int <  0
      133         then v-int = ?.
      134       return v-int.
      135     end.
      136   end class.
