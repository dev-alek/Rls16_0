       16     define property StatusList as character init "Требует проверки,Ошибка проверки,К гашению,Ошибка гашения,Погашен,Отправлен" no-undo
       17       get.
       18     define property VSDTypeList as character init "Входящий,Исходящий,Производственный,Возвратный,Транспортный" no-undo
       19       get.
       20     define property PendingRepaymentList as character init "4,5" no-undo
       21       get.
       22     define property IsNeedCheckLbl as character no-undo
       23       get:
       24         IsNeedCheckLbl = entry (1, StatusList).
       25         return IsNeedCheckLbl.
       26       end.
       27       private set.
