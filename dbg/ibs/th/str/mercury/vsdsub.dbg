      558     method private void prepareobj ():
      559       vsdStorage = new vsdtostorage().
      560     end.
      561     method public logical checkuuid( input-output uuid as character ):
      562       def var ii as int no-undo.
      563       def var err as logical no-undo.
      564       def var str as character no-undo.
      565       def var numentr as integer no-undo.
      566       numentr = num-entries (uuid, "-") no-error.
      567       if numentr = 8
      568       then do:
      569         do ii = 1 to numentr:
      570           if length (trim (entry (ii, uuid, "-"))) <> 4
      571             then err = true.
      572           str = str + trim (entry (ii, uuid, "-")).
      573           if ii = 2 or ii = 3 or ii = 4 or ii = 5
      574           then do:
      575             str = str + "-".
      576           end.
      577         end.
      578         uuid = str.
      579       end.
      580       numentr = num-entries (uuid, "-") no-error.
      581       do ii = 1 to numentr:
      582         case ii:
      583         when 1 then do:
      584           if length (trim (entry (ii, uuid, "-"))) <> 8
      585             then err = true.
      586         end.
      587         when 2 or when 3 or when 4 then do:
      588           if length (entry (ii, uuid, "-")) <> 4
      589             then err = true.
      590         end.
      591         when 5 then do:
      592           if length (trim (entry (ii, uuid, "-"))) <> 12
      593             then err = true.
      594         end.
      595         end case.
      596       end.
      597       if ii <> 6
      598         then err = true.
      599       if err
      600         then do:
      601           Msg = "Неверный формат UUID - " + uuid.
      602           return false.
      603         end.
      604       return true.
      605     end method.
      606     method public void setMsg( arg as character ):
      607       Msg = arg.
      608     end.
      609     method public void setStatusErr( arg as logical ):
      610       StatusErr = arg.
      611     end.
      612     method public void setFlagChange( arg as logical ):
      613       Changed = arg.
      614     end.
      615   end class.
