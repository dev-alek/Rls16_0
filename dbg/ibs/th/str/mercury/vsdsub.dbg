      120     define property UUID as character no-undo
      121       get.
      122       set ( uuid-arg as char):
      123         uuid-arg = trim(uuid-arg).
      124         if uuid-arg = "" or checkuuid (input-output uuid-arg)
      125           then do:
      126             if UUID <> uuid-arg
      127             then do:
      128               UUID = uuid-arg.
      129               setFlagChange (true).
      130             end.
      131           end.
      132           else do:
      133             UUID = UUID.
      134             message Msg view-as alert-box.
      135             setStatusErr(true).
      136           end.
      137       end.
      138     define property UUIDUsr as character no-undo
      139       get:
      140         def var ii as int no-undo.
      141         def var str as char no-undo.
      142         str = string (replace (UUID, "-", "")).
      143         return str .
      144       end.
