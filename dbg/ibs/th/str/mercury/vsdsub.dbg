      530     define property VsdRecid as recid init ? no-undo
      531       get.
      532       set (arg as recid):
      533         if VsdRecid = ?
      534         then do:
      535           VsdRecid = arg.
      536         end.
      537         else do:
      538           message "Recid уже присвоен. Запрещено присваивать recid не из vsdstorage" view-as alert-box.
