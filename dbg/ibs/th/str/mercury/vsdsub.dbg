       62           return bf_gdsmerc.merc-name.
       63         end.
       64         else do:
       65           find first bf_gdsmerc no-lock
       66             where bf_gdsmerc.gds-code = GdsCode no-error.
       67           if available (bf_gdsmerc)
       68           then do:
       69             return bf_gdsmerc.merc-name.
       70           end.
       71           else return "".
       72         end.
       73       end.
