       39           setFlagChange (true).
       40         end.
       41       end.
       42     define property GdsMercGUID as character no-undo
       43       get:
       44         if available (bf_gdsmerc)
       45         then do:
       46           return bf_gdsmerc.GUID.
       47         end.
       48         else do:
       49           find first bf_gdsmerc no-lock
       50             where bf_gdsmerc.gds-code = GdsCode no-error.
       51           if available (bf_gdsmerc)
       52           then do:
       53             return bf_gdsmerc.GUID.
       54           end.
       55           else return "".
       56         end.
       57       end.
       58     define property GdsMercName as character no-undo
       59       get:
