     3563                   DeltaOtn_H_Water2       = buf_sr-izmerenia.sr-relative-err-water
     3564                   DeltaOtn_R2             = buf_sr-izmerenia.sr-relative-err-dens
     3565                   DeltaAbs_H_CalcType2    = buf_sr-izmerenia.sr-type-level-measuring + 1
     3566                   DeltaAbs_H_Water_CalcType2 = buf_sr-izmerenia.sr-type-level-measuring + 1
     3567                   DeltaOtn_N              = 0.05
     3568                 .
