     4159         def var MF   as decimal no-undo.
     4160         def var dMF  as decimal no-undo.
     4161         def var MTTH as decimal no-undo.
     4162         def var md   as decimal no-undo.
     4163         def var dmd  as decimal no-undo.
     4164         def var dF   as decimal no-undo.
     4165         def var NPE  as decimal no-undo.
     4166         def var ME   as decimal no-undo.
     4167         def var dMEd as decimal no-undo.
     4168         assign
     4169           MTTH = infoSecObj:DocQnty * infoSecObj:DocDensity
     4170           MF = p-tank-weight-rvs
     4171           dF = 0.65
     4172           NPE = infoSectionTotal:NormalWastage
     4173           dmd = MF * dF * 0.01
     4174           dMP = MF - MTTH
     4175           dMEd = MTTH * NPE * 0.001
     4176           ME = MTTH - MF - dmd
     4177         .
     4178         if MTTH > MF
     4179         and abs(dMP) > dmd + dMed
     4180         then do:
     4181           ME = dMEd.
     4182         end.
     4183         if ME < 0 then ME = 0 .
     4184         infoSecObj:NaturalLoss = ME.
     4185       end .
     4186     end .
     4187   end class.
