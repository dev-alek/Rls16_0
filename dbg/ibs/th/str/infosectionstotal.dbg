     3518                 substitute ("Для складского места &1 не заданно средство измерения",buf_place.pl-code)
     3519               view-as alert-box error.
     3520               undo _trpomi, return error.
     3521             end.
     3522             else do :
     3523               find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = place-si no-error.
