      194     method public void Initialization (inTrnDocNum as char, inGdsCode as int):
      195       define variable rdc-dnstvalue as character no-undo.
      196       define variable rdc-dnsttype as character no-undo.
      197       define variable v-gds-attr-value as character no-undo .
      198       define variable v-gds-attr-type  as character no-undo .
      199       assign
      200         TrnDocNum = inTrnDocNum
      201         GdsCode = inGdsCode
      202       .
      203       find first buf_trn no-lock where buf_trn.doc-code = TrnDocNum.
      204       ObjCode = buf_trn.obj-code.
      205       ObjType = buf_trn.obj-type.
      206       NLStorage = new normloss ().
      207       Parnl = new partpnloss ().
      208       PrtlPropObj = ptrlpropproc:GetPropPtrl(ObjType, ObjCode).
      209           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      210         (input  GdsCode
      211         ,input  'fuel-type':U
      212         ,output v-gds-attr-value
      213         ,output v-gds-attr-type
      214         ) no-error .
      215       if error-status :error
      216       then do:
      217         FuelType = "".
      218       end.
      219       else FuelType = v-gds-attr-value.
      220       run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
      221       if error-status:error or lookup (FuelType, "metan,propan,lgas") > 0 then
      222       do:
      223         rdc-dnstvalue = "not".
      224       end.
      225       RdcDnstvalue = rdc-dnstvalue.
      226       GetDBAllAttr ().
      227       CalculateTotal().
      228     end method.
      229     method public void Initialization (inTrnDocNum as char, inArtic as char, inObjType as char, inObjCode as int):
      230       find first buf_goods no-lock where
      231                                  buf_goods.artic= inArtic
      232                              and buf_goods.prod-code = inObjCode
      233                              and buf_goods.prod-type = inObjType no-error.
      234       Initialization (inTrnDocNum, buf_goods.gds-code).
      235     end method.
      236     method public void GetDBAllAttr():
      237       define variable ii as integer no-undo.
      238       clearObj().
      239       find first buf_doc-line-attr where buf_doc-line-attr.doc-code = TrnDocNum
      240         and buf_doc-line-attr.gds-code = GdsCode
      241         and buf_doc-line-attr.attr-code = "n" no-error.
      242       if available (buf_doc-line-attr)
      243         then assign SectionNum = integer (buf_doc-line-attr.attr-value).
      244       else SectionNum = 1.
      245       if available (buf_doc-line-attr) and buf_doc-line-attr.attr-value = '0'
      246         then SectionNum = 1.
      247       do ii = 1 to SectionNum :
      248         InfoSectionCurr = new InfoSection().
      249         InfoSectionCurr:infoSectionTotal = this-object.
      250         InfoSectionCurr:idSec = ii.
      251         for each buf_doc-line-attr where buf_doc-line-attr.doc-code = TrnDocNum
      252           and buf_doc-line-attr.gds-code = GdsCode
      253           and not buf_doc-line-attr.attr-code = "n"
      254           and (SectionNum = 1 or (num-entries (buf_doc-line-attr.attr-code, chr(4)) > 1 and (entry (2, buf_doc-line-attr.attr-code, chr(4))) = string (ii) and SectionNum > 1)):
      255           def var attrCode as char no-undo.
      256           assign
      257             attrCode = entry (1, buf_doc-line-attr.attr-code, chr(4)) no-error.
      258           if error-status:error then next.
      259           InfoSectionCurr:SetProp (attrCode, buf_doc-line-attr.attr-value).
      260         end.
      261         create ttObjInfoSecProp.
      262         assign
      263           ttObjInfoSecProp.iSecNum = ii
      264           ttObjInfoSecProp.objInfoSecProp = cast (InfoSectionCurr, Progress.Lang.Object).
      265       end.
      266       CalculateTotal ().
      267     end method.
      268     method public void NewSection(  ):
      269       InfoSectionCurr = new InfoSection().
      270       assign
      271         SectionNum = SectionNum + 1.
      272       create ttObjInfoSecProp.
      273       assign
      274         ttObjInfoSecProp.iSecNum = SectionNum
      275         ttObjInfoSecProp.objInfoSecProp = InfoSectionCurr
      276       .
      277       idSecCurr = SectionNum.
      278       InfoSectionCurr:idSec = SectionNum.
      279       InfoSectionCurr:infoSectionTotal = this-object.
      280       if InfoSectionCurr:AccShip = 0
      281       or InfoSectionCurr:AccShip = ?
      282       then
      283         InfoSectionCurr:AccShip = 0.25.
      284     end method.
      285     method public class InfoSection GetInfoSectionProp ():
      286       return GetInfoSectionProp (1).
      287     end.
      288     method public class InfoSection GetInfoSectionProp (inSecNum as integer):
      289       define variable objInfoSec as class InfoSection.
      290       for first ttObjInfoSecProp where ttObjInfoSecProp.iSecNum = inSecNum:
      291         objInfoSec = cast ( ttObjInfoSecProp.objInfoSecProp, InfoSection ).
      292         InfoSectionCurr = objInfoSec.
      293         idSecCurr = inSecNum.
      294         return objInfoSec.
      295       end.
      296     end method.
      297     method public character GetInfoSectionProp (inTankCord1 as char):
      298       define variable objInfoSec as class InfoSection no-undo.
      299       define variable listIdSec as character no-undo.
      300       listIdSec = "".
      301       for each ttObjInfoSecProp :
      302         objInfoSec = cast ( ttObjInfoSecProp.objInfoSecProp, InfoSection ).
      303         InfoSectionCurr = objInfoSec.
      304         if InfoSectionCurr:ListTank = inTankCord1
      305         then do:
      306           listIdSec = listIdSec + chr(4) + string (ttObjInfoSecProp.iSecNum).
      307         end.
      308       end.
      309       listIdSec = trim (listIdSec, chr(4)).
      310       return listIdSec.
      311     end method.
      312     method public void DeleteSection( inNum as int  ):
      313       def var ii as integer no-undo.
      314       define variable objInfoSec as class InfoSection.
      315       find first ttObjInfoSecProp where ttObjInfoSecProp.iSecNum = inNum.
      316       delete object ttObjInfoSecProp.objInfoSecProp.
      317       delete ttObjInfoSecProp.
      318       ii = 0.
      319       for each ttObjInfoSecProp use-index pi:
      320         assign
      321           ii = ii + 1
      322           ttObjInfoSecProp.iSecNum = ii.
      323           idSecCurr = ttObjInfoSecProp.iSecNum.
      324           objInfoSec = cast ( ttObjInfoSecProp.objInfoSecProp, InfoSection ).
      325           objInfoSec:idSec = ii.
      326       end.
      327       SectionNum = SectionNum - 1.
      328     end method.
      329     method public void CalculateTotal ():
      330       def var ii as integer no-undo.
      331       assign
      332         CarVolTotal = 0
      333         TankVolTotal = 0
      334         TankWaterVolTotal = 0
      335         TankWeightTotal = 0
      336         DocQntyTotal = 0
      337         CliQntyTotal = 0
      338         FactQntyTotal = 0
      339         FactKgQntyTotal = 0
      340         DocDensityAvg = 0
      341         EndRealDate = ?
      342         EndRealTime = ?
      343         StartRealTime = ?
      344         StartRealDate = ?
      345         TPNormPLSum = 0
      346         TPNormAutoSum = 0
      347         TPNormSum = 0
      348       .
      349       do ii = 1 to SectionNum :
      350         GetInfoSectionProp (ii).
      351         if not CliQntyInput
      352         then do:
      353           InfoSectionCurr:CliQnty = round(InfoSectionCurr:DocDensity * InfoSectionCurr:DocQnty, 3).
      354         end.
      355         else do:
      356           InfoSectionCurr:DocDensity = InfoSectionCurr:CliQnty / InfoSectionCurr:DocQnty.
      357         end.
      358         assign
      359           CarVolTotal = InfoSectionCurr:CarVol + CarVolTotal
      360           TankVolTotal = InfoSectionCurr:TankVol + TankVolTotal
      361           TankWaterVolTotal = InfoSectionCurr:TankWater + TankWaterVolTotal
      362           TankWeightTotal = InfoSectionCurr:TankWeight + TankWeightTotal
      363           DocQntyTotal = InfoSectionCurr:DocQnty + DocQntyTotal
      364           FactQntyTotal = InfoSectionCurr:FactQnty + FactQntyTotal
      365           FactKgQntyTotal = InfoSectionCurr:FactKgQnty + FactKgQntyTotal
      366           TPNormPLSum = InfoSectionCurr:TPNormPL + TPNormPLSum
      367           TPNormAutoSum = InfoSectionCurr:TPNormAuto + TPNormAutoSum
      368           TPNormSum = InfoSectionCurr:TPNorm + TPNormSum
      369         .
      370         CliQntyTotal = InfoSectionCurr:CliQnty + CliQntyTotal.
      371         if StartRealDate = ? or datetime (InfoSectionCurr:DateStart, InfoSectionCurr:TimeStart) < datetime (StartRealDate, StartRealTime)
      372         then do:
      373           assign
      374             StartRealTime = InfoSectionCurr:TimeStart
      375             StartRealDate = InfoSectionCurr:DateStart
      376           .
      377         end.
      378         if EndRealDate = ? or datetime (InfoSectionCurr:DateEnd, InfoSectionCurr:TimeEnd) > datetime (EndRealDate, EndRealTime)
      379         then do:
      380           assign
      381             EndRealTime = InfoSectionCurr:TimeEnd
      382             EndRealDate = InfoSectionCurr:DateEnd
      383           .
      384         end.
      385       end.
      386       assign
      387         CliQntyTotal = round(CliQntyTotal, 3)
      388         CarVolTotal = round(CarVolTotal, 3)
      389         TankVolTotal = round(TankVolTotal, 3)
      390         TankWaterVolTotal = round(TankWaterVolTotal, 3)
      391         TankWeightTotal = round(TankWeightTotal, 3)
      392         DocQntyTotal = round(DocQntyTotal, 3)
      393         FactQntyTotal = round(FactQntyTotal, 3)
      394         FactKgQntyTotal = round(FactKgQntyTotal, 3)
      395         TPNormPLSum = round(TPNormPLSum, 3)
      396         TPNormAutoSum = round(TPNormAutoSum, 3)
      397         TPNormSum = round(TPNormSum, 3)
      398       .
      399       DocDensityAvg = CliQntyTotal / DocQntyTotal .
      400     end method.
      401     method public void clearObj ():
      402       release buf_doc-line-attr.
      403       for each ttObjInfoSecProp use-index pi:
      404         if ttObjInfoSecProp.objInfoSecProp <> ? then delete object ttObjInfoSecProp.objInfoSecProp.
      405         delete ttObjInfoSecProp.
      406       end.
      407       SectionNum = 0.
      408     end method.
      409     method private void putheader(input inpGetInfoSectionProp as class InfoSection ):
      410       put stream log-algo unformatted
      411             chr(10)
      412             "-----------------------------------------------"
      413             chr(10)
      414             now chr(10)
      415             "Номер документа: " TrnDocNum chr(10)
      416             "Секция: " inpGetInfoSectionProp:SectionName chr(10)
      417             "Флаг комиссионного приема: " inpGetInfoSectionProp:IsKP chr(10)
      418             inpGetInfoSectionProp:RnAlgo chr(10).
      419     end method.
      420     method public void SaveDB():
      421       find first buf_goods no-lock where buf_goods.gds-code = GdsCode.
      422       if not can-find (first buf_doc-line no-lock where
      423                                  buf_doc-line.doc-code = TrnDocNum
      424                              and buf_goods.artic = buf_doc-line.artic
      425                              and buf_goods.prod-code = buf_doc-line.prod-code
      426                              and buf_goods.prod-type = buf_doc-line.prod-type)
      427       then do:
      428         return error substitute ("Линия по накладной не существует. Не возможно сохранить в базу данных данные по секциям для накладной &1 товар артикул &2 произовдитель &3&4", TrnDocNum, buf_goods.artic, buf_goods.prod-type, buf_goods.prod-code).
      429       end.
      430       SaveDBNoCheck().
      431     end.
      432     method public void SaveDBNoCheck():
      433       define variable ii as integer no-undo.
      434       for each buf_doc-line-attr where buf_doc-line-attr.doc-code = TrnDocNum
      435         and buf_doc-line-attr.gds-code = GdsCode
      436         :
      437         if buf_doc-line-attr.attr-code = "propan-perc"
      438         or buf_doc-line-attr.attr-code = "connect-hoses"
      439         then next .
      440         delete buf_doc-line-attr.
      441       end.
      442       create buf_doc-line-attr.
      443       assign
      444         buf_doc-line-attr.doc-code = TrnDocNum
      445         buf_doc-line-attr.gds-code = GdsCode
      446         buf_doc-line-attr.attr-code = "n"
      447         buf_doc-line-attr.attr-value = string (SectionNum)
      448       .
      449       do ii = 1 to SectionNum:
      450         GetInfoSectionProp (ii).
      451         create buf_doc-line-attr.
      452         assign
      453           buf_doc-line-attr.doc-code = TrnDocNum
      454           buf_doc-line-attr.gds-code = GdsCode
      455           buf_doc-line-attr.attr-code = 'car-vol' + if SectionNum > 1 then chr(4) + string (ii) else "".
      456         buf_doc-line-attr.attr-value = string (InfoSectionCurr:CarVol).
      457         create buf_doc-line-attr.
      458         assign
      459           buf_doc-line-attr.doc-code = TrnDocNum
      460           buf_doc-line-attr.gds-code = GdsCode
      461           buf_doc-line-attr.attr-code = 'tests' + if SectionNum > 1 then chr(4) + string (ii) else "".
      462         buf_doc-line-attr.attr-value = string (InfoSectionCurr:Tests).
      463         create buf_doc-line-attr.
      464         assign
      465           buf_doc-line-attr.doc-code = TrnDocNum
      466           buf_doc-line-attr.gds-code = GdsCode
      467           buf_doc-line-attr.attr-code = 'certif-fuel' + if SectionNum > 1 then chr(4) + string (ii) else "".
      468         buf_doc-line-attr.attr-value = InfoSectionCurr:CertifFuel.
      469         create buf_doc-line-attr.
      470         assign
      471           buf_doc-line-attr.doc-code = TrnDocNum
      472           buf_doc-line-attr.gds-code = GdsCode
      473           buf_doc-line-attr.attr-code = 'norm-doc' + if SectionNum > 1 then chr(4) + string (ii) else "".
      474         buf_doc-line-attr.attr-value = InfoSectionCurr:NormDoc.
      475         create buf_doc-line-attr.
      476         assign
      477           buf_doc-line-attr.doc-code = TrnDocNum
      478           buf_doc-line-attr.gds-code = GdsCode
      479           buf_doc-line-attr.attr-code = 'num-passport' + if SectionNum > 1 then chr(4) + string (ii) else "".
      480         buf_doc-line-attr.attr-value = InfoSectionCurr:NumPassport.
      481         create buf_doc-line-attr.
      482         assign
      483           buf_doc-line-attr.doc-code = TrnDocNum
      484           buf_doc-line-attr.gds-code = GdsCode
      485           buf_doc-line-attr.attr-code = 'validity-certif' + if SectionNum > 1 then chr(4) + string (ii) else "".
      486         buf_doc-line-attr.attr-value = InfoSectionCurr:ValidityCertif.
      487         create buf_doc-line-attr.
      488         assign
      489           buf_doc-line-attr.doc-code = TrnDocNum
      490           buf_doc-line-attr.gds-code = GdsCode
      491           buf_doc-line-attr.attr-code = 'passport-plotn' + if SectionNum > 1 then chr(4) + string (ii) else "".
      492         buf_doc-line-attr.attr-value = InfoSectionCurr:PassportPlotn.
