      863     method public void RNAlgo (ii as int, output MP as decimal):
      864       RNAlgo(ii, MP, no).
      865     end.
      866     method public void RNAlgo (ii as int, output MP as decimal, IsManual as log):
      867       def var dMP  as decimal no-undo.
      868       def var MF   as decimal no-undo.
      869       def var dMF  as decimal no-undo.
      870       def var MTTH as decimal no-undo.
      871       def var md   as decimal no-undo.
      872       def var dmd  as decimal no-undo.
      873       def var dF   as decimal no-undo.
      874       def var NPE  as decimal no-undo.
      875       def var ME   as decimal no-undo.
      876       def var dMEd as decimal no-undo.
      877       def var I    as decimal no-undo.
      878       def var H    as decimal no-undo.
      879       def var v-ok as logical no-undo.
      880       assign
      881         MTTH = InfoSectionCurr:DocQnty * InfoSectionCurr:DocDensity
      882         MF = InfoSectionCurr:TankWeight
      883         dF = 0.65
      884         NPE = NormalWastage
      885         dmd = MF * dF * 0.01
      886         dMP = MF - MTTH
      887         dMEd = MTTH * NPE * 0.001
      888         ME = MTTH - MF - dmd
      889       .
      890       if ME < 0 then ME = 0 .
      891       if not InfoSectionCurr:IsKP or IsManual
      892       then do:
      893         if abs (dMP) <= dmd
      894         then do:
      895           MP = MTTH.
      896           InfoSectionCurr:AccAbsFact = dmd.
      897           InfoSectionCurr:RnAlgo = "условие 26".
      898           output stream log-algo to value ("log-algo-pomi.txt") append.
      899           putheader(InfoSectionCurr).
      900           put stream log-algo unformatted
      901             "MTTH  = " string(MTTH) chr(10)
      902             "MF  = " string(MF) chr(10)
      903             "dF  = " string(dF) chr(10)
      904             "NPE  = " string(NPE) chr(10)
      905             "dmd  = " string(dmd) chr(10)
      906             "dMP  = " string(dMP) chr(10)
      907             "dMEd  = " string(dMEd) chr(10)
      908             "ME = " string(ME) chr(10)
      909           .
      910           output stream log-algo close.
      911           return.
      912         end.
      913         if abs (dMP) <= dmd + dMed
      914         then do:
      915           MP = MTTH - ME.
      916           InfoSectionCurr:AccAbsFact = dmd + dMed.
      917           InfoSectionCurr:NaturalLoss = ME.
      918           InfoSectionCurr:RnAlgo = "условие 29".
      919           output stream log-algo to value ("log-algo-pomi.txt") append.
      920           putheader(InfoSectionCurr).
      921           put stream log-algo unformatted
      922             "MTTH  = " string(MTTH) chr(10)
      923             "MF  = " string(MF) chr(10)
      924             "dF  = " string(dF) chr(10)
      925             "NPE  = " string(NPE) chr(10)
      926             "dmd  = " string(dmd) chr(10)
      927             "dMP  = " string(dMP) chr(10)
      928             "dMEd  = " string(dMEd) chr(10)
      929             "ME = " string(ME) chr(10)
      930           .
      931           output stream log-algo close.
      932           return.
      933         end.
      934       end.
      935       if not InfoSectionCurr:IsKP and not isManual
      936       then do:
      937         message substitute ("Имеются расхождения с документарным количеством больше допустимого. Требуется комиссионный прием нефтепродукта. Продолжить (для секции &1 будет установлен флаг комиссионного приема)?", ii)
      938         view-as alert-box question buttons yes-no update v-ok .
      939         if not v-ok
      940         then do:
      941           MP = ?.
      942           return.
      943         end.
      944         IsFlagKPChg = true.
      945         assign
      946           InfoSectionCurr:IsKP = true
      947         .
      948         MP = ?.
      949         return.
      950       end.
      951       IsFlagKPChg = false.
      952       if not IsActnComm
      953       then do:
      954         MP = ?.
      955         return.
      956       end.
      957       def var MKP    as decimal no-undo.
      958       def var dMKP   as decimal no-undo.
      959       def var dmKPd  as decimal no-undo.
      960       def var delKP  as decimal no-undo.
      961       def var delTTH as decimal no-undo.
      962       def var dTTH   as decimal no-undo.
      963       def var dKP    as decimal no-undo.
      964       def var MKPK   as decimal no-undo.
      965       def var dmTTHd as decimal no-undo.
      966       def var X1     as decimal no-undo.
      967       def var X2     as decimal no-undo.
      968       def var X3     as decimal no-undo.
      969       def var X4     as decimal no-undo.
      970       if InfoSectionCurr:AccMeth = 1
      971       then
      972       assign
      973         MF = InfoSectionCurr:TankWeightRvs
      974         dMP = MF - MTTH
      975       .
      976       InfoSectionCurr:Deficit = 0 .
      977       InfoSectionCurr:Excess  = 0 .
      978       MKP = MF.
      979       dMKP = MKP - MTTH.
      980       dKP = InfoSectionCurr:AccPomi.
      981       dmKPd = MKP * dF * 0.01.
      982       delKP = dF * MKP * 0.01.
      983       if abs(dMKP) <= dmKPd
      984       then do:
      985         MP = MTTH.
      986         InfoSectionCurr:AccAbsFact = dmKPd.
      987         InfoSectionCurr:RnAlgo = "условие 34".
      988         output stream log-algo to value ("log-algo-pomi.txt") append.
      989         putheader(InfoSectionCurr).
      990         put stream log-algo unformatted
      991           "MTTH  = " string(MTTH) chr(10)
      992           "MF  = " string(MF) chr(10)
      993           "dF  = " string(dF) chr(10)
      994           "NPE  = " string(NPE) chr(10)
      995           "dmd  = " string(dmd) chr(10)
      996           "dMP  = " string(dMP) chr(10)
      997           "dMEd  = " string(dMEd) chr(10)
      998           "ME = " string(ME) chr(10)
      999           "MKP = " string(MKP) chr(10)
     1000           "dMKP = " string(dMKP) chr(10)
     1001           "dmKPd = " string(dmKPd) chr(10)
     1002           "dTTH = " string(dTTH) chr(10)
     1003           "dKP = " string(dKP) chr(10)
     1004           "MKPK = " string(MKPK) chr(10)
     1005           "dmTTHd = " string(dmTTHd) chr(10)
     1006           "MP = " string(MP) chr(10)
     1007           "I = " string(I) chr(10)
     1008           "H = " string(H) chr(10)
     1009         .
     1010         output stream log-algo close.
     1011         return.
     1012       end.
     1013       else do :
     1014         if MTTH < MKP
     1015         then do :
     1016           MKPK = MKP - dmKPd .
     1017           I = MKPK - MTTH.
     1018           MP = MKPK.
     1019           InfoSectionCurr:AccAbsFact = dmKPd.
     1020           InfoSectionCurr:Excess = I.
     1021           InfoSectionCurr:RnAlgo = " нет условие 34 и условие 36".
     1022           output stream log-algo to value ("log-algo-pomi.txt") append.
     1023           putheader(InfoSectionCurr).
     1024           put stream log-algo unformatted
     1025             "MTTH  = " string(MTTH) chr(10)
     1026             "MF  = " string(MF) chr(10)
     1027             "dF  = " string(dF) chr(10)
     1028             "NPE  = " string(NPE) chr(10)
     1029             "dmd  = " string(dmd) chr(10)
     1030             "dMP  = " string(dMP) chr(10)
     1031             "dMEd  = " string(dMEd) chr(10)
     1032             "ME = " string(ME) chr(10)
     1033             "MKP = " string(MKP) chr(10)
     1034             "dMKP = " string(dMKP) chr(10)
     1035             "dmKPd = " string(dmKPd) chr(10)
     1036             "delKP = " string(delKP) chr(10)
     1037             "dKP = " string(dKP) chr(10)
     1038             "MKPK = " string(MKPK) chr(10)
     1039             "dmTTHd = " string(dmTTHd) chr(10)
     1040             "I = " string(I) chr(10)
     1041             "H = " string(H) chr(10)
     1042           .
     1043           output stream log-algo close.
     1044           return.
     1045         end .
     1046         if MTTH > MKP
     1047         then do :
     1048           if abs(dMKP) <= (dmKPd + dMed)
     1049           then do :
     1050             ME = MTTH - MKP - dmKPd .
     1051             MP = MTTH - ME .
     1052             InfoSectionCurr:AccAbsFact = dmKPd + dMed .
     1053             InfoSectionCurr:NaturalLoss = ME .
     1054             InfoSectionCurr:RnAlgo = " нет условие 34, условие 40 и условие 41".
     1055             output stream log-algo to value ("log-algo-pomi.txt") append.
     1056             putheader(InfoSectionCurr).
     1057             put stream log-algo unformatted
     1058               "MTTH  = " string(MTTH) chr(10)
     1059               "MF  = " string(MF) chr(10)
     1060               "dF  = " string(dF) chr(10)
     1061               "NPE  = " string(NPE) chr(10)
     1062               "dmd  = " string(dmd) chr(10)
     1063               "dMP  = " string(dMP) chr(10)
     1064               "dMEd  = " string(dMEd) chr(10)
     1065               "ME = " string(ME) chr(10)
     1066               "MKP = " string(MKP) chr(10)
     1067               "dMKP = " string(dMKP) chr(10)
     1068               "dmKPd = " string(dmKPd) chr(10)
     1069               "dKP = " string(dKP) chr(10)
     1070               "MKPK = " string(MKPK) chr(10)
     1071               "dmTTHd = " string(dmTTHd) chr(10)
     1072               "I = " string(I) chr(10)
     1073               "H = " string(H) chr(10)
     1074             .
     1075             output stream log-algo close.
     1076             return.
     1077           end .
     1078           else do :
     1079             MKPK = MKP + dmKPd .
     1080             ME = dMed .
     1081             H = MTTH - MKPK - ME .
     1082             MP = MKPK .
     1083             InfoSectionCurr:AccAbsFact = dmKPd + dMed.
     1084             InfoSectionCurr:NaturalLoss = ME.
     1085             InfoSectionCurr:Deficit = H.
     1086             InfoSectionCurr:RnAlgo = " нет условие 34, условие 40 и нет условие 41".
     1087             output stream log-algo to value ("log-algo-pomi.txt") append.
     1088             putheader(InfoSectionCurr).
     1089             put stream log-algo unformatted
     1090               "MTTH  = " string(MTTH) chr(10)
     1091               "MF  = " string(MF) chr(10)
     1092               "dF  = " string(dF) chr(10)
     1093               "NPE  = " string(NPE) chr(10)
     1094               "dmd  = " string(dmd) chr(10)
     1095               "dMP  = " string(dMP) chr(10)
     1096               "dMEd  = " string(dMEd) chr(10)
     1097               "ME = " string(ME) chr(10)
     1098               "MKP = " string(MKP) chr(10)
     1099               "dMKP = " string(dMKP) chr(10)
     1100               "dmKPd = " string(dmKPd) chr(10)
     1101               "delKP = " string(delKP) chr(10)
     1102               "dKP = " string(dKP) chr(10)
     1103               "MKPK = " string(MKPK) chr(10)
     1104               "dmTTHd = " string(dmTTHd) chr(10)
     1105               "I = " string(I) chr(10)
     1106               "H = " string(H) chr(10)
     1107             .
     1108             output stream log-algo close.
     1109             return.
     1110           end .
     1111         end .
     1112       end .
     1113       finally:
     1114         find first ub.place no-lock where ub.place.obj-type = ObjType and ub.place.obj-code = ObjCode and ub.place.loc1 = InfoSectionCurr:ListTank no-error.
     1115         if available (ub.place)
     1116         then do:
     1117           assign
     1118             Parnl:ObjType = ObjType
     1119             Parnl:ObjCode = ObjCode
     1120             Parnl:GdsCode = GdsCode
     1121             Parnl:AutoNum = CarNum
     1122             Parnl:OnDate = buf_trn.doc-date
     1123           .
     1124           Parnl:PlCode = ub.place.pl-code no-error.
     1125           release ub.place.
     1126           Parnl:SecNum = InfoSectionCurr:SectionName.
     1127           Parnl:GroupNP = InfoSectionCurr:GroupNP.
     1128           NLStorage:getNormLoss(Parnl).
     1129           InfoSectionCurr:TPNormAuto = Parnl:AutoNormLoss.
     1130           InfoSectionCurr:TPNormPL = (InfoSectionCurr:TankWeight / 1000 * ParNl:PLNormLoss).
     1131           output stream log-algo to value ("log-algo-pomi.txt") append.
     1132           put stream log-algo unformatted
     1133             "MTP = " InfoSectionCurr:TPNorm chr(10)
     1134             "NHH = " string(Parnl:AutoNormLoss) chr(10)
     1135             "NPR = " string(Parnl:PLNormLoss) chr(10).
     1136           output stream log-algo close.
     1137         end.
     1138       end finally.
     1139     end method.
     1140     method public void CalcWeight ():
     1141       define variable ToolType                as integer no-undo.
     1142       define variable DeltaAbs_R              as decimal no-undo.
     1143       define variable DeltaOtn_R              as decimal no-undo.
     1144       define variable DeltaAbs_Tv             as decimal no-undo.
     1145       define variable DeltaAbs_Tr             as decimal no-undo.
     1146       define variable NeckType                as integer no-undo.
     1147       define variable Dgor                    as decimal no-undo.
     1148       define variable NeckWidth               as decimal no-undo.
     1149       define variable NeckHeight              as decimal no-undo.
     1150       define variable ToolAutomationLevel_R   as integer no-undo.
     1151       define variable ToolAutomationLevel_Tv  as integer no-undo.
     1152       define variable ToolAutomationLevel_Tr  as integer no-undo.
     1153       define variable error-string            as character no-undo.
     1154       define variable v-proc as character no-undo.
     1155       define variable v-TankVol-m3            as decimal decimals 10 no-undo .
     1156       define variable vAutomationDegree as integer no-undo extent 3 init [2,1,3].
     1157       define buffer buf_sr-izmerenia    for ub.sr-izmerenia .
     1158       define variable A_Reservoir             as decimal no-undo init 0.0000125 .
     1159       define variable DeltaOtn_N               as decimal no-undo init 0.05 .
     1160       define variable V_real as decimal no-undo.
     1161       define variable vErr as character no-undo .
     1162       define variable vWrn as character no-undo .
     1163       define variable vDllVersion as character no-undo .
     1164       define variable DeltaV_GT as decimal no-undo.
     1165       define variable DeltaV as decimal no-undo.
     1166       define variable Vcy as decimal no-undo.
     1167       define variable Rcy as decimal no-undo.
     1168       define variable Rcy20 as decimal no-undo.
     1169       define variable V as decimal no-undo.
     1170       define variable CTL_base_alt as decimal no-undo.
     1171       define variable CPL_base_alt as decimal no-undo.
     1172       define variable CTPL_base_alt as decimal no-undo.
     1173       define variable Fp_base_alt as decimal no-undo.
     1174       define variable CTL_obs_base as decimal no-undo.
     1175       define variable CPL_obs_base as decimal no-undo.
     1176       define variable CTPL_obs_base as decimal no-undo.
     1177       define variable Fp_obs_base as decimal no-undo.
     1178       define variable VolumetricExpansion as decimal no-undo.
     1179       define variable Rv as decimal no-undo.
     1180       define variable DeltaOtn_Vcy as decimal no-undo.
     1181       define variable M as decimal no-undo.
     1182       define variable DeltaOtn_M as decimal no-undo.
     1183       case RdcDnstvalue:
     1184         when "pomi-rn" then do:
     1185           _trpomi :
     1186             do on error undo, return no-apply :
     1187             find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = InfoSectionCurr:PlaceSi no-error.
     1188             if not available buf_sr-izmerenia then do :
     1189               message
     1190                 substitute( 'Не найдено средство измерения плотности с кодом &1', InfoSectionCurr:PlaceSi ) skip
     1191               view-as alert-box error.
     1192               undo _trpomi, return no-apply  .
     1193             end.
     1194             else do :
     1195               if buf_sr-izmerenia.sr-type-izm = 2 then
     1196               do:
     1197                 message
     1198                   "При расчете по методу CMethodOfMetering31N ~"Расчет массы и объема нефтепродуктов в автомобильных цистернах~"" skip
     1199                   "не предусматривается использование СИ с типом ~"Измерительная система~""
     1200                 view-as alert-box error.
     1201                 undo _trpomi, return no-apply  .
     1202               end.
     1203               assign
     1204                 ToolType               = buf_sr-izmerenia.sr-type-id
     1205                 DeltaAbs_R             = buf_sr-izmerenia.sr-abs-err-dens
     1206                 DeltaOtn_R             = buf_sr-izmerenia.sr-relative-err-dens
     1207                 ToolAutomationLevel_R  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     1208                 ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1].
     1209                 ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     1210               .
     1211               if DeltaOtn_R = ? then DeltaOtn_R = 0 .
     1212             end.
     1213             find first buf_sr-izmerenia no-lock where buf_sr-izmerenia.node-code = InfoSectionCurr:PlaceSiTemp no-error.
     1214             if not available buf_sr-izmerenia then do :
     1215               message
     1216                 substitute( 'Не найдено средство измерения температуры с кодом &1', InfoSectionCurr:PlaceSiTemp ) skip
     1217               view-as alert-box error.
     1218               undo _trpomi, return no-apply  .
     1219             end.
     1220             else do :
     1221               assign
     1222                 DeltaAbs_Tv            = buf_sr-izmerenia.sr-abs-err-temp-vol
     1223                 ToolAutomationLevel_Tv = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     1224                 DeltaAbs_Tr            = buf_sr-izmerenia.sr-abs-err-temp-dens
     1225                 ToolAutomationLevel_Tr = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     1226               .
     1227             end.
     1228             v-proc = "CMethodOfMetering31N" .
     1229             if InfoSectionCurr:Pour = "" then do :
     1230               message
     1231                 "Заполнены не все поля, необходимые " skip
     1232                 "для работы библиотеки ПОкМИ"         skip
     1233                 "Введите тип налива"  skip
     1234               view-as alert-box error.
     1235               undo _trpomi, return no-apply .
     1236             end.
     1237             if InfoSectionCurr:Shape = "" then do :
     1238               message
     1239                 "Заполнены не все поля, необходимые " skip
     1240                 "для работы библиотеки ПОкМИ"         skip
     1241                 "Укажите форму горловины"  skip
     1242               view-as alert-box error.
     1243             end.
     1244             if InfoSectionCurr:CarVol = ? or InfoSectionCurr:CarVol = 0 then do :
     1245               message
     1246                 "Заполнены не все поля, необходимые " skip
     1247                 "для работы библиотеки ПОкМИ"         skip
     1248                 "Введите Объем по свидетельству о поверке в литрах"  skip
     1249               view-as alert-box error.
     1250               undo _trpomi, return no-apply  .
     1251             end.
     1252             if InfoSectionCurr:ABTarir = ? then do :
     1253               message
     1254                 "Заполнены не все поля, необходимые " skip
     1255                 "для работы библиотеки ПОкМИ"         skip
     1256                 "Введите Уровень цистерны относительно тарировочной планки"  skip
     1257               view-as alert-box error.
     1258               undo _trpomi, return no-apply  .
     1259             end.
     1260             decimal(InfoSectionCurr:Diameter) no-error .
     1261             if error-status:error then
     1262             do:
     1263               assign
     1264                 NeckType = 1
     1265                 NeckWidth = decimal (entry (1, replace(InfoSectionCurr:Diameter, "\", "/"), "/"))
     1266                 NeckHeight = decimal (entry (2, replace(InfoSectionCurr:Diameter, "\", "/"), "/"))
     1267                 Dgor = 0
     1268               no-error .
     1269             end.
     1270             else do:
     1271             assign
     1272               NeckType = 0
     1273               Dgor = decimal (InfoSectionCurr:Diameter).
     1274             end.
     1275             if InfoSectionCurr:TankTemp = ? then do :
     1276               message
     1277                 "Заполнены не все поля, необходимые " skip
     1278                 "для работы библиотеки ПОкМИ"         skip
     1279                 "Введите Температуру"  skip
     1280               view-as alert-box error.
     1281               undo _trpomi, return no-apply  .
     1282             end.
     1283             if InfoSectionCurr:DensTemp = ? then do :
     1284               message
     1285                 "Заполнены не все поля, необходимые " skip
     1286                 "для работы библиотеки ПОкМИ"         skip
     1287                 "Введите Температуру"  skip
     1288               view-as alert-box error.
     1289               undo _trpomi, return no-apply  .
     1290             end.
     1291             if InfoSectionCurr:TankDensity = ? or InfoSectionCurr:TankDensity = 0 then do :
     1292               message
     1293                 "Заполнены не все поля, необходимые " skip
     1294                 "для работы библиотеки ПОкМИ"         skip
     1295                 "Введите Плотность топлива для ПОкМИ"  skip
     1296               view-as alert-box error.
     1297               undo _trpomi, return no-apply .
     1298             end.
     1299             if  InfoSectionCurr:ListTank = "" then do :
     1300               message
     1301                 "Заполнены не все поля, необходимые " skip
     1302                 "для работы библиотеки ПОкМИ"         skip
     1303                 "Выберите резервуар"  skip
     1304               view-as alert-box error.
     1305               undo _trpomi, return no-apply .
     1306             end.
     1307             define variable v-auto-error as decimal no-undo.
     1308             find first ub.auto-tank-attr no-lock
     1309                  where ub.auto-tank-attr.auto-num = CarNum
     1310                    and ub.auto-tank-attr.attr-code = "auto-error" no-error.
     1311             if available (ub.auto-tank-attr)
     1312             then do:
     1313               assign v-auto-error = decimal (ub.auto-tank-attr.attr-value) no-error.
     1314               if error-status:error
     1315                 then v-auto-error = 0.4 .
     1316             end.
     1317             else do:
     1318               v-auto-error = 0.4 .
     1319             end.
     1320             find first ub.auto-tank-attr no-lock
     1321                  where ub.auto-tank-attr.auto-num = CarNum
     1322                    and ub.auto-tank-attr.attr-code = "auto-temp" no-error.
     1323             if available (ub.auto-tank-attr)
     1324             then do:
     1325               assign A_Reservoir = decimal (ub.auto-tank-attr.attr-value) no-error.
     1326               if error-status:error
     1327                 then A_Reservoir = 0.0000125 .
     1328             end.
     1329             else do:
     1330               A_Reservoir = 0.0000125 .
     1331             end.
     1332             if A_Reservoir <> 0.0000125
     1333             and A_Reservoir <> 0.000023
     1334             then do :
     1335               A_Reservoir = 0.0000125 .
     1336             end .
     1337             if infoSectionCurr:Pour = "Нижний налив"
     1338             then do:
     1339               assign
     1340                 V_real = (InfoSectionCurr:CarVol + InfoSectionCurr:DopVolume) / 1000
     1341               .
     1342             end.
     1343             else do:
     1344               assign
     1345                 V_real = InfoSectionCurr:CarVol / 1000
     1346               .
     1347             end.
     1348             if InfoSectionCurr:Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая")
     1349             then do :
     1350               InfoSectionCurr:GetCalibTable(InfoSectionCurr:ABTarir) .
     1351             end .
     1352             MM31N
     1353               (
     1354               input V_real,
     1355               input if InfoSectionCurr:Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") then 2 else 1,
     1356               input InfoSectionCurr:CalibTable,
     1357               input InfoSectionCurr:ABTarir,
     1358               input if InfoSectionCurr:Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") then 0 else InfoSectionCurr:NeckArea,
     1359               input infoSectionCurr:TankTemp,
     1360               input InfoSectionCurr:DensTemp,
     1361               input InfoSectionCurr:TankDensity * 1000,
     1362               input TempForPomi,
     1363               input 0.0,
     1364               input 0.0,
     1365               input ToolType,
     1366               input A_Reservoir,
     1367               input v-auto-error,
     1368               input ToolAutomationLevel_R,
     1369               input ToolAutomationLevel_Tv,
     1370               input ToolAutomationLevel_Tr,
     1371               input DeltaAbs_R,
     1372               input DeltaOtn_R,
     1373               input DeltaAbs_Tv,
     1374               input DeltaAbs_Tr,
     1375               input DeltaOtn_N,
     1376               input 1,
     1377               input 2,
     1378               input 2,
     1379               output DeltaV_GT,
     1380               output DeltaV,
     1381               output Vcy,
     1382               output Rcy,
     1383               output Rcy20,
     1384               output V,
     1385               output CTL_base_alt,
     1386               output CPL_base_alt,
     1387               output CTPL_base_alt,
     1388               output Fp_base_alt,
     1389               output CTL_obs_base,
     1390               output CPL_obs_base,
     1391               output CTPL_obs_base,
     1392               output Fp_obs_base,
     1393               output VolumetricExpansion,
     1394               output Rv,
     1395               output DeltaOtn_Vcy,
     1396               output M,
     1397               output DeltaOtn_M,
     1398               output vErr,
     1399               output vWrn,
     1400               output vDllVersion
     1401               )
     1402             .
     1403             output stream outstream to value ("pomi.log") append.
     1404             put stream outstream unformatted
     1405               chr(10)
     1406                                          now                     skip
     1407               'Процедура: '              v-proc                  skip
     1408               'Версия dll: '             vDllVersion     skip
     1409               'V_real                 = ' V_real            skip
     1410               'DeltaCorrectionType    = ' if InfoSectionCurr:Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") then 2 else 1 skip
     1411               'CalibrationTable       = ' InfoSectionCurr:CalibTable skip
     1412               'DeltaH                 = ' InfoSectionCurr:ABTarir skip
     1413               'NeckArea               = ' (if InfoSectionCurr:Shape = entry (1, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") then 0 else InfoSectionCurr:NeckArea) skip
     1414               'Tv                     = ' InfoSectionCurr:TankTemp skip
     1415               'Tr                     = ' InfoSectionCurr:DensTemp skip
     1416               'R                      = ' trim(string(( InfoSectionCurr:TankDensity * 1000 ), ">>>9.9<")) skip
     1417               'Tcy                    = ' TempForPomi skip
     1418               'ToolType               = ' ToolType                skip
     1419               'A_Reservoir            = ' string (A_Reservoir)    skip
     1420               'DeltaOtn_V             = ' string (v-auto-error)   skip
     1421               'ToolAutomationLevel_R  = ' ToolAutomationLevel_R skip
     1422               'ToolAutomationLevel_Tv = ' ToolAutomationLevel_Tv skip
     1423               'ToolAutomationLevel_Tr = ' ToolAutomationLevel_Tr skip
     1424               'DeltaAbs_R             = ' DeltaAbs_R              skip
     1425               'DeltaOtn_R             = ' DeltaOtn_R              skip
     1426               'DeltaAbs_Tv            = ' DeltaAbs_Tv             skip
     1427               'DeltaAbs_Tr            = ' DeltaAbs_Tr             skip
     1428               'DeltaOtn_N             = ' DeltaOtn_N              skip
     1429               'Round_M                = ' 1                       skip
     1430               'Round_T                = ' 2                       skip
     1431               'Round_R                = ' 2                       skip
     1432               'DeltaV_GT              = ' DeltaV_GT         skip
     1433               'DeltaV                 = ' DeltaV            skip
     1434               'Vcy                    = ' Vcy               skip
     1435               'Rcy                    = ' Rcy               skip
     1436               'Rcy20                  = ' Rcy20             skip
     1437               'V                      = ' V                 skip
     1438               'CTL_base_alt           = ' CTL_base_alt      skip
     1439               'CPL_base_alt           = ' CPL_base_alt      skip
     1440               'CTPL_base_alt          = ' CTPL_base_alt     skip
     1441               'Fp_base_alt            = ' Fp_base_alt       skip
     1442               'CTL_obs_base           = ' CTL_obs_base      skip
     1443               'CPL_obs_base           = ' CPL_obs_base      skip
     1444               'CTPL_obs_base          = ' CTPL_obs_base     skip
     1445               'VolumetricExpansion    = ' VolumetricExpansion skip
     1446               'Fp_obs_base            = ' Fp_obs_base       skip
     1447               'Rv                     = ' Rv                skip
     1448               'DeltaOtn_Vcy           = ' DeltaOtn_Vcy      skip
     1449               'M                      = ' M                 skip
     1450               'DeltaOtn_M             = ' DeltaOtn_M        skip
     1451               'Warnings               = ' vWrn              skip
     1452             .
     1453             output stream outstream close.
     1454             if trim(vErr) > "" then do :
     1455               error-string = replace(vErr,";0x","~n0x") .
     1456               output stream outstream to value ("pomi.log") append.
     1457               put stream outstream error-string format "x(1024)" skip.
     1458               output stream outstream close.
     1459               message
     1460                 substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) skip
     1461               view-as alert-box error.
     1462               undo _trpomi, return no-apply  .
     1463             end.
     1464             else do :
     1465               assign
     1466                 InfoSectionCurr:cmom-nb = v-proc
     1467                 InfoSectionCurr:TankDensityPomi = Rcy / 1000
     1468                 InfoSectionCurr:TankVolPomi     = Vcy * 1000
     1469                 InfoSectionCurr:TankWeight      = M
     1470                 InfoSectionCurr:AccPomi         = 0.65
     1471                 InfoSectionCurr:AccPomiReal     = round(DeltaOtn_M, 2)
     1472                 InfoSectionCurr:TankVolPomiReal = V * 1000
     1473                 InfoSectionCurr:PokmiWarnings   = vWrn
     1474               .
     1475             end.
     1476           end.
     1477         end.
     1478         when "th" then do:
     1479             def var v-tank-density-pomi as decimal no-undo.
     1480             def var v-tank-vol-pomi as decimal no-undo.
     1481             if lookup (FuelType, "petrol,diesel-sum,diesel-wint") > 0
     1482             then do:
     1483               message
     1484                 substitute('Ошибка определения типа топлива &1 или не верный тип товлива &2', return-value, FuelType)
     1485               view-as alert-box error.
     1486               undo, return error return-value .
     1487             end.
     1488             run str/rdcdnst.p (input InfoSectionCurr:TankDensityPomi * 1000
     1489                           ,input InfoSectionCurr:DensTemp
     1490                           ,input InfoSectionCurr:TankVol
     1491                           ,input InfoSectionCurr:TankTemp
     1492                           ,input FuelType
     1493                           ,output v-tank-density-pomi
     1494                           ,output v-tank-vol-pomi)
     1495             no-error.
     1496             if not error-status:error then do:
     1497               InfoSectionCurr:TankDensityPomi = v-tank-density-pomi.
     1498               InfoSectionCurr:TankVolPomi = v-tank-vol-pomi.
     1499               InfoSectionCurr:TankWeight = InfoSectionCurr:TankDensityPomi * InfoSectionCurr:TankVolPomi .
     1500             end.
     1501             else do:
     1502               message
     1503                 substitute('Ошибка при рассчете приведенных значений плотности и объема: &1', return-value)
     1504               view-as alert-box error.
     1505               undo, return no-apply  .
     1506             end.
     1507         end.
     1508         when "manual" then do:
     1509           InfoSectionCurr:TankWeight = InfoSectionCurr:TankDensityPomi * InfoSectionCurr:TankVolPomi .
     1510         end.
     1511       end case.
     1512       def var dMP  as decimal no-undo.
     1513       def var MF   as decimal no-undo.
     1514       def var dMF  as decimal no-undo.
     1515       def var MTTH as decimal no-undo.
     1516       def var md   as decimal no-undo.
     1517       def var dmd  as decimal no-undo.
     1518       def var dF   as decimal no-undo.
     1519       def var NPE  as decimal no-undo.
     1520       def var ME   as decimal no-undo.
     1521       def var dMEd as decimal no-undo.
     1522       assign
     1523         MTTH = InfoSectionCurr:DocQnty * InfoSectionCurr:DocDensity
     1524         MF = InfoSectionCurr:TankWeight
     1525         dF = InfoSectionCurr:AccPomi
     1526         NPE = NormalWastage
     1527         dmd = MF * dF * 0.01
     1528         dMP = MF - MTTH
     1529         dMEd = MTTH * NPE * 0.001.
     1530         ME = MTTH - MF - dmd.
     1531       .
     1532       if MTTH > MF
     1533       and abs(dMP) > dmd + dMed
     1534       then do:
     1535         ME = dMEd.
     1536       end.
     1537       if ME < 0 then ME = 0 .
     1538       InfoSectionCurr:NaturalLoss = ME.
     1539       find first ub.place no-lock where ub.place.obj-type = ObjType and ub.place.obj-code = ObjCode and ub.place.loc1 = InfoSectionCurr:ListTank no-error.
     1540       if available (ub.place)
     1541       then do:
     1542         assign
     1543           Parnl:ObjType = ObjType
     1544           Parnl:ObjCode = ObjCode
     1545           Parnl:GdsCode = GdsCode
     1546           Parnl:AutoNum = CarNum
     1547           Parnl:OnDate = buf_trn.doc-date
     1548         .
     1549         Parnl:PlCode = ub.place.pl-code no-error.
     1550         release ub.place.
     1551         Parnl:SecNum = InfoSectionCurr:SectionName.
     1552         Parnl:GroupNP = InfoSectionCurr:GroupNP.
     1553         NLStorage:getNormLoss(Parnl).
     1554         InfoSectionCurr:TPNormAuto = Parnl:AutoNormLoss.
     1555         InfoSectionCurr:TPNormPL = (InfoSectionCurr:TankWeight / 1000 * ParNl:PLNormLoss).
     1556         output stream outstream to value ("pomi.log") append.
     1557         put stream outstream unformatted
     1558           "MTP = " InfoSectionCurr:TPNorm chr(10)
     1559           "NHH = " string(Parnl:AutoNormLoss) chr(10)
     1560           "NPR = " string(Parnl:PLNormLoss) chr(10).
     1561         output stream outstream close.
     1562       end.
     1563     end.
     1564     method public void CalcTP () :
     1565       find first ub.place no-lock where ub.place.obj-type = ObjType and ub.place.obj-code = ObjCode and ub.place.loc1 = InfoSectionCurr:ListTank no-error.
     1566       if available (ub.place)
     1567       then do:
     1568         assign
     1569           Parnl:ObjType = ObjType
     1570           Parnl:ObjCode = ObjCode
     1571           Parnl:GdsCode = GdsCode
     1572           Parnl:AutoNum = CarNum
     1573           Parnl:OnDate = buf_trn.doc-date
     1574         .
     1575         Parnl:PlCode = ub.place.pl-code no-error.
     1576         release ub.place.
     1577         Parnl:SecNum = InfoSectionCurr:SectionName.
     1578         Parnl:GroupNP = InfoSectionCurr:GroupNP.
     1579         NLStorage:getNormLoss(Parnl).
     1580         InfoSectionCurr:TPNormAuto = Parnl:AutoNormLoss.
     1581         InfoSectionCurr:TPNormPL = (InfoSectionCurr:TankWeight / 1000 * ParNl:PLNormLoss).
     1582         output stream log-algo to value ("log-algo-pomi.txt") append.
     1583         put stream log-algo unformatted
     1584           "MTP = " InfoSectionCurr:TPNorm chr(10)
     1585           "NHH = " string(Parnl:AutoNormLoss) chr(10)
     1586           "NPR = " string(Parnl:PLNormLoss) chr(10).
     1587         output stream log-algo close.
     1588       end.
     1589     end method .
     1590     method public logical CheckNameSec (arg1 as int, arg2 as char):
     1591         def var ii as int no-undo.
     1592         do ii = 1 to this-object:SectionNum:
     1593           this-object:GetInfoSectionProp(ii).
     1594           if this-object:idSecCurr = arg1
     1595             then next.
     1596           if  trim (arg2) <> "" and trim (this-object:InfoSectionCurr:SectionName) = trim (arg2)
     1597           then do:
     1598             return false.
     1599           end.
     1600         end.
     1601         return not can-find (first buf_doc-line-attr no-lock where
     1602               buf_doc-line-attr.doc-code = TrnDocNum
     1603           and buf_doc-line-attr.gds-code <> GdsCode
     1604           and buf_doc-line-attr.attr-code begins "section-name"
     1605           and trim (arg2) = trim (buf_doc-line-attr.attr-value)).
     1606     end.
     1607     method public void GetArea ( output NeckArea as decimal, input v-boxshape as integer, input v-size as character ):
     1608       define variable v-mm as com-handle.
     1609       define variable v-proc as character no-undo.
     1610       define variable error-string as character no-undo.
     1611       define variable vErr as character no-undo .
     1612       define variable vWrn as character no-undo .
     1613       define variable vDllVersion as character no-undo .
     1614       define variable Diameter      as decimal no-undo .
     1615       define variable Length        as decimal no-undo .
     1616       define variable Width         as decimal no-undo .
     1617       define variable Circumference as decimal no-undo .
     1618       define variable Wall          as decimal no-undo .
     1619       if not RdcDnstvalue = "pomi-rn"
     1620       then do:
     1621         case v-boxshape:
     1622           when 1 then do:
     1623             NeckArea = decimal(entry(3, v-size, "/")) * decimal(entry(4, v-size, "/")) * 0.000001 no-error.
     1624           end .
     1625           when 3 then do:
     1626             NeckArea = 3.14159 * decimal(entry(2, v-size, "/")) * decimal(entry(2, v-size, "/")) * 0.000001 / 4 no-error .
     1627           end .
     1628           otherwise do :
     1629             NeckArea = 0 .
     1630           end .
     1631         end case .
     1632         if NeckArea = ? then NeckArea = 0 .
     1633         return.
     1634       end.
     1635       if v-size = ""
     1636       or v-size = ?
     1637       then do :
     1638         v-size = "////" .
     1639       end .
     1640       v-proc = "CMethodOfMetering26A" .
     1641       def var v-diameter as decimal no-undo.
     1642       def var v-circumference as decimal no-undo.
     1643       def var v-wall as decimal no-undo.
     1644       case v-boxshape:
     1645         when 1 then do:
     1646           assign
     1647             Diameter      = 0.0
     1648             Length        = decimal (entry (3, v-size, "/"))
     1649             Width         = decimal (entry (4, v-size, "/"))
     1650             Circumference = 0.0
     1651             Wall          = decimal (entry (2, v-size, "/"))
     1652           .
     1653         end.
     1654         when 2 then do:
     1655           assign
     1656             Diameter      = 0.0
     1657             Length        = decimal (entry (3, v-size, "/"))
     1658             Width         = decimal (entry (4, v-size, "/"))
     1659             Circumference = 0.0
     1660             Wall          = decimal (entry (2, v-size, "/"))
     1661           .
     1662         end.
     1663         when 3 then do:
     1664           case true:
     1665             when decimal (entry (3, v-size, "/")) > 0 and decimal (entry (5, v-size, "/")) > 0 then do:
     1666               v-diameter = decimal (entry (3, v-size, "/")).
     1667               v-wall = decimal (entry (5, v-size, "/")).
     1668               v-circumference = 0.
     1669             end.
     1670             when decimal (entry (2, v-size, "/")) > 0 then do:
     1671               v-diameter = decimal (entry (2, v-size, "/")).
     1672               v-wall = 0.
     1673               v-circumference = 0.
     1674             end.
     1675             when decimal (entry (4, v-size, "/")) > 0 then do:
     1676               v-diameter = 0.
     1677               v-wall = decimal (entry (5, v-size, "/")).
     1678               v-circumference = decimal (entry (4, v-size, "/")).
     1679               v-boxshape = 4.
     1680             end.
     1681             otherwise do:
     1682               v-diameter = if decimal (entry (3, v-size, "/")) > 0 then decimal (entry (3, v-size, "/")) else decimal (entry (2, v-size, "/")).
     1683               v-wall = decimal (entry (5, v-size, "/")).
     1684               v-circumference = decimal (entry (4, v-size, "/")).
     1685             end.
     1686           end case.
     1687           assign
     1688             Diameter      = v-diameter
     1689             Length        = 0.0
     1690             Width         = 0.0
     1691             Circumference = v-circumference
     1692             Wall          = v-wall
     1693           .
     1694         end.
     1695         when 0 then do:
     1696           NeckArea = 0.
     1697           return.
     1698         end.
     1699         otherwise do:
     1700           message
     1701             substitute('Неверный тип горловины')
     1702           view-as alert-box error.
     1703           undo, return no-apply .
     1704         end.
     1705       end case.
     1706       MM26A
     1707         (
     1708         input v-boxshape,
     1709         input Diameter,
     1710         input Length,
     1711         input Width,
     1712         input Circumference,
     1713         input Wall,
     1714         output NeckArea,
     1715         output vErr,
     1716         output vWrn,
     1717         output vDllVersion
     1718         )
     1719       .
     1720       output stream outstream to value ("pomi.log") append.
     1721       put stream outstream unformatted
     1722         chr(10)
     1723         now skip
     1724         'Процедура: '             v-proc             skip
     1725         'Type                 = ' v-boxshape         skip
     1726         'Diameter             = ' Diameter      skip
     1727         'Length               = ' Length        skip
     1728         'Width                = ' Width         skip
     1729         'Circumference        = ' Circumference skip
     1730         'Wall                 = ' Wall          skip
     1731       .
     1732       output stream outstream close.
     1733       if trim(vErr) > "" then do :
     1734         error-string = vErr .
     1735         output stream outstream to value ("pomi.log") append.
     1736           put stream outstream error-string format "x(1024)" skip.
     1737         output stream outstream close.
     1738         message
     1739           substitute('Ошибка работы библиотеки ПОкМИ &1',error-string) skip
     1740         view-as alert-box error.
     1741         undo, return no-apply  .
     1742       end.
     1743       else do :
     1744         output stream outstream to value ("pomi.log") append.
     1745           put stream outstream
     1746           "Area             = " string (NeckArea)      skip.
     1747         output stream outstream close.
     1748       end.
     1749     end method.
     1750     destructor public InfoSectionsTotal ( ):
     1751       clearObj().
     1752     end destructor.
     1753   method public void MM6
     1754     (
     1755     input H as decimal,
     1756     input H_water as decimal,
     1757     input CalibrationTable as character,
     1758     input CalibrationBelt as character,
     1759     input P0 as decimal,
     1760     input Tv as decimal,
     1761     input Tr as decimal,
     1762     input R as decimal,
     1763     input Tcy as decimal,
     1764     input ToolType as integer,
     1765     input DeltaOtn_K as decimal,
     1766     input DeadZone_Reservoir as decimal,
     1767     input A_Reservoir as decimal,
     1768     input A_LevelMeasurementTool as decimal,
     1769     input ToolAutomationLevel_H as integer,
     1770     input ToolAutomationLevel_H_Water as integer,
     1771     input ToolAutomationLevel_R as integer,
     1772     input ToolAutomationLevel_Tv as integer,
     1773     input ToolAutomationLevel_Tr as integer,
     1774     input DeltaAbs_H_CalcType as integer,
     1775     input DeltaAbs_H_Water_CalcType as integer,
     1776     input DeltaAbs_H as decimal,
     1777     input DeltaAbs_H_Water as decimal,
     1778     input DeltaAbs_R as decimal,
     1779     input DeltaAbs_Tv as decimal,
     1780     input DeltaAbs_Tr as decimal,
     1781     input DeltaOtn_N as decimal,
     1782     input Round_M as integer,
     1783     input Round_T as integer,
     1784     input Round_R as integer,
     1785     output V_total as decimal,
     1786     output V_water as decimal,
     1787     output DeltaV as decimal,
     1788     output V_product as decimal,
     1789     output Vcy as decimal,
     1790     output Rcy as decimal,
     1791     output V as decimal,
     1792     output CTL_base_alt as decimal,
     1793     output CPL_base_alt as decimal,
     1794     output CTPL_base_alt as decimal,
     1795     output Fp_base_alt as decimal,
     1796     output CTL_obs_base as decimal,
     1797     output CPL_obs_base as decimal,
     1798     output CTPL_obs_base as decimal,
     1799     output Fp_obs_base as decimal,
     1800     output Rv as decimal,
     1801     output DeltaOtn_Vcy as decimal,
     1802     output DeltaOtn_Vm as decimal,
     1803     output M as decimal,
     1804     output DeltaOtn_M as decimal,
     1805     output VolumetricExpansion as decimal,
     1806     output Err as character,
     1807     output Wrn as character,
     1808     output DllVersion as character
     1809     )
     1810   :
     1811     define variable libName as character no-undo .
     1812     define variable hCall   AS handle    no-undo .
     1813     define variable mErr as memptr no-undo .
     1814     define variable mWrn as memptr no-undo .
     1815     define variable mDllVersion as memptr no-undo .
     1816     SET-SIZE(mErr) = 1024 .
     1817     SET-SIZE(mWrn) = 1024 .
     1818     SET-SIZE(mDllVersion) = 20 .
     1819     libName = search("exe/MM.dll") .
     1820     create call hCall.
     1821     assign
     1822       hCall:CALL-NAME      = "MethodCt6"
     1823       hCall:LIBRARY        = libName
     1824       hCall:CALL-TYPE      = DLL-CALL-TYPE
     1825       hCall:NUM-PARAMETERS = 56
     1826     .
     1827     hCall:SET-PARAMETER(1, "Memptr", "OUTPUT", mErr).
     1828     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     1829     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
     1830     hCall:SET-PARAMETER(4, "DOUBLE", "INPUT", H).
     1831     hCall:SET-PARAMETER(5, "DOUBLE", "INPUT", H_water).
     1832     hCall:SET-PARAMETER(6, "CHARACTER", "INPUT", CalibrationTable).
     1833     hCall:SET-PARAMETER(7, "CHARACTER", "INPUT", CalibrationBelt).
     1834     hCall:SET-PARAMETER(8, "DOUBLE", "INPUT", P0).
     1835     hCall:SET-PARAMETER(9, "DOUBLE", "INPUT", Tv).
     1836     hCall:SET-PARAMETER(10, "DOUBLE", "INPUT", Tr).
     1837     hCall:SET-PARAMETER(11, "DOUBLE", "INPUT", R).
     1838     hCall:SET-PARAMETER(12, "DOUBLE", "INPUT", Tcy).
     1839     hCall:SET-PARAMETER(13, "LONG", "INPUT", ToolType).
     1840     hCall:SET-PARAMETER(14, "DOUBLE", "INPUT", DeltaOtn_K).
     1841     hCall:SET-PARAMETER(15, "DOUBLE", "INPUT", DeadZone_Reservoir).
     1842     hCall:SET-PARAMETER(16, "DOUBLE", "INPUT", A_Reservoir).
     1843     hCall:SET-PARAMETER(17, "DOUBLE", "INPUT", A_LevelMeasurementTool).
     1844     hCall:SET-PARAMETER(18, "LONG", "INPUT", ToolAutomationLevel_H).
     1845     hCall:SET-PARAMETER(19, "LONG", "INPUT", ToolAutomationLevel_H_Water).
     1846     hCall:SET-PARAMETER(20, "LONG", "INPUT", ToolAutomationLevel_R).
     1847     hCall:SET-PARAMETER(21, "LONG", "INPUT", ToolAutomationLevel_Tv).
     1848     hCall:SET-PARAMETER(22, "LONG", "INPUT", ToolAutomationLevel_Tr).
     1849     hCall:SET-PARAMETER(23, "LONG", "INPUT", DeltaAbs_H_CalcType).
     1850     hCall:SET-PARAMETER(24, "LONG", "INPUT", DeltaAbs_H_Water_CalcType).
     1851     hCall:SET-PARAMETER(25, "DOUBLE", "INPUT", DeltaAbs_H).
     1852     hCall:SET-PARAMETER(26, "DOUBLE", "INPUT", DeltaAbs_H_Water).
     1853     hCall:SET-PARAMETER(27, "DOUBLE", "INPUT", DeltaAbs_R).
     1854     hCall:SET-PARAMETER(28, "DOUBLE", "INPUT", DeltaAbs_Tv).
     1855     hCall:SET-PARAMETER(29, "DOUBLE", "INPUT", DeltaAbs_Tr).
     1856     hCall:SET-PARAMETER(30, "DOUBLE", "INPUT", DeltaOtn_N).
