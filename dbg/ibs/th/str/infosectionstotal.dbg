     3536                   ToolAutomationLevel_H_Water1 = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3537                   DeltaAbs_H1             = buf_sr-izmerenia.sr-abs-err-neft-water
     3538                   DeltaAbs_H_Water1       = buf_sr-izmerenia.sr-abs-err-water
     3539                   ToolAutomationLevel_R1  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3540                   DeltaAbs_R1             = buf_sr-izmerenia.sr-abs-err-dens
     3541                   ToolAutomationLevel_Tv1 = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3542                   DeltaAbs_Tv1            = buf_sr-izmerenia.sr-abs-err-temp-vol
     3543                   ToolAutomationLevel_Tr1 = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3544                   DeltaAbs_Tr1            = buf_sr-izmerenia.sr-abs-err-temp-dens
     3545                   DeltaOtn_H1             = buf_sr-izmerenia.sr-relative-err-neft-water
     3546                   DeltaOtn_H_Water1       = buf_sr-izmerenia.sr-relative-err-water
     3547                   DeltaOtn_R1             = buf_sr-izmerenia.sr-relative-err-dens
     3548                   DeltaAbs_H_CalcType1    = buf_sr-izmerenia.sr-type-level-measuring + 1
     3549                   DeltaAbs_H_Water_CalcType1 = buf_sr-izmerenia.sr-type-level-measuring + 1
     3550                   ToolType2               = buf_sr-izmerenia.sr-type-id
     3551                   LevelToolType2          = buf_sr-izmerenia.sr-type-level-measuring
     3552                   ToolAutomationLevel_H2  = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3553                   ToolAutomationLevel_H_Water2 = vAutomationDegree[buf_sr-izmerenia.sr-type-izm + 1]
     3554                   DeltaAbs_H2             = buf_sr-izmerenia.sr-abs-err-neft-water
     3555                   DeltaAbs_H_Water2       = buf_sr-izmerenia.sr-abs-err-water
