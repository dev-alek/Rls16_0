     2680     hCall:SET-PARAMETER(1, "Memptr", "OUTPUT", mErr).
     2681     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     2682     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
     2683     hCall:SET-PARAMETER(4, "LONG", "INPUT", M_type).
     2684     hCall:SET-PARAMETER(5, "DOUBLE", "INPUT", M).
     2685     hCall:SET-PARAMETER(6, "DOUBLE", "INPUT", T).
     2686     hCall:SET-PARAMETER(7, "LONG", "INPUT", P_type).
     2687     hCall:SET-PARAMETER(8, "DOUBLE", "INPUT", P_extra).
     2688     hCall:SET-PARAMETER(9, "DOUBLE", "INPUT", P_atmosphere).
     2689     hCall:SET-PARAMETER(10, "DOUBLE", "INPUT", M_pseudo).
     2690     hCall:SET-PARAMETER(11, "DOUBLE", "INPUT", R_pseudo).
     2691     hCall:SET-PARAMETER(12, "LONG", "INPUT", Round_T).
     2692     hCall:SET-PARAMETER(13, "LONG", "INPUT", Round_R).
     2693     hCall:SET-PARAMETER(14, "LONG", "INPUT", 1024).
     2694     hCall:SET-PARAMETER(15, "LONG", "INPUT", 1024).
     2695     hCall:SET-PARAMETER(16, "DOUBLE", "OUTPUT", R).
     2696     hCall:SET-PARAMETER(17, "DOUBLE", "OUTPUT", P_vapor).
     2697     hCall:INVOKE( ).
     2698     Err = get-string(mErr, 1, 1024) .
     2699     Wrn = get-string(mWrn, 1, 1024) .
     2700     DllVersion = get-string(mDllVersion, 1, 20) .
     2701     delete object hCall.
     2702   end .
     2703   method public void MM57
     2704     (
     2705     input H as decimal,
     2706     input ToolType as integer,
     2707     output DeltaAbs_H as decimal,
     2708     output Err as character,
     2709     output Wrn as character,
     2710     output DllVersion as character
     2711     )
     2712   :
     2713     define variable libName as character no-undo .
     2714     define variable hCall   AS handle    no-undo .
     2715     define variable mErr as memptr no-undo .
     2716     define variable mWrn as memptr no-undo .
     2717     define variable mDllVersion as memptr no-undo .
     2718     SET-SIZE(mErr) = 1024 .
     2719     SET-SIZE(mWrn) = 1024 .
     2720     SET-SIZE(mDllVersion) = 20 .
     2721     libName = search("exe/MM.dll") .
     2722     create call hCall.
     2723     assign
     2724       hCall:CALL-NAME      = "MethodCt57"
     2725       hCall:LIBRARY        = libName
     2726       hCall:CALL-TYPE      = DLL-CALL-TYPE
     2727       hCall:NUM-PARAMETERS = 8
     2728     .
     2729     hCall:SET-PARAMETER(1, "Memptr", "OUTPUT", mErr).
     2730     hCall:SET-PARAMETER(2, "Memptr", "OUTPUT", mWrn).
     2731     hCall:SET-PARAMETER(3, "Memptr", "OUTPUT", mDllVersion).
     2732     hCall:SET-PARAMETER(4, "DOUBLE", "INPUT", H).
     2733     hCall:SET-PARAMETER(5, "LONG", "INPUT", ToolType).
     2734     hCall:SET-PARAMETER(6, "LONG", "INPUT", 1024).
     2735     hCall:SET-PARAMETER(7, "LONG", "INPUT", 1024).
     2736     hCall:SET-PARAMETER(8, "DOUBLE", "OUTPUT", DeltaAbs_H).
     2737     hCall:INVOKE( ).
     2738     Err = get-string(mErr, 1, 1024) .
     2739     Wrn = get-string(mWrn, 1, 1024) .
     2740     DllVersion = get-string(mDllVersion, 1, 20) .
     2741     delete object hCall.
     2742   end .
     2743   method public character getCalibrationBelt
     2744     (
     2745     input iObjType as character,
     2746     input iObjCode as integer,
     2747     input iPlCode  as integer,
     2748     input iLevelNP as decimal,
     2749     input iLevelWater as decimal
     2750     )
     2751   :
     2752     define variable vCalibBelt      as  character         no-undo.
     2753     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     2754     for each buf_pl-level-mm where
     2755              buf_pl-level-mm.obj-type = iObjType
     2756          and buf_pl-level-mm.obj-code = iObjCode
     2757          and buf_pl-level-mm.pl-code  = iPlCode
     2758          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     2759               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     2760         no-lock
     2761         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     2762       if first-of(buf_pl-level-mm.zone) then do:
     2763         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     2764       end.
     2765       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     2766       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     2767         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     2768     end.
     2769     return vCalibBelt.
     2770   end.
     2771     method public void CalcPomiRvs(
     2772       input p-sec-num as integer,
     2773       input p-doc-code as character,
     2774       input p-gds-code as integer,
     2775       input-output infoSectionTotal as class ibs.th.str.InfoSectionsTotal,
     2776       output p-tank-weight-rvs as decimal,
     2777       output p-tank-vol-pomi-rvs as decimal )
     2778     :
     2779       define buffer buf_place             for ub.place .
     2780       define buffer buf2_place            for ub.place .
     2781       define buffer buf_clob-bind         for ub.clob-bind .
     2782       define buffer buf_place-attr        for ub.place-attr .
     2783       define buffer bf_goods              for ub.goods .
     2784       define buffer bf_bef_rvs-doc        for ub.rvs-doc  .
     2785       define buffer bf_aft_rvs-doc        for ub.rvs-doc  .
     2786       define buffer bf_bef_rvs-line       for ub.rvs-line .
     2787       define buffer bf_aft_rvs-line       for ub.rvs-line .
     2788       define buffer bf_rvs-line-attr      for ub.rvs-line-attr .
     2789       define buffer buf_sr-izmerenia      for sr-izmerenia .
     2790       define buffer dens_sr-izmerenia     for sr-izmerenia .
     2791       define buffer temp_sr-izmerenia     for sr-izmerenia .
     2792       define buffer level_sr-izmerenia    for sr-izmerenia .
     2793       define buffer temp-dens_sr-izmerenia for sr-izmerenia .
     2794       define buffer water1_pl-level       for ub.pl-level .
     2795       define buffer water2_pl-level       for ub.pl-level .
     2796       define buffer total1_pl-level       for ub.pl-level .
     2797       define buffer total2_pl-level       for ub.pl-level .
     2798       define buffer buf_pl-level-attr     for ub.pl-level-attr .
     2799       define buffer buf_pl-level          for ub.pl-level .
     2800       define variable CalibTable               as character no-undo initial "".
     2801       define variable CalibBelt                as character no-undo initial "".
     2802       define variable DeltaOtn_K               as decimal no-undo.
     2803       define variable DeltaOtn_N               as decimal no-undo init 0.05 .
     2804       define variable ToolType1                as integer no-undo.
     2805       define variable LevelToolType1           as integer no-undo.
     2806       define variable DeltaAbs_H1              as decimal no-undo.
     2807       define variable DeltaAbs_H_Water1        as decimal no-undo.
     2808       define variable DeltaAbs_R1              as decimal no-undo.
     2809       define variable DeltaAbs_Tv1             as decimal no-undo.
     2810       define variable DeltaAbs_Tr1             as decimal no-undo.
     2811       define variable DeltaOtn_H1              as decimal no-undo.
     2812       define variable DeltaOtn_H_Water1        as decimal no-undo.
     2813       define variable DeltaOtn_R1              as decimal no-undo.
     2814       define variable ToolAutomationLevel_H1   as integer no-undo.
     2815       define variable ToolAutomationLevel_H_Water1 as integer no-undo.
     2816       define variable ToolAutomationLevel_R1   as integer no-undo.
     2817       define variable ToolAutomationLevel_Tv1  as integer no-undo.
     2818       define variable ToolAutomationLevel_Tr1  as integer no-undo.
     2819       define variable DeltaAbs_H_CalcType1     as integer no-undo.
     2820       define variable DeltaAbs_H_Water_CalcType1   as integer no-undo.
     2821       define variable ToolType2                as integer no-undo.
     2822       define variable LevelToolType2           as integer no-undo.
     2823       define variable DeltaAbs_H2              as decimal no-undo.
     2824       define variable DeltaAbs_H_Water2        as decimal no-undo.
     2825       define variable DeltaAbs_R2              as decimal no-undo.
     2826       define variable DeltaAbs_Tv2             as decimal no-undo.
     2827       define variable DeltaAbs_Tr2             as decimal no-undo.
     2828       define variable DeltaOtn_H2              as decimal no-undo.
     2829       define variable DeltaOtn_H_Water2        as decimal no-undo.
     2830       define variable DeltaOtn_R2              as decimal no-undo.
     2831       define variable ToolAutomationLevel_H2   as integer no-undo.
     2832       define variable ToolAutomationLevel_H_Water2 as integer no-undo.
     2833       define variable ToolAutomationLevel_R2   as integer no-undo.
     2834       define variable ToolAutomationLevel_Tv2  as integer no-undo.
     2835       define variable ToolAutomationLevel_Tr2  as integer no-undo.
     2836       define variable DeltaAbs_H_CalcType2     as integer no-undo.
     2837       define variable DeltaAbs_H_Water_CalcType2   as integer no-undo.
     2838       define variable v-temp-izm-vol1         as decimal no-undo .
     2839       define variable v-temp-izm-vol2         as decimal no-undo .
     2840       define variable place-SI                as integer no-undo .
     2841       define variable v-place-type            as integer no-undo .
     2842       define variable pl-rvd-dens-1           as logical no-undo .
     2843       define variable pl-rvd-lvl-1            as logical no-undo .
     2844       define variable pl-rvd-temp-1           as logical no-undo .
     2845       define variable pl-rvd-dens-2           as logical no-undo .
     2846       define variable pl-rvd-lvl-2            as logical no-undo .
     2847       define variable pl-rvd-temp-2           as logical no-undo .
     2848       define variable v-mi-lvl-1              as integer no-undo .
     2849       define variable v-mi-lvl-2              as integer no-undo .
     2850       define variable v-mi-dnst-1             as integer no-undo .
     2851       define variable v-mi-dnst-2             as integer no-undo .
     2852       define variable v-mi-tmp-1              as integer no-undo .
     2853       define variable v-mi-tmp-2              as integer no-undo .
     2854       define variable v-mi-tmp-dnst-1         as integer no-undo .
     2855       define variable v-mi-tmp-dnst-2         as integer no-undo .
     2856       define variable DeltaV1                 as decimal no-undo .
     2857       define variable DeltaV2                 as decimal no-undo .
     2858       define variable WaterDeltaV1            as decimal no-undo .
     2859       define variable WaterDeltaV2            as decimal no-undo .
     2860       define variable Tv1                     as decimal no-undo .
     2861       define variable Tr1                     as decimal no-undo .
     2862       define variable R1                      as decimal no-undo .
     2863       define variable Tv2                     as decimal no-undo .
     2864       define variable Tr2                     as decimal no-undo .
     2865       define variable R2                      as decimal no-undo .
     2866       define variable temp-for-pomi           as integer no-undo.
     2867       define variable error-string            as character no-undo.
     2868       define variable v-is-meas               as logical no-undo.
     2869       define variable v-mm-density            as decimal no-undo.
     2870       define variable v-proc as character no-undo.
     2871       define variable vAutomationDegree as integer no-undo extent 3 init [2,1,3].
     2872       define variable v-com-tanks    as character no-undo init "":U .
     2873       define variable v-pl-code-list as character no-undo init "":U .
     2874       define variable ii             as integer   no-undo .
     2875       define variable v-avg-temp     as decimal   no-undo .
     2876       define variable v-ok as logical no-undo .
     2877       define variable v-sec as character no-undo .
     2878       define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
     2879       define variable v-value as character no-undo .
     2880       define variable vErr as character no-undo .
     2881       define variable vWrn as character no-undo .
     2882       define variable vDllVersion as character no-undo .
     2883       define variable V_total1   as decimal no-undo .
     2884       define variable V_total2   as decimal no-undo .
     2885       define variable V_water1   as decimal no-undo .
     2886       define variable V_water2   as decimal no-undo .
     2887       define variable Delta_V1   as decimal no-undo .
     2888       define variable Delta_V2   as decimal no-undo .
     2889       define variable M          as decimal no-undo .
     2890       define variable DeltaOtn_M as decimal no-undo .
     2891       define variable v-warnings as character no-undo .
     2892       _trpomi :
     2893       do on error undo, return error :
     2894         infoSecObj = infoSectionTotal:GetInfoSectionProp(p-sec-num) .
     2895         v-sec = infoSecObj:SectionName .
     2896         find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     2897                                             and bf_bef_rvs-doc.out-code = p-doc-code
     2898                                             and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 3
     2899                                             and entry(2, bf_bef_rvs-doc.rvs-code, "-") = v-sec
     2900                                             no-error .
     2901         if not available bf_bef_rvs-doc
     2902         then do :
     2903           find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     2904                                               and bf_bef_rvs-doc.out-code = p-doc-code
     2905                                               and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 2
     2906                                               no-error .
     2907         end .
     2908         find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     2909                                             and bf_aft_rvs-doc.out-code = p-doc-code
     2910                                             and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 3
     2911                                             and entry(2, bf_aft_rvs-doc.rvs-code, "-") = v-sec
     2912                                             no-error .
     2913         if not available bf_aft_rvs-doc
     2914         then do :
     2915           find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     2916                                               and bf_aft_rvs-doc.out-code = p-doc-code
     2917                                               and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 2
     2918                                               no-error .
     2919         end .
     2920         if not available bf_bef_rvs-doc
     2921         or not available bf_aft_rvs-doc
     2922         then do :
     2923           if infoSecObj:AccMeth = 1
     2924           then do :
     2925             message "Не найдены сверки по документу!" view-as alert-box error .
     2926           end .
     2927           undo _trpomi, return error .
     2928         end .
     2929         find first buf_place no-lock where buf_place.obj-type = infoSectionTotal:ObjType
     2930                                        and buf_place.obj-code = infoSectionTotal:ObjCode
     2931                                        and buf_place.loc1     = infoSecObj:ListTank
     2932                                        and buf_place.status_  = ""
     2933                                        no-error .
     2934         if not available buf_place
     2935         then do :
     2936           message substitute("Не найден текущий резервуар с кодом &1!", infoSecObj:ListTank) view-as alert-box error .
     2937           undo _trpomi, return error .
     2938         end .
     2939         assign v-pl-code-list = v-pl-code-list + string(buf_place.pl-code) + "," .
     2940         v-ok = no .
     2941         find first buf_place-attr no-lock where buf_place-attr.attr-code   = "place-com-tanks"
     2942                                             and buf_place-attr.obj-code    = buf_place.obj-code
     2943                                             and buf_place-attr.obj-type    = buf_place.obj-type
     2944                                             and buf_place-attr.pl-code     = buf_place.pl-code no-error.
     2945         if available buf_place-attr then do :
     2946           v-com-tanks = buf_place-attr.attr-value .
     2947           v-ok = yes .
     2948         end.
     2949         if v-ok
     2950         and v-com-tanks > ""
     2951         then do :
     2952           do ii = 1 to num-entries(v-com-tanks) :
     2953             find first buf2_place no-lock where buf2_place.obj-type = buf_place.obj-type
     2954                                             and buf2_place.obj-code = buf_place.obj-code
     2955                                             and buf2_place.loc1     = entry(ii, v-com-tanks)
     2956                                             and buf2_place.status_  = ""
     2957                                             no-error .
     2958             if available buf2_place
     2959             then do :
     2960               assign v-pl-code-list = v-pl-code-list + string(buf2_place.pl-code) + "," .
     2961             end .
     2962           end .
     2963         end .
     2964         assign v-pl-code-list = trim(v-pl-code-list, ",") .
     2965         assign
     2966           p-tank-weight-rvs   = 0.0
     2967           p-tank-vol-pomi-rvs = 0.0
     2968         .
     2969         place_ :
     2970         do ii = 1 to num-entries(v-pl-code-list) :
     2971           find first buf_place no-lock where buf_place.pl-code = integer(entry(ii, v-pl-code-list)) no-error .
     2972           if not available buf_place
     2973           then do :
     2974             undo _trpomi, return error .
     2975           end .
     2976           assign
     2977             CalibTable = ""
     2978             CalibBelt  = ""
     2979           .
     2980           v-ok = no .
     2981           find first buf_place-attr no-lock where buf_place-attr.attr-code   = "place-type"
     2982                                               and buf_place-attr.obj-code    = buf_place.obj-code
     2983                                               and buf_place-attr.obj-type    = buf_place.obj-type
     2984                                               and buf_place-attr.pl-code     = buf_place.pl-code no-error.
     2985           if available buf_place-attr then do :
     2986             v-place-type = integer(buf_place-attr.attr-value) .
     2987             v-ok = yes .
     2988           end.
     2989           v-proc = "CMethodOfMetering7" .
     2990           if v-ok
     2991           and v-place-type = 1
     2992           then
     2993             v-proc = "CMethodOfMetering14"
     2994           .
     2995           v-ok = no .
     2996           place-si = ? .
     2997           find first buf_place-attr no-lock where buf_place-attr.attr-code   = "place-SI"
     2998                                               and buf_place-attr.obj-code    = buf_place.obj-code
     2999                                               and buf_place-attr.obj-type    = buf_place.obj-type
     3000                                               and buf_place-attr.pl-code     = buf_place.pl-code no-error.
     3001           if available buf_place-attr then do :
     3002             place-si = integer(buf_place-attr.attr-value) .
     3003             v-ok = yes .
     3004           end.
     3005           find first bf_bef_rvs-line no-lock where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     3006                                                and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     3007                                                and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     3008                                                and bf_bef_rvs-line.pl-code  = buf_place.pl-code
     3009                                                and bf_bef_rvs-line.gds-code = p-gds-code
     3010                                                no-error .
     3011           if not available bf_bef_rvs-line
     3012           then do :
     3013             if infoSecObj:AccMeth = 1
     3014             then do :
     3015               message "Не заполнена сверка До!" view-as alert-box error .
     3016             end .
     3017             undo _trpomi, return error .
     3018           end .
     3019           if bf_bef_rvs-line.state-measure-qnty = ?
     3020           or bf_bef_rvs-line.state-measure-qnty <= 0
     3021           or bf_bef_rvs-line.state-measure-cli-qnty = ?
     3022           or bf_bef_rvs-line.state-measure-cli-qnty <= 0
     3023           or bf_bef_rvs-line.state-level-total = ?
     3024           or bf_bef_rvs-line.state-level-total <= 0
     3025           or bf_bef_rvs-line.state-level-water = ?
     3026           or bf_bef_rvs-line.state-temperature = ?
     3027           then do :
     3028             if infoSecObj:AccMeth = 1
     3029             then do :
     3030               message "Не заполнена сверка До!" view-as alert-box error .
     3031             end .
     3032             undo _trpomi, return error .
     3033           end .
     3034           for first bf_rvs-line-attr no-lock where bf_rvs-line-attr.rvs-code  = bf_bef_rvs-line.rvs-code
     3035                                                and bf_rvs-line-attr.obj-code  = bf_bef_rvs-line.obj-code
     3036                                                and bf_rvs-line-attr.obj-type  = bf_bef_rvs-line.obj-type
     3037                                                and bf_rvs-line-attr.gds-code  = bf_bef_rvs-line.gds-code
     3038                                                and bf_rvs-line-attr.pl-code   = bf_bef_rvs-line.pl-code
     3039                                                and bf_rvs-line-attr.attr-code = "temp-izm-vol"
     3040           :
     3041             v-temp-izm-vol1 = decimal(bf_rvs-line-attr.attr-value) .
     3042           end .
     3043           find first bf_aft_rvs-line no-lock where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     3044                                                and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     3045                                                and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     3046                                                and bf_aft_rvs-line.pl-code  = buf_place.pl-code
     3047                                                and bf_aft_rvs-line.gds-code = p-gds-code
     3048                                                no-error .
     3049           if not available bf_aft_rvs-line
     3050           then do :
     3051             if infoSecObj:AccMeth = 1
     3052             then do :
     3053               message "Не заполнена сверка После!" view-as alert-box error .
     3054             end .
     3055             undo _trpomi, return error .
     3056           end .
     3057           if bf_aft_rvs-line.state-measure-qnty = ?
     3058           or bf_aft_rvs-line.state-measure-qnty <= 0
     3059           or bf_aft_rvs-line.state-measure-cli-qnty = ?
     3060           or bf_aft_rvs-line.state-measure-cli-qnty <= 0
     3061           or bf_aft_rvs-line.state-level-total = ?
     3062           or bf_aft_rvs-line.state-level-total <= 0
     3063           or bf_aft_rvs-line.state-level-water = ?
     3064           or bf_aft_rvs-line.state-temperature = ?
     3065           then do :
     3066             if infoSecObj:AccMeth = 1
     3067             then do :
     3068               message "Не заполнена сверка После!" view-as alert-box error .
     3069             end .
     3070             undo _trpomi, return error .
     3071           end .
     3072           if bf_bef_rvs-line.state-measure-cli-qnty = bf_aft_rvs-line.state-measure-cli-qnty
     3073           then do :
     3074             next place_ .
