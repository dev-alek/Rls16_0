      187     define private variable NLStorage as class normloss no-undo.
      188     constructor public InfoSectionsTotal (inTrnDocNum as char, inGdsCode as int, inMode as char):
      189       Mode = inMode.
      190       Initialization (inTrnDocNum, inGdsCode).
      191     end.
