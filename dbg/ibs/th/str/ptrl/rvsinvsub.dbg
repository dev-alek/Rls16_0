        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   block-level on error undo, throw.
        4   class ibs.th.str.ptrl.rvsinvsub:
        5     define property RvsCode as character no-undo
        6       get.
        7       set.
        8     define property ObjType as character no-undo
        9       get.
       10       set.
       11     define property ObjCode as integer no-undo
       12       get.
       13       set.
       14     define property PlCode as integer no-undo
       15       get.
       16       set.
       17     define property GdsCode as integer no-undo
       18       get.
       19       set.
       20     define property Diff as decimal no-undo
       21       get.
       22       set.
       23     define property MeteringErr as decimal no-undo
       24       get.
       25       set.
       26     define property NormalWastage as decimal no-undo
       27       get.
       28       set.
       29     define property TPNormalAuto as decimal no-undo
       30       get.
       31       set.
       32     define property TPNormalPl as decimal no-undo
       33       get.
       34       set.
       35     define property TPNormal as decimal no-undo
       36       get:
       37         return TPNormalAuto + TPNormalPl.
       38       end.
       39     define property MeterErrWast as decimal no-undo
       40       get.
       41       set.
       42     define property TPWast as decimal no-undo
       43       get.
       44       set.
       45     define property NaturWast as decimal no-undo
       46       get.
       47       set.
       48     define property RvsInvStrObj as class rvsinvstr no-undo
       49       get:
       50         if not valid-object ( RvsInvStrObj )
       51           then return new rvsinvstr ().
       52           else return RvsInvStrObj.
       53       end.
       54       set.
       55     define property DeficitOver as decimal no-undo
       56       get:
       57         return (absolute (Diff) - TPWast - NaturWast -  MeterErrWast) .
       58       end.
       59   end class.
