        1   using progress.lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.str.ptrl.autotrn.xmlhndler :
        4     define public property WherePhrase as character no-undo
        5       get.
        6       protected set.
        7     define public property ErrMsg as character no-undo
        8       get.
        9       protected set.
       10     define public property ErrSys as character no-undo
       11       get.
       12       protected set.
       13     define public property ErrNum as integer no-undo init 0
       14       get.
       15       protected set.
       16     define public property ErrExcuteMethodName as character no-undo
       17       get.
       18       protected set.
       19     define public property LastExcuteMethodName as character no-undo
       20       get.
       21       protected set.
       22     define public property TrnDataDS as handle no-undo
       23       get.
       24       protected set.
       25     define public property vQR as handle no-undo
       26       get.
       27       protected set.
       28     define public property vbf as handle no-undo
       29       get.
       30       protected set.
       31     define variable lretok as logical no-undo.
       32     method public void FillDataset(input inXMLFile as char):
       33       LastExcuteMethodName = "FillDataset".
       34       define variable csourcetype             as character no-undo.
       35       define variable creadmode               as character no-undo.
       36       define variable loverridedefaultmapping as logical   no-undo.
       37       define variable cfile                   as character no-undo.
       38       define variable cschemalocation         as character no-undo.
       39       define variable cfieldtypemapping       as character no-undo.
       40       define variable cverifyschemamode       as character no-undo.
       41       delete object TrnDataDS no-error.
       42       delete object vQR no-error.
       43       delete object vbf no-error.
       44       file-info:file-name = search(inXMLFile) .
       45       if file-info:file-size = 0
       46       then do :
       47         ErrMsg = SetErrMsg(LastExcuteMethodName, "Ïףסעמי פאיכ xml", 1).
       48         undo, return error.
       49       end .
       50       assign
       51         csourcetype             = "file"
       52         cfile                   =  search (inXMLFile)
       53         creadmode               = "empty"
       54         //cschemalocation         = "qr.xsd"
       55         loverridedefaultmapping = ?
       56         cfieldtypemapping       = ?
       57         cverifyschemamode       = ?.
       58       create dataset TrnDataDS.
       59       lretok = TrnDataDS:read-xml(csourcetype, cfile, creadmode, cschemalocation,
       60         loverridedefaultmapping, cfieldtypemapping, cverifyschemamode) no-error.
       61       if not lretok or error-status:error
       62       then do:
       63         ErrMsg = SetErrMsg(LastExcuteMethodName, error-status:get-message (1), 2).
       64         undo, return error.
       65       end.
       66       create query vQR.
       67       return.
       68     end method.
       69     method public logical GetFirst( inTableName as char):
       70       lretok = GetFirst(inTableName, "") no-error.
       71       if error-status:error
       72         then undo, return error.
       73       return lretok.
       74     end.
       75     method public logical GetFirst ( inTableName as char, inWherePhrase as char):
       76       LastExcuteMethodName = "GetFirstRow".
       77       WherePhrase = inWherePhrase.
       78       vbf = TrnDataDS:get-buffer-handle(inTableName).
       79       lretok = vQR:set-buffers(vbf) no-error.
       80       if not lretok
       81       then do:
       82         ErrMsg = SetErrMsg(LastExcuteMethodName, error-status:get-message (1), 1).
       83         undo, return error.
       84       end.
       85       lretok = vQR:query-prepare("for each " + inTableName + " " + WherePhrase) no-error.
       86       if not lretok
       87       then do:
       88         ErrMsg = SetErrMsg(LastExcuteMethodName, error-status:get-message (1), 2).
       89         undo, return error.
       90       end.
       91       lretok = vQR:query-open( ) no-error.
       92       if not lretok
       93       then do:
       94         ErrMsg = SetErrMsg(LastExcuteMethodName, error-status:get-message (1), 3).
       95         undo, return error.
       96       end.
       97       lretok = vQR:get-first( ) no-error.
       98       return lretok.
       99     end method.
      100     method public logical GetNext():
      101       LastExcuteMethodName = "GetNext".
      102       lretok = vQR:get-next( ) no-error.
      103       if not lretok
      104       then do:
      105         return false.
      106       end.
      107       return true.
      108     end method.
      109     method public void SetWherePhrase( inWhereFrase as char ):
      110       WherePhrase = inWhereFrase.
      111       return.
      112     end method.
      113     method protected char SetErrMsg (inMethodName as char, inErrSys as char, inErrNum as int ):
      114         return SetErrMsg (inMethodName, "", inErrSys, inErrNum).
      115     end method.
      116     method protected char SetErrMsg (inMethodName as char, inErrMsg as char, inErrSys as char, inErrNum as int ):
      117       ErrNum =  inErrNum.
      118       ErrSys = if inErrSys <> ? and inErrSys <> "" then inErrSys else "".
      119       return substitute ("Class Name: &1. Method Name: &2. Error Code: &3. &4 &5", "xmlhndler", LastExcuteMethodName, string(inErrNum), inErrMsg, inErrSys).
      120     end method.
      121   end class.
