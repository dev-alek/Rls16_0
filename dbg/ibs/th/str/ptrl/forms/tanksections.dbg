      329     @VisualDesigner.
      330     method private void tabControlCancelEvntHndl( input sender as System.Object, input e as System.Windows.Forms.TabControlCancelEventArgs ):
      331       def var ii as int no-undo.
      332       def var tabThis as TabPage no-undo.
      333       def var tbcontrol as TabControl no-undo.
      334       tbcontrol = cast(sender, tabControl).
      335       if tabControl:SelectedIndex < 0
      336         then return.
      337       if tabControl:TabPages[tabControl:SelectedIndex] = tabPageSum or tabControl:TabPages[tabControl:SelectedIndex] = tabPageAdd
      338         then return.
      339       tabThis = tabControl:TabPages[tabControl:SelectedIndex].
      340       int (tabThis:Name) no-error.
      341       if not error-status:error and not tankSectionControl[integer (tabThis:Name)]:CheckSec(yes, yes, no)
      342       then do:
      343         tankSectionControl[integer (tabThis:Name)]:SetForcus ().
      344         tbcontrol = cast(sender, tabControl).
      345         e:Cancel = true.
      346         return.
      347       end.
      348       return.
      349     end method.
      350           @VisualDesigner.
      351           method private void tool_FormClosing( input sender as System.Object, input e as System.Windows.Forms.FormClosingEventArgs ):
      352                   define variable vlog as logical no-undo .
      353                   define variable ii as integer no-undo .
      354                   define variable numsecs as character no-undo .
      355                   define variable v-sec as character no-undo .
      356                   define buffer buf_rvs-doc for ub.rvs-doc .
      357                   if infoSecsObj:Mode = "ИЗМЕНЕНИЕ" or infoSecsObj:Mode = "ДОБАВЛЕНИЕ"
      358                   then do :
      359                     if vClickSave
      360                     then do :
      361                       if not infoSecsObj:FlagTrn
      362                       then do :
      363                         numsecs = "" .
      364                         do ii = 1 to infoSecsObj:SectionNum:
      365               if infoSecsObj:GetInfoSectionProp(ii):alarm-SGDKK
      366               then do :
      367                 numsecs = numsecs + infoSecsObj:GetInfoSectionProp(ii):SectionName + chr(10) .
      368               end .
      369             end.
      370             if numsecs > ""
      371             then do :
      372               message "Для секций " skip
      373                       numsecs
      374                       "установлены флаги «Тревожное событие СЭП». По обозначенным  секциям будет активирован  комиссионный прием. Продолжить?"
      375               view-as alert-box question buttons yes-no update vlog .
      376               if not vlog
      377               then do :
      378                 e:Cancel = yes .
      379                 vClickSave = no .
      380                 infoSecsObj:WasSetting = no .
      381               end .
      382               else do :
      383                 do ii = 1 to infoSecsObj:SectionNum:
      384                   if infoSecsObj:GetInfoSectionProp(ii):alarm-SGDKK
      385                   then do :
      386                     infoSecsObj:GetInfoSectionProp(ii):IsKP = yes .
      387                   end .
      388                 end.
      389               end .
      390             end .
      391             numsecs = "" .
      392             do ii = 1 to infoSecsObj:SectionNum:
      393               if infoSecsObj:GetInfoSectionProp(ii):KPnoMeas
      394               then do :
      395                 numsecs = numsecs + infoSecsObj:GetInfoSectionProp(ii):SectionName + chr(10) .
      396               end .
      397             end.
      398             if numsecs > ""
      399             then do :
      400               message "Для секций " skip
      401                       numsecs
      402                       "установлены флаги «Переход к комиссионному приему НП без замеров секции АЦ». По обозначенным  секциям будет активирован  комиссионный прием. Продолжить?"
      403               view-as alert-box question buttons yes-no update vlog .
      404               if not vlog
      405               then do :
      406                 e:Cancel = yes .
      407                 vClickSave = no .
      408                 infoSecsObj:WasSetting = no .
      409               end .
      410               else do :
      411                 do ii = 1 to infoSecsObj:SectionNum:
      412                   if infoSecsObj:GetInfoSectionProp(ii):KPnoMeas
      413                   then do :
      414                     infoSecsObj:GetInfoSectionProp(ii):IsKP = yes .
      415                   end .
      416                 end.
      417               end .
      418             end .
      419             if infoSecsObj:Mode = "ИЗМЕНЕНИЕ" then infoSecsObj:SaveDB() .
      420                       end .
      421                     end .
      422                     else do :
      423           message "Несохранённые данные будут утеряны! Выйти без сохранения?"
      424           view-as alert-box question buttons yes-no update vlog .
      425           if not vlog
      426           then do :
      427             e:Cancel = yes .
      428           end .
      429         end .
      430       end .
      431                   return.
      432           end method.
      433     @VisualDesigner.
      434     method private void toolSBtn_Exit_Click( input sender as System.Object, input e as System.EventArgs ):
      435       vClickSave = no .
      436       this-object:Close().
      437       return.
      438     end method.
      439     @VisualDesigner.
      440     method private void toolSBtn_Ok_Click( input sender as System.Object, input e as System.EventArgs ):
      441       define variable ii as integer no-undo .
      442       define variable v-idSel as int no-undo.
      443       define variable tabsel as TabPage no-undo.
      444       tabsel = tabControl:SelectedTab.
      445       if tabsel:Name = "tabPageSum"
      446       then do :
      447         v-idSel = infoSecsObj:SectionNum .
      448       end .
      449       else do :
      450         v-idSel = integer (tabsel:Name).
      451       end .
      452       if infoSecsObj:FlagTrn
      453       then do :
      454         do ii = 1 to infoSecsObj:SectionNum:
      455           tabControl:SelectTab(ii - 1) .
      456         end .
      457         tabControl:SelectTab(v-idSel - 1) .
      458       end .
      459       do ii = 1 to infoSecsObj:SectionNum:
      460         if not tankSectionControl[ii]:CheckSec(yes, if infoSecsObj:FlagTrn then no else yes, yes)
      461         then do :
      462           tabControl:SelectTab(ii - 1) .
      463           return.
      464         end .
      465       end.
      466       do ii = 1 to infoSecsObj:SectionNum:
      467         tankSectionControl[ii]:SetInfoSec().
      468       end.
      469       infoSecsObj:WasSetting = true.
      470       vClickSave = yes .
      471       this-object:Close().
      472       return.
      473     end method.
      474     @VisualDesigner.
      475     method private void toolSBtn_Delete_Click( input sender as System.Object, input e as System.EventArgs ):
      476       define variable ii as integer no-undo .
      477       define variable v-idSel as int no-undo.
      478       define variable tabsel as TabPage no-undo.
      479       if infoSecsObj:SectionNum = 1
      480       then do:
      481         message "Нельзя удалять одну единственную секцию." view-as alert-box information title "Сообщение".
      482         return.
      483       end.
      484       tabsel = tabControl:SelectedTab.
      485       if tabsel:Name = "tabPageSum"
      486       then do :
      487         v-idSel = infoSecsObj:SectionNum .
      488       end .
      489       else do :
      490         v-idSel = integer (tabsel:Name).
      491       end .
      492       this-object:tabControl:Controls:Remove(tabPageAdd).
      493       do ii = 1 to infoSecsObj:SectionNum:
      494         if ii <> v-idSel
      495           then tankSectionControl[ii]:SetInfoSec().
      496         this-object:tabControl:Controls:Remove (this-object:tabPageArr[ii]).
      497         delete object this-object:tabPageArr[ii].
      498       end.
      499       infoSecsObj:GetInfoSectionProp(v-idSel).
      500       infoSecsObj:DeleteSection(infoSecsObj:InfoSectionCurr:idSec).
      501       SetDataControls().
      502       return.
      503     end.
      504     @VisualDesigner.
      505     method private void tabPageSum_Enter( input sender as System.Object, input e as System.EventArgs ):
      506       infoSecsObj:CalculateTotal().
      507       SetDataSum ().
      508     end.
      509     @VisualDesigner.
      510     method private void tabPageAdd_Enter( input sender as System.Object, input e as System.EventArgs ):
      511       if infoSecsObj:SectionNum >= maxSec
      512       then do:
      513         message "Максимальное количество секций - " maxSec ". Невозможно добавить секцию." view-as alert-box information title "Сообщение".
      514         tabControl:SelectedIndex = prevTabIndex.
      515         return.
      516       end.
      517       infoSecsObj:NewSection ().
      518       infoSecsObj:InfoSectionCurr:UserMode = true.
      519       this-object:tabPageArr[infoSecsObj:idSecCurr] = this-object:tabPageAdd.
      520       this-object:tabPageArr[infoSecsObj:idSecCurr]:Name = string (infoSecsObj:idSecCurr).
      521       this-object:tabPageArr[infoSecsObj:idSecCurr]:Enter:Unsubscribe(this-object:tabPageAdd_Enter).
      522       this-object:tabPageAdd = new System.Windows.Forms.TabPage().
      523       this-object:tabPageAdd:Location = new System.Drawing.Point(4, 23).
      524       this-object:tabPageAdd:Name = "tabPageAdd".
      525       this-object:tabPageAdd:Padding = new System.Windows.Forms.Padding(3).
      526       this-object:tabPageAdd:Size = new System.Drawing.Size(702, 765).
      527       this-object:tabPageAdd:TabIndex = 1.
      528       this-object:tabPageAdd:Text = "+".
      529       this-object:tabPageAdd:Enter:Subscribe(this-object:tabPageAdd_Enter).
      530       this-object:tabPageAdd:UseVisualStyleBackColor = true.
      531       this-object:tabPageArr[infoSecsObj:idSecCurr]:Text = string (infoSecsObj:InfoSectionCurr:SectionName).
      532       this-object:tankSectionControl[infoSecsObj:idSecCurr] = new tanksection(infoSecsObj, infoSecsObj:idSecCurr, this-object).
      533       this-object:tabPageArr[infoSecsObj:idSecCurr]:Controls:Add(tankSectionControl[infoSecsObj:idSecCurr]).
      534       this-object:tabControl:Controls:Add(tabPageAdd).
      535       return.
      536     end method.
      537     method public void SetSecName (arg as char):
      538       tabControl:SelectedTab:Text = arg.
      539     end.
      540     destructor public tanksections ( ):
      541       tankSectionSumControl:Dispose() .
      542       delete object tankSectionSumControl no-error .
      543     end destructor.
      544   end class.
