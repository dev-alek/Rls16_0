       63     constructor public tanksections ():
       64       super().
       65       assign
       66         screenHeight = Screen:PrimaryScreen:WorkingArea:Height
       67         formHeight = 882
       68       .
       69       infoSecsObj = new InfoSectionsTotal ().
       70       infoSecsObj:GetDBAllAttr().
       71       if infoSecsObj:SectionNum = 0
       72         then undo, throw new Progress.Lang.AppError ("Ошибка при создании формы, отсутсвуют секции по доп. инфо.").
       73       InitializeComponent().
