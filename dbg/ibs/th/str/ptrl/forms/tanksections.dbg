       50       InitializeComponent().
       51       if infoSecsObj:FlagTrn and screenHeight < (formHeight + 30) then this-object:ClientSize = new System.Drawing.Size(713, screenHeight - 40).
       52       if (infoSecsObj:Mode = "ИЗМЕНЕНИЕ" or infoSecsObj:Mode = "ДОБАВЛЕНИЕ")
