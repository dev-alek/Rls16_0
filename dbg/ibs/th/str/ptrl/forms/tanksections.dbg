       86     method private void SetDataControls():
       87       def var ii as int no-undo.
       88       define variable v-tth             as handle    no-undo .
       89       define variable par-type          as character no-undo .
       90       define variable v-value-char      as character no-undo .
       91       define variable v-value-date      as date      no-undo .
       92       define variable v-value-decimal   as decimal   no-undo .
       93       define variable v-value-integer   as integer   no-undo .
       94       define variable v-value-logical   as logical   no-undo .
       95       define variable v-rvd-own-nb      as logical   no-undo .
       96       define buffer buf_trn-doc for ub.trn-doc .
       97       if not valid-object (infoSecsObj)
       98       then do:
       99         undo, throw new Progress.Lang.AppError ("Ошибка при создании формы, передан неверный параметр, не иницализирован объект типа InfoSectionsTotal").
      100       end.
      101       run adm/shattri.p (
      102                  input "get":U
      103                 ,input  infoSecsObj:ObjType
      104                 ,input  infoSecsObj:ObjCode
      105                 ,input  'petrol':U
      106                 ,input  'rvd-own-nb':U
      107                 ,output v-value-char
      108                 ,output v-value-date
      109                 ,output v-value-decimal
      110                 ,output v-value-integer
      111                 ,output v-rvd-own-nb
      112                 ,output par-type
      113                 ,input-output table-handle v-tth
      114                 ) no-error .
      115       if error-status:error then do:
      116           if valid-object(v-tth) then delete object v-tth.
      117           v-rvd-own-nb = false .
      118       end.
      119       do ii = 1 to infoSecsObj:SectionNum:
      120         infoSecsObj:GetInfoSectionProp(ii).
      121         InitializeComponentCust().
      122         if infoSecsObj:SectionNum = 0
      123           then return.
      124         this-object:tabPageArr[infoSecsObj:idSecCurr]:Text = string (infoSecsObj:InfoSectionCurr:SectionName).
      125         tankSectionControl[infoSecsObj:idSecCurr] = new tanksection(infoSecsObj, infoSecsObj:idSecCurr, this-object).
      126         this-object:tabPageArr[infoSecsObj:idSecCurr]:Controls:Add(tankSectionControl[infoSecsObj:idSecCurr]).
      127       end.
      128       SetDataSum ().
      129       if (infoSecsObj:Mode = "ИЗМЕНЕНИЕ" or infoSecsObj:Mode = "ДОБАВЛЕНИЕ") and not infoSecsObj:FlagTrn
      130         then do:
      131           toolSBtn_Delete:Visible = true.
      132           this-object:tabControl:Controls:Add(this-object:tabPageAdd).
      133         end.
      134       if infoSecsObj:FlagTrn
      135         then this-object:tabControl:Controls:Add(this-object:tabPageSum).
      136       if (infoSecsObj:Mode = "ПРОСМОТР")
      137       then do:
      138         toolSBtn_Delete:Visible = false.
      139         toolSBtn_Ok:Visible = false.
      140       end.
      141       if v-rvd-own-nb = false
      142       then do :
      143         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = infoSecsObj:TrnDocNum no-error .
      144         if available buf_trn-doc
      145         then do :
      146           find first ub.clients-attr no-lock where ub.clients-attr.obj-type = buf_trn-doc.cli-type
      147                                                and ub.clients-attr.obj-code = buf_trn-doc.cli-code
      148                                                and ub.clients-attr.attr-code = 'owner-code':U
      149                                                no-error .
      150           if available ub.clients-attr
      151           and ub.clients-attr.attr-value > ""
      152           then do :
      153             if ub.clients-attr.attr-value = "орг" + string(buf_trn-doc.host-code)
      154             then do :
      155               toolSBtn_Delete:Visible = false.
      156               this-object:tabControl:Controls:Remove(this-object:tabPageAdd).
      157             end .
      158           end .
      159         end .
      160       end .
      161       catch e as Progress.Lang.Error:
      162         undo, throw e.
      163       end catch.
      164     end.
