     1252     method private void InitializeComponentCust(  ):
     1253       def var ii as int no-undo.
     1254       define variable v-tth             as handle    no-undo .
     1255       define variable par-type          as character no-undo .
     1256       define variable v-value-char      as character no-undo .
     1257       define variable v-value-date      as date      no-undo .
     1258       define variable v-value-decimal   as decimal   no-undo .
     1259       define variable v-value-integer   as integer   no-undo .
     1260       define variable v-value-logical   as logical   no-undo .
     1261       define variable v-field           as character no-undo .
     1262       define variable v-rvd-own-nb      as logical   no-undo .
     1263       define variable tmpInfoSecs       as class InfoSectionsTotal no-undo .
     1264       define variable v-num-sec-pl      as integer   no-undo .
     1265       define buffer buf_trn-doc for ub.trn-doc .
     1266       define buffer buf_rvs-doc for ub.rvs-doc .
     1267       run adm/shattri.p (
     1268                  input "get":U
     1269                 ,input  infoSecsObj:ObjType
     1270                 ,input  infoSecsObj:ObjCode
     1271                 ,input  'petrol':U
     1272                 ,input  'sec-fields':U
     1273                 ,output v-sec-fields
     1274                 ,output v-value-date
     1275                 ,output v-value-decimal
     1276                 ,output v-value-integer
     1277                 ,output v-value-logical
     1278                 ,output par-type
     1279                 ,input-output table-handle v-tth
     1280                 ) no-error .
     1281       if error-status:error then do:
     1282           if valid-object(v-tth) then delete object v-tth.
     1283           undo, return error return-value + error-status :get-message(1) .
     1284       end.
     1285       run adm/shattri.p (
     1286                  input "get":U
     1287                 ,input  infoSecsObj:ObjType
     1288                 ,input  infoSecsObj:ObjCode
     1289                 ,input  'petrol':U
     1290                 ,input  'rvd-own-nb':U
     1291                 ,output v-value-char
     1292                 ,output v-value-date
     1293                 ,output v-value-decimal
     1294                 ,output v-value-integer
     1295                 ,output v-rvd-own-nb
     1296                 ,output par-type
     1297                 ,input-output table-handle v-tth
     1298                 ) no-error .
     1299       if error-status:error then do:
     1300           if valid-object(v-tth) then delete object v-tth.
     1301           v-rvd-own-nb = false .
     1302       end.
     1303       define variable arrayShape as System.Object extent 4 no-undo.
     1304       do ii = 1 to 4:
     1305         arrayShape[ii] = entry (ii, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая").
     1306       end.
     1307       this-object:comboBoxShape:Items:AddRange(arrayShape).
     1308       v-tank-weight-rvs = ? .
     1309       v-tank-vol-pomi-rvs = ? .
     1310       SetControls().
     1311       assign
     1312         maskedTextBoxArr[1] = this-object:maskedTextBoxNormDoc
     1313         maskedTextBoxArr[2] = this-object:maskedTextBoxCertifFuel
     1314         maskedTextBoxArr[3] = this-object:maskedTextBoxValidityCertif
     1315         maskedTextBoxArr[4] = this-object:maskedTextBoxABTArir
     1316         maskedTextBoxArr[5] = this-object:maskedTextBoxTankDens
     1317         maskedTextBoxArr[6] = this-object:maskedTextBoxTankWater
     1318         maskedTextBoxArr[7] = this-object:maskedTextBoxTankTemp
     1319         maskedTextBoxArr[8] = this-object:maskedTextBoxDensTemp
     1320         maskedTextBoxArr[9] = this-object:maskedTextBoxCarVol
     1321         maskedTextBoxArr[10] = this-object:maskedTextBoxDiameter
     1322         maskedTextBoxArr[11] = this-object:maskedTextBoxListTank
     1323         maskedTextBoxArr[12] = this-object:maskedTextBoxPlaceSi
