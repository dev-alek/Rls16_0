      216     constructor public tanksection ( infoSecs as class InfoSectionsTotal, idSec as int, inTanksecs as class tanksections):
      217       super().
      218       tanksecsObj = inTanksecs.
      219       idSecTabPage = idSec.
      220       infoSecsObj = infoSecs.
      221       InitializeComponent().
      222       InitializeComponentCust().
      223       this-object:ComponentsCollection:ADD(this-object:components).
      224       catch e as Progress.Lang.Error:
      225         undo, throw e.
      226       end catch.
      227     end constructor.
      228           @VisualDesigner.
      229           method private void bRvsBef_MouseClick( input sender as System.Object, input e as System.Windows.Forms.MouseEventArgs ):
      230                   if infoSecsObj:Mode = 'ПРОСМОТР':U
      231       then do :
      232         ActionRvsSec
      233           ( input 'ПРОСМОТР':U
      234            ,input "edit":U
      235            ,input 'перед_док':U
      236           ) no-error .
      237         if error-status :error then do:
      238           return  .
      239         end.
      240       end .
      241       else do :
      242         bRvsBef:ContextMenu = new ContextMenu() .
      243         menuItemRvsBef1 = new System.Windows.Forms.MenuItem("Сверка резервуара") .
      244         menuItemRvsBef2 = new System.Windows.Forms.MenuItem("Просмотр") .
      245         menuItemRvsBef3 = new System.Windows.Forms.MenuItem("Редактирование") .
      246         bRvsBef:ContextMenu:MenuItems:Add(menuItemRvsBef1) .
      247         bRvsBef:ContextMenu:MenuItems:Add(menuItemRvsBef2) .
      248         bRvsBef:ContextMenu:MenuItems:Add(menuItemRvsBef3) .
      249         menuItemRvsBef1:Click:Subscribe(onClickRvsBef1) .
      250         menuItemRvsBef2:Click:Subscribe(onClickRvsBef2) .
      251         menuItemRvsBef3:Click:Subscribe(onClickRvsBef3) .
      252         bRvsBef:ContextMenu:Show(bRvsBef, new System.Drawing.Point(e:X, e:Y)) .
      253       end .
      254       return.
      255           end method.
      256           @VisualDesigner.
      257           method private void buttonCalcResultAC_Click( input sender as System.Object, input e as System.EventArgs ):
      258                   define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
      259       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
      260       if infoSecObj:TankWeight = ?
      261       or infoSecObj:TankWeight <= 0
      262       then do :
      263         if infoSecObj:AccMeth = 0
      264         then do :
      265           message 'Расчёт не выполнен. Нажмите кнопку "Рассчитать по замерам в АЦ" и повторите.' view-as alert-box .
      266         end .
      267         return no-apply .
      268       end .
      269       run str/pomi-resultAC.w (input-output infoSecObj) .
      270                   return.
      271           end method.
      272           @VisualDesigner.
      273           method private void buttonCalcResultRvs_Click( input sender as System.Object, input e as System.EventArgs ):
      274                   define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
      275       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
      276       v-tank-weight-rvs = infoSecObj:TankWeightRvs .
      277       if v-tank-weight-rvs = ?
      278       or v-tank-weight-rvs <= 0
      279       then do :
      280         if infoSecObj:AccMeth = 1
      281         then do :
      282           message 'Расчёт не выполнен. Нажмите кнопку "Рассчитать по данным сверок" и повторите.' view-as alert-box .
      283         end .
      284         else do :
      285           message 'Расчёт будет выполнен при сохранении данных по строке, при условии заполненности сверок.' view-as alert-box .
      286         end .
      287         return no-apply .
      288       end .
      289       run str/pomi-result.w (input-output infoSecObj) .
      290                   return.
      291           end method.
      292           @VisualDesigner.
      293           method private void buttonCalcWeightRvs_Click( input sender as System.Object, input e as System.EventArgs ):
      294                   define variable v-new-sec-fact-qnty-kg as decimal no-undo .
      295       define variable v-calc-density as decimal no-undo .
      296       define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
      297                   infoSecsObj:CalcPomiRvs(input idSecTabPage,
      298                                           input infoSecsObj:TrnDocNum,
      299                                           input infoSecsObj:GdsCode,
      300                                           input-output infoSecsObj,
      301                                           output v-tank-weight-rvs,
      302                                           output v-tank-vol-pomi-rvs) .
      303                   v-calc-density = v-tank-weight-rvs / v-tank-vol-pomi-rvs .
      304                   if v-calc-density = ?
      305       or v-calc-density <= 0
      306       or v-calc-density >= 1
      307       then do :
      308         message substitute("По результатам расчёта модуля ПОкМИ плотность выходит за допустимые значения!&1Масса, кг: &2&1Объём, л: &3", chr(10), v-tank-weight-rvs, v-tank-vol-pomi-rvs)
      309         view-as alert-box error .
      310         return .
      311       end .
      312       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
      313       infoSecsObj:RNAlgo (integer(infoSecObj:SectionName), output v-new-sec-fact-qnty-kg).
      314       if infoSecObj:IsKP
      315       then do :
      316         label51:Visible = true .
      317       end .
      318       infoSecObj:FactQnty = v-new-sec-fact-qnty-kg / v-calc-density .
      319       infoSecObj:FactDensity = v-calc-density .
      320       infoSecsObj:SaveDB() .
      321       infoSecsObj:GetDBAllAttr() .
      322                   return.
      323           end method.
      324           @VisualDesigner.
      325           method private void cbKPnoMeas_CheckedChanged( input sender as System.Object, input e as System.EventArgs ):
      326                   define variable v-log as logical no-undo .
      327                   if cbKPnoMeas:Checked
      328       then do :
      329         message "При установке флага «Переход к комиссионному приему НП без замеров секции АЦ» будет активирован комиссионный прием. Продолжить?"
      330         view-as alert-box question buttons yes-no update v-log .
      331         if not v-log
      332         then do :
      333           cbKPnoMeas:checked = no .
      334         end .
      335       end .
      336                   return.
      337           end method.
      338           @VisualDesigner.
      339           method private void maskedTextBoxAukKey_Leave( input sender as System.Object, input e as System.EventArgs ):
      340                   def var ii as int no-undo.
      341       do ii = 1 to extent (tanksecsObj:tankSectionControl):
      342         if not valid-object (tanksecsObj:tankSectionControl[ii]) or tanksecsObj:tankSectionControl[ii]:idSecTabPage = this-object:idSecTabPage
      343           then next.
      344         tanksecsObj:tankSectionControl[ii]:GetAukKey(maskedTextBoxAukKey:Text, cbSGDKK:Checked).
      345       end.
      346                   return.
      347           end method.
      348           @VisualDesigner.
      349     method private void maskedTextBoxDensTemp_Leave( input sender as System.Object, input e as System.EventArgs ):
      350       define variable v-dec as decimal no-undo init ? .
      351       v-dec = decimal(maskedTextBoxDensTemp:Text) no-error .
      352       if v-dec <> ?
      353       then do :
      354         if v-dec < -40.0
      355         or v-dec > 90.0
      356         then do :
      357           message "Температура должна находиться в диапазоне от -40°С до 90°С" view-as alert-box .
      358           maskedTextBoxDensTemp:Text = "0.0" .
      359         end .
      360       end .
      361       return.
      362     end method.
      363     @VisualDesigner.
      364     method private void maskedTextBoxTankTemp_Leave( input sender as System.Object, input e as System.EventArgs ):
      365       define variable v-dec as decimal no-undo init ? .
      366       v-dec = decimal(maskedTextBoxTankTemp:Text) no-error .
      367       if v-dec <> ?
      368       then do :
      369         if v-dec < -40.0
      370         or v-dec > 90.0
      371         then do :
      372           message "Температура должна находиться в диапазоне от -40°С до 90°С" view-as alert-box .
      373           maskedTextBoxTankTemp:Text = "0.0" .
      374         end .
      375       end .
      376       return.
      377     end method.
      378     @VisualDesigner.
      379     method private void onClickRvsBef1 ( input sender as System.Object, input e as System.EventArgs ) :
      380       define variable v-sec as character no-undo .
      381       define variable infoSecObj as class InfoSection no-undo .
      382       define buffer buf_rvs-doc for ub.rvs-doc .
      383       define buffer buf_trn-doc for ub.trn-doc .
      384       define buffer buf_doc-pl for ub.doc-pl .
      385       define buffer buf_pl-gds-pump for ub.pl-gds-pump .
      386       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
      387       if infoSecsObj:GetInfoSectionProp(idSecTabPage):isKP
      388       and not infoSecsObj:IsActnComm
      389       then do :
      390         message "Для секции " + infoSecsObj:GetInfoSectionProp(idSecTabPage):SectionName + " установлен флаг комиссионного приема. Работа с сверкой запрещена!"
      391         view-as alert-box .
      392         return .
      393       end .
      394       assign rvslog = no .
      395       v-sec = infoSecsObj:GetInfoSectionProp(idSecTabPage):SectionName .
      396       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = infoSecsObj:TrnDocNum .
      397       find first buf_rvs-doc
      398           where buf_rvs-doc.rvs-type = 'перед_док':U
      399           and buf_rvs-doc.out-code = infoSecsObj:TrnDocNum
      400           and num-entries(buf_rvs-doc.rvs-code, "-") = 3
      401           and entry(2, buf_rvs-doc.rvs-code, "-") = v-sec
      402           and buf_rvs-doc.state-measure-qnty <> ?
      403       no-error .
      404       if available buf_rvs-doc then
      405       do:
      406         if not chk-asi-polling (yes)
      407           then return no-apply .
      408         message
      409             "Сверка до уже выполнена. Вы уверены, что хотите ее изменить?"  skip
      410             view-as alert-box question buttons yes-no update rvslog.
      411         if not rvslog then
      412           return no-apply .
      413       end.
      414       if infoSecsObj:petrol_block-nozzle
      415       then do :
      416         list-pl = "" .
      417         for each buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
      418                                       and buf_doc-pl.obj-code = buf_trn-doc.obj-code
      419                                       and buf_doc-pl.out-code = buf_trn-doc.doc-code
      420                                       and buf_doc-pl.gds-code = infoSecsObj:GdsCode,
      421         each buf_pl-gds-pump no-lock where buf_pl-gds-pump.gds-code = infoSecsObj:GdsCode
      422                                        and buf_pl-gds-pump.obj-code = buf_doc-pl.obj-code
      423                                        and buf_pl-gds-pump.obj-type = buf_doc-pl.obj-type
      424                                        and buf_pl-gds-pump.pl-code = buf_doc-pl.pl-code,
      425         each buf_pl-pump-nozzle no-lock where buf_pl-pump-nozzle.obj-code = buf_pl-gds-pump.obj-code
      426                                           and buf_pl-pump-nozzle.obj-type = buf_pl-gds-pump.obj-type
      427                                           and buf_pl-pump-nozzle.pl-code = buf_pl-gds-pump.pl-code
      428                                           and buf_pl-pump-nozzle.pump-code = buf_pl-gds-pump.pump-code
      429         :
      430           list-pl = substitute("&1&2&3:&4:&5", list-pl,
      431                    if list-pl = "" then "" else ";",
      432                    buf_pl-pump-nozzle.nozzle-code,
      433                    buf_pl-pump-nozzle.pump-code,
      434                    buf_pl-pump-nozzle.pl-code).
      435         end.
      436         run str/diallog.w ( input infoSecsObj:parentproc
      437                             ,input infoSecsObj:in-line-handle
      438                             ,input 'str/get-block-nozzle.p':U
      439                             ,input (buf_trn-doc.obj-type + chr(4) +
      440                             string(buf_trn-doc.obj-code) + chr(4) +
      441                             string(0) + chr(4) +
      442                             string(0) + chr(4) +
      443                             chr(4) +
      444                             chr(4) +
      445                             chr(4) +
      446                             substitute("&1,&2"
      447                             ,"block"
      448                             ,list-pl))
      449                             ,input yes
      450                             ,input ''
      451                             ,input 'Блокировка пистолетов') .
      452          if error-status :error then
      453          do:
      454            return no-apply .
      455          end.
      456          if return-value begins "Для кассы" then
      457          do:
      458            message return-value
      459               view-as alert-box question buttons yes-no update v-ok as logical  .
      460            if v-ok then run block-nozzle .
      461            else message "Сообщите в службу поддержки о неуспешной попытке блокировки пистолетов"
      462                  view-as alert-box.
      463          end.
      464          else
      465          do:
      466            message "Блокировка пистолетов прошла успешно"
      467               view-as alert-box.
      468          end.
      469       end .
      470       ActionRvsSec
      471          ( input 'ИЗМЕНЕНИЕ':U
      472           ,input "meas":U
      473           ,input 'перед_док':U
      474           ) no-error .
      475       if error-status :error then
      476       do:
      477         return no-apply .
      478       end.
      479       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
      480       groupBox5:Enabled               = yes .
      481       dateTimePickerDateStart:Enabled = yes .
      482       dateTimePickerDateStart:Checked = yes .
      483       dateTimePickerDateStart:Focus() .
      484       dateTimePickerDateStart:Text      = string (infoSecObj:DateStart) no-error.
      485       if error-status:error or infoSecObj:DateStart = ?
      486         then
      487       do:
      488         blank_datetime (dateTimePickerDateStart).
      489       end.
      490       dateTimePickerDateStart:Show() .
      491       dateTimePickerDateStart:Enabled = no .
      492       dateTimePickerTimeStart:Enabled = yes .
      493       dateTimePickerTimeStart:Checked = yes .
      494       dateTimePickerTimeStart:visible = yes .
      495       dateTimePickerTimeStart:Focus() .
      496       dateTimePickerTimeStart:Text      = GetTimeStr(infoSecObj:TimeStart) no-error.
      497       if error-status:error or infoSecObj:TimeStart = ? or infoSecObj:TimeStart = 0
      498         then
      499       do:
      500         blank_datetime (dateTimePickerTimeStart).
      501       end.
      502       dateTimePickerTimeStart:Enabled = no .
      503       groupBox5:Enabled               = no .
      504       infoSecObj:TankWeightRvs = ? .
      505     end method .
