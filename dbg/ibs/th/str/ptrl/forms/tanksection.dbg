      626     @VisualDesigner.
      627     method private void bRvsAft_MouseClick( input sender as System.Object, input e as System.Windows.Forms.MouseEventArgs ):
      628       if infoSecsObj:Mode = 'ПРОСМОТР':U
      629       then do :
      630         ActionRvsSec
      631           ( input 'ПРОСМОТР':U
      632            ,input "edit":U
      633            ,input 'после_док':U
      634           ) no-error .
      635         if error-status :error then do:
      636           return  .
      637         end.
      638       end .
      639       else do :
      640         bRvsAft:ContextMenu = new ContextMenu() .
      641         menuItemRvsAft1 = new System.Windows.Forms.MenuItem("Сверка резервуара") .
      642         menuItemRvsAft2 = new System.Windows.Forms.MenuItem("Просмотр") .
      643         menuItemRvsAft3 = new System.Windows.Forms.MenuItem("Редактирование") .
      644         bRvsAft:ContextMenu:MenuItems:Add(menuItemRvsAft1) .
      645         bRvsAft:ContextMenu:MenuItems:Add(menuItemRvsAft2) .
      646         bRvsAft:ContextMenu:MenuItems:Add(menuItemRvsAft3) .
      647         menuItemRvsAft1:Click:Subscribe(onClickRvsAft1) .
      648         menuItemRvsAft2:Click:Subscribe(onClickRvsAft2) .
      649         menuItemRvsAft3:Click:Subscribe(onClickRvsAft3) .
      650         bRvsAft:ContextMenu:Show(bRvsAft, new System.Drawing.Point(e:X, e:Y)) .
      651       end .
      652       return.
      653     end method.
      654     @VisualDesigner.
      655     method private void onClickRvsAft1 ( input sender as System.Object, input e as System.EventArgs ) :
      656       define variable infoSecObj as class InfoSection no-undo .
