     3014     @VisualDesigner.
     3015     method private void maskedTextBoxPlaceSiHndler( input sender as System.Object, input e as System.EventArgs ):
     3016       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3017       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3018       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3019       infoSecsObj:InfoSectionCurr:PlaceSi = integer (v-maskTextBox:Text).
     3020       textBoxPlSiName:Text = infoSecsObj:InfoSectionCurr:PlSiName.
     3021       v-maskTextBox:Text = string(infoSecsObj:InfoSectionCurr:PlaceSi). .
     3022       find first ub.sr-izmerenia no-lock where ub.sr-izmerenia.node-code = integer (v-maskTextBox:Text) no-error.
     3023       if available (ub.sr-izmerenia)
     3024       and (ub.sr-izmerenia.sr-temperature)
     3025       and (textBoxPlSiNameTemp:text = "0" or textBoxPlSiNameTemp:text = "")
     3026       then do:
     3027         infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3028         maskedTextBoxPlaceSiTemp:Text = v-maskTextBox:Text.
     3029         infoSecsObj:InfoSectionCurr:PlaceSiTemp = integer (v-maskTextBox:Text).
     3030         textBoxPlSiNameTemp:Text = infoSecsObj:InfoSectionCurr:PlSiNameTemp.
     3031         v-maskTextBox:Text = string(infoSecsObj:InfoSectionCurr:PlaceSiTemp).
     3032       end.
     3033       return.
     3034     end method.
     3035           @VisualDesigner.
     3036           method private void maskedTextBoxPlaceSiTemp_Leave( input sender as System.Object, input e as System.EventArgs ):
     3037       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3038       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3039       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3040       infoSecsObj:InfoSectionCurr:PlaceSiTemp = integer (v-maskTextBox:Text).
     3041       textBoxPlSiNameTemp:Text = infoSecsObj:InfoSectionCurr:PlSiNameTemp.
     3042       v-maskTextBox:Text = string(infoSecsObj:InfoSectionCurr:PlaceSiTemp). .
     3043       find first ub.sr-izmerenia no-lock where ub.sr-izmerenia.node-code = integer (v-maskTextBox:Text) no-error.
     3044       if available (ub.sr-izmerenia)
     3045       and (ub.sr-izmerenia.sr-density)
     3046       and (textBoxPlSiName:text = "0" or textBoxPlSiName:text = "")
     3047       then do:
     3048         infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3049         maskedTextBoxPlaceSi:Text = v-maskTextBox:Text.
     3050         infoSecsObj:InfoSectionCurr:PlaceSi = integer (v-maskTextBox:Text).
     3051         textBoxPlSiName:Text = infoSecsObj:InfoSectionCurr:PlSiName.
     3052         v-maskTextBox:Text = string(infoSecsObj:InfoSectionCurr:PlaceSi).
     3053       end.
     3054       return.
     3055           end method.
     3056     @VisualDesigner.
     3057     method private void maskedTextBoxSecName_Leave( input sender as System.Object, input e as System.EventArgs ):
     3058       define variable ii as integer no-undo.
     3059       define variable v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3060       define buffer buf_auto-section for ub.auto-section .
     3061       define buffer sec_auto-section for ub.auto-section .
     3062       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3063       v-maskTextBox:Text = left-trim (v-maskTextBox:Text, "0").
     3064       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3065       infoSecsObj:InfoSectionCurr:UserMode = true.
     3066       infoSecsObj:InfoSectionCurr:SectionName = maskedTextBoxSecName:Text.
     3067       if not infoSecsObj:CheckNameSec(idSecTabPage, v-maskTextBox:Text)
     3068       then do:
     3069         message "Такой номер уже есть." view-as alert-box title "Сообщение".
     3070         v-maskTextBox:Text = "".
     3071         v-maskTextBox:Focus().
     3072         return.
     3073       end.
     3074       find first buf_auto-section no-lock where buf_auto-section.auto-num = infoSecsObj:InfoSectionCurr:infoSectionTotal:CarNum no-error .
     3075       find first sec_auto-section no-lock where sec_auto-section.auto-num = infoSecsObj:InfoSectionCurr:infoSectionTotal:CarNum
     3076                                             and sec_auto-section.section-num = integer(v-maskTextBox:Text)
     3077                                             no-error .
     3078       if available sec_auto-section
     3079       then do :
     3080         infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3081         infoSecsObj:InfoSectionCurr:SetCarVol(maskedTextBoxSecName:Text).
     3082         comboBoxShape:Text = infoSecsObj:InfoSectionCurr:Shape.
     3083         maskedTextBoxDiameter:Text = infoSecsObj:InfoSectionCurr:Diameter.
     3084         maskedTextBoxCarVol:Enabled = false.
     3085         comboBoxShape:Enabled = false.
     3086         maskedTextBoxSecName:Enabled = false.
     3087         maskedTextBoxCarVol:Text = format_round_3(infoSecsObj:InfoSectionCurr:CarVol).
     3088       end .
     3089       else do :
     3090         if available buf_auto-section
     3091         and v-maskTextBox:Text > ""
     3092         then do :
     3093           message ("В АЦ с номером " + infoSecsObj:InfoSectionCurr:infoSectionTotal:CarNum + " не найдена секция " + v-maskTextBox:Text) view-as alert-box title "Сообщение".
     3094           v-maskTextBox:Text = "".
     3095           v-maskTextBox:Focus().
     3096           return .
     3097         end .
     3098       end .
     3099       tanksecsObj:SetSecName (v-maskTextBox:Text).
     3100       return.
     3101     end method.
