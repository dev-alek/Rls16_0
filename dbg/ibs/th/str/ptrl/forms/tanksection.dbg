      859             ,input 'Разблокировка выбранных пистолетов') .
      860         if not error-status:error then
      861         do:
      862           if return-value begins "Для кассы" then
      863           do:
      864              message return-value
      865                 view-as alert-box question buttons yes-no update v-ok as logical  .
      866              if v-ok then run unblock-nozzle .
      867              else message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
      868                    view-as alert-box.
      869           end.
      870           else
      871           do:
      872              message if return-value begins "Ошибка" then return-value else "Разблокировка пистолетов прошла успешно"
      873                view-as alert-box.
      874           end.
      875         end.
      876         else
      877         do:
      878           return no-apply .
      879         end.
      880       end .
      881     end method .
      882           @VisualDesigner.
      883           method private void button1_Click( input sender as System.Object, input e as System.EventArgs ):
      884       define variable ii as integer no-undo.
      885       define variable v-section as character no-undo.
      886       define variable v-mode as character no-undo.
      887       define variable varauto-tank-par as character no-undo.
      888       define variable inum-ComboBoxShape as integer no-undo.
      889       if ComboBoxShape:Text = ""
      890       then do:
      891         message
      892           "Вначале задайте тип горловины."  skip
      893         view-as alert-box error.
      894         undo, return no-apply.
      895       end.
      896       varauto-tank-par = replace(maskedTextBoxDiameter:Text, "/", chr(4)).
      897       if (infoSecsObj:Mode = 'ИЗМЕНЕНИЕ':U or infoSecsObj:Mode = 'ДОБАВЛЕНИЕ':U)
      898       and (not infoSecsObj:FlagTrn or (infoSecsObj:FlagTrn and infoSecsObj:IsSGDKK and infoSecsObj:IsKP and not infoSecsObj:IsKPrvs))
      899       and maskedTextBoxCarVol:Enabled = true
      900       then v-mode = 'ИЗМЕНЕНИЕ':U.
      901       else v-mode = 'ПРОСМОТР':U.
      902       inum-ComboBoxShape = lookup (comboBoxShape:Text, var-list-shape, ",") - 1.
      903       run str/autotncs.w
      904         ( input        v-mode
      905          ,input-output varauto-tank-par
      906          ,input        1
      907          ,input        decimal (maskedTextBoxCarVol:Text)
      908          ,input        inum-ComboBoxShape
      909          ,input        integer (maskedTextBoxSecName:Text)
      910         ) no-error.
      911       if integer (ComboBoxShape) = 0
      912       then do:
      913         v-dop-volume = decimal(entry(1, varauto-tank-par, chr(4)) ) no-error.
      914         create tt-section .
      915         tt-section.dif     = 0 .
      916         tt-section.volume1 = 0 .
      917         do ii = 2 to num-entries (varauto-tank-par,chr(4)):
      918             v-section = entry(ii, varauto-tank-par, chr(4)) .
      919             create tt-section .
      920             tt-section.dif     = integer(entry (1,v-section,chr(6))) no-error .
      921             tt-section.volume1 = decimal(entry (2,v-section,chr(6))) no-error .
      922         end.
      923       end.
      924       maskedTextBoxDiameter:Text = replace(varauto-tank-par,chr(4), "/").
      925                   return.
      926           end method.
