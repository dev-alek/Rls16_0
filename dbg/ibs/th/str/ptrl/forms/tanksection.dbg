     1084     method private void buttonCalcWeight_Click( input sender as System.Object, input e as System.EventArgs ):
     1085       define variable v-new-sec-fact-qnty-kg as decimal no-undo .
     1086       define variable v-calc-density as decimal no-undo .
     1087       define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
     1088       SetInfoSec ().
     1089       if not CheckSec(no, yes, no)
     1090       then do:
     1091         SetForcus().
     1092         return.
     1093       end.
     1094       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage).
     1095       infoSecsObj:CalcWeight().
     1096       v-calc-density = infoSecObj:TankDensityPomi .
     1097       if v-calc-density = ?
     1098       or v-calc-density <= 0
     1099       or v-calc-density >= 1
     1100       then do :
     1101         message "По результатам расчёта модуля ПОкМИ плотность выходит за допустимые значения!"
     1102         view-as alert-box error .
     1103         return .
     1104       end .
     1105       infoSecsObj:RNAlgo (integer(infoSecObj:SectionName), output v-new-sec-fact-qnty-kg).
     1106       if infoSecObj:IsKP
     1107       then do :
     1108         label51:Visible = true .
     1109       end .
     1110       infoSecObj:FactQnty = v-new-sec-fact-qnty-kg / v-calc-density .
     1111       infoSecObj:FactDensity = v-calc-density .
     1112       infoSecsObj:SaveDB() .
     1113       infoSecsObj:GetDBAllAttr() .
     1114       SetControls ().
     1115       return.
     1116     end method.
