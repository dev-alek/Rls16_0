     3262     @VisualDesigner.
     3263     method private void KeyPressMaskTBDecimal( input sender as System.Object, input e as System.Windows.Forms.KeyPressEventArgs, maxLenthInt as int, maxLenthFractional as int ):
     3264       def var v-asc as int no-undo.
     3265       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3266       def var startcursor as int no-undo.
     3267       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3268       startcursor = v-maskTextBox:SelectionStart.
     3269       e:Handled = true.
     3270       e:Handled = not isSpecKey(e:KeyChar).
     3271       if not e:Handled
     3272         then return.
     3273       if asc (e:KeyChar) = 46
     3274       then do:
     3275         e:Handled = not isOnePoint(v-maskTextBox:Text).
     3276         if not e:Handled
     3277           then do:
     3278             return.
     3279           end.
     3280         v-maskTextBox:SelectionStart = index (v-maskTextBox:Text, ".").
     3281         return.
     3282       end.
     3283       if isNumeral(e:KeyChar)
     3284       then do:
     3285         e:Handled = false.
     3286         if not e:Handled
     3287         then do:
     3288           if startcursor = 0 and v-maskTextBox:Text begins "0"
     3289           then do:
     3290             v-maskTextBox:Text = substring (v-maskTextBox:Text, 2, length (v-maskTextBox:Text) - 1 ).
     3291             v-maskTextBox:SelectionStart = 0.
     3292             return.
     3293           end.
     3294           if startcursor <> 0 and startcursor = index (v-maskTextBox:Text, ".") - 1
     3295             then startcursor = startcursor + 1.
     3296           if (length (entry (1, v-maskTextBox:Text, ".")) < maxLenthInt or startcursor < index (v-maskTextBox:Text, ".") ) and (index (v-maskTextBox:Text, ".") = 0 or startcursor <= index (v-maskTextBox:Text, ".") or startcursor = 0)
     3297           then do:
     3298             if length (entry (1, v-maskTextBox:Text, ".")) < maxLenthInt
     3299             then do :
     3300               if num-entries(v-maskTextBox:Text, ".") = 2
     3301               and length (entry (2, v-maskTextBox:Text, ".")) = maxLenthFractional
     3302               and startcursor >= index (v-maskTextBox:Text, ".")
     3303               then do :
     3304                 v-maskTextBox:Text = substring (v-maskTextBox:Text, 1, length (v-maskTextBox:Text) - 1 ) + e:KeyChar .
     3305                 e:KeyChar = "" .
     3306                 v-maskTextBox:SelectionStart = startcursor .
     3307               end .
     3308               return.
     3309             end .
     3310             v-maskTextBox:Text = this-object:ValueChgToInt (v-maskTextBox:Text, maxLenthInt, input-output startcursor).
     3311           end.
     3312           else do:
     3313             if index (v-maskTextBox:Text, ".") = 0
     3314             then do:
     3315               v-maskTextBox:Text = v-maskTextBox:Text + '.'.
     3316               startcursor = startcursor + 1.
     3317             end.
     3318             if startcursor < index (v-maskTextBox:Text, ".")
     3319               then do:
     3320                 v-maskTextBox:SelectionStart = index (v-maskTextBox:Text, ".").
     3321                 startcursor = v-maskTextBox:SelectionStart.
     3322               end.
     3323             v-maskTextBox:Text = this-object:ValueChgToFractional (v-maskTextBox:Text, maxLenthFractional, input-output startcursor).
     3324           end.
     3325         end.
     3326         v-maskTextBox:SelectionStart = startcursor.
     3327       end.
     3328     end.
     3329     @VisualDesigner.
     3330     method private logical isSpecKey ( input arg as char):
     3331       def var v-asc as int no-undo.
     3332       v-asc = asc(arg).
     3333       if lookup (string (v-asc), "13,8") = 0
     3334       then do:
     3335         return false.
     3336       end.
     3337       return true.
     3338     end.
     3339     @VisualDesigner.
     3340     method private logical isOnePoint (input tBoxText as char):
     3341       if index (tBoxText, ".") > 0
     3342         then do:
     3343           return false.
     3344         end.
     3345       return true.
     3346     end.
     3347     @VisualDesigner.
     3348     method private logical isNumeral ( input arg as char):
     3349       if not ( asc (arg) >= 48 and asc (arg) <= 57)
     3350       then do:
     3351         return false.
     3352       end.
     3353       return true.
     3354     end.
     3355     @VisualDesigner.
     3356     method private char ValueChgToInt( input arg as char, maxLenthInt as int, input-output pStartcursor as int ):
     3357       def var v-str as char extent 2 no-undo.
     3358       def var v-cursor as int no-undo.
     3359       v-cursor = pStartcursor.
     3360       v-str[1] = entry (1, arg, ".").
     3361       if num-entries (arg, ".") = 2
     3362       then do:
     3363         v-str[2] = entry (2, arg, ".").
     3364       end.
     3365       if length (v-str[1]) > maxLenthInt - 1
     3366       then do:
     3367         v-str[1] = substring (v-str[1], 1, length (v-str[1]) - 1 ).
     3368         v-cursor = v-cursor - 1.
     3369         return v-str[1] + "." + v-str[2].
     3370       end.
     3371       pStartcursor = v-cursor.
     3372       return arg.
     3373     end.
     3374     @VisualDesigner.
     3375     method private char ValueChgToFractional( input arg as char, maxLenthFractional as int, input-output pStartcursor as int  ):
     3376       def var v-str as char extent 2 no-undo.
     3377       def var v-cursor as int no-undo.
     3378       v-cursor = pStartcursor.
     3379       v-str[1] = entry (1, arg, ".").
     3380       if num-entries (arg, ".") = 2
     3381       then do:
     3382         v-str[2] = entry (2, arg, ".").
     3383       end.
     3384       if length (v-str[2]) > maxLenthFractional - 1
     3385       then do:
     3386         v-str[2] = substring (v-str[2], 1, length (v-str[2]) - 1 ).
     3387         v-cursor = v-cursor - 1.
     3388         return v-str[1] + "." + v-str[2].
     3389       end.
     3390       pStartcursor = v-cursor.
     3391       return arg.
     3392     end.
     3393     method private void ValueChgMaskTBox( input sender as System.Object, input e as System.EventArgs ):
     3394       def var v-asc as int no-undo.
     3395       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3396       def var v-str as char extent 2 no-undo.
     3397       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3398       v-str[1] = entry (1, v-maskTextBox:Text, ".").
     3399       if num-entries (v-maskTextBox:Text, ".") = 2
     3400       then do:
     3401         v-str[2] = entry (2, v-maskTextBox:Text, ".").
     3402       end.
     3403       if length (v-str[1]) > 10
     3404       then do:
     3405         v-str[1] = substring (v-str[1], 1, length (v-str[1]) - 1 ).
     3406       end.
     3407       if length (v-str[2]) > 3
     3408       then do:
     3409         v-str[2] = substring (v-str[2], 1, length (v-str[2]) - 1 ).
     3410       end.
     3411       v-maskTextBox:Text = v-str[1] + "." + v-str[2].
     3412       return.
     3413     end method.
     3414     method private void SetControls ():
     3415       def var infoSecObj as class InfoSection no-undo.
     3416       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3417       infoSecObj:UserMode = true.
     3418       this-object:maskedTextBoxSecName:Text         = infoSecObj:SectionName.
     3419       this-object:maskedTextBoxCarVol:Text          = format_round_0 (infoSecObj:CarVol).
     3420       this-object:maskedTextBoxDocDens:Text         = format_dens (infoSecObj:DocDensity).
     3421       v-doc-density = infoSecObj:DocDensity no-error .
     3422       this-object:maskedTextBoxDocDensST:Text       = format_dens (infoSecObj:DocDensST).
     3423       this-object:maskedTextBoxPaspDens:Text        = format_dens (infoSecObj:PaspDens).
     3424       this-object:maskedTextBoxPressure:Text        = if infoSecObj:Pressure = 0 or infoSecObj:Pressure = ? then "0." else format_pressure (infoSecObj:Pressure).
     3425       this-object:maskedTextBoxDocQnty:Text         = format_round_0 (infoSecObj:DocQnty).
     3426       this-object:maskedTextBoxDocVolume:Text       = format_round_0 (infoSecObj:DocVolume).
     3427       v-doc-qnty = infoSecObj:DocQnty no-error .
     3428       this-object:maskedTextBoxTTNTemp:Text         = if infoSecObj:TTNTemp = ? then "" else format_temper (infoSecObj:TTNTemp).
     3429       this-object:maskedTextBoxAccShip:Text         = format_round_3 (if infoSecObj:AccShip > 0 then infoSecObj:AccShip else 0.25).
     3430       this-object:maskedTextBoxDiameter:Text        = (infoSecObj:Diameter).
     3431       this-object:maskedTextBoxCliQnty:Text         = format_round_1 (infoSecObj:CliQnty).
     3432       v-cli-qnty = infoSecObj:CliQnty no-error .
