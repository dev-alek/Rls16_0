     3208           end.
     3209       end.
     3210       else do:
     3211         if index (v-maskTextBox:Text, "-") > 0
     3212         then do:
     3213           v-maskTextBox:Text = replace (v-maskTextBox:Text, "-", "").
     3214           v-maskTextBox:SelectionStart = startcursor - 1.
     3215           KeyPressMaskTBInt(sender, e, maxLenthInt).
     3216           startcursor = v-maskTextBox:SelectionStart.
     3217           v-maskTextBox:Text = "-" + v-maskTextBox:Text.
     3218           v-maskTextBox:SelectionStart = startcursor + 1.
     3219         end.
     3220         else do:
     3221           KeyPressMaskTBInt(sender, e, maxLenthInt).
     3222         end.
     3223       end.
     3224     end.
