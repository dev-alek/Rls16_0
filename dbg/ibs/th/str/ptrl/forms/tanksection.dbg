     3197       then do:
     3198         if index (v-maskTextBox:Text, "-") > 0
     3199           then do:
     3200             v-maskTextBox:Text = replace (v-maskTextBox:Text, "-", "").
     3201             v-maskTextBox:SelectionStart = startcursor - 1.
     3202             e:Handled = true.
     3203           end.
     3204           else do:
     3205             v-maskTextBox:Text = "-" + v-maskTextBox:Text.
     3206             v-maskTextBox:SelectionStart = startcursor + 1.
