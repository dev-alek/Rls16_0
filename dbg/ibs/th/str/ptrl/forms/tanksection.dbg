     3504         blank_datetime (dateTimePickerTimeStart).
     3505       end.
     3506       this-object:dateTimePickerTimeEnd:Text        = GetTimeStr(infoSecObj:TimeEnd) no-error.
     3507       if error-status:error or infoSecObj:TimeEnd = ? or infoSecObj:TimeEnd = 0
     3508         then
     3509       do:
     3510         blank_datetime (dateTimePickerTimeEnd).
     3511       end.
     3512       this-object:DateTimeDateProb:Text             = string (infoSecObj:DateProb) no-error.
     3513       if error-status:error or infoSecObj:DateProb = ?
     3514         then
     3515       do:
     3516         blank_datetime (DateTimeDateProb).
     3517       end.
     3518       infoSecObj:FillTTSection(infoSecObj:Diameter).
     3519       if ((infoSecsObj:Mode = "ДОБАВЛЕНИЕ" or infoSecsObj:Mode = "ИЗМЕНЕНИЕ")
     3520         and (maskedTextBoxListTank:Text = ""))
     3521       then do:
     3522         def var v-bool as log no-undo.
     3523         def buffer buf_pl-gds for ub.pl-gds.
     3524         v-bool = false.
     3525         for each buf_pl-gds no-lock where buf_pl-gds.obj-type = infoSecsObj:ObjType
     3526                                       and buf_pl-gds.obj-code = infoSecsObj:ObjCode
     3527                                       and buf_pl-gds.gds-code = infoSecsObj:GdsCode
     3528                                       :
     3529           if v-bool
     3530           then do:
     3531             v-bool = false.
     3532             leave.
     3533           end.
     3534           v-bool = true.
     3535         end.
     3536         if v-bool
     3537         then do:
     3538           for first buf_pl-gds no-lock where buf_pl-gds.obj-type = infoSecsObj:ObjType
     3539                                          and buf_pl-gds.obj-code = infoSecsObj:ObjCode
     3540                                          and buf_pl-gds.gds-code = infoSecsObj:GdsCode
     3541                                          :
     3542             find first ub.place no-lock where ub.place.pl-code = buf_pl-gds.pl-code no-error.
     3543             maskedTextBoxListTank:Text = ub.place.loc1.
     3544             infoSecsObj:InfoSectionCurr:ListTank = maskedTextBoxListTank:text .
     3545           end.
     3546         end.
     3547       end.
     3548       catch e as Progress.Lang.AppError:
     3549         undo, throw e.
     3550       end catch.
     3551     end.
     3552     method private void CalcDoc ( input sender as System.Object, input e as System.EventArgs ):
     3553       def var a as dec no-undo.
     3554       def var b as dec no-undo.
     3555       def var c as dec no-undo.
     3556       a = decimal (maskedTextBoxDocQnty:Text) no-error.
     3557       b = decimal (maskedTextBoxDocDens:Text) no-error.
     3558       c = decimal (maskedTextBoxCliQnty:Text) no-error.
     3559       maskedTextBoxTankWeight:text = "" .
     3560       maskedTextBoxTankVolPomi:text = "" .
     3561       maskedTextBoxTankDensityPomi:text = "" .
     3562       maskedTextBoxAccWeight:text = "" .
     3563       assign
     3564         v-doc-qnty      = a
     3565         v-doc-density   = b
     3566         v-cli-qnty      = c
     3567       no-error .
     3568       if not infoSecsObj:CliQntyInput
     3569         then do:
     3570           this-object:maskedTextBoxCliQnty:Text = format_round_1(a * b) no-error.
     3571           v-cli-qnty = a * b .
     3572         end.
     3573       if not infoSecsObj:DocQntyInput
     3574         then do:
     3575           this-object:maskedTextBoxDocQnty:Text = format_round_0(c / b) no-error.
     3576           v-doc-qnty = c / b .
     3577         end.
     3578       if not infoSecsObj:DensityInput
     3579         then do:
     3580           this-object:maskedTextBoxDocDens:Text = format_dens(c / a) no-error.
     3581           v-doc-density = c / a .
     3582         end.
     3583     end.
     3584     method public void SetInfoSec ():
     3585       def var infoSecObj as class InfoSection no-undo.
     3586       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3587       infoSecObj = infoSecsObj:InfoSectionCurr.
     3588       infoSecObj:SectionName = (this-object:maskedTextBoxSecName:Text).
     3589       infoSecObj:CarVol          = decimal(this-object:maskedTextBoxCarVol:Text).
     3590       infoSecObj:DocDensity      = v-doc-density .
     3591       infoSecObj:DocQnty         = v-doc-qnty .
     3592       infoSecObj:DocVolume       = decimal(this-object:maskedTextBoxDocVolume:Text).
     3593       infoSecObj:TTNTemp         = (if trim (this-object:maskedTextBoxTTNTemp:Text) = "" then ? else decimal(this-object:maskedTextBoxTTNTemp:Text) ).
     3594       infoSecObj:AccShip         = decimal(this-object:maskedTextBoxAccShip:Text).
     3595       infoSecObj:Diameter        = (this-object:maskedTextBoxDiameter:Text).
     3596       infoSecObj:CliQnty         = v-cli-qnty .
     3597       infoSecObj:NumPassport     = (this-object:maskedTextBoxNumPassport:Text).
     3598       infoSecObj:NormDoc         = (this-object:maskedTextBoxNormDoc:Text).
     3599       infoSecObj:CertifFuel      = (this-object:maskedTextBoxCertifFuel:Text).
     3600       infoSecObj:ValidityCertif  = (this-object:maskedTextBoxValidityCertif:Text).
     3601       infoSecObj:ABTarir         = if trim (this-object:maskedTextBoxABTArir:Text) = "" then ? else decimal(this-object:maskedTextBoxABTArir:Text).
     3602       infoSecObj:Mouth           = decimal(this-object:maskedTextBoxMouth:Text).
     3603       infoSecObj:TankVol         = decimal(this-object:maskedTextBoxTankVol:Text).
     3604       infoSecObj:TankDensity     = decimal(this-object:maskedTextBoxTankDens:Text).
     3605       infoSecObj:NaturalLoss     = decimal(this-object:maskedTextBoxNaturLoss:Text).
     3606       infoSecObj:TankWater       = decimal(this-object:maskedTextBoxTankWater:Text).
     3607       infoSecObj:TankTemp        = (if trim (this-object:maskedTextBoxTankTemp:Text) = "" then ? else decimal(this-object:maskedTextBoxTankTemp:Text) ).
     3608       infoSecObj:DensTemp        = (if trim (this-object:maskedTextBoxDensTemp:Text) = "" then ? else decimal(this-object:maskedTextBoxDensTemp:Text) ).
     3609       infoSecObj:ListTank        = (this-object:maskedTextBoxListTank:Text).
     3610       infoSecObj:PlaceSi         = decimal(this-object:maskedTextBoxPlaceSi:Text).
     3611       infoSecObj:NumPlotn        = (this-object:maskedTextBoxNumPlot:Text).
     3612       infoSecObj:PassportPlotn   = (this-object:maskedTextBoxPassportPlotn:Text).
     3613       infoSecObj:TankDensityPomi = decimal(this-object:maskedTextBoxTankDensityPomi:Text).
     3614       infoSecObj:TankVolPomi     = decimal(this-object:maskedTextBoxTankVolPomi:Text).
     3615       infoSecObj:TankWeight      = decimal(this-object:maskedTextBoxTankWeight:Text).
     3616       infoSecObj:AccPomi         = decimal(this-object:maskedTextBoxAccWeight:Text).
     3617       infoSecObj:Tests           = (this-object:maskedTextBoxTests:Text).
     3618       infoSecObj:KolProb         = decimal(this-object:maskedTextBoxKolProb:Text).
     3619       infoSecObj:NumPrintProb    = (this-object:maskedTextBoxNumPrintProb:Text).
     3620       infoSecObj:PlaceSiTemp     = decimal(this-object:maskedTextBoxPlaceSiTemp:Text).
     3621       infoSecObj:Shape           = this-object:comboBoxShape:Text.
     3622       infoSecObj:Pour            = this-object:comboBoxPour:Text.
     3623       infoSecObj:DateProb        = date ((this-object:DateTimeDateProb:Text)).
     3624       infoSecObj:DateStart       = date ((this-object:dateTimePickerDateStart:Text)).
     3625       infoSecObj:DateEnd         = date ((this-object:dateTimePickerDateEnd:Text)).
     3626       infoSecObj:TimeStart       = GetTimeInt((this-object:dateTimePickerTimeStart:Text)).
     3627       infoSecObj:TimeEnd         = GetTimeInt((this-object:dateTimePickerTimeEnd:Text)).
     3628       infoSecObj:DatePovPlotn    = date ((this-object:dateTimePickerDatePovPlotn:Text)).
     3629       infoSecObj:DatePovPlotnTemp = date ((this-object:dateTimePickerDatePovTemp:Text)).
     3630       infoSecObj:DocDensST       = decimal(this-object:maskedTextBoxDocDensST:Text).
     3631       infoSecObj:PaspDens        = decimal(this-object:maskedTextBoxPaspDens:Text).
     3632       infoSecObj:Pressure        = decimal(this-object:maskedTextBoxPressure:Text).
     3633       infoSecObj:GroupNP         = this-object:comboBoxGroupNP:Text.
     3634       infoSecObj:alarm-SGDKK     = this-object:cbSGDKK:Checked.
     3635       infoSecObj:AukKey          = this-object:maskedTextBoxAukKey:Text.
     3636       infoSecObj:KPnoMeas         = this-object:cbKPnoMeas:Checked.
     3637       if num-entries (this-object:TimeProb:Text, ":") >= 2
     3638       then do:
     3639         infoSecObj:HourProb = integer (entry (1, this-object:TimeProb:Text, ":")).
     3640         infoSecObj:MinProb  = integer (entry (2, this-object:TimeProb:Text, ":")).
     3641       end.
     3642       else do:
     3643         infoSecObj:HourProb = ?.
     3644         infoSecObj:MinProb = ?.
     3645       end.
     3646     end.
     3647     method private void calc-weight-vol ( input sender as System.Object, input e as System.EventArgs ):
     3648       calc-weight-vol ().
     3649     end.
     3650     method private void calc-weight-vol ( ):
     3651       define variable v-area as decimal no-undo.
     3652       define variable inum-ComboBoxShape as integer no-undo.
     3653       if not infoSecsObj:FlagTrn
     3654         then return.
     3655       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     3656       inum-ComboBoxShape = lookup (comboBoxShape:Text, var-list-shape, ",") - 1 no-error.
     3657       infoSecsObj:GetArea (output v-area, input inum-ComboBoxShape, input maskedTextBoxDiameter:Text)
     3658         no-error.
     3659       if error-status:error then
     3660       do:
     3661         message "Неверно указан размер горловины. Берется по умолчанию 0" view-as alert-box.
     3662         maskedTextBoxDiameter:Text = "0".
     3663         v-area = 0.
     3664       end.
     3665       infoSecsObj:InfoSectionCurr:NeckArea = v-area.
     3666       if inum-ComboBoxShape = 0
     3667       and infoSecsObj:RdcDnstvalue = "not"
     3668       then do :
     3669         maskedTextBoxMouth:Text = "0" .
     3670       end .
     3671       else do :
     3672         maskedTextBoxMouth:Text = format_round_0 (   infoSecsObj:InfoSectionCurr:getMouth(decimal (maskedTextBoxABTArir:Text), v-area)) no-error.
     3673         if error-status:error
     3674         then do:
     3675           message "Неверно указано отклонение от планки. Берется по умолчанию 0" view-as alert-box.
     3676           maskedTextBoxDiameter:Text = "0".
     3677           v-area = 0.
     3678         end.
     3679       end .
     3680       if     not infoSecsObj:RdcDnstvalue = "not"
     3681          and ((not infoSecsObj:IsSGDKK)
     3682               or (    infoSecsObj:IsSGDKK
     3683                   and cbSGDKK:checked
     3684                   and infoSecsObj:InfoSectionCurr:AccMeth = 0)
     3685              )
     3686       then do:
     3687         maskedTextBoxTankVol:Text = format_round_0 ((decimal (maskedTextBoxCarVol:Text)) + decimal (maskedTextBoxMouth:Text) - decimal(maskedTextBoxTankWater:Text) + (if comboBoxPour:Text = "Нижний налив" then infoSecsObj:InfoSectionCurr:DopVolume else 0)).
     3688       end.
     3689       if infoSecsObj:RdcDnstvalue = "not" then
     3690       do:
     3691         maskedTextBoxTankVol:Text = format_round_0 ((decimal (maskedTextBoxCarVol:Text)) + decimal (maskedTextBoxMouth:Text) - decimal(maskedTextBoxTankWater:Text) + (if comboBoxPour:Text = "Нижний налив" then infoSecsObj:InfoSectionCurr:DopVolume else 0)).
     3692         if infoSecsObj:RdcDnstvalue = "not"
     3693         then do:
     3694           maskedTextBoxTankWeight:Text = format_round_3 (decimal(maskedTextBoxTankVol:Text) * decimal ( maskedTextBoxTankDens:Text)).
     3695         end.
     3696       end.
     3697       else
     3698       do:
     3699         if infoSecsObj:RdcDnstvalue = "pomi-rn" or infoSecsObj:RdcDnstvalue = "th" then
     3700         do :
     3701           assign
     3702             maskedTextBoxTankDensityPomi:Text = format_dens (decimal (maskedTextBoxTankWeight:Text) / decimal (maskedTextBoxTankVolPomi:Text)).
     3703         end.
     3704         else
     3705         do:
     3706           maskedTextBoxTankWeight:Text = format_round_3 (decimal(maskedTextBoxTankVolPomi:Text) * decimal ( maskedTextBoxTankDensityPomi:Text)).
     3707         end.
     3708       end.
     3709     end method.
     3710     method private char format_round_0 (arg as decimal):
     3711       def var str as char no-undo.
     3712       str = trim (string (round(arg, 0), "->>>>>>>>9")).
     3713       return str.
     3714     end.
     3715     method private char format_round_1 (arg as decimal):
     3716       def var str as char no-undo.
     3717       str = trim (string (round(arg, 1), "->>>>>>>>9.9")).
     3718       return str.
     3719     end.
     3720     method private char format_round_3 (arg as decimal):
     3721       def var str as char no-undo.
     3722       str = trim (string (round(arg, 3), "->>>>>>>>9.999")).
     3723       return str.
     3724     end.
     3725     method private char format_int (arg as integer):
     3726       def var str as char no-undo.
     3727       str = string (arg).
     3728       return str.
     3729     end.
     3730     method private char format_dens (arg as decimal):
     3731       def var str as char no-undo.
     3732       str = trim (string (round(arg, 4), "->>>>>>>>9.9999")) no-error.
     3733       if error-status:error
     3734         then return "".
     3735       return str.
     3736     end.
     3737     method private char format_pressure (arg as decimal):
     3738       def var str as char no-undo.
     3739       str = trim (string (round(arg, 1), "->>>>>>>>9.<")) no-error.
     3740       if error-status:error
     3741         then return "".
     3742       return str.
     3743     end.
     3744     method private char format_temper (arg as decimal):
     3745       def var str as char no-undo.
     3746       str = trim (string (round(arg, 1), "->>9.<")).
     3747       return str.
     3748     end.
     3749     method private void blank_datetime (arg as DateTimePicker):
     3750       arg:visible = true.
     3751       arg:Format = DateTimePickerFormat:Custom.
     3752       arg:CustomFormat = "    " .
     3753     end.
     3754     method private char GetTimeStr (arg as int):
     3755       def var v-str as char no-undo.
     3756       def var v-str-2 as char no-undo.
     3757       v-str-2 = string (integer( truncate( arg / 3600 , 0 ) )) no-error.
     3758       if error-status:error
     3759         then return "".
     3760       v-str = v-str-2 + ":" + string (integer( truncate(( arg - integer (v-str-2) * 3600 ) / 60 , 0 ))) + ":00" no-error.
     3761       if error-status:error
     3762         then return "".
     3763       return v-str.
     3764     end.
     3765     method private int GetTimeInt (arg as char):
     3766       def var v-int as int no-undo.
     3767       if arg <> "" and num-entries (arg, ":") >= 2
     3768       then do:
     3769         v-int = integer (entry (1, arg, ":")) * 3600 + integer (entry (2, arg, ":")) * 60 no-error.
     3770         if not error-status:error
     3771           then return v-int.
     3772       end.
     3773       return ?.
     3774     end.
     3775     method private logical valid-density (input p-density as decimal) :
     3776       define variable v-answ as logical no-undo .
     3777       if (p-density <> ? and p-density > 0.0 and p-density < 1.0)
     3778       then do:
     3779         assign
     3780           v-answ = true
     3781         .
     3782       end.
     3783       else do:
     3784         assign
     3785           v-answ = false
     3786         .
     3787       end.
     3788       return v-answ.
     3789     end method .
     3790     method public void SetForcus ():
     3791       setFocusMaskTextDoc:Focus() no-error .
     3792     end.
     3793     method public void ClWght ( input sender as System.Object, input e as System.EventArgs ):
     3794       if not infoSecsObj:RdcDnstvalue = "not"
     3795       then do:
     3796         maskedTextBoxTankDensityPomi:Text = "".
     3797         maskedTextBoxTankVolPomi:Text = "".
     3798         maskedTextBoxTankWeight:Text = "".
     3799         maskedTextBoxAccWeight:Text = "".
     3800       end.
     3801     end.
     3802     method public logical CheckSec (input p-save as logical, input p-ShowMsg as logical, input p-exit as logical):
     3803       define variable v-dec as decimal no-undo.
     3804       define variable v-str as character no-undo.
     3805       define variable v-sec as character no-undo .
     3806       define buffer buf_rvs-doc for ub.rvs-doc .
     3807       v-str = "Не заполнено обязательное поле ".
     3808       if infoSecsObj:FlagTrn
     3809       then do:
     3810         if not infoSecsObj:RdcDnstvalue = "not"
     3811         then do:
     3812           if not infoSecsObj:IsSGDKK
     3813           then do :
     3814             if p-save
     3815             and p-exit
     3816             and infoSecsObj:GetInfoSectionProp(idSecTabPage):AccMeth = 1
     3817             and infoSecsObj:IsActnComm
     3818             then do :
     3819               find first buf_rvs-doc no-lock where buf_rvs-doc.out-code = infoSecsObj:TrnDocNum no-error .
     3820               if available buf_rvs-doc
     3821               then do :
     3822                 v-dec = decimal (v-tank-weight-rvs) no-error.
     3823                 if (error-status:error or v-dec = 0 or v-dec = ?)
     3824                 then do:
     3825                   ShowMsg( "Сохранение параметров секции невозможно." + chr(10) +
     3826                            "Не выполнен расчет массы принимаемого НП."  + chr(10) +
     3827                            "Введите данные и нажмите кнопку Рассчитать по данным сверок." ).
     3828                   return false.
     3829                 end .
     3830               end .
     3831             end .
     3832             if cbKPnoMeas:Checked then return true .
     3833             if lookup("a-b-tarir", v-sec-fields) > 0
     3834             then do :
     3835               if trim (maskedTextBoxABTArir:Text) = ""
     3836               then do:
     3837                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3838                 then ShowMsg( v-str + "отклонение от тарировочной пл." ).
     3839                 setFocusMaskTextDoc = maskedTextBoxABTArir.
     3840                 return false.
     3841               end.
     3842             end.
     3843             if lookup("tank-density", v-sec-fields) > 0
     3844             then do :
     3845               v-dec = decimal (maskedTextBoxTankDens:Text) no-error.
     3846               if (error-status:error or v-dec = 0)
     3847               then do:
     3848                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3849                 then ShowMsg( v-str + "плотность топлива" ).
     3850                 setFocusMaskTextDoc = maskedTextBoxTankDens.
     3851                 return false.
     3852               end.
     3853               if not valid-density(v-dec)
     3854               then do :
     3855                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3856                 then ShowMsg( "Неверно введена плотность топлива" ).
     3857                 setFocusMaskTextDoc = maskedTextBoxTankDens.
     3858                 return false.
     3859               end .
     3860             end.
     3861             if lookup("tank-temp", v-sec-fields) > 0
     3862             then do :
     3863               v-dec = decimal (maskedTextBoxTankTemp:Text) no-error.
     3864               if (error-status:error or trim (maskedTextBoxTankTemp:Text) = "")
     3865               then do:
     3866                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3867                 then ShowMsg( v-str + "температура замера объема" ).
     3868                 setFocusMaskTextDoc = maskedTextBoxTankTemp.
     3869                 return false.
     3870               end.
     3871             end.
     3872             if lookup("dens-temp", v-sec-fields) > 0
     3873             then do :
     3874               v-dec = decimal (maskedTextBoxDensTemp:Text) no-error.
     3875               if (error-status:error or trim (maskedTextBoxDensTemp:Text) = "")
     3876               then do:
     3877                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3878                 then ShowMsg( v-str + "температура замера плотности" ).
     3879                 setFocusMaskTextDoc = maskedTextBoxDensTemp.
     3880                 return false.
     3881               end.
     3882             end.
     3883             if lookup("place-si", v-sec-fields) > 0
     3884             then do :
     3885               v-dec = decimal (maskedTextBoxPlaceSi:Text) no-error.
     3886               if (error-status:error or v-dec = 0)
     3887               then do:
     3888                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3889                 then ShowMsg( v-str + "средство измерения плотности" ).
     3890                 setFocusMaskTextDoc = maskedTextBoxPlaceSi.
     3891                 return false.
     3892               end.
     3893             end.
     3894             if lookup("place-si-temp", v-sec-fields) > 0
     3895             then do :
     3896               v-dec = decimal (maskedTextBoxPlaceSiTemp:Text) no-error.
     3897               if (error-status:error or v-dec = 0)
     3898               then do:
     3899                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3900                 then ShowMsg( v-str + "средство измерения температуры" ).
     3901                 setFocusMaskTextDoc = maskedTextBoxPlaceSiTemp.
     3902                 return false.
     3903               end.
     3904             end.
     3905             if p-save
     3906             then do :
     3907               v-dec = decimal (maskedTextBoxTankWeight:Text) no-error.
     3908               if (error-status:error or v-dec = 0)
     3909               then do:
     3910                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3911                 then ShowMsg( "Сохранение параметров секции невозможно." + chr(10) +
     3912                          "Не выполнен расчет массы принимаемого НП."  + chr(10) +
     3913                          "Введите данные и нажмите кнопку Рассчитать по замерам в АЦ." ).
     3914                 return false.
     3915               end.
     3916               if infoSecsObj:GetInfoSectionProp(idSecTabPage):AccMeth = 1
     3917               and infoSecsObj:IsActnComm
     3918               then do :
     3919                 v-dec = decimal (v-tank-weight-rvs) no-error.
     3920                 if (error-status:error or v-dec = 0 or v-dec = ?)
     3921                 then do:
     3922                   if p-ShowMsg or infoSecsObj:SectionNum = 1
     3923                   then ShowMsg( "Сохранение параметров секции невозможно." + chr(10) +
     3924                            "Не выполнен расчет массы принимаемого НП."  + chr(10) +
     3925                            "Введите данные и нажмите кнопку Рассчитать по данным сверок." ).
     3926                   return false.
     3927                 end .
     3928               end .
     3929             end .
     3930           end .
     3931           else do :
     3932             if cbSGDKK:Checked
     3933             then do :
     3934               if not infoSecsObj:IsActnComm
     3935               and infoSecsObj:isKP
     3936               and trim(maskedTextBoxAukKey:text) > ""
     3937               then do :
     3938                 if p-ShowMsg or infoSecsObj:SectionNum = 1
     3939                 then ShowMsg( "По накладной установлен флаг комиссионного приема. Недостаточно прав для ввода идентификатора доступа (ключа) верхнего уровня или одноразового кода!" ).
     3940                 setFocusMaskTextDoc = maskedTextBoxAukKey.
     3941                 return false.
     3942               end .
     3943               if length(trim(maskedTextBoxAukKey:text)) < 4
     3944               and maskedTextBoxAukKey:Enabled
     3945               and p-exit
     3946               then do :
     3947                 ShowMsg( "Некорректная длина идентификатора доступа (ключа) верхнего уровня или одноразового кода для разблокировки API-адаптера. Проверьте введенное значение и скорректируйте." ).
     3948                 setFocusMaskTextDoc = maskedTextBoxAukKey.
     3949                 return false.
     3950               end .
     3951             end .
     3952             else do :
     3953               if lookup("accessIDLowerLevel", v-sec-fields) > 0
     3954               then do :
     3955                 if length(trim(maskedTextBoxAukKey:text)) < 4
     3956                 and maskedTextBoxAukKey:Enabled
     3957                 then do :
     3958                   if p-ShowMsg then ShowMsg( "Некорректная длина идентификатора доступа (ключа) нижнего уровня. Проверьте введенное значение и скорректируйте." ).
     3959                   setFocusMaskTextDoc = maskedTextBoxAukKey.
     3960                   return false.
     3961                 end .
     3962               end.
     3963             end .
     3964             if p-save
     3965             and p-exit
     3966             then do :
     3967               if infoSecsObj:IsKPrvs
     3968               then do :
     3969                 if infoSecsObj:GetInfoSectionProp(idSecTabPage):AccMeth = 1
     3970                 then do :
     3971                   v-dec = decimal (v-tank-weight-rvs) no-error.
     3972                   if (error-status:error or v-dec = 0 or v-dec = ?)
     3973                   then do:
     3974                     ShowMsg( "Сохранение параметров секции невозможно." + chr(10) +
     3975                              "Не выполнен расчет массы принимаемого НП."  + chr(10) +
     3976                              "Введите данные и нажмите кнопку Рассчитать по данным сверок." ).
     3977                     return false.
     3978                   end .
     3979                 end .
     3980               end .
     3981               else
     3982               if infoSecsObj:IsKP
     3983               then do :
     3984                 if infoSecsObj:GetInfoSectionProp(idSecTabPage):AccMeth = 0
     3985                 then do :
     3986                   v-dec = decimal (maskedTextBoxTankWeight:Text) no-error.
     3987                   if (error-status:error or v-dec = 0)
     3988                   then do:
     3989                     ShowMsg( "Сохранение параметров секции невозможно." + chr(10) +
     3990                              "Не выполнен расчет массы принимаемого НП."  + chr(10) +
     3991                              "Введите данные и нажмите кнопку Рассчитать по замерам в АЦ." ).
     3992                     return false.
     3993                   end .
     3994                 end .
     3995               end .
     3996             end .
     3997           end .
     3998         end.
     3999         else do:
     4000           if lookup("car-vol", v-sec-fields) > 0
     4001           then do :
     4002             v-dec = decimal (maskedTextBoxCarVol:Text) no-error.
     4003             if (error-status:error or v-dec = 0)
