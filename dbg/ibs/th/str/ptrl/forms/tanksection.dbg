      660       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
      661       if infoSecsObj:GetInfoSectionProp(idSecTabPage):isKP
      662       and not infoSecsObj:IsActnComm
      663       then do :
      664         message "Для секции " + infoSecsObj:GetInfoSectionProp(idSecTabPage):SectionName + " установлен флаг комиссионного приема. Работа с сверкой запрещена!"
      665         view-as alert-box .
      666         return .
      667       end .
      668       assign rvslog = no .
      669       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = infoSecsObj:TrnDocNum .
      670       if not chk-asi-polling (no)
      671       then return no-apply .
      672       ActionRvsSec
      673         ( input 'ИЗМЕНЕНИЕ':U
      674          ,input "meas":U
      675          ,input 'после_док':U
      676         ) no-error .
      677       if error-status :error then do:
      678         return no-apply .
      679       end.
      680       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
      681       groupBox5:Enabled                 = yes .
      682       dateTimePickerDateEnd:Enabled     = yes .
      683       dateTimePickerDateEnd:Checked     = yes .
      684       dateTimePickerDateEnd:Focus() .
      685       dateTimePickerDateEnd:Text        = string (infoSecObj:DateEnd) no-error.
      686       if error-status:error or infoSecObj:DateEnd = ?
      687         then
      688       do:
      689         blank_datetime (dateTimePickerDateEnd).
      690       end.
      691       dateTimePickerDateEnd:Enabled     = no .
      692       dateTimePickerTimeEnd:Enabled     = yes .
      693       dateTimePickerTimeEnd:Checked     = yes .
      694       dateTimePickerTimeEnd:Focus() .
      695       dateTimePickerTimeEnd:Text        = GetTimeStr(infoSecObj:TimeEnd) no-error.
      696       if error-status:error or infoSecObj:TimeEnd = ? or infoSecObj:TimeEnd = 0
      697         then
      698       do:
      699         blank_datetime (dateTimePickerTimeEnd).
      700       end.
      701       dateTimePickerTimeEnd:Enabled     = no .
      702       groupBox5:Enabled                 = no .
      703       infoSecObj:TankWeightRvs = ? .
      704       if infoSecsObj:petrol_block-nozzle
      705       then do :
      706         list-pl = "" .
      707         for each buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
      708                                       and buf_doc-pl.obj-code = buf_trn-doc.obj-code
      709                                       and buf_doc-pl.out-code = buf_trn-doc.doc-code
      710                                       and buf_doc-pl.gds-code = infoSecsObj:GdsCode,
      711         each buf_pl-gds-pump no-lock where buf_pl-gds-pump.gds-code = infoSecsObj:GdsCode
      712                                        and buf_pl-gds-pump.obj-code = buf_doc-pl.obj-code
      713                                        and buf_pl-gds-pump.obj-type = buf_doc-pl.obj-type
      714                                        and buf_pl-gds-pump.pl-code = buf_doc-pl.pl-code,
      715         each buf_pl-pump-nozzle no-lock where buf_pl-pump-nozzle.obj-code = buf_pl-gds-pump.obj-code
      716                                           and buf_pl-pump-nozzle.obj-type = buf_pl-gds-pump.obj-type
      717                                           and buf_pl-pump-nozzle.pl-code = buf_pl-gds-pump.pl-code
      718                                           and buf_pl-pump-nozzle.pump-code = buf_pl-gds-pump.pump-code
      719         :
      720           list-pl = substitute("&1&2&3:&4:&5", list-pl,
      721                      if list-pl = "" then "" else ";",
      722                      buf_pl-pump-nozzle.nozzle-code,
      723                      buf_pl-pump-nozzle.pump-code,
      724                      buf_pl-pump-nozzle.pl-code).
      725         end.
      726         run str/diallog.w ( input infoSecsObj:parentproc
      727             ,input infoSecsObj:in-line-handle
      728             ,input 'str/get-block-nozzle.p':U
      729             ,input (buf_trn-doc.obj-type + chr(4) +
      730             string(buf_trn-doc.obj-code) + chr(4) +
      731             string(0) + chr(4) +
      732             string(0) + chr(4) +
      733             chr(4) +
      734             chr(4) +
      735             chr(4) +
      736             substitute("&1,&2"
      737             ,"unblock"
      738             ,list-pl))
      739             ,input yes
      740             ,input ''
      741             ,input 'Разблокировка выбранных пистолетов') .
      742         if not error-status:error then
      743         do:
      744           if return-value begins "Для кассы" then
      745           do:
      746              message return-value
      747                 view-as alert-box question buttons yes-no update v-ok as logical  .
      748              if v-ok then run unblock-nozzle .
      749              else message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
      750                    view-as alert-box.
      751           end.
      752           else
      753           do:
      754              message if return-value begins "Ошибка" then return-value else "Разблокировка пистолетов прошла успешно"
      755                view-as alert-box.
      756           end.
      757         end.
      758         else
      759         do:
      760           return no-apply .
      761         end.
      762       end .
      763     end method .
