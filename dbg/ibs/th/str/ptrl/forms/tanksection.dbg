     5328                 v-prt-start-real-date = buf_rvs-line.real-date .
     5329                 v-prt-start-real-time = buf_rvs-line.real-time .
     5330               end.
     5331               else do:
     5332                 v-prt-end-real-date = buf_rvs-line.real-date .
     5333                 v-prt-end-real-time = buf_rvs-line.real-time .
     5334               end.
     5335               for each tt-pump-nozzle
     5336               :
     5337                 delete tt-pump-nozzle .
     5338               end.
     5339               for each bf_pl-pump-nozzle no-lock where bf_pl-pump-nozzle.obj-type = buf_rvs-line.obj-type
     5340                                                    and bf_pl-pump-nozzle.obj-code = buf_rvs-line.obj-code
     5341                                                    and bf_pl-pump-nozzle.pl-code  = buf_rvs-line.pl-code,
     5342               first bf_pump-nozzle no-lock where bf_pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     5343                                              and bf_pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     5344                                              and bf_pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     5345                                              and bf_pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     5346               :
     5347                 create tt-pump-nozzle.
     5348                 assign
     5349                   tt-pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     5350                   tt-pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     5351                   tt-pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     5352                   tt-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     5353                   tt-pump-nozzle.gds-code    = buf_goods.gds-code
     5354                 .
     5355               end .
     5356               if ptoldfilvalue = "yes":U then do:
     5357                 run gbl/d-askw.w
     5358                   ( input "Выбор источника данных с информацией по ТРК"
     5359                   ,input "Будем читать текущие данные с ТРК или возьмем данные из файла?"
     5360                   ,input "|^"
     5361                   ,input "Текущие данные|Из файлов|Отмена"
     5362                   ,input "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем"
     5363                   ,input 1
     5364                   ,input 3
     5365                   ,output varnum
     5366                   ) .
     5367                 case varnum :
     5368                   when 1 then do:
     5369                     assign
     5370                       varcur-rvs = 1
     5371                     .
     5372                   end.
     5373                   when 2  then do:
     5374                     assign
     5375                       varcur-rvs = 0
     5376                     .
     5377                   end.
     5378                   when 3 then do:
     5379                     assign
     5380                       varcur-rvs = 3
     5381                     .
     5382                   end.
     5383                 end case.
     5384               end.
     5385               else do:
     5386                 assign
     5387                   varcur-rvs = 1
     5388                 .
     5389               end.
     5390               if varcur-rvs <> 3
     5391               then do :
     5392                 waitForm = new ibs.th.str.ptrl.forms.waitform("~r~nОпрос ТРК...") .
     5393                 waitForm:Show() .
     5394                 if varcur-rvs = 1
     5395                 or ptoldfilvalue <> "yes":u
     5396                 then do :
     5397   run lib-rvs_anls-pmp in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input              infoSecsObj:Parentproc ,
     5398                         input              buf_rvs-doc.obj-type ,
     5399                         input              buf_rvs-doc.obj-code ,
     5400                         input              yes ,
     5401                         input-output table tt-pump-nozzle-file ,
     5402                         input-output table tt-pump-nozzle ,
     5403                         input              yes ,
     5404                         input              ? ,
     5405                         input              yes) no-error .
     5406                 end.
     5407                 else do :
     5408   run lib-rvs_anls-pmp in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input              infoSecsObj:Parentproc ,
     5409                         input              buf_rvs-doc.obj-type ,
     5410                         input              buf_rvs-doc.obj-code ,
     5411                         input              yes ,
     5412                         input-output table tt-pump-nozzle-file ,
     5413                         input-output table tt-pump-nozzle ,
     5414                         input              no ,
     5415                         input              ? ,
     5416                         input              yes) no-error .
     5417                 end.
     5418                 waitForm:Close() .
     5419                 delete object waitForm no-error .
     5420                 for each tt-pump-nozzle :
     5421                   find first tt-pump-nozzle-file where
     5422                              tt-pump-nozzle-file.obj-type    = tt-pump-nozzle.obj-type    and
     5423                              tt-pump-nozzle-file.obj-code    = tt-pump-nozzle.obj-code    and
     5424                              tt-pump-nozzle-file.pump-code   = tt-pump-nozzle.pump-code   and
     5425                              tt-pump-nozzle-file.nozzle-code = tt-pump-nozzle.nozzle-code no-error .
     5426                   if available tt-pump-nozzle-file
     5427                   then
     5428                   assign
     5429                     tt-pump-nozzle.meas-el-cnt = tt-pump-nozzle-file.meas-el-cnt
     5430                     tt-pump-nozzle.meas-am-cnt = tt-pump-nozzle-file.meas-am-cnt
     5431                     tt-pump-nozzle.meas-cf-cnt = tt-pump-nozzle-file.meas-cf-cnt
     5432                   .
     5433                 end.
     5434                 for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.obj-type = buf_rvs-line.obj-type
     5435                                                      and buf_rvs-line-pump.obj-code = buf_rvs-line.obj-code
     5436                                                      and buf_rvs-line-pump.rvs-code = buf_rvs-line.rvs-code
     5437                                                      and buf_rvs-line-pump.pl-code  = buf_rvs-line.pl-code
     5438                                                      and buf_rvs-line-pump.gds-code = buf_rvs-line.gds-code
     5439                 :
     5440   run lib-rvs_fill1pmp in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input       recid( buf_rvs-line-pump ) ,
     5441                         input table tt-pump-nozzle )  .
     5442                 end .
     5443               end .
     5444               for each buf_rvs-line-pump exclusive-lock where buf_rvs-line-pump.obj-type = buf_rvs-line.obj-type
     5445                                                           and buf_rvs-line-pump.obj-code = buf_rvs-line.obj-code
     5446                                                           and buf_rvs-line-pump.rvs-code = buf_rvs-line.rvs-code
     5447                                                           and buf_rvs-line-pump.pl-code  = buf_rvs-line.pl-code
     5448                                                           and buf_rvs-line-pump.gds-code = buf_rvs-line.gds-code
     5449               :
     5450                 assign
     5451                   buf_rvs-line-pump.state-el-cnt    = 0 when buf_rvs-line-pump.state-el-cnt = ?
     5452                   buf_rvs-line-pump.state-mh-cnt    = 0 when buf_rvs-line-pump.state-mh-cnt = ?
     5453                 .
     5454               end .
     5455             end .
     5456           end.
     5457         end case.
     5458         if not pAction = 'ПРОСМОТР':U
     5459         then do :
     5460           infoSecsObj:GetInfoSectionProp(idSecTabPage) .
     5461           if pRvsType = 'перед_док':U
     5462           then do:
     5463             infoSecsObj:InfoSectionCurr:DateStart = v-prt-start-real-date .
     5464             infoSecsObj:InfoSectionCurr:TimeStart = v-prt-start-real-time .
     5465           end .
     5466           else do :
     5467             infoSecsObj:InfoSectionCurr:DateEnd   = v-prt-end-real-date .
     5468             infoSecsObj:InfoSectionCurr:TimeEnd   = v-prt-end-real-time .
     5469           end .
     5470           infoSecsObj:InfoSectionCurr:TankWeightRvs = ? .
     5471           infoSecsObj:InfoSectionCurr:TankVolPomiRvs = ? .
     5472           infoSecsObj:InfoSectionCurr:AvgTempRvs = ? .
     5473         end.
     5474         infoSecsObj:SaveDB().
     5475         if not available buf_rvs-line
     5476         then do :
     5477           find first buf_rvs-line exclusive-lock
     5478           where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     5479             and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     5480             and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     5481             and buf_rvs-line.pl-code  = v-pl-code
     5482             and buf_rvs-line.gds-code = buf_goods.gds-code
     5483           .
     5484         end .
     5485         if pAction = 'ИЗМЕНЕНИЕ':U then do:
     5486           if pActionType = "meas":U then do:
     5487   run lib-rvs_rvsclcln in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input recid(buf_rvs-line) ) no-error .
     5488             if error-status :error then do:
     5489               message
     5490                 "Ошибка при пересчете строки документа сверки." skip
     5491                 return-value skip
     5492                 error-status :get-message(1) skip
     5493                 view-as alert-box error .
     5494               undo block_tr, return error .
     5495             end.
     5496           end.
     5497   run lib-rvs_rvsclchd in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input recid(buf_rvs-doc) ,
     5498                         input false ) no-error .
     5499           if error-status :error then do:
     5500             message
     5501               "Ошибка при пересчете документа сверки." skip
     5502               return-value skip
     5503               error-status :get-message(1) skip
     5504               view-as alert-box error .
     5505             undo block_tr, return error .
     5506           end.
     5507           return-rvs-qnty
     5508             ( input infoSecsObj:TrnDocNum
     5509              ,input buf_goods.gds-code
     5510              ,input v-pl-code
     5511              ,output v-rvs-qnty-before
     5512              ,output v-rvs-qnty-after
     5513              ,output v-rvs-cli-qnty-before
     5514              ,output v-rvs-cli-qnty-after
     5515             ) no-error .
     5516           if error-status :error then do:
     5517             undo block_tr, return error return-value .
     5518           end.
     5519           if pRvsType = 'после_док':U then do:
     5520             if v-rvs-qnty-after = ?
     5521               or v-rvs-qnty-after = 0
     5522             then do:
     5523               message
     5524                 "Не задано количество по сверке <<после_док>>"
     5525                 "по резервуару" v-pl-code "."
     5526                 view-as alert-box error .
     5527               undo block_tr, return error .
     5528             end.
     5529             if v-rvs-cli-qnty-after = ?
     5530               or v-rvs-cli-qnty-after = 0
     5531             then do:
     5532                 message
     5533                   "Масса не рассчитана. Не задана плотность в сверке <<после_док>>"
     5534                   "по резервуару" v-pl-code "."
     5535                   view-as alert-box error .
     5536               undo block_tr, return error .
     5537             end.
     5538           end.
     5539           if v-rvs-qnty-after <> ?
     5540             and v-rvs-qnty-after <> 0
     5541           then do:
     5542             if v-rvs-qnty-after - v-rvs-qnty-before <= 0
     5543               or v-rvs-qnty-after - v-rvs-qnty-before = ?
     5544             then do:
     5545               message
     5546                 substitute( "Ошибка по результатам сверки." ) skip
     5547                 substitute( "Место хранения: &1 .", v-pl-code ) skip
     5548                 substitute( "Количество залитого топлива: &1 (&2).", v-rvs-qnty-after - v-rvs-qnty-before, buf_goods.unit-base ) skip
     5549                 substitute( "Объем в сверке до: &1 ", v-rvs-qnty-before ) skip
     5550                 substitute( "Объем в сверке после: &1 ", v-rvs-qnty-after ) skip
     5551                 view-as alert-box .
     5552               undo block_tr, return error .
     5553             end.
     5554             if v-rvs-cli-qnty-after - v-rvs-cli-qnty-before <= 0
     5555               or v-rvs-cli-qnty-after - v-rvs-cli-qnty-before = ?
     5556             then do:
     5557               message
     5558                 substitute( "Ошибка по результатам сверки." ) skip
     5559                 substitute( "Место хранения: &1 .", v-pl-code ) skip
     5560                 substitute( "Количество залитого топлива: &1 (&2).", v-rvs-cli-qnty-after - v-rvs-cli-qnty-before, buf_goods.unit-cli ) skip
     5561                 substitute( "Масса в сверке до: &1 ", v-rvs-cli-qnty-before ) skip
     5562                 substitute( "Масса в сверке после: &1 ", v-rvs-cli-qnty-after ) skip
     5563                 view-as alert-box .
     5564               undo block_tr, return error .
     5565             end.
     5566             assign
     5567               v-rvs-density = (v-rvs-cli-qnty-after - v-rvs-cli-qnty-before) / (v-rvs-qnty-after - v-rvs-qnty-before)
     5568             .
     5569             if Valid-Density( v-rvs-density ) <> true then do:
     5570               message
     5571                 substitute( "Ошибка по результатам сверки." ) skip
     5572                 substitute( "Место хранения: &1 .", v-pl-code ) skip
     5573                 substitute( "Плотность залитого топлива: &1.", v-rvs-density ) skip
     5574                 view-as alert-box .
     5575               undo block_tr, return error .
     5576             end.
     5577           end.
     5578         end.
     5579       end.
     5580     end method .
     5581     method private void check-before
     5582       (input pDocCode as character,
     5583        input pGdsCode as integer,
     5584        input pPlCode  as integer)
     5585     :
     5586       define buffer buf_goods         for ub.goods .
     5587       define buffer bf_after_rvs-doc  for ub.rvs-doc  .
     5588       define buffer bf_after_rvs-line for ub.rvs-line .
     5589       define buffer bf_before_rvs-doc  for ub.rvs-doc  .
     5590       define buffer bf_before_rvs-line for ub.rvs-line .
     5591       define variable ii as integer no-undo .
     5592       define variable v-sec as character no-undo .
     5593       define variable infoSecObj as class InfoSection no-undo .
     5594       find first buf_goods no-lock
     5595         where buf_goods.gds-code = pGdsCode
     5596         .
     5597       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
     5598       v-sec = infoSecObj:SectionName .
     5599       for each bf_before_rvs-doc no-lock where bf_before_rvs-doc.rvs-type = 'перед_док':U
     5600                                            and bf_before_rvs-doc.out-code = pDocCode
     5601                                            and num-entries(bf_before_rvs-doc.rvs-code, "-") = 3
     5602                                            and entry(2, bf_before_rvs-doc.rvs-code, "-") <> v-sec
     5603       :
     5604         for each bf_before_rvs-line no-lock where bf_before_rvs-line.rvs-code = bf_before_rvs-doc.rvs-code
     5605                                               and bf_before_rvs-line.obj-type = bf_before_rvs-doc.obj-type
     5606                                               and bf_before_rvs-line.obj-code = bf_before_rvs-doc.obj-code
     5607                                               and bf_before_rvs-line.pl-code  = pPlCode
     5608                                               and bf_before_rvs-line.gds-code = buf_goods.gds-code
     5609                                               and bf_before_rvs-line.state-measure-cli-qnty <> ?
     5610         :
     5611           find first bf_after_rvs-doc no-lock where bf_after_rvs-doc.rvs-type = 'после_док':U
     5612                                                 and bf_after_rvs-doc.out-code = pDocCode
     5613                                                 and num-entries(bf_after_rvs-doc.rvs-code, "-") = 3
     5614                                                 and entry(2, bf_after_rvs-doc.rvs-code, "-") = entry(2, bf_before_rvs-doc.rvs-code, "-")
     5615                                                 no-error .
     5616           if not available bf_after_rvs-doc
     5617           then do :
     5618             message
     5619               "Не найдена сверка <<после налива топлива>> "
     5620               "по секции" v-sec ". "
     5621               "Следует удалить сверки и создать их снова. "
     5622             view-as alert-box error .
     5623             return error .
     5624           end .
     5625           find first bf_after_rvs-line no-lock where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     5626                                                  and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     5627                                                  and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     5628                                                  and bf_after_rvs-line.pl-code  = pPlCode
     5629                                                  and bf_after_rvs-line.gds-code = buf_goods.gds-code
     5630                                                  and bf_after_rvs-line.state-measure-cli-qnty <> ?
     5631                                                  no-error .
     5632           if not available bf_after_rvs-line
     5633           then do :
     5634             message
     5635               "Не заполнена сверка «После» по секции " entry(2, bf_after_rvs-doc.rvs-code, "-")
     5636             view-as alert-box .
     5637             return error .
     5638           end .
     5639         end .
     5640       end .
     5641       find first bf_after_rvs-doc no-lock
     5642         where bf_after_rvs-doc.rvs-type = 'после_док':U
     5643           and bf_after_rvs-doc.out-code = pDocCode
     5644           and num-entries(bf_after_rvs-doc.rvs-code, "-") = 3
     5645           and entry(2, bf_after_rvs-doc.rvs-code, "-") = v-sec
     5646         no-error .
     5647       if available bf_after_rvs-doc then do:
     5648         find first bf_after_rvs-line no-lock
     5649           where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     5650             and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     5651             and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     5652             and bf_after_rvs-line.pl-code  = pPlCode
     5653             and bf_after_rvs-line.gds-code = buf_goods.gds-code
     5654           no-error .
     5655         if not available bf_after_rvs-line then do:
     5656           message
     5657             "По данному товару нет заготовки для сверки <<после налива топлива>>"
     5658             "по резервуару" pPlCode "."
     5659             view-as alert-box error .
     5660           return error .
     5661         end.
     5662         if bf_after_rvs-line.state-measure-cli-qnty <> ? then do:
     5663           message
     5664             "Уже задан фактический остаток в сверке <<после налива топлива>>"
     5665             "по резервуару" pPlCode "."
     5666             "Следует удалить сверки и создать их снова."
     5667             view-as alert-box error .
     5668           return error .
     5669         end.
     5670       end.
     5671       else do:
     5672         message "Не создана сверка <<после налива топлива>>." view-as alert-box error .
     5673         return error .
     5674       end.
     5675     end method .
     5676     method private void check-after
     5677       (input pDocCode as character,
     5678        input pGdsCode as integer,
     5679        input pPlCode  as integer)
     5680     :
     5681       define buffer buf_goods         for ub.goods .
     5682       define buffer bf_after_rvs-doc  for ub.rvs-doc  .
     5683       define buffer bf_after_rvs-line for ub.rvs-line .
     5684       define buffer bf_before_rvs-doc  for ub.rvs-doc  .
     5685       define buffer bf_before_rvs-line for ub.rvs-line .
     5686       define buffer bf2_before_rvs-doc  for ub.rvs-doc  .
     5687       define buffer bf2_before_rvs-line for ub.rvs-line .
     5688       define variable ii as integer no-undo .
     5689       define variable v-sec as character no-undo .
     5690       define variable infoSecObj as class InfoSection no-undo .
     5691       find first buf_goods no-lock
     5692         where buf_goods.gds-code = pGdsCode
     5693         .
     5694       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
     5695       v-sec = infoSecObj:SectionName .
     5696       find first bf_before_rvs-doc no-lock
     5697         where bf_before_rvs-doc.rvs-type = 'перед_док':U
     5698           and bf_before_rvs-doc.out-code = pDocCode
     5699           and num-entries(bf_before_rvs-doc.rvs-code, "-") = 3
     5700           and entry(2, bf_before_rvs-doc.rvs-code, "-") = v-sec
     5701         no-error .
     5702       if available bf_before_rvs-doc then do:
     5703         find first bf_before_rvs-line no-lock
     5704           where bf_before_rvs-line.rvs-code = bf_before_rvs-doc.rvs-code
     5705             and bf_before_rvs-line.obj-type = bf_before_rvs-doc.obj-type
     5706             and bf_before_rvs-line.obj-code = bf_before_rvs-doc.obj-code
     5707             and bf_before_rvs-line.pl-code  = pPlCode
     5708             and bf_before_rvs-line.gds-code = pGdsCode
     5709           no-error .
     5710         if not available bf_before_rvs-line then do:
     5711           message
     5712             "По данному товару нет заготовки для сверки <<до налива топлива>>"
     5713             "по резервуару" pPlCode "."
     5714             view-as alert-box error .
     5715           return error .
     5716         end.
     5717         if bf_before_rvs-line.state-measure-cli-qnty = ?
     5718         then do:
     5719           message
     5720             "Не задан фактический остаток в сверке <<до налива топлива>>"
     5721             "по резервуару" pPlCode "." skip
     5722             "Следует удалить сверки и создать их снова."
     5723             view-as alert-box error .
     5724           return error .
     5725         end.
     5726         if bf_before_rvs-line.state-density = ?
     5727         then do:
     5728           message
     5729             "Не задана фактическая плотность в сверке <<до налива топлива>>"
     5730             "по резервуару" pPlCode "." skip
     5731             "Следует удалить сверки и создать их снова."
     5732             view-as alert-box error .
     5733           return error .
     5734         end.
     5735       end.
     5736       else do:
     5737         message "Не создана сверка <<до налива топлива>>." view-as alert-box error .
     5738         return error .
     5739       end.
     5740       for each bf_before_rvs-doc no-lock where bf_before_rvs-doc.rvs-type = 'перед_док':U
     5741                                            and bf_before_rvs-doc.out-code = pDocCode
     5742                                            and num-entries(bf_before_rvs-doc.rvs-code, "-") = 3
     5743                                            and entry(2, bf_before_rvs-doc.rvs-code, "-") <> v-sec
     5744       :
     5745         for each bf_before_rvs-line no-lock where bf_before_rvs-line.rvs-code = bf_before_rvs-doc.rvs-code
     5746                                               and bf_before_rvs-line.obj-type = bf_before_rvs-doc.obj-type
     5747                                               and bf_before_rvs-line.obj-code = bf_before_rvs-doc.obj-code
     5748                                               and bf_before_rvs-line.pl-code  = pPlCode
     5749                                               and bf_before_rvs-line.gds-code = buf_goods.gds-code
     5750                                               and bf_before_rvs-line.state-measure-cli-qnty <> ?
     5751         :
     5752           find first bf_after_rvs-doc no-lock where bf_after_rvs-doc.rvs-type = 'после_док':U
     5753                                                 and bf_after_rvs-doc.out-code = pDocCode
     5754                                                 and num-entries(bf_after_rvs-doc.rvs-code, "-") = 3
     5755                                                 and entry(2, bf_after_rvs-doc.rvs-code, "-") = entry(2, bf_before_rvs-doc.rvs-code, "-")
     5756                                                 no-error .
     5757           if not available bf_after_rvs-doc
     5758           then do :
     5759             message
     5760               "Не найдена сверка <<после налива топлива>> "
     5761               "по секции" v-sec ". "
     5762               "Следует удалить сверки и создать их снова. "
     5763             view-as alert-box error .
     5764             return error .
     5765           end .
     5766           find first bf_after_rvs-line no-lock where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     5767                                                  and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     5768                                                  and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     5769                                                  and bf_after_rvs-line.pl-code  = pPlCode
     5770                                                  and bf_after_rvs-line.gds-code = buf_goods.gds-code
     5771                                                  and bf_after_rvs-line.state-measure-cli-qnty <> ?
     5772                                                  no-error .
     5773           if not available bf_after_rvs-line
     5774           then do :
     5775             message
     5776               "Не заполнена сверка «После» по секции " entry(2, bf_after_rvs-doc.rvs-code, "-")
     5777             view-as alert-box .
     5778             return error .
     5779           end .
     5780         end .
     5781       end .
     5782       find first bf_after_rvs-doc no-lock
     5783         where bf_after_rvs-doc.rvs-type = 'после_док':U
     5784           and bf_after_rvs-doc.out-code = pDocCode
     5785           and num-entries(bf_after_rvs-doc.rvs-code, "-") = 3
     5786           and entry(2, bf_after_rvs-doc.rvs-code, "-") = v-sec
     5787         no-error .
     5788       if available bf_after_rvs-doc
     5789       then do:
     5790         find first bf_after_rvs-line no-lock
     5791           where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     5792             and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     5793             and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     5794             and bf_after_rvs-line.pl-code  = pPlCode
     5795             and bf_after_rvs-line.gds-code = buf_goods.gds-code
     5796           no-error .
     5797         if available bf_after_rvs-line
     5798         then do :
     5799           for each bf2_before_rvs-doc no-lock where bf2_before_rvs-doc.rvs-type = 'перед_док':U
     5800                                                 and bf2_before_rvs-doc.out-code = pDocCode
     5801                                                 and num-entries(bf2_before_rvs-doc.rvs-code, "-") = 3
     5802                                                 and entry(2, bf2_before_rvs-doc.rvs-code, "-") <> v-sec
     5803           :
     5804             find first bf2_before_rvs-line no-lock where bf2_before_rvs-line.rvs-code = bf2_before_rvs-doc.rvs-code
     5805                                                      and bf2_before_rvs-line.obj-type = bf2_before_rvs-doc.obj-type
     5806                                                      and bf2_before_rvs-line.obj-code = bf2_before_rvs-doc.obj-code
     5807                                                      and bf2_before_rvs-line.pl-code  = pPlCode
     5808                                                      and bf2_before_rvs-line.gds-code = buf_goods.gds-code
     5809                                                      and bf2_before_rvs-line.state-measure-cli-qnty <> ?
     5810                                                      and ((bf2_before_rvs-line.real-date > bf_after_rvs-line.real-date)
     5811                                                        or (bf2_before_rvs-line.real-date = bf_after_rvs-line.real-date
     5812                                                        and bf2_before_rvs-line.real-time > bf_after_rvs-line.real-time))
     5813                                                      no-error .
     5814             if available bf2_before_rvs-line
     5815             then do :
     5816               message
     5817                 "Уже заполнена сверка «До» по секции " entry(2, bf2_before_rvs-doc.rvs-code, "-")
     5818                 " Следует удалить сверки и создать их снова. "
     5819               view-as alert-box .
     5820               return error .
     5821             end .
     5822           end .
     5823         end .
     5824       end .
     5825     end method .
     5826     method void return-rvs-qnty
     5827       (input pDocCode as character,
     5828        input pGdsCode as integer,
     5829        input pPlCode  as integer,
     5830        output p-rvs-qnty-before     like ub.rvs-line.state-measure-qnty,
     5831        output p-rvs-qnty-after      like ub.rvs-line.state-measure-qnty,
     5832        output p-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty,
     5833        output p-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty)
     5834     :
     5835       define buffer bf_bef_rvs-doc  for ub.rvs-doc  .
     5836       define buffer bf_aft_rvs-doc  for ub.rvs-doc  .
     5837       define buffer bf_bef_rvs-line for ub.rvs-line .
     5838       define buffer bf_aft_rvs-line for ub.rvs-line .
     5839       define variable v-sec as character no-undo .
     5840       define variable infoSecObj as class InfoSection no-undo .
     5841       infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
     5842       v-sec = infoSecObj:SectionName .
     5843       assign
     5844         p-rvs-qnty-before     = 0.0
     5845         p-rvs-qnty-after      = 0.0
     5846         p-rvs-cli-qnty-before = 0.0
     5847         p-rvs-cli-qnty-after  = 0.0
     5848       .
     5849       find first bf_bef_rvs-doc no-lock
     5850         where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     5851           and bf_bef_rvs-doc.out-code = pDocCode
     5852           and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 3
     5853           and entry(2, bf_bef_rvs-doc.rvs-code, "-") = v-sec
     5854         no-error .
     5855       if available bf_bef_rvs-doc then do:
     5856         for each bf_bef_rvs-line no-lock
     5857           where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     5858             and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     5859             and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     5860             and bf_bef_rvs-line.gds-code = pGdsCode
     5861             and bf_bef_rvs-line.pl-code  = pPlCode
     5862         :
     5863           assign
     5864             p-rvs-qnty-before     = p-rvs-qnty-before     + bf_bef_rvs-line.state-measure-qnty
     5865             p-rvs-cli-qnty-before = p-rvs-cli-qnty-before + bf_bef_rvs-line.state-measure-cli-qnty
     5866           .
     5867         end.
     5868       end.
     5869       find first bf_aft_rvs-doc no-lock
     5870         where bf_aft_rvs-doc.rvs-type = 'после_док':U
     5871           and bf_aft_rvs-doc.out-code = pDocCode
     5872           and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 3
     5873           and entry(2, bf_aft_rvs-doc.rvs-code, "-") = v-sec
     5874         no-error .
     5875       if available bf_aft_rvs-doc then do:
     5876         for each bf_aft_rvs-line no-lock
     5877           where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     5878             and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     5879             and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     5880             and bf_aft_rvs-line.gds-code = pGdsCode
     5881             and bf_aft_rvs-line.pl-code  = pPlCode
     5882         :
     5883           assign
     5884             p-rvs-qnty-after     = p-rvs-qnty-after     + bf_aft_rvs-line.state-measure-qnty
     5885             p-rvs-cli-qnty-after = p-rvs-cli-qnty-after + bf_aft_rvs-line.state-measure-cli-qnty
     5886           .
     5887         end.
     5888       end.
     5889     end method .
     5890     method logical chk-asi-polling
     5891       (input is-bef as log )
     5892     :
     5893       define buffer bf_rsv for ub.rvs-doc .
     5894       define variable v-sec as character no-undo .
     5895       v-sec = infoSecsObj:GetInfoSectionProp(idSecTabPage):SectionName .
     5896       find first bf_rsv
     5897         no-lock where bf_rsv.rvs-type = (if is-bef then 'перед_док':U else 'после_док':U)
     5898         and bf_rsv.out-code = infoSecsObj:TrnDocNum
     5899         and num-entries(bf_rsv.rvs-code, "-") = 3
     5900         and entry(2, bf_rsv.rvs-code, "-") = v-sec
     5901         and bf_rsv.state-measure-qnty <> ?
     5902         no-error .
     5903       if available (bf_rsv) and not infoSecsObj:lRepeatAsi
     5904         then
     5905       do:
     5906         message
     5907           infoSecsObj:mRepeatAsi
     5908           view-as alert-box information title "".
     5909         return no .
     5910       end.
     5911       else return yes.
     5912     end method .
     5913     method character db-attr-value
     5914       (input pDbNum as integer,
     5915        input pAttrCode as character)
     5916     :
     5917       define buffer buf_db-attr for ub.db-attr .
     5918       find first buf_db-attr no-lock
     5919         where buf_db-attr.db-num    = pDbNum
     5920           and buf_db-attr.attr-code = pAttrCode
     5921         no-error .
     5922       if avail buf_db-attr then do:
     5923         return buf_db-attr.attr-value .
     5924       end.
     5925       return "" .
     5926     end method .
     5927     destructor public tanksection ( ):
     5928     end destructor.
     5929   end class.
