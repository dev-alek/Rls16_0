     3156     @VisualDesigner.
     3157     method private void KeyPressMaskTBInt( input sender as System.Object, input e as System.Windows.Forms.KeyPressEventArgs, maxLenthInt as int):
     3158       def var v-asc as int no-undo.
     3159       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
     3160       def var startcursor as int no-undo.
     3161       v-maskTextBox = cast(sender, System.Windows.Forms.MaskedTextBox).
     3162       startcursor = v-maskTextBox:SelectionStart.
     3163       e:Handled = true.
     3164       e:Handled = not isSpecKey(e:KeyChar).
     3165       if not e:Handled
     3166         then return.
     3167       e:Handled = not isNumeral(e:KeyChar).
     3168       if not e:Handled
     3169       then do:
     3170         if length (v-maskTextBox:Text) < maxLenthInt
     3171         then do:
     3172           return.
     3173         end.
     3174         else do:
     3175           if length (v-maskTextBox:Text) > maxLenthInt - 1
     3176           then do:
     3177             v-maskTextBox:Text = substring (v-maskTextBox:Text, 1, length (v-maskTextBox:Text) - 1 ).
     3178             if v-maskTextBox:Text = ""
     3179               then v-maskTextBox:Text = "0".
     3180             if startcursor = maxLenthInt
     3181               then startcursor = startcursor - 1.
     3182           end.
     3183           v-maskTextBox:Text = this-object:ValueChgToInt (v-maskTextBox:Text, maxLenthInt, input-output startcursor).
     3184         end.
     3185         v-maskTextBox:SelectionStart = startcursor.
     3186       end.
     3187     end.
     3188     @VisualDesigner.
     3189     method private void KeyPressMaskTBIntNegativeNum( input sender as System.Object, input e as System.Windows.Forms.KeyPressEventArgs, maxLenthInt as int):
     3190       def var v-maskTextBox as System.Windows.Forms.MaskedTextBox no-undo.
