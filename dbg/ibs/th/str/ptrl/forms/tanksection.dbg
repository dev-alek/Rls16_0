      952     @VisualDesigner.
      953     method private void buttonPl_Click( input sender as System.Object, input e as System.EventArgs ):
      954       define buffer buf_place for ub.place .
      955       define buffer buf2_place for ub.place .
      956       define buffer buf_place-attr for ub.place-attr .
      957       define buffer buf2_place-attr for ub.place-attr .
      958       define variable ii as integer no-undo .
      959       define variable v-str as character no-undo .
      960       define variable v-is-main as logical no-undo .
      961       define variable v-com-tanks as character no-undo .
      962       run str/place-list.w
      963       ( input infoSecsObj:ObjType,
      964         input infoSecsObj:ObjCode,
      965         input infoSecsObj:GdsCode,
      966         input-output v-str
      967       ).
      968       if maskedTextBoxListTank:text = v-str
      969       then do :
      970         return .
      971       end .
      972       find first buf_place no-lock where buf_place.obj-type = infoSecsObj:ObjType
      973                                      and buf_place.obj-code = infoSecsObj:ObjCode
      974                                      and buf_place.loc1     = v-str
      975                                      and buf_place.status_  = ""
      976                                      no-error .
      977       if not available buf_place
      978       then do :
      979         return error .
      980       end .
      981       for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-is-main"
      982                                           and buf_place-attr.obj-code = buf_place.obj-code
      983                                           and buf_place-attr.obj-type = buf_place.obj-type
      984                                           and buf_place-attr.pl-code  = buf_place.pl-code
      985       :
      986         v-is-main = logical(buf_place-attr.attr-value) .
      987       end .
      988       if not v-is-main
      989       then do :
      990         for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-com-tanks"
      991                                             and buf_place-attr.obj-code = buf_place.obj-code
      992                                             and buf_place-attr.obj-type = buf_place.obj-type
      993                                             and buf_place-attr.pl-code  = buf_place.pl-code
      994         :
      995           assign v-com-tanks = buf_place-attr.attr-value .
      996         end .
      997         do ii = 1 to num-entries(v-com-tanks) :
      998           find first buf2_place no-lock where buf2_place.obj-type = buf_place.obj-type
      999                                           and buf2_place.obj-code = buf_place.obj-code
     1000                                           and buf2_place.loc1     = entry(ii, v-com-tanks)
     1001                                           and buf2_place.status_  = ""
     1002                                           no-error .
     1003           if available buf2_place
     1004           then do :
     1005             for first buf2_place-attr no-lock where buf2_place-attr.attr-code = "place-is-main"
     1006                                                 and buf2_place-attr.obj-code  = buf2_place.obj-code
     1007                                                 and buf2_place-attr.obj-type  = buf2_place.obj-type
     1008                                                 and buf2_place-attr.pl-code   = buf2_place.pl-code
     1009             :
     1010               if logical(buf2_place-attr.attr-value)
     1011               then do :
     1012                 v-str = buf2_place.loc1 .
     1013                 leave .
     1014               end .
     1015             end .
     1016           end .
     1017         end .
     1018       end .
     1019       if maskedTextBoxListTank:text = v-str
     1020       then do :
     1021         return .
     1022       end .
     1023       infoSecsObj:PlChanged = yes .
     1024       maskedTextBoxListTank:text = v-str.
     1025       infoSecsObj:GetInfoSectionProp(idSecTabPage).
     1026       infoSecsObj:InfoSectionCurr:ListTank = maskedTextBoxListTank:text .
     1027       return.
     1028     end method.
