     4228     method private void ShowMsg (arg as char):
     4229       message arg view-as alert-box information title "Сообщение".
     4230     end.
     4231   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4232   method private logical cur-time (output p-today as date,
     4233                                    output p-time  as integer ):
     4234     do
     4235     on error undo, return error
     4236     :
     4237       define variable v-date1 as date      no-undo .
     4238       define variable v-date2 as date      no-undo .
     4239       define variable v-time  as integer   no-undo .
     4240       assign
     4241         v-date1 = today
     4242         v-time  = time
     4243         v-date2 = today
     4244       .
     4245       if v-date1 <> v-date2
     4246       then do:
     4247         assign
     4248           v-date1 = today
     4249           v-time  = v-time
     4250         .
     4251       end.
     4252       assign
     4253         p-today = v-date1
     4254         p-time  = v-time
     4255       .
     4256     end.
     4257   end.
     4258   method private character  cur-time-date ()
     4259   :
     4260     return string(today, '99/99/9999':U) .
     4261   end.
     4262   method private decimal cur-time-mjd ()
     4263   :
     4264     define variable v-date as date      no-undo .
     4265     define variable v-time as integer   no-undo .
     4266     cur-time
     4267       (output v-date
     4268       ,output v-time
     4269       ) .
     4270     return integer(v-date) - 2400002 + (v-time / 86400) .
     4271   end.
     4272   method private integer cur-time-get-ending-index
     4273   (input p-number as integer
     4274   )
     4275   :
     4276     if p-number < 0
     4277     or p-number = ?
     4278     then do:
     4279       return 1 .
     4280     end.
     4281     define variable v-rest as integer   no-undo .
     4282     assign
     4283       p-number = p-number modulo 100
     4284     .
     4285     if p-number < 20
     4286     then do:
     4287       assign
     4288         v-rest = p-number
     4289       .
     4290     end.
     4291     else do:
     4292       assign
     4293         v-rest = p-number modulo 10
     4294       .
     4295     end.
     4296     case v-rest :
     4297       when 1
     4298       then do:
     4299         return 2 .
     4300       end.
     4301       when 2 or
     4302       when 3 or
     4303       when 4
     4304       then do:
     4305         return 3 .
     4306       end.
     4307       otherwise do:
     4308         return 1 .
     4309       end.
     4310     end case .
     4311   end.
     4312   method private character cur-time-mjd-to-date(
     4313     input  i-mjd-diff as decimal
     4314   ,output  o-Date     as date
     4315   ,output  o-Time     as integer):
     4316      define variable v-day-number as integer   no-undo .
     4317      if    i-mjd-diff < 0
     4318         or i-mjd-diff = ?
     4319      then do:
     4320         return "?" .
     4321      end.
     4322      assign
     4323         v-day-number = truncate(i-mjd-diff,0).
     4324         o-Date = date(v-day-number + 2400002).
     4325         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     4326     .
     4327   end.
     4328   method private character cur-time-mjd-to-string
     4329   (input p-mjd-diff as decimal
     4330   )
     4331   :
     4332     define variable v-day-number as integer   no-undo .
     4333     define variable v-seconds    as integer   no-undo .
     4334     define variable v-hour       as integer   no-undo .
     4335     define variable v-min        as integer   no-undo .
     4336     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     4337     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     4338     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     4339     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     4340     if p-mjd-diff < 0
     4341     or p-mjd-diff = ?
     4342     then do:
     4343       return "?" .
     4344     end.
     4345     assign
     4346       v-day-number = integer(truncate(p-mjd-diff,0))
     4347       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     4348     .
     4349     if v-seconds > 86400
     4350     then do:
     4351       assign
     4352         v-seconds = 86400 - 1
     4353       .
     4354     end.
     4355     if v-seconds < 0
     4356     then do:
     4357       assign
     4358         v-seconds = 0
     4359       .
     4360     end.
     4361     assign
     4362       v-hour = truncate(v-seconds / 3600, 0)
     4363     .
     4364     assign
     4365       v-seconds = v-seconds modulo 3600
     4366     .
     4367     assign
     4368       v-min = truncate(v-seconds / 60, 0)
     4369     .
     4370     assign
     4371       v-seconds = v-seconds modulo 60
     4372     .
     4373     return
     4374         (if v-day-number <> 0
     4375           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     4376           else ""
     4377         )
     4378       + (if v-day-number <> 0 or v-hour <> 0
     4379           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     4380           else ""
     4381         )
     4382       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     4383           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     4384           else ""
     4385         )
     4386       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     4387       .
     4388   end.
     4389   method private character cur-time-string ()
     4390   :
     4391     define variable v-date as date      no-undo .
     4392     define variable v-time as integer   no-undo .
     4393     cur-time
     4394       (output v-date
     4395       ,output v-time
     4396       ) .
     4397     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     4398   end.
     4399   method private character cur-time-string-sec ()
     4400   :
     4401     define variable v-date as date      no-undo .
     4402     define variable v-time as integer   no-undo .
     4403     cur-time
     4404       (output v-date
     4405       ,output v-time
     4406       ) .
     4407     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     4408   end.
     4409   method private character cur-time-custom
     4410   (input p-prefix as character
     4411   ,input p-date-format as character
     4412   ,input p-delimiter as character
     4413   ,input p-time-format as character
     4414   ,input p-suffix as character
     4415   )
     4416   :
     4417     define variable v-date as date      no-undo .
     4418     define variable v-time as integer   no-undo .
     4419     cur-time
     4420       (output v-date
     4421       ,output v-time
     4422       ) .
     4423     return
     4424       p-prefix
     4425       + string(v-date, p-date-format)
     4426       + p-delimiter
     4427       + string(v-time, p-time-format)
     4428       + p-suffix
     4429       .
     4430   end.
     4431   method private character cur-time-print ()
     4432   :
     4433     define variable v-date as date      no-undo .
     4434     define variable v-time as integer   no-undo .
     4435     cur-time
     4436       (output v-date
     4437       ,output v-time
     4438       ) .
     4439     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     4440   end.
     4441   method private datetime cur-time-datetime ()
     4442   :
     4443     define variable v-char as character no-undo .
     4444     define variable v-datetime as datetime no-undo .
     4445     v-char = cur-time-string().
     4446     v-datetime = datetime(v-char).
     4447     return  v-datetime.
     4448   end.
     4449   method private character cur-time-string-msec ()
     4450   :
     4451     define variable v-date as datetime  no-undo .
     4452     v-date = now.
     4453     return string(v-date) .
     4454   end.
     4455     method private void ActionRvsSec
     4456       (input pAction as character,
     4457        input pActionType as character,
     4458        input pRvsType as character)
     4459     :
     4460       define buffer buf_doc-line for ub.doc-line.
     4461       block_tr:
     4462       do transaction
     4463       :
     4464         define variable v-pl-code      like ub.place.pl-code    no-undo .
     4465         define variable v-rvs-code     like ub.rvs-doc.rvs-code no-undo .
     4466         define variable v-act-name     as   character           no-undo .
     4467         define variable v-log          as   logical             no-undo .
     4468         define variable v-count-doc-pl as   integer             no-undo .
     4469         define variable is-rvs-place   as   logical             no-undo .
     4470         define variable varnum         as   integer             no-undo.
     4471         define variable varcur-rvs     as   integer             no-undo.
     4472         define variable v-today        as   date                no-undo.
     4473         define variable v-time         as   integer             no-undo.
     4474         define variable v-value        as character no-undo .
     4475         define variable v-value2       as character no-undo .
     4476         define variable v-ok           as logical   no-undo .
     4477         define variable ii             as integer   no-undo .
     4478         define variable v-com-vessel-rvs as logical no-undo init no .
     4479         define variable v-com-vessel-is-meas as logical no-undo init no .
     4480         define variable v-code         as character    no-undo.
     4481         define variable is-com-tanks   as logical no-undo init no .
     4482         define variable v-pump-err     as character no-undo init "" .
     4483         define buffer buf_rvs-doc       for ub.rvs-doc .
     4484         define buffer buf_rvs-line      for ub.rvs-line .
     4485         define buffer buf_rvs-line-pump for ub.rvs-line-pump .
     4486         define buffer buf_place         for ub.place .
     4487         define buffer buf_place-attr    for ub.place-attr .
     4488         define buffer buf2_place        for ub.place .
     4489         define buffer buf_goods         for ub.goods .
     4490         define buffer bf_pump-nozzle    for ub.pump-nozzle.
     4491         define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     4492         define buffer bf_pl-gds         for ub.pl-gds.
     4493         define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     4494         define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     4495         define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4496         define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4497         define variable v-rvs-density         like ub.rvs-line.state-density          no-undo .
     4498         define variable v-attr-type           as character no-undo .
     4499         define variable v-attr-value          as character   no-undo .
     4500         define variable v-delta-mass-qnty as decimal   no-undo .
     4501         define variable v-com-tank-delta-mass-qnty as decimal   no-undo .
     4502         define variable v-asi-ip  as character no-undo .
     4503         define variable v-asi-port as character no-undo .
     4504         define variable v-asi-type as character no-undo .
     4505         define variable ptoldfilvalue          as character    no-undo.
     4506         define variable ptoldfiltype           as character    no-undo.
     4507         define variable v-prt-start-real-date  like ub.rvs-line.real-date    no-undo .
     4508         define variable v-prt-start-real-time  like ub.rvs-line.real-time    no-undo .
     4509         define variable v-prt-end-real-date    like ub.rvs-line.real-date    no-undo .
     4510         define variable v-prt-end-real-time    like ub.rvs-line.real-time    no-undo .
     4511         define variable infoSecObj as class InfoSection .
     4512         define variable v-pl-list      as character no-undo init "":U .
     4513         define variable v-com-tanks    as character no-undo init "":U .
     4514         define variable pl-rvd-dens as logical no-undo .
     4515         define variable pl-rvd-lvl as logical no-undo .
     4516         define variable pl-rvd-temp as logical no-undo .
     4517         define variable waitForm as class ibs.th.str.ptrl.forms.waitform no-undo.
     4518         infoSecObj = infoSecsObj:GetInfoSectionProp(idSecTabPage) .
     4519         find first buf_rvs-doc exclusive-lock
     4520           where buf_rvs-doc.rvs-type = pRvsType
     4521             and buf_rvs-doc.out-code = infoSecsObj:TrnDocNum
     4522             and num-entries(buf_rvs-doc.rvs-code, "-") = 3
     4523             and entry(2, buf_rvs-doc.rvs-code, "-") = infoSecObj:SectionName
     4524           no-error .
     4525         if not available buf_rvs-doc then do:
     4526           message
     4527             "Не зафиксированы книжные кол-ва и не созданы документы сверки по складскому документу." skip
     4528             view-as alert-box error .
     4529           undo block_tr, return error .
     4530         end.
     4531         find first buf_goods no-lock where buf_goods.gds-code = infoSecsObj:GdsCode .
     4532   run conf-rd in ibs.th.gbl.gbl-hndllib:g#library
     4533     (input  'ptoldfil'
     4534     ,input  buf_rvs-doc.host-code
     4535     ,input  buf_rvs-doc.obj-type
     4536     ,input  buf_rvs-doc.obj-code
     4537     ,input  ''
     4538     ,input  ''
     4539     ,input  ''
     4540     ,input  no
     4541     ,output ptoldfilvalue
     4542     ,output ptoldfiltype
     4543     ) no-error .
     4544         assign v-pl-code = ? .
     4545         if pAction = 'ПРОСМОТР':U
     4546         then do :
     4547           for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4548                                           and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4549                                           and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4550                                           and buf_rvs-line.gds-code = buf_goods.gds-code
     4551           :
     4552             assign
     4553               v-pl-code      = buf_rvs-line.pl-code
     4554               v-pl-list      = v-pl-list + string(buf_rvs-line.pl-code) + ","
     4555             .
     4556           end .
     4557           if v-pl-code = ?
     4558           then do :
     4559             message
     4560               "Не найдена строка сверки:" skip
     4561               substitute( "товар &1", buf_goods.gds-code ) skip
     4562               substitute( "место хранения &1", infoSecObj:ListTank ) skip
     4563               view-as alert-box error .
     4564             undo block_tr, return error .
     4565           end .
     4566         end .
     4567         else do :
     4568           for first buf_place no-lock where buf_place.obj-type = buf_rvs-doc.obj-type
     4569                                         and buf_place.obj-code = buf_rvs-doc.obj-code
     4570                                         and buf_place.loc1 = infoSecObj:ListTank
     4571                                         and buf_place.status_ = ""
     4572           :
     4573             assign
     4574               v-pl-code = buf_place.pl-code
     4575               v-pl-list = v-pl-list + string(buf_place.pl-code) + ","
     4576               v-com-tanks = ""
     4577             .
     4578             for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-com-tanks"
     4579                                                 and buf_place-attr.obj-code = buf_place.obj-code
     4580                                                 and buf_place-attr.obj-type = buf_place.obj-type
     4581                                                 and buf_place-attr.pl-code  = buf_place.pl-code
     4582             :
     4583               assign v-com-tanks = buf_place-attr.attr-value .
     4584             end .
     4585             if pActionType = "edit"
     4586             then
     4587             do ii = 1 to num-entries(v-com-tanks) :
     4588               for each buf2_place no-lock where buf2_place.obj-type = buf_place.obj-type
     4589                                             and buf2_place.obj-code = buf_place.obj-code
     4590                                             and buf2_place.loc1     = entry(ii, v-com-tanks)
     4591               :
     4592                 for first buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4593                                                  and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4594                                                  and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4595                                                  and buf_rvs-line.pl-code  = buf2_place.pl-code
     4596                                                  and buf_rvs-line.gds-code = buf_goods.gds-code
     4597                 :
     4598                   assign v-pl-list = v-pl-list + string(buf2_place.pl-code) + "," .
     4599                 end .
     4600                 release buf_rvs-line no-error .
     4601               end .
     4602             end .
     4603           end .
     4604         end .
     4605         assign v-pl-list = trim(v-pl-list, ",") .
     4606         if num-entries(v-pl-list) > 1
     4607         or v-pl-code = ?
     4608         then do:
     4609           run ref/pl-gds-list.w
     4610             ( input v-pl-list
     4611             , output v-pl-code
     4612             ) no-error .
     4613           if v-pl-code = ?
     4614           or v-pl-code = 0
     4615           then do:
     4616             message "Не выбрано место хранения " view-as alert-box .
     4617             undo block_tr, return error .
     4618           end.
     4619           if error-status :error then do:
     4620             message
     4621               substitute( "Ошибка при выборе места хранения по товару &1.", buf_goods.gds-code ) skip
     4622               return-value skip
     4623               error-status :get-message(1) skip
     4624               view-as alert-box error .
     4625             undo block_tr, return error .
     4626           end.
     4627         end .
     4628         find first buf_rvs-line
     4629           where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4630             and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4631             and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4632             and buf_rvs-line.pl-code  = v-pl-code
     4633             and buf_rvs-line.gds-code = buf_goods.gds-code
     4634           no-error.
     4635         if not available buf_rvs-line then do:
     4636           message
     4637             substitute( "Не найдена строка сверки по резервуару &1", v-pl-code ) skip
     4638             view-as alert-box error .
     4639           undo block_tr, return error .
     4640         end.
     4641         case pAction :
     4642           when 'ИЗМЕНЕНИЕ':U
     4643           then do:
     4644             if infoSecObj:IsKP
     4645             then do :
     4646               assign
     4647                 v-act-name = 'actn_income_petrol-сommission':U
     4648               .
     4649             end .
     4650             else do :
     4651               find first buf_place no-lock where buf_place.obj-type = buf_rvs-doc.obj-type
     4652                                              and buf_place.obj-code = buf_rvs-doc.obj-code
     4653                                              and buf_place.pl-code  = v-pl-code
     4654                                              no-error .
     4655               if not available buf_place
     4656               then do :
     4657                 undo block_tr, return error return-value .
     4658               end .
     4659               if pActionType = "meas" or not buf_place.is-meas
     4660               then do :
     4661                 assign
     4662                   v-act-name = 'actn_rvs-on-doc_cr-revision':U
     4663                 .
     4664               end .
     4665               else do :
     4666                 for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-rvd-dnsty"
     4667                                                    and buf_place-attr.obj-code = buf_place.obj-code
     4668                                                    and buf_place-attr.obj-type = buf_place.obj-type
     4669                                                    and buf_place-attr.pl-code  = buf_place.pl-code
     4670                 :
     4671                   assign pl-rvd-dens = logical(buf_place-attr.attr-value) no-error .
     4672                 end .
     4673                 for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-rvd-lvl"
     4674                                                    and buf_place-attr.obj-code = buf_place.obj-code
     4675                                                    and buf_place-attr.obj-type = buf_place.obj-type
     4676                                                    and buf_place-attr.pl-code  = buf_place.pl-code
     4677                 :
     4678                   assign pl-rvd-lvl = logical(buf_place-attr.attr-value) no-error .
     4679                 end .
     4680                 for first buf_place-attr no-lock where buf_place-attr.attr-code = "place-rvd-tmp"
     4681                                                    and buf_place-attr.obj-code = buf_place.obj-code
     4682                                                    and buf_place-attr.obj-type = buf_place.obj-type
     4683                                                    and buf_place-attr.pl-code  = buf_place.pl-code
     4684                 :
     4685                   assign pl-rvd-temp = logical(buf_place-attr.attr-value) no-error .
     4686                 end .
     4687                 if buf_place.is-meas
     4688                 and not pl-rvd-dens
     4689                 and not pl-rvd-lvl
     4690                 and not pl-rvd-temp
     4691                 then do :
     4692                   assign
     4693                     v-act-name = 'actn_rvs-on-doc_upd-revision':U
     4694                   .
     4695                 end .
     4696                 else do :
     4697                   assign
     4698                     v-act-name = 'actn_rvs-control_upd-immeas':U
     4699                   .
     4700                 end .
     4701               end .
     4702             end .
     4703             case pRvsType :
     4704               when 'перед_док':U then do:
     4705                 check-before
     4706                   ( input infoSecsObj:TrnDocNum
     4707                    ,input buf_goods.gds-code
     4708                    ,input v-pl-code
     4709                   ) no-error .
     4710                 if error-status :error then do:
     4711                   undo block_tr, return error .
     4712                 end.
     4713               end.
     4714               when 'после_док':U then do:
     4715                 check-after
     4716                   ( input infoSecsObj:TrnDocNum
     4717                    ,input buf_goods.gds-code
     4718                    ,input v-pl-code
     4719                   ) no-error .
     4720                 if error-status :error then do:
     4721                   undo block_tr, return error .
     4722                 end.
     4723               end.
     4724             end case .
     4725           end.
     4726           when 'ПРОСМОТР':U
     4727           then do:
     4728             assign
     4729               v-act-name = 'actn_rvs-on-doc_lookup':U
     4730             .
     4731           end.
     4732         end case.
     4733         if v-act-name <> "":U
     4734         then do:
     4735   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4736   do:
     4737     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
     4738       (input  gbl-var:g#db-num
     4739       ,input  gbl-var:g#userid
     4740       ,input  0
     4741       ,input  v-act-name
     4742       ,input  'object':U
     4743       ,input  buf_rvs-doc.host-code
     4744       ,input  buf_rvs-doc.obj-type
     4745       ,input  buf_rvs-doc.obj-code
     4746       ,input  0
     4747       ,input  0
     4748       ,input  0
     4749       ,input  true
     4750       ,output v-log
     4751       ) no-error .
     4752   end.
     4753           if v-log <> yes then do:
     4754             if pAction = 'ИЗМЕНЕНИЕ':U
     4755             then do :
     4756               message "Не достаточно прав! Работа со сверками запрещена!" view-as alert-box .
     4757             end .
     4758             undo block_tr, return error .
     4759           end.
     4760         end.
     4761         find first buf_rvs-line exclusive-lock
     4762           where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4763             and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4764             and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4765             and buf_rvs-line.pl-code  = v-pl-code
     4766             and buf_rvs-line.gds-code = buf_goods.gds-code
     4767           .
     4768         case pActionType :
     4769           when "meas":U then do:
     4770             for each tt-meas
     4771             :
     4772               delete tt-meas .
     4773             end.
     4774             for each tt-pump-nozzle
     4775             :
     4776               delete tt-pump-nozzle .
     4777             end.
     4778             find buf_place no-lock
     4779               where buf_place.obj-type = buf_rvs-doc.obj-type
     4780                 and buf_place.obj-code = buf_rvs-doc.obj-code
     4781                 and buf_place.pl-code  = v-pl-code
     4782               .
     4783             if v-com-tanks > ""
     4784             then do :
     4785               v-com-vessel-rvs = yes .
     4786               v-com-vessel-is-meas = no .
     4787               v-com-tanks = buf_place.loc1 + "," + v-com-tanks .
     4788               do ii = 1 to num-entries(v-com-tanks) :
     4789                 find first buf_place no-lock where buf_place.obj-type = buf_rvs-doc.obj-type
     4790                                                and buf_place.obj-code = buf_rvs-doc.obj-code
     4791                                                and buf_place.loc1     = entry(ii, v-com-tanks)
     4792                                                and buf_place.status_  = ""
     4793                                                no-error .
     4794                 if available buf_place
     4795                 then do :
     4796                   if buf_place.is-meas
     4797                   then do :
     4798                     v-com-vessel-is-meas = yes .
     4799                     create tt-meas .
     4800                     assign
     4801                       tt-meas.obj-type = buf_rvs-doc.obj-type
     4802                       tt-meas.obj-code = buf_rvs-doc.obj-code
     4803                       tt-meas.pl-code  = buf_place.pl-code
     4804                       tt-meas.loc1     = buf_place.loc1
     4805                     .
     4806                     for each bf_pl-pump-nozzle no-lock where bf_pl-pump-nozzle.obj-type = buf_place.obj-type
     4807                                                          and bf_pl-pump-nozzle.obj-code = buf_place.obj-code
     4808                                                          and bf_pl-pump-nozzle.pl-code  = buf_place.pl-code,
     4809                     first bf_pump-nozzle no-lock where bf_pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     4810                                                    and bf_pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     4811                                                    and bf_pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     4812                                                    and bf_pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     4813                     :
     4814                       create tt-pump-nozzle.
     4815                       assign
     4816                         tt-pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     4817                         tt-pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     4818                         tt-pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     4819                         tt-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     4820                         tt-pump-nozzle.gds-code    = buf_goods.gds-code
     4821                       .
     4822                     end .
     4823                   end .
     4824                 end .
     4825               end .
     4826               if not v-com-vessel-is-meas
     4827               then do :
     4828                 message
     4829                   substitute( 'Ни один из сообщающихся резервуаров не измеряется приборами.', buf_place.pl-code)
     4830                   view-as alert-box error .
     4831                 undo block_tr, return error .
     4832               end .
     4833             end .
     4834             else do :
     4835               if buf_place.is-meas <> yes then do:
     4836                 message
     4837                   substitute( 'Резервуар &1 не измеряется приборами.', buf_place.pl-code)
     4838                   view-as alert-box error .
     4839                 undo block_tr, return error .
     4840               end.
     4841               if buf_place.loc1 = "":U
     4842                 or buf_place.loc1 = ?
     4843               then do:
     4844                 message
     4845                   substitute( 'Не указан локальный код на складском месте &1 .', buf_place.pl-code )
     4846                   view-as alert-box error .
     4847                 undo block_tr, return error .
     4848               end.
     4849               create tt-meas .
     4850               assign
     4851                 tt-meas.obj-type = buf_rvs-doc.obj-type
     4852                 tt-meas.obj-code = buf_rvs-doc.obj-code
     4853                 tt-meas.pl-code  = v-pl-code
     4854               .
     4855               for each bf_pl-pump-nozzle no-lock where bf_pl-pump-nozzle.obj-type = buf_place.obj-type
     4856                                                    and bf_pl-pump-nozzle.obj-code = buf_place.obj-code
     4857                                                    and bf_pl-pump-nozzle.pl-code  = buf_place.pl-code,
     4858               first bf_pump-nozzle no-lock where bf_pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     4859                                              and bf_pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     4860                                              and bf_pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     4861                                              and bf_pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     4862               :
     4863                 create tt-pump-nozzle.
     4864                 assign
     4865                   tt-pump-nozzle.obj-type    = bf_pl-pump-nozzle.obj-type
     4866                   tt-pump-nozzle.obj-code    = bf_pl-pump-nozzle.obj-code
     4867                   tt-pump-nozzle.pump-code   = bf_pl-pump-nozzle.pump-code
     4868                   tt-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
     4869                   tt-pump-nozzle.gds-code    = buf_goods.gds-code
     4870                 .
     4871               end .
     4872             end .
     4873             find first sys-ctrl no-lock.
     4874             v-asi-ip = db-attr-value(sys-ctrl.db,"AsiIp").
     4875             v-asi-port = db-attr-value(sys-ctrl.db,"AsiPort").
     4876             v-asi-type = db-attr-value(sys-ctrl.db,"AsiType").
     4877             if trim(v-asi-ip) <> ''
     4878             and trim(v-asi-port) <> ''
     4879             and trim(v-asi-type) <> ''
     4880             then do :
     4881               case v-asi-type :
     4882                 when "1"
     4883                 then do :
     4884                   varcur-rvs = 2 .
     4885                 end.
     4886                 when "2"
     4887                 then do :
     4888                   varcur-rvs = 3 .
     4889                 end.
     4890               end case .
     4891             end.
     4892             else do :
     4893               if ptoldfilvalue = "yes":U then do:
     4894                 run gbl/d-askw.w
     4895                   ( input "Выбор источника данных с информацией по резервуарам"
     4896                   ,input "Будем читать текущие данные с резервуаров или возьмем данные из файла?"
     4897                   ,input "|^"
     4898                   ,input "Текущие данные|Из файлов|Отмена"
     4899                   ,input "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем"
     4900                   ,input 1
     4901                   ,input 3
     4902                   ,output varnum
     4903                   ) .
     4904                 case varnum :
     4905                   when 1 then do:
     4906                     assign
     4907                       varcur-rvs = 1
     4908                     .
     4909                   end.
     4910                   when 2  then do:
     4911                     assign
     4912                       varcur-rvs = 0
     4913                     .
     4914                   end.
     4915                   when 3 then do:
     4916                     return .
     4917                   end.
     4918                 end case.
     4919               end.
     4920               else do:
     4921                 assign
     4922                   varcur-rvs = 1
     4923                 .
     4924               end.
     4925             end.
     4926             waitForm = new ibs.th.str.ptrl.forms.waitform("~r~nОпрос АСИ...") .
     4927             waitForm:Show() .
     4928   run lib-rvs_rvsplace in ibs.th.gbl.gbl-hndllib:g#lib-rvs ( input              buf_rvs-doc.obj-type ,
     4929                         input              buf_rvs-doc.obj-code ,
     4930                         input              yes ,
     4931                         input              varcur-rvs ,
