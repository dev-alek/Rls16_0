        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.asubjects.
        3   using ibs.th.str.ptrl.*.
        4   using ibs.th.gbl.storage.*.
        5   block-level on error undo, throw.
        6   class ibs.th.str.ptrl.rvsinvsubs inherits asubjects:
        7     define property RvsInvSubCurr as class rvsinvsub
        8       get:
        9         return cast (SubjectObjCurr, rvsinvsub).
       10       end.
       11     define property RvsCode as character no-undo
       12       get.
       13       set.
       14     define property IsRvsInvAlg3 as logical no-undo
       15       get.
       16       set.
       17     define property ObjType as character no-undo
       18       get.
       19       set.
       20     define property ObjCode as integer no-undo
       21       get.
       22       set.
       23     define property MeteringErrWastSum as decimal no-undo
       24       get.
       25       set.
       26     define property NaturWastageSum as decimal no-undo
       27       get.
       28       set.
       29     define property TPWastSum as decimal no-undo
       30       get.
       31       set.
       32     define property DiffSum as decimal no-undo
       33       get.
       34       set.
       35     define property DeficitOverSum as decimal no-undo
       36       get:
       37         return (absolut (DiffSum) - TPWastSum - NaturWastageSum - MeteringErrWastSum).
       38       end.
       39     define property RvsInvStrObj as class rvsinvstr no-undo
       40       get:
       41         if not valid-object ( RvsInvStrObj )
       42           then return new rvsinvstr ().
       43           else return RvsInvStrObj.
       44       end.
       45       set.
       46     method public void CalcSum ():
       47       RvsInvStrObj:CalcSum(this-object).
       48     end method.
       49   end class.
