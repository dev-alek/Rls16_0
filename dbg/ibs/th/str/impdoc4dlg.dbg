       31     method public void setParentproc (input p-parentproc-hdl as handle) :
       32       parparentproc = p-parentproc-hdl .
       33     end method .
       34           @VisualDesigner.
       35           METHOD PRIVATE VOID fileButton_click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
       36     define variable v-file-name as character no-undo .
       37     define variable v-ok        as logical no-undo .
       38     system-dialog get-file v-file-name
       39       filters "Файлы импорта ПН (*.adb)" "*.adb",
       40               "Все файлы (*.*)" "*.*"
       41       title "Выберите файл для импорта накладных"
       42       update v-ok
       43     .
       44     if v-ok then file_name:Text = v-file-name .
       45                   RETURN.
       46           END METHOD.
       47           @VisualDesigner.
       48           METHOD PRIVATE VOID objButton_click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
       49       define variable v-rid-list as character no-undo .
       50       define variable v-rid-rec  as recid no-undo .
       51       define buffer buf_shop for ub.shop .
       52       v-rid-list = "" . // можно взять текущее подразделение
       53       run adm/shops.w ( input parparentproc
       54                        ,input "b-sel"
       55                        ,input-output v-rid-list
       56                        ,no ).
       57       if v-rid-list = "":U then return.
       58       v-rid-rec = integer(v-rid-list) no-error .
       59       find first buf_shop no-lock where recid(buf_shop) = v-rid-rec no-error .
       60       if available buf_shop then code_obj:Text = string (buf_shop.obj-code) .
       61                   RETURN.
       62           END METHOD.
       63     METHOD PRIVATE VOID okButton_Click (sender AS System.Object, e AS System.EventArgs):
       64       assign
       65         fi-file-name   = file_name:Text
       66         fi-obj-type    = 'маг':U
       67         fi-obj-code    = integer(code_obj:Text)
       68         is-doc-close   = cbCloseFact:Checked
       69       no-error .
       70       if fi-file-name = "" then do:
       71         message "Не задан файл импорта" view-as alert-box error .
       72         return .
       73       end .
       74       THIS-OBJECT:DialogResult = System.Windows.Forms.DialogResult:Ok.
       75       THIS-OBJECT:Close ( ).
       76     END METHOD.
       77     METHOD PRIVATE VOID cancelButton_Click (sender AS System.Object, e AS System.EventArgs):
       78       THIS-OBJECT:DialogResult = System.Windows.Forms.DialogResult:Cancel.
       79       THIS-OBJECT:Close ( ).
       80     END METHOD.
