        1   using System.Runtime.InteropServices.ComTypes.IMoniker from assembly.
        2   block-level on error undo, throw.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define input  parameter iParparentproc as handle    no-undo.
        8   define input  parameter iCodeTrg       as class ibs.th.ref.code.code_trg no-undo.
        9   define input  parameter iMode          as character no-undo.
       10   define input  parameter IBuffer        as handle    no-undo.
       11   define output parameter OSave          as logical   no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision:$":U .
       13   define variable vss-author      as character no-undo init "$Author:$":U .
       14   define variable vss-date        as character no-undo init "$Date:$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       16   define variable vss-archive     as character no-undo init "$Archive:$":U .
       17   define variable vss-description as character no-undo init "".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define temp-table tt-code-frm like code
       73     field Frecid as int64 init ?.
       74   define variable mSDedit as class   ibs.th.ref.code.SDedit_ no-undo.
       75   define variable v-ip  as character no-undo .
       76   if iMode = 'ДОБАВЛЕНИЕ':U then do:
       77   define variable v-ok    as logical no-undo .
       78   message "Загрузить список касс?"
       79     view-as alert-box question buttons yes-no update v-ok.
       80   end.
       81   if v-ok = true then
       82   do:
       83     for each ub.cash-desk no-lock where ub.cash-desk.autonomy = 0 and ub.cash-desk.is-del = no:
       84       find first ub.code where ub.Code.parent = "SpravDevice" and ub.Code.code = string(ub.cash-desk.cash-num) no-error .
       85       if not available (ub.Code) then do:
       86         create ub.Code .
       87         assign
       88         ub.Code.code = string(ub.cash-desk.cash-num)
       89         ub.Code.misc9 = string(ub.cash-desk.cash-num)
       90         ub.Code.parent = "SpravDevice"
       91         ub.Code.CodeName = "Касса" + " " + string(ub.cash-desk.cash-num)
       92         .
       93        end.
       94         ub.Code.status_ = 0.
       95         if num-entries(ub.cash-desk.addr-path, chr(4)) > 1 then v-ip = entry(2,ub.cash-desk.addr-path,chr(4)) .
       96         if num-entries (v-ip,":") > 1 then ub.Code.misc1 = entry(1,v-ip,":") + ":" + "8000/hddsmart" . else ub.Code.misc1 = v-ip .
       97   end.
       98     mSDedit = new ibs.th.ref.code.SDedit_(iMode).
       99     OSave = mSDedit:DialogResult = System.Windows.Forms.DialogResult:OK.
      100   end.
      101   else do:
      102     mSDedit = new ibs.th.ref.code.SDedit_(iMode).
      103     mSDedit:bindcode:Handle = IBuffer .
      104     wait-for  mSDedit:ShowDialog() .
      105     OSave = mSDedit:DialogResult = System.Windows.Forms.DialogResult:OK.
      106   end.
      107     finally:
      108       delete object mSDedit.
      109     end finally.
