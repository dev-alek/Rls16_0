        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define input  parameter iParparentproc as handle    no-undo.
        7   define input  parameter iMode          as character no-undo.
        8   define input  parameter iParent        as character no-undo.
        9   define input  parameter iCode          as character no-undo.
       10   define input  parameter ititle         as character no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision:$":U .
       12   define variable vss-author      as character no-undo init "$Author:$":U .
       13   define variable vss-date        as character no-undo init "$Date:$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       15   define variable vss-archive     as character no-undo init "$Archive:$":U .
       16   define variable vss-description as character no-undo init "".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
       72   mCodeTrg = new ibs.th.ref.code.code_trg().
       73   mCodeTrg:formLable(1, 1, "Код").
       74   mCodeTrg:formLable(1, 2, "Наименование").
       75   mCodeTrg:formLable(1, 4, "IP").
       76   mCodeTrg:MaxLevel = 1.
       77   mCodeTrg:parent = left-trim(iparent + chr(4) + icode,chr(4)).
       78   mCodeTrg:startlevel = num-entries(mCodeTrg:parent,chr(4)).
       79   find first code where code.parent eq iparent
       80                     and code.code   eq icode
       81                     no-lock no-error.
       82   if available code
       83   then mCodeTrg:title = code.codename.
       84   mCodeTrg:brwcode().
       85   finally:
       86      delete object mCodeTrg.
       87   end finally.
