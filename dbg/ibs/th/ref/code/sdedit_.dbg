      196   method void proc-alt-shift-f2 ():
      197     if not ibs.th.gbl.gbl-var:rcode
      198   then
      199     run gbl\inidebug.p .
      200   end.
      201   method void proc-alt-shift-f3 ():
      202      define variable vdebugalert   as logical no-undo .
      203      assign
      204         vdebugalert = session:debug-alert
      205         session:debug-alert = yes
      206      .
      207   message program-name( 1 ) skip( 1 )
      208             vss-revision                  skip( 0 )
      209             vss-author                    skip( 0 )
      210             vss-date                      skip( 0 )
      211             vss-workfile                  skip( 0 )
      212             vss-archive                   skip( 1 )
      213             vss-description               skip( 1 )
      214     view-as alert-box title "Текущая программа".
      215     session:debug-alert = vdebugalert.
      216   end.
      217   define variable v-inform-launched as logical no-undo initial false .
