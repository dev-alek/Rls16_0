      221   end .
      222   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      223         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      224         then do:
      225             proc-alt-shift-f3 ().
      226         end.
      227         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      228         then do:
      229             proc-alt-shift-f2 ().
      230         end.
      231   end method.
      232   method private void End_obj_KeyDown():
      233   catch e as Progress.Lang.Error:
      234            undo, throw e.
      235         end catch.
      236   end method.
      237   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      238      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      239      define variable v-curr-sv-date as date no-undo .
      240      define variable v-new-sv-date  as date no-undo .
      241      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      242      then do:
      243         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      244         run gbl/getcurdt.p
      245            (output v-curr-sv-date
      246         ) .
      247         vdate:value = v-curr-sv-date.
      248      end.
      249      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      250      then do:
      251         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      252         v-curr-sv-date = vdate:value .
      253         if v-curr-sv-date = ?
      254         then do:
      255            run gbl/getcurdt.p
      256               (output v-curr-sv-date
      257            ) .
      258         end.
      259         if v-curr-sv-date <> ?
      260         then do:
      261            assign
      262               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      263               vdate:value = v-new-sv-date
      264            .
      265         end.
      266      end.
      267      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      268      then do:
      269         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      270         v-curr-sv-date = vdate:value.
      271         if v-curr-sv-date = ?
      272         then do:
      273            run gbl/getcurdt.p
      274               (output v-curr-sv-date
      275            ) .
      276         end.
      277         if v-curr-sv-date <> ?
      278         then do:
      279            run gbl/lastdate.p
      280               (input  v-curr-sv-date
      281               ,output v-new-sv-date
      282            ).
      283            vdate:value = v-new-sv-date.
      284         end.
      285      end.
      286      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      287      then do:
      288         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      289         define variable v-description   as character no-undo .
      290         define variable v-ok            as logical no-undo.
      291         v-curr-sv-date = vdate:value.
      292         if v-curr-sv-date = ?
      293         then do:
      294            run gbl/getcurdt.p
      295               (output v-curr-sv-date
      296            ) .
      297         end.
      298         if v-curr-sv-date <> ?
      299         then do:
      300            run gbl/d-inpday.w
      301               (input ?
      302               ,input "Выбор даты"
      303               ,input v-description
      304               ,input ""
      305               ,input-output v-curr-sv-date
      306               ,output v-ok
      307            ).
      308            if v-ok = true
      309            then do:
      310               vdate:value = v-curr-sv-date .
      311            end.
      312         end.
      313      end.
      314   end method.
