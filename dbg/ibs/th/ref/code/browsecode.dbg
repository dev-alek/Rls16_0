       80      method private void BrwMode( input imode as character  ):
       81         if iMode eq 'ДОБАВЛЕНИЕ':U
       82         then do:
       83            assign
       84            bedit  :visible = false
       85            this-object:dataGridView1:Columns[0]:Visible = false.
       86         .
       87         end.
       88         else if iMode eq 'ПРОСМОТР':U
       89         then do:
       90            assign
       91            bAdd   :visible = false
       92            bdel   :visible = false
       93            bedit  :visible = false
       94            bexport:visible = false
       95            bimport:visible = false
       96            bselect:visible = false
       97            this-object:dataGridView1:Columns[0]:Visible = false.
       98         .
       99         end.
      100         else if iMode eq 'ВЫБОР':U
      101         then do:
      102            assign
      103            bAdd   :visible = false
      104            bdel   :visible = false
      105            bedit  :visible = false
      106            bexport:visible = false
      107            bimport:visible = false
      108            bselect:visible = true
      109            this-object:dataGridView1:Columns[0]:Visible = yes.
      110         .
      111         end.
      112         else do:
      113            if iMode eq "sysadm"
      114            then assign
      115               bAdd   :visible = yes
      116               bdel   :visible = yes
      117               bedit  :visible = yes
      118               bexport:visible = true
      119               bimport:visible = true
      120               bselect:visible = false
      121            .
      122            this-object:dataGridView1:Columns[0]:Visible = no.
      123         end.
      124         return.
      125      end method.
