        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define input  parameter Parparentproc  as handle    no-undo.
        6   define input  parameter iMode          as character no-undo.
        7   define input  parameter iParent        as character no-undo.
        8   define input  parameter iCode          as character no-undo.
        9   define input  parameter ititle         as character no-undo.
       10   define new global shared variable g#library  as handle no-undo .
       11   define new global shared variable g#library2 as handle no-undo .
       12   define   shared variable g#auto as logical no-undo.
       13   define   shared variable g#news as logical no-undo.
       14   define   shared variable g#oxml as logical no-undo.
       15   define   shared variable g#esys as logical no-undo.
       16   define   shared variable g#news-source-db as integer no-undo.
       17   define   shared variable g#esys-source-esys as integer no-undo.
       18   define   shared variable g#db-num as integer   no-undo .
       19   define   shared variable g#userid as character no-undo .
       20   define   shared variable g#passwd as character no-undo .
       21   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       22     define variable v-cntxt-db-num        as integer   no-undo .
       23     define variable v-cntxt-userid        as character no-undo .
       24     define variable v-cntxt-level         as character no-undo .
       25     define variable v-cntxt-host-code-obj as integer   no-undo .
       26     define variable v-cntxt-obj-type      as character no-undo .
       27     define variable v-cntxt-obj-code      as integer   no-undo .
       28     define variable v-cntxt-db-num-obj    as integer   no-undo .
       29     define variable v-cntxt-is-admin      as logical   no-undo .
       30   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31     run mainmenu_getcntxt in parparentproc
       32       (output v-cntxt-db-num
       33       ,output v-cntxt-userid
       34       ,output v-cntxt-level
       35       ,output v-cntxt-host-code-obj
       36       ,output v-cntxt-obj-type
       37       ,output v-cntxt-obj-code
       38       ,output v-cntxt-db-num-obj
       39       ,output v-cntxt-is-admin
       40       ) .
       41   define variable vss-revision    as character no-undo init "$Revision:$":U .
       42   define variable vss-author      as character no-undo init "$Author:$":U .
       43   define variable vss-date        as character no-undo init "$Date:$":U .
       44   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       45   define variable vss-archive     as character no-undo init "$Archive:$":U .
       46   define variable vss-description as character no-undo init "".
       47   procedure vss-get-info :
       48     define output parameter p-vss-revision    like vss-revision    no-undo .
       49     define output parameter p-vss-author      like vss-author      no-undo .
       50     define output parameter p-vss-date        like vss-date        no-undo .
       51     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       52     define output parameter p-vss-archive     like vss-archive     no-undo .
       53     define output parameter p-vss-description like vss-description no-undo .
       54     assign
       55       p-vss-revision    = vss-revision
       56       p-vss-author      = vss-author
       57       p-vss-date        = vss-date
       58       p-vss-workfile    = vss-workfile
       59       p-vss-archive     = vss-archive
       60       p-vss-description = vss-description
       61     .
       62   end procedure.
       63   procedure vss-get-parameters :
       64     define output parameter p-vss-parameters as character no-undo .
       65   end procedure.
       66   define new global shared variable g#vssrevis-logger as handle    no-undo .
       67   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       68   define variable v-vssrevis-logger                   as handle    no-undo .
       69   procedure vss-logevent :
       70     define input  parameter p-extra-paramters as character no-undo .
       71     define variable v-vssrevis-parameters as character no-undo .
       72     do
       73     on error undo, return error return-value
       74     :
       75       if  valid-handle(v-vssrevis-logger)
       76       and v-vssrevis-logger :get-signature("logevent") <> ""
       77       then do:
       78         run vss-get-parameters in this-procedure
       79           (output v-vssrevis-parameters
       80           ).
       81         run logevent in v-vssrevis-logger
       82           (input vss-workfile
       83           ,input vss-revision
       84           ,input v-vssrevis-parameters
       85           ,input p-extra-paramters
       86           ).
       87       end.
       88     end.
       89   end procedure.
       90   assign
       91     v-vssrevis-logger = g#vssrevis-logger
       92   .
       93   if  valid-handle(v-vssrevis-logger)
       94   and v-vssrevis-logger :get-signature("logevent") <> ""
       95   then do:
       96     assign
       97       v-vssrevis-logevent = true
       98     .
       99     run vss-logevent in this-procedure (input vss-description) .
      100   end.
      101   define new global Shared variable opn_win as logical no-undo init NO.
      102   define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
      103   mCodeTrg = new ibs.th.ref.code.code_trg('ПРОСМОТР':U).
      104   mCodeTrg:formLable(1, 1, "Код").
      105   mCodeTrg:formLable(1, 3, "Файл").
      106   mCodeTrg:formLable(1, 6, "XML").
      107   mCodeTrg:parparentproc = Parparentproc.
      108   mCodeTrg:menuHandle = this-procedure.
      109   mCodeTrg:addMenu(1, "Восстановление файла", ",Экспорт в XML,").
      110   mCodeTrg:parent = "XML_backup".
      111   mCodeTrg:startlevel = num-entries(mCodeTrg:parent, chr(4)).
      112   mCodeTrg:MaxLevel = mCodeTrg:startlevel.
      113   mCodeTrg:title = "Файл для восстановления".
      114   mCodeTrg:filter = " and code.code = " + quoter(icode).
      115   mCodeTrg:Mode = 'ПРОСМОТР':U.
      116   if opn_win = YES then do:
      117       run menuitem_1_2  ( input this-procedure ).
      118   end.
      119   if opn_win = NO then do:
      120      opn_win = YES.
      121      mCodeTrg:brwcode().
      122   end.
      123   finally:
      124       opn_win = NO.
      125   end finally.
      126   procedure menuitem_1_2:
      127      define input  parameter iBuff as handle no-undo.
      128      define variable cSaveFile as character no-undo.
      129      define variable lCommit   as logical   no-undo.
      130      opn_win = YES.
      131      cSaveFile = substring(icode, r-index(icode, " ") + 1).
      132      SYSTEM-DIALOG GET-FILE cSaveFile
      133          TITLE "Сохранить XML-файл"
      134          FILTERS
      135              "XML-файлы (*.xml)" "*.xml",
      136              "Все файлы (*.*)"   "*.*"
      137          ASK-OVERWRITE
      138          SAVE-AS
      139          USE-FILENAME
      140          UPDATE lCommit
      141          DEFAULT-EXTENSION "xml".
      142      IF NOT lCommit THEN RETURN.
      143      cSaveFile = TRIM(cSaveFile).
      144      if index(cSaveFile, " ") > 0 then do:
      145        message "Имя файла не должно содержать пробелы" view-as alert-box .
      146       return.
      147      end.
      148     find first code where code.parent eq iparent and code.code eq icode no-lock no-error.
      149     if available code then do:
      150        define variable RXML as longchar no-undo.
      151        RXML = code.misc3.
      152        copy-lob from RXML to file cSaveFile.
      153        if error-status:error then
      154            message "Ошибка сохранения файла:" view-as alert-box.
      155        else  message  "Файл сохранён:" cSaveFile view-as alert-box .
      156      end.
      157   end.
