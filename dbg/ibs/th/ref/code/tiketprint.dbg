        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define input  parameter Parparentproc  as handle    no-undo.
        6   define input  parameter iMode          as character no-undo.
        7   define input  parameter iParent        as character no-undo.
        8   define input  parameter iCode          as character no-undo.
        9   define input  parameter ititle         as character no-undo.
       10   define new global shared variable g#library  as handle no-undo .
       11   define new global shared variable g#library2 as handle no-undo .
       12   define   shared variable g#auto as logical no-undo.
       13   define   shared variable g#news as logical no-undo.
       14   define   shared variable g#oxml as logical no-undo.
       15   define   shared variable g#esys as logical no-undo.
       16   define   shared variable g#news-source-db as integer no-undo.
       17   define   shared variable g#esys-source-esys as integer no-undo.
       18   define   shared variable g#db-num as integer   no-undo .
       19   define   shared variable g#userid as character no-undo .
       20   define   shared variable g#passwd as character no-undo .
       21   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       22     define variable v-cntxt-db-num        as integer   no-undo .
       23     define variable v-cntxt-userid        as character no-undo .
       24     define variable v-cntxt-level         as character no-undo .
       25     define variable v-cntxt-host-code-obj as integer   no-undo .
       26     define variable v-cntxt-obj-type      as character no-undo .
       27     define variable v-cntxt-obj-code      as integer   no-undo .
       28     define variable v-cntxt-db-num-obj    as integer   no-undo .
       29     define variable v-cntxt-is-admin      as logical   no-undo .
       30   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31     run mainmenu_getcntxt in parparentproc
       32       (output v-cntxt-db-num
       33       ,output v-cntxt-userid
       34       ,output v-cntxt-level
       35       ,output v-cntxt-host-code-obj
       36       ,output v-cntxt-obj-type
       37       ,output v-cntxt-obj-code
       38       ,output v-cntxt-db-num-obj
       39       ,output v-cntxt-is-admin
       40       ) .
       41   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       42   define  temp-table gds-list no-undo like ub.goods
       43     field qnty   as decimal
       44     field to-del as logical
       45     field order-num as integer
       46     field to-sel as logical
       47     field promo-code as character
       48     field ActionId  as int64
       49     field db-num as integer
       50     index art  is primary unique artic prod-type prod-code
       51     index code is         unique gds-code
       52     index oi order-num
       53     index isel to-sel
       54     .
       55   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       56   define    temp-table gds-list-hist no-undo
       57   field list-table as character
       58   field id as integer
       59   field line as integer
       60   field hist-mode as character
       61   field des as character
       62   field num-recs as integer
       63   field option_ as character
       64   field item_ as character
       65   field status_ as character
       66   field num-add as integer
       67   field num-ignored as integer
       68   field done as logical
       69   field err_ as logical
       70   field err-mes as character
       71   index pi is primary
       72   id
       73   line
       74   index isdone
       75   done
       76   .
       77   define variable vss-revision    as character no-undo init "$Revision:$":U .
       78   define variable vss-author      as character no-undo init "$Author:$":U .
       79   define variable vss-date        as character no-undo init "$Date:$":U .
       80   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       81   define variable vss-archive     as character no-undo init "$Archive:$":U .
       82   define variable vss-description as character no-undo init "".
       83   procedure vss-get-info :
       84     define output parameter p-vss-revision    like vss-revision    no-undo .
       85     define output parameter p-vss-author      like vss-author      no-undo .
       86     define output parameter p-vss-date        like vss-date        no-undo .
       87     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       88     define output parameter p-vss-archive     like vss-archive     no-undo .
       89     define output parameter p-vss-description like vss-description no-undo .
       90     assign
       91       p-vss-revision    = vss-revision
       92       p-vss-author      = vss-author
       93       p-vss-date        = vss-date
       94       p-vss-workfile    = vss-workfile
       95       p-vss-archive     = vss-archive
       96       p-vss-description = vss-description
       97     .
       98   end procedure.
       99   procedure vss-get-parameters :
      100     define output parameter p-vss-parameters as character no-undo .
      101   end procedure.
      102   define new global shared variable g#vssrevis-logger as handle    no-undo .
      103   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      104   define variable v-vssrevis-logger                   as handle    no-undo .
      105   procedure vss-logevent :
      106     define input  parameter p-extra-paramters as character no-undo .
      107     define variable v-vssrevis-parameters as character no-undo .
      108     do
      109     on error undo, return error return-value
      110     :
      111       if  valid-handle(v-vssrevis-logger)
      112       and v-vssrevis-logger :get-signature("logevent") <> ""
      113       then do:
      114         run vss-get-parameters in this-procedure
      115           (output v-vssrevis-parameters
      116           ).
      117         run logevent in v-vssrevis-logger
      118           (input vss-workfile
      119           ,input vss-revision
      120           ,input v-vssrevis-parameters
      121           ,input p-extra-paramters
      122           ).
      123       end.
      124     end.
      125   end procedure.
      126   assign
      127     v-vssrevis-logger = g#vssrevis-logger
      128   .
      129   if  valid-handle(v-vssrevis-logger)
      130   and v-vssrevis-logger :get-signature("logevent") <> ""
      131   then do:
      132     assign
      133       v-vssrevis-logevent = true
      134     .
      135     run vss-logevent in this-procedure (input vss-description) .
      136   end.
      137   define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
      138   mCodeTrg = new ibs.th.ref.code.code_trg(
      139    'ДОБАВЛЕНИЕ':U
      140                                           ).
      141   mCodeTrg:formLable(1, 1, "Код товара").
      142   mCodeTrg:formLable(1, 2, "Наименование").
      143   mCodeTrg:formLable(1, 3, "Кол-во").
      144   mCodeTrg:formLable(1, 4, ?).
      145   mCodeTrg:parparentproc = Parparentproc.
      146   mCodeTrg:chek-erpRN = no.
      147   mCodeTrg:menuHandle = this-procedure.
      148   mCodeTrg:addMenu(1, "Печать", "").
      149   mCodeTrg:addMenu(2, "Меню", "Очистить список,Очистить список удаленных").
      150   mCodeTrg:parent = left-trim(iparent + chr(4) + icode,chr(4)).
      151   mCodeTrg:startlevel = num-entries(mCodeTrg:parent,chr(4)).
      152   mCodeTrg:MaxLevel = 1.
      153   mCodeTrg:title = "Печать ценников".
      154   mCodeTrg:brwcode().
      155   finally:
      156      delete object mCodeTrg.
      157   end finally.
      158   procedure menuitem_1:
      159      define input  parameter iBuff as handle no-undo.
      160      empty temp-table gds-list.
      161      for each code where code.parent eq icode
      162                      and code.status_ eq 0
      163      no-lock:
      164         find first goods no-lock where
      165                    goods.gds-code = int(code.code) no-error .
      166         if available goods
      167         then do:
      168            create gds-list.
      169            buffer-copy goods to gds-list.
      170         end.
      171      end.
      172      if avail gds-list
      173      then
      174         run ibs/th/rep/tick-lst.p (input parparentproc,
      175                                    input v-cntxt-obj-type,
      176                                    input v-cntxt-obj-code,
      177                                    input table gds-list).
      178   end.
      179   procedure menuitem_2_1:
      180      define input  parameter iBuff as handle no-undo.
      181      for each code where code.parent eq icode
      182      exclusive-lock:
      183         delete code.
      184      end.
      185   end.
      186   procedure menuitem_2_2:
      187      define input  parameter iBuff as handle no-undo.
      188      for each code where code.parent eq icode
      189                      and code.status_ ne 0
      190      exclusive-lock:
      191         delete code.
      192      end.
      193   end.
