       36           method private void btn_unit_Click( input sender as System.Object, input e as System.EventArgs ):
       37         define buffer units for units.
       38         define variable vRec as recid no-undo .
       39         do on error undo, return no-apply:
       40            run ref/units.w
       41                  (input  parparentproc
       42                  ,input  yes
       43                  ,output vRec
       44                  ).
       45            if vRec <> ? then do:
       46               find first units where recid(units) = vRec no-lock no-error.
       47               if avail units then do:
       48                  this-object:mUnit:Text = units.unit-name.
       49                  this-object:mUnit:focus().
       50               end.
       51            end.
       52         end.
       53         return.
       54           end method.
