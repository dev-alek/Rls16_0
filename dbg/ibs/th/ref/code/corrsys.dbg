        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   define input  parameter iParparentproc as handle    no-undo.
       18   define input  parameter iMode          as character no-undo.
       19   define input  parameter iParent        as character no-undo.
       20   define input  parameter iCode          as character no-undo.
       21   define input  parameter ititle         as character no-undo.
       22   define variable vss-revision    as character no-undo init "$Revision:$":U .
       23   define variable vss-author      as character no-undo init "$Author:$":U .
       24   define variable vss-date        as character no-undo init "$Date:$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       26   define variable vss-archive     as character no-undo init "$Archive:$":U .
       27   define variable vss-description as character no-undo init "".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define variable mCodeTrg as class ibs.th.ref.code.code_trg no-undo.
       83   mCodeTrg = new ibs.th.ref.code.code_trg().
       84   mCodeTrg:formLable(1, 1, "Код").
       85   mCodeTrg:formLable(1, 2, "Наименование").
       86   mCodeTrg:MaxLevel = 1.
       87   mCodeTrg:Mode = imode.
       88   mCodeTrg:chek-erpRN = g#db-num ne 0.
       89   mCodeTrg:nwsGbd = yes.
       90   if imode = 'ВЫБОР':U then do:
       91   mCodeTrg:formLable(1, 1, "").
       92   end.
       93   mCodeTrg:parent = left-trim(iparent + chr(4) + icode,chr(4)).
       94   mCodeTrg:startlevel = num-entries(mCodeTrg:parent,chr(4)).
       95   find first code where code.parent eq iparent
       96                     and code.code   eq icode
       97                     no-lock no-error.
       98   if available code
       99   then mCodeTrg:title = code.codename.
      100   mCodeTrg:brwcode().
      101   finally:
      102      delete object mCodeTrg.
      103   end finally.
