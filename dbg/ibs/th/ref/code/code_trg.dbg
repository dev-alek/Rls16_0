        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.code.code_trg final:
        4      define temp-table tt-query no-undo
        5         field NameQuery as character
        6         field hQuery    as handle
        7     index NameQuery NameQuery.
        8     define temp-table tt-SaveParam no-undo
        9         field LevelSave   as integer
       10         field MaxLevel    as integer
       11         field chek-erpRN  as logical
       12     index LevelSave LevelSave.
       13     define temp-table tt-form no-undo
       14         field f-level    as integer
       15         field f-numfield as integer
       16         field f-brwname  as character
       17         field f-SetLevel as integer
       18     index indForm f-level f-numfield .
       19     define temp-table tt-menu no-undo
       20         field f-num    as integer
       21         field f-lable  as character
       22         field f-list   as character
       23     index f-num f-num .
       24     define temp-table tt-code-brw no-undo like code
       25       field Frecid as int64 init ?
       26       field fstatus as character
       27       field fchange as logical
       28       .
       29     define temp-table tt-code-frm no-undo like code
       30       field Frecid as int64 init ?.
       31    define  temp-table tmprecid
       32       field Frecid as recid init ?
       33       field fnum as character
       34       field fTable as character
       35    index num  fnum Frecid
       36    index itable is primary unique fTable Frecid
       37    .
       38   define variable fSelect as logical no-undo format "*/" column-label "".
       39   method public logical isSelect
       40       (iBuffer as handle  ):
       41       define buffer tmprecid for tmprecid.
       42       if iBuffer:available
       43       then
       44          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       45                                and tmprecid.Frecid = iBuffer:recid
       46          no-lock no-error.
       47       return available tmprecid.
       48    end.
       49   method public logical setSelect
       50       (iBuffer as handle  ):
       51       define buffer tmprecid for tmprecid.
       52       if iBuffer:available
       53       then do:
       54          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       55                                and tmprecid.Frecid = iBuffer:recid
       56          no-lock no-error.
       57          if available tmprecid
       58          then
       59             delete tmprecid.
       60          else do:
       61             create tmprecid.
       62             assign
       63                tmprecid.fTable = iBuffer:TABLE
       64                tmprecid.Frecid = iBuffer:recid
       65             .
       66          end.
       67       end.
       68       return available tmprecid.
       69    end.
       70     define variable v-code-brw as class ibs.th.ref.code.browsecode no-undo .
       71     define public variable parent as character no-undo.
       72     define public variable menuHandle as handle no-undo.
       73     define public variable title  as character no-undo init ?.
       74     define public variable startlevel as integer no-undo.
       75     define public variable mViewdel as logical no-undo.
       76     define public variable filter   as character no-undo.
       77     define public variable nwsGbd   as logical no-undo.
       78     define public variable nwsUbd   as logical no-undo.
       79     define public variable extProcView as logical no-undo .
       80     define property curLevel as integer no-undo
       81     get:
       82         return if parent eq "" then 0 else num-entries(parent,chr(4)).
       83     end.
       84     define public property MaxLevel as integer  no-undo
       85     get.
       86     set(arg as int):
       87        saveMaxLevel().
       88        MaxLevel = arg.
       89     end.
       90     define public property isForm as logical  no-undo
       91     get:
       92        return valid-object (v-code-brw).
       93     end.
       94     method  public void saveMaxLevel ():
       95        if not isForm  then return.
       96        define variable vcurLevel as integer no-undo.
       97        vcurLevel = curLevel.
       98        find first tt-SaveParam where tt-SaveParam.LevelSave eq vcurLevel no-lock no-error.
       99        if not available tt-SaveParam
      100        then do:
      101           create tt-SaveParam.
      102           tt-SaveParam.LevelSave = vcurLevel.
      103        end.
      104        tt-SaveParam.MaxLevel = MaxLevel.
      105     end.
      106     method  public void clearParam ():
      107        define variable vcurLevel as integer no-undo.
      108        vcurLevel = curLevel.
      109        find first tt-SaveParam where tt-SaveParam.LevelSave eq vcurLevel no-lock no-error.
      110        if available tt-SaveParam
      111        then do:
      112           MaxLevel   = tt-SaveParam.MaxLevel.
      113           chek-erpRN = tt-SaveParam.chek-erpRN.
      114        end.
      115        for each tt-SaveParam where tt-SaveParam.LevelSave ge vcurLevel:
      116           delete tt-SaveParam.
      117        end.
      118        for each tt-form where tt-form.f-SetLevel ge vcurLevel:
      119           delete tt-form.
      120        end.
      121     end.
      122     define property endLevel as logical no-undo
      123     get:
      124         return MaxLevel ne 0 and num-entries(parent,chr(4))  eq  MaxLevel  .
      125     end.
      126     define property chek-erpRN as logical no-undo
      127      get.
      128      set(arg as logical):
      129        saveChekErpRN().
      130        chek-erpRN = arg.
      131     end.
      132     define property isVisibleStatus as logical no-undo init true
      133     get.
      134     set.
      135     method  public void saveChekErpRN ():
      136        if not isForm  then return.
      137        define variable vcurLevel as integer no-undo.
      138        vcurLevel = curLevel.
      139        find first tt-SaveParam where tt-SaveParam.LevelSave eq vcurLevel no-lock no-error.
      140        if not available tt-SaveParam
      141        then do:
      142           create tt-SaveParam.
      143           tt-SaveParam.LevelSave = vcurLevel.
      144        end.
      145        tt-SaveParam.chek-erpRN = chek-erpRN.
      146     end.
      147     define property Mode as character  no-undo
      148      get.
      149      set.
      150     define variable mode-erprn as logical no-undo init ?.
      151     method  public logical get1CERP():
      152          define variable conf-par as character no-undo.
      153          define variable par-type as character no-undo.
      154          if mode-erprn eq ?
      155          then do:
      156   run conf-rd in ibs.th.gbl.gbl-hndllib:g#library
      157     (input  'is-erpRN'
      158     ,input  0
      159     ,input  ''
      160     ,input  0
      161     ,input  ''
      162     ,input  ''
      163     ,input  ''
      164     ,input  NO
      165     ,output conf-par
      166     ,output par-type
      167     ) no-error .
      168             if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
      169             else mode-erprn = no.
      170          end.
      171          return mode-erprn.
      172       end.
      173     define property parparentproc as handle no-undo
      174       private get.
      175       set(input iH as handle):
      176         parparentproc = ih.
      177       end.
      178      constructor public code_trg (  ):
      179         this-object('ИЗМЕНЕНИЕ':U).
      180      end constructor.
      181      constructor public code_trg (imode as character   ):
      182         super ().
      183         mode = imode.
      184         if mode eq 'ВЫБОР':U
      185         then
      186         rid-keep ().
      187         formLable(0, 1, "Код ").
      188         formLable(0, 2, "Наименование").
      189      end constructor.
      190      destructor public code_trg ( ):
      191      end destructor.
      192      method public void NextLevel ():
      193         define buffer code for code.
      194         find first code where recid(code) eq tt-code-brw.Frecid no-lock no-error.
      195         if available  code
      196         then do:
      197            if     code.procview ne ""
      198               and SearchPFile(code.procview) ne ?
      199            then do:
      200               if mode eq 'ВЫБОР':U
      201               then
      202                  rid-keep ().
      203               extProcView = yes .
      204               run value( code.procview) (parparentproc, Mode, code.parent , code.code,Code.CodeName) no-error.
      205               if error-status:error
      206               then
      207                  message return-value skip
      208                          error-status:get-message (1)
      209                  view-as alert-box.
      210               if mode eq 'ВЫБОР':U
      211               then
      212                  rid-rest ().
      213            end.
      214            else do:
      215               extProcView = no .
      216               if not endLevel
      217               then do:
      218                  codeProcViewSet(code.parent,code.code).
      219                  assign
      220                     parent  = code.parent + chr(4) + code.code
      221                     parent  = left-trim(parent,chr(4))
      222                  .
      223                  setFieldBrw(num-entries(Parent,chr(4))).
      224               end.
      225               getQuery("code").
      226            end.
      227         end.
      228      end.
      229      method public void rid-keep ():
      230         define buffer buf_tt-code-brw for tt-code-brw.
      231         for each buf_tt-code-brw:
      232            find first tmprecid where tmprecid.fTable eq "code"
      233                                  and tmprecid.Frecid eq buf_tt-code-brw.Frecid
      234            no-error.
      235            if     available tmprecid
      236               and not buf_tt-code-brw.fchange
      237            then
      238               delete tmprecid.
      239            else if not available tmprecid
      240                    and buf_tt-code-brw.fchange
      241            then do:
      242               create tmprecid.
      243               assign
      244                  tmprecid.Frecid = buf_tt-code-brw.Frecid
      245                  tmprecid.fTable = "code"
      246               .
      247            end.
      248         end.
      249         run gbl/rid-keep.p (input table tmprecid) no-error.
      250      end.
      251      method public void rid-rest ():
      252         define buffer buf_tt-code-brw for tt-code-brw.
      253         run gbl/rid-rest.p (output table tmprecid) no-error.
      254         for each buf_tt-code-brw:
      255            find first tmprecid where tmprecid.fTable eq "code"
      256                                  and tmprecid.Frecid eq buf_tt-code-brw.Frecid
      257            no-error.
      258         end.
      259      end.
      260      method public logical PrevLevel ():
      261         if parent ne ""
      262         then do:
      263            assign
      264               entry(num-entries(parent,chr(4)),parent,chr(4)) = ""
      265               parent = right-trim(parent,chr(4))
      266            .
      267            if num-entries(parent,chr(4)) < startlevel
      268            then do:
      269               if mode eq 'ВЫБОР':U
      270               then do:
      271                  run gbl/rid-keep.p (input table tmprecid) no-error.
      272               end.
      273               return no.
      274            end.
      275            else do:
      276               clearParam().
      277               setFieldBrw(num-entries(Parent,chr(4))).
      278               getQuery("code").
      279               return yes.
      280            end.
      281         end.
      282      end.
      283      method public void formLable (ilevel as integer, inumfield as integer ,iname as character   ):
      284          formLableSetLevel ((if isForm then curLevel else 0) + ilevel, inumfield, iname).
      285      end.
      286      method public void formLableSetLevel (ilevel as integer, inumfield as integer ,iname as character   ):
      287         find first tt-form where tt-form.f-level    eq ilevel
      288                              and tt-form.f-numfield eq inumfield
      289                              no-error.
      290         if not available tt-form
      291         then do:
      292            create tt-form.
      293            assign
      294               tt-form.f-level    = ilevel
      295               tt-form.f-numfield = inumfield
      296               tt-form.f-brwname  = iname
      297               tt-form.f-SetLevel = if isForm then curLevel else -1
      298            .
      299         end.
      300         else do:
      301               tt-form.f-brwname  = iname.
      302         end.
      303      end.
      304      method public handle getQuery (input iNameQuery as character ) :
      305           return getQuery(iNameQuery,no).
      306      end.
      307      method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
      308           define variable hQuery   as handle  no-undo .
      309           define variable vCodeQry as handle  no-undo .
      310           define variable vfirst   as logical no-undo .
      311           define variable vOpen    as logical no-undo init yes.
      312           define variable vTblName as character no-undo .
      313           define variable vOpenStr as character no-undo .
      314           define variable vSchedId as integer no-undo .
      315           define variable sortFrase as character no-undo .
      316           define buffer code    for ub.code.
      317           find first tt-Query where tt-Query.NameQuery eq iNameQuery
      318           no-error.
      319         if     available tt-Query
      320            and iNewQuery
      321         then do:
      322            delete object tt-Query.hQuery.
      323            delete tt-Query.
      324         end.
      325         if not available tt-Query
      326         then
      327         do:
      328             create query hQuery.
      329         end.
      330         else
      331            hQuery = tt-Query.hQuery.
      332             case iNameQuery:
      333                 when "code"
      334                 then do:
      335                     for each tt-code-brw:
      336                        delete tt-code-brw.
      337                     end.
      338                     create query vCodeQry.
      339                     vCodeQry:set-buffers(buffer code:handle).
      340                     vCodeQry:query-prepare(substitute("for each code where code.parent = &1 &2 and &3",
      341                                                       quoter(Parent),
      342                                                       filter,
      343                                                       if mViewdel then "yes" else "code.status_ <> 1", filter)).
      344                    vCodeQry:query-open().
      345                    vCodeQry:get-first().
      346                    QRY-BLOCK:
      347                    repeat while not vCodeQry:query-off-end:
      348                      create tt-code-brw.
      349                      buffer-copy code to tt-code-brw.
      350                      assign
      351                        tt-code-brw.Frecid = recid (code)
      352                        tt-code-brw.fstatus = getstatus(Code.status_)
      353                      .
      354                      vCodeQry:get-next().
      355                    end.
      356                    vCodeQry:query-close().
      357                    delete object vCodeQry.
      358                    case entry(1, Parent, chr(4)) :
      359                      when "CashParamHash"
      360                      then do :
      361                        if num-entries(Parent, chr(4)) = 1
      362                        then do :
      363                          sortFrase = "by datetime(tt-code-brw.codeName) desc".
      364                        end .
      365                      end .
      366                      when "XML_UPD"
      367                      then do :
      368                        if num-entries(Parent, chr(4)) = 2
      369                        then do :
      370                          sortFrase = "by datetime(tt-code-brw.code) desc".
      371                        end .
      372                      end .
      373                    end case .
      374                    hQuery:set-buffers(buffer tt-code-brw:HANDLE).
      375                    hQuery:query-prepare("FOR EACH tt-code-brw " + sortFrase).
      376                 end.
      377                 when "currentcode"
      378                 then do:
      379                    define buffer buf_code for code.
      380                    message "FOR EACH buf_code where (buf_code.parent eq " + quoter(code.parent) +
      381                                                             " and buf_code.code   eq " + quoter(code.code)  +
      382                                                             " ) or ( buf_code.parent begins " + quoter(code.parent + chr(4) + code.code ) + ")"
      383                    view-as alert-box.
      384                 end.
      385             end case.
      386             if vOpen
      387             then do:
      388                hQuery:query-open.
      389                if vFirst
      390                then
      391                    hQuery:get-first () no-error .
      392             end.
      393             if not available tt-Query
      394             then
      395             do:
      396                create tt-Query.
      397             assign
      398                 tt-Query.NameQuery = iNameQuery
      399                 tt-Query.hQuery    = hQuery
      400             .
      401         end.
      402           return hQuery.
      403       end.
      404       method public void  brwcode ():
      405          v-code-brw = new ibs.th.ref.code.browsecode (input mode, input this-object).
      406          v-code-brw:chek-erpRN = chek-erpRN.
      407          v-code-brw:Text = if this-object:title eq ? then "Справочники" else this-object:title.
      408          setMenu().
      409          setFieldBrw(num-entries(parent,chr(4))).
      410          wait-for  v-code-brw:ShowDialog() .
      411          delete object v-code-brw.
      412       end.
      413       method public void codeProcViewSet(iparent as character ,icode as character ):
      414          if iparent eq ""
      415          then do:
      416             if icode eq "CashFunKey"
      417             then do:
      418                MaxLevel = MaxLevel + 1.
      419                formLable(1, 1, "Функция").
      420                formLable(1, 2, "Наименование").
      421                formLable(1, 3, "Код функции").
      422                formLable(1, 4, "   ").
      423             end.
      424             else if icode eq "CashParamHash"
      425             then do:
      426                MaxLevel = MaxLevel + 1.
      427                formLable(1, 1, "БД").
      428                formLable(1, 2, "Дата и время").
      429                formLable(1, 3, "Хеш").
      430             end.
      431             else if icode eq "codeerror"
      432             then do:
      433                MaxLevel = MaxLevel + 3.
      434                formLable(1, 1, "Код").
      435                formLable(1, 2, "Наименование").
      436                formLable(2, 1, "Код").
      437                formLable(2, 2, "Наименование").
      438                formLable(3, 1, "Код").
      439                formLable(3, 2, "Наименование").
      440                formLable(3, 3, "Текст").
      441                formLable(3, 4, "Группировка выгр.").
      442                formLable(3, 5, "Знач.Выгр.").
      443             end.
      444             else if icode eq "okei-kkt"
      445             then do:
      446                formLable(1, 1, "Код ОКЕИ").
      447                formLable(1, 2, "Код ЕИ ККТ").
      448                formLable(1, 4, "ПФ ККТ").
      449                MaxLevel = MaxLevel + 1.
      450                chek-erpRN = yes.
      451             end.
      452             else if icode eq "DTSeasons"
      453             then do:
      454                formLable(1, 1, "Код").
      455                formLable(1, 2, "Наименование на чеке").
      456                formLable(1, 3, "Код топлива").
      457                formLable(1, 4, "Альтернативное наименование").
      458                formLable(1, 5, "НДС в ПЦ").
      459                formLable(1, 6, "ЕИ в ПЦ").
      460                MaxLevel = MaxLevel + 1.
      461             end.
      462             else if icode eq "FuelCodeInfo"
      463             then do:
      464                formLable(1, 1, "Код АСУ АЗК").
      465                formLable(1, 3, "Эталонный код").
      466                MaxLevel = MaxLevel + 1.
      467                chek-erpRN = yes.
      468                isVisibleStatus = false.
      469             end.
      470             else if icode eq "XML_UPD"
      471             then do:
      472                MaxLevel = MaxLevel + 2.
      473                formLable(1, 1,"БД ").
      474                formLable(2, 1, "Код").
      475                formLable(2, 3, "Файл").
      476                formLable(2, 4, "Хеш").
      477                formLable(2, 5, "Версия метаданных").
      478                formLable(2, 6, "БД").
      479             end.
      480             else if icode eq "XML_BACKUP"
      481             then do:
      482                MaxLevel = MaxLevel + 2.
      483                formLable(1, 1,"Код ").
      484                formLable(1, 3,"Файл").
      485                formLable(1, 4,"Хеш ").
      486                formLable(1, 6, " ").
      487             end.
      488          end.
      489       end.
      490       method public void setFieldBrw (ilevel as integer ):
      491          define variable vi as integer no-undo.
      492          if not valid-object (v-code-brw)
      493          then
      494             return.
      495          find first tt-form where tt-form.f-level eq ilevel
      496          no-error.
      497          if available tt-form and valid-object (v-code-brw) then
      498          do vi= 1 to 16:
      499             find first tt-form where tt-form.f-level eq ilevel
      500                                  and tt-form.f-numfield eq vi
      501             no-error.
      502             if available tt-form
      503             then
      504                v-code-brw:Visual_Columns(vi,tt-form.f-brwname).
      505             else
      506                v-code-brw:Visual_Columns(vi,?).
      507          end.
      508          else
      509             v-code-brw:defColumn().
      510       end.
      511       method public void addMenu (inum as integer, iLable as character , ilistMenu as character ):
      512          find first tt-menu where tt-menu.f-num eq inum no-error.
      513          if not available tt-menu
      514          then do:
      515             create tt-menu.
      516             tt-menu.f-num = inum.
      517          end.
      518          assign
      519             tt-menu.f-lable = iLable
      520             tt-menu.f-list  = ilistMenu
      521          .
      522       end.
      523       method public void delMenu (inum as integer):
      524          find first tt-menu where tt-menu.f-num eq inum no-error.
      525          if available tt-menu
      526          then do:
      527             delete tt-menu.
      528          end.
      529       end.
      530       method public void setMenu ( ):
      531          if not valid-handle (menuHandle) then return.
      532          for each tt-menu no-lock:
      533             v-code-brw:addMenu(tt-menu.f-num, tt-menu.f-lable, tt-menu.f-list).
      534          end.
      535       end.
      536       method private integer  getDbNum ( ):
      537          find first sys-ctrl.
      538          return sys-ctrl.db-num.
      539       end.
      540       method public void histOne ( ):
      541          define variable v-rid-list as character no-undo.
      542         if avail tt-code-brw then
      543         do:
      544            run ref/ccode.w (
      545                      tt-code-brw.parent,
      546                      tt-code-brw.code,
      547                      parparentproc,
      548                      0,
      549                      "",
      550                      0,
      551                      "",
      552                      "one",
      553                      ?,
      554                      "",
      555                      "" ,
      556                      getDbNum ( ),
      557                      ?,
      558                      input-output v-rid-list ) .
      559         end.
      560       end.
      561       method public void histChild ( ):
      562          define variable v-rid-list as character no-undo.
      563         if avail tt-code-brw then
      564         do:
      565            run ref/ccode.w (
      566                      tt-code-brw.parent,
      567                      tt-code-brw.code,
      568                      parparentproc,
      569                      0,
      570                      "",
      571                      0,
      572                      "",
      573                      "parentBeg",
      574                      ?,
      575                      "",
      576                      "" ,
      577                      getDbNum ( ),
      578                      ?,
      579                      input-output v-rid-list ) .
      580         end.
      581       end.
      582       method public void runMenu (iStr as character ):
      583          define buffer code for code.
      584          find first code where recid(code) eq tt-code-brw.Frecid no-lock no-error.
      585          run value(istr) in menuHandle
      586          ((buffer code:handle)) no-error.
      587          if error-status:error
      588          then
      589             message error-status:get-message (1) skip
      590                     return-value
      591             view-as alert-box.
      592       end.
      593       method public void addcode ( ):
      594          release code.
      595          create tt-code-frm.
      596          tt-code-frm.parent = parent.
      597          frmcode('ДОБАВЛЕНИЕ':U , buffer tt-code-frm:handle).
      598          finally:
      599             delete tt-code-frm.
      600          end finally.
      601       end method.
      602       method public void editcode ( ):
      603          define buffer code for code.
      604          find first code where recid(code) eq tt-code-brw.Frecid no-lock no-error.
      605          if available code
      606          then do:
      607             buffer-copy code to tt-code-frm.
      608             tt-code-frm.Frecid  = recid(code).
      609             frmcode('ИЗМЕНЕНИЕ':U,buffer tt-code-frm:handle).
      610          end.
      611          finally:
      612             if available tt-code-frm
      613             then
      614                delete tt-code-frm.
      615          end finally.
      616       end method.
      617       method public void delcode ( ):
      618          define buffer buf_code for code.
      619          define buffer code for code.
      620          find first code where recid(code) eq tt-code-brw.Frecid no-lock no-error.
      621          if available code
      622          then do:
      623             if SearchPFile(Code.procdel) ne ?
      624             then
      625                run value (Code.procdel) (recid(code)).
      626             else do:
      627                find first buf_code where recid(buf_code) eq recid(code)
      628                exclusive-lock.
      629                if available buf_code
      630                then do:
      631                   if buf_code.status_ eq 1
      632                   then
      633                      buf_code.status_ = 0.
      634                   else
      635                      buf_code.status_ = 1.
      636                end.
      637             end.
      638          end.
      639       end method.
      640       method public character  getstatus (iStatus as integer  ):
      641       define variable vStatus as character no-undo.
      642                 vStatus = entry (lookup (string(iStatus), '0,1,50,99':U), 'тек,удал,блок,удаление':U) no-error.
      643          return vStatus.
      644       end method.
      645       method public character  getprocedit(ibuffertt as handle ):
      646          define variable oProc as character no-undo.
      647          define variable vparent     as character no-undo.
      648          define variable vcode       as character no-undo.
      649          define variable vLastdelim  as integer no-undo.
      650          define buffer code for code.
      651          if     ibuffertt::procedit ne ""
      652             and ibuffertt::procedit ne  ?
      653          then
      654             oProc = ibuffertt::procedit.
      655          else do:
      656            assign
      657               vLastdelim = r-index(ibuffertt::parent,chr(4))
      658               vparent    = if vLastdelim eq 0 then "" else substring(ibuffertt::parent,1,vLastdelim - 1)
      659               vcode      = if vLastdelim eq 0 then ibuffertt::parent else substring(ibuffertt::parent,vLastdelim + 1)
      660            .
      661            find first code where Code.parent eq vparent
      662                               and code.code  eq vcode
      663            no-lock no-error.
      664            block-code:
      665            do while available code and code.code ne "":
      666               if     code.procedit ne ?
      667                  and code.procedit ne ""
      668               then do:
      669                  oProc = code.procedit.
      670                  leave block-code.
      671               end.
      672               assign
      673                  vLastdelim = r-index(Code.parent,chr(4))
      674                  vparent    = if vLastdelim eq 0 then "" else substring(Code.parent,1,vLastdelim - 1)
      675                  vcode      = if vLastdelim eq 0 then Code.parent else substring(Code.parent,vLastdelim + 1)
      676               .
      677               find first code where Code.parent eq vparent
      678                                  and code.code  eq vcode
      679               no-lock no-error.
      680             end.
      681          end.
      682          return oProc.
      683       end method.
      684       method public void frmcode (Imode as character ,ibuffertt as handle ):
      685          define variable VSave as logical no-undo.
      686          define variable v-code-frm as class ibs.th.ref.code.frmcode no-undo.
      687          define buffer buf_code for code.
      688          define variable vproc as character no-undo.
      689          vproc = getprocedit(ibuffertt).
      690          if SearchPFile(vproc) ne ?
      691          then
      692             run value(vproc) (parparentproc, this-object, Imode  ,ibuffertt,output Vsave ).
      693          else do:
      694             v-code-frm = new ibs.th.ref.code.frmcode(ibuffertt,this-object).
      695             for each tt-form where tt-form.f-level eq num-entries(parent,chr(4)):
      696                v-code-frm:setlable(tt-form.f-numfield, tt-form.f-brwname).
      697             end.
      698             wait-for  v-code-frm:ShowDialog() .
      699             VSave = v-code-frm:DialogResult = System.Windows.Forms.DialogResult:ok.
      700             delete object v-code-frm.
      701          end.
      702          if VSave
      703          then do trans:
      704             if ibuffertt::frecid ne ?
      705             then
      706                find first buf_code where recid(buf_code) eq ibuffertt::frecid exclusive-lock.
      707             buffer-copy tt-code-frm to buf_code
      708             assign
      709                buf_code.nwsgbd = nwsGbd when nwsGbd
      710                buf_code.nwsubd = nwsUbd when nwsUbd
      711             .
      712             if available tt-code-brw
      713             then
      714                buffer-copy tt-code-frm to tt-code-brw.
      715          end.
      716       end method.
      717       method public void checkcode () :
      718       define buffer buf_code for code.
      719       find first buf_code where buf_code.parent eq parent
      720                             and buf_code.code   eq tt-code-frm.code
      721                             and if tt-code-frm.frecid ne ? then recid(buf_code) ne tt-code-frm.frecid else yes
      722                             no-lock no-error.
      723        if available buf_code
      724        then do:
      725           message "Уже есть запись с кодом " tt-code-frm.code
      726           view-as alert-box.
      727           return error.
      728        end.
      729     end method. // end_of_checkPromoAction
      730     method public void CheckCodeInt () :
      731       define buffer buf_code for code.
      732       find first buf_code where buf_code.parent eq parent
      733                             and int(buf_code.code)   eq int(tt-code-frm.code)
      734                             and if tt-code-frm.frecid ne ? then recid(buf_code) ne tt-code-frm.frecid else yes
      735                             no-lock no-error.
      736        if available buf_code
      737        then do:
      738           message "Уже есть запись с кодом " tt-code-frm.code
      739           view-as alert-box.
      740           return error.
      741        end.
      742     end method. // end_of_checkPromoAction
      743     method public void codeexport (file as character  ):
      744        define variable vexpot as class ibs.th.bge.xmlimpexp no-undo.
      745         vexpot = new ibs.th.bge.xmlimpexp().
      746         define variable hQuery   as handle  no-undo .
      747         define buffer Buf_code for code.
      748         create query hQuery.
      749         hQuery:set-buffers(buffer buf_code:HANDLE).
      750         hQuery:query-prepare("FOR EACH buf_code where buf_code.export_ "
      751                                                             ).
      752         hQuery:query-open ().
      753         vexpot:updatetableforxml(hQuery).
      754         vexpot:xmldom-save  ( file ).
      755         message "Выгружен файл " file
      756         view-as alert-box.
      757         finally:
      758            delete object vexpot.
      759            delete object hQuery.
      760         end finally.
      761        end method.
      762        method public void codeimport (file as character  ):
      763          define variable vimport as class ibs.th.bge.xmlimpexp no-undo.
      764          vimport= new ibs.th.bge.xmlimpexp().
      765          vimport:xmldom-load ( file ).
      766          vimport:updatetablefordb().
      767          message "Загрузка завершена."
      768          view-as alert-box.
      769          finally:
      770            delete object vimport.
      771         end finally.
      772        end method.
      773        method public void changeRow(input iAll as logical):
      774          define variable vFlag as logical no-undo.
      775          vFlag = if     available tt-code-brw
      776                     and tt-code-brw.fchange
      777                  then no
      778                  else yes.
      779          if iAll
      780          then
      781              for each   tt-code-brw:
      782                  tt-code-brw.fchange = vFlag.
      783              end.
      784          else
      785               if avail tt-code-brw
      786               then
      787                   tt-code-brw.fchange = vFlag.
      788      end.
      789   method public character objExists
      790   (input  ifolder as character,
      791    input  iType   as character  ):
      792       define variable vFileType as character no-undo init "D,F".
      793       define variable vi        as integer no-undo.
      794       define variable vtype as character no-undo.
      795       if iType ne ?
      796       then
      797          vFileType = iType.
      798       do vi = 1 to num-entries(vFileType):
      799          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      800          vtype = file-information:file-type.
      801          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      802             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      803             index(vtype , entry(vi,vFileType )) > 0
      804          then return file-information:full-pathname .
      805          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      806          vtype = file-information:file-type.
      807          if file-information:file-name <> "" and
      808             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      809             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      810             index( vtype, entry(vi,vFileType )) > 0
      811          then return file-information:full-pathname .
      812       end.
      813       return ? .
      814   end.
      815   method public character SearchFile
      816   (input  ifile as character):
      817      return objExists(ifile,?).
      818   end.
      819   method public character SearchPFile
      820   (input inFile as char):
      821        define variable oFile       as character no-undo.
      822        define variable vFileSearch as character no-undo.
      823        define variable vNumEntry   as integer no-undo.
      824        if inFile = "" then return ?.
      825        vNumEntry = num-entries(inFile,".").
      826        vFileSearch = inFile.
      827        if    vNumEntry > 0
      828           and (   entry(vNumEntry,inFile,".") eq "p"
      829                or entry(vNumEntry,inFile,".") eq "w")
      830        then do:
      831           entry(vNumEntry,vFileSearch, ".") = "r".
      832           oFile = search(vFileSearch ).
      833           if oFile eq ?
      834           then
      835              oFile = search(inFile).
      836        end.
      837        else
      838           oFile = search(vFileSearch).
      839        return oFile.
      840     end.
      841   end class.
