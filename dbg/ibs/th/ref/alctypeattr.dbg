        1   using ibs.th.ref.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.AlcTypeAttr :
        4     define variable ii as integer no-undo.
        5     method public void GetAlcTypeAttr (input  p-alc-type-code as character, input p-code as character, output p-value as decimal):
        6       define buffer buf_alc-type-attr for ub.alc-type-attr .
        7       do
        8         on error undo, return error
        9         :
       10         find first ub.alc-type where ub.alc-type.alc-type-code = p-alc-type-code no-error.
       11         if available (ub.alc-type)
       12           then
       13         do:
       14           find first buf_alc-type-attr no-lock where
       15             buf_alc-type-attr.alc-type-inner-code         = ub.alc-type.alc-type-inner-code
       16             and   buf_alc-type-attr.create-user-db-num    = ub.alc-type.create-user-db-num
       17             and   buf_alc-type-attr.attr-code             = p-code no-error .
       18           if not available buf_alc-type-attr then
       19           do:
       20             return error return-value
       21               .
       22           end.
       23           else
       24           do:
       25             assign
       26               p-value = decimal (buf_alc-type-attr.attr-value)
       27           no-error.
       28           end.
       29         end.
       30       end.
       31       release buf_alc-type-attr.
       32     end method.
       33   end class.
