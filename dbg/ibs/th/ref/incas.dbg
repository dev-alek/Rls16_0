       13   define temp-table tt-coins no-undo XML-NODE-NAME "coins" serialize-name  "coins"
       14     field id       as decimal
       15     field qnty     as decimal
       16     field sum-qnty as decimal
       17     index pi is primary unique id desc.
       18   define temp-table tt-banknots no-undo XML-NODE-NAME "banknots" serialize-name  "banknots"
       19     field id       as integer
       20     field qnty     as integer
       21     field sum-qnty as integer
       22     index pi is primary unique id desc.
       23   define temp-table tt-cover-sheet no-undo
       24     field num-bag      as character
       25     field depos-code   as integer
       26     field depos-bank   as character
       27     field repos-code   as integer
       28     field repos-bank   as character
       29     field pin02        as character
       30     field source_      as character
       31     field total-sum    as decimal
       32     index pi num-bag
       33   .
       34   define dataset ds-banknots XML-NODE-NAME "money" serialize-name  "money" for tt-banknots,
       35     tt-coins .
       36   define         variable hQueryCoins                           as handle                                         no-undo .
       37   define         variable hQueryBanknot                         as handle                                         no-undo .
       38   method private handle add_Coints():
       39      define variable v-list-coints as character no-undo .
       40      define variable ii            as integer   no-undo .
       41      v-list-coints = "10;5;2;1;0.5;0.1;0.05" .
       42       define variable ddd as decimal no-undo.
       43       do ii = 1 to num-entries (v-list-coints,";"):
       44         find first tt-coins where tt-coins.id       = decimal (entry(ii,v-list-coints,";"))
       45         no-error.
       46         if not available tt-coins
       47         then do:
       48            create tt-coins .
       49            assign
       50              tt-coins.id       = decimal(entry(ii,v-list-coints,";"))
       51              tt-coins.qnty     = 0
       52              tt-coins.sum-qnty = 0
       53              .
       54          end.
       55       end.
       56   end.
       57   method private handle getq_Coints():
       58   if valid-handle(hQueryCoins)  then delete object hQueryCoins.
       59       create query hQueryCoins.
       60       hQueryCoins:set-buffers(buffer tt-coins:HANDLE).
       61       hQueryCoins:query-prepare("FOR EACH tt-coins by tt-coins.id desc").
       62       hQueryCoins:query-open.
       63       return hQueryCoins.
       64   end.
       65   method private handle add_Banknot():
       66      define variable v-list-banknot as character no-undo .
       67      define variable ii             as integer   no-undo .
       68      v-list-banknot = "5000;2000;1000;500;200;100;50;10" .
       69       do ii = 1 to num-entries (v-list-banknot,";"):
       70         find first tt-banknots where tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       71         no-error.
       72         if not available tt-banknots
       73         then do:
       74            create tt-banknots .
       75            assign
       76              tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       77              tt-banknots.qnty     = 0
       78              tt-banknots.sum-qnty = 0
       79              .
       80          end.
       81       end.
       82   end.
       83   method private handle getq_Banknot():
       84      if valid-handle(hQueryBanknot)  then delete object hQueryBanknot.
       85       create query hQueryBanknot.
       86       hQueryBanknot:set-buffers(buffer tt-banknots:HANDLE).
       87       hQueryBanknot:query-prepare("FOR EACH tt-banknots by tt-banknots.id desc").
       88       hQueryBanknot:query-open.
       89       return hQueryBanknot.
       90   end.
       91   define temp-table tt-cashBookOst no-undo
       92   field chang      as logical
       93   field cashbookid as int64
       94   field cashbookname as character
       95   field ost        as decimal
       96   field ostrasch   as decimal
       97   field osnpko     as decimal
       98   field osnrko     as decimal
       99   index pi cashbookid.
      100      define public variable mSumm as decimal  no-undo.
      101      define public variable mosnbag as character no-undo.
      102      define public variable mdopbag as character no-undo.
      103      define public variable mMoney as character no-undo.
      104      define private variable OstCash as class ibs.th.ref.ostcashbook no-undo.
      105      define private variable mtrgOst as class ibs.th.ref.ostcashbook_trg no-undo.
      106     define public property maxSum    as decimal  no-undo init ?
      107     private get.
      108     set(input isum as decimal ):
      109       maxSum = iSum.
      110       fSum:text = string(maxSum).
      111     end.
      112      constructor public incas (  ):
      113         super().
      114         mtrgOst = new ibs.th.ref.ostcashbook_trg().
      115         InitializeComponent().
      116         OstCash:trgOst = mtrgOst.
      117         add_Banknot().
      118         windowContainer1:Update_Banknots (getq_Banknot()).
      119         add_Coints().
      120         windowContainer1:Update_coints( getq_Coints()).
      121         windowContainer1:Fsumm:ReadOnly = yes.
      122         this-object:ComponentsCollection:ADD(this-object:components).
      123         catch e as Progress.Lang.Error:
      124            undo, throw e.
      125         end catch.
      126      end constructor.
      127           @VisualDesigner.
      128           method private void Bt_ok_Click( input sender as System.Object, input e as System.EventArgs ):
      129              define variable Vmoney as longchar  no-undo.
      130              if     windowContainer1:v-total-sum ne 0
      131                 and windowContainer1:v-total-sum ne dec(fSum:text)
      132              then do:
      133                 message "Введенная сумма не соответствует введенным номиналам"
      134            view-as alert-box.
      135            return.
      136         end.
      137         if      maxSum ne ?
      138             and dec(fSum:text) > maxSum
      139         then do:
      140            message "Сумма инкассации " dec(fSum:text) " не может быть больше суммы денег в кассе " maxSum
      141            view-as alert-box.
      142            return.
      143         end.
      144         if  mtrgOst:ChekSumm
      145             and mtrgOst:summ < dec(fSum:text)
      146         then do:
      147            message "Сумма инкассации " dec(fSum:text) " по не основным кассовым книгам не может быть больше суммы денег в кассе " mtrgOst:summ
      148            view-as alert-box.
      149            return.
      150         end.
      151         if trim(fOsn:text) eq ""
      152         then do:
      153            message "Не указан номер сумки."
      154            view-as alert-box.
      155            return.
      156         end.
      157                 if windowContainer1:v-total-sum eq 0
      158                 then
      159                    Vmoney = "".
      160                 else
      161                    dataset ds-banknots:write-json("longchar", Vmoney).
      162              this-object:mSumm = dec(fSum:text).
      163              this-object:mosnbag = trim(fOsn:text).
      164             // this-object:mdopbag = trim(if fDop:text eq "" or fDop:text eq ? then fOsn:text else fDop:text).
      165              this-object:mMoney  = Vmoney.
      166                   this-object:DialogResult = System.Windows.Forms.DialogResult:Ok.
      167                   this-object:Close ( ).
      168                   return.
      169           end method.
