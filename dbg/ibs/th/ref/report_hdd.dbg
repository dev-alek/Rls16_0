       85     method private void button_click_run( input sender as System.Object, input e as System.EventArgs ):
       86       assign
       87         v-DateStart   = date(this-object:date_start:Text)
       88         v-DateEnd     = date(this-object:date_end:Text)
       89         v-TimeStart   = this-object:time_start:Value
       90         v-TimeEnd     = this-object:time_end:Value
       91         v-NamePK      = this-object:NamePK:Text
       92         v-ModelDisk   = this-object:ModelDisk:Text
       93         v-AttrName    = this-object:attr_name:Text
       94         v-AttrType    = this-object:attr_type:Text
       95         .
       96       run rep/hdd-report.p (input parparentproc,
       97         input v-DateStart,
       98         input v-DateEnd,
       99         input v-TimeStart,
      100         input v-TimeEnd,
      101         input v-NamePK,
      102         input v-ModelDisk,
      103         input v-AttrName,
      104         input v-AttrType,
      105         input v-obj-list) no-error .
      106       return.
      107     end method.
