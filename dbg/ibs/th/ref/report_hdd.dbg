      504   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      505         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      506         then do:
      507             proc-alt-shift-f3 ().
      508         end.
      509         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      510         then do:
      511             proc-alt-shift-f2 ().
      512         end.
      513   end method.
