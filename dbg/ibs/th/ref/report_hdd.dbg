      517         end catch.
      518   end method.
      519   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      520      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      521      define variable v-curr-sv-date as date no-undo .
      522      define variable v-new-sv-date  as date no-undo .
      523      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      524      then do:
      525         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      526         run gbl/getcurdt.p
      527            (output v-curr-sv-date
      528         ) .
      529         vdate:value = v-curr-sv-date.
      530      end.
      531      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      532      then do:
      533         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      534         v-curr-sv-date = vdate:value .
      535         if v-curr-sv-date = ?
      536         then do:
      537            run gbl/getcurdt.p
      538               (output v-curr-sv-date
      539            ) .
      540         end.
      541         if v-curr-sv-date <> ?
      542         then do:
      543            assign
      544               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      545               vdate:value = v-new-sv-date
      546            .
      547         end.
      548      end.
      549      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      550      then do:
      551         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      552         v-curr-sv-date = vdate:value.
      553         if v-curr-sv-date = ?
      554         then do:
      555            run gbl/getcurdt.p
      556               (output v-curr-sv-date
      557            ) .
      558         end.
      559         if v-curr-sv-date <> ?
      560         then do:
      561            run gbl/lastdate.p
      562               (input  v-curr-sv-date
      563               ,output v-new-sv-date
      564            ).
      565            vdate:value = v-new-sv-date.
      566         end.
      567      end.
      568      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      569      then do:
      570         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      571         define variable v-description   as character no-undo .
      572         define variable v-ok            as logical no-undo.
      573         v-curr-sv-date = vdate:value.
      574         if v-curr-sv-date = ?
      575         then do:
      576            run gbl/getcurdt.p
      577               (output v-curr-sv-date
      578            ) .
      579         end.
      580         if v-curr-sv-date <> ?
      581         then do:
      582            run gbl/d-inpday.w
      583               (input ?
      584               ,input "Выбор даты"
      585               ,input v-description
      586               ,input ""
      587               ,input-output v-curr-sv-date
      588               ,output v-ok
      589            ).
      590            if v-ok = true
      591            then do:
      592               vdate:value = v-curr-sv-date .
      593            end.
      594         end.
      595      end.
      596   end method.
