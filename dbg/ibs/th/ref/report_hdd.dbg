      112     @VisualDesigner.
      113     method private void click_choice_obj( input sender as System.Object, input e as System.EventArgs ):
      114       define variable v-host-code like ub.sysconf.host-code no-undo .
      115       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      116       define variable v-select-obj-type  as character no-undo .
      117       define variable v-select-obj-code  as integer   no-undo .
      118       define variable v-object-available as logical   no-undo .
      119       define variable p-obj-list         as character no-undo .
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     run mainmenu_getcntxt in parparentproc
      131       (output v-cntxt-db-num
      132       ,output v-cntxt-userid
      133       ,output v-cntxt-level
      134       ,output v-cntxt-host-code-obj
      135       ,output v-cntxt-obj-type
      136       ,output v-cntxt-obj-code
      137       ,output v-cntxt-db-num-obj
      138       ,output v-cntxt-is-admin
      139       ) .
      140       for each buf_userobjs_temp-user-obj
      141         on error undo, return error return-value
      142         :
      143         delete buf_userobjs_temp-user-obj .
      144       end.
      145   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   run usobjava in ibs.th.gbl.gbl-hndllib:g#library2
      147     (input  v-cntxt-db-num
      148     ,input  0
      149     ,input  v-cntxt-userid
      150     ,input  v-cntxt-obj-type
      151     ,input  v-cntxt-obj-code
      152     ,output v-object-available
      153     ) no-error .
      154       if error-status :error
      155         then
      156       do:
      157         message
      158           "Ошибка при вызове процедуры gbl/usobjava.i" skip
      159           error-status :get-message(1) skip
      160           return-value skip
      161           view-as alert-box error .
      162         undo, return no-apply .
      163       end.
      164       if v-object-available = true
      165         then
      166       do:
      167         find first buf_userobjs_temp-user-obj
      168           where buf_userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      169           and buf_userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      170           and buf_userobjs_temp-user-obj.db-num = v-cntxt-db-num
      171           no-error .
      172         if not available buf_userobjs_temp-user-obj
      173           then
      174         do:
      175           create buf_userobjs_temp-user-obj .
      176           assign
      177             buf_userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      178             buf_userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      179             buf_userobjs_temp-user-obj.db-num   = v-cntxt-db-num
      180             .
      181         end.
      182       end.
      183       define variable v-user-select as logical no-undo .
      184       run gbl/userobjs.w
      185         (input  parparentproc
      186         ,input  p-callback-handle
      187         ,input  v-cntxt-db-num
      188         ,input  v-cntxt-userid
      189         ,input  v-cntxt-host-code-obj
      190         ,input  v-cntxt-obj-type
      191         ,input  v-cntxt-obj-code
      192         ,INPUT  "b-sel,b-mark"
      193         ,output v-user-select
      194         ,output v-select-obj-type
      195         ,output v-select-obj-code
      196         ) .
      197       if v-user-select <> true
      198         then
      199       do:
      200         message
      201           "Объект не выбран"
      202           view-as alert-box information .
      203         assign
      204           p-obj-list = ""
      205           v-obj-list = ""
      206           .
      207       end.
      208       else
      209       do:
      210         for each temp_obj-list:
      211           delete temp_obj-list.
      212         end.
      213         for each buf_userobjs_temp-user-obj
      214           on error undo, return no-apply
      215           :
      216           create temp_obj-list.
      217           assign
      218             temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
      219             temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
      220             .
      221         end.
      222         assign
      223           p-obj-list = ""
      224           v-obj-list = ""
      225           .
      226         for each temp_obj-list
      227           :
      228           assign
      229             p-obj-list = p-obj-list + "," + temp_obj-list.obj-type + "," + string( temp_obj-list.obj-code )
      230             .
      231           find first ub.clients no-lock where ub.clients.obj-code = userobjs_temp-user-obj.obj-code and ub.clients.obj-type = userobjs_temp-user-obj.obj-type no-error .
      232             if available (ub.clients) then v-obj-list = v-obj-list + "," + string( ub.clients.db-num).
      233             else v-obj-list = v-obj-list + "," + string(temp_obj-list.obj-code ).
      234         end.
      235         p-obj-list = trim (p-obj-list,",") .
      236         v-obj-list = trim(v-obj-list,",").
      237       end.
      238       this-object:obj_list:Text = string(p-obj-list) .
      239       return.
      240     end method.
      241           @VisualDesigner.
      242           method private void date_end_Leave( input sender as System.Object, input e as System.EventArgs ):
      243                     if this-object:date_start:Value > this-object:date_end:Value then do:
      244         message "Дата " + this-object:date_start:Text + " больше даты " + this-object:date_end:Text
      245         view-as alert-box.
      246         return no-apply .
      247       end.
      248                   return.
      249           end method.
      250           @VisualDesigner.
      251           method private void date_start_Leave( input sender as System.Object, input e as System.EventArgs ):
      252                   if date(this-object:date_start:Value) > date(today) then do:
      253                     message "Дата больше текущей даты."
      254         view-as alert-box.
      255         return no-apply .
      256                   end.
      257                   return.
      258           end method.
