      478   method void proc-alt-shift-f2 ():
      479     if not ibs.th.gbl.gbl-var:rcode
      480   then
      481     run gbl\inidebug.p .
      482   end.
      483   method void proc-alt-shift-f3 ():
      484      define variable vdebugalert   as logical no-undo .
      485      assign
      486         vdebugalert = session:debug-alert
      487         session:debug-alert = yes
      488      .
      489   message program-name( 1 ) skip( 1 )
      490             vss-revision                  skip( 0 )
      491             vss-author                    skip( 0 )
      492             vss-date                      skip( 0 )
      493             vss-workfile                  skip( 0 )
      494             vss-archive                   skip( 1 )
      495             vss-description               skip( 1 )
      496     view-as alert-box title "Текущая программа".
      497     session:debug-alert = vdebugalert.
      498   end.
      499   define variable v-inform-launched as logical no-undo initial false .
