        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.xproc.attr_trg:
        4   method private void getAttrLib ():
        5      define variable g#attr-lib  as handle no-undo .
        6      run gbl/getgattrlib.p (output g#attr-lib).
        7   end.
        8      define temp-table tt-query no-undo
        9         field NameQuery as character
       10         field hQuery    as handle
       11      index NameQuery NameQuery.
       12      define temp-table tt-attr
       13         field rowidf     as rowid
       14         field attr-code  as character
       15         field attr-name  as character
       16         field attr-value as character
       17         field mandatoryf as logical
       18         index attr-code attr-code
       19         index rowidf rowidf
       20         index mandatoryf mandatoryf
       21      .
       22      define public variable mbuffPar as handle  no-undo.
       23      define public variable mAll     as logical no-undo .
       24      define variable mKeyRec as class ibs.th.gbl.keyrec no-undo.
       25      define variable mGroupObj as character no-undo.
       26      define variable mWhere    as character no-undo.
       27      constructor public attr_trg (  ):
       28         super ().
       29         mKeyRec = new ibs.th.gbl.keyrec().
       30      end constructor.
       31      destructor public attr_trg ( ):
       32         delete object mKeyRec.
       33      end destructor.
       34      method public handle getQuery (input iNameQuery as character) :
       35         return getQuery(iNameQuery,no).
       36      end.
       37      method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
       38         define variable hQuery   as handle  no-undo .
       39         define variable vfirst   as logical no-undo .
       40         define variable vOpen    as logical no-undo init yes.
       41         define variable vTblName as character no-undo .
       42         define variable vOpenStr as character no-undo .
       43         define variable vSchedId as integer no-undo .
       44         define buffer xattr for xattr.
       45         define buffer tt-attr-new for tt-attr.
       46         find first tt-Query where tt-Query.NameQuery eq iNameQuery
       47         no-error.
       48         if     available tt-Query
       49            and iNewQuery
       50         then do:
       51            delete object tt-Query.hQuery.
       52            delete tt-Query.
       53         end.
       54         if not available tt-Query
       55         then
       56         do:
       57             create query hQuery.
       58         end.
       59         else
       60            hQuery = tt-Query.hQuery.
       61         case iNameQuery:
       62            when "tt-attr"
       63            then do:
       64               for each tt-attr:
       65                  delete tt-attr.
       66               end.
       67               define variable vTables as character no-undo.
       68               define variable vTablesAttr as character no-undo.
       69               define variable vBhTbl as handle no-undo.
       70               define variable vAttrCode as character no-undo.
       71               define variable vWhere as character no-undo.
       72               vTables = mbuffPar:table.
       73               vTablesAttr = vTables + "-attr".
       74               mkeyrec:GenWhereKeyrTab(vTables + "-attr", vTables, vTables + "-attr", mbuffPar, "ub", ?,  output mWhere).
       75               create buffer vBhTbl for table vTablesAttr .
       76               mGroupObj = mbuffPar:buffer-field ("GroupObj"):buffer-value ()no-error.
       77               if error-status:error
       78               then do:
       79                  .
       80                  vBhTbl:find-first( substitute("&1 and &2.attr-code eq 'GroupObj'",mwhere,vTablesAttr), no-lock ) no-error .
       81                  mGroupObj = if vBhTbl:available then vBhTbl:buffer-field ("attr-value"):buffer-value () else vTables.
       82               end.
       83               vWhere = substitute("FOR EACH &1 &2 ",vTables + "-attr",mWhere).
       84               create query hQuery.
       85               hQuery:set-buffers(vBhTbl).
       86               hQuery:query-prepare(vWhere + " No-lock") no-error.
       87               hQuery:query-open().
       88               hQuery:get-first().
       89               do while not hQuery:query-off-end:
       90                  vAttrCode = vBhTbl:buffer-field("attr-code"):buffer-value.
       91                  find first xattr where Xattr.GroupObj-code eq  mGroupObj
       92                                     and Xattr.Xattr-Code    eq  vAttrCode
       93                  no-lock no-error.
       94                  if   (     available xattr
       95                        and  not Xattr.Hidden)
       96                     or not available xattr
       97                  then do:
       98                     create tt-attr-new.
       99                     tt-attr-new.rowidf     = vBhTbl:rowid.
      100                     tt-attr-new.attr-code  = vAttrCode.
      101                     if available xattr then do:
      102                        tt-attr-new.attr-name  = Xattr.Name.
      103                        tt-attr-new.attr-value = formatVulue(vBhTbl:buffer-field("attr-value"):buffer-value,Xattr.Data-Type,Xattr.Data-Format).
      104                        tt-attr-new.mandatoryf = Xattr.Mandatory.
      105                     end.
      106                     else do:
      107                        tt-attr-new.attr-name  = vAttrCode.
      108                        tt-attr-new.attr-value = vBhTbl:buffer-field("attr-value"):buffer-value.
      109                     end.
      110                  end.
      111                  hQuery:get-next().
      112               end.
      113               delete object vBhTbl.
      114               for each xattr where Xattr.GroupObj-code eq  mGroupObj
      115                                and not Xattr.Hidden
      116                                and not Xattr.Progress-Field
      117                                and (   Xattr.Mandatory or mAll)
      118               no-lock:
      119                  find first tt-attr where tt-attr.attr-code eq Xattr.Xattr-Code
      120                  no-lock no-error.
      121                  if not available tt-attr
      122                  then do:
      123                     create tt-attr-new.
      124                     assign
      125                        tt-attr-new.attr-code  = Xattr.Xattr-Code
      126                        tt-attr-new.attr-name  = Xattr.Name
      127                        tt-attr-new.mandatoryf = Xattr.Mandatory
      128                     .
      129                     release tt-attr-new.
      130                  end.
      131               end.
      132               hQuery:set-buffers(buffer tt-attr:HANDLE).
      133               hQuery:query-prepare("FOR EACH tt-attr ").
      134            end.
      135         end case.
      136         if vOpen
      137         then do:
      138            hQuery:query-open.
      139            if vFirst
      140            then
      141               hQuery:get-first () no-error .
      142         end.
      143         if not available tt-Query
      144         then do:
      145            create tt-Query.
      146            assign
      147               tt-Query.NameQuery = iNameQuery
      148               tt-Query.hQuery    = hQuery
      149            .
      150         end.
      151         return hQuery.
      152      end.
      153      method public void brwAttr():
      154         define variable VBrw as class ibs.th.ref.xproc.attr no-undo.
      155         vBrw = new ibs.th.ref.xproc.attr (this-object).
      156         vBrw:ShowModalDialog().
      157         delete object vbrw.
      158      end method.
      159      method public character formatVulue(ivalue as character ,
      160                                          iType  as character ,
      161                                          iFormat as character):
      162         return trim(
      163                   if iType eq 'decimal':U
      164                   then string(decimal (ivalue), iFormat)
      165                   else if iType eq 'date':U
      166                   then string(date    (ivalue), iFormat)
      167                   else if iType eq 'integer':U
      168                   then string(integer (ivalue), iFormat)
      169                   else if iType eq 'logical':U
      170                   then string(logical (ivalue), iFormat)
      171                   else string(         ivalue , iFormat)
      172                   ).
      173      end method.
      174      method public void editform():
      175         define variable vFrmTrg as class ibs.th.ref.xproc.attrfrm_trg no-undo.
      176         define variable vresult as character no-undo.
      177         if available tt-attr
      178         then do:
      179            vFrmTrg = new ibs.th.ref.xproc.attrfrm_trg().
      180            vFrmTrg:GroupObj = mGroupObj.
      181            vFrmTrg:AttrCode = tt-attr.attr-code.
      182            if vFrmTrg:FrmAttr(if tt-attr.rowidf eq ? then ? else tt-attr.attr-value)
      183            then do:
      184               vresult = vFrmTrg:resultValue.
      185                           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run attr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib
      186                    (mbuffPar,
      187                     tt-attr.attr-code,
      188                     vresult)no-error.
      189               if error-status:error
      190               then do:
      191                  message return-value
      192                  view-as alert-box.
      193               end.
      194               else do:
      195                  define variable vBhTbl as handle no-undo.
      196                  define variable vTablesAttr as character no-undo.
      197                  vTablesAttr = mbuffPar:table + "-attr".
      198                  create buffer vBhTbl for table vTablesAttr .
      199                  vBhTbl:find-first( substitute("&1 and &2.attr-code eq '&3'",mwhere,vTablesAttr,tt-attr.attr-cod), no-lock ) no-error .
      200                  if vBhTbl:available
      201                  then do:
      202                     find first xattr where Xattr.GroupObj-code  eq mGroupObj
      203                                        and Xattr.Xattr-Code     eq tt-attr.attr-code
      204                     no-lock no-error.
      205                        tt-attr.attr-value = if available xattr
      206                                             then formatVulue(vresult,Xattr.Data-Type,Xattr.Data-Format)
      207                                             else vresult.
      208                        tt-attr.rowidf = vBhTbl:rowid.
      209                  end.
      210                  else
      211                     message "Беда"
      212                     view-as alert-box.
      213               end.
      214            end.
      215            delete object vFrmTrg.
      216         end.
      217      end method.
      218   end class.
