        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.xproc.attrfrm_trg:
        4    define  temp-table tmprecid
        5       field Frecid as recid init ?
        6       field fnum as character
        7       field fTable as character
        8    index num  fnum Frecid
        9    index itable is primary unique fTable Frecid
       10    .
       11   define variable fSelect as logical no-undo format "*/" column-label "".
       12   method public logical isSelect
       13       (iBuffer as handle  ):
       14       define buffer tmprecid for tmprecid.
       15       if iBuffer:available
       16       then
       17          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       18                                and tmprecid.Frecid = iBuffer:recid
       19          no-lock no-error.
       20       return available tmprecid.
       21    end.
       22   method public logical setSelect
       23       (iBuffer as handle  ):
       24       define buffer tmprecid for tmprecid.
       25       if iBuffer:available
       26       then do:
       27          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       28                                and tmprecid.Frecid = iBuffer:recid
       29          no-lock no-error.
       30          if available tmprecid
       31          then
       32             delete tmprecid.
       33          else do:
       34             create tmprecid.
       35             assign
       36                tmprecid.fTable = iBuffer:TABLE
       37                tmprecid.Frecid = iBuffer:recid
       38             .
       39          end.
       40       end.
       41       return available tmprecid.
       42    end.
       43   method private void getAttrLib ():
       44      define variable g#attr-lib  as handle no-undo .
       45      run gbl/getgattrlib.p (output g#attr-lib).
       46   end.
       47      define public variable GroupObj    as character no-undo.
       48      define public variable AttrCode    as character no-undo.
       49      define public variable resultValue as character no-undo.
       50      constructor public attrfrm_trg (  ):
       51         super ().
       52      end constructor.
       53      destructor public attrfrm_trg ( ):
       54      end destructor.
       55      define variable mValue as character no-undo.
       56      define variable mNum   as logical no-undo.
       57      define variable mDate  as logical no-undo.
       58      define variable mCheck as logical no-undo.
       59      define variable mtext  as logical no-undo.
       60      define variable mComb  as logical no-undo.
       61      define variable vMaxDec as decimal no-undo init ?.
       62      define variable vMinDec as decimal no-undo init ?.
       63      define variable vMaxDat as date no-undo init ?.
       64      define variable vMinDat as date no-undo init ?.
       65      define variable vMaxStr as character  no-undo.
       66      define variable vMinStr as character  no-undo.
       67      define variable vdec as char no-undo.
       68      define variable vi as integer no-undo.
       69      define variable vpos as integer no-undo.
       70      define variable mfrm as class ibs.th.ref.xproc.attrfrm no-undo.
       71      method public logical  FrmAttr(ivalue as character ):
       72         define buffer xattr for xattr.
       73         mFrm = new ibs.th.ref.xproc.attrfrm (this-object).
       74         find first xattr where Xattr.GroupObj-code eq GroupObj
       75                            and Xattr.Xattr-Code    eq AttrCode
       76         no-lock no-error.
       77         if available xattr
       78         then do:
       79            if Xattr.Data-Type eq 'decimal':U
       80            then do:
       81               vdec =  replace(entry(1,Xattr.Data-Format,"."),",","").
       82               if Xattr.Validation ne ""
       83               then do:
       84                  vpos = index(Xattr.Validation,"<<").
       85                  if vpos ne 0
       86                  then do:
       87                     vminstr = substring(Xattr.Validation,1,vpos - 1).
       88                     vmaxStr = substring(Xattr.Validation,vpos + 2).
       89                     if vminstr ne ""
       90                     then
       91                        vmindec = decimal (vminstr)no-error.
       92                     if vmaxStr ne ""
       93                     then
       94                        vmaxdec = decimal (vmaxStr)no-error.
       95                  end.
       96               end.
       97               if vdec begins "-"
       98               then do:
       99                  assign
      100                     vmindec = decimal("-" + fill("9",length(vdec) - 1) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "" ) when vmindec eq ?
      101                     vmaxdec = decimal(      fill("9",length(vdec) - 1) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "")  when vmaxdec eq ?
      102                  .
      103               end.
      104               else
      105                  assign
      106                     vmindec = 0                                                                                                               when vmindec eq ?
      107                     vmaxdec = decimal(      fill("9",length(vdec)    ) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "") when vmaxdec eq ?
      108                  .
      109               mfrm:numericUpDown:Minimum = vmindec.
      110               mfrm:numericUpDown:Maximum = vmaxdec.
      111               if     ivalue = ?
      112               then do:
      113                  if Xattr.Initial ne ""
      114                  then
      115                     ivalue = Xattr.Initial.
      116                  else
      117                     ivalue = string(vMindec).
      118               end.
      119               mfrm:numericUpDown:Visible = yes.
      120               mfrm:numericUpDown:DecimalPlaces = Xattr.Accuracy.
      121               mNum = yes.
      122            end.
      123            else if Xattr.Data-Type eq 'date':U
      124            then do :
      125               if Xattr.Validation ne ""
      126               then do:
      127                  vpos = index(Xattr.Validation,"<<").
      128                  if vpos ne 0
      129                  then do:
      130                     vminstr = substring(Xattr.Validation,1,vpos - 1).
      131                     vmaxStr = substring(Xattr.Validation,vpos + 2).
      132                     if vminstr ne ""
      133                     then
      134                        vmindat = date  (vminstr) no-error.
      135                     if vmaxStr ne ""
      136                     then
      137                        vmaxdat = date (vmaxStr) no-error.
      138                     assign
      139                        mfrm:dateTimePicker:mindate = vmindat when vmindat ne ?
      140                        mfrm:dateTimePicker:maxdate = vmaxdat when vmaxdat ne ?
      141                     .
      142                  end.
      143               end.
      144               mfrm:dateTimePicker:Visible = yes.
      145               mdate = yes.
      146            end.
      147            else if Xattr.Data-Type eq 'integer':U
      148            then do:
      149               vdec =  replace(entry(1,Xattr.Data-Format,"."),",","").
      150               if Xattr.Validation ne ""
      151               then do:
      152                  vpos = index(Xattr.Validation,"<<").
      153                  if vpos ne 0
      154                  then do:
      155                     vminstr = substring(Xattr.Validation,1,vpos - 1).
      156                     vmaxStr = substring(Xattr.Validation,vpos + 2).
      157                     if vminstr ne ""
      158                     then
      159                        vmindec = integer  (vminstr)no-error.
      160                     if vmaxStr ne ""
      161                     then
      162                        vmaxdec = integer (vmaxStr)no-error.
      163                  end.
      164               end.
      165               if vdec begins "-"
      166               then do:
      167                  assign
      168                     vmindec = decimal("-" + fill("9",length(vdec) - 1)  ) when vmindec eq ?
      169                     vmaxdec = decimal(      fill("9",length(vdec) - 1)  ) when vmaxdec eq ?
      170                  .
      171               end.
      172               else
      173                  assign
      174                     vmindec = 0                                          when vmindec eq ?
      175                     vmaxdec = decimal(      fill("9",length(vdec)    ) ) when vmaxdec eq ?
      176                  .
      177               mfrm:numericUpDown:Minimum = vmindec.
      178               mfrm:numericUpDown:Maximum = vmaxdec.
      179               if     ivalue = ?
      180               then do:
      181                  if Xattr.Initial ne ""
      182                  then
      183                     ivalue = Xattr.Initial.
      184                  else
      185                     ivalue = string(vMindec).
      186               end.
      187               mfrm:numericUpDown:Visible = yes.
      188               mnum = yes.
      189            end.
      190            else if Xattr.Data-Type eq 'logical':U
      191            then do:
      192               mfrm:checkBox:Visible = yes.
      193               mfrm:checkBox:Text    = Xattr.Name.
      194               mcheck = yes.
      195            end.
      196            else do:
      197               if xattr.listValue
      198               then do:
      199                  mfrm:textBox:Visible = true.
      200                  mfrm:button:Visible  =  Xattr.Domain-Code ne "".
      201                  mtext = yes.
      202               end.
      203               else if Xattr.Domain-Code ne ""
      204               then do:
      205                  mfrm:comboBox:Visible = true.
      206                  mComb = yes.
      207                  define variable vParent as character no-undo.
      208                  vParent = replace(Xattr.Domain-Code, "\", chr(4)).
      209                  for each code where code.parent  eq  vParent
      210                                  and code.status_ ne 1
      211                  no-lock:
      212                     mfrm:comboBox:Items:Add(code.code).
      213                  end.
      214               end.
      215               else if     Xattr.Validation ne ""
      216                       and index (Xattr.Validation,".") eq 0
      217                       and index (Xattr.Validation,"*") eq 0
      218               then do:
      219                  mComb = yes.
      220                  do vi = 1 to num-entries(Xattr.Validation):
      221                     mfrm:comboBox:Items:Add(entry(vi,Xattr.Validation)).
      222                  end.
      223               end.
      224               else do:
      225                  mfrm:textBox:Visible = true.
      226                  mtext = yes.
      227               end.
      228            end.
      229         end.
      230         else do:
      231            mfrm:textBox:Visible = true.
      232            mtext = yes.
      233         end.
      234         resultValue = ivalue.
      235         if mnum
      236         then
      237             mfrm:numericUpDown:Value = dec(resultValue) no-error.
      238         else if mdate
      239         then
      240            mfrm:dateTimePicker:Value = date(resultValue) no-error.
      241         else if mcheck
      242         then
      243            mfrm:checkBox:Checked = logical(resultValue) no-error.
      244         else if mComb
      245         then
      246            mfrm:comboBox:text = resultValue.
      247         else if mtext
      248         then
      249            mfrm:textBox:text = resultValue.
      250         mFrm:ShowModalDialog().
      251         if mFrm:DialogResult = System.Windows.Forms.DialogResult:Ok
      252         then do:
      253            resultValue = mValue.
      254            return yes.
      255         end.
      256         return no.
      257         finally:
      258            delete object mFrm no-error.
      259         end finally.
      260      end method.
      261      method public void setresult ():
      262         if mnum
      263            then
      264               mValue = string(mfrm:numericUpDown:Value).
      265            else if mdate
      266            then
      267               mValue = string(mfrm:dateTimePicker:Value).
      268            else if mcheck
      269            then
      270               mValue = string(mfrm:checkBox:Checked).
      271            else if mComb
      272            then
      273               mValue = mfrm:comboBox:text.
      274            else if mtext
      275            then
      276               mValue = mfrm:textBox:text.
      277      end.
      278      method public character  btnCode(iValue as character ):
      279         define buffer xattr for xattr.
      280         define buffer code for code.
      281         define variable vParent as character no-undo.
      282         define variable vCode   as character no-undo.
      283         define variable oValue as character no-undo.
      284         oValue = ivalue.
      285         find first xattr where Xattr.GroupObj-code eq GroupObj
      286                            and Xattr.Xattr-Code    eq AttrCode
      287         no-lock no-error.
      288         if num-entries(Xattr.Domain-Code,"\") eq 1
      289         then
      290            vcode = Xattr.Domain-Code.
      291         else
      292            assign
      293               vparent = Xattr.Domain-Code
      294               vcode   = entry ( num-entries(vparent,"\"),vparent,"\")
      295               entry ( num-entries(vparent,"\"),vparent,"\") = ""
      296               vParent = replace(trim(Xattr.Domain-Code, "\"),"\", chr(4))
      297            .
      298         run ref/codelayout.p('ВЫБОР':U,vParent,vcode, ?,output table tmprecid).
      299         for each tmprecid,
      300           first code where recid(code) eq tmprecid.Frecid:
      301           if lookup(code.code, oValue) = 0
      302           then
      303              oValue = oValue + "," + code.code.
      304         end.
      305         ovalue = trim(ovalue,",").
      306         return ovalue.
      307      end method.
      308      method public logical CheckAttr():
      309                     if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run attr-Check-group in ibs.th.gbl.gbl-hndllib:g#attr-lib
      310                    (GroupObj,
      311                     AttrCode ,
      312                     mValue) no-error.
      313         if error-status:error
      314         then do:
      315            message   return-value
      316            view-as alert-box.
      317            return no.
      318         end.
      319         return yes.
      320      end.
      321   end class.
