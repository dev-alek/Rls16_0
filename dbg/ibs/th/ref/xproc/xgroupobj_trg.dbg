        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.xproc.xgroupobj_trg:
        4      constructor public xgroupobj_trg (  ):
        5         super ().
        6      end constructor.
        7      destructor public xgroupobj_trg ( ):
        8      end destructor.
        9      define temp-table tt-query no-undo
       10         field NameQuery as character
       11         field hQuery    as handle
       12      index NameQuery NameQuery.
       13      define temp-table tt-groupobj no-undo like xgroupobj
       14         field Frecid  as recid
       15         field fchange as logical
       16      .
       17     define variable Parent as character no-undo.
       18     define variable BegParent as character no-undo init ?.
       19      method public handle getQuery (input iNameQuery as character ) :
       20         return   getQuery(iNameQuery,no).
       21      end.
       22      method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
       23         define variable hQuery   as handle  no-undo .
       24         define variable vfirst   as logical no-undo .
       25         define variable vOpen    as logical no-undo init yes.
       26         define variable vTblName as character no-undo .
       27         define variable vOpenStr as character no-undo .
       28         define variable vSchedId as integer no-undo .
       29         find first tt-Query where tt-Query.NameQuery eq iNameQuery
       30         no-error.
       31         if     available tt-Query
       32            and iNewQuery
       33         then do:
       34            delete object tt-Query.hQuery.
       35            delete tt-Query.
       36         end.
       37         if not available tt-Query
       38         then
       39         do:
       40             create query hQuery.
       41         end.
       42         else
       43            hQuery = tt-Query.hQuery.
       44         case iNameQuery:
       45            when "tt-groupobj"
       46            then do:
       47               for each tt-groupobj:
       48                  delete tt-groupobj.
       49               end.
       50               for each xgroupobj where xgroupobj.Parent-GroupObj eq  Parent
       51               no-lock:
       52                  create tt-groupobj.
       53                  buffer-copy xgroupobj to tt-groupobj
       54                  assign
       55                     tt-groupobj.Frecid = recid (xgroupobj)
       56                  .
       57               end.
       58               hQuery:set-buffers(buffer tt-groupobj:HANDLE).
       59               hQuery:query-prepare("FOR EACH tt-groupobj ").
       60            end.
       61            when "xgroupobj"
       62            then do:
       63               hQuery:set-buffers(buffer xgroupobj:HANDLE).
       64               hQuery:query-prepare("FOR EACH xgroupobj where xgroupobj.Parent-GroupObj eq " + QUOTER(parent) +
       65               " no-lock").
       66            end.
       67         end case.
       68         if vOpen
       69         then do:
       70            hQuery:query-open.
       71            if vFirst
       72            then
       73               hQuery:get-first () no-error .
       74         end.
       75         if not available tt-Query
       76         then do:
       77            create tt-Query.
       78            assign
       79               tt-Query.NameQuery = iNameQuery
       80               tt-Query.hQuery    = hQuery
       81            .
       82         end.
       83         return hQuery.
       84      end.
       85      method public void addgroupobj ( ):
       86         define buffer xGroupObj for xGroupObj.
       87         create tt-GroupObj.
       88         tt-GroupObj.Parent-GroupObj = parent.
       89         frmGroupObj('ДОБАВЛЕНИЕ':U , buffer tt-GroupObj:handle).
       90         finally:
       91            delete tt-GroupObj.
       92         end finally.
       93      end method.
       94      method public void editgroupobj ( ):
       95         if available xGroupObj
       96         then do:
       97            buffer-copy xGroupObj to tt-GroupObj.
       98            tt-GroupObj.Frecid  = recid(xGroupObj).
       99            frmGroupObj('ИЗМЕНЕНИЕ':U,buffer tt-GroupObj:handle).
      100         end.
      101         finally:
      102            if available tt-GroupObj
      103            then
      104               delete tt-GroupObj.
      105         end finally.
      106      end method.
      107      method public logical delgroupobj ( ):
      108         if available xGroupObj
      109         then do:
      110            find current xGroupObj exclusive-lock.
      111            if available xGroupObj
      112            then do:
      113               delete xGroupObj no-error.
      114               if error-status:error
      115               then do:
      116                  message return-value
      117                  view-as alert-box.
      118                  return no.
      119               end.
      120            end.
      121         end.
      122         return yes.
      123      end.
      124      method public void lookgroupobj ( ):
      125         if available  xGroupObj
      126         then
      127            frmGroupObj('ПРОСМОТР':U , buffer xGroupObj:handle).
      128      end method.
      129      method public void frmGroupObj (Imode as character ,ibuffertt as handle ):
      130         define variable VSave as logical no-undo.
      131         define variable v-frmEdit as class ibs.th.ref.xproc.xgroupobjFrm no-undo.
      132         if Imode eq 'ПРОСМОТР':U
      133         then
      134            v-frmEdit = new ibs.th.ref.xproc.xgroupobjfrm().
      135         else
      136            v-frmEdit = new ibs.th.ref.xproc.xgroupobjfrm(this-object).
      137         v-frmEdit:ShowModalDialog(ibuffertt) .
      138         VSave = v-frmEdit:DialogResult eq System.Windows.Forms.DialogResult:ok.
      139         delete object v-frmEdit.
      140         if VSave
      141         then do trans:
      142             if Imode eq 'ДОБАВЛЕНИЕ':U
      143             then
      144                create xGroupObj.
      145             else
      146                find current xGroupObj exclusive-lock.
      147             buffer-copy tt-GroupObj to xGroupObj.
      148         end.
      149      end method.
      150      method public void NextLevel():
      151         if BegParent eq ?
      152         then
      153            BegParent = parent.
      154         if available xgroupobj
      155         then
      156            parent = xGroupObj.GroupObj-Code.
      157         else if available tt-groupobj
      158         then
      159            parent = tt-GroupObj.GroupObj-Code.
      160         return.
      161      end method.
      162      method public logical CheckRec():
      163         define buffer xgroupobj for xgroupobj.
      164         find first xgroupobj where xGroupObj.GroupObj-Code eq tt-groupobj.GroupObj-Code
      165                                and recid(xGroupObj) ne tt-groupobj.Frecid
      166            no-lock no-error.
      167         if available xgroupobj
      168         then do:
      169            message "Уже есть запись с кодом " tt-groupobj.GroupObj-Code
      170            view-as alert-box.
      171            return no.
      172         end.
      173         else
      174            return yes.
      175      end.
      176      method public logical validNextLevel():
      177         return (available xGroupObj and xGroupObj.Hierarchy) or (available tt-GroupObj and tt-GroupObj.Hierarchy).
      178      end.
      179      method public logical PrevLevel():
      180         define buffer xGroupObj for xGroupObj.
      181         if BegParent eq ? or BegParent eq parent
      182         then
      183            return no.
      184         else do:
      185            find first xGroupObj where xGroupObj.GroupObj-Code eq parent
      186            no-lock no-error.
      187            if available xGroupObj
      188            then
      189               parent = xGroupObj.Parent-GroupObj.
      190            else
      191               return no.
      192         end.
      193         return yes.
      194      end method.
      195      method public void ViewMenu():
      196         define variable vChoice as integer no-undo.
      197         if    available xGroupObj
      198            or available tt-groupobj
      199         then do:
      200            run gbl/d-askw.w (input "Меню",
      201                              input "Выберите действие",
      202                              input "||",
      203                              input "Атрибуты|Статусы|Отмена",
      204                              input "Список атрибутов|Список статусов|",
      205                              input 1,
      206                              input 3,
      207                              output vchoice).
      208            if vChoice eq 1
      209            then
      210               run ref\xattr.p(if available xGroupObj then xGroupObj.GroupObj-Code else tt-groupobj.GroupObj-Code).
      211         end.
      212      end.
      213   end class.
