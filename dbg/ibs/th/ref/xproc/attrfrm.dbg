      196   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      197         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      198         then do:
      199             proc-alt-shift-f3 ().
      200         end.
      201         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      202         then do:
      203             proc-alt-shift-f2 ().
      204         end.
      205   end method.
      206   method private void End_obj_KeyDown():
      207   catch e as Progress.Lang.Error:
      208            undo, throw e.
      209         end catch.
      210   end method.
      211   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      212      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      213      define variable v-curr-sv-date as date no-undo .
      214      define variable v-new-sv-date  as date no-undo .
      215      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      216      then do:
      217         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      218         run gbl/getcurdt.p
      219            (output v-curr-sv-date
      220         ) .
      221         vdate:value = v-curr-sv-date.
      222      end.
      223      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      224      then do:
      225         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      226         v-curr-sv-date = vdate:value .
      227         if v-curr-sv-date = ?
      228         then do:
      229            run gbl/getcurdt.p
      230               (output v-curr-sv-date
      231            ) .
      232         end.
      233         if v-curr-sv-date <> ?
      234         then do:
      235            assign
      236               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      237               vdate:value = v-new-sv-date
      238            .
      239         end.
      240      end.
      241      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      242      then do:
      243         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      244         v-curr-sv-date = vdate:value.
      245         if v-curr-sv-date = ?
      246         then do:
      247            run gbl/getcurdt.p
      248               (output v-curr-sv-date
      249            ) .
      250         end.
      251         if v-curr-sv-date <> ?
      252         then do:
      253            run gbl/lastdate.p
      254               (input  v-curr-sv-date
      255               ,output v-new-sv-date
      256            ).
      257            vdate:value = v-new-sv-date.
      258         end.
      259      end.
      260      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      261      then do:
      262         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      263         define variable v-description   as character no-undo .
      264         define variable v-ok            as logical no-undo.
      265         v-curr-sv-date = vdate:value.
      266         if v-curr-sv-date = ?
      267         then do:
      268            run gbl/getcurdt.p
      269               (output v-curr-sv-date
      270            ) .
      271         end.
      272         if v-curr-sv-date <> ?
      273         then do:
      274            run gbl/d-inpday.w
      275               (input ?
      276               ,input "Выбор даты"
      277               ,input v-description
      278               ,input ""
      279               ,input-output v-curr-sv-date
      280               ,output v-ok
      281            ).
      282            if v-ok = true
      283            then do:
      284               vdate:value = v-curr-sv-date .
      285            end.
      286         end.
      287      end.
      288   end method.
      289   method private void End_date_KeyDown():
      290         catch e as Progress.Lang.Error:
      291            undo, throw e.
      292         end catch.
      293      end method.
