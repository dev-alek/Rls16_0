      170   method void proc-alt-shift-f2 ():
      171     if not ibs.th.gbl.gbl-var:rcode
      172   then
      173     run gbl\inidebug.p .
      174   end.
      175   method void proc-alt-shift-f3 ():
      176      define variable vdebugalert   as logical no-undo .
      177      assign
      178         vdebugalert = session:debug-alert
      179         session:debug-alert = yes
      180      .
      181   message program-name( 1 ) skip( 1 )
      182             vss-revision                  skip( 0 )
      183             vss-author                    skip( 0 )
      184             vss-date                      skip( 0 )
      185             vss-workfile                  skip( 0 )
      186             vss-archive                   skip( 1 )
      187             vss-description               skip( 1 )
      188     view-as alert-box title "Текущая программа".
      189     session:debug-alert = vdebugalert.
      190   end.
      191   define variable v-inform-launched as logical no-undo initial false .
