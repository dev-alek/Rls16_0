      429      method private void ChangeDataType():
      430         if DataTypeF:text eq 'decimal':U
      431         then
      432            assign
      433               Accuracyf:visible = yes
      434               Accuracyl:visible = yes
      435            .
      436         else
      437            assign
      438               Accuracyf:visible = no
      439               Accuracyl:visible = no
      440            .
      441         if DataTypeF:text eq 'character':U
      442         then
      443            assign
      444               listvalue:visible   = yes
      445               ValidationF:visible = yes
      446               Validationl:visible = yes
      447            .
      448         else do:
      449            listvalue:visible   = no.
      450            if DataTypeF:text eq 'logical':U
      451            then
      452              assign
      453                  ValidationF:visible = no
      454                  ValidationL:visible = no
      455            .
      456            else
      457               assign
      458                  ValidationF:visible = yes
      459                  ValidationL:visible = yes
      460            .
      461         end.
      462      end.
      463      method private void SetFormat():
      464         DataFormatF:text =   if DataTypeF:text eq 'decimal':U
      465                              then ">>,>>>,>>>,>>9.99"
      466                              else if DataTypeF:text eq 'date':U
      467                              then "99/99/9999"
      468                              else if DataTypeF:text eq 'integer':U
      469                              then ">>>>>>>>9"
      470                              else if DataTypeF:text eq 'logical':U
      471                              then "Да/Нет"
      472                              else "X(12)".
      473      end.
      474      method private void lockField(ienable as logical):
      475         buttonOk:enabled = ienable.
      476         XattrCodeF:enabled = ienable.
      477         NameF:enabled = ienable.
      478         Constant:enabled = ienable.
      479         OverridableF:enabled = ienable.
      480         Hiddenf:enabled = ienable.
      481         MandatoryF:enabled = ienable.
      482         DataTypeF:enabled = ienable.
      483         Accuracyf:enabled = ienable.
      484         DataFormatF:enabled = ienable.
      485         InitialF:enabled = ienable.
      486         DomenCodeF:enabled = ienable.
      487         ValidationF:enabled = ienable.
      488         descF:enabled = ienable.
      489         OrderF:enabled = ienable.
      490         ClableF:enabled = ienable.
      491         labelf:enabled = ienable.
      492         listvalue:enabled = ienable.
      493      end.
