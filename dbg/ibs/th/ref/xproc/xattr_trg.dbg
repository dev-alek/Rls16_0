        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.xproc.xattr_trg:
        4      define temp-table tt-query no-undo
        5         field NameQuery as character
        6         field hQuery    as handle
        7      index NameQuery NameQuery.
        8      define temp-table tt-attr no-undo like xattr
        9         field Frecid  as recid
       10         field fchange as logical
       11      .
       12      constructor public xattr_trg (  ):
       13         super ().
       14      end constructor.
       15      destructor public xattr_trg ( ):
       16      end destructor.
       17      define public variable GroupObjCode as character no-undo.
       18      method public handle getQuery (input iNameQuery as character ) :
       19         return   getQuery(iNameQuery,no).
       20      end.
       21      method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
       22         define variable hQuery   as handle  no-undo .
       23         define variable vfirst   as logical no-undo .
       24         define variable vOpen    as logical no-undo init yes.
       25         define variable vTblName as character no-undo .
       26         define variable vOpenStr as character no-undo .
       27         define variable vSchedId as integer no-undo .
       28         find first tt-Query where tt-Query.NameQuery eq iNameQuery
       29         no-error.
       30         if     available tt-Query
       31            and iNewQuery
       32         then do:
       33            delete object tt-Query.hQuery.
       34            delete tt-Query.
       35         end.
       36         if not available tt-Query
       37         then
       38         do:
       39             create query hQuery.
       40         end.
       41         else
       42            hQuery = tt-Query.hQuery.
       43         case iNameQuery:
       44            when "tt-attr"
       45            then do:
       46               for each tt-attr:
       47                  delete tt-attr.
       48               end.
       49               for each xattr where Xattr.GroupObj-code eq  GroupObjCode
       50               no-lock:
       51                  create tt-attr.
       52                  buffer-copy xattr to tt-attr
       53                  assign
       54                     tt-attr.Frecid = recid (xgroupobj)
       55                  .
       56               end.
       57               hQuery:set-buffers(buffer tt-attr:HANDLE).
       58               hQuery:query-prepare("FOR EACH tt-attr ").
       59            end.
       60            when "xattr"
       61            then do:
       62               hQuery:set-buffers(buffer xattr:HANDLE).
       63               hQuery:query-prepare("FOR EACH xattr where xattr.GroupObj-code eq " + QUOTER(GroupObjCode) +
       64               " no-lock").
       65            end.
       66         end case.
       67         if vOpen
       68         then do:
       69            hQuery:query-open.
       70            if vFirst
       71            then
       72               hQuery:get-first () no-error .
       73         end.
       74         if not available tt-Query
       75         then do:
       76            create tt-Query.
       77            assign
       78               tt-Query.NameQuery = iNameQuery
       79               tt-Query.hQuery    = hQuery
       80            .
       81         end.
       82         return hQuery.
       83      end.
       84      method public void brwAttr():
       85         define variable VBrw as class ibs.th.ref.xproc.xattr no-undo.
       86         vBrw = new ibs.th.ref.xproc.Xattr (this-object).
       87         vBrw:ShowModalDialog().
       88         delete object vbrw.
       89      end.
       90      method public void addXattr ( ):
       91         define buffer Xattr for Xattr.
       92         create tt-attr.
       93         tt-attr.GroupObj-code = GroupObjCode.
       94         tt-attr.sign-inherit  = GroupObjCode.
       95         frmAttr('днаюбкемхе':U , buffer tt-attr:handle).
       96         finally:
       97            delete tt-Attr.
       98         end finally.
       99      end method.
      100      method public void editXattr ( ):
      101         if available Xattr
      102         then do:
      103            buffer-copy Xattr to tt-attr.
      104            tt-attr.Frecid  = recid(Xattr).
      105            frmAttr('хглемемхе':U,buffer tt-Attr:handle).
      106         end.
      107         finally:
      108            if available tt-attr
      109            then
      110               delete tt-attr.
      111         end finally.
      112      end method.
      113      method public logical delXAttr ( ):
      114         if available Xattr
      115         then do:
      116            find current Xattr exclusive-lock.
      117            if available Xattr
      118            then do:
      119               delete Xattr no-error.
      120               if error-status:error
      121               then do:
      122                  message return-value
      123                  view-as alert-box.
      124                  return no.
      125               end.
      126            end.
      127         end.
      128         return yes.
      129      end.
      130      method public void lookXattr ( ):
      131         if available  Xattr
      132         then
      133            frmattr('опнялнрп':U , buffer Xattr:handle).
      134      end method.
      135      method public void frmAttr (Imode as character ,ibuffertt as handle ):
      136         define variable VSave as logical no-undo.
      137         define variable v-frmEdit as class ibs.th.ref.xproc.xattrFrm no-undo.
      138         if Imode eq 'опнялнрп':U
      139         then
      140            v-frmEdit = new ibs.th.ref.xproc.xattrfrm().
      141         else
      142            v-frmEdit = new ibs.th.ref.xproc.xattrfrm(this-object).
      143         v-frmEdit:ShowModalDialog(ibuffertt) .
      144         VSave = v-frmEdit:DialogResult eq System.Windows.Forms.DialogResult:ok.
      145         delete object v-frmEdit.
      146         if VSave
      147         then do trans:
      148             if Imode eq 'днаюбкемхе':U
      149             then
      150                create xAttr.
      151             else
      152                find current xattr exclusive-lock.
      153             buffer-copy tt-attr to xattr.
      154         end.
      155      end method.
      156   end class.
