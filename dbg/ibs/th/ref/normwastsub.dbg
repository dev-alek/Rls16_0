        1   using Progress.Lang.*.
        2   using ibs.th.ref.*.
        3   using ibs.th.gbl.storage.* from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.ref.normwastsub:
        6   method private void getAttrLib ():
        7      define variable g#attr-lib  as handle no-undo .
        8      run gbl/getgattrlib.p (output g#attr-lib).
        9   end.
       10     define property ParGdsOAttr as class ibs.th.ref.pargdsoattr no-undo get. set.
       11     define property NormalWastageWinter as decimal no-undo init 0 get. set.
       12     define property NormalWastageSummer as decimal no-undo init 0 get. set.
       13     define property NormalWastageTransWinter as decimal no-undo init 0 get. set.
       14     define property NormalWastageTransSummer as decimal no-undo init 0 get. set.
       15     define property NormalWastageDate as decimal no-undo init 0 get. set.
       16     define property NormalWastageTransDate as decimal no-undo init 0 get. set.
       17     define property BeginWinter as date no-undo get. set.
       18     define property BeginSummer as date no-undo get. set.
       19     define property IsDecommissioned as logical no-undo get. set.
       20     define property NormWastS as decimal init 0.0 no-undo
       21       get.
       22       set.
       23     define property NormWastW as decimal init 0.0 no-undo
       24       get.
       25       set.
       26     define property NormWastDays as decimal init 0.0 no-undo
       27       get.
       28       private set.
       29     define property NormalWastageHdnler as class ibs.th.gbl.storage.normwast no-undo
       30       get.
       31       private set.
       32     constructor public normwastsub (  ):
       33       ParGdsOAttr = new pargdsoattr ().
       34       NormalWastageHdnler =  new normwast ().
       35     end constructor.
       36     method public void FillNormWast ():
       37       def var objNormWastSub as class normwastsub no-undo.
       38       objNormWastSub = this-object.
       39           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-o-normal-wastage-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
       40         (input-output objNormWastSub
       41         ) .
       42       NormalWastageHdnler:RegDocPeriod(objNormWastSub:ParGdsOAttr:FromInvDate, objNormWastSub:ParGdsOAttr:ToInvDate, objNormWastSub:ParGdsOAttr:FromInvFQKg).
       43     end.
       44     method public void CalcWastNorm ():
       45       NormWastS = 0.
       46       NormWastW = 0.
       47       NormalWastageHdnler:CalcWastNorm (this-object).
       48       NormWastDays = NormWastS + NormWastW.
       49     end.
       50   end class.
