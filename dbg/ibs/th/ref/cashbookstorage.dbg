      187     define property Msg as character
      188       get.
      189       private set.
      190     define variable mQuery as handle no-undo.
      191     define variable mQueryRule as handle no-undo.
      192     define variable objKeyRec as ibs.th.gbl.keyrec no-undo.
      193     define variable objCount  as ibs.th.ref.counter.counterstorage no-undo.
      194     constructor public cashbookstorage (  ):
      195       super ().
      196       objKeyRec = new ibs.th.gbl.keyrec().
      197       objCount  = new ibs.th.ref.counter.counterstorage().
      198     end constructor.
      199     destructor public cashbookstorage ( ):
      200        delete object objKeyRec.
      201        delete object objCount.
      202     end destructor.
      203     method private void checkCashBook (buffer tt-cashbook for tt-cashbook) :
      204       Msg = "" .
      205       if trim(tt-cashbook.CashBookName) = ""
      206       then do :
      207         Msg = "Наименование типа кассовой книги не может быть пустым!" .
      208         return .
      209       end.
      210       if trim(tt-cashbook.CorrPko) = ""
      211       then do :
      212         Msg = "Поле Кор. счет ПКО не может быть пустым!" .
      213         return .
      214       end.
      215       if trim(tt-cashbook.OSnAcct) = ""
      216       then do :
      217         Msg = "Поле Основной счет не может быть пустым!" .
      218         return .
      219       end.
      220       if trim(tt-cashbook.RuleOsnPko) = ""
      221       then do :
      222         Msg = 'Правило заполнения графы "Основание" ПКО не может быть пустым!' .
      223         return .
      224       end.
      225       if trim(tt-cashbook.RulePril) = ""
      226       then do :
      227         Msg = "Правило заполнения графы Приложение не может быть пустым!" .
      228         return .
      229       end.
      230       if (trim(tt-cashbook.cli-type) = ""
      231       or tt-cashbook.cli-code = ? or tt-cashbook.cli-code <= 0) and tt-cashbook.id eq 0
      232       then do :
      233         Msg = "Выберите контрагента для автоматического формирования платежей. Поле Контрагент (авто)." .
      234         return .
      235       end.
      236       find first ub.cashbook no-lock where ub.CashBook.CashBookName = tt-cashbook.CashBookName and ub.CashBook.id <> tt-cashbook.id no-error.
      237       if available ub.cashbook
      238       then do :
      239         Msg = "Уже есть тип кассовой книги с наименованием  " + tt-cashbook.CashBookName .
      240         return .
      241       end.
      242       return .
      243     end method .
      244     method private void checkCashBookRule (buffer tt-cashbookrule for tt-cashbookrule) :
      245       Msg = "" .
      246       if trim(tt-cashbookrule.obj) = ""
      247       then do :
      248         Msg = "Выберите объект!" .
      249         return .
      250       end.
      251       if tt-cashbookrule.obj-type <> 'маг':U
      252       then do :
      253         if trim(tt-cashbookrule.ManagerPosition) = ""
      254         then do :
      255           Msg = "Выберите должность руководителя!" .
      256           return .
      257         end.
      258         if trim(tt-cashbookrule.ManagerFIO) = ""
      259         then do :
      260           Msg = "Выберите ФИО руководителя!" .
      261           return .
      262         end.
      263         if trim(tt-cashbookrule.BuhFIO) = ""
      264         then do :
      265           Msg = "Выберите ФИО бухгалтера!" .
      266           return .
      267         end.
      268         if trim(tt-cashbookrule.struct) = ""
      269         then do :
      270           Msg = "Поле <Структурное подразделение> не выбрано!" .
      271           return .
      272         end.
      273         if trim(tt-cashbookrule.uchet) = ""
      274         then do :
      275           Msg = "Поле <учёт ведётся> не выбрано!" .
      276           return .
      277         end.
      278         if trim(tt-cashbookrule.PkoMask) = ""
      279         then do :
      280           Msg = "Маска ПКО не может быть пустой!" .
      281           return .
      282         end.
      283         if trim(tt-cashbookrule.RkoMask) = ""
      284         then do :
      285           Msg = "Маска РКО не может быть пустой!" .
      286           return .
      287         end.
      288       end.
      289       if tt-cashbookrule.obj-type <> 'орг':U
      290       then do :
      291         if tt-cashbookrule.currPko > ""
      292         then do :
      293           int64(tt-cashbookrule.currPko) no-error.
      294           if error-status:error
      295           then do :
      296             Msg = "Текущий номер ПКО должен быть целым числом (без маски)" .
      297             return .
      298           end.
      299         end.
      300         if tt-cashbookrule.currRko > ""
      301         then do :
      302           int64(tt-cashbookrule.currRko) no-error.
      303           if error-status:error
      304           then do :
      305             Msg = "Текущий номер РКО должен быть целым числом (без маски)" .
      306             return .
      307           end.
      308         end.
      309       end.
      310       return.
      311     end method .
      312     method public void insertDB (buffer tt-cashbook for tt-cashbook, output p-id as int64) :
      313         if not tt-cashbook.basic-kb
      314         then
      315            tt-cashbook.id = -1.
      316         checkCashBook(buffer tt-cashbook) .
      317         if Msg <> ""
      318         then return .
      319         create ub.cashbook .
      320         buffer-copy tt-cashbook to ub.CashBook
      321         assign
      322           ub.CashBook.id = if tt-cashbook.basic-kb then 0 else next-value(s-cashbook-id)
      323           ub.CashBook.Status_ = 0
      324           ub.CashBook.RulePril = getRulePrilID(tt-cashbook.RulePril)
      325           ub.CashBook.RuleOsnPko = getRuleOsnID(tt-cashbook.RuleOsnPko)
      326           tt-cashbook.id         = ub.CashBook.id
      327         .
      328         updateAttrForcashbook (buffer tt-cashbook:handle).
      329         p-id = ub.CashBook.id .
      330     end method .
      331     method public void ttCashbooksaturation (input iBuffer as handle):
      332        define variable vField as handle no-undo.
      333        define variable vitm  as integer no-undo.
      334        define buffer buf_file  for _file.
      335        define buffer buf_field for _field.
      336        define buffer CashBookrule for CashBookrule.
      337         find first buf_file where buf_file._file-name eq "cashbook" no-lock.
      338        do vitm = 1 to iBuffer:num-fields:
      339            vField = iBuffer:buffer-field(vItm).
      340            if lookup (vField:name,"stat,mark,basic-kb") eq 0
      341            then do:
      342               find first buf_field where buf_field._file-recid eq recid(buf_file)
      343                                      and buf_field._Field-Name eq vField:name
      344               no-lock no-error.
      345               if not available buf_field
      346               then do:
      347                  find first ub.CashBookrule where ub.CashBookRule.CashBookID eq iBuffer:buffer-field ("id"):buffer-value ()
      348                                               and ub.CashBookRule.Obj-type   eq 'всем':U
      349                                               and ub.CashBookRule.Obj-code   eq 0
      350                                               and ub.CashBookRule.Code       eq vField:name
      351                  no-lock no-error.
      352                  if  available  ub.CashBookrule
      353                  then do:
      354                     vField:buffer-value () =  ub.CashBookRule.RuleValue.
      355                  end.
      356               end.
      357            end.
      358         end.
      359     end.
      360      method public void updateAttrForcashbook (input iBuffer as handle):
      361        define variable vField as handle no-undo.
      362        define variable vitm  as integer no-undo.
      363        define buffer buf_file  for _file.
      364        define buffer buf_field for _field.
      365        define buffer CashBookrule for CashBookrule.
      366         find first buf_file where buf_file._file-name eq "cashbook" no-lock.
      367        do vitm = 1 to iBuffer:num-fields:
      368            vField = iBuffer:buffer-field(vItm).
      369            if lookup (vField:name,"stat,mark,basic-kb") eq 0
      370            then do:
      371               find first buf_field where buf_field._file-recid eq recid(buf_file)
      372                                      and buf_field._Field-Name eq vField:name
      373               no-lock no-error.
      374               if not available buf_field
      375               then do:
      376                  find first ub.CashBookrule where ub.CashBookRule.CashBookID eq iBuffer:buffer-field ("id"):buffer-value ()
      377                                               and ub.CashBookRule.Obj-type   eq 'всем':U
      378                                               and ub.CashBookRule.Obj-code   eq 0
      379                                               and ub.CashBookRule.Code       eq vField:name
      380                  exclusive-lock no-error.
      381                  if not available  ub.CashBookrule
      382                  then do:
      383                     create ub.CashBookRule.
      384                     assign
      385                        ub.CashBookRule.CashBookID = iBuffer:buffer-field ("id"):buffer-value ()
      386                        ub.CashBookRule.Obj-type   = 'всем':U
      387                        ub.CashBookRule.Obj-code   = 0
      388                        ub.CashBookRule.Code       = vField:name
      389                        ub.CashBookRule.Status_    = 0
      390                     .
      391                  end.
      392                  ub.CashBookRule.RuleValue =  vField:buffer-value ().
      393                  release ub.CashBookRule .
      394               end.
      395            end.
      396         end.
      397     end.
      398     method public void updateDB (buffer tt-cashbook for tt-cashbook) :
      399         checkCashBook(buffer tt-cashbook) .
      400         if Msg <> ""
      401         then return .
      402         find first ub.cashbook exclusive-lock where ub.cashbook.id = tt-cashbook.id .
      403         buffer-copy tt-cashbook except tt-cashbook.RulePril tt-cashbook.RuleOsnPko to ub.CashBook .
      404         assign
      405         ub.CashBook.RuleOsnPko = getRuleOsnID(tt-cashbook.RuleOsnPko)
      406         ub.CashBook.RulePril = getRulePrilID(tt-cashbook.RulePril)
      407         .
      408         updateAttrForcashbook(buffer tt-cashbook:handle).
      409     end method .
      410     method private void CrRuleDBobj (buffer tt-cashbookrule for tt-cashbookrule  , icode as character  ) :
      411        find first ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID  = tt-cashbookrule.CashBookID
      412                                                    and ub.CashBookRule.Obj-type    = tt-cashbookrule.obj-type
      413                                                    and ub.CashBookRule.Obj-code    = tt-cashbookrule.obj-code
      414                                                    and ub.CashBookRule.Code        = icode
      415           no-error .
      416        if not available ub.CashBookRule
      417        then do:
      418           create ub.CashBookRule.
      419           assign
      420              ub.CashBookRule.CashBookID  = tt-cashbookrule.CashBookID
      421              ub.CashBookRule.Obj-type    = tt-cashbookrule.obj-type
      422              ub.CashBookRule.Obj-code    = tt-cashbookrule.obj-code
      423              ub.CashBookRule.Code        = icode
      424           .
      425        end.
      426        ub.CashBookRule.host-code   = tt-cashbookrule.host-code.
      427        ub.CashBookRule.Status_     = tt-cashbookrule.Status_ .
      428        ub.CashBookRule.RuleValue = if      icode eq "PkoMask"
      429                                     then tt-cashbookrule.PkoMask
      430                                     else if icode eq "RkoMask"
      431                                     then tt-cashbookrule.RkoMask
      432                                     else if icode eq "currPko"
      433                                     then tt-cashbookrule.currPko
      434                                     else if icode eq "currRko"
      435                                     then tt-cashbookrule.currRko
      436                                     else if icode eq "ManagerPosition"
      437                                     then getMgrPositionID(tt-cashbookrule.ManagerPosition)
      438                                     else if icode eq "ManagerFIO"
      439                                     then getMgrFioID(tt-cashbookrule.ManagerFIO)
      440                                     else if icode eq "BuhFIO"
      441                                     then getBuhFioID(tt-cashbookrule.BuhFIO)
      442                                     else if icode eq "Struct"
      443                                     then getStructID(tt-cashbookrule.Struct)
      444                                     else if icode eq "uchet"
      445                                     then getUchetID(tt-cashbookrule.uchet)
      446                                     else if icode eq "DptName"
      447                                     then tt-cashbookrule.DptName
      448                                     else if icode eq "DptType"
      449                                     then tt-cashbookrule.DptType
      450                                     else if icode eq "DptCode"
      451                                     then string (tt-cashbookrule.DptCode)
      452                                     else if icode eq "Pin"
      453                                     then string (tt-cashbookrule.Pin)
      454                                     else ""
      455                                     .
      456            define variable v-cashbookrule-key-rec as character no-undo.
      457            if icode eq "currPko"  or icode eq "currRko"
      458            then do:
      459               objKeyRec:GenKeyRec ( input 'CashBookRule':U
      460                                                  ,input buffer ub.cashbookrule:handle
      461                                                  ,output v-cashbookrule-key-rec).
      462               find first clients where clients.obj-type eq tt-cashbookrule.obj-type
      463                                and clients.obj-code eq tt-cashbookrule.obj-code
      464                                no-lock no-error.
      465               if     available clients
      466                  and clients.db-num ne ?
      467               then
      468               objcount:SetCountValue(clients.db-num,
      469                                      "cashbookrule",
      470                                      v-cashbookrule-key-rec,
      471                                      icode,
      472                                      int64(ub.cashbookrule.RuleValue)).
      473           end.
      474     end method.
      475     method public void updateDBobj (input dataset for ds-cashbookrule) :
      476       for each tt-cashbookrule :
      477         checkCashBookRule(buffer tt-cashbookrule) .
      478         if Msg <> ""
      479         then return .
      480         CrRuleDBobj(buffer tt-cashbookrule, "PkoMask").
      481         CrRuleDBobj(buffer tt-cashbookrule, "RkoMask").
      482         CrRuleDBobj(buffer tt-cashbookrule, "currPko").
      483         CrRuleDBobj(buffer tt-cashbookrule, "currRko" ).
      484         CrRuleDBobj(buffer tt-cashbookrule, "ManagerPosition").
      485         CrRuleDBobj(buffer tt-cashbookrule, "ManagerFIO").
      486         CrRuleDBobj(buffer tt-cashbookrule, "BuhFIO" ).
      487         CrRuleDBobj(buffer tt-cashbookrule, "Struct").
      488         CrRuleDBobj(buffer tt-cashbookrule, "uchet").
      489         CrRuleDBobj(buffer tt-cashbookrule,"DptName" ).
      490         CrRuleDBobj(buffer tt-cashbookrule,"DptType").
      491         CrRuleDBobj(buffer tt-cashbookrule,"DptCode").
      492         CrRuleDBobj(buffer tt-cashbookrule,"Pin").
      493       end.
      494     end method .
      495     method public void deleteDB (input dataset for ds-cashbook) :
      496       for each tt-cashbook :
      497         find first ub.cashbook exclusive-lock where ub.cashbook.id = tt-cashbook.id .
      498         if ub.CashBook.Status_ = 0
      499         then do :
      500           ub.CashBook.Status_ = 1.
      501           for each ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = ub.cashbook.id :
      502             delete ub.CashBookRule.
      503           end.
      504           for each ub.goods-attr exclusive-lock where ub.goods-attr.attr-code = 'cash-book-id':U
      505                                                 and ub.goods-attr.attr-value = string(ub.cashbook.id):
      506           delete ub.goods-attr .
      507         end.
      508         end.
      509         else
      510         if ub.CashBook.Status_ = 1
      511         then do :
      512           ub.CashBook.Status_ = 0.
      513         end.
      514       end.
      515     end method .
      516     method public void deleteDB (input id as int64) :
      517       find first ub.cashbook exclusive-lock where ub.cashbook.id = id .
      518       if ub.CashBook.Status_ = 0
      519       then do :
      520         ub.CashBook.Status_ = 1.
      521         for each ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = ub.cashbook.id :
      522           delete ub.CashBookRule.
      523         end.
      524         for each ub.goods-attr exclusive-lock where ub.goods-attr.attr-code = 'cash-book-id':U
      525                                                 and ub.goods-attr.attr-value = string(ub.cashbook.id):
      526           delete ub.goods-attr .
      527         end.
      528       end.
      529       else if ub.CashBook.Status_ = 1
      530       then do :
      531         ub.CashBook.Status_ = 0.
      532       end.
      533     end method .
      534     method public void deleteDBobj (input cashbookId as int64, input p-obj-type as character, input p-obj-code as integer) :
      535       for each ub.cashbookrule exclusive-lock where ub.CashBookRule.CashBookID = cashbookId
      536                                                 and ub.CashBookRule.obj-type   = p-obj-type
      537                                                 and ub.CashBookRule.obj-code   = p-obj-code :
      538         delete ub.CashBookRule .
      539       end.
      540     end method .
      541     method public void getcashbook (input pExtCode as character, output dataset ds-cashbook ) :
      542       define buffer buf_cashbook for ub.cashbook .
      543       for each buf_cashbook no-lock where buf_cashbook.ext-code = pExtCode :
      544         create tt-cashbook .
      545         buffer-copy buf_cashbook to tt-cashbook
      546         assign
      547           tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      548           tt-cashbook.basic-kb = tt-cashbook.id eq 0
      549         .
      550         ttCashbooksaturation(buffer tt-cashbook:handle).
      551       end.
      552     end method.
      553     method public void getcashbook (input pCashBookId as int64, output dataset ds-cashbook ) :
      554       define buffer buf_cashbook for ub.cashbook .
      555       find first buf_cashbook no-lock where buf_cashbook.id = pCashBookId no-error .
      556       if available buf_cashbook then do :
      557         create tt-cashbook .
      558         buffer-copy buf_cashbook to tt-cashbook
      559         assign
      560           tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      561           tt-cashbook.basic-kb = tt-cashbook.id eq 0
      562         .
      563         ttCashbooksaturation(buffer tt-cashbook:handle).
      564       end.
      565     end method.
      566     method public handle getquery
      567     ( input v-stat as character,
      568       input v-firm as character,
      569       output oQuery as handle,
      570       output oQueryRule as handle)
      571     :
      572       define buffer buf_cashbook for ub.cashbook .
      573       define buffer buf_cashbookrule for ub.cashbookrule .
      574       if valid-object(mQuery) then delete object mQuery.
      575       if valid-object(mQueryRule) then delete object mQueryRule.
      576       empty temp-table tt-cashbook .
      577       empty temp-table tt-cashbookrule .
      578       case v-firm :
      579         when 'все':U
      580         then do :
      581           case v-stat :
      582             when 'все':U
      583             then do :
      584               for each buf_cashbook no-lock :
      585                 create tt-cashbook .
      586                 buffer-copy buf_cashbook except buf_cashbook.RulePril buf_cashbook.RuleOsnPko to tt-cashbook
      587                 assign
      588                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      589                 .
      590                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      591                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      592                 ttCashbooksaturation(buffer tt-cashbook:handle).
      593                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      594                                                     and  buf_cashbookrule.obj-type ne 'всем':U
      595                                                     break by buf_cashbookrule.obj-type desc
      596                                                           by buf_cashbookrule.obj-code:
      597                   if first-of(buf_cashbookrule.obj-type)
      598                   or first-of(buf_cashbookrule.obj-code)
      599                   then do :
      600                     create tt-cashbookrule.
      601                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      602                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      603                   end.
      604                   fill_cashbookrule (buffer buf_cashbookrule) .
      605                 end.
      606               end.
      607             end.
      608             when 'тек':U
      609             then do :
      610               for each buf_cashbook no-lock where buf_cashbook.status_ = 0:
      611                 create tt-cashbook .
      612                 buffer-copy buf_cashbook except buf_cashbook.RulePril buf_cashbook.RuleOsnPko to tt-cashbook
      613                 assign
      614                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      615                 .
      616                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      617                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      618                 ttCashbooksaturation(buffer tt-cashbook:handle).
      619                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      620                                                     and buf_cashbookrule.status_ = 0
      621                                                     and buf_cashbookrule.obj-type ne 'всем':U
      622                                                     break by buf_cashbookrule.obj-type desc
      623                                                           by buf_cashbookrule.obj-code:
      624                   if first-of(buf_cashbookrule.obj-type)
      625                   or first-of(buf_cashbookrule.obj-code)
      626                   then do :
      627                     create tt-cashbookrule.
      628                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      629                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      630                   end.
      631                   fill_cashbookrule (buffer buf_cashbookrule) .
      632                 end.
      633               end.
      634             end.
      635             when 'удал':U
      636             then do :
      637               for each buf_cashbook no-lock where buf_cashbook.status_ = 1:
      638                 create tt-cashbook .
      639                 buffer-copy buf_cashbook except buf_cashbook.RulePril buf_cashbook.RuleOsnPko to tt-cashbook
      640                 assign
      641                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      642                 .
      643                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      644                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      645                 ttCashbooksaturation(buffer tt-cashbook:handle).
      646                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      647                                                     and buf_cashbookrule.status_ = 1
      648                                                     and  buf_cashbookrule.obj-type ne 'всем':U
      649                                                     break by buf_cashbookrule.obj-type desc
      650                                                           by buf_cashbookrule.obj-code:
      651                   if first-of(buf_cashbookrule.obj-type)
      652                   or first-of(buf_cashbookrule.obj-code)
      653                   then do :
      654                     create tt-cashbookrule.
      655                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      656                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      657                   end.
      658                   fill_cashbookrule (buffer buf_cashbookrule) .
      659                 end.
      660               end.
      661             end.
      662           end case .
      663         end.
      664         otherwise
      665         do :
      666           case v-stat :
      667             when 'все':U
      668             then do :
      669               for each buf_cashbook no-lock :
      670                 create tt-cashbook .
      671                 buffer-copy buf_cashbook to tt-cashbook
      672                 assign
      673                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      674                 .
      675                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      676                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      677                 ttCashbooksaturation(buffer tt-cashbook:handle).
      678                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      679                                                     and buf_cashbookrule.host-code = v-firm
      680                                                     and buf_cashbookrule.obj-type ne 'всем':U
      681                                                     break by buf_cashbookrule.obj-type desc
      682                                                           by buf_cashbookrule.obj-code:
      683                   if first-of(buf_cashbookrule.obj-type)
      684                   or first-of(buf_cashbookrule.obj-code)
      685                   then do :
      686                     create tt-cashbookrule.
      687                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      688                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      689                     tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      690                     tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      691                   end.
      692                   fill_cashbookrule (buffer buf_cashbookrule) .
      693                 end.
      694               end.
      695             end.
      696             when 'тек':U
      697             then do :
      698               for each buf_cashbook no-lock where buf_cashbook.status_ = 0:
      699                 create tt-cashbook .
      700                 buffer-copy buf_cashbook to tt-cashbook
      701                 assign
      702                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      703                 .
      704                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      705                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      706                 ttCashbooksaturation(buffer tt-cashbook:handle).
      707                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      708                                                     and buf_cashbookrule.host-code = v-firm
      709                                                     and buf_cashbookrule.status_ = 0
      710                                                     and  buf_cashbookrule.obj-type ne 'всем':U
      711                                                     break by buf_cashbookrule.obj-type desc
      712                                                           by buf_cashbookrule.obj-code:
      713                   if first-of(buf_cashbookrule.obj-type)
      714                   or first-of(buf_cashbookrule.obj-code)
      715                   then do :
      716                     create tt-cashbookrule.
      717                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      718                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      719                   end.
      720                   fill_cashbookrule (buffer buf_cashbookrule) .
      721                 end.
      722               end.
      723             end.
      724             when 'удал':U
      725             then do :
      726               for each buf_cashbook no-lock where buf_cashbook.status_ = 1:
      727                 create tt-cashbook .
      728                 buffer-copy buf_cashbook to tt-cashbook
      729                 assign
      730                   tt-cashbook.stat = if tt-cashbook.status_ = 0 then "Текущий" else if tt-cashbook.status_ = 1 then "Удаленный" else "?"
      731                 .
      732                 tt-cashbook.RulePril = getRulePrilName(integer(buf_cashbook.RulePril)) .
      733                 tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      734                 ttCashbooksaturation(buffer tt-cashbook:handle).
      735                 for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = buf_cashbook.id
      736                                                     and buf_cashbookrule.host-code = v-firm
      737                                                     and buf_cashbookrule.status_ = 1
      738                                                     and buf_cashbookrule.obj-type ne 'всем':U
      739                                                     break by buf_cashbookrule.obj-type desc
      740                                                           by buf_cashbookrule.obj-code:
      741                   if first-of(buf_cashbookrule.obj-type)
      742                   or first-of(buf_cashbookrule.obj-code)
      743                   then do :
      744                     create tt-cashbookrule.
      745                     buffer-copy buf_cashbookrule to tt-cashbookrule .
      746                     tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      747                   end.
      748                   fill_cashbookrule (buffer buf_cashbookrule) .
      749                 end.
      750               end.
      751             end.
      752           end case .
      753         end.
      754       end case.
      755       if not valid-object(mQuery)
      756       then do:
      757          create query mQuery.
      758          mQuery:set-buffers(buffer tt-cashbook:HANDLE).
      759          mQuery:query-prepare("FOR EACH tt-cashbook").
      760       end.
      761       mQuery:query-open ().
      762       oQuery = mQuery.
      763       if not valid-object(mQueryRule)
      764       then do:
      765          create query mQueryRule.
      766          mQueryRule:set-buffers(buffer tt-cashbookrule:HANDLE).
      767          mQueryRule:query-prepare("FOR EACH tt-cashbookrule").
      768       end.
      769       mQueryRule:query-open ().
      770       oQueryRule = mQueryRule.
      771       return oQuery.
      772     end method.
      773     method public void getCashBookRule (input pCashBookId as int64, input pObjType as character, input pObjCode as integer, output dataset ds-cashbookrule) :
      774       define buffer buf_cashbookrule for ub.cashbookrule .
      775       for each buf_cashbookrule no-lock where buf_cashbookrule.cashbookId = pCashBookId
      776                                           and buf_cashbookrule.obj-code = pObjCode
      777                                           and buf_cashbookrule.obj-type = pObjType
      778                                           break by buf_cashbookrule.obj-type
      779                                                 by buf_cashbookrule.obj-code:
      780         if first-of(buf_cashbookrule.obj-type)
      781         or first-of(buf_cashbookrule.obj-code)
      782         then do :
      783           create tt-cashbookrule.
      784           buffer-copy buf_cashbookrule to tt-cashbookrule .
      785           tt-cashbookrule.obj = tt-cashbookrule.obj-type + string(tt-cashbookrule.obj-code) .
      786         end.
      787         fill_cashbookrule (buffer buf_cashbookrule) .
      788       end.
      789     end method.
      790     method public character getSinglRule (input pCashBookId as int64, input pObjType as character, input pObjCode as integer, input pRuleCode as character ) :
      791       find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = pCashBookId
      792                                            and ub.CashBookRule.Obj-type   = pObjType
      793                                            and ub.CashBookRule.Obj-code   = pObjCode
      794                                            and ub.CashBookRule.Code       = pRuleCode
      795                                            no-error.
      796       if not available ub.CashBookRule
      797       then do :
      798         find first ub.clients no-lock where ub.clients.obj-type = pObjType
      799                                         and ub.clients.obj-code = pObjCode
      800                                         no-error.
      801         if not available ub.clients
      802         then do :
      803           return ? .
      804         end.
      805         find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = pCashBookId
      806                                              and ub.CashBookRule.Obj-type   = 'орг':U
      807                                              and ub.CashBookRule.Obj-code   = ub.clients.host-code
      808                                              and ub.CashBookRule.Code       = pRuleCode
      809                                              no-error.
      810         if not available ub.CashBookRule
      811         then do :
      812            find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = pCashBookId
      813                                                 and ub.CashBookRule.Obj-type   = 'всем':U
      814                                                 and ub.CashBookRule.Obj-code   = 0
      815                                                 and ub.CashBookRule.Code       = pRuleCode
      816                                                 no-error.
      817            if not available ub.CashBookRule
      818            then do :
      819               return ? .
      820            end.
      821         end.
      822       end.
      823       return ub.CashBookRule.RuleValue .
      824     end.
      825     method private void fill_cashbookrule (buffer buf_cashbookrule for ub.cashbookrule) :
      826       define variable v-cashbookrule-key-rec as character no-undo.
      827       case buf_cashbookrule.code :
      828         when "PkoMask"
      829         then do :
      830           tt-cashbookrule.PkoMask = buf_cashbookrule.RuleValue .
      831         end.
      832         when "RkoMask"
      833         then do :
      834           tt-cashbookrule.RkoMask = buf_cashbookrule.RuleValue .
      835         end.
      836         when "currPko"
      837         then do :
      838           objKeyRec:GenKeyRec ( input 'CashBookRule':U
      839                                               ,input buffer buf_cashbookrule:handle
      840                                               ,output v-cashbookrule-key-rec).
      841           find first clients where clients.obj-type eq tt-cashbookrule.obj-type
      842                                and clients.obj-code eq tt-cashbookrule.obj-code
      843                                no-lock no-error.
      844               if     available clients
      845                  and clients.db-num ne ?
      846               then
      847           tt-cashbookrule.currPko = string(
      848                                            objcount:getCountValue(clients.db-num,
      849                                                                   "cashbookrule",
      850                                                                   v-cashbookrule-key-rec,
      851                                                                   "currPKO")
      852                                            ).
      853         end.
      854         when "currRko"
      855         then do :
      856            objKeyRec:GenKeyRec ( input 'CashBookRule':U
      857                                               ,input buffer buf_cashbookrule:handle
      858                                               ,output v-cashbookrule-key-rec).
      859            find first clients where clients.obj-type eq tt-cashbookrule.obj-type
      860                                and clients.obj-code eq tt-cashbookrule.obj-code
      861                                no-lock no-error.
      862               if     available clients
      863                  and clients.db-num ne ?
      864               then
      865            tt-cashbookrule.currRko = string(objcount:getCountValue(clients.db-num,
      866                                                                    "cashbookrule",
      867                                                                    v-cashbookrule-key-rec,
      868                                                                    "currRko")) .
      869         end.
      870         when "ManagerPosition"
      871         then do :
      872           tt-cashbookrule.ManagerPosition = getMgrPositionName(buf_cashbookrule.RuleValue) .
      873         end.
      874         when "ManagerFIO"
      875         then do :
      876           tt-cashbookrule.ManagerFIO = getMgrFioName(buf_cashbookrule.RuleValue) .
      877         end.
      878         when "BuhFIO"
      879         then do :
      880           tt-cashbookrule.BuhFIO = getBuhFioName(buf_cashbookrule.RuleValue) .
      881         end.
      882         when "Struct"
      883         then do :
      884           tt-cashbookrule.Struct = getStructName(integer(buf_cashbookrule.RuleValue)) .
      885         end.
      886         when "uchet"
      887         then do :
      888           tt-cashbookrule.uchet = getUchetName(integer(buf_cashbookrule.RuleValue)) .
      889         end.
      890         when "DptName"
      891         then do :
      892           tt-cashbookrule.DptName = buf_cashbookrule.RuleValue .
      893         end.
      894         when "DptType"
      895         then do :
      896           tt-cashbookrule.DptType = buf_cashbookrule.RuleValue .
      897         end.
      898         when "DptCode"
      899         then do :
      900           tt-cashbookrule.DptCode = integer(buf_cashbookrule.RuleValue) no-error .
      901         end.
      902         when "Pin"
      903         then do :
      904           tt-cashbookrule.Pin = buf_cashbookrule.RuleValue .
      905         end.
      906       end case.
      907     end method.
      908   end class.
