       38   define dataset ds-cashbook for tt-cashbook .
       39   method private character getRuleOsnName (input p-rule-reason as character) :
       40       define variable v-name as character no-undo .
       41       case p-rule-reason :
       42         when "0" then v-name = "Выручка от реализации" .
       43         when "1" then v-name = "Номера Z-отчетов" .
       44         when "2" then v-name = "Не заполнять" .
       45           otherwise v-name = p-rule-reason .
       46       end case .
       47       return v-name .
       48     end method .
       49     method private character getRuleOsnID (input p-rule-reason as character) :
       50       define variable v-id as character no-undo .
       51       case p-rule-reason :
       52         when "Выручка от реализации" then v-id = "0" .
       53         when "Номера Z-отчетов" then v-id = "1" .
       54         when "Не заполнять" then v-id = "2" .
       55           otherwise v-id = p-rule-reason .
       56       end case .
       57       return v-id .
       58     end method .
       59     method private character getRulePrilName (input p-rule-att as integer) :
       60       define variable v-name as character no-undo .
       61       case p-rule-att :
       62         when 1 then v-name = "Не заполнять" .
       63           otherwise v-name = "Номера Z-отчетов" .
       64       end case .
       65       return v-name .
       66     end method .
       67       method private character getRulePrilID (input p-rule-att as character) :
       68       define variable v-id as character no-undo .
       69       case p-rule-att :
       70         when "Не заполнять" then v-id = "1" .
       71           otherwise v-id = "0" .
       72       end case .
       73       return v-id .
       74     end method .
