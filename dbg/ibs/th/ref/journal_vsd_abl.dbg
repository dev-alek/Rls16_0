      309           METHOD PRIVATE VOID button1_Click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      310               vjournalvsdTrg:CreateTT(INPUT DATASET ds-vsd-set, OUTPUT TABLE ttvsd).
      311               hbingvsd:QUERY-OPEN ().
      312               bingvsd:RefreshAll().
      313               IF AVAILABLE ttvsd THEN DO:
      314               vjournalvsdTrg:VSD_lock(ttvsd.id, ttvsd.db-num, ttvsd.vsdsubs).
      315               END.
      316               ELSE
      317               MESSAGE "Не выбран объект для отображения."
      318           VIEW-AS ALERT-BOX.
      319               RETURN.
      320           END METHOD.
