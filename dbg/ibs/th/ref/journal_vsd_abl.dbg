       82      //111  { gbl/prn-lib.i   }
       83       DEFINE TEMP-TABLE t-obj-list NO-UNDO
       84       FIELD obj-type  AS CHARACTER
       85       FIELD obj-code  AS INTEGER
       86       FIELD host-code AS INTEGER
       87       INDEX pi IS UNIQUE PRIMARY obj-type  obj-code
       88       INDEX firm                 host-code.
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  temp-table tt-gds-list no-undo like ub.goods
       91     field qnty   as decimal
       92     field to-del as logical
       93     field order-num as integer
       94     field to-sel as logical
       95     field promo-code as character
       96     field ActionId  as int64
       97     field db-num as integer
       98     index art  is primary unique artic prod-type prod-code
       99     index code is         unique gds-code
      100     index oi order-num
      101     index isel to-sel
      102     .
      103   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   define    temp-table tt-gds-list-hist no-undo
      105   field list-table as character
      106   field id as integer
      107   field line as integer
      108   field hist-mode as character
      109   field des as character
      110   field num-recs as integer
      111   field option_ as character
      112   field item_ as character
      113   field status_ as character
      114   field num-add as integer
      115   field num-ignored as integer
      116   field done as logical
      117   field err_ as logical
      118   field err-mes as character
      119   index pi is primary
      120   id
      121   line
      122   index isdone
      123   done
      124   .
      125   DEFINE TEMP-TABLE tt-vsd-filt NO-UNDO
      126   FIELD date-end AS DATE
      127   FIELD date-start AS DATE
      128   FIELD fTime  AS INTEGER
      129   FIELD FalExting AS LOGICAL
      130   FIELD FalVerif  AS LOGICAL
      131   FIELD Rep       AS LOGICAL
      132   FIELD ReqVerif  AS LOGICAL
      133   FIELD ToExtin   AS LOGICAL
      134   FIELD Sent      AS LOGICAL
      135   FIELD doc-code  AS CHARACTER
      136   .
      137   DEFINE DATASET ds-vsd-set
      138   FOR tt-vsd-filt, t-obj-list,  tt-gds-list .
      139   DEFINE TEMP-TABLE ttvsd NO-UNDO LIKE ub.vsd
      140           FIELD dateTTH     AS DATE
      141           FIELD NomTTH      AS CHAR
      142           FIELD NomTTHpost  AS CHAR
      143           FIELD NomAZS      AS CHAR
      144           FIELD Post        AS CHAR
      145           FIELD artic       AS CHAR
      146           FIELD gdsname     AS CHAR
      147           FIELD prod-code   AS CHAR
      148           FIELD COLobj      AS DEC
      149           FIELD unit-cli    AS CHAR
      150           FIELD unit-base   AS CHAR
      151           FIELD statusvsd   AS CHAR
      152           FIELD ojd         AS DEC
      153           FIELD gdsmercguid AS CHAR
      154           FIELD vsdtypelbl  AS CHAR
      155           FIELD vsdsubs     AS CLASS Progress.Lang.Object.
      156       DEFINE DATASET dsVSd FOR ttVSd.
      157       DEFINE VARIABLE v-object-available    AS LOGICAL   NO-UNDO .
      158       DEFINE VARIABLE vjournalvsdTrg AS CLASS journal_vsd_trg.
      159       CONSTRUCTOR PUBLIC journal_vsd_abl ( INPUT p-paparparentproc AS HANDLE  ):
      160           SUPER().
      161           InitializeComponent().
      162           THIS-OBJECT:ComponentsCollection:ADD(THIS-OBJECT:components).
      163           vjournalvsdTrg = NEW ibs.th.ref.journal_vsd_trg (p-paparparentproc).
      164           parparentproc = p-paparparentproc.
      165   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166     run mainmenu_getcntxt in parparentproc
      167       (output v-cntxt-db-num
      168       ,output v-cntxt-userid
      169       ,output v-cntxt-level
      170       ,output v-cntxt-host-code-obj
      171       ,output v-cntxt-obj-type
      172       ,output v-cntxt-obj-code
      173       ,output v-cntxt-db-num-obj
      174       ,output v-cntxt-is-admin
      175       ) .
      176           CREATE tt-vsd-filt.
      177           ASSIGN
      178               tt-vsd-filt.date-end   = TODAY
      179               tt-vsd-filt.date-start = TODAY
      180               tt-vsd-filt.FalExting  = YES
      181               tt-vsd-filt.FalVerif   = YES
      182               tt-vsd-filt.Rep        = YES
      183               tt-vsd-filt.ReqVerif   = YES
      184               tt-vsd-filt.ToExtin    = YES
      185               tt-vsd-filt.Sent    = YES
      186               tt-vsd-filt.fTime      = 0
      187               .
      188           FOR EACH db NO-LOCK
      189               ON ERROR UNDO, RETURN NO-APPLY
      190               :
      191               FOR EACH clients NO-LOCK
      192                   WHERE clients.db-num = db.db-num
      193                   ON ERROR UNDO, RETURN NO-APPLY
      194                   :
      195   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   run usobjava in ibs.th.gbl.gbl-hndllib:g#library2
      197     (input  v-cntxt-db-num
      198     ,input  0
      199     ,input  v-cntxt-userid
      200     ,input  clients.obj-type
      201     ,input  clients.obj-code
      202     ,output v-object-available
      203     ) no-error .
      204                   IF ERROR-STATUS :ERROR
      205                       THEN
      206                   DO:
      207                       MESSAGE
      208                           vss-workfile vss-revision vss-description SKIP
      209                           "Ошибка при вызове процедуры gbl/usobjava.i" SKIP
      210                           ERROR-STATUS :GET-MESSAGE(1) SKIP
      211                           RETURN-VALUE SKIP
      212                           VIEW-AS ALERT-BOX ERROR .
      213                       UNDO, RETURN NO-APPLY .
      214                   END.
      215                   IF v-object-available = TRUE
      216                       THEN
      217                   DO:
      218                       CREATE t-obj-list .
      219                       ASSIGN
      220                           t-obj-list.obj-type = clients.obj-type
      221                           t-obj-list.obj-code = clients.obj-code
      222                           .
      223                   END.
      224               END.
      225           END.
      226           vjournalvsdTrg:CreateTT(INPUT DATASET ds-vsd-set, OUTPUT TABLE ttvsd).
      227           hDSVSd = DATASET dsVSd:HANDLE.
      228           bingvsd:HANDLE =  hDSvsd:TOP-NAV-QUERY.
      229           hbingvsd = bingvsd:HANDLE.
      230           hDSFILt = DATASET ds-vsd-set:HANDLE.
      231           bindttfilt:HANDLE = hDSFILt:TOP-NAV-QUERY.
      232           CATCH e AS Progress.Lang.Error:
      233               UNDO, THROW e.
      234           END CATCH.
      235       END CONSTRUCTOR.
