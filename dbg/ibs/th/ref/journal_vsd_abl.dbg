      930   method void proc-alt-shift-f2 ():
      931     if not ibs.th.gbl.gbl-var:rcode
      932   then
      933     run gbl\inidebug.p .
      934   end.
      935   method void proc-alt-shift-f3 ():
      936      define variable vdebugalert   as logical no-undo .
      937      assign
      938         vdebugalert = session:debug-alert
      939         session:debug-alert = yes
      940      .
      941   message program-name( 1 ) skip( 1 )
      942             vss-revision                  skip( 0 )
      943             vss-author                    skip( 0 )
      944             vss-date                      skip( 0 )
      945             vss-workfile                  skip( 0 )
      946             vss-archive                   skip( 1 )
      947             vss-description               skip( 1 )
      948     view-as alert-box title "Текущая программа".
      949     session:debug-alert = vdebugalert.
      950   end.
      951   define variable v-inform-launched as logical no-undo initial false .
      952   method void proc-alt-shift-f4 ():
      953   end.
      954   method void proc-alt-f1 ():
      955   end .
      956   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      957         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      958         then do:
      959             proc-alt-shift-f3 ().
      960         end.
      961         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      962         then do:
      963             proc-alt-shift-f2 ().
      964         end.
      965   end method.
      966   method private void End_obj_KeyDown():
      967   catch e as Progress.Lang.Error:
      968            undo, throw e.
      969         end catch.
      970   end method.
      971   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      972      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      973      define variable v-curr-sv-date as date no-undo .
      974      define variable v-new-sv-date  as date no-undo .
      975      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      976      then do:
      977         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      978         run gbl/getcurdt.p
      979            (output v-curr-sv-date
      980         ) .
      981         vdate:value = v-curr-sv-date.
      982      end.
      983      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      984      then do:
      985         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      986         v-curr-sv-date = vdate:value .
      987         if v-curr-sv-date = ?
      988         then do:
      989            run gbl/getcurdt.p
      990               (output v-curr-sv-date
      991            ) .
      992         end.
      993         if v-curr-sv-date <> ?
      994         then do:
      995            assign
      996               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      997               vdate:value = v-new-sv-date
      998            .
      999         end.
     1000      end.
     1001      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
     1002      then do:
     1003         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
     1004         v-curr-sv-date = vdate:value.
     1005         if v-curr-sv-date = ?
     1006         then do:
     1007            run gbl/getcurdt.p
     1008               (output v-curr-sv-date
     1009            ) .
     1010         end.
     1011         if v-curr-sv-date <> ?
     1012         then do:
     1013            run gbl/lastdate.p
     1014               (input  v-curr-sv-date
     1015               ,output v-new-sv-date
     1016            ).
     1017            vdate:value = v-new-sv-date.
     1018         end.
     1019      end.
     1020      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
     1021      then do:
     1022         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
     1023         define variable v-description   as character no-undo .
     1024         define variable v-ok            as logical no-undo.
     1025         v-curr-sv-date = vdate:value.
     1026         if v-curr-sv-date = ?
     1027         then do:
     1028            run gbl/getcurdt.p
     1029               (output v-curr-sv-date
     1030            ) .
     1031         end.
     1032         if v-curr-sv-date <> ?
     1033         then do:
     1034            run gbl/d-inpday.w
     1035               (input ?
     1036               ,input "Выбор даты"
     1037               ,input v-description
     1038               ,input ""
     1039               ,input-output v-curr-sv-date
     1040               ,output v-ok
     1041            ).
     1042            if v-ok = true
     1043            then do:
     1044               vdate:value = v-curr-sv-date .
     1045            end.
     1046         end.
     1047      end.
     1048   end method.
     1049   method private void End_date_KeyDown():
     1050         catch e as Progress.Lang.Error:
     1051            undo, throw e.
     1052         end catch.
     1053       END METHOD.
