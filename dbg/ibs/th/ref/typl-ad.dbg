        1   using Progress.Lang.*.
        2   using ibs.th.gbl.gbl-var.
        3   block-level on error undo, throw.
        4   class ibs.th.ref.typl-ad:
        5     define property ReturnMsg as character no-undo
        6       get.
        7       private set.
        8   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
        9   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
       10   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
       11   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
       12     define variable hndl-proc-key-rec as handle.
       13     constructor public typl-ad ():
       14       run ref/typl-ad.p persistent set hndl-proc-key-rec .
       15     end constructor.
       16     destructor public typl-ad ():
       17       if valid-object(hndl-proc-key-rec) then delete object hndl-proc-key-rec .
       18     end destructor.
       19     method public recid objo-add (
       20       input p-db-num     as integer,
       21       input p-id         as integer,
       22       input p-obj-type   as character,
       23       input p-obj-code   as integer,
       24       input p-stts       as integer,
       25       input p-db-num-usr as integer,
       26       input p-userid     as character
       27     ) :
       28       define variable v-recid as recid no-undo .
       29       run objo-add in hndl-proc-key-rec
       30         (input p-db-num
       31         ,input p-id
       32         ,input p-obj-type
       33         ,input p-obj-code
       34         ,input p-stts
       35         ,input p-db-num-usr
       36         ,input p-userid
       37        ,output v-recid
       38         ) .
       39       return v-recid .
       40     end method.
       41     method public void type-price-list-ADD (
       42       input p-plt-id as integer,
       43       input p-db-num as integer,
       44       input p-name       as character,
       45       input p-ban-discnt as integer,
       46       input p-calc-round-method   as character,
       47       input p-calc-round-base     as decimal,
       48       input p-calc-increase-p     as decimal,
       49       input p-calc-method         as character,
       50       input p-create-price-doc    as integer,
       51       input p-fix-cource-crc-base as logical,
       52       input p-fix-cource-crc-doc  as logical,
       53       input p-main            as logical,
       54       input p-plt-main-id     as integer,
       55       input p-plt-main-db-num as integer,
       56       input p-priority        as integer,
       57       input p-only-gbd        as integer,
       58       input p-under-type-list    as integer,
       59       input p-under-round-method as character,
       60       input p-under-perc         as decimal,
       61       input p-under-hand-corr    as integer,
       62       input p-send-cassa         as integer,
       63       input p-use-cassa          as integer,
       64       input p-use-gds-group      as integer,
       65       input p-work-date          as integer,
       66       input p-curr-code          as integer,
       67       input p-use-cash-pay       as integer,
       68       input p-use-pay-type       as integer,
       69       input p-have-rs-qnty-group  as integer,
       70       input p-qgr-db-num          as integer,
       71       input p-qgr-id              as integer,
       72       input p-have-rs-sum-group   as logical,
       73       input p-sgr-db-num          as integer,
       74       input p-sgr-id              as integer,
       75       input p-rs-buyer            as integer,
       76       input p-bgr-db-num          as integer,
       77       input p-bgr-id              as integer,
       78       input p-obj-turnover        as logical,
       79       input p-tog-db-num          as integer,
       80       input p-tog-id              as integer,
       81       input p-ttg-summa           as decimal,
       82       input p-have-rs-turn-group  as integer,
       83       input p-have-tog-db-num     as integer,
       84       input p-have-tog-id         as integer,
       85       input p-gop-db-num          as integer,
       86       input p-gop-id              as integer,
       87       input p-use-obj             as integer,
       88       input p-gop-db-num-for-calc-turnover as integer,
       89       input p-gop-id-for-calc-turnover     as integer,
       90       input p-userid          as character,
       91       input p-db-num-usr      as integer,
       92      output p-recid  as recid,
       93       input table TT_cassa,
       94       input table TT_grp,
       95       input table TT_pay-type,
       96       input table TT_cash-pay
       97     ):
       98     if p-gop-id = 0 then do:
       99       define variable v-recid as recid no-undo .
      100       assign
      101         p-gop-id = next-value ( s-gop , ub )
      102       .
      103         create ub.grp-obj-price.
      104         assign
      105         ub.grp-obj-price.gop-db-num   = p-gop-db-num
      106         ub.grp-obj-price.gop-id       = p-gop-id
      107         ub.grp-obj-price.name-group   = substitute("По объекту &1&2", 'маг':U, p-db-num)
      108         ub.grp-obj-price.stts         = 0
      109         ub.grp-obj-price.who          = gbl-var:g#userid
      110         ub.grp-obj-price.db-num-chg   = gbl-var:g#db-num
      111         ub.grp-obj-price.sys-date     = today
      112         ub.grp-obj-price.sys-time     = time
      113         ub.grp-obj-price.sys-time-chr = string(ub.grp-obj-price.sys-time,"hh:mm")
      114         .
      115         v-recid = objo-add (input p-gop-db-num
      116                            ,input p-gop-id
      117                            ,input 'маг':U
      118                            ,input p-db-num
      119                            ,input 0
      120                            ,input gbl-var:g#db-num
      121                            ,input gbl-var:g#userid
      122                            ) .
      123     end.
      124       run type-price-list-ADD in hndl-proc-key-rec
      125         (input p-db-num
      126         ,input p-plt-id
      127         ,input p-name
      128         ,input p-ban-discnt
      129         ,input p-calc-round-method
      130         ,input p-calc-round-base
      131         ,input p-calc-increase-p
      132         ,input p-calc-method
      133         ,input p-create-price-doc
      134         ,input p-fix-cource-crc-base
      135         ,input p-fix-cource-crc-doc
      136         ,input p-have-rs-qnty-group
      137         ,input p-have-rs-sum-group
      138         ,input p-main
      139         ,input p-only-gbd
      140         ,input p-plt-main-db-num
      141         ,input p-plt-main-id
      142         ,input p-priority
      143         ,input p-rs-buyer
      144         ,input p-send-cassa
      145         ,input p-under-hand-corr
      146         ,input p-under-round-method
      147         ,input p-under-perc
      148         ,input p-under-type-list
      149         ,input p-use-cassa
      150         ,input p-use-gds-group
      151         ,input p-use-obj
      152         ,input p-work-date
      153         ,input p-bgr-db-num
      154         ,input p-bgr-id
      155         ,input p-curr-code
      156         ,input p-gop-db-num
      157         ,input p-gop-db-num-for-calc-turnover
      158         ,input p-gop-id
      159         ,input p-gop-id-for-calc-turnover
      160         ,input p-qgr-db-num
      161         ,input p-qgr-id
      162         ,input p-sgr-db-num
      163         ,input p-sgr-id
      164         ,input p-tog-db-num
      165         ,input p-tog-id
      166         ,input p-obj-turnover
      167         ,input p-ttg-summa
      168         ,input p-userid
      169         ,input p-db-num-usr
      170         ,input p-have-rs-turn-group
      171         ,input p-have-tog-db-num
      172         ,input p-have-tog-id
      173         ,input p-use-cash-pay
      174         ,input p-use-pay-type
      175        ,output p-recid
      176        , input table TT_cassa
      177        , input table TT_grp
      178        , input table TT_pay-type
      179        , input table TT_cash-pay
      180         ) .
      181     end method.
      182     method public void type-price-list-delete (
      183       input p-db-num     as integer,
      184       input p-id         as integer,
      185       input p-db-num-usr as integer,
      186       input p-userid     as character,
      187       buffer child_price-list-type for ub.price-list-type
      188     ) :
      189       run type-price-list-delete in hndl-proc-key-rec
      190         (input p-db-num
      191         ,input p-id
      192         ,input p-db-num-usr
      193         ,input p-userid
      194         ,buffer child_price-list-type
      195         ).
      196     end method.
      197   end class.
