     1576     @VisualDesigner.
     1577     method private void Enable_Form():
     1578       case tt-OperServ.CalcType:
     1579         when 1 then
     1580           do:
     1581             OsTypeRas = "Оплата Сотовой связи" .
     1582           end.
     1583         when 2 then
     1584           do:
     1585             OsTypeRas = "Оплата по договору" .
     1586           end.
     1587         when 3 then
     1588           do:
     1589             OsTypeRas = "Оплата Счёта" .
     1590           end.
     1591         when 4 then
     1592           do:
     1593             OsTypeRas = "Начисление на карту" .
     1594           end.
     1595         when 5 then
     1596           do:
     1597             OsTypeRas = "Платежный агент" .
     1598           end.
     1599       end case .
     1600       case tt-OperServ.OsType:
     1601         when 0 then
     1602           do:
     1603             p-OsType = "" .
     1604           end.
     1605         when 1 then
     1606           do:
     1607             p-OsType = "ОСС (OpenWay)" .
     1608           end.
     1609         when 2 then
     1610           do:
     1611             p-OsType = "Автопомощь" .
     1612           end.
     1613         when 3 then
     1614           do:
     1615             p-OsType = "Пополнение ВБРР" .
     1616           end.
     1617         when 5 then
     1618           do:
     1619             p-OsType = "Выдача наличных" .
     1620           end.
     1621       end case .
     1622       if tt-OperServ.CommType = 5 then
     1623       do:
     1624         CommType = "Процент".
     1625       end.
     1626       else
     1627       do:
     1628         CommType = "Сумма" .
     1629       end.
     1630       if tt-OperServ.CommType = 5 then Commis_val = tt-OperServ.CommPerc .
     1631       else Commis_val = tt-OperServ.CommSumm .
     1632       case tt-OperServ.AgentFlagRas:
     1633         when 1 then
     1634           do:
     1635             p-AgentFlagRasch = "Банковский платежный агент".
     1636           end.
     1637         when 2 then
     1638           do:
     1639             p-AgentFlagRasch = "Банковский платежный субагент".
     1640           end.
     1641         when 4 then
     1642           do:
     1643             p-AgentFlagRasch = "Платежный агент".
     1644           end.
     1645         when 8 then
     1646           do:
     1647             p-AgentFlagRasch = "Платежный субагент".
     1648           end.
     1649         when 16 then
     1650           do:
     1651             p-AgentFlagRasch = "Поверенный пользователь".
     1652           end.
     1653         when 32 then
     1654           do:
     1655             p-AgentFlagRasch = "Комиссионер".
     1656           end.
     1657         when 64 then
     1658           do:
     1659             p-AgentFlagRasch = "Агент, не явл. никем из перечисленных".
     1660           end.
     1661       end case.
     1662       case tt-OperServ.AgentFlag:
     1663         when 1 then
     1664           do:
     1665             p-AgentFlag = "Банковский платежный агент".
     1666           end.
     1667         when 2 then
     1668           do:
     1669             p-AgentFlag = "Банковский платежный субагент".
     1670           end.
     1671         when 4 then
     1672           do:
     1673             p-AgentFlag = "Платежный агент".
     1674           end.
     1675         when 8 then
     1676           do:
     1677             p-AgentFlag = "Платежный субагент".
     1678           end.
     1679         when 16 then
     1680           do:
     1681             p-AgentFlag = "Поверенный пользователь".
     1682           end.
     1683         when 32 then
     1684           do:
     1685             p-AgentFlag = "Комиссионер".
     1686           end.
     1687         when 64 then
     1688           do:
     1689             p-AgentFlag = "Агент, не явл. никем из перечисленных".
     1690           end.
     1691       end case.
     1692       return.
     1693     end method.
