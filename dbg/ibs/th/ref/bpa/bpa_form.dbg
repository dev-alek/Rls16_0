      109     constructor public BPA_form (iChange as character, p-id as integer ):
      110       super().
      111       pMode = iChange .
      112       if pMode = 'ДОБАВЛЕНИЕ':U then
      113       do:
      114         create tt-OperServ .
      115         tt-OperServ.id = next-value (s-operserv-id) .
      116       end.
      117       else
      118       do:
      119         find first buf_OperServ exclusive-lock where buf_OperServ.id = p-id no-error .
      120         buffer-copy buf_OperServ to tt-OperServ .
      121         Enable_Form () .
      122       end.
      123       InitializeComponent().
      124       if pMode <> 'ДОБАВЛЕНИЕ':U then
      125       do:
      126         assign
      127         this-object:type_ras:Text = OsTypeRas .
      128         this-object:type_OperServ:Text = p-OsType .
      129         this-object:type_OperServ1:Text = p-OsType .
      130         this-object:type_OperServ2:Text = p-OsType .
      131         this-object:type_commis:Text = CommType .
      132         this-object:Commis:Text = string(Commis_val) .
      133         this-object:f_type_commis:Text = CommType .
      134         this-object:f_commis:Text = string(Commis_val) .
      135         this-object:c_bpa_AgentFlag:Text = p-AgentFlag .
      136         this-object:c_bpa_AgentFlagRas:Text = p-AgentFlagRasch .
      137         .
      138       end.
      139       Visual_form_Type(OsTypeRas).
      140       Visual_form_mode(pMode).
      141       bindingBPA:Handle = buffer tt-OperServ:handle .
      142       this-object:ComponentsCollection:ADD(this-object:components).
      143       catch e as Progress.Lang.Error:
      144         undo, throw e.
      145       end catch.
      146     end constructor.
      147     constructor public BPA_form ():
      148       InitializeComponent().
      149     end constructor.
