     1500         when "Начисление на карту" then
     1501           do:
     1502             assign
     1503               this-object:type_OperServ:Visible = false .
     1504             this-object:type_OperServ1:Visible = false .
     1505             this-object:type_OperServ2:Visible = true .
     1506             this-object:type_OperServ2:Text = "Пополнение ВБРР" .
