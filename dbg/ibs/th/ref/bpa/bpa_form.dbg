     1544         this-object:OCCgroup:Enabled = true .
     1545         this-object:auto_groupBox1:Enabled = true .
     1546         this-object:bpa_agent:Enabled = true .
     1547         this-object:bpa_groupBox3:Enabled = true .
     1548         this-object:bpa_oper:Enabled = true .
     1549         this-object:bpa_prod:Enabled = true .
     1550         .
