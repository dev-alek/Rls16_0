     1538         this-object:f_name:Enabled = true .
     1539         this-object:type_OperServ:Enabled = true .
     1540         this-object:type_OperServ1:Enabled = true .
     1541         this-object:type_OperServ2:Enabled = true .
     1542         this-object:type_ras:Enabled = true .
