      159     @VisualDesigner.
      160     method private void add_goods():
      161       define variable v-GdsList as character no-undo .
      162       define variable ii        as integer   no-undo .
      163       define buffer buf_OperServ  for ub.OperServ .
      164       run str/gdslist.p ( input parparentproc
      165         , output v-GdsList).
      166       if v-GdsList <> "" then
      167       do:
      168         v-GdsList = trim(v-GdsList,chr(6)) .
      169         for first ub.goods no-lock where ub.goods.gds-code = integer(entry(1, v-GdsList,chr(6))):
      170          if ub.goods.gds-type <> 'у':U then do:
      171            message "Товар должен быть услугой"
      172            view-as alert-box.
      173            return .
      174          end.
      175          else do:
      176          assign
      177          commis_gds:Text = string(entry(1, v-GdsList,chr(6)))
      178          commis_gds1:Text = string(entry(1, v-GdsList,chr(6)))
      179          tt-OperServ.gds-code = integer(entry(1, v-GdsList,chr(6))).
      180          end.
      181         end.
      182       end.
      183       return.
      184     end method.
