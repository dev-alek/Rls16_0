     1552         do:
     1553           this-object:type_ras:Enabled = false .
     1554         end.
     1555       end.
     1556       else
     1557       do:
     1558         assign
     1559           this-object:f_code:Enabled = false .
     1560         this-object:f_name:Enabled = false .
     1561         this-object:type_OperServ:Enabled = false .
     1562         this-object:type_ras:Enabled = false .
     1563         this-object:type_OperServ1:Enabled = false .
     1564         this-object:type_OperServ2:Enabled = false .
     1565         this-object:type:Enabled = false .
     1566         this-object:OCCgroup:Enabled = false .
     1567         this-object:auto_groupBox1:Enabled = false .
     1568         this-object:bpa_agent:Enabled = false .
     1569         this-object:bpa_groupBox3:Enabled = false .
     1570         this-object:bpa_oper:Enabled = false .
     1571         this-object:bpa_prod:Enabled = false .
     1572         .
     1573       end.
     1574       return.
