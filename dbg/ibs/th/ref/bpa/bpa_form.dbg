     1147     @VisualDesigner.
     1148     method private void b_click_cancel( input sender as System.Object, input e as System.EventArgs ):
     1149       empty temp-table tt-OperServ .
     1150       close().
     1151       return.
     1152     end method.
     1153     @VisualDesigner.
     1154     method private void b_click_exit( input sender as System.Object, input e as System.EventArgs ):
     1155       if pMode = 'ДОБАВЛЕНИЕ':U then
     1156       do:
     1157         bindingBPA:Assign().
     1158         create ub.OperServ .
     1159         buffer-copy tt-OperServ to ub.OperServ .
     1160       end.
     1161       if pMode = 'ИЗМЕНЕНИЕ':U then
     1162       do:
     1163         bindingBPA:Assign().
     1164         find first ub.OperServ exclusive-lock where ub.OperServ.id = tt-OperServ.id no-error .
     1165         buffer-copy tt-OperServ to ub.OperServ .
     1166       end.
     1167       Close().
     1168       return.
