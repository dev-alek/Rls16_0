     1493             this-object:auto_groupBox1:Visible = false .
     1494             this-object:bpa_agent:Visible = false .
     1495             this-object:bpa_groupBox3:Visible = false .
     1496             this-object:bpa_oper:Visible = false .
     1497             this-object:bpa_prod:Visible = false .
