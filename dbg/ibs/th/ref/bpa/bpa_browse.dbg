      828     METHOD PUBLIC VOID Visual_form( INPUT iChange AS character ):
      829       case iChange:
      830         when 'ИЗМЕНЕНИЕ':U then
      831           do:
      832             assign
      833               this-object:toolStripMark:Enabled = false.
      834             this-object:toolStripMenuChoose:Enabled = false.
      835             .
      836           end.
      837         when 'ВЫБОР':U then
      838           do:
      839             assign
      840             this-object:toolStripMenuAdd:Enabled = false .
      841             this-object:toolStripMenuCopy:Enabled = false .
      842             this-object:toolStripMenuDel:Enabled = false .
      843             this-object:toolStripMenuEdit:Enabled = false .
      844             this-object:toolStripMenuGoods:Enabled  = false .
      845             .
      846           end.
      847         when 'ПРОСМОТР':U then
      848           do:
      849             assign
      850             this-object:toolStripMenuAdd:Enabled = false .
      851             this-object:toolStripMenuCopy:Enabled = false .
      852             this-object:toolStripMenuDel:Enabled = false .
      853             this-object:toolStripMenuEdit:Enabled = false .
      854             this-object:toolStripMenuGoods:Enabled  = true .
      855             this-object:toolStripMark:Enabled = false.
      856             this-object:toolStripMenuChoose:Enabled = false.
      857             .
      858           end.
      859       end case .
      860       return.
      861     end method .
