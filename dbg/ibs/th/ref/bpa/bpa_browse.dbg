      123     @VisualDesigner.
      124     @VisualDesigner.
      125     method private void button_addBPA_Click(iChange as character, v-id as integer):
      126       define variable vPos      as integer   no-undo.
      127       define variable v-listact-brw as class ibs.th.ref.bpa.BPA_form no-undo .
      128       v-listact-brw = new ibs.th.ref.bpa.BPA_form (iChange,v-id).
      129       v-listact-brw:parparentproc = parparentproc.
      130       wait-for  v-listact-brw:ShowDialog() .
      131       vPos = bindingSource1:Position.
      132       bindingSource1:Handle = browse_OperServ(v-status, v-CalcType).
      133       bindingSource1:Position = vPos .
      134     end method.
      135     @VisualDesigner.
      136     method private void click_delete( input sender as System.Object, input e as System.EventArgs ):
      137       define variable vPos as integer no-undo.
      138       vPos = bindingSource1:Position.
      139       find first ub.OperServ exclusive-lock where ub.OperServ.id = tt-query.id and ub.OperServ.Status_ = 0 no-error .
      140       if available (ub.OperServ) then
      141       do:
      142         for each buf_goods-attr exclusive-lock where buf_goods-attr.attr-code = 'oper-serv-idd':U
      143           and buf_goods-attr.attr-value = string(tt-query.id):
      144           delete buf_goods-attr .
      145         end.
      146         ub.OperServ.Status_ = 1 .
      147       end.
      148       else
      149       do:
      150         find first ub.OperServ exclusive-lock where ub.OperServ.id = tt-query.id and ub.OperServ.Status_ = 1 no-error .
      151         if available (ub.OperServ) then
      152         do:
      153           MESSAGE
      154             "Востановить запись?"
      155             VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no UPDATE glog.
      156           IF NOT glog THEN RETURN ERROR.
      157           else
      158           do:
      159             ub.OperServ.Status_ = 0 .
      160           end.
      161         end.
      162       end.
      163       bindingSource1:Handle = browse_OperServ(v-status, v-CalcType).
      164       bindingSource1:Position = vPos .
      165       return.
      166     end method.
      167     @VisualDesigner.
      168     method private void click_mark( input sender as System.Object, input e as System.EventArgs ):
      169       define variable vPos as integer no-undo.
      170       vPos = bindingSource1:Position.
      171       v-list = "" .
      172       if tt-query.Mark = "*" then tt-query.Mark = "" .
      173       else tt-query.Mark = "*" .
      174       for each tt-query no-lock where tt-query.Mark = "*":
      175         v-list = v-list + chr(6) + string(tt-query.id) .
      176       end.
      177       p-list = trim (v-list,chr(6)) .
      178       bindingSource1:Position = vPos + 1 .
      179       bindingSource1:Refresh() .
      180       return.
      181     end method.
