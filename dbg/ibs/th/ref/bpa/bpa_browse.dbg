      514     @VisualDesigner.
      515     method private void menu_copy( input sender as System.Object, input e as System.EventArgs ):
      516       define buffer buf_OperServ for ub.OperServ .
      517       define variable type_ as character no-undo .
      518       define variable p-id  as integer   no-undo .
      519       find first buf_OperServ no-lock where buf_OperServ.id = tt-query.id no-error .
      520       if available (buf_OperServ) then
      521       do:
      522         create tt-OperServ .
      523         buffer-copy buf_OperServ except buf_OperServ.id to tt-OperServ .
      524         tt-OperServ.id = next-value (s-operserv-id) .
      525         create ub.OperServ .
      526         buffer-copy tt-OperServ to ub.OperServ .
      527         p-id = ub.OperServ.id .
      528         case ub.OperServ.OsType:
      529           when 0 then
      530             do:
      531               type_ = "" .
      532             end.
      533           when 1 then
      534             do:
      535               type_ = "ОСС (OpenWay)".
      536             end.
      537           when 2 then
      538             do:
      539               type_ = "Автопомощь".
      540             end.
      541           when 3 then
      542             do:
      543               type_ = "Пополнение ВБРР" .
      544             end.
      545           when 5 then
      546             do:
      547               type_ = "Выдача наличных" .
      548             end.
      549         end case .
      550         button_Edit( p-id , type_ ) .
      551       end.
      552       return.
      553     end method.
      554     @VisualDesigner.
      555     method private void r_status_Checked( input sender as System.Object, input e as System.EventArgs ):
      556       if this-object:radioButton1:Checked = true then v-status = 'все':U .
      557       if this-object:radioButton2:Checked = true then v-status = 'тек':U .
      558       if this-object:radioButton3:Checked = true then v-status = 'удал':U .
      559       bindingSource1:Handle = browse_OperServ(v-status, v-CalcType).
      560       return.
      561     end method.
      562     @VisualDesigner.
      563     method private void r_type_Checked( input sender as System.Object, input e as System.EventArgs ):
      564       case this-object:CalcType:Text:
      565         when "Все" then
      566           do:
      567             v-CalcType = 0 .
      568           end.
      569         when "Оплата Сотовой связи" then
      570           do:
      571             v-CalcType = 1 .
      572           end.
      573         when "Оплата по договору" then
      574           do:
      575             v-CalcType = 2 .
      576           end.
      577         when "Оплата Счёта" then
      578           do:
      579             v-CalcType = 3 .
      580           end.
      581         when "Начисление на карту" then
      582           do:
      583             v-CalcType = 4 .
      584           end.
      585         when "Платежный агент" then
      586           do:
      587             v-CalcType = 5 .
      588           end.
      589       end case.
      590       bindingSource1:Handle = browse_OperServ(v-status, v-CalcType).
      591       return.
      592     end method.
      593     @VisualDesigner.
      594     method private void select_goods( input sender as System.Object, input e as System.EventArgs ):
      595       define variable v-listact-brw as class ibs.th.ref.bpa.BPA_Goods no-undo .
      596       v-listact-brw = new ibs.th.ref.bpa.BPA_Goods (pMode,string( tt-query.id), 'oper-serv-idd':U).
      597    //v-listact-brw:Visual_form(iChange).
      598       v-listact-brw:parparentproc = parparentproc.
      599       wait-for  v-listact-brw:ShowDialog() .
      600       define variable v-err-msg as character no-undo .
      601       define variable vPos      as integer   no-undo.
      602       vPos = bindingSource1:Position.
      603       bindingSource1:Handle = browse_OperServ(v-status, v-CalcType).
      604       bindingSource1:Position = vPos.
      605       catch exAppErrors as class Progress.Lang.AppError :
      606         v-err-msg = exAppErrors:ReturnValue .
      607         if v-err-msg > "" then .
      608         else
      609         do :
      610           v-err-msg = exAppErrors:GetMessage(1) .
      611           if v-err-msg > "" then .
      612           else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\bpa\bpa_browse.cls" .
      613         end .
      614         message v-err-msg  view-as alert-box.
      615       end catch .
      616       catch exProErrors as class Progress.Lang.ProError :
      617         v-err-msg = exProErrors:GetMessage(1) .
      618         if v-err-msg > "" then .
      619         else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\bpa\bpa_browse.cls" .
      620         message "ProError" skip(1) v-err-msg  view-as alert-box.
      621       end catch .
      622       catch exAnyErrors as class Progress.Lang.Error:
      623         v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\bpa\bpa_browse.cls " + exAnyErrors:GetMessage(1).
      624         message "LangError" skip(1) v-err-msg  view-as alert-box.
      625       end catch .
      626       finally:
      627         if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
      628       end finally.
      629     end method.
      630     method private void add_query(buffer buf_OperServ for OperServ):
      631         create tt-query .
      632         assign
      633           tt-query.ext-code = buf_OperServ.ext-code
      634           tt-query.id       = buf_OperServ.id
      635           tt-query.OSname   = buf_OperServ.OSname
      636           .
      637         case buf_OperServ.OsType:
      638           when 0 then
      639             do:
      640               tt-query.OsType = "" .
      641             end.
      642           when 1 then
      643             do:
      644               tt-query.OsType = "ОСС (OpenWay)" .
      645             end.
      646           when 2 then
      647             do:
      648               tt-query.OsType = "Автопомощь" .
      649             end.
      650           when 3 then
      651             do:
      652               tt-query.OsType = "Пополнение ВБРР" .
      653             end.
      654             when 5 then
      655             do:
      656               tt-query.OsType = "Выдача наличных" .
      657             end.
      658         end case .
      659         case buf_OperServ.CalcType:
      660           when 1 then
      661             do:
      662               tt-query.OsTypeRas = "Оплата Сотовой связи" .
      663             end.
      664           when 2 then
      665             do:
      666               tt-query.OsTypeRas = "Оплата по договору" .
      667             end.
      668           when 3 then
      669             do:
      670               tt-query.OsTypeRas = "Оплата Счёта" .
      671             end.
      672           when 4 then
      673             do:
      674               tt-query.OsTypeRas = "Начисление на карту" .
      675             end.
      676           when 5 then
      677             do:
      678               tt-query.OsTypeRas = "Платежный агент" .
      679             end.
      680         end case .
      681         if buf_OperServ.Status_ = 0 then tt-query.Status_ = 'тек':U .
      682         else tt-query.Status_ = 'удал':U .
      683     end.
      684     method private handle browse_OperServ(status_ as character, type_ as integer):
      685       define buffer buf_OperServ for ub.OperServ .
      686       empty temp-table tt-query .
      687       case type_ :
      688         when 0 then
      689         do:
      690            case status_ :
      691               when 'все':U then
      692               do:
      693                  for each buf_OperServ no-lock :
      694                     add_query(buffer buf_OperServ).
      695                  end.
      696               end.
      697               when 'тек':U then
      698               do:
      699                  for each buf_OperServ no-lock where buf_OperServ.Status_ = 0:
      700                     add_query(buffer buf_OperServ).
      701                  end.
      702               end.
      703               when 'удал':U then
      704               do:
      705                  for each buf_OperServ no-lock where buf_OperServ.Status_ = 1:
      706                     add_query(buffer buf_OperServ).
      707                  end.
      708               end.
      709            end case.
      710         end.
      711         when 1 then
      712         do:
      713            case status_ :
      714            when 'все':U then
      715            do:
      716               for each buf_OperServ no-lock where buf_OperServ.CalcType = type_:
      717                  add_query(buffer buf_OperServ).
      718               end.
      719            end.
      720            when 'тек':U then
      721            do:
      722               for each buf_OperServ no-lock where buf_OperServ.Status_ = 0 and buf_OperServ.CalcType = type_:
      723                  add_query(buffer buf_OperServ).
      724               end.
      725            end.
      726            when 'удал':U then
      727            do:
      728               for each buf_OperServ no-lock where buf_OperServ.Status_ = 1 and buf_OperServ.CalcType = type_:
      729                  add_query(buffer buf_OperServ).
      730               end.
      731            end.
      732            end case.
      733         end .
      734         when 4 then
      735           do:
      736             case status_ :
      737               when 'все':U then
      738                 do:
      739                   for each buf_OperServ no-lock where buf_OperServ.CalcType = type_:
      740                     add_query(buffer buf_OperServ).
      741                   end.
      742                 end.
      743               when 'тек':U then
      744                 do:
      745                   for each buf_OperServ no-lock where buf_OperServ.Status_ = 0 and buf_OperServ.CalcType = type_:
      746                     add_query(buffer buf_OperServ).
      747                   end.
      748                 end.
      749               when 'удал':U then
      750                 do:
      751                   for each buf_OperServ no-lock where buf_OperServ.Status_ = 1 and buf_OperServ.CalcType = type_:
      752                     add_query(buffer buf_OperServ).
      753                   end.
      754                 end.
      755             end case.
      756           end.
      757         when 5 then
      758           do:
      759             case status_ :
      760               when 'все':U then
      761                 do:
      762                   for each buf_OperServ no-lock where buf_OperServ.CalcType = type_:
      763                     add_query(buffer buf_OperServ).
      764                   end.
      765                 end.
      766               when 'тек':U then
      767                 do:
      768                   for each buf_OperServ no-lock where buf_OperServ.Status_ = 0 and buf_OperServ.CalcType = type_:
      769                     add_query(buffer buf_OperServ).
      770                   end.
      771                 end.
      772               when 'удал':U then
      773                 do:
      774                   for each buf_OperServ no-lock where buf_OperServ.Status_ = 1 and buf_OperServ.CalcType = type_:
      775                     add_query(buffer buf_OperServ).
      776                   end.
      777                 end.
      778             end case.
      779           end.
      780       end case .
      781       if valid-handle(hQuery)  THEN DELETE object hQuery.
      782       create query hQuery.
      783       hQuery:set-buffers(buffer tt-query:HANDLE).
      784       hQuery:query-prepare("FOR EACH tt-query").
      785       hQuery:query-open.
      786       return hQuery .
      787     end method .
