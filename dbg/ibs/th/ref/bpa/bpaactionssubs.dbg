        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.*.
        3   USING ibs.th.ref.bpa.*.
        4   block-level on error undo, throw.
        5   class ibs.th.ref.bpa.BpaActionsSubs inherits asubjects:
        6   define variable vss-revision    as character no-undo initial "$Revision: c16e05d4b612, 2089, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Wed Dec 25 15:23:51 2019 +0300 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: BpaActionsSubs.cls $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/bpa/BpaActionsSubs.cls $":U .
       11   define variable vss-description as character no-undo initial "Объект платежных агентов/операторов.".
       12   define property bpaActionObjCurr as class bpaActionSub
       13   get:
       14     return cast (SubjectObjCurr, bpaActionSub) .
       15   end.
       16   end class.
