      534     @VisualDesigner.
      535     method private void leave_commis( input sender as System.Object, input e as System.EventArgs ):
      536       if c_type_commis:Items:ToString() = "Процент" then
      537       do:
      538         OperServ.CommPerc = integer(f_commis:Text).
      539       end.
      540       else
      541       do:
      542         OperServ.CommSumm = integer(f_commis:Text).
      543       end.
      544       return.
      545     end method.
      546     @VisualDesigner.
      547     method private void leave_type_commis( input sender as System.Object, input e as System.EventArgs ):
      548       if c_type_commis:Items:ToString() = "Процент" then
      549       do:
      550         OperServ.CommType = 0.
      551       end.
      552       else
      553       do:
      554         OperServ.CommType = 1.
      555       end.
      556       return.
