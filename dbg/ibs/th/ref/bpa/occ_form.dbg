      483     @VisualDesigner.
      484     method private void leave_CalcType( input sender as System.Object, input e as System.EventArgs ):
      485       case c_type_commis:Items:ToString():
      486         when "Оплата Сотовой связи" then
      487           do:
      488             OperServ.CalcType = 1 .
      489           end.
      490         when "Оплата по договору" then
      491           do:
      492             OperServ.CalcType = 2 .
      493           end.
      494         when "Оплата Счёта" then
      495           do:
      496             OperServ.CalcType = 3 .
      497           end.
      498         when "Начисление на карту" then
      499           do:
      500             OperServ.CalcType = 4 .
      501           end.
      502         when "Платежный агент" then
      503           do:
      504             OperServ.CalcType = 5 .
      505           end.
      506       end case.
      507       return.
      508     end method.
