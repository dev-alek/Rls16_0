       40     constructor public OCC_form (iChange as character, p-id as integer ):
       41       super().
       42       pMode = iChange .
       43       case pMode:
       44         when 'ДОБАВЛЕНИЕ':U then
       45           do:
       46             create OperServ .
       47             ub.OperServ.id = next-value (s-operserv-id) .
       48             ub.OperServ.OsType  = 1 .
       49           end.
       50         when 'ИЗМЕНЕНИЕ':U then
       51           do:
       52             find first ub.OperServ exclusive-lock where ub.OperServ.id = p-id no-error .
       53           end.
       54         when 'ПРОСМОТР':U then
       55           do:
       56             find first ub.OperServ exclusive-lock where ub.OperServ.id = p-id no-error .
       57           end.
       58       end case .
       59       InitializeComponent().
       60       Visual_form(pMode).
       61       bindingSource1:Handle = buffer OperServ:handle .
       62       this-object:ComponentsCollection:ADD(this-object:components).
       63       catch e as Progress.Lang.Error:
       64         undo, throw e.
       65       end catch.
       66     end constructor.
       67     constructor public OCC_form ():
       68     end constructor.
       69     @VisualDesigner.
       70     method private void b_cancel_Click( input sender as System.Object, input e as System.EventArgs ):
       71       if pMode = 'ДОБАВЛЕНИЕ':U then delete ub.OperServ .
       72       Close().
       73       return.
       74     end method.
       75     @VisualDesigner.
       76     method private void b_exit_Click( input sender as System.Object, input e as System.EventArgs ):
       77       if pMode = 'ДОБАВЛЕНИЕ':U then do:
       78         find first ub.OperServ exclusive-lock where ub.OperServ.ext-code = f_code:Text no-error .
       79         if available (ub.OperServ) then do:
       80           message "Платежный агент/оператор уже есть с таким кодом: " f_code:Text
       81           view-as alert-box.
       82           return .
       83         end.
       84       bindingSource1:Assign().
       85       end.
       86       Close().
       87       return.
       88     end method.
