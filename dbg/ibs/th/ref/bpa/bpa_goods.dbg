       50     method private void click_add( input sender as System.Object, input e as System.EventArgs ):
       51       add_attr().
       52       return.
       53     end method.
       54     @VisualDesigner.
       55     method private void add_attr():
       56       define variable v-GdsList as character no-undo .
       57       define variable ii        as integer   no-undo .
       58       define buffer bf_goods-attr     for ub.goods-attr .
       59       define buffer buf_tt-goods-attr for tt-goods-attr .
       60       define variable glog     as logical no-undo .
       61       define variable v-glog   as logical no-undo .
       62       define variable goods-ok as logical no-undo .
       63       define buffer buf_OperServ  for ub.OperServ .
       64       define variable v-name  as character no-undo .
       65       empty temp-table tt-goods-attr .
       66       run str/gdslist.p ( input parparentproc
       67         , output v-GdsList).
       68       if v-GdsList <> "" then
       69       do:
       70         v-GdsList = trim(v-GdsList,chr(6)) .
       71         do ii = 1 to num-entries (v-GdsList,chr(6)):
       72           find first ub.goods-attr where ub.goods-attr.attr-code = p-attr-code and
       73             ub.goods-attr.gds-code   = integer(entry(ii,v-GdsList,chr(6))) no-error .
       74           if not available (ub.goods-attr) then
       75           do:
       76             CREATE ub.goods-attr.
       77             ASSIGN
       78               ub.goods-attr.attr-code  = p-attr-code
       79               ub.goods-attr.attr-value = string(id_)
       80               ub.goods-attr.gds-code   = integer(entry(ii,v-GdsList,chr(6)))
       81               .
       82           end.
       83           else
       84           do:
       85             create tt-goods-attr.
       86             ASSIGN
       87               tt-goods-attr.attr-code  = p-attr-code
       88               tt-goods-attr.attr-value = ub.goods-attr.attr-value
       89               tt-goods-attr.gds-code   = integer(entry(ii,v-GdsList,chr(6)))
       90               .
       91           end.
       92         end.
       93       end.
       94       find first buf_tt-goods-attr no-error .
       95       if available (buf_tt-goods-attr) then
       96       do:
       97         MESSAGE
       98           "Перепривязать товары?"
       99           VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no UPDATE glog.
      100         IF NOT glog THEN RETURN ERROR.
      101         else
      102         do:
      103           MESSAGE
      104             "Для всех товаров?"
      105             VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no UPDATE v-glog.
      106           IF NOT v-glog THEN
      107           do:
      108             for each tt-goods-attr:
      109               for first ub.goods no-lock where ub.goods.gds-code = tt-goods-attr.gds-code:
      110               if p-attr-code = 'oper-serv-idd':U then do:
      111               find first buf_OperServ no-lock where buf_OperServ.id = integer(tt-goods-attr.attr-value) no-error .
      112               if available (buf_OperServ) then v-name = buf_OperServ.OSname .
      113               end.
      114               else do:
      115                 find first ub.CashBook no-lock where ub.CashBook.id = integer(tt-goods-attr.attr-value) no-error .
      116                 if available (ub.CashBook) then v-name = ub.CashBook.CashBookName .
      117               end.
      118               message "Товар: " + ub.goods.gds-name + " привязан к " + v-name + ", перепривязать?"
      119                 view-as alert-box question buttons yes-no update goods-ok .
      120               if goods-ok then
      121               do:
      122                 find first bf_goods-attr exclusive-lock where bf_goods-attr.gds-code = tt-goods-attr.gds-code
      123                   and bf_goods-attr.attr-code = tt-goods-attr.attr-code .
      124                 delete bf_goods-attr .
      125                 create bf_goods-attr .
      126                 assign
      127                   bf_goods-attr.gds-code   = tt-goods-attr.gds-code
      128                   bf_goods-attr.attr-code  = tt-goods-attr.attr-code
      129                   bf_goods-attr.attr-value = string(id_)
      130                   .
      131               end.
      132             end.
      133             end.
      134           end.
      135           else
      136           do:
      137             for each tt-goods-attr:
      138               find first bf_goods-attr exclusive-lock where bf_goods-attr.gds-code = tt-goods-attr.gds-code
      139                 and bf_goods-attr.attr-code = tt-goods-attr.attr-code .
      140               delete bf_goods-attr .
      141               create bf_goods-attr .
      142               assign
      143                 bf_goods-attr.gds-code   = tt-goods-attr.gds-code
      144                 bf_goods-attr.attr-code  = tt-goods-attr.attr-code
      145                 bf_goods-attr.attr-value = string(id_)
      146                 .
      147             end.
      148           end.
      149         end.
      150       end.
      151       bindingSource1:Handle = browse_Goods().
      152       return.
      153     end method.
