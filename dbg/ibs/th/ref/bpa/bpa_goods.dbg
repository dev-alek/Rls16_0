      158     end method.
      159     @VisualDesigner.
      160     method private void click_del( input sender as System.Object, input e as System.EventArgs ):
      161       define buffer buf_goods-attr for ub.goods-attr .
      162                   define variable vPos as integer no-undo.
      163       vPos = bindingSource1:Position.
      164       find first buf_goods-attr exclusive-lock where buf_goods-attr.gds-code = tt-goods.gds-code and buf_goods-attr.attr-code = p-attr-code no-error .
      165       if available (buf_goods-attr) then
      166       do:
      167         delete buf_goods-attr .
      168       end.
      169       bindingSource1:Handle = browse_Goods().
      170       return.
      171     end method.
      172           @VisualDesigner.
      173           method private void click_del_all( input sender as System.Object, input e as System.EventArgs ):
      174                   define buffer buf_goods-attr for ub.goods-attr .
      175                   for each buf_goods-attr exclusive-lock where buf_goods-attr.attr-code = p-attr-code
      176                   and buf_goods-attr.attr-value = string(id_):
      177                     delete buf_goods-attr .
      178                   end.
      179                   bindingSource1:Handle = browse_Goods().
      180                   return.
      181           end method.
      182     METHOD PUBLIC VOID Visual_form( INPUT iChange AS character ):
      183       if iChange = 'ПРОСМОТР':U then
      184       do:
      185         assign
      186         this-object:toolStripMenuAdd:Enabled = false.
      187         this-object:toolStripMenuDel:Enabled = false.
      188         this-object:toolStripMenuDelAll:Enabled = false .
      189         .
      190       end.
      191       return.
      192     end method .
      193     method private handle browse_Goods():
      194       define buffer buf_goods-attr for ub.goods-attr .
      195       define buffer buf_goods      for ub.goods .
      196       empty temp-table tt-goods .
      197       for each buf_goods-attr no-lock where buf_goods-attr.attr-code = p-attr-code
      198       and buf_goods-attr.attr-value = string(id_),
      199         first buf_goods no-lock where buf_goods.gds-code = buf_goods-attr.gds-code:
      200         create tt-goods .
      201         assign
      202           tt-goods.artic    = buf_goods.artic
      203           tt-goods.gds-code = buf_goods.gds-code
      204           tt-goods.gds-name = buf_goods.gds-name
      205           tt-goods.gds-type = buf_goods.gds-type
      206           .
      207       end.
      208       if valid-handle(hQuery)  THEN DELETE object hQuery.
      209       create query hQuery.
      210       hQuery:set-buffers(buffer tt-goods:HANDLE).
      211       hQuery:query-prepare("FOR EACH tt-goods").
      212       hQuery:query-open.
      213       return hQuery .
      214     end method .
