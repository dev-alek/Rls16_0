      199     METHOD PUBLIC VOID ShowModalDialog(  ):
      200       define variable v-ind1 as integer no-undo .
      201       define variable v-ind2 as integer no-undo .
      202       define variable v-ind3 as integer no-undo .
      203       if climGrp > "" then do :
      204         v-ind1 = max(0, this-object:cbCliGrp:FindStringExact(climGrp) ) .
      205       end .
      206       else v-ind1 = 0 .
      207       if beginSummer > "" then do :
      208         v-ind2 = this-object:cbSpring:FindStringExact(beginSummer) .
      209         if v-ind2 < 0 then v-ind2 = 3 .
      210       end .
      211       else v-ind2 = 3 .
      212       if beginWinter > "" then do :
      213         v-ind3 = this-object:cbWinter:FindStringExact(beginWinter) .
      214         if v-ind3 < 0 then v-ind3 = 8 .
      215       end .
      216       else v-ind3 = 8 .
      217       assign
      218         this-object:cbCliGrp:SelectedIndex = v-ind1
      219         this-object:cbSpring:SelectedIndex = v-ind2
      220         this-object:cbWinter:SelectedIndex = v-ind3
      221       .
      222       WAIT-FOR THIS-OBJECT:ShowDialog().
      223     END METHOD.
      224   END CLASS.
