       33           @VisualDesigner.
       34           METHOD PRIVATE VOID cbSpring_SelectedIndexChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
       35       define variable v-winter-ind as integer no-undo . // ind0 = feb, ind10=dec
       36       v-winter-ind = this-object:cbWinter:SelectedIndex + 1 . // => ind1=feb, ind11=dec
       37       if (this-object:cbSpring:SelectedIndex > v-winter-ind) then
       38         this-object:cbWinter:SelectedIndex = this-object:cbSpring:SelectedIndex - 1 .
       39                   RETURN.
       40           END METHOD.
       41           @VisualDesigner.
       42           METHOD PRIVATE VOID cbWinter_SelectedIndexChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
       43       define variable v-winter-ind as integer no-undo . // ind0 = feb, ind10=dec
       44       v-winter-ind = this-object:cbWinter:SelectedIndex + 1 . // => ind1=feb, ind11=dec
       45       if (this-object:cbSpring:SelectedIndex > v-winter-ind) then
       46         this-object:cbSpring:SelectedIndex = this-object:cbWinter:SelectedIndex + 1 .
       47                   RETURN.
       48           END METHOD.
