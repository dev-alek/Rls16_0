       60     constructor public marktype (
       61        iParentProc as handle,
       62        iMode as character,
       63        iCode      like ub.code.code,
       64        iCodeValue like ub.code.codevalue,
       65        iCodeName  like ub.code.codename,
       66        iMisc1     like ub.code.misc1,
       67        iMisc2     like ub.code.misc2,
       68        iMisc3     like ub.code.misc3,
       69        iMisc4     like ub.code.misc4
       70        ):
       71       define buffer bufCode for ub.code.
       72       super().
       73       assign
       74         parparentproc = iParentProc
       75         mode = iMode
       76       .
       77       InitializeComponent().
       78       this-object:ComponentsCollection:ADD(this-object:components).
       79       this-object:fillCode:text = iCode.
       80       if mode = 'ДОБАВЛЕНИЕ':U then
       81       do:
       82           assign
       83             this-object:fillMisc3:Value    = today
       84             this-object:fillMisc4:Value    = datetime(today, 0)
       85             this-object:checkMisc2:Checked = true
       86           .
       87       end.
       88       else
       89       do:
       90           assign
       91             this-object:fillCodeValue:text    = iCodeValue
       92             this-object:fillCodeName:text     = iCodeName
       93             this-object:fillMisc1:text        = iMisc1
       94             this-object:checkMisc2:Checked    = logical(iMisc2)
       95             this-object:fillMisc3:Value       = date(iMisc3)
       96             this-object:fillMisc4:Value       = datetime(date(iMisc3), int(IMisc4) * 1000)
       97           .
       98           if can-find(first bufCode where
       99                             bufCode.parent = "MarkType"
      100                         and bufCode.code   = this-object:fillCode:text
      101                       ) then
      102           do:
      103               assign
      104                 this-object:fillCode:Enabled      = false
      105                 this-object:fillCodeValue:Enabled = false
      106                 this-object:fillMisc1:Enabled     = false
      107               .
      108           end.
      109       end.
      110       this-object:groupBox:Focus().
      111       catch e as Progress.Lang.Error:
      112         undo, throw e.
      113       end catch.
      114     end constructor.
      115     @VisualDesigner.
      116     method private void mButtonExit( input sender as System.Object, input e as System.EventArgs ):
      117       isUpdated = false.
      118       close() .
      119       return.
      120     end method.
      121     @VisualDesigner.
      122     method private void mButtonEnter( input sender as System.Object, input e as System.EventArgs ):
      123       define buffer bufCode for ub.code.
      124       if this-object:fillCodeValue:text = "" or
      125          this-object:fillCodeName:text = "" or
      126          int(this-object:fillMisc1:text) = 0 then
      127       do:
      128           message "Все поля формы должны быть заполнены." view-as alert-box.
      129           return.
      130       end.
      131       if mode = 'ДОБАВЛЕНИЕ':U then
      132       do:
      133           find first bufCode where
      134                      bufCode.parent  = "MarkType"
      135                  and (bufCode.code    = string(int(this-object:fillCode:text))
      136                   or bufCode.codevalue = this-object:fillCodeValue:text)
      137                no-lock no-error.
      138           if avail bufCode then
      139           do:
      140               message
      141                 substitute(
      142                     "В системе уже есть запись в кодом маркировки &1 и значением &2.~nСохранение невозможно.",
      143                     quoter(bufCode.code),
      144                     quoter(bufCode.codevalue)
      145                 ) view-as alert-box.
      146               return.
      147           end.
      148       end.
      149       assign
      150           codeType  = this-object:fillCode:text
      151           codeValue = this-object:fillCodeValue:text
      152           codeName  = this-object:fillCodeName:text
      153           codeMisc1 = this-object:fillMisc1:text
      154           codeMisc2 = if this-object:checkMisc2:Checked then "yes" else "no"
      155           codeMisc3 = string(this-object:fillMisc3:Value,"99.99.9999")
      156           codeMisc4 = string(mtime(this-object:fillMisc4:Value) / 1000)
      157           isUpdated = true
      158       .
      159       close() .
      160       return.
      161     end method.
      162     @VisualDesigner.
      163     method private void mCheckDigit(input sender as System.Object, input e as System.EventArgs):
      164       define variable vTextBox as System.Windows.Forms.TextBox no-undo.
      165       define variable vText    as integer                      no-undo.
      166       vTextBox = cast(sender, System.Windows.Forms.TextBox).
      167       if vTextBox:Text = "" then return.
      168       vText = integer(vTextBox:text) no-error.
      169       if error-status:error or
      170          substring(vTextBox:text, 1, length(vTextBox:text)) = "." or
      171          substring(vTextBox:text, 1, length(vTextBox:text)) = "," or
      172          length(vTextBox:text) > 2 then
      173       do:
      174           vTextBox:text = substring(vTextBox:text, 1, length(vTextBox:text) - 1).
      175           vTextBox:SelectionStart = length(vTextBox:Text).
      176       end.
      177     end method.
      178     @VisualDesigner.
      179     method private void mCheckInputCodeValue(input sender as System.Object, input e as System.EventArgs):
      180       define variable vTextBox as System.Windows.Forms.TextBox no-undo.
      181       define variable vAscii as integer no-undo.
      182       define variable vCount as integer   no-undo.
      183       define variable vValue as character no-undo.
      184       vTextBox = cast(sender, System.Windows.Forms.TextBox).
      185       if vTextBox:Text = "" then return.
      186       do vCount = 1 to length(vTextBox:Text):
      187         vAscii   = asc(substring(vTextBox:text, vCount, 1)).
      188         if not ((vAscii >= 48 and vAscii <= 57) or
      189                 (vAscii >= 65 and vAscii <= 90) or
      190                 (vAscii >= 97 and vAscii <= 122)) then
      191         do:
      192           message
      193             "Разрешен ввод только цифр и латинских букв." skip
      194             "Проверьте раскладку клавиатуры."
      195             view-as alert-box.
      196           substring(vTextBox:text, vCount, 1) = "".
      197           vTextBox:SelectionStart = length(vTextBox:Text).
      198         end.
      199       end.
      200     end method.
