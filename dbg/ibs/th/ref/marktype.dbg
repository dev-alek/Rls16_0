      401   end .
      402   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      403         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      404         then do:
      405             proc-alt-shift-f3 ().
      406         end.
      407         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      408         then do:
      409             proc-alt-shift-f2 ().
      410         end.
      411   end method.
      412   method private void End_obj_KeyDown():
      413   catch e as Progress.Lang.Error:
      414            undo, throw e.
      415         end catch.
      416   end method.
      417   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      418      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      419      define variable v-curr-sv-date as date no-undo .
      420      define variable v-new-sv-date  as date no-undo .
      421      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      422      then do:
      423         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      424         run gbl/getcurdt.p
      425            (output v-curr-sv-date
      426         ) .
      427         vdate:value = v-curr-sv-date.
      428      end.
      429      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      430      then do:
      431         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      432         v-curr-sv-date = vdate:value .
      433         if v-curr-sv-date = ?
      434         then do:
      435            run gbl/getcurdt.p
      436               (output v-curr-sv-date
      437            ) .
      438         end.
      439         if v-curr-sv-date <> ?
      440         then do:
      441            assign
      442               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      443               vdate:value = v-new-sv-date
      444            .
      445         end.
      446      end.
      447      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      448      then do:
      449         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      450         v-curr-sv-date = vdate:value.
      451         if v-curr-sv-date = ?
      452         then do:
      453            run gbl/getcurdt.p
      454               (output v-curr-sv-date
      455            ) .
      456         end.
      457         if v-curr-sv-date <> ?
      458         then do:
      459            run gbl/lastdate.p
      460               (input  v-curr-sv-date
      461               ,output v-new-sv-date
      462            ).
      463            vdate:value = v-new-sv-date.
      464         end.
      465      end.
      466      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      467      then do:
      468         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      469         define variable v-description   as character no-undo .
      470         define variable v-ok            as logical no-undo.
      471         v-curr-sv-date = vdate:value.
      472         if v-curr-sv-date = ?
      473         then do:
      474            run gbl/getcurdt.p
      475               (output v-curr-sv-date
      476            ) .
      477         end.
      478         if v-curr-sv-date <> ?
      479         then do:
      480            run gbl/d-inpday.w
      481               (input ?
      482               ,input "Выбор даты"
      483               ,input v-description
      484               ,input ""
      485               ,input-output v-curr-sv-date
      486               ,output v-ok
      487            ).
      488            if v-ok = true
      489            then do:
      490               vdate:value = v-curr-sv-date .
      491            end.
      492         end.
      493      end.
      494   end method.
      495   method private void End_date_KeyDown():
      496       catch e as Progress.Lang.Error:
      497         undo, throw e.
      498       end catch.
      499     end method.
      500     destructor public marktype ( ):
      501     end destructor.
      502   end class.
