      376   method void proc-alt-shift-f2 ():
      377     if not ibs.th.gbl.gbl-var:rcode
      378   then
      379     run gbl\inidebug.p .
      380   end.
      381   method void proc-alt-shift-f3 ():
      382      define variable vdebugalert   as logical no-undo .
      383      assign
      384         vdebugalert = session:debug-alert
      385         session:debug-alert = yes
      386      .
      387   message program-name( 1 ) skip( 1 )
      388             vss-revision                  skip( 0 )
      389             vss-author                    skip( 0 )
      390             vss-date                      skip( 0 )
      391             vss-workfile                  skip( 0 )
      392             vss-archive                   skip( 1 )
      393             vss-description               skip( 1 )
      394     view-as alert-box title "Текущая программа".
      395     session:debug-alert = vdebugalert.
      396   end.
      397   define variable v-inform-launched as logical no-undo initial false .
