       30   method private handle add_Coints():
       31      define variable v-list-coints as character no-undo .
       32      define variable ii            as integer   no-undo .
       33      v-list-coints = "10;5;2;1;0.5;0.1;0.05" .
       34       define variable ddd as decimal no-undo.
       35       do ii = 1 to num-entries (v-list-coints,";"):
       36         find first tt-coins where tt-coins.id       = decimal (entry(ii,v-list-coints,";"))
       37         no-error.
       38         if not available tt-coins
       39         then do:
       40            create tt-coins .
       41            assign
       42              tt-coins.id       = decimal(entry(ii,v-list-coints,";"))
       43              tt-coins.qnty     = 0
       44              tt-coins.sum-qnty = 0
       45              .
       46          end.
       47       end.
       48   end.
       49   method private handle getq_Coints():
       50   if valid-handle(hQueryCoins)  then delete object hQueryCoins.
       51       create query hQueryCoins.
       52       hQueryCoins:set-buffers(buffer tt-coins:HANDLE).
       53       hQueryCoins:query-prepare("FOR EACH tt-coins by tt-coins.id desc").
       54       hQueryCoins:query-open.
       55       return hQueryCoins.
       56   end.
       57   method private handle add_Banknot():
       58      define variable v-list-banknot as character no-undo .
       59      define variable ii             as integer   no-undo .
       60      v-list-banknot = "5000;2000;1000;500;200;100;50;10" .
       61       do ii = 1 to num-entries (v-list-banknot,";"):
       62         find first tt-banknots where tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       63         no-error.
       64         if not available tt-banknots
       65         then do:
       66            create tt-banknots .
       67            assign
       68              tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       69              tt-banknots.qnty     = 0
       70              tt-banknots.sum-qnty = 0
       71              .
       72          end.
       73       end.
       74   end.
       75   method private handle getq_Banknot():
       76      if valid-handle(hQueryBanknot)  then delete object hQueryBanknot.
       77       create query hQueryBanknot.
       78       hQueryBanknot:set-buffers(buffer tt-banknots:HANDLE).
       79       hQueryBanknot:query-prepare("FOR EACH tt-banknots by tt-banknots.id desc").
       80       hQueryBanknot:query-open.
       81       return hQueryBanknot.
       82   end.
