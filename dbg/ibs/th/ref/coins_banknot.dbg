      369     method public void Update_Banknots (input table1 as handle):
      370       define variable vB as handle no-undo.
      371       define buffer tt-banknots for tt-banknots.
      372       vB = table1:get-buffer-handle (1).
      373       table1:get-first( ).
      374       do while table1:query-off-end <> true:
      375          find first tt-banknots where tt-banknots.id       = vB::id
      376          no-error.
      377          if not available tt-banknots
      378          then
      379             create tt-banknots.
      380          assign
      381             tt-banknots.id       = vB::id
      382             tt-banknots.qnty     = vB::qnty
      383             tt-banknots.sum-qnty = vB::sum-qnty.
      384          table1:get-next( ).
      385       end.
      386       setItog().
      387       bindingSource_Bank:Handle = table1 .
      388     end.
      389     method public void Update_coints (input table2 as handle):
      390        define variable vB as handle no-undo.
      391        define buffer tt-coins for tt-coins.
      392        vB = table2:get-buffer-handle (1).
      393       do while table2:query-off-end <> true:
      394          find first tt-coins where tt-coins.id       = vB::id
      395          no-error.
      396          if not available tt-coins
      397          then
      398             create tt-coins.
      399          assign
      400             tt-coins.id       = vB::id
      401             tt-coins.qnty     = vB::qnty
      402             tt-coins.sum-qnty = vB::sum-qnty.
      403          table2:get-next(  ).
      404       end.
      405       setItog().
      406       bindingSource_Coins:Handle = table2 .
      407     end.
      408     method private handle browse_Coints():
      409       add_Coints().
      410       return getq_Coints() .
      411     end method .
      412     method private handle browse_Banknot():
      413       add_Banknot().
      414       return getq_Banknot().
      415     end method .
      416     method private void setItog():
      417        define buffer tt-coins     for tt-coins.
      418        define buffer tt-banknots  for tt-banknots.
      419        define variable vSumm as decimal no-undo.
      420        for each tt-coins:
      421           VSumm = vSumm + tt-coins.sum-qnty.
      422        end.
      423        for each tt-banknots :
      424           VSumm = vSumm + tt-banknots .sum-qnty.
      425        end.
      426        Fsumm:text = string(VSumm,">>>>>>>>>9.99").
      427        v-total-sum = vSumm .
      428     end.
      429     method private void ChekItog():
      430     end.
      431     destructor public Coins_Banknot ( ):
      432     end destructor.
      433   end class.
