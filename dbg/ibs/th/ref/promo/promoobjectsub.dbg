        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   USING ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.ref.promo.PromoObjectSub implements ithsub:
        7   define variable vss-revision    as character no-undo initial "$Revision: 709fd28fa30d, 1490, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Thu Aug 30 10:41:46 2018 +0300 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: promoobjectsub.cls $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/promo/promoobjectsub.cls $":U .
       12   define variable vss-description as character no-undo initial "Объект объекта акции.".
       13     define property Msg as character no-undo
       14       get.
       15       set.
       16       define property StatusErr as logical no-undo
       17       get:
       18         def var err as log no-undo.
       19         err = StatusErr.
       20         StatusErr = false.
       21         return err.
       22       end.
       23       private set.
       24     define property ID as int64 init ?  no-undo
       25       get.
       26       set (ID-arg as int64):
       27         ID = ID-arg.
       28       end.
       29       define property db-num as integer  no-undo
       30       get.
       31       set(arg as integer ):
       32         if arg <> db-num
       33         then do:
       34           db-num = arg.
       35           setFlagChange (true).
       36         end.
       37       end.
       38     define buffer bf_clients for ub.clients.
       39     define property obj-type as char no-undo
       40       get.
       41       SET (arg as char):
       42         if arg <> obj-type
       43         then do:
       44           obj-type = arg.
       45           release bf_clients.
       46           setFlagChange (true).
       47         end.
       48       END.
       49     define property idAction as int64 no-undo
       50       get.
       51       set(arg as int64):
       52         if arg <> idAction
       53         then do:
       54           idAction = arg.
       55           setFlagChange (true).
       56         end.
       57       END.
       58     define property obj-code as int no-undo
       59       get.
       60       set(arg as int):
       61         if arg <> obj-code
       62         then do:
       63           obj-code = arg.
       64           release bf_clients.
       65           setFlagChange (true).
       66         end.
       67       END.
       68     define property end-date as date no-undo
       69       get.
       70       set(arg as date):
       71         if arg <> end-date
       72         then do:
       73           end-date = arg.
       74           setFlagChange (true).
       75         end.
       76       END.
       77       define property FirmCode as integer no-undo
       78       get:
       79           define  variable v-host-code as integer   no-undo.
       80           define  variable v-host-name as character no-undo.
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   run hostname in ibs.th.gbl.gbl-hndllib:g#library
       83     (input  obj-type
       84     ,input  obj-code
       85     ,output v-host-code
       86     ,output v-host-name
       87     )  .
       88           return  v-host-code.
       89       end.
       90       define property FirmName as char no-undo
       91       get:
       92           define  variable v-host-code as integer no-undo.
       93           define  variable v-host-name as character no-undo.
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   run hostname in ibs.th.gbl.gbl-hndllib:g#library
       96     (input  obj-type
       97     ,input  obj-code
       98     ,output v-host-code
       99     ,output v-host-name
      100     )  .
      101           return  v-host-name.
      102       end.
      103       define property objName as character no-undo
      104       get:
      105         if available (bf_clients)
      106         then do:
      107           return bf_clients.obj-name.
      108         end.
      109         else do:
      110           find first bf_clients no-lock
      111                where bf_clients.obj-type = obj-type
      112                  and bf_clients.obj-code = obj-code
      113           no-error.
      114           if available (bf_clients)
      115           then do:
      116             return bf_clients.obj-name.
      117           end.
      118           else return "".
      119         end.
      120       end.
      121       define property objDbNum as Integer no-undo
      122       get:
      123         if available (bf_clients)
      124         then do:
      125           return bf_clients.db-num.
      126         end.
      127         else do:
      128           find first bf_clients no-lock
      129                where bf_clients.obj-type = obj-type
      130                  and bf_clients.obj-code = obj-code
      131           no-error.
      132           if available (bf_clients)
      133           then do:
      134             return bf_clients.db-num.
      135           end.
      136           else return 0.
      137         end.
      138       end.
      139       define property Mode as char no-undo init 'и':U
      140       get.
      141       set.
      142       define property Changed as logical no-undo
      143       get.
      144       set.
      145     constructor public promoobjectsub (  ):
      146     end constructor.
      147     method public void setMsg( arg as character ):
      148       Msg = arg.
      149     end.
      150     method public void setStatusErr( arg as logical ):
      151       StatusErr = arg.
      152     end.
      153     method public void setFlagChange( arg as logical ):
      154       Changed = arg.
      155     end.
      156     destructor public promoobjectsub ( ):
      157      //  Clean().
      158     end destructor.
      159   end class.
