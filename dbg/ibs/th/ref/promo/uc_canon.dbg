       28       method public VOID setDisable(input iModeView as logical  ):
       29           assign
       30               textBox1:enabled = not iModeview
       31               textBox2:enabled = not iModeview
       32            .
       33       end.
       34        method Public VOID LocalEvent(input iEvent as character, input iEventParam as character  ):
       35           if iEvent eq "CritOneLable"
       36           then do:
       37               if entry (1, iEventParam,"#") ne "?"
       38               then assign
       39                   label1:text    = entry (1, iEventParam,"#")
       40                   label1:visible = yes
       41                   textBox1:visible = yes
       42               .
       43               else assign
       44                   label1:visible      = no
       45                   textBox1:visible    = no
       46               .
       47               if     num-entries(iEventParam,"#") > 1
       48                  and entry (2, iEventParam,"#") ne "?"
       49               then assign
       50                   label2:text    = entry (2, iEventParam,"#")
       51                   label2:visible = yes
       52                   textBox2:visible = yes
       53               .
       54               else assign
       55                   label2:visible      = no
       56                   textBox2:visible    = no
       57               .
       58               if     num-entries(iEventParam,"#") > 2
       59                  and entry (3, iEventParam,"#") ne "?"
       60               then assign
       61                   label3:text    = entry (3, iEventParam,"#")
       62                   label3:visible = yes
       63               .
       64               else assign
       65                   label3:visible      = no
       66               .
       67           end.
       68           if iEvent eq "CritOneLableCode" then do:
       69             label1:Visible = false .
       70             label2:Visible = true .
       71             label3:Visible = false .
       72             textBox1:Visible = false .
       73             textBox2:Visible = true .
       74             label2:text = iEventParam .
       75           end.
       76           if iEvent eq "NotOneLable" then do:
       77             label1:Visible = false .
       78             label2:Visible = false .
       79             label3:Visible = false .
       80             textBox1:Visible = false .
       81             textBox2:Visible = false .
       82           end.
       83           if iEvent eq "swapCritAndDiscont"
       84           then do:
       85               this-object:tableLayoutPanel3:Controls:Remove(this-object:textBox1).
       86               this-object:tableLayoutPanel3:Controls:Remove(this-object:textBox2).
       87               this-object:tableLayoutPanel3:Controls:Add(this-object:textBox2, 1, 0).
       88               this-object:tableLayoutPanel3:Controls:Add(this-object:textBox1, 3, 0).
       89           end.
       90       end.
