      349     define property Msg as character no-undo
      350       get.
      351       set.
      352       define property StatusErr as logical no-undo
      353       get:
      354         def var err as log no-undo.
      355         err = StatusErr.
      356         StatusErr = false.
      357         return err.
      358       end.
      359       private set.
      360     define property ID as int64  no-undo
      361       get.
      362       set (ID-arg as int64):
      363         ID = ID-arg.
      364       end.
      365     define property idCrit as int64 no-undo
      366       get.
      367       SET (arg as int64):
      368         if arg <> idCrit
      369         then do:
      370           idCrit = arg.
      371           setFlagChange (true).
      372         end.
      373       END.
      374     define property idAction as int64 no-undo
      375       get.
      376       set(arg as int64):
      377         if arg <> idAction
      378         then do:
      379           idAction = arg.
      380           setFlagChange (true).
      381         end.
      382       END.
      383     define property db-num as integer  no-undo
      384       get.
      385       set(arg as integer ):
      386         if arg <> db-num
      387         then do:
      388           db-num = arg.
      389           setFlagChange (true).
      390         end.
      391       end.
      392     define property GdsCode as integer no-undo
      393       get.
      394       set(arg as integer):
      395         if arg <> GdsCode
      396         then do:
      397           GdsCode = arg.
      398           setFlagChange (true).
      399         end.
      400       END.
      401     define property objCode as integer no-undo
      402       get.
      403       set.
      404       define buffer bf_gds for ub.goods.
      405       define property GdsName as character no-undo
      406       get:
      407         if available (bf_gds)
      408         then do:
      409           return bf_gds.gds-name.
      410         end.
      411         else do:
      412           find first bf_gds no-lock
      413             where bf_gds.gds-code = GdsCode no-error.
      414           if available (bf_gds)
      415           then do:
      416             return bf_gds.gds-name.
      417           end.
      418           else return "".
      419         end.
      420       end.
      421       define property dtSeason as character no-undo
      422       get:
      423         define variable typeAttr as character no-undo.
      424         if not available (bf_gds) then
      425         do:
      426           find first bf_gds no-lock
      427             where bf_gds.gds-code = GdsCode no-error.
      428         end.
      429         if available (bf_gds) then
      430         do:
      431             return
      432               gdsoattr-value(
      433                 'dt-seasons':U,
      434                 gdsCode,
      435                 'маг':U,
      436                 objCode,
      437                 output typeAttr
      438               ).
      439         end.
      440         else return "".
      441       end.
      442       define property qnty as dec no-undo
      443       get.
      444       set(arg as dec):
      445         if arg <> qnty
      446         then do:
      447           qnty = arg.
      448           setFlagChange (true).
      449         end.
      450       END.
      451       define property mess as char no-undo
      452       get.
      453       set(arg as char):
      454         if arg <> mess
      455         then do:
      456           mess = arg.
      457           setFlagChange (true).
      458         end.
      459       END.
      460       define property mess-gks as char no-undo
      461       get.
      462       set(arg as char):
      463         if arg <> mess-gks
      464         then do:
      465           mess-gks = arg.
      466           setFlagChange (true).
      467         end.
      468       END.
      469       define property Mode as char no-undo init 'и':U
      470       get.
      471       set.
      472       define property Changed as logical no-undo
      473       get.
      474       set.
      475     constructor public promogiftsub (  ):
      476     end constructor.
      477     method public void setMsg( arg as character ):
      478       Msg = arg.
      479     end.
      480     method public void setStatusErr( arg as logical ):
      481       StatusErr = arg.
      482     end.
      483     method public void setFlagChange( arg as logical ):
      484       Changed = arg.
      485     end.
      486   end class.
