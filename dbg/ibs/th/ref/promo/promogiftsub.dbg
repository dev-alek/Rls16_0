      327   method public integer gds-attr_check-code-dt-seasons (
      328     input  p-code     like ub.goods.gds-code,
      329     input  p-obj-type like ub.clients.obj-type,
      330     input  p-obj-code like ub.clients.obj-code,
      331     output p-gds-code like ub.goods.gds-code
      332     ):
      333     define variable p-dt-code as integer no-undo .
      334     do:
      335           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr_check-code-dt-seasons in ibs.th.gbl.gbl-hndllib:g#attr-lib
      336         (input p-code
      337         ,input p-obj-type
      338         ,input p-obj-code
      339         ,output p-gds-code
      340         ,output p-dt-code
      341         ) no-error .
      342       if error-status :error
      343       then do:
      344         undo, return error return-value .
      345       end.
      346     end.
