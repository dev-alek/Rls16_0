      851     method public void editOnePromo () :
      852       define variable vFlag as logical no-undo.
      853   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   do:
      855     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      856       (input  ibs.th.gbl.gbl-var:g#db-num
      857       ,input  ibs.th.gbl.gbl-var:g#userid
      858       ,input  0
      859       ,input  'actn_action-edit_firm':U
      860       ,input  'firm':U
      861       ,input  v-host-code
      862       ,input  '':U
      863       ,input  0
      864       ,input  0
      865       ,input  0
      866       ,input  0
      867       ,input  true
      868       ,output vFlag
      869       )  .
      870   end.
      871     if     vFlag
      872        and available tt-promoaction
      873     then do:
      874       if refPromoMark() then        message "Правила акции нарушают закон о маркировке продукции. Редактирование не возможно."
      875          view-as alert-box.
      876       else do:
      877       refOnePromo().
      878       if  v-obj-date > tt-promoaction.end-date
      879       then
      880          message "Акция завершена. Редактирование не возможно"
      881          view-as alert-box.
      882       else if     tt-promoaction.status_ eq 2
      883       then
      884          message "Редактирование не возможно"
      885          view-as alert-box.
      886       else do:
      887         if tt-promoaction.status_ eq 1
      888         then do:
      889           if     v-obj-date ne ?
      890              and v-obj-date >= tt-promoaction.beg-date
      891           then do:
      892   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   do:
      894     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      895       (input  v-cntxt-db-num
      896       ,input  v-cntxt-userid
      897       ,input  0
      898       ,input  'actn_action-edit_firm':U
      899       ,input  'firm':U
      900       ,input  v-host-code
      901       ,input  '':U
      902       ,input  0
      903       ,input  0
      904       ,input  0
      905       ,input  0
      906       ,input  true
      907       ,output vFlag
      908       )  .
      909   end.
      910             if vFlag
      911             then do:
      912                assign
      913                  this-object:ModeView = yes
      914                  this-object:ModeEarlyTermination = yes
      915                .
      916                formOnePromo ('ИЗМЕНЕНИЕ':U) .
      917              end.
      918            end.
      919            else
      920              message "Редактирование не возможно"
      921                 view-as alert-box.
      922         end.
      923         else
      924            formOnePromo ('ИЗМЕНЕНИЕ':U) .
      925       end.
      926       end.
      927     end.
      928     end method .
      929     method public void editOnePromoStatus () :
      930       define variable vFlag as logical no-undo.
      931   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   do:
      933     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      934       (input  ibs.th.gbl.gbl-var:g#db-num
      935       ,input  ibs.th.gbl.gbl-var:g#userid
      936       ,input  0
      937       ,input  'actn_action-end_firm':U
      938       ,input  'firm':U
      939       ,input  v-host-code
      940       ,input  '':U
      941       ,input  0
      942       ,input  0
      943       ,input  0
      944       ,input  0
      945       ,input  true
      946       ,output vFlag
      947       )  .
      948   end.
      949       if vFlag
      950       then do:
      951          this-object:ModeView = yes.
      952          this-object:ModeChangeStatus = yes.
      953          formOnePromo ('ИЗМЕНЕНИЕ':U) .
      954       end.
      955     end method .
      956      method public void DelOnePromo () :
      957       define variable vFlag as logical no-undo.
      958       define variable v-sub   as class promoActionsub no-undo .
      959   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   do:
      961     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      962       (input  ibs.th.gbl.gbl-var:g#db-num
      963       ,input  ibs.th.gbl.gbl-var:g#userid
      964       ,input  0
      965       ,input  'actn_action-edit_firm':U
      966       ,input  'firm':U
      967       ,input  v-host-code
      968       ,input  '':U
      969       ,input  0
      970       ,input  0
      971       ,input  0
      972       ,input  0
      973       ,input  true
      974       ,output vFlag
      975       )  .
      976   end.
      977     if     vFlag
      978        and available tt-PromoAction
      979     then do:
      980       refOnePromo().
      981       if tt-PromoAction.status_ ne 0
      982       then
      983          message "Удалять акции можно только в статусе настройка"
      984          view-as alert-box.
      985       else do:
      986         v-sub = cast(tt-PromoAction.sub, promoActionSub) .
      987         message
      988            "Вы точно точно хотите удалить акцию "  v-sub:NameAction "?"
      989         view-as alert-box question buttons OK-Cancel update vFlag.
      990         if vFlag
      991         then do:
      992            v-sub:Mode = 'у':U.
      993            m-storage:deleteDB(v-sub) .
      994            getListTable().
      995         end.
      996       end.
      997     end.
      998     end method .
      999     method private void refOnePromo ():
     1000       define variable v-sub   as class promoActionsub no-undo .
     1001       v-sub = cast(tt-promoaction.sub, ibs.th.ref.promo.PromoActionSub) .
     1002       m-storage:refreshObj(v-sub).
     1003       assign
     1004          tt-promoaction.id          = v-sub:ID
     1005          tt-PromoAction.db-num      = v-sub:db-num
     1006          tt-PromoAction.changeDate  = v-sub:changeDate
     1007          tt-PromoAction.comment     = v-sub:comment
     1008          tt-PromoAction.description = v-sub:description
     1009          tt-PromoAction.ext-code    = v-sub:ext-code
     1010          tt-PromoAction.paymenttype = v-sub:paymenttype
     1011          tt-PromoAction.priority    = v-sub:priority
     1012          tt-PromoAction.status_     = v-sub:status_
     1013          tt-PromoAction.status_lbl  = v-sub:status_lbl
     1014          tt-promoaction.beg-date    = v-sub:beg-date
     1015          tt-promoaction.end-date    = v-sub:end-date
     1016          tt-promoaction.methodCalc  = v-sub:methodCalc
     1017          tt-promoaction.mode        = v-sub:Mode
     1018          tt-promoaction.nameAction  = v-sub:nameAction
     1019          tt-promoaction.typecond    = v-sub:typecond
     1020          tt-promoaction.TypeDiscont = v-sub:TypeDiscont
     1021        .
     1022     end.
     1023     method public void formOnePromo (input  p-mode as character) :
     1024     define variable v-sub   as class promoActionsub no-undo .
     1025         dataset ds-promoaction-one:empty-dataset ( ) .
     1026         if (  p-mode eq 'ДОБАВЛЕНИЕ':U
     1027            or p-mode eq 'ИЗМЕНЕНИЕ':U )
     1028            and  chek1CERP ()
     1029         then
     1030            undo, throw new Progress.Lang.AppError("Создание/изменение акций невозможно при интеграции с 1С-ERP") .
     1031        if p-mode = 'ИЗМЕНЕНИЕ':U and refPromoMark() then
     1032           undo, throw new Progress.Lang.AppError("Создание/изменение акции невозможно. Правила акции нарушают закон о маркировке продукции.") .
     1033         // вызвать в storage создание экземпляра класса sub и его заполнение или инициализацию
     1034         if p-mode eq 'ДОБАВЛЕНИЕ':U and not modecopy then do:
     1035            v-sub = new promoActionsub().
     1036            v-sub:refreshChildObj().
     1037            end.
     1038         else do:
     1039           if available tt-promoaction then do:
     1040             if p-mode eq 'ИЗМЕНЕНИЕ':U and tt-promoaction.ext-code ne "" then
     1041               undo, throw new Progress.Lang.AppError("Акция заведена во внешней системе. Редактирование запрещено.") .
     1042             refOnePromo().
     1043             v-sub = cast(tt-promoaction.sub, ibs.th.ref.promo.PromoActionSub) .
     1044              if modecopy
     1045                 then
     1046              do:
     1047                 v-sub = this-object:m-storage:CopyObject(v-sub).
     1048                 if refPromoMark() then
     1049                    undo, throw new Progress.Lang.AppError("Создание/изменение акции невозможно. Правила акции нарушают закон о маркировке продукции.") .
     1050              end.
     1051             else
     1052                v-sub:refreshChildObj().
     1053           end .
     1054           else do:
     1055             undo, throw new Progress.Lang.AppError("отсутствует промоакция для отображения в форме ввода") .
     1056           end .
     1057         end .
     1058         // перелить этот класс в таблицы редактируемого dataset
     1059         createDsForAction(p-mode, v-sub).
     1060         find first tt-promoaction-one no-error.
     1061         if not available tt-promoaction-one then
     1062           undo, throw new Progress.Lang.AppError("отсутствует набор данных для формы ввода") .
     1063         //if ModeView then p-mode = {&lookup}.
     1064         do trans:
     1065            dialog1 = new ibs.th.ref.promo.dPromoActions(p-mode, this-object).
     1066            dialog1:viewpage6(tt-promoaction-one.methodCalc ne 7 and not tt-PromoAction-one.TypeDiscontvisa).
     1067            dialog1:prepareobj(). //input-output dataset ds-promoaction-one by-reference) .
     1068         // для просмотра убрать кнопку "Ок", написать гашение полей, сравнить активность полей для создания и для редактирования
     1069            dialog1:ShowModalDialog().
     1070            if dialog1:DialogResult = System.Windows.Forms.DialogResult:Ok then do:
     1071           // изменённый dataset с описанием акции из v-dialog1 хранится тут;
     1072           // перенести значение из таблиц DataSet'а в классы описания акции
     1073   
     1074              if p-mode ne 'ПРОСМОТР':U
     1075              then
     1076                 updateObjForAction(). // - обновляет класс в tt-PromoAction-one.sub
     1077   
     1078           // и передать класс(ы) в storage на insert-row, и затем на update-row
     1079   
     1080                 v-sub = cast(tt-PromoAction-one.sub, promoActionSub) .
     1081           
     1082           /*if v-sub:Changed then*/ do:
     1083               if v-sub:ID > 0 then m-storage:updateDB(v-sub) .
     1084                               else m-storage:insertDB(v-sub) .
     1085            end .
     1086            if p-mode ne 'ДОБАВЛЕНИЕ':U
     1087            then
     1088               refOnePromo().
     1089         end .
     1090         if p-mode eq 'ДОБАВЛЕНИЕ':U
     1091         then
     1092            delete object v-sub.
     1093      end.
     1094     return.   
     1095     define variable v-err-msg as character no-undo .  
     1096     catch exAppErrors as class Progress.Lang.AppError :
     1097       v-err-msg = exAppErrors:ReturnValue .
     1098       if v-err-msg > "" then . else do :
     1099         v-err-msg = exAppErrors:GetMessage(1) .
     1100         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\promo\promo_trg.cls" .
     1101       end .
     1102       message v-err-msg view-as alert-box.
     1103     end catch .
     1104     catch exProErrors as class Progress.Lang.ProError :
     1105       v-err-msg = exProErrors:GetMessage(1) . 
     1106       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\promo\promo_trg.cls" .
     1107       message "ProError" skip(1) v-err-msg skip exProErrors:CallStack view-as alert-box.
     1108     end catch .
     1109     catch exAnyErrors as class Progress.Lang.Error:
     1110       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\promo\promo_trg.cls " + exAnyErrors:GetMessage(1).
     1111       message "LangError" skip(1) v-err-msg skip exAnyErrors:CallStack view-as alert-box.
     1112     end catch .
     1113     finally:
     1114         // оставлять диалог пока не получается: при повторном запуске указатель валидный, но сам объект disposed
     1115   
     1116         this-object:ModeView         = no.
     1117         this-object:ModeChangeStatus = no.
     1118         this-object:ModeEarlyTermination = no.
     1119         this-object:modecopy             = no.
     1120         CleanQuery("promoActionAll,promoActionStatus").
     1121         if valid-object(dialog1) then delete object dialog1 .
     1122         
     1123       end finally .
     1124     end method. // end_of getOnePromo
