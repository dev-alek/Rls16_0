     2164     method public void UpdateObjForSchedw0
     2165     ( input  p-subs    as class promoSchedwSubs
     2166     ) :
     2167       define variable v-sub   as class promoSchedwSub no-undo.
     2168       define variable v-subd  as class promoSchedwSub no-undo.
     2169       define variable vi      as integer no-undo .
     2170       define variable v-days  as character no-undo .
     2171       define variable v-itimebeg as integer no-undo .
     2172       define variable v-itimeend as integer no-undo .
     2173       define variable v-temp-id  as integer no-undo .
     2174       define variable v-dtimebeg as datetime no-undo .
     2175       define variable v-dtimeend as datetime no-undo .
     2176       /* для простого расписания на одна запись в temp-table распределяется в коллекцию так:
     2177          - первая строка в коллекции обновляется, согласно отображению на экране;
     2178          - остальным строчкам коллекции проставляется delete
     2179       */
     2180   /*    
     2181   define variable dsXmlFileName as character no-undo .
     2182   dsXmlFileName = substitute("&1.xml", "a1-promo-schedule-week").
     2183   temp-table tt-promo-schedule-week:WRITE-XML ( "FILE", dsXmlFileName, true, "UTF-8").
     2184   */
     2185       
     2186       for first tt-promo-schedule-week:
     2187         v-days = "".
     2188         assign
     2189           v-days = v-days + ",1" when tt-promo-schedule-week.isday_mon
     2190           v-days = v-days + ",2" when tt-promo-schedule-week.isday_tue
     2191           v-days = v-days + ",3" when tt-promo-schedule-week.isday_wed
     2192           v-days = v-days + ",4" when tt-promo-schedule-week.isday_thu
     2193           v-days = v-days + ",5" when tt-promo-schedule-week.isday_fri
     2194           v-days = v-days + ",6" when tt-promo-schedule-week.isday_sat
     2195           v-days = v-days + ",7" when tt-promo-schedule-week.isday_sun
     2196         .
     2197         v-days = substring(v-days, 2) .
     2198         if v-days eq "1,2,3,4,5,6,7"
     2199         then v-days = "0".
     2200         
     2201         roundDtime (0, tt-promo-schedule-week.dtime-beg, tt-promo-schedule-week.dtime-end,
     2202              output v-temp-id,
     2203              output v-itimebeg, output v-itimeend,
     2204              output v-dtimebeg, output v-dtimeend) .
     2205         if valid-object(p-subs) then do :
     2206           vi = p-subs:GetItem(1) .
     2207           if vi > 0 then do :
     2208             v-sub = p-subs:promoSchedwObjCurr .
     2209             do vi = 2 to p-subs:GetItem(vI):
     2210               v-subd = p-subs:promoSchedwObjCurr .
     2211               v-subd:Mode = 'у':U .
     2212             end .
     2213           end .
     2214           else do:
     2215             v-sub = new promoSchedwSub().
     2216             p-subs:AddItem(v-sub).
     2217             assign
     2218               v-sub:Mode    = 'с':U
     2219             . 
     2220           end.
     2221           assign
     2222             v-sub:timebeg  = v-itimebeg 
     2223             v-sub:timeend  = v-itimeend
     2224             v-sub:wdaylist = v-days
     2225           .
     2226         end .
     2227         else do :
     2228           // если расписания не было - то пишем его только если что-нибудь поменялось
     2229   
     2230          // if (v-days <> "0") or (v-itimebeg <> 0) or (v-itimeend <> 86340) then do :
     2231   
     2232             v-sub = new promoSchedwSub().
     2233             assign
     2234               v-sub:timebeg  = v-itimebeg 
     2235               v-sub:timeend  = v-itimeend
     2236               v-sub:wdaylist = v-days
     2237               v-sub:Mode     = 'с':U
     2238             .
     2239             p-subs = new promoSchedwSubs().
     2240             p-subs:AddItem(v-sub).
     2241          // end .
     2242   
     2243         end .
     2244         
     2245       end.
     2246           
     2247     end method. // end_of_UpdateObjForSchedw0
     2248   
     2249   
     2250     method public void UpdateObjForSchedw1
     2251     ( input  p-subs    as class promoSchedwSubs
     2252     ) :
     2253       define variable v-sub   as class promoSchedwSub no-undo.
     2254       define variable v-suba  as class promoSchedwSub no-undo.
     2255       define variable vi      as integer no-undo .
     2256       define variable v-ancorValid as logical no-undo .
     2257       define variable v-ancorOut   as logical no-undo .
     2258       define variable v-temp-id    as integer no-undo .
     2259       define variable v-dtimebeg   as datetime no-undo .
     2260       define variable v-dtimeend   as datetime no-undo .
     2261       define variable v-itimebeg   as integer no-undo .
     2262       define variable v-itimeend   as integer no-undo .
     2263   
     2264       /* если до этого расписания в акции не было - сливаем его как есть из tt-promo-schedule-week2 */
     2265       if not valid-object (p-subs) then p-subs = new promoSchedwSubs().
     2266       
     2267       // 1. из коллекции удалить все дни, кроме якорного (т.е. где id = promosched-id)
     2268   
     2269       v-ancorValid = false .
     2270       do vi = 1 to p-subs:GetItem(vI):
     2271         v-sub = p-subs:promoSchedwObjCurr .
     2272         if v-sub:ID = v-sub:schedId then assign
     2273           v-suba = v-sub
     2274           v-ancorValid = true
     2275         .
     2276         else v-sub:Mode = 'у':U .
     2277       end .
     2278   
     2279       // 2. якорную запись коллекции (если коллекцияя была непустая) обновить,
     2280   
     2281       //    остальные запись из tt-promo-schedule-week2 добавить
     2282   
     2283       if v-ancorValid then do :
     2284         // если якорная запись присутствует в tt-promo-schedule-week2 - обновить её
     2285   
     2286         // иначе взять любую другую и обновить ею.
     2287   
     2288         v-ancorOut = false .
     2289         for each tt-promo-schedule-week2:
     2290           if tt-promo-schedule-week2.id = v-suba:Id then do :
     2291             roundDtime (0, tt-promo-schedule-week2.dtime-beg, tt-promo-schedule-week2.dtime-end,
     2292               output v-temp-id,
     2293               output v-itimebeg, output v-itimeend,
     2294               output v-dtimebeg, output v-dtimeend) .
     2295             assign
     2296               v-suba:timebeg  = v-itimebeg
     2297               v-suba:timeend  = v-itimeend
     2298               v-suba:wdaylist = substitute(  "&1",  tt-promo-schedule-week2.wdaynum  )
     2299             .
     2300             delete tt-promo-schedule-week2 .
     2301             v-ancorOut = true .
     2302             leave .
     2303           end .
     2304         end .
     2305         if not v-ancorOut then for first tt-promo-schedule-week2:
     2306             roundDtime (0, tt-promo-schedule-week2.dtime-beg, tt-promo-schedule-week2.dtime-end,
     2307               output v-temp-id,
     2308               output v-itimebeg, output v-itimeend,
     2309               output v-dtimebeg, output v-dtimeend) .
     2310             assign
     2311               v-suba:timebeg  = v-itimebeg
     2312               v-suba:timeend  = v-itimeend
     2313               v-suba:wdaylist = substitute(  "&1",  tt-promo-schedule-week2.wdaynum  )
     2314             .
     2315             delete tt-promo-schedule-week2 .
     2316         end .
     2317       end . // end_of v-ancorValid
     2318   
     2319       
     2320       for each tt-promo-schedule-week2:
     2321         // записи добавленные в tt-promo-schedule-week2 из формы ввода имеют отрицательный id и округлённое время
     2322   
     2323         // записи, загруженные из БД, имеют положительный id и округлённое время
     2324   
     2325         v-sub = new promoSchedwSub().
     2326         p-subs:AddItem(v-sub).
     2327         roundDtime (0, tt-promo-schedule-week2.dtime-beg, tt-promo-schedule-week2.dtime-end,
     2328              output v-temp-id,
     2329              output v-itimebeg, output v-itimeend,
     2330              output v-dtimebeg, output v-dtimeend) .
     2331         assign
     2332           v-sub:db-num  = tt-promo-schedule-week2.db-num
     2333           v-sub:schedId = tt-promo-schedule-week2.promosched-id
     2334           v-sub:Mode    = 'с':U
     2335           v-sub:timebeg  = v-itimebeg
     2336           v-sub:timeend  = v-itimeend
     2337     //      v-sub:wdaylist = substitute(  "&1",  lookup(tt-promo-schedule-week2.wdaylabel, g-week-days) )
     2338   
     2339           v-sub:wdaylist = substitute(  "&1",  tt-promo-schedule-week2.wdaynum  )
     2340         .
     2341       end .
     2342       
     2343     end method. // end_of_UpdateObjForSchedw1
     2344   
     2345   
