     2979       method  public logical chek1CERP(): 
     2980          define variable conf-par as character no-undo.
     2981          define variable mode-erprn as logical no-undo.
     2982          define variable par-type as character no-undo.
     2983          /*
     2984   
     2985   $Revision$
     2986   $Author$
     2987   $Date$
     2988   $Workfile$
     2989   $Archive$
     2990   
     2991   Чтение параметров конфигурации для текущей БД
     2992   
     2993   Автор: Уханов Дмитрий Юрьевич
     2994   Дата создания: 03/22/00
     2995   Author: Dmitry Ukhanov
     2996   Creation date: 03/22/00
     2997   
     2998   */
     2999   /*
     3000   Возвращаемые значения:
     3001     p-value: значение параметра
     3002     p-type:  тип параметра
     3003       {&type-char}
     3004       {&type-log}
     3005       {&type-dec}
     3006       {&type-int}
     3007       {&type-date}
     3008   
     3009   Сначала ищется запись config с указанным параметрами,
     3010   если запись не найдена, то производится поиск записи config
     3011   только по параметру p-code (общесистемной настройки).
     3012   
     3013   Для config, привязанных к объекту,
     3014   производится поиск настройки по объекту,
     3015   Если отсутствует настройка по объекту, то производится поиск настройки по фирме
     3016   Если отсутствует настройка по объекту, то производится поиск глобальной настройки
     3017   
     3018   */
     3019   run conf-rd in ibs.th.gbl.gbl-hndllib:g#library
     3020     (input  'is-erpRN'  /* p-code  */
     3021     ,input  0  /* h-code  */
     3022     ,input  ''  /* o-type  */
     3023     ,input  0  /* o-code  */
     3024     ,input  ''  /* не используется */
     3025     ,input  ''  /* не используется */
     3026     ,input  ''  /* не используется */
     3027     ,input  NO  /* msg-on  */
     3028     ,output conf-par  /* p-value */
     3029     ,output par-type /* p-type  */
     3030     ) no-error .
     3031   /* $Workfile$ e n d */
     3032    
     3033          if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
     3034          else mode-erprn = no.
     3035          
     3036          return mode-erprn .
     3037       end method.
     3038   
     3039      method private logical refPromoMark ():
     3040         define variable v-sub as class promoActionsub no-undo .
     3041         define buffer buf_PromoGift  for ub.PromoGift .
     3042         define buffer buf_PromoGoods for ub.PromoGoods .
     3043         define buffer buf_goods-attr for ub.goods-attr .
     3044         define variable v-ban-recipes as logical no-undo .
     3045         v-sub = cast(tt-promoaction.sub, ibs.th.ref.promo.PromoActionSub) .
     3046         m-storage:refreshObj(v-sub).
     3047         define variable ObjSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3048       
     3049       run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3050      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true . 
     3051      if v-ban-recipes then do:
     3052   /*      for each buf_PromoGoods no-lock where buf_PromoGoods.idAction = v-sub:ID and buf_PromoGoods.db-num = v-sub:db-num:*/
     3053   /*         if can-find (first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_PromoGoods.gds-code and          */
     3054   /*            buf_goods-attr.attr-code = {&attr-mark-type} and buf_goods-attr.attr-value <> "not-type" and                */
     3055   /*            buf_goods-attr.attr-value <> "") then                                                                       */
     3056   /*         do:                                                                                                            */
     3057   /*            return true.                                                                                                */
     3058   /*         end.                                                                                                           */
     3059   /*      end.                                                                                                              */
     3060         for each buf_PromoGift no-lock where buf_PromoGift.idaction = v-sub:ID and buf_PromoGift.db-num = v-sub:db-num:
     3061            if can-find (first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_PromoGift.gds-code and 
     3062               buf_goods-attr.attr-code = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" and 
     3063               buf_goods-attr.attr-value <> "") then 
     3064            do:
     3065               return true.
     3066            end.         
     3067         end.  
     3068      end.
     3069      else return false .      
     3070      end.
     3071      
     3072     
     3073   end class .
