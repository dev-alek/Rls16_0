      826     method public void BrwPromoAction () :
      827       define variable v-listact-brw as class ibs.th.ref.promo.wListActions no-undo .
      828     v-listact-brw = new ibs.th.ref.promo.wListActions (input this-object
      829     //, input table tt-promoaction by-reference
      830     ).
      831         .
      832    //  v-listact-brw:SetPromoTrg(this-object ).
      833     wait-for System.Windows.Forms.Application:Run ( v-listact-brw ) .
      834     finally:
      835       if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
      836     end finally.
      837     end method .
