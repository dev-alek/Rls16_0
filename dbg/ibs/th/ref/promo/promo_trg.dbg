     1127     method public void histOnePromo () :
     1128     define variable v-rid-list as character no-undo.
     1129     
     1130       if available tt-promoaction then do:
     1131         run ref/cpromo.w (
     1132                       input '':U /*bttns*/
     1133                      ,input 'one':U /*p-mode*/
     1134                      ,input /* X_wth-place.obj-type */ ''
     1135                      ,input /* X_wth-place.obj-code */ 0
     1136                      ,INPUT tt-promoaction.id
     1137                      ,INPUT-OUTPUT v-rid-list) .
