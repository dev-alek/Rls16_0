     1647   
     1648     // отрезает секунды и милисекунды от value из dateTimePicker
     1649   
     1650     method private void roundDtime (
     1651       input  p-wdaynum   as integer 
     1652     , input  p-dtimebeg1 as datetime
     1653     , input  p-dtimeend1 as datetime
     1654     , output p-temp-id   as integer
     1655     , output p-itimebeg2 as integer
     1656     , output p-itimeend2 as integer
     1657     , output p-dtimebeg2 as datetime
     1658     , output p-dtimeend2 as datetime
     1659     ) :
     1660       assign
     1661         p-itimebeg2 = integer( truncate(  mtime(p-dtimebeg1) / 1000 / 60,  0  ) ) 
     1662         p-itimeend2 = integer( truncate(  mtime(p-dtimeend1) / 1000 / 60,  0  ) )
     1663       .
     1664       // в id время кладётся минутами, иначе не хватит разрядности
     1665   
     1666       p-temp-id = (-1) *
     1667       (
     1668             100000000 * p-wdaynum
     1669               + 10000 * p-itimebeg2 
     1670                       + p-itimeend2
     1671       ) no-error.
     1672       assign
     1673         p-itimebeg2 = p-itimebeg2 * 60
     1674         p-itimeend2 = p-itimeend2 * 60
     1675         p-dtimebeg2 = datetime (today, p-itimebeg2 * 1000)
     1676         p-dtimeend2 = datetime (today, p-itimeend2 * 1000)
     1677       .
     1678     end method . // end_of roundDtime
     1679   
     1680     method public void CreateTableForSchedw0
     1681     ( input  p-mode as character
     1682     , input  p-subs as class promoschedwsubs
     1683     ) :
     1684       define variable vI as int no-undo.
     1685       define variable v-i-counter as integer no-undo .
     1686       define variable v-sub as promoschedwsub no-undo .
     1687       // if p-mode = {&add-def} then temp-table tt-PromoGift:tracking-changes = true . 
     1688   
     1689       create tt-promo-schedule-week.
     1690       
     1691     if valid-object(p-subs) then do:
     1692       v-i-counter = p-subs:iCounter .
     1693       if v-i-counter > 0 then do :
     1694       do vi = 1 to p-subs:GetItem(vI):
     1695           v-sub = p-subs:promoSchedwObjCurr .
     1696           assign
     1697             tt-promo-schedule-week.db-num = v-sub:db-num
     1698             tt-promo-schedule-week.promosched-id = v-sub:schedId
     1699             // время начала и окончания приходит из БД округлённое, без секунд
     1700   
     1701             tt-promo-schedule-week.timebeg   = v-sub:timebeg
     1702             tt-promo-schedule-week.timeend   = v-sub:timeend
     1703             tt-promo-schedule-week.dtime-beg = datetime (today, tt-promo-schedule-week.timebeg * 1000)
     1704             tt-promo-schedule-week.dtime-end = datetime (today, tt-promo-schedule-week.timeend * 1000)
     1705             tt-promo-schedule-week.sub    = v-sub when (v-sub:Id = v-sub:schedId)  
     1706           .
     1707           if p-mode = 'ДОБАВЛЕНИЕ':U 
     1708           then do:
     1709             tt-promo-schedule-week.promosched-id = m-local-sec.
     1710             tt-promo-schedule-week.mode          = 'с':U.
     1711             
     1712           end.   
     1713           tt-promo-schedule-week.wdaylist = tt-promo-schedule-week.wdaylist + substitute(",&1", v-sub:wdaylist) .
     1714       end.
     1715       assign
     1716         tt-promo-schedule-week.wdaylist = substring(tt-promo-schedule-week.wdaylist, 2)
     1717       .
     1718       end .
     1719     end. // end_of valid-object(subs)
     1720   
     1721     else v-i-counter = 0 .
     1722     
     1723     /* 09/VIII-2018 если расписания нет - акция действует постоянно.
     1724                     Частный случай: если расписания нет - оно рассматривается как ПРОСТОЕ, и мы приходим сюда. */
     1725     if v-i-counter = 0 then do :
     1726       assign
     1727         /* остались незаполненными:
     1728             tt-promo-schedule-week.db-num        = p-subs:promoSchedwObjCurr:db-num
     1729             tt-promo-schedule-week.promosched-id = p-subs:promoSchedwObjCurr:schedId
     1730             tt-promo-schedule-week.sub           = p-subs:promoSchedwObjCurr when (v-sub:Id = v-sub:schedId)  
     1731         */
     1732         tt-promo-schedule-week.dtime-beg = datetime (today, 0)
     1733         tt-promo-schedule-week.dtime-end = datetime (today, 86340 * 1000) // 86340 = 23:59
     1734   
     1735         tt-promo-schedule-week.wdaylist = "0"
     1736       .
     1737     end .
     1738     
     1739       assign
     1740         tt-promo-schedule-week.id        = tt-promo-schedule-week.promosched-id
     1741         tt-promo-schedule-week.isday_mon = can-do(tt-promo-schedule-week.wdaylist, "1") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1742         tt-promo-schedule-week.isday_tue = can-do(tt-promo-schedule-week.wdaylist, "2") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1743         tt-promo-schedule-week.isday_wed = can-do(tt-promo-schedule-week.wdaylist, "3") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1744         tt-promo-schedule-week.isday_thu = can-do(tt-promo-schedule-week.wdaylist, "4") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1745         tt-promo-schedule-week.isday_fri = can-do(tt-promo-schedule-week.wdaylist, "5") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1746         tt-promo-schedule-week.isday_sat = can-do(tt-promo-schedule-week.wdaylist, "6") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1747         tt-promo-schedule-week.isday_sun = can-do(tt-promo-schedule-week.wdaylist, "7") or can-do(tt-promo-schedule-week.wdaylist, "0")
     1748       .
     1749       // if p-mode = {&update} then temp-table tt-PromoGift:tracking-changes = true .
     1750   
     1751     end method. // end_of_CreateTableForSchedw0
     1752   
     1753   //  define private variable g-week-days as character no-undo initial
     1754   
     1755   //    "понедельник,вторник,среда,четверг,пятница,суббота,воскресенье" .
     1756   
     1757     method public void CreateTableForSchedw1
     1758     ( input  p-mode as character
     1759     , input  p-subs as class promoschedwsubs
     1760     ) :
     1761       define variable vI     as int no-undo.
     1762       define variable v-sub  as promoschedwsub no-undo .
     1763       define variable v-wdaylist as character no-undo .
     1764       define variable i-num  as integer no-undo .
     1765       define variable i-size as integer no-undo .
     1766       define variable s-wday as character no-undo .
     1767       define variable i-wday as integer no-undo .
     1768       define variable v-isFirst as logical no-undo .
     1769       define variable v-temp-id  as integer no-undo .
     1770       define variable v-itimebeg as integer no-undo .
     1771       define variable v-itimeend as integer no-undo .
     1772       define variable v-dtimebeg as datetime no-undo .
     1773       define variable v-dtimeend as datetime no-undo .
     1774       define variable v-dtimebeg2 as datetime no-undo .
     1775       define variable v-dtimeend2 as datetime no-undo .
     1776       
     1777       if valid-object(p-subs) then do:
     1778       // if p-mode = {&add-def} then temp-table tt-PromoGift:tracking-changes = true . 
     1779   
     1780       do vi = 1 to p-subs:GetItem(vI):
     1781           v-sub = p-subs:promoSchedwObjCurr .
     1782           
     1783           v-itimebeg = v-sub:timebeg .
     1784           v-itimeend = v-sub:timeend .
     1785           v-dtimebeg = datetime (today, v-itimebeg * 1000) .
     1786           v-dtimeend = datetime (today, v-itimeend * 1000) .
     1787           
     1788           v-wdaylist = v-sub:wdaylist .
     1789           i-size = num-entries (v-wdaylist) .
     1790           v-isFirst = true .
     1791           do i-num = 1 to i-size :
     1792             s-wday = entry(i-num, v-wdaylist) .
     1793             i-wday = integer(s-wday) no-error .
     1794             if i-wday > 0 then do :
     1795               roundDtime (i-wday, v-dtimebeg, v-dtimeend,
     1796                 output v-temp-id,
     1797                 output v-itimebeg, output v-itimeend,
     1798                 output v-dtimebeg2, output v-dtimeend2) .
     1799   
     1800               create tt-promo-schedule-week2 .
     1801               if v-isFirst then assign
     1802                 tt-promo-schedule-week2.sub = v-sub 
     1803                 tt-promo-schedule-week2.id  = v-sub:ID
     1804                 v-isFirst = false
     1805               .
     1806               else assign
     1807                 tt-promo-schedule-week2.id  = v-temp-id
     1808               .
     1809               assign
     1810                 tt-promo-schedule-week2.db-num        = v-sub:db-num
     1811                 tt-promo-schedule-week2.promosched-id = v-sub:schedId
     1812                 tt-promo-schedule-week2.dtime-beg = v-dtimebeg
     1813                 tt-promo-schedule-week2.dtime-end = v-dtimeend
     1814   //            tt-promo-schedule-week2.wdaylabel = entry(i-wday, g-week-days)
     1815   
     1816                 tt-promo-schedule-week2.wdaynum  = i-wday
     1817                 tt-promo-schedule-week2.wdaylist = s-wday
     1818               .
     1819               if p-mode = 'ДОБАВЛЕНИЕ':U 
     1820               then do:
     1821                 tt-promo-schedule-week2.promosched-id = m-local-sec.
     1822                 tt-promo-schedule-week2.mode          = 'с':U.
     1823               end.
     1824             end . // end_of i-wday>0
     1825   
     1826           end . // end_of do on wdaylist   
     1827   
     1828       end.
     1829       // if p-mode = {&update} then temp-table tt-PromoGift:tracking-changes = true .
     1830   
     1831       end. // end_of valid-object(subs)
     1832   
     1833     end method. // end_of_CreateTableForSchedw1
     1834   
     1835   
     1836   /* @NOTE 16/VIII-2018 копирование экземпляра класса:
     1837     https://knowledgebase.progress.com/articles/Article/000050150
     1838     How to clone a class object in OOABL?
     1839     (найдено через Google по строке "Clone method is undefined for the class. (13444) OpenEdge")  
     1840   */
     1841   /* 2.2 перенести temp-table в объект m-sub */
     1842     method public void UpdateObjForAction
     1843     ( 
     1844     ) :
     1845       define variable p-sub as class promoActionSub.
     1846       define variable v-sched-sub as class promoSchedSub no-undo .
     1847       for first tt-PromoAction-one:
     1848           
     1849           assign
     1850              p-sub                 = cast(tt-PromoAction-one.sub, promoActionSub)
     1851              p-sub:ID              = tt-PromoAction-one.id             
     1852              p-sub:db-num          = tt-PromoAction-one.db-num
     1853              p-sub:changeDate      = if tt-PromoAction-one.ChangDateFl then tt-PromoAction-one.changeDate else ?
     1854              p-sub:comment         = tt-PromoAction-one.comment
     1855              p-sub:description     = tt-PromoAction-one.description
     1856              p-sub:ext-code        = tt-PromoAction-one.ext-code
     1857              p-sub:priority        = tt-PromoAction-one.priority
     1858              p-sub:status_lbl      = tt-PromoAction-one.status_lbl
     1859              p-sub:beg-date        = tt-PromoAction-one.beg-date        
     1860              p-sub:end-date        = tt-PromoAction-one.end-date        
     1861              p-sub:methodCalclbl   = tt-PromoAction-one.methodCalclbl      
     1862              p-sub:Mode            = tt-PromoAction-one.mode           
     1863              p-sub:NameAction      = tt-PromoAction-one.nameAction      
     1864              p-sub:promosched-id   = tt-PromoAction-one.promosched-id   
     1865              p-sub:typecondlbl     = tt-PromoAction-one.typecondlbl        
     1866              p-sub:TypeDiscont     = if tt-PromoAction-one.TypeDiscontsolo then 1 else if tt-PromoAction-one.TypeDiscontcombo then 2 else 3
     1867              p-sub:CritgoodsFl     = tt-PromoAction-one.CritgoodsFl     
     1868              v-sched-sub           = p-sub:Schedule
     1869              
     1870            .
     1871            // даже если в акции отсутствовало расписание - здесь p-sub:Schedule уже есть всегда
     1872   
     1873            assign
     1874              v-sched-sub:dispname     = tt-PromoAction-one.scheduleName 
     1875              v-sched-sub:schedType    = if tt-PromoAction-one.scheduleType then 1 else 0
     1876              v-sched-sub:extCodeSched = tt-PromoAction-one.extCodeSched
     1877            .
     1878            case p-sub:status_enum :
     1879              when ibs.th.ref.promo.enum-promo-status:ensetting then /* выполняется настройка */
     1880                v-sched-sub:status_ = ibs.th.ref.promo.enum-sched-status:ensetting .
     1881              otherwise /* enactive = активна, encompleted = завершена */ 
     1882                v-sched-sub:status_ = ibs.th.ref.promo.enum-sched-status:enactive .
     1883            end case .
     1884            
     1885            // ?? переделать все на input-output ??
     1886   
     1887            updateObjForGoodsCrits(p-sub:GoodsCrits).
     1888            updateObjForGoodsAppl (p-sub:GoodsAppl ).
     1889            updateObjForCrite     (p-sub:Criterion ).
     1890            updateObjForGift      (p-sub:Gifts,0).
     1891            updateObjForObject    (p-sub:Objects).
     1892            updateObjForSET       (p-sub:PromoSet ).
     1893            updateObjForCards     (p-sub:CardsBin ).
     1894            updateObjForBC        (p-sub:BarCode ).
     1895            // ... а вот p-sub:ScheduleWeek могло и не быть. Особенно, если в акции отсутствовало расписание.
     1896   
     1897            if v-sched-sub:schedType = 0 then UpdateObjForSchedw0 (p-sub:ScheduleWeek).
     1898                                         else UpdateObjForSchedw1 (p-sub:ScheduleWeek).
     1899            define variable vstr as character no-undo.
     1900            for each tt-cashpay no-lock:
     1901                vstr = vstr 
     1902                     + chr(4) 
     1903                     + string(tt-cashpay.cdpay-code) 
     1904                     + chr(3) 
     1905                     + string(tt-cashpay.curr-code).
     1906            end.
     1907            assign
     1908               vstr                           = trim(vstr, chr(4) )
     1909               tt-PromoAction-one.paymenttype = vstr
     1910               p-sub:paymenttype              = tt-PromoAction-one.paymenttype
     1911            .                                 
     1912        end.
     1913     end method. // end_of_updateObjForAction
