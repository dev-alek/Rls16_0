     2354     method private character modeForm2Fun (input p-mode-form as character) :
     2355       define variable v-mode-fun as character no-undo .
     2356       case p-mode-form :
     2357         when 'ИЗМЕНЕНИЕ':U then v-mode-fun = 'и':U .
     2358                   otherwise v-mode-fun = 'с':U . // <= &add-def, &lookup
     2359   
     2360         // nothing => &h-delete
     2361   
     2362       end case .
     2363       return v-mode-fun .
     2364     end method .
     2365   
     2366     /* Т.к. на момент ввода расписания оно уже известно, то его многократное переключение лишнее.
     2367        Поэтому функционал переключения будет исключён при малейших проблемах.
     2368        16/VIII-2018 автоматическое создание расписания при переключении с ПРОСТОГО на ДЕТАЛЬНОЕ
     2369                     и с ДЕТАЛЬНОГО на ПРОСТОЕ отменено 
     2370     */
     2371     define private variable e-add-message as character no-undo .
     2372     define private variable e-ign-message as character no-undo .
     2373     define private variable e-has-inputs  as logical no-undo .
     2374     define private variable e-has-errors  as logical no-undo .
     2375     method public logical add2Detail(input p-bind-qname as character) :
     2376       define variable v-has-errors as logical no-undo .
     2377       define variable v-h-query  as handle no-undo .
     2378       define variable v-is-ok    as logical no-undo .
     2379         assign
     2380           e-add-message = substitute("Добавлены дни недели:&1", chr(10))
     2381           e-ign-message = substitute("Дни недели:&1", chr(10))
     2382           e-has-inputs  = false
     2383           e-has-errors  = false
     2384         .
     2385         // ...и снимать галочки на тот случай, если при добавлении будет ошибка и панель ввода останется на экране
     2386   
     2387         if tt-promo-schedule-week3.isday_mon then do :
     2388           v-has-errors = createDetail2 ("1", buffer tt-promo-schedule-week3) .
     2389           tt-promo-schedule-week3.isday_mon = v-has-errors .
     2390           e-has-errors = (e-has-errors or v-has-errors) .
     2391         end .
     2392         if tt-promo-schedule-week3.isday_tue then do :
     2393           v-has-errors = createDetail2 ("2", buffer tt-promo-schedule-week3) .
     2394           tt-promo-schedule-week3.isday_tue = v-has-errors .
     2395           e-has-errors = (e-has-errors or v-has-errors) .
     2396         end .
     2397         if tt-promo-schedule-week3.isday_wed then do :
     2398           v-has-errors = createDetail2 ("3", buffer tt-promo-schedule-week3) .
     2399           tt-promo-schedule-week3.isday_wed = v-has-errors .
     2400           e-has-errors = (e-has-errors or v-has-errors) .
     2401         end .
     2402         if tt-promo-schedule-week3.isday_thu then do :
     2403           v-has-errors = createDetail2 ("4", buffer tt-promo-schedule-week3) .
     2404           tt-promo-schedule-week3.isday_thu = v-has-errors .
     2405           e-has-errors = (e-has-errors or v-has-errors) .
     2406         end .
     2407         if tt-promo-schedule-week3.isday_fri then do :
     2408           v-has-errors = createDetail2 ("5", buffer tt-promo-schedule-week3) .
     2409           tt-promo-schedule-week3.isday_fri = v-has-errors .
     2410           e-has-errors = (e-has-errors or v-has-errors) .
     2411         end .
     2412         if tt-promo-schedule-week3.isday_sat then do :
     2413           v-has-errors = createDetail2 ("6", buffer tt-promo-schedule-week3) .
     2414           tt-promo-schedule-week3.isday_sat = v-has-errors .
     2415           e-has-errors = (e-has-errors or v-has-errors) .
     2416         end .
     2417         if tt-promo-schedule-week3.isday_sun then do :
     2418           v-has-errors = createDetail2 ("7", buffer tt-promo-schedule-week3) .
     2419           tt-promo-schedule-week3.isday_sun = v-has-errors .
     2420           e-has-errors = (e-has-errors or v-has-errors) .
     2421         end .
     2422       v-h-query = getQuery(p-bind-qname, no).
     2423       v-is-ok = v-h-query:QUERY-OPEN ( ).
     2424       v-has-errors = e-has-errors .
     2425       if v-has-errors then do :
     2426         if e-has-inputs then
     2427           e-add-message = e-add-message + chr(10) + e-ign-message 
     2428         .
     2429         else e-add-message = e-ign-message .
     2430         e-add-message = e-add-message + "содержат пересечение интервалов." .  
     2431         message e-add-message view-as alert-box.
     2432       end .
     2433       return v-has-errors .
     2434     end method .
     2435     method public void delFromDetail(input p-bind-qname as character) :
     2436       define variable v-h-query  as handle no-undo .
     2437       define variable v-is-ok    as logical no-undo .
     2438         if available tt-promo-schedule-week2 then
     2439           delete tt-promo-schedule-week2 .
     2440       v-h-query = getQuery(p-bind-qname, no).
     2441       v-is-ok = v-h-query:QUERY-OPEN ( ).
     2442     end method .
     2443     define private variable a-week-days as character extent 7 no-undo initial
     2444       ["понедельник","вторник","среда","четверг","пятница","суббота","воскресенье"] .
     2445     method private logical createDetail2 (input p-wday     as character,
     2446                                         buffer p-buf-week for tt-promo-schedule-week3) :
     2447       define variable i-wday     as integer no-undo .
     2448       define variable v-dtimebeg as datetime no-undo .
     2449       define variable v-dtimeend as datetime no-undo .
     2450       define variable v-temp-id  as integer no-undo .
     2451       define variable v-itimebeg as integer no-undo .
     2452       define variable v-itimeend as integer no-undo .
     2453       define variable v-has-err  as logical no-undo .
     2454       
     2455       i-wday = integer (p-wday) no-error .
     2456       if not error-status:error then do :
     2457         roundDtime (i-wday, p-buf-week.dtime-beg, p-buf-week.dtime-end,
     2458              output v-temp-id,
     2459              output v-itimebeg, output v-itimeend,
     2460              output v-dtimebeg, output v-dtimeend) .
     2461         // пересечение и касание времени в пределах дня
     2462   
     2463         if can-find (first tt-promo-schedule-week2
     2464                      where tt-promo-schedule-week2.wdaynum = i-wday
     2465                        and tt-promo-schedule-week2.dtime-beg <= v-dtimeend
     2466                        and tt-promo-schedule-week2.dtime-end >= v-dtimebeg 
     2467                     ) then do :
     2468           v-has-err = true .
     2469           e-ign-message = e-ign-message + substitute("&1(&2-&3)&4"
     2470           , a-week-days[i-wday]
     2471           , string(v-itimebeg, "hh:mm")
     2472           , string(v-itimeend, "hh:mm")
     2473           , chr(10)
     2474           ).
     2475           return v-has-err .                
     2476         end .
     2477         v-has-err = false .
     2478         if not can-find (first tt-promo-schedule-week2
     2479                          where tt-promo-schedule-week2.wdaynum = i-wday
     2480                            and tt-promo-schedule-week2.dtime-beg = v-dtimebeg
     2481                            and tt-promo-schedule-week2.dtime-end = v-dtimeend) then do :
     2482           create tt-promo-schedule-week2 .
     2483           tt-promo-schedule-week2.id = v-temp-id no-error.
     2484           if error-status:error then delete tt-promo-schedule-week2 . else do :
     2485             assign
     2486           tt-promo-schedule-week2.promosched-id = p-buf-week.promosched-id
     2487           tt-promo-schedule-week2.dtime-beg     = v-dtimebeg
     2488           tt-promo-schedule-week2.dtime-end     = v-dtimeend
     2489           tt-promo-schedule-week2.wdaylist      = p-wday
     2490           tt-promo-schedule-week2.wdaynum       = i-wday
     2491           tt-promo-schedule-week2.mode          = 'с':U
     2492             .
     2493             e-has-inputs  = true .
     2494             e-add-message = e-add-message + substitute("&1&2", a-week-days[i-wday], chr(10)).
     2495           end .
     2496         end .
     2497       end .
     2498       else v-has-err = true .
     2499       return v-has-err .
     2500     end method .
     2501     method public void delgds(input iName as character ):
     2502       case iName:
     2503          when "PromoGoodsAppl" 
     2504          then do:
     2505             if  tt-PromoGoodsAppl.mode eq 'с':U
     2506             then 
     2507                delete tt-PromoGoodsAppl.
     2508             else 
     2509                tt-PromoGoodsAppl.mode = 'у':U.
     2510          end. 
     2511          when "PromoGoodsCrit"
     2512          then do:
     2513             if  tt-PromoGoodsCrite.mode eq 'с':U
     2514             then 
     2515                delete tt-PromoGoodsCrite.
     2516             else 
     2517                tt-PromoGoodsCrite.mode = 'у':U.
     2518          end.  
     2519          when "PromoSet"
     2520          then do:
     2521             if  tt-PromoSet.mode eq 'с':U
     2522             then 
     2523                delete tt-PromoSet.
     2524             else 
     2525                tt-PromoSet.mode = 'у':U.
     2526          end.
     2527          when "PromoCardsBin"
     2528          then do:
     2529             if  tt-PromoCardsBin.mode eq 'с':U
     2530             then 
     2531                delete tt-PromoCardsBin.
     2532             else 
     2533                tt-PromoSet.mode = 'у':U.
     2534          end.  
     2535          when "PromoBarCode"
     2536          then do:
     2537             if  tt-PromoBC.mode eq 'с':U
     2538             then 
     2539                delete tt-PromoBC.
     2540             else 
     2541                tt-PromoBC.mode = 'у':U.
     2542          end.         
     2543          when "PromoSetGoods"
     2544          then do:
     2545             if  tt-PromoSetGoods.mode eq 'с':U
     2546             then 
     2547                delete tt-PromoSetGoods.
     2548             else 
     2549                tt-PromoSetGoods.mode = 'у':U.
     2550          end. 
     2551          when "PromoCriterion"
     2552          then do:
     2553             if  tt-PromoCriterion.mode eq 'с':U
     2554             then 
     2555                delete tt-PromoCriterion.
     2556             else 
     2557                tt-PromoCriterion.mode = 'у':U.
     2558          end. 
     2559          when "PromoObject"
     2560          then do:
     2561             if  tt-PromoObject.mode eq 'с':U
     2562             then 
     2563                delete tt-PromoObject.
     2564             else 
     2565                tt-PromoObject.mode = 'у':U.
     2566          end. 
     2567          when "PromoPay"
     2568          then do:
     2569             delete tt-CashPay.
     2570          end. 
     2571          when "PromoGift"
     2572          then do:
     2573            if  tt-PromoGift.mode eq 'с':U
     2574             then 
     2575                delete tt-PromoGift.
     2576             else 
     2577                tt-PromoGift.mode = 'у':U.
     2578             
     2579          end.
     2580          when "PromoCardsBin"
     2581          then do:
     2582            if  tt-PromoCardsBin.mode eq 'с':U
     2583             then 
     2584                delete tt-PromoCardsBin.
     2585             else 
     2586                tt-PromoCardsBin.mode = 'у':U.
     2587             
     2588          end.
     2589           
     2590                       
     2591       end case.
     2592     end.         
     2593   method public void printgds(input iName as character ):
     2594     define buffer buf_PromoBc for tt-PromoBc .
     2595     define buffer buf_PromoGoodsAppl for tt-PromoGoodsAppl .
     2596       case iName:
     2597          when "PromoBarCode" or when "PromoBarCodeFix" 
     2598          then do:
     2599            empty temp-table gds-list .
     2600         if not tt-PromoBc.Chang then do:
     2601                  find first ub.goods no-lock where
     2602                     ub.goods.gds-code = tt-PromoBc.gds-code no-error .
     2603                  create gds-list.
     2604                  buffer-copy goods to gds-list.
     2605                  assign
     2606                     gds-list.promo-code = tt-PromoBc.bc-code
     2607                     gds-list.ActionId   = tt-PromoBc.idAction
     2608                     gds-list.db-num     = tt-PromoBc.db-num
     2609                     .
     2610           end.
     2611           else do:
     2612             for each buf_PromoBc where buf_PromoBc.Chang:
     2613                  find first ub.goods no-lock where
     2614                     ub.goods.gds-code = buf_PromoBc.gds-code no-error .
     2615                  create gds-list.
     2616                  buffer-copy goods to gds-list.
     2617                  assign
     2618                     gds-list.promo-code = buf_PromoBc.bc-code
     2619                     gds-list.ActionId   = buf_PromoBc.idAction
     2620                     gds-list.db-num     = buf_PromoBc.db-num
     2621                     .           
     2622             end.
     2623           end.
     2624           run ibs/th/rep/tick-lst.p (input parparentproc, input v-cntxt-obj-type, input v-cntxt-obj-code, input table gds-list).
     2625           for each tt-PromoBc where tt-PromoBc.Chang:
     2626             tt-PromoBc.Chang = false .
     2627           end.
     2628            
     2629          end. 
     2630          when "PromoGoodsFix"
     2631          then do:
     2632            empty temp-table gds-list .
     2633         if not tt-PromoGoodsAppl.Chang then do:
     2634                  find first ub.goods no-lock where
     2635                     ub.goods.gds-code = tt-PromoGoodsAppl.gds-code no-error .
     2636                  create gds-list.
     2637                  buffer-copy goods to gds-list.
     2638                  assign
     2639                     gds-list.ActionId   = tt-PromoGoodsAppl.idAction
     2640                     gds-list.db-num     = tt-PromoGoodsAppl.db-num
     2641                     .
     2642           end.
     2643           else do:
     2644             for each buf_PromoGoodsAppl where buf_PromoGoodsAppl.Chang:
     2645                  find first ub.goods no-lock where
     2646                     ub.goods.gds-code = buf_PromoGoodsAppl.gds-code no-error .
     2647                  create gds-list.
     2648                  buffer-copy goods to gds-list.
     2649                  assign
     2650                     gds-list.ActionId   = buf_PromoGoodsAppl.idAction
     2651                     gds-list.db-num     = buf_PromoGoodsAppl.db-num
     2652                     .           
     2653             end.
     2654           end.
     2655           run ibs/th/rep/tick-lst.p (input parparentproc, input v-cntxt-obj-type, input v-cntxt-obj-code, input table gds-list).
     2656           for each tt-PromoGoodsAppl where tt-PromoGoodsAppl.Chang:
     2657             tt-PromoGoodsAppl.Chang = false .
     2658           end.
     2659            
     2660          end.        
     2661       end case.
     2662     end.     
     2663     method public void addgds(input iname  as char):
     2664       define variable rid-list as character no-undo.
     2665       define variable vI as integer no-undo.
     2666       /* when "PromoObject"
     2667          when "PromoPay" */
     2668       if    iname eq "promoset"
     2669          
     2670       then do:
     2671          create tt-PromoSet.
     2672          assign
     2673             tt-PromoSet.idAction = tt-promoaction-one.id
     2674             tt-PromoSet.id       = m-local-sec
     2675             m-local-sec          = m-local-sec - 1
     2676             tt-PromoSet.mode     = 'с':U
     2677           .
     2678       end.
     2679       else if  iname eq "PromoCardsBin"
     2680       then do:
     2681          create tt-PromoCardsBin.
     2682          assign
     2683             tt-PromoCardsBin.idAction = tt-promoaction-one.id
     2684             tt-PromoCardsBin.id       = m-local-sec
     2685             m-local-sec          = m-local-sec - 1
     2686             tt-PromoCardsBin.mode     = 'с':U
     2687           .
     2688       end.
     2689       else if iname eq "PromoCriterion"
     2690       then do:
     2691          create tt-PromoCriterion.
     2692          assign
     2693             tt-PromoCriterion.idAction = tt-promoaction-one.id
     2694             tt-PromoCriterion.id       = m-local-sec
     2695             m-local-sec                = m-local-sec - 1
     2696             tt-PromoCriterion.mode     = 'с':U
     2697           .
     2698       end.  
     2699       else if    iname  eq "promosetgoods" and not available tt-promoset
     2700       then
     2701          message "Сначала введите промо набор."
     2702          view-as alert-box.
     2703       else if    iname  eq "PromoGiftForCrit" and not available tt-PromoCriterion
     2704       then
     2705          message "Сначала введите критерии."
     2706          view-as alert-box.
     2707       else
     2708       run ref/gds-ref.p (
     2709                     input parparentproc
     2710                     ,input "b-sel,b-mark"
     2711                     ,input ?                /*p-stat */
     2712                     ,input 'все':U           /*p-list  */
     2713                     ,input ?                /*p-cond  */
     2714                     ,input ?                /*p-rec   */
     2715                     ,input ?                /*p-grp   */
     2716                     ,input ?                /*p-cli-type */
     2717                     ,input ?                /*p-cli-code  */
     2718                     ,input ?       /*p-obj-type  */
     2719                     ,input ?       /*p-obj-code  */
     2720                     ,input ?                /*p-other     */
     2721                     ,output rid-list ).
     2722         do vi = 1 to num-entries(rid-list):
     2723            find first ub.goods where recid(ub.goods) eq int64(entry(vi,rid-list))
     2724            no-lock no-error.
     2725            if available ub.goods
     2726            then do:
     2727            if can-find (first ub.goods-attr no-lock where ub.goods-attr.gds-code = ub.goods.gds-code and 
     2728               ub.goods-attr.attr-code = 'mark-type':U and ub.goods-attr.attr-value <> "not-type" and 
     2729               ub.goods-attr.attr-value <> "") then 
     2730            do:
     2731               message "Правила акции нарушают закон о маркировке продукции. Добавление маркированных товаров запрещено."
     2732               view-as alert-box.
     2733            end.   
     2734            else do:
     2735            case iName:
     2736                when "PromoGoodsAppl" 
     2737                then do:
     2738                   find first tt-PromoGoodsappl where  tt-PromoGoodsAppl.gds-code = ub.goods.gds-code no-error.
     2739                   if not available tt-PromoGoodsAppl
     2740                   then do:
     2741                       create tt-PromoGoodsappl.
     2742                       assign
     2743                          tt-PromoGoodsAppl.idAction = tt-promoaction-one.id
     2744                          tt-PromoGoodsAppl.id       = m-local-sec
     2745                          m-local-sec                = m-local-sec - 1
     2746                          tt-PromoGoodsAppl.mode     = 'с':U
     2747                          tt-PromoGoodsAppl.gds-code = ub.goods.gds-code
     2748                          tt-PromoGoodsAppl.gdsName  = ub.goods.gds-name
     2749                       . 
     2750                    end.   
     2751                end. 
     2752                when "PromoGoodsCrit"
     2753                then do:
     2754                  find first tt-PromoGoodsCrite where  tt-PromoGoodsCrite.gds-code = ub.goods.gds-code no-error.
     2755                   if not available tt-PromoGoodsCrite
     2756                   then do:
     2757                       create tt-PromoGoodsCrite.
     2758                       assign
     2759                          tt-PromoGoodsCrite.idAction = tt-promoaction-one.id
     2760                          tt-PromoGoodsCrite.id       = m-local-sec
     2761                          m-local-sec                 = m-local-sec - 1
     2762                          tt-PromoGoodsCrite.mode     = 'с':U
     2763                          tt-PromoGoodsCrite.gds-code = ub.goods.gds-code
     2764                          tt-PromoGoodsCrite.gdsName   = ub.goods.gds-name
     2765                       .
     2766                    end.     
     2767                end.  
     2768                when "PromoSetGoods"
     2769                then do:
     2770                  find first tt-PromoSetGoods where  tt-PromoSetGoods.gds-code = ub.goods.gds-code no-error.
     2771                   if not available tt-PromoSetGoods
     2772                   then do:
     2773                       create tt-PromoSetGoods.
     2774                       assign
     2775                          tt-PromoSetGoods.idAction = tt-promoaction-one.id
     2776                          tt-PromoSetGoods.id       = m-local-sec
     2777                          tt-PromoSetGoods.Idset    = tt-PromoSet.id
     2778                          m-local-sec               = m-local-sec - 1
     2779                          tt-PromoSetGoods.mode     = 'с':U
     2780                          tt-PromoSetGoods.gds-code = ub.goods.gds-code
     2781                          tt-PromoSetGoods.gdsName = ub.goods.gds-name
     2782                       . 
     2783                    end.   
     2784                end. 
     2785                when "PromoBarCode"
     2786                then do:
     2787                  find first tt-PromoBc where  tt-PromoBc.gds-code = ub.goods.gds-code no-error.
     2788                   if not available tt-PromoBc
     2789                   then do:
     2790                       create tt-PromoBc.
     2791                       assign
     2792                          tt-PromoBc.idAction = tt-promoaction-one.id
     2793                          tt-PromoBc.id       = m-local-sec
     2794                          tt-PromoBc.Idset    = tt-PromoSet.id
     2795                          m-local-sec               = m-local-sec - 1
     2796                          tt-PromoBc.mode     = 'с':U
     2797                          tt-PromoBc.gds-code = ub.goods.gds-code
     2798                          tt-PromoBc.gdsName  = ub.goods.gds-name
     2799                       . 
     2800                    end.   
     2801                end. 
     2802          
     2803                when "PromoGiftForAction"
     2804                then do:
     2805                  find first tt-PromoGift where  tt-PromoGift.gds-code = ub.goods.gds-code 
     2806                                            and  tt-PromoGift.Idcrit   = 0 no-error.
     2807                   if not available tt-PromoGift
     2808                   then do:
     2809                       create tt-PromoGift.
     2810                       assign
     2811                          tt-PromoGift.idAction = tt-promoaction-one.id
     2812                          tt-PromoGift.id       = m-local-sec
     2813                          m-local-sec               = m-local-sec - 1
     2814                          tt-PromoGift.mode     = 'с':U
     2815                          tt-PromoGift.gds-code = ub.goods.gds-code
     2816                          tt-PromoGift.gdsName = ub.goods.gds-name
     2817                       .
     2818                    end.    
     2819                 end.
     2820                 when "PromoGiftForCrit"
     2821                then do:
     2822                  find first tt-PromoGift where  tt-PromoGift.gds-code = ub.goods.gds-code 
     2823                                            and  tt-PromoGift.Idcrit   = tt-PromoCriterion.id no-error.
     2824                   if not available tt-PromoGift
     2825                   then do:
     2826                       create tt-PromoGift.
     2827                       assign
     2828                          tt-PromoGift.idAction = tt-promoaction-one.id
     2829                          tt-PromoGift.id       = m-local-sec
     2830                          tt-PromoGift.Idcrit   = tt-PromoCriterion.id
     2831                          m-local-sec               = m-local-sec - 1
     2832                          tt-PromoGift.mode     = 'с':U
     2833                          tt-PromoGift.gds-code = ub.goods.gds-code
     2834                          tt-PromoGift.gdsName = ub.goods.gds-name
     2835                       .
     2836                    end.     
     2837                end. 
     2838                       
     2839       end case.
     2840            end.   
     2841            end.   
     2842        end.             
     2843     end  method.
     2844     method public void GetCrit(output oMinCrit as character, output oDiscont as character ):
     2845       if available tt-promocriterion
     2846       then assign 
     2847          oMinCrit = string(tt-promocriterion.mincrit)
     2848          oDiscont = string(tt-promocriterion.Discont)
     2849       .
     2850       else assign
     2851          oMinCrit = "?"
     2852          oDiscont = "?".
     2853          
     2854     end method.
     2855     method public logical setCrit(input iAdd as logical,input iMinCrit as decimal ,input iDiscont as decimal  ):
     2856       define buffer buf_promocriterion for tt-promocriterion.
     2857       find first buf_promocriterion where buf_promocriterion.mincrit eq iMinCrit and recid(buf_promocriterion) ne recid(tt-promocriterion)
     2858       no-error.
     2859       if available buf_promocriterion 
     2860       then do:
     2861         message "Уже есть запись с таким минимальным значением критерия " iMinCrit
     2862         view-as alert-box.
     2863         return false.
     2864       end.
     2865       if iAdd 
     2866       then do:
     2867          create  tt-promocriterion.
     2868          assign
     2869             tt-PromoCriterion.id       = m-local-sec
     2870             m-local-sec                = m-local-sec - 1
     2871          .
     2872             
     2873       end.
     2874       assign
     2875          tt-PromoCriterion.idAction = tt-promoaction-one.id
     2876          tt-PromoCriterion.mode     = 'с':U
     2877          tt-promocriterion.mincrit  =  iMinCrit
     2878          tt-promocriterion.discont  =  iDiscont
     2879          
     2880       .
     2881       release tt-PromoCriterion.
     2882       CreateCrits().
     2883       return yes. 
     2884     end method.
     2885     
     2886     method public logical addObject():
     2887       define variable v-user-select as logical   no-undo .
     2888       define variable v-sub as class PromoObjectSub no-undo.
     2889     //define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2890   
     2891        run gbl/uobjsman.p (parparentproc,
     2892                            v-cntxt-db-num,
     2893                            v-cntxt-userid,
     2894                            v-host-code,
     2895                            v-cntxt-obj-type,
     2896                            v-cntxt-obj-code,
     2897                            output v-user-select ,
     2898                            output table tt-obj ).
     2899       if   v-user-select
     2900       then do:                   
     2901         v-sub =  new PromoObjectSub().                    
     2902         for each tt-obj:
     2903            find first tt-promoObject where tt-promoObject.obj-code eq tt-obj.obj-code
     2904                                        and tt-promoObject.obj-type eq tt-obj.obj-type
     2905            no-error.
     2906            if not available tt-promoObject
     2907            then do:
     2908               v-sub:obj-code = tt-obj.obj-code.
     2909               v-sub:obj-type = tt-obj.obj-type.
     2910               create          tt-promoObject.
     2911               assign
     2912                tt-promoObject.id       = m-local-sec
     2913                m-local-sec             = m-local-sec - 1
     2914                tt-PromoObject.idaction       = tt-promoaction-one.id
     2915                tt-PromoObject.mode           = 'с':U
     2916                tt-PromoObject.db-num         = v-sub:db-num
     2917                tt-PromoObject.obj-code       = v-sub:obj-code
     2918                tt-PromoObject.obj-type       = v-sub:obj-type
     2919                tt-PromoObject.FirmCode       = v-sub:FirmCode
     2920                tt-PromoObject.FirmName       = v-sub:FirmName
     2921                tt-PromoObject.objName        = v-sub:objName
     2922                tt-PromoObject.objDbNum       = v-sub:objDbNum
     2923                
     2924              .
     2925            end.
     2926            
     2927         end.
     2928         
     2929       end.
     2930       return v-user-select.
     2931       finally:
     2932         if valid-object(v-sub) then delete object v-sub.
     2933       end finally.      
     2934     
     2935      end.
     2936      method public logical addpay():
     2937        define variable v-pay-type-list as character no-undo.
     2938        define variable vi as integer no-undo. 
     2939        define variable Vflag as logical no-undo. 
     2940        define buffer Buf_cashpay for cash-pay.    
     2941          run ref/cashpays.w (
     2942               INPUT parparentproc
     2943               ,INPUT "b-sel,b-mark":U
     2944               ,input 'все':U
     2945               ,input v-host-code
     2946               ,input v-cntxt-obj-type
     2947               ,input v-cntxt-obj-code
     2948               ,OUTPUT v-pay-type-list
     2949               ).
     2950          do vi = 1 to num-entries(v-pay-type-list):
     2951            find first Buf_cashpay where recid(Buf_cashpay) eq integer (entry(vi,v-pay-type-list)) no-lock no-error.
     2952            if available Buf_cashpay
     2953            then do:        
     2954               find first tt-cashpay where tt-cashpay.cdpay-code = Buf_cashpay.cdpay-code 
     2955                                       and tt-cashpay.curr-code  = Buf_cashpay.curr-code  
     2956               no-lock no-error.
     2957               if not available tt-cashpay
     2958               then do:
     2959                  create tt-cashpay.
     2960                  buffer-copy Buf_cashpay to tt-cashpay.
     2961                  Vflag = yes.
     2962               end.
     2963            end.
     2964          end.  
     2965          return Vflag.    
     2966       end.
     2967       
     2968       method public void saveTypediscont(isolo  as logical,
     2969                                           iCombo as logical,
     2970                                           ivisa  as logical):
     2971          if available tt-promoaction-one
     2972          then assign
     2973             tt-promoaction-one.TypeDiscontsolo  = isolo
     2974             tt-promoaction-one.TypeDiscontcombo = icombo
     2975             tt-promoaction-one.TypeDiscontvisa  = ivisa
     2976          .
     2977       end.
