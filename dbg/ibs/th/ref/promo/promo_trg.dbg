     1146   /* --- 2 вызовы из формы добавления/редактирования --- */
     1147   
     1148   /* 2.1 перенести объект m-sub в temp-table */
     1149     method public void CreateDsForAction
     1150     ( input  p-mode as character
     1151     , input  p-sub  as class promoactionsub
     1152     ) :
     1153       define variable v-sched-sub as class promoSchedSub no-undo .
     1154       define variable vi          as integer  no-undo.
     1155       define variable vSurr       as character no-undo.
     1156       define buffer buf_cashpay for cash-pay.
     1157       m-local-sec          = m-local-sec - 1.
     1158       // для режима добавления включить tracking-changes на время инициализации полей
     1159   
     1160       // для режима редактирования - включить после инициализации   
     1161   
     1162       //if p-mode = {&add-def} then temp-table tt-promoaction-one:tracking-changes = true .
     1163   
     1164       create tt-promoaction-one.
     1165       assign 
     1166          tt-PromoAction-one.id             = p-sub:ID
     1167          tt-PromoAction-one.db-num         = p-sub:db-num
     1168          tt-PromoAction-one.changeDate     = p-sub:changeDate
     1169          tt-PromoAction-one.ChangDateFl    = tt-PromoAction-one.changeDate ne ?
     1170          tt-PromoAction-one.comment        = p-sub:comment
     1171          tt-PromoAction-one.description    = p-sub:description    
     1172          tt-PromoAction-one.ext-code       = p-sub:ext-code 
     1173          tt-PromoAction-one.paymenttype    = p-sub:paymenttype 
     1174          tt-PromoAction-one.priority       = p-sub:priority 
     1175          tt-PromoAction-one.beg-date       = p-sub:beg-date
     1176          tt-PromoAction-one.end-date       = p-sub:end-date
     1177          tt-PromoAction-one.methodCalclbl  = p-sub:methodCalclbl
     1178          tt-PromoAction-one.methodCalc     = p-sub:methodCalc // для отовбражения закладки подарков
     1179   
     1180          /* 1. при чтении из БД поле p-sub:Mode пустое: оно зависит от режима запуска формы ввода
     1181             2. форма ввода запускается в режимах &add-def, &lookup и &update;
     1182                экземпляр класса различает режимы &h-create, &h-update, &h-delete
     1183             3. ещё круче: режим запуска формы работает только для формы;
     1184                режим сохранения записи по умолчанию = &h-update, а остальные режимы
     1185                прописываются принудительно при добавлении или удалении сущности. 
     1186          */ 
     1187          // tt-PromoAction-one.mode           = modeForm2Fun (p-mode)
     1188   
     1189          
     1190          tt-PromoAction-one.nameAction     = p-sub:NameAction
     1191          tt-PromoAction-one.promosched-id  = p-sub:promosched-id
     1192          tt-PromoAction-one.typecondlbl    = p-sub:typecondLbl
     1193          tt-PromoAction-one.status_lbl     = p-sub:status_lbl
     1194          tt-PromoAction-one.TypeDiscontSolo = if p-sub:TypeDiscont eq 1 then true else false
     1195          tt-PromoAction-one.TypeDiscontCombo = if p-sub:TypeDiscont eq 2 then true else false
     1196          tt-PromoAction-one.TypeDiscontvisa = if p-sub:TypeDiscont eq 3 then true else false
     1197          
     1198          
     1199          tt-PromoAction-one.sub            = cast(p-sub,Progress.Lang.Object)
     1200       no-error.
     1201   
     1202         define buffer buf_PromoAttr for ub.PromoAttr .
     1203       find first buf_promoAttr where
     1204         buf_promoAttr.attr-code = "charge-BL" and
     1205         buf_promoAttr.tablename = "PromoPay" and
     1206         tt-promoaction-one.id = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and 
     1207         tt-promoaction-one.db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) 
     1208         no-error.     
     1209         if available (buf_PromoAttr) then tt-promoaction-one.changeBL = logical (buf_PromoAttr.attr-value) . 
     1210         else tt-promoaction-one.changeBL = false .
     1211   
     1212   
     1213       if p-mode = 'ДОБАВЛЕНИЕ':U then tt-PromoAction-one.mode = 'с':U.
     1214       v-sched-sub = p-sub:Schedule .
     1215       if valid-object(v-sched-sub) then do:
     1216         assign
     1217          tt-PromoAction-one.scheduleName   = v-sched-sub:dispname
     1218          tt-PromoAction-one.extCodeSched   = v-sched-sub:extCodeSched
     1219         no-error.
     1220         if p-mode = 'ДОБАВЛЕНИЕ':U 
     1221           then do:
     1222             v-sched-sub:id = m-local-sec.
     1223             v-sched-sub:mode          = 'с':U.
     1224             
     1225           end.
     1226       end .
     1227       else do:
     1228          v-sched-sub = new promoSchedSub ().
     1229          assign
     1230            v-sched-sub:schedType = 0
     1231            v-sched-sub:Mode      = 'с':U
     1232          .
     1233          p-sub:Schedule = v-sched-sub .
     1234       end .
     1235       assign
     1236         tt-PromoAction-one.scheduleType   = (v-sched-sub:schedType > 0)
     1237       .
     1238       if v-sched-sub:schedType = 0 then CreateTableForSchedw0 (p-mode, p-sub:ScheduleWeek).
     1239                                    else CreateTableForSchedw1 (p-mode, p-sub:ScheduleWeek).
     1240        //if p-mode = {&update} then temp-table tt-promoaction-one:tracking-changes = true .
     1241   
     1242        CritgoodsFl = p-sub:CritgoodsFl .
     1243        CreateTableForGoodsCrits(p-mode, p-sub:GoodsCrits).
     1244        CreateTableForGoodsAppl (p-mode, p-sub:GoodsAppl ).
     1245        CreateTableForCardsBin  (p-mode, p-sub:CardsBin ).
     1246        CreateTableForBarCode   (p-mode, p-sub:GoodsAppl ).
     1247        CreateTableForPromoSet  (p-mode, p-sub:PromoSet ).
     1248        CreateTableForCrite     (p-mode, p-sub:Criterion ).
     1249        CreateTableForGift      (p-mode, p-sub:Gifts     ).
     1250        CreateTableForObject    (p-mode, p-sub:Objects     ).
     1251        //find first tt-PromoGoodsCrite no-error.
     1252   
     1253        tt-PromoAction-one.CritgoodsFl = p-sub:CritgoodsFl.   //available tt-PromoGoodsCrite.
     1254   
     1255        find first tt-PromoGift where tt-PromoGift.gds-code ne 0 and tt-PromoGift.idCrit ne 0 no-error.
     1256        tt-PromoAction-one.simpGiftFl = not available tt-PromoGift.
     1257         do vi = 1 to num-entries(tt-PromoAction-one.paymenttype,chr(4)):
     1258            vSurr = entry(vi,tt-PromoAction-one.paymenttype,chr(4)).
     1259            find first Buf_cashpay where Buf_cashpay.cdpay-code = integer (entry(1,vSurr,chr(3)))
     1260                                     and Buf_cashpay.curr-code  = integer (entry(2,vSurr,chr(3)))
     1261            no-lock no-error.
     1262            if available Buf_cashpay
     1263            then do:
     1264                find first tt-cashpay where tt-cashpay.cdpay-code = Buf_cashpay.cdpay-code 
     1265                                        and tt-cashpay.curr-code  = Buf_cashpay.curr-code  
     1266                no-lock no-error.
     1267                if not available tt-cashpay
     1268                then do:
     1269                    create tt-cashpay.
     1270                    buffer-copy Buf_cashpay to tt-cashpay.
     1271                end.
     1272            end.
     1273        end.
     1274        m-local-sec          = m-local-sec - 1.
     1275     end method. // end_of_CreateDsForAction
     1276   
     1277     
     1278     method public void CreateTableForGoodsCrits
     1279     ( input  p-mode as character
     1280     , input  p-subs  as class promogoodssubs
     1281     ) :
     1282       define variable vI as int no-undo.
     1283       define variable p-sub as class promogoodssub no-undo.
     1284       //if p-mode = {&add-def} then temp-table tt-PromoGoodsCrite:tracking-changes = true . 
     1285   
     1286       do vi = 1 to p-subs:GetItem(vI):
     1287           p-sub = p-subs:promoGoodsObjCurr.  
     1288           create tt-PromoGoodsCrite.
     1289           assign
     1290              tt-PromoGoodsCrite.id             = p-sub:ID
     1291              tt-PromoGoodsCrite.idAction       = p-sub:idAction
     1292              tt-PromoGoodsCrite.gds-code       = p-sub:GdsCode
     1293              tt-PromoGoodsCrite.gdsname        = p-sub:Gdsname
     1294              tt-PromoGoodsCrite.type           = p-sub:type
     1295              tt-PromoGoodsCrite.sub            = p-subs:SubjectObjCurr
     1296              tt-PromoGoodsCrite.mode           = p-sub:Mode
     1297              tt-PromoGoodsCrite.db-num         = p-sub:db-num
     1298              tt-PromoGoodsCrite.idSet          = p-sub:idSet
     1299              tt-PromoGoodsCrite.price          = p-sub:price
     1300              tt-PromoGoodsCrite.qnty           = p-sub:qnty
     1301              tt-PromoGoodsCrite.NameSet        = p-sub:NameSet
     1302            .
     1303            if p-mode = 'ДОБАВЛЕНИЕ':U 
     1304            then do:
     1305            tt-PromoGoodsCrite.mode = 'с':U.
     1306            tt-PromoGoodsCrite.idAction = tt-PromoAction-one.id.
     1307            end.
     1308        end.    
     1309        //if p-mode = {&update} then temp-table tt-PromoGoodsCrite:tracking-changes = true .
     1310   
     1311     end method. // end_of_CreateTableForGoodsCrite
     1312   
     1313      method public void CreateCrits():
     1314          define buffer tt-PromoCriterion     for tt-PromoCriterion.
     1315          define buffer tt-PromoCriterionnext for tt-PromoCriterion.
     1316          for each tt-PromoCriterion
     1317              by tt-PromoCriterion.mincrit:
     1318              block-next:  
     1319              for each tt-PromoCriterionnext where tt-PromoCriterionnext.mincrit > tt-PromoCriterion.mincrit
     1320                                               and tt-PromoCriterionnext.mode    <> 'у':U  
     1321              by tt-PromoCriterionnext.mincrit:
     1322                 leave block-next.
     1323              end.  
     1324   
     1325              if tt-PromoCriterion.maxcrit <> 0 then do:
     1326              if CritgoodsFl then 
     1327              assign
     1328              tt-PromoCriterion.span = "От " +   trim(string (0,">>>>>>>9.99")) 
     1329              tt-PromoCriterion.spanBef = "До " +   trim(string (tt-PromoCriterion.maxcrit,">>>>>>>9.99")) .
     1330              else 
     1331              assign
     1332              tt-PromoCriterion.span = "От " +   trim(string (tt-PromoCriterion.mincrit,">>>>>>>9.99")) .
     1333              tt-PromoCriterion.spanBef = "До " +   trim(string (tt-PromoCriterion.maxcrit,">>>>>>>9.99")) .
     1334              .
     1335              end.
     1336              else do:
     1337              tt-PromoCriterion.span = "От " +   trim(string (tt-PromoCriterion.mincrit,">>>>>>>9.99")) .
     1338              if available tt-PromoCriterionnext  then tt-PromoCriterion.spanBef = "До " +   trim(string (tt-PromoCriterionnext.mincrit - 0.01 ,">>>>>>>9.99")) .
     1339              else "".
     1340              end.
     1341   
     1342   /*           if tt-PromoCriterion.maxcrit = 0 then tt-PromoCriterion.spanBef = " " .                          */
     1343   /*           else tt-PromoCriterion.spanBef = "До " +   trim(string (tt-PromoCriterion.maxcrit,">>>>>>>9.99"))*/
     1344                                     .                                   
     1345          end. 
     1346      end.
     1347     method public void CreateTableForGoodsAppl
     1348     ( input  p-mode as character
     1349     , input  p-subs  as class promogoodssubs
     1350     ) :
     1351       define variable vI as int no-undo.
     1352       define variable p-sub as class promogoodssub no-undo.
     1353   
     1354       //if p-mode = {&add-def} then temp-table tt-PromoGoodsAppl:tracking-changes = true . 
     1355   
     1356       do vi = 1 to p-subs:GetItem(vI):  
     1357           p-sub = p-subs:promoGoodsObjCurr.
     1358           create tt-PromoGoodsAppl.
     1359           assign
     1360              tt-PromoGoodsAppl.id             = p-sub:ID
     1361              tt-PromoGoodsAppl.idAction       = p-sub:idAction
     1362              tt-PromoGoodsAppl.gds-code       = p-sub:GdsCode
     1363              tt-PromoGoodsAppl.gdsname        = p-sub:GdsName
     1364              tt-PromoGoodsAppl.type           = p-sub:type
     1365              tt-PromoGoodsAppl.sub            = p-subs:SubjectObjCurr
     1366              tt-PromoGoodsAppl.mode           = p-sub:Mode
     1367              tt-PromoGoodsAppl.db-num         = p-sub:db-num
     1368              tt-PromoGoodsAppl.idSet          = p-sub:idSet
     1369              tt-PromoGoodsAppl.price          = p-sub:price
     1370              tt-PromoGoodsAppl.qnty           = p-sub:qnty
     1371              tt-PromoGoodsAppl.NameSet        = p-sub:NameSet
     1372            . 
