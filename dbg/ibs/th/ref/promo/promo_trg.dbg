      243   define variable mDate   as date     no-undo.
      244   define variable mStatus as integer  no-undo.
      245       method private void getListTable (
      246          //input-output table tt-promoaction bind
      247       ) :
      248           getListTable(mDate,mStatus).
      249       end.
      250       method public void getListTable (input idate as date, input istatus as integer
      251          //input-output table tt-promoaction bind
      252       ) :
      253           assign
      254               mDate   = idate
      255               mStatus = istatus
      256           .
      257           define variable v-subs    as class promoActionSubs no-undo .
      258           define variable v-sub     as class promoactionsub no-undo .
      259           define variable v-length  as integer no-undo .
      260           define variable v-i       as integer no-undo .
      261           define variable v-size    as integer no-undo .
      262           empty temp-table tt-promoaction.
      263           v-subs    =
      264           m-storage:getpromoactionsubs(idate,istatus) . // получаем коллекцию из data-storage
      265           // перекладываем коллекцию во временную таблицу
      266           v-length  = v-subs:iCounter .
      267           v-subs:IsDelChildObj = no.
      268           do v-i = 1 to v-length :
      269               v-size = v-subs:GetItem(v-i) . // переключает SubjectObjCurr на N[v-i] и возвращает количество элементов в коллекции
      270               v-sub = v-subs:promoActionObjCurr .
      271               create tt-promoaction .
      272               assign
      273                   tt-promoaction.id           = v-sub:ID
      274                   tt-PromoAction.db-num      = v-sub:db-num
      275                   tt-PromoAction.changeDate  = v-sub:changeDate
      276                   tt-PromoAction.comment     = v-sub:comment
      277                   tt-PromoAction.description = v-sub:description
      278                   tt-PromoAction.ext-code    = v-sub:ext-code
      279                   tt-PromoAction.paymenttype = v-sub:paymenttype
      280                   tt-PromoAction.priority    = v-sub:priority
      281                   tt-PromoAction.status_     = v-sub:status_
      282                   tt-PromoAction.status_lbl  = v-sub:status_lbl
      283                   tt-promoaction.beg-date    = v-sub:beg-date
      284                   tt-promoaction.end-date    = v-sub:end-date
      285                   tt-promoaction.methodCalc  = v-sub:methodCalc
      286                   tt-promoaction.mode        = v-sub:Mode
      287                   tt-promoaction.nameAction  = v-sub:nameAction
      288                   tt-promoaction.typecond    = v-sub:typecond
      289                   tt-promoaction.TypeDiscont = v-sub:TypeDiscont
      290                   tt-promoaction.sub         = v-subs:SubjectObjCurr
      291               .
      292           end.
      293       // удаляем коллекцию без удаления её элементов:
      294       //   data-storage использовал конструктор с флагом false на входе для создания коллекции
      295           delete object v-subs .
      296       // Все элементы коллекции доступны по ссылке из экранной таблицы
      297       end method . // end_of getListTable
      298     method public class promoActionSubs ReturnSubsPromoAction():
      299         define variable vSubs  as class promoActionSubs  no-undo .
      300         define variable vSub   as class promoActionSub   no-undo .
      301         vSubs = new promoActionSubs().
      302         for each tt-promoaction where tt-promoaction.Chang:
      303             vsub = cast(tt-promoaction.sub, ibs.th.ref.promo.PromoActionSub) .
      304             m-storage:refreshObj(vsub).
      305             vSubs:AddItem(tt-promoaction.sub).
      306         end.
      307         return vSubs.
      308      end.
      309      method public void changeRow(input iAll as logical):
      310          define variable vFlag as logical no-undo.
      311          vFlag = if     available tt-promoaction
      312                     and tt-promoaction.Chang
      313                  then no
      314                  else yes.
      315          if iAll
      316          then
      317              for each   tt-promoaction:
      318                  tt-promoaction.Chang = vFlag.
      319              end.
      320          else
      321               if avail tt-promoaction
      322               then
      323                   tt-promoaction.Chang = vFlag.
      324      end.
      325      method public void changeRowAll(input iAll as logical):
      326          define variable vFlag as logical no-undo.
      327          vFlag = if     available tt-PromoGoodsAppl
      328                     and tt-PromoGoodsAppl.Chang
      329                  then no
      330                  else yes.
      331          if iAll
      332          then
      333              for each   tt-PromoGoodsAppl:
      334                  tt-PromoGoodsAppl.Chang = vFlag.
      335              end.
      336          else
      337               if avail tt-PromoGoodsAppl
      338               then
      339                   tt-PromoGoodsAppl.Chang = vFlag.
      340      end.
      341      method public void ChangBarCode(input iAll as logical):
      342          define variable vFlag as logical no-undo.
      343          vFlag = if     available tt-PromoBc
      344                     and tt-PromoBc.Chang
      345                  then no
      346                  else yes.
      347          if iAll
      348          then
      349              for each   tt-PromoBc:
      350                  tt-PromoBc.Chang = vFlag.
      351              end.
      352          else
      353               if avail tt-PromoBc
      354               then
      355                   tt-PromoBc.Chang = vFlag.
      356      end.
      357     method public void printPromoActionList () :
      358     define variable v-report-name       as character no-undo .
      359     define variable v-file-name-rep-htm as character no-undo .
      360     define variable v-filt-1            as character no-undo . // фильтр по mDate
      361     define variable v-filt-2            as character no-undo . // фильтр по mStatus
      362     define variable v-date-start        as date no-undo . // для имени листа в Excel
      363     define variable v-page-name         as character no-undo . // имя листа в Excel
      364     // по каждой акции:
      365     define variable v-PromoActionSub    as class ibs.th.ref.promo.PromoActionSub no-undo .
      366     define variable v-wdaylist          as character no-undo . // перечень дней недели (пн=1)
      367     define variable v-wdaysubs          as class promoschedwsubs no-undo . // перечень дней недели (объектами)
      368     define variable v-sub               as promoschedwsub no-undo . // каждый день недели (объект)
      369     define variable v-timelist          as character extent 7 no-undo . // перечень времени на каждый день недели
      370     define variable v-sdaynum           as character no-undo . // номер дня недели (пн=1)
      371     define variable v-idaynum           as integer no-undo . // номер дня недели (пн=1)
      372     define variable vi                  as integer no-undo .
      373     define variable vj                  as integer no-undo .
      374     define buffer buf_tt-promoaction for tt-promoaction .
      375       assign
      376         v-filt-1 = if mDate   = ? then "" else substitute("с датой окончания от &1", mDate)
      377         v-filt-2 = if mStatus = ? then "" else substitute("со статусом &1",          mStatus)
      378         v-date-start = today
      379         v-page-name  = substitute(  "exp&1g",  string(day(v-date-start), "99")  )
      380       .
      381       // 03/VIII-2018 функции для печати временно берём из ibs.th.gbl.gbl-inipar
      382       v-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name() .
      383       assign
      384         v-file-name-rep-htm = v-report-name + ".html"
      385       .
      386       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
      387   do:
      388     put stream OutStr-html unformatted
      389       "<!DOCTYPE HTML>" skip
      390       '<html>' skip
      391       '<head>' skip
      392       '  <meta charset="utf-8">' skip
      393       '  <style type="text/css">' skip
      394       '      table ~{border-collapse: collapse~;~}' skip
      395       '      tbody td, th ~{border: 1px solid black~; height: 14px~;~}' skip
      396       '      tbody td ~{text-align: center~; padding-left: 4px~;~}' skip
      397       '  </style>' skip
      398       '</head>' skip
      399       '<body>' skip
      400       substitute('<TABLE name="&1" fit_to_page="true" orientation="portrait" repeat_rows="1:4" outline_below="false">', v-page-name) skip
      401       '<thead>' skip
      402       '  <tr class="set_columns">' skip
      403       '    <td style="width: 98px;"></td>' skip
      404       '    <td style="width: 300px;"></td>' skip
      405       '    <td style="width: 80px;"></td>' skip
      406       '    <td style="width: 80px;"></td>' skip
      407       '    <td style="width: 50px;"></td>' skip
      408       '    <td style="width: 50px;"></td>' skip
      409       '    <td style="width: 50px;"></td>' skip
      410       '    <td style="width: 50px;"></td>' skip
      411       '    <td style="width: 50px;"></td>' skip
      412       '    <td style="width: 50px;"></td>' skip
      413       '    <td style="width: 50px;"></td>' skip
      414       '  </tr>' skip
      415       '  <tr>' skip
      416       '    <td colspan="11"></td>' skip
      417       '  </tr>' skip
      418       '  <tr>' skip
      419       '    <td colspan="11">' + v-filt-1 + '<br />' + v-filt-2 + '</td>' skip
      420       '  </tr>' skip
      421       '</thead>' skip
      422       '<tbody>' skip
      423       '  <tr>' skip
      424       '    <th>№ промо-акции</th>' skip
      425       '    <th>Наименование промо-акции</th>' skip
      426       '    <th>Дата начала</th>' skip
      427       '    <th>Дата окончания</th>' skip
      428       '    <th>пн</th>' skip
      429       '    <th>вт</th>' skip
      430       '    <th>ср</th>' skip
      431       '    <th>чт</th>' skip
      432       '    <th>пт</th>' skip
      433       '    <th>сб</th>' skip
      434       '    <th>вс</th>' skip
      435       '  </tr>' skip
      436     .
      437   end.
      438   do :
      439       for each buf_tt-promoaction :
      440         v-wdaylist = "" .
      441         do vj = 1 to 7 : v-timelist[vj] = "" . end .
      442         v-PromoActionSub = cast(buf_tt-promoaction.sub, ibs.th.ref.promo.PromoActionSub) .
      443         // m-storage:refreshObj(v-PromoActionSub).
      444         v-PromoActionSub:refreshChildObj().
      445         v-wdaysubs = v-PromoActionSub:ScheduleWeek .
      446         if valid-object (v-wdaysubs) then do :
      447           if v-wdaysubs:GetItem(vI) = 1 and v-wdaysubs:promoSchedwObjCurr:wdaylist = "0" then do:
      448           v-wdaylist = "1,2,3,4,5,6,7" .
      449           do vj = 1 to 7 :
      450              v-timelist[vj] ="00:00 - 23:59" .
      451           end .
      452           end.
      453           else do:
      454           do vi = 1 to v-wdaysubs:GetItem(vI):
      455             v-sub = v-wdaysubs:promoSchedwObjCurr .
      456             // v-sub:wdaylist содержит или один день, или перечень дней через запятую
      457             v-wdaylist = v-wdaylist + substitute(",&1", v-sub:wdaylist) .
      458             do vj = 1 to num-entries(v-sub:wdaylist) :
      459               v-sdaynum = entry(vj, v-sub:wdaylist) .
      460               v-idaynum = integer(v-sdaynum) no-error .
      461               if v-idaynum > 0 then assign
      462                 v-timelist[v-idaynum] = v-timelist[v-idaynum] +
      463                   substitute(  ",<br />&1 - &2",  string(v-sub:timebeg, "hh:mm"),  string(v-sub:timeend, "hh:mm")  )
      464               .
      465             end .
      466           end .
      467           v-wdaylist = substring(v-wdaylist, 2) .
      468           do vj = 1 to 7 :
      469              v-timelist[vj] = substring(v-timelist[vj], 8) .
      470           end .
      471         end . // end_of_wdaysubs
      472         end .
      473         put stream OutStr-html unformatted
      474           '  <tr>'
      475           '<td rowspan="2">' buf_tt-promoaction.ext-code '</td>'
      476           '<td rowspan="2">' buf_tt-promoaction.nameAction '</td>'
      477           '<td rowspan="2">' string(buf_tt-promoaction.beg-date, "99.99.99") '</td>'
      478           '<td rowspan="2">' string(buf_tt-promoaction.end-date, "99.99.99") '</td>'
      479           '<td>' (if can-do(v-wdaylist, "1") then '+' else '-') '</td>'
      480           '<td>' (if can-do(v-wdaylist, "2") then '+' else '-') '</td>'
      481           '<td>' (if can-do(v-wdaylist, "3") then '+' else '-') '</td>'
      482           '<td>' (if can-do(v-wdaylist, "4") then '+' else '-') '</td>'
      483           '<td>' (if can-do(v-wdaylist, "5") then '+' else '-') '</td>'
      484           '<td>' (if can-do(v-wdaylist, "6") then '+' else '-') '</td>'
      485           '<td>' (if can-do(v-wdaylist, "7") then '+' else '-') '</td>'
      486           '  </tr><tr>' skip
      487           '<td>' v-timelist[1] '</td>'
      488           '<td>' v-timelist[2] '</td>'
      489           '<td>' v-timelist[3] '</td>'
      490           '<td>' v-timelist[4] '</td>'
      491           '<td>' v-timelist[5] '</td>'
      492           '<td>' v-timelist[6] '</td>'
      493           '<td>' v-timelist[7] '</td>'
      494           '  </tr>' skip
      495         .
      496       end . // end_of for_each_buf_tt-promoaction
      497   end .
      498   do :
      499     put stream OutStr-html unformatted
      500       '</tbody>' skip
      501       '<tfoot>' skip
      502     .
      503     put stream OutStr-html unformatted
      504       '</tfoot>' skip
      505       '</table>' skip
      506       '</body>' skip
      507       '</html>' skip
      508     .
      509     output stream OutStr-html close.
      510   end .
      511     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(v-file-name-rep-htm,"") .
      512     end method .
      513     method public logical getChangeBL ():
      514       return tt-promoaction-one.changeBL .
      515     end.
      516       method public handle getQuery (input iNameQuery as character ) :
      517           return getQuery(iNameQuery,no).
      518       end.
      519       method public handle getQuery (input iNameQuery as character,input iNewQuery as logical ) :
      520           define variable hQuery   as handle  no-undo .
      521           define variable vfirst   as logical no-undo .
      522           define variable vTblName as character no-undo .
      523           define variable vOpenStr as character no-undo .
      524           define variable vSchedId as integer no-undo .
      525               find first tt-Query where tt-Query.NameQuery eq iNameQuery
      526               no-error.
      527               if     available tt-Query
      528                  and iNewQuery
      529               then do:
      530                  delete object tt-Query.hQuery.
      531                  delete tt-Query.
      532               end.
      533               if not available tt-Query
      534               then
      535               do:
      536                   create query hQuery.
      537                   case iNameQuery:
      538                       when "promoActionStatus"
      539                       then do:
      540                           hQuery:set-buffers(buffer tt-promoaction:HANDLE).
      541                           hQuery:query-prepare("FOR EACH tt-promoaction where tt-promoaction.status_ = 1").
      542                       end.
      543                       when "promoActionAll"
      544                       then do:
      545                           hQuery:set-buffers(buffer tt-promoaction:HANDLE).
      546                           hQuery:query-prepare("FOR EACH tt-promoaction").
      547                       end.
      548                       when "promoActionOne"
      549                       or
      550                       when "promoActionOne2"
      551                       or
      552                       when "promoActionOne3"
      553                       or
      554                       when "promoActionOne4"
      555                       then do:
      556                           hQuery:set-buffers(buffer tt-promoaction-one:HANDLE).
      557                           hQuery:query-prepare("FOR EACH tt-promoaction-one").
      558                           vfirst = yes.
      559                       end.
      560                       when "PromoGoodsAppl"
      561                       then do:
      562                           hQuery:set-buffers(buffer tt-PromoGoodsAppl:HANDLE).
      563                           hQuery:query-prepare("FOR EACH tt-PromoGoodsAppl " + if not available tt-promoaction-one then "" else (
      564                                                    "where tt-PromoGoodsAppl.idaction eq " + string(tt-promoaction-one.id)  +
      565                                                    "  and tt-PromoGoodsAppl.mode ne 'у':U"
      566                                                )).
      567                       end.
      568                       when "PromoGoodsApplFix"
      569                       then do:
      570                           hQuery:set-buffers(buffer tt-PromoGoodsAppl:HANDLE).
      571                           hQuery:query-prepare("FOR EACH tt-PromoGoodsAppl " + if not available tt-promoaction-one then "" else (
      572                                                    "where tt-PromoGoodsAppl.idaction eq " + string(tt-promoaction-one.id)  +
      573                                                    "  and tt-PromoGoodsAppl.mode ne 'у':U"
      574                                                )).
      575                       end.
      576                       when "PromoGoodsFix"
      577                       then do:
      578                           hQuery:set-buffers(buffer tt-PromoGoodsAppl:HANDLE).
      579                           hQuery:query-prepare("FOR EACH tt-PromoGoodsAppl " + if not available tt-promoaction-one then "" else (
      580                                                    "where tt-PromoGoodsAppl.idaction eq " + string(tt-promoaction-one.id)  +
      581                                                    "  and tt-PromoGoodsAppl.mode ne 'у':U"
      582                                                )).
      583                       end.
      584                       when "PromoCardsBin"
      585                       then do:
      586                           hQuery:set-buffers(buffer tt-PromoCardsBin:HANDLE).
      587                           hQuery:query-prepare("FOR EACH tt-PromoCardsBin " + if not available tt-promoaction-one then "" else (
      588                                                    "where tt-PromoCardsBin.idaction eq " + string(tt-promoaction-one.id)  +
      589                                                    "  and tt-PromoCardsBin.mode ne 'у':U"
      590                                                )).
      591                       end.
      592                       when "PromoBarCode"
      593                       then do:
      594                           hQuery:set-buffers(buffer tt-PromoBc:HANDLE).
      595                           hQuery:query-prepare("FOR EACH tt-PromoBC " + if not available tt-promoaction-one then "" else (
      596                                                    "where tt-PromoBC.idaction eq " + string(tt-promoaction-one.id)  +
      597                                                    "  and tt-PromoBC.mode ne 'у':U"
      598                                                )).
      599                       end.
      600                       when "PromoGoodsCrit"
      601                       then do:
      602                           hQuery:set-buffers(buffer tt-PromoGoodsCrite:HANDLE).
      603                           hQuery:query-prepare("FOR EACH tt-PromoGoodsCrite " + if not available tt-promoaction-one then "" else (
      604                                                    "where tt-PromoGoodsCrite.idaction eq " + string(tt-promoaction-one.id)  +
      605                                                    "  and tt-PromoGoodsCrite.mode     ne 'у':U")).
      606                       end.
      607                       when "PromoSet"
      608                       then do:
      609                           hQuery:set-buffers(buffer tt-PromoSet:HANDLE).
      610                           hQuery:query-prepare("FOR EACH tt-PromoSet "  +  if not available tt-promoaction-one then "" else (
      611                                                    "where tt-PromoSet.idaction eq " + string(tt-promoaction-one.id) +
      612                                                    "  and tt-PromoSet.mode     ne 'у':U"
      613                                                )).
      614                       end.
      615                       when "PromoSetGoods"
      616                       then do:
      617                           hQuery:set-buffers(buffer tt-PromoSetGoods:HANDLE).
      618                           hQuery:query-prepare("FOR EACH tt-PromoSetGoods " + if not available tt-PromoSet then "" else (
      619                                                    "where tt-PromoSetGoods.idaction eq " + string(tt-PromoSet.idAction) +
      620                                                    "  and tt-PromoSetGoods.idset    eq " + string(tt-PromoSet.id) +
      621                                                    "  and tt-PromoSetGoods.mode     ne 'у':U"
      622                                               )).
      623                       end.
      624                       when "PromoCriterion"
      625                       then do:
      626                           hQuery:set-buffers(buffer tt-PromoCriterion:HANDLE).
      627                           hQuery:query-prepare("FOR EACH tt-PromoCriterion " + if not available tt-promoaction-one then "" else (
      628                                                    "where tt-PromoCriterion.idaction eq " + string(tt-promoaction-one.id) +
      629                                                    "  and tt-PromoCriterion.mode     ne 'у':U")).
      630                       end.
      631                       when "PromoObject"
      632                       then do:
      633                           hQuery:set-buffers(buffer tt-PromoObject:HANDLE).
      634                           hQuery:query-prepare("FOR EACH tt-PromoObject " + if not available tt-promoaction-one then "" else (
      635                                                    "where tt-PromoObject.idaction eq " + string(tt-promoaction-one.id) +
      636                                                    "  and tt-PromoObject.mode     ne 'у':U")).
      637                       end.
      638                       when "PromoPay"
      639                       then do:
      640                           hQuery:set-buffers(buffer tt-CashPay:HANDLE).
      641                           hQuery:query-prepare("FOR EACH tt-CashPay ").
      642                       end.
      643                       when "PromoCriterionOne"
      644                       then do:
      645                           for each tt-PromoCriterion where tt-PromoCriterion.mode eq 'и':U :
      646                               if vFirst
      647                               then
      648                                 . // tt-PromoCriterion.mode = {&h-delete}.
      649                               else
      650                                   vFirst = yes.
      651                           end.
      652                           for each tt-PromoCriterion where tt-PromoCriterion.mode eq 'с':U :
      653                               if vFirst
      654                               then
      655                          .  //       delete tt-PromoCriterion.  удалять нельзя мешает копированию
      656                               else
      657                                   vFirst = yes.
      658                           end.
      659                           if not vFirst
      660                           then do:
      661                               create tt-PromoCriterion.
      662                               assign
      663                                   vFirst                     = yes
      664                                   tt-PromoCriterion.mode     = 'с':U
      665                                   tt-PromoCriterion.idAction = tt-promoaction-one.id
      666                                   tt-PromoCriterion.id       = m-local-sec
      667                                   m-local-sec                = m-local-sec - 1
      668                               .
      669                           end.
      670                           hQuery:set-buffers(buffer tt-PromoCriterion:HANDLE).
      671                           hQuery:query-prepare("FOR EACH tt-PromoCriterion " + if not available tt-promoaction-one then "" else (
      672                                                    "where tt-PromoCriterion.idaction eq " + string(tt-promoaction-one.id) +
      673                                                    "  and tt-PromoCriterion.mode     ne 'у':U")).
      674                       end.
      675                       when "PromoGiftForAction"
      676                       then do:
      677                           hQuery:set-buffers(buffer tt-PromoGift:HANDLE).
      678                           hQuery:query-prepare("FOR EACH tt-PromoGift " + (if not available tt-promoaction-one then "where true " else (
      679                                                    "where tt-PromoGift.idaction eq " + string(tt-promoaction-one.id) )) +
      680                                                    "  and tt-PromoGift.idCrit   eq 0 "  +
      681                                                    "  and tt-PromoGift.GDS-CODE NE 0" +
      682                                                    "  and tt-PromoGift.mode     ne 'у':U"
      683                                               ).
      684                       end.
      685                       when "PromoMes"
      686                       then do:
      687                           vFirst = yes.
      688                           if     available tt-PromoCriterion
      689                              and not can-find( first tt-PromoGift  where tt-PromoGift.idaction eq tt-PromoCriterion.idaction
      690                                                      and tt-PromoGift.idCrit   eq tt-PromoCriterion.id
      691                                                      and tt-PromoGift.mode     ne 'у':U)
      692                           then do:
      693                               create tt-PromoGift.
      694                               assign
      695                               tt-PromoGift.idCrit   = tt-PromoCriterion.id
      696                               tt-PromoGift.idaction = tt-PromoCriterion.idaction
      697                               tt-PromoGift.mode     = 'с':U
      698                               tt-PromoGift.id       = m-local-sec
      699                               m-local-sec           = m-local-sec - 1.
      700                           end.
      701                           hQuery:set-buffers(buffer tt-PromoGift:HANDLE).
      702                           hQuery:query-prepare("FOR each tt-PromoGift " + if not available tt-promoaction-one then "" else (
      703                                                    "where tt-PromoGift.idaction eq " + string(tt-PromoCriterion.idaction) +
      704                                                    "  and tt-PromoGift.idCrit   eq " + string(tt-PromoCriterion.id)       +
      705                                                    "  and tt-PromoGift.mode     ne 'у':U"
      706                                               )).
      707                       end.
      708                       when "PromoMes1"
      709                       then do:
      710                           vFirst = yes.
      711                           if     available tt-PromoCriterion
      712                              and not can-find( first tt-PromoGift  where tt-PromoGift.idaction eq tt-PromoCriterion.idaction
      713                                                      and tt-PromoGift.idCrit   eq tt-PromoCriterion.id
      714                                                      and tt-PromoGift.mode     ne 'у':U)
      715                           then do:
      716                               create tt-PromoGift.
      717                               assign
      718                               tt-PromoGift.idCrit   = tt-PromoCriterion.id
      719                               tt-PromoGift.idaction = tt-PromoCriterion.idaction
      720                               tt-PromoGift.mode     = 'с':U
      721                               tt-PromoGift.id       = m-local-sec
      722                               m-local-sec           = m-local-sec - 1.
      723                           end.
      724                           hQuery:set-buffers(buffer tt-PromoGift:HANDLE).
      725                           hQuery:query-prepare("FOR each tt-PromoGift " + if not available tt-promoaction-one then "" else (
      726                                                    "where tt-PromoGift.idaction eq " + string(tt-PromoCriterion.idaction) +
      727                                                    "  and tt-PromoGift.idCrit   eq " + string(tt-PromoCriterion.id)       +
      728                                                    "  and tt-PromoGift.mode     ne 'у':U"
      729                                               )).
      730                       end.
      731                       when "PromoGiftForCrit"
      732                       then do:
      733                           hQuery:set-buffers(buffer tt-PromoGift:HANDLE).
      734                           hQuery:query-prepare("FOR EACH tt-PromoGift " + (if not available tt-PromoCriterion then "where true" else (
      735                                                    "where tt-PromoGift.idaction eq " + string(tt-PromoCriterion.idAction) +
      736                                                    "  and tt-PromoGift.idCrit   eq " + string(tt-PromoCriterion.id) )) +
      737                                                    "  and tt-PromoGift.idCrit   ne 0 "  +
      738                                                    "  and tt-PromoGift.GDS-CODE NE 0" +
      739                                                    "  and tt-PromoGift.mode     ne 'у':U"
      740                                               ).
      741                       end.
      742                       when "promoSchedWeek"
      743                       then do:
      744                           vTblName = "tt-promo-schedule-week" .
      745                           hQuery:set-buffers(buffer tt-promo-schedule-week:HANDLE).
      746                           // 26/VII-2018 - tt-promoaction-one должен быть всегда available
      747                           // 27/VII-2018 - если на available tt-promoaction-one - то хотябы available tt-promoaction
      748                           case true:
      749                             when available tt-promoaction-one then vSchedId = tt-promoaction-one.promosched-id .
      750                             when available tt-promoaction     then vSchedId = tt-promoaction.promosched-id .
      751                                                          otherwise vSchedId = 0 .
      752                           end case .
      753                           vOpenStr = substitute (
      754                             "PRESELECT EACH &1 where &1.promosched-id = &2 and &1.mode ne '&3'"
      755                             , vTblName, vSchedId, 'у':U
      756                           ) .
      757                           hQuery:query-prepare(vOpenStr).
      758                           vfirst = yes.
      759                       end.
      760                       when "promoSchedWeek2"
      761                       then do:
      762                           vTblName = "tt-promo-schedule-week2" .
      763                           hQuery:set-buffers(buffer tt-promo-schedule-week2:HANDLE).
      764                           case true:
      765                             when available tt-promoaction-one then vSchedId = tt-promoaction-one.promosched-id .
      766                             when available tt-promoaction     then vSchedId = tt-promoaction.promosched-id .
      767                                                          otherwise vSchedId = 0 .
      768                           end case .
      769                           vOpenStr = substitute (
      770                             "PRESELECT EACH &1 where &1.promosched-id = &2 and &1.mode ne '&3'"
      771                             , vTblName, vSchedId, 'у':U
      772                           ) .
      773                           hQuery:query-prepare(vOpenStr).
      774                           vfirst = yes.
      775                       end.
      776                       when "promoSchedWeek3" then do :
      777                           case true:
      778                             when available tt-promoaction-one then vSchedId = tt-promoaction-one.promosched-id .
      779                             when available tt-promoaction     then vSchedId = tt-promoaction.promosched-id .
      780                                                          otherwise vSchedId = 0 .
      781                           end case .
      782                           if not can-find (first tt-promo-schedule-week3) then do :
      783                             create tt-promo-schedule-week3 .
      784                             assign
      785                               tt-promo-schedule-week3.promosched-id = vSchedId
      786                             .
      787                           end .
      788                           vTblName = "tt-promo-schedule-week3" .
      789                           hQuery:set-buffers(buffer tt-promo-schedule-week3:HANDLE).
      790                           vOpenStr = substitute (
      791                             "PRESELECT EACH &1 where &1.promosched-id = &2 and &1.mode ne '&3'"
      792                             , vTblName, vSchedId, 'у':U
      793                           ) .
      794                           hQuery:query-prepare(vOpenStr).
      795                           vfirst = yes.
      796                       end .
      797                   end case.
      798                   if available (tt-promoaction) then typeCond = tt-promoaction.typecond .
      799                   hQuery:query-open.
      800                   if vFirst
      801                   then
      802                       hQuery:get-first () no-error .
      803                   create tt-Query.
      804                   assign
      805                       tt-Query.NameQuery = iNameQuery
      806                       tt-Query.hQuery    = hQuery
      807                   .
      808               end.
      809               else
      810                  hQuery = tt-Query.hQuery.
      811           return hQuery.
      812       end.
      813       method public handle CleanQuery (input iNoCleanNameQuery as character ) :
      814           for each tt-Query where not can-do(iNoCleanNameQuery,tt-Query.nameQuery):
      815               tt-Query.hQuery:query-close ().
      816               delete object tt-Query.hQuery.
      817               delete tt-Query.
      818           end.
      819       end.
