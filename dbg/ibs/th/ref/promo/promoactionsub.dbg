      429     define private property refreshObj as logical no-undo
      430       get.
      431       set.
      432     method public void Clean():
      433       if valid-object(THIS-OBJECT:Criterion)    then delete object THIS-OBJECT:Criterion    no-error.
      434       if valid-object(THIS-OBJECT:Gifts)        then delete object THIS-OBJECT:Gifts        no-error.
      435       if valid-object(THIS-OBJECT:GoodsAppl)    then delete object THIS-OBJECT:GoodsAppl    no-error.
      436       if valid-object(THIS-OBJECT:GoodsCrits)   then delete object THIS-OBJECT:GoodsCrits   no-error.
      437       if valid-object(this-object:Objects)      then delete object this-object:Objects      no-error.
      438       if valid-object(THIS-OBJECT:Schedule)     then delete object THIS-OBJECT:Schedule     no-error.
      439       if valid-object(THIS-OBJECT:ScheduleWeek) then delete object THIS-OBJECT:ScheduleWeek no-error.
      440       if valid-object(THIS-OBJECT:CardsBin)     then delete object THIS-OBJECT:CardsBin     no-error.
      441     end.
      442     method public void refreshChildObj():
      443       Clean().
      444       this-object:refreshObj = yes.
      445        // --- start ---
      446       THIS-OBJECT:Criterion no-error.
      447       THIS-OBJECT:Gifts no-error.
      448       THIS-OBJECT:GoodsAppl no-error.
      449       THIS-OBJECT:CardsBin no-error.
      450       THIS-OBJECT:Promoset no-error.
      451       THIS-OBJECT:GoodsCrits no-error.
      452       this-object:Objects no-error.
      453       THIS-OBJECT:Schedule no-error.
      454       THIS-OBJECT:ScheduleWeek no-error.
      455        // --- end ---
      456       this-object:refreshObj = no.
      457     end method.
      458     destructor public promoactionsub ( ):
      459       Clean().
      460       delete object vpromotype no-error.
      461     end destructor.
      462   end class.
