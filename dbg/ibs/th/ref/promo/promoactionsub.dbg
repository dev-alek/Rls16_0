      241     define property GoodsCrits as CLASS promogoodssubs no-undo
      242       get():
      243          DEFINE VARIABLE vStorageOBj AS CLASS promoGoodsStorage.
      244          IF     this-object:refreshObj
      245             and not valid-object (GoodsCrits)
      246          THEN DO :
      247             vStorageOBj = NEW promoGoodsStorage().
      248             GoodsCrits = vStorageOBj:getpromoGoodssubs(id,ibs.th.ref.promo.enum-promo-goods-type:criterion,db-num,objCode).
      249             delete OBJECT vStorageOBj no-error.
      250          END.
      251          RETURN GoodsCrits.
      252       END.
      253       set(arg as CLASS promogoodssubs):
      254           GoodsCrits = arg.
      255           setFlagChange (true).
      256       END.
      257     define property CritgoodsFl as logical no-undo init ?
      258       get():
      259         return if CritgoodsFl eq ?
      260           then if valid-object (this-object:GoodsCrits)
      261           then GoodsCrits:iCounter ne 0
      262           else no
      263           else no.
      264       end.
      265       set.
