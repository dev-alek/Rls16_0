        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.*.
        3   using ibs.th.ref.promo.*.
        4   block-level on error undo, throw.
        5   class ibs.th.ref.promo.promoActionSubs inherits asubjects:
        6   define variable vss-revision    as character no-undo initial "$Revision: 18f7b619da54, 1481, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: DARuban $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Thu Aug 30 10:41:44 2018 +0300 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: promoactionsubs.cls $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/promo/promoactionsubs.cls $":U .
       11   define variable vss-description as character no-undo initial "Коллекция объектов акций.".
       12     define property promoActionObjCurr as class promoActionSub
       13       get:
       14         return cast (SubjectObjCurr, promoActionSub).
       15       end.
       16   end class.
