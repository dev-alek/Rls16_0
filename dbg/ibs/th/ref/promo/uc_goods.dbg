      211     method Public VOID SetBind( ):
      212       define variable vLable as character no-undo.
      213       if mCrit
      214         then assign
      215           mBind  = "PromoGoodsCrit"
      216           vLable = "Независимые условия"
      217           .
      218       else if PromoSet
      219           then assign
      220             mBind  = "PromoSet"
      221             vLable = "Промо набор"
      222             .
      223         else if PromoSetFix
      224             then assign
      225               mBind  = "PromoSet"
      226               vLable = "Промо набор"
      227               .
      228           else if PromoSetgoods
      229               then assign
      230                 mBind  = "PromoSetgoods"
      231                 vLable = "Товары"
      232                 .
      233             else if Promovisa
      234                 then  assign
      235                   mBind  = "PromoCardsBin"
      236                   vLable = "Карты Visa"
      237                   .
      238               else if PromoBarCode
      239                   then assign
      240                     mBind  = "PromoBarCode"
      241                     vLable = "Штрих коды"
      242                     .
      243                 else if PromoBarCodeFix
      244                     then assign
      245                       mBind  = "PromoBarCode"
      246                       vLable = "Штрих коды"
      247                       .
      248                   else if PromoGoodsApplFix
      249                       then assign
      250                         mBind  = "PromoGoodsApplFix"
      251                         vLable = "Товары"
      252                         .
      253                     else if PromoGoodsFix
      254                     then assign
      255                     mBind = "PromoGoodsFix"
      256                     vLable = "Товары"
      257                     .
      258                     else assign
      259                         mBind  = "PromoGoodsAppl"
      260                         vLable = "Товары"
      261                         .
      262       SetBind(no).
      263       label1:text = vLable.
      264       if PromoSet
      265         then assign
