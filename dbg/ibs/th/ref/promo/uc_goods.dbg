      371     method Public VOID SetBind(input iflag as logical ):
      372       bindGoods:handle = m-promo-trg:getQuery(mBind,iflag).
      373       setDisable(m-promo-trg:modeVIEW).
      374       if iflag
      375         then
      376         bindGoods:RefreshAll().
      377     end method.
      378     method Public VOID LocalEvent(input iEvent as character, input iEventParam as character  ):
      379       if iEvent eq "changePromoSet" and promosetgoods
      380         then
      381         SetBind(yes).
      382       else if iEvent eq "showDiscontForset" and promoset
      383           then assign
      384             THIS-OBJECT:dataGridView1:Columns[5]:HeaderText = "Скидка, %"
      385             THIS-OBJECT:dataGridView1:Columns[5]:Visible    = yes .
      386         else if iEvent eq "showPrice" and not promoset and not mCrit and not promosetgoods
      387             then assign
      388               THIS-OBJECT:dataGridView1:Columns[5]:HeaderText = "Цена, руб"
      389               THIS-OBJECT:dataGridView1:Columns[5]:Visible    = yes .
      390     end.
      391     method public VOID setDisable(input iModeView as logical  ):
      392       assign
      393         button1:enabled                               = not iModeview
      394         button2:enabled                               = not iModeview
      395         button3:enabled                               = not iModeview
      396         button5:enabled                               = not iModeview
      397         THIS-OBJECT:dataGridView1:Columns[3]:ReadOnly = iModeview
      398         THIS-OBJECT:dataGridView1:Columns[4]:ReadOnly = iModeview
      399         THIS-OBJECT:dataGridView1:Columns[5]:ReadOnly = iModeview
      400            //   THIS-OBJECT:dataGridView1:Columns[6]:ReadOnly = pMode
      401         .
      402     end.
