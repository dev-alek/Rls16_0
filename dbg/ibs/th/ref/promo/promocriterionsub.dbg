        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   USING ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.ref.promo.PromoCriterionSub implements ithsub:
        7   define variable vss-revision    as character no-undo initial "$Revision: 971568bb50e0, 1502, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: obrezanova $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Thu Aug 30 10:41:48 2018 +0300 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: promocriterionsub.cls $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/promo/promocriterionsub.cls $":U .
       12   define variable vss-description as character no-undo initial "Объект критерий акции.".
       13     define property Msg as character no-undo
       14       get.
       15       set.
       16       define property StatusErr as logical no-undo
       17       get:
       18         def var err as log no-undo.
       19         err = StatusErr.
       20         StatusErr = false.
       21         return err.
       22       end.
       23       private set.
       24     define property ID as int64 no-undo
       25       get.
       26       set (ID-arg as int64):
       27         ID = ID-arg.
       28       end.
       29       define property db-num as integer  no-undo
       30       get.
       31       set(arg as integer ):
       32         if arg <> db-num
       33         then do:
       34           db-num = arg.
       35           setFlagChange (true).
       36         end.
       37       end.
       38     define property mincrit as dec no-undo
       39       get.
       40       SET (arg as dec):
       41         if arg <> mincrit
       42         then do:
       43           mincrit = arg.
       44           setFlagChange (true).
       45         end.
       46       END.
       47     define property maxcrit as dec no-undo
       48       get.
       49       SET (arg as dec):
       50         if arg <> maxcrit
       51         then do:
       52           maxcrit = arg.
       53           setFlagChange (true).
       54         end.
       55       END.
       56     define property idAction as int64 no-undo
       57       get.
       58       set(arg as int64):
       59         if arg <> idAction
       60         then do:
       61           idAction = arg.
       62           setFlagChange (true).
       63         end.
       64       END.
       65     define property discont as dec no-undo
       66       get.
       67       set(arg as dec):
       68         if arg <> discont
       69         then do:
       70           discont = arg.
       71           setFlagChange (true).
       72         end.
       73       END.
       74       define property Gifts as CLASS promoGiftsubs no-undo
       75       get():
       76          DEFINE VARIABLE vStorageOBj AS CLASS promoGiftStorage.
       77          IF     this-object:refreshObj
       78             and not valid-object (Gifts)
       79          THEN DO :
       80             vStorageOBj = NEW promoGiftStorage().
       81             Gifts = vStorageOBj:getpromoGiftSubs(idAction,id,db-num).
       82             delete OBJECT vStorageOBj no-error.
       83          END.
       84          RETURN Gifts.
       85       END.
       86       set(arg as CLASS promoGiftsubs):
       87           Gifts = arg.
       88           setFlagChange (true).
       89       END.
       90       define property Mode as char no-undo init 'и':U
       91       get.
       92       set.
       93       define property Changed as logical no-undo
       94       get.
       95       set.
       96     constructor public promoCriterionsub (  ):
       97     end constructor.
       98     method public void setMsg( arg as character ):
       99       Msg = arg.
      100     end.
      101     method public void setStatusErr( arg as logical ):
      102       StatusErr = arg.
      103     end.
      104     method public void setFlagChange( arg as logical ):
      105       Changed = arg.
      106     end.
      107     define private property refreshObj as logical no-undo
      108       get.
      109       set.
      110     method public void Clean():
      111        if valid-object(THIS-OBJECT:Gifts)      then delete object THIS-OBJECT:Gifts no-error.
      112     end.
      113     method public void refreshChildObj():
      114        Clean().
      115        this-object:refreshObj = yes.
      116        THIS-OBJECT:Gifts no-error.
      117        this-object:refreshObj = no.
      118     end.
      119     destructor public promocriterionsub ( ):
      120        Clean().
      121     end destructor.
      122   end class.
