      797           METHOD PRIVATE VOID radioButton6_CheckedChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      798           if radioButton6:Checked then do: // детальное -> простое
      799              // 16/VIII-2018 - отменено копирование расписания при переключении
      800              radioButton6:ForeColor  = System.Drawing.Color:Green.
      801              radioButton5:ForeColor  = System.Drawing.Color:Black.
      802              tableL_Detailed:Visible = false.
      803              tableL_Easily:Visible = true.
      804           end.
      805           else do: // простое -> детальное
      806              // 16/VIII-2018 - отменено копирование расписания при переключении
      807              radioButton6:ForeColor  = System.Drawing.Color:Black.
      808              radioButton5:ForeColor  = System.Drawing.Color:Green.
      809              tableL_Easily:Visible = false.
      810              tableL_Detailed:Visible = true.
      811           end.
      812                   RETURN.
      813           END METHOD.
      814     @VisualDesigner.
      815     METHOD PRIVATE VOID dataGridView1_CellFormatting(
      816      INPUT sender AS System.Object
      817    , INPUT e      AS System.Windows.Forms.DataGridViewCellFormattingEventArgs ):
      818      define variable v-iday as integer no-undo .
      819      // выводить наименования дней недели вместо номеров дней недели
      820      if (dataGridView1:Columns[e:ColumnIndex]:Name = "wdaynum") then do :
      821        v-iday = e:Value .
      822        if v-iday > 0 then assign
      823          e:Value = a-week-days[v-iday]
      824          e:FormattingApplied = true
      825        .
      826      end .
      827       RETURN.
      828     END METHOD.
      829     @VisualDesigner.
      830     METHOD PRIVATE VOID dateTimePicker3_ValueChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      831       dateTimePicker4:MinDate = dateTimePicker3:Value .
      832       RETURN.
      833     END METHOD.
      834     @VisualDesigner.
      835     METHOD PRIVATE VOID button9_Click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      836       define variable v-has-errors as logical no-undo .
      837         if tableLayoutPanel1:Visible then do :
      838           // добавить введённые данные в список и закрыть панель
      839            dateTimePicker3:Value = dateTimePicker3:Value .
      840            dateTimePicker4:Value = dateTimePicker4:Value .
      841            bindingSchedWeek3:Assign().
      842            v-has-errors = m-promo-trg:add2Detail("promoSchedWeek2") .
      843            if v-has-errors then
      844              bindingSchedWeek3:Refresh() .
      845            else assign
      846              button1:Text = "Удалить"
      847              tableLayoutPanel1:Visible = false
      848            .
      849         end .
      850         else assign
      851           button1:Text = "Не добавлять"
      852           tableLayoutPanel1:Visible = true
      853         .
      854       RETURN.
      855     END METHOD.
      856     @VisualDesigner.
      857     METHOD PRIVATE VOID button1_Click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      858         if tableLayoutPanel1:Visible then do :
      859           tableLayoutPanel1:Visible = false .
      860           button1:Text = "Удалить" .
      861         end .
      862         else do :
      863           // удалить из списка строку под курсором; панель не открывать
      864            m-promo-trg:delFromDetail("promoSchedWeek2") .
      865         end .
      866       RETURN.
      867     END METHOD.
      868           @VisualDesigner.
      869           METHOD PRIVATE VOID textBox1_TextChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      870                   label8:Text = textBox1:Text .
      871                   RETURN.
