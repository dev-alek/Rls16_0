        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.promo.promoType:
        4   define variable vss-revision    as character no-undo initial "$Revision: 38e7c64866ed, 3182, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        6   define variable vss-date        as character no-undo initial "$Date: 2022/12/27 12:54:25 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: promoType.cls $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/promo/promoType.cls $":U .
        9   define variable vss-description as character no-undo initial "Типы для акций.".
       10    define temp-table tt-type
       11       field list  as character
       12       field item as character
       13       field code  as integer
       14    index  item list item
       15    index  code list code
       16    .
       17    define temp-table ttTypeOut
       18       field list  as character
       19       field item as character
       20       field code  as integer
       21    index  item list item
       22    index  code list code
       23    .
       24   CONSTRUCTOR PUBLIC promoType(  ):
       25       TypeDiscontrefresh().
       26       methodCalcrefresh().
       27       typecondrefresh().
       28       Status_refresh().
       29   end.
       30   define property TypeDiscontListAll as character init "Временная скидка,Промо-набор,Карта Visa" no-undo
       31   get.
       32   define property TypeDiscontList    as character  no-undo
       33       get():
       34          return if TypeDiscontList = ""
       35                 then TypeDiscontListAll
       36                 else TypeDiscontList.
       37       end.
       38       private set.
       39    method public void TypeDiscontrefresh():
       40    define variable vi as integer  no-undo.
       41        for each tt-type  where tt-type.list  = "TypeDiscont" :
       42            delete tt-type.
       43        end.
       44        do vi = 1 to num-entries(TypeDiscontList):
       45            create tt-type.
       46            assign
       47               tt-type.list  = "TypeDiscont"
       48               tt-type.item  = entry(vi,TypeDiscontList)
       49               tt-type.code  = lookup (tt-type.item, TypeDiscontListAll) - 0
       50            .
       51       end.
       52   end.
       53   method public character TypeDiscontLbl (intSts as integer ):
       54       return typeLbl("TypeDiscont",intSts).
       55   end.
       56   method public integer TypeDiscontInt (charSts as character):
       57       return typeInt("TypeDiscont",charSts).
       58   end.
       59   define property methodCalcListAll as character init "Скидка процентом,Абсолютная (скидка суммой от цены),Скидка количеством,Скидка процентом за количество,Фиксированная цена,Выдача сообщения,Подарок" no-undo
       60   get.
       61   define property methodCalcList    as character  no-undo
       62       get():
       63          return if methodCalcList = ""
       64                 then methodCalcListAll
       65                 else methodCalcList.
       66       end.
       67       private set.
       68    method public void methodCalcrefresh():
       69    define variable vi as integer  no-undo.
       70        for each tt-type  where tt-type.list  = "methodCalc" :
       71            delete tt-type.
       72        end.
       73        do vi = 1 to num-entries(methodCalcList):
       74            create tt-type.
       75            assign
       76               tt-type.list  = "methodCalc"
       77               tt-type.item  = entry(vi,methodCalcList)
       78               tt-type.code  = lookup (tt-type.item, methodCalcListAll) - 0
       79            .
       80       end.
       81   end.
       82   method public character methodCalcLbl (intSts as integer ):
       83       return typeLbl("methodCalc",intSts).
       84   end.
       85   method public integer methodCalcInt (charSts as character):
       86       return typeInt("methodCalc",charSts).
       87   end.
       88   define property typecondListAll as character init "Количество по строке,Сумма по строке,Сумма в документе,Скидка по ШК,Скидка по картам лояльности" no-undo
       89   get.
       90   define property typecondList    as character  no-undo
       91       get():
       92          return if typecondList = ""
       93                 then typecondListAll
       94                 else typecondList.
       95       end.
       96       private set.
       97    method public void typecondrefresh():
       98    define variable vi as integer  no-undo.
       99        for each tt-type  where tt-type.list  = "typecond" :
      100            delete tt-type.
      101        end.
      102        do vi = 1 to num-entries(typecondList):
      103            create tt-type.
      104            assign
      105               tt-type.list  = "typecond"
      106               tt-type.item  = entry(vi,typecondList)
      107               tt-type.code  = lookup (tt-type.item, typecondListAll) - 0
      108            .
      109       end.
      110   end.
      111   method public character typecondLbl (intSts as integer ):
      112       return typeLbl("typecond",intSts).
      113   end.
      114   method public integer typecondInt (charSts as character):
      115       return typeInt("typecond",charSts).
      116   end.
      117   define property Status_ListAll as character init "Настройки в работе,Активная,Заблокирована" no-undo
      118   get.
      119   define property Status_List    as character  no-undo
      120       get():
      121          return if Status_List = ""
      122                 then Status_ListAll
      123                 else Status_List.
      124       end.
      125       private set.
      126    method public void Status_refresh():
      127    define variable vi as integer  no-undo.
      128        for each tt-type  where tt-type.list  = "Status_" :
      129            delete tt-type.
      130        end.
      131        do vi = 1 to num-entries(Status_List):
      132            create tt-type.
      133            assign
      134               tt-type.list  = "Status_"
      135               tt-type.item  = entry(vi,Status_List)
      136               tt-type.code  = lookup (tt-type.item, Status_ListAll) - 1
      137            .
      138       end.
      139   end.
      140   method public character Status_Lbl (intSts as integer ):
      141       return typeLbl("Status_",intSts).
      142   end.
      143   method public integer Status_Int (charSts as character):
      144       return typeInt("Status_",charSts).
      145   end.
      146   method public character typeLbl (ilist as character ,intType as integer ):
      147       find first tt-type where tt-type.list eq ilist
      148                            and tt-type.code eq intType
      149                            no-error.
      150       return if available tt-type then tt-type.item else ?.
      151   end.
      152   method public integer typeInt (ilist as character ,chartype as character):
      153       find first tt-type where tt-type.list eq ilist
      154                            and tt-type.item eq charType
      155                            no-error.
      156       return if available tt-type then tt-type.code else ?.
      157   end.
      158   method public void typeTable (ilist as character,output table ttTypeOut ):
      159       define variable vi as integer  no-undo.
      160       define buffer tt-type for tt-type.
      161       for each ttTypeOut:
      162           delete ttTypeOut.
      163       end.
      164       do vi = 1 to num-entries(ilist):
      165           for each tt-type where tt-type.list eq entry(vi,ilist):
      166               create ttTypeOut.
      167               buffer-copy tt-type to ttTypeOut.
      168           end.
      169       end.
      170   end.
      171   method public void CangeTypeDiscont (input iTypeDiscont as int):
      172       if iTypeDiscont eq 1
      173       then
      174          methodCalclist = methodCalclistall.
      175       else if iTypeDiscont eq 3
      176       then
      177          methodCalclist = "Подарок".
      178       else
      179          methodCalclist = "Скидка процентом,Фиксированная цена".
      180       methodCalcRefresh().
      181     end.
      182   method public void CangeTypeDiscontAndMethodCalc (input iTypeDiscont as int,input iMethodCalc as int):
      183       if iTypeDiscont = 1
      184       then do:
      185           if    iMethodCalc eq 1
      186              or iMethodCalc eq 6
      187              or iMethodCalc eq 7
      188           then
      189               TypeCondList = TypeCondListAll.
      190           else if  iMethodCalc eq 2
      191           then
      192               TypeCondList = "Количество по строке,Сумма по строке,Скидка по ШК".
      193           else if  iMethodCalc eq 5
      194           then
      195               TypeCondList = ",Скидка по ШК,Скидка по картам лояльности".
      196           else
      197               TypeCondList = "".
      198       end.
      199       else if iTypeDiscont = 3
      200       then do:
      201          TypeCondList = "Сумма в документе".
      202       end.
      203       else
      204           TypeCondList = "".
      205       TypeCondRefresh().
      206     end.
      207   end class.
