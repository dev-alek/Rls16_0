      176           METHOD PRIVATE VOID radioButton1_CheckedChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      177           if radioButton1:Checked then do:
      178              radioButton1:ForeColor  = System.Drawing.Color:Green.
      179              radioButton2:ForeColor  = System.Drawing.Color:Black.
      180              Show_Panet_SelectConditonItem(1).
      181           end.
      182           else do:
      183              radioButton1:ForeColor  = System.Drawing.Color:Black.
      184              radioButton2:ForeColor  = System.Drawing.Color:Green.
      185              Show_Panet_SelectConditonItem(2).
      186           end.
      187                   RETURN.
      188           END METHOD.
      189           METHOD public VOID Show_Panet_SelectConditonItem():
      190               Show_Panet_SelectConditonItem(if radioButton1:checked then 1 else 2).
      191           end.
      192           METHOD private VOID Show_Panet_SelectConditonItem( INPUT SelectItem AS int):
      193               THIS-OBJECT:panel_SelectConditionItems:Controls:Clear().
      194               clenObject().
      195                typeCond:visible = true.
      196                  ucMain7 = NEW ibs.th.ref.promo.uc_SelectsGCP().
      197               CASE SelectItem:
      198                       WHEN 1 then do:
      199                           ucMain7:PublicEvent("ViewGiftForAction", "").
      200                           ucMain7:INIT_Panel(no, no, no, yes).
      201                       END.
      202                   WHEN 2 then do:
      203                       ucMain7:INIT_Panel(no, no, yes, yes).
      204                       find first tttypeCond where tttypeCond.item eq typecond:Text no-lock no-error.
      205                       if available tttypeCond
      206                       then do:
      207                       if tttypeCond.code = 1 // "Количество по строке"
      208                       then do:
      209                           ucMain7:PublicEvent("CritLable", "Количество, ед#Диапазон действия,ед#?").
      210                       end.
      211                       else if tttypeCond.code = 2 // "Сумма по строке"
      212                       then do:
      213                           ucMain7:PublicEvent("CritLable", "Сумма, руб#Диапазон действия, Руб#?").
      214                       end.
      215                       else if tttypeCond.code = 3 // "Итог чека"
      216                       then do:
      217                           ucMain7:PublicEvent("CritLable", "Сумма, руб#Диапазон действия, Руб#?").
      218                       end.
      219                       else
      220                           ucMain7:PublicEvent("CritLable", "Количество / сумма#Диапазон действия#?").
      221                   end.
      222                   END.
      223            END.
      224            ucMain7:SetPromoTrg(m-promo-trg).
      225            ucMain7:Dock = System.Windows.Forms.DockStyle:Fill.
      226            THIS-OBJECT:panel_SelectConditionItems:Controls:Add(ucMain7).
      227            typeCond:visible = false.
      228              RETURN.
      229       END METHOD.
      230       METHOD public void clenObject():
      231           if valid-object(ucMain7)            then delete object ucMain7.
      232       end.
