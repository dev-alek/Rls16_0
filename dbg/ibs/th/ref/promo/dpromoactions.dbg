       73       constructor public dPromoActions(input p-mode as character, input p-promo-trg as class ibs.th.ref.promo.promo_trg):
       74         super().
       75           InitializeComponent ( ).
       76           m-promo-trg = p-promo-trg.
       77           INIT_TAB_CONTROLS().
       78               case p-mode:
       79               when 'ДОБАВЛЕНИЕ':U then do:
       80                   Disable_Field(false).
       81                   this-object:text = if m-promo-trg:ModeCopy
       82                                      then "Копирование промоакции"
       83                                      else "Создание промоакции".
       84               end .
       85               when 'ПРОСМОТР':U then do:
       86                   Disable_Field(true).
       87                   this-object:text = "Просмотр промоакции".
       88               end.
       89               when 'ИЗМЕНЕНИЕ':U then do:
       90                   if    m-promo-trg:ModeChangeStatus
       91                      or m-promo-trg:ModeEarlyTermination
       92                   then do:
       93                     Disable_Field(true).
       94                     buttonOk:enabled = yes.
       95                   end.
       96                   else
       97                      Disable_Field(false).
       98                   this-object:text =  if m-promo-trg:ModeChangeStatus
       99                                      then "Смена статуса промо акции"
      100                                      else if m-promo-trg:ModeEarlyTermination
      101                                      then "Досрочное завершение промоакции"
      102                                      else "Редактироване промоакции".
      103               end.
      104               otherwise do:
      105                   message "error" view-as alert-box.
      106               end.
      107               end case.        catch e as Progress.Lang.Error:
      108               undo, throw e.
      109           end catch.
      110       end constructor .
