      509       method public void viewpage6 (input iFlag as logical) :
      510           if iFlag
      511           then do:
      512              if tabControl1:TabPages:Count = 5 THEN
      513              tabControl1:TabPages:Add(tabPage6).
      514           end.
      515           else
      516           if tabControl1:TabPages:Count ne 5 then do:
      517              tabPage5save = tabControl1:TabPages[5].
      518              tabControl1:TabPages:Remove(tabPage6).
      519           end.
      520       end.
