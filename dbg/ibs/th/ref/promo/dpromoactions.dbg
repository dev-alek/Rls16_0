      498           method private void tabControl1_Selected( input sender as System.Object, input e as System.Windows.Forms.TabControlEventArgs ):
      499                   uc_TabPromoAction1:cleanPanel().
      500           uc_TabPresents1:clenObject().
      501           if tabControl1:SelectedIndex  = 5
