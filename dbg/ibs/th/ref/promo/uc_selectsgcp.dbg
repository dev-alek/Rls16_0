      205       METHOD PUBLIC VOID INIT_Panel(INPUT IsIndGoods as LOGICAL,INPUT IsGoods as LOGICAL, INPUT IsConditions as LOGICAL, INPUT IsPresents as LOGICAL, INPUT IsMess as LOGICAL, input isCritOne as logical):
      206           uc_Goods1:Visible = IsIndGoods.
      207           uc_Goods2:Visible = IsGoods.
      208           uc_Present1:Visible = IsPresents.
      209           uc_Conditions1:Visible = IsConditions.
      210           uc_Mess1:Visible = IsMess.
      211           uc_Canon1:Visible = isCritOne.
      212           define variable vMax   as integer no-undo.
      213           define variable vWidth as integer no-undo.
      214           define variable vCount as integer no-undo.
      215           vMax = (if IsIndGoods    then 1 else 0)
      216                + (if IsGoods       then 1 else 0)
      217                + (if IsPresents    then 1 else 0)
      218                + (if IsConditions  then 1 else 0)
      219                + (if IsMess        then 1 else 0).
      220           vWidth = 100 / vMax.
      221           vCount = vCount +  1.
      222           if vCount eq vMax then vWidth = 100 - (vMax - 1)* integer (100 / vMax) .
      223           if   not IsIndGoods
      224           then THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]:Width = 0.
      225           else THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]= NEW System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType:Percent, Progress.Util.CastUtil:ToSingle(vWidth)).
      226           vCount = vCount +  1.
      227           if vCount eq vMax then vWidth = 100 - (vMax - 1)* integer (100 / vMax) .
      228           if   not IsGoods
      229           then THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]:Width = 0.
      230           else THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]= NEW System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType:Percent, Progress.Util.CastUtil:ToSingle(vWidth)).
