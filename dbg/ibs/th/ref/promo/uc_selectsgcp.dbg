      232           if vCount eq vMax then vWidth = 100 - (vMax - 1)* integer (100 / vMax) .
      233           if   not IsConditions
      234           then THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]:Width = 0.
      235           else THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]= NEW System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType:Percent, Progress.Util.CastUtil:ToSingle(vWidth)).
      236           vCount = vCount +  1.
      237           if vCount eq vMax then vWidth = 100 - (vMax - 1)* integer (100 / vMax) .
      238           if   not IsPresents
      239           then THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]:Width = 0.
      240           else THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]= NEW System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType:Percent, Progress.Util.CastUtil:ToSingle(vWidth)).
      241            vCount = vCount +  1.
      242           if vCount eq vMax then vWidth = 100 - (vMax - 1)* integer (100 / vMax) .
      243           if   not IsMess
      244           then THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]:Width = 0.
      245           else THIS-OBJECT:tableLayoutPanel1:ColumnStyles[vCount - 1]= NEW System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType:Percent, Progress.Util.CastUtil:ToSingle(vWidth)).
      246       END METHOD.
