      540     METHOD PRIVATE VOID comboBox1_SelectedIndexChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      541       if  changecomboBox1
      542         then
      543         Show_Panet_SelectConditonItem().
      544     end.
      545     METHOD public VOID Show_Panet_SelectConditonItem():
      546       if radioButton3:checked
      547         then
      548       do:
      549         init_first_value_combobox(3).
      550         Show_Panet_SelectConditonItem(61).
      551         m-promo-trg:ViewPage6(no).
      552       end.
      553       else
      554       do:
      555         find first ttMethodCalc where ttMethodCalc.item eq comboBox1:SelectedItem:ToString() no-lock no-error.
      556         if available ttMethodCalc
      557           then
      558         do:
      559           Init_comboBox3(if radioButton3:checked then 3 else if radioButton2:checked then 2 else 1,ttMethodCalc.code).
      560           Init_comboBox_nUMBER(0).
      561           if ttMethodCalc.code eq 7
      562             then
      563             m-promo-trg:ViewPage6(no).
      564           else
      565             m-promo-trg:ViewPage6(yes).
      566           case ttMethodCalc.code:
      567             when 1 then
      568               do: // "Скидка процентом"
      569                 Show_Panet_SelectConditonItem(1).
      570                 Init_comboBox_nUMBER(1).
      571               end .
      572             when 2 then
      573               do: // Абсолютная (скидка суммой от цены)
      574                 Show_Panet_SelectConditonItem(2).
      575                 Init_comboBox_nUMBER(2).
      576               end .
      577             when 3 then
      578               do: // Скидка количеством
      579                 Show_Panet_SelectConditonItem(3).
      580                 Init_comboBox_nUMBER(3).
      581               end .
      582             when 4 then
      583               do: //Скидка процентом за количество
      584                 Show_Panet_SelectConditonItem(4).
      585                 Init_comboBox_nUMBER(4).
      586               end .
      587             when 5 then
      588               do: // Фиксированная цена
      589                 Show_Panet_SelectConditonItem(5).
      590                 Init_comboBox_nUMBER(5).
      591               end .
      592             when 6 then
      593               do: // Выдача сообщения
      594                 Show_Panet_SelectConditonItem(6).
      595                 Init_comboBox_nUMBER(6).
      596               end .
      597             when 7 then
      598               do: // "Подарок"
      599                 Show_Panet_SelectConditonItem(7).
      600                        //  tabControl1:TabPages:Remove(tabPage6).
      601               end .
      602           end case.
      603         end.
      604       end.
      605       RETURN.
      606     END METHOD.
      607     method public void cleanPanel():
      608       THIS-OBJECT:panel_SelectConditionItems:Controls:Clear().
      609       if valid-object(ucMain7)        then delete object ucMain7.
      610     end.
      611     METHOD PRIVATE VOID Show_Panet_SelectConditonItem( INPUT SelectItem AS int):
      612       cleanPanel().
      613       define variable vLoadForm as logical no-undo.
      614       assign
      615         label5:Visible    = FALSE
      616         checkBox1:Visible = label5:Visible
      617         .
      618       ucMain7 = NEW ibs.th.ref.promo.uc_SelectsGCP().
      619       case SelectItem:
      620         when 1 then
      621           do:
      622             IF radioButton1:Checked THEN
      623             DO:
      624               find first tttypeCond where tttypeCond.item eq comboBox3:SelectedItem:ToString() no-lock no-error.
      625               if available tttypeCond
      626                 then
      627               do:
      628                 if tttypeCond.code = 1 // "Количество по строке"
      629                   then
      630                 do:
      631                   ucMain7:INIT_Panel(checkBox1:Checked, yes, yes, no).
      632                   ucMain7:PublicEvent("CritLable", string(checkBox1:Checked) + "#Количество, ед#Диапазон действия,ед#Диапазон действия,ед#Скидка, %").
      633                   assign
      634                     label5:Visible    = true
      635                     checkBox1:Visible = label5:Visible
      636                     .
      637                   vLoadForm = yes.
      638                 end.
      639                 else IF tttypeCond.code = 2 // "Сумма по строке"
      640                     then
      641                   do:
      642                     ucMain7:INIT_Panel(checkBox1:Checked, yes, yes, no).
      643                     ucMain7:PublicEvent("CritLable", string(checkBox1:checked) + "#Сумма, руб#Диапазон действия, руб#Диапазон действия, руб#Скидка, %").
      644                     assign
      645                       label5:Visible    = true
      646                       checkBox1:Visible = label5:Visible
      647                       .
      648                     vLoadForm = yes.
      649                   end.
      650                 IF tttypeCond.code = 3 // "Итог чека"
      651                   then
      652                 do:
      653                   ucMain7:INIT_Panel(no, no, yes, no).
      654                   ucMain7:PublicEvent("CritLable", "Сумма, руб#Диапазон действия, руб#Скидка, %").
      655                   ucMain7:PublicEvent("swapCritAndDiscont", "").
      656                   vLoadForm = yes.
      657                 END.
      658                 if tttypeCond.code = 4 // "Скидка по ШК"
      659                   then
      660                 do:
      661                   ucMain7:INIT_BarCode(SelectItem).
      662                   ucMain7:PublicEvent("CritOneLableCode", "Скидка, %").
      663                   assign
      664                     label5:Visible    = false
      665                     checkBox1:Visible = false
      666                     .
      667                   vLoadForm = yes.
      668                 end.
      669               end.
      670             END.
      671             ELSE
      672             DO:
      673               ucMain7:INIT_PromoSet(SelectItem).
      674               ucMain7:PublicEvent("showDiscontForSet", "").
      675               ucMain7:PublicEvent("CritOneLable", "?").
      676               vLoadForm = yes.
      677             END.
      678           end .
      679         when 2 then
      680           do: // абсолютная
      681             find first tttypeCond where tttypeCond.item eq comboBox3:SelectedItem:ToString() no-lock no-error.
      682             if available tttypeCond
      683               then
      684             do:
      685               assign
      686                 label5:Visible    = true
      687                 checkBox1:Visible = label5:Visible
      688                 .
      689               if tttypeCond.code = 1 // "Количество по строке"
      690                 then
      691               do:
      692                 ucMain7:INIT_Panel(checkBox1:Checked, yes, yes, no).
      693                 ucMain7:PublicEvent("CritLable", string(checkBox1:checked) + "#Количество, ед#Диапазон действия,ед#Диапазон действия,ед#Скидка, руб").
      694                 vLoadForm = yes.
      695               end.
      696               else if tttypeCond.code = 2 // "Сумма по строку"
      697                   then
      698                 do:
      699                   ucMain7:INIT_Panel(checkBox1:Checked, yes, yes, no).
      700                   ucMain7:PublicEvent("CritLable", string(checkBox1:checked) + "#Сумма, руб#Диапазон действия, руб#Диапазон действия, руб#Скидка, руб").
      701                   vLoadForm = yes.
      702                 end.
      703                 else if tttypeCond.code = 4 // "Скидка по ШК"
      704                 then
      705               do:
      706                 assign
      707                   label5:Visible    = false
      708                   checkBox1:Visible = false
      709                   .
      710                 ucMain7:INIT_BarCode(SelectItem).
      711                 ucMain7:PublicEvent("CritOneLableCode", "Скидка, абс").
      712                 vLoadForm = yes.
      713               end.
      714             end.
      715           end .
      716         when 3 then
      717           do: // Скидка количеством
      718             ucMain7:INIT_Panel(no, yes, no, no, no,yes).
      719             ucMain7:PublicEvent("CritOneLable", "Бесплатно#из").
      720             ucMain7:PublicEvent("swapCritAndDiscont", "").
      721             vLoadForm = yes.
      722           end .
      723         when 4 then
      724           do: //Скидка процентом за количество
      725             ucMain7:INIT_Panel(no, yes, no, no, no, yes).
      726             ucMain7:PublicEvent("CritOneLable", "Каждый#со скидкой#%").
      727             vLoadForm = yes.
      728           end .
      729         when 5 then
      730           do: // Фиксированная цена
      731             IF radioButton1:Checked THEN
      732             DO:
      733               find first tttypeCond where tttypeCond.item eq comboBox3:SelectedItem:ToString() no-lock no-error.
      734               if available tttypeCond
      735                 then
      736               do:
      737                 if tttypeCond.code = 4 // "Скидка по ШК"
      738                   then
      739                 do:
      740                   ucMain7:INIT_BarCode(SelectItem).
      741                   ucMain7:PublicEvent("NotOneLable", "").
      742                   assign
      743                     label5:Visible    = false
      744                     checkBox1:Visible = false
      745                     .
      746                   vLoadForm = yes.
      747                 end.
      748                 if tttypeCond.code = 5 // "Скидка по картам лояльности"
      749                   then
      750                 do:
      751                   ucMain7:INIT_GoodsFix(SelectItem).
      752                   ucMain7:PublicEvent("NotOneLable", "").
      753                   assign
      754                     label5:Visible    = false
      755                     checkBox1:Visible = false
      756                     .
      757                   vLoadForm = yes.
      758                 end.
      759               end .
      760               else do:
      761                   ucMain7:INIT_GoodsFix(SelectItem).
      762                   ucMain7:PublicEvent("NotOneLable", "").
      763                   assign
      764                     label5:Visible    = false
      765                     checkBox1:Visible = false
      766                     .
      767                   vLoadForm = yes.
      768               end.
      769             END.
      770             ELSE
      771             DO:
      772                 ucMain7:INIT_PromoSet(SelectItem).
      773                 ucMain7:PublicEvent("CritOneLable", "?#Цена, руб").
      774                 vLoadForm = yes.
      775             end.
      776           END.
      777         when 6 then
      778           do:
      779             find first tttypeCond where tttypeCond.item eq comboBox3:SelectedItem:ToString() no-lock no-error.
      780             if available tttypeCond
      781               then
      782             do:
      783               if tttypeCond.code = 1 // "Количество по строке"
      784                 then
      785               do:
      786                 ucMain7:INIT_Panel(checkBox1:Checked, no, no, no,yes,yes).
      787                 ucMain7:PublicEvent("CritOneLable", "Количество от, ед").
      788                 assign
      789                   label5:Visible    = true
      790                   checkBox1:Visible = label5:Visible
      791                   vLoadForm         = yes
      792                   .
      793               end.
      794               else if    tttypeCond.code = 2 // "Сумма по строке"
      795                   or tttypeCond.code = 3 // "Итог чека"
      796                   then
      797                 do :
      798                   ucMain7:INIT_Panel(if tttypeCond.code = 3 then no else checkBox1:Checked, no, no, no,yes,yes).
      799                   ucMain7:PublicEvent("CritOneLable", "Сумма от, руб").
      800                   vLoadForm = yes.
      801                   if    tttypeCond.code = 2 then
      802                     assign
      803                       label5:Visible    = true
      804                       checkBox1:Visible = label5:Visible
      805                       .
      806                 end.
      807             end.
      808           end .
      809         when 7 then
      810           do:
      811             find first tttypeCond where tttypeCond.item eq comboBox3:SelectedItem:ToString() no-lock no-error.
      812             if available tttypeCond
      813               then
      814             do:
      815               if tttypeCond.code = 1 // "Количество по строке"
      816                 then
      817               do:
      818                 ucMain7:INIT_Panel(no, yes, yes, yes).
      819                 ucMain7:PublicEvent("CritLable", "Количество, ед#Диапазон действия,ед#?").
      820                 vLoadForm = yes.
      821               end.
      822               else if tttypeCond.code = 2 // "Сумма по строке"
      823                   then
      824                 do:
      825                   ucMain7:INIT_Panel(no, yes, yes, yes).
      826                   ucMain7:PublicEvent("CritLable", "Сумма, руб#Диапазон действия, Руб#?").
      827                   vLoadForm = yes.
      828                 end.
      829                 else if tttypeCond.code = 3 // "Итог чека"
      830                     then
      831                   do:
      832                     ucMain7:INIT_Panel(no, no, yes, yes).
      833                     ucMain7:PublicEvent("CritLable", "Сумма, руб#Диапазон действия, Руб#?").
      834                     vLoadForm = yes.
      835                   end.
      836             end.
      837           end .
      838         when 61 then
      839           do:
      840             ucMain7:INIT_visa().
      841             ucMain7:PublicEvent("CritOneLable", "Сумма от, руб").
      842             ucMain7:PublicEvent("ViewGiftForAction", "").
      843             vLoadForm = yes.
      844           end.
      845       end case.
      846       if vLoadForm
      847         then
      848       do:
      849         ucMain7:SetPromoTrg(m-promo-trg).
      850         ucMain7:Dock = System.Windows.Forms.DockStyle:Fill.
      851         THIS-OBJECT:panel_SelectConditionItems:Controls:Add(ucMain7).
      852       end.
      853       else
      854         delete object ucMain7.
      855       RETURN.
      856     END METHOD.
