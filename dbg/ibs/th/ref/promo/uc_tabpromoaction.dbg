      104     METHOD PUBLIC VOID Enabled_Controls(INPUT sender AS LOGICAL):
      105         //  panel_SelectConditionItems:Enabled = sender.
      106       tableLayoutPanel6:Enabled = sender.
      107       label6:Enabled = sender.
      108       comboBox3:Enabled = sender.
      109     END METHOD.
      110     define variable changecomboBox1 as logical no-undo init yes.
      111     METHOD PRIVATE VOID Init_comboBox1(INPUT sender AS integer ):
      112       define variable vtext as character no-undo.
      113       vtext = comboBox1:text.
      114       comboBox1:Items:Clear().
      115       m-promo-type:CangeTypeDiscont(sender).
      116       m-promo-type:typeTable("methodCalc", output table ttMethodCalc).
      117       for each ttMethodCalc:
      118         comboBox1:Items:Add(ttMethodCalc.item).
      119         if ttMethodCalc.item eq vtext
      120           then
      121         do:
      122           changecomboBox1 = no.
      123           comboBox1:text = vtext.
      124           changecomboBox1 = yes.
      125         end.
      126       end.
      127       IF sender eq 1 THEN
      128       DO:
      129         label2:Visible = true.
      130         comboBox1:Visible = true.
      131         label5:Visible = TRUE.
      132         label6:Visible = TRUE.
      133         checkBox1:Visible = TRUE.
      134         comboBox3:Visible = TRUE.
      135       END.
      136       ELSE
      137       DO:
      138         IF sender eq 2
      139           then
      140         do:
      141           label2:Visible = true.
      142           comboBox1:Visible = true.
      143           label5:Visible = TRUE.
      144           checkBox1:Visible = TRUE.
      145           label6:Visible = FALSE.
      146           comboBox3:Visible = FALSE.
      147         end.
      148         else
      149         do:
      150           label2:Visible = true.
      151           comboBox1:Visible = true.
      152           checkBox1:Visible = false.
      153           label6:Visible = true.
      154           comboBox3:Visible = true.
      155         end.
      156       END.
      157     END METHOD.
      158     METHOD PRIVATE VOID Init_comboBox_nUMBER(INPUT sender AS INTEGER):
      159       IF radioButton1:Checked THEN
      160       DO:
      161         label5:Visible = TRUE.
      162         label6:Visible = TRUE.
      163         checkBox1:Visible = TRUE.
      164         comboBox3:Visible = TRUE.
      165       END.
      166       if comboBox3:Text = "Скидка по ШК"
      167        then do:
      168         label5:Visible = false.
      169         checkBox1:Visible = false.
      170         m-promo-trg:ViewPage6(no).
      171       end.
      172       IF sender = 3  THEN
      173       DO:
      174         label5:Visible = FALSE.
      175         label6:Visible = FALSE.
      176         checkBox1:Visible = FALSE.
      177         comboBox3:Visible = FALSE.
      178       END.
      179       IF sender = 4  THEN
      180       DO:
      181         label5:Visible = FALSE.
      182         label6:Visible = FALSE.
      183         checkBox1:Visible = FALSE.
      184         comboBox3:Visible = FALSE.
      185       END.
      186       IF sender = 5  THEN
      187       DO:
      188         label5:Visible = FALSE.
      189         checkBox1:Visible = FALSE.
      190       END.
      191     END METHOD.
      192     define variable changecomboBox3 as logical no-undo init yes.
      193     METHOD PRIVATE VOID Init_comboBox3(INPUT itypeDiscont AS integer ,input iMethodCalc as integer ):
      194       define variable vtext as character no-undo.
      195       vtext = comboBox3:text.
      196       comboBox3:Items:Clear().
      197       label5:Text = "Независимые условия:".
      198       m-promo-type:CangeTypeDiscontAndMethodCalc(itypeDiscont,iMethodCalc).
      199       m-promo-type:typeTable("typecond", output table tttypecond).
      200       for each tttypecond:
      201         comboBox3:Items:Add(tttypecond.item).
      202         if tttypecond.item eq vtext
      203           then
      204         do:
      205           changecomboBox3 = no.
      206           comboBox3:text = vtext.
      207           changecomboBox3 = yes.
      208         end.
      209       end.
      210     END METHOD.
      211     METHOD PRIVATE VOID init_first_value_combobox(itypeDiscont as integer ):
      212       m-promo-type:CangeTypeDiscont(itypeDiscont).
      213       m-promo-type:typeTable("methodCalc", output table ttMethodCalc).
      214       for first ttMethodCalc:
      215         comboBox1:text = ttMethodCalc.item.
      216       end.
      217       if available ttMethodCalc
      218         then
      219       do:
      220         m-promo-type:CangeTypeDiscontAndMethodCalc(itypeDiscont,ttMethodCalc.code).
      221         m-promo-type:typeTable("typecond", output table tttypecond).
      222         for first tttypecond:
      223           comboBox3:text = tttypecond.item.
      224         end.
      225       end.
      226     END METHOD.
