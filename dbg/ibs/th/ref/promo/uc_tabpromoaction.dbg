      481     METHOD PRIVATE VOID radioButton1_CheckedChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      482       define variable vrabiobat as integer no-undo.
      483       THIS-OBJECT:panel_SelectConditionItems:Controls:Clear().
      484       Init_comboBox_nUMBER(0).
      485       if radioButton3:Checked then
      486       do:
      487         radioButton1:ForeColor  = System.Drawing.Color:Black.
      488         radioButton2:ForeColor  = System.Drawing.Color:Black.
      489         radioButton3:ForeColor  = System.Drawing.Color:Green.
      490         Show_Panet_SelectConditonItem().
      491       end.
      492       else
      493       do:
      494         if radioButton2:Checked then
      495         do:
      496           radioButton1:ForeColor  = System.Drawing.Color:Black.
      497           radioButton2:ForeColor  = System.Drawing.Color:Green.
      498           radioButton3:ForeColor  = System.Drawing.Color:Black.
      499         end.
      500         else
      501         do:
      502           radioButton1:ForeColor  = System.Drawing.Color:Green.
      503           radioButton2:ForeColor  = System.Drawing.Color:Black.
      504           radioButton3:ForeColor  = System.Drawing.Color:Black.
      505         end.
      506       end.
      507       vrabiobat = if radioButton3:checked then 3 else if radioButton2:checked then 2 else 1.
      508       Init_comboBox1(vrabiobat).
      509       find first ttMethodCalc where ttMethodCalc.item eq comboBox1:SelectedItem:ToString() no-lock no-error.
      510       if available ttMethodCalc
      511         then
      512         Init_comboBox3(vrabiobat,ttMethodCalc.code).
      513       RETURN.
      514     END METHOD.
      515     @VisualDesigner.
      516     METHOD PRIVATE VOID comboBox3_SelectedIndexChanged( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      517       if changecomboBox3
      518         then
      519       do:
      520         IF radioButton1:Checked THEN
      521         DO:
      522           find first ttMethodCalc where ttMethodCalc.item eq comboBox1:SelectedItem:ToString() no-lock no-error.
      523           if available ttMethodCalc then
      524           do:
      525             Show_Panet_SelectConditonItem(ttMethodCalc.code ).
      526           end.
      527         END.
      528         else
      529         DO:
      530           find first ttMethodCalc where ttMethodCalc.item eq comboBox1:SelectedItem:ToString() no-lock no-error.
      531           if available ttMethodCalc then
      532           do:
      533             Show_Panet_SelectConditonItem(ttMethodCalc.code ).
      534           end.
      535         END.
      536       end.
      537       RETURN.
      538     END METHOD.
