      350     define property Msg as character no-undo
      351       get.
      352       set.
      353     define property Mode as char no-undo init 'и':U
      354       get.
      355     set.
      356     define property StatusErr as logical no-undo
      357       get:
      358         def var err as log no-undo.
      359         err = StatusErr.
      360         StatusErr = false.
      361         return err.
      362       end.
      363       private set.
      364     define property ID as int64 init ?  no-undo
      365       get.
      366       set (ID-arg as int64):
      367         ID = ID-arg.
      368       end.
      369     define property db-num as integer init ?  no-undo
      370       get.
      371       set(arg as int):
      372         if arg <> db-num
      373           then
      374         do:
      375           db-num = arg.
      376           setFlagChange (true).
      377         end.
      378       end.
      379     define property idSet as int64 no-undo
      380       get.
      381       set(arg as int64):
      382         if arg <> idSet
      383           then
      384         do:
      385           idSet = arg.
      386           setFlagChange (true).
      387         end.
      388       end.
      389     define property qnty as decimal  no-undo
      390       get.
      391       set(arg as decimal ):
      392         if arg <> qnty
      393           then
      394         do:
      395           qnty = arg.
      396           setFlagChange (true).
      397         end.
      398       end.
      399     define property NameSet as character  no-undo
      400       get.
      401       set(arg as character  ):
      402         if arg <> NameSet
      403           then
      404         do:
      405           NameSet = arg.
      406           setFlagChange (true).
      407         end.
      408       end.
      409     define property price as decimal  init ?  no-undo
      410       get.
      411       set(arg as decimal ):
      412         if arg <> price
      413           then
      414         do:
      415           price = arg.
      416           setFlagChange (true).
      417         end.
      418       end.
      419     define buffer buf_PromoAttr for ub.PromoAttr .
      420     define property promotion-code as character  init ""  no-undo
      421       get.
      422       set(arg as character ):
      423         if arg <> promotion-code
      424           then
      425         do:
      426           promotion-code = arg.
      427           setFlagChange (true).
      428         end.
      429       end.
      430     define property type as int no-undo
      431       get.
      432       SET (arg as int):
      433         if arg <> type
      434           then
      435         do:
      436           type = arg.
      437           setFlagChange (true).
      438         end.
      439       END.
      440     define property idAction as int64 no-undo
      441       get.
      442       set(arg as int64):
      443         if arg <> idAction
      444           then
      445         do:
      446           idAction = arg.
      447           setFlagChange (true).
      448         end.
      449       END.
      450     define property objCode as integer no-undo
      451       get.
      452       set(arg as integer):
      453         if arg <> objCode
      454           then
      455         do:
      456           objCode = arg.
      457           setFlagChange (true).
      458         end.
      459       end.
      460     define buffer bf_gds for ub.goods.
      461     define property GdsCode as integer no-undo
      462       get.
      463       set(arg as integer):
      464         if arg <> GdsCode
      465           then
      466         do:
      467           GdsCode = arg.
      468           release bf_gds.
      469           setFlagChange (true).
      470         end.
      471       END.
      472     define property GdsName as character no-undo
      473       get:
      474         if available (bf_gds)
      475           then
      476         do:
      477           return bf_gds.gds-name.
      478         end.
      479         else
      480         do:
      481           find first bf_gds no-lock
      482             where bf_gds.gds-code = GdsCode no-error.
      483           if available (bf_gds)
      484             then
      485           do:
      486             return bf_gds.gds-name.
      487           end.
      488           else return "".
      489         end.
      490       end.
      491     define property dtSeason as character no-undo
      492       get:
      493         define variable typeAttr as character no-undo.
      494         if not available (bf_gds) then
      495         do:
      496           find first bf_gds no-lock
      497             where bf_gds.gds-code = GdsCode no-error.
      498         end.
      499         if available (bf_gds) then
      500         do:
      501             return
      502               gdsoattr-value(
      503                 'dt-seasons':U,
      504                 gdsCode,
      505                 'маг':U,
      506                 objCode,
      507                 output typeAttr
      508               ).
      509         end.
      510         else return "".
      511       end.
      512     define property promo-code as character no-undo
      513       get:
      514         if available (buf_PromoAttr)
      515           then
      516         do:
      517           return buf_PromoAttr.attr-value.
      518         end.
      519         else
      520         do:
      521           find first buf_PromoAttr no-lock where buf_promoAttr.attr-code = "bc-code" and
      522             buf_promoAttr.tablename = "PromoGoods" and
      523             idAction = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and
      524             db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) and
      525             GdsCode = integer(entry(3,buf_PromoAttr.p-key,chr(3))) no-error .
      526           if available (buf_PromoAttr) then
      527           do:
      528             return buf_PromoAttr.attr-value .
      529           end.
      530           else return "".
      531         end.
      532       end.
      533     define property promoSetGoods as CLASS promoGoodssubs no-undo
      534       get():
      535          DEFINE VARIABLE vStorageOBj AS CLASS promoGoodsStorage.
      536          IF     this-object:refreshObj
      537             and not valid-object (promoSetGoods)
      538          THEN DO :
      539             vStorageOBj = NEW promoGoodsStorage().
      540             promoSetGoods = vStorageOBj:getpromoGoodssubs(idAction,id,ibs.th.ref.promo.enum-promo-goods-type:promoSetGoods,db-num,objCode).
      541             delete OBJECT vStorageOBj no-error.
      542          END.
      543          RETURN promoSetGoods.
