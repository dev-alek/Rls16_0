      512   method void proc-alt-shift-f2 ():
      513     if not ibs.th.gbl.gbl-var:rcode
      514   then
      515     run gbl\inidebug.p .
      516   end.
      517   method void proc-alt-shift-f3 ():
      518      define variable vdebugalert   as logical no-undo .
      519      assign
      520         vdebugalert = session:debug-alert
      521         session:debug-alert = yes
      522      .
      523   message program-name( 1 ) skip( 1 )
      524             vss-revision                  skip( 0 )
      525             vss-author                    skip( 0 )
      526             vss-date                      skip( 0 )
      527             vss-workfile                  skip( 0 )
      528             vss-archive                   skip( 1 )
      529             vss-description               skip( 1 )
      530     view-as alert-box title "Текущая программа".
      531     session:debug-alert = vdebugalert.
      532   end.
      533   define variable v-inform-launched as logical no-undo initial false .
      534   method void proc-alt-shift-f4 ():
      535   end.
      536   method void proc-alt-f1 ():
      537   end .
      538   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      539         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      540         then do:
      541             proc-alt-shift-f3 ().
      542         end.
      543         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      544         then do:
      545             proc-alt-shift-f2 ().
      546         end.
      547   end method.
      548   method private void End_obj_KeyDown():
      549   catch e as Progress.Lang.Error:
      550            undo, throw e.
      551         end catch.
      552   end method.
      553   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      554      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      555      define variable v-curr-sv-date as date no-undo .
      556      define variable v-new-sv-date  as date no-undo .
      557      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      558      then do:
      559         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      560         run gbl/getcurdt.p
      561            (output v-curr-sv-date
      562         ) .
      563         vdate:value = v-curr-sv-date.
      564      end.
      565      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      566      then do:
      567         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      568         v-curr-sv-date = vdate:value .
      569         if v-curr-sv-date = ?
      570         then do:
      571            run gbl/getcurdt.p
      572               (output v-curr-sv-date
      573            ) .
      574         end.
      575         if v-curr-sv-date <> ?
      576         then do:
      577            assign
      578               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      579               vdate:value = v-new-sv-date
      580            .
      581         end.
      582      end.
      583      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      584      then do:
      585         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      586         v-curr-sv-date = vdate:value.
      587         if v-curr-sv-date = ?
      588         then do:
      589            run gbl/getcurdt.p
      590               (output v-curr-sv-date
      591            ) .
      592         end.
      593         if v-curr-sv-date <> ?
      594         then do:
      595            run gbl/lastdate.p
      596               (input  v-curr-sv-date
      597               ,output v-new-sv-date
      598            ).
      599            vdate:value = v-new-sv-date.
      600         end.
      601      end.
      602      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      603      then do:
      604         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      605         define variable v-description   as character no-undo .
      606         define variable v-ok            as logical no-undo.
      607         v-curr-sv-date = vdate:value.
      608         if v-curr-sv-date = ?
      609         then do:
      610            run gbl/getcurdt.p
      611               (output v-curr-sv-date
      612            ) .
      613         end.
      614         if v-curr-sv-date <> ?
      615         then do:
      616            run gbl/d-inpday.w
      617               (input ?
      618               ,input "Выбор даты"
      619               ,input v-description
      620               ,input ""
      621               ,input-output v-curr-sv-date
      622               ,output v-ok
      623            ).
      624            if v-ok = true
      625            then do:
      626               vdate:value = v-curr-sv-date .
      627            end.
      628         end.
      629      end.
      630   end method.
      631   method private void End_date_KeyDown():
      632         catch e as Progress.Lang.Error:
      633            undo, throw e.
      634         end catch.
      635       end method.
