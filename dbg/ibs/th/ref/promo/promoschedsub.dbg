        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.ref.promo.PromoSchedSub implements ithsub:
        6   define variable vss-revision    as character no-undo initial "$Revision: 709fd28fa30d, 1490, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Thu Aug 30 10:41:46 2018 +0300 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: promoschedsub.cls $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: ibs/th/ref/promo/promoschedsub.cls $":U .
       11   define variable vss-description as character no-undo initial "Сущность Заголовок расписания промоакций.".
       12     define property Msg as character no-undo
       13       get.
       14       set.
       15       define property StatusErr as logical no-undo
       16       get:
       17         def var err as log no-undo.
       18         err = StatusErr.
       19         StatusErr = false.
       20         return err.
       21       end.
       22       private set.
       23     define property ID as integer no-undo
       24       get.
       25       set.
       26     define property dispname as char no-undo
       27       get.
       28       set(arg as char):
       29         if arg <> dispname
       30         then do:
       31           dispname = arg.
       32           setFlagChange (true).
       33         end.
       34       END.
       35     define property schedType as integer no-undo
       36       get.
       37       set(arg as integer):
       38         if arg <> schedType
       39         then do:
       40           schedType = arg.
       41           setFlagChange (true).
       42         end.
       43       END.
       44     define property status_ as ibs.th.ref.promo.enum-sched-status no-undo
       45       get.
       46       set(arg as ibs.th.ref.promo.enum-sched-status):
       47         if arg <> status_
       48         then do:
       49           status_ = arg.
       50           setFlagChange (true).
       51         end.
       52       END.
       53     define property extCodeSched as char no-undo
       54       get.
       55       set(arg as char):
       56         if arg <> extCodeSched
       57         then do:
       58           extCodeSched = arg.
       59           setFlagChange (true).
       60         end.
       61       END.
       62     define property db-num as integer no-undo
       63       get.
       64       set(arg as integer):
       65         if arg <> db-num
       66         then do:
       67           db-num = arg.
       68           setFlagChange (true).
       69         end.
       70       END.
       71       define property Mode as char init 'и':U no-undo
       72       get.
       73       set.
       74       define property Changed as logical no-undo
       75       get.
       76       set.
       77     constructor public promoschedsub (  ):
       78     end constructor.
       79     method public void setMsg( arg as character ):
       80       Msg = arg.
       81     end.
       82     method public void setStatusErr( arg as logical ):
       83       StatusErr = arg.
       84     end.
       85     method public void setFlagChange( arg as logical ):
       86       Changed = arg.
       87     end.
       88   end class.
