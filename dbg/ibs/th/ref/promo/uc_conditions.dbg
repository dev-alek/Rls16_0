      149       method public VOID setDisable(input iModeView as logical  ):
      150           assign
      151               button1:enabled = not iModeview
      152               button2:enabled = not iModeview
      153               button3:enabled = not iModeview .
      154           if m-promo-trg:typeCond <> 1 and m-promo-trg:typeCond <> 2 then THIS-OBJECT:dataGridView1:Columns[2]:Visible = no .
      155           else THIS-OBJECT:dataGridView1:Columns[2]:Visible = true .
      156               .
      157       end.
      158       method Public VOID localEvent(input iEvent as character, input iEventParam as character  ):
      159           define variable check_   as logical no-undo .
      160           define variable is_check as logical no-undo .
      161           if iEvent eq "CritLable"
      162               then
      163           do:
      164               if num-entries(iEventParam,"#") > 4 then
      165               do:
      166                   check_ = logical(entry(1,iEventParam,"#")) .
      167                   is_check = true .
      168               end.
      169               if entry(1,iEventParam,"#") eq "?"
      170                   then
      171                   THIS-OBJECT:dataGridView1:Columns[0]:Visible = no.
      172               else
      173               do:
      174                   if is_check then
      175                   do:
      176                   end.
      177                   else
      178                   do:
      179                       THIS-OBJECT:dataGridView1:Columns[0]:Visible = yes.
      180                       THIS-OBJECT:dataGridView1:Columns[0]:HeaderText = entry(1,iEventParam,"#").
      181                       label2:text = entry(1,iEventParam,"#").
      182                   end.
      183               end.
      184               if num-entries ( iEventParam,"#") > 1
      185                   then
      186               do:
      187                   if entry(2,iEventParam,"#") eq "?"
      188                       then
      189                       THIS-OBJECT:dataGridView1:Columns[1]:Visible = no.
      190                   else
      191                   do:
      192                       if is_check then
      193                       do:
      194                           if not check_ then
      195                           do:
      196                               THIS-OBJECT:dataGridView1:Columns[0]:Visible = no.
      197                               THIS-OBJECT:dataGridView1:Columns[3]:FillWeight = 60.
      198                               THIS-OBJECT:dataGridView1:Columns[2]:FillWeight = 60.
      199                           end.
      200                           else
      201                           do:
      202                               THIS-OBJECT:dataGridView1:Columns[0]:Visible = yes.
      203                               THIS-OBJECT:dataGridView1:Columns[0]:HeaderText = entry(2,iEventParam,"#") + " для незав. условий".
      204                               label2:text = entry(2,iEventParam,"#").
      205                               THIS-OBJECT:dataGridView1:Columns[1]:FillWeight = 50.
      206                               THIS-OBJECT:dataGridView1:Columns[2]:FillWeight = 50.
      207                               THIS-OBJECT:dataGridView1:Columns[3]:FillWeight = 50.
      208                           end.
      209                       end.
      210                       else
      211                       do:
      212                           THIS-OBJECT:dataGridView1:Columns[1]:Visible = yes.
      213                           THIS-OBJECT:dataGridView1:Columns[1]:HeaderText = entry(2,iEventParam,"#").
      214                       end.
      215                   end.
      216                   if num-entries ( iEventParam,"#") > 2
      217                       then
      218                   do:
      219                       if entry(3,iEventParam,"#") eq "?"
      220                           then
      221                           THIS-OBJECT:dataGridView1:Columns[2]:Visible = no.
      222                       else
      223                       do:
      224                           if is_check then
      225                           do:
      226                               THIS-OBJECT:dataGridView1:Columns[1]:Visible = yes.
      227                               THIS-OBJECT:dataGridView1:Columns[1]:HeaderText = entry(3,iEventParam,"#").
      228                           end.
      229                           else
      230                           do:
      231                               THIS-OBJECT:dataGridView1:Columns[2]:Visible = yes.
      232                               THIS-OBJECT:dataGridView1:Columns[2]:HeaderText = entry(3,iEventParam,"#").
      233                               label3:text = entry(3,iEventParam,"#").
      234                           end.
      235                       end.
      236                   end.
      237                   if num-entries ( iEventParam,"#") > 3
      238                       then
      239                   do:
      240                       if entry(4,iEventParam,"#") eq "?"
      241                           then
      242                           THIS-OBJECT:dataGridView1:Columns[3]:Visible = no.
      243                       else
      244                       do:
      245                           if is_check then
      246                           do:
      247                               THIS-OBJECT:dataGridView1:Columns[2]:Visible = yes.
      248                               THIS-OBJECT:dataGridView1:Columns[2]:HeaderText = entry(4,iEventParam,"#").
      249                               label3:text = entry(4,iEventParam,"#").
      250                           end.
      251                           else
      252                           do:
      253                               THIS-OBJECT:dataGridView1:Columns[3]:Visible = yes.
      254                               THIS-OBJECT:dataGridView1:Columns[3]:HeaderText = entry(4,iEventParam,"#").
      255                               label3:text = entry(4,iEventParam,"#").
      256                           end.
      257                       end.
      258                   end.
      259                   if num-entries ( iEventParam,"#") > 4
      260                       then
      261                   do:
      262                       if entry(4,iEventParam,"#") eq "?"
      263                           then
      264                           THIS-OBJECT:dataGridView1:Columns[4]:Visible = no.
      265                       else
      266                       do:
      267                           THIS-OBJECT:dataGridView1:Columns[3]:Visible = yes.
      268                           THIS-OBJECT:dataGridView1:Columns[3]:HeaderText = entry(5,iEventParam,"#").
      269                           label3:text = entry(5,iEventParam,"#").
      270                       end.
      271                   end.
      272               end.
      273            // THIS-OBJECT:dataGridView1:Columns[2]:Visible = logical(iEventParam) no-error.
      274           end.
      275       end.
