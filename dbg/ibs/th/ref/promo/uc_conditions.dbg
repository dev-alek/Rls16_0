       56       method private void editrow( input iadd as logical ):
       57           define variable vtext1 as character no-undo.
       58           define variable vtext2 as character no-undo.
       59           assign
       60               textBox1:text = ""
       61               textBox2:text = ""
       62               .
       63           if not iadd
       64               then
       65           do:
       66               m-promo-trg:GetCrit(output vtext1,output vtext2).
       67               if vtext1 eq "?"
       68                   then
       69                   iadd = yes.
       70               else assign
       71                       textBox1:text = vtext1
       72                       textBox2:text = vtext2
       73                       .
       74           end.
       75           assign
       76               dataGridView1:Visible = false
       77               button3:Enabled       = false
       78               button2:Enabled       = false
       79               button1:Enabled       = false
       80               mNew                  = iadd
       81               .
       82           return.
       83       end method.
       84       method private LOGICAL EndEditRow():
       85           define variable vOk as logical no-undo init yes.
       86           dec(textBox1:text) no-error.
       87           if error-status:error
       88               then
       89           do:
       90               message "Поле '" label2:text "' должен быть числом."
       91                   view-as alert-box.
       92               vOk = false.
       93           end.
       94           dec(textBox2:text) no-error.
       95           if error-status:error
       96               then
       97           do:
       98               message "Поле '" label3:text " должен быть числом."
       99                   view-as alert-box.
      100               vOk = false.
      101           end.
      102           if vOk then
      103               vOk = m-promo-trg:setCrit(mNew,dec(textBox1:text),dec(textBox2:text) ).
      104           return vOk.
      105       end method.
      106       @VisualDesigner.
      107       METHOD PRIVATE VOID button4_Click( INPUT sender AS System.Object, INPUT e AS System.EventArgs ):
      108           if EndEditRow()
      109               then
      110           do:
      111               bindPromoCrit:handle:query-open.
      112               bindPromoCrit:RefreshAll().
      113               dataGridView1:Visible = true.
      114               button3:Enabled = true.
      115               button2:Enabled = true.
      116               button1:Enabled = true.
      117           end.
      118           RETURN.
      119       END METHOD.
