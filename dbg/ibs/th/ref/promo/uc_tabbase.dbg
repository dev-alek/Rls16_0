      396   this-object:dateTimePicker1:KeyDown:Subscribe(this-object:date_KeyDown).
      397   This-object:dateTimePicker2:KeyDown:Subscribe(this-object:date_KeyDown).
      398   this-object:dateTimePicker3:KeyDown:Subscribe(this-object:date_KeyDown).
      399   catch e as Progress.Lang.Error:
      400            undo, throw e.
      401         end catch.
      402   end method.
      403   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      404      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      405      define variable v-curr-sv-date as date no-undo .
      406      define variable v-new-sv-date  as date no-undo .
      407      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      408      then do:
      409         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      410         run gbl/getcurdt.p
      411            (output v-curr-sv-date
      412         ) .
      413         vdate:value = v-curr-sv-date.
      414      end.
      415      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      416      then do:
      417         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      418         v-curr-sv-date = vdate:value .
      419         if v-curr-sv-date = ?
      420         then do:
      421            run gbl/getcurdt.p
      422               (output v-curr-sv-date
      423            ) .
      424         end.
      425         if v-curr-sv-date <> ?
      426         then do:
      427            assign
      428               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      429               vdate:value = v-new-sv-date
      430            .
      431         end.
      432      end.
      433      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      434      then do:
      435         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      436         v-curr-sv-date = vdate:value.
      437         if v-curr-sv-date = ?
      438         then do:
      439            run gbl/getcurdt.p
      440               (output v-curr-sv-date
      441            ) .
      442         end.
      443         if v-curr-sv-date <> ?
      444         then do:
      445            run gbl/lastdate.p
      446               (input  v-curr-sv-date
      447               ,output v-new-sv-date
      448            ).
      449            vdate:value = v-new-sv-date.
      450         end.
      451      end.
      452      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      453      then do:
      454         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      455         define variable v-description   as character no-undo .
      456         define variable v-ok            as logical no-undo.
      457         v-curr-sv-date = vdate:value.
      458         if v-curr-sv-date = ?
      459         then do:
      460            run gbl/getcurdt.p
      461               (output v-curr-sv-date
      462            ) .
      463         end.
      464         if v-curr-sv-date <> ?
      465         then do:
      466            run gbl/d-inpday.w
      467               (input ?
      468               ,input "Выбор даты"
      469               ,input v-description
      470               ,input ""
      471               ,input-output v-curr-sv-date
      472               ,output v-ok
      473            ).
      474            if v-ok = true
      475            then do:
      476               vdate:value = v-curr-sv-date .
      477            end.
      478         end.
      479      end.
      480   end method.
      481   method private void End_date_KeyDown():
      482       catch e as Progress.Lang.Error:
      483         undo, throw e.
      484       end catch.
      485       END METHOD.
      486   END CLASS.
