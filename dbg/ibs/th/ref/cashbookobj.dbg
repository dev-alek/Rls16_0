      675     method public void Visual_form( input iChange AS character ):
      676       if iChange = 'ПРОСМОТР':U then
      677       do:
      678         assign
      679           this-object:fObjCode:ReadOnly = true
      680           this-object:fMaskPko:ReadOnly = true
      681           this-object:fMaskRko:ReadOnly = true
      682           this-object:fDptName:ReadOnly = true
      683           this-object:fDptType:ReadOnly = true
      684           this-object:fDptCode:ReadOnly = true
      685           this-object:fBuhFIO:Enabled = false
      686           this-object:fManagerFIO:Enabled = false
      687           this-object:fManagerPosition:Enabled = false
      688           this-object:fStruct:Enabled = false
      689           this-object:fUchet:Enabled = false
      690           this-object:fCurrPKO:ReadOnly = true
      691           this-object:fCurrRKO:ReadOnly = true
      692           this-object:bObj:Enabled = false
      693           this-object:buttonOk:Enabled = false
      694         .
      695       end.
      696       if iChange = 'ИЗМЕНЕНИЕ':U then
      697       do:
      698         assign
      699           this-object:fObjCode:ReadOnly = true
      700           this-object:bObj:Enabled = false
      701         .
      702         define variable v-log as logical no-undo .
      703         define variable v-log2 as logical no-undo .
      704         v-log = true .
      705   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   do:
      707     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      708       (input  v-cntxt-db-num
      709       ,input  v-cntxt-userid
      710       ,input  0
      711       ,input  'actn_fin-cashbook_update':U
      712       ,input  'global':U
      713       ,input  0
      714       ,input  '':U
      715       ,input  0
      716       ,input  0
      717       ,input  0
      718       ,input  0
      719       ,input  false
      720       ,output v-log
      721       )  .
      722   end.
      723         v-log2 = true .
      724   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   do:
      726     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      727       (input  v-cntxt-db-num
      728       ,input  v-cntxt-userid
      729       ,input  0
      730       ,input  'actn_fin-counter_update':U
      731       ,input  'object':U
      732       ,input  v-cntxt-host-code-obj
      733       ,input  v-cntxt-obj-type
      734       ,input  v-cntxt-obj-code
      735       ,input  0
      736       ,input  0
      737       ,input  0
      738       ,input  false
      739       ,output v-log2
      740       )  .
      741   end.
      742         define variable v-cntxt-db-num  as integer no-undo.
      743         assign
      744           this-object:fMaskPko:ReadOnly = not (v-log and v-cntxt-db-num = 0)
      745           this-object:fMaskRko:ReadOnly = not (v-log and v-cntxt-db-num = 0)
      746           this-object:fDptName:ReadOnly = not (v-log and v-cntxt-db-num = 0)
      747           this-object:fDptType:ReadOnly = not (v-log and v-cntxt-db-num = 0)
      748           this-object:fDptCode:ReadOnly = not (v-log and v-cntxt-db-num = 0)
      749           this-object:fBuhFIO:Enabled = (v-log and v-cntxt-db-num = 0)
      750           this-object:fManagerFIO:Enabled = (v-log and v-cntxt-db-num = 0)
      751           this-object:fManagerPosition:Enabled = (v-log and v-cntxt-db-num = 0)
      752           this-object:fStruct:Enabled = (v-log and v-cntxt-db-num = 0)
      753           this-object:fUchet:Enabled = (v-log and v-cntxt-db-num = 0)
      754           this-object:buttonOk:Enabled = (v-log and v-cntxt-db-num = 0) or v-log2
      755         .
      756         if tt-CashBookrule.Obj-type = 'орг':U
      757         then do :
      758           assign
      759             this-object:fCurrRKO:Enabled = false
      760             this-object:fCurrPKO:Enabled = false
      761           .
      762         end.
      763         else do :
      764           assign
      765             this-object:fCurrRKO:Enabled = v-log2
      766             this-object:fCurrPKO:Enabled = v-log2
      767           .
      768         end.
      769       end.
      770       return.
      771     end method .
      772   end class.
