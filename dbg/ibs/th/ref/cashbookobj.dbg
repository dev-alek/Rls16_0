       32    method private character getMgrPositionName (input p-post-chief as character) :
       33       define variable v-name as character no-undo .
       34       case p-post-chief :
       35         when "1" then v-name = "Директор" .
       36         when "2" then v-name = "Управляющий" .
       37         when "0" then v-name = "Должность рук-ля фирмы" .
       38         otherwise v-name = p-post-chief .
       39       end case .
       40       return v-name .
       41     end method .
       42    method private character getMgrPositionID (input p-post-chief as character) :
