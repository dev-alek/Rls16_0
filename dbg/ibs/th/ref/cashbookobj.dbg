      165     define property parparentproc as handle no-undo
      166     private get.
      167     set(input iH as handle):
      168           parparentproc = ih.
      169     end.
      170     constructor public cashbookobj (inParparentproc as handle, Mode as character, p-id as int64, p-obj-code as integer, p-obj-type as character):
      171       super().
      172       parparentproc = inParparentproc .
      173   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174     run mainmenu_getcntxt in parparentproc
      175       (output v-cntxt-db-num
      176       ,output v-cntxt-userid
      177       ,output v-cntxt-level
      178       ,output v-cntxt-host-code-obj
      179       ,output v-cntxt-obj-type
      180       ,output v-cntxt-obj-code
      181       ,output v-cntxt-db-num-obj
      182       ,output v-cntxt-is-admin
      183       ) .
      184       v-cashbookID = p-id .
      185       v-obj-code = p-obj-code .
      186       v-obj-type = p-obj-type .
      187       mCashBook = new cashbookstorage () .
      188       empty temp-table tt-cashbookrule .
      189       case Mode:
      190         when 'ДОБАВЛЕНИЕ':U then
      191         do:
      192           create tt-CashBookrule .
      193           assign
      194             tt-cashbookrule.host-code = ?
      195             tt-cashbookrule.cashbookID = v-cashbookID
      196             tt-cashbookrule.obj-type   =  p-obj-type
      197             tt-cashbookrule.obj-code   =  p-obj-code
      198           .
      199         end.
      200         when 'ИЗМЕНЕНИЕ':U
      201         or when 'ПРОСМОТР':U then
      202         do:
      203           mCashBook:getCashBookRule(input v-cashbookID, input v-obj-type, input v-obj-code, output dataset ds-cashbookrule) .
      204           find first tt-cashbookrule exclusive-lock .
      205           tt-cashbookrule.obj = tt-cashbookrule.Obj-type + string(tt-cashbookrule.obj-code) .
      206         end.
      207       end case .
      208       InitializeComponent().
      209       Visual_form(Mode).
      210       bindingSource1:Handle = buffer tt-CashBookRule:handle .
      211       this-object:ComponentsCollection:ADD(this-object:components).
      212       catch e as Progress.Lang.Error:
      213         undo, throw e.
      214       end catch.
      215     end constructor.
      216     constructor public cashbookobj( ):
      217         super().
      218         InitializeComponent ( ).
      219         catch e as Progress.Lang.Error:
      220            undo, throw e.
      221         end catch.
      222     end constructor.
      223     destructor public cashbookobj( ):
      224       delete object mCashBook no-error .
      225         if valid-object(components) then do:
      226            cast(components, System.IDisposable):Dispose().
      227         end.
      228     end destructor.
      229           @VisualDesigner.
      230           method private void bObj_Click( input sender as System.Object, input e as System.EventArgs ):
      231                   define variable ref-rec as recid no-undo .
      232       define variable ref-list as character no-undo.
      233       run ref/cli-all.w ( input parParentProc
      234                        ,input "b-add,b-sel"
      235                        ,input 'все':U
      236                        ,input ?
      237                        ,input ?
      238                        ,input ?
      239                        ,input ?
      240                        ,input ?
      241                        ,output ref-list) .
      242       if ref-list = "" then do:
      243         return .
      244       end.
      245       ref-rec = integer( ref-list ).
      246       FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
      247       if ub.clients.obj-type = 'чел':U
      248       then do :
      249         message "Нельзя добавлять настройки для физического лица!" view-as alert-box .
      250         return.
      251       end.
      252       if ub.clients.obj-type = 'скл':U
      253       then do :
      254         message "Нельзя добавлять настройки для склада!" view-as alert-box .
      255         return.
      256       end.
      257       if ub.clients.obj-type = 'орг':U
      258       then do :
      259         find first ub.sysconf no-lock where ub.sysconf.host-code = ub.clients.obj-code no-error.
      260         if not available ub.sysconf
      261         then do :
      262           message "Можно выбрать только свою фирму!" view-as alert-box .
      263           return.
      264         end.
      265       end.
      266       this-object:fObjCode:Text = ub.clients.obj-type + string(ub.clients.obj-code) .
      267       this-object:fObjCode:Focus().
      268       assign
      269         tt-CashBookrule.Obj-code = ub.clients.obj-code
      270         tt-CashBookrule.Obj-type = ub.clients.obj-type
      271         tt-CashBookrule.host-code = if ub.clients.obj-type = 'орг':U then string(ub.clients.obj-code) else string(ub.clients.host-code)
      272       .
      273       if tt-CashBookrule.Obj-type = 'орг':U
      274       then do :
      275         assign
      276           this-object:fCurrRKO:Enabled = false
      277           this-object:fCurrPKO:Enabled = false
      278         .
      279       end.
      280       else do :
      281         assign
      282           this-object:fCurrRKO:Enabled = true
      283           this-object:fCurrPKO:Enabled = true
      284         .
      285       end.
      286                   return.
      287           end method.
      288           @VisualDesigner.
      289           method private void fStruct_TextChanged( input sender as System.Object, input e as System.EventArgs ):
      290                   if fStruct:Text = "Значение по умолчанию"
      291       then do :
      292         assign
      293           fDptName:visible = true
      294           fDptType:visible = true
      295           fDptCode:visible = true
      296           label11:visible = true
      297           label12:visible = true
      298           label13:visible = true
      299         .
      300       end.
      301       else do :
      302         assign
      303           fDptName:text = ""
      304           fDptType:text = ""
      305           fDptCode:text = "0"
      306         .
      307         fDptName:Focus() .
      308         fDptType:Focus() .
      309         fDptCode:Focus() .
      310         assign
      311           fDptName:visible = false
      312           fDptType:visible = false
      313           fDptCode:visible = false
      314           label11:visible = false
      315           label12:visible = false
      316           label13:visible = false
      317         .
      318       end.
      319                   return.
      320           end method.
