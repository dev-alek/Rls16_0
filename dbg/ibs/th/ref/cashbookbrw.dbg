      627           method private void bMark_Click( input sender as System.Object, input e as System.EventArgs ):
      628                   define variable vPos as integer no-undo.
      629       define variable v-mark as character no-undo .
      630       vPos = bindingSource1:Position.
      631       v-mark = cashbookBrowse:CurrentRow:Cells["markDataGridViewTextBoxColumn"]:Value .
      632       v-id = cashbookBrowse:CurrentRow:Cells["id"]:Value .
      633       v-list = "" .
      634       if v-mark = "*"
      635       then do :
      636         cashbookBrowse:CurrentRow:Cells["markDataGridViewTextBoxColumn"]:Value = "" .
      637         mQuery:reposition-to-row (vPos + 1) .
      638         mQuery:get-buffer-handle("tt-cashbook"):buffer-field("mark"):buffer-value = "" .
      639       end.
      640       else do :
      641         cashbookBrowse:CurrentRow:Cells["markDataGridViewTextBoxColumn"]:Value = "*" .
      642         mQuery:reposition-to-row (vPos + 1) .
      643         mQuery:get-buffer-handle("tt-cashbook"):buffer-field("mark"):buffer-value = "*" .
      644       end.
      645       mQuery:get-first () .
      646       repeat :
      647         v-id = mQuery:get-buffer-handle("tt-cashbook"):buffer-field("id"):buffer-value .
      648         if mQuery:get-buffer-handle("tt-cashbook"):buffer-field("mark"):buffer-value = "*"
      649         then v-list = v-list + chr(6) + string(v-id) .
      650         mQuery:get-next () no-error.
      651         if mQuery:query-off-end then leave .
      652       end.
      653       v-list = trim (v-list,chr(6)) .
      654       if cashbookBrowse:RowCount <> (bindingSource1:position + 1) then bindingSource1:Position = vPos + 1 .
      655                   return.
      656           end method.
