      241           @VisualDesigner.
      242           method private void cashbookBrowse_SelectionChanged( input sender as System.Object, input e as System.EventArgs ):
      243                   if mQuery:num-results > 0
      244                   then do :
      245                   v-id = cashbookBrowse:CurrentRow:Cells["id"]:Value no-error.
      246                   if error-status:error then return .
      247                   mQueryRule:query-prepare(substitute("FOR EACH tt-cashbookrule where tt-cashbookrule.CashBookId = &1 break by tt-cashbookrule.host-code by tt-cashbookrule.obj-type desc by tt-cashbookrule.obj-code", v-id)).
      248         mQueryRule:query-open ().
      249         bindingSource2:handle = mQueryRule .
      250       end .
      251           end method.
