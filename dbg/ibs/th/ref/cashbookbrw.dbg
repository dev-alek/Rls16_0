     1315      method public void getobj(input iText as character,output oType as character , output oCode as integer    ):
     1316         if iText begins 'всем':U
     1317         then
     1318            assign
     1319            oCode = 0
     1320            oType = 'всем':U .
     1321         else
     1322         assign
     1323            oCode = integer(substring(iText, 4))
     1324            oType = substring(iText, 1, 3) .
     1325      end method.
