     1263           @VisualDesigner.
     1264           method private void firm_CheckedChanged( input sender as System.Object, input e as System.EventArgs ):
     1265             define variable ref-rec as recid no-undo .
     1266       define variable ref-list as character no-undo.
     1267                   if this-object:rbFirmAll:Checked = true
     1268                   then do :
     1269                     v-firmes = 'все':U .
     1270                     v-firmChoosed = no .
     1271                   end.
     1272       if this-object:rbFirmCurr:Checked = true
     1273       then do :
     1274         v-firmes = string(v-cntxt-host-code-obj) .
     1275         v-firmChoosed = no .
     1276       end.
     1277       if this-object:rbFirmSelect:Checked = true
     1278       then do :
     1279         if v-firmChoosed then return .
     1280         run ref/cli-all.w ( input parParentProc
     1281                        ,input "b-add,b-sel"
     1282                        ,input 'орг':U
     1283                        ,input ?
     1284                        ,input ?
     1285                        ,input ?
     1286                        ,input ?
     1287                        ,input ?
     1288                        ,output ref-list) .
     1289         if ref-list = "" then do:
     1290           this-object:rbFirmCurr:Checked = true .
     1291           v-firmes = string(v-cntxt-host-code-obj) .
     1292           return .
     1293         end.
     1294         ref-rec = integer( ref-list ).
     1295         FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
     1296         v-firmes = string(ub.clients.obj-code) .
     1297         v-firmChoosed = yes .
     1298       end .
     1299       bindingSource1:Handle = mCashBook:getquery(input v-status, input v-firmes, output mQuery, output mQueryRule).
     1300       bindingSource2:handle = mQueryRule .
     1301                   return.
     1302           end method.
