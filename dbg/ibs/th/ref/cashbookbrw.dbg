      146           @VisualDesigner.
      147      method private void bhistpko_Click( input sender as System.Object, input e as System.EventArgs ):
      148         define variable v-cashbookrule-key-rec as character no-undo.
      149         define variable v-rid-list as character no-undo.
      150         define variable v-id as int64 no-undo.
      151         define variable v-obj-code as integer no-undo.
      152         define variable v-obj-type as character no-undo.
      153         v-id = cashbookBrowse:CurrentRow:Cells["id"]:Value .
      154         v-obj-code = integer(substring(cashbookRuleBrowse:CurrentRow:Cells["obj"]:Value:ToString(), 4)) .
      155         v-obj-type = substring(cashbookRuleBrowse:CurrentRow:Cells["obj"]:Value:ToString(), 1, 3) .
      156         find first cashbookrule where CashBookRule.CashBookID eq v-id
      157                                   and CashBookRule.Obj-type   eq v-obj-type
      158                                   and CashBookRule.Obj-code   eq v-obj-code
      159                                   and CashBookRule.Code       eq "currPko"
      160         no-lock no-error.
      161         if available cashbookrule
      162         then do:
      163            objKeyRec = new ibs.th.gbl.keyrec().
      164            objKeyRec:GenKeyRec ( input 'CashBookRule':U
      165                                 ,input buffer ub.cashbookrule:handle
      166                                 ,output v-cashbookrule-key-rec).
      167            delete object objKeyRec.
      168            find first clients where clients.obj-type eq cashbookrule.obj-type
      169                                and clients.obj-code  eq  cashbookrule.obj-code
      170            no-lock no-error.
      171            if     available clients
      172               and clients.db-num ne ?
      173            then
      174               run ref/ccounhist.w (clients.db-num, // id
      175                                  "cashbookrule",
      176                                  v-cashbookrule-key-rec,
      177                                  "currPKO",
      178                                  parparentproc,
      179                                  0,
      180                                  "",
      181                                  0,
      182                                  "",
      183                                  "one",
      184                                  ?,
      185                                  "",
      186                                  "",
      187                                  ibs.th.gbl.gbl-var:g#db-num,
      188                                  ?,
      189                                  input-output v-rid-list ).
      190         end.
      191         return.
      192      end method.
