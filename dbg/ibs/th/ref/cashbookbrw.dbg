      359           method private void bAdd_Click( input sender as System.Object, input e as System.EventArgs ):
      360             define variable v-log as logical no-undo .
      361       v-log = true .
      362   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   do:
      364     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
