       88     constructor public cashbookbrw( input Mode as character, input p-parparentproc as handle ):
       89       super().
       90       parparentproc = p-parparentproc .
       91       vMode = Mode .
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93     run mainmenu_getcntxt in parparentproc
       94       (output v-cntxt-db-num
       95       ,output v-cntxt-userid
       96       ,output v-cntxt-level
       97       ,output v-cntxt-host-code-obj
       98       ,output v-cntxt-obj-type
       99       ,output v-cntxt-obj-code
      100       ,output v-cntxt-db-num-obj
      101       ,output v-cntxt-is-admin
      102       ) .
      103       InitializeComponent().
      104       Visual_form(vMode) .
      105       v-status = 'тек':U.
      106       v-firmes = 'все':U .
      107       mCashBook = new cashbookstorage () .
      108       bindingSource1:Handle = mCashBook:getquery(input v-status, input v-firmes, output mQuery, output mQueryRule).
      109       bindingSource2:handle = mQueryRule .
      110       this-object:ComponentsCollection:ADD(this-object:components).
      111       catch e as Progress.Lang.Error:
      112         undo, throw e.
      113       end catch.
      114     end constructor.
