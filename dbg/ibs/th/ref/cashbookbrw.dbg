      261     method public void Visual_form( input iChange AS character ):
      262       define variable v-log as logical no-undo .
      263       IF iChange = 'ИЗМЕНЕНИЕ':U then
      264       do:
      265         assign
      266           this-object:bMark:Enabled = false
      267           this-object:bSelect:Enabled = false
      268         .
      269         if v-cntxt-db-num <> 0
      270         then do :
      271           v-log = true .
      272   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      273   do:
      274     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      275       (input  v-cntxt-db-num
      276       ,input  v-cntxt-userid
      277       ,input  0
      278       ,input  'actn_fin-counter_update':U
      279       ,input  'object':U
      280       ,input  v-cntxt-host-code-obj
      281       ,input  v-cntxt-obj-type
      282       ,input  v-cntxt-obj-code
      283       ,input  0
      284       ,input  0
      285       ,input  0
      286       ,input  false
      287       ,output v-log
      288       )  .
      289   end.
      290           assign
      291             this-object:bAdd:Enabled = false
      292             this-object:bChange:Enabled = false
      293             this-object:bDel:Enabled = false
      294             this-object:bAddObj:Enabled = false
      295             this-object:bChangeObj:Enabled = false
      296             this-object:bDelObj:Enabled = false
      297           .
      298           if v-log then this-object:bChangeObj:Enabled = true .
      299         end.
      300       end.
      301       if iChange = 'ВЫБОР':U then do:
      302         assign
      303           this-object:bAdd:Enabled = false
      304           this-object:bChange:Enabled = false
      305           this-object:bDel:Enabled = false
      306           this-object:bAddObj:Enabled = false
      307           this-object:bChangeObj:Enabled = false
      308           this-object:bDelObj:Enabled = false
      309           this-object:bMark:Enabled = false
      310         .
      311       end.
      312       if iChange = "multiselect" then do:
      313         assign
      314           this-object:bAdd:Enabled = false
      315           this-object:bChange:Enabled = false
      316           this-object:bDel:Enabled = false
      317           this-object:bAddObj:Enabled = false
      318           this-object:bChangeObj:Enabled = false
      319           this-object:bDelObj:Enabled = false
      320         .
      321       end.
      322       if iChange = 'ПРОСМОТР':U then do:
      323         assign
      324           this-object:bMark:Enabled = false
      325           this-object:bSelect:Enabled = false
      326         .
      327         v-log = true .
      328   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   do:
      330     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      331       (input  v-cntxt-db-num
      332       ,input  v-cntxt-userid
      333       ,input  0
      334       ,input  'actn_fin-counter_update':U
      335       ,input  'object':U
      336       ,input  v-cntxt-host-code-obj
      337       ,input  v-cntxt-obj-type
      338       ,input  v-cntxt-obj-code
      339       ,input  0
      340       ,input  0
      341       ,input  0
      342       ,input  false
      343       ,output v-log
      344       )  .
      345   end.
      346         assign
      347           this-object:bAdd:Enabled = false
      348           this-object:bChange:Enabled = false
      349           this-object:bDel:Enabled = false
      350           this-object:bAddObj:Enabled = false
      351           this-object:bChangeObj:Enabled = false
      352           this-object:bDelObj:Enabled = false
      353         .
      354         if v-log then this-object:bChangeObj:Enabled = true .
      355       end.
      356       return.
      357     end method .
