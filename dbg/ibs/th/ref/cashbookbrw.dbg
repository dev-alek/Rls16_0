      387           method private void AddCashBook( Mode as character, v-id as int64):
      388       run ref/cashbookfrm.p (parparentproc,Mode,v-id).
      389       define variable vPos      as integer   no-undo.
      390       vPos = bindingSource1:Position.
      391       bindingSource1:Handle = mCashBook:getquery(input v-status, input v-firmes, output mQuery, output mQueryRule).
      392       bindingSource2:handle = mQueryRule .
      393       bindingSource1:Position = vPos .
      394     end method.
      395           @VisualDesigner.
      396           method private void bAddObj_Click( input sender as System.Object, input e as System.EventArgs ):
      397       if valid-handle (mQuery)
      398       and mQuery:num-results > 0
      399       then do :
      400         define variable v-log as logical no-undo .
      401         v-log = true .
      402   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   do:
      404     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      405       (input  v-cntxt-db-num
      406       ,input  v-cntxt-userid
      407       ,input  0
      408       ,input  'actn_fin-cashbook_add-def':U
      409       ,input  'global':U
      410       ,input  0
      411       ,input  '':U
      412       ,input  0
      413       ,input  0
      414       ,input  0
      415       ,input  0
      416       ,input  false
      417       ,output v-log
      418       )  .
      419   end.
      420         if v-log = false then do :
      421           message 'Для добавления требуется право "кассовые книги ДОБАВЛЕНИЕ"' view-as alert-box .
      422           return .
      423         end.
      424                   v-id = cashbookBrowse:CurrentRow:Cells["id"]:Value .
      425                   v-obj-code = ? .
      426                   v-obj-type = ? .
      427                   AddCashBookObj('ДОБАВЛЕНИЕ':U, v-id, v-obj-code, v-obj-type) .
      428       end.
      429       else do :
      430         message "Сначала выберите (или создайте) тип кассовой книги!" view-as alert-box .
      431       end.
      432                   return.
      433           end method.
