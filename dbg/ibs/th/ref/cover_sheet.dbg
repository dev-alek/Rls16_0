      136     DEFINE BUFFER find_fin-bank     FOR ub.fin-bank.
      137     DEFINE BUFFER find_fin-doc-attr FOR ub.fin-doc-attr.
      138     define private variable v-deposit_bank   as integer                  no-undo .
      139     define private variable v-recip_bank     as integer                  no-undo .
      140     define         variable v-recip_schet    as character                no-undo .
      141     define         variable vBankDepos-host  as integer                  no-undo.
      142     define         variable vBankDepos-code  as integer                  no-undo.
      143     define         variable vBankRecip-host  as integer                  no-undo.
      144     define         variable vBankRecip-code  as integer                  no-undo.
