       15     define variable v-cntxt-is-admin      as logical   no-undo .
       16     define temp-table tt-coins no-undo XML-NODE-NAME "coins" serialize-name  "coins"
       17     field id       as decimal
       18     field qnty     as decimal
       19     field sum-qnty as decimal
       20     index pi is primary unique id desc.
       21   define temp-table tt-banknots no-undo XML-NODE-NAME "banknots" serialize-name  "banknots"
       22     field id       as integer
       23     field qnty     as integer
       24     field sum-qnty as integer
       25     index pi is primary unique id desc.
       26   define temp-table tt-cover-sheet no-undo
       27     field num-bag      as character
       28     field depos-code   as integer
       29     field depos-bank   as character
       30     field repos-code   as integer
       31     field repos-bank   as character
       32     field pin02        as character
       33     field source_      as character
       34     field total-sum    as decimal
       35     index pi num-bag
       36   .
       37   define dataset ds-banknots XML-NODE-NAME "money" serialize-name  "money" for tt-banknots,
       38     tt-coins .
       39   define         variable hQueryCoins                           as handle                                         no-undo .
       40   define         variable hQueryBanknot                         as handle                                         no-undo .
       41   method private handle add_Coints():
       42      define variable v-list-coints as character no-undo .
       43      define variable ii            as integer   no-undo .
       44      v-list-coints = "10;5;2;1;0.5;0.1;0.05" .
       45       define variable ddd as decimal no-undo.
       46       do ii = 1 to num-entries (v-list-coints,";"):
       47         find first tt-coins where tt-coins.id       = decimal (entry(ii,v-list-coints,";"))
       48         no-error.
       49         if not available tt-coins
       50         then do:
       51            create tt-coins .
       52            assign
       53              tt-coins.id       = decimal(entry(ii,v-list-coints,";"))
       54              tt-coins.qnty     = 0
       55              tt-coins.sum-qnty = 0
       56              .
       57          end.
       58       end.
       59   end.
       60   method private handle getq_Coints():
       61   if valid-handle(hQueryCoins)  then delete object hQueryCoins.
       62       create query hQueryCoins.
       63       hQueryCoins:set-buffers(buffer tt-coins:HANDLE).
       64       hQueryCoins:query-prepare("FOR EACH tt-coins by tt-coins.id desc").
       65       hQueryCoins:query-open.
       66       return hQueryCoins.
       67   end.
       68   method private handle add_Banknot():
       69      define variable v-list-banknot as character no-undo .
       70      define variable ii             as integer   no-undo .
       71      v-list-banknot = "5000;2000;1000;500;200;100;50;10" .
       72       do ii = 1 to num-entries (v-list-banknot,";"):
       73         find first tt-banknots where tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       74         no-error.
       75         if not available tt-banknots
       76         then do:
       77            create tt-banknots .
       78            assign
       79              tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
       80              tt-banknots.qnty     = 0
       81              tt-banknots.sum-qnty = 0
       82              .
       83          end.
       84       end.
       85   end.
       86   method private handle getq_Banknot():
       87      if valid-handle(hQueryBanknot)  then delete object hQueryBanknot.
       88       create query hQueryBanknot.
       89       hQueryBanknot:set-buffers(buffer tt-banknots:HANDLE).
       90       hQueryBanknot:query-prepare("FOR EACH tt-banknots by tt-banknots.id desc").
       91       hQueryBanknot:query-open.
       92       return hQueryBanknot.
       93   end.
       94   method public char clean_char
       95   (INPUT in_str AS CHARACTER):
       96       DEFINE VARIABLE out_str  AS CHARACTER NO-UNDO.
       97       DEFINE VARIABLE i        AS INTEGER   NO-UNDO.
       98       DEFINE VARIABLE new_str  AS CHARACTER NO-UNDO.
       99       DEFINE VARIABLE ch_code  AS INTEGER   NO-UNDO.
      100       out_str = "".
      101       DO i = 1 TO LENGTH (in_str):
      102           new_str = SUBSTRING(in_str, i, 1).
      103           ch_code = ASC(new_str).
      104           IF  ch_code >= 32
      105           and ch_code < 1104
      106           and ch_code <> 166
      107           and ch_code <> 127
      108           and new_str <> "?"
      109           THEN out_str = out_str + new_str.
      110       END.
      111       RETURN out_str.
      112   END.
