      153     constructor public Cover_Sheet (p-host-code as integer, p-fin-code as integer, p-CashBookId as integer, p-sum-doc as decimal, p-mode as character ):
      154       super().
      155       v-host-code = p-host-code .
      156       v-fin-code  = p-fin-code .
      157       v-CashBookId = p-CashBookId .
      158       v-sum-doc = p-sum-doc .
      159       InitializeComponent().
      160       Visual(p-mode) .
      161       this-object:ComponentsCollection:ADD(this-object:components).
      162       catch e as Progress.Lang.Error:
      163         undo, throw e.
      164       end catch.
      165     end constructor.
      166     constructor public Cover_Sheet ( ):
      167       super().
      168       InitializeComponent().
      169       this-object:ComponentsCollection:ADD(this-object:components).
      170       catch e as Progress.Lang.Error:
      171         undo, throw e.
      172       end catch.
      173     end constructor.
      174     @VisualDesigner.
      175     method private void b_bank_recip_Click( input sender as System.Object, input e as System.EventArgs ):
      176       run ref/finbanks.w (input parParentProc
      177         , input v-host-code
      178         , input "b-sel":U
      179         , input 'фирма':U
      180         , input v-host-code
      181         , input-output v-status
      182         , input-output v-rid-list) no-error .
      183       if v-rid-list <> "" then
      184       do:
      185         FIND FIRST find_fin-bank No-LOCK where
      186           recid(find_fin-bank) = integer(entry(1, v-rid-list)) No-ERROR.
      187         if not avail find_fin-bank then
      188         do:
      189           message
      190             "Неверное значение параметра вызова v-rid-list" v-rid-list
      191             view-as alert-box error .
      192           return error.
      193         end.
      194         this-object:bank_recip:Text = find_fin-bank.bank-name.
      195         v-recip_bank = find_fin-bank.code-bank .
      196         find first ub.fin-schet no-lock where ub.fin-schet.code-bank = v-recip_bank no-error .
      197         if available (ub.fin-schet) then v-recip_schet = ub.fin-schet.r-schet .
      198       end.
      199       return.
      200     end method.
