      231     @VisualDesigner.
      232     method private void b_save_Click( input sender as System.Object, input e as System.EventArgs ):
      233       define variable CSJson as longchar no-undo .
      234       define variable CShtt  as handle   no-undo .
      235       define buffer bf_fin-doc-attr for ub.fin-doc-attr .
      236       define variable attr-value as character no-undo .
      237       define variable v-source   as character no-undo .
      238       define buffer buf_fin-doc for ub.fin-doc .
      239       if v-sum-doc <> windowContainer1:v-total-sum and v-sum-doc <> decimal(windowContainer1:Fsumm:Text) then
      240       do:
      241         message "Сумма документа " + string(v-sum-doc) + " не равна сумме " + string(windowContainer1:v-total-sum) + " из препроводительной ведомости."
      242           view-as alert-box.
      243         return no-apply .
      244       end.
      245       if this-object:num_bag:Text = "" then
      246       do:
      247         message "Номер сумки не заполнен"
      248           view-as alert-box.
      249         return no-apply .
      250       end.
      251       find first bf_fin-doc-attr exclusive-lock where bf_fin-doc-attr.attr-code = "pre-vedom" and bf_fin-doc-attr.host-code = v-host-code
      252         and bf_fin-doc-attr.fin-doc-code = v-fin-code no-error .
      253       if not available (bf_fin-doc-attr) then
      254       do:
      255         create bf_fin-doc-attr .
      256         assign
      257           bf_fin-doc-attr.attr-code    = "pre-vedom"
      258           bf_fin-doc-attr.fin-doc-code = v-fin-code
      259           bf_fin-doc-attr.host-code    = v-host-code
      260           .
      261       end.
      262       if this-object:source_rec:Text = "Поступления от продажи товаров" then v-source = "02" .
      263       else v-source = "32" .
      264       attr-value = clean_char(this-object:num_bag:Text) + ";" + string(v-deposit_bank) + ";" + string(v-recip_bank) + ";" +
      265         this-object:pin02:Text + ";" + this-object:source_rec:Text + ";" + string(windowContainer1:v-total-sum) + ";" + v-recip_schet .
      266       bf_fin-doc-attr.attr-value = attr-value .
      267       dataset ds-banknots:handle:write-json ("longchar",CSJson) .
      268       if CSJson <> ? then
      269       do:
      270         find first find_fin-doc-attr where find_fin-doc-attr.host-code = v-host-code and find_fin-doc-attr.attr-code = "cover_sheet"
      271           and find_fin-doc-attr.fin-doc-code = v-fin-code no-error .
      272         if not available (find_fin-doc-attr) then
      273         do:
      274           create find_fin-doc-attr .
      275           assign
      276             find_fin-doc-attr.attr-code    = "cover_sheet"
      277             find_fin-doc-attr.fin-doc-code = v-fin-code
      278             find_fin-doc-attr.host-code    = v-host-code
      279             .
      280         end.
      281         find_fin-doc-attr.attr-value = CSJson .
      282       end.
      283       this-object:DialogResult = System.Windows.Forms.DialogResult:Ok.
      284       Close().
      285       return.
      286     end method.
      287     @VisualDesigner.
      288     method private void Cover_Sheet_Load( input sender as System.Object, input e as System.EventArgs ):
      289       define variable ii     as integer  no-undo .
      290       define variable CSJson as longchar no-undo .
      291       define variable CShtt  as handle   no-undo .
      292       define buffer bf_fin-doc-attr for ub.fin-doc-attr .
      293       define variable attr-value as character no-undo .
      294       define buffer buf_cashbook for ub.CashBook .
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296     define variable v-cntxt-db-num        as integer   no-undo .
      297     define variable v-cntxt-userid        as character no-undo .
      298     define variable v-cntxt-level         as character no-undo .
      299     define variable v-cntxt-host-code-obj as integer   no-undo .
      300     define variable v-cntxt-obj-type      as character no-undo .
      301     define variable v-cntxt-obj-code      as integer   no-undo .
      302     define variable v-cntxt-db-num-obj    as integer   no-undo .
      303     define variable v-cntxt-is-admin      as logical   no-undo .
      304   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305     run mainmenu_getcntxt in parparentproc
      306       (output v-cntxt-db-num
      307       ,output v-cntxt-userid
      308       ,output v-cntxt-level
      309       ,output v-cntxt-host-code-obj
      310       ,output v-cntxt-obj-type
      311       ,output v-cntxt-obj-code
      312       ,output v-cntxt-db-num-obj
      313       ,output v-cntxt-is-admin
      314       ) .
      315       find first bf_fin-doc-attr exclusive-lock where bf_fin-doc-attr.attr-code = "pre-vedom" and bf_fin-doc-attr.host-code = v-host-code
      316         and bf_fin-doc-attr.fin-doc-code = v-fin-code and bf_fin-doc-attr.attr-value begins this-object:num_bag:Text no-error .
      317       if available (bf_fin-doc-attr) then
      318       do:
      319         assign
      320           this-object:num_bag:Text     = entry(1,bf_fin-doc-attr.attr-value,";")
      321           this-object:pin02:Text       = entry(4,bf_fin-doc-attr.attr-value,";")
      322           this-object:source_rec:Text  = entry(5,bf_fin-doc-attr.attr-value,";")
      323           windowContainer1:v-total-sum = decimal(entry(6,bf_fin-doc-attr.attr-value,";"))
      324           v-recip_schet                = entry(7,bf_fin-doc-attr.attr-value,";")
      325           .
      326         FIND FIRST find_fin-bank No-LOCK where find_fin-bank.code-bank = integer(entry(2,bf_fin-doc-attr.attr-value,";")) and find_fin-bank.host-code = v-host-code No-ERROR.
      327         if avail find_fin-bank then
      328         do:
      329           this-object:deposit_bank:Text = find_fin-bank.bank-name .
      330           v-deposit_bank = find_fin-bank.code-bank .
      331         end.
      332         FIND FIRST find_fin-bank No-LOCK where find_fin-bank.code-bank = integer(entry(3,bf_fin-doc-attr.attr-value,";")) and find_fin-bank.host-code = v-host-code No-ERROR.
      333         if avail find_fin-bank then
      334         do:
      335           this-object:bank_recip:Text = find_fin-bank.bank-name .
      336           v-recip_bank = find_fin-bank.code-bank .
      337         end.
      338       end.
      339       else
      340       do:
      341         for first buf_cashbook no-lock where buf_cashbook.id = v-CashBookId:
      342           if buf_cashbook.id = 0 then
      343           do:
      344             this-object:source_rec:Text = "Поступления от продажи товаров" .
      345           end.
      346           else
      347           do:
      348             this-object:source_rec:Text = "Прочие поступления".
      349           end.
      350           define variable mCashBook as class ibs.th.ref.cashbookstorage NO-UNDO.
      351           mCashBook = new  ibs.th.ref.cashbookstorage().
      352           vBankDepos-host = int(mCashBook:getSinglRule(v-CashBookId, 'всем':U, 0, "BankDepos-host")) .
      353           vBankDepos-code = int(mCashBook:getSinglRule(v-CashBookId, 'всем':U, 0, "BankDepos-code") ).
      354           vBankRecip-host = int(mCashBook:getSinglRule(v-CashBookId, 'всем':U, 0, "BankRecip-host")) .
      355           vBankRecip-code = int(mCashBook:getSinglRule(v-CashBookId, 'всем':U, 0, "BankRecip-code") ).
      356           v-recip_schet = mCashBook:getSinglRule(v-CashBookId, 'всем':U, 0, "BankRecip-acct") .
      357           delete object mCashBook no-error.
      358           FIND FIRST find_fin-bank No-LOCK where find_fin-bank.code-bank = vBankDepos-code
      359             and find_fin-bank.host-code = vBankDepos-host No-ERROR.
      360           if avail find_fin-bank then
      361           do:
      362             this-object:deposit_bank:Text = find_fin-bank.bank-name .
      363             v-deposit_bank = find_fin-bank.code-bank .
      364           end.
      365           FIND FIRST find_fin-bank No-LOCK where find_fin-bank.code-bank = vBankRecip-code
      366             and find_fin-bank.host-code = vBankRecip-host No-ERROR.
      367           if avail find_fin-bank then
      368           do:
      369             this-object:bank_recip:Text = find_fin-bank.bank-name .
      370             v-recip_bank = find_fin-bank.code-bank .
      371           end.
      372           for first ub.CashBookRule no-lock where
      373             ub.cashbookrule.CashBookID  = buf_cashbook.id and
      374             ub.cashbookrule.host-code   = string(v-host-code) and
      375             ub.CashBookRule.Obj-code   =  v-cntxt-obj-code and
      376             ub.CashBookRule.Obj-type   = string(v-cntxt-obj-type) and
      377             ub.cashbookrule.Status_     = 0 and
      378             ub.cashbookrule.Code        = "Pin" :
      379             this-object:pin02:Text = ub.cashbookrule.RuleValue .
      380           end.
      381         end.
      382       end.
      383       find first find_fin-doc-attr where find_fin-doc-attr.host-code = v-host-code and find_fin-doc-attr.attr-code = "cover_sheet"
      384         and find_fin-doc-attr.fin-doc-code = v-fin-code no-error .
      385       if available (find_fin-doc-attr) then
      386       do:
      387         CSJson = find_fin-doc-attr.attr-value .
      388         if CSJson <> ? and CSJson <> "" then
      389           dataset ds-banknots:handle:read-json ("longchar",CSJson) .
      390       end.
      391       add_Banknot().
      392       windowContainer1:Update_Banknots (getq_Banknot()).
      393       add_Coints().
      394       windowContainer1:Update_coints( getq_Coints()).
      395       return.
      396     end method.
