        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.ostcashbook_trg:
        4         define temp-table tt-cashBookOst no-undo
        5   field chang      as logical
        6   field cashbookid as int64
        7   field cashbookname as character
        8   field ost        as decimal
        9   field ostrasch   as decimal
       10   field osnpko     as decimal
       11   field osnrko     as decimal
       12   index pi cashbookid.
       13      define variable mQuery   as handle  no-undo .
       14      define public property  ChekSumm as logical no-undo
       15      get():
       16        define buffer tt-cashBookOst for tt-cashBookOst.
       17        find first tt-cashBookOst where tt-cashBookOst.cashbookid eq 0 no-error.
       18        return not available tt-cashBookOst or not tt-cashBookOst.chang.
       19      end.
       20      define public variable Summ as decimal no-undo.
       21      constructor public ostcashbook_trg (  ):
       22         super ().
       23      end constructor.
       24      method public void settt (input table tt-cashBookOst):
       25      end.
       26      method public void gettt (output table tt-cashBookOst):
       27      end.
       28      method public handle getQuery ():
       29         delete object mQuery no-error. // может быть еще не создана
       30         create query mQuery.
       31         mQuery:set-buffers(buffer tt-cashBookOst:HANDLE).
       32         mQuery:query-prepare("FOR EACH tt-cashBookOst").
       33         mQuery:query-open.
       34         return mQuery.
       35      end.
       36      method public decimal  cangCashbook ():
       37        if available tt-cashBookOst and tt-cashBookOst.ostrasch > 0
       38        then
       39           tt-cashBookOst.chang = not tt-cashBookOst.chang.
       40        return  getsumost().
       41      end.
       42      method public decimal  cangCashbookall (input IFLAG as logical):
       43        define buffer tt-cashBookOst for tt-cashBookOst.
       44        for each tt-cashBookOst where tt-cashBookOst.ostrasch > 0:
       45           tt-cashBookOst.chang = IFLAG.
       46        end.
       47        return  getsumost().
       48      end.
       49      method public decimal  getsumost ():
       50        define buffer tt-cashBookOst for tt-cashBookOst.
       51        define variable oSum as decimal no-undo.
       52        for each tt-cashBookOst where tt-cashBookOst.chang :
       53           oSum = oSum + tt-cashBookOst.ostrasch.
       54        end.
       55        Summ = osum.
       56        return oSum.
       57      end.
       58      destructor public ostcashbook_trg ( ):
       59      end destructor.
       60   end class.
