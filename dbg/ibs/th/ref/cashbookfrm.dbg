      698      method private void okButton_Click (sender as System.Object, e as System.EventArgs):
      699         bindingSource1:Assign().
      700         if tt-cashbook.id = ?
      701            then
      702         do :
      703            mCashBook:insertDB(buffer tt-cashbook, output v-cashbookId) .
      704         end.
      705         else
      706         do :
      707            mCashBook:updateDB(buffer tt-cashbook) .
      708         end.
      709         if mCashBook:Msg <> ""
      710            then
      711         do :
      712            message mCashBook:Msg view-as alert-box .
      713            return .
      714         end.
      715         this-object:DialogResult = System.Windows.Forms.DialogResult:Ok.
      716         this-object:Close ( ).
      717      end method.
