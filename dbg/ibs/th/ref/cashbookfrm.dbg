      170   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171     define variable v-cntxt-db-num        as integer   no-undo .
      172     define variable v-cntxt-userid        as character no-undo .
      173     define variable v-cntxt-level         as character no-undo .
      174     define variable v-cntxt-host-code-obj as integer   no-undo .
      175     define variable v-cntxt-obj-type      as character no-undo .
      176     define variable v-cntxt-obj-code      as integer   no-undo .
