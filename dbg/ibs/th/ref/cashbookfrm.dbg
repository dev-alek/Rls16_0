      181      define private variable vss-include-info as CHARACTER no-undo.
      182      define property parparentproc as handle no-undo
      183         private get.
      184         set(input iH as handle):
      185            parparentproc = ih.
      186   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187     run mainmenu_getcntxt in parparentproc
      188       (output v-cntxt-db-num
      189       ,output v-cntxt-userid
      190       ,output v-cntxt-level
      191       ,output v-cntxt-host-code-obj
      192       ,output v-cntxt-obj-type
      193       ,output v-cntxt-obj-code
      194       ,output v-cntxt-db-num-obj
      195       ,output v-cntxt-is-admin
      196       ) .
      197   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   run hostcode in ibs.th.gbl.gbl-hndllib:g#library
      199     (input  v-cntxt-obj-type
      200     ,input  v-cntxt-obj-code
      201     ,output v-host-code
      202     )  .
      203   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   run objdtget in ibs.th.gbl.gbl-hndllib:g#library
      205     (input  v-cntxt-obj-type
      206     ,input  v-cntxt-obj-code
      207     ,output v-obj-date
      208     ) no-error .
      209            if error-status:error then
      210               message substitute( "Ошибка чтения текущей даты на объекте &1&2" ,
      211                  v-cntxt-obj-type, v-cntxt-obj-code) view-as alert-box.
      212         end.
      213      constructor public cashbookfrm (Mode as character, p-id as int64 ):
      214         super().
      215         mCashBook = new cashbookstorage () .
      216         empty temp-table tt-cashbook .
      217         create tt-CashBook .
      218         case Mode:
      219            when 'ДОБАВЛЕНИЕ':U then
      220               do:
      221                  tt-cashbook.id = ? .
      222               end.
      223            when 'ИЗМЕНЕНИЕ':U
      224            or
      225            when 'ПРОСМОТР':U then
      226               do:
      227                  find first buf_cashbook no-lock where buf_cashbook.id = p-id .
      228                  buffer-copy buf_cashbook except buf_cashbook.RulePril buf_cashbook.RuleOsnPko to tt-cashbook .
      229                  tt-cashbook.RulePril = getRulePrilName(integer (buf_cashbook.RulePril)) .
      230                  tt-cashbook.RuleOsnPko = getRuleOsnName(buf_cashbook.RuleOsnPko) .
      231                  mCashBook:ttCashbooksaturation(buffer tt-cashbook:handle).
      232               end.
      233         end case .
      234         InitializeComponent().
      235         Visual_form(Mode).
      236         bindingSource1:Handle = buffer tt-CashBook:handle .
      237         this-object:ComponentsCollection:ADD(this-object:components).
      238         catch e as Progress.Lang.Error:
      239            undo, throw e.
      240         end catch.
      241      end constructor.
      242      constructor public cashbookfrm( ):
      243         super().
      244         InitializeComponent ( ).
      245         catch e as Progress.Lang.Error:
      246            undo, throw e.
      247         end catch.
      248      end constructor.
      249      destructor public cashbookfrm( ):
      250         delete object mCashBook no-error .
      251         if valid-object(components) then
      252         do:
      253            cast(components, System.IDisposable):Dispose().
      254         end.
      255      end destructor.
      256      @VisualDesigner.
      257      method private void bChooseCli_Click( input sender as System.Object, input e as System.EventArgs ):
      258         define variable ref-rec  as recid     no-undo .
      259         define variable ref-list as character no-undo.
      260         run ref/cli-all.w ( input parParentProc
      261            ,input "b-sel"
      262            ,input 'все':U
      263            ,input ?
      264            ,input ?
      265            ,input ?
      266            ,input ?
      267            ,input ?
      268            ,output ref-list) .
      269         if ref-list = "" then
      270         do:
      271            return .
      272         end.
      273         ref-rec = integer( ref-list ).
      274         FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
      275         this-object:lCli:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
      276         this-object:lCli:Focus().
      277         assign
      278            tt-CashBook.cli-type = ub.clients.obj-type
      279            tt-CashBook.cli-code = ub.clients.obj-code
      280            .
      281         return.
      282      end method.
