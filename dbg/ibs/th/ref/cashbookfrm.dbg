      337      @VisualDesigner.
      338      method private void bChooseCredit_Click( input sender as System.Object, input e as System.EventArgs ):
      339         define variable rid-list as character no-undo.
      340         rid-list = "":U .
      341         run ref/fwcode-1.w (
      342            parParentProc
      343            ,"b-sel"
      344            ,'все':U
      345            ,input ?
      346            ,input ?
      347            ,output rid-list ).
      348         if rid-list <> "":U then
      349         do:
      350            FIND FIRST fin-code-cor-acc WHERE
      351               recid( fin-code-cor-acc ) = integer(entry(1, rid-list)) NO-LOCK .
      352            if fin-code-cor-acc.status_ <> integer('0':U) then
      353            do:
      354               message
      355                  "Нельзя выбрать удаленный корр счет"
      356                  view-as alert-box error .
      357               return .
      358            end.
      359            this-object:fCorpko:Text = fin-code-cor-acc.code-value .
      360            this-object:fCorpko:focus() .
      361         end.
      362         return.
      363      end method.
