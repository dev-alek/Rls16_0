      445      @VisualDesigner.
      446      method private void btbankdep_Click( input sender as System.Object, input e as System.EventArgs ):
      447         define variable v-rid-list as character no-undo .
      448         define variable v-status_  like ub.fin-bank.status_ no-undo init 'тек':U.
      449         run ref/finbanks.w
      450            (input parparentproc
      451            ,input v-cntxt-host-code-obj
      452            ,input "b-sel":U
      453            ,input 'все':U
      454            ,input v-cntxt-host-code-obj
      455            ,input-output v-status_
      456            ,input-output v-rid-list
      457            ).
      458         find first fin-bank where recid(fin-bank) eq integer (v-rid-list) no-lock no-error.
      459         if available fin-bank
      460            then
      461            assign
      462               lbankdep:text              = fin-bank.bank-name
      463               tt-cashbook.BankDepos-host = fin-bank.host-code
      464               tt-cashbook.BankDepos-code = fin-bank.code-bank
      465               .
      466         return.
      467      end method.
      468      @VisualDesigner.
      469      method private void btbankrec_Click( input sender as System.Object, input e as System.EventArgs ):
      470         define variable v-rid-list as character no-undo .
      471         define variable v-status_  like ub.fin-bank.status_ no-undo init 'тек':U.
      472         run ref/finbanks.w
      473            (input parparentproc
      474            ,input v-cntxt-host-code-obj
      475            ,input "b-sel":U
      476            ,input 'все':U
      477            ,input v-cntxt-host-code-obj
      478            ,input-output v-status_
      479            ,input-output v-rid-list
      480            ).
      481         find first fin-bank where recid(fin-bank) eq integer (v-rid-list) no-lock no-error.
      482         if available fin-bank
      483            then
      484            assign
      485               lbankrec:text              = fin-bank.bank-name
