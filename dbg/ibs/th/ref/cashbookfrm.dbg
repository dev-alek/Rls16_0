      498            ,'все':U
      499            ,input ?
      500            ,input ?
      501            ,output rid-list ).
      502         if rid-list <> "":U then
      503         do:
      504            FIND FIRST fin-code-cor-acc WHERE
      505               recid( fin-code-cor-acc ) = integer(entry(1, rid-list)) NO-LOCK .
