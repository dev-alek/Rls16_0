       40   method private character getRuleOsnName (input p-rule-reason as character) :
       41       define variable v-name as character no-undo .
       42       case p-rule-reason :
       43         when "0" then v-name = "Выручка от реализации" .
       44         when "1" then v-name = "Номера Z-отчетов" .
       45         when "2" then v-name = "Не заполнять" .
       46           otherwise v-name = p-rule-reason .
       47       end case .
       48       return v-name .
       49     end method .
       50     method private character getRuleOsnID (input p-rule-reason as character) :
       51       define variable v-id as character no-undo .
       52       case p-rule-reason :
       53         when "Выручка от реализации" then v-id = "0" .
       54         when "Номера Z-отчетов" then v-id = "1" .
       55         when "Не заполнять" then v-id = "2" .
       56           otherwise v-id = p-rule-reason .
       57       end case .
       58       return v-id .
       59     end method .
       60     method private character getRulePrilName (input p-rule-att as integer) :
       61       define variable v-name as character no-undo .
       62       case p-rule-att :
       63         when 1 then v-name = "Не заполнять" .
       64           otherwise v-name = "Номера Z-отчетов" .
       65       end case .
       66       return v-name .
       67     end method .
       68       method private character getRulePrilID (input p-rule-att as character) :
       69       define variable v-id as character no-undo .
       70       case p-rule-att :
       71         when "Не заполнять" then v-id = "1" .
       72           otherwise v-id = "0" .
       73       end case .
       74       return v-id .
       75     end method .
