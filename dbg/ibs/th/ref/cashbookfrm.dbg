     1591      method public void Visual_form( input iChange AS character ):
     1592         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.cli-type
     1593            and ub.clients.obj-code = tt-cashbook.cli-code
     1594            no-error .
     1595         if available ub.clients
     1596            then
     1597         do :
     1598            this-object:lCli:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1599         end.
     1600         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.Vnecli-type
     1601            and ub.clients.obj-code = tt-cashbook.Vnecli-code
     1602            no-error .
     1603         if available ub.clients
     1604            then
     1605         do :
     1606            this-object:lCliVne:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1607         end.
     1608         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.Avanscli-type
     1609            and ub.clients.obj-code = tt-cashbook.Avanscli-code
     1610            no-error .
     1611         if available ub.clients
     1612            then
     1613         do :
     1614            this-object:lCliAvans:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1615         end.
     1616         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.CountCash-type
     1617            and ub.clients.obj-code = tt-cashbook.CountCash-code
     1618            no-error .
     1619         if available ub.clients
     1620            then
     1621         do :
     1622            this-object:lcashcli:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1623         end.
     1624         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.CountCollect-type
     1625            and ub.clients.obj-code = tt-cashbook.CountCollect-code
     1626            no-error .
     1627         if available ub.clients
     1628            then
     1629         do :
     1630            this-object:Lincasagent:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1631         end.
     1632         find first ub.clients no-lock where ub.clients.obj-type = tt-cashbook.contr-type-transf
     1633            and ub.clients.obj-code = tt-cashbook.contr-code-transf
     1634            no-error .
     1635         if available ub.clients
     1636            then
     1637         do :
     1638            this-object:lclitrans:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "   " + ub.clients.obj-name .
     1639         end.
     1640         find first fin-bank where fin-bank.host-code = tt-cashbook.BankRecip-host
     1641            and fin-bank.code-bank = tt-cashbook.BankRecip-code  no-lock no-error.
     1642         if available fin-bank
     1643            then
     1644            lbankrec:text              = fin-bank.bank-name.
     1645         find first fin-bank where fin-bank.host-code = tt-cashbook.Bankdepos-host
     1646            and fin-bank.code-bank = tt-cashbook.Bankdepos-code  no-lock no-error.
     1647         if available fin-bank
     1648            then
     1649            lbankdep:text              = fin-bank.bank-name.
     1650         if iChange = 'ПРОСМОТР':U then
     1651         do:
     1652           assign
     1653             this-object:fExtCode:ReadOnly          = true
     1654             this-object:fName:ReadOnly             = true
     1655             this-object:fCorpko:ReadOnly           = true
     1656             this-object:fCorpkoVne:ReadOnly        = true
     1657             this-object:fCorpkoAvans:ReadOnly      = true
     1658             this-object:FcorRko:ReadOnly           = true
     1659             this-object:fOsnacct:ReadOnly          = true
     1660             this-object:fTakenFrom:ReadOnly        = true
     1661             this-object:fTakenFromVne:ReadOnly     = true
     1662             this-object:fTakenFromAvans:ReadOnly   = true
     1663             this-object:fRuleOsnPko:Enabled        = false
     1664             this-object:fRuleOsnPkoAvans:Enabled   = false
     1665             this-object:fRuleOsnPkoVne:Enabled     = false
     1666             this-object:fRuleOsnRko:Enabled        = false
     1667             this-object:fRulePril:Enabled          = false
     1668             this-object:FlagSepCash:Enabled        = false
     1669             this-object:FlagSepFuel:Enabled        = false
