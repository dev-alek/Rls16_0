        1   USING Progress.Lang.*.
        2   USING ibs.th.str.mercury.*.
        3   USING ibs.th.gbl.storage.*.
        4   BLOCK-LEVEL ON ERROR UNDO, THROW.
        5   CLASS ibs.th.ref.journal_vsd_trg:
        6       DEFINE VARIABLE vss-revision       AS CHARACTER NO-UNDO INIT "$Revision$":U .
        7       DEFINE VARIABLE vss-author         AS CHARACTER NO-UNDO INIT "$Author$":U .
        8       DEFINE VARIABLE vss-date           AS CHARACTER NO-UNDO INIT "$Date$":U .
        9       DEFINE VARIABLE vss-workfile       AS CHARACTER NO-UNDO INIT "$Workfile$":U .
       10       DEFINE VARIABLE vss-archive        AS CHARACTER NO-UNDO INIT "$Archive$":U .
       11       DEFINE VARIABLE vss-description    AS CHARACTER NO-UNDO INIT "Журнал ВСД".
       12       DEFINE TEMP-TABLE t-obj-list NO-UNDO
       13       FIELD obj-type  AS CHARACTER
       14       FIELD obj-code  AS INTEGER
       15       FIELD host-code AS INTEGER
       16       INDEX pi IS UNIQUE PRIMARY obj-type  obj-code
       17       INDEX firm                 host-code.
       18   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19   define  temp-table tt-gds-list no-undo like ub.goods
       20     field qnty   as decimal
       21     field to-del as logical
       22     field order-num as integer
       23     field to-sel as logical
       24     field promo-code as character
       25     field ActionId  as int64
       26     field db-num as integer
       27     index art  is primary unique artic prod-type prod-code
       28     index code is         unique gds-code
       29     index oi order-num
       30     index isel to-sel
       31     .
       32   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       33   define    temp-table tt-gds-list-hist no-undo
       34   field list-table as character
       35   field id as integer
       36   field line as integer
       37   field hist-mode as character
       38   field des as character
       39   field num-recs as integer
       40   field option_ as character
       41   field item_ as character
       42   field status_ as character
       43   field num-add as integer
       44   field num-ignored as integer
       45   field done as logical
       46   field err_ as logical
       47   field err-mes as character
       48   index pi is primary
       49   id
       50   line
       51   index isdone
       52   done
       53   .
       54   DEFINE TEMP-TABLE tt-vsd-filt NO-UNDO
       55   FIELD date-end AS DATE
       56   FIELD date-start AS DATE
       57   FIELD fTime  AS INTEGER
       58   FIELD FalExting AS LOGICAL
       59   FIELD FalVerif  AS LOGICAL
       60   FIELD Rep       AS LOGICAL
       61   FIELD ReqVerif  AS LOGICAL
       62   FIELD ToExtin   AS LOGICAL
       63   FIELD Sent      AS LOGICAL
       64   FIELD doc-code  AS CHARACTER
       65   .
       66   DEFINE DATASET ds-vsd-set
       67   FOR tt-vsd-filt, t-obj-list,  tt-gds-list .
       68   DEFINE TEMP-TABLE ttvsd NO-UNDO LIKE ub.vsd
       69           FIELD dateTTH     AS DATE
       70           FIELD NomTTH      AS CHAR
       71           FIELD NomTTHpost  AS CHAR
       72           FIELD NomAZS      AS CHAR
       73           FIELD Post        AS CHAR
       74           FIELD artic       AS CHAR
       75           FIELD gdsname     AS CHAR
       76           FIELD prod-code   AS CHAR
       77           FIELD COLobj      AS DEC
       78           FIELD unit-cli    AS CHAR
       79           FIELD unit-base   AS CHAR
       80           FIELD statusvsd   AS CHAR
       81           FIELD ojd         AS DEC
       82           FIELD gdsmercguid AS CHAR
       83           FIELD vsdtypelbl  AS CHAR
       84           FIELD vsdsubs     AS CLASS Progress.Lang.Object.
       85   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86     define variable v-cntxt-db-num        as integer   no-undo .
       87     define variable v-cntxt-userid        as character no-undo .
       88     define variable v-cntxt-level         as character no-undo .
       89     define variable v-cntxt-host-code-obj as integer   no-undo .
       90     define variable v-cntxt-obj-type      as character no-undo .
       91     define variable v-cntxt-obj-code      as integer   no-undo .
       92     define variable v-cntxt-db-num-obj    as integer   no-undo .
       93     define variable v-cntxt-is-admin      as logical   no-undo .
       94       DEFINE VARIABLE parparentproc AS HANDLE NO-UNDO.
       95       CONSTRUCTOR PUBLIC journal_vsd_trg (INPUT  pparparentproc AS HANDLE ):
       96       parparentproc = pparparentproc.
       97   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98     run mainmenu_getcntxt in parparentproc
       99       (output v-cntxt-db-num
      100       ,output v-cntxt-userid
      101       ,output v-cntxt-level
      102       ,output v-cntxt-host-code-obj
      103       ,output v-cntxt-obj-type
      104       ,output v-cntxt-obj-code
      105       ,output v-cntxt-db-num-obj
      106       ,output v-cntxt-is-admin
      107       ) .
      108       END CONSTRUCTOR.
      109       METHOD PUBLIC  VOID VSD_lock(INPUT pID AS INTEGER  , INPUT pdb-num AS INTEGER,input pvsdsubs AS Progress.Lang.Object   ):
      110           DEFINE VARIABLE vsdsubsObj AS CLASS vsdsubs NO-UNDO.
      111           DEFINE VARIABLE vSave AS LOGICAL NO-UNDO.
      112           DEFINE BUFFER vsd FOR ub.vsd.
      113           FIND FIRST vsd WHERE vsd.id EQ pID
      114               AND vsd.db-num EQ pdb-num
      115               NO-LOCK NO-ERROR.
      116           IF AVAIL vsd
      117               THEN
      118           DO:
      119               vsdsubsObj = CAST (pvsdsubs, vsdsubs).
      120               RUN str/vsd.w (INPUT parparentproc, INPUT 'ПРОСМОТР':U, INPUT vsdsubsObj, OUTPUT vSave).
      121           END.
      122           RETURN.
      123       END METHOD.
      124       METHOD PUBLIC  VOID VSD_edit(INPUT pID AS INTEGER  , INPUT pdb-num AS INTEGER,input pvsdsubs AS Progress.Lang.Object   ):
      125          DEFINE VARIABLE vsdsubsObj    AS CLASS vsdsubs      NO-UNDO.
      126          DEFINE VARIABLE vsdsubObj     AS CLASS vsdsub       NO-UNDO.
      127          DEFINE VARIABLE vsdStorageObj AS CLASS vsdtostorage NO-UNDO.
      128          DEFINE BUFFER vsd FOR ub.vsd.
      129          DEFINE VARIABLE vSave AS LOGICAL NO-UNDO.
      130          DEFINE VARIABLE vI AS INTEGER NO-UNDO.
      131          FIND FIRST vsd WHERE vsd.id     EQ pID
      132                           AND vsd.db-num EQ pdb-num
      133             NO-LOCK NO-ERROR.
      134          IF AVAIL vsd
      135          THEN DO:
      136             vsdsubsObj = CAST (pvsdsubs, vsdsubs).
      137             RUN str/vsd.w (INPUT parparentproc, INPUT 'ИЗМЕНЕНИЕ':U, INPUT vsdsubsObj, OUTPUT vSave).
      138             IF vSave
      139             THEN DO:
      140                DO vi = 1 TO vsdsubsObj:GetItem(vi):
      141                   vsdsubObj = vsdsubsObj:VsdObjCurr.
      142                   IF vsdsubObj:Changed
      143                   THEN DO:
      144                      vsdStorageObj = NEW vsdtostorage ().
      145                      CASE TRUE:
      146                         WHEN vsdsubObj:ID > 0
      147                         THEN DO:
      148                            vsdStorageObj:updateDB(vsdsubObj).
      149                         END.
      150                         OTHERWISE DO:
      151                            vsdStorageObj:insertDB(vsdsubObj).
      152                         END.
      153                      END CASE.
      154                       DELETE  OBJECT vsdStorageObj NO-ERROR.
      155                   END.
      156                END.
      157             END.
      158          END.
      159           RETURN.
      160       END METHOD.
      161       METHOD PUBLIC  VOID gds_lock(INPUT pgds-code AS INTEGER,input pobj-type AS CHARACTER ,input pobj-code AS INTEGER  ):
      162           DEFINE VARIABLE gds-rec  AS INT64 NO-UNDO.
      163           DEFINE BUFFER goods FOR ub.goods.
      164           FIND FIRST goods WHERE goods.gds-code EQ pgds-code NO-LOCK NO-ERROR.
      165           IF AVAIL goods
      166           THEN DO:
      167               gds-rec = recid(goods).
      168               run ref/gds-form.w (
      169                   INPUT parparentproc
      170                   , INPUT 'ПРОСМОТР':U
      171                   , INPUT pobj-type
      172                   , INPUT pobj-code
      173                   , input ?
      174                   , input-output gds-rec
      175                   ) .
      176           END.
      177           RETURN.
      178       END METHOD.
      179       METHOD PUBLIC  VOID gds_merc_lock(INPUT pgds-code AS INTEGER  ):
      180           run ref/merq-gds.w (
      181               parparentproc
      182               ,INPUT-OUTPUT pgds-code
      183               ,INPUT 'ПРОСМОТР':U
      184               ) no-error .
      185           RETURN.
      186       END METHOD.
      187       METHOD PUBLIC  VOID trn_doc_lock(INPUT ppart-key AS CHARACTER,INPUT pgds-code AS INTEGER ):
      188           DEFINE BUFFER doc-line FOR ub.doc-line.
      189       DEFINE BUFFER trn-doc  FOR ub.trn-doc.
      190       DEFINE BUFFER goods FOR ub.goods.
      191       DEFINE VARIABLE vlog AS LOGICAL NO-UNDO.
      192       FIND FIRST trn-doc WHERE trn-doc.doc-code EQ ENTRY (8,ppart-key,chr(3)) NO-LOCK NO-ERROR.
      193       IF AVAIL trn-doc
      194       THEN DO :
      195           CASE trn-doc.doc-type:
      196               WHEN 'при':U
      197               THEN DO:
      198   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   do:
      200     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      201       (input  v-cntxt-db-num
      202       ,input  v-cntxt-userid
      203       ,input  0
      204       ,input  'actn_income_lookup':U
      205       ,input  'object':U
      206       ,input  trn-doc.host-code
      207       ,input  trn-doc.obj-type
      208       ,input  trn-doc.obj-code
      209       ,input  0
      210       ,input  0
      211       ,input  0
      212       ,input  true
      213       ,output vlog
      214       )  .
      215   end.
      216               END.
      217               WHEN 'рас':U
      218               THEN DO:
      219   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   do:
      221     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      222       (input  v-cntxt-db-num
      223       ,input  v-cntxt-userid
      224       ,input  0
      225       ,input  'actn_expense_lookup':U
      226       ,input  'object':U
      227       ,input  trn-doc.host-code
      228       ,input  trn-doc.obj-type
      229       ,input  trn-doc.obj-code
      230       ,input  0
      231       ,input  0
      232       ,input  0
      233       ,input  true
      234       ,output vlog
      235       )  .
      236   end.
      237               END.
      238               WHEN 'спи':U
      239               THEN DO:
      240   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   do:
      242     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      243       (input  v-cntxt-db-num
      244       ,input  v-cntxt-userid
      245       ,input  0
      246       ,input  'actn_write-off_lookup':U
      247       ,input  'object':U
      248       ,input  trn-doc.host-code
      249       ,input  trn-doc.obj-type
      250       ,input  trn-doc.obj-code
      251       ,input  0
      252       ,input  0
      253       ,input  0
      254       ,input  true
      255       ,output vlog
      256       )  .
      257   end.
      258               END .
      259               WHEN 'инв':U
      260               THEN DO:
      261   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   do:
      263     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      264       (input  v-cntxt-db-num
      265       ,input  v-cntxt-userid
      266       ,input  0
      267       ,input  'actn_inventory_lookup':U
      268       ,input  'object':U
      269       ,input  trn-doc.host-code
      270       ,input  trn-doc.obj-type
      271       ,input  trn-doc.obj-code
      272       ,input  0
      273       ,input  0
      274       ,input  0
      275       ,input  true
      276       ,output vlog
      277       )  .
      278   end.
      279               END.
      280               WHEN 'возврат':U
      281               THEN DO:
      282   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      283   do:
      284     run chk-actg in ibs.th.gbl.gbl-hndllib:g#library2
      285       (input  v-cntxt-db-num
      286       ,input  v-cntxt-userid
      287       ,input  0
      288       ,input  'actn_return_lookup':U
      289       ,input  'object':U
      290       ,input  trn-doc.host-code
      291       ,input  trn-doc.obj-type
      292       ,input  trn-doc.obj-code
      293       ,input  0
      294       ,input  0
      295       ,input  0
      296       ,input  true
      297       ,output vlog
      298       )  .
      299   end.
      300                END.
      301                OTHERWISE
      302                DO:
      303                   MESSAGE
      304                       vss-workfile vss-revision vss-description skip
      305                       "Неизвестный тип документа" skip
      306                       "Тип документа" trn-doc.doc-type skip
      307                       "Код документа" trn-doc.doc-code skip
      308                       VIEW-AS ALERT-BOX ERROR .
      309               END.
      310           END CASE .
      311           IF NOT vlog THEN RETURN NO-APPLY.
      312           FIND FIRST goods WHERE goods.gds-code EQ pgds-code NO-LOCK NO-ERROR.
      313           IF AVAIL goods
      314           THEN DO:
      315               FIND doc-line WHERE doc-line.doc-code  = trn-doc.doc-code
      316                               AND doc-line.artic     = goods.artic
      317                               AND doc-line.prod-type = goods.prod-type
      318                               AND doc-line.prod-code = goods.prod-code
      319               NO-LOCK  NO-ERROR .
      320               IF AVAIL doc-line
      321               THEN
      322                   RUN str/trn-lkp.p (parparentproc, recid(trn-doc), recid(doc-line)).
      323           END.
      324       END.
      325           RETURN.
      326       END METHOD.
      327       METHOD PUBLIC  VOID filt-clen ( output DATASET FOR ds-vsd-set   ):
      328       DEFINE VARIABLE v-object-available AS LOGICAL   NO-UNDO .
      329      ASSIGN
      330           tt-vsd-filt.date-end   = TODAY
      331           tt-vsd-filt.date-start = TODAY
      332           tt-vsd-filt.FalExting   = YES
      333           tt-vsd-filt.FalVerif    = YES
      334           tt-vsd-filt.Rep         = YES
      335           tt-vsd-filt.ReqVerif    = YES
      336           tt-vsd-filt.ToExtin     = YES
      337           tt-vsd-filt.fTime        = 0
      338           tt-vsd-filt.doc-code = ?
      339           .
      340         FOR EACH t-obj-list:
      341            delete t-obj-list.
      342         end.
      343         FOR EACH tt-gds-list:
      344            delete tt-gds-list.
      345         end.
      346         FOR EACH db NO-LOCK
      347           ON ERROR UNDO, RETURN NO-APPLY
      348           :
      349           FOR EACH clients NO-LOCK
      350               WHERE clients.db-num = db.db-num
      351               ON ERROR UNDO, RETURN NO-APPLY
      352               :
      353   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   run usobjava in ibs.th.gbl.gbl-hndllib:g#library2
      355     (input  v-cntxt-db-num
      356     ,input  0
      357     ,input  v-cntxt-userid
      358     ,input  clients.obj-type
      359     ,input  clients.obj-code
      360     ,output v-object-available
      361     ) no-error .
      362               IF ERROR-STATUS :ERROR
      363                   THEN
      364               DO:
      365                   MESSAGE
      366                       vss-workfile vss-revision vss-description SKIP
      367                       "Ошибка при вызове процедуры gbl/usobjava.i" SKIP
      368                       ERROR-STATUS :GET-MESSAGE(1) SKIP
      369                       RETURN-VALUE SKIP
      370                       VIEW-AS ALERT-BOX ERROR .
      371                   UNDO, RETURN NO-APPLY .
      372               END.
      373               IF v-object-available = TRUE
      374                   THEN
      375               DO:
      376                   CREATE t-obj-list .
      377                   ASSIGN
      378                       t-obj-list.obj-type = clients.obj-type
      379                       t-obj-list.obj-code = clients.obj-code
      380                       no-error.
      381               END.
      382           END.
      383       END.
      384       RETURN.
      385       END METHOD.
      386       METHOD PUBLIC  VOID CreateTT ( INPUT DATASET FOR ds-vsd-set ,output TABLE ttvsd  ):
      387       FOR EACH ttvsd :
      388          DELETE ttvsd.
      389       END.
      390       FIND FIRST tt-vsd-filt NO-ERROR.
      391           DEFINE BUFFER goods       FOR ub.goods.
      392           DEFINE BUFFER trn-doc     FOR ub.trn-doc.
      393           DEFINE BUFFER clients     FOR ub.clients.
      394           DEFINE BUFFER bclients    FOR ub.clients.
      395           DEFINE VARIABLE vStatus      AS CHARACTER NO-UNDO.
      396           DEFINE VARIABLE vGdsChek     AS LOGICAL   NO-UNDO.
      397           DEFINE VARIABLE v-attr-type  AS CHARACTER NO-UNDO.
      398           DEFINE VARIABLE vOjd         AS INTEGER   NO-UNDO.
      399           DEFINE VARIABLE vI           AS INTEGER   NO-UNDO.
      400           DEFINE VARIABLE vsdsTHObj    AS CLASS     vsdsubs.
      401           DEFINE VARIABLE vsdTHObj     AS CLASS     vsdsub.
      402           DEFINE VARIABLE vsdsOneTHObj AS CLASS     vsdsubs.
      403           DEFINE VARIABLE vsdStorage   AS CLASS     vsdtostorage.
      404           FIND FIRST tt-vsd-filt NO-ERROR.
      405           IF tt-vsd-filt.ReqVerif THEN
      406               vStatus = vStatus + ",0".
      407           IF tt-vsd-filt.FalVerif THEN
      408               vStatus = vStatus + ",1".
      409           IF tt-vsd-filt.ToExtin THEN
      410               vStatus = vStatus + ",2".
      411           IF tt-vsd-filt.FalExting THEN
      412               vStatus = vStatus + ",3".
      413           IF tt-vsd-filt.Rep THEN
      414               vStatus = vStatus + ",4".
      415           IF tt-vsd-filt.sent THEN
      416               vStatus = vStatus + ",5".
      417           vStatus = SUBSTRING(vStatus,2).
      418           .
      419           FIND FIRST tt-gds-list NO-LOCK NO-ERROR.
      420           vGdsChek = AVAIL tt-gds-list.
      421           IF    tt-vsd-filt.doc-code EQ "?"
      422               OR tt-vsd-filt.doc-code EQ ""
      423               THEN tt-vsd-filt.doc-code = ?.
      424           DEFINE VARIABLE ml AS LOGICAL   NO-UNDO.
      425           vsdStorage = NEW vsdtostorage ().
      426           FOR EACH t-obj-list:
      427               vsdsTHObj = vsdStorage:getVSDsubs(t-obj-list.obj-type,t-obj-list.obj-code,vstatus).
      428               vsdsTHObj:IsDelChildObj = NO .
      429               Block-vsd:
      430               DO vi = 1 TO vsdsTHObj:GetItem (vi):
      431                   FIND FIRST ttvsd WHERE ttVSD.ID         = vsdsTHObj:VsdObjCurr:ID
      432                       AND ttvsd.db-num       = vsdsTHObj:VsdObjCurr:DBNum
      433                       NO-ERROR.
      434                   IF AVAIL ttvsd
      435                       THEN
      436                       NEXT Block-vsd.
      437                   FIND FIRST trn-doc WHERE trn-doc.doc-code EQ ENTRY (8,vsdsTHObj:VsdObjCurr:PartKey,chr(3)) NO-LOCK NO-ERROR.
      438                   IF NOT AVAIL trn-doc
      439                       THEN
      440                       NEXT Block-vsd.
      441                   IF    trn-doc.doc-date < tt-vsd-filt.date-start
      442                       OR trn-doc.doc-date > tt-vsd-filt.date-end
      443                       OR (tt-vsd-filt.doc-code NE ?
      444                       AND NOT CAN-DO(tt-vsd-filt.doc-code,trn-doc.doc-code))
      445                       THEN
      446                       NEXT Block-vsd.
      447                   FIND FIRST goods WHERE goods.gds-code EQ vsdsTHObj:VsdObjCurr:GdsCode NO-LOCK NO-ERROR.
      448                   IF NOT AVAIL goods THEN NEXT Block-vsd.
      449                   CASE  vGdsChek:
      450                       WHEN YES THEN
      451                           DO:
      452                               FIND FIRST tt-gds-list
      453                                   WHERE tt-gds-list.artic     = goods.artic
      454                                   AND tt-gds-list.prod-type = goods.prod-type
      455                                   AND tt-gds-list.prod-code = goods.prod-code NO-ERROR .
      456                               IF NOT AVAILABLE tt-gds-list THEN NEXT Block-vsd.
      457                           END.
      458                       OTHERWISE .
      459                   END.
      460                   FIND FIRST  clients WHERE clients.obj-type EQ goods.prod-type
      461                       AND clients.obj-code EQ goods.prod-code
      462                       NO-LOCK NO-ERROR.
      463                   FIND FIRST  bclients WHERE bclients.obj-type EQ  trn-doc.cli-type
      464                       AND bclients.obj-code EQ trn-doc.cli-code
      465                       NO-LOCK NO-ERROR.
      466                   vOjd =  IF vsdsTHObj:VsdObjCurr:PendingRepayment THEN 0 ELSE TRUNC ((NOW - vsdsTHObj:VsdObjCurr:FactDatetime)/ (1000 * 60 * 60),0).
      467                   IF    vOjd >= tt-vsd-filt.fTime
      468                       OR vsdsTHObj:VsdObjCurr:PendingRepayment
      469                       THEN
      470                   DO:
      471                       vsdsOneTHObj = NEW vsdsubs ().
      472                       vsdsOneTHObj:AddItem(vsdsTHObj:VsdObjCurr).
      473                       CREATE ttvsd.
      474                       ttvsd.gds-name-merc = vsdsTHObj:VsdObjCurr:GdsMercName.
      475                       ttvsd.gds-guid      = vsdsTHObj:VsdObjCurr:GdsGUID.
      476                       ttvsd.gdsmercguid   = vsdsTHObj:VsdObjCurr:GdsMercGUID.
      477                       ttvsd.msg-err       = vsdsTHObj:VsdObjCurr:MsgErr.
      478                       ttvsd.gds-code      = vsdsTHObj:VsdObjCurr:GdsCode.
      479                       ttVSD.UUID          = vsdsTHObj:VsdObjCurr:UUID.
      480                       ttvsd.date-out      = vsdsTHObj:VsdObjCurr:DateOut.
      481                       ttvsd.date-cr       = vsdsTHObj:VsdObjCurr:DateCr.
      482                       ttvsd.expiry-date   = vsdsTHObj:VsdObjCurr:ExpiryDate.
      483                       ttvsd.expiry-date-2 = vsdsTHObj:VsdObjCurr:ExpiryDate2.
      484                       ttVSD.statusvsd     = vsdsTHObj:VsdObjCurr:StatusLbl.
      485                       ttVSD.ID            = vsdsTHObj:VsdObjCurr:ID.
      486                       ttvsd.db-num        = vsdsTHObj:VsdObjCurr:DBNum.
      487                       ttvsd.part-key      = vsdsTHObj:VsdObjCurr:PartKey.
      488                       ttvsd.obj-type      = vsdsTHObj:VsdObjCurr:ObjType.
      489                       ttvsd.obj-code      = vsdsTHObj:VsdObjCurr:ObjCode.
      490                       ttvsd.vsdtypelbl    = vsdsTHObj:VsdObjCurr:VSDTypeLbl.
      491                       ttVSD.COLobj        = vsdsTHObj:VsdObjCurr:Qnty.
      492                       ttvsd.vsdsubs       = CAST (vsdsOneTHObj  , Progress.Lang.Object).
      493                       ASSIGN
      494                           ttVSD.dateTTH    = trn-doc.doc-date
      495                           ttVSD.NomTTH     = trn-doc.doc-code
      496                           ttVSD.NomTTHpost = trn-doc.rcv-code
      497                           ttVSD.NomAZS     = STRING(t-obj-list.obj-code)
      498                           ttVSD.Post       = IF AVAIL bclients
      499                                              THEN bclients.obj-name
      500                           ELSE ""
      501                           ttVSD.artic      = goods.artic
      502                           ttVSD.gdsname    = goods.gds-name
      503                           ttVSD.prod-code  = IF AVAIL clients
      504                                              THEN clients.obj-name
      505                           ELSE ""
      506                           ttVSD.ojd        = vojd
      507                           .
      508                       if vsdsTHObj:VsdObjCurr:UnitGuid <> "" and vsdsTHObj:VsdObjCurr:UnitGuid <> ?
      509                       then do :
      510                         for first units-attr no-lock where units-attr.attr-code = "MercGuid"
      511                                                        and units-attr.attr-value = vsdsTHObj:VsdObjCurr:UnitGuid :
      512                           ttVSD.unit-cli = units-attr.unit-name .
      513                         end.
      514                       end.
      515                       RUN gbl/trdcat-v.p
      516                           ( INPUT trn-doc.doc-code
      517                           ,INPUT 'nids':U
      518                           ,OUTPUT ttVSD.NomTTHpost
      519                           ,OUTPUT v-attr-type
      520                           ).
      521                   END.
      522               END.
      523               FINALLY:
      524                   DELETE OBJECT vsdsTHObj  NO-ERROR.
      525               END FINALLY.
      526           END.
      527             FINALLY :
      528               DELETE OBJECT vsdStorage NO-ERROR .
      529           END FINALLY.
      530       END METHOD.
      531   END CLASS.
