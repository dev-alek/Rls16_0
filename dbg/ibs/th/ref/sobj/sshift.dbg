      696      method private void  val-shift ():
      697         if TOGShift:Checked = true
      698         then do:
      699            shiftstart:visible = yes.
      700            ShiftStartlab:visible = yes.
      701            togshift2:visible  = yes.
      702            if togshift2:Checked
      703            then do:
      704               BtnShiftend:visible = no.
      705            end.
      706            else do:
      707               shiftend:visible = yes.
      708               shiftendlab:visible = yes.
      709            end.
      710            if  mTrgLoc:avail_shift-obj()
      711            then do:
      712               BtnShiftStart:visible = yes.
      713               BtnShiftend:visible = not togshift2:Checked.
      714            end.
      715         end.
      716         else do:
      717            TogShift2:Checked = false.
      718            dateend:visible = yes.
      719            dateendlab:visible = yes.
      720            ShiftEnd:visible = no.
      721            ShiftEndlab:visible = no.
      722            ShiftStart:visible = no.
      723            ShiftStartlab:visible = no.
      724            TogShift2:visible = no.
      725            btnshiftend:visible = no.
      726            btnshiftstart:visible = no.
      727         end.
      728      end method.
      729      method private void  val-shift2 ():
      730         DateEnd:value  = DateStart:value.
      731         ShiftEnd:value = ShiftStart:Value.
      732         define variable vdateend as date no-undo.
      733         define variable vShiftEnd as integer no-undo.
      734         vdateend = DateStart:value.
      735         vShiftEnd = ShiftEnd:value.
      736         mTrgLoc:set-end(vdateend, vShiftEnd).
      737         if TOGShift2:Checked
      738         then do:
      739            DateEnd:visible = no.
      740            shiftend:visible = no.
      741            DateEndlab:visible = no.
      742            shiftendlab:visible = no.
      743         end.
      744         else do:
      745            DateEnd:visible = yes.
      746            shiftend:visible = yes.
      747            DateEndlab:visible = yes.
      748            shiftendlab:visible = yes.
      749         end.
      750         if mTrgLoc:avail_shift-obj()
      751         then do:
      752            btnshiftend:visible = not TOGShift2:Checked .
      753         end.
      754      end method.
      755      method private void  VALUE-CHANGED_TOG-Shift (itog-shift as logical):
      756         mTrgLoc:VALUE-CHANGED_TOG-Shift (itog-shift).
      757      end.
      758      method private void  VALUE-CHANGE_RADIO-task ():
      759         define variable v-Date-End as date no-undo.
      760         define variable v-Date-Start as date no-undo.
      761         v-Date-End    = DateEnd:Value .
      762         v-Date-Start  = dateStart:Value.
      763         mTrgLoc:Set_Date-Start(v-Date-Start).
      764         mTrgLoc:Set_Date-End(v-Date-End).
      765         define variable vshift as integer no-undo.
      766         vshift = shiftEnd:value.
      767         mTrgLoc:set_shift-End(vshift) .
      768         vshift = shiftEnd:value.
      769         mTrgLoc:set_shift-Start (vshift).
      770         vshift = shiftEnd:value.
      771         mTrgLoc:set_shift-alone (vshift).
      772         define variable vRADIO-task as character no-undo.
      773         vRADIO-task = RADIO-task.
      774         display-radio-task (vRADIO-task).
      775         mTrgLoc:VALUE-CHANGE_RADIO-task( vRADIO-task).
      776      end.
      777      method private void display-RAdio-task(iRAdio-task as character ) :
      778         define variable vRAdio-task as integer no-undo.
      779         vRAdio-task = sType:RAdiotaskInt(iRAdio-task).
      780         case vRAdio-task :
      781            when  1
      782            then do:
      783               assign
      784                  TOGShift:Checked = false
      785                  DateAlone:Visible = no
      786                  ShiftAlone:Visible = no
      787                  DateAlonelab:Visible = no
      788                  ShiftAlonelab:Visible = no
      789                  Btnshift:Visible = no
      790                  ShiftEnd:Visible = no
      791                  ShiftStart:Visible = no
      792                  ShiftEndlab:Visible = no
      793                  ShiftStartlab:Visible = no
      794                  TOGShift:Visible = no
      795               .
      796               assign
      797                  DateEnd:Visible = yes
      798                  DateStart:Visible = yes
      799                  DateEndlab:Visible = yes
      800                  DateStartlab:Visible = yes
      801               .
      802               mTrgLoc:set_tog-shift (false).
      803            end.
      804            when 2 then do:
      805               assign
      806                  DateAlone:Visible = no
      807                  ShiftAlone:Visible = no
      808                  DateAlonelab:Visible = no
      809                  ShiftAlonelab:Visible = no
      810                  Btnshift:Visible = no
      811                  ShiftEnd:Visible = no
      812                  ShiftStart:Visible = no
      813                  ShiftEndlab:Visible = no
      814                  ShiftStartlab:Visible = no
      815                  TOGShift:Visible = no
      816                  TOGShift:checked = true
      817               .
      818               assign
      819                  DateEnd:Visible = yes
      820                  DateStart:Visible = yes
      821                  DateEndlab:Visible = yes
      822                  DateStartlab:Visible = yes
      823               .
      824               mTrgLoc:set_tog-shift ( true).
      825            end.
      826            when 3 then do:
      827               assign
      828                  DateEnd:Visible = yes
      829                  DateStart:Visible = yes
      830                  ShiftEnd:Visible = yes
      831                  ShiftStart:Visible = yes
      832                  DateEndlab:Visible = yes
      833                  DateStartlab:Visible = yes
      834                  ShiftEndlab:Visible = yes
      835                  ShiftStartlab:Visible = yes
      836               .
      837               assign
      838                  TOGShift:checked = true
      839                  DateAlone:Visible = no
      840                  ShiftAlone:Visible = no
      841                  DateAlonelab:Visible = no
      842                  ShiftAlonelab:Visible = no
      843                  Btnshift:Visible = no
      844                  TOGShift:Visible = no
      845               .
      846               mTrgLoc:set_tog-shift ( true).
      847            end.
      848            when 4 then do:
      849               assign
      850                  DateEnd:Visible = yes
      851                  DateStart:Visible = yes
      852                  ShiftAlone:Visible = yes
      853                  DateEndlab:Visible = yes
      854                  DateStartlab:Visible = yes
      855                  ShiftAlonelab:Visible = yes
      856               .
      857               assign
      858                  DateAlone:Visible = no
      859                  ShiftEnd:Visible = no
      860                  DateAlonelab:Visible = no
      861                  ShiftEndlab:Visible = no
      862                  Btnshift:Visible = no
      863                  ShiftStart:Visible = no
      864                  ShiftStartlab:Visible = no
      865                  TOGShift:checked = true
      866                  TOGShift:Visible = no
      867               .
      868               define variable vShiftAlone as integer no-undo.
      869               vShiftAlone = ShiftAlone:value.
      870               mTrgLoc:set_Shift-End(vShiftAlone).
      871               mTrgLoc:set_Shift-Start(vShiftAlone).
      872               assign
      873                  Shiftstart:Value = vShiftAlone
      874                  ShiftEnd:Value = vShiftAlone
      875               .
      876               mTrgLoc:set_tog-shift ( true).
      877            end.
      878         end.
      879      end method.
      880      method private void display-date () :
      881      case ParamForm:temp-param-date:
      882         when 0
      883         then do:
      884            assign
      885               Radio_Task:Visible = no
      886               TEXT3:Visible = no
      887               DateAlone:Visible = no
      888               DateAlonelab:Visible = no
      889               Btnshift:Visible = no
      890               ShiftAlone:Visible = no
      891               DateEnd:Visible = no
      892               DateStart:Visible = no
      893               ShiftEnd:Visible = no
      894               ShiftStart:Visible = no
      895               ShiftAlonelab:Visible = no
      896               DateEndlab:Visible = no
      897               DateStartlab:Visible = no
      898               ShiftEndlab:Visible = no
      899               ShiftStartlab:Visible = no
      900               TOGShift:Visible = no
      901               Radio_Period:Visible = no
      902            .
      903         end.
      904         when 1
      905         then do:
      906            assign
      907               TEXT3:Visible = yes
      908               DateAlone:Visible = yes
      909               DateAlonelab:Visible = yes
      910            .
      911            assign
      912               Radio_task:Visible = no
      913               DateEnd:Visible = no
      914               DateStart:Visible = no
      915               ShiftAlone:Visible = no
      916               DateEndlab:Visible = no
      917               DateStartlab:Visible = no
      918               ShiftAlonelab:Visible = no
      919               Btnshift:Visible = no
      920               ShiftEnd:Visible = no
      921               ShiftStart:Visible = no
      922               ShiftEndlab:Visible = no
      923               ShiftStartlab:Visible = no
      924               TOGShift:Visible = no
      925               Radio_Period:Visible = no
      926            .
      927         end.
      928         when 2
      929         then do:
      930            assign
      931               TEXT3:Visible = yes
      932               DateEnd:Visible = yes
      933               DateStart:Visible = yes
      934               DateEndlab:Visible = yes
      935               DateStartlab:Visible = yes
      936            .
      937            TEXT3:Text = 'Выбор периода'.
      938            assign
      939               Radio_task:Visible = no
      940               DateAlone:Visible = no
      941               ShiftAlone:Visible = no
      942               DateAlonelab:Visible = no
      943               ShiftAlonelab:Visible = no
      944               Btnshift:Visible = no
      945               ShiftEnd:Visible = no
