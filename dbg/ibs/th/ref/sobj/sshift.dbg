      544   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      545      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      546      define variable v-curr-sv-date as date no-undo .
      547      define variable v-new-sv-date  as date no-undo .
      548      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      549      then do:
      550         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      551         run gbl/getcurdt.p
      552            (output v-curr-sv-date
      553         ) .
      554         vdate:value = v-curr-sv-date.
      555      end.
      556      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      557      then do:
      558         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      559         v-curr-sv-date = vdate:value .
      560         if v-curr-sv-date = ?
      561         then do:
      562            run gbl/getcurdt.p
      563               (output v-curr-sv-date
      564            ) .
      565         end.
      566         if v-curr-sv-date <> ?
      567         then do:
      568            assign
      569               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      570               vdate:value = v-new-sv-date
      571            .
      572         end.
      573      end.
      574      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      575      then do:
      576         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      577         v-curr-sv-date = vdate:value.
      578         if v-curr-sv-date = ?
      579         then do:
      580            run gbl/getcurdt.p
      581               (output v-curr-sv-date
      582            ) .
      583         end.
      584         if v-curr-sv-date <> ?
      585         then do:
      586            run gbl/lastdate.p
      587               (input  v-curr-sv-date
      588               ,output v-new-sv-date
      589            ).
      590            vdate:value = v-new-sv-date.
      591         end.
      592      end.
      593      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      594      then do:
      595         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      596         define variable v-description   as character no-undo .
      597         define variable v-ok            as logical no-undo.
      598         v-curr-sv-date = vdate:value.
      599         if v-curr-sv-date = ?
      600         then do:
      601            run gbl/getcurdt.p
      602               (output v-curr-sv-date
      603            ) .
      604         end.
      605         if v-curr-sv-date <> ?
      606         then do:
      607            run gbl/d-inpday.w
      608               (input ?
      609               ,input "Выбор даты"
      610               ,input v-description
      611               ,input ""
      612               ,input-output v-curr-sv-date
      613               ,output v-ok
      614            ).
      615            if v-ok = true
      616            then do:
      617               vdate:value = v-curr-sv-date .
      618            end.
      619         end.
      620      end.
      621   end method.
      622   method private void End_date_KeyDown():
      623         catch e as Progress.Lang.Error:
      624            undo, throw e.
      625         end catch.
      626      end method.
