      955            assign
      956               TEXT3:Visible = yes
      957               DateEnd:Visible = yes
      958               DateStart:Visible = yes
      959               ShiftStart:Visible = yes
      960               ShiftAlone:Visible = yes
      961               DateEndlab:Visible = yes
      962               DateStartlab:Visible = yes
      963               ShiftStartlab:Visible = yes
      964               ShiftAlonelab:Visible = yes
      965            .
