       92      method public void Assign-frame(  ):
       93         define variable vtog-shift as logical no-undo.
       94         vtog-shift = togshift:checked.
       95         if    ParamForm:temp-param-date = 8
       96            or ParamForm:temp-param-date = 7
       97         then
       98            vtog-shift = true .
       99         define variable vDate-End as date no-undo.
      100         define variable vShift-End as integer no-undo.
      101         define variable vDate-Alone as date no-undo.
      102         define variable vShift-Alone as integer no-undo.
      103         define variable vDate-Start as date no-undo.
      104         define variable vShift-Start as integer no-undo.
      105         define variable vFlg as logical no-undo.
      106         assign
      107            vDate-End = date(DateEnd:value)
      108            vShift-End = int(ShiftEnd:value)
      109            vDate-Alone = date(DateAlone:Value)
      110            vShift-Alone = int(ShiftAlone:value)
      111            vDate-Start = date(DateStart:Value)
      112            vShift-Start = int(ShiftStart:value)
      113         .
      114         if     vtog-shift
      115            and togshift2:Checked
      116         then assign
      117            vDate-End       = Datestart:Value
      118            vShift-End      = ShiftStart:Value
      119         .
      120         mTrgLoc:set_Date-Alone    (vDate-Alone).
      121         mTrgLoc:set_Date-End      (vDate-End).
      122         mTrgLoc:set_Date-Start    (vDate-Start).
      123         mTrgLoc:set_Shift-Alone   (vShift-Alone).
      124         mTrgLoc:set_Shift-End     (vShift-End).
      125         mTrgLoc:set_Shift-Start   (vShift-Start).
      126         mTrgLoc:set_TOG-Shift      ( vTOG-Shift).
      127         mTrgLoc:set_RADIO-task     ( RADIO-task).
      128         if     DateAlone:visible
      129            and dateend:visible = false
      130         then do:
      131            mTrgLoc:set_Date-Start    (vDate-Alone) .
      132            mTrgLoc:set_Date-End      (vDate-Alone)   .
      133         end.
      134         if radioButton4:Checked
      135         then do:
      136            mTrgLoc:set_Shift-End     (vShift-Alone).
      137            mTrgLoc:set_Shift-Start   (vShift-Alone).
      138         end.
      139         define variable t-str as character no-undo.
      140         case ParamForm:temp-param-date :
      141            when 0 then t-str = "" .
      142            when 1 then t-str = " На " + string(vDate-Alone,"99/99/9999").
      143            when 2 then t-str = " За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      144            when 3 then t-str = " По смене № " + string(vShift-Alone) + "  за период с " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      145            when 4 then do:
      146               if     vtog-shift
      147                  and togshift2:Checked
      148               then
      149                  t-str = " По смене № "  + string(vShift-Start) + " на  " + string(vDate-Start,"99/99/9999") .
      150               else
      151                   t-str =  (if vtog-shift then "Смены с "  + string(vShift-Start)   + " по "  + string(vShift-End)  else "" ) +
      152                   " За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      153                   end.
      154            when 5 or when 6 then do:
      155               case yes:
      156                  when radioButton1:Checked
      157                  then
      158                     t-str = "Календарные сутки , За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      159                  when radioButton2:Checked
      160                  then
      161                     t-str = "Сменные сутки , За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      162                  when radioButton3:Checked
      163                  then
      164                     t-str = "Сменные сутки,  За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") +
      165                                     " Смены с "  + string(vShift-Start)   + " по "  + string(vShift-End)   .
      166                  when radioButton4:Checked
      167                  then
      168                     t-str = " По смене № " + string(vShift-Alone) + " За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      169               end case.
      170            end.
      171            when 7 then t-str = " По смене № " + string(vShift-Alone) + "  дата открытия " + string(vDate-Start,"99/99/9999") .
      172            when 8 then do:
      173                   t-str =
      174                   "Смены с "  + string(vShift-Start)   + " по "  + string(vShift-End)  +
      175                   " За период с  " + string(vDate-Start,"99/99/9999") + "  по " + string(vDate-End,"99/99/9999") .
      176            end.
      177            when 9 then do:
      178                   t-str =
      179                   "Период : за " + radio_period:Text .
      180            end.
      181         end case.
      182         mTrgLoc:set_strShift( t-str).
      183         return.
      184      end method.
