     1233                  DateStartlab:visible = no
     1234                  DateEndlab:visible = no
     1235               .
     1236            end.
     1237         end case.
     1238      end method.
     1239      method public void local-apply-layout(iparamObj as class ibs.th.ref.sobj.sParamObj):
     1240         assign
     1241            DateAlone:Value   = iparamObj:X-Date-Alone  when iparamObj:X-Date-Alone ne ?
     1242            DateEnd:Value     = iparamObj:X-Date-End    when iparamObj:X-Date-End ne ?
     1243            DateStart:Value   = iparamObj:X-Date-Start  when iparamObj:X-Date-Start ne ?
     1244            ShiftAlone:Value  = iparamObj:X-Shift-Alone
     1245            ShiftEnd:Value    = iparamObj:X-Shift-End
     1246            ShiftStart:Value  = iparamObj:X-Shift-Start
     1247            TOGShift:Checked  = iparamObj:X-TOG-Shift
     1248            RADIO-task        = string(iparamObj:x-RADIO-task) when iparamObj:x-RADIO-task ne 0
     1249         .
     1250         if iparamObj:x-Date-Alone = date('') then  DateAlone:Value   = ParamForm:init-Date-Alone.
     1251         if iparamObj:x-Date-End   = date('') then  DateEnd:Value     = ParamForm:init-Date-End  .
     1252         if iparamObj:x-Date-Start = date('') then  DateStart:Value   = ParamForm:init-Date-Start.
     1253         if iparamObj:x-Shift-alone = 0 then        Shiftalone:Value  = ParamForm:init-shift-alone.
     1254         if iparamObj:x-Shift-start = 0 then        Shiftstart:Value  = ParamForm:init-shift-start.
     1255         if iparamObj:x-Shift-end = 0 then          Shiftend:Value    = ParamForm:init-shift-end  .
     1256         if      ParamForm:temp-param-date  = 9
     1257            and ( radio_period:Text = ? or radio_period:Text = "" )
     1258         then do:
     1259            if ParamForm:temp-param-date-type-period <> ?
     1260            then radio_period:Text  = ParamForm:temp-param-date-type-period.
     1261         end.
     1262        if mTrgLoc:avail_shift-obj()
     1263        then  do:
     1264           if ParamForm:temp-param-date = 4 then  togshift:Checked = true .
     1265           if    ParamForm:temp-param-date = 8
     1266              or ParamForm:temp-param-date = 7
     1267           then  assign
     1268                    togshift:Checked = true
     1269                    iparamObj:x-tog-shift = true
     1270                 .
     1271        end.
     1272         if    ParamForm:temp-param-date < 5
     1273            or ParamForm:temp-param-date = 7
     1274         then
     1275            radioButton1:Checked = yes.
     1276         val-shift() .
     1277         display-date () .
     1278         define variable vdatestart as date no-undo.
     1279         define variable vdateend as date no-undo.
     1280         vdatestart = datestart:value.
     1281         vdateend   = dateend:value.
     1282         mTrgLoc:verify-date(vDateStart, vDateEnd)  .
     1283         if    ParamForm:temp-param-date = 5
     1284            or ParamForm:temp-param-date = 6
     1285         then  display-radio-task (RADIO-task).
     1286         if iparamObj:params-only-mode  = 'ПРОСМОТР':U
     1287         then do:
     1288            assign
     1289               radio_task:enabled = no
     1290               datealone:enabled = no
     1291               togshift2:enabled = no
     1292               togshift:enabled = no
     1293               shiftalone:enabled = no
     1294               shiftend:enabled = no
     1295               datestart:enabled = no
     1296               dateend:enabled = no
     1297               radio_period:enabled = no
     1298            .
     1299         end.
     1300      end.
     1301      method public character  AssignParam():
     1302         define variable vdatestart as date no-undo.
     1303         define variable vdateend as date no-undo.
     1304         define variable vtext as character no-undo.
     1305         vdatestart = datestart:value.
     1306         vdateend   = dateend:value.
     1307         vtext = mTrgLoc:verify-date(vDateStart, vDateEnd)  no-error.
     1308         if error-status:error
     1309         then
     1310            return error vtext.
     1311      end.
     1312      destructor public sShift ( ):
     1313         delete object mTrgLoc no-error.
     1314      end destructor.
     1315   end class.
