      967            assign
      968               DateAlone:Visible = no
      969               ShiftEnd:Visible = no
      970               shiftstart:Visible = no
      971               DateAlonelab:Visible = no
      972               ShiftEndlab:Visible = no
      973               shiftstartlab:Visible = no
      974               TOGShift:Visible = no
      975               RADIO_task:Visible = no
      976               Radio_Period:Visible = no
      977            .
      978         end.
      979         when 4
      980         then do:
      981            if TOGShift2:Checked
      982            then do:
      983               assign
      984                  DateEnd:Visible = no
      985                  shiftend:Visible = no
      986                  DateEndlab:Visible = no
      987                  shiftendlab:Visible = no
      988               .
      989            end.
      990            else do:
      991               assign
      992                  DateEnd:Visible = yes
      993                  shiftend:Visible = yes
      994                  DateEndlab:Visible = yes
      995                  shiftendlab:Visible = yes
      996               .
      997            end.
      998            assign
      999               TEXT3:Visible = yes
     1000               DateStart:Visible = yes
     1001               ShiftStart:Visible = yes
     1002               DateStartlab:Visible = yes
     1003               ShiftStartlab:Visible = yes
     1004               TOGShift:Visible = yes
     1005            .
     1006            if not togshift:Checked
     1007            then do:
     1008               assign
     1009                  Shiftstart:Visible = no
     1010                  shiftend:Visible = no
     1011                  Shiftstartlab:Visible = no
     1012                  shiftendlab:Visible = no
     1013                  BtnShiftend:Visible = no
     1014                  BtnShiftStart:Visible = no
     1015                  Radio_Period:Visible = no
     1016               .
     1017            end.
     1018            else do:
     1019               if togshift2:Checked
     1020               then do:
     1021                  assign
     1022                     shiftend:ReadOnly = yes
     1023                     BtnShiftend:visible = no
     1024                     DateEnd:enabled = no
     1025                     DateEndlab:enabled = no
     1026                  .
     1027                  assign
     1028                     Shiftstart:ReadOnly = no
     1029                     BtnShiftStart:visible = yes
     1030                  .
     1031                  Shiftstart:visible = yes .
     1032                  Shiftstartlab:visible = yes .
     1033                  assign
     1034                     TEXT3:visible = yes
     1035                     DateStart:visible = yes
     1036                     DateEnd:visible = yes
     1037                     ShiftStart:visible = yes
     1038                     ShiftEnd:visible = yes
     1039                     DateStartlab:visible = yes
     1040                     DateEndlab:visible = yes
     1041                     ShiftStartlab:visible = yes
     1042                     ShiftEndlab:visible = yes
     1043                     TOGShift:visible = yes
     1044                  .
     1045               end.
     1046               else do:
     1047                  assign
     1048                     Shiftstart:visible = yes
     1049                     shiftend:visible = yes
     1050                     Shiftstartlab:visible = yes
     1051                     shiftendlab:visible = yes
     1052                     BtnShiftend:visible = yes
     1053                     BtnShiftStart:visible = yes
     1054                  .
     1055                  assign
     1056                     TEXT3:visible = yes
     1057                     DateStart:visible = yes
     1058                     DateEnd:visible = yes
     1059                     ShiftStart:visible = yes
     1060                     ShiftEnd:visible = yes
     1061                     DateStartlab:visible = yes
     1062                     DateEndlab:visible = yes
     1063                     ShiftStartlab:visible = yes
     1064                     ShiftEndlab:visible = yes
     1065                     TOGShift:visible = yes
     1066                     DateStart:Enabled = no
     1067                     DateEnd:Enabled = no
     1068                     ShiftStart:Enabled = no
     1069                     ShiftEnd:Enabled = no
     1070                     TOGShift:Enabled = no
     1071                  .
     1072                   end.
     1073            end.
     1074            assign
     1075               DateStart:visible = yes
     1076               DateEnd:visible = yes
     1077               DateStartlab:visible = yes
     1078               DateEndlab:visible = yes
     1079               TOGShift:visible = yes
     1080               DateStart:Enabled = yes
     1081               DateEnd:Enabled = yes
     1082               TOGShift:Enabled = yes
     1083            .
     1084            assign
     1085               DateAlone:visible = no
     1086               DateAlonelab:visible = no
     1087               Btnshift:visible = no
     1088               ShiftAlone:visible = no
     1089               ShiftAlonelab:visible = no
     1090               Radio_task:visible = no
     1091               Radio_Period:visible = no
     1092            .
     1093            if ParamForm:temp-param-obj = ""
     1094            then do:
     1095               if mTrgLoc:avail_shift-obj()
     1096               then  do:
     1097                  assign
     1098                     ShiftStart:visible = no
     1099                     ShiftStartlab:visible = no
     1100                     TOGShift:visible = no
     1101                     ShiftEnd:visible = no
     1102                     ShiftEndlab:visible = no
     1103                     TOGShift2:visible = no
     1104                     BtnShiftend:visible = no
     1105                     BtnShiftStart:visible = no
     1106                  .
     1107               end.
     1108               else do:
     1109                 if togshift:Checked
     1110                 then do:
     1111                    BtnShiftStart:visible = yes .
     1112                    if not togshift2:Checked
     1113                    then
     1114                       BtnShiftend:visible = yes .
     1115                 end.
     1116              end.
     1117           end.
     1118        end.
     1119        when 5
     1120        then do:
     1121            assign
     1122               TEXT3:visible = yes
     1123               DateEnd:visible = yes
     1124               DateStart:visible = yes
     1125               DateEndlab:visible = yes
     1126               DateStartlab:visible = yes
     1127               RADIO_task:visible = yes
     1128            .
     1129            assign
     1130               DateAlone:visible = no
     1131               DateAlonelab:visible = no
     1132               Btnshift:visible = no
     1133               ShiftAlone:visible = no
     1134               ShiftAlonelab:visible = no
     1135               TOGShift:visible = no
     1136               Radio_Period:visible = no
     1137            .
     1138            end.
     1139          when 6
     1140          then do:
     1141               assign
     1142                  TEXT3:visible = yes
     1143                  DateEnd:visible = yes
     1144                  DateStart:visible = yes
     1145                  DateEndlab:visible = yes
     1146                  DateStartlab:visible = yes
     1147                  RADIO_task:visible = yes
     1148               .
     1149               assign
     1150                  DateAlone:visible = no
     1151                  DateAlonelab:visible = no
     1152                  Btnshift:visible = no
     1153                  ShiftAlone:visible = no
     1154                  ShiftAlonelab:visible = no
     1155                  TOGShift:visible = no
     1156                  Radio_Period:visible = no
     1157               .
     1158               radioButton3:visible = no.
     1159               radioButton4:visible = no.
     1160          end.
     1161          when 7
     1162          then do:
     1163             TEXT3:Text = 'Выбор смены'.
     1164             assign
     1165                TEXT3:visible = yes
     1166                DateStart:visible = yes
     1167                ShiftStart:visible = yes
     1168                ShiftAlone:visible = yes
     1169                DateStartlab:visible = yes
     1170                ShiftStartlab:visible = yes
     1171                ShiftAlonelab:visible = yes
     1172             .
     1173             assign
     1174                DateAlone:visible = no
     1175                dateend:visible = no
     1176                ShiftEnd:visible = no
     1177                shiftstart:visible = no
     1178                DateAlonelab:visible = no
     1179                dateendlab:visible = no
     1180                ShiftEndlab:visible = no
     1181                shiftstartlab:visible = no
     1182                TOGShift:visible = no
     1183                RADIO_task:visible = no
     1184                Radio_Period:visible = no
     1185             .
     1186          end.
     1187          when 8
     1188          then do:
     1189             togshift:Checked = true .
     1190             togshift2:Checked = false  .
     1191             mTrgLoc:set_tog-shift( true) .
     1192             assign
     1193                TEXT3:visible = yes
     1194                DateStart:visible = yes
     1195                ShiftStart:visible = yes
     1196                DateEnd:visible = yes
     1197                shiftend:visible = yes
     1198                DateStartlab:visible = yes
     1199                ShiftStartlab:visible = yes
     1200                DateEndlab:visible = yes
     1201                shiftendlab:visible = yes
     1202                BtnShiftend:visible = yes
     1203                BtnShiftStart:visible = yes
     1204             .
     1205             assign
     1206                DateAlone:visible = no
     1207                DateAlonelab:visible = no
     1208                Btnshift:visible = no
     1209                ShiftAlone:visible = no
     1210                ShiftAlonelab:visible = no
     1211                Radio_task:visible = no
     1212                togshift:visible = no
     1213                togshift2:visible = no
     1214                Radio_Period:visible = no
     1215             .
     1216          end.
     1217          when 9 then do:
     1218               TEXT3:Text ='Выбор периода'.
     1219               assign
