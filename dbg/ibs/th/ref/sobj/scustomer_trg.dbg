        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.sobj.sCustomer_trg:
        4   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        5   def   temp-table cli-list no-undo like ub.clients
        6     field to-del as logical
        7     index obj  is primary unique obj-type obj-code
        8     index cli-name      obj-name
        9     .
       10      define public property stype as class ibs.th.ref.sobj.stype no-undo
       11      get.
       12      set.
       13      define public property ParamObj as class ibs.th.ref.sobj.sParamObj no-undo
       14      get.
       15      set.
       16      define public property ParamForm as class ibs.th.ref.sobj.sParamForm no-undo
       17      get.
       18      set.
       19      constructor public sCustomer_trg (  ):
       20         super ().
       21      end constructor.
       22      destructor public sCustomer_trg ( ):
       23      end destructor.
       24      method public character  VALUE-CHANGED_Radio-customer (input-output pRadioCustomer as character ):
       25         define variable ocustomer-name as character no-undo.
       26         define variable customer-recids as character no-undo.
       27         define variable v-ii as integer no-undo.
       28         define buffer buf_clients for ub.clients.
       29         define variable vRadioCustomer as integer  no-undo.
       30         vRadioCustomer = stype:RadioCustomerInt(pRadioCustomer).
       31         ParamObj:empty-g#customer().
       32         case vRadioCustomer :
       33            when 1 then do:
       34               ocustomer-name = 'все':U.
       35            end.
       36            when 2 then do:
       37               if ParamForm:temp-param-customer-type  = ""
       38               then
       39                  ParamForm:temp-param-customer-type = 'все':U.
       40               run str/cli-list_class.p
       41                            ( ParamObj:my-handle
       42                            , ParamObj:my-cntxt-host-code-obj
       43                            , ParamObj:my-cntxt-obj-type
       44                            , ParamObj:my-cntxt-obj-code
       45                            ,output table cli-list
       46                               ) .
       47               if not can-find (first cli-list no-lock )
       48               then do:
       49                    ocustomer-name = 'все':U.
       50                    pRadiocustomer = stype:RadioCustomerLbl(1).
       51               end.
       52               else do:
       53                   ocustomer-name = ''.
       54                   for each cli-list  :
       55                      ParamObj:create_g#customer(cli-list.obj-type, cli-list.obj-code, cli-list.obj-name).
       56                       if length (ocustomer-name) >= 10000
       57                       then do:
       58                          ocustomer-name = trim(ocustomer-name , '...') .
       59                          ocustomer-name = ocustomer-name + '...' .
       60                       end.
       61                       else ocustomer-name = ocustomer-name + cli-list.obj-name + chr(10).
       62                   end.
       63               end.
       64            end.
       65         end case.
       66         new-state ("RADIO-CUSTOMER="  + string(vRadiocustomer)).
       67         return ocustomer-name.
       68      end method.
       69      method public logical set_TextLb (itext as character ):
       70         paramobj:x-text-cust = itext.
       71      end method.
       72      method public void Assign-frame(iRadioCustomer as character ):
       73         define variable t-str as character no-undo.
       74         define variable vRadioCustomer as integer no-undo.
       75         vRadioCustomer = stype:RadioCustomerInt(iRadioCustomer).
       76         if ParamForm:temp-param-customer <> ""
       77         then do:
       78            t-str = paramobj:x-text-cust + ": " .
       79            t-str = t-str + paramobj:get-custumer-text().
       80            if vRadioCustomer = 1 then t-str = t-str + chr(10) + "все" .
       81            paramobj:strcust = t-str .
       82         end.
       83      end method.
       84      method private void new-state(istate as character ):
       85      end method.
       86   end class.
