      345       usertableObj:init_tt().
      346       bindingSource1:handle:query-open.
      347       bindingSource1:RefreshAll() .
      348       users:handle:query-open.
      349       users:RefreshAll() .
      350       RETURN.
      351       END METHOD.
      352       DESTRUCTOR PUBLIC userhist ( ):
      353           IF VALID-OBJECT(components) THEN DO:
      354               CAST(components, System.IDisposable):Dispose().
      355           END.
      356       END DESTRUCTOR.
      357   END CLASS.
