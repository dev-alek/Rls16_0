      329       METHOD OVERRIDE PUBLIC VOID my-report ():
      330       if  str2 = yes then do:
      331          usertableObj:my_report().
      332          bindingSource1:handle:query-open.
      333          bindingSource1:RefreshAll() .
      334          users:handle:query-open.
      335          users:RefreshAll() .
