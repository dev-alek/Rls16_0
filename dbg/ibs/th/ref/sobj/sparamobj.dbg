      534     define variable v-cntxt-db-num        as integer   no-undo .
      535     define variable v-cntxt-userid        as character no-undo .
      536     define variable v-cntxt-level         as character no-undo .
      537     define variable v-cntxt-host-code-obj as integer   no-undo .
      538     define variable v-cntxt-obj-type      as character no-undo .
      539     define variable v-cntxt-obj-code      as integer   no-undo .
      540     define variable v-cntxt-db-num-obj    as integer   no-undo .
      541     define variable v-cntxt-is-admin      as logical   no-undo .
      542   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543     run mainmenu_getcntxt in my-handle
      544       (output v-cntxt-db-num
      545       ,output v-cntxt-userid
      546       ,output v-cntxt-level
      547       ,output v-cntxt-host-code-obj
      548       ,output v-cntxt-obj-type
      549       ,output v-cntxt-obj-code
      550       ,output v-cntxt-db-num-obj
      551       ,output v-cntxt-is-admin
      552       ) .
      553   define variable base-type as character no-undo .
      554   define variable base-code as integer   no-undo .
      555   define variable g#report-num as integer   no-undo .
      556   define variable g#gds-engl as logical   no-undo .
      557   define variable vv-exch-rate  as decimal   no-undo .
      558   define variable vv-exch-scale as decimal   no-undo .
      559   define variable v-cntxt-host-name-obj as character no-undo .
      560   if v-cntxt-level = 'object':U then do:
      561   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   run hostname in ibs.th.gbl.gbl-hndllib:g#library
      563     (input  v-cntxt-obj-type
      564     ,input  v-cntxt-obj-code
      565     ,output v-cntxt-host-code-obj
      566     ,output v-cntxt-host-name-obj
      567     )  .
      568   end.
      569   if v-cntxt-level = 'firm':U then do:
      570     find first ub.clients no-lock where
      571                ub.clients.obj-type = 'орг':U and
      572                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      573   if error-status :error then v-cntxt-host-name-obj = ? .
      574      else v-cntxt-host-name-obj = ub.clients.obj-name.
      575   end.
      576   if v-cntxt-level = 'object':U
      577   or v-cntxt-level = 'firm':U
      578   then do:
      579   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   run basecode in ibs.th.gbl.gbl-hndllib:g#library
      581     (input  v-cntxt-host-code-obj
      582     ,output base-code
      583     )  .
      584   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   run exchrate in ibs.th.gbl.gbl-hndllib:g#library
      586     (input  base-code
      587     ,input  today
      588     ,output vv-exch-rate
      589     ,output vv-exch-scale
      590     ,output base-type
      591     )  .
      592   end.
      593   run get-report-num in my-handle ( output g#report-num ).
      594   run get-gds-engl in my-handle ( output g#gds-engl ) .
      595         assign
      596            my-cntxt-db-num = v-cntxt-db-num
      597            my-cntxt-userid = v-cntxt-userid
      598            my-cntxt-level = v-cntxt-level
      599            my-cntxt-host-code-obj = v-cntxt-host-code-obj
      600            my-cntxt-obj-type = v-cntxt-obj-type
      601            my-cntxt-obj-code = v-cntxt-obj-code
      602            my-cntxt-db-num-obj = v-cntxt-db-num-obj
      603            my-cntxt-is-admin = v-cntxt-is-admin
      604            my-base-type  = base-type
      605            my-base-code = base-code
      606            my-g#report-num = g#report-num
      607            my-g#gds-engl = g#gds-engl
      608            my-v-exch-rate = vv-exch-rate
      609            my-v-exch-scale = vv-exch-scale
      610            my-cntxt-host-name-obj = v-cntxt-host-name-obj
      611         .
      612      end method.
      613      method public logical  avail_obj-list (iobj-type as character ,iobj-code as integer ):
      614         define buffer obj-list for obj-list.
      615         return can-find (first obj-list where obj-list.obj-type = iobj-type
      616                                           and obj-list.obj-code = iobj-code).
      617      end method.
      618      method public character get-obj-List-text():
      619         define variable otext as character no-undo.
      620         define buffer cli-obj   for ub.clients .
      621         for each Obj-list :
      622             find cli-obj where cli-obj.obj-type = obj-list.obj-type  and
      623                                cli-obj.obj-code = obj-list.obj-code no-lock .
      624             if length(otext) <= 6000
      625             then
      626                otext = otext + chr(10) + "     " + cli-obj.obj-name  + ' ' + obj-list.obj-type.
      627         end.
      628         return otext.
      629      end method.
      630      method public integer  get-count-gds-list():
      631         define variable lns-cnt as integer no-undo.
      632         for each gds-list :
      633            lns-cnt = lns-cnt + 1 .
      634         end.
      635         return lns-cnt.
      636      end method.
      637      method public character get-custumer-text():
      638         define variable oStr as character no-undo.
      639         block-cust:
      640         for each g#customer:
      641            if length (oStr) >= 10000
      642            then do:
      643               oStr = oStr + '...' .
      644               leave block-cust.
      645            end.
      646            else oStr = oStr + chr(10) + "     " + g#customer.obj-name .
      647         end.
      648         return oStr.
      649      end method.
      650      method public void  CheckAndUpNameObjList():
      651         define variable L#obj-code like obj-list.obj-code no-undo.
      652         define variable l#obj-type like obj-list.obj-type no-undo.
      653         define buffer obj-list   for obj-list .
      654         define buffer o-clients  for ub.clients.
      655         assign
      656            L#obj-code=0
      657            l#obj-type=""
      658         .
      659         for each obj-list  by obj-list.obj-code by obj-list.obj-type :
      660            if obj-list.obj-code = L#obj-code and
      661               obj-list.obj-type = l#obj-type then  do:
      662               delete obj-list.
      663            end.
      664            else do:
      665               find first  o-clients where
      666                        o-clients.obj-code = obj-list.obj-code and
      667                        o-clients.obj-type = obj-list.obj-type  no-lock no-error .
      668               assign
      669                  obj-list.obj-name = if avail o-clients then  o-clients.obj-name else ""
      670                  l#obj-code = obj-list.obj-code
      671                  l#obj-type = obj-list.obj-type
      672               .
      673            end.
      674         end.
      675      end method.
      676      method public character  get-s-notes():
      677         define variable v-i as integer   no-undo .
      678         define variable s-notes as character no-undo.
      679         for each gds-list-hist :
      680            v-i = v-i + 1 .
      681            s-notes = s-notes + chr(10) + gds-list-hist.hist-mode +  gds-list-hist.des .
      682            if v-i > 10 then do:
      683               s-notes = s-notes + " ... " .
      684               leave.
      685            end.
      686         end.
      687      end method.
      688      method public void make-6-gds-list () :
      689         define buffer buf-goods for ub.goods.
      690         if X-SelectGood = 7 then do:
      691            for each gds-list  :
      692               delete gds-list.
      693            end.
      694            for each g#cli no-lock :
      695               for each tmp#grp no-lock :
      696                  for each buf-goods where
      697                     buf-goods.prod-type = g#cli.obj-type and
      698                     buf-goods.prod-code = g#cli.obj-code and
      699                     ( trim(buf-goods.grp-name)  begins trim(tmp#grp.grp-name) )
      700                  no-lock :
      701                     if not can-find(first gds-list where gds-list.gds-code= buf-goods.gds-code)
      702                     then  do:
      703                        create gds-list.
      704                        buffer-copy buf-goods to gds-list  no-error  .
      705                     end.
      706                  end.
      707               end.
      708            end.
      709         end.
      710      end method.
      711      constructor public sParamObj (  ):
      712         super ().
      713      end constructor.
      714      destructor public sParamObj ( ):
      715      end destructor.
      716   end class.
