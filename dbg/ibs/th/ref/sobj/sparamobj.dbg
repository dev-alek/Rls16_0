      350   method public character  create_g#cli (cli-grp_recids as char):
      351   define buffer cli-prod for  ub.clients .
      352      for each g#cli :
      353          delete g#cli .
      354      end .
      355      define variable v-ind as integer   no-undo .
      356      do v-ind = 1 to num-entries( cli-grp_recids )
      357       :
      358           find cli-prod where recid( cli-prod ) = int( entry(v-ind, cli-grp_recids ) ) no-lock.
      359           create g#cli.
      360           assign
      361           g#cli.obj-type = cli-prod.obj-type
      362           g#cli.obj-code = cli-prod.obj-code
      363           g#cli.obj-name = cli-prod.obj-name.
      364       end.
      365   end.
      366      method public character  Get_text_g#cli (output ocount as integer ):
      367         define variable oText as character no-undo.
      368      ocount = 0.
      369      for each g#cli no-lock:
      370         if length(oText) <= 6000 then oText = oText + chr(10) + "     " + g#cli.obj-name .
      371         ocount =  ocount + 1 .
      372      end.
      373      return oText.
      374   end.
