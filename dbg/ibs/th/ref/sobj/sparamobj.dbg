      200   method public character grplib-get-full-name (p-node-code as integer):
      201      define variable p-full-name as character no-undo.
      202      do:
      203       define variable v-upper-code    as integer           no-undo.
      204       define buffer buf_gds-grp       for ub.gds-grp.
      205       define buffer buf_upper_gds-grp for ub.gds-grp.
      206       find first buf_gds-grp no-lock
      207            where buf_gds-grp.node-code = p-node-code
      208       no-error.
      209       if not available buf_gds-grp
      210       then do:
      211           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      212       end.
      213       assign
      214           p-full-name  = ""
      215           v-upper-code = 1
      216       .
      217       do while buf_gds-grp.upper-code <> 0
      218       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      219       :
      220           assign
      221               p-full-name  = buf_gds-grp.node-name
      222                            + (if p-full-name <> "" then chr(47) else "")
      223                            + p-full-name
      224               v-upper-code = buf_gds-grp.upper-code
      225           .
      226           find first buf_gds-grp no-lock
      227                where buf_gds-grp.node-code = v-upper-code
      228           no-error.
      229           if not available buf_gds-grp
      230           then do:
      231               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      232                                   + string( v-upper-code )
      233                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      234           end.
      235       end.
      236       assign
      237       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      238       .
      239   end.
      240   return p-full-name.
      241   end .
      242   method public integer grplib-get-node-from-full-name (p-full-name as char):
      243      define variable p-node-code as integer  no-undo.
      244   define variable v-ii as integer no-undo .
      245   define variable v-upper-code as integer no-undo .
      246   define variable v-root-code as integer no-undo .
      247   define variable v-entry as character no-undo .
      248   define buffer buf_gds-grp       for ub.gds-grp.
      249   do
      250   on error undo, return error
      251   :
      252     find first buf_gds-grp no-lock
      253         where buf_gds-grp.upper-code = 0
      254     no-error .
      255     if not available buf_gds-grp
      256     then do:
      257         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      258     end.
      259     else do:
      260       assign
      261       v-root-code = buf_gds-grp.node-code
      262       .
      263     end.
      264     v-upper-code = v-root-code.
      265     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      266       assign
      267       v-entry = entry(v-ii, p-full-name, chr(47)).
      268       if v-entry = '' then leave.
      269       find first buf_gds-grp no-lock where
      270                 buf_gds-grp.node-name = v-entry
      271             and buf_gds-grp.upper-code = v-upper-code
      272             no-error.
      273       if not available buf_gds-grp then do:
      274         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      275       end.
      276       else do:
      277         p-node-code = buf_gds-grp.node-code.
      278         v-upper-code = buf_gds-grp.node-code.
      279       end.
      280     end.
      281   end.
      282   return p-node-code.
      283   end .
      284   define
      285   temp-table tmp#grp no-undo
      286       field node-code like ub.gds-grp.node-code
      287       field grp-name like ub.gds-grp.node-name
      288       field lvl-num  like ub.gds-grp.lvl-num
      289       field is-term  like ub.gds-grp.is-term
      290       index pi is unique primary grp-name node-code
      291       index i-node-code    node-code
      292       index level-num   lvl-num  grp-name
      293       index is-term is-term  grp-name
      294       .
      295   method public void empty-tmp#grp ():
      296      for each tmp#grp :
      297         delete tmp#grp.
      298      end.
      299   end.
      300   method public void get-glob-tmp#grp ():
      301   end.
      302   method public void set-glob-tmp#grp ():
      303   end.
      304   method public void get-tmp#grp (output table tmp#grp bind):
      305   end.
      306   method public void set-tmp#grp (input table tmp#grp bind):
      307   end.
      308   method public character  create_tmp#grp (gdsgrp_recids as char):
      309      define variable t-str as character no-undo.
      310   define variable Grp_Name as character no-undo.
      311   define buffer buf_gds-grp for gds-grp.
      312      for each  tmp#grp :
      313        delete tmp#grp.
      314      end.
      315      define variable v-ind as integer   no-undo .
      316      repeat v-ind = 1 to num-entries( gdsgrp_recids ):
      317         find first buf_gds-grp where recid ( buf_gds-grp ) = integer ( entry(v-ind,gdsgrp_recids )) no-lock.
      318             Grp_Name = grplib-get-full-name (  buf_gds-grp.node-code  ).
      319         if Grp_Name <> ? then  if length(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + Grp_Name .
      320         create tmp#grp.
      321         assign tmp#grp.node-code = buf_gds-grp.node-code
      322                tmp#grp.grp-name = Grp_Name
      323                tmp#grp.is-term = buf_gds-grp.is-term
      324                tmp#grp.lvl-num = buf_gds-grp.lvl-num
      325         .
      326      end.
      327      return t-str.
      328   end.
