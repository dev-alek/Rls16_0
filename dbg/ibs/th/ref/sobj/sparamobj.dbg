      177   method public character  get-gds-list-one ():
      178      define variable vcount as integer no-undo.
      179      define buffer Buf_gds-list for gds-list.
      180      find first gds-list no-error.
      181      for each Buf_gds-list where recid(Buf_gds-list) ne recid(gds-list) :
      182         delete Buf_gds-list.
      183      end.
      184      return if available gds-list then gds-list.gds-name else ? .
      185   end.
      186   method public character  create-gds-list (iri-list as character ):
      187      define buffer buf_goods for goods.
      188      for each gds-list :
      189         delete gds-list.
      190      end.
      191      if iri-list <> ""
      192      then do:
      193         find first buf_goods where recid(buf_goods) = integer (iri-list) no-lock.
      194         buffer-copy buf_goods to gds-list no-error.
      195      end.
      196   end.
      197      define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   define variable vss-include-info6 as character format "X(65)" no-undo
