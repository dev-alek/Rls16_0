      142   method public character  get-gds-list-note ():
      143      define variable o-notes as character no-undo.
      144      define variable v-i as integer no-undo.
      145      for each gds-list-hist :
      146         v-i = v-i + 1 .
      147         o-notes = o-notes + chr(10) + gds-list-hist.hist-mode +  gds-list-hist.des .
      148         if v-i > 10
      149         then do:
      150            o-notes = o-notes + " ... " .
      151            leave.
      152         end.
      153      end.
      154   end.
