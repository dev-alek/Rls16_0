        3   class ibs.th.ref.sobj.sParamObj:
        4   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        5   def
        6   temp-table  obj-list no-undo
        7     field obj-type like ub.clients.obj-type
        8     field obj-code like ub.clients.obj-code
        9     field obj-name like ub.clients.obj-name
       10     field obj-id   as integer
       11     field db-num   as integer
       12     index pi is primary unique obj-id
       13     index ie1 obj-type obj-code
       14     index ie2 obj-name
       15   .
       16   method public void empty-obj-list ():
       17      for each obj-list :
       18         delete obj-list.
       19      end.
       20   end.
       21   method public logical can-find-obj-list ():
       22      return can-find (first obj-list no-lock).
       23   end.
       24   method public void get-obj-list (output table obj-list bind):
       25   end.
       26   method public void set-obj-list (input table obj-list bind):
       27   end.
       28   method public void create_obj-list (p-obj-type as char, p-obj-code as integer ):
       29      do
       30      on error undo, return error return-value
       31      :
       32         define buffer cli-obj for ub.clients .
       33         define variable p-var as integer no-undo .
       34         define buffer buf_obj-list for obj-list .
       35         find last buf_obj-list  use-index pi no-error .
       36         if available buf_obj-list
       37         then
       38            p-var = buf_obj-list.obj-id + 1.
       39         else
       40            p-var = 1.
       41         find first cli-obj where
       42                   cli-obj.obj-type = p-obj-type
       43               and cli-obj.obj-code = p-obj-code
       44         no-lock no-error.
       45         if available cli-obj
       46         then do:
       47            create buf_obj-list.
       48            assign
       49               buf_obj-list.obj-id   = p-var
       50               buf_obj-list.obj-code = cli-obj.obj-code
       51               buf_obj-list.obj-type = cli-obj.obj-type
       52               buf_obj-list.obj-name = cli-obj.obj-name
       53               buf_obj-list.db-num   = cli-obj.db-num
       54            .
       55         end.
       56      end.
       57   end.
