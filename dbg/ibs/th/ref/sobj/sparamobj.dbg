      394   method public void create_g#customer  (p-obj-type as char, p-obj-code as integer,p-obj-Name as character  ):
      395      do
      396      on error undo, return error return-value
      397      :
      398         define buffer cli-obj for ub.clients .
      399         define variable p-var as integer no-undo .
      400         define buffer buf_g#customer for g#customer .
      401         find first buf_g#customer  where buf_g#customer.obj-type eq p-obj-type
      402                                      and buf_g#customer.obj-code eq p-obj-code
      403         no-error.
      404         if not available buf_g#customer
      405         then do:
      406            find first cli-obj where
      407                       cli-obj.obj-type = p-obj-type
      408                   and cli-obj.obj-code = p-obj-code
      409            no-lock no-error.
      410            if available cli-obj
      411            then do:
      412               create buf_g#customer.
      413               assign
      414                  buf_g#customer.obj-code = cli-obj.obj-code
      415                  buf_g#customer.obj-type = cli-obj.obj-type
      416                  buf_g#customer.obj-name = cli-obj.obj-name
      417               .
      418            end.
      419         end.
      420      end.
      421   end.
