      909         mParamObj:ReportName = if mUserframe:namereport ne "" then mUserframe:namereport else  namereport
      910         mParamObj:ReportProc = if mUserframe:procname   ne "" then mUserframe:procname   else  procname
      911      .
      912      mDReport:Text  = trim(namereport).
      913      if mParamForm:params-only then do:
      914         if mParamObj:params-only-mode  = 'ПРОСМОТР':U then do:
      915            mDReport:Text  = substitute("Просмотр ПАРАМЕТРОВ отчета:  &1" ,  trim( mParamObj:ReportName ) ) .
      916         end.
      917         else do:
      918            mDReport:Text  = substitute("Задание ПАРАМЕТРОВ отчета:  &1" ,  trim( mParamObj:ReportName ) ) .
      919         end.
      920      end.
