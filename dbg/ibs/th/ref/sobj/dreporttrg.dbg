       22   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23   method private logical cur-time (output p-today as date,
       24                                    output p-time  as integer ):
       25     do
       26     on error undo, return error
       27     :
       28       define variable v-date1 as date      no-undo .
       29       define variable v-date2 as date      no-undo .
       30       define variable v-time  as integer   no-undo .
       31       assign
       32         v-date1 = today
       33         v-time  = time
       34         v-date2 = today
       35       .
       36       if v-date1 <> v-date2
       37       then do:
       38         assign
       39           v-date1 = today
       40           v-time  = v-time
       41         .
       42       end.
       43       assign
       44         p-today = v-date1
       45         p-time  = v-time
       46       .
       47     end.
       48   end.
       49   method private character  cur-time-date ()
       50   :
       51     return string(today, '99/99/9999':U) .
       52   end.
       53   method private decimal cur-time-mjd ()
       54   :
       55     define variable v-date as date      no-undo .
       56     define variable v-time as integer   no-undo .
       57     cur-time
       58       (output v-date
       59       ,output v-time
       60       ) .
       61     return integer(v-date) - 2400002 + (v-time / 86400) .
       62   end.
       63   method private integer cur-time-get-ending-index
       64   (input p-number as integer
       65   )
       66   :
       67     if p-number < 0
       68     or p-number = ?
       69     then do:
       70       return 1 .
       71     end.
       72     define variable v-rest as integer   no-undo .
       73     assign
       74       p-number = p-number modulo 100
       75     .
       76     if p-number < 20
       77     then do:
       78       assign
       79         v-rest = p-number
       80       .
       81     end.
       82     else do:
       83       assign
       84         v-rest = p-number modulo 10
       85       .
       86     end.
       87     case v-rest :
       88       when 1
       89       then do:
       90         return 2 .
       91       end.
       92       when 2 or
       93       when 3 or
       94       when 4
       95       then do:
       96         return 3 .
       97       end.
       98       otherwise do:
       99         return 1 .
      100       end.
      101     end case .
      102   end.
      103   method private character cur-time-mjd-to-date(
      104     input  i-mjd-diff as decimal
      105   ,output  o-Date     as date
      106   ,output  o-Time     as integer):
      107      define variable v-day-number as integer   no-undo .
      108      if    i-mjd-diff < 0
      109         or i-mjd-diff = ?
      110      then do:
      111         return "?" .
      112      end.
      113      assign
      114         v-day-number = truncate(i-mjd-diff,0).
      115         o-Date = date(v-day-number + 2400002).
      116         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      117     .
      118   end.
      119   method private character cur-time-mjd-to-string
      120   (input p-mjd-diff as decimal
      121   )
      122   :
      123     define variable v-day-number as integer   no-undo .
      124     define variable v-seconds    as integer   no-undo .
      125     define variable v-hour       as integer   no-undo .
      126     define variable v-min        as integer   no-undo .
      127     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      128     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      129     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      130     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      131     if p-mjd-diff < 0
      132     or p-mjd-diff = ?
      133     then do:
      134       return "?" .
      135     end.
      136     assign
      137       v-day-number = integer(truncate(p-mjd-diff,0))
      138       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      139     .
      140     if v-seconds > 86400
      141     then do:
      142       assign
      143         v-seconds = 86400 - 1
      144       .
      145     end.
      146     if v-seconds < 0
      147     then do:
      148       assign
      149         v-seconds = 0
      150       .
      151     end.
      152     assign
      153       v-hour = truncate(v-seconds / 3600, 0)
      154     .
      155     assign
      156       v-seconds = v-seconds modulo 3600
      157     .
      158     assign
      159       v-min = truncate(v-seconds / 60, 0)
      160     .
      161     assign
      162       v-seconds = v-seconds modulo 60
      163     .
      164     return
      165         (if v-day-number <> 0
      166           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      167           else ""
      168         )
      169       + (if v-day-number <> 0 or v-hour <> 0
      170           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      171           else ""
      172         )
      173       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      174           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      175           else ""
      176         )
      177       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      178       .
      179   end.
      180   method private character cur-time-string ()
      181   :
      182     define variable v-date as date      no-undo .
      183     define variable v-time as integer   no-undo .
      184     cur-time
      185       (output v-date
      186       ,output v-time
      187       ) .
      188     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      189   end.
      190   method private character cur-time-string-sec ()
      191   :
      192     define variable v-date as date      no-undo .
      193     define variable v-time as integer   no-undo .
      194     cur-time
      195       (output v-date
      196       ,output v-time
      197       ) .
      198     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      199   end.
      200   method private character cur-time-custom
      201   (input p-prefix as character
      202   ,input p-date-format as character
      203   ,input p-delimiter as character
      204   ,input p-time-format as character
      205   ,input p-suffix as character
      206   )
      207   :
      208     define variable v-date as date      no-undo .
      209     define variable v-time as integer   no-undo .
      210     cur-time
      211       (output v-date
      212       ,output v-time
      213       ) .
      214     return
      215       p-prefix
      216       + string(v-date, p-date-format)
      217       + p-delimiter
      218       + string(v-time, p-time-format)
      219       + p-suffix
      220       .
      221   end.
      222   method private character cur-time-print ()
      223   :
      224     define variable v-date as date      no-undo .
      225     define variable v-time as integer   no-undo .
      226     cur-time
      227       (output v-date
      228       ,output v-time
      229       ) .
      230     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      231   end.
      232   method private datetime cur-time-datetime ()
      233   :
      234     define variable v-char as character no-undo .
      235     define variable v-datetime as datetime no-undo .
      236     v-char = cur-time-string().
      237     v-datetime = datetime(v-char).
      238     return  v-datetime.
      239   end.
      240   method private character cur-time-string-msec ()
      241   :
      242     define variable v-date as datetime  no-undo .
      243     v-date = now.
      244     return string(v-date) .
      245   end.
