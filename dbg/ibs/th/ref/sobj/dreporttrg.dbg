      783      method public void FormRun (iClass as character) :
      784         mDReport = new ibs.th.ref.sobj.dreport (input iClass, input this-object).
      785         local-initialize ().
      786         wait-for System.Windows.Forms.Application:Run ( mDReport ) .
      787         define variable v-err-msg as character no-undo .
      788         catch exAppErrors as class Progress.Lang.AppError :
      789            v-err-msg = exAppErrors:ReturnValue .
      790            if v-err-msg > "" then . else do :
      791               v-err-msg = exAppErrors:GetMessage(1) .
      792               if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\sobj\dreporttrg.cls" .
      793            end .
      794            message "AppError" skip(1) v-err-msg skip exAppErrors:CallStack view-as alert-box.
      795         end catch .
      796         catch exProErrors as class Progress.Lang.ProError :
      797            v-err-msg = exProErrors:GetMessage(1) .
      798            if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\sobj\dreporttrg.cls" .
      799            message "ProError" skip(1) v-err-msg skip exProErrors:CallStack view-as alert-box.
      800         end catch .
      801         catch exAnyErrors as class Progress.Lang.Error:
      802            v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\ref\sobj\dreporttrg.cls " + exAnyErrors:GetMessage(1).
      803            message "LangError" skip(1) v-err-msg skip exAnyErrors:CallStack view-as alert-box.
      804         end catch .
      805         finally:
      806            if valid-object(mDReport) then delete object mDReport no-error .
      807         end finally.
      808      end method .
