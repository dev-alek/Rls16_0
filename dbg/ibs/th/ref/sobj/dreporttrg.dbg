     1413      method private void new-state(istate as character ):
     1414      end.
     1415      method public void setparam(
     1416            iparParentProc  as handle,
     1417            iprocname       as character ,
     1418            inamereport     as character ,
     1419            iparam-date     as integer   ,
     1420            iparam-goods    as character ,
     1421            iparam-obj      as character ,
     1422            iparam-pay      as character ,
     1423            iparam-pay-hide as character ,
     1424            iparam-universal as character ,
     1425            iparam-alon     as logical    ):
     1426         assign
     1427            parParentProc     = iparParentProc
     1428            procname          = iprocname
     1429            namereport        = inamereport
     1430            param-date        = iparam-date
     1431            param-goods       = iparam-goods
     1432            param-obj         = iparam-obj
     1433            param-pay         = iparam-pay
     1434            param-pay-hide    = iparam-pay-hide
     1435            param-universal   = iparam-universal
     1436            param-alon        = iparam-alon
     1437         .
     1438      end.
     1439   end class.
