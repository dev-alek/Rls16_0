      737   method private void  initilize-page-3 ():
      738      define variable temp-str- as character no-undo .
      739      define variable temp-i as integer no-undo .
      740      define variable  l-ind as integer no-undo .
      741      define variable v-nn as integer no-undo.
      742      define variable v-nn2 as integer no-undo.
      743      find first ubflt.usr-flt no-lock where
      744            ubflt.usr-flt.user-name  = mParamObj:my-cntxt-userid and
      745            ubflt.usr-flt.call-point = mParamObj:ReportProc  no-error .
      746      if available ubflt.usr-flt
      747      then  do:
      748         v-nn = num-entries( ubflt.usr-flt.list_) .
      749         repeat l-ind = 1 to v-nn :
      750            if entry(1,entry(l-ind, ubflt.usr-flt.list_),"=")  = "ReportPageHeight":U
      751            then do:
      752               mParamObj:ReportPageHeight = integer(entry(2,entry(l-ind, ubflt.usr-flt.list_),"=")) no-error .
      753               if error-status :error  then message "qq1" .
      754            end.
      755            if entry(1,entry(l-ind,ubflt.usr-flt.list_),"=")  = "ReportPageWidth":U
      756            then do:
      757               mParamObj:ReportPageWidth = integer(entry(2,entry(l-ind, ubflt.usr-flt.list_),"=")) no-error .
      758               if error-status :error  then message "qq2" .
      759            end.
      760            if entry(1,entry(l-ind, ubflt.usr-flt.list_ ),"=")  = "Use-Column":U
      761            then do :
      762               temp-str- = entry( 2 , entry(l-ind, ubflt.usr-flt.list_)  ,"=" ) no-error .
      763               if error-status :error  then message "qq3" .
      764               v-nn2 = num-entries ( temp-str- , ";") .
      765               repeat temp-i = 1 to v-nn2:
      766                  if temp-i <= 50
      767                  then
      768                     mParamObj:use-column[temp-i] = ( if trim(entry(temp-i,temp-str-,";")) = "true" then true else false) .
      769               end.
      770            end.
      771         end.
      772      end.
      773      else
      774         assign
      775            mParamObj:ReportPageHeight = 0
      776            mParamObj:ReportPageWidth  = 0
      777         .
      778       mDReport:mlistf:op-br() no-error.
      779   end method.
