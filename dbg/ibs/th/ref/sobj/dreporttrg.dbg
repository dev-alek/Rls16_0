      843      method public void bOk    ():
      844         if mparamform:params-only
      845         then do:
      846            proc-save-param-RUM() no-error.
      847            if error-status :error
      848            then do:
      849               return .
      850            end.
      851         end.
      852         else do:
      853            run trg/userlog.p (
      854                input "report":U
      855              , input namereport + chr(3) + procname
      856              , input ?
      857              , input ?
      858              , input ""
      859             ) no-error.
      860             if error-status :error
      861             then do:
      862                 message return-value + error-status:get-message(1) view-as alert-box title "Ошибка записи истории действий пользователя".
      863             end.
      864            print-report() no-error .
      865            if error-status :error
      866            then do:
      867               return .
      868            end.
      869            return no-apply .
      870         end.
      871      end method.
