      461   method private void local-pre-initialize ():
      462     define variable v-today as date      no-undo .
      463     define variable v-time  as integer   no-undo .
      464     define variable v-ok    as logical   no-undo .
      465      cur-time  (output v-today
      466                ,output v-time
      467                ).
      468      if mParamForm:init-date-start = date("") or mParamForm:init-date-start = ? then mParamForm:init-date-start  = v-today .
      469      if mParamForm:init-date-end = date("") or mParamForm:init-date-end = ? then  mParamForm:init-date-end    = v-today .
      470      if mParamForm:init-date-alone = date("") or mParamForm:init-date-alone = ? then  mParamForm:init-date-alone  = v-today.
      471      if mParamForm:init-shift-alone = ? then mParamForm:init-shift-alone = 0 .
      472      if mParamForm:init-shift-start = ? then mParamForm:init-shift-start = 0 .
      473      if mParamForm:init-shift-end   = ? then mParamForm:init-shift-end   = 0 .
      474   end.
      475   method public void SetVar
      476   (
      477   ):
      478      define variable customer-yes as logical init false no-undo .
      479      define variable customer-name as character init "" no-undo .
      480      define variable customer-type as character init "" no-undo .
      481      define variable schet-yes  as logical init false no-undo .
      482      define variable schet-name as character init "" no-undo .
      483      define variable schet-hide as character init "" no-undo .
      484      define variable schet-init as character init "" no-undo .
      485      define variable ed_date-ref as character no-undo .
      486      define variable Jv as integer no-undo.
      487      define variable v-ii as integer no-undo .
      488      define variable plase-cost as integer no-undo .
      489      define variable plase-crsa as integer no-undo .
      490      define variable plase-sale as integer no-undo .
      491      define variable radio-period as character   no-undo .
      492      define variable v-nn3 as integer no-undo.
      493      param-universal = param-universal + ",".
      494      temp-param-obj-type  = "".
      495      all-object = false .
      496      mParamObj:parParentProc = parParentProc.
      497      assign temp-param-schet-mode = 'фирма':U .
      498      v-nn3 = num-entries(param-universal).
      499      repeat Jv = 1 to v-nn3:
      500         case entry(Jv,param-universal ) :
      501           when  "all":U or
      502           when  "shop":U or
      503           when  "stok":U then temp-param-obj-type    =  entry(Jv,param-universal ).
      504           when   string(1)             then mParamObj:Make-Excel       = true.
      505           when   string(9)         then mParamObj:Make-Excel-com   = true.
      506           when   string(12)           then mParamForm:Verify-Arc-aht   = true.
      507           when   string(2)            then mParamForm:Verify-Arc-ot    = true.
      508           when   string(3)           then mParamForm:Verify-Arc-stk   = true.
      509           when   string(8)          then mParamForm:Verify-Arc-supp  = true.
      510           when   string(11)          then mParamForm:Verify-Arc-hold  = true.
      511           when   string(24)        then mParamForm:Verify-Arc-strong  = true.
      512           when   string(4)            then mParamForm:Verify-send-check = true.
