      932     ,output v-value-integer
      933     ,output v-value-logical
      934     ,output par-type
      935     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      936     ) no-error .
      937      for each thbjattr_thbj-attr :
      938         if thbjattr_thbj-attr.prop-code = 'actuate'  then p-actuate   = thbjattr_thbj-attr.property-value-logical .
      939      end.
      940      if p-actuate
      941      then do:
      942         if param-Alon = false
      943         then do:
      944             make-btn    ().
      945         end.
      946      end.
      947      if mParamForm:params-only  then do:
      948         mUserframe:my-params ( input "get" ) no-error .
      949         local-apply-layout ().
      950     end.
      951   end .
      952   method private void make-btn ():
      953    do
      954    on error undo, return error return-value
      955    :
      956      mDReport:b_ach:Visible = mUserframe:report-to-ach (yes).
      957     end.
      958   end .
      959   METHOD public void my_select():
      960   AssignParam ().
      961   Assign-frame().
      962   end.
      963   method private void AssignParam ():
      964      define variable vtext as character no-undo.
      965      vtext = mShift:AssignParam() no-error.
      966      if error-status :error
      967      then do:
      968         undo, return error vtext .
      969      end.
      970      vtext = mObj:AssignParam() no-error.
      971      if error-status :error
      972      then do:
      973         undo, return error vtext .
      974      end.
      975      vtext = mGoods:AssignParam() no-error.
      976      if error-status :error
      977      then do:
      978         undo, return error vtext .
      979      end.
      980      mparamObj:make-6-gds-list().
      981   end.
      982   define temp-table param-to-export no-undo
      983   field param-code     as character
      984   field param-sub-code as character
      985   field param-type     as character
      986   field param-value    as character
      987   field param-comment  as character
      988   index pi is unique primary  param-code     param-sub-code
      989   .
      990   method public void make-ach ():
      991      do
      992      on error undo, return error return-value
      993      :
      994         mUserframe:my-var().
      995         AssignParam().
      996         mUserframe:report-to-ach (no ) .
      997         mParamObj:get-param-to-export(output table param-to-export ).
      998         if error-status :error = true then return error .
      999         define variable exp-name as character no-undo .
     1000         run gbl/_tmpfile.p ( "t", ".par", output exp-name) .
     1001         output STREAM str-export TO  VALUE(exp-name).
     1002         for each param-to-export :
     1003            export stream str-export param-to-export .
     1004         end.
     1005         output STREAM str-export CLOSE.
     1006         define variable res as integer no-undo .
     1007         define variable name-exe as character no-undo .
     1008         assign
     1009            file-info:file-name = "exe/run-act.bat".
     1010            name-exe = file-info:full-pathname
     1011         no-error .
     1012         if error-status :error then return error .
     1013         run gbl/syn.p ( input name-exe , input  exp-name , input  "Запуск " + name-exe , output res ).
     1014         if  res > 0
     1015         then do:
     1016            message  "Ошибка  при выполнении команды в ОС "  res .
     1017         end.
     1018      end.
     1019   end method.
     1020   method private void  return-var () :
     1021     mListF:Save-table() no-error.
     1022     mFormat:get-var() no-error.
     1023     mUserframe:my-var() no-error.
     1024   end method.
     1025   method private void select-page(inum as integer ):
     1026   end.
     1027   method private void proc-save-param-RUM () :
     1028     AssignParam().
     1029     Assign-frame().
     1030      if param-alon = false
     1031      then do:
     1032         initilize-page-3 () .
     1033         return-var () .
     1034         if   (   mParamObj:reportpageheight = 0
     1035               or mParamObj:reportpagewidth = 0
     1036               )
     1037            and mParamForm:format-folder
     1038         then do:
     1039            select-page(3) .
     1040            undo, return error return-value .
     1041         end.
     1042      end.
     1043      mUserframe:my-var () no-error.
     1044      if error-status:error then
     1045      do:
     1046         case return-value:
     1047            when 'First-page':U then  do:
     1048               return error.
     1049            end.
     1050            when 'Second-page':U then  do:
     1051               message "Проверьте правильность заполнения формы!".
     1052               select-page ( 2 ).
     1053               return  error .
     1054            end.
     1055            when 'format-page' then do:
     1056               message "Необходимо сходить на закладку <Формат...> !".
     1057               select-page ( 3 ).
     1058               return error.
     1059            end.
     1060            otherwise  do:
     1061               message "Необходимо сходить на закладку <Продолжение...> !".
     1062               select-page ( 2 ).
     1063               return error.
     1064            end.
     1065         end case.
     1066      end.
     1067      mUserframe:my-params ( input "set" ) no-error .
     1068      if error-status:error then
     1069      do:
     1070         case return-value:
     1071            when 'First-page':U then  do:
     1072               return error.
     1073            end.
     1074            when 'Second-page':U then  do:
     1075               message "Проверьте правильность заполнения формы!".
     1076               select-page ( 2 ).
     1077               return  error .
     1078            end.
     1079            when 'format-page' then do:
     1080               message "Необходимо сходить на закладку <Формат...> !".
     1081               select-page ( 3 ).
     1082               return error.
     1083            end.
     1084            otherwise  do:
     1085               message "Необходимо сходить на закладку <Продолжение...> !".
     1086               select-page ( 2 ).
     1087               return error.
     1088            end.
     1089         end case.
     1090      end.
     1091   end method.
     1092   method private void print-report ():
     1093      define variable choice             as logical   no-undo .
     1094      define variable v-total-archive-ok as logical   no-undo .
     1095      define variable v-archive-ok       as logical init true  no-undo .
     1096      define variable v-comment          as character no-undo .
     1097      define variable v-can-print        as logical   no-undo .
     1098      define variable temp-date      as date no-undo.
     1099      define variable temp-shift     as integer no-undo .
     1100      define variable v-date-start as date      no-undo .
     1101      define variable v-date-end   as date      no-undo .
     1102      define variable spis-obj     as character no-undo .
     1103      AssignParam()  .
     1104      Assign-frame().
     1105      v-total-archive-ok = true.
     1106      if mParamForm:verify-arc-fin = true
     1107      then do:
     1108         define variable p-status       as integer   no-undo .
     1109         define variable p-cut-date     as date      no-undo .
     1110         define variable p-cut-fin-date as date      no-undo .
     1111   run cutd-db in ibs.th.gbl.gbl-hndllib:g#library
     1112     (input  mParamObj:my-cntxt-db-num
     1113     ,output p-status
     1114     ,output p-cut-date
     1115     ,output p-cut-fin-date
     1116     ) no-error .
     1117         if param-date = 1
     1118         then do:
     1119            assign
     1120               v-date-start = mParamObj:x-date-alone
     1121               v-date-end   = mParamObj:x-date-alone
     1122           .
     1123         end.
     1124         else do:
     1125           assign
     1126             v-date-start = mParamObj:x-date-start
     1127             v-date-end   = mParamObj:x-date-end
     1128           .
     1129         end.
     1130         if p-cut-date <> ? and ( v-date-start < p-cut-date  or v-date-end < p-cut-date)
     1131         then do:
     1132            message
     1133               "ВНИМАНИЕ!" skip
     1134               "БД была обрезана на " string(p-cut-fin-date, "99/99/9999")  skip
     1135               "Данные в отчете будут не корректны." skip
     1136               "Продолжить формирование отчета?" skip
     1137            view-as alert-box question
     1138               buttons yes-no
     1139               title "Финансовые архивы"
     1140               update choice .
     1141            if choice = false
     1142            then do:
     1143               assign
     1144                  v-total-archive-ok = false
     1145               .
     1146               undo, return error return-value .
     1147            end.
     1148            else do:
     1149               if param-date = 1
     1150               then do:
     1151                  v-date-end = p-cut-fin-date .
     1152               end .
     1153               else do:
     1154                  v-date-start = p-cut-fin-date .
     1155                  v-date-end   = p-cut-fin-date .
     1156               end.
     1157               v-total-archive-ok = true .
     1158            end.
     1159         end.
     1160      end.
     1161      if mParamForm:verify-arc-hold = true
     1162      then do:
     1163         if param-date = 1
     1164         then do:
     1165            assign
     1166               temp-date = mParamObj:x-date-alone
     1167            .
     1168         end.
     1169         else do:
     1170            TEMP-DATE = mParamObj:x-Date-End .
     1171         end.
     1172         run trg/bt_hold.p
     1173            (input  temp-date
     1174            ,input  true
     1175            ,input  mParamObj:my-cntxt-db-num
     1176            ,input  mParamObj:my-cntxt-userid
     1177            ) no-error .
     1178         if error-status :error
     1179         then do:
     1180            message
     1181               "ВНИМАНИЕ!" skip
     1182               "Межфирменные архивы" skip
     1183               return-value skip
     1184               "Данные по выбранному периоду могут быть неполными или некорректными."
     1185               "Продолжить формирование отчета?" skip
     1186            view-as alert-box question buttons yes-no update choice .
     1187            if choice = false
     1188            then do:
     1189               v-total-archive-ok = false.
     1190            end.
     1191            else do:
     1192               v-total-archive-ok = true.
     1193            end.
     1194         end.
     1195      end.
     1196      if    mParamForm:verify-arc-ot   = true
     1197         or mParamForm:verify-arc-stk  = true
     1198         or mParamForm:verify-arc-aht  = true
     1199         or mParamForm:verify-arc-supp = true
     1200      then do:
     1201         if    mParamForm:verify-arc-ot = true
     1202           and mParamForm:verify-arc-stk <> true
     1203         then do:
     1204            mParamForm:verify-arc-stk = true.
     1205         end.
     1206         spis-obj = "" .
     1207         v-total-archive-ok  = true .
     1208         mParamObj:get-obj-list(output table  obj-list).
     1209         for each obj-list no-lock :
     1210            if param-date = 1
     1211            then do:
     1212               assign
     1213                  v-date-start = mParamObj:x-date-alone
     1214                  v-date-end   = mParamObj:x-date-alone
     1215               .
     1216            end.
     1217            else do:
     1218               assign
     1219                  v-date-start = mParamObj:x-date-start
     1220                  v-date-end   = mParamObj:x-date-end
     1221               .
     1222            end.
     1223            run rep/chk-ahz.p
     1224               (input        obj-list.obj-type
     1225               ,input        obj-list.obj-code
     1226               ,input        mParamForm:verify-arc-ot
     1227               ,input        mParamForm:verify-arc-stk
     1228               ,input        mParamForm:verify-arc-supp
     1229               ,input        mParamForm:verify-arc-aht
     1230               ,input        true
     1231               ,input        mParamObj:my-cntxt-db-num
     1232               ,input        mParamObj:my-cntxt-userid
     1233               ,input-output v-date-start
     1234               ,input-output v-date-end
     1235               ,output       v-archive-ok
     1236               ,output       v-comment
     1237               ,output       v-can-print
     1238            ) .
     1239            if v-archive-ok = false
     1240            then do:
     1241               if     v-can-print = false
     1242                  or  mParamForm:verify-arc-strong  = true
     1243               then do:
     1244                  message
     1245                     "ВНИМАНИЕ !!!" skip
     1246                     "Отчет не может быть сформирован!" skip
     1247                     "На запрошенную дату нет архивов или они сжаты" skip
     1248                     v-comment skip
     1249                  view-as alert-box information .
     1250                  select-page (1).
     1251                  undo, return error return-value .
     1252               end.
     1253               else do:
     1254                  assign
     1255                     v-total-archive-ok = false
     1256                     spis-obj =  spis-obj + substitute("&1&2," , obj-list.obj-type , obj-list.obj-code)
     1257                  .
     1258               end.
     1259            end.
     1260         end.
     1261         spis-obj = trim(spis-obj, ',') .
     1262         if v-total-archive-ok = false
     1263         then do:
     1264            define variable v-period-description as character no-undo .
     1265            if param-date = 1
     1266            then do:
     1267               assign
     1268                  v-period-description = substitute("на конец дня &1"
     1269                                              ,string(mParamObj:x-date-end, '99/99/9999':u)
     1270                                              )
     1271               .
     1272            end.
     1273            else do:
     1274               assign
     1275                  v-period-description = substitute("с начала дня &1 по конец дня &2"
     1276                                              ,string(mParamObj:x-date-start, '99/99/9999':u)
     1277                                              ,string(mParamObj:x-date-end,   '99/99/9999':u)
     1278                                              )
     1279               .
     1280            end.
     1281            message
     1282               "ВНИМАНИЕ!" skip
     1283               v-comment skip
     1284               spis-obj skip
     1285               "" skip
     1286               "Данные по выбранному периоду" v-period-description "могут быть неполными или некорректными." skip
     1287               "Продолжить формирование отчета?" skip
     1288            view-as alert-box question buttons yes-no update choice .
     1289            if choice = false
     1290            then do:
     1291               v-archive-ok = false.
     1292               return.
     1293            end.
     1294            else do:
     1295               v-total-archive-ok = true.
     1296            end.
     1297         end.
     1298      end.
     1299      if v-total-archive-ok = true
     1300      then do:
     1301         if param-alon = false
     1302         then do:
     1303            initilize-page-3 ().
     1304            return-var () .
     1305            if    (mParamObj:reportpageheight = 0  or mParamObj:reportpagewidth = 0)
     1306               and mParamForm:format-folder
     1307            then do:
     1308               select-page (3) no-error .
     1309               undo, return error return-value .
     1310            end.
     1311         end.
     1312         mUserframe:my-var () no-error.
     1313         if error-status:error
     1314         then do:
     1315            case return-value:
     1316               when 'First-page':U
     1317               then  do:
     1318                  return .
     1319               end.
     1320               when 'Second-page':U then  do:
     1321                   message "Проверьте правильность заполнения формы!".
     1322                   select-page ( 2 ).
     1323                   return.
     1324               end.
     1325               when 'format-page' then do:
     1326                  message "Необходимо сходить на закладку <Формат...> !".
     1327                  select-page( 3 ).
     1328                  return no-apply.
     1329               end.
     1330               otherwise  do:
     1331                  message "Необходимо сходить на закладку <Продолжение...> !".
     1332                  select-page  ( 2 ).
     1333                  return no-apply.
     1334               end.
     1335            end case.
     1336         end.
     1337      end.
     1338      if v-archive-ok = false and
     1339           (  mParamForm:verify-arc-ot   = true
     1340           or mParamForm:verify-arc-stk  = true
     1341           or mParamForm:verify-arc-aht  = true
     1342           or mParamForm:verify-arc-supp = true )
     1343      then do:
     1344         assign
     1345            mParamObj:reportheader = mParamObj:reportheader + chr(10)
     1346                        + "Архивы рассчитаны не полностью. Информация в отчете может быть неполной или некорректной."
     1347                        + chr(10) +
     1348                        (if spis-obj <> "" then substitute("Не корректная информация об архивах на объектах: &1" ,spis-obj ) else "")
     1349         .
     1350      end.
     1351      mParamObj:d-report-handle = d-report-handle .
     1352      if param-Alon
     1353      then do:
     1354         openforexcel () .
     1355         if num-entries (trim(procname), " " ) > 1
     1356         then do:
     1357            define variable p-proc-par1 as character no-undo .
     1358            define variable p-proc-par2 as character no-undo .
     1359            assign
     1360               p-proc-par1 = entry(1, procname, " ")
     1361               p-proc-par2 = entry(2, procname, " ")
     1362            .
     1363            run value ( p-proc-par1 )
     1364               (input p-proc-par2,
     1365                input mparamObj ).
     1366         end.
     1367         else do:
     1368            run value ( procname ) (input mparamObj).
     1369         end.
     1370         CloseForExcel () .
     1371      end.
     1372      else do:
     1373         mUserframe:my-report () no-error .
     1374         if error-status:error
     1375         then do:
     1376            case return-value:
     1377               when 'First-page':U
     1378               then  do:
     1379                  return .
     1380               end.
     1381               when 'Second-page':U then  do:
     1382                   message "Проверьте правильность заполнения формы!".
     1383                   select-page ( 2 ).
     1384                   return.
     1385               end.
     1386               when 'format-page' then do:
     1387                  message "Необходимо сходить на закладку <Формат...> !".
     1388                  select-page( 3 ).
     1389                  return no-apply.
     1390               end.
     1391               otherwise  do:
     1392                  message "Необходимо сходить на закладку <Продолжение...> !".
     1393                  select-page  ( 2 ).
     1394                  return no-apply.
     1395               end.
     1396            end case.
     1397         end.
     1398         CloseForExcel().
     1399      end.
     1400      run prg-bar_delete-progress-bar in mParamObj:d-report-handle .
     1401      mParamObj:d-report-handle = ? .
     1402   end .
