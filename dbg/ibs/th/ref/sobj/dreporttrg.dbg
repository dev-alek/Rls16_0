      326   method public void OpenForExcel():
      327      define variable v-ch#ExcelApplication as com-handle no-undo .
      328      define variable v-ch#Workbook         as com-handle no-undo .
      329      define variable v-ch#Worksheet        as com-handle no-undo .
      330      os-delete value( string( session:temp-directory ) +
      331                                 "rpt" + string( mParamObj:my-g#report-num ) + ".txt":U ) .
      332      os-delete value( string( session:temp-directory ) +
      333                                 "rpt" + string( mParamObj:my-g#report-num ) + ".frm":U ) .
      334      os-delete value( string( session:temp-directory ) +
      335                                 "rpt" + string( mParamObj:my-g#report-num ) + ".txl":U ) .
      336      if mParamObj:Make-Excel
      337      then do:
      338         output stream ForExcel to value( string( session:temp-directory +
      339                                        "rpt" + string( mParamObj:my-g#report-num ) + ".txt":U ) ) .
      340         assign
      341            mParamObj:v-excel-file = string( session:temp-directory + "rpt" + string( mParamObj:my-g#report-num ) )
      342            mParamObj:number-list = 1
      343         .
      344         if mParamObj:make-excel-com
      345         then do:
      346   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   if valid-handle(mParamObj:ch#WorkSheet) then
      348   RELEASE OBJECT mParamObj:ch#WorkSheet no-error.
      349   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if valid-handle(mParamObj:ch#Workbook) then
      351   RELEASE OBJECT mParamObj:ch#Workbook no-error.
      352   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   if valid-handle(mParamObj:ch#ExcelApplication) then
      354   RELEASE OBJECT mParamObj:ch#ExcelApplication no-error.
      355            create "Excel.Application" mParamObj:ch#excelApplication connect no-error.
      356            if error-status:error
      357            then do :
      358           create "Excel.Application" mParamObj:ch#excelApplication no-error.
      359       if error-status :error then do:
      360           message
      361           "Ошибка при запуске Excel" skip
      362           error-status :get-message(1) skip
      363           view-as alert-box error .
      364           undo, return error .
      365       end.
      366            end.
      367            assign
      368               mParamObj:num#str#  = 0.
      369               v-ch#excelApplication  = mParamObj:ch#excelApplication.
      370               v-ch#excelApplication:Interactive = false.
      371               v-ch#excelApplication:ScreenUpdating = false.
      372               v-ch#excelApplication:Visible = false.
      373               mParamObj:ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      374               mParamObj:ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      375               v-ch#Worksheet = mParamObj:ch#WorkSheet.
      376               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      377               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      378               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      379               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      380            no-error .
      381            if error-status:error
      382            then do:
      383               mParamObj:Make-Excel-com = false .
      384               mParamObj:Make-Excel = false .
      385               output Stream  ForExcel close.
      386               os-delete value( string( session:temp-directory ) +
      387                              "rpt" + string( mParamObj:my-g#report-num ) + ".txt":U ) .
      388               os-delete value( string( session:temp-directory ) +
      389                              "rpt" + string( mParamObj:my-g#report-num ) + ".frm":U ) .
      390               return.
      391            end.
      392         end.
      393      end.
      394   end.
      395   method public void CloseForExcel():
      396      define variable ii as integer no-undo .
      397      define variable vsheet-num as integer no-undo.
      398      if mParamObj:Make-Excel
      399      then  do:
      400         output Stream  ForExcel close.
      401         os-delete value( string( session:temp-directory ) +
      402                                "rpt" + string( mParamObj:my-g#report-num ) + ".txt":U ) .
      403         os-delete value( string( session:temp-directory ) +
      404                                "rpt" + string( mParamObj:my-g#report-num ) + ".frm":U ) .
      405         vsheet-num = mParamObj:sheet-num.
      406         if vsheet-num > 1
      407         then do:
      408            do ii = 2 to vsheet-num:
      409               os-delete value( string( session:temp-directory ) +
      410                                     "rpt" + string( mParamObj:my-g#report-num ) + ".":U  + string(ii)) .
      411            end.
      412         end.
