        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.sobj.sGoods_trg:
        4      define variable vss-revision    as character no-undo initial "$Revision$":U .
        5      define variable vss-author      as character no-undo initial "$Author$":U .
        6      define variable vss-date        as character no-undo initial "$Date$":U .
        7      define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8      define variable vss-archive     as character no-undo initial "$Archive$":U .
        9      define variable vss-description as character no-undo init "Форма выбора товаров".
       10      define property ParamObj as class ibs.th.ref.sobj.sParamObj no-undo
       11      get.
       12      set.
       13      define property ParamForm as class ibs.th.ref.sobj.sParamForm no-undo
       14      get.
       15      set.
       16      define property stype as class ibs.th.ref.sobj.stype no-undo
       17      get.
       18      set.
       19      define variable keep-spis as character no-undo.
       20      method public void CHOOSE_BUTTON-gds ():
       21         if not Paramform:params-only then do:
       22            ParamObj:empty-gds-list().
       23         end.
       24         run str/gds-list.w ( input ParamObj:my-handle, input ParamObj:my-cntxt-host-code-obj, input ParamObj:my-cntxt-obj-type, input ParamObj:my-cntxt-obj-code ).
       25         ParamObj:get-glob-gds-list().
       26         ParamObj:get-glob-gds-list-hist().
       27      end.
       28      method public void  choose_BUTTON-node ():
       29        define variable vgdsgrp_recids as character no-undo.
       30        vgdsgrp_recids = ParamForm:gdsgrp_recids.
       31         run ref/gds-grp.w
       32         (             input ParamObj:my-handle
       33                      ,input "b-sel,b-mark"
       34                      ,input ParamObj:my-cntxt-obj-type
       35                      ,input ParamObj:my-cntxt-obj-code
       36                      ,input-output vgdsgrp_recids ).
       37         ParamForm:gdsgrp_recids = vgdsgrp_recids.
       38      end.
       39      method public logical choose_BUTTON-node-2 ():
       40         define variable vgdsgrp_recids as character no-undo.
       41         vgdsgrp_recids = ParamForm:gdsgrp_recids.
       42         run ref/gds-grp.w
       43         (              input ParamObj:my-handle
       44                       ,input "b-sel,b-mark"
       45                       ,input ParamObj:my-cntxt-obj-type
       46                       ,input ParamObj:my-cntxt-obj-code
       47                       ,input-output vgdsgrp_recids ).
       48         ParamForm:gdsgrp_recids = vgdsgrp_recids.
       49         return num-entries(ParamForm:gdsgrp_recids) > 0 .
       50      end.
       51      method public logical set_SelectGood (iSelectGood as integer ):
       52         paramobj:x-SelectGood = iSelectGood.
       53      end method.
       54      method public logical set_GoodsEditor (iGoodsEditor as character  ):
       55         paramobj:x-Goods-Editor = iGoodsEditor.
       56      end method.
       57      method public logical set_TextLb (itext as character ):
       58         paramobj:x-text-Goods = itext.
       59      end method.
       60      method public logical selXSelectGood (output t-str as character,output goods-count as character ):
       61         define variable grp_name    as char.
       62         define buffer buf_gds-grp for ub.gds-grp .
       63         define variable my-c as int no-undo.
       64         define variable lns-cnt as integer no-undo.
       65         if paramform:temp-param-goods <> ""
       66         then do:
       67            case paramobj:x-SelectGood :
       68               when 1 then t-str = " По всем товарам ".
       69               when 2 then do:
       70                  t-str = " По группам " + ParamObj:create_tmp#grp(ParamForm:gdsgrp_recids ) .
       71                  if num-entries( ParamForm:gdsgrp_recids ) > 0 then
       72                      goods-count = "выбрано " + string(num-entries( ParamForm:gdsgrp_recids )) + " групп " .
       73                      else goods-count = "НЕ выбрано !!!".
       74                  end.
       75               when 3 then do:
       76                  t-str = ''.
       77                  t-str = " По производителям " + Paramobj:Get_text_g#cli(output my-c) .
       78                  if my-c > 0
       79                  then
       80                     goods-count = "выбрано " + String(my-c) .
       81                  else
       82                     goods-count = "НЕ выбрано !!!".
       83               end.
       84               when 4 then do:
       85                  lns-cnt = Paramobj:get-gds-list-count().
       86                  if lns-cnt ne 0 then do:
       87                     t-str = " По списку товаров " +  Paramobj:get-gds-list-note().
       88                     goods-count = "выбрано " + String(lns-cnt) .
       89                  end.
       90                  else assign goods-count = "НЕ выбрано !!!" t-str = "" .
       91               end.
       92               when  6  then do:
       93                  lns-cnt = Paramobj:get-gds-list-count().
       94                  if  keep-spis <> "" then do:
       95                     t-str = Paramobj:get-gds-list-note().
       96                     goods-count = "выбрано списков : " + String(lns-cnt) .
       97                  end.
       98                  else assign goods-count = "НЕ выбрано !!!" t-str = "" lns-cnt = 0 .
       99               end.
      100               when 5 then do:
      101                  if Paramobj:get-gds-list-one() ne  ?
      102                  then assign t-str = " " +  Paramobj:get-gds-list-one() goods-count = "выбран 1 товар".
      103                  else assign t-str = ""                                 goods-count = "НЕ выбрано !!!" lns-cnt = 0 .
      104               end.
      105               when 7 then do:
      106                  t-str = " По группам "  + Paramobj:create_tmp#grp(Paramform:gdsgrp_recids).
      107                  t-str = t-str + chr(10) +  " По производителям " + Paramobj:Get_text_g#cli(output my-c).
      108                  if num-entries( Paramform:gdsgrp_recids ) > 0  and my-c > 0 then do:
      109                     goods-count = "выбрано " + string(num-entries( Paramform:gdsgrp_recids )) + " групп "
      110                         + string(my-c) + " производителей " .
      111                  end.
      112                  else goods-count = "НЕ выбрано !!!".
      113               end.
      114            end case.
      115         end.
      116      end.
      117      method public void choose_BUTTON-one ():
      118         define variable ri-list         as char no-undo .
      119         define buffer buf_goods for ub.goods .
      120         run ref/gds-ref.p
      121             ( paramobj:my-handle
      122               ,'b-sel'
      123               ,?
      124               ,?
      125               ,?
      126               ,?
      127               ,?
      128               ,?
      129               ,?
      130               ,paramobj:my-cntxt-obj-type
      131               ,paramobj:my-cntxt-obj-code
      132               ,?
      133               , output ri-list) .
      134         paramobj:create-gds-list(ri-list).
      135      end.
      136      method public void choose_BUTTON-prod (iSelectGood as char):
      137         define variable v-ind as integer   no-undo .
      138         define buffer cli-prod for ub.clients .
      139         define variable cli-grp_recids as character no-undo .
      140         define variable vSelectGood as integer  no-undo.
      141         vSelectGood = sType:SelectGoodInt(iSelectGood).
      142         if vSelectGood = 3
      143         then do:
      144            run ref/cli-all.w
      145               (  paramobj:my-handle
      146                  , "b-sel,b-mark"
      147                   , 'про':U
      148                    , 'все':U
      149                   , 'текущие':U
      150                   , ?
      151                   , ",,,,,,NO,,"
      152                   , ?
      153                 , output cli-grp_recids ) no-error .
      154            if error-status :error then
      155               message vss-workfile vss-revision vss-description skip
      156                           error-status :get-message(1) skip
      157                           "Ошибка вызова cli-all.w"
      158                           view-as alert-box error .
      159            paramobj:create_g#cli(cli-grp_recids).
      160         end.
      161         else do:
      162            paramobj:empty-g#cli().
      163            cli-grp_recids = "" .
      164         end.
      165      end.
      166      method public logical choose_BUTTON-prod-2 (iSelectGood as char):
      167         define buffer cli-prod for ub.clients .
      168         define variable v-ind          as integer   no-undo .
      169         define variable cli-grp_recids as character no-undo .
      170         define variable vSelectGood    as integer   no-undo.
      171         vSelectGood = sType:SelectGoodInt(iSelectGood).
      172         if vSelectGood = 7
      173         then do:
      174            run ref/cli-all.w
      175               (  paramobj:my-handle
      176               ,  "b-sel,b-mark"
      177               ,  'про':U
      178               ,  'все':U
      179               ,  'текущие':U
      180               ,  ?
      181               ,  ",,,,,,NO,,"
      182               , ?
      183               , output cli-grp_recids ) .
      184            paramobj:create_g#cli(cli-grp_recids).
      185         end.
      186         else do:
      187            paramobj:empty-g#cli().
      188         end.
      189         return cli-grp_recids ne "".
      190      end.
      191      method public void CHOOSE_BUTTON-keep-spis(output lns-cnt as integer , output s-notes as character ):
      192         define variable keep-spis as character no-undo.
      193         ParamObj:empty-gds-list().
      194         keep-spis = "".
      195         define buffer buf_clob-bind for ub.clob-bind  .
      196         define variable v-rid-list as character no-undo .
      197         run ref/clobbnds.w ( input ParamObj:my-handle
      198                       ,input ParamObj:parent-handle
      199                       ,input 'b-sel'
      200                       ,input "uniq-key-rec"
      201                       ,input ""
      202                       ,input 'list':U
      203                       ,input 'gds-list'
      204                       ,input -1
      205                       ,input-output v-rid-list) no-error.
      206         find first buf_clob-bind no-lock where
      207               recid(buf_clob-bind) = integer(v-rid-list) no-error .
      208         if available buf_clob-bind then do:
      209            keep-spis = buf_clob-bind.field-name_ .
      210            lns-cnt = 1 .
      211            s-notes = substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, buf_clob-bind.descr ).
      212         end.
      213         else do:
      214            keep-spis = "".
      215            lns-cnt = 0 .
      216            s-notes = " " .
      217         end.
      218         new-state ("KEEP-SPIS="  + string(keep-spis)).
      219      end.
      220      method public void value-changed_SelectGood (iSelectGood as character ):
      221         define variable vSelectGood    as integer   no-undo.
      222         vSelectGood = sType:SelectGoodInt(iSelectGood).
      223         new-state ("SELECTGOOD="  + String(vSelectGood)).
      224      end.
      225      method public void Assign-frame():
      226         define variable t-str as character no-undo.
      227         define variable goods-count as character no-undo.
      228         if ParamForm:temp-param-goods = ""
      229         then ParamObj:strGoods = " ".
      230         else do:
      231            selXSelectGood(output t-str, output goods-count).
      232            ParamObj:strGoods = paramobj:x-text-Goods + ": "  + t-str .        .
      233         end.
      234      end.
      235      method private void new-state(istate as character ):
      236      end.
      237      constructor public sGoods_trg (  ):
      238         super ().
      239      end constructor.
      240      destructor public sGoods_trg ( ):
      241      end destructor.
      242   end class.
