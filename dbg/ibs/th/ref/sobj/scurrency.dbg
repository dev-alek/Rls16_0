      399      method public void local-apply-layout(iparamObj as class ibs.th.ref.sobj.sParamObj):
      400         if     iparamObj:X-SET_PAY_TYPE ne ?
      401            and iparamObj:X-SET_PAY_TYPE ne 0
      402         then
      403            SETPAYTYPE = stype:SetPayTypeLbl(iparamObj:X-SET_PAY_TYPE).
      404         if     iparamObj:X-SET_val_TYPE ne ?
      405            and iparamObj:X-SET_val_TYPE ne 0
      406         then
      407            SETvalTYPE = stype:SetValTypeLbl(iparamObj:X-SET_val_TYPE).
      408         if      (   Paramform:init-SET_PAY_TYPE <> 0
      409                  or Paramform:init-SET_PAY_TYPE <> ?)
      410             and (   iparamObj:x-SET_PAY_TYPE = ?
      411                  or iparamObj:x-SET_PAY_TYPE = 0)
      412             and Paramform:init-SET_PAY_TYPE  ne ?
      413             and Paramform:init-SET_PAY_TYPE  ne 0
      414         then do:
      415            SETPAYTYPE = stype:SetPayTypeLbl(Paramform:init-SET_PAY_TYPE).
      416         end.
      417         display-pay ().
      418         set_val().
      419         if iparamObj:params-only-mode  = 'ПРОСМОТР':U
      420         then do:
      421            showcrsa:enabled = no.
      422            showcost:enabled = no.
      423            showsale:enabled = no.
      424            SetPayType_Enabled("").
      425            SetValType_Enabled("").
      426         end.
      427      end method.
      428      method public void local-initialize(iparamObj as class ibs.th.ref.sobj.sParamObj):
      429         if iParamObj:Show-Cost
      430         then do:
      431            Showcost:Checked = iParamObj:Show-cost.
      432            Showcost:enabled = yes.
      433            Showcost:visible = yes.
      434         end.
      435         if iParamObj:Show-Crsa
      436         then do:
      437            Showcrsa:Checked = iParamObj:Show-crsa.
      438            Showcrsa:enabled = yes.
      439            Showcrsa:visible = yes.
      440         end.
      441         if iParamObj:Show-sale
      442         then do:
      443            Showsale:Checked = iParamObj:Show-sale.
      444            Showsale:enabled = yes.
      445            Showsale:visible = yes.
      446         end.
      447         if paramform:Name-Sale-price <> ""
      448         then do :
      449            stype:settypelbl("SetPayType",5,paramform:Name-Sale-price).
      450            showsale:Text = paramform:Name-Sale-price .
      451         end.
      452         if (paramform:init-SET_val_type <> 0)
      453         then do:
      454            setvaltype = stype:SetValTypeLbl(paramform:init-SET_val_type).
      455         end.
      456         else
      457            if ParamForm:temp-param-Pay-hide ne ""
      458            then
      459            setvaltype = stype:SetValTypeLbl(int(entry(1,ParamForm:temp-param-Pay-hide))).
      460      end method.
      461   end class.
