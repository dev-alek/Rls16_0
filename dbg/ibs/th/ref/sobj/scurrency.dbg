      353      method private void display-pay ():
      354         if ParamForm:temp-param-pay = ""
      355         then do:
      356            SetPayType_Enabled("").
      357            SetPayType_visible("").
      358            SETPAYTYPE= stype:setpaytypelbl(2).
      359         end.
      360         else do:
      361            SetPayType_Enabled(ParamForm:temp-param-pay).
      362            SetPayType_visible("*").
      363            SetValType_Enabled(ParamForm:temp-param-Pay-hide).
      364            SetValType_visible("*").
      365            TEXT4:visible = yes.
      366            if lookup(ParamForm:temp-param-pay, "" ) > 0
      367            then
      368               SETPAYTYPE= stype:setpaytypelbl(2).
      369         end.
      370         if ParamForm:temp-param-pay-hide = "" then do:
      371            SetValType_Enabled("").
      372            SetValType_visible("").
      373         end.
      374         else do:
      375            SetValType_Enabled(ParamForm:temp-param-Pay-hide).
      376            SetValType_visible("*").
      377            TEXT4:visible = yes .
      378         end.
      379      end.
      380      method private void Set_VAl() :
      381         if not (ParamForm:temp-param-pay = "" and  ParamForm:temp-param-pay-hide = "")
      382         then do:
      383            if SETPAYtYPE = stype:setpaytypelbl(1)
      384            then
      385               SetValType_Enabled("").
      386            else
      387               SetValType_Enabled(ParamForm:temp-param-Pay-hide).
      388         end.
      389      end.
