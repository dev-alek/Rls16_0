       47      define public property RadioSchet as character  no-undo
       48      get:
       49         return if      RadioSchetOne           :checked
       50                then    RadioSchetOne           :text
       51                else if RadioSchetMy            :checked
       52                then    RadioSchetMy            :text
       53                else if RadioSchetFirm          :checked
       54                then    RadioSchetFirm          :text
       55                else if RadioSchetCurrency      :checked
       56                then    RadioSchetCurrency      :text
       57                else if RadioSchetChang         :checked
       58                then    RadioSchetChang         :text
       59                else if RadioSchetAbbr          :checked
       60                then    RadioSchetAbbr          :text
       61                else if RadioSchetAll           :checked
       62                then    RadioSchetAll           :text
       63                else "".
       64      end.
       65      set (iarg as character  ):
       66         if      iarg eq RadioSchetOne          :text
       67         then            RadioSchetOne          :checked = yes .
       68         else if iarg eq RadioSchetMy           :text
       69         then            RadioSchetMy           :checked = yes .
       70         else if iarg eq RadioSchetFirm         :text
       71         then            RadioSchetFirm         :checked = yes.
       72         else if iarg eq RadioSchetCurrency     :text
       73         then            RadioSchetCurrency     :checked = yes.
       74         else if iarg eq RadioSchetChang        :text
       75         then            RadioSchetChang        :checked = yes .
       76         else if iarg eq RadioSchetAbbr         :text
       77         then            RadioSchetAbbr         :checked = yes.
       78         else if iarg eq RadioSchetAll          :text
       79         then            RadioSchetAll          :checked = yes.
       80         else
       81            message "Нет поля " iarg
       82            view-as alert-box.
       83      end.
       84      define public property RadioSchet_disable as character  no-undo
       85      set (iarg as character  ):
       86         define variable varg as character  no-undo.
       87         define variable vi as integer no-undo.
       88         if iarg = "*" then "".
       89         do vi = 1 to 7:
       90            if lookup(string(vi),iarg) eq 0
       91            then do:
       92            varg = stype:SelectObjectLbl(vi)no-error.
       93            if      varg eq RadioSchetOne:Text
       94            then            assign
       95                            BtnSchetOne :visible  = no
       96                            RadioSchetOne:Enabled = no
       97                           .
       98            else if varg eq RadioSchetMy:Text
       99            then            RadioSchetMy:Enabled = no .
      100            else if varg eq RadioSchetFirm:Text
      101            then            RadioSchetFirm:Enabled = no .
      102            else if varg eq RadioSchetCurrency:Text
      103            then            assign
      104                            BtnSchetVal:visible = no
      105                            RadioSchetCurrency:Enabled = no .
      106            else if varg eq RadioSchetChang:Text
      107            then            assign
      108                            BtnSchet:visible = no
      109                            RadioSchetChang:Enabled = no .
      110            else if varg eq RadioSchetAbbr:Text
      111            then            RadioSchetAbbr:Enabled = no .
      112            else if varg eq RadioSchetAll:Text
      113            then            RadioSchetAll:Enabled = no .
      114         end.
      115         end.
      116      end.
