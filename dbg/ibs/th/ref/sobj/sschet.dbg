      351      method private void select-radio-schet-no-apply (init as logical ):
      352         do on error undo, return error return-value:
      353            case stype:RadioSchetint(radioschet) :
      354               when 3 then do:
      355                  assign
      356                     BtnSchet:enabled    = yes
      357                     BtnSchetOne:enabled = no
      358                     BtnSchetVal:enabled = no
      359                  .
      360                  if not init
      361                  then
      362                     CHOOSE_BUTTON-schet ().
      363               end.
      364               when 4 then do:
      365                  assign
      366                     BtnSchet:enabled    = no
      367                     BtnSchetOne:enabled = yes
      368                     BtnSchetVal:enabled = no
      369                  .
      370                  if init
      371                  then
      372                     mTrgLoc:initschet().
      373                  else
      374                     CHOOSE_BUTTON-schet-one().
      375               end.
      376               when 7 then do:
      377                  assign
      378                     BtnSchet:enabled    = no
      379                     BtnSchetOne:enabled = no
      380                     BtnSchetVal:enabled = yes
      381                  .
      382                  if not init
      383                  then
      384                     CHOOSE_BUTTON-schet().
      385               end.
      386               otherwise do:
      387                  assign
      388                     BtnSchet:enabled    = no
      389                     BtnSchetOne:enabled = no
      390                     BtnSchetVal:enabled = no
      391                  .
      392               end.
      393            end case.
      394            setlkpschet().
      395            lkpschet:text  = lkpschet:text + mtrgloc:getschettext().
      396         end.
      397      end.
      398      method private void  CHOOSE_BUTTON-schet():
      399         mtrgloc:CHOOSE_BUTTON-schet().
      400         setlkpschet().
      401      end.
      402      method private void  setlkpschet():
      403         lkpschet:text = ParamForm:temp-param-schet + " по : " + RADIOschet + chr(10) .
      404         lkpschet:text  = lkpschet:text + mtrgloc:getschettext().
      405      end.
      406      method private void  CHOOSE_BUTTON-schet-one():
      407         mtrgloc:CHOOSE_BUTTON-schet-one().
      408         setlkpschet().
      409      end.
      410      method private void CHOOSE_BUTTON-schet-val():
      411         mtrgloc:CHOOSE_BUTTON-schet-val().
      412      end.
      413      method private void VALUE-CHANGED_Radio-schet ():
      414         select-radio-schet() .
      415      end.
      416      method private void select-Radio-schet ():
      417         do
      418         on error undo, return error return-value
      419         :
      420            select-radio-schet-no-apply(no).
      421            mtrgloc:select-Radio-schet(RadioSchet).
      422         end.
      423      end.
      424      method public void Assign-frame():
      425         if RadioSchet = "" then RadioSchet = stype:RadioSchetLbl(1).
      426         mTrgLoc:Assign-frame(lkpschet:Text).
      427      end method.
      428      method public void local-apply-layout(iparamObj as class ibs.th.ref.sobj.sParamObj):
      429         if iparamObj:params-only-mode  = 'ПРОСМОТР':U
      430         then
      431            RadioSchet_disable = "*".
      432      end method.
      433      method public void local-initialize(iparamObj as class ibs.th.ref.sobj.sParamObj):
      434         init-radio-schet() .
      435      end method.
      436   end class.
