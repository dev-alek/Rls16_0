      279      method private void init-radio-schet ():
      280         do
      281         on error undo, return error return-value
      282         :
      283            define variable ll as integer no-undo .
      284            label1:text = ParamForm:temp-param-schet .
      285            if ParamForm:temp-param-schet-init <> "" then do:
      286               radioschet = stype:RadioSchetLbl(  4 ).
      287            end.
      288            if ParamForm:temp-param-schet-hide <> ""
      289            then do:
      290               if radioschet eq stype:RadioSchetLbl(4)
      291               then
      292               repeat ll = 1 to num-entries(ParamForm:temp-param-schet-hide) - 1 :
      293                 if entry(ll,ParamForm:temp-param-schet-hide) =  string( 4 )
      294                    then message "Не верно заданы параметры для блока ВЫБОР СЧЕТА в вызывающей процедуре g- " view-as alert-box error .
      295               end.
      296               radioschet_disable=ParamForm:temp-param-schet-hide.
      297               if radioschet = stype:RadioSchetLbl(  4 )
      298               then do:
      299                  block-rep:
      300                  repeat ll = 1 to 7 :
      301                     if lookup( string(ll) , ParamForm:temp-param-schet-hide) eq 0
      302                     then do:
      303                        radioschet = stype:RadioSchetLbl(ll) .
      304                        leave block-rep.
      305                     end.
      306                  end.
      307               end.
      308               if stype:RadioSchetint(radioschet) eq  4
      309               then do:
      310                  mTrgLoc:initschet ().
      311               end.
      312               select-radio-schet-no-apply(yes).
      313            end.
      314         end.
      315      end.
