      212       method public void Set_Date-Start(iDate-Start as date):
      213          ParamObj:X-Date-Start     = iDate-Start.
      214       end.
      215      method public character  verify-date(iDateStart as date, iDateEnd as date):
      216         if iDateEnd < iDateStart
      217         then do:
      218            message "Интервал дат введен неверно !" view-as alert-box error title "О Ш И Б К А !!!".
      219            return error "Интервал дат введен неверно".
      220         end.
      221      end.
      222      method public  void LEAVE_Shift-Alone(iShift-Alone as integer ):
      223         set_Shift-Alone(iShift-Alone).
      224         set_Shift-end  (iShift-Alone).
      225         set_Shift-start(iShift-alone).
      226         new-state ("SHIFT-ALONE="  + String(iSHIFT-Alone)).
      227      end.
      228      method public  void set_Shift-Alone(iShift-Alone as integer ):
      229         Paramobj:X-Shift-Alone   = iShift-Alone.
      230      end.
      231      method public  void set_Shift-end(iShift-end as integer ):
      232         ParamObj:X-Shift-End     = iShift-end.
      233      end.
      234      method public  void set_Shift-start(iShift-start as integer ):
      235         ParamObj:X-Shift-start     = iShift-start.
      236      end.
      237      method public  void verify-shift(idate as date,iShift as integer, iflag as logical ) :
      238         define buffer buf_shift-obj for ub.shift-obj .
      239         find first buf_Shift-obj where buf_Shift-obj.shift-num  = iShift
      240                                    and buf_Shift-obj.shift-date = idate
      241         no-lock no-error.
      242         if    not available buf_Shift-obj
      243            or (iflag and not ParamObj:avail_obj-list( buf_shift-obj.obj-type,buf_shift-obj.obj-code ) )
      244         then do:
      245            message "Нет смены " ishift idate " !"
      246               view-as alert-box error title "О Ш И Б К А !!!".
      247            return error.
      248         end.
      249         else do:
      250            ParamObj:x-tog-shift = true .
      251         end.
      252      end method.
      253      method public logical avail_shift-obj ():
      254         define buffer buf_shift-obj for ub.shift-obj .
      255         return can-find(first buf_shift-obj where
      256                               buf_shift-obj.obj-code = ParamObj:my-cntxt-obj-code and
      257                               buf_shift-obj.obj-type = ParamObj:my-cntxt-obj-type no-lock ).
      258      end.
      259      method public void  VALUE-CHANGED_TOG-Shift (itog-shift as logical):
      260         set_tog-shift (not itog-shift = false).
      261         new-state ("TOG-SHIFT ="  + String(itog-shift)).
      262      end .
      263      method public void  set_TOG-Shift (itog-shift as logical):
      264          ParamObj:x-tog-shift   = itog-shift .
      265      end .
