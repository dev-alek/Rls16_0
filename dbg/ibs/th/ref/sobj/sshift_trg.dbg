       18      method public void BtnShift (input-output pdate-start   as date,
       19                                   input-output pshift-alone  as integer ):
       20         define variable v-doc-rec as recid no-undo.
       21         define variable rec-list-2 as character no-undo.
       22         define buffer buf_shift-obj for ub.shift-obj .
       23         define variable vSelectObject as character no-undo.
       24         vSelectObject =ParamObj:x-SelectObject.
       25         if  vSelectObject = "currency":U
       26         then do:
       27            find first buf_shift-obj no-lock where
       28                       buf_shift-obj.shift-date = pdate-start and
       29                       buf_shift-obj.shift-num = pshift-alone and
       30                       buf_shift-obj.obj-type = ParamObj:my-cntxt-obj-type and
       31                       buf_shift-obj.obj-code = ParamObj:my-cntxt-obj-code no-error.
       32            if available buf_shift-obj
       33            then
       34               rec-list-2 = string(recid(buf_shift-obj)).
       35         end.
       36         if  vSelectObject = "currency":U
       37         then do:
       38            run str/sht-all.w
       39            (             input paramobj:my-handle
       40                         ,input paramobj:my-cntxt-obj-type
       41                         ,input paramobj:my-cntxt-obj-code
       42                         ,input  "b-sel"
       43                         ,input "obj":U
       44                         ,input paramobj:my-cntxt-obj-type
       45                         ,input paramobj:my-cntxt-obj-code
       46                         ,input ParamObj:ReportProc
       47                         ,input-output rec-list-2 ).
       48         end.
       49         else do:
       50            run str/sht-all.w
       51            (             input paramobj:my-handle
       52                         ,input paramobj:my-cntxt-obj-type
       53                         ,input paramobj:my-cntxt-obj-code
       54                         ,input  "b-sel"
       55                         ,input "all":U
       56                         ,input '':U
       57                         ,input 0
       58                         ,input ParamObj:ReportProc
       59                         ,input-output rec-list-2 ).
       60         end.
       61         find first buf_shift-obj where recid (buf_shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
       62         if available buf_shift-obj
       63         then do:
       64            assign
       65               pdate-start  = buf_shift-obj.shift-date
       66               pshift-alone = buf_shift-obj.shift-num
       67            .
       68         end.
       69      end.
       70      method public void BUTTON-Shift-Start(
       71                                       input-output pdate-start as date,
       72                                       input-output pshift-start as integer):
       73         define variable v-doc-rec as recid no-undo .
       74         define variable rec-list-2      as char no-undo.
       75         define buffer buf_shift-obj for ub.shift-obj .
       76         define variable vSelectObject as character no-undo.
       77         vSelectObject = ParamObj:x-SelectObject.
       78         if  vSelectObject = "currency":U
       79         then do:
       80            find first buf_shift-obj no-lock where
       81                       buf_shift-obj.shift-date = pdate-start and
       82                       buf_shift-obj.shift-num = pshift-start and
       83                       buf_shift-obj.obj-type = paramobj:my-cntxt-obj-type and
       84                       buf_shift-obj.obj-code = paramobj:my-cntxt-obj-code no-error.
       85            if available buf_shift-obj
       86            then
       87               rec-list-2 = string(recid(buf_shift-obj)).
       88            end.
       89            if  vSelectObject = "currency":U
       90            then do:
       91               run str/sht-all.w
       92               (             input paramobj:my-handle
       93                            ,input paramobj:my-cntxt-obj-type
       94                            ,input paramobj:my-cntxt-obj-code
       95                            ,input  "b-sel"
       96                            ,input "obj":U
       97                            ,input paramobj:my-cntxt-obj-type
       98                            ,input paramobj:my-cntxt-obj-code
       99                            ,input paramobj:ReportProc
      100                            ,input-output rec-list-2 ).
