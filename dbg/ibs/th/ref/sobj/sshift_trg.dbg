      188      method public void LEAVE_Date-Alone (iDate-Alone as date):
      189         Set_Date-Start( iDate-Alone).
      190         set_Date-End ( iDate-Alone).
      191         set_Date-Alone ( iDate-Alone).
      192         new-state ("DATE-ALONE="  + String(iDATE-ALONE)).
      193      end.
      194      method public void LEAVE_Date-End (iDateStart as date, iDate-End as date):
      195         set_Date-End (iDate-End).
