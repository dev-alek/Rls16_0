        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.ref.sobj.sSchet_trg:
        4      define public property ParamObj as class ibs.th.ref.sobj.sParamObj no-undo
        5      get.
        6      set.
        7      define public property ParamForm as class ibs.th.ref.sobj.sParamForm no-undo
        8      get.
        9      set.
       10      define public property stype as class ibs.th.ref.sobj.stype no-undo
       11      get.
       12      set.
       13      define variable schet-list as character no-undo.
       14      define variable m-curr-code               as integer   no-undo .
       15      define variable m-curr-abbr               as character no-undo .
       16      method public void initschet ():
       17         define buffer buf_fin-schet for ub.fin-schet.
       18         if     ParamForm:temp-param-schet-init <> ""
       19            and ParamForm:temp-param-schet-init <> ?
       20         then do:
       21            find first buf_fin-schet no-lock where
       22                       buf_fin-schet.code-schet = integer (ParamForm:temp-param-schet-init) and
       23                       buf_fin-schet.host-code  = ParamObj:my-cntxt-host-code-obj no-error .
       24            if available buf_fin-schet
       25            then
       26               schet-list = string(recid(buf_fin-schet)).
       27         end.
       28      end.
       29      method public character  getschettext ():
       30         define buffer buf_fin-schet for ub.fin-schet.
       31         define variable vtext as character no-undo.
       32         define variable v-iii as integer no-undo .
       33         if schet-list <> ""
       34         then do:
       35            if schet-list begins "curr-code="
       36            then
       37               vtext =m-curr-abbr.
       38            else
       39            repeat v-iii = 1 to num-entries(schet-list) :
       40               find first buf_fin-schet no-lock where    recid(buf_fin-schet) = integer (entry(v-iii,schet-list))   no-error .
       41               if available buf_fin-schet then
       42                  vtext  = vtext  + string( buf_fin-schet.code-schet) + ", " .
       43            end.
       44         end.
       45         return vtext.
       46      end.
       47      method public void  CHOOSE_BUTTON-schet():
       48         define variable v-status_ as character  no-undo init 'тек':U.
       49         schet-list = "" .
       50         run ref/finschts.w
       51          (   input ParamObj:my-handle,
       52              input ParamObj:my-cntxt-host-code-obj,
       53              input "b-mark,b-sel",
       54              input ParamForm:temp-param-schet-mode,
       55              input ?,
       56              input ?,
       57              input 0,
       58              input ParamObj:my-cntxt-host-code-obj ,
       59              input 0,
       60              input-output v-status_,
       61              input-output schet-list).
       62         ParamObj:fin-schet-recid =  schet-list .
       63      end.
       64      method public void  CHOOSE_BUTTON-schet-one():
       65         define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
       66         define buffer buf_fin-schet for ub.fin-schet.
       67         schet-list          = "" .
       68         if     ParamForm:temp-param-schet-init <> ""
       69            and ParamForm:temp-param-schet-init <> ?
       70         then do:
       71            find first buf_fin-schet no-lock where
       72                       buf_fin-schet.code-schet = integer (ParamForm:temp-param-schet-init) and
       73                       buf_fin-schet.host-code  = ParamObj:my-cntxt-host-code-obj no-error .
       74            if available buf_fin-schet
       75            then
       76               assign
       77                  schet-list = string(recid(buf_fin-schet))
       78                  v-status_ = buf_fin-schet.status_
       79               .
       80         end.
       81         run ref/finschts.w
       82          (   input ParamObj:my-handle,
       83              input ParamObj:my-cntxt-host-code-obj,
       84              input "b-sel",
       85              input ParamForm:temp-param-schet-mode,
       86              input ?,
       87              input ?,
       88              input 0,
       89              input ParamObj:my-cntxt-host-code-obj ,
       90              input 0,
       91              input-output v-status_,
       92              input-output schet-list).
       93         if num-entries(schet-list) > 1 then do:
       94            schet-list = "".
       95            ParamObj:fin-schet-recid =  schet-list.
       96            message "ћожно выбрать только один счет !!!" view-as alert-box .
       97            return .
       98         end.
       99         ParamObj:fin-schet-recid =  schet-list .
      100         find first buf_fin-schet no-lock where    recid(buf_fin-schet) = integer (schet-list)   no-error .
      101         define variable v-code-schet as integer no-undo .
      102         if available buf_Fin-schet then do:
      103            v-code-schet = buf_fin-schet.code-schet.
      104         end.
      105         if     ParamForm:ref_date-start <> '':u
      106            and entry(2, ParamForm:ref_date-start, chr(4)) = "finsttms":U
      107         then do:
      108            entry(3, ParamForm:ref_date-start, chr(4)) = "code-schet-start".
      109            entry(4, ParamForm:ref_date-start, chr(4)) = string(v-code-schet).
      110         end.
      111         if     ParamForm:ref_date-end <> '':u
      112            and entry(2, ParamForm:ref_date-end, chr(4)) = "finsttms":U
      113         then do:
      114            entry(3, ParamForm:ref_date-end, chr(4)) = "code-schet-end".
      115            entry(4, ParamForm:ref_date-end, chr(4)) = string(v-code-schet).
      116         end.
      117         if     ParamForm:ref_date-alone <> '':u
      118            and entry(2, ParamForm:ref_date-alone, chr(4)) = "finsttms":U
      119         then do:
      120            entry(3, ParamForm:ref_date-alone, chr(4)) = "code-schet-end1".
      121            entry(4, ParamForm:ref_date-alone, chr(4)) = string(v-code-schet).
      122         end.
      123      end.
      124      method public void CHOOSE_BUTTON-schet-val():
      125         define variable ref-rec as recid no-undo.
      126         define buffer buf_currency for ub.currency .
      127         run ref/currency.w ( ParamObj:my-handle, "b-sel", input-output ref-rec ).
      128         if ref-rec = ? then do:
      129            assign
      130               schet-list= ""
      131               m-curr-abbr =  "" .
      132               m-curr-code = ?.
      133            return.
      134         end.
      135         else do:
      136            find first buf_currency where recid( buf_currency ) = ref-rec no-lock.
      137            assign
      138               m-curr-code = buf_currency.curr-code
      139               schet-list = "curr-code=" + string(buf_currency.curr-code)
      140               m-curr-abbr = buf_currency.curr-abbr
      141            .
      142         end.
      143      end.
      144      method private void new-state(istate as character ):
      145      end.
      146      method public void select-Radio-schet (iRadio-schet as character ):
      147         define variable vRadioSchet as integer no-undo.
      148         do
      149         on error undo, return error return-value
      150         :
      151            vRadioSchet = stype:RadioSchetInt(iRadio-schet).
      152            new-state("RADIO-SCHET="  + string(vRadioSchet)) .
      153            case vRadioSchet:
      154               when 1
      155               or
      156               when 2
      157               or
      158               when 3
      159               or
      160               when 6
      161               or
      162               when 4
      163               then do:
      164                  if     ParamForm:ref_date-start <> '':u
      165                     and entry(2, ParamForm:ref_date-start, chr(4)) = "finsttms":U
      166                  then do:
      167                     entry(3, ParamForm:ref_date-start, chr(4)) = "ext-type-stat-start".
      168                     entry(4, ParamForm:ref_date-start, chr(4)) = "".
      169                  end.
      170                  if     ParamForm:ref_date-end <> '':u
      171                     and entry(2, ParamForm:ref_date-end, chr(4)) = "finsttms":U
      172                  then do:
      173                     entry(3, ParamForm:ref_date-end, chr(4)) = "ext-type-stat-end".
      174                     entry(4, ParamForm:ref_date-end, chr(4)) = "".
      175                  end.
      176                  if     ParamForm:ref_date-alone <> '':u
      177                     and entry(2, ParamForm:ref_date-alone, chr(4)) = "finsttms":U
      178                  then do:
      179                     entry(3, ParamForm:ref_date-alone, chr(4)) = "ext-type-stat-start".
      180                     entry(4, ParamForm:ref_date-alone, chr(4)) = "".
      181                  end.
      182               end.
      183               when 5
      184               or
      185               when 7
      186               then do:
      187                  if     ParamForm:ref_date-start <> '':u
      188                     and entry(2, ParamForm:ref_date-start, chr(4)) = "finsttms":U
      189                  then do:
      190                     entry(3, ParamForm:ref_date-start, chr(4)) = "currency-start".
      191                     if vradioschet = 5
      192                     then  do:
      193                        entry(4, ParamForm:ref_date-start, chr(4)) = "0".
      194                     end.
      195                     else do:
      196                        entry(4, ParamForm:ref_date-start, chr(4)) = entry(2, schet-list, "=").
      197                     end.
      198                  end.
      199                  if     ParamForm:ref_date-end <> '':u
      200                     and entry(2, ParamForm:ref_date-end, chr(4)) = "finsttms":U
      201                  then do:
      202                     entry(3, ParamForm:ref_date-end, chr(4)) = "currency-end".
      203                     if vradioschet = 5
      204                     then  do:
      205                        entry(4, ParamForm:ref_date-end, chr(4)) = "0".
      206                     end.
      207                     else do:
      208                        entry(4, ParamForm:ref_date-end, chr(4)) = entry(2, schet-list, "=").
      209                     end.
      210                  end.
      211                  if     ParamForm:ref_date-alone <> '':u
      212                     and entry(2, ParamForm:ref_date-alone, chr(4)) = "finsttms":U
      213                  then do:
      214                     entry(3, ParamForm:ref_date-alone, chr(4)) = "currency-end1".
      215                     if vradioschet = 5
      216                     then  do:
      217                        entry(4, ParamForm:ref_date-alone, chr(4)) = "0".
      218                     end.
      219                     else do:
      220                        entry(4, ParamForm:ref_date-alone, chr(4)) = entry(2, schet-list, "=").
      221                     end.
      222                  end.
      223               end.
      224            end case.
      225         end.
      226      end.
      227      method public void Assign-frame(itext as character ):
      228         define variable t-str as character no-undo.
      229         ParamObj:fin-schet-recid =  schet-list.
      230         if ParamForm:temp-param-schet <> ""
      231         then do:
      232            paramobj:strSchet = itext.
      233         end.
      234      end method.
      235   end class.
