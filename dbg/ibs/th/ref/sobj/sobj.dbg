       83         mTrgLoc:ParamForm = iarg.
       84         ParamForm = iarg.
       85      end.
       86      constructor public sobj (  ):
       87         super().
       88         mTrgLoc = new ibs.th.ref.sobj.sObj_trg ().
       89         mTrgLoc:ObjForm = this-object.
       90         InitializeComponent().
       91         this-object:ComponentsCollection:ADD(this-object:components).
       92         catch e as Progress.Lang.Error:
       93            undo, throw e.
       94         end catch.
       95      end constructor.
