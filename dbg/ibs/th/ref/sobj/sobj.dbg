       20      define public property stype as class ibs.th.ref.sobj.stype no-undo
       21      get.
       22      set(iarg as ibs.th.ref.sobj.stype):
       23         stype = iarg.
       24         mTrgLoc:stype = iarg.
       25         SelectObjectObjFirm  :text = iarg:SelectObjectLbl("firm":U).
       26         SelectObjectObjCurr  :text = iarg:SelectObjectLbl("currency":U).
       27         SelectObjectObjChoice:text = iarg:SelectObjectLbl("choice":U).
       28         SelectObjectAll      :text = iarg:SelectObjectLbl("all":U).
       29      end.
       30      define public property SelectObject as character  no-undo
       31      get:
       32         return if      SelectObjectObjFirm  :checked
       33                then    SelectObjectObjFirm  :text
       34                else if SelectObjectObjCurr  :checked
       35                then    SelectObjectObjCurr  :text
       36                else if SelectObjectObjChoice:checked
       37                then    SelectObjectObjChoice:text
       38                else if SelectObjectAll      :checked
       39                then    SelectObjectAll      :text
       40                else "".
       41      end.
       42      set (iarg as character  ):
       43         if      iarg eq SelectObjectObjFirm  :text
       44         then            SelectObjectObjFirm  :checked = yes .
       45         else if iarg eq SelectObjectObjCurr  :text
       46         then            SelectObjectObjCurr  :checked = yes .
       47         else if iarg eq SelectObjectObjChoice:text
       48         then            SelectObjectObjChoice:checked = yes.
       49         else if iarg eq SelectObjectAll      :text
       50         then            SelectObjectAll      :checked = yes.
       51         else
       52            message "Нет поля " iarg
       53            view-as alert-box.
       54      end.
       55      define public property SelectObject_disable as character  no-undo
       56      set (iarg as character  ):
       57         define variable varg as character  no-undo.
       58         define variable vi as integer no-undo.
       59         if not iarg eq "*"
       60         then
       61         do vi = 1 to 4:
       62            if lookup(string(vi),iarg) eq 0
       63            then do:
       64               varg = stype:SelectObjectLbl(vi)no-error.
       65               if      varg eq SelectObjectObjFirm:Text
       66               then            SelectObjectObjFirm:Enabled = no .
       67               else if varg eq SelectObjectObjCurr:Text
       68               then            SelectObjectObjCurr:Enabled = no .
       69               else if varg eq SelectObjectObjChoice:Text
       70               then            SelectObjectObjChoice:Enabled = no .
       71               else if varg eq SelectObjectAll:Text
       72               then            SelectObjectAll:Enabled = no .
       73            end.
       74         end.
       75      end.
       76      define public property ParamObj as class ibs.th.ref.sobj.sParamObj no-undo
       77      set(iarg as ibs.th.ref.sobj.sParamObj):
       78         mTrgLoc:ParamObj = iarg.
       79      end.
