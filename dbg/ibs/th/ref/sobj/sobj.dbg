      230      method private character verify-obj():
      231         mTrgLoc:verify-obj () no-error.
      232         if error-status:error then return error.
      233      end.
      234      method private void CHOOSE_BUTTON-obj ():
      235         mtrgloc:select-objects-proc (false) .
      236      end.
      237      method private void VALUE-CHANGED_SelectObject():
      238         mtrgloc:select-objects-proc (no) .
      239         val-obj () .
      240         mtrgloc:VALUE-CHANGED_SelectObject(stype:SelectObjectchar(SelectObject)).
      241         ObjCount:text = mTrgLoc:Assign-frame(SelectObject).
      242      end.
      243      method private void VALUE-CHANGED_SelectObjectF():
      244         VALUE-CHANGED_SelectObject().
      245         ObjCount:text = "Выбор объекта: Все по фирме" .
      246      end.
      247      method private void display-obj ():
      248         define variable v-temp-str  as character no-undo .
      249         define variable J#          as integer   no-undo .
      250         define variable L#          as integer   no-undo .
      251         define variable RET#        as logical   no-undo .
      252         define variable R#          as integer   no-undo .
      253        SelectObject_disable = mTrgLoc:ParamForm:temp-param-obj.
      254         if (mTrgLoc:ParamObj:my-cntxt-obj-type = 'скл':U and mTrgLoc:ParamForm:temp-param-obj-type = 'shop')
      255         or (mTrgLoc:ParamObj:my-cntxt-obj-type = 'маг':U  and mTrgLoc:ParamForm:temp-param-obj-type = 'stock')
      256         then do:
      257            SelectObject_disable = sType:SelectObjectchar(3).
      258            value-changed_selectobject().
      259         end.
      260      end.
      261      method private void val-obj ():
      262         BtnObj:enabled = selectobject eq stype:SelectObjectLbl("choice":U).
      263      end.
      264      method public void Assign-frame():
      265         mTrgLoc:set_SelectObject(SelectObject).
      266         mTrgLoc:set_TextLb( TEXT1:text).
      267         ObjCount:text = mTrgLoc:Assign-frame(SelectObject).
      268      end.
      269      method public void local-apply-layout(iparamObj as class ibs.th.ref.sobj.sParamObj):
      270         if     iparamObj:X-SelectObject ne ?
      271            and iparamObj:X-SelectObject ne ""
      272         then
      273            SelectObject = stype:SelectObjectLbl(iparamObj:X-SelectObject).
      274         display-obj ().
      275         val-obj () .
      276         if iparamObj:X-SelectObject = "all":U then mTrgLoc:sss().
      277         if iparamObj:X-SelectObject = "firm":U then mTrgLoc:sss().
      278         mTrgLoc:verify-check-currency () .
      279         if iparamObj:params-only-mode  = 'ПРОСМОТР':U
      280         then
      281            SelectObject_disable = "".
      282      end method.
      283      method public void local-initialize(iparamObj as class ibs.th.ref.sobj.sParamObj):
      284         if    iparamObj:my-cntxt-level = 'firm':U
      285            or iparamObj:my-cntxt-level = 'global':U
      286         then do:
      287           assign
      288             SelectObjectObjCurr:visible = no.
      289         end.
      290         if ParamForm:temp-param-obj <> ""
      291         then do:
      292            if not (    iparamObj:my-cntxt-level = 'firm':U
      293                    or  iparamObj:my-cntxt-level = 'global':U )
      294            then    SelectObject =  stype:SelectObjectLbl("currency":U) .
      295            if SelectObject =  stype:SelectObjectLbl("choice":U)
      296            then do:
      297               iparamObj:empty-obj-list().
      298            end.
      299            else do:
      300               iparamObj:create_obj-list(iparamObj:my-cntxt-obj-type, iparamObj:my-cntxt-obj-code ).
      301            end.
      302         end.
      303      end method.
      304      method public char AssignParam ():
      305          verify-obj() no-error.
      306          if error-status:error then return error.
      307      end method.
      308   end class.
