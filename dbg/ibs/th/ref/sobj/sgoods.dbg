      397      method private void Display-count (ilns-cnt as integer,i-notes as character ):
      398         if sType:SelectGoodInt(SelectGood) = 6 then do:
      399           assign
      400             goodscount:Text = '(Выбрано ' + string(ilns-cnt) + ' список)'
      401             GoodsEditor:Text = i-notes
      402             .
      403         end.
      404         else do:
      405            if ilns-cnt > 0
      406            then
      407               assign
      408                  goodscount:Text = '(Выбрано ' + string(ilns-cnt) + ' товаров)'
      409                  GoodsEditor:Text= i-notes
      410               .
      411            else
      412               assign
      413                  goodscount:Text = ''
      414                  GoodsEditor:Text = ''
      415               .
      416         end.
      417         mTrgLoc:set_GoodsEditor( GoodsEditor:Text).
      418      end .
      419      method public void choose_BUTTON-one ():
      420         mtrgloc:choose_BUTTON-one().
      421         display-count-other().
      422      end.
      423      method private void Display-count-OTHER ():
      424   define variable t-str as character no-undo.
      425   define variable goods-count as character no-undo.
      426      mTrgLoc:set_SelectGood ( sType:SelectGoodInt( SelectGood )).
      427      mTrgLoc:selXSelectGood(output t-str,output goods-count).
      428      if length (t-str) > 6000
      429      then
      430         GoodsEditor:Text = substring(T-str ,1, 6000) +  " выборка для просмотра обрезана - слишком много записей " .
      431      else
      432         GoodsEditor:text = T-str  .
      433      mTrgLoc:set_GoodsEditor(GoodsEditor:Text).
      434   end .
      435    method private void display-goods () :
      436   define buffer buf_clob-bind for ub.clob-bind  .
      437   define variable v-temp-str  as character no-undo .
      438   define variable J#          as integer   no-undo .
      439   define variable L#          as integer   no-undo .
      440   define variable RET#        as logical   no-undo .
      441   define variable R#          as integer   no-undo .
      442    if  mTrgLoc:ParamForm:temp-param-goods ne ""
      443       then do:
      444        SelectGood_disable = mTrgLoc:ParamForm:temp-param-goods.
      445        SelectGood = stype:SelectGoodLbl(int(entry(1,mTrgLoc:ParamForm:temp-param-goods))).
      446     Display-count-OTHER() .
      447       end.
      448   end .
      449   method private void val-goods  ():
      450      if mTrgLoc:ParamForm:temp-param-goods <> ""
      451      then do:
      452         assign
      453            goodscount :text  = ''
      454            GoodsEditor:text  = ''
      455         .
      456         case sType:SelectGoodInt(SelectGood):
      457            when 1
      458            then do:
      459               assign
      460                  BtnGds:enabled      = no
      461                  BtnKeepSpis:enabled = no
      462                  BtnNode:enabled     = no
      463                  BtnProd:enabled     = no
      464                  BtnOne:enabled      = no
      465                  BtnProd2:enabled    = no
      466                  BtnNode2:enabled    = no
      467                  GoodsEditor:Text = " По всем товарам "
      468               .
      469            end.
      470            when 2 then do:
      471               assign
      472                  BtnGds:enabled      = no
      473                  BtnKeepSpis:enabled = no
      474                  BtnProd:enabled     = no
      475                  BtnOne:enabled      = no
      476                  BtnProd2:enabled    = no
      477                  BtnNode2:enabled    = no
      478                  BtnNode:enabled     = yes
      479               .
      480            end.
      481            when 3 then do:
      482               assign
      483                  BtnGds:enabled      = no
      484                  BtnKeepSpis:enabled = no
      485                  BtnNode:enabled     = no
      486                  BtnOne:enabled      = no
      487                  BtnProd2:enabled    = no
      488                  BtnNode2:enabled    = no
      489                  BtnProd:enabled     = yes
      490               .
      491            end.
      492            when 4 then do:
      493               assign
      494                  BtnGds:enabled      = no
      495                  BtnKeepSpis:enabled = no
      496                  BtnNode:enabled     = no
      497                  BtnProd:enabled     = no
      498                  BtnOne:enabled      = no
      499                  BtnProd2:enabled    = no
      500                  BtnNode2:enabled    = no
      501                  BtnGds:enabled      = yes
      502               .
      503            end.
      504            when 6 then do:
      505               assign
      506                  BtnGds:enabled      = no
      507                  BtnNode:enabled     = no
      508                  BtnProd:enabled     = no
      509                  BtnOne:enabled      = no
      510                  BtnProd2:enabled    = no
      511                  BtnNode2:enabled    = no
      512                  BtnKeepSpis:enabled = yes
      513               .
      514            end.
      515            when 5 then do:
      516               assign
      517                  BtnGds:enabled      = no
      518                  BtnKeepSpis:enabled = no
      519                  BtnNode:enabled     = no
      520                  BtnProd:enabled     = no
      521                  BtnProd2:enabled    = no
      522                  BtnNode2:enabled    = no
      523                  BtnOne:enabled      = yes
      524               .
      525            end.
      526            when 7 then do:
      527               assign
      528                  BtnGds:enabled      = no
      529                  BtnKeepSpis:enabled = no
      530                  BtnNode:enabled     = no
      531                  BtnProd:enabled     = no
      532                  BtnOne:enabled      = no
      533                  BtnProd2:enabled    = yes
      534                  BtnNode2:enabled    = yes
      535                  BtnOne:enabled      = no
      536               .
      537            end.
      538         end case.
      539         goodscount:enabled  = yes.
      540         GoodsEditor:enabled = yes.
      541      end.
      542      else assign
      543         goodscount:enabled  = no
      544         GoodsEditor:enabled = no
      545      .
      546   end.
      547      method private void CHOOSE_BUTTON-keep-spis():
      548         define variable sNote as character no-undo.
      549         define variable lns-cnt as integer  no-undo.
      550         mTrgLoc:CHOOSE_BUTTON-keep-spis(output lns-cnt,output sNote).
      551         display-count (lns-cnt,sNote) .
      552         display-count-other ().
      553      end.
      554      method public void Assign-frame():
      555         mTrgLoc:set_GoodsEditor(GoodsEditor:Text).
      556         mTrgLoc:set_SelectGood(sType:SelectGoodInt( SelectGood )).
      557         mTrgLoc:set_TextLb(TEXT2:Text).
      558         mTrgLoc:Assign-frame().
      559      end.
      560      method public void local-apply-layout(iparamObj as class ibs.th.ref.sobj.sParamObj):
      561         GoodsEditor:Text = iparamObj:X-Goods-Editor.
      562         if iparamObj:X-SelectGood ne 0
      563         then
      564            SelectGood   = stype:SelectGoodlbl(iparamObj:X-SelectGood).
      565         display-goods () .
      566         val-goods () .
      567         if paramform:temp-param-goods <> ""
      568         then do:
      569            display-count-other () .
      570         end.
      571         else
      572            goodseditor:visible = no.
      573         if iparamObj:params-only-mode  = 'ПРОСМОТР':U
      574         then
      575            SelectGood_disable = "*".
      576      end method .
      577      method public character  AssignParam ():
      578      end method.
      579   end class.
