       26      define public property stype as class ibs.th.ref.sobj.stype no-undo
       27      get.
       28      set(iarg as ibs.th.ref.sobj.stype):
       29         stype = iarg.
       30         mTrgLoc:stype = iarg.
       31         radioButton1:text = iarg:SelectGoodLbl(1).
       32         radioButton2:text = iarg:SelectGoodLbl(2).
       33         radioButton3:text = iarg:SelectGoodLbl(3).
       34         radioButton4:text = iarg:SelectGoodLbl(4).
       35         radioButton5:text = iarg:SelectGoodLbl(5).
       36         radioButton6:text = iarg:SelectGoodLbl(6).
       37         radioButton7:text = iarg:SelectGoodLbl(7).
       38      end.
       39      define public property SelectGood as character  no-undo
       40      get:
       41         return if      radioButton1:checked
       42                then    radioButton1:text
       43                else if radioButton2:checked
       44                then    radioButton2:text
       45                else if radioButton3:checked
       46                then    radioButton3:text
       47                else if radioButton4:checked
       48                then    radioButton4:text
       49                else if radioButton5:checked
       50                then    radioButton5:text
       51                else if radioButton6:checked
       52                then    radioButton6:text
       53                else if radioButton7:checked
       54                then    radioButton7:text
       55                else "".
       56      end.
       57      set (iarg as character  ):
       58         if      iarg eq radioButton1:text
       59         then            radioButton1:checked = yes .
       60         else if iarg eq radioButton2:text
       61         then            radioButton2:checked = yes .
       62         else if iarg eq radioButton3:text
       63         then            radioButton3:checked = yes .
       64         else if iarg eq radioButton4:text
       65         then            radioButton4:checked = yes .
       66         else if iarg eq radioButton5:text
       67         then            radioButton5:checked = yes .
       68         else if iarg eq radioButton6:text
       69         then            radioButton6:checked = yes .
       70         else if iarg eq radioButton7:text
       71         then            radioButton7:checked = yes .
       72         else
       73            message "Нет поля " iarg
       74            view-as alert-box.
       75      end.
       76      define public property SelectGood_disable as character  no-undo
       77      set (iarg as character  ):
       78         define variable varg as character  no-undo.
       79         define variable vi as integer no-undo.
       80         if iarg eq "*" then iarg = "".
       81         do vi = 1 to 7:
       82            if lookup(string(vi),iarg) eq 0
       83            then do:
       84               varg = stype:SelectGoodLbl(vi)no-error.
       85               if      varg eq radioButton1:Text
       86               then            radioButton1:Enabled = no .
       87               else if varg eq radioButton2:Text
       88               then            radioButton2:Enabled = no .
       89               else if varg eq radioButton3:Text
       90               then            radioButton3:Enabled = no .
       91               else if varg eq radioButton4:Text
       92               then            radioButton4:Enabled = no .
       93               else if varg eq radioButton5:Text
       94               then            radioButton5:Enabled = no .
       95               else if varg eq radioButton6:Text
       96               then            radioButton6:Enabled = no .
       97               else if varg eq radioButton7:Text
       98               then            radioButton7:Enabled = no .
       99            end.
      100         end.
      101      end.
