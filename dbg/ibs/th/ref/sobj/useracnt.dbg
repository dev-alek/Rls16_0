        1   USING Progress.Lang.*.
        2   USING ibs.th.ref.sobj.*.
        3   BLOCK-LEVEL ON ERROR UNDO, THROW.
        4   CLASS ibs.th.ref.sobj.useracnt inherits sUserFrame:
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6     define variable v-cntxt-db-num        as integer   no-undo .
        7     define variable v-cntxt-userid        as character no-undo .
        8     define variable v-cntxt-level         as character no-undo .
        9     define variable v-cntxt-host-code-obj as integer   no-undo .
       10     define variable v-cntxt-obj-type      as character no-undo .
       11     define variable v-cntxt-obj-code      as integer   no-undo .
       12     define variable v-cntxt-db-num-obj    as integer   no-undo .
       13     define variable v-cntxt-is-admin      as logical   no-undo .
       14   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   def
       16   temp-table  obj-list no-undo
       17     field obj-type like ub.clients.obj-type
       18     field obj-code like ub.clients.obj-code
       19     field obj-name like ub.clients.obj-name
       20     field obj-id   as integer
       21     field db-num   as integer
       22     index pi is primary unique obj-id
       23     index ie1 obj-type obj-code
       24     index ie2 obj-name
       25   .
       26   define variable v-obj-code  as integer no-undo .
       27   define variable v-obj-type  as character no-undo .
       28   define buffer buf_c-user-log for c-user-log.
       29   define temp-table tt-user-account no-undo
       30   field user-id_  as character LABEL "ID"
       31   field user_name as character LABEL "Имя пользователя"
       32   field db-num    as integer   LABEL "БД "
       33   index pi db-num user-id_
       34   .
       35   define property query_user-account as handle no-undo
       36     public get.
       37     public set.
       38   constructor public useracnt ( ):
       39     super().
       40     create query query_user-account.
       41                  query_user-account:set-buffers(buffer tt-user-account:HANDLE).
       42                  query_user-account:query-prepare("FOR EACH tt-user-account").
       43                  query_user-account:query-open.
       44   for each user-obj where user-obj.obj-code = 1 ,
       45         each ub.user-account no-lock where ub.user-account.user-id = user-obj.user-id:
       46         create tt-user-account .
       47         assign
       48         tt-user-account.db-num = user-obj.obj-code
       49         tt-user-account.user-id_ = ub.user-account.user-id
       50         tt-user-account.user_name = "ID: " + ub.user-account.user-id
       51                                 + " ФИО: " + user-account.last-name
       52                                 + " "      + user-account.first-name
       53                                 + " "      + user-account.second-name
       54                                 .
       55   end.
       56   end constructor.
       57   END CLASS.
