      408      method public void params-only-mode_lookup( input ilookup as logical ):
      409         if ilookup
      410         then do:
      411            this-object:buttonCancel:text = '&Выход' .
      412            this-object:buttonOk:Visible  = no.
      413         end.
      414         else do:
      415            this-object:buttonOk:Text = '&Ввод' .
      416            this-object:buttonCancel:text = '&Отмена' .
      417         end.
      418         return.
      419      end method.
