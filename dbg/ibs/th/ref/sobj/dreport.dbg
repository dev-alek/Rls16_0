      273   method void proc-alt-shift-f2 ():
      274     if not ibs.th.gbl.gbl-var:rcode
      275   then
      276     run gbl\inidebug.p .
      277   end.
      278   method void proc-alt-shift-f3 ():
      279      define variable vdebugalert   as logical no-undo .
      280      assign
      281         vdebugalert = session:debug-alert
      282         session:debug-alert = yes
      283      .
      284   message program-name( 1 ) skip( 1 )
      285             vss-revision                  skip( 0 )
      286             vss-author                    skip( 0 )
      287             vss-date                      skip( 0 )
      288             vss-workfile                  skip( 0 )
      289             vss-archive                   skip( 1 )
      290             vss-description               skip( 1 )
      291     view-as alert-box title "Текущая программа".
      292     session:debug-alert = vdebugalert.
      293   end.
      294   define variable v-inform-launched as logical no-undo initial false .
      295   method void proc-alt-shift-f4 ():
      296   end.
      297   method void proc-alt-f1 ():
      298   end .
      299   method private void obj_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      300         if   e:KeyCode = System.Windows.Forms.Keys:F3 and e:Shift and e:Alt
      301         then do:
      302             proc-alt-shift-f3 ().
      303         end.
      304         else if   e:KeyCode = System.Windows.Forms.Keys:F2 and e:Shift and e:Alt
      305         then do:
      306             proc-alt-shift-f2 ().
      307         end.
      308   end method.
      309   method private void End_obj_KeyDown():
      310   catch e as Progress.Lang.Error:
      311            undo, throw e.
      312         end catch.
      313   end method.
      314   method private void date_KeyDown( input sender as System.Object, input e as System.Windows.Forms.KeyEventArgs ):
      315      define variable vdate as System.Windows.Forms.DateTimePicker no-undo.
      316      define variable v-curr-sv-date as date no-undo .
      317      define variable v-new-sv-date  as date no-undo .
      318      if   e:KeyCode = System.Windows.Forms.Keys:D and e:Control
      319      then do:
      320         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      321         run gbl/getcurdt.p
      322            (output v-curr-sv-date
      323         ) .
      324         vdate:value = v-curr-sv-date.
      325      end.
      326      else if   e:KeyCode = System.Windows.Forms.Keys:B and e:Control
      327      then do:
      328         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      329         v-curr-sv-date = vdate:value .
      330         if v-curr-sv-date = ?
      331         then do:
      332            run gbl/getcurdt.p
      333               (output v-curr-sv-date
      334            ) .
      335         end.
      336         if v-curr-sv-date <> ?
      337         then do:
      338            assign
      339               v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      340               vdate:value = v-new-sv-date
      341            .
      342         end.
      343      end.
      344      else if   e:KeyCode = System.Windows.Forms.Keys:E and e:Control
      345      then do:
      346         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      347         v-curr-sv-date = vdate:value.
      348         if v-curr-sv-date = ?
      349         then do:
      350            run gbl/getcurdt.p
      351               (output v-curr-sv-date
      352            ) .
      353         end.
      354         if v-curr-sv-date <> ?
      355         then do:
      356            run gbl/lastdate.p
      357               (input  v-curr-sv-date
      358               ,output v-new-sv-date
      359            ).
      360            vdate:value = v-new-sv-date.
      361         end.
      362      end.
      363      else if   e:KeyCode = System.Windows.Forms.Keys:F and e:Control
      364      then do:
      365         vdate = cast(sender ,System.Windows.Forms.DateTimePicker).
      366         define variable v-description   as character no-undo .
      367         define variable v-ok            as logical no-undo.
      368         v-curr-sv-date = vdate:value.
      369         if v-curr-sv-date = ?
      370         then do:
      371            run gbl/getcurdt.p
      372               (output v-curr-sv-date
      373            ) .
      374         end.
      375         if v-curr-sv-date <> ?
      376         then do:
      377            run gbl/d-inpday.w
      378               (input ?
      379               ,input "Выбор даты"
      380               ,input v-description
      381               ,input ""
      382               ,input-output v-curr-sv-date
      383               ,output v-ok
      384            ).
      385            if v-ok = true
      386            then do:
      387               vdate:value = v-curr-sv-date .
      388            end.
      389         end.
      390      end.
      391   end method.
      392   method private void End_date_KeyDown():
      393         catch e as Progress.Lang.Error:
      394            undo, throw e.
      395         end catch.
      396      end method.
