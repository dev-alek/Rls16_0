      370   constructor public sType(  ):
      371      SelectObjectRefresh().
      372      RadioTaskRefresh().
      373      SelectGoodRefresh().
      374      RadioSchetRefresh().
      375      RadioPeriodRefresh().
      376      SetPayTypeRefresh().
      377      SetValTypeRefresh().
      378      RadioCustomerRefresh().
      379   end.
      380   method public character typeLbl (ilist as character ,intType as integer ):
      381       find first tt-type where tt-type.list    eq ilist
      382                            and tt-type.codeint eq intType
      383                            no-error.
      384       return if available tt-type then tt-type.item else ?.
      385   end.
      386   method public character typeLbl (ilist as character ,charType as char ):
      387       find first tt-type where tt-type.list     eq ilist
      388                            and tt-type.codechar eq charType
      389                            no-error.
      390       return if available tt-type then tt-type.item else ?.
      391   end.
      392   method public integer typeInt (ilist as character ,chartype as character):
      393       find first tt-type where tt-type.list eq ilist
      394                            and tt-type.item eq charType
      395                            no-error.
      396       return if available tt-type then tt-type.codeint else ?.
      397   end.
      398   method public character  typechar (ilist as character ,chartype as character):
      399       find first tt-type where tt-type.list eq ilist
      400                            and tt-type.item eq charType
      401                            no-error.
      402       return if available tt-type then tt-type.codechar else ?.
      403   end.
      404   method public character  typechar (ilist as character ,inttype as integer):
      405       find first tt-type where tt-type.list eq ilist
      406                            and tt-type.codeint eq inttype
      407                            no-error.
      408       return if available tt-type then tt-type.codechar else ?.
      409   end.
      410   method public void  settypelbl (ilist as character ,inttype as integer,iVal as character ):
      411       find first tt-type where tt-type.list eq ilist
      412                            and tt-type.codeint eq inttype
      413                            no-error.
      414       if available tt-type
      415       then
      416         tt-type.item = iVal.
      417   end.
      418   method public void typeTable (ilist as character,output table ttTypeOut ):
      419       define variable vi as integer  no-undo.
      420       define buffer tt-type for tt-type.
      421       for each ttTypeOut:
      422           delete ttTypeOut.
      423       end.
      424       do vi = 1 to num-entries(ilist):
      425           for each tt-type where tt-type.list eq entry(vi,ilist):
      426               create ttTypeOut.
      427               buffer-copy tt-type to ttTypeOut.
      428           end.
      429       end.
      430   end.
      431   end class.
