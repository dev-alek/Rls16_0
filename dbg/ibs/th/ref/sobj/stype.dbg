       10    define temp-table tt-type
       11       field list  as character
       12       field item as character
       13       field codeint  as integer
       14       field codeChar  as character
       15    index  item     list item
       16    index  codeint  list codeint
       17    index  codeChar list codeChar
       18    .
       19    define temp-table ttTypeOut
       20       field list  as character
       21       field item as character
       22       field codeint  as integer
       23       field codeChar  as character
       24    index  item     list item
       25    index  codeint  list codeint
       26    index  codeChar list codeChar
