       28   define property SelectObjectListAll as character init "Все по фирме,Текущий,Выборочно,Все" no-undo
       29   get.
       30   define property SelectObjectCharall as character init "firm,currency,choice,all" no-undo
       31   get.
       32   define property SelectObjectList    as character  no-undo
       33       get():
       34          return if SelectObjectList = ""
       35                 then SelectObjectListAll
       36                 else SelectObjectList.
       37       end.
       38       private set(iarg as character):
       39          SelectObjectList = iarg.
       40          SelectObjectrefresh().
       41       end.
       42    method public void SelectObjectRefresh():
       43    define variable vi as integer  no-undo.
       44        for each tt-type  where tt-type.list  = "SelectObject" :
       45            delete tt-type.
       46        end.
       47        do vi = 1 to num-entries(SelectObjectList):
       48            create tt-type.
       49            assign
       50               tt-type.list     = "SelectObject".
       51               tt-type.item     = entry(vi,SelectObjectList).
       52               tt-type.codeInt  = lookup (tt-type.item, SelectObjectListAll).
       53               tt-type.codeChar = entry(tt-type.codeInt,SelectObjectCharall).
       54               tt-type.codeInt = tt-type.codeInt - 0
       55            .
       56       end.
       57   end.
       58   method public character SelectObjectLbl (intSts as integer ):
       59       return typeLbl("SelectObject",intSts).
       60   end.
       61   method public character SelectObjectLbl (charSts as character ):
       62       return typeLbl("SelectObject",charSts).
       63   end.
       64   method public integer SelectObjectInt (charSts as character):
       65       return typeInt("SelectObject",charSts).
       66   end.
       67   method public character  SelectObjectchar (charSts as character):
       68       return typechar("SelectObject",charSts).
       69   end.
       70   method public character  SelectObjectchar (icodeint as integer ):
       71       return typechar("SelectObject",icodeint).
       72   end.
