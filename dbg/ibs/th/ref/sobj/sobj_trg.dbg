        6   define temp-table userobjs_temp-user-obj no-undo
        7     field obj-type as character
        8     field obj-code as integer
        9     index xpk is primary unique obj-type obj-code
       10     .
       11   method private void userobjs_clear ():
       12     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       13     do
       14     on error undo, return error return-value
       15     :
       16       for each buf_userobjs_temp-user-obj
       17       on error undo, return error return-value
       18       :
       19         delete buf_userobjs_temp-user-obj .
       20       end.
       21     end.
       22   end .
       23   method private void userobjs_object-count (output p-total-count as integer ):
       24     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       25     do
       26     on error undo, return error return-value
       27     :
       28       assign
       29         p-total-count = 0
       30       .
       31       for each buf_userobjs_temp-user-obj
       32       on error undo, return error return-value
       33       :
       34         assign
       35           p-total-count = p-total-count + 1
       36         .
       37       end.
       38     end.
       39   end.
       40   method private void userobjs_append
       41     (p-obj-type as character,
       42      p-obj-code as integer):
       43     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       44     do
       45     on error undo, return error return-value
       46     :
       47       find first buf_userobjs_temp-user-obj
       48         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
       49           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
       50         no-error .
       51       if not available buf_userobjs_temp-user-obj
       52       then do:
       53         create buf_userobjs_temp-user-obj .
       54         assign
       55           buf_userobjs_temp-user-obj.obj-type = p-obj-type
       56           buf_userobjs_temp-user-obj.obj-code = p-obj-code
       57         .
       58       end.
       59     end.
       60   end.
       61   method private void userobjs_object-exist (output p-object-exist as logical):
       62     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       63     do
       64     on error undo, return error return-value
       65     :
       66       find first buf_userobjs_temp-user-obj
       67         no-error .
       68       if not available buf_userobjs_temp-user-obj
       69       then do:
       70         assign
       71           p-object-exist = false
       72         .
       73       end.
       74       else do:
       75         assign
       76           p-object-exist = true
       77         .
       78       end.
       79     end.
       80   end.
