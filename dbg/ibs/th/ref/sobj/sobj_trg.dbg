      170      method public void VALUE-CHANGED_SelectObject(iSelectObject as char):
      171         new-state ("SELECTOBJECT="  + iSelectObject).
      172      end.
      173      define variable mstr-obj# as character no-undo.
      174      define variable mstr-obj2# as character no-undo.
      175      define variable mstr-obj3# as character no-undo.
      176      method public void  sss ():
      177         define buffer buf_clients  for ub.clients .
      178         define buffer cli-obj      for ub.clients .
      179         define buffer buf_user-obj for ub.user-obj .
      180         define buffer buf_db       for ub.db .
      181         define buffer buf_store    for ub.store .
      182         define buffer buf_shop     for ub.shop .
      183         define buffer buf_sysconf  for ub.sysconf .
      184         if    not (Paramform:temp-param-obj = '*'
      185            or Lookup(string(4),  Paramform:temp-param-obj) > 0
      186            or Lookup(string(1), Paramform:temp-param-obj) > 0  )
      187         then do:
      188            message "Выполнить невозможно, смените текущий объект !" view-as alert-box error .
      189            return error.
      190         end.
      191         ParamObj:empty-obj-list().
      192         assign
      193            mstr-obj#  = ''
      194            mstr-obj2# = ''
      195            mstr-obj3# = ''
      196         .
      197         for each buf_user-obj no-lock
      198            where buf_user-obj.db-num  = ParamObj:my-cntxt-db-num
      199              and buf_user-obj.user-id = ParamObj:my-cntxt-userid ,
      200         each cli-obj no-lock
      201            where cli-obj.obj-type = buf_user-obj.obj-type
      202              and cli-obj.obj-code = buf_user-obj.obj-code
      203              and (   cli-obj.db-num           = ParamObj:my-cntxt-db-num
      204                   or ParamObj:my-cntxt-db-num = 0 )
      205         :
      206            find first buf_clients no-lock
      207                 where buf_clients.obj-type = buf_user-obj.obj-type
      208                   and buf_clients.obj-code = buf_user-obj.obj-code
      209            .
      210            if buf_clients.stts <> 0 then next.
      211            if     ParamForm:verify-send-check
      212               and buf_clients.db-num <> ParamObj:my-cntxt-db-num
      213               and ParamForm:all-object = false
      214            then do:
      215               find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
      216               if buf_db.send-check = false
      217               then do:
      218                  mstr-obj2# = mstr-obj2#  + " " + buf_clients.obj-name + ",".
      219                  next.
      220               end.
      221            end.
      222            if     ParamForm:temp-param-obj-type = 'shop':U
      223               and ParamForm:all-object = false
      224            then do:
      225               if buf_user-obj.obj-type = 'скл':U
      226               then do:
      227                  mstr-obj# = mstr-obj#  +  " " + buf_clients.obj-name + ",".
      228                  next.
      229               end.
      230            end.
      231            if    ParamForm:temp-param-obj-type = 'stock':U
      232               and ParamForm:all-object = false
      233            then do:
      234               if buf_user-obj.obj-type = 'маг':U
      235               then do:
      236                  mstr-obj# = mstr-obj#  +  " " +  buf_clients.obj-name + "," .
      237                  next.
      238               end.
      239            end.
      240            define variable vselectobject as character no-undo.
      241            vselectobject = sType:SelectObjectchar( ObjForm:selectobject).
      242            case buf_user-obj.obj-type:
      243               when 'скл':U then do:
      244                  find first buf_store where buf_store.obj-code = buf_user-obj.obj-code no-lock.
      245                  if     vSelectObject = "firm":U
      246                     and ParamForm:all-object = false
      247                  then do:
      248                     if buf_store.host-code <> ParamObj:my-cntxt-host-code-obj
      249                     then do:
      250                        mstr-obj3# = mstr-obj3#  + " " + buf_clients.obj-name + ",".
      251                        next.
      252                     end.
      253                  end.
      254                  find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
      255                  find first buf_clients no-lock where
      256                             buf_clients.obj-type = buf_user-obj.obj-type and
      257                             buf_clients.obj-code = buf_user-obj.obj-code no-error.
      258                  if buf_sysconf.base-code = ParamObj:my-base-code
      259                  then do:
      260                     ParamObj:create_obj-list(buf_user-obj.obj-type, buf_user-obj.obj-code).
      261                  end.
      262                  else do :
      263                     if ParamForm:all-object = false
      264                     then
      265                        mstr-obj# = mstr-obj#  +  " "  +  buf_clients.obj-name +  "," .
      266                     else do:
      267                        ParamObj:create_obj-list(buf_user-obj.obj-type, buf_user-obj.obj-code).
      268                     end.
      269                  end.
      270               end.
      271               when 'маг':U then  do:
      272                  find first buf_shop where buf_shop.obj-code = buf_user-obj.obj-code no-lock.
      273                  if     vselectobject = "firm":U
      274                     and ParamForm:all-object = false
      275                  then do:
      276                     if buf_shop.host-code <> ParamObj:my-cntxt-host-code-obj
      277                     then do:
      278                        mstr-obj3# = mstr-obj3#  + " " + buf_clients.obj-name + "," .
      279                        next.
      280                     end.
      281                  end.
      282                  find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
      283                  find first buf_clients no-lock where
      284                             buf_clients.obj-type = buf_user-obj.obj-type and
      285                             buf_clients.obj-code = buf_user-obj.obj-code no-error.
      286                  if buf_sysconf.base-code = ParamObj:my-base-code
      287                  then do:
      288                     ParamObj:create_obj-list(buf_user-obj.obj-type, buf_user-obj.obj-code).
      289                  end.
      290                  else do:
      291                     if ParamForm:all-object = false
      292                     then
      293                        mstr-obj# = mstr-obj#  +  " " +  buf_clients.obj-name +  "," .
      294                     else do:
      295                        ParamObj:create_obj-list(buf_user-obj.obj-type, buf_user-obj.obj-code).
      296                     end.
      297                  end.
      298               end.
      299            end case.
      300         end.
      301      end.
      302      method public void verify-check-currency ():
      303         define buffer buf_clients for ub.clients .
      304         define buffer buf_db for ub.db .
      305         define variable vselectobject as character no-undo.
      306         vselectobject = sType:SelectObjectchar( ObjForm:selectobject).
      307         if vselectobject = "currency":U
      308         then do:
      309            find first buf_clients no-lock where  buf_clients.obj-type = ParamObj:my-cntxt-obj-type and
      310                                                  buf_clients.obj-code = ParamObj:my-cntxt-obj-code no-error.
      311            if ParamForm:verify-send-check and buf_clients.db-num <> ParamObj:my-cntxt-db-num
      312            then do:
      313               find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
      314               if buf_db.send-check = false
      315               then do:
      316                  mstr-obj2# = mstr-obj2#  + " " + buf_clients.obj-name + ",".
      317                  ObjForm:selectobject = stype:SelectObjectLbl( "all":U) .
      318                  ObjForm:BtnObj:Enabled = false.
      319                  sss () .
      320                  return error.
      321               end.
      322            end.
      323         end.
      324      end.
      325      method public void verify-check ():
      326         define buffer buf_clients for ub.clients .
      327         define buffer buf_db for ub.db .
      328         find first buf_clients no-lock where
      329                    buf_clients.obj-type = ParamObj:my-cntxt-obj-TYPE and
      330                    buf_clients.obj-code = ParamObj:my-cntxt-obj-CODE
      331         no-error.
      332         if     ParamForm:Verify-send-check
      333            and buf_Clients.db-num <> ParamObj:my-cntxt-db-num
      334         then do:
      335            find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
      336            if buf_db.send-check = false
      337            then do:
      338               message 'Нельзя выбрать текущий объект !' view-as alert-box error.
      339               verify-check-currency ().
      340            end.
      341            else do:
      342               ParamObj:create_obj-list(buf_clients.obj-type, buf_clients.obj-code).
      343            end.
      344         end.
      345         else do:
      346            ParamObj:create_obj-list(buf_clients.obj-type, buf_clients.obj-code).
      347         end.
      348      end.
      349      method public void select-objects-proc ( imy-request as logical ):
      350         select-objects-proc (imy-request, no ).
      351      end.
      352      method public void select-objects-proc ( imy-request as logical, ialt as logical   ):
      353         define variable v-ii as integer   no-undo .
      354         def buffer cli-obj  for ub.clients .
      355         ParamObj:empty-obj-list().
      356         assign
      357            mstr-obj#  = ""
      358            mstr-obj2# = ""
      359            mstr-obj3# = ""
      360         .
      361         define variable vselectobject as character no-undo.
      362         vselectobject = sType:SelectObjectchar( ObjForm:selectobject).
      363         case vselectobject :
      364            when "currency":U then do:
      365               verify-check ().
      366            end.
      367            when "all":U then   do:
      368               sss().
      369            end.
      370            when "all" then   do:
      371               sss().
      372            end.
      373            when "firm":U then   do:
      374               sss().
      375            end.
      376            when "choice":U then do:
      377               define variable v-object-exist as logical   no-undo .
      378   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   userobjs_object-exist
      380     (output v-object-exist
      381     )  .
      382               if ialt
      383               then do:
      384                  if     not paramform:params-only
      385                     and     v-object-exist = false
      386                  then do:
      387   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388      userobjs_append
      389     (input  ParamObj:my-cntxt-obj-type
      390     ,input  ParamObj:my-cntxt-obj-code
      391     )  .
      392                     v-object-exist = true .
      393                  end.
      394               end.
      395               if    imy-request    = false
      396                  or v-object-exist = false
      397               then do:
      398                  define variable v-user-select as logical   no-undo .
      399                  define variable v-recids      as character no-undo .
      400                  if paramform:params-only
      401                  then do:
      402                     thobjs
      403                       ( input ParamObj:my-handle
      404                       , input (if ParamObj:params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
      405                       , input "all":U
      406                       , input ''
      407                       , input ?
      408                       , input ?
      409                       , input-output v-recids ) no-error .
      410                  end.
      411                  else do:
      412   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   userobjs_select-many
      414     (input  ParamObj:my-handle
      415     ,input  ParamObj:my-cntxt-db-num
      416     ,input  ParamObj:my-cntxt-userid
      417     ,input  ParamObj:my-cntxt-host-code-obj
      418     ,input  ParamObj:my-cntxt-obj-type
      419     ,input  ParamObj:my-cntxt-obj-code
      420     ,output v-user-select
      421     )  .
      422                  end.
      423               end.
      424               imy-request = true .
      425   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   userobjs_object-exist
      427     (output v-object-exist
      428     )  .
      429               if v-object-exist = false
      430               then do:
      431                  if    ParamForm:temp-param-obj-type = 'shop':u
      432                     or ParamForm:temp-param-obj-type = 'stock':u
      433                  then do:
      434                     ObjForm:selectobject = stype:SelectObjectLbl( "firm":U) .
      435                  end.
      436                  else do:
      437                     ObjForm:selectobject = stype:SelectObjectLbl( if ialt then "not":u else "currency":U)  .
      438                  end.
      439                  ObjForm:BtnObj:Enabled = false.
      440                  find cli-obj where cli-obj.obj-type = ParamObj:my-cntxt-obj-type and
      441                                     cli-obj.obj-code = ParamObj:my-cntxt-obj-code no-lock .
      442                  if    ParamForm:temp-param-obj-type = 'shop':u
      443                     or ParamForm:temp-param-obj-type = 'stock':u
      444                  then do:
      445                     sss().
      446                  end.
      447                  else do:
      448                     if ialt then do:
      449                        verify-check().
      450                     end.
      451                  end.
      452               end.
      453               else do:
      454                  define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      455                  define buffer buf_clients for ub.clients .
      456                  define buffer buf_db for ub.db .
      457                  define buffer buf_shop for ub.shop .
      458                  define buffer buf_store for ub.store .
      459                  define buffer buf_sysconf for ub.sysconf .
      460                  for each buf_userobjs_temp-user-obj
      461                  :
      462                     find first buf_clients no-lock
      463                          where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
      464                            and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
      465                     .
      466                     if     ParamForm:verify-send-check
      467                        and buf_clients.db-num <> paramObj:my-cntxt-db-num
      468                        and ParamForm:all-object = false
      469                     then do:
      470                        find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
      471                        if buf_db.send-check = false
      472                        then do:
      473                           mstr-obj2# = mstr-obj2#  + " " + buf_clients.obj-name + ",".
      474                           next.
      475                        end.
      476                     end.
      477                     if     ParamForm:temp-param-obj-type = 'shop':u
      478                        and ParamForm:all-object = false
      479                     then do:
      480                        if buf_userobjs_temp-user-obj.obj-type = 'скл':U
      481                        then do:
      482                           mstr-obj# = mstr-obj#  +  " " +  buf_clients.obj-name  .
      483                           next.
      484                        end.
      485                     end.
      486                     if     ParamForm:temp-param-obj-type = 'stock':u
      487                        and ParamForm:all-object = false
      488                     then do:
      489                        if buf_userobjs_temp-user-obj.obj-type = 'маг':U
