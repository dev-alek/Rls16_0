      498                           find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
      499                           find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
      500                           find first buf_clients no-lock where
      501                                      buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
      502                                      buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
      503                           .
      504                           if    buf_sysconf.base-code = base-code
      505                              or ParamForm:all-object = true
      506                           then do:
      507                              paramobj:create_obj-list(buf_userobjs_temp-user-obj.obj-type,  buf_userobjs_temp-user-obj.obj-code).
      508                           end.
      509                           else do:
      510                              mstr-obj# = mstr-obj#  +  " " +  buf_clients.obj-name + "," .
      511                           end.
      512                        end.
      513                        when 'маг':U
      514                        then do:
      515                           find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
      516                           find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
      517                           find first buf_clients no-lock where
      518                                      buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
      519                                      buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
      520                           if     buf_sysconf.base-code = base-code
      521                               or ParamForm:all-object = true
      522                           then do:
      523                              paramobj:create_obj-list(buf_userobjs_temp-user-obj.obj-type,  buf_userobjs_temp-user-obj.obj-code).
      524                           end.
      525                           else do:
      526                              mstr-obj# = mstr-obj#  +  " " +  buf_clients.obj-name + "," .
      527                           end.
      528                        end.
      529                     end case.
      530                  end.
      531               end.
      532            end.
      533         end case.
      534      end.
      535      method private void new-state(istate as character ):
