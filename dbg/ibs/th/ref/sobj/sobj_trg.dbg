      537      method public void verify-obj ():
      538         if ParamForm:temp-param-obj <> ""
      539         then do:
      540            if ObjForm:selectobject = stype:SelectObjectLbl("choice":U) then do:
      541               select-objects-proc(true,no).
      542            end.
      543            if not paramObj:can-find-obj-list()
      544            then do:
      545               message "Не выбран объект !" skip
      546                  "Объекты не включенные в список" mstr-obj#    skip
      547                  mstr-obj2#   skip
      548                  mstr-obj3#   skip
      549                  view-as alert-box error.
      550               return error.
      551            end.
      552         end.
      553      end.
      554      method public logical set_SelectObject (iSelectObject as character ):
      555         paramobj:x-SelectObject = stype:SelectObjectChar(iSelectObject).
      556      end method.
      557      method public logical set_TextLb (itext as character ):
      558         paramobj:x-text-Obj = itext.
      559      end method.
      560      method public character  Assign-frame(iSelectObject as character):
      561         define variable vSelectObject as character no-undo.
      562         define variable t-str as character no-undo.
      563         paramobj:CheckAndUpNameObjList().
      564         if ParamForm:temp-param-obj = ""
      565         then ParamObj:strobj = ''.
      566         else do:
      567            vSelectObject = stype:SelectObjectChar(iSelectObject).
      568            t-str= '' .
      569            if paramForm:temp-param-Alon
      570            then do:
      571               if vSelectObject = "all":U           then sss().
      572               if vSelectObject = "firm":U      then sss().
      573               if vSelectObject = "currency":U  then select-objects-proc (no).
      574           end.
      575           case vSelectObject:
      576             when "all":U then t-str = " По всем объектам ".
      577             when "firm":U then t-str = " Все по фирме ".
      578             otherwise do:
      579                 t-str = paramObj:get-obj-List-text().
      580             end.
      581          end case.
      582          paramobj:strobj = paramobj:x-text-Obj + ": " + t-str.
      583          if mstr-obj# <> "" then
      584             paramobj:strobj = paramobj:strobj  + chr(10) + "Не включены в список : " + mstr-obj# .
      585          if mstr-obj2# <> "" then
      586             paramobj:strobj = paramobj:strobj   + chr(10) +  "Нет информации о чеках на объектах : " + mstr-obj2# .
      587          if mstr-obj3# <> "" then do:
      588             if not vSelectObject = "firm":U then do:
      589                paramobj:strobj = paramobj:strobj   + chr(10) +  "Не текущая фирма : " + mstr-obj3# .
      590             end.
      591          end.
      592        end.
      593        return paramobj:strobj.
      594      end.
      595      constructor public sObj_trg (  ):
      596         super ().
      597      end constructor.
      598      destructor public sObj_trg ( ):
      599      end destructor.
      600   end class.
