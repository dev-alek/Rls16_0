        1   USING Progress.Lang.*.
        2   using ibs.th.ref.sobj.*.
        3   BLOCK-LEVEL ON ERROR UNDO, THROW.
        4   CLASS ibs.th.ref.sobj.usertable :
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6     define variable v-cntxt-db-num        as integer   no-undo .
        7     define variable v-cntxt-userid        as character no-undo .
        8     define variable v-cntxt-level         as character no-undo .
        9     define variable v-cntxt-host-code-obj as integer   no-undo .
       10     define variable v-cntxt-obj-type      as character no-undo .
       11     define variable v-cntxt-obj-code      as integer   no-undo .
       12     define variable v-cntxt-db-num-obj    as integer   no-undo .
       13     define variable v-cntxt-is-admin      as logical   no-undo .
       14   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   def
       16   temp-table  obj-list no-undo
       17     field obj-type like ub.clients.obj-type
       18     field obj-code like ub.clients.obj-code
       19     field obj-name like ub.clients.obj-name
       20     field obj-id   as integer
       21     field db-num   as integer
       22     index pi is primary unique obj-id
       23     index ie1 obj-type obj-code
       24     index ie2 obj-name
       25   .
       26   method public void empty-obj-list ():
       27      for each obj-list :
       28         delete obj-list.
       29      end.
       30   end.
       31   method public logical can-find-obj-list ():
       32      return can-find (first obj-list no-lock).
       33   end.
       34   method public void get-obj-list (output table obj-list bind):
       35   end.
       36   method public void set-obj-list (input table obj-list bind):
       37   end.
       38   method public void create_obj-list (p-obj-type as char, p-obj-code as integer ):
       39      do
       40      on error undo, return error return-value
       41      :
       42         define buffer cli-obj for ub.clients .
       43         define variable p-var as integer no-undo .
       44         define buffer buf_obj-list for obj-list .
       45         find last buf_obj-list  use-index pi no-error .
       46         if available buf_obj-list
       47         then
       48            p-var = buf_obj-list.obj-id + 1.
       49         else
       50            p-var = 1.
       51         find first cli-obj where
       52                   cli-obj.obj-type = p-obj-type
       53               and cli-obj.obj-code = p-obj-code
       54         no-lock no-error.
       55         if available cli-obj
       56         then do:
       57            create buf_obj-list.
       58            assign
       59               buf_obj-list.obj-id   = p-var
       60               buf_obj-list.obj-code = cli-obj.obj-code
       61               buf_obj-list.obj-type = cli-obj.obj-type
       62               buf_obj-list.obj-name = cli-obj.obj-name
       63               buf_obj-list.db-num   = cli-obj.db-num
       64            .
       65         end.
       66      end.
       67   end.
       68    define temp-table tt-user-account no-undo
       69   field user-id_  as character LABEL "ID"
       70   field user_name as character LABEL "Имя пользователя"
       71   field db-num    as integer   LABEL "БД "
       72   field flg       as logical   LABEL "*" format "*/"
       73   field flg2      as logical
       74   index pi db-num user-id_
       75   .
       76   define temp-table tt-objects  no-undo
       77   field name_ as character
       78   field table_ as character
       79   field flg    as logical  LABEL "*" format "*/"
       80   field flg2   as int
       81   .
       82   define temp-table tt-user-account2 no-undo
       83   field user-id_  as character LABEL "ID"
       84   field user_name as character LABEL "Имя пользователя"
       85   field db-num    as integer   LABEL "БД "
       86   field flg       as logical   LABEL "*" format "*/"
       87   field flg2      as logical
       88   index pi db-num user-id_
       89   .
       90   define temp-table tt-objects2  no-undo
       91   field name_ as character
       92   field table_ as character
       93   field flg    as logical  LABEL "*" format "*/"
       94   field flg2   as int
       95   .
       96   define variable v-user-table-name as character no-undo .
       97   define variable v-user-table      as character no-undo .
       98   define variable v-table           as character no-undo .
       99   define buffer buf_tt-user-account2 for tt-user-account2  .
      100   DEFINE VARIABLE mform  AS CLASS ibs.th.ref.sobj.userhist no-undo.
      101   define property query_user-table as handle no-undo
      102     public get.
      103     public set.
      104   define property query_user-account as handle no-undo
      105     public get.
      106     public set.
      107   constructor public usertable (iform as class ibs.th.ref.sobj.userhist ):
      108   super().
      109   mform = iform.
      110     create query query_user-table.
      111                  query_user-table:set-buffers(buffer tt-objects:HANDLE).
      112                  query_user-table:query-prepare("FOR EACH tt-objects BY tt-objects.name_ ").
      113                  query_user-table:query-open.
      114     create query query_user-account.
      115                  query_user-account:set-buffers(buffer tt-user-account:HANDLE).
      116                  query_user-account:query-prepare("FOR EACH tt-user-account BY tt-user-account.user_name ").
      117                  query_user-account:query-open.
      118   end constructor.
      119   METHOD public void init_tt():
      120   mform:ParamObj:get-obj-list(output table obj-list).
      121   for each user-obj  ,
      122         each ub.user-account no-lock where ub.user-account.user-id = user-obj.user-id:
      123            find first tt-user-account where tt-user-account.user-id_ = ub.user-account.user-id and tt-user-account.flg2 = yes  no-error.
      124               if  not AVAILABLE tt-user-account then do:
      125               create tt-user-account .
      126               assign
      127               tt-user-account.db-num    = user-obj.db-num
      128               tt-user-account.user-id_  = ub.user-account.user-id
      129               tt-user-account.user_name =
      130                                 user-account.last-name
      131                                 + " "      + user-account.first-name
      132                                 + " "      + user-account.second-name
      133               tt-user-account.flg2 = yes
      134               .
      135            end.
      136   end.
      137   if mform:ParamObj:x-SelectObject <> "firm" then do:
      138    for each tt-user-account  :
      139       find first obj-list where tt-user-account.db-num = obj-list.db-num no-error.
      140         if not AVAILABLE obj-list then
      141            do:
      142               delete tt-user-account .
      143            end.
      144   END.
      145   END.
      146    EMPTY TEMP-TABLE tt-objects.
      147   for each c-user-log no-lock
      148       where c-user-log.corr-date >= mform:ParamObj:x-Date-Start and c-user-log.corr-date <= mform:ParamObj:x-Date-End
      149       by c-user-log.head-table :
      150       v-table = c-user-log.head-table .
      151       if v-table begins "c-" and v-table <> 'c-usr-hist':U and v-table <> 'c-plc-hist':U
      152        then  do:
      153            v-user-table = replace(v-table,"c-","").
      154        end.
      155        else v-user-table = v-table .
      156        find first tt-objects where tt-objects.table_ = v-user-table and tt-objects.flg2 =  1 no-error .
      157        if not AVAILABLE (tt-objects) then
      158           do:
      159   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   run tblnmusr in ibs.th.gbl.gbl-hndllib:g#library
      161     (input  v-user-table
      162     ,output v-user-table-name
      163     )  .
      164           create tt-objects .
      165               assign
      166               tt-objects.table_ = v-user-table
      167               tt-objects.name_  = v-user-table-name
      168               tt-objects.flg2 =  1
      169               .
      170        end.
      171   end.
      172   for each tt-objects  :
      173       find first tt-objects2 where tt-objects2.table_ = tt-objects.table_ and tt-objects2.flg = yes no-error .
      174       if AVAILABLE (tt-objects2) then
      175       do:
      176               assign
      177               tt-objects.flg =  yes
      178               .
      179        end.
      180   end.
      181    empty TEMP-TABLE tt-objects2.
      182   for each tt-objects  :
      183        create tt-objects2 .
      184        buffer-copy tt-objects to tt-objects2 .
      185   end.
      186   END METHOD.
      187   METHOD public void mark_user():
      188       tt-user-account.flg = not tt-user-account.flg .
      189   END METHOD.
      190   METHOD public void mark_user_all():
      191         for each tt-user-account  :
      192               tt-user-account.flg = yes .
      193         end.
      194   END METHOD.
      195   METHOD public void mark_table():
      196       tt-objects.flg = not tt-objects.flg .
      197       for each tt-objects2 where tt-objects.table_ =  tt-objects2.table_ :
      198       tt-objects2.flg = not tt-objects2.flg .
      199       end.
      200   END METHOD.
      201   METHOD public void mark_table_all():
      202       for each tt-objects  :
      203       tt-objects.flg = yes.
      204       end.
      205       for each tt-objects2  :
      206       tt-objects2.flg = yes .
      207       end.
      208   END METHOD.
      209   METHOD public void my_report():
      210   empty TEMP-TABLE tt-user-account2.
      211   for each tt-user-account  :
      212        create tt-user-account2 .
      213        buffer-copy tt-user-account to tt-user-account2 .
      214   end.
      215   find first tt-user-account where tt-user-account.flg = yes no-error.
      216   if AVAILABLE tt-user-account then do:
      217     for each tt-user-account  :
      218         if   tt-user-account.flg = no then delete tt-user-account .
      219     end.
      220   end.
      221   empty TEMP-TABLE tt-objects2.
      222   for each tt-objects  :
      223        create tt-objects2 .
      224        buffer-copy tt-objects to tt-objects2 .
      225   end.
      226   find first tt-objects where tt-objects.flg = yes no-error.
      227   if AVAILABLE tt-objects then do:
      228      for each tt-objects  :
      229        if   tt-objects.flg = no then delete tt-objects .
      230      end.
      231   end.
      232   run rep/r-hist-sysadm.p
      233            (input mform:ParamObj:my-handle,
      234             input mform:ParamObj:x-Date-Start,
      235             input mform:ParamObj:x-Date-End,
      236             input table tt-user-account BY-REFERENCE,
      237             input table tt-objects      BY-REFERENCE ) .
      238   empty TEMP-TABLE tt-user-account.
      239   for each tt-user-account2:
      240        create tt-user-account .
      241        buffer-copy tt-user-account2 to tt-user-account .
      242   end.
      243   empty TEMP-TABLE tt-objects.
      244   for each tt-objects2:
      245        create tt-objects.
      246        buffer-copy tt-objects2 to tt-objects .
      247   end.
      248   END METHOD.
      249   END CLASS.
