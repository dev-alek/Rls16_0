      214   method private handle pascur ():
      215   define buffer  Buf_user for  _user.
      216    find first gPasSysAdm no-error.
      217    if not available gPasSysAdm then crpas().
      218    define variable vReturn as handle no-undo.
      219    find first Buf_user
      220              where Buf_user._userid    = mloginsysadm
      221              no-error
      222              .
      223      if available Buf_user
      224      then do:
      225          block-pas:
      226          for each gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-lock:
      227             if Buf_user._password eq encode(gpasSysadm.pasw)
      228             then
      229                leave block-pas.
      230          end.
      231      end.
      232      release Buf_user.
      233      if not available gPasSysAdm
      234      then
      235         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      236      vReturn = buffer gPasSysAdm:handle.
      237      return vReturn.
      238   end.
      239   method private handle pasNew ():
      240      define buffer  sys-ctrl for ub.sys-ctrl.
      241      define buffer  upgrade for ub.upgrade.
      242      define buffer  upgrade-attr for ub.upgrade-attr.
      243      find first gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm no-error.
      244      if not available gPasSysAdm then crpas().
      245      define variable vReturn as handle no-undo.
      246      find first sys-ctrl no-lock .
      247      block-upg:
      248      for each  upgrade  where upgrade.db-num = sys-ctrl.db-num
      249      no-lock
      250       by upgrade.db-num descending by upgrade.step-num descending
      251          :
      252        leave block-upg.
      253      end.
      254      find first upgrade-attr no-lock where
      255                 upgrade-attr.db-num      = upgrade.db-num and
      256                 upgrade-attr.version-num = upgrade.version-num and
      257                 upgrade-attr.attr-code   = "releace" no-error .
      258      find first  gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm and
      259                                   gPasSysAdm.num eq integer (upgrade-attr.attr-value) no-lock no-error.
      260      release sys-ctrl.
      261      release upgrade.
      262      release upgrade-attr.
      263      if not available gPasSysAdm
      264      then
      265         find last gPasSysAdm where gPasSysAdm.fLogin eq mloginsysadm.
      266      vReturn = buffer gPasSysAdm:handle.
      267      return vReturn.
      268   end.
