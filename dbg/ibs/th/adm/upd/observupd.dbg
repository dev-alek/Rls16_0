      421     define property upd-df as character no-undo
      422     get():
      423       return if extent (m-upd-list-df) > CurrDBShm
      424              then m-upd-list-df[CurrDBShm + 1]
      425              else "".
      426     end.
      427     constructor observupd ():
      428       define buffer buf_sys-ctrl for ub.sys-ctrl.
      429       define buffer buf_db for ub.db.
      430       define variable vVerStuct as integer no-undo.
      431       define variable vVerDB    as integer no-undo.
      432       TargetDBShm = extent(m-upd-list-df).
      433       find first buf_sys-ctrl no-lock no-error.
      434       if available buf_sys-ctrl
      435       then do:
      436          DbNum = buf_sys-ctrl.db-num.
      437          find first buf_db no-lock where buf_db.db-num = DbNum no-error.
      438          if available buf_db
      439          then do:
      440             if buf_db.reserve1-char begins "updto:"
      441             then
      442                vVerStuct = integer (substring(buf_db.reserve1-char,7)) no-error.
      443             else
      444                vVerStuct = integer (buf_db.reserve1-char) no-error.
      445          end.
      446       end.
      447       find first _file no-lock where _file._file-name = "db"  no-error.
      448       if available _file
      449       then do:
      450          find first _field of _file where _field._Field-Name =  "reserve1-char" no-lock no-error.
      451          if available (_field)
      452          then do:
      453             vVerDB = integer (_field._initial) no-error.
      454             release _field.
      455          end.
      456          release _file.
      457       end.
      458       CurrDBShm = max(vVerDB,vVerStuct).
      459       find first buf_db no-lock where buf_db.db-num = 0 no-error.
      460       if available buf_db
      461       then do:
      462          if buf_db.reserve1-char begins "updto:"
      463          then
      464             CurrDB0Shm = integer (substring(buf_db.reserve1-char,7)) no-error.
      465          else
      466             CurrDB0Shm = integer (buf_db.reserve1-char) no-error.
      467       end.
      468       pwd = pasCur()::pasw.
      469       release buf_db.
      470       release buf_sys-ctrl.
      471     end.
      472     method public void dbexcept( input-output inListDb as char, input inTableName as char ):
      473       def var ii as int no-undo.
      474       def var iDB as int no-undo.
      475       def var numentr as int no-undo.
      476       def var newListDB as char no-undo init "NULL".
      477       def var dBShm0 as integer no-undo.
      478       def var TempInt as integer no-undo.
      479       define buffer buf_db for ub.db.
      480       if DbNum <> 0
      481           then return.
      482       dbShm0 = CurrDB0Shm.
      483       numentr = num-entries (inListDb, chr(1)) no-error.
      484       if numentr = ?
      485       then do:
      486         return .
      487       end.
      488       if lookup (inTableName, List1) > 0
      489       then do:
      490         do ii = 1 to numentr:
      491           TempInt = 0.
      492           iDB = integer (entry (ii, inListDb, chr(1) )) no-error.
      493           for each buf_db where buf_db.db-num = iDB and buf_db.db-num <> 0:
      494              if buf_db.reserve1-char begins "updto:"
      495              then
      496                 TempInt = integer (substring(buf_db.reserve1-char,7)) no-error.
      497              else
      498                 TempInt = integer (buf_db.reserve1-char) no-error.
      499             if TempInt = ?
      500               then TempInt = 0.
      501             if TempInt = 1
      502             then do:
      503               if newListDB = "NULL"
      504                 then newListDB = "".
      505               newListDB = newListDB + chr(1) + string (iDB).
      506             end.
      507           end.
      508         end.
      509         inListDb = trim (newListDB, chr(1)).
      510       end.
      511       return.
      512     end method.
      513     method private logical chkdbforupd ():
      514       define variable v-process-id   as integer   no-undo.
      515       define variable v-process-list as character no-undo.
      516       define variable vUserIgnor     as character no-undo.
      517       define buffer buf_thbj-attr for ub.thbj-attr.
      518       run gbl/getprcid.p ( output v-process-id ) no-error.
      519       if error-status:error
      520       then do:
      521         Msg = ( "Невозможно получить PID процесса. Обновление схемы БД невозможно. Работа с ней запрещена!" ).
      522         IsErr = true.
      523         return false.
      524       end.
      525       find first buf_thbj-attr no-lock
      526          where buf_thbj-attr.obj-type        = 'БД':U
      527            and buf_thbj-attr.obj-code        = DbNum
      528            and buf_thbj-attr.upper-prop-code = 'auto-task':U
      529            and buf_thbj-attr.prop-code       = 'user-list':U
      530       no-error.
      531       if available buf_thbj-attr
      532       then do:
      533          vUserIgnor = buf_thbj-attr.property-value-character.
      534          release buf_thbj-attr.
      535       end.
      536       else
      537          vUserIgnor = "nws".
      538       for each _Connect where _Connect._Connect-Type = "REMC"
      539                           and _Connect._Connect-Pid <> ?
      540                           and _Connect._Connect-Pid <> v-process-id
      541                           and not can-do(vUserIgnor,_Connect._Connect-Name)
      542       no-lock:
      543         v-process-list = v-process-list + chr(10) + string (_Connect._Connect-Pid) + " - " + _Connect._Connect-Name +  " - " + _Connect._Connect-Device.
      544       end.
      545       if v-process-list <> ""
      546       then do:
      547         Msg = substitute ( "Для обновления схемы БД завершите процессы. &1",  v-process-list).
      548         IsErr = true.
      549         return false.
      550       end.
      551       return true.
      552     end.
      553     method public void writeResult (input inShm as integer):
      554       define variable vI       as integer no-undo.
      555       define variable vStrChk  as character no-undo.
      556       define variable vAttr    as character no-undo.
      557       define variable vSearch  as character no-undo.
      558       define variable vValue   as character no-undo.
      559       define variable vProc    as character no-undo.
      560       define variable vparam   as character no-undo.
      561       define variable vOK      as logical   no-undo.
      562       define variable VTestStr as character no-undo.
      563       define variable vrunProc as logical   no-undo.
      564       define buffer buf_db for ub.db.
      565       define buffer buf_sys-ctrl for ub.sys-ctrl.
      566       on write of ub.db override do: end.
      567       if inShm > 0
      568       then do:
      569       VTestStr = m-upd-list-chk[inShm] .
      570          do vi = 1 to num-entries(VTestStr):
      571            assign
      572              vStrChk = entry(vi,VTestStr)
      573              vattr   = ""
      574              vValue  = ""
      575              vSearch = entry(1,vStrChk,":")
      576              vStrChk = substring(vStrChk,length(vSearch) + 2)
      577              vValue  = entry (2,vStrChk,"=")
      578              vStrChk = entry (1,vStrChk,"=")
      579            no-error.
      580            if    can-do("Desc,Help,Valmsg,Valexp,Order,Column-label,Decimals,Extent,Data-Type,Initial,Mandatory,inactive",vSearch)
      581            then assign
      582               vattr = "_" + vSearch
      583               vSearch = "FIELD".
      584             .
      585            if vSearch eq "proc"
      586            then do:
      587               assign
      588                  vProc  = entry(1,vStrChk,";")
      589                  vParam = entry(2,vStrChk,";")
      590               no-error.
      591               if SearchPFile (vProc) eq ?
      592               then do:
      593                  Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. Не найден файл '&2' . Работа с ней запрещена!",inShm,Vproc ).
      594                  IsErr = true.
      595                  return.
      596               end.
      597               run value(vProc) (vParam, output vOk) no-error.
      598               if not vOk
      599               then do:
      600                  Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. Не прошла провека '&2' c параметрром '&3' . Работа с ней запрещена!",inShm,Vproc,vParam ).
      601                  IsErr = true.
      602                  return.
      603               end.
      604               else
      605                  vrunProc = yes.
      606            end.
      607            else if vSearch eq "TABLE"
      608            then do:
      609              find first _file no-lock where _file._file-name = vStrChk  no-error.
      610              if not available (_file)
      611              then do:
      612                Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. Отсутствует таблица &2. Работа с ней запрещена!",inShm,vStrChk ).
      613                IsErr = true.
      614                return.
      615              end.
      616            end.
      617            else if vSearch eq "SEQUENCE"
      618            then do:
      619              find first _Sequence no-lock where _Sequence._Seq-Name = vStrChk  no-error.
      620              if not available (_Sequence)
      621              then do:
      622                Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. Отсутствует Sequence &2. Работа с ней запрещена!",inShm,vStrChk ).
      623                IsErr = true.
      624                return.
      625              end.
      626            end.
      627            else if vSearch eq "FIELD"
      628            then do:
      629              find first _file no-lock where _file._file-name = entry(1,vStrChk,".")  no-error.
      630              if available _file
      631              then
      632                 find first _field of _file where _field._Field-Name =  entry(2,vStrChk,".") no-lock no-error.
      633              if not available (_field)
      634              then do:
      635                Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. Отсутствует поле &2. Работа с ней запрещена!", inShm,vStrChk ).
      636                IsErr = true.
      637                return.
      638              end.
      639              else do:
      640                define variable vBuffHandle as handle no-undo.
      641                vBuffHandle = buffer _field:handle.
      642                if     vattr ne ""
      643                   and vBuffHandle:buffer-field(vattr):buffer-value ne vvalue
      644                then do:
      645                  Msg = substitute ( "Обновление схемы БД до версии &1 завершилось неудачно. У поля &2 реквизит &3 не равен &4. Работа с ней запрещена!", inShm,vStrChk,vAttr,vValue ).
      646                  IsErr = true.
      647                  return.
      648                end.
      649              end.
      650            end.
      651          end.
      652       end.
      653       if not iscomp
      654       then do:
      655          find first buf_sys-ctrl no-lock no-error.
      656          if available buf_sys-ctrl
      657          then do:
      658             find first buf_db exclusive-lock where buf_db.db-num = buf_sys-ctrl.db-num no-error.
      659             buf_db.reserve1-char = "updto:" + string (inShm).
      660             CurrDBShm = inShm.
      661             buf_db.reserve2-char = "deferred-callnews".
      662             release buf_db.
      663             release buf_sys-ctrl.
      664          end.
      665       end.
      666       else do:
      667          if     vrunProc
      668             and inShm >= TargetDBShm
      669          then do:
      670             find first _file no-lock where _file._file-name = "db"  no-error.
      671             if available _file
      672             then do:
      673                find first _field of _file where _field._Field-Name =  "reserve1-char" no-lock no-error.
      674                if     available (_field)
      675                   and _field._initial ne string (inShm)
      676                then do:
      677                   find first _field of _file where _field._Field-Name =  "reserve1-char" exclusive-lock no-error.
      678                  _field._initial = string (inShm).
      679                  release _field.
      680                end.
      681                release _file.
      682             end.
      683          end.
      684       end.
      685       CurrDBShm = inShm.
      686       isUpdShm = true.
      687     end.
      688     method public logical isneedupg (input flag as logical):
      689       return CurrDBShm < TargetDBShm .
      690     end.
      691     method public logical isneedupg ():
      692       if CurrDBShm < TargetDBShm
      693         then
      694       do:
      695         if not chkdbforupd ()
      696           then return ?.
      697         return true.
      698       end.
      699       if upd-all-list-df ne "" and not IsComp then return true.
      700       return false.
      701     end.
      702     method public void putstat (input itext as char):
      703        if valid-handle(PublisHandle)
      704        then
      705           publish "putstat" from PublisHandle (itext ).
      706      end.
      707   method public character objExists
      708   (input  ifolder as character,
      709    input  iType   as character  ):
      710       define variable vFileType as character no-undo init "D,F".
      711       define variable vi        as integer no-undo.
      712       define variable vtype as character no-undo.
      713       if iType ne ?
      714       then
      715          vFileType = iType.
      716       do vi = 1 to num-entries(vFileType):
      717          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      718          vtype = file-information:file-type.
      719          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      720             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      721             index(vtype , entry(vi,vFileType )) > 0
      722          then return file-information:full-pathname .
      723          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      724          vtype = file-information:file-type.
      725          if file-information:file-name <> "" and
      726             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      727             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      728             index( vtype, entry(vi,vFileType )) > 0
      729          then return file-information:full-pathname .
      730       end.
      731       return ? .
      732   end.
      733   method public character SearchFile
      734   (input  ifile as character):
      735      return objExists(ifile,?).
      736   end.
      737   method public character SearchPFile
      738   (input inFile as char):
      739        define variable oFile       as character no-undo.
      740        define variable vFileSearch as character no-undo.
      741        define variable vNumEntry   as integer no-undo.
      742        if inFile = "" then return ?.
      743        vNumEntry = num-entries(inFile,".").
      744        vFileSearch = inFile.
      745        if    vNumEntry > 0
      746           and (   entry(vNumEntry,inFile,".") eq "p"
      747                or entry(vNumEntry,inFile,".") eq "w")
      748        then do:
      749           entry(vNumEntry,vFileSearch, ".") = "r".
      750           oFile = search(vFileSearch ).
      751           if oFile eq ?
      752           then
      753              oFile = search(inFile).
      754        end.
      755        else
      756           oFile = search(vFileSearch).
      757        return oFile.
      758     end.
      759   end class.
