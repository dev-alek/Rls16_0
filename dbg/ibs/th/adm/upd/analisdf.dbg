       21          modeupd = iarg.
       22          DelArea = lookup("iscomp",iarg) ne 0.
       23          silent  = lookup("updblank",iarg) ne 0.
       24          ActiveIndexAll = lookup("OneDf",iarg) ne 0.
       25       end.
