     1117         vORDER                                  = vORDER + 10
     1118         vPOSITION                               = vPOSITION + 1
     1119         tt-FIELD.f-localIndex = 1
     1120         tt-FIELD.f-mode       = "ADD"
     1121         tt-FIELD.f-Table      = iTableName
     1122         tt-FIELD.f-Name       = '"action"'
     1123         tt-FIELD.f-Data-Type  = "integer"
     1124         tt-FIELD.f-POSITION   = string(vPOSITION)
     1125         tt-FIELD.f-ORDER      = string (vORDER)
     1126         tt-FIELD.f-DESCRIPTION =  '"Описание действия"'
     1127         tt-FIELD.f-FORMAT      = '"99"'
     1128         tt-FIELD.f-INITIAL     = '"0"'
     1129         tt-FIELD.f-LABEL       = '"Описание действия"'
     1130         tt-FIELD.f-MAX-WIDTH   = '4'
     1131      .
     1132      if iIsHead then
     1133      do:
     1134          create tt-FIELD.
     1135          assign
     1136             vORDER                                  = vORDER + 10
     1137             vPOSITION                               = vPOSITION + 1
     1138             tt-FIELD.f-localIndex = 1
     1139             tt-FIELD.f-mode       = "ADD"
     1140             tt-FIELD.f-Table      = iTableName
     1141             tt-FIELD.f-Name       = '"subject"'
     1142             tt-FIELD.f-Data-Type  = "character"
     1143             tt-FIELD.f-POSITION   = string(vPOSITION)
     1144             tt-FIELD.f-ORDER      = string (vORDER)
     1145             tt-FIELD.f-FORMAT     = '"X(8)"'
     1146             tt-FIELD.f-INITIAL    = '""'
     1147             tt-FIELD.f-LABEL      = '"Предмет изменения"'
     1148             tt-FIELD.f-MAX-WIDTH  = '16'
     1149             tt-FIELD.f-MANDATORY  = "логическое_поле"
     1150          .
     1151          create tt-FIELD.
     1152          assign
     1153             vORDER                                  = vORDER + 10
     1154             vPOSITION                               = vPOSITION + 1
     1155             tt-FIELD.f-localIndex = 1
     1156             tt-FIELD.f-mode       = "ADD"
     1157             tt-FIELD.f-Table      = iTableName
     1158             tt-FIELD.f-Name       = '"is-news"'
     1159             tt-FIELD.f-Data-Type  = "logical"
     1160             tt-FIELD.f-POSITION   = string(vPOSITION)
     1161             tt-FIELD.f-ORDER      = string (vORDER)
     1162             tt-FIELD.f-FORMAT     = '"yes/no"'
     1163             tt-FIELD.f-INITIAL    = '"no"'
     1164             tt-FIELD.f-LABEL      = '"Прием по новостям"'
     1165             tt-FIELD.f-MAX-WIDTH  = '1'
     1166          .
     1167          create tt-FIELD.
     1168          assign
     1169             vORDER                                  = vORDER + 10
     1170             vPOSITION                               = vPOSITION + 1
     1171             tt-FIELD.f-localIndex = 1
     1172             tt-FIELD.f-mode       = "ADD"
     1173             tt-FIELD.f-Table      = iTableName
     1174             tt-FIELD.f-Name       = '"source-type"'
     1175             tt-FIELD.f-Data-Type  = "character"
     1176             tt-FIELD.f-POSITION   = string(vPOSITION)
     1177             tt-FIELD.f-ORDER      = string (vORDER)
