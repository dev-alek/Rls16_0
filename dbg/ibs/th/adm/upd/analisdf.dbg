       94         field f-DECIMALS as char
       95         field f-HELP as char
       96         field f-ORDER as char
       97         field f-MANDATORY as char
       98         field f-NULL-ALLOWED as char
       99         field f-CASE-SENSITIVE as char
      100         field f-NOT-CASE-SENSITIVE as char
      101         field f-VIEW-AS as char
      102         field f-FORMAT-SA as char
      103         field f-HELP-SA as char
      104         field f-LABEL as char
      105         field f-LABEL-SA as char
      106         field f-COLUMN-LABEL as char
      107         field f-COLUMN-LABEL-SA as char
      108         field f-CAN-READ as char
      109         field f-CAN-WRITE as char
      110         field f-VALEXP as char
      111         field f-VALMSG as char
      112         field f-VALMSG-SA as char
      113         field f-EXTENT as char
