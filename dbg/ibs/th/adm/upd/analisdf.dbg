     1213             tt-FIELD.f-INITIAL    = '"no"'
     1214             tt-FIELD.f-LABEL      = '""'
     1215             tt-FIELD.f-MAX-WIDTH  = '16'
     1216          .
     1217      end.
     1218   end method.
     1219   method public void crTriggerFile(
     1220     iTableName as character,
     1221     iFileName as character,
     1222     iTrigger as character ):
     1223     define variable vFullName as character no-undo.
     1224     vFullName = substitute("&1&2&3.p",session:temp-directory, iFileName, lc(substr(iTrigger,1,1))).
     1225     output stream sTrigger to value(vFullName).
     1226     put stream sTrigger unformatted
     1227        "block-level on error undo, throw." skip(1)
     1228        "/*" skip
     1229        "$Revision$" skip
     1230        "$Author$" skip
     1231        "$Date$" skip
     1232        "$Workfile$" skip
     1233        "$Archive$" skip(1)
     1234        "Автор: Сгенерировано автоматически методом " program-name(1) skip
     1235        "Дата создания: " string(today,"99/99/9999") skip
     1236        "Author: automatically generated by " program-name(1) skip
     1237        "Created: " string(today,"99/99/9999") skip
     1238        "*/" skip(1)
     1239        "&glob main-tbl " iTableName skip
     1240        "trigger procedure for " lc(iTrigger) " of ub.~{&main-tbl~}"
     1241     .
     1242     if iTrigger = "write" then
     1243     do:
     1244       put stream sTrigger unformatted
     1245         " " skip
     1246         "  new buffer new-~{&main-tbl~}" skip
     1247         "  old buffer old-~{&main-tbl~}" skip
     1248       .
     1249     end.
     1250     put stream sTrigger unformatted
     1251       "." skip(1)
     1252       "define variable vss-revision    as character no-undo initial ~"$Revision$~":U." skip
     1253       "define variable vss-author      as character no-undo initial ~"$Author$~":U." skip
     1254       "define variable vss-date        as character no-undo initial ~"$Date$~":U." skip
     1255       "define variable vss-workfile    as character no-undo initial ~"$Workfile$~":U." skip
     1256       "define variable vss-archive     as character no-undo initial ~"$Archive$~":U." skip
     1257       "define variable vss-description as character no-undo init ~"Триггер на " lc(iTrigger) " " iTableName "~"." skip
     1258     .
     1259     output stream sTrigger close.
     1260   end method.
     1261   method public void crtablehist(iTableName as character ):
     1262     crtablehist(iTableName, no, "").
     1263   end method.
     1264   method public void crtablehist(
     1265      iTableName as character,
     1266      iCrSeq as logical,
     1267      iFileTrigger  as character
     1268   ):
     1269      if not can-find(first tt-TABLE where tt-TABLE.f-Name = '"' + iTableName + '"') then
     1270      do:
     1271        empty temp-table tt-TABLE.
     1272        empty temp-table tt-FIELD.
     1273        empty temp-table tt-Index.
     1274        empty temp-table tt-SEQUENCE.
     1275        run prodict/dump_df.p   (iTableName,
     1276                                 iTableName + ".df",
     1277                                 "").
     1278        readDF(iTableName + ".df").
     1279      end.
     1280      define variable vnewName   as character no-undo.
     1281      define variable vnewNameno as character no-undo.
     1282      for each tt-TABLE where not ( tt-TABLE.f-Name begins "c-") :
     1283         vnewNameno = "c-" + trim(tt-TABLE.f-Name,'"').
     1284         vnewName = '"' + vnewNameno + '"'.
     1285         ChangeTable(tt-TABLE.f-Name,vnewName).
     1286         tt-TABLE.f-Area = '"History"'.
     1287         ChangeAreahist (vnewName).
     1288         if iFileTrigger <> "" then
     1289         do:
     1290           crTriggerFile (vnewNameno, iFileTrigger, "WRITE").
     1291           crTriggerFile (vnewNameno, iFileTrigger, "DELETE").
     1292           tt-TABLE.f-TABLE-TRIGGER = substitute(
     1293             "~"DELETE~" OVERRIDE PROCEDURE ~"trg/&1d.p~" CRC ~"?~"~
     1294   &2~"WRITE~" OVERRIDE PROCEDURE ~"trg/&1w.p~" CRC ~"?~"",
     1295             iFileTrigger, chr(4)).
     1296         end.
     1297         else
     1298         do:
     1299           tt-TABLE.f-TABLE-TRIGGER = "".
     1300         end.
     1301         addFieldHist (vnewName, false).
     1302         addIndexHist (vnewName).
     1303         tt-TABLE.f-Name     = vnewName.
     1304         tt-TABLE.f-DUMP-NAME = '"' + lc(vnewNameno) + '"'.
     1305         if iCrSeq then
     1306         do:
     1307           create tt-SEQUENCE.
     1308           assign
     1309             tt-SEQUENCE.f-mode           = "ADD"
     1310             tt-SEQUENCE.f-Name           = "s-" + vnewNameno + "-chip-num"
     1311             tt-SEQUENCE.f-INITIAL        = '0'
     1312             tt-SEQUENCE.f-INCREMENT      = '1'
     1313             tt-SEQUENCE.f-CYCLE-ON-LIMIT = 'no'
     1314           .
     1315         end.
     1316      end.
     1317      dumpTable ("c-" + iTableName + ".df").
     1318      if not noMessage then
     1319        message "c-" + iTableName + ".df" search("c-" + iTableName + ".df")
     1320        view-as alert-box.
     1321    end method.
     1322   method public void crTableHeadHist
     1323      ( iTableName    as character
     1324      , iTableHead    as character
     1325      , iSequenceName as character
     1326      , iFileTrigger  as character):
     1327      empty temp-table tt-TABLE.
     1328      empty temp-table tt-FIELD.
     1329      empty temp-table tt-Index.
     1330      empty temp-table tt-SEQUENCE.
     1331      run prodict/dump_df.p   (iTableName,
     1332                               iTableName + ".df",
     1333                               "").
     1334      readDF(iTableName + ".df").
     1335      define variable vnewName   as character no-undo.
     1336      define variable vnewNameno as character no-undo.
     1337      for each tt-TABLE where not ( tt-TABLE.f-Name begins "c-") :
     1338         vnewNameno = trim(iTableHead).
     1339         vnewName = '"' + vnewNameno + '"'.
     1340         DeleteFieldsForHeadTable(tt-TABLE.f-Name).
     1341         ChangeTable(tt-TABLE.f-Name,vnewName).
     1342         tt-TABLE.f-Area = '"History"'.
     1343         ChangeAreahist (vnewName).
     1344         if iFileTrigger <> "" then
     1345         do:
     1346           crTriggerFile (vnewNameno, iFileTrigger, "WRITE").
     1347           crTriggerFile (vnewNameno, iFileTrigger, "DELETE").
     1348           tt-TABLE.f-TABLE-TRIGGER = substitute(
     1349             "~"DELETE~" OVERRIDE PROCEDURE ~"trg/&1d.p~" CRC ~"?~"~
     1350   &2~"WRITE~" OVERRIDE PROCEDURE ~"trg/&1w.p~" CRC ~"?~"",
     1351             iFileTrigger, chr(4)).
     1352         end.
     1353         else
     1354         do:
     1355           tt-TABLE.f-TABLE-TRIGGER = "".
     1356         end.
     1357         addFieldHist (vnewName, true).
     1358         addIndexHeadHist (vnewName).
     1359         tt-TABLE.f-Name     = vnewName.
     1360         tt-TABLE.f-DUMP-NAME = '"' + lc(vnewNameno) + '"'.
     1361         create tt-SEQUENCE.
     1362         assign
     1363            tt-SEQUENCE.f-mode           = "add"
     1364            tt-SEQUENCE.f-Name           = trim(iSequenceName)
     1365            tt-SEQUENCE.f-INITIAL        = '0'
     1366            tt-SEQUENCE.f-INCREMENT      = '1'
     1367            tt-SEQUENCE.f-CYCLE-ON-LIMIT = 'no'
     1368         .
     1369      end.
     1370      dumpTable (iTableHead + ".df") no-error.
     1371      if not noMessage then
     1372        message iTableHead + ".df" search(iTableHead + ".df")
     1373        view-as alert-box.
     1374   end method.
     1375   method public void crTableAttr (
     1376      iTableName       as character,
     1377      iFileTrigger     as character,
     1378      iCrHistAttr      as logical,
     1379      iFileTriggerHist as character):
     1380      define variable vnewName   as character no-undo.
     1381      define variable vnewNameno as character no-undo.
     1382      empty temp-table tt-TABLE.
     1383      empty temp-table tt-FIELD.
     1384      empty temp-table tt-Index.
     1385      empty temp-table tt-SEQUENCE.
     1386      run prodict/dump_df.p   (iTableName,
     1387                               iTableName + ".df",
     1388                               "").
     1389      readDF(iTableName + ".df").
     1390      for each tt-TABLE where not ( tt-TABLE.f-Name begins "c-") :
     1391         vnewNameno = trim(iTableName) + "-attr".
     1392         vnewName = '"' + vnewNameno + '"'.
     1393         DeleteFieldsForHeadTable(tt-TABLE.f-Name).
     1394         ChangeTable(tt-TABLE.f-Name,vnewName).
     1395         if iFileTrigger <> "" then
     1396         do:
     1397           crTriggerFile (vnewNameno, iFileTrigger, "WRITE").
     1398           crTriggerFile (vnewNameno, iFileTrigger, "DELETE").
     1399           tt-TABLE.f-TABLE-TRIGGER = substitute(
     1400             "~"DELETE~" OVERRIDE PROCEDURE ~"trg/&1d.p~" CRC ~"?~"~
     1401   &2~"WRITE~" OVERRIDE PROCEDURE ~"trg/&1w.p~" CRC ~"?~"",
     1402             iFileTrigger, chr(4)).
     1403         end.
     1404         else
     1405         do:
     1406           tt-TABLE.f-TABLE-TRIGGER = "".
     1407         end.
     1408         addFieldAttr (vnewName).
     1409         addIndexAttr (vnewName).
     1410         tt-TABLE.f-Name     = vnewName.
     1411         tt-TABLE.f-DUMP-NAME = '"' + lc(vnewNameno) + '"'.
     1412      end.
     1413      dumpTable (iTableName + "-attr.df").
     1414      if iCrHistAttr then
     1415      do:
     1416        crtablehist(iTableName + "-attr", no, iFileTriggerHist).
     1417      end.
     1418      if not noMessage then
     1419        message iTableName + "-attr.df" search(iTableName + "-attr.df")
     1420        view-as alert-box.
     1421   end method.
     1422    method public void putmes (input itext as char):
     1423       if not silent
     1424       then do:
     1425          message itext
     1426          view-as alert-box.
     1427       end.
     1428    end method.
     1429      method public void putstat (input itext as char):
     1430         if valid-handle(PublisHandle)
     1431        then
     1432           publish "putstat" from PublisHandle (itext ).
     1433      end.
     1434   end class.
