     1195             tt-FIELD.f-INITIAL    = '""'
     1196             tt-FIELD.f-LABEL      = '"Ссылка на источник"'
     1197             tt-FIELD.f-MAX-WIDTH  = '16'
     1198          .
     1199      end.
     1200      else do:
     1201          create tt-FIELD.
     1202          assign
     1203             vORDER                                  = vORDER + 10
     1204             vPOSITION                               = vPOSITION + 1
     1205             tt-FIELD.f-localIndex = 1
     1206             tt-FIELD.f-mode       = "ADD"
     1207             tt-FIELD.f-Table      = iTableName
     1208             tt-FIELD.f-Name       = '"is-del"'
