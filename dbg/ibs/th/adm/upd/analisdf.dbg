       48      end destructor.
       49      method public character  objExists  (input  ifolder as character,
       50                                        input  iType   as character  ):
       51         define variable vPureName  as character no-undo.
       52         define variable vFullPath as character no-undo.
       53         define variable vFileType as character no-undo.
       54         file-information:file-name = ifolder.
       55         if index( file-information:file-type, iType ) > 0 then return file-information:full-pathname .
       56         file-information:file-name = "./" + ifolder.
       57         if index( file-information:file-type, iType ) > 0 then return file-information:full-pathname .
       58         return ? .
       59      end method.
       60    define stream sReadfile.
       61     define variable mBuffer     as handle    no-undo.
       62     define variable mBufferName as character no-undo.
       63     define variable mName       as character no-undo.
       64           define temp-table tt-TABLE
       65        field f-mode as char
       66        field f-Name as char
       67        field f-NewName as char
       68        field f-AREA as char
       69        field f-LABEL as char
       70        field f-CAN-CREATE as char
       71        field f-CAN-DELETE as char
       72        field f-CAN-READ as char
       73        field f-CAN-WRITE as char
       74        field f-CAN-DUMP as char
       75        field f-CAN-LOAD as char
       76        field f-DESCRIPTION as char
       77        field f-DUMP-NAME as char
       78        field f-TABLE-TRIGGER as char
       79        field f-localIndex as integer
