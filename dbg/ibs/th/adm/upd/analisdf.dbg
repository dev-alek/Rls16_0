      143      .
      144     method public logical createDF (iCurrDBShm as integer):
      145        return createDF(iCurrDBShm,TargetDBShm).
      146     end method.
      147     method public logical createDF (iCurrDBShm as integer, iTargetDBShm as integer):
      148        define variable vi as integer no-undo.
      149        define variable vFileDf as character no-undo.
      150        define variable vFlagDf as logical no-undo.
      151        block-read:
      152        do  vi = iCurrDBShm + 1 to minimum(iTargetDBShm,TargetDBShm):
      153           if not obsrvdbObj:m-upd-list-df[vi    ] begins "proc:"
      154           then do:
      155              vFlagDf = yes.
      156              vFileDf   = obsrvdbObj:m-upd-list-df[vi].
      157              if vFileDf begins "only:"
      158              then
      159                 vFileDf = substring(vFileDf,6).
      160              if readDF(vFileDf)
      161              then
      162                 return no.
      163           end.
      164           else do:
      165              mFileDf   = obsrvdbObj:m-upd-list-df[vi    ].
      166              if mFileDf begins "only:"
      167              then
      168                 mFileDf = substring(mFileDf,6).
      169              mUpdateTo = vi.
      170              return yes.
      171           end.
      172           if     vi >= TargetDBShm
      173              or  obsrvdbObj:m-upd-list-df[vi    ] begins "proc:"
      174              or  obsrvdbObj:m-upd-list-df[vi + 1] begins "proc:"
      175              or  obsrvdbObj:m-upd-list-df[vi    ] begins "only:"
      176              or  obsrvdbObj:m-upd-list-df[vi + 1] begins "only:"
      177            then
      178               leave block-read.
      179        end.
      180        if vi > minimum(iTargetDBShm,TargetDBShm)
      181        then
      182           vi = minimum(iTargetDBShm,TargetDBShm).
      183        if mFileDf begins "proc:"
      184        then
      185           return yes.
      186        define variable VavailVer as logical no-undo.
      187        for each tt-FIELD where f-Name       = '"reserve1-char"'
      188                                    and f-Table      = '"db"'
      189        :
      190           f-initial    = '"' + string(vi) + '"' .
      191           VavailVer = yes.
      192        end.
      193        if not VavailVer
      194        then do:
      195           create tt-FIELD.
      196           assign
      197             f-mode       = "UPDATE"
      198             f-Name       = '"reserve1-char"'
      199             f-Table      = '"db"'
      200             f-initial    = '"' + string(vi) + '"'
      201             f-localIndex = 1
      202           .
      203        end.
      204        vFileDf = substitute ("&1_&2_&3.df","update",iCurrDBShm,vi).
      205        dumpTable(vFileDf).
      206        mFileDf   = objExists(vFileDf,"f").
      207        mUpdateTo = vi.
      208        return yes.
      209     end.
      210     method public character  addDFNumUpd (iFileDf as character, num as integer ):
      211        define variable Vi          as integer no-undo.
      212        define variable vfiledf     as character no-undo.
      213        define variable vSTR        as character no-undo.
      214        define variable vFileDf_new as character no-undo.
      215        define variable vFirst      as logical no-undo init yes.
      216        do vi = 1 to num-entries(iFileDf):
      217            vFileDf_new = replace( iFileDf, "~\", "~/" ).
      218            vFileDf_new = entry( num-entries( vFileDf_new, "~/" ), vFileDf_new, "~/" ).
      219            entry(1,vFileDf_new, ".") =  entry(1,vFileDf_new, ".") + "_" + string (num).
      220            vfiledf = search (entry(vi,iFileDf)).
      221            output stream Ostream to value(vFileDf_new).
      222            input STREAM sReadfile FROM  VALUE(vfiledf).
      223            block-file:
      224            repeat:
      225                import stream sReadfile unformatted vSTR.
      226                if      trim (vstr) eq "."
      227                   and vFirst
      228                then do:
      229                   vFirst = no.
      230                   put stream Ostream unformatted  'UPDATE FIELD "reserve1-char" OF "db"' skip '  INITIAL "' + string(num) + '"' skip(1).
      231                end.
      232                if trim(vstr) eq ""
      233                then
      234                   put stream Ostream unformatted      skip(1) .
      235                else
      236                   put stream Ostream unformatted trim (replace (vstr,"  "," ")) skip .
      237            end.
      238            input STREAM sReadfile CLOSE.
      239            output stream Ostream close.
      240            entry(vi,iFileDf) = vFileDf_new.
      241         end.
      242        return iFileDf.
      243     end.
      244     method public logical readDF (iFileDf as character ):
      245         define variable vSTR as character no-undo.
      246         define variable vI as integer no-undo.
      247         define variable vfiledf as character no-undo.
      248         do vi = 1 to num-entries(iFileDf):
      249            vfiledf = search (entry(vi,iFileDf)).
      250            if vfiledf eq ?
      251            then do:
      252               Msg = substitute("Не найден файл &1" , entry(vi,iFileDf)).
      253               putmes(msg).
      254               return yes.
      255            end.
      256            input STREAM sReadfile FROM  VALUE(vfiledf).
      257            block-file:
      258            repeat:
      259                import stream sReadfile unformatted vSTR.
      260                if trim (vstr) eq "." then leave block-file.
      261                if parsString(vSTR)
      262                then
      263                   return yes.
      264            end.
      265            input STREAM sReadfile CLOSE.
      266         end.
      267         finally:
      268         if valid-handle (mBuffer)
      269            then
      270               delete object mBuffer.
      271         end finally.
      272     end method.
      273        define variable mposih         as integer no-undo init 1.
      274      method private logical parsString ( iStr as character ):
      275         define variable vStrTmp     as character no-undo.
      276         define variable vTableWhere as character no-undo.
      277         define variable vFieldName  as character no-undo.
      278         define variable vOptionalWhere as character no-undo.
      279         define variable vMode          as character no-undo.
      280         define variable vtarget        as character no-undo.
      281         define variable vStr           as character no-undo.
      282         define variable vStr1          as character no-undo.
      283         define variable vSdvig         as integer no-undo.
      284         define variable VPrimary       as logical no-undo.
      285         define variable vFilePos       as integer no-undo.
      286         iStr = trim (replace (istr,"  "," ")).
      287         if istr eq "" then return no.
      288         vMode = entry(1,istr, " ").
      289         if can-do("add,update,drop,rename", vMode)
      290         then do:
      291            mBufferName = entry(2,istr, " ") no-error.
      292            if error-status:error
      293            then do:
      294               msg = substitute("Ошибка структуре df файла не задан объект для метода &1", vMode).
      295               putmes(msg).
      296               return yes.
      297            end.
      298            if mBufferName eq "PRIMARY"
      299            then do:
      300                mBufferName = entry(3,istr, " ") no-error.
      301                if error-status:error
      302                then do:
      303                   msg = substitute( "Ошибка структуре df файла не задан объект для метода &1", vMode).
      304                   putmes(msg).
      305                   return yes.
      306                end.
      307                assign
      308                   vSdvig   = 1
      309                   VPrimary = yes
      310                   .
      311            end.
      312            if valid-handle( mBuffer)
      313            then
      314               delete object mBuffer.
      315            create buffer mBuffer for table "tt-" + mBufferName no-error.
      316            if error-status:error
      317            then do:
      318               msg = substitute( "Не известный буфер &1" , "tt-" + mBufferName).
      319               putmes(msg).
      320               return yes.
      321            end.
      322            mName = entry(3 + vSdvig,istr, " ") no-error.
      323            if error-status:error
      324            then do:
      325               msg = substitute( "Ошибка структуре df файла не задан объект для метода &1  для таблицы &2" ,vMode , "tt-" + mBufferName).
      326               putmes(msg).
      327               return yes.
      328            end.
      329            if    mBufferName eq "field"
      330            then do:
      331               vTableWhere = if vMode eq "rename" then entry(5,istr, " ") else entry(5 + vSdvig,istr, " ") no-error.
      332               if error-status:error
      333               then do:
      334                  msg = substitute( "Ошибка структуре df файла не задан таблица для &1 &2", mBufferName, mName).
      335                  putmes(msg).
      336                  return yes.
      337               end.
      338               else do:
      339                  if vMode eq "rename" then vtarget = entry(7,istr, " ").
      340                  vOptionalWhere = substitute (" and tt-&1.f-table eq '&2'",mBufferName,vTableWhere).
      341               end.
      342            end.
      343            else if mBufferName eq "index"
      344            then do:
      345               vTableWhere = if vMode eq "rename" then entry(7,istr, " ") else entry(5 + vSdvig,istr, " ") no-error.
      346               if error-status:error
      347               then do:
      348                  msg = substitute( "Ошибка структуре df файла не задан таблица для &1 &2", mBufferName, mName).
      349                  putmes(msg).
      350                  return yes.
      351               end.
      352               else do:
      353                  if vMode eq "rename" then vtarget = entry(5,istr, " ").
      354                  vOptionalWhere = substitute (" and tt-&1.f-table eq '&2'",mBufferName,vTableWhere).
      355               end.
      356            end.
      357            else
      358               vOptionalWhere = "".
      359            vOptionalWhere = substitute ("where tt-&1.f-Name eq '&2' &3",mBufferName,mName,vOptionalWhere).
      360            mBuffer:find-last(vOptionalWhere, no-lock) no-error.
      361            if mBuffer:available
      362            then do:
      363               if     vMode                     eq "rename"
      364                  and mBuffer::f-mode eq "add"
      365               then do:
      366                  if mbuffername eq "table"
      367                  then do:
      368                     ChangeTable(mBuffer::f-Name , entry(5,istr, " ")).
      369                     mBuffer::f-Name = entry(5,istr, " ").
      370                  end.
      371                  else
      372                     mBuffer::f-Name = vtarget.
      373                     return no.
      374               end.
      375               else if      mBuffer::f-mode eq "rename"
      376                         or (    vMode eq "rename"
      377                             and vmode eq "update")
      378               then do:
      379                  mposih = mBuffer::f-localIndex + 1.
      380                  mBuffer:buffer-release ().
      381               end.
      382               else if vmode eq "add"
      383               then do:
      384                  if mBuffer::f-mode eq "drop"
      385                  then do:
      386                     mposih = mBuffer::f-localIndex + 1.
      387                     mBuffer:buffer-release ().
      388                  end.
      389                  else do:
      390                     msg = substitute( "Ошибка структуре df файла объект создан рание &1 &2 &3 &4", vmode, mBufferName, mName, vTableWhere).
      391                     putmes(msg).
      392                     return yes.
      393                  end.
      394               end.
      395               else if vmode eq "drop"
      396               then do:
      397                  if mBuffer::f-mode eq "add" or mBuffer::f-mode eq "update"
      398                  then do:
      399                     if mbuffername eq "table"
      400                     then do:
      401                        for each tt-FIELD where tt-FIELD.f-Table eq mBuffer::f-name:
      402                           delete tt-FIELD.
      403                        end.
      404                        for each tt-index where tt-index.f-Table eq mBuffer::f-name:
      405                           delete tt-index.
      406                        end.
      407                     end.
      408                     if mBuffer::f-mode eq "add"
      409                     then do:
      410                        mBuffer:buffer-delete ().
      411                        return no.
      412                     end.
      413                     else
      414                        mBuffer:buffer-delete ().
      415                  end.
      416                  else
      417                     mBuffer::f-mode = vmode.
      418               end.
      419            end.
      420            if not mBuffer:available
      421            then do:
      422               mBuffer:buffer-create ().
      423               mBuffer::f-mode       = vmode.
      424               mBuffer::f-Name       = mName.
      425               mBuffer::f-localIndex = mposih.
      426               if vMode eq "rename"
      427               then
      428                  mBuffer::f-NewName = if    mbuffername eq "table"
      429                                                    or mbuffername eq "index"
      430                                                 then entry(5,istr, " ")
      431                                                 else entry(7,istr, " ").
      432            end.
      433            if VPrimary
      434            then
      435              mBuffer:buffer-field("f-PRIMARY"):BUFFER-VALUE () = "логическое_поле".
      436            if    mBufferName eq "field"
      437               or mBufferName eq "index"
      438            then
      439               mBuffer::f-table = vTableWhere.
      440            if    mBufferName eq "field"
      441               and vMode ne "rename"
      442            then do:
      443               mBuffer::f-Data-Type = entry(7,istr, " ") no-error.
      444               if     error-status:error
      445                  and vMode eq "add"
      446               then do:
      447                  msg = substitute( "Ошибка структуре df файла не задан таблица для &1 &2", mBufferName, mName).
      448                  putmes(msg).
      449                  return yes.
      450               end.
      451            end.
      452         end.
      453         else do:
      454            if    mBufferName eq "table" and can-do("AREA,LABEL,DESCRIPTION,DUMP-NAME,TABLE-TRIGGER,CAN-CREATE,CAN-DELETE,CAN-READ,CAN-WRITE,CAN-DUMP,CAN-LOAD",trim(vMode,'"'))
      455               or mBufferName eq "field" and can-do("DESCRIPTION,FORMAT,INITIAL,LABEL,POSITION,MAX-WIDTH,COLUMN-LABEL,DECIMALS,HELP,ORDER,MANDATORY,NULL-ALLOWED,CASE-SENSITIVE,NOT-CASE-SENSITIVE,VIEW-AS,FORMAT-SA,HELP-SA,LABEL-SA,COLUMN-LABEL-SA,CAN-READ,CAN-WRITE,VALEXP,VALMSG,VALMSG-SA,EXTENT,INITIAL-SA",trim(vMode,'"'))
      456               or mBufferName eq "INDEX" and can-do("AREA,DESCRIPTION,UNIQUE,PRIMARY,INDEX-FIELD,WORD,inactive",trim(vMode,'"'))
      457               or mBufferName eq "SEQUENCE" and can-do("INITIAL,INCREMENT,CYCLE-ON-LIMIT,MIN-VAL,MAX-VAL",trim(vMode,'"'))
      458            then do:
      459                  if     ActiveIndexAll
      460                     and mBufferName eq "INDEX" and can-do("inactive",trim(vMode,'"'))
      461                  then
      462                     return no.
      463                  vFieldName = "f-" + vMode no-error.
      464                  if error-status:error
      465                  then do:
      466                     msg = substitute( "Ошибка структуре df  объекта &1 &2 нет поля в таблице &3", mBufferName, mName, "f-" + vMode).
      467                     putmes(msg).
      468                     return yes.
      469                  end.
      470                  define variable vval as character no-undo.
      471                  vval = trim(
      472                                                                     (if can-do("INDEX-FIELD,TABLE-TRIGGER" ,vmode)
      473                                                                     then mBuffer:buffer-field(vFieldName):BUFFER-VALUE () + chr(4)
      474                                                                     else "")
      475                                                                   + trim (substring (istr,length(vMode) + 2))
      476                                                                   ,chr(4) ).
      477                  if trim(vMode,'"') = "DESCRIPTION" then
      478                  do:
      479                    BLOCK_DESC:
      480                    repeat:
      481                      vFilePos = seek(sReadfile).
      482                      import stream sReadfile unformatted vStr.
      483                      vStr1 = entry(1, trim(vStr), " ").
      484                      if mBufferName eq "table" and can-do("AREA,LABEL,DESCRIPTION,DUMP-NAME,TABLE-TRIGGER,CAN-CREATE,CAN-DELETE,CAN-READ,CAN-WRITE,CAN-DUMP,CAN-LOAD",trim(vStr1,'"'))
      485                         or mBufferName eq "field" and can-do("DESCRIPTION,FORMAT,INITIAL,LABEL,POSITION,MAX-WIDTH,COLUMN-LABEL,DECIMALS,HELP,ORDER,MANDATORY,NULL-ALLOWED,CASE-SENSITIVE,NOT-CASE-SENSITIVE,VIEW-AS,FORMAT-SA,HELP-SA,LABEL-SA,COLUMN-LABEL-SA,CAN-READ,CAN-WRITE,VALEXP,VALMSG,VALMSG-SA,EXTENT,INITIAL-SA",trim(vStr1,'"'))
      486                         or mBufferName eq "INDEX" and can-do("AREA,DESCRIPTION,UNIQUE,PRIMARY,INDEX-FIELD,WORD,inactive",trim(vStr1,'"')) then
      487                      do:
      488                        seek stream sReadfile to vFilePos.
      489                        leave BLOCK_DESC.
      490                      end.
      491                      else
      492                      do:
      493                        vval = vval + "~n" + vStr.
      494                      end.
      495                    end.
      496                  end.
      497                  mBuffer:buffer-field(vFieldName):BUFFER-VALUE () = vval   no-error.
      498                  if mBuffer:buffer-field(vFieldName):BUFFER-VALUE () eq ""
      499                  then
      500                     mBuffer:buffer-field(vFieldName):BUFFER-VALUE () = "логическое_поле".
      501                  if error-status:error
      502                  then do:
      503                     msg = substitute( "2 Ошибка структуре df  объекта &1 &2", mBufferName, mName).
      504                     putmes(msg).
      505                     return yes.
      506                  end.
      507                  if vMode eq "NULL-ALLOWED"
      508                  then
      509                     mBuffer:buffer-field("f-MANDATORY"):BUFFER-VALUE () = "".
      510                  else if vMode eq "MANDATORY"
      511                  then
      512                     mBuffer:buffer-field("f-NULL-ALLOWED"):BUFFER-VALUE () = "".
      513                  else if vMode eq "NOT-CASE-SENSITIVE"
      514                  then
      515                     mBuffer:buffer-field("f-CASE-SENSITIVE"):BUFFER-VALUE () = "".
      516                  else if vMode eq "CASE-SENSITIVE"
      517                  then
      518                     mBuffer:buffer-field("f-NOT-CASE-SENSITIVE"):BUFFER-VALUE () = "".
      519            end.
      520            else do:
      521               msg = substitute( "Ошибка структуре df  объекта &1 &2 неизвестное выражение &3",mBufferName, mName, vMode).
      522               putmes(msg).
      523               return yes.
      524            end.
      525         end.
      526      end method.
      527      method public void dumpTable(ifile  as character):
      528         if fileDF <> "" then
      529         do:
      530             iFile = fileDF.
      531         end.
      532         else
      533         do:
      534           output stream Ostream to value(ifile).
      535           output stream Ostream close.
      536         end.
      537         find first tt-Table no-error.
      538         if available tt-Table
      539         then
      540            dumpOneTable(ifile,buffer tt-Table:handle ).
      541         find first tt-field no-error.
      542         if available tt-field
      543         then
      544            dumpOneTable(ifile,buffer tt-field:handle ).
      545         find first tt-index no-error.
      546         if available tt-index
      547         then
      548            dumpOneTable(ifile,buffer tt-index:handle ).
      549         find first tt-SEQUENCE no-error.
      550         if available tt-SEQUENCE
      551         then
      552            dumpOneTable(ifile,buffer tt-SEQUENCE:handle ).
      553         if fileDF = "" then
      554         do:
      555             output stream Ostream to value(ifile) append.
      556             put stream Ostream unformatted "." skip "PSC" skip "cpstream=1251" skip "." skip .
      557             output stream Ostream close.
      558         end.
      559      end.
      560      method private void dumpOneTable(ifile  as character,
      561                                      iBuffer as  handle):
      562      define var vItm   as int64  no-undo.
      563      define var vJ   as int64  no-undo.
      564      define var vField as handle   no-undo.
      565      define var vQuery  as handle no-undo.
      566      define var vBuffer as handle no-undo.
      567      define variable vTxt       as character no-undo.
      568      define variable vFieldName as character no-undo.
      569      define variable vFieldPref as integer   no-undo.
      570      vBuffer = iBuffer.
      571      output stream Ostream to value(ifile) append.
      572      do transaction:
      573      create query vQuery.
      574      vQuery:add-buffer(vBuffer).
      575      def var vPredicate as char no-undo.
      576      vPredicate = "for EACH " + vBuffer:name + if vBuffer:name = "tt-FIELD" then " BY INT("  + vBuffer:name + ".f-ORDER)" else "".
      577      if not vQuery:query-prepare(vPredicate) then  do: msg = substitute( "ERROR 1 ", error-status:get-message(1)).  message msg view-as alert-box. end.
      578      if not vQuery:query-open()then  do: msg = substitute( "ERROR 2 ", error-status:get-message(1)).  message msg view-as alert-box. end.
      579      vQuery:get-first().
      580      if vBuffer:available
      581      then do:
      582         vFieldPref = length("f-") + 1.
      583         do while vBuffer:available:
      584            vtxt = if vBuffer:name eq "tt-field"
      585                then substitute ("&1 FIELD &2 OF &3 &4&5",
      586                                 vBuffer::f-mode,
      587                                 vBuffer::f-name,
      588                                 vBuffer::f-table,
      589                                 if vBuffer::f-mode eq "rename" then " TO " + vBuffer::f-NewName else "",
      590                                 if vBuffer::f-Data-Type ne "" then "AS " + vBuffer::f-Data-Type else "")
      591                else if vBuffer:name eq "tt-index"
      592                then substitute ("&1 INDEX &2&3 ON &4",
      593                                 vBuffer::f-mode,
      594                                 vBuffer::f-name,
      595                                 if vBuffer::f-mode eq "rename" then " TO " + vBuffer::f-NewName  else "",
      596                                 if vBuffer::f-mode eq "rename" then vBuffer::f-table else vBuffer::f-table)
      597                else substitute ("&1 &2 &3&4",
      598                                 vBuffer::f-mode,
      599                                 substring(vBuffer:name,length("tt-") + 1),
      600                                 vBuffer::f-name,
      601                                 if vBuffer::f-mode eq "rename" then " TO " + vBuffer::f-NewName else ""
      602                                 ).
      603            put stream Ostream unformatted vtxt skip.
      604            do vItm = 1 to vBuffer:num-fields:
      605               vField = vBuffer:buffer-field(vItm).
      606               vFieldName = substring(vField:name,vFieldPref).
      607               if not can-do("mode,name,newname,table,Data-Type,localindex" + (if DelArea then ",area" else "") ,vFieldName)
      608               then do:
      609                  do vj = 1 to if vField:buffer-value eq ? then 1 else num-entries(vField:buffer-value,chr(4)):
      610                     define variable vValue as character no-undo.
      611                     vValue = entry(vj,vField:buffer-value,chr(4)).
      612                     if vValue eq "логическое_поле" then vValue = "".
      613                     put stream Ostream unformatted substitute ('  &1 &2',vFieldName,vValue) skip.
      614                  end.
      615               end.
      616            end.
      617            put stream Ostream unformatted skip(1).
      618            vQuery:get-next().
      619         end.
      620      end.
      621      finally :
      622        if valid-handle(vQuery) then
      623        do:
      624          vQuery:query-close().
      625          delete object vQuery.
      626        end.
      627        output stream Ostream close.
      628      end finally .
      629      end.
      630   end method.
      631   method public logical CheckTable(ifile  as character):
      632         define variable vOk as logical no-undo.
      633         define variable oOK as logical no-undo.
      634         oOK = CheckOneTable(temp-table tt-Table:handle ).
      635         vOk = CheckOneTable(temp-table tt-field:handle ).
      636         oOK = oOK and vOk.
      637         vOk = CheckOneTable(temp-table tt-index:handle ).
      638         oOK = oOK and vOk.
      639         vOk = CheckOneTable(temp-table tt-SEQUENCE:handle ).
      640         oOK = oOK and vOk.
      641         if not oOK
      642         then
      643            dumpTable(ifile).
      644         return oOK.
      645      end.
      646   method private logical CheckOneTable(iTable as  handle):
      647      define buffer buftt-TABLE for tt-TABLE.
      648      define var vItm   as int64  no-undo.
      649      define var vJ   as int64  no-undo.
      650      define var vField as handle   no-undo.
      651      define var vQuery  as handle no-undo.
      652      define var vBuffer as handle no-undo.
      653      define var vBufferDB as handle no-undo.
      654      define variable vTxt       as character no-undo.
      655      define variable vFieldName as character no-undo.
      656      define variable vFieldPref as integer   no-undo.
      657      define variable vFieldValue as character no-undo.
      658      define variable vBufferName as character no-undo.
      659      define variable vWhere      as character no-undo.
      660      define variable vOk     as logical no-undo.
      661      define variable oOkl     as logical no-undo init yes.
      662      define variable verror  as logical no-undo.
      663      define variable vFlagEQ as logical no-undo.
      664      define variable vCheckField as logical no-undo.
      665      vBuffer = iTable:default-buffer-handle.
      666      create query vQuery.
      667      vQuery:add-buffer(vBuffer).
      668      if not vQuery:query-prepare("PRESELECT EACH " + vBuffer:name)
      669      then do:
      670         msg = substitute( "ERROR 1 ", error-status:get-message(1)).
      671         putmes(msg).
      672         verror = yes.
      673      end.
      674      if not vQuery:query-open()
      675      then do:
      676         msg = substitute( "ERROR 2 ", error-status:get-message(1)).
      677         putmes(msg).
      678         verror = yes.
      679      end.
      680      vQuery:get-first().
      681      if vBuffer:available
      682      then do:
      683         define variable vCheck as logical no-undo.
      684         vCheck = yes.
      685         if  vBuffer:name eq "tt-TABLE"
      686         then
      687            vBufferName = "_file".
      688         else if  vBuffer:name eq "tt-field"
      689         then  do:
      690            assign
      691               vBufferName = "_field"
      692               vCheckField = yes
      693            .
      694         end.
      695         else if  vBuffer:name eq "tt-Index"
      696         then
      697            vBufferName = "_Index".
      698         else if  vBuffer:name eq "tt-Sequence"
      699         then
      700            vBufferName = "_Sequence".
      701         else
      702            return no.
      703         create buffer vBufferDB for table  vBufferName no-error.
      704         vFieldPref = length("f-") + 1.
      705         block-tt:
      706         do while vBuffer:available:
      707            if vBuffer::f-mode eq "rename"
      708           then do:
      709              vQuery:get-next().
      710              next block-tt.
      711           end.
      712         if  vBuffer:name eq "tt-TABLE"
      713         then do:
      714            find first buftt-TABLE where buftt-TABLE.f-name eq  vBuffer::f-name
      715                                             and buftt-TABLE.f-localIndex > vBuffer::f-localIndex
      716            no-error.
      717            if available buftt-TABLE
      718            then
      719               vCheck = no.
      720            vWhere      = substitute ("where _file._file-name eq &1 ",if vBuffer::f-mode eq "rename" then vBuffer::f-NewName else  vBuffer::f-name).
      721         end.
      722         else if  vBuffer:name eq "tt-field"
      723         then do:
      724            define variable vvvv as character no-undo.
      725            vFieldValue = trim(  vBuffer::f-table, '"').
      726            find first _file no-lock where _file._file-name = vFieldValue  no-error.
      727            if available _file
      728            then do:
      729               vWhere      = substitute ("where _field._file-recid eq &1 and _field._Field-Name eq &2 ",recid(_file),if vBuffer::f-mode eq "rename" then vBuffer::f-NewName else  vBuffer::f-name).
      730               if     vFieldValue = "db"
      731                  and trim(vBuffer::f-name,'"') eq "reserve1-char"
      732               then
      733                  vCheck = no.
      734            end.
      735         end.
      736         else if  vBuffer:name eq "tt-Index"
      737         then do:
      738            vFieldValue =  trim( vBuffer::f-table, '"').
      739            find first _file no-lock where _file._file-name = vFieldValue no-error.
      740            if available _file
      741            then
      742               vWhere      = substitute ("where _Index._file-recid eq &1 and _Index._Index-Name eq &2 ",recid(_file),if vBuffer::f-mode eq "rename" then vBuffer::f-NewName else  vBuffer::f-name).
      743         end.
      744         else if  vBuffer:name eq "tt-Sequence"
      745         then
      746            vWhere      = substitute ("where _Sequence._Seq-Name eq &1 ",vBuffer::f-name).
      747         else
      748            return no.
      749            vBufferDB:find-last(vWhere, no-lock) no-error.
      750            vOk = no.
      751            if vBufferDB:available
      752               and vBuffer::f-mode ne "drop"
      753               and vCheck
      754            then do:
      755               vOk = yes.
      756               if vCheckField then
      757               block-field:
      758               do vItm = 1 to vBuffer:num-fields:
      759                  define variable vValuelog as logical no-undo.
      760                  vValuelog = yes.
      761                  vField = vBuffer:buffer-field(vItm).
      762                  vFieldName = "_" + substring(vField:name,vFieldPref).
      763                  if vFieldName eq "_DESCRIPTION"
      764                  then
      765                     vFieldName = "_DESC".
      766                  else if vFieldName eq "_POSITION"
      767                  then
      768                     vFieldName = "_field-rpos".
      769                  else if vFieldName eq "_MAX-WIDTH"
      770                  then
      771                     vFieldName = "_WIDTH".
      772                  else if vFieldName eq "_COLUMN-LABEL"
      773                  then
      774                     vFieldName = "_Col-label".
      775                  else if vFieldName eq "_COLUMN-LABEL-SA"
      776                  then
      777                     vFieldName = "_Label-SA".
      778                  else if vFieldName eq "_CASE-SENSITIVE"
      779                  then
      780                     vFieldName = "_fld-case".
      781                  else if vFieldName eq "_NOT-CASE-SENSITIVE"
      782                  then
      783                     assign
      784                       vValuelog  = no
      785                       vFieldName = "_fld-case"
      786                     .
      787                  else if vFieldName eq "_NULL-ALLOWED"
      788                  then
      789                     assign
      790                        vValuelog  = no
      791                        vFieldName = "_MANDATORY"
      792                     .
      793                  if     (not can-do("_mode,_name,_table,_localindex,_NewName",vFieldName)
      794                     and vField:buffer-value ne "")
      795                  then do vj = 1 to if vField:buffer-value eq ? then 1 else num-entries(vField:buffer-value,chr(4)):
      796                     define variable vValuedb as character no-undo.
      797                     vFieldValue = replace(trim(vField:buffer-value," "),'"','').
      798                     vValuedb = replace(vBufferDB:buffer-field(vFieldName):buffer-value,'"','').
      799                     vFlagEQ = if vFieldValue eq "логическое_поле"
      800                           then
      801                              logical (vValuedb) eq vValuelog
      802                           else
      803                              vValuedb eq vFieldValue.
      804                      if vFlagEQ
      805                      then
      806                         vField:buffer-value = "".
      807                      else
      808                         vOk = no.
      809                  end.
      810               end.
      811            end.
      812            else if    ( not vBufferDB:available
      813                    and vBuffer::f-mode eq "drop")
      814                    or not vCheck
      815            then
      816               vOk = yes.
      817            if vOk
      818            then
      819               vBuffer:buffer-delete ().
      820            else do:
      821               oOkl = no.
      822            end.
      823            vQuery:get-next().
      824         end.
      825      end.
      826      ookl = not verror and oOkl.
      827      vQuery:query-close().
      828      delete object vQuery.
      829      finally:
      830         return oOkl.
      831      end finally.
      832   end method.
      833   method private void DeleteFieldsForHeadTable(iTableName as character):
      834      define variable vIndex as character no-undo.
      835      define variable vField as character no-undo.
      836      for each tt-Index where
      837                tt-Index.f-table = iTableName
      838            and tt-Index.f-Name  <> "~"pi~"":
      839        delete tt-Index.
      840      end.
      841      for first tt-Index where
      842                tt-Index.f-table = iTableName
      843            and tt-Index.f-Name  = "~"pi~"":
      844        vIndex = replace(tt-Index.f-INDEX-FIELD,chr(4),",").
      845        for each tt-FIELD where
      846                 tt-FIELD.f-table = iTableName:
      847          vField = substitute("&1 ASCENDING",tt-FIELD.f-Name).
      848          if not can-do(vIndex, vField) then
      849          do:
      850            vField = substitute("&1 DESCENDING",tt-FIELD.f-Name).
      851            if not can-do(vIndex, vField) then
      852              delete tt-FIELD.
      853          end.
      854        end.
      855      end.
      856   end method.
      857   method private void ChangeTable(OldName as character, NewName as character ):
      858      for each tt-FIELD where tt-FIELD.f-table eq oldName:
      859         tt-FIELD.f-table = newName.
      860      end.
      861      for each tt-Index where tt-Index.f-table eq oldName:
      862         tt-Index.f-table = newName.
      863      end.
      864   end method.
      865   method private void ChangeAreahist(iTableName as character ):
      866      for each tt-Index where tt-Index.f-table eq iTableName :
      867         tt-Index.f-area = '"History_Index"'.
      868      end.
      869   end method.
      870   method private void addIndexHeadHist(iTableName as character ):
      871      define buffer buf_tt-Index for tt-Index.
      872      for each tt-Index where tt-Index.f-localIndex ne 0  :
      873         create buf_tt-Index.
      874         buffer-copy tt-Index except f-PRIMARY f-UNIQUE f-localIndex  f-Name to buf_tt-Index
      875         assign
      876           buf_tt-Index.f-Name = '"sub"'
      877         .
      878         assign
      879            buf_tt-Index.f-INDEX-FIELD = '"subject" ASCENDING'
      880                                                         + chr(4) + buf_tt-Index.f-INDEX-FIELD
      881                                                         + chr(4) + '"corr-date" ASCENDING'
      882                                                         + chr(4) + '"corr-time" ASCENDING'
      883                                                         + chr(4) + '"corr-user-db-num" ASCENDING'
      884                tt-Index.f-INDEX-FIELD =     tt-Index.f-INDEX-FIELD
      885                                                         + chr(4) + '"corr-user-db-num" ASCENDING'
      886                                                         + chr(4) + '"chip-num" ASCENDING'
      887                                                         + chr(4) + '"subject" ASCENDING'
      888         .
      889      end.
      890      create tt-Index.
      891      assign
      892         tt-Index.f-mode        = "ADD"
      893         tt-Index.f-Table       = iTableName
      894         tt-Index.f-Name        = '"chip-num"'
      895         tt-Index.f-AREA        = '"History_Index"'
      896         tt-Index.f-INDEX-FIELD = '"chip-num" ASCENDING'
      897      .
      898      create tt-Index.
      899      assign
      900         tt-Index.f-mode        = "ADD"
      901         tt-Index.f-Table       = iTableName
      902         tt-Index.f-Name        = '"corr-user-db-num"'
      903         tt-Index.f-AREA        = '"History_Index"'
      904         tt-Index.f-INDEX-FIELD = '"corr-user-db-num" ASCENDING'
      905      .
      906      create tt-Index.
      907      assign
      908         tt-Index.f-mode        = "ADD"
      909         tt-Index.f-Table       = iTableName
      910         tt-Index.f-Name        = '"user-name"'
      911         tt-Index.f-AREA        = '"History_Index"'
      912         tt-Index.f-INDEX-FIELD = '"corr-user-name" ASCENDING' + chr(4) + '"corr-user-db-num" ASCENDING'
      913      .
      914   end method.
      915   method private void addIndexAttr(iTableName as character ):
      916      define buffer buf_tt-Index for tt-Index.
      917      define variable vArea as character no-undo.
      918      for first tt-Index where
      919                tt-Index.f-table = iTableName
      920            and tt-Index.f-Name  = "~"pi~"":
      921        tt-Index.f-INDEX-FIELD =
      922          substitute("&1&2~"attr-code~" ASCENDING",tt-Index.f-INDEX-FIELD,chr(4)).
      923        vArea = tt-Index.f-AREA.
      924      end.
      925      create tt-Index.
      926      assign
      927         tt-Index.f-mode        = "ADD"
      928         tt-Index.f-Table       = iTableName
      929         tt-Index.f-Name        = '"code-value"'
      930         tt-Index.f-AREA        = vArea
      931         tt-Index.f-INDEX-FIELD = '"attr-code" ASCENDING' + chr(4) + '"attr-value" ASCENDING'
      932      .
      933   end method.
      934   method private void addindexHist(iTableName as character ):
      935      define buffer buf_tt-Index for tt-Index.
      936      for each tt-Index where tt-Index.f-localIndex ne 0  :
      937         create buf_tt-Index.
      938         buffer-copy tt-Index except f-PRIMARY f-UNIQUE f-localIndex  f-Name to buf_tt-Index
      939         assign
      940         buf_tt-Index.f-Name = '"' + trim(tt-Index.f-Name,'"') + '-2"'
      941         .
      942         assign
      943            buf_tt-Index.f-INDEX-FIELD = buf_tt-Index.f-INDEX-FIELD
      944                                                         + chr(4) + '"corr-date" ASCENDING'
      945                                                         + chr(4) + '"corr-time" ASCENDING'
      946                                                         + chr(4) + '"corr-user-db-num" ASCENDING'
      947                tt-Index.f-INDEX-FIELD =     tt-Index.f-INDEX-FIELD
      948                                                         + chr(4) + '"corr-user-db-num" ASCENDING'
      949                                                         + chr(4) + '"chip-num" ASCENDING'
      950         .
      951      end.
      952      create tt-Index.
      953      assign
      954         tt-Index.f-mode        = "ADD"
      955         tt-Index.f-Table       = iTableName
      956         tt-Index.f-Name        = '"corr-user-db-num"'
      957         tt-Index.f-AREA        = '"History_Index"'
      958         tt-Index.f-INDEX-FIELD = '"corr-user-db-num" ASCENDING'
      959      .
      960      create tt-Index.
      961      assign
      962         tt-Index.f-mode        = "ADD"
      963         tt-Index.f-Table       = iTableName
      964         tt-Index.f-Name        = '"corr-user-name"'
      965         tt-Index.f-AREA        = '"History_Index"'
      966         tt-Index.f-INDEX-FIELD = '"corr-user-name" ASCENDING' + chr(4) + '"corr-user-db-num" ASCENDING'
      967      .
      968   end method.
      969   method private void addFieldAttr(iTableName as character ):
      970      define variable vORDER    as integer no-undo init 0.
      971      define variable vPOSITION as integer no-undo init 1.
      972      for each tt-FIELD where tt-FIELD.f-table eq iTableName
      973          by int(tt-FIELD.f-ORDER):
      974         assign
      975           vPOSITION                              = vPOSITION + 1
      976          tt-FIELD.f-POSITION   = string(vPOSITION)
      977         .
      978      end.
      979      for each tt-FIELD where tt-FIELD.f-table eq iTableName
      980          by int(tt-FIELD.f-POSITION):
      981         assign
      982         vORDER                                  = vORDER + 10
      983         tt-FIELD.f-ORDER      = string (vORDER)
      984         .
      985      end.
      986      create tt-FIELD.
      987      assign
      988         vORDER                                  = vORDER + 10
      989         vPOSITION                               = vPOSITION + 1
      990         tt-FIELD.f-localIndex = 1
      991         tt-FIELD.f-mode       = "ADD"
      992         tt-FIELD.f-Table      = iTableName
      993         tt-FIELD.f-Name       ='"attr-code"'
      994         tt-FIELD.f-Data-Type  = "character"
      995         tt-FIELD.f-FORMAT     = '"X(8)"'
      996         tt-FIELD.f-INITIAL    = '""'
      997         tt-FIELD.f-LABEL       = '"Код атрибута"'
      998         tt-FIELD.f-POSITION   = string(vPOSITION)
      999         tt-FIELD.f-MAX-WIDTH  = "16"
     1000         tt-FIELD.f-ORDER      = string (vORDER)
     1001         tt-FIELD.f-MANDATORY  = "логическое_поле"
     1002      .
     1003      create tt-FIELD.
     1004      assign
     1005         vORDER                                  = vORDER + 10
     1006         vPOSITION                               = vPOSITION + 1
     1007         tt-FIELD.f-localIndex = 1
     1008         tt-FIELD.f-mode       = "ADD"
     1009         tt-FIELD.f-Table      = iTableName
     1010         tt-FIELD.f-Name       ='"attr-value"'
     1011         tt-FIELD.f-Data-Type  = "character"
     1012         tt-FIELD.f-FORMAT     = '"X(20)"'
     1013         tt-FIELD.f-INITIAL    = '""'
     1014         tt-FIELD.f-LABEL       = '"Значение атрибута"'
     1015         tt-FIELD.f-POSITION   = string(vPOSITION)
     1016         tt-FIELD.f-MAX-WIDTH  = "40"
     1017         tt-FIELD.f-ORDER      = string (vORDER)
     1018      .
     1019   end method.
     1020   method private void addFieldHist(iTableName as character, iIsHead as logical ):
     1021      define variable vORDER    as integer no-undo.
     1022      define variable vPOSITION as integer no-undo.
     1023      for each tt-FIELD where tt-FIELD.f-table eq iTableName:
     1024         assign
     1025            vORDER    = max(vORDER   ,int(tt-FIELD.f-ORDER    ))
     1026            vPOSITION = max(vPOSITION,int(tt-FIELD.f-POSITION ))
     1027         .
     1028      end.
     1029      assign
     1030         vORDER    = max(vORDER,1000)
     1031         vPOSITION = max(vPOSITION,100)
     1032      .
     1033      create tt-FIELD.
     1034      assign
     1035         vORDER                                  = vORDER + 10
     1036         vPOSITION                               = vPOSITION + 1
     1037         tt-FIELD.f-localIndex = 1
     1038         tt-FIELD.f-mode       = "ADD"
     1039         tt-FIELD.f-Table      = iTableName
     1040         tt-FIELD.f-Name       ='"chip-num"'
     1041         tt-FIELD.f-Data-Type  = "integer"
     1042         tt-FIELD.f-FORMAT     = '"->,>>>,>>9"'
     1043         tt-FIELD.f-INITIAL    = '"0"'
     1044         tt-FIELD.f-LABEL       = '"Уникальный код"'
     1045         tt-FIELD.f-POSITION   = string(vPOSITION)
     1046         tt-FIELD.f-MAX-WIDTH  = "4"
     1047         tt-FIELD.f-ORDER      = string (vORDER)
     1048         tt-FIELD.f-MANDATORY  = "логическое_поле"
     1049      .
     1050      create tt-FIELD.
     1051      assign
     1052         vORDER                                  = vORDER + 10
     1053         vPOSITION                               = vPOSITION + 1
     1054         tt-FIELD.f-localIndex = 1
     1055         tt-FIELD.f-mode       = "ADD"
     1056         tt-FIELD.f-Table      = iTableName
     1057         tt-FIELD.f-Name       = '"corr-date"'
     1058         tt-FIELD.f-Data-Type  = "date"
     1059         tt-FIELD.f-POSITION   = string(vPOSITION)
     1060         tt-FIELD.f-ORDER      = string (vORDER)
     1061         tt-FIELD.f-FORMAT     = '"99/99/99"'
     1062         tt-FIELD.f-INITIAL    = '?'
     1063         tt-FIELD.f-LABEL       = '"Дата действия"'
     1064         tt-FIELD.f-MAX-WIDTH  = '4'
     1065      .
     1066      create tt-FIELD.
     1067      assign
     1068         vORDER                                  = vORDER + 10
     1069         vPOSITION                               = vPOSITION + 1
     1070         tt-FIELD.f-localIndex = 1
     1071         tt-FIELD.f-mode       = "ADD"
     1072         tt-FIELD.f-Table      = iTableName
     1073         tt-FIELD.f-Name       = '"corr-time"'
     1074         tt-FIELD.f-Data-Type  = "integer"
     1075         tt-FIELD.f-POSITION   = string(vPOSITION)
