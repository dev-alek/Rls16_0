     1100      assign
     1101         vORDER                                  = vORDER + 10
     1102         vPOSITION                               = vPOSITION + 1
     1103         tt-FIELD.f-localIndex = 1
     1104         tt-FIELD.f-mode       = "ADD"
     1105         tt-FIELD.f-Table      = iTableName
     1106         tt-FIELD.f-Name       = '"corr-user-name"'
     1107         tt-FIELD.f-Data-Type  = "character"
     1108         tt-FIELD.f-POSITION   = string(vPOSITION)
     1109         tt-FIELD.f-ORDER      = string (vORDER)
     1110         tt-FIELD.f-FORMAT     = '"x(8)"'
     1111         tt-FIELD.f-INITIAL    = '""'
     1112         tt-FIELD.f-LABEL       = '"Изменил"'
     1113         tt-FIELD.f-MAX-WIDTH  = '16'
     1114     .
     1115     create tt-FIELD.
