     1187             tt-FIELD.f-localIndex = 1
     1188             tt-FIELD.f-mode       = "ADD"
     1189             tt-FIELD.f-Table      = iTableName
     1190             tt-FIELD.f-Name       = '"source-ref"'
     1191             tt-FIELD.f-Data-Type  = "character"
     1192             tt-FIELD.f-POSITION   = string(vPOSITION)
     1193             tt-FIELD.f-ORDER      = string (vORDER)
