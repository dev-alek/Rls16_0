     1091         tt-FIELD.f-POSITION   = string(vPOSITION)
     1092         tt-FIELD.f-ORDER      = string (vORDER)
     1093         tt-FIELD.f-FORMAT     = '"->,>>>,>>9"'
     1094         tt-FIELD.f-INITIAL    = '"0"'
     1095         tt-FIELD.f-LABEL       = '"ДБ создания"'
     1096         tt-FIELD.f-MAX-WIDTH  = '4'
     1097         tt-FIELD.f-MANDATORY  = "логическое_поле"
     1098      .
