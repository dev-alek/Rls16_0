        1   define input parameter iTableList as character no-undo.
        2   define variable vi as integer no-undo.
        3   define variable vTableList as character no-undo.
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define variable mAsyncProc as class ibs.th.file.AsyncProc.
        9   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       10   define variable mstopAsunc as logical no-undo.
       11   function StopCheck returns logical:
       12      define variable oFlag as logical no-undo.
       13      run StopCheckAsync (output oFlag).
       14      return oFlag.
       15   end.
       16   procedure StopCheckAsync:
       17       define output  parameter oFlag as logical no-undo.
       18       if mstopAsunc
       19       then
       20          oFlag = mstopAsunc.
       21       else do:
       22          oFlag = mAsyncProc:CheckStop().
       23          mstopAsunc = oFlag.
       24       end.
       25   end.
       26   function GetParamAsunc returns character
       27   (input iNumPar as integer  ):
       28      return mAsyncProc:GetPARAM(iNumPar).
       29   end.
       30   function GetParamAsuncStr returns ibs.th.file.asyncparam
       31   (input iParamName as character ):
       32      return mAsyncProc:GetPARAM(iParamName).
       33   end.
       34   procedure PutMesAsunc:
       35       define input  parameter Itext as character no-undo.
       36       define variable vflag as logical no-undo.
       37       Publish "WriteLogAsunc" (Itext, yes)  .
       38   end.
       39   procedure PutMesAsuncNoTime:
       40       define input  parameter Itext as character no-undo.
       41       define variable vflag as logical no-undo.
       42       Publish "WriteLogAsunc" (Itext,no)  .
       43   end.
       44   procedure PutStatAsunc:
       45       define input  parameter Itext as character no-undo.
       46       Publish "PutStatAsunc" (Itext,no) .
       47        run
       48       PutMesAsunc (itext).
       49   end.
       50   procedure PutStatAsuncNoTime:
       51       define input  parameter Itext as character no-undo.
       52       Publish "PutStatAsunc" (Itext,no)  .
       53        run
       54       PutMesAsuncNoTime (itext).
       55   end.
       56   procedure PutStatAsuncAdd:
       57       define input  parameter Itext as character no-undo.
       58       Publish "PutStatAsunc" (Itext,yes)  .
       59   end.
       60   procedure PutFileLogAsunc:
       61       define input  parameter IFile as character no-undo.
       62       Publish "PutFileLogAsunc" (ifile)  .
       63   end.
       64          mAsyncProc:mProcPublish = this-procedure.
       65   vTableList = trim(iTableList,'"').
       66   function copytable returns logical (itable_old as character, itable_new as character ) forward.
       67   run putStatAsunc in this-procedure ("Копирование данных в новую структуру...").
       68   def var mtablename as char no-undo.
       69   do vi = 1 to num-entries (vTableList,"|"):
       70      mtablename  = entry(vi,vTableList,"|").
       71      run putStatAsunc in this-procedure ("Копирование данных в новую структуру. Обработка таблицы " + mtablename ).
       72      copytable(mtablename + "_old", mtablename).
       73   end.
       74   function copytable returns logical (itable_old as character, itable_new as character ):
       75      define variable vBufTargetTable as handle no-undo.
       76      define variable vBufSourseTable as handle no-undo.
       77      define variable vQuery          as handle no-undo.
       78      define variable vi as int64 no-undo.
       79      create buffer vBufTargetTable for table itable_new.
       80      vBufTargetTable:disable-load-triggers (false).
       81      create buffer vBufSourseTable for table itable_old.
       82      create query vQuery.
       83      vQuery:set-buffers(vBufSourseTable).
       84      vQuery:query-prepare("preselect EACH " + vBufSourseTable:name + " no-lock").
       85      vQuery:query-open().
       86      vQuery:get-first().
       87      do while vBufSourseTable:available:
       88         if vi mod 1000 = 0 then
       89           run putStatAsunc in this-procedure
       90             (substitute("Копирование данных в новую структуру. Oбработка таблицы &1. Обработано записей: &2 из &3.",
       91             itable_new, vi, vQuery:num-results)).
       92         do transaction:
       93            vBufTargetTable:buffer-create ().
       94            vBufTargetTable:buffer-copy (vBufSourseTable).
       95            vBufTargetTable:buffer-release ().
       96            vBufSourseTable:find-current (exclusive-lock).
       97            vBufSourseTable:buffer-delete ().
       98         end.
       99         vi = vi + 1.
      100         vQuery:get-next().
      101      end.
      102      vQuery:query-close().
      103      delete object vQuery.
      104      delete object vBufTargetTable.
      105      delete object vBufSourseTable.
      106   end.
