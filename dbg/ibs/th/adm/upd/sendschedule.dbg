        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define new global shared variable g#library  as handle no-undo .
        6   define new global shared variable g#library2 as handle no-undo .
        7   define   shared variable g#auto as logical no-undo.
        8   define   shared variable g#news as logical no-undo.
        9   define   shared variable g#oxml as logical no-undo.
       10   define   shared variable g#esys as logical no-undo.
       11   define   shared variable g#news-source-db as integer no-undo.
       12   define   shared variable g#esys-source-esys as integer no-undo.
       13   define   shared variable g#db-num as integer   no-undo .
       14   define   shared variable g#userid as character no-undo .
       15   define   shared variable g#passwd as character no-undo .
       16   define variable v-user-login as character no-undo .
       17   define variable v-user-id as character no-undo .
       18   define variable v-shift-num as integer no-undo .
       19   define variable v-shift-date as date no-undo .
       20   define variable v-free-id as character no-undo .
       21   define variable v-value    as character no-undo .
       22   define variable v-type     as character no-undo .
       23   define variable v-dopi1 as integer no-undo .
       24   define variable v-dopi2 as integer no-undo .
       25   define buffer buf_shift-obj for ub.shift-obj .
       26   define buffer buf_schedule for ub.schedule .
       27   define buffer buf_schedule-attr for ub.schedule-attr.
       28   define buffer buf_sys-ctrl for ub.sys-ctrl .
       29   define buffer buf_clients for ub.clients .
       30   define buffer buf_db-attr for ub.db-attr .
       31   define buffer buf_ruledict for ub.ruledict .
       32   run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-type) no-error.
       33   if v-value = "no"
       34   then do:
       35     return .
       36   end .
       37   find first buf_sys-ctrl no-lock no-error.
       38   if not available buf_sys-ctrl
       39   then do :
       40     return error return-value .
       41   end .
       42   find first buf_ruledict no-lock where buf_ruledict.entry-id = 0  no-error.
       43   if available buf_ruledict
       44   then do :
       45     assign
       46       v-dopi1 = integer(entry(2, buf_ruledict.documentation,  "."))
       47       v-dopi2 = integer(entry(2, entry(1, buf_ruledict.documentation, "."), "_"))
       48     no-error .
       49     if not error-status:error
       50     then do :
       51       if v-dopi2 = 0
       52       then do :
       53         if v-dopi1 < 13
       54         then do :
       55           return .
       56         end .
       57       end .
       58     end .
       59   end .
       60   find first buf_db-attr no-lock where buf_db-attr.db-num = buf_sys-ctrl.db-num
       61                                    and buf_db-attr.attr-code = "schedule-sent"
       62                                    no-error .
       63   if available buf_db-attr
       64   and logical(buf_db-attr.attr-value)
       65   then do :
       66     return .
       67   end .
       68   find first buf_clients no-lock where buf_clients.obj-type = 'маг'
       69                                    and buf_clients.db-num = buf_sys-ctrl.db-num
       70                                    no-error .
       71   if not available buf_clients
       72   then do :
       73     if buf_sys-ctrl.db-num = 0
       74     then do :
       75       return .
       76     end .
       77     return error "В базе данных не найден магазин" .
       78   end .
       79   v-shift-num = 0 .
       80   v-shift-date = ? .
       81   for first buf_shift-obj
       82       where buf_shift-obj.obj-type = buf_clients.obj-type
       83         and buf_shift-obj.obj-code = buf_clients.obj-code
       84         and buf_shift-obj.status_ = "тек"
       85       use-index stts :
       86     assign
       87       v-shift-date = buf_shift-obj.shift-date
       88       v-shift-num  = buf_shift-obj.shift-num
       89     .
       90   end.
       91   if v-shift-date = ? then v-shift-date = today .
       92   for each buf_schedule no-lock where buf_schedule.cre-db-num = buf_clients.db-num :
       93     if buf_schedule.task-type = "autofree"
       94     then do :
       95       find first buf_schedule-attr no-lock
       96           where buf_schedule-attr.cre-db-num = buf_schedule.cre-db-num
       97             and buf_schedule-attr.task-type  = buf_schedule.task-type
       98             and buf_schedule-attr.task-num   = buf_schedule.task-num
       99             and buf_schedule-attr.attr-code  begins  ("schd-free-id" + chr(4))
      100       no-error .
      101       if available buf_schedule-attr then
      102       assign
      103       v-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      104       no-error
      105       .
      106     end .
      107     run trg/userlog.p (
      108             input 'schedule'
      109           , input ("Первичная отправка в 1С расписания автозаданий на объекте " +
      110                   buf_clients.obj-type + string(buf_clients.obj-code) + ";" +
      111                   buf_schedule.task-type + ";" +
      112                   (if buf_schedule.task-type = "autofree" then v-free-id else "0") + ";" +
      113                     string(buf_schedule.task-num) + "|" +
      114                     (if buf_schedule.active then "1" else "0") + "|" +
      115                     buf_schedule.task-year + "|" +
      116                     buf_schedule.task-month + "|" +
      117                     buf_schedule.task-day + "|" +
      118                     buf_schedule.task-weekday + "|" +
      119                     buf_schedule.task-hour + "|" +
      120                     buf_schedule.task-minute +
      121                   chr(3) +
      122                   buf_clients.obj-type + chr(6) +
      123                   string(buf_clients.obj-code) + chr(6) +
      124                   string(v-shift-date) + chr(6) +
      125                   string(v-shift-num) + chr(6) +
      126                   buf_schedule.task-type + chr(6) +
      127                   (if buf_schedule.task-type = "autofree" then v-free-id else "0") + chr(6) +
      128                   string(buf_schedule.task-num) + chr(6) +
      129                   (if buf_schedule.active then "1" else "0") + chr(6) +
      130                   buf_schedule.task-year + chr(6) +
      131                   buf_schedule.task-month + chr(6) +
      132                   buf_schedule.task-day + chr(6) +
      133                   buf_schedule.task-weekday + chr(6) +
      134                   buf_schedule.task-hour + chr(6) +
      135                   buf_schedule.task-minute + chr(6) +
      136                   "chg" + chr(6) +
      137                   buf_schedule.db-num-char )
      138           , input ?
      139           , input ?
      140           , input ""
      141           ) no-error .
      142     if error-status:error
      143     then do :
      144       return error return-value .
      145     end .
      146   end .
      147   create buf_db-attr .
      148   assign
      149     buf_db-attr.db-num = buf_sys-ctrl.db-num
      150     buf_db-attr.attr-code = "schedule-sent"
      151     buf_db-attr.attr-value = string(yes)
      152   .
      153   return.
