        1   define input  parameter iParam as character no-undo.
        2   define output parameter oOk as logical no-undo.
        3   define variable vi as integer no-undo.
        4   function Checktable returns logical (itable as character) forward.
        5   do vi = 1 to num-entries (iParam,"|"):
        6      if not Checktable(entry(vi,iParam,"|")) then  return.
        7   end.
        8   ook = yes.
        9   return.
       10   function Checktable returns logical (itable as character):
       11      define variable vBufTable as handle no-undo.
       12      define variable vQuery          as handle no-undo.
       13      define variable vOk             as logical no-undo.
       14      create buffer vBufTable for table itable.
       15      create query vQuery.
       16      vQuery:set-buffers(vBufTable).
       17      vQuery:query-prepare("for each " + vBufTable:name + " no-lock").
       18      vQuery:query-open().
       19      vQuery:get-first().
       20      vOk = not vBufTable:available.
       21      vQuery:query-close().
       22      delete object vQuery.
       23      delete object vBufTable.
       24      return vOk.
       25   end.
