        1   using Progress.Lang.*.
        2   using ibs.th.adm.upd.*.
        3   block-level on error undo, throw.
        4   class ibs.th.adm.upd.CheckUpd:
        5      constructor public CheckUpd (  ):
        6         this-object (yes).
        7      end constructor.
        8      define variable obsrvdbObj as class observupd no-undo.
        9      define property TargetDBShm as integer no-undo
       10         get.
       11         private set.
       12      define property CurrDBShm as integer  no-undo
       13         get.
       14         private set.
       15      define property isNeedUpd as logical no-undo
       16      get:
       17         return updChceck().
       18      end.
       19      define property isRcode as logical init ? no-undo
       20      get:
       21         if isRcode eq ?
       22         then do:
       23            def var loadDFProcFile as char no-undo.
       24            loadDFProcFile = search ("ibs/th/adm/upd/loaddf.r").
       25            isRcode = loadDFProcFile ne ?.
       26         end.
       27         return isRcode.
       28      end.
       29      set.
       30      define variable IQS as logical no-undo.
       31      constructor public CheckUpd (IQS as logical):
       32         this-object:IQS = IQS.
       33      end constructor.
       34      define variable mupd as logical no-undo init yes.
       35      method public logical updChceck ():
       36         define variable isNeedUpd as logical no-undo.
       37         obsrvdbObj = new observupd ().
       38         isNeedUpd = obsrvdbObj:isneedupg(yes).
       39         CurrDBShm   = obsrvdbObj:CurrDBShm.
       40         TargetDBShm = obsrvdbObj:TargetDBShm.
       41         if not isNeedUpd
       42         then
       43            run utl\chekupd.p (yes,TargetDBShm, output isNeedUpd).
       44         if  not session:batch-mode and IQS and not isRcode and isNeedUpd
       45         then do:
       46            if(mupd) then do:
       47            message "Необходимо обновить базу с версии " CurrDBShm  " до " TargetDBShm " до запуска процесса. Остновить выполнение?" view-as alert-box question
       48                buttons yes-no title "[ ВНИМАНИЕ! ]" update isNeedUpd.
       49            mupd = false.
       50            end.
       51            else
       52               isNeedUpd = false.
       53         end.
       54         delete object obsrvdbObj.
       55         return isNeedUpd.
       56      end.
       57            define property isStopWork as logical no-undo
       58      get:
       59         return search("cmp/UpdWorkStop.txt") ne ?.
       60      end.
       61      define stream sOut.
       62      method public void workStop ():
       63         define variable vFile as character no-undo.
       64         define variable vPName as integer no-undo.
       65         vFile = search("cmp/update.bmp").
       66         if vfile eq ?
       67         then
       68            vFile = "cmp/UpdWorkStop.txt".
       69         else
       70            vFile = replace(vFile,"cmp/update.bmp","cmp/UpdWorkStop.txt" ).
       71         output stream sOut to vFile.
       72         put stream sOut unformatted "Stop update " now skip.
       73         do vPName = 1 to 100:
       74            if  program-name(vPName) = ? then  leave .
       75            put stream sOut (if  vPName ne 1 then  "" else  "->")  program-name (vPName) .
       76         end.
       77         output stream sOut close.
       78      end.
       79      method public void workStart ():
       80         define variable vFile as character no-undo.
       81         vFile = search("cmp/UpdWorkStop.txt").
       82         os-delete value(vFile).
       83      end.
       84      destructor public CheckUpd ( ):
       85      end destructor.
       86   end class.
