        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define variable mAsyncProc as class ibs.th.file.AsyncProc.
        6   run ibs\th\file\getasyncproc.p (output mAsyncProc).
        7   define variable mstopAsunc as logical no-undo.
        8   function StopCheck returns logical:
        9      define variable oFlag as logical no-undo.
       10      run StopCheckAsync (output oFlag).
       11      return oFlag.
       12   end.
       13   procedure StopCheckAsync:
       14       define output  parameter oFlag as logical no-undo.
       15       if mstopAsunc
       16       then
       17          oFlag = mstopAsunc.
       18       else do:
       19          oFlag = mAsyncProc:CheckStop().
       20          mstopAsunc = oFlag.
       21       end.
       22   end.
       23   function GetParamAsunc returns character
       24   (input iNumPar as integer  ):
       25      return mAsyncProc:GetPARAM(iNumPar).
       26   end.
       27   function GetParamAsuncStr returns ibs.th.file.asyncparam
       28   (input iParamName as character ):
       29      return mAsyncProc:GetPARAM(iParamName).
       30   end.
       31   procedure PutMesAsunc:
       32       define input  parameter Itext as character no-undo.
       33       define variable vflag as logical no-undo.
       34       Publish "WriteLogAsunc" (Itext, yes)  .
       35   end.
       36   procedure PutMesAsuncNoTime:
       37       define input  parameter Itext as character no-undo.
       38       define variable vflag as logical no-undo.
       39       Publish "WriteLogAsunc" (Itext,no)  .
       40   end.
       41   procedure PutStatAsunc:
       42       define input  parameter Itext as character no-undo.
       43       Publish "PutStatAsunc" (Itext,no) .
       44        run
       45       PutMesAsunc (itext).
       46   end.
       47   procedure PutStatAsuncNoTime:
       48       define input  parameter Itext as character no-undo.
       49       Publish "PutStatAsunc" (Itext,no)  .
       50        run
       51       PutMesAsuncNoTime (itext).
       52   end.
       53   procedure PutStatAsuncAdd:
       54       define input  parameter Itext as character no-undo.
       55       Publish "PutStatAsunc" (Itext,yes)  .
       56   end.
       57   procedure PutFileLogAsunc:
       58       define input  parameter IFile as character no-undo.
       59       Publish "PutFileLogAsunc" (ifile)  .
       60   end.
       61          mAsyncProc:mProcPublish = this-procedure.
       62   function objExists return character
       63   (input  ifolder as character,
       64    input  iType   as character  ):
       65       define variable vFileType as character no-undo init "D,F".
       66       define variable vi        as integer no-undo.
       67       define variable vtype as character no-undo.
       68       if iType ne ?
       69       then
       70          vFileType = iType.
       71       do vi = 1 to num-entries(vFileType):
       72          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       73          vtype = file-information:file-type.
       74          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       75             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       76             index(vtype , entry(vi,vFileType )) > 0
       77          then return file-information:full-pathname .
       78          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       79          vtype = file-information:file-type.
       80          if file-information:file-name <> "" and
       81             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       82             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       83             index( vtype, entry(vi,vFileType )) > 0
       84          then return file-information:full-pathname .
       85       end.
       86       return ? .
       87   end.
       88   function SearchFile return character
       89   (input  ifile as character):
       90      return objExists(ifile,?).
       91   end.
       92   function SearchPFile return character
       93   (input inFile as char):
       94        define variable oFile       as character no-undo.
       95        define variable vFileSearch as character no-undo.
       96        define variable vNumEntry   as integer no-undo.
       97        if inFile = "" then return ?.
       98        vNumEntry = num-entries(inFile,".").
       99        vFileSearch = inFile.
      100        if    vNumEntry > 0
      101           and (   entry(vNumEntry,inFile,".") eq "p"
      102                or entry(vNumEntry,inFile,".") eq "w")
      103        then do:
      104           entry(vNumEntry,vFileSearch, ".") = "r".
      105           oFile = search(vFileSearch ).
      106           if oFile eq ?
      107           then
      108              oFile = search(inFile).
      109        end.
      110        else
      111           oFile = search(vFileSearch).
      112        return oFile.
      113     end.
      114   current-window:hidden = yes.
      115   define input  parameter iparam as character no-undo.
      116   run PutMesAsunc ("Загружаем df в базу" ).
      117   run PutFileLogAsunc(iparam).
      118   os-delete "ub.e".
      119   run prodict/load_df.r (iparam + ",no") no-error.
      120   define variable mfile as character no-undo.
      121   mfile = searchFile("ub.e").
      122   file-info:file-name = mfile.
      123   if file-info:file-name ne ? and
      124     file-info:file-size ne 0
      125   then do:
      126      run PutMesAsunc ("Error Ошибка обновления БД" ).
      127      run PutFileLogAsunc(mfile).
      128   end.
