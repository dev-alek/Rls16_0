        1   using Progress.Lang.*.
        2   using ibs.th.adm.upd.*.
        3   class ibs.th.adm.upd.updschm:
        4   define variable vss-revision    as character no-undo init "$Revision:$":U .
        5   define variable vss-author      as character no-undo init "$Author:$":U .
        6   define variable vss-date        as character no-undo init "$Date:$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        8   define variable vss-archive     as character no-undo init "$Archive:$":U .
        9   define variable vss-description as character no-undo init "Обновление БД.".
       10     define variable loadDFprocFile as character no-undo.
       11     define property TargetDBShm as integer no-undo
       12       get.
       13       private set.
       14     define property CurrDBShm as integer  no-undo
       15       get.
       16       private set.
       17     define property NewCurrDBShm as integer  no-undo
       18       get.
       19       private set.
       20     define property CurrDB0Shm as integer  no-undo
       21       get.
       22       private set.
       23     define private property QuestionUpd as logical no-undo  init yes
       24       get.
       25       set.
       26     define private property UpdAllDB as logical no-undo init yes
       27       get.
       28       set.
       29     define private property UpdPart as  logical no-undo init yes
       30       get.
       31       set.
       32     define private property silent as logical no-undo
       33       get.
       34       set.
       35     define private property changPath as logical no-undo
       36       get.
       37       set.
       38     define private property UpdBlank as logical no-undo
       39       get.
       40       set.
       41     define private property ModeUpd as character  no-undo
       42       get.
       43       set (iarg as character ):
       44          modeupd = iarg.
       45          if lookup("OneDf",iarg) ne 0
       46          then do:
       47             QuestionUpd = no.
       48             UpdAllDB    = yes.
       49             UpdPart     = no.
       50             silent      = yes.
       51          end.
       52          else do:
       53             QuestionUpd = lookup("iscomp",iarg) eq 0 and lookup("UpdBlank",iarg) eq 0.
       54             UpdAllDB    = lookup("iscomp",iarg) eq 0 and lookup("UpdBlank",iarg) eq 0.
       55             UpdPart     = lookup("iscomp",iarg) eq 0 and lookup("UpdBlank",iarg) eq 0.
       56             silent      = lookup("updblank",iarg) ne 0.
       57             changPath   = lookup("iscomp",iarg) ne 0.
       58             UpdBlank    = lookup("UpdBlank",iarg) ne 0.
       59          end.
       60       end.
       61     define property ConPar as character no-undo
       62       get.
       63       set (arg as char):
       64         if arg begins "iscomp|"
       65         then do:
       66            modeupd = "iscomp".
       67            arg = entry(2,arg,"|").
       68         end.
       69         ConPar = replace (arg, "&1", "").
       70       end.
       71     define property isUpdShm as logical no-undo init yes
       72       get.
       73       private set.
       74     define property isNeedUpd as logical no-undo
       75     get.
       76     private set.
       77     define property PublisHandle as handle  no-undo
       78       get.
       79       private set.
       80     define property DbNum as integer init ?  no-undo
       81       get.
       82       private set.
       83     define property IsErr as logical no-undo
       84       get.
       85       private set.
       86     define property Msg as character no-undo
       87       get.
       88       private set.
       89     define private variable myUser         as character no-undo .
       90     define private variable myPasswd       as character no-undo .
       91     define property m-user-passwd-upd   as character no-undo
       92     get:
       93        define variable vpas as character no-undo.
       94        vpas = myPasswd  no-error.
       95        if vpas begins "nocrypt:"
       96        then
       97           vpas = substring (vpas,9).
       98        return substitute(' -U &1 -P "&2"':U
       99                                   ,myUser
      100                                   ,vpas
      101                                   ).
      102     end.
      103     define property isRcode as logical init ? no-undo
      104     get:
      105         if isRcode eq ?
      106         then do:
      107            def var loadDFProcFile as char no-undo.
      108            loadDFProcFile = search ("ibs/th/adm/upd/loaddf.r").
      109            isRcode = loadDFProcFile ne ?.
      110         end.
      111         return isRcode.
      112     end.
      113     set.
      114     define variable obsrvdbObj as class observupd no-undo.
      115     define variable analisdfObj as class analisdf no-undo.
      116     define private variable m-prowin32FileName  as character no-undo.
      117     define private variable m-FileDf            as character no-undo.
      118     define private variable m-Batch             as logical   no-undo.
      119     define variable mDfUpdaLL as character no-undo.
      120     define stream sReadfile.
      121     constructor public updschm ():
      122        this-object (yes).
      123     end constructor.
      124     constructor public updschm (IQS as logical):
      125        putStat ("Установка контекста для проверки обновления ... ").
      126        obsrvdbObj = new observupd ().
      127        obsrvdbObj:ModeUpd = modeupd.
      128        obsrvdbObj:PublisHandle = PublisHandle.
      129        isNeedUpd = obsrvdbObj:isneedupg(yes).
      130        CurrDBShm   = obsrvdbObj:CurrDBShm.
      131        CurrDB0Shm  = obsrvdbObj:CurrDB0Shm.
      132        DbNum       = obsrvdbObj:DbNum.
      133        TargetDBShm = obsrvdbObj:TargetDBShm.
      134        if not isNeedUpd
      135        then
      136           run utl\chekupd.p (yes,TargetDBShm, output isNeedUpd).
      137        if IQS and not isRcode and isNeedUpd
      138        then
      139           message "Необходимо обновить базу с версии " CurrDBShm  " до " TargetDBShm " до запуска процесса. Остновить выполнение?" view-as alert-box question
      140                buttons yes-no title "[ ВНИМАНИЕ! ]" update isNeedUpd.
      141        delete object obsrvdbObj.
      142        putStat  ("Установка контекста для проверки обновления завершена").
      143     end constructor.
      144     constructor public updschm (input inConPar as char,input iMode as character,ipubhan as handle,iDfFile as character ):
      145       putStat  ("Установка контекста для обновления ...").
      146       define variable vupd as logical no-undo.
      147       define variable vok  as logical no-undo.
      148       modeupd = iMode.
      149       PublisHandle = iPubHan.
      150       ConPar      = inConPar.
      151       obsrvdbObj = new observupd ().
      152       obsrvdbObj:modeupd = modeupd.
      153       if iDfFile eq ?
      154       then do:
      155          obsrvdbObj:PublisHandle = PublisHandle.
      156          CurrDBShm   = obsrvdbObj:CurrDBShm.
      157          CurrDB0Shm  = obsrvdbObj:CurrDB0Shm.
      158          DbNum       = obsrvdbObj:DbNum.
      159          TargetDBShm = obsrvdbObj:TargetDBShm.
      160          m-FileDf    = obsrvdbObj:upd-df.
      161          isNeedUpd = obsrvdbObj:isneedupg(yes).
      162          if not isNeedUpd
      163          then
      164             run utl\chekupd.p (yes,TargetDBShm, output isNeedUpd).
      165          if QuestionUpd and not isRcode and isNeedUpd
      166          then do:
      167             putStat  ("Предоставлен выбор пользователя обновлять Бд или нет").
      168             message "Обновить базу с версии " CurrDBShm  " до " TargetDBShm "?" view-as alert-box question
      169                buttons yes-no title "[ ВНИМАНИЕ! ]" update vupd.
      170             if not vupd
      171             then do:
      172                putStat  ("Пользователя отказался от обновления Бд").
      173                isNeedUpd = no.
      174                return.
      175             end.
      176             else
      177                putStat  ("Пользователя согласился на обновление Бд").
      178          end.
      179          isNeedUpd = obsrvdbObj:isneedupg().
      180          if obsrvdbObj:IsErr
      181          then do:
      182            Msg = obsrvdbObj:Msg.
      183            IsErr = true.
      184          end.
      185          run utl\chekupd.p (no, TargetDBShm , output vok).
      186          if not vok
      187          then do:
      188             msg = return-value.
      189             IsErr = true.
      190          end.
      191       end.
      192       else do:
      193         isNeedUpd = yes.
      194         CurrDBShm   = -10.
      195         TargetDBShm = CurrDBShm.
      196         analisdfObj = new analisdf ().
      197         analisdfObj:modeupd = modeupd.
      198         if analisdfObj:readDF(iDfFile)
      199         then do:
      200            Msg =
      201              substitute("Ошибка при обновлении схемы базы данных &1&2",  chr(10) ,
      202              analisdfObj:msg)
      203            .
      204            IsErr = true.
      205         end.
      206         else do:
      207            mDfUpdaLL = replace(iDfFile,".df","_new.df").
      208            analisdfObj:dumpTable(mDfUpdaLL).
      209         end.
      210         delete object analisdfObj.
      211       end.
      212       assign
      213          myUser   = "sysadm".
      214          myPasswd = substitute("nocrypt:&1":U
      215                                   ,obsrvdbObj:pwd
      216                                   )
      217       .
      218       delete object obsrvdbObj.
      219       loadDFProcFile = search ("ibs/th/adm/upd/loaddf.r").
      220       if loadDFProcFile eq ?
      221       then
      222          loadDFProcFile = search ("ibs/th/adm/upd/loaddf.p").
      223       m-prowin32FileName =  search ("bin/prowin32.exe").
      224       putStat  ("Установка контекста для обновления завершена").
      225     end constructor.
      226     constructor public updschm (input inConPar as char,input iMode as character,ipubhan as handle):
      227          this-object(inConPar,input iMode,ipubhan,?).
      228     end.
      229     constructor public updschm (input inConPar as char ):
      230        this-object(input inConPar,"").
      231     end.
      232     constructor public updschm (input inConPar as char,input iMode as character):
      233        this-object(input inConPar,"",?).
      234     end.
      235     method public void upddbshm ():
      236       define variable vI as integer no-undo.
      237       define variable vdbconect as logical no-undo.
      238       if  CurrDBShm eq TargetDBShm
      239       then
      240          vdbconect = yes.
      241       putStat  ("Обновление Бд").
      242       upddbshmall().
      243       if isUpdShm
      244          and UpdAllDB
      245       then do:
      246            disconnect value ('ub').
      247         do vi = 1 to num-entries(mDfUpdaLL):
      248            upddbshm-1(entry(vi,mDfUpdaLL)).
      249         end.
      250       end.
      251       return.
      252     end.
      253     method public void upddbshmall():
      254       Block-UpdOne:
      255       do while CurrDBShm < TargetDBShm :
      256         isUpdShm = no.
      257         upddbshmAllOneDf().
      258         if isErr
      259         then
      260           leave Block-UpdOne.
      261       end.
      262       if isErr
      263       then do:
      264          if not UpdPart
      265          then
      266             putmes("Ошибка обновления БД.").
      267          else do:
      268             putmes("Ошибка обновления БД. Попробуем обновить по частям").
      269             isErr = no.
      270             Block-UpdOneTry:
      271             do while CurrDBShm < TargetDBShm :
      272                isUpdShm = no.
      273                upddbshmOne().
      274                if isErr
      275                then
      276                   leave Block-UpdOneTry.
      277             end.
      278          end.
      279       end.
      280     end method.
      281     method public void upddbshmAllOneDf ():
      282       if not connected ("ub")
      283       then
      284          connect value(substitute(ConPar + " &1", m-user-passwd-upd)).
      285       if CurrDBShm < TargetDBShm
      286       then do:
      287         analisdfObj = new analisdf ().
      288         analisdfObj:modeupd = modeupd.
      289         analisdfObj:PublisHandle = PublisHandle.
      290         putstat(substitute ("Получение файла обновления для версии &1",CurrDBShm)).
      291         if  analisdfObj:createDF(CurrDBShm)
      292         then do:
      293            assign
      294               m-FileDf     = analisdfObj:mFileDf
      295               NewCurrDBShm = analisdfObj:mUpdateTo
      296            .
      297            putstat(substitute ("Получен файла обновления &1 c версии &2 до версии &3",m-FileDf,CurrDBShm,NewCurrDBShm)).
      298         end.
      299         else
      300            isErr = yes.
      301         if isErr then
      302         do:
      303           Msg =
      304             substitute("Ошибка при обновлении схемы базы данных &1&2",  chr(10) ,
      305             analisdfObj:msg)
      306             .
      307           putstat(Msg).
      308           IsErr = true.
      309           return.
      310         end.
      311         delete object analisdfObj no-error.
      312         disconnect value ('ub').
      313         upddbshm-1(m-FileDf).
      314         if isErr then
      315         do:
      316           Msg =
      317             substitute("Ошибка при обновлении схемы базы данных &1&2 &1&3",  chr(10) ,
      318             error-status :get-message(1) ,
      319             return-value)
      320             .
      321           putStat(MSG).
      322           IsErr = true.
      323         end.
      324         connect value(substitute(ConPar + " &1", m-user-passwd-upd)).
      325       end.
      326        analisdfObj = new analisdf ().
      327        analisdfObj:modeupd = modeupd.
      328        analisdfObj:PublisHandle = PublisHandle.
      329        def var m-FileDf_new as char no-undo.
      330        putstat(substitute ("Получение файла проверки с версии &1",CurrDBShm)).
      331        if analisdfObj:createDF(CurrDBShm)
      332        then do:
      333           m-FileDf     = analisdfObj:mFileDf.
      334           m-FileDf_new = replace (m-FileDf,"~/","~\").
      335           entry(num-entries (m-FileDf_new,"~\"),m-FileDf_new,"~\") = "new_" + entry(num-entries (m-FileDf_new,"~\"),m-FileDf_new,"~\").
      336           if not analisdfObj:CheckTable(m-FileDf_new)
      337           then do:
      338              IsErr = true.
      339              delete object analisdfObj no-error.
      340              putmes (substitute ("Поля не прошедшие проверку выгружены в файл &1",m-FileDf_new)).
      341              return.
      342           end.
      343        end.
      344        putstat(substitute ("Проверка прошла успешно.")).
      345        delete object analisdfObj no-error.
      346        obsrvdbObj = new observupd ().
      347       obsrvdbObj:ModeUpd = ModeUpd.
      348       obsrvdbObj:PublisHandle = PublisHandle.
      349       putstat(substitute ("Сохраняем версию БД.")).
      350       obsrvdbObj:writeResult(NewCurrDBShm).
      351       if obsrvdbObj:IsErr
      352       then do:
      353         Msg = obsrvdbObj:Msg.
      354         putstat(substitute ("Ошибка сохранения версии &1",Msg)).
      355         delete object obsrvdbObj no-error.
      356         IsErr = true.
      357         return.
      358       end.
      359       putstat(substitute ("Сохранена версия &1 БД.",NewCurrDBShm)).
      360       delete object obsrvdbObj no-error.
      361       CurrDBShm = NewCurrDBShm.
      362       isUpdShm = true.
      363     end method.
      364     method public void upddbshmOne ():
      365       if CurrDBShm < TargetDBShm
      366       then do:
      367         analisdfObj = new analisdf ().
      368         analisdfObj:modeupd = modeupd.
      369         analisdfObj:PublisHandle = PublisHandle.
      370         if  analisdfObj:createDF(CurrDBShm,CurrDBShm + 1)
      371         then do:
      372            assign
      373               m-FileDf     = analisdfObj:mFileDf
      374               NewCurrDBShm = analisdfObj:mUpdateTo
      375            .
      376         end.
      377         else
      378            isErr = yes.
      379         if isErr then
      380         do:
      381           Msg =
      382             substitute("Ошибка при обновлении схемы базы данных&1&2",  chr(10) ,
      383             analisdfObj:msg)
      384             .
      385           IsErr = true.
      386           return.
      387         end.
      388         if not m-FileDf begins "proc:"
      389         then
      390            m-FileDf = analisdfObj:addDFNumUpd(m-FileDf,CurrDBShm + 1).
      391         delete object analisdfObj no-error.
      392         disconnect value ('ub').
      393         upddbshm-1(m-FileDf).
      394         if isErr then
      395         do:
      396           Msg =
      397             substitute("Ошибка при обновлении схемы базы данных&1&2&1&3",  chr(10) ,
      398             error-status :get-message(1) ,
      399             return-value)
      400             .
      401           IsErr = true.
      402           return.
      403         end.
      404         connect value(substitute(ConPar + " &1", m-user-passwd-upd)).
      405       end.
      406       NewCurrDBShm = CurrDBShm + 1.
      407       obsrvdbObj = new observupd ().
      408       obsrvdbObj:ModeUpd = ModeUpd.
      409       obsrvdbObj:PublisHandle = PublisHandle.
      410       obsrvdbObj:writeResult(NewCurrDBShm).
      411       if obsrvdbObj:IsErr
      412       then do:
      413         Msg = obsrvdbObj:Msg.
      414         delete object obsrvdbObj no-error.
      415         IsErr = true.
      416         return.
      417       end.
      418       m-FileDf = obsrvdbObj:upd-df.
      419       delete object obsrvdbObj no-error.
      420       CurrDBShm = NewCurrDBShm.
      421       isUpdShm = true.
      422     end method.
      423     method private void upddbshm-1 (input iparam as character ):
      424       define variable vproc  as character no-undo.
      425       define variable vparam as character no-undo.
      426       if iparam begins "proc:"
      427       then do:
      428          assign
      429             iparam = substring (iparam,6)
      430             vproc  = entry(1,iparam,";")
      431             vparam = entry(2,iparam,";")
      432          no-error.
      433          putStat  (substitute ("Выполнение процедуры &1 ...",iparam)).
      434          if vproc ne ""
      435          then
      436             runsession (vproc,vparam).
      437          putStat  (substitute ("Выполнение процедуры &1 завершено",iparam)).
      438       end.
      439       else do:
      440          putStat  (substitute ("Загрузка данных из файла &1 ...",iparam)).
      441          loaddf (iparam).
      442          putStat  (substitute ("Загрузка данных из файла &1 завершена.",iparam)).
      443       end.
      444       if IsErr = true
      445         then return.
      446     end method.
      447     method private void loaddf (input inFileDF as char):
      448       def var v-filedfname as character no-undo.
      449       v-filedfname = search (inFileDF).
      450       if v-filedfname = ?
      451       then do:
      452         Msg = substitute ( "Файл &1 обновления схемы БД не найден. Работа с ней запрещена!", inFileDF).
      453         IsErr = true.
      454         return.
      455       end.
      456       runsession(loadDFprocFile,v-filedfname).
      457     end.
      458     method private void runsession (input iProc as char,input iParam as char):
      459        define variable vParamStart as character no-undo.
      460        if SearchPFile (iProc) eq ?
      461        then do:
      462           Msg = substitute ( "Не найден файл &1 !", iProc).
      463           putmes(msg).
      464           IsErr = true.
      465           return.
      466        end.
      467        else
      468           iProc = SearchPFile (iProc).
      469        if iproc eq loadDFprocFile and isRcode
      470        then
      471           vParamStart = vParamStart + " -rx  -clientlog  mylog.lg -logginglevel 1" .
      472       define variable vAsyncHelper as class ibs.th.file.AsyncHelperth no-undo.
      473       vAsyncHelper = new ibs.th.file.AsyncHelperth().
      474       vAsyncHelper:myUser = myUser.
      475       vAsyncHelper:myPass = myPasswd.
      476       vAsyncHelper:MyBachMode = no.
      477       vAsyncHelper:WritelogInter = 5.
      478       vAsyncHelper:mProcPublish = PublisHandle.
      479       vAsyncHelper:ChangProPath = changPath.
      480       vAsyncHelper:paramSession = vParamStart.
      481       vAsyncHelper:SetGblPar = false.
      482       if UpdBlank
      483       then do:
      484          vAsyncHelper:MyParamStart = " -ininame "  + GetStartupParam("-ininame") + " " + ConPar.
      485          vAsyncHelper:DbConnect  = no.
      486       end.
      487       vAsyncHelper:AsyncProc("utl/proc-anyproc", substitute("&1&3&2":U
      488                                                 , iProc
      489                                                 ,if iParam eq "" then "" else iParam ,
      490                                                  if iParam eq "" then "" else chr(4) ),1).
      491       run ibs\th\file\waithelper.p (vAsyncHelper,?, 1, substitute ("Обновление БД с &1 версии до &2 версии",CurrDBShm,NewCurrDBShm)).
      492       define variable vLogFile as character no-undo.
      493       define variable vSilent as logical no-undo.
      494       vSilent = silent.
      495       silent = yes.
      496       vLogFile = searchfile(vAsyncHelper:getLog(?)).
      497       if vLogFile ne ?
      498       then do:
      499          input STREAM sReadfile FROM  VALUE(vLogFile).
      500          block-read:
      501          repeat:
      502             define variable vstr as character no-undo.
      503             import stream sReadfile unformatted vStr.
      504             putmes (vStr).
      505             define variable vtext1 as character no-undo.
      506             define variable vtext3 as character no-undo.
      507             assign
      508                vtext1 = entry(1,vStr," ")
      509                vtext3 = entry(3,vStr," ")
      510             no-error.
      511             if    vtext1 = "error"
      512                or vtext3 = "error"
      513             then do:
      514                IsErr = yes.
      515             end.
      516          end.
      517          input stream sReadfile close.
      518       end.
      519       silent = vSilent.
      520       delete object vAsyncHelper.
      521     end method.
      522      method public character GetStartupParam (input iParam as character  ):
      523      define variable vStartupParameters as character no-undo.
      524      vStartupParameters = session:startup-parameters.
      525      define variable vNumStartupParameters as integer no-undo.
      526      vNumStartupParameters = num-entries( vStartupParameters ).
      527      define variable i as integer no-undo.
      528         block-par:
      529      do i = 1 to vNumStartupParameters:
      530         define variable vParameter as character no-undo.
      531         vParameter = entry( i, vStartupParameters ).
      532         if vParameter begins iParam then
      533         do:
      534            define variable vList as character no-undo.
      535            vList  = entry(2,vParameter,' ').
      536         end.
      537      end.
      538      return vList.
      539      end method.
      540      method public void putmes (input itext as char):
      541       if not silent
      542       then do:
      543          message itext
      544          view-as alert-box.
      545       end.
      546       if valid-handle(PublisHandle)
      547       then
      548          publish "WriteLogAsunc" from PublisHandle (itext,yes ).
      549      end.
      550      method public void putstat (input itext as char):
      551         if valid-handle(PublisHandle)
      552        then
      553           publish "PutStatAsunc"  from PublisHandle (itext, no ).
      554      end.
      555   method public character objExists
      556   (input  ifolder as character,
      557    input  iType   as character  ):
      558       define variable vFileType as character no-undo init "D,F".
      559       define variable vi        as integer no-undo.
      560       define variable vtype as character no-undo.
      561       if iType ne ?
      562       then
      563          vFileType = iType.
      564       do vi = 1 to num-entries(vFileType):
      565          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      566          vtype = file-information:file-type.
      567          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      568             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      569             index(vtype , entry(vi,vFileType )) > 0
      570          then return file-information:full-pathname .
      571          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      572          vtype = file-information:file-type.
      573          if file-information:file-name <> "" and
      574             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      575             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      576             index( vtype, entry(vi,vFileType )) > 0
      577          then return file-information:full-pathname .
      578       end.
      579       return ? .
      580   end.
      581   method public character SearchFile
      582   (input  ifile as character):
      583      return objExists(ifile,?).
      584   end.
      585   method public character SearchPFile
      586   (input inFile as char):
      587        define variable oFile       as character no-undo.
      588        define variable vFileSearch as character no-undo.
      589        define variable vNumEntry   as integer no-undo.
      590        if inFile = "" then return ?.
      591        vNumEntry = num-entries(inFile,".").
      592        vFileSearch = inFile.
      593        if    vNumEntry > 0
      594           and (   entry(vNumEntry,inFile,".") eq "p"
      595                or entry(vNumEntry,inFile,".") eq "w")
      596        then do:
      597           entry(vNumEntry,vFileSearch, ".") = "r".
      598           oFile = search(vFileSearch ).
      599           if oFile eq ?
      600           then
      601              oFile = search(inFile).
      602        end.
      603        else
      604           oFile = search(vFileSearch).
      605        return oFile.
      606     end.
      607   end class.
