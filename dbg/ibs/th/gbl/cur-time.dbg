        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.cur-time:
        4     define property ReturnMsg as character no-undo
        5       get.
        6       private set.
        7     define variable hndl-proc-curtime as handle.
        8     constructor public cur-time ():
        9       run gbl\cur-time.p persistent (output hndl-proc-curtime) no-error.
       10     end constructor.
       11     method public void CurTime (
       12       output p-today      as date,
       13       output p-time       as integer ):
       14       run cur-time in hndl-proc-curtime ( output p-today
       15         ,output p-time) no-error.
       16       if error-status:error
       17         then
       18       do:
       19       end.
       20     end.
       21     destructor public cur-time ():
       22       delete object hndl-proc-curtime no-error.
       23       if error-status:error
       24         then
       25       do:
       26       end.
       27     end destructor.
       28   end class.
