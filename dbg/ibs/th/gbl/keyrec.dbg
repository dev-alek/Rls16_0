        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.keyrec inherits ibs.th.gbl.sys.objth:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override public property vss-description as character no-undo init "Бибилиотека для работы с Key-Rec" get.
       10     define property ReturnMsg as character no-undo
       11       get.
       12       private set.
       13     define property Err as logical no-undo
       14       get.
       15       private set.
       16     define property g#news as logical no-undo
       17       get.
       18       private set.
       19     define variable hndl-proc-key-rec as handle.
       20     constructor public keyrec ():
       21       run gbl\key-rec.p persistent (output hndl-proc-key-rec) no-error.
       22       if error-status:error
       23       then
       24          message error-status:get-message(1) view-as alert-box.
       25     end constructor.
       26     method public void GenKeyRec (
       27       input  p-tbl-name    as character,
       28       input  p-bh_tbl-name as handle,
       29       output p-key-rec     as character ):
       30       run gen-key-rec in hndl-proc-key-rec ( input p-tbl-name
       31                                             ,input p-bh_tbl-name
       32                                             ,output p-key-rec) no-error.
       33       if error-status:error
       34       then do:
       35         ReturnMsg = return-value.
       36         Err = true.
       37       end.
       38     end.
       39     method public void GenRowKeyr (
       40       input p-key-rec    as character,
       41       input p-key-handle as handle   ,
       42       input p-db-name    as character,
       43       input p-tt-handle  as handle   ,
       44       input p-stts-lock  as integer  ,
       45       output p-tbl-row   as rowid    ,
       46       output p-tbl-name  as character
       47     ):
       48       run gen-row-keyr in hndl-proc-key-rec (  input p-key-rec
       49                                               ,input p-key-handle
       50                                               ,input p-db-name
       51                                               ,input p-tt-handle
       52                                               ,input p-stts-lock
       53                                               ,output p-tbl-row
       54                                               ,output p-tbl-name) no-error.
       55       if error-status:error
       56       then do:
       57         ReturnMsg = return-value.
       58         Err = true.
       59       end.
       60     end.
       61     method public void GenKeyFv (
       62       input p-key-rec     as character,
       63       output p-field-list as character,
       64       output p-value-list as character
       65     ):
       66       run gen-key-fv in hndl-proc-key-rec ( input p-key-rec
       67                                            ,output p-field-list
       68                                            ,output p-field-list) no-error.
       69       if error-status:error
       70       then do:
       71         ReturnMsg = return-value.
       72         Err = true.
       73       end.
       74     end.
       75      method public void GenHnKeyrTab
       76      (input  i-tableSerach as character,
       77       input  i-tablekey    as character,
       78       input  p-key-rec     as character,
       79       input  p-key-handle  as handle,
       80       input  p-db-name    as character,
       81       input  p-tt-handle  as handle,
       82       input  p-stts-lock  as integer,
       83       output o-hn         as handle )
       84       :
       85          run gen-hn-keyr-tab in hndl-proc-key-rec (
       86                  input  i-tableSerach,
       87                  input  i-tablekey ,
       88                  input  p-key-rec,
       89                  input  p-key-handle ,
       90                  input  p-db-name  ,
       91                  input  p-tt-handle,
       92                  input  p-stts-lock ,
       93                  output o-hn   ).
       94      end method.
       95      method public void GenWhereKeyrTab
       96      (input  i-tableSerach as character,
       97       input  i-tablekey    as character,
       98       input  p-key-rec     as character,
       99       input  p-key-handle  as handle,
      100       input  p-db-name    as character,
      101       input  p-tt-handle  as handle,
      102       output o-where      as character  )
      103       :
      104          run gen-Where-keyr-tab in hndl-proc-key-rec (
      105                  input  i-tableSerach,
      106                  input  i-tablekey ,
      107                  input  p-key-rec,
      108                  input  p-key-handle ,
      109                  input  p-db-name  ,
      110                  input  p-tt-handle,
      111                  output o-where   ).
      112      end method.
      113     destructor public keyrec ():
      114       delete object hndl-proc-key-rec no-error.
      115       if error-status:error
      116       then do:
      117         ReturnMsg = return-value.
      118         Err = true.
      119       end.
      120     end destructor.
      121   end class.
