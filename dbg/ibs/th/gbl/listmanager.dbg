        1   using ibs.th.gbl.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.listmanager :
        4     define variable ii as integer no-undo.
        5     method public void WriteElement (input-output list as character, inNameElement as character, inValue as character):
        6       def var isExistElem as log no-undo init false.
        7                   def var element  as char no-undo.
        8       do ii = 1 to num-entries (list, chr(4)):
        9         element = entry (ii, list, chr(4)).
       10         if entry (1, element, chr(5)) = inNameElement
       11         then do:
       12           entry (2, element, chr(5)) = inValue.
       13           isExistElem = true.
       14           entry (ii, list, chr(4)) = element.
       15           return.
       16         end.
       17       end.
       18       if not isExistElem
       19       then do:
       20         list = list + chr(4) + inNameElement + chr(5) + inValue.
       21         list = left-trim (list, chr(4)).
       22       end.
       23     end method.
       24     method public character ReadElement (input inList as character, inNameElement as character):
       25       def var element  as char no-undo.
       26       do ii = 1 to num-entries (inList, chr(4)):
       27         element = entry (ii, inList, chr(4)).
       28         if entry (1, element, chr(5)) = inNameElement
       29         then do:
       30           return entry (2, element, chr(5)) .
       31         end.
       32       end.
       33       return ?.
       34     end method.
       35   end class.
