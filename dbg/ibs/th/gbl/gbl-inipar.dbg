        1   block-level on error undo, throw.
        2   class ibs.th.gbl.gbl-inipar:
        3       define static property conPar as character no-undo
        4       get.
        5       private set.
        6     define static property conParKeyName as character no-undo
        7       initial "секция REP-SETS параметр ConPar в .ini файле"
        8       get.
        9     define static property conParFlt as character no-undo
       10       get.
       11       private set.
       12     define static property conParFltKeyName as character no-undo
       13       initial "секция REP-SETS параметр ConParFlt в .ini файле"
       14       get.
       15     define static property logDir as character no-undo
       16       get.
       17       private set.
       18     define static property logDirKeyName as character no-undo
       19       initial "секция REP-SETS параметр logDir в .ini файле"
       20       get.
       21       define static property comstr as character no-undo
       22       get.
       23       private set.
       24     define static property comstrKeyName as character no-undo
       25       initial "секция revision параметр comstr в .ini файле"
       26       get.
       27     define static property dirflrvs as character no-undo
       28       get.
       29       private set.
       30     define static property dirflrvsKeyName as character no-undo
       31       initial "секция revision параметр dirflrvs в .ini файле"
       32       get.
       33     define static property dirflpmp as character no-undo
       34       get.
       35       private set.
       36     define static property dirflpmpKeyName as character no-undo
       37       initial "секция revision параметр dirflpmp в .ini файле"
       38       get.
       39       define static property dirfrgAcc as character no-undo initial ?
       40       get.
       41       private set.
       42     define static property dirfrgAccKeyName as character no-undo
       43       initial "секция BGE параметр Dirfrg-acc в .ini файле"
       44       get.
       45       define static property oxmlDir as character no-undo // значение для переменной oxml-heap-dir
       46       get.
       47       private set.
       48     define static property oxmlDirKeyName as character no-undo
       49       initial "секция OXML параметр oxml-dir в .ini файле"
       50       get.
       51     define static property oxmlExchDir as character no-undo // значение для переменной oxml-exch-dir
       52       get.
       53       private set.
       54     define static property oxmlExchDirKeyName as character no-undo
       55       initial "секция OXML параметр oxml-exch-dir в .ini файле"
       56       get.
       57     define static property cntxt-report-num as integer no-undo initial 0  // значение для переменной oxml-exch-dir
       58     get():
       59       if  cntxt-report-num = 0
       60       then
       61          cntxt-report-num = dynamic-next-value( "next-report":U, "ubflt":U ).
       62       return cntxt-report-num.
       63     end.
       64     private set.
       65       // для формирования имени файла отчетов - обеспечивает уникальность имён временных файлов между сессиями
       66     method public static void Setcntxt-report-num ():
       67     end.
       68     constructor static gbl-inipar():
       69       ibs.th.gbl.gbl-inipar:InitPar ( ) .
       70     end constructor.
       71     method public static void InitPar ( ) :
       72       get-key-value section "rep-sets" key "ConPar"    value conPar .
       73       get-key-value section "rep-sets" key "ConParFlt" value conParFlt .
       74       get-key-value section "rep-sets" key "logDir"    value logDir .
       75       if logDir = ?
       76       then do :
       77         logDir = ".\" .
       78       end .
       79       else do :
       80         logDir = right-trim(logDir, "\") .
       81         logDir = right-trim(logDir, "/") .
       82         logDir = logDir + "\" .
       83       end.
       84       get-key-value section "revision" key "comstr"    value comstr .
       85       get-key-value section "revision" key "dirflrvs"  value dirflrvs .
       86       get-key-value section "revision" key "dirflpmp"  value dirflpmp .
       87           get-key-value section "BGE" key "dirfrg-acc"     value dirfrgAcc .
       88       get-key-value section "oxml" key "oxml-dir"      value oxmlDir .
       89       get-key-value section "oxml" key "oxml-exch-dir" value oxmlExchDir .
       90     end method. // end_of InitPar
       91     method public static character PutKeyValue (input p-section as character,
       92                                                 input p-key     as character,
       93                                                 input p-value   as character ) :
       94     define variable v-message  as character no-undo .
       95     define variable v-par-name as character no-undo .
       96       case p-section :
       97         when "REP-SETS" then do :
       98           case p-key :
       99             when "ConPar"    then v-par-name = conParKeyName .
      100             when "ConParFlt" then v-par-name = conParFltKeyName .
      101             when "logDir"    then v-par-name = logDirKeyName .
      102             otherwise v-par-name = "" .
      103           end case .
      104         end .
      105         when "revision" then do :
      106           case p-key :
      107             when "comstr"   then v-par-name = comstrKeyName .
      108             when "dirflrvs" then v-par-name = dirflrvsKeyName .
      109             when "dirflpmp" then v-par-name = dirflpmpKeyName .
      110             otherwise v-par-name = "" .
      111           end case .
      112         end .
      113         when "BGE" then do :
      114           case p-key :
      115             when "dirfrg-acc" then v-par-name = dirfrgAccKeyName .
      116             otherwise v-par-name = "" .
      117           end case .
      118         end .
      119         when "OXML" then do :
      120           case p-key :
      121             when "oxml-dir"      then v-par-name = oxmlDirKeyName .
      122             when "oxml-exch-dir" then v-par-name = oxmlExchDirKeyName .
      123             otherwise v-par-name = "" .
      124           end case .
      125         end .
      126         otherwise v-par-name = "" .
      127       end case .
      128       if v-par-name = "" then do :
      129         v-message = substitute("Ошибка сохранения параметра: секция &1 параметр &2 в .ini файле вне статичного контекста."
      130                               , p-section, p-key) .
      131       end .
      132       else do :
      133         put-key-value section p-section key p-key value p-value no-error.
      134         if error-status:num-messages > 0 then
      135           v-message = substitute("Ошибка сохранения параметра: &1: &2"
      136                                 , v-par-name, error-status:get-message (error-status:num-messages)
      137                                 ) .
      138         else if error-status:error then
      139           v-message = substitute("Ошибка сохранения параметра: &1", v-par-name) .
      140         else do :
      141           v-message = "" .
      142           case p-section :
      143             when "REP-SETS" then do :
      144               case p-key :
      145                 when "ConPar"    then conPar    = p-value .
      146                 when "ConParFlt" then conParFlt = p-value .
      147                 when "logDir"    then logDir    = p-value .
      148               end case .
      149             end .
      150             when "revision" then do :
      151               case p-key :
      152                 when "comstr"   then comstr   = p-value .
      153                 when "dirflrvs" then dirflrvs = p-value .
      154                 when "dirflpmp" then dirflpmp = p-value .
      155               end case .
      156             end .
      157             when "BGE" then do :
      158               case p-key :
      159                 when "dirfrg-acc" then dirfrgAcc = p-value .
      160               end case .
      161             end .
      162             when "OXML" then do :
      163               case p-key :
      164                 when "oxml-dir"      then oxmlDir     = p-value .
      165                 when "oxml-exch-dir" then oxmlExchDir = p-value .
      166               end case .
      167             end .
      168           end case .
      169         end .
      170       end .
      171       return v-message .
      172     end method. // end_of PutKeyValue
      173     method public static character prn-lib-get-report-name ( ) :
      174     define variable v-report-name as character no-undo .
      175       v-report-name = prn-lib-get-report-name ("rpt") .
      176       return v-report-name .
      177     end method.
      178     method public static character prn-lib-get-report-name (input p-df-name as character) :
      179     define variable v-report-name as character no-undo .
      180       v-report-name = substitute("&1&2&3", session:temp-directory, p-df-name, cntxt-report-num ) .
      181       return v-report-name .
      182     end method.
      183     method public static void prn-lib-reportviewer-report-name (input p-report-name-html as character) :
      184        define variable v-full-path-RepView as character no-undo.
      185        define variable ii                  as integer no-undo .
      186        define variable v-report-name       as character no-undo .
      187        if search("exe\ReportViewer\reportviewer.exe") <> ? then
      188        do:
      189          v-full-path-RepView = search("exe\ReportViewer\reportviewer.exe").
      190        end.
      191        else
      192        do:
      193          message "Не найдена программа просмотра отчёта!" view-as alert-box error.
      194        end.
      195        do ii = 1 to NUM-ENTRIES (p-report-name-html).
      196          v-report-name = ENTRY (ii,p-report-name-html," ").
      197          if search(v-report-name) = ? then
      198          do:
      199            message "Не найден файл отчёта: " v-report-name view-as alert-box error.
      200            return error.
      201          end.
      202        end.
      203        os-command no-wait value(v-full-path-RepView + " true " + p-report-name-html).
      204     end method.
      205     method public static void prn-lib-reportviewer (input p-report-name-html as character,
      206     input p-param as character) :
      207      define variable ii                  as integer   no-undo .
      208      define variable jj                  as integer   no-undo .
      209      define variable v-report-name       as character no-undo .
      210      define variable v-fill-path-RepView as character no-undo.
      211      define variable v-param             as character no-undo .
      212      define variable v-GUI               as character no-undo init 'TRUE' .
      213      define variable v-password          as character no-undo init 'FALSE'.
      214      define variable v-par               as character no-undo .
      215      define variable v-path              as character no-undo .
      216      define variable v-os                as character no-undo .
      217      define variable v-command           as character no-undo .
      218      define variable v-excel             as character no-undo init 'TRUE' .
      219      define variable v-silent            as character no-undo init 'FALSE' .
      220      do ii = 1 to NUM-ENTRIES (p-report-name-html):
      221         v-report-name = ENTRY (ii,p-report-name-html," ").
      222         if search(v-report-name) = ? then
      223         do:
      224            return error "Не найден файл отчёта: " + v-report-name.
      225         end.
      226      end.
      227      do jj = 1 to NUM-ENTRIES (p-param,chr(4)):
      228         v-par = entry (jj,p-param,chr(4)) .
      229         if num-entries(v-par,':') <> 2 then return error 'Не правильно переданы параметры'.
      230         case entry(1,v-par,':':U):
      231            when 'GUI' then
      232               v-GUI = entry(2,v-par,':').
      233            when 'Password' then
      234               v-password = entry(2,v-par,':').
      235            when 'OS' then
      236               v-os = entry(2,v-par,':').
      237            when 'EXCEL' then
      238               v-excel = entry(2,v-par,':').
      239         end case.
      240      end.
      241      v-path = "exe\ReportViewer\reportviewer.exe" .
      242      if search(v-path) <> ? then
      243      do:
      244         v-fill-path-RepView = search(v-path).
      245      end.
      246      else
      247      do:
      248         return error "Не найдена программа просмотра отчёта!" .
      249      end.
      250      v-command = substitute('&1 &2 &3 &4 &5 ',v-fill-path-RepView,v-GUI,v-password,v-excel,p-report-name-html).
      251      if v-GUI = 'False'
      252      then
      253         os-command SILENT value(v-command).
      254      else
      255         os-command no-wait value(v-command).
      256   end method.
      257   end class.
