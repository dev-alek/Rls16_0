        1   USING Progress.Lang.*.
        2   using ibs.th.gbl.*.
        3   block-level on error undo, throw.
        4   CLASS ibs.th.gbl.ReportXsltUtil:
        5   def var v-temp-file         as char             no-undo.
        6   def var v-main-template     as char             no-undo.
        7   def var v-rep-gen           as class ReportXml  no-undo.
        8   def var v-rep-num           as int              no-undo.
        9   def var v-rep-section-open  as logical          no-undo.
       10   def var v-cur-template      as char initial ""  no-undo.
       11   def stream cfg-stream.
       12   def temp-table tmp#xslt no-undo
       13   field template-name as char
       14   field data-prefix as char
       15   .
       16   def buffer buf_tmp#xslt for tmp#xslt.
       17   constructor public ReportXsltUtil(temp-file as char):
       18       v-temp-file = temp-file.
       19       v-main-template = search("exe\xslt-excel-main-template.xml").
       20       v-rep-gen = new ReportXml(v-temp-file + ".xslt-data").
       21   end.
       22   method public ReportXml get-data-generator():
       23       return v-rep-gen.
       24   end.
       25   method public void set-current-template(template-file-name as char):
       26       v-cur-template = template-file-name.
       27   end.
       28   method char get-cur-tag-name():
       29       return "rep" + string(v-rep-num).
       30   end.
       31   method public void begin-report():
       32       end-report().
       33       v-rep-num = v-rep-num + 1.
       34       v-rep-gen:start-element(get-cur-tag-name()).
       35       v-rep-section-open = true.
       36   end.
       37   method public void end-report():
       38       if v-rep-section-open then
       39           do:
       40               v-rep-gen:end-element(get-cur-tag-name()).
       41               v-rep-section-open = false.
       42               if v-cur-template <> ""  then
       43                   do:
       44                       create buf_tmp#xslt.
       45                       assign
       46                           buf_tmp#xslt.template-name = search(v-cur-template)
       47                           buf_tmp#xslt.data-prefix = "Workbook/" + get-cur-tag-name()
       48                           .
       49                       v-cur-template = "".
       50                   end.
       51           end.
       52   end.
       53   method public void write-config():
       54       def var path as char no-undo.
       55       path = v-temp-file + ".xslt-cfg".
       56       output stream cfg-stream to value(path).
       57       put stream cfg-stream unformatted "init=excel,null" skip.
       58       put stream cfg-stream unformatted "main_template=" v-main-template skip.
       59       for each buf_tmp#xslt:
       60           put stream cfg-stream unformatted
       61               "merge_file="
       62               buf_tmp#xslt.template-name
       63               ","
       64               buf_tmp#xslt.data-prefix
       65               skip.
       66       end.
       67       put stream cfg-stream unformatted "merge_to=" v-temp-file ".xslt-merged" skip.
       68       put stream cfg-stream unformatted
       69           "transform_to="
       70           v-temp-file ".xslt-data"
       71           ","
       72           v-temp-file ".xslt-res"
       73           skip.
       74       output stream cfg-stream close.
       75   end.
       76   destructor public ReportXsltUtil():
       77       end-report().
       78       delete object v-rep-gen.
       79   end.
       80   END CLASS.
