        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class Ibs.Th.Gbl.rep-out:
        4           method public character xsl-transform(input xml as character, input xsl as character):
        5                   define variable result_xml as character no-undo.
        6           define variable java       as character no-undo.
        7           define variable saxon      as character no-undo.
        8           java = search("jre\bin\java.exe":U).
        9           if java = ? then do:
       10               message "Не найден исполняющий файл Java." view-as alert-box error  buttons ok.
       11               return result_xml.
       12           end.
       13           saxon = search("exe\saxon.jar":U).
       14           if saxon = ? then do:
       15               message "Не найден файл Saxon.jar." view-as alert-box error buttons ok.
       16               return result_xml.
       17           end.
       18           result_xml = session:temp-directory + "result.xml".
       19           define variable test as character no-undo.
       20           test = java + " -jar " + saxon + " -o " + result_xml + " " + xml + " " + xsl.
       21           os-command silent value(java + " -jar " + saxon + " -o " + result_xml + " " + xml + " " + xsl).
       22           result_xml = search(result_xml).
       23                   return result_xml.
       24           end method.
       25           method public void office(input xml as character, input xsl as character):
       26           define variable ch_office as com-handle no-undo.
       27           define variable xml_res as character no-undo.
       28           create "Excel.Application":U ch_office no-error.
       29         if error-status :error then
       30         do:
       31            message
       32               "Ошибка при запуске Excel" skip
       33               error-status :get-message(1) skip
       34               view-as alert-box error .
       35            undo, return error .
       36         end.
       37           if integer(ch_office) <> ? then do:
       38               xml_res = xsl-transform(xml, xsl).
       39               if xml_res = ? or xml_res = "" then do:
       40                   message "Файл отчета не создан." view-as alert-box error buttons ok.
       41                   return.
       42               end.
       43               ch_office:Visible = false.
       44               ch_office:DisplayAlerts = false.
       45               ch_office:Workbooks:open(xml_res).
       46               ch_office:ActiveWorkBook:SaveAs(string(session:temp-directory + "rep_" + replace(replace(string(now,"99.99.99 HH:MM:SS"),":","-")," ","_") + ".xls"), -4143, , , , , ).
       47               ch_office:Visible = true.
       48               ch_office:DisplayAlerts = true.
       49               release object ch_office no-error.
       50           end.
       51           else do:
       52               create "com.sun.star.ServiceManager":U ch_office no-error.
       53               if integer(ch_office) = ? then do:
       54                   message "Не найдены Microsoft Excel или Open Office Calc" view-as alert-box.
       55                   return.
       56               end.
       57               else do:
       58                   define variable ch_oDocument as com-handle no-undo.
       59                   define variable ch_oDesktop as com-handle no-undo.
       60                   define variable oofilename as character no-undo.
       61                   define variable ooargs as raw no-undo.
       62                   oofilename = "file:///":U + session:temp-directory + "rep_" + replace(replace(string(now,"99.99.99 HH:MM:SS":U),":","-")," ","_") + ".ods".
       63                   assign
       64                   oofilename = replace(oofilename, "\", "/").
       65                   create "com.sun.star.ServiceManager":U ch_office no-error.
       66                   ch_oDesktop  = ch_office:createinstance("com.sun.star.frame.Desktop":U).
       67                   ch_oDocument = ch_oDesktop:loadComponentFromURL(string("file:///":U + replace(xml_res, "\", "/")), "_blank":U, 0,ooargs).
       68                   ch_oDocument:storeAsURL(oofilename,ooargs).
       69                   release object ch_oDesktop no-error.
       70                   release object ch_oDocument no-error.
       71               end.
       72           end.
       73       release object ch_office no-error.
       74       os-delete value(xml).
       75       os-delete value(xml_res).
       76           end method.
       77   end class.
