        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class Ibs.Th.Gbl.ReportXml:
        4       define public variable hSAXWriter as handle no-undo.
        5       define public variable table-types as character no-undo.
        6       define public variable subtotal-types as character no-undo.
        7       define public variable total-types as character no-undo.
        8       constructor public ReportXml (input xml_tmp as character):
        9           super ().
       10           create sax-writer hSAXWriter.
       11           hSAXWriter:formatted = true.
       12           hSAXWriter:encoding = "UTF-8":U.
       13           hSAXWriter:set-output-destination("file":U, xml_tmp).
       14           hSAXWriter:start-document().
       15           hSAXWriter:start-element("Workbook":U).
       16       end constructor.
       17       method public void worksheet(input cName as character):
       18           if cName = "end":U then do:
       19               hSAXWriter:end-element("Worksheet":U).
       20           end.
       21           else do:
       22               hSAXWriter:start-element("Worksheet":U).
       23               hSAXWriter:insert-attribute("Name":U, cName).
       24           end.
       25       end method.
       26       method public void worksheet-header(input cHeader as character):
       27           case cHeader:
       28           when "start" then
       29           hSAXWriter:start-element("header":U).
       30           when "end" then
       31           hSAXWriter:end-element("header":U).
       32           otherwise
       33           hSAXWriter:write-data-element("row":U, cHeader).
       34           end case.
       35       end method.
       36       method public void worksheet-footer(input cHeader as character):
       37           case cHeader:
       38           when "start" then
       39           hSAXWriter:start-element("footer":U).
       40           when "end"   then
       41           hSAXWriter:end-element("footer":U).
       42           otherwise
       43           hSAXWriter:write-data-element("row":U, cHeader).
       44           end case.
       45       end method.
       46       method public void table-columns(input cWidth as character):
       47           define variable i as integer no-undo.
       48           hSAXWriter:start-element("table":U).
       49           hSAXWriter:start-element("columns":U).
       50           do i = 1 to num-entries(cWidth, ","):
       51               hSAXWriter:write-data-element("width":U, entry(i, cWidth, ",")).
       52           end.
       53           hSAXWriter:end-element("columns":U).
       54       end method.
       55       method public void table-header(input cHeader as character,
       56                                       input cHeight as character,
       57                                       input cRow as character):
       58           define variable i as integer no-undo.
       59           hSAXWriter:start-element("table-header":U).
       60           hSAXWriter:insert-attribute("Height":U, cHeight).
       61           hSAXWriter:insert-attribute("Row":U, cRow).
       62           do i = 1 to num-entries(cHeader, "|"):
       63               hSAXWriter:write-data-element("header":U, entry(i, cHeader, "|")).
       64           end.
       65           hSAXWriter:end-element("table-header":U).
       66       end method.
       67       method public void table-group(input cGroup as character):
       68           hSAXWriter:start-element("row":U).
       69               hSAXWriter:insert-attribute("Type":U,"group":U).
       70               hSAXWriter:write-data-element("Name":U, cGroup).
       71               hSAXWriter:write-data-element("Merge":U, string( num-entries(table-types, ",") - 1 )).
       72           hSAXWriter:end-element("row":U).
       73       end method.
       74       method public void table-row(input cRow as character):
       75           define variable i as integer no-undo.
       76           define variable lOK as logical no-undo.
       77           hSAXWriter:start-element("row":U).
       78           do i = 1 to num-entries(cRow, "|"):
       79               assign
       80               lOK = hSAXWriter:start-element("cell":U)
       81               lOK = hSAXWriter:insert-attribute("Type":U,entry(i, table-types, ","))
       82               lOK = hSAXWriter:write-characters(entry(i, cRow, "|"))
       83               lOK = hSAXWriter:end-element("cell":U).
       84           end.
       85           hSAXWriter:end-element("row":U).
       86       end method.
       87       method public void table-subtotal(input cRow as character):
       88           define variable i as integer no-undo.
       89           define variable lOK as logical no-undo.
       90           hSAXWriter:start-element("row":U).
       91           hSAXWriter:insert-attribute("Type":U,"subtotal":U).
       92           do i = 1 to num-entries(cRow, "|"):
       93               assign
       94               lOK = hSAXWriter:start-element("cell":U)
       95               lOK = hSAXWriter:insert-attribute("Type":U,entry(i, table-types, ","))
       96               lOK = hSAXWriter:write-characters(entry(i, cRow, "|"))
       97               lOK = hSAXWriter:end-element("cell":U).
       98           end.
       99           hSAXWriter:end-element("row":U).
      100       end method.
      101       method public void table-total(input cRow as character):
      102           define variable i as integer no-undo.
      103           define variable lOK as logical no-undo.
      104           hSAXWriter:start-element("row":U).
      105           hSAXWriter:insert-attribute("Type":U,"total":U).
      106           do i = 1 to num-entries(cRow, "|"):
      107               assign
      108               lOK = hSAXWriter:start-element("cell":U)
      109               lOK = hSAXWriter:insert-attribute("Type":U,entry(i, table-types, ","))
      110               lOK = hSAXWriter:write-characters(entry(i, cRow, "|"))
      111               lOK = hSAXWriter:end-element("cell":U).
      112           end.
      113           hSAXWriter:end-element("row":U).
      114           hSAXWriter:end-element("table":U).
      115       end method.
      116       method public void start-element(input cName as character):
      117           hSAXWriter:start-element(cName).
      118       end method.
      119       method public void end-element(input cName as character):
      120           hSAXWriter:end-element(cName).
      121       end method.
      122       method public void add-element(input cName as character, input cValue as character):
      123           hSAXWriter:write-data-element(cName, cValue).
      124       end method.
      125       method public void add-attr(input cName as character, input cValue as character):
      126           hSAXWriter:insert-attribute(cName, cValue).
      127       end method.
      128       destructor public ReportXml ():
      129          hSAXWriter:end-element("Workbook":U).
      130          hSAXWriter:end-document().
      131          delete object hSAXWriter.
      132       end destructor.
      133   end class.
