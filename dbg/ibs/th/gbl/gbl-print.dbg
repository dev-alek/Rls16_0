        1   using ibs.th.gbl.sys.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.gbl-print inherits objth:
        4   define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5       define override public property vss-author      as character no-undo init "$Author:$":U get.
        6       define override public property vss-date        as character no-undo init "$Date:$":U get.
        7       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9       define override public property vss-description as character no-undo init "Статусы электронных документов" get.
       10      constructor gbl-print():
       11       super ( ) .
       12     end constructor.
       13     define private variable cntxt-report-num as integer no-undo initial 0 .
       14     method public character prn-lib-get-report-name ( ) :
       15     define variable v-report-name as character no-undo .
       16       v-report-name = prn-lib-get-report-name ("rpt") .
       17       return v-report-name .
       18     end method.
       19     method public character prn-lib-get-report-name (input p-df-name as character) :
       20     define variable v-report-name as character no-undo .
       21       assign
       22         cntxt-report-num = dynamic-next-value( "next-report":U, "ubflt":U ) when cntxt-report-num = 0
       23       .
       24       v-report-name = substitute("&1&2&3", session:temp-directory, p-df-name, cntxt-report-num ) .
       25       return v-report-name .
       26     end method.
       27     method public void prn-lib-reportviewer-report-name (input p-report-name-html as character) :
       28        define variable v-full-path-RepView as character no-undo.
       29        define variable ii                  as integer no-undo .
       30        define variable v-report-name       as character no-undo .
       31        if search("exe\ReportViewer\reportviewer.exe") <> ? then
       32        do:
       33          v-full-path-RepView = search("exe\ReportViewer\reportviewer.exe").
       34        end.
       35        else
       36        do:
       37          message "Не найдена программа просмотра отчёта!" view-as alert-box error.
       38        end.
       39        do ii = 1 to NUM-ENTRIES (p-report-name-html).
       40          v-report-name = ENTRY (ii,p-report-name-html," ").
       41          if search(v-report-name) = ? then
       42          do:
       43            message "Не найден файл отчёта: " v-report-name view-as alert-box error.
       44            return error.
       45          end.
       46        end.
       47        os-command no-wait value(v-full-path-RepView + " true " + p-report-name-html).
       48     end method.
       49     method public void prn-lib-reportviewer (input p-report-name-html as character,
       50     input p-param as character) :
       51      define variable ii                  as integer   no-undo .
       52      define variable jj                  as integer   no-undo .
       53      define variable v-report-name       as character no-undo .
       54      define variable v-fill-path-RepView as character no-undo.
       55      define variable v-param             as character no-undo .
       56      define variable v-GUI               as character no-undo init 'TRUE' .
       57      define variable v-password          as character no-undo init 'FALSE'.
       58      define variable v-par               as character no-undo .
       59      define variable v-path              as character no-undo .
       60      define variable v-os                as character no-undo .
       61      define variable v-command           as character no-undo .
       62      define variable v-excel             as character no-undo init 'TRUE' .
       63      define variable v-silent            as character no-undo init 'FALSE' .
       64      do ii = 1 to NUM-ENTRIES (p-report-name-html):
       65         v-report-name = ENTRY (ii,p-report-name-html," ").
       66         if search(v-report-name) = ? then
       67         do:
       68            return error "Не найден файл отчёта: " + v-report-name.
       69         end.
       70      end.
       71         GET-KEY-VALUE section "REP-SETS" key "rep_excel" value v-excel .
       72         if v-excel eq ?
       73            then
       74            v-excel = "".
       75         else
       76         do:
       77            case v-excel:
       78               when 'TRUE' then
       79                  v-excel = 'TRUE' .
       80               when 'YES'  then
       81                  v-excel = 'TRUE' .
       82               otherwise
       83               v-excel = 'FALSE' .
       84            end case .
       85         end.
       86         GET-KEY-VALUE section "REP-SETS" key "Password" value v-password .
       87         if v-password = ? then v-password = "FALSE" .
       88         else
       89         do:
       90            case v-password:
       91               when 'TRUE' then
       92                  v-password = 'TRUE' .
       93               when 'YES'  then
       94                  v-password = 'TRUE' .
       95               otherwise
       96               v-password = 'FALSE' .
       97            end case .
       98         end.
       99      do jj = 1 to NUM-ENTRIES (p-param,chr(4)):
      100         v-par = entry (jj,p-param,chr(4)) .
      101         if num-entries(v-par,':') <> 2 then return error 'Не правильно переданы параметры'.
      102         case entry(1,v-par,':':U):
      103            when 'GUI' then
      104               v-GUI = entry(2,v-par,':').
      105            when 'Password' then
      106               v-password = entry(2,v-par,':').
      107            when 'OS' then
      108               v-os = entry(2,v-par,':').
      109            when 'EXCEL' then
      110               v-excel = entry(2,v-par,':').
      111         end case.
      112      end.
      113      v-path = "exe\ReportViewer\reportviewer.exe" .
      114      if search(v-path) <> ? then
      115      do:
      116         v-fill-path-RepView = search(v-path).
      117      end.
      118      else
      119      do:
      120         return error "Не найдена программа просмотра отчёта!" .
      121      end.
      122      v-command = substitute('&1 &2 &3 &4 &5 ',v-fill-path-RepView,v-GUI,v-password,v-excel,p-report-name-html).
      123      if v-GUI = 'False'
      124      then
      125         os-command SILENT value(v-command).
      126      else
      127         os-command no-wait value(v-command).
      128   end method.
      129   end class.
