        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.str.marking.handlers.tree.
        4   using ibs.th.gbl.keyrec.
        5   using Ibs.Th.Gbl.gbl-print.
        6   block-level on error undo, throw.
        7   class ibs.th.gbl.lib inherits objth:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Библиотеки системы" get.
       14     define variable marTree as class tree no-undo.
       15     define public property MarkingTree as class tree no-undo
       16     get:
       17       if not valid-object (MarkingTree)
       18       then do:
       19   marTree = new tree ().
       20   ObjSrv:Regobj(this-object,marTree,
       21   "marTree"
       22   ) .
       23       end.
       24       return marTree .
       25     end.
       26     define public property KeyRec as class keyrec no-undo
       27     get.
       28     private set.
       29     define public property prnLib as class gbl-print no-undo
       30     get.
       31     private set.
       32     constructor public lib (  ):
       33       super ().
       34   marTree = new tree ().
       35   ObjSrv:Regobj(this-object,marTree,
       36   "marTree"
       37   ) .
       38   KeyRec = new keyrec ().
       39   ObjSrv:Regobj(this-object,KeyRec,
       40   "KeyRec"
       41   ) .
       42   prnLib = new gbl-print ().
       43   ObjSrv:Regobj(this-object,prnLib,
       44   "prnLib"
       45   ) .
       46     end constructor.
       47   end class.
