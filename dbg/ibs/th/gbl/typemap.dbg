        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.map.mapstring.
        4   using ibs.th.gbl.sys.objth.
        5   block-level on error undo, throw.
        6   class Ibs.Th.Gbl.TypeMap inherits objth abstract:
        7     define public property mapType as class mapstring no-undo get.
        8       protected set.
        9     define public property CurrProp as class propmap no-undo
       10     get:
       11       def var currP as class propmap no-undo.
       12       currP = cast (mapType:SubjectObjCurr, propmap) no-error.
       13       if currP = ? or error-status:error
       14       then do:
       15        "Залогируем".
       16         return ?.
       17       end.
       18       else return currP.
       19     end.
       20     define public property  Unknow as class propmap no-undo get.  protected set.
       21     define public property  startElem as integer no-undo init 1 get. set.
       22     constructor protected TypeMap ():
       23       super().
       24       getobjserv().
       25       if valid-object (ObjSrv)
       26       then
       27          ObjSrv:Regobj(this-object).
       28   Unknow = new propmap (?,'Unknow','Неизвестный Type.').
       29   ObjSrv:Regobj(this-object,Unknow,
       30   "Unknow"
       31   ) .
       32   mapType = new mapstring (true,Unknow).
       33   ObjSrv:Regobj(this-object,mapType,
       34   "mapType"
       35   ) .
       36     end.
       37     method public char GetLabel(inKey as int):
       38       def var prop as class propmap no-undo.
       39       if valid-object (mapType:GetItemKeyInt(inKey))
       40         then return cast (mapType:SubjectObjCurr, ibs.th.gbl.propmap):Label_.
       41         else return ?.
       42     end method.
       43     method public char GetLabel(inKeyStr as char):
       44       def var prop as class propmap no-undo.
       45       if valid-object (mapType:GetItemKeyStr(inKeyStr))
       46         then return cast (mapType:SubjectObjCurr, ibs.th.gbl.propmap):Label_.
       47         else return inKeyStr.
       48     end method.
       49     method public char GetNameProp(inKey as int):
       50       def var prop as class propmap no-undo.
       51       if valid-object (mapType:GetItemKeyInt(inKey))
       52         then return cast (mapType:SubjectObjCurr, ibs.th.gbl.propmap):NameProp.
       53         else return ?.
       54     end method.
       55     method public char GetNameProp(inKeyStr as char):
       56       def var prop as class propmap no-undo.
       57       if valid-object (mapType:GetItemKeyStr(inKeyStr))
       58         then return cast (mapType:SubjectObjCurr, ibs.th.gbl.propmap):NameProp.
       59         else return ?.
       60     end method.
       61     method public int GetKeyIntDB(inKeyStr as char):
       62       def var prop as class propmap no-undo.
       63       if valid-object (mapType:GetItemKeyStr(inKeyStr))
       64         then return cast (mapType:SubjectObjCurr, ibs.th.gbl.propmap):KeyIntDB.
       65         else return ?.
       66     end method.
       67     method public class propmap GetProp(inKey as int):
       68       def var prop as class propmap no-undo.
       69       if valid-object (mapType:GetItemKeyInt(inKey))
       70       then return cast(mapType:SubjectObjCurr, propmap).
       71       else return Unknow.
       72     end method.
       73     method public class propmap GetProp(inKeyStr as char):
       74       def var prop as class propmap no-undo.
       75       if valid-object (mapType:GetItemKeyStr(inKeyStr))
       76       then return cast(mapType:SubjectObjCurr, propmap).
       77       else return Unknow.
       78     end method.
       79     method protected class propmap crProp(inNameProp as char, inLabel as char):
       80        crProp(startElem , inNameProp, inLabel).
       81        startElem = startElem + 1.
       82     end.
       83     method protected class propmap crProp(inKeyInt as int, inNameProp as char, inLabel as char):
       84       def var prop as class propmap no-undo.
       85   prop = new propmap (inKeyInt,inNameProp,inLabel).
       86   ObjSrv:Regobj(this-object,prop,
       87    inNameProp
       88   ) .
       89       mapType:AddItem(prop, inKeyInt,inNameProp, inLabel).
       90       return prop.
       91     end method.
       92   end class.
