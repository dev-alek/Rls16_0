        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.logging.logger:
        4     define static property Path as character no-undo
        5       get.
        6       set.
        7     define static property StrLogPut as character no-undo
        8       get.
        9       set (a as char):
       10         StrLogPut = a.
       11         PutStr(StrLogPut).
       12       end.
       13    define stream strlog.
       14     method static public void PutStr (str as char):
       15       define variable v-path as character no-undo.
       16       if search (Path) = ?
       17       then v-path = Path.
       18       else v-path = search (Path).
       19       output stream strlog to value (v-path) append.
       20       put stream strlog unformatted str chr(10).
       21       output stream strlog close.
       22     end.
       23   end class.
