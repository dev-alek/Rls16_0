        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.ptrl.par.ptrlpropproc:
        4     define static temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
        5     define static private property ObjType as character no-undo
        6       get.
        7       set.
        8     define static private property ObjCode as integer no-undo
        9       get.
       10       set.
       11     method static class ibs.th.gbl.ptrl.par.ptrlprop GetPropPtrl (p-obj-type as character, p-obj-code as integer):
       12       ObjType = p-obj-type.
       13       ObjCode = p-obj-code.
       14       return get-ptrl-prop ().
       15     end.
       16     method static private ibs.th.gbl.ptrl.par.ptrlprop get-ptrl-prop ():
       17         define variable par-type          as character no-undo.
       18         define variable v-value-character as character no-undo .
       19         define variable v-value-date      as date      no-undo .
       20         define variable v-value-decimal   as decimal   no-undo .
       21         define variable v-value-integer   as integer   no-undo .
       22         define variable v-value-logical   as logical   no-undo .
       23         define variable objOptPtrl        as class ibs.th.gbl.ptrl.par.ptrlprop no-undo .
       24         for each thbjattr_thbj-attr
       25         :
       26           delete thbjattr_thbj-attr .
       27         end.
       28         run adm/shattri.p
       29           ( input "get":U
       30           , input ibs.th.gbl.ptrl.par.ptrlpropproc:ObjType
       31           , input ibs.th.gbl.ptrl.par.ptrlpropproc:ObjCode
       32           , input 'petrol':U
       33           , input  ""
       34           , output v-value-character
       35           , output v-value-date
       36           , output v-value-decimal
       37           , output v-value-integer
       38           , output v-value-logical
       39           , output par-type
       40           , input-output table thbjattr_thbj-attr
       41           ) no-error .
       42         objOptPtrl = new ibs.th.gbl.ptrl.par.ptrlprop ().
       43         for each thbjattr_thbj-attr
       44         on error undo, return error return-value
       45         :
       46           case thbjattr_thbj-attr.prop-code :
       47             when 'denstclc':U then do:
       48               if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
       49                 assign
       50                   objOptPtrl:ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
       51                 .
       52               end.
       53             end.
       54             when 'expptrl':U then do:
       55               if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
       56                 and thbjattr_thbj-attr.prop-value-type = 'character':U
       57               then do:
       58                 assign
       59                   objOptPtrl:ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
       60                 .
       61               end.
       62             end.
       63             when 'inpptrl':U then do:
       64               if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
       65                 and thbjattr_thbj-attr.prop-value-type = 'character':U
       66               then do:
       67                 assign
       68                   objOptPtrl:ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
       69                 .
       70               end.
       71             end.
       72             when 'autopump':U then do:
       73               if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
       74                 assign
       75                   objOptPtrl:ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
       76                 .
       77               end.
       78             end.
       79             when 'rvsnmter':U then do:
       80               if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
       81                 assign
       82                   objOptPtrl:ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
       83                 .
       84               end.
       85             end.
       86             when 'avtinvpm':U then do:
       87               if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
       88                 assign
       89                   objOptPtrl:ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
       90                 .
       91               end.
       92             end.
       93             when 'invclipt':U then do:
       94               if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
       95                 assign
       96                   objOptPtrl:ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
       97                 .
       98               end.
       99             end.
      100             when 'olddens':U then do:
      101               if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      102                 assign
      103                   objOptPtrl:ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      104                 .
      105               end.
      106             end.
      107             when 'algrvspt':U then do:
      108               if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      109                 assign
      110                   objOptPtrl:ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      111                 .
      112               end.
      113             end.
      114             when 'temp-for-pomi':U then do:
      115               if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      116                 assign
      117                   objOptPtrl:ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      118                 .
      119               end.
      120             end.
      121             when 'algoincome':U then do:
      122               if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      123                 assign
      124                   objOptPtrl:ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      125                 .
      126               end.
      127             end.
      128             when 'mand-choice-autocar':U then do:
      129               if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      130                 assign
      131                   objOptPtrl:ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      132                 .
      133               end.
      134             end.
      135             when 'Delta-mass-horiz':U then do:
      136               if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      137                 assign
      138                   objOptPtrl:ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      139                 .
      140               end.
      141             end.
      142             when 'Delta-mass-vert':U then do:
      143               if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      144                 assign
      145                   objOptPtrl:ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      146                 .
      147               end.
      148             end.
      149           end case.
      150           delete thbjattr_thbj-attr .
      151         end.
      152         return objOptPtrl.
      153     end method.
      154   end class.
