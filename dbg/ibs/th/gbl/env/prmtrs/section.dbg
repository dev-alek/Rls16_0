        1   using Progress.Lang.*.
        2   using ibs.th.gbl.env.prmtrs.edo.
        3   using ibs.th.gbl.sys.objth.
        4   class ibs.th.gbl.env.prmtrs.section inherits objth:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Параметры по секциям" get.
       11     define public variable edo as class edo no-undo.
       12     method public class edo GetSectionEDO(pObjType as char, pObjCode as int):
       13       def var vMarkingType as character no-undo.
       14       def var vIsEDO as logical no-undo.
       15       def var vIsEDODiadok as logical no-undo.
       16       def var vIsManual as logical no-undo.
       17       def var vIsBanRecipes as logical no-undo.
       18       def var vIsBanAltr as logical no-undo.
       19       def var vIsBarCode as logical no-undo.
       20       if valid-object (edo) and edo:ObjType = pObjType and edo:ObjCode = pObjCode
       21       then do:
       22         return edo.
       23       end.
       24       delete object edo no-error.
       25   edo = new edo (pObjType,pObjCode).
       26   ObjSrv:Regobj(this-object,edo,
       27   "edo"
       28   ) .
       29       return edo.
       30     end method.
       31   end class.
