      214         ,output v-value-decimal
      215         ,output v-value-integer
      216         ,output v-value-logical
      217         ,output v-value-type
      218         ,input-output TABLE thbjattr_thbj-attr
      219         ) no-error .
      220       if v-value-logical = true
