       58     define public property ObjType as character no-undo
       59       get.
       60       private set.
       61     define public property ObjCode as integer no-undo
       62       get.
       63       private set.
       64     constructor public edo ( pObjType as char, pObjCode as int ):
       65        assign
       66         ObjType = pObjType
       67         ObjCode = pObjCode
       68       .
       69     end.
       70     method override public logical RefrashObject():
       71        if     ObjType ne ""
       72           and ObjType ne ?
       73           and ObjCode ne ?
       74           and ObjCode ne 0
       75        then
       76           RefrashObject(ObjType,ObjCode).
       77     end method.
       78     method public logical RefrashObject(pObjType as char, pObjCode as int):
       79       define variable v-value-character     as character     no-undo .
       80       define variable v-value-decimal       as decimal       no-undo .
       81       define variable v-value-integer       as integer       no-undo .
       82       define variable v-value-logical       as logical       no-undo .
       83       define variable v-value-type          as character     no-undo .
       84       define variable v-value-date          as date          no-undo .
       85       assign
       86         ObjType = pObjType
       87         ObjCode = pObjCode
       88       .
       89       run adm/shattri.p (
       90         input "get":U
       91         ,input pObjType
       92         ,input pObjCode
       93         ,input 'marking':U
       94         ,input "marking-type"
       95         ,output v-value-character
       96         ,output v-value-date
       97         ,output v-value-decimal
       98         ,output v-value-integer
       99         ,output v-value-logical
      100         ,output v-value-type
      101         ,input-output TABLE thbjattr_thbj-attr
      102         ) no-error .
      103       MarkingType = v-value-character.
      104       if valid-object(MarkingTypeobj)
      105       then do:
      106          MarkingTypeobj:reLoadItems(v-value-character).
      107       end.
      108       else do:
      109   MarkingTypeobj = new markingtype (MarkingType).
      110   ObjSrv:Regobj(this-object,MarkingTypeobj,
      111   "MarkingTypeobj"
      112   ) .
      113       end.
      114       run adm/shattri.p (
      115         input "get":U
      116         ,input pObjType
      117         ,input pObjCode
      118         ,input 'marking':U
      119         ,input "marking-type-edo"
      120         ,output v-value-character
      121         ,output v-value-date
      122         ,output v-value-decimal
      123         ,output v-value-integer
      124         ,output v-value-logical
      125         ,output v-value-type
      126         ,input-output TABLE thbjattr_thbj-attr
      127         ) no-error .
      128       if valid-object(MarkingTypeEDOobj)
      129       then do:
      130          MarkingTypeEDOobj:reLoadItems(v-value-character).
      131       end.
      132       else do:
      133   MarkingTypeEDOobj = new markingtype (v-value-character).
      134   ObjSrv:Regobj(this-object,MarkingTypeEDOobj,
      135   "MarkingTypeEDOobj"
      136   ) .
      137       end.
      138       run adm/shattri.p (
      139         input "get":U
      140         ,input pObjType
      141         ,input pObjCode
      142         ,input 'marking':U
      143         ,input "marking-EDO"
