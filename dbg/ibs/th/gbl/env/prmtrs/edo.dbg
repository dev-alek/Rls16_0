      297         ,output v-value-integer
      298         ,output v-value-logical
      299         ,output v-value-type
      300         ,input-output TABLE thbjattr_thbj-attr
      301         ) no-error .
      302       if valid-object(MarkingTypeBlockCashUnMarkObj)
      303       then do:
      304          MarkingTypeBlockCashUnMarkObj:reLoadItems(v-value-character).
      305       end.
