        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.env.conf.markingtype.
        4   class ibs.th.gbl.env.prmtrs.edo inherits objth.
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Параметры работы с ЭДО" get.
       11   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       13     define public property MarkingType as character initial "" no-undo
       14       get.
       15       private set.
       16     define public property MarkingTypeobj as class markingtype no-undo
       17       get.
       18       private set.
       19     define public property MarkingTypeEDOobj as class markingtype no-undo
       20       get.
       21       private set.
       22     define public property MarkingTypeArticObj as class markingtype no-undo
       23       get.
       24       private set.
