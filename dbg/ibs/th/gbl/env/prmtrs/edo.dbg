      145         ,output v-value-date
      146         ,output v-value-decimal
      147         ,output v-value-integer
      148         ,output v-value-logical
      149         ,output v-value-type
      150         ,input-output TABLE thbjattr_thbj-attr
      151         ) no-error .
      152       if v-value-logical = true
      153         then IsEDO = true.
      154         else IsEDO = false.
      155       run adm/shattri.p (
      156         input "get":U
      157         ,input pObjType
      158         ,input pObjCode
