        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   class ibs.th.gbl.env.conf.markingtypegbl inherits objth.
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override public property vss-description as character no-undo init "Настрока для хранения списков" get.
       10     define temp-table tt-conf no-undo
       11       field objNum  as integer
       12       field ConfStr as character
       13       index objNum objNum
       14     .
       15     define variable vObjNum as integer no-undo.
       16     method public int GetNextObjNum ():
       17        vObjNum= vObjNum + 1.
       18        return vObjNum.
       19     end.
       20     constructor public markingtypeGBl ():
       21       super().
       22     end constructor.
       23     method public logical AvialItem(iNumObj as integer, arg as char):
       24       define buffer tt-conf for tt-conf.
       25       find first tt-conf where tt-conf.objNum  eq iNumObj
       26                            and tt-conf.ConfStr eq arg
       27       no-error.
       28       return available tt-conf.
       29     end method.
       30     method public void AddItem(iNumObj as integer, arg as char):
       31       define buffer tt-conf for tt-conf.
       32       find first tt-conf where tt-conf.objNum  eq iNumObj
       33                            and tt-conf.ConfStr eq arg
       34       no-error.
       35       if not available tt-conf
       36       then do:
       37          create tt-conf.
       38          assign
       39             tt-conf.objNum  = iNumObj
       40             tt-conf.ConfStr = arg
       41          .
       42       end.
       43     end method.
       44     method public void delItem(iNumObj as integer, arg as char):
       45       define buffer tt-conf for tt-conf.
       46       find first tt-conf where tt-conf.objNum  eq iNumObj
       47                            and tt-conf.ConfStr eq arg
       48       no-error.
       49       if available tt-conf
       50       then do:
       51          delete tt-conf.
       52       end.
       53     end method.
       54     method public void delItems(iNumObj as integer):
       55       define buffer tt-conf for tt-conf.
       56       repeat preselect each tt-conf where tt-conf.ObjNum eq iNumObj:
       57          find next tt-conf.
       58            delete tt-conf.
       59       end.
       60     end method.
       61   end class.
