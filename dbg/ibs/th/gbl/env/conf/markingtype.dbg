        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.env.conf.markingtypegbl.
        4   class ibs.th.gbl.env.conf.markingtype inherits objth.
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Настрока для типов маркировки" get.
       11     define variable MarkingTypeGbl as MarkingTypeGbl no-undo.
       12     define variable vObjNum as integer no-undo.
       13     constructor public markingtype ( conf_val as char ):
       14       super().
       15       MarkingTypeGbl = objsrv:SystemAux:MarkingTypeGbl.
       16       vObjNum = MarkingTypeGbl:GetNextObjNum().
       17       reLoadItems(conf_val).
       18     end constructor.
       19     method public logical AvialItem(arg as char):
       20       return MarkingTypeGbl:AvialItem(vObjNum, arg).
       21     end method.
       22     method public void AddItem( arg as char):
       23        MarkingTypeGbl:AddItem(vObjNum, arg).
       24     end method.
       25     method public void delItem(arg as char):
       26        MarkingTypeGbl:delItem(vObjNum, arg).
       27     end method.
       28     method public void delItems():
       29        MarkingTypeGbl:delItems(vObjNum).
       30     end method.
       31     method public void reLoadItems(arg as char):
       32        define variable vi as integer no-undo.
       33        delItems().
       34        do vi = 1 to num-entries (arg):
       35          AddItem( entry (vi,arg)).
       36       end.
       37     end method.
       38     method public logical GetValForType(arg as char):
       39       return AvialItem(arg).
       40     end method.
       41           destructor public markingtype ( ):
       42         delItems().
       43           end destructor.
       44   end class.
