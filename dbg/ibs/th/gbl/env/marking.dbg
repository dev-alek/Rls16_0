        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.str.marking.sts.
        4   using ibs.th.str.marking.types.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.env.marking inherits objth:
        7      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8      define override public property vss-author      as character no-undo init "$Author:$":U get.
        9      define override public property vss-date        as character no-undo init "$Date:$":U get.
       10      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12      define override public property vss-description as character no-undo init "Маркировка товаров" get.
       13     define public property Sts as class sts no-undo
       14       get.
       15       set.
       16     define public property Types as class Types no-undo
       17       get.
       18       set.
       19     constructor public marking (  ):
       20       super ().
       21   Sts = new sts ().
       22   ObjSrv:Regobj(this-object,Sts,
       23   "Sts"
       24   ) .
       25   Types = new Types ().
       26   ObjSrv:Regobj(this-object,Types,
       27   "Types"
       28   ) .
       29     end constructor.
       30     METHOD OVERRIDE PUBLIC LOGICAL RefrashObject(  ):
       31         if valid-object(Types) then
       32           delete object Types.
       33   Types = new Types ().
       34   ObjSrv:Regobj(this-object,Types,
       35   "Types"
       36   ) .
       37     END METHOD.
       38   end class.
