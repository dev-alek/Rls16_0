        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.map.*.
        4   block-level on error undo, throw.
        5   class ibs.th.gbl.map.ParamColection inherits objth:
        6      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7      define override public property vss-author      as character no-undo init "$Author:$":U get.
        8      define override public property vss-date        as character no-undo init "$Date:$":U get.
        9      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11      define override public property vss-description as character no-undo init "Колекция параметров и значений" get.
       12      define variable vObjNum as integer no-undo.
       13      define variable ParamColectionGbl as ParamColectionGbl no-undo.
       14      constructor public ParamColection (  ):
       15         super ().
       16         ParamColectionGbl = objSrv:SystemAux:ParamColectionGbl.
       17         vObjNum = ParamColectionGbl:GetNextObjNum().
       18      end constructor.
       19      destructor public ParamColection ( ):
       20         delParams().
       21      end destructor.
       22      method public character getValue(iParam as char):
       23         return ParamColectionGbl:getValue(vObjNum, iParam).
       24      end method.
       25      method public void setParam(iParam as char, iValue as char):
       26         ParamColectionGbl:setParam(vObjNum, iParam, iValue).
       27      end method.
       28      method public void delParam(iParam as char):
       29         ParamColectionGbl:delParam(vObjNum, iParam).
       30      end method.
       31      method public void delParams():
       32         ParamColectionGbl:delParams(vObjNum).
       33      end method.
       34   end class.
