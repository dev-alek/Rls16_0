        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.*.
        3   using ibs.th.gbl.sys.objth.
        4   block-level on error undo, throw.
        5   class ibs.th.gbl.map.mapstringgbl inherits ibs.th.gbl.sys.objth:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Класс для хранеиня всех коллекций" get.
       12     define variable iCounter as integer no-undo.
       13     define property UncnowObj as class Progress.Lang.Object no-undo
       14       get.
       15       private set.
       16     define private temp-table ttListObj no-undo
       17       field ObjNum as integer
       18       field iNum as integer
       19       field keyStr as character
       20       field ByKeyStr as int
       21       field keyInt as integer
       22       field ByKeyInt as integer
       23       field LabStr as character
       24       field ByLabStr as int
       25       field SubObj as class Progress.Lang.Object
       26       index pi is primary unique ObjNum iNum
       27       index keyStr is unique ObjNum keyStr
       28       index keyInt is unique ObjNum keyInt
       29       index ByKeyStr ObjNum ByKeyStr
       30       index ByKeyInt ObjNum ByKeyInt
       31       index obj is unique SubObj.
       32     define variable vObjNum as integer no-undo.
       33     method public int GetNextObjNum ():
       34        vObjNum= vObjNum + 1.
       35        return vObjNum.
       36     end.
       37     define variable vLasObjNum as integer no-undo.
       38     method public void AddItem (iNumObj as integer, subObj as Progress.Lang.Object, keyInt as integer, keyStr as character, LabStr as character):
       39       define buffer ttListObj for ttListObj.
       40       find first ttListObj where ttListObj.ObjNum eq iNumObj
       41                              and ttListObj.SubObj eq subObj
       42       no-error.
       43       if not available ttListObj
       44       then do:
       45          if vLasObjNum ne iNumObj
       46          then do:
       47             find Last ttListObj where ttListObj.ObjNum eq iNumObj no-error.
       48             if available ttListObj
       49             then
       50                iCounter =  ttListObj.ObjNum.
       51             else
       52                iCounter = 0.
       53             vLasObjNum = iNumObj.
       54          end.
       55          iCounter = iCounter + 1.
       56          create ttListObj.
       57          assign
       58            ttListObj.ObjNum = iNumObj
       59            ttListObj.iNum   = iCounter
       60            ttListObj.SubObj = subObj
       61         .
       62      end.
       63      assign
       64         ttListObj.keyStr = keyStr
       65         ttListObj.keyInt = if keyInt eq ? then iCounter         else keyInt
       66         ttListObj.LabStr = if LabStr eq ? then ttListObj.keyStr else LabStr
       67      no-error.
       68      if error-status:error
       69      then do:
       70      end.
       71     end.
       72     method public void DeleteItem (iNumObj as integer, iNum as int):
       73       define buffer ttListObj for ttListObj.
       74       find first ttListObj where ttListObj.ObjNum eq iNumObj
       75                              and ttListObj.iNum   eq iNum.
       76       delete ttListObj.
       77       for each ttListObj where ttListObj.ObjNum eq iNumObj
       78                            and ttListObj.iNum   > iNum use-index pi :
       79         assign
       80           ttListObj.iNum = ttListObj.iNum - 1.
       81       end.
       82       if vLasObjNum eq iNumObj
       83       then do:
       84          iCounter = iCounter - 1.
       85       end.
       86     end.
       87     method public void DeleteItem (iNumObj as integer, keyStr as character):
       88       define buffer ttListObj for ttListObj.
       89       def var iNum as integer no-undo.
       90       find first ttListObj where ttListObj.ObjNum eq iNumObj
       91                              and ttListObj.keyStr eq keyStr.
       92       iNum = ttListObj.iNum.
       93       delete ttListObj.
       94       for each ttListObj where ttListObj.ObjNum eq iNumObj
       95                            and ttListObj.iNum > iNum use-index pi :
       96         assign
       97           ttListObj.iNum = ttListObj.iNum - 1.
       98       end.
       99       if vLasObjNum ne iNumObj
      100       then do:
      101          iCounter = iCounter - 1.
      102       end.
      103     end.
      104     method public void DeleteItems (iNumObj as integer):
      105       define buffer ttListObj for ttListObj.
      106       repeat preselect each ttListObj where ttListObj.ObjNum eq iNumObj:
      107          find next ttListObj.
      108            delete ttListObj.
      109       end.
      110       if vLasObjNum eq iNumObj
      111       then do:
      112          iCounter = 0.
      113       end.
      114     end.
      115     method public void SortTab (iNumObj as integer):
      116        define buffer ttListObj for ttListObj.
      117        define variable vi as integer no-undo.
      118        vi = 0.
      119        for each ttListObj where ttListObj.ObjNum eq iNumObj
      120                             and ttListObj.KeyInt ne ?
      121        by ttListObj.keyStr:
      122           vi = vi + 1.
      123           ttListObj.ByKeyStr = vi.
      124        end.
      125        vi = 0.
      126        for each ttListObj where ttListObj.ObjNum eq iNumObj
      127                             and ttListObj.KeyInt ne ?
      128        by ttListObj.keyInt:
      129           vi = vi + 1.
      130           ttListObj.ByKeyInt = vi.
      131        end.
      132        vi = 0.
      133        for each ttListObj where ttListObj.ObjNum eq iNumObj
      134                             and ttListObj.KeyInt ne ?
      135        by ttListObj.LabStr:
      136           vi = vi + 1.
      137           ttListObj.ByLabStr = vi.
      138        end.
      139     end.
      140     method public Progress.Lang.Object GetItem (iNumObj as integer, iNum as int):
      141       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      142       define buffer ttListObj for ttListObj.
      143       SubjectObjCurr = UncnowObj.
      144       for first ttListObj where ttListObj.ObjNum eq iNumObj
      145                             and ttListObj.iNum   eq iNum:
      146         SubjectObjCurr = ttListObj.SubObj.
      147       end.
      148       return SubjectObjCurr.
      149     end.
      150     method public Progress.Lang.Object GetItemByInt (iNumObj as integer, iNum as int):
      151       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      152       SubjectObjCurr = UncnowObj.
      153       for first ttListObj where ttListObj.ObjNum eq iNumObj
      154                             and ttListObj.ByKeyInt = iNum:
      155         SubjectObjCurr = ttListObj.SubObj.
      156       end.
      157       return SubjectObjCurr.
      158     end.
      159     method public Progress.Lang.Object GetItemByStr (iNumObj as integer, iNum as int):
      160       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      161       SubjectObjCurr = UncnowObj.
      162       for first ttListObj where ttListObj.ObjNum eq iNumObj
      163                             and ttListObj.ByKeyStr = iNum:
      164         SubjectObjCurr = ttListObj.SubObj.
      165       end.
      166       return SubjectObjCurr.
      167     end.
      168     method public Progress.Lang.Object GetItemByLab (iNumObj as integer,iNum as int):
      169       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      170       SubjectObjCurr = UncnowObj.
      171       for first ttListObj where ttListObj.ObjNum eq iNumObj
      172                             and ttListObj.ByLabStr = iNum:
      173         SubjectObjCurr = ttListObj.SubObj.
      174       end.
      175       return SubjectObjCurr.
      176     end.
      177     method public class Progress.Lang.Object GetItemKeyStr (iNumObj as integer,keyStr as character):
      178       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      179       SubjectObjCurr = UncnowObj.
      180       for first ttListObj where ttListObj.ObjNum eq iNumObj
      181                             and ttListObj.keyStr = keyStr:
      182         SubjectObjCurr = ttListObj.SubObj.
      183       end.
      184       return SubjectObjCurr.
      185     end.
      186     method public class Progress.Lang.Object GetItemKeyInt (iNumObj as integer,keyInt as integer):
      187       define variable SubjectObjCurr as class Progress.Lang.Object no-undo.
      188       SubjectObjCurr = UncnowObj.
      189       for first ttListObj where ttListObj.ObjNum eq iNumObj
      190                             and ttListObj.keyInt = keyint:
      191         SubjectObjCurr = ttListObj.SubObj.
      192       end.
      193       return SubjectObjCurr.
      194     end.
      195   end class.
