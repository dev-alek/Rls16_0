        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   block-level on error undo, throw.
        4   class ibs.th.gbl.map.ParamColectionGbl inherits objth:
        5      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6      define override public property vss-author      as character no-undo init "$Author:$":U get.
        7      define override public property vss-date        as character no-undo init "$Date:$":U get.
        8      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10      define override public property vss-description as character no-undo init "Колекция параметров и значений" get.
       11       define temp-table tt-param no-undo
       12       field objNum  as integer
       13       field Code_    as character
       14       field value_   as character
       15       index objcode objNum code_
       16     .
       17     define variable vObjNum as integer no-undo.
       18     method public int GetNextObjNum ():
       19        vObjNum= vObjNum + 1.
       20        return vObjNum.
       21     end.
       22     method public character getValue(iNumObj as integer, iParam as char):
       23       define buffer tt-param for tt-param.
       24       find first tt-param where tt-param.objNum  eq iNumObj
       25                             and tt-param.Code_   eq iParam
       26       no-error.
       27       return if available tt-param then tt-param.value_ else ?.
       28     end method.
       29     method public void setParam(iNumObj as integer, iParam as char, iValue as char):
       30       define buffer tt-param for tt-param.
       31       find first tt-param where tt-param.objNum  eq iNumObj
       32                             and tt-param.Code_   eq iParam
       33       no-error.
       34       if not available tt-param
       35       then do:
       36          create tt-param.
       37          assign
       38             tt-param.objNum  = iNumObj
       39             tt-param.code_   = iParam
       40          .
       41       end.
       42       tt-param.value_ = iValue.
       43     end method.
       44     method public void delParam(iNumObj as integer, iParam as char):
       45       define buffer tt-param for tt-param.
       46       find first tt-param where tt-param.objNum  eq iNumObj
       47                             and tt-param.Code_   eq iParam
       48       no-error.
       49       if available tt-param
       50       then do:
       51          delete tt-param.
       52       end.
       53     end method.
       54     method public void delParams(iNumObj as integer):
       55       define buffer tt-param for tt-param.
       56       repeat preselect each tt-param where tt-param.ObjNum eq iNumObj:
       57          find next tt-param.
       58            delete tt-param.
       59       end.
       60     end method.
       61      constructor public ParamColectionGbl (  ):
       62         super ().
       63      end constructor.
       64   end class.
