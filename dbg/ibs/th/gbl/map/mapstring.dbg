        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.*.
        3   using ibs.th.gbl.sys.objth.
        4   using ibs.th.gbl.map.mapstringgbl.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.map.mapstring inherits ibs.th.gbl.sys.objth:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Класс для коллекций" get.
       13     define property iCounter as integer no-undo
       14       get.
       15       private set.
       16     define property SubjectObjCurr as class Progress.Lang.Object no-undo
       17       get.
       18       set.
       19     define property UncnowObj as class Progress.Lang.Object no-undo
       20       get.
       21       private set.
       22     define property IsDelChildObj as logical init true no-undo
       23       get.
       24       set.
       25     define property isSort as logical init false no-undo
       26       get.
       27       private set.
       28     define variable vObjNum as integer no-undo.
       29     define variable MapStringGbl as MapStringGbl no-undo.
       30     constructor public mapstring ( isDelChild as log ):
       31       IsDelChildObj = isDelChild.
       32       MapStringGbl = objSrv:SystemAux:MapStringGbl.
       33       vObjNum = MapStringGbl:GetNextObjNum().
       34     end constructor.
       35     constructor public mapstring ( isDelChild as log, iobj as Progress.Lang.Object ):
       36       this-object(isDelChild).
       37       UncnowObj = iobj.
       38     end constructor.
       39     method public void AddItem (subObj as Progress.Lang.Object, keyStr as character):
       40        AddItem (subObj, ?, keyStr).
       41     end.
       42     method public void AddItem (subObj as Progress.Lang.Object, keyInt as integer , keyStr as character):
       43        AddItem (subObj, keyInt, keyStr, ? ).
       44     end.
       45     method public void AddItem (subObj as Progress.Lang.Object, keyInt as integer, keyStr as character, LabStr as character):
       46       MapStringGbl:AddItem(vObjNum, subObj, keyInt, keyStr, LabStr) no-error.
       47       if not error-status:error
       48       then
       49          iCounter = iCounter + 1.
       50       isSort = no.
       51       SubjectObjCurr = subObj.
       52     end.
       53     method public void DeleteItem (iNum as int):
       54       MapStringGbl:DeleteItem(vObjNum, iNum).
       55       isSort = no.
       56       iCounter = iCounter - 1.
       57     end.
       58     method public void DeleteItem (keyStr as character):
       59       MapStringGbl:DeleteItem(vObjNum, keyStr).
       60       isSort = no.
       61       iCounter = iCounter - 1.
       62     end.
       63     method public void SortTab ():
       64        if not isSort
       65        then do:
       66           MapStringGbl:SortTab(vObjNum).
       67           isSort = yes.
       68        end.
       69     end.
       70     method public integer GetItem (iNum as int):
       71       SubjectObjCurr = MapStringGbl:GetItem(vObjNum, iNum).
       72       if SubjectObjCurr eq MapStringGbl:UncnowObj
       73       then
       74          SubjectObjCurr = UncnowObj.
       75       return iCounter.
       76     end.
       77     method public integer GetItemByInt (iNum as int):
       78       SortTab().
       79       SubjectObjCurr = MapStringGbl:GetItemByInt(vObjNum, iNum).
       80       if SubjectObjCurr eq MapStringGbl:UncnowObj
       81       then
       82          SubjectObjCurr = UncnowObj.
       83       return iCounter.
       84     end.
       85     method public integer GetItemByStr (iNum as int):
       86       SortTab().
       87       SubjectObjCurr = MapStringGbl:GetItemByStr(vObjNum, iNum).
       88       if SubjectObjCurr eq MapStringGbl:UncnowObj
       89       then
       90          SubjectObjCurr = UncnowObj.
       91       return iCounter.
       92     end.
       93     method public integer GetItemByLab (iNum as int):
       94       SortTab().
       95       SubjectObjCurr = MapStringGbl:GetItemByLab(vObjNum, iNum).
       96       if SubjectObjCurr eq MapStringGbl:UncnowObj
       97       then
       98          SubjectObjCurr = UncnowObj.
       99       return iCounter.
      100     end.
      101     method public class Progress.Lang.Object GetItemKeyStr (keyStr as character):
      102       SubjectObjCurr = MapStringGbl:GetItemKeyStr(vObjNum, keyStr).
      103       if SubjectObjCurr eq MapStringGbl:UncnowObj
      104       then
      105          SubjectObjCurr = UncnowObj.
      106       return SubjectObjCurr.
      107     end.
      108     method public class Progress.Lang.Object GetItemKeyInt (keyInt as integer):
      109       SubjectObjCurr = MapStringGbl:GetItemKeyInt(vObjNum, keyInt).
      110       if SubjectObjCurr eq MapStringGbl:UncnowObj
      111       then
      112          SubjectObjCurr = UncnowObj.
      113       return SubjectObjCurr.
      114     end.
      115     destructor public mapstring ( ):
      116       if IsDelChildObj
      117       then
      118          MapStringGbl:DeleteItems(vObjNum).
      119     end destructor.
      120   end class.
