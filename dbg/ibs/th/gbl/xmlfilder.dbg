        1   block-level on error undo, throw.
        2   CLASS Ibs.Th.Gbl.XmlFilder:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: xmlfilder.cls $ $Revision: aea5316774be, 0, rls $".
        4     define private temp-table tag-pair no-undo
        5       field tag-name  as character
        6       field tag-value as character
        7       field is-set    as logical
        8     index pi is primary unique
        9       tag-name
       10     index iset
       11       is-set
       12     .
       13     define private variable hdocument as handle    no-undo .
       14     define private variable hroot     as handle    no-undo .
       15     define private variable hchild    as handle    no-undo .
       16     define private variable htext     as handle    no-undo .
       17     define private variable v-is-correct-parse  as logical   no-undo .
       18     define private variable v-tag-list          as character no-undo .
       19     define private variable v-err-message       as character no-undo .
       20     constructor public XmlFilder () :
       21     end constructor.
       22     DESTRUCTOR XmlFilder () :
       23       empty temp-table tag-pair.
       24       if valid-handle (hdocument)
       25       then do:
       26         delete object hdocument no-error .
       27       end.
       28       if valid-handle (hroot)
       29       then do:
       30         delete object hroot no-error .
       31       end.
       32       if valid-handle (hchild)
       33       then do:
       34         delete object hchild no-error .
       35       end.
       36       if valid-handle (htext)
       37       then do:
       38         delete object htext no-error .
       39       end.
       40       assign
       41         hdocument = ?
       42         hroot     = ?
       43         hchild    = ?
       44         htext     = ?
       45       .
       46     END DESTRUCTOR.
       47     define public property well-parsed as logical   no-undo
       48       get:
       49         return v-is-correct-parse.
       50       end get.
       51     define public property error-message as character no-undo
       52       get:
       53         return v-err-message.
       54       end get.
       55     method public void set-tag-list ( input p-tag-list as character ) :
       56       define buffer buf_tag-pair for tag-pair.
       57       define variable v-num-entries as integer   no-undo .
       58       define variable v-i           as integer   no-undo .
       59       define variable v-tag-name    as character no-undo .
       60       do
       61       on error undo, return error return-value
       62       :
       63         empty temp-table buf_tag-pair.
       64         assign
       65           v-num-entries       = num-entries(p-tag-list)
       66           v-is-correct-parse  = false
       67           v-tag-list          = p-tag-list
       68           v-err-message       = ""
       69         .
       70         do v-i = 1 to v-num-entries
       71         :
       72           assign
       73             v-tag-name = entry(v-i, p-tag-list)
       74           .
       75           find first buf_tag-pair where buf_tag-pair.tag-name = v-tag-name no-error .
       76           if not available buf_tag-pair then do:
       77             create buf_tag-pair.
       78             assign
       79               buf_tag-pair.tag-name = v-tag-name
       80               buf_tag-pair.is-set   = false
       81             .
       82           end.
       83         end.
       84       end.
       85     end method.
       86     method public logical parse( input p-parse-str as character) :
       87       define buffer buf_tag-pair for tag-pair.
       88       define variable v-parse-str   as longchar  no-undo .
       89       define variable v-log         as logical   no-undo .
       90       define variable v-i           as integer   no-undo .
       91       define variable v-tag-name    as character no-undo .
       92       define variable v-tag-value   as character no-undo .
       93       do
       94       on error undo, return error return-value
       95       :
       96         create x-document hdocument.
       97         create x-noderef hroot.
       98         create x-noderef hchild.
       99         create x-noderef htext.
      100         assign
      101           v-parse-str = p-parse-str
      102         .
      103         v-log = hDocument :load( "LONGCHAR", v-parse-str, no ) no-error.
      104         if error-status :error
      105         then do:
      106           assign
      107             v-err-message = substitute( "Ошибка загрузки XML-документа.&1&2&1&3"
      108                                       , chr(10)
      109                                       , error-status :get-message(1)
      110                                       , error-status :get-message(2)
      111                                       )
      112           .
      113           return false.
      114         end.
      115         if v-log <> yes
      116         then do:
      117           assign
      118             v-err-message = substitute( "Ошибка загрузки XML-документа.&1&2&1&3"
      119                                       , chr(10)
      120                                       , error-status :get-message(1)
      121                                       , error-status :get-message(2)
      122                                       )
      123           .
      124           return false.
      125         end.
      126         v-log = hDocument :get-document-element( hRoot ) no-error .
      127         if v-log <> yes
      128         then do:
      129           assign
      130             v-err-message = "Ошибка нахождения корневого элемнта документа."
      131           .
      132           return false.
      133         end.
      134         el-tree:
      135         repeat v-i = 1 to hRoot :num-children
      136         :
      137           hRoot :get-child( hChild , v-i ) .
      138           if hChild :subtype <> 'ELEMENT' or hChild :num-children = 0 then next el-tree.
      139           assign
      140             v-tag-name = hChild :name
      141           .
      142           find first buf_tag-pair where buf_tag-pair.tag-name = v-tag-name no-error .
      143           if available buf_tag-pair then do:
      144             hChild :get-child( hText , 1 ).
      145             assign
      146               v-tag-value = hText :node-value
      147             .
      148             assign
      149               buf_tag-pair.tag-value  = v-tag-value
      150               buf_tag-pair.is-set     = true
      151             .
      152           end.
      153         end.
      154         delete object hdocument .
      155         delete object hroot     .
      156         delete object hchild    .
      157         delete object htext     .
      158         assign
      159           hdocument = ?
      160           hroot     = ?
      161           hchild    = ?
      162           htext     = ?
      163           v-i       = 0
      164         .
      165         for each buf_tag-pair
      166           where buf_tag-pair.is-set = false
      167         :
      168           assign
      169             v-i = v-i + 1
      170             v-err-message = buf_tag-pair.tag-name + ', '
      171           .
      172         end.
      173         if v-i > 0
      174         then do:
      175           assign
      176             v-err-message = "Не найдены поля: " + v-err-message
      177           .
      178           return false.
      179         end.
      180         return true.
      181       end.
      182     end method.
      183     method public character get-tag( input p-tag-name as character, output p-found as logical ) :
      184       define buffer buf_tag-pair  for tag-pair.
      185       define variable v-tag-value as character no-undo .
      186       do
      187       on error undo, return error return-value
      188       :
      189         find first buf_tag-pair where buf_tag-pair.tag-name = p-tag-name no-error .
      190         if available buf_tag-pair
      191         then do:
      192           assign
      193             v-tag-value = buf_tag-pair.tag-value
      194             p-found     = yes
      195           .
      196         end.
      197         else do:
      198           assign
      199             v-tag-value = ?
      200             p-found     = no
      201           .
      202         end.
      203         return v-tag-value.
      204       end.
      205     end method.
      206   end class.
