        1   CLASS Ibs.Th.Gbl.ProgressBar
        2     IMPLEMENTS Ibs.Th.Gbl.IProgressBar
        3   :
        4       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: progressbar.cls $ $Revision: 64ee1a69159c, 2047, rls $".
        5       define protected variable v-stepvalue         as int64      no-undo.
        6       define protected variable v-prc               as character  no-undo.
        7       define protected variable v-prc-int           as integer    no-undo.
        8       define protected variable v-visible           as logical    no-undo.
        9       define protected variable v-maxvalue          as int64      no-undo.
       10       define protected variable v-minvalue          as int64      no-undo.
       11       define protected variable v-curvalue          as int64      no-undo.
       12       define protected variable v-time1             as int64      no-undo.
       13       define protected variable v-time2             as int64      no-undo.
       14       define protected variable v-prediction        as character  no-undo.
       15       define protected variable v-elapsed           as character  no-undo.
       16       define protected variable v-text              as character  no-undo.
       17       define protected variable v-last-repaint-time as int64      no-undo.
       18       define protected variable v-is-canceled       as logical    no-undo.
       19       define rectangle r-complete
       20           size-chars 78 by 1
       21           bgcolor 8.
       22       define rectangle r-progress
       23           size-chars 1 by 1
       24           edge-pixels 1
       25           bgcolor 14.
       26       define button b-cancel
       27           label "Отмена"
       28           size 10 by 1.
       29       define frame progressbar
       30           r-complete at col 1 row 2
       31           r-progress at col 1 row 2
       32           v-prc at col 24 row 1 NO-LABEL
       33           v-elapsed    at col 1  row 3 FORMAT "X(10)" LABEL "Прошло"
       34           v-prediction at col 1  row 4 FORMAT "X(10)" LABEL "Расчетное время"
       35           b-cancel     at col 21 row 5
       36           space( 0 ) skip( 0 )
       37       with view-as dialog-box keep-tab-order
       38            side-labels no-underline three-d
       39            cancel-button b-cancel
       40       .
       41       DEFINE PUBLIC PROPERTY process-event AS logical INITIAL true NO-UNDO
       42         get.
       43         set.
       44       DEFINE PUBLIC PROPERTY fg-color AS INTEGER NO-UNDO
       45           GET :
       46               RETURN r-progress:BGCOLOR IN FRAME progressbar.
       47           END GET.
       48           SET ( INPUT p-color AS INTEGER ) :
       49               ASSIGN
       50                   r-progress:BGCOLOR IN FRAME progressbar = p-color
       51               .
       52           END SET.
       53       DEFINE PUBLIC PROPERTY bg-color AS INTEGER NO-UNDO
       54           GET :
       55               RETURN r-complete:BGCOLOR IN FRAME progressbar.
       56           END GET.
       57           SET ( INPUT p-color AS INTEGER ) :
       58               ASSIGN
       59                   r-complete:BGCOLOR IN FRAME progressbar = p-color
       60               .
       61           END SET.
       62       DEFINE PUBLIC PROPERTY frame-title AS CHARACTER NO-UNDO
       63           GET:
       64               RETURN FRAME progressbar:TITLE.
       65           END GET.
       66           SET ( INPUT p-str AS CHARACTER ) :
       67               ASSIGN
       68                   FRAME progressbar:TITLE = p-str
       69               .
       70           END SET.
       71       DEFINE PUBLIC PROPERTY tick AS INT64 INITIAL 10000 NO-UNDO
       72           GET.
       73           SET.
       74       DEFINE PUBLIC PROPERTY can-cancel AS LOGICAL INITIAL NO NO-UNDO
       75           GET.
       76           SET.
       77       DEFINE PUBLIC PROPERTY is-canceled AS LOGICAL INITIAL NO NO-UNDO
       78           GET:
       79             return v-is-canceled .
       80           END GET.
       81       DEFINE PUBLIC PROPERTY cb-handle AS HANDLE NO-UNDO
       82         get.
       83         set.
       84       DEFINE PUBLIC PROPERTY cb-proc-name AS CHARACTER INITIAL ? NO-UNDO
       85         get.
       86         set.
       87       DEFINE PUBLIC PROPERTY cb-params AS CHARACTER INITIAL ? NO-UNDO
       88         get.
       89         set.
       90       CONSTRUCTOR PUBLIC ProgressBar ( INPUT p-min AS INT64 , INPUT p-max AS INT64 ) :
       91           this-object( p-min, p-max , 0 ).
       92       END CONSTRUCTOR.
       93       CONSTRUCTOR PUBLIC ProgressBar ( INPUT p-min AS INT64 , INPUT p-max AS INT64 , INPUT p-cur AS INT64 ) :
       94           define variable v-complete as integer no-undo.
       95           do with frame progressbar:
       96               assign
       97                   v-minvalue                = p-min
       98                   v-maxvalue                = if ( p-min > p-max ) then p-min else p-max
       99                   v-curvalue                = p-cur
      100                   v-stepvalue               = if ( v-maxvalue - v-minvalue ) < 100 then ( 100 / ( v-maxvalue - v-minvalue ) )
      101                                               else integer( ( v-maxvalue - v-minvalue ) / 100 )
      102                   v-prc-int                 = integer( ( v-curvalue / v-maxvalue ) * 100 )
      103                   v-prc                     = substitute("&1 %" , v-prc-int )
      104                   v-complete                = integer( ( r-complete:width-chars / v-maxvalue ) * v-curvalue )
      105                   r-progress:width-chars    = if v-complete = 0 then 0.01 else v-complete
      106                   b-cancel:visible          = false
      107                   frame progressbar:title = "Обработка..."
      108               .
      109           end.
      110       END CONSTRUCTOR.
      111       DESTRUCTOR ProgressBar () :
      112       END DESTRUCTOR.
      113       ON CHOOSE OF b-cancel IN FRAME progressbar
      114       DO:
      115         if valid-handle(cb-handle)
      116         then do:
      117           if cb-handle:get-signature(cb-proc-name) <> ""
      118           then do:
      119             if cb-params <> ? and cb-params <> ""
      120             then do:
      121               run value(cb-proc-name) in cb-handle ( input cb-params ) no-error .
      122             end.
      123             else do:
      124               run value(cb-proc-name) in cb-handle no-error .
      125             end.
      126             if error-status :error
      127             then do:
      128               return no-apply.
      129             end.
      130           end.
      131         end.
      132         assign
      133           v-is-canceled = yes
      134         .
      135         hide-bar().
      136       END.
      137       METHOD PUBLIC VOID show-bar() :
      138           display
      139             r-complete
      140             v-prc
      141           with frame progressbar.
      142           if can-cancel = yes
      143           then do:
      144             assign
      145               b-cancel:visible  = true
      146             .
      147             enable
      148               b-cancel
      149             with frame progressbar.
      150           end.
      151           view frame progressbar.
      152           assign
      153               v-visible = yes
      154               v-time1   = etime
      155           .
      156       END METHOD.
      157       METHOD PUBLIC VOID hide-bar() :
      158           HIDE FRAME progressbar.
      159           ASSIGN
      160               v-visible = NO
      161           .
      162       END METHOD.
      163       METHOD PUBLIC VOID increment() :
      164           DEFINE VARIABLE v-mod       AS INT64     NO-UNDO.
      165           DEFINE VARIABLE v-time-diff AS INT64     NO-UNDO.
      166           IF v-curvalue >= v-maxvalue THEN RETURN.
      167           ASSIGN
      168               v-curvalue = v-curvalue + 1
      169               v-time2 = ETIME
      170               v-time-diff = INTEGER( TRUNCATE ( ( v-time2 - v-time1 ) / 1000 , 0 ) )
      171               v-mod = ( v-curvalue MODULO v-stepvalue )
      172           .
      173           IF v-visible AND v-mod = 0 THEN DO:
      174               repaint().
      175           END.
      176           ELSE IF ( v-time2 - v-last-repaint-time ) >= tick  THEN DO:
      177               assign
      178                   v-elapsed = STRING( v-time-diff , 'HH:MM:SS':U )
      179                   v-prediction = IF v-time-diff = 0 THEN "" ELSE string( INT64( TRUNCATE( v-maxvalue * ( v-time2 - v-time1 ) / ( 1000 * v-curvalue ), 0) ) , 'HH:MM:SS':U)
      180                   v-last-repaint-time = v-time2
      181               .
      182               display
      183                   v-elapsed
      184                   v-prediction
      185               with frame progressbar.
      186           END.
      187           process-events().
      188       END METHOD.
      189       METHOD PUBLIC VOID increment(inMsg as char) :
      190           DEFINE VARIABLE v-mod       AS INT64     NO-UNDO.
      191           DEFINE VARIABLE v-time-diff AS INT64     NO-UNDO.
      192           FRAME progressbar:TITLE = "Обработка..." + inMsg.
      193           increment().
      194       END METHOD.
      195       METHOD PUBLIC VOID step ( INPUT p-val AS INTEGER ) :
      196           if p-val <= 0 then return.
      197           ASSIGN
      198               v-curvalue = v-curvalue + p-val
      199           .
      200           if v-curvalue > v-maxvalue then do:
      201             assign
      202               v-curvalue = v-maxvalue
      203             .
      204           end.
      205           IF p-val > v-stepvalue OR (( v-curvalue MODULO v-stepvalue) <= ( ( v-curvalue - p-val ) MODULO v-stepvalue ))  THEN DO:
      206               repaint().
      207           END.
      208           process-events().
      209       END METHOD.
      210       METHOD PUBLIC VOID stepto ( INPUT p-val AS INTEGER ) :
      211           define variable v-sval as int64   no-undo .
      212           define variable v-lval as int64   no-undo .
      213           if p-val < v-curvalue then return.
      214           if p-val <= 0 then return.
      215           assign
      216             v-sval = ( p-val - v-curvalue )
      217             v-lval = v-curvalue
      218           .
      219           if p-val > v-maxvalue then do:
      220             assign
      221               v-curvalue = v-maxvalue
      222             .
      223           end.
      224           else do:
      225             assign
      226               v-curvalue = p-val
      227             .
      228           end.
      229           IF v-sval > v-stepvalue OR (( v-curvalue MODULO v-stepvalue) <= ( v-lval MODULO v-stepvalue ))  THEN DO:
      230               repaint().
      231           END.
      232           process-events().
      233       END METHOD.
      234       METHOD PUBLIC VOID tick () :
      235           DEFINE VARIABLE v-time-diff AS INT64     NO-UNDO.
      236           ASSIGN
      237               v-time2 = ETIME
      238               v-time-diff = v-time2 - v-time1
      239           .
      240           IF ( v-time2 - v-last-repaint-time ) >= tick  THEN DO:
      241               assign
      242                   v-elapsed = STRING( int64( TRUNCATE ( v-time-diff / 1000 , 0 ) )  , 'HH:MM:SS':U )
      243                   v-last-repaint-time = v-time2
      244               .
      245               display
      246                   v-elapsed
      247               with frame progressbar.
      248           END.
      249           process-events().
      250       END METHOD.
      251       METHOD PRIVATE VOID repaint () :
      252           DEFINE VARIABLE v-complete AS INTEGER NO-UNDO.
      253           DO WITH FRAME progressbar:
      254               assign
      255                   v-time2 = ETIME
      256                   v-complete = integer( ( r-complete:width-chars / v-maxvalue ) * v-curvalue )
      257                   r-progress:width-chars = IF v-complete = 0 THEN 0.01 ELSE v-complete
      258                   v-prc-int = INTEGER( ( v-curvalue / v-maxvalue ) * 100 )
      259                   v-prc     = SUBSTITUTE("&1 %" , v-prc-int )
      260                   v-prediction = string( INT64( TRUNCATE( v-maxvalue * ( v-time2 - v-time1 ) / ( 1000 * v-curvalue ), 0) ) , 'HH:MM:SS':U)
      261                   v-elapsed = STRING( INT64( TRUNCATE ( ( v-time2 - v-time1 ) /  1000 , 0 ) ) , 'HH:MM:SS':U )
      262                   v-last-repaint-time = v-time2
      263               .
      264               display
      265                   r-progress
      266                   v-prc
      267                   v-prediction
      268                   v-elapsed
      269               with frame progressbar.
      270           END.
      271       END METHOD.
      272       METHOD PRIVATE VOID process-events () :
      273         if can-cancel and process-event
      274         then do:
      275           process events.
      276         end.
      277       END METHOD.
      278       METHOD PUBLIC VOID refresh_() :
      279           HIDE FRAME progressbar.
      280           display r-complete v-prc with frame progressbar.
      281           VIEW FRAME progressbar.
      282       END METHOD.
      283   END CLASS.
