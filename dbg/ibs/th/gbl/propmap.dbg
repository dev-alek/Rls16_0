        1   using Progress.Lang.*.
        2   using ibs.th.gbl.propmap.
        3   using ibs.th.gbl.sys.objth.
        4   using ibs.th.gbl.map.mapstring.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.propmap inherits objth:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Описание элементов справочника" get.
       13     define public property Label_ as character no-undo
       14       get.
       15       set.
       16     define public property NameProp as character no-undo
       17       get.
       18       set.
       19     define public property KeyIntDB as integer no-undo
       20       get.
       21       private set.
       22     define public property KeyInt as integer no-undo
       23       get.
       24       set(arg as integer ):
       25          KeyInt   = arg.
       26          KeyIntDB = arg.
       27       end.
       28     constructor public propmap (inNameProp as char, inLabel as char):
       29       super ().
       30       assign
       31         Label_   = inLabel
       32         NameProp = inNameProp
       33         .
       34     end constructor.
       35     constructor public propmap (iKeyInt as integer, inNameProp as char, inLabel as char):
       36       super ().
       37       assign
       38         Label_   = inLabel
       39         NameProp = inNameProp
       40         KeyInt   = iKeyInt
       41         .
       42     end constructor.
       43     destructor public propmap ( ):
       44     end destructor.
       45   end class.
