        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.gbl.logger.putout inherits ibs.th.gbl.sys.objth :
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override public property vss-description as character no-undo init "Вывод информации в файл" get.
       10     define stream out.
       11     define private variable fileName_ as character no-undo.
       12     constructor public putout (inFileName as char ):
       13       super ().
       14       fileName_ = inFileName.
       15     end constructor.
       16     method public void PutMessage( inMsg as character ):
       17       output stream out to value(fileName_) append.
       18       put stream out unformatted (string(now) + ": " + inMsg) skip.
       19       output stream out close.
       20     end method.
       21     destructor public putout ( ):
       22       output stream out close.
       23     end destructor.
       24   end class.
