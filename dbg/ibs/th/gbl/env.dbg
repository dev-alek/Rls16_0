        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.env.utd.
        4   using ibs.th.gbl.env.marking.
        5   using ibs.th.gbl.sys.env.ini.
        6   using ibs.th.gbl.env.conf.
        7   using ibs.th.gbl.env.prmtrs.section.
        8   block-level on error undo, throw.
        9   class ibs.th.gbl.env inherits objth:
       10     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       11     define override public property vss-author      as character no-undo init "$Author:$":U get.
       12     define override public property vss-date        as character no-undo init "$Date:$":U get.
       13     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       14     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       15     define override public property vss-description as character no-undo init "Сущности системы" get.
       16     define property Utd as class utd no-undo
       17       get.
       18       private set.
       19     define property Marking as class marking no-undo
       20       get.
       21       private set.
       22     define property ParametrsOfSection as class section no-undo
       23       get.
       24       private set.
       25     constructor public env (  ):
       26       super ().
       27   Utd = new utd ().
       28   ObjSrv:Regobj(this-object,Utd,
       29   "Utd"
       30   ) .
       31    .
       32   Marking = new marking ().
       33   ObjSrv:Regobj(this-object,Marking,
       34   "Marking"
       35   ) .
       36   ParametrsOfSection = new section ().
       37   ObjSrv:Regobj(this-object,ParametrsOfSection,
       38   "ParametrsOfSection"
       39   ) .
       40    .
       41     end constructor.
       42   end class.
