        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.TypeMap.
        3   using ibs.th.gbl.propmap.
        4   block-level on error undo, throw.
        5   class ibs.th.gbl.collection.paramCol inherits TypeMap:
        6        define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7        define override public property vss-author      as character no-undo init "$Author:$":U get.
        8        define override public property vss-date        as character no-undo init "$Date:$":U get.
        9        define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10        define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11        define override public property vss-description as character no-undo init "Коллекция параметров" get.
       12      constructor public paramCol (  ):
       13         super ().
       14         Unknow:Label_ = ?.
       15      end constructor.
       16      destructor public paramCol ( ):
       17      end destructor.
       18      define variable countParam as integer no-undo.
       19      method public void setParam(iName as character, iValue as char):
       20         define variable vParam as class propmap no-undo.
       21         vparam = GetProp(iName).
       22         if vParam eq Unknow
       23         then do:
       24            countParam = countParam + 1.
       25            crProp(countParam, iName, iValue).
       26         end.
       27         else
       28            vParam:Label_ = iValue.
       29      end.
       30      method public character getParamValue (iName as char):
       31         return GetLabel(iName).
       32      end.
       33      method public character getParams(  ):
       34         define variable VStr as character no-undo.
       35         define variable vI as integer no-undo.
       36         do vi = 1 to mapType:GetItemByLab(vi):
       37            VStr = VStr + ', ' + CurrProp:NameProp + ': "' + CurrProp:Label_ + '"' .
       38         end.
       39         return substitute ("Params : ~{&1}",substring (vstr,3)).
       40      end.
       41   end class.
