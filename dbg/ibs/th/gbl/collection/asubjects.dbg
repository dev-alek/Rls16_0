        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.*.
        3   block-level on error undo, throw.
        4   class ibs.th.gbl.collection.asubjects implements isubjects:
        5     define property iCounter as integer no-undo
        6       get.
        7       private set.
        8     define property SubjectObjCurr as class Progress.Lang.Object no-undo
        9       get.
       10       set.
       11     define property IsDelChildObj as logical init true no-undo
       12       get.
       13       set.
       14     define private temp-table ttListObj no-undo
       15       field iNum   as integer
       16       field SubObj as class   Progress.Lang.Object
       17       index pi is primary unique iNum .
       18     constructor public asubjects ( arg as log ):
       19       IsDelChildObj = arg.
       20     end constructor.
       21     constructor public asubjects (  ):
       22     end constructor.
       23     method public void AddItem (subObj as Progress.Lang.Object):
       24       assign
       25         iCounter = iCounter + 1.
       26       create ttListObj.
       27       assign
       28         ttListObj.iNum   = iCounter
       29         ttListObj.SubObj = subObj
       30         .
       31       SubjectObjCurr = subObj.
       32     end.
       33     method public void DeleteItem (iNum as int):
       34       find first ttListObj where ttListObj.iNum = iNum.
       35       delete ttListObj.
       36       iNum = 0.
       37       for each ttListObj use-index pi:
       38         assign
       39           iNum           = iNum + 1
       40           ttListObj.iNum = iNum.
       41       end.
       42       iCounter = iCounter - 1.
       43     end.
       44     method public integer GetItem (iNum as int):
       45       for first ttListObj where ttListObj.iNum = iNum:
       46         SubjectObjCurr = ttListObj.SubObj.
       47       end.
       48       return iCounter.
       49     end.
       50     method public void Add (subObj as Progress.Lang.Object):
       51       assign
       52         iCounter = iCounter + 1.
       53       create ttListObj.
       54       assign
       55         ttListObj.iNum   = iCounter
       56         ttListObj.SubObj = subObj
       57         .
       58       SubjectObjCurr = subObj.
       59     end.
       60     method public void Delete (iNum as int):
       61       find first ttListObj where ttListObj.iNum = iNum.
       62       delete ttListObj.
       63       iNum = 0.
       64       for each ttListObj use-index pi:
       65         assign
       66           iNum           = iNum + 1
       67           ttListObj.iNum = iNum.
       68       end.
       69       iCounter = iCounter - 1.
       70     end.
       71     method public integer Get (iNum as int):
       72       for first ttListObj where ttListObj.iNum = iNum:
       73         SubjectObjCurr = ttListObj.SubObj.
       74       end.
       75       return iCounter.
       76     end.
       77     destructor public asubjects ( ):
       78       if IsDelChildObj
       79       then
       80         for each ttListObj:
       81           SubjectObjCurr = ttListObj.SubObj.
       82           delete object SubjectObjCurr no-error.
       83         end.
       84     end destructor.
       85   end class.
