        1   using Progress.Lang.*.
        2   using ibs.th.str.mercury.*.
        3   using ibs.th.gbl.storage.*.
        4   using ibs.th.gbl.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.gdsmercstr:
        7     define buffer buf_gdsmerc for ub.gds-mercury.
        8     method private void exception( arg as handle, ingdsmercObj as class gdsmercsub, t-h as handle ):
        9       ingdsmercObj:setMsg(arg:get-message (1)).
       10       ingdsmercObj:setStatusErr(arg:error).
       11       t-h:buffer-delete () no-error.
       12       message "Œ¯Ë·Í‡ - "  ingdsmercObj:Msg view-as alert-box.
       13       return.
       14     end method.
       15     method public void insertDB( input gdsmercObj as class gdsmercsub ):
       16       create buf_gdsmerc.
       17       assign
       18         buf_gdsmerc.id     = next-value (s-gds-mercury-id, ub)
       19         buf_gdsmerc.db-num = 0
       20       no-error.
       21       if error-status:error
       22       then do:
       23         exception(error-status, gdsmercObj, buffer buf_gdsmerc:handle).
       24         return.
       25       end.
       26       setDataStorage(input gdsmercObj, buffer buf_gdsmerc).
       27       return.
       28     end method.
       29     method public void updateDB( input gdsmercObj as gdsmercsub  ):
       30       find first buf_gdsmerc where
       31         buf_gdsmerc.id     = gdsmercObj:ID and
       32         buf_gdsmerc.db-num = gdsmercObj:DBNum no-error.
       33       if not available (buf_gdsmerc)
       34       then do:
       35         exception(error-status, gdsmercObj, buffer buf_gdsmerc:handle).
       36         return.
       37       end.
       38       setDataStorage(input gdsmercObj, buffer buf_gdsmerc).
       39       release buf_gdsmerc.
       40       return.
       41     end method.
       42     method public void deleteDB( input gdsmercObj as gdsmercsub  ):
       43       find first buf_gdsmerc where
       44         buf_gdsmerc.id     = gdsmercObj:ID and
       45         buf_gdsmerc.db-num = gdsmercObj:DBNum no-error.
       46       if not available (buf_gdsmerc)
       47       then do:
       48         exception(error-status, gdsmercObj, buffer buf_gdsmerc:handle).
       49         return.
       50       end.
       51       delete buf_gdsmerc.
       52       return.
       53     end method.
       54     method public class gdsmercsubs getgdsmercs (input inGdsCode as integer ):
       55       define variable gdsmercsObj as class gdsmercsubs no-undo .
       56       gdsmercsObj = new gdsmercsubs ().
       57       for each buf_gdsmerc where buf_gdsmerc.gds-code = inGdsCode:
       58         gdsmercsObj:AddItem(getDataStorage (buffer buf_gdsmerc)).
       59       end.
       60       return gdsmercsObj.
       61     end method.
       62       method public class gdsmercsubs getguidmercs (input inGUID as character ):
       63       define variable gdsmercsObj as class gdsmercsubs no-undo .
       64       gdsmercsObj = new gdsmercsubs ().
       65       for each buf_gdsmerc where buf_gdsmerc.GUID = inGUID:
       66         gdsmercsObj:AddItem(getDataStorage (buffer buf_gdsmerc)).
       67       end.
       68       return gdsmercsObj.
       69     end method.
       70     method private void setDataStorage (input ingdsmercObj as class gdsmercsub, buffer inbf_gdsmerc for ub.gds-mercury ):
       71       inbf_gdsmerc.UUID         = ingdsmercObj:UUID.
       72       inbf_gdsmerc.gds-code     = ingdsmercObj:GdsCode.
       73       inbf_gdsmerc.cr-date      = ingdsmercObj:DateCr.
       74       inbf_gdsmerc.update-date  = ingdsmercObj:DateUpdate.
       75       inbf_gdsmerc.merc-name    = ingdsmercObj:MercName.
       76       inbf_gdsmerc.GUID         = ingdsmercObj:GUID_.
       77       inbf_gdsmerc.GUID-subtype = ingdsmercObj:GUIDSubType.
       78       inbf_gdsmerc.GUID-type    = ingdsmercObj:GUIDType.
       79       inbf_gdsmerc.prod-type    = ingdsmercObj:ProdType.
       80       release inbf_gdsmerc.
       81     end.
       82     method private class gdsmercsub getDataStorage ( buffer inbf_gdsmerc for ub.gds-mercury ):
       83       define variable gdsmercObj  as class gdsmercsub no-undo .
       84       gdsmercObj = new gdsmercsub ().
       85       assign
       86         gdsmercObj:ID          = inbf_gdsmerc.id
       87         gdsmercObj:DBNum       = inbf_gdsmerc.db-num
       88         gdsmercObj:UUID        = inbf_gdsmerc.UUID
       89         gdsmercObj:GdsCode     = inbf_gdsmerc.gds-code
       90         gdsmercObj:DateCr      = inbf_gdsmerc.cr-date
       91         gdsmercObj:DateUpdate  = inbf_gdsmerc.update-date
       92         gdsmercObj:MercName    = inbf_gdsmerc.merc-name
       93         gdsmercObj:GUID_       = inbf_gdsmerc.GUID
       94         gdsmercObj:GUIDSubType = inbf_gdsmerc.GUID-subtype
       95         gdsmercObj:GUIDType    = inbf_gdsmerc.GUID-type
       96         gdsmercObj:ProdType    = inbf_gdsmerc.prod-type
       97         .
       98       return gdsmercObj.
       99     end.
      100   end class.
