        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promoGiftstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: e455fc319afd, 3602, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: ARostovtsev $":U .
        9     define variable vss-date        as character no-undo initial "$Date: 2023/12/28 12:56:37 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promogiftstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promogiftstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage Gift Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inPromoGiftObj as class promoGiftsub, t-h as handle ):
       17       inpromoGiftObj:setMsg(arg:get-message (1)).
       18       inpromoGiftObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void updateDBAll( input promoGiftsubsObj as promoGiftsubs  ):
       27         updateDBAll (promoGiftsubsObj,?,?,?).
       28     end.
       29     method public void updateDBAll( input promoGiftsubsObj as promoGiftsubs ,input pIdAction as int64):
       30       updateDBAll (promoGiftsubsObj,pIdAction,?,?).
       31     end.
       32     method public void updateDBAll( input promoGiftsubsObj as promoGiftsubs ,input pIdAction as int64, input pIdCrit as int64,input pdb-num as integer  ):
       33         define variable vi as int no-undo.
       34         do vi =  1 to promoGiftsubsObj:GetItem(vi):
       35            if pIdAction ne ?
       36            then
       37               promoGiftsubsObj:promoGiftObjCurr:idAction = pIdAction.
       38            if pIdCrit ne ?
       39            then
       40               promoGiftsubsObj:promoGiftObjCurr:idCrit = pIdCrit.
       41            if pdb-num ne ?
       42            then
       43               promoGiftsubsObj:promoGiftObjCurr:db-num = pdb-num.
       44            if      promoGiftsubsObj:promoGiftObjCurr:Mode eq 'с':U
       45            then
       46               insertDB(promoGiftsubsObj:promoGiftObjCurr).
       47            else if promoGiftsubsObj:promoGiftObjCurr:Mode eq 'и':U
       48            then
       49               updateDB(promoGiftsubsObj:promoGiftObjCurr).
       50            else if promoGiftsubsObj:promoGiftObjCurr:Mode eq 'у':U
       51            then
       52               deleteDB(promoGiftsubsObj:promoGiftObjCurr).
       53         end.
       54     end.
       55     method public void insertDB( input promoGiftsubObj as promoGiftsub  ):
       56       define buffer buf_promoCriterion for ub.promoCriterion.
       57         if promoGiftsubObj:db-num eq ? then
       58          undo, throw new Progress.Lang.AppError(
       59            substitute("отсутствует db-num в классе подарков/сообщений с кодом товара &1&2", string(promoGiftsubObj:GdsCode),promoGiftsubObj:mess)
       60          ) .
       61       define buffer buf_promoGift for ub.promoGift.
       62       create buf_promoGift.
       63       assign
       64         buf_promoGift.id     = next-value (s-promoGift-id, ub)
       65         buf_promoGift.db-num = promoGiftsubObj:db-num
       66       no-error.
       67       if error-status:error
       68       then do:
       69         exception(error-status, promoGiftsubObj, buffer buf_promoGift:handle).
       70         return.
       71       end.
       72       setDataStorage(input promoGiftsubObj, buffer buf_promoGift).
       73     end method.
       74     method public void updateDB( input promoGiftsubObj as promoGiftsub  ):
       75       define buffer buf_promoGift for ub.promoGift.
       76       find first buf_promoGift where
       77             buf_promoGift.id     = promoGiftsubObj:ID
       78       no-error.
       79       if not available (buf_promoGift)
       80       then do:
       81         exception(error-status, promoGiftsubObj, buffer buf_promoGift:handle).
       82         return.
       83       end.
       84       setDataStorage(input promoGiftsubObj, buffer buf_promoGift).
       85       return.
       86     end method.
       87     method public void deleteDB( input promoGiftsubObj as promoGiftsub  ):
       88       define buffer buf_promoGift for ub.promoGift.
       89       find first buf_promoGift where
       90         buf_promoGift.id     = promoGiftsubObj:ID
       91         no-error.
       92       if not available (buf_promoGift)
       93       then do:
       94         exception(error-status, promoGiftsubObj, buffer buf_promoGift:handle).
       95         return.
       96       end.
       97       delete buf_promoGift.
       98       return.
       99     end method.
      100     method public class promoGiftsubs getpromoGiftsubs (input idaction as int64,input idcrit as int64,input idb-num as integer ):
      101       return getpromoGiftsubs (idaction, idcrit, idb-num, ?).
      102     end method.
      103     method public class promoGiftsubs getpromoGiftsubs (input idaction as int64,input idcrit as int64,input idb-num as integer, input iobj-code as integer ):
      104       define variable promoGiftsubsObj as class promoGiftsubs.
      105       define buffer buf_promoGift for ub.promoGift.
      106       promoGiftsubsObj = new promoGiftsubs ().
      107       for each buf_promoGift   where buf_promoGift.idaction eq idaction
      108                                   and buf_promoGift.idcrit  eq idcrit
      109                                   and buf_promoGift.db-num  eq idb-num
      110       no-lock:
      111           promoGiftsubsObj:AddItem(getDataStorage (buffer buf_promoGift, iobj-code)).
      112       end.
      113       return promoGiftsubsObj.
      114     end method.
      115     method private void setDataStorage (input inpromoGiftObj as class promoGiftsub, buffer inbf_promoGift for ub.PromoGift):
      116       assign
      117           inbf_promoGift.idCrit        = inpromoGiftObj:idCrit
      118           inbf_promoGift.idAction      = inpromoGiftObj:idAction
      119           inbf_promoGift.Gds-Code      = inpromoGiftObj:GdsCode
      120           inbf_promoGift.qnty          = inpromoGiftObj:qnty
      121           inbf_promoGift.mess          = inpromoGiftObj:mess
      122          // inbf_promoGift.db-num        = inpromoGiftObj:db-num
      123           .
      124         for first ub.PromoAction no-lock where ub.PromoAction.id = inpromoGiftObj:idaction:
      125         find first ub.PromoAttr exclusive-lock where ub.PromoAttr.attr-code = "mess-gks" and
      126         ub.PromoAttr.p-key = string(ub.PromoAction.id) + chr(3) + string(ub.PromoAction.db-num) and
      127         ub.PromoAttr.tablename = "PromoGift" no-error .
      128         if not available (ub.PromoAttr) then do:
      129             create ub.PromoAttr .
      130             assign
      131             ub.PromoAttr.attr-code = "mess-gks"
      132             ub.PromoAttr.p-key = string(ub.PromoAction.id) + chr(3) + string(ub.PromoAction.db-num)
      133             ub.PromoAttr.tablename = "PromoGift"
      134             .
      135         end.
      136         ub.PromoAttr.attr-value = inpromoGiftObj:mess-gks .
      137         end.
      138         validate inbf_promoGift.
      139       end.
      140     method private class promoGiftsub getDataStorage ( buffer inbf_promoGift for ub.promoGift ):
      141       return getDataStorage(buffer inbf_promoGift, ?).
      142     end.
      143     method private class promoGiftsub getDataStorage ( buffer inbf_promoGift for ub.promoGift, objCode as integer ):
      144       define variable promoGiftsubObj  as class promoGiftsub.
      145       promoGiftsubObj = new promoGiftsub ().
      146       return getDataStorage(promoGiftsubObj,buffer inbf_promoGift, objCode).
      147     end.
      148     method private class promoGiftsub getDataStorage (inpromoGiftSubObj as class promoGiftsub, buffer inbf_promoGift for ub.promoGift ):
      149       return getDataStorage(inpromoGiftSubObj,buffer inbf_promoGift, ?).
      150     end.
      151     method private class promoGiftsub getDataStorage (inpromoGiftSubObj as class promoGiftsub, buffer inbf_promoGift for ub.promoGift, obj-code as integer ):
      152       assign
      153         inpromoGiftSubObj:ID        = inbf_promoGift.id
      154         inpromoGiftSubObj:idCrit    = inbf_promoGift.idCrit
      155         inpromoGiftSubObj:idAction  = inbf_promoGift.idAction
      156         inpromoGiftSubObj:GdsCode   = inbf_promoGift.Gds-Code
      157         inpromoGiftSubObj:qnty      = inbf_promoGift.qnty
      158         inpromoGiftSubObj:mess      = inbf_promoGift.mess
      159         inpromoGiftSubObj:db-num    = inbf_promoGift.db-num
      160         inpromoGiftSubObj:objCode   = obj-code
      161       .
      162         for first ub.PromoAction no-lock where ub.PromoAction.id = inbf_promoGift.idaction:
      163         find first ub.PromoAttr no-lock where ub.PromoAttr.attr-code = "mess-gks" and
      164         ub.PromoAttr.p-key = string(ub.PromoAction.id) + chr(3) + string(ub.PromoAction.db-num) and
      165         ub.PromoAttr.tablename = "PromoGift" no-error .
      166         if available (ub.PromoAttr) then do:
      167           inpromoGiftSubObj:mess-gks = ub.PromoAttr.attr-value .
      168         end.
      169         end.
      170       return inpromoGiftSubObj.
      171     end.
      172     method public void refreshObj (inpromoGiftSubObj as class promoGiftsub):
      173       define buffer buf_promoGift for ub.promoGift.
      174       if not valid-object (inpromoGiftSubObj)
      175       then do:
      176         Msg = "Объект типа promoGiftsub не существует".
      177         return.
      178       end.
      179       find first buf_promoGift no-lock where buf_promoGift.ID = inpromoGiftSubObj:ID no-error.
      180       if not available (buf_promoGift)
      181       then do:
      182         Msg = "Не найден Товар - " + string (inpromoGiftSubObj:ID).
      183         return.
      184       end.
      185       getDataStorage (inpromoGiftSubObj, buffer buf_promoGift).
      186     end.
      187   end class.
