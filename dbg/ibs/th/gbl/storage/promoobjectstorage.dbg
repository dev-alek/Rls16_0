        1   using Progress.Lang.*.
        2   using ibs.th.ref.promo.*.
        3   block-level on error undo, throw.
        4   class ibs.th.gbl.storage.promoObjectStorage:
        5     define variable vss-revision    as character no-undo initial "$Revision: 2131ac572a79, 4114, test $":U .
        6     define variable vss-author      as character no-undo initial "$Author: VSpiridonov $":U .
        7     define variable vss-date        as character no-undo initial "$Date: 2025/02/28 14:26:23 $":U .
        8     define variable vss-workfile    as character no-undo initial "$Workfile: promoObjectStorage.cls $":U .
        9     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promoObjectStorage.cls $":U .
       10     define variable vss-description as character no-undo initial "Storage Object Action".
       11     define property Msg as character
       12       get.
       13       private set.
       14     method private void exception( arg as handle, inpromoObjectObj as class promoObjectsub, t-h as handle ):
       15       inpromoObjectObj:setMsg(arg:get-message (1)).
       16       inpromoObjectObj:setStatusErr(arg:error).
       17       t-h:buffer-delete () no-error.
       18       return.
       19     end method.
       20     method private void exception( arg as char ):
       21       Msg = arg.
       22       return.
       23     end method.
       24     method public void updateDBAll( input promoObjectsubsObj as promoObjectsubs ):
       25         updateDBAll (PromoObjectsubsObj,?,?).
       26     end.
       27     method public void updateDBAll( input PromoObjectsubsObj as PromoObjectsubs ,input pIdParent as int64,input pdb-num as integer  ):
       28         define variable vi as int no-undo.
       29         define variable vSub as Class PromoObjectsub no-undo.
       30         do vi =  1 to PromoObjectsubsObj:GetItem(vi):
       31            vSub = PromoObjectsubsObj:PromoObjectObjCurr.
       32            if pIdParent ne ?
       33            then
       34               vSub:idAction = pIdParent.
       35            if pdb-num ne ?
       36            then
       37               vSub:db-num = pdb-num.
       38             if      vSub:Mode eq 'с':U
       39            then
       40               insertDB(vSub).
       41            else if vSub:Mode eq 'и':U
       42            then
       43               updateDB(vSub).
       44            else if vSub:Mode eq 'у':U
       45            then
       46               deleteDB(vSub).
       47         end.
       48     end.
       49     method public void insertDB( input PromoObjectsubObj as PromoObjectsub  ):
       50       define buffer buf_promoObject for ub.promoObject.
       51       define variable vId as integer no-undo.
       52       if PromoObjectsubObj:db-num eq ? then
       53          undo, throw new Progress.Lang.AppError(
       54            substitute("отсутствует db-num в классе объектов &1 &2", PromoObjectsubObj:obj-type,PromoObjectsubObj:obj-code)
       55          ) .
       56       create buf_PromoObject.
       57       assign
       58         VId                       = next-value (s-PromoObject-id, ub)
       59         buf_PromoObject.id        = vId
       60         buf_PromoObject.db-num    = PromoObjectsubObj:db-num
       61       no-error.
       62       if error-status:error
       63       then do:
       64         exception(error-status, PromoObjectsubObj, buffer buf_PromoObject:handle).
       65         return.
       66       end.
       67       setDataStorage(input PromoObjectsubObj, buffer buf_PromoObject).
       68       return.
       69     end method.
       70     method public void updateDB( input PromoObjectsubObj as PromoObjectsub  ):
       71       define buffer buf_promoObject for ub.promoObject.
       72       find first buf_PromoObject where
       73             buf_PromoObject.id     = PromoObjectsubObj:ID
       74       no-error.
       75       if not available (buf_PromoObject)
       76       then do:
       77         exception(error-status, PromoObjectsubObj, buffer buf_PromoObject:handle).
       78         return.
       79       end.
       80       setDataStorage(input PromoObjectsubObj, buffer buf_PromoObject).
       81       return.
       82     end method.
       83     method public void deleteDB( input PromoObjectsubObj as PromoObjectsub  ):
       84       define buffer buf_promoObject for ub.promoObject.
       85       find first buf_PromoObject where
       86         buf_PromoObject.id     = PromoObjectsubObj:ID
       87         no-error.
       88       if not available (buf_PromoObject)
       89       then do:
       90         exception(error-status, PromoObjectsubObj, buffer buf_PromoObject:handle).
       91         return.
       92       end.
       93       delete buf_PromoObject.
       94       return.
       95     end method.
       96     method public class PromoObjectsubs getPromoObjectsubs (input pId as int64,input idb-num as int ):
       97       define buffer buf_promoObject for ub.promoObject.
       98       define variable PromoObjectsubsObj as class PromoObjectsubs.
       99       PromoObjectsubsObj = new PromoObjectsubs ().
      100       for each buf_PromoObject  where buf_PromoObject.idAction = pId
      101                                      and buf_PromoObject.db-num = idb-num
      102       no-lock:
      103           PromoObjectsubsObj:AddItem(getDataStorage (buffer buf_PromoObject)).
      104       end.
      105       return PromoObjectsubsObj.
      106     end method.
      107     method private void setDataStorage (input inPromoObjectObj as class PromoObjectsub, buffer inbf_PromoObject for ub.PromoObject ):
      108       assign
      109           inbf_PromoObject.obj-type        = inPromoObjectObj:obj-type
      110           inbf_PromoObject.obj-code        = inPromoObjectObj:obj-code
      111           inbf_PromoObject.end-date        = inPromoObjectObj:end-date
      112           inbf_PromoObject.idAction        = inPromoObjectObj:idAction
      113         //  inbf_PromoObject.db-num          = inPromoObjectObj:db-num
      114       .
      115       release inbf_PromoObject.
      116       end.
      117     method private class PromoObjectsub getDataStorage ( buffer inbf_PromoObject for ub.PromoObject ):
      118       define variable PromoObjectsubObj  as class PromoObjectsub.
      119       PromoObjectsubObj = new PromoObjectsub ().
      120       return getDataStorage(PromoObjectsubObj,buffer inbf_PromoObject ).
      121     end.
      122     method private class PromoObjectsub getDataStorage (inPromoObjectSubObj as class PromoObjectsub, buffer inbf_PromoObject for ub.PromoObject ):
      123       assign
      124         inPromoObjectSubObj:ID            = inbf_PromoObject.id
      125         inPromoObjectSubObj:obj-type      = inbf_PromoObject.obj-type
      126         inPromoObjectSubObj:obj-code      = inbf_PromoObject.obj-code
      127         inPromoObjectSubObj:end-date      = inbf_PromoObject.end-date
      128         inPromoObjectSubObj:idAction      = inbf_PromoObject.idAction
      129         inPromoObjectSubObj:db-num        = inbf_PromoObject.db-num
      130       .
      131       return inPromoObjectSubObj.
      132     end.
      133     method public void refreshObj (inPromoObjectSubObj as class PromoObjectsub):
      134       define buffer buf_promoObject for ub.promoObject.
      135       if not valid-object (inPromoObjectSubObj)
      136       then do:
      137         Msg = "Объект типа PromoObjectsub не существует".
      138         return.
      139       end.
      140       find first buf_PromoObject no-lock where buf_PromoObject.ID = inPromoObjectSubObj:ID no-error.
      141       if not available (buf_PromoObject)
      142       then do:
      143         Msg = "Не найден Критерий - " + string (inPromoObjectSubObj:ID) .
      144         return.
      145       end.
      146       getDataStorage (inPromoObjectSubObj, buffer buf_PromoObject).
      147     end.
      148   end class.
