        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promoCriterionstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: 296f0acf624c, 1503, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
        9     define variable vss-date        as character no-undo initial "$Date: Thu Aug 30 10:41:48 2018 +0300 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promocriterionstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promocriterionstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage Criterion Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inPromoCriterionObj as class promoCriterionsub, t-h as handle ):
       17       inpromoCriterionObj:setMsg(arg:get-message (1)).
       18       inpromoCriterionObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void updateDBAll( input promoCriterionsubsObj as promoCriterionsubs ):
       27         updateDBAll (promoCriterionsubsObj,?,?).
       28     end.
       29     method public void updateDBAll( input promoCriterionsubsObj as promoCriterionsubs ,input pIdParent as int64,input pdb-num as integer  ):
       30         define variable vi as int no-undo.
       31         define variable v-sub as promoCriterionsub no-undo .
       32         do vi =  1 to promoCriterionsubsObj:GetItem(vi):
       33            v-sub =promoCriterionsubsObj:promoCriterionObjCurr.
       34            if pIdParent ne ?
       35            then
       36               v-sub:idAction = pIdParent.
       37            if pdb-num ne ?
       38            then
       39               v-sub:db-num = pdb-num.
       40            if      v-sub:Mode eq 'с':U
       41            then
       42               insertDB(v-sub).
       43            else if v-sub:Mode eq 'и':U
       44            then
       45               updateDB(v-sub).
       46            else if v-sub:Mode eq 'у':U
       47            then
       48               deleteDB(v-sub).
       49         end.
       50     end.
       51     method public void insertDB( input promoCriterionsubObj as promoCriterionsub  ):
       52        define buffer buf_promoCriterion for ub.promoCriterion.
       53         if promoCriterionsubObj:db-num eq ? then
       54          undo, throw new Progress.Lang.AppError(
       55            substitute("отсутствует db-num в классе с кодом товара &1", string(promoCriterionsubObj:mincrit))
       56          ) .
       57       define variable vId as integer no-undo.
       58       create buf_promoCriterion.
       59       assign
       60         VId                       = next-value (s-promoCriterion-id, ub)
       61         buf_promoCriterion.id     = vId
       62         buf_promoCriterion.db-num = promoCriterionsubObj:db-num
       63       no-error.
       64       if error-status:error
       65       then do:
       66         exception(error-status, promoCriterionsubObj, buffer buf_promoCriterion:handle).
       67         return.
       68       end.
       69       setDataStorage(input promoCriterionsubObj, buffer buf_promoCriterion).
       70       define variable vStorageGiftOBj  as class promoGiftStorage.
       71       if valid-object(promoCriterionsubObj:Gifts)
       72       then do:
       73             vStorageGiftOBj = new promoGiftStorage().
       74             vStorageGiftOBj:updateDBAll(promoCriterionsubObj:Gifts,promoCriterionsubObj:idAction,vID,promoCriterionsubObj:db-num).
       75       end.
       76       return.
       77       finally:
       78             if valid-object(vStorageGiftOBj) then delete object vStorageGiftOBj.
       79       end finally.
       80     end method.
       81     method public void updateDB( input promoCriterionsubObj as promoCriterionsub  ):
       82       define buffer buf_promoCriterion for ub.promoCriterion.
       83       find first buf_promoCriterion where
       84             buf_promoCriterion.id     = promoCriterionsubObj:ID
       85       no-error.
       86       if not available (buf_promoCriterion)
       87       then do:
       88         exception(error-status, promoCriterionsubObj, buffer buf_promoCriterion:handle).
       89         return.
       90       end.
       91       setDataStorage(input promoCriterionsubObj, buffer buf_promoCriterion).
       92       define variable vStorageGiftOBj  as class promoGiftStorage.
       93       if valid-object(promoCriterionsubObj:Gifts)
       94       then do:
       95             vStorageGiftOBj = new promoGiftStorage().
       96             vStorageGiftOBj:updateDBAll(promoCriterionsubObj:Gifts,promoCriterionsubObj:idAction,promoCriterionsubObj:ID,promoCriterionsubObj:db-num).
       97       end.
       98       return.
       99       finally:
      100             if valid-object(vStorageGiftOBj) then delete object vStorageGiftOBj.
      101       end finally.
      102     end method.
      103     method public void deleteDB( input promoCriterionsubObj as promoCriterionsub  ):
      104       define buffer buf_promoCriterion for ub.promoCriterion.
      105       find first buf_promoCriterion where
      106         buf_promoCriterion.id     = promoCriterionsubObj:ID
      107         no-error.
      108       if not available (buf_promoCriterion)
      109       then do:
      110         exception(error-status, promoCriterionsubObj, buffer buf_promoCriterion:handle).
      111         return.
      112       end.
      113       delete buf_promoCriterion.
      114       return.
      115     end method.
      116     method public class promoCriterionsubs getpromoCriterionsubs (input pId as int64,input idb-num as int ):
      117       define buffer buf_promoCriterion for ub.promoCriterion.
      118       define variable promoCriterionsubsObj as class promoCriterionsubs.
      119       promoCriterionsubsObj = new promoCriterionsubs ().
      120       for each buf_promoCriterion  where buf_promoCriterion.idAction = pId
      121                                      and buf_promoCriterion.db-num = idb-num
      122       no-lock:
      123           promoCriterionsubsObj:AddItem(getDataStorage (buffer buf_promoCriterion)).
      124       end.
      125       return promoCriterionsubsObj.
      126     end method.
      127     method private void setDataStorage (input inpromoCriterionObj as class promoCriterionsub, buffer inbf_promoCriterion for ub.promoCriterion ):
      128       define buffer buf_promoAttr for ub.PromoAttr .
      129       assign
      130           inbf_promoCriterion.mincrit         = inpromoCriterionObj:mincrit
      131           inbf_promoCriterion.discont         = inpromoCriterionObj:discont
      132           inbf_promoCriterion.idAction        = inpromoCriterionObj:idAction
      133           //inbf_promoCriterion.db-num          = inpromoCriterionObj:db-num
      134       .
      135       validate inbf_promoCriterion.
      136       find first buf_promoAttr no-lock where buf_promoAttr.attr-code = "maxcrit" and
      137       buf_promoAttr.p-key = string(inbf_promoCriterion.id) + chr(3) +
      138                             string(inbf_promoCriterion.db-num)  and
      139       buf_promoAttr.tablename = "promoCriterion" no-error .
      140       if not available (buf_promoAttr) then do:
      141         create buf_promoAttr .
      142         assign
      143         buf_promoAttr.attr-code = "maxcrit"
      144         buf_promoAttr.p-key = string(inbf_promoCriterion.id) + chr(3) + string(inbf_promoCriterion.db-num)
      145         buf_promoAttr.tablename = "promoCriterion"
      146         .
      147       end.
      148        buf_promoAttr.attr-value = string(inpromoCriterionObj:maxcrit).
      149       end.
      150     method private class promoCriterionsub getDataStorage ( buffer inbf_promoCriterion for ub.promoCriterion ):
      151       define variable promoCriterionsubObj  as class promoCriterionsub.
      152       promoCriterionsubObj = new promoCriterionsub ().
      153       return getDataStorage(promoCriterionsubObj,buffer inbf_promoCriterion).
      154     end.
      155     method private class promoCriterionsub getDataStorage (inpromoCriterionSubObj as class promoCriterionsub,buffer inbf_promoCriterion for ub.promoCriterion ):
      156       define buffer buf_promoAttr for ub.PromoAttr .
      157       find first buf_promoAttr no-lock where buf_promoAttr.attr-code = "maxcrit" and
      158       buf_promoAttr.p-key = string(inbf_promoCriterion.id) + chr(3) +
      159                             string(inbf_promoCriterion.db-num)  and
      160       buf_promoAttr.tablename = "promoCriterion" no-error .
      161       if available (buf_promoAttr) then inpromoCriterionSubObj:maxcrit       = decimal(buf_promoAttr.attr-value) .
      162       assign
      163         inpromoCriterionSubObj:ID            = inbf_promoCriterion.id
      164         inpromoCriterionSubObj:mincrit       = inbf_promoCriterion.mincrit
      165         inpromoCriterionSubObj:discont       = inbf_promoCriterion.discont
      166         inpromoCriterionSubObj:idAction      = inbf_promoCriterion.idAction
      167         inpromoCriterionSubObj:db-num        = inbf_promoCriterion.db-num
      168       .
      169       return inpromoCriterionSubObj.
      170     end.
      171     method public void refreshObj (inpromoCriterionSubObj as class promoCriterionsub):
      172       define buffer buf_promoCriterion for ub.promoCriterion.
      173       if not valid-object (inpromoCriterionSubObj)
      174       then do:
      175         Msg = "Объект типа promoCriterionsub не существует".
      176         return.
      177       end.
      178       find first buf_promoCriterion no-lock where buf_promoCriterion.ID = inpromoCriterionSubObj:ID no-error.
      179       if not available (buf_promoCriterion)
      180       then do:
      181         Msg = "Не найден Критерий - " + string (inpromoCriterionSubObj:ID) .
      182         return.
      183       end.
      184       getDataStorage (inpromoCriterionSubObj,buffer buf_promoCriterion).
      185     end.
      186   end class.
