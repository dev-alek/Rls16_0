        1   using Progress.Lang.*.
        2   using ibs.th.str.ptrl.*.
        3   block-level on error undo, throw.
        4   class ibs.th.gbl.storage.rvsinvstr:
        5     define property ListAttr as character init "MeteringErr,Diff,TPNormalPL,TPNormalAuto,NormalWastage"
        6       get.
        7     def private var v-metererrwast as dec no-undo.
        8     def private var v-natur-wast as dec no-undo.
        9     def private var v-tp-wast as dec no-undo.
       10     method public void insertDB( input rvsinvsubObj as class rvsinvsub  ):
       11       define buffer bf_rvs-l-attr for ub.rvs-line-attr.
       12       create bf_rvs-l-attr.
       13       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       14       bf_rvs-l-attr.attr-code = "MeteringErr".
       15       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:MeteringErr).
       16       create bf_rvs-l-attr.
       17       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       18       bf_rvs-l-attr.attr-code = "Diff".
       19       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:Diff).
       20       create bf_rvs-l-attr.
       21       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       22       bf_rvs-l-attr.attr-code = "TPNormalAuto".
       23       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:TPNormalAuto).
       24       create bf_rvs-l-attr.
       25       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       26       bf_rvs-l-attr.attr-code = "TPNormalPL".
       27       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:TPNormalPl).
       28       create bf_rvs-l-attr.
       29       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       30       bf_rvs-l-attr.attr-code = "NormalWastage".
       31       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:NormalWastage).
       32       finally:
       33         SetWast(rvsinvsubObj).
       34         release bf_rvs-l-attr.
       35       end finally.
       36     end.
       37     method public void updateDB( input rvsinvsubObj as class rvsinvsub  ):
       38       define buffer bf_rvs-l-attr for ub.rvs-line-attr.
       39       find first bf_rvs-l-attr exclusive-lock where
       40             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
       41         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
       42         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
       43         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
       44         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
       45         and bf_rvs-l-attr.attr-code = "MeteringErr"
       46         no-error.
       47       if not available (bf_rvs-l-attr)
       48       then do:
       49         message "rvsinvstr: Ошибка обновления записи. Запись отсутствует." view-as alert-box error.
       50         return.
       51       end.
       52       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       53       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:MeteringErr).
       54       find first bf_rvs-l-attr exclusive-lock where
       55             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
       56         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
       57         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
       58         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
       59         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
       60         and bf_rvs-l-attr.attr-code = "Diff"
       61         no-error.
       62       if not available (bf_rvs-l-attr)
       63       then do:
       64         message "rvsinvstr: Ошибка обновления записи. Запись отсутствует." view-as alert-box error.
       65         return.
       66       end.
       67       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       68       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:Diff).
       69       find first bf_rvs-l-attr exclusive-lock where
       70             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
       71         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
       72         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
       73         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
       74         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
       75         and bf_rvs-l-attr.attr-code = "TPNormalAuto"
       76         no-error.
       77       if not available (bf_rvs-l-attr)
       78       then do:
       79         message "rvsinvstr: Ошибка обновления записи. Запись отсутствует." view-as alert-box error.
       80         return.
       81       end.
       82       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       83       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:TPNormalAuto).
       84       find first bf_rvs-l-attr exclusive-lock where
       85             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
       86         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
       87         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
       88         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
       89         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
       90         and bf_rvs-l-attr.attr-code = "TPNormalPl"
       91         no-error.
       92       if not available (bf_rvs-l-attr)
       93       then do:
       94         message "rvsinvstr: Ошибка обновления записи. Запись отсутствует." view-as alert-box error.
       95         return.
       96       end.
       97       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
       98       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:TPNormalPl).
       99       find first bf_rvs-l-attr exclusive-lock where
      100             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
      101         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
      102         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
      103         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
      104         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
      105         and bf_rvs-l-attr.attr-code = "NormalWastage"
      106         no-error.
      107       if not available (bf_rvs-l-attr)
      108       then do:
      109         message "rvsinvstr: Ошибка обновления записи. Запись отсутствует." view-as alert-box error.
      110         return.
      111       end.
      112       RvsLAttrFillHeadr(rvsinvsubObj, buffer bf_rvs-l-attr).
      113       bf_rvs-l-attr.attr-value = string (rvsinvsubObj:NormalWastage).
      114       finally:
      115         SetWast(rvsinvsubObj).
      116         release bf_rvs-l-attr.
      117       end finally.
      118     end.
      119     method private void RvsLAttrFillHeadr ( input rvsinvsubObj as class rvsinvsub, buffer bf_rvs-l-attr for ub.rvs-line-attr ):
      120         bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode.
      121         bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType.
      122         bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode.
      123         bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode.
      124         bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode.
      125     end.
      126     method public void DeleteDB ( rvscode as char, objtype as char, objcode as int ):
      127       define buffer bf_rvs-l-attr for ub.rvs-line-attr.
      128       for each bf_rvs-l-attr exclusive-lock where
      129               bf_rvs-l-attr.rvs-code = rvscode
      130           and bf_rvs-l-attr.obj-type = objtype
      131           and bf_rvs-l-attr.obj-code = objcode
      132           and lookup (bf_rvs-l-attr.attr-code, ListAttr) > 0
      133           :
      134         delete bf_rvs-l-attr.
      135       end.
      136     end.
      137     method public void FillSumByOver ( rvsinvsubsObj as class rvsinvsubs  ):
      138       FillSum ( rvsinvsubsObj, false ).
      139     end.
      140     method public void FillSumByDeficit ( rvsinvsubsObj as class rvsinvsubs  ):
      141       FillSum ( rvsinvsubsObj, true ).
      142     end.
      143     method public void FillSum ( rvsinvsubsObj as class rvsinvsubs, isDeficit as logical  ):
      144       define buffer bf_rvs-l-attr for ub.rvs-line-attr.
      145       define buffer bf_rvs-l-attr-1 for ub.rvs-line-attr.
      146       def var v-metererrnorm as dec no-undo.
      147       def var v-natur-norm as dec no-undo.
      148       def var v-tp-norm as dec no-undo.
      149       for each bf_rvs-l-attr no-lock where
      150             bf_rvs-l-attr.rvs-code = rvsinvsubsObj:RvsCode
      151         and bf_rvs-l-attr.obj-type = rvsinvsubsObj:ObjType
      152         and bf_rvs-l-attr.obj-code = rvsinvsubsObj:ObjCode
      153         and bf_rvs-l-attr.attr-code = "Diff"
      154         and ( (not isDeficit and decimal (bf_rvs-l-attr.attr-value) >= 0)  or (isDeficit and decimal (bf_rvs-l-attr.attr-value) < 0))
      155           :
      156         for each bf_rvs-l-attr-1 no-lock where
      157               bf_rvs-l-attr-1.rvs-code = rvsinvsubsObj:RvsCode
      158           and bf_rvs-l-attr-1.obj-type = rvsinvsubsObj:ObjType
      159           and bf_rvs-l-attr-1.obj-code = rvsinvsubsObj:ObjCode
      160           and bf_rvs-l-attr-1.gds-code  = bf_rvs-l-attr.gds-code
      161           and bf_rvs-l-attr-1.pl-code  = bf_rvs-l-attr.pl-code
      162           and lookup (bf_rvs-l-attr-1.attr-code, ListAttr) > 0:
      163           case bf_rvs-l-attr-1.attr-code:
      164             when "Diff" then do:
      165               rvsinvsubsObj:DiffSum = rvsinvsubsObj:DiffSum + decimal (bf_rvs-l-attr-1.attr-value).
      166               rvsinvsubsObj:IsRvsInvAlg3 = true.
      167             end.
      168             when "TPNormalAuto" then do:
      169               v-tp-norm = v-tp-norm + decimal (bf_rvs-l-attr-1.attr-value).
      170             end.
      171             when "TPNormalPl" then do:
      172               v-tp-norm = v-tp-norm + decimal (bf_rvs-l-attr-1.attr-value).
      173             end.
      174             when "NormalWastage" then do:
      175               v-natur-norm = decimal (bf_rvs-l-attr-1.attr-value).
      176             end.
      177             when "MeteringErr" then do:
      178               v-metererrnorm = decimal (bf_rvs-l-attr-1.attr-value).
      179             end.
      180           end case.
      181         end.
      182         v-tp-norm = round (v-tp-norm, 0).
      183         SetWast(decimal (bf_rvs-l-attr.attr-value), v-metererrnorm, v-natur-norm, v-tp-norm ).
      184         rvsinvsubsObj:NaturWastageSum = rvsinvsubsObj:NaturWastageSum + v-natur-wast.
      185         rvsinvsubsObj:MeteringErrWastSum = rvsinvsubsObj:MeteringErrWastSum + v-metererrwast.
      186         rvsinvsubsObj:TPWastSum = rvsinvsubsObj:TPWastSum  + v-tp-wast.
      187         v-tp-norm = 0.
      188       end.
      189     end.
      190     method public void SetWast (rvsinvObj as rvsinvsub):
      191       SetWast (rvsinvObj:Diff, rvsinvObj:MeteringErr, rvsinvObj:NormalWastage, rvsinvObj:TPNormal).
      192       assign
      193         rvsinvObj:MeterErrWast = v-metererrwast
      194         rvsinvObj:NaturWast = v-natur-wast
      195         rvsinvObj:TPWast = round (v-tp-wast, 0).
      196       .
      197     end.
      198     method private void SetWast (inDiff as decimal, inMetErrN as decimal, inNaturN as decimal, inTPN as decimal):
      199       if absolute (inDiff) < inMetErrN
      200         then
      201           assign
      202             v-metererrwast = inDiff
      203             v-natur-wast = 0
      204             v-tp-wast = 0
      205           .
      206       else
      207         if absolute (inDiff) < inMetErrN + inNaturN
      208           then
      209             assign
      210               v-metererrwast = inMetErrN
      211               v-natur-wast = inDiff - inMetErrN
      212               v-tp-wast = 0
      213             .
      214           else
      215             if absolute (inDiff) < inMetErrN + inNaturN + inTPN
      216             then
      217               assign
      218                 v-metererrwast = inMetErrN
      219                 v-natur-wast = inNaturN
      220                 v-tp-wast = inDiff - (inMetErrN + inNaturN)
      221               .
      222             else
      223               assign
      224                 v-metererrwast = inMetErrN
      225                 v-natur-wast = inNaturN
      226                 v-tp-wast = inTPN
      227               .
      228     end.
      229     method public logical FillSub ( rvsinvsubObj as class rvsinvsub):
      230       define buffer bf_rvs-l-attr for ub.rvs-line-attr.
      231       define variable isRvsInv as logical no-undo init false.
      232       for each bf_rvs-l-attr no-lock where
      233             bf_rvs-l-attr.rvs-code = rvsinvsubObj:RvsCode
      234         and bf_rvs-l-attr.obj-type = rvsinvsubObj:ObjType
      235         and bf_rvs-l-attr.obj-code = rvsinvsubObj:ObjCode
      236         and bf_rvs-l-attr.gds-code = rvsinvsubObj:GdsCode
      237         and bf_rvs-l-attr.pl-code = rvsinvsubObj:PlCode
      238           :
      239         case bf_rvs-l-attr.attr-code:
      240           when "Diff" then do:
      241             rvsinvsubObj:Diff = decimal (bf_rvs-l-attr.attr-value).
      242           end.
      243           when "TPNormalAuto" then do:
      244             rvsinvsubObj:TPNormalAuto = decimal (bf_rvs-l-attr.attr-value).
      245           end.
      246           when "TPNormalPl" then do:
      247             rvsinvsubObj:TPNormalPl = decimal (bf_rvs-l-attr.attr-value).
      248           end.
      249           when "NormalWastage" then do:
      250             rvsinvsubObj:NormalWastage = decimal (bf_rvs-l-attr.attr-value).
      251           end.
      252           when "MeteringErr" then do:
      253             rvsinvsubObj:MeteringErr = decimal (bf_rvs-l-attr.attr-value).
      254           end.
      255         end case.
      256         isRvsInv = true.
      257       end.
      258       SetWast(rvsinvsubObj).
      259       return isRvsInv.
      260     end.
      261     method public void CalcSum (RvsInvSubsObj as class rvsinvsubs):
      262       def var ii as int no-undo.
      263       assign
      264         RvsInvSubsObj:MeteringErrWastSum = 0
      265         RvsInvSubsObj:TPWastSum = 0
      266         RvsInvSubsObj:NaturWastageSum = 0
      267         RvsInvSubsObj:DiffSum = 0
      268       .
      269       do ii = 1 to RvsInvSubsObj:iCounter:
      270         assign
      271           RvsInvSubsObj:MeteringErrWastSum = RvsInvSubsObj:RvsInvSubCurr:MeterErrWast + RvsInvSubsObj:MeteringErrWastSum
      272           RvsInvSubsObj:NaturWastageSum = RvsInvSubsObj:RvsInvSubCurr:NaturWast + RvsInvSubsObj:NaturWastageSum
      273           RvsInvSubsObj:TPWastSum = RvsInvSubsObj:RvsInvSubCurr:TPWast + RvsInvSubsObj:TPWastSum
      274           RvsInvSubsObj:DiffSum = RvsInvSubsObj:RvsInvSubCurr:Diff + RvsInvSubsObj:DiffSum
      275         .
      276       end.
      277     end method.
      278   end class.
