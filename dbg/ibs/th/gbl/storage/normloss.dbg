        1   using Progress.Lang.*.
        2   using ibs.th.str.mercury.*.
        3   using ibs.th.gbl.storage.*.
        4   using ibs.th.gbl.*.
        5   using ibs.th.str.clients.*.
        6   using ibs.th.ref.* from propath.
        7   block-level on error undo, throw.
        8   class ibs.th.gbl.storage.normloss:
        9     define property Msg as character
       10       get.
       11       private set.
       12     define buffer buf_norm-loss for ub.norm-loss.
       13     method private void exception( arg as handle, invsdObj as class vsdsub, t-h as handle ):
       14       invsdObj:setMsg(arg:get-message (1)).
       15       invsdObj:setStatusErr(arg:error).
       16       t-h:buffer-delete () no-error.
       17       return.
       18     end method.
       19     method private void exception( arg as char ):
       20       Msg = arg.
       21       return.
       22     end method.
       23     method public void insertDB( input normlossobj as normlosssub  ):
       24       create buf_norm-loss.
       25       assign
       26       no-error.
       27       if error-status:error
       28       then do:
       29         return.
       30       end.
       31       setDataStorage(input normlossobj, buffer buf_norm-loss).
       32       return.
       33     end method.
       34     method public void updateDB( input normlossObj as normlosssub  ):
       35       find first buf_norm-loss where
       36         buf_norm-loss.id = normlossObj:ID no-error.
       37       if not available (buf_norm-loss)
       38       then do:
       39         return.
       40       end.
       41       setDataStorage(input normlossObj, buffer buf_norm-loss).
       42       release buf_norm-loss.
       43       return.
       44     end method.
       45     method public void getNormLoss ( parTPforNorm as class partpnloss ):
       46       def buffer bf_norm-loss for ub.norm-loss.
       47       def buffer bf_pl-attr for ub.place-attr.
       48       def buffer bf_gds-attr for ub.goods-attr.
       49       def buffer bf_cli-attr for ub.clients-attr.
       50       def buffer buf_auto-tank for ub.auto-tank.
       51       def buffer buf_auto-section for ub.auto-section.
       52       def var plnlValue as decimal init 0 no-undo.
       53       def var autonlValue as decimal init 0 no-undo.
       54       def var climGrp as character no-undo.
       55       def var dateSeason1 as date no-undo.
       56       def var dateSeason2 as date no-undo.
       57       def var season as integer no-undo.
       58       def var locate as character no-undo.
       59       find first bf_pl-attr no-lock
       60         where
       61               bf_pl-attr.pl-code = parTPforNorm:PlCode
       62           and bf_pl-attr.obj-type = parTPforNorm:ObjType
       63           and bf_pl-attr.obj-code = parTPforNorm:ObjCode
       64           and bf_pl-attr.attr-code = "place-local"
       65         no-error.
       66       if available (bf_pl-attr)
       67       then do:
       68         if bf_pl-attr.attr-value = "1"
       69           then locate = "0".
       70           else locate = "1".
       71       end.
       72       else locate = "1".
       73       find first bf_gds-attr no-lock where
       74             bf_gds-attr.gds-code = parTPforNorm:GdsCode
       75         and bf_gds-attr.attr-code = 'group-np':U
       76         no-error.
       77       find first bf_cli-attr no-lock where
       78             bf_cli-attr.obj-type = parTPforNorm:ObjType
       79         and bf_cli-attr.obj-code = parTPforNorm:ObjCode
       80         and bf_cli-attr.attr-code = 'cli-clim-grp':U
       81         no-error.
       82       if available (bf_cli-attr)
       83       and (available (bf_gds-attr) or parTPforNorm:GroupNP > "")
       84       and parTPforNorm:OnDate <> ?
       85       then do:
       86         if num-entries (bf_cli-attr.attr-value) = 3
       87         then do:
       88           climGrp = entry (1,bf_cli-attr.attr-value).
       89           dateSeason1 = date (entry (2,bf_cli-attr.attr-value)  + "/" + string (year (parTPforNorm:OnDate))).
       90           dateSeason2 = date (entry (3,bf_cli-attr.attr-value)  + "/" + string (year (parTPforNorm:OnDate))).
       91           if dateSeason1 < parTPforNorm:OnDate and parTPforNorm:OnDate < dateSeason2
       92           then
       93             season = 0.
       94           else
       95             season = 1.
       96         end.
       97       end.
       98       find first bf_norm-loss no-lock where bf_norm-loss.type = 0 and bf_norm-loss.clim-grp = climGrp
       99           and bf_norm-loss.oil-grp = (if parTPforNorm:GroupNP > "" then parTPforNorm:GroupNP else bf_gds-attr.attr-value)
      100           and bf_norm-loss.position = locate
      101           and bf_norm-loss.season = season
      102           no-error.
      103       if available (bf_norm-loss)
      104         then plnlValue = bf_norm-loss.value-loss.
      105       def var maxlvl as decimal no-undo.
      106       def var maxlvl1 as decimal no-undo.
      107       def var maxlvl2 as decimal no-undo.
      108       for first buf_auto-section no-lock where buf_auto-section.auto-num = parTPforNorm:AutoNum
      109                                            and buf_auto-section.section-num = integer(parTPforNorm:SecNum)
      110                                            :
      111         assign
      112           maxlvl = buf_auto-section.brutto-qnty / 1000
      113         no-error.
      114       end.
      115       for last bf_norm-loss no-lock where maxlvl > 0 and bf_norm-loss.type = 1 and bf_norm-loss.clim-grp = climGrp
      116           and bf_norm-loss.oil-grp = (if parTPforNorm:GroupNP > "" then parTPforNorm:GroupNP else bf_gds-attr.attr-value)
      117           and bf_norm-loss.season = season
      118           and
      119           (
      120             ((bf_norm-loss.sec-vol1) < maxlvl
      121             and (bf_norm-loss.sec-vol2) >= maxlvl)
      122             or
      123             ((bf_norm-loss.sec-vol1) < maxlvl
      124             and (bf_norm-loss.sec-vol2) = 0)
      125           )
      126           by bf_norm-loss.sec-vol1:
      127           autonlValue = bf_norm-loss.value-loss.
      128       end.
      129       finally:
      130         release bf_pl-attr.
      131         release bf_cli-attr.
      132         release bf_gds-attr.
      133         release buf_norm-loss.
      134         parTPforNorm:PLNormLoss = plnlValue.
      135         parTPforNorm:AutoNormLoss = autonlValue.
      136       end finally.
      137     end method.
      138     method public decimal getNormLoss ( input auto-num as char, input in-gds-code as int ):
      139       def buffer buf_norm-loss for ub.norm-loss.
      140       def var nlValue as decimal no-undo.
      141       release buf_norm-loss.
      142       return nlValue.
      143     end method.
      144     method private void setDataStorage (input innormlossObj as class normlosssub, buffer inbf_normloss for ub.norm-loss ):
      145       assign
      146         inbf_normloss.id         = innormlossObj:ID
      147         inbf_normloss.clim-grp   = innormlossObj:ClimGrp
      148         inbf_normloss.oil-grp    = innormlossObj:OilGrp
      149         inbf_normloss.position   = innormlossObj:Position_
      150         inbf_normloss.season     = innormlossObj:Season
      151         inbf_normloss.sec-vol    = innormlossObj:SecVol
      152         inbf_normloss.type       = innormlossObj:Type_
      153         inbf_normloss.value-loss = innormlossObj:ValueLoss
      154       .
      155       release inbf_normloss.
      156     end.
      157     method private class normlosssub getDataStorage ( buffer inbf_normloss for ub.norm-loss ):
      158       define variable normlossObj as class normlosssub no-undo.
      159       normlossObj = new normlosssub ().
      160       assign
      161         normlossObj:ID        = inbf_normloss.id
      162         normlossObj:ClimGrp   = inbf_normloss.clim-grp
      163         normlossObj:OilGrp    = inbf_normloss.oil-grp
      164         normlossObj:Position_ = inbf_normloss.position
      165         normlossObj:Season    = inbf_normloss.season
      166         normlossObj:SecVol    = inbf_normloss.sec-vol
      167         normlossObj:Type_     = inbf_normloss.type
      168         normlossObj:ValueLoss = inbf_normloss.value-loss
      169       .
      170       return normlossObj.
      171     end.
      172     method private decimal SecVol1 (arg as char):
      173       return decimal (entry (1, arg, "-")).
      174     end.
      175     method private decimal SecVol2 (arg as char):
      176       if num-entries (arg, "-") = 2
      177         then return decimal (entry (2, arg, "-")).
      178         else return ?.
      179     end.
      180   end class.
