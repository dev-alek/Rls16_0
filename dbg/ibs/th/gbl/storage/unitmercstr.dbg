        1   using Progress.Lang.*.
        2   using ibs.th.str.mercury.*.
        3   using ibs.th.gbl.storage.*.
        4   using ibs.th.gbl.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.unitmercstr:
        7     define buffer buf_units for ub.units.
        8     define buffer buf_units-attr for ub.units-attr.
        9     define buffer buf_goods-attr for ub.goods-attr.
       10     method private void exception( arg as handle, inunitmercObj as class unitsub, t-h as handle ):
       11       inunitmercObj:setMsg(arg:get-message (1)).
       12       inunitmercObj:setStatusErr(arg:error).
       13       t-h:buffer-delete () no-error.
       14       message "Œ¯Ë·Í‡ - "  inunitmercObj:Msg view-as alert-box.
       15       return.
       16     end method.
       17     method public void writeDB( input unitsObj as class unitsubs, input inGdsCode as integer ):
       18       find first buf_goods-attr where buf_goods-attr.gds-code = inGdsCode
       19                                   and buf_goods-attr.attr-code = 'MercUnits':U no-error .
       20       if not available (buf_goods-attr)
       21       then do:
       22         create buf_goods-attr.
       23         assign
       24           buf_goods-attr.gds-code = inGdsCode
       25           buf_goods-attr.attr-code = 'MercUnits':U
       26         .
       27       end.
       28       setDataStorage(input unitsObj, buffer buf_goods-attr).
       29       release buf_goods-attr.
       30       return.
       31     end method.
       32     method public void deleteDB( input inGdsCode as integer  ):
       33       find first buf_goods-attr where buf_goods-attr.gds-code = inGdsCode
       34                                   and buf_goods-attr.attr-code = 'MercUnits':U no-error .
       35       if not available (buf_goods-attr)
       36       then do:
       37         return.
       38       end.
       39       delete buf_goods-attr.
       40       return.
       41     end method.
       42     method public class unitsubs getunitmercs (input inGdsCode as integer ):
       43       define variable ii as integer no-undo .
       44       define variable unitsObj as class unitsubs no-undo .
       45       unitsObj = new unitsubs ().
       46       for first buf_goods-attr where buf_goods-attr.gds-code = inGdsCode
       47                                  and buf_goods-attr.attr-code = 'MercUnits':U:
       48         do ii = 1 to num-entries(buf_goods-attr.attr-value, chr(4)) :
       49           unitsObj:AddItem(getDataStorage (entry(ii, buf_goods-attr.attr-value, chr(4)))).
       50         end.
       51       end.
       52       return unitsObj.
       53     end method.
       54     method private void setDataStorage (input unitsObj as class unitsubs, buffer inbf_goods-attr for ub.goods-attr ):
       55       define variable ii as integer no-undo .
       56       inbf_goods-attr.attr-value = "" .
       57       do ii = 1 to unitsObj:GetItem(ii) :
       58         inbf_goods-attr.attr-value = inbf_goods-attr.attr-value
       59                                    + (if inbf_goods-attr.attr-value = "" then "" else chr(4))
       60                                    + unitsObj:UnitObjCurr:UnitName + chr(3) + string(unitsObj:UnitObjCurr:UnitCoef) .
       61       end .
       62       release inbf_goods-attr.
       63     end.
       64     method private class unitsub getDataStorage ( input inAttrValue as character ):
       65       define variable unitObj  as class unitsub no-undo .
       66       unitObj = new unitsub ().
       67       find first buf_units no-lock where buf_units.unit-name = entry(1, inAttrValue, chr(3)) .
       68       find first buf_units-attr no-lock where buf_units-attr.unit-name = entry(1, inAttrValue, chr(3))
       69                                          and buf_units-attr.attr-code = "MercGuid" no-error.
       70       assign
       71         unitObj:UnitName          = buf_units.unit-name
       72         unitObj:UnitFullName      = buf_units.long-name
       73         unitObj:UnitGuid          = if available buf_units-attr then buf_units-attr.attr-value else ""
       74         unitObj:UnitCoef          = decimal(entry(2, inAttrValue, chr(3)))
       75       .
       76       return unitObj.
       77     end.
       78   end class.
