        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promoSchedstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: 8aa5522306d2, 3076, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: DRuban $":U .
        9     define variable vss-date        as character no-undo initial "$Date: Пт авг 05 19:16:16 2022 +0300 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promoschedstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promoschedstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage Sched Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inObj as class promoSchedsub, t-h as handle ):
       17       inObj:setMsg(arg:get-message (1)).
       18       inObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void insertDB( input inObj as promoSchedsub ):
       27       define buffer buf_promo-schedule for ub.promo-schedule .
       28       if inObj:db-num eq ? then
       29          undo, throw new Progress.Lang.AppError(
       30            substitute("отсутствует db-num в классе заголовков расписаний &1", inObj:dispname)
       31          ) .
       32       create buf_promo-schedule.
       33       assign
       34         buf_promo-schedule.id     = inObj:ID
       35         buf_promo-schedule.db-num = inObj:db-num
       36       no-error.
       37       if error-status:error
       38       then do:
       39         exception(error-status, inObj, buffer buf_promo-schedule:handle).
       40         return.
       41       end.
       42       setDataStorage(input inObj, buffer buf_promo-schedule).
       43     end method.
       44     method public void updateDB( input inObj as promoSchedsub  ):
       45       define buffer buf_promo-schedule for ub.promo-schedule .
       46       find first buf_promo-schedule where buf_promo-schedule.id = inObj:ID no-error.
       47       if not available (buf_promo-schedule)
       48       then do:
       49         exception(error-status, inObj, buffer buf_promo-schedule:handle).
       50         return.
       51       end.
       52       setDataStorage(input inObj, buffer buf_promo-schedule).
       53       return.
       54     end method.
       55     method public void deleteDB( input inObj as promoSchedsub  ):
       56       if not valid-object(inObj)
       57       then
       58          return.
       59       define buffer buf_promo-schedule for ub.promo-schedule .
       60       find first buf_promo-schedule where buf_promo-schedule.id = inObj:ID no-error.
       61       if not available (buf_promo-schedule)
       62       then do:
       63         exception(error-status, inObj, buffer buf_promo-schedule:handle).
       64         return.
       65       end.
       66       delete buf_promo-schedule.
       67       return.
       68     end method.
       69     method public class promoSchedsub getpromoSchedsub (input idPromoSched as integer):
       70       define buffer buf_promo-schedule for ub.promo-schedule .
       71       define variable v-sub as class promoSchedsub no-undo .
       72       for first buf_promo-schedule where buf_promo-schedule.id eq idPromoSched
       73       no-lock:
       74           v-sub = getDataStorage (buffer buf_promo-schedule).
       75       end.
       76       return v-sub.
       77     end method.
       78     method private void setDataStorage (input inObj as class promoSchedsub, buffer inbf for ub.promo-schedule ):
       79       define variable v-status as ibs.th.ref.promo.enum-sched-status no-undo .
       80       v-status = inObj:status_ .
       81       assign
       82         inbf.dispname       = inObj:dispname
       83         inbf.sched-type     = inObj:schedType
       84         inbf.status_        = v-status:getvalue() when valid-object(v-status)
       85         inbf.ext-code-sched = inObj:extCodeSched
       86       .
       87       validate  inbf.
       88     end method.
       89     method private class promoSchedsub getDataStorage ( buffer inbf for ub.promo-schedule ):
       90       define variable subObj  as class promoSchedsub.
       91       subObj = new promoSchedsub ().
       92       assign
       93         subObj:ID        = inbf.id
       94         subObj:dispname  = inbf.dispname
       95         subObj:schedType = inbf.sched-type
       96         subObj:status_   = ibs.th.ref.promo.enum-sched-status:GetEnum(inbf.status_)
       97         subObj:extCodeSched = inbf.ext-code-sched
       98         subObj:db-num    = inbf.db-num
       99       .
      100       return subObj.
      101     end.
      102     method public void refreshObj (inSubObj as class promoSchedsub):
      103       define buffer buf_promo-schedule for ub.promo-schedule .
      104       if not valid-object (inSubObj)
      105       then do:
      106         Msg = "Объект типа promoSchedtsub не существует".
      107         return.
      108       end.
      109       find first buf_promo-schedule no-lock where buf_promo-schedule.ID = inSubObj:ID no-error.
      110       if not available (buf_promo-schedule)
      111       then do:
      112         Msg = "Не найдено расписание - " + string (inSubObj:ID).
      113         return.
      114       end.
      115       getDataStorage (buffer buf_promo-schedule).
      116     end.
      117   end class.
