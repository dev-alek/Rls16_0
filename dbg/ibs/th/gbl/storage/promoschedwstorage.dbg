        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promoSchedwstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: 8aa5522306d2, 3076, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: DRuban $":U .
        9     define variable vss-date        as character no-undo initial "$Date: Пт авг 05 19:16:16 2022 +0300 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promoschedwstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promoschedwstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage SchedW Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inObj as class promoSchedwsub, t-h as handle ):
       17       inObj:setMsg(arg:get-message (1)).
       18       inObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void updateDBAll( input inObjList as promoSchedwsubs  ):
       27         // 01/VIII-2018 пока ни от куда не вызывался
       28         updateDBAll (inObjList,?,?).
       29     end.
       30     method public void updateDBAll( input inObjList as promoSchedwsubs
       31                                   , input idb-num   as integer
       32                                   , input ishced-id as integer ):
       33         define variable vi as int no-undo.
       34         define variable v-sub as promoSchedwsub no-undo .
       35         define variable v-sched-id as integer no-undo .
       36         v-sched-id = ishced-id .
       37         do vi = 1 to inObjList:GetItem(vi):
       38            v-sub = inObjList:promoSchedwObjCurr .
       39            case v-sub:Mode :
       40              when 'с':U then do:
       41                assign
       42                  v-sub:db-num  = idb-num    when (v-sub:db-num  = 0) and (idb-num    > 0)
       43                  v-sub:schedId = v-sched-id when (v-sub:schedId = 0) and (v-sched-id > 0)
       44                .
       45                insertDB(v-sub).
       46                assign
       47                  v-sched-id = v-sub:schedId when v-sched-id = 0
       48                .
       49              end .
       50              when 'и':U then
       51                updateDB(v-sub).
       52              when 'у':U then
       53                deleteDB(v-sub).
       54              otherwise .
       55            end case .
       56         end. // end_of do_in_objList
       57     end. // end_of_updateDBAll
       58     method public void insertDB( input inObj as promoSchedwsub ):
       59       if inObj:db-num eq ? then
       60          undo, throw new Progress.Lang.AppError(
       61            substitute("отсутствует db-num в классе расписаний &1 &2 & 3", inObj:wdaylist,inObj:timebeg,inObj:timeend)
       62          ) .
       63       define buffer buf_promo-schedule-week for ub.promo-schedule-week .
       64       inObj:ID = next-value (s-promosched-id, ub) .
       65       if inObj:schedId > 0 then . else inObj:schedId = inObj:ID .
       66       create buf_promo-schedule-week.
       67       assign
       68         buf_promo-schedule-week.id     = inObj:ID
       69         buf_promo-schedule-week.db-num = inObj:db-num
       70         buf_promo-schedule-week.promosched-id = inObj:schedId
       71       no-error.
       72       if error-status:error
       73       then do:
       74         exception(error-status, inObj, buffer buf_promo-schedule-week:handle).
       75         return.
       76       end.
       77       setDataStorage(input inObj, buffer buf_promo-schedule-week).
       78     end method.
       79     method public void updateDB( input inObj as promoSchedwsub ):
       80       define buffer buf_promo-schedule-week for ub.promo-schedule-week .
       81       find first buf_promo-schedule-week where buf_promo-schedule-week.id = inObj:ID no-error.
       82       if not available (buf_promo-schedule-week)
       83       then do:
       84         exception(error-status, inObj, buffer buf_promo-schedule-week:handle).
       85         return.
       86       end.
       87       setDataStorage(input inObj, buffer buf_promo-schedule-week).
       88       return.
       89     end method.
       90     method public void deleteDB( input inObj as promoSchedwsub ):
       91       if not valid-object (inObj)
       92       then
       93          return.
       94       define buffer buf_promo-schedule-week for ub.promo-schedule-week .
       95       find first buf_promo-schedule-week where buf_promo-schedule-week.id = inObj:ID no-error.
       96       if not available (buf_promo-schedule-week)
       97       then do:
       98         exception(error-status, inObj, buffer buf_promo-schedule-week:handle).
       99         return.
      100       end.
      101       delete buf_promo-schedule-week.
      102       return.
      103     end method.
      104     method public class promoSchedwsubs getpromoSchedwsubs (input idPromoSched as integer):
      105       define buffer buf_promo-schedule-week for ub.promo-schedule-week .
      106       define variable listObj as class promoSchedwsubs.
      107       listObj = new promoSchedwsubs ().
      108       for each buf_promo-schedule-week where buf_promo-schedule-week.promosched-id eq idPromoSched
      109       no-lock:
      110           listObj:AddItem(getDataStorage (buffer buf_promo-schedule-week)).
      111       end.
      112       return listObj.
      113     end method.
      114     method private void setDataStorage (input inObj as class promoSchedwsub, buffer inbf for ub.promo-schedule-week ):
      115       assign
      116         inbf.timebeg       = inObj:timebeg
      117         inbf.timeend       = inObj:timeend
      118         inbf.wdaylist      = inObj:wdaylist
      119       .
      120       validate inbf.
      121     end method.
      122     method private class promoSchedwsub getDataStorage ( buffer inbf for ub.promo-schedule-week ):
      123       define variable subObj  as class promoSchedwsub.
      124       subObj = new promoSchedwsub ().
      125       assign
      126         subObj:ID       = inbf.id
      127         subObj:schedId  = inbf.promosched-id
      128         subObj:timebeg  = inbf.timebeg
      129         subObj:timeend  = inbf.timeend
      130         subObj:wdaylist = inbf.wdaylist
      131         subObj:db-num   = inbf.db-num
      132       .
      133       return subObj.
      134     end.
      135     method public void refreshObj (inSubObj as class promoSchedwsub):
      136       define buffer buf_promo-schedule-week for ub.promo-schedule-week .
      137       if not valid-object (inSubObj)
      138       then do:
      139         Msg = "Объект типа promoSchedtsub не существует".
      140         return.
      141       end.
      142       find first buf_promo-schedule-week no-lock where buf_promo-schedule-week.ID = inSubObj:ID no-error.
      143       if not available (buf_promo-schedule-week)
      144       then do:
      145         Msg = "Не найдено расписание - " + string (inSubObj:ID).
      146         return.
      147       end.
      148       getDataStorage (buffer buf_promo-schedule-week).
      149     end.
      150   end class.
