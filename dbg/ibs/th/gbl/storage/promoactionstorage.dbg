        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promoactionstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: e455fc319afd, 3602, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: ARostovtsev $":U .
        9     define variable vss-date        as character no-undo initial "$Date: 2023/12/28 12:56:37 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promoactionstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promoactionstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inPromoActionObj as class promoactionsub, t-h as handle ):
       17       inpromoactionObj:setMsg(arg:get-message (1)).
       18       inpromoactionObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void insertDB( input promoactionsubObj as promoactionsub  ):
       27       define buffer buf_promoaction for ub.promoaction.
       28       define variable vID     as integer no-undo.
       29       define variable vDb-num as integer no-undo.
       30       create buf_promoaction.
       31       assign
       32         vID                    = if promoactionsubObj:id > 0 then promoactionsubObj:id else next-value (s-promoaction-id, ub)
       33         buf_promoaction.id     = vID
       34         vDb-num                = ibs.th.gbl.gbl-var:g#db-num
       35         buf_promoaction.db-num = vDb-num
       36       no-error.
       37       if error-status:error
       38       then do:
       39         exception(error-status, promoactionsubObj, buffer buf_promoaction:handle).
       40         return.
       41       end.
       42       assign
       43           promoactionsubObj:ID     = VID
       44           promoactionsubObj:db-num = vDb-num
       45       .
       46       updateDBChiled(input promoactionsubObj,buffer buf_promoaction).
       47     end method.
       48     method public void updateDB( input promoactionsubObj as promoactionsub  ):
       49       define buffer buf_promoaction for ub.promoaction.
       50       find first buf_promoaction where
       51             buf_promoaction.id     = promoactionsubObj:ID
       52       no-error.
       53       if not available (buf_promoaction)
       54       then do:
       55         exception(error-status, promoactionsubObj, buffer buf_promoaction:handle).
       56         return.
       57       end.
       58       updateDBChiled(input promoactionsubObj,buffer buf_promoaction).
       59     end method.
       60     method public void updateDBChiled( input ipromoactionsubObj as promoactionsub ,buffer buf_promoaction for ub.promoaction):
       61       define variable vStoragegoodsOBj  as class promoGoodsStorage.
       62       define variable vStorageCritOBj   as class promoCriterionStorage.
       63       define variable vStorageGiftOBj   as class promoGiftStorage.
       64       define variable vStorageObjectOBj as class promoObjectStorage.
       65       define variable vStorageschedObj  as class promoSchedstorage.
       66       define variable vStorageschedwObj as class promoSchedwstorage.
       67       define variable vSchedDays        as class promoSchedwsubs.
       68       define variable vSchedDay         as class promoSchedwsub.
       69       define variable vSchedule         as class promoSchedsub.
       70       define variable v-sched-id        as integer no-undo .
       71       assign
       72         vSchedDays = ipromoactionsubObj:ScheduleWeek
       73         vSchedule  = ipromoactionsubObj:Schedule
       74       .
       75       CleanChildObj(ipromoactionsubObj).
       76      if valid-object (vSchedDays) and valid-object (vSchedule) then do:
       77        vStorageschedwObj = new promoSchedwstorage ().
       78   //   vStorageschedwObj:updateDBAll(vSchedDays, buf_promoaction.Db-num, buf_promoaction.promosched-id) .
       79        vStorageschedwObj:updateDBAll(vSchedDays, buf_promoaction.Db-num, ipromoactionsubObj:promosched-id) .
       80        vStorageschedObj  = new promoSchedstorage ().
       81        case vSchedule:Mode :
       82          when 'с':U then do:
       83            vSchedule:db-num = buf_promoaction.Db-num .
       84            vSchedDay  = vSchedDays:promoSchedwObjCurr .
       85            v-sched-id = if valid-object(vSchedDay) then vSchedDay:schedId else next-value (s-promosched-id, ub) .
       86            assign
       87              vSchedule:ID = v-sched-id
       88              ipromoactionsubObj:promosched-id = v-sched-id
       89            .
       90            vStorageschedObj:insertDB(vSchedule).
       91          end .
       92          when 'и':U then
       93            vStorageschedObj:updateDB(vSchedule).
       94          when 'у':U then
       95            vStorageschedObj:deleteDB(vSchedule).
       96          otherwise .
       97        end case .
       98      end .
       99      setDataStorage(input ipromoactionsubObj, buffer buf_promoaction).
      100      if    valid-object (ipromoactionsubObj:GoodsCrits)
      101         or valid-object (ipromoactionsubObj:GoodsAppl)
      102         or valid-object (ipromoactionsubObj:PromoSet)
      103         or valid-object (ipromoactionsubObj:CardsBin)
      104      then do :
      105         vStoragegoodsOBj = new promoGoodsStorage().
      106         if    valid-object (ipromoactionsubObj:GoodsCrits)
      107         then
      108             vStoragegoodsOBj:updateDBAll(ipromoactionsubObj:GoodsCrits,buf_promoaction.ID,buf_promoaction.Db-num).
      109         if valid-object (ipromoactionsubObj:GoodsAppl)
      110         then
      111             vStoragegoodsOBj:updateDBAll(ipromoactionsubObj:GoodsAppl,buf_promoaction.ID,buf_promoaction.Db-num).
      112         if valid-object (ipromoactionsubObj:PromoSet)
      113         then
      114             vStoragegoodsOBj:updateDBAll(ipromoactionsubObj:PromoSet,buf_promoaction.ID,buf_promoaction.Db-num).
      115         if valid-object (ipromoactionsubObj:CardsBin)
      116         then
      117             vStoragegoodsOBj:updateDBAll(ipromoactionsubObj:CardsBin,buf_promoaction.ID,buf_promoaction.Db-num).
      118      end.
      119      if valid-object(ipromoactionsubObj:Criterion)
      120       then do:
      121             vStorageCritOBj = new promoCriterionStorage().
      122             vStorageCritOBj:updateDBAll(ipromoactionsubObj:Criterion,buf_promoaction.ID,buf_promoaction.Db-num).
      123       end.
      124       if valid-object(ipromoactionsubObj:Gifts)
      125       then do:
      126             vStorageGiftOBj = new promoGiftStorage().
      127             vStorageGiftOBj:updateDBAll(ipromoactionsubObj:Gifts,buf_promoaction.ID,0,buf_promoaction.Db-num).
      128       end.
      129       if valid-object(ipromoactionsubObj:Objects)
      130       then do:
      131             vStorageObjectOBj = new promoObjectStorage().
      132             vStorageObjectOBj:updateDBAll(ipromoactionsubObj:Objects,buf_promoaction.ID,buf_promoaction.Db-num).
      133       end.
      134       return.
      135       finally:
      136             if valid-object(vStoragegoodsOBj ) then delete object vStoragegoodsOBj.
      137             if valid-object(vStorageCritOBj  ) then delete object vStorageCritOBj.
      138             if valid-object(vStorageGiftOBj  ) then delete object vStorageGiftOBj.
      139             if valid-object(vStorageObjectOBj) then delete object vStorageObjectOBj.
      140             if valid-object(vStorageschedObj ) then delete object vStorageschedObj.
      141             if valid-object(vStorageschedwObj) then delete object vStorageschedwObj.
      142         end finally.
      143     end.
      144     method public void deleteDB( input promoactionsubObj as promoactionsub  ):
      145       define buffer buf_promoaction for ub.promoaction.
      146       define variable vStoragegoodsOBj as class promoGoodsStorage.
      147       find first buf_promoaction where
      148         buf_promoaction.id     = promoactionsubObj:ID
      149         no-error.
      150       if not available (buf_promoaction)
      151       then do:
      152         exception(error-status, promoactionsubObj, buffer buf_promoaction:handle).
      153         return.
      154       end.
      155       delete buf_promoaction.
      156       return.
      157     end method.
      158     method public class promoactionsubs getpromoactionsubs ( ):
      159       define buffer buf_promoaction for ub.promoaction.
      160       define variable promoactionsubsObj as class promoactionsubs.
      161       promoactionsubsObj = new promoactionsubs ().
      162       for each buf_promoaction no-lock:
      163           promoactionsubsObj:AddItem(getDataStorage (buffer buf_promoaction)).
      164           // + set promosched-id
      165       end.
      166       return promoactionsubsObj.
      167     end method.
      168     method public class promoactionsubs getpromoactionsubs (input iDate as date,input istatus as integer  ):
      169       define buffer buf_promoaction for ub.promoaction.
      170       define variable hQuery   as handle  no-undo .
      171       define variable vStrWhere as character no-undo.
      172       define variable promoactionsubsObj as class promoactionsubs.
      173       promoactionsubsObj = new promoactionsubs ().
      174       if idate <> ?
      175       then
      176          vStrWhere = (if vStrWhere eq "" then "" else vStrWhere + " and ") + "buf_PromoAction.end-date >= " + string(idate).
      177       if istatus <> ?
      178       then
      179          vStrWhere = (if vStrWhere eq "" then "" else vStrWhere + " and ") + "buf_PromoAction.Status_ = "  + string(istatus).
      180       vStrWhere = (if vStrWhere eq "" then "" else " where " + vStrWhere).
      181       create query hQuery.
      182       hQuery:set-buffers(buffer buf_promoaction:HANDLE).
      183       hQuery:query-prepare("FOR EACH buf_promoaction " + vStrWhere).
      184       hQuery:query-open ().
      185       hQuery:get-first ().
      186       do while hQuery:query-off-end = false :
      187           promoactionsubsObj:AddItem(getDataStorage (buffer buf_promoaction)).
      188           hQuery:get-next().
      189       end.
      190       hQuery:query-close() .
      191       delete object hQuery.
      192       return promoactionsubsObj.
      193     end method.
      194     method public class promoactionsubs getpromoactionsubs (input iDb as integer ,input iId as int64  ):
      195         define variable promoactionsubsObj as class promoactionsubs no-undo.
      196         getpromoactionsubs (input-output promoactionsubsObj,idb, iid, ?).
      197         return promoactionsubsObj.
      198     end.
      199     method public void getpromoactionsubs (input-output ipromoactionsubsObj as promoactionsubs, input iDb as integer ,input iId as int64 ):
      200       getpromoactionsubs  (input-output ipromoactionsubsObj, input iDb, input iId, ? ).
      201     end.
      202     method public void getpromoactionsubs (input-output ipromoactionsubsObj as promoactionsubs, input iDb as integer ,input iId as int64, input objCode as integer  ):
      203       define buffer buf_promoaction for ub.promoaction.
      204       define variable hQuery   as handle  no-undo .
      205       define variable vStrWhere as character no-undo.
      206       if not valid-object(ipromoactionsubsObj)
      207       then
      208          ipromoactionsubsObj = new promoactionsubs ().
      209       vStrWhere = "buf_PromoAction.db-num eq " + string(iDb) + " and buf_PromoAction.id eq " + string(iId).
      210       vStrWhere = (if vStrWhere eq "" then "" else " where " + vStrWhere).
      211       create query hQuery.
      212       hQuery:set-buffers(buffer buf_promoaction:HANDLE).
      213       hQuery:query-prepare("FOR EACH buf_promoaction " + vStrWhere).
      214       hQuery:query-open ().
      215       hQuery:get-first ().
      216       do while hQuery:query-off-end = false :
      217           ipromoactionsubsObj:AddItem(getDataStorage (buffer buf_promoaction, objCode)).
      218           hQuery:get-next().
      219       end.
      220       hQuery:query-close() .
      221       delete object hQuery.
      222    end method.
      223      method public class promoactionsub CopyObject (input inpromoactionObj as class promoactionsub):
      224       define variable promoactionsubObj  as class promoactionsub.
      225       promoactionsubObj = new promoactionsub ().
      226       //promoactionsubObj = cast(inpromoactionObj:Clone(),promoactionsub).
      227       assign
      228            // id ставляем чтобы начита потомков с родителя
      229           promoactionsubObj:ID          = inpromoactionObj:ID
      230           promoactionsubObj:Mode        = 'с':U
      231           promoactionsubObj:status_          = 0
      232           promoactionsubObj:NameAction  = inpromoactionObj:NameAction
      233           promoactionsubObj:beg-date         = inpromoactionObj:beg-date
      234           promoactionsubObj:end-date        = inpromoactionObj:end-date
      235           promoactionsubObj:nameAction       = inpromoactionObj:nameAction
      236           promoactionsubObj:TypeDiscontEnum      = inpromoactionObj:TypeDiscontEnum
      237           promoactionsubObj:methodCalc       = inpromoactionObj:methodCalc
      238           promoactionsubObj:typecond         = inpromoactionObj:typecond
      239           promoactionsubObj:promosched-id    = inpromoactionObj:promosched-id
      240           promoactionsubObj:db-num           = inpromoactionObj:db-num // - заполнился при create
      241           promoactionsubObj:changeDate      = inpromoactionObj:changeDate
      242           promoactionsubObj:comment          = inpromoactionObj:comment
      243           promoactionsubObj:description      = inpromoactionObj:description
      244           promoactionsubObj:ext-code          = inpromoactionObj:ext-code
      245           promoactionsubObj:paymenttype      = inpromoactionObj:paymenttype
      246           promoactionsubObj:priority         = inpromoactionObj:priority
      247       .
      248       promoactionsubObj:refreshChildObj().
      249       promoactionsubObj:id = 0.
      250       return promoactionsubObj.
      251       end.
      252     method private void setDataStorage (input inpromoactionObj as class promoactionsub, buffer inbf_promoaction for ub.promoaction ):
      253       assign
      254           inbf_promoaction.beg-date         = inpromoactionObj:beg-date
      255           inbf_promoaction.end-date         = inpromoactionObj:end-date
      256           inbf_promoaction.nameAction       = inpromoactionObj:nameAction
      257           inbf_promoaction.TypeDiscont      = inpromoactionObj:TypeDiscontEnum:GetValue()
      258           inbf_promoaction.methodCalc       = inpromoactionObj:methodCalc
      259           inbf_promoaction.typecond         = inpromoactionObj:typecond
      260           inbf_promoaction.promosched-id    = inpromoactionObj:promosched-id
      261   //        inbf_promoaction.db-num           = inpromoactionObj:db-num - заполнился при create
      262           inbf_promoaction.changeDate       = inpromoactionObj:changeDate
      263           inbf_promoaction.comment          = inpromoactionObj:comment
      264           inbf_promoaction.description      = inpromoactionObj:description
      265           inbf_promoaction.ext-code         = inpromoactionObj:ext-code
      266           inbf_promoaction.paymenttype      = inpromoactionObj:paymenttype
      267           inbf_promoaction.priority         = inpromoactionObj:priority
      268           inbf_promoaction.status_          = inpromoactionObj:status_Enum:GetValue()
      269       .
      270       validate inbf_promoaction.
      271       end.
      272     method private class promoactionsub getDataStorage ( buffer inbf_promoaction for ub.promoaction ):
      273       return getDataStorage(buffer inbf_promoaction, ?).
      274     end.
      275     method private class promoactionsub getDataStorage ( buffer inbf_promoaction for ub.promoaction, input objCode as integer):
      276       define variable promoactionsubObj  as class promoactionsub.
      277       promoactionsubObj = new promoactionsub ().
      278       return getDataStorage(promoactionsubObj,buffer inbf_promoaction, objCode).
      279     end.
      280     method private class promoactionsub getDataStorage (input inpromoactionSubObj as class promoactionsub, buffer inbf_promoaction for ub.promoaction):
      281       return getDataStorage(inpromoactionSubObj,buffer inbf_promoaction, ?).
      282     end.
      283     method private class promoactionsub getDataStorage (input inpromoactionSubObj as class promoactionsub, buffer inbf_promoaction for ub.promoaction, input objCode as integer):
      284       assign
      285         inpromoactionSubObj:ID            = inbf_promoaction.id
      286         inpromoactionSubObj:beg-date      = inbf_promoaction.beg-date
      287         inpromoactionSubObj:end-date      = inbf_promoaction.end-date
      288         inpromoactionSubObj:nameAction    = inbf_promoaction.nameAction
      289         inpromoactionSubObj:TypeDiscont   = inbf_promoaction.TypeDiscont
      290         inpromoactionSubObj:methodCalc    = inbf_promoaction.methodCalc
      291         inpromoactionSubObj:typecond      = inbf_promoaction.typecond
      292         inpromoactionSubObj:promosched-id = inbf_promoaction.promosched-id // заполняется автоматом в .Schedule:set()
      293         inpromoactionSubObj:db-num        = inbf_promoaction.db-num
      294         inpromoactionSubObj:changeDate    = inbf_promoaction.changeDate
      295         inpromoactionSubObj:comment       = inbf_promoaction.comment
      296         inpromoactionSubObj:description   = inbf_promoaction.description
      297         inpromoactionSubObj:ext-code      = inbf_promoaction.ext-code
      298         inpromoactionSubObj:paymenttype   = inbf_promoaction.paymenttype
      299         inpromoactionSubObj:priority      = inbf_promoaction.priority
      300         inpromoactionSubObj:status_       = inbf_promoaction.status_
      301         inpromoactionSubObj:objCode       = objCode
      302       .
      303       return inpromoactionSubObj.
      304     end.
      305     method public void refreshObj (inpromoactionSubObj as class promoactionsub):
      306       refreshObj(inpromoactionSubObj, ?).
      307     end.
      308     method public void refreshObj (inpromoactionSubObj as class promoactionsub, input objCode as integer):
      309       define buffer buf_promoaction for ub.promoaction.
      310       if not valid-object (inpromoactionSubObj)
      311       then do:
      312         Msg = "Объект типа promoactionsub не существует".
      313         return.
      314       end.
      315       find first buf_promoaction no-lock where buf_promoaction.ID = inpromoactionSubObj:ID no-error.
      316       if not available (buf_promoaction)
      317       then do:
      318         Msg = "Не найден Акция - " + string (inpromoactionSubObj:ID) .
      319         return.
      320       end.
      321       define variable v-sub as class promoactionsub no-undo .
      322       getDataStorage (inpromoactionSubObj,buffer buf_promoaction, objCode).
      323     end.
      324     method public void CleanChildObj (inpromoactionSubObj as class promoactionsub):
      325       if inpromoactionSubObj:TypeDiscontEnum eq ibs.th.ref.promo.enum-type-discount:envisa
      326       then
      327          this-object:CleanChildObj(inpromoactionSubObj, yes, yes, yes, no, yes, no).
      328       else do:
      329          case inpromoactionSubObj:methodCalc:
      330          when 1 then do: //"Скидка процентом"
      331             if  inpromoactionSubObj:TypeDiscontEnum eq ibs.th.ref.promo.enum-type-discount:ensolo then // временная
      332             do:
      333                if inpromoactionSubObj:typecond = 1 // "Количество по строке"
      334                then
      335                   this-object:CleanChildObj(inpromoactionSubObj, no, not inpromoactionSubObj:CritgoodsFl, yes, no, no, yes).
      336                else if inpromoactionSubObj:typecond = 2 // "Сумма по строке"
      337                then
      338                   this-object:CleanChildObj(inpromoactionSubObj, no, not inpromoactionSubObj:CritgoodsFl, yes, no, no, yes).
      339                else if inpromoactionSubObj:typecond = 3 // "Итог чека"
      340                then
      341                   this-object:CleanChildObj(inpromoactionSubObj, yes, yes, yes, no, no, yes).
      342                else if inpromoactionSubObj:typecond = 4 // "Штрих код"
      343                then
      344                   this-object:CleanChildObj(inpromoactionSubObj, no, yes, no, no, no, yes).
      345             end.
      346             else
      347                this-object:CleanChildObj(inpromoactionSubObj, yes, yes, no, yes, no, yes).
      348             end .
      349             when 2 then do: // абсолютная
      350                  this-object:CleanChildObj(inpromoactionSubObj, no, not inpromoactionSubObj:CritgoodsFl, yes, no, no, yes).
      351                  if inpromoactionSubObj:typecond = 4
      352                  then this-object:CleanChildObj(inpromoactionSubObj, no, no, no, no, no, yes).
      353             end.
      354             when 3 then do: // Скидка количеством
      355                this-object:CleanChildObj(inpromoactionSubObj, no, yes, yes, no, yes, yes).
      356             end .
      357             when 4 then do: //Скидка процентом за количество
      358                this-object:CleanChildObj(inpromoactionSubObj, no, no, no, no, no, yes).
      359             end .
      360             when 5 then do: // Фиксированная цена
      361                if inpromoactionSubObj:TypeDiscontEnum eq ibs.th.ref.promo.enum-type-discount:ensolo
      362                then
      363                   this-object:CleanChildObj(inpromoactionSubObj, no, yes, yes, yes, no, yes).
      364                else
      365                   this-object:CleanChildObj(inpromoactionSubObj, yes, yes, no, no, yes, yes).
      366                if inpromoactionSubObj:typecond = 4
      367                  then this-object:CleanChildObj(inpromoactionSubObj, no, no, no, no, no, yes).
      368             end .
      369             when 6 then do:
      370                if    inpromoactionSubObj:typecond = 1 // "Количество по строке"
      371                   or inpromoactionSubObj:typecond = 2 // "Сумма по строке"
      372                then
      373                   this-object:CleanChildObj(inpromoactionSubObj, yes, not inpromoactionSubObj:CritgoodsFl, yes, no, yes, yes).
      374                else if inpromoactionSubObj:typecond = 3 // "Итог чека"
      375                then
      376                   this-object:CleanChildObj(inpromoactionSubObj, yes, yes, yes, no, yes, yes).
      377             end .
      378             when 7 then do:
      379                if inpromoactionSubObj:typecond = 1 // "Количество по строке"
      380                then
      381                   this-object:CleanChildObj(inpromoactionSubObj, no, yes, yes, no, no, yes).
      382                else if inpromoactionSubObj:typecond = 2 // "Сумма по строке"
      383                then
      384                   this-object:CleanChildObj(inpromoactionSubObj, no, yes, yes, no, no, yes).
      385                else if inpromoactionSubObj:typecond = 3 // "Итог чека"
      386                then
      387                   this-object:CleanChildObj(inpromoactionSubObj, yes, yes, yes, no, no, yes).
      388             end.
      389          end case.
      390       end.
      391     end.
      392     method public void CleanChildObj (inpromoactionSubObj as class promoactionsub,
      393     input iCleanGoodsAppl as logical,
      394     input iCleanGoodsCrit as logical,
      395     input iCleanPromoSet  as logical,
      396     input iCleanCriterion  as logical,
      397     input iCleanCriterionNotOne  as logical,
      398     input iCleanPromoCardsBin as logical
      399     ):
      400       define variable vGoods as class  promogoodssubs no-undo.
      401       define variable vGood  as class  promogoodssub no-undo.
      402       define variable vCriterions as class  promoCriterionsubs no-undo.
      403       define variable vCriterion  as class  promoCriterionsub no-undo.
      404       define variable vCriterionOne  as class  promoCriterionsub no-undo.
      405       define variable vI as integer no-undo.
      406       define variable vcount as integer no-undo.
      407       if iCleanGoodsAppl
      408       then do:
      409         vGoods = inpromoactionSubObj:GoodsAppl.
      410         vcount = vGoods:GetItem(1).
      411         do vi = vcount   to 1 by -1 :
      412           vGoods:GetItem(vi).
      413           vGood = vGoods:promoGoodsObjCurr.
      414           if vGood:Mode eq 'с':U
      415           then
      416              vGoods:DeleteItem(vi).
      417           else
      418              vGood:Mode = 'у':U.
      419         end.
      420       end.
      421       if iCleanGoodsCrit
      422       then do:
      423         vGoods = inpromoactionSubObj:GoodsCrits.
      424         do vi =  vGoods:GetItem(vi)  to 1 by -1 :
      425           vGoods:GetItem(vi).
      426           vGood = vGoods:promoGoodsObjCurr.
      427           if vGood:Mode eq 'с':U
      428           then
      429              vGoods:DeleteItem(vi).
      430           else
      431              vGood:Mode = 'у':U.
      432         end.
      433       end.
      434       if iCleanPromoSet
      435       then do:
      436         vGoods = inpromoactionSubObj:PromoSet.
      437         do vi =  vGoods:GetItem(vi)  to 1 by -1 :
      438           vGoods:GetItem(vi).
      439           vGood = vGoods:promoGoodsObjCurr.
      440           if vGood:Mode eq 'с':U
      441           then
      442              vGoods:DeleteItem(vi).
      443           else
      444              vGood:Mode = 'у':U.
      445         end.
      446       end.
      447       if iCleanCriterion
      448       then do:
      449         vCriterions = inpromoactionSubObj:Criterion.
      450         do vi =  vCriterions:GetItem(vi)  to 1 by -1 :
      451           vCriterions:GetItem(vi).
      452           vCriterion = vCriterions:promoCriterionObjCurr.
      453           if vCriterion:Mode eq 'с':U
      454           then
      455              vCriterions:DeleteItem(vi).
      456           else
      457              vCriterion:Mode = 'у':U.
      458         end.
      459       end.
      460       if iCleanCriterionNotOne
      461       then do:
      462         vCriterions = inpromoactionSubObj:Criterion.
      463         block-critOne:
      464         do vi =  1 to vCriterions:GetItem(vi)   :
      465           vCriterion = vCriterions:promoCriterionObjCurr.
      466           if vCriterion:Mode ne  'у':U
      467           then do:
      468              vCriterionone = vCriterion.
      469              leave block-critOne.
      470           end.
      471         end.
      472         do vi =  vCriterions:GetItem(vi)  to 1 by -1 :
      473           vCriterions:GetItem(vi).
      474           vCriterion = vCriterions:promoCriterionObjCurr.
      475           if vCriterionone ne vCriterion
      476           then do:
      477             if vCriterion:Mode eq 'с':U
      478             then
      479                vCriterions:DeleteItem(vi).
      480             else
      481                vCriterion:Mode = 'у':U.
      482           end.
      483         end.
      484       end.
      485       if iCleanPromoCardsBin
      486       then do:
      487         vGoods = inpromoactionSubObj:CardsBin.
      488         do vi =  vGoods:GetItem(vi)  to 1 by -1 :
      489           vGoods:GetItem(vi).
      490           vGood = vGoods:promoGoodsObjCurr.
      491           if vGood:Mode eq 'с':U
      492           then
      493              vGoods:DeleteItem(vi).
      494           else
      495              vGood:Mode = 'у':U.
      496         end.
      497       end.
      498     end.
      499   end class.
