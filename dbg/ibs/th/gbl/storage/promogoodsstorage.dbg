        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.ref.promo.*.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.storage.promogoodsstorage:
        7     define variable vss-revision    as character no-undo initial "$Revision: e455fc319afd, 3602, rls $":U .
        8     define variable vss-author      as character no-undo initial "$Author: ARostovtsev $":U .
        9     define variable vss-date        as character no-undo initial "$Date: 2023/12/28 12:56:37 $":U .
       10     define variable vss-workfile    as character no-undo initial "$Workfile: promogoodsstorage.cls $":U .
       11     define variable vss-archive     as character no-undo initial "$Archive: ibs/th/gbl/storage/promogoodsstorage.cls $":U .
       12     define variable vss-description as character no-undo initial "Storage Goods Action".
       13     define property Msg as character
       14       get.
       15       private set.
       16     method private void exception( arg as handle, inPromoGoodsObj as class promoGoodssub, t-h as handle ):
       17       inpromoGoodsObj:setMsg(arg:get-message (1)).
       18       inpromoGoodsObj:setStatusErr(arg:error).
       19       t-h:buffer-delete () no-error.
       20       return.
       21     end method.
       22     method private void exception( arg as char ):
       23       Msg = arg.
       24       return.
       25     end method.
       26     method public void updateDBAll( input promoGoodssubsObj as promoGoodssubs ):
       27       updateDBAll (promoGoodssubsObj,?,?,?).
       28     end.
       29     method public void updateDBAll( input promoGoodssubsObj as promoGoodssubs ,input iIdAction as int64, input idb-num as integer  ):
       30       updateDBAll (promoGoodssubsObj,iIdAction,?,idb-num).
       31     end.
       32     method public void updateDBAll( input promoGoodssubsObj as promoGoodssubs ,input iIdAction as int64,input iIdSet as int64, input idb-num as integer  ):
       33       define variable v-sub as promoGoodssub no-undo .
       34       define variable vi    as int           no-undo.
       35       do vi =  1 to promoGoodssubsObj:GetItem(vi):
       36         v-sub = promoGoodssubsObj:promoGoodsObjCurr .
       37         assign
       38           v-sub:idAction = promoGoodssubsObj:IdAction
       39           when promoGoodssubsObj:IdAction > 0
       40           v-sub:idSet    = promoGoodssubsObj:IdSet
       41           when promoGoodssubsObj:IdSet    > 0
       42           v-sub:db-num   = promoGoodssubsObj:db-num
       43           when promoGoodssubsObj:db-num   ne ?
       44           v-sub:type     = promoGoodssubsObj:type
       45           when promoGoodssubsObj:type     > 0
       46           v-sub:idAction = iIdAction
       47           when iIdAction > 0
       48           v-sub:idSet    = iIdSet
       49           when iIdSet    > 0
       50           v-sub:db-num   = idb-num
       51           when idb-num   ne ?
       52           .
       53         case v-sub:Mode :
       54           when 'с':U then
       55             insertDB(v-sub).
       56           when 'и':U then
       57             updateDB(v-sub).
       58           when 'у':U then
       59             deleteDB(v-sub).
       60           otherwise .
       61         end case .
       62         if valid-object(v-sub:promoSetGoods)
       63           then
       64           updateDBAll(v-sub:promoSetGoods,iIdAction,v-sub:ID,idb-num).
       65       end.
       66     end.
       67     method public void insertDB( input promoGoodssubObj as promoGoodssub  ):
       68       define buffer buf_promogoods for ub.promogoods.
       69       define buffer buf_promoAttr  for ub.PromoAttr .
       70       if promoGoodssubObj:db-num eq ? then
       71         undo, throw new Progress.Lang.AppError(
       72           substitute("отсутствует db-num в классе с кодом товара &1", promoGoodssubObj:GdsCode)
       73           ) .
       74       create buf_promoGoods.
       75       assign
       76         buf_promoGoods.id     = next-value (s-promoGoods-id, ub)
       77         buf_promoGoods.db-num = promoGoodssubObj:db-num
       78         promoGoodssubObj:ID   = buf_promoGoods.id
       79       no-error.
       80       if error-status:error
       81         then
       82       do:
       83         exception(error-status, promoGoodssubObj, buffer buf_promoGoods:handle).
       84         return.
       85       end.
       86       setDataStorage(input promoGoodssubObj, buffer buf_promoGoods).
       87       for each buf_promoAttr exclusive-lock where buf_promoAttr.attr-code = "bc-code" and
       88         buf_promoAttr.tablename = "PromoGoods" and
       89         promoGoodssubObj:idAction = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and
       90         promoGoodssubObj:db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) and
       91         promoGoodssubObj:GdsCode = integer(entry(3,buf_PromoAttr.p-key,chr(3))):
       92         delete buf_promoAttr .
       93       end.
       94           if promoGoodssubObj:promotion-code <> ? then
       95       dO:
       96         create buf_promoAttr .
       97         assign
       98           buf_promoAttr.tablename = "PromoGoods"
       99           buf_promoAttr.attr-code = "bc-code"
      100           buf_promoAttr.p-key     = string(promoGoodssubObj:idAction) + chr(3) +
      101                             string(promoGoodssubObj:db-num) + chr(3) +
      102                             string(promoGoodssubObj:GdsCode)
      103           .
      104         buf_promoAttr.attr-value = promoGoodssubObj:promotion-code .
      105       end.
      106       return.
      107     end method.
      108     method public void updateDB( input promoGoodssubObj as promoGoodssub  ):
      109       define buffer buf_promogoods for ub.promogoods.
      110       define buffer buf_promoAttr  for ub.PromoAttr .
      111       find first buf_promoGoods where
      112         buf_promoGoods.id     = promoGoodssubObj:ID
      113         no-error.
      114       if not available (buf_promoGoods)
      115         then
      116       do:
      117         exception(error-status, promoGoodssubObj, buffer buf_promoGoods:handle).
      118         return.
      119       end.
      120       setDataStorage(input promoGoodssubObj, buffer buf_promoGoods).
      121       for each buf_promoAttr exclusive-lock where buf_promoAttr.attr-code = "bc-code" and
      122         buf_promoAttr.tablename = "PromoGoods" and
      123         promoGoodssubObj:idAction = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and
      124         promoGoodssubObj:db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) and
      125         promoGoodssubObj:GdsCode = integer(entry(3,buf_PromoAttr.p-key,chr(3))):
      126         delete buf_promoAttr .
      127       end.
      128       if promoGoodssubObj:promotion-code <> ? then
      129       do:
      130         create buf_promoAttr .
      131         assign
      132           buf_promoAttr.tablename = "PromoGoods"
      133           buf_promoAttr.attr-code = "bc-code"
      134           buf_promoAttr.p-key     = string(promoGoodssubObj:idAction) + chr(3) +
      135                             string(promoGoodssubObj:db-num) + chr(3) +
      136                             string(promoGoodssubObj:GdsCode)
      137           .
      138         buf_promoAttr.attr-value = promoGoodssubObj:promotion-code .
      139       end.
      140       return.
      141     end method.
      142     method public void deleteDB( input promoGoodssubObj as promoGoodssub  ):
      143       define buffer buf_promogoods for ub.promogoods.
      144       define buffer buf_promoAttr  for ub.PromoAttr .
      145       find first buf_promoGoods where
      146         buf_promoGoods.id     = promoGoodssubObj:ID
      147         no-error.
      148       if not available (buf_promoGoods)
      149         then
      150       do:
      151         exception(error-status, promoGoodssubObj, buffer buf_promoGoods:handle).
      152         return.
      153       end.
      154       delete buf_promoGoods.
      155       for first buf_promoAttr exclusive-lock where buf_promoAttr.attr-code = "bc-code" and
      156         buf_promoAttr.tablename = "PromoGoods" and
      157         promoGoodssubObj:idAction = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and
      158         promoGoodssubObj:db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) and
      159         promoGoodssubObj:GdsCode = integer(entry(3,buf_PromoAttr.p-key,chr(3))):
      160         delete buf_promoAttr .
      161       end.
      162       return.
      163     end method.
      164     method public class promoGoodssubs getpromoGoodssubs (input idaction as int64,
      165       input iTYPE as ibs.th.ref.promo.enum-promo-goods-type,
      166       input idb-num as integer ):
      167       return getpromoGoodssubs(idaction, iTYPE, idb-num, ?).
      168     end method.
      169     method public class promoGoodssubs getpromoGoodssubs (input idaction as int64,
      170       input iTYPE as ibs.th.ref.promo.enum-promo-goods-type,
      171       input idb-num as integer,
      172       input iobj-code as integer ):
      173       define buffer buf_promogoods for ub.promogoods.
      174       define variable promoGoodssubsObj as class   promoGoodssubs.
      175       define variable vType             as integer no-undo.
      176       vType = iTYPE:getvalue().
      177       promoGoodssubsObj = new promoGoodssubs ().
      178       assign
      179         promoGoodssubsObj:idaction = idaction
      180         promoGoodssubsObj:type     = vtype
      181         promoGoodssubsObj:db-num   = idb-num
      182         .
      183       if idaction > 0
      184         then
      185         for each buf_promoGoods   where buf_promoGoods.idaction eq idaction
      186           and buf_promoGoods.idSet    eq 0
      187           and buf_promoGoods.type     eq vType
      188           and buf_promoGoods.db-num   eq idb-num
      189           no-lock:
      190           promoGoodssubsObj:AddItem(getDataStorage (buffer buf_promoGoods, iobj-code)).
      191         end.
      192       return promoGoodssubsObj.
      193     end method.
      194     method public class promoGoodssubs getpromoGoodssubs (input idaction as int64,
      195       input iIdSet    as int64,
      196       input iTYPE    as ibs.th.ref.promo.enum-promo-goods-type,
      197       input idb-num  as integer,
      198       input iobj-code as integer ):
      199       define buffer buf_promogoods for ub.promogoods.
      200       define variable promoGoodssubsObj as class   promoGoodssubs.
      201       define variable vType             as integer no-undo.
      202       vType = iTYPE:getvalue().
      203       promoGoodssubsObj = new promoGoodssubs ().
      204       assign
      205         promoGoodssubsObj:idaction = idaction
      206         promoGoodssubsObj:type     = vtype
      207         promoGoodssubsObj:db-num   = idb-num
      208         promoGoodssubsObj:IdSet    = iIdSet
      209         .
      210       if     idaction > 0
      211         and iIdSet   > 0
      212         then
      213         for each buf_promoGoods   where buf_promoGoods.idaction eq idaction
      214           and buf_promoGoods.idSet     eq iIdSet
      215           and buf_promoGoods.type     eq vtype
      216           and buf_promoGoods.db-num  eq idb-num
      217           no-lock:
      218           promoGoodssubsObj:AddItem(getDataStorage (buffer buf_promoGoods, iobj-code)).
      219         end.
      220       return promoGoodssubsObj.
      221     end method.
      222     method private void setDataStorage (input inpromoGoodsObj as class promoGoodssub, buffer inbf_promoGoods for ub.promoGoods ):
      223       assign
      224         inbf_promoGoods.type     = inpromoGoodsObj:type
      225         inbf_promoGoods.idAction = inpromoGoodsObj:idAction
      226         inbf_promoGoods.Gds-Code = inpromoGoodsObj:GdsCode
      227         inbf_promoGoods.db-num   = inpromoGoodsObj:db-num
      228         inbf_promoGoods.idSet    = inpromoGoodsObj:idSet
      229         inbf_promoGoods.price    = inpromoGoodsObj:price
      230         inbf_promoGoods.qnty     = inpromoGoodsObj:qnty
      231         inbf_promoGoods.NameSet  = inpromoGoodsObj:NameSet
      232         .
      233       validate inbf_promoGoods.
      234     end.
      235     method private class promoGoodssub getDataStorage ( buffer inbf_promoGoods for ub.promoGoods):
      236       return getDataStorage(buffer inbf_promoGoods, ?).
      237     end.
      238     method private class promoGoodssub getDataStorage ( buffer inbf_promoGoods for ub.promoGoods, objCode as integer ):
      239       define variable promoGoodssubObj as class promoGoodssub.
      240       promoGoodssubObj = new promoGoodssub ().
      241       return getDataStorage(promoGoodssubObj,buffer inbf_promoGoods, objCode).
      242     end.
      243     method private class promoGoodssub getDataStorage (inpromoGoodsSubObj as class promoGoodssub, buffer inbf_promoGoods for ub.promoGoods):
      244       return getDataStorage (inpromoGoodsSubObj, buffer inbf_promoGoods, ?).
      245     end.
      246     method private class promoGoodssub getDataStorage (inpromoGoodsSubObj as class promoGoodssub, buffer inbf_promoGoods for ub.promoGoods, objCode as integer ):
      247       assign
      248         inpromoGoodsSubObj:ID       = inbf_promoGoods.id
      249         inpromoGoodsSubObj:type     = inbf_promoGoods.type
      250         inpromoGoodsSubObj:idAction = inbf_promoGoods.idAction
      251         inpromoGoodsSubObj:GdsCode  = inbf_promoGoods.Gds-Code
      252         inpromoGoodsSubObj:db-num   = inbf_promoGoods.db-num
      253         inpromoGoodsSubObj:idSet    = inbf_promoGoods.idSet
      254         inpromoGoodsSubObj:price    = inbf_promoGoods.price
      255         inpromoGoodsSubObj:qnty     = inbf_promoGoods.qnty
      256         inpromoGoodsSubObj:NameSet  = inbf_promoGoods.NameSet
      257         inpromoGoodsSubObj:objCode  = objCode
      258         .
      259       return inpromoGoodsSubObj.
      260     end.
      261     method public void refreshObj (inpromoGoodsSubObj as class promoGoodssub):
      262       define buffer buf_promoGoods for ub.promoGoods.
      263       if not valid-object (inpromoGoodsSubObj)
      264         then
      265       do:
      266         Msg = "Объект типа promoGoodssub не существует".
      267         return.
      268       end.
      269       find first buf_promoGoods no-lock where buf_promoGoods.ID = inpromoGoodsSubObj:ID no-error.
      270       if not available (buf_promoGoods)
      271         then
      272       do:
      273         Msg = "Не найден Товар - " + string (inpromoGoodsSubObj:ID).
      274         return.
      275       end.
      276       getDataStorage (inpromoGoodsSubObj,buffer buf_promoGoods).
      277     end.
      278   end class.
