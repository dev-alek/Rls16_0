        1   using Progress.Lang.*.
        2   using ibs.th.gbl.storage.*.
        3   using ibs.th.ref.*.
        4   block-level on error undo, throw.
        5   class ibs.th.gbl.storage.normwast:
        6     define temp-table tt-docperiod no-undo
        7       field dateBeg as date
        8       field dateEnd as date
        9       field fact-qnty-kg as decimal
       10       index pi dateBeg
       11     .
       12     method public void RegDoc (d as date, chg-fact-qnty-kg as decimal):
       13       def buffer bf_tt-docp for tt-docperiod.
       14      find first tt-docperiod where tt-docperiod.dateBeg = d + 1 use-index pi no-error.
       15       if available (tt-docperiod)
       16       then do:
       17         tt-docperiod.fact-qnty-kg = tt-docperiod.fact-qnty-kg + chg-fact-qnty-kg.
       18         return.
       19       end.
       20       find first tt-docperiod where tt-docperiod.dateBeg = d use-index pi no-error.
       21       if available (tt-docperiod)
       22       then do:
       23         tt-docperiod.dateBeg = tt-docperiod.dateBeg + 1.
       24         tt-docperiod.fact-qnty-kg = tt-docperiod.fact-qnty-kg + chg-fact-qnty-kg.
       25         return.
       26       end.
       27       find first tt-docperiod where tt-docperiod.dateEnd = d use-index pi no-error.
       28       if available (tt-docperiod)
       29       then do:
       30         tt-docperiod.dateBeg = tt-docperiod.dateEnd - 1.
       31         tt-docperiod.fact-qnty-kg = tt-docperiod.fact-qnty-kg + chg-fact-qnty-kg.
       32         return.
       33       end.
       34       find last bf_tt-docp where bf_tt-docp.dateBeg < d and bf_tt-docp.dateEnd > d use-index pi no-error.
       35       if not available (bf_tt-docp)
       36       then do:
       37         message "Документ не зарегистрирован. Дата - " d view-as alert-box.
       38         return.
       39       end.
       40       create tt-docperiod.
       41       tt-docperiod.dateBeg = d + 1.
       42       tt-docperiod.dateEnd = bf_tt-docp.dateEnd.
       43       bf_tt-docp.dateEnd = d.
       44       tt-docperiod.fact-qnty-kg = bf_tt-docp.fact-qnty-kg + chg-fact-qnty-kg.
       45       finally:
       46         release tt-docperiod.
       47         output to 123 append.
       48         put "-------" skip.
       49         for each tt-docperiod:
       50           export tt-docperiod.
       51         end.
       52         output close.
       53       end.
       54     end.
       55     method public void RegDocPeriod (d1 as date, d2 as date, fact-qnty-kg as decimal):
       56       empty temp-table tt-docperiod.
       57       create tt-docperiod.
       58       tt-docperiod.dateBeg = d1.
       59       tt-docperiod.dateEnd = d2.
       60       tt-docperiod.fact-qnty-kg = fact-qnty-kg.
       61     end.
       62     method public void CalcWastNorm (objNormWastSub as class normwastsub):
       63       output to decommissioned.txt append.
       64       put now skip.
       65       put "-------" skip.
       66       export "Товар - " objNormWastSub:ParGdsOAttr:GdsCode ". Место хранения - " objNormWastSub:ParGdsOAttr:PlCode.
       67       for each tt-docperiod use-index pi:
       68         CaclQDaysSeason (objNormWastSub, tt-docperiod.dateBeg, tt-docperiod.dateEnd, tt-docperiod.fact-qnty-kg).
       69         export tt-docperiod.
       70       end.
       71       put "-------" skip.
       72       output close.
       73     end.
       74     method private void CaclQDaysSeason(objNormWastSub as class normwastsub, d1 as date, d2 as date, fact-qnty-kg as decimal):
       75       def var yy1 as int  no-undo.
       76       def var yy2 as int  no-undo.
       77       def var daySummer   as int no-undo.
       78       def var monthSummer as int no-undo.
       79       def var dayWinter   as int no-undo.
       80       def var monthWinter as int no-undo.
       81       def var ii  as int  no-undo.
       82       yy1 = year (d1).
       83       yy2 = year (d2).
       84       daySummer = day (objNormWastSub:BeginSummer).
       85       monthSummer = month (objNormWastSub:BeginSummer).
       86       dayWinter = day (objNormWastSub:BeginSummer).
       87       monthWinter = month (objNormWastSub:BeginWinter).
       88       if yy1 - yy2 > 0
       89       then do:
       90         CaclQDaysSeasonByYear
       91           (
       92             d1, date (12, 31, yy1),
       93             date (monthSummer, daySummer, yy1), date (monthWinter, dayWinter, yy2)
       94             , objNormWastSub
       95             , fact-qnty-kg
       96           ).
       97         CaclQDaysSeasonByYear
       98           (
       99             date (01, 01, yy1), d2,
      100             date (monthSummer, daySummer, yy1), date (monthWinter, dayWinter, yy2)
      101             , objNormWastSub
      102             , fact-qnty-kg
      103           ).
      104         do ii = yy1 + 1 to yy2 - 1:
      105           CaclQDaysSeasonByYear
      106             (
      107               date (01, 01, yy1), date (12, 31, yy1),
      108               date (monthSummer, daySummer, yy1), date (monthWinter, dayWinter, yy2)
      109             , objNormWastSub
      110             , fact-qnty-kg
      111             ).
      112         end.
      113       end.
      114       else do:
      115         CaclQDaysSeasonByYear
      116           (
      117             d1, d2,
      118             date (monthSummer, daySummer, yy1), date (monthWinter, dayWinter, yy2)
      119             , objNormWastSub
      120             , fact-qnty-kg
      121           ).
      122       end.
      123     end.
      124     method private void CaclQDaysSeasonByYear
      125       ( d1 as date, d2 as date , p1 as date, p2 as date, objNormWastSub as class normwastsub, fact-qnty-kg as decimal)
      126     :
      127       def var sqdays      as int init 0 no-undo.
      128       def var wqdays      as int init 0 no-undo.
      129       def var wqdays1 as int no-undo.
      130       def var wqdays2 as int no-undo.
      131       sqdays = (min (p2,d2) - max (p1,d1)) + 1.
      132       if sqdays < 0
      133       then do:
      134         wqdays = (d2 - d1) .
      135         sqdays = 0.
      136       end.
      137       else do:
      138         wqdays1 = d2 - p2.
      139         wqdays2 = p1 - d1.
      140         wqdays = max (0,wqdays1) + max (0,wqdays2) .
      141       end.
      142       export "Qnty kg " fact-qnty-kg "Qnty Day Summer " sqdays "EUH Norm Summer " objNormWastSub:NormalWastageSummer " EUH Summer " ((fact-qnty-kg * objNormWastSub:NormalWastageSummer) * sqdays / 30000).
      143       export "Qnty kg " fact-qnty-kg "Qnty Day Winter " wqdays "EUH Norm Winter " objNormWastSub:NormalWastageWinter "EUH Winter " ((fact-qnty-kg * objNormWastSub:NormalWastageWinter) * wqdays / 30000).
      144       assign
      145         objNormWastSub:NormWastS = objNormWastSub:NormWastS + (fact-qnty-kg * objNormWastSub:NormalWastageSummer) * sqdays / 30000
      146         objNormWastSub:NormWastW = objNormWastSub:NormWastW + (fact-qnty-kg * objNormWastSub:NormalWastageWinter) * wqdays / 30000
      147       .
      148     end.
      149   end class.
