        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.map.*.
        4   using ibs.th.gbl.env.conf.markingtypegbl.
        5   block-level on error undo, throw.
        6   class ibs.th.gbl.sys.SystemAux inherits objth:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Класс для хранения вспомогательных классов системы" get.
       13      define property MapStringGbl as class mapstringgbl no-undo
       14       get.
       15       private set.
       16      define property MarkingTypeGbl as class MarkingTypeGbl no-undo
       17       get.
       18       private set.
       19      define property ParamColectionGbl as class ParamColectionGbl no-undo
       20       get.
       21       private set.
       22      constructor public SystemAux (  ):
       23         super ().
       24   MapStringGbl = new MapStringGbl ().
       25   ObjSrv:Regobj(this-object,MapStringGbl,
       26   "MapStringGbl"
       27   ) .
       28   MarkingTypeGbl = new MarkingTypeGbl ().
       29   ObjSrv:Regobj(this-object,MarkingTypeGbl,
       30   "MarkingTypeGbl"
       31   ) .
       32   ParamColectionGbl = new ParamColectionGbl ().
       33   ObjSrv:Regobj(this-object,ParamColectionGbl,
       34   "ParamColectionGbl"
       35   ) .
       36      end constructor.
       37   end class.
