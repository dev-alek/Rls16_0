        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objsrv.
        3   using ibs.th.gbl.sys.objth.
        4   using ibs.th.gbl.env.
        5   using ibs.th.gbl.logger.
        6   using ibs.th.gbl.logger.putout.
        7   using ibs.th.gbl.sys.env.ini.
        8   using ibs.th.gbl.lib.
        9   using ibs.th.gbl.systemsetting.
       10   using ibs.th.gbl.sys.SystemAux.
       11   block-level on error undo, throw.
       12   class ibs.th.gbl.sys.objsrv:
       13         define temp-table tt-objth no-undo
       14       field iNum       as integer
       15       field objhndl    as class Progress.Lang.Object
       16       field propname   as character
       17       field label_     as character
       18       field objname    as character
       19       field objparent  as character
       20       field procparent as character
       21   index pparent objparent propname
       22   index objname objname
       23   .
       24     define public property upd as integer no-undo
       25       get.
       26       private set.
       27     define public property Env as class env no-undo
       28       get.
       29       private set.
       30     define public property Lib as class lib no-undo
       31       get.
       32       private set.
       33     define public property SystemSetting as class systemsetting no-undo
       34       get.
       35       private set.
       36     define public property SysLog as class logger no-undo
       37       get.
       38       private set.
       39     define private variable out as class putout no-undo.
       40     define property SysINI as class ini no-undo
       41       get.
       42       private set.
       43     define property SystemAux as class systemaux no-undo
       44       get.
       45       private set.
       46     constructor public objsrv (  ):
       47       super ().
       48       SysLog = new logger (out).
       49       SysLog:EventHndlr("Родился objsrv").
       50     end constructor.
       51     method public void Initialization(  ):
       52       session:error-stack-trace = session:debug-alert.
       53   SystemAux = new SystemAux ().
       54       Regobj(SystemAux,
       55   "SystemAux"
       56   ).
       57   SysINI = new ini ().
       58       Regobj(SysINI,
       59   "SysINI"
       60   ).
       61   out = new putout (SysINI:SystemLogFileName:Value_).
       62       Regobj(out,
       63   "out"
       64   ).
       65   Env = new env ().
       66       Regobj(Env,
       67   "Env"
       68   ).
       69   Lib = new lib ().
       70       Regobj(Lib,
       71   "Lib"
       72   ).
       73    .
       74       define variable vtext as character no-undo.
       75       vtext = "blgiNoabkbkcWiii"
       76    .
       77   SystemSetting = new systemsetting (vtext).
       78       Regobj(SystemSetting,
       79   "SystemSetting"
       80   ).
       81    .
       82       return.
       83       define variable v-err-msg as character no-undo .
       84     end method.
       85     define variable count as integer no-undo.
       86     method private void Regobj(iparantProc as character, iobjparen as objth, iobj as objth, propname as char ):
       87       define variable IdObj as character  no-undo.
       88       if valid-object (iobj)
       89       then do:
       90          IdObj = iobj:ToString().
       91          find first tt-objth where tt-objth.objname eq IdObj no-error.
       92          if not available tt-objth
       93          then do:
       94             count = count + 1.
       95             create tt-objth.
       96             assign
       97                tt-objth.inum      = count
       98                tt-objth.objname   = IdObj
       99                tt-objth.objhndl   = iobj
      100             .
      101          end.
      102          else
      103             iobj:RefrashObject().
      104          tt-objth.propname  = propname.
      105          objparent = if valid-object(iobjparen) then iobjparen:ToString() else this-object:ToString().
      106          tt-objth.procparent = iparantProc.
      107          SysLog:EventHndlr("Зарегистрирован - " + IdObj).
      108       end.
      109       return.
      110     end method.
      111     method public void Regobj(iobjparen as objth, iobj as objth, propname as char ):
      112        Regobj(program-name(3),iobjparen, iobj, propname ).
      113     end.
      114     method public void Regobj(iobjparen as objth, iobj as objth ):
      115        Regobj(program-name(3),iobjparen, iobj, "" ).
      116     end.
      117     method public void Regobj( iobj as objth, propname as char ):
      118        Regobj(program-name(2),?,iobj,propname).
      119     end method.
      120     method public void Regobj( iobj as objth ):
      121        Regobj(program-name(4),?,iobj,"").
      122     end method.
      123     method public void Delobj( obj as Progress.Lang.Object ):
      124       if not valid-object (obj)
      125         then do:
      126           SysLog:EventHndlr("Че то объекта нет").
      127           return.
      128         end.
      129       DelobjChild(obj:ToString()).
      130       find first tt-objth where tt-objth.objname = obj:ToString() no-error.
      131       if not available (tt-objth)
      132       then do:
      133         SysLog:EventHndlr("Че то не то - " + obj:ToString()).
      134       end.
      135       else do:
      136          SysLog:EventHndlr("Разрегистрирован - " + obj:ToString()).
      137          delete tt-objth.
      138       end.
      139       return.
      140     end method.
      141     method public void DelobjChild( iParent as character  ):
      142       define buffer tt-objth for tt-objth.
      143       find first tt-objth where tt-objth.objparent = iParent no-error.
      144       do while  available  tt-objth:
      145          DelobjChild(tt-objth.objname).
      146          delete object tt-objth.objhndl no-error.
      147          if avail tt-objth then delete tt-objth.
      148          find first tt-objth where tt-objth.objparent = iParent no-error.
      149       end.
      150       return.
      151     end method.
      152     method public void view_(  ):
      153       for each tt-objth:
      154       end.
      155       return.
      156     end method.
      157     destructor public objsrv ( ):
      158       def var hndl as handle no-undo.
      159       SysLog:EventHndlr("Умирает objsrv").
      160       delobj(this-object).
      161       for each tt-objth where tt-objth.objname ne SysLog:ToString() :
      162          SysLog:EventHndlr("Забыли удалить " + tt-objth.objname) .
      163          delete tt-objth.
      164       end.
      165       delete object SysLog no-error.
      166     end destructor.
      167     method public logical RefrashObject(iUpd as integer ):
      168        upd = iUpd.
      169        for each tt-objth:
      170           cast (tt-objth.objhndl, objth):RefrashObject().
      171        end.
      172     end method.
      173     method public void GetTableObjTh(output table for tt-objth):
      174       for each tt-objth:
      175          tt-objth.label_ = cast (tt-objth.objhndl, objth):getLable().
      176       end.
      177     end method.
      178   end class.
