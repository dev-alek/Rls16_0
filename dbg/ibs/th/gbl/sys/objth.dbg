        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objsrv.
        3   block-level on error undo, throw.
        4   class ibs.th.gbl.sys.objth abstract:
        5   define public var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        6     define abstract property vss-revision    as character no-undo get.
        7     define abstract property vss-author      as character no-undo get.
        8     define abstract property vss-date        as character no-undo get.
        9     define abstract property vss-workfile    as character no-undo get.
       10     define abstract property vss-archive     as character no-undo get.
       11     define abstract property vss-description as character no-undo get.
       12     method final void vss-get-info (
       13        output o-vss-revision    as character,
       14        output o-vss-author      as character,
       15        output o-vss-date        as character,
       16        output o-vss-workfile    as character,
       17        output o-vss-archive     as character,
       18        output o-vss-description as character
       19   ):
       20        assign
       21          o-vss-revision    = vss-revision
       22          o-vss-author      = vss-author
       23          o-vss-date        = vss-date
       24          o-vss-workfile    = vss-workfile
       25          o-vss-archive     = vss-archive
       26          o-vss-description = vss-description
       27        .
       28      end.
       29      method public char getLable():
       30         return vss-description.
       31      end.
       32     constructor protected objth ():
       33       getobjserv().
       34       if valid-object (ObjSrv)
       35         then ObjSrv:Regobj(this-object).
       36     end constructor.
       37     destructor public objth (  ):
       38       getobjserv().
       39       if valid-object (ObjSrv)
       40         then ObjSrv:Delobj(this-object).
       41     end destructor.
       42     method public void getobjserv():
       43   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       44     end method.
       45     method public logical RefrashObject():
       46     end method.
       47   end class.
