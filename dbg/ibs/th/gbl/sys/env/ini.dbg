        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.sys.env.ini.section.val.
        4   block-level on error undo, throw.
        5   class ibs.th.gbl.sys.env.ini  inherits objth:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Ключи INI файла" get.
       12     define public property SystemLogFileName as val no-undo
       13       get.
       14       private set.
       15     constructor public ini (  ):
       16       super ().
       17       SystemLogFileName = getKeyValue("SystemTH", "SysLogFileName", "systh.log").
       18     end constructor.
       19     def var mval as class val no-undo.
       20     method private class val getKeyValue(inSecName as char, inKeyName as char, inValueDefault as char):
       21       def var value_ as character no-undo.
       22       def var val as class val no-undo.
       23       get-key-value
       24         section inSecName
       25         key inKeyName
       26         value value_.
       27   val = new val ().
       28   ObjSrv:Regobj(this-object,val,
       29   "val"
       30   ) .
       31    .
       32       mval = val.
       33       assign
       34         val:SectionName = inSecName
       35         val:KeyName = inKeyName
       36         val:Value_ = (if value_ = ? then inValueDefault else value_)
       37       .
       38       return val.
       39     end method.
       40   end class.
