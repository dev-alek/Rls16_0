        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ParserXMLDictGds inherits EGAISUTM:
        5       define variable v-FS-RAR as character no-undo .
        6       define temp-table tt-gds-EG no-undo
        7           field gds-code          like ub.goods.gds-code          label "Код товара в TH"
        8           field gds-name          like ub.goods.gds-name          label "Полное наименование" format "X(120)"
        9           field alc-code          as character                    label "Алкогольный код"     format "X(30)"
       10           field ms-base           like ub.goods.ms-base           label "Объем"               format ">>9.9<<"
       11           field alc-type-code     like ub.alc-type.alc-type-code  label "Код АП"
       12           field proof             like ub.goods.proof             label "Крепость"            format ">9.9"
       13           field prod-info         as character
       14           field imp-info          as character
       15           index pi as primary
       16               gds-code
       17           index name_ as word-index
       18               gds-name
       19           index alc
       20               alc-code
       21       .
       22       DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
       23       DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
       24       DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       25       define variable v-save-info as character no-undo .
       26       define variable v-imp as logical .
       27       constructor public ParserXMLDictGds (inOjType as char, inObjCode as int):
       28         super (inOjType, inObjCode).
       29       end constructor.
       30       method override handle ParseResponse(inFileName as char):
       31           empty temp-table tt-gds-EG .
       32           CREATE X-DOCUMENT hDoc.
       33           CREATE X-NODEREF hRoot.
       34           hDoc:LOAD("file",inFileName,FALSE).
       35           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       36           GetChildren(hRoot, 1).
       37           DELETE OBJECT hDoc.
       38           DELETE OBJECT hRoot.
       39           return buffer tt-gds-EG:handle.
       40       end.
       41       method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
       42           DEFINE VARIABLE i AS INTEGER NO-UNDO.
       43           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
       44           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
       45           CREATE X-NODEREF hNoderef.
       46           CREATE X-NODEREF hText .
       47           REPEAT i = 1 TO hParent:NUM-CHILDREN:
       48               good = hParent:GET-CHILD(hNoderef,i).
       49               IF NOT good THEN
       50                   LEAVE.
       51               IF hNoderef:SUBTYPE <> "element" THEN
       52                   NEXT.
       53               hNoderef:GET-CHILD(hText, 1) no-error .
       54               IF hNoderef:NAME = "ns:FSRAR_ID" THEN
       55                   assign v-FS-RAR = hText:node-value .
       56               IF hNoderef:NAME = "rap:Product" THEN DO:
       57                   create tt-gds-EG .
       58                   assign
       59                     tt-gds-EG.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
       60                     tt-gds-EG.prod-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
       61                   .
       62                END.
       63               IF hNoderef:NAME = "pref:ShortName"    THEN assign tt-gds-EG.gds-name        = hText:node-value .
       64               IF hNoderef:NAME = "pref:FullName"     THEN do :
       65                   if trim(tt-gds-EG.gds-name) = "" then assign tt-gds-EG.gds-name        = hText:node-value .
       66               end.
       67               IF hNoderef:NAME = "pref:AlcCode"      THEN assign tt-gds-EG.alc-code        = hText:node-value .
       68               IF hNoderef:NAME = "pref:Capacity"     THEN assign tt-gds-EG.ms-base         = decimal(hText:node-value) .
       69               IF hNoderef:NAME = "pref:AlcVolume"    THEN assign tt-gds-EG.proof           = decimal(hText:node-value) .
       70               IF hNoderef:NAME = "pref:ProductVCode" THEN assign tt-gds-EG.alc-type-code   = hText:node-value .
       71               IF hNoderef:NAME = "pref:Producer"     THEN assign v-imp       = false .
       72               IF hNoderef:NAME = "pref:Importer"     THEN assign v-imp       = true .
       73               IF hNoderef:NAME = "oref:UL"
       74               OR hNoderef:NAME = "oref:FL"
       75               OR hNoderef:NAME = "oref:FO"
       76               OR hNoderef:NAME = "oref:TS"
       77               THEN DO :
       78                   if v-imp then assign entry (7, tt-gds-EG.imp-info, chr(5)) = entry(2, hNoderef:NAME, ":") .
       79                   else          assign entry (7, tt-gds-EG.prod-info, chr(5)) = entry(2, hNoderef:NAME, ":") .
       80               END.
       81               IF hNoderef:NAME = "oref:ClientRegId" THEN DO :
       82                   if v-imp then assign entry (1, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
       83                   else          assign entry (1, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
       84               end.
       85               IF hNoderef:NAME = "oref:INN"
       86               OR hNoderef:NAME = "oref:TSNUM"       THEN do :
       87                   if v-imp then assign entry (2, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
       88                   else          assign entry (2, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
       89               end.
       90               IF hNoderef:NAME = "oref:KPP"         THEN do :
       91                   if v-imp then assign entry (3, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
       92                   else          assign entry (3, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
       93               end.
       94               IF hNoderef:NAME = "oref:FullName"    THEN do :
       95                   if v-imp then assign entry (4, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
       96                   else          assign entry (4, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
       97               end.
       98               IF hNoderef:NAME = "oref:Country"     THEN do :
       99                   if v-imp then assign entry (5, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
      100                   else          assign entry (5, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
      101               end.
      102               IF hNoderef:NAME = "oref:RegionCode"  THEN do :
      103                   if v-imp then assign entry (8, tt-gds-EG.imp-info, chr(5)) = hText:node-value .
      104                   else          assign entry (8, tt-gds-EG.prod-info, chr(5)) = hText:node-value .
      105               end.
      106               IF hNoderef:NAME = "oref:description" THEN do :
      107                   if v-imp then do :
      108                       v-save-info = tt-gds-EG.imp-info .
      109                       assign entry (6, tt-gds-EG.imp-info, chr(5)) = hText:node-value no-error .
      110                       if tt-gds-EG.imp-info = ? then tt-gds-EG.imp-info = v-save-info .
      111                   end.
      112                   else do :
      113                       v-save-info = tt-gds-EG.prod-info .
      114                       assign entry (6, tt-gds-EG.prod-info, chr(5)) = hText:node-value no-error .
      115                       if tt-gds-EG.prod-info = ? then tt-gds-EG.prod-info = v-save-info .
      116                   end.
      117               end.
      118               GetChildren(hNoderef, (level + 1)).
      119           END.
      120           DELETE OBJECT hNoderef.
      121           DELETE OBJECT hText.
      122       END.
      123   end class.
