        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ActBalance inherits EGAISUTM:
        5   define temp-table tt-act-header
        6       field num           as character        label "№ акта"      format "X(30)"
        7       field date_         as date             label "Дата акта"
        8       field is-sent       as logical
        9       field answer_       as character        label "Ответ"       format "X(1500)"
       10       field type_         as character        label "Основание"   format "X(35)"
       11       field RegID         as character        label "Рег. номер"  format "X(50)"
       12       index pi as primary unique
       13           num
       14   .
       15   define temp-table tt-gds-act
       16       field num           as character                label "№ акта"
       17       field position_     as integer                  label "№ пп"                    format ">>>9"
       18       field gds-code      like ub.goods.gds-code      label "Код товара   "
       19       field part-code     like ub.parts.part-code     label "Партия"
       20       field doc-code      as character                label "№ накладной TH"
       21       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
       22       field alc-code      as character                label "Алкогольный код"         format "X(21)"
       23       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
       24       field qnty          as decimal                  label "Количество"
       25       field inform-A      as character                label "Справка А"               format "X(20)"
       26       field A-qnty        as decimal                  label "Кол-во в справке"
       27       field A-bottleDate  as date                     label "Дата розлива"
       28       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
       29       field A-ttnDate     as date                     label "Дата"
       30       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
       31       field A-fixDate     as date                     label "Дата фикс."
       32       field inform-B      as character                label "Справка Б"               format "X(20)"
       33       field marks-qnty    as integer                  label "Кол-во марок"
       34       field egais-name    as character
       35       index pi as primary unique
       36           position_
       37       index code
       38           gds-code doc-code
       39   .
       40   define   temp-table tt-marks
       41       field num                 as character            label "№ акта"
       42       field gds-part-position_  as integer
       43       field mark                as character            label "Марка"          format "X(100)"
       44       field new_                as logical
       45       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
       46       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
       47       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
       48       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
       49       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
       50       field flag                as logical              label "T"
       51       field reserv              as integer              label "R"
       52       field parts               as character            label "Партия"         format "X(130)"
       53       index pi as primary unique
       54           mark
       55   .
       56   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       57     define stream outstr.
       58     define private buffer buf_clob-bind for ub.clob-bind.
       59     define private buffer buf_clob-data for ub.clob-data.
       60     define private buffer buf_gds for ub.goods.
       61     define private buffer buf_trn-doc for ub.trn-doc.
       62     define private buffer buf_doc-attr for ub.doc-attr.
       63     define private buffer buf_doc-line for ub.doc-line.
       64     define private buffer buf_clients for ub.clients.
       65     define private buffer buf_ext-classif for ub.ext-classif.
       66     define private variable parameters     as character no-undo.
       67     define private variable inFileName     as character no-undo.
       68     define private variable inData         as character no-undo.
       69     define private variable outData        as character no-undo.
       70     define private variable cmd            as character no-undo.
       71     define private variable urlResp        as character no-undo.
       72     define private variable v-uniq-key-rec as character no-undo.
       73     define private variable v-Answer       as character no-undo.
       74     define private variable v-RegID        as character no-undo.
       75     define private variable ticket2        as logical   no-undo.
       76     define variable v-FS-RAR  as character no-undo .
       77     define variable ObjType   as character no-undo .
       78     define variable ObjCode   as integer   no-undo .
       79     define variable Obj       as character no-undo .
       80     define variable v-ext-sys as integer   no-undo .
       81     DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       82     define property inNum as character no-undo
       83       get.
       84       set.
       85     constructor public ActBalance (inOjType as char, inObjCode as int, inFSRAR as char, inExtSys as integer):
       86       super (inOjType, inObjCode).
       87       ObjCode = inObjCode.
       88       ObjType = inOjType.
       89       Obj = "*-" + substring(ObjType,1,1) + string(ObjCode) + "-*" .
       90       v-FS-RAR = inFSRAR.
       91       v-ext-sys = inExtSys.
       92       IsSent.
       93     end constructor.
       94     method public override handle GetHndlTable(inTableType as int, inAbIndenty as char) :
       95       define variable hRoot as handle  no-undo.
       96       define variable hDoc  as handle  no-undo.
       97       define variable ii    as integer no-undo.
       98           define variable v-type as character no-undo .
       99       assign
      100         parameters = inNum
      101         StatusErr = false
      102         Msg       = ""
      103         .
      104       case inTableType:
      105         when 3 then
      106           do:
      107             empty temp-table tt-act-header.
      108             for each buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab':U:
      109               if entry(1, buf_clob-bind.descr, chr(4)) matches Obj
      110               then .
      111               else next .
      112               create tt-act-header.
      113               assign
      114                   tt-act-header.num       = (entry (1, buf_clob-bind.descr, chr(4)))
      115                   tt-act-header.date_     = date (entry (2, buf_clob-bind.descr, chr(4)))
      116                   tt-act-header.is-sent   = logical (entry (3, buf_clob-bind.descr, chr(4)))
      117               .
      118               assign tt-act-header.answer_   = (entry (4, buf_clob-bind.descr, chr(4))) no-error .
      119               assign tt-act-header.type_   = (entry (5, buf_clob-bind.descr, chr(4))) no-error .
      120                           assign tt-act-header.RegID     = (entry (6, buf_clob-bind.descr, chr(4))) no-error .
      121               end.
      122             return buffer tt-act-header:handle.
      123           end.
      124         when 2 then
      125         do :
      126                   v-Answer = "" .
      127           v-RegID = "" .
      128           create x-document hDoc.
      129           create x-noderef  hRoot.
      130           ReplyID = "" .
      131           IsSent.
      132           if ReplyID = "" or ReplyID = ?
      133           then do:
      134             StatusErr = true.
      135             Msg = "Не найден запрос в журнале запросов или код запроса пуст".
      136             return ?.
      137           end.
      138           if ConPar = "" or ConPar = ?
      139           then do:
      140             StatusErr = true.
      141             Msg = "Не заданы настройки соединения для EGAIS".
      142             return ?.
      143           end.
      144           ticket2 = false .
      145           GetSubjectOfRequestUTM().
      146           if StatusErr
      147             then return ?.
      148           file-info:file-name = search (inFileName).
      149           if search (inFileName) = ? or file-info:file-size = 0
      150           then do:
      151             assign
      152               StatusErr = true
      153               Msg = "Не удалось получить данные от UTM"
      154             .
      155             return ?.
      156           end.
      157           if not WriteDbStatus ( 4, parameters , ReplyId, true )
      158           then do:
      159             assign
      160               StatusErr = true
      161               Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      162             .
      163             undo, return ?.
      164           end.
      165           hDoc:load ("file", inFileName, false).
      166           hDoc:get-document-element(hRoot) .
      167           GetChildren(hRoot, 1).
      168           DELETE OBJECT hDoc no-error.
      169           DELETE OBJECT hRoot no-error.
      170           ticket2 = true .
      171           if num-entries(urlResp, chr(4)) = 2 then do :
      172               create x-document hDoc.
      173               create x-noderef  hRoot.
      174               GetSubjectOfRequestUTM().
      175               if StatusErr
      176                 then return ?.
      177               file-info:file-name = search (inFileName).
      178               if search (inFileName) = ? or file-info:file-size = 0
      179               then do:
      180                 assign
      181                   StatusErr = true
      182                   Msg = "Не удалось получить данные от UTM"
      183                 .
      184                 return ?.
      185               end.
      186               hDoc:load ("file", inFileName, false).
      187               hDoc:get-document-element(hRoot) .
      188               GetChildren(hRoot, 1).
      189               DELETE OBJECT hDoc no-error.
      190               DELETE OBJECT hRoot no-error.
      191           end.
      192           find last buf_clob-bind exclusive-lock where buf_clob-bind.field-name_ = 'egais-ab':U and buf_clob-bind.uniq-key-rec = inAbIndenty .
      193           v-type = (entry (5, buf_clob-bind.descr, chr(4))) no-error .
      194                   if v-type = ? then v-type = "" .
      195                   if num-entries (buf_clob-bind.descr, chr(4)) = 3 then
      196               assign buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-Answer + chr(4) + v-type + chr(4) + v-RegID .
      197           else if num-entries (buf_clob-bind.descr, chr(4)) = 4 then
      198                           assign entry(4, buf_clob-bind.descr, chr(4)) = v-Answer
      199                                      buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-type + chr(4) + v-RegID .
      200                   else if num-entries (buf_clob-bind.descr, chr(4)) = 5 then
      201               assign entry(4, buf_clob-bind.descr, chr(4)) = v-Answer
      202                                      entry(5, buf_clob-bind.descr, chr(4)) = v-type
      203                                      buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-RegID .
      204                   else if num-entries (buf_clob-bind.descr, chr(4)) = 6 then
      205               assign entry(4, buf_clob-bind.descr, chr(4)) = v-Answer
      206                                      entry(5, buf_clob-bind.descr, chr(4)) = v-type
      207                                      entry(6, buf_clob-bind.descr, chr(4)) = v-RegID .
      208           release buf_clob-bind .
      209           find first tt-act-header where tt-act-header.num = inAbIndenty .
      210           assign tt-act-header.answer_ = v-Answer
      211                  tt-act-header.RegID   = v-RegID .
      212           return buffer tt-act-header:handle.
      213         end.
      214       end case.
      215     end.
      216     method override public logical SendRequestUTM ():
      217       def var ii        as int    no-undo.
      218       def var xml-cont  as char   no-undo.
      219       def var respValue as handle no-undo.
      220       assign
      221         parameters = inNum
      222         StatusErr = false
      223         Msg       = ""
      224         .
      225       IsSent.
      226       do trans:
      227         os-delete "RespActChargeOn0.xml".
      228         assign
      229           inFileName = "RespActChargeOn0.xml"
      230           .
      231         find first tt-act-header where tt-act-header.num = inNum no-error.
      232         if available (tt-act-header)
      233           then
      234         do:
      235             if VerXSD = "1"
      236             then
      237             cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/ActChargeOn >&4", search ("exe/curl.exe"), search ("ActChargeOn.xml"), ConPar, inFileName, TimeOut).
      238             if VerXSD = "2"
      239             then
      240             cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/ActChargeOn_v2 >&4", search ("exe/curl.exe"), search ("ActChargeOn_v2.xml"), ConPar, inFileName, TimeOut).
      241             os-command silent value (cmd).
      242             file-info:file-name = search (inFileName).
      243             if search (inFileName) <> ? and file-info:file-size > 0
      244               then
      245             do:
      246               respValue = ParseRequest (inFileName).
      247               if respValue = ?
      248                 then
      249               do:
      250                 assign
      251                   StatusErr = true
      252                   Msg       = "Не удалось разобрать данные от UTM"
      253                   .
      254                 undo, return false.
      255               end.
      256               if not StatusErr
      257                 then
      258                 ReplyId = respValue:node-value.
      259               else
      260               do:
      261                 assign
      262                   StatusErr = true
      263                   Msg       = respValue:node-value
      264                   .
      265                 undo, return false.
      266               end.
      267             end.
      268             else
      269             do:
      270               assign
      271                 StatusErr = true
      272                 Msg       = "Не удалось отправить акт постановки на баланс в UTM"
      273                 .
      274               undo, return false.
      275             end.
      276             if not WriteDbStatus (4, parameters , ReplyId, false)
      277             then do:
      278               assign
      279                 StatusErr = true
      280                 Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      281               .
      282               undo, return false.
      283             end.
      284         end.
      285       end.
      286     end.
      287     method override protected logical GetIsSent ():
      288       find last ub.esys-all-attr no-lock
      289                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      290                   and ub.esys-all-attr.attr-code = "egais"
      291                   and ub.esys-all-attr.key2       = 4
      292                   and ub.esys-all-attr.attr-value = parameters
      293                   no-error.
      294       if available (ub.esys-all-attr )
      295       then do:
      296         ReplyId = ub.esys-all-attr.key7.
      297         return true.
      298       end.
      299       return false.
      300     end.
      301     method protected handle ParseRequest (inFileName as char):
      302       define variable hRoot as handle  no-undo.
      303       define variable hDoc  as handle  no-undo.
      304       define variable hRow  as handle  no-undo.
      305       define variable hText as handle  no-undo.
      306       define variable ii    as integer no-undo.
      307       create x-document hDoc.
      308       create x-noderef  hRoot.
      309       create x-noderef  hRow.
      310       create x-noderef htext .
      311       hDoc:load ("file", inFileName, false).
      312       hDoc:encoding = "UTF-8".
      313       hDoc:get-document-element(hRoot) .
      314       do ii = 1 to hRoot:num-children:
      315         hRoot:get-child(hRow,ii).
      316         case hRow:name:
      317           when "url" then
      318             do:
      319               hRow:get-child (hText, 1) no-error.
      320               return hText.
      321             end.
      322           when "error" then
      323             do:
      324               hRow:get-child (hText, 1) no-error.
      325               StatusErr = true.
      326               return hText.
      327             end.
      328           otherwise
      329             do:
      330               return ?.
      331             end.
      332         end case.
      333       end.
      334     end.
      335     method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
      336           DEFINE VARIABLE i AS INTEGER NO-UNDO.
      337           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      338           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      339           define variable v-ok as logical no-undo .
      340           CREATE X-NODEREF hNoderef.
      341           CREATE X-NODEREF hText .
      342           REPEAT i = 1 TO hParent:NUM-CHILDREN:
      343               good = hParent:GET-CHILD(hNoderef,i).
      344               IF NOT good THEN
      345                   LEAVE.
      346               IF hNoderef:SUBTYPE <> "element" THEN
      347                   NEXT.
      348               hNoderef:GET-CHILD(hText, 1) no-error .
      349               IF hNoderef:NAME = "tc:RegID"    THEN do :
      350                   v-RegID  = hText:node-value no-error.
      351                   if v-RegID = ? then v-RegID = "" .
      352               end.
      353               IF hNoderef:NAME = "tc:Conclusion"
      354               OR hNoderef:NAME = "tc:OperationResult" THEN
      355               DO :
      356                   if hText:node-value = "Rejected" then v-RegID = v-RegID + CHR(5) + "R" .
      357                   if hText:node-value = "Accepted" then v-RegID = v-RegID + CHR(5) + "A" .
      358               END.
      359               IF hNoderef:NAME = "tc:Comments" THEN do :
      360                   if trim(v-Answer) = '' or v-Answer = chr(10) then v-Answer = hText:node-value .
      361                   else v-Answer = v-Answer + chr(10) + hText:node-value .
      362               end.
      363               IF hNoderef:NAME = "tc:OperationResult" THEN v-ok = (hText:node-value = "Accepted") .
      364               IF hNoderef:NAME = "tc:OperationComment" THEN v-Answer = v-Answer + chr(10) + hText:node-value .
      365               GetChildren(hNoderef, (level + 1)).
      366           END.
      367           DELETE OBJECT hNoderef.
      368           DELETE OBJECT hText.
      369     END.
      370     method public override character GetSubjectOfRequestUTM() :
      371       define variable response as character no-undo .
      372       if not ticket2 then do :
      373           urlResp = GetURLUTM(ReplyId).
      374       end.
      375       if StatusErr and Msg <> "" and Msg <> ? then return ? .
      376       if urlResp = "" or urlResp = ?
      377       then do:
      378         StatusErr = true.
      379         Msg = "Еще не получен ответ от сервера EGAIS по запросу " + ReplyId + chr(10) + "Либо ответ уже автоматически удалён".
      380         return ?.
      381       end.
      382       if not ticket2 then do :
      383           os-delete "RespActChargeOn.xml".
      384           assign
      385             inFileName = "RespActChargeOn.xml"
      386             response = entry(1,urlResp,chr(4))
      387           .
      388       end.
      389       else do :
      390           os-delete "RespActChargeOn2.xml".
      391           assign
      392             inFileName = "RespActChargeOn2.xml"
      393           .
      394           response = entry(2,urlResp,chr(4)) no-error .
      395       end.
      396       if trim(response) <> "" then do :
      397           cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, response, inFileName).
      398           os-command silent value (cmd).
      399       end.
      400     end.
      401     method protected override character GetURLUTM (inReplyId as char):
      402       define variable hRoot as handle  no-undo.
      403       define variable hDoc  as handle  no-undo.
      404       define variable hRow  as handle  no-undo.
      405       define variable hText as handle  no-undo.
      406       define variable ii    as integer no-undo.
      407       define variable files as character no-undo.
      408       create x-document hDoc.
      409       create x-noderef  hRoot.
      410       create x-noderef  hRow.
      411       create x-noderef  hText.
      412       assign
      413         inFileName = "ReceiptListOfQuery.xml"
      414       .
      415       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      416       if search (inFileName) <> ? then os-delete value (inFileName).
      417       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      418       os-command silent value (cmd).
      419       file-info:file-name = search (inFileName).
      420       if search (inFileName) = ? or file-info:file-size = 0
      421       then do:
      422         assign
      423           StatusErr = true
      424           Msg = "Не удалось получить данные от UTM"
      425         .
      426         return ?.
      427       end.
      428       hDoc:load ("file", inFileName, false).
      429       hDoc:get-document-element(hRoot) .
      430       do ii = 1 to hRoot:num-children:
      431         hRoot:get-child(hRow,ii).
      432         case hRow:name:
      433           when "url" then
      434             do:
      435               if hRow:get-attribute("replyId") = ReplyId
      436               then do:
      437                 hRow:get-child (hText, 1) no-error.
      438                 files = files + chr(4) + hText:node-value.
      439               end.
      440             end.
      441         end case.
      442       end.
      443       files = trim(files, chr(4)) .
      444       return files .
      445     end.
      446   end class.
