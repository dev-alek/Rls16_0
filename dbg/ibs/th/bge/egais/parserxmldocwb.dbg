      169     method public void ParseRec (hDoc as handle, input-output table tt-wb-header, input-output table tt-wb-act-header, input-output table tt-ticket, input-output table tt-wb-info-client, input-output table tt-wb-gds-EG):
      170       define variable hRoot as handle no-undo.
      171       glog = false.
      172       empty temp-table tt-wb-header.
      173       empty temp-table tt-wb-gds-EG.
      174       empty temp-table tt-wb-act-header.
      175       empty temp-table tt-wb-act-gds-EG.
      176       empty temp-table tt-ticket.
      177       empty temp-table tt-wb-info-client.
      178       if valid-handle (hDoc)
      179       then do:
      180         create x-noderef hRoot.
      181         nn = 0.
      182         hDoc:get-document-element(hRoot).
      183         GetChildren(hRoot, 1).
      184         delete object hRoot.
      185         delete object hDoc.
      186       end.
      187       find first tt-wb-header no-error.
      188       find first tt-wb-act-header no-error.
      189       find first tt-ticket no-error.
      190       if not available (tt-wb-header) and not available (tt-wb-act-header) and not available (tt-ticket) then
      191       do:
      192         glog = false.
      193       end.
      194       glog = true.
      195     end.
      196     method public void ParseRec (hDoc as handle, input-output outDate as date, url_ as char):
      197       define variable hRoot as handle no-undo.
      198       glog = false.
      199       empty temp-table tt-wb-header.
      200       empty temp-table tt-wb-gds-EG.
      201       empty temp-table tt-wb-act-header.
      202       empty temp-table tt-wb-act-gds-EG.
      203       empty temp-table tt-ticket.
      204       if valid-handle (hDoc)
      205       then do:
      206         create x-noderef hRoot.
      207         nn = 0.
      208         hDoc:get-document-element(hRoot).
      209         GetChildren(hRoot, 1).
      210         delete object hRoot.
      211         delete object hDoc.
      212       end.
      213       find first tt-wb-header no-error.
      214       find first tt-wb-act-header no-error.
      215       find first tt-ticket no-error.
      216       case true:
      217         when available tt-wb-header then do:
      218           outDate = tt-wb-header.wb-date.
      219         end.
      220         when available tt-wb-act-header then do:
      221           outDate = tt-wb-act-header.act-date.
      222         end.
      223         when available tt-ticket then do:
      224           assign
      225             outDate = date (   substring (entry (3, tt-ticket.ticket-date, "-"), 1, 2) + "." + entry (2, tt-ticket.ticket-date, "-") + "." + entry (1, tt-ticket.ticket-date, "-"))
      226           no-error.
      227         end.
      228       end case.
      229       glog = true.
      230     end.
      231     method public void ParseRec (hDocWB as handle, hDocRef as handle, input-output table tt-wb-header, input-output table tt-wb-gds-EG, input-output table tt-wb-info-client):
      232       define variable hRoot as handle no-undo.
      233       glog = false.
      234       if IsToClearTable
      235       then do:
      236         empty temp-table tt-wb-header.
      237         empty temp-table tt-wb-gds-EG.
      238         empty temp-table tt-wb-info-client.
      239       end.
      240       if valid-handle (hDocWB)
      241       then do:
      242         create x-noderef hRoot.
      243         nn = 0.
      244         hDocWB:get-document-element(hRoot).
      245         GetChildren(hRoot, 1).
      246         delete object hRoot.
      247         delete object hDocWB.
      248       end.
      249       if valid-handle (hDocRef)
      250       then do:
      251         create x-noderef hRoot.
      252         nn = 0.
      253         hDocRef:get-document-element(hRoot).
      254         GetChildren(hRoot, 1).
      255         delete object hRoot.
      256         delete object hDocRef.
      257       end.
      258       glog = true.
      259     end.
      260     method public void ParseRec (hDocAct as handle, input-output table tt-wb-act-header, input-output table tt-wb-act-gds-EG):
      261       define variable hRoot as handle no-undo.
      262       glog = false.
      263       if IsToClearTable
      264       then do:
      265         empty temp-table tt-wb-act-header.
      266         empty temp-table tt-wb-act-gds-EG.
      267       end.
      268       if valid-handle (hDocAct)
      269       then do:
      270         create x-noderef hRoot.
      271         nn = 0.
      272         hDocAct:get-document-element(hRoot).
      273         GetChildren(hRoot, 1).
      274         delete object hRoot.
      275         delete object hDocAct.
      276       end.
      277       glog = true.
      278     end.
      279     method public void ParseRec (hDocTicket as handle, input-output table tt-ticket):
      280       define variable hRoot as handle no-undo.
      281       glog = false.
      282       if IsToClearTable
      283       then do:
      284         empty temp-table tt-ticket.
      285       end.
      286       if valid-handle (hDocTicket)
      287       then do:
      288         create x-noderef hRoot.
      289         nn = 0.
      290         hDocTicket:get-document-element(hRoot).
      291         GetChildren(hRoot, 1).
      292         delete object hRoot.
      293         delete object hDocTicket.
      294       end.
      295       glog = true.
      296     end.
      297     method private void GetChildren(hParent as handle, level as integer):
      298       define variable i             as integer   no-undo.
      299       define variable hNoderef      as handle    no-undo.
      300       define variable hText         as handle    no-undo.
      301       define variable nameParent    as handle    no-undo.
      302       define variable good          as logical   no-undo.
      303       define variable parentName    as character no-undo.
      304       define variable parentNS-URI  as character no-undo.
      305       define variable noderefName   as character no-undo.
      306       define variable noderefNS-URI as character no-undo.
      307       create x-noderef hNoderef.
      308       create x-noderef hText .
      309       parentNS-URI = hParent:namespace-uri.
      310       parentName = hParent:name.
      311       case true:
      312         when parentNS-URI = "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" then do:
      313           parentName = "ns:" + entry (2, parentName, ":").
      314         end.
      315         when parentNS-URI = "http://fsrar.ru/WEGAIS/TTNSingle_v2" or parentNS-URI = "http://fsrar.ru/WEGAIS/TTNSingle" then do:
      316           parentName = "wb:" + entry (2, parentName, ":").
      317         end.
      318         when parentNS-URI = "http://fsrar.ru/WEGAIS/TTNInformF2Reg" or parentNS-URI = "http://fsrar.ru/WEGAIS/TTNInformBReg" then do:
      319           parentName = "wbr:" + entry (2, parentName, ":").
      320         end.
      321         when parentNS-URI = "http://fsrar.ru/WEGAIS/ActTTNSingle_v2" or parentNS-URI = "http://fsrar.ru/WEGAIS/ActTTNSingle" then do:
      322           parentName = "wa:" + entry (2, parentName, ":").
      323         end.
      324         when parentNS-URI = "http://fsrar.ru/WEGAIS/Ticket" then do:
      325           parentName = "tc:" + entry (2, parentName, ":").
      326         end.
      327         when parentName begins "wt" then do:
      328           parentName = "wt:" + entry (2, parentName, ":").
      329         end.
      330         when parentNS-URI = "http://fsrar.ru/WEGAIS/ClientRef_v2" or parentNS-URI = "http://fsrar.ru/WEGAIS/ClientRef" then do:
      331           parentName = "oref:" + entry (2, parentName, ":").
      332         end.
      333         when parentNS-URI = "http://fsrar.ru/WEGAIS/ProductRef_v2" or parentNS-URI = "http://fsrar.ru/WEGAIS/ProductRef" then do:
      334           parentName = "pref:" + entry (2, parentName, ":").
      335         end.
      336       end.
      337       repeat i = 1 to hParent:num-children:
      338         good = hParent:get-child(hNoderef,i).
      339         if not good then
      340           leave.
      341         if hNoderef:subtype <> "element" or hNoderef:num-children = 0 then
      342           next.
      343         hNoderef:get-child(hText, 1) no-error .
      344         if error-status:error
      345           then next.
      346         noderefNS-URI = hNoderef:namespace-uri.
      347         noderefName = hNoderef:name.
      348         case true:
      349           when noderefNS-URI = "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" then do:
      350             noderefName = "ns:" + entry (2, noderefName, ":").
      351           end.
      352           when noderefNS-URI = "http://fsrar.ru/WEGAIS/TTNSingle_v2" or noderefNS-URI = "http://fsrar.ru/WEGAIS/TTNSingle" then do:
      353             noderefName = "wb:" + entry (2, noderefName, ":").
      354           end.
      355           when noderefNS-URI = "http://fsrar.ru/WEGAIS/TTNInformF2Reg" or noderefNS-URI = "http://fsrar.ru/WEGAIS/TTNInformBReg" then do:
      356             noderefName = "wbr:" + entry (2, noderefName, ":").
      357           end.
      358           when noderefNS-URI = "http://fsrar.ru/WEGAIS/ActTTNSingle_v2" or noderefNS-URI = "http://fsrar.ru/WEGAIS/ActTTNSingle" then do:
      359             noderefName = "wa:" + entry (2, noderefName, ":").
      360           end.
      361           when noderefNS-URI = "http://fsrar.ru/WEGAIS/Ticket" then do:
      362             noderefName = "tc:" + entry (2, noderefName, ":").
      363           end.
      364           when noderefName begins "wt" then do:
      365             noderefName = "wt:" + entry (2, noderefName, ":").
      366           end.
      367           when noderefNS-URI = "http://fsrar.ru/WEGAIS/ClientRef_v2" or noderefNS-URI = "http://fsrar.ru/WEGAIS/ClientRef" then do:
      368             noderefName = "oref:" + entry (2, noderefName, ":").
      369           end.
      370           when noderefNS-URI = "http://fsrar.ru/WEGAIS/ProductRef_v2" or noderefNS-URI = "http://fsrar.ru/WEGAIS/ProductRef" then do:
      371             noderefName = "pref:" + entry (2, noderefName, ":").
      372           end.
      373         end.
      374         case noderefName:
      375           when "wb:Shipper" or
      376           when "wbr:Shipper" then
      377             do:
      378               parentNameOref = "".
      379               create tt-wb-info-client .
      380               tt-wb-info-client.wb-type-client = "Shipper".
      381             end.
      382           when "wb:Consignee" then
      383             do:
      384               parentNameOref = "".
      385               create tt-wb-info-client .
      386               tt-wb-info-client.wb-type-client = "Consignee".
      387             end.
      388           when "wb:Supplier" then
      389             do:
      390               parentNameOref = "".
      391               create tt-wb-info-client .
      392               tt-wb-info-client.wb-type-client = "Supplier".
      393             end.
      394           when "wb:Content" or when "wbr:Content" then
      395             do:
      396               parentNameOref = "".
      397               assign
      398                 tt-wb-header.uniq-key-rec = tt-wb-header.num + chr(6) + string (tt-wb-header.wb-date) + chr(6) + tt-wb-header.regID-Ship + chr(6) + tt-wb-header.Identity.
      399             end.
      400           when "wb:Position" then
      401             do:
      402               parentNameOref = "".
      403               create tt-wb-gds-EG .
      404               tt-wb-gds-EG.prod-list = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5).
      405               tt-wb-gds-EG.importer-list = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5).
      406               nn = nn + 1.
      407             end.
      408           when "wa:Header" then
      409             do:
      410               parentNameOref = "".
      411               create tt-wb-act-header .
      412             end.
      413           when "wa:Position" then
      414             do:
      415               parentNameOref = "".
      416               create tt-wb-act-gds-EG .
      417             end.
      418           when "ns:Ticket" then
      419             do:
      420               parentNameOref = "".
      421               create tt-ticket .
      422               tt-ticket.docType = "Ticket".
      423             end.
      424           when "ns:ConfirmTicket" then
      425             do:
      426               parentNameOref = "".
      427               create tt-ticket .
      428               tt-ticket.doc = 'ConfirmTicket'.
      429               tt-ticket.docType = 'ConfirmTicket'.
      430             end.
      431           when "ns:ConfirmRepealWB" then
      432             do:
      433               parentNameOref = "".
      434               create tt-ticket .
      435               tt-ticket.doc = 'ConfirmRepealWB'.
      436               tt-ticket.docType = 'ConfirmRepealWB'.
      437             end.
      438           when "ns:RequestRepealWB" then
      439             do:
      440               parentNameOref = "".
      441               create tt-ticket .
      442               tt-ticket.doc = 'RequestRepealWB'.
      443               tt-ticket.docType = 'RequestRepealWB'.
      444             end.
      445         end case.
      446         if lookup (parentName, "ns:Ticket") > 0 then do:
      447           if noderefName = "tc:DocId" then assign tt-ticket.docID = hText:node-value.
      448           if noderefName = "tc:TransportId" then assign tt-ticket.TransId = hText:node-value.
      449           if noderefName = "tc:TicketDate" then assign tt-ticket.ticket-date = hText:node-value.
      450           if noderefName = "tc:RegID"
      451           then do:
      452             assign tt-ticket.regid = hText:node-value.
      453           end.
      454           if noderefName = "tc:Identity" then assign tt-ticket.Identity = hText:node-value.
      455           if noderefName = "tc:DocType" then assign tt-ticket.doc = "ticket/" + hText:node-value.
      456         end.
      457         if lookup (parentName, "ns:ConfirmTicket,ns:ConfirmRepealWB") > 0 then do:
      458           if noderefName = "wt:Identity" then assign tt-ticket.Identity = hText:node-value.
      459         end.
      460         if lookup (parentName, "wt:Header") > 0 then do:
      461           if noderefName = "wt:IsConfirm" then assign tt-ticket.status_ = hText:node-value.
      462           if noderefName = "wt:TicketDate" then assign tt-ticket.ticket-date = hText:node-value.
      463           if noderefName = "wt:WBRegId" then assign tt-ticket.regid = hText:node-value.
      464           if noderefName = "wt:Note" then assign tt-ticket.comment = hText:node-value.
      465         end.
      466         if lookup (parentName, "ns:RequestRepealWB") > 0 then do:
      467           if noderefName = "qp:RequestDate" then assign tt-ticket.ticket-date = hText:node-value.
      468           if noderefName = "qp:WBRegId" then assign tt-ticket.regid = hText:node-value.
      469           if noderefName = "qp:RequestNumber" then assign tt-ticket.Identity = hText:node-value.
      470         end.
      471         if lookup (parentName, "tc:Result") > 0 then do:
      472           if noderefName = "tc:Conclusion" then assign tt-ticket.status_ = hText:node-value.
      473           if noderefName = "tc:Comments" then assign tt-ticket.comment = hText:node-value.
      474         end.
      475         if lookup (parentName, "tc:OperationResult") > 0 then do:
      476           if noderefName = "tc:OperationResult" then assign tt-ticket.status_ = hText:node-value.
      477           if noderefName = "tc:OperationComment" then assign tt-ticket.comment = hText:node-value.
      478         end.
      479         if lookup (parentName, "ns:Owner") > 0
      480         then do:
      481           if noderefName = "ns:FSRAR_ID" then assign FromFSRAR = hText:node-value.
      482         end.
      483         case noderefName:
      484         when 'ns:WayBill' then do:
      485           if not available (tt-wb-header) then create tt-wb-header.
      486           tt-wb-header.verXSD = 'WayBill'.
      487         end.
      488         when 'ns:WayBill_v2' then do:
      489           if not available (tt-wb-header) then create tt-wb-header.
      490           tt-wb-header.verXSD = 'WayBill_v2'.
      491         end.
      492         end case.
      493         if lookup (parentName, "wb:Header,ns:WayBill,ns:WayBill_v2,wbr:Header,wa:Header") > 0
      494           then
      495         do:
      496           if noderefName = "wb:Identity" or noderefName = "wbr:Identity" or noderefName = "wb:NUMBER" or noderefName = "wbr:WBRegId"
      497             then
      498           do:
      499             if not available (tt-wb-header) then create tt-wb-header.
      500             assign
      501               tt-wb-header.Identity = hText:node-value when noderefName = "wb:Identity"
      502               tt-wb-header.ps       = "EGAIS wb:Identity " + hText:node-value when noderefName = "wb:Identity"
      503               .
      504           end.
      505           if noderefName = "wb:NUMBER" or noderefName = "wbr:WBNUMBER" then assign tt-wb-header.num = hText:node-value.
      506           if noderefName = "wb:Date" or noderefName = "wbr:WBDate" then assign tt-wb-header.wb-date = date (entry (3, hText:node-value, "-") + "." + entry (2, hText:node-value, "-") + "." + entry (1, hText:node-value, "-")) .
      507           if noderefName = "wb:ShippingDate" then assign tt-wb-header.shippingdate = date (entry (3, hText:node-value, "-") + "." + entry (2, hText:node-value, "-") + "." + entry (1, hText:node-value, "-")) .
      508           if noderefName = "wb:Type" then
      509           do:
      510             case hText:node-value :
      511               when 'WBInvoiceFromMe' then
      512                 do:
      513                   assign
      514                     tt-wb-header.wb-type      = 'ie':U
      515                     tt-wb-header.wb-type-full = "приход вн.".
      516                 end.
      517               when 'WBReturnFromMe' then
      518                 do:
      519                   assign
      520                     tt-wb-header.wb-type      = 're':U
      521                     tt-wb-header.wb-type-full = "возврат вн.".
      522                 end.
      523               otherwise
      524               do:
      525                 assign
      526                   tt-wb-header.wb-type = ?.
      527               end.
      528             end case.
      529           end.
      530           if noderefName = "wb:UnitType"     then assign tt-wb-header.UnitType = hText:node-value .
      531           if noderefName = "wa:ACTNUMBER" then assign tt-wb-act-header.num = hText:node-value.
      532           if noderefName = "wa:ActDate" then assign tt-wb-act-header.act-date = date (entry (3, right-trim (hText:node-value), "-") + "." + entry (2, hText:node-value, "-") + "." + entry (1, left-trim (hText:node-value), "-")) .
      533           if noderefName = "wa:WBRegId" then assign tt-wb-act-header.wbregid = hText:node-value.
      534           if noderefName = "wa:IsAccept" then assign tt-wb-act-header.status_ = hText:node-value.
      535           if noderefName = "wa:Note" then assign tt-wb-act-header.note = hText:node-value.
      536         end.
      537         if lookup (parentName, "wb:Shipper,wb:Consignee,wb:Supplier,wbr:Shipper")  > 0 or lookup (parentNameOref, "wb:Shipper,wb:Consignee,wb:Supplier,wbr:Shipper")  > 0
      538         then
      539         do:
      540           if lookup (noderefName, "oref:UL,oref:FL,oref:FO,oref:TS") > 0
      541           then do:
      542             parentNameOref = parentName.
      543           end.
      544           if noderefName = "oref:ClientRegId" then
      545           do:
      546             assign
      547               tt-wb-info-client.regID = hText:node-value
      548               tt-wb-header.regID-Ship = hText:node-value
      549               when tt-wb-info-client.wb-type-client = 'Shipper'
      550               tt-wb-header.regID-Cons = hText:node-value
      551               when tt-wb-info-client.wb-type-client = 'Consignee'
      552               .
      553           end.
      554           if noderefName = "oref:FullName"    then assign tt-wb-header.NameShip = hText:node-value when parentName = 'wb:Shipper'.
      555           if noderefName = "oref:INN"         then assign tt-wb-header.INNShip = hText:node-value when parentName = 'wb:Shipper'.
      556           if noderefName = "oref:KPP"         then assign tt-wb-header.KPPShip = hText:node-value when parentName = 'wb:Shipper'.
      557           if noderefName = "oref:INN"         then assign tt-wb-info-client.inn = hText:node-value .
      558           if noderefName = "oref:KPP"         then assign tt-wb-info-client.kpp = hText:node-value .
      559           if noderefName = "oref:FullName"    then assign tt-wb-info-client.obj-name-egais = hText:node-value .
      560           if noderefName = "oref:Country"     then assign tt-wb-info-client.country = hText:node-value .
      561           if noderefName = "oref:Index"       then assign tt-wb-info-client.postIndex = hText:node-value .
      562           if noderefName = "oref:RegionCode"  then assign tt-wb-info-client.regionCode = hText:node-value .
      563           if noderefName = "oref:area"        then assign tt-wb-info-client.district = hText:node-value .
      564           if noderefName = "oref:city"        then assign tt-wb-info-client.city = hText:node-value .
      565           if noderefName = "oref:place"       then assign tt-wb-info-client.settlement = hText:node-value .
      566           if noderefName = "oref:street"      then assign tt-wb-info-client.street = hText:node-value .
      567           if noderefName = "oref:house"       then assign tt-wb-info-client.house-number = hText:node-value .
      568           if noderefName = "oref:building"    then assign tt-wb-info-client.house-case = hText:node-value .
      569           if noderefName = "oref:liter"       then assign tt-wb-info-client.house-litera = hText:node-value .
      570           if noderefName = "oref:description" then assign tt-wb-info-client.description_ = hText:node-value .
      571         end.
      572         if lookup (parentName, "wa:Position") > 0
      573         then
      574         do:
      575           if noderefName = "wa:InformBRegId"   then assign tt-wb-act-gds-EG.refB = hText:node-value .
      576           if noderefName = "wa:RealQuantity"   then assign tt-wb-act-gds-EG.RealQuantity = decimal(hText:node-value) .
      577         end.
      578         if lookup (parentName, "wb:Position,wb:Product") > 0
      579           then
      580         do:
      581           if tt-wb-gds-EG.gds-name = "" then
      582             if noderefName = "pref:ShortName"    then assign tt-wb-gds-EG.gds-name = hText:node-value.
      583           if noderefName = "pref:FullName"     then assign tt-wb-gds-EG.gds-name = hText:node-value.
      584           if noderefName = "pref:AlcCode"
      585             then assign tt-wb-gds-EG.alc-code = hText:node-value.
      586           if noderefName = "pref:Capacity"     then assign tt-wb-gds-EG.ms-base = decimal(hText:node-value) .
      587           if noderefName = "pref:AlcVolume"    then assign tt-wb-gds-EG.proof = decimal(hText:node-value) .
      588           if noderefName = "pref:ProductVCode" then assign tt-wb-gds-EG.alc-type-code = hText:node-value .
      589           if noderefName = "wb:Identity"
      590           then do:
      591             assign
      592               tt-wb-gds-EG.Identity = hText:node-value
      593               tt-wb-gds-EG.nn = nn
      594             .
      595           end.
      596           if noderefName = "wb:Price"          then assign tt-wb-gds-EG.price = decimal(hText:node-value) .
      597           if noderefName = "wb:Quantity"       then assign tt-wb-gds-EG.qnty = decimal(hText:node-value) .
      598           if noderefName = "pref:UnitType"       then assign tt-wb-gds-EG.UnitType = hText:node-value .
      599         end.
      600         if available (tt-wb-gds-EG) and lookup (parentName, "pref:Importer") > 0 then do:
      601           if noderefName = "oref:ClientRegId" then assign tt-wb-gds-EG.regID-Importer = hText:node-value .
      602           tt-wb-gds-EG.importer-th = "".
      603           find first ub.ext-classif no-lock
      604             where ub.ext-classif.classif-subject = 'clients':U
      605               and ub.ext-classif.classif-name = 'clients-esys':U
      606               and ub.ext-classif.db-num = 0
      607               and ub.ext-classif.key#_one = ExtSys
      608               and ub.ext-classif.CharKey_Three = tt-wb-gds-EG.regID-Importer
      609               no-error.
      610           if available (ub.ext-classif) then do:
      611             tt-wb-gds-EG.importer-th = entry (2, ub.ext-classif.uniq-key-rec, chr(3)) + entry (3, ub.ext-classif.uniq-key-rec, chr(3)).
      612           end.
      613           if noderefName = "oref:ClientRegId" then do:
      614             assign entry (1, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      615             assign entry (5, tt-wb-gds-EG.importer-list, chr(5)) = "oref:address".
      616             assign entry (6, tt-wb-gds-EG.importer-list, chr(5)) = "oref:address".
      617           end.
      618           if noderefName = "oref:INN"         then assign entry (2, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      619           if noderefName = "oref:KPP"         then assign entry (3, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      620           if noderefName = "oref:FullName"    then assign entry (4, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      621         end.
      622         if available (tt-wb-gds-EG) and parentName = "oref:address" and (entry (5, tt-wb-gds-EG.importer-list, chr(5)) = "oref:address" or entry (6, tt-wb-gds-EG.importer-list, chr(5)) = "oref:address")
      623         then do:
      624           if noderefName = "oref:Country"     then assign entry (5, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      625           if noderefName = "oref:description" then assign entry (6, tt-wb-gds-EG.importer-list, chr(5)) = hText:node-value .
      626         end.
      627         if available (tt-wb-gds-EG) and
      628           (lookup (parentName, "pref:Producer") > 0 or lookup (parentNameOref, "pref:Producer") > 0)
      629         then do:
      630           if lookup (noderefName, "oref:UL,oref:FL,oref:FO,oref:TS") > 0
      631           then do:
      632             parentNameOref = parentName.
      633           end.
      634           case parentName:
      635             when "oref:UL"
      636               then entry (7, tt-wb-gds-EG.prod-list, chr(5)) = 'UL'.
      637             when "oref:FL"
      638               then entry (7, tt-wb-gds-EG.prod-list, chr(5)) = 'FL'.
      639             when "oref:FO"
      640               then entry (7, tt-wb-gds-EG.prod-list, chr(5)) = 'FO'.
      641             when "oref:TS"
      642               then entry (7, tt-wb-gds-EG.prod-list, chr(5)) = 'TS'.
      643           end case.
      644           if noderefName = "oref:ClientRegId" then assign tt-wb-gds-EG.regID-Producer = hText:node-value .
      645           tt-wb-gds-EG.producer-th = "".
      646           find first ub.ext-classif no-lock
      647             where ub.ext-classif.classif-subject = 'clients':U
      648               and ub.ext-classif.classif-name = 'clients-esys':U
      649               and ub.ext-classif.db-num = 0
      650               and ub.ext-classif.key#_one = ExtSys
      651               and ub.ext-classif.CharKey_Three = tt-wb-gds-EG.regID-Producer
      652               no-error.
      653           if available (ub.ext-classif) then do:
      654             tt-wb-gds-EG.producer-th = entry (2, ub.ext-classif.uniq-key-rec, chr(3)) + entry (3, ub.ext-classif.uniq-key-rec, chr(3)).
      655           end.
      656           if noderefName = "oref:ClientRegId"
      657           then do:
      658             assign entry (1, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      659             assign entry (5, tt-wb-gds-EG.prod-list, chr(5)) = "oref:address".
      660             assign entry (6, tt-wb-gds-EG.prod-list, chr(5)) = "oref:address".
      661           end.
      662           if noderefName = "oref:INN"         then assign entry (2, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      663           if noderefName = "oref:KPP"         then assign entry (3, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      664           if noderefName = "oref:FullName"    then assign entry (4, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      665           if noderefName = "oref:RegionCode"    then assign entry (8, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      666         end.
      667         if available (tt-wb-gds-EG) and parentName = "oref:address" and (entry (5, tt-wb-gds-EG.prod-list, chr(5)) = "oref:address" or entry (6, tt-wb-gds-EG.prod-list, chr(5)) = "oref:address")
      668         then do:
      669           if noderefName = "oref:Country"     then assign entry (5, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      670           if noderefName = "oref:description" then assign entry (6, tt-wb-gds-EG.prod-list, chr(5)) = hText:node-value .
      671         end.
      672         if lookup (parentName, "wb:InformA") > 0
      673           then
      674         do:
      675           if noderefName = "pref:RegId" then assign tt-wb-gds-EG.refA = hText:node-value.
      676         end.
      677         if lookup (parentName, "wb:InformF1") > 0
      678           then
      679         do:
      680           if noderefName = "pref:RegId" then assign tt-wb-gds-EG.refA = hText:node-value.
      681         end.
      682         if lookup (parentName, "pref:InformBItem") > 0
      683           then
      684         do:
      685           if noderefName = "pref:BRegId" then assign tt-wb-gds-EG.beforRefB = hText:node-value.
      686         end.
      687         if lookup (parentName, "pref:InformF2Item") > 0
      688           then
      689         do:
      690           if noderefName = "pref:F2RegId" then assign tt-wb-gds-EG.beforRefB = hText:node-value.
      691         end.
      692         if lookup (parentName, "wbr:Header") > 0
      693           then
      694         do:
      695           find first tt-wb-header no-error.
      696           if not available (tt-wb-header) then create tt-wb-header.
      697           if noderefName = "wbr:WBRegId" then assign tt-wb-header.wbregid = hText:node-value .
      698           if noderefName = "wbr:Identity" then assign tt-wb-header.Identity = hText:node-value .
      699         end.
      700         if lookup (parentName, "wbr:Position") > 0
      701           then
      702         do:
      703           if noderefName = "wbr:Identity" then
      704           do:
      705             find first tt-wb-gds-EG where tt-wb-gds-EG.Identity = hText:node-value no-error.
      706           end.
      707           if available (tt-wb-gds-EG) and (noderefName = "wbr:InformBRegId" or noderefName = "wbr:InformF2RegId") then assign tt-wb-gds-EG.refB = hText:node-value.
      708         end.
      709         if available (tt-wb-gds-EG) then do:
      710           if tt-wb-gds-EG.regID-Importer = ""
      711             then
      712             assign
      713               tt-wb-gds-EG.regID-i-p = tt-wb-gds-EG.regID-Producer
      714               tt-wb-gds-EG.i-p-th = tt-wb-gds-EG.producer-th
      715             .
      716             else
      717             assign
      718               tt-wb-gds-EG.regID-i-p = tt-wb-gds-EG.regID-Importer
      719               tt-wb-gds-EG.i-p-th = tt-wb-gds-EG.importer-th
      720             .
      721             find first ub.ext-classif no-lock
      722               where ub.ext-classif.classif-subject = 'clients':U
      723                 and ub.ext-classif.classif-name = 'clients-esys':U
      724                 and ub.ext-classif.db-num = 0
      725                 and ub.ext-classif.key#_one = ExtSys
      726                 and ub.ext-classif.CharKey_Three =  tt-wb-gds-EG.regID-i-p
      727                 no-error.
      728             if available (ub.ext-classif) then do:
      729               find first buf_clients where buf_clients.obj-type = entry (2, ub.ext-classif.uniq-key-rec, chr(3)) and buf_clients.obj-code = integer (entry (3, ub.ext-classif.uniq-key-rec, chr(3))) no-error.
      730               if available (buf_clients)
      731                 then tt-wb-gds-EG.i-p-name = buf_clients.obj-name.
      732             end.
      733         end.
      734         GetChildren(hNoderef, (level + 1)).
      735       end.
      736       delete object hNoderef.
      737       delete object hText.
      738     end.
      739   end class.
