      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148     define private buffer buf_clob-bind for ub.clob-bind.
      149     define private buffer buf_clob-data for ub.clob-data.
      150     define private buffer buf_clients   for ub.clients.
      151     define private variable inFileName     as character no-undo.
      152     define private variable nn             as integer   no-undo.
      153     define private variable parentNameOref as character no-undo.
      154     define property glog as logical no-undo
      155       get.
      156       set.
      157     define property FromFSRAR as character no-undo
      158       get.
      159       set.
      160     define property IsToClearTable as logical no-undo init true
      161       get.
      162       set.
      163     define property ExtSys as integer no-undo
      164       get.
      165       private set.
      166     constructor public ParserXMLDocWB (inExtSys as int):
      167       ExtSys = inExtSys.
