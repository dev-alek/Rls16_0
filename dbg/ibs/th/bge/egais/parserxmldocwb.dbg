       74       field gds-code      as integer label "Код товара в TH"
       75       field gds-name      as character label "Полное наименование" format "X(150)"
       76       field doc-qnty      as decimal label "Кол-во по док."
       77       field fact-qnty     as decimal label "Кол-во факт."
       78       field RealQuantity  as decimal label "Кол-во акт"
       79       field refB          as character label "Справка B" format "X(25)"
