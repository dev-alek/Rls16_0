        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ParserXMLDocWB:
        5     define temp-table tt-wb-header no-undo
        6       field wb-type-full as character label "Тип" format "X(10)"
        7       field num          as character label "№ пост."
        8       field wb-date      as date label "Дата"
        9       field shippingdate as date label "Дата поставки"
       10       field regID-Ship   as character format "X(21)" label "RegId контр."
       11       field NameShip     as character format "X(150)" label "Контрагент EGAIS"
       12       field regID-Cons   as character format "X(21)" label "Получатель EGAIS"
       13       field client       as character label "Контр. TH"
       14       field clientCons   as character label "Получ. TH"
       15       field cli-type     as character label "Тип клиента TH"
       16       field cli-code     as integer label "Код клиента TH"
       17       field obj-type     as character label "Тип клиента TH"
       18       field obj-code     as integer label "Код клиента TH"
       19       field ps           as character label "Примечание"
       20       field wbregid      as character format "X(21)" label "WBRegId"
       21       field Identity     as character label "ID EGAIS"
       22       field wb-type      as character label "Тип"
       23       field cargo-from   as character label  "Грузоотправитель"
       24       field uniq-key-rec as character
       25       field INNShip      as character label "ИНН контрагента"
       26       field KPPShip      as character label "КПП контрагента"
       27       field TransIdList  as character
       28       field UnitType     as character label "Тип единицы измерения"
       29       field verXSD       as character label "Версия XSD"
       30       index pi
       31       Identity
       32       .
       33     define temp-table tt-wb-gds-EG no-undo
       34       field gds-code       like ub.goods.gds-code label "Код товара в TH"
       35       field gds-name       like ub.goods.gds-name label "Полное наименование" format "X(150)"
       36       field alc-code       as character label "Алкогольный код" format "X(21)"
       37       field ms-base        like ub.goods.ms-base label "Объем" format ">>9.9<<"
       38       field alc-type-code  like ub.alc-type.alc-type-code label "Код АП"
       39       field proof          like ub.goods.proof label "Крепость" format ">9.9"
       40       field regID-i-p      as character format "X(21)" label "Импортер/Производитель"
       41       field i-p-name       as character label "Импортер/Производитель назв." format "X(150)"
       42       field i-p-th         as character label "Импортер/Производитель TH"
       43       field qnty           like ub.doc-line.doc-qnty label "Кол-во"
       44       field price          like ub.doc-line.price-rubl label "Цена"
       45       field refA           as character label "Справка A" format "X(25)"
       46       field refB           as character label "Справка B" format "X(25)"
       47       field beforRefB      as character label "Пред. справка B" format "X(25)"
       48       field Identity       as character label "ID EGAIS"
       49       field regID-Importer as character format "X(21)" label "Импортер"
       50       field importer-th    as character label "Импортер TH"
       51       field regID-Producer as character format "X(21)" label "Производитель"
       52       field Producer-th    as character label "Производитель TH"
       53       field nn             as integer label "№"
       54       field prod-list      as character format "x(1)"
       55       field importer-list  as character format "x(1)"
       56       field color-sts      as integer   format "99" init ?
       57       field UnitType       as character format "x(1)"
       58       index pi nn ascending
       59       index qntyIndex
       60       gds-code
       61       alc-code
       62       qnty
       63       .
       64     define temp-table tt-wb-act-header no-undo
