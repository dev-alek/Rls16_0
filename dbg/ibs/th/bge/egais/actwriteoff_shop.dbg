        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ActWriteOff_Shop inherits EGAISUTM:
        5   define temp-table tt-act-header
        6       field num           as character        label "№ акта"      format "X(30)"
        7       field date_         as date             label "Дата акта"
        8       field type_         as character        label "Основание списания" format "X(18)"
        9       field is-sent       as logical
       10       field answer_       as character        label "Ответ"       format "X(1500)"
       11       field RegID         as character        label "Рег. номер"  format "X(50)"
       12       index pi as primary unique
       13           num
       14   .
       15   define temp-table tt-gds-act
       16       field num           as character                label "№ акта"
       17       field position_     as integer                  label "№ пп"                    format ">>>9"
       18       field gds-code      like ub.goods.gds-code      label "Код товара   "
       19       field alc-code      as character                label "Алкогольный код"         format "X(21)"
       20       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
       21       field qnty          as decimal                  label "Количество"
       22       field marks-qnty    as integer                  label "Кол-во марок"
       23       field egais-name    as character
       24       index pi as primary unique
       25           position_
       26       index code
       27           gds-code
       28   .
       29   define   temp-table tt-marks
       30       field num                 as character            label "№ акта"
       31       field gds-part-position_  as integer
       32       field mark                as character            label "Марка"          format "X(100)"
       33       field new_                as logical
       34       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
       35       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
       36       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
       37       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
       38       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
       39       field flag                as logical              label "T"
       40       index pi as primary unique
       41           mark
       42   .
       43   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       44     define stream outstr.
       45     define private buffer buf_clob-bind for ub.clob-bind.
       46     define private buffer buf_clob-data for ub.clob-data.
       47     define private buffer buf_gds for ub.goods.
       48     define private buffer buf_trn-doc for ub.trn-doc.
       49     define private buffer buf_doc-attr for ub.doc-attr.
       50     define private buffer buf_doc-line for ub.doc-line.
       51     define private buffer buf_clients for ub.clients.
       52     define private buffer buf_ext-classif for ub.ext-classif.
       53     define private variable parameters     as character no-undo.
       54     define private variable inFileName     as character no-undo.
       55     define private variable inData         as character no-undo.
       56     define private variable outData        as character no-undo.
       57     define private variable cmd            as character no-undo.
       58     define private variable urlResp        as character no-undo.
       59     define private variable v-uniq-key-rec as character no-undo.
       60     define private variable v-Answer       as character no-undo.
       61     define private variable v-RegID        as character no-undo.
       62     define private variable ticket2        as logical   no-undo.
       63     define variable v-FS-RAR  as character no-undo .
       64     define variable ObjType   as character no-undo .
       65     define variable ObjCode   as integer   no-undo .
       66     define variable Obj       as character no-undo .
       67     define variable v-ext-sys as integer   no-undo .
       68     DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       69     define property inNum as character no-undo
       70       get.
       71       set.
       72     constructor public ActWriteOff_Shop (inOjType as char, inObjCode as int, inFSRAR as char, inExtSys as integer):
       73       super (inOjType, inObjCode).
       74       ObjCode = inObjCode.
       75       ObjType = inOjType.
       76       Obj = "*-" + substring(ObjType,1,1) + string(ObjCode) + "-*" .
       77       v-FS-RAR = inFSRAR.
       78       v-ext-sys = inExtSys.
       79       IsSent.
       80     end constructor.
       81     method public override handle GetHndlTable(inTableType as int, inAbIndenty as char) :
       82       define variable hRoot as handle  no-undo.
       83       define variable hDoc  as handle  no-undo.
       84       define variable ii    as integer no-undo.
       85       assign
       86         parameters = inNum
       87         StatusErr = false
       88         Msg       = ""
       89         .
       90       case inTableType:
       91         when 3 then
       92           do:
       93             empty temp-table tt-act-header.
       94             for each buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo_shop':U:
       95               if entry(1, buf_clob-bind.descr, chr(4)) matches Obj
       96               then .
       97               else next .
       98               create tt-act-header.
       99               assign
      100                   tt-act-header.num       = (entry (1, buf_clob-bind.descr, chr(4)))
      101                   tt-act-header.date_     = date (entry (2, buf_clob-bind.descr, chr(4)))
      102                   tt-act-header.type_     = (entry (3, buf_clob-bind.descr, chr(4)))
      103                   tt-act-header.is-sent   = logical (entry (4, buf_clob-bind.descr, chr(4)))
      104               .
      105               assign tt-act-header.answer_   = (entry (5, buf_clob-bind.descr, chr(4))) no-error .
      106               assign tt-act-header.RegID     = (entry (6, buf_clob-bind.descr, chr(4))) no-error .
      107               end.
      108             return buffer tt-act-header:handle.
      109           end.
      110         when 2 then
      111         do :
      112           v-Answer = "" .
      113           v-RegID = "" .
      114           create x-document hDoc.
      115           create x-noderef  hRoot.
      116           ReplyID = "" .
      117           IsSent.
      118           if ReplyID = "" or ReplyID = ?
      119           then do:
      120             StatusErr = true.
      121             Msg = "Не найден запрос в журнале запросов или код запроса пуст".
      122             return ?.
      123           end.
      124           if ConPar = "" or ConPar = ?
      125           then do:
      126             StatusErr = true.
      127             Msg = "Не заданы настройки соединения для EGAIS".
      128             return ?.
      129           end.
      130           ticket2 = false .
      131           GetSubjectOfRequestUTM().
      132           if StatusErr
      133             then return ?.
      134           file-info:file-name = search (inFileName).
      135           if search (inFileName) = ? or file-info:file-size = 0
      136           then do:
      137             assign
      138               StatusErr = true
      139               Msg = "Не удалось получить данные от UTM"
      140             .
      141             return ?.
      142           end.
      143           if not WriteDbStatus ( 4, parameters , ReplyId, true )
      144           then do:
      145             assign
      146               StatusErr = true
      147               Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      148             .
      149             undo, return ?.
      150           end.
      151           hDoc:load ("file", inFileName, false).
      152           hDoc:get-document-element(hRoot) .
      153           GetChildren(hRoot, 1).
      154           DELETE OBJECT hDoc no-error.
      155           DELETE OBJECT hRoot no-error.
      156           ticket2 = true .
      157           if num-entries(urlResp, chr(4)) = 2 then do :
      158               create x-document hDoc.
      159               create x-noderef  hRoot.
      160               GetSubjectOfRequestUTM().
      161               if StatusErr
      162                 then return ?.
      163               file-info:file-name = search (inFileName).
      164               if search (inFileName) = ? or file-info:file-size = 0
      165               then do:
      166                 assign
      167                   StatusErr = true
      168                   Msg = "Не удалось получить данные от UTM"
      169                 .
      170                 return ?.
      171               end.
      172               hDoc:load ("file", inFileName, false).
      173               hDoc:get-document-element(hRoot) .
      174               GetChildren(hRoot, 1).
      175               DELETE OBJECT hDoc no-error.
      176               DELETE OBJECT hRoot no-error.
      177           end.
      178           find last buf_clob-bind exclusive-lock where buf_clob-bind.field-name_ = 'egais-awo_shop':U and buf_clob-bind.uniq-key-rec = inAbIndenty .
      179           if num-entries (buf_clob-bind.descr, chr(4)) = 4 then
      180               assign buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-Answer + chr(4) + v-RegID .
      181           else if num-entries (buf_clob-bind.descr, chr(4)) = 5 then
      182               assign entry(5, buf_clob-bind.descr, chr(4)) = v-Answer
      183                      buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-RegID .
      184           else if num-entries (buf_clob-bind.descr, chr(4)) = 6 then
      185               assign entry(5, buf_clob-bind.descr, chr(4)) = v-Answer
      186                      entry(6, buf_clob-bind.descr, chr(4)) = v-RegID .
      187           release buf_clob-bind .
      188           find first tt-act-header where tt-act-header.num = inAbIndenty .
      189           assign tt-act-header.answer_ = v-Answer
      190                  tt-act-header.RegID   = v-RegID .
      191           return buffer tt-act-header:handle.
      192         end.
      193       end case.
      194     end.
      195     method override public logical SendRequestUTM ():
      196       def var ii        as int    no-undo.
      197       def var xml-cont  as char   no-undo.
      198       def var respValue as handle no-undo.
      199       assign
      200         parameters = inNum
      201         StatusErr = false
      202         Msg       = ""
      203         .
      204       IsSent.
      205       do trans:
      206         os-delete "RespActWriteOff_shop0.xml".
      207         assign
      208           inFileName = "RespActWriteOff_shop0.xml"
      209           .
      210         find first tt-act-header where tt-act-header.num = inNum no-error.
      211         if available (tt-act-header)
      212           then
      213         do:
      214             cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/ActWriteOffShop_v2 >&4", search ("exe/curl.exe"), search ("ActWriteOff_shop.xml"), ConPar, inFileName, TimeOut).
      215             os-command silent value (cmd).
      216             file-info:file-name = search (inFileName).
      217             if search (inFileName) <> ? and file-info:file-size > 0
      218               then
      219             do:
      220               respValue = ParseRequest (inFileName).
      221               if respValue = ?
      222                 then
      223               do:
      224                 assign
      225                   StatusErr = true
      226                   Msg       = "Не удалось разобрать данные от UTM"
      227                   .
      228                 undo, return false.
      229               end.
      230               if not StatusErr
      231                 then
      232                 ReplyId = respValue:node-value.
      233               else
      234               do:
      235                 assign
      236                   StatusErr = true
      237                   Msg       = respValue:node-value
      238                   .
      239                 undo, return false.
      240               end.
      241             end.
      242             else
      243             do:
      244               assign
      245                 StatusErr = true
      246                 Msg       = "Не удалось отправить акт о списании в UTM"
      247                 .
      248               undo, return false.
      249             end.
      250             if not WriteDbStatus (4, parameters , ReplyId, false)
      251             then do:
      252               assign
      253                 StatusErr = true
      254                 Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      255               .
      256               undo, return false.
      257             end.
      258         end.
      259       end.
      260     end.
      261     method override protected logical GetIsSent ():
      262       find last ub.esys-all-attr no-lock
      263                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      264                   and ub.esys-all-attr.attr-code = "egais"
      265                   and ub.esys-all-attr.key2       = 4
      266                   and ub.esys-all-attr.attr-value = parameters
      267                   no-error.
      268       if available (ub.esys-all-attr )
      269       then do:
      270         ReplyId = ub.esys-all-attr.key7.
      271         return true.
      272       end.
      273       return false.
      274     end.
      275     method protected handle ParseRequest (inFileName as char):
      276       define variable hRoot as handle  no-undo.
      277       define variable hDoc  as handle  no-undo.
      278       define variable hRow  as handle  no-undo.
      279       define variable hText as handle  no-undo.
      280       define variable ii    as integer no-undo.
      281       create x-document hDoc.
      282       create x-noderef  hRoot.
      283       create x-noderef  hRow.
      284       create x-noderef htext .
      285       hDoc:load ("file", inFileName, false).
      286       hDoc:encoding = "UTF-8".
      287       hDoc:get-document-element(hRoot) .
      288       do ii = 1 to hRoot:num-children:
      289         hRoot:get-child(hRow,ii).
      290         case hRow:name:
      291           when "url" then
      292             do:
      293               hRow:get-child (hText, 1) no-error.
      294               return hText.
      295             end.
      296           when "error" then
      297             do:
      298               hRow:get-child (hText, 1) no-error.
      299               StatusErr = true.
      300               return hText.
      301             end.
      302           otherwise
      303             do:
      304               return ?.
      305             end.
      306         end case.
      307       end.
      308     end.
      309     method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
      310           DEFINE VARIABLE i AS INTEGER NO-UNDO.
      311           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      312           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      313           define variable v-ok as logical no-undo .
      314           CREATE X-NODEREF hNoderef.
      315           CREATE X-NODEREF hText .
      316           REPEAT i = 1 TO hParent:NUM-CHILDREN:
      317               good = hParent:GET-CHILD(hNoderef,i).
      318               IF NOT good THEN
      319                   LEAVE.
      320               IF hNoderef:SUBTYPE <> "element" THEN
      321                   NEXT.
      322               hNoderef:GET-CHILD(hText, 1) no-error .
      323               IF hNoderef:NAME = "tc:RegID"    THEN do :
      324                   v-RegID  = hText:node-value no-error.
      325                   if v-RegID = ? then v-RegID = "" .
      326               end.
      327               IF hNoderef:NAME = "tc:Conclusion"
      328               OR hNoderef:NAME = "tc:OperationResult" THEN
      329               DO :
      330                   if hText:node-value = "Rejected" then v-RegID = v-RegID + CHR(5) + "R" .
      331                   if hText:node-value = "Accepted" then v-RegID = v-RegID + CHR(5) + "A" .
      332               END.
      333               IF hNoderef:NAME = "tc:Comments" THEN do :
      334                   if trim(v-Answer) = '' or v-Answer = chr(10) then v-Answer = hText:node-value .
      335                   else v-Answer = v-Answer + chr(10) + hText:node-value .
      336               end.
      337               IF hNoderef:NAME = "tc:OperationResult" THEN v-ok = (hText:node-value = "Accepted") .
      338               IF hNoderef:NAME = "tc:OperationComment"  THEN v-Answer = v-Answer + chr(10) + hText:node-value .
      339               GetChildren(hNoderef, (level + 1)).
      340           END.
      341           DELETE OBJECT hNoderef.
      342           DELETE OBJECT hText.
      343     END.
      344     method public override character GetSubjectOfRequestUTM() :
      345       define variable response as character no-undo .
      346       if not ticket2 then do :
      347           urlResp = GetURLUTM(ReplyId).
      348       end.
      349       if StatusErr and Msg <> "" and Msg <> ? then return ? .
      350       if urlResp = "" or urlResp = ?
      351       then do:
      352         StatusErr = true.
      353         Msg = "Еще не получен ответ от сервера EGAIS по запросу " + ReplyId + chr(10) + "Либо ответ уже автоматически удалён".
      354         return ?.
      355       end.
      356       if not ticket2 then do :
      357           os-delete "RespActWriteOff_shop.xml".
      358           assign
      359             inFileName = "RespActWriteOff_shop.xml"
      360             response = entry(1,urlResp,chr(4))
      361           .
      362       end.
      363       else do :
      364           os-delete "RespActWriteOff_shop2.xml".
      365           assign
      366             inFileName = "RespActWriteOff_shop2.xml"
      367           .
      368           response = entry(2,urlResp,chr(4)) no-error .
      369       end.
      370       if trim(response) <> "" then do :
      371           cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, response, inFileName).
      372           os-command silent value (cmd).
      373       end.
      374     end.
      375     method protected override character GetURLUTM (inReplyId as char):
      376       define variable hRoot as handle  no-undo.
      377       define variable hDoc  as handle  no-undo.
      378       define variable hRow  as handle  no-undo.
      379       define variable hText as handle  no-undo.
      380       define variable ii    as integer no-undo.
      381       define variable files as character no-undo.
      382       create x-document hDoc.
      383       create x-noderef  hRoot.
      384       create x-noderef  hRow.
      385       create x-noderef  hText.
      386       assign
      387         inFileName = "ReceiptListOfQuery.xml"
      388       .
      389       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      390       if search (inFileName) <> ? then os-delete value (inFileName).
      391       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      392       os-command silent value (cmd).
      393       file-info:file-name = search (inFileName).
      394       if search (inFileName) = ? or file-info:file-size = 0
      395       then do:
      396         assign
      397           StatusErr = true
      398           Msg = "Не удалось получить данные от UTM"
      399         .
      400         return ?.
      401       end.
      402       hDoc:load ("file", inFileName, false).
      403       hDoc:get-document-element(hRoot) .
      404       do ii = 1 to hRoot:num-children:
      405         hRoot:get-child(hRow,ii).
      406         case hRow:name:
      407           when "url" then
      408             do:
      409               if hRow:get-attribute("replyId") = ReplyId
      410               then do:
      411                 hRow:get-child (hText, 1) no-error.
      412                 files = files + chr(4) + hText:node-value.
      413               end.
      414             end.
      415         end case.
      416       end.
      417       files = trim(files, chr(4)) .
      418       return files .
      419     end.
      420   end class.
