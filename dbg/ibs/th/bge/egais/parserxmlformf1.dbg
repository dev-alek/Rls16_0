        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.egais.ParserXMLFormF1 inherits EGAISUTM:
        6     define         variable v-FS-RAR     as character no-undo .
        7     define private variable listManagObj as class     listmanager.
        8     define variable extFormF1ValueObj as class   ExtFormF1Value no-undo.
        9     define temp-table tt-gds-EG no-undo
       10       field formF1code as character label "Код справки 1"
       11       field extFormF1ValueObj as class Progress.Lang.Object
       12       index pi as primary
       13       formF1code
       14       .
       15     define variable hDoc        as handle    no-undo.
       16     define variable hRoot       as handle    no-undo.
       17     define variable good        as logical   no-undo.
       18     define variable v-save-info as character no-undo .
       19     define variable v-OrgCli    as logical .
       20     constructor public ParserXMLFormF1 (inOjType as char, inObjCode as int):
       21       super (inOjType, inObjCode).
       22       listManagObj = new listmanager ().
       23     end constructor.
       24     method override handle ParseResponse(inFileName as char):
       25       for each tt-gds-EG:
       26         if valid-object (tt-gds-EG.extFormF1ValueObj)
       27           then delete object tt-gds-EG.extFormF1ValueObj.
       28       end.
       29       empty temp-table tt-gds-EG .
       30       create x-document hDoc.
       31       create x-noderef hRoot.
       32       hDoc:load("file",inFileName,false).
       33       hDoc:get-document-element(hRoot).
       34       GetChildren(hRoot, 1).
       35       delete object hDoc.
       36       delete object hRoot.
       37       return buffer tt-gds-EG:handle.
       38     end.
       39     method private void GetChildren(hParent as handle, level as integer):
       40       define variable i                 as integer no-undo.
       41       define variable hNoderef          as handle  no-undo.
       42       define variable hText             as handle  no-undo.
       43       create x-noderef hNoderef.
       44       create x-noderef hText .
       45       repeat i = 1 to hParent:num-children:
       46         good = hParent:get-child(hNoderef,i).
       47         if not good then
       48           leave.
       49         if hNoderef:subtype <> "element" then
       50           next.
       51         hNoderef:get-child(hText, 1) no-error .
       52         if hNoderef:name = "ns:FSRAR_ID" then
       53           assign v-FS-RAR = hText:node-value .
       54         if hNoderef:name = "rfa:InformF1RegId" then
       55         do:
       56           create tt-gds-EG .
       57           extFormF1ValueObj = new ExtFormF1Value().
       58           tt-gds-EG.extFormF1ValueObj = cast (extFormF1ValueObj, Progress.Lang.Object).
       59           extFormF1ValueObj:FormF1Code = htext:node-value.
       60           tt-gds-EG.formF1code = htext:node-value.
       61         end.
       62         if hNoderef:name = "rfa:Product" then
       63         do:
       64           v-OrgCli = false.
       65         end.
       66         if hNoderef:name = "rfa:OriginalClient" then
       67         do:
       68           v-OrgCli = true.
       69         end.
       70         if v-OrgCli then
       71         do:
       72           if hNoderef:name = "oref:UL"
       73             or hNoderef:name = "oref:FL"
       74             or hNoderef:name = "oref:FO"
       75             or hNoderef:name = "oref:TS"
       76             then
       77           do :
       78            extFormF1ValueObj:CliEgaisTypeOrigCli = entry(2, hNoderef:name, ":") .
       79           end.
       80           if hnoderef:name = "oref:ClientRegId" then extFormF1ValueObj:CliRegIdOrigCli = htext:node-value.
       81           if hnoderef:name = "oref:INN" then extFormF1ValueObj:INNOrigCli = htext:node-value.
       82           if hnoderef:name = "oref:KPP" then extFormF1ValueObj:KPPOrigCli = htext:node-value.
       83           if hnoderef:name = "oref:FullName" then extFormF1ValueObj:FullNameOrigCli = htext:node-value.
       84           if hnoderef:name = "oref:Country" then extFormF1ValueObj:CountryOrigCli = htext:node-value.
       85           if hnoderef:name = "oref:RegionCode" then extFormF1ValueObj:RegionOrigCli = htext:node-value.
       86           if hnoderef:name = "oref:description" then extFormF1ValueObj:DescrOrigCli = htext:node-value.
       87         end.
       88         if hnoderef:name = "rfa:BottlingDate" then extFormF1ValueObj:BottlingDate = htext:node-value.
       89         GetChildren(hNoderef, (level + 1)).
       90       end.
       91       delete object hNoderef.
       92       delete object hText.
       93     end.
       94     destructor public ParserXMLFormF1 ( ):
       95       if valid-object (listManagObj)
       96         then delete object listManagObj.
       97       for each tt-gds-EG:
       98         if valid-object (tt-gds-EG.extFormF1ValueObj)
       99           then delete object tt-gds-EG.extFormF1ValueObj.
      100       end.
      101     end destructor.
      102   end class.
