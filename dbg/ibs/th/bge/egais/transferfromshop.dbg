        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.TransferFromShop inherits EGAISUTM:
        5   define temp-table tt-act-header
        6       field num           as character        label "№ акта"      format "X(30)"
        7       field date_         as date             label "Дата акта"
        8       field is-sent       as logical
        9       field answer_       as character        label "Ответ"       format "X(1500)"
       10       field RegID         as character        label "Рег. номер"  format "X(50)"
       11       index pi as primary unique
       12           num
       13   .
       14   define temp-table tt-gds-act
       15       field num           as character                label "№ акта"
       16       field position_     as integer                  label "№ пп"                    format ">>>9"
       17       field gds-code      like ub.goods.gds-code      label "Код товара   "
       18       field alc-code      as character                label "Алкогольный код"         format "X(21)"
       19       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
       20       field qnty          as decimal                  label "Количество"
       21       field inform-B      as character                label "Справка Б"               format "X(20)"
       22       index pi as primary unique
       23           position_
       24       index code
       25           gds-code
       26   .
       27   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       28     define stream outstr.
       29     define private buffer buf_clob-bind for ub.clob-bind.
       30     define private buffer buf_clob-data for ub.clob-data.
       31     define private buffer buf_gds for ub.goods.
       32     define private buffer buf_trn-doc for ub.trn-doc.
       33     define private buffer buf_doc-attr for ub.doc-attr.
       34     define private buffer buf_doc-line for ub.doc-line.
       35     define private buffer buf_clients for ub.clients.
       36     define private buffer buf_ext-classif for ub.ext-classif.
       37     define private variable parameters     as character no-undo.
       38     define private variable inFileName     as character no-undo.
       39     define private variable inData         as character no-undo.
       40     define private variable outData        as character no-undo.
       41     define private variable cmd            as character no-undo.
       42     define private variable urlResp        as character no-undo.
       43     define private variable v-uniq-key-rec as character no-undo.
       44     define private variable v-Answer       as character no-undo.
       45     define private variable v-RegID        as character no-undo.
       46     define private variable ticket2        as logical   no-undo.
       47     define variable v-FS-RAR  as character no-undo .
       48     define variable ObjType   as character no-undo .
       49     define variable ObjCode   as integer   no-undo .
       50     define variable Obj       as character no-undo .
       51     define variable v-ext-sys as integer   no-undo .
       52     DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       53     define property inNum as character no-undo
       54       get.
       55       set.
       56     constructor public TransferFromShop (inOjType as char, inObjCode as int, inFSRAR as char, inExtSys as integer):
       57       super (inOjType, inObjCode).
       58       ObjCode = inObjCode.
       59       ObjType = inOjType.
       60       Obj = "*-" + substring(ObjType,1,1) + string(ObjCode) + "-*" .
       61       v-FS-RAR = inFSRAR.
       62       v-ext-sys = inExtSys.
       63       IsSent.
       64     end constructor.
       65     method public override handle GetHndlTable(inTableType as int, inAbIndenty as char) :
       66       define variable hRoot as handle  no-undo.
       67       define variable hDoc  as handle  no-undo.
       68       define variable ii    as integer no-undo.
       69       assign
       70         parameters = inNum
       71         StatusErr = false
       72         Msg       = ""
       73         .
       74       case inTableType:
       75         when 3 then
       76           do:
       77             empty temp-table tt-act-header.
       78             for each buf_clob-bind where buf_clob-bind.field-name_ = 'egais-tfs':U:
       79               if entry(1, buf_clob-bind.descr, chr(4)) matches Obj
       80               then .
       81               else next .
       82               create tt-act-header.
       83               assign
       84                   tt-act-header.num       = (entry (1, buf_clob-bind.descr, chr(4)))
       85                   tt-act-header.date_     = date (entry (2, buf_clob-bind.descr, chr(4)))
       86                   tt-act-header.is-sent   = logical (entry (3, buf_clob-bind.descr, chr(4)))
       87               .
       88               assign tt-act-header.answer_   = (entry (4, buf_clob-bind.descr, chr(4))) no-error .
       89                           assign tt-act-header.RegID     = (entry (5, buf_clob-bind.descr, chr(4))) no-error .
       90               end.
       91             return buffer tt-act-header:handle.
       92           end.
       93         when 2 then
       94         do :
       95                   v-Answer = "" .
       96           v-RegID = "" .
       97           create x-document hDoc.
       98           create x-noderef  hRoot.
       99           ReplyID = "" .
      100           IsSent.
      101           if ReplyID = "" or ReplyID = ?
      102           then do:
      103             StatusErr = true.
      104             Msg = "Не найден запрос в журнале запросов или код запроса пуст".
      105             return ?.
      106           end.
      107           if ConPar = "" or ConPar = ?
      108           then do:
      109             StatusErr = true.
      110             Msg = "Не заданы настройки соединения для EGAIS".
      111             return ?.
      112           end.
      113           ticket2 = false .
      114           GetSubjectOfRequestUTM().
      115           if StatusErr
      116             then return ?.
      117           file-info:file-name = search (inFileName).
      118           if search (inFileName) = ? or file-info:file-size = 0
      119           then do:
      120             assign
      121               StatusErr = true
      122               Msg = "Не удалось получить данные от UTM"
      123             .
      124             return ?.
      125           end.
      126           if not WriteDbStatus ( 4, parameters , ReplyId, true )
      127           then do:
      128             assign
      129               StatusErr = true
      130               Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      131             .
      132             undo, return ?.
      133           end.
      134           hDoc:load ("file", inFileName, false).
      135           hDoc:get-document-element(hRoot) .
      136           GetChildren(hRoot, 1).
      137           DELETE OBJECT hDoc no-error.
      138           DELETE OBJECT hRoot no-error.
      139           ticket2 = true .
      140           if num-entries(urlResp, chr(4)) = 2 then do :
      141               create x-document hDoc.
      142               create x-noderef  hRoot.
      143               GetSubjectOfRequestUTM().
      144               if StatusErr
      145                 then return ?.
      146               file-info:file-name = search (inFileName).
      147               if search (inFileName) = ? or file-info:file-size = 0
      148               then do:
      149                 assign
      150                   StatusErr = true
      151                   Msg = "Не удалось получить данные от UTM"
      152                 .
      153                 return ?.
      154               end.
      155               hDoc:load ("file", inFileName, false).
      156               hDoc:get-document-element(hRoot) .
      157               GetChildren(hRoot, 1).
      158               DELETE OBJECT hDoc no-error.
      159               DELETE OBJECT hRoot no-error.
      160           end.
      161           find last buf_clob-bind exclusive-lock where buf_clob-bind.field-name_ = 'egais-tfs':U and buf_clob-bind.uniq-key-rec = inAbIndenty .
      162           if num-entries (buf_clob-bind.descr, chr(4)) = 3 then
      163               assign buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-Answer + chr(4) + v-RegID .
      164           else if num-entries (buf_clob-bind.descr, chr(4)) = 4 then
      165               assign entry(4, buf_clob-bind.descr, chr(4)) = v-Answer
      166                                      buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-RegID .
      167                   else if num-entries (buf_clob-bind.descr, chr(4)) = 5 then
      168               assign entry(4, buf_clob-bind.descr, chr(4)) = v-Answer
      169                                      entry(5, buf_clob-bind.descr, chr(4)) = v-RegID .
      170           release buf_clob-bind .
      171           find first tt-act-header where tt-act-header.num = inAbIndenty .
      172           assign tt-act-header.answer_ = v-Answer
      173                  tt-act-header.RegID   = v-RegID .
      174           return buffer tt-act-header:handle.
      175         end.
      176       end case.
      177     end.
      178     method override public logical SendRequestUTM ():
      179       def var ii        as int    no-undo.
      180       def var xml-cont  as char   no-undo.
      181       def var respValue as handle no-undo.
      182       assign
      183         parameters = inNum
      184         StatusErr = false
      185         Msg       = ""
      186         .
      187       IsSent.
      188       do trans:
      189         os-delete "RespTransferFromShop0.xml".
      190         assign
      191           inFileName = "RespTransferFromShop0.xml"
      192           .
      193         find first tt-act-header where tt-act-header.num = inNum no-error.
      194         if available (tt-act-header)
      195           then
      196         do:
      197             cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/TransferFromShop >&4", search ("exe/curl.exe"), search ("TransferFromShop.xml"), ConPar, inFileName, TimeOut).
      198             os-command silent value (cmd).
      199             file-info:file-name = search (inFileName).
      200             if search (inFileName) <> ? and file-info:file-size > 0
      201               then
      202             do:
      203               respValue = ParseRequest (inFileName).
      204               if respValue = ?
      205                 then
      206               do:
      207                 assign
      208                   StatusErr = true
      209                   Msg       = "Не удалось разобрать данные от UTM"
      210                   .
      211                 undo, return false.
      212               end.
      213               if not StatusErr
      214                 then
      215                 ReplyId = respValue:node-value.
      216               else
      217               do:
      218                 assign
      219                   StatusErr = true
      220                   Msg       = respValue:node-value
      221                   .
      222                 undo, return false.
      223               end.
      224             end.
      225             else
      226             do:
      227               assign
      228                 StatusErr = true
      229                 Msg       = "Не удалось отправить акт о возврате продукции на склад в UTM"
      230                 .
      231               undo, return false.
      232             end.
      233             if not WriteDbStatus (4, parameters , ReplyId, false)
      234             then do:
      235               assign
      236                 StatusErr = true
      237                 Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      238               .
      239               undo, return false.
      240             end.
      241         end.
      242       end.
      243     end.
      244     method override protected logical GetIsSent ():
      245       find last ub.esys-all-attr no-lock
      246                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      247                   and ub.esys-all-attr.attr-code = "egais"
      248                   and ub.esys-all-attr.key2       = 4
      249                   and ub.esys-all-attr.attr-value = parameters
      250                   no-error.
      251       if available (ub.esys-all-attr )
      252       then do:
      253         ReplyId = ub.esys-all-attr.key7.
      254         return true.
      255       end.
      256       return false.
      257     end.
      258     method protected handle ParseRequest (inFileName as char):
      259       define variable hRoot as handle  no-undo.
      260       define variable hDoc  as handle  no-undo.
      261       define variable hRow  as handle  no-undo.
      262       define variable hText as handle  no-undo.
      263       define variable ii    as integer no-undo.
      264       create x-document hDoc.
      265       create x-noderef  hRoot.
      266       create x-noderef  hRow.
      267       create x-noderef htext .
      268       hDoc:load ("file", inFileName, false).
      269       hDoc:encoding = "UTF-8".
      270       hDoc:get-document-element(hRoot) .
      271       do ii = 1 to hRoot:num-children:
      272         hRoot:get-child(hRow,ii).
      273         case hRow:name:
      274           when "url" then
      275             do:
      276               hRow:get-child (hText, 1) no-error.
      277               return hText.
      278             end.
      279           when "error" then
      280             do:
      281               hRow:get-child (hText, 1) no-error.
      282               StatusErr = true.
      283               return hText.
      284             end.
      285           otherwise
      286             do:
      287               return ?.
      288             end.
      289         end case.
      290       end.
      291     end.
      292     method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
      293           DEFINE VARIABLE i AS INTEGER NO-UNDO.
      294           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      295           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      296           define variable v-ok as logical no-undo .
      297           CREATE X-NODEREF hNoderef.
      298           CREATE X-NODEREF hText .
      299           REPEAT i = 1 TO hParent:NUM-CHILDREN:
      300               good = hParent:GET-CHILD(hNoderef,i).
      301               IF NOT good THEN
      302                   LEAVE.
      303               IF hNoderef:SUBTYPE <> "element" THEN
      304                   NEXT.
      305               hNoderef:GET-CHILD(hText, 1) no-error .
      306               IF hNoderef:NAME = "tc:RegID"    THEN do :
      307                   v-RegID  = hText:node-value no-error.
      308                   if v-RegID = ? then v-RegID = "" .
      309               end.
      310               IF hNoderef:NAME = "tc:Conclusion"
      311               OR hNoderef:NAME = "tc:OperationResult" THEN
      312               DO :
      313                   if hText:node-value = "Rejected" then v-RegID = v-RegID + CHR(5) + "R" .
      314                   if hText:node-value = "Accepted" then v-RegID = v-RegID + CHR(5) + "A" .
      315               END.
      316               IF hNoderef:NAME = "tc:Comments" THEN do :
      317                   if trim(v-Answer) = '' or v-Answer = chr(10) then v-Answer = hText:node-value .
      318                   else v-Answer = v-Answer + chr(10) + hText:node-value .
      319               end.
      320               IF hNoderef:NAME = "tc:OperationResult" THEN v-ok = (hText:node-value = "Accepted") .
      321               IF hNoderef:NAME = "tc:OperationComment" THEN v-Answer = v-Answer + chr(10) + hText:node-value .
      322               GetChildren(hNoderef, (level + 1)).
      323           END.
      324           DELETE OBJECT hNoderef.
      325           DELETE OBJECT hText.
      326     END.
      327     method public override character GetSubjectOfRequestUTM() :
      328       define variable response as character no-undo .
      329       if not ticket2 then do :
      330           urlResp = GetURLUTM(ReplyId).
      331       end.
      332       if StatusErr and Msg <> "" and Msg <> ? then return ? .
      333       if urlResp = "" or urlResp = ?
      334       then do:
      335         StatusErr = true.
      336         Msg = "Еще не получен ответ от сервера EGAIS по запросу " + ReplyId + chr(10) + "Либо ответ уже автоматически удалён".
      337         return ?.
      338       end.
      339       if not ticket2 then do :
      340           os-delete "RespTransferFromShop.xml".
      341           assign
      342             inFileName = "RespTransferFromShop.xml"
      343             response = entry(1,urlResp,chr(4))
      344           .
      345       end.
      346       else do :
      347           os-delete "RespTransferFromShop2.xml".
      348           assign
      349             inFileName = "RespTransferFromShop2.xml"
      350           .
      351           response = entry(2,urlResp,chr(4)) no-error .
      352       end.
      353       if trim(response) <> "" then do :
      354           cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, response, inFileName).
      355           os-command silent value (cmd).
      356       end.
      357     end.
      358     method protected override character GetURLUTM (inReplyId as char):
      359       define variable hRoot as handle  no-undo.
      360       define variable hDoc  as handle  no-undo.
      361       define variable hRow  as handle  no-undo.
      362       define variable hText as handle  no-undo.
      363       define variable ii    as integer no-undo.
      364       define variable files as character no-undo.
      365       create x-document hDoc.
      366       create x-noderef  hRoot.
      367       create x-noderef  hRow.
      368       create x-noderef  hText.
      369       assign
      370         inFileName = "ReceiptListOfQuery.xml"
      371       .
      372       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      373       if search (inFileName) <> ? then os-delete value (inFileName).
      374       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      375       os-command silent value (cmd).
      376       file-info:file-name = search (inFileName).
      377       if search (inFileName) = ? or file-info:file-size = 0
      378       then do:
      379         assign
      380           StatusErr = true
      381           Msg = "Не удалось получить данные от UTM"
      382         .
      383         return ?.
      384       end.
      385       hDoc:load ("file", inFileName, false).
      386       hDoc:get-document-element(hRoot) .
      387       do ii = 1 to hRoot:num-children:
      388         hRoot:get-child(hRow,ii).
      389         case hRow:name:
      390           when "url" then
      391             do:
      392               if hRow:get-attribute("replyId") = ReplyId
      393               then do:
      394                 hRow:get-child (hText, 1) no-error.
      395                 files = files + chr(4) + hText:node-value.
      396               end.
      397             end.
      398         end case.
      399       end.
      400       files = trim(files, chr(4)) .
      401       return files .
      402     end.
      403   end class.
