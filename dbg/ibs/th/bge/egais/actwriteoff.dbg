        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ActWriteOff inherits EGAISUTM:
        5   define temp-table tt-act-header
        6       field num           as character        label "№ акта"      format "X(30)"
        7       field date_         as date             label "Дата акта"
        8       field type_         as character        label "Основание списания" format "X(18)"
        9       field is-sent       as logical
       10       field answer_       as character        label "Ответ"       format "X(1500)"
       11       field RegID         as character        label "Рег. номер"  format "X(50)"
       12       index pi as primary unique
       13           num
       14   .
       15   define temp-table tt-gds-act
       16       field num           as character                label "№ акта"
       17       field position_     as integer                  label "№ пп"                    format ">>>9"
       18       field gds-code      like ub.goods.gds-code      label "Код товара   "
       19       field alc-code      as character                label "Алкогольный код"         format "X(21)"
       20       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
       21       field qnty          as decimal                  label "Количество"
       22       field inform-B      as character                label "Справка Б"               format "X(20)"
       23       field marks-qnty    as integer                  label "Кол-во марок"
       24       field egais-name    as character
       25       index pi as primary unique
       26           num position_
       27       index code
       28           gds-code
       29   .
       30   define   temp-table tt-marks
       31       field num                 as character            label "№ акта"
       32       field gds-part-position_  as integer
       33       field mark                as character            label "Марка"          format "X(100)"
       34       field new_                as logical
       35       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
       36       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
       37       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
       38       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
       39       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
       40       field flag                as logical              label "T"
       41       index pi as primary unique
       42           mark
       43   .
       44   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       45     define stream outstr.
       46     define private buffer buf_clob-bind for ub.clob-bind.
       47     define private buffer buf_clob-data for ub.clob-data.
       48     define private buffer buf_gds for ub.goods.
       49     define private buffer buf_trn-doc for ub.trn-doc.
       50     define private buffer buf_doc-attr for ub.doc-attr.
       51     define private buffer buf_doc-line for ub.doc-line.
       52     define private buffer buf_clients for ub.clients.
       53     define private buffer buf_ext-classif for ub.ext-classif.
       54     define private variable parameters     as character no-undo.
       55     define private variable inFileName     as character no-undo.
       56     define private variable inData         as character no-undo.
       57     define private variable outData        as character no-undo.
       58     define private variable cmd            as character no-undo.
       59     define private variable urlResp        as character no-undo.
       60     define private variable v-uniq-key-rec as character no-undo.
       61     define private variable v-Answer       as character no-undo.
       62     define private variable v-RegID        as character no-undo.
       63     define private variable ticket2        as logical   no-undo.
       64     define variable v-FS-RAR  as character no-undo .
       65     define variable ObjType   as character no-undo .
       66     define variable ObjCode   as integer   no-undo .
       67     define variable Obj       as character no-undo .
       68     define variable v-ext-sys as integer   no-undo .
       69     DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       70     define property inNum as character no-undo
       71       get.
       72       set.
       73     constructor public ActWriteOff (inOjType as char, inObjCode as int, inFSRAR as char, inExtSys as integer):
       74       super (inOjType, inObjCode).
       75       ObjCode = inObjCode.
       76       ObjType = inOjType.
       77       Obj = "*-" + substring(ObjType,1,1) + string(ObjCode) + "-*" .
       78       v-FS-RAR = inFSRAR.
       79       v-ext-sys = inExtSys.
       80       IsSent.
       81     end constructor.
       82     method public override handle GetHndlTable(inTableType as int, inAbIndenty as char) :
       83       define variable hRoot as handle  no-undo.
       84       define variable hDoc  as handle  no-undo.
       85       define variable ii    as integer no-undo.
       86       assign
       87         parameters = inNum
       88         StatusErr = false
       89         Msg       = ""
       90         .
       91       case inTableType:
       92         when 3 then
       93           do:
       94             empty temp-table tt-act-header.
       95             for each buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo':U:
       96               if entry(1, buf_clob-bind.descr, chr(4)) matches Obj
       97               then .
       98               else next .
       99               create tt-act-header.
      100               assign
      101                   tt-act-header.num       = (entry (1, buf_clob-bind.descr, chr(4)))
      102                   tt-act-header.date_     = date (entry (2, buf_clob-bind.descr, chr(4)))
      103                   tt-act-header.type_     = (entry (3, buf_clob-bind.descr, chr(4)))
      104                   tt-act-header.is-sent   = logical (entry (4, buf_clob-bind.descr, chr(4)))
      105               .
      106               assign tt-act-header.answer_   = (entry (5, buf_clob-bind.descr, chr(4))) no-error .
      107               assign tt-act-header.RegID     = (entry (6, buf_clob-bind.descr, chr(4))) no-error .
      108               end.
      109             return buffer tt-act-header:handle.
      110           end.
      111         when 2 then
      112         do :
      113           v-Answer = "" .
      114           v-RegID = "" .
      115           create x-document hDoc.
      116           create x-noderef  hRoot.
      117           ReplyID = "" .
      118           IsSent.
      119           if ReplyID = "" or ReplyID = ?
      120           then do:
      121             StatusErr = true.
      122             Msg = "Не найден запрос в журнале запросов или код запроса пуст".
      123             return ?.
      124           end.
      125           if ConPar = "" or ConPar = ?
      126           then do:
      127             StatusErr = true.
      128             Msg = "Не заданы настройки соединения для EGAIS".
      129             return ?.
      130           end.
      131           ticket2 = false .
      132           GetSubjectOfRequestUTM().
      133           if StatusErr
      134             then return ?.
      135           file-info:file-name = search (inFileName).
      136           if search (inFileName) = ? or file-info:file-size = 0
      137           then do:
      138             assign
      139               StatusErr = true
      140               Msg = "Не удалось получить данные от UTM"
      141             .
      142             return ?.
      143           end.
      144           if not WriteDbStatus ( 4, parameters , ReplyId, true )
      145           then do:
      146             assign
      147               StatusErr = true
      148               Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      149             .
      150             undo, return ?.
      151           end.
      152           hDoc:load ("file", inFileName, false).
      153           hDoc:get-document-element(hRoot) .
      154           GetChildren(hRoot, 1).
      155           DELETE OBJECT hDoc no-error.
      156           DELETE OBJECT hRoot no-error.
      157           ticket2 = true .
      158           if num-entries(urlResp, chr(4)) = 2 then do :
      159               create x-document hDoc.
      160               create x-noderef  hRoot.
      161               GetSubjectOfRequestUTM().
      162               if StatusErr
      163                 then return ?.
      164               file-info:file-name = search (inFileName).
      165               if search (inFileName) = ? or file-info:file-size = 0
      166               then do:
      167                 assign
      168                   StatusErr = true
      169                   Msg = "Не удалось получить данные от UTM"
      170                 .
      171                 return ?.
      172               end.
      173               hDoc:load ("file", inFileName, false).
      174               hDoc:get-document-element(hRoot) .
      175               GetChildren(hRoot, 1).
      176               DELETE OBJECT hDoc no-error.
      177               DELETE OBJECT hRoot no-error.
      178           end.
      179           find last buf_clob-bind exclusive-lock where buf_clob-bind.field-name_ = 'egais-awo':U and buf_clob-bind.uniq-key-rec = inAbIndenty .
      180           if num-entries (buf_clob-bind.descr, chr(4)) = 4 then
      181               assign buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-Answer + chr(4) + v-RegID .
      182           else if num-entries (buf_clob-bind.descr, chr(4)) = 5 then
      183               assign entry(5, buf_clob-bind.descr, chr(4)) = v-Answer
      184                      buf_clob-bind.descr = buf_clob-bind.descr + chr(4) + v-RegID .
      185           else if num-entries (buf_clob-bind.descr, chr(4)) = 6 then
      186               assign entry(5, buf_clob-bind.descr, chr(4)) = v-Answer
      187                      entry(6, buf_clob-bind.descr, chr(4)) = v-RegID .
      188           release buf_clob-bind .
      189           find first tt-act-header where tt-act-header.num = inAbIndenty .
      190           assign tt-act-header.answer_ = v-Answer
      191                  tt-act-header.RegID   = v-RegID .
      192           return buffer tt-act-header:handle.
      193         end.
      194       end case.
      195     end.
      196     method override public logical SendRequestUTM ():
      197       def var ii        as int    no-undo.
      198       def var xml-cont  as char   no-undo.
      199       def var respValue as handle no-undo.
      200       assign
      201         parameters = inNum
      202         StatusErr = false
      203         Msg       = ""
      204         .
      205       IsSent.
      206       do trans:
      207         os-delete "RespActWriteOff0.xml".
      208         assign
      209           inFileName = "RespActWriteOff0.xml"
      210           .
      211         find first tt-act-header where tt-act-header.num = inNum no-error.
      212         if available (tt-act-header)
      213           then
      214         do:
      215             if VerXSD = "1" then
      216               cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/ActWriteOff >&4", search ("exe/curl.exe"), search ("ActWriteOff.xml"), ConPar, inFileName, TimeOut).
      217             if VerXSD = "2" then
      218               cmd = substitute ("&1 --connect-timeout &5 -F xml_file=@&2 &3/opt/in/ActWriteOff_v2 >&4", search ("exe/curl.exe"), search ("ActWriteOff.xml"), ConPar, inFileName, TimeOut).
      219             os-command silent value (cmd).
      220             file-info:file-name = search (inFileName).
      221             if search (inFileName) <> ? and file-info:file-size > 0
      222               then
      223             do:
      224               respValue = ParseRequest (inFileName).
      225               if respValue = ?
      226                 then
      227               do:
      228                 assign
      229                   StatusErr = true
      230                   Msg       = "Не удалось разобрать данные от UTM"
      231                   .
      232                 undo, return false.
      233               end.
      234               if not StatusErr
      235                 then
      236                 ReplyId = respValue:node-value.
      237               else
      238               do:
      239                 assign
      240                   StatusErr = true
      241                   Msg       = respValue:node-value
      242                   .
      243                 undo, return false.
      244               end.
      245             end.
      246             else
      247             do:
      248               assign
      249                 StatusErr = true
      250                 Msg       = "Не удалось отправить акт о списании в UTM"
      251                 .
      252               undo, return false.
      253             end.
      254             if not WriteDbStatus (4, parameters , ReplyId, false)
      255             then do:
      256               assign
      257                 StatusErr = true
      258                 Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      259               .
      260               undo, return false.
      261             end.
      262         end.
      263       end.
      264     end.
      265     method override protected logical GetIsSent ():
      266       find last ub.esys-all-attr no-lock
      267                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      268                   and ub.esys-all-attr.attr-code = "egais"
      269                   and ub.esys-all-attr.key2       = 4
      270                   and ub.esys-all-attr.attr-value = parameters
      271                   no-error.
      272       if available (ub.esys-all-attr )
      273       then do:
      274         ReplyId = ub.esys-all-attr.key7.
      275         return true.
      276       end.
      277       return false.
      278     end.
      279     method protected handle ParseRequest (inFileName as char):
      280       define variable hRoot as handle  no-undo.
      281       define variable hDoc  as handle  no-undo.
      282       define variable hRow  as handle  no-undo.
      283       define variable hText as handle  no-undo.
      284       define variable ii    as integer no-undo.
      285       create x-document hDoc.
      286       create x-noderef  hRoot.
      287       create x-noderef  hRow.
      288       create x-noderef htext .
      289       hDoc:load ("file", inFileName, false).
      290       hDoc:encoding = "UTF-8".
      291       hDoc:get-document-element(hRoot) .
      292       do ii = 1 to hRoot:num-children:
      293         hRoot:get-child(hRow,ii).
      294         case hRow:name:
      295           when "url" then
      296             do:
      297               hRow:get-child (hText, 1) no-error.
      298               return hText.
      299             end.
      300           when "error" then
      301             do:
      302               hRow:get-child (hText, 1) no-error.
      303               StatusErr = true.
      304               return hText.
      305             end.
      306           otherwise
      307             do:
      308               return ?.
      309             end.
      310         end case.
      311       end.
      312     end.
      313     method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
      314           DEFINE VARIABLE i AS INTEGER NO-UNDO.
      315           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      316           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      317           define variable v-ok as logical no-undo .
      318           CREATE X-NODEREF hNoderef.
      319           CREATE X-NODEREF hText .
      320           REPEAT i = 1 TO hParent:NUM-CHILDREN:
      321               good = hParent:GET-CHILD(hNoderef,i).
      322               IF NOT good THEN
      323                   LEAVE.
      324               IF hNoderef:SUBTYPE <> "element" THEN
      325                   NEXT.
      326               hNoderef:GET-CHILD(hText, 1) no-error .
      327               IF hNoderef:NAME = "tc:RegID"    THEN do :
      328                   v-RegID  = hText:node-value no-error.
      329                   if v-RegID = ? then v-RegID = "" .
      330               end.
      331               IF hNoderef:NAME = "tc:Conclusion"
      332               OR hNoderef:NAME = "tc:OperationResult" THEN
      333               DO :
      334                   if hText:node-value = "Rejected" then v-RegID = v-RegID + CHR(5) + "R" .
      335                   if hText:node-value = "Accepted" then v-RegID = v-RegID + CHR(5) + "A" .
      336               END.
      337               IF hNoderef:NAME = "tc:Comments" THEN do :
      338                   if trim(v-Answer) = '' or v-Answer = chr(10) then v-Answer = hText:node-value .
      339                   else v-Answer = v-Answer + chr(10) + hText:node-value .
      340               end.
      341               IF hNoderef:NAME = "tc:OperationResult" THEN v-ok = (hText:node-value = "Accepted") .
      342               IF hNoderef:NAME = "tc:OperationComment" THEN v-Answer = v-Answer + chr(10) + hText:node-value .
      343               GetChildren(hNoderef, (level + 1)).
      344           END.
      345           DELETE OBJECT hNoderef.
      346           DELETE OBJECT hText.
      347     END.
      348     method public override character GetSubjectOfRequestUTM() :
      349       define variable response as character no-undo .
      350       if not ticket2 then do :
      351           urlResp = GetURLUTM(ReplyId).
      352       end.
      353       if StatusErr and Msg <> "" and Msg <> ? then return ? .
      354       if urlResp = "" or urlResp = ?
      355       then do:
      356         StatusErr = true.
      357         Msg = "Еще не получен ответ от сервера EGAIS по запросу " + ReplyId + chr(10) + "Либо ответ уже автоматически удалён".
      358         return ?.
      359       end.
      360       if not ticket2 then do :
      361           os-delete "RespActWriteOff.xml".
      362           assign
      363             inFileName = "RespActWriteOff.xml"
      364             response = entry(1,urlResp,chr(4))
      365           .
      366       end.
      367       else do :
      368           os-delete "RespActWriteOff2.xml".
      369           assign
      370             inFileName = "RespActWriteOff2.xml"
      371           .
      372           response = entry(2,urlResp,chr(4)) no-error .
      373       end.
      374       if trim(response) <> "" then do :
      375           cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, response, inFileName).
      376           os-command silent value (cmd).
      377       end.
      378     end.
      379     method protected override character GetURLUTM (inReplyId as char):
      380       define variable hRoot as handle  no-undo.
      381       define variable hDoc  as handle  no-undo.
      382       define variable hRow  as handle  no-undo.
      383       define variable hText as handle  no-undo.
      384       define variable ii    as integer no-undo.
      385       define variable files as character no-undo.
      386       create x-document hDoc.
      387       create x-noderef  hRoot.
      388       create x-noderef  hRow.
      389       create x-noderef  hText.
      390       assign
      391         inFileName = "ReceiptListOfQuery.xml"
      392       .
      393       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      394       if search (inFileName) <> ? then os-delete value (inFileName).
      395       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      396       os-command silent value (cmd).
      397       file-info:file-name = search (inFileName).
      398       if search (inFileName) = ? or file-info:file-size = 0
      399       then do:
      400         assign
      401           StatusErr = true
      402           Msg = "Не удалось получить данные от UTM"
      403         .
      404         return ?.
      405       end.
      406       hDoc:load ("file", inFileName, false).
      407       hDoc:get-document-element(hRoot) .
      408       do ii = 1 to hRoot:num-children:
      409         hRoot:get-child(hRow,ii).
      410         case hRow:name:
      411           when "url" then
      412             do:
      413               if hRow:get-attribute("replyId") = ReplyId
      414               then do:
      415                 hRow:get-child (hText, 1) no-error.
      416                 files = files + chr(4) + hText:node-value.
      417               end.
      418             end.
      419         end case.
      420       end.
      421       files = trim(files, chr(4)) .
      422       return files .
      423     end.
      424   end class.
