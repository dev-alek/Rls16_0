        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ParserXMLDictOrg inherits EGAISUTM:
        5       define variable v-FS-RAR as character no-undo .
        6       define temp-table tt-objs-EG no-undo
        7           field obj-type          like ub.clients.obj-type
        8           field obj-code          like ub.clients.obj-code
        9           field obj-name-th       as character label "Наименование в TH"
       10           field obj-name-egais    as character label "Наименование ЕГАИС"    format "X(100)"
       11           field regID             as character label "Регистрационный номер" format "X(21)"
       12           field inn               as character label "ИНН"
       13           field kpp               as character label "КПП"
       14           field country           as character label "Код страны"
       15           field regionCode        as character label "Код региона"
       16           field district          as character label "Район"
       17           field city              as character label "Город"
       18           field settlement        as character label "Населенный пункт"
       19           field street            as character label "Улица"
       20           field house-number      as character label "Номер дома"
       21           field house-case        as character label "Корпус"
       22           field house-apartment   as character label "Номер квартиры"
       23           field house-litera      as character label "Литера"
       24           field postIndex         as character label "Почтовый индекс"
       25           field description_      as character label "Адрес"                  format "X(100)"
       26           field fromEgais         as logical
       27           field connected_        as logical
       28           field obj-name-egais-short as character label "Короткое наименование ЕГАИС" format "X(100)"
       29           field versionWB         as character format "X(10)"
       30           field typeEgais         as character format "X(2)"
       31           index pi
       32               inn kpp
       33       .
       34       DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
       35       DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
       36       DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       37       constructor public ParserXMLDictOrg (inOjType as char, inObjCode as int):
       38         super (inOjType, inObjCode).
       39       end constructor.
       40       method override handle ParseResponse(inFileName as char):
       41           empty temp-table tt-objs-EG .
       42           CREATE X-DOCUMENT hDoc.
       43           CREATE X-NODEREF hRoot.
       44           hDoc:LOAD("file",inFileName,FALSE).
       45           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       46           GetChildren(hRoot, 1).
       47           DELETE OBJECT hDoc.
       48           DELETE OBJECT hRoot.
       49           return buffer tt-objs-EG:handle.
       50       end.
       51       method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
       52           DEFINE VARIABLE i AS INTEGER NO-UNDO.
       53           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
       54           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
       55           CREATE X-NODEREF hNoderef.
       56           CREATE X-NODEREF hText .
       57           REPEAT i = 1 TO hParent:NUM-CHILDREN:
       58               good = hParent:GET-CHILD(hNoderef,i).
       59               IF NOT good THEN
       60                   LEAVE.
       61               IF hNoderef:SUBTYPE <> "element" THEN
       62                   NEXT.
       63               hNoderef:GET-CHILD(hText, 1) no-error .
       64               IF hNoderef:NAME = "ns:FSRAR_ID" THEN
       65                   assign v-FS-RAR = hText:node-value .
       66               IF hNoderef:NAME = "rc:Client" THEN do :
       67                   create tt-objs-EG .
       68                   assign tt-objs-EG.fromEgais = yes .
       69               end.
       70               IF hNoderef:NAME = "oref:UL"
       71               OR hNoderef:NAME = "oref:FL"
       72               OR hNoderef:NAME = "oref:FO"
       73               OR hNoderef:NAME = "oref:TS"
       74               THEN assign tt-objs-EG.typeEgais = entry(2, hNoderef:NAME, ":") .
       75               IF hNoderef:NAME = "oref:ClientRegId" THEN assign tt-objs-EG.regID          = hText:node-value .
       76               IF hNoderef:NAME = "oref:INN"         THEN assign tt-objs-EG.inn            = hText:node-value .
       77               IF hNoderef:NAME = "oref:KPP"         THEN assign tt-objs-EG.kpp            = hText:node-value .
       78               IF hNoderef:NAME = "oref:FullName"    THEN assign tt-objs-EG.obj-name-egais = hText:node-value .
       79               IF hNoderef:NAME = "oref:ShortName"   THEN assign tt-objs-EG.obj-name-egais-short = hText:node-value .
       80               IF hNoderef:NAME = "oref:Country"     THEN assign tt-objs-EG.country        = hText:node-value .
       81               IF hNoderef:NAME = "oref:Index"       THEN assign tt-objs-EG.postIndex      = hText:node-value .
       82               IF hNoderef:NAME = "oref:RegionCode"  THEN assign tt-objs-EG.regionCode     = hText:node-value .
       83               IF hNoderef:NAME = "oref:area"        THEN assign tt-objs-EG.district       = hText:node-value .
       84               IF hNoderef:NAME = "oref:city"        THEN assign tt-objs-EG.city           = hText:node-value .
       85               IF hNoderef:NAME = "oref:place"       THEN assign tt-objs-EG.settlement     = hText:node-value .
       86               IF hNoderef:NAME = "oref:street"      THEN assign tt-objs-EG.street         = hText:node-value .
       87               IF hNoderef:NAME = "oref:house"       THEN assign tt-objs-EG.house-number   = hText:node-value .
       88               IF hNoderef:NAME = "oref:building"    THEN assign tt-objs-EG.house-case     = hText:node-value .
       89               IF hNoderef:NAME = "oref:liter"       THEN assign tt-objs-EG.house-litera   = hText:node-value .
       90               IF hNoderef:NAME = "oref:description" THEN assign tt-objs-EG.description_   = hText:node-value .
       91               IF hNoderef:NAME = "oref:VersionWB"   THEN assign tt-objs-EG.versionWB      = hText:node-value .
       92               GetChildren(hNoderef, (level + 1)).
       93           END.
       94           DELETE OBJECT hNoderef.
       95           DELETE OBJECT hText.
       96       END.
       97   end class.
