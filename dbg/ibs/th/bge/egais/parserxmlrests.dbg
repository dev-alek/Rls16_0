        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ParserXMLRests inherits EGAISUTM:
        5       define variable v-FS-RAR as character no-undo .
        6       define property v-date-time as character no-undo
        7           get.
        8           set.
        9       define temp-table tt-gds-rests-EG no-undo
       10       field gds-code          like ub.goods.gds-code          label "Код товара в TH"
       11       field gds-name          like ub.goods.gds-name          label "Наименование товара" format "X(100)"
       12       field alc-code          as character                    label "Алкогольный код"     format "X(21)"
       13       field ms-base           like ub.goods.ms-base           label "Объем"               format ">>9.9<<"
       14       field alc-type-code     like ub.alc-type.alc-type-code  label "Код АП"
       15       field proof             like ub.goods.proof             label "Крепость"            format ">9.9"
       16       field fromEgais         as logical
       17       field egais-name        as character                    label "Наименование ЕГАИС"  format "X(100)"
       18       field egais-qnty        as decimal                      label "Остаток ЕГАИС"
       19       field informA_          as character                    label "ID справки А"        format "X(30)"
       20       field informB_          as character                    label "ID справки Б"        format "X(30)"
       21       field TH-qnty           as decimal                      label "Остаток TH"
       22       field packed            as logical
       23       index pi as primary
       24           gds-code
       25       index name_ as word-index
       26           gds-name
       27       index alc
       28           alc-code
       29       .
       30       DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
       31       DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
       32       DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       33       constructor public ParserXMLRests (inOjType as char, inObjCode as int):
       34         super (inOjType, inObjCode).
       35       end constructor.
       36       method override handle ParseResponse(inFileName as char):
       37           empty temp-table tt-gds-rests-EG .
       38           CREATE X-DOCUMENT hDoc.
       39           CREATE X-NODEREF hRoot.
       40           hDoc:LOAD("file",inFileName,FALSE).
       41           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       42           GetChildren(hRoot, 1).
       43           DELETE OBJECT hDoc.
       44           DELETE OBJECT hRoot.
       45           return buffer tt-gds-rests-EG:handle.
       46       end.
       47       method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
       48           DEFINE VARIABLE i AS INTEGER NO-UNDO.
       49           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
       50           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
       51           CREATE X-NODEREF hNoderef.
       52           CREATE X-NODEREF hText .
       53           REPEAT i = 1 TO hParent:NUM-CHILDREN:
       54               good = hParent:GET-CHILD(hNoderef,i).
       55               IF NOT good THEN
       56                   LEAVE.
       57               IF hNoderef:SUBTYPE <> "element" THEN
       58                   NEXT.
       59               hNoderef:GET-CHILD(hText, 1) no-error .
       60               IF hNoderef:NAME = "ns:FSRAR_ID" THEN
       61                   assign v-FS-RAR = hText:node-value .
       62               IF hNoderef:NAME = "rst:StockPosition" THEN
       63                   create tt-gds-rests-EG .
       64               IF hNoderef:NAME = "rst:RestsDate"   THEN assign v-date-time        = hText:node-value .
       65               IF hNoderef:NAME = "rst:Quantity"    THEN assign tt-gds-rests-EG.egais-qnty        = decimal(hText:node-value) .
       66               IF hNoderef:NAME = "rst:InformARegId"
       67               OR hNoderef:NAME = "rst:InformF1RegId" THEN assign tt-gds-rests-EG.informA_          = hText:node-value .
       68               IF hNoderef:NAME = "rst:InformBRegId"
       69               OR hNoderef:NAME = "rst:InformF2RegId" THEN assign tt-gds-rests-EG.informB_          = hText:node-value .
       70               IF hNoderef:NAME = "pref:FullName"     THEN do :
       71                   if trim(tt-gds-rests-EG.gds-name) = "" then assign tt-gds-rests-EG.gds-name        = hText:node-value .
       72               end.
       73               IF hNoderef:NAME = "pref:AlcCode"      THEN assign tt-gds-rests-EG.alc-code        = hText:node-value .
       74               IF hNoderef:NAME = "pref:UnitType"     THEN assign tt-gds-rests-EG.packed          = (hText:node-value = "Packed") .
       75               IF hNoderef:NAME = "pref:Capacity"     THEN assign tt-gds-rests-EG.ms-base         = decimal(hText:node-value) .
       76               IF hNoderef:NAME = "pref:AlcVolume"    THEN assign tt-gds-rests-EG.proof           = decimal(hText:node-value) .
       77               IF hNoderef:NAME = "pref:ProductVCode" THEN assign tt-gds-rests-EG.alc-type-code   = hText:node-value .
       78               GetChildren(hNoderef, (level + 1)).
       79           END.
       80           DELETE OBJECT hNoderef.
       81           DELETE OBJECT hText.
       82       END.
       83   end class.
