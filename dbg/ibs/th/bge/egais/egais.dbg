        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.EGAIS:
        5     define variable oldEGAISImpl as class EGAISImpl no-undo.
        6     define property DbNum as integer no-undo init ?
        7       get.
        8       private set.
        9     define property User_Id as char no-undo init ?
       10       get.
       11       private set.
       12     define public property EGAISImpl as class EGAISImpl
       13       get.
       14       set (arg as class EGAISImpl):
       15         if valid-object (oldEGAISImpl)
       16           then delete object oldEGAISImpl.
       17         EGAISImpl = arg.
       18         EGAISImpl:DbNum = DbNum.
       19         EGAISImpl:User_Id = User_Id.
       20         oldEGAISImpl = arg.
       21       end.
       22     define property IsSent as logical no-undo
       23       get:
       24         return EGAISImpl:IsSent.
       25       end.
       26       protected set.
       27     define property ReplyId as character no-undo
       28       get.
       29       protected set.
       30     define property Msg as character no-undo
       31       get.
       32       protected set.
       33     define property StatusErr as logical no-undo init false
       34       get.
       35       protected set.
       36     constructor public EGAIS (inDbNum as int, inUserId as char):
       37       assign
       38         DbNum   = inDbNum
       39         User_Id = inUserId
       40         .
       41     end constructor.
       42     method public logical SendRequestUTM ():
       43       define variable glog as logical no-undo.
       44       assign
       45         StatusErr = false
       46         Msg       = "".
       47       assign
       48         glog      = EGAISImpl:SendRequestUTM ()
       49         Msg       = EGAISImpl:Msg
       50         StatusErr = EGAISImpl:StatusErr
       51         ReplyId   = EGAISImpl:ReplyId
       52         .
       53       return glog.
       54     end.
       55     method public handle GetHndlTable ():
       56       define variable tth as handle no-undo.
       57       assign
       58         StatusErr = false
       59         Msg       = "".
       60       assign
       61         tth       = EGAISImpl:GetHndlTable()
       62         Msg       = EGAISImpl:Msg
       63         StatusErr = EGAISImpl:StatusErr
       64         .
       65       return tth.
       66     end.
       67     method public handle GetHndlTable (inArg as int, inArg1 as char):
       68       define variable tth as handle no-undo.
       69       assign
       70         StatusErr = false
       71         Msg       = "".
       72       assign
       73         tth       = EGAISImpl:GetHndlTable(inArg, inArg1)
       74         Msg       = EGAISImpl:Msg
       75         StatusErr = EGAISImpl:StatusErr
       76         .
       77       return tth.
       78     end.
       79     method public void SaveWB (inArg as char):
       80       define variable tth as handle no-undo.
       81       assign
       82         StatusErr = false
       83         Msg       = "".
       84       EGAISImpl:SaveWB(inArg).
       85       assign
       86         Msg       = EGAISImpl:Msg
       87         StatusErr = EGAISImpl:StatusErr
       88         .
       89     end.
       90     method public void RejectWB (inArg as char):
       91       define variable tth as handle no-undo.
       92       assign
       93         StatusErr = false
       94         Msg       = "".
       95       EGAISImpl:RejectWB(inArg).
       96       assign
       97         Msg       = EGAISImpl:Msg
       98         StatusErr = EGAISImpl:StatusErr
       99         .
      100     end.
      101     method public void ConnWB (inArg as char, inArg1 as char):
      102       define variable tth as handle no-undo.
      103       assign
      104         StatusErr = false
      105         Msg       = "".
      106       EGAISImpl:ConnWB(inArg, inArg1).
      107       assign
      108         Msg       = EGAISImpl:Msg
      109         StatusErr = EGAISImpl:StatusErr
      110         .
      111     end.
      112   end class.
