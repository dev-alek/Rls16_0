        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.EGAISUTM inherits EGAISImpl:
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
        7     define protected variable TimeOut as character no-undo.
        8     define property ConPar as character no-undo
        9     get.
       10     protected set.
       11     define property VerXSD as character no-undo
       12     get.
       13     protected set.
       14     define property INNObj as character no-undo
       15     get.
       16     protected set.
       17     constructor public EGAISUTM (inOjType as char, inObjCode as int):
       18       define variable v-value-character   as character no-undo .
       19       define variable v-value-decimal     as decimal   no-undo .
       20       define variable v-value-integer     as integer   no-undo .
       21       define variable v-value-logical     as logical   no-undo .
       22       define variable v-value-type        as character no-undo .
       23       define variable v-value-date        as date      no-undo .
       24       get-key-value section 'EGAIS' key 'TimeOut' value TimeOut.
       25       if TimeOut = ? then do:
       26         assign
       27           TimeOut = "5".
       28       end.
       29       run adm/shattri.p (
       30            input "get":U
       31           ,input inOjType
       32           ,input inObjCode
       33           ,input 'egais':U
       34           ,input 'egais-utm':U
       35           ,output v-value-character
       36           ,output v-value-date
       37           ,output v-value-decimal
       38           ,output v-value-integer
       39           ,output v-value-logical
       40           ,output v-value-type
       41           ,input-output table thbjattr_thbj-attr
       42           ) no-error .
       43       ConPar = trim (v-value-character, '/').
       44       ConPar = trim (ConPar, '\').
       45       run adm/shattri.p (
       46            input "get":U
       47           ,input inOjType
       48           ,input inObjCode
       49           ,input 'egais':U
       50           ,input 'egais-ver-xsd':U
       51           ,output v-value-character
       52           ,output v-value-date
       53           ,output v-value-decimal
       54           ,output v-value-integer
       55           ,output v-value-logical
       56           ,output v-value-type
       57           ,input-output table thbjattr_thbj-attr
       58           ) no-error .
       59       if error-status:error
       60         then v-value-character = "1".
       61       case v-value-character:
       62         when "1" or when "" or when ? then do:
       63           VerXSD = "1".
       64         end.
       65         when "2" then do:
       66           VerXSD = "2".
       67         end.
       68         otherwise do:
       69           message substitute ("В настройках параметров ЕГАИС для объекта указана неверная версия схем XSD - &1. Будет использована схема по умолчанию 1", VerXSD) view-as alert-box.
       70           VerXSD = "1".
       71         end.
       72       end.
       73       run adm/shattri.p (
       74            input "get":U
       75           ,input inOjType
       76           ,input inObjCode
       77           ,input 'egais':U
       78           ,input 'egais-inn':U
       79           ,output v-value-character
       80           ,output v-value-date
       81           ,output v-value-decimal
       82           ,output v-value-integer
       83           ,output v-value-logical
       84           ,output v-value-type
       85           ,input-output table thbjattr_thbj-attr
       86           ) no-error .
       87       INNObj = v-value-character.
       88     end constructor.
       89     method protected character GetURLUTM (arg as char):
       90     end.
       91     method protected character GetSubjectOfRequestUTM ():
       92     end.
       93     method final protected logical WriteDbStatus ( inSubject as int,  inParameters as char, inReplyId as char, inSts as log ):
       94       define buffer buf_ext-sys for ub.ext-system.
       95       find first buf_ext-sys no-lock where buf_ext-sys.delivery-method = 10 no-error.
       96       if available (buf_ext-sys) then
       97       do:
       98         find first ub.esys-all-attr
       99                 where ub.esys-all-attr.key7 = inReplyId no-error.
      100         if not available ub.esys-all-attr
      101           then do:
      102             create ub.esys-all-attr.
      103             ub.esys-all-attr.key4       = string (now).
      104           end.
      105         assign
      106           ub.esys-all-attr.table-name = "esys-pck-sent"
      107           ub.esys-all-attr.attr-code  = "egais"
      108           ub.esys-all-attr.attr-value = inParameters
      109           ub.esys-all-attr.key1       = buf_ext-sys.esys-id
      110           ub.esys-all-attr.key2       = inSubject
      111           ub.esys-all-attr.key3       = string (inSts)
      112           ub.esys-all-attr.key5       = DbNum
      113           ub.esys-all-attr.key7       = inReplyId
      114           ub.esys-all-attr.key8       = User_Id
      115         no-error.
      116         if error-status:error
      117         then do:
      118           release ub.esys-all-attr.
      119           return false.
      120         end.
      121       end.
      122       else
      123         return false.
      124       release ub.esys-all-attr.
      125       return true.
      126     end method.
      127     method final protected logical CheckCurrentRequest ( inSubject as int,  inParameters as char, output outReplyId as char ):
      128       find first ub.esys-all-attr
      129                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      130                   and ub.esys-all-attr.attr-code = "egais"
      131                   and ub.esys-all-attr.key2       = inSubject
      132                   and ub.esys-all-attr.attr-value = inParameters
      133                   and ub.esys-all-attr.key3 = string (false)
      134                   no-error.
      135       if available (ub.esys-all-attr )
      136       then do:
      137         outReplyId = ub.esys-all-attr.key7.
      138         release ub.esys-all-attr.
      139         return true.
      140       end.
      141       return false.
      142     end method.
      143     method protected handle ParseResponse (inFileName as char):
      144     end.
      145     method protected void ParseResponse (inContent as char, inTableType as int):
      146     end.
      147   end class.
