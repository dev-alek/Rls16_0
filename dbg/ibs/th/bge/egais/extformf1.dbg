        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.egais.ExtFormF1:
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        8   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
        9   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       11   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       12   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       13   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       14   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       15   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       16   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       17   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       18   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       19   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       20   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       21   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       22   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       23   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       24   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       25   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       26   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       27     define private temp-table ttObjEgaisAlcProp no-undo
       28       field iExtFormF1Obj as integer
       29       field ExtFormF1ValueObj as class Progress.Lang.Object
       30       index pi is primary unique iExtFormF1Obj .
       31     define private buffer buf_ext-classif      for ub.ext-classif.
       32     define private buffer x_ext-classif        for ub.ext-classif.
       33     define private buffer buf_ext-classif-attr for ub.ext-classif-attr.
       34     define private buffer buf_gds for ub.goods.
       35     define private buffer buf_cli for ub.clients.
       36     define private variable listManagObj as class listmanager.
       37     define property ExtSystem as integer no-undo
       38       get.
       39       private set.
       40     define property DbNum as integer init 0 no-undo
       41       get.
       42       set.
       43     define property IsSilent as logical no-undo
       44       get.
       45       private set.
       46     define property FormF1CodeItemQuery as character no-undo
       47       get.
       48       private set.
       49     define property AlcCodeItemQuery as character no-undo
       50       get.
       51       private set.
       52     define property NumBundles as integer no-undo
       53       get.
       54       private set.
       55     define property ReturnMsg as character no-undo
       56       get.
       57       private set.
       58     define property SettingsTTList as character no-undo init ";;;;;23,yes;;;1,no"
       59       get.
       60       private set.
       61     define temp-table tt-egaisformf1-hndls no-undo
       62       field mark                as character format "X(1)" label "*"
       63       field formF1Code          as character label "Код справки 1" format "x(21)"
       64       field alcCode             as character label "Алк. код товара" format "x(21)"
       65       field BottlingDate        as character label "Дата розлива" format "x(10)"
       66       field CliEgaisTypeOrigCli as character label "Тип" format "x(2)"
       67       field CliRegIdOrigCli     as character label "Код клиента ЕГАИС" format "x(21)"
       68       field INNOrigCli          as character label "ИНН клиента ЕГАИС" format "x(10)"
       69       field KPPOrigCli          as character label "КПП клиента ЕГАИС" format "x(10)"
       70       field ColorNum            as integer init ?
       71       index pi as primary
       72       alcCode formF1Code
       73       .
       74     constructor public ExtFormF1 (inIsSilent as logical):
       75       ExtSystem = getExtSystem().
       76       IsSilent = inIsSilent.
       77       if ExtSystem = 0 or ExtSystem = ?
       78         then
       79       do:
       80         if not IsSilent
       81           then message "Отсутсвует ВС настроенная для обмена с ЕГАИС" view-as alert-box.
       82         return error "Отсутсвует ВС настроенная для обмена с ЕГАИС".
       83       end.
       84       listManagObj = new listmanager ().
       85     end constructor.
       86     destructor public ExtFormF1 ():
       87       if valid-object (listManagObj)
       88         then delete object listManagObj.
       89       ClearProp().
       90     end destructor.
       91     method public void GetHndlTable (inFormF1Code as char, inAlcCode as char, input-output outTTHndl as handle):
       92       def var ExtFormF1ValueObj as ExtFormF1Value no-undo.
       93       assign
       94         ReturnMsg = ""
       95       .
       96       empty temp-table tt-egaisformf1-hndls.
       97       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'EGAIS':U
       98         and buf_ext-classif.classif-name = 'FormF1-esys':U
       99         and buf_ext-classif.db-num = 0
      100         and (inFormF1Code = "" or buf_ext-classif.CharKey_Two = inFormF1Code)
      101         and buf_ext-classif.key#_two = ExtSystem
      102         and buf_ext-classif.key#_three = 0
      103         and (inAlcCode = "" or buf_ext-classif.charkey_one = inAlcCode)
      104         and buf_ext-classif.Key#_One = 0
      105         and buf_ext-classif.charkey_three = ""
      106         and buf_ext-classif.nonunique = 0
      107         :
      108         find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      109           and buf_ext-classif-attr.classif-name = buf_ext-classif.classif-name
      110           and buf_ext-classif-attr.db-num = buf_ext-classif.db-num
      111           and buf_ext-classif-attr.Key#_One = buf_ext-classif-attr.Key#_One
      112           and buf_ext-classif-attr.Key#_two = buf_ext-classif.key#_two
      113           and buf_ext-classif-attr.Key#_three = buf_ext-classif.key#_three
      114           and buf_ext-classif-attr.CharKey_One = buf_ext-classif.charkey_one
      115           and buf_ext-classif-attr.CharKey_two = buf_ext-classif.charkey_two
      116           and buf_ext-classif-attr.CharKey_three = buf_ext-classif.charkey_three
      117           and buf_ext-classif-attr.nonunique = buf_ext-classif.nonunique
      118           and buf_ext-classif-attr.attr-code = 'egais-info'
      119           no-error .
      120           create tt-egaisformf1-hndls.
      121           if available (buf_ext-classif-attr)
      122           then
      123             assign
      124               ExtFormF1ValueObj = GetInfoObj (buf_ext-classif-attr.attr-value)
      125             no-error.
      126           else
      127             assign
      128               ExtFormF1ValueObj = GetInfoObj ("")
      129             no-error.
      130           if error-status:error or not available (buf_ext-classif-attr)
      131             then
      132           do:
      133             ReturnMsg = " Справка 1" + string (buf_ext-classif.CharKey_Two) + ". Выполните синхронизацию товаров.".
      134             if not IsSilent
      135               then message ReturnMsg view-as alert-box.
      136             tt-egaisformf1-hndls.ColorNum = RED_COLOR.
      137           end.
      138           ExtFormF1ValueObj:AlcCode = buf_ext-classif.CharKey_One.
      139           ExtFormF1ValueObj:FormF1Code = buf_ext-classif.CharKey_Two.
      140           assign
      141             tt-egaisformf1-hndls.alcCode = ExtFormF1ValueObj:AlcCode
      142             tt-egaisformf1-hndls.formF1Code = ExtFormF1ValueObj:FormF1Code
      143             tt-egaisformf1-hndls.BottlingDate = ExtFormF1ValueObj:BottlingDate
      144             tt-egaisformf1-hndls.CliEgaisTypeOrigCli = ExtFormF1ValueObj:CliEgaisTypeOrigCli
      145             tt-egaisformf1-hndls.CliRegIdOrigCli = ExtFormF1ValueObj:CliRegIdOrigCli
      146             tt-egaisformf1-hndls.INNOrigCli = ExtFormF1ValueObj:INNOrigCli
      147             tt-egaisformf1-hndls.KPPOrigCli = ExtFormF1ValueObj:KPPOrigCli
      148             tt-egaisformf1-hndls.ColorNum = RED_COLOR when ExtFormF1ValueObj:INNOrigCli = ""
      149           .
      150       end.
      151       outTTHndl = buffer tt-egaisformf1-hndls:handle.
      152       if valid-object (ExtFormF1ValueObj)
      153         then delete object ExtFormF1ValueObj.
      154     end.
      155     method public logical OpenQueryExtFormF1 (inFormF1Code as char):
      156       return OpenQueryExtFormF1 (inFormF1Code, "").
      157     end.
      158     method public logical OpenQueryExtFormF1 (inFormF1Code as char, inAlcCode as char):
      159       def var ii as int no-undo.
      160       ClearProp().
      161       assign
      162         ReturnMsg = ""
      163         AlcCodeItemQuery = inAlcCode
      164         FormF1CodeItemQuery = inFormF1Code
      165         ii = 0.
      166       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'EGAIS':U
      167         and buf_ext-classif.classif-name = 'FormF1-esys':U
      168         and buf_ext-classif.db-num = 0
      169         and (FormF1CodeItemQuery = "" or buf_ext-classif.CharKey_Two = FormF1CodeItemQuery)
      170         and buf_ext-classif.key#_two = ExtSystem
      171         and buf_ext-classif.key#_three = 0
      172         and (AlcCodeItemQuery = "" or buf_ext-classif.charkey_one = AlcCodeItemQuery)
      173         and buf_ext-classif.Key#_One = 0
      174         and buf_ext-classif.charkey_three = ""
      175         and buf_ext-classif.nonunique = 0
      176         :
      177         find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      178           and buf_ext-classif-attr.classif-name = buf_ext-classif.classif-name
      179           and buf_ext-classif-attr.db-num = buf_ext-classif.db-num
      180           and buf_ext-classif-attr.Key#_One = buf_ext-classif.key#_one
      181           and buf_ext-classif-attr.Key#_two = buf_ext-classif.key#_two
      182           and buf_ext-classif-attr.Key#_three = buf_ext-classif.key#_three
      183           and buf_ext-classif-attr.CharKey_One = buf_ext-classif.charkey_one
      184           and buf_ext-classif-attr.CharKey_two = buf_ext-classif.charkey_two
      185           and buf_ext-classif-attr.CharKey_three = buf_ext-classif.charkey_three
      186           and buf_ext-classif-attr.nonunique = buf_ext-classif.nonunique
      187           and buf_ext-classif-attr.attr-code = 'egais-info'
      188           no-error .
      189         if not available (buf_ext-classif-attr)
      190           then
      191         do:
      192           ReturnMsg = "Отсутсвует атрибут egais-info - " + buf_ext-classif.charkey_one + "/" + string (buf_ext-classif.key#_one) + ". Выполните синхронизацию.".
      193           if not IsSilent
      194             then message ReturnMsg view-as alert-box.
      195         end.
      196         ii = ii + 1.
      197         setProp (ii) no-error.
      198         if ReturnMsg <> ""
      199           then
      200         do:
      201           if not IsSilent
      202             then message ReturnMsg view-as alert-box.
      203         end.
      204       end.
      205       NumBundles = ii.
      206       return true.
      207     end.
      208     method public class ExtFormF1Value GetExtFormF1Value () :
      209       return GetExtFormF1Value (1).
      210     end.
      211     method public class ExtFormF1Value GetExtFormF1Value (inJJ as int) :
      212       find first ttObjEgaisAlcProp where ttObjEgaisAlcProp.iExtFormF1Obj = inJJ no-error.
      213       if not available (ttObjEgaisAlcProp)
      214         then return ?.
      215       return cast (ttObjEgaisAlcProp.ExtFormF1ValueObj, ibs.th.bge.egais.ExtFormF1Value).
      216     end.
      217     method public logical CreateExtFormF1 (inFormF1Code as character, inAlcCode as char):
      218       define variable extFormF1ValueObj as class ExtFormF1Value no-undo.
      219       define variable glog as logical no-undo.
      220       extFormF1ValueObj = new ExtFormF1Value().
      221       extFormF1ValueObj:AlcCode = inAlcCode.
      222       extFormF1ValueObj:FormF1Code = inFormF1Code.
      223       glog = CreateExtFormF1(extFormF1ValueObj) .
      224       if not glog
      225         then if valid-object (extFormF1ValueObj)
      226                     then delete object extFormF1ValueObj.
      227       return glog.
      228     end.
      229     method public logical WriteExtFormF1 (inExtFormF1ValueObj as class ExtFormF1Value):
      230       OpenQueryExtFormF1(inExtFormF1ValueObj:FormF1Code, inExtFormF1ValueObj:AlcCode).
      231       if NumBundles = 1
      232       then do:
      233         if not SaveEGAISInfoDB (inExtFormF1ValueObj)
      234         then do:
      235           AlcCodeItemQuery = "".
      236           FormF1CodeItemQuery = "".
      237           undo, return false.
      238         end.
      239         return true.
      240       end.
      241       else do:
      242         if not CreateExtFormF1 (inExtFormF1ValueObj)
      243         then do:
      244           AlcCodeItemQuery = "".
      245           FormF1CodeItemQuery = "".
      246           undo, return false.
      247         end.
      248         return true.
      249       end.
      250       return false.
      251     end.
      252     method public logical CreateExtFormF1 (inExtFormF1ValueObj as class ExtFormF1Value):
      253       ClearProp().
      254       assign
      255         ReturnMsg = ""
      256         AlcCodeItemQuery = inExtFormF1ValueObj:AlcCode
      257         FormF1CodeItemQuery = inExtFormF1ValueObj:FormF1Code
      258       .
      259       if inExtFormF1ValueObj:AlcCode = ? or inExtFormF1ValueObj:AlcCode = ""
      260       then do:
      261         ReturnMsg = "Неверное значение AlcCode".
      262         if not IsSilent
      263           then message ReturnMsg view-as alert-box.
      264         AlcCodeItemQuery = "".
      265         FormF1CodeItemQuery = "".
      266         undo, return false.
      267       end.
      268       do trans:
      269         find first buf_ext-classif no-lock  where buf_ext-classif.classif-subject = 'EGAIS':U
      270           and buf_ext-classif.classif-name = 'FormF1-esys':U
      271           and buf_ext-classif.db-num = 0
      272           and buf_ext-classif.Key#_One = 0
      273           and buf_ext-classif.key#_two = ExtSystem
      274           and buf_ext-classif.key#_three = 0
      275           and buf_ext-classif.charkey_one = inExtFormF1ValueObj:AlcCode
      276           and buf_ext-classif.charkey_two = inExtFormF1ValueObj:FormF1Code
      277           and buf_ext-classif.charkey_three = ""
      278           and buf_ext-classif.nonunique = 0
      279           no-error.
      280         if available (buf_ext-classif)
      281           then
      282         do:
      283           ReturnMsg = "Уже есть запись товара ЕГАИС - " + inExtFormF1ValueObj:AlcCode + " cо справкой 1 - " + string (inExtFormF1ValueObj:FormF1Code).
      284           if not IsSilent
      285             then message ReturnMsg view-as alert-box.
      286           AlcCodeItemQuery = "".
      287           FormF1CodeItemQuery = "".
      288           undo, return false.
      289         end.
      290         create buf_ext-classif.
      291         assign
      292           buf_ext-classif.classif-subject = 'EGAIS':U
      293           buf_ext-classif.classif-name = 'FormF1-esys':U
      294           buf_ext-classif.db-num = 0
      295           buf_ext-classif.Key#_One = 0
      296           buf_ext-classif.key#_two = ExtSystem
      297           buf_ext-classif.key#_three = 0
      298           buf_ext-classif.charkey_one = inExtFormF1ValueObj:AlcCode
      299           buf_ext-classif.charkey_two = inExtFormF1ValueObj:FormF1Code
      300           buf_ext-classif.charkey_three = ""
      301           buf_ext-classif.nonunique = 0
      302           buf_ext-classif.uniq-key-rec = 'EGAIS':U + chr(3) + string (inExtFormF1ValueObj:FormF1Code)
      303         no-error.
      304         if error-status:error
      305           then
      306         do:
      307           delete buf_ext-classif.
      308           ReturnMsg = "Непредвиденная ошибка при создании связки  - " + inExtFormF1ValueObj:AlcCode + " TH - " + string (inExtFormF1ValueObj:FormF1Code).
      309           if not IsSilent
      310             then message ReturnMsg view-as alert-box.
      311           AlcCodeItemQuery = "".
      312           FormF1CodeItemQuery = "".
      313           undo, return false.
      314         end.
      315         create buf_ext-classif-attr.
      316         assign
      317           buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      318           buf_ext-classif-attr.classif-name    = buf_ext-classif.classif-name
      319           buf_ext-classif-attr.db-num          = buf_ext-classif.db-num
      320           buf_ext-classif-attr.Key#_One        = buf_ext-classif.key#_one
      321           buf_ext-classif-attr.Key#_two        = buf_ext-classif.key#_two
      322           buf_ext-classif-attr.Key#_three      = buf_ext-classif.key#_three
      323           buf_ext-classif-attr.CharKey_One     = buf_ext-classif.charkey_one
      324           buf_ext-classif-attr.CharKey_two     = buf_ext-classif.charkey_two
      325           buf_ext-classif-attr.CharKey_three   = buf_ext-classif.charkey_three
      326           buf_ext-classif-attr.nonunique       = buf_ext-classif.nonunique
      327           buf_ext-classif-attr.attr-code       = 'egais-info'
      328         no-error.
      329         if error-status:error
      330           then
      331         do:
      332           delete buf_ext-classif-attr.
      333           ReturnMsg = "Запись уже есть buf_ext-classif-attr. Создание будет продолжено. Непредвиденная ситуация при создании атрибута egais-info  - " + inExtFormF1ValueObj:AlcCode + " TH - " + string (inExtFormF1ValueObj:FormF1Code).
      334           if not IsSilent
      335             then message ReturnMsg view-as alert-box.
      336           find first buf_ext-classif-attr where
      337             buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      338             and buf_ext-classif-attr.classif-name    = buf_ext-classif.classif-name
      339             and buf_ext-classif-attr.db-num          = buf_ext-classif.db-num
      340             and buf_ext-classif-attr.Key#_One        = buf_ext-classif.key#_one
      341             and buf_ext-classif-attr.Key#_two        = buf_ext-classif.key#_two
      342             and buf_ext-classif-attr.Key#_three      = buf_ext-classif.key#_three
      343             and buf_ext-classif-attr.CharKey_One     = buf_ext-classif.charkey_one
      344             and buf_ext-classif-attr.CharKey_two     = buf_ext-classif.charkey_two
      345             and buf_ext-classif-attr.CharKey_three   = buf_ext-classif.charkey_three
      346             and buf_ext-classif-attr.nonunique       = buf_ext-classif.nonunique
      347             and buf_ext-classif-attr.attr-code       = 'egais-info'
      348           no-error.
      349         end.
      350         if not SaveEGAISInfoDB (inExtFormF1ValueObj)
      351           then do:
      352             AlcCodeItemQuery = "".
      353             FormF1CodeItemQuery = "".
      354             undo, return false.
      355           end.
      356       end.
      357       create ttObjEgaisAlcProp.
      358       NumBundles = 1.
      359       ttObjEgaisAlcProp.iExtFormF1Obj = 1.
      360       cast (ttObjEgaisAlcProp.ExtFormF1ValueObj, ibs.th.bge.egais.ExtFormF1Value) = inExtFormF1ValueObj.
      361       return true.
      362     end.
      363     method public logical DeleteExtFormF1 (inFormF1Code as character, inAlcCode as char):
      364       ReturnMsg = "".
      365       do trans:
      366         for each buf_ext-classif-attr exclusive-lock where
      367               buf_ext-classif-attr.classif-subject = 'EGAIS':U
      368           and buf_ext-classif-attr.classif-name = 'FormF1-esys':U
      369           and buf_ext-classif-attr.db-num = 0
      370           and (inFormF1Code = ? or inFormF1Code = "" or buf_ext-classif-attr.CharKey_Two = inFormF1Code)
      371           and buf_ext-classif-attr.key#_two = ExtSystem
      372           and (inAlcCode = ? or inAlcCode = "" or buf_ext-classif-attr.charkey_one = inAlcCode)
      373           :
      374           delete buf_ext-classif-attr.
      375         end.
      376         for each buf_ext-classif exclusive-lock where
      377               buf_ext-classif.classif-subject = 'EGAIS':U
      378           and buf_ext-classif.classif-name = 'FormF1-esys':U
      379           and buf_ext-classif.db-num = 0
      380           and buf_ext-classif.key#_two = ExtSystem
      381           and (inFormF1Code = ? or inFormF1Code = "" or buf_ext-classif.CharKey_Two = inFormF1Code)
      382           and (inAlcCode = ? or inAlcCode = "" or buf_ext-classif.charkey_one = inAlcCode)
      383           :
      384           delete buf_ext-classif.
      385         end.
      386       end.
      387       ClearProp ().
      388       return true.
      389     end.
      390     method public logical SaveEGAISInfo (inExtFormF1ValueObj as ExtFormF1Value):
      391       def var glog as log no-undo.
      392       do trans:
      393         find first buf_ext-classif-attr where
      394               buf_ext-classif-attr.classif-subject = 'EGAIS':U
      395           and buf_ext-classif-attr.classif-name = 'FormF1-esys':U
      396           and buf_ext-classif-attr.db-num = 0
      397           and buf_ext-classif-attr.Key#_One = 0
      398           and buf_ext-classif-attr.key#_two = ExtSystem
      399           and buf_ext-classif-attr.key#_three = 0
      400           and buf_ext-classif-attr.charkey_one = inExtFormF1ValueObj:AlcCode
      401           and buf_ext-classif-attr.charkey_two = inExtFormF1ValueObj:FormF1Code
      402           and buf_ext-classif-attr.charkey_three = ""
      403           and buf_ext-classif-attr.attr-code = 'egais-info' no-error
      404         .
      405         if not available (buf_ext-classif-attr)
      406           then do:
      407             create buf_ext-classif-attr.
      408             assign
      409               buf_ext-classif-attr.classif-subject = 'EGAIS':U
      410               buf_ext-classif-attr.classif-name = 'FormF1-esys':U
      411               buf_ext-classif-attr.db-num = 0
      412               buf_ext-classif-attr.Key#_One = 0
      413               buf_ext-classif-attr.key#_two = ExtSystem
      414               buf_ext-classif-attr.key#_three = 0
      415               buf_ext-classif-attr.charkey_one = inExtFormF1ValueObj:AlcCode
      416               buf_ext-classif-attr.charkey_two = inExtFormF1ValueObj:FormF1Code
      417               buf_ext-classif-attr.charkey_three = ""
      418               buf_ext-classif-attr.attr-code = 'egais-info'.
      419           end.
      420         glog = SaveEGAISInfoDB (inExtFormF1ValueObj).
      421       end.
      422       return glog.
      423     end.
      424     method private logical SaveEGAISInfoDB (inExtFormF1ValueObj as ExtFormF1Value):
      425       def var v-list-data  as char no-undo.
      426       def var v-msg   as char no-undo.
      427       ReturnMsg = "".
      428       listManagObj:WriteElement (v-list-data, "BottlingDate", inExtFormF1ValueObj:BottlingDate).
      429       listManagObj:WriteElement (v-list-data, "CliRegIdOrigCli", inExtFormF1ValueObj:CliRegIdOrigCli).
      430       listManagObj:WriteElement (v-list-data, "CliEgaisTypeOrigCli", inExtFormF1ValueObj:CliEgaisTypeOrigCli).
      431       listManagObj:WriteElement (v-list-data, "INNOrigCli", inExtFormF1ValueObj:INNOrigCli).
      432       listManagObj:WriteElement (v-list-data, "KPPOrigCli", inExtFormF1ValueObj:KPPOrigCli).
      433       listManagObj:WriteElement (v-list-data, "FullNameOrigCli", inExtFormF1ValueObj:FullNameOrigCli).
      434       listManagObj:WriteElement (v-list-data, "RegionOrigCli", inExtFormF1ValueObj:RegionOrigCli).
      435       listManagObj:WriteElement (v-list-data, "DescrOrigCli", inExtFormF1ValueObj:DescrOrigCli).
      436       buf_ext-classif-attr.attr-value = v-list-data.
      437       release buf_ext-classif-attr.
      438     end.
      439     method public void Release_ ():
      440       ClearProp().
      441     end.
      442     method public logical CopyEgaisInfo (inExtFormF1ValueObjForm as ExtFormF1Value, inExtFormF1ValueObjTo as ExtFormF1Value) :
      443       ReturnMsg = "".
      444       if not valid-object (inExtFormF1ValueObjForm) or not valid-object (inExtFormF1ValueObjTo)
      445       then do:
      446         ReturnMsg = "Не найден объект inExtFormF1ValueObjForm или inExtFormF1ValueObjTo".
      447         if not IsSilent
      448           then message ReturnMsg view-as alert-box.
      449         return false.
      450       end.
      451       assign
      452         inExtFormF1ValueObjTo:BottlingDate = inExtFormF1ValueObjForm:BottlingDate
      453         inExtFormF1ValueObjTo:CliRegIdOrigCli = inExtFormF1ValueObjForm:CliRegIdOrigCli
      454         inExtFormF1ValueObjTo:CliEgaisTypeOrigCli = inExtFormF1ValueObjForm:CliEgaisTypeOrigCli
      455         inExtFormF1ValueObjTo:INNOrigCli = inExtFormF1ValueObjForm:INNOrigCli
      456         inExtFormF1ValueObjTo:KPPOrigCli = inExtFormF1ValueObjForm:KPPOrigCli
      457         inExtFormF1ValueObjTo:FullNameOrigCli = inExtFormF1ValueObjForm:FullNameOrigCli
      458         inExtFormF1ValueObjTo:CountryOrigCli = inExtFormF1ValueObjForm:CountryOrigCli
      459         inExtFormF1ValueObjTo:RegionOrigCli = inExtFormF1ValueObjForm:RegionOrigCli
      460         inExtFormF1ValueObjTo:DescrOrigCli = inExtFormF1ValueObjForm:DescrOrigCli
      461       no-error.
      462       if error-status:error
      463       then do:
      464         ReturnMsg = "Ошибка присвоения свойств объекта inExtFormF1ValueObjTo".
      465         if not IsSilent
      466           then message ReturnMsg view-as alert-box.
      467         return false.
      468       end.
      469       return true.
      470     end.
      471     method private integer GetExtSystem ():
      472       define variable v-value-character as character no-undo .
      473       define variable v-value-decimal   as decimal   no-undo .
      474       define variable v-value-integer   as integer   no-undo .
      475       define variable v-value-logical   as logical   no-undo .
      476       define variable v-value-type      as character no-undo .
      477       define variable v-value-date      as date      no-undo .
      478       define variable v-ext-sys         as integer   no-undo .
      479       empty temp-table thbjattr_thbj-attr.
      480       run adm/shattri.p (
      481         input "get":U
      482         ,input '':U
      483         ,input 0
      484         ,input 'egais':U
      485         ,input 'egais-exsys':U
      486         ,output v-value-character
      487         ,output v-value-date
      488         ,output v-value-decimal
      489         ,output v-value-integer
      490         ,output v-value-logical
      491         ,output v-value-type
      492         ,input-output table thbjattr_thbj-attr
      493         ) no-error .
      494       return v-value-integer .
      495     end.
      496     method private void setProp (inJJ as int):
      497       def var v-prod  as char no-undo.
      498       def var v-impor as char no-undo.
      499       def var v-msg   as char no-undo.
      500       def var hndlclsExtFormF1ValueObj as class ExtFormF1Value no-undo.
      501       def var ExtFormF1ValueObj as class ExtFormF1Value no-undo.
      502       v-prod = ''.
      503       v-impor = ''.
      504       ReturnMsg = "".
      505       hndlclsExtFormF1ValueObj = new ExtFormF1Value().
      506       create ttObjEgaisAlcProp.
      507       assign
      508         ttObjEgaisAlcProp.iExtFormF1Obj = inJJ
      509         ttObjEgaisAlcProp.ExtFormF1ValueObj = cast (hndlclsExtFormF1ValueObj,Progress.Lang.Object).
      510       hndlclsExtFormF1ValueObj:AlcCode = buf_ext-classif.CharKey_One.
      511       hndlclsExtFormF1ValueObj:FormF1Code = buf_ext-classif.CharKey_Two.
      512       find current buf_ext-classif-attr no-lock no-error.
      513       if not available (buf_ext-classif-attr)
      514         then
      515       do:
      516         ReturnMsg = ReturnMsg + " Товар" + string (hndlclsExtFormF1ValueObj:AlcCode) + "/" + string (hndlclsExtFormF1ValueObj:FormF1Code) + ". Выполните синхронизацию товаров.".
      517         if not IsSilent
      518           then message ReturnMsg view-as alert-box.
      519       end.
      520       if available (buf_ext-classif-attr)
      521       then
      522         assign
      523           ExtFormF1ValueObj = GetInfoObj (buf_ext-classif-attr.attr-value)
      524         no-error.
      525       else
      526         assign
      527           ExtFormF1ValueObj = GetInfoObj ("")
      528         no-error.
      529       if ReturnMsg <> ""
      530         then
      531       do:
      532         ReturnMsg = ReturnMsg + " Товар" + string (hndlclsExtFormF1ValueObj:AlcCode) + "/" + string (hndlclsExtFormF1ValueObj:FormF1Code) + ". Выполните синхронизацию товаров.".
      533         if not IsSilent
      534           then message ReturnMsg view-as alert-box.
      535       end.
      536       ExtFormF1ValueObj:AlcCode = buf_ext-classif.CharKey_One.
      537       ExtFormF1ValueObj:FormF1Code = buf_ext-classif.CharKey_Two.
      538       assign
      539         hndlclsExtFormF1ValueObj:AlcCode = ExtFormF1ValueObj:AlcCode
      540         hndlclsExtFormF1ValueObj:FormF1Code = ExtFormF1ValueObj:FormF1Code
      541         hndlclsExtFormF1ValueObj:BottlingDate = ExtFormF1ValueObj:BottlingDate
      542         hndlclsExtFormF1ValueObj:CliRegIdOrigCli = ExtFormF1ValueObj:CliRegIdOrigCli
      543         hndlclsExtFormF1ValueObj:CliEgaisTypeOrigCli = ExtFormF1ValueObj:CliEgaisTypeOrigCli
      544         hndlclsExtFormF1ValueObj:INNOrigCli = ExtFormF1ValueObj:INNOrigCli
      545         hndlclsExtFormF1ValueObj:KPPOrigCli = ExtFormF1ValueObj:KPPOrigCli
      546         hndlclsExtFormF1ValueObj:FullNameOrigCli = ExtFormF1ValueObj:FullNameOrigCli
      547         hndlclsExtFormF1ValueObj:CountryOrigCli = ExtFormF1ValueObj:CountryOrigCli
      548         hndlclsExtFormF1ValueObj:RegionOrigCli = ExtFormF1ValueObj:RegionOrigCli
      549         hndlclsExtFormF1ValueObj:DescrOrigCli = ExtFormF1ValueObj:DescrOrigCli
      550       .
      551       if valid-object (ExtFormF1ValueObj)
      552         then delete object ExtFormF1ValueObj.
      553     end.
      554     method private void ClearProp ():
      555       AlcCodeItemQuery = "".
      556       FormF1CodeItemQuery = "".
      557       NumBundles = 0.
      558       for each ttObjEgaisAlcProp:
      559         if valid-object (ttObjEgaisAlcProp.ExtFormF1ValueObj)
      560           then delete object ttObjEgaisAlcProp.ExtFormF1ValueObj.
      561       end.
      562       empty temp-table ttObjEgaisAlcProp.
      563     end.
      564     method public class ExtFormF1Value GetInfoObj (inInfoValue as char):
      565       def var ExtFormF1ValueObj as class ExtFormF1Value no-undo.
      566       ExtFormF1ValueObj = new ExtFormF1Value().
      567       ExtFormF1ValueObj:BottlingDate = listManagObj:ReadElement (inInfoValue, "BottlingDate").
      568       ExtFormF1ValueObj:CliRegIdOrigCli =  listManagObj:ReadElement (inInfoValue, "CliRegIdOrigCli").
      569       ExtFormF1ValueObj:CliEgaisTypeOrigCli = listManagObj:ReadElement (inInfoValue, "CliEgaisTypeOrigCli").
      570       ExtFormF1ValueObj:INNOrigCli = listManagObj:ReadElement (inInfoValue, "INNOrigCli").
      571       ExtFormF1ValueObj:KPPOrigCli = listManagObj:ReadElement (inInfoValue, "KPPOrigCli").
      572       ExtFormF1ValueObj:FullNameOrigCli = listManagObj:ReadElement (inInfoValue, "FullNameOrigCli").
      573       ExtFormF1ValueObj:CountryOrigCli = listManagObj:ReadElement (inInfoValue, "CountryOrigCli").
      574       ExtFormF1ValueObj:RegionOrigCli = listManagObj:ReadElement (inInfoValue, "RegionOrigCli").
      575       ExtFormF1ValueObj:DescrOrigCli = listManagObj:ReadElement (inInfoValue, "DescrOrigCli").
      576       return ExtFormF1ValueObj.
      577     end.
      578   end class.
