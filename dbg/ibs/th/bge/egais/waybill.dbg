     1439       end.
     1440       find first buf_ext-classif no-lock where
     1441             buf_ext-classif.classif-name = 'egais-transId':U
     1442         and buf_ext-classif.db-num = 0
     1443         and buf_ext-classif.key#_one = v-ext-sys
     1444         and buf_ext-classif.CharKey_One = tt-wb-header.wbregid
     1445         and buf_ext-classif.CharKey_Two = ReplyId no-error.
     1446       if not available (buf_ext-classif)
     1447       then do:
     1448         create buf_ext-classif.
     1449         assign
     1450           buf_ext-classif.classif-name = 'egais-transId':U
     1451           buf_ext-classif.db-num = 0
     1452           buf_ext-classif.key#_one = v-ext-sys
     1453           buf_ext-classif.CharKey_One = tt-wb-header.wbregid
     1454           buf_ext-classif.CharKey_Two = ReplyId
