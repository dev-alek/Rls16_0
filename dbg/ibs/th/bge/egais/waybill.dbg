     1416             Msg       = "Не удалось разобрать данные от УТМ"
     1417             .
     1418           undo, return false.
     1419         end.
     1420         if not StatusErr
     1421           then
     1422           ReplyId = respValue:node-value.
     1423         else
     1424         do:
     1425           assign
     1426             StatusErr = true
     1427             Msg       = respValue:node-value
     1428             .
     1429           undo, return false.
