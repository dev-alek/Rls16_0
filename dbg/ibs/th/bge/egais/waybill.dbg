     2086                     v-clob-db-num = ?.
     2087                     v-int64-id = 0.
     2088                     ticketUKR = tt-ticket.regid + chr(4) + tt-ticket.docId + chr(4) + tt-ticket.Identity +  chr(4) + tt-ticket.ticket-date.
     2089                     if ticketUKR = ? or StatusErr
     2090                     then do:
     2091                       message "Ошибка приема файла запроса на распроведение накладной" ticketUKR skip urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     2092                       StatusErr = false.
     2093                       Msg = "".
     2094                       next url_.
     2095                     end.
     2096                     find first ub.doc-attr where ub.doc-attr.attr-code = 'negais':U and ub.doc-attr.attr-value = tt-ticket.regid no-error.
     2097                     if available (ub.doc-attr)
     2098                     then do:
     2099                       find first buf_doc-attr exclusive-lock where buf_doc-attr.doc-code = ub.doc-attr.doc-code and buf_doc-attr.attr-code = 'egais':U no-error.
     2100                       if not available (buf_doc-attr)
     2101                       then do:
     2102                         create buf_doc-attr.
     2103                         assign
     2104                           buf_doc-attr.doc-code = ub.doc-attr.doc-code
     2105                           buf_doc-attr.attr-code = 'egais':U
     2106                         .
     2107                       end.
     2108                       assign
     2109                         buf_doc-attr.attr-value = "Распроведена" when tt-ticket.status_ = "Accepted".
     2110                       release buf_doc-attr.
     2111                     end.
     2112                     if can-find (first buf_clob-bind where
     2113                           (buf_clob-bind.uniq-key-rec = ticketUKR or (buf_clob-bind.uniq-key-rec = tt-ticket.regid + chr(4) + tt-ticket.docId and (tt-ticket.Identity = ? or tt-ticket.Identity = "")))
     2114                       and buf_clob-bind.resource-type =  'egais-ticket':U)
     2115                       then next url_.
     2116                     run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2117                       ,input ",yes"
     2118                       ,input ?
     2119                       ,input ticketUKR
     2120                       ,input 'egais-wb-ticket':U
     2121                       ,input ''
     2122                       ,input-output v-part-num
     2123                       ,input 'egais-wb-ticket':U
     2124                       ,input-output v-clob-db-num
     2125                       ,input-output v-int64-id
     2126                       ,input search (inFileName)
     2127                       ,input ''
     2128                       ) no-error .
     2129                     if error-status:error then
     2130                     do:
     2131                       Msg = error-status:get-message(1) + chr(10) + return-value.
     2132                       StatusErr = false.
     2133                       next url_.
     2134                     end.
     2135                   end.
     2136                 when urlStr matches ("*opt/out/Ticket/*") then
     2137                   do:
     2138                     empty temp-table tt-ticket.
     2139                     os-delete "Ticket.xml".
     2140                     os-delete value (search ("Ticket.xml")).
     2141                     assign
     2142                       inFileName = "Ticket.xml"
     2143                       .
     2144                     CmdParseXml(urlStr).
     2145                     if StatusErr
     2146                     then do:
     2147                       message "Ошибка приема файла квитанции " urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     2148                       StatusErr = false.
     2149                       Msg = "".
     2150                       next url_.
     2151                     end.
     2152                     find first tt-ticket no-error.
     2153                     if not available (tt-ticket)
     2154                     then do:
     2155                       Msg = error-status:get-message(1) + chr(10) + return-value.
     2156                       message "Ошибка приема файла квитанции накладной" urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     2157                       StatusErr = false.
     2158                       next url_.
     2159                     end.
     2160                     v-clob-db-num = ?.
     2161                     v-int64-id = 0.
     2162                     ticketUKR = tt-ticket.regid + chr(4) + tt-ticket.docId + chr(4) + tt-ticket.Identity +  chr(4) + tt-ticket.ticket-date.
     2163                     if ticketUKR = ? or StatusErr
     2164                     then do:
     2165                       message "Ошибка приема файла квитанции " ticketUKR skip urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     2166                       StatusErr = false.
     2167                       Msg = "".
     2168                       next url_.
     2169                     end.
     2170                     find first ub.clob-bind where
     2171                           ub.clob-bind.resource-type = 'egais-wb':U
     2172                       and ((tt-ticket.regid <> "" and entry (5, ub.clob-bind.descr, chr(4)) = tt-ticket.regid) or lookup (tt-ticket.TransId, ub.clob-bind.field-name_) > 0) no-error.
     2173                     if available (ub.clob-bind)
     2174                     then do:
     2175                       if num-entries (ub.clob-bind.descr, chr(4)) < 10
     2176                       then do:
     2177                         ub.clob-bind.descr = ub.clob-bind.descr + chr(4).
     2178                       end.
     2179                       if entry (10, ub.clob-bind.descr, chr(4)) <> "Accepted"
     2180                       then do:
     2181                         entry (10, ub.clob-bind.descr, chr(4))  = tt-ticket.status_.
     2182                       end.
     2183                     end.
     2184                     if not (can-find (first buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb':U and lookup (tt-ticket.TransId, buf_clob-bind.field-name_) > 0)
     2185                         or can-find (first buf_clob-bind where buf_clob-bind.field-name_ = tt-ticket.TransId)
     2186                         or can-find (first buf_ext-classif where buf_ext-classif.classif-name = 'egais-transId':U
     2187                             and buf_ext-classif.db-num = 0
     2188                             and buf_ext-classif.key#_one = v-ext-sys
     2189                             and buf_ext-classif.CharKey_Two = tt-ticket.TransId))
     2190                     then do:
     2191                       if (tt-ticket.regid = "" or tt-ticket.regid = ?) or (tt-ticket.doc <> 'WayBillAct' and tt-ticket.doc <> 'WAYBILL')  then do:
     2192                         next url_.
     2193                       end.
     2194                     end.
     2195                     if can-find (first buf_clob-bind where
     2196                           ((buf_clob-bind.uniq-key-rec = ticketUKR or (buf_clob-bind.uniq-key-rec = tt-ticket.regid + chr(4) + tt-ticket.docId and (tt-ticket.Identity = ? or tt-ticket.Identity = "")))
     2197                       and buf_clob-bind.resource-type =  'egais-ticket':U))
     2198                       then next url_.
     2199                     run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2200                       ,input ",yes"
     2201                       ,input ?
     2202                       ,input ticketUKR
     2203                       ,input tt-ticket.TransId
     2204                       ,input ''
     2205                       ,input-output v-part-num
     2206                       ,input 'egais-ticket':U
     2207                       ,input-output v-clob-db-num
     2208                       ,input-output v-int64-id
     2209                       ,input search (inFileName)
     2210                       ,input ''
     2211                       ) no-error .
     2212                     if error-status:error then
     2213                     do:
     2214                       Msg = error-status:get-message(1) + chr(10) + return-value.
     2215                       StatusErr = false.
     2216                       next url_.
     2217                     end.
     2218                     if tt-ticket.regid <> ""
     2219                     then do:
     2220                       find first buf_ext-classif where buf_ext-classif.classif-name = 'egais-transId':U
     2221                               and buf_ext-classif.db-num = 0
     2222                               and buf_ext-classif.key#_one = v-ext-sys
     2223                               and buf_ext-classif.CharKey_Two = tt-ticket.TransId no-error.
     2224                       if available (buf_ext-classif) then do:
     2225                       find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.doc-code = buf_ext-classif.CharKey_One no-error.
     2226                         if not available (buf_doc-attr)
     2227                         then do:
     2228                           create buf_doc-attr.
     2229                           assign
     2230                             buf_doc-attr.doc-code = buf_ext-classif.CharKey_One
     2231                             buf_doc-attr.attr-value = tt-ticket.regid
     2232                             buf_doc-attr.attr-code = 'negais':U
     2233                           .
     2234                         end.
     2235                       end.
     2236                     end.
     2237                   end.
     2238               end case.
     2239             end.
     2240         end case.
     2241       end.
     2242       os-copy value (search ('ReceiptListOfQuery.xml')) value (v-FS-RAR + '_ReceiptListOfQuery.xml').
     2243       HndlAnaliz = buffer tt-analiz:handle.
     2244       empty temp-table tt-wb-info-client.
     2245       empty temp-table tt-wb-hndls.
     2246       empty temp-table tt-wb-act-hndls.
     2247       empty temp-table tt-wb-header.
     2248       empty temp-table tt-wb-gds-EG.
     2249       empty temp-table tt-wb-act-header.
     2250       empty temp-table tt-wb-act-gds-EG.
     2251     end.
     2252     method private void createhDoc (inRecCD as recid, inFileName as char, output outhDoc as handle ):
     2253       define buffer buf_cd for ub.clob-data.
     2254       find first buf_cd where recid (buf_cd) = inRecCD no-lock.
     2255       copy-lob
     2256         from  object buf_cd.cdata
     2257         to  file inFileName
     2258         no-convert
     2259         no-error .
     2260       create x-document outhDoc.
     2261       outhDoc:encoding = 'utf-8'.
     2262       outhDoc:load("file", search (inFileName), false).
     2263       release buf_cd.
     2264     end.
     2265     method private void createhDoc (inFileName as char, output outhDoc as handle ):
     2266       create x-document outhDoc.
     2267       outhDoc:encoding = 'utf-8'.
     2268       outhDoc:load("file", search (inFileName), false).
     2269     end.
     2270     method override public void SaveWB (inWbIdentity as char):
     2271       def var trn-doc-code as char no-undo.
     2272       find first buf_clob-bind no-lock where buf_clob-bind.uniq-key-rec = inWbIdentity and buf_clob-bind.resource-type = 'egais-wb':U no-error.
     2273       if not available (buf_clob-bind) then
     2274       do:
     2275         Msg = "Не найдена накладная с идентификатором " + inWbIdentity.
     2276         StatusErr = true.
     2277         return.
     2278       end.
     2279       if can-find (first tt-wb-gds-EG where tt-wb-gds-EG.RefA = "" or tt-wb-gds-EG.RefB = "")
     2280         then
     2281       do:
     2282         Msg = "Не для всех товаров есть сравка A или B ".
     2283         StatusErr = true.
     2284         return.
     2285       end.
     2286       do trans:
     2287         run ibs/th/bge/egais/AdapteeEGAISProcOra-i516.p
     2288           (
     2289           input table tt-wb-header,
     2290           input table tt-wb-gds-EG,
     2291           input User_Id,
     2292           input "",
     2293           input-output trn-doc-code
     2294           ) no-error.
     2295         if error-status:error then
     2296         do:
     2297           Msg = return-value.
     2298           StatusErr = true.
     2299           return.
     2300         end.
     2301         Msg = return-value.
     2302         if Msg <> ""
     2303         then do:
     2304           message Msg chr(10) "Сохранить?" view-as alert-box
     2305             question buttons yes-no
     2306             title "" update v-choise as logical.
     2307           if not v-choise then do:
     2308             Msg = "Отменено пользователем".
     2309             StatusErr = true.
     2310             return.
     2311           end.
     2312         end.
     2313         find current buf_clob-bind exclusive-lock.
     2314         entry (6, buf_clob-bind.descr, chr(4)) = trn-doc-code.
     2315         find current buf_clob-bind no-lock.
     2316       end.
     2317       find first tt-wb-hndls where tt-wb-hndls.uniq-key-rec = buf_clob-bind.uniq-key-rec no-error.
     2318       if not available (tt-wb-hndls)
     2319       then do:
     2320         Msg = "Непредвиденная ошибка." + buf_clob-bind.descr.
     2321         StatusErr = true.
     2322         return.
     2323       end.
     2324       release buf_clob-bind.
     2325       find first buf_trn-doc where buf_trn-doc.doc-code = trn-doc-code no-error.
     2326       tt-wb-hndls.trn-doc-code = trn-doc-code.
     2327       if available (buf_trn-doc)
     2328       then do:
     2329         tt-wb-hndls.status_ = buf_trn-doc.status_ + if buf_trn-doc.flag_ then "+" else "-".
     2330         tt-wb-hndls.isWB = true.
     2331       end.
     2332       release buf_trn-doc.
     2333     end.
     2334     method override public void RejectWB (inWbIdentity as char):
     2335       do trans:
     2336         find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = inWbIdentity and buf_clob-bind.resource-type = 'egais-wb':U no-error.
     2337         find current buf_clob-bind exclusive-lock.
     2338         entry (6, buf_clob-bind.descr, chr(4)) = 'отказ'.
     2339         find current buf_clob-bind no-lock.
     2340         find first tt-wb-hndls where tt-wb-hndls.uniq-key-rec = buf_clob-bind.uniq-key-rec no-error.
     2341         if not available (tt-wb-hndls)
     2342         then do:
     2343           Msg = "Непредвиденная ошибка. " + chr(10) + buf_clob-bind.descr.
     2344           StatusErr = true.
     2345           undo, return.
     2346         end.
     2347         if not available (buf_clob-bind) then
     2348         do:
     2349           Msg = "Не найдена накладная с идентификатором " + inWbIdentity.
     2350           StatusErr = true.
     2351           undo, return.
     2352         end.
     2353         if not SendRequestUTM()
     2354         then do:
     2355           Msg = "Не удалось отправить отказ - " + inWbIdentity + chr(10) + Msg.
     2356           StatusErr = true.
     2357           undo, return.
     2358         end.
     2359       end.
     2360       tt-wb-hndls.trn-doc-code = 'отказ'.
     2361     end.
     2362     method override public void ConnWB (inWbIdentity as char, inTrnDoc as char):
     2363       def buffer buf_tt-wb-gds-EG for tt-wb-gds-EG.
     2364       def var isErr     as logical no-undo.
     2365       def var isWarning as logical no-undo.
     2366       def var ischoise  as logical no-undo.
     2367       def var jj        as int     no-undo.
     2368       def var ii        as int     no-undo.
     2369       def var THSumm    as decimal no-undo.
     2370       def var EGAISSumm as decimal no-undo.
     2371       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = inWbIdentity and buf_clob-bind.resource-type = 'egais-wb':U no-error.
     2372       if not available (buf_clob-bind) then
     2373       do:
     2374         Msg = "Не найдена накладная с идентификатором " + inWbIdentity.
     2375         StatusErr = true.
     2376         return.
     2377       end.
     2378       find first buf_trn-doc where buf_trn-doc.doc-code = entry (6, buf_clob-bind.descr, chr(4)) no-error.
     2379       if entry (6, buf_clob-bind.descr, chr(4)) = 'отказ' or available (buf_trn-doc)
     2380       then do:
     2381         Msg = "Накладная уже связана или по ней был отказ.".
     2382         message  Msg + " Вы уверены, что хотите связать накладную?" view-as alert-box question buttons yes-no
     2383           title "" update isChoise.
     2384         if not isChoise then do:
     2385           StatusErr = true.
     2386           return.
     2387         end.
     2388         if not ActnEGAISAdm
     2389         then do:
     2390           Msg = 'Для связывания нужно право "Администрирование запросов в ЕГАИС"'.
     2391           StatusErr = true.
     2392           return.
     2393         end.
     2394       end.
     2395       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = inTrnDoc no-error.
     2396       if not available (buf_trn-doc)
     2397       then do:
     2398         Msg = "Не найдена накладная" + inTrnDoc.
     2399         StatusErr = true.
     2400         return.
     2401       end.
     2402       foreach1_:
     2403       for each tt-wb-gds-EG break by gds-code:
     2404         THSumm = 0.
     2405         EGAISSumm = 0.
     2406         ii = 0.
     2407         jj = 0.
     2408         if not first-of (gds-code) and last-of (gds-code)
     2409           then next foreach1_.
     2410         find first buf_gds no-lock where buf_gds.gds-code = tt-wb-gds-EG.gds-code no-error.
     2411         if not available (buf_gds)
     2412         then do:
     2413           Msg = Msg + (if Msg <> "" then chr(10) else '') + substitute ("Товар &1 &2 не имеет связки.", tt-wb-gds-EG.alc-code, tt-wb-gds-EG.gds-name).
     2414           isErr = true.
     2415         end.
     2416         else do:
     2417           for each ub.parts no-lock
     2418             where
     2419                   ub.parts.obj-code  = buf_trn-doc.obj-code
     2420               and ub.parts.obj-type  = buf_trn-doc.obj-type
     2421               and ub.parts.artic     = buf_gds.artic
     2422               and ub.parts.prod-type = buf_gds.prod-type
     2423               and ub.parts.prod-code = buf_gds.prod-code
     2424               and ub.parts.out-code  = inTrnDoc:
     2425             jj = jj + 1.
     2426             THSumm = THSumm + ub.parts.fact-qnty / ub.parts.cli-base-rate.
     2427             alcTypeAttrObj:GetAlcTypeAttr ( input tt-wb-gds-EG.alc-type-code,
     2428                                      input   "alc-min-price",
     2429                                      output  minPrice
     2430                                   ).
     2431             if ub.parts.price-rubl < minPrice or tt-wb-gds-EG.price < minPrice * ub.parts.cli-base-rate
     2432             then do:
     2433             Msg = Msg + (if Msg <> "" then chr(10) else '')
     2434               + substitute ("Для товара &5/&1 &2 цена в накладной ЕГАИС или TH меньше допустимой &6 (мин. доп. в ед. поставщика &8) по группе &7. В накладной ЕГАИС цена - &3 в накладной TH цена - &4.", tt-wb-gds-EG.alc-code, tt-wb-gds-EG.gds-name, tt-wb-gds-EG.price, ub.parts.price-rubl, buf_gds.gds-code, minPrice, tt-wb-gds-EG.alc-type-code, minPrice * ub.parts.cli-base-rate).
     2435             end.
     2436           end.
     2437           for each buf_tt-wb-gds-EG where buf_tt-wb-gds-EG.gds-code = buf_gds.gds-code:
     2438             ii = ii + 1.
     2439             EGAISSumm = EGAISSumm + buf_tt-wb-gds-EG.qnty.
     2440           end.
     2441           if EGAISSumm <> THSumm
     2442           then do:
     2443             isWarning = true.
     2444             Msg = Msg + (if Msg <> "" then chr(10) else '')
     2445               + substitute ("Не совпадает документарное кол-во. Для товара &5/&1 &2 в накладной ЕГАИС кол-во по партиям - &3 в накладной TH кол-во по партиям - &4.", tt-wb-gds-EG.alc-code, tt-wb-gds-EG.gds-name, EGAISSumm, THSumm, buf_gds.gds-code).
     2446           end.
     2447           if ii <> jj
     2448           then do:
     2449             isWarning = true.
     2450             Msg = Msg + (if Msg <> "" then chr(10) else '')
     2451               + substitute ("Для товара &5/&1 &2 в накладной ЕГАИС партий - &3 в накладной TH партий - &4.", tt-wb-gds-EG.alc-code, tt-wb-gds-EG.gds-name, ii, jj, buf_gds.gds-code).
     2452             if jj = 0
     2453               then Msg = Msg + chr(10)
     2454                 + substitute ("Для товара &1/&2 &3 при отправке накладной в ЕГАИС акт будет с расхождение и кол-во 0.", buf_gds.gds-code, tt-wb-gds-EG.alc-code, tt-wb-gds-EG.gds-name).
     2455           end.
     2456         end.
     2457       end.
     2458       for each ub.parts no-lock
     2459         where
     2460               ub.parts.out-code = inTrnDoc
     2461           and ub.parts.obj-code = buf_trn-doc.obj-code
     2462           and ub.parts.obj-type = buf_trn-doc.obj-type
     2463           :
     2464         find first buf_gds no-lock where
     2465                   ub.parts.artic     = buf_gds.artic
     2466               and ub.parts.prod-type = buf_gds.prod-type
     2467               and ub.parts.prod-code = buf_gds.prod-code.
     2468         find first tt-wb-gds-EG no-lock where tt-wb-gds-EG.gds-code = buf_gds.gds-code no-error.
     2469         if not available ( tt-wb-gds-EG )
     2470         then do:
     2471           isWarning = true.
     2472           Msg = Msg + (if Msg <> "" then chr(10) else '')
     2473             + substitute ("Товара &1 &2 в накладной TH отсутствует в накладной ЕГАИС.", buf_gds.gds-code, buf_gds.gds-name).
     2474         end.
     2475       end.
     2476       if isErr
     2477       then do:
     2478         StatusErr = true.
     2479         return.
     2480       end.
     2481       output stream outstr close.
     2482       output stream outstr to value ("warWBLog.txt").
     2483       put stream outstr unformatted Msg.
     2484       output stream outstr close.
     2485       if isWarning
     2486       then do:
     2487         message  Msg + chr(10) + " Вы уверены, что хотите связать накладную?" view-as alert-box question buttons yes-no
     2488           title "" update isChoise.
     2489         if not isChoise then do:
     2490           StatusErr = true.
     2491           return.
     2492         end.
     2493         if not ActnEGAISAdm
     2494         then do:
     2495           Msg = 'Для связывания нужно право "Администрирование запросов в ЕГАИС"'.
     2496           StatusErr = true.
     2497           return.
     2498         end.
     2499       end.
     2500       run ibs/th/bge/egais/AdapteeEGAISProcOra-i516.p
     2501         (
     2502         input table tt-wb-header,
     2503         input table tt-wb-gds-EG,
     2504         input User_Id,
     2505         input "conn",
     2506         input-output inTrnDoc
     2507         ) no-error.
     2508       if error-status:error then
     2509       do:
     2510         Msg = return-value.
     2511         StatusErr = true.
     2512         return.
     2513       end.
     2514       find current buf_clob-bind exclusive-lock.
     2515       entry (6, buf_clob-bind.descr, chr(4)) = inTrnDoc.
     2516       find current buf_clob-bind no-lock.
     2517       find first tt-wb-hndls where tt-wb-hndls.uniq-key-rec = buf_clob-bind.uniq-key-rec no-error.
     2518       if not available (tt-wb-hndls)
     2519       then do:
     2520         Msg = "Непредвиденная ошибка." + buf_clob-bind.descr.
     2521         StatusErr = true.
     2522         return.
     2523       end.
     2524       tt-wb-hndls.trn-doc-code = inTrnDoc.
     2525     end.
     2526     method public logical SendForceAccept ():
     2527       isForceAccept = true.
     2528       if not SendRequestUTM()
     2529       then do:
     2530         StatusErr = true.
     2531         return false.
     2532       end.
     2533       isForceAccept = false.
     2534       return true.
     2535     end.
     2536     method public logical ReleaseTable_ ():
     2537       release buf_clob-bind.
     2538       release buf_clob-bind-temp.
     2539       release buf_clob-bind-wb-hndls.
     2540       release buf_clob-data.
     2541     end.
     2542     method private longchar GetXMLAct ():
     2543       def var ii           as integer   no-undo.
     2544       def var xml-cont     as longchar  no-undo.
     2545       def var is-diff      as logical   no-undo.
     2546       def var docCodeList  as character no-undo.
     2547       def var VerXSDShip   as character no-undo.
     2548       find first tt-wb-header.
     2549       find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     2550         and buf_ext-classif-attr.classif-name = 'clients-esys':U
     2551         and buf_ext-classif-attr.db-num = 0
     2552         and buf_ext-classif-attr.key#_one = v-ext-sys
     2553         and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Ship
     2554         and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     2555       if available (buf_ext-classif-attr)
     2556       then
     2557         assign
     2558           VerXSDShip = entry (1, buf_ext-classif-attr.attr-value, chr(4))
     2559         no-error.
     2560       else VerXSDShip = 'WayBill'.
     2561       if not (available (buf_clob-bind) and entry (6, buf_clob-bind.descr, chr(4)) = 'отказ') and not isForceAccept then do:
     2562         docCodeList = "".
     2563         for each buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.attr-value begins (tt-wb-header.wbregid) :
     2564           if can-find (first buf_trn-doc where buf_trn-doc.doc-code = buf_doc-attr.doc-code and
     2565                 not (buf_trn-doc.status_ = 'факт':U))
     2566             then next.
     2567           docCodeList = docCodeList + "," + buf_doc-attr.doc-code.
     2568         end.
     2569         docCodeList = left-trim (docCodeList, ',').
     2570         if num-entries (docCodeList) > 1
     2571         then do:
     2572           Msg = substitute ("Несколько связанных накладных c одной накладной ЕГАИС wbregid - &1/&2. Для исправления пересвяжите накладную", tt-wb-header.wbregid, docCodeList) + chr(10).
     2573           for each buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.attr-value begins (tt-wb-header.wbregid):
     2574             Msg = Msg + "Накладаная - " + buf_doc-attr.doc-code + chr(10).
     2575           end.
     2576           StatusErr = true.
     2577           return ?.
     2578         end.
     2579         if docCodeList <> ""
     2580         then do:
     2581           find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.doc-code = docCodeList no-error.
     2582         end.
     2583         if not available (buf_doc-attr)
     2584         then do:
     2585           Msg = substitute ("Не найден атрибут документа с номером ЕГАИС WBRegID - &1, пересвяжите накладную", tt-wb-header.wbregid).
     2586           StatusErr = true.
     2587           return ?.
     2588         end.
     2589         foreach_:
     2590         for each tt-wb-gds-EG :
     2591           release buf_parts.
     2592           release buf_gds.
     2593           release buf_doc-line.
     2594           find first buf_gds no-lock where buf_gds.gds-code = tt-wb-gds-EG.gds-code no-error.
     2595           if available (buf_gds) then do:
     2596             find first buf_parts where
     2597               buf_parts.obj-type = tt-wb-header.obj-type and
     2598               buf_parts.obj-code = tt-wb-header.obj-code and
     2599               buf_parts.artic = buf_gds.artic and
     2600               buf_parts.prod-type = buf_gds.prod-type and
     2601               buf_parts.prod-code = buf_gds.prod-code and
     2602               buf_parts.out-code = buf_doc-attr.doc-code and
     2603               buf_parts.alc-ref-ab-path = tt-wb-gds-EG.refA + "," + tt-wb-gds-EG.refB + "," + tt-wb-gds-EG.alc-code + "," + tt-wb-gds-EG.alc-type-code no-lock no-error.
     2604           end.
     2605           if not available (buf_parts) then do:
     2606           find first buf_parts where
     2607               buf_parts.out-code = buf_doc-attr.doc-code and
     2608               buf_parts.obj-type = tt-wb-header.obj-type and
     2609               buf_parts.obj-code = tt-wb-header.obj-code and
     2610               buf_parts.alc-ref-ab-path = tt-wb-gds-EG.refA + "," + tt-wb-gds-EG.refB + "," + tt-wb-gds-EG.alc-code + "," + tt-wb-gds-EG.alc-type-code no-lock no-error.
     2611           end.
     2612           if not available (buf_parts) then do:
     2613             find first buf_doc-line no-lock where available (buf_gds) and buf_doc-line.doc-code = buf_doc-attr.doc-code and
     2614                buf_gds.artic = buf_doc-line.artic and buf_gds.prod-code = buf_doc-line.prod-code and buf_gds.prod-type = buf_doc-line.prod-type no-error.
     2615             if not available (buf_doc-line) then do:
     2616                 message "Не найден товар в накладной, который есть в ЕГАИС - " + buf_doc-attr.doc-code + " товар - " + string (tt-wb-gds-EG.gds-code) + " Продолжить с отправкой для данного товара в акте кол-ва 0?" view-as alert-box
     2617                   question buttons yes-no
     2618                   title "" update v-choise as logical.
     2619                 if not v-choise then do:
     2620                   Msg = "Отменено пользователем".
     2621                   StatusErr = true.
     2622                   return ?.
     2623                 end.
     2624                 is-diff = true.
     2625                 xml-cont = xml-cont + substitute ('<wa:Position><wa:Identity>&1</wa:Identity><wa:InformBRegId>&2</wa:InformBRegId><wa:RealQuantity>&3</wa:RealQuantity></wa:Position>', string (tt-wb-gds-EG.Identity), tt-wb-gds-EG.refB, 0.0).
     2626                 next foreach_.
     2627             end.
     2628             else do:
     2629                 Msg = "Не найдена партия для товара " + string (tt-wb-gds-EG.gds-code) + "/" + tt-wb-gds-EG.alc-code + " справка А " + tt-wb-gds-EG.refA + " справка Б " + tt-wb-gds-EG.refB + ". Документ - " + buf_doc-attr.doc-code +  "/" + buf_doc-attr.attr-value.
     2630                 StatusErr = true.
     2631                 return ?.
     2632             end.
     2633           end.
     2634           if tt-wb-gds-EG.qnty <> buf_parts.fact-qnty / buf_parts.cli-base-rate then
     2635           do:
     2636             is-diff = true.
     2637           end.
     2638           case tt-wb-header.verXSD:
     2639           when "WayBill_v2"
     2640           then
     2641             xml-cont = xml-cont + substitute ('<wa:Position><wa:Identity>&1</wa:Identity><wa:InformF2RegId>&2</wa:InformF2RegId><wa:RealQuantity>&3</wa:RealQuantity></wa:Position>', string (tt-wb-gds-EG.Identity), tt-wb-gds-EG.refB, string ( buf_parts.fact-qnty / buf_parts.cli-base-rate)).
     2642           when "WayBill"
     2643           then
     2644             xml-cont = xml-cont + substitute ('<wa:Position><wa:Identity>&1</wa:Identity><wa:InformBRegId>&2</wa:InformBRegId><wa:RealQuantity>&3</wa:RealQuantity></wa:Position>', string (tt-wb-gds-EG.Identity), tt-wb-gds-EG.refB, string ( buf_parts.fact-qnty / buf_parts.cli-base-rate)).
     2645           end case.
     2646         end .
     2647         case tt-wb-header.verXSD:
     2648         when "WayBill_v2"
     2649         then
     2650           return substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle_v2"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct_v2><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, (if is-diff then 'Differences' else 'Accepted'), buf_doc-attr.doc-code, iso-date (date (now)), tt-wb-header.wbregid, "Принимаем продукцию. " + (if is-diff then "Имеются расхождения." else "")) + (if is-diff then xml-cont else "") + '</wa:Content></ns:WayBillAct_v2></ns:Document></ns:Documents>'.
     2651         when "WayBill"
     2652         then
     2653           return substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Accepted', buf_doc-attr.doc-code, iso-date (date (now)), tt-wb-header.wbregid, "Принимаем продукцию. " + (if is-diff then "Имеются расхождения." else "")) + (if is-diff then xml-cont else "") + '</wa:Content></ns:WayBillAct></ns:Document></ns:Documents>'.
     2654         end case.
     2655       end.
     2656       else do:
     2657         if isForceAccept
     2658         then do:
     2659           find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.attr-value begins (tt-wb-header.wbregid) no-error.
     2660           case tt-wb-header.verXSD:
     2661           when "WayBill_v2"
     2662           then
     2663             xml-cont = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle_v2"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct_v2><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Accepted', (if available (buf_doc-attr) then buf_doc-attr.doc-code else string (time)), iso-date (date (now)), tt-wb-header.wbregid, "Принимаем продукцию") + '</wa:Content></ns:WayBillAct_v2></ns:Document></ns:Documents>'.
     2664           when "WayBill"
     2665           then
     2666             xml-cont = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Accepted', (if available (buf_doc-attr) then buf_doc-attr.doc-code else string (time)), iso-date (date (now)), tt-wb-header.wbregid, "Принимаем продукцию") + '</wa:Content></ns:WayBillAct></ns:Document></ns:Documents>'.
     2667           end case.
     2668         end.
     2669         else do:
     2670           if tt-wb-header.verXSD = 'WayBill_v2'
     2671           then
     2672             xml-cont = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle_v2"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct_v2><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Rejected', time, iso-date (date (now)), tt-wb-header.wbregid, "Отказ") + '</wa:Content></ns:WayBillAct_v2></ns:Document></ns:Documents>'.
     2673           else
     2674             xml-cont = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Rejected', time, iso-date (date (now)), tt-wb-header.wbregid, "Отказ") + '</wa:Content></ns:WayBillAct></ns:Document></ns:Documents>'.
     2675         end.
     2676         return xml-cont.
     2677       end.
     2678     end.
     2679     method private void CmdParseXml (inType as char):
     2680       define variable hDoc as handle no-undo.
     2681       cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, inType, inFileName).
     2682       os-command silent value (cmd).
     2683       file-info:file-name = search (inFileName).
     2684       if file-info:file-size = 0
     2685       then do:
     2686         Msg = substitute ('По адресу &1 получен пустой файл. Возможно нужно увеличить timeout в настройках INI файда секция EGAIS', inType).
     2687         StatusErr = true.
     2688         return.
     2689       end.
     2690       createhDoc(inFileName, output hDoc).
     2691       prsXMLDocWB:ParseRec (hDoc, input-output table tt-wb-header, input-output table tt-wb-act-header, input-output table tt-ticket, input-output table tt-wb-info-client, input-output table tt-wb-gds-EG).
     2692       find first tt-wb-header no-error.
     2693       find first tt-wb-act-header no-error.
     2694       find first tt-ticket no-error.
     2695       if not prsXMLDocWB:glog then
     2696       do:
     2697         Msg = 'Ошибка обработки xml'.
     2698         StatusErr = true.
     2699         return.
     2700       end.
     2701     end.
     2702     method private void WriteXMLWB (inFileName as char):
     2703       def var sw               as handle    no-undo.
     2704       def var VerXSDShip       as character no-undo.
     2705       def var VerXSDCons       as character no-undo.
     2706       def var CliEgaisTypeShip as character no-undo.
     2707       def var CliEgaisTypeCons as character no-undo.
     2708       def var ii               as integer   no-undo.
     2709       find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     2710         and buf_ext-classif-attr.classif-name = 'clients-esys':U
     2711         and buf_ext-classif-attr.db-num = 0
     2712         and buf_ext-classif-attr.key#_one = v-ext-sys
     2713         and buf_ext-classif-attr.CharKey_two = (tt-wb-header.obj-type + string(tt-wb-header.obj-code))
     2714         and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Ship
     2715         and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     2716       if available (buf_ext-classif-attr)
     2717       then
     2718         assign
     2719           VerXSDShip = entry (1, buf_ext-classif-attr.attr-value, chr(4))
     2720           CliEgaisTypeShip = entry (2, buf_ext-classif-attr.attr-value, chr(4))
     2721         no-error.
     2722       else VerXSDShip = 'WayBill'.
     2723       if VerXSDShip = ? or VerXSDShip = "" or VerXSDShip = "WayBill" or VerXSD = "1"
     2724       then do:
     2725         VerWBXsd = "WayBill".
     2726         verPrefXMLNS = "".
     2727       end.
     2728       else do:
     2729         VerWBXsd = "WayBill_v2".
     2730         verPrefXMLNS = "2".
     2731       end.
     2732       if VerWBXsd = "WayBill_v2"
     2733       then do:
     2734         find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     2735           and buf_ext-classif-attr.classif-name = 'clients-esys':U
     2736           and buf_ext-classif-attr.db-num = 0
     2737           and buf_ext-classif-attr.key#_one = v-ext-sys
     2738           and buf_ext-classif-attr.CharKey_two = (tt-wb-header.cli-type + string(tt-wb-header.cli-code))
     2739           and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Cons
     2740           and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     2741         if available (buf_ext-classif-attr)
     2742         then do:
     2743           assign
     2744             VerXSDCons = entry (1, buf_ext-classif-attr.attr-value, chr(4))
     2745             CliEgaisTypeCons = entry (2, buf_ext-classif-attr.attr-value, chr(4))
     2746           no-error.
     2747           if VerXSDCons = ? or VerXSDCons = ""
     2748           then do:
     2749             VerWBXsd = "WayBill".
     2750             verPrefXMLNS = "".
     2751           end.
     2752         end.
     2753         else do:
     2754           VerWBXsd = "WayBill".
     2755           verPrefXMLNS = "".
     2756         end.
     2757       end.
     2758       tt-wb-header.verXSD = VerWBXsd.
     2759       create sax-writer sw .
     2760       sw:formatted = true.
     2761       sw:set-output-destination ("file", inFileName).
     2762       sw:encoding = "UTF-8".
     2763       sw:start-document () .
     2764       sw:start-element ("ns:Documents") .
     2765       sw:insert-attribute ("Version", "1.0") .
     2766       case VerWBXsd:
     2767         when "WayBill" then do:
     2768           sw:insert-attribute ("xmlns:wb", "http://fsrar.ru/WEGAIS/TTNSingle").
     2769           sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01").
     2770           sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef").
     2771           sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef").
     2772         end.
     2773         when "WayBill_v2" then do:
     2774           sw:insert-attribute ("xmlns:wb2", "http://fsrar.ru/WEGAIS/TTNSingle_v2").
     2775           sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01").
     2776           sw:insert-attribute ("xmlns:oref2", "http://fsrar.ru/WEGAIS/ClientRef_v2").
     2777           sw:insert-attribute ("xmlns:pref2", "http://fsrar.ru/WEGAIS/ProductRef_v2").
     2778         end.
     2779       end case.
     2780       sw:start-element ("ns:Owner") .
     2781           sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     2782       sw:end-element ("ns:Owner") .
     2783       sw:start-element ("ns:Document") .
     2784         sw:start-element ("ns:" + VerWBXsd) .
     2785           sw:write-data-element ("wb" + verPrefXMLNS + ":Identity", tt-wb-header.Identity) .
     2786           sw:start-element ("wb" + verPrefXMLNS + ":Header") .
     2787             sw:write-data-element ("wb" + verPrefXMLNS + ":NUMBER", tt-wb-header.Identity).
     2788             sw:write-data-element ("wb" + verPrefXMLNS + ":Date", iso-date (tt-wb-header.wb-date)).
     2789             sw:write-data-element ("wb" + verPrefXMLNS + ":Type", tt-wb-header.wb-type).
     2790             if VerWBXsd = 'WayBill'
     2791               then sw:write-data-element ("wb" + verPrefXMLNS + ":UnitType", tt-wb-header.UnitType).
     2792             sw:write-data-element ("wb" + verPrefXMLNS + ":ShippingDate", iso-date (tt-wb-header.wb-date)).
     2793             sw:start-element ("wb" + verPrefXMLNS + ":Shipper") .
     2794               if VerWBXsd = 'WayBill_v2'
     2795                 then sw:start-element ("oref" + verPrefXMLNS + ":" + CliEgaisTypeShip) .
     2796               AddClientXML(sw, tt-wb-header.obj-type, tt-wb-header.obj-code, tt-wb-header.regID-Ship, yes).
     2797               if StatusErr
     2798                 then return.
     2799               if VerWBXsd = 'WayBill_v2'
     2800                 then sw:end-element ("oref" + verPrefXMLNS + ":" + CliEgaisTypeShip) .
     2801             sw:end-element ("wb" + verPrefXMLNS + ":Shipper") .
     2802             sw:start-element ("wb" + verPrefXMLNS + ":Consignee") .
     2803               if VerWBXsd = 'WayBill_v2'
     2804                 then sw:start-element ("oref" + verPrefXMLNS + ":" + CliEgaisTypeCons) .
     2805               AddClientXML(sw, tt-wb-header.cli-type, tt-wb-header.cli-code, tt-wb-header.regID-Cons, no).
     2806               if StatusErr
     2807                 then return.
     2808               if VerWBXsd = 'WayBill_v2'
     2809                 then sw:end-element ("oref" + verPrefXMLNS + ":" + CliEgaisTypeCons) .
     2810             sw:end-element ("wb" + verPrefXMLNS + ":Consignee") .
     2811             sw:start-element ("wb" + verPrefXMLNS + ":Transport") .
     2812             sw:end-element ("wb" + verPrefXMLNS + ":Transport") .
     2813           sw:end-element ("wb" + verPrefXMLNS + ":Header") .
     2814           sw:start-element ("wb" + verPrefXMLNS + ":Content") .
     2815           ii = 0.
     2816           for each tt-wb-gds-EG no-lock:
     2817             ii = ii + 1.
     2818             extGdsObj:OpenQueryExtGds (tt-wb-gds-EG.gds-code, tt-wb-gds-EG.alc-code).
     2819             if extGdsObj:NumBundles = 0
     2820             then do:
     2821               Msg = substitute ("Не найдена связка &1/&2. &3",tt-wb-gds-EG.gds-code, tt-wb-gds-EG.alc-code, extGdsObj:ReturnMsg).
     2822               extGdsObj:OpenQueryExtGds (tt-wb-gds-EG.alc-code).
     2823               if extGdsObj:NumBundles = 0
     2824               then do:
     2825                 StatusErr = true.
     2826                 return.
     2827               end.
     2828               else do:
     2829                 extGdsValueObj = extGdsObj:GetExtGdsValue().
     2830                 message substitute ("&1 Продолжить? (информация по алкокоду будет получена от &2/&3).", Msg + chr(10), string (extGdsValueObj:GdsCode), extGdsValueObj:AlcCode) view-as alert-box question buttons yes-no title "Вопрос..." update isChoise as logical.
     2831                 if isChoise
     2832                 then do:
     2833                   Msg = "".
     2834                 end.
     2835                 else do:
     2836                   StatusErr = true.
     2837                   return.
     2838                 end.
     2839               end.
     2840             end.
     2841             extGdsValueObj = extGdsObj:GetExtGdsValue().
     2842             sw:start-element ("wb" + verPrefXMLNS + ":Position") .
     2843               sw:write-data-element ("wb" + verPrefXMLNS + ":Identity", tt-wb-gds-EG.Identity).
     2844               sw:start-element ("wb" + verPrefXMLNS + ":Product") .
     2845                 sw:write-data-element ("pref" + verPrefXMLNS + ":FullName", extGdsValueObj:FullNameGds).
     2846                 sw:write-data-element ("pref" + verPrefXMLNS + ":AlcCode", tt-wb-gds-EG.alc-code).
     2847                 if VerWBXsd = 'WayBill_v2'
     2848                 then do:
     2849                   if tt-wb-gds-EG.UnitType = 'Packed' then sw:write-data-element ("pref" + verPrefXMLNS + ":Capacity", if extGdsValueObj:Capacity <> 0 and extGdsValueObj:Capacity <> ? then string (extGdsValueObj:Capacity) else string (tt-wb-gds-EG.ms-base)).
     2850                   sw:write-data-element ("pref" + verPrefXMLNS + ":UnitType", tt-wb-gds-EG.UnitType).
     2851                 end.
     2852                 else do:
     2853                   if tt-wb-header.UnitType = 'Packed' then sw:write-data-element ("pref" + verPrefXMLNS + ":Capacity", string (tt-wb-gds-EG.ms-base)).
     2854                 end.
     2855                 sw:write-data-element ("pref" + verPrefXMLNS + ":AlcVolume", string (tt-wb-gds-EG.proof)).
     2856                 sw:write-data-element ("pref" + verPrefXMLNS + ":ProductVCode", tt-wb-gds-EG.alc-type-code).
     2857                 if extGdsValueObj:FullNameProd = ""
     2858                 then do:
     2859                   StatusErr = true.
     2860                   Msg = extGdsObj:ReturnMsg + " У товара неизвестен производитель из ЕГАИС - " + string (tt-wb-gds-EG.gds-code) + ". Выполните синхронизацию товаров.".
     2861                   return.
     2862                 end.
     2863                 if VerWBXsd = 'WayBill_v2' and (extGdsValueObj:CliEgaisTypeProd = "")
     2864                 then do:
     2865                   StatusErr = true.
     2866                   Msg = Msg + extGdsObj:ReturnMsg + " У товара неизвестен тип производителя из ЕГАИС - " + string (tt-wb-gds-EG.gds-code) + ". Выполните синхронизацию товаров во второй схеме XSD." + chr(10).
     2867                 end.
     2868                 sw:start-element ("pref" + verPrefXMLNS + ":Producer") .
     2869                   if VerWBXsd = 'WayBill_v2' and not extGdsValueObj:CliEgaisTypeProd = ""
     2870                     then sw:start-element ("oref" + verPrefXMLNS + ":" + extGdsValueObj:CliEgaisTypeProd) .
     2871                   if not ( extGdsValueObj:INNProd = "" or extGdsValueObj:KPPProd = "")
     2872                   then do:
     2873                     sw:write-data-element ("oref" + verPrefXMLNS + ":INN",  extGdsValueObj:INNProd ).
     2874                     sw:write-data-element ("oref" + verPrefXMLNS + ":KPP", extGdsValueObj:KPPProd ).
     2875                   end.
     2876                   sw:write-data-element ("oref" + verPrefXMLNS + ":ClientRegId", extGdsValueObj:CliRegIdProd ).
     2877                   sw:write-data-element ("oref" + verPrefXMLNS + ":FullName", extGdsValueObj:FullNameProd ).
     2878                   sw:start-element ("oref" + verPrefXMLNS + ":address").
     2879                     sw:write-data-element ("oref" + verPrefXMLNS + ":Country", extGdsValueObj:CountryProd ).
     2880                     if VerWBXsd = "WayBill_v2" and extGdsValueObj:RegionProd <> ""
     2881                       then sw:write-data-element ("oref" + verPrefXMLNS + ":RegionCode", extGdsValueObj:RegionProd ).
     2882                     sw:write-data-element ("oref" + verPrefXMLNS + ":description", extGdsValueObj:DescrProd ).
     2883                   sw:end-element ("oref" + verPrefXMLNS + ":address").
     2884                   if VerWBXsd = 'WayBill_v2' and not extGdsValueObj:CliEgaisTypeProd = ""
     2885                     then sw:end-element ("oref" + verPrefXMLNS + ":" + extGdsValueObj:CliEgaisTypeProd) .
     2886                 sw:end-element ("pref" + verPrefXMLNS + ":Producer") .
     2887                 if not extGdsValueObj:FullNameImpor = "" and VerXSD <> '2' then do:
     2888                   sw:start-element ("pref" + verPrefXMLNS + ":Importer") .
     2889                     if not ( extGdsValueObj:INNImpor = "" or extGdsValueObj:KPPImpor = "")
     2890                     then do:
     2891                       sw:write-data-element ("oref" + verPrefXMLNS + ":INN",  extGdsValueObj:INNImpor ).
     2892                       sw:write-data-element ("oref" + verPrefXMLNS + ":KPP", extGdsValueObj:KPPImpor ).
     2893                     end.
     2894                     sw:write-data-element ("oref" + verPrefXMLNS + ":ClientRegId", extGdsValueObj:CliRegIdImpor ).
     2895                     sw:write-data-element ("oref" + verPrefXMLNS + ":FullName", extGdsValueObj:FullNameImpor ).
     2896                     sw:start-element ("oref" + verPrefXMLNS + ":address").
     2897                       sw:write-data-element ("oref" + verPrefXMLNS + ":Country", extGdsValueObj:CountryImpor ).
     2898                       sw:write-data-element ("oref" + verPrefXMLNS + ":description", extGdsValueObj:DescrImpor ).
     2899                     sw:end-element ("oref" + verPrefXMLNS + ":address").
     2900                   sw:end-element ("pref" + verPrefXMLNS + ":Importer") .
     2901                 end.
     2902               sw:end-element ("wb" + verPrefXMLNS + ":Product") .
     2903               sw:write-data-element ("wb" + verPrefXMLNS + ":Quantity", string (tt-wb-gds-EG.qnty)).
     2904               sw:write-data-element ("wb" + verPrefXMLNS + ":Price", string (tt-wb-gds-EG.price)).
     2905               case VerWBXsd:
     2906               when 'WayBill' then do:
     2907                 sw:start-element ("wb" + verPrefXMLNS + ":InformA") .
     2908                   sw:write-data-element ("pref" + verPrefXMLNS + ":RegId", tt-wb-gds-EG.refA).
     2909                 sw:end-element ("wb" + verPrefXMLNS + ":InformA") .
     2910                 sw:start-element ("wb" + verPrefXMLNS + ":InformB") .
     2911                   sw:start-element ("pref" + verPrefXMLNS + ":InformBItem") .
     2912                     sw:write-data-element ("pref" + verPrefXMLNS + ":BRegId", tt-wb-gds-EG.refB).
     2913                   sw:end-element ("pref" + verPrefXMLNS + ":InformBItem") .
     2914                 sw:end-element ("wb" + verPrefXMLNS + ":InformB") .
     2915               end.
     2916               when 'WayBill_v2' then do:
     2917                 sw:start-element ("wb" + verPrefXMLNS + ":InformF1") .
     2918                   sw:write-data-element ("pref" + verPrefXMLNS + ":RegId", tt-wb-gds-EG.refA).
     2919                 sw:end-element ("wb" + verPrefXMLNS + ":InformF1") .
     2920                 sw:start-element ("wb" + verPrefXMLNS + ":InformF2") .
     2921                   sw:start-element ("pref" + verPrefXMLNS + ":InformF2Item") .
     2922                     sw:write-data-element ("pref" + verPrefXMLNS + ":F2RegId", tt-wb-gds-EG.refB).
     2923                   sw:end-element ("pref" + verPrefXMLNS + ":InformF2Item") .
     2924                 sw:end-element ("wb" + verPrefXMLNS + ":InformF2") .
     2925               end.
     2926               end case.
     2927             sw:end-element ("wb" + verPrefXMLNS + ":Position") .
     2928           end.
     2929           if StatusErr
     2930           then do:
     2931             return.
     2932           end.
     2933           sw:end-element ("wb" + verPrefXMLNS + ":Content") .
     2934         sw:end-element ("ns:" + VerWBXsd) .
     2935       sw:end-element ("ns:Document") .
     2936       sw:end-element ("ns:Documents") .
     2937       delete object sw.
     2938     end.
     2939     method private void AddClientXML (inSW as handle, inObjType as char, inObjCode as int, inRegID as char, inShipper as log):
     2940       find first buf_clients no-lock where buf_clients.obj-type = inObjType and buf_clients.obj-code = inObjCode no-error.
     2941       if available (buf_clients)
     2942       then do:
     2943         if buf_clients.obj-type = 'орг':U
     2944         then do:
     2945           find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error.
     2946         end.
     2947         else do:
     2948           find first buf_firm no-lock where buf_firm.firm-code = buf_clients.host-code no-error.
     2949         end.
     2950         find first buf_clients-attr no-lock where buf_clients-attr.obj-type = inObjType and buf_clients-attr.obj-code = inObjCode
     2951           and buf_clients-attr.attr-code = 'kpp':U no-error.
     2952       end.
     2953       else do:
     2954         Msg = "Не найден клиент " + inObjType + string (inObjCode).
     2955         StatusErr = true.
     2956         return.
     2957       end.
     2958       if available (buf_firm) then do:
     2959         inSW:write-data-element ("oref" + verPrefXMLNS + ":INN", if INNObj = "" or INNObj = ? or not inShipper then buf_firm.inn else INNObj).
     2960         if buf_firm.kpp <> "" and (not buf_clients.obj-type = 'маг':U and not buf_clients.obj-type = 'скл':U) and not available (buf_clients-attr)
     2961           then inSW:write-data-element ("oref" + verPrefXMLNS + ":KPP", buf_firm.kpp).
     2962         if available (buf_clients-attr) and buf_clients-attr.attr-value <> ""
     2963           then inSW:write-data-element ("oref" + verPrefXMLNS + ":KPP", buf_clients-attr.attr-value).
     2964       end.
     2965       else do:
     2966         Msg = "Не найден ИНН организации или объекта " + inObjType + string (inObjCode).
     2967         StatusErr = true.
     2968         return.
     2969       end.
     2970       find first buf_clients-attr no-lock where buf_clients-attr.obj-type = inObjType and buf_clients-attr.obj-code = inObjCode
     2971         and buf_clients-attr.attr-code = 'requisite-alc-decl':U no-error.
     2972       inSW:write-data-element ("oref" + verPrefXMLNS + ":ClientRegId", inRegID).
     2973       if available (buf_clients-attr) and num-entries (buf_clients-attr.attr-value, "|") >= 20
     2974       then do:
     2975         inSW:write-data-element ("oref" + verPrefXMLNS + ":FullName", entry (1, attr-value, "|")).
     2976       end.
     2977       else do:
     2978         Msg = "Не заполнены/неполные атрибуты для алкогольной декларации. Заполните и синхронизируйте с ЕГАИС. Клиент - " + inObjType + string (inObjCode).
     2979         StatusErr = true.
     2980         return.
     2981       end.
     2982       inSW:start-element ("oref" + verPrefXMLNS + ":address").
     2983         if available (buf_clients-attr)
     2984         then do:
     2985           def var descr as char no-undo.
     2986           inSW:write-data-element ("oref" + verPrefXMLNS + ":Country", entry (3, buf_clients-attr.attr-value, "|")).
     2987           if VerWBXsd = "WayBill_v2"
     2988             then inSW:write-data-element ("oref" + verPrefXMLNS + ":RegionCode", entry (5, buf_clients-attr.attr-value, "|") ).
     2989           find first buf_country where buf_country.num-code = integer (entry (3, buf_clients-attr.attr-value, "|")) no-error.
     2990           descr = entry (20, buf_clients-attr.attr-value, "|") no-error.
     2991           descr = replace (descr, chr(5), "|").
     2992           if descr = ? or descr = ""
     2993           then do:
     2994             Msg = "Отсутствует андрес ЕГАИС организации " + inObjType + string (inObjCode) + ' ' + buf_clients.obj-name + ". Обновите данные ЕГАИС по организации.".
     2995             StatusErr = true.
     2996             return.
     2997           end.
     2998           inSW:write-data-element ("oref" + verPrefXMLNS + ":description", descr).
     2999         end.
     3000       inSW:end-element ("oref" + verPrefXMLNS + ":address").
     3001     end.
     3002     method private void GetVerXsd (output outVerDocXsd as char):
     3003       define variable CliEgaisTypeShip as character no-undo.
     3004       define variable CliEgaisTypeCons as character no-undo.
     3005       define variable VerXSDShip       as character no-undo.
     3006       find first tt-wb-header no-error.
     3007       if not available (tt-wb-header)
     3008       then do:
     3009         Msg = "Ошибка определения версии XSD схемы документа".
     3010         StatusErr = true.
     3011         return.
     3012       end.
     3013       find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     3014         and buf_ext-classif-attr.classif-name = 'clients-esys':U
     3015         and buf_ext-classif-attr.db-num = 0
     3016         and buf_ext-classif-attr.key#_one = v-ext-sys
     3017         and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Ship
     3018         and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     3019       if available (buf_ext-classif-attr)
     3020       then
     3021         assign
     3022           VerXSDShip = entry (1, buf_ext-classif-attr.attr-value, chr(4))
     3023           CliEgaisTypeShip = entry (2, buf_ext-classif-attr.attr-value, chr(4))
     3024         no-error.
     3025       else VerXSDShip = 'WayBill'.
     3026       if VerXSDShip = ? or VerXSDShip = "" or VerXSDShip = "WayBill" or VerXSD = "1"
     3027       then do:
     3028         outVerDocXsd = "WayBill".
     3029         verPrefXMLNS = "".
     3030       end.
     3031       else do:
     3032         outVerDocXsd = "WayBill_v2".
     3033         verPrefXMLNS = "2".
     3034       end.
     3035       if outVerDocXsd = "WayBill_v2"
     3036       then do:
     3037         find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     3038           and buf_ext-classif-attr.classif-name = 'clients-esys':U
     3039           and buf_ext-classif-attr.db-num = 0
     3040           and buf_ext-classif-attr.key#_one = v-ext-sys
     3041           and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Cons
     3042           and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     3043         if available (buf_ext-classif-attr)
     3044         then do:
     3045           assign
     3046             CliEgaisTypeCons = entry (2, buf_ext-classif-attr.attr-value, chr(4))
     3047           no-error.
     3048           if CliEgaisTypeCons = ? or CliEgaisTypeCons = ""
     3049           then do:
     3050             outVerDocXsd = "WayBill".
     3051             verPrefXMLNS = "".
     3052           end.
     3053         end.
     3054         else do:
     3055           outVerDocXsd = "WayBill".
     3056           verPrefXMLNS = "".
     3057         end.
     3058       end.
     3059     end.
     3060   end class.
