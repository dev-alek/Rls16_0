      289     constructor public WayBill (inObjType as char, inObjCode as int, inFSRAR as char, inExtSys as integer):
      290       super (inObjType, inObjCode).
      291       ObjCode = inObjCode.
      292       ObjType = inObjType.
      293       v-FS-RAR = inFSRAR.
      294       v-ext-sys = inExtSys.
      295       IsSent.
      296       extGdsObj = new ExtGds (yes).
      297       prsXMLDocWB = new ParserXMLDocWB(v-ext-sys).
      298       alcTypeAttrObj = new AlcTypeAttr ().
      299     end constructor.
      300     destructor WayBill ():
      301       if valid-object (extGdsObj)
      302         then delete object extGdsObj no-error.
      303       if valid-object (prgObj)
      304         then delete object prgObj.
      305       if valid-object (prsXMLDocWB)
      306         then delete object prsXMLDocWB.
      307       if valid-object (alcTypeAttrObj)
      308         then delete object alcTypeAttrObj.
      309     end.
      310     method public override handle GetHndlTable(inTableType as int, inWbIdentity as char) :
      311       define buffer buf_clob-bind-ref for ub.clob-bind.
      312       define buffer buf_clob-data-ref for ub.clob-data.
      313       define variable hDoc    as handle  no-undo.
      314       define variable hDocRef as handle  no-undo.
      315       define variable ii      as integer no-undo.
      316       assign
      317         StatusErr = false
      318         Msg       = ""
      319         .
      320       isForceAccept = false.
      321       case inTableType:
      322         when 1 or
      323         when 2 then
      324           do:
      325             if true
      326               then
      327             do:
      328               empty temp-table tt-wb-header.
      329               empty temp-table tt-wb-gds-EG.
      330               find first buf_clob-bind no-lock where buf_clob-bind.uniq-key-rec = inWbIdentity and buf_clob-bind.resource-type = 'egais-wb':U no-error.
      331               if not available (buf_clob-bind) then
      332               do:
      333                 find first buf_clob-bind no-lock
      334                   where num-entries (inWbIdentity, chr(6)) = 4 and
      335                     (buf_clob-bind.uniq-key-rec = entry (4, inWbIdentity, chr(6)) + chr(6) + entry (3, inWbIdentity, chr(6))
      336                     or buf_clob-bind.uniq-key-rec = entry (4, inWbIdentity, chr(6))) and
      337                     buf_clob-bind.resource-type = 'egais-wb':U
      338                 no-error.
      339                 if not available (buf_clob-bind) then
      340                 do:
      341                   Msg = "Не найдена накладная с идентификатором " + inWbIdentity.
      342                   StatusErr = true.
      343                   return ?.
      344                 end.
      345               end.
      346               v-uniq-key-rec = buf_clob-bind.uniq-key-rec.
      347               find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      348               createhDoc(recid (buf_clob-data), "temp.xml", output hDoc).
      349               find first buf_clob-bind-ref no-lock where buf_clob-bind-ref.uniq-key-rec = v-uniq-key-rec and buf_clob-bind-ref.resource-type = 'egais-ref-b':U no-error.
      350               if available (buf_clob-bind-ref) then
      351               do:
      352                 find first buf_clob-data-ref no-lock where buf_clob-data-ref.db-num = buf_clob-bind-ref.db-num and buf_clob-data-ref.int64-id = buf_clob-bind-ref.int64-id no-error.
      353                 createhDoc(recid (buf_clob-data-ref), "refbtemp.xml", output hDocRef).
      354                 prsXMLDocWB:ParseRec(hDoc, hDocRef, input-output table tt-wb-header, input-output table tt-wb-gds-EG, input-output table tt-wb-info-client).
      355               end.
      356               else do:
      357                 prsXMLDocWB:ParseRec(hDoc, ?, input-output table tt-wb-header, input-output table tt-wb-gds-EG, input-output table tt-wb-info-client).
      358               end.
      359               find first tt-wb-header.
      360               if not available ( tt-wb-header )
      361               then do:
      362                 message "Неудалось распарсить документ." view-as alert-box.
      363                 return ?.
      364               end.
      365               tt-wb-header.TransIdList = buf_clob-bind.field-name_.
      366               find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'clients':U
      367                 and buf_ext-classif.classif-name = 'clients-esys':U
      368                 and buf_ext-classif.db-num = 0
      369                 and buf_ext-classif.key#_one = v-ext-sys
      370                 and buf_ext-classif.CharKey_Three = tt-wb-header.regID-Ship no-error.
      371               if available (buf_ext-classif)
      372                 then
      373               do:
      374                 find first ub.clients no-lock where
      375                   ub.clients.obj-type = entry(2, buf_ext-classif.uniq-key-rec, chr(3)) and
      376                   ub.clients.obj-code = integer(entry(3, buf_ext-classif.uniq-key-rec, chr(3))).
      377                 if available (ub.clients) then
      378                 do:
      379                   find first ub.clients-attr where ub.clients-attr.attr-code = 'main-accholder':U
      380                     and ub.clients-attr.obj-code = ub.clients.obj-code and ub.clients-attr.obj-type = ub.clients.obj-type no-error.
      381                   if available (ub.clients-attr)
      382                   then do:
      383                     assign
      384                       tt-wb-header.cli-type = entry (1, ub.clients-attr.attr-value, ",")
      385                       tt-wb-header.cli-code = integer (entry (2, ub.clients-attr.attr-value, ","))
      386                       tt-wb-header.client   = entry (1, ub.clients-attr.attr-value, ",") + entry (2, ub.clients-attr.attr-value, ",")
      387                       tt-wb-header.cargo-from = ub.clients.obj-type + string (ub.clients.obj-code)
      388                       .
      389                   end.
      390                   else do:
      391                     assign
      392                       tt-wb-header.cli-type = ub.clients.obj-type
      393                       tt-wb-header.cli-code = ub.clients.obj-code
      394                       tt-wb-header.client   = ub.clients.obj-type + string (ub.clients.obj-code)
      395                       .
      396                   end.
      397                 end.
      398               end.
      399               find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'clients':U
      400                 and buf_ext-classif.classif-name = 'clients-esys':U
      401                 and buf_ext-classif.db-num = 0
      402                 and buf_ext-classif.key#_one = v-ext-sys
      403                 and buf_ext-classif.CharKey_Three = tt-wb-header.regID-Cons and buf_ext-classif.CharKey_Two = entry (9, buf_clob-bind.descr, chr(4)) no-error.
      404               if available (buf_ext-classif)
      405                 then
      406               do:
      407                 find first ub.clients no-lock where
      408                   ub.clients.obj-type = entry(2, buf_ext-classif.uniq-key-rec, chr(3)) and
      409                   ub.clients.obj-code = integer(entry(3, buf_ext-classif.uniq-key-rec, chr(3))).
      410                 if available (ub.clients) then
      411                 do:
      412                   assign
      413                     tt-wb-header.obj-type   = ub.clients.obj-type
      414                     tt-wb-header.obj-code   = ub.clients.obj-code
      415                     tt-wb-header.clientCons = ub.clients.obj-type + string (ub.clients.obj-code)
      416                     .
      417                 end.
      418               end.
      419               for each tt-wb-gds-EG:
      420                 if tt-wb-gds-EG.alc-code = ? or tt-wb-gds-EG.alc-code = ""
      421                 then do:
      422                   message "Документ распарсен с ошибками." view-as alert-box.
      423                   return ?.
      424                 end.
      425                 extGdsObj:OpenQueryExtGds(0, tt-wb-gds-EG.alc-code).
      426                 if extGdsObj:NumBundles = 1
      427                   then do:
      428                     tt-wb-gds-EG.gds-code = extGdsObj:GetExtGdsValue():GdsCode.
      429                     find first buf_tt-wb-gds-EG where buf_tt-wb-gds-EG.alc-code = tt-wb-gds-EG.alc-code and recid (buf_tt-wb-gds-EG) <> recid (tt-wb-gds-EG) no-error.
      430                     if available (buf_tt-wb-gds-EG)
      431                     then do:
      432                       buf_tt-wb-gds-EG.color-sts = DARK_GREY_COLOR.
      433                       tt-wb-gds-EG.color-sts = DARK_GREY_COLOR.
      434                     end.
      435                   end.
      436                   else do:
      437                     if extGdsObj:NumBundles > 1
      438                     then do:
      439                       assign tt-wb-gds-EG.gds-code = ?.
      440                       tt-wb-gds-EG.color-sts = DARK_GREY_COLOR.
      441                     end.
      442                     else assign tt-wb-gds-EG.gds-code = 0 tt-wb-gds-EG.color-sts = RED_COLOR.
      443                   end.
      444               end.
      445               if available (buf_clob-bind-ref) then
      446               do:
      447                 for each tt-wb-gds-EG where tt-wb-gds-EG.gds-code = ? :
      448                   nnList = lookup ( tt-wb-gds-EG.refB, buf_clob-bind-ref.descr).
      449                   if nnList > 0
      450                   then do:
      451                     extGdsObj:OpenQueryExtGds (integer (entry (nnList - 1, buf_clob-bind-ref.descr)), tt-wb-gds-EG.alc-code).
      452                     if extGdsObj:NumBundles > 0
      453                     then do:
      454                       tt-wb-gds-EG.gds-code = integer (entry (nnList - 1, buf_clob-bind-ref.descr)).
      455                     end.
      456                     else do:
      457                       tt-wb-gds-EG.color-sts = RED_COLOR.
      458                     end.
      459                   end.
      460                   else do:
      461                     tt-wb-gds-EG.color-sts = DARK_GREY_COLOR.
      462                   end.
      463                 end.
      464               end.
      465             end.
      466             HndlHeader = buffer tt-wb-header:handle.
      467             HndlLine = buffer tt-wb-gds-EG:handle.
      468             if inTableType = 1 then
      469             do:
      470               return buffer tt-wb-header:handle.
      471             end.
      472             else
      473             do:
      474               return buffer tt-wb-gds-EG:handle.
      475             end.
      476           end.
      477         when 8 or
      478         when 9 then
      479           do:
      480             if true
      481               then
      482             do:
      483               if inTableType = 8
      484                 then empty temp-table tt-wb-act-header.
      485                 else empty temp-table tt-wb-act-gds-EG.
      486               find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = inWbIdentity and buf_clob-bind.resource-type = 'egais-wb-act':U no-error.
      487               if not available (buf_clob-bind) then
      488               do:
      489                 Msg = "Не найден акт с идентификатором " + inWbIdentity.
      490                 StatusErr = true.
      491                 return ?.
      492               end.
      493               find first buf_clob-data exclusive-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      494               createhDoc(recid (buf_clob-data), "temp.xml", output hDoc).
      495               prsXMLDocWB:ParseRec (hDoc, input-output table tt-wb-act-header, input-output table tt-wb-act-gds-EG).
      496               find first tt-wb-act-header.
      497               find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.attr-value begins tt-wb-act-header.wbregid no-error.
      498               if available (buf_doc-attr) then do:
      499                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-attr.doc-code.
      500                 for each tt-wb-act-gds-EG :
      501                   find first buf_parts no-lock where
      502                    buf_parts.obj-type = buf_trn-doc.obj-type and
      503                    buf_parts.obj-code = buf_trn-doc.obj-code and
      504                    buf_parts.in-code = buf_trn-doc.doc-code and
      505                    buf_parts.out-code = buf_trn-doc.doc-code and
      506                    tt-wb-act-gds-EG.refB = entry (2, buf_parts.alc-ref-ab-path, ",") no-error.
      507                   if available (buf_parts) then do:
      508                     find first buf_gds no-lock where buf_gds.artic = buf_parts.artic and buf_gds.prod-code = buf_parts.prod-code and buf_gds.prod-type = buf_parts.prod-type.
      509                     assign
      510                       tt-wb-act-gds-EG.doc-qnty = buf_parts.qnty / buf_parts.cli-base-rate
      511                       tt-wb-act-gds-EG.fact-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
      512                       tt-wb-act-gds-EG.gds-code = buf_gds.gds-code
      513                     .
      514                   end.
      515                   else do:
      516                     assign
      517                       tt-wb-act-gds-EG.doc-qnty = ?
      518                       tt-wb-act-gds-EG.fact-qnty = ?
      519                       tt-wb-act-gds-EG.gds-code = ?
      520                     .
      521                   end.
      522                 end.
      523               end.
      524             end.
      525             HndlHeader = buffer tt-wb-header:handle.
      526             HndlLine = buffer tt-wb-gds-EG:handle.
      527             if inTableType = 8 then
      528             do:
      529               return buffer tt-wb-act-header:handle.
      530             end.
      531             else
      532             do:
      533               return buffer tt-wb-act-gds-EG:handle.
      534             end.
      535           end.
      536         when 3 then
      537           do:
      538             SettingsTTList = "20,yes;;;12,yes;9,yes;20,yes;10,yes;10,yes;6,yes;12,yes;;;30,yes;10,yes;;;;".
      539             egaisTTS = new TransferToShop (ObjType, ObjCode, v-FS-RAR, v-ext-sys).
      540             egaisTTS:DbNum =  DbNum.
      541             egaisTTS:User_Id = User_Id.
      542             bh-act-tts-header = egaisTTS:GetHndlTable(3, "").
      543             empty temp-table tt-wb-hndls.
      544             for each buf_clob-bind-wb-hndls no-lock where buf_clob-bind-wb-hndls.resource-type = 'egais-wb':U:
      545               if entry (9, buf_clob-bind-wb-hndls.descr, chr(4)) <> "" and entry (9, buf_clob-bind-wb-hndls.descr, chr(4)) <> "0" and entry (9, buf_clob-bind-wb-hndls.descr, chr(4)) <> ObjType + string (ObjCode)
      546                 then next.
      547               create tt-wb-hndls.
      548               assign
      549                 tt-wb-hndls.wb-date      = date (entry (1, buf_clob-bind-wb-hndls.descr, chr(4)))
      550                 tt-wb-hndls.num          = (if buf_clob-bind-wb-hndls.uniq-key-rec matches '*отмена*' or buf_clob-bind-wb-hndls.uniq-key-rec matches '*old*' then "отмена: " else "") + entry (2, buf_clob-bind-wb-hndls.descr, chr(4))
      551                 tt-wb-hndls.shippregid   = entry (3, buf_clob-bind-wb-hndls.descr, chr(4))
      552                 tt-wb-hndls.Identity     = entry (4, buf_clob-bind-wb-hndls.descr, chr(4))
      553                 tt-wb-hndls.trn-doc-code = entry (6, buf_clob-bind-wb-hndls.descr, chr(4))
      554                 tt-wb-hndls.is-sent      = entry (7, buf_clob-bind-wb-hndls.descr, chr(4))
      555                 tt-wb-hndls.wb-type      = "приход вн."
      556                   when entry (8, buf_clob-bind-wb-hndls.descr, chr(4)) = 'ie':U
      557                 tt-wb-hndls.wb-type      = "возврат вн."
      558                   when entry (8, buf_clob-bind-wb-hndls.descr, chr(4)) = 're':U
      559                 tt-wb-hndls.obj          = entry (9, buf_clob-bind-wb-hndls.descr, chr(4))
      560                 tt-wb-hndls.EGAISSts     = entry (10, buf_clob-bind-wb-hndls.descr, chr(4)) when num-entries (buf_clob-bind-wb-hndls.descr, chr(4)) > 9
      561                 tt-wb-hndls.uniq-key-rec = buf_clob-bind-wb-hndls.uniq-key-rec.
      562                 tt-wb-hndls.DbNUm        = buf_clob-bind-wb-hndls.db-num.
      563               .
      564               bh-act-tts-header:find-first (substitute ("where tt-act-header.num matches '*&1*'", trn-doc-code), no-lock ) no-error.
      565               if bh-act-tts-header:available
      566               then do:
      567                 tt-wb-hndls.tts = bh-act-tts-header:buffer-field ("num"):buffer-value ().
      568                 if num-entries (bh-act-tts-header:buffer-field ("RegID"):buffer-value (), chr(5) ) < 2
      569                 then do:
      570                   if bh-act-tts-header:buffer-field ("is-sent"):buffer-value = true
      571                   then do:
      572                     tt-wb-hndls.tts-status_ = 'Отправлен'.
      573                   end.
      574                   else do:
      575                     tt-wb-hndls.tts-status_ = 'Новый'.
      576                   end.
      577                 end.
      578                 else do:
      579                   case entry(2, bh-act-tts-header:buffer-field ("RegID"):buffer-value, chr(5)):
      580                   when "R" then do:
      581                     tt-wb-hndls.tts-status_ = 'Отклонен'.
      582                   end.
      583                   when "A" then do:
      584                     tt-wb-hndls.tts-status_ = 'Принят'.
      585                   end.
      586                   end case.
      587                 end.
      588               end.
      589               find first ub.ext-classif no-lock
      590                 where ub.ext-classif.classif-subject = 'clients':U
      591                   and ub.ext-classif.classif-name = 'clients-esys':U
      592                   and ub.ext-classif.db-num = 0
      593                   and ub.ext-classif.key#_one = v-ext-sys
      594                   and ub.ext-classif.CharKey_Three = tt-wb-hndls.shippregid
      595                   no-error.
      596               if available (ub.ext-classif) then do:
      597                 find first buf_clients where buf_clients.obj-type = entry (2, ub.ext-classif.uniq-key-rec, chr(3)) and buf_clients.obj-code = integer (entry (3, ub.ext-classif.uniq-key-rec, chr(3))) no-error.
      598                 if available (buf_clients)
      599                   then do:
      600                     tt-wb-hndls.cli = buf_clients.obj-type + string (buf_clients.obj-code).
      601                     tt-wb-hndls.cliname = buf_clients.obj-name.
      602                   end.
      603               end.
      604               assign
      605                 tt-wb-hndls.wbregid = entry (5, buf_clob-bind-wb-hndls.descr, chr(4)) no-error.
      606               if tt-wb-hndls.wbregid = ""
      607               then do:
      608                 if GetHndlTable(1, tt-wb-hndls.uniq-key-rec) <> ?
      609                 then do:
      610                   find first tt-wb-header no-error.
      611                   find first buf_clob-bind-temp where recid (buf_clob-bind-temp) = recid (buf_clob-bind-wb-hndls) exclusive-lock.
      612                   if available (tt-wb-header)
      613                     then
      614                       assign
      615                         tt-wb-hndls.wbregid = tt-wb-header.wbregid
      616                         entry (5, buf_clob-bind-temp.descr, chr(4)) = tt-wb-header.wbregid when available (buf_clob-bind-temp).
      617                       .
      618                   release buf_clob-bind-temp.
      619                 end.
      620               end.
      621               find first buf_trn-doc where buf_trn-doc.doc-code = tt-wb-hndls.trn-doc-code no-error.
      622               if available (buf_trn-doc)
      623                 then
      624                   assign
      625                   tt-wb-hndls.status_ = buf_trn-doc.status_ + (if buf_trn-doc.flag_ then "+" else "-")
      626                   tt-wb-hndls.isWB = true.
      627                 else tt-wb-hndls.isWB = false.
      628             end.
      629             if valid-object (egaisTTS)
      630               then delete object egaisTTS.
      631             return buffer tt-wb-hndls:handle.
      632           end.
      633         when 7 then
      634           do:
      635             SettingsTTList = "10,yes;;;".
      636             empty temp-table tt-wb-act-hndls.
      637             for each buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb-act':U:
      638               create tt-wb-act-hndls.
      639               assign
      640                 tt-wb-act-hndls.wbregid  = entry (1, buf_clob-bind.descr, chr(4))
      641                 tt-wb-act-hndls.act-date = date (entry (2, buf_clob-bind.descr, chr(4)))
      642                 tt-wb-act-hndls.num      = entry (3, buf_clob-bind.descr, chr(4))
      643                 tt-wb-act-hndls.status_  = entry (4, buf_clob-bind.descr, chr(4))
      644                 .
      645             end.
      646             return buffer tt-wb-act-hndls:handle.
      647           end.
      648         when 12 then
      649           do:
      650             empty temp-table tt-ticket.
      651             ii = 0.
      652             find current tt-wb-hndls no-error.
      653             find first ub.clob-bind where (available (tt-wb-hndls) and ub.clob-bind.resource-type = 'egais-wb':U and ub.clob-bind.uniq-key-rec = tt-wb-hndls.uniq-key-rec) no-error.
      654             for each buf_clob-bind where (buf_clob-bind.resource-type = 'egais-ticket':U and buf_clob-bind.uniq-key-rec begins inWbIdentity)
      655                                         or (available (ub.clob-bind) and not buf_clob-bind.uniq-key-rec begins inWbIdentity and buf_clob-bind.resource-type = 'egais-ticket':U and lookup (buf_clob-bind.field-name_, ub.clob-bind.field-name_) > 0)
      656                                         or can-find (first buf_ext-classif where buf_ext-classif.classif-name = 'egais-transId':U
      657                                           and buf_ext-classif.db-num = 0
      658                                           and buf_ext-classif.key#_one = v-ext-sys
      659                                           and buf_ext-classif.CharKey_One = inWbIdentity
      660                                           and buf_ext-classif.CharKey_Two = buf_clob-bind.field-name_):
      661               ii = ii + 1.
      662               find first buf_clob-data where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      663               createhDoc(recid (buf_clob-data), string (ii) + "temp.xml", output hDoc).
      664               prsXMLDocWB:IsToClearTable = false.
      665               prsXMLDocWB:ParseRec (hDoc, input-output table tt-ticket).
      666               prsXMLDocWB:IsToClearTable = true.
      667             end.
      668             for each buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb-ticket':U and buf_clob-bind.uniq-key-rec begins inWbIdentity :
      669               ii = ii + 1.
      670               find first buf_clob-data where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      671               createhDoc(recid (buf_clob-data), string (ii) + "temp.xml", output hDoc).
      672               prsXMLDocWB:IsToClearTable = false.
      673               prsXMLDocWB:ParseRec (hDoc, input-output table tt-ticket).
      674               prsXMLDocWB:IsToClearTable = true.
      675             end.
      676             return buffer tt-ticket:handle.
      677           end.
      678         when 13 then
      679           do:
      680             empty temp-table tt-ticket.
      681             for each buf_clob-bind where
      682               ((buf_clob-bind.resource-type = 'egais-ticket':U or buf_clob-bind.resource-type = 'egais-wb-ticket':U) and buf_clob-bind.uniq-key-rec matches "*" + inWbIdentity + "*")
      683               or (can-find (first buf_ext-classif where buf_ext-classif.classif-name = 'egais-transId':U
      684                     and buf_ext-classif.db-num = 0
      685                     and buf_ext-classif.key#_one = v-ext-sys
      686                     and buf_ext-classif.CharKey_One = inWbIdentity
      687                     and buf_ext-classif.CharKey_Two = buf_clob-bind.field-name_))
      688               :
      689               ii = ii + 1.
      690               find first buf_clob-data where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      691               createhDoc(recid (buf_clob-data), string (ii) + "temp.xml", output hDoc).
      692               prsXMLDocWB:IsToClearTable = false.
      693               prsXMLDocWB:ParseRec (hDoc, input-output table tt-ticket).
      694               prsXMLDocWB:IsToClearTable = true.
      695             end.
      696             find first tt-ticket where tt-ticket.regid <> "" no-error.
      697             if available (tt-ticket) then do:
      698               find first buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.doc-code = inWbIdentity no-error.
      699               if not available (buf_doc-attr)
      700               then do:
      701                 create buf_doc-attr.
      702                 assign
      703                   buf_doc-attr.doc-code = inWbIdentity
      704                   buf_doc-attr.attr-value = tt-ticket.regid
      705                   buf_doc-attr.attr-code = 'negais':U
      706                 .
      707               end.
      708               for each buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb-act':U and buf_clob-bind.uniq-key-rec matches "*" + buf_doc-attr.attr-value + "*" :
      709                 find first buf_clob-data where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      710                 create tt-ticket.
      711                 assign
      712                   tt-ticket.regid = entry (1, buf_clob-bind.descr, chr(4))
      713                   tt-ticket.ticket-date = string (iso-date (date (entry (2, buf_clob-bind.descr, chr(4)))))
      714                   tt-ticket.doc = entry (3, buf_clob-bind.descr, chr(4))
      715                   tt-ticket.status_ = entry (4, buf_clob-bind.descr, chr(4)).
      716                 createhDoc(recid (buf_clob-data), "temp.xml", output hDoc).
      717                 prsXMLDocWB:ParseRec (hDoc, input-output table tt-wb-act-header, input-output table tt-wb-act-gds-EG).
      718                 find first tt-wb-act-header no-error.
      719                 if available (tt-wb-act-header)
      720                 then do:
      721                   tt-ticket.comment = tt-wb-act-header.note.
      722                   find first ub.doc-attr exclusive-lock where ub.doc-attr.doc-code = inWbIdentity and ub.doc-attr.attr-code = 'egais':U no-error.
      723                   if not available (ub.doc-attr)
      724                   then do:
      725                     create ub.doc-attr.
      726                     assign
      727                       ub.doc-attr.doc-code = buf_doc-attr.doc-code
      728                       ub.doc-attr.attr-code = 'egais':U
      729                     .
      730                   end.
      731                   ub.doc-attr.attr-value = tt-wb-act-header.status_.
      732                   release ub.doc-attr.
      733                   tt-wb-hndls.EGAISSts = tt-wb-act-header.status_.
      734                 end.
      735               end.
      736             end.
      737             return buffer tt-ticket:handle.
      738           end.
      739         when 5 then
      740           do:
      741             SettingsTTList = "20,yes;;;12,yes;9,yes;20,yes;10,yes;;6,yes;12,yes;;;30,yes;10,yes;;;;".
      742             empty temp-table tt-wb-hndls.
      743             egaisTTS = new TransferToShop (ObjType, ObjCode, v-FS-RAR, v-ext-sys).
      744             egaisTTS:DbNum =  DbNum.
      745             egaisTTS:User_Id = User_Id.
      746             bh-act-tts-header = egaisTTS:GetHndlTable(3, "").
      747             for each buf_doc-attr no-lock where buf_doc-attr.attr-code = 'negais':U:
      748               for each buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-attr.doc-code and buf_trn-doc.status_ = 'факт':U and lookup (buf_trn-doc.doc-type, 'при,возврат':U) > 0 :
      749                 if ObjCode <> buf_trn-doc.obj-code or ObjType <> buf_trn-doc.obj-type
      750                   then next.
      751                 find first ub.doc-attr no-lock where ub.doc-attr.doc-code = buf_trn-doc.doc-code and ub.doc-attr.attr-code = 'egais':U no-error.
      752                 find first buf_clients where buf_clients.obj-code = buf_trn-doc.cli-code and buf_clients.obj-type = buf_trn-doc.cli-type no-lock.
      753                 find first ub.ext-classif no-lock
      754                   where ub.ext-classif.classif-subject = 'clients':U
      755                     and ub.ext-classif.classif-name = 'clients-esys':U
      756                     and ub.ext-classif.db-num = 0
      757                     and ub.ext-classif.key#_one = v-ext-sys
      758                     and ub.ext-classif.uniq-key-rec = 'clients':U + chr(3) + buf_trn-doc.cli-type + chr(3) + string (buf_trn-doc.cli-code)
      759                     no-error.
      760                 find first ub.doc-attr no-lock where ub.doc-attr.doc-code = buf_trn-doc.doc-code and ub.doc-attr.attr-code = 'egais':U no-error.
      761                 create tt-wb-hndls.
      762                 assign
      763                   tt-wb-hndls.wb-date      = buf_trn-doc.doc-date
      764                   tt-wb-hndls.num          = entry (2, buf_doc-attr.attr-value, chr(6))
      765                   tt-wb-hndls.trn-doc-code = buf_trn-doc.doc-code
      766                   tt-wb-hndls.cliname = buf_clients.obj-name
      767                   tt-wb-hndls.obj = buf_trn-doc.obj-type + string (buf_trn-doc.obj-code)
      768                   tt-wb-hndls.obj = buf_trn-doc.obj-type + string (buf_trn-doc.obj-code)
      769                   tt-wb-hndls.cli   = buf_trn-doc.cli-type + string (buf_trn-doc.cli-code)
      770                   tt-wb-hndls.uniq-key-rec = buf_doc-attr.attr-value
      771                   tt-wb-hndls.status_      = buf_trn-doc.status_ + (if buf_trn-doc.flag_ then "+" else "-")
      772                   tt-wb-hndls.EGAISSts     = if available (ub.doc-attr) and not ub.doc-attr.attr-value <> "" then ub.doc-attr.attr-value else ""
      773                   tt-wb-hndls.wbregid      = entry (1, buf_doc-attr.attr-value, chr(6)) no-error.
      774                   if tt-wb-hndls.EGAISSts <> "" and tt-wb-hndls.EGAISSts <> "Accepted"
      775                   then do:
      776                     find first buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb':U and buf_clob-bind.descr matches "*" + tt-wb-hndls.wbregid + "*" no-lock no-error.
      777                     if available (buf_clob-bind)
      778                     then do:
      779                       assign
      780                         tt-wb-hndls.EGAISSts = entry (10, buf_clob-bind.descr, chr(4)) when num-entries (buf_clob-bind.descr, chr(4)) > 9.
      781                       if not available (ub.doc-attr)
      782                       then do:
      783                         create ub.doc-attr.
      784                         assign
      785                           ub.doc-attr.doc-code = buf_trn-doc.doc-code
      786                           ub.doc-attr.attr-code = 'egais':U
      787                         .
      788                       end.
      789                       else do:
      790                         find current ub.doc-attr exclusive-lock.
      791                       end.
      792                       if tt-wb-hndls.EGAISSts <> ub.doc-attr.attr-value
      793                       then do:
      794                         assign
      795                           ub.doc-attr.attr-value = entry (10, buf_clob-bind.descr, chr(4)) when num-entries (buf_clob-bind.descr, chr(4)) > 9 and tt-wb-hndls.EGAISSts = "".
      796                       end.
      797                     end.
      798                     find current ub.doc-attr no-lock.
      799                   end.
      800                   if tt-wb-hndls.EGAISSts = ""
      801                   then do:
      802                     find first buf_clob-bind where buf_clob-bind.resource-type = 'egais-wb':U and buf_clob-bind.descr matches "*" + tt-wb-hndls.wbregid + "*" no-lock no-error.
      803                     if available (buf_clob-bind)
      804                     then do:
      805                       assign
      806                         tt-wb-hndls.EGAISSts = entry (10, buf_clob-bind.descr, chr(4)) when num-entries (buf_clob-bind.descr, chr(4)) > 9.
      807                       if not available (ub.doc-attr)
      808                       then do:
      809                         create ub.doc-attr.
      810                         assign
      811                           ub.doc-attr.doc-code = buf_trn-doc.doc-code
      812                           ub.doc-attr.attr-code = 'egais':U
      813                         .
      814                       end.
      815                       else do:
      816                         find current ub.doc-attr exclusive-lock.
      817                       end.
      818                       assign
      819                         ub.doc-attr.attr-value = entry (10, buf_clob-bind.descr, chr(4)) when num-entries (buf_clob-bind.descr, chr(4)) > 9.
      820                       find current ub.doc-attr no-lock.
      821                     end.
      822                   end.
      823                   assign
      824                     tt-wb-hndls.wb-type      = 'приход внешний':U when buf_trn-doc.ext-doc-type = 'ie':U
      825                     tt-wb-hndls.wb-type      = 'возврат внешний':U when buf_trn-doc.ext-doc-type = 're':U
      826                     tt-wb-hndls.wb-type      = 'возврат внутренний':U when buf_trn-doc.ext-doc-type = 'rv':U
      827                     tt-wb-hndls.wb-type      = 'приход внутренний':U when buf_trn-doc.ext-doc-type = 'iv':U
      828                   .
      829                   bh-act-tts-header:find-first (substitute ("where tt-act-header.num matches '*&1*'", trn-doc-code), no-lock ) no-error.
      830                   if bh-act-tts-header:available
      831                   then do:
      832                     tt-wb-hndls.tts = bh-act-tts-header:buffer-field ("num"):buffer-value ().
      833                     if num-entries (bh-act-tts-header:buffer-field ("RegID"):buffer-value (), chr(5) ) < 2
      834                     then do:
      835                       if bh-act-tts-header:buffer-field ("is-sent"):buffer-value = true
      836                       then do:
      837                         tt-wb-hndls.tts-status_ = 'Отправлен'.
      838                       end.
      839                       else do:
      840                         tt-wb-hndls.tts-status_ = 'Новый'.
      841                       end.
      842                     end.
      843                     else do:
      844                       case entry(2, bh-act-tts-header:buffer-field ("RegID"):buffer-value, chr(5)):
      845                       when "R" then do:
      846                         tt-wb-hndls.tts-status_ = 'Отклонен'.
      847                       end.
      848                       when "A" then do:
      849                         tt-wb-hndls.tts-status_ = 'Принят'.
      850                       end.
      851                       end case.
      852                     end.
      853                   end.
      854                   tt-wb-hndls.is-sent = if available (ub.doc-attr) then "да" else "".
      855                   entry (1, tt-wb-hndls.uniq-key-rec, chr(6)) = "".
      856                   tt-wb-hndls.uniq-key-rec = left-trim (tt-wb-hndls.uniq-key-rec, chr(6)).
      857                   if available (ub.ext-classif)
      858                     then tt-wb-hndls.shippregid = ub.ext-classif.CharKey_Three.
      859               end.
      860             end.
      861             if valid-object (egaisTTS)
      862               then delete object egaisTTS.
      863             return buffer tt-wb-hndls:handle.
      864           end.
      865         when 4 then
      866           do:
      867             SettingsTTList = "20,no;;;12,yes;9,yes;20,yes;17,yes;10,yes;6,yes;20,yes;;1,no;1,no;1,no;1,no;1,no;1,no;1,no".
      868             empty temp-table tt-wb-hndls.
      869               for each buf_trn-doc no-lock where buf_trn-doc.obj-code = ObjCode and buf_trn-doc.obj-type = ObjType
      870                 and (buf_trn-doc.status_ = 'факт':U or buf_trn-doc.status_ = 'разрешен':U)
      871                 and (buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'ee':U) :
      872                 find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'clients':U
      873                   and buf_ext-classif.classif-name = 'clients-esys':U
      874                   and buf_ext-classif.db-num = 0
      875                   and buf_ext-classif.key#_one = v-ext-sys
      876                   and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + buf_trn-doc.cli-type + chr(3) + string (buf_trn-doc.cli-code)
      877                   no-error.
      878                 if not available (buf_ext-classif)
      879                   then next.
      880                 find first buf_doc-attr no-lock where buf_doc-attr.doc-code = buf_trn-doc.doc-code and buf_doc-attr.attr-code = 'egais':U  no-error.
      881                 create tt-wb-hndls.
      882                 assign
      883                   tt-wb-hndls.wb-date      = buf_trn-doc.doc-date
      884                   tt-wb-hndls.trn-doc-code = buf_trn-doc.doc-code
      885                   tt-wb-hndls.obj          = buf_trn-doc.obj-type + string (buf_trn-doc.obj-code)
      886                   tt-wb-hndls.cli          = buf_trn-doc.cli-type + string (buf_trn-doc.cli-code)
      887                   tt-wb-hndls.cliname      = buf_trn-doc.cli-name
      888                   tt-wb-hndls.shippregid   = buf_ext-classif.charkey_three when available (buf_ext-classif)
      889                   tt-wb-hndls.wb-type      = 'возврат пост.':U when buf_trn-doc.ext-doc-type = 'ep':U
      890                   tt-wb-hndls.wb-type      = 'расход внутренний':U when buf_trn-doc.ext-doc-type = 'ev':U
      891                   tt-wb-hndls.wb-type      = 'расход внешний':U when buf_trn-doc.ext-doc-type = 'ee':U
      892                   tt-wb-hndls.EGAISSts     = if available (buf_doc-attr) and not buf_doc-attr.attr-value = '1':U then buf_doc-attr.attr-value else ""
      893                   tt-wb-hndls.EGAISSts     = 'Накладная отправлена':U when  available (buf_doc-attr) and buf_doc-attr.attr-value = '1':U
      894                   tt-wb-hndls.EGAISSts     = "не отправлена" when not available (buf_doc-attr)
      895                   tt-wb-hndls.wbregid      = buf_doc-attr.attr-value when available (buf_doc-attr)
      896                   tt-wb-hndls.status_      = buf_trn-doc.status_ + (if buf_trn-doc.flag_ then "+" else "-")
      897                 .
      898               end.
      899             return buffer tt-wb-hndls:handle.
      900           end.
      901         when 10 or
      902         when 11 then
      903           do:
      904             empty temp-table tt-wb-header.
      905             empty temp-table tt-wb-gds-EG.
      906             ii = 0.
      907             find first buf_trn-doc no-lock where buf_trn-doc.doc-code = inWbIdentity no-error.
      908             if not available (buf_trn-doc)
      909             then do:
      910               Msg = "Не найдена накладная" + inWbIdentity.
      911               StatusErr = true.
      912               return ?.
      913             end.
      914             if buf_trn-doc.fact-date = ?
      915             then do:
      916               Msg = "Неизвестная фактическая дата накладной: " + inWbIdentity + ". Установите фактическую дату в накладной.".
      917               StatusErr = true.
      918               return ?.
      919             end.
      920             create tt-wb-header.
      921             assign
      922               tt-wb-header.Identity = buf_trn-doc.doc-code
      923               tt-wb-header.wb-type = "WBReturnFromMe" when buf_trn-doc.ext-doc-type = 'ep':U
      924               tt-wb-header.wb-type = "WBInvoiceFromMe" when buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'ee':U
      925               tt-wb-header.wb-date = buf_trn-doc.fact-date
      926               tt-wb-header.cli-code = buf_trn-doc.cli-code
      927               tt-wb-header.cli-type = buf_trn-doc.cli-type
      928               tt-wb-header.obj-type = buf_trn-doc.obj-type
      929               tt-wb-header.obj-code = buf_trn-doc.obj-code
      930             .
      931             find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'clients':U
      932               and buf_ext-classif.classif-name = 'clients-esys':U
      933               and buf_ext-classif.db-num = 0
      934               and buf_ext-classif.key#_one = v-ext-sys
      935               and buf_ext-classif.CharKey_Two = buf_trn-doc.obj-type + string (buf_trn-doc.obj-code) no-error.
      936             if not available (buf_ext-classif)
      937             then do:
      938               Msg = "Не найден клиент ЕГАИС для объекта " + buf_trn-doc.obj-type + string (buf_trn-doc.obj-code).
      939               StatusErr = true.
      940               return ?.
      941             end.
      942             tt-wb-header.regID-Ship = buf_ext-classif.CharKey_Three.
      943             find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'clients':U
      944               and buf_ext-classif.classif-name = 'clients-esys':U
      945               and buf_ext-classif.db-num = 0
      946               and buf_ext-classif.key#_one = v-ext-sys
      947               and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + buf_trn-doc.cli-type + chr(3) + string (buf_trn-doc.cli-code) no-error.
      948             if not available (buf_ext-classif)
      949             then do:
      950               Msg = "Не найден клиент ЕГАИС для контрагента " + buf_trn-doc.cli-type + string (buf_trn-doc.cli-code).
      951               StatusErr = true.
      952               return ?.
      953             end.
      954             tt-wb-header.regID-Cons = buf_ext-classif.CharKey_Three.
      955             for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code:
      956               for each buf_parts no-lock where
      957                 buf_parts.obj-type = buf_trn-doc.obj-type and
      958                 buf_parts.obj-code = buf_trn-doc.obj-code and
      959                 buf_parts.artic = buf_doc-line.artic and
      960                 buf_parts.prod-type = buf_doc-line.prod-type and
      961                 buf_parts.prod-code = buf_doc-line.prod-code and
      962                 buf_parts.out-code = buf_trn-doc.doc-code:
      963                 ii = ii + 1.
      964                 find first buf_gds no-lock where buf_gds.artic = buf_parts.artic and buf_gds.prod-code = buf_parts.prod-code and buf_gds.prod-type = buf_parts.prod-type.
      965                 if num-entries (buf_parts.alc-ref-ab-path, ",") < 3
      966                 then do:
      967                   Msg = "В алкогольных атрибутах по партии отсутсвует алкогольный код и код группы для товара - " + string (buf_gds.gds-code) + ".".
      968                   StatusErr = true.
      969                   return ?.
      970                 end.
      971                 find first ub.gds-dtl where
      972                       ub.gds-dtl.doc-code = buf_doc-line.doc-code
      973                   and ub.gds-dtl.artic = buf_parts.artic
      974                   and ub.gds-dtl.prod-type = buf_parts.prod-type
      975                   and ub.gds-dtl.prod-code = buf_parts.prod-code no-error.
      976                 if not available (ub.gds-dtl)
      977                 then do:
      978                   Msg = "Отсутствует gds-dtl - " + string (buf_parts.artic) + ".".
      979                   StatusErr = true.
      980                   return ?.
      981                 end.
      982                 create tt-wb-gds-EG.
      983                 assign
      984                   tt-wb-gds-EG.Identity = string (ii)
      985                   tt-wb-gds-EG.gds-code = buf_gds.gds-code
      986                   tt-wb-gds-EG.qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
      987                   tt-wb-gds-EG.price = buf_parts.price-cli when buf_trn-doc.ext-doc-type = 'ep':U
      988                   tt-wb-gds-EG.price = ub.gds-dtl.price-rubl when buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'ee':U
      989                   tt-wb-gds-EG.refA = entry (1, buf_parts.alc-ref-ab-path, ",")
      990                   tt-wb-gds-EG.refB = entry (2, buf_parts.alc-ref-ab-path, ",")
      991                   tt-wb-gds-EG.alc-code = entry (3, buf_parts.alc-ref-ab-path, ",")
      992                   tt-wb-gds-EG.alc-type-code = entry (4, buf_parts.alc-ref-ab-path, ",")
      993                 .
      994                 if tt-wb-gds-EG.refA = "" or tt-wb-gds-EG.refB = "" or tt-wb-gds-EG.refA = ? or tt-wb-gds-EG.refB = ?
      995                 then do:
      996                   Msg = "Не найдена справка А или Б к партии - " + buf_parts.out-code + ". Товар - " + string (buf_gds.gds-code) + "  " + buf_gds.gds-name.
      997                   StatusErr = true.
      998                   return ?.
      999                 end.
     1000                 find first ub.alc-type-gds
     1001                      where ub.alc-type-gds.gds-code = buf_gds.gds-code
     1002                        and ub.alc-type-gds.create-user-db-num = 0 no-lock no-error.
     1003                 if not available (ub.alc-type-gds)
     1004                 then do:
     1005                   Msg = "Не задана алкогольная группа у товара " + string (buf_gds.gds-code).
     1006                   StatusErr = true.
     1007                   return ?.
     1008                 end.
     1009                 find first ub.alc-type where ub.alc-type-gds.alc-type-inner-code = ub.alc-type.alc-type-inner-code no-lock no-error.
     1010                 if not available (ub.alc-type)
     1011                 then do:
     1012                   Msg = "Не найдена алкогольная группа у товара" + string (buf_gds.gds-code).
     1013                   StatusErr = true.
     1014                   return ?.
     1015                 end.
     1016                 alcTypeAttrObj:GetAlcTypeAttr ( input tt-wb-gds-EG.alc-type-code,
     1017                                          input   "alc-min-price",
     1018                                          output  minPrice
     1019                                       ) no-error.
     1020                 if tt-wb-gds-EG.price < minPrice * buf_gds.cli-base-rate
     1021                 then do:
     1022                 Msg = Msg + (if Msg <> "" then chr(10) else '')
     1023                   + substitute ("Для товара &2/&1 &3 цена в накладной &4 меньше допустимой &5 по группе &6.", tt-wb-gds-EG.alc-code, buf_gds.gds-code, tt-wb-gds-EG.gds-name, tt-wb-gds-EG.price / buf_gds.cli-base-rate, minPrice, tt-wb-gds-EG.alc-type-code).
     1024                 end.
     1025                 assign
     1026                   tt-wb-gds-EG.ms-base = buf_gds.ms-base
     1027                   tt-wb-gds-EG.proof = buf_gds.proof
     1028                   tt-wb-gds-EG.alc-type-code = ub.alc-type.alc-type-code
     1029                 .
     1030                 if buf_doc-line.unit-cli <> buf_gds.unit-base and buf_doc-line.unit-cli > ""
     1031                 then do:
     1032                   tt-wb-gds-EG.UnitType = 'Unpacked'.
     1033                   if tt-wb-header.UnitType = '' or  tt-wb-header.UnitType = 'Packed' then tt-wb-header.UnitType = 'Unpacked'.
     1034                 end.
     1035                 else do:
     1036                   tt-wb-gds-EG.UnitType = 'Packed'.
     1037                   if tt-wb-header.UnitType <> 'Unpacked' then tt-wb-header.UnitType = 'Packed'.
     1038                 end.
     1039               end.
     1040             end.
     1041           end.
     1042       end case.
     1043     end.
     1044     method override public logical SendRequestUTM ():
     1045       def var ii        as int    no-undo.
     1046       def var xml-cont  as char   no-undo.
     1047       def var verDocXsd as char   no-undo.
     1048       def var respValue as handle no-undo.
     1049       assign
     1050         StatusErr = false
     1051         Msg       = ""
     1052         .
     1053       output stream outstr close.
     1054       if IsSent
     1055         then
     1056       do:
     1057         Msg = "Запрос уже был отправлен".
     1058         StatusErr = true.
     1059         return no.
     1060       end.
     1061       do trans:
     1062         os-delete "RespTTNAct.xml".
     1063         os-delete value (search ("RespTTNAct.xml")).
     1064         assign
     1065           inFileName = "RespTTNAct.xml"
     1066           .
     1067         find first tt-wb-header.
     1068         find first tt-wb-hndls where tt-wb-header.uniq-key-rec = tt-wb-hndls.uniq-key-rec no-error.
     1069         if available (tt-wb-hndls)
     1070           then
     1071         do:
     1072           if not (tt-wb-hndls.wb-type matches "*расход*" or (tt-wb-hndls.wb-type matches "*возврат*"
     1073                 and not tt-wb-hndls.wb-type matches "*возврат от покупателя*" and not tt-wb-hndls.wb-type matches "*возврат внешний*"
     1074                 and not tt-wb-hndls.wb-type matches "*возврат вн.*")) then
     1075           do:
     1076             output stream outstr to value ("TTNAct.xml") convert target "UTF-8".
     1077             outData = GetXMLAct() no-error.
     1078             if outData = ? or outData = ""
     1079             then do:
     1080               output stream outstr close.
     1081               return false.
     1082             end.
     1083             put stream outstr unformatted outData.
     1084             put stream outstr skip.
     1085             output stream outstr close.
     1086             case tt-wb-header.verXSD:
     1087               when "WayBill"
     1088                 then cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBillAct >&4", search ("exe/curl.exe"), search ("TTNAct.xml"), ConPar, inFileName).
     1089               when "WayBill_v2"
     1090                 then cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBillAct_v2 >&4", search ("exe/curl.exe"), search ("TTNAct.xml"), ConPar, inFileName).
     1091             end case.
     1092             os-command value (cmd).
     1093             file-info:file-name = search (inFileName).
     1094             if search (inFileName) <> ? and file-info:file-size > 0
     1095               then
     1096             do:
     1097               respValue = ParseRequest (inFileName).
     1098               if respValue = ?
     1099                 then
     1100               do:
     1101                 assign
     1102                   StatusErr = true
     1103                   Msg       = "Не удалось разобрать данные от УТМ"
     1104                   .
     1105                 undo, return false.
     1106               end.
     1107               if not StatusErr
     1108                 then
     1109                 ReplyId = respValue:node-value.
     1110               else
     1111               do:
     1112                 assign
     1113                   StatusErr = true
     1114                   Msg       = respValue:node-value
     1115                   .
     1116                 undo, return false.
     1117               end.
     1118             end.
     1119             else
     1120             do:
     1121               assign
     1122                 StatusErr = true
     1123                 Msg       = "Не удалось отправить акт на накладную в УТМ"
     1124                 .
     1125               undo, return false.
     1126             end.
     1127             find current buf_clob-bind exclusive-lock.
     1128             entry (7, buf_clob-bind.descr, chr(4)) = "да".
     1129             buf_clob-bind.field-name_ = buf_clob-bind.field-name_ + ',' + ReplyId.
     1130             find current buf_clob-bind no-lock.
     1131             tt-wb-hndls.is-sent = "да".
     1132           end.
     1133           else
     1134           do:
     1135             inFileName = "TTN.xml".
     1136             WriteXMLWB (inFileName).
     1137             if StatusErr
     1138             then
     1139             do:
     1140               return false.
     1141             end.
     1142             case tt-wb-header.verXSD:
     1143             when 'WayBill' then do:
     1144               cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBill >&4", search ("exe/curl.exe"), search (inFileName), ConPar, "RespTTN.xml").
     1145             end.
     1146             when 'WayBill_v2' then do:
     1147               cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBill_v2 >&4", search ("exe/curl.exe"), search (inFileName), ConPar, "RespTTN.xml").
     1148             end.
     1149             end case.
     1150             os-command value (cmd).
     1151             file-info:file-name = search ("RespTTN.xml").
     1152             if search ("RespTTN.xml") <> ? and file-info:file-size > 0
     1153               then
     1154             do:
     1155               respValue = ParseRequest ("RespTTN.xml").
     1156               if respValue = ?
     1157                 then
     1158               do:
     1159                 assign
     1160                   StatusErr = true
     1161                   Msg       = "Не удалось разобрать данные от УТМ"
     1162                   .
     1163                 undo, return false.
     1164               end.
     1165               if not StatusErr
     1166                 then
     1167                 ReplyId = respValue:node-value.
     1168               else
     1169               do:
     1170                 assign
     1171                   StatusErr = true
     1172                   Msg       = respValue:node-value
     1173                   .
     1174                 undo, return false.
     1175               end.
     1176             end.
     1177             else
     1178             do:
     1179               assign
     1180                 StatusErr = true
     1181                 Msg       = "Не удалось отправить накладную в УТМ"
     1182                 .
     1183               undo, return false.
     1184             end.
     1185             find first buf_ext-classif no-lock where
     1186                   buf_ext-classif.classif-name = 'egais-transId':U
     1187               and buf_ext-classif.db-num = 0
     1188               and buf_ext-classif.key#_one = v-ext-sys
     1189               and buf_ext-classif.CharKey_One = tt-wb-header.Identity
     1190               and buf_ext-classif.CharKey_Two = ReplyId no-error.
     1191             if not available (buf_ext-classif)
     1192             then do:
     1193               create buf_ext-classif.
     1194               assign
     1195                 buf_ext-classif.classif-name = 'egais-transId':U
     1196                 buf_ext-classif.db-num = 0
     1197                 buf_ext-classif.key#_one = v-ext-sys
     1198                 buf_ext-classif.CharKey_One = tt-wb-header.Identity
     1199                 buf_ext-classif.CharKey_Two = ReplyId
     1200               no-error.
     1201             end.
     1202           end.
     1203         end.
     1204         else do:
     1205           assign
     1206             StatusErr = true
     1207             Msg       = "Не найдена clob-bind по ключу - " + tt-wb-header.uniq-key-rec
     1208             .
     1209           return false.
     1210         end.
     1211       end.
     1212     end.
     1213     method public logical SendWBActRejUTM (inWbRegId as char):
     1214       def var VerXSDShip   as character no-undo.
     1215       def var respValue as handle no-undo.
     1216       os-delete "RespTTNAct.xml".
     1217       os-delete value (search ("RespTTNAct.xml")).
     1218       assign
     1219         inFileName = "RespTTNAct.xml"
     1220         .
     1221       find first tt-wb-header.
     1222       find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = 'clients':U
     1223         and buf_ext-classif-attr.classif-name = 'clients-esys':U
     1224         and buf_ext-classif-attr.db-num = 0
     1225         and buf_ext-classif-attr.key#_one = v-ext-sys
     1226         and buf_ext-classif-attr.CharKey_Three = tt-wb-header.regID-Ship
     1227         and buf_ext-classif-attr.attr-code = "egais-cli-info" no-error.
     1228       if available (buf_ext-classif-attr)
     1229       then
     1230         assign
     1231           VerXSDShip = entry (1, buf_ext-classif-attr.attr-value, chr(4))
     1232         no-error.
     1233       else VerXSDShip = 'WayBill'.
     1234       output stream outstr close.
     1235       output stream outstr to value ("TTNAct.xml") convert target "UTF-8".
     1236       case tt-wb-header.verXSD:
     1237       when "WayBill_v2"
     1238       then
     1239         outData = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle_v2"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct_v2><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Rejected', time, iso-date (date (now)), inWbRegId, "Отказ") + '</wa:Content></ns:WayBillAct_v2></ns:Document></ns:Documents>'.
     1240       when "WayBill"
     1241       then
     1242         outData = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef" xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef" xmlns:wa="http://fsrar.ru/WEGAIS/ActTTNSingle"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:WayBillAct><wa:Header><wa:IsAccept>&2</wa:IsAccept><wa:ACTNUMBER>&3</wa:ACTNUMBER><wa:ActDate>&4</wa:ActDate><wa:WBRegId>&5</wa:WBRegId><wa:Note>&6</wa:Note></wa:Header><wa:Content>', v-FS-RAR, 'Rejected', time, iso-date (date (now)), inWbRegId, "Отказ") + '</wa:Content></ns:WayBillAct></ns:Document></ns:Documents>'.
     1243       end case.
     1244       if outData = ? or outData = ""
     1245       then do:
     1246         output stream outstr close.
     1247         return false.
     1248       end.
     1249       put stream outstr unformatted outData.
     1250       put stream outstr skip.
     1251       output stream outstr close.
     1252       case tt-wb-header.verXSD:
     1253         when "WayBill"
     1254           then cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBillAct >&4", search ("exe/curl.exe"), search ("TTNAct.xml"), ConPar, inFileName).
     1255         when "WayBill_v2"
     1256           then cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/WayBillAct_v2 >&4", search ("exe/curl.exe"), search ("TTNAct.xml"), ConPar, inFileName).
     1257       end case.
     1258       os-command value (cmd).
     1259       file-info:file-name = search (inFileName).
     1260       if search (inFileName) <> ? and file-info:file-size > 0
     1261         then
     1262       do:
     1263         respValue = ParseRequest (inFileName).
     1264         if respValue = ?
     1265           then
     1266         do:
     1267           assign
     1268             StatusErr = true
     1269             Msg       = "Не удалось разобрать данные от УТМ"
     1270             .
     1271           undo, return false.
     1272         end.
     1273         if not StatusErr
     1274           then
     1275           ReplyId = respValue:node-value.
     1276         else
     1277         do:
     1278           assign
     1279             StatusErr = true
     1280             Msg       = respValue:node-value
     1281             .
     1282           undo, return false.
     1283         end.
     1284       end.
     1285       else
     1286       do:
     1287         assign
     1288           StatusErr = true
     1289           Msg       = "Не удалось отправить отказ на накладную в УТМ"
     1290           .
     1291         undo, return false.
     1292       end.
     1293       find first buf_ext-classif no-lock where
     1294             buf_ext-classif.classif-name = 'egais-transId':U
     1295         and buf_ext-classif.db-num = 0
     1296         and buf_ext-classif.key#_one = v-ext-sys
     1297         and buf_ext-classif.CharKey_One = tt-wb-header.Identity
     1298         and buf_ext-classif.CharKey_Two = ReplyId no-error.
     1299       if not available (buf_ext-classif)
     1300       then do:
     1301         create buf_ext-classif.
     1302         assign
     1303           buf_ext-classif.classif-name = 'egais-transId':U
     1304           buf_ext-classif.db-num = 0
     1305           buf_ext-classif.key#_one = v-ext-sys
     1306           buf_ext-classif.CharKey_One = tt-wb-header.Identity
     1307           buf_ext-classif.CharKey_Two = ReplyId
     1308         no-error.
     1309       end.
     1310     end.
     1311     method public logical SendReqRepealWBUTM (inWbRegId as char):
     1312       def var VerXSDShip   as character no-undo.
     1313       def var respValue as handle no-undo.
     1314       os-delete "RespRequestRepealWB.xml".
     1315       os-delete value (search ("RespRequestRepealWB.xml")).
     1316       assign
     1317         inFileName = "RespRequestRepealWB.xml"
     1318         .
     1319       output stream outstr close.
     1320       find first tt-wb-header.
     1321       output stream outstr to value ("RequestRepealWB.xml") convert target "UTF-8".
     1322       outData = substitute ('<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:qp="http://fsrar.ru/WEGAIS/RequestRepealWB"><ns:Owner><ns:FSRAR_ID>&1</ns:FSRAR_ID></ns:Owner><ns:Document><ns:RequestRepealWB><qp:ClientId>&2</qp:ClientId><qp:RequestNumber>&3</qp:RequestNumber><qp:RequestDate>&4</qp:RequestDate><qp:WBRegId>&5</qp:WBRegId></ns:RequestRepealWB></ns:Document></ns:Documents>', v-FS-RAR, v-FS-RAR, tt-wb-header.num + "-" + string (time), iso-date (now), tt-wb-header.wbregid).
     1323       if outData = ? or outData = ""
     1324       then do:
     1325         output stream outstr close.
     1326         return false.
     1327       end.
     1328       put stream outstr unformatted outData.
     1329       put stream outstr skip.
     1330       output stream outstr close.
     1331       cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/RequestRepealWB >&4", search ("exe/curl.exe"), search ("RequestRepealWB.xml"), ConPar, inFileName).
     1332       os-command value (cmd).
     1333       file-info:file-name = search (inFileName).
     1334       if search (inFileName) <> ? and file-info:file-size > 0
     1335         then
     1336       do:
     1337         respValue = ParseRequest (inFileName).
     1338         if respValue = ?
     1339           then
     1340         do:
     1341           assign
     1342             StatusErr = true
     1343             Msg       = "Не удалось разобрать данные от УТМ"
     1344             .
     1345           undo, return false.
     1346         end.
     1347         if not StatusErr
     1348           then
     1349           ReplyId = respValue:node-value.
     1350         else
     1351         do:
     1352           assign
     1353             StatusErr = true
     1354             Msg       = respValue:node-value
     1355             .
     1356           undo, return false.
     1357         end.
     1358       end.
     1359       else
     1360       do:
     1361         assign
     1362           StatusErr = true
     1363           Msg       = "Не удалось отправить запрос в УТМ на отмену проведения накладной"
     1364           .
     1365         undo, return false.
     1366       end.
     1367       find first buf_ext-classif no-lock where
     1368             buf_ext-classif.classif-name = 'egais-transId':U
     1369         and buf_ext-classif.db-num = 0
     1370         and buf_ext-classif.key#_one = v-ext-sys
     1371         and buf_ext-classif.CharKey_One = tt-wb-header.wbregid
     1372         and buf_ext-classif.CharKey_Two = ReplyId no-error.
     1373       if not available (buf_ext-classif)
     1374       then do:
     1375         create buf_ext-classif.
     1376         assign
     1377           buf_ext-classif.classif-name = 'egais-transId':U
     1378           buf_ext-classif.db-num = 0
     1379           buf_ext-classif.key#_one = v-ext-sys
     1380           buf_ext-classif.CharKey_One = tt-wb-header.wbregid
     1381           buf_ext-classif.CharKey_Two = ReplyId
     1382         no-error.
     1383       end.
     1384     end.
