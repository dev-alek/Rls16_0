     1458     method override protected logical GetIsSent ():
     1459       def var repId as char no-undo.
     1460       def var glog  as log  no-undo.
     1461     end.
     1462     method protected handle ParseRequest (inFileName as char):
     1463       define variable hRoot as handle  no-undo.
     1464       define variable hDoc  as handle  no-undo.
     1465       define variable hRow  as handle  no-undo.
     1466       define variable hText as handle  no-undo.
     1467       define variable ii    as integer no-undo.
     1468       create x-document hDoc.
     1469       create x-noderef  hRoot.
     1470       create x-noderef  hRow.
     1471       create x-noderef htext .
     1472       hDoc:load ("file", inFileName, false).
     1473       hDoc:encoding = "UTF-8".
     1474       hDoc:get-document-element(hRoot) .
     1475       do ii = 1 to hRoot:num-children:
     1476         hRoot:get-child(hRow,ii).
     1477         case hRow:name:
     1478           when "url" then
     1479             do:
     1480               hRow:get-child (hText, 1) no-error.
     1481               return hText.
     1482             end.
     1483           when "error" then
     1484             do:
     1485               hRow:get-child (hText, 1) no-error.
     1486               StatusErr = true.
     1487               return hText.
     1488             end.
     1489           otherwise
     1490           do:
     1491             return ?.
     1492           end.
     1493         end case.
     1494       end.
     1495     end.
     1496     method public void GetDocUTM ():
     1497       output stream str-formF1 close.
     1498       output stream str-formF1 to "loWBgFormF1.txt" append.
     1499       GetDocUTMPrivat ().
     1500       output stream str-formF1 close.
     1501       if valid-object (prgObj)
     1502         then do:
     1503           prgObj:hide-bar().
     1504           delete object prgObj.
     1505         end.
     1506     end.
     1507     method private void GetDocUTMPrivat ():
     1508       define variable hRoot         as handle    no-undo.
     1509       define variable hDoc          as handle    no-undo.
     1510       define variable hRow          as handle    no-undo.
     1511       define variable hText         as handle    no-undo.
     1512       define variable ii            as integer   no-undo.
     1513       define variable jj            as integer   no-undo.
     1514       define variable ListOfQuery   as longchar  no-undo.
     1515       define variable v-part-num    as integer   no-undo.
     1516       define variable v-clob-db-num as integer   no-undo.
     1517       define variable v-int64-id    as int64     no-undo.
     1518       define variable v-info        as character no-undo.
     1519       define variable ticketUKR     as character no-undo.
     1520       define variable urlStr        as character no-undo.
     1521       define variable extFormF1Obj  as class     ExtFormF1 no-undo .
     1522       define variable extFormF1ValueObj as class ExtFormF1Value no-undo .
     1523       define variable egaisFormF1 as class FormF1 no-undo.
     1524       create x-document hDoc.
     1525       create x-noderef  hRoot.
     1526       create x-noderef  hRow.
     1527       create x-noderef  hText.
     1528       empty temp-table tt-analiz.
     1529       assign
     1530         inFileName = "ReceiptListOfQuery.xml"
     1531         .
     1532       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
     1533       if search (inFileName) <> ? then os-delete value (inFileName).
     1534       if FastDwnl then do:
     1535         if search ( v-FS-RAR + '_ReceiptListOfQuery.xml' ) <> ?
     1536         then do:
     1537           copy-lob
     1538             from  file v-FS-RAR + '_ReceiptListOfQuery.xml'
     1539             to  object ListOfQuery
     1540             no-convert
     1541             no-error .
     1542         end.
     1543       end.
     1544       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
     1545       os-command value (cmd).
     1546       file-info:file-name = search (inFileName).
     1547       if search (inFileName) = ? or file-info:file-size = 0
     1548         then
     1549       do:
     1550         assign
     1551           StatusErr = true
     1552           Msg       = "Не удалось получить данные от УТМ"
     1553           .
     1554         return.
     1555       end.
     1556       hDoc:load ("file", inFileName, false).
     1557       hDoc:get-document-element(hRoot) .
     1558       prgObj = new ProgressBar (1, integer (hRoot:num-children / 2)).
     1559       prgObj:can-cancel = true.
     1560       prgObj:show-bar().
     1561       url_:
     1562       do ii = 1 to hRoot:num-children:
     1563         hRoot:get-child(hRow,ii).
     1564         case hRow:name:
     1565           when "url" then
     1566             do:
     1567               hRow:get-child (hText, 1) no-error.
     1568               urlStr = hText:node-value.
     1569               prgObj:increment( substring (urlStr, if length (urlStr) <= 50 then 1 else length (urlStr) - 50)).
     1570               if prgObj:is-canceled
     1571                 then return.
     1572               if FastDwnl then
     1573               do:
     1574                 if ListOfQuery <> ? and ListOfQuery <> "" and index (ListOfQuery, urlStr) > 0
     1575                   then next url_.
     1576               end.
     1577               case true:
     1578                 when urlStr matches ("*opt/out/WayBill/*") or urlStr matches ("*opt/out/WayBill_v2/*") then
     1579                   do:
     1580                     os-delete "WayBill.xml".
     1581                     os-delete value (search ("WayBill.xml")).
     1582                     assign
     1583                       inFileName = "WayBill.xml"
     1584                       .
     1585                     CmdParseXml(urlStr).
     1586                     if StatusErr
     1587                     then do:
     1588                       message "Ошибка приема файла накланой: " v-info skip urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     1589                       StatusErr = false.
     1590                       Msg = "".
     1591                       next url_.
     1592                     end.
     1593                     create tt-analiz.
     1594                     assign
     1595                       tt-analiz.url_ = urlStr
     1596                       tt-analiz.num = tt-wb-header.num
     1597                       tt-analiz.wb-date = tt-wb-header.wb-date
     1598                       tt-analiz.Identity = tt-wb-header.Identity
     1599                       tt-analiz.wb-type = "накл"
     1600                       tt-analiz.uniq-key-rec = tt-wb-header.num + chr(6) + string (tt-wb-header.wb-date) + chr(6) + tt-wb-header.regID-Ship + chr(6) + tt-wb-header.Identity
     1601                       tt-analiz.nnOrder = ii
     1602                       tt-analiz.resource-type = 'egais-wb':U
     1603                     .
     1604                     find first buf_tt-analiz where recid (buf_tt-analiz) <> recid (tt-analiz)
     1605                       and buf_tt-analiz.wb-type = tt-analiz.wb-type
     1606                       and buf_tt-analiz.uniq-key-rec = tt-analiz.uniq-key-rec no-error.
     1607                     if available (buf_tt-analiz)
     1608                     then do:
     1609                       buf_tt-analiz.isMany = true.
     1610                       tt-analiz.isMany = true.
     1611                     end.
     1612                     find first tt-wb-header no-error.
     1613                     if not available (tt-wb-header)
     1614                     then do:
     1615                       message "Ошибка приема файла накланой: " v-info skip urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     1616                       StatusErr = false.
     1617                       Msg = "".
     1618                       next url_.
     1619                     end.
     1620                     find first tt-wb-info-client where tt-wb-info-client.wb-type-client = "Consignee".
     1621                     for each buf_ext-classif no-lock where
     1622                           buf_ext-classif.classif-subject = 'clients':U
     1623                       and buf_ext-classif.classif-name = 'clients-esys':U
     1624                       and buf_ext-classif.db-num = 0
     1625                       and buf_ext-classif.key#_one = v-ext-sys
     1626                       and buf_ext-classif.CharKey_Three = tt-wb-info-client.regID:
     1627                       if available (buf_ext-classif) then
     1628                       do:
     1629                         tt-wb-header.obj-type = entry(2, buf_ext-classif.uniq-key-rec, chr(3)).
     1630                         tt-wb-header.obj-code = integer(entry(3, buf_ext-classif.uniq-key-rec, chr(3))).
     1631                       end.
     1632                       find first buf_clients no-lock where buf_clients.obj-type = tt-wb-header.obj-type and buf_clients.obj-code = tt-wb-header.obj-code and buf_clients.db-num = DbNum no-error.
     1633                       if available (buf_clients)
     1634                         then leave.
     1635                     end.
     1636                     if not available (buf_clients)
     1637                       then
     1638                         assign
     1639                           tt-wb-header.obj-type = ""
     1640                           tt-wb-header.obj-code = 0
     1641                         .
     1642                     find first tt-wb-info-client where tt-wb-info-client.wb-type-client = "Shipper".
     1643                     v-info = string (tt-wb-header.wb-date) + chr(4) + tt-wb-header.num + chr(4) + tt-wb-info-client.regID + chr(4) + tt-wb-header.Identity + chr(4) + tt-wb-header.wbregid + chr(4) + "нет" + chr(4) + "нет" + chr(4) + tt-wb-header.wb-type + chr(4) + tt-wb-header.obj-type + if tt-wb-header.obj-code = 0 or tt-wb-header.obj-code = ? then "" else string (tt-wb-header.obj-code).
     1644                     if tt-wb-header.uniq-key-rec = ?
     1645                     then do:
     1646                       message "Ошибка приема файла накладной: " v-info skip urlStr skip Msg skip " Прием документов будет продолжен" view-as alert-box.
     1647                       StatusErr = false.
     1648                       Msg = "".
     1649                       next url_.
     1650                     end.
     1651                     v-clob-db-num = ?.
     1652                     v-int64-id = 0.
