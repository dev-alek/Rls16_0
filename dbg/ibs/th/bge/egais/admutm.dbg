      167     constructor public admutm (inOjType as char, inObjCode as int, inFSRAR as char, inExtSys as int):
      168       super (inOjType, inObjCode).
      169       FSRAR = inFSRAR.
      170       prsXMLDocWB = new ParserXMLDocWB (inExtSys).
      171       IsSent.
      172     end constructor.
      173     destructor public admutm ():
      174       if valid-object (prsXMLDocWB)
      175         then delete object prsXMLDocWB.
      176       if valid-object (prgObj)
      177         then delete object prgObj.
      178     end destructor.
      179     method public override handle GetHndlTable ():
      180       assign
      181         StatusErr = false
      182         Msg = ""
      183       .
      184       GetURLUTM().
      185       return buffer tt-alldoc:handle.
      186     end.
      187     method public void SaveRecords ():
      188       def var hDoc as handle no-undo.
      189       def var path as char no-undo.
      190       def var fullFileName as char no-undo.
      191       assign
      192         StatusErr = false
      193         Msg = ""
      194       .
      195       find last tt-alldoc no-error.
      196       if not available (tt-alldoc)
      197         then return.
      198       prgObj = new ProgressBar (1, tt-alldoc.nnOrder).
      199       prgObj:can-cancel = true.
      200       prgObj:show-bar().
      201       for each tt-alldoc:
      202         prgObj:increment( substring (tt-alldoc.url_, if length (tt-alldoc.url_) <= 50 then 1 else length (tt-alldoc.url_) - 50)).
      203         if prgObj:is-canceled
      204           then do:
      205             if valid-object (prgObj)
      206               then do:
      207                 prgObj:hide-bar().
      208                 delete object prgObj.
      209               end.
      210             return.
      211           end.
      212         SaveRecord(tt-alldoc.url_, output fullFileName).
      213         tt-alldoc.date_ = DocDate.
      214         if StatusErr then do:
      215           if valid-object (prgObj)
      216             then do:
      217               prgObj:hide-bar().
      218               delete object prgObj.
      219             end.
      220           return.
      221         end.
      222       end.
      223       if valid-object (prgObj)
      224         then do:
      225           prgObj:hide-bar().
      226           delete object prgObj.
      227         end.
      228       glog = true.
      229     end.
      230     method protected handle ParseRequest (inFileName as char):
      231       define variable hRoot as handle  no-undo.
      232       define variable hDoc  as handle  no-undo.
      233       define variable hRow  as handle  no-undo.
      234       define variable hText as handle  no-undo.
      235       define variable ii    as integer no-undo.
      236       create x-document hDoc.
      237       create x-noderef  hRoot.
      238       create x-noderef  hRow.
      239       create x-noderef htext .
      240       hDoc:load ("file", inFileName, false).
      241       hDoc:encoding = "UTF-8".
      242       hDoc:get-document-element(hRoot) .
      243       do ii = 1 to hRoot:num-children:
      244         hRoot:get-child(hRow,ii).
      245         case hRow:name:
      246           when "url" then
      247             do:
      248               hRow:get-child (hText, 1) no-error.
      249               return hText.
      250             end.
      251           when "error" then
      252             do:
      253               hRow:get-child (hText, 1) no-error.
      254               StatusErr = true.
      255               return hText.
      256             end.
      257           otherwise
      258             do:
      259               return ?.
      260             end.
      261         end case.
      262       end.
      263     end.
      264     method private void GetURLUTM ():
      265       empty temp-table tt-alldoc.
      266       assign
      267         inFileName = "ReceiptListOfQuery.xml"
      268       .
      269       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      270       if search (inFileName) <> ? then os-delete value (inFileName).
      271       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/out?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      272       os-command silent value (cmd).
      273       file-info:file-name = search (inFileName).
      274       if search (inFileName) = ? or file-info:file-size = 0
      275       then do:
      276         assign
      277           StatusErr = true
      278           Msg = "Не удалось получить данные от UTM"
      279         .
      280         return.
      281       end.
      282       ParseUrl(inFileName).
      283       assign
      284         inFileName = "ReceiptListInDoc.xml"
      285       .
      286       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      287       if search (inFileName) <> ? then os-delete value (inFileName).
      288       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/in?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName).
      289       os-command silent value (cmd).
      290       file-info:file-name = search (inFileName).
      291       if search (inFileName) = ? or file-info:file-size = 0
      292       then do:
      293         assign
      294           StatusErr = true
      295           Msg = "Не удалось получить данные от UTM"
      296         .
      297         return.
      298       end.
      299       ParseUrl(inFileName).
      300       return.
      301     end.
      302     method public void Cleaning (inBeforDays as integer, inLogHandle as handle):
      303       def var url_ as character no-undo.
      304       def buffer buf_tt-alldoc for tt-alldoc.
      305       assign
      306         StatusErr = false
      307         Msg = ""
      308       .
      309       GetURLUTM().
      310       for each buf_tt-alldoc where buf_tt-alldoc.typeDirection = 'out':
      311         url_ = buf_tt-alldoc.url_.
      312         case true:
      313           when lookup (buf_tt-alldoc.typeDoc, "ReplyRests,INVENTORYREGINFO,ReplyAP,ReplyPartner" ) > 0 then do:
      314             DelRecord(buf_tt-alldoc.url_).
      315             if valid-handle (inLogHandle)
      316             then do:
      317               run write-log-and-file in inLogHandle (          input 1                                                            , input LogFileName                                                  , input 1                                                            , input 'Удаление: ' + url_).
      318             end.
      319           end.
      320           otherwise do:
      321             SaveRecord(buf_tt-alldoc.url_).
      322             buf_tt-alldoc.date_ = DocDate.
      323             if buf_tt-alldoc.date_ < today - inBeforDays and buf_tt-alldoc.date_ <> ?
      324               then DelRecord(buf_tt-alldoc.url_).
      325             if valid-handle (inLogHandle)
      326             then do:
      327               run write-log-and-file in inLogHandle (          input 1                                                            , input LogFileName                                                  , input 1                                                            , input 'Удаление: ' + url_).
      328             end.
      329           end.
      330         end.
      331         process events.
      332       end.
      333       for each buf_tt-alldoc where buf_tt-alldoc.typeDirection = 'in':
      334         url_ = buf_tt-alldoc.url_.
      335         DelRecord(url_).
      336         run write-log-and-file in inLogHandle (          input 1                                                            , input LogFileName                                                  , input 1                                                            , input 'Удаление: ' + url_).
      337         process events.
      338       end.
      339     end.
      340     method public void LookRec (input inUrl as char):
      341       def var fullFileName as char no-undo.
      342       assign
      343         StatusErr = false
      344         Msg = ""
      345       .
      346       SaveRecord(inUrl, output fullFileName).
      347       if StatusErr then return.
      348       if not available (tt-alldoc)
      349         then find first tt-alldoc where tt-alldoc.url_ = inUrl no-error.
      350       if available (tt-alldoc)
      351         then tt-alldoc.date_ = DocDate.
      352       os-command silent value(fullFileName).
      353     end.
      354     method public void WriteDbStatusTrue ():
      355       if not WriteDbStatus (integer ('3':U), parameters , ReplyId, true)
      356       then do:
      357         assign
      358           StatusErr = true
      359           Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      360         .
      361         return.
      362       end.
      363     end.
      364     method public void SaveRecord (input inUrl as char):
      365       assign
      366         StatusErr = false
      367         Msg = ""
      368       .
      369       def var fullFileName as char no-undo.
      370       SaveRecord (input inUrl, output fullFileName).
      371       if StatusErr then return.
      372       if not available (tt-alldoc)
      373         then find first tt-alldoc where tt-alldoc.url_ = inUrl no-error.
      374       if available (tt-alldoc)
      375         then tt-alldoc.date_ = DocDate.
      376     end.
      377     method public void SaveRecord (input inUrl as char, output outFullFileName as char):
      378       def var path as char no-undo.
      379       def var hDoc as handle no-undo.
      380       assign
      381         StatusErr = false
      382         Msg = ""
      383       .
      384       path = "egais_" + FSRAR + "\".
      385       file-info:file-name = right-trim (path, "\").
      386       if file-info:file-type = ?
      387       then do:
      388         os-create-dir value(right-trim (path, "\")).
      389         if os-error <> 0 then do:
      390           message substitute("Невозможно создать директорию &1",path) view-as alert-box error.
      391           leave.
      392         end.
      393       end.
      394       assign
      395         inFileName = entry (7, inUrl, "/") + "_" + entry (6, inUrl, "/").
      396         .
      397       os-delete value (path + "inFileName").
      398       os-delete value (search (path + inFileName)).
      399       outFullFileName = path + inFileName + ".xml".
      400       cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, inUrl, outFullFileName).
      401       os-command silent value (cmd).
      402       file-info:file-name = search (outFullFileName).
      403       if file-info:file-size = ? or  file-info:file-size = 0
      404         then do:
      405           StatusErr = true.
      406           Msg = 'Не удалось получить данные от УТМ.'.
      407           return.
      408         end.
      409       file-info:file-name = search (outFullFileName).
      410       create x-document hDoc.
      411       hDoc:encoding = 'utf-8'.
      412       hDoc:load ("file", file-info:file-name, false) no-error.
      413       prsXMLDocWB:ParseRec (hDoc, input-output DocDate, inUrl).
      414       glog = true.
      415     end.
      416     method public void DelRecord (input inUrl as char):
      417       assign
      418         StatusErr = false
      419         Msg = ""
      420       .
      421       cmd = substitute ("&1  -X DELETE &2", search ("exe/curl.exe"), inUrl).
      422       os-command silent value (cmd).
      423     end.
      424     method public void QueryResendDoc (input inWBREGID as char):
      425       def var ContStr as char no-undo.
      426       def var FullFileName as char no-undo.
      427       def var ContLongCh as longchar no-undo.
      428       ContStr = '<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:qp="http://fsrar.ru/WEGAIS/QueryParameters"> <ns:Owner><ns:FSRAR_ID>TH-FSRAR</ns:FSRAR_ID></ns:Owner><ns:Document><ns:QueryResendDoc><qp:Parameters><qp:Parameter><qp:Name>WBREGID</qp:Name><qp:Value>TH-WBREGID</qp:Value></qp:Parameter></qp:Parameters></ns:QueryResendDoc></ns:Document></ns:Documents>'.
      429       assign
      430         StatusErr = false
      431         Msg = ""
      432       .
      433       ContStr = replace (ContStr, "TH-FSRAR", FSRAR).
      434       ContStr = replace (ContStr, "TH-WBREGID", inWBREGID).
      435       ContLongCh = ContStr.
      436       copy-lob
      437         from  object ContLongCh
      438         to  file 'QueryResendDoc.xml'
      439         no-convert
      440         no-error .
      441       FullFileName = search ('QueryResendDoc.xml').
      442       cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/QueryResendDoc >&4", search ("exe/curl.exe"), FullFileName, ConPar, "RespQueryResendDoc.xml").
      443       os-command silent value (cmd).
      444       file-info:file-name = search ("RespQueryResendDoc.xml").
      445       if search (inFileName) = ? or file-info:file-size = 0 or file-info:file-size = ?
      446         then
      447       do:
      448         assign
      449           StatusErr = true
      450           Msg       = substitute ("Не удалось отправить повторный запрос накладной - &1 в УТМ.", inWBREGID)
      451           .
      452         undo, return.
      453       end.
      454     end.
      455     method public void ReqRepealWB (input inWBREGID as char):
      456       def var ContStr as char no-undo.
      457       def var FullFileName as char no-undo.
      458       def var ContLongCh as longchar no-undo.
      459       ContStr = '<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0"xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01"xmlns:qp="http://fsrar.ru/WEGAIS/RequestRepealWB"><ns:Owner><ns:FSRAR_ID>TH-FSRAR</ns:FSRAR_ID></ns:Owner><ns:Document><ns:RequestRepealWB><qp:ClientId>TH-FSRAR</qp:ClientId><qp:RequestNumber></qp:RequestNumber><qp:RequestDate></qp:RequestDate><qp:WBRegId>TH-WBREGID</qp:WBRegId></ns:RequestRepealWB></ns:Document></ns:Documents>'.
      460       assign
      461         StatusErr = false
      462         Msg = ""
      463       .
      464       ContStr = replace (ContStr, "TH-FSRAR", FSRAR).
      465       ContStr = replace (ContStr, "TH-WBREGID", inWBREGID).
      466       ContLongCh = ContStr.
      467       copy-lob
      468         from  object ContLongCh
      469         to  file 'RequestRepealWB.xml'
      470         no-convert
      471         no-error .
      472       FullFileName = search ('RequestRepealWB.xml').
      473       cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/RequestRepealWB.xml >&4", search ("exe/curl.exe"), FullFileName, ConPar, "RespRequestRepealWB.xml").
      474       os-command silent value (cmd).
      475       file-info:file-name = search ("RespRequestRepealWB.xml").
      476       if search (inFileName) = ? or file-info:file-size = 0 or file-info:file-size = ?
      477         then
      478       do:
      479         assign
      480           StatusErr = true
      481           Msg       = substitute ("Не удалось отправить отмену на накладную - &1 в УТМ.", inWBREGID)
      482           .
      483         undo, return.
      484       end.
      485     end.
      486     method public void SendInfoVer (input inInfoVer as char):
      487       def var ContStr as char no-undo.
      488       def var FullFileName as char no-undo.
      489       def var ContLongCh as longchar no-undo.
      490       def var respValue as handle no-undo.
      491       ContStr = '<?xml version="1.0" encoding="UTF-8"?><ns:Documents Version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01" xmlns:qp="http://fsrar.ru/WEGAIS/InfoVersionTTN"><ns:Owner><ns:FSRAR_ID>TH-FSRAR</ns:FSRAR_ID></ns:Owner><ns:Document><ns:InfoVersionTTN><qp:ClientId>TH-FSRAR</qp:ClientId><qp:WBTypeUsed>TH-InfoVer</qp:WBTypeUsed></ns:InfoVersionTTN></ns:Document></ns:Documents>'.
      492       assign
      493         StatusErr = false
      494         Msg = ""
      495       .
      496       if IsSentInvoVer
      497       then do:
      498         Msg = "Запрос уже был отправлен.".
      499         StatusErr = true.
      500       end.
      501       ContStr = replace (ContStr, "TH-FSRAR", FSRAR).
      502       ContStr = replace (ContStr, "TH-InfoVer", inInfoVer).
      503       ContLongCh = ContStr.
      504       copy-lob
      505         from  object ContLongCh
      506         to  file 'InfoVersionTTN.xml'
      507         no-convert
      508         no-error .
      509       FullFileName = search ('InfoVersionTTN.xml').
      510       cmd = substitute ("&1 --connect-timeout 1 -F xml_file=@&2 &3/opt/in/InfoVersionTTN >&4", search ("exe/curl.exe"), FullFileName, ConPar, "RespInfoVersionTTN.xml").
      511       os-command silent value (cmd).
      512       file-info:file-name = search ("RespInfoVersionTTN.xml").
      513       if search (FullFileName) = ? or file-info:file-size = 0 or file-info:file-size = ?
      514         then
      515       do:
      516         assign
      517           StatusErr = true
      518           Msg       = substitute ("Не удалось отправить уведомление о смене версии в УТМ на &1.", inInfoVer)
      519           .
      520         undo, return.
      521       end.
      522       respValue = ParseRequest (file-info:file-name).
      523       if respValue = ?
      524         then
      525       do:
      526         assign
      527           StatusErr = true
      528           Msg       = "Не удалось разобрать данные от УТМ"
      529           .
      530         return.
      531       end.
      532       if not StatusErr
      533         then
      534         ReplyId = respValue:node-value.
      535       else
      536       do:
      537         assign
      538           StatusErr = true
      539           Msg       = respValue:node-value
      540           .
      541         return.
      542       end.
      543       if not WriteDbStatus (integer ('3':U), parameters , ReplyId, false)
      544       then do:
      545         assign
      546           StatusErr = true
      547           Msg = "Не удалось записать данные о запросе в БД. Запрос не выполен."
      548         .
      549         return.
      550       end.
      551     end.
      552     method public void ParseUrl (input inFileName as char):
      553       define variable hRoot as handle  no-undo.
      554       define variable hDoc  as handle  no-undo.
      555       define variable hRow  as handle  no-undo.
      556       define variable hText as handle  no-undo.
      557       define variable ii    as integer no-undo.
      558       define variable jj    as integer no-undo.
      559       create x-document hDoc.
      560       create x-noderef  hRoot.
      561       create x-noderef  hRow.
      562       create x-noderef  hText.
      563       hDoc:load ("file", inFileName, false).
      564       hDoc:get-document-element(hRoot) .
      565       jj = 0.
      566       do ii = 1 to hRoot:num-children:
      567         hRoot:get-child(hRow,ii).
      568         case hRow:name:
      569           when "url" then
      570             do:
      571               jj = jj + 1.
      572               hRow:get-child (hText, 1) no-error.
      573               create tt-alldoc.
      574               assign
      575                 tt-alldoc.url_ = hText:node-value
      576                 tt-alldoc.nnOrder = jj.
      577               assign
      578                 tt-alldoc.typeDoc = entry (6, hText:node-value, "/")
      579                 tt-alldoc.typeDirection = entry (5, hText:node-value, "/") no-error
      580                 .
      581             end.
      582         end case.
      583       end.
      584     end.
      585     method override protected logical GetIsSent ():
      586       def var repId as char no-undo.
      587       def var glog  as log  no-undo.
      588       glog = CheckCurrentRequest (integer ('3':U), parameters, repId).
      589       if glog
      590         then ReplyId = repId.
      591       return glog.
      592     end.
      593     method public override character GetSubjectOfRequestUTM() :
      594       assign
      595         StatusErr = false
      596         Msg = ""
      597       .
      598       urlResp = GetURLUTM(ReplyId, "out").
      599       if urlResp = "" or urlResp = ?
      600       then do:
      601         StatusErr = true.
      602         Msg = "Еще не получен ответ от сервера EGAIS по запросу " + ReplyId.
      603         return ?.
      604       end.
      605       os-delete "TicketInfoVer.xml".
      606       assign
      607         inFileName = "TicketInfoVer.xml"
      608       .
      609       cmd = substitute ("&1 --connect-timeout &2 -X GET &3 >&4", search ("exe/curl.exe"), TimeOut, urlResp, inFileName).
      610       os-command silent value (cmd).
      611     end.
      612     method protected character GetURLUTM (inReplyId as char, direction as char):
      613       define variable hRoot as handle  no-undo.
      614       define variable hDoc  as handle  no-undo.
      615       define variable hRow  as handle  no-undo.
      616       define variable hText as handle  no-undo.
      617       define variable ii    as integer no-undo.
      618       create x-document hDoc.
      619       create x-noderef  hRoot.
      620       create x-noderef  hRow.
      621       create x-noderef  hText.
      622       assign
      623         inFileName = "ReceiptListOfQuery.xml"
      624       .
      625       if search ("ReceiptListOfQuery.xml") <> ? then os-delete value (inFileName).
      626       if search (inFileName) <> ? then os-delete value (inFileName).
      627       cmd = substitute ("&1 --connect-timeout &2 -X GET &3/opt/&5?refresh=true >&4",search ("exe/curl.exe"), TimeOut, ConPar, inFileName, direction).
      628       os-command silent value (cmd).
      629       file-info:file-name = search (inFileName).
      630       if search (inFileName) = ? or file-info:file-size = 0
      631       then do:
      632         assign
      633           StatusErr = true
      634           Msg = "Не удалось получить данные от UTM"
      635         .
      636         return ?.
      637       end.
      638       hDoc:load ("file", inFileName, false).
      639       hDoc:get-document-element(hRoot) .
      640       do ii = 1 to hRoot:num-children:
      641         hRoot:get-child(hRow,ii).
      642         case hRow:name:
      643           when "url" then
      644             do:
      645               if hRow:get-attribute("replyId") = ReplyId
      646               then do:
      647                 hRow:get-child (hText, 1) no-error.
      648                 return hText:node-value.
      649               end.
      650             end.
      651         end case.
      652       end.
      653       return ?.
      654     end.
      655   end class.
