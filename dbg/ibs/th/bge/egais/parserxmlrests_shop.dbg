        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ParserXMLRests_Shop inherits EGAISUTM:
        5       define variable v-FS-RAR as character no-undo .
        6       define property v-date-time as character no-undo
        7         get.
        8         set.
        9       define temp-table tt-gds-rests-EG_shop no-undo
       10       field gds-code          like ub.goods.gds-code          label "Код товара в TH"
       11       field gds-name          like ub.goods.gds-name          label "Наименование товара" format "X(100)"
       12       field alc-code          as character                    label "Алкогольный код"     format "X(21)"
       13       field ms-base           like ub.goods.ms-base           label "Объем"               format ">>9.9<<"
       14       field alc-type-code     like ub.alc-type.alc-type-code  label "Код АП"
       15       field proof             like ub.goods.proof             label "Крепость"            format ">9.9"
       16       field fromEgais         as logical
       17       field egais-name        as character                    label "Наименование ЕГАИС"  format "X(100)"
       18       field egais-qnty        as decimal                      label "Остаток ЕГАИС"
       19       field TH-qnty           as decimal                      label "Остаток TH"
       20       field packed            as logical
       21       index pi as primary
       22           gds-code
       23       index name_ as word-index
       24           gds-name
       25       index alc
       26           alc-code
       27       .
       28       DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
       29       DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
       30       DEFINE VARIABLE good AS LOGICAL NO-UNDO.
       31       constructor public ParserXMLRests_Shop (inOjType as char, inObjCode as int):
       32         super (inOjType, inObjCode).
       33       end constructor.
       34       method override handle ParseResponse(inFileName as char):
       35           empty temp-table tt-gds-rests-EG_shop .
       36           CREATE X-DOCUMENT hDoc.
       37           CREATE X-NODEREF hRoot.
       38           hDoc:LOAD("file",inFileName,FALSE).
       39           hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       40           GetChildren(hRoot, 1).
       41           DELETE OBJECT hDoc.
       42           DELETE OBJECT hRoot.
       43           return buffer tt-gds-rests-EG_shop:handle.
       44       end.
       45       method private void GetChildren(hParent AS HANDLE, level AS INTEGER):
       46           DEFINE VARIABLE i AS INTEGER NO-UNDO.
       47           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
       48           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
       49           CREATE X-NODEREF hNoderef.
       50           CREATE X-NODEREF hText .
       51           REPEAT i = 1 TO hParent:NUM-CHILDREN:
       52               good = hParent:GET-CHILD(hNoderef,i).
       53               IF NOT good THEN
       54                   LEAVE.
       55               IF hNoderef:SUBTYPE <> "element" THEN
       56                   NEXT.
       57               hNoderef:GET-CHILD(hText, 1) no-error .
       58               IF hNoderef:NAME = "ns:FSRAR_ID" THEN
       59                   assign v-FS-RAR = hText:node-value .
       60               IF hNoderef:NAME = "rst:ShopPosition" THEN
       61                   create tt-gds-rests-EG_shop .
       62               IF hNoderef:NAME = "rst:RestsDate"   THEN assign v-date-time        = hText:node-value .
       63               IF hNoderef:NAME = "rst:Quantity"    THEN assign tt-gds-rests-EG_shop.egais-qnty        = decimal(hText:node-value) .
       64               IF hNoderef:NAME = "pref:FullName"     THEN do :
       65                   if trim(tt-gds-rests-EG_shop.gds-name) = "" then assign tt-gds-rests-EG_shop.gds-name        = hText:node-value .
       66               end.
       67               IF hNoderef:NAME = "pref:AlcCode"      THEN assign tt-gds-rests-EG_shop.alc-code        = hText:node-value .
       68               IF hNoderef:NAME = "pref:UnitType"     THEN assign tt-gds-rests-EG_shop.packed          = (hText:node-value = "Packed") .
       69               IF hNoderef:NAME = "pref:Capacity"     THEN assign tt-gds-rests-EG_shop.ms-base         = decimal(hText:node-value) .
       70               IF hNoderef:NAME = "pref:AlcVolume"    THEN assign tt-gds-rests-EG_shop.proof           = decimal(hText:node-value) .
       71               IF hNoderef:NAME = "pref:ProductVCode" THEN assign tt-gds-rests-EG_shop.alc-type-code   = hText:node-value .
       72               GetChildren(hNoderef, (level + 1)).
       73           END.
       74           DELETE OBJECT hNoderef.
       75           DELETE OBJECT hText.
       76       END.
       77   end class.
