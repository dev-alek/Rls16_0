        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.Journal inherits ibs.th.bge.egais.EGAISImpl:
        5     define public variable tth_journal-egais as handle no-undo.
        6     define public variable bh_journal-egais as handle no-undo.
        7     define buffer buf_esys-all-attr for ub.esys-all-attr.
        8     define variable        v-subject        as character no-undo.
        9     define variable        v-status         as character no-undo.
       10     define variable        v-db-num         as integer   no-undo.
       11     define variable        v-user           as character no-undo.
       12     define temp-table tt_journal-egais no-undo
       13       field jou-who     as character LABEL "Кто отправил"       format "X(30)"
       14       field jou-time    as datetime  LABEL "Во сколько"         FORMAT "99.99.99 HH:MM"
       15       field jou-subject as character LABEL "Какой запрос"       format "X(25)"
       16       field jou-status  as character LABEL "Состояние запроса"  format "X(20)"
       17       field jou-param   as character LABEL "Параметр"           format "X(30)"
       18       field jou-code    as character LABEL "Код запроса"        format "X(38)"
       19       field piIndex     as character
       20       index tt_journal-egais is primary jou-code ascending.
       21     method public override handle GetHndlTable( ):
       22     for each buf_esys-all-attr where buf_esys-all-attr.table-name = "esys-pck-sent"
       23                                  and buf_esys-all-attr.attr-code  = "egais" no-lock:
       24       create tt_journal-egais.
       25           v-subject = "Some".
       26           if buf_esys-all-attr.key2 = integer('1':U) then do:
       27             v-subject = 'Справочник организаций':U.
       28           end.
       29           if buf_esys-all-attr.key2 = integer('2':U) then do:
       30             v-subject = 'Справочник товаров':U.
       31           end.
       32           if buf_esys-all-attr.key2 = integer('3':U) then do:
       33             v-subject = 'Уведомление сервера ЕГАИС о смене версии xsd-схем':U.
       34           end.
       35           if buf_esys-all-attr.key2 = 7 then do:
       36             v-subject = 'Справочник справок 1'.
       37           end.
       38           if buf_esys-all-attr.key3 = "no" then v-status = "Запрос отправлен".
       39           else v-status = "Ответ получен".
       40           if buf_esys-all-attr.key8 <> "" then do:
       41             find first ub.user-account where ub.user-account.user-id = buf_esys-all-attr.key8 no-error.
       42             v-user = ub.user-account.last-name + ' ' + ub.user-account.first-name + ' ' + ub.user-account.second-name .
       43           end.
       44       assign
       45         tt_journal-egais.jou-who = v-user
       46         tt_journal-egais.jou-code = buf_esys-all-attr.key7
       47         tt_journal-egais.jou-time = datetime (buf_esys-all-attr.key4)
       48         tt_journal-egais.jou-subject = v-subject
       49         tt_journal-egais.jou-status = v-status
       50         tt_journal-egais.jou-param = replace(buf_esys-all-attr.attr-value,chr(4),'|')
       51         tt_journal-egais.piIndex = table-name + string (key1) + string (key2) + string (key3) + string (key4) + string (key5) + string (key6) +
       52           string (key7) + string (key8) + attr-code.
       53          .
       54      end.
       55       return buffer tt_journal-egais:handle.
       56     end.
       57   end class.
