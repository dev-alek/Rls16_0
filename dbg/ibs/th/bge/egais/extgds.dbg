        1   using Progress.Lang.*.
        2   using ibs.th.bge.egais.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.egais.ExtGds:
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
        8   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        9   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       10   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       11   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       12   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       13   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       14   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       15   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       16   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       17   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       18   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       19   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       20   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       21   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       22   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       23   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       24   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       25   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       26     define private temp-table ttObjEgaisAlcProp no-undo
       27       field iExtGdsObj as integer
       28       field ExtGdsValueObj as class Progress.Lang.Object
       29       index pi is primary unique iExtGdsObj .
       30     define private buffer buf_ext-classif      for ub.ext-classif.
       31     define private buffer x_ext-classif        for ub.ext-classif.
       32     define private buffer buf_ext-classif-attr for ub.ext-classif-attr.
       33     define private buffer buf_gds for ub.goods.
       34     define private buffer buf_cli for ub.clients.
       35     define property ExtSystem as integer no-undo
       36       get.
       37       private set.
       38     define property DbNum as integer init 0 no-undo
       39       get.
       40       set.
       41     define property IsSilent as logical no-undo
       42       get.
       43       private set.
       44     define property GdsCodeItemQuery as integer no-undo init 0
       45       get.
       46       private set.
       47     define property AlcCodeItemQuery as character no-undo
       48       get.
       49       private set.
       50     define property NumBundles as integer no-undo
       51       get.
       52       private set.
       53     define property ReturnMsg as character no-undo
       54       get.
       55       private set.
       56     define property SettingsTTList as character no-undo init ";;;20,yes;23,yes;;;20,yes;20,no;;20,yes;;;;;20,yes;;;;;1,no;"
       57       get.
       58       private set.
       59     define temp-table tt-egaisgds-hndls no-undo
       60       field mark             as character format "X(1)" label "*"
       61       field gdsCode          as integer   label "Код товара" format "9999999999"
       62       field alcCode          as character label "Алк. код товара" format "x(21)"
       63       field gdsName          as character label "Название товара" format "x(256)"
       64       field egaisGdsName     as character label "Название товара ЕГАИС" format "x(256)"
       65       field artic            as character label "Артикл" format "x(15)"
       66       field prod             as character label "Производитель TH" format "x(21)"
       67       field prodName         as character label "Производитель TH" format "x(256)"
       68       field prodInnkpp       as character label "ИНН/КПП производителя TH" format "x(30)"
       69       field prodEgais        as character label "Код производитель ЕГАИС" format "x(21)"
       70       field prodEgaisName    as character label "Производитель ЕГАИС" format "x(256)"
       71       field egaisTypeProd    as character label "Тип"
       72       field regionProd       as character label "Регион"
       73       field prodInnkppEgais  as character label "ИНН/КПП производителя ЕГАИС" format "x(30)"
       74       field imporEgais       as character label "Код импортер ЕГАИС" format "x(21)"
       75       field imporEgaisName   as character label "Импортер ЕГАИС" format "x(256)"
       76       field egaisTypeImpor   as character label "Тип"
       77       field regionImpor      as character label "Регион"
       78       field imporInnkppEgais as character label "ИНН/КПП импортера ЕГАИС" format "x(30)"
       79       field verXSD           as integer   label "Вер. XSD" format "99"
       80       field ColorNum         as integer init ?
       81       field capacity         as decimal   label "Объем"
       82       index pi as primary
       83       gdsCode alcCode
       84       .
       85     constructor public ExtGds (inIsSilent as logical):
       86       ExtSystem = getExtSystem().
       87       IsSilent = inIsSilent.
       88       if ExtSystem = 0 or ExtSystem = ?
       89         then
       90       do:
       91         if not IsSilent
       92           then message "Отсутсвует ВС настроенная для обмена с ЕГАИС" view-as alert-box.
       93         return error "Отсутсвует ВС настроенная для обмена с ЕГАИС".
       94       end.
       95     end constructor.
       96     destructor public ExtGds ():
       97       ClearProp().
       98     end destructor.
       99     method public logical OpenQueryExtGds (inAlcCode as char):
      100       return OpenQueryExtGds (0, inAlcCode).
      101     end.
      102     method public logical OpenQueryExtGds (inGdsCode as int):
      103       return OpenQueryExtGds (inGdsCode, "").
      104     end.
      105     method public void GetHndlTable (inGdsCode as int, inAlcCode as char, input-output outTTHndl as handle):
      106       def var ExtGdsValueObj as class ExtGdsValue no-undo.
      107       assign
      108         ReturnMsg = ""
      109       .
      110       empty temp-table tt-egaisgds-hndls.
      111       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'goods':U
      112         and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      113         and buf_ext-classif.db-num = 0
      114         and (inGdsCode = 0 or buf_ext-classif.key#_one = inGdsCode)
      115         and buf_ext-classif.key#_two = ExtSystem
      116         and buf_ext-classif.key#_three = 0
      117         and (inAlcCode = "" or buf_ext-classif.charkey_one = inAlcCode)
      118         and buf_ext-classif.charkey_two = ""
      119         and buf_ext-classif.charkey_three = ""
      120         and buf_ext-classif.nonunique = 0
      121         :
      122           find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      123             and buf_ext-classif-attr.classif-name = buf_ext-classif.classif-name
      124             and buf_ext-classif-attr.db-num = buf_ext-classif.db-num
      125             and buf_ext-classif-attr.Key#_One = buf_ext-classif.key#_one
      126             and buf_ext-classif-attr.Key#_two = buf_ext-classif.key#_two
      127             and buf_ext-classif-attr.Key#_three = buf_ext-classif.key#_three
      128             and buf_ext-classif-attr.CharKey_One = buf_ext-classif.charkey_one
      129             and buf_ext-classif-attr.CharKey_two = buf_ext-classif.charkey_two
      130             and buf_ext-classif-attr.CharKey_three = buf_ext-classif.charkey_three
      131             and buf_ext-classif-attr.nonunique = buf_ext-classif.nonunique
      132             and buf_ext-classif-attr.attr-code = 'egais-info'
      133             no-error .
      134           create tt-egaisgds-hndls.
      135           if available (buf_ext-classif-attr)
      136           then
      137             assign
      138               ExtGdsValueObj = GetInfoObj (buf_ext-classif-attr.attr-value)
      139             no-error.
      140           else
      141             assign
      142               ExtGdsValueObj = GetInfoObj ("")
      143             no-error.
      144           if error-status:error or not available (buf_ext-classif-attr)
      145             then
      146           do:
      147             ReturnMsg = "Товар" + string (buf_ext-classif.key#_one) + ". Выполните синхронизацию товаров.".
      148             if not IsSilent
      149               then message ReturnMsg view-as alert-box.
      150             tt-egaisgds-hndls.ColorNum = RED_COLOR.
      151           end.
      152           ExtGdsValueObj:AlcCode = buf_ext-classif.CharKey_One.
      153           ExtGdsValueObj:GdsCode = buf_ext-classif.Key#_One.
      154           assign
      155             tt-egaisgds-hndls.alcCode = ExtGdsValueObj:AlcCode
      156             tt-egaisgds-hndls.gdsCode = ExtGdsValueObj:GdsCode
      157             tt-egaisgds-hndls.prodEgaisName = ExtGdsValueObj:FullNameProd
      158             tt-egaisgds-hndls.prodEgais = ExtGdsValueObj:CliRegIdProd
      159             tt-egaisgds-hndls.imporEgais = ExtGdsValueObj:CliRegIdImpor
      160             tt-egaisgds-hndls.imporEgaisName = ExtGdsValueObj:FullNameImpor
      161             tt-egaisgds-hndls.imporInnkppEgais = ExtGdsValueObj:INNImpor + (if ExtGdsValueObj:KPPImpor <> "" then "/" + ExtGdsValueObj:KPPImpor else "")
      162             tt-egaisgds-hndls.prodInnkppEgais = ExtGdsValueObj:INNProd + (if ExtGdsValueObj:KPPProd <> "" then "/" + ExtGdsValueObj:KPPProd else "")
      163             tt-egaisgds-hndls.egaisGdsName = ExtGdsValueObj:FullNameGds
      164             tt-egaisgds-hndls.capacity = ExtGdsValueObj:Capacity
      165             tt-egaisgds-hndls.egaisTypeProd = ExtGdsValueObj:CliEgaisTypeProd
      166             tt-egaisgds-hndls.regionProd = ExtGdsValueObj:RegionProd
      167             tt-egaisgds-hndls.egaisTypeImpor = ExtGdsValueObj:CliEgaisTypeImpor
      168             tt-egaisgds-hndls.regionImpor = ExtGdsValueObj:RegionImpor
      169           .
      170           release buf_gds.
      171           find first buf_gds no-lock where buf_gds.gds-code = ExtGdsValueObj:GdsCode no-error.
      172           release buf_cli.
      173           find first buf_cli no-lock where buf_cli.obj-type = buf_gds.prod-type and buf_cli.obj-code = buf_gds.prod-code no-error.
      174           if valid-object (ExtGdsValueObj)
      175             then delete object ExtGdsValueObj.
      176           if tt-egaisgds-hndls.egaisTypeProd = ""
      177           then do:
      178             assign
      179               tt-egaisgds-hndls.verXSD = 1.
      180           end.
      181           else do:
      182             assign
      183               tt-egaisgds-hndls.verXSD = 2.
      184           end.
      185           if tt-egaisgds-hndls.prodInnkppEgais = "" and  tt-egaisgds-hndls.imporInnkppEgais = "" and tt-egaisgds-hndls.verXSD = 1
      186           then do:
      187             tt-egaisgds-hndls.ColorNum = RED_COLOR.
      188           end.
      189           if available (buf_gds)
      190           then
      191             assign
      192               tt-egaisgds-hndls.gdsName = buf_gds.gds-name
      193               tt-egaisgds-hndls.artic = buf_gds.artic
      194               tt-egaisgds-hndls.prod = buf_gds.prod-type + string (buf_gds.prod-code)
      195               tt-egaisgds-hndls.prodName = buf_cli.obj-name
      196             .
      197       end.
      198       outTTHndl = buffer tt-egaisgds-hndls:handle.
      199     end.
      200     method public logical OpenQueryExtGds (inGdsCode as int, inAlcCode as char):
      201       def var ii as int no-undo.
      202       ClearProp().
      203       assign
      204         ReturnMsg = ""
      205         AlcCodeItemQuery = inAlcCode
      206         GdsCodeItemQuery = inGdsCode
      207         ii = 0.
      208       for each buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'goods':U
      209         and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      210         and buf_ext-classif.db-num = 0
      211         and (GdsCodeItemQuery = 0 or buf_ext-classif.key#_one = GdsCodeItemQuery)
      212         and buf_ext-classif.key#_two = ExtSystem
      213         and buf_ext-classif.key#_three = 0
      214         and (AlcCodeItemQuery = "" or buf_ext-classif.charkey_one = AlcCodeItemQuery)
      215         and buf_ext-classif.charkey_two = ""
      216         and buf_ext-classif.charkey_three = ""
      217         and buf_ext-classif.nonunique = 0
      218         :
      219         find first buf_ext-classif-attr no-lock where buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      220           and buf_ext-classif-attr.classif-name = buf_ext-classif.classif-name
      221           and buf_ext-classif-attr.db-num = buf_ext-classif.db-num
      222           and buf_ext-classif-attr.Key#_One = buf_ext-classif.key#_one
      223           and buf_ext-classif-attr.Key#_two = buf_ext-classif.key#_two
      224           and buf_ext-classif-attr.Key#_three = buf_ext-classif.key#_three
      225           and buf_ext-classif-attr.CharKey_One = buf_ext-classif.charkey_one
      226           and buf_ext-classif-attr.CharKey_two = buf_ext-classif.charkey_two
      227           and buf_ext-classif-attr.CharKey_three = buf_ext-classif.charkey_three
      228           and buf_ext-classif-attr.nonunique = buf_ext-classif.nonunique
      229           and buf_ext-classif-attr.attr-code = 'egais-info'
      230           no-error .
      231         if not available (buf_ext-classif-attr)
      232           then
      233         do:
      234           ReturnMsg = "Отсутсвует атрибут egais-info - " + buf_ext-classif.charkey_one + "/" + string (buf_ext-classif.key#_one) + ". Выполните синхронизацию.".
      235           if not IsSilent
      236             then message ReturnMsg view-as alert-box.
      237         end.
      238         ii = ii + 1.
      239         setProp (ii) no-error.
      240         if ReturnMsg <> ""
      241           then
      242         do:
      243           if not IsSilent
      244             then message ReturnMsg view-as alert-box.
      245         end.
      246       end.
      247       NumBundles = ii.
      248       return true.
      249     end.
      250     method public class ExtGdsValue GetExtGdsValue () :
      251       return GetExtGdsValue (1).
      252     end.
      253     method public class ExtGdsValue GetExtGdsValue (inJJ as int) :
      254       find first ttObjEgaisAlcProp where ttObjEgaisAlcProp.iExtGdsObj = inJJ no-error.
      255       if not available (ttObjEgaisAlcProp)
      256         then return ?.
      257       return cast (ttObjEgaisAlcProp.ExtGdsValueObj, ibs.th.bge.egais.ExtGdsValue).
      258     end.
      259     method public logical CreateExtGds (inGdsCode as int, inAlcCode as char):
      260       define variable extGdsValueObj as class ExtGdsValue no-undo.
      261       define variable glog as logical no-undo.
      262       extGdsValueObj = new ExtGdsValue().
      263       extGdsValueObj:AlcCode = inAlcCode.
      264       extGdsValueObj:GdsCode = inGdsCode.
      265       glog = CreateExtGds(extGdsValueObj) .
      266       if not glog
      267         then if valid-object (extGdsValueObj)
      268                     then delete object extGdsValueObj.
      269       return glog.
      270     end.
      271     method public logical CreateExtGds (inExtGdsValueObj as class ExtGdsValue):
      272       ClearProp().
      273       assign
      274         ReturnMsg = ""
      275         AlcCodeItemQuery = inExtGdsValueObj:AlcCode
      276         GdsCodeItemQuery = inExtGdsValueObj:GdsCode
      277       .
      278       find first buf_gds no-lock where buf_gds.gds-code = inExtGdsValueObj:GdsCode no-error.
      279       if not available (buf_gds)
      280       then do:
      281         ReturnMsg = "Не найден товар TH - " + string (inExtGdsValueObj:GdsCode).
      282         if not IsSilent
      283           then message ReturnMsg view-as alert-box.
      284         AlcCodeItemQuery = "".
      285         GdsCodeItemQuery = 0.
      286         undo, return false.
      287       end.
      288       if inExtGdsValueObj:AlcCode = ? or inExtGdsValueObj:AlcCode = ""
      289       then do:
      290         ReturnMsg = "Неверное значение AlcCode".
      291         if not IsSilent
      292           then message ReturnMsg view-as alert-box.
      293         AlcCodeItemQuery = "".
      294         GdsCodeItemQuery = 0.
      295         undo, return false.
      296       end.
      297       do trans:
      298         find first buf_ext-classif no-lock  where buf_ext-classif.classif-subject = 'goods':U
      299           and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      300           and buf_ext-classif.db-num = 0
      301           and buf_ext-classif.Key#_One = inExtGdsValueObj:GdsCode
      302           and buf_ext-classif.key#_two = ExtSystem
      303           and buf_ext-classif.key#_three = 0
      304           and buf_ext-classif.charkey_one = inExtGdsValueObj:AlcCode
      305           and buf_ext-classif.charkey_two = ""
      306           and buf_ext-classif.charkey_three = ""
      307           and buf_ext-classif.nonunique = 0
      308           no-error.
      309         if available (buf_ext-classif)
      310           then
      311         do:
      312           ReturnMsg = "Уже есть связка товара ЕГАИС - " + inExtGdsValueObj:AlcCode + " c товаром TH - " + string (inExtGdsValueObj:GdsCode).
      313           if not IsSilent
      314             then message ReturnMsg view-as alert-box.
      315           AlcCodeItemQuery = "".
      316           GdsCodeItemQuery = 0.
      317           undo, return false.
      318         end.
      319         create buf_ext-classif.
      320         assign
      321           buf_ext-classif.classif-subject = 'goods':U
      322           buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      323           buf_ext-classif.db-num = 0
      324           buf_ext-classif.Key#_One = inExtGdsValueObj:GdsCode
      325           buf_ext-classif.key#_two = ExtSystem
      326           buf_ext-classif.key#_three = 0
      327           buf_ext-classif.charkey_one = inExtGdsValueObj:AlcCode
      328           buf_ext-classif.charkey_two = ""
      329           buf_ext-classif.charkey_three = ""
      330           buf_ext-classif.nonunique = 0
      331           buf_ext-classif.uniq-key-rec = 'goods':U + chr(3) + string (inExtGdsValueObj:GdsCode)
      332         no-error.
      333         if error-status:error
      334           then
      335         do:
      336           delete buf_ext-classif.
      337           ReturnMsg = "Непредвиденная ошибка при создании связки  - " + inExtGdsValueObj:AlcCode + " TH - " + string (inExtGdsValueObj:GdsCode).
      338           if not IsSilent
      339             then message ReturnMsg view-as alert-box.
      340           AlcCodeItemQuery = "".
      341           GdsCodeItemQuery = 0.
      342           undo, return false.
      343         end.
      344         create buf_ext-classif-attr.
      345         assign
      346           buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      347           buf_ext-classif-attr.classif-name    = buf_ext-classif.classif-name
      348           buf_ext-classif-attr.db-num          = buf_ext-classif.db-num
      349           buf_ext-classif-attr.Key#_One        = buf_ext-classif.key#_one
      350           buf_ext-classif-attr.Key#_two        = buf_ext-classif.key#_two
      351           buf_ext-classif-attr.Key#_three      = buf_ext-classif.key#_three
      352           buf_ext-classif-attr.CharKey_One     = buf_ext-classif.charkey_one
      353           buf_ext-classif-attr.CharKey_two     = buf_ext-classif.charkey_two
      354           buf_ext-classif-attr.CharKey_three   = buf_ext-classif.charkey_three
      355           buf_ext-classif-attr.nonunique       = buf_ext-classif.nonunique
      356           buf_ext-classif-attr.attr-code       = 'egais-info'
      357         no-error.
      358         if error-status:error
      359           then
      360         do:
      361           delete buf_ext-classif-attr.
      362           ReturnMsg = "Запись уже есть buf_ext-classif-attr. Создание будет продолжено. Непредвиденная ситуация при создании атрибута egais-info  - " + inExtGdsValueObj:AlcCode + " TH - " + string (inExtGdsValueObj:GdsCode).
      363           if not IsSilent
      364             then message ReturnMsg view-as alert-box.
      365           find first buf_ext-classif-attr where
      366             buf_ext-classif-attr.classif-subject = buf_ext-classif.classif-subject
      367             and buf_ext-classif-attr.classif-name    = buf_ext-classif.classif-name
      368             and buf_ext-classif-attr.db-num          = buf_ext-classif.db-num
      369             and buf_ext-classif-attr.Key#_One        = buf_ext-classif.key#_one
      370             and buf_ext-classif-attr.Key#_two        = buf_ext-classif.key#_two
      371             and buf_ext-classif-attr.Key#_three      = buf_ext-classif.key#_three
      372             and buf_ext-classif-attr.CharKey_One     = buf_ext-classif.charkey_one
      373             and buf_ext-classif-attr.CharKey_two     = buf_ext-classif.charkey_two
      374             and buf_ext-classif-attr.CharKey_three   = buf_ext-classif.charkey_three
      375             and buf_ext-classif-attr.nonunique       = buf_ext-classif.nonunique
      376             and buf_ext-classif-attr.attr-code       = 'egais-info'
      377           no-error.
      378         end.
      379         if not SaveEGAISInfoDB (inExtGdsValueObj)
      380           then do:
      381             AlcCodeItemQuery = "".
      382             GdsCodeItemQuery = 0.
      383             undo, return false.
      384           end.
      385       end.
      386       create ttObjEgaisAlcProp.
      387       NumBundles = 1.
      388       ttObjEgaisAlcProp.iExtGdsObj = 1.
      389       cast (ttObjEgaisAlcProp.ExtGdsValueObj, ibs.th.bge.egais.ExtGdsValue) = inExtGdsValueObj.
      390       return true.
      391     end.
      392     method public logical DeleteExtGds (inGdsCode as int):
      393       if DeleteExtGds ( inGdsCode, ? )
      394         then return true.
      395         else return false.
      396     end.
      397     method public logical DeleteExtGds (inAlcCode as char):
      398       if DeleteExtGds (  ?, inAlcCode )
      399         then return true.
      400         else return false.
      401     end.
      402     method public logical DeleteExtGds (inGdsCode as int, inAlcCode as char):
      403       ReturnMsg = "".
      404       do trans:
      405         for each buf_ext-classif-attr exclusive-lock where
      406               buf_ext-classif-attr.classif-subject = 'goods':U
      407           and buf_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      408           and buf_ext-classif-attr.db-num = 0
      409           and (inGdsCode = ? or buf_ext-classif-attr.Key#_One = inGdsCode)
      410           and buf_ext-classif-attr.key#_two = ExtSystem
      411           and (inAlcCode = ? or buf_ext-classif-attr.charkey_one = inAlcCode)
      412           :
      413           delete buf_ext-classif-attr.
      414         end.
      415         for each buf_ext-classif exclusive-lock where
      416               buf_ext-classif.classif-subject = 'goods':U
      417           and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      418           and buf_ext-classif.db-num = 0
      419           and buf_ext-classif.key#_two = ExtSystem
      420           and (inGdsCode = ? or buf_ext-classif.Key#_One = inGdsCode)
      421           and (inAlcCode = ? or buf_ext-classif.charkey_one = inAlcCode)
      422           :
      423           delete buf_ext-classif.
      424         end.
      425       end.
      426       ClearProp ().
      427       return true.
      428     end.
      429     method public logical SaveEGAISInfo (inExtGdsValueObj as ExtGdsValue):
      430       def var glog as log no-undo.
      431       do trans:
      432         find first buf_ext-classif-attr where
      433               buf_ext-classif-attr.classif-subject = 'goods':U
      434           and buf_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      435           and buf_ext-classif-attr.db-num = 0
      436           and buf_ext-classif-attr.Key#_One = inExtGdsValueObj:GdsCode
      437           and buf_ext-classif-attr.key#_two = ExtSystem
      438           and buf_ext-classif-attr.key#_three = 0
      439           and buf_ext-classif-attr.charkey_one = inExtGdsValueObj:AlcCode
      440           and buf_ext-classif-attr.charkey_two = ""
      441           and buf_ext-classif-attr.charkey_three = ""
      442           and buf_ext-classif-attr.attr-code = 'egais-info'
      443         no-error.
      444         if not available (buf_ext-classif-attr)
      445         then do:
      446           create buf_ext-classif-attr.
      447           assign
      448             buf_ext-classif-attr.classif-subject = 'goods':U
      449             buf_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      450             buf_ext-classif-attr.db-num = 0
      451             buf_ext-classif-attr.Key#_One = inExtGdsValueObj:GdsCode
      452             buf_ext-classif-attr.key#_two = ExtSystem
      453             buf_ext-classif-attr.key#_three = 0
      454             buf_ext-classif-attr.charkey_one = inExtGdsValueObj:AlcCode
      455             buf_ext-classif-attr.charkey_two = ""
      456             buf_ext-classif-attr.charkey_three = ""
      457             buf_ext-classif-attr.attr-code = 'egais-info'.
      458         end.
      459         glog = SaveEGAISInfoDB (inExtGdsValueObj).
      460       end.
      461       return glog.
      462     end.
      463     method private logical SaveEGAISInfoDB (inExtGdsValueObj as ExtGdsValue):
      464       def var v-prod  as char no-undo.
      465       def var v-impor as char no-undo.
      466       def var v-msg   as char no-undo.
      467       ReturnMsg = "".
      468       v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5).
      469       v-impor = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5).
      470       entry (1, v-prod, chr(5)) = inExtGdsValueObj:CliRegIdProd.
      471       entry (2, v-prod, chr(5)) = inExtGdsValueObj:INNProd.
      472       entry (3, v-prod, chr(5)) = inExtGdsValueObj:KPPProd.
      473       entry (4, v-prod, chr(5)) = inExtGdsValueObj:FullNameProd.
      474       entry (5, v-prod, chr(5)) = inExtGdsValueObj:CountryProd.
      475       entry (6, v-prod, chr(5)) = inExtGdsValueObj:DescrProd.
      476       entry (7, v-prod, chr(5)) = inExtGdsValueObj:CliEgaisTypeProd.
      477       entry (8, v-prod, chr(5)) = inExtGdsValueObj:RegionProd.
      478       entry (1, v-impor, chr(5)) = inExtGdsValueObj:CliRegIdImpor.
      479       entry (2, v-impor, chr(5)) = inExtGdsValueObj:INNImpor.
      480       entry (3, v-impor, chr(5)) = inExtGdsValueObj:KPPImpor.
      481       entry (4, v-impor, chr(5)) = inExtGdsValueObj:FullNameImpor.
      482       entry (5, v-impor, chr(5)) = inExtGdsValueObj:CountryImpor.
      483       entry (6, v-impor, chr(5)) = inExtGdsValueObj:DescrImpor.
      484       entry (7, v-impor, chr(5)) = inExtGdsValueObj:CliEgaisTypeImpor.
      485       entry (8, v-impor, chr(5)) = inExtGdsValueObj:RegionImpor.
      486       buf_ext-classif-attr.attr-value = v-prod + chr(4) + v-impor + chr(4) + inExtGdsValueObj:FullNameGds + chr(4) + string (inExtGdsValueObj:Capacity).
      487       release buf_ext-classif-attr.
      488     end.
      489     method public void Release_ ():
      490       ClearProp().
      491     end.
      492     method public logical CopyEgaisInfo (inExtGdsValueObjForm as ExtGdsValue, inExtGdsValueObjTo as class ExtGdsValue) :
      493       ReturnMsg = "".
      494       if not valid-object (inExtGdsValueObjForm) or not valid-object (inExtGdsValueObjTo)
      495       then do:
      496         ReturnMsg = "Не найден объект inExtGdsValueObjForm или inExtGdsValueObjTo".
      497         if not IsSilent
      498           then message ReturnMsg view-as alert-box.
      499         return false.
      500       end.
      501       assign
      502         inExtGdsValueObjTo:CliRegIdImpor = inExtGdsValueObjForm:CliRegIdImpor
      503         inExtGdsValueObjTo:CliRegIdProd = inExtGdsValueObjForm:CliRegIdProd
      504         inExtGdsValueObjTo:CountryImpor = inExtGdsValueObjForm:CountryImpor
      505         inExtGdsValueObjTo:CountryProd = inExtGdsValueObjForm:CountryProd
      506         inExtGdsValueObjTo:DescrImpor = inExtGdsValueObjForm:DescrImpor
      507         inExtGdsValueObjTo:DescrProd = inExtGdsValueObjForm:DescrProd
      508         inExtGdsValueObjTo:FullNameGds = inExtGdsValueObjForm:FullNameGds
      509         inExtGdsValueObjTo:Capacity = inExtGdsValueObjForm:Capacity
      510         inExtGdsValueObjTo:FullNameImpor = inExtGdsValueObjForm:FullNameImpor
      511         inExtGdsValueObjTo:FullNameProd = inExtGdsValueObjForm:FullNameProd
      512         inExtGdsValueObjTo:INNImpor = inExtGdsValueObjForm:INNImpor
      513         inExtGdsValueObjTo:INNProd = inExtGdsValueObjForm:INNProd
      514         inExtGdsValueObjTo:KPPImpor = inExtGdsValueObjForm:KPPImpor
      515         inExtGdsValueObjTo:KPPProd = inExtGdsValueObjForm:KPPProd
      516         inExtGdsValueObjTo:CliEgaisTypeImpor = inExtGdsValueObjForm:CliEgaisTypeImpor
      517         inExtGdsValueObjTo:CliEgaisTypeProd = inExtGdsValueObjForm:CliEgaisTypeProd
      518         inExtGdsValueObjTo:RegionImpor = inExtGdsValueObjForm:RegionImpor
      519         inExtGdsValueObjTo:RegionProd = inExtGdsValueObjForm:RegionProd
      520       no-error.
      521       if error-status:error
      522       then do:
      523         ReturnMsg = "Ошибка присвоения свойств объекта inExtGdsValueObjTo".
      524         if not IsSilent
      525           then message ReturnMsg view-as alert-box.
      526         return false.
      527       end.
      528       return true.
      529     end.
      530     method private integer GetExtSystem ():
      531       define variable v-value-character as character no-undo .
      532       define variable v-value-decimal   as decimal   no-undo .
      533       define variable v-value-integer   as integer   no-undo .
      534       define variable v-value-logical   as logical   no-undo .
      535       define variable v-value-type      as character no-undo .
      536       define variable v-value-date      as date      no-undo .
      537       define variable v-ext-sys         as integer   no-undo .
      538       empty temp-table thbjattr_thbj-attr.
      539       run adm/shattri.p (
      540         input "get":U
      541         ,input '':U
      542         ,input 0
      543         ,input 'egais':U
      544         ,input 'egais-exsys':U
      545         ,output v-value-character
      546         ,output v-value-date
      547         ,output v-value-decimal
      548         ,output v-value-integer
      549         ,output v-value-logical
      550         ,output v-value-type
      551         ,input-output table thbjattr_thbj-attr
      552         ) no-error .
      553       return v-value-integer .
      554     end.
      555     method private void setProp (inJJ as int):
      556       def var v-prod  as char no-undo.
      557       def var v-impor as char no-undo.
      558       def var v-msg   as char no-undo.
      559       def var hndlclsExtGdsValueObj as class ExtGdsValue no-undo.
      560       def var ExtGdsValueObj as class ExtGdsValue no-undo.
      561       v-prod = ''.
      562       v-impor = ''.
      563       ReturnMsg = "".
      564       hndlclsExtGdsValueObj = new ExtGdsValue().
      565       create ttObjEgaisAlcProp.
      566       assign
      567         ttObjEgaisAlcProp.iExtGdsObj = inJJ
      568         ttObjEgaisAlcProp.ExtGdsValueObj = cast (hndlclsExtGdsValueObj,Progress.Lang.Object).
      569       find current buf_ext-classif-attr no-lock no-error.
      570       if not available (buf_ext-classif-attr)
      571         then
      572       do:
      573         ReturnMsg = ReturnMsg + " Товар" + string (hndlclsExtGdsValueObj:AlcCode) + "/" + string (hndlclsExtGdsValueObj:GdsCode) + ". Выполните синхронизацию товаров.".
      574         if not IsSilent
      575           then message ReturnMsg view-as alert-box.
      576       end.
      577       if available (buf_ext-classif-attr)
      578       then
      579         assign
      580           ExtGdsValueObj = GetInfoObj (buf_ext-classif-attr.attr-value)
      581         no-error.
      582       else
      583         assign
      584           ExtGdsValueObj = GetInfoObj ("")
      585         no-error.
      586       if ReturnMsg <> ""
      587         then
      588       do:
      589         ReturnMsg = ReturnMsg + " Товар" + string (buf_ext-classif.key#_one) + ". Выполните синхронизацию товаров.".
      590         if not IsSilent
      591           then message ReturnMsg view-as alert-box.
      592       end.
      593       ExtGdsValueObj:AlcCode = buf_ext-classif.CharKey_One.
      594       ExtGdsValueObj:GdsCode = buf_ext-classif.Key#_One.
      595       assign
      596         hndlclsExtGdsValueObj:AlcCode = ExtGdsValueObj:AlcCode
      597         hndlclsExtGdsValueObj:GdsCode = ExtGdsValueObj:GdsCode
      598         hndlclsExtGdsValueObj:CliRegIdProd = ExtGdsValueObj:CliRegIdProd
      599         hndlclsExtGdsValueObj:INNProd = ExtGdsValueObj:INNProd
      600         hndlclsExtGdsValueObj:KPPProd = ExtGdsValueObj:KPPProd
      601         hndlclsExtGdsValueObj:FullNameProd = ExtGdsValueObj:FullNameProd
      602         hndlclsExtGdsValueObj:CountryProd = ExtGdsValueObj:CountryProd
      603         hndlclsExtGdsValueObj:DescrProd = ExtGdsValueObj:DescrProd
      604         hndlclsExtGdsValueObj:CliEgaisTypeProd = ExtGdsValueObj:CliEgaisTypeProd
      605         hndlclsExtGdsValueObj:RegionProd = ExtGdsValueObj:RegionProd
      606         hndlclsExtGdsValueObj:CliRegIdImpor = ExtGdsValueObj:CliRegIdImpor
      607         hndlclsExtGdsValueObj:INNImpor = ExtGdsValueObj:INNImpor
      608         hndlclsExtGdsValueObj:KPPImpor = ExtGdsValueObj:KPPImpor
      609         hndlclsExtGdsValueObj:FullNameImpor = ExtGdsValueObj:FullNameImpor
      610         hndlclsExtGdsValueObj:CountryImpor = ExtGdsValueObj:CountryImpor
      611         hndlclsExtGdsValueObj:DescrImpor = ExtGdsValueObj:DescrImpor
      612         hndlclsExtGdsValueObj:CliEgaisTypeImpor = ExtGdsValueObj:CliEgaisTypeImpor
      613         hndlclsExtGdsValueObj:RegionImpor = ExtGdsValueObj:RegionImpor
      614         hndlclsExtGdsValueObj:FullNameGds = ExtGdsValueObj:FullNameGds
      615         hndlclsExtGdsValueObj:Capacity = ExtGdsValueObj:Capacity
      616       .
      617       hndlclsExtGdsValueObj:extFormF1Obj:OpenQueryExtFormF1(ExtGdsValueObj:AlcCode).
      618       if valid-object (ExtGdsValueObj)
      619         then delete object ExtGdsValueObj.
      620     end.
      621     method private void ClearProp ():
      622       AlcCodeItemQuery = "".
      623       GdsCodeItemQuery = 0.
      624       NumBundles = 0.
      625       for each ttObjEgaisAlcProp:
      626         if valid-object (ttObjEgaisAlcProp.ExtGdsValueObj)
      627           then delete object ttObjEgaisAlcProp.ExtGdsValueObj.
      628       end.
      629       empty temp-table ttObjEgaisAlcProp.
      630     end.
      631     method public class ExtGdsValue GetInfoObj (inInfoValue as char):
      632       def var ExtGdsValueObj as class ExtGdsValue no-undo.
      633       def var v-msg   as char no-undo.
      634       def var v-prod  as char no-undo.
      635       def var v-impor as char no-undo.
      636       ExtGdsValueObj = new ExtGdsValue().
      637       if num-entries (inInfoValue, chr(4)) < 3
      638         then
      639       do:
      640         ReturnMsg = "Некорректный атрибут egais-info - " + inInfoValue.
      641         return ExtGdsValueObj.
      642       end.
      643       v-prod = entry (1, inInfoValue, chr(4)) no-error.
      644       if num-entries (v-prod, chr (5)) < 6
      645         then
      646       do:
      647         ReturnMsg = "Некорректный атрибут egais-info v-prod - " + inInfoValue.
      648         return ExtGdsValueObj.
      649       end.
      650       v-impor = entry (2, inInfoValue, chr(4)) no-error.
      651       if  num-entries (v-impor, chr (5)) < 6
      652         then
      653       do:
      654         ReturnMsg = "Некорректный атрибут egais-info v-impor - " + inInfoValue.
      655         return ExtGdsValueObj.
      656       end.
      657       ExtGdsValueObj:CliRegIdProd = entry (1, v-prod, chr(5)).
      658       ExtGdsValueObj:INNProd = entry (2, v-prod, chr(5)).
      659       ExtGdsValueObj:KPPProd = entry (3, v-prod, chr(5)).
      660       ExtGdsValueObj:FullNameProd = entry (4, v-prod, chr(5)).
      661       ExtGdsValueObj:CountryProd = entry (5, v-prod, chr(5)).
      662       ExtGdsValueObj:DescrProd = entry (6, v-prod, chr(5)).
      663       assign
      664       ExtGdsValueObj:CliEgaisTypeProd = entry (7, v-prod, chr(5)) when num-entries (v-prod, chr (5)) > 6
      665       ExtGdsValueObj:RegionProd = entry (8, v-prod, chr(5)) when num-entries (v-prod, chr (5)) > 7
      666       .
      667       ExtGdsValueObj:CliRegIdImpor = entry (1, v-impor, chr(5)).
      668       ExtGdsValueObj:INNImpor = entry (2, v-impor, chr(5)).
      669       ExtGdsValueObj:KPPImpor = entry (3, v-impor, chr(5)).
      670       ExtGdsValueObj:FullNameImpor = entry (4, v-impor, chr(5)).
      671       ExtGdsValueObj:CountryImpor = entry (5, v-impor, chr(5)).
      672       ExtGdsValueObj:DescrImpor = entry (6, v-impor, chr(5)).
      673       assign
      674       ExtGdsValueObj:CliEgaisTypeImpor = entry (7, v-impor, chr(5)) when num-entries (v-impor, chr (5)) > 6
      675       ExtGdsValueObj:RegionImpor = entry (8, v-impor, chr(5)) when num-entries (v-impor, chr (5)) > 7
      676       .
      677       ExtGdsValueObj:FullNameGds = entry (3, inInfoValue, chr(4)).
      678       if num-entries (inInfoValue, chr(4)) > 3
      679       then do:
      680         ExtGdsValueObj:Capacity = decimal (entry (4, inInfoValue, chr(4))) no-error.
      681         if error-status:error
      682         then do:
      683           ExtGdsValueObj:Capacity = 0.
      684         end.
      685       end.
      686       return ExtGdsValueObj.
      687     end.
      688   end class.
