       82   procedure alc-type-attr-value :
       83     define input  parameter p-alc-type-inner-code as integer   no-undo .
       84     define input  parameter p-create-user-db-num  as integer   no-undo .
       85     define input  parameter p-code                as character no-undo .
       86     define output parameter p-value               as character no-undo .
       87     define output parameter p-status              as integer   no-undo .
       88     define output parameter p-corr-date           as date      no-undo .
       89     define output parameter p-corr-time           as integer   no-undo .
       90     define output parameter p-corr-user-name      as character no-undo .
       91     define output parameter p-create-date         as date      no-undo .
       92     define output parameter p-create-time         as integer   no-undo .
       93     define output parameter p-create-user         as character no-undo .
       94     define buffer buf_alc-type-attr for ub.alc-type-attr .
       95     do
       96     on error undo, return error
       97     :
       98          find first buf_alc-type-attr no-lock where
       99                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      100               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      101               and   buf_alc-type-attr.attr-code             = p-code no-error .
      102         if not available buf_alc-type-attr then do:
      103           return error return-value
      104           .
      105         end.
      106         else do:
      107         assign
      108           p-value           = buf_alc-type-attr.attr-value
      109           p-status          = buf_alc-type-attr.attr-status
      110           p-corr-date       = buf_alc-type-attr.corr-date
      111           p-corr-time       = buf_alc-type-attr.corr-time
      112           p-corr-user-name  = buf_alc-type-attr.corr-user-name
      113           p-create-date     = buf_alc-type-attr.create-date
      114           p-create-time     = buf_alc-type-attr.create-time
      115           p-create-user     = buf_alc-type-attr.create-user
      116         .
      117         end.
      118     end.
      119   end procedure.
      120   procedure alc-type-attr-val :
      121     define input  parameter p-alc-type-inner-code as integer   no-undo .
      122     define input  parameter p-create-user-db-num  as integer   no-undo .
      123     define input  parameter p-code                as character no-undo .
      124     define output parameter p-value               as character no-undo .
      125     define buffer buf_alc-type-attr for ub.alc-type-attr .
      126     do
      127     on error undo, return error
      128     :
      129          find first buf_alc-type-attr no-lock where
      130                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      131               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      132               and   buf_alc-type-attr.attr-code             = p-code no-error .
      133         if not available buf_alc-type-attr then do:
      134           return error return-value
      135           .
      136         end.
      137         else do:
      138         assign
      139           p-value           = buf_alc-type-attr.attr-value
      140         .
      141         end.
      142     end.
      143   end procedure.
      144   procedure alc-type-attr-write :
      145     define input  parameter p-alc-type-inner-code as integer   no-undo .
      146     define input  parameter p-create-user-db-num  as integer   no-undo .
      147     define input  parameter p-code                as character no-undo .
      148     define input parameter p-value                as character no-undo .
      149     define input parameter p-status               as integer   no-undo .
      150     define input parameter p-corr-date            as date      no-undo .
      151     define input parameter p-corr-time            as integer   no-undo .
      152     define input parameter p-corr-user-name       as character no-undo .
      153     define input parameter p-create-date          as date      no-undo .
      154     define input parameter p-create-time          as integer   no-undo .
      155     define input parameter p-create-user          as character no-undo .
      156     define buffer buf_alc-type-attr for ub.alc-type-attr .
      157     do
      158     on error undo, return error
      159     :
      160          find first buf_alc-type-attr no-lock where
      161                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      162               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      163               and   buf_alc-type-attr.attr-code             = p-code no-error .
      164         if not available buf_alc-type-attr then do:
      165           create buf_alc-type-attr .
      166           assign
      167             buf_alc-type-attr.alc-type-inner-code = p-alc-type-inner-code
      168             buf_alc-type-attr.create-user-db-num  = p-create-user-db-num
      169             buf_alc-type-attr.attr-code           = p-code
      170             buf_alc-type-attr.attr-value          = p-value
      171             buf_alc-type-attr.attr-status         = p-status
      172             buf_alc-type-attr.corr-date           = p-corr-date
      173             buf_alc-type-attr.corr-time           = p-corr-time
      174             buf_alc-type-attr.corr-user-name      = p-corr-user-name
      175             buf_alc-type-attr.create-date         = p-create-date
      176             buf_alc-type-attr.create-time         = p-create-time
      177             buf_alc-type-attr.create-user         = p-create-user
      178           .
      179         end.
      180         else do:
      181         assign
      182             buf_alc-type-attr.attr-value          = p-value
      183             buf_alc-type-attr.attr-status         = p-status
      184             buf_alc-type-attr.corr-date           = p-corr-date
      185             buf_alc-type-attr.corr-time           = p-corr-time
      186             buf_alc-type-attr.corr-user-name      = p-corr-user-name
      187             buf_alc-type-attr.create-date         = p-create-date
      188             buf_alc-type-attr.create-time         = p-create-time
      189             buf_alc-type-attr.create-user         = p-create-user
      190         .
      191         end.
      192     end.
      193   end procedure.
      194   procedure alc-type-attr-delete :
      195     define input  parameter p-alc-type-inner-code as integer   no-undo .
      196     define input  parameter p-create-user-db-num  as integer   no-undo .
      197     define input  parameter p-code                as character no-undo .
      198     define buffer buf_alc-type-attr for ub.alc-type-attr .
      199     do
      200     on error undo, return error
      201     :
      202          find first buf_alc-type-attr exclusive-lock where
      203                     buf_alc-type-attr.alc-type-inner-code   = p-alc-type-inner-code
      204               and   buf_alc-type-attr.create-user-db-num    = p-create-user-db-num
      205               and   buf_alc-type-attr.attr-code             = p-code no-error .
      206         if not available buf_alc-type-attr then do:
      207           return error return-value
      208           .
      209         end.
      210         else do:
      211           delete buf_alc-type-attr .
      212         end.
      213     end.
      214   end procedure.
