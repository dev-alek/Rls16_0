      356       .
      357   define input  parameter table for  tt-wb-header.
      358   define input  parameter table for  tt-wb-gds-EG.
      359   define input  parameter userId_ as character no-undo.
      360   define input  parameter Mode as character no-undo.
      361   define input-output parameter p-doc-code as character no-undo.
      362   define stream outstr.
      363   define variable iDbNum as integer no-undo.
      364   define variable MsgLog as character no-undo.
      365   define buffer buf_goods for ub.goods.
      366   define buffer buf_doc-attr for ub.doc-attr.
      367   MAIN-BLOCK:
      368   do trans:
      369     define variable num-rec-ok as logical no-undo.
      370     define variable ii         as integer no-undo.
      371     define variable jj         as integer no-undo.
      372     define variable minPrice   as decimal no-undo.
      373     define variable logWrite   as class   LogWrite no-undo.
      374     find first tt-wb-header no-lock.
      375   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      377     (output iDbNum
      378     ,output userId_
      379     ) no-error .
      380     create temp_trn-doc.
      381     assign
      382       temp_trn-doc.line-num      = ii
      383       temp_trn-doc.doc-date      = tt-wb-header.wb-date
      384       temp_trn-doc.ps            = tt-wb-header.ps
      385       temp_trn-doc.doc-code      = tt-wb-header.wbregid + chr(6) + tt-wb-header.uniq-key-rec
      386       temp_trn-doc.ext-doc-type  = tt-wb-header.wb-type
      387       temp_trn-doc.cli-type      = tt-wb-header.cli-type
      388       temp_trn-doc.cli-code      = tt-wb-header.cli-code
      389       temp_trn-doc.obj-type      = tt-wb-header.obj-type
      390       temp_trn-doc.obj-code      = tt-wb-header.obj-code
      391       temp_trn-doc.cargo-from    = tt-wb-header.cargo-from
      392       temp_trn-doc.exch-code     = 0
      393       temp_trn-doc.exch-rate     = 1
      394       temp_trn-doc.exch-scale    = 1
      395       temp_trn-doc.contract-code = ?
      396       temp_trn-doc.price-type    = if tt-wb-header.wb-type = 'ee':U then "TSFTSD" else ""
      397       .
      398     jj = 0.
      399     for each tt-wb-gds-EG no-lock:
      400       find first buf_goods no-lock where buf_goods.gds-code = tt-wb-gds-EG.gds-code no-error.
      401       if not available (buf_goods)
      402       then do:
      403         return error ("Не найден товар с кодом - " + string (tt-wb-gds-EG.gds-code)).
      404       end.
      405       jj = jj + 1.
      406       create temp_doc-line.
      407       assign
      408         temp_doc-line.line-num   = jj
      409         temp_doc-line.gds-code   = tt-wb-gds-EG.gds-code
      410         temp_doc-line.price-cli  = tt-wb-gds-EG.price
      411         temp_doc-line.doc-code   = temp_trn-doc.doc-code
      412         temp_doc-line.RefA = tt-wb-gds-EG.RefA
      413         temp_doc-line.RefB = tt-wb-gds-EG.RefB
      414         temp_doc-line.alc-code = tt-wb-gds-EG.alc-code
      415         temp_doc-line.alc-type-code = tt-wb-gds-EG.alc-type-code
      416         temp_doc-line.importer-th = tt-wb-gds-EG.importer-th
      417         temp_doc-line.line-num-str = tt-wb-gds-EG.Identity
      418       .
      419       find first ub.alc-type where ub.alc-type.alc-type-code = tt-wb-gds-EG.alc-type-code no-error.
      420       if available (ub.alc-type)
      421       then do:
      422         run alc-type-attr-val (  input   ub.alc-type.alc-type-inner-code,
      423                                  input   ub.alc-type.create-user-db-num,
      424                                  input   "alc-min-price",
      425                                  output  minPrice
      426                               )  no-error.
      427       end.
      428       if tt-wb-gds-EG.price < minPrice * buf_goods.cli-base-rate
      429       then do:
      430         MsgLog = MsgLog + chr(10) + substitute ("Для товара &2/&1 &3 цена в накладной ЕГАИС - &4 меньше допустимой - &5 по группе &6", tt-wb-gds-EG.alc-code, buf_goods.gds-code, tt-wb-gds-EG.gds-name, tt-wb-gds-EG.price * buf_goods.cli-base-rate, minPrice, tt-wb-gds-EG.alc-type-code).
      431       end.
      432       if tt-wb-header.UnitType <> ''
      433       then do:
      434         if true
      435         then
      436           assign
      437             temp_doc-line.fact-qnty  = buf_goods.cli-base-rate * tt-wb-gds-EG.qnty
      438             temp_doc-line.doc-qnty   = buf_goods.cli-base-rate * tt-wb-gds-EG.qnty
      439             temp_doc-line.cli-qnty   = tt-wb-gds-EG.qnty
      440             temp_doc-line.price-cli = tt-wb-gds-EG.price
      441           .
      442         else
      443           assign
      444             temp_doc-line.fact-qnty  = tt-wb-gds-EG.qnty
      445             temp_doc-line.doc-qnty   = tt-wb-gds-EG.qnty
      446             temp_doc-line.cli-qnty   = tt-wb-gds-EG.qnty
      447             temp_doc-line.price-cli = tt-wb-gds-EG.price
      448           .
      449       end.
      450       else do:
      451         if tt-wb-gds-EG.UnitType = 'UnPacked'
      452         then
      453           assign
      454             temp_doc-line.fact-qnty  = buf_goods.cli-base-rate * tt-wb-gds-EG.qnty
      455             temp_doc-line.doc-qnty   = buf_goods.cli-base-rate * tt-wb-gds-EG.qnty
      456             temp_doc-line.cli-qnty   = tt-wb-gds-EG.qnty
      457             temp_doc-line.price-cli = tt-wb-gds-EG.price
      458           .
      459         else
      460           assign
      461             temp_doc-line.fact-qnty  = tt-wb-gds-EG.qnty
      462             temp_doc-line.doc-qnty   = tt-wb-gds-EG.qnty
      463             temp_doc-line.cli-qnty   = tt-wb-gds-EG.qnty
      464             temp_doc-line.price-cli = tt-wb-gds-EG.price
      465           .
      466       end.
      467     end.
      468     if MsgLog <> ""
      469     then do:
      470       output stream outstr to value ("warWBLog.txt").
      471       put stream outstr unformatted MsgLog.
      472       output stream outstr close.
      473       message substitute ("&2&1 Продолжить?", MsgLog, chr(10)) view-as alert-box question buttons yes-no title "Вопрос..." update isChoise as logical.
      474       if isChoise
      475       then do:
      476         MsgLog = "".
      477       end.
      478       else do:
      479         return error "Отменено пользователем." .
      480       end.
      481     end.
      482     case Mode:
      483       when "set-refAB"
      484       then do:
      485         run set-refAB no-error.
      486         if error-status:error
      487         then do:
      488           return error return-value .
      489         end.
      490       end.
      491       when "conn" then do:
      492         run set-refAB no-error.
      493         if error-status:error
      494         then do:
      495           return error return-value .
      496         end.
      497         def var temp-str as char no-undo.
      498         for each buf_doc-attr exclusive-lock where buf_doc-attr.attr-code = 'negais':U and buf_doc-attr.attr-value begins (tt-wb-header.wbregid):
      499           delete buf_doc-attr.
      500         end.
      501         temp-str = string(tt-wb-header.wbregid + chr(6) + tt-wb-header.uniq-key-rec).
      502   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      503                          input 'negais':U ,
      504                          input temp-str ) no-error .
      505         if error-status:error
      506         then do:
      507           return error MsgLog + chr(10) + return-value.
      508         end.
      509   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      510                          input 'nids':U ,
      511                          input entry(1,tt-wb-header.uniq-key-rec,chr(6)) ) no-error .
      512         if error-status:error
      513         then do:
      514           return error MsgLog + chr(10) + return-value.
      515         end.
      516   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      517                          input 'dids':U ,
      518                          input entry(2,tt-wb-header.uniq-key-rec,chr(6)) ) no-error .
      519         if error-status:error
      520         then do:
      521           return error MsgLog + chr(10) + return-value.
      522         end.
      523       end.
      524       otherwise do:
      525         run utl/ora-i516.p (
      526           input this-procedure ,
      527           input this-procedure ,
      528           input table temp_trn-doc ,
      529           input table temp_doc-line ,
      530           output num-rec-ok
      531           ) no-error .
      532         if error-status:error
      533         then do:
      534           return error MsgLog + chr(10) + return-value.
      535         end.
      536       end.
      537     end case.
      538   end.
      539   procedure pcall-log-file:
      540     define input parameter msg as character no-undo.
      541     if msg begins "n-d" then do:
      542       p-doc-code = entry (2, msg, "=").
      543     end.
      544     else do:
      545     assign
      546       MsgLog = msg + chr(10)
      547       .
      548     end.
      549   end.
      550   procedure get-db-num:
      551     define output parameter pDbNum as integer no-undo.
      552     pDbNum = iDbNum.
      553   end.
      554   procedure get-userid:
      555     define output parameter pUserId as character no-undo.
      556     assign
      557       pUserId = userId_ + ",egais"
      558       .
      559   end.
      560   procedure mainmenu_getcntxt :
      561   define output parameter p-cntxt-db-num                as integer   no-undo .
      562   define output parameter p-cntxt-userid                as character no-undo .
      563   define output parameter p-cntxt-level                 as character no-undo .
      564   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
      565   define output parameter p-cntxt-obj-type              as character no-undo .
      566   define output parameter p-cntxt-obj-code              as integer   no-undo .
      567   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
      568   define output parameter p-cntxt-is-admin              as logical   no-undo .
      569     do
      570     on error undo, return error return-value
      571     :
      572     define variable vt-host-code as integer   no-undo .
      573     find first temp_trn-doc no-error.
      574   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      576     (input  temp_trn-doc.obj-type
      577     ,input  temp_trn-doc.obj-code
      578     ,output p-cntxt-db-num-obj
      579     )  .
      580   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      582     (input  temp_trn-doc.obj-type
      583     ,input  temp_trn-doc.obj-code
      584     ,output vt-host-code
      585     )  .
      586     assign
      587       p-cntxt-db-num          =  p-cntxt-db-num-obj
      588       p-cntxt-userid          =  userId_
      589       p-cntxt-level           =  v-cntxt-level
      590       p-cntxt-host-code-obj   =  vt-host-code
      591       p-cntxt-obj-type        =  temp_trn-doc.obj-type
      592       p-cntxt-obj-code        =  temp_trn-doc.obj-code
      593       p-cntxt-is-admin        =  v-cntxt-is-admin
      594     .
      595     end.
      596   end procedure.
      597   procedure set-refAB:
      598     find first ub.trn-doc where ub.trn-doc.doc-code = p-doc-code no-lock.
      599       foreach_:
      600       for each ub.parts exclusive-lock
      601         where
      602               ub.parts.out-code  = p-doc-code
      603           and ub.parts.obj-code  = ub.trn-doc.obj-code
      604           and ub.parts.obj-type  = ub.trn-doc.obj-type
      605           by ub.parts.artic by ub.parts.prod-type by ub.parts.prod-code by ub.parts.qnty
      606         :
      607         find first buf_goods where buf_goods.artic = ub.parts.artic and buf_goods.prod-type = ub.parts.prod-type and buf_goods.prod-code = ub.parts.prod-code no-error.
      608         if not available (buf_goods)
      609           then return error error-status:get-message (1).
      610         find next tt-wb-gds-EG where tt-wb-gds-EG.gds-code = buf_goods.gds-code and tt-wb-gds-EG.qnty =  ub.parts.qnty use-index qntyIndex no-lock no-error.
      611         if not available (tt-wb-gds-EG) then do:
      612           find first tt-wb-gds-EG where  tt-wb-gds-EG.gds-code = buf_goods.gds-code and tt-wb-gds-EG.qnty =  ub.parts.qnty use-index qntyIndex no-lock no-error.
      613           if not available (tt-wb-gds-EG)
      614             then find first tt-wb-gds-EG where  tt-wb-gds-EG.gds-code = buf_goods.gds-code use-index qntyIndex no-lock no-error.
      615           if not available (tt-wb-gds-EG)
      616             then next foreach_.
      617         end.
      618         run trg/partps.p ( input buf_goods.gds-code
      619                          , input ub.parts.in-code
      620                          , ?
      621                          , input ub.parts.part-code
      622                          , input ub.parts.mark-db-num
      623                          , input ub.parts.mark-code
      624                          , input ub.parts.alc-bottling-date
      625                          , input tt-wb-gds-EG.refA + ',' + tt-wb-gds-EG.refB + ',' + tt-wb-gds-EG.alc-code + ',' + tt-wb-gds-EG.alc-type-code
      626                          , input ub.parts.alc-quality-certif-path
      627                          , input ub.parts.alc-certif-path
      628                          , if tt-wb-gds-EG.importer-th <> "" then substring (tt-wb-gds-EG.importer-th, 1, 3) else ""
      629                          , if tt-wb-gds-EG.importer-th <> "" then substring (tt-wb-gds-EG.importer-th, 4) else ""
      630                          ) no-error .
      631         if error-status :error
      632         then do:
      633           undo, return error "Ошибка при вызове процедуры partps.p" +
      634                               chr(10) +
      635                               error-status :get-message(1) +
      636                               chr(10) + return-value + chr(10).
      637         end.
      638       end.
      639   end procedure.
