        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.execlimpexp inherits objth:
        6      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7      define override public property vss-author      as character no-undo init "$Author:$":U get.
        8      define override public property vss-date        as character no-undo init "$Date:$":U get.
        9      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11      define override public property  vss-description as character no-undo init "Класс импорта экспорта Эксель" get.
       12      define property PublisHandle as handle no-undo
       13      get.
       14      set.
       15      constructor public execlimpexp (  ):
       16         super ().
       17      end constructor.
       18      constructor public execlimpexp ( iPublisHandle as handle  ):
       19         super ().
       20         PublisHandle = iPublisHandle.
       21      end constructor.
       22      define stream OutStr-html.
       23      method public  char expToExcel(htt as  handle):
       24         define variable vFile  as character no-undo.
       25         vfile = htt:name + ".html".
       26         expToExcel(htt,vFile).
       27         return vfile.
       28      end.
       29      method public  void expToExcel(ihandle as  handle, ifile as char):
       30         define variable vItm as integer  no-undo.
       31         define variable vhBuffer as handle no-undo.
       32         define variable vhQry as handle no-undo.
       33         define variable vhField as handle no-undo.
       34         if ihandle:type eq "temp-table"
       35         then
       36            vhBuffer = ihandle:default-buffer-handle.
       37         else if ihandle:type eq "buffer"
       38         then
       39            vhBuffer = ihandle.
       40         else if ihandle:type eq "query"
       41         then do:
       42            vhBuffer = ihandle:get-buffer-handle(ihandle:num-buffers).
       43            vHQry = ihandle.
       44         end.
       45         else do:
       46            putmes("Недопустимый тип handle возможные хандлы temp-table или buffer или query").
       47            return.
       48         end.
       49         if vhBuffer eq ?
       50         then do:
       51            putmes("Не удалось определить буфер для работы").
       52            return.
       53         end.
       54         output stream OutStr-html to value(ifile) convert target 'UTF-8' .
       55         put stream OutStr-html unformatted
       56   "<!DOCTYPE HTML>" skip
       57   ' <html>' skip
       58   '  <head>' skip
       59   '   <meta charset="utf-8">' skip
       60   '    <style type="text/css">' skip
       61   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
       62   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
       63   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
       64   '   </style>' skip
       65   '  </head>' skip
       66            '<body>' skip
       67            '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
       68            '<thead>' skip
       69            ' <tr class="set_columns">' skip.
       70         do vItm = 1 to vhBuffer:num-fields:
       71            vhField = vhBuffer:buffer-field(vItm).
       72            if vhField:name ne "NumLine_"
       73            then
       74               put stream OutStr-html unformatted
       75               ' <td style="width:' + formatToPx(vhField:format, length (getFieldName(vhField))) + 'px"></td>' skip.
       76         end.
       77         put stream OutStr-html unformatted
       78            '</tr>' skip
       79            '</thead>' skip
       80            '<tr>' skip.
       81         do vItm = 1 to vhBuffer:num-fields:
       82            vhField = vhBuffer:buffer-field(vItm).
       83            if vhField:name ne "NumLine_"
       84            then
       85               put stream OutStr-html unformatted
       86                 '<td text_wrap="true" style=" text-align: center; border: 1px solid black;">' + getFieldName(vhField) + '</td>' skip.
       87         end.
       88         put stream OutStr-html unformatted
       89            '</tr>'   skip
       90            '<tbody>' skip
       91         .
       92         if not valid-handle (vHQry)
       93         then do:
       94            create query  vHQry.
       95            vhQry:set-buffers (vhBuffer).
       96            vHQry:query-prepare ("FOR EACH " + vhBuffer:name + "  NO-LOCK").
       97         end.
       98         vHQry:query-open ().
       99         repeat:
      100            vHQry:get-next ().
      101            if vHQry:query-off-end
      102            then leave .
      103            put stream OutStr-html unformatted
      104               '<tr>' skip.
      105            do vItm = 1 to vhBuffer:num-fields:
      106               vhField = vhBuffer:buffer-field(vItm).
      107               if vhField:name ne "NumLine_"
      108               then
      109                  put stream OutStr-html unformatted
      110                     '<td text_wrap="true">' vhField:buffer-value '</td>' skip.
      111            end.
      112            put stream OutStr-html unformatted
      113               '</tr>' skip.
      114         end.
      115         vhQry:query-close ().
      116         put stream OutStr-html unformatted
      117            '<tbody>' skip
      118            '</table>'
      119         .
      120         output stream OutStr-html close.
      121         delete object vhQry.
      122         ObjSrv:Lib:prnLib:prn-lib-reportviewer(ifile, "GUI:FALSE").
      123      end.
      124      method public handle impExcel(ifile   as character,
      125                                    iNumCol as integer  ):
      126         define variable tth as handle no-undo.
      127         define variable vi as integer no-undo.
      128         create temp-table tth.
      129         do vi = 1 to iNumCol:
      130            tth:add-new-field ("Col_" + string(vi), "char").
      131         end.
      132         tth:add-new-field ("NumLine_", "char").
      133         tth:add-new-index("NumLine_", false, true).
      134         tth:add-index-field("NumLine_", "NumLine_").
      135         tth:temp-table-prepare ("tt-col-" + string(iNumCol)).
      136         impExcel(ifile,tth).
      137         return tth.
      138      end.
      139      method public void impExcel (iFile     as character,
      140                                   ihandle   as  handle):
      141         define variable vItm     as integer  no-undo.
      142         define variable vhBuffer as handle   no-undo.
      143         define variable mExcelApplication as component-handle no-undo.
      144         define variable mWorkBook         as component-handle no-undo.
      145         define variable mWorkSheet        as component-handle no-undo.
      146         define variable vhField      as handle no-undo.
      147         define variable vValue       as character no-undo.
      148         define variable vChLine      as integer   no-undo.
      149         define variable vCorectItem  as integer   no-undo.
      150         define variable vCorectLine  as integer   no-undo.
      151         define variable vAvailLine   as logical   no-undo.
      152         define variable vNextLine    as logical   no-undo.
      153         if ihandle:type eq "temp-table"
      154         then
      155            vhBuffer = ihandle:default-buffer-handle.
      156         else if ihandle:type eq "buffer"
      157         then
      158            vhBuffer = ihandle.
      159         else do:
      160            putmes("Недопустимый тип handle возможные хандлы temp-table or buffer").
      161            return.
      162         end.
      163         create "Excel.Application":U mExcelApplication no-error.
      164         if error-status :error then do:
      165            putmes(substitute ("Ошибка при запуске Excel: &1",error-status :get-message(1))).
      166            return.
      167         end.
      168         assign
      169            mExcelApplication:DisplayAlerts = no
      170            mWorkbook                       = mExcelApplication:WorkBooks:Add(iFile)
      171            mWorkSheet                      = mWorkbook:Sheets:Item(1)
      172         .
      173         Block-Line:
      174         do on error   undo Block-Line, leave Block-Line
      175            on end-key undo Block-Line, leave Block-Line
      176         while true:
      177            vChLine = vChLine + 1.
      178            vhBuffer:buffer-create ().
      179            assign
      180               vCorectItem = 0
      181               vAvailLine  = no
      182               vNextLine   = no
      183            .
      184            do vItm = 1 to vhBuffer:num-fields:
      185               vhField = vhBuffer:buffer-field(vItm).
      186               if vhField:name ne "NumLine_"
      187               then do:
      188                  vValue = ?.
      189                  vValue = mWorkSheet:Range(f-range(vItm - vCorectItem) + string(vChLine)):VALUE no-error.
      190                  if vValue = ? then vValue = mWorkSheet:Range(f-range(vItm - vCorectItem) + string(vChLine)):FORMULA no-error.
      191                  if     vValue ne ""
      192                     and vValue ne ?
      193                  then do:
      194                     if vValue = getFieldName(vhField)
      195                     then do:
      196                        vNextLine = yes.
      197                        vhField:buffer-value = vValue no-error.
      198                     end.
      199                     else do:
      200                        vAvailLine           = yes.
      201                        vhField:buffer-value = vValue no-error.
      202                        if error-status:error
      203                        then
      204                           putmes(substitute ("В ячейке &1 не удается преобразовать &2 в &3: &4",f-range(vItm - vCorectItem) + string(vChLine),vValue,vhField:data-type, error-status:get-message (1))).
      205                     end.
      206                  end.
      207               end.
      208               else do:
      209                  vCorectItem = vCorectItem  + 1.
      210                  vhField:buffer-value = vChLine + vCorectLine.
      211               end.
      212            end.
      213            if vNextLine and not vAvailLine
      214            then do:
      215               vhBuffer:buffer-delete ().
      216               vCorectLine = vCorectLine - 1.
      217            end.
      218            else if not vAvailLine
      219            then do:
      220               vhBuffer:buffer-delete ().
      221               vChLine = vChLine - 1.
      222               leave.
      223            end.
      224            else do:
      225               define variable vDelLine as logical no-undo.
      226               if valid-handle (PublisHandle)
      227               then do:
      228                  publish "WorkLineExel" from PublisHandle (vhBuffer,output vDelLine).
      229                  if vDelLine
      230                  then
      231                     vhBuffer:buffer-delete ().
      232               end.
      233            end.
      234         end.
      235         release object mWorkSheet no-error.
      236         release object mWorkbook no-error.
      237         mExcelApplication :QUIT().
      238         release object mExcelApplication.
      239      end method.
      240      method public character  formatToPx(iformat as character, imin as int):
      241         define variable vColChar as integer no-undo.
      242         if iformat begins "x("
      243         then
      244            vColChar = integer (substring (iformat,3,length (iformat) - 3)).
      245         else
      246            vColChar = length (iformat).
      247         vColChar = max(vColChar,imin).
      248         return string (11 * vColChar).
      249      end method.
      250      method public character  getFieldName(ifield as handle ):
      251         return if     ifield:label ne ""
      252                   and ifield:label ne ?
      253                then ifield:label
      254                else if     ifield:column-label ne ""
      255                        and ifield:column-label ne ?
      256                then ifield:column-label
      257                else ifield:name.
      258      end method.
      259      method public character f-range (input p-num as integer) :
      260         case p-num :
      261            when 1 then return "A":U .
      262            when 2 then return "B":U .
      263            when 3 then return "C":U .
      264            when 4 then return "D":U .
      265            when 5 then return "E":U .
      266            when 6 then return "F":U .
      267            when 7 then return "G":U .
      268            when 8 then return "H":U .
      269            when 9 then return "I":U .
      270            when 10 then return "J":U .
      271            when 11 then return "K":U .
      272            when 12 then return "L":U .
      273            when 13 then return "M":U .
      274            when 14 then return "N":U .
      275            when 15 then return "O":U .
      276            when 16 then return "P":U .
      277            when 17 then return "Q":U .
      278            when 18 then return "R":U .
      279            when 19 then return "S":U .
      280            when 20 then return "T":U .
      281         end case .
      282      end method.
      283      method public void putmes (input itext as char):
      284         if valid-handle (PublisHandle)
      285         then
      286            publish "WriteLogExel" from PublisHandle (itext).
      287      end.
      288      destructor public execlimpexp ( ):
      289      end destructor.
      290   end class.
