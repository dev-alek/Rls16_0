        1   using Progress.Lang.*.
        2   using ibs.th.bge.mercury.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.mercury.ParserXMLUnits:
        5     define temp-table tt-units-merc
        6       field guid_ as character format "X(40)"
        7       field uuid_ as character format "X(40)"
        8       field name1 as character format "X(5)"
        9       field name2 as character format "X(20)"
       10       index pi as primary unique
       11         guid_
       12     .
       13     define variable v-item      as character no-undo .
       14     define variable v-mess      as character no-undo .
       15     DEFINE VARIABLE hDoc        AS HANDLE    NO-UNDO.
       16     DEFINE VARIABLE hRoot       AS HANDLE    NO-UNDO.
       17     DEFINE VARIABLE good        AS LOGICAL   NO-UNDO.
       18     define variable v-save-info as character no-undo .
       19     define variable v-imp       as logical .
       20     method public void ParseResponse(inFileName as char, INPUT-OUTPUT Table tt-units-merc, output Msg as character):
       21       empty temp-table tt-units-merc .
       22       CREATE X-DOCUMENT hDoc.
       23       CREATE X-NODEREF hRoot.
       24       hDoc:LOAD("file",inFileName,FALSE) no-error.
       25       if inFileName = ? then
       26       do:
       27         Msg = "Файл " + inFileName + " не найден" .
       28         return .
       29       end.
       30       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       31       GetChildren(hRoot, 1, output Msg).
       32       DELETE OBJECT hDoc.
       33       DELETE OBJECT hRoot.
       34     end.
       35     method private void GetChildren(hParent AS HANDLE, level AS INTEGER, output Msg as character):
       36       DEFINE VARIABLE i        AS INTEGER NO-UNDO.
       37       DEFINE VARIABLE hNoderef AS HANDLE  NO-UNDO.
       38       DEFINE VARIABLE hText    AS HANDLE  NO-UNDO.
       39       DEFINE VARIABLE tt       as integer NO-UNDO .
       40       tt = hParent:NUM-CHILDREN no-error .
       41       if tt = ? then
       42       do:
       43         Msg = "Ошибка запроса. См. в файле ответа" .
       44         return.
       45       end.
       46       CREATE X-NODEREF hNoderef.
       47       CREATE X-NODEREF hText .
       48       REPEAT i = 1 TO hParent:NUM-CHILDREN:
       49         good = hParent:GET-CHILD(hNoderef,i).
       50         IF NOT good THEN
       51           LEAVE.
       52         IF hNoderef:SUBTYPE <> "element" THEN
       53           NEXT.
       54         hNoderef:GET-CHILD(hText, 1) no-error .
       55         IF hNoderef:NAME = "dt:unit" THEN
       56         DO:
       57           create tt-units-merc .
       58         END.
       59         IF hNoderef:NAME = "bs:uuid" THEN
       60         DO:
       61           tt-units-merc.uuid_ = hText:node-value .
       62         END.
       63         IF hNoderef:NAME = "bs:guid" THEN
       64         DO:
       65           tt-units-merc.guid_ = hText:node-value .
       66         END.
       67         IF hNoderef:NAME = "dt:name" THEN
       68         DO:
       69           tt-units-merc.name1 = hText:node-value .
       70         END.
       71         IF hNoderef:NAME = "dt:fullName" THEN
       72         DO:
       73           tt-units-merc.name2 = hText:node-value .
       74         END.
       75         GetChildren(hNoderef, (level + 1),msg).
       76       END.
       77       DELETE OBJECT hNoderef.
       78       DELETE OBJECT hText.
       79     END.
       80   end class.
