        1   using ibs.th.str.gds.*.
        2   using ibs.th.str.mercury.*.
        3   using ibs.th.gbl.storage.*.
        4   using ibs.th.str.clients.*.
        5   block-level on error undo, throw.
        6   define input parameter p-vsdId as int64 no-undo .
        7   define variable v-appId as character no-undo .
        8   define variable v-status as character no-undo .
        9   define variable v-mess as character no-undo .
       10   define variable v-issuerId as character no-undo .
       11   define variable v-errcode as character no-undo .
       12   define variable v-parsesub as character no-undo .
       13   define variable v-parsesub2 as character no-undo .
       14   define variable vsdStorage as class vsdtostorage no-undo .
       15   define variable vsdsTHObj as class vsdsubs no-undo .
       16   define variable temp-vsdsTHObj as class vsdsubs no-undo .
       17   define variable vsdTHObj as class vsdsub no-undo .
       18   define variable vsdStsType as class vsdstatustype no-undo .
       19   define variable v-statusVSD as character no-undo .
       20   define variable v-statusVSD2 as character no-undo .
       21   define variable v-typeVSD as character no-undo .
       22   define variable v-dateCr as character no-undo .
       23   define variable v-year as character no-undo .
       24   define variable v-month as character no-undo .
       25   define variable v-day as character no-undo .
       26   define variable v-hour as character no-undo .
       27   define variable v-ignorSect as logical no-undo initial no .
       28   define variable v-empty-answer as logical no-undo initial yes .
       29   define buffer buf_vsd for ub.vsd .
       30   procedure getData:
       31     define output parameter p-appId as character no-undo .
       32     define output parameter p-status as character no-undo .
       33     define output parameter p-mess as character no-undo .
       34     assign
       35       p-appId = v-appId
       36       p-status = v-status
       37       p-mess = v-mess
       38     .
       39   end procedure.
       40   procedure getVsds:
       41     define output parameter p-appId as character no-undo .
       42     define output parameter p-status as character no-undo .
       43     define output parameter p-mess as character no-undo .
       44     define output parameter p-Vsds as class vsdsubs no-undo .
       45     assign
       46       p-appId = v-appId
       47       p-status = v-status
       48       p-mess = v-mess
       49     .
       50     p-Vsds = vsdsTHObj .
       51     if v-errcode = "MERC14561"
       52     or v-errcode = "MERC14562"
       53     or v-errcode = "MERC14563"
       54     or v-errcode = "MERC14258"
       55     or v-errcode = "MERC14537"
       56     then p-mess = v-errcode .
       57   end procedure.
       58   DEFINE VARIABLE gcCurrentElement AS CHARACTER NO-UNDO.
       59   procedure StartElement:
       60   DEFINE INPUT PARAMETER namespaceURI AS CHARACTER NO-UNDO.
       61   DEFINE INPUT PARAMETER localName    AS CHARACTER NO-UNDO.
       62   DEFINE INPUT PARAMETER qname        AS CHARACTER NO-UNDO.
       63   DEFINE INPUT PARAMETER hAttributes  AS HANDLE NO-UNDO.
       64     gcCurrentElement = qname .
       65     case qname :
       66       when "merc:stockEntry" then v-ignorSect = yes .
       67       when "message" then v-mess = "" .
       68       when "apl:error" then v-errcode = hAttributes:get-value-by-qname("code") no-error .
       69       when "applicationId" then v-appId = "" .
       70       when "status" then v-status = "" .
       71       when "issuerId" THEN v-issuerId = "" .
       72       when "vd:vetDocument" or
       73       when "merc:vetDocument"
       74       then do :
       75         if v-ignorSect then return .
       76         v-empty-answer = no .
       77         if not valid-object(vsdsTHObj)
       78         then vsdsTHObj = new vsdsubs ().
       79         if not valid-object(vsdStorage)
       80         then vsdStorage = new vsdtostorage ().
       81         if not valid-object(vsdStsType)
       82         then vsdStsType = new vsdstatustype ().
       83         v-parsesub = "vetDocument" .
       84       end.
       85       when "merc:getVetDocumentByUuidRequest" then v-empty-answer = no .
       86       when "errors" then v-empty-answer = no .
       87       when "apl:errors" then v-empty-answer = no .
       88       when "ws:receiveApplicationResultRequest" then v-empty-answer = no .
       89       when "receiveApplicationResultRequest" then v-empty-answer = no .
       90       when "ws:submitApplicationResponse" then v-empty-answer = no .
       91       when "bs:uuid"
       92       then do :
       93         case v-parsesub :
       94           otherwise do :
       95           end.
       96         end case.
       97       end.
       98       when "vd:productItem" then v-parsesub = "productItem" .
       99       when "vd:product" then v-parsesub = "product" .
      100       when "vd:subProduct" then v-parsesub = "subProduct" .
      101       when "vd:unit" then v-parsesub = "unit" .
      102       when "vd:country" then v-parsesub = "country" .
      103       when "dt:businessEntity" then v-parsesub = "businessEntity" .
      104       when "dt:enterprise" then v-parsesub = "enterprise" .
      105       when "vd:purpose" then v-parsesub = "purpose" .
      106       when "vd:broker" then v-parsesub = "broker" .
      107       when "dt:packingType" then v-parsesub = "packingType" .
      108       when "vd:laboratoryResearch" then v-parsesub = "laboratoryResearch" .
      109       when "vd:dateOfProduction" then v-parsesub2 = "dateOfProduction" .
      110       when "vd:expiryDate" then v-parsesub2 = "expiryDate" .
      111       when "vd:consignor" then v-parsesub2 = "consignor" .
      112       when "vd:consignee" then v-parsesub2 = "consignee" .
      113       when "vd:producer" then v-parsesub2 = "producer" .
      114       when "vd:referencedDocument" then v-parsesub2 = "referencedDocument" .
      115       when "vd:authentication" then v-parsesub2 = "authentication" .
      116       when "vd:origin" then v-parsesub2 = "origin" .
      117       when "vd:firstDate"
      118       then do :
      119         v-parsesub = "firstDate" .
      120         v-year = "" .
      121         v-month = "" .
      122         v-day = "" .
      123         v-hour = "" .
      124       end.
      125     end case.
      126   end procedure.
      127   PROCEDURE Characters:
      128     DEFINE INPUT PARAMETER ppText AS MEMPTR NO-UNDO.
      129     DEFINE INPUT PARAMETER piNumChars AS INTEGER NO-UNDO.
      130     define variable v-str as character no-undo .
      131     if v-ignorSect then return .
      132     v-str = GET-STRING(ppText,1) .
      133     if v-str begins chr(10) then return .
      134     if v-parsesub = "laboratoryResearch" then return .
      135     case gcCurrentElement :
      136       when "message" or
      137       when "apl:error"
      138       then do :
      139         v-mess = v-mess + chr(10) + v-str .
      140         v-mess = left-trim(v-mess, chr(10)) .
      141       end.
      142       when "applicationId" THEN v-appId = v-str .
      143       when "status" THEN v-status = v-str .
      144       when "issuerId" THEN v-issuerId = v-str .
      145       when "bs:uuid"
      146       then do :
      147         case v-parsesub :
      148           when "vetDocument"
      149           then do :
      150             find first buf_vsd no-lock where buf_vsd.UUID = v-str and buf_vsd.ID = p-vsdId no-error.
      151             if not available buf_vsd
      152             then do :
      153               vsdTHObj = new vsdsub ().
      154               vsdsTHObj:AddItem(vsdTHObj) .
      155               vsdsTHObj:VsdObjCurr:UUID = caps(v-str) .
      156               vsdsTHObj:VsdObjCurr:EconomicSub = v-issuerId .
      157               vsdsTHObj:VsdObjCurr:FactDatetime = now .
      158             end.
      159             else do :
      160               temp-vsdsTHObj = new vsdsubs ().
      161               temp-vsdsTHObj = vsdStorage:getVSDsubs(buffer buf_vsd) .
      162               vsdsTHObj:AddItem(temp-vsdsTHObj:VsdObjCurr) .
      163               vsdsTHObj:VsdObjCurr:EconomicSub = v-issuerId .
      164               vsdsTHObj:VsdObjCurr:TTNissueDate = "" .
      165               vsdsTHObj:VsdObjCurr:TTNissueNumber = "" .
      166               vsdsTHObj:VsdObjCurr:TTNissueSeries= "" .
      167               vsdsTHObj:VsdObjCurr:TTNrelationshipType = "" .
      168               vsdsTHObj:VsdObjCurr:TTNtype = "" .
      169               vsdsTHObj:VsdObjCurr:PackageGuid = "" .
      170               vsdsTHObj:VsdObjCurr:PackageLevel = "" .
      171               vsdsTHObj:VsdObjCurr:PackageQnty = "" .
      172               vsdsTHObj:VsdObjCurr:NumPart = "" .
      173             end .
      174           end.
      175         end case.
      176       end.
      177       when "vd:vetDType"
      178       then do :
      179         v-typeVSD = v-str .
      180         case v-typeVSD :
      181           when "INCOMING" then vsdsTHObj:VsdObjCurr:VSDType = 1 .
      182           when "OUTGOING" then vsdsTHObj:VsdObjCurr:VSDType = 2 .
      183           when "PRODUCTIVE" then vsdsTHObj:VsdObjCurr:VSDType = 3 .
      184           when "RETURNABLE" then vsdsTHObj:VsdObjCurr:VSDType = 4 .
      185           when "TRANSPORT" then vsdsTHObj:VsdObjCurr:VSDType = 5 .
      186         end case .
      187       end.
      188       when "vd:vetDStatus"
      189       then do :
      190         v-statusVSD = v-str .
      191       end.
      192       when "vd:status"
      193       then do :
      194         v-statusVSD2 = v-str .
      195       end.
      196       when "bs:guid"
      197       then do :
      198         case v-parsesub :
      199           when "businessEntity"
      200           then do :
      201             case v-parsesub2 :
      202               when "consignor" then vsdsTHObj:VsdObjCurr:CliBeGuid = v-str .
      203               when "consignee" then vsdsTHObj:VsdObjCurr:ObjBeGuid = v-str .
      204             end case.
      205           end.
      206           when "enterprise"
      207           then do :
      208             case v-parsesub2 :
      209               when "consignor" then vsdsTHObj:VsdObjCurr:CliEntGuid = v-str .
      210               when "consignee" then vsdsTHObj:VsdObjCurr:ObjEntGuid = v-str .
      211               when "producer" then vsdsTHObj:VsdObjCurr:ProducerGuid = v-str .
      212             end case.
      213           end.
      214           when "productItem"
      215           then do :
      216             if v-parsesub2 <> "origin"
      217             then
      218               vsdsTHObj:VsdObjCurr:GdsGuid = v-str .
      219           end.
      220           when "product"
      221           then do :
      222             vsdsTHObj:VsdObjCurr:ProductGuid = v-str .
      223           end.
      224           when "subProduct"
      225           then do :
      226             vsdsTHObj:VsdObjCurr:SubProductGuid = v-str .
      227           end.
      228           when "unit" then vsdsTHObj:VsdObjCurr:UnitGuid = v-str .
      229           when "country" then vsdsTHObj:VsdObjCurr:OrigCountryGuid = v-str .
      230           when "purpose" then vsdsTHObj:VsdObjCurr:PurposeGuid = v-str .
      231           when "broker" then vsdsTHObj:VsdObjCurr:BrokerGuid = v-str .
      232           when "packingType" then vsdsTHObj:VsdObjCurr:PackageGuid = vsdsTHObj:VsdObjCurr:PackageGuid + chr(4) + v-str .
      233         end case.
      234       end.
      235       when "dt:name"
      236       then do :
      237         case v-parsesub :
      238           when "productItem"
      239           then do :
      240             vsdsTHObj:VsdObjCurr:GdsName = v-str .
      241           end.
      242         end case.
      243       end.
      244       when "vd:issueDate"
      245       then do :
      246         v-dateCr = v-str .
      247         case v-parsesub2 :
      248           when "referencedDocument"
      249           then do :
      250             vsdsTHObj:VsdObjCurr:TTNissueDate = vsdsTHObj:VsdObjCurr:TTNissueDate + chr(4) + v-str .
      251           end.
      252           when "authentication" then do : end .
      253           otherwise do :
      254             vsdsTHObj:VsdObjCurr:DateCr = date(integer(substring(v-dateCr, 6,2)), integer(substring(v-dateCr, 9,2)), integer(substring(v-dateCr, 1,4))) .
      255           end .
      256         end case .
      257       end.
      258       when "vd:perishable" then vsdsTHObj:VsdObjCurr:Perishable = v-str .
      259       when "vd:vehicleNumber" or
      260       when "vd:wagonNumber" or
      261       when "vd:shipName" or
      262       when "vd:flightNumber"
      263       then vsdsTHObj:VsdObjCurr:CarNum = v-str.
      264       when "vd:containerNumber" then vsdsTHObj:VsdObjCurr:ContainerNum = v-str .
      265       when "vd:trailerNumber" then vsdsTHObj:VsdObjCurr:TrailerNum = v-str .
      266       when "vd:transportStorageType" then vsdsTHObj:VsdObjCurr:TransportType = v-str .
      267       when "vd:transportType" then vsdsTHObj:VsdObjCurr:Transport = v-str .
      268       when "vd:volume" then vsdsTHObj:VsdObjCurr:Qnty = decimal(v-str) .
      269       when "vd:batchId" then vsdsTHObj:VsdObjCurr:NumPart = vsdsTHObj:VsdObjCurr:NumPart + chr(4) + v-str .
      270       when "vd:productType" then vsdsTHObj:VsdObjCurr:TypeProd = v-str .
      271       when "dt:year" then v-year = v-str .
      272       when "dt:month" then v-month = v-str .
      273       when "dt:day" then v-day = v-str no-error.
      274       when "dt:hour" then v-hour = v-str no-error.
      275       when "dt:quantity" then vsdsTHObj:VsdObjCurr:PackageQnty = vsdsTHObj:VsdObjCurr:PackageQnty + chr(4) + v-str .
      276       when "dt:level" then vsdsTHObj:VsdObjCurr:PackageLevel = vsdsTHObj:VsdObjCurr:PackageLevel + chr(4) + v-str .
      277       when "dt:role"
      278       then do :
      279         case v-parsesub2 :
      280           when "producer" then vsdsTHObj:VsdObjCurr:ProducerRole = v-str .
      281           otherwise do :
      282           end .
      283         end case .
      284       end.
      285       when "vd:issueNumber"
      286       then do :
      287         case v-parsesub2 :
      288           when "referencedDocument"
      289           then do :
      290             vsdsTHObj:VsdObjCurr:TTNissueNumber = vsdsTHObj:VsdObjCurr:TTNissueNumber + chr(4) + v-str .
      291           end.
      292           otherwise do :
      293           end .
      294         end case .
      295       end.
      296       when "vd:issueSeries"
      297       then do :
      298         case v-parsesub2 :
      299           when "referencedDocument"
      300           then do :
      301             vsdsTHObj:VsdObjCurr:TTNissueSeries = vsdsTHObj:VsdObjCurr:TTNissueSeries + chr(4) + v-str .
      302           end.
      303           otherwise do :
      304           end .
      305         end case .
      306       end.
      307       when "vd:type"
      308       then do :
      309         case v-parsesub2 :
      310           when "referencedDocument"
      311           then do :
      312             vsdsTHObj:VsdObjCurr:TTNtype = vsdsTHObj:VsdObjCurr:TTNtype + chr(4) + v-str .
      313           end.
      314           otherwise do :
      315           end .
      316         end case .
      317       end.
      318       when "vd:relationshipType"
      319       then do :
      320         case v-parsesub2 :
      321           when "referencedDocument"
      322           then do :
      323             vsdsTHObj:VsdObjCurr:TTNrelationshipType = vsdsTHObj:VsdObjCurr:TTNrelationshipType + chr(4) + v-str .
      324           end.
      325           otherwise do :
      326           end .
      327         end case .
      328       end.
      329       when "vd:cargoInspected"
      330       then do :
      331         case v-parsesub2 :
      332           when "authentication" then vsdsTHObj:VsdObjCurr:CargoInspected = v-str .
      333           otherwise do :
      334           end .
      335         end case .
      336       end.
      337       when "vd:cargoExpertized"
      338       then do :
      339         case v-parsesub2 :
      340           when "authentication" then vsdsTHObj:VsdObjCurr:CargoExpertized = v-str .
      341           otherwise do :
      342           end .
      343         end case .
      344       end.
      345       when "vd:locationProsperity"
      346       then do :
      347         case v-parsesub2 :
      348           when "authentication" then vsdsTHObj:VsdObjCurr:LocationProsperity = v-str .
      349           otherwise do :
      350           end .
      351         end case .
      352       end.
      353     end case .
      354   end procedure .
      355   PROCEDURE EndElement:
      356     DEFINE INPUT PARAMETER pcNamespaceURI AS CHARACTER NO-UNDO.
      357     DEFINE INPUT PARAMETER pcLocalName AS CHARACTER NO-UNDO.
      358     DEFINE INPUT PARAMETER pcElementName AS CHARACTER NO-UNDO.
      359     case pcElementName :
      360       when "merc:stockEntry" then v-ignorSect = no .
      361       when "vd:firstDate"
      362       then do :
      363         if v-ignorSect then return .
      364         case v-parsesub2 :
      365           when "dateOfProduction" then vsdsTHObj:VsdObjCurr:DateOut = v-year + ":" + v-month + ":" + v-day + ":" + v-hour .
      366           when "expiryDate" then vsdsTHObj:VsdObjCurr:ExpiryDate = v-year + ":" + v-month + ":" + v-day + ":" + v-hour .
      367         end case.
      368       end.
      369       when "vd:secondDate"
      370       then do :
      371         if v-ignorSect then return .
      372         case v-parsesub2 :
      373           when "dateOfProduction" then vsdsTHObj:VsdObjCurr:ExpiryOutDate = v-year + ":" + v-month + ":" + v-day + ":" + v-hour .
      374           when "expiryDate" then vsdsTHObj:VsdObjCurr:ExpiryDate2 = v-year + ":" + v-month + ":" + v-day + ":" + v-hour .
      375         end case.
      376       end.
      377       when "application"
      378       then do :
      379       end.
      380       when "vd:productItem"
      381       then do :
      382       end.
      383       when "vd:vetDocument" or
      384       when "merc:vetDocument"
      385       then do :
      386         if v-ignorSect then return .
      387         if v-statusVSD2 = "CONFIRMED"
      388         then do :
      389           if v-statusVSD = "CONFIRMED" then vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsNeedUtilized .
      390           if v-statusVSD = "UTILIZED" then vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsUtilized .
      391         end.
      392         else
      393         if v-statusVSD2 = "UTILIZED"
      394         then do :
      395           if v-statusVSD = "UTILIZED" then vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsUtilized .
      396         end.
      397         else do :
      398           if v-statusVSD = "CONFIRMED" then vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      399           if v-statusVSD = "UTILIZED" then vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrUtilized .
      400           vsdsTHObj:VsdObjCurr:MsgErr = v-mess .
      401         end.
      402         v-parsesub = "" .
      403         delete object vsdStorage no-error .
      404         delete object vsdStsType no-error .
      405       end.
      406       when "vd:productItem" then v-parsesub = "" .
      407       when "vd:product" then v-parsesub = "" .
      408       when "vd:subProduct" then v-parsesub = "" .
      409       when "vd:unit" then v-parsesub = "" .
      410       when "vd:country" then v-parsesub = "" .
      411       when "dt:businessEntity" then v-parsesub = "" .
      412       when "dt:enterprise" then v-parsesub = "" .
      413       when "vd:purpose" then v-parsesub = "" .
      414       when "vd:broker" then v-parsesub = "" .
      415       when "dt:packingType" then v-parsesub = "" .
      416       when "vd:laboratoryResearch" then v-parsesub = "" .
      417       when "vd:dateOfProduction" then v-parsesub2 = "" .
      418       when "vd:expiryDate" then v-parsesub2 = "" .
      419       when "vd:consignor" then v-parsesub2 = "" .
      420       when "vd:consignee" then v-parsesub2 = "" .
      421       when "vd:producer" then v-parsesub2 = "" .
      422       when "vd:referencedDocument" then v-parsesub2 = "" .
      423       when "vd:authentication" then v-parsesub2 = "" .
      424       when "vd:origin" then v-parsesub2 = "" .
      425       when "vd:referencedDocument"
      426       then do :
      427         v-parsesub2 = "" .
      428         if valid-object(vsdsTHObj)
      429         and valid-object(vsdsTHObj:VsdObjCurr)
      430         then do :
      431           if num-entries(vsdsTHObj:VsdObjCurr:TTNissueSeries, chr(4)) < num-entries(vsdsTHObj:VsdObjCurr:TTNtype, chr(4))
      432           then do :
      433             vsdsTHObj:VsdObjCurr:TTNissueSeries = vsdsTHObj:VsdObjCurr:TTNissueSeries + chr(4) .
      434           end.
      435         end.
      436       end.
      437       when "vd:authentication" then v-parsesub2 = "" .
      438     end case.
      439   end procedure .
      440   procedure EndDocument:
      441     if v-empty-answer
      442     then do :
      443       v-status = "REJECTED" .
      444       v-mess = "Пустой ответ от Ветис.API..." .
      445     end.
      446   end procedure .
