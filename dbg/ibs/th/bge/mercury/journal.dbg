        1   using Progress.Lang.*.
        2   using ibs.th.bge.mercury.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.mercury.Journal :
        5     define public variable tth_journal-merc as handle no-undo.
        6     define public variable bh_journal-merc as handle no-undo.
        7     define buffer buf_esys-all-attr for ub.esys-all-attr.
        8     define variable        v-subject        as character no-undo.
        9     define variable        v-status         as character no-undo.
       10     define variable        v-db-num         as integer   no-undo.
       11     define variable        v-user           as character no-undo.
       12     define temp-table tt_journal-merc no-undo
       13       field jou-who     as character LABEL "Кто отправил"       format "X(30)"
       14       field jou-time    as datetime  LABEL "Во сколько"         FORMAT "99.99.99 HH:MM"
       15       field jou-subject as character LABEL "Какой запрос"       format "X(25)"
       16       field jou-status  as character LABEL "Состояние запроса"  format "X(20)"
       17       field jou-param   as character LABEL "UUID ВСД"           format "X(38)"
       18       field jou-code    as character LABEL "Код запроса"        format "X(38)"
       19       field piIndex     as character
       20       index tt_journal-egais is primary jou-code ascending.
       21     method public handle GetHndlTable(input date1 as datetime, input date2 as datetime):
       22     empty temp-table tt_journal-merc .
       23     for each buf_esys-all-attr where buf_esys-all-attr.table-name = "esys-pck-sent"
       24                                  and buf_esys-all-attr.attr-code  = "mercury"
       25                                  and datetime (buf_esys-all-attr.key4) >= date1
       26                                  and datetime (buf_esys-all-attr.key4) <= date2 no-lock:
       27       create tt_journal-merc.
       28       v-subject = "Some".
       29       if buf_esys-all-attr.key2 = 1 then do:
       30         v-subject = "Запрос ВСД по UUID".
       31       end.
       32       if buf_esys-all-attr.key2 = 2 then do:
       33         v-subject = "Запрос на гашение ВСД".
       34       end.
       35       if buf_esys-all-attr.key8 <> "" then do:
       36         find first ub.user-account where ub.user-account.user-id = buf_esys-all-attr.key8 no-error.
       37         v-user = ub.user-account.last-name + ' ' + ub.user-account.first-name + ' ' + ub.user-account.second-name .
       38       end.
       39       assign
       40         tt_journal-merc.jou-who = v-user
       41         tt_journal-merc.jou-code = buf_esys-all-attr.key7
       42         tt_journal-merc.jou-time = datetime (buf_esys-all-attr.key4)
       43         tt_journal-merc.jou-subject = v-subject
       44         tt_journal-merc.jou-status = buf_esys-all-attr.key3
       45         tt_journal-merc.jou-param = replace(buf_esys-all-attr.attr-value,chr(4),'|')
       46         tt_journal-merc.piIndex = table-name + string (key1) + string (key2) + string (key3) + string (key4) + string (key5) + string (key6) +
       47         string (key7) + string (key8) + attr-code.
       48       .
       49     end.
       50     return buffer tt_journal-merc:handle.
       51     end.
       52   end class.
