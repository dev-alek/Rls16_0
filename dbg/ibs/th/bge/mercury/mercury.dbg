      715       end.
      716       os-command silent value (cmd).
      717       ParseXML(input SearchFile(v-resp-file)) .
      718       p-applicationId = applicationId .
      719       p-Status_ = Status_ .
      720       p-Msg = Msg .
      721       pause 0.2 .
      722     end method.
      723     method public void receiveVetDoc
      724     (
      725      input inApplicationId as char,
      726      input inUUID as char,
      727      input p-qnty as decimal,
      728      input p-fact-qnty as decimal,
      729      input is-utilized as logical,
      730      output p-Status_ as char,
      731      output p-Msg  as char
      732     ) :
      733       define variable gdsMercsubsObj as class gdsmercsubs no-undo .
      734       define variable gdsMercsubObj as class gdsmercsub no-undo .
      735       define variable gdsMercstrObj as class gdsmercstr no-undo .
      736       define variable unitsMercObj as class unitsubs no-undo .
      737       define variable unitMercStr as class unitmercstr no-undo .
      738       define variable is-err as logical no-undo .
      739       define variable v-found-unit as logical no-undo .
      740       define variable v-found-cli as logical no-undo .
      741       define variable v-calc-qnty as decimal no-undo .
      742       define variable jj as integer no-undo .
      743       define variable v-resp-file as character no-undo .
      744       v-resp-file = "VetDocumentByUuidResponse_DB" + string(DbNum) + ".xml" .
      745       define buffer buf_ext-classif for ext-classif .
      746       define buffer buf_goods for ub.goods .
      747       define buffer buf_units-attr for ub.units-attr .
      748       define buffer bf_vsd for vsd .
      749       vsds = new vsdsubs() .
      750       vsdStorage = new vsdtostorage ().
      751       gdsMercsubsObj = new gdsmercsubs ().
      752       gdsMercsubObj = new gdsmercsub ().
      753       gdsMercstrObj = new gdsmercstr ().
      754       unitsMercObj = new unitsubs ().
      755       unitMercStr = new unitmercstr ().
      756       is-err = false .
      757       v-found-unit = false .
      758       receiveApplicationResult (v-resp-file, inApplicationId) .
      759       if Status_ = "COMPLETED"
      760       then
      761       do ii = 1 to vsds:GetItem (ii):
      762         vsds:VsdObjCurr:MsgErr = "" .
      763         if is-utilized then vsds:VsdObjCurr:Status_ = vsdStat:IsUtilized .
      764         gdsMercsubsObj = gdsMercstrObj:getgdsmercs(vsds:VsdObjCurr:GdsCode) .
      765         if valid-object(gdsMercsubsObj:GdsMercsubsCurr)
      766         and gdsMercsubsObj:GdsMercsubsCurr:GUID_ <> vsds:VsdObjCurr:GdsGuid
      767         and vsds:VsdObjCurr:GdsGuid <> ""
      768         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      769         then do :
      770           Msg = Msg + chr(10) + "GUID'ы товаров не совпадают." .
      771           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      772           is-err = true .
      773         end .
      774         if not valid-object(gdsMercsubsObj:GdsMercsubsCurr)
      775         and vsds:VsdObjCurr:GdsGuid <> ""
      776         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      777         then do :
      778           Msg = Msg + chr(10) + "В ВСД товар с GUID'ом. В TH товар не синхронизирован с ФГИС Меркурий (нет GUID'а)" .
      779           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      780           is-err = true .
      781         end .
      782         if issuerId <> vsds:VsdObjCurr:ObjBeGuid
      783         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      784         then do :
      785           Msg = Msg + chr(10) + "GUID'ы хоз. субъекта получателя не совпадают." .
      786           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      787           is-err = true .
      788         end.
      789         v-found-cli = no .
      790         for each buf_ext-classif no-lock
      791           where buf_ext-classif.classif-subject = 'clients':U
      792             and buf_ext-classif.classif-name = 'clients-esys':U
      793             and buf_ext-classif.db-num = 0
      794             and buf_ext-classif.key#_one = esysId
      795             and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + vsds:VsdObjCurr:ObjType + chr(3) + string (vsds:VsdObjCurr:ObjCode)
      796             :
      797           if entry(2, buf_ext-classif.charKey_Two, chr(6)) = vsds:VsdObjCurr:ObjEntGuid
      798           then do :
      799             v-found-cli = yes .
      800             leave.
      801           end.
      802         end.
      803         if v-found-cli = no
      804         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      805         then do :
      806           Msg = Msg + chr(10) + "GUID'ы предприятия получателя не совпадают." .
      807           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      808           is-err = true .
      809         end.
      810         v-found-cli = no .
      811         for each buf_ext-classif no-lock
      812           where buf_ext-classif.classif-subject = 'clients':U
      813             and buf_ext-classif.classif-name = 'clients-esys':U
      814             and buf_ext-classif.db-num = 0
      815             and buf_ext-classif.key#_one = esysId
      816             and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + vsds:VsdObjCurr:CliType + chr(3) + string (vsds:VsdObjCurr:CliCode)
      817             :
      818           if ( entry(1, buf_ext-classif.charKey_Two, chr(6)) = vsds:VsdObjCurr:CliBeGuid or vsds:VsdObjCurr:CliType = 'маг' )
      819           and entry(2, buf_ext-classif.charKey_Two, chr(6)) = vsds:VsdObjCurr:CliEntGuid
      820           then do :
      821             v-found-cli = yes .
      822             leave.
      823           end.
      824         end .
      825         if v-found-cli = no
      826         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      827         then do :
      828           Msg = Msg + chr(10) + "GUID'ы хоз. субъекта и/или предприятия отправителя не совпадают." .
      829           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      830           is-err = true .
      831         end.
      832         find first buf_goods no-lock where buf_goods.gds-code = vsds:VsdObjCurr:GdsCode .
      833         find first buf_units-attr no-lock where buf_units-attr.unit-name = buf_goods.unit-base
      834                                             and buf_units-attr.attr-code = "MercGuid"
      835                                             no-error .
      836         if available buf_units-attr
      837         and buf_units-attr.attr-value = vsds:VsdObjCurr:UnitGuid
      838         then do :
      839           v-found-unit = true .
      840           v-calc-qnty = p-qnty .
      841         end.
      842         else do :
      843           unitsMercObj = unitMercStr:getunitmercs(vsds:VsdObjCurr:GdsCode) .
      844           units_ :
      845           do jj = 1 to unitsMercObj:GetItem (jj):
      846             find first buf_units-attr no-lock where buf_units-attr.unit-name = unitsMercObj:UnitObjCurr:UnitName
      847                                                 and buf_units-attr.attr-code = "MercGuid"
      848                                                 no-error .
      849             if not available buf_units-attr then next units_ .
      850             if buf_units-attr.attr-value = vsds:VsdObjCurr:UnitGuid
      851             then do :
      852               v-found-unit = true .
      853               v-calc-qnty = p-qnty * unitsMercObj:UnitObjCurr:UnitCoef .
      854               leave units_ .
      855             end.
      856           end.
      857         end.
      858         if not v-found-unit
      859         then do :
      860           Msg = Msg + chr(10) + "Не найдено соответствие единицы измерения из ВСД с единицами измерения TH." .
      861           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      862           is-err = true .
      863         end.
      864         if v-calc-qnty > (vsds:VsdObjCurr:Qnty * 1.05)
      865         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      866         and v-found-unit = true
      867         then do :
      868           Msg = Msg + chr(10) + "Документарное количество в TH превосходит количество в ВСД более чем на 5%." .
      869           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      870           is-err = true .
      871         end.
      872         if v-calc-qnty < (vsds:VsdObjCurr:Qnty * 0.95)
      873         and vsds:VsdObjCurr:Status_ <> vsdStat:IsUtilized
      874         and v-found-unit = true
      875         then do :
      876           Msg = Msg + chr(10) + "Документарное количество в TH меньше количества в ВСД более чем на 5%." .
      877           os-copy value(search(v-resp-file)) value ("ERR_vetDoc_" + inUUID + ".xml" ) .
      878           is-err = true .
      879         end.
      880         vsdStorage:updateDB(vsds:VsdObjCurr) .
      881       end .
      882       if Status_ = "REJECTED"
      883       or is-err
      884       then do :
      885         find first bf_vsd no-lock where bf_vsd.UUID = inUUID and bf_vsd.ID = vsdId no-error.
      886         if available bf_vsd
      887         then do :
      888           vsds = vsdStorage:getVSDsubs (buffer bf_vsd) .
      889           do ii = 1 to vsds:GetItem(ii):
      890             Msg = left-trim(Msg, chr(10)) .
      891             vsds:VsdObjCurr:Status_ = vsdStat:IsErrCheck .
      892             vsds:VsdObjCurr:MsgErr = Msg .
      893             if is-utilized then vsds:VsdObjCurr:Status_ = vsdStat:IsUtilized .
      894             vsdStorage:updateDB(vsds:VsdObjCurr) .
      895           end.
      896         end.
      897       end .
      898       delete object vsds no-error.
      899       delete object vsdStorage no-error.
      900       delete object gdsMercsubsObj no-error.
      901       delete object gdsMercsubObj no-error.
      902       delete object gdsMercstrObj no-error.
      903       delete object unitMercStr no-error.
      904       delete object unitsMercObj no-error.
      905       p-Status_ = Status_ .
      906       p-Msg = Msg .
      907     end method .
      908     method public void receiveIncomingConsignmentResponse
      909     (
      910      input inApplicationId as char,
      911      input inUUID as char,
      912      output p-Status_ as char,
      913      output p-Msg  as char
      914     ) :
      915       define variable v-resp-file as character no-undo .
      916       v-resp-file = "IncomingConsignmentResponse_DB" + string(DbNum) + ".xml" .
      917       define buffer buf_vsd for ub.vsd .
      918       vsds = new vsdsubs() .
      919       vsdStorage = new vsdtostorage ().
      920       receiveApplicationResult (v-resp-file, inApplicationId) .
      921       if Status_ = "COMPLETED"
      922       then
      923       do ii = 1 to vsds:GetItem (ii):
      924         vsds:VsdObjCurr:MsgErr = "" .
      925         if vsds:VsdObjCurr:ID > 0
      926         then do :
      927           vsdStorage:updateDB(vsds:VsdObjCurr) .
      928         end.
      929         else do :
      930           find first buf_vsd no-lock where buf_vsd.UUID = inUUID and buf_vsd.ID = vsdId no-error .
      931           if available buf_vsd
      932           then do :
      933             vsds:VsdObjCurr:PartKey     = buf_vsd.part-key .
      934             vsds:VsdObjCurr:GdsCode     = buf_vsd.gds-code .
      935             vsds:VsdObjCurr:ObjType     = buf_vsd.obj-type .
      936             vsds:VsdObjCurr:ObjCode     = buf_vsd.obj-code .
      937             vsds:VsdObjCurr:CliType     = buf_vsd.cli-type .
      938             vsds:VsdObjCurr:CliCode     = buf_vsd.cli-code .
      939             vsds:VsdObjCurr:Status_     = vsdStat:IsSent .
      940           end.
      941           vsdStorage:insertDB(vsds:VsdObjCurr) .
      942         end.
      943       end .
      944       if Status_ = "REJECTED"
      945       then do :
      946         find first buf_vsd no-lock where buf_vsd.UUID = inUUID and buf_vsd.ID = vsdId no-error .
      947         if available buf_vsd
      948         then do :
      949           vsds = vsdStorage:getVSDsubs (buffer buf_vsd) .
      950           do ii = 1 to vsds:GetItem(ii):
      951             Msg = left-trim(Msg, chr(10)) .
      952             if Msg = "MERC14561"
      953             or Msg = "MERC14562"
      954             or Msg = "MERC14563"
      955             or Msg = "MERC14258"
      956             or Msg = "MERC14537"
      957             then
      958               vsds:VsdObjCurr:Status_ = vsdStat:IsNeedUtilized .
      959             else
      960               vsds:VsdObjCurr:Status_ = vsdStat:IsErrUtilized .
      961             vsds:VsdObjCurr:MsgErr = Msg .
      962             vsdStorage:updateDB(vsds:VsdObjCurr) .
      963           end.
      964         end.
      965       end .
      966       delete object vsds no-error.
      967       delete object vsdStorage no-error.
      968       p-Status_ = Status_ .
      969       p-Msg = Msg .
      970     end method .
      971     method private void receiveApplicationResult
      972     (
      973      input v-result-file as char,
      974      input inApplicationId as char
      975     ) :
      976       define variable cmd as character no-undo .
      977       define variable sw as handle no-undo .
      978       define variable v-file  as character no-undo .
      979       v-file = "receiveApplicationResult_DB" + string(DbNum) + ".xml" .
      980       create sax-writer sw .
      981       sw:formatted = true.
      982       sw:set-output-destination ("file", v-file).
      983       sw:encoding = "UTF-8".
      984       sw:start-document () .
      985       sw:start-element ("se:Envelope") .
      986       sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
      987       sw:insert-attribute ("xmlns:ws", "http://api.vetrf.ru/schema/cdm/application/ws-definitions") .
      988         sw:start-element ("se:Body") .
      989           sw:start-element ("ws:receiveApplicationResultRequest") .
      990             sw:write-data-element ("ws:apiKey", apiKey) .
      991             sw:write-data-element ("ws:issuerId", issuerId) .
      992             sw:write-data-element ("ws:applicationId", inApplicationId) .
      993           sw:end-element ("ws:receiveApplicationResultRequest") .
      994         sw:end-element ("se:Body") .
      995       sw:end-element ("se:Envelope") .
      996       sw:end-document () .
      997       delete object sw.
      998       if trim(proxy-addr) <> "" and proxy-addr <> ?
      999       then do :
     1000         if proxy-ssl
     1001         then do :
     1002           cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
     1003                           search ("exe/curl.exe"), SearchFile(v-file), v-result-file, login, password, server_, proxy-addr).
     1004         end.
     1005         else do :
     1006           cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
     1007                           search ("exe/curl.exe"), SearchFile(v-file), v-result-file, login, password, server_, proxy-addr, proxy-login, proxy-pswd).
     1008         end.
     1009       end.
     1010       else do :
     1011         cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
     1012                         search ("exe/curl.exe"), SearchFile(v-file), v-result-file, login, password, server_).
     1013       end.
     1014       os-command silent value (cmd).
     1015       ParseXML(input SearchFile(v-result-file)) .
     1016     end method .
     1017     method public void ParseXML
     1018     (
     1019       input p-inFileName as character
     1020     ):
     1021       define variable hHandler as handle no-undo.
     1022       define variable hParser  as handle no-undo.
     1023       define variable nameChildrenCurr as character no-undo.
     1024       define variable iNum             as integer   no-undo.
     1025       run ibs/th/bge/mercury/parseMercXML.p persistent set hHandler (input vsdID).
     1026       create sax-reader hParser.
     1027       hParser:handler = hHandler.
     1028       hParser:set-input-source("FILE", p-inFileName).
     1029       hParser:SUPPRESS-NAMESPACE-PROCESSING = true.
     1030       hParser:VALIDATION-ENABLED = false.
     1031       hParser:SCHEMA-LOCATION = "".
     1032       hParser:NONAMESPACE-SCHEMA-LOCATION = "".
     1033       iNum = 0.
     1034       hParser:sax-parse ( ).
     1035       if p-inFileName = SearchFile("ApplicationResponse_DB" + string(DbNum) + ".xml")
     1036       then do :
     1037         run getData in hHandler (output applicationId, output Status_, output Msg).
     1038       end.
     1039       if p-inFileName = SearchFile("VetDocumentByUuidResponse_DB" + string(DbNum) + ".xml")
     1040       or p-inFileName = SearchFile("IncomingConsignmentResponse_DB" + string(DbNum) + ".xml")
     1041       then do :
     1042         run getVsds in hHandler (output applicationId, output Status_, output Msg, output vsds).
     1043       end.
     1044       delete object hParser.
     1045       delete procedure hHandler.
     1046     end method.
     1047   method public character objExists
     1048   (input  ifolder as character,
     1049    input  iType   as character  ):
     1050       define variable vFileType as character no-undo init "D,F".
     1051       define variable vi        as integer no-undo.
     1052       define variable vtype as character no-undo.
     1053       if iType ne ?
     1054       then
     1055          vFileType = iType.
     1056       do vi = 1 to num-entries(vFileType):
     1057          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     1058          vtype = file-information:file-type.
     1059          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1060             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1061             index(vtype , entry(vi,vFileType )) > 0
     1062          then return file-information:full-pathname .
     1063          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     1064          vtype = file-information:file-type.
     1065          if file-information:file-name <> "" and
     1066             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     1067             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     1068             index( vtype, entry(vi,vFileType )) > 0
     1069          then return file-information:full-pathname .
     1070       end.
     1071       return ? .
     1072   end.
     1073   method public character SearchFile
     1074   (input  ifile as character):
     1075      return objExists(ifile,?).
     1076   end.
     1077   method public character SearchPFile
     1078   (input inFile as char):
     1079        define variable oFile       as character no-undo.
     1080        define variable vFileSearch as character no-undo.
     1081        define variable vNumEntry   as integer no-undo.
     1082        if inFile = "" then return ?.
     1083        vNumEntry = num-entries(inFile,".").
     1084        vFileSearch = inFile.
     1085        if    vNumEntry > 0
     1086           and (   entry(vNumEntry,inFile,".") eq "p"
     1087                or entry(vNumEntry,inFile,".") eq "w")
     1088        then do:
     1089           entry(vNumEntry,vFileSearch, ".") = "r".
     1090           oFile = search(vFileSearch ).
     1091           if oFile eq ?
     1092           then
     1093              oFile = search(inFile).
     1094        end.
     1095        else
     1096           oFile = search(vFileSearch).
     1097        return oFile.
     1098     end.
     1099   end class.
