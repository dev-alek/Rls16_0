        1   using Progress.Lang.*.
        2   using ibs.th.str.gds.*.
        3   using ibs.th.str.mercury.*.
        4   using ibs.th.gbl.storage.*.
        5   using ibs.th.str.clients.*.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.mercury.mercury:
        8     define variable vsdStat as class ibs.th.str.mercury.vsdstatustype no-undo.
        9   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10     define property apiKey as character no-undo init ?
       11       get.
       12       private set.
       13     define property issuerId as character no-undo init ?
       14       get.
       15       private set.
       16     define property login as character no-undo init ?
       17       get.
       18       private set.
       19     define property login_is as character no-undo init ?
       20       get.
       21       private set.
       22     define property password as character no-undo init ?
       23       get.
       24       private set.
       25     define property proxy-addr as character no-undo init ?
       26       get.
       27       private set.
       28     define property proxy-login as character no-undo init ?
       29       get.
       30       private set.
       31     define property proxy-pswd as character no-undo init ?
       32       get.
       33       private set.
       34     define property proxy-ssl as logical no-undo init ?
       35       get.
       36       private set.
       37     define property esysId as integer no-undo init ?
       38       get.
       39       private set.
       40     define property DbNum as integer no-undo init ?
       41       get.
       42       private set.
       43     define property server_ as character no-undo init ?
       44       get.
       45       private set.
       46     define property applicationId as character no-undo
       47       get.
       48       protected set.
       49     define property vsdId as int64 no-undo
       50       get.
       51       set.
       52     define property Status_ as character no-undo
       53       get.
       54       protected set.
       55     define property Msg as character no-undo
       56       get.
       57       protected set.
       58     define property StatusErr as logical no-undo init false
       59       get.
       60       protected set.
       61     define variable vsds as class vsdsubs no-undo .
       62     define variable vsdStorage as class vsdtostorage no-undo .
       63     define variable gdsMercsubsObj as class gdsmercsubs no-undo .
       64     define variable gdsmercstrObj as class gdsmercstr no-undo .
       65     define buffer buf_ext-classif        for ub.ext-classif.
       66     define buffer buf_ext-system         for ub.ext-system.
       67     def var ii as integer no-undo .
       68     constructor public mercury (inApiKey as char,
       69                                 inIssuerId as char,
       70                                 inLogin as char,
       71                                 inPassword as char,
       72                                 inLogin_is as char,
       73                                 inEsysId as int,
       74                                 inServer as int,
       75                                 inProxyAddr as char,
       76                                 inProxyLogin as char,
       77                                 inProxyPswd as char,
       78                                 inProxySSL as logical,
       79                                 inDbNum as int):
       80       assign
       81         apiKey   = inApiKey
       82         issuerId = inIssuerId
       83         login    = inLogin
       84         password = inPassword
       85         login_is = inLogin_is
       86         esysId   = inEsysId
       87         proxy-addr = inProxyAddr
       88         proxy-login = inProxyLogin
       89         proxy-pswd = inProxyPswd
       90         proxy-ssl = inProxySSL
       91         DbNum = inDbNum
       92       .
       93       if inServer = 1 then server_ = "https://api2.vetrf.ru:8002" .
       94       if inServer = 2 then server_ = "https://api.vetrf.ru" .
       95                   vsdStat = new vsdstatustype () .
       96     end constructor.
       97     destructor public mercury ( ):
       98       delete object vsds no-error .
       99       delete object vsdStorage no-error .
      100       delete object gdsMercsubsObj no-error .
      101       delete object gdsmercstrObj no-error .
      102     end destructor.
      103     method public void GetVetDocumentByUuid
      104     (
      105      input inUuid as char,
      106      input inEntGuid as char,
      107      output p-applicationId as char,
      108      output p-Status_ as char,
      109      output p-Msg  as char
      110     ) :
      111       define variable cmd as character no-undo .
      112       define variable sw as handle no-undo .
      113       define variable v-file  as character no-undo .
      114       v-file = "GetVetDocumentByUuid_DB" + string(DbNum) + ".xml" .
      115       define variable v-resp-file as character no-undo .
      116       v-resp-file = "ApplicationResponse_DB" + string(DbNum) + ".xml" .
      117       create sax-writer sw .
      118       sw:formatted = true.
      119       sw:set-output-destination ("file", v-file).
      120       sw:encoding = "UTF-8".
      121       sw:start-document () .
      122       sw:start-element ("se:Envelope") .
      123       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      124       sw:insert-attribute ("xmlns:dt", "http://api.vetrf.ru/schema/cdm/dictionary/v2") .
      125       sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
      126       sw:insert-attribute ("xmlns:merc", "http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2") .
      127       sw:insert-attribute ("xmlns:apldef", "http://api.vetrf.ru/schema/cdm/application/ws-definitions") .
      128       sw:insert-attribute ("xmlns:apl", "http://api.vetrf.ru/schema/cdm/application") .
      129       sw:insert-attribute ("xmlns:vd", "http://api.vetrf.ru/schema/cdm/mercury/vet-document/v2") .
      130       sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
      131         sw:start-element ("se:Body") .
      132           sw:start-element ("apldef:submitApplicationRequest") .
      133             sw:write-data-element ("apldef:apiKey", apiKey) .
      134             sw:start-element ("apl:application") .
      135               sw:write-data-element ("apl:serviceId", "mercury-g2b.service:2.1") .
      136               sw:write-data-element ("apl:issuerId", issuerId) .
      137               sw:write-data-element ("apl:issueDate", iso-date(now)) .
      138               sw:start-element ("apl:data") .
      139                 sw:start-element ("merc:getVetDocumentByUuidRequest") .
      140                   sw:write-data-element ("merc:localTransactionId", "1") .
      141                   sw:start-element ("merc:initiator") .
      142                     sw:write-data-element ("vd:login", login_is) .
      143                   sw:end-element ("merc:initiator") .
      144                   sw:write-data-element ("bs:uuid", inUuid) .
      145                   sw:write-data-element ("dt:enterpriseGuid", inEntGuid) .
      146                 sw:end-element ("merc:getVetDocumentByUuidRequest") .
      147               sw:end-element ("apl:data") .
      148             sw:end-element ("apl:application") .
      149           sw:end-element ("apldef:submitApplicationRequest") .
      150         sw:end-element ("se:Body") .
      151       sw:end-element ("se:Envelope") .
      152       sw:end-document () .
      153       delete object sw.
      154       if trim(proxy-addr) <> "" and proxy-addr <> ?
      155       then do :
      156         if proxy-ssl
      157         then do :
      158           cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
      159                           search ("exe/curl.exe"), SearchFile(v-file), v-resp-file, login, password, server_, proxy-addr).
      160         end.
      161         else do :
      162           cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
      163                           search ("exe/curl.exe"), SearchFile(v-file), v-resp-file, login, password, server_, proxy-addr, proxy-login, proxy-pswd).
      164         end.
      165       end.
      166       else do :
      167         cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
      168                         search ("exe/curl.exe"), SearchFile(v-file), v-resp-file, login, password, server_).
      169       end.
      170       os-command silent value (cmd).
      171       ParseXML(input SearchFile(v-resp-file)) .
      172       p-applicationId = applicationId .
      173       p-Status_ = Status_ .
      174       p-Msg = Msg .
      175       pause 0.2 .
      176     end method.
      177     method public void processIncomingConsignment
      178     (
      179      input inVsdSubs as class vsdsubs,
      180      input p-qnty as decimal,
      181      input p-fact-qnty as decimal,
      182      output p-applicationId as char,
      183      output p-Status_ as char,
      184      output p-Msg  as char
      185     ) :
      186       define variable cmd as character no-undo .
      187       define variable sw as handle no-undo .
      188       define variable v-file  as character no-undo .
      189       v-file = "processIncomingConsignment_DB" + string(DbNum) + ".xml" .
      190       define variable v-resp-file as character no-undo .
      191       v-resp-file = "ApplicationResponse_DB" + string(DbNum) + ".xml" .
      192       define variable v-cli-be-guid as character no-undo .
      193       define variable v-cli-ent-guid as character no-undo .
      194       define variable v-obj-be-guid as character no-undo .
      195       define variable v-obj-ent-guid as character no-undo .
      196       define variable rd as integer no-undo .
      197       define variable bi as integer no-undo .
      198       define variable v-util-qnty as decimal no-undo .
      199       define variable v-return-qnty as decimal no-undo .
      200       define variable jj as integer no-undo .
      201       define variable v-is-return as logical no-undo .
      202       define variable unitsMercObj as class unitsubs no-undo .
      203       define variable unitMercStr as class unitmercstr no-undo .
      204       define buffer buf_goods for ub.goods .
      205       define buffer buf_units-attr for ub.units-attr .
      206       gdsMercsubsObj = new gdsmercsubs ().
      207       gdsmercstrObj = new gdsmercstr ().
      208       unitsMercObj = new unitsubs ().
      209       unitMercStr = new unitmercstr ().
      210       find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('10':U) no-error.
      211       if not available buf_ext-system
      212       then do :
      213       end.
      214       v-obj-be-guid = inVsdSubs:VsdObjCurr:ObjBeGuid no-error .
      215       v-obj-ent-guid = inVsdSubs:VsdObjCurr:ObjEntGuid no-error .
      216       find first buf_ext-classif no-lock
      217           where buf_ext-classif.classif-subject = 'clients':U
      218             and buf_ext-classif.classif-name = 'clients-esys':U
      219             and buf_ext-classif.db-num = 0
      220             and buf_ext-classif.key#_one = buf_ext-system.esys-id
      221             and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + inVsdSubs:VsdObjCurr:ObjType + chr(3) + string (inVsdSubs:VsdObjCurr:ObjCode)
      222             no-error.
      223       if v-obj-be-guid = "" or v-obj-be-guid = ? then
      224         v-obj-be-guid = entry(1, buf_ext-classif.charKey_Two, chr(6)) no-error.
      225       if v-obj-ent-guid = "" or v-obj-ent-guid = ? then
      226         v-obj-ent-guid = entry(2, buf_ext-classif.charKey_Two, chr(6)) no-error.
      227       if v-obj-be-guid = "" or v-obj-be-guid = ? then v-obj-be-guid = issuerId .
      228       v-cli-be-guid = inVsdSubs:VsdObjCurr:CliBeGuid no-error .
      229       v-cli-ent-guid = inVsdSubs:VsdObjCurr:CliEntGuid no-error .
      230       find first buf_ext-classif no-lock
      231           where buf_ext-classif.classif-subject = 'clients':U
      232             and buf_ext-classif.classif-name = 'clients-esys':U
      233             and buf_ext-classif.db-num = 0
      234             and buf_ext-classif.key#_one = buf_ext-system.esys-id
      235             and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + inVsdSubs:VsdObjCurr:CliType + chr(3) + string (inVsdSubs:VsdObjCurr:CliCode)
      236             no-error.
      237       if v-cli-be-guid = "" or v-cli-be-guid = ? then
      238         v-cli-be-guid = entry(1, buf_ext-classif.charKey_Two, chr(6)) no-error.
      239       if v-cli-ent-guid = "" or v-cli-ent-guid = ? then
      240         v-cli-ent-guid = entry(2, buf_ext-classif.charKey_Two, chr(6)) no-error.
      241       if (v-cli-be-guid = "" or v-cli-be-guid = ?) and inVsdSubs:VsdObjCurr:CliType = 'маг' then v-cli-be-guid = issuerId .
      242       find first buf_goods no-lock where buf_goods.gds-code = inVsdSubs:VsdObjCurr:GdsCode no-error .
      243       if not available buf_goods
      244       then do :
      245         p-Status_ = "CritErr_GdsCode" .
      246         p-Msg = "Не найден товар из ВСД. Код товара в ВСД - " + string(inVsdSubs:VsdObjCurr:GdsCode) . .
      247         return .
      248       end .
      249       find first buf_units-attr no-lock where buf_units-attr.unit-name = buf_goods.unit-base
      250                                           and buf_units-attr.attr-code = "MercGuid"
      251                                           no-error .
      252       if available buf_units-attr
      253       and buf_units-attr.attr-value = inVsdSubs:VsdObjCurr:UnitGuid
      254       then do :
      255         if p-qnty = p-fact-qnty
      256         then do :
      257           v-util-qnty = p-qnty .
      258           v-return-qnty = 0 .
      259           v-is-return = false .
      260         end.
      261         else do :
      262           v-util-qnty = p-fact-qnty .
      263           v-return-qnty = p-qnty - v-util-qnty .
      264           v-is-return = true .
      265         end.
      266       end.
      267       else do :
      268         unitsMercObj = unitMercStr:getunitmercs(inVsdSubs:VsdObjCurr:GdsCode) .
      269         units_ :
      270         do jj = 1 to unitsMercObj:GetItem (jj):
      271           find first buf_units-attr no-lock where buf_units-attr.unit-name = unitsMercObj:UnitObjCurr:UnitName
      272                                               and buf_units-attr.attr-code = "MercGuid"
      273                                               no-error .
      274           if not available buf_units-attr then next units_ .
      275           if buf_units-attr.attr-value = inVsdSubs:VsdObjCurr:UnitGuid
      276           then do :
      277             if p-qnty = p-fact-qnty
      278             then do :
      279               v-util-qnty = p-qnty * unitsMercObj:UnitObjCurr:UnitCoef .
      280               v-return-qnty = 0 .
      281               v-is-return = false .
      282             end.
      283             else do :
      284               v-util-qnty = p-fact-qnty * unitsMercObj:UnitObjCurr:UnitCoef .
      285               v-return-qnty = (p-qnty - p-fact-qnty) * unitsMercObj:UnitObjCurr:UnitCoef .
      286               v-is-return = true .
      287             end.
      288             leave units_ .
      289           end.
      290         end.
      291       end.
      292       gdsMercsubsObj = gdsmercstrObj:getgdsmercs(inVsdSubs:VsdObjCurr:GdsCode).
      293       create sax-writer sw .
      294       sw:formatted = true.
      295       sw:set-output-destination ("file", v-file).
      296       sw:encoding = "UTF-8".
      297       sw:start-document () .
      298       sw:start-element ("se:Envelope") .
      299       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      300       sw:insert-attribute ("xmlns:dt", "http://api.vetrf.ru/schema/cdm/dictionary/v2") .
      301       sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
      302       sw:insert-attribute ("xmlns:merc", "http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2") .
      303       sw:insert-attribute ("xmlns:apldef", "http://api.vetrf.ru/schema/cdm/application/ws-definitions") .
      304       sw:insert-attribute ("xmlns:apl", "http://api.vetrf.ru/schema/cdm/application") .
      305       sw:insert-attribute ("xmlns:vd", "http://api.vetrf.ru/schema/cdm/mercury/vet-document/v2") .
      306       sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
      307         sw:start-element ("se:Body") .
      308           sw:start-element ("apldef:submitApplicationRequest") .
      309             sw:write-data-element ("apldef:apiKey", apiKey) .
      310             sw:start-element ("apl:application") .
      311               sw:write-data-element ("apl:serviceId", "mercury-g2b.service:2.1") .
      312               sw:write-data-element ("apl:issuerId", issuerId) .
      313               sw:write-data-element ("apl:issueDate", iso-date(now)) .
      314               sw:start-element ("apl:data") .
      315                 sw:start-element ("merc:processIncomingConsignmentRequest") .
      316                   sw:write-data-element ("merc:localTransactionId", "1") .
      317                   sw:start-element ("merc:initiator") .
      318                     sw:write-data-element ("vd:login", login_is) .
      319                   sw:end-element ("merc:initiator") .
      320                   sw:start-element ("merc:delivery") .
      321                     sw:write-data-element ("vd:deliveryDate", iso-date(inVsdSubs:VsdObjCurr:FactDatetime)) .
      322                     sw:start-element ("vd:consignor") .
      323                       sw:start-element ("dt:businessEntity") .
      324                         sw:write-data-element ("bs:guid", LC(v-cli-be-guid)) .
      325                       sw:end-element ("dt:businessEntity") .
      326                       sw:start-element ("dt:enterprise") .
      327                         sw:write-data-element ("bs:guid", LC(v-cli-ent-guid)) .
      328                       sw:end-element ("dt:enterprise") .
      329                     sw:end-element ("vd:consignor") .
      330                     sw:start-element ("vd:consignee") .
      331                       sw:start-element ("dt:businessEntity") .
      332                         sw:write-data-element ("bs:guid", LC(v-obj-be-guid)) .
      333                       sw:end-element ("dt:businessEntity") .
      334                       sw:start-element ("dt:enterprise") .
      335                         sw:write-data-element ("bs:guid", LC(v-obj-ent-guid)) .
      336                       sw:end-element ("dt:enterprise") .
      337                     sw:end-element ("vd:consignee") .
      338                   if v-util-qnty > 0
      339                   then do :
      340                     sw:start-element ("vd:consignment") .
      341                       sw:write-data-element ("vd:productType", inVsdSubs:VsdObjCurr:TypeProd) .
      342                       sw:start-element ("vd:product") .
      343                         if inVsdSubs:VsdObjCurr:ProductGuid <> "" and inVsdSubs:VsdObjCurr:ProductGuid <> ?
      344                         then sw:write-data-element ("bs:guid", LC(inVsdSubs:VsdObjCurr:ProductGuid)) .
      345                         else sw:write-data-element ("bs:guid", LC(gdsMercsubsObj:GdsMercsubsCurr:GUIDType)) .
      346                       sw:end-element ("vd:product") .
      347                       sw:start-element ("vd:subProduct") .
      348                         if inVsdSubs:VsdObjCurr:SubProductGuid <> "" and inVsdSubs:VsdObjCurr:SubProductGuid <> ?
      349                         then sw:write-data-element ("bs:guid", LC(inVsdSubs:VsdObjCurr:SubProductGuid)) .
      350                         else sw:write-data-element ("bs:guid", LC(gdsMercsubsObj:GdsMercsubsCurr:GUIDSubType)) .
      351                       sw:end-element ("vd:subProduct") .
      352                       sw:start-element ("vd:productItem") .
      353                         if inVsdSubs:VsdObjCurr:GdsGuid <> ? and inVsdSubs:VsdObjCurr:GdsGuid <> ""
      354                         then sw:write-data-element ("bs:guid", LC(inVsdSubs:VsdObjCurr:GdsGuid)) .
      355                         if inVsdSubs:VsdObjCurr:GdsName <> ? and inVsdSubs:VsdObjCurr:GdsName <> ""
      356                         then sw:write-data-element ("dt:name", inVsdSubs:VsdObjCurr:GdsName) .
      357                       sw:end-element ("vd:productItem") .
      358                       sw:write-data-element ("vd:volume", string(round(v-util-qnty, 6))) .
      359                       sw:start-element ("vd:unit") .
      360                         sw:write-data-element ("bs:guid", LC(inVsdSubs:VsdObjCurr:UnitGuid)) .
      361                       sw:end-element ("vd:unit") .
      362                       sw:start-element ("vd:dateOfProduction") .
      363                         sw:start-element ("vd:firstDate") .
      364                           sw:write-data-element ("dt:year", entry(1, inVsdSubs:VsdObjCurr:DateOut, ":")) .
      365                           if entry(2, inVsdSubs:VsdObjCurr:DateOut, ":") <> ""
      366                           then sw:write-data-element ("dt:month", entry(2, inVsdSubs:VsdObjCurr:DateOut, ":")) .
      367                           if entry(3, inVsdSubs:VsdObjCurr:DateOut, ":") <> ""
      368                           then sw:write-data-element ("dt:day", entry(3, inVsdSubs:VsdObjCurr:DateOut, ":")) .
      369                           if entry(4, inVsdSubs:VsdObjCurr:DateOut, ":") <> ""
      370                           then sw:write-data-element ("dt:hour", entry(4, inVsdSubs:VsdObjCurr:DateOut, ":")) .
      371                         sw:end-element ("vd:firstDate") .
      372                       if inVsdSubs:VsdObjCurr:ExpiryOutDate <> ? and inVsdSubs:VsdObjCurr:ExpiryOutDate <> ":::" and inVsdSubs:VsdObjCurr:ExpiryOutDate <> ""
      373                       then do :
      374                         sw:start-element ("vd:secondDate") .
      375                           sw:write-data-element ("dt:year", entry(1, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":")) .
      376                           if entry(2, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":") <> ""
      377                           then sw:write-data-element ("dt:month", entry(2, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":")) .
      378                           if entry(3, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":") <> ""
      379                           then sw:write-data-element ("dt:day", entry(3, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":")) .
      380                           if entry(4, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":") <> ""
      381                           then sw:write-data-element ("dt:hour", entry(4, inVsdSubs:VsdObjCurr:ExpiryOutDate, ":")) .
      382                         sw:end-element ("vd:secondDate") .
      383                       end.
      384                       sw:end-element ("vd:dateOfProduction") .
      385                       sw:start-element ("vd:expiryDate") .
      386                         sw:start-element ("vd:firstDate") .
      387                           sw:write-data-element ("dt:year", entry(1, inVsdSubs:VsdObjCurr:ExpiryDate, ":")) .
      388                           if entry(2, inVsdSubs:VsdObjCurr:ExpiryDate, ":") <> ""
      389                           then sw:write-data-element ("dt:month", entry(2, inVsdSubs:VsdObjCurr:ExpiryDate, ":")) .
      390                           if entry(3, inVsdSubs:VsdObjCurr:ExpiryDate, ":") <> ""
      391                           then sw:write-data-element ("dt:day", entry(3, inVsdSubs:VsdObjCurr:ExpiryDate, ":")) .
      392                           if entry(4, inVsdSubs:VsdObjCurr:ExpiryDate, ":") <> ""
      393                           then sw:write-data-element ("dt:hour", entry(4, inVsdSubs:VsdObjCurr:ExpiryDate, ":")) .
      394                         sw:end-element ("vd:firstDate") .
      395                       if inVsdSubs:VsdObjCurr:ExpiryDate2 <> ? and inVsdSubs:VsdObjCurr:ExpiryDate2 <> ":::" and inVsdSubs:VsdObjCurr:ExpiryDate2 <> ""
      396                       then do :
      397                         sw:start-element ("vd:secondDate") .
      398                           sw:write-data-element ("dt:year", entry(1, inVsdSubs:VsdObjCurr:ExpiryDate2, ":")) .
      399                           if entry(2, inVsdSubs:VsdObjCurr:ExpiryDate2, ":") <> ""
      400                           then sw:write-data-element ("dt:month", entry(2, inVsdSubs:VsdObjCurr:ExpiryDate2, ":")) .
