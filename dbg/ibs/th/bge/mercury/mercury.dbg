      699       delete object unitsMercObj no-error.
      700       if trim(proxy-addr) <> "" and proxy-addr <> ?
      701       then do :
      702         if proxy-ssl
      703         then do :
      704           cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
      705                           search ("exe/curl.exe"), SearchFile(v-file), v-resp-file, login, password, server_, proxy-addr).
      706         end.
      707         else do :
      708           cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ApplicationManagementService >&3",
