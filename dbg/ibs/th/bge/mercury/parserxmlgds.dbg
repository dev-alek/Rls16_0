        1   using Progress.Lang.*.
        2   using ibs.th.bge.mercury.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.mercury.ParserXMLGds:
        5   define temp-table tt-gds-merq no-undo
        6     field ID             as integer
        7     field merc-name      like ub.goods.gds-name label "Полное наименование" format "X(100)"
        8     field UUID           as character label "UUID"
        9     field GUID_          as character label "GUID"
       10     field units          as character label "Ед.измерения"
       11     field units_th       as character label "Ед.измерения в ТН"
       12     field status_        as integer   label "Статус"
       13     field crDate         as date      label "Дата создания" format "99.99.9999"
       14     field update_Date    as date      label "Дата изменени" format "99.99.9999"
       15     field prod-type      as integer   label "Тип продукции" format ">>>>9"
       16     field prod-type-name as character label "Тип продукции"
       17     field GUID-type      as character label "GUID-type"
       18     field GUID-subtype   as character label "GUID-subtype"
       19     index pi as primary
       20     ID
       21     index name_ as word-index
       22     merc-name
       23     index merq
       24     GUID_
       25     .
       26     define variable v-FS-RAR    as character no-undo .
       27     define variable v-item      as character no-undo .
       28     define variable v-mess      as character no-undo .
       29     DEFINE VARIABLE hDoc        AS HANDLE    NO-UNDO.
       30     DEFINE VARIABLE hRoot       AS HANDLE    NO-UNDO.
       31     DEFINE VARIABLE good        AS LOGICAL   NO-UNDO.
       32     define variable v-save-info as character no-undo .
       33     define variable v-imp       as logical .
       34     method public void ParseResponse(inFileName as char, INPUT-OUTPUT Table tt-gds-merq, output Msg as character):
       35       empty temp-table tt-gds-merq .
       36       CREATE X-DOCUMENT hDoc.
       37       CREATE X-NODEREF hRoot.
       38       hDoc:LOAD("file",inFileName,FALSE) no-error.
       39       if inFileName = ? then
       40       do:
       41         Msg = "Файл не найден" .
       42         return .
       43       end.
       44       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       45       GetChildren(hRoot, 1, output Msg).
       46       DELETE OBJECT hDoc.
       47       DELETE OBJECT hRoot.
       48     end.
       49     method private void GetChildren(hParent AS HANDLE, level AS INTEGER, output Msg as character):
       50       DEFINE VARIABLE i        AS INTEGER NO-UNDO.
       51       DEFINE VARIABLE hNoderef AS HANDLE  NO-UNDO.
       52       DEFINE VARIABLE hText    AS HANDLE  NO-UNDO.
       53       DEFINE VARIABLE tt       as integer NO-UNDO .
       54       tt = hParent:NUM-CHILDREN no-error .
       55       if tt = ? then
       56       do:
       57         Msg = "Ошибка запроса. См. в файле ответа" .
       58         return.
       59       end.
       60       CREATE X-NODEREF hNoderef.
       61       CREATE X-NODEREF hText .
       62       REPEAT i = 1 TO hParent:NUM-CHILDREN:
       63         good = hParent:GET-CHILD(hNoderef,i).
       64         IF NOT good THEN
       65           LEAVE.
       66         IF hNoderef:SUBTYPE <> "element" THEN
       67           NEXT.
       68         hNoderef:GET-CHILD(hText, 1) no-error .
       69         IF hNoderef:NAME = "dt:productItem" THEN
       70         DO:
       71           v-item = "ProductItem" .
       72           create tt-gds-merq .
       73         END.
       74         IF hNoderef:NAME = "dt:product" THEN
       75         DO:
       76           v-item = "Product" .
       77         END.
       78         IF hNoderef:NAME = "dt:subProduct" THEN
       79         DO:
       80           v-item = "SubProduct" .
       81         END.
       82         IF hNoderef:NAME = "dt:unit" THEN
       83         DO:
       84           v-item = "Unit" .
       85         END.
       86         IF hNoderef:NAME = "bs:uuid" and v-item = "Product"    THEN assign tt-gds-merq.UUID = hText:node-value .
       87         if v-item = "ProductItem" then
       88         do:
       89           IF hNoderef:NAME = "bs:guid"    THEN assign tt-gds-merq.GUID_ = hText:node-value .
       90           IF hNoderef:NAME = "bs:createDate"    THEN assign tt-gds-merq.crDate = date(DateMercury(hText:node-value)) .
       91           IF hNoderef:NAME = "bs:updateDate"    THEN assign tt-gds-merq.update_Date = date(DateMercury(hText:node-value)) .
       92           IF hNoderef:NAME = "dt:name"          THEN assign tt-gds-merq.merc-name = hText:node-value .
       93         end.
       94         if v-item = "Product" then
       95         do:
       96           IF hNoderef:NAME = "bs:guid"    THEN assign tt-gds-merq.GUID-type = hText:node-value .
       97         end.
       98         if v-item = "SubProduct" then
       99         do:
      100           IF hNoderef:NAME = "bs:guid"    THEN assign tt-gds-merq.GUID-subtype = hText:node-value .
      101         end.
      102         if v-item = "unit" then
      103         do:
      104           IF hNoderef:NAME = "dt:name"          THEN assign tt-gds-merq.units = hText:node-value .
      105         end.
      106         IF hNoderef:NAME = "dt:productType"   THEN assign tt-gds-merq.prod-type = INTEGER (hText:node-value) .
      107         IF hNoderef:NAME = "dt:status"    THEN assign tt-gds-merq.status_ = INTEGER(hText:node-value) .
      108         if hNoderef:NAME begins "base:error" then do: assign Msg = hText:NODE-VALUE .
      109         return.
      110         end.
      111         GetChildren(hNoderef, (level + 1),msg).
      112       END.
      113       DELETE OBJECT hNoderef.
      114       DELETE OBJECT hText.
      115     END.
      116     method private character DateMercury (inValue as character):
      117       def var v-str as character no-undo.
      118       inValue = entry (1,inValue,"T")  .
      119       if inValue = "0001-01-01" then v-str = ? .
      120       else v-str = entry (3, string(inValue), "-") + "/" + entry (2, string(inValue), "-") + "/" + entry (1, string(inValue), "-") .
      121       return v-str.
      122     end.
      123   end class.
