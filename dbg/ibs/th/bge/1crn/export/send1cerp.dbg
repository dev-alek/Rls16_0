        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.paramCol from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.export.send1cerp
        5      inherits   ibs.th.gbl.sys.objth
        6      implements ibs.th.rul.route_date_error
        7   :
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Выгрузка в 1С" get.
       14      define public property parparentproc as handle    no-undo
       15      get. set.
       16      define public property parent-handle as handle    no-undo get. set.
       17      define public property log-handle    as handle    no-undo get. set.
       18      define public property processType   as character no-undo get. set.
       19      define public property oldbh         as handle    no-undo get. set.
       20      define public property newbh         as handle    no-undo get. set.
       21      define public property params        as paramCol  no-undo get. set.
       22      define public property classExport   as character no-undo get. set.
       23      define variable cmd-code      as character no-undo.
       24      define variable m-DATA        as memptr no-undo.
       25      define property Msg as character no-undo
       26      get.
       27      private set.
       28   method public logical context_begin-esys-command
       29   (
       30       input p-esys-id-list as character
       31      ,input-output p-esys-cmd-proc-handle as handle
       32      ,output p-esys-cmd-code as integer
       33   ):
       34      if not valid-handle(p-esys-cmd-proc-handle )
       35      then do:
       36        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
       37        if error-status :error
       38        then do:
       39           setError ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
       40                                              "&5&4&6"
       41                                              ,vss-workfile
       42                                              ,vss-revision
       43                                              ,vss-description
       44                                              ,chr(10)
       45                                              ,error-status:get-message(1)
       46                                              ,return-value )).
       47        end.
       48        run begin-create-command in p-esys-cmd-proc-handle
       49          (input 'cmd-esys-general':U
       50          ,input p-esys-id-list
       51          ,output p-esys-cmd-code
       52          ) no-error.
       53        if error-status :error
       54        then do:
       55          setError ( input substitute("Ошибка при создании команды &1&2&3&1&4"
       56                                                           , 'cmd-esys-general':U
       57                                                           , error-status:get-message(1)
       58                                                           , return-value
       59                                                           )).
       60          return no .
       61        end.
       62        return yes.
       63      end.
       64   end.
       65   method public int64 context_send-esys-command
       66   (
       67       input p-esys-id-list as character
       68      ,input p-esys-cmd-proc-handle as handle
       69      ,input p-esys-cmd-code as integer
       70      ,input p-user-id as character
       71   ):
       72      define variable v-dmp-ord-int64 as int64 no-undo .
       73      if valid-handle(p-esys-cmd-proc-handle )
       74      then do:
       75         run send-command-esys in p-esys-cmd-proc-handle
       76             (input p-esys-cmd-code
       77             ,input p-esys-id-list
       78             ,input p-user-id
       79             ,output v-dmp-ord-int64
       80             ) no-error.
       81         if error-status :error
       82         then do:
       83            setError ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
       84                                                           , p-esys-id-list
       85                                                           , cmd-code
       86                                                           , chr(10)
       87                                                           , error-status:get-message(1)
       88                                                           , return-value
       89                                                           )).
       90            return 0.
       91         end.
       92         delete procedure p-esys-cmd-proc-handle no-error.
       93         return v-dmp-ord-int64.
       94      end.
       95      else do:
       96         setError ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
       97                                                       , p-esys-id-list
       98                                                       , cmd-code
       99                                                       , chr(10)
      100                                                       , error-status:get-message(1)
      101                                                       , return-value
      102                                                       )).
      103         return 0 .
      104      end.
      105   end.
      106   method public logical context_set-custom-esys-pck-name
      107   (
      108       input p-esys-cmd-proc-handle as handle
      109      ,input p-esys-cmd-code as integer
      110      ,input p-custom-pck-name as character
      111   ):
      112      if valid-handle(p-esys-cmd-proc-handle )
      113      then do:
      114         run set-custom-esys-pck-name in p-esys-cmd-proc-handle (
      115                                                                 input p-esys-cmd-code
      116                                                                ,input p-custom-pck-name) no-error .
      117         if error-status :error
      118         then do:
      119            setError ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
      120                                                        , cmd-code
      121                                                        , chr(10)
      122                                                        , error-status:get-message(1)
      123                                                        , return-value
      124                                                        )).
      125            return no .
      126         end.
      127         return yes.
      128      end.
      129      else do:
      130         setError ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
      131                                                       , cmd-code
      132                                                       , chr(10)
      133                                                       , error-status:get-message(1)
      134                                                       , return-value
      135                                                       )).
      136         return no .
      137      end.
      138   end.
      139      method public void setError(iText as char):
      140         msg = iText.
      141         if valid-handle (log-handle)        then          run write-log-and-file in log-handle (                   input 1                                          , input "send1cerp.log"                             , input 1                                          , input Msg) no-error.
      142      end.
      143      constructor public send1cerp (input  i-parparentproc   as handle,
      144                                    input  i-parent-handle   as handle,
      145                                    input  i-log-handle      as handle,
      146                                    input  i-process         as character,
      147                                    input  i-oldbh           as handle,
      148                                    input  i-newbh           as handle,
      149                                    input  i-param           as paramCol
      150      ):
      151         super ().
      152         assign
      153            parparentproc = i-parparentproc
      154            parent-handle = i-parent-handle
      155            log-handle    = i-log-handle
      156            processType   = i-process
      157            oldbh         = i-oldbh
      158            newbh         = i-newbh
      159            params        = i-param
      160         .
      161         init().
      162         if Msg = ""
      163         then
      164            exportData().
      165      end constructor.
      166      destructor public send1cerp ( ):
      167      end destructor.
      168      method private void init ():
      169         cmd-code = "cmd-send-&1-to-1C-ERP".
      170         msg = "".
      171         if     classExport ne ?
      172            and classExport ne ""
      173         then
      174            .
      175         else if     processType ne ?
      176            and processType ne ""
      177         then do:
      178            classExport = substitute ("ibs.th.bge.1crn.subjects.exp-&1", processType).
      179         end.
      180         else if newbh:available
      181         then do:
      182            cmd-code = substitute (cmd-code, newbh:table).
      183            classExport = substitute ("ibs.th.bge.1crn.subjects.exp-obj-&1", newbh:table).
      184         end.
      185         else if oldbh:available
      186         then do:
      187            cmd-code = substitute (cmd-code, oldbh:table).
      188            classExport = substitute ("ibs.th.bge.1crn.subjects.exp-obj-&1", oldbh:table).
      189         end.
      190         if    classExport eq ?
      191            or classExport eq ""
      192         then do:
      193             setError("Не передана команда и буфер для отправки.").
      194         end.
      195         else if    search(replace(classExport,".","/") + ".r"  ) eq ?
      196            and search(replace(classExport,".","/") + ".cls") eq ?
      197         then do:
      198            setError(substitute ("Не найден класс экспорта &1",replace(classExport,".","/") + ".r")).
      199         end.
      200      end.
      201      method public logical exportData():
      202         define variable ExpData as class Ibs.Th.Rul.Route-data_ no-undo .
      203   ExpData = new Ibs.Th.Rul.Route-data_ (this-object,parparentproc,parent-handle,log-handle).
      204   ObjSrv:Regobj(this-object,ExpData,
      205   "ExpData"
      206   ) .
      207         exportData(ExpData) no-error .
      208         if error-status:error then
      209         do:
      210            setError(substitute("&1 &2&3",return-value,error-status:get-message(1))).
      211         end.
      212         finally:
      213            if valid-object (ExpData)
      214            then
      215               delete object ExpData.
      216         end finally.
      217      end.
      218      method private void exportData(input ExpData as class Ibs.Th.Rul.Route-data_) :
      219         if not valid-object (ExpData)
      220         then do:
      221            setError("Объект ExpData должен быть создан").
      222            return.
      223         end.
      224         define variable subOBj as class ibs.th.bge.1crn.export.send1cerpsub no-undo .
      225         _main:
      226         do
      227         on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), MSG)
      228         :
      229            if retry then do:
      230               setError(substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), MSG)).
      231               return.
      232            end.
      233            subOBj = dynamic-new classExport() no-error.
      234            if error-status:error
      235            then do:
      236               setError(substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), MSG)).
      237               return.
      238            end.
      239            ObjSrv:RegObj(this-object,subOBj).
      240            define variable v-custom-pack-name   as character   no-undo .
      241            define variable v-dump-ord-int64     as int64       no-undo .
      242            define buffer buf_sys-ctrl   for sys-ctrl.
      243            define buffer buf_ext-system  for ub.ext-system.
      244            define variable expObj as class ibs.th.bge.1crn.export.expsubject no-undo .
      245            ObjSrv:RegObj(this-object,subOBj).
      246            define variable v-esys-id-list as character no-undo.
      247            define variable v-esys-cmd-proc-handle as handle no-undo.
      248            define variable v-esys-cmd-code as int no-undo.
      249            find first buf_sys-ctrl no-lock .
      250            v-esys-id-list = "" .
      251            for each buf_ext-system no-lock where buf_ext-system.delivery-method = integer('11':U)
      252                                              and buf_ext-system.esys-have-export = yes
      253                                             and buf_ext-system.esys-db-num-exp = buf_sys-ctrl.db-num :
      254               v-esys-id-list = v-esys-id-list + string(buf_ext-system.esys-id) + chr(1) .
      255            end.
      256            v-esys-id-list = trim(v-esys-id-list, chr(1)) .
      257            if v-esys-id-list = ""
      258            then do :
      259               setError ( "Нет внешней системы с методом доставки 1C-RN." ) .
      260               return.
      261            end.
      262            subObj:setContext(parparentproc,
      263                         parent-handle,
      264                         log-handle,
      265                         processType,
      266                         oldbh,
      267                         newbh,
      268                         params) no-error.
      269            if error-status:error
      270            then do:
      271               Msg = subObj:msg.
      272               undo _main, return .
      273            end.
      274            if  context_begin-esys-command( input v-esys-id-list, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false
      275            then do:
      276               undo _main, retry .
      277            end.
      278            expObj = new ibs.th.bge.1crn.export.expsubject ().
      279            expObj:GetContent(subObj) no-error.
      280            if error-status:error
      281            then do:
      282               Msg = expObj:msg.
      283               undo _main, retry .
      284            end.
      285            if ExpData:esys-add-dump-data ( input expObj:Data,
      286                                            input v-esys-cmd-proc-handle,
      287                                            input v-esys-cmd-code,
      288                                           ('+update' + chr(4) + expObj:InitSecTag) +
      289                                            (if expObj:sendTableName <> ""
      290                                             then substitute("&1&2&3&4",chr(4),
      291                                                             expObj:sendTableName,
      292                                                             if expObj:sendOldRowid <> ? then substitute("&1&2",chr(3),expObj:sendOldRowid) else "",
      293                                                             if expObj:sendNewRowid <> ? then substitute("&1&2",chr(3),expObj:sendNewRowid) else "")
      294                                             else "")) = false
      295            then do:
      296               undo _main, retry .
      297            end.
      298            if  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false
      299            then
      300               undo _main, retry .
      301            v-dump-ord-int64 = context_send-esys-command( input v-esys-id-list
      302                                                        , input v-esys-cmd-proc-handle
      303                                                        , input v-esys-cmd-code
      304                                                        , input ibs.th.gbl.gbl-var:g#userid).
      305            if v-dump-ord-int64 = 0
      306            then
      307               undo _main, retry .
      308            ExpData:Route-data_clear-data ( ) .
      309            finally:
      310               if valid-object (subObj)
      311               then
      312                  delete object subObj.
      313               if valid-handle (v-esys-cmd-proc-handle)
      314               then
      315                  delete procedure v-esys-cmd-proc-handle no-error.
      316            end finally.
      317         end.
      318      end.
      319   end class.
