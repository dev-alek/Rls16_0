        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.export.expsubject:
        5     define property Data as memptr no-undo
        6       get.
        7       private set.
        8     define property Msg as character no-undo
        9       get.
       10       private set.
       11     define property InitSecTag as character no-undo
       12       get.
       13       private set.
       14      define property sendTableName  as character  no-undo
       15        get.
       16        private set.
       17      define property sendOldRowid as rowid  no-undo
       18        get.
       19        private set.
       20      define property sendNewRowid as rowid  no-undo
       21        get.
       22        private set.
       23     method public void GetContent (expsubject as class ibs.th.bge.1crn.subjects.iexpsubject, inType as char, inFileName as char):
       24       define variable sw as handle no-undo.
       25       create sax-writer sw.
       26       sw:formatted = true.
       27       case inType:
       28         when "memptr"
       29           then sw:set-output-destination ("memptr", Data).
       30         when "file"
       31           then sw:set-output-destination ("file", inFileName).
       32       end.
       33       sw:encoding = "UTF-8".
       34       sw:fragment = true .
       35       sw:start-document () .
       36       expsubject:CrContentToSW (sw).
       37       InitSecTag = expsubject:InitSecTag.
       38       sendTableName = expsubject:sendTableName.
       39       sendOldRowid  = expsubject:sendOldRowid.
       40       sendNewRowid  = expsubject:sendNewRowid.
       41       if inType = "memptr" and get-size(Data) > 0 and sendTableName = "" or
       42         (sendTableName <> "code" and sendTableName <> "Cash-param-hist" and sendOldRowid = ? and sendNewRowid = ?) then
       43       do:
       44         Msg = substitute(
       45           "ƒолжны быть установлены об€зательные свойства класса экспорта: охватывающий тег, таблица и rowid выгружаемой записи (&1).",
       46           expsubject:InitSecTag
       47         ).
       48         return error.
       49       end.
       50       sw:end-document () .
       51      end.
       52      method public void GetContent (expsubject as class ibs.th.bge.1crn.subjects.iexpsubject):
       53        GetContent (expsubject, "memptr", ?).
       54      end.
       55   end class.
