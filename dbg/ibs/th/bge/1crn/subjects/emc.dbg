        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.emc inherits ibs.th.bge.1crn.subjects.code:
        4       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override property InitTag as character no-undo init "EMC"
       10       get.
       11     method private date date-mth (inValue as character):
       12       inValue = entry (1, inValue, "T").
       13       return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
       14     end.
       15             define var emctype-code as integer no-undo.
       16     method override protected void SetPropProtected (inTag as char, inValue as char):
       17       super:SetPropProtected(inTag, inValue).
       18       case inTag:
       19         when "emc-start-date" then do:
       20             assign code_ = if inValue >= "" then inValue else ""
       21                    misc1 = string(if inValue >= "" then date-mth (inValue) else ?,"99/99/9999")
       22                    old_code_ = code_
       23             .
       24         end.
       25         when "del-l" then do:
       26            assign del-f = if inValue >= "" then integer (inValue) else 0.
       27         end.
       28         when "emc-name" then do:
       29           assign CodeName = if inValue >= "" then inValue else "" .
       30         end.
       31         when "emc-value" then do:
       32           assign CodeValue = if inValue >= "" then inValue else "" .
       33         end.
       34         when "emctype-code" then do:
       35           assign emctype-code = if inValue >= "" then integer (inValue) else 0
       36                  parent_      = "emc" + chr(4) + string(emctype-code,"999")
       37                  old_parent_  = parent_
       38            .
       39         end.
       40       end case.
       41     end.
       42     method override protected void CheckData ():
       43       def var v-str as char no-undo.
       44       define buffer code for ub.Code.
       45       assign
       46         v-str = "emc-start-date" when code_ = ?
       47         v-str = v-str + ",emc-value" when CodeValue = ?
       48         v-str = v-str + ",emctype-code" when parent_ = ?
       49       .
       50       v-str = trim (v-str, ",").
       51       if v-str > ''
       52       then
       53         undo, throw new Progress.Lang.AppError( substitute ("Теги &1 не могут иметь неопределное значение", v-str)).
       54       block-code:
       55       for each code where Code.parent    begins "emc"
       56                       and Code.CodeName  eq CodeName
       57       no-lock:
       58          assign
       59             old_parent_ = Code.parent
       60             old_code_   = Code.code
       61          .
       62          leave block-code.
       63       end.
       64       if    code_   ne old_code_
       65          or parent_ ne old_parent_
       66       then do:
       67          find first code where Code.parent eq parent_
       68                            and Code.code   eq code_
       69          no-lock no-error.
       70          if available code
       71          then
       72             undo, throw new Progress.Lang.AppError( substitute("Уже есть запись emctype-code = &1 на дату &2",emctype-code, code_)).
       73       end.
       74     end.
       75   end class.
