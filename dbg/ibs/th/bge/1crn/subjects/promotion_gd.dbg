        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   class ibs.th.bge.1crn.subjects.promotion_gd inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-code as character  no-undo get. private set.
       10     define override property InitTag as character no-undo init "gd"
       11       get.
       12             method override protected void SetPropProtected (inTag as char, inValue as char):
       13       case inTag:
       14         when "gd-code" then gd-code = if inValue >= "" then inValue else "" .
       15       end case.
       16       catch exProErrors as class Progress.Lang.ProError :
       17         case exProErrors:GetMessageNum(1):
       18           when 18207 then undo, throw new Progress.Lang.AppError(
       19             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       20           ) .
       21           otherwise undo, throw new Progress.Lang.AppError(
       22             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       23           ) .
       24         end case .
       25       end catch .
       26     end method.
       27     method override protected void CheckData ():
       28       def var v-str as char no-undo.
       29       assign
       30         v-str = ",gd-code" when gd-code = ?
       31       .
       32       v-str = substring(v-str, 2).
       33       if v-str > "" then undo, throw new Progress.Lang.AppError(
       34         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       35       ) .
       36     end method .
       37     method override protected void ClearSub():
       38       assign
       39         gd-code = ?
       40       .
       41     end method .
       42   end class.
