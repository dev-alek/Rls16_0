        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.cash-doc implements iexpsubject:
        5   define variable vss-include-info0 as character format "X(65)" no-undo
        6   initial "@(#)$Workfile$ $Revision$".
        7   method private void xmlchar-test (input  p-in-string          as character,
        8                                     output p-out-string-enc     as character,
        9                                     output p-out-string-dec    as character):
       10   do
       11   on error undo, return error
       12   :
       13          xmlchar-encode
       14       (
       15             input p-in-string
       16           , output p-out-string-enc
       17       ).
       18          xmlchar-decode
       19       (
       20             input p-out-string-enc
       21           , output p-out-string-dec
       22       ).
       23   end.
       24   end .
       25   method private void xmlchar-encode (input  p-in-string          as character,
       26                                     output p-out-string         as character):
       27       define variable v-position      as integer      no-undo.
       28       define variable v-current-char  as character    no-undo.
       29   do
       30   on error undo, return error
       31   :
       32       assign
       33           p-out-string = "":U
       34       .
       35       case p-in-string
       36       :
       37           when ?
       38           then do:
       39               assign
       40                   p-out-string = "?":U
       41               .
       42           end.
       43           when "?":U
       44           then do:
       45               assign
       46                   p-out-string = "&#63;":U
       47               .
       48           end.
       49           otherwise do:
       50               do v-position = 1 to length( p-in-string )
       51               :
       52                   assign
       53                       v-current-char = substring( p-in-string, v-position, 1 )
       54                   .
       55                   case v-current-char
       56                   :
       57                       when "&":U
       58                       then do:
       59                           assign
       60                               p-out-string = p-out-string + "&amp;":U
       61                           .
       62                       end.
       63                       when ">":U
       64                       then do:
       65                           assign
       66                               p-out-string = p-out-string + "&gt;":U
       67                           .
       68                       end.
       69                       when "<":U
       70                       then do:
       71                           assign
       72                               p-out-string = p-out-string + "&lt;":U
       73                           .
       74                       end.
       75                       when "'":U
       76                       then do:
       77                           assign
       78                               p-out-string = p-out-string + "&apos;":U
       79                           .
       80                       end.
       81                       when '"':U
       82                       then do:
       83                           assign
       84                               p-out-string = p-out-string + "&quot;":U
       85                           .
       86                       end.
       87                       when chr(1)
       88                       then do:
       89                           assign
       90                               p-out-string = p-out-string + "":U
       91                           .
       92                       end.
       93                       when chr(2)
       94                       then do:
       95                           assign
       96                               p-out-string = p-out-string + "":U
       97                           .
       98                       end.
       99                       when chr(3)
      100                       then do:
      101                           assign
      102                               p-out-string = p-out-string + "":U
      103                           .
      104                       end.
      105                       when chr(4)
      106                       then do:
      107                           assign
      108                               p-out-string = p-out-string + "":U
      109                           .
      110                       end.
      111                       when chr(5)
      112                       then do:
      113                           assign
      114                               p-out-string = p-out-string + "":U
      115                           .
      116                       end.
      117                       when chr(6)
      118                       then do:
      119                           assign
      120                               p-out-string = p-out-string + "":U
      121                           .
      122                       end.
      123                       when chr(7)
      124                       then do:
      125                           assign
      126                               p-out-string = p-out-string + "":U
      127                           .
      128                       end.
      129                       when chr(8)
      130                       then do:
      131                           assign
      132                               p-out-string = p-out-string + "":U
      133                           .
      134                       end.
      135                       when chr(9)
      136                       then do:
      137                           assign
      138                               p-out-string = p-out-string + "":U
      139                           .
      140                       end.
      141                       when chr(29)
      142                       then do:
      143                           assign
      144                               p-out-string = p-out-string + "":U
      145                           .
      146                       end.
      147                       when chr(10)
      148                       then do:
      149                           assign
      150                               p-out-string = p-out-string + "&#10;":U
      151                           .
      152                       end.
      153                       when chr(13)
      154                       then do:
      155                           assign
      156                               p-out-string = p-out-string + "&#13;":U
      157                           .
      158                       end.
      159                       otherwise do:
      160                           assign
      161                               p-out-string = p-out-string + v-current-char
      162                           .
      163                       end.
      164                   end case.
      165               end.
      166           end.
      167       end case.
      168   end.
      169   end .
      170   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      171   define variable p-out-string as character no-undo.
      172       define variable v-position      as integer      no-undo.
      173       define variable v-current-char  as character    no-undo.
      174   do
      175   on error undo, return error
      176   :
      177       assign
      178           p-out-string = "":U
      179       .
      180       case p-in-string
      181       :
      182           when ?
      183           then do:
      184               assign
      185                   p-out-string = "?":U
      186               .
      187           end.
      188           otherwise do:
      189               do v-position = 1 to length( p-in-string )
      190               :
      191                   assign
      192                       v-current-char = substring( p-in-string, v-position, 1 )
      193                   .
      194                   case v-current-char
      195                   :
      196                       when chr(1)
      197                       then do:
      198                           assign
      199                               p-out-string = p-out-string + " ":U
      200                           .
      201                       end.
      202                       when chr(2)
      203                       then do:
      204                           assign
      205                               p-out-string = p-out-string + " ":U
      206                           .
      207                       end.
      208                       when chr(3)
      209                       then do:
      210                           assign
      211                               p-out-string = p-out-string + " ":U
      212                           .
      213                       end.
      214                       when chr(4)
      215                       then do:
      216                           assign
      217                               p-out-string = p-out-string + " ":U
      218                           .
      219                       end.
      220                       when chr(5)
      221                       then do:
      222                           assign
      223                               p-out-string = p-out-string + " ":U
      224                           .
      225                       end.
      226                       when chr(6)
      227                       then do:
      228                           assign
      229                               p-out-string = p-out-string + " ":U
      230                           .
      231                       end.
      232                       when chr(7)
      233                       then do:
      234                           assign
      235                               p-out-string = p-out-string + " ":U
      236                           .
      237                       end.
      238                       when chr(8)
      239                       then do:
      240                           assign
      241                               p-out-string = p-out-string + " ":U
      242                           .
      243                       end.
      244                       when chr(9)
      245                       then do:
      246                           assign
      247                               p-out-string = p-out-string + " ":U
      248                           .
      249                       end.
      250                       when chr(29)
      251                       then do:
      252                           assign
      253                               p-out-string = p-out-string + " ":U
      254                           .
      255                       end.
      256                       when chr(10)
      257                       then do:
      258                           assign
      259                               p-out-string = p-out-string + " ":U
      260                           .
      261                       end.
      262                       when chr(13)
      263                       then do:
      264                           assign
      265                               p-out-string = p-out-string + " ":U
      266                           .
      267                       end.
      268                       otherwise do:
      269                           assign
      270                               p-out-string = p-out-string + v-current-char
      271                           .
      272                       end.
      273                   end case.
      274               end.
      275           end.
      276       end case.
      277   end.
      278   return p-out-string.
      279   end .
      280   method private void xmlchar-decode (input  p-in-string          as character,
      281                                     output p-out-string         as character):
      282       define variable v-position      as integer      no-undo.
      283       define variable v-last-position as integer      no-undo.
      284       define variable v-temp-integer  as integer      no-undo.
      285       define variable v-current-char  as character    no-undo.
      286       define variable v-next-char     as character    no-undo.
      287       define variable v-success       as logical      no-undo.
      288   do
      289   on error undo, return error
      290   :
      291       assign
      292           p-out-string = "":U
      293           v-position   = 0
      294       .
      295       replace-cycle:
      296       do while yes
      297       on error undo, return error
      298       :
      299           assign
      300               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      301           .
      302           if v-last-position <= v-position
      303           then do:
      304               if v-position = 0
      305               then do:
      306                   assign
      307                       p-out-string = p-in-string
      308                   .
      309               end.
      310               else do:
      311                   assign
      312                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      313                   .
      314               end.
      315               leave replace-cycle.
      316           end.
      317           else do:
      318               assign
      319                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      320                   v-position      = v-last-position
      321                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      322               .
      323               if v-current-char = "#":U
      324               then do:
      325                   assign
      326                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      327                   .
      328                   if v-last-position > 0
      329                   then do:
      330                       xmlchar-read-integer
      331                        (
      332                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      333                           , output v-temp-integer
      334                           , output v-success
      335                       ).
      336                       if v-success = yes
      337                       and v-temp-integer >= 1
      338                       and v-temp-integer <= 255
      339                       then do:
      340                           assign
      341                               p-out-string = p-out-string + chr( v-temp-integer )
      342                               v-position   = v-last-position + 1
      343                           .
      344                       end.
      345                       else do:
      346                           assign
      347                               p-out-string = p-out-string + "&":U
      348                               v-position   = v-position   + 1
      349                           .
      350                       end.
      351                   end.
      352                   else do:
      353                       assign
      354                           p-out-string = p-out-string + "&":U
      355                           v-position   = v-position   + 1
      356                       .
      357                   end.
      358               end.
      359               else do:
      360                   case substring( p-in-string, v-position + 1, 3 )
      361                   :
      362                       when "lt;":U
      363                       then do:
      364                           assign
      365                               p-out-string = p-out-string + "<":U
      366                               v-position   = v-position   + 3
      367                           .
      368                       end.
      369                       when "gt;":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + ">":U
      373                               v-position   = v-position   + 3
      374                           .
      375                       end.
      376                       otherwise do:
      377                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      378                           then do:
      379                               assign
      380                                   p-out-string = p-out-string + "&":U
      381                                   v-position   = v-position   + 4
      382                               .
      383                           end.
      384                           else do:
      385                               case substring( p-in-string, v-position + 1, 5 )
      386                               :
      387                                   when "quot;":U
      388                                   then do:
      389                                       assign
      390                                           p-out-string = p-out-string + '"':U
      391                                           v-position   = v-position   + 5
      392                                       .
      393                                   end.
      394                                   when "apos;":U
      395                                   then do:
      396                                       assign
      397                                           p-out-string = p-out-string + "'":U
      398                                           v-position   = v-position   + 5
      399                                       .
      400                                   end.
      401                                   otherwise do:
      402                                       assign
      403                                           p-out-string = p-out-string + "&":U
      404                                       .
      405                                   end.
      406                               end case.
      407                           end.
      408                       end.
      409                   end case.
      410               end.
      411           end.
      412       end.
      413   end.
      414   end .
      415   method private void xmlchar-read-integer (input  p-input-string       as character,
      416                                             output p-output-integer     as integer,
      417                                             output p-success            as logical):
      418   do
      419   on error undo, return error
      420   :
      421       assign
      422           p-output-integer = integer( p-input-string )
      423       no-error.
      424       if error-status :error
      425       then do:
      426           assign
      427               p-success           = no
      428               p-output-integer    = 0
      429           .
      430       end.
      431       else do:
      432           assign
      433               p-success           = yes
      434           .
      435       end.
      436   end.
      437   end.
      438     define temp-table tt-coins no-undo XML-NODE-NAME "coins" serialize-name  "coins"
      439     field id       as decimal
      440     field qnty     as decimal
      441     field sum-qnty as decimal
      442     index pi is primary unique id desc.
      443   define temp-table tt-banknots no-undo XML-NODE-NAME "banknots" serialize-name  "banknots"
      444     field id       as integer
      445     field qnty     as integer
      446     field sum-qnty as integer
      447     index pi is primary unique id desc.
      448   define temp-table tt-cover-sheet no-undo
      449     field num-bag      as character
      450     field depos-code   as integer
      451     field depos-bank   as character
      452     field repos-code   as integer
      453     field repos-bank   as character
      454     field pin02        as character
      455     field source_      as character
      456     field total-sum    as decimal
      457     index pi num-bag
      458   .
      459   define dataset ds-banknots XML-NODE-NAME "money" serialize-name  "money" for tt-banknots,
      460     tt-coins .
      461   define         variable hQueryCoins                           as handle                                         no-undo .
      462   define         variable hQueryBanknot                         as handle                                         no-undo .
      463   method private handle add_Coints():
      464      define variable v-list-coints as character no-undo .
      465      define variable ii            as integer   no-undo .
      466      v-list-coints = "10;5;2;1;0.5;0.1;0.05" .
      467       define variable ddd as decimal no-undo.
      468       do ii = 1 to num-entries (v-list-coints,";"):
      469         find first tt-coins where tt-coins.id       = decimal (entry(ii,v-list-coints,";"))
      470         no-error.
      471         if not available tt-coins
      472         then do:
      473            create tt-coins .
      474            assign
      475              tt-coins.id       = decimal(entry(ii,v-list-coints,";"))
      476              tt-coins.qnty     = 0
      477              tt-coins.sum-qnty = 0
      478              .
      479          end.
      480       end.
      481   end.
      482   method private handle getq_Coints():
      483   if valid-handle(hQueryCoins)  then delete object hQueryCoins.
      484       create query hQueryCoins.
      485       hQueryCoins:set-buffers(buffer tt-coins:HANDLE).
      486       hQueryCoins:query-prepare("FOR EACH tt-coins by tt-coins.id desc").
      487       hQueryCoins:query-open.
      488       return hQueryCoins.
      489   end.
      490   method private handle add_Banknot():
      491      define variable v-list-banknot as character no-undo .
      492      define variable ii             as integer   no-undo .
      493      v-list-banknot = "5000;2000;1000;500;200;100;50;10" .
      494       do ii = 1 to num-entries (v-list-banknot,";"):
      495         find first tt-banknots where tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
      496         no-error.
      497         if not available tt-banknots
      498         then do:
      499            create tt-banknots .
      500            assign
      501              tt-banknots.id       = integer(entry(ii,v-list-banknot,";"))
      502              tt-banknots.qnty     = 0
      503              tt-banknots.sum-qnty = 0
      504              .
      505          end.
      506       end.
      507   end.
      508   method private handle getq_Banknot():
      509      if valid-handle(hQueryBanknot)  then delete object hQueryBanknot.
      510       create query hQueryBanknot.
      511       hQueryBanknot:set-buffers(buffer tt-banknots:HANDLE).
      512       hQueryBanknot:query-prepare("FOR EACH tt-banknots by tt-banknots.id desc").
      513       hQueryBanknot:query-open.
      514       return hQueryBanknot.
      515   end.
      516     define temp-table tt-fin-doc like ub.c-fin-doc .
      517     define temp-table tt-fin-doc-tax like ub.c-fin-doc-tax .
      518     define temp-table tt-fin-doc-attr no-undo
      519       field fin-doc      as integer
      520       field sumka        as character
      521       field banknote     as character
      522       field bank-resive  as integer
      523       field bank-deposit as integer
      524       field pin          as character
      525       field source_      as character
      526       field contr-kb     as character init ?
      527       index pi fin-doc
      528       .
      529     define property Msg as character no-undo
      530       get.
      531       private set.
      532     define property InitSecTag as character no-undo init "cash"
      533       get.
      534       private set.
      535     define public property sendTableName  as character  no-undo init "fin-doc"
      536       get.
      537     define public property sendOldRowid as rowid  no-undo
      538       get.
      539       set.
      540     define public property sendNewRowid as rowid  no-undo
      541       get.
      542       set.
      543     define property fin-doc as character no-undo
      544       get.
      545       set.
      546     define property del_f  as integer no-undo
      547       get.
      548       set.
      549     define variable sw     as handle    no-undo.
      550     define variable v-type as character no-undo .
      551     define variable CSJson as longchar  no-undo .
      552     method public void CrContentToSW (insw as handle):
      553     define buffer buf_fin-doc       for ub.fin-doc .
      554     define buffer buf_fin-doc-attr  for ub.fin-doc-attr .
      555     define buffer buf_fin-doc-tax   for ub.fin-doc-tax .
      556     define buffer buf_c-fin-doc     for ub.c-fin-doc .
      557     define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax .
      558     define buffer buf_CashBook      for ub.CashBook .
      559       sw = insw .
      560       find first buf_fin-doc no-lock where buf_fin-doc.fin-doc-code = INTEGER (fin-doc) no-error .
      561       if AVAILABLE buf_fin-doc then
      562       do:
      563         sendOldRowid  = rowid(buf_fin-doc).
      564         create tt-fin-doc .
      565         BUFFER-COPY buf_fin-doc to tt-fin-doc .
      566         for each buf_fin-doc-tax no-lock where buf_fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code:
      567           create tt-fin-doc-tax .
      568           BUFFER-COPY buf_fin-doc-tax to tt-fin-doc-tax .
      569         end.
      570       end.
      571       else
      572       do:
      573         find FIRST buf_c-fin-doc no-lock where buf_c-fin-doc.fin-doc-code = INTEGER (fin-doc) no-error .
      574         if AVAILABLE buf_c-fin-doc then
      575         do:
      576           sendOldRowid  = rowid(buf_c-fin-doc).
      577           create tt-fin-doc .
      578           BUFFER-COPY buf_c-fin-doc to tt-fin-doc .
      579           for first buf_c-fin-doc-tax no-lock where buf_c-fin-doc-tax.fin-doc-code = buf_c-fin-doc.fin-doc-code:
      580             create tt-fin-doc-tax .
      581             BUFFER-COPY buf_c-fin-doc-tax to tt-fin-doc-tax .
      582           end.
      583         end.
      584         else
      585         do:
      586           Msg = "Нет финансового документа с номером " + fin-doc .
      587           return error Msg.
      588         end.
      589       end.
      590       case tt-fin-doc.fin-doc-type:
      591         when 'пко':U then
      592           v-type = "1".
      593         when 'рко':U then
      594           v-type = "2".
      595         when ? then
      596           v-type = "".
      597       end.
      598       sw:start-element ("cash-doc") .
      599       sw:write-data-element ("doc-code", string-mth(tt-fin-doc.fin-doc-code)).
      600       sw:write-data-element ("num", if tt-fin-doc.prn-doc-code = ? then "" else string(tt-fin-doc.prn-doc-code)).
      601       sw:write-data-element ("del-f", string(del_f)).
      602       find first buf_CashBook no-lock where buf_CashBook.id = tt-fin-doc.CashBookId no-error .
      603       if available buf_CashBook then do :
      604         if buf_CashBook.ext-code > "" then
      605           sw:write-data-element ("type-kb", buf_CashBook.ext-code).
      606         find first buf_fin-doc-attr no-lock where buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code and buf_fin-doc-attr.host-code = tt-fin-doc.host-code
      607         and buf_fin-doc-attr.attr-code = "contr-kb" no-error .
      608         if available (buf_fin-doc-attr) then
      609         do:
      610            find first tt-fin-doc-attr where tt-fin-doc-attr.fin-doc = buf_fin-doc-attr.fin-doc-code no-error .
      611            if not available (tt-fin-doc-attr) then
      612            do:
      613               create tt-fin-doc-attr .
      614               assign
      615                  tt-fin-doc-attr.fin-doc = buf_fin-doc-attr.fin-doc-code
      616               .
      617            end.
      618            find first cashbook where cashbook.id eq int(buf_fin-doc-attr.attr-value)
      619            no-lock no-error.
      620            if available  cashbook
      621            then
      622               assign
      623                 tt-fin-doc-attr.contr-kb = CashBook.ext-code.
      624               .
      625          end.
      626       end .
      627       find first buf_fin-doc-attr no-lock where buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code and buf_fin-doc-attr.host-code = tt-fin-doc.host-code
      628         and buf_fin-doc-attr.attr-code = "pre-vedom" no-error .
      629       if available (buf_fin-doc-attr) then
      630       do:
      631         find first tt-fin-doc-attr where tt-fin-doc-attr.sumka = entry (1,buf_fin-doc-attr.attr-value,";") no-error .
      632         if not available (tt-fin-doc-attr) then
      633         do:
      634           create tt-fin-doc-attr .
      635           assign
      636             tt-fin-doc-attr.fin-doc = buf_fin-doc-attr.fin-doc-code
      637             .
      638         end.
      639         assign
      640           tt-fin-doc-attr.sumka = entry (1,buf_fin-doc-attr.attr-value,";")
      641           tt-fin-doc-attr.bank-deposit = integer(entry(2,buf_fin-doc-attr.attr-value,";"))
      642           tt-fin-doc-attr.bank-resive  = integer(entry (3,buf_fin-doc-attr.attr-value,";"))
      643           tt-fin-doc-attr.pin          = entry(4,buf_fin-doc-attr.attr-value,";")
      644           tt-fin-doc-attr.source_      = if tt-fin-doc.CashBookId = 0 then "Поступления от продажи товаров" else "Прочие поступления"
      645           .
      646       end.
      647       find first buf_fin-doc-attr no-lock where buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code and buf_fin-doc-attr.host-code = tt-fin-doc.host-code
      648         and buf_fin-doc-attr.attr-code = "cover_sheet" no-error .
      649       if available (buf_fin-doc-attr) then
      650       do:
      651         find first tt-fin-doc-attr where tt-fin-doc-attr.fin-doc = buf_fin-doc-attr.fin-doc-code no-error .
      652         if not available (tt-fin-doc-attr) then
      653         do:
      654           create tt-fin-doc-attr .
      655           assign
      656             tt-fin-doc-attr.fin-doc = buf_fin-doc-attr.fin-doc-code
      657             .
      658         end.
      659         assign
      660           tt-fin-doc-attr.banknote = buf_fin-doc-attr.attr-value
      661           .
      662       end.
      663       sw:write-data-element ("date", if tt-fin-doc.doc-date = ? then "" else ISO-DATE (tt-fin-doc.doc-date)).
      664       sw:write-data-element ("shift-date", if tt-fin-doc.shift-date = ? then "" else ISO-DATE (tt-fin-doc.shift-date)).
      665       sw:write-data-element ("shift-num", string-mth(tt-fin-doc.shift-num)).
      666       sw:write-data-element ("type", v-type).
      667       if v-type = "1"
      668       then do :
      669         if tt-fin-doc.cor-acc-value > "" then
      670           sw:write-data-element ("kredit", tt-fin-doc.cor-acc-value).
      671         if tt-fin-doc.cor-acc1-value > "" then
      672           sw:write-data-element ("debit", tt-fin-doc.cor-acc1-value).
      673       end .
      674       if v-type = "2"
      675       then do :
      676         if tt-fin-doc.cor-acc-value > "" then
      677           sw:write-data-element ("kredit", tt-fin-doc.cor-acc1-value).
      678         if tt-fin-doc.cor-acc1-value > "" then
      679           sw:write-data-element ("debit", tt-fin-doc.cor-acc-value).
      680       end .
      681       sw:write-data-element ("sum", string-mth(tt-fin-doc.sum-doc)).
      682       if v-type = "1" then
      683       do:
      684         sw:write-data-element ("contr-name", if tt-fin-doc.payer-name = ? then "" else string(tt-fin-doc.payer-name)).
      685         sw:write-data-element ("contr-code", string-mth(tt-fin-doc.payer-code)).
      686       end.
      687       else
      688       do:
      689         sw:write-data-element ("contr-name", if tt-fin-doc.receiver-name = ? then "" else string(tt-fin-doc.receiver-name)).
      690         sw:write-data-element ("contr-code", string-mth(tt-fin-doc.receiver-code)).
      691       end.
      692       sw:write-data-element ("doc-osn", if tt-fin-doc.naznach-plat = ? then "" else xmlchar-encode-1c(string(tt-fin-doc.naznach-plat))).
      693       sw:write-data-element ("pril", xmlchar-encode-1c(tt-fin-doc.enclosure)).
      694       sw:write-data-element ("nds-str", if tt-fin-doc.including = ? then "" else xmlchar-encode-1c(string(tt-fin-doc.including))).
      695       sw:write-data-element ("operator", if tt-fin-doc.user-name-doc = ? then "" else user-name(tt-fin-doc.user-name-doc)).
      696       sw:write-data-element ("idty-doc", if tt-fin-doc.payer-dop1 = ? then "" else xmlchar-encode-1c(string(tt-fin-doc.receiver-passport))).
      697       find first tt-fin-doc-attr no-lock where tt-fin-doc-attr.fin-doc = tt-fin-doc.fin-doc-code no-error .
      698       if available (tt-fin-doc-attr) then do:
      699          if     tt-fin-doc-attr.sumka ne ?
      700             and tt-fin-doc-attr.sumka ne ""
      701          then
      702             sw:write-data-element ("sumka", xmlchar-encode-1c(tt-fin-doc-attr.sumka)).
      703          if     tt-fin-doc-attr.bank-resive ne ?
      704             and tt-fin-doc-attr.bank-resive ne 0
      705          then do:
      706             for first ub.fin-bank no-lock where ub.fin-bank.host-code = tt-fin-doc.host-code and
      707                                                  ub.fin-bank.code-bank = tt-fin-doc-attr.bank-resive:
      708             sw:write-data-element ("bank-resive",  string(ub.fin-bank.bik)).
      709             end.
      710          end.
      711          if     tt-fin-doc-attr.source_ ne ?
      712             and tt-fin-doc-attr.source_ ne ""
      713          then
      714             sw:write-data-element ("source",  string(tt-fin-doc-attr.source_)).
      715       end.
      716       find first tt-fin-doc-attr no-lock where tt-fin-doc-attr.fin-doc = tt-fin-doc.fin-doc-code no-error .
      717       if     available tt-fin-doc-attr
      718          and tt-fin-doc-attr.contr-kb ne ?
      719       then do:
      720          sw:write-data-element ("contr-kb",  tt-fin-doc-attr.contr-kb).
      721       end.
      722       sw:start-element ("ndss") .
      723       for each tt-fin-doc-tax no-lock where tt-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code:
      724         sw:start-element ("nds") .
      725         sw:write-data-element ("sum", string-mth(tt-fin-doc-tax.sum-line-doc)).
      726         sw:write-data-element ("nds-code", string-mth(tt-fin-doc-tax.vat-pc)).
      727         sw:write-data-element ("sum-nds", string-mth(tt-fin-doc-tax.sum-vat-line-doc)).
      728         sw:end-element ("nds") .
      729       end.
      730       sw:end-element ("ndss")  .
      731       sw:END-ELEMENT ("cash-doc") .
      732     end method.
      733     method private character string-mth (inValue as decimal):
      734       def var v-str as character no-undo.
      735       if inValue = ?
      736         then v-str = "0".
      737       if string (inValue) begins "."
      738         then v-str = "0" + string (inValue).
      739       else v-str = string (inValue).
      740       return v-str.
      741     end.
      742     method private character  user-name   (v-user-code as character):
      743       define variable v-user-name as character no-undo .
      744       define buffer buf_user-account for ub.user-account .
      745       find first buf_user-account no-lock
      746         where buf_user-account.user-id = v-user-code
      747         no-error .
      748       if not available buf_user-account
      749         then
      750       do:
      751         assign
      752           v-user-name = string(v-user-code)
      753           .
      754       end.
      755       else
      756       do:
      757         assign
      758           v-user-name = buf_user-account.nik
      759           .
      760       end.
      761       return v-user-name.
      762     end.
      763   end class.
