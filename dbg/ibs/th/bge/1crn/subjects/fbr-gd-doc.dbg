      464                       end.
      465                       when chr(13)
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + " ":U
      469                           .
      470                       end.
      471                       otherwise do:
      472                           assign
      473                               p-out-string = p-out-string + v-current-char
      474                           .
      475                       end.
      476                   end case.
      477               end.
      478           end.
      479       end case.
      480   end.
      481   return p-out-string.
      482   end .
      483   method private void xmlchar-decode (input  p-in-string          as character,
      484                                     output p-out-string         as character):
      485       define variable v-position      as integer      no-undo.
      486       define variable v-last-position as integer      no-undo.
      487       define variable v-temp-integer  as integer      no-undo.
      488       define variable v-current-char  as character    no-undo.
      489       define variable v-next-char     as character    no-undo.
      490       define variable v-success       as logical      no-undo.
      491   do
      492   on error undo, return error
      493   :
      494       assign
      495           p-out-string = "":U
      496           v-position   = 0
      497       .
      498       replace-cycle:
      499       do while yes
      500       on error undo, return error
      501       :
      502           assign
      503               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      504           .
      505           if v-last-position <= v-position
      506           then do:
      507               if v-position = 0
      508               then do:
      509                   assign
      510                       p-out-string = p-in-string
      511                   .
      512               end.
      513               else do:
      514                   assign
      515                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      516                   .
      517               end.
      518               leave replace-cycle.
      519           end.
      520           else do:
      521               assign
      522                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      523                   v-position      = v-last-position
      524                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      525               .
      526               if v-current-char = "#":U
      527               then do:
      528                   assign
      529                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      530                   .
      531                   if v-last-position > 0
      532                   then do:
      533                       xmlchar-read-integer
      534                        (
      535                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      536                           , output v-temp-integer
      537                           , output v-success
      538                       ).
      539                       if v-success = yes
      540                       and v-temp-integer >= 1
      541                       and v-temp-integer <= 255
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + chr( v-temp-integer )
      545                               v-position   = v-last-position + 1
      546                           .
      547                       end.
      548                       else do:
      549                           assign
      550                               p-out-string = p-out-string + "&":U
      551                               v-position   = v-position   + 1
      552                           .
      553                       end.
      554                   end.
      555                   else do:
      556                       assign
      557                           p-out-string = p-out-string + "&":U
      558                           v-position   = v-position   + 1
      559                       .
      560                   end.
      561               end.
      562               else do:
      563                   case substring( p-in-string, v-position + 1, 3 )
      564                   :
      565                       when "lt;":U
      566                       then do:
      567                           assign
      568                               p-out-string = p-out-string + "<":U
      569                               v-position   = v-position   + 3
      570                           .
      571                       end.
      572                       when "gt;":U
      573                       then do:
      574                           assign
      575                               p-out-string = p-out-string + ">":U
      576                               v-position   = v-position   + 3
      577                           .
      578                       end.
      579                       otherwise do:
      580                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      581                           then do:
      582                               assign
      583                                   p-out-string = p-out-string + "&":U
      584                                   v-position   = v-position   + 4
      585                               .
      586                           end.
      587                           else do:
      588                               case substring( p-in-string, v-position + 1, 5 )
      589                               :
      590                                   when "quot;":U
      591                                   then do:
      592                                       assign
      593                                           p-out-string = p-out-string + '"':U
      594                                           v-position   = v-position   + 5
      595                                       .
      596                                   end.
      597                                   when "apos;":U
      598                                   then do:
      599                                       assign
      600                                           p-out-string = p-out-string + "'":U
      601                                           v-position   = v-position   + 5
      602                                       .
      603                                   end.
      604                                   otherwise do:
      605                                       assign
      606                                           p-out-string = p-out-string + "&":U
      607                                       .
      608                                   end.
      609                               end case.
      610                           end.
      611                       end.
      612                   end case.
      613               end.
      614           end.
      615       end.
      616   end.
      617   end .
      618   method private void xmlchar-read-integer (input  p-input-string       as character,
      619                                             output p-output-integer     as integer,
      620                                             output p-success            as logical):
      621   do
      622   on error undo, return error
      623   :
      624       assign
      625           p-output-integer = integer( p-input-string )
      626       no-error.
      627       if error-status :error
      628       then do:
      629           assign
      630               p-success           = no
      631               p-output-integer    = 0
      632           .
      633       end.
      634       else do:
      635           assign
      636               p-success           = yes
      637           .
      638       end.
      639   end.
      640   end.
      641   define variable mMRCCode  as logical    no-undo.
      642   define variable mTypeMark as character  no-undo.
      643   method private logical IS-NeedMark
      644   ( input ib-code as integer  ,
      645     input ib-str as character ):
      646      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      647      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      648                                    and buf_prod-bc-attr.b-str  eq ib-str
      649                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      650        no-lock no-error.
      651      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      652   end.
      653   method private character repTegforDm
      654   (iDM as char ):
      655       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      656       define variable vteg as character no-undo.
      657       define variable oDM as character no-undo.
      658       define variable vi as integer no-undo.
      659       oDM = iDm.
      660       do vi = 1 to num-entries(vTeglist):
      661          vTeg = entry(vi,vTeglist).
      662          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      663       end.
      664       return oDM.
      665   end.
      666   method private character repSpecSimbforDm
      667   (iDM as char ):
      668       define variable oDM as character no-undo.
      669       xmlchar-decode(iDM, output oDM).
      670     return repTegforDm (oDM).
      671   end.
      672   method private logical CheckGtin
      673   (iGtin as char):
      674      define variable bar_code as character no-undo.
      675      define variable vGtin as logical no-undo init "yes".
      676      if length(iGtin) eq 14
      677      then do:
      678         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      679         run str/chk-sum.p
      680          (input-output bar_code ) no-error .
      681         if iGtin ne  bar_code
      682         then
      683            vGtin = no.
      684      end.
      685      else
      686         vGtin = no.
      687      return vgtin.
      688   end.
      689   method private character repSpecSimbforXlm
      690   (iDM as char ):
      691       iDM = replace(iDM,chr(29),"").
      692       return iDM.
      693   end.
      694   method private character getGtinByDM
      695   (IDM as char):
      696      define variable VTXT as char no-undo.
      697      define variable vGtin as char no-undo.
      698      vTXt = IdM.
      699      vGtin = IDM.
      700      if    length(vtxt) > 14
      701      then do:
      702         if   vtxt begins "(01)"
      703                or vtxt begins "(02)"
      704         then
      705            vGtin = substring(vtxt,5,14).
      706         else if   (vtxt begins "01"
      707                or vtxt begins "02" )
      708                and (   (    substring(iDm,17,2) eq "21"
      709                         and length(vtxt) >= 21)
      710                     or substring(iDm,17,2) eq "37"
      711                     or substring(iDm,17,4) eq "(37)" )
      712         then do:
      713            vGtin = substring(vtxt,3,14).
      714            if not checkGtin(vGtin)
      715            then
      716               vGtin = substring(vtxt,1,14).
      717         end.
      718         else if     length(vtxt) eq 14 + 7 + 4 + 4
      719             or length(vtxt) eq 14 + 7 + 4
      720             or length(vtxt) eq 14 + 7
      721         then
      722            vGtin = substring(vtxt,1,14).
      723      end.
      724      if not checkGtin(vGtin)
      725      then
      726         vGtin = "".
      727      return vgtin.
      728   end.
      729   method private integer getGdsCodeByGtin
      730   (iGtin as char):
      731      define buffer prod-bc  for ub.prod-bc.
      732      define buffer bar-code for ub.bar-code.
      733      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      734      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      735      return if avail bar-code then bar-code.gds-code else ?.
      736   end.
      737   method private decimal getQntyCodeByGtin
      738   (iGtin as char):
      739      define buffer prod-bc  for ub.prod-bc.
      740      define buffer bar-code for ub.bar-code.
      741      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      742      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      743      return if avail bar-code then bar-code.cli-base-rate else ?.
      744   end.
      745   method private integer getGdsCodeByDM
      746   (iDm as char):
      747      define variable vGtin as char no-undo.
      748      define buffer prod-bc for ub.prod-bc.
      749      vGtin  = getGtinByDM (IDM ).
      750      return getGdsCodeByGtin (vGtin).
      751   end.
      752   method private logical ChekTypeMarkByGds
      753   (iGds-code as integer ):
      754      define buffer goods-attr for ub.goods-attr.
      755      find first goods-attr where goods-attr.gds-code   = iGds-code
      756                              and goods-attr.attr-code  = 'mark-type':U
      757      no-lock no-error.
      758      if available goods-attr
      759      then do:
      760         mTypeMark = goods-attr.attr-value.
      761         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      762           .
      763      end.
      764      else
      765         return no.
      766   end.
      767   method private logical ChekTypeMarkByDm
      768   (iDM as char ):
      769      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      770   end.
      771   method private logical ChekTypeMarkByGtin
      772   (iGtin as char ):
      773      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      774   end.
      775   method private character  GetNextElement
      776     (input iAllTeg        as logical
      777     ,output oteg          as character
      778     ,output otegval       as character
      779     ,input-output pstr    as character
      780      ):
      781        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      782        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      783        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      784        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      785        define variable vTeg as character no-undo.
      786        define variable vLength as integer no-undo.
      787        define variable vi as integer no-undo.
      788        define variable vj as integer no-undo.
      789        define buffer code for ub.code.
      790        find first code where Code.parent eq "MarkType"
      791                          and Code.CodeValue   eq mTypeMark
      792                          no-lock no-error.
      793        if     available code
      794           and Code.misc1 ne ""
      795           and Code.misc1 ne ?
      796        then do:
      797           integer (Code.misc1) no-error.
      798           if not error-status:error
      799           then
      800             entry (4,vlistleng) = Code.misc1.
      801        end.
      802        if iAllTeg
      803        then
      804           assign
      805              vlistElem     = vlistElem    + vlistElemDop
      806              vlistleng     = vlistleng    + vlistlengDop
      807           .
      808        else if mMRCCode
      809        then
      810           assign
      811              vlistElem     = vlistElem    + ",(8005),8005"
      812              vlistleng     = vlistleng    + ",000006,0006"
      813           .
      814       block-elem:
      815       do vi = 1 to num-entries(vlistElem):
      816          vTeg = entry(vi,vlistElem).
      817          if pstr begins vTeg
      818          then do:
      819             if    vTeg eq "21"
      820             then
      821                vLength = index(pstr,chr(29)) - 2 no-error.
      822             if vLength  <= 0
      823             then
      824                vLength = int(entry(vi,vlistleng)).
      825             otegval = substring (pstr,length(vteg) + 1, vLength).
      826             oteg = replace(replace(vteg,")",""),"(","").
      827             vTeg = vteg + otegval.
      828             otegval = replace(otegval,chr(29),"").
      829             oteg = replace(replace(oteg,")",""),"(","").
      830             pstr = substring (pstr,length(vTeg)+ 1).
      831             vTeg = replace(vTeg,chr(29),"").
      832             leave block-elem.
      833          end.
      834          else
      835             vTeg = "".
      836       end.
      837       return vteg.
      838   end.
      839   method private character  GetCodeIdent
      840   (iDm as char):
      841      define variable Velement   as character no-undo init "first".
      842      define variable oCodeIdent as character no-undo.
      843      define variable vteg as character no-undo.
      844      define variable vtegval as character no-undo.
      845      define variable vGtin as character no-undo.
      846      define buffer marking for ub.marking.
      847      for first marking no-lock where
      848                marking.mark eq iDm
      849            and marking.unit-ext = "LEVEL2"
      850      :
      851        return iDm.
      852      end.
      853      vGtin  = getGtinByDM (iDm ).
      854      ChekTypeMarkByDm(idm).
      855      if iDm begins 'tech_':U
      856      then
      857         oCodeIdent = iDm.
      858      else if length(iDm) < 21
      859      then do:
      860         find first marking where marking.mark eq idm
      861         no-lock no-error.
      862         oCodeIdent = if available marking then marking.mark else  ?.
      863      end.
      864      else if     length(iDm) eq 29
      865         and not iDm begins "01"
      866         and not iDm begins "02"
      867      then
      868         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      869      else  if     length(iDm) >= 24
      870               and (  iDm begins "01"
      871                   or iDm begins "02")
      872               and  substring(iDm,17,2) ne "21"
      873      then do:
      874         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      875                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      876         then
      877            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      878         else
      879            oCodeIdent = iDM.
      880      end.
      881      else  if     (   length(iDm) eq 25
      882                    or length(iDm) eq 21)
      883               and (not iDm begins "01"
      884               and  not iDm begins "02")
      885      then
      886         oCodeIdent = substring(iDm,1,21).
      887      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      888      then
      889         oCodeIdent = substring(iDm,1,21).
      890      else do while Velement ne "" and idm ne "":
      891         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      892         oCodeIdent = oCodeIdent + Velement.
      893      end.
      894      return oCodeIdent.
      895   end.
      896   method private character  GetTegCod
      897   (icodeIdent as char, iTeg as char):
      898      define variable Velement   as character no-undo init "first".
      899      define variable oTeg as character no-undo init ?.
      900      define variable vteg as character no-undo.
      901      define variable vtegval as character no-undo.
      902      if     ((length(icodeIdent) eq 21
      903         and not icodeIdent begins "01"
      904         and not icodeIdent begins "02")
      905         or
      906             ( length(icodeIdent) eq 25
      907               and not icodeIdent begins "01"
      908               and not icodeIdent begins "02"))
      909      then do:
      910         if iTeg eq "01" or iTeg eq "02"
      911         then
      912            oTeg = substring(icodeIdent,1,21).
      913         else  if  iTeg eq "21"
      914         then
      915            oTeg = substring(icodeIdent,15,7).
      916      end.
      917      else do:
      918         ChekTypeMarkByDm(icodeIdent).
      919         block-teg:
      920            do while Velement ne "" and icodeIdent ne "":
      921            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      922            if    Velement begins iTeg
      923               or Velement begins "(" + iTeg + ")"
      924            then do:
      925               oTeg = vtegval.
      926               leave block-teg.
      927            end.
      928         end.
      929      end.
      930      return oTeg.
      931   end.
      932   method private logical isOAD
      933   (icodeIdent as character):
      934      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      935   end.
      936   method private logical isMark
      937   (icodeIdent as character):
      938      define buffer buf_marking for ub.marking.
      939      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      940             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      941   end.
      942   method private character  addBracketForCode
      943   (icodeIdent as char):
      944      define variable Velement   as character no-undo init "first".
      945      define variable oTeg as character no-undo.
      946      define variable vteg as character no-undo.
      947      define variable vtegval as character no-undo.
      948      define buffer marking for ub.marking.
      949      find first marking no-lock where
      950                 marking.mark begins icodeIdent no-error.
      951      if    not ChekTypeMarkByDm(icodeIdent)
      952         or length(icodeIdent) le 24
      953         or (avail marking and marking.unit-ext = "LEVEL2")
      954      then
      955         oTeg = icodeIdent.
      956      else do:
      957         if (  icodeIdent begins "01"
      958            or icodeIdent begins "02"
      959            ) and CheckGtin(substring (icodeIdent,3,14))
      960            and substring (icodeIdent,17,2) eq "21"
      961         then do:
      962            mMRCCode = yes.
      963            ChekTypeMarkByDm(icodeIdent).
      964            block-teg:
      965            do while Velement ne "" and icodeIdent ne "":
      966               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      967               if vteg ne ""
      968               then
      969                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      970            end.
      971            mMRCCode = no.
      972         end.
      973         else do:
      974            oTeg = icodeIdent.
      975         end.
      976      end.
      977      return oTeg.
      978   end.
      979   method private integer getlevelByCodId
      980   (iCode as char):
      981      define variable vLength as int no-undo.
      982      define variable vLevel  as int no-undo.
      983      if not ChekTypeMarkByDM (icode) then return ?.
      984      vLength = length(iCode).
      985      if    vLength eq 18
      986         or vLength eq 20
      987      then
      988         Vlevel = 4.
      989      else if vLength eq 21
      990      then
      991         Vlevel = 1.
      992      else if vLength eq 25
      993      then do:
      994         if  iCode begins "01"
      995         then
      996            Vlevel = 3.
      997         else
      998            Vlevel = 1.
      999      end.
     1000      else if     vLength >= 26
     1001              and vLength <= 46
     1002      then do:
     1003         if    substring(iCode,17,2) eq "11"
     1004            or substring(iCode,17,2) eq "13"
     1005            or (    substring(iCode,17,2) eq "21"
     1006                and vLength >= 33
     1007                and substring(iCode,26,4) ne "8005")
     1008         then
     1009            Vlevel = 4.
     1010         else if    vLength eq 31
     1011                 or vLength eq 38
     1012                 or vLength eq 39
     1013                 or vLength eq 45
     1014         then
     1015            Vlevel = 1.
     1016         else if    vLength eq 35
     1017                 or vLength eq 43
     1018         then
     1019            Vlevel = 3.
     1020         else
     1021            Vlevel = ?.
     1022      end.
     1023      else
     1024         Vlevel = ?.
     1025      return Vlevel.
     1026   end.
     1027   method private character  getLevelMotpBycodid
     1028   (iDm as char):
     1029      define variable vLevel as integer no-undo.
     1030      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1031      vLevel = getlevelByCodId(iDm).
     1032      if    vLevel eq ?
     1033         or vLevel < 1
     1034         or vLevel > 6
     1035      then
     1036         return ?.
     1037      else
     1038         return entry(vlevel,vList).
     1039   end.
     1040   method private character    getLevelUTDByLevelMotp
     1041   (iUnit as char):
     1042      define variable vLevel as integer no-undo.
     1043      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1044      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1045      vLevel = lookup(iUnit,vListMOTP).
     1046      if    vLevel eq ?
     1047         or vLevel < 1
     1048         or vLevel > 4
     1049      then
     1050         return ?.
     1051      else
     1052         return entry(vlevel,vListutd).
     1053   end.
     1054   method private character  getLevelMotpByDM
     1055   (iDm as char):
     1056      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1057   end.
     1058   method private character  getLevelUTDByCodId
     1059   (iDm as char):
     1060      define variable vLevel as integer no-undo.
     1061      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1062      vLevel = getlevelByCodId(iDm).
     1063      if    vLevel eq ?
     1064         or vLevel < 1
     1065         or vLevel > 4
     1066      then
     1067         return ?.
     1068      else
     1069         return entry(vlevel,vList).
     1070   end.
     1071   method private character  getLevelUTDByDM
     1072   (iDm as char):
     1073      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1074   end.
     1075   define variable mNotMarkQnty as logical no-undo.
     1076   method private decimal getQntyUTDByCodId
     1077   (iDM as char):
     1078      define variable vLevel as integer no-undo.
     1079      define variable vList as character no-undo init "1,5,10,500".
     1080      define variable vGtin as character no-undo.
     1081      define variable vqnty as decimal no-undo init ?.
     1082      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1083      if vqnty eq ?
     1084      then do:
     1085         if not mNotMarkQnty
     1086         then do:
     1087            define buffer marking for ub.marking.
     1088            define variable vCodident as character no-undo.
     1089            vCodident = GetCodeIdent(idm).
     1090            find first marking where marking.mark begins vCodident no-lock no-error.
     1091            if     available marking
     1092               and marking.box-qnty ne ?
     1093            then
     1094               return marking.box-qnty.
     1095         end.
     1096         vGtin = getGtinByDm(iDM).
     1097         if ChekTypeMarkByGtin (vGtin)
     1098         then do:
     1099            vLevel = getlevelByCodId(iDM).
     1100            if     vLevel >= 1
     1101               and vLevel <= 4
     1102            then
     1103               vqnty = int(entry(vlevel,vList)).
     1104         end.
     1105         else
     1106            vqnty = getQntyCodeByGtin(vgtin).
     1107      end.
     1108      return vqnty.
     1109   end.
     1110   method private decimal getQntyUTDByDM
     1111   (iDm as char):
     1112      define variable vDM as character no-undo.
     1113      if     length (iDm) ne 25
     1114         and length (iDm) ne 29
     1115         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1116      then
     1117         vDM = substring (iDm,1,length (iDm) - 6 ).
     1118      else
     1119         vDM = substring (iDm,1,length (iDm) - 4 ).
     1120      return getQntyUTDByCodId(vDM).
     1121   end.
     1122   method private decimal    getMRC4
     1123   (iMRC as char):
     1124      define variable oMrc     as decimal no-undo init ?.
     1125      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1126      define variable vi       as integer no-undo.
     1127      define variable vfound   as integer no-undo.
     1128      define variable vposStart   as integer no-undo.
     1129      do:
     1130      OMRc = 0.
     1131      do vi = 1 to 4:
     1132         define variable vsimb as character no-undo.
     1133         vsimb = substring(iMRC,vi,1).
     1134         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1135         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1136         if vfound > 0
     1137         then
     1138            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1139         end.
     1140         OMRc = OMRc / 100.
     1141      end.
     1142      return OMRc.
     1143   end.
     1144   method private decimal    getMRCByDM
     1145   (iDm as char):
     1146      define variable vMRC     as character no-undo.
     1147      define variable oMrc     as decimal no-undo init ?.
     1148      define variable Velement as character no-undo init "empty".
     1149      define variable vteg as character no-undo.
     1150      define variable vtegval as character no-undo.
     1151      if    length(idm) eq 14 + 7 + 4 + 4
     1152         or length(idm) eq 14 + 7 + 4
     1153      then do:
     1154         vMRC = substring(idm,22,4).
     1155         omrc = getMRC4(vMRC).
     1156      end.
     1157      else do:
     1158          ChekTypeMarkByDm(iDm).
     1159          block-mrc:
     1160          do while Velement ne "" and idm ne "":
     1161             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1162             if Velement begins "8005"
     1163             then do:
     1164                vMRC = substring(Velement,5,6).
     1165                leave block-mrc.
     1166             end.
     1167             else if Velement begins "(8005)"
     1168             then do:
     1169                vMRC = substring(Velement,7,6).
     1170                leave block-mrc.
     1171             end.
     1172          end.
     1173          if vMRC ne ""
     1174          then
     1175             OMRc = dec(vmrc) / 100 no-error.
     1176      end.
     1177      return OMRc.
     1178   end.
     1179   method private date    MoveDate
     1180   (idate as date,
     1181    iMonth as int64):
     1182      define variable vMonth   as int64 no-undo.
     1183      define variable vYear    as int64 no-undo.
     1184      define variable vDateNew as date  no-undo.
     1185       define variable vDay     as int64 no-undo.
     1186       vMonth = month(iDate) + iMonth.
     1187       vYear =  year(iDate).
     1188       if vMonth <= 0
     1189       then assign
     1190          vMonth = vMonth + 12
     1191           vYear  = vYear - 1
     1192       .
     1193       else if vMonth > 12
     1194       then assign
     1195          vMonth = vMonth - 12
     1196           vYear  = vYear + 1
     1197       .
     1198       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1199       do while error-status:error eq yes:
     1200          VDay = vDay + 1.
     1201          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1202       end.
     1203       if VDay > 0
     1204       then
     1205          vDateNew + 1.
     1206       return vDateNew.
     1207   end.
     1208   method private logical    checkEMRC
     1209   (input  iDm as char,
     1210    output vOk as logical):
     1211      define variable v-value-emrc as character no-undo.
     1212      define variable v-type-emrc  as character no-undo.
     1213      define variable vDateIso     as character no-undo.
     1214      define variable vMRC         as decimal no-undo.
     1215      define variable vqnty        as decimal no-undo.
     1216      define variable vPrice       as decimal no-undo.
     1217      define variable vparent      as character no-undo.
     1218      define variable vgds-code    as integer no-undo.
     1219      define buffer code for ub.code.
     1220      vMRC = getMRCByDM(iDm).
     1221      if vMRC > 0
     1222      then do:
     1223         vgds-code = getGdsCodeByDM(iDm).
     1224         vqnty     = getQntyUTDByDM(iDm).
     1225               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1226            (
     1227             input   vgds-code
     1228            ,input   'emrc-type':U
     1229            ,output   v-value-emrc
     1230            ,output   v-type-emrc
     1231          ) no-error.
     1232          if     v-value-emrc ne ""
     1233             and v-value-emrc ne ?
     1234          then do:
     1235             vDateIso = iso-date(today).
     1236             vPrice = vMRC / vqnty.
     1237             vparent ="emc" + chr(4) + v-value-emrc.
     1238             find last code where Code.parent      eq vparent
     1239                              and Code.code        le vDateIso
     1240                              and code.status_  eq 0
     1241             no-lock no-error.
     1242             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1243             then
     1244                vOk = true .
     1245             else do:
     1246                 define variable vText      as character no-undo.
     1247                 define variable vDate      as date no-undo.
     1248                 define variable vDateLast  as character no-undo.
     1249                 define variable vDateFirst as character no-undo.
     1250                 define variable vDate3     as date no-undo.
     1251                 vdate = date(code.misc1).
     1252                 vDateLast = code.misc1.
     1253                 vDate3 = MoveDate(today, - 3 ).
     1254                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1255                                      string(vDate3  , "99/99/9999"),
     1256                                      string(vDate   , "99/99/9999")
     1257                                      ).
     1258                 vdateIso = iso-date(vdate3).
     1259                 find last code  where Code.parent      eq vparent
     1260                                   and Code.code        le vDateIso
     1261                                   and code.status_  eq 0 no-lock no-error.
     1262                 if available code
     1263                 then
     1264                    vDateIso = code.code.
     1265                 vDateFirst = vDateIso.
     1266                 vDateLast = iso-date(vdate).
     1267                 define variable vGood as logical no-undo.
     1268                 define variable vDateSale as date no-undo.
     1269                 define buffer bcode for code.
     1270                 for last code where Code.parent   eq vparent
     1271                                 and code.status_  eq 0
     1272                                 and code.code     < vDateLast
     1273                                 and code.code     >= vDateFirst
     1274                 no-lock:
     1275                    find first bcode where bCode.parent   eq vparent
     1276                                       and bcode.status_  eq 0
     1277                                       and bcode.code     > code.code no-lock no-error.
     1278                    if available bcode
     1279                    then do:
     1280                       if vPrice < dec(Code.CodeValue)
     1281                       then
     1282                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1283                                                     chr(10),
     1284                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1285                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1286                                                     ).
     1287                       else do:
     1288                          vGood = yes.
     1289                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1290                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1291                                                     chr(10),
     1292                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1293                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1294                                                     string(         vDateSale            ,"99/99/9999"),
     1295                                                     string(vDateSale - today)
     1296                                                     ).
     1297                       end.
     1298                    end.
     1299                 end.
     1300                 if vgood
     1301                 then do:
     1302                    define variable choice as integer no-undo .
     1303                    run gbl/d-askw.w (input "Уточнение"
     1304                           ,input  vText
     1305                           ,input "|"
     1306                           ,input "Принять|Вернуть"
     1307                           ,input "Принять данный товар|Вернуть товар постащику"
     1308                           ,input 1
     1309                           ,input 2
     1310                           ,output choice) no-error.
     1311                    vok = choice eq 1.
     1312                 end.
     1313                 else
     1314                    vok =false.
     1315             end.
     1316          end.
     1317      end.
     1318   end.
     1319   method private character addGs2Mark
     1320   (iMark as char):
     1321      define variable vDM   as character no-undo.
     1322      define variable vIdx  as integer   no-undo.
     1323      if index(iMark,chr(29),1) > 0
     1324      then return iMark.
     1325      if substring(iMark,26,4) = "8005" then
     1326      do:
     1327        vIdx = index(iMark,"93",26 + 4 + 5).
     1328        if vIdx > 1 then do:
     1329          vDM = substitute("&1&4&2&4&3",
     1330                           substring(iMark,1,25),
     1331                           substring(iMark,26,vIdx - 25 - 1),
     1332                           substring(iMark,vIdx),
     1333                           chr(29)) no-error.
     1334          vIdx = index(vDm,"240",vIdx + 4).
     1335          if vIdx > 0 then
     1336          do:
     1337            vDM = substitute("&1&3&2",
     1338                             substring(vDm,1,vIdx - 1),
     1339                             substring(vDm,vIdx),
     1340                             chr(29)) no-error.
     1341          end.
     1342        end.
     1343        else
     1344          vDM = substitute("&1&3&2",
     1345                           substring(iMark,1,25),
     1346                           substring(iMark,26),
     1347                           chr(29)) no-error.
     1348      end.
     1349      else if substring(iMark,32,2) = "91" then
     1350      do:
     1351        vIdx = index(iMark,"92",32).
     1352        if vIdx > 1 then
     1353          vDM = substitute("&1&4&2&4&3",
     1354                           substring(iMark,1,31),
     1355                           substring(iMark,32,vIdx - 31 - 1),
     1356                           substring(iMark,vIdx),
     1357                           chr(29)) no-error.
     1358        else
     1359          vDM = substitute("&1&3&2",
     1360                           substring(iMark,1,31),
     1361                           substring(iMark,32),
     1362                           chr(29)) no-error.
     1363      end.
     1364      else if substring(iMark,39,2) = "91" then
     1365      do:
     1366        vIdx = index(iMark,"92",38).
     1367        if vIdx > 1 then
     1368          vDM = substitute("&1&4&2&4&3",
     1369                           substring(iMark,1,38),
     1370                           substring(iMark,39,vIdx - 38 - 1),
     1371                           substring(iMark,vIdx),
     1372                           chr(29)) no-error.
     1373        else
     1374          vDM = substitute("&1&3&2",
     1375                           substring(iMark,1,38),
     1376                           substring(iMark,39),
     1377                           chr(29)) no-error.
     1378      end.
     1379      else if substring(iMark,25,2) = "93" then
     1380      do:
     1381        vIdx = index(iMark,"92",25).
     1382        if vIdx > 1 then
     1383          vDM = substitute("&1&4&2&4&3",
     1384                           substring(iMark,1,24),
     1385                           substring(iMark,25,vIdx - 24 - 1),
     1386                           substring(iMark,vIdx),
     1387                           chr(29)) no-error.
     1388        else
     1389          vIdx = index(iMark,"3103",25).
     1390          if vIdx > 0 then
     1391          vDM = substitute("&1&4&2&4&3",
     1392                           substring(iMark,1,24),
     1393                           substring(iMark,25,vIdx - 24 - 1),
     1394                           substring(iMark,vIdx),
     1395                           chr(29)) no-error.
     1396          else
     1397            vDM = substitute("&1&3&2",
     1398                             substring(iMark,1,24),
     1399                             substring(iMark,25),
     1400                             chr(29)) no-error.
     1401      end.
     1402      else if substring(iMark,32,2) = "93" then
     1403      do:
     1404        vDM = substitute("&1&3&2",
     1405              substring(iMark,1,31),
     1406              substring(iMark,32),
     1407              chr(29)) no-error.
     1408      end.
     1409      return if vDM <> "" then vDm else iMark.
     1410   end.
     1411   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   method private logical AddUtdErrForTab
     1414   (idb-num         as integer ,
     1415    idoc-id         as integer ,
     1416    iTab            as character,
     1417    iObj            as handle ,
     1418    iCheckType      as character,
     1419    iCodeErr        as character,
     1420    iCheckObj       as character ):
     1421      define buffer utd-err for utd-err.
     1422      define buffer utd for utd.
     1423      find first utd where utd.db-num     eq idb-num
     1424                       and utd.doc-id     eq idoc-id
     1425                       and utd.Direction  eq 'Outbound'
     1426      no-lock no-error.
     1427      if available utd
     1428      then
     1429         return no.
     1430      define variable vRecKey as character no-undo.
     1431            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1432            objKeyRec = new ibs.th.gbl.keyrec().
     1433            objKeyRec:GenKeyRec ( input iTab
     1434                                 ,input iObj
     1435                                 ,output vRecKey).
     1436            delete object objKeyRec.
     1437      find first utd-err where utd-err.db-num     eq idb-num
     1438                           and utd-err.doc-id     eq idoc-id
     1439                           and utd-err.CheckType  eq iCheckType
     1440                           and utd-err.CodeErr    eq iCodeErr
     1441                           and utd-err.CheckObj   eq iCheckObj
     1442      exclusive-lock no-error.
     1443      if not available utd-err
     1444      then do:
     1445         create utd-err.
     1446         assign
     1447            utd-err.db-num         = idb-num
     1448            utd-err.doc-id         = idoc-id
     1449            utd-err.CheckType      = iCheckType
     1450            utd-err.CodeErr        = iCodeErr
     1451            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     1452            utd-err.reckey         = vRecKey
     1453            utd-err.qnty           = 1
     1454         .
     1455      end.
     1456      else
     1457         utd-err.qnty = utd-err.qnty + 1.
     1458      return utd-err.qnty eq 1.
     1459   end.
     1460   method private logical AddUtdErr
     1461   (idb-num         as integer ,
     1462    idoc-id         as integer ,
     1463    iObj            as handle ,
     1464    iCheckType      as character,
     1465    iCodeErr        as character,
     1466    iCheckObj       as character ):
     1467      AddUtdErrForTab
     1468         (idb-num,
     1469          idoc-id,
     1470          iObj:table,
     1471          iObj,
     1472          iCheckType,
     1473          iCodeErr,
     1474          iCheckObj).
     1475   end.
     1476   method private void ClearUtdErrTypeCode
     1477   (idb-num         as integer,
     1478    idoc-id         as integer ,
     1479    iCheckType      as character,
     1480    iCodeErr        as character
     1481    ):
     1482      define buffer utd-err for utd-err.
     1483      if    iCheckType eq "*"
     1484         or iCheckType eq ?
     1485      then do:
     1486         if     iCodeErr ne ?
     1487            and iCodeErr ne "*"
     1488         then
     1489            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     1490            view-as alert-box.
     1491         else
     1492         for each utd-err where utd-err.db-num  eq idb-num
     1493                            and utd-err.doc-id  eq idoc-id
     1494         exclusive-lock:
     1495            delete utd-err.
     1496         end.
     1497      end.
     1498      else do:
     1499         if    iCodeErr eq ?
     1500            or iCodeErr eq "*"
     1501         then do:
     1502            for each utd-err where utd-err.db-num     eq idb-num
     1503                               and utd-err.doc-id     eq idoc-id
     1504                               and utd-err.CheckType  eq iCheckType
     1505            exclusive-lock:
     1506               delete utd-err.
     1507            end.
     1508         end.
     1509         else do:
     1510            for each utd-err where utd-err.db-num     eq idb-num
     1511                               and utd-err.doc-id     eq idoc-id
     1512                               and utd-err.CheckType  eq iCheckType
     1513                               and ub.utd-err.CodeErr eq iCodeErr
     1514            exclusive-lock:
     1515               delete utd-err.
     1516            end.
     1517         end.
     1518      end.
     1519   end.
     1520   method private void ClearUtdErr
     1521   (idb-num         as integer,
     1522    idoc-id         as integer ,
     1523    iCheckType      as character
     1524    ):
     1525      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     1526   end.
     1527   method private character GetMesError
     1528   (itxt as character,
     1529    iobj as character ):
     1530    define variable vi as integer no-undo.
     1531    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     1532       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     1533    end.
     1534    return itxt.
     1535   end.
     1536   method private character GetTextErrorType
     1537   (iCheckType as character,
     1538    iCodeErr   as character,
     1539    iChechObj  as character,
     1540    iType      as character  ):
     1541      define buffer code    for code.
     1542      define variable vError as character no-undo.
     1543      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1544                        and code.code   eq iCodeErr
     1545      no-lock no-error.
     1546      if available code
     1547      then do:
     1548         define variable vType as integer no-undo.
     1549         if code.misc3 eq "error"
     1550         then
     1551            vType = 0.
     1552         else if code.misc3 eq "warning"
     1553         then
     1554            vType = 1.
     1555         else if code.misc3 eq "Hiden"
     1556         then
     1557            vType = 2.
     1558         else
     1559            vtype = int(code.misc3) no-error.
     1560         case itype:
     1561            when "error"
     1562            then do:
     1563               if vtype eq 0
     1564               then
     1565                  vError = GetMesError(Code.CodeValue,iChechObj).
     1566            end.
     1567            when "warning"
     1568            then do:
     1569               if vtype <= 1
     1570               then
     1571                  vError = GetMesError(Code.CodeValue,iChechObj).
     1572            end.
     1573            otherwise do:
     1574               vError = GetMesError(Code.CodeValue,iChechObj).
     1575            end.
     1576         end.
     1577      end.
     1578      else
     1579         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     1580      return vError.
     1581   end.
     1582   method private integer  GetTypeError
     1583   (iCheckType as character,
     1584    iCodeErr   as character):
     1585      define buffer code    for code.
     1586      define variable vType as integer no-undo.
     1587      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1588                        and code.code   eq iCodeErr
     1589      no-lock no-error.
     1590      if     not available code
     1591         and code.misc3 eq "error"
     1592      then
     1593         vType = 0.
     1594      else if code.misc3 eq "warning"
     1595      then
     1596         vType = 1.
     1597      else if code.misc3 eq "Hiden"
     1598      then
     1599         vType = 2.
     1600      else
     1601         vtype = int(code.misc3) no-error.
     1602      return vtype.
     1603   end.
     1604   method private character GetTextError
     1605   (iCheckType as character,
     1606    iCodeErr   as character,
     1607    iChechObj  as character ):
     1608      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     1609   end.
     1610   method private character GetErrForUtdstr
     1611   (idb-num     as integer ,
     1612    idoc-id     as integer ,
     1613    iCheckType  as character
     1614    ):
     1615      define buffer utd-err for utd-err.
     1616      define buffer code    for code.
     1617      define variable vHQry as handle no-undo.
     1618      define variable vError as longchar no-undo.
     1619      define variable vErrorOne as longchar  no-undo.
     1620      define variable oError as character no-undo.
     1621      create query vHQry.
     1622      vHQry:set-buffers(buffer utd-err:handle).
     1623      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1624                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1625                               + if    iCheckType eq "*"
     1626                                    or iCheckType eq ?
     1627                                 then       ""
     1628                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1629      vHQry:query-open().
     1630      vHQry:get-first().
     1631      QRY-BLOCK:
     1632      repeat while not vHQry:query-off-end:
     1633         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1634         if     vErrorOne ne ""
     1635            and vErrorOne ne ?
     1636         then
     1637            vError = vError + ", " + vErrorOne.
     1638         vHQry:get-next().
     1639      end.
     1640      oError = substring(vError,3,4002).
     1641      return oError.
     1642   end.
     1643   method private character GetErrJsonForUtd
     1644   (idb-num         as integer ,
     1645    idoc-id         as integer ,
     1646    iCheckType      as character
     1647    ):
     1648      define buffer utd-err for utd-err.
     1649      define variable vHQry as handle no-undo.
     1650      define variable vError as longchar no-undo.
     1651      define variable oError as character no-undo.
     1652      create query vHQry.
     1653      define variable vi as integer no-undo.
     1654      vHQry:set-buffers(buffer utd-err:handle).
     1655      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1656                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1657                               + if    iCheckType eq "*"
     1658                                    or iCheckType eq ?
     1659                                 then       ""
     1660                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1661      vHQry:query-open().
     1662      vHQry:get-first().
     1663      QRY-BLOCK:
     1664      repeat while not vHQry:query-off-end:
     1665         define variable vErrorOne as character no-undo.
     1666         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1667         if     vErrorOne ne ?
     1668            and vErrorOne ne ""
     1669         then do:
     1670            vi = vi + 1.
     1671            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1672                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     1673                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1674         end.
     1675         vHQry:get-next().
     1676      end.
     1677      for first utd where utd.db-num eq idb-num
     1678                      and utd.doc-id eq idoc-id
     1679                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     1680      no-lock,
     1681         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1682                                  and utd-marking-lines.doc-id eq idoc-id
     1683                                  and utd-marking-lines.doc-level eq 1
     1684      no-lock,
     1685         first marking where marking.mark eq utd-marking-lines.mark
     1686                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1687      no-lock:
     1688         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     1689         if     vErrorOne ne ?
     1690            and vErrorOne ne ""
     1691         then do:
     1692            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     1693                            + '","ОбъектОш":"' + marking.mark
     1694                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1695         end.
     1696      end.
     1697      if vError ne ""
     1698      then
     1699         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     1700      return oError.
     1701   end.
     1702   method private character GetErrJsonForUtdReturn
     1703   (idb-num         as integer ,
     1704    idoc-id         as integer ,
     1705    iCheckType      as character
     1706    ):
     1707      define buffer utd-err for utd-err.
     1708      define variable vHQry as handle no-undo.
     1709      define variable vError as longchar no-undo.
     1710      define variable oError as character no-undo.
     1711      define variable vi as integer no-undo.
     1712      create query vHQry.
     1713      vHQry:set-buffers(buffer utd-err:handle).
     1714      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1715                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1716                               + if    iCheckType eq "*"
     1717                                    or iCheckType eq ?
     1718                                 then       ""
     1719                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1720      vHQry:query-open().
     1721      vHQry:get-first().
     1722      QRY-BLOCK:
     1723      repeat while not vHQry:query-off-end:
     1724         define variable vErrorOne as character no-undo.
     1725         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1726         if     vErrorOne ne ?
     1727            and vErrorOne ne ""
     1728         then do:
     1729            vi = vi + 1.
     1730            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1731                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     1732                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     1733         end.
     1734         vHQry:get-next().
     1735      end.
     1736      if vError ne ""
     1737      then
     1738         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     1739      return oError.
     1740   end.
     1741   method private character GetCodeTextError
     1742   (iCheckType as character,
     1743    iCodeErr   as character,
     1744    iChechObj  as character,
     1745    output oCode as character,
     1746    output ovalue as character ):
     1747      define buffer code    for code.
     1748      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1749                        and code.code   eq iCodeErr
     1750      no-lock no-error.
     1751      if     available code
     1752      then do:
     1753         define variable vi as integer no-undo init ?.
     1754         vi = int(Code.misc3) no-error.
     1755         if    code.misc3 ne "error"
     1756            and vi ne 0
     1757         then
     1758            oCode = ?.
     1759         else if     Code.misc1 ne ?
     1760                 and Code.misc1 ne ""
     1761         then
     1762            assign
     1763               oCode  = GetMesError(Code.misc1,iChechObj)
     1764               ovalue = GetMesError(Code.misc2,iChechObj)
     1765            .
     1766      end.
     1767      return if oCode eq ""
     1768             then ""
     1769             else (oCode + "_" + ovalue).
     1770   end.
     1771   define temp-table TT-err no-undo
     1772     field code_ as character
     1773     field text_ as character
     1774   index code_ code_.
     1775   method private character GetErrTxtForUtd
     1776   (idb-num         as integer ,
     1777    idoc-id         as integer ,
     1778    iCheckType      as character
     1779    ):
     1780      define buffer utd-err for utd-err.
     1781      define variable vHQry as handle no-undo.
     1782      define variable oError as character no-undo.
     1783      create query vHQry.
     1784      define variable vi as integer no-undo.
     1785      for each tt-err :
     1786         delete tt-err.
     1787      end.
     1788      vHQry:set-buffers(buffer utd-err:handle).
     1789      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1790                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1791                               + if    iCheckType eq "*"
     1792                                    or iCheckType eq ?
     1793                                 then       ""
     1794                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1795      vHQry:query-open().
     1796      vHQry:get-first().
     1797      define variable vcode as character no-undo.
     1798      define variable vvalue as character no-undo.
     1799      QRY-BLOCK:
     1800      repeat while not vHQry:query-off-end:
     1801         vi = vi + 1.
     1802         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     1803         if vcode ne ?
     1804         then do:
     1805            find first tt-err where tt-err.code eq vcode
     1806            no-error.
     1807            if not available tt-err
     1808            then do:
     1809               create tt-err.
     1810               assign
     1811                  tt-err.code_ = vcode
     1812                  tt-err.text_ = vvalue
     1813               .
     1814            end.
     1815            else
     1816               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1817         end.
     1818         vHQry:get-next().
     1819      end.
     1820     find first utd where utd.db-num eq idb-num
     1821                         and utd.doc-id eq idoc-id
     1822         no-lock.
     1823      define buffer cancel_utd-lines for utd-lines.
     1824      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     1825                                  and cancel_utd-lines.doc-id eq idoc-id
     1826      no-lock:
     1827         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     1828         then do:
     1829            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1830                                        and utd-marking-lines.doc-id eq idoc-id
     1831                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     1832            no-lock,
     1833               first marking where marking.mark eq utd-marking-lines.mark
     1834                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1835            no-lock:
     1836               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     1837               find first tt-err where tt-err.code eq vcode
     1838               no-error.
     1839               if not available tt-err
     1840               then do:
     1841                  create tt-err.
     1842                  assign
     1843                     tt-err.code_ = vcode
     1844                     tt-err.text_ = vvalue
     1845                  .
     1846               end.
     1847               else
     1848                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1849            end.
     1850         end.
     1851         else do:
     1852            define variable vqnty as decimal no-undo.
     1853            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     1854            if vqnty eq ? then vqnty = 0.
     1855            if vqnty ne cancel_utd-lines.Quantity
     1856            then do:
     1857               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     1858               find first tt-err where tt-err.code eq vcode
     1859               no-error.
     1860               if not available tt-err
     1861               then do:
     1862                  create tt-err.
     1863                  assign
     1864                     tt-err.code_ = vcode
     1865                     tt-err.text_ = vvalue
     1866                  .
     1867               end.
     1868               else
     1869                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1870            end.
     1871         end.
     1872      end.
     1873      for each tt-err:
     1874         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     1875      end.
     1876      return oError.
     1877   end.
     1878   define variable mFormatErr as character no-undo init "text".
     1879   method private character GetErrForUtd
     1880   (idb-num         as integer ,
     1881    idoc-id         as integer ,
     1882    iType           as character
     1883    ):
     1884      if mFormatErr eq "text"
     1885      then
     1886         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     1887      else do:
     1888         if itype eq "return"
     1889         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     1890         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     1891      end.
     1892   end.
     1893   method private longchar GetErrComText
     1894   (icomment as character,
     1895    itext    as longchar ):
     1896       define variable vText as longchar no-undo.
     1897      if mFormatErr eq "text"
     1898      then do:
     1899         if icomment ne ""
     1900         then
     1901            icomment = substitute("comment:|&1|",icomment).
     1902         vText = icomment + itext.
     1903      end.
     1904      else do:
     1905         icomment = if icomment begins  '"'
     1906                    then icomment
     1907                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     1908         vText = icomment + "," + itext.
     1909         vText = "~{" + trim(vText,",") + "~}".
     1910      end.
     1911      return vText.
     1912   end.
     1913   method private logical  CheckTypeForMarkLineType
     1914   (iObj            as handle,
     1915    iCheckType      as character,
     1916    iCodeErr        as character ,
     1917    iTypeErr        as character ):
     1918      define variable vRecKey-markLine as character no-undo.
     1919      define variable vGoodMark        as logical no-undo.
     1920      define variable vdb-num          as integer no-undo.
     1921      define variable vdoc-id          as integer no-undo.
     1922      define variable vlinenum         as integer no-undo.
     1923      define variable vErrorOne as character no-undo.
     1924      define buffer buf_utd-err for utd-err.
     1925       define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1926       objKeyRec = new ibs.th.gbl.keyrec().
     1927       objKeyRec:GenKeyRec ( input "utd-marking-lines"
     1928                            ,input iObj
     1929                            ,output  vRecKey-markLine).
     1930       delete object objKeyRec.
     1931      vGoodMark = yes.
     1932      vdb-num = iObj::db-num.
     1933      vdoc-id = iObj::doc-id.
     1934      vlinenum = iObj::linenum.
     1935      block-mark-err:
     1936      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1937                               and buf_utd-err.db-num = vdb-num
     1938                               and buf_utd-err.reckey = vRecKey-markLine
     1939                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1940                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1941      no-lock:
     1942         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1943         if     vErrorOne ne ?
     1944            and vErrorOne ne ""
     1945         then do:
     1946            vGoodMark = no.
     1947            leave block-mark-err.
     1948         end.
     1949      end.
     1950      return not vGoodMark.
     1951   end.
     1952   method private logical  CheckErrForMarkLineType
     1953   (iObj            as handle,
     1954    iType           as character  ):
     1955      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     1956   end.
     1957   method private logical  CheckErrForMarkLine
     1958   (iObj            as handle):
     1959      return CheckErrForMarkLineType(iObj,"*").
     1960   end.
     1961   method private logical  CheckErrForLineTypeCode
     1962   (iObj                 as handle,
     1963    iCheckType           as character,
     1964    iCodeErr             as character,
     1965    iTypeErr             as character,
     1966    iOneErr              as logical):
     1967      define variable vRecKey-line     as character no-undo.
     1968      define buffer buf_utd-err for utd-err.
     1969      define variable vUtdlineError as logical no-undo.
     1970      define variable vErrorOne as character no-undo.
     1971            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1972            objKeyRec = new ibs.th.gbl.keyrec().
     1973            objKeyRec:GenKeyRec ( input "utd-lines"
     1974                                 ,input iObj
     1975                                 ,output vRecKey-line).
     1976            delete object objKeyRec.
     1977         define variable vdb-num as integer no-undo.
     1978         define variable vdoc-id as integer no-undo.
     1979         define variable vlinenum as integer no-undo.
     1980         vdb-num = iObj::db-num.
     1981         vdoc-id = iObj::doc-id.
     1982         vlinenum = iObj::linenum.
     1983         block-err:
     1984         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1985                                  and buf_utd-err.db-num = vdb-num
     1986                                  and buf_utd-err.reckey = vRecKey-line
     1987                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1988                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1989         no-lock:
     1990            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1991            if     vErrorOne ne ?
     1992               and vErrorOne ne ""
     1993            then do:
     1994               vUtdlineError = yes.
     1995               leave block-err.
     1996            end.
     1997         end.
     1998         if  not vUtdlineError
     1999         then do:
     2000            define variable vGoodMark as logical no-undo.
     2001            vGoodMark = yes.
     2002            block-line-err:
     2003            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2004                                         and utd-marking-lines.doc-id  eq vdoc-id
     2005                                         and utd-marking-lines.LineNum eq vLineNum
     2006            no-lock:
     2007               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2008               if     vGoodMark
     2009                  and iOneErr eq no
     2010               then
     2011                  leave block-line-err.
     2012               if     iOneErr = yes
     2013                  and not vGoodMark
     2014               then
     2015                  leave block-line-err.
     2016            end.
     2017            vUtdlineError = not vGoodMark.
     2018         end.
     2019      return vUtdlineError.
     2020   end.
     2021   method private character   getErrForLineType
     2022   (iObj            as handle,
     2023    iType           as character  ):
     2024      define variable vRecKey-line     as character no-undo.
     2025      define buffer buf_utd-err for utd-err.
     2026      define variable vUtdlineError as logical no-undo.
     2027      define variable vErrorOne as character no-undo.
     2028      define variable oError as character no-undo.
     2029            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2030            objKeyRec = new ibs.th.gbl.keyrec().
     2031            objKeyRec:GenKeyRec ( input "utd-lines"
     2032                                 ,input iObj
     2033                                 ,output vRecKey-line).
     2034            delete object objKeyRec.
     2035         define variable vdb-num as integer no-undo.
     2036         define variable vdoc-id as integer no-undo.
     2037         define variable vlinenum as integer no-undo.
     2038         vdb-num = iObj::db-num.
     2039         vdoc-id = iObj::doc-id.
     2040         vlinenum = iObj::linenum.
     2041         block-err:
     2042         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2043                                  and buf_utd-err.db-num = vdb-num
     2044                                  and buf_utd-err.reckey = vRecKey-line
     2045                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2046         no-lock:
     2047            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2048            if     vErrorOne ne ?
     2049               and vErrorOne ne ""
     2050            then do:
     2051               oError = oError + vErrorOne + " ".
     2052            end.
     2053         end.
     2054      return oError.
     2055   end.
     2056   method private logical  CheckErrForLineType
     2057   (iObj            as handle,
     2058    iType           as character  ):
     2059       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2060   end.
     2061   method private logical  CheckErrForLine
     2062   (iObj            as handle):
     2063      return CheckErrForLineType(iobj,"*").
     2064   end.
     2065   method private logical  CheckErrForUtd
     2066   (idb-num         as integer ,
     2067    idoc-id         as integer ):
     2068      for each utd-lines where utd-lines.db-num eq idb-num
     2069                           and utd-lines.doc-id eq idoc-id
     2070      no-lock :
     2071         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2072         then
     2073            return no.
     2074      end.
     2075      return yes.
     2076   end.
     2077   method public logical CheckMarkUtd-28rel
     2078    (input idb-num as integer,
     2079    input idoc-id as integer):
     2080    define buffer utd                   for utd.
     2081    define buffer utd-lines             for utd-lines.
     2082    define buffer utd-marking-lines     for utd-marking-lines.
     2083    define variable v-par-type as character no-undo.
     2084    define variable vgdsNoMark as logical no-undo.
     2085    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2086      define variable v-par-val  as character no-undo.
     2087      find first utd where utd.db-num eq idb-num
     2088                       and utd.doc-id eq idoc-id
     2089      no-lock no-error.
     2090      if available utd
     2091      then do:
     2092         if     utd.obj-code ne ?
     2093            and utd.obj-type ne ?
     2094         then do:
     2095            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2096            Block-utd-lines:
     2097            for each utd-lines where utd-lines.db-num eq idb-num
     2098                                 and utd-lines.doc-id eq idoc-id
     2099            no-lock:
     2100               if     utd-lines.gds-code ne ?
     2101                  and utd-lines.gds-code ne 0
     2102               then do:
     2103                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2104                       ( utd-lines.gds-code,
     2105                         'mark-type':U,
     2106                          output v-par-val,
     2107                          output v-par-type
     2108                       ).
     2109                  if     EDOParSec:IsEdo
     2110                     and EDOParSec:GetIsEDOForType(v-par-val)
     2111                  then do:
     2112                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2113                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2114                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2115                                                    and length(utd-marking-lines.mark) > 13
     2116                     no-lock no-error.
     2117                     if     avail utd-marking-lines
     2118                        and not CheckErrForLine(buffer utd-lines:handle)
     2119                     then
     2120                        leave Block-utd-lines.
     2121                  end.
     2122                  else
     2123                     vgdsNoMark = yes.
     2124               end.
     2125            end.
     2126            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2127            if vgdsNoMark then return available utd-lines . else return yes .
     2128         end.
     2129      end.
     2130      return yes.
     2131   end.
     2132   method public logical CheckMarkUtd
     2133    (input idb-num  as integer,
     2134     input idoc-id  as integer):
     2135     define buffer utd-lines             for ub.utd-lines.
     2136     block-line:
     2137     for each utd-lines where utd-lines.db-num eq idb-num
     2138                          and utd-lines.doc-id eq idoc-id
     2139     no-lock:
     2140        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2141        then
     2142           leave block-line.
     2143     end.
     2144     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2145     return available utd-lines.
     2146   end.
     2147   method public logical CheckNotMarkUtd
     2148    (input idb-num  as integer,
     2149     input idoc-id  as integer):
     2150     define buffer utd-lines             for ub.utd-lines.
     2151     for each utd-lines where utd-lines.db-num eq idb-num
     2152                          and utd-lines.doc-id eq idoc-id
     2153     no-lock:
     2154        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2155        then
     2156           return yes.
     2157     end.
     2158     return no.
     2159   end.
     2160   method public logical CheckMarkUtdLine
     2161    (input idb-num  as integer,
     2162     input idoc-id  as integer,
     2163     input iLineNum as integer):
     2164    define buffer utd                   for utd.
     2165    define buffer utd-lines             for utd-lines.
     2166    define buffer utd-marking-lines     for utd-marking-lines.
     2167    define variable v-par-type as character no-undo.
     2168    define variable vMarking        as logical no-undo.
     2169    define variable vArtic          as logical no-undo.
     2170    define variable vTransitional   as logical no-undo.
     2171    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2172      define variable v-par-val  as character no-undo.
     2173      find first utd where utd.db-num eq idb-num
     2174                       and utd.doc-id eq idoc-id
     2175      no-lock no-error.
     2176      if available utd
     2177      then do:
     2178         if     utd.obj-code ne ?
     2179            and utd.obj-type ne ?
     2180         then do:
     2181            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2182            Block-utd-lines:
     2183            for each utd-lines where utd-lines.db-num   eq idb-num
     2184                                 and utd-lines.doc-id   eq idoc-id
     2185                                 and utd-lines.LineNum  eq iLineNum
     2186            no-lock:
     2187               if     utd-lines.gds-code ne ?
     2188                  and utd-lines.gds-code ne 0
     2189               then do:
     2190                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2191                       ( utd-lines.gds-code,
     2192                         'mark-type':U,
     2193                          output v-par-val,
     2194                          output v-par-type
     2195                       ).
     2196                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2197                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2198                  if vMarking
     2199                  then do:
     2200                     block-marking:
     2201                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2202                                                    and utd-marking-lines.doc-id   eq idoc-id
     2203                                                    and utd-marking-lines.LineNum  eq iLineNum
     2204                                                    and length(utd-marking-lines.mark) > 13
     2205                     no-lock:
     2206                        if isOAD(utd-marking-lines.mark)
     2207                        then do:
     2208                           assign
     2209                              vArtic   = yes
     2210                              vMarking = no
     2211                           .
     2212                           leave block-marking.
     2213                        end.
     2214                     end.
     2215                  end.
     2216                  if vArtic
     2217                  then do:
     2218                     block-artic:
     2219                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2220                                                    and utd-marking-lines.doc-id   eq idoc-id
     2221                                                    and utd-marking-lines.LineNum  eq iLineNum
     2222                                                    and length(utd-marking-lines.mark) > 13
     2223                     no-lock:
     2224                        if isMark(utd-marking-lines.mark)
     2225                        then do:
     2226                           assign
     2227                              vArtic   = no
     2228                              vMarking = yes
     2229                           .
     2230                           leave block-artic.
     2231                        end.
     2232                     end.
     2233                  end.
     2234                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2235                  if vTransitional
     2236                  then do:
     2237                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2238                                                    and utd-marking-lines.doc-id   eq idoc-id
     2239                                                    and utd-marking-lines.LineNum  eq iLineNum
     2240                                                    and length(utd-marking-lines.mark) > 13
     2241                     no-lock no-error.
     2242                     if not available utd-marking-lines
     2243                     then assign
     2244                        vMarking = no
     2245                        vArtic   = no
     2246                     .
     2247                  end.
     2248               end.
     2249               else
     2250                  assign
     2251                     vMarking      = yes
     2252                     vArtic        = no
     2253                     vTransitional = no
     2254                  .
     2255               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2256               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2257               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2258            end.
     2259         end.
     2260      end.
     2261      return vMarking or vArtic.
     2262   end.
     2263   method public logical getMarkUtdLine
     2264    (input  idb-num  as integer,
     2265     input  idoc-id  as integer,
     2266     input  iLineNum as integer,
     2267     output oMarking        as logical,
     2268     output oArtic          as logical,
     2269     output oTransitional   as logical):
     2270     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2271     oArtic        = not oMarking
     2272            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2273     oTransitional = (oMarking or oArtic)
     2274            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2275   end.
     2276   method public logical CheckMarking
     2277    (input idb-num as integer,
     2278    input idoc-id as integer,
     2279    input iTypeErr as character ):
     2280     define variable vMarkutd as logical no-undo.
     2281     define variable vCrErr   as logical no-undo.
     2282     define buffer utd-lines         for utd-lines.
     2283     define buffer utd-marking-lines for utd-marking-lines.
     2284     define buffer marking           for marking.
     2285     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2286      block-line:
     2287      for each utd-lines where utd-lines.db-num eq idb-num
     2288                           and utd-lines.doc-id eq idoc-id
     2289      no-lock:
     2290         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2291         then do:
     2292            for each utd-marking-lines
     2293                     where utd-marking-lines.db-num  = utd-lines.db-num
     2294                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2295                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2296            no-lock:
     2297               if isMark(utd-marking-lines.mark)
     2298               then do:
     2299                  find first marking where marking.mark eq utd-marking-lines.mark
     2300                  no-lock no-error.
     2301                  if not available marking
     2302                  then do:
     2303                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2304                     vCrErr = yes.
     2305                     next block-line.
     2306                  end.
     2307               end.
     2308            end.
     2309         end.
     2310      end.
     2311      return vCrErr.
     2312   end.
     2313   method public logical CheckMarkForType
     2314    (input idb-num   as integer,
     2315     input idoc-id   as integer):
     2316      define variable vMarking        as logical no-undo.
     2317      define variable vArtic          as logical no-undo.
     2318      define variable vTransitional   as logical no-undo.
     2319      define buffer utd-lines         for utd-lines.
     2320      define buffer utd-marking-lines for utd-marking-lines.
     2321      block-line:
     2322      for each utd-lines where utd-lines.db-num eq idb-num
     2323                           and utd-lines.doc-id eq idoc-id
     2324      no-lock:
     2325         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2326                          output vMarking         , output vArtic          , output vTransitional).
     2327         for each utd-marking-lines
     2328                     where utd-marking-lines.db-num  = utd-lines.db-num
     2329                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2330                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2331         no-lock:
     2332            if length(utd-marking-lines.mark) < 14
     2333            then do:
     2334               if (vMarking or vArtic) and not vTransitional
     2335               then
     2336                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2337            end.
     2338            else if not isMark(utd-marking-lines.mark)
     2339            then do:
     2340               if vMarking
     2341               then
     2342                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2343            end.
     2344            else do:
     2345            end.
     2346         end.
     2347      end.
     2348   end.
     2349   method public logical WeighedProd
     2350      ( input p-gds-code as integer) :
     2351      define variable v-par-val  as character no-undo.
     2352      define variable v-par-type as character no-undo.
     2353              if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2354               ( p-gds-code,
     2355                 'weighed-gds':U,
     2356                  output v-par-val,
     2357                  output v-par-type
     2358               ).
     2359      return logical(v-par-val).
     2360   end.
     2361   method public logical WghProdVariable
     2362       (input p-obj-type as char,
     2363        input p-obj-code as integer,
     2364        input p-gds-code as integer) :
     2365      define variable v-wgh-val  as character no-undo.
     2366      define variable v-par-val  as character no-undo.
     2367      define variable v-par-type as character no-undo.
     2368      define variable vMarking        as logical no-undo.
     2369      define variable vArtic          as logical no-undo.
     2370      define variable vTransitional   as logical no-undo.
     2371      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2372         if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2373           ( p-gds-code,
     2374             'weighed-gds':U,
     2375              output v-wgh-val,
     2376              output v-par-type
     2377           ).
     2378       if logical(v-wgh-val) = yes then do:
     2379           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2380               ( p-gds-code,
     2381                 'mark-type':U,
     2382                  output v-par-val,
     2383                  output v-par-type
     2384               ).
     2385           if v-par-val <> "" then do:
     2386               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2387               assign
     2388                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2389                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2390                  .
     2391           end.
     2392      end.
     2393      if v-wgh-val > "" and (vMarking or vArtic)
     2394      then return yes.
     2395      else return no.
     2396   end.
     2397   method public decimal MarkWeight
     2398      ( input p-mark as character) :
     2399      define buffer  buf_marking-attr for  ub.marking-attr.
     2400      define variable vMarkWeight as decimal no-undo.
     2401      vMarkWeight = 0.
     2402      if p-mark <> "" and p-mark <> ?
     2403      then do:
     2404          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2405                                        and buf_marking-attr.attr-code eq "weight"
     2406             no-lock no-error.
     2407          if not available buf_marking-attr
     2408          then do :
     2409            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2410                                          and buf_marking-attr.attr-code eq "weight"
     2411               no-lock no-error.
     2412          end .
     2413          if avail buf_marking-attr
     2414          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2415      end.
     2416      return vMarkWeight.
     2417   end.
     2418     define temp-table buf_fbr-doc like ub.fbr-doc.
     2419     define buffer buf_fbr-line for ub.fbr-line.
     2420     define buffer buf_trn-doc for ub.trn-doc.
     2421     define buffer buf_doc-line for ub.doc-line.
     2422     define buffer buf_doc-line-attr for ub.doc-line-attr.
     2423     define buffer buf_gds-dtl for ub.gds-dtl.
     2424     define buffer buf_doc-pl for ub.doc-pl.
     2425     define buffer buf_gds for ub.goods.
     2426     define buffer buf_doc-attr for ub.doc-attr.
     2427     define buffer buf_parts for ub.parts.
     2428     define buffer buf_recipe for ub.recipe.
     2429     define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2430     define buffer buf_marking-lines for ub.marking-lines .
     2431     define property Msg as character no-undo
     2432       get:
     2433         return trim (Msg, chr(10)).
     2434       end.
     2435       private set (inArg as char):
     2436         Msg = Msg + chr(10) + inArg.
     2437       end.
     2438     define property DocCode as character no-undo
     2439       get.
     2440       set.
     2441     define property BufTableHndl as handle no-undo
     2442       get.
     2443       set.
     2444     define temp-table tt-gds no-undo
     2445       field line-num as integer
     2446       field gds-code as integer
     2447     .
     2448     define property InitSecTag as character no-undo init "trn-gd-docs"
     2449       get.
     2450     define property BufTableHndlNew as handle no-undo
     2451       get.
     2452       set.
     2453     define property BufTableHndlOld as handle no-undo
     2454       get.
     2455       set.
     2456     define public property sendTableName as character no-undo init "fbr-doc"
     2457       get.
     2458     define public property sendOldRowid as rowid  no-undo
     2459       get.
     2460       set.
     2461     define public property sendNewRowid as rowid  no-undo
     2462       get.
     2463       set.
     2464     define variable sw               as handle    no-undo.
     2465     define variable v-doc-type-ERPRN as character no-undo.
     2466     define variable v-is-petrol-trn  as logical   no-undo.
     2467     define variable v-is-pieces      as logical   no-undo.
     2468     define variable isDel            as logical   no-undo.
     2469     define variable v-bufhnd         as handle    no-undo.
     2470     define variable v-user-name      as character no-undo.
     2471     method public void CrContentToSW (insw as handle):
     2472       sw = insw.
     2473       create buf_fbr-doc.
     2474       v-bufhnd = buffer buf_fbr-doc:handle.
     2475       if valid-handle (BufTableHndlNew)
     2476       then do:
     2477         sendNewRowid  = BufTableHndlNew:rowid.
     2478         v-bufhnd:buffer-copy (BufTableHndlNew) no-error.
     2479         if error-status:error
     2480         then do:
     2481           Msg = "Ошибка выгрузки fbr-gd-doc, неверный буфер BufTableHndlNew".
     2482           undo, return error Msg.
     2483         end.
     2484         isDel = false.
     2485       end.
     2486       else do:
     2487         if not valid-handle (BufTableHndlOld)
     2488         then do:
     2489           Msg = "Ошибка выгрузки fbr-gd-doc, неопеределен ни старый ни новый буфер".
     2490           undo, return error Msg.
     2491         end.
     2492         sendOldRowid  = BufTableHndlOld:rowid.
     2493         v-bufhnd:buffer-copy (BufTableHndlOld) no-error.
     2494         if error-status:error
     2495         then do:
     2496           Msg = "Ошибка выгрузки fbr-gd-doc, неверный буфер BufTableHndlOld".
     2497           undo, return error Msg.
     2498         end.
     2499         isDel = true.
     2500       end.
     2501       case buf_fbr-doc.doc-type:
     2502         when 'производство':U then do:
     2503           v-doc-type-ERPRN = "6".
     2504             StartDocFbr().
     2505             FbrLine().
     2506             EndDocFbr().
     2507         end.
     2508         otherwise do:
     2509           return.
     2510         end.
     2511       end.
     2512     end.
     2513     method private void FbrLine ():
     2514       find first buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_fbr-doc.doc-code no-error.
     2515       if not available (buf_fbr-line)
     2516         then return.
     2517       FBR ().
     2518     end.
     2519     method private void FBR ():
     2520       define variable ii as integer no-undo.
     2521       define variable vGT as integer no-undo .
     2522       define variable vGtin as character no-undo .
     2523       define variable vQnty as integer no-undo .
     2524       define variable v-value as character no-undo .
     2525       define variable v-type as character no-undo .
     2526       define variable isVarWeight as logical no-undo init no .
     2527       sw:start-element ("dishs").
     2528       for each buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     2529         and buf_fbr-line.is-comp:
     2530         find first buf_gds where
     2531               buf_gds.artic = buf_fbr-line.artic
     2532           and buf_gds.prod-code = buf_fbr-line.prod-code
     2533           and buf_gds.prod-type = buf_fbr-line.prod-type.
     2534         ii = ii + 1.
     2535         isVarWeight = WghProdVariable(buf_fbr-doc.obj-type, buf_fbr-doc.obj-code, buf_gds.gds-code).
     2536               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2537           ( input buf_gds.gds-code
     2538            ,input 'mark-type':U
     2539            ,output v-value
     2540            ,output v-type
     2541           )        no-error .
     2542         if error-status :error
     2543         then do:
     2544           undo, return error return-value .
     2545         end.
     2546         find first tt-gds where tt-gds.gds-code = buf_gds.gds-code no-error.
     2547         sw:start-element ("dish").
     2548           write-data-element ("line-num", string-mth (ii)).
     2549           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     2550           write-data-element ("oper-type", (if buf_fbr-line.trn-type = 'спи':U
     2551             then "2" else "1") ).
     2552           write-data-element ("qnty", string-mth (round ((buf_fbr-line.fact-qnty) , 3))).
     2553           write-data-element ("u-price", string-mth (round ((buf_fbr-line.price-rubl) , 2))).
     2554           write-data-element ("p-price", string-mth (round ((buf_fbr-line.price-sale) , 2))).
     2555           write-data-element ("u-price-s", string-mth (round (buf_fbr-line.price-sum-rubl , 2))).
     2556           write-data-element ("rcp-code", buf_fbr-line.recipe-code).
     2557           if (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_fbr-doc.obj-type, buf_fbr-doc.obj-code):GetIsEDOForType(v-value) or isVarWeight) and
     2558              can-find(first buf_marking-lines where
     2559                             buf_marking-lines.gds-code = buf_gds.gds-code
     2560                         and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2561                         and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2562                         and buf_marking-lines.in-code  = "manufacturing"
     2563                         and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2564                         and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2565                         and buf_marking-lines.prt-code = 0
     2566                         and buf_marking-lines.doc-level = 1)
     2567           then do :
     2568             sw:start-element ("marks").
     2569             for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_gds.gds-code
     2570                                                  and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2571                                                  and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2572                                                  and buf_marking-lines.in-code  = "manufacturing"
     2573                                                  and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2574                                                  and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2575                                                  and buf_marking-lines.prt-code = 0
     2576                                                  and buf_marking-lines.doc-level = 1
     2577             :
     2578               sw:start-element ("mark").
     2579               write-data-element ("mark-code", repTegforDm( addBracketForCode(buf_marking-lines.mark))).
     2580               sw:end-element ("mark").
     2581             end .
     2582             sw:end-element ("marks").
     2583           end .
     2584         sw:end-element ("dish").
     2585       end.
     2586       sw:end-element ("dishs").
     2587       sw:start-element ("ingrs").
     2588       for each buf_fbr-line no-lock where buf_fbr-line.doc-code = buf_fbr-doc.doc-code
     2589         and not buf_fbr-line.is-comp:
     2590         find first buf_gds no-lock where
     2591               buf_gds.artic = buf_fbr-line.artic
     2592           and buf_gds.prod-code = buf_fbr-line.prod-code
     2593           and buf_gds.prod-type = buf_fbr-line.prod-type.
     2594         isVarWeight = WghProdVariable(buf_fbr-doc.obj-type, buf_fbr-doc.obj-code, buf_gds.gds-code).
     2595         find first buf_recipe no-lock where
     2596               buf_recipe.recipe-code = buf_fbr-line.recipe-code no-error.
     2597         find first fbr-recipe no-lock where fbr-recipe.doc-code = buf_fbr-line.doc-code
     2598                                         and fbr-recipe.recipe-code = buf_fbr-line.recipe-code no-error.
     2599         find first buf_fbr-recipe-gds no-lock where buf_fbr-recipe-gds.doc-code = buf_fbr-line.doc-code
     2600                                                 and buf_fbr-recipe-gds.recipe-code = buf_fbr-line.recipe-code
     2601                                                 and buf_fbr-recipe-gds.prod-type = buf_fbr-line.prod-type
     2602                                                 and buf_fbr-recipe-gds.prod-code = buf_fbr-line.prod-code
     2603                                                 and buf_fbr-recipe-gds.artic = buf_fbr-line.artic
     2604                                                 no-error .
     2605         find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_fbr-line.doc-code
     2606                                                and buf_doc-line-attr.gds-code = buf_gds.gds-code
     2607                                                and buf_doc-line-attr.attr-code = "GTIN-qnty"
     2608                                                no-error .
     2609               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2610           ( input buf_gds.gds-code
     2611            ,input 'mark-type':U
     2612            ,output v-value
     2613            ,output v-type
     2614           )        no-error .
     2615         if error-status :error
     2616         then do:
     2617           undo, return error return-value .
     2618         end.
     2619         define variable brutto as decimal no-undo.
     2620         define variable netto as decimal no-undo.
     2621         assign
     2622           brutto = buf_fbr-line.fact-qnty
     2623           netto = (buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.recipe-brutto-qnty) * buf_fbr-recipe-gds.recipe-qnty
     2624         .
     2625         sw:start-element ("ingr").
     2626           write-data-element ("dish-code", string-mth (buf_recipe.gds-code)).
     2627           write-data-element ("rcp-code", buf_recipe.recipe-code).
     2628           write-data-element ("ingr-code", string-mth (buf_gds.gds-code)).
     2629           write-data-element ("qnty-b", string-mth (round (brutto, 3))).
     2630           write-data-element ("qnty-n", string-mth (round (netto, 3))).
     2631           write-data-element ("qnty-p", string-mth (round ((brutto - netto), 3))).
     2632           write-data-element ("perc-p", string-mth (round ((buf_fbr-line.coeff-value), 2))).
     2633           write-data-element ("u-price",string-mth (round ((buf_fbr-line.price-rubl), 2))).
     2634           write-data-element ("u-price-s", string-mth (round (buf_fbr-line.price-sum-rubl , 2))).
     2635           if available buf_doc-line-attr
     2636           and buf_doc-line-attr.attr-value > ""
     2637           and not isVarWeight
     2638           then do :
     2639             sw:start-element ("marks").
     2640             GT_ :
     2641             do vGT = 1 to num-entries(buf_doc-line-attr.attr-value, ";") :
     2642               assign
     2643                 vGtin = entry(1, entry(vGT, buf_doc-line-attr.attr-value, ";"), "=")
     2644                 vQnty = integer(entry(2, entry(vGT, buf_doc-line-attr.attr-value, ";"), "="))
     2645               no-error .
     2646               if error-status:error
     2647               then next GT_ .
     2648               sw:start-element ("mark").
     2649               write-data-element ("gtin", vGtin) .
     2650               write-data-element ("gtin-qnt", string-mth(vQnty)) .
     2651               sw:end-element ("mark").
     2652             end .
     2653             sw:end-element ("marks").
     2654           end .
     2655           if (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_fbr-doc.obj-type, buf_fbr-doc.obj-code):GetIsEDOForType(v-value) or isVarWeight) and
     2656              can-find(first buf_marking-lines where
     2657                             buf_marking-lines.gds-code = buf_gds.gds-code
     2658                         and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2659                         and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2660                         and buf_marking-lines.in-code  = "manufacturing"
     2661                         and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2662                         and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2663                         and buf_marking-lines.prt-code = 0
     2664                         and buf_marking-lines.doc-level = 1)
     2665           then do :
     2666             sw:start-element ("marks").
     2667             for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf_gds.gds-code
     2668                                                  and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2669                                                  and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2670                                                  and buf_marking-lines.in-code  = "manufacturing"
     2671                                                  and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2672                                                  and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2673                                                  and buf_marking-lines.prt-code = 0
     2674                                                  and buf_marking-lines.doc-level = 1
     2675             :
     2676               sw:start-element ("mark").
     2677               write-data-element ("mark-code", repTegforDm( addBracketForCode(buf_marking-lines.mark))).
     2678               sw:end-element ("mark").
     2679             end .
     2680             sw:end-element ("marks").
     2681           end .
     2682         sw:end-element ("ingr").
     2683       end.
     2684       sw:end-element ("ingrs").
     2685     end.
     2686     method private void StartDocFbr ():
     2687         sw:start-element ("trn-gd-doc") .
     2688   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2689   run usrfulnm in ibs.th.gbl.gbl-hndllib:g#library
     2690     (input  buf_fbr-doc.creid
     2691     ,output v-user-name
     2692     )  .
     2693           write-data-element ("doc-code", buf_fbr-doc.doc-code).
     2694           write-data-element ("doc-num", buf_fbr-doc.doc-code).
     2695           write-data-element ("del-f", string (isDel, "1/0") ).
     2696           write-data-element ("doc-date", if buf_fbr-doc.doc-date = ? then "" else substitute("&1T&2",iso-date(date(buf_fbr-doc.doc-date)), string(buf_fbr-doc.sys-time))).
     2697           write-data-element ("fact-date", if buf_fbr-doc.fact-date = ? then "" else iso-date (date (buf_fbr-doc.fact-date))).
     2698           write-data-element ("doc-type", v-doc-type-ERPRN).
     2699           write-data-element ("operator", v-user-name ).
     2700           write-data-element ("shift-date", if buf_fbr-doc.shift-date = ? then "" else iso-date (date (buf_fbr-doc.shift-date))).
     2701           write-data-element ("shift-num", if buf_fbr-doc.shift-num = ? then "0" else string-mth (buf_fbr-doc.shift-num)).
     2702     end.
     2703     method private void EndDocFbr ():
     2704       sw:end-element ("trn-gd-doc") .
     2705     end.
     2706     method private void write-data-element (inTag as char, inValue as char):
     2707       if inValue = ?
     2708       then do:
     2709         Msg = substitute ('Предупреждение отладки: тег &1 иммет не определнное значение. Работа будет продолжена...', inTag).
     2710       end.
     2711       if inTag = ?
     2712       then do:
     2713         Msg = substitute ('Предупреждение отладки: Имя тега не может быть пустым...').
     2714         return.
     2715       end.
     2716       if inTag = "acc-ship"
     2717       then do:
     2718         if string (inValue) begins "."
     2719           then inValue = "0" + inValue.
     2720       end.
     2721       inTag = lc (InTag).
     2722       if inValue = ?
     2723         then sw:write-empty-element (inTag).
     2724         else sw:write-data-element (inTag, inValue).
     2725     end.
     2726     method private character string-mth (inValue as integer):
     2727       def var v-str as character no-undo.
     2728       if inValue = ?
     2729         then v-str = "0".
     2730         else v-str = string (inValue).
     2731       return v-str.
     2732     end.
     2733     method private character string-mth (inValue as decimal):
     2734       def var v-str as character no-undo.
     2735       if inValue = ?
     2736       then do:
     2737           v-str = "0".
     2738           return v-str.
     2739       end.
     2740       if string (inValue) begins "."
     2741         then v-str = "0" + string (inValue).
     2742         else v-str = string (inValue).
     2743       return v-str.
     2744     end.
     2745   end class.
