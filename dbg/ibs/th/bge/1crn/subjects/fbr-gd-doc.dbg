      154   method public void setattrUtdMarkingLines
      155   (idb-num   as integer,
      156    idoc-id   as integer,
      157    ilinenum  as integer,
      158    imark     as character,
      159    iattrcode as character,
      160    iattrval  as character ):
      161      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      162      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      163                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      164                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      165                                          and utd-marking-lines-attr.mark      eq imark
      166                                          and utd-marking-lines-attr.attr-code eq iattrcode
      167      no-lock no-error.
      168      if not available utd-marking-lines-attr
      169      then do:
      170         if iattrval ne ?
      171            and iattrval ne ""
      172         then do:
      173            create utd-marking-lines-attr.
      174            assign
      175               utd-marking-lines-attr.db-num     = idb-num
      176               utd-marking-lines-attr.doc-id     = idoc-id
      177               utd-marking-lines-attr.lineNum    = ilineNum
      178               utd-marking-lines-attr.mark       = imark
      179               utd-marking-lines-attr.attr-code  = iattrcode
      180               utd-marking-lines-attr.attr-value = iattrval
      181            .
      182         end.
      183      end.
      184      else do:
      185         if utd-marking-lines-attr.attr-value ne iattrval
      186         then do:
      187            find current utd-marking-lines-attr exclusive-lock no-error.
      188            if available utd-marking-lines-attr
      189            then do:
      190               if    iattrval eq ?
      191                  or iattrval eq ""
      192               then do:
      193                  delete utd-marking-lines-attr.
      194               end.
      195               else do:
      196                  utd-marking-lines-attr.attr-value = iattrval.
      197               end.
      198            end.
      199         end.
      200      end.
      201      release utd-marking-lines-attr.
      202   end.
