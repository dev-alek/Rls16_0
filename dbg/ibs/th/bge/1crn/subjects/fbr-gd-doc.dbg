      416                       end.
      417                       when chr(4)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + " ":U
      421                           .
      422                       end.
      423                       when chr(5)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + " ":U
      427                           .
      428                       end.
      429                       when chr(6)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + " ":U
      433                           .
      434                       end.
      435                       when chr(7)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + " ":U
      439                           .
      440                       end.
      441                       when chr(8)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + " ":U
      445                           .
      446                       end.
      447                       when chr(9)
      448                       then do:
      449                           assign
