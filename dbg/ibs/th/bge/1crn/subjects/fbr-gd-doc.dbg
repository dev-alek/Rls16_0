       14   method public char getattrUtdEx
       15   (idb-num   as integer,
       16    idoc-id   as integer,
       17    iattrcode as character,
       18    iExValue  as character  ):
       19      define buffer utd-attr for utd-attr.
       20      find first utd-attr where utd-attr.db-num eq idb-num
       21                            and utd-attr.doc-id eq idoc-id
       22                            and utd-attr.attr-code eq iattrcode
       23      no-lock no-error.
       24      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
       25   end.
       26   method public char getattrUtd
       27   (idb-num   as integer,
       28    idoc-id   as integer,
       29    iattrcode as character ):
       30     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
       31   end.
       32   method public void setattrUtd
       33   (idb-num   as integer,
       34    idoc-id   as integer,
       35    iattrcode as character,
       36    iattrval  as character ):
       37      define buffer utd-attr for utd-attr.
       38      find first utd-attr where utd-attr.db-num eq idb-num
       39                            and utd-attr.doc-id eq idoc-id
       40                            and utd-attr.attr-code eq iattrcode
       41      no-lock no-error.
       42      if not available utd-attr
       43      then do:
       44         create utd-attr.
       45         assign
       46            utd-attr.db-num    = idb-num
       47            utd-attr.doc-id    = idoc-id
       48            utd-attr.attr-code = iattrcode
       49            utd-attr.attr-value = iattrval
       50         .
       51      end.
       52      else do:
       53         if utd-attr.attr-value ne iattrval
       54         then do:
       55            find current utd-attr exclusive-lock no-error.
       56            if available utd-attr
       57            then
       58               utd-attr.attr-value = iattrval.
       59         end.
       60      end.
       61      release utd-attr.
       62   end.
       63   method public char GetAttrUtdlinesEx
       64   (idb-num   as integer,
       65    idoc-id   as integer,
       66    ilinenum  as integer,
       67    iattrcode as character,
       68    iExValue  as character  ):
       69      define buffer utd-lines-attr for utd-lines-attr.
       70      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
       71                                  and utd-lines-attr.doc-id    eq idoc-id
       72                                  and utd-lines-attr.lineNum   eq ilineNum
       73                                  and utd-lines-attr.attr-code eq iattrcode
       74      no-lock no-error.
       75      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
       76   end.
       77   method public char GetAttrUtdlines
       78   (idb-num   as integer,
       79    idoc-id   as integer,
       80    ilinenum  as integer,
       81    iattrcode as character ):
       82      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
       83   end.
       84   method public void setattrUtdlines
       85   (idb-num   as integer,
       86    idoc-id   as integer,
       87    ilinenum  as integer,
       88    iattrcode as character,
       89    iattrval  as character ):
       90      define buffer utd-lines-attr for utd-lines-attr.
       91      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
       92                                  and utd-lines-attr.doc-id    eq idoc-id
       93                                  and utd-lines-attr.lineNum   eq ilineNum
       94                                  and utd-lines-attr.attr-code eq iattrcode
       95      no-lock no-error.
       96      if not available utd-lines-attr
       97      then do:
       98         if iattrval ne ?
       99            and iattrval ne ""
      100         then do:
      101            create utd-lines-attr.
      102            assign
      103               utd-lines-attr.db-num    = idb-num
      104               utd-lines-attr.doc-id    = idoc-id
      105               utd-lines-attr.lineNum   = ilineNum
      106               utd-lines-attr.attr-code = iattrcode
      107               utd-lines-attr.attr-value = iattrval
      108            .
      109         end.
      110      end.
      111      else do:
      112         if utd-lines-attr.attr-value ne iattrval
      113         then do:
      114            find current utd-lines-attr exclusive-lock no-error.
      115            if available utd-lines-attr
      116            then do:
      117               if    iattrval eq ?
      118                  or iattrval eq ""
      119               then do:
      120                  delete utd-lines-attr.
      121               end.
      122               else do:
      123                  utd-lines-attr.attr-value = iattrval.
      124               end.
      125            end.
      126         end.
      127      end.
      128      release utd-lines-attr.
      129   end.
