      210   method private void xmlchar-test (input  p-in-string          as character,
      211                                     output p-out-string-enc     as character,
      212                                     output p-out-string-dec    as character):
      213   do
      214   on error undo, return error
      215   :
      216          xmlchar-encode
      217       (
      218             input p-in-string
      219           , output p-out-string-enc
      220       ).
      221          xmlchar-decode
      222       (
      223             input p-out-string-enc
      224           , output p-out-string-dec
      225       ).
      226   end.
      227   end .
      228   method private void xmlchar-encode (input  p-in-string          as character,
      229                                     output p-out-string         as character):
      230       define variable v-position      as integer      no-undo.
      231       define variable v-current-char  as character    no-undo.
      232   do
      233   on error undo, return error
      234   :
      235       assign
      236           p-out-string = "":U
      237       .
      238       case p-in-string
      239       :
      240           when ?
      241           then do:
      242               assign
      243                   p-out-string = "?":U
      244               .
      245           end.
      246           when "?":U
      247           then do:
      248               assign
      249                   p-out-string = "&#63;":U
      250               .
      251           end.
      252           otherwise do:
      253               do v-position = 1 to length( p-in-string )
      254               :
      255                   assign
      256                       v-current-char = substring( p-in-string, v-position, 1 )
      257                   .
      258                   case v-current-char
      259                   :
      260                       when "&":U
      261                       then do:
      262                           assign
      263                               p-out-string = p-out-string + "&amp;":U
      264                           .
      265                       end.
      266                       when ">":U
      267                       then do:
      268                           assign
      269                               p-out-string = p-out-string + "&gt;":U
      270                           .
      271                       end.
      272                       when "<":U
      273                       then do:
      274                           assign
      275                               p-out-string = p-out-string + "&lt;":U
      276                           .
      277                       end.
      278                       when "'":U
      279                       then do:
      280                           assign
      281                               p-out-string = p-out-string + "&apos;":U
      282                           .
      283                       end.
      284                       when '"':U
      285                       then do:
      286                           assign
      287                               p-out-string = p-out-string + "&quot;":U
      288                           .
      289                       end.
      290                       when chr(1)
      291                       then do:
      292                           assign
      293                               p-out-string = p-out-string + "":U
      294                           .
      295                       end.
      296                       when chr(2)
      297                       then do:
      298                           assign
      299                               p-out-string = p-out-string + "":U
      300                           .
      301                       end.
      302                       when chr(3)
      303                       then do:
      304                           assign
      305                               p-out-string = p-out-string + "":U
      306                           .
      307                       end.
      308                       when chr(4)
      309                       then do:
      310                           assign
      311                               p-out-string = p-out-string + "":U
      312                           .
      313                       end.
      314                       when chr(5)
      315                       then do:
      316                           assign
      317                               p-out-string = p-out-string + "":U
      318                           .
      319                       end.
      320                       when chr(6)
      321                       then do:
      322                           assign
      323                               p-out-string = p-out-string + "":U
      324                           .
      325                       end.
      326                       when chr(7)
      327                       then do:
      328                           assign
      329                               p-out-string = p-out-string + "":U
      330                           .
      331                       end.
      332                       when chr(8)
      333                       then do:
      334                           assign
      335                               p-out-string = p-out-string + "":U
      336                           .
      337                       end.
      338                       when chr(9)
      339                       then do:
      340                           assign
      341                               p-out-string = p-out-string + "":U
      342                           .
      343                       end.
      344                       when chr(29)
      345                       then do:
      346                           assign
      347                               p-out-string = p-out-string + "":U
      348                           .
      349                       end.
      350                       when chr(10)
      351                       then do:
      352                           assign
      353                               p-out-string = p-out-string + "&#10;":U
      354                           .
      355                       end.
      356                       when chr(13)
      357                       then do:
      358                           assign
      359                               p-out-string = p-out-string + "&#13;":U
      360                           .
      361                       end.
      362                       otherwise do:
      363                           assign
      364                               p-out-string = p-out-string + v-current-char
      365                           .
      366                       end.
      367                   end case.
      368               end.
      369           end.
      370       end case.
      371   end.
      372   end .
      373   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      374   define variable p-out-string as character no-undo.
      375       define variable v-position      as integer      no-undo.
      376       define variable v-current-char  as character    no-undo.
      377   do
      378   on error undo, return error
