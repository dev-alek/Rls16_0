        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.contr-price-docs from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.contr-price-docs inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property doc-id      as character    no-undo get. private set.
       12     define property doc-num     as character    no-undo get. private set.
       13     define property doc-date    as character    no-undo get. private set.
       14     define property contr-code  as character    no-undo get. private set.
       15     define property cont-code   as character    no-undo get. private set.
       16     define property price-list  as subjects     no-undo get. private set.
       17     define override property InitTag as character no-undo init "contr-price-doc"
       18       get.
       19     constructor public contr-price-docs ():
       20       InitListTag = "price-list".
       21     end constructor.
       22             method override protected void SetPropProtected (inTag as char, inValue as char):
       23       case inTag:
       24         when "doc-id"     then doc-id     = if inValue >= "" then inValue else "" .
       25         when "doc-num"    then doc-num    = if inValue >= "" then inValue else "" .
       26         when "doc-date"   then doc-date   = if inValue >= "" then inValue else "" .
       27         when "contr-code" then contr-code = if inValue >= "" then inValue else "" .
       28         when "cont-code"  then cont-code  = if inValue >= "" then inValue else "" .
       29       end case.
       30       catch exProErrors as class Progress.Lang.ProError :
       31         case exProErrors:GetMessageNum(1):
       32           when 18207 then undo, throw new Progress.Lang.AppError(
       33             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       34           ) .
       35           otherwise undo, throw new Progress.Lang.AppError(
       36             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       37           ) .
       38         end case .
       39       end catch .
       40     end method.
       41     method override protected void SetPropProtected(SubsObj as subjects):
       42       case SubsObj:InitTag:
       43         when "price-list" then price-list = SubsObj.
       44       end case.
       45     end method.
       46     method override protected void CheckData ():
       47       def var v-str as char no-undo.
       48       assign
       49         v-str = v-str + ",cont-code" when cont-code = ?
       50       .
       51       v-str = substring(v-str, 2).
       52       if v-str > "" then undo, throw new Progress.Lang.AppError(
       53         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       54       ) .
       55     end method.
       56     method override protected void ClearSub():
       57       assign
       58         doc-id       = ?
       59         doc-num      = ?
       60         doc-date     = ?
       61         contr-code   = ?
       62         cont-code    = ?
       63       .
       64       if valid-object(price-list) then delete object price-list no-error .
       65     end.
       66   end class.
