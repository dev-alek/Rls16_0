        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.shops inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property name_ as character no-undo
       19       get.
       20       private set.
       21   define property hist-code as character no-undo
       22       get.
       23       private set.
       24   define property hist-name as character no-undo
       25       get.
       26       private set.
       27     define property frm-code as character no-undo
       28       get.
       29       private set.
       30     define property grp-code as character no-undo
       31       get.
       32       private set.
       33     define property address as character no-undo
       34       get.
       35       private set.
       36     define property tel as character no-undo
       37       get.
       38       private set.
       39     define property director as character no-undo
       40       get.
       41       private set.
       42     define property accr as character no-undo
       43       get.
       44       private set.
       45     define property cafe_exist as integer no-undo
       46       get.
       47       private set.
       48     define property clim-grp as character no-undo
       49       get.
       50       private set.
       51     define property begin-summer as character no-undo
       52       get.
       53       private set.
       54     define property begin-winter as character no-undo
       55       get.
       56       private set.
       57     define property decommissioned as integer no-undo
       58       get.
       59       private set.
       60     define property kpp as character no-undo
       61       get.
       62       private set.
       63     define property edi as integer no-undo
       64       get.
       65       private set.
       66     define override property InitTag as character no-undo init "azk"
       67       get.
       68     method override protected void SetPropProtected (inTag as char, inValue as char):
       69       case inTag:
       70         when "code"           then code_          = if inValue >= "" then inValue else "" .
       71         when "del-l"          then del-l          = if inValue >= "" then integer (inValue) else 0 .
       72         when "del-f"          then del-f          = if inValue >= "" then integer (inValue) else 0 .
       73         when "name"           then name_          = if inValue >= "" then inValue else "" .
       74         when "hist-code"      then Hist-code      = if inValue >= "" then inValue else "" .
       75         when "hist-name"      then hist-name      = if inValue >= "" then inValue else "" .
       76         when "frm-code"       then frm-code       = if inValue >= "" then inValue else "" .
       77         when "grp-code"       then grp-code       = if inValue >= "" then inValue else "" .
       78         when "address"        then address        = if inValue >= "" then inValue else "" .
       79         when "tel"            then tel            = if inValue >= "" then inValue else "" .
       80         when "director"       then director       = if inValue >= "" then inValue else "" .
       81         when "accr"           then accr           = if inValue >= "" then inValue else "" .
       82         when "cafe_exist"     then cafe_exist     = if inValue >= "" then integer (inValue) else 0 .
       83         when "clim-grp"       then clim-grp       = if inValue >= "" then inValue else "" .
       84         when "begin-summer"   then begin-summer   = if inValue >= "" then inValue else "" .
       85         when "begin-winter"   then begin-winter   = if inValue >= "" then inValue else "" .
       86         when "decommissioned" then decommissioned = if inValue >= "" then integer (inValue) else 0 .
       87         when "kpp"            then kpp            = if inValue >= "" then inValue else "" .
       88         when "edi"            then edi            = if inValue >= "" then integer (inValue) else 0 .
       89       end case.
       90     end method.
       91     method override protected void CheckData ():
       92       def var v-str as char no-undo.
       93       assign
       94         v-str = ",code" when code_ = ?
       95         v-str = v-str + ",name" when name_ = ?
       96         v-str = v-str + ",frm-code" when frm-code = ?
       97         v-str = v-str + ",clim-grp" when clim-grp = ?
       98         v-str = v-str + ",begin-summer" when begin-summer = ?
       99         v-str = v-str + ",begin-winter" when begin-winter = ?
      100       .
      101       v-str = substring(v-str, 2).
      102       if v-str > "" then undo, throw new Progress.Lang.AppError(
      103         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      104       ) .
      105     end method.
      106     method override protected void ClearSub():
      107       assign
      108         code_      = ?
      109         del-l      = ?
      110         del-f      = ?
      111         name_      = ?
      112         frm-code   = ?
      113         hist-name  = ?
      114         hist-code  = ?
      115         grp-code   = ?
      116         address    = ?
      117         tel        = ?
      118         director   = ?
      119         accr       = ?
      120         cafe_exist = ?
      121         clim-grp       = ?
      122         begin-summer   = ?
      123         begin-winter   = ?
      124         decommissioned = ?
      125         kpp        = ?
      126         edi        = ?
      127       .
      128     end method.
      129   end class.
