        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.rvd-reason inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property type_         as integer      no-undo get.
       10       private set.
       11     define property code_         as character    no-undo get.
       12       private set.
       13     define property del-l         as integer      no-undo get.
       14       private set.
       15     define property del-f         as integer      no-undo get.
       16       private set.
       17     define property name_         as character    no-undo get.
       18       private set.
       19     define property description_  as character    no-undo get.
       20       private set.
       21     define override property InitTag as character no-undo init "rvd-reason"
       22       get.
       23     method override protected void SetPropProtected (inTag as char, inValue as char):
       24       case inTag:
       25         when "type" then
       26           do:
       27             assign
       28               type_ = integer (inValue).
       29           end.
       30         when "code" then
       31           do:
       32             assign
       33               code_ = inValue .
       34           end.
       35         when "del-l" then
       36           do:
       37             assign
       38               del-l = integer (inValue).
       39           end.
       40         when "del-f" then
       41           do:
       42             assign
       43               del-f = integer (inValue).
       44           end.
       45         when "name" then
       46           do:
       47             assign
       48               name_ = inValue .
       49           end.
       50         when "description" then
       51           do:
       52             assign
       53               description_ = inValue .
       54           end.
       55       end case.
       56     end.
       57     method override protected void CheckData ():
       58       def var v-str as char no-undo.
       59       assign
       60         v-str = "code"
       61         when code_ = ?
       62         v-str = v-str + ",type"
       63         when type_ = ?
       64         v-str = v-str + ",name"
       65         when name_ = ?
       66       .
       67       v-str = trim (v-str, ",").
       68       if v-str > ''
       69         then
       70         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       71     end.
       72     method override protected void ClearSub():
       73       assign
       74         type_         = ?
       75         code_         = ?
       76         del-l         = ?
       77         del-f         = ?
       78         name_         = ?
       79         description_  = ""
       80       .
       81     end.
       82   end class.
