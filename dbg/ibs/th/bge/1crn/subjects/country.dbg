        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.country inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property name_ as character no-undo
       19       get.
       20       private set.
       21     define property full-name as character no-undo
       22       get.
       23       private set.
       24     define property alfa2 as character no-undo
       25       get.
       26       private set.
       27     define property alfa3 as character no-undo
       28       get.
       29       private set.
       30     define override property InitTag as character no-undo init "country"
       31       get.
       32     method override protected void SetPropProtected (inTag as char, inValue as char):
       33       case inTag:
       34         when "code" then do:
       35           assign code_ = inValue.
       36         end.
       37         when "del-l" then do:
       38           assign del-l = integer (inValue).
       39         end.
       40         when "del-f" then do:
       41           assign del-f = integer (inValue).
       42         end.
       43         when "name" then do:
       44           assign name_ = inValue .
       45         end.
       46         when "full-name" then do:
       47           assign full-name = inValue .
       48         end.
       49         when "alfa2" then do:
       50           assign alfa2 = inValue .
       51         end.
       52         when "alfa3" then do:
       53           assign alfa3 = inValue .
       54         end.
       55       end case.
       56     end.
       57     method override protected void CheckData ():
       58       def var v-str as char no-undo.
       59       assign
       60         v-str = "code" when code_ = ?
       61       .
       62       v-str = trim (v-str, ",").
       63       if v-str > ''
       64       then
       65         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       66     end.
       67     method override protected void ClearSub():
       68       assign
       69         code_     = ?
       70         del-l     = ?
       71         del-f     = ?
       72         name_     = ?
       73         full-name = ?
       74         alfa2     = ?
       75         alfa3     = ?
       76       .
       77     end.
       78   end class.
