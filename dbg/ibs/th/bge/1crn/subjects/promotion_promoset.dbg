        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   class ibs.th.bge.1crn.subjects.promotion_promoset inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property ps-Price as decimal    no-undo get. private set.
       11     define property ps-sections as subjects no-undo
       12       get.
       13       private set.
       14     define override property InitTag as character no-undo init "promoset"
       15       get.
       16     constructor public promotion_promoset ():
       17       InitListTag = "ps-sections".
       18     end constructor.
       19             method override protected void SetPropProtected (inTag as char, inValue as char):
       20       case inTag:
       21         when "ps-Price"   then ps-Price   = if inValue >= "" then decimal (inValue) else 0.0 .
       22       end case.
       23       catch exProErrors as class Progress.Lang.ProError :
       24         case exProErrors:GetMessageNum(1):
       25           when 18207 then undo, throw new Progress.Lang.AppError(
       26             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       27           ) .
       28           otherwise undo, throw new Progress.Lang.AppError(
       29             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       30           ) .
       31         end case .
       32       end catch .
       33     end method.
       34     method override protected void SetPropProtected (SubsObj as subjects):
       35       case SubsObj:InitTag:
       36         when "ps-sections" then ps-sections = SubsObj.
       37       end case.
       38     end method.
       39     method override protected void CheckData ():
       40       def var v-str as char no-undo.
       41       assign
       42         v-str = ",ps-Price" when ps-Price = ?
       43         v-str = v-str + ",ps-sections" when not valid-object(ps-sections)
       44       .
       45       v-str = substring(v-str, 2).
       46       if v-str > "" then undo, throw new Progress.Lang.AppError(
       47         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       48       ) .
       49     end method .
       50     method override protected void ClearSub():
       51       assign
       52         ps-Price   = ?
       53       .
       54       if valid-object(ps-sections) then delete object ps-sections .
       55     end method .
       56   end class.
