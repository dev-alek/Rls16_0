        1   USING Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.bank-accounts from propath.
        4   using ibs.th.bge.1crn.subjects.bank-accounts_bank from propath.
        5   using ibs.th.bge.1crn.subjects.isubject from propath.
        6   block-level on error undo, throw.
        7   CLASS ibs.th.bge.1crn.subjects.bank-accounts inherits ibs.th.bge.1crn.subjects.asubject:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define property r-schet     as character    no-undo get.
       14       private set.
       15     define property del-l       as integer      no-undo get.
       16       private set.
       17     define property del-f       as integer      no-undo get.
       18       private set.
       19     define property cont-code   as character    no-undo get.
       20       private set.
       21     define property bank        as bank-accounts_bank     no-undo get .
       22       private set .
       23     define override property InitTag as character no-undo init "bank-account"
       24       get.
       25     constructor public bank-accounts ():
       26       InitListTag = "bank".
       27     end constructor.
       28     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       29       case inTag:
       30         when "r-schet" then
       31           do:
       32             assign
       33               r-schet = inValue .
       34           end.
       35         when "del-l" then
       36           do:
       37             assign
       38               del-l = integer (inValue).
       39           end.
       40         when "del-f" then
       41           do:
       42             assign
       43               del-f = integer (inValue).
       44           end.
       45         when "cont-code" then
       46           do:
       47             assign
       48               cont-code = inValue .
       49           end.
       50       end case.
       51     end.
       52     method override protected void SetPropProtected(SubsObj as isubject):
       53       bank = cast (SubsObj, bank-accounts_bank).
       54     end.
       55     method override protected void CheckData ():
       56       def var v-str as char no-undo.
       57       assign
       58         v-str = "r-schet"
       59         when r-schet = ?
       60         v-str = v-str + ",cont-code"
       61         when cont-code = ?
       62         .
       63       v-str = trim (v-str, ",").
       64       if v-str > ''
       65         then
       66         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       67     end.
       68     method override protected void ClearSub():
       69       assign
       70         r-schet   = ?
       71         del-l     = ?
       72         del-f     = ?
       73         cont-code = ?
       74         .
       75       delete object bank no-error .
       76     end.
       77   END CLASS.
