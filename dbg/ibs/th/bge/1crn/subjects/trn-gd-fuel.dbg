        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.trn-gd-fuel inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property line-num as character no-undo
       10       get.
       11       private set.
       12     define property gd-code as integer no-undo
       13       get.
       14       private set.
       15     define property cap-ttn as decimal no-undo
       16       get.
       17       private set.
       18     define property wght-ttn as decimal no-undo
       19       get.
       20       private set.
       21     define property dnsty-ttn as decimal no-undo
       22       get.
       23       private set.
       24     define property sum as decimal no-undo
       25       get.
       26       private set.
       27     define property cap-fact as decimal no-undo
       28       get.
       29       private set.
       30     define property wght-fact as decimal no-undo
       31       get.
       32       private set.
       33     define property dnsty-fact as decimal no-undo
       34       get.
       35       private set.
       36     define override property InitTag as character no-undo init "gd"
       37       get.
       38     method override protected void SetPropProtected (inTag as char, inValue as char):
       39       case inTag:
       40         when "line-num" then do:
       41           assign line-num = inValue.
       42         end.
       43         when "gd-code" then do:
       44           assign gd-code = integer (inValue).
       45         end.
       46         when "cap-ttn" then do:
       47           assign cap-ttn = decimal (inValue).
       48         end.
       49         when "wght-ttn" then do:
       50           assign wght-ttn = decimal (inValue) .
       51         end.
       52         when "dnsty-ttn" then do:
       53           assign dnsty-ttn = decimal (inValue).
       54         end.
       55         when "cap-fact" then do:
       56           assign cap-fact = decimal (inValue).
       57         end.
       58         when "wght-fact" then do:
       59           assign wght-fact = decimal (inValue).
       60         end.
       61         when "dnsty-fact" then do:
       62           assign dnsty-fact = decimal (inValue).
       63         end.
       64         when "sum" then do:
       65           assign sum = decimal (inValue).
       66         end.
       67       end case.
       68     end.
       69     method override protected void CheckData ():
       70       def var v-str as char no-undo.
       71       assign
       72         v-str = v-str + ",gd-code" when gd-code = ?
       73       .
       74       v-str = trim (v-str, ",").
       75       if v-str > ''
       76       then
       77         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       78     end.
       79     method override protected void ClearSub():
       80       assign
       81         line-num  = ?
       82         gd-code   = ?
       83         cap-ttn   = ?
       84         wght-ttn  = ?
       85         dnsty-ttn = ?
       86         cap-fact  = ?
       87         wght-fact = ?
       88         dnsty-fact = ?
       89         sum = ?
       90       .
       91     end.
       92   end class.
