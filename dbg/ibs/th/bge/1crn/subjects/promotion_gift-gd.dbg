        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   class ibs.th.bge.1crn.subjects.promotion_gift-gd inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-code as character  no-undo get. private set. // 1-1 Код товара
       10     define property gd-qnty as decimal    no-undo get. private set. // 1-1 количество
       11     define override property InitTag as character no-undo init "gd"
       12       get.
       13             method override protected void SetPropProtected (inTag as char, inValue as char):
       14       case inTag:
       15         when "gd-code" then gd-code = if inValue >= "" then inValue else "" .
       16         when "gd-qnty" then gd-qnty = if inValue >= "" then decimal (inValue) else 0.0 .
       17       end case.
       18       catch exProErrors as class Progress.Lang.ProError :
       19         case exProErrors:GetMessageNum(1):
       20           when 18207 then undo, throw new Progress.Lang.AppError(
       21             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       22           ) .
       23           otherwise undo, throw new Progress.Lang.AppError(
       24             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       25           ) .
       26         end case .
       27       end catch .
       28     end method.
       29     method override protected void CheckData ():
       30       def var v-str as char no-undo.
       31       assign
       32         v-str = ",gd-code" when gd-code = ?
       33         v-str = v-str + ",gd-qnty" when gd-qnty = ?
       34       .
       35       v-str = substring(v-str, 2).
       36       if v-str > "" then undo, throw new Progress.Lang.AppError(
       37         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       38       ) .
       39     end method .
       40     method override protected void ClearSub():
       41       assign
       42         gd-code = ?
       43         gd-qnty = ?
       44       .
       45     end method .
       46   end class.
