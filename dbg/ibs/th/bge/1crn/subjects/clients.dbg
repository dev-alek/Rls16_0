        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.clients from propath.
        4   using ibs.th.bge.1crn.subjects.clients_suppliers from propath.
        5   using ibs.th.bge.1crn.subjects.clients_carriers from propath.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.1crn.subjects.clients inherits ibs.th.bge.1crn.subjects.asubject:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define property code_ as character no-undo
       14       get.
       15       private set.
       16     define property del-l as integer no-undo
       17       get.
       18       private set.
       19     define property del-f as integer no-undo
       20       get.
       21       private set.
       22     define property name_ as character no-undo
       23       get.
       24       private set.
       25     define property full-name as character no-undo
       26       get.
       27       private set.
       28     define property nb-carriers     as subjects     no-undo get.
       29       private set.
       30     define property nb-suppliers    as subjects     no-undo get.
       31       private set.
       32     define property grp-code as character no-undo
       33       get.
       34       private set.
       35     define property city as character no-undo
       36       get.
       37       private set.
       38     define property ind as character no-undo
       39       get.
       40       private set.
       41     define property inn as character no-undo
       42       get.
       43       private set.
       44     define property kpp as character no-undo
       45       get.
       46       private set.
       47     define property agnt as character no-undo
       48       get.
       49       private set.
       50     define property post-adr as character no-undo
       51       get.
       52       private set.
       53     define property e-mail as character no-undo
       54       get.
       55       private set.
       56     define property leg-adr as character no-undo
       57       get.
       58       private set.
       59     define property okpo as character no-undo
       60       get.
       61       private set.
       62     define property post-np     as integer    no-undo
       63       get.
       64       private set.
       65     define property post-sug     as integer    no-undo
       66       get.
       67       private set.
       68     define property own-post    as integer    no-undo
       69       get.
       70       private set.
       71     define property post-npz     as integer    no-undo
       72       get.
       73       private set.
       74     define property code-KSK as character no-undo
       75       get.
       76       private set.
       77     define property code-AIS as character no-undo
       78       get.
       79       private set.
       80     define property org-code as character no-undo
       81       get.
       82       private set.
       83     define override property InitTag as character no-undo init "contractor"
       84       get.
       85     constructor public clients ():
       86       InitListTag = "nb-carriers,nb-suppliers".
       87     end constructor.
       88     method override protected void SetPropProtected (inTag as char, inValue as char):
       89       case inTag:
       90         when "code"      then
       91           code_     = if inValue >= "" then inValue else "" .
       92         when "del-l"     then
       93           del-l     = if inValue >= "" then integer (inValue) else 0 .
       94         when "del-f"     then
       95           del-f     = if inValue >= "" then integer (inValue) else 0 .
       96         when "name"      then
       97           name_     = if inValue >= "" then inValue else "" .
       98         when "full-name" then
       99           full-name = if inValue >= "" then inValue else "" .
      100         when "grp-code"  then
      101           grp-code  = if inValue >= "" then inValue else "" .
      102         when "city"      then
      103           city      = if inValue >= "" then inValue else "" .
      104         when "ind"       then
      105           ind       = if inValue >= "" then inValue else "" .
      106         when "inn"       then
      107           inn       = if inValue >= "" then inValue else "" .
      108         when "kpp"       then
      109           kpp       = if inValue >= "" then inValue else "" .
      110         when "agnt"      then
      111           agnt      = if inValue >= "" then inValue else "" .
      112         when "post-adr"  then
      113           post-adr  = if inValue >= "" then inValue else "" .
      114         when "e-mail"    then
      115           e-mail    = if inValue >= "" then inValue else "" .
      116         when "leg-adr"   then
      117           leg-adr   = if inValue >= "" then inValue else "" .
      118         when "okpo"      then
      119           okpo      = if inValue >= "" then inValue else "" .
      120         when "post-np"      then
      121           post-np      = if inValue >= "" then int(inValue) else 0 .
      122         when "post-sug"      then
      123           post-sug      = if inValue >= "" then int(inValue) else 0 .
      124         when "own"      then
      125           own-post      = if inValue >= "" then int(inValue) else 0 .
      126         when "npz"      then
      127           post-npz      = if inValue >= "" then int(inValue) else 0 .
      128         when "code-KSK"      then
      129           code-KSK      = if inValue >= "" then inValue else "" .
      130         when "code-AIS"      then
      131           code-AIS      = if inValue >= "" then inValue else "" .
      132         when "org-code"      then
      133           org-code      = if inValue >= "" then inValue else "" .
      134       end case.
      135     end method.
      136     method override protected void SetPropProtected(SubsObj as subjects):
      137       case SubsObj:InitTag:
      138         when "nb-carriers" then
      139           do:
      140             nb-carriers = SubsObj.
      141           end.
      142         when "nb-suppliers" then
      143           do:
      144             nb-suppliers = SubsObj.
      145           end.
      146       end case.
      147     end.
      148     method override protected void CheckData ():
      149       def var v-str as char no-undo.
      150       assign
      151         v-str = ",code"
      152         when code_ = ?
      153         v-str = v-str + ",name"
      154         when name_ = ?
      155         .
      156       v-str = substring(v-str, 2).
      157       if v-str > "" then undo, throw new Progress.Lang.AppError(
      158           substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      159           ) .
      160     end method.
      161     method override protected void ClearSub():
      162       assign
      163         code_     = ?
      164         del-l     = ?
      165         del-f     = ?
      166         name_     = ?
      167         full-name = ?
      168         grp-code  = ?
      169         city      = ?
      170         ind       = ?
      171         inn       = ?
      172         kpp       = ?
      173         agnt      = ?
      174         post-adr  = ?
      175         e-mail    = ?
      176         leg-adr   = ?
      177         okpo      = ?
      178         post-np   = ?
      179         post-sug  = ?
      180         own-post  = ?
      181         post-npz  = ?
      182         code-KSK  = ?
      183         code-AIS  = ?
      184         org-code  = ?
      185         .
      186     end method.
      187   end class.
