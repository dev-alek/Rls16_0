        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.export.send1cerpsub.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.exp-order inherits send1cerpsub:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Выгрузка Заказов в 1С" get.
       12       define override public property InitSecTag as character no-undo init 'orders':U
       13     get.
       14     define override public property sendTableName as character no-undo init "order-doc"
       15       get.
       16      method override public void CheckParam(  ):
       17       define buffer buf_order-doc  for ub.order-doc .
       18       define buffer buf_order-line for ub.order-line .
       19       if not valid-handle(oldbh) then
       20       do:
       21         Msg = "Не передана ссылка на заказ.".
       22         return error.
       23       end.
       24       if oldbh:keys ne "db-num,doc-code" then
       25       do:
       26         Msg = "Передан не Заказ.".
       27         return error.
       28       end.
       29       find first buf_order-doc no-lock where
       30                  buf_order-doc.db-num   = int(oldbh:buffer-field( "db-num":U  ):buffer-value )
       31              and buf_order-doc.doc-code = int(oldbh:buffer-field( "doc-code":U  ):buffer-value ) no-error .
       32       if not avail buf_order-doc then
       33       do:
       34         Msg = substitute("Заказ &1 не найден.", oldbh:buffer-field( "doc-code":U  ):buffer-value).
       35         return error.
       36       end.
       37       if can-find(first buf_order-line where
       38                         buf_order-line.db-num     = buf_order-doc.db-num
       39                     and buf_order-line.doc-code   = buf_order-doc.doc-code
       40                     and buf_order-line.order-qnty <= 0) then
       41       do:
       42         Msg = substitute("В заказе &1 не должно быть строк с количеством <= 0.", oldbh:buffer-field( "doc-code":U  ):buffer-value).
       43         return error.
       44       end.
       45       return.
       46      end method.
       47     method override public void CrContentToSW (insw as handle):
       48       define buffer buf_order-doc  for ub.order-doc .
       49       define buffer buf_order-line for ub.order-line .
       50       define buffer buf_user-account for ub.user-account .
       51       find first buf_order-doc no-lock where
       52                  buf_order-doc.db-num   = int(oldbh:buffer-field( "db-num":U  ):buffer-value )
       53              and buf_order-doc.doc-code = int(oldbh:buffer-field( "doc-code":U  ):buffer-value ) no-error .
       54       sendOldRowid = rowid(buf_order-doc) .
       55       insw:start-element ('order':U) .
       56       insw:write-data-element (  "order-item":U,  string(buf_order-doc.doc-code)  ).
       57       insw:write-data-element (  "sup-code":U,    string(buf_order-doc.cli-code)  ).
       58       insw:write-data-element (  "cont-code":U,   string(buf_order-doc.contract-code)  ).
       59       insw:write-data-element (  "doc-datetime":U, formatDateTime(buf_order-doc.doc-date)  ).
       60       insw:write-data-element (  "order-date":U,   formatDate(buf_order-doc.order-date)  ).
       61       insw:write-data-element (  "creator-order":U,getCreatorOrder(buf_order-doc.user-id)  ).
       62       insw:start-element ('order-goods':U) .
       63       for each buf_order-line no-lock where
       64                buf_order-line.db-num   = buf_order-doc.db-num
       65            and buf_order-line.doc-code = buf_order-doc.doc-code:
       66         insw:start-element ('order-good':U) .
       67         insw:write-data-element (  "gd-code":U,   string(buf_order-line.gds-code)  ).
       68         insw:write-data-element (  "amount":U,    string(buf_order-line.order-qnty)  ).
       69         insw:end-element ('order-good':U) .
       70       end .
       71       insw:end-element ('order-goods':U) .
       72       insw:end-element ('order':U) .
       73       finally:
       74           if Msg <> "" then
       75             return error Msg.
       76       end finally.
       77     end method .
       78     method private character formatDateTime (iDateTime as datetime) :
       79       define variable vDateTime as character no-undo .
       80       if (iDateTime = ?) then vDateTime = "" .
       81       else
       82          vDateTime =  entry(1,iso-date(iDateTime),".")
       83       .
       84       return vDateTime .
       85     end method .
       86     method private character formatDate (iDate as date) :
       87       return if (iDate = ?) then "" else iso-date(iDate) .
       88     end method .
       89     method private character getCreatorOrder (iUserId as character) :
       90       define variable vUserName as character no-undo.
       91       define buffer buf_user-account for ub.user-account .
       92       if iUserId <> '' then
       93       do:
       94         find first buf_user-account no-lock where
       95                    buf_user-account.user-id = iUserId no-error .
       96         if available (buf_user-account) then
       97           vUserName = trim(buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name) .
       98       end.
       99       return vUserName.
      100     end method .
      101   end class.
