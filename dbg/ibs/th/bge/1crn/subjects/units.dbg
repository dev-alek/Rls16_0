        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.units inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property okei-code   as character    no-undo get. private set.
       10     define property del-l       as integer      no-undo get. private set.
       11     define property del-f       as integer      no-undo get. private set.
       12     define property name_       as character    no-undo get. private set.
       13     define property full-name   as character    no-undo get. private set.
       14     define property type_       as integer      no-undo get. private set.
       15     define override property InitTag as character no-undo init "unit"
       16       get.
       17     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "okei-code" then do:
       20           assign okei-code = inValue .
       21         end.
       22         when "del-l" then do:
       23           assign del-l = integer (inValue).
       24         end.
       25         when "del-f" then do:
       26           assign del-f = integer (inValue).
       27         end.
       28         when "name" then do:
       29           assign name_ = inValue .
       30         end.
       31         when "full-name" then do:
       32           assign full-name = inValue .
       33         end.
       34         when "type" then do:
       35           assign type_ = integer(inValue) .
       36         end.
       37       end case.
       38     end.
       39     method override protected void CheckData ():
       40       def var v-str as char no-undo.
       41       assign
       42         v-str = v-str + ",name" when name_ = ?
       43         v-str = v-str + ",type" when type_ = ?
       44       .
       45       v-str = trim (v-str, ",").
       46       if v-str > ''
       47       then
       48         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       49     end.
       50     method override protected void ClearSub():
       51       assign
       52         okei-code = ?
       53         del-l     = ?
       54         del-f     = ?
       55         name_     = ?
       56         full-name = ?
       57         type_     = ?
       58       .
       59     end.
       60   end class.
