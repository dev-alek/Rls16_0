      230     method override protected void CheckData ():
      231       def var v-str as char no-undo.
      232       assign
      233         v-str = ",code"
      234         when code_ = ?
      235         v-str = v-str + ",name"
      236         when name_ = ?
      237         .
      238       v-str = substring(v-str, 2).
      239       if v-str > "" then undo, throw new Progress.Lang.AppError(
      240           substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      241           ) .
      242     end method.
