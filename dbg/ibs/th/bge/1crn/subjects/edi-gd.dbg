        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.edi-gd inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property gds-code        as integer      no-undo get. private set.
        9     define property line-num        as integer      no-undo get. private set.
       10     define property qnty-ttn        as decimal      no-undo get. private set.
       11     define property sum             as decimal      no-undo get. private set.
       12     define property nds-code        as decimal      no-undo get. private set.
       13     define property price-nonds     as decimal      no-undo get. private set.
       14     define property stts-desc       as character    no-undo get. private set.
       15     define property cert-decl       as character    no-undo get. private set.
       16     define property sum-nds         as decimal      no-undo get. private set.
       17     define property Qnty-accepted   as decimal      no-undo get. private set.
       18     define property del-l           as integer      no-undo get. private set.
       19     define property del-f           as integer      no-undo get. private set.
       20     define property manual-selection as integer     no-undo get. private set.
       21     define override property InitTag as character no-undo init "gd"
       22       get.
       23     define property marks            as ibs.th.bge.1crn.subjects.subjects no-undo
       24       get.
       25       private set.
       26     constructor public edi-gd ():
       27        InitListTag = "marks".
       28     end constructor.
       29     method private date date-mth (inValue as character):
       30       inValue = entry (1, inValue, "T").
       31       return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
       32     end.
       33             method override protected void SetPropProtected (inTag as char, inValue as char):
       34       case inTag:
       35         when "gd-code"      then gds-code         = if inValue >= "" then integer (inValue) else 0 .
       36         when "line-num"     then line-num         = if inValue >= "" then integer (inValue) else 0 .
       37         when "del-l"        then del-l            = if inValue >= "" then integer (inValue) else 0 .
       38         when "del-f"        then del-f            = if inValue >= "" then integer (inValue) else 0 .
       39         when "qnty-ttn"     then qnty-ttn         = if inValue >= "" then decimal (inValue) else 0.0 .
       40         when "sum"          then sum              = if inValue >= "" then decimal (inValue) else 0.0 .
       41         when "nds-code"     then nds-code         = if inValue >= "" then decimal (inValue) else 0.0 .
       42         when "price-nonds"  then price-nonds      = if inValue >= "" then decimal (inValue) else 0.0 .
       43         when "stts-desc"    then stts-desc        = if inValue >= "" then inValue else "" .
       44         when "cert-decl"    then do:
       45           if cert-decl = "" then cert-decl        = if inValue >= "" then inValue else "" .
       46           else cert-decl = cert-decl + chr(4) + if inValue >= "" then inValue else "" .
       47         end.
       48         when "sum-nds"      then sum-nds          = if inValue >= "" then decimal (inValue) else 0.0 .
       49         when "Qnty-accepted" then Qnty-accepted   = if inValue >= "" then decimal (inValue) else 0.0 .
       50         when "manual-selection" then manual-selection = if inValue >= "" then integer (inValue) else 0 .
       51       end case.
       52       catch exProErrors as class Progress.Lang.ProError :
       53         case exProErrors:GetMessageNum(1):
       54           when 18207 then undo, throw new Progress.Lang.AppError(
       55             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       56           ) .
       57           otherwise undo, throw new Progress.Lang.AppError(
       58             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       59           ) .
       60         end case .
       61       end catch .
       62     end method.
       63     method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
       64        case SubsObj:InitTag:
       65          when "marks"   then marks   = SubsObj.
       66       end case.
       67      end method.
       68     method override protected void CheckData ():
       69       def var v-str as char no-undo.
       70       assign
       71         v-str =         ",line-num"           when line-num          = ?
       72         v-str = v-str + ",qnty-ttn"           when qnty-ttn          = ?
       73         v-str = v-str + ",sum"                when sum               = ?
       74         v-str = v-str + ",price-nonds"        when price-nonds       = ?
       75       .
       76       v-str = substring(v-str, 2).
       77       if v-str > "" then undo, throw new Progress.Lang.AppError(
       78         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       79       ) .
       80     end method.
       81     method override protected void ClearSub():
       82       assign
       83         line-num           = ?
       84         del-l              = ?
       85         del-f              = ?
       86         qnty-ttn           = ?
       87         sum                = ?
       88         nds-code           = ?
       89         price-nonds        = ?
       90         gds-code           = ?
       91         stts-desc          = ?
       92         sum-nds            = ?
       93         Qnty-accepted      = ?
       94         manual-selection   = ?
       95         cert-decl          = ""
       96       .
       97       if valid-object(marks)        then delete object marks .
       98     end method.
       99   end class.
