        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.contr-price-docs_price-list inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gds-code      as character    no-undo get. private set.
       10     define property unit-spl-code as character    no-undo get. private set.
       11     define property unit-k        as decimal      no-undo get. private set.
       12     define property price-sale  as decimal      no-undo get. private set.
       13     define property nds-code    as decimal      no-undo get. private set.
       14     define property min-otkl    as decimal      no-undo get. private set.
       15     define property max-otkl    as decimal      no-undo get. private set.
       16     define override property InitTag as character no-undo init "gds-sale"
       17       get.
       18             method override protected void SetPropProtected (inTag as char, inValue as char):
       19       case inTag:
       20         when "gds-code"      then gds-code      = if inValue >= "" then inValue else "" .
       21         when "unit-spl-code" then unit-spl-code = if inValue >= "" then inValue else "" .
       22         when "unit-k"        then unit-k        = if inValue >= "" then decimal (inValue) else 0.0 .
       23         when "price-sale" then price-sale = if inValue >= "" then decimal (inValue) else 0.0 .
       24         when "nds-code"   then nds-code   = if inValue >= "" then decimal (inValue) else 0.0 .
       25         when "min-otkl"   then min-otkl   = if inValue >= "" then decimal (inValue) else 0.0 .
       26         when "max-otkl"   then max-otkl   = if inValue >= "" then decimal (inValue) else 0.0 .
       27       end case.
       28       catch exProErrors as class Progress.Lang.ProError :
       29         case exProErrors:GetMessageNum(1):
       30           when 18207 then undo, throw new Progress.Lang.AppError(
       31             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       32           ) .
       33           otherwise undo, throw new Progress.Lang.AppError(
       34             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       35           ) .
       36         end case .
       37       end catch .
       38     end.
       39     method override protected void CheckData ():
       40       def var v-str as char no-undo.
       41       assign
       42         v-str = ",gds-code" when gds-code = ?
       43         v-str = v-str + ",price-sale" when price-sale = ?
       44       .
       45       v-str = substring(v-str, 2).
       46       if v-str > "" then undo, throw new Progress.Lang.AppError(
       47         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       48       ) .
       49     end.
       50     method override protected void ClearSub():
       51       assign
       52         gds-code      = ?
       53         unit-spl-code = ?
       54         unit-k        = ?
       55         price-sale   = ?
       56         nds-code     = ?
       57         min-otkl     = ?
       58         max-otkl     = ?
       59       .
       60     end.
       61   end class.
