        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.enum-assortment-stg.
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.assortment-matrix inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property gds-code as character no-undo
       12       get.
       13       private set.
       14     define property stg as enum-assortment-stg no-undo
       15       get.
       16       private set.
       17     define override property InitTag as character no-undo init "assortment-matrix"
       18       get.
       19     method override protected void SetPropProtected (inTag as char, inValue as char):
       20       case inTag:
       21         when "gds-code" then gds-code = if inValue >= "" then inValue else "" .
       22         when "stg" then do :
       23           if inValue >= "" then stg = enum-assortment-stg:GetEnum( integer (inValue) ) .
       24                            else stg = enum-assortment-stg:enarchive .
       25         end .
       26       end case.
       27       catch exProErrors as class Progress.Lang.ProError :
       28         case exProErrors:GetMessageNum(1):
       29           when 18207 then undo, throw new Progress.Lang.AppError(
       30             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       31           ) .
       32           otherwise undo, throw new Progress.Lang.AppError(
       33             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       34           ) .
       35         end case .
       36       end catch .
       37     end method.
       38     method override protected void CheckData ():
       39       def var v-str as char no-undo.
       40       assign
       41         v-str = ",gds-code" when gds-code = ?
       42       .
       43       v-str = substring(v-str, 2).
       44       if v-str > "" then undo, throw new Progress.Lang.AppError(
       45         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       46       ) .
       47     end method.
       48     method override protected void ClearSub():
       49       assign
       50         gds-code = ?
       51         stg      = ?
       52       .
       53     end method.
       54   end class.
