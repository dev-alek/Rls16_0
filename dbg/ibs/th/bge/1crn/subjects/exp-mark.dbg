        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.export.send1cerpsub.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.exp-mark inherits send1cerpsub:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Выгрузка марок в 1с" get.
       12   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   define variable vss-include-info1 as character format "X(65)" no-undo
       14   initial "@(#)$Workfile$ $Revision$".
       15   method private void xmlchar-test (input  p-in-string          as character,
       16                                     output p-out-string-enc     as character,
       17                                     output p-out-string-dec    as character):
       18   do
       19   on error undo, return error
       20   :
       21          xmlchar-encode
       22       (
       23             input p-in-string
       24           , output p-out-string-enc
       25       ).
       26          xmlchar-decode
       27       (
       28             input p-out-string-enc
       29           , output p-out-string-dec
       30       ).
       31   end.
       32   end .
       33   method private void xmlchar-encode (input  p-in-string          as character,
       34                                     output p-out-string         as character):
       35       define variable v-position      as integer      no-undo.
       36       define variable v-current-char  as character    no-undo.
       37   do
       38   on error undo, return error
       39   :
       40       assign
       41           p-out-string = "":U
       42       .
       43       case p-in-string
       44       :
       45           when ?
       46           then do:
       47               assign
       48                   p-out-string = "?":U
       49               .
       50           end.
       51           when "?":U
       52           then do:
       53               assign
       54                   p-out-string = "&#63;":U
       55               .
       56           end.
       57           otherwise do:
       58               do v-position = 1 to length( p-in-string )
       59               :
       60                   assign
       61                       v-current-char = substring( p-in-string, v-position, 1 )
       62                   .
       63                   case v-current-char
       64                   :
       65                       when "&":U
       66                       then do:
       67                           assign
       68                               p-out-string = p-out-string + "&amp;":U
       69                           .
       70                       end.
       71                       when ">":U
       72                       then do:
       73                           assign
       74                               p-out-string = p-out-string + "&gt;":U
       75                           .
       76                       end.
       77                       when "<":U
       78                       then do:
       79                           assign
       80                               p-out-string = p-out-string + "&lt;":U
       81                           .
       82                       end.
       83                       when "'":U
       84                       then do:
       85                           assign
       86                               p-out-string = p-out-string + "&apos;":U
       87                           .
       88                       end.
       89                       when '"':U
       90                       then do:
       91                           assign
       92                               p-out-string = p-out-string + "&quot;":U
       93                           .
       94                       end.
       95                       when chr(1)
       96                       then do:
       97                           assign
       98                               p-out-string = p-out-string + "":U
       99                           .
      100                       end.
      101                       when chr(2)
      102                       then do:
      103                           assign
      104                               p-out-string = p-out-string + "":U
      105                           .
      106                       end.
      107                       when chr(3)
      108                       then do:
      109                           assign
      110                               p-out-string = p-out-string + "":U
      111                           .
      112                       end.
      113                       when chr(4)
      114                       then do:
      115                           assign
      116                               p-out-string = p-out-string + "":U
      117                           .
      118                       end.
      119                       when chr(5)
      120                       then do:
      121                           assign
      122                               p-out-string = p-out-string + "":U
      123                           .
      124                       end.
      125                       when chr(6)
      126                       then do:
      127                           assign
      128                               p-out-string = p-out-string + "":U
      129                           .
      130                       end.
      131                       when chr(7)
      132                       then do:
      133                           assign
      134                               p-out-string = p-out-string + "":U
      135                           .
      136                       end.
      137                       when chr(8)
      138                       then do:
      139                           assign
      140                               p-out-string = p-out-string + "":U
      141                           .
      142                       end.
      143                       when chr(9)
      144                       then do:
      145                           assign
      146                               p-out-string = p-out-string + "":U
      147                           .
      148                       end.
      149                       when chr(29)
      150                       then do:
      151                           assign
      152                               p-out-string = p-out-string + "":U
      153                           .
      154                       end.
      155                       when chr(10)
      156                       then do:
      157                           assign
      158                               p-out-string = p-out-string + "&#10;":U
      159                           .
      160                       end.
      161                       when chr(13)
      162                       then do:
      163                           assign
      164                               p-out-string = p-out-string + "&#13;":U
      165                           .
      166                       end.
      167                       otherwise do:
      168                           assign
      169                               p-out-string = p-out-string + v-current-char
      170                           .
      171                       end.
      172                   end case.
      173               end.
      174           end.
      175       end case.
      176   end.
      177   end .
      178   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      179   define variable p-out-string as character no-undo.
      180       define variable v-position      as integer      no-undo.
      181       define variable v-current-char  as character    no-undo.
      182   do
      183   on error undo, return error
      184   :
      185       assign
      186           p-out-string = "":U
      187       .
      188       case p-in-string
      189       :
      190           when ?
      191           then do:
      192               assign
      193                   p-out-string = "?":U
      194               .
      195           end.
      196           otherwise do:
      197               do v-position = 1 to length( p-in-string )
      198               :
      199                   assign
      200                       v-current-char = substring( p-in-string, v-position, 1 )
      201                   .
      202                   case v-current-char
      203                   :
      204                       when chr(1)
      205                       then do:
      206                           assign
      207                               p-out-string = p-out-string + " ":U
      208                           .
      209                       end.
      210                       when chr(2)
      211                       then do:
      212                           assign
      213                               p-out-string = p-out-string + " ":U
      214                           .
      215                       end.
      216                       when chr(3)
      217                       then do:
      218                           assign
      219                               p-out-string = p-out-string + " ":U
      220                           .
      221                       end.
      222                       when chr(4)
      223                       then do:
      224                           assign
      225                               p-out-string = p-out-string + " ":U
      226                           .
      227                       end.
      228                       when chr(5)
      229                       then do:
      230                           assign
      231                               p-out-string = p-out-string + " ":U
      232                           .
      233                       end.
      234                       when chr(6)
      235                       then do:
      236                           assign
      237                               p-out-string = p-out-string + " ":U
      238                           .
      239                       end.
      240                       when chr(7)
      241                       then do:
      242                           assign
      243                               p-out-string = p-out-string + " ":U
      244                           .
      245                       end.
      246                       when chr(8)
      247                       then do:
      248                           assign
      249                               p-out-string = p-out-string + " ":U
      250                           .
      251                       end.
      252                       when chr(9)
      253                       then do:
      254                           assign
      255                               p-out-string = p-out-string + " ":U
      256                           .
      257                       end.
      258                       when chr(29)
      259                       then do:
      260                           assign
      261                               p-out-string = p-out-string + " ":U
      262                           .
      263                       end.
      264                       when chr(10)
      265                       then do:
      266                           assign
      267                               p-out-string = p-out-string + " ":U
      268                           .
      269                       end.
      270                       when chr(13)
      271                       then do:
      272                           assign
      273                               p-out-string = p-out-string + " ":U
      274                           .
      275                       end.
      276                       otherwise do:
      277                           assign
      278                               p-out-string = p-out-string + v-current-char
      279                           .
      280                       end.
      281                   end case.
      282               end.
      283           end.
      284       end case.
      285   end.
      286   return p-out-string.
      287   end .
      288   method private void xmlchar-decode (input  p-in-string          as character,
      289                                     output p-out-string         as character):
      290       define variable v-position      as integer      no-undo.
      291       define variable v-last-position as integer      no-undo.
      292       define variable v-temp-integer  as integer      no-undo.
      293       define variable v-current-char  as character    no-undo.
      294       define variable v-next-char     as character    no-undo.
      295       define variable v-success       as logical      no-undo.
      296   do
      297   on error undo, return error
      298   :
      299       assign
      300           p-out-string = "":U
      301           v-position   = 0
      302       .
      303       replace-cycle:
      304       do while yes
      305       on error undo, return error
      306       :
      307           assign
      308               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      309           .
      310           if v-last-position <= v-position
      311           then do:
      312               if v-position = 0
      313               then do:
      314                   assign
      315                       p-out-string = p-in-string
      316                   .
      317               end.
      318               else do:
      319                   assign
      320                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      321                   .
      322               end.
      323               leave replace-cycle.
      324           end.
      325           else do:
      326               assign
      327                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      328                   v-position      = v-last-position
      329                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      330               .
      331               if v-current-char = "#":U
      332               then do:
      333                   assign
      334                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      335                   .
      336                   if v-last-position > 0
      337                   then do:
      338                       xmlchar-read-integer
      339                        (
      340                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      341                           , output v-temp-integer
      342                           , output v-success
      343                       ).
      344                       if v-success = yes
      345                       and v-temp-integer >= 1
      346                       and v-temp-integer <= 255
      347                       then do:
      348                           assign
      349                               p-out-string = p-out-string + chr( v-temp-integer )
      350                               v-position   = v-last-position + 1
      351                           .
      352                       end.
      353                       else do:
      354                           assign
      355                               p-out-string = p-out-string + "&":U
      356                               v-position   = v-position   + 1
      357                           .
      358                       end.
      359                   end.
      360                   else do:
      361                       assign
      362                           p-out-string = p-out-string + "&":U
      363                           v-position   = v-position   + 1
      364                       .
      365                   end.
      366               end.
      367               else do:
      368                   case substring( p-in-string, v-position + 1, 3 )
      369                   :
      370                       when "lt;":U
      371                       then do:
      372                           assign
      373                               p-out-string = p-out-string + "<":U
      374                               v-position   = v-position   + 3
      375                           .
      376                       end.
      377                       when "gt;":U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + ">":U
      381                               v-position   = v-position   + 3
      382                           .
      383                       end.
      384                       otherwise do:
      385                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      386                           then do:
      387                               assign
      388                                   p-out-string = p-out-string + "&":U
      389                                   v-position   = v-position   + 4
      390                               .
      391                           end.
      392                           else do:
      393                               case substring( p-in-string, v-position + 1, 5 )
      394                               :
      395                                   when "quot;":U
      396                                   then do:
      397                                       assign
      398                                           p-out-string = p-out-string + '"':U
      399                                           v-position   = v-position   + 5
      400                                       .
      401                                   end.
      402                                   when "apos;":U
      403                                   then do:
      404                                       assign
      405                                           p-out-string = p-out-string + "'":U
      406                                           v-position   = v-position   + 5
      407                                       .
      408                                   end.
      409                                   otherwise do:
      410                                       assign
      411                                           p-out-string = p-out-string + "&":U
      412                                       .
      413                                   end.
      414                               end case.
      415                           end.
      416                       end.
      417                   end case.
      418               end.
      419           end.
      420       end.
      421   end.
      422   end .
      423   method private void xmlchar-read-integer (input  p-input-string       as character,
      424                                             output p-output-integer     as integer,
      425                                             output p-success            as logical):
      426   do
      427   on error undo, return error
      428   :
      429       assign
      430           p-output-integer = integer( p-input-string )
      431       no-error.
      432       if error-status :error
      433       then do:
      434           assign
      435               p-success           = no
      436               p-output-integer    = 0
      437           .
      438       end.
      439       else do:
      440           assign
      441               p-success           = yes
      442           .
      443       end.
      444   end.
      445   end.
      446   method private void getAttrLib ():
      447      define variable g#attr-lib  as handle no-undo .
      448      run gbl/getgattrlib.p (output g#attr-lib).
      449   end.
      450   define variable mMRCCode  as logical    no-undo.
      451   define variable mTypeMark as character  no-undo.
      452   method private logical IS-NeedMark
      453   ( input ib-code as integer  ,
      454     input ib-str as character ):
      455      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      456      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      457                                    and buf_prod-bc-attr.b-str  eq ib-str
      458                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      459        no-lock no-error.
      460      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      461   end.
      462   method private character repTegforDm
      463   (iDM as char ):
      464       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      465       define variable vteg as character no-undo.
      466       define variable oDM as character no-undo.
      467       define variable vi as integer no-undo.
      468       oDM = iDm.
      469       do vi = 1 to num-entries(vTeglist):
      470          vTeg = entry(vi,vTeglist).
      471          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      472       end.
      473       return oDM.
      474   end.
      475   method private character repSpecSimbforDm
      476   (iDM as char ):
      477       define variable oDM as character no-undo.
      478       xmlchar-decode(iDM, output oDM).
      479     return repTegforDm (oDM).
      480   end.
      481   method private logical CheckGtin
      482   (iGtin as char):
      483      define variable bar_code as character no-undo.
      484      define variable vGtin as logical no-undo init "yes".
      485      if length(iGtin) eq 14
      486      then do:
      487         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      488         run str/chk-sum.p
      489          (input-output bar_code ) no-error .
      490         if iGtin ne  bar_code
      491         then
      492            vGtin = no.
      493      end.
      494      else
      495         vGtin = no.
      496      return vgtin.
      497   end.
      498   method private character repSpecSimbforXlm
      499   (iDM as char ):
      500       iDM = replace(iDM,chr(29),"").
      501       return iDM.
      502   end.
      503   method private character getGtinByDM
      504   (IDM as char):
      505      define variable VTXT as char no-undo.
      506      define variable vGtin as char no-undo.
      507      vTXt = IdM.
      508      vGtin = IDM.
      509      if    length(vtxt) > 14
      510      then do:
      511         if   vtxt begins "(01)"
      512                or vtxt begins "(02)"
      513         then
      514            vGtin = substring(vtxt,5,14).
      515         else if   (vtxt begins "01"
      516                or vtxt begins "02" )
      517                and (   (    substring(iDm,17,2) eq "21"
      518                         and length(vtxt) >= 21)
      519                     or substring(iDm,17,2) eq "37"
      520                     or substring(iDm,17,4) eq "(37)" )
      521         then do:
      522            vGtin = substring(vtxt,3,14).
      523            if not checkGtin(vGtin)
      524            then
      525               vGtin = substring(vtxt,1,14).
      526         end.
      527         else if     length(vtxt) eq 14 + 7 + 4 + 4
      528             or length(vtxt) eq 14 + 7 + 4
      529             or length(vtxt) eq 14 + 7
      530         then
      531            vGtin = substring(vtxt,1,14).
      532      end.
      533      if not checkGtin(vGtin)
      534      then
      535         vGtin = "".
      536      return vgtin.
      537   end.
      538   method private integer getGdsCodeByGtin
      539   (iGtin as char):
      540      define buffer prod-bc  for ub.prod-bc.
      541      define buffer bar-code for ub.bar-code.
      542      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      543      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      544      return if avail bar-code then bar-code.gds-code else ?.
      545   end.
      546   method private decimal getQntyCodeByGtin
      547   (iGtin as char):
      548      define buffer prod-bc  for ub.prod-bc.
      549      define buffer bar-code for ub.bar-code.
      550      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      551      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      552      return if avail bar-code then bar-code.cli-base-rate else ?.
      553   end.
      554   method private integer getGdsCodeByDM
      555   (iDm as char):
      556      define variable vGtin as char no-undo.
      557      define buffer prod-bc for ub.prod-bc.
      558      vGtin  = getGtinByDM (IDM ).
      559      return getGdsCodeByGtin (vGtin).
      560   end.
      561   method private logical ChekTypeMarkByGds
      562   (iGds-code as integer ):
      563      define buffer goods-attr for ub.goods-attr.
      564      find first goods-attr where goods-attr.gds-code   = iGds-code
      565                              and goods-attr.attr-code  = 'mark-type':U
      566      no-lock no-error.
      567      if available goods-attr
      568      then do:
      569         mTypeMark = goods-attr.attr-value.
      570         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      571           .
      572      end.
      573      else
      574         return no.
      575   end.
      576   method private logical ChekTypeMarkByDm
      577   (iDM as char ):
      578      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      579   end.
      580   method private logical ChekTypeMarkByGtin
      581   (iGtin as char ):
      582      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      583   end.
      584   method private character  GetNextElement
      585     (input iAllTeg        as logical
      586     ,output oteg          as character
      587     ,output otegval       as character
      588     ,input-output pstr    as character
      589      ):
      590        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      591        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      592        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      593        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      594        define variable vTeg as character no-undo.
      595        define variable vLength as integer no-undo.
      596        define variable vi as integer no-undo.
      597        define variable vj as integer no-undo.
      598        define buffer code for ub.code.
      599        find first code where Code.parent eq "MarkType"
      600                          and Code.CodeValue   eq mTypeMark
      601                          no-lock no-error.
      602        if     available code
      603           and Code.misc1 ne ""
      604           and Code.misc1 ne ?
      605        then do:
      606           integer (Code.misc1) no-error.
      607           if not error-status:error
      608           then
      609             entry (4,vlistleng) = Code.misc1.
      610        end.
      611        if iAllTeg
      612        then
      613           assign
      614              vlistElem     = vlistElem    + vlistElemDop
      615              vlistleng     = vlistleng    + vlistlengDop
      616           .
      617        else if mMRCCode
      618        then
      619           assign
      620              vlistElem     = vlistElem    + ",(8005),8005"
      621              vlistleng     = vlistleng    + ",000006,0006"
      622           .
      623       block-elem:
      624       do vi = 1 to num-entries(vlistElem):
      625          vTeg = entry(vi,vlistElem).
      626          if pstr begins vTeg
      627          then do:
      628             if    vTeg eq "21"
      629             then
      630                vLength = index(pstr,chr(29)) - 2 no-error.
      631             if vLength  <= 0
      632             then
      633                vLength = int(entry(vi,vlistleng)).
      634             otegval = substring (pstr,length(vteg) + 1, vLength).
      635             oteg = replace(replace(vteg,")",""),"(","").
      636             vTeg = vteg + otegval.
      637             otegval = replace(otegval,chr(29),"").
      638             oteg = replace(replace(oteg,")",""),"(","").
      639             pstr = substring (pstr,length(vTeg)+ 1).
      640             vTeg = replace(vTeg,chr(29),"").
      641             leave block-elem.
      642          end.
      643          else
      644             vTeg = "".
      645       end.
      646       return vteg.
      647   end.
      648   method private character  GetCodeIdent
      649   (iDm as char):
      650      define variable Velement   as character no-undo init "first".
      651      define variable oCodeIdent as character no-undo.
      652      define variable vteg as character no-undo.
      653      define variable vtegval as character no-undo.
      654      define variable vGtin as character no-undo.
      655      define buffer marking for ub.marking.
      656      for first marking no-lock where
      657                marking.mark eq iDm
      658            and marking.unit-ext = "LEVEL2"
      659      :
      660        return iDm.
      661      end.
      662      vGtin  = getGtinByDM (iDm ).
      663      ChekTypeMarkByDm(idm).
      664      if iDm begins 'tech_':U
      665      then
      666         oCodeIdent = iDm.
      667      else if length(iDm) < 21
      668      then do:
      669         find first marking where marking.mark eq idm
      670         no-lock no-error.
      671         oCodeIdent = if available marking then marking.mark else  ?.
      672      end.
      673      else if     length(iDm) eq 29
      674         and not iDm begins "01"
      675         and not iDm begins "02"
      676      then
      677         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      678      else  if     length(iDm) >= 24
      679               and (  iDm begins "01"
      680                   or iDm begins "02")
      681               and  substring(iDm,17,2) ne "21"
      682      then do:
      683         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      684                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      685         then
      686            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      687         else
      688            oCodeIdent = iDM.
      689      end.
      690      else  if     (   length(iDm) eq 25
      691                    or length(iDm) eq 21)
      692               and (not iDm begins "01"
      693               and  not iDm begins "02")
      694      then
      695         oCodeIdent = substring(iDm,1,21).
      696      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      697      then
      698         oCodeIdent = substring(iDm,1,21).
      699      else do while Velement ne "" and idm ne "":
      700         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      701         oCodeIdent = oCodeIdent + Velement.
      702      end.
      703      return oCodeIdent.
      704   end.
      705   method private character  GetTegCod
      706   (icodeIdent as char, iTeg as char):
      707      define variable Velement   as character no-undo init "first".
      708      define variable oTeg as character no-undo init ?.
      709      define variable vteg as character no-undo.
      710      define variable vtegval as character no-undo.
      711      if     ((length(icodeIdent) eq 21
      712         and not icodeIdent begins "01"
      713         and not icodeIdent begins "02")
      714         or
      715             ( length(icodeIdent) eq 25
      716               and not icodeIdent begins "01"
      717               and not icodeIdent begins "02"))
      718      then do:
      719         if iTeg eq "01" or iTeg eq "02"
      720         then
      721            oTeg = substring(icodeIdent,1,21).
      722         else  if  iTeg eq "21"
      723         then
      724            oTeg = substring(icodeIdent,15,7).
      725      end.
      726      else do:
      727         ChekTypeMarkByDm(icodeIdent).
      728         block-teg:
      729            do while Velement ne "" and icodeIdent ne "":
      730            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      731            if    Velement begins iTeg
      732               or Velement begins "(" + iTeg + ")"
      733            then do:
      734               oTeg = vtegval.
      735               leave block-teg.
      736            end.
      737         end.
      738      end.
      739      return oTeg.
      740   end.
      741   method private logical isOAD
      742   (icodeIdent as character):
      743      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      744   end.
      745   method private logical isMark
      746   (icodeIdent as character):
      747      define buffer buf_marking for ub.marking.
      748      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      749             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      750   end.
      751   method private character  addBracketForCode
      752   (icodeIdent as char):
      753      define variable Velement   as character no-undo init "first".
      754      define variable oTeg as character no-undo.
      755      define variable vteg as character no-undo.
      756      define variable vtegval as character no-undo.
      757      define buffer marking for ub.marking.
      758      find first marking no-lock where
      759                 marking.mark begins icodeIdent no-error.
      760      if    not ChekTypeMarkByDm(icodeIdent)
      761         or length(icodeIdent) le 24
      762         or (avail marking and marking.unit-ext = "LEVEL2")
      763      then
      764         oTeg = icodeIdent.
      765      else do:
      766         if (  icodeIdent begins "01"
      767            or icodeIdent begins "02"
      768            ) and CheckGtin(substring (icodeIdent,3,14))
      769            and substring (icodeIdent,17,2) eq "21"
      770         then do:
      771            mMRCCode = yes.
      772            ChekTypeMarkByDm(icodeIdent).
      773            block-teg:
      774            do while Velement ne "" and icodeIdent ne "":
      775               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      776               if vteg ne ""
      777               then
      778                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      779            end.
      780            mMRCCode = no.
      781         end.
      782         else do:
      783            oTeg = icodeIdent.
      784         end.
      785      end.
      786      return oTeg.
      787   end.
      788   method private integer getlevelByCodId
      789   (iCode as char):
      790      define variable vLength as int no-undo.
      791      define variable vLevel  as int no-undo.
      792      if not ChekTypeMarkByDM (icode) then return ?.
      793      vLength = length(iCode).
      794      if    vLength eq 18
      795         or vLength eq 20
      796      then
      797         Vlevel = 4.
      798      else if vLength eq 21
      799      then
      800         Vlevel = 1.
      801      else if vLength eq 25
      802      then do:
      803         if  iCode begins "01"
      804         then
      805            Vlevel = 3.
      806         else
      807            Vlevel = 1.
      808      end.
      809      else if     vLength >= 26
      810              and vLength <= 46
      811      then do:
      812         if    substring(iCode,17,2) eq "11"
      813            or substring(iCode,17,2) eq "13"
      814            or (    substring(iCode,17,2) eq "21"
      815                and vLength >= 33
      816                and substring(iCode,26,4) ne "8005")
      817         then
      818            Vlevel = 4.
      819         else if    vLength eq 31
      820                 or vLength eq 38
      821                 or vLength eq 39
      822                 or vLength eq 45
      823         then
      824            Vlevel = 1.
      825         else if    vLength eq 35
      826                 or vLength eq 43
      827         then
      828            Vlevel = 3.
      829         else
      830            Vlevel = ?.
      831      end.
      832      else
      833         Vlevel = ?.
      834      return Vlevel.
      835   end.
      836   method private character  getLevelMotpBycodid
      837   (iDm as char):
      838      define variable vLevel as integer no-undo.
      839      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      840      vLevel = getlevelByCodId(iDm).
      841      if    vLevel eq ?
      842         or vLevel < 1
      843         or vLevel > 6
      844      then
      845         return ?.
      846      else
      847         return entry(vlevel,vList).
      848   end.
      849   method private character    getLevelUTDByLevelMotp
      850   (iUnit as char):
      851      define variable vLevel as integer no-undo.
      852      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      853      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      854      vLevel = lookup(iUnit,vListMOTP).
      855      if    vLevel eq ?
      856         or vLevel < 1
      857         or vLevel > 4
      858      then
      859         return ?.
      860      else
      861         return entry(vlevel,vListutd).
      862   end.
      863   method private character  getLevelMotpByDM
      864   (iDm as char):
      865      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      866   end.
      867   method private character  getLevelUTDByCodId
      868   (iDm as char):
      869      define variable vLevel as integer no-undo.
      870      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      871      vLevel = getlevelByCodId(iDm).
      872      if    vLevel eq ?
      873         or vLevel < 1
      874         or vLevel > 4
      875      then
      876         return ?.
      877      else
      878         return entry(vlevel,vList).
      879   end.
      880   method private character  getLevelUTDByDM
      881   (iDm as char):
      882      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      883   end.
      884   define variable mNotMarkQnty as logical no-undo.
      885   method private decimal getQntyUTDByCodId
      886   (iDM as char):
      887      define variable vLevel as integer no-undo.
      888      define variable vList as character no-undo init "1,5,10,500".
      889      define variable vGtin as character no-undo.
      890      define variable vqnty as decimal no-undo init ?.
      891      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      892      if vqnty eq ?
      893      then do:
      894         if not mNotMarkQnty
      895         then do:
      896            define buffer marking for ub.marking.
      897            define variable vCodident as character no-undo.
      898            vCodident = GetCodeIdent(idm).
      899            find first marking where marking.mark begins vCodident no-lock no-error.
      900            if     available marking
      901               and marking.box-qnty ne ?
      902            then
      903               return marking.box-qnty.
      904         end.
      905         vGtin = getGtinByDm(iDM).
      906         if ChekTypeMarkByGtin (vGtin)
      907         then do:
      908            vLevel = getlevelByCodId(iDM).
      909            if     vLevel >= 1
      910               and vLevel <= 4
      911            then
      912               vqnty = int(entry(vlevel,vList)).
      913         end.
      914         else
      915            vqnty = getQntyCodeByGtin(vgtin).
      916      end.
      917      return vqnty.
      918   end.
      919   method private decimal getQntyUTDByDM
      920   (iDm as char):
      921      define variable vDM as character no-undo.
      922      if     length (iDm) ne 25
      923         and length (iDm) ne 29
      924         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      925      then
      926         vDM = substring (iDm,1,length (iDm) - 6 ).
      927      else
      928         vDM = substring (iDm,1,length (iDm) - 4 ).
      929      return getQntyUTDByCodId(vDM).
      930   end.
      931   method private decimal    getMRC4
      932   (iMRC as char):
      933      define variable oMrc     as decimal no-undo init ?.
      934      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      935      define variable vi       as integer no-undo.
      936      define variable vfound   as integer no-undo.
      937      define variable vposStart   as integer no-undo.
      938      do:
      939      OMRc = 0.
      940      do vi = 1 to 4:
      941         define variable vsimb as character no-undo.
      942         vsimb = substring(iMRC,vi,1).
      943         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      944         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      945         if vfound > 0
      946         then
      947            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      948         end.
      949         OMRc = OMRc / 100.
      950      end.
      951      return OMRc.
      952   end.
      953   method private decimal    getMRCByDM
      954   (iDm as char):
      955      define variable vMRC     as character no-undo.
      956      define variable oMrc     as decimal no-undo init ?.
      957      define variable Velement as character no-undo init "empty".
      958      define variable vteg as character no-undo.
      959      define variable vtegval as character no-undo.
      960      if    length(idm) eq 14 + 7 + 4 + 4
      961         or length(idm) eq 14 + 7 + 4
      962      then do:
      963         vMRC = substring(idm,22,4).
      964         omrc = getMRC4(vMRC).
      965      end.
      966      else do:
      967          ChekTypeMarkByDm(iDm).
      968          block-mrc:
      969          do while Velement ne "" and idm ne "":
      970             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      971             if Velement begins "8005"
      972             then do:
      973                vMRC = substring(Velement,5,6).
      974                leave block-mrc.
      975             end.
      976             else if Velement begins "(8005)"
      977             then do:
      978                vMRC = substring(Velement,7,6).
      979                leave block-mrc.
      980             end.
      981          end.
      982          if vMRC ne ""
      983          then
      984             OMRc = dec(vmrc) / 100 no-error.
      985      end.
      986      return OMRc.
      987   end.
      988   method private date    MoveDate
      989   (idate as date,
      990    iMonth as int64):
      991      define variable vMonth   as int64 no-undo.
      992      define variable vYear    as int64 no-undo.
      993      define variable vDateNew as date  no-undo.
      994       define variable vDay     as int64 no-undo.
      995       vMonth = month(iDate) + iMonth.
      996       vYear =  year(iDate).
      997       if vMonth <= 0
      998       then assign
      999          vMonth = vMonth + 12
     1000           vYear  = vYear - 1
     1001       .
     1002       else if vMonth > 12
     1003       then assign
     1004          vMonth = vMonth - 12
     1005           vYear  = vYear + 1
     1006       .
     1007       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1008       do while error-status:error eq yes:
     1009          VDay = vDay + 1.
     1010          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1011       end.
     1012       if VDay > 0
     1013       then
     1014          vDateNew + 1.
     1015       return vDateNew.
     1016   end.
     1017   method private logical    checkEMRC
     1018   (input  iDm as char,
     1019    output vOk as logical):
     1020      define variable v-value-emrc as character no-undo.
     1021      define variable v-type-emrc  as character no-undo.
     1022      define variable vDateIso     as character no-undo.
     1023      define variable vMRC         as decimal no-undo.
     1024      define variable vqnty        as decimal no-undo.
     1025      define variable vPrice       as decimal no-undo.
     1026      define variable vparent      as character no-undo.
     1027      define variable vgds-code    as integer no-undo.
     1028      define buffer code for ub.code.
     1029      vMRC = getMRCByDM(iDm).
     1030      if vMRC > 0
     1031      then do:
     1032         vgds-code = getGdsCodeByDM(iDm).
     1033         vqnty     = getQntyUTDByDM(iDm).
     1034               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1035            (
     1036             input   vgds-code
     1037            ,input   'emrc-type':U
     1038            ,output   v-value-emrc
     1039            ,output   v-type-emrc
     1040          ) no-error.
     1041          if     v-value-emrc ne ""
     1042             and v-value-emrc ne ?
     1043          then do:
     1044             vDateIso = iso-date(today).
     1045             vPrice = vMRC / vqnty.
     1046             vparent ="emc" + chr(4) + v-value-emrc.
     1047             find last code where Code.parent      eq vparent
     1048                              and Code.code        le vDateIso
     1049                              and code.status_  eq 0
     1050             no-lock no-error.
     1051             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1052             then
     1053                vOk = true .
     1054             else do:
     1055                 define variable vText      as character no-undo.
     1056                 define variable vDate      as date no-undo.
     1057                 define variable vDateLast  as character no-undo.
     1058                 define variable vDateFirst as character no-undo.
     1059                 define variable vDate3     as date no-undo.
     1060                 vdate = date(code.misc1).
     1061                 vDateLast = code.misc1.
     1062                 vDate3 = MoveDate(today, - 3 ).
     1063                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1064                                      string(vDate3  , "99/99/9999"),
     1065                                      string(vDate   , "99/99/9999")
     1066                                      ).
     1067                 vdateIso = iso-date(vdate3).
     1068                 find last code  where Code.parent      eq vparent
     1069                                   and Code.code        le vDateIso
     1070                                   and code.status_  eq 0 no-lock no-error.
     1071                 if available code
     1072                 then
     1073                    vDateIso = code.code.
     1074                 vDateFirst = vDateIso.
     1075                 vDateLast = iso-date(vdate).
     1076                 define variable vGood as logical no-undo.
     1077                 define variable vDateSale as date no-undo.
     1078                 define buffer bcode for code.
     1079                 for last code where Code.parent   eq vparent
     1080                                 and code.status_  eq 0
     1081                                 and code.code     < vDateLast
     1082                                 and code.code     >= vDateFirst
     1083                 no-lock:
     1084                    find first bcode where bCode.parent   eq vparent
     1085                                       and bcode.status_  eq 0
     1086                                       and bcode.code     > code.code no-lock no-error.
     1087                    if available bcode
     1088                    then do:
     1089                       if vPrice < dec(Code.CodeValue)
     1090                       then
     1091                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1092                                                     chr(10),
     1093                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1094                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1095                                                     ).
     1096                       else do:
     1097                          vGood = yes.
     1098                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1099                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1100                                                     chr(10),
     1101                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1102                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1103                                                     string(         vDateSale            ,"99/99/9999"),
     1104                                                     string(vDateSale - today)
     1105                                                     ).
     1106                       end.
     1107                    end.
     1108                 end.
     1109                 if vgood
     1110                 then do:
     1111                    define variable choice as integer no-undo .
     1112                    run gbl/d-askw.w (input "Уточнение"
     1113                           ,input  vText
     1114                           ,input "|"
     1115                           ,input "Принять|Вернуть"
     1116                           ,input "Принять данный товар|Вернуть товар постащику"
     1117                           ,input 1
     1118                           ,input 2
     1119                           ,output choice) no-error.
     1120                    vok = choice eq 1.
     1121                 end.
     1122                 else
     1123                    vok =false.
     1124             end.
     1125          end.
     1126      end.
     1127   end.
     1128   method private character addGs2Mark
     1129   (iMark as char):
     1130      define variable vDM   as character no-undo.
     1131      define variable vIdx  as integer   no-undo.
     1132      if index(iMark,chr(29),1) > 0
     1133      then return iMark.
     1134      if substring(iMark,26,4) = "8005" then
     1135      do:
     1136        vIdx = index(iMark,"93",26 + 4 + 5).
     1137        if vIdx > 1 then do:
     1138          vDM = substitute("&1&4&2&4&3",
     1139                           substring(iMark,1,25),
     1140                           substring(iMark,26,vIdx - 25 - 1),
     1141                           substring(iMark,vIdx),
     1142                           chr(29)) no-error.
     1143          vIdx = index(vDm,"240",vIdx + 4).
     1144          if vIdx > 0 then
     1145          do:
     1146            vDM = substitute("&1&3&2",
     1147                             substring(vDm,1,vIdx - 1),
     1148                             substring(vDm,vIdx),
     1149                             chr(29)) no-error.
     1150          end.
     1151        end.
     1152        else
     1153          vDM = substitute("&1&3&2",
     1154                           substring(iMark,1,25),
     1155                           substring(iMark,26),
     1156                           chr(29)) no-error.
     1157      end.
     1158      else if substring(iMark,32,2) = "91" then
     1159      do:
     1160        vIdx = index(iMark,"92",32).
     1161        if vIdx > 1 then
     1162          vDM = substitute("&1&4&2&4&3",
     1163                           substring(iMark,1,31),
     1164                           substring(iMark,32,vIdx - 31 - 1),
     1165                           substring(iMark,vIdx),
     1166                           chr(29)) no-error.
     1167        else
     1168          vDM = substitute("&1&3&2",
     1169                           substring(iMark,1,31),
     1170                           substring(iMark,32),
     1171                           chr(29)) no-error.
     1172      end.
     1173      else if substring(iMark,39,2) = "91" then
     1174      do:
     1175        vIdx = index(iMark,"92",38).
     1176        if vIdx > 1 then
     1177          vDM = substitute("&1&4&2&4&3",
     1178                           substring(iMark,1,38),
     1179                           substring(iMark,39,vIdx - 38 - 1),
     1180                           substring(iMark,vIdx),
     1181                           chr(29)) no-error.
     1182        else
     1183          vDM = substitute("&1&3&2",
     1184                           substring(iMark,1,38),
     1185                           substring(iMark,39),
     1186                           chr(29)) no-error.
     1187      end.
     1188      else if substring(iMark,25,2) = "93" then
     1189      do:
     1190        vIdx = index(iMark,"92",25).
     1191        if vIdx > 1 then
     1192          vDM = substitute("&1&4&2&4&3",
     1193                           substring(iMark,1,24),
     1194                           substring(iMark,25,vIdx - 24 - 1),
     1195                           substring(iMark,vIdx),
     1196                           chr(29)) no-error.
     1197        else
     1198          vIdx = index(iMark,"3103",25).
     1199          if vIdx > 0 then
     1200          vDM = substitute("&1&4&2&4&3",
     1201                           substring(iMark,1,24),
     1202                           substring(iMark,25,vIdx - 24 - 1),
     1203                           substring(iMark,vIdx),
     1204                           chr(29)) no-error.
     1205          else
     1206            vDM = substitute("&1&3&2",
     1207                             substring(iMark,1,24),
     1208                             substring(iMark,25),
     1209                             chr(29)) no-error.
     1210      end.
     1211      else if substring(iMark,32,2) = "93" then
     1212      do:
     1213        vDM = substitute("&1&3&2",
     1214              substring(iMark,1,31),
     1215              substring(iMark,32),
     1216              chr(29)) no-error.
     1217      end.
     1218      return if vDM <> "" then vDm else iMark.
     1219   end.
     1220     define override public property InitSecTag as character no-undo init 'marks':U
     1221     get.
     1222     define override public property sendTableName as character no-undo init "marking"
     1223       get.
     1224      method override public void CheckParam(  ):
     1225         if not valid-handle (oldbh)
     1226         then
     1227            return error "Не передан старый буфер".
     1228         if oldbh:table ne "marking"
     1229         then
     1230            return error "Старый буфер не marking: " + oldbh:table.
     1231         return.
     1232      end method.
     1233   method override public void CrContentToSW (insw as handle):
     1234      find first marking where marking.mark eq string(oldbh:buffer-field( "mark":U  ):buffer-value)
     1235      no-lock no-error.
     1236      if available marking
     1237      then do:
     1238         sendOldRowid = rowid(marking).
     1239         insw:start-element ('mark':U) .
     1240         insw:write-data-element (  "mark-code":U,     repSpecSimbforXlm(   addBracketForCode(marking.mark))   ).
     1241         insw:write-data-element (  "unit-ext":U,        if marking.unit-ext eq ? then "" else marking.unit-ext  ).
     1242         insw:write-data-element (  "qnty-box":U,        if marking.box-qnty eq ? then "" else string( marking.box-qnty )   ).
     1243         insw:write-data-element (  "stts":U,       ObjSrv:Env:marking:sts:mark:GetNameProp(marking.sts)).
     1244         insw:write-data-element (  "mark-parent":U,     repSpecSimbforXlm(  addBracketForCode( marking.mark-parent ))  ).
     1245         if marking.gds-ext-id <> "" and marking.gds-ext-id <> ? then
     1246           insw:write-data-element (  "GTIN":U,       marking.gds-ext-id   ).
     1247         insw:write-data-element (  "gds-code":U,       if marking.gds-code eq ? then "" else string(marking.gds-code)   ).
     1248         find first marking-attr where marking-attr.mark eq marking.mark
     1249                                   and marking-attr.attr-code eq "mrc"
     1250                                   and marking-attr.attr-value <> '0'
     1251                                   and marking-attr.attr-value <> ''
     1252         no-lock no-error.
     1253         if available marking-attr
     1254         then
     1255            insw:write-data-element (  "mrc":U,       marking-attr.attr-value   ).
     1256         find first marking-attr where marking-attr.mark eq marking.mark
     1257                                   and marking-attr.attr-code eq "weight"
     1258                                   and marking-attr.attr-value <> '0'
     1259                                   and marking-attr.attr-value <> ''
     1260         no-lock no-error.
     1261         if available marking-attr
     1262         then
     1263            insw:write-data-element (  "weight":U,       marking-attr.attr-value   ).
     1264         insw:end-element ('mark':U) .
     1265      end.
     1266     end method .
     1267   end class.
