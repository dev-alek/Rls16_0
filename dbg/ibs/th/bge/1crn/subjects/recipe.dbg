        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.enum-recipe-status.
        3   using ibs.th.bge.1crn.enum-recipe-type.
        4   using ibs.th.bge.1crn.subjects.subjects from propath.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.recipe inherits ibs.th.bge.1crn.subjects.asubject:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property status_ as enum-recipe-status no-undo
       19       get.
       20       private set.
       21     define property recipe-code as character no-undo
       22       get.
       23       private set.
       24     define property recipe-type as enum-recipe-type no-undo
       25       get.
       26       private set.
       27     define property recipe-name as character no-undo
       28       get.
       29       private set.
       30     define property recipe-num as character no-undo
       31       get.
       32       private set.
       33     define property gd-code as character no-undo
       34       get.
       35       private set.
       36     define property qnty-netto as decimal no-undo
       37       get.
       38       private set.
       39     define property qnty as integer no-undo
       40       get.
       41       private set.
       42     define property weight as decimal no-undo
       43       get.
       44       private set.
       45     define property main as integer no-undo
       46       get.
       47       private set.
       48     define property recipe-gds as subjects no-undo
       49       get.
       50       private set.
       51     define override property InitTag as character no-undo init "recipe"
       52       get.
       53     constructor public recipe ():
       54       InitListTag = "recipe-gds".
       55     end constructor.
       56     method override protected void SetPropProtected (inTag as char, inValue as char):
       57       case inTag:
       58         when "recipe-code" then recipe-code = if inValue >= "" then inValue else "" .
       59         when "gd-code"     then gd-code     = if inValue >= "" then inValue else "" .
       60         when "del-l"       then del-l       = if inValue >= "" then integer (inValue) else 0 .
       61         when "del-f"       then del-f       = if inValue >= "" then integer (inValue) else 0 .
       62         when "status"      then do:
       63           if inValue >= "" then status_     = enum-recipe-status:GetEnum( integer (inValue) ) .
       64                            else status_     = enum-recipe-status:enopen .
       65         end .
       66         when "qnty"        then qnty        = if inValue >= "" then integer (inValue) else 0 .
       67         when "qnty-netto"  then qnty-netto  = if inValue >= "" then decimal (inValue) else 0.0 .
       68         when "recipe-name" then recipe-name = if inValue >= "" then inValue else "" .
       69         when "recipe-type" then do :
       70           if inValue >= "" then recipe-type = enum-recipe-type:GetEnum( integer (inValue) ) .
       71                            else recipe-type = enum-recipe-type:enmanufacturing .
       72         end .
       73         when "recipe-num"  then recipe-num  = if inValue >= "" then inValue else "" .
       74         when "weight"      then weight      = if inValue >= "" then decimal (inValue) else 0.0 .
       75         when "main"        then main        = if inValue >= "" then integer (inValue) else 0 .
       76       end case.
       77       catch exProErrors as class Progress.Lang.ProError :
       78         case exProErrors:GetMessageNum(1):
       79           when 18207 then undo, throw new Progress.Lang.AppError(
       80             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       81           ) .
       82           otherwise undo, throw new Progress.Lang.AppError(
       83             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       84           ) .
       85         end case .
       86       end catch .
       87     end method.
       88     method override protected void SetPropProtected (SubsObj as subjects):
       89       case SubsObj:InitTag:
       90         when "recipe-gds" then recipe-gds = SubsObj.
       91       end case.
       92     end method.
       93     method override protected void CheckData ():
       94       def var v-str as char no-undo.
       95       assign
       96         v-str = ",recipe-code" when recipe-code = ?
       97         v-str = v-str + ",gd-code" when gd-code = ?
       98         v-str = v-str + ",recipe-gds" when not valid-object(recipe-gds)
       99       .
      100       v-str = substring(v-str, 2).
      101       if v-str > "" then undo, throw new Progress.Lang.AppError(
      102         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      103       ) .
      104     end method.
      105     method override protected void ClearSub():
      106       assign
      107         recipe-code = ?
      108         gd-code     = ?
      109         del-l       = ?
      110         del-f       = ?
      111         qnty        = ?
      112         qnty-netto  = ?
      113         recipe-name = ?
      114         recipe-type = ?
      115         recipe-num  = ?
      116         weight      = ?
      117         main        = ?
      118       .
      119       if valid-object(recipe-gds) then delete object recipe-gds .
      120     end method.
      121   end class.
