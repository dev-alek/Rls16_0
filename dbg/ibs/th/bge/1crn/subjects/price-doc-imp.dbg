        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.price-doc_gds-sale from propath.
        4   using ibs.th.bge.1crn.subjects.price-doc-imp from propath.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.price-doc-imp inherits ibs.th.bge.1crn.subjects.asubject:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define property doc-num     as character    no-undo get.
       13       private set.
       14     define property doc-id     as character    no-undo get.
       15       private set.
       16     define property doc-num-ES  as character    no-undo get.
       17       private set.
       18     define property doc-date    as character    no-undo get.
       19       private set.
       20     define property doc-status  as character    no-undo get.
       21       private set.
       22     define property status-date as datetime-tz  no-undo get.
       23       private set.
       24     define property cr-gs       as integer      no-undo get.
       25       private set.
       26     define property cmnt        as character    no-undo get.
       27       private set.
       28     define property gds-sale    as subjects no-undo get.
       29       private set.
       30     define override property InitTag as character no-undo init "price-doc"
       31       get.
       32     constructor public price-doc-imp ():
       33       InitListTag = "gds-sale".
       34     end constructor.
       35     method override protected void SetPropProtected (inTag as char, inValue as char) :
       36        case inTag:
       37         when "doc-num" then
       38           do:
       39             assign
       40               doc-num-ES = inValue .
       41           end.
       42         when "doc-id" then
       43           do:
       44             assign
       45               doc-id = inValue .
       46           end.
       47         when "doc-num-gs" then
       48           do:
       49             assign
       50               doc-num = inValue .
       51           end.
       52         when "cr-gs" then
       53           do:
       54             assign
       55               cr-gs = integer (inValue).
       56           end.
       57         when "doc-date" then
       58           do:
       59             assign
       60               doc-date = inValue.
       61           end.
       62         when "doc-status" then
       63           do:
       64             assign
       65               doc-status = inValue.
       66           end.
       67         when "status-date" then
       68           do:
       69             assign
       70               status-date = datetime-tz(inValue).
       71           end.
       72         when "cmnt" then
       73           do:
       74             assign
       75               cmnt = inValue.
       76           end.
       77       end case.
       78     end method.
       79     method override protected void SetPropProtected(SubsObj as subjects):
       80       case SubsObj:InitTag:
       81         when "gds-sale" then
       82           do:
       83             gds-sale = SubsObj.
       84           end.
       85       end case.
       86     end.
       87     method override protected void CheckData ():
       88       def var v-str as char no-undo.
       89       if v-str > ''
       90       then
       91         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       92     end method .
       93     method override protected void ClearSub():
       94       assign
       95           doc-num      = ?
       96           doc-id       = ?
       97           doc-num-ES   = ?
       98           doc-date     = ?
       99           doc-status   = ?
      100           status-date  = ?
      101           cr-gs        = ?
      102           cmnt         = ?
      103       .
      104       delete object gds-sale no-error.
      105     end method .
      106   end class.
