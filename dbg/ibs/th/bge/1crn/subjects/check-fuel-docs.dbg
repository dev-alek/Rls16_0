        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.check-fuel-docs implements iexpsubject:
        5     define buffer buf_rvs-doc             for ub.rvs-doc .
        6     define buffer buf_c-rvs-doc           for ub.c-rvs-doc .
        7     define buffer buf_rvs-line            for ub.rvs-line .
        8     define buffer buf_c-rvs-line          for ub.c-rvs-line .
        9     define buffer buf_doc-attr            for ub.doc-attr .
       10     define buffer buf_c-doc-attr          for ub.c-doc-attr .
       11     define buffer buf_rvs-line-attr       for ub.rvs-line-attr .
       12     define buffer buf_rvs-line-pump       for ub.rvs-line-pump .
       13     define buffer buf_c-rvs-line-pump     for ub.c-rvs-line-pump .
       14     define buffer buf_parent_user-account for ub.user-account .
       15     define buffer buf_user-account        for ub.user-account .
       16     define buffer buf_place-attr          for ub.place-attr .
       17     define buffer buf_rvs-doc-attr        for ub.rvs-doc-attr .
       18     define temp-table tt-rvs-doc like ub.c-rvs-doc
       19       field del-f as integer .
       20     define temp-table tt-rvs-line like ub.c-rvs-line .
       21     define temp-table tt-doc-attr like ub.doc-attr .
       22     define temp-table tt-rvs-line-attr like ub.rvs-line-attr .
       23     define temp-table tt-rvs-line-pump like ub.c-rvs-line-pump .
       24     define variable v-user-name             as character no-undo .
       25     define variable v-autorvs               as integer   no-undo init 0 .
       26     define variable v-type                  as character no-undo .
       27     define variable v-dnsty                 as decimal   no-undo .
       28     define variable v-wght                  as decimal   no-undo .
       29     define variable v-ex-df                 as decimal   no-undo .
       30     define variable v-dens-sug              as decimal   no-undo .
       31     define variable v-pres-sug              as decimal   no-undo .
       32     define variable v-dens-sug-fact         as decimal   no-undo .
       33     define variable v-pres-sug-fact         as decimal   no-undo .
       34     define variable v-line-input-type-p as character no-undo .
       35     define variable v-line-input-type-t as character no-undo .
       36     define variable v-line-input-type-l as character no-undo .
       37     define variable v-doc-input-type        as character no-undo .
       38     define variable v-input-type-list       as character no-undo .
       39     define variable er-wght-pipeline        as decimal   no-undo .
       40     define variable v-temp-izm-vol          as decimal no-undo .
       41     define variable it                      as integer no-undo .
       42     define variable id                      as integer no-undo .
       43     define variable sr-type-temp            as integer no-undo .
       44     define variable sr-type-dens            as integer no-undo .
       45     define variable v-izm-temps             as character no-undo .
       46     define variable v-izm-denses            as character no-undo .
       47     define variable v-POkMI-result-attr     as character no-undo .
       48     define variable v-POkMI-mass            as decimal no-undo .
       49     define variable v-POkMI-otn-delta-mass  as decimal no-undo .
       50     define variable v-POkMI-standart-dens   as decimal no-undo .
       51     define variable v-POkMI-standart-vol    as decimal no-undo .
       52     define variable v-POkMI-vol             as decimal no-undo .
       53     define variable v-POkMI-water-vol       as decimal no-undo .
       54     define variable v-ASI-POkMI-standart-dens   as decimal no-undo .
       55     define variable ii                      as integer no-undo .
       56     define variable v-is-sug                as logical no-undo .
       57     define variable v-dnst-mi               as character no-undo .
       58     define variable v-lvl-mi                as character no-undo .
       59     define variable v-tmp-mi                as character no-undo .
       60     define variable varmeasure-water-qnty   as decimal no-undo.
       61     define variable varstate-water-qnty     as decimal no-undo.
       62     define variable v-pl-code               as character no-undo .
       63     define variable v-test-asi-diff         as decimal no-undo .
       64     define property Msg as character no-undo
       65       get.
       66       private set.
       67     define property DocCode as character no-undo
       68       get.
       69       set.
       70     define property InitSecTag as character no-undo
       71       get.
       72       private set.
       73     define public property sendTableName  as character  no-undo init "rvs-doc"
       74       get.
       75     define public property sendOldRowid as rowid  no-undo
       76       get.
       77       set.
       78     define public property sendNewRowid as rowid  no-undo
       79       get.
       80       set.
       81     define variable sw as handle no-undo.
       82     define private variable libFindtank as class ibs.th.str.findtank no-undo .
       83     method public void CrContentToSW (insw as handle):
       84       sw = insw .
       85       libFindtank = new ibs.th.str.findtank ().
       86       find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-code = DocCode no-error.
       87       if available (buf_rvs-doc) then
       88       do:
       89         buffer-copy buf_rvs-doc to tt-rvs-doc .
       90         tt-rvs-doc.del-f = 0 .
       91         tt-rvs-doc.fact-time = buf_rvs-doc.fact-time .
       92         sendOldRowid  = rowid(buf_rvs-doc).
       93       end.
       94       else
       95       do:
       96         find first buf_c-rvs-doc no-lock where buf_c-rvs-doc.rvs-code = DocCode no-error.
       97         if available (buf_c-rvs-doc) then
       98         do:
       99           buffer-copy buf_c-rvs-doc to tt-rvs-doc .
      100           tt-rvs-doc.del-f = 1 .
      101           sendOldRowid  = rowid(buf_c-rvs-doc).
      102         end.
      103         else return.
      104       end.
      105       find first buf_doc-attr no-lock where tt-rvs-doc.rvs-code = buf_doc-attr.doc-code and buf_doc-attr.attr-code = "rvs-auto" and buf_doc-attr.attr-value = "Yes" no-error.
      106       if available buf_doc-attr then
      107       do :
      108         v-autorvs = 1.
      109       end.
      110       else
      111       do:
      112         find first buf_c-doc-attr no-lock where tt-rvs-doc.rvs-code = buf_c-doc-attr.doc-code and buf_c-doc-attr.attr-code = "rvs-auto" and buf_c-doc-attr.attr-value = "Yes" no-error.
      113         if available buf_c-doc-attr then
      114         do :
      115           v-autorvs = 1.
      116         end.
      117       end.
      118       case tt-rvs-doc.rvs-type:
      119         when 'перед_док':U then
      120           do:
      121             v-type = "1" .
      122           end.
      123         when 'после_док':U then
      124           do:
      125             v-type = "2" .
      126           end.
      127         when 'смена':U then
      128           do:
      129             v-type = "4" .
      130           end.
      131         when 'контроль':U then
      132           do:
      133             v-type = "3" .
      134           end.
      135         when 'проверка':U then
      136           do:
      137             v-type = "test-asi" .
      138           end.
      139       end case.
      140       find first buf_user-account no-lock
      141         where buf_user-account.user-id = tt-rvs-doc.creid
      142         no-error .
      143       if not available buf_user-account
      144         then
      145       do:
      146         assign
      147           v-user-name = tt-rvs-doc.creid
      148           .
      149       end.
      150       else
      151       do:
      152         if buf_user-account.check-parent = true
      153           then
      154         do:
      155           find first buf_parent_user-account no-lock
      156             where buf_parent_user-account.user-id = buf_user-account.parent-user-id
      157             no-error .
      158           if not available buf_parent_user-account
      159             then
      160           do:
      161             assign
      162               v-user-name = tt-rvs-doc.creid
      163               .
      164           end.
      165           else
      166           do:
      167             assign
      168               v-user-name = buf_user-account.nik
      169               .
      170           end.
      171         end.
      172         else
      173         do:
      174           assign
      175             v-user-name = buf_user-account.nik
      176             .
      177         end.
      178       end.
      179       if tt-rvs-doc.del-f = 0 then
      180       do:
      181         for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = tt-rvs-doc.rvs-code:
      182           create tt-rvs-line .
      183           buffer-copy buf_rvs-line to tt-rvs-line .
      184         end.
      185         for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = tt-rvs-doc.rvs-code
      186                                              and buf_rvs-line-pump.obj-code = tt-rvs-doc.obj-code
      187                                              and buf_rvs-line-pump.obj-type = tt-rvs-doc.obj-type
      188                                              break
      189                                              by buf_rvs-line-pump.pump-code
      190                                              by buf_rvs-line-pump.nozzle-code:
      191           if first-of(buf_rvs-line-pump.nozzle-code)
      192           then do :
      193             find first tt-rvs-line-pump where tt-rvs-line-pump.pump-code    = buf_rvs-line-pump.pump-code
      194                                           and tt-rvs-line-pump.nozzle-code  = buf_rvs-line-pump.nozzle-code
      195                                           and tt-rvs-line-pump.pl-code      = buf_rvs-line-pump.pl-code
      196                                           no-error .
      197             if not available tt-rvs-line-pump
      198             then do :
      199               create tt-rvs-line-pump .
      200               buffer-copy buf_rvs-line-pump to tt-rvs-line-pump .
      201             end.
      202           end.
      203         end.
      204       end.
      205       else
      206       do:
      207         for each buf_c-rvs-line no-lock where buf_c-rvs-line.rvs-code = tt-rvs-doc.rvs-code and buf_c-rvs-line.chip-num = tt-rvs-doc.chip-num:
      208           create tt-rvs-line .
      209           buffer-copy buf_c-rvs-line to tt-rvs-line .
      210         end.
      211         for each buf_c-rvs-line-pump no-lock where buf_c-rvs-line-pump.rvs-code = tt-rvs-doc.rvs-code
      212                                                and buf_c-rvs-line-pump.obj-code = tt-rvs-doc.obj-code
      213                                                and buf_c-rvs-line-pump.obj-type = tt-rvs-doc.obj-type
      214                                                break
      215                                                by buf_c-rvs-line-pump.pump-code
      216                                                by buf_c-rvs-line-pump.nozzle-code:
      217           if first-of(buf_c-rvs-line-pump.nozzle-code)
      218           then do :
      219             find first tt-rvs-line-pump where tt-rvs-line-pump.pump-code    = buf_c-rvs-line-pump.pump-code
      220                                           and tt-rvs-line-pump.nozzle-code  = buf_c-rvs-line-pump.nozzle-code
      221                                           and tt-rvs-line-pump.pl-code      = buf_c-rvs-line-pump.pl-code
      222                                           no-error .
      223             if not available tt-rvs-line-pump
      224             then do :
      225               create tt-rvs-line-pump .
      226               buffer-copy buf_c-rvs-line-pump to tt-rvs-line-pump .
      227             end.
      228           end.
      229         end.
      230       end.
      231       if v-type = "test-asi"
      232       then do :
      233         expCheckCorrectDoc() .
      234       end .
      235       else do :
      236         expCheckFuelDoc() .
      237       end .
      238     end .
      239     method private void expCheckCorrectDoc() :
      240       InitSecTag = "check-correct-docs" .
      241       define variable v-asi-type as character no-undo .
      242       find first buf_doc-attr no-lock where buf_doc-attr.doc-code = tt-rvs-doc.rvs-code
      243                                         and buf_doc-attr.attr-code = "test-asi-type"
      244                                         no-error .
      245       if not available buf_doc-attr
      246       then do :
      247         find last buf_c-doc-attr no-lock where buf_c-doc-attr.doc-code = tt-rvs-doc.rvs-code
      248                                            and buf_c-doc-attr.attr-code = "test-asi-type"
      249                                            no-error .
      250         if available buf_c-doc-attr
      251         then do :
      252           assign v-asi-type = buf_c-doc-attr.attr-value .
      253         end .
      254       end .
      255       else do :
      256         assign v-asi-type = buf_doc-attr.attr-value .
      257       end .
      258       case v-asi-type :
      259         when "test-asi_dens-place" then v-type = "1" .
      260         when "test-asi_dens-pump" then v-type = "2" .
      261         when "test-asi_mass" then v-type = "3" .
      262         otherwise v-type = "0" .
      263       end case .
      264       sw:start-element ("check-correct-doc") .
      265       sw:write-data-element ("doc-code", if tt-rvs-doc.rvs-code = ? then "" else string(tt-rvs-doc.rvs-code)) no-error .
      266       sw:write-data-element ("doc-num", if tt-rvs-doc.rvs-code = ? then "" else string(tt-rvs-doc.rvs-code)) no-error .
      267       sw:write-data-element ("doc-date", if tt-rvs-doc.doc-date = ? then "" else iso-date(datetime(tt-rvs-doc.doc-date, (tt-rvs-doc.fact-time * 1000 )))).
      268       sw:write-data-element ("doc-date-f", if tt-rvs-doc.sys-date = ? then "" else iso-date(datetime(tt-rvs-doc.sys-date, (tt-rvs-doc.sys-time-int * 1000 )))).
      269       sw:write-data-element ("del-f", if tt-rvs-doc.del-f = ? then "" else string(tt-rvs-doc.del-f)) no-error .
      270       sw:write-data-element ("doc-type", string(v-type)) no-error .
      271       sw:write-data-element ("shift-date", if tt-rvs-doc.shift-date = ? then "" else iso-date(tt-rvs-doc.shift-date)) no-error .
      272       sw:write-data-element ("shift-num", if tt-rvs-doc.shift-num = ? then "" else string(tt-rvs-doc.shift-num)) no-error .
      273       sw:write-data-element ("operator", if v-user-name = ? then "" else string(v-user-name)) no-error .
      274       sw:start-element ("tanks") .
      275       for each tt-rvs-line no-lock:
      276         varmeasure-water-qnty = (tt-rvs-line.brutto-qnty - tt-rvs-line.measure-qnty) .
      277         assign
      278           v-dnsty = ?
      279           v-wght = ?
      280           v-ex-df = ?
      281           v-line-input-type-p = ""
      282           v-line-input-type-T = ""
      283           v-line-input-type-l = ""
      284           v-dens-sug = ?
      285           v-pres-sug = ?
      286           v-dens-sug-fact = ?
      287           v-pres-sug-fact = ?
      288           v-temp-izm-vol = ?
      289           v-dnst-mi = ""
      290           v-lvl-mi = ""
      291           v-tmp-mi = ""
      292           sr-type-temp = ?
      293           v-izm-temps = ""
      294           sr-type-dens = ?
      295           v-izm-denses = ""
      296           v-POkMI-result-attr = ""
      297           varmeasure-water-qnty = ?
      298           varstate-water-qnty = ?
      299           v-test-asi-diff = ?
      300         .
      301         for each buf_rvs-line-attr no-lock
      302           where buf_rvs-line-attr.obj-code  = tt-rvs-line.obj-code
      303           and buf_rvs-line-attr.obj-type  = tt-rvs-line.obj-type
      304           and buf_rvs-line-attr.gds-code  = tt-rvs-line.gds-code
      305           and buf_rvs-line-attr.pl-code   = tt-rvs-line.pl-code
      306           and buf_rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code:
      307           case buf_rvs-line-attr.attr-code:
      308             when "test-asi-diff" then
      309               do:
      310                 v-test-asi-diff = decimal(buf_rvs-line-attr.attr-value) .
      311               end.
      312             when "izmer-density" then
      313               do:
      314                 v-dnsty = decimal(buf_rvs-line-attr.attr-value) .
      315               end.
      316             when "delta-mass-qnty" then
      317               do:
      318                 v-wght = decimal(buf_rvs-line-attr.attr-value) .
      319               end.
      320             when "CriticalDif" then
      321               do:
      322                 v-ex-df = decimal(buf_rvs-line-attr.attr-value) .
      323               end.
      324             when "temp-izm-vol" then
      325               do:
      326                 v-temp-izm-vol = decimal(buf_rvs-line-attr.attr-value) .
      327               end.
      328             when "izm-temps" then
      329               do:
      330                 sr-type-temp = integer(entry(1, buf_rvs-line-attr.attr-value, ";")) no-error .
      331                 v-izm-temps = entry(2, buf_rvs-line-attr.attr-value, ";") no-error .
      332               end.
      333             when "izm-denses" then
      334               do:
      335                 sr-type-dens = integer(entry(1, buf_rvs-line-attr.attr-value, ";")) no-error .
      336                 v-izm-denses = entry(2, buf_rvs-line-attr.attr-value, ";") no-error .
      337               end.
      338             when "POkMI-result" then
      339               do:
      340                 v-POkMI-result-attr = buf_rvs-line-attr.attr-value .
      341                 v-POkMI-mass            = decimal(entry(2, entry(1, v-POkMI-result-attr, chr(10)), ":")) no-error .
      342                 v-POkMI-otn-delta-mass  = decimal(entry(2, entry(2, v-POkMI-result-attr, chr(10)), ":")) no-error .
      343                 v-POkMI-standart-dens   = decimal(entry(2, entry(3, v-POkMI-result-attr, chr(10)), ":")) no-error .
      344                 v-POkMI-standart-vol    = decimal(entry(2, entry(4, v-POkMI-result-attr, chr(10)), ":")) no-error .
      345                 v-POkMI-vol             = decimal(entry(2, entry(5, v-POkMI-result-attr, chr(10)), ":")) no-error .
      346                 v-POkMI-water-vol       = decimal(entry(2, entry(6, v-POkMI-result-attr, chr(10)), ":")) no-error .
      347               end .
      348             when "pokmi-water-qnty" then
      349               do:
      350                 if not v-is-sug
      351                 then do :
      352                   varstate-water-qnty = decimal(buf_rvs-line-attr.attr-value) .
      353                 end .
      354               end.
      355             when "measure-water-qnty" then
      356               do:
      357                 varmeasure-water-qnty = decimal(buf_rvs-line-attr.attr-value) .
      358               end.
      359             when "asi-pomi-density" then
      360               do:
      361                 v-ASI-POkMI-standart-dens = decimal(buf_rvs-line-attr.attr-value) .
      362               end.
      363           end case .
      364         end.
      365         if v-wght = ? then v-wght = 0 .
      366         if v-ex-df = ? then v-ex-df = 0 .
      367         find first buf_place-attr no-lock where buf_place-attr.attr-code   = "place-error-mass"
      368                                             and buf_place-attr.obj-code    = tt-rvs-line.obj-code
      369                                             and buf_place-attr.obj-type    = tt-rvs-line.obj-type
      370                                             and buf_place-attr.pl-code     = tt-rvs-line.pl-code no-error.
      371         if available buf_place-attr
      372         then do :
      373           er-wght-pipeline = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density * decimal(buf_place-attr.attr-value) / 100 no-error.
      374         end.
      375         else er-wght-pipeline = ? .
      376         sw:start-element ("tank") .
      377         sw:write-data-element ("tank-num"  , if tt-rvs-line.pl-code = ? then "0" else string(tt-rvs-line.pl-code)) no-error .
      378         sw:write-data-element ("gd-code"  , if tt-rvs-line.gds-code = ? then "0" else string(tt-rvs-line.gds-code)) no-error .
      379         sw:write-data-element ("tank-cmn-lvl" , if tt-rvs-line.level-total = ? then "0" else string-mth(tt-rvs-line.level-total)) no-error .
      380         sw:write-data-element ("tnk-wtr-lvl" , if tt-rvs-line.level-water = ? then "0" else string-mth(tt-rvs-line.level-water)) no-error .
      381         if tt-rvs-line.temperature = ?
      382         then
      383           sw:write-empty-element ("tnk-t") .
      384         else
      385           sw:write-data-element ("tnk-t" , string-mth(tt-rvs-line.temperature)) no-error .
      386         sw:write-data-element ("tank-ost" , if tt-rvs-line.measure-qnty = ? then "0" else string(tt-rvs-line.measure-qnty)) no-error .
      387         sw:write-data-element ("tank-wght" , if tt-rvs-line.measure-cli-qnty = ? then "0" else string-mth(tt-rvs-line.measure-cli-qnty)) no-error .
      388         sw:write-data-element ("tank-dnst" , if tt-rvs-line.density = ? then "0" else string-mth(tt-rvs-line.density)) no-error .
      389         sw:write-data-element ("tank-wtr" , if varmeasure-water-qnty = ? then "0" else string-mth(varmeasure-water-qnty)) no-error .
      390         sw:write-data-element ("tank-ost-br" , if tt-rvs-line.brutto-qnty = ? then "0" else string-mth(tt-rvs-line.brutto-qnty)) no-error .
      391         sw:write-data-element ("tank-ost-fact" , if tt-rvs-line.state-measure-qnty = ? then "0" else string-mth(tt-rvs-line.state-measure-qnty)) no-error .
      392         sw:write-data-element ("tank-dnst-fact" , if tt-rvs-line.state-density = ? then "0" else string-mth(tt-rvs-line.state-density)) no-error .
      393         sw:write-data-element ("tank-ost-br-fact" , if tt-rvs-line.state-brutto-qnty = ? then "0" else string-mth(tt-rvs-line.state-brutto-qnty)) no-error .
      394         sw:write-data-element ("tank-wtr-fact" , if varstate-water-qnty = ? then "0" else string-mth(varstate-water-qnty)) no-error .
      395         sw:write-data-element ("tank-wght-fact" , if tt-rvs-line.state-measure-cli-qnty = ? then "0" else string-mth(tt-rvs-line.state-measure-cli-qnty)) no-error .
      396         sw:write-data-element ("tank-cmn-lvl-fact" , if tt-rvs-line.state-level-total = ? then "0" else string-mth(tt-rvs-line.state-level-total)) no-error .
      397         sw:write-data-element ("tnk-wtr-lvl-fact" , if tt-rvs-line.state-level-water = ? then "0" else string-mth(tt-rvs-line.state-level-water)) no-error .
      398         sw:write-data-element ("tnk-t-vlm-fact" , if v-temp-izm-vol = ? then "0" else string-mth(v-temp-izm-vol)) no-error .
      399         sw:write-data-element ("tnk-t-average-fact" , if tt-rvs-line.state-temperature = ? then "0" else string-mth(tt-rvs-line.state-temperature)) no-error .
      400         case sr-type-temp :
      401           when 0
      402           then
      403           do it = 1 to num-entries(v-izm-temps) :
      404             sw:write-data-element (substitute("tnk-t&1-fact", string(it)) , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      405           end .
      406           when 1
      407           then
      408           do it = 1 to num-entries(v-izm-temps) :
      409             if it = 1
      410             then
      411               sw:write-data-element ("tnk-t-low-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      412             if it = 2
      413             then
      414               sw:write-data-element ("tnk-t-mid-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      415             if it = 3
      416             then
      417               sw:write-data-element ("tnk-t-upp-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      418           end .
      419         end case .
      420         sw:write-data-element ("ms-dnsty-average" , if v-dnsty = ? then "0" else string-mth(v-dnsty)) no-error .
      421         case sr-type-dens :
      422           when 0
      423           then
      424           do id = 1 to num-entries(v-izm-denses) :
      425             sw:write-data-element (substitute("ms-dnsty&1", string(id)) , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      426           end .
      427           when 1
      428           then
      429           do id = 1 to num-entries(v-izm-denses) :
      430             if id = 1
      431             then
      432               sw:write-data-element ("ms-dnsty-low" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      433             if id = 2
      434             then
      435               sw:write-data-element ("ms-dnsty-mid" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      436             if id = 3
      437             then
      438               sw:write-data-element ("ms-dnsty-upp" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      439           end .
      440         end case .
      441         sw:write-data-element ("er-wght" , string-mth(v-wght)) no-error .
      442         sw:write-data-element ("abs-er-wght" , if (tt-rvs-line.state-measure-cli-qnty * v-wght / 100) = ? then "0" else string-mth(tt-rvs-line.state-measure-cli-qnty * v-wght / 100)) no-error .
      443         case v-type :
      444           when "1"
      445           then do :
      446             sw:write-data-element ("calc-dnst" , string-mth(tt-rvs-line.density)) no-error .
      447             sw:write-data-element ("calc-dnst-fact" , string-mth(v-dnsty)) no-error .
      448             sw:write-data-element ("calc-dnst-discrepancy" , string-mth(v-test-asi-diff)) no-error .
      449             sw:write-data-element ("calc-dnst-discrepancy-gram" , string-mth(v-test-asi-diff / 1000)) no-error .
      450           end .
      451           when "2"
      452           then do :
      453             sw:write-data-element ("pomi-wght" , string-mth(v-POkMI-mass)) no-error .
      454             sw:write-data-element ("pomi-rel-me" , string-mth(v-POkMI-otn-delta-mass)) no-error .
      455             sw:write-data-element ("pomi-dnst" , string-mth(v-POkMI-standart-dens)) no-error .
      456             sw:write-data-element ("pomi-vlm-st" , string-mth(v-POkMI-standart-vol)) no-error .
      457             sw:write-data-element ("pomi-vlm-tv" , string-mth(v-POkMI-vol)) no-error .
      458             sw:write-data-element ("pomi-wtr" , string-mth(v-POkMI-water-vol)) no-error .
      459             sw:write-data-element ("calc-dnst" , string-mth(tt-rvs-line.density)) no-error .
      460             sw:write-data-element ("calc-dnst-fact" , string-mth(v-POkMI-standart-dens)) no-error .
      461             sw:write-data-element ("calc-dnst-discrepancy" , string-mth(v-test-asi-diff)) no-error .
      462             sw:write-data-element ("calc-dnst-above" , string-mth(v-ASI-POkMI-standart-dens)) no-error .
      463             sw:write-data-element ("calc-dnst-discrepancy-gram" , string-mth(v-test-asi-diff / 1000)) no-error .
      464           end .
      465           when "3"
      466           then do :
      467             sw:write-data-element ("pomi-wght" , string-mth(v-POkMI-mass)) no-error .
      468             sw:write-data-element ("pomi-rel-me" , string-mth(v-POkMI-otn-delta-mass)) no-error .
      469             sw:write-data-element ("pomi-dnst" , string-mth(v-POkMI-standart-dens)) no-error .
      470             sw:write-data-element ("pomi-vlm-st" , string-mth(v-POkMI-standart-vol)) no-error .
      471             sw:write-data-element ("pomi-vlm-tv" , string-mth(v-POkMI-vol)) no-error .
      472             sw:write-data-element ("pomi-wtr" , string-mth(v-POkMI-water-vol)) no-error .
      473             sw:write-data-element ("calc-wght" , string-mth(tt-rvs-line.measure-cli-qnty)) no-error .
      474             sw:write-data-element ("calc-wght-fact" , string-mth(tt-rvs-line.state-measure-cli-qnty)) no-error .
      475             sw:write-data-element ("calc-wght-discrepancy" , string-mth(v-test-asi-diff)) no-error .
      476             sw:write-data-element ("calc-wght-discrepancy-kilo" , string-mth(ABS(tt-rvs-line.state-measure-cli-qnty - tt-rvs-line.measure-cli-qnty))) no-error .
      477           end .
      478         end case .
      479         sw:end-element ("tank")  .
      480       end .
      481       sw:end-element ("tanks")  .
      482       sw:start-element ("comp-comm") .
      483         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      484                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-1"
      485                                               no-error .
      486         if available buf_rvs-doc-attr
      487         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      488         then do :
      489           sw:write-data-element ("chairmen1", entry(1, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      490         end .
      491         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      492                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-2"
      493                                               no-error .
      494         if available buf_rvs-doc-attr
      495         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      496         then do :
      497           sw:write-data-element ("chairmen2", entry(1, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      498         end .
      499         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      500                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-3"
      501                                               no-error .
      502         if available buf_rvs-doc-attr
      503         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      504         then do :
      505           sw:write-data-element ("chairmen3", entry(1, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      506         end .
      507         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      508                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-4"
      509                                               no-error .
      510         if available buf_rvs-doc-attr
      511         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      512         then do :
      513           sw:write-data-element ("chairmen4", entry(1, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      514         end .
      515         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      516                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-5"
      517                                               no-error .
      518         if available buf_rvs-doc-attr
      519         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      520         then do :
      521           sw:write-data-element ("chairmen5", entry(1, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      522         end .
      523         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      524                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-1"
      525                                               no-error .
      526         if available buf_rvs-doc-attr
      527         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      528         then do :
      529           sw:write-data-element ("jobtitle1", entry(2, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      530         end .
      531         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      532                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-2"
      533                                               no-error .
      534         if available buf_rvs-doc-attr
      535         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      536         then do :
      537           sw:write-data-element ("jobtitle2", entry(2, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      538         end .
      539         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      540                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-3"
      541                                               no-error .
      542         if available buf_rvs-doc-attr
      543         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      544         then do :
      545           sw:write-data-element ("jobtitle3", entry(2, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      546         end .
      547         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      548                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-4"
      549                                               no-error .
      550         if available buf_rvs-doc-attr
      551         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      552         then do :
      553           sw:write-data-element ("jobtitle4", entry(2, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      554         end .
      555         find first buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = tt-rvs-doc.rvs-code
      556                                               and buf_rvs-doc-attr.attr-code = "test-asi-commission-5"
      557                                               no-error .
      558         if available buf_rvs-doc-attr
      559         and num-entries(buf_rvs-doc-attr.attr-value, chr(4)) = 2
      560         then do :
      561           sw:write-data-element ("jobtitle5", entry(2, buf_rvs-doc-attr.attr-value, chr(4))) no-error .
      562         end .
      563       sw:end-element ("comp-comm")  .
      564       sw:end-element ("check-correct-doc")  .
      565       return .
      566     end method .
      567     method private void expCheckFuelDoc() :
      568       InitSecTag = "check-fuel-docs" .
      569       v-input-type-list = '' .
      570       for each tt-rvs-line no-lock :
      571         for first buf_rvs-line-attr no-lock
      572           where buf_rvs-line-attr.obj-code  = tt-rvs-line.obj-code
      573           and buf_rvs-line-attr.obj-type  = tt-rvs-line.obj-type
      574           and buf_rvs-line-attr.gds-code  = tt-rvs-line.gds-code
      575           and buf_rvs-line-attr.pl-code   = tt-rvs-line.pl-code
      576           and buf_rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
      577           and buf_rvs-line-attr.attr-code = 'input-type-p':
      578           v-input-type-list = v-input-type-list + ',' + buf_rvs-line-attr.attr-value .
      579         end.
      580         for first buf_rvs-line-attr no-lock
      581           where buf_rvs-line-attr.obj-code  = tt-rvs-line.obj-code
      582           and buf_rvs-line-attr.obj-type  = tt-rvs-line.obj-type
      583           and buf_rvs-line-attr.gds-code  = tt-rvs-line.gds-code
      584           and buf_rvs-line-attr.pl-code   = tt-rvs-line.pl-code
      585           and buf_rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
      586           and buf_rvs-line-attr.attr-code = 'input-type-t':
      587           v-input-type-list = v-input-type-list + ',' + buf_rvs-line-attr.attr-value .
      588         end.
      589         for first buf_rvs-line-attr no-lock
      590           where buf_rvs-line-attr.obj-code  = tt-rvs-line.obj-code
      591           and buf_rvs-line-attr.obj-type  = tt-rvs-line.obj-type
      592           and buf_rvs-line-attr.gds-code  = tt-rvs-line.gds-code
      593           and buf_rvs-line-attr.pl-code   = tt-rvs-line.pl-code
      594           and buf_rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code
      595           and buf_rvs-line-attr.attr-code = 'input-type-l':
      596           v-input-type-list = v-input-type-list + ',' + buf_rvs-line-attr.attr-value .
      597         end.
      598       end.
      599       v-input-type-list = left-trim(v-input-type-list, ",") .
      600       if can-do(v-input-type-list, 'а')
      601       and not can-do(v-input-type-list, 'ф')
      602       and not can-do(v-input-type-list, 'ак')
      603       and not can-do(v-input-type-list, 'фк')
      604       and not can-do(v-input-type-list, 'п')
      605       then v-doc-input-type = 'а'.
      606       if can-do(v-input-type-list, 'ф')
      607       and not can-do(v-input-type-list, 'а')
      608       and not can-do(v-input-type-list, 'ак')
      609       and not can-do(v-input-type-list, 'фк')
      610       and not can-do(v-input-type-list, 'п')
      611       then v-doc-input-type = 'ф'.
      612       if  not can-do(v-input-type-list, 'ф')
      613       and can-do(v-input-type-list, 'ак')
      614       and not can-do(v-input-type-list, 'п')
      615       then v-doc-input-type = 'ак'.
      616       if ((can-do(v-input-type-list, 'ф')
      617       or can-do(v-input-type-list, 'п'))
      618       and can-do(v-input-type-list, 'а'))
      619       or can-do(v-input-type-list, 'фк')
      620       then v-doc-input-type = 'фк'.
      621       if can-do(v-input-type-list, 'р')
      622       and not can-do(v-input-type-list, 'а')
      623       and not can-do(v-input-type-list, 'ф')
      624       and not can-do(v-input-type-list, 'к')
      625       and not can-do(v-input-type-list, 'п')
      626       then v-doc-input-type = 'р'.
      627       if v-doc-input-type = 'а'
      628       and (can-do(v-input-type-list, 'р')
      629         or can-do(v-input-type-list, ''))
      630       then v-doc-input-type = 'ак'.
      631       if v-doc-input-type = 'ф'
      632       and (can-do(v-input-type-list, 'р')
      633         or can-do(v-input-type-list, ''))
      634       then v-doc-input-type = 'фк'.
      635       define variable v-out-code as character no-undo .
      636       sw:start-element ("check-fuel-doc") .
      637       sw:write-data-element ("doc-code", if tt-rvs-doc.rvs-code = ? then "" else string(tt-rvs-doc.rvs-code)) no-error .
      638       sw:write-data-element ("doc-num", if tt-rvs-doc.rvs-code = ? then "" else string(tt-rvs-doc.rvs-code)) no-error .
      639       sw:write-data-element ("doc-date", if tt-rvs-doc.doc-date = ? then "" else iso-date(datetime(tt-rvs-doc.doc-date, (tt-rvs-doc.fact-time * 1000 )))).
      640       sw:write-data-element ("doc-date-f", if tt-rvs-doc.sys-date = ? then "" else iso-date(datetime(tt-rvs-doc.sys-date, (tt-rvs-doc.sys-time-int * 1000 )))).
      641       sw:write-data-element ("del-f", if tt-rvs-doc.del-f = ? then "" else string(tt-rvs-doc.del-f)) no-error .
      642       sw:write-data-element ("doc-type", string(v-type)) no-error .
      643       if v-type = "4" then do:
      644         if tt-rvs-doc.out-code = ? then do:
      645           if num-entries(tt-rvs-doc.PS,"№") > 1 then do:
      646             v-out-code = entry(2,tt-rvs-doc.PS,"№") .
      647             v-out-code = replace (v-out-code,".","") .
      648             v-out-code = trim(v-out-code," ").
      649           end.
      650           sw:write-data-element ("parent-doc", v-out-code) no-error .
      651         end.
      652         else sw:write-data-element ("parent-doc", tt-rvs-doc.out-code) no-error .
      653       end.
      654       sw:write-data-element ("inp-type", v-doc-input-type).
      655       sw:write-data-element ("shift-date", if tt-rvs-doc.shift-date = ? then "" else iso-date(tt-rvs-doc.shift-date)) no-error .
      656       sw:write-data-element ("shift-num", if tt-rvs-doc.shift-num = ? then "" else string(tt-rvs-doc.shift-num)) no-error .
      657       sw:write-data-element ("auto-cr", string(v-autorvs)) no-error .
      658       if tt-rvs-doc.out-code > "" then sw:write-data-element ("out-code", tt-rvs-doc.out-code).
      659       else sw:write-empty-element ("out-code").
      660       sw:write-data-element ("operator", if v-user-name = ? then "" else string(v-user-name)) no-error .
      661       sw:start-element ("tanks") .
      662       for each tt-rvs-line no-lock:
      663         v-is-sug = no .
      664         for first goods-attr no-lock where goods-attr.gds-code = tt-rvs-line.gds-code
      665                                        and goods-attr.attr-code = 'fuel-type':U
      666                                        :
      667           v-is-sug = logical(goods-attr.attr-value = 'lgas':U) no-error .
      668         end .
      669         if not v-is-sug
      670         then do :
      671           varmeasure-water-qnty = (tt-rvs-line.brutto-qnty - tt-rvs-line.measure-qnty) .
      672         end .
      673         assign
      674           v-dnsty = ?
      675           v-wght = ?
      676           v-ex-df = ?
      677           v-line-input-type-p = ""
      678           v-line-input-type-T = ""
      679           v-line-input-type-l = ""
      680           v-dens-sug = ?
      681           v-pres-sug = ?
      682           v-dens-sug-fact = ?
      683           v-pres-sug-fact = ?
      684           v-temp-izm-vol = ?
      685           v-dnst-mi = ""
      686           v-lvl-mi = ""
      687           v-tmp-mi = ""
      688           sr-type-temp = ?
      689           v-izm-temps = ""
      690           sr-type-dens = ?
      691           v-izm-denses = ""
      692           v-POkMI-result-attr = ""
      693           varmeasure-water-qnty = ?
      694           varstate-water-qnty = ?
      695         .
      696         for each buf_rvs-line-attr no-lock
      697           where buf_rvs-line-attr.obj-code  = tt-rvs-line.obj-code
      698           and buf_rvs-line-attr.obj-type  = tt-rvs-line.obj-type
      699           and buf_rvs-line-attr.gds-code  = tt-rvs-line.gds-code
      700           and buf_rvs-line-attr.pl-code   = tt-rvs-line.pl-code
      701           and buf_rvs-line-attr.rvs-code  = tt-rvs-line.rvs-code:
      702           case buf_rvs-line-attr.attr-code:
      703             when "izmer-density" then
      704               do:
      705                 v-dnsty = decimal(buf_rvs-line-attr.attr-value) .
      706               end.
      707             when "delta-mass-qnty" then
      708               do:
      709                 v-wght = decimal(buf_rvs-line-attr.attr-value) .
      710               end.
      711             when "CriticalDif" then
      712               do:
      713                 v-ex-df = decimal(buf_rvs-line-attr.attr-value) .
      714               end.
      715             when "input-type-p" then
      716               do:
      717                 v-line-input-type-p = buf_rvs-line-attr.attr-value .
      718                 if length(v-line-input-type-p) = 2 then v-line-input-type-p = substring(v-line-input-type-p, 2, 1) .
      719               end.
      720             when "input-type-T" then
      721               do:
      722                 v-line-input-type-T = buf_rvs-line-attr.attr-value .
      723                 if length(v-line-input-type-T) = 2 then v-line-input-type-T = substring(v-line-input-type-T, 2, 1) .
      724               end.
      725             when "input-type-l" then
      726               do:
      727                 v-line-input-type-l = buf_rvs-line-attr.attr-value .
      728                 if length(v-line-input-type-l) = 2 then v-line-input-type-l = substring(v-line-input-type-l, 2, 1) .
      729               end.
      730             when "dens-pf-sug" then
      731               do:
      732                 v-dens-sug = decimal(buf_rvs-line-attr.attr-value) .
      733               end.
      734             when "pressure-sug" then
      735               do:
      736                 v-pres-sug = decimal(buf_rvs-line-attr.attr-value) .
      737               end.
      738             when "state-dens-pf-sug" then
      739               do:
      740                 v-dens-sug-fact = decimal(buf_rvs-line-attr.attr-value) .
      741               end.
      742             when "state-pressure-sug" then
      743               do:
      744                 v-pres-sug-fact = decimal(buf_rvs-line-attr.attr-value) .
      745               end.
      746             when "temp-izm-vol" then
      747               do:
      748                 v-temp-izm-vol = decimal(buf_rvs-line-attr.attr-value) .
      749               end.
      750             when "mi-dnst" then
      751               do:
      752                 v-dnst-mi = buf_rvs-line-attr.attr-value .
      753               end.
      754             when "mi-lvl" then
      755               do:
      756                 v-lvl-mi = buf_rvs-line-attr.attr-value .
      757               end.
      758             when "mi-tmp" then
      759               do:
      760                 v-tmp-mi = buf_rvs-line-attr.attr-value .
      761               end.
      762             when "izm-temps" then
      763               do:
      764                 sr-type-temp = integer(entry(1, buf_rvs-line-attr.attr-value, ";")) no-error .
      765                 v-izm-temps = entry(2, buf_rvs-line-attr.attr-value, ";") no-error .
      766               end.
      767             when "izm-denses" then
      768               do:
      769                 sr-type-dens = integer(entry(1, buf_rvs-line-attr.attr-value, ";")) no-error .
      770                 v-izm-denses = entry(2, buf_rvs-line-attr.attr-value, ";") no-error .
      771               end.
      772             when "POkMI-result" then
      773               do:
      774                 v-POkMI-result-attr = buf_rvs-line-attr.attr-value .
      775                 if v-is-sug
      776                 then do :
      777                   v-POkMI-mass            = decimal(entry(2, entry(1, v-POkMI-result-attr, chr(10)), ":")) no-error .
      778                   v-POkMI-otn-delta-mass  = decimal(entry(2, entry(2, v-POkMI-result-attr, chr(10)), ":")) no-error .
      779                   v-POkMI-standart-vol    = decimal(entry(2, entry(3, v-POkMI-result-attr, chr(10)), ":")) no-error .
      780                 end .
      781                 else do :
      782                   v-POkMI-mass            = decimal(entry(2, entry(1, v-POkMI-result-attr, chr(10)), ":")) no-error .
      783                   v-POkMI-otn-delta-mass  = decimal(entry(2, entry(2, v-POkMI-result-attr, chr(10)), ":")) no-error .
      784                   v-POkMI-standart-dens   = decimal(entry(2, entry(3, v-POkMI-result-attr, chr(10)), ":")) no-error .
      785                   v-POkMI-standart-vol    = decimal(entry(2, entry(4, v-POkMI-result-attr, chr(10)), ":")) no-error .
      786                   v-POkMI-vol             = decimal(entry(2, entry(5, v-POkMI-result-attr, chr(10)), ":")) no-error .
      787                   v-POkMI-water-vol       = decimal(entry(2, entry(6, v-POkMI-result-attr, chr(10)), ":")) no-error .
      788                 end .
      789               end .
      790             when "sug-water-qnty" then
      791               do:
      792                 if v-is-sug
      793                 then do :
      794                   varmeasure-water-qnty = decimal(buf_rvs-line-attr.attr-value) .
      795                   varstate-water-qnty = varmeasure-water-qnty .
      796                 end .
      797               end.
      798             when "pokmi-water-qnty" then
      799               do:
      800                 if not v-is-sug
      801                 then do :
      802                   varstate-water-qnty = decimal(buf_rvs-line-attr.attr-value) .
      803                 end .
      804               end.
      805             when "measure-water-qnty" then
      806               do:
      807                 varmeasure-water-qnty = decimal(buf_rvs-line-attr.attr-value) .
      808               end.
      809           end case .
      810         end.
      811         if v-wght = ? then v-wght = 0 .
      812         if v-ex-df = ? then v-ex-df = 0 .
      813         if v-dens-sug-fact = 0 or v-dens-sug-fact = ? then v-dens-sug-fact = v-dens-sug .
      814         if v-pres-sug-fact = 0 or v-pres-sug-fact = ? then v-pres-sug-fact = v-pres-sug .
      815         find first buf_place-attr no-lock where buf_place-attr.attr-code   = "place-error-mass"
      816                                             and buf_place-attr.obj-code    = tt-rvs-line.obj-code
      817                                             and buf_place-attr.obj-type    = tt-rvs-line.obj-type
      818                                             and buf_place-attr.pl-code     = tt-rvs-line.pl-code no-error.
      819         if available buf_place-attr
      820         then do :
      821           er-wght-pipeline = tt-rvs-line.state-add-qnty * tt-rvs-line.state-density * decimal(buf_place-attr.attr-value) / 100 no-error.
      822         end.
      823         else er-wght-pipeline = ? .
      824         sw:start-element ("tank") .
      825         sw:write-data-element ("tank-num"  , if tt-rvs-line.pl-code = ? then "0" else string(tt-rvs-line.pl-code)) no-error .
      826         sw:write-data-element ("gd-code"  , if tt-rvs-line.gds-code = ? then "0" else string(tt-rvs-line.gds-code)) no-error .
      827         sw:write-data-element ("tank-ost" , if tt-rvs-line.measure-qnty = ? then "0" else string(tt-rvs-line.measure-qnty)) no-error .
      828         sw:write-data-element ("tank-ost-tc" , if tt-rvs-line.measure-tc-qnty = ? then "0" else string-mth(tt-rvs-line.measure-tc-qnty)) no-error .
      829         sw:write-data-element ("tank-dnst" , if tt-rvs-line.density = ? then "0" else string-mth(tt-rvs-line.density)) no-error .
      830         sw:write-data-element ("pipeline-qnty" , if tt-rvs-line.add-qnty = ? then "0" else string-mth(tt-rvs-line.add-qnty)) no-error .
      831         sw:write-data-element ("tank-ost-br" , if tt-rvs-line.brutto-qnty = ? then "0" else string-mth(tt-rvs-line.brutto-qnty)) no-error .
      832         sw:write-data-element ("tank-ost-br-tc" , if tt-rvs-line.brutto-tc-qnty = ? then "0" else string-mth(tt-rvs-line.brutto-tc-qnty)) no-error .
      833         sw:write-data-element ("tank-wtr" , if varmeasure-water-qnty = ? then "0" else string-mth(varmeasure-water-qnty)) no-error .
      834         sw:write-data-element ("tank-wght" , if tt-rvs-line.measure-cli-qnty = ? then "0" else string-mth(tt-rvs-line.measure-cli-qnty)) no-error .
      835         sw:write-data-element ("tank-wght-br" , if tt-rvs-line.brutto-cli-qnty = ? then "0" else string-mth(tt-rvs-line.brutto-cli-qnty)) no-error .
      836         sw:write-data-element ("tank-wtr-wght" , if varmeasure-water-qnty = ? then "0" else string-mth(varmeasure-water-qnty)) no-error .
      837         sw:write-data-element ("tank-lvl" , if tt-rvs-line.level-petrol = ? then "0" else string-mth(tt-rvs-line.level-petrol)) no-error .
      838         sw:write-data-element ("tank-cmn-lvl" , if tt-rvs-line.level-total = ? then "0" else string-mth(tt-rvs-line.level-total)) no-error .
      839         sw:write-data-element ("tnk-wtr-lvl" , if tt-rvs-line.level-water = ? then "0" else string-mth(tt-rvs-line.level-water)) no-error .
      840         if tt-rvs-line.temperature = ?
      841         then
      842           sw:write-empty-element ("tnk-t") .
      843         else
      844           sw:write-data-element ("tnk-t" , string-mth(tt-rvs-line.temperature)) no-error .
      845         if tt-rvs-line.temp-layer1 = ?
      846         then
      847           sw:write-empty-element ("tnk-t1") .
      848         else
      849           sw:write-data-element ("tnk-t1" , string-mth(tt-rvs-line.temp-layer1)) no-error .
      850         if tt-rvs-line.temp-layer2 = ?
      851         then
      852           sw:write-empty-element ("tnk-t2") .
      853         else
      854           sw:write-data-element ("tnk-t2" , string-mth(tt-rvs-line.temp-layer2)) no-error .
      855         if tt-rvs-line.temp-layer3 = ?
      856         then
      857           sw:write-empty-element ("tnk-t3") .
      858         else
      859           sw:write-data-element ("tnk-t3" , string-mth(tt-rvs-line.temp-layer3)) no-error .
      860         sw:write-data-element ("tnk-flng" , if tt-rvs-line.meas-cf-qnty = ? then "0" else string-mth(tt-rvs-line.meas-cf-qnty)) no-error .
      861         if v-dnst-mi > "" then sw:write-data-element ("dnst-mi" , v-dnst-mi) no-error .
      862         if v-line-input-type-p > "" then sw:write-data-element ("inp-type-p" , v-line-input-type-p) no-error .
      863         if v-lvl-mi > "" then sw:write-data-element ("lvl-mi" , v-lvl-mi) no-error .
      864         if v-line-input-type-l > "" then sw:write-data-element ("inp-type-l" , v-line-input-type-l) no-error .
      865         if v-tmp-mi > "" then sw:write-data-element ("tmp-mi" , v-tmp-mi) no-error .
      866         if v-line-input-type-t > "" then sw:write-data-element ("inp-type-t" , v-line-input-type-t) no-error .
      867         if v-dens-sug <> ? and v-dens-sug <> 0 then sw:write-data-element ("tnk-dens-sug" , string-mth(v-dens-sug)) no-error .
      868         if v-pres-sug <> ? and v-pres-sug <> 0 then sw:write-data-element ("tnk-pres-sug" , string-mth(v-pres-sug)) no-error .
      869         sw:write-data-element ("tank-ost-fact" , if tt-rvs-line.state-measure-qnty = ? then "0" else string-mth(tt-rvs-line.state-measure-qnty)) no-error .
      870         sw:write-data-element ("tank-ost-tc-fact" , if tt-rvs-line.state-measure-tc-qnty = ? then "0" else string-mth(tt-rvs-line.state-measure-tc-qnty)) no-error .
      871         sw:write-data-element ("tank-dnst-fact" , if tt-rvs-line.state-density = ? then "0" else string-mth(tt-rvs-line.state-density)) no-error .
      872         sw:write-data-element ("pipeline-qnty-fact" , if tt-rvs-line.state-add-qnty = ? then "0" else string-mth(tt-rvs-line.state-add-qnty)) no-error .
      873         sw:write-data-element ("pipeline-wght-fact" , if tt-rvs-line.state-add-qnty * tt-rvs-line.state-density = ? then "0" else string-mth(tt-rvs-line.state-add-qnty * tt-rvs-line.state-density)) no-error .
      874         sw:write-data-element ("er-wght-pipeline" , if er-wght-pipeline = ? then "0" else string-mth(er-wght-pipeline)) no-error .
      875         sw:write-data-element ("tank-ost-br-fact" , if tt-rvs-line.state-brutto-qnty = ? then "0" else string-mth(tt-rvs-line.state-brutto-qnty)) no-error .
      876         sw:write-data-element ("tank-ost-br-tc-fact" , if tt-rvs-line.state-brutto-tc-qnty = ? then "0" else string-mth(tt-rvs-line.state-brutto-tc-qnty)) no-error .
      877         sw:write-data-element ("tank-wtr-fact" , if varstate-water-qnty = ? then "0" else string-mth(varstate-water-qnty)) no-error .
      878         sw:write-data-element ("tank-wght-fact" , if tt-rvs-line.state-measure-cli-qnty = ? then "0" else string-mth(tt-rvs-line.state-measure-cli-qnty)) no-error .
      879         sw:write-data-element ("tank-wght-br-fact" , if tt-rvs-line.state-brutto-cli-qnty = ? then "0" else string-mth(tt-rvs-line.state-brutto-cli-qnty)) no-error .
      880         sw:write-data-element ("tank-wtr-wght-fact" , if varstate-water-qnty = ? then "0" else string-mth(varstate-water-qnty)) no-error .
      881         sw:write-data-element ("tank-lvl-fact" , if tt-rvs-line.state-level-petrol = ? then "0" else string-mth(tt-rvs-line.state-level-petrol)) no-error .
      882         sw:write-data-element ("tank-cmn-lvl-fact" , if tt-rvs-line.state-level-total = ? then "0" else string-mth(tt-rvs-line.state-level-total)) no-error .
      883         sw:write-data-element ("tnk-wtr-lvl-fact" , if tt-rvs-line.state-level-water = ? then "0" else string-mth(tt-rvs-line.state-level-water)) no-error .
      884         if not v-is-sug
      885         then
      886           sw:write-data-element ("tnk-t-vlm-fact" , if v-temp-izm-vol = ? then "0" else string-mth(v-temp-izm-vol)) no-error .
      887         sw:write-data-element ("tnk-t-average-fact" , if tt-rvs-line.state-temperature = ? then "0" else string-mth(tt-rvs-line.state-temperature)) no-error .
      888         case sr-type-temp :
      889           when 0
      890           then
      891           do it = 1 to num-entries(v-izm-temps) :
      892             sw:write-data-element (substitute("tnk-t&1-fact", string(it)) , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      893           end .
      894           when 1
      895           then
      896           do it = 1 to num-entries(v-izm-temps) :
      897             if it = 1
      898             then
      899               sw:write-data-element ("tnk-t-low-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      900             if it = 2
      901             then
      902               sw:write-data-element ("tnk-t-mid-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      903             if it = 3
      904             then
      905               sw:write-data-element ("tnk-t-upp-fact" , string-mth(decimal(entry(it, v-izm-temps)))) no-error .
      906           end .
      907         end case .
      908         sw:write-data-element ("tnk-flng-fact" , if tt-rvs-line.state-cf-qnty = ? then "0" else string-mth(tt-rvs-line.state-cf-qnty)) no-error .
      909         if v-dens-sug-fact <> ? and v-dens-sug-fact <> 0 then sw:write-data-element ("tnk-dens-sug-fact" , string-mth(v-dens-sug-fact)) no-error .
      910         if v-pres-sug-fact <> ? and v-pres-sug-fact <> 0 then sw:write-data-element ("tnk-pres-sug-fact" , string-mth(v-pres-sug-fact)) no-error .
      911         if not v-is-sug
      912         then
      913           sw:write-data-element ("ms-dnsty-average" , if v-dnsty = ? then "0" else string-mth(v-dnsty)) no-error .
      914         case sr-type-dens :
      915           when 0
      916           then
      917           do id = 1 to num-entries(v-izm-denses) :
      918             sw:write-data-element (substitute("ms-dnsty&1", string(id)) , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      919           end .
      920           when 1
      921           then
      922           do id = 1 to num-entries(v-izm-denses) :
      923             if id = 1
      924             then
      925               sw:write-data-element ("ms-dnsty-low" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      926             if id = 2
      927             then
      928               sw:write-data-element ("ms-dnsty-mid" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      929             if id = 3
      930             then
      931               sw:write-data-element ("ms-dnsty-upp" , string-mth(decimal(entry(id, v-izm-denses)))) no-error .
      932           end .
      933         end case .
      934         sw:write-data-element ("er-wght" , string-mth(v-wght)) no-error .
      935         sw:write-data-element ("abs-er-wght" , if (tt-rvs-line.state-measure-cli-qnty * v-wght / 100) = ? then "0" else string-mth(tt-rvs-line.state-measure-cli-qnty * v-wght / 100)) no-error .
      936         sw:write-data-element ("ex-df" , string-mth(v-ex-df)) no-error .
      937         sw:write-data-element ("pomi-wght" , string-mth(v-POkMI-mass)) no-error .
      938         sw:write-data-element ("pomi-rel-me" , string-mth(v-POkMI-otn-delta-mass)) no-error .
      939         if not v-is-sug
      940         then
      941           sw:write-data-element ("pomi-dnst" , string-mth(v-POkMI-standart-dens)) no-error .
      942         sw:write-data-element ("pomi-vlm-st" , string-mth(v-POkMI-standart-vol)) no-error .
      943         if not v-is-sug
      944         then
      945           sw:write-data-element ("pomi-vlm-tv" , string-mth(v-POkMI-vol)) no-error .
      946         if not v-is-sug
      947         then
      948           sw:write-data-element ("pomi-wtr" , string-mth(v-POkMI-water-vol)) no-error .
      949         sw:end-element ("tank")  .
      950       end.
      951       sw:end-element ("tanks")  .
      952       find first tt-rvs-line-pump no-error .
      953       if available (tt-rvs-line-pump) then do:
      954       sw:start-element ("trk-ps") .
      955       for each tt-rvs-line-pump :
      956         v-pl-code = getTankNum
      957                 (input tt-rvs-line-pump.obj-type
      958                 ,input tt-rvs-line-pump.obj-code
      959                 ,input tt-rvs-line-pump.pump-code
      960                 ,input tt-rvs-line-pump.nozzle-code
      961                 ,input ?
      962                 ,input ?
      963                 ,input tt-rvs-line-pump.gds-code
      964                 ) .
      965         if v-pl-code = ?
      966         or v-pl-code = "0"
      967         then
      968           v-pl-code = string(tt-rvs-line-pump.pl-code)
      969         .
      970         sw:start-element ("trk-p") .
      971         sw:write-data-element ("tank-num" , if v-pl-code = ? then "0" else v-pl-code) no-error .
      972         sw:write-data-element ("trk-num" , if tt-rvs-line-pump.pump-code = ? then "0" else string-mth(tt-rvs-line-pump.pump-code)) no-error .
      973         sw:write-data-element ("trk-p-num" , if tt-rvs-line-pump.nozzle-code = ? then "0" else string-mth(tt-rvs-line-pump.nozzle-code)) no-error .
      974         sw:write-data-element ("cnt-el" , if tt-rvs-line-pump.meas-el-cnt = ? then "0" else string-mth(tt-rvs-line-pump.meas-el-cnt)) no-error .
      975         sw:write-data-element ("sum-cnt-el" , if tt-rvs-line-pump.meas-am-cnt = ? then "0" else string-mth(tt-rvs-line-pump.meas-am-cnt)) no-error .
      976         sw:write-data-element ("qnty" , if tt-rvs-line-pump.meas-cf-cnt = ? then "0" else string-mth(tt-rvs-line-pump.meas-cf-cnt)) no-error .
      977         sw:write-data-element ("cnt-meh" , if tt-rvs-line-pump.meas-mh-cnt = ? then "0" else string-mth(tt-rvs-line-pump.meas-mh-cnt)) no-error .
      978         sw:write-data-element ("cnt-ob" , if tt-rvs-line-pump.meas-mh-qnty = ? then "0" else string-mth(tt-rvs-line-pump.meas-mh-qnty)) no-error .
      979         sw:write-data-element ("sum-cnt-ob" , if tt-rvs-line-pump.meas-am-qnty = ? then "0" else string-mth(tt-rvs-line-pump.meas-am-qnty)) no-error .
      980         sw:write-data-element ("qnty-nal" , if tt-rvs-line-pump.meas-cf-qnty = ? then "0" else string-mth(tt-rvs-line-pump.meas-cf-qnty)) no-error .
      981         sw:write-data-element ("cnt-el-fact" , if tt-rvs-line-pump.state-el-cnt = ? then "0" else string-mth(tt-rvs-line-pump.state-el-cnt)) no-error .
      982         sw:write-data-element ("sum-fact" , if tt-rvs-line-pump.state-am-cnt = ? then "0" else string-mth(tt-rvs-line-pump.state-am-cnt)) no-error .
      983         sw:write-data-element ("qnty-fact" , if tt-rvs-line-pump.state-cf-cnt = ? then "0" else string-mth(tt-rvs-line-pump.state-cf-cnt)) no-error .
      984         sw:write-data-element ("cnt-meh-fact" , if tt-rvs-line-pump.state-mh-cnt = ? then "0" else string-mth(tt-rvs-line-pump.state-mh-cnt)) no-error .
      985         sw:write-data-element ("cnt-meh-ob" , if tt-rvs-line-pump.state-mh-qnty = ? then "0" else string-mth(tt-rvs-line-pump.state-mh-qnty)) no-error .
      986         sw:write-data-element ("sum-meh-ob" , if tt-rvs-line-pump.state-am-qnty = ? then "0" else string-mth(tt-rvs-line-pump.state-am-qnty)) no-error .
      987         sw:write-data-element ("qnty-nal-fact" , if tt-rvs-line-pump.state-cf-qnty = ? then "0" else string-mth(tt-rvs-line-pump.state-cf-qnty)) no-error .
      988         if v-type = "1"
      989         or v-type = "2"
      990         then do :
      991           if tt-rvs-line-pump.state-el-cnt = ?
      992           or tt-rvs-line-pump.state-el-cnt <= 0
      993           then do :
      994             sw:write-data-element ("trk-err" , "1") no-error .
      995           end .
      996           else do :
      997             sw:write-data-element ("trk-err" , "0") no-error .
      998           end .
      999         end .
     1000         sw:end-element ("trk-p")  .
     1001       end.
     1002       sw:end-element ("trk-ps")  .
     1003       end.
     1004       sw:end-element ("check-fuel-doc") .
     1005       finally :
     1006         if valid-object(libFindtank) then delete object libFindtank .
     1007       end finally .
     1008     end.
     1009     method private character getTankNum (p-obj-type    as character,
     1010                                          p-obj-code    as integer,
     1011                                          p-pump        as integer,
     1012                                          p-nozzle-code as integer,
     1013                                          p-src-pl-code as integer,
     1014                                          p-pl-code     as integer,
     1015                                          p-gds-code    as integer) :
     1016       define buffer buf_place for ub.place .
     1017       define variable v-pl-code as integer no-undo .
     1018       define variable v-loc1    as character no-undo .
     1019            if p-src-pl-code > 0 then v-pl-code = p-src-pl-code.
     1020       else if p-pl-code     > 0 then v-pl-code = p-pl-code.
     1021       else do:
     1022         libFindtank:findtank_
     1023         (input p-obj-type
     1024         ,input p-obj-code
     1025         ,input p-pump
     1026         ,input p-nozzle-code
     1027         ,input p-pl-code
     1028         ,input p-gds-code
     1029         ,output v-pl-code
     1030         ) .
     1031       end .
     1032       if v-pl-code > 0 then do:
     1033         find first buf_place no-lock where buf_place.pl-code = v-pl-code no-error .
     1034         v-loc1 = if available buf_place then string(buf_place.pl-code) else "0" .
     1035       end.
     1036       else v-loc1 = "0" .
     1037       return v-loc1 .
     1038     end method .
     1039     method private character string-mth (inValue as decimal):
     1040       def var v-str as character no-undo.
     1041       def var v-stt as decimal   no-undo.
     1042       if inValue = ?  then v-str = "0".
     1043       if inValue < 0 then
     1044       do:
     1045         v-stt = inValue .
     1046         inValue = abs(v-stt).
     1047       end.
     1048       if string (inValue) begins "."
     1049         then v-str = "0" + string (inValue).
     1050       else v-str = string (inValue).
     1051       if v-stt <> 0 then v-str = "-" + v-str.
     1052       return v-str.
     1053     end.
     1054   end class.
