        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.trn-prt inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-line-num as character no-undo
       10       get.
       11       private set.
       12     define property prt-id as character no-undo
       13       get.
       14       private set.
       15     define property in-doc-id as character no-undo
       16       get.
       17       private set.
       18     define property edoc-id as character no-undo
       19       get.
       20       private set.
       21     define property vad-guid as character no-undo
       22       get.
       23       private set.
       24     define property qnty-ttn as decimal no-undo
       25       get.
       26       private set.
       27     define property qnty-fact as decimal no-undo
       28       get.
       29       private set.
       30     define property sum as decimal no-undo
       31       get.
       32       private set.
       33     define property sum-nds as decimal no-undo
       34       get.
       35       private set.
       36     define property nds-code as decimal no-undo
       37       get.
       38       private set.
       39     define property gds-code as integer no-undo
       40       get.
       41       private set.
       42     define property qnty as decimal no-undo
       43       get.
       44       private set.
       45     define override property InitTag as character no-undo init "prt"
       46       get.
       47     method override protected void SetPropProtected (inTag as char, inValue as char):
       48       case inTag:
       49         when "gd-line-num" then do:
       50           assign gd-line-num = inValue.
       51         end.
       52         when "prt-id" then do:
       53           assign prt-id = inValue.
       54         end.
       55         when "in-doc-id" then do:
       56           assign in-doc-id = inValue.
       57         end.
       58         when "edoc-id" then do:
       59           assign edoc-id = inValue.
       60         end.
       61         when "vad-guid" then do:
       62           assign vad-guid = inValue.
       63         end.
       64         when "qnty-ttn" then do:
       65           assign qnty-ttn = decimal (inValue) .
       66         end.
       67         when "qnty-fact" then do:
       68           assign qnty-fact = decimal (inValue).
       69         end.
       70         when "sum" then do:
       71           assign sum = decimal (inValue).
       72         end.
       73         when "sum-nds" then do:
       74           assign sum-nds = decimal (inValue).
       75         end.
       76         when "nds-code" then do:
       77           assign nds-code = decimal (inValue).
       78         end.
       79         when "qnty" then do:
       80           assign qnty = decimal (inValue) .
       81         end.
       82         when "gds-code" then do:
       83           assign gds-code = integer (inValue) .
       84         end.
       85       end case.
       86     end.
       87     method override protected void CheckData ():
       88       def var v-str as char no-undo.
       89       assign
       90         v-str = v-str + ",qnty-ttn" when qnty-fact = ?
       91       .
       92       v-str = trim (v-str, ",").
       93       if v-str > ''
       94       then
       95         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       96     end.
       97     method override protected void ClearSub():
       98       assign
       99         gd-line-num  = ?
      100         prt-id    = ?
      101         in-doc-id = ?
      102         edoc-id   = ?
      103         qnty      = ?
      104         vad-guid  = ?
      105         qnty-ttn  = ?
      106         qnty-fact = ?
      107         sum       = ?
      108         sum-nds   = ?
      109         nds-code  = ?
      110         gds-code  = ?
      111       .
      112     end.
      113   end class.
