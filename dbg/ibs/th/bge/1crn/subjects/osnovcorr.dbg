        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.osnovcorr inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_       as integer    no-undo get.
       10       private set.
       11     define property del-l       as integer      no-undo get.
       12       private set.
       13     define property del-f       as integer      no-undo get.
       14       private set.
       15     define property osn_name    as character    no-undo get.
       16       private set.
       17     define override property InitTag as character no-undo init "osnovcorr"
       18       get.
       19     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       20       case inTag:
       21         when "code" then
       22           do:
       23             assign
       24               code_ = integer(inValue) .
       25           end.
       26         when "del-l" then
       27           do:
       28             assign
       29               del-l = integer (inValue).
       30           end.
       31         when "del-f" then
       32           do:
       33             assign
       34               del-f = integer (inValue).
       35           end.
       36         when "osn_name" then
       37           do:
       38             assign
       39               osn_name = inValue .
       40           end.
       41       end case.
       42     end.
       43     method override protected void CheckData ():
       44       def var v-str as char no-undo.
       45       assign
       46         v-str = "code"
       47         when code_ = ?
       48         v-str = v-str + ",osn_name"
       49         when osn_name = ?
       50         .
       51       v-str = trim (v-str, ",").
       52       if v-str > ''
       53         then
       54         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       55     end.
       56     method override protected void ClearSub():
       57       assign
       58         code_     = ?
       59         del-l     = ?
       60         del-f     = ?
       61         osn_name  = ?
       62         .
       63     end.
       64   end class.
