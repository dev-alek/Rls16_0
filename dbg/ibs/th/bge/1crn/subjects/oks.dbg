        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.oks inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property Code_ok       as character    no-undo get. private set.
        9     define property Code_ei_kkt   as character    no-undo get. private set.
       10     define property Code_pf_kkt   as character    no-undo get. private set.
       11     define property notation      as character    no-undo get. private set.
       12     define property del-l         as integer      no-undo get. private set.
       13     define property del-f         as integer      no-undo get. private set.
       14     define override property InitTag as character no-undo init "OK"
       15       get.
       16     constructor public oks ():
       17     end constructor.
       18             method override protected void SetPropProtected (inTag as char, inValue as char):
       19       case inTag:
       20         when "del-l"        then del-l            = if inValue >= "" then integer (inValue) else 0 .
       21         when "del-f"        then del-f            = if inValue >= "" then integer (inValue) else 0 .
       22         when "Code_ok"     or when "Code-ok"      then Code_ok          = string(if inValue >= "" then integer (inValue) else 0) .
       23         when "Code_ei_kkt" or when "Code-ei-kkt"  then Code_ei_kkt      = if inValue >= "" then inValue else "" .
       24         when "Code_pf_kkt" or when "Code-pf-kkt"  then Code_pf_kkt      = if inValue >= "" then inValue else "" .
       25         when "notation"     then notation         = if inValue >= "" then inValue else "" .
       26       end case.
       27       catch exProErrors as class Progress.Lang.ProError :
       28         case exProErrors:GetMessageNum(1):
       29           when 18207 then undo, throw new Progress.Lang.AppError(
       30             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       31           ) .
       32           otherwise undo, throw new Progress.Lang.AppError(
       33             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       34           ) .
       35         end case .
       36       end catch .
       37     end method.
       38     method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
       39      end method.
       40     method override protected void CheckData ():
       41       def var v-str as char no-undo.
       42       assign
       43         v-str = v-str + ",Code_ok"          when Code_ok         = ?
       44         v-str = v-str + ",Code_ei_kkt"      when Code_ei_kkt     = ?
       45         v-str = v-str + ",Code_pf_kkt"      when Code_pf_kkt     = ?
       46       .
       47       v-str = substring(v-str, 2).
       48       if v-str > "" then undo, throw new Progress.Lang.AppError(
       49         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       50       ) .
       51     end method.
       52     method override protected void ClearSub():
       53       assign
       54         Code_ok            = ?
       55         del-l              = ?
       56         del-f              = ?
       57         Code_ei_kkt        = ?
       58         Code_pf_kkt        = ?
       59         notation           = ?
       60       .
       61     end method.
       62   end class.
