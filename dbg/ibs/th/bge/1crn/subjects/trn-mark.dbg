        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.trn-mark inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property prt-id as character no-undo
       10       get.
       11       private set.
       12     define property in-doc-id as character no-undo
       13       get.
       14       private set.
       15     define property mark-code as character no-undo
       16       get.
       17       private set.
       18     define property gtin as character no-undo
       19       get.
       20       private set.
       21     define property gtin_qnt as integer no-undo
       22       get.
       23       private set.
       24     define property upd_id as character no-undo
       25       get.
       26       private set.
       27     define property gds-code as integer no-undo
       28       get.
       29       private set.
       30     define override property InitTag as character no-undo init "mark"
       31       get.
       32     method override protected void SetPropProtected (inTag as char, inValue as char):
       33       case inTag:
       34         when "prt-id" then do:
       35           assign prt-id = inValue.
       36         end.
       37         when "in-doc-id" then do:
       38           assign in-doc-id = inValue.
       39         end.
       40         when "mark-code" then do:
       41           assign mark-code = inValue.
       42         end.
       43         when "gtin" then do:
       44           assign gtin = inValue.
       45         end.
       46         when "gtin-qnt" then do:
       47           assign gtin_qnt = integer(inValue) no-error .
       48         end.
       49         when "upd-id" then do:
       50           assign upd_id = inValue.
       51         end.
       52         when "gds-code" then do:
       53           assign gds-code = integer(inValue) no-error .
       54         end.
       55       end case.
       56     end.
       57     method override protected void CheckData ():
       58       def var v-str as char no-undo.
       59       v-str = trim (v-str, ",").
       60       if v-str > ''
       61       then
       62         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       63     end.
       64     method override protected void ClearSub():
       65       assign
       66         prt-id   = ?
       67         mark-code = ?
       68         gtin = ?
       69         gtin_qnt = ?
       70         upd_id = ?
       71         in-doc-id = ?
       72         gds-code = ?
       73       .
       74     end.
       75   end class.
