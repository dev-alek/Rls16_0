        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.enum-deg-auto.
        3   using ibs.th.bge.1crn.enum-dnst-ms-type.
        4   using ibs.th.bge.1crn.enum-level-ms-type.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.measuring inherits ibs.th.bge.1crn.subjects.asubject:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define property code_ as character no-undo
       13       get.
       14       private set.
       15     define property del-l as integer no-undo
       16       get.
       17       private set.
       18     define property del-f as integer no-undo
       19       get.
       20       private set.
       21     define property deg-auto as enum-deg-auto no-undo
       22       get.
       23       private set.
       24     define property name_ as character no-undo
       25       get.
       26       private set.
       27     define property dimension-level as integer no-undo
       28       get.
       29       private set.
       30     define property dimension-temp as integer no-undo
       31       get.
       32       private set.
       33     define property dimension-dnst as integer no-undo
       34       get.
       35       private set.
       36     define property dimension-wght as integer no-undo
       37       get.
       38       private set.
       39     define property level-ms-type as enum-level-ms-type no-undo
       40       get.
       41       private set.
       42     define property level-tk as decimal no-undo
       43       get.
       44       private set.
       45     define property level-abs-me as decimal no-undo
       46       get.
       47       private set.
       48     define property level-rel-me-np as decimal no-undo
       49       get.
       50       private set.
       51     define property level-abs-me-wtr as decimal no-undo
       52       get.
       53       private set.
       54     define property level-rel-me-wtr as decimal no-undo
       55       get.
       56       private set.
       57     define property temp-abs-me-vlm as decimal no-undo
       58       get.
       59       private set.
       60     define property temp-abs-me-dnst as decimal no-undo
       61       get.
       62       private set.
       63     define property dnst-ms-type as enum-dnst-ms-type no-undo
       64       get.
       65       private set.
       66     define property dnst-abs-me-np as decimal no-undo
       67       get.
       68       private set.
       69     define property dnst-rel-me-np as decimal no-undo
       70       get.
       71       private set.
       72     define property dnst-abs-me-lpg-l as decimal no-undo
       73       get.
       74       private set.
       75     define property dnst-rel-me-lpg-l as decimal no-undo
       76       get.
       77       private set.
       78     define property dnst-abs-me-lpg-v as decimal no-undo
       79       get.
       80       private set.
       81     define property wght-rel-me as decimal no-undo
       82       get.
       83       private set.
       84     define property limit as decimal no-undo
       85       get.
       86       private set.
       87     define override property InitTag as character no-undo init "measuring"
       88       get.
       89     method override protected void SetPropProtected (inTag as char, inValue as char):
       90      case inTag:
       91         when "code"              then code_           = if inValue >= "" then inValue else "" .
       92         when "del-l"             then del-l           = if inValue >= "" then integer (inValue) else 0.
       93         when "del-f"             then del-f           = if inValue >= "" then integer (inValue) else 0.
       94         when "deg-auto"          then do:
       95            if inValue >= "" then deg-auto = enum-deg-auto:GetEnum(integer(inValue)) .
       96                             else deg-auto = enum-deg-auto:GetEnum(0) .
       97         end.
       98         when "name"              then name_           = if inValue >= "" then inValue else "" .
       99         when "dimension-level"   then dimension-level = if inValue >= "" then integer (inValue) else 0.
      100         when "dimension-temp"    then dimension-temp  = if inValue >= "" then integer (inValue) else 0.
      101         when "dimension-dnst"    then dimension-dnst  = if inValue >= "" then integer (inValue) else 0.
      102         when "dimension-wght"    then dimension-wght  = if inValue >= "" then integer (inValue) else 0.
      103         when "level-ms-type"     then do:
      104            if inValue >= "" then level-ms-type = enum-level-ms-type:GetEnum(integer(inValue)) .
      105                             else level-ms-type = enum-level-ms-type:GetEnum(0) .
      106         end.
      107         when "level-tk"          then level-tk         = if inValue >= "" then decimal (inValue) else 0.
      108         when "level-abs-me"      then level-abs-me  = if inValue >= "" then decimal (inValue) else 0.
      109         when "level-rel-me-np"   then level-rel-me-np  = if inValue >= "" then decimal (inValue) else 0.
      110         when "level-abs-me"      then level-abs-me     = if inValue >= "" then decimal (inValue) else 0.
      111         when "level-abs-me-wtr"  then level-abs-me-wtr = if inValue >= "" then decimal (inValue) else 0.
      112         when "level-rel-me-wtr"  then level-rel-me-wtr = if inValue >= "" then decimal (inValue) else 0.
      113         when "temp-abs-me-vlm"   then temp-abs-me-vlm  = if inValue >= "" then decimal (inValue) else 0.
      114         when "temp-abs-me-dnst"  then temp-abs-me-dnst = if inValue >= "" then decimal (inValue) else 0.
      115         when "dnst-ms-type"      then do:
      116            if inValue >= "" then dnst-ms-type = enum-dnst-ms-type:GetEnum(integer(inValue)) .
      117                             else dnst-ms-type = enum-dnst-ms-type:GetEnum(0) .
      118         end.
      119         when "dnst-abs-me-np"    then dnst-abs-me-np    = if inValue >= "" then decimal (inValue) else 0.
      120         when "dnst-rel-me-np"    then dnst-rel-me-np    = if inValue >= "" then decimal (inValue) else 0.
      121         when "dnst-abs-me-lpg-l" then dnst-abs-me-lpg-l = if inValue >= "" then decimal (inValue) else 0.
      122         when "dnst-rel-me-lpg-l" then dnst-rel-me-lpg-l = if inValue >= "" then decimal (inValue) else 0.
      123         when "dnst-abs-me-lpg-v" then dnst-abs-me-lpg-v = if inValue >= "" then decimal (inValue) else 0.
      124         when "wght-rel-me"       then wght-rel-me       = if inValue >= "" then decimal (inValue) else 0.
      125         when "limit"             then limit             = if inValue >= "" then decimal (inValue) else 0 .
      126       end case.
      127       catch exProErrors as class Progress.Lang.ProError :
      128         case exProErrors:GetMessageNum(1):
      129           when 18207 then undo, throw new Progress.Lang.AppError(
      130             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
      131           ) .
      132           otherwise undo, throw new Progress.Lang.AppError(
      133             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
      134           ) .
      135         end case .
      136       end catch .
      137     end method.
      138     method override protected void CheckData ():
      139       def var v-str as char no-undo.
      140       assign
      141         v-str = ",code"                      when code_             = ?
      142         v-str = v-str + ",deg-auto"          when deg-auto          = ?
      143         v-str = v-str + ",name"              when name_             = ?
      144         v-str = v-str + ",level-ms-type"     when level-ms-type     = ? and dimension-level   = 1
      145         v-str = v-str + ",level-abs-me"      when level-abs-me      = ? and dimension-level = 1
      146                and (deg-auto = enum-deg-auto:GetEnum(0) or deg-auto = enum-deg-auto:GetEnum(2))
      147         v-str = v-str + ",level-abs-me-wtr"  when level-abs-me-wtr  = ? and dimension-level = 1
      148                and (deg-auto = enum-deg-auto:GetEnum(0) or deg-auto = enum-deg-auto:GetEnum(2))
      149         v-str = v-str + ",temp-abs-me-vlm"   when temp-abs-me-vlm   = ? and dimension-temp    = 1
      150         v-str = v-str + ",temp-abs-me-dnst"  when temp-abs-me-dnst  = ? and dimension-temp    = 1
      151         v-str = v-str + ",dnst-ms-type"      when dnst-ms-type      = ? and dimension-dnst    = 1
      152         v-str = v-str + ",wght-rel-me"       when wght-rel-me       = ? and dimension-wght    = 1
      153         v-str = v-str + ",limit"             when limit             = ?
      154       .
      155       v-str = substring(v-str, 2).
      156       if v-str > "" then undo, throw new Progress.Lang.AppError(
      157         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      158       ) .
      159     end method.
      160     method override protected void ClearSub():
      161       assign
      162         code_             = ?
      163         del-l             = ?
      164         del-f             = ?
      165         deg-auto          = ?
      166         name_             = ?
      167         dimension-level   = 0
      168         dimension-temp    = 0
      169         dimension-dnst    = 0
      170         dimension-wght    = 0
      171         level-ms-type     = ?
      172         level-tk          = ?
      173         level-abs-me      = ?
      174         level-rel-me-np   = ?
      175         level-abs-me-wtr  = ?
      176         level-rel-me-wtr  = ?
      177         temp-abs-me-vlm   = ?
      178         temp-abs-me-dnst  = ?
      179         dnst-ms-type      = ?
      180         dnst-abs-me-np    = ?
      181         dnst-rel-me-np    = ?
      182         dnst-abs-me-lpg-l = ?
      183         dnst-rel-me-lpg-l = ?
      184         dnst-abs-me-lpg-v = ?
      185         wght-rel-me       = ?
      186         limit             = ?
      187       .
      188     end method.
      189   end class.
