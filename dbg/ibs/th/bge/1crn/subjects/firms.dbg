        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.firms inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property name_ as character no-undo
       19       get.
       20       private set.
       21     define property city as character no-undo
       22       get.
       23       private set.
       24     define property ind as character no-undo
       25       get.
       26       private set.
       27     define property inn as character no-undo
       28       get.
       29       private set.
       30     define property kpp as character no-undo
       31       get.
       32       private set.
       33     define property agnt as character no-undo
       34       get.
       35       private set.
       36     define property post-adr as character no-undo
       37       get.
       38       private set.
       39     define property e-mail as character no-undo
       40       get.
       41       private set.
       42     define property leg-adr as character no-undo
       43       get.
       44       private set.
       45     define property okpo as character no-undo
       46       get.
       47       private set.
       48     define override property InitTag as character no-undo init "org-unit"
       49       get.
       50     method override protected void SetPropProtected (inTag as char, inValue as char):
       51       case inTag:
       52         when "code"      then code_     = if inValue >= "" then inValue else "" .
       53         when "del-l"     then del-l     = if inValue >= "" then integer (inValue) else 0 .
       54         when "del-f"     then del-f     = if inValue >= "" then integer (inValue) else 0 .
       55         when "name"      then name_     = if inValue >= "" then inValue else "" .
       56         when "city"      then city      = if inValue >= "" then inValue else "" .
       57         when "ind"       then ind       = if inValue >= "" then inValue else "" .
       58         when "inn"       then inn       = if inValue >= "" then inValue else "" .
       59         when "kpp"       then kpp       = if inValue >= "" then inValue else "" .
       60         when "agnt"      then agnt      = if inValue >= "" then inValue else "" .
       61         when "post-adr"  then post-adr  = if inValue >= "" then inValue else "" .
       62         when "e-mail"    then e-mail    = if inValue >= "" then inValue else "" .
       63         when "leg-adr"   then leg-adr   = if inValue >= "" then inValue else "" .
       64         when "okpo"      then okpo      = if inValue >= "" then inValue else "" .
       65       end case.
       66     end method.
       67     method override protected void CheckData ():
       68       def var v-str as char no-undo.
       69       assign
       70         v-str = ",code" when code_ = ?
       71         v-str = v-str + ",name" when name_ = ?
       72       .
       73       v-str = substring(v-str, 2).
       74       if v-str > "" then undo, throw new Progress.Lang.AppError(
       75         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       76       ) .
       77     end method.
       78     method override protected void ClearSub():
       79       assign
       80         code_     = ?
       81         del-l     = ?
       82         del-f     = ?
       83         name_     = ?
       84         city      = ?
       85         ind       = ?
       86         inn       = ?
       87         kpp       = ?
       88         agnt      = ?
       89         post-adr  = ?
       90         e-mail    = ?
       91         leg-adr   = ?
       92         okpo      = ?
       93       .
       94     end method.
       95   end class.
