        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.export.send1cerpsub.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.exp-DTSeasons inherits send1cerpsub:
        5     define override public property InitSecTag as character no-undo init "DT-Seasons"
        6     get.
        7     define override public property vss-archive as character no-undo
        8     get.
        9     define override public property vss-author as character no-undo
       10     get.
       11     define override public property vss-date as character no-undo
       12     get.
       13     define override public property vss-description as character no-undo
       14     get.
       15     define override public property vss-revision as character no-undo
       16     get.
       17     define override public property vss-workfile as character no-undo
       18     get.
       19     define override public property sendTableName as character no-undo init "gds-obj-attr"
       20     get.
       21     constructor public exp-DTSeasons (  ):
       22       super ().
       23     end constructor.
       24     method override public void CheckParam(  ):
       25     end method.
       26     method override public void CrContentToSW( input hSaxWriter as handle ):
       27       define variable gdsCode like ub.gds-obj-attr.gds-code no-undo.
       28       define buffer buf_code         for ub.code .
       29       define buffer buf_goods-attr   for ub.goods-attr .
       30       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
       31       define buffer time_gds-obj-attr for ub.gds-obj-attr .
       32       find first buf_gds-obj-attr no-lock where buf_gds-obj-attr.gds-code = integer(oldbh:buffer-field( "gds-code":U  ):buffer-value) and
       33         buf_gds-obj-attr.attr-code = "dt-seasons" and buf_gds-obj-attr.obj-code = integer(oldbh:buffer-field( "obj-code":U  ):buffer-value) and
       34         buf_gds-obj-attr.obj-type = oldbh:buffer-field( "obj-type":U  ):buffer-value no-error .
       35       if available (buf_gds-obj-attr) then
       36       do:
       37         sendOldRowid = rowid(buf_gds-obj-attr).
       38         find first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_gds-obj-attr.gds-code and
       39           buf_goods-attr.attr-code = "fuel-type" no-error .
       40         find first buf_code no-lock where buf_code.parent = "DTseasons" and buf_code.code = buf_gds-obj-attr.attr-value no-error .
       41         if available (buf_goods-attr) and available (buf_code) then
       42         do:
       43       find first time_gds-obj-attr exclusive-lock where time_gds-obj-attr.attr-code = "change-dt-seasons" and
       44       time_gds-obj-attr.gds-code = buf_gds-obj-attr.gds-code and
       45       time_gds-obj-attr.obj-code = buf_gds-obj-attr.obj-code and
       46       time_gds-obj-attr.obj-type = buf_gds-obj-attr.obj-type no-error .
       47       define variable time-change as character no-undo .
       48       if available (time_gds-obj-attr) then
       49       time-change = time_gds-obj-attr.attr-value.
       50       else time-change = entry(1,iso-date(now),"+") .
       51           hSaxWriter:start-element ("DT-Season") .
       52           hSaxWriter:write-data-element (  "code":U,     string(buf_goods-attr.gds-code)   ).
       53           hSaxWriter:write-data-element (  "seasons":U,       string(buf_code.code)   ).
       54           hSaxWriter:write-data-element (  "time-change":U,       time-change   ).
       55           hSaxWriter:end-element ("DT-Season") .
       56         end.
       57       end.
       58     end method.
       59     destructor public exp-DTSeasons ( ):
       60     end destructor.
       61   end class.
