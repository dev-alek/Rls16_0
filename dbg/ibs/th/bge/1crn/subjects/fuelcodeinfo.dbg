        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.fuelcodeinfo inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9      define property ExtCode  as character    no-undo get.
       10         private set.
       11      define property del-l as integer no-undo
       12         get.
       13         private set.
       14      define property del-f as integer no-undo
       15         get.
       16         private set.
       17      define property ExtId    as integer    no-undo get.
       18         private set.
       19      define property ExtName  as character    no-undo get.
       20         private set.
       21      define property IntCode  as character    no-undo get.
       22         private set.
       23      define override property InitTag as character no-undo init "FuelCodeInfo"
       24         get.
       25      method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       26         case inTag:
       27            when "ExtCode" then
       28               do:
       29                  assign
       30                     ExtCode = inValue .
       31               end.
       32            when "del-l"     then
       33               del-l     = if inValue >= "" then integer (inValue) else 0 .
       34            when "del-f"     then
       35               del-f     = if inValue >= "" then integer (inValue) else 0 .
       36            when "ExtId" then
       37               do:
       38                  assign
       39                     ExtId = integer (inValue) .
       40               end.
       41            when "ExtName" then
       42               do:
       43                  assign
       44                     ExtName = inValue .
       45               end.
       46            when "IntCode" then
       47               do:
       48                  assign
       49                     IntCode = inValue .
       50               end.
       51         end case.
       52      end.
       53      method override protected void CheckData ():
       54         def var v-str as char no-undo.
       55         assign
       56            v-str = "ExtCode"
       57            when ExtCode = ?
       58            v-str = v-str + ",IntCode"
       59            when IntCode = ?
       60            .
       61         v-str = trim (v-str, ",").
       62         if v-str > ''
       63            then
       64            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       65      end.
       66      method override protected void ClearSub():
       67         assign
       68            ExtCode = ?
       69            del-l   = ?
       70            del-f   = ?
       71            ExtId   = ?
       72            ExtName = ?
       73            IntCode = ?
       74            .
       75      end.
       76   end class.
