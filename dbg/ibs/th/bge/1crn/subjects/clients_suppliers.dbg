        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.clients_suppliers from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.clients_suppliers inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property code_       as integer    no-undo get.
       12       private set.
       13     define override property InitTag as character no-undo init "nb-supplier"
       14       get.
       15     method override protected void SetPropProtected (inTag as char, inValue as char):
       16       case inTag:
       17         when "code" then
       18           do:
       19             assign
       20               code_ = integer(inValue) .
       21           end.
       22        end case.
       23     end.
       24     method override protected void CheckData ():
       25       def var v-str as char no-undo.
       26       assign
       27         v-str = v-str + ",code"
       28         when code_ = ?
       29         .
       30       v-str = trim (v-str, ",").
       31       if v-str > ''
       32         then
       33         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       34     end.
       35     method override protected void ClearSub():
       36       assign
       37         code_         = ?
       38         .
       39     end.
       40   end class.
