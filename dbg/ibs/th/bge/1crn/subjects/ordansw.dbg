        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.ordansw inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property order-item as integer no-undo init ?
       11       get.
       12       private set.
       13     define property order-item-ext as character no-undo
       14       get.
       15       private set.
       16     define property sts as integer no-undo
       17       get.
       18       private set.
       19     define property mess as character no-undo
       20       get.
       21       private set.
       22     define override property InitTag as character no-undo init "ordansw"
       23       get.
       24     method override protected void SetPropProtected (inTag as char, inValue as char):
       25       case inTag:
       26         when "order-item" then do:
       27           assign order-item = int(inValue) no-error.
       28         end.
       29         when "order-item-external" then do:
       30           assign order-item-ext = inValue.
       31         end.
       32         when "status" then do:
       33           assign sts = int(inValue) no-error.
       34         end.
       35         when "message" then do:
       36           assign mess = inValue .
       37         end.
       38       end case.
       39     end.
       40     method override protected void CheckData ():
       41       def var v-str as char no-undo.
       42       assign
       43         v-str = "order-item" when order-item = ?
       44         v-str = v-str + ",order-item-external" when order-item-ext = ? and sts = 6
       45         v-str = v-str + ",status" when sts = ?
       46       .
       47       v-str = trim (v-str, ",").
       48       if v-str > ''
       49       then
       50         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределенное значение", v-str)).
       51       if not can-do("0,1,2,3,4,5,6",string(sts))
       52       then
       53         undo, throw new Progress.Lang.AppError( substitute ("“ег answer может принимать значени€ &1", "0,1,2,3,4,5,6")).
       54     end.
       55     method override protected void ClearSub():
       56       assign
       57         order-item     = ?
       58         order-item-ext = ?
       59         sts            = ?
       60         mess           = ?
       61       .
       62     end.
       63   end class.
