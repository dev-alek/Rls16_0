        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.business-units inherits ibs.th.bge.1crn.subjects.asubject:
        4       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5       define override public property vss-author      as character no-undo init "$Author:$":U get.
        6       define override public property vss-date        as character no-undo init "$Date:$":U get.
        7       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property name_ as character no-undo
       19       get.
       20       private set.
       21     define override property InitTag as character no-undo init "business-unit"
       22       get.
       23     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       24       case inTag:
       25         when "code" then do:
       26           assign code_ = inValue .
       27         end.
       28         when "del-l" then do:
       29           assign del-l = integer (inValue).
       30         end.
       31         when "del-f" then do:
       32           assign del-f = integer (inValue).
       33         end.
       34         when "name" then do:
       35           assign name_ = inValue .
       36         end.
       37       end case.
       38     end.
       39     method override protected void CheckData ():
       40       def var v-str as char no-undo.
       41       assign
       42         v-str = "code" when code_ = ?
       43       .
       44       v-str = trim (v-str, ",").
       45       if v-str > ''
       46       then
       47         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       48     end.
       49     method override protected void ClearSub():
       50       assign
       51         code_     = ?
       52         del-l     = ?
       53         del-f     = ?
       54         name_     = ?
       55       .
       56     end.
       57   end class.
