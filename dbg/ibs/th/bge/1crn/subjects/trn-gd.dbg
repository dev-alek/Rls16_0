        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.trn-gd inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property line-num as character no-undo
       11       get.
       12       private set.
       13     define property gd-code as integer no-undo
       14       get.
       15       private set.
       16     define property unit-code as character no-undo
       17       get.
       18       private set.
       19     define property koef as decimal no-undo
       20       get.
       21       private set.
       22     define property qnty-ttn as decimal no-undo
       23       get.
       24       private set.
       25     define property qnty-fact as decimal no-undo
       26       get.
       27       private set.
       28     define property sum as decimal no-undo
       29       get.
       30       private set.
       31     define property sum-nds as decimal no-undo
       32       get.
       33       private set.
       34     define property nds-code as decimal no-undo
       35       get.
       36       private set.
       37     define property prts as subjects no-undo
       38       get.
       39       private set.
       40     define property marks as subjects no-undo
       41       get.
       42       private set.
       43     define override property InitTag as character no-undo init "gd"
       44       get.
       45     constructor public trn-gd ():
       46       InitListTag = "prts,marks".
       47     end constructor.
       48     method override protected void SetPropProtected(input SubsObj as subjects):
       49       case SubsObj:InitTag:
       50         when "marks" then
       51           do:
       52             marks = SubsObj.
       53           end.
       54         when "prts" then
       55           do:
       56             prts = SubsObj.
       57           end.
       58       end case.
       59     end.
       60     method override protected void SetPropProtected (inTag as char, inValue as char):
       61       case inTag:
       62         when "line-num" then do:
       63           assign line-num = inValue.
       64         end.
       65         when "gd-code" then do:
       66           assign gd-code = integer (inValue).
       67         end.
       68         when "unit-code" then do:
       69           assign unit-code = inValue.
       70         end.
       71         when "koef" then do:
       72           assign koef = decimal (inValue) .
       73         end.
       74         when "qnty-ttn" then do:
       75           assign qnty-ttn = decimal (inValue) .
       76         end.
       77         when "qnty-fact" then do:
       78           assign qnty-fact = decimal (inValue).
       79         end.
       80         when "sum" then do:
       81           assign sum = decimal (inValue).
       82         end.
       83         when "sum-nds" then do:
       84           assign sum-nds = decimal (inValue).
       85         end.
       86         when "nds-code" then do:
       87           assign nds-code = decimal (inValue).
       88         end.
       89       end case.
       90     end.
       91     method override protected void CheckData ():
       92       def var v-str as char no-undo.
       93       assign
       94         v-str = v-str + ",gd-code" when gd-code = ?
       95         v-str = v-str + ",unit-code" when unit-code = ?
       96         v-str = v-str + ",qnty-ttn" when qnty-fact = ?
       97       .
       98       v-str = trim (v-str, ",").
       99       if v-str > ''
      100       then
      101         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      102     end.
      103     method override protected void ClearSub():
      104       assign
      105         line-num  = ?
      106         gd-code   = ?
      107         unit-code = ?
      108         koef      = ?
      109         qnty-ttn  = ?
      110         qnty-fact = ?
      111         sum       = ?
      112         sum-nds   = ?
      113         nds-code  = ?
      114       .
      115       delete object prts no-error.
      116       delete object marks no-error.
      117     end.
      118   end class.
