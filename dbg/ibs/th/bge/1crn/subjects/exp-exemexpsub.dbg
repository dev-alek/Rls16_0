        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.export.send1cerpsub.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.exp-exemexpsub inherits send1cerpsub:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Пример класса выгрузки в 1с" get.
       11      define override public property InitSecTag as character no-undo init "test-export"
       12      get.
       13      define override public property sendTableName  as character  no-undo init ""
       14      get.
       15      method override public void CheckParam(  ):
       16         return.
       17      end method.
       18      method override public void CrContentToSW( input hSaxWriter as handle ):
       19         hSAXWriter:start-element("slips") no-error.
       20            hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
       21            hSAXWriter:insert-attribute("obj",   "ep44")       no-error.
       22            hSAXWriter:write-data-element ("test", params:getParamValue("test")).
       23            hSAXWriter:write-data-element ("test7", params:getParamValue("test7")).
       24            hSAXWriter:write-data-element ("test9", substitute ("&1", params:getParamValue("test9"))).
       25         hSAXWriter:end-element("slips") no-error.
       26         return.
       27      end method.
       28   end class.
