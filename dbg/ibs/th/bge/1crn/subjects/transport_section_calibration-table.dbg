        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.transport_section_calibration-table inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property sec-num    as integer    no-undo get.
       10       private set.
       11     define property deviation  as integer     no-undo get.
       12       private set.
       13     define property amount    as decimal      no-undo get.
       14       private set.
       15     define property deltaV    as decimal      no-undo get.
       16       private set.
       17     define override property InitTag as character no-undo init "ct-lvl"
       18       get.
       19     method override protected void SetPropProtected (inTag as char, inValue as char):
       20       case inTag:
       21         when "sec-num" then
       22           do:
       23             assign
       24               sec-num = integer(inValue) .
       25           end.
       26         when "deviation" then
       27           do:
       28             assign
       29               deviation = integer(inValue) .
       30           end.
       31         when "amount" then
       32           do:
       33             assign
       34               amount = decimal (inValue) .
       35           end.
       36         when "deltaV" then
       37           do:
       38             assign
       39               deltaV = decimal (inValue) .
       40           end.
       41       end case.
       42     end.
       43     method override protected void CheckData ():
       44       def var v-str as char no-undo.
       45       assign
       46         v-str = v-str + ",sec-mum"
       47         when sec-num = ?
       48         v-str = v-str + ",deviation"
       49         when deviation = ?
       50         v-str = v-str + ",amount"
       51         when amount = ?
       52         .
       53       v-str = trim (v-str, ",").
       54       if v-str > ''
       55         then
       56         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       57     end.
       58     method override protected void ClearSub():
       59       assign
       60         sec-num   = ?
       61         deviation = ?
       62         amount    = ?
       63         deltaV    = ?
       64       .
       65     end.
       66   end class.
