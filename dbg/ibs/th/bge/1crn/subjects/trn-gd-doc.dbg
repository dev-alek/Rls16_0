     2477     method public void CrContentToSW (insw as handle):
     2478       sw = insw.
     2479       create buf_trn-doc.
     2480       v-bufhnd = buffer buf_trn-doc:handle.
     2481       if valid-handle (BufTableHndlNew)
     2482       then do:
     2483         sendNewRowid  = BufTableHndlNew:rowid.
     2484         v-bufhnd:buffer-copy (BufTableHndlNew) no-error.
     2485         if error-status:error
     2486         then do:
     2487           Msg = "Ошибка выгрузки trn-gd-code, неверный буфер BufTableHndlNew".
     2488           undo, return error Msg.
     2489         end.
     2490         isDel = false.
     2491       end.
     2492       else do:
     2493         if not valid-handle (BufTableHndlOld)
     2494         then do:
     2495           Msg = "Ошибка выгрузки trn-gd-code, неопеределен ни старый ни новый буфер".
     2496           undo, return error Msg.
     2497         end.
     2498         sendOldRowid  = BufTableHndlOld:rowid.
     2499         v-bufhnd:buffer-copy (BufTableHndlOld) no-error.
     2500         if error-status:error
     2501         then do:
     2502           Msg = "Ошибка выгрузки trn-gd-code, неверный буфер BufTableHndlOld".
     2503           undo, return error Msg.
     2504         end.
     2505         isDel = true.
     2506       end.
     2507       DocCode = buf_trn-doc.doc-code.
