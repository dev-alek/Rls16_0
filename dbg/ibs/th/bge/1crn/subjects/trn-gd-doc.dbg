      211   method private void xmlchar-test (input  p-in-string          as character,
      212                                     output p-out-string-enc     as character,
      213                                     output p-out-string-dec    as character):
      214   do
      215   on error undo, return error
      216   :
      217          xmlchar-encode
      218       (
      219             input p-in-string
      220           , output p-out-string-enc
      221       ).
      222          xmlchar-decode
      223       (
      224             input p-out-string-enc
      225           , output p-out-string-dec
      226       ).
      227   end.
      228   end .
      229   method private void xmlchar-encode (input  p-in-string          as character,
      230                                     output p-out-string         as character):
      231       define variable v-position      as integer      no-undo.
      232       define variable v-current-char  as character    no-undo.
      233   do
      234   on error undo, return error
      235   :
      236       assign
      237           p-out-string = "":U
      238       .
      239       case p-in-string
      240       :
      241           when ?
      242           then do:
      243               assign
      244                   p-out-string = "?":U
      245               .
      246           end.
      247           when "?":U
      248           then do:
      249               assign
      250                   p-out-string = "&#63;":U
      251               .
      252           end.
      253           otherwise do:
      254               do v-position = 1 to length( p-in-string )
      255               :
      256                   assign
      257                       v-current-char = substring( p-in-string, v-position, 1 )
      258                   .
      259                   case v-current-char
      260                   :
      261                       when "&":U
      262                       then do:
      263                           assign
      264                               p-out-string = p-out-string + "&amp;":U
      265                           .
      266                       end.
      267                       when ">":U
      268                       then do:
      269                           assign
      270                               p-out-string = p-out-string + "&gt;":U
      271                           .
      272                       end.
      273                       when "<":U
      274                       then do:
      275                           assign
      276                               p-out-string = p-out-string + "&lt;":U
      277                           .
      278                       end.
      279                       when "'":U
      280                       then do:
      281                           assign
      282                               p-out-string = p-out-string + "&apos;":U
      283                           .
      284                       end.
      285                       when '"':U
      286                       then do:
      287                           assign
      288                               p-out-string = p-out-string + "&quot;":U
      289                           .
      290                       end.
      291                       when chr(1)
      292                       then do:
      293                           assign
      294                               p-out-string = p-out-string + "":U
      295                           .
      296                       end.
      297                       when chr(2)
      298                       then do:
      299                           assign
      300                               p-out-string = p-out-string + "":U
      301                           .
      302                       end.
      303                       when chr(3)
      304                       then do:
      305                           assign
      306                               p-out-string = p-out-string + "":U
      307                           .
      308                       end.
      309                       when chr(4)
      310                       then do:
      311                           assign
      312                               p-out-string = p-out-string + "":U
      313                           .
      314                       end.
      315                       when chr(5)
      316                       then do:
      317                           assign
      318                               p-out-string = p-out-string + "":U
      319                           .
      320                       end.
      321                       when chr(6)
      322                       then do:
      323                           assign
      324                               p-out-string = p-out-string + "":U
      325                           .
      326                       end.
      327                       when chr(7)
      328                       then do:
      329                           assign
      330                               p-out-string = p-out-string + "":U
      331                           .
      332                       end.
      333                       when chr(8)
      334                       then do:
      335                           assign
      336                               p-out-string = p-out-string + "":U
      337                           .
      338                       end.
      339                       when chr(9)
      340                       then do:
      341                           assign
      342                               p-out-string = p-out-string + "":U
      343                           .
      344                       end.
      345                       when chr(29)
      346                       then do:
      347                           assign
      348                               p-out-string = p-out-string + "":U
      349                           .
      350                       end.
      351                       when chr(10)
      352                       then do:
      353                           assign
      354                               p-out-string = p-out-string + "&#10;":U
      355                           .
      356                       end.
      357                       when chr(13)
      358                       then do:
      359                           assign
      360                               p-out-string = p-out-string + "&#13;":U
      361                           .
      362                       end.
      363                       otherwise do:
      364                           assign
      365                               p-out-string = p-out-string + v-current-char
      366                           .
      367                       end.
      368                   end case.
      369               end.
      370           end.
      371       end case.
      372   end.
      373   end .
      374   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      375   define variable p-out-string as character no-undo.
      376       define variable v-position      as integer      no-undo.
      377       define variable v-current-char  as character    no-undo.
      378   do
      379   on error undo, return error
      380   :
      381       assign
      382           p-out-string = "":U
      383       .
      384       case p-in-string
      385       :
      386           when ?
      387           then do:
