      412                       when chr(3)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + " ":U
      416                           .
      417                       end.
      418                       when chr(4)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + " ":U
      422                           .
      423                       end.
      424                       when chr(5)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + " ":U
      428                           .
      429                       end.
      430                       when chr(6)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + " ":U
      434                           .
      435                       end.
      436                       when chr(7)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + " ":U
      440                           .
      441                       end.
      442                       when chr(8)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + " ":U
      446                           .
      447                       end.
      448                       when chr(9)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + " ":U
      452                           .
      453                       end.
      454                       when chr(29)
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + " ":U
      458                           .
      459                       end.
      460                       when chr(10)
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + " ":U
      464                           .
      465                       end.
      466                       when chr(13)
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + " ":U
      470                           .
      471                       end.
      472                       otherwise do:
      473                           assign
      474                               p-out-string = p-out-string + v-current-char
      475                           .
      476                       end.
      477                   end case.
      478               end.
      479           end.
      480       end case.
      481   end.
      482   return p-out-string.
      483   end .
      484   method private void xmlchar-decode (input  p-in-string          as character,
      485                                     output p-out-string         as character):
      486       define variable v-position      as integer      no-undo.
      487       define variable v-last-position as integer      no-undo.
      488       define variable v-temp-integer  as integer      no-undo.
      489       define variable v-current-char  as character    no-undo.
      490       define variable v-next-char     as character    no-undo.
      491       define variable v-success       as logical      no-undo.
      492   do
      493   on error undo, return error
      494   :
      495       assign
      496           p-out-string = "":U
      497           v-position   = 0
      498       .
      499       replace-cycle:
      500       do while yes
      501       on error undo, return error
      502       :
      503           assign
      504               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      505           .
      506           if v-last-position <= v-position
      507           then do:
      508               if v-position = 0
      509               then do:
      510                   assign
      511                       p-out-string = p-in-string
      512                   .
      513               end.
      514               else do:
      515                   assign
      516                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      517                   .
      518               end.
      519               leave replace-cycle.
      520           end.
      521           else do:
      522               assign
      523                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      524                   v-position      = v-last-position
      525                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      526               .
      527               if v-current-char = "#":U
      528               then do:
      529                   assign
      530                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      531                   .
      532                   if v-last-position > 0
      533                   then do:
      534                       xmlchar-read-integer
      535                        (
      536                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      537                           , output v-temp-integer
      538                           , output v-success
      539                       ).
      540                       if v-success = yes
      541                       and v-temp-integer >= 1
      542                       and v-temp-integer <= 255
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + chr( v-temp-integer )
      546                               v-position   = v-last-position + 1
      547                           .
      548                       end.
      549                       else do:
      550                           assign
      551                               p-out-string = p-out-string + "&":U
      552                               v-position   = v-position   + 1
      553                           .
      554                       end.
      555                   end.
      556                   else do:
      557                       assign
      558                           p-out-string = p-out-string + "&":U
      559                           v-position   = v-position   + 1
      560                       .
      561                   end.
      562               end.
      563               else do:
      564                   case substring( p-in-string, v-position + 1, 3 )
      565                   :
      566                       when "lt;":U
      567                       then do:
      568                           assign
      569                               p-out-string = p-out-string + "<":U
      570                               v-position   = v-position   + 3
      571                           .
      572                       end.
      573                       when "gt;":U
      574                       then do:
      575                           assign
      576                               p-out-string = p-out-string + ">":U
      577                               v-position   = v-position   + 3
      578                           .
      579                       end.
      580                       otherwise do:
      581                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      582                           then do:
      583                               assign
      584                                   p-out-string = p-out-string + "&":U
      585                                   v-position   = v-position   + 4
      586                               .
      587                           end.
      588                           else do:
      589                               case substring( p-in-string, v-position + 1, 5 )
      590                               :
      591                                   when "quot;":U
      592                                   then do:
      593                                       assign
      594                                           p-out-string = p-out-string + '"':U
      595                                           v-position   = v-position   + 5
      596                                       .
      597                                   end.
      598                                   when "apos;":U
      599                                   then do:
      600                                       assign
      601                                           p-out-string = p-out-string + "'":U
      602                                           v-position   = v-position   + 5
      603                                       .
      604                                   end.
      605                                   otherwise do:
      606                                       assign
      607                                           p-out-string = p-out-string + "&":U
      608                                       .
      609                                   end.
      610                               end case.
      611                           end.
      612                       end.
      613                   end case.
      614               end.
      615           end.
      616       end.
      617   end.
      618   end .
      619   method private void xmlchar-read-integer (input  p-input-string       as character,
      620                                             output p-output-integer     as integer,
      621                                             output p-success            as logical):
      622   do
      623   on error undo, return error
      624   :
      625       assign
      626           p-output-integer = integer( p-input-string )
      627       no-error.
      628       if error-status :error
      629       then do:
      630           assign
      631               p-success           = no
      632               p-output-integer    = 0
      633           .
      634       end.
      635       else do:
      636           assign
      637               p-success           = yes
      638           .
      639       end.
      640   end.
      641   end.
      642   define variable mMRCCode  as logical    no-undo.
      643   define variable mTypeMark as character  no-undo.
      644   method private logical IS-NeedMark
      645   ( input ib-code as integer  ,
      646     input ib-str as character ):
      647      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      648      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      649                                    and buf_prod-bc-attr.b-str  eq ib-str
      650                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      651        no-lock no-error.
      652      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      653   end.
      654   method private character repTegforDm
      655   (iDM as char ):
      656       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      657       define variable vteg as character no-undo.
      658       define variable oDM as character no-undo.
      659       define variable vi as integer no-undo.
      660       oDM = iDm.
      661       do vi = 1 to num-entries(vTeglist):
      662          vTeg = entry(vi,vTeglist).
      663          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      664       end.
      665       return oDM.
      666   end.
      667   method private character repSpecSimbforDm
      668   (iDM as char ):
      669       define variable oDM as character no-undo.
      670       xmlchar-decode(iDM, output oDM).
      671     return repTegforDm (oDM).
      672   end.
      673   method private logical CheckGtin
      674   (iGtin as char):
      675      define variable bar_code as character no-undo.
      676      define variable vGtin as logical no-undo init "yes".
      677      if length(iGtin) eq 14
      678      then do:
      679         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      680         run str/chk-sum.p
      681          (input-output bar_code ) no-error .
      682         if iGtin ne  bar_code
      683         then
      684            vGtin = no.
      685      end.
      686      else
      687         vGtin = no.
      688      return vgtin.
      689   end.
      690   method private character repSpecSimbforXlm
      691   (iDM as char ):
      692       iDM = replace(iDM,chr(29),"").
      693       return iDM.
      694   end.
      695   method private character getGtinByDM
      696   (IDM as char):
      697      define variable VTXT as char no-undo.
      698      define variable vGtin as char no-undo.
      699      vTXt = IdM.
      700      vGtin = IDM.
      701      if    length(vtxt) > 14
      702      then do:
      703         if   vtxt begins "(01)"
      704                or vtxt begins "(02)"
      705         then
      706            vGtin = substring(vtxt,5,14).
      707         else if   (vtxt begins "01"
      708                or vtxt begins "02" )
      709                and (   (    substring(iDm,17,2) eq "21"
      710                         and length(vtxt) >= 21)
      711                     or substring(iDm,17,2) eq "37"
      712                     or substring(iDm,17,4) eq "(37)" )
      713         then do:
      714            vGtin = substring(vtxt,3,14).
      715            if not checkGtin(vGtin)
      716            then
      717               vGtin = substring(vtxt,1,14).
      718         end.
      719         else if     length(vtxt) eq 14 + 7 + 4 + 4
      720             or length(vtxt) eq 14 + 7 + 4
      721             or length(vtxt) eq 14 + 7
      722         then
      723            vGtin = substring(vtxt,1,14).
      724      end.
      725      if not checkGtin(vGtin)
      726      then
      727         vGtin = "".
      728      return vgtin.
      729   end.
      730   method private integer getGdsCodeByGtin
      731   (iGtin as char):
      732      define buffer prod-bc  for ub.prod-bc.
      733      define buffer bar-code for ub.bar-code.
      734      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      735      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      736      return if avail bar-code then bar-code.gds-code else ?.
      737   end.
      738   method private decimal getQntyCodeByGtin
      739   (iGtin as char):
      740      define buffer prod-bc  for ub.prod-bc.
      741      define buffer bar-code for ub.bar-code.
      742      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      743      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      744      return if avail bar-code then bar-code.cli-base-rate else ?.
      745   end.
      746   method private integer getGdsCodeByDM
      747   (iDm as char):
      748      define variable vGtin as char no-undo.
      749      define buffer prod-bc for ub.prod-bc.
      750      vGtin  = getGtinByDM (IDM ).
      751      return getGdsCodeByGtin (vGtin).
      752   end.
      753   method private logical ChekTypeMarkByGds
      754   (iGds-code as integer ):
      755      define buffer goods-attr for ub.goods-attr.
      756      find first goods-attr where goods-attr.gds-code   = iGds-code
      757                              and goods-attr.attr-code  = 'mark-type':U
      758      no-lock no-error.
      759      if available goods-attr
      760      then do:
      761         mTypeMark = goods-attr.attr-value.
      762         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      763           .
      764      end.
      765      else
      766         return no.
      767   end.
      768   method private logical ChekTypeMarkByDm
      769   (iDM as char ):
      770      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      771   end.
      772   method private logical ChekTypeMarkByGtin
      773   (iGtin as char ):
      774      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      775   end.
      776   method private character  GetNextElement
      777     (input iAllTeg        as logical
      778     ,output oteg          as character
      779     ,output otegval       as character
      780     ,input-output pstr    as character
      781      ):
      782        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      783        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      784        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      785        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      786        define variable vTeg as character no-undo.
      787        define variable vLength as integer no-undo.
      788        define variable vi as integer no-undo.
      789        define variable vj as integer no-undo.
      790        define buffer code for ub.code.
      791        find first code where Code.parent eq "MarkType"
      792                          and Code.CodeValue   eq mTypeMark
      793                          no-lock no-error.
      794        if     available code
      795           and Code.misc1 ne ""
      796           and Code.misc1 ne ?
      797        then do:
      798           integer (Code.misc1) no-error.
      799           if not error-status:error
      800           then
      801             entry (4,vlistleng) = Code.misc1.
      802        end.
      803        if iAllTeg
      804        then
      805           assign
      806              vlistElem     = vlistElem    + vlistElemDop
      807              vlistleng     = vlistleng    + vlistlengDop
      808           .
      809        else if mMRCCode
      810        then
      811           assign
      812              vlistElem     = vlistElem    + ",(8005),8005"
      813              vlistleng     = vlistleng    + ",000006,0006"
      814           .
      815       block-elem:
      816       do vi = 1 to num-entries(vlistElem):
      817          vTeg = entry(vi,vlistElem).
      818          if pstr begins vTeg
      819          then do:
      820             if    vTeg eq "21"
      821             then
      822                vLength = index(pstr,chr(29)) - 2 no-error.
      823             if vLength  <= 0
      824             then
      825                vLength = int(entry(vi,vlistleng)).
      826             otegval = substring (pstr,length(vteg) + 1, vLength).
      827             oteg = replace(replace(vteg,")",""),"(","").
      828             vTeg = vteg + otegval.
      829             otegval = replace(otegval,chr(29),"").
      830             oteg = replace(replace(oteg,")",""),"(","").
      831             pstr = substring (pstr,length(vTeg)+ 1).
      832             vTeg = replace(vTeg,chr(29),"").
      833             leave block-elem.
      834          end.
      835          else
      836             vTeg = "".
      837       end.
      838       return vteg.
      839   end.
      840   method private character  GetCodeIdent
      841   (iDm as char):
      842      define variable Velement   as character no-undo init "first".
      843      define variable oCodeIdent as character no-undo.
      844      define variable vteg as character no-undo.
      845      define variable vtegval as character no-undo.
      846      define variable vGtin as character no-undo.
      847      define buffer marking for ub.marking.
      848      for first marking no-lock where
      849                marking.mark eq iDm
      850            and marking.unit-ext = "LEVEL2"
      851      :
      852        return iDm.
      853      end.
      854      vGtin  = getGtinByDM (iDm ).
      855      ChekTypeMarkByDm(idm).
      856      if iDm begins 'tech_':U
      857      then
      858         oCodeIdent = iDm.
      859      else if length(iDm) < 21
      860      then do:
      861         find first marking where marking.mark eq idm
      862         no-lock no-error.
      863         oCodeIdent = if available marking then marking.mark else  ?.
      864      end.
      865      else if     length(iDm) eq 29
      866         and not iDm begins "01"
      867         and not iDm begins "02"
      868      then
      869         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      870      else  if     length(iDm) >= 24
      871               and (  iDm begins "01"
      872                   or iDm begins "02")
      873               and  substring(iDm,17,2) ne "21"
      874      then do:
      875         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      876                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      877         then
      878            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      879         else
      880            oCodeIdent = iDM.
      881      end.
      882      else  if     (   length(iDm) eq 25
      883                    or length(iDm) eq 21)
      884               and (not iDm begins "01"
      885               and  not iDm begins "02")
      886      then
      887         oCodeIdent = substring(iDm,1,21).
      888      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      889      then
      890         oCodeIdent = substring(iDm,1,21).
      891      else do while Velement ne "" and idm ne "":
      892         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      893         oCodeIdent = oCodeIdent + Velement.
      894      end.
      895      return oCodeIdent.
      896   end.
      897   method private character  GetTegCod
      898   (icodeIdent as char, iTeg as char):
      899      define variable Velement   as character no-undo init "first".
      900      define variable oTeg as character no-undo init ?.
      901      define variable vteg as character no-undo.
      902      define variable vtegval as character no-undo.
      903      if     ((length(icodeIdent) eq 21
      904         and not icodeIdent begins "01"
      905         and not icodeIdent begins "02")
      906         or
      907             ( length(icodeIdent) eq 25
      908               and not icodeIdent begins "01"
      909               and not icodeIdent begins "02"))
      910      then do:
      911         if iTeg eq "01" or iTeg eq "02"
      912         then
      913            oTeg = substring(icodeIdent,1,21).
      914         else  if  iTeg eq "21"
      915         then
      916            oTeg = substring(icodeIdent,15,7).
      917      end.
      918      else do:
      919         ChekTypeMarkByDm(icodeIdent).
      920         block-teg:
      921            do while Velement ne "" and icodeIdent ne "":
      922            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      923            if    Velement begins iTeg
      924               or Velement begins "(" + iTeg + ")"
      925            then do:
      926               oTeg = vtegval.
      927               leave block-teg.
      928            end.
      929         end.
      930      end.
      931      return oTeg.
      932   end.
      933   method private logical isOAD
      934   (icodeIdent as character):
      935      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      936   end.
      937   method private logical isMark
      938   (icodeIdent as character):
      939      define buffer buf_marking for ub.marking.
      940      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      941             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      942   end.
      943   method private character  addBracketForCode
      944   (icodeIdent as char):
      945      define variable Velement   as character no-undo init "first".
      946      define variable oTeg as character no-undo.
      947      define variable vteg as character no-undo.
      948      define variable vtegval as character no-undo.
      949      define buffer marking for ub.marking.
      950      find first marking no-lock where
      951                 marking.mark begins icodeIdent no-error.
      952      if    not ChekTypeMarkByDm(icodeIdent)
      953         or length(icodeIdent) le 24
      954         or (avail marking and marking.unit-ext = "LEVEL2")
      955      then
      956         oTeg = icodeIdent.
      957      else do:
      958         if (  icodeIdent begins "01"
      959            or icodeIdent begins "02"
      960            ) and CheckGtin(substring (icodeIdent,3,14))
      961            and substring (icodeIdent,17,2) eq "21"
      962         then do:
      963            mMRCCode = yes.
      964            ChekTypeMarkByDm(icodeIdent).
      965            block-teg:
      966            do while Velement ne "" and icodeIdent ne "":
      967               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      968               if vteg ne ""
      969               then
      970                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      971            end.
      972            mMRCCode = no.
      973         end.
      974         else do:
      975            oTeg = icodeIdent.
      976         end.
      977      end.
      978      return oTeg.
      979   end.
      980   method private integer getlevelByCodId
      981   (iCode as char):
      982      define variable vLength as int no-undo.
      983      define variable vLevel  as int no-undo.
      984      if not ChekTypeMarkByDM (icode) then return ?.
      985      vLength = length(iCode).
      986      if    vLength eq 18
      987         or vLength eq 20
      988      then
      989         Vlevel = 4.
      990      else if vLength eq 21
      991      then
      992         Vlevel = 1.
      993      else if vLength eq 25
      994      then do:
      995         if  iCode begins "01"
      996         then
      997            Vlevel = 3.
      998         else
      999            Vlevel = 1.
     1000      end.
     1001      else if     vLength >= 26
     1002              and vLength <= 46
     1003      then do:
     1004         if    substring(iCode,17,2) eq "11"
     1005            or substring(iCode,17,2) eq "13"
     1006            or (    substring(iCode,17,2) eq "21"
     1007                and vLength >= 33
     1008                and substring(iCode,26,4) ne "8005")
     1009         then
     1010            Vlevel = 4.
     1011         else if    vLength eq 31
     1012                 or vLength eq 38
     1013                 or vLength eq 39
     1014                 or vLength eq 45
     1015         then
     1016            Vlevel = 1.
     1017         else if    vLength eq 35
     1018                 or vLength eq 43
     1019         then
     1020            Vlevel = 3.
     1021         else
     1022            Vlevel = ?.
     1023      end.
     1024      else
     1025         Vlevel = ?.
     1026      return Vlevel.
     1027   end.
     1028   method private character  getLevelMotpBycodid
     1029   (iDm as char):
     1030      define variable vLevel as integer no-undo.
     1031      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1032      vLevel = getlevelByCodId(iDm).
     1033      if    vLevel eq ?
     1034         or vLevel < 1
     1035         or vLevel > 6
     1036      then
     1037         return ?.
     1038      else
     1039         return entry(vlevel,vList).
     1040   end.
     1041   method private character    getLevelUTDByLevelMotp
     1042   (iUnit as char):
     1043      define variable vLevel as integer no-undo.
     1044      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1045      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1046      vLevel = lookup(iUnit,vListMOTP).
     1047      if    vLevel eq ?
     1048         or vLevel < 1
     1049         or vLevel > 4
     1050      then
     1051         return ?.
     1052      else
     1053         return entry(vlevel,vListutd).
     1054   end.
     1055   method private character  getLevelMotpByDM
     1056   (iDm as char):
     1057      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1058   end.
     1059   method private character  getLevelUTDByCodId
     1060   (iDm as char):
     1061      define variable vLevel as integer no-undo.
     1062      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1063      vLevel = getlevelByCodId(iDm).
     1064      if    vLevel eq ?
     1065         or vLevel < 1
     1066         or vLevel > 4
     1067      then
     1068         return ?.
     1069      else
     1070         return entry(vlevel,vList).
     1071   end.
     1072   method private character  getLevelUTDByDM
     1073   (iDm as char):
     1074      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1075   end.
     1076   define variable mNotMarkQnty as logical no-undo.
     1077   method private decimal getQntyUTDByCodId
     1078   (iDM as char):
     1079      define variable vLevel as integer no-undo.
     1080      define variable vList as character no-undo init "1,5,10,500".
     1081      define variable vGtin as character no-undo.
     1082      define variable vqnty as decimal no-undo init ?.
     1083      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1084      if vqnty eq ?
     1085      then do:
     1086         if not mNotMarkQnty
     1087         then do:
     1088            define buffer marking for ub.marking.
     1089            define variable vCodident as character no-undo.
     1090            vCodident = GetCodeIdent(idm).
     1091            find first marking where marking.mark begins vCodident no-lock no-error.
     1092            if     available marking
     1093               and marking.box-qnty ne ?
     1094            then
     1095               return marking.box-qnty.
     1096         end.
     1097         vGtin = getGtinByDm(iDM).
     1098         if ChekTypeMarkByGtin (vGtin)
     1099         then do:
     1100            vLevel = getlevelByCodId(iDM).
     1101            if     vLevel >= 1
     1102               and vLevel <= 4
     1103            then
     1104               vqnty = int(entry(vlevel,vList)).
     1105         end.
     1106         else
     1107            vqnty = getQntyCodeByGtin(vgtin).
     1108      end.
     1109      return vqnty.
     1110   end.
     1111   method private decimal getQntyUTDByDM
     1112   (iDm as char):
     1113      define variable vDM as character no-undo.
     1114      if     length (iDm) ne 25
     1115         and length (iDm) ne 29
     1116         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1117      then
     1118         vDM = substring (iDm,1,length (iDm) - 6 ).
     1119      else
     1120         vDM = substring (iDm,1,length (iDm) - 4 ).
     1121      return getQntyUTDByCodId(vDM).
     1122   end.
     1123   method private decimal    getMRC4
     1124   (iMRC as char):
     1125      define variable oMrc     as decimal no-undo init ?.
     1126      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1127      define variable vi       as integer no-undo.
     1128      define variable vfound   as integer no-undo.
     1129      define variable vposStart   as integer no-undo.
     1130      do:
     1131      OMRc = 0.
     1132      do vi = 1 to 4:
     1133         define variable vsimb as character no-undo.
     1134         vsimb = substring(iMRC,vi,1).
     1135         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1136         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1137         if vfound > 0
     1138         then
     1139            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1140         end.
     1141         OMRc = OMRc / 100.
     1142      end.
     1143      return OMRc.
     1144   end.
     1145   method private decimal    getMRCByDM
     1146   (iDm as char):
     1147      define variable vMRC     as character no-undo.
     1148      define variable oMrc     as decimal no-undo init ?.
     1149      define variable Velement as character no-undo init "empty".
     1150      define variable vteg as character no-undo.
     1151      define variable vtegval as character no-undo.
     1152      if    length(idm) eq 14 + 7 + 4 + 4
     1153         or length(idm) eq 14 + 7 + 4
     1154      then do:
     1155         vMRC = substring(idm,22,4).
     1156         omrc = getMRC4(vMRC).
     1157      end.
     1158      else do:
     1159          ChekTypeMarkByDm(iDm).
     1160          block-mrc:
     1161          do while Velement ne "" and idm ne "":
     1162             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1163             if Velement begins "8005"
     1164             then do:
     1165                vMRC = substring(Velement,5,6).
     1166                leave block-mrc.
     1167             end.
     1168             else if Velement begins "(8005)"
     1169             then do:
     1170                vMRC = substring(Velement,7,6).
     1171                leave block-mrc.
     1172             end.
     1173          end.
     1174          if vMRC ne ""
     1175          then
     1176             OMRc = dec(vmrc) / 100 no-error.
     1177      end.
     1178      return OMRc.
     1179   end.
     1180   method private date    MoveDate
     1181   (idate as date,
     1182    iMonth as int64):
     1183      define variable vMonth   as int64 no-undo.
     1184      define variable vYear    as int64 no-undo.
     1185      define variable vDateNew as date  no-undo.
     1186       define variable vDay     as int64 no-undo.
     1187       vMonth = month(iDate) + iMonth.
     1188       vYear =  year(iDate).
     1189       if vMonth <= 0
     1190       then assign
     1191          vMonth = vMonth + 12
     1192           vYear  = vYear - 1
     1193       .
     1194       else if vMonth > 12
     1195       then assign
     1196          vMonth = vMonth - 12
     1197           vYear  = vYear + 1
     1198       .
     1199       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1200       do while error-status:error eq yes:
     1201          VDay = vDay + 1.
     1202          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1203       end.
     1204       if VDay > 0
     1205       then
     1206          vDateNew + 1.
     1207       return vDateNew.
     1208   end.
     1209   method private logical    checkEMRC
     1210   (input  iDm as char,
     1211    output vOk as logical):
     1212      define variable v-value-emrc as character no-undo.
     1213      define variable v-type-emrc  as character no-undo.
     1214      define variable vDateIso     as character no-undo.
     1215      define variable vMRC         as decimal no-undo.
     1216      define variable vqnty        as decimal no-undo.
     1217      define variable vPrice       as decimal no-undo.
     1218      define variable vparent      as character no-undo.
     1219      define variable vgds-code    as integer no-undo.
     1220      define buffer code for ub.code.
     1221      vMRC = getMRCByDM(iDm).
     1222      if vMRC > 0
     1223      then do:
     1224         vgds-code = getGdsCodeByDM(iDm).
     1225         vqnty     = getQntyUTDByDM(iDm).
     1226               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1227            (
     1228             input   vgds-code
     1229            ,input   'emrc-type':U
     1230            ,output   v-value-emrc
     1231            ,output   v-type-emrc
     1232          ) no-error.
     1233          if     v-value-emrc ne ""
     1234             and v-value-emrc ne ?
     1235          then do:
     1236             vDateIso = iso-date(today).
     1237             vPrice = vMRC / vqnty.
     1238             vparent ="emc" + chr(4) + v-value-emrc.
     1239             find last code where Code.parent      eq vparent
     1240                              and Code.code        le vDateIso
     1241                              and code.status_  eq 0
     1242             no-lock no-error.
     1243             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1244             then
     1245                vOk = true .
     1246             else do:
     1247                 define variable vText      as character no-undo.
     1248                 define variable vDate      as date no-undo.
     1249                 define variable vDateLast  as character no-undo.
     1250                 define variable vDateFirst as character no-undo.
     1251                 define variable vDate3     as date no-undo.
     1252                 vdate = date(code.misc1).
     1253                 vDateLast = code.misc1.
     1254                 vDate3 = MoveDate(today, - 3 ).
     1255                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1256                                      string(vDate3  , "99/99/9999"),
     1257                                      string(vDate   , "99/99/9999")
     1258                                      ).
     1259                 vdateIso = iso-date(vdate3).
     1260                 find last code  where Code.parent      eq vparent
     1261                                   and Code.code        le vDateIso
     1262                                   and code.status_  eq 0 no-lock no-error.
     1263                 if available code
     1264                 then
     1265                    vDateIso = code.code.
     1266                 vDateFirst = vDateIso.
     1267                 vDateLast = iso-date(vdate).
     1268                 define variable vGood as logical no-undo.
     1269                 define variable vDateSale as date no-undo.
     1270                 define buffer bcode for code.
     1271                 for last code where Code.parent   eq vparent
     1272                                 and code.status_  eq 0
     1273                                 and code.code     < vDateLast
     1274                                 and code.code     >= vDateFirst
     1275                 no-lock:
     1276                    find first bcode where bCode.parent   eq vparent
     1277                                       and bcode.status_  eq 0
     1278                                       and bcode.code     > code.code no-lock no-error.
     1279                    if available bcode
     1280                    then do:
     1281                       if vPrice < dec(Code.CodeValue)
     1282                       then
     1283                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1284                                                     chr(10),
     1285                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1286                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1287                                                     ).
     1288                       else do:
     1289                          vGood = yes.
     1290                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1291                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1292                                                     chr(10),
     1293                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1294                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1295                                                     string(         vDateSale            ,"99/99/9999"),
     1296                                                     string(vDateSale - today)
     1297                                                     ).
     1298                       end.
     1299                    end.
     1300                 end.
     1301                 if vgood
     1302                 then do:
     1303                    define variable choice as integer no-undo .
     1304                    run gbl/d-askw.w (input "Уточнение"
     1305                           ,input  vText
     1306                           ,input "|"
     1307                           ,input "Принять|Вернуть"
     1308                           ,input "Принять данный товар|Вернуть товар постащику"
     1309                           ,input 1
     1310                           ,input 2
     1311                           ,output choice) no-error.
     1312                    vok = choice eq 1.
     1313                 end.
     1314                 else
     1315                    vok =false.
     1316             end.
     1317          end.
     1318      end.
     1319   end.
     1320   method private character addGs2Mark
     1321   (iMark as char):
     1322      define variable vDM   as character no-undo.
     1323      define variable vIdx  as integer   no-undo.
     1324      if index(iMark,chr(29),1) > 0
     1325      then return iMark.
     1326      if substring(iMark,26,4) = "8005" then
     1327      do:
     1328        vIdx = index(iMark,"93",26 + 4 + 5).
     1329        if vIdx > 1 then do:
     1330          vDM = substitute("&1&4&2&4&3",
     1331                           substring(iMark,1,25),
     1332                           substring(iMark,26,vIdx - 25 - 1),
     1333                           substring(iMark,vIdx),
     1334                           chr(29)) no-error.
     1335          vIdx = index(vDm,"240",vIdx + 4).
     1336          if vIdx > 0 then
     1337          do:
     1338            vDM = substitute("&1&3&2",
     1339                             substring(vDm,1,vIdx - 1),
     1340                             substring(vDm,vIdx),
     1341                             chr(29)) no-error.
     1342          end.
     1343        end.
     1344        else
     1345          vDM = substitute("&1&3&2",
     1346                           substring(iMark,1,25),
     1347                           substring(iMark,26),
     1348                           chr(29)) no-error.
     1349      end.
     1350      else if substring(iMark,32,2) = "91" then
     1351      do:
     1352        vIdx = index(iMark,"92",32).
     1353        if vIdx > 1 then
     1354          vDM = substitute("&1&4&2&4&3",
     1355                           substring(iMark,1,31),
     1356                           substring(iMark,32,vIdx - 31 - 1),
     1357                           substring(iMark,vIdx),
     1358                           chr(29)) no-error.
     1359        else
     1360          vDM = substitute("&1&3&2",
     1361                           substring(iMark,1,31),
     1362                           substring(iMark,32),
     1363                           chr(29)) no-error.
     1364      end.
     1365      else if substring(iMark,39,2) = "91" then
     1366      do:
     1367        vIdx = index(iMark,"92",38).
     1368        if vIdx > 1 then
     1369          vDM = substitute("&1&4&2&4&3",
     1370                           substring(iMark,1,38),
     1371                           substring(iMark,39,vIdx - 38 - 1),
     1372                           substring(iMark,vIdx),
     1373                           chr(29)) no-error.
     1374        else
     1375          vDM = substitute("&1&3&2",
     1376                           substring(iMark,1,38),
     1377                           substring(iMark,39),
     1378                           chr(29)) no-error.
     1379      end.
     1380      else if substring(iMark,25,2) = "93" then
     1381      do:
     1382        vIdx = index(iMark,"92",25).
     1383        if vIdx > 1 then
     1384          vDM = substitute("&1&4&2&4&3",
     1385                           substring(iMark,1,24),
     1386                           substring(iMark,25,vIdx - 24 - 1),
     1387                           substring(iMark,vIdx),
     1388                           chr(29)) no-error.
     1389        else
     1390          vIdx = index(iMark,"3103",25).
     1391          if vIdx > 0 then
     1392          vDM = substitute("&1&4&2&4&3",
     1393                           substring(iMark,1,24),
     1394                           substring(iMark,25,vIdx - 24 - 1),
     1395                           substring(iMark,vIdx),
     1396                           chr(29)) no-error.
     1397          else
     1398            vDM = substitute("&1&3&2",
     1399                             substring(iMark,1,24),
     1400                             substring(iMark,25),
     1401                             chr(29)) no-error.
     1402      end.
     1403      else if substring(iMark,32,2) = "93" then
     1404      do:
     1405        vDM = substitute("&1&3&2",
     1406              substring(iMark,1,31),
     1407              substring(iMark,32),
     1408              chr(29)) no-error.
     1409      end.
     1410      return if vDM <> "" then vDm else iMark.
     1411   end.
     1412   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1414   method private logical AddUtdErrForTab
     1415   (idb-num         as integer ,
     1416    idoc-id         as integer ,
     1417    iTab            as character,
     1418    iObj            as handle ,
     1419    iCheckType      as character,
     1420    iCodeErr        as character,
     1421    iCheckObj       as character ):
     1422      define buffer utd-err for utd-err.
     1423      define buffer utd for utd.
     1424      find first utd where utd.db-num     eq idb-num
     1425                       and utd.doc-id     eq idoc-id
     1426                       and utd.Direction  eq 'Outbound'
     1427      no-lock no-error.
     1428      if available utd
     1429      then
     1430         return no.
     1431      define variable vRecKey as character no-undo.
     1432            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1433            objKeyRec = new ibs.th.gbl.keyrec().
     1434            objKeyRec:GenKeyRec ( input iTab
     1435                                 ,input iObj
     1436                                 ,output vRecKey).
     1437            delete object objKeyRec.
     1438      find first utd-err where utd-err.db-num     eq idb-num
     1439                           and utd-err.doc-id     eq idoc-id
     1440                           and utd-err.CheckType  eq iCheckType
     1441                           and utd-err.CodeErr    eq iCodeErr
     1442                           and utd-err.CheckObj   eq iCheckObj
     1443      exclusive-lock no-error.
     1444      if not available utd-err
     1445      then do:
     1446         create utd-err.
     1447         assign
     1448            utd-err.db-num         = idb-num
     1449            utd-err.doc-id         = idoc-id
     1450            utd-err.CheckType      = iCheckType
     1451            utd-err.CodeErr        = iCodeErr
     1452            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     1453            utd-err.reckey         = vRecKey
     1454            utd-err.qnty           = 1
     1455         .
     1456      end.
     1457      else
     1458         utd-err.qnty = utd-err.qnty + 1.
     1459      return utd-err.qnty eq 1.
     1460   end.
     1461   method private logical AddUtdErr
     1462   (idb-num         as integer ,
     1463    idoc-id         as integer ,
     1464    iObj            as handle ,
     1465    iCheckType      as character,
     1466    iCodeErr        as character,
     1467    iCheckObj       as character ):
     1468      AddUtdErrForTab
     1469         (idb-num,
     1470          idoc-id,
     1471          iObj:table,
     1472          iObj,
     1473          iCheckType,
     1474          iCodeErr,
     1475          iCheckObj).
     1476   end.
     1477   method private void ClearUtdErrTypeCode
     1478   (idb-num         as integer,
     1479    idoc-id         as integer ,
     1480    iCheckType      as character,
     1481    iCodeErr        as character
     1482    ):
     1483      define buffer utd-err for utd-err.
     1484      if    iCheckType eq "*"
     1485         or iCheckType eq ?
     1486      then do:
     1487         if     iCodeErr ne ?
     1488            and iCodeErr ne "*"
     1489         then
     1490            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     1491            view-as alert-box.
     1492         else
     1493         for each utd-err where utd-err.db-num  eq idb-num
     1494                            and utd-err.doc-id  eq idoc-id
     1495         exclusive-lock:
     1496            delete utd-err.
     1497         end.
     1498      end.
     1499      else do:
     1500         if    iCodeErr eq ?
     1501            or iCodeErr eq "*"
     1502         then do:
     1503            for each utd-err where utd-err.db-num     eq idb-num
     1504                               and utd-err.doc-id     eq idoc-id
     1505                               and utd-err.CheckType  eq iCheckType
     1506            exclusive-lock:
     1507               delete utd-err.
     1508            end.
     1509         end.
     1510         else do:
     1511            for each utd-err where utd-err.db-num     eq idb-num
     1512                               and utd-err.doc-id     eq idoc-id
     1513                               and utd-err.CheckType  eq iCheckType
     1514                               and ub.utd-err.CodeErr eq iCodeErr
     1515            exclusive-lock:
     1516               delete utd-err.
     1517            end.
     1518         end.
     1519      end.
     1520   end.
     1521   method private void ClearUtdErr
     1522   (idb-num         as integer,
     1523    idoc-id         as integer ,
     1524    iCheckType      as character
     1525    ):
     1526      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     1527   end.
     1528   method private character GetMesError
     1529   (itxt as character,
     1530    iobj as character ):
     1531    define variable vi as integer no-undo.
     1532    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     1533       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     1534    end.
     1535    return itxt.
     1536   end.
     1537   method private character GetTextErrorType
     1538   (iCheckType as character,
     1539    iCodeErr   as character,
     1540    iChechObj  as character,
     1541    iType      as character  ):
     1542      define buffer code    for code.
     1543      define variable vError as character no-undo.
     1544      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1545                        and code.code   eq iCodeErr
     1546      no-lock no-error.
     1547      if available code
     1548      then do:
     1549         define variable vType as integer no-undo.
     1550         if code.misc3 eq "error"
     1551         then
     1552            vType = 0.
     1553         else if code.misc3 eq "warning"
     1554         then
     1555            vType = 1.
     1556         else if code.misc3 eq "Hiden"
     1557         then
     1558            vType = 2.
     1559         else
     1560            vtype = int(code.misc3) no-error.
     1561         case itype:
     1562            when "error"
     1563            then do:
     1564               if vtype eq 0
     1565               then
     1566                  vError = GetMesError(Code.CodeValue,iChechObj).
     1567            end.
     1568            when "warning"
     1569            then do:
     1570               if vtype <= 1
     1571               then
     1572                  vError = GetMesError(Code.CodeValue,iChechObj).
     1573            end.
     1574            otherwise do:
     1575               vError = GetMesError(Code.CodeValue,iChechObj).
     1576            end.
     1577         end.
     1578      end.
     1579      else
     1580         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     1581      return vError.
     1582   end.
     1583   method private integer  GetTypeError
     1584   (iCheckType as character,
     1585    iCodeErr   as character):
     1586      define buffer code    for code.
     1587      define variable vType as integer no-undo.
     1588      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1589                        and code.code   eq iCodeErr
     1590      no-lock no-error.
     1591      if     not available code
     1592         and code.misc3 eq "error"
     1593      then
     1594         vType = 0.
     1595      else if code.misc3 eq "warning"
     1596      then
     1597         vType = 1.
     1598      else if code.misc3 eq "Hiden"
     1599      then
     1600         vType = 2.
     1601      else
     1602         vtype = int(code.misc3) no-error.
     1603      return vtype.
     1604   end.
     1605   method private character GetTextError
     1606   (iCheckType as character,
     1607    iCodeErr   as character,
     1608    iChechObj  as character ):
     1609      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     1610   end.
     1611   method private character GetErrForUtdstr
     1612   (idb-num     as integer ,
     1613    idoc-id     as integer ,
     1614    iCheckType  as character
     1615    ):
     1616      define buffer utd-err for utd-err.
     1617      define buffer code    for code.
     1618      define variable vHQry as handle no-undo.
     1619      define variable vError as longchar no-undo.
     1620      define variable vErrorOne as longchar  no-undo.
     1621      define variable oError as character no-undo.
     1622      create query vHQry.
     1623      vHQry:set-buffers(buffer utd-err:handle).
     1624      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1625                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1626                               + if    iCheckType eq "*"
     1627                                    or iCheckType eq ?
     1628                                 then       ""
     1629                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1630      vHQry:query-open().
     1631      vHQry:get-first().
     1632      QRY-BLOCK:
     1633      repeat while not vHQry:query-off-end:
     1634         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1635         if     vErrorOne ne ""
     1636            and vErrorOne ne ?
     1637         then
     1638            vError = vError + ", " + vErrorOne.
     1639         vHQry:get-next().
     1640      end.
     1641      oError = substring(vError,3,4002).
     1642      return oError.
     1643   end.
     1644   method private character GetErrJsonForUtd
     1645   (idb-num         as integer ,
     1646    idoc-id         as integer ,
     1647    iCheckType      as character
     1648    ):
     1649      define buffer utd-err for utd-err.
     1650      define variable vHQry as handle no-undo.
     1651      define variable vError as longchar no-undo.
     1652      define variable oError as character no-undo.
     1653      create query vHQry.
     1654      define variable vi as integer no-undo.
     1655      vHQry:set-buffers(buffer utd-err:handle).
     1656      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1657                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1658                               + if    iCheckType eq "*"
     1659                                    or iCheckType eq ?
     1660                                 then       ""
     1661                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1662      vHQry:query-open().
     1663      vHQry:get-first().
     1664      QRY-BLOCK:
     1665      repeat while not vHQry:query-off-end:
     1666         define variable vErrorOne as character no-undo.
     1667         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1668         if     vErrorOne ne ?
     1669            and vErrorOne ne ""
     1670         then do:
     1671            vi = vi + 1.
     1672            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1673                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     1674                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1675         end.
     1676         vHQry:get-next().
     1677      end.
     1678      for first utd where utd.db-num eq idb-num
     1679                      and utd.doc-id eq idoc-id
     1680                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     1681      no-lock,
     1682         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1683                                  and utd-marking-lines.doc-id eq idoc-id
     1684                                  and utd-marking-lines.doc-level eq 1
     1685      no-lock,
     1686         first marking where marking.mark eq utd-marking-lines.mark
     1687                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1688      no-lock:
     1689         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     1690         if     vErrorOne ne ?
     1691            and vErrorOne ne ""
     1692         then do:
     1693            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     1694                            + '","ОбъектОш":"' + marking.mark
     1695                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1696         end.
     1697      end.
     1698      if vError ne ""
     1699      then
     1700         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     1701      return oError.
     1702   end.
     1703   method private character GetErrJsonForUtdReturn
     1704   (idb-num         as integer ,
     1705    idoc-id         as integer ,
     1706    iCheckType      as character
     1707    ):
     1708      define buffer utd-err for utd-err.
     1709      define variable vHQry as handle no-undo.
     1710      define variable vError as longchar no-undo.
     1711      define variable oError as character no-undo.
     1712      define variable vi as integer no-undo.
     1713      create query vHQry.
     1714      vHQry:set-buffers(buffer utd-err:handle).
     1715      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1716                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1717                               + if    iCheckType eq "*"
     1718                                    or iCheckType eq ?
     1719                                 then       ""
     1720                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1721      vHQry:query-open().
     1722      vHQry:get-first().
     1723      QRY-BLOCK:
     1724      repeat while not vHQry:query-off-end:
     1725         define variable vErrorOne as character no-undo.
     1726         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1727         if     vErrorOne ne ?
     1728            and vErrorOne ne ""
     1729         then do:
     1730            vi = vi + 1.
     1731            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1732                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     1733                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     1734         end.
     1735         vHQry:get-next().
     1736      end.
     1737      if vError ne ""
     1738      then
     1739         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     1740      return oError.
     1741   end.
     1742   method private character GetCodeTextError
     1743   (iCheckType as character,
     1744    iCodeErr   as character,
     1745    iChechObj  as character,
     1746    output oCode as character,
     1747    output ovalue as character ):
     1748      define buffer code    for code.
     1749      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1750                        and code.code   eq iCodeErr
     1751      no-lock no-error.
     1752      if     available code
     1753      then do:
     1754         define variable vi as integer no-undo init ?.
     1755         vi = int(Code.misc3) no-error.
     1756         if    code.misc3 ne "error"
     1757            and vi ne 0
     1758         then
     1759            oCode = ?.
     1760         else if     Code.misc1 ne ?
     1761                 and Code.misc1 ne ""
     1762         then
     1763            assign
     1764               oCode  = GetMesError(Code.misc1,iChechObj)
     1765               ovalue = GetMesError(Code.misc2,iChechObj)
     1766            .
     1767      end.
     1768      return if oCode eq ""
     1769             then ""
     1770             else (oCode + "_" + ovalue).
     1771   end.
     1772   define temp-table TT-err no-undo
     1773     field code_ as character
     1774     field text_ as character
     1775   index code_ code_.
     1776   method private character GetErrTxtForUtd
     1777   (idb-num         as integer ,
     1778    idoc-id         as integer ,
     1779    iCheckType      as character
     1780    ):
     1781      define buffer utd-err for utd-err.
     1782      define variable vHQry as handle no-undo.
     1783      define variable oError as character no-undo.
     1784      create query vHQry.
     1785      define variable vi as integer no-undo.
     1786      for each tt-err :
     1787         delete tt-err.
     1788      end.
     1789      vHQry:set-buffers(buffer utd-err:handle).
     1790      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1791                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1792                               + if    iCheckType eq "*"
     1793                                    or iCheckType eq ?
     1794                                 then       ""
     1795                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1796      vHQry:query-open().
     1797      vHQry:get-first().
     1798      define variable vcode as character no-undo.
     1799      define variable vvalue as character no-undo.
     1800      QRY-BLOCK:
     1801      repeat while not vHQry:query-off-end:
     1802         vi = vi + 1.
     1803         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     1804         if vcode ne ?
     1805         then do:
     1806            find first tt-err where tt-err.code eq vcode
     1807            no-error.
     1808            if not available tt-err
     1809            then do:
     1810               create tt-err.
     1811               assign
     1812                  tt-err.code_ = vcode
     1813                  tt-err.text_ = vvalue
     1814               .
     1815            end.
     1816            else
     1817               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1818         end.
     1819         vHQry:get-next().
     1820      end.
     1821     find first utd where utd.db-num eq idb-num
     1822                         and utd.doc-id eq idoc-id
     1823         no-lock.
     1824      define buffer cancel_utd-lines for utd-lines.
     1825      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     1826                                  and cancel_utd-lines.doc-id eq idoc-id
     1827      no-lock:
     1828         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     1829         then do:
     1830            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1831                                        and utd-marking-lines.doc-id eq idoc-id
     1832                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     1833            no-lock,
     1834               first marking where marking.mark eq utd-marking-lines.mark
     1835                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1836            no-lock:
     1837               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     1838               find first tt-err where tt-err.code eq vcode
     1839               no-error.
     1840               if not available tt-err
     1841               then do:
     1842                  create tt-err.
     1843                  assign
     1844                     tt-err.code_ = vcode
     1845                     tt-err.text_ = vvalue
     1846                  .
     1847               end.
     1848               else
     1849                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1850            end.
     1851         end.
     1852         else do:
     1853            define variable vqnty as decimal no-undo.
     1854            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     1855            if vqnty eq ? then vqnty = 0.
     1856            if vqnty ne cancel_utd-lines.Quantity
     1857            then do:
     1858               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     1859               find first tt-err where tt-err.code eq vcode
     1860               no-error.
     1861               if not available tt-err
     1862               then do:
     1863                  create tt-err.
     1864                  assign
     1865                     tt-err.code_ = vcode
     1866                     tt-err.text_ = vvalue
     1867                  .
     1868               end.
     1869               else
     1870                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1871            end.
     1872         end.
     1873      end.
     1874      for each tt-err:
     1875         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     1876      end.
     1877      return oError.
     1878   end.
     1879   define variable mFormatErr as character no-undo init "text".
     1880   method private character GetErrForUtd
     1881   (idb-num         as integer ,
     1882    idoc-id         as integer ,
     1883    iType           as character
     1884    ):
     1885      if mFormatErr eq "text"
     1886      then
     1887         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     1888      else do:
     1889         if itype eq "return"
     1890         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     1891         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     1892      end.
     1893   end.
     1894   method private longchar GetErrComText
     1895   (icomment as character,
     1896    itext    as longchar ):
     1897       define variable vText as longchar no-undo.
     1898      if mFormatErr eq "text"
     1899      then do:
     1900         if icomment ne ""
     1901         then
     1902            icomment = substitute("comment:|&1|",icomment).
     1903         vText = icomment + itext.
     1904      end.
     1905      else do:
     1906         icomment = if icomment begins  '"'
     1907                    then icomment
     1908                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     1909         vText = icomment + "," + itext.
     1910         vText = "~{" + trim(vText,",") + "~}".
     1911      end.
     1912      return vText.
     1913   end.
     1914   method private logical  CheckTypeForMarkLineType
     1915   (iObj            as handle,
     1916    iCheckType      as character,
     1917    iCodeErr        as character ,
     1918    iTypeErr        as character ):
     1919      define variable vRecKey-markLine as character no-undo.
     1920      define variable vGoodMark        as logical no-undo.
     1921      define variable vdb-num          as integer no-undo.
     1922      define variable vdoc-id          as integer no-undo.
     1923      define variable vlinenum         as integer no-undo.
     1924      define variable vErrorOne as character no-undo.
     1925      define buffer buf_utd-err for utd-err.
     1926       define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1927       objKeyRec = new ibs.th.gbl.keyrec().
     1928       objKeyRec:GenKeyRec ( input "utd-marking-lines"
     1929                            ,input iObj
     1930                            ,output  vRecKey-markLine).
     1931       delete object objKeyRec.
     1932      vGoodMark = yes.
     1933      vdb-num = iObj::db-num.
     1934      vdoc-id = iObj::doc-id.
     1935      vlinenum = iObj::linenum.
     1936      block-mark-err:
     1937      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1938                               and buf_utd-err.db-num = vdb-num
     1939                               and buf_utd-err.reckey = vRecKey-markLine
     1940                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1941                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1942      no-lock:
     1943         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1944         if     vErrorOne ne ?
     1945            and vErrorOne ne ""
     1946         then do:
     1947            vGoodMark = no.
     1948            leave block-mark-err.
     1949         end.
     1950      end.
     1951      return not vGoodMark.
     1952   end.
     1953   method private logical  CheckErrForMarkLineType
     1954   (iObj            as handle,
     1955    iType           as character  ):
     1956      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     1957   end.
     1958   method private logical  CheckErrForMarkLine
     1959   (iObj            as handle):
     1960      return CheckErrForMarkLineType(iObj,"*").
     1961   end.
     1962   method private logical  CheckErrForLineTypeCode
     1963   (iObj                 as handle,
     1964    iCheckType           as character,
     1965    iCodeErr             as character,
     1966    iTypeErr             as character,
     1967    iOneErr              as logical):
     1968      define variable vRecKey-line     as character no-undo.
     1969      define buffer buf_utd-err for utd-err.
     1970      define variable vUtdlineError as logical no-undo.
     1971      define variable vErrorOne as character no-undo.
     1972            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1973            objKeyRec = new ibs.th.gbl.keyrec().
     1974            objKeyRec:GenKeyRec ( input "utd-lines"
     1975                                 ,input iObj
     1976                                 ,output vRecKey-line).
     1977            delete object objKeyRec.
     1978         define variable vdb-num as integer no-undo.
     1979         define variable vdoc-id as integer no-undo.
     1980         define variable vlinenum as integer no-undo.
     1981         vdb-num = iObj::db-num.
     1982         vdoc-id = iObj::doc-id.
     1983         vlinenum = iObj::linenum.
     1984         block-err:
     1985         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1986                                  and buf_utd-err.db-num = vdb-num
     1987                                  and buf_utd-err.reckey = vRecKey-line
     1988                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1989                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1990         no-lock:
     1991            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1992            if     vErrorOne ne ?
     1993               and vErrorOne ne ""
     1994            then do:
     1995               vUtdlineError = yes.
     1996               leave block-err.
     1997            end.
     1998         end.
     1999         if  not vUtdlineError
     2000         then do:
     2001            define variable vGoodMark as logical no-undo.
     2002            vGoodMark = yes.
     2003            block-line-err:
     2004            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2005                                         and utd-marking-lines.doc-id  eq vdoc-id
     2006                                         and utd-marking-lines.LineNum eq vLineNum
     2007            no-lock:
     2008               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2009               if     vGoodMark
     2010                  and iOneErr eq no
     2011               then
     2012                  leave block-line-err.
     2013               if     iOneErr = yes
     2014                  and not vGoodMark
     2015               then
     2016                  leave block-line-err.
     2017            end.
     2018            vUtdlineError = not vGoodMark.
     2019         end.
     2020      return vUtdlineError.
     2021   end.
     2022   method private character   getErrForLineType
     2023   (iObj            as handle,
     2024    iType           as character  ):
     2025      define variable vRecKey-line     as character no-undo.
     2026      define buffer buf_utd-err for utd-err.
     2027      define variable vUtdlineError as logical no-undo.
     2028      define variable vErrorOne as character no-undo.
     2029      define variable oError as character no-undo.
     2030            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2031            objKeyRec = new ibs.th.gbl.keyrec().
     2032            objKeyRec:GenKeyRec ( input "utd-lines"
     2033                                 ,input iObj
     2034                                 ,output vRecKey-line).
     2035            delete object objKeyRec.
     2036         define variable vdb-num as integer no-undo.
     2037         define variable vdoc-id as integer no-undo.
     2038         define variable vlinenum as integer no-undo.
     2039         vdb-num = iObj::db-num.
     2040         vdoc-id = iObj::doc-id.
     2041         vlinenum = iObj::linenum.
     2042         block-err:
     2043         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2044                                  and buf_utd-err.db-num = vdb-num
     2045                                  and buf_utd-err.reckey = vRecKey-line
     2046                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2047         no-lock:
     2048            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2049            if     vErrorOne ne ?
     2050               and vErrorOne ne ""
     2051            then do:
     2052               oError = oError + vErrorOne + " ".
     2053            end.
     2054         end.
     2055      return oError.
     2056   end.
     2057   method private logical  CheckErrForLineType
     2058   (iObj            as handle,
     2059    iType           as character  ):
     2060       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2061   end.
     2062   method private logical  CheckErrForLine
     2063   (iObj            as handle):
     2064      return CheckErrForLineType(iobj,"*").
     2065   end.
     2066   method private logical  CheckErrForUtd
     2067   (idb-num         as integer ,
     2068    idoc-id         as integer ):
     2069      for each utd-lines where utd-lines.db-num eq idb-num
     2070                           and utd-lines.doc-id eq idoc-id
     2071      no-lock :
     2072         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2073         then
     2074            return no.
     2075      end.
     2076      return yes.
     2077   end.
     2078   method public logical CheckMarkUtd-28rel
     2079    (input idb-num as integer,
     2080    input idoc-id as integer):
     2081    define buffer utd                   for utd.
     2082    define buffer utd-lines             for utd-lines.
     2083    define buffer utd-marking-lines     for utd-marking-lines.
     2084    define variable v-par-type as character no-undo.
     2085    define variable vgdsNoMark as logical no-undo.
     2086    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2087      define variable v-par-val  as character no-undo.
     2088      find first utd where utd.db-num eq idb-num
     2089                       and utd.doc-id eq idoc-id
     2090      no-lock no-error.
     2091      if available utd
     2092      then do:
     2093         if     utd.obj-code ne ?
     2094            and utd.obj-type ne ?
     2095         then do:
     2096            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2097            Block-utd-lines:
     2098            for each utd-lines where utd-lines.db-num eq idb-num
     2099                                 and utd-lines.doc-id eq idoc-id
     2100            no-lock:
     2101               if     utd-lines.gds-code ne ?
     2102                  and utd-lines.gds-code ne 0
     2103               then do:
     2104                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2105                       ( utd-lines.gds-code,
     2106                         'mark-type':U,
     2107                          output v-par-val,
     2108                          output v-par-type
     2109                       ).
     2110                  if     EDOParSec:IsEdo
     2111                     and EDOParSec:GetIsEDOForType(v-par-val)
     2112                  then do:
     2113                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2114                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2115                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2116                                                    and length(utd-marking-lines.mark) > 13
     2117                     no-lock no-error.
     2118                     if     avail utd-marking-lines
     2119                        and not CheckErrForLine(buffer utd-lines:handle)
     2120                     then
     2121                        leave Block-utd-lines.
     2122                  end.
     2123                  else
     2124                     vgdsNoMark = yes.
     2125               end.
     2126            end.
     2127            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2128            if vgdsNoMark then return available utd-lines . else return yes .
     2129         end.
     2130      end.
     2131      return yes.
     2132   end.
     2133   method public logical CheckMarkUtd
     2134    (input idb-num  as integer,
     2135     input idoc-id  as integer):
     2136     define buffer utd-lines             for ub.utd-lines.
     2137     block-line:
     2138     for each utd-lines where utd-lines.db-num eq idb-num
     2139                          and utd-lines.doc-id eq idoc-id
     2140     no-lock:
     2141        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2142        then
     2143           leave block-line.
     2144     end.
     2145     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2146     return available utd-lines.
     2147   end.
     2148   method public logical CheckNotMarkUtd
     2149    (input idb-num  as integer,
     2150     input idoc-id  as integer):
     2151     define buffer utd-lines             for ub.utd-lines.
     2152     for each utd-lines where utd-lines.db-num eq idb-num
     2153                          and utd-lines.doc-id eq idoc-id
     2154     no-lock:
     2155        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2156        then
     2157           return yes.
     2158     end.
     2159     return no.
     2160   end.
     2161   method public logical CheckMarkUtdLine
     2162    (input idb-num  as integer,
     2163     input idoc-id  as integer,
     2164     input iLineNum as integer):
     2165    define buffer utd                   for utd.
     2166    define buffer utd-lines             for utd-lines.
     2167    define buffer utd-marking-lines     for utd-marking-lines.
     2168    define variable v-par-type as character no-undo.
     2169    define variable vMarking        as logical no-undo.
     2170    define variable vArtic          as logical no-undo.
     2171    define variable vTransitional   as logical no-undo.
     2172    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2173      define variable v-par-val  as character no-undo.
     2174      find first utd where utd.db-num eq idb-num
     2175                       and utd.doc-id eq idoc-id
     2176      no-lock no-error.
     2177      if available utd
     2178      then do:
     2179         if     utd.obj-code ne ?
     2180            and utd.obj-type ne ?
     2181         then do:
     2182            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2183            Block-utd-lines:
     2184            for each utd-lines where utd-lines.db-num   eq idb-num
     2185                                 and utd-lines.doc-id   eq idoc-id
     2186                                 and utd-lines.LineNum  eq iLineNum
     2187            no-lock:
     2188               if     utd-lines.gds-code ne ?
     2189                  and utd-lines.gds-code ne 0
     2190               then do:
     2191                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2192                       ( utd-lines.gds-code,
     2193                         'mark-type':U,
     2194                          output v-par-val,
     2195                          output v-par-type
     2196                       ).
     2197                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2198                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2199                  if vMarking
     2200                  then do:
     2201                     block-marking:
     2202                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2203                                                    and utd-marking-lines.doc-id   eq idoc-id
     2204                                                    and utd-marking-lines.LineNum  eq iLineNum
     2205                                                    and length(utd-marking-lines.mark) > 13
     2206                     no-lock:
     2207                        if isOAD(utd-marking-lines.mark)
     2208                        then do:
     2209                           assign
     2210                              vArtic   = yes
     2211                              vMarking = no
     2212                           .
     2213                           leave block-marking.
     2214                        end.
     2215                     end.
     2216                  end.
     2217                  if vArtic
     2218                  then do:
     2219                     block-artic:
     2220                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2221                                                    and utd-marking-lines.doc-id   eq idoc-id
     2222                                                    and utd-marking-lines.LineNum  eq iLineNum
     2223                                                    and length(utd-marking-lines.mark) > 13
     2224                     no-lock:
     2225                        if isMark(utd-marking-lines.mark)
     2226                        then do:
     2227                           assign
     2228                              vArtic   = no
     2229                              vMarking = yes
     2230                           .
     2231                           leave block-artic.
     2232                        end.
     2233                     end.
     2234                  end.
     2235                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2236                  if vTransitional
     2237                  then do:
     2238                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2239                                                    and utd-marking-lines.doc-id   eq idoc-id
     2240                                                    and utd-marking-lines.LineNum  eq iLineNum
     2241                                                    and length(utd-marking-lines.mark) > 13
     2242                     no-lock no-error.
     2243                     if not available utd-marking-lines
     2244                     then assign
     2245                        vMarking = no
     2246                        vArtic   = no
     2247                     .
     2248                  end.
     2249               end.
     2250               else
     2251                  assign
     2252                     vMarking      = yes
     2253                     vArtic        = no
     2254                     vTransitional = no
     2255                  .
     2256               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2257               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2258               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2259            end.
     2260         end.
     2261      end.
     2262      return vMarking or vArtic.
     2263   end.
     2264   method public logical getMarkUtdLine
     2265    (input  idb-num  as integer,
     2266     input  idoc-id  as integer,
     2267     input  iLineNum as integer,
     2268     output oMarking        as logical,
     2269     output oArtic          as logical,
     2270     output oTransitional   as logical):
     2271     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2272     oArtic        = not oMarking
     2273            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2274     oTransitional = (oMarking or oArtic)
     2275            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2276   end.
     2277   method public logical CheckMarking
     2278    (input idb-num as integer,
     2279    input idoc-id as integer,
     2280    input iTypeErr as character ):
     2281     define variable vMarkutd as logical no-undo.
     2282     define variable vCrErr   as logical no-undo.
     2283     define buffer utd-lines         for utd-lines.
     2284     define buffer utd-marking-lines for utd-marking-lines.
     2285     define buffer marking           for marking.
     2286     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2287      block-line:
     2288      for each utd-lines where utd-lines.db-num eq idb-num
     2289                           and utd-lines.doc-id eq idoc-id
     2290      no-lock:
     2291         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2292         then do:
     2293            for each utd-marking-lines
     2294                     where utd-marking-lines.db-num  = utd-lines.db-num
     2295                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2296                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2297            no-lock:
     2298               if isMark(utd-marking-lines.mark)
     2299               then do:
     2300                  find first marking where marking.mark eq utd-marking-lines.mark
     2301                  no-lock no-error.
     2302                  if not available marking
     2303                  then do:
     2304                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2305                     vCrErr = yes.
     2306                     next block-line.
     2307                  end.
     2308               end.
     2309            end.
     2310         end.
     2311      end.
     2312      return vCrErr.
     2313   end.
     2314   method public logical CheckMarkForType
     2315    (input idb-num   as integer,
     2316     input idoc-id   as integer):
     2317      define variable vMarking        as logical no-undo.
     2318      define variable vArtic          as logical no-undo.
     2319      define variable vTransitional   as logical no-undo.
     2320      define buffer utd-lines         for utd-lines.
     2321      define buffer utd-marking-lines for utd-marking-lines.
     2322      block-line:
     2323      for each utd-lines where utd-lines.db-num eq idb-num
     2324                           and utd-lines.doc-id eq idoc-id
     2325      no-lock:
     2326         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2327                          output vMarking         , output vArtic          , output vTransitional).
     2328         for each utd-marking-lines
     2329                     where utd-marking-lines.db-num  = utd-lines.db-num
     2330                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2331                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2332         no-lock:
     2333            if length(utd-marking-lines.mark) < 14
     2334            then do:
     2335               if (vMarking or vArtic) and not vTransitional
     2336               then
     2337                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2338            end.
     2339            else if not isMark(utd-marking-lines.mark)
     2340            then do:
     2341               if vMarking
     2342               then
     2343                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2344            end.
     2345            else do:
     2346            end.
     2347         end.
     2348      end.
     2349   end.
