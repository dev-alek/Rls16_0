     3443     method private void writeprts (p-line-num as integer):
     3444       def var vsds as class vsdsubs no-undo.
     3445       def var vsdstr as class vsdtostorage no-undo.
     3446       def var vsdsts as class vsdstatustype no-undo.
     3447       def var ii as integer no-undo.
     3448       define variable v-mercury-value as character no-undo .
     3449       define variable v-mercury-type  as character no-undo .
     3450       define variable v-mercury-prod as logical init false.
     3451       vsdstr = new vsdtostorage ().
     3452       vsdsts = new vsdstatustype ().
     3453       block-doc-line:
     3454       for first buf_doc-line no-lock where buf_doc-line.doc-code = DocCode
     3455                                        and buf_doc-line.line-num = p-line-num:
     3456         find first buf_gds no-lock where
     3457               buf_gds.artic = buf_doc-line.artic
     3458           and buf_gds.prod-code = buf_doc-line.prod-code
     3459           and buf_gds.prod-type = buf_doc-line.prod-type.
     3460   run gdscdat in ibs.th.gbl.gbl-hndllib:g#library
     3461     (input  buf_gds.gds-code
     3462     ,input  'mercur_FGIS=request':u
     3463     ,output v-mercury-prod
     3464     ) no-error .
     3465         sw:start-element ("prts").
     3466         for each buf_parts where buf_parts.out-code = buf_doc-line.doc-code
     3467             and buf_parts.artic = buf_doc-line.artic
     3468             and buf_parts.prod-type = buf_doc-line.prod-type
     3469             and buf_parts.prod-code = buf_doc-line.prod-code
     3470         no-lock:
     3471           sw:start-element ("prt").
     3472             if v-is-edo-return
     3473             then do :
     3474               if buf_parts.ps > ""
     3475               and length(buf_parts.ps) = 36
     3476               then do :
     3477                 write-data-element ("edoc-id", buf_parts.ps).
     3478               end .
     3479               else do :
     3480                 for first buf_utd no-lock where buf_utd.doc-code = buf_parts.in-code :
     3481                   write-data-element ("edoc-id", buf_utd.DocumentExt).
     3482                 end.
     3483               end .
     3484             end .
     3485             write-data-element ("in-doc-id", buf_parts.in-code).
     3486             if buf_parts.part-code > ""
     3487             then
     3488             write-data-element ("prt-id", buf_parts.part-code).
     3489             if v-mercury-prod
     3490             then do :
     3491               vsds = vsdstr:getVSDsubs(buffer buf_parts).
     3492               if vsds:iCounter > 0
     3493               then do:
     3494                 block-vsd:
     3495                 do ii = 1 to vsds:GetItem(ii):
     3496                   if     vsds:VsdObjCurr:UUID ne ""
     3497                      and vsds:VsdObjCurr:UUID ne ?
     3498                      and (   vsds:VsdObjCurr:VSDType = vsdsts:VSDTrans
     3499                           or vsds:VsdObjCurr:VSDType = vsdsts:VSDIn)
     3500                   then do:
     3501                     write-data-element ("vad-guid", vsds:VsdObjCurr:UUID).
     3502                     leave block-vsd.
     3503                   end.
     3504                 end.
     3505               end.
     3506               delete object vsds no-error.
     3507             end .
     3508             write-data-element ("qnty-ttn", string-mth (buf_parts.qnty)).
     3509             write-data-element ("qnty-fact", string-mth (buf_parts.fact-qnty)).
     3510             write-data-element ("sum", string-mth (round (buf_parts.price-rubl * buf_parts.fact-qnty, 2))).
     3511             write-data-element ("nds-code", if buf_parts.VAT-type = 'без':U then "-1" else string-mth ( round (buf_parts.VAT-pc , 0))).
     3512             write-data-element ("sum-nds", string-mth ( round ((buf_parts.price-rubl * buf_parts.fact-qnty * buf_parts.VAT-pc) / (100 + buf_parts.VAT-pc) , 2))).
     3513             write-data-element ("sum-s", string-mth (round (buf_parts.price-rubl * buf_parts.fact-qnty / (1 + (buf_parts.VAT-pc / 100)), 2))).
     3514           sw:end-element ("prt").
     3515         end.
     3516         sw:end-element ("prts").
     3517       end.
     3518       delete object vsdsts no-error.
     3519       delete object vsdstr no-error.
     3520     end.
     3521   end class.
