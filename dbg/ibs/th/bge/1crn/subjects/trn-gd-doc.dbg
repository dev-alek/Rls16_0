     3394           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'car-time':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3395           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 't_pass-fname':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3396           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 't_pass-position':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3397           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 't_accept-fname':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3398           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 't_accept-position':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3399           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'ndovwho':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3400           find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'nosn':U no-error.   if available (buf_doc-attr) then write-data-element (buf_doc-attr.attr-code, buf_doc-attr.attr-value).
     3401               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'Shipper':U no-error.   if available (buf_doc-attr) then write-data-element ('shipper', (if buf_doc-attr.attr-value = ""  or buf_doc-attr.attr-value = ? then "" else ((if num-entries (buf_doc-attr.attr-value, ";") = 2 then (entry (2, buf_doc-attr.attr-value, ";" )) else substring (buf_doc-attr.attr-value, 4, length ( buf_doc-attr.attr-value)))))).
     3402     if v-is-petrol-trn
     3403     then do :
     3404               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'othermoves':U no-error.   write-data-element ('othermoves', (if available (buf_doc-attr) and buf_doc-attr.attr-value > "" and logical(buf_doc-attr.attr-value) then "1" else "0" )).
     3405     end .
     3406     if v-is-lgas-trn
     3407     or v-is-lgas-corr-trn
     3408     then do :
     3409               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'clear-ac':U no-error.   write-data-element ('cleared', (if available (buf_doc-attr) and buf_doc-attr.attr-value > "" and logical(buf_doc-attr.attr-value) then "1" else "0" )).
     3410       for first bf_doc-line-attr no-lock where bf_doc-line-attr.doc-code = DocCode
     3411                                            and bf_doc-line-attr.attr-code = "connect-hoses"
     3412       :
     3413         if bf_doc-line-attr.attr-value > ""
     3414         and bf_doc-line-attr.attr-value <> ?
     3415         then do :
     3416           write-data-element ("connect-hoses", if logical(bf_doc-line-attr.attr-value) then "1" else "0") .
     3417         end .
     3418       end .
     3419     end .
     3420     end.
