     2362   method public logical WghProdVariable
     2363       (input p-obj-type as char,
     2364        input p-obj-code as integer,
     2365        input p-gds-code as integer) :
     2366      define variable v-wgh-val  as character no-undo.
     2367      define variable v-par-val  as character no-undo.
     2368      define variable v-par-type as character no-undo.
     2369      define variable vMarking        as logical no-undo.
     2370      define variable vArtic          as logical no-undo.
     2371      define variable vTransitional   as logical no-undo.
     2372      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2373         if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2374           ( p-gds-code,
     2375             'weighed-gds':U,
     2376              output v-wgh-val,
     2377              output v-par-type
     2378           ).
     2379       if logical(v-wgh-val) = yes then do:
     2380           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2381               ( p-gds-code,
     2382                 'mark-type':U,
     2383                  output v-par-val,
     2384                  output v-par-type
     2385               ).
     2386           if v-par-val <> "" then do:
     2387               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2388               assign
     2389                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2390                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2391                  .
     2392           end.
     2393      end.
     2394      if v-wgh-val > "" and (vMarking or vArtic)
     2395      then return yes.
     2396      else return no.
     2397   end.
     2398   method public decimal MarkWeight
     2399      ( input p-mark as character) :
     2400      define buffer  buf_marking-attr for  ub.marking-attr.
     2401      define variable vMarkWeight as decimal no-undo.
     2402      vMarkWeight = 0.
     2403      if p-mark <> "" and p-mark <> ?
     2404      then do:
     2405          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2406                                        and buf_marking-attr.attr-code eq "weight"
     2407             no-lock no-error.
     2408          if not available buf_marking-attr
     2409          then do :
     2410            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2411                                          and buf_marking-attr.attr-code eq "weight"
     2412               no-lock no-error.
     2413          end .
     2414          if avail buf_marking-attr
     2415          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2416      end.
     2417      return vMarkWeight.
     2418   end.
