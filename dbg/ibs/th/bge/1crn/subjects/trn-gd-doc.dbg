       15   method public char getattrUtdEx
       16   (idb-num   as integer,
       17    idoc-id   as integer,
       18    iattrcode as character,
       19    iExValue  as character  ):
       20      define buffer utd-attr for utd-attr.
       21      find first utd-attr where utd-attr.db-num eq idb-num
       22                            and utd-attr.doc-id eq idoc-id
       23                            and utd-attr.attr-code eq iattrcode
       24      no-lock no-error.
       25      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
       26   end.
       27   method public char getattrUtd
       28   (idb-num   as integer,
       29    idoc-id   as integer,
       30    iattrcode as character ):
       31     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
       32   end.
       33   method public void setattrUtd
       34   (idb-num   as integer,
       35    idoc-id   as integer,
       36    iattrcode as character,
       37    iattrval  as character ):
       38      define buffer utd-attr for utd-attr.
       39      find first utd-attr where utd-attr.db-num eq idb-num
       40                            and utd-attr.doc-id eq idoc-id
       41                            and utd-attr.attr-code eq iattrcode
       42      no-lock no-error.
       43      if not available utd-attr
       44      then do:
       45         create utd-attr.
       46         assign
       47            utd-attr.db-num    = idb-num
       48            utd-attr.doc-id    = idoc-id
       49            utd-attr.attr-code = iattrcode
       50            utd-attr.attr-value = iattrval
       51         .
       52      end.
       53      else do:
       54         if utd-attr.attr-value ne iattrval
       55         then do:
       56            find current utd-attr exclusive-lock no-error.
       57            if available utd-attr
       58            then
       59               utd-attr.attr-value = iattrval.
       60         end.
       61      end.
       62      release utd-attr.
       63   end.
       64   method public char GetAttrUtdlinesEx
       65   (idb-num   as integer,
       66    idoc-id   as integer,
       67    ilinenum  as integer,
       68    iattrcode as character,
       69    iExValue  as character  ):
       70      define buffer utd-lines-attr for utd-lines-attr.
       71      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
       72                                  and utd-lines-attr.doc-id    eq idoc-id
       73                                  and utd-lines-attr.lineNum   eq ilineNum
       74                                  and utd-lines-attr.attr-code eq iattrcode
       75      no-lock no-error.
       76      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
       77   end.
       78   method public char GetAttrUtdlines
       79   (idb-num   as integer,
       80    idoc-id   as integer,
       81    ilinenum  as integer,
       82    iattrcode as character ):
       83      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
       84   end.
       85   method public void setattrUtdlines
       86   (idb-num   as integer,
       87    idoc-id   as integer,
       88    ilinenum  as integer,
       89    iattrcode as character,
       90    iattrval  as character ):
       91      define buffer utd-lines-attr for utd-lines-attr.
       92      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
       93                                  and utd-lines-attr.doc-id    eq idoc-id
       94                                  and utd-lines-attr.lineNum   eq ilineNum
       95                                  and utd-lines-attr.attr-code eq iattrcode
       96      no-lock no-error.
       97      if not available utd-lines-attr
       98      then do:
       99         if iattrval ne ?
      100            and iattrval ne ""
      101         then do:
      102            create utd-lines-attr.
      103            assign
      104               utd-lines-attr.db-num    = idb-num
      105               utd-lines-attr.doc-id    = idoc-id
      106               utd-lines-attr.lineNum   = ilineNum
      107               utd-lines-attr.attr-code = iattrcode
      108               utd-lines-attr.attr-value = iattrval
      109            .
      110         end.
      111      end.
      112      else do:
      113         if utd-lines-attr.attr-value ne iattrval
      114         then do:
      115            find current utd-lines-attr exclusive-lock no-error.
      116            if available utd-lines-attr
      117            then do:
      118               if    iattrval eq ?
      119                  or iattrval eq ""
      120               then do:
      121                  delete utd-lines-attr.
      122               end.
      123               else do:
      124                  utd-lines-attr.attr-value = iattrval.
      125               end.
      126            end.
      127         end.
      128      end.
      129      release utd-lines-attr.
      130   end.
