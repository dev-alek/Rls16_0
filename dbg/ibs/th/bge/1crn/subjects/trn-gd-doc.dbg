      155   method public void setattrUtdMarkingLines
      156   (idb-num   as integer,
      157    idoc-id   as integer,
      158    ilinenum  as integer,
      159    imark     as character,
      160    iattrcode as character,
      161    iattrval  as character ):
      162      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      163      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      164                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      165                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      166                                          and utd-marking-lines-attr.mark      eq imark
      167                                          and utd-marking-lines-attr.attr-code eq iattrcode
      168      no-lock no-error.
      169      if not available utd-marking-lines-attr
      170      then do:
      171         if iattrval ne ?
      172            and iattrval ne ""
      173         then do:
      174            create utd-marking-lines-attr.
      175            assign
      176               utd-marking-lines-attr.db-num     = idb-num
      177               utd-marking-lines-attr.doc-id     = idoc-id
      178               utd-marking-lines-attr.lineNum    = ilineNum
      179               utd-marking-lines-attr.mark       = imark
      180               utd-marking-lines-attr.attr-code  = iattrcode
      181               utd-marking-lines-attr.attr-value = iattrval
      182            .
      183         end.
      184      end.
      185      else do:
      186         if utd-marking-lines-attr.attr-value ne iattrval
      187         then do:
      188            find current utd-marking-lines-attr exclusive-lock no-error.
      189            if available utd-marking-lines-attr
      190            then do:
      191               if    iattrval eq ?
      192                  or iattrval eq ""
      193               then do:
      194                  delete utd-marking-lines-attr.
      195               end.
      196               else do:
      197                  utd-marking-lines-attr.attr-value = iattrval.
      198               end.
      199            end.
      200         end.
      201      end.
      202      release utd-marking-lines-attr.
      203   end.
