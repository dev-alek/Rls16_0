     2571         then buf_trn-doc.ext-doc-type = BufTableHndlOld:buffer-field("ext-doc-type"):buffer-value.
     2572   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2573   run usrfulnm in ibs.th.gbl.gbl-hndllib:g#library
     2574     (input  buf_trn-doc.creid
     2575     ,output v-user-name
     2576     )  .
     2577       if (buf_trn-doc.reason-code = 23 and buf_trn-doc.ext-doc-type = 'ee':U)
     2578       or v-is-return
     2579       then do:
     2580         v-doc-type-ERPRN = "2".
     2581         if v-is-petrol-trn
     2582           then StartDocTrnFuel().
     2583           else StartDocTrn().
     2584         SpiVnesh().
     2585         if v-is-petrol-trn
     2586           then EndDocTrnFuel().
     2587           else EndDocTrn().
     2588       end.
     2589       else do:
     2590         define variable vdoc-type as character no-undo.
     2591         vdoc-type = buf_trn-doc.ext-doc-type.
     2592         case vdoc-type:
     2593            when 'ie':U then do:
     2594               if buf_trn-doc.cli-type = 'маг'
     2595               then
     2596                  vdoc-type = 'iv':U.
     2597            end.
     2598            when 're':U then do:
     2599               if buf_trn-doc.cli-type = 'маг'
     2600               then
     2601                  vdoc-type = 'rv':U.
     2602            end.
     2603         end case.
     2604         case vdoc-type:
     2605           when 'ie':U then do:
     2606             v-doc-type-ERPRN = "1".
     2607             if v-is-petrol-trn
     2608               then StartDocTrnFuel().
     2609               else StartDocTrn().
     2610             PriVnesh().
     2611             if v-is-petrol-trn
     2612               then EndDocTrnFuel().
     2613               else EndDocTrn().
     2614           end.
     2615           when 'ep':U then do:
     2616             v-doc-type-ERPRN = "2".
     2617             if v-is-petrol-trn
     2618               then StartDocTrnFuel().
     2619               else StartDocTrn().
     2620             SpiVnesh().
     2621             if v-is-petrol-trn
     2622               then EndDocTrnFuel().
     2623               else EndDocTrn().
     2624           end.
     2625           when 'ev':U then do:
     2626             v-doc-type-ERPRN = "3".
     2627             if v-is-petrol-trn
     2628               then StartDocTrnFuel().
     2629               else StartDocTrn().
     2630             RasPerem().
     2631             if v-is-petrol-trn
     2632               then EndDocTrnFuel().
     2633               else do:
     2634                 EndDocTrn().
     2635               end.
     2636           end.
     2637           when 'iv':U then do:
     2638             v-doc-type-ERPRN = "4".
     2639             if v-is-petrol-trn
     2640               then StartDocTrnFuel().
     2641               else StartDocTrn().
     2642             PriPerem().
     2643             if v-is-petrol-trn
     2644               then EndDocTrnFuel().
     2645               else EndDocTrn().
     2646           end.
     2647           when 'we':U then do:
     2648             v-doc-type-ERPRN = "5".
     2649             if v-is-petrol-trn
     2650               then StartDocTrnFuel().
     2651               else StartDocTrn().
     2652             SpiVnesh().
     2653             if v-is-petrol-trn
     2654               then EndDocTrnFuel().
     2655               else EndDocTrn().
     2656           end.
     2657           when 'ee':U then do:
     2658             v-doc-type-ERPRN = "7".
     2659             if v-is-petrol-trn
     2660               then StartDocTrnFuel().
     2661               else StartDocTrn().
     2662             SpiVnesh().
     2663             if v-is-petrol-trn
     2664               then EndDocTrnFuel().
     2665               else EndDocTrn().
     2666           end.
     2667           when 'rv':U or when 're':U then do:
     2668             v-doc-type-ERPRN = "8".
     2669             StartDocTrn().
     2670             PriPerem().
     2671             EndDocTrn().
     2672           end.
     2673           otherwise do:
     2674             return.
     2675           end.
     2676         end.
     2677       end.
     2678     end.
     2679     method private void PriVnesh ():
     2680       TrdcAattrPri().
     2681       if v-is-petrol-trn
     2682         then PriVneshLineFuel().
     2683         else PriVneshLine().
     2684     end.
     2685     method private void PriPerem ():
     2686       if v-doc-type-ERPRN = "4"
     2687         then write-data-element ("fuel-st-code", string-mth (buf_trn-doc.cli-code)).
     2688       if v-doc-type-ERPRN = "8"
     2689         then write-data-element ("fuel-st-code", string-mth (buf_trn-doc.cli-code)).
     2690       find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'nids':U no-error. ~
     2691       if available (buf_doc-attr)
     2692       then do:
     2693         write-data-element ('doc-id', buf_doc-attr.attr-value) no-error.
     2694       end.
     2695       if v-is-petrol-trn
     2696         then PriVneshLineFuel().
     2697         else do:
     2698           PriVneshLine().
     2699         end.
     2700     end.
     2701     method private void SpiVnesh ():
     2702       if v-doc-type-ERPRN = "3"
     2703         then write-data-element ("fuel-st-code", string-mth (buf_trn-doc.cli-code)).
     2704       TrdcAattrRas().
     2705       if v-is-petrol-trn
     2706         then RasFuel().
     2707         else Ras().
     2708     end.
     2709     method private void RasPerem ():
     2710       if v-doc-type-ERPRN = "3"
     2711         then write-data-element ("fuel-st-code", string-mth (buf_trn-doc.cli-code)).
     2712       if v-is-petrol-trn
     2713         then RasFuel().
     2714         else Ras().
     2715     end.
     2716     method private void PriVneshLine ():
     2717      define variable vat-pc as character no-undo .
     2718       sw:start-element ("gds").
     2719       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code by buf_doc-line.line-num:
     2720         find first buf_gds no-lock where
     2721               buf_gds.artic = buf_doc-line.artic
     2722           and buf_gds.prod-code = buf_doc-line.prod-code
     2723           and buf_gds.prod-type = buf_doc-line.prod-type.
     2724         if buf_trn-doc.contract-code <> 0 then do:
     2725           for first buf_contract-specif no-lock where buf_contract-specif.contract-num = buf_trn-doc.contract-code and
     2726           buf_contract-specif.artic = buf_doc-line.artic and
     2727           buf_contract-specif.prod-code = buf_doc-line.prod-code and
     2728           buf_contract-specif.prod-type = buf_doc-line.prod-type :
     2729             if buf_contract-specif.VAT-type = 'без':U then vat-pc = "-1".
     2730           end.
     2731         end.
     2732         sw:start-element ("gd").
     2733           write-data-element ("line-num", string-mth (buf_doc-line.line-num)).
     2734           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     2735           write-data-element ("unit-code", string (buf_doc-line.unit-cli)).
     2736           write-data-element ("koef", string (buf_doc-line.cli-base-rate)).
     2737           write-data-element ("qnty-ttn", string-mth (buf_doc-line.cli-qnty)).
     2738           write-data-element ("qnty-fact", string-mth (buf_doc-line.fact-qnty / buf_doc-line.cli-base-rate)).
     2739           if v-doc-type-ERPRN = "8"
     2740           then do:
     2741             find first buf_gds-dtl where buf_gds-dtl.doc-code = buf_trn-doc.doc-code
     2742               and buf_gds-dtl.artic = buf_gds-dtl.artic
     2743               and buf_gds-dtl.prod-code = buf_gds-dtl.prod-code
     2744               and buf_gds-dtl.prod-type = buf_gds-dtl.prod-type.
     2745             write-data-element ("sum", string-mth (round (buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty, 2))).
     2746             write-data-element ("nds-code", if vat-pc <> "" then vat-pc else string-mth ( round (buf_doc-line.VAT-pc , 0))).
     2747             write-data-element ("sum-nds", string-mth ( round ((buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty * buf_doc-line.VAT-pc) / (100 + buf_doc-line.VAT-pc) , 2))).
     2748             write-data-element ("sum-s", string-mth ( round (buf_doc-line.price-rubl * buf_doc-line.fact-qnty / (1 + (buf_doc-line.VAT-pc / 100)), 2))).
     2749           end.
     2750           else do:
     2751             def var sum-nds as decimal no-undo.
     2752             def var sum_ as decimal no-undo.
     2753             sum_ = round (buf_doc-line.price-rubl * buf_doc-line.fact-qnty, 2).
     2754             sum-nds = round ((buf_doc-line.price-rubl * buf_doc-line.fact-qnty * buf_doc-line.VAT-pc) / (100 + buf_doc-line.VAT-pc) , 2).
     2755             write-data-element ("sum", string-mth (sum_)).
     2756             write-data-element ("nds-code", if vat-pc <> "" then vat-pc else string-mth ( round (buf_doc-line.VAT-pc , 0))).
     2757             write-data-element ("sum-nds", string-mth (sum-nds)).
     2758             write-data-element ("sum-s", string-mth (sum_ - sum-nds)).
     2759           end.
     2760           writeprts(buf_doc-line.line-num).
     2761           Marks(buf_doc-line.line-num) .
     2762         sw:end-element ("gd").
     2763       end.
     2764       sw:end-element ("gds").
     2765     end.
     2766     method private void PriVneshLineFuel ():
     2767       define variable infoSecsObj     as class InfoSectionsTotal no-undo.
     2768       define variable infoSecObj      as class InfoSection       no-undo.
     2769       define variable ii as integer no-undo.
     2770       define variable is-exist-sec as logical no-undo.
     2771       define variable v-date as date no-undo.
     2772       define variable v-int  as integer no-undo.
     2773       define variable vIsSGDKK as logical no-undo init no .
     2774       define buffer buf_clients-attr for ub.clients-attr .
     2775       infoSecsObj = new InfoSectionsTotal().
     2776       release buf_doc-attr no-error.
     2777               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'ptbobj':U no-error.   if available (buf_doc-attr) then write-data-element ('nb', (if buf_doc-attr.attr-value = ""  or buf_doc-attr.attr-value = ? then "" else ((if num-entries (buf_doc-attr.attr-value, ";") = 2 then (entry (2, buf_doc-attr.attr-value, ";" )) else substring (buf_doc-attr.attr-value, 4, length ( buf_doc-attr.attr-value)))))).
     2778       if available buf_doc-attr
     2779       and buf_doc-attr.attr-value > ""
     2780       then do :
     2781         find first buf_clients-attr no-lock where buf_clients-attr.obj-type  = entry(1, buf_doc-attr.attr-value, ";")
     2782                                               and buf_clients-attr.obj-code  = integer(entry(2, buf_doc-attr.attr-value, ";"))
     2783                                               and buf_clients-attr.attr-code = 'owner-code':U
     2784                                               no-error .
     2785         if available buf_clients-attr
     2786         and buf_clients-attr.attr-value > ""
     2787         then do :
     2788           write-data-element ('org-code', substring(buf_clients-attr.attr-value, 4)) no-error.
     2789         end .
     2790         else do :
     2791           write-data-element ('org-code', "") no-error.
     2792         end .
     2793       end .
     2794               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'ptb-item-pour':U no-error.   if available (buf_doc-attr) then write-data-element ('ptb-item-pour', (buf_doc-attr.attr-value)).
     2795               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'autoent':U no-error.   if available (buf_doc-attr) then write-data-element ('przk', (if buf_doc-attr.attr-value = ""  or buf_doc-attr.attr-value = ? then "" else ((if num-entries (buf_doc-attr.attr-value, ";") = 2 then (entry (2, buf_doc-attr.attr-value, ";" )) else substring (buf_doc-attr.attr-value, 4, length ( buf_doc-attr.attr-value)))))).
     2796               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'car-num':U no-error.   if available (buf_doc-attr) then write-data-element ('tanker', (buf_doc-attr.attr-value)).
     2797               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'fio-driver':U no-error.   if available (buf_doc-attr) then write-data-element ('driver', (buf_doc-attr.attr-value)).
     2798               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'time-income':U no-error.   if available (buf_doc-attr) then write-data-element ('time-income', (buf_doc-attr.attr-value)).
     2799               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'inspection-cert':U no-error.   if available (buf_doc-attr) then write-data-element ('inspection-cert', (buf_doc-attr.attr-value)).
     2800               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'date-cert':U no-error.   if available (buf_doc-attr) then write-data-element ('date-cert', iso-date (date (buf_doc-attr.attr-value))).
     2801               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'condition':U no-error.   if available (buf_doc-attr) then write-data-element ('condition', (buf_doc-attr.attr-value)).
     2802       find first buf_doc-attr no-lock where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'seals-condition':U no-error. ~
     2803       if available (buf_doc-attr)
     2804       then do:
     2805         write-data-element ('seales', entry (1, buf_doc-attr.attr-value, chr(4))) no-error.
     2806         write-data-element ('seales-condition', entry (2, buf_doc-attr.attr-value, chr(4))) no-error.
     2807       end.
     2808       find first buf_doc-attr no-lock where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'car-num':U no-error .
     2809       if available buf_doc-attr
     2810       then do :
     2811         find first sep_auto-tank-attr no-lock where sep_auto-tank-attr.auto-num = buf_doc-attr.attr-value
     2812                                                 and sep_auto-tank-attr.attr-code = "auto-sep"
     2813                                                 no-error.
     2814         if available sep_auto-tank-attr
     2815         and logical(sep_auto-tank-attr.attr-value)
     2816         then do :
     2817           vIsSGDKK = yes .
     2818         end .
     2819       end .
     2820       if vIsSGDKK = yes
     2821       then do :
     2822         write-data-element ('ess', string(1)) no-error.
     2823       end .
     2824       else do :
     2825         write-data-element ('ess', string(0)) no-error.
     2826       end .
     2827       find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = DocCode and buf_doc-line-attr.attr-code begins "shape" no-error.
     2828       if available (buf_doc-line-attr)
     2829       then do:
     2830         write-data-element ('neck-type', string(lookup(buf_doc-line-attr.attr-value, "Без горловины,Квадратная/прямоугольная,Эллиптическая,Круглая") - 1)) no-error .
     2831       end .
     2832               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'date-pour':U no-error.   if available (buf_doc-attr) then write-data-element ('date-pour', iso-date (date (buf_doc-attr.attr-value))).
     2833               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'time-pour':U no-error.   if available (buf_doc-attr) then write-data-element ('time-pour', (buf_doc-attr.attr-value)).
     2834               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'doc-not':U no-error.   if available (buf_doc-attr) then write-data-element ('doc-not', (buf_doc-attr.attr-value)).
     2835               find first buf_doc-attr where buf_doc-attr.doc-code = DocCode and buf_doc-attr.attr-code = 'spisok-not-doc':U no-error.   if available (buf_doc-attr) then write-data-element ('spisok-not-doc', (buf_doc-attr.attr-value)).
     2836       sw:start-element ("gds").
     2837       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code by buf_doc-line.line-num:
     2838         find first buf_gds where
     2839               buf_gds.artic = buf_doc-line.artic
     2840           and buf_gds.prod-code = buf_doc-line.prod-code
     2841           and buf_gds.prod-type = buf_doc-line.prod-type.
     2842         infoSecsObj:Initialization(buf_doc-line.doc-code, buf_gds.gds-code).
     2843         infoSecsObj:GetDBAllAttr ().
     2844         infoSecsObj:CalculateTotal().
     2845         sw:start-element ("gd").
     2846           write-data-element ("line-num", string-mth (buf_doc-line.line-num)).
     2847           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     2848           write-data-element ("cap-ttn", string-mth (buf_doc-line.doc-qnty)).
     2849           write-data-element ("wght-ttn", string-mth (buf_doc-line.cli-qnty)).
     2850           write-data-element ("dnsty-ttn", string-mth (buf_doc-line.doc-density)).
     2851           write-data-element ("cap-fact", string-mth (buf_doc-line.fact-qnty)).
     2852           if not infoSecsObj:FactKgQntyTotal = 0
     2853           then do:
     2854             is-exist-sec = true.
     2855             write-data-element ("wght-fact", string-mth (round (infoSecsObj:FactKgQntyTotal, 3))).
     2856           end.
     2857           else do:
     2858             write-data-element ("wght-fact", string-mth (round (buf_doc-line.fact-density * buf_doc-line.fact-qnty, 3))).
     2859           end.
     2860           write-data-element ("dnsty-fact", string-mth (buf_doc-line.fact-density)).
     2861           write-data-element ("sum", string-mth (round (buf_doc-line.price-cli * buf_doc-line.cli-qnty, 2))).
     2862           find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = DocCode
     2863                                                  and buf_doc-line-attr.gds-code = buf_gds.gds-code
     2864                                                  and buf_doc-line-attr.attr-code = "propan-perc"
     2865                                                  no-error .
     2866           if available buf_doc-line-attr
     2867           and buf_doc-line-attr.attr-value > ""
     2868           and decimal(buf_doc-line-attr.attr-value) >= 0
     2869           then do :
     2870             write-data-element ('C3H8', string-mth (decimal(buf_doc-line-attr.attr-value))) .
     2871           end .
     2872         sw:end-element ("gd").
     2873       end.
     2874       sw:end-element ("gds").
     2875       if not buf_trn-doc.cli-code = 800000002 and is-exist-sec and not v-is-lgas-trn and not v-is-lgas-corr-trn
     2876       then do:
     2877         sw:start-element ("scs").
     2878         for each buf_doc-line no-lock where not v-doc-type-ERPRN = '4' and buf_doc-line.doc-code = buf_trn-doc.doc-code:
     2879           find first buf_gds where
     2880                 buf_gds.artic = buf_doc-line.artic
     2881             and buf_gds.prod-code = buf_doc-line.prod-code
     2882             and buf_gds.prod-type = buf_doc-line.prod-type.
     2883           infoSecsObj:Initialization(buf_doc-line.doc-code, buf_gds.gds-code).
     2884           infoSecsObj:GetDBAllAttr ().
     2885           do ii = 1 to infoSecsObj:SectionNum:
     2886             infoSecObj = infoSecsObj:GetInfoSectionProp(ii).
     2887             if infoSecObj:FactQnty = 0  or infoSecObj:FactQnty = ?
     2888               then next.
     2889             sw:start-element ("sc").
     2890             write-data-element ("sc-num", string (infoSecObj:SectionName)).
     2891             write-data-element ("gd-line-num", string-mth (buf_doc-line.line-num)).
     2892             write-data-element ("cap-doc", string-mth (if infoSecObj:DocVolume > 0 then infoSecObj:DocVolume else infoSecObj:DocQnty)).
     2893             write-data-element ("dnsty-doc", string-mth (infoSecObj:DocDensity)).
     2894             write-data-element ("standard-dnst", string-mth (infoSecObj:DocDensST)).
     2895             write-data-element ("wght-doc", string-mth (infoSecObj:CliQnty)).
     2896             write-data-element ("acc-ship", string-mth (infoSecObj:AccShip)).
     2897             write-data-element ("cap-psprt", string-mth (infoSecObj:CarVol)).
     2898             write-data-element ("sz-nck", replace(infoSecObj:Diameter, chr(6), " ")).
     2899             if not vIsSGDKK
     2900             then do :
     2901               write-data-element ("filling-method", (if infoSecObj:Pour = "Верхний налив" then '0' else '1')).
     2902               if infoSecObj:DopVolume = ?
     2903               or infoSecObj:DopVolume = 0
     2904               then do :
     2905                 infoSecObj:DopVolume = decimal (entry(1, replace(infoSecObj:Diameter, chr(6), " "), "/")) no-error .
     2906                 if error-status:error
     2907                   then infoSecObj:DopVolume = 0.
     2908               end .
     2909               write-data-element ("pipe-vlm", string (infoSecObj:DopVolume)).
     2910             end .
     2911             write-data-element ("lvl", string-mth (infoSecObj:ABTarir)).
     2912             write-data-element ("cap-nck", string-mth (infoSecObj:Mouth)).
     2913             write-data-element ("cap", string-mth (infoSecObj:TankVol)).
     2914             write-data-element ("dnsty-f", string-mth (infoSecObj:TankDensity)).
     2915             write-data-element ("cap-wtr", string-mth (infoSecObj:TankWater)).
     2916             write-data-element ("t-cap", string-mth (infoSecObj:TankTemp)).
     2917             write-data-element ("t-dnsty", string-mth (infoSecObj:DensTemp)).
     2918             write-data-element ("msd-code", string-mth (infoSecObj:PlaceSi)).
     2919             write-data-element ("mst-code", string-mth (infoSecObj:PlaceSiTemp)).
     2920             write-data-element ("pv-date", string (iso-date (infoSecObj:DatePovPlotn))).
     2921             write-data-element ("dnsty-pr", string-mth (infoSecObj:TankDensityPomi)).
     2922             write-data-element ("cap-pr", string-mth (infoSecObj:TankVolPomi)).
     2923             write-data-element ("wght-pr", string-mth (infoSecObj:TankWeight)).
     2924             write-data-element ("wght-eu", string-mth (infoSecObj:NaturalLoss)).
     2925             write-data-element ("tp-norm", string (infoSecObj:TPNorm)).
     2926             write-data-element ("tp-tank-norm", string-mth (infoSecObj:TPNormPL)).
     2927             write-data-element ("tp-nsn-norm", string-mth (infoSecObj:TPNormAuto)).
     2928             write-data-element ("wght-vpr", string-mth (infoSecObj:AccAbsFact)).
     2929             write-data-element ("ned", string-mth (infoSecObj:Deficit)).
     2930             write-data-element ("izl", string-mth (infoSecObj:Excess)).
     2931             write-data-element ("dnsty-uch", string-mth (infoSecObj:FactDensity)).
     2932             write-data-element ("cap-uch", string-mth (infoSecObj:FactQnty)).
     2933             write-data-element ("wght-uch", string-mth (infoSecObj:FactKgQnty)).
     2934             write-data-element ("sl-date-s", string (iso-date (infoSecObj:DateStart))).
     2935             write-data-element ("sl-time-s", string (infoSecObj:TimeStart, "HH:MM")).
     2936             write-data-element ("sl-date-e", string (iso-date (infoSecObj:DateEnd))).
     2937             write-data-element ("sl-time-e", string (infoSecObj:TimeEnd, "HH:MM")).
     2938             write-data-element ("cmm", string (if infoSecObj:IsKP then "1" else "0")).
     2939             if infoSecObj:IsKP
     2940             then do :
     2941               write-data-element ("acc-meth", string (infoSecObj:AccMeth)).
     2942             end .
     2943             write-data-element ("er-ms", string-mth (infoSecObj:AccPomi)).
     2944             write-data-element ("norm-doc", string (infoSecObj:NormDoc)).
     2945             write-data-element ("passport-num", string (infoSecObj:NumPassport)).
     2946             write-data-element ("passport-dnst", string-mth (infoSecObj:PaspDens)).
     2947             write-data-element ("t-ttn", string-mth (infoSecObj:TTNTemp)).
     2948             case infoSecObj:GroupNP :
     2949               when "I"
     2950               then do :
     2951                 write-data-element ("fuel-group", string (1)).
     2952               end .
     2953               when "II"
     2954               then do :
     2955                 write-data-element ("fuel-group", string (2)).
     2956               end .
     2957               when "III"
     2958               then do :
     2959                 write-data-element ("fuel-group", string (3)).
     2960               end .
     2961               when "IV"
     2962               then do :
     2963                 write-data-element ("fuel-group", string (4)).
     2964               end .
     2965             end case .
     2966             if infoSecObj:Pressure > 0
     2967             then
     2968               write-data-element ("dnp", string-mth (infoSecObj:Pressure)).
     2969             if vIsSGDKK
     2970             then do :
     2971               write-data-element ("alrm", (if infoSecObj:alarm-SGDKK then string(1) else string(0))).
     2972               if infoSecObj:aukKey > ""
     2973               then do :
     2974                 write-data-element ("auk", string(infoSecObj:aukKey)).
     2975               end .
     2976             end .
     2977             else do :
     2978               write-data-element ("trans-comm", (if infoSecObj:KPnoMeas then string(1) else string(0))).
     2979             end .
     2980             write-data-element ("tank-num", string (infoSecObj:ListTank)).
     2981             write-data-element ("certif-fuel", string (infoSecObj:CertifFuel)).
     2982             write-data-element ("validity-certif", string (infoSecObj:ValidityCertif)).
     2983             write-data-element ("tests", if string (infoSecObj:Tests) = "" then "0" else string (infoSecObj:Tests)).
     2984             write-data-element ("num-print-prob", string (infoSecObj:NumPrintProb)).
     2985             write-data-element ("prob-kol", string-mth (infoSecObj:KolProb)).
     2986             write-data-element ("prob-date", iso-date (infoSecObj:DateProb)).
     2987             write-data-element ("prob-time", string (infoSecObj:HourProb, "99") + ":" + string (infoSecObj:MinProb, "99")).
     2988             find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'перед_док':U
     2989                                              and buf_rvs-doc.out-code = buf_trn-doc.doc-code
     2990                                              and num-entries(buf_rvs-doc.rvs-code, "-") = 3
     2991                                              and entry(2, buf_rvs-doc.rvs-code, "-") = infoSecObj:SectionName
     2992                                              no-error .
     2993             if not available buf_rvs-doc
     2994             then do :
     2995               find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'перед_док':U
     2996                                                and buf_rvs-doc.out-code = buf_trn-doc.doc-code
     2997                                                no-error .
     2998             end .
     2999             if available buf_rvs-doc
     3000             then do :
     3001               write-data-element ("rvs-before", string (buf_rvs-doc.rvs-code)).
     3002             end .
     3003             find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'после_док':U
     3004                                              and buf_rvs-doc.out-code = buf_trn-doc.doc-code
     3005                                              and num-entries(buf_rvs-doc.rvs-code, "-") = 3
     3006                                              and entry(2, buf_rvs-doc.rvs-code, "-") = infoSecObj:SectionName
     3007                                              no-error .
     3008             if not available buf_rvs-doc
     3009             then do :
     3010               find first buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'после_док':U
     3011                                                and buf_rvs-doc.out-code = buf_trn-doc.doc-code
     3012                                                no-error .
     3013             end .
     3014             if available buf_rvs-doc
     3015             then do :
     3016               write-data-element ("rvs-after", string (buf_rvs-doc.rvs-code)).
     3017             end .
     3018             sw:end-element ("sc").
     3019           end.
     3020         end.
     3021         sw:end-element ("scs").
     3022       end.
     3023       sw:start-element ("tanks").
     3024       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code by buf_doc-line.line-num:
     3025         find first buf_gds where
     3026               buf_gds.artic = buf_doc-line.artic
     3027           and buf_gds.prod-code = buf_doc-line.prod-code
     3028           and buf_gds.prod-type = buf_doc-line.prod-type.
     3029         for each buf_doc-pl where buf_doc-pl.obj-type = buf_doc-line.obj-type and buf_doc-pl.obj-code = buf_doc-line.obj-code
     3030           and buf_doc-pl.out-code = buf_doc-line.doc-code and buf_doc-pl.gds-code = buf_gds.gds-code
     3031           :
     3032           sw:start-element ("tank").
     3033             write-data-element ("gd-line", string-mth (buf_doc-line.line-num)).
     3034             write-data-element ("tank", string-mth (buf_doc-pl.pl-code)).
     3035             write-data-element ("cap-doc", string-mth (buf_doc-pl.doc-qnty)).
     3036             write-data-element ("dnsty-doc", string-mth (buf_doc-line.doc-density)).
     3037             write-data-element ("wght-doc", string-mth (buf_doc-pl.cli-doc-qnty)).
     3038             write-data-element ("dnsty", string-mth ( buf_doc-pl.cli-fact-qnty / buf_doc-pl.fact-qnty)).
     3039             write-data-element ("cap", string-mth (buf_doc-pl.fact-qnty)).
     3040             write-data-element ("wght", string-mth (buf_doc-pl.cli-fact-qnty)).
     3041             find first buf_doc-pl-attr no-lock where buf_doc-pl-attr.obj-code  = buf_doc-pl.obj-code
     3042                                                  and buf_doc-pl-attr.obj-type  = buf_doc-pl.obj-type
     3043                                                  and buf_doc-pl-attr.gds-code  = buf_doc-pl.gds-code
     3044                                                  and buf_doc-pl-attr.pl-code   = buf_doc-pl.pl-code
     3045                                                  and buf_doc-pl-attr.out-code  = buf_doc-pl.out-code
     3046                                                  and buf_doc-pl-attr.attr-code = "free-vol-exceed"
     3047                                                  no-error.
     3048             if available buf_doc-pl-attr
     3049             then do :
     3050               write-data-element ("excess-free", (if logical(buf_doc-pl-attr.attr-value) then "1" else "0")).
     3051             end .
     3052           sw:end-element ("tank").
     3053         end.
     3054       end.
     3055       sw:end-element ("tanks").
     3056     end.
     3057     method private void Ras ():
     3058       sw:start-element ("gds").
     3059     for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code by buf_doc-line.line-num:
     3060         find first buf_gds-dtl where buf_gds-dtl.doc-code = buf_doc-line.doc-code
     3061           and buf_doc-line.artic = buf_gds-dtl.artic
     3062           and buf_doc-line.prod-code = buf_gds-dtl.prod-code
     3063           and buf_doc-line.prod-type = buf_gds-dtl.prod-type.
     3064         find first buf_gds where
     3065               buf_gds.artic = buf_doc-line.artic
     3066           and buf_gds.prod-code = buf_doc-line.prod-code
     3067           and buf_gds.prod-type = buf_doc-line.prod-type.
     3068         sw:start-element ("gd").
     3069           write-data-element ("line-num", string-mth (buf_doc-line.line-num)).
     3070           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     3071           write-data-element ("unit-code", string (buf_gds.unit-base)).
     3072           write-data-element ("koef", string (1)).
     3073           write-data-element ("qnty-ttn", string-mth (buf_gds-dtl.doc-qnty)).
     3074           write-data-element ("qnty-fact", string-mth (buf_gds-dtl.fact-qnty)).
     3075           write-data-element ("sum", string-mth (round (buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty, 2))).
     3076           write-data-element ("nds-code", string-mth ( round (buf_doc-line.VAT-pc , 0))).
     3077           write-data-element ("sum-nds", string-mth ( round ((buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty * buf_doc-line.VAT-pc) / (100 + buf_doc-line.VAT-pc) , 2))).
     3078           write-data-element ("sum-s", string-mth (round (buf_doc-line.price-rubl * buf_gds-dtl.fact-qnty / (1 + (buf_doc-line.VAT-pc / 100)), 2))).
     3079           writeprts(buf_doc-line.line-num).
     3080           Marks(buf_doc-line.line-num) .
     3081         sw:end-element ("gd").
     3082       end.
     3083       sw:end-element ("gds").
     3084     end.
     3085     method private void RasFuel ():
     3086       sw:start-element ("gds").
     3087       for each buf_gds-dtl no-lock where buf_gds-dtl.doc-code = buf_trn-doc.doc-code:
     3088         find first buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code
     3089           and buf_doc-line.artic = buf_gds-dtl.artic
     3090           and buf_doc-line.prod-code = buf_gds-dtl.prod-code
     3091           and buf_doc-line.prod-type = buf_gds-dtl.prod-type.
     3092         find first buf_gds where
     3093               buf_gds.artic = buf_doc-line.artic
     3094           and buf_gds.prod-code = buf_doc-line.prod-code
     3095           and buf_gds.prod-type = buf_doc-line.prod-type.
     3096         sw:start-element ("gd").
     3097           write-data-element ("line-num", string-mth (buf_doc-line.line-num)).
     3098           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     3099           write-data-element ("cap-ttn", string-mth (buf_gds-dtl.doc-qnty)).
     3100           write-data-element ("wght-ttn", string-mth (buf_doc-line.cli-qnty)).
     3101           write-data-element ("dnsty-ttn", string-mth (buf_doc-line.doc-density)).
     3102           write-data-element ("cap-fact", string-mth (buf_gds-dtl.fact-qnty)).
     3103           write-data-element ("wght-fact", string-mth (round (buf_doc-line.fact-density * buf_gds-dtl.fact-qnty, 3))).
     3104           write-data-element ("dnsty-fact", string-mth (buf_doc-line.fact-density)).
     3105           write-data-element ("sum", string-mth (round (buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty, 2))).
     3106           if v-doc-type-ERPRN = "3" or v-doc-type-ERPRN = "5" or v-doc-type-ERPRN = "7"
     3107             then write-data-element ("t", string-mth (round (buf_doc-line.temperature, 2))).
     3108         sw:end-element ("gd").
     3109       end.
     3110       sw:end-element ("gds").
     3111       sw:start-element ("tanks").
     3112       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code by buf_doc-line.line-num:
     3113         find first buf_gds where
     3114               buf_gds.artic = buf_doc-line.artic
     3115           and buf_gds.prod-code = buf_doc-line.prod-code
     3116           and buf_gds.prod-type = buf_doc-line.prod-type.
     3117         for each buf_doc-pl where buf_doc-pl.obj-type = buf_doc-line.obj-type and buf_doc-pl.obj-code = buf_doc-line.obj-code
     3118           and buf_doc-pl.out-code = buf_doc-line.doc-code and buf_doc-pl.gds-code = buf_gds.gds-code
     3119           :
     3120           sw:start-element ("tank").
     3121             write-data-element ("gd-line", string-mth (buf_doc-line.line-num)).
     3122             write-data-element ("tank", string-mth (buf_doc-pl.pl-code)).
     3123             write-data-element ("cap-doc", string-mth (buf_doc-pl.doc-qnty)).
     3124             write-data-element ("dnsty-doc", string-mth (buf_doc-line.doc-density)).
     3125             write-data-element ("wght-doc", string-mth (buf_doc-pl.cli-doc-qnty)).
     3126             write-data-element ("dnsty", string-mth ( buf_doc-pl.cli-fact-qnty / buf_doc-pl.fact-qnty)).
     3127             write-data-element ("cap", string-mth (buf_doc-pl.fact-qnty)).
     3128             write-data-element ("wght", string-mth (buf_doc-pl.cli-fact-qnty)).
     3129           sw:end-element ("tank").
     3130         end.
     3131       end.
     3132       sw:end-element ("tanks").
     3133     end.
     3134     method private void StartDocTrn ():
     3135         InitSecTag =  "trn-gd-docs".
     3136         sw:start-element ("trn-gd-doc") .
     3137           write-data-element ("doc-code", buf_trn-doc.doc-code).
     3138           write-data-element ("doc-num", buf_trn-doc.doc-code).
     3139           write-data-element ("del-f", string (isDel, "1/0") ).
     3140           write-data-element ("doc-date", if buf_trn-doc.doc-date = ? then "" else iso-date (datetime (buf_trn-doc.doc-date, buf_trn-doc.real-time-create * 1000))).
     3141           write-data-element ("fact-date", if buf_trn-doc.fact-date = ? then "" else iso-date (datetime (buf_trn-doc.fact-date, buf_trn-doc.fact-time * 1000))).
     3142           write-data-element ("doc-type", v-doc-type-ERPRN).
     3143           if v-is-edo-return
     3144           then do :
     3145             write-data-element ("edi-return", "1").
     3146           end.
     3147           write-data-element ("doc-rsn-code", (if buf_trn-doc.reason-code = ? then "0" else string-mth (buf_trn-doc.reason-code))).
     3148           write-data-element ("edoc-id", edoc-id).
     3149           write-data-element ("shift-date", if buf_trn-doc.shift-date = ? then "" else iso-date (date (buf_trn-doc.shift-date))).
     3150           write-data-element ("shift-num", if buf_trn-doc.shift-num = ? then "0" else string-mth (buf_trn-doc.shift-num)).
     3151           write-data-element ("contr-code", string-mth (buf_trn-doc.cli-code)).
     3152           write-data-element ("dog-code", string-mth (buf_trn-doc.contract-code)).
     3153           write-data-element ("operator", v-user-name ).
     3154           write-data-element ("psn-wrkr", string-mth (buf_trn-doc.wrkr)).
     3155           write-data-element ("psn-agnt", string-mth (buf_trn-doc.agnt)).
     3156           write-data-element ("psn-boss", string-mth (buf_trn-doc.boss)).
     3157     end.
     3158     method private void EndDocTrn ():
     3159       sw:end-element ("trn-gd-doc") .
     3160     end.
     3161     method private void StartDocTrnFuel ():
     3162         InitSecTag =  "trn-fuel-docs".
     3163         sw:start-element ("trn-fuel-doc") .
     3164           write-data-element ("doc-code", buf_trn-doc.doc-code).
     3165           write-data-element ("doc-num", buf_trn-doc.doc-code).
     3166           write-data-element ("del-f", string (isDel, "1/0") ).
     3167           write-data-element ("doc-date", if buf_trn-doc.doc-date = ? then "" else iso-date (datetime (buf_trn-doc.doc-date, buf_trn-doc.real-time-create * 1000))).
     3168           write-data-element ("fact-date", if buf_trn-doc.fact-date = ? then "" else iso-date (datetime (buf_trn-doc.fact-date, buf_trn-doc.fact-time * 1000))).
     3169           write-data-element ("doc-type", (if v-is-lgas-corr-trn then "9" else v-doc-type-ERPRN)).
     3170           write-data-element ("doc-rsn-code", string-mth (buf_trn-doc.reason-code)).
     3171           write-data-element ("shift-date", if buf_trn-doc.shift-date = ? then "" else iso-date (date (buf_trn-doc.shift-date))).
     3172           write-data-element ("shift-num", if buf_trn-doc.shift-num = ? then "0" else string-mth (buf_trn-doc.shift-num)).
     3173           write-data-element ("contr-code", string-mth (buf_trn-doc.cli-code)).
     3174           write-data-element ("dog-code", string-mth (buf_trn-doc.contract-code)).
     3175           write-data-element ("operator", v-user-name ).
     3176           write-data-element ("psn-wrkr", string-mth (buf_trn-doc.wrkr)).
     3177           write-data-element ("psn-agnt", string-mth (buf_trn-doc.agnt)).
     3178           write-data-element ("psn-boss", string-mth (buf_trn-doc.boss)).
     3179     end.
     3180     method private void EndDocTrnFuel ():
     3181       sw:end-element ("trn-fuel-doc") .
     3182     end.
     3183     method private void Marks (p-line-num as integer):
     3184       define variable v-gds-attr-value-old as character no-undo .
     3185       define variable v-gds-attr-type      as character no-undo .
     3186       define variable vGT as integer no-undo .
     3187       define variable vGtin as character no-undo .
     3188       define variable vQnty as integer no-undo .
     3189       define variable vDocQnty as integer no-undo .
     3190       define variable isVarWeight as logical no-undo init no .
     3191       for first buf_doc-line no-lock where buf_doc-line.doc-code = DocCode
     3192                                       and buf_doc-line.line-num = p-line-num,
     3193         first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and
     3194         buf_goods.prod-code = buf_doc-line.prod-code and
     3195         buf_goods.prod-type = buf_doc-line.prod-type  :
     3196         isVarWeight = WghProdVariable(buf_doc-line.obj-type, buf_doc-line.obj-code, buf_goods.gds-code).
     3197         find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_doc-line.doc-code
     3198                                                and buf_doc-line-attr.gds-code = buf_goods.gds-code
     3199                                                and buf_doc-line-attr.attr-code = "GTIN-qnty"
     3200                                                no-error .
     3201         if available buf_doc-line-attr
     3202         and buf_doc-line-attr.attr-value > ""
     3203         and not isVarWeight
     3204         then do :
     3205           sw:start-element ("marks").
     3206           GT_ :
     3207           do vGT = 1 to num-entries(buf_doc-line-attr.attr-value, ";") :
     3208             assign
     3209               vGtin = entry(1, entry(vGT, buf_doc-line-attr.attr-value, ";"), "=")
     3210               vQnty = integer(entry(2, entry(vGT, buf_doc-line-attr.attr-value, ";"), "="))
     3211             no-error .
     3212             if error-status:error
     3213             then next GT_ .
     3214             sw:start-element ("mark").
     3215             write-data-element ("gtin", vGtin) .
     3216             write-data-element ("gtin-qnt", string-mth(vQnty)) .
     3217             sw:end-element ("mark").
     3218           end .
     3219           sw:end-element ("marks").
     3220         end .
     3221         else do :
     3222                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     3223             ( input buf_goods.gds-code
     3224              ,input 'mark-type':U
     3225              ,output v-gds-attr-value-old
     3226              ,output v-gds-attr-type
     3227             )        no-error .
     3228           if error-status :error
     3229           then do:
     3230             undo, return error return-value .
     3231           end.
     3232           define variable vAvailMarks as logical no-undo.
     3233           for each buf_parts no-lock where buf_parts.out-code  = buf_doc-line.doc-code
     3234                                        and buf_parts.artic     = buf_doc-line.artic
     3235                                        and buf_parts.prod-type = buf_doc-line.prod-type
     3236                                        and buf_parts.prod-code = buf_doc-line.prod-code:
     3237             if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_parts.obj-type, buf_parts.obj-code):GetIsMarkingForType(v-gds-attr-value-old)
     3238             or ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_parts.obj-type, buf_parts.obj-code):GetIsEDOForType(v-gds-attr-value-old)
     3239             or isVarWeight
     3240             then do:
     3241               for each buf_marking-lines no-lock where buf_marking-lines.doc-level = 1 and
     3242                 buf_marking-lines.gds-code = buf_goods.gds-code and
     3243                 buf_marking-lines.in-code = buf_parts.in-code and
     3244                 buf_marking-lines.obj-code = buf_parts.obj-code and
     3245                 buf_marking-lines.obj-type = buf_parts.obj-type and
     3246                 buf_marking-lines.out-code = buf_parts.out-code and
     3247                 buf_marking-lines.part-code = buf_parts.part-code and
     3248                 buf_marking-lines.prt-code = buf_parts.prt-code  :
     3249                 if buf_marking-lines.mark begins 'tech_':U
     3250                 and buf_trn-doc.ext-doc-type <> 'ev':U and buf_trn-doc.ext-doc-type <> 'iv':U
     3251                 then next .
     3252                 if buf_marking-lines.sts <> ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3253                 and buf_marking-lines.sts <> ObjSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     3254                 and buf_trn-doc.ext-doc-type = 'iv':U
     3255                 then next .
     3256                 if not vAvailMarks
     3257                 then do:
     3258                    sw:start-element ("marks").
     3259                    vAvailMarks = yes.
     3260                 end.
     3261                 sw:start-element ("mark").
     3262                 if buf_parts.part-code > ""
     3263                 then
     3264                 write-data-element ("prt-id", buf_parts.part-code).
     3265                 write-data-element ("in-doc-id", buf_parts.in-code).
     3266                 write-data-element ("mark-code", repTegforDm( addBracketForCode(buf_marking-lines.mark))).
     3267                 sw:end-element ("mark").
     3268               end.
     3269             end.
     3270             else
     3271             if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_parts.obj-type, buf_parts.obj-code):GetIsArticForType(v-gds-attr-value-old)
     3272             then do :
     3273               if buf_trn-doc.ext-doc-type = 'ev':U
     3274               or buf_trn-doc.ext-doc-type = 'iv':U
     3275               then do:
     3276                 if num-entries(buf_parts.part-code, "_") = 2
     3277                 then do :
     3278                   vGtin = entry(1, buf_parts.part-code, "_") .
     3279                   if length(vGtin) = 8
     3280                   or length(vGtin) = 12
     3281                   or length(vGtin) = 13
     3282                   or length(vGtin) = 14
     3283                   then do :
     3284                     vQnty = integer(abs(buf_parts.fact-qnty)) .
     3285                     vDocQnty = integer(abs(buf_parts.qnty)) .
     3286                     if not vAvailMarks
     3287                     then do:
     3288                       sw:start-element ("marks").
     3289                       vAvailMarks = yes.
     3290                     end.
     3291                     sw:start-element ("mark").
     3292                     if buf_parts.part-code > ""
     3293                     then
     3294                     write-data-element ("prt-id", buf_parts.part-code).
     3295                     write-data-element ("in-doc-id", buf_parts.in-code).
     3296                     write-data-element ("gtin", vGtin) .
     3297                     if buf_trn-doc.ext-doc-type = 'iv':U
     3298                     then
     3299                       write-data-element ("gtin-qnt-ttn", string-mth(vDocQnty)) .
     3300                     write-data-element ("gtin-qnt", string-mth(vQnty)) .
     3301                     write-data-element ("upd-id", buf_parts.PS) .
     3302                     sw:end-element ("mark").
     3303                   end .
     3304                 end .
     3305               end .
     3306               if v-is-return
     3307               then do :
     3308                 for each buf_marking-lines no-lock where buf_marking-lines.doc-level = 1 and
     3309                   buf_marking-lines.gds-code = buf_goods.gds-code and
     3310                   buf_marking-lines.in-code = buf_parts.in-code and
     3311                   buf_marking-lines.obj-code = buf_parts.obj-code and
     3312                   buf_marking-lines.obj-type = buf_parts.obj-type and
     3313                   buf_marking-lines.out-code = buf_parts.out-code and
     3314                   buf_marking-lines.part-code = buf_parts.part-code and
     3315                   buf_marking-lines.prt-code = buf_parts.prt-code  :
     3316                   if buf_marking-lines.mark begins 'tech_':U
     3317                   and buf_trn-doc.ext-doc-type <> 'ev':U and buf_trn-doc.ext-doc-type <> 'iv':U
     3318                   then next .
     3319                   if buf_marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3320                   and buf_trn-doc.ext-doc-type = 'iv':U
     3321                   then next .
     3322                   if not vAvailMarks
     3323                   then do:
     3324                      sw:start-element ("marks").
     3325                      vAvailMarks = yes.
     3326                   end.
     3327                   sw:start-element ("mark").
     3328                   write-data-element ("in-doc-id", buf_parts.in-code).
     3329                   if buf_parts.part-code > ""
     3330                   then
     3331                   write-data-element ("prt-id", buf_parts.part-code).
     3332                   write-data-element ("mark-code", repTegforDm( addBracketForCode(buf_marking-lines.mark))).
     3333                   sw:end-element ("mark").
     3334                 end.
     3335               end .
     3336             end .
     3337           end.
     3338           if vAvailMarks
     3339           then
     3340             sw:end-element ("marks").
     3341         end .
     3342       end .
     3343     end.
     3344     method private void write-data-element (inTag as char, inValue as char):
     3345       if inValue = ?
     3346       then do:
     3347         Msg = substitute ('Предупреждение отладки: тег &1 иммет не определнное значение. Работа будет продолжена...', inTag).
     3348       end.
     3349       if inTag = ?
     3350       then do:
     3351         Msg = substitute ('Предупреждение отладки: Имя тега не может быть пустым...').
     3352         return.
     3353       end.
     3354       if inTag = "acc-ship"
     3355       then do:
     3356         if string (inValue) begins "."
     3357           then inValue = "0" + inValue.
     3358       end.
     3359       inTag = lc (InTag).
     3360       if inValue = ?
     3361         then
     3362         .
     3363         else sw:write-data-element (inTag, inValue).
     3364     end.
     3365     method private character string-mth (inValue as integer):
     3366       def var v-str as character no-undo.
     3367       if inValue = ?
     3368         then v-str = "0".
     3369         else v-str = string (inValue).
     3370       return v-str.
     3371     end.
     3372     method private character string-mth (inValue as decimal):
     3373       def var v-str as character no-undo.
     3374       if inValue = ?
     3375         then v-str = "0".
     3376       else
     3377         if string (inValue) begins "."
     3378           then v-str = "0" + string (inValue).
     3379           else v-str = string (inValue).
     3380       return v-str.
     3381     end.
