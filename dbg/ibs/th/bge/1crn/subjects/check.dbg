     3118               insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else  bf_chk-discnt.promo-id  ) .
     3119             end.
     3120             if bf_chk-discnt.templ-rl-root > 0 then  insw:write-data-element (  "discntGdsReason",       string(bf_chk-discnt.templ-rl-root)          ) .
     3121             insw:end-element ('chk-discnt':U) .
     3122           end.
     3123         end.
     3124         else
     3125         do:
     3126           assign
     3127             v-sum-promo = 0
     3128             v-pcnt-promo = 0
     3129             .
     3130           if buf_chk-discnt.record-type = 1 and
     3131              buf_chk-discnt.promo-id > "" then
     3132           do:
     3133               find first buf_chk-gds-attr no-lock
     3134                    where buf_chk-gds-attr.doc-code =  buf_chk-discnt.doc-code
     3135                      and buf_chk-gds-attr.line-num  =  buf_chk-discnt.line-num
     3136                      and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3137                  no-error.
     3138               if avail buf_chk-gds-attr then do:
     3139                   v-sum-promo = dec(buf_chk-gds-attr.attr-value).
     3140                   find first  buf_chk-gds no-lock
     3141                         where buf_chk-gds.doc-code = buf_chk-discnt.doc-code
     3142                           and buf_chk-gds.line-num = buf_chk-discnt.line-num
     3143                      no-error.
     3144                   if avail buf_chk-gds then
     3145                      v-pcnt-promo = 100 * ( 1 - (buf_chk-gds.sum-base / (buf_chk-gds.sum-base + v-sum-promo))).
     3146               end.
     3147           end.
     3148           if buf_chk-discnt.discnt-type = 999 and
     3149              buf_chk-discnt.record-type = 2 and
     3150              buf_chk-discnt.value-type = 2 and
     3151              buf_chk-discnt.line-num = 0 and
     3152              buf_chk-discnt.promo-id = ""
     3153              then do:
     3154              if not vflg0
     3155              then do:
     3156                v-discnt-value-abs = 0.
     3157                for each bf_chk-discnt no-lock
     3158                   where bf_chk-discnt.doc-code = buf_chk-discnt.doc-code
     3159                     and bf_chk-discnt.record-type = buf_chk-discnt.record-type
     3160                     and bf_chk-discnt.discnt-type = buf_chk-discnt.discnt-type
     3161                     and bf_chk-discnt.value-type = buf_chk-discnt.value-type
     3162                     and bf_chk-discnt.line-num = buf_chk-discnt.line-num
     3163                     :
     3164                     vflg0 = yes.
     3165                     v-discnt-value-abs = v-discnt-value-abs + bf_chk-discnt.discnt-value-abs.
     3166                end.
     3167                insw:start-element ('chk-discnt':U) .
     3168                insw:write-data-element (  "discnt-num",       string(buf_chk-discnt.discnt-id)          ) .
     3169                insw:write-data-element (  "line-num",         string(buf_chk-discnt.line-num)           ) .
     3170                insw:write-data-element (  "discnt-type",      string(buf_chk-discnt.value-type)        ) .
     3171                insw:write-data-element (  "discntValueAbs",   left-trim(string(v-discnt-value-abs,  "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3172                insw:write-data-element (  "discntValuePcnt",  left-trim(string(0, "->>>>9.9<"))                 ) .
     3173                if buf_chk-discnt.promo-id > "" then
     3174                do:
     3175                  find first PromoAction where PromoAction.id =  int(buf_chk-discnt.promo-id) no-lock no-error.
     3176                  insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else  buf_chk-discnt.promo-id  ) .
     3177                end.
     3178                if buf_chk-discnt.templ-rl-root > 0 then  insw:write-data-element (  "discntGdsReason",       string(buf_chk-discnt.templ-rl-root)          ) .
     3179                insw:end-element ('chk-discnt':U) .
     3180              end.
     3181           end.
     3182           else do:
     3183               insw:start-element ('chk-discnt':U) .
     3184               insw:write-data-element (  "discnt-num",       string(buf_chk-discnt.discnt-id)          ) .
     3185               insw:write-data-element (  "line-num",         string(buf_chk-discnt.line-num)           ) .
     3186               insw:write-data-element (  "discnt-type",      string(buf_chk-discnt.value-type)        ) .
     3187               insw:write-data-element (  "discntValueAbs",   left-trim(string(buf_chk-discnt.discnt-value-abs + v-sum-promo,  "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3188               insw:write-data-element (  "discntValuePcnt",  left-trim(string(buf_chk-discnt.discnt-value-pcnt + v-pcnt-promo, "->>>>9.9<"))                 ) .
     3189               if buf_chk-discnt.promo-id > "" then
     3190               do:
     3191                 find first PromoAction where PromoAction.id =  int(buf_chk-discnt.promo-id) no-lock no-error.
     3192                 insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else  buf_chk-discnt.promo-id  ) .
     3193               end.
     3194               if buf_chk-discnt.templ-rl-root > 0 then  insw:write-data-element (  "discntGdsReason",       string(buf_chk-discnt.templ-rl-root)          ) .
     3195               insw:end-element ('chk-discnt':U) .
     3196           end.
     3197         end.
     3198         if last-of(buf_chk-discnt.doc-code) then insw:end-element ('chk-discnts':U) .
     3199       end .
     3200       end .
     3201       if v-disc-promo-id <> 0 and
     3202          vflg-disc = no
     3203       then do:
     3204           insw:start-element ('chk-discnts':U) .
     3205           insw:start-element ('chk-discnt':U) .
     3206           insw:write-data-element (  "discnt-num",       "1"    ) .
     3207           insw:write-data-element (  "line-num",         string(v-line-num-promo)  ) .
     3208           insw:write-data-element (  "discnt-type",      "0"    ) .
     3209           insw:write-data-element (  "discntValueAbs",   "0.0"  ) .
     3210           insw:write-data-element (  "discntValuePcnt",  "0.0"  ) .
     3211           find first PromoAction where PromoAction.id =  v-disc-promo-id no-lock no-error.
     3212           insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else string(v-disc-promo-id)  ) .
     3213           insw:end-element ('chk-discnt':U) .
     3214           insw:end-element ('chk-discnts':U) .
     3215       end.
     3216       for each buf_chk-discnt no-lock
