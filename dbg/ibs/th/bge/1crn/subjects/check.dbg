     3041            insw:write-data-element (  "sbprrn",    string(buf_chk-pay-attr.attr-value)              ) .
     3042            end .
     3043         for first buf_chk-pay-attr no-lock
     3044              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     3045                and buf_chk-pay-attr.attr-code = "sbpstat":U
     3046                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num :
     3047            insw:write-data-element (  "sbpstat",    string(buf_chk-pay-attr.attr-value)              ) .
     3048            end .
     3049         insw:end-element ('chk-pay':U) .
     3050         if last-of(buf_chk-pay.doc-code) then insw:end-element ('chk-pays':U) .
     3051       end .
     3052       define variable vflg as logical no-undo.
     3053       define variable vflg0 as logical no-undo.
     3054       define variable v-discnt-value-abs as decimal no-undo.
     3055       define variable v-promocode-list as character no-undo.
     3056       define variable vflg-disc as logical no-undo.
     3057       assign
     3058          vflg  = no
     3059          vflg0 = no
     3060          v-discnt-value-abs = 0
     3061          v-promocode-list = ""
     3062          v-disc-promo-id = 0
     3063          vflg-disc = no
     3064          .
     3065       if p-buf_chk-doc.chk-type = integer('6':U)
     3066         and v-b-code <> 0
     3067         and not can-find(first buf_chk-discnt no-lock
     3068                          where buf_chk-discnt.doc-code    = p-buf_chk-doc.doc-code
     3069                            and buf_chk-discnt.record-type    = 5
     3070                            and buf_chk-discnt.promo-id <> "" )
     3071       then do:
