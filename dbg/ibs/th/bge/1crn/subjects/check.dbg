     2987         if buf_chk-pay.pay-card > "" then
     2988         insw:write-data-element (  "pay-card",  string(buf_chk-pay.pay-card)  ) .
     2989         for first buf_chk-pay-attr no-lock
     2990              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     2991                and buf_chk-pay-attr.attr-code = "cpdoc":U
     2992                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num :
     2993           insw:write-data-element (  "rrn",  buf_chk-pay-attr.attr-value  ) .
