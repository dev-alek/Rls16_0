     3234       break by buf_chk-discnt.doc-code by buf_chk-discnt.promo-id :
     3235         if first-of(buf_chk-discnt.doc-code) then insw:start-element ('chk-promos':U) .
     3236           insw:start-element ('chk-promo':U) .
     3237           find first PromoAction where PromoAction.id =  int(buf_chk-discnt.promo-id) no-lock no-error.
     3238               insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else  buf_chk-discnt.promo-id  ) .
     3239               insw:write-data-element (  "promotion-count",     left-trim(string(buf_chk-discnt.object-sum, "->>>>>>>>9.99"))   ) .
     3240          insw:end-element ('chk-promo':U) .
     3241         if last-of(buf_chk-discnt.doc-code) then insw:end-element ('chk-promos':U) .
     3242       end .
     3243      if v-disc-promo-id <> 0
     3244      then do:
     3245         insw:start-element ('chk-promos':U) .
     3246         insw:start-element ('chk-promo':U) .
