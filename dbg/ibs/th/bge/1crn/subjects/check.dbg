     3025         insw:write-data-element (  "sum",  left-trim(string(buf_chk-pay.tot-rubl, "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3026         if not v-ex-Nds then do:
     3027            find first buf_cash-pay-attr no-lock
     3028                 where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     3029                   and buf_cash-pay-attr.curr-code  = buf_chk-pay.curr-code
     3030                   and buf_cash-pay-attr.attr-code  = "cash-prop" no-error .
     3031            if available buf_cash-pay-attr then do :
     3032              v-is-nds = if can-do ("1,2,3,6,7", buf_cash-pay-attr.attr-value) then 1 else 0 .
     3033            end .
     3034            else v-is-nds = 0 .
     3035            insw:write-data-element (  "is-nds",    string(v-is-nds)              ) .
     3036         end.
     3037         for first buf_chk-pay-attr no-lock
     3038              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     3039                and buf_chk-pay-attr.attr-code = "sbprrn":U
