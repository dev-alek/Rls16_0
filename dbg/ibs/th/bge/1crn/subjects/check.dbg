     2971         insw:write-data-element ("trn-end",      iso-date(ttTranFuel.trn-end)).
     2972         insw:write-data-element ("trn-prnt",     string(ttTranFuel.trn-prnt)).
     2973         insw:write-data-element ("trn-prnt-trk", string(ttTranFuel.trn-prnt-trk)).
