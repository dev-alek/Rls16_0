     2995         for first buf_chk-pay-attr no-lock
     2996              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     2997                and buf_chk-pay-attr.attr-code = "RRN":U
     2998                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num :
     2999           insw:write-data-element (  "rrn",  buf_chk-pay-attr.attr-value  ) .
     3000         end.
     3001         for first buf_chk-pay-attr no-lock
     3002              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     3003                and buf_chk-pay-attr.attr-code = "RRN-VBRR":U
     3004                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num :
     3005           insw:write-data-element (  "rrn",  buf_chk-pay-attr.attr-value  ) .
