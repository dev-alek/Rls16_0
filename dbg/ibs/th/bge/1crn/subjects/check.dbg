     3014              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     3015                and buf_chk-pay-attr.attr-code = "CPWithdrawal":U
     3016                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num no-error.
     3017         if available buf_chk-pay-attr then
     3018         insw:write-data-element (  "cap-sum",  left-trim(string (dec(buf_chk-pay-attr.attr-value),">>>>>>>>>>>9.99") ) ) .
     3019         find first buf_chk-pay-attr no-lock
     3020              where buf_chk-pay-attr.doc-code  = buf_chk-pay.doc-code
     3021                and buf_chk-pay-attr.attr-code = "CPAgreement":U
     3022                and buf_chk-pay-attr.line-num  = buf_chk-pay.line-num no-error.
     3023         if available buf_chk-pay-attr then
