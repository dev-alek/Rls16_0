     3248         insw:write-data-element (  "promotion-code", if available PromoAction and PromoAction.ext-code > '' then PromoAction.ext-code else  string(v-disc-promo-id)  ) .
     3249         insw:write-data-element (  "promotion-count",     left-trim(string(v-disc-promo-count, "->>>>>>>>9.99"))   ) .
     3250         insw:end-element ('chk-promo':U) .
     3251         insw:end-element ('chk-promos':U) .
     3252      end.
     3253       for each buf_chk-gds-pay no-lock
     3254          where buf_chk-gds-pay.doc-code = p-buf_chk-doc.doc-code
     3255       break by buf_chk-gds-pay.doc-code :
     3256         if first-of(buf_chk-gds-pay.doc-code) then insw:start-element ('chk-pays-r':U) .
     3257         insw:start-element ('chk-pay-r':U) .
     3258         insw:write-data-element (  "pay-code",  string(buf_chk-gds-pay.pay-code)    ) .
     3259         insw:write-data-element (  "line-num",  string(buf_chk-gds-pay.line-num)    ) .
     3260         insw:write-data-element (  "pay-num",   string(buf_chk-gds-pay.cpline-num)  ) .
