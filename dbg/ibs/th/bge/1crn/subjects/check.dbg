        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.enum-chk-type.
        3   using ibs.th.bge.1crn.subjects.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.check implements iexpsubject:
        6   define public var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        7   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        8   define variable vss-include-info1 as character format "X(65)" no-undo
        9   initial "@(#)$Workfile$ $Revision$".
       10   method private void xmlchar-test (input  p-in-string          as character,
       11                                     output p-out-string-enc     as character,
       12                                     output p-out-string-dec    as character):
       13   do
       14   on error undo, return error
       15   :
       16          xmlchar-encode
       17       (
       18             input p-in-string
       19           , output p-out-string-enc
       20       ).
       21          xmlchar-decode
       22       (
       23             input p-out-string-enc
       24           , output p-out-string-dec
       25       ).
       26   end.
       27   end .
       28   method private void xmlchar-encode (input  p-in-string          as character,
       29                                     output p-out-string         as character):
       30       define variable v-position      as integer      no-undo.
       31       define variable v-current-char  as character    no-undo.
       32   do
       33   on error undo, return error
       34   :
       35       assign
       36           p-out-string = "":U
       37       .
       38       case p-in-string
       39       :
       40           when ?
       41           then do:
       42               assign
       43                   p-out-string = "?":U
       44               .
       45           end.
       46           when "?":U
       47           then do:
       48               assign
       49                   p-out-string = "&#63;":U
       50               .
       51           end.
       52           otherwise do:
       53               do v-position = 1 to length( p-in-string )
       54               :
       55                   assign
       56                       v-current-char = substring( p-in-string, v-position, 1 )
       57                   .
       58                   case v-current-char
       59                   :
       60                       when "&":U
       61                       then do:
       62                           assign
       63                               p-out-string = p-out-string + "&amp;":U
       64                           .
       65                       end.
       66                       when ">":U
       67                       then do:
       68                           assign
       69                               p-out-string = p-out-string + "&gt;":U
       70                           .
       71                       end.
       72                       when "<":U
       73                       then do:
       74                           assign
       75                               p-out-string = p-out-string + "&lt;":U
       76                           .
       77                       end.
       78                       when "'":U
       79                       then do:
       80                           assign
       81                               p-out-string = p-out-string + "&apos;":U
       82                           .
       83                       end.
       84                       when '"':U
       85                       then do:
       86                           assign
       87                               p-out-string = p-out-string + "&quot;":U
       88                           .
       89                       end.
       90                       when chr(1)
       91                       then do:
       92                           assign
       93                               p-out-string = p-out-string + "":U
       94                           .
       95                       end.
       96                       when chr(2)
       97                       then do:
       98                           assign
       99                               p-out-string = p-out-string + "":U
      100                           .
      101                       end.
      102                       when chr(3)
      103                       then do:
      104                           assign
      105                               p-out-string = p-out-string + "":U
      106                           .
      107                       end.
      108                       when chr(4)
      109                       then do:
      110                           assign
      111                               p-out-string = p-out-string + "":U
      112                           .
      113                       end.
      114                       when chr(5)
      115                       then do:
      116                           assign
      117                               p-out-string = p-out-string + "":U
      118                           .
      119                       end.
      120                       when chr(6)
      121                       then do:
      122                           assign
      123                               p-out-string = p-out-string + "":U
      124                           .
      125                       end.
      126                       when chr(7)
      127                       then do:
      128                           assign
      129                               p-out-string = p-out-string + "":U
      130                           .
      131                       end.
      132                       when chr(8)
      133                       then do:
      134                           assign
      135                               p-out-string = p-out-string + "":U
      136                           .
      137                       end.
      138                       when chr(9)
      139                       then do:
      140                           assign
      141                               p-out-string = p-out-string + "":U
      142                           .
      143                       end.
      144                       when chr(29)
      145                       then do:
      146                           assign
      147                               p-out-string = p-out-string + "":U
      148                           .
      149                       end.
      150                       when chr(10)
      151                       then do:
      152                           assign
      153                               p-out-string = p-out-string + "&#10;":U
      154                           .
      155                       end.
      156                       when chr(13)
      157                       then do:
      158                           assign
      159                               p-out-string = p-out-string + "&#13;":U
      160                           .
      161                       end.
      162                       otherwise do:
      163                           assign
      164                               p-out-string = p-out-string + v-current-char
      165                           .
      166                       end.
      167                   end case.
      168               end.
      169           end.
      170       end case.
      171   end.
      172   end .
      173   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      174   define variable p-out-string as character no-undo.
      175       define variable v-position      as integer      no-undo.
      176       define variable v-current-char  as character    no-undo.
      177   do
      178   on error undo, return error
      179   :
      180       assign
      181           p-out-string = "":U
      182       .
      183       case p-in-string
      184       :
      185           when ?
      186           then do:
      187               assign
      188                   p-out-string = "?":U
      189               .
      190           end.
      191           otherwise do:
      192               do v-position = 1 to length( p-in-string )
      193               :
      194                   assign
      195                       v-current-char = substring( p-in-string, v-position, 1 )
      196                   .
      197                   case v-current-char
      198                   :
      199                       when chr(1)
      200                       then do:
      201                           assign
      202                               p-out-string = p-out-string + " ":U
      203                           .
      204                       end.
      205                       when chr(2)
      206                       then do:
      207                           assign
      208                               p-out-string = p-out-string + " ":U
      209                           .
      210                       end.
      211                       when chr(3)
      212                       then do:
      213                           assign
      214                               p-out-string = p-out-string + " ":U
      215                           .
      216                       end.
      217                       when chr(4)
      218                       then do:
      219                           assign
      220                               p-out-string = p-out-string + " ":U
      221                           .
      222                       end.
      223                       when chr(5)
      224                       then do:
      225                           assign
      226                               p-out-string = p-out-string + " ":U
      227                           .
      228                       end.
      229                       when chr(6)
      230                       then do:
      231                           assign
      232                               p-out-string = p-out-string + " ":U
      233                           .
      234                       end.
      235                       when chr(7)
      236                       then do:
      237                           assign
      238                               p-out-string = p-out-string + " ":U
      239                           .
      240                       end.
      241                       when chr(8)
      242                       then do:
      243                           assign
      244                               p-out-string = p-out-string + " ":U
      245                           .
      246                       end.
      247                       when chr(9)
      248                       then do:
      249                           assign
      250                               p-out-string = p-out-string + " ":U
      251                           .
      252                       end.
      253                       when chr(29)
      254                       then do:
      255                           assign
      256                               p-out-string = p-out-string + " ":U
      257                           .
      258                       end.
      259                       when chr(10)
      260                       then do:
      261                           assign
      262                               p-out-string = p-out-string + " ":U
      263                           .
      264                       end.
      265                       when chr(13)
      266                       then do:
      267                           assign
      268                               p-out-string = p-out-string + " ":U
      269                           .
      270                       end.
      271                       otherwise do:
      272                           assign
      273                               p-out-string = p-out-string + v-current-char
      274                           .
      275                       end.
      276                   end case.
      277               end.
      278           end.
      279       end case.
      280   end.
      281   return p-out-string.
      282   end .
      283   method private void xmlchar-decode (input  p-in-string          as character,
      284                                     output p-out-string         as character):
      285       define variable v-position      as integer      no-undo.
      286       define variable v-last-position as integer      no-undo.
      287       define variable v-temp-integer  as integer      no-undo.
      288       define variable v-current-char  as character    no-undo.
      289       define variable v-next-char     as character    no-undo.
      290       define variable v-success       as logical      no-undo.
      291   do
      292   on error undo, return error
      293   :
      294       assign
      295           p-out-string = "":U
      296           v-position   = 0
      297       .
      298       replace-cycle:
      299       do while yes
      300       on error undo, return error
      301       :
      302           assign
      303               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      304           .
      305           if v-last-position <= v-position
      306           then do:
      307               if v-position = 0
      308               then do:
      309                   assign
      310                       p-out-string = p-in-string
      311                   .
      312               end.
      313               else do:
      314                   assign
      315                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      316                   .
      317               end.
      318               leave replace-cycle.
      319           end.
      320           else do:
      321               assign
      322                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      323                   v-position      = v-last-position
      324                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      325               .
      326               if v-current-char = "#":U
      327               then do:
      328                   assign
      329                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      330                   .
      331                   if v-last-position > 0
      332                   then do:
      333                       xmlchar-read-integer
      334                        (
      335                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      336                           , output v-temp-integer
      337                           , output v-success
      338                       ).
      339                       if v-success = yes
      340                       and v-temp-integer >= 1
      341                       and v-temp-integer <= 255
      342                       then do:
      343                           assign
      344                               p-out-string = p-out-string + chr( v-temp-integer )
      345                               v-position   = v-last-position + 1
      346                           .
      347                       end.
      348                       else do:
      349                           assign
      350                               p-out-string = p-out-string + "&":U
      351                               v-position   = v-position   + 1
      352                           .
      353                       end.
      354                   end.
      355                   else do:
      356                       assign
      357                           p-out-string = p-out-string + "&":U
      358                           v-position   = v-position   + 1
      359                       .
      360                   end.
      361               end.
      362               else do:
      363                   case substring( p-in-string, v-position + 1, 3 )
      364                   :
      365                       when "lt;":U
      366                       then do:
      367                           assign
      368                               p-out-string = p-out-string + "<":U
      369                               v-position   = v-position   + 3
      370                           .
      371                       end.
      372                       when "gt;":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + ">":U
      376                               v-position   = v-position   + 3
      377                           .
      378                       end.
      379                       otherwise do:
      380                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      381                           then do:
      382                               assign
      383                                   p-out-string = p-out-string + "&":U
      384                                   v-position   = v-position   + 4
      385                               .
      386                           end.
      387                           else do:
      388                               case substring( p-in-string, v-position + 1, 5 )
      389                               :
      390                                   when "quot;":U
      391                                   then do:
      392                                       assign
      393                                           p-out-string = p-out-string + '"':U
      394                                           v-position   = v-position   + 5
      395                                       .
      396                                   end.
      397                                   when "apos;":U
      398                                   then do:
      399                                       assign
      400                                           p-out-string = p-out-string + "'":U
      401                                           v-position   = v-position   + 5
      402                                       .
      403                                   end.
      404                                   otherwise do:
      405                                       assign
      406                                           p-out-string = p-out-string + "&":U
      407                                       .
      408                                   end.
      409                               end case.
      410                           end.
      411                       end.
      412                   end case.
      413               end.
      414           end.
      415       end.
      416   end.
      417   end .
      418   method private void xmlchar-read-integer (input  p-input-string       as character,
      419                                             output p-output-integer     as integer,
      420                                             output p-success            as logical):
      421   do
      422   on error undo, return error
      423   :
      424       assign
      425           p-output-integer = integer( p-input-string )
      426       no-error.
      427       if error-status :error
      428       then do:
      429           assign
      430               p-success           = no
      431               p-output-integer    = 0
      432           .
      433       end.
      434       else do:
      435           assign
      436               p-success           = yes
      437           .
      438       end.
      439   end.
      440   end.
      441   method private void getAttrLib ():
      442      define variable g#attr-lib  as handle no-undo .
      443      run gbl/getgattrlib.p (output g#attr-lib).
      444   end.
      445   define variable mMRCCode  as logical    no-undo.
      446   define variable mTypeMark as character  no-undo.
      447   method private logical IS-NeedMark
      448   ( input ib-code as integer  ,
      449     input ib-str as character ):
      450      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      451      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      452                                    and buf_prod-bc-attr.b-str  eq ib-str
      453                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      454        no-lock no-error.
      455      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      456   end.
      457   method private character repTegforDm
      458   (iDM as char ):
      459       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      460       define variable vteg as character no-undo.
      461       define variable oDM as character no-undo.
      462       define variable vi as integer no-undo.
      463       oDM = iDm.
      464       do vi = 1 to num-entries(vTeglist):
      465          vTeg = entry(vi,vTeglist).
      466          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      467       end.
      468       return oDM.
      469   end.
      470   method private character repSpecSimbforDm
      471   (iDM as char ):
      472       define variable oDM as character no-undo.
      473       xmlchar-decode(iDM, output oDM).
      474     return repTegforDm (oDM).
      475   end.
      476   method private logical CheckGtin
      477   (iGtin as char):
      478      define variable bar_code as character no-undo.
      479      define variable vGtin as logical no-undo init "yes".
      480      if length(iGtin) eq 14
      481      then do:
      482         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      483         run str/chk-sum.p
      484          (input-output bar_code ) no-error .
      485         if iGtin ne  bar_code
      486         then
      487            vGtin = no.
      488      end.
      489      else
      490         vGtin = no.
      491      return vgtin.
      492   end.
      493   method private character repSpecSimbforXlm
      494   (iDM as char ):
      495       iDM = replace(iDM,chr(29),"").
      496       return iDM.
      497   end.
      498   method private character getGtinByDM
      499   (IDM as char):
      500      define variable VTXT as char no-undo.
      501      define variable vGtin as char no-undo.
      502      vTXt = IdM.
      503      vGtin = IDM.
      504      if    length(vtxt) > 14
      505      then do:
      506         if   vtxt begins "(01)"
      507                or vtxt begins "(02)"
      508         then
      509            vGtin = substring(vtxt,5,14).
      510         else if   (vtxt begins "01"
      511                or vtxt begins "02" )
      512                and (   (    substring(iDm,17,2) eq "21"
      513                         and length(vtxt) >= 21)
      514                     or substring(iDm,17,2) eq "37"
      515                     or substring(iDm,17,4) eq "(37)" )
      516         then do:
      517            vGtin = substring(vtxt,3,14).
      518            if not checkGtin(vGtin)
      519            then
      520               vGtin = substring(vtxt,1,14).
      521         end.
      522         else if     length(vtxt) eq 14 + 7 + 4 + 4
      523             or length(vtxt) eq 14 + 7 + 4
      524             or length(vtxt) eq 14 + 7
      525         then
      526            vGtin = substring(vtxt,1,14).
      527      end.
      528      if not checkGtin(vGtin)
      529      then
      530         vGtin = "".
      531      return vgtin.
      532   end.
      533   method private integer getGdsCodeByGtin
      534   (iGtin as char):
      535      define buffer prod-bc  for ub.prod-bc.
      536      define buffer bar-code for ub.bar-code.
      537      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      538      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      539      return if avail bar-code then bar-code.gds-code else ?.
      540   end.
      541   method private decimal getQntyCodeByGtin
      542   (iGtin as char):
      543      define buffer prod-bc  for ub.prod-bc.
      544      define buffer bar-code for ub.bar-code.
      545      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      546      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      547      return if avail bar-code then bar-code.cli-base-rate else ?.
      548   end.
      549   method private integer getGdsCodeByDM
      550   (iDm as char):
      551      define variable vGtin as char no-undo.
      552      define buffer prod-bc for ub.prod-bc.
      553      vGtin  = getGtinByDM (IDM ).
      554      return getGdsCodeByGtin (vGtin).
      555   end.
      556   method private logical ChekTypeMarkByGds
      557   (iGds-code as integer ):
      558      define buffer goods-attr for ub.goods-attr.
      559      find first goods-attr where goods-attr.gds-code   = iGds-code
      560                              and goods-attr.attr-code  = 'mark-type':U
      561      no-lock no-error.
      562      if available goods-attr
      563      then do:
      564         mTypeMark = goods-attr.attr-value.
      565         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      566           .
      567      end.
      568      else
      569         return no.
      570   end.
      571   method private logical ChekTypeMarkByDm
      572   (iDM as char ):
      573      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      574   end.
      575   method private logical ChekTypeMarkByGtin
      576   (iGtin as char ):
      577      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      578   end.
      579   method private character  GetNextElement
      580     (input iAllTeg        as logical
      581     ,output oteg          as character
      582     ,output otegval       as character
      583     ,input-output pstr    as character
      584      ):
      585        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      586        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      587        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      588        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      589        define variable vTeg as character no-undo.
      590        define variable vLength as integer no-undo.
      591        define variable vi as integer no-undo.
      592        define variable vj as integer no-undo.
      593        define buffer code for ub.code.
      594        find first code where Code.parent eq "MarkType"
      595                          and Code.CodeValue   eq mTypeMark
      596                          no-lock no-error.
      597        if     available code
      598           and Code.misc1 ne ""
      599           and Code.misc1 ne ?
      600        then do:
      601           integer (Code.misc1) no-error.
      602           if not error-status:error
      603           then
      604             entry (4,vlistleng) = Code.misc1.
      605        end.
      606        if iAllTeg
      607        then
      608           assign
      609              vlistElem     = vlistElem    + vlistElemDop
      610              vlistleng     = vlistleng    + vlistlengDop
      611           .
      612        else if mMRCCode
      613        then
      614           assign
      615              vlistElem     = vlistElem    + ",(8005),8005"
      616              vlistleng     = vlistleng    + ",000006,0006"
      617           .
      618       block-elem:
      619       do vi = 1 to num-entries(vlistElem):
      620          vTeg = entry(vi,vlistElem).
      621          if pstr begins vTeg
      622          then do:
      623             if    vTeg eq "21"
      624             then
      625                vLength = index(pstr,chr(29)) - 2 no-error.
      626             if vLength  <= 0
      627             then
      628                vLength = int(entry(vi,vlistleng)).
      629             otegval = substring (pstr,length(vteg) + 1, vLength).
      630             oteg = replace(replace(vteg,")",""),"(","").
      631             vTeg = vteg + otegval.
      632             otegval = replace(otegval,chr(29),"").
      633             oteg = replace(replace(oteg,")",""),"(","").
      634             pstr = substring (pstr,length(vTeg)+ 1).
      635             vTeg = replace(vTeg,chr(29),"").
      636             leave block-elem.
      637          end.
      638          else
      639             vTeg = "".
      640       end.
      641       return vteg.
      642   end.
      643   method private character  GetCodeIdent
      644   (iDm as char):
      645      define variable Velement   as character no-undo init "first".
      646      define variable oCodeIdent as character no-undo.
      647      define variable vteg as character no-undo.
      648      define variable vtegval as character no-undo.
      649      define variable vGtin as character no-undo.
      650      define buffer marking for ub.marking.
      651      for first marking no-lock where
      652                marking.mark eq iDm
      653            and marking.unit-ext = "LEVEL2"
      654      :
      655        return iDm.
      656      end.
      657      vGtin  = getGtinByDM (iDm ).
      658      ChekTypeMarkByDm(idm).
      659      if iDm begins 'tech_':U
      660      then
      661         oCodeIdent = iDm.
      662      else if length(iDm) < 21
      663      then do:
      664         find first marking where marking.mark eq idm
      665         no-lock no-error.
      666         oCodeIdent = if available marking then marking.mark else  ?.
      667      end.
      668      else if     length(iDm) eq 29
      669         and not iDm begins "01"
      670         and not iDm begins "02"
      671      then
      672         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      673      else  if     length(iDm) >= 24
      674               and (  iDm begins "01"
      675                   or iDm begins "02")
      676               and  substring(iDm,17,2) ne "21"
      677      then do:
      678         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      679                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      680         then
      681            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      682         else
      683            oCodeIdent = iDM.
      684      end.
      685      else  if     (   length(iDm) eq 25
      686                    or length(iDm) eq 21)
      687               and (not iDm begins "01"
      688               and  not iDm begins "02")
      689      then
      690         oCodeIdent = substring(iDm,1,21).
      691      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      692      then
      693         oCodeIdent = substring(iDm,1,21).
      694      else do while Velement ne "" and idm ne "":
      695         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      696         oCodeIdent = oCodeIdent + Velement.
      697      end.
      698      return oCodeIdent.
      699   end.
      700   method private character  GetTegCod
      701   (icodeIdent as char, iTeg as char):
      702      define variable Velement   as character no-undo init "first".
      703      define variable oTeg as character no-undo init ?.
      704      define variable vteg as character no-undo.
      705      define variable vtegval as character no-undo.
      706      if     ((length(icodeIdent) eq 21
      707         and not icodeIdent begins "01"
      708         and not icodeIdent begins "02")
      709         or
      710             ( length(icodeIdent) eq 25
      711               and not icodeIdent begins "01"
      712               and not icodeIdent begins "02"))
      713      then do:
      714         if iTeg eq "01" or iTeg eq "02"
      715         then
      716            oTeg = substring(icodeIdent,1,21).
      717         else  if  iTeg eq "21"
      718         then
      719            oTeg = substring(icodeIdent,15,7).
      720      end.
      721      else do:
      722         ChekTypeMarkByDm(icodeIdent).
      723         block-teg:
      724            do while Velement ne "" and icodeIdent ne "":
      725            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      726            if    Velement begins iTeg
      727               or Velement begins "(" + iTeg + ")"
      728            then do:
      729               oTeg = vtegval.
      730               leave block-teg.
      731            end.
      732         end.
      733      end.
      734      return oTeg.
      735   end.
      736   method private logical isOAD
      737   (icodeIdent as character):
      738      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      739   end.
      740   method private logical isMark
      741   (icodeIdent as character):
      742      define buffer buf_marking for ub.marking.
      743      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      744             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      745   end.
      746   method private character  addBracketForCode
      747   (icodeIdent as char):
      748      define variable Velement   as character no-undo init "first".
      749      define variable oTeg as character no-undo.
      750      define variable vteg as character no-undo.
      751      define variable vtegval as character no-undo.
      752      define buffer marking for ub.marking.
      753      find first marking no-lock where
      754                 marking.mark begins icodeIdent no-error.
      755      if    not ChekTypeMarkByDm(icodeIdent)
      756         or length(icodeIdent) le 24
      757         or (avail marking and marking.unit-ext = "LEVEL2")
      758      then
      759         oTeg = icodeIdent.
      760      else do:
      761         if (  icodeIdent begins "01"
      762            or icodeIdent begins "02"
      763            ) and CheckGtin(substring (icodeIdent,3,14))
      764            and substring (icodeIdent,17,2) eq "21"
      765         then do:
      766            mMRCCode = yes.
      767            ChekTypeMarkByDm(icodeIdent).
      768            block-teg:
      769            do while Velement ne "" and icodeIdent ne "":
      770               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      771               if vteg ne ""
      772               then
      773                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      774            end.
      775            mMRCCode = no.
      776         end.
      777         else do:
      778            oTeg = icodeIdent.
      779         end.
      780      end.
      781      return oTeg.
      782   end.
      783   method private integer getlevelByCodId
      784   (iCode as char):
      785      define variable vLength as int no-undo.
      786      define variable vLevel  as int no-undo.
      787      if not ChekTypeMarkByDM (icode) then return ?.
      788      vLength = length(iCode).
      789      if    vLength eq 18
      790         or vLength eq 20
      791      then
      792         Vlevel = 4.
      793      else if vLength eq 21
      794      then
      795         Vlevel = 1.
      796      else if vLength eq 25
      797      then do:
      798         if  iCode begins "01"
      799         then
      800            Vlevel = 3.
      801         else
      802            Vlevel = 1.
      803      end.
      804      else if     vLength >= 26
      805              and vLength <= 46
      806      then do:
      807         if    substring(iCode,17,2) eq "11"
      808            or substring(iCode,17,2) eq "13"
      809            or (    substring(iCode,17,2) eq "21"
      810                and vLength >= 33
      811                and substring(iCode,26,4) ne "8005")
      812         then
      813            Vlevel = 4.
      814         else if    vLength eq 31
      815                 or vLength eq 38
      816                 or vLength eq 39
      817                 or vLength eq 45
      818         then
      819            Vlevel = 1.
      820         else if    vLength eq 35
      821                 or vLength eq 43
      822         then
      823            Vlevel = 3.
      824         else
      825            Vlevel = ?.
      826      end.
      827      else
      828         Vlevel = ?.
      829      return Vlevel.
      830   end.
      831   method private character  getLevelMotpBycodid
      832   (iDm as char):
      833      define variable vLevel as integer no-undo.
      834      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      835      vLevel = getlevelByCodId(iDm).
      836      if    vLevel eq ?
      837         or vLevel < 1
      838         or vLevel > 6
      839      then
      840         return ?.
      841      else
      842         return entry(vlevel,vList).
      843   end.
      844   method private character    getLevelUTDByLevelMotp
      845   (iUnit as char):
      846      define variable vLevel as integer no-undo.
      847      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      848      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      849      vLevel = lookup(iUnit,vListMOTP).
      850      if    vLevel eq ?
      851         or vLevel < 1
      852         or vLevel > 4
      853      then
      854         return ?.
      855      else
      856         return entry(vlevel,vListutd).
      857   end.
      858   method private character  getLevelMotpByDM
      859   (iDm as char):
      860      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      861   end.
      862   method private character  getLevelUTDByCodId
      863   (iDm as char):
      864      define variable vLevel as integer no-undo.
      865      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      866      vLevel = getlevelByCodId(iDm).
      867      if    vLevel eq ?
      868         or vLevel < 1
      869         or vLevel > 4
      870      then
      871         return ?.
      872      else
      873         return entry(vlevel,vList).
      874   end.
      875   method private character  getLevelUTDByDM
      876   (iDm as char):
      877      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      878   end.
      879   define variable mNotMarkQnty as logical no-undo.
      880   method private decimal getQntyUTDByCodId
      881   (iDM as char):
      882      define variable vLevel as integer no-undo.
      883      define variable vList as character no-undo init "1,5,10,500".
      884      define variable vGtin as character no-undo.
      885      define variable vqnty as decimal no-undo init ?.
      886      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      887      if vqnty eq ?
      888      then do:
      889         if not mNotMarkQnty
      890         then do:
      891            define buffer marking for ub.marking.
      892            define variable vCodident as character no-undo.
      893            vCodident = GetCodeIdent(idm).
      894            find first marking where marking.mark begins vCodident no-lock no-error.
      895            if     available marking
      896               and marking.box-qnty ne ?
      897            then
      898               return marking.box-qnty.
      899         end.
      900         vGtin = getGtinByDm(iDM).
      901         if ChekTypeMarkByGtin (vGtin)
      902         then do:
      903            vLevel = getlevelByCodId(iDM).
      904            if     vLevel >= 1
      905               and vLevel <= 4
      906            then
      907               vqnty = int(entry(vlevel,vList)).
      908         end.
      909         else
      910            vqnty = getQntyCodeByGtin(vgtin).
      911      end.
      912      return vqnty.
      913   end.
      914   method private decimal getQntyUTDByDM
      915   (iDm as char):
      916      define variable vDM as character no-undo.
      917      if     length (iDm) ne 25
      918         and length (iDm) ne 29
      919         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      920      then
      921         vDM = substring (iDm,1,length (iDm) - 6 ).
      922      else
      923         vDM = substring (iDm,1,length (iDm) - 4 ).
      924      return getQntyUTDByCodId(vDM).
      925   end.
      926   method private decimal    getMRC4
      927   (iMRC as char):
      928      define variable oMrc     as decimal no-undo init ?.
      929      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      930      define variable vi       as integer no-undo.
      931      define variable vfound   as integer no-undo.
      932      define variable vposStart   as integer no-undo.
      933      do:
      934      OMRc = 0.
      935      do vi = 1 to 4:
      936         define variable vsimb as character no-undo.
      937         vsimb = substring(iMRC,vi,1).
      938         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      939         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      940         if vfound > 0
      941         then
      942            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      943         end.
      944         OMRc = OMRc / 100.
      945      end.
      946      return OMRc.
      947   end.
      948   method private decimal    getMRCByDM
      949   (iDm as char):
      950      define variable vMRC     as character no-undo.
      951      define variable oMrc     as decimal no-undo init ?.
      952      define variable Velement as character no-undo init "empty".
      953      define variable vteg as character no-undo.
      954      define variable vtegval as character no-undo.
      955      if    length(idm) eq 14 + 7 + 4 + 4
      956         or length(idm) eq 14 + 7 + 4
      957      then do:
      958         vMRC = substring(idm,22,4).
      959         omrc = getMRC4(vMRC).
      960      end.
      961      else do:
      962          ChekTypeMarkByDm(iDm).
      963          block-mrc:
      964          do while Velement ne "" and idm ne "":
      965             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      966             if Velement begins "8005"
      967             then do:
      968                vMRC = substring(Velement,5,6).
      969                leave block-mrc.
      970             end.
      971             else if Velement begins "(8005)"
      972             then do:
      973                vMRC = substring(Velement,7,6).
      974                leave block-mrc.
      975             end.
      976          end.
      977          if vMRC ne ""
      978          then
      979             OMRc = dec(vmrc) / 100 no-error.
      980      end.
      981      return OMRc.
      982   end.
      983   method private date    MoveDate
      984   (idate as date,
      985    iMonth as int64):
      986      define variable vMonth   as int64 no-undo.
      987      define variable vYear    as int64 no-undo.
      988      define variable vDateNew as date  no-undo.
      989       define variable vDay     as int64 no-undo.
      990       vMonth = month(iDate) + iMonth.
      991       vYear =  year(iDate).
      992       if vMonth <= 0
      993       then assign
      994          vMonth = vMonth + 12
      995           vYear  = vYear - 1
      996       .
      997       else if vMonth > 12
      998       then assign
      999          vMonth = vMonth - 12
     1000           vYear  = vYear + 1
     1001       .
     1002       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1003       do while error-status:error eq yes:
     1004          VDay = vDay + 1.
     1005          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1006       end.
     1007       if VDay > 0
     1008       then
     1009          vDateNew + 1.
     1010       return vDateNew.
     1011   end.
     1012   method private logical    checkEMRC
     1013   (input  iDm as char,
     1014    output vOk as logical):
     1015      define variable v-value-emrc as character no-undo.
     1016      define variable v-type-emrc  as character no-undo.
     1017      define variable vDateIso     as character no-undo.
     1018      define variable vMRC         as decimal no-undo.
     1019      define variable vqnty        as decimal no-undo.
     1020      define variable vPrice       as decimal no-undo.
     1021      define variable vparent      as character no-undo.
     1022      define variable vgds-code    as integer no-undo.
     1023      define buffer code for ub.code.
     1024      vMRC = getMRCByDM(iDm).
     1025      if vMRC > 0
     1026      then do:
     1027         vgds-code = getGdsCodeByDM(iDm).
     1028         vqnty     = getQntyUTDByDM(iDm).
     1029               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1030            (
     1031             input   vgds-code
     1032            ,input   'emrc-type':U
     1033            ,output   v-value-emrc
     1034            ,output   v-type-emrc
     1035          ) no-error.
     1036          if     v-value-emrc ne ""
     1037             and v-value-emrc ne ?
     1038          then do:
     1039             vDateIso = iso-date(today).
     1040             vPrice = vMRC / vqnty.
     1041             vparent ="emc" + chr(4) + v-value-emrc.
     1042             find last code where Code.parent      eq vparent
     1043                              and Code.code        le vDateIso
     1044                              and code.status_  eq 0
     1045             no-lock no-error.
     1046             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1047             then
     1048                vOk = true .
     1049             else do:
     1050                 define variable vText      as character no-undo.
     1051                 define variable vDate      as date no-undo.
     1052                 define variable vDateLast  as character no-undo.
     1053                 define variable vDateFirst as character no-undo.
     1054                 define variable vDate3     as date no-undo.
     1055                 vdate = date(code.misc1).
     1056                 vDateLast = code.misc1.
     1057                 vDate3 = MoveDate(today, - 3 ).
     1058                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1059                                      string(vDate3  , "99/99/9999"),
     1060                                      string(vDate   , "99/99/9999")
     1061                                      ).
     1062                 vdateIso = iso-date(vdate3).
     1063                 find last code  where Code.parent      eq vparent
     1064                                   and Code.code        le vDateIso
     1065                                   and code.status_  eq 0 no-lock no-error.
     1066                 if available code
     1067                 then
     1068                    vDateIso = code.code.
     1069                 vDateFirst = vDateIso.
     1070                 vDateLast = iso-date(vdate).
     1071                 define variable vGood as logical no-undo.
     1072                 define variable vDateSale as date no-undo.
     1073                 define buffer bcode for code.
     1074                 for last code where Code.parent   eq vparent
     1075                                 and code.status_  eq 0
     1076                                 and code.code     < vDateLast
     1077                                 and code.code     >= vDateFirst
     1078                 no-lock:
     1079                    find first bcode where bCode.parent   eq vparent
     1080                                       and bcode.status_  eq 0
     1081                                       and bcode.code     > code.code no-lock no-error.
     1082                    if available bcode
     1083                    then do:
     1084                       if vPrice < dec(Code.CodeValue)
     1085                       then
     1086                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1087                                                     chr(10),
     1088                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1089                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1090                                                     ).
     1091                       else do:
     1092                          vGood = yes.
     1093                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1094                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1095                                                     chr(10),
     1096                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1097                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1098                                                     string(         vDateSale            ,"99/99/9999"),
     1099                                                     string(vDateSale - today)
     1100                                                     ).
     1101                       end.
     1102                    end.
     1103                 end.
     1104                 if vgood
     1105                 then do:
     1106                    define variable choice as integer no-undo .
     1107                    run gbl/d-askw.w (input "Уточнение"
     1108                           ,input  vText
     1109                           ,input "|"
     1110                           ,input "Принять|Вернуть"
     1111                           ,input "Принять данный товар|Вернуть товар постащику"
     1112                           ,input 1
     1113                           ,input 2
     1114                           ,output choice) no-error.
     1115                    vok = choice eq 1.
     1116                 end.
     1117                 else
     1118                    vok =false.
     1119             end.
     1120          end.
     1121      end.
     1122   end.
     1123   method private character addGs2Mark
     1124   (iMark as char):
     1125      define variable vDM   as character no-undo.
     1126      define variable vIdx  as integer   no-undo.
     1127      if index(iMark,chr(29),1) > 0
     1128      then return iMark.
     1129      if substring(iMark,26,4) = "8005" then
     1130      do:
     1131        vIdx = index(iMark,"93",26 + 4 + 5).
     1132        if vIdx > 1 then do:
     1133          vDM = substitute("&1&4&2&4&3",
     1134                           substring(iMark,1,25),
     1135                           substring(iMark,26,vIdx - 25 - 1),
     1136                           substring(iMark,vIdx),
     1137                           chr(29)) no-error.
     1138          vIdx = index(vDm,"240",vIdx + 4).
     1139          if vIdx > 0 then
     1140          do:
     1141            vDM = substitute("&1&3&2",
     1142                             substring(vDm,1,vIdx - 1),
     1143                             substring(vDm,vIdx),
     1144                             chr(29)) no-error.
     1145          end.
     1146        end.
     1147        else
     1148          vDM = substitute("&1&3&2",
     1149                           substring(iMark,1,25),
     1150                           substring(iMark,26),
     1151                           chr(29)) no-error.
     1152      end.
     1153      else if substring(iMark,32,2) = "91" then
     1154      do:
     1155        vIdx = index(iMark,"92",32).
     1156        if vIdx > 1 then
     1157          vDM = substitute("&1&4&2&4&3",
     1158                           substring(iMark,1,31),
     1159                           substring(iMark,32,vIdx - 31 - 1),
     1160                           substring(iMark,vIdx),
     1161                           chr(29)) no-error.
     1162        else
     1163          vDM = substitute("&1&3&2",
     1164                           substring(iMark,1,31),
     1165                           substring(iMark,32),
     1166                           chr(29)) no-error.
     1167      end.
     1168      else if substring(iMark,39,2) = "91" then
     1169      do:
     1170        vIdx = index(iMark,"92",38).
     1171        if vIdx > 1 then
     1172          vDM = substitute("&1&4&2&4&3",
     1173                           substring(iMark,1,38),
     1174                           substring(iMark,39,vIdx - 38 - 1),
     1175                           substring(iMark,vIdx),
     1176                           chr(29)) no-error.
     1177        else
     1178          vDM = substitute("&1&3&2",
     1179                           substring(iMark,1,38),
     1180                           substring(iMark,39),
     1181                           chr(29)) no-error.
     1182      end.
     1183      else if substring(iMark,25,2) = "93" then
     1184      do:
     1185        vIdx = index(iMark,"92",25).
     1186        if vIdx > 1 then
     1187          vDM = substitute("&1&4&2&4&3",
     1188                           substring(iMark,1,24),
     1189                           substring(iMark,25,vIdx - 24 - 1),
     1190                           substring(iMark,vIdx),
     1191                           chr(29)) no-error.
     1192        else
     1193          vIdx = index(iMark,"3103",25).
     1194          if vIdx > 0 then
     1195          vDM = substitute("&1&4&2&4&3",
     1196                           substring(iMark,1,24),
     1197                           substring(iMark,25,vIdx - 24 - 1),
     1198                           substring(iMark,vIdx),
     1199                           chr(29)) no-error.
     1200          else
     1201            vDM = substitute("&1&3&2",
     1202                             substring(iMark,1,24),
     1203                             substring(iMark,25),
     1204                             chr(29)) no-error.
     1205      end.
     1206      else if substring(iMark,32,2) = "93" then
     1207      do:
     1208        vDM = substitute("&1&3&2",
     1209              substring(iMark,1,31),
     1210              substring(iMark,32),
     1211              chr(29)) no-error.
     1212      end.
     1213      return if vDM <> "" then vDm else iMark.
     1214   end.
     1215   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216     define private temp-table tt-rep no-undo
     1217      field obj-type          as character
     1218      field obj-code          as integer
     1219      field obj-name          as character
     1220      field chk-date          as date
     1221      field chk-time          as integer
     1222      field sort-date         as date
     1223      field sort-time         as integer
     1224      field shift-date        as date
     1225      field shift-name        as character
     1226      field doc-code          as character
     1227      field chk-num           as integer
     1228      field line-num          as integer
     1229      field doc-num2          as character
     1230      field z-number          as integer
     1231      field tran-num          as integer
     1232      field chk-type-desc     as character
     1233      field pay-desk          as character
     1234      field cash-num          as integer
     1235      field cashier           as character
     1236      field trk-num           as integer
     1237      field nozzle-num        as integer
     1238      field fuel-code         as integer
     1239      field gds-name          as character
     1240      field volume            as decimal
     1241      field price             as decimal
     1242      field money             as decimal
     1243      field cash-pay-code     as integer
     1244      field cash-pay-name     as character
     1245      field pay-card          as character
     1246      field datetime-beg      as datetime
     1247      field date-beg          as date
     1248      field time-beg          as integer
     1249      field datetime-end      as datetime
     1250      field date-end          as date
     1251      field time-end          as integer
     1252      field time-length       as integer
     1253      field all-time-length   as integer
     1254      field all-time-length-2 as integer
     1255      field multi-pay         as logical
     1256      field resume-tran       as logical
     1257      field uuid              as character
     1258      field uuid-cheq         as character
     1259      field grp-num           as integer
     1260      field db-num            as integer
     1261   index pi obj-code shift-date shift-name sort-date sort-time pay-desk fuel-code trk-num nozzle-num
     1262   index si1 obj-code grp-num datetime-beg
     1263   index CashPayNname cash-pay-name
     1264   index GrpNum grp-num
     1265   index ChkTypeDesc chk-type-desc
     1266   index iuuid db-num uuid-cheq uuid
     1267   index UuidCheq db-num uuid uuid-cheq
     1268   index UuidCHKType db-num uuid chk-type-desc
     1269   index DateTimeBeg datetime-beg
     1270   index AllTimeLength2 all-time-length-2
     1271   index sort obj-code sort-date sort-time
     1272   .
     1273   define private temp-table tt-all-total-rep no-undo
     1274      field obj-type           as character
     1275      field obj-code           as integer
     1276      field qty-chk            as integer
     1277      field qty-tran           as integer
     1278      field qty-chk-fuel       as integer
     1279      field full-time-tran     as integer
     1280      field avg-time-tran      as integer
     1281      field avg-time-tran-fuel as integer
     1282   index obj obj-type obj-code
     1283   .
     1284   define private temp-table tt-total-rep no-undo like tt-all-total-rep
     1285      field obj-name           as character
     1286   index ObjName obj-type obj-code obj-name
     1287   .
     1288   define private temp-table tt-grp no-undo
     1289      field obj-type           as character
     1290      field obj-code           as integer
     1291      field obj-name           as character
     1292      field grp-num            as integer
     1293      field all-time-length    as integer
     1294      field all-time-length-2  as integer
     1295      field cash-pay-code      as integer
     1296      field cash-pay-name      as character
     1297      field resume-tran        as logical
     1298   index ObjName obj-type obj-code obj-name
     1299   index ResumeTran  resume-tran
     1300   index GrpNum grp-num
     1301   .
     1302   define private temp-table tt-grp-uuid no-undo
     1303      field grp-num            as integer
     1304      field uuid               as character
     1305    index uid uuid grp-num.
     1306   .
     1307   define private temp-table tt-grp-cheq-uuid no-undo
     1308      field grp-num            as integer
     1309      field uuid               as character
     1310    index uid uuid grp-num.
     1311   .
     1312   define private temp-table tt-pay no-undo
     1313      field seq             as integer
     1314      field volume          as decimal
     1315      field money           as decimal
     1316      field cash-pay-code   as integer
     1317      field cash-pay-name   as character
     1318      field pay-card        as character
     1319      field multi-pay       as logical
     1320     index pi seq
     1321     .
     1322   method private void CreateOneRec
     1323         (buffer chk-doc   for chk-doc,
     1324          buffer tran-fuel for tran-fuel,
     1325          buffer chk-gds   for chk-gds,
     1326          buffer goods     for goods):
     1327      define buffer cash-pay    for cash-pay.
     1328      define buffer b-chk-gds   for chk-gds.
     1329      define buffer b-tran-fuel for tran-fuel.
     1330      define variable v-chk-type-desc as character no-undo.
     1331      define variable v-cash-pay-code as integer   no-undo.
     1332      define variable v-cash-pay-name as character no-undo.
     1333      define variable v-pay-card      as character no-undo.
     1334      define variable v-psn-code      as integer   no-undo.
     1335      define variable v-db-num        as integer   no-undo.
     1336      define variable vDateBeg        as datetime  no-undo.
     1337      define variable vDateEnd        as datetime  no-undo.
     1338      define variable vSeq            as integer   no-undo.
     1339      define variable vMoney          as decimal   no-undo.
     1340      define variable vVolume         as decimal   no-undo.
     1341      define variable vTotSum         as decimal   no-undo.
     1342      do:
     1343         vVolume = if can-do("6,14,16", string(chk-doc.chk-type)) then chk-gds.doc-qnty else tran-fuel.volume.
     1344         empty temp-table tt-pay.
     1345         v-chk-type-desc = entry(lookup(string(chk-doc.chk-type), "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"), "Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр").
     1346         for each chk-pay where
     1347                  chk-pay.doc-code = chk-gds.doc-code
     1348         no-lock
     1349         break
     1350            by chk-pay.doc-code
     1351            by chk-pay.tot-sum:
     1352            if first-of(chk-pay.doc-code) and last-of(chk-pay.doc-code) then
     1353               leave.
     1354            vSeq = vSeq + 1.
     1355            v-pay-card = if chk-pay.pay-card = "0" then "" else chk-pay.pay-card.
     1356            find first cash-pay where
     1357                       cash-pay.cdpay-code = chk-pay.pay-code
     1358            no-lock no-error.
     1359            if avail cash-pay then
     1360               assign
     1361                  v-cash-pay-code = chk-pay.pay-code
     1362                  v-cash-pay-name = cash-pay.obj-name
     1363                  .
     1364            else
     1365               assign
     1366                  v-cash-pay-code = 0
     1367                  v-cash-pay-name = ""
     1368                  .
     1369            vTotSum = chk-pay.tot-sum - (if last-of(chk-pay.doc-code) then
     1370                                            (chk-doc.tot-doc - chk-gds.sum-base)
     1371                                         else 0).
     1372            create tt-pay.
     1373            assign
     1374               tt-pay.seq           = vSeq
     1375               tt-pay.volume        = round(vVolume * vTotSum / chk-gds.sum-base, 2)
     1376               tt-pay.money         = vTotSum
     1377               tt-pay.cash-pay-code = v-cash-pay-code
     1378               tt-pay.cash-pay-name = v-cash-pay-name
     1379               tt-pay.pay-card      = v-pay-card
     1380               tt-pay.multi-pay     = yes
     1381               .
     1382               if tt-pay.volume = ? then
     1383                  tt-pay.volume = 0.0.
     1384         end.
     1385         find first tt-pay no-error.
     1386         if not avail tt-pay then do:
     1387            find first chk-pay where
     1388                       chk-pay.doc-code = chk-gds.doc-code
     1389            no-lock no-error.
     1390            if avail chk-pay then
     1391               assign
     1392                  v-pay-card      = if chk-pay.pay-card = "0" then "" else chk-pay.pay-card
     1393                  vMoney          = chk-gds.sum-base
     1394                  v-cash-pay-code = chk-pay.pay-code
     1395                  .
     1396            else
     1397               assign
     1398                  v-pay-card       = ""
     1399                  vMoney           = tran-fuel.money
     1400                  v-cash-pay-code  = (if chk-doc.chk-type = 8 then 0 else tran-fuel.pay-code)
     1401                  .
     1402            find first cash-pay where
     1403                       cash-pay.cdpay-code = v-cash-pay-code
     1404            no-lock no-error.
     1405            v-cash-pay-name = if avail cash-pay then cash-pay.obj-name else "".
     1406            create tt-pay.
     1407            assign
     1408               tt-pay.seq           = 1
     1409               tt-pay.volume        = vVolume
     1410               tt-pay.money         = if chk-doc.chk-type = 1 then vVolume * tran-fuel.price else vMoney
     1411               tt-pay.cash-pay-code = v-cash-pay-code
     1412               tt-pay.cash-pay-name = v-cash-pay-name
     1413               tt-pay.pay-card      = v-pay-card
     1414               .
     1415         end.
     1416         find first b-tran-fuel where
     1417                    b-tran-fuel.db-num    = tran-fuel.db-num
     1418                and b-tran-fuel.uuid      = tran-fuel.uuid
     1419                and b-tran-fuel.uuid-cheq = ""
     1420         no-lock no-error.
     1421         if avail b-tran-fuel and b-tran-fuel.date-beg < tran-fuel.date-beg then
     1422            vDateBeg = b-tran-fuel.date-beg.
     1423         else
     1424            vDateBeg = tran-fuel.date-beg.
     1425         assign
     1426            vDateBeg = vDateBeg           + timezone * 60000
     1427            vDateEnd = tran-fuel.date-end + timezone * 60000.
     1428            .
     1429         for each tt-pay:
     1430            create tt-rep.
     1431            assign
     1432               tt-rep.chk-date        = chk-doc.chk-date
     1433               tt-rep.chk-time        = chk-doc.chk-time
     1434               tt-rep.sort-date       = chk-doc.chk-date
     1435               tt-rep.sort-time       = chk-doc.chk-time
     1436               tt-rep.shift-date      = chk-doc.shift-date
     1437               tt-rep.shift-name      = chk-doc.shift-name + "(" + string(chk-doc.shift-num) + ")"
     1438               tt-rep.doc-code        = chk-doc.doc-code
     1439               tt-rep.chk-num         = chk-doc.chk-num
     1440               tt-rep.line-num        = chk-gds.line-num
     1441               tt-rep.doc-num2        = (if num-entries(chk-doc.doc-num2, ":") > 1 then entry(1, chk-doc.doc-num2, ":") else "")
     1442               tt-rep.z-number        = chk-doc.z-number
     1443               tt-rep.tran-num        = tran-fuel.tran-num
     1444               tt-rep.chk-type-desc   = v-chk-type-desc
     1445               tt-rep.cash-num        = tran-fuel.cash-num
     1446               tt-rep.trk-num         = tran-fuel.trk-num + 1
     1447               tt-rep.nozzle-num      = tran-fuel.nozzle-num + 1
     1448               tt-rep.fuel-code       = chk-gds.b-code
     1449               tt-rep.gds-name        = goods.gds-name
     1450               tt-rep.volume          = tt-pay.volume
     1451               tt-rep.price           = tran-fuel.price
     1452               tt-rep.money           = if tt-pay.multi-pay then tt-pay.money else tt-pay.volume * tran-fuel.price
     1453               tt-rep.cash-pay-code   = tt-pay.cash-pay-code
     1454               tt-rep.cash-pay-name   = tt-pay.cash-pay-name
     1455               tt-rep.pay-card        = tt-pay.pay-card
     1456               tt-rep.datetime-beg    = vDateBeg
     1457               tt-rep.date-beg        = date(vDateBeg)
     1458               tt-rep.time-beg        = mtime(vDateBeg) / 1000
     1459               tt-rep.datetime-end    = vDateEnd
     1460               tt-rep.date-end        = date(vDateEnd)
     1461               tt-rep.time-end        = mtime(vDateEnd) / 1000
     1462               tt-rep.time-length     = (vDateEnd - vDateBeg) / 1000
     1463               tt-rep.all-time-length = tt-rep.time-length
     1464               tt-rep.multi-pay       = tt-pay.multi-pay
     1465               tt-rep.resume-tran     = no
     1466               tt-rep.uuid            = tran-fuel.uuid
     1467               tt-rep.uuid-cheq       = tran-fuel.uuid-cheq
     1468               tt-rep.db-num          = tran-fuel.db-num
     1469               .
     1470            if chk-doc.chk-type = 16 and chk-gds.src-qnty <= 0 then do:
     1471               find first b-chk-gds where
     1472                          b-chk-gds.doc-code = chk-gds.doc-code
     1473                      and b-chk-gds.b-code   = chk-gds.b-code
     1474                      and b-chk-gds.line-num > chk-gds.line-num
     1475               no-lock no-error.
     1476               if avail b-chk-gds then
     1477                  assign
     1478                     tt-rep.volume     = b-chk-gds.doc-qnty
     1479                     .
     1480            end.
     1481         end.
     1482      end.
     1483   end.
     1484   method private void InitTT
     1485            (i-tog-shift       as logical,
     1486             i-date-start      as date,
     1487             i-date-end        as date,
     1488             i-Shift-Start     as integer,
     1489             i-Shift-End       as integer,
     1490             iChkTypeCodeList  as character,
     1491             iGdsCodeList      as character,
     1492             iTRKList          as character):
     1493      define buffer chk-doc      for chk-doc.
     1494      define buffer chk-doc-attr for chk-doc-attr.
     1495      define buffer chk-gds      for chk-gds.
     1496      define buffer goods        for goods.
     1497      define buffer cash-pay     for cash-pay.
     1498      define buffer prod-bc      for prod-bc.
     1499      define buffer b-tran-fuel  for tran-fuel.
     1500      define variable v-gds-code as integer  no-undo.
     1501      define variable vDateBeg   as datetime no-undo.
     1502      define variable vDateEnd   as datetime no-undo.
     1503      define variable vCount     as integer  no-undo.
     1504      if i-tog-shift then do:
     1505         for
     1506             each chk-doc where
     1507                  chk-doc.shift-date >= i-date-start
     1508              and chk-doc.shift-date <= i-date-end
     1509              and can-do(iChkTypeCodeList, string(chk-doc.chk-type))
     1510         no-lock,
     1511            first chk-doc-attr where
     1512                  chk-doc-attr.doc-code  = chk-doc.doc-code
     1513              and chk-doc-attr.attr-code = "CheckId"
     1514         no-lock,
     1515            each tran-fuel where
     1516                 tran-fuel.uuid-cheq = chk-doc-attr.attr-value
     1517             and can-do(iTRKList, string(tran-fuel.trk-num + 1))
     1518         no-lock:
     1519            v-gds-code = tran-fuel.fuel-code.
     1520            if v-gds-code < 100 then do:
     1521               find first prod-bc where
     1522                          prod-bc.b-str = string(v-gds-code)
     1523               no-lock no-error.
     1524               if avail prod-bc then do:
     1525                  find first chk-gds where
     1526                             chk-gds.doc-code = chk-doc.doc-code
     1527                         and chk-gds.b-code   = prod-bc.b-code
     1528                  no-lock no-error.
     1529                  find first goods where
     1530                             goods.gds-code = prod-bc.b-code
     1531                  no-lock no-error.
     1532                  if not avail chk-gds or not avail goods
     1533                  then
     1534                     next.
     1535                  v-gds-code = goods.gds-code.
     1536               end.
     1537               else next.
     1538            end.
     1539            else do:
     1540               find first chk-gds where
     1541                          chk-gds.doc-code = chk-doc.doc-code
     1542                      and chk-gds.b-code   = v-gds-code
     1543               no-lock no-error.
     1544               find first goods where
     1545                          goods.gds-code = v-gds-code
     1546               no-lock no-error.
     1547               if not avail chk-gds or not avail goods
     1548               then
     1549                  next.
     1550            end.
     1551            if not can-do(iGdsCodeList, string(v-gds-code)) then next.
     1552            if (chk-doc.shift-date = i-date-start and chk-doc.shift-num < i-Shift-Start) or
     1553               (chk-doc.shift-date = i-date-end   and chk-doc.shift-num > i-Shift-End)
     1554            then
     1555               next.
     1556            CreateOneRec(buffer chk-doc,
     1557                         buffer tran-fuel,
     1558                         buffer chk-gds,
     1559                         buffer goods
     1560                         ).
     1561         end.
     1562      end.
     1563      else do:
     1564        TRAN-FUEL:
     1565        for each tran-fuel where
     1566                 tran-fuel.date-beg >= datetime(string(i-date-start) + " 00:00:00") - timezone * 60000
     1567             and tran-fuel.date-beg <= datetime(string(i-date-end + 2) + " 23:59:59") - timezone * 60000
     1568             and can-do(iTRKList, string(tran-fuel.trk-num + 1))
     1569        no-lock:
     1570          release chk-doc-attr.
     1571          if tran-fuel.num-cheq > 0 then do:
     1572   for first chk-doc-attr where
     1573             chk-doc-attr.attr-code  = "CheckId"
     1574         and chk-doc-attr.attr-value = tran-fuel.uuid-cheq
     1575   no-lock,
     1576       first chk-doc where
     1577             chk-doc.doc-code = chk-doc-attr.doc-code
     1578         and can-do(iChkTypeCodeList, string(chk-doc.chk-type))
     1579   no-lock
     1580   :
     1581     v-gds-code = tran-fuel.fuel-code.
     1582     if v-gds-code < 100 then do:
     1583       find first prod-bc where
     1584                  prod-bc.b-str = string(v-gds-code)
     1585       no-lock no-error.
     1586       if avail prod-bc then do:
     1587          find first chk-gds where
     1588                     chk-gds.doc-code = chk-doc.doc-code
     1589                 and chk-gds.b-code   = prod-bc.b-code
     1590          no-lock no-error.
     1591          find first goods where
     1592                     goods.gds-code = prod-bc.b-code
     1593          no-lock no-error.
     1594          if not avail chk-gds or not avail goods
     1595          then
     1596             next TRAN-FUEL.
     1597          v-gds-code = goods.gds-code.
     1598       end.
     1599       else next TRAN-FUEL.
     1600     end.
     1601     else do:
     1602        find first chk-gds where
     1603                   chk-gds.doc-code = chk-doc.doc-code
     1604               and chk-gds.b-code   = v-gds-code
     1605        no-lock no-error.
     1606        find first goods where
     1607                   goods.gds-code = v-gds-code
     1608        no-lock no-error.
     1609        if not avail chk-gds or not avail goods
     1610        then
     1611           next TRAN-FUEL.
     1612     end.
     1613     if not can-do(iGdsCodeList, string(v-gds-code)) then next TRAN-FUEL.
     1614       CreateOneRec(buffer chk-doc,
     1615                    buffer tran-fuel,
     1616                    buffer chk-gds,
     1617                    buffer goods
     1618                    ).
     1619   end.
     1620          end.
     1621          if not available chk-doc-attr then do:
     1622          end.
     1623        end.
     1624      end.
     1625      release tt-rep.
     1626   end.
     1627   method private void AfterCalc(i-tog-shift  as logical,
     1628                                 i-date-end   as date,
     1629                                 iTRKList     as character,
     1630                                 iCashPayList as character,
     1631                                 iTranTimeMax as integer):
     1632      define buffer b-chk-gds    for chk-gds.
     1633      define buffer b-tt-rep     for tt-rep.
     1634      define buffer b2-tt-rep    for tt-rep.
     1635      define variable vI                   as integer   no-undo.
     1636      define variable vCheck               as logical   no-undo.
     1637      define variable vCheckResumeTran     as logical   no-undo.
     1638      define variable v-all-time-length    as integer   no-undo.
     1639      define variable v-count-grp-num      as integer   no-undo.
     1640      define variable v-prev-datetime-end  as datetime  no-undo.
     1641      define variable v-first-datetime-beg as datetime  no-undo.
     1642      define variable vResumeTran          as logical   no-undo.
     1643      define variable vUuidCheq            as character no-undo.
     1644      define variable vFirstRecId          as recid     no-undo.
     1645      define variable vConfirmResumeTran   as logical   no-undo.
     1646      define variable vRecId               as recid     no-undo.
     1647      define variable vRowId               as rowid     no-undo.
     1648      define variable vRowIdList           as character no-undo.
     1649      define variable v-gds-code           as integer   no-undo.
     1650      define variable vTrkNum              as integer   no-undo.
     1651      for each  tt-grp:
     1652         delete tt-grp.
     1653      end.
     1654      for each  tt-grp-uuid:
     1655         delete tt-grp-uuid.
     1656      end.
     1657      for each  tt-grp-cheq-uuid:
     1658         delete tt-grp-cheq-uuid.
     1659      end.
     1660      for each tt-rep where
     1661               not can-do(iTRKList, string(tt-rep.trk-num)):
     1662         delete tt-rep.
     1663      end.
     1664      for each tt-rep where
     1665               tt-rep.cash-pay-name = "":
     1666         find first tran-fuel where
     1667                    tran-fuel.db-num   = tt-rep.db-num
     1668                and tran-fuel.tran-num = tt-rep.tran-num
     1669                and tran-fuel.num-cheq = integer(tt-rep.doc-num2)
     1670         no-lock no-error.
     1671         if avail tran-fuel then do:
     1672            for first chk-doc-attr where
     1673                      chk-doc-attr.attr-code  = "CheckId"
     1674                  and chk-doc-attr.attr-value = tran-fuel.uuid-cheq
     1675            no-lock,
     1676                first chk-doc where
     1677                      chk-doc.doc-code = chk-doc-attr.doc-code
     1678            no-lock
     1679                  :
     1680               v-gds-code = tran-fuel.fuel-code.
     1681               if v-gds-code < 100 then do:
     1682                  find first prod-bc where
     1683                             prod-bc.b-str = string(tran-fuel.fuel-code)
     1684                  no-lock no-error.
     1685                  if avail prod-bc then do:
     1686                     find first chk-gds where
     1687                                chk-gds.doc-code = chk-doc.doc-code
     1688                            and chk-gds.b-code   = prod-bc.b-code
     1689                     no-lock no-error.
     1690                     find first goods where
     1691                                goods.gds-code = prod-bc.b-code
     1692                     no-lock no-error.
     1693                     if not avail chk-gds or not avail goods
     1694                     then
     1695                        next.
     1696                     v-gds-code = goods.gds-code.
     1697                  end.
     1698               end.
     1699               else do:
     1700                  find first chk-gds where
     1701                             chk-gds.doc-code = chk-doc.doc-code
     1702                         and chk-gds.b-code   = v-gds-code
     1703                  no-lock no-error.
     1704                  find first goods where
     1705                             goods.gds-code = v-gds-code
     1706                  no-lock no-error.
     1707                  if not avail chk-gds or not avail goods
     1708                  then
     1709                     next.
     1710               end.
     1711               find first chk-pay where
     1712                          chk-pay.doc-code = chk-gds.doc-code
     1713               no-lock no-error.
     1714               if avail chk-pay then do:
     1715                  find first cash-pay where
     1716                             cash-pay.cdpay-code = chk-pay.pay-code
     1717                  no-lock no-error.
     1718                  if avail cash-pay then
     1719                     assign
     1720                        tt-rep.cash-pay-code = chk-pay.pay-code
     1721                        tt-rep.cash-pay-name = cash-pay.obj-name.
     1722               end.
     1723            end.
     1724         end.
     1725      end.
     1726      v-count-grp-num = 0.
     1727      for each tt-rep
     1728         by tt-rep.obj-code
     1729         by tt-rep.sort-date
     1730         by tt-rep.sort-time:
     1731         block-grp-uuid:
     1732         for each tt-grp-uuid where  tt-grp-uuid.uuid     = tt-rep.uuid
     1733         no-lock:
     1734            for each tt-grp where
     1735                       tt-grp.obj-type = tt-rep.obj-type
     1736                   and tt-grp.obj-code = tt-rep.obj-code
     1737                   and tt-grp.obj-name = tt-rep.obj-name
     1738                   and tt-grp.grp-num  = tt-grp-uuid.grp-num
     1739                   :
     1740                   find first tt-grp-cheq-uuid where tt-grp-cheq-uuid.grp-num = tt-grp.grp-num
     1741                                                 and tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     1742                   no-error.
     1743                   leave block-grp-uuid.
     1744                end.
     1745         end.
     1746         if not available tt-grp
     1747         then do:
     1748            block-grp-cheq:
     1749            for each tt-grp-cheq-uuid where  tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     1750            no-lock:
     1751               for each tt-grp where
     1752                          tt-grp.obj-type = tt-rep.obj-type
     1753                      and tt-grp.obj-code = tt-rep.obj-code
     1754                      and tt-grp.obj-name = tt-rep.obj-name
     1755                      and tt-grp.grp-num  = tt-grp-cheq-uuid.grp-num
     1756                      :
     1757                      find first tt-grp-uuid where tt-grp-uuid.grp-num = tt-grp.grp-num
     1758                                               and tt-grp-uuid.uuid     = tt-rep.uuid
     1759                      no-error.
     1760                      leave block-grp-cheq.
     1761               end.
     1762            end.
     1763         end.
     1764         if     not avail tt-grp
     1765         then do:
     1766            v-count-grp-num = v-count-grp-num + 1.
     1767            create tt-grp.
     1768            assign
     1769               tt-grp.obj-type = tt-rep.obj-type
     1770               tt-grp.obj-code = tt-rep.obj-code
     1771               tt-grp.obj-name = tt-rep.obj-name
     1772               tt-grp.grp-num  = v-count-grp-num
     1773               .
     1774         end.
     1775         if not available tt-grp-cheq-uuid
     1776         then do:
     1777            create tt-grp-cheq-uuid.
     1778            assign
     1779               tt-grp-cheq-uuid.grp-num  = tt-grp.grp-num
     1780               tt-grp-cheq-uuid.uuid     = tt-rep.uuid-cheq
     1781            .
     1782         end.
     1783         if not available tt-grp-uuid
     1784         then do:
     1785            create tt-grp-uuid.
     1786            assign
     1787               tt-grp-uuid.grp-num = tt-grp.grp-num
     1788               tt-grp-uuid.uuid     = tt-rep.uuid
     1789            .
     1790         end.
     1791         tt-rep.grp-num = tt-grp.grp-num.
     1792         if tt-grp.cash-pay-name = "" then
     1793            assign
     1794               tt-grp.cash-pay-code = tt-rep.cash-pay-code
     1795               tt-grp.cash-pay-name = tt-rep.cash-pay-name
     1796               .
     1797         release tt-grp.
     1798      end.
     1799      for each tt-rep
     1800      break
     1801         by tt-rep.obj-code
     1802         by tt-rep.grp-num
     1803         by tt-rep.sort-date
     1804         by tt-rep.sort-time
     1805         by tt-rep.datetime-beg:
     1806         if first-of(tt-rep.grp-num) then do:
     1807            assign
     1808               vUuidCheq          = ""
     1809               vResumeTran        = no
     1810               vConfirmResumeTran = no
     1811               .
     1812            if tt-rep.chk-type-desc = "Продажа" then
     1813               assign
     1814                  vUuidCheq   = tt-rep.uuid-cheq
     1815                  vResumeTran = yes
     1816                  vTrkNum     = tt-rep.trk-num
     1817                  .
     1818            find first b-tt-rep where recid(b-tt-rep) = vFirstRecId no-error.
     1819         end.
     1820         else do:
     1821            if tt-rep.chk-type-desc = "Продажа" and
     1822               tt-rep.uuid-cheq     = vUuidCheq and
     1823               tt-rep.multi-pay     = no        and
     1824               vResumeTran          = yes
     1825            then
     1826               assign
     1827                  tt-rep.resume-tran = yes
     1828                  vConfirmResumeTran = yes
     1829                  .
     1830            else
     1831               if tt-rep.chk-type-desc = "Продажа" and
     1832                  tt-rep.uuid-cheq     = vUuidCheq and
     1833                  tt-rep.multi-pay     = no
     1834               then
     1835                  assign
     1836                     vResumeTran = yes
     1837                     vTrkNum     = tt-rep.trk-num
     1838                  .
     1839               else
     1840                  vResumeTran = no.
     1841            for first b-tt-rep where
     1842                      b-tt-rep.db-num   = tt-rep.db-num
     1843                  and b-tt-rep.uuid     = tt-rep.uuid
     1844                  and b-tt-rep.chk-num = 0:
     1845              assign
     1846                tt-rep.resume-tran = yes
     1847                vConfirmResumeTran = yes
     1848              .
     1849              for first tt-grp-uuid where
     1850                        tt-grp-uuid.uuid = b-tt-rep.uuid:
     1851                 delete tt-grp-uuid.
     1852              end.
     1853              delete b-tt-rep.
     1854            end.
     1855         end.
     1856         if last-of(tt-rep.grp-num) and not first-of(tt-rep.grp-num) and vConfirmResumeTran then do:
     1857            for first tt-grp where tt-grp.grp-num = tt-rep.grp-num:
     1858               tt-grp.resume-tran = yes.
     1859            end.
     1860         end.
     1861      end.
     1862      for each tt-grp where
     1863               tt-grp.resume-tran = yes:
     1864         for each tt-rep where
     1865                  tt-rep.grp-num = tt-grp.grp-num
     1866         break
     1867            by tt-rep.obj-code
     1868            by tt-rep.grp-num
     1869            by tt-rep.datetime-beg
     1870            by tt-rep.sort-date
     1871            by tt-rep.sort-time:
     1872            if not first-of(tt-rep.grp-num) and tt-rep.chk-type-desc = "Продажа" then do:
     1873               find first b-tt-rep where
     1874                          recid(b-tt-rep)        = vRecId
     1875                      and b-tt-rep.chk-type-desc = "Продажа"
     1876               no-error.
     1877               if avail b-tt-rep then do:
     1878                  assign
     1879                     b-tt-rep.datetime-end    = tt-rep.datetime-beg
     1880                     b-tt-rep.date-end        = tt-rep.date-beg
     1881                     b-tt-rep.time-end        = tt-rep.time-beg
     1882                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     1883                     .
     1884               end.
     1885            end.
     1886            vRecId = recid(tt-rep).
     1887         end.
     1888      end.
     1889      repeat preselect each tt-rep where
     1890                            tt-rep.chk-type-desc = "ПеревТрнзкц":
     1891         find next tt-rep.
     1892         find first b-chk-gds where
     1893                    b-chk-gds.doc-code =  tt-rep.doc-code
     1894                and b-chk-gds.line-num <> chk-gds.line-num
     1895         no-lock no-error.
     1896         if avail b-chk-gds then do:
     1897            find first b-tt-rep where
     1898                       b-tt-rep.db-num    =  tt-rep.db-num
     1899                   and b-tt-rep.uuid      =  tt-rep.uuid
     1900                   and b-tt-rep.uuid-cheq <> tt-rep.uuid-cheq
     1901            no-error.
     1902            if avail b-tt-rep then do:
     1903               find first b2-tt-rep where
     1904                          b2-tt-rep.db-num    =  B-tt-rep.db-num
     1905                      and b2-tt-rep.uuid-cheq =  b-tt-rep.uuid-cheq
     1906                      and b2-tt-rep.uuid      <> b-tt-rep.uuid
     1907               no-lock no-error.
     1908               if avail b2-tt-rep then do:
     1909                  create b-tt-rep.
     1910                  buffer-copy b2-tt-rep to b-tt-rep
     1911                     assign
     1912                        b-tt-rep.chk-date        = tt-rep.chk-date
     1913                        b-tt-rep.chk-time        = tt-rep.chk-time
     1914                        b-tt-rep.sort-date       = tt-rep.sort-date
     1915                        b-tt-rep.sort-time       = tt-rep.sort-time
     1916                        b-tt-rep.doc-code        = tt-rep.doc-code
     1917                        b-tt-rep.chk-num         = tt-rep.chk-num
     1918                        b-tt-rep.line-num        = b-chk-gds.line-num
     1919                        b-tt-rep.doc-num2        = tt-rep.doc-num2
     1920                        b-tt-rep.z-number        = tt-rep.z-number
     1921                        b-tt-rep.chk-type-desc   = tt-rep.chk-type-desc
     1922                        b-tt-rep.resume-tran     = no
     1923                        b-tt-rep.uuid-cheq       = tt-rep.uuid-cheq
     1924                        .
     1925               end.
     1926            end.
     1927         end.
     1928      end.
     1929      for each tt-grp:
     1930         for each tt-rep where
     1931                  tt-rep.grp-num = tt-grp.grp-num
     1932         break
     1933            by tt-rep.obj-code
     1934            by tt-rep.grp-num
     1935            by tt-rep.datetime-beg
     1936            by tt-rep.sort-date
     1937            by tt-rep.sort-time:
     1938            if not first-of(tt-rep.grp-num) and tt-rep.chk-type-desc = "ПеревТрнзкц" then do:
     1939               find first b-tt-rep where
     1940                          recid(b-tt-rep)        = vRecId
     1941                      and b-tt-rep.chk-type-desc = "Продажа"
     1942               no-error.
     1943               if avail b-tt-rep then do:
     1944                  assign
     1945                     b-tt-rep.datetime-end    = tt-rep.datetime-end
     1946                     b-tt-rep.date-end        = tt-rep.date-end
     1947                     b-tt-rep.time-end        = tt-rep.time-end
     1948                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     1949                     .
     1950               end.
     1951            end.
     1952            vRecId = recid(tt-rep).
     1953         end.
     1954      end.
     1955      for each tt-rep where
     1956               tt-rep.chk-type-desc = "Возврат":
     1957         find last b-tt-rep where
     1958                   b-tt-rep.DB-NUM        = tt-rep.db-num
     1959               and b-tt-rep.uuid          = tt-rep.uuid
     1960               and b-tt-rep.chk-type-desc = "Продажа"
     1961         no-error.
     1962         if avail b-tt-rep then do:
     1963            assign
     1964               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     1965               tt-rep.date-beg     = b-tt-rep.date-beg
     1966               tt-rep.time-beg     = b-tt-rep.time-beg
     1967               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     1968               .
     1969         end.
     1970      end.
     1971      for each tt-rep where
     1972               tt-rep.chk-type-desc = "СбросТрнзкц":
     1973         find last b-tt-rep where
     1974                   b-tt-rep.DB-NUM        = tt-rep.db-num
     1975               and b-tt-rep.uuid          = tt-rep.uuid
     1976               and b-tt-rep.chk-type-desc = "Продажа"
     1977         no-error.
     1978         if avail b-tt-rep then do:
     1979            assign
     1980               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     1981               tt-rep.date-beg     = b-tt-rep.date-beg
     1982               tt-rep.time-beg     = b-tt-rep.time-beg
     1983               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     1984               .
     1985         end.
     1986      end.
     1987      for each tt-rep where
     1988               tt-rep.chk-type-desc = "ПеревТрнзкц":
     1989         find first b-tt-rep where
     1990                    b-tt-rep.DB-NUM        = tt-rep.db-num
     1991                and b-tt-rep.uuid          = tt-rep.uuid
     1992                and b-tt-rep.chk-type-desc = "Продажа"
     1993         no-error.
     1994         if avail b-tt-rep then do:
     1995            assign
     1996               tt-rep.datetime-beg = b-tt-rep.datetime-beg
     1997               tt-rep.date-beg     = b-tt-rep.date-beg
     1998               tt-rep.time-beg     = b-tt-rep.time-beg
     1999               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2000               .
     2001         end.
     2002      end.
     2003      for each tt-rep where
     2004               tt-rep.chk-type-desc = "ТехПролив":
     2005         find first tran-fuel where
     2006                    tran-fuel.db-num    =  tt-rep.db-num
     2007                and tran-fuel.uuid      =  tt-rep.uuid
     2008                and tran-fuel.uuid-cheq <> tt-rep.uuid-cheq
     2009         no-lock no-error.
     2010         if avail tran-fuel then do:
     2011            assign
     2012               tt-rep.datetime-beg = tran-fuel.date-beg + timezone * 60000
     2013               tt-rep.date-beg     = date(tt-rep.datetime-beg)
     2014               tt-rep.time-beg     = mtime(tt-rep.datetime-beg) / 1000
     2015               tt-rep.time-length  = (tt-rep.datetime-end - tt-rep.datetime-beg) / 1000
     2016               .
     2017         end.
     2018      end.
     2019      for each tt-rep
     2020      break
     2021         by tt-rep.obj-code
     2022         by tt-rep.grp-num
     2023         by tt-rep.datetime-beg
     2024         by tt-rep.sort-date
     2025         by tt-rep.sort-time:
     2026         if first-of(tt-rep.grp-num) then do:
     2027            vRowId = ?.
     2028         end.
     2029         if can-do("Возврат,СбросТрнзкц", tt-rep.chk-type-desc) and vRowId <> ? then do:
     2030            for first b-tt-rep where rowid(b-tt-rep) = vRowId:
     2031               assign
     2032                  b-tt-rep.datetime-end    = tt-rep.datetime-end
     2033                  b-tt-rep.date-end        = tt-rep.date-end
     2034                  b-tt-rep.time-end        = tt-rep.time-end
     2035                  b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2036                  .
     2037            end.
     2038         end.
     2039         vRowId = rowid(tt-rep).
     2040      end.
     2041      for each tt-rep
     2042      break
     2043         by tt-rep.obj-code
     2044         by tt-rep.grp-num
     2045         by tt-rep.datetime-beg
     2046         by tt-rep.sort-date
     2047         by tt-rep.sort-time:
     2048         if first-of(tt-rep.grp-num) then do:
     2049            vRowIdList = "".
     2050         end.
     2051         if tt-rep.chk-type-desc = "Аннуляция" then
     2052            vRowIdList = vRowIdList + (if vRowIdList > "" then "," else "") + string(rowid(tt-rep)).
     2053         else if tt-rep.chk-type-desc = "Продажа" then do:
     2054            do vI = 1 to num-entries(vRowIdList):
     2055               vRowId = to-rowid(entry(vI, vRowIdList)).
     2056               for first b-tt-rep where rowid(b-tt-rep) = vRowId:
     2057                  assign
     2058                     b-tt-rep.datetime-end    = tt-rep.datetime-end
     2059                     b-tt-rep.date-end        = tt-rep.date-end
     2060                     b-tt-rep.time-end        = tt-rep.time-end
     2061                     b-tt-rep.time-length     = (b-tt-rep.datetime-end - b-tt-rep.datetime-beg) / 1000
     2062                     .
     2063               end.
     2064            end.
     2065            vRowIdList = "".
     2066         end.
     2067      end.
     2068      for each tt-rep
     2069      break
     2070         by tt-rep.obj-code
     2071         by tt-rep.grp-num
     2072         by tt-rep.sort-date
     2073         by tt-rep.sort-time
     2074         by tt-rep.datetime-beg:
     2075         if first-of(tt-rep.grp-num) then do:
     2076            vI = 0.
     2077            find first b-tt-rep where
     2078                       rowid(b-tt-rep) = rowid(tt-rep).
     2079         end.
     2080         vI = vI + 1.
     2081         if last-of(tt-rep.grp-num) and vI = 2 then do:
     2082            if b-tt-rep.chk-type-desc  = "Продажа"           and
     2083               b-tt-rep.uuid           = tt-rep.uuid         and
     2084               tt-rep.uuid-cheq        begins "empty-"       and
     2085               b-tt-rep.trk-num        = tt-rep.trk-num      and
     2086               b-tt-rep.nozzle-num     = tt-rep.nozzle-num   and
     2087               b-tt-rep.fuel-code      = tt-rep.fuel-code    and
     2088               b-tt-rep.volume         = tt-rep.volume       and
     2089               b-tt-rep.datetime-beg  <= tt-rep.datetime-beg
     2090            then
     2091               tt-rep.chk-type-desc = "Перелив".
     2092         end.
     2093      end.
     2094      for each tt-rep where
     2095               not can-do(iCashPayList, string(tt-rep.cash-pay-code)):
     2096         delete tt-rep.
     2097      end.
     2098      if i-tog-shift = no then do:
     2099         for each tt-rep where
     2100                  tt-rep.datetime-beg > datetime(string(i-date-end) + " 23:59:59"):
     2101            delete tt-rep.
     2102         end.
     2103      end.
     2104      for each tt-rep
     2105      break
     2106         by tt-rep.obj-code
     2107         by tt-rep.grp-num
     2108         by tt-rep.datetime-beg
     2109         by tt-rep.sort-date
     2110         by tt-rep.sort-time:
     2111         if first-of(tt-rep.grp-num) then do:
     2112            assign
     2113               v-all-time-length    = 0
     2114               v-prev-datetime-end  = datetime("01/01/1990 00:00:00")
     2115               v-first-datetime-beg = tt-rep.datetime-beg
     2116               .
     2117         end.
     2118         if tt-rep.datetime-end > v-prev-datetime-end then
     2119            v-all-time-length = v-all-time-length + (tt-rep.datetime-end - max(tt-rep.datetime-beg, v-prev-datetime-end)) / 1000.
     2120         v-prev-datetime-end = max(tt-rep.datetime-end, v-prev-datetime-end).
     2121         if last-of(tt-rep.grp-num) then do:
     2122            find first tt-grp where
     2123                       tt-grp.grp-num = tt-rep.grp-num
     2124            no-error.
     2125            if avail tt-grp then
     2126               assign
     2127                  tt-grp.all-time-length   = v-all-time-length
     2128                  tt-grp.all-time-length-2 = (tt-rep.datetime-end - v-first-datetime-beg) / 1000
     2129                  .
     2130         end.
     2131      end.
     2132      for each tt-rep:
     2133         find first tt-grp where
     2134                    tt-grp.grp-num = tt-rep.grp-num
     2135         no-error.
     2136         if avail tt-grp then do:
     2137            assign
     2138               tt-rep.all-time-length   = tt-grp.all-time-length
     2139               tt-rep.all-time-length-2 = tt-grp.all-time-length-2
     2140               .
     2141         end.
     2142      end.
     2143      for each tt-rep where
     2144               tt-rep.all-time-length-2 < iTranTimeMax * 60:
     2145         delete tt-rep.
     2146      end.
     2147      for each tt-grp-uuid:
     2148         delete tt-grp-uuid.
     2149      end.
     2150      for each tt-rep
     2151      break
     2152         by tt-rep.obj-type
     2153         by tt-rep.obj-code
     2154         by tt-rep.sort-date
     2155         by tt-rep.sort-time
     2156         by tt-rep.uuid-cheq
     2157         by tt-rep.datetime-beg:
     2158         if first-of(tt-rep.obj-code) then do:
     2159            create tt-total-rep.
     2160            assign
     2161               tt-total-rep.obj-type = tt-rep.obj-type
     2162               tt-total-rep.obj-code = tt-rep.obj-code
     2163               tt-total-rep.obj-name = tt-rep.obj-name
     2164               .
     2165         end.
     2166         if first-of(tt-rep.uuid-cheq) then do:
     2167            vCheck = no.
     2168            tt-total-rep.qty-chk = tt-total-rep.qty-chk + 1.
     2169         end.
     2170         find first tt-grp-uuid where tt-grp-uuid.grp-num = 0
     2171                                  and tt-grp-uuid.uuid     = tt-rep.uuid
     2172         no-error.
     2173         if not available tt-grp-uuid
     2174         then do:
     2175            vCheck = yes.
     2176            create tt-grp-uuid.
     2177            assign
     2178               tt-grp-uuid.grp-num = 0
     2179               tt-grp-uuid.uuid     = tt-rep.uuid
     2180            .
     2181         end.
     2182         if last-of(tt-rep.uuid-cheq) then do:
     2183            if vCheck then
     2184               tt-total-rep.qty-chk-fuel = tt-total-rep.qty-chk-fuel + 1.
     2185         end.
     2186      end.
     2187      release tt-total-rep.
     2188      for each tt-rep,
     2189         first tt-total-rep where
     2190               tt-total-rep.obj-type = tt-rep.obj-type
     2191           and tt-total-rep.obj-code = tt-rep.obj-code
     2192           and tt-total-rep.obj-name = tt-rep.obj-name
     2193      break
     2194         by tt-rep.obj-type
     2195         by tt-rep.obj-code
     2196         by tt-rep.obj-name
     2197         by tt-rep.tran-num:
     2198         if first-of(tt-rep.tran-num) then do:
     2199            tt-total-rep.qty-tran       = tt-total-rep.qty-tran + 1.
     2200            tt-total-rep.full-time-tran = tt-total-rep.full-time-tran + tt-rep.time-length.
     2201         end.
     2202      end.
     2203      for each tt-total-rep:
     2204         tt-total-rep.avg-time-tran      = tt-total-rep.full-time-tran / tt-total-rep.qty-tran.
     2205         tt-total-rep.avg-time-tran-fuel = tt-total-rep.full-time-tran / tt-total-rep.qty-chk-fuel.
     2206      end.
     2207      for each tt-grp-uuid:
     2208         delete tt-grp-uuid.
     2209      end.
     2210      for each tt-rep
     2211      break
     2212         by tt-rep.obj-type
     2213         by tt-rep.obj-code
     2214         by tt-rep.sort-date
     2215         by tt-rep.sort-time
     2216         by tt-rep.uuid-cheq
     2217         by tt-rep.datetime-beg:
     2218         if first-of(tt-rep.obj-code) then do:
     2219            create tt-all-total-rep.
     2220            assign
     2221               tt-all-total-rep.obj-type = tt-rep.obj-type
     2222               tt-all-total-rep.obj-code = tt-rep.obj-code
     2223               .
     2224         end.
     2225         if first-of(tt-rep.uuid-cheq) then do:
     2226            vCheck = no.
     2227            tt-all-total-rep.qty-chk = tt-all-total-rep.qty-chk + 1.
     2228         end.
     2229         find first tt-grp-uuid where tt-grp-uuid.grp-num = 0
     2230                                  and tt-grp-uuid.uuid     = tt-rep.uuid
     2231         no-error.
     2232         if not available tt-grp-uuid
     2233         then do:
     2234            vCheck = yes.
     2235            create tt-grp-uuid.
     2236            assign
     2237               tt-grp-uuid.grp-num = 0
     2238               tt-grp-uuid.uuid     = tt-rep.uuid
     2239            .
     2240         end.
     2241         if last-of(tt-rep.uuid-cheq) then do:
     2242            if vCheck then
     2243               tt-all-total-rep.qty-chk-fuel = tt-all-total-rep.qty-chk-fuel + 1.
     2244         end.
     2245      end.
     2246      release tt-all-total-rep.
     2247      for each tt-rep,
     2248         first tt-all-total-rep where
     2249               tt-all-total-rep.obj-type = tt-rep.obj-type
     2250           and tt-all-total-rep.obj-code = tt-rep.obj-code
     2251      break
     2252         by tt-rep.obj-type
     2253         by tt-rep.obj-code
     2254         by tt-rep.tran-num:
     2255         if first-of(tt-rep.tran-num) then do:
     2256            tt-all-total-rep.qty-tran       = tt-all-total-rep.qty-tran + 1.
     2257            tt-all-total-rep.full-time-tran = tt-all-total-rep.full-time-tran + tt-rep.time-length.
     2258         end.
     2259      end.
     2260      for each tt-all-total-rep:
     2261         tt-all-total-rep.avg-time-tran      = tt-all-total-rep.full-time-tran / tt-all-total-rep.qty-tran.
     2262         tt-all-total-rep.avg-time-tran-fuel = tt-all-total-rep.full-time-tran / tt-all-total-rep.qty-chk-fuel.
     2263      end.
     2264   end.
     2265   define private temp-table ttTranFuel no-undo
     2266      field line-num     as integer
     2267      field trn-num      as integer
     2268      field db-num       as integer
     2269      field uuid         as character
     2270      field uuid-cheq    as character
     2271      field chk-type     as integer
     2272      field chk-date     as date
     2273      field chk-time     as integer
     2274      field trk-num      as integer
     2275      field trn-start    as datetime
     2276      field trn-end      as datetime
     2277      field trn-prnt     as integer
     2278      field trn-prnt-trk as integer
     2279      field trn-chld     as integer
     2280      field trn-chld-trk as integer
     2281   index pi db-num uuid uuid-cheq
     2282   index si trn-start trn-end chk-date chk-time
     2283   .
     2284   define private temp-table tt-recid-TranFuel no-undo
     2285      field rec-id as recid
     2286   .
     2287     define property Msg as character no-undo
     2288       get:
     2289         return trim (Msg, chr(10)).
     2290       end.
     2291       private set (inArg as char):
     2292         Msg = Msg + chr(10) + inArg.
     2293       end.
     2294       define property InitSecTag as character no-undo init 'sales-p-shifts':U
     2295       get.
     2296     define public property sendTableName  as character  no-undo
     2297       get.
     2298       private set.
     2299     define public property sendOldRowid as rowid  no-undo
     2300       get.
     2301       set.
     2302     define public property sendNewRowid as rowid  no-undo
     2303       get.
     2304       set.
     2305     define property BufHandle as handle no-undo
     2306       get.
     2307       set.
     2308     define private variable libFindtank as class ibs.th.str.findtank no-undo .
     2309     define private variable mRepShiftNum  as integer no-undo.
     2310     define private variable mRepShiftDate as date    no-undo.
     2311                                       constructor public check ():
     2312        super().
     2313        libFindtank = new ibs.th.str.findtank ().
     2314     end constructor.
     2315     method public void CrContentToSW (insw as handle):
     2316   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2317       define variable v-fld-host-code  as handle no-undo .
     2318       define variable v-fld-obj-type   as handle no-undo .
     2319       define variable v-fld-obj-code   as handle no-undo .
     2320       define variable v-fld-shift-date as handle no-undo .
     2321       define variable v-fld-shift-num  as handle no-undo .
     2322       define variable v-host-code      as integer no-undo .
     2323       define variable v-obj-type       as character no-undo .
     2324       define variable v-obj-code       as integer no-undo .
     2325       define variable v-shift-date     as date no-undo .
     2326       define variable v-shift-num      as integer no-undo .
     2327       define variable v-user-name      as character no-undo .
     2328       define variable v-inkas-dtime    as datetime no-undo .
     2329       define variable v-en-chktype     as enum-chk-type no-undo .
     2330       define buffer chk-doc-attr for ub.chk-doc-attr.
     2331       define buffer buf_inkas          for ub.inkas .
     2332       define buffer over_buf_chk-doc   for ub.chk-doc .
     2333       Msg = "" .
     2334       if not valid-handle(BufHandle) then undo, throw new Progress.Lang.AppError("Отсутствует запись СМЕНЫ shift_obj с документами продажи") .
     2335       sendTableName = BufHandle:table.
     2336       sendOldRowid  = BufHandle:rowid.
     2337     if BufHandle:table <> "chk-doc" then do:
     2338       assign
     2339         v-fld-host-code  = BufHandle:buffer-field( "host-code":U  )
     2340         v-fld-obj-type   = BufHandle:buffer-field( "obj-type":U  )
     2341         v-fld-obj-code   = BufHandle:buffer-field( "obj-code":U  )
     2342         v-fld-shift-date = BufHandle:buffer-field( "shift-date":U  )
     2343         v-fld-shift-num  = BufHandle:buffer-field( "shift-num":U  )
     2344       .
     2345       assign
     2346         v-host-code  = v-fld-host-code:buffer-value
     2347         v-obj-type   = v-fld-obj-type:buffer-value
     2348         v-obj-code   = v-fld-obj-code:buffer-value
     2349         v-shift-date = v-fld-shift-date:buffer-value
     2350         v-shift-num  = v-fld-shift-num:buffer-value
     2351       .
     2352       insw:start-element ('shift':U) .
     2353       if v-shift-date = ? then insw:write-empty-element ( "shift-date":U ) .
     2354                           else insw:write-data-element (  "shift-date":U,  iso-date(v-shift-date)  ).
     2355       if v-shift-num  = ? then insw:write-empty-element ( "shift-num":U  ) .
     2356                           else insw:write-data-element (  "shift-num":U,   string(v-shift-num)     ).
     2357       insw:start-element ('checks':U) .
     2358       for each buf_inkas no-lock
     2359          where buf_inkas.host-code  = v-host-code
     2360            and buf_inkas.obj-type   = v-obj-type
     2361            and buf_inkas.obj-code   = v-obj-code
     2362            and buf_inkas.shift-date = v-shift-date
     2363            and buf_inkas.shift-num  = v-shift-num
     2364            and buf_inkas.status_    = 'факт':U
     2365       :
     2366   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2367   run usrfulnm in ibs.th.gbl.gbl-hndllib:g#library
     2368     (input  buf_inkas.user-name
     2369     ,output v-user-name
     2370     )  .
     2371       run rep/rpychk0.p ( input "bgepych2"
     2372                         , input v-obj-type
     2373                         , input v-obj-code
     2374                         ,input ?
     2375                         ,input ?
     2376                         ,input ?
     2377                         ,input ?
     2378                         ,input ?
     2379                         ,input ?
     2380                         , input buf_inkas.inkas-code
     2381                         ) .
     2382       v-inkas-dtime = datetime(buf_inkas.fact-date, buf_inkas.sys-time-int * 1000) .
     2383       for each over_buf_chk-doc no-lock
     2384          where over_buf_chk-doc.out-code = buf_inkas.inkas-code:
     2385         v-en-chktype = enum-chk-type:GetEnum(over_buf_chk-doc.chk-type) no-error .
     2386         if not error-status:error then
     2387           CrContentInterfaceToSW (insw, buffer over_buf_chk-doc, v-inkas-dtime, v-user-name,
     2388             v-host-code, v-obj-type, v-obj-code) .
     2389       end .
     2390       for each chk-doc-attr where attr-code = 'CHFlag1S' and attr-value = 'no' exclusive-lock:
     2391          for each over_buf_chk-doc  no-lock  where over_buf_chk-doc.doc-code = chk-doc-attr.doc-code:
     2392             v-en-chktype = enum-chk-type:GetEnum(over_buf_chk-doc.chk-type) no-error .
     2393             if not error-status:error
     2394             then
     2395                CrContentInterfaceToSW (insw,
     2396                                        buffer over_buf_chk-doc,
     2397                                        v-inkas-dtime,
     2398                                        v-user-name,
     2399                                        v-host-code,
     2400                                        v-obj-type,
     2401                                        v-obj-code) .
     2402          end.
     2403          delete chk-doc-attr.
     2404       end.
     2405     end.
     2406     insw:end-element ('checks':U) .
     2407     insw:end-element ('shift':U) .
     2408    END.
     2409   if BufHandle:table = "chk-doc" then do:
     2410         define variable v-curr-sv-date as date no-undo .
     2411         run gbl/getcurdt.p  (output v-curr-sv-date ) .
     2412       assign
     2413         v-fld-obj-type   = BufHandle:buffer-field( "obj-type":U  )
     2414         v-fld-obj-code   = BufHandle:buffer-field( "obj-code":U  )
     2415         v-fld-shift-num  = BufHandle:buffer-field( "shift-num":U  )
     2416       .
     2417       assign
     2418         v-obj-type   = v-fld-obj-type:buffer-value
     2419         v-obj-code   = v-fld-obj-code:buffer-value
     2420         v-shift-date = v-curr-sv-date
     2421         v-shift-num  = v-fld-shift-num:buffer-value
     2422       .
     2423       find first shift-obj where shift-obj.status_ = "ТЕК" and shift-obj.obj-code = v-obj-code no-error.
     2424       IF AVAILABLE shift-obj THEN v-shift-num = shift-obj.shift-num.
     2425       else v-shift-num = 0.
     2426       insw:start-element ('shift':U) .
     2427       insw:write-data-element (  "shift-date":U,  iso-date(v-shift-date) ).
     2428       insw:write-data-element (  "shift-num":U,   string(v-shift-num)    ).
     2429       insw:start-element ('checks':U) .
     2430       for each chk-doc-attr where chk-doc-attr.attr-code = 'CHFlag1S' and chk-doc-attr.attr-value = 'no' exclusive-lock:
     2431          for each over_buf_chk-doc  no-lock  where
     2432                   over_buf_chk-doc.doc-code = chk-doc-attr.doc-code:
     2433             if over_buf_chk-doc.chk-type eq 40 or over_buf_chk-doc.chk-type eq 13 then
     2434             do:
     2435                v-en-chktype = enum-chk-type:GetEnum(over_buf_chk-doc.chk-type) no-error .
     2436                if not error-status:error then
     2437                CrContentInterfaceToSW (insw, buffer over_buf_chk-doc, v-inkas-dtime, v-user-name,
     2438                v-host-code, v-obj-type, v-obj-code) .
     2439                delete chk-doc-attr.
     2440             end.
     2441          end.
     2442       end .
     2443   insw:end-element ('checks':U) .
     2444   insw:end-element ('shift':U) .
     2445   END.
     2446       catch exAppErrors as class Progress.Lang.AppError :
     2447         Msg = exAppErrors:ReturnValue .
     2448         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
     2449         undo, throw exAppErrors .
     2450       end catch .
     2451       catch exProErrors as class Progress.Lang.ProError :
     2452         Msg = exProErrors:GetMessage(1) .
     2453         undo, throw exProErrors .
     2454       end catch .
     2455       catch exAnyErrors as class Progress.Lang.Error:
     2456         Msg = "Unexpected error occurred..." .
     2457         undo, throw exAnyErrors .
     2458       end catch .
     2459     end method .
     2460     method private void CrTTFuelTran (buffer p-buf_chk-doc for ub.chk-doc):
     2461      define buffer chk-doc-attr  for chk-doc-attr.
     2462      define buffer chk-gds       for chk-gds.
     2463      define buffer b-chk-gds     for chk-gds.
     2464      define buffer bar-code      for bar-code.
     2465      define buffer goods         for goods.
     2466      define buffer prod-bc       for prod-bc.
     2467      define buffer tran-fuel     for tran-fuel.
     2468      define buffer b-tran-fuel   for tran-fuel.
     2469      define buffer b2-tran-fuel  for tran-fuel.
     2470      define buffer b-ttTranFuel  for ttTranFuel.
     2471      define variable vRecId as recid   no-undo.
     2472      empty temp-table ttTranFuel.
     2473      for each chk-doc-attr where
     2474               chk-doc-attr.doc-code  = p-buf_chk-doc.doc-code
     2475           and chk-doc-attr.attr-code = "CheckId"
     2476      no-lock,
     2477          each chk-gds where
     2478               chk-gds.doc-code = p-buf_chk-doc.doc-code
     2479      no-lock:
     2480         if can-find(first ttTranFuel where ttTranFuel.uuid-cheq = chk-doc-attr.attr-value) then
     2481            next.
     2482         empty temp-table tt-recid-TranFuel.
     2483         for first bar-code where
     2484                   bar-code.b-code = chk-gds.b-code
     2485         no-lock,
     2486             first goods where
     2487                   goods.gds-code = bar-code.gds-code
     2488         no-lock:
     2489            for first prod-bc where
     2490                      prod-bc.b-code = chk-gds.b-code
     2491            no-lock,
     2492                each tran-fuel where
     2493                     tran-fuel.uuid-cheq = chk-doc-attr.attr-value
     2494                 and tran-fuel.fuel-code = integer(prod-bc.b-str)
     2495            no-lock:
     2496               create tt-recid-TranFuel.
     2497               tt-recid-TranFuel.rec-id = recid(tran-fuel).
     2498            end.
     2499            for each tran-fuel where
     2500                     tran-fuel.uuid-cheq = chk-doc-attr.attr-value
     2501                 and tran-fuel.fuel-code = goods.gds-code
     2502            no-lock:
     2503               create tt-recid-TranFuel.
     2504               tt-recid-TranFuel.rec-id = recid(tran-fuel).
     2505            end.
     2506         end.
     2507         for each tt-recid-TranFuel,
     2508            first tran-fuel where
     2509                  recid(tran-fuel) = tt-recid-TranFuel.rec-id
     2510         no-lock:
     2511            find first tt-rep where
     2512                       tt-rep.uuid      = tran-fuel.uuid
     2513                   and tt-rep.uuid-cheq = tran-fuel.uuid-cheq
     2514            no-error.
     2515            create ttTranFuel.
     2516            assign
     2517               ttTranFuel.line-num     = chk-gds.line-num
     2518               ttTranFuel.trn-num      = tran-fuel.tran-num
     2519               ttTranFuel.trn-start    = if avail tt-rep then
     2520                                            tt-rep.datetime-beg
     2521                                         else
     2522                                            tran-fuel.date-beg + timezone * 60000
     2523               ttTranFuel.trn-end      = if avail tt-rep then
     2524                                            tt-rep.datetime-end
     2525                                         else
     2526                                            tran-fuel.date-end + timezone * 60000
     2527               ttTranFuel.trk-num      = tran-fuel.trk-num + 1
     2528               ttTranFuel.db-num       = tran-fuel.db-num
     2529               ttTranFuel.uuid         = tran-fuel.uuid
     2530               ttTranFuel.uuid-cheq    = tran-fuel.uuid-cheq
     2531               ttTranFuel.chk-type     = p-buf_chk-doc.chk-type
     2532               ttTranFuel.chk-date     = p-buf_chk-doc.chk-date
     2533               ttTranFuel.chk-time     = p-buf_chk-doc.chk-time
     2534               .
     2535            if p-buf_chk-doc.chk-type = 16 then do:
     2536               find first b-chk-gds where
     2537                          b-chk-gds.doc-code =  p-buf_chk-doc.doc-code
     2538                      and b-chk-gds.line-num <> chk-gds.line-num
     2539               no-lock no-error.
     2540               if avail b-chk-gds then do:
     2541                  find first b-tran-fuel where
     2542                             b-tran-fuel.db-num    =  tran-fuel.db-num
     2543                         and b-tran-fuel.uuid      =  tran-fuel.uuid
     2544                         and b-tran-fuel.uuid-cheq <> tran-fuel.uuid-cheq
     2545                  no-lock no-error.
     2546                  if avail b-tran-fuel then do:
     2547                     find first b2-tran-fuel where
     2548                                b2-tran-fuel.db-num    =  b-tran-fuel.db-num
     2549                            and b2-tran-fuel.uuid-cheq =  b-tran-fuel.uuid-cheq
     2550                            and b2-tran-fuel.uuid      <> b-tran-fuel.uuid
     2551                     no-lock no-error.
     2552                     if avail b2-tran-fuel then do:
     2553                        find first tt-rep where
     2554                                   tt-rep.uuid      = b2-tran-fuel.uuid
     2555                               and tt-rep.uuid-cheq = b2-tran-fuel.uuid-cheq
     2556                        no-error.
     2557                        create ttTranFuel.
     2558                        assign
     2559                           ttTranFuel.line-num     = b-chk-gds.line-num
     2560                           ttTranFuel.trn-num      = b2-tran-fuel.tran-num
     2561                           ttTranFuel.trn-start    = if avail tt-rep then
     2562                                                        tt-rep.datetime-beg
     2563                                                     else
     2564                                                        b2-tran-fuel.date-beg + timezone * 60000
     2565                           ttTranFuel.trn-end      = if avail tt-rep then
     2566                                                        tt-rep.datetime-end
     2567                                                     else
     2568                                                        b2-tran-fuel.date-end + timezone * 60000
     2569                           ttTranFuel.trk-num      = b2-tran-fuel.trk-num + 1
     2570                           ttTranFuel.db-num       = b2-tran-fuel.db-num
     2571                           ttTranFuel.uuid         = b2-tran-fuel.uuid
     2572                           ttTranFuel.uuid-cheq    = tran-fuel.uuid-cheq
     2573                           ttTranFuel.chk-type     = p-buf_chk-doc.chk-type
     2574                           ttTranFuel.chk-date     = p-buf_chk-doc.chk-date
     2575                           ttTranFuel.chk-time     = p-buf_chk-doc.chk-time
     2576                           .
     2577                     end.
     2578                  end.
     2579               end.
     2580            end.
     2581         end.
     2582      end.
     2583      for each ttTranFuel:
     2584         find first tt-rep where
     2585                    tt-rep.uuid      = ttTranFuel.uuid
     2586                and tt-rep.uuid-cheq = ttTranFuel.uuid-cheq
     2587         no-error.
     2588         if avail tt-rep then
     2589            assign
     2590               ttTranFuel.trn-start = tt-rep.datetime-beg
     2591               ttTranFuel.trn-end   = tt-rep.datetime-end
     2592               .
     2593      end.
     2594      vRecId = ?.
     2595      for each ttTranFuel
     2596      break
     2597         by ttTranFuel.trn-start
     2598         by ttTranFuel.trn-end
     2599         by ttTranFuel.chk-date
     2600         by ttTranFuel.chk-time:
     2601         if vRecId <> ? then do:
     2602            find first b-ttTranFuel where
     2603                       recid(b-ttTranFuel) = vRecId
     2604            no-error.
     2605            if avail b-ttTranFuel then do:
     2606               assign
     2607                  b-ttTranFuel.trn-chld     = ttTranFuel.trn-num
     2608                  b-ttTranFuel.trn-chld-trk = ttTranFuel.trk-num
     2609                  ttTranFuel.trn-prnt       = b-ttTranFuel.trn-num
     2610                  ttTranFuel.trn-prnt-trk   = b-ttTranFuel.trk-num
     2611                  .
     2612            end.
     2613         end.
     2614         vRecId = recid(ttTranFuel).
     2615      end.
     2616     end method.
     2617           destructor public check ( ):
     2618          if valid-object(libFindtank) then delete object libFindtank .
     2619           end destructor.
     2620     method private void CrContentInterfaceToSW (insw as handle
     2621                                             , buffer p-buf_chk-doc for ub.chk-doc
     2622                                             , input p-inkas-dtime    as datetime
     2623                                             , input p-inkas-operator as character
     2624                                             , input p-host-code      as integer
     2625                                             , input p-obj-type       as character
     2626                                             , input p-obj-code       as integer
     2627                                             ) :
     2628       define buffer buf_dis-card     for ub.dis-card .
     2629       define buffer buf_chk-doc-attr for ub.chk-doc-attr .
     2630       define buffer chk-doc-attr for ub.chk-doc-attr .
     2631       define buffer buf_chk-gds      for ub.chk-gds .
     2632       define buffer buf_bar-code     for ub.bar-code .
     2633       define buffer buf_goods        for ub.goods .
     2634       define buffer buf_chk-gds-attr for ub.chk-gds-attr .
     2635       define buffer buf_chk-pay      for ub.chk-pay .
     2636       define buffer buf_chk-pay-attr for ub.chk-pay-attr .
     2637       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2638       define buffer buf_chk-discnt   for ub.chk-discnt .
     2639       define buffer bf_chk-discnt    for ub.chk-discnt .
     2640       define buffer buf_chk-gds-pay  for ub.chk-gds-pay .
     2641       define buffer buf_OperServ     for ub.OperServ .
     2642       define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     2643       define buffer buf_clients      for ub.clients .
     2644       define buffer buf_cash-desk    for ub.cash-desk .
     2645       define buffer buf_doc-line     for ub.doc-line .
     2646       define buffer buf_parts        for ub.parts .
     2647       define buffer buf_marking-chk  for ub.marking-chk .
     2648       define variable v-is-petrolium as logical no-undo .
     2649       define variable v-price-azs    as decimal no-undo .
     2650       define variable v-is-pieces    as logical no-undo .
     2651       define variable v-loc1         as character no-undo .
     2652       define variable v-spump        as character no-undo .
     2653       define variable v-snozzle-code as character no-undo .
     2654       define variable v-key-one      as integer no-undo .
     2655       define variable v-is-nds       as integer no-undo .
     2656       define variable v-ex-Nds       as logical no-undo.
     2657       define variable v-chk-pay-is-nds as logical no-undo .
     2658       define variable v-sum-s        as decimal no-undo .
     2659       define variable v-parts-qnty   as decimal no-undo .
     2660       define variable v-marking      as character no-undo .
     2661       define variable v-sum-promo    as decimal no-undo .
     2662       define variable v-pcnt-promo   as decimal no-undo .
     2663       define variable v-b-code       as integer no-undo.
     2664       define variable v-gds-qnty     as decimal no-undo.
     2665       define variable v-disc-promo-id as integer no-undo.
     2666       define variable v-disc-promo-count as int no-undo.
     2667       define variable v-line-num-promo as int no-undo.
     2668       insw:start-element ('check':U) .
     2669       if p-buf_chk-doc.shift-date = ? then insw:write-empty-element ( "shift-date":U ) .
     2670       else insw:write-data-element (  "shift-date":U,  iso-date(p-buf_chk-doc.shift-date)  ).
     2671       insw:write-data-element (  "shift-num":U,       string(if p-buf_chk-doc.shift-num = 0 then p-buf_chk-doc.shift-name else string(p-buf_chk-doc.shift-num))   ).
     2672       insw:write-data-element (  "chk-num":U,         string(p-buf_chk-doc.chk-num)     ).
     2673       insw:write-data-element (  "cb-num":U,          string(p-buf_chk-doc.pay-desk)    ).
     2674       insw:write-data-element (  "chk-id":U,                 p-buf_chk-doc.doc-code     ).
     2675       define variable v-c-type as integer no-undo .
     2676       v-c-type = 0 .
     2677       find first buf_clients no-lock
     2678            where buf_clients.obj-code = p-obj-code
     2679              and buf_clients.obj-type = p-obj-type no-error .
     2680       if available buf_clients then do :
     2681         find first buf_cash-desk no-lock
     2682              where buf_cash-desk.db-num   = buf_clients.db-num
     2683                and buf_cash-desk.obj-code = p-obj-code
     2684                and buf_cash-desk.cash-num = p-buf_chk-doc.pay-desk no-error .
     2685         if available buf_cash-desk then do :
     2686           v-c-type = buf_cash-desk.device-kind .
     2687         end .
     2688       end .
     2689       insw:write-data-element (  "c-type":U,  string(v-c-type)  ).
     2690       if p-buf_chk-doc.doc-num > "" then
     2691       insw:write-data-element (  "ext-num":U,         p-buf_chk-doc.doc-num   ).
     2692       if p-buf_chk-doc.doc-num2 > "" then
     2693       insw:write-data-element (  "direct-chk-num":U,  p-buf_chk-doc.doc-num2  ).
     2694       if p-buf_chk-doc.chk-date = ? then insw:write-empty-element( "chk-date":U ).
     2695       else insw:write-data-element (  "chk-date":U,  iso-date(p-buf_chk-doc.chk-date)  ).
     2696       insw:write-data-element (  "chk-time",     timeFormat(p-buf_chk-doc.chk-time)    ).
     2697       insw:write-data-element (  "cashier",          string(p-buf_chk-doc.cashier)     ).
     2698       insw:write-data-element (  "z-num",            string(p-buf_chk-doc.z-number)    ).
     2699       insw:write-data-element (  "chk-type", left-trim(string(p-buf_chk-doc.chk-type, ">9"))    ).
     2700       insw:write-data-element (  "netto",   left-trim(string(p-buf_chk-doc.netto,   "->>>>>>>>9.9<"))  ).
     2701       insw:write-data-element (  "tot-doc", left-trim(string(p-buf_chk-doc.tot-doc, "->>>>>>>>9.9<"))  ).
     2702       if p-buf_chk-doc.chk-type <> 13 and p-buf_chk-doc.chk-type <> 40     then
     2703        do:
     2704           find first buf_chk-doc-attr where buf_chk-doc-attr.doc-code  eq p-buf_chk-doc.doc-code
     2705                                     and buf_chk-doc-attr.attr-code eq "CHMgrKey"
     2706                no-lock no-error.
     2707          if avail buf_chk-doc-attr
     2708          then
     2709          insw:write-data-element( "CHMgrKey",  buf_chk-doc-attr.attr-value).
     2710       end.
     2711       if p-buf_chk-doc.chk-type <> 13 and p-buf_chk-doc.chk-type <> 40     then
     2712        do:
     2713             find first chk-doc-attr where chk-doc-attr.doc-code = p-buf_chk-doc.doc-code
     2714               and chk-doc-attr.attr-code = 'CHFlag1' no-lock no-error.
     2715               if available chk-doc-attr then
     2716               do:
     2717                 insw:write-data-element (  "CHFlag1",  string(chk-doc-attr.attr-value)  ) .
     2718                 if chk-doc-attr.attr-value = "0" then
     2719                   insw:write-data-element (  "Dry-chk-th",  string(chk-doc-attr.attr-value)  ) .
     2720               end.
     2721       end.
     2722       find first buf_chk-doc-attr where buf_chk-doc-attr.doc-code  eq p-buf_chk-doc.doc-code
     2723                                     and buf_chk-doc-attr.attr-code eq "CHNumberKKT"
     2724                no-lock no-error.
     2725       if avail buf_chk-doc-attr
     2726       then
     2727          insw:write-data-element( "CHNumberKKT",  buf_chk-doc-attr.attr-value).
     2728       find first buf_chk-doc-attr where buf_chk-doc-attr.doc-code  eq p-buf_chk-doc.doc-code
     2729                                     and buf_chk-doc-attr.attr-code eq "CHNumberFN"
     2730                no-lock no-error.
     2731       if avail buf_chk-doc-attr
     2732       then
     2733          insw:write-data-element( "CHNumberFN",  buf_chk-doc-attr.attr-value).
     2734       if "" > "" then insw:write-data-element ( "term-num", "" ).
     2735       if p-buf_chk-doc.d-card > "" then do:
     2736         insw:write-data-element (  "dc-num":U,     p-buf_chk-doc.src-d-card     ).
     2737         find first buf_dis-card no-lock
     2738              where buf_dis-card.d-card = p-buf_chk-doc.d-card no-error .
     2739         if available buf_dis-card then do:
     2740           if buf_dis-card.card-num > 0 then
     2741         insw:write-data-element (  "dc-name":U,    string(buf_dis-card.type)  ).
     2742         end.
     2743       end.
     2744       if p-inkas-operator > "" then
     2745         insw:write-data-element (  "operator":U,   p-inkas-operator           ).
     2746       if p-buf_chk-doc.out-code > "" then // chk-doc.out-code хранит значение из inkas.inkas-code
     2747         insw:write-data-element (  "prdoc-num":U,  p-buf_chk-doc.out-code     ).
     2748       if p-inkas-dtime = ? then insw:write-data-element ("prdoc-date":U, SUBSTITUTE("&1T&2", iso-date(p-buf_chk-doc.chk-date), timeFormat(p-buf_chk-doc.chk-time) )).
     2749       else  insw:write-data-element (  "prdoc-date":U, iso-date(p-inkas-dtime)    ).
     2750           v-chk-pay-is-nds = false .
     2751       for each buf_cash-pay-attr no-lock
     2752          where buf_cash-pay-attr.attr-code  = "cash-prop"
     2753            and can-do ("1,2,3,6,7", buf_cash-pay-attr.attr-value) :
     2754         if can-find (first buf_chk-pay
     2755                      where buf_chk-pay.doc-code  = p-buf_chk-doc.doc-code
     2756                        and buf_chk-pay.pay-code  = buf_cash-pay-attr.cdpay-code
     2757                        and buf_chk-pay.curr-code = buf_cash-pay-attr.curr-code) then do :
     2758           v-chk-pay-is-nds = true .
     2759           leave .
     2760         end .
     2761       end .
     2762       find first buf_chk-doc-attr no-lock
     2763            where buf_chk-doc-attr.doc-code  eq p-buf_chk-doc.doc-code
     2764              and buf_chk-doc-attr.attr-code eq "CHFiscalDocSign" no-error .
     2765       if available buf_chk-doc-attr then
     2766         insw:write-data-element (  "fpd":U,  buf_chk-doc-attr.attr-value     ).
     2767       assign
     2768          v-ex-Nds = no
     2769          v-b-code = 0
     2770          v-gds-qnty = 0
     2771          .
     2772       if can-find (first buf_chk-gds where buf_chk-gds.doc-code = p-buf_chk-doc.doc-code) then do:
     2773       insw:start-element ('chk-gds':U) .
     2774         for each buf_chk-gds no-lock
     2775            where buf_chk-gds.doc-code = p-buf_chk-doc.doc-code :
     2776           v-ex-Nds = v-ex-Nds or buf_chk-gds.VAT-pc eq ? or buf_chk-gds.VAT-sum-rubl eq ? .
     2777           insw:start-element ('chk-gd':U) .
     2778           insw:write-data-element (  "line-num",  string(buf_chk-gds.line-num)  ) .
     2779           find first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code no-error.
     2780           if available buf_bar-code then do:
     2781             find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     2782             if available buf_goods then do:
     2783   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in ibs.th.gbl.gbl-hndllib:g#lib-trn
     2784     (
     2785        input buf_goods.artic
     2786     ,  input buf_goods.prod-type
     2787     ,  input buf_goods.prod-code
     2788     , output v-is-petrolium
     2789     , output v-is-pieces
     2790     ) .
     2791               if v-is-petrolium then
     2792               assign
     2793                  v-b-code = buf_chk-gds.b-code
     2794                  v-gds-qnty = buf_chk-gds.src-qnty
     2795                  .
     2796             end .
     2797             else v-is-petrolium = false .
     2798           end .
     2799           else v-is-petrolium = false .
     2800           if v-is-petrolium then do :
     2801             if buf_chk-gds.pl-code > 0 then v-loc1 = string (buf_chk-gds.pl-code).
     2802             else if available buf_bar-code then do:
     2803               v-loc1 = getTankNum
     2804                 (input p-buf_chk-doc.obj-type
     2805                 ,input p-buf_chk-doc.obj-code
     2806                 ,input buf_chk-gds.pump
     2807                 ,input buf_chk-gds.nozzle-code
     2808                 ,input buf_chk-gds.src-pl-code
     2809                 ,input buf_chk-gds.pl-code
     2810                 ,input buf_bar-code.gds-code
     2811                 ) .
     2812             end.
     2813             else v-loc1 = "" .
     2814             assign
     2815               v-spump        = string(buf_chk-gds.pump)
     2816               v-snozzle-code = string(buf_chk-gds.nozzle-code)
     2817             .
     2818           end .
     2819           else assign
     2820             v-loc1  = ""
     2821             v-spump = ""
     2822             v-snozzle-code = ""
     2823           .
     2824           insw:write-data-element (  "trk-num",  if v-spump        > "" then v-spump        else "0"  ) .
     2825           insw:write-data-element (  "tank-num", if v-loc1         > "" then v-loc1         else "0"  ) .
     2826           insw:write-data-element (  "trk-pnum", if v-snozzle-code > "" then v-snozzle-code else "0"  ) .
     2827           if available buf_bar-code then insw:write-data-element (  "gd-code",  string(buf_bar-code.gds-code)  ) .
     2828                                     else insw:write-empty-element ( "gd-code" ) .
     2829           insw:write-data-element (  "qnty",  left-trim(string(buf_chk-gds.doc-qnty, "->>>>>>>9.999"))  ) .
     2830           if v-is-petrolium and (buf_chk-gds.density > 0) then do :
     2831             insw:write-data-element (  "wght",
     2832               left-trim( string(buf_chk-gds.doc-qnty * buf_chk-gds.density, "->>>>>>>>9.999") )
     2833             ) .
     2834           end.
     2835           find first buf_chk-gds-attr no-lock where
     2836                      buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2837                  and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2838                  and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2839               no-error.
     2840           if avail buf_chk-gds-attr then v-sum-promo = dec(buf_chk-gds-attr.attr-value) no-error.
     2841           else v-sum-promo = 0.
     2842           insw:write-data-element (  "sum",
     2843             if buf_chk-gds.sum-base = ?
     2844             then  "0"
     2845             else  left-trim( string(buf_chk-gds.sum-base + v-sum-promo, "->>>>>>>>9.99") )
     2846           ) .
     2847           if available buf_goods
     2848           then do :
     2849             assign
     2850               v-sum-s = 0
     2851               v-parts-qnty = 0
     2852             .
     2853             for each buf_parts no-lock where buf_parts.out-code   = p-buf_chk-doc.out-code
     2854                                            and buf_parts.artic      = buf_goods.artic
     2855                                            and buf_parts.prod-code  = buf_goods.prod-code
     2856                                            and buf_parts.prod-type  = buf_goods.prod-type :
     2857               assign
     2858                 v-parts-qnty = v-parts-qnty + buf_parts.fact-qnty
     2859                 v-sum-s = v-sum-s + (buf_parts.fact-qnty * buf_parts.price-rubl / (1 + (buf_parts.VAT-pc / 100)))
     2860               .
     2861             end.
     2862             if v-parts-qnty > 0 then v-sum-s = v-sum-s / v-parts-qnty * buf_chk-gds.doc-qnty .
     2863             if v-sum-s <> 0
     2864             then do :
     2865               insw:write-data-element (  "sum-s",
     2866                 left-trim( string(v-sum-s, "->>>>>>>>9.99") )
     2867               ) .
     2868             end.
     2869             else do :
     2870               insw:write-data-element (  "sum-s", "0" ) .
     2871             end.
     2872           end.
     2873           if (buf_chk-gds.discnt <> 0) or (v-sum-promo <> 0) then
     2874           insw:write-data-element (  "sum-discnt",
     2875             left-trim( string(buf_chk-gds.doc-qnty * buf_chk-gds.discnt + v-sum-promo, "->>>>>>>>>9.9<<<<<<<<<") )
     2876           ) .
     2877           if v-is-petrolium and (buf_chk-gds.density > 0) then
     2878           insw:write-data-element (  "dnsty",  string(buf_chk-gds.density, "9.9999999999")  ) .
     2879           if buf_chk-gds.pass-gds > 0 then
     2880           insw:write-data-element (  "dry-chk",  string(buf_chk-gds.pass-gds)  ) .
     2881           if v-chk-pay-is-nds then do :
     2882             if buf_chk-gds.VAT-pc ne ? then
     2883               insw:write-data-element (  "vat-rate",  string(buf_chk-gds.VAT-pc)        ) .
     2884             if buf_chk-gds.VAT-sum-rubl ne ? then
     2885               insw:write-data-element (  "vat",       string(buf_chk-gds.VAT-sum-rubl)  ) .
     2886           end .
     2887           find first buf_chk-gds-attr no-lock
     2888                where buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2889                  and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2890                  and buf_chk-gds-attr.attr-code = 'oss-code':U no-error .
     2891           if available buf_chk-gds-attr then do:
     2892             v-key-one = integer (buf_chk-gds-attr.attr-value) no-error .
     2893             find first buf_OperServ no-lock where buf_OperServ.id = v-key-one no-error .
     2894             if available buf_OperServ then do :
     2895               insw:write-data-element (  "operator-code",  buf_OperServ.ext-code  ) .
     2896               insw:write-data-element (  "operator-name",  buf_OperServ.OSname    ) .
     2897             end .
     2898           end .
     2899           find first buf_chk-gds-attr no-lock
     2900                where buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2901                  and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2902                  and buf_chk-gds-attr.attr-code = "agent-gd-code":U no-error .
     2903           if available buf_chk-gds-attr then do:
     2904             insw:write-data-element (  "srt-BC",  buf_chk-gds-attr.attr-value  ) .
     2905           end .
     2906           insw:write-data-element (  "price",  left-trim(string(buf_chk-gds.src-price, "->>>>>>>>9.99"))  ) .
     2907           if enum-chk-type:GetEnum(p-buf_chk-doc.chk-type) = enum-chk-type:entranscancell then do:
     2908             if buf_chk-gds.write-off-code >= 0 then
     2909               insw:write-data-element (  "prolito",  string(buf_chk-gds.write-off-code)  ).
     2910           end .
     2911           insw:write-data-element (  "src-code",  string(buf_chk-gds.src-code)  ) .
     2912           find first buf_chk-gds-attr no-lock
     2913                where buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     2914                  and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2915                  and buf_chk-gds-attr.attr-code = "CSPriceOrig":U no-error .
     2916           if available buf_chk-gds-attr then do:
     2917             v-price-azs = decimal(buf_chk-gds-attr.attr-value) .
     2918             insw:write-data-element (  "price-azs",  left-trim(string(v-price-azs, "->>>>>>>>9.99"))  ) .
     2919           end .
     2920           for each buf_marking-chk no-lock where buf_marking-chk.doc-code =  buf_chk-gds.doc-code and buf_marking-chk.line-num = buf_chk-gds.line-num:
     2921             v-marking = repSpecSimbforXlm(GetCodeIdent(buf_marking-chk.mark)).
     2922             if v-marking = "" then do:
     2923             message "Ошибка. В чеке " buf_chk-gds.doc-code  " отсутствует марка." view-as alert-box.
     2924             end.
     2925             if v-marking <> "" then do:
     2926             insw:write-data-element (  "dm",  v-marking ) .
     2927             end.
     2928           end.
     2929           insw:end-element ('chk-gd':U) .
     2930         end .
     2931       insw:end-element ('chk-gds':U) .
     2932       end .
     2933       if mRepShiftDate = ? or
     2934          (mRepShiftDate <> p-buf_chk-doc.shift-date and mRepShiftNum <> p-buf_chk-doc.shift-num) then do:
     2935          empty temp-table tt-rep.
     2936          empty temp-table tt-all-total-rep.
     2937          empty temp-table tt-total-rep.
     2938          empty temp-table tt-grp.
     2939          empty temp-table tt-pay.
     2940          assign
     2941             mRepShiftNum  = p-buf_chk-doc.shift-num
     2942             mRepShiftDate = p-buf_chk-doc.shift-date
     2943             .
     2944          initTT(yes,
     2945                 mRepShiftDate,
     2946                 mRepShiftDate,
     2947                 mRepShiftNum,
     2948                 mRepShiftNum,
     2949                 "*",
     2950                 "*",
     2951                 "*").
     2952          AfterCalc(yes,
     2953                    mRepShiftDate,
     2954                    "*",
     2955                    "*",
     2956                    0).
     2957       end.
     2958       CrTTFuelTran(buffer p-buf_chk-doc).
     2959       for each ttTranFuel
     2960       break
     2961         by ttTranFuel.trn-start
     2962         by ttTranFuel.trn-end
     2963         by ttTranFuel.chk-date
     2964         by ttTranFuel.chk-time:
     2965         if first(ttTranFuel.trn-start) then
     2966            insw:start-element ('chk-trns':U) .
     2967         insw:start-element ('chk-trn':U) .
