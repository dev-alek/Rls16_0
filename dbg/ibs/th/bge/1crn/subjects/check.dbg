     3079                                             output v-disc-promo-count).
     3080       end.
     3081       if not can-find (first chk-discnt where chk-discnt.doc-code = p-buf_chk-doc.doc-code
     3082                                           and chk-discnt.discnt-type       = 23
     3083                                           and chk-discnt.discnt-value-pcnt = 0) then do :
     3084       for each buf_chk-discnt no-lock
     3085          where buf_chk-discnt.doc-code = p-buf_chk-doc.doc-code
     3086            and ( buf_chk-discnt.record-type = 1 or
     3087                  buf_chk-discnt.record-type = 2
     3088                  or buf_chk-discnt.value-type = 14)
     3089       break by buf_chk-discnt.doc-code :
     3090         if first-of(buf_chk-discnt.doc-code) then do:
     3091            vflg-disc = yes.
     3092            insw:start-element ('chk-discnts':U) .
     3093         end.
     3094         if buf_chk-discnt.promo-id > "" and
     3095            not can-do(v-promocode-list,buf_chk-discnt.promo-id) then
     3096               v-promocode-list = if v-promocode-list = ""
     3097                                     then buf_chk-discnt.promo-id
     3098                                     else v-promocode-list + "," + buf_chk-discnt.promo-id.
     3099         if   buf_chk-discnt.line-type = integer('2':U)
     3100         and buf_chk-discnt.record-type = 1
     3101         and can-find(first  bf_chk-discnt no-lock
     3102             where bf_chk-discnt.doc-code = buf_chk-discnt.doc-code and  bf_chk-discnt.record-type = 1 and bf_chk-discnt.discnt-id = buf_chk-discnt.discnt-id ) then
     3103         do:
     3104            if not vflg
     3105            then
     3106            for each bf_chk-discnt no-lock
     3107             where bf_chk-discnt.doc-code = buf_chk-discnt.doc-code and bf_chk-discnt.record-type = 1  and bf_chk-discnt.discnt-id = buf_chk-discnt.discnt-id  break by bf_chk-discnt.object-line-num:
     3108             vflg = yes.
     3109             insw:start-element ('chk-discnt':U) .
     3110             insw:write-data-element (  "discnt-num",       string(bf_chk-discnt.discnt-id)          ) .
     3111             insw:write-data-element (  "line-num",         string(bf_chk-discnt.object-line-num)           ) .
     3112             insw:write-data-element (  "discnt-type",      string(bf_chk-discnt.value-type)        ) .
     3113             insw:write-data-element (  "discntValueAbs",   left-trim(string(bf_chk-discnt.discnt-value-abs,  "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3114             insw:write-data-element (  "discntValuePcnt",  left-trim(string(bf_chk-discnt.discnt-value-pcnt, "->>>9.9<"))                 ) .
     3115             if bf_chk-discnt.promo-id > "" then
