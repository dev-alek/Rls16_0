     3268         find first buf_chk-gds-attr no-lock where
     3269                      buf_chk-gds-attr.doc-code = buf_chk-gds-pay.doc-code
     3270                  and buf_chk-gds-attr.line-num  = buf_chk-gds-pay.line-num
     3271                  and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3272               no-error.
     3273         v-sum-promo = if avail buf_chk-gds-attr then dec(buf_chk-gds-attr.attr-value) else 0 no-error.
     3274         if  v-sum-promo <> 0 and buf_chk-gds-pay.eff-doc-qnty <> 0 then
     3275            insw:write-data-element (  "discntValueAbs",  left-trim(string((buf_chk-gds-pay.discnt + (v-sum-promo / buf_chk-gds-pay.eff-doc-qnty)), "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3276         else
     3277            insw:write-data-element (  "discntValueAbs",  left-trim(string((buf_chk-gds-pay.discnt), "->>>>>>>>>9.9<<<<<<<<<"))  ) .
     3278         insw:end-element ('chk-pay-r':U) .
     3279         if last-of(buf_chk-gds-pay.doc-code) then insw:end-element ('chk-pays-r':U) .
     3280       end .
     3281       insw:end-element ('check':U) .
     3282     end method .
     3283     method private character timeFormat (p-time as integer) :
     3284       define variable v-tm-format as character initial "hh:mm:ss" no-undo .
     3285       return if (p-time >= 0) then string(p-time, v-tm-format) else "" .
     3286     end method .
     3287     method private character dateFormat (p-date as date) :
     3288       define variable v-dt-format as character initial "99.99.9999" no-undo .
     3289       return if (p-date = ?) then "" else string(p-date, v-dt-format) .
     3290     end method .
     3291     method private character getTankNum (p-obj-type    as character,
     3292                                          p-obj-code    as integer,
     3293                                          p-pump        as integer,
     3294                                          p-nozzle-code as integer,
     3295                                          p-src-pl-code as integer,
     3296                                          p-pl-code     as integer,
     3297                                          p-gds-code    as integer) :
     3298       define buffer buf_place for ub.place .
     3299       define variable v-pl-code as integer no-undo .
     3300       define variable v-loc1    as character no-undo .
     3301            if p-src-pl-code > 0 then v-pl-code = p-src-pl-code.
     3302       else if p-pl-code     > 0 then v-pl-code = p-pl-code.
     3303       else do:
     3304         libFindtank:findtank_
     3305         (input p-obj-type
     3306         ,input p-obj-code
     3307         ,input p-pump
     3308         ,input p-nozzle-code
     3309         ,input p-pl-code
     3310         ,input p-gds-code
     3311         ,output v-pl-code
     3312         ) .
     3313       end .
     3314       if v-pl-code > 0 then do:
     3315         find first buf_place no-lock where buf_place.pl-code = v-pl-code no-error .
     3316         v-loc1 = if available buf_place then string(buf_place.pl-code) else "0" .
     3317       end.
     3318       else v-loc1 = "0" .
     3319       return v-loc1 .
     3320     end method .
     3321     method private character base64-enc ( input v-string as character ) :
     3322       define variable v-base64-encode as character no-undo .
     3323       do
     3324       on error undo, return error return-value
     3325       :
     3326         define variable v-raw     as raw       no-undo .
     3327         define variable v-raw-str as character no-undo .
     3328         if v-string = ?
     3329         then do:
     3330           undo, return error "base64-encode: строка имеет неопределенное значение" .
     3331           end.
     3332           assign
     3333             length(v-raw) = length(v-string) + 1
     3334           .
     3335           assign
     3336             put-string(v-raw, 1) = v-string
     3337           .
     3338           assign
     3339             v-raw-str = string(v-raw)
     3340           .
     3341           assign
     3342             length(v-raw) = 0
     3343           .
     3344           assign
     3345             v-base64-encode = substring(v-raw-str, 7)
     3346           .
     3347       end.
     3348       return v-base64-encode .
     3349     end.
     3350     method private integer get-chk-promo-id (
     3351        input p-obj-code as integer,
     3352        input p-obj-type as character,
     3353        input p-pay-desk as integer,
     3354        input p-doc-num2 as character,
     3355        input p-b-code as integer,
     3356        input p-gds-qnty as decimal,
     3357        output o-disc-promo-line as integer,
     3358        output o-disc-promo-count as integer ) :
     3359       define buffer buf2_chk-doc for ub.chk-doc.
     3360       define buffer buf2_chk-gds for ub.chk-gds.
     3361       define buffer buf2_chk-discnt for ub.chk-discnt.
     3362       define variable v-promo-id as character no-undo .
     3363       v-promo-id = "".
     3364       for first buf2_chk-doc no-lock where
     3365                buf2_chk-doc.obj-code = p-obj-code
     3366            and buf2_chk-doc.obj-type = p-obj-type
     3367            and buf2_chk-doc.pay-desk = p-pay-desk
     3368            and buf2_chk-doc.chk-type = int('1':U)
     3369            and buf2_chk-doc.chk-num  = int(entry(1,p-doc-num2,":"))
     3370            and buf2_chk-doc.z-number = int(entry(2,p-doc-num2,":"))
     3371          :
     3372          find first buf2_chk-gds no-lock where
     3373                     buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     3374                and  buf2_chk-gds.b-code   = p-b-code
     3375          no-error.
     3376          if avail buf2_chk-gds then do:
     3377              find first buf2_chk-discnt no-lock where
     3378                         buf2_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     3379                         buf2_chk-discnt.record-type = 1 and
     3380                         buf2_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     3381                         buf2_chk-discnt.promo-id > ""
     3382              no-error .
     3383              if avail buf2_chk-discnt
     3384              then do:
     3385                  assign
     3386                    v-promo-id = buf2_chk-discnt.promo-id
     3387                    o-disc-promo-line = buf2_chk-gds.line-num
     3388                    o-disc-promo-count = if buf2_chk-gds.src-qnty <> -1 * p-gds-qnty then 1 else 0
     3389                    .
     3390              end.
     3391          end.
     3392       end.
     3393       return int(v-promo-id) .
     3394     end.
     3395   end class.
