        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.goods_barcode inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9       define property bcode         as character    no-undo get. private set.
       10       define property unit-code     as character    no-undo get. private set.
       11       define property coeff         as decimal      no-undo get. private set.
       12       define property barcode-type  as integer      no-undo get. private set.
       13       define override  property InitTag as character no-undo init "barcode"
       14         get.
       15       method override protected void SetPropProtected( input inTag as character, input inValue as character ):
       16         case inTag:
       17             when "bcode" then
       18               do:
       19                 assign
       20                   bcode = inValue no-error.
       21               end.
       22             when "unit-code" then
       23               do:
       24                 assign
       25                   unit-code = inValue no-error.
       26               end.
       27             when "coeff" then
       28               do:
       29                 assign
       30                   coeff = decimal(inValue) no-error.
       31               end.
       32             when "barcode-type" then
       33               do:
       34                 assign
       35                   barcode-type = integer(inValue) no-error.
       36               end.
       37         end case.
       38       end method.
       39       method override protected void CheckData(  ):
       40         def var v-str as char no-undo.
       41         assign
       42           v-str = "bcode" when bcode = ?
       43           v-str = v-str + ",unit-code" when unit-code = ?
       44           v-str = v-str + ",coeff" when coeff = ?
       45         .
       46         v-str = trim (v-str, ",").
       47         if v-str > ''
       48         then
       49           undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       50       end method.
       51       method override protected void ClearSub(  ):
       52         assign
       53           bcode = ?
       54           unit-code = ?
       55           coeff = ?
       56           barcode-type = ?
       57         .
       58       end method.
       59   end class.
