        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.normloss inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property type_ as integer no-undo
       10       get.
       11       private set.
       12     define property clim-grp as character no-undo
       13       get.
       14       private set.
       15     define property position_ as integer no-undo
       16       get.
       17       private set.
       18     define property sec-vol1 as decimal no-undo
       19       get.
       20       private set.
       21     define property sec-vol2 as decimal no-undo
       22       get.
       23       private set.
       24     define property oil-grp as character no-undo
       25       get.
       26       private set.
       27     define property season_ as integer no-undo
       28       get.
       29       private set.
       30     define property value_ as decimal no-undo
       31       get.
       32       private set.
       33     define override property InitTag as character no-undo init "norm-loss"
       34       get.
       35     method override protected void SetPropProtected (inTag as char, inValue as char):
       36       case inTag:
       37         when "type" then
       38           do:
       39             assign
       40               type_ = integer(inValue).
       41           end.
       42         when "clim-grp" then
       43           do:
       44             assign
       45               clim-grp = inValue.
       46           end.
       47         when "position" then
       48           do:
       49             assign
       50               position_ = integer (inValue).
       51           end.
       52         when "sec-vol" then
       53           do:
       54             if num-entries(inValue,"-") > 1 then do:
       55             assign
       56               sec-vol1 = decimal(entry(1,inValue,"-"))
       57               sec-vol2 = decimal(entry(2,inValue,"-"))
       58               .
       59              end.
       60              else do:
       61             assign
       62               sec-vol1 = decimal(inValue)
       63               sec-vol2 = 0
       64               .
       65              end.
       66           end.
       67         when "oil-grp" then
       68           do:
       69             assign
       70               oil-grp = inValue .
       71           end.
       72         when "season" then
       73           do:
       74             assign
       75               season_ = integer(inValue) .
       76           end.
       77         when "value" then
       78           do:
       79             assign
       80               value_ = decimal(inValue) .
       81           end.
       82       end case.
       83     end.
       84     method override protected void CheckData ():
       85       def var v-str as char no-undo.
       86       assign
       87         v-str = "type"
       88         when type_ = ?
       89         v-str = v-str + ",clim-grp"
       90         when clim-grp = ?
       91         v-str = v-str + ",oil-grp"
       92         when oil-grp = ?
       93         v-str = v-str + ",season"
       94         when season_ = ?
       95         .
       96       v-str = trim (v-str, ",").
       97       if v-str > ''
       98         then
       99         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      100     end.
      101     method override protected void ClearSub():
      102       assign
      103         type_     = ?
      104         clim-grp  = ?
      105         position_ = ?
      106         sec-vol1  = ?
      107         sec-vol2  = ?
      108         oil-grp   = ?
      109         season_   = ?
      110         value_    = ?
      111         .
      112     end.
      113   end class.
