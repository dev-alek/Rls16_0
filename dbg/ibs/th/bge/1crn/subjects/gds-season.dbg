        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.gds-season inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property Tbg-code    as character    no-undo get. private set.
       10     define property del-l       as integer      no-undo get. private set.
       11     define property del-f       as integer      no-undo get. private set.
       12     define property gds-code    as character    no-undo get. private set.
       13     define override property InitTag as character no-undo init "Tb-gd"
       14       get.
       15     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       16       case inTag:
       17         when "Tbg-code" then do:
       18           assign Tbg-code = inValue .
       19         end.
       20         when "del-l" then do:
       21           assign del-l = integer (inValue).
       22         end.
       23         when "del-f" then do:
       24           assign del-f = integer (inValue).
       25         end.
       26         when "gds-code" then do:
       27           assign gds-code = inValue .
       28         end.
       29       end case.
       30     end.
       31     method override protected void CheckData ():
       32       def var v-str as char no-undo.
       33       assign
       34         v-str = "Tbg-code" when Tbg-code = ?
       35         v-str = v-str + ",gds-code" when gds-code = ?
       36       .
       37       v-str = trim (v-str, ",").
       38       if v-str > ''
       39       then
       40         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       41     end.
       42     method override protected void ClearSub():
       43       assign
       44         Tbg-code  = ?
       45         del-l     = ?
       46         del-f     = ?
       47         gds-code  = ?
       48       .
       49     end.
       50   end class.
