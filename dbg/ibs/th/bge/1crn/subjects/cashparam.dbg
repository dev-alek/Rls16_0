        1   using Progress.Lang.*.
        2   using ibs.th.str.cash.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.cashparam inherits ibs.th.bge.1crn.subjects.code:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   method public logical is-numeral
       12     (input p-string   as character ,
       13      input char-avail as character) :
       14     define variable p-replace-string as character no-undo .
       15     define variable log-result       as logical  no-undo .
       16     if p-string = ? then
       17       return false .
       18     p-replace-string = p-string.
       19     if lookup ("*", char-avail) > 0 then
       20         p-replace-string = replace (p-replace-string, '*', '9').
       21     if lookup ("digit", char-avail) > 0 then
       22       assign
       23         p-replace-string = replace (p-replace-string, '0', '9')
       24         p-replace-string = replace (p-replace-string, '1', '9')
       25         p-replace-string = replace (p-replace-string, '2', '9')
       26         p-replace-string = replace (p-replace-string, '3', '9')
       27         p-replace-string = replace (p-replace-string, '4', '9')
       28         p-replace-string = replace (p-replace-string, '5', '9')
       29         p-replace-string = replace (p-replace-string, '6', '9')
       30         p-replace-string = replace (p-replace-string, '7', '9')
       31         p-replace-string = replace (p-replace-string, '8', '9')
       32         .
       33     else
       34        p-replace-string = replace (p-replace-string, '9', chr(15))
       35         .
       36     if lookup ("letter", char-avail) > 0 then
       37       assign
       38         p-replace-string = replace (p-replace-string, 'A', '9')
       39         p-replace-string = replace (p-replace-string, 'B', '9')
       40         p-replace-string = replace (p-replace-string, 'C', '9')
       41         p-replace-string = replace (p-replace-string, 'D', '9')
       42         p-replace-string = replace (p-replace-string, 'E', '9')
       43         p-replace-string = replace (p-replace-string, 'F', '9')
       44         p-replace-string = replace (p-replace-string, 'G', '9')
       45         p-replace-string = replace (p-replace-string, 'H', '9')
       46         p-replace-string = replace (p-replace-string, 'I', '9')
       47         p-replace-string = replace (p-replace-string, 'J', '9')
       48         p-replace-string = replace (p-replace-string, 'K', '9')
       49         p-replace-string = replace (p-replace-string, 'L', '9')
       50         p-replace-string = replace (p-replace-string, 'M', '9')
       51         p-replace-string = replace (p-replace-string, 'N', '9')
       52         p-replace-string = replace (p-replace-string, 'O', '9')
       53         p-replace-string = replace (p-replace-string, 'P', '9')
       54         p-replace-string = replace (p-replace-string, 'Q', '9')
       55         p-replace-string = replace (p-replace-string, 'R', '9')
       56         p-replace-string = replace (p-replace-string, 'S', '9')
       57         p-replace-string = replace (p-replace-string, 'T', '9')
       58         p-replace-string = replace (p-replace-string, 'U', '9')
       59         p-replace-string = replace (p-replace-string, 'V', '9')
       60         p-replace-string = replace (p-replace-string, 'W', '9')
       61         p-replace-string = replace (p-replace-string, 'X', '9')
       62         p-replace-string = replace (p-replace-string, 'Y', '9')
       63         p-replace-string = replace (p-replace-string, 'Z', '9')
       64         p-replace-string = replace (p-replace-string, '_', '9')
       65         .
       66     return p-replace-string = fill ('9', length (p-string)).
       67   end.
       68     define override property InitTag as character no-undo init "Etalon-param"
       69       get.
       70      define variable mCashDevice      as class CashDevice  no-undo.
       71      define variable mCashSection     as class CashSection no-undo.
       72      constructor public cashparam (  ):
       73         super ().
       74         mCashDevice  = new CashDevice().
       75         mCashSection = new CashSection().
       76      end constructor.
       77             define variable vSign as integer    no-undo.
       78     define variable vSource as integer  no-undo.
       79     define variable vSection as character no-undo.
       80     method override protected void SetPropProtected (inTag as char, inValue as char):
       81       super:SetPropProtected(inTag, inValue).
       82       case inTag:
       83         when "sign" then do:
       84            vSign = if inValue >= "" then integer (inValue) else 0.
       85            entry(2,parent_,chr(4)) = string(vSign).
       86         end.
       87         when "source" then do:
       88            vsource  = if inValue >= "" then integer (inValue) else 0.
       89            entry(3,parent_,chr(4)) = string(vsource).
       90         end.
       91         when "section" then do:
       92            vSection = if inValue >= "" then inValue else "".
       93           entry(4,parent_,chr(4)) = vSection.
       94         end.
       95         when "name" then do:
       96           code_ = if inValue >= "" then inValue else "" .
       97         end.
       98         when "value-etalon" then do:
       99           CodeValue = if inValue >= "" then inValue else "" .
      100         end.
      101         when "required" then do:
      102           status_ = (if inValue >= "" then integer (inValue) else 0) - 1 .
      103         end.
      104         when "description" then do:
      105           CodeName = if inValue >= "" then inValue else "" .
      106         end.
      107       end case.
      108     end.
      109     method override protected void CheckData ():
      110       def var v-str as char no-undo.
      111       define buffer code for ub.Code.
      112       assign
      113         v-str =         "sign"          when vSign = ?
      114         v-str = v-str + ",source"       when vsource = ?
      115         v-str = v-str + ",Section"      when vSection = ?
      116         v-str = v-str + ",name"         when code_ = ? and vsource ne 2
      117       .
      118       if code_ eq ?
      119       then
      120          code_ = "".
      121       v-str = trim (v-str, ",").
      122       if v-str > ''
      123       then
      124         undo, throw new Progress.Lang.AppError( substitute ("Теги &1 не могут иметь неопределное значение", v-str)).
      125       if mCashDevice:GetProp(vSign) eq mCashDevice:Unknow
      126       then
      127          undo, throw new Progress.Lang.AppError( substitute ('Тег "&1" имеет не допустимое значение "&2"', "sign", vsign + 1)).
      128      if mCashSection:GetProp(vsource) eq mCashSection:Unknow
      129      then
      130          undo, throw new Progress.Lang.AppError( substitute ('Тег "&1" имеет не допустимое значение "&2"', "source",vsource)).
      131      if     status_ ne 0
      132         and status_ ne 1
      133      then do:
      134         undo, throw new Progress.Lang.AppError(substitute ("Недопустимое значение &1 поля required Допустимы 1 - обязательный и 2 - Необязательный",
      135                                  status_ + 1)).
      136      end.
      137      if not is-numeral (vsection,
      138                         if vsource eq 1
      139                         then "letter,digit"
      140                         else "digit")
      141      then do:
      142         undo, throw new Progress.Lang.AppError(substitute ("Недопустимое значение '&1' поля section Допустимы только &2",
      143                                  vsection,
      144                                  if vsource eq 1 then "Латинские буквы, цифры, подчеркивание и * " else "Цифры" )).
      145      end.
      146      if vsource eq 1
      147      then do:
      148         if not is-numeral (code_,
      149                            "letter,digit,*"
      150                            )
      151         then do:
      152            undo, throw new Progress.Lang.AppError(substitute ("Недопустимое значение '&1' поля name Допустимы только &2",
      153                                     code_,
      154                                     if vsource eq 1 then "Латинские буквы, цифры, подчеркивание и * " else "Цифры")).
      155         end.
      156      end.
      157      else do:
      158         if     codevalue ne "MGR"
      159            and codevalue ne "REG"
      160         then do:
      161            undo, throw new Progress.Lang.AppError(substitute ("Недопустимое значение &1 поля value-etalon Допустимы MGR - менаджер и REG - кассир",
      162                                     codevalue)).
      163         end.
      164      end.
      165       old_code_ = code_.
      166       old_parent_ = parent_.
      167     end.
      168     method override protected void ClearSub(  ):
      169         super:ClearSub().
      170         assign
      171            vSign = ?
      172            vsource = ?
      173            vSection = ?
      174            old_code_ = ?
      175            old_parent_ = ?
      176            code_  = ?
      177            CodeValue = ""
      178            parent_ = substitute ("cash-param&1&1&1",chr(4)).
      179         .
      180      end method.
      181           destructor public cashparam ( ):
      182             if valid-object(mCashDevice) then
      183           delete object mCashDevice.
      184         if valid-object(mCashSection) then
      185           delete object mCashSection.
      186           end destructor.
      187   end class.
