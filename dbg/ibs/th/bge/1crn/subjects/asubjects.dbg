        1   using Progress.Lang.*.
        2   using ibs.th.gbl.collection.isubjects from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.asubjects implements isubjects abstract:
        5     define property iCounter as integer no-undo
        6       get.
        7       private set.
        8     define property SubjectObjCurr as class Progress.Lang.Object no-undo
        9       get.
       10       set.
       11     define private temp-table ttListObj no-undo
       12       field iNum as integer
       13       field SubObj as class Progress.Lang.Object
       14       index pi is primary unique iNum .
       15     method public void Add (subObj as Progress.Lang.Object):
       16        assign
       17         iCounter = iCounter + 1.
       18       create ttListObj.
       19       assign
       20         ttListObj.iNum = iCounter
       21         ttListObj.SubObj = subObj
       22       .
       23       SubjectObjCurr = subObj.
       24     end.
       25     method public void Delete (iNum as int):
       26       find first ttListObj where ttListObj.iNum = iNum.
       27       SubjectObjCurr = ttListObj.SubObj.
       28       delete object SubjectObjCurr no-error.
       29       delete ttListObj.
       30       iNum = 0.
       31       for each ttListObj use-index pi:
       32         assign
       33           iNum = iNum + 1
       34           ttListObj.iNum = iNum.
       35       end.
       36       iCounter = iCounter - 1.
       37     end.
       38     method public integer Get (iNum as int):
       39       for first ttListObj where ttListObj.iNum = iNum:
       40         SubjectObjCurr = ttListObj.SubObj.
       41       end.
       42       return iCounter.
       43     end.
       44     destructor public asubjects ( ):
       45         for each ttListObj:
       46           SubjectObjCurr = ttListObj.SubObj.
       47           delete object SubjectObjCurr no-error.
       48         end.
       49     end destructor.
       50   end class.
