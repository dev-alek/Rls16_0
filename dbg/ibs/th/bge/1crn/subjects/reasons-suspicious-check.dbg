        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.reasons-suspicious-check inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_         as character    no-undo get.
       10       private set.
       11     define property del-l         as integer      no-undo get.
       12       private set.
       13     define property name_         as character    no-undo get.
       14       private set.
       15     define override property InitTag as character no-undo init "reasons-suspicious-check"
       16       get.
       17     method override protected void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "code" then
       20           do:
       21             assign
       22               code_ = inValue .
       23           end.
       24         when "del-l" then
       25           do:
       26             assign
       27               del-l = integer (inValue).
       28           end.
       29         when "name" then
       30           do:
       31             assign
       32               name_ = inValue .
       33           end.
       34       end case.
       35     end.
       36     method override protected void CheckData ():
       37       def var v-str as char no-undo.
       38       assign
       39         v-str = "code"
       40         when code_ = ?
       41         v-str = v-str + ",name"
       42         when name_ = ?
       43       .
       44       v-str = trim (v-str, ",").
       45       if v-str > ''
       46         then
       47         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       48     end.
       49     method override protected void ClearSub():
       50       assign
       51         code_         = ?
       52         del-l         = ?
       53         name_         = ?
       54       .
       55     end.
       56   end class.
