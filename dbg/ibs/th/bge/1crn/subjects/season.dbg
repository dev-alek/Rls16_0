        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.season inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property Tbg-code    as character    no-undo get. private set.
       10     define property del-l       as integer      no-undo get. private set.
       11     define property del-f       as integer      no-undo get. private set.
       12     define property Tb-name     as character    no-undo get. private set.
       13     define property Tb-image    as longchar     no-undo get. private set.
       14     define override property InitTag as character no-undo init "Tb-group"
       15       get.
       16     method override protected void SetPropProtected (inTag as char, inValue as char):
       17       case inTag:
       18         when "Tbg-code" then do:
       19           assign Tbg-code = inValue .
       20         end.
       21         when "del-l" then do:
       22           assign del-l = integer (inValue).
       23         end.
       24         when "del-f" then do:
       25           assign del-f = integer (inValue).
       26         end.
       27         when "Tb-name" then do:
       28           assign Tb-name = inValue .
       29         end.
       30         when "Tb-image" then do:
       31           assign Tb-image = inValue .
       32         end.
       33       end case.
       34     end.
       35     method override protected void SetPropProtected (inTag as char, inValue as longchar):
       36       case inTag:
       37         when "Tb-image" then do:
       38           assign Tb-image = inValue .
       39         end.
       40       end case.
       41     end.
       42     method override protected void CheckData ():
       43       def var v-str as char no-undo.
       44       assign
       45         v-str = "Tbg-code" when Tbg-code = ?
       46       .
       47       v-str = trim (v-str, ",").
       48       if v-str > ''
       49       then
       50         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       51     end.
       52     method override protected void ClearSub():
       53       assign
       54         Tbg-code   = ?
       55         del-l     = ?
       56         del-f     = ?
       57         Tb-name   = ?
       58         Tb-image  = ?
       59       .
       60     end.
       61   end class.
