        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.mark inherits ibs.th.bge.1crn.subjects.asubject:
        3       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4       define override public property vss-author      as character no-undo init "$Author:$":U get.
        5       define override public property vss-date        as character no-undo init "$Date:$":U get.
        6       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8       define property mark-code       as character    no-undo get.
        9           private set.
       10       define property unit-ext        as character    no-undo get.
       11           private set.
       12       define property qnty-box        as decimal      no-undo get.
       13           private set.
       14       define property stts            as character    no-undo get.
       15           private set.
       16       define property mark-parent     as character    no-undo get.
       17           private set.
       18       define property GTIN            as character    no-undo get.
       19           private set.
       20       define property expDate         as character  no-undo get.
       21           private set.
       22       define property expDateOther    as character    no-undo get.
       23           private set.
       24       define property gds-code        as integer      no-undo get.
       25           private set.
       26       define property mrc             as decimal      no-undo get.
       27           private set.
       28       define property weight          as decimal      no-undo get.
       29           private set.
       30       define property stts-desc             as character    no-undo get.
       31           private set.
       32       define property del-l         as integer      no-undo get.
       33           private set.
       34       define property del-f         as integer      no-undo get.
       35           private set.
       36       define property obj-load        as character       no-undo get.  set.
       37       define override property InitTag as character no-undo init "mark"
       38           get.
       39       constructor public mark ():
       40       end constructor.
       41       method private date date-mth (inValue as character):
       42           inValue = entry (1, inValue, "T").
       43           return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
       44       end.
       45               method override protected void SetPropProtected (inTag as char, inValue as char):
       46           define variable ii              as integer   no-undo .
       47           define variable expDateMes      as character no-undo .
       48           define variable expDateOtherMes as character no-undo .
       49           case inTag:
       50               when "del-l"        then
       51                   del-l            = if inValue >= "" then integer (inValue) else 0 .
       52               when "del-f"        then
       53                   del-f            = if inValue >= "" then integer (inValue) else 0 .
       54               when "mark-code"    then
       55                   mark-code        = if inValue >= "" then inValue else "" .
       56               when "unit-ext"     then
       57                   unit-ext         = if inValue >= "" then inValue else "" .
       58               when "qnty-box"     then
       59                   qnty-box         = if inValue >= "" then decimal (inValue) else 0.0 .
       60               when "stts"         then
       61                   stts             = if inValue >= "" then inValue else "" .
       62               when "mark_parent"  then
       63                   mark-parent      = if inValue >= "" then inValue else "" .
       64               when "mark-parent"  then
       65                   mark-parent      = if inValue >= "" then inValue else "" .
       66               when "stts-desc"    then
       67                   stts-desc        = if inValue >= "" then inValue else "" .
       68               when "GTIN"         then
       69                   GTIN             = if inValue >= "" then inValue else "" .
       70               when "expirationDate" then
       71                   expDate        = ENTRY(1,STRING(formatDateTime(inValue)),"+") .
       72               when "expirationsDates" then
       73                   do:
       74                       do ii = 1 to num-entries(inValue):
       75                           if ii = 12 then leave .
       76                           expDateOtherMes = ENTRY(1,STRING(formatDateTime(entry(ii,inValue))),",") .
       77                           if expDateOther = ? then expDateOther = string(datetime-tz(expDateOtherMes)) .
       78                           else expDateOther = expDateOther + ", " + string(datetime-tz(expDateOtherMes)) .
       79                       end.
       80                   end.
       81               when "gds-code"     then
       82                   gds-code         = if inValue >= "" then integer (inValue) else 0 .
       83               when "mrc"          then
       84                   mrc              = if inValue >= "" then decimal (inValue) else 0.0 .
       85               when "weight"       then
       86                   weight           = if inValue >= "" then decimal (inValue) else 0.0 .
       87           end case.
       88           catch exProErrors as class Progress.Lang.ProError :
       89               case exProErrors:GetMessageNum(1):
       90                   when 18207 then
       91                       undo, throw new Progress.Lang.AppError(
       92                           substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       93                           ) .
       94                   otherwise
       95                   undo, throw new Progress.Lang.AppError(
       96                       substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       97                       ) .
       98               end case .
       99           end catch .
      100       end method.
      101       method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
      102       end method.
      103       method override protected void CheckData ():
      104           def var v-str as char no-undo.
      105           assign
      106               v-str = v-str + ",mark-code"
      107               when mark-code         = ?
      108               v-str = v-str + ",qnty-box"
      109               when qnty-box          = ? and obj-load eq "mark"
      110               .
      111           v-str = substring(v-str, 2).
      112           if v-str > "" then undo, throw new Progress.Lang.AppError(
      113                   substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      114                   ) .
      115       end method.
      116       method override protected void ClearSub():
      117           assign
      118               mark-code    = ?
      119               del-l        = ?
      120               del-f        = ?
      121               unit-ext     = ?
      122               qnty-box     = ?
      123               stts         = ?
      124               mark-parent  = ?
      125               GTIN         = ?
      126               gds-code     = ?
      127               mrc          = ?
      128               stts-desc    = ?
      129               weight       = ?
      130               expDate      = ?
      131               expDateOther = ?
      132               .
      133       end method.
      134       method private date formatDate (pDate as character) :
      135           define variable iDate as character no-undo .
      136           iDate = entry(1,pDate,"T") .
      137           return if (iDate = "" or iDate = "")
      138              then ?
      139              else date(int(substring(iDate,6,2)),int(substring(iDate,9,2)),int(substring(iDate,1,4))) .
      140       end method .
      141       method private character formatDateTime (pDate as character) :
      142           define variable iDate as character no-undo .
      143           define variable vDate as date      no-undo .
      144           define variable kDate as datetime  no-undo.
      145           iDate = entry(1,pDate,"T") .
      146           if (iDate = "" or iDate = "")
      147               then return ? .
      148           else vDate = date(int(substring(iDate,6,2)),int(substring(iDate,9,2)),int(substring(iDate,1,4))) .
      149           return string(vDate,"99/99/9999") + " " + entry(2,pDate,"T") .
      150       end method .
      151   end class.
