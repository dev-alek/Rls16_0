        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.invs-trk implements iexpsubject:
        5     define buffer buf_icnt-doc  for ub.icnt-doc .
        6     define buffer buf_icnt-line for ub.icnt-line .
        7     define property Msg as character no-undo
        8       get.
        9       private set.
       10     define property DocCode as character no-undo
       11       get.
       12       set.
       13     define property InitSecTag as character no-undo init "invs-trk"
       14       get.
       15       private set.
       16     define property sendTableName  as character  no-undo init "icnt-doc"
       17     get.
       18     define property sendOldRowid as rowid  no-undo
       19     get.
       20     set.
       21     define property sendNewRowid as rowid  no-undo
       22     get.
       23     set.
       24     define variable sw as handle no-undo.
       25     method public void CrContentToSW (insw as handle):
       26       sw = insw .
       27       find first buf_icnt-doc no-lock where buf_icnt-doc.doc-code = DocCode no-error.
       28       if not available (buf_icnt-doc)
       29         then return.
       30       sendOldRowid = rowid(buf_icnt-doc).
       31       sw:start-element ("inv-trk") .
       32       sw:write-data-element ("doc-num", if buf_icnt-doc.doc-code = ? then "" else string(buf_icnt-doc.doc-code)).
       33       sw:write-data-element ("doc-code", if buf_icnt-doc.doc-code = ? then "" else string(buf_icnt-doc.doc-code)).
       34       sw:write-data-element ("date", if buf_icnt-doc.doc-date = ? then "" else ISO-DATE(buf_icnt-doc.doc-date)).
       35       sw:write-data-element ("shift-date", if buf_icnt-doc.shift-date = ? then "" else ISO-DATE (buf_icnt-doc.shift-date)).
       36       sw:write-data-element ("shift-num", if buf_icnt-doc.shift-num = ? then "0" else string(buf_icnt-doc.shift-num)).
       37       sw:write-data-element ("operator", if buf_icnt-doc.creid = ? then "" else pr-objname(buf_icnt-doc.creid)).
       38       sw:start-element ("trk-inds") .
       39       for each buf_icnt-line no-lock where buf_icnt-line.doc-code = buf_icnt-doc.doc-code:
       40         sw:start-element ("trk-ind") .
       41         sw:write-data-element ("gd-code"  , string-mth(buf_icnt-line.gds-code)).
       42         sw:write-data-element ("trk-num" , string-mth(buf_icnt-line.pump-code)).
       43         sw:write-data-element ("trk-pnum" , string-mth(buf_icnt-line.nozzle-code)).
       44         sw:write-data-element ("ind-el" , string-mth(buf_icnt-line.state-el-cnt)).
       45         sw:write-data-element ("ind-meh" , string-mth(buf_icnt-line.state-mh-cnt)).
       46         sw:write-data-element ("dif" , string-mth(buf_icnt-line.state-el-cnt - buf_icnt-line.state-mh-cnt)).
       47         sw:write-data-element ("ind-auto" , string-mth(if buf_icnt-line.meas-el-cnt = ? then 0 else buf_icnt-line.meas-el-cnt)).
       48         sw:end-element ("trk-ind")  .
       49       end.
       50       sw:end-element ("trk-inds")  .
       51       sw:END-ELEMENT ("inv-trk") .
       52     end.
       53     method private character string-mth (inValue as decimal):
       54       def var v-str as character no-undo.
       55       def var v-stt as decimal   no-undo.
       56       if inValue = ?  then v-str = "0".
       57       if inValue < 0 then
       58       do:
       59         v-stt = inValue .
       60         inValue = ABSOLUTE(v-stt).
       61       end.
       62       if string (inValue) begins "."
       63         then v-str = "0" + string (inValue).
       64       else v-str = string (inValue).
       65       if v-stt <> 0 then v-str = "-" + v-str.
       66       return v-str.
       67     end.
       68       method private character pr-objname (inValue as character):
       69           define variable v-obj-name as character no-undo .
       70               find first ub.user-account NO-LOCK where ub.user-account.user-id = inValue no-error .
       71               if AVAILABLE (ub.user-account) then do:
       72                   v-obj-name = ub.user-account.last-name + " " + (if ub.user-account.first-name <> "" then SUBSTRING (ub.user-account.first-name,1,1) + "." else "") + (if ub.user-account.second-name <> "" then SUBSTRING (ub.user-account.second-name,1,1) + "." else "").
       73               end.
       74          RETURN v-obj-name.
       75       end.
       76   end class.
