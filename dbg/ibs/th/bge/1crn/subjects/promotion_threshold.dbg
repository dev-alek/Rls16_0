        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   class ibs.th.bge.1crn.subjects.promotion_threshold inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property value_      as decimal    no-undo get. private set.
       11     define property valueupto   as decimal    no-undo get. private set.
       12     define property dscnt       as decimal    no-undo get. private set.
       13     define property message_    as character  no-undo get. private set.
       14     define property message-gks as character  no-undo get. private set.
       15     define property Gifts as subjects no-undo
       16       get.
       17       private set.
       18     define override property InitTag as character no-undo init "threshold"
       19       get.
       20     constructor public promotion_threshold ():
       21       InitListTag = "Gifts".
       22     end constructor.
       23             method override protected void SetPropProtected (inTag as char, inValue as char):
       24       case inTag:
       25         when "value"   then value_   = if inValue >= "" then decimal (inValue) else 0.0 .
       26         when "valueupto"   then valueupto   = if inValue >= "" then decimal (inValue) else 0.0 .
       27         when "dscnt"   then dscnt    = if inValue >= "" then decimal (inValue) else 0.0 .
       28         when "message" then message_ = if inValue >= "" then inValue else "" .
       29         when "message-gks" then message-gks = if inValue >= "" then inValue else "" .
       30       end case.
       31       catch exProErrors as class Progress.Lang.ProError :
       32         case exProErrors:GetMessageNum(1):
       33           when 18207 then undo, throw new Progress.Lang.AppError(
       34             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       35           ) .
       36           otherwise undo, throw new Progress.Lang.AppError(
       37             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       38           ) .
       39         end case .
       40       end catch .
       41     end method.
       42     method override protected void SetPropProtected (SubsObj as subjects):
       43       case SubsObj:InitTag:
       44         when "Gifts" then Gifts = SubsObj.
       45       end case.
       46     end method.
       47     method override protected void CheckData ():
       48       def var v-str as char no-undo.
       49       assign
       50         v-str = ",value" when value_ = ?
       51       .
       52       v-str = substring(v-str, 2).
       53       if v-str > "" then undo, throw new Progress.Lang.AppError(
       54         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       55       ) .
       56     end method .
       57     method override protected void ClearSub():
       58       assign
       59         value_   = ?
       60         dscnt    = ?
       61         message_ = ?
       62         message-gks = ?
       63       .
       64       if valid-object(Gifts) then delete object Gifts .
       65     end method .
       66   end class.
