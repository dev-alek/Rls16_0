        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   class ibs.th.bge.1crn.subjects.promotion_schedule inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property sch-code as character no-undo get. private set. // строка 1-1 Код расписания внешней системы
       11     define property sch-name as character no-undo get. private set. // строка 1-1 Название акции
       12     define property Sch-type as character no-undo get. private set. // строка 1-1 Тип расписания  0 - Простое \1 - детальное
       13     define property schedule-lines as subjects no-undo
       14       get.
       15       private set.
       16     define override property InitTag as character no-undo init "schedule"
       17       get.
       18     constructor public promotion_schedule ():
       19       InitListTag = "schedule-lines".
       20     end constructor.
       21             method override protected void SetPropProtected (inTag as char, inValue as char):
       22       case inTag:
       23         when "sch-code" then sch-code = if inValue >= "" then inValue else "" .
       24         when "sch-name" then sch-name = if inValue >= "" then inValue else "" .
       25         when "Sch-type" then Sch-type = if inValue >= "" then inValue else "" .
       26       end case.
       27       catch exProErrors as class Progress.Lang.ProError :
       28         case exProErrors:GetMessageNum(1):
       29           when 18207 then undo, throw new Progress.Lang.AppError(
       30             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       31           ) .
       32           otherwise undo, throw new Progress.Lang.AppError(
       33             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       34           ) .
       35         end case .
       36       end catch .
       37     end method.
       38     method override protected void SetPropProtected (SubsObj as subjects):
       39       case SubsObj:InitTag:
       40         when "schedule-lines" then schedule-lines = SubsObj.
       41       end case.
       42     end method.
       43     method override protected void CheckData ():
       44       def var v-str as char no-undo.
       45       assign
       46         v-str = ",sch-code" when sch-code = ?
       47         v-str = v-str + ",sch-name" when sch-name = ?
       48         v-str = v-str + ",Sch-type" when Sch-type = ?
       49         v-str = v-str + ",schedule-lines" when not valid-object(schedule-lines)
       50       .
       51       v-str = substring(v-str, 2).
       52       if v-str > "" then undo, throw new Progress.Lang.AppError(
       53         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       54       ) .
       55     end method .
       56     method override protected void ClearSub():
       57       assign
       58         sch-code = ?
       59         sch-name = ?
       60         Sch-type = ?
       61       .
       62       if valid-object(schedule-lines) then delete object schedule-lines .
       63     end method .
       64   end class.
