        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   class ibs.th.bge.1crn.subjects.promotion_ps-section inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property ps-name     as character  no-undo get. private set.
       11     define property ps-amount   as decimal    no-undo get. private set.
       12     define property ps-discount as decimal    no-undo get. private set.
       13     define property gds as subjects no-undo
       14       get.
       15       private set.
       16     define override property InitTag as character no-undo init "ps-section"
       17       get.
       18     constructor public promotion_ps-section ():
       19       InitListTag = "gds".
       20     end constructor.
       21             method override protected void SetPropProtected (inTag as char, inValue as char):
       22       case inTag:
       23         when "ps-name"     then ps-name     = if inValue >= "" then inValue else "" .
       24         when "ps-amount"   then ps-amount   = if inValue >= "" then decimal (inValue) else 0.0 .
       25         when "ps-discount" then ps-discount = if inValue >= "" then decimal (inValue) else 0.0 .
       26       end case.
       27       catch exProErrors as class Progress.Lang.ProError :
       28         case exProErrors:GetMessageNum(1):
       29           when 18207 then undo, throw new Progress.Lang.AppError(
       30             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       31           ) .
       32           otherwise undo, throw new Progress.Lang.AppError(
       33             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       34           ) .
       35         end case .
       36       end catch .
       37     end method.
       38     method override protected void SetPropProtected (SubsObj as subjects):
       39       case SubsObj:InitTag:
       40         when "gds" then gds = SubsObj.
       41       end case.
       42     end method.
       43     method override protected void CheckData ():
       44       def var v-str as char no-undo.
       45       assign
       46         v-str = ",ps-name" when ps-name = ?
       47         v-str = v-str + ",ps-amount" when ps-amount = ?
       48         v-str = v-str + ",gds" when not valid-object(gds)
       49       .
       50       v-str = substring(v-str, 2).
       51       if v-str > "" then undo, throw new Progress.Lang.AppError(
       52         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       53       ) .
       54     end method .
       55     method override protected void ClearSub():
       56       assign
       57         ps-name     = ?
       58         ps-amount   = ?
       59         ps-discount = ?
       60       .
       61       if valid-object(gds) then delete object gds .
       62     end method .
       63   end class.
