        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.trn-gd-doc from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.trn-fuel-doc-in inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property doc-code as character no-undo
       12       get.
       13       private set.
       14     define property doc-num as character no-undo
       15       get.
       16       private set.
       17     define property del-f as integer no-undo
       18       get.
       19       private set.
       20     define property doc-date as date no-undo
       21       get.
       22       private set.
       23     define property doc-type as character no-undo
       24       get.
       25       private set.
       26     define property shift-date as date no-undo
       27       get.
       28       private set.
       29     define property shift-num as integer no-undo
       30       get.
       31       private set.
       32     define property ttn-num as character no-undo
       33       get.
       34       private set.
       35     define property ttn-date as date no-undo
       36       get.
       37       private set.
       38     define property contr-code as character no-undo
       39       get.
       40       private set.
       41     define property dog-code as character no-undo
       42       get.
       43       private set.
       44     define property fuel-st-code as character no-undo
       45       get.
       46       private set.
       47     define property doc-id as character no-undo
       48       get.
       49       private set.
       50     define property GDS as subjects no-undo
       51       get.
       52       private set.
       53     define override property InitTag as character no-undo init "trn-fuel-doc"
       54       get.
       55     constructor public trn-fuel-doc-in ():
       56       InitListTag = "gds".
       57     end constructor.
       58     method override protected void SetPropProtected(SubsObj as subjects):
       59       case SubsObj:InitTag:
       60         when "gds" then
       61           do:
       62             gds = SubsObj.
       63           end.
       64       end case.
       65     end.
       66     method override protected void SetPropProtected (inTag as char, inValue as char):
       67       case inTag:
       68         when "doc-code" then do:
       69           assign doc-code = inValue.
       70         end.
       71         when "doc-num" then do:
       72           assign doc-num = inValue.
       73         end.
       74         when "del-f" then do:
       75           assign del-f = integer (inValue).
       76         end.
       77         when "doc-date" then do:
       78           assign doc-date = date-mth (inValue) .
       79         end.
       80         when "doc-type" then do:
       81           assign doc-type = inValue .
       82         end.
       83         when "shift-date" then do:
       84           assign shift-date = date-mth (inValue) .
       85         end.
       86         when "shift-num" then do:
       87           assign shift-num = integer (inValue) .
       88         end.
       89         when "ttn-num" then do:
       90           assign ttn-num = inValue .
       91         end.
       92         when "ttn-date" then do:
       93           assign ttn-date = date-mth (inValue) .
       94         end.
       95         when "contr-code" then do:
       96           assign contr-code = inValue .
       97         end.
       98         when "dog-code" then do:
       99           assign dog-code = inValue .
      100         end.
      101         when "fuel-st-code" then do:
      102           assign fuel-st-code = inValue .
      103         end.
      104         when "doc-id" then do:
      105           assign doc-id = inValue .
      106         end.
      107       end case.
      108     end.
      109     method override protected void CheckData ():
      110       def var v-str as char no-undo.
      111       assign
      112         v-str = v-str + ",doc-type" when doc-type = ?
      113       .
      114       v-str = trim (v-str, ",").
      115       if v-str > ''
      116       then
      117         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      118     end.
      119     method override protected void ClearSub():
      120       assign
      121         doc-code     = ?
      122         doc-num      = ?
      123         del-f        = ?
      124         doc-date     = ?
      125         doc-type     = ?
      126         shift-date   = ?
      127         shift-num    = ?
      128         ttn-num      = ?
      129         ttn-date     = ?
      130         contr-code   = ?
      131         dog-code     = ?
      132         fuel-st-code = ?
      133       .
      134       delete object gds no-error.
      135     end.
      136     method private date date-mth (inValue as character):
      137       inValue = entry (1, inValue, "T").
      138       return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
      139     end.
      140   end class.
