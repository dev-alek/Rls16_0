        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.tank-imp_cal-tbl from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.tank-imp_cal-tbl inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11      define property lvl_ as decimal no-undo get.
       12         private set.
       13      define property amnt as decimal no-undo get.
       14         private set.
       15      define property comp-err as decimal no-undo get.
       16         private set.
       17      define property deltaV as decimal no-undo get.
       18         private set.
       19      define override property InitTag as character no-undo init "cal-tbl-line"
       20         get.
       21      method override protected void SetPropProtected (inTag as char, inValue as char):
       22         case inTag:
       23            when "lvl" then
       24               do:
       25                  assign
       26                     lvl_ = decimal(inValue) .
       27               end.
       28            when "amnt" then
       29               do:
       30                  assign
       31                     amnt = decimal(inValue) .
       32               end.
       33            when "comp-err" then
       34               do:
       35                  assign
       36                     comp-err = decimal(inValue) .
       37               end.
       38            when "deltaV" then
       39               do:
       40                  assign
       41                     deltaV = decimal(inValue) .
       42               end.
       43         end case.
       44      end.
       45      method override protected void CheckData ():
       46         def var v-str as char no-undo.
       47         assign
       48            v-str = v-str + ",lvl"
       49            when lvl_ = ?
       50            v-str = v-str + ",amnt"
       51            when amnt = ?
       52            .
       53         v-str = trim (v-str, ",").
       54         if v-str > ''
       55            then
       56            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       57      end.
       58      method override protected void ClearSub():
       59         assign
       60            lvl_     = ?
       61            amnt     = ?
       62            comp-err = ?
       63            deltaV   = ?
       64         .
       65      end.
       66   end class.
