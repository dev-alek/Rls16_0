        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.cli-grps inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property upper-code as character no-undo
       13       get.
       14       private set.
       15     define property del-l as integer no-undo
       16       get.
       17       private set.
       18     define property del-f as integer no-undo
       19       get.
       20       private set.
       21     define property name_ as character no-undo
       22       get.
       23       private set.
       24     define override property InitTag as character no-undo init "contractor-group"
       25       get.
       26     method override protected void SetPropProtected (inTag as char, inValue as char):
       27       case inTag:
       28         when "code"       then code_      = if inValue >= "" then inValue else "" .
       29         when "upper-code" then upper-code = if inValue >= "" then inValue else "" .
       30         when "del-l"      then del-l      = if inValue >= "" then integer (inValue) else 0.
       31         when "del-f"      then del-f      = if inValue >= "" then integer (inValue) else 0.
       32         when "name"       then name_      = if inValue >= "" then inValue else "" .
       33       end case.
       34     end method .
       35     method override protected void CheckData ():
       36       def var v-str as char no-undo.
       37       assign
       38         v-str = ",code" when code_ = ?
       39         v-str = v-str + ",upper-code" when upper-code = ?
       40         v-str = v-str + ",name" when name_ = ?
       41       .
       42       v-str = substring(v-str, 2).
       43       if v-str > "" then undo, throw new Progress.Lang.AppError(
       44         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       45       ) .
       46     end method.
       47     method override protected void ClearSub():
       48       assign
       49         code_      = ?
       50         upper-code = ?
       51         del-l      = ?
       52         del-f      = ?
       53         name_      = ?
       54       .
       55     end method.
       56   end class.
