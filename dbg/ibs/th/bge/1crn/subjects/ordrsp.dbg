        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.ordrsp inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property order-item as character no-undo
       11       get.
       12       private set.
       13     define property order-date as date no-undo
       14       get.
       15       private set.
       16     define property order-good as subjects no-undo get.
       17       private set.
       18     define override property InitTag as character no-undo init "ordrsp"
       19       get.
       20     constructor public ordrsp ():
       21       InitListTag = "order-good".
       22     end constructor.
       23     method override protected void SetPropProtected (inTag as char, inValue as char):
       24       case inTag:
       25         when "order-item" then do:
       26           assign order-item = inValue.
       27         end.
       28         when "order-date" then do:
       29           assign order-date = formatDate(inValue) .
       30         end.
       31       end case.
       32     end.
       33     method override protected void SetPropProtected(SubsObj as subjects):
       34         case SubsObj:InitTag:
       35            when "order-good" then
       36              order-good = SubsObj.
       37         end case.
       38     end.
       39     method override protected void CheckData ():
       40       def var v-str as char no-undo.
       41       assign
       42         v-str = "order-item" when order-item = ?
       43         v-str = v-str + ",order-date" when order-date = ?
       44       .
       45       v-str = trim (v-str, ",").
       46       if v-str > ''
       47       then
       48         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       49     end.
       50     method override protected void ClearSub():
       51       assign
       52         order-item  = ?
       53         order-date  = ?
       54         order-good  = ?
       55       .
       56     end.
       57     method private datetime formatDateTime (iDateTime as character) :
       58       define variable vDateTime as datetime no-undo .
       59       if (iDateTime = ? or iDateTime = "") then vDateTime = ? .
       60       else
       61          vDateTime =  datetime(iDateTime)
       62       .
       63       return vDateTime .
       64     end method .
       65     method private date formatDate (iDate as character) :
       66       return if (iDate = "" or iDate = "")
       67              then ?
       68              else date(int(substring(iDate,6,2)),int(substring(iDate,9,2)),int(substring(iDate,1,4))) .
       69     end method .
       70   end class.
