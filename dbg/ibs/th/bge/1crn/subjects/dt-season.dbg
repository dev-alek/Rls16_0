        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.dt-season inherits ibs.th.bge.1crn.subjects.code:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override property InitTag as character no-undo init "DT-season"
       10       get.
       11     constructor public dt-season():
       12       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#library)
       13         then run str/library.p persistent no-error .
       14     end constructor.
       15     method override protected void SetPropProtected (inTag as char, inValue as char):
       16       super:SetPropProtected(inTag, inValue).
       17       case inTag:
       18         when "code" then do:
       19             assign
       20               code_ = if inValue >= "" then inValue else ?
       21               parent_ = "DTSeasons"
       22               old_code_ = if inValue >= "" then inValue else ?
       23               old_parent_ = "DTSeasons"          .
       24         end.
       25         when "del-l" then do:
       26            assign status_ = if inValue >= "" then integer (inValue) else 0.
       27         end.
       28         when "del-f" then do:
       29            assign del-f = if inValue >= "" then integer (inValue) else 0.
       30         end.
       31         when "chk-name" then do:
       32           assign CodeName = if inValue >= "" then inValue else ? .
       33         end.
       34         when "alt-name" then do:
       35           assign misc1 = if inValue >= "" then inValue else ? .
       36         end.
       37         when "nds-code" then do:
       38           assign misc2 = if inValue >= "" then inValue else ? .
       39         end.
       40         when "unit-code" then do:
       41           assign misc3 = if inValue >= "" then inValue else ? .
       42         end.
       43         when "parent-code" then do:
       44           assign CodeValue = if inValue >= "" then inValue else ? .
       45         end.
       46       end case.
       47     end.
       48     method override protected void CheckData ():
       49       define variable v-str        as character no-undo.
       50       define variable v-list-rates as character no-undo.
       51       define variable strErr       as character no-undo.
       52       define variable rate         as character no-undo.
       53       define buffer buf_units for ub.units.
       54       assign
       55         v-str = "code" when code_ = ?
       56         v-str = v-str + ",chk-name" when CodeName = ?
       57         v-str = v-str + ",parent-code" when CodeValue = ?
       58       .
       59       v-str = trim (v-str, ",").
       60       if v-str > ''
       61       then
       62         undo, throw new Progress.Lang.AppError( substitute ("Теги &1 не могут иметь неопределное значение", v-str)).
       63       if misc2 <> "" then do:
       64         run getListTaxRateValue in ibs.th.gbl.gbl-hndllib:g#library
       65           ("НДС", ?, 0, "", 0, output v-list-rates).
       66         rate = string(decimal(misc2)) no-error.
       67         if error-status:error or
       68            not can-do(v-list-rates, rate) then
       69           strErr = strErr + substitute("~nЗначение ~"&1~" тега <nds-code> не найден в справочнике ~"Налоги~"", misc2)
       70         .
       71       end.
       72       else misc2 = "20".
       73       if misc3 <> "" and misc3 <> ? then do:
       74         if not can-find(first buf_units where buf_units.unit-name = misc3 no-lock) then
       75           strErr = strErr + substitute("~nЗначение ~"&1~" тега <unit-code> не найден в справочнике ~"Единицы измерения~"", misc3)
       76         .
       77       end.
       78       else misc3 = "лт".
       79       if strErr <> "" then
       80         undo, throw new Progress.Lang.AppError(strErr).
       81     end.
       82   end class.
