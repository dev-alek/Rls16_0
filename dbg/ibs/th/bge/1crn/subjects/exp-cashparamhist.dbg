        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.bge.1crn.export.send1cerpsub.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.exp-CashParamHist inherits send1cerpsub implements iexpsubject:
        7      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8      define override public property vss-author      as character no-undo init "$Author:$":U get.
        9      define override public property vss-date        as character no-undo init "$Date:$":U get.
       10      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12      define override public property vss-description as character no-undo init "Выгрузка кассовых параметров" get.
       13         define override public property InitSecTag as character no-undo init 'Current-params':U
       14      get.
       15      define override public property sendTableName  as character  no-undo init "Cash-param-hist"
       16      get.
       17      method override public void CheckParam(  ):
       18         return.
       19      end method.
       20      method private character fConvetDateTime
       21         (input iTStamp as dec):
       22        define variable vDateTime as datetime  no-undo.
       23        define variable vDate     as date      no-undo.
       24        define variable vDays     as int64     no-undo.
       25        define variable vSec      as integer   no-undo.
       26        define variable vTimeZone as character no-undo.
       27        vDays = truncate(int64(iTStamp) / 3600 / 24, 0).
       28        vDate = date("01/01/1970") + vDays.
       29        vSec = (int64(iTStamp) - vDays * 3600 * 24).
       30        if timezone >= 0
       31        then
       32           vTimeZone = "+" + string( timezone * 60,"HH:MM").
       33        else
       34           vTimeZone = "-" + string( timezone * -60,"HH:MM").
       35        return string(iso-date(datetime-tz(string(vDate,"99/99/9999") + " " + string(vSec, "HH:MM:SS" + vTimeZone) ))).
       36      end method.
       37      method override public void CrContentToSW( input insw as handle ):
       38         define buffer code for ub.code.
       39         for each Cash-param-hist
       40         no-lock:
       41            insw:start-element ("Current-param").
       42            insw:write-data-element (  "sign":U,                     string(Cash-param-hist.device            )).
       43            insw:write-data-element (  "source":U,                          Cash-param-hist.param_section     ).
       44            insw:write-data-element (  "section":U,                         Cash-param-hist.param_group       ).
       45            insw:write-data-element (  "name-current":U,                    Cash-param-hist.param_name        ).
       46            insw:write-data-element (  "value-current":U,                   Cash-param-hist.param_value       ).
       47            insw:write-data-element (  "source-value":U,                    Cash-param-hist.param_value_dop   ).
       48            insw:write-data-element (  "cd-num":U,                   string(Cash-param-hist.cash-num         )).
       49            insw:write-data-element (  "date-act-check":U, fConvetDateTime (Cash-param-hist.tstamp           )).
       50            insw:end-element("Current-param").
       51         end.
       52         return.
       53      end method.
       54   end class.
