        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.goods_barcode from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.goods inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property code_         as character    no-undo get. private set.
       12     define property del-l         as integer      no-undo get. private set.
       13     define property del-f         as integer      no-undo get. private set.
       14     define property grp-code      as character    no-undo get. private set.
       15     define property name_         as character    no-undo get. private set.
       16     define property eng-name      as character    no-undo get. private set.
       17     define property label-name    as character    no-undo get. private set.
       18     define property chk-name      as character    no-undo get. private set.
       19     define property artic         as character    no-undo get. private set.
       20     define property unit-code     as character    no-undo get. private set.
       21     define property prod-code     as integer      no-undo get. private set.
       22     define property wt            as decimal      no-undo get. private set.
       23     define property ms            as decimal      no-undo get. private set.
       24     define property gds-type      as character    no-undo get. private set.
       25     define property mark-type     as integer      no-undo get. private set.
       26     define property emc-type      as character    no-undo get. private set.
       27     define property ISCookStumped as integer      no-undo get. private set.
       28     define property CommodityCode as character    no-undo get. private set.
       29     define property img           as longchar     no-undo get. private set.
       30     define property unit-spl-code as character    no-undo get. private set.
       31     define property unit-k        as decimal      no-undo get. private set.
       32     define property nds-code      as integer      no-undo get. private set.
       33     define property enbl-ne       as integer      no-undo get. private set.
       34     define property enbl-zc       as integer      no-undo get. private set.
       35     define property enbl-exc      as integer      no-undo get. private set.
       36     define property srvc-type     as integer      no-undo get. private set.
       37     define property fuel-type     as integer      no-undo get. private set.
       38     define property oil-grp       as character    no-undo get. private set.
       39     define property max-dnsty     as decimal      no-undo get. private set.
       40     define property min-dnsty     as decimal      no-undo get. private set.
       41     define property pay-trk       as integer      no-undo get. private set.
       42     define property neu-z         as decimal      no-undo get. private set.
       43     define property neu-l         as decimal      no-undo get. private set.
       44     define property neu-storage-l as decimal      no-undo get. private set.
       45     define property neu-storage-z as decimal      no-undo get. private set.
       46     define property proteins      as decimal      no-undo get. private set.
       47     define property fats          as decimal      no-undo get. private set.
       48     define property carbohydrates as decimal      no-undo get. private set.
       49     define property calories      as decimal      no-undo get. private set.
       50     define property vad-gds       as integer      no-undo get. private set.
       51     define property pay-flag      as integer      no-undo get. private set.
       52     define property is18plus      as integer      no-undo get. private set.
       53     define property loyalty-gift  as integer  no-undo get. private set.
       54     define property method-flag   as character    no-undo get. private set.
       55     define property code-AIS      as character    no-undo get. private set.
       56     define property production-use as integer      no-undo get. private set.
       57     define property barcode        as subjects     no-undo get. private set.
       58     define property unit-add-codes as subjects     no-undo get. private set.
       59     define property weighed-product as integer     no-undo get. private set.
       60     define override property InitTag as character no-undo init "good"
       61       get.
       62     constructor public goods ():
       63       InitListTag = "barcode,unit-add-codes".
       64     end constructor.
       65             method override protected void SetPropProtected (inTag as char, inValue as char) :
       66        case inTag:
       67         when "code"          then code_         = if inValue >= "" then inValue else "" .
       68         when "del-l"         then del-l         = if inValue >= "" then integer (inValue) else 0 .
       69         when "del-f"         then del-f         = if inValue >= "" then integer (inValue) else 0 .
       70         when "grp-code"      then grp-code      = if inValue >= "" then inValue else "" .
       71         when "name"          then name_         = if inValue >= "" then inValue else "" .
       72         when "eng-name"      then eng-name      = if inValue >= "" then inValue else "" .
       73         when "label-name"    then label-name    = if inValue >= "" then inValue else "" .
       74         when "chk-name"      then chk-name      = if inValue >= "" then inValue else "" .
       75         when "artic"         then artic         = if inValue >= "" then inValue else "" .
       76         when "unit-code"     then unit-code     = if inValue >= "" then inValue else "" .
       77         when "prod-code"     then prod-code     = if inValue >= "" then integer (inValue) else 0 .
       78         when "wt"            then wt            = if inValue >= "" then decimal (inValue) else 0.0 .
       79         when "ms"            then ms            = if inValue >= "" then decimal (inValue) else 0.0 .
       80         when "gds-type"      then gds-type      = if inValue >= "" then inValue else "" .
       81         when "mark-type"     then mark-type     = if inValue >= "" then integer (inValue) else 0 .
       82         when "emc-type"      then emc-type      = if inValue >= "" then inValue else "" .
       83         when "img"           then img           = if inValue >= "" then inValue else "" .
       84         when "unit-spl-code" then unit-spl-code = if inValue >= "" then inValue else "" .
       85         when "unit-k"        then unit-k        = if inValue >= "" then decimal (inValue) else 0.0 .
       86         when "nds-code"      then nds-code      = if inValue >= "" then integer (inValue) else 0 .
       87         when "enbl-ne"       then enbl-ne       = if inValue >= "" then integer (inValue) else 0 .
       88         when "enbl-zc"       then enbl-zc       = if inValue >= "" then integer (inValue) else 0 .
       89         when "enbl-exc"      then enbl-exc      = if inValue >= "" then integer (inValue) else 0 .
       90         when "srvc-type"     then srvc-type     = if inValue >= "" then integer (inValue) else 0 .
       91         when "fuel-type"     then fuel-type     = if inValue >= "" then integer (inValue) else 0 .
       92         when "oil-grp"       then oil-grp       = if inValue >= "" then inValue else "" .
       93         when "max-dnsty"     then max-dnsty     = if inValue >= "" then decimal (inValue) else 0.0 .
       94         when "min-dnsty"     then min-dnsty     = if inValue >= "" then decimal (inValue) else 0.0 .
       95         when "pay-trk"       then pay-trk       = if inValue >= "" then integer (inValue) else 0 .
       96         when "neu-z"         then neu-z         = if inValue >= "" then decimal (inValue) else 0.0 .
       97         when "neu-l"         then neu-l         = if inValue >= "" then decimal (inValue) else 0.0 .
       98         when "neu-storage-l" then neu-storage-l = if inValue >= "" then decimal (inValue) else 0.0 .
       99         when "neu-storage-z" then neu-storage-z = if inValue >= "" then decimal (inValue) else 0.0 .
      100         when "proteins"      then proteins      = if inValue >= "" then decimal (inValue) else 0.0 .
      101         when "fats"          then fats          = if inValue >= "" then decimal (inValue) else 0.0 .
      102         when "carbohydrates" then carbohydrates = if inValue >= "" then decimal (inValue) else 0.0 .
      103         when "calories"      then calories      = if inValue >= "" then decimal (inValue) else 0.0 .
      104         when "ISCookStumped" then ISCookStumped = if inValue >= "" then integer (inValue) else 0 .
      105         when "CommodityCode" then CommodityCode = if inValue >= "" then inValue else "" .
      106         when "code-ais"      then code-AIS      = if inValue >= "" then inValue else "" .
      107         when "vad-gds"       then vad-gds       = if inValue >= "" then integer (inValue) else 0 .
      108         when "pay-flag"      then pay-flag      = if inValue >= "" then integer (inValue) else 0 .
      109         when "is18plus"      then is18plus      = if inValue >= "" then integer (inValue) else 0 .
      110         when "loyalty-gift" then loyalty-gift  = if inValue >= "" then integer (inValue) else 0 .
      111         when "method-flag"   then method-flag   = if inValue >= "" then inValue else "" .
      112         when "production-use" then production-use = if inValue >= "" then integer (inValue) else 0 .
      113         when "weighed-product" then weighed-product = if inValue >= "" then integer (inValue) else 0 .
      114       end case.
      115       catch exProErrors as class Progress.Lang.ProError :
      116         case exProErrors:GetMessageNum(1):
      117           when 18207 then undo, throw new Progress.Lang.AppError(
      118             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
      119           ) .
      120           otherwise undo, throw new Progress.Lang.AppError(
      121             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
      122           ) .
      123         end case .
      124       end catch .
      125     end method.
      126     method override protected void SetPropProtected (inTag as char, inValue as longchar) :
      127        case inTag:
      128         when "img"           then img           = if inValue >= "" then inValue else "" .
      129       end case.
      130       catch exProErrors as class Progress.Lang.ProError :
      131         case exProErrors:GetMessageNum(1):
      132           when 18207 then undo, throw new Progress.Lang.AppError(
      133             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
      134           ) .
      135           otherwise undo, throw new Progress.Lang.AppError(
      136             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
      137           ) .
      138         end case .
      139       end catch .
      140     end method.
      141     method override protected void SetPropProtected(SubsObj as subjects):
      142       case SubsObj:InitTag:
      143         when "barcode"        then barcode        = SubsObj.
      144         when "unit-add-codes" then unit-add-codes = SubsObj.
      145       end case.
      146     end.
      147     method override protected void CheckData ():
      148       def var v-str as char no-undo.
      149       assign
      150         v-str = ",code" when code_ = ?
      151         v-str = v-str + ",grp-code" when grp-code = ?
      152         v-str = v-str + ",name" when name_ = ?
      153         v-str = v-str + ",unit-k" when unit-k = ?
      154       .
      155       v-str = substring(v-str, 2).
      156       if v-str > "" then undo, throw new Progress.Lang.AppError(
      157         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      158       ) .
      159     end method .
      160     method override protected void ClearSub():
      161       assign
      162           code_         = ?
      163           del-l         = ?
      164           del-f         = ?
      165           grp-code      = ?
      166           name_         = ?
      167           eng-name      = ?
      168           label-name    = ?
      169           chk-name      = ?
      170           artic         = ?
      171           unit-code     = ?
      172           prod-code     = ?
      173           wt            = ?
      174           ms            = ?
      175           gds-type      = ?
      176           mark-type     = ?
      177           emc-type      = ?
      178           img           = ?
      179           unit-spl-code = ?
      180           unit-k        = ?
      181           nds-code      = ?
      182           enbl-ne       = ?
      183           enbl-zc       = ?
      184           enbl-exc      = ?
      185           srvc-type     = ?
      186           fuel-type     = ?
      187           oil-grp       = ?
      188           max-dnsty     = ?
      189           min-dnsty     = ?
      190           pay-trk       = ?
      191           neu-z         = ?
      192           neu-l         = ?
      193           neu-storage-l = ?
      194           neu-storage-z = ?
      195           proteins      = ?
      196           fats          = ?
      197           carbohydrates = ?
      198           calories      = ?
      199           ISCookStumped = ?
      200           CommodityCode = ?
      201           vad-gds       = ?
      202           pay-flag      = ?
      203           is18plus      = ?
      204           loyalty-gift = ?
      205           method-flag   = ?
      206           code-AIS      = ?
      207           production-use = ?
      208           weighed-product = ?
      209       .
      210       if valid-object(barcode) then delete object barcode .
      211       if valid-object(unit-add-codes) then delete object unit-add-codes .
      212     end method .
      213   end class.
