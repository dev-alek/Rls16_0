        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.good-grps inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property del-l as integer no-undo
       13       get.
       14       private set.
       15     define property del-f as integer no-undo
       16       get.
       17       private set.
       18     define property upper-code as character no-undo
       19       get.
       20       private set.
       21     define property name_ as character no-undo
       22       get.
       23       private set.
       24     define property rn-code as character no-undo
       25       get.
       26       private set.
       27     define property r-mat as integer no-undo
       28       get.
       29       private set.
       30     define property Prohibition-sale as integer no-undo
       31       get.
       32       private set.
       33     define override property InitTag as character no-undo init "good-grp"
       34       get.
       35     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       36       case inTag:
       37         when "code" then
       38           do:
       39             assign
       40               code_ = inValue .
       41           end.
       42         when "del-l" then
       43           do:
       44             assign
       45               del-l = integer (inValue).
       46           end.
       47         when "del-f" then
       48           do:
       49             assign
       50               del-f = integer (inValue).
       51           end.
       52         when "upper-code" then
       53           do:
       54             assign
       55               upper-code = inValue.
       56           end.
       57         when "name" then
       58           do:
       59             assign
       60               name_ = inValue.
       61           end.
       62         when "rn-code" then
       63           do:
       64             assign
       65               rn-code = inValue.
       66           end.
       67         when "r-mat" then
       68           do:
       69             assign
       70               r-mat = integer(inValue).
       71           end.
       72         when "Prohibition-sale" then
       73           do:
       74             assign
       75               Prohibition-sale = integer(inValue).
       76           end.
       77       end case.
       78     end .
       79     method override protected void CheckData ():
       80       def var v-str as char no-undo.
       81       assign
       82         v-str = "code"
       83         when code_ = ?
       84         v-str = v-str + ",name"
       85         when name_ = ?
       86         .
       87       v-str = trim (v-str, ",").
       88       if v-str > ''
       89         then
       90         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       91     end.
       92     method override protected void ClearSub():
       93       assign
       94         code_   = ?
       95         del-l   = ?
       96         del-f   = ?
       97         name_   = ?
       98         rn-code = ?
       99         r-mat   = ?
      100         Prohibition-sale = ?
      101         .
      102     end.
      103   end class.
