        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.shift implements iexpsubject:
        5       define stream sinp .
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define variable v-binfile-converter-program as character no-undo initial 'exe/base64.exe':U .
        8   define temp-table temp-ext-file-line no-undo like ub.ext-file-line
        9     .
       10   method public void binfile_read (p-db-num       as integer,
       11   p-from-db-num  as integer,
       12   p-file-num     as integer,
       13   p-file-name    as character):
       14     define variable v-temp-file-name        as character no-undo .
       15     define variable v-convert-full-pathname as character no-undo .
       16     define variable v-input-full-pathname   as character no-undo .
       17     define variable v-temp-full-pathname    as character no-undo .
       18     define variable v-read-line             as character no-undo .
       19     define variable v-line-num              as integer   no-undo .
       20     define variable v-command-line          as character no-undo .
       21     define buffer buf_temp-ext-file-line for temp-ext-file-line .
       22     do
       23     on error undo, return error return-value
       24     :
       25       binfile_clear(input p-db-num
       26         ,input p-from-db-num
       27         ,input p-file-num
       28         ) .
       29       run gbl/_tmpfile.p
       30         (input  't':U
       31         ,input  '.b64':U
       32         ,output v-temp-file-name
       33         ) .
       34       RUN gbl/_tmpfile.p ( "report", ".txt", OUTPUT v-temp-file-name ) .
       35       assign
       36         file-info :file-name    = v-binfile-converter-program
       37         v-convert-full-pathname = file-info :full-pathname
       38       .
       39       assign
       40         file-info :file-name    = p-file-name
       41         v-input-full-pathname   = file-info :full-pathname
       42       .
       43       assign
       44         file-info :file-name    = v-temp-file-name
       45         v-temp-full-pathname    = file-info :full-pathname
       46       .
       47       if v-temp-full-pathname = ? then v-temp-full-pathname = v-temp-file-name .
       48       assign
       49         v-command-line = substitute('&1 -e "&2" &3':U
       50                                         ,v-convert-full-pathname
       51                                         ,v-input-full-pathname
       52                                         ,v-temp-full-pathname
       53                                         )
       54       .
       55       os-command silent value(v-command-line) .
       56       input stream sinp from value(v-temp-full-pathname) .
       57       assign
       58         v-line-num = 0
       59       .
       60       repeat
       61       :
       62         assign
       63           v-read-line = '':U
       64         .
       65         import stream sinp unformatted v-read-line .
       66         if v-read-line <> '':U
       67         then do:
       68           assign
       69             v-line-num  = v-line-num + 1
       70           .
       71           create buf_temp-ext-file-line .
       72           assign
       73             buf_temp-ext-file-line.db-num       = p-db-num
       74             buf_temp-ext-file-line.from-db-num  = p-from-db-num
       75             buf_temp-ext-file-line.file-num     = p-file-num
       76             buf_temp-ext-file-line.line-num     = v-line-num
       77             buf_temp-ext-file-line.sub-line-num = 0
       78             buf_temp-ext-file-line.line-text    = v-read-line
       79           .
       80         end.
       81       end.
       82       input stream sinp close .
       83       os-delete value(v-temp-full-pathname) .
       84     end.
       85   end method.
       86   method public void binfile_clear (p-db-num       as integer,
       87   p-from-db-num  as integer,
       88   p-file-num     as integer):
       89     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       90     do
       91     on error undo, return error return-value
       92     :
       93       for each buf_temp-ext-file-line
       94         where buf_temp-ext-file-line.db-num   = p-db-num
       95           and buf_temp-ext-file-line.from-db-num = p-from-db-num
       96           and buf_temp-ext-file-line.file-num = p-file-num
       97       on error undo, return error return-value
       98       :
       99         delete buf_temp-ext-file-line .
      100       end.
      101     end.
      102   end method.
      103     define property Msg as character no-undo
      104       get.
      105       private set.
      106       define property InitSecTag as character no-undo init 'shifts':U
      107       get.
      108     define public property sendTableName as character no-undo init "shift-obj"
      109       get.
      110     define public property sendOldRowid as rowid  no-undo
      111       get.
      112       set.
      113     define public property sendNewRowid as rowid  no-undo
      114       get.
      115       set.
      116     define property KeyRowid as rowid no-undo
      117       get.
      118       set.
      119     method public void CrContentToSW (insw as handle):
      120       define buffer buf_shift-obj   for ub.shift-obj .
      121       define buffer buf_shift-staff for ub.shift-staff .
      122       define variable v-dt-shift-start as datetime no-undo .
      123       define variable v-dt-shift-end   as datetime no-undo .
      124       Msg = "" .
      125       find first buf_shift-obj no-lock where rowid(buf_shift-obj) = KeyRowid no-error .
      126       if not available buf_shift-obj then undo, throw new Progress.Lang.AppError(
      127         substitute("Не найдена запись СМЕНА shift-obj rowid [&1]", KeyRowid)
      128       ) .
      129       sendOldRowid  = KeyRowid.
      130       insw:start-element ('shift':U) .
      131       if buf_shift-obj.shift-date = ? then insw:write-empty-element( "shift-date":U ).
      132       else insw:write-data-element (  "shift-date":U,  iso-date(buf_shift-obj.shift-date)  ).
      133       insw:write-data-element (  "shift-num":U,  string(buf_shift-obj.shift-num)  ).
      134       insw:write-data-element (  "shift-number":U,  string(buf_shift-obj.shift-name)  ).
      135       assign
      136         v-dt-shift-start = datetime(buf_shift-obj.open-date, buf_shift-obj.open-time * 1000)
      137         v-dt-shift-end   = if (buf_shift-obj.status_ = 'зкр':U) then
      138                            datetime(buf_shift-obj.close-date, buf_shift-obj.close-time * 1000)
      139                            else ?
      140       .
      141       if v-dt-shift-start = ? then insw:write-empty-element ( "shift-start":U ) .
      142       else insw:write-data-element (  "shift-start":U,  iso-date(v-dt-shift-start)  ) .
      143       if v-dt-shift-end   = ? then insw:write-empty-element ( "shift-end":U   ) .
      144       else insw:write-data-element (  "shift-end":U,    iso-date(v-dt-shift-end)    ) .
      145       if can-find (first buf_shift-staff
      146                    where buf_shift-staff.obj-type   = buf_shift-obj.obj-type
      147                      and buf_shift-staff.obj-code   = buf_shift-obj.obj-code
      148                      and buf_shift-staff.shift-date = buf_shift-obj.shift-date
      149                      and buf_shift-staff.shift-num  = buf_shift-obj.shift-num
      150                      and buf_shift-staff.next-shift = false) then do:
      151         insw:start-element ('personal':U) .
      152         for each buf_shift-staff no-lock
      153            where buf_shift-staff.obj-type   = buf_shift-obj.obj-type
      154              and buf_shift-staff.obj-code   = buf_shift-obj.obj-code
      155              and buf_shift-staff.shift-date = buf_shift-obj.shift-date
      156              and buf_shift-staff.shift-num  = buf_shift-obj.shift-num
      157              and buf_shift-staff.next-shift = false :
      158           insw:start-element ('cashier':U) .
      159           if buf_shift-staff.psn-code > 0 then
      160           insw:write-data-element (  "cashier-code",  string(buf_shift-staff.psn-code)                 ) .
      161           else
      162           insw:write-data-element (  "cashier-code",  "0"                 ) .
      163           insw:write-data-element (  "main-cashier",  if buf_shift-staff.staff-role then "1" else "0"  ) .
      164           insw:end-element ('cashier':U) .
      165         end .
      166         insw:end-element ('personal':U) .
      167       end.
      168         if v-dt-shift-end <> ? then
      169         do:
      170             define buffer buf_reportShift for ub.reportShift .
      171             define variable mypar      as character no-undo .
      172             define variable check-html as character no-undo .
      173             define variable v-ras      as logical   no-undo .
      174             define variable report-html1      as longchar no-undo .
      175             define buffer buf_temp-ext-file-line for temp-ext-file-line .
      176             find first buf_reportShift exclusive-lock where
      177                 buf_reportShift.obj-code  = buf_shift-obj.obj-code
      178                 and buf_reportShift.obj-type = buf_shift-obj.obj-type
      179                 and buf_reportShift.shift-date = buf_shift-obj.shift-date
      180                 and buf_reportShift.shift-num  = buf_shift-obj.shift-num
      181                 and buf_reportShift.report-type  = 0 no-error .
      182             if not avail buf_reportShift then
      183             do:
      184                 Msg = substitute("Чек лист за смену &1 &2 не найден.", buf_shift-obj.shift-date, buf_shift-obj.shift-num).
      185                 return error.
      186             end.
      187             mypar =
      188                 "X-DATE-START = " + string(buf_reportShift.shift-date, "99/99/9999") + chr(44) +
      189                 "X-SHIFT-START = " + string(buf_reportShift.shift-num) + chr(44) +
      190                 "X-OBJ-CODE = " + string(buf_reportShift.obj-code) + chr(44) +
      191                 "X-OBJ-TYPE = " + string(buf_reportShift.obj-type) .
      192             if can-find (first shift-param where shift-param.obj-code = buf_reportShift.obj-code and
      193                 shift-param.obj-type = buf_reportShift.obj-type and
      194                 shift-param.shift-date = buf_reportShift.shift-date and
      195                 shift-param.shift-num = buf_reportShift.shift-num and
      196                 (shift-param.error-mass or shift-param.error-paid-trans)) then v-ras = true .
      197             run rep/r-shiftClose.p
      198                 (input buf_shift-obj.host-code
      199                 ,input mypar
      200                 ,input yes
      201                 ,input v-ras
      202                 ,input false
      203                 ,output check-html
      204                 ) .
      205             buf_reportShift.report-html = check-html .
      206             if search(buf_reportShift.report-html) <> ? then
      207             do:
      208                 binfile_read(input  0
      209                     ,input  1
      210                     ,input  1
      211                     ,input  buf_reportShift.report-html
      212                     ) .
      213                 for each buf_temp-ext-file-line
      214                     where buf_temp-ext-file-line.db-num   = 0
      215                     and buf_temp-ext-file-line.from-db-num = 1
      216                     and buf_temp-ext-file-line.file-num = 1
      217                     on error undo, return error return-value
      218                     :
      219                     report-html1 = report-html1 + buf_temp-ext-file-line.line-text .
      220                 end.
      221             end.
      222             insw:start-element ("checklist") .
      223             insw:write-data-element (  "id":U,   string(buf_reportShift.id)    ).
      224             insw:write-data-element (  "generation":U,   if buf_reportShift.date = ? then "" else iso-date (datetime (buf_reportShift.date, buf_reportShift.time_ * 1000))).
      225             insw:write-data-element (  "checklist-html":U,  report-html1 ).
      226             insw:write-data-element (  "suspicious-chk":U,  if buf_reportShift.flag then "1" else "0" ).
      227             insw:write-data-element (  "operator":U,  string(buf_reportShift.fio) ).
      228             insw:write-data-element (  "id-user":U,   entry(2,buf_reportShift.user-id,"-")  ).
      229             insw:end-element ("checklist") .
      230         end.
      231       insw:end-element ('shift':U) .
      232       catch exAppErrors as class Progress.Lang.AppError :
      233         Msg = exAppErrors:ReturnValue .
      234         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
      235         undo, throw exAppErrors .
      236       end catch .
      237       catch exProErrors as class Progress.Lang.ProError :
      238         Msg = exProErrors:GetMessage(1) .
      239         undo, throw exProErrors .
      240       end catch .
      241       catch exAnyErrors as class Progress.Lang.Error:
      242         Msg = "Unexpected error occurred..." .
      243         undo, throw exAnyErrors .
      244       end catch .
      245       finally :
      246       end finally .
      247     end method .
      248     method private character dtimeFormat (p-date as date, p-time as integer) :
      249       define variable v-dt-format as character initial "99.99.9999" no-undo .
      250       define variable v-tm-format as character initial "hh:mm:ss" no-undo .
      251       define variable v-str-dtime as character no-undo .
      252       if (p-date = ?) then v-str-dtime = "" .
      253       else assign
      254          v-str-dtime = string(p-date, v-dt-format)
      255          v-str-dtime  = v-str-dtime  + " " + string(p-time, v-tm-format) when (p-time >= 0)
      256       .
      257       return v-str-dtime .
      258     end method .
      259     method private character dateFormat (p-date as date) :
      260       define variable v-dt-format as character initial "99.99.9999" no-undo .
      261       return if (p-date = ?) then "" else string(p-date, v-dt-format) .
      262     end method .
      263   end class.
