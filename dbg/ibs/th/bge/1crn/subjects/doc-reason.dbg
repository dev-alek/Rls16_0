        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.doc-reason inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_         as character    no-undo get.
       10       private set.
       11     define property del-l         as integer      no-undo get.
       12       private set.
       13     define property del-f         as integer      no-undo get.
       14       private set.
       15     define property name_         as character    no-undo get.
       16       private set.
       17     define property description_  as character    no-undo get.
       18       private set.
       19     define override property InitTag as character no-undo init "doc-reason"
       20       get.
       21     method override protected void SetPropProtected (inTag as char, inValue as char):
       22       case inTag:
       23         when "code" then
       24           do:
       25             assign
       26               code_ = inValue .
       27           end.
       28         when "del-l" then
       29           do:
       30             assign
       31               del-l = integer (inValue).
       32           end.
       33         when "del-f" then
       34           do:
       35             assign
       36               del-f = integer (inValue).
       37           end.
       38         when "name" then
       39           do:
       40             assign
       41               name_ = inValue .
       42           end.
       43         when "description" then
       44           do:
       45             assign
       46               description_ = inValue .
       47           end.
       48       end case.
       49     end.
       50     method override protected void CheckData ():
       51       def var v-str as char no-undo.
       52       assign
       53         v-str = "code"
       54         when code_ = ?
       55         v-str = v-str + ",name"
       56         when name_ = ?
       57       .
       58       v-str = trim (v-str, ",").
       59       if v-str > ''
       60         then
       61         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       62     end.
       63     method override protected void ClearSub():
       64       assign
       65         code_         = ?
       66         del-l         = ?
       67         del-f         = ?
       68         name_         = ?
       69         description_  = ""
       70       .
       71     end.
       72   end class.
