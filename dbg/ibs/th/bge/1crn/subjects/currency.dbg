        1   USING Progress.Lang.*.
        2   block-level on error undo, throw.
        3   CLASS ibs.th.bge.1crn.subjects.currency inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_       as character    no-undo get. private set.
       10     define property del-l       as integer      no-undo get. private set.
       11     define property del-f       as integer      no-undo get. private set.
       12     define property name_       as character    no-undo get. private set.
       13     define property sym-name    as character    no-undo get. private set.
       14     define property name-in-words-1    as character    no-undo get. private set.
       15     define property name-in-words-2    as character    no-undo get. private set.
       16     define property name-in-words-3    as character    no-undo get. private set.
       17     define property name-in-words-4    as character    no-undo get. private set.
       18     define property name-in-words-5    as character    no-undo get. private set.
       19     define property name-in-words-6    as character    no-undo get. private set.
       20     define override property InitTag as character no-undo init "currency"
       21       get.
       22     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       23       case inTag:
       24         when "code" then do:
       25           assign code_ = inValue .
       26         end.
       27         when "del-l" then do:
       28           assign del-l = integer (inValue).
       29         end.
       30         when "del-f" then do:
       31           assign del-f = integer (inValue).
       32         end.
       33         when "name" then do:
       34           assign name_ = inValue .
       35         end.
       36         when "sym-name" then do:
       37           assign sym-name = inValue .
       38         end.
       39         when "name-in-words-1" then do:
       40           assign name-in-words-1 = inValue .
       41         end.
       42         when "name-in-words-2" then do:
       43           assign name-in-words-2 = inValue .
       44         end.
       45         when "name-in-words-3" then do:
       46           assign name-in-words-3 = inValue .
       47         end.
       48         when "name-in-words-4" then do:
       49           assign name-in-words-4 = inValue .
       50         end.
       51         when "name-in-words-5" then do:
       52           assign name-in-words-5 = inValue .
       53         end.
       54         when "name-in-words-6" then do:
       55           assign name-in-words-6 = inValue .
       56         end.
       57       end case.
       58     end.
       59     method override protected void CheckData ():
       60       def var v-str as char no-undo.
       61       assign
       62         v-str = "code" when code_ = ?
       63         v-str = v-str + ",name" when name_ = ?
       64       .
       65       v-str = trim (v-str, ",").
       66       if v-str > ''
       67       then
       68         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       69     end.
       70     method override protected void ClearSub():
       71       assign
       72         code_     = ?
       73         del-l     = ?
       74         del-f     = ?
       75         name_     = ?
       76         sym-name  = ?
       77         name-in-words-1     = ?
       78         name-in-words-2     = ?
       79         name-in-words-3     = ?
       80         name-in-words-4     = ?
       81         name-in-words-5     = ?
       82         name-in-words-6     = ?
       83       .
       84     end.
       85   END CLASS.
