        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.str.placelib from propath .
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.tank implements iexpsubject:
        6     define variable placelib as class placelib no-undo .
        7     define buffer buf_place      for ub.place .
        8     define buffer com_place      for ub.place .
        9     define buffer buf_c-place    for ub.c-place .
       10     define buffer buf_place-attr for ub.place-attr .
       11     define buffer buf_pl-level   for ub.pl-level .
       12     define buffer buf_c-pl-level for ub.c-pl-level .
       13     define buffer buf_pl-level-mm   for ub.pl-level-mm .
       14     define buffer buf_pl-level-attr for ub.pl-level-attr .
       15     define buffer buf_pl-gds     for ub.pl-gds .
       16     define temp-table tt-place like ub.c-place
       17     field gds-code as integer.
       18     define temp-table tt-pl-level-mm like ub.pl-level-mm.
       19     define temp-table tt-pl-level like ub.c-pl-level
       20     field belt      as decimal
       21     field comp-err  as decimal
       22     field deltaV    as decimal
       23     .
       24     define variable ii      as integer   no-undo .
       25     define variable v-code  as character no-undo .
       26     define variable v-value as character no-undo .
       27     define variable v-ok    as logical   no-undo .
       28     define variable v-del   as logical   no-undo .
       29      define temp-table tt-place-attr
       30         field pl-code             like place.pl-code
       31         field place-type          as character
       32         field place-Si            as integer
       33         field place-diameter      as decimal
       34         field dead-balance        as decimal
       35         field place-rel-error     as decimal
       36         field pl-twice-code       like place.loc1
       37         field place-dens-prov     as decimal
       38         field place-local         as integer
       39         field place-asi-sertif    as integer
       40         field place-error-mass    as decimal
       41         field place-rvd-dnsty     as integer
       42         field place-rvd-lvl       as integer
       43         field place-rvd-tmp       as integer
       44         field place-dc-height     as integer
       45         field place-tank-tk       as decimal
       46         field place-dnst-mi-code  as character
       47         field place-lvl-mi-code   as character
       48         field place-tmp-mi-code   as character
       49         field place-passport-num  as character
       50         field place-passport-type as character
       51         field ponton              as logical
       52         field ponton-mass         as decimal
       53         field ponton-height       as decimal
       54         field com-vessel          as logical
       55         field com-tanks           as character
       56         field is-main             as logical
       57         field main-com-code       as character
       58         field gate-valve          as logical
       59         index pi as primary unique
       60         pl-code
       61         .
       62     define property Msg as character no-undo
       63       get.
       64       private set.
       65     define property pl-code as character no-undo
       66       get.
       67       set.
       68     define variable sw as handle no-undo.
       69     define property InitSecTag as character no-undo init "tanks"
       70       get.
       71       private set.
       72     define public property sendTableName as character no-undo init "place"
       73       get.
       74     define public property sendOldRowid as rowid  no-undo
       75       get.
       76       set.
       77     define public property sendNewRowid as rowid  no-undo
       78       get.
       79       set.
       80     method public void CrContentToSW (insw as handle):
       81       sw = insw .
       82       placelib = new placelib().
       83       find first buf_place no-lock where buf_place.pl-code = INTEGER (pl-code) no-error .
       84       if AVAILABLE buf_place then
       85       do:
       86         v-del = no .
       87         sendOldRowid = rowid(buf_place).
       88         create tt-place .
       89         BUFFER-COPY buf_place to tt-place .
       90         find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
       91         if AVAILABLE (buf_pl-gds) then do:
       92           tt-place.gds-code = buf_pl-gds.gds-code .
       93         end.
       94       end.
       95       else
       96       do:
       97         find LAST buf_c-place no-lock where buf_c-place.pl-code = INTEGER (pl-code) no-error .
       98         if AVAILABLE buf_c-place then
       99         do:
      100           v-del = yes .
      101           sendOldRowid = rowid(buf_c-place).
      102           create tt-place .
      103           BUFFER-COPY buf_c-place to tt-place .
      104           find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_c-place.pl-code no-error .
      105           if AVAILABLE (buf_pl-gds) then
      106           do:
      107             tt-place.gds-code = buf_pl-gds.gds-code .
      108           end.
      109         end.
      110         else
      111         do:
      112           Msg = "Нет складкского места с кодом" + pl-code .
      113           return error.
      114         end.
      115       end.
      116       find first buf_pl-level no-lock where buf_pl-level.pl-code = tt-place.pl-code and
      117         buf_pl-level.obj-code = tt-place.obj-code and
      118         buf_pl-level.obj-type = tt-place.obj-type no-error .
      119       if AVAILABLE buf_pl-level then
      120       do:
      121         for each buf_pl-level no-lock where buf_pl-level.pl-code = tt-place.pl-code and
      122           buf_pl-level.obj-code = tt-place.obj-code and
      123           buf_pl-level.obj-type = tt-place.obj-type:
      124           create tt-pl-level .
      125           buffer-copy buf_pl-level to tt-pl-level .
      126           find first buf_pl-level-attr no-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      127                                                  and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      128                                                  and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      129                                                  and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      130                                                  and buf_pl-level-attr.attr-code = "tarir-delta"
      131                                                  no-error .
      132           if available buf_pl-level-attr then tt-pl-level.comp-err = decimal (buf_pl-level-attr.attr-value) .
      133           find first buf_pl-level-attr no-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
      134                                                  and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
      135                                                  and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
      136                                                  and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
      137                                                  and buf_pl-level-attr.attr-code = "deltaV"
      138                                                  no-error .
      139           if available buf_pl-level-attr then tt-pl-level.deltaV = decimal (buf_pl-level-attr.attr-value) no-error .
      140           find first buf_pl-level-mm where
      141                      buf_pl-level-mm.obj-type   = tt-place.obj-type
      142                  and buf_pl-level-mm.obj-code   = tt-place.obj-code
      143                  and buf_pl-level-mm.pl-code    = tt-place.pl-code
      144                  and buf_pl-level-mm.min-level <= buf_pl-level.pl-level
      145                  and buf_pl-level-mm.max-level >= buf_pl-level.pl-level
      146                no-lock no-error.
      147           tt-pl-level.belt = if avail buf_pl-level-mm then buf_pl-level-mm.zone else 0.
      148         end .
      149       end .
      150       else
      151       do:
      152         for each buf_c-pl-level no-lock where buf_c-pl-level.pl-code = tt-place.pl-code and
      153           buf_c-pl-level.obj-code = tt-place.obj-code and
      154           buf_c-pl-level.obj-type = tt-place.obj-type:
      155           create tt-pl-level .
      156           buffer-copy buf_c-pl-level to tt-pl-level .
      157           find first buf_pl-level-attr no-lock where buf_pl-level-attr.obj-type  = buf_c-pl-level.obj-type
      158                                                  and buf_pl-level-attr.obj-code  = buf_c-pl-level.obj-code
      159                                                  and buf_pl-level-attr.pl-code   = buf_c-pl-level.pl-code
      160                                                  and buf_pl-level-attr.pl-level  = buf_c-pl-level.pl-level
      161                                                  and buf_pl-level-attr.attr-code = "tarir-delta"
      162                                                  no-error .
      163           if available buf_pl-level-attr then tt-pl-level.comp-err = decimal (buf_pl-level-attr.attr-value) .
      164           find first buf_pl-level-attr no-lock where buf_pl-level-attr.obj-type  = buf_c-pl-level.obj-type
      165                                                  and buf_pl-level-attr.obj-code  = buf_c-pl-level.obj-code
      166                                                  and buf_pl-level-attr.pl-code   = buf_c-pl-level.pl-code
      167                                                  and buf_pl-level-attr.pl-level  = buf_c-pl-level.pl-level
      168                                                  and buf_pl-level-attr.attr-code = "deltaV"
      169                                                  no-error .
      170           if available buf_pl-level-attr then tt-pl-level.deltaV = decimal (buf_pl-level-attr.attr-value) no-error .
      171           find first buf_pl-level-mm where
      172                      buf_pl-level-mm.obj-type = tt-place.obj-type
      173                  and buf_pl-level-mm.obj-code = tt-place.obj-code
      174                  and buf_pl-level-mm.pl-code = tt-place.pl-code
      175                  and buf_pl-level-mm.min-level <= buf_c-pl-level.pl-level
      176                  and buf_pl-level-mm.max-level >= buf_c-pl-level.pl-level
      177                no-lock no-error.
      178           tt-pl-level.belt = if avail buf_pl-level-mm then buf_pl-level-mm.zone else 0.
      179         end.
      180       end.
      181       find first buf_pl-level-mm where
      182                  buf_pl-level-mm.pl-code = tt-place.pl-code
      183              and buf_pl-level-mm.obj-code = tt-place.obj-code
      184              and buf_pl-level-mm.obj-type = tt-place.obj-type no-lock no-error .
      185       if avail buf_pl-level-mm then
      186       do:
      187           for each buf_pl-level-mm where
      188                    buf_pl-level-mm.pl-code = tt-place.pl-code
      189                and buf_pl-level-mm.obj-code = tt-place.obj-code
      190                and buf_pl-level-mm.obj-type = tt-place.obj-type
      191               no-lock:
      192               create tt-pl-level-mm .
      193               buffer-copy buf_pl-level-mm to tt-pl-level-mm .
      194           end.
      195       end.
      196       for each tt-place where tt-place.pl-code = INTEGER (pl-code) no-lock :
      197         find first tt-place-attr exclusive-lock where tt-place-attr.pl-code = tt-place.pl-code no-error.
      198         if not available tt-place-attr then
      199         do :
      200           create tt-place-attr.
      201           tt-place-attr.pl-code = tt-place.pl-code.
      202           ii = 0.
      203           do ii = 1 to num-entries('place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve':u):
      204             v-code = entry(ii,'place-type,place-SI,place-diameter,dead-balance,water-level,dens-prov,place-virtual,place-twice-code,place-sert-urov,place-local,place-error-mass,place-asi-sertif,place-rvd-dnsty,place-rvd-lvl,place-rvd-tmp,place-SI-dens,place-SI-level,place-SI-temp,place-passp-num,place-passp-type,place-dead-high,place-temp-coef,disable-water-alarm,disable-level-alarm,place-ponton,place-ponton-mass,place-ponton-height,place-com-vessel,place-com-tanks,place-is-main,place-gate-valve':u) .
      205             placelib:placelib_get-attr (
      206               input v-code
      207               ,input tt-place.obj-code
      208               ,input tt-place.obj-type
      209               ,input tt-place.pl-code
      210               ,output v-value
      211               ,output v-ok      ) no-error.
      212              case v-code :
      213                 when "place-type" then
      214                    do :
      215                       if v-ok then
      216                       do :
      217                          if integer(v-value) = 1 then tt-place-attr.place-type = "1"  .
      218                          if integer(v-value) = 2 then tt-place-attr.place-type = "2"  .
      219                       end.
      220                    end.
      221                 when "place-SI" then
      222                    do :
      223                       if v-ok then tt-place-attr.place-Si = integer(v-value) .
      224                    end.
      225                 when "place-diameter" then
      226                    do :
      227                       if v-ok then tt-place-attr.place-diameter = decimal(v-value) .
      228                    end.
      229                 when "dead-balance" then
      230                    do :
      231                       if v-ok then tt-place-attr.dead-balance = decimal(v-value) .
      232                    end.
      233                 when "dens-prov" then
      234                    do :
      235                       if v-ok then tt-place-attr.place-dens-prov = decimal(v-value) .
      236                    end.
      237                 when "place-twice-code" then
      238                    do:
      239                       if v-ok then tt-place-attr.pl-twice-code = v-value .
      240                    end.
      241                 when "place-error-mass" then
      242                    do:
      243                       if v-ok then tt-place-attr.place-error-mass = decimal(v-value) .
      244                    end.
      245                 when "place-local" then
      246                    do:
      247                       if v-ok then
      248                       do:
      249                          if v-value = "1" then tt-place-attr.place-local = 0 .
      250                          else tt-place-attr.place-local = 1 .
      251                       end.
      252                    end.
      253                 when "place-asi-sertif" then
      254                    do:
      255                       if v-ok then
      256                       do:
      257                          if v-value = "yes" then tt-place-attr.place-asi-sertif = 1 .
      258                          else tt-place-attr.place-asi-sertif = 0 .
      259                       end.
      260                    end.
      261                 when "place-rvd-dnsty" then
      262                    do:
      263                       if v-ok then
      264                       do:
      265                          if v-value = "yes" then tt-place-attr.place-rvd-dnsty = 1 .
      266                          else tt-place-attr.place-rvd-dnsty = 0 .
      267                       end.
      268                    end.
      269                 when "place-rvd-lvl" then
      270                    do:
      271                       if v-ok then
      272                       do:
      273                          if v-value = "yes" then tt-place-attr.place-rvd-lvl = 1 .
      274                          else tt-place-attr.place-rvd-lvl = 0 .
      275                       end.
      276                    end.
      277                 when "place-rvd-tmp" then
      278                    do:
      279                       if v-ok then
      280                       do:
      281                          if v-value = "yes" then tt-place-attr.place-rvd-tmp = 1 .
      282                          else tt-place-attr.place-rvd-tmp = 0 .
      283                       end.
      284                    end.
      285                 when "place-dead-high" then
      286                    do:
      287                       if v-ok then
      288                       do:
      289                          tt-place-attr.place-dc-height = integer(v-value).
      290                       end.
      291                    end.
      292                 when "place-temp-coef" then
      293                    do:
      294                       if v-ok then
      295                       do:
      296                          tt-place-attr.place-tank-tk = decimal(v-value).
      297                       end.
      298                    end.
      299                 when "place-SI-dens" then
      300                    do:
      301                       if v-ok then
      302                       do:
      303                          tt-place-attr.place-dnst-mi-code = v-value .
      304                          if tt-place-attr.place-dnst-mi-code = ? then tt-place-attr.place-dnst-mi-code = "0" .
      305                       end.
      306                    end.
      307                 when "place-SI-level" then
      308                    do:
      309                       if v-ok then
      310                       do:
      311                          tt-place-attr.place-lvl-mi-code = v-value .
      312                          if tt-place-attr.place-lvl-mi-code = ? then tt-place-attr.place-lvl-mi-code = "0" .
      313                       end.
      314                    end.
      315                 when "place-SI-temp" then
      316                    do:
      317                       if v-ok then
      318                       do:
      319                          tt-place-attr.place-tmp-mi-code = v-value.
      320                          if tt-place-attr.place-tmp-mi-code = ? then tt-place-attr.place-tmp-mi-code = "0" .
      321                       end.
      322                    end.
      323                 when "place-passp-num" then
      324                    do:
      325                       if v-ok then
      326                       do:
      327                          tt-place-attr.place-passport-num = v-value .
      328                       end.
      329                    end.
      330                 when "place-passp-type" then
      331                    do:
      332                       if v-ok then
      333                       do:
      334                          tt-place-attr.place-passport-type = v-value .
      335                       end.
      336                    end.
      337                 when "place-ponton" then do :
      338                   if v-ok then tt-place-attr.ponton = logical(v-value) .
      339                 end.
      340                 when "place-ponton-mass" then do:
      341                   if v-ok then tt-place-attr.ponton-mass = decimal(v-value) .
      342                 end.
      343                 when "place-ponton-height" then do:
      344                   if v-ok then tt-place-attr.ponton-height = decimal(v-value) .
      345                 end.
      346                 when "place-com-vessel" then do :
      347                   if v-ok then tt-place-attr.com-vessel = logical(v-value) .
      348                 end.
      349                 when "place-com-tanks" then do :
      350                   if v-ok then tt-place-attr.com-tanks = v-value .
      351                 end.
      352                 when "place-is-main" then do :
      353                   if v-ok then tt-place-attr.is-main = logical(v-value) .
      354                 end.
      355                 when "place-gate-valve" then do :
      356                   if v-ok then tt-place-attr.gate-valve = logical(v-value) .
      357                 end.
      358              end case.
      359           end.
      360           if tt-place-attr.com-vessel
      361           and not tt-place-attr.is-main
      362           and tt-place-attr.com-tanks > ""
      363           then
      364           do ii = 1 to num-entries(tt-place-attr.com-tanks) :
      365             find first com_place no-lock where com_place.obj-type = tt-place.obj-type
      366                                            and com_place.obj-code = tt-place.obj-code
      367                                            and com_place.loc1     = entry(ii, tt-place-attr.com-tanks)
      368                                            and com_place.status_  = ""
      369                                            no-error .
      370             if available com_place
      371             then do :
      372               placelib:placelib_get-attr (
      373               input "place-is-main"
      374               ,input com_place.obj-code
      375               ,input com_place.obj-type
      376               ,input com_place.pl-code
      377               ,output v-value
      378               ,output v-ok      ) no-error.
      379               if v-ok
      380               and logical (v-value)
      381               then do :
      382                 tt-place-attr.main-com-code = string(com_place.pl-code) .
      383               end .
      384             end .
      385           end .
      386         end.
      387         sw:start-element ("tank") .
      388         sw:write-data-element ("tank-code", string(tt-place.pl-code)).
      389         sw:write-data-element ("tank-num", string(tt-place.loc1)).
      390         sw:write-data-element ("del-l", if tt-place.status_ <> 'удал':U then "0" else "1").
      391         sw:write-data-element ("del-f", if v-del then "1" else "0").
      392         sw:write-data-element ("name", if tt-place.pl-name = ? then "" else tt-place.pl-name).
      393         sw:write-data-element ("gs-code", string(tt-place.obj-code)).
      394         for first tt-place-attr no-lock where tt-place-attr.pl-code = tt-place.pl-code:
      395           sw:write-data-element ("tank-type", string(tt-place-attr.place-type)).
      396           sw:write-data-element ("pl-qnty"  , string(tt-place.add-qnty)).
      397           sw:write-data-element ("max-qnty" , string(tt-place.max-qnty)).
      398           sw:write-data-element ("d-qnty"   , string(tt-place-attr.dead-balance)).
      399           sw:write-data-element ("tank-d"   , string(tt-place-attr.place-diameter)).
      400           sw:write-data-element ("dc-height" , string(tt-place-attr.place-dc-height)).
      401           sw:write-data-element ("rel-er"   , if tt-place-attr.place-type = "1" then "0.20" else "0.25").
      402           sw:write-data-element ("dnsty"    , string-mth (tt-place-attr.place-dens-prov)).
      403           sw:write-data-element ("main-mi-code"  , string(if tt-place-attr.place-Si = ? then 0 else tt-place-attr.place-Si)).
      404           sw:write-data-element ("position"  , string(tt-place-attr.place-local)).
      405           sw:write-data-element ("certified"  , string(tt-place-attr.place-asi-sertif)).
      406           sw:write-data-element ("pipe-er"  , string-mth(tt-place-attr.place-error-mass)).
      407           sw:write-data-element ("tank-tk" , string(tt-place-attr.place-tank-tk)).
      408           sw:write-data-element ("rvd-dnsty"  , string(tt-place-attr.place-rvd-dnsty)).
      409           sw:write-data-element ("dnst-mi-code" , string(if tt-place-attr.place-dnst-mi-code = ? then "0" else tt-place-attr.place-dnst-mi-code)).
      410           sw:write-data-element ("rvd-lvl"  , string(tt-place-attr.place-rvd-lvl)).
      411           sw:write-data-element ("lvl-mi-code" , string(if tt-place-attr.place-lvl-mi-code = ? then "0" else tt-place-attr.place-lvl-mi-code)).
      412           sw:write-data-element ("rvd-tmp"  , string(tt-place-attr.place-rvd-tmp)).
      413           sw:write-data-element ("tmp-mi-code" , string(if tt-place-attr.place-tmp-mi-code = ? then "0" else tt-place-attr.place-tmp-mi-code)).
      414           sw:write-data-element ("gd-code", string(tt-place.gds-code)).
      415           sw:write-data-element ("izm-pr", if tt-place.is-meas = yes then "1" else "0").
      416           sw:write-data-element ("passport-num" , string(tt-place-attr.place-passport-num)).
      417           sw:write-data-element ("passport-type" , string(tt-place-attr.place-passport-type)).
      418           if tt-place-attr.place-type = "1"
      419           then do :
      420             if tt-place-attr.ponton
      421             then do :
      422               sw:write-data-element ("pontoon", "1").
      423               sw:write-data-element ("wght-pntn", string(tt-place-attr.ponton-mass)).
      424               sw:write-data-element ("srfcng-pntn", string(tt-place-attr.ponton-height)).
      425             end .
      426             else do :
      427               sw:write-data-element ("pontoon", "0").
      428             end .
      429           end .
      430           if tt-place-attr.com-vessel
      431           then do :
      432             sw:write-data-element ("com-vessel", "1").
      433             if tt-place-attr.is-main
      434             then do :
      435               sw:write-empty-element ("com-code") .
      436             end .
      437             else do :
      438               sw:write-data-element ("com-code", tt-place-attr.main-com-code) .
      439             end .
      440           end .
      441           if tt-place-attr.gate-valve
      442           then do :
      443             sw:write-data-element ("gate-valve", "1").
      444           end .
      445           else do :
      446             sw:write-data-element ("gate-valve", "0").
      447           end .
      448         end.
      449         find first tt-pl-level no-lock where tt-pl-level.pl-code = tt-place.pl-code and
      450           tt-pl-level.obj-code = tt-place.obj-code and
      451           tt-pl-level.obj-type = tt-place.obj-type no-error .
      452         if AVAILABLE (tt-pl-level) then
      453         do:
      454           sw:start-element ("cal-tbl") .
      455           for each tt-pl-level no-lock where tt-pl-level.pl-code = tt-place.pl-code and
      456             tt-pl-level.obj-code = tt-place.obj-code and
      457             tt-pl-level.obj-type = tt-place.obj-type:
      458             sw:start-element ("cal-tbl-line") .
      459             sw:write-data-element ("lvl"  , string(tt-pl-level.pl-level)).
      460             if tt-pl-level.belt <> 0 then sw:write-data-element ("belt", string(tt-pl-level.belt)).
      461             sw:write-data-element ("amnt" , string(tt-pl-level.pl-qnty)).
      462             sw:write-data-element ("comp-err" , string(tt-pl-level.comp-err,">9.999")).
      463             if tt-pl-level.deltaV > 0 then sw:write-data-element ("deltaV", trim(string(tt-pl-level.deltaV, ">>9.9999"))).
      464             sw:end-element ("cal-tbl-line")  .
      465           end.
      466           sw:end-element ("cal-tbl")  .
      467         end.
      468         find first tt-pl-level-mm no-lock where tt-pl-level-mm.pl-code = tt-place.pl-code and
      469           tt-pl-level-mm.obj-code = tt-place.obj-code and
      470           tt-pl-level-mm.obj-type = tt-place.obj-type no-error .
      471         if AVAILABLE (tt-pl-level-mm) then
      472         do:
      473           sw:start-element ("belt-tbl") .
      474           for each tt-pl-level-mm no-lock where tt-pl-level-mm.pl-code = tt-place.pl-code and
      475             tt-pl-level-mm.obj-code = tt-place.obj-code and
      476             tt-pl-level-mm.obj-type = tt-place.obj-type:
      477             sw:start-element ("belt-tbl-line") .
      478             sw:write-data-element ("num-belt"  , string(tt-pl-level-mm.zone)).
      479             sw:write-data-element ("low-lvl"  , string(tt-pl-level-mm.min-level)).
      480             sw:write-data-element ("up-lvl"  , string(tt-pl-level-mm.max-level)).
      481             sw:write-data-element ("tbl-lvl"  , string(tt-pl-level-mm.level)).
      482             sw:write-data-element ("Belt-capacity"  , left-trim(right-trim(string(tt-pl-level-mm.capacity / 1000,">>>9.9999"),"0")," ")).
      483             sw:end-element ("belt-tbl-line")  .
      484           end.
      485           sw:end-element ("belt-tbl")  .
      486         end.
      487         sw:END-ELEMENT ("tank") .
      488       end.
      489     end.
      490     method private character string-mth (inValue as decimal):
      491       def var v-str as character no-undo.
      492       if inValue = ?
      493         then v-str = "0".
      494       if string (inValue) begins "."
      495         then v-str = "0" + string (inValue).
      496       else v-str = string (inValue).
      497       return v-str.
      498     end.
      499   end class.
