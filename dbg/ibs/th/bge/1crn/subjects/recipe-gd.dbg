        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.recipe-gd inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-code as character no-undo
       10       get.
       11       private set.
       12     define property unit-code as character no-undo
       13       get.
       14       private set.
       15     define property qnty-net as decimal no-undo
       16       get.
       17       private set.
       18     define property qnty-gross as decimal no-undo
       19       get.
       20       private set.
       21     define property lf as decimal no-undo
       22       get.
       23       private set.
       24     define property gds-recipe-code as character no-undo
       25       get.
       26       private set.
       27     define property seasonal-losses as decimal no-undo
       28       get.
       29       private set.
       30     define property weight-gross    as decimal no-undo
       31       get.
       32       private set.
       33     define property wst as integer no-undo
       34       get.
       35       private set.
       36     define override property InitTag as character no-undo init "recipe-gd"
       37       get.
       38     method override protected void SetPropProtected (inTag as char, inValue as char):
       39       case inTag:
       40         when "gd-code"    then gd-code    = if inValue >= "" then inValue else "" .
       41         when "unit-code"  then unit-code  = if inValue >= "" then inValue else "" .
       42         when "qnty-net"   then qnty-net   = if inValue >= "" then decimal(inValue) else 0.0 .
       43         when "qnty-gross" then qnty-gross = if inValue >= "" then decimal(inValue) else 0.0 .
       44         when "lf"         then lf         = if inValue >= "" then decimal(inValue) else 0.0 .
       45         when "seasonal-losses" then seasonal-losses = if inValue >= "" then decimal(inValue) else 0.0 .
       46         when "weight-gross"    then weight-gross    = if inValue >= "" then decimal(inValue) else 0.0 .
       47         when "recipe-code" then gds-recipe-code = if inValue >= "" then inValue else "" .
       48         when "wst"        then wst        = if inValue >= "" then integer (inValue) else 0 .
       49       end case.
       50     end method.
       51     method override protected void CheckData ():
       52       def var v-str as char no-undo.
       53       assign
       54         v-str = ",gd-code" when gd-code = ?
       55       .
       56       v-str = substring(v-str, 2).
       57       if v-str > "" then undo, throw new Progress.Lang.AppError(
       58         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       59       ) .
       60     end method.
       61     method override protected void ClearSub():
       62       assign
       63         gd-code         = ?
       64         unit-code       = ?
       65         qnty-net        = ?
       66         qnty-gross      = ?
       67         lf              = ?
       68         gds-recipe-code = ?
       69         seasonal-losses = ?
       70         weight-gross    = ?
       71         wst             = ?
       72       .
       73     end method.
       74   end class.
