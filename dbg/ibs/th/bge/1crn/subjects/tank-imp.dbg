      257      method override protected void SetPropProtected(SubsObj as subjects):
      258         case SubsObj:InitTag:
      259            when "cal-tbl" then
      260               do:
      261                  cal-tbl = SubsObj.
      262               end.
      263            when "belt-tbl" then
      264               do:
      265                  belt-tbl = SubsObj.
      266               end.
      267         end case.
      268      end.
      269      method override protected void CheckData ():
      270         def var v-str as char no-undo.
      271         assign
      272            v-str = "tank-code"
      273            when tank-code = ?
      274            v-str = v-str + ",gs-code"
      275            when gs-code = ?
      276            v-str = v-str + ",table-version"
      277            when table-version = ?
      278         .
      279         v-str = trim (v-str, ",").
      280         if v-str > ''
      281            then
      282            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      283      end.
