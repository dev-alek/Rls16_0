        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.kass-book-gd inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property gd-code as character  no-undo get. private set.
        9     define override property InitTag as character no-undo init "kb-gd"
       10       get.
       11             method override protected void SetPropProtected (inTag as char, inValue as char):
       12       case inTag:
       13         when "gd-code" then gd-code = if inValue >= "" then inValue else "" .
       14       end case.
       15       catch exProErrors as class Progress.Lang.ProError :
       16         case exProErrors:GetMessageNum(1):
       17           when 18207 then undo, throw new Progress.Lang.AppError(
       18             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       19           ) .
       20           otherwise undo, throw new Progress.Lang.AppError(
       21             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       22           ) .
       23         end case .
       24       end catch .
       25     end method.
       26     method override protected void CheckData ():
       27       def var v-str as char no-undo.
       28       assign
       29         v-str = ""
       30       .
       31       v-str = substring(v-str, 2).
       32       if v-str > "" then undo, throw new Progress.Lang.AppError(
       33         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       34       ) .
       35     end method .
       36     method override protected void ClearSub():
       37       assign
       38         gd-code = ?
       39       .
       40     end method .
       41   end class.
