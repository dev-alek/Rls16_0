        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.transport_section from propath.
        4   using ibs.th.bge.1crn.subjects.transport_section_calibration-table from propath.
        5   using ibs.th.bge.1crn.subjects.transport from propath.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.1crn.subjects.transport inherits ibs.th.bge.1crn.subjects.asubject:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13      define property code_       as character    no-undo get.
       14         private set.
       15      define property del-l       as integer      no-undo get.
       16         private set.
       17      define property del-f       as integer      no-undo get.
       18         private set.
       19      define property ac-type     as integer      no-undo get.
       20         private set.
       21      define property mark        as character    no-undo get.
       22         private set.
       23      define property reg-num     as character    no-undo get.
       24         private set.
       25      define property tr-owner    as character    no-undo get.
       26         private set.
       27      define property is-ac       as integer      no-undo get.
       28         private set.
       29      define property name_       as character    no-undo get.
       30         private set.
       31      define property ess         as integer      no-undo get.
       32         private set.
       33      define property neck-type   as integer      no-undo get.
       34         private set.
       35      define property me-vlm      as decimal      no-undo get.
       36         private set.
       37      define property ac-tk       as decimal      no-undo get.
       38         private set.
       39      define property valve       as integer      no-undo get.
       40         private set.
       41      define property con-sleeve  as decimal      no-undo get.
       42         private set.
       43      define property sections    as subjects     no-undo get.
       44         private set.
       45      define property calibration-table    as subjects     no-undo get.
       46         private set.
       47      define override property InitTag as character no-undo init "transport"
       48         get.
       49      constructor public transport ():
       50         InitListTag = "sections,calibration-table".
       51      end constructor.
       52      method override protected void SetPropProtected (inTag as char, inValue as char):
       53         case inTag:
       54            when "code" then
       55               do:
       56                  assign
       57                     code_ = inValue .
       58               end.
       59            when "del-l" then
       60               do:
       61                  assign
       62                     del-l = integer(inValue) .
       63               end.
       64            when "del-f" then
       65               do:
       66                  assign
       67                     del-f = integer(inValue) .
       68               end.
       69            when "ac-type" then
       70               do:
       71                  assign
       72                     ac-type = integer(inValue) .
       73               end.
       74            when "mark" then
       75               do:
       76                  assign
       77                     mark = inValue.
       78               end.
       79            when "reg-num" then
       80               do:
       81                  assign
       82                     reg-num = replace(inValue, " ", "").
       83               end.
       84            when "tr-owner" then
       85               do:
       86                  assign
       87                     tr-owner = inValue.
       88               end.
       89            when "is-ac" then
       90               do:
       91                  assign
       92                     is-ac = integer(inValue) .
       93               end.
       94            when "name" then
       95               do:
       96                  assign
       97                     name_ = inValue.
       98               end.
       99            when "ess" then
      100               do:
      101                  assign
      102                     ess = integer(inValue).
      103               end.
      104            when "neck-type" then
      105               do:
      106                  assign
      107                     neck-type = integer(inValue) .
      108               end.
      109            when "me-vlm" then
      110               do:
      111                  assign
      112                     me-vlm = decimal(inValue) .
      113               end.
      114            when "ac-tk" then
      115               do:
      116                  assign
      117                     ac-tk = decimal(inValue) .
      118               end.
      119            when "valve" then
      120               do:
      121                  assign
      122                     valve = integer(inValue) .
      123               end.
      124            when "con-sleeve" then
      125               do:
      126                  assign
      127                     con-sleeve = decimal(inValue) .
      128               end.
      129         end case.
      130      end.
      131      method override protected void SetPropProtected(SubsObj as subjects):
      132         case SubsObj:InitTag:
      133            when "sections" then
      134               do:
      135                  sections = SubsObj.
      136               end.
      137            when "calibration-table" then
      138               do:
      139                  calibration-table = SubsObj.
      140               end.
      141         end case.
      142      end.
      143      method override protected void CheckData ():
      144         def var v-str as char no-undo.
      145         assign
      146            v-str = v-str + ",ac-type"
      147            when ac-type = ?
      148            v-str = v-str + ",neck-type"
      149            when neck-type = ? and ess = 0
      150            v-str = v-str + ",me-vlm"
      151            when me-vlm = ? and ess = 0
      152            v-str = v-str + ",ac-tk"
      153            when ac-tk = ? and ess = 0
      154            .
      155         v-str = trim (v-str, ",").
      156         if v-str > ''
      157            then
      158            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      159      end.
      160      method override protected void ClearSub():
      161         assign
      162            code_     = ?
      163            del-l     = ?
      164            del-f     = ?
      165            ac-type   = ?
      166            mark      = ?
      167            reg-num   = ?
      168            tr-owner  = ?
      169            is-ac     = ?
      170            name_     = ?
      171            neck-type = ?
      172            me-vlm    = ?
      173            ac-tk     = ?
      174            ess       = ?
      175            valve     = ?
      176            con-sleeve = ?
      177            .
      178         delete object sections no-error .
      179         delete object calibration-table no-error .
      180      end.
      181   end class.
