        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.isubject from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.asubject abstract inherits ibs.th.gbl.sys.objth implements ibs.th.bge.1crn.subjects.isubject:
        6     define public property Msg as character
        7       get.
        8       set.
        9     define public property IsInitSubForWrite as logical
       10       get.
       11       protected set.
       12     define abstract property InitTag as character no-undo
       13       get.
       14     define override public property vss-description as character no-undo get():
       15          return "Объект сообщения " + InitTag.
       16      end.
       17     define public property InitListTag as character no-undo init ""
       18       get.
       19       set.
       20     method public void SetProp (inTag as char, inValue as char).
       21       if inTag = InitTag then do:
       22         InitSub().
       23         return.
       24       end.
       25       if not IsInitSubForWrite
       26         then undo, throw new Progress.Lang.AppError( substitute ( "Сущность &1 не инициализирована для записи", InitTag )).
       27       SetPropProtected (inTag, inValue).
       28     end.
       29     method public void InitProp ().
       30       IsInitSubForWrite = not IsInitSubForWrite .
       31     end.
       32     method public void SetProp (inTag as char, inValue as longchar).
       33       if inTag = InitTag then do:
       34         InitSub().
       35         return.
       36       end.
       37       if not IsInitSubForWrite
       38         then undo, throw new Progress.Lang.AppError( substitute ( "Сущность &1 не инициализирована для записи", InitTag )).
       39       SetPropProtected (inTag, inValue).
       40     end.
       41     method public void SetProp (inSubObj as isubject).
       42       SetPropProtected (inSubObj).
       43     end.
       44     method protected void SetPropProtected (inSubObj as isubject):
       45     end.
       46     method public void SetProp (inSubsObj as subjects).
       47       if not IsInitSubForWrite
       48         then undo, throw new Progress.Lang.AppError( substitute ( "Сущность &1 не инициализирована для записи", InitTag )).
       49       if lookup (inSubsObj:InitTag, InitListTag) = 0 or InitListTag = "" then do:
       50             undo, throw new Progress.Lang.AppError( substitute ("Поддержка подсущности &1 для сущности &2 не реализована", inSubsObj:InitTag, InitTag)).
       51       end.
       52       SetPropProtected (inSubsObj).
       53     end.
       54     method abstract protected void SetPropProtected (inTag as char, inValue as char).
       55     method protected void SetPropProtected (inSubsObj as subjects):
       56       undo, throw new Progress.Lang.AppError( substitute ("Поддержка подсущности &1 для сущности &2 не реализована", inSubsObj:InitTag, InitTag)).
       57     end.
       58     method protected void InitSub ():
       59       if not IsInitSubForWrite
       60       then do:
       61         ClearSub().
       62         IsInitSubForWrite = true.
       63       end.
       64       else do:
       65         CheckData().
       66         IsInitSubForWrite = false.
       67       end.
       68     end.
       69     method protected void SetPropProtected (inTag as char, inValue as longchar):
       70     end.
       71     destructor public asubject ( ):
       72         ClearSub().
       73     end.
       74     method abstract protected void ClearSub ().
       75     method abstract protected void CheckData ().
       76   end class.
