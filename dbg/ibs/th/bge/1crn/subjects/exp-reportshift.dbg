        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.export.send1cerpsub.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.exp-reportShift inherits send1cerpsub:
        6       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7       define override public property vss-author      as character no-undo init "$Author:$":U get.
        8       define override public property vss-date        as character no-undo init "$Date:$":U get.
        9       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11       define override public property vss-description as character no-undo init "Выгрузка отчетов в 1С" get.
       12       define stream sinp .
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable v-binfile-converter-program as character no-undo initial 'exe/base64.exe':U .
       15   define temp-table temp-ext-file-line no-undo like ub.ext-file-line
       16     .
       17   method public void binfile_read (p-db-num       as integer,
       18   p-from-db-num  as integer,
       19   p-file-num     as integer,
       20   p-file-name    as character):
       21     define variable v-temp-file-name        as character no-undo .
       22     define variable v-convert-full-pathname as character no-undo .
       23     define variable v-input-full-pathname   as character no-undo .
       24     define variable v-temp-full-pathname    as character no-undo .
       25     define variable v-read-line             as character no-undo .
       26     define variable v-line-num              as integer   no-undo .
       27     define variable v-command-line          as character no-undo .
       28     define buffer buf_temp-ext-file-line for temp-ext-file-line .
       29     do
       30     on error undo, return error return-value
       31     :
       32       binfile_clear(input p-db-num
       33         ,input p-from-db-num
       34         ,input p-file-num
       35         ) .
       36       run gbl/_tmpfile.p
       37         (input  't':U
       38         ,input  '.b64':U
       39         ,output v-temp-file-name
       40         ) .
       41       RUN gbl/_tmpfile.p ( "report", ".txt", OUTPUT v-temp-file-name ) .
       42       assign
       43         file-info :file-name    = v-binfile-converter-program
       44         v-convert-full-pathname = file-info :full-pathname
       45       .
       46       assign
       47         file-info :file-name    = p-file-name
       48         v-input-full-pathname   = file-info :full-pathname
       49       .
       50       assign
       51         file-info :file-name    = v-temp-file-name
       52         v-temp-full-pathname    = file-info :full-pathname
       53       .
       54       if v-temp-full-pathname = ? then v-temp-full-pathname = v-temp-file-name .
       55       assign
       56         v-command-line = substitute('&1 -e "&2" &3':U
       57                                         ,v-convert-full-pathname
       58                                         ,v-input-full-pathname
       59                                         ,v-temp-full-pathname
       60                                         )
       61       .
       62       os-command silent value(v-command-line) .
       63       input stream sinp from value(v-temp-full-pathname) .
       64       assign
       65         v-line-num = 0
       66       .
       67       repeat
       68       :
       69         assign
       70           v-read-line = '':U
       71         .
       72         import stream sinp unformatted v-read-line .
       73         if v-read-line <> '':U
       74         then do:
       75           assign
       76             v-line-num  = v-line-num + 1
       77           .
       78           create buf_temp-ext-file-line .
       79           assign
       80             buf_temp-ext-file-line.db-num       = p-db-num
       81             buf_temp-ext-file-line.from-db-num  = p-from-db-num
       82             buf_temp-ext-file-line.file-num     = p-file-num
       83             buf_temp-ext-file-line.line-num     = v-line-num
       84             buf_temp-ext-file-line.sub-line-num = 0
       85             buf_temp-ext-file-line.line-text    = v-read-line
       86           .
       87         end.
       88       end.
       89       input stream sinp close .
       90       os-delete value(v-temp-full-pathname) .
       91     end.
       92   end method.
       93   method public void binfile_clear (p-db-num       as integer,
       94   p-from-db-num  as integer,
       95   p-file-num     as integer):
       96     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       97     do
       98     on error undo, return error return-value
       99     :
      100       for each buf_temp-ext-file-line
      101         where buf_temp-ext-file-line.db-num   = p-db-num
      102           and buf_temp-ext-file-line.from-db-num = p-from-db-num
      103           and buf_temp-ext-file-line.file-num = p-file-num
      104       on error undo, return error return-value
      105       :
      106         delete buf_temp-ext-file-line .
      107       end.
      108     end.
      109   end method.
      110         define override public property InitSecTag as character no-undo init 'TH-reports':U
      111     get.
      112       define override public property sendTableName as character no-undo init "reportShift"
      113           get.
      114       method override public void CheckParam(  ):
      115           define buffer buf_reportShift for ub.reportShift .
      116           define variable mypar       as character no-undo .
      117           define variable report-html as character no-undo .
      118           define variable report-json as character no-undo .
      119           if not valid-handle(oldbh) then
      120           do:
      121               Msg = "Не передана ссылка на отчет.".
      122               return error.
      123           end.
      124           if oldbh:keys ne "obj-code,obj-type,shift-date,shift-num,report-type" then
      125           do:
      126               Msg = "Переданы не отчеты.".
      127               return error.
      128           end.
      129           find first buf_reportShift exclusive-lock where
      130               buf_reportShift.obj-code  = int(oldbh:buffer-field( "obj-code":U  ):buffer-value )
      131               and buf_reportShift.obj-type = oldbh:buffer-field( "obj-type":U  ):buffer-value
      132               and buf_reportShift.shift-date = date(oldbh:buffer-field( "shift-date":U  ):buffer-value )
      133               and buf_reportShift.shift-num  = int(oldbh:buffer-field( "shift-num":U  ):buffer-value )
      134               and buf_reportShift.report-type  = int(oldbh:buffer-field( "report-type":U  ):buffer-value ) no-error .
      135           if not avail buf_reportShift then
      136           do:
      137               Msg = substitute("Отчет &1 не найден.", oldbh:buffer-field( "id":U  ):buffer-value).
      138               return error.
      139           end.
      140           mypar =
      141               "X-DATE-START = " + string(buf_reportShift.shift-date, "99/99/9999") + chr(44) +
      142               "X-SHIFT-START = " + string(buf_reportShift.shift-num) + chr(44) +
      143               "X-DATE-END = " + string(buf_reportShift.shift-date, "99/99/9999") + chr(44) +
      144               "X-SHIFT-END = " + string(buf_reportShift.shift-num) .
      145           run rep/r-closeShift.p
      146               ( input parparentproc
      147               ,input ?
      148               ,input ''
      149               ,input mypar
      150               ,INPUT buf_reportShift.obj-code
      151               ,INPUT buf_reportShift.obj-type
      152               ,INPUT "руб"
      153               ,INPUT 0
      154               ,INPUT yes
      155               ,INPUT yes
      156               ,input yes
      157               ,input yes
      158               ,input no
      159               ,INPUT yes
      160               ,input no
      161               ,input yes
      162               ,input yes
      163               ,input yes
      164               ,input yes
      165               ,input yes
      166               ,input yes
      167               ,input yes
      168               ,input no
      169               ,input yes
      170               ,output report-html
      171               ,output report-json
      172               ) .
      173               buf_reportShift.report-html = report-html .
      174               buf_reportShift.report-json = report-json .
      175           return.
      176       end method.
      177       method override public void CrContentToSW (insw as handle):
      178           define buffer buf_reportShift for ub.reportShift .
      179           define variable v-dt-shift-start as datetime no-undo .
      180           define variable v-dt-shift-end   as datetime no-undo .
      181           define variable report-html      as longchar no-undo .
      182           define variable report-json      as longchar no-undo .
      183           define buffer buf_temp-ext-file-line for temp-ext-file-line .
      184           find first buf_reportShift no-lock where
      185               buf_reportShift.obj-code  = int(oldbh:buffer-field( "obj-code":U  ):buffer-value )
      186               and buf_reportShift.obj-type = oldbh:buffer-field( "obj-type":U  ):buffer-value
      187               and buf_reportShift.shift-date = date(oldbh:buffer-field( "shift-date":U  ):buffer-value )
      188               and buf_reportShift.shift-num  = int(oldbh:buffer-field( "shift-num":U  ):buffer-value )
      189               and buf_reportShift.report-type  = int(oldbh:buffer-field( "report-type":U  ):buffer-value ) no-error .
      190           sendOldRowid = rowid(buf_reportShift) .
      191           if search(buf_reportShift.report-html) <> ? then
      192           do:
      193               binfile_read(input  0
      194                   ,input  1
      195                   ,input  1
      196                   ,input  buf_reportShift.report-html
      197                   ) .
      198               for each buf_temp-ext-file-line
      199                   where buf_temp-ext-file-line.db-num   = 0
      200                   and buf_temp-ext-file-line.from-db-num = 1
      201                   and buf_temp-ext-file-line.file-num = 1
      202                   on error undo, return error return-value
      203                   :
      204                   report-html = report-html + buf_temp-ext-file-line.line-text .
      205               end.
      206           end.
      207           if search(buf_reportShift.report-json) <> ? then
      208           do:
      209               binfile_read(input  0
      210                   ,input  1
      211                   ,input  1
      212                   ,input  buf_reportShift.report-json
      213                   ) .
      214               for each buf_temp-ext-file-line
      215                   where buf_temp-ext-file-line.db-num   = 0
      216                   and buf_temp-ext-file-line.from-db-num = 1
      217                   and buf_temp-ext-file-line.file-num = 1
      218                   on error undo, return error return-value
      219                   :
      220                   report-json = report-json + buf_temp-ext-file-line.line-text .
      221               end.
      222           end.
      223           insw:start-element ("TH-report") .
      224           insw:write-data-element (  "id":U,   string(buf_reportShift.id)    ).
      225           insw:write-data-element (  "generation":U,   iso-date (datetime (buf_reportShift.date, buf_reportShift.time_ * 1000)) ).
      226           insw:write-data-element (  "shift-date":U, iso-date(buf_reportShift.shift-date) ) .
      227           insw:write-data-element (  "shift-num":U,   string(buf_reportShift.shift-num)    ).
      228           insw:write-data-element (  "shift-number":U,   string(buf_reportShift.shift-name)    ).
      229           insw:write-data-element (  "type":U,   string(buf_reportShift.report-type)    ).
      230           insw:write-data-element (  "operator":U,  string(buf_reportShift.fio) ).
      231           insw:write-data-element (  "id-user":U,   entry(2,buf_reportShift.user-id,"-")  ).
      232           insw:write-data-element (  "report-html":U,  report-html ).
      233           insw:write-data-element (  "report-json":U,  report-json ).
      234           insw:end-element ("TH-report") .
      235           finally:
      236               if Msg <> "" then
      237                   return error Msg.
      238           end finally.
      239       end method .
      240       method private character formatDateTime (iDateTime as datetime) :
      241           define variable vDateTime as character no-undo .
      242           if (iDateTime = ?) then vDateTime = "" .
      243           else
      244               vDateTime =  entry(1,iso-date(iDateTime),".")
      245                   .
      246           return vDateTime .
      247       end method .
      248       method private character formatDate (iDate as date) :
      249           return if (iDate = ?) then "" else iso-date(iDate) .
      250       end method .
      251       method private character getCreatorOrder (iUserId as character) :
      252           define variable vUserName as character no-undo.
      253           define buffer buf_user-account for ub.user-account .
      254           if iUserId <> '' then
      255           do:
      256               find first buf_user-account no-lock where
      257                   buf_user-account.user-id = iUserId no-error .
      258               if available (buf_user-account) then
      259                   vUserName = trim(buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name) .
      260           end.
      261           return vUserName.
      262       end method .
      263   end class.
