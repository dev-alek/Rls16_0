        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.bge.1crn.export.send1cerpsub.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.exp-CashParamControl inherits send1cerpsub implements iexpsubject:
        7      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8      define override public property vss-author      as character no-undo init "$Author:$":U get.
        9      define override public property vss-date        as character no-undo init "$Date:$":U get.
       10      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12      define override public property  vss-description as character no-undo init "Выгрузка эталонных кассовых параметров" get.
       13         define override public property InitSecTag as character no-undo init 'Control-etalon-params':U
       14      get.
       15      define override public property sendTableName  as character  no-undo init "code"
       16      get.
       17      method override public void CheckParam(  ):
       18         return.
       19      end method.
       20      method override public void CrContentToSW( input insw as handle ):
       21         define buffer code for ub.code.
       22         for each code where code.parent begins "cash-param"
       23                         and num-entries (code.parent,chr(4)) eq 4
       24         no-lock:
       25            insw:start-element ("Control-etalon-param").
       26            insw:write-data-element (  "sign":U,          string(int(entry(2,Code.parent,chr(4))))).
       27            insw:write-data-element (  "source":U,                   entry(3,Code.parent,chr(4))      ).
       28            insw:write-data-element (  "section":U,                  entry(4,Code.parent,chr(4))      ).
       29            insw:write-data-element (  "name":U,                     Code.code                 ).
       30            insw:write-data-element (  "value-etalon":U,             Code.CodeValue            ).
       31            insw:write-data-element (  "required":U,                 string(Code.status_ + 1)  ).
       32            if      Code.CodeName ne ?
       33               and  Code.CodeName ne ?
       34            then
       35               insw:write-data-element (  "description":U,              Code.CodeName             ).
       36            insw:end-element("Control-etalon-param").
       37         end.
       38         return.
       39      end method.
       40   end class.
