        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.export.send1cerpsub.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.exp-chkSlipHead inherits send1cerpsub:
        6       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7       define override public property vss-author      as character no-undo init "$Author:$":U get.
        8       define override public property vss-date        as character no-undo init "$Date:$":U get.
        9       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11       define override public property vss-description as character no-undo init "Выгрузка отчетов с касс в 1С" get.
       12       define stream sinp .
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable v-binfile-converter-program as character no-undo initial 'exe/base64.exe':U .
       15   define temp-table temp-ext-file-line no-undo like ub.ext-file-line
       16     .
       17   method public void binfile_read (p-db-num       as integer,
       18   p-from-db-num  as integer,
       19   p-file-num     as integer,
       20   p-file-name    as character):
       21     define variable v-temp-file-name        as character no-undo .
       22     define variable v-convert-full-pathname as character no-undo .
       23     define variable v-input-full-pathname   as character no-undo .
       24     define variable v-temp-full-pathname    as character no-undo .
       25     define variable v-read-line             as character no-undo .
       26     define variable v-line-num              as integer   no-undo .
       27     define variable v-command-line          as character no-undo .
       28     define buffer buf_temp-ext-file-line for temp-ext-file-line .
       29     do
       30     on error undo, return error return-value
       31     :
       32       binfile_clear(input p-db-num
       33         ,input p-from-db-num
       34         ,input p-file-num
       35         ) .
       36       run gbl/_tmpfile.p
       37         (input  't':U
       38         ,input  '.b64':U
       39         ,output v-temp-file-name
       40         ) .
       41       RUN gbl/_tmpfile.p ( "report", ".txt", OUTPUT v-temp-file-name ) .
       42       assign
       43         file-info :file-name    = v-binfile-converter-program
       44         v-convert-full-pathname = file-info :full-pathname
       45       .
       46       assign
       47         file-info :file-name    = p-file-name
       48         v-input-full-pathname   = file-info :full-pathname
       49       .
       50       assign
       51         file-info :file-name    = v-temp-file-name
       52         v-temp-full-pathname    = file-info :full-pathname
       53       .
       54       if v-temp-full-pathname = ? then v-temp-full-pathname = v-temp-file-name .
       55       assign
       56         v-command-line = substitute('&1 -e "&2" &3':U
       57                                         ,v-convert-full-pathname
       58                                         ,v-input-full-pathname
       59                                         ,v-temp-full-pathname
       60                                         )
       61       .
       62       os-command silent value(v-command-line) .
       63       input stream sinp from value(v-temp-full-pathname) .
       64       assign
       65         v-line-num = 0
       66       .
       67       repeat
       68       :
       69         assign
       70           v-read-line = '':U
       71         .
       72         import stream sinp unformatted v-read-line .
       73         if v-read-line <> '':U
       74         then do:
       75           assign
       76             v-line-num  = v-line-num + 1
       77           .
       78           create buf_temp-ext-file-line .
       79           assign
       80             buf_temp-ext-file-line.db-num       = p-db-num
       81             buf_temp-ext-file-line.from-db-num  = p-from-db-num
       82             buf_temp-ext-file-line.file-num     = p-file-num
       83             buf_temp-ext-file-line.line-num     = v-line-num
       84             buf_temp-ext-file-line.sub-line-num = 0
       85             buf_temp-ext-file-line.line-text    = v-read-line
       86           .
       87         end.
       88       end.
       89       input stream sinp close .
       90       os-delete value(v-temp-full-pathname) .
       91     end.
       92   end method.
       93   method public void binfile_clear (p-db-num       as integer,
       94   p-from-db-num  as integer,
       95   p-file-num     as integer):
       96     define buffer buf_temp-ext-file-line  for temp-ext-file-line .
       97     do
       98     on error undo, return error return-value
       99     :
      100       for each buf_temp-ext-file-line
      101         where buf_temp-ext-file-line.db-num   = p-db-num
      102           and buf_temp-ext-file-line.from-db-num = p-from-db-num
      103           and buf_temp-ext-file-line.file-num = p-file-num
      104       on error undo, return error return-value
      105       :
      106         delete buf_temp-ext-file-line .
      107       end.
      108     end.
      109   end method.
      110         define override public property InitSecTag as character no-undo init 'kass-reports':U
      111     get.
      112       define override public property sendTableName as character no-undo init "chkSlipHead"
      113           get.
      114       method override public void CheckParam(  ):
      115           define buffer buf_chk-slip-head for ub.chk-slip-head .
      116           if not valid-handle(oldbh) then
      117           do:
      118               Msg = "Не передана ссылка на отчет.".
      119               return error.
      120           end.
      121           if oldbh:keys ne "db-num,ID,CheckID,RRN" then
      122           do:
      123               Msg = "Переданы не отчеты.".
      124               return error.
      125           end.
      126           find first buf_chk-slip-head exclusive-lock where
      127               buf_chk-slip-head.obj-code  = int(oldbh:buffer-field( "obj-code":U  ):buffer-value )
      128               and buf_chk-slip-head.db-num = int(oldbh:buffer-field( "db-num":U  ):buffer-value )
      129               and buf_chk-slip-head.is-report = int(oldbh:buffer-field( "is-report":U  ):buffer-value )
      130               and buf_chk-slip-head.slip-dt  = datetime(oldbh:buffer-field( "slip-dt":U  ):buffer-value ) no-error .
      131           if not avail buf_chk-slip-head then
      132           do:
      133               Msg = substitute("Отчет &1 не найден.", oldbh:buffer-field( "id":U  ):buffer-value).
      134               return error.
      135           end.
      136           return.
      137       end method.
      138       method override public void CrContentToSW (insw as handle):
      139           define buffer buf_chk-slip-head  for ub.chk-slip-head .
      140           define buffer bf_chk-slip-head   for ub.chk-slip-head .
      141           define buffer bf_chk-slip-string for ub.chk-slip-string .
      142           define variable report-txt    as longchar no-undo .
      143           define variable report-json   as longchar no-undo .
      144           define variable v-report-txt  as longchar no-undo .
      145           define variable v-report-json as longchar no-undo .
      146           define buffer buf_temp-ext-file-line for temp-ext-file-line .
      147           define variable vMemptr-txt  as memptr no-undo .
      148           define variable vMemptr-json as memptr no-undo .
      149           find first buf_chk-slip-head no-lock where
      150               buf_chk-slip-head.obj-code  = int(oldbh:buffer-field( "obj-code":U  ):buffer-value )
      151               and buf_chk-slip-head.db-num = int(oldbh:buffer-field( "db-num":U  ):buffer-value )
      152               and buf_chk-slip-head.is-report = int(oldbh:buffer-field( "is-report":U  ):buffer-value )
      153               and buf_chk-slip-head.slip-dt  = datetime(oldbh:buffer-field( "slip-dt":U  ):buffer-value ) no-error .
      154           sendOldRowid = rowid(buf_chk-slip-head) .
      155           for each bf_chk-slip-head no-lock where bf_chk-slip-head.obj-code = buf_chk-slip-head.obj-code and
      156               bf_chk-slip-head.db-num = buf_chk-slip-head.db-num and
      157               bf_chk-slip-head.is-report = buf_chk-slip-head.is-report and
      158               bf_chk-slip-head.slip-dt > buf_chk-slip-head.slip-dt:
      159               report-json = "" .
      160               report-txt = "" .
      161               for each bf_chk-slip-string no-lock
      162                   where bf_chk-slip-string.db-num = bf_chk-slip-head.db-num
      163                   and bf_chk-slip-string.CheckID = bf_chk-slip-head.CheckID
      164                   and bf_chk-slip-string.ID = bf_chk-slip-head.ID
      165                   and bf_chk-slip-string.RRN = bf_chk-slip-head.RRN
      166                   and bf_chk-slip-string.str-num < 10000
      167                   by bf_chk-slip-string.str-num on error
      168                   undo, return error return-value
      169                   :
      170                   report-txt = report-txt + chr(10) + bf_chk-slip-string.str-value .
      171               end.
      172               if report-txt <> "" then
      173               do:
      174                   copy-lob from report-txt to vMemptr-txt .
      175                   v-report-txt = base64-encode(vMemptr-txt) .
      176               end.
      177               for each bf_chk-slip-string no-lock
      178                   where bf_chk-slip-string.db-num = bf_chk-slip-head.db-num
      179                   and bf_chk-slip-string.CheckID = bf_chk-slip-head.CheckID
      180                   and bf_chk-slip-string.ID = bf_chk-slip-head.ID
      181                   and bf_chk-slip-string.RRN = bf_chk-slip-head.RRN
      182                   and bf_chk-slip-string.str-num > 10000
      183                   by bf_chk-slip-string.str-num on error
      184                   undo, return error return-value
      185                   :
      186                   report-json = report-json + chr(10) + bf_chk-slip-string.str-value .
      187               end.
      188               if report-json <> "" then
      189               do:
      190                   copy-lob from report-json to vMemptr-json .
      191                   v-report-json = base64-encode(vMemptr-json) .
      192               end.
      193               insw:start-element ("kass-report") .
      194               insw:write-data-element (  "id":U,   string(bf_chk-slip-head.ID)    ).
      195               insw:write-data-element (  "generation":U,   iso-date(bf_chk-slip-head.slip-dt) ).
      196               insw:write-data-element (  "shift-date":U, iso-date(bf_chk-slip-head.CashShiftDate) ) .
      197               insw:write-data-element (  "shift-number":U,   string(bf_chk-slip-head.CashShiftNum)    ).
      198               insw:write-data-element (  "kass-num":U,   string(bf_chk-slip-head.cash-num)    ).
      199               insw:write-data-element (  "type":U,   string(bf_chk-slip-head.kind)    ).
      200               insw:write-data-element (  "report-txt":U,  v-report-txt ).
      201               insw:write-data-element (  "report-json":U,  v-report-json ).
      202               insw:end-element ("kass-report") .
      203           end.
      204           finally:
      205               if Msg <> "" then
      206                   return error Msg.
      207           end finally.
      208       end method .
      209       method private character formatDateTime (iDateTime as datetime) :
      210           define variable vDateTime as character no-undo .
      211           if (iDateTime = ?) then vDateTime = "" .
      212           else
      213               vDateTime =  entry(1,iso-date(iDateTime),".")
      214                   .
      215           return vDateTime .
      216       end method .
      217       method private character formatDate (iDate as date) :
      218           return if (iDate = ?) then "" else iso-date(iDate) .
      219       end method .
      220       method private character getCreatorOrder (iUserId as character) :
      221           define variable vUserName as character no-undo.
      222           define buffer buf_user-account for ub.user-account .
      223           if iUserId <> '' then
      224           do:
      225               find first buf_user-account no-lock where
      226                   buf_user-account.user-id = iUserId no-error .
      227               if available (buf_user-account) then
      228                   vUserName = trim(buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name) .
      229           end.
      230           return vUserName.
      231       end method .
      232   end class.
