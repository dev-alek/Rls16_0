        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   class ibs.th.bge.1crn.subjects.promotion_schedule-line inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property day_      as character    no-undo get. private set.
       10     define property strt-time as character    no-undo get. private set.
       11     define property end-time  as character    no-undo get. private set.
       12     define override property InitTag as character no-undo init "schedule-line"
       13       get.
       14             method override protected void SetPropProtected (inTag as char, inValue as char):
       15       case inTag:
       16         when "day"       then day_      = if inValue >= "" then inValue else "" .
       17         when "strt-time" then strt-time = if inValue >= "" then inValue else "" .
       18         when "end-time"  then end-time  = if inValue >= "" then inValue else "" .
       19       end case.
       20       catch exProErrors as class Progress.Lang.ProError :
       21         case exProErrors:GetMessageNum(1):
       22           when 18207 then undo, throw new Progress.Lang.AppError(
       23             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       24           ) .
       25           otherwise undo, throw new Progress.Lang.AppError(
       26             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       27           ) .
       28         end case .
       29       end catch .
       30     end method.
       31     method override protected void CheckData ():
       32       def var v-str as char no-undo.
       33       assign
       34         v-str = ",day" when day_ = ?
       35         v-str = v-str + ",strt-time" when strt-time = ?
       36         v-str = v-str + ",end-time" when end-time = ?
       37       .
       38       v-str = substring(v-str, 2).
       39       if v-str > "" then undo, throw new Progress.Lang.AppError(
       40         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       41       ) .
       42     end method .
       43     method override protected void ClearSub():
       44       assign
       45         day_      = ?
       46         strt-time = ?
       47         end-time  = ?
       48       .
       49     end method .
       50   end class.
