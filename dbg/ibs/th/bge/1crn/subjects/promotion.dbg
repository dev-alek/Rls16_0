        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.isubject .
        3   using ibs.th.bge.1crn.subjects.subjects from propath.
        4   using ibs.th.ref.promo.enum-type-discount .
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.subjects.promotion inherits ibs.th.bge.1crn.subjects.asubject:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define property code_         as character    no-undo get. private set.
       13     define property del-l         as integer      no-undo get. private set.
       14     define property del-f         as integer      no-undo get. private set.
       15     define property name_         as character    no-undo get. private set.
       16     define property priority      as integer      no-undo get. private set.
       17     define property strt-date     as date         no-undo get. private set.
       18     define property end-date      as date         no-undo get. private set.
       19     define property earlyend-day  as date         no-undo get. private set.
       20     define property description_  as character    no-undo get. private set.
       21     define property comment       as character    no-undo get. private set.
       22     define property dscnt-type    as enum-type-discount no-undo get. private set.
       23     define property dscnt-value-type as integer   no-undo get. private set.
       24     define property threshold-type as integer     no-undo get. private set.
       25     define property pmnt-types    as character    no-undo get. private set.
       26     define property prohibition-charge-BL as integer no-undo get. private set.
       27     define property status_       as integer      no-undo get. private set.
       28     define property schedule     as ibs.th.bge.1crn.subjects.promotion_schedule no-undo
       29       get.
       30       private set.
       31     define property thresholds   as subjects no-undo
       32       get.
       33       private set.
       34     define property gds          as subjects no-undo
       35       get.
       36       private set.
       37     define property gds-addcond  as subjects no-undo
       38       get.
       39       private set.
       40     define property promoset     as ibs.th.bge.1crn.subjects.promotion_promoset no-undo
       41       get.
       42       private set.
       43     define property gifts        as subjects no-undo
       44       get.
       45       private set.
       46     define property payment-systems        as subjects no-undo
       47       get.
       48       private set.
       49     define override property InitTag as character no-undo init "promotion"
       50       get.
       51     constructor public promotion ():
       52       InitListTag = "shedule,thresholds,gds,gds-addcond,promoset,gifts,payment-systems".
       53     end constructor.
       54             method override protected void SetPropProtected (inTag as char, inValue as char):
       55       case inTag:
       56         when "code"         then code_        = if inValue >= "" then inValue else "" .
       57         when "del-l"        then del-l        = if inValue >= "" then integer (inValue) else 0 .
       58         when "del-f"        then del-f        = if inValue >= "" then integer (inValue) else 0 .
       59         when "name"         then name_        = if inValue >= "" then inValue else "" .
       60         when "priority"     then priority     = if inValue >= "" then integer (inValue) else 0 .
       61         when "strt-date"    then strt-date    = if inValue >= "" then date-mth (inValue) else ? .
       62         when "end-date"     then end-date     = if inValue >= "" then date-mth (inValue) else ? .
       63         when "earlyend-day" then earlyend-day = if inValue >= "" then date-mth (inValue) else ? .
       64         when "description"  then description_ = if inValue >= "" then inValue else "" .
       65         when "comment"      then comment      = if inValue >= "" then inValue else "" .
       66         when "dscnt-type"   then do:
       67           if inValue >= "" then dscnt-type = enum-type-discount:GetEnum( integer (inValue) ) .
       68                            else dscnt-type = enum-type-discount:ensolo .
       69         end .
       70         when "dscnt-value-type" then dscnt-value-type = if inValue >= "" then integer (inValue) else 0 .
       71         when "threshold-type"   then threshold-type   = if inValue >= "" then integer (inValue) else 0 .
       72         when "pmnt-types"       then pmnt-types       = if inValue >= "" then inValue else "" .
       73         when "prohibition-charge-BL" then prohibition-charge-BL = if inValue >= "" then integer (inValue) else 0 .
       74         // !! перечень статусов акции в 1с отличается от перечня статусов акции в TH !!
       75         when "status"           then status_          = if inValue >= "" then integer (inValue) else 0 .
       76       end case.
       77       catch exProErrors as class Progress.Lang.ProError :
       78         case exProErrors:GetMessageNum(1):
       79           when 18207 then undo, throw new Progress.Lang.AppError(
       80             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       81           ) .
       82           otherwise undo, throw new Progress.Lang.AppError(
       83             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       84           ) .
       85         end case .
       86       end catch .
       87     end method.
       88     method override protected void SetPropProtected (SubObj as isubject):
       89       case SubObj:InitTag:
       90         when "schedule" then
       91           schedule = cast (SubObj, ibs.th.bge.1crn.subjects.promotion_schedule) .
       92         when "promoset" then
       93           promoset = cast (SubObj, ibs.th.bge.1crn.subjects.promotion_promoset) .
       94       end case .
       95     end method.
       96     method override protected void SetPropProtected (SubsObj as subjects):
       97       case SubsObj:InitTag:
       98         when "thresholds"      then thresholds      = SubsObj.
       99         when "gds"             then gds             = SubsObj.
      100         when "gds-addcond"     then gds-addcond     = SubsObj.
      101         when "gifts"           then gifts           = SubsObj.
      102         when "payment-systems" then payment-systems = SubsObj.
      103       end case.
      104     end method.
      105     method override protected void CheckData ():
      106       def var v-str as char no-undo.
      107       assign
      108         v-str = ",code" when code_ = ?
      109         v-str = v-str + ",name" when name_ = ?
      110         v-str = v-str + ",priority" when priority = ?
      111         v-str = v-str + ",strt-date" when strt-date = ?
      112         v-str = v-str + ",end-date" when end-date = ?
      113         v-str = v-str + ",dscnt-type" when dscnt-type = ?
      114         v-str = v-str + ",dscnt-value-type" when dscnt-value-type = ?
      115         v-str = v-str + ",status" when status_ = ?
      116         // 13/VII-2018 - расписание в составе промо-акции сделано обязательным
      117         // 09/VIII-2018 - расписание в составе промо-акции сделано необязательным. Акция без расписания действует все дни всё время.
      118         // v-str = v-str + ",schedule" when not valid-object(schedule)
      119       .
      120       v-str = substring(v-str, 2).
      121       if v-str > "" then undo, throw new Progress.Lang.AppError(
      122         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      123       ) .
      124     end method.
      125     method override protected void ClearSub():
      126       assign
      127         code_        = ?
      128         del-l        = ?
      129         del-f        = ?
      130         name_        = ?
      131         priority     = ?
      132         strt-date    = ?
      133         end-date     = ?
      134         earlyend-day = ?
      135         description_ = ?
      136         comment      = ?
      137         dscnt-type   = ?
      138         dscnt-value-type = ?
      139         threshold-type = ?
      140         pmnt-types   = ?
      141         prohibition-charge-BL = ?
      142         status_      = ?
      143       .
      144       if valid-object(schedule)        then delete object schedule .
      145       if valid-object(thresholds)      then delete object thresholds .
      146       if valid-object(gds)             then delete object gds .
      147       if valid-object(gds-addcond)     then delete object gds-addcond .
      148       if valid-object(promoset)        then delete object promoset .
      149       if valid-object(gifts)           then delete object gifts .
      150       if valid-object(payment-systems) then delete object payment-systems .
      151     end method.
      152     method private date date-mth (inValue as character) : // возвращает дату из строки iso-date
      153       define variable v-date as date no-undo .
      154       assign
      155         inValue = entry (1, inValue, "T")
      156         v-date  = date (
      157           integer (entry (2, Invalue, "-")),
      158           integer (entry (3, Invalue, "-")),
      159           integer (entry (1, Invalue, "-"))
      160                        )
      161       .
      162       return v-date.
      163     end method.
      164   end class.
