        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.export.send1cerpsub.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.exp-techlosses inherits send1cerpsub:
        5     define override public property InitSecTag as character no-undo init "techlosses"
        6     get.
        7     define override public property sendTableName as character no-undo init "trn-doc"
        8     get.
        9     define override public property vss-archive as character no-undo
       10     get.
       11     define override public property vss-author as character no-undo
       12     get.
       13     define override public property vss-date as character no-undo
       14     get.
       15     define override public property vss-description as character no-undo
       16     get.
       17     define override public property vss-revision as character no-undo
       18     get.
       19     define override public property vss-workfile as character no-undo
       20     get.
       21     constructor public exp-techlosses (  ):
       22       super ().
       23     end constructor.
       24     method override public void CheckParam(  ):
       25         if not valid-handle (oldbh)
       26         then
       27            return error "Не передан старый буфер".
       28         if oldbh:table ne "trn-doc"
       29         then
       30            return error "Старый буфер не trn-doc: " + oldbh:table.
       31         return.
       32     end method.
       33     method override public void CrContentToSW( input hSaxWriter as handle ):
       34      define buffer buf_trn-doc for ub.trn-doc .
       35      define buffer buf_doc-line for ub.doc-line .
       36      define buffer buf_doc-line-attr for ub.doc-line-attr .
       37      define variable blowdown as decimal no-undo format "->>9.99".
       38      define variable fittings as decimal no-undo format "->>9.99".
       39      define variable emptying as decimal no-undo format "->>9.99".
       40      define variable refund as decimal no-undo format "->>9.99" init ?.
       41      define variable ctrlvalve as decimal no-undo format "->>9.99".
       42      find first buf_trn-doc no-lock where buf_trn-doc.doc-code = string(oldbh:buffer-field ("doc-code":U):buffer-value) no-error .
       43      if available buf_trn-doc
       44      then do:
       45        sendOldRowid = rowid(buf_trn-doc).
       46        for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code:
       47         find first ub.goods no-lock where ub.goods.artic = buf_doc-line.artic and
       48         ub.goods.prod-code = buf_doc-line.prod-code and
       49         ub.goods.prod-type = buf_doc-line.prod-type no-error .
       50         if available (ub.goods) then do:
       51         find first buf_doc-line-attr no-lock where buf_doc-line-attr.attr-code = "blowdown" and
       52         buf_doc-line-attr.doc-code = buf_doc-line.doc-code and
       53         buf_doc-line-attr.gds-code = ub.goods.gds-code no-error .
       54         if available (buf_doc-line-attr) then if buf_doc-line-attr.attr-value = ? then blowdown = 0 .
       55         else blowdown = decimal(buf_doc-line-attr.attr-value) .
       56         find first buf_doc-line-attr no-lock where buf_doc-line-attr.attr-code = "fittings" and
       57         buf_doc-line-attr.doc-code = buf_doc-line.doc-code and
       58         buf_doc-line-attr.gds-code = ub.goods.gds-code no-error .
       59         if available (buf_doc-line-attr) then if buf_doc-line-attr.attr-value = ? then fittings = 0 .
       60         else fittings = decimal(buf_doc-line-attr.attr-value) .
       61               find first buf_doc-line-attr no-lock where buf_doc-line-attr.attr-code = "emptying" and
       62         buf_doc-line-attr.doc-code = buf_doc-line.doc-code and
       63         buf_doc-line-attr.gds-code = ub.goods.gds-code no-error .
       64         if available (buf_doc-line-attr) then if buf_doc-line-attr.attr-value = ? then emptying = 0 .
       65         else emptying = decimal(buf_doc-line-attr.attr-value) .
       66               find first buf_doc-line-attr no-lock where buf_doc-line-attr.attr-code = "refund" and
       67         buf_doc-line-attr.doc-code = buf_doc-line.doc-code and
       68         buf_doc-line-attr.gds-code = ub.goods.gds-code no-error .
       69         if available (buf_doc-line-attr) then refund = decimal(buf_doc-line-attr.attr-value) .
       70               find first buf_doc-line-attr no-lock where buf_doc-line-attr.attr-code = "ctrlvalve" and
       71         buf_doc-line-attr.doc-code = buf_doc-line.doc-code and
       72         buf_doc-line-attr.gds-code = ub.goods.gds-code no-error .
       73         if available (buf_doc-line-attr) then if buf_doc-line-attr.attr-value = ? then ctrlvalve = 0 .
       74         else ctrlvalve = decimal(buf_doc-line-attr.attr-value) .
       75         hSaxWriter:start-element ("techlosse") .
       76         hSaxWriter:write-data-element (  "out-code":U,     buf_trn-doc.doc-code   ).
       77         hSaxWriter:write-data-element (  "tl-blowdown":U,left-trim(string(blowdown,"->>>>>>>>9.999"))).
       78         hSaxWriter:write-data-element (  "tl-fittings":U,left-trim (string(fittings,"->>>>>>>>9.999"))).
       79         hSaxWriter:write-data-element (  "tl-emptying":U,left-trim (string(emptying,"->>>>>>>>9.999"))).
       80         if refund <> ? then hSaxWriter:write-data-element (  "tl-refund":U,left-trim (string(refund,"->>>>>>>>9.999"))).
       81         hSaxWriter:write-data-element (  "tl-ctrlvalve":U,left-trim (string(ctrlvalve,"->>>>>>>>9.999"))).
       82         hSaxWriter:end-element ("techlosse") .
       83   end.
       84      end.
       85   end.
       86     end method.
       87     destructor public exp-techlosses ( ):
       88     end destructor.
       89   end class.
