        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.int-point inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_ as character no-undo
       10       get.
       11       private set.
       12     define property azk-code as character no-undo
       13       get.
       14       private set.
       15     define override property InitTag as character no-undo init "int-point"
       16       get.
       17     method override protected void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "code" then do:
       20           assign code_ = inValue.
       21         end.
       22         when "azk-code" then do:
       23           assign azk-code = inValue.
       24         end.
       25       end case.
       26     end.
       27     method override protected void CheckData ():
       28       def var v-str as char no-undo.
       29       assign
       30         v-str = "code" when code_ = ?
       31       .
       32       v-str = trim (v-str, ",").
       33       if v-str > ''
       34       then
       35         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       36     end.
       37     method override protected void ClearSub():
       38       assign
       39         code_     = ?
       40         azk-code  = ?
       41       .
       42     end.
       43   end class.
