        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.payment-agent inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property code_         as character    no-undo get. private set.
        9     define property name_         as character    no-undo get. private set.
       10     define property adr-trans-op    as character    no-undo get. private set.
       11     define property inn-trans-op    as character    no-undo get. private set.
       12     define property name-trans-op   as character    no-undo get. private set.
       13     define property oper-pa         as character    no-undo get. private set.
       14     define property sign-pa         as integer      no-undo get. private set.
       15     define property tel-pa          as character    no-undo get. private set.
       16     define property tel-acceptor    as character    no-undo get. private set.
       17     define property tel-trans-op    as character    no-undo get. private set.
       18     define property sign-pa-subj    as integer      no-undo get. private set.
       19     define property name-prov       as character    no-undo get. private set.
       20     define property inn-prov        as character    no-undo get. private set.
       21     define property tel-prov        as character    no-undo get. private set.
       22     define property type-calc-repl  as integer      no-undo get. private set.
       23     define property min-sum         as decimal      no-undo get. private set.
       24     define property max-sum         as decimal      no-undo get. private set.
       25     define property warning-sum     as decimal      no-undo get. private set.
       26     define property comm-entry-type as integer      no-undo get. private set.
       27     define property value-comm      as decimal      no-undo get. private set.
       28     define property gds-comm        as integer      no-undo get. private set.
       29     define property auth-req        as integer      no-undo get. private set.
       30     define property prt-slp-req     as integer      no-undo get. private set.
       31     define property name-slp        as character    no-undo get. private set.
       32     define property max-num         as integer      no-undo get. private set.
       33     define property min-num         as integer      no-undo get. private set.
       34     define property oper-type       as integer      no-undo get. private set.
       35     define property del-l         as integer      no-undo get. private set.
       36     define property del-f         as integer      no-undo get. private set.
       37     define property kb-gds            as ibs.th.bge.1crn.subjects.subjects no-undo
       38       get.
       39       private set.
       40     define override property InitTag as character no-undo init "payment-agent"
       41       get.
       42     constructor public payment-agent ():
       43       InitListTag = "kb-gds".
       44     end constructor.
       45             method override protected void SetPropProtected (inTag as char, inValue as char):
       46       case inTag:
       47         when "code"         then code_        = if inValue >= "" then inValue else "" .
       48         when "del-l"        then del-l        = if inValue >= "" then integer (inValue) else 0 .
       49         when "del-f"        then del-f        = if inValue >= "" then integer (inValue) else 0 .
       50         when "name"         then name_        = if inValue >= "" then inValue else "" .
       51         when "adr-trans-op"    then adr-trans-op    = if inValue >= "" then inValue else "" .
       52         when "inn-trans-op"    then inn-trans-op    = if inValue >= "" then inValue else "" .
       53         when "name-trans-op"   then name-trans-op   = if inValue >= "" then inValue else "" .
       54         when "oper-pa"         then oper-pa         = if inValue >= "" then inValue else "" .
       55         when "sign-pa"         then sign-pa         = if inValue >= "" then integer (inValue) else 0 .
       56         when "tel-pa"          then tel-pa          = if inValue >= "" then inValue else "" .
       57         when "tel-acceptor"    then tel-acceptor    = if inValue >= "" then inValue else "" .
       58         when "tel-trans-op"    then tel-trans-op    = if inValue >= "" then inValue else "" .
       59         when "sign-pa-subj"    then sign-pa-subj    = if inValue >= "" then integer (inValue) else 0 .
       60         when "name-prov"       then name-prov       = if inValue >= "" then inValue else "" .
       61         when "inn-prov"        then inn-prov        = if inValue >= "" then inValue else "" .
       62         when "tel-prov"        then tel-prov        = if inValue >= "" then inValue else "" .
       63         when "type-calc-repl"  then type-calc-repl  = if inValue >= "" then integer (inValue) else 0 .
       64         when "min-sum"         then min-sum         = if inValue >= "" then decimal (inValue) else 0.0 .
       65         when "max-sum"         then max-sum         = if inValue >= "" then decimal (inValue) else 0.0 .
       66         when "warning-sum"     then warning-sum     = if inValue >= "" then decimal (inValue) else 0.0 .
       67         when "comm-entry-type" then comm-entry-type = if inValue >= "" then integer (inValue) else 0 .
       68         when "value-comm"      then value-comm      = if inValue >= "" then decimal (inValue) else 0.0 .
       69         when "gds-comm"        then gds-comm        = if inValue >= "" then integer (inValue) else 0 .
       70         when "auth-req"        then auth-req        = if inValue >= "" then integer (inValue) else 0 .
       71         when "prt-slp-req"     then prt-slp-req     = if inValue >= "" then integer (inValue) else 0 .
       72         when "name-slp"        then name-slp        = if inValue >= "" then inValue else "" .
       73         when "max-num"         then max-num         = if inValue >= "" then integer (inValue) else 0 .
       74         when "min-num"         then min-num         = if inValue >= "" then integer (inValue) else 0 .
       75         when "oper-type"       then oper-type       = if inValue >= "" then integer (inValue) else 0 .
       76       end case.
       77       catch exProErrors as class Progress.Lang.ProError :
       78         case exProErrors:GetMessageNum(1):
       79           when 18207 then undo, throw new Progress.Lang.AppError(
       80             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       81           ) .
       82           otherwise undo, throw new Progress.Lang.AppError(
       83             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       84           ) .
       85         end case .
       86       end catch .
       87     end method.
       88     method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
       89       case SubsObj:InitTag:
       90         when "kb-gds"   then kb-gds   = SubsObj.
       91       end case.
       92     end method.
       93     method override protected void CheckData ():
       94       def var v-str as char no-undo.
       95       assign
       96         v-str =         ",code"           when code_          = ?
       97         v-str = v-str + ",name"           when name_          = ?
       98         v-str = v-str + ",adr-trans-op"   when adr-trans-op   = ? and type-calc-repl ne 1
       99         v-str = v-str + ",inn-trans-op"   when inn-trans-op   = ? and type-calc-repl ne 1
      100         v-str = v-str + ",name-trans-op"  when name-trans-op  = ? and type-calc-repl ne 1
      101         v-str = v-str + ",oper-pa"        when oper-pa        = ? and type-calc-repl ne 1
      102         v-str = v-str + ",sign-pa"        when sign-pa        = ?
      103         v-str = v-str + ",sign-pa-subj"   when sign-pa-subj   = ?
      104         v-str = v-str + ",type-calc-repl" when type-calc-repl = ?
      105         v-str = v-str + ",max-sum"        when max-sum        = ?
      106       .
      107       v-str = substring(v-str, 2).
      108       if v-str > "" then undo, throw new Progress.Lang.AppError(
      109         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
      110       ) .
      111     end method.
      112     method override protected void ClearSub():
      113       assign
      114         code_           = ?
      115         del-l = ?
      116         del-f = ?
      117         name_           = ?
      118         adr-trans-op    = ?
      119         inn-trans-op    = ?
      120         name-trans-op   = ?
      121         oper-pa         = ?
      122         sign-pa         = ?
      123         tel-pa          = ?
      124         tel-acceptor    = ?
      125         tel-trans-op    = ?
      126         sign-pa-subj    = ?
      127         name-prov       = ?
      128         inn-prov        = ?
      129         tel-prov        = ?
      130         type-calc-repl  = ?
      131         min-sum         = ?
      132         max-sum         = ?
      133         warning-sum     = ?
      134         comm-entry-type = ?
      135         value-comm      = ?
      136         gds-comm        = ?
      137         auth-req        = ?
      138         prt-slp-req     = ?
      139         name-slp        = ?
      140         max-num         = ?
      141         min-num         = ?
      142         oper-type       = ?
      143       .
      144       if valid-object(kb-gds)        then delete object kb-gds .
      145     end method.
      146   end class.
