        1   USING Progress.Lang.*.
        2   block-level on error undo, throw.
        3   CLASS ibs.th.bge.1crn.subjects.cashiers inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_       as character    no-undo get. private set.
       10     define property del-l       as integer      no-undo get. private set.
       11     define property del-f       as integer      no-undo get. private set.
       12     define property name_       as character    no-undo get. private set.
       13     define property role-code   as integer      no-undo get. private set.
       14     define override property InitTag as character no-undo init "cashier"
       15       get.
       16     method override protected void SetPropProtected (inTag as char, inValue as char):
       17       case inTag:
       18         when "code" then do:
       19           assign code_ = inValue .
       20         end.
       21         when "del-l" then do:
       22           assign del-l = integer (inValue).
       23         end.
       24         when "del-f" then do:
       25           assign del-f = integer (inValue).
       26         end.
       27         when "name" then do:
       28           assign name_ = inValue .
       29         end.
       30         when "role-code" then do:
       31           assign role-code = integer(inValue) .
       32         end.
       33       end case.
       34     end.
       35   method override protected void CheckData ():
       36       def var v-str as char no-undo.
       37       assign
       38         v-str = "code" when code_ = ?
       39         v-str = v-str + ",name" when name_ = ?
       40       .
       41       v-str = trim (v-str, ",").
       42       if v-str > ''
       43       then
       44         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       45     end.
       46     method override protected void ClearSub():
       47       assign
       48         code_     = ?
       49         del-l     = ?
       50         del-f     = ?
       51         name_     = ?
       52         role-code = ?
       53       .
       54     end.
       55   END CLASS.
