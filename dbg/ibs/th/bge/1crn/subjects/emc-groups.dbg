        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.emc-groups inherits ibs.th.bge.1crn.subjects.code:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define override property InitTag as character no-undo init "emc-group"
       10     get.
       11             define var emctype-code as integer no-undo.
       12     define var emctype-name as char    no-undo.
       13     method override protected void SetPropProtected (inTag as char, inValue as char):
       14       super:SetPropProtected(inTag, inValue).
       15       case inTag:
       16         when "emctype-code" then do:
       17           assign emctype-code = if inValue >= "" then integer (inValue) else 0
       18                  code_   = string(emctype-code,"999")
       19                  old_code_ = code_
       20                  parent_ = "EMC"
       21                  old_parent_  = parent_
       22                  CodeValue = string(emctype-code,"999")
       23                  .
       24         end.
       25         when "emctype-name" then do:
       26           assign
       27           emctype-name = if inValue >= "" then inValue else ""
       28           codeName = emctype-name
       29           .
       30         end.
       31         when "del-l" then do:
       32            assign del-l = if inValue >= "" then integer (inValue) else 0
       33            .
       34            if del-l = 1 then  codeName = emctype-name + " (удален)" .
       35         end.
       36       end case.
       37     end method.
       38     method override protected void CheckData ():
       39       def var v-str as char no-undo.
       40       define buffer code for ub.Code.
       41       assign
       42         v-str = "emctype-code" when emctype-code = ?
       43         v-str = v-str + ", emctype-name" when emctype-name = ""
       44       .
       45       v-str = trim (v-str, ",").
       46       if v-str > ''
       47       then
       48         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       49     end method.
       50   end class.
