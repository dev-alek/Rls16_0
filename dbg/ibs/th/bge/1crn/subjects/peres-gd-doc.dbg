        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.str.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.peres-gd-doc implements iexpsubject:
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7     define temp-table bf_trn-doc like ub.trn-doc.
        8     define buffer bf_doc-line        for ub.doc-line.
        9     define buffer bf_goods           for ub.goods.
       10     define buffer bf-plus_doc-line   for ub.doc-line.
       11     define buffer bf-plus_goods      for ub.goods.
       12     define buffer bf_parts           for ub.parts.
       13     define buffer bf-plus_parts      for ub.parts.
       14     define buffer bf_parts-root      for ub.parts-root.
       15     define temp-table tt-doc-line-cashe no-undo
       16     field doc-code  like ub.doc-line.doc-code
       17     field artic     like ub.doc-line.artic
       18     field prod-type like ub.doc-line.prod-type
       19     field prod-code like ub.doc-line.prod-code
       20     field qnty      as   decimal
       21     field sum-rubl  as   decimal
       22     field sum-base  as   decimal
       23     field vat-rubl  as   decimal
       24     field vat-base  as   decimal
       25     index pi is unique primary doc-code artic prod-type prod-code.
       26     define temp-table tt-doc-line-cashe-plus no-undo
       27     field doc-code     like ub.doc-line.doc-code
       28     field wf-artic     like ub.doc-line.artic
       29     field wf-prod-type like ub.doc-line.prod-type
       30     field wf-prod-code like ub.doc-line.prod-code
       31     field artic     like ub.doc-line.artic
       32     field prod-type like ub.doc-line.prod-type
       33     field prod-code like ub.doc-line.prod-code
       34     field qnty               as decimal
       35     field sum-rubl           as decimal
       36     field sum-base           as decimal
       37     field vat-rubl           as decimal
       38     field vat-base           as decimal
       39     field write-off-qnty     as decimal
       40     field write-off-sum-rubl as decimal
       41     field write-off-sum-base as decimal
       42     index pi is unique primary doc-code wf-artic wf-prod-type wf-prod-code artic prod-type prod-code.
       43     define temp-table tt-clcparts no-undo like ub.parts
       44     field part-cur-base like ub.gds-dtl.price-base
       45     field part-cur-road-tax like ub.gds-dtl.price-base
       46     field part-cur-excise like ub.gds-dtl.price-base
       47     .
       48   define temp-table tt-allsum no-undo
       49   field sum-type           as   character
       50   field fact-qnty             as decimal
       51   field cli-qnty              as decimal
       52   field sum-dsc-base-doc      as decimal
       53   field sum-dsc-rubl-doc      as decimal
       54   field dsc-base-doc          as decimal
       55   field dsc-rubl-doc          as decimal
       56   field vat-base-doc          as decimal
       57   field vat-rubl-doc          as decimal
       58   field vat-base-buyer-doc    as decimal
       59   field vat-rubl-buyer-doc    as decimal
       60   field slt-base-doc          as decimal
       61   field slt-rubl-doc          as decimal
       62   field road-tax-base-doc     as decimal
       63   field road-tax-rubl-doc     as decimal
       64   field excise-base-doc       as decimal
       65   field excise-rubl-doc       as decimal
       66   field sum-dsc-base-acc      as decimal
       67   field sum-dsc-rubl-acc      as decimal
       68   field sum-dsc-cli-acc       as decimal
       69   field dsc-base-acc          as decimal
       70   field dsc-rubl-acc          as decimal
       71   field dsc-cli-acc           as decimal
       72   field vat-base-acc          as decimal
       73   field vat-rubl-acc          as decimal
       74   field vat-cli-acc           as decimal
       75   field slt-base-acc          as decimal
       76   field slt-rubl-acc          as decimal
       77   field slt-cli-acc           as decimal
       78   field road-tax-base-acc     as decimal
       79   field road-tax-rubl-acc     as decimal
       80   field road-tax-cli-acc      as decimal
       81   field excise-base-acc       as decimal
       82   field excise-rubl-acc       as decimal
       83   field excise-cli-acc        as decimal
       84   field transport-base-acc    as decimal
       85   field transport-rubl-acc    as decimal
       86   field transport-cli-acc     as decimal
       87   field other-base-acc        as decimal
       88   field other-rubl-acc        as decimal
       89   field other-cli-acc         as decimal
       90   field sum-dsc-base-cur      as decimal
       91   field sum-dsc-rubl-cur      as decimal
       92   field dsc-base-cur          as decimal
       93   field dsc-rubl-cur          as decimal
       94   field vat-base-cur          as decimal
       95   field vat-rubl-cur          as decimal
       96   field vat-base-buyer-cur    as decimal
       97   field vat-rubl-buyer-cur    as decimal
       98   field slt-base-cur          as decimal
       99   field slt-rubl-cur          as decimal
      100   field road-tax-base-cur     as decimal
      101   field road-tax-rubl-cur     as decimal
      102   field excise-base-cur       as decimal
      103   field excise-rubl-cur       as decimal
      104   index sum-type is primary unique sum-type.
      105     define property Msg as character no-undo
      106       get:
      107         return trim (Msg, chr(10)).
      108       end.
      109       private set (inArg as char):
      110         Msg = Msg + chr(10) + inArg.
      111       end.
      112     define property InitSecTag as character no-undo init "peres-gd-docs"
      113       get.
      114     define property BufTableHndlNew as handle no-undo
      115       get.
      116       set.
      117     define property BufTableHndlOld as handle no-undo
      118       get.
      119       set.
      120     define public property sendTableName as character no-undo init "trn-doc"
      121       get.
      122     define public property sendOldRowid as rowid  no-undo
      123       get.
      124       set.
      125     define public property sendNewRowid as rowid  no-undo
      126       get.
      127       set.
      128     define variable sw               as handle    no-undo.
      129     define variable isDel            as logical   no-undo.
      130     define variable varinvclcwt      as logical   no-undo.
      131     define variable varinvclcas      as logical   no-undo.
      132     define variable varinvclcex      as logical   no-undo.
      133     define variable varinvclcms      as logical   no-undo.
      134     define variable varinvclcbef     as logical   no-undo.
      135     define variable prtvalue         as character no-undo.
      136     define variable varinvclcspvalue as character no-undo.
      137     define variable varr-b           as character no-undo.
      138     define variable is-cdinv         as character no-undo .
      139     define variable clcprtsl-hndl    as handle    no-undo .
      140     define variable v-bufhnd         as handle    no-undo.
      141     method public void CrContentToSW (insw as handle):
      142       sw = insw.
      143       create bf_trn-doc.
      144       v-bufhnd = buffer bf_trn-doc:handle.
      145       if valid-handle (BufTableHndlNew)
      146       then do:
      147         sendNewRowid  = BufTableHndlNew:rowid.
      148         v-bufhnd:buffer-copy (BufTableHndlNew) no-error.
      149         if error-status:error
      150         then do:
      151           Msg = "Ошибка выгрузки peres-gd-doc, неверный буфер BufTableHndlNew".
      152           undo, return error Msg.
      153         end.
      154         isDel = false.
      155       end.
      156       else do:
      157         if not valid-handle (BufTableHndlOld)
      158         then do:
      159           Msg = "Ошибка выгрузки peres-gd-doc, неопеределен ни старый ни новый буфер".
      160           undo, return error Msg.
      161         end.
      162         sendOldRowid  = BufTableHndlOld:rowid.
      163         v-bufhnd:buffer-copy (BufTableHndlOld) no-error.
      164         if error-status:error
      165         then do:
      166           Msg = "Ошибка выгрузки peres-gd-doc, неверный буфер BufTableHndlOld".
      167           undo, return error Msg.
      168         end.
      169         isDel = true.
      170       end.
      171       run str/clcprtsl.p persistent (output clcprtsl-hndl).
      172       StartDocInv().
      173       GdsLine().
      174       EndDocInv().
      175       delete procedure clcprtsl-hndl.
      176     end.
      177     method private void GdsLine ():
      178       sw:start-element ("gds").
      179       for each bf_doc-line
      180         where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock,
      181         first bf_goods where bf_goods.artic = bf_doc-line.artic
      182         and bf_goods.prod-type = bf_doc-line.prod-type
      183         and bf_goods.prod-code = bf_doc-line.prod-code no-lock,
      184         first bf_parts where bf_parts.out-code  = bf_doc-line.doc-code
      185         and bf_parts.obj-type  = bf_doc-line.obj-type
      186         and bf_parts.obj-code  = bf_doc-line.obj-code
      187         and bf_parts.artic = bf_doc-line.artic
      188         and bf_parts.prod-type = bf_doc-line.prod-type
      189         and bf_parts.prod-code = bf_doc-line.prod-code
      190         and bf_parts.fact-qnty < 0 no-lock:
      191         for each bf-plus_doc-line
      192           where bf-plus_doc-line.doc-code = bf_trn-doc.doc-code no-lock,
      193           first bf-plus_goods where bf-plus_goods.artic = bf-plus_doc-line.artic
      194           and bf-plus_goods.prod-type = bf-plus_doc-line.prod-type
      195           and bf-plus_goods.prod-code = bf-plus_doc-line.prod-code no-lock,
      196           first bf_parts-root where bf_parts-root.doc-code = bf-plus_doc-line.doc-code
      197           and bf_parts-root.gds-code = bf-plus_goods.gds-code
      198           and bf_parts-root.orig-gds-code = bf_goods.gds-code no-lock:
      199           sw:start-element ("gd").
      200             write-data-element ("gd-code-from", string-mth (bf_goods.gds-code)).
      201             write-data-element ("gd-code-to", string-mth (bf-plus_goods.gds-code)).
      202             write-data-element ("qnty", string-mth ( round (get-income-qnty(buffer bf_doc-line, buffer bf-plus_doc-line), 3) )).
      203             write-data-element ("sum-from", string-mth (round (get-write-off-sum-rubl (buffer bf_doc-line), 3))).
      204             write-data-element ("sum-to", string-mth (round (get-income-sum-rbl (buffer bf_doc-line, buffer bf-plus_doc-line ), 3))).
      205             write-data-element ("sum-from-s", string-mth (round (absolut (bf_parts.fact-qnty * bf_parts.price-base / (1 + (bf_parts.VAT-pc / 100))), 3))).
      206           sw:end-element ("gd").
      207         end.
      208       end.
      209       sw:end-element ("gds").
      210     end.
      211     method private void StartDocInv ():
      212           find first c-trn-doc where c-trn-doc.doc-code = bf_trn-doc.doc-code NO-LOCK NO-ERROR.
      213           sw:start-element ("peres-gd-doc") .
      214           write-data-element ("doc-code", bf_trn-doc.doc-code).
      215           write-data-element ("doc-num", bf_trn-doc.doc-code).
      216           write-data-element ("del-f", string (isDel, "1/0") ).
      217                   write-data-element ("doc-date", if bf_trn-doc.doc-date = ? then "" else substitute("&1T&2", iso-date(date(c-trn-doc.doc-date)),string(c-trn-doc.sys-time) ) ).
      218           write-data-element ("fact-date", if bf_trn-doc.fact-date = ? then "" else iso-date (date (bf_trn-doc.fact-date))).
      219           write-data-element ("shift-date", if bf_trn-doc.shift-date = ? then "" else iso-date (date (bf_trn-doc.shift-date))).
      220           write-data-element ("shift-num", if bf_trn-doc.shift-num = ? then "0" else string-mth (bf_trn-doc.shift-num)).
      221     end.
      222     method private void EndDocInv ():
      223       sw:end-element ("peres-gd-doc") .
      224     end.
      225     method private void write-data-element (inTag as char, inValue as char):
      226       if inValue = ?
      227       then do:
      228         Msg = substitute ('Предупреждение отладки: тег &1 иммет неопределнное значение. Работа будет продолжена...', inTag).
      229       end.
      230       if inTag = ?
      231       then do:
      232         Msg = substitute ('Предупреждение отладки: Имя тега не может быть пустым...').
      233         return.
      234       end.
      235       inTag = lc (InTag).
      236       if inValue = ?
      237         then sw:write-empty-element (inTag).
      238         else sw:write-data-element (inTag, inValue).
      239     end.
      240     method private character string-mth (inValue as integer):
      241       def var v-str as character no-undo.
      242       if inValue = ?
      243         then v-str = "0".
      244         else v-str = string (inValue).
      245       return v-str.
      246     end.
      247     method private character string-mth (inValue as decimal):
      248       def var v-str as character no-undo.
      249       if inValue = ?
      250         then v-str = "0".
      251       if string (inValue) begins "."
      252         then v-str = "0" + string (inValue).
      253         else v-str = string (inValue).
      254       return v-str.
      255     end.
      256     method private decimal get-write-off-sum-rubl ( buffer local-doc-line for ub.doc-line ) :
      257         find first tt-doc-line-cashe where tt-doc-line-cashe.doc-code  = local-doc-line.doc-code  and
      258                                            tt-doc-line-cashe.artic     = local-doc-line.artic     and
      259                                            tt-doc-line-cashe.prod-type = local-doc-line.prod-type and
      260                                            tt-doc-line-cashe.prod-code = local-doc-line.prod-code no-error.
      261         if not available tt-doc-line-cashe then do:
      262           proc-get-write-off (BUFFER local-doc-line).
      263           find first tt-doc-line-cashe where tt-doc-line-cashe.doc-code  = local-doc-line.doc-code  and
      264                                              tt-doc-line-cashe.artic     = local-doc-line.artic     and
      265                                              tt-doc-line-cashe.prod-type = local-doc-line.prod-type and
      266                                              tt-doc-line-cashe.prod-code = local-doc-line.prod-code .
      267         end.
      268         return tt-doc-line-cashe.sum-rubl.
      269     end.
      270     method private decimal get-income-sum-rbl ( BUFFER local-doc-line for ub.doc-line, BUFFER local-doc-line-plus for ub.doc-line  ) :
      271        find first tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       and
      272                                                tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          and
      273                                                tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      and
      274                                                tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
      275                                                tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     and
      276                                                tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type and
      277                                                tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code no-error.
      278        if not available tt-doc-line-cashe-plus then do:
      279          proc-get-write-off (BUFFER local-doc-line).
      280          find first tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       and
      281                                                  tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          and
      282                                                  tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      and
      283                                                  tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
      284                                                  tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     and
      285                                                  tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type and
      286                                                  tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code .
      287        end.
      288        return tt-doc-line-cashe-plus.sum-rubl.
      289     end.
      290     method private void proc-get-write-off ( buffer bf-loc_doc-line for ub.doc-line ) :
      291       define buffer bf-loc-plus_doc-line for ub.doc-line.
      292       define buffer bf-loc_parts         for ub.parts.
      293       define buffer bf-loc_parts-root    for ub.parts-root.
      294       define buffer bf-loc-plus_parts    for ub.parts.
      295       define buffer bf-loc_goods         for ub.goods.
      296       define buffer bf-loc-plus_goods    for ub.goods.
      297       define variable varprice-rubl-parts as decimal no-undo.
      298       define variable varprice-base-parts as decimal no-undo.
      299       find first bf-loc_goods where bf-loc_goods.artic     = bf-loc_doc-line.artic     and
      300                                     bf-loc_goods.prod-type = bf-loc_doc-line.prod-type and
      301                                     bf-loc_goods.prod-code = bf-loc_doc-line.prod-code no-lock.
      302       find first tt-doc-line-cashe where tt-doc-line-cashe.doc-code  = bf-loc_doc-line.doc-code  and
      303                                          tt-doc-line-cashe.artic     = bf-loc_doc-line.artic     and
      304                                          tt-doc-line-cashe.prod-type = bf-loc_doc-line.prod-type and
      305                                          tt-doc-line-cashe.prod-code = bf-loc_doc-line.prod-code no-error.
      306       if not available tt-doc-line-cashe then do:
      307         create tt-doc-line-cashe.
      308         assign
      309           tt-doc-line-cashe.doc-code  = bf-loc_doc-line.doc-code
      310           tt-doc-line-cashe.artic     = bf-loc_doc-line.artic
      311           tt-doc-line-cashe.prod-type = bf-loc_doc-line.prod-type
      312           tt-doc-line-cashe.prod-code = bf-loc_doc-line.prod-code .
      313       end.
      314       else do:
      315         assign
      316           tt-doc-line-cashe.qnty     = 0.00
      317           tt-doc-line-cashe.sum-rubl = 0.00
      318           tt-doc-line-cashe.sum-base = 0.00
      319           tt-doc-line-cashe.vat-rubl = 0.00
      320           tt-doc-line-cashe.vat-base = 0.00.
      321         for each tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code  and
      322                                               tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic     and
      323                                               tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type and
      324                                               tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code :
      325           delete tt-doc-line-cashe-plus.
      326         end.
      327       end.
      328       for each bf-loc_parts where bf-loc_parts.out-code  = bf-loc_doc-line.doc-code  and
      329                                   bf-loc_parts.obj-type  = bf-loc_doc-line.obj-type  and
      330                                   bf-loc_parts.obj-code  = bf-loc_doc-line.obj-code  and
      331                                   bf-loc_parts.artic     = bf-loc_doc-line.artic     and
      332                                   bf-loc_parts.prod-type = bf-loc_doc-line.prod-type and
      333                                   bf-loc_parts.prod-code = bf-loc_doc-line.prod-code and
      334                                   bf-loc_parts.fact-qnty < 0 no-lock :
      335         for each tt-clcparts :
      336           delete tt-clcparts.
      337         end.
      338         create tt-clcparts.
      339         buffer-copy bf-loc_parts to tt-clcparts.
      340         run clcprtsl_calc-parts-inkaps in clcprtsl-hndl (
      341                                         input-output table tt-clcparts
      342                                       , input-output table tt-allsum
      343                                       , input yes
      344                                       , input no
      345                                       , input bf-loc_doc-line.road-tax
      346                                       , input bf-loc_doc-line.excise
      347                                       , input bf-loc_doc-line.VAT-pc
      348                                       , input bf-loc_doc-line.cons-vat-pc
      349                                       , input bf-loc_doc-line.SLT-pc
      350                                       , input bf_trn-doc.base-rate
      351                                       , input bf_trn-doc.base-scale
      352                                       , input "":U
      353                                       , input 0.0
      354                                       , input 0.0
      355                                       , input 0.0
      356                                       , input 0.0
      357                                       , input 0.0
      358                                       , input 0.0
      359                                   ).
      360         find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error.
      361         if available tt-allsum then do:
      362           assign
      363             tt-doc-line-cashe.qnty     = tt-doc-line-cashe.qnty     - tt-allsum.fact-qnty
      364             tt-doc-line-cashe.sum-rubl = tt-doc-line-cashe.sum-rubl - tt-allsum.sum-dsc-rubl-doc
      365             tt-doc-line-cashe.sum-base = tt-doc-line-cashe.sum-base - tt-allsum.sum-dsc-base-doc
      366             tt-doc-line-cashe.vat-rubl = tt-doc-line-cashe.vat-rubl - tt-allsum.vat-rubl-doc
      367             tt-doc-line-cashe.vat-base = tt-doc-line-cashe.vat-base - tt-allsum.vat-base-doc.
      368           assign
      369             varprice-rubl-parts = tt-allsum.sum-dsc-rubl-doc / tt-allsum.fact-qnty
      370             varprice-base-parts = tt-allsum.sum-dsc-base-doc / tt-allsum.fact-qnty.
      371           for each bf-loc_parts-root where bf-loc_parts-root.doc-code       = bf-loc_parts.out-code   and
      372                                            bf-loc_parts-root.orig-in-code   = bf-loc_parts.in-code    and
      373                                            bf-loc_parts-root.orig-gds-code  = bf-loc_goods.gds-code   and
      374                                            bf-loc_parts-root.orig-part-code = bf-loc_parts.part-code  no-lock :
      375             find first bf-loc-plus_goods where bf-loc-plus_goods.gds-code  = bf-loc_parts-root.gds-code no-lock.
      376             find first bf-loc-plus_parts where bf-loc-plus_parts.obj-type  = bf-loc_doc-line.obj-type    and
      377                                                bf-loc-plus_parts.obj-code  = bf-loc_doc-line.obj-code    and
      378                                                bf-loc-plus_parts.artic     = bf-loc-plus_goods.artic     and
      379                                                bf-loc-plus_parts.prod-type = bf-loc-plus_goods.prod-type and
      380                                                bf-loc-plus_parts.prod-code = bf-loc-plus_goods.prod-code and
      381                                                bf-loc-plus_parts.in-code   = bf-loc_parts-root.in-code   and
      382                                                bf-loc-plus_parts.out-code  = bf-loc_doc-line.doc-code    and
      383                                                bf-loc-plus_parts.part-code = bf-loc_parts-root.part-code no-lock.
      384             find first bf-loc-plus_doc-line where bf-loc-plus_doc-line.doc-code  = bf-loc-plus_parts.out-code  and
      385                                                   bf-loc-plus_doc-line.artic     = bf-loc-plus_parts.artic     and
      386                                                   bf-loc-plus_doc-line.prod-type = bf-loc-plus_parts.prod-type and
      387                                                   bf-loc-plus_doc-line.prod-code = bf-loc-plus_parts.prod-code .
      388             find first tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code  and
      389                                                     tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic     and
      390                                                     tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type and
      391                                                     tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code and
      392                                                     tt-doc-line-cashe-plus.artic        = bf-loc-plus_goods.artic      and
      393                                                     tt-doc-line-cashe-plus.prod-type    = bf-loc-plus_goods.prod-type  and
      394                                                     tt-doc-line-cashe-plus.prod-code    = bf-loc-plus_goods.prod-code  no-error.
      395             if not available tt-doc-line-cashe-plus then do:
      396               create tt-doc-line-cashe-plus.
      397               assign
      398                 tt-doc-line-cashe-plus.doc-code     = tt-doc-line-cashe.doc-code
      399                 tt-doc-line-cashe-plus.wf-artic     = tt-doc-line-cashe.artic
      400                 tt-doc-line-cashe-plus.wf-prod-type = tt-doc-line-cashe.prod-type
      401                 tt-doc-line-cashe-plus.wf-prod-code = tt-doc-line-cashe.prod-code
      402                 tt-doc-line-cashe-plus.artic        = bf-loc-plus_goods.artic
      403                 tt-doc-line-cashe-plus.prod-type    = bf-loc-plus_goods.prod-type
      404                 tt-doc-line-cashe-plus.prod-code    = bf-loc-plus_goods.prod-code .
      405             end.
      406             for each tt-clcparts :
      407               delete tt-clcparts.
      408             end.
      409             create tt-clcparts.
      410             buffer-copy bf-loc-plus_parts to tt-clcparts.
      411             run clcprtsl_calc-parts-inkaps in clcprtsl-hndl (
      412                                             input-output table tt-clcparts
      413                                           , input-output table tt-allsum
      414                                           , input yes
      415                                           , input no
      416                                           , input bf-loc-plus_doc-line.road-tax
      417                                           , input bf-loc-plus_doc-line.excise
      418                                           , input bf-loc-plus_doc-line.VAT-pc
      419                                           , input bf-loc-plus_doc-line.cons-vat-pc
      420                                           , input bf-loc-plus_doc-line.SLT-pc
      421                                           , input bf_trn-doc.base-rate
      422                                           , input bf_trn-doc.base-scale
      423                                           , input "":U
      424                                           , input 0.0
      425                                           , input 0.0
      426                                           , input 0.0
      427                                           , input 0.0
      428                                           , input 0.0
      429                                           , input 0.0
      430                                       ).
      431             find first tt-allsum where tt-allsum.sum-type = 'основная_сумма':U no-error.
      432             find first tt-clcparts.
      433             if available tt-allsum then do:
      434               assign
      435                 tt-doc-line-cashe-plus.qnty               = tt-doc-line-cashe-plus.qnty               + tt-allsum.fact-qnty
      436                 tt-doc-line-cashe-plus.sum-rubl           = tt-doc-line-cashe-plus.sum-rubl           + tt-allsum.sum-dsc-rubl-doc
      437                 tt-doc-line-cashe-plus.sum-base           = tt-doc-line-cashe-plus.sum-base           + tt-allsum.sum-dsc-base-doc
      438                 tt-doc-line-cashe-plus.vat-rubl           = tt-doc-line-cashe-plus.vat-rubl           + tt-allsum.vat-rubl-doc
      439                 tt-doc-line-cashe-plus.vat-base           = tt-doc-line-cashe-plus.vat-base           + tt-allsum.vat-base-doc
      440                 tt-doc-line-cashe-plus.write-off-qnty     = tt-doc-line-cashe-plus.write-off-qnty     + tt-clcparts.real-qnty
      441                 tt-doc-line-cashe-plus.write-off-sum-rubl = tt-doc-line-cashe-plus.write-off-sum-rubl + varprice-rubl-parts * tt-clcparts.real-qnty
      442                 tt-doc-line-cashe-plus.write-off-sum-base = tt-doc-line-cashe-plus.write-off-sum-base + varprice-base-parts * tt-clcparts.real-qnty
      443               .
      444             end.
      445           end.
      446         end.
      447       end.
      448     end.
      449     method private decimal get-income-qnty
      450     ( buffer local-doc-line for ub.doc-line, buffer local-doc-line-plus for ub.doc-line ) :
      451      find first tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       and
      452                                              tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          and
      453                                              tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      and
      454                                              tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
      455                                              tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     and
      456                                              tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type and
      457                                              tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code no-error.
      458      if not available tt-doc-line-cashe-plus then do:
      459        proc-get-write-off (buffer local-doc-line).
      460        find first tt-doc-line-cashe-plus where tt-doc-line-cashe-plus.doc-code     = local-doc-line.doc-code       and
      461                                                tt-doc-line-cashe-plus.wf-artic     = local-doc-line.artic          and
      462                                                tt-doc-line-cashe-plus.wf-prod-type = local-doc-line.prod-type      and
      463                                                tt-doc-line-cashe-plus.wf-prod-code = local-doc-line.prod-code      and
      464                                                tt-doc-line-cashe-plus.artic        = local-doc-line-plus.artic     and
      465                                                tt-doc-line-cashe-plus.prod-type    = local-doc-line-plus.prod-type and
      466                                                tt-doc-line-cashe-plus.prod-code    = local-doc-line-plus.prod-code .
      467      end.
      468      return tt-doc-line-cashe-plus.qnty.
      469     end method.
      470   end class.
