        1   USING Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.bank-accounts from propath.
        4   using ibs.th.bge.1crn.subjects.bank-accounts_bank from propath.
        5   block-level on error undo, throw.
        6   CLASS ibs.th.bge.1crn.subjects.bank-accounts_bank inherits ibs.th.bge.1crn.subjects.asubject:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define property bank-name   as character    no-undo get.
       13       private set.
       14     define property bik         as character    no-undo get.
       15       private set.
       16     define property bank-city   as character    no-undo get.
       17       private set.
       18     define property cor-acc     as character    no-undo get.
       19       private set.
       20     define property qr-rule     as integer      no-undo get.
       21       private set.
       22     define property bank-deposit-debit as character    no-undo get.
       23       private set.
       24     define property bank-deposit-kredit as character    no-undo get.
       25       private set.
       26     define override property InitTag as character no-undo init "bank"
       27       get.
       28     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       29       case inTag:
       30         when "bank-name" then
       31           do:
       32             assign
       33               bank-name = inValue .
       34           end.
       35         when "bik" then
       36           do:
       37             assign
       38               bik = inValue .
       39           end.
       40         when "bank-city" then
       41           do:
       42             assign
       43               bank-city = inValue .
       44           end.
       45         when "cor-acc" then
       46           do:
       47             assign
       48               cor-acc = inValue .
       49           end.
       50         when "qr-rule" then
       51           do:
       52             assign
       53               qr-rule = integer(inValue) .
       54           end.
       55         when "bank-deposit-debit" then
       56           do:
       57             assign
       58               bank-deposit-debit = inValue .
       59           end.
       60         when "bank-deposit-kredit" then
       61           do:
       62             assign
       63               bank-deposit-kredit = inValue .
       64           end.
       65       end case.
       66     end.
       67     method override protected void CheckData ():
       68       def var v-str as char no-undo.
       69       assign
       70         v-str = v-str + ",bik"
       71         when bik = ?
       72         v-str = v-str + ",cor-acc"
       73         when cor-acc = ?
       74         .
       75       v-str = trim (v-str, ",").
       76       if v-str > ''
       77         then
       78         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       79     end.
       80     method override protected void ClearSub():
       81       assign
       82         bank-name = ?
       83         cor-acc   = ?
       84         bank-city = ?
       85         bik       = ?
       86         qr-rule   = ?
       87         bank-deposit-debit = ?
       88         bank-deposit-kredit = ?
       89         .
       90     end.
       91   END CLASS.
