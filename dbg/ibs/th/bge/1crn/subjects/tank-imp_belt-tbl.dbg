        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.tank-imp_cal-tbl from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.tank-imp_belt-tbl inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11      define property num-belt as int64 no-undo get.
       12         private set.
       13      define property low-lvl as int64 no-undo get.
       14         private set.
       15      define property up-lvl as int64 no-undo get.
       16         private set.
       17      define property tbl-lvl as int64 no-undo get.
       18         private set.
       19      define property belt-capacity as decimal no-undo get.
       20         private set.
       21      define override property InitTag as character no-undo init "belt-tbl-line"
       22         get.
       23      method override protected void SetPropProtected (inTag as char, inValue as char):
       24         case inTag:
       25            when "num-belt" then
       26               do:
       27                  assign
       28                     num-belt = int64(inValue) .
       29               end.
       30            when "low-lvl" then
       31               do:
       32                  assign
       33                     low-lvl = int64(inValue) .
       34               end.
       35            when "up-lvl" then
       36               do:
       37                  assign
       38                     up-lvl = int64(inValue) .
       39               end.
       40            when "tbl-lvl" then
       41               do:
       42                  assign
       43                     tbl-lvl = int64(inValue) .
       44               end.
       45            when "belt-capacity" then
       46               do:
       47                  assign
       48                     belt-capacity = decimal(inValue) .
       49               end.
       50         end case.
       51      end.
       52      method override protected void CheckData ():
       53         def var v-str as char no-undo.
       54         assign
       55            v-str = v-str + ",num-belt"
       56            when num-belt = ?
       57            v-str = v-str + ",low-lvl"
       58            when low-lvl = ?
       59            v-str = v-str + ",up-lvl"
       60            when up-lvl = ?
       61            v-str = v-str + ",tbl-lvl"
       62            when tbl-lvl = ?
       63            v-str = v-str + ",belt-capacity"
       64            when belt-capacity = ?
       65            .
       66         v-str = trim (v-str, ",").
       67         if v-str > ''
       68            then
       69            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       70      end.
       71      method override protected void ClearSub():
       72         assign
       73            num-belt      = ?
       74            low-lvl       = ?
       75            up-lvl        = ?
       76            tbl-lvl       = ?
       77            belt-capacity = ?
       78            .
       79      end.
       80   end class.
