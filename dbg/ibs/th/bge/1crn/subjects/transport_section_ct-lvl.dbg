        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.transport_section_ct-lvl inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property sec-num    as integer    no-undo get.
       10       private set.
       11     define property deviation  as integer     no-undo get.
       12       private set.
       13     define property amount    as decimal      no-undo get.
       14       private set.
       15     define override property InitTag as character no-undo init "ct-lvl"
       16       get.
       17     method override protected void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "sec-num" then
       20           do:
       21             assign
       22               sec-num = integer(inValue) .
       23           end.
       24         when "deviation" then
       25           do:
       26             assign
       27               deviation = integer(inValue) .
       28           end.
       29         when "amount" then
       30           do:
       31             assign
       32               amount = decimal (inValue) .
       33           end.
       34       end case.
       35     end.
       36     method override protected void CheckData ():
       37       def var v-str as char no-undo.
       38       assign
       39         v-str = v-str + ",sec-mum"
       40         when sec-num = ?
       41         v-str = v-str + ",deviation"
       42         when deviation = ?
       43         v-str = v-str + ",amount"
       44         when amount = ?
       45         .
       46       v-str = trim (v-str, ",").
       47       if v-str > ''
       48         then
       49         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       50     end.
       51     method override protected void ClearSub():
       52       assign
       53         sec-num   = ?
       54         deviation = ?
       55         amount    = ?
       56         .
       57     end.
       58   end class.
