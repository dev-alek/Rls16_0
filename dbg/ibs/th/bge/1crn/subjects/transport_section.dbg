        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.transport_section from propath.
        4   using ibs.th.bge.1crn.subjects.transport_section_calibration-table from propath.
        5   using ibs.th.bge.1crn.subjects.transport from propath.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.1crn.subjects.transport_section inherits ibs.th.bge.1crn.subjects.asubject:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13      define property sec-num         as integer    no-undo get.
       14         private set.
       15      define property capacity        as decimal    no-undo get.
       16         private set.
       17      define property min-of-lvl      as decimal    no-undo get.
       18         private set.
       19      define property max-of-lvl      as decimal    no-undo get.
       20         private set.
       21      define property diameter        as decimal    no-undo get.
       22         private set.
       23      define property length_         as decimal    no-undo get.
       24         private set.
       25      define property width_          as decimal    no-undo get.
       26         private set.
       27      define property circumference   as decimal    no-undo get.
       28         private set.
       29      define property wall            as decimal    no-undo get.
       30         private set.
       31      define property pipe-vlm        as decimal    no-undo get.
       32         private set.
       33      define override property InitTag as character no-undo init "section"
       34         get.
       35      method override protected void SetPropProtected (inTag as char, inValue as char):
       36         case inTag:
       37            when "sec-num" then
       38               do:
       39                  assign
       40                     sec-num = integer(inValue) .
       41               end.
       42            when "capacity" then
       43               do:
       44                  assign
       45                     capacity = decimal(inValue) .
       46               end.
       47            when "min-of-lvl" then
       48               do:
       49                  assign
       50                     min-of-lvl = decimal(inValue) .
       51               end.
       52            when "max-of-lvl" then
       53               do:
       54                  assign
       55                     max-of-lvl = decimal(inValue).
       56               end.
       57            when "diameter" then
       58               do:
       59                  assign
       60                     diameter = decimal(inValue).
       61               end.
       62            when "length" then
       63               do:
       64                  assign
       65                     length_ = decimal(inValue).
       66               end.
       67            when "width" then
       68               do:
       69                  assign
       70                     width_ = decimal(inValue).
       71               end.
       72            when "circumference" then
       73               do:
       74                  assign
       75                     circumference = decimal(inValue).
       76               end.
       77            when "wall" then
       78               do:
       79                  assign
       80                     wall = decimal(inValue).
       81               end.
       82            when "pipe-vlm" then
       83               do:
       84                  assign
       85                     pipe-vlm = decimal(inValue).
       86               end.
       87         end case.
       88      end.
       89      method override protected void CheckData ():
       90         def var v-str as char no-undo.
       91         assign
       92            v-str = v-str + "sec-num"
       93            when sec-num = ?.
       94         if v-str > ''
       95            then
       96            undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       97      end.
       98      method override protected void ClearSub():
       99         assign
      100            sec-num       = ?
      101            capacity      = ?
      102            min-of-lvl    = ?
      103            max-of-lvl    = ?
      104            diameter      = ?
      105            length_       = ?
      106            width_        = ?
      107            circumference = ?
      108            wall          = ?
      109            pipe-vlm      = ?
      110            .
      111      end.
      112   end class.
