       18   method private void xmlchar-test (input  p-in-string          as character,
       19                                     output p-out-string-enc     as character,
       20                                     output p-out-string-dec    as character):
       21   do
       22   on error undo, return error
       23   :
       24          xmlchar-encode
       25       (
       26             input p-in-string
       27           , output p-out-string-enc
       28       ).
       29          xmlchar-decode
       30       (
       31             input p-out-string-enc
       32           , output p-out-string-dec
       33       ).
       34   end.
       35   end .
       36   method private void xmlchar-encode (input  p-in-string          as character,
       37                                     output p-out-string         as character):
       38       define variable v-position      as integer      no-undo.
       39       define variable v-current-char  as character    no-undo.
       40   do
       41   on error undo, return error
       42   :
       43       assign
       44           p-out-string = "":U
       45       .
       46       case p-in-string
       47       :
       48           when ?
       49           then do:
       50               assign
       51                   p-out-string = "?":U
       52               .
       53           end.
       54           when "?":U
       55           then do:
       56               assign
       57                   p-out-string = "&#63;":U
       58               .
       59           end.
       60           otherwise do:
       61               do v-position = 1 to length( p-in-string )
       62               :
       63                   assign
       64                       v-current-char = substring( p-in-string, v-position, 1 )
       65                   .
       66                   case v-current-char
       67                   :
       68                       when "&":U
       69                       then do:
       70                           assign
       71                               p-out-string = p-out-string + "&amp;":U
       72                           .
       73                       end.
       74                       when ">":U
       75                       then do:
       76                           assign
       77                               p-out-string = p-out-string + "&gt;":U
       78                           .
       79                       end.
       80                       when "<":U
       81                       then do:
       82                           assign
       83                               p-out-string = p-out-string + "&lt;":U
       84                           .
       85                       end.
       86                       when "'":U
       87                       then do:
       88                           assign
       89                               p-out-string = p-out-string + "&apos;":U
       90                           .
       91                       end.
       92                       when '"':U
       93                       then do:
       94                           assign
       95                               p-out-string = p-out-string + "&quot;":U
       96                           .
       97                       end.
       98                       when chr(1)
       99                       then do:
      100                           assign
      101                               p-out-string = p-out-string + "":U
      102                           .
      103                       end.
      104                       when chr(2)
      105                       then do:
      106                           assign
      107                               p-out-string = p-out-string + "":U
      108                           .
      109                       end.
      110                       when chr(3)
      111                       then do:
      112                           assign
      113                               p-out-string = p-out-string + "":U
      114                           .
      115                       end.
      116                       when chr(4)
      117                       then do:
      118                           assign
      119                               p-out-string = p-out-string + "":U
      120                           .
      121                       end.
      122                       when chr(5)
      123                       then do:
      124                           assign
      125                               p-out-string = p-out-string + "":U
      126                           .
      127                       end.
      128                       when chr(6)
      129                       then do:
      130                           assign
      131                               p-out-string = p-out-string + "":U
      132                           .
      133                       end.
      134                       when chr(7)
      135                       then do:
      136                           assign
      137                               p-out-string = p-out-string + "":U
      138                           .
      139                       end.
      140                       when chr(8)
      141                       then do:
      142                           assign
      143                               p-out-string = p-out-string + "":U
      144                           .
      145                       end.
      146                       when chr(9)
      147                       then do:
      148                           assign
      149                               p-out-string = p-out-string + "":U
      150                           .
      151                       end.
      152                       when chr(29)
      153                       then do:
      154                           assign
      155                               p-out-string = p-out-string + "":U
      156                           .
      157                       end.
      158                       when chr(10)
      159                       then do:
      160                           assign
      161                               p-out-string = p-out-string + "&#10;":U
      162                           .
      163                       end.
      164                       when chr(13)
      165                       then do:
      166                           assign
      167                               p-out-string = p-out-string + "&#13;":U
      168                           .
      169                       end.
      170                       otherwise do:
      171                           assign
      172                               p-out-string = p-out-string + v-current-char
      173                           .
      174                       end.
      175                   end case.
      176               end.
      177           end.
      178       end case.
      179   end.
      180   end .
      181   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      182   define variable p-out-string as character no-undo.
      183       define variable v-position      as integer      no-undo.
      184       define variable v-current-char  as character    no-undo.
      185   do
      186   on error undo, return error
      187   :
      188       assign
      189           p-out-string = "":U
      190       .
      191       case p-in-string
      192       :
      193           when ?
      194           then do:
      195               assign
      196                   p-out-string = "?":U
      197               .
      198           end.
      199           otherwise do:
      200               do v-position = 1 to length( p-in-string )
      201               :
      202                   assign
      203                       v-current-char = substring( p-in-string, v-position, 1 )
      204                   .
      205                   case v-current-char
      206                   :
      207                       when chr(1)
      208                       then do:
      209                           assign
      210                               p-out-string = p-out-string + " ":U
      211                           .
      212                       end.
      213                       when chr(2)
      214                       then do:
      215                           assign
      216                               p-out-string = p-out-string + " ":U
      217                           .
      218                       end.
      219                       when chr(3)
      220                       then do:
      221                           assign
      222                               p-out-string = p-out-string + " ":U
      223                           .
      224                       end.
      225                       when chr(4)
      226                       then do:
      227                           assign
      228                               p-out-string = p-out-string + " ":U
      229                           .
      230                       end.
      231                       when chr(5)
      232                       then do:
      233                           assign
      234                               p-out-string = p-out-string + " ":U
      235                           .
      236                       end.
      237                       when chr(6)
      238                       then do:
      239                           assign
      240                               p-out-string = p-out-string + " ":U
      241                           .
      242                       end.
      243                       when chr(7)
      244                       then do:
      245                           assign
      246                               p-out-string = p-out-string + " ":U
      247                           .
      248                       end.
      249                       when chr(8)
      250                       then do:
      251                           assign
      252                               p-out-string = p-out-string + " ":U
      253                           .
      254                       end.
      255                       when chr(9)
      256                       then do:
      257                           assign
      258                               p-out-string = p-out-string + " ":U
      259                           .
      260                       end.
      261                       when chr(29)
      262                       then do:
      263                           assign
      264                               p-out-string = p-out-string + " ":U
      265                           .
      266                       end.
      267                       when chr(10)
      268                       then do:
      269                           assign
      270                               p-out-string = p-out-string + " ":U
      271                           .
      272                       end.
      273                       when chr(13)
      274                       then do:
      275                           assign
      276                               p-out-string = p-out-string + " ":U
      277                           .
      278                       end.
      279                       otherwise do:
      280                           assign
      281                               p-out-string = p-out-string + v-current-char
      282                           .
      283                       end.
      284                   end case.
      285               end.
      286           end.
      287       end case.
      288   end.
      289   return p-out-string.
      290   end .
      291   method private void xmlchar-decode (input  p-in-string          as character,
      292                                     output p-out-string         as character):
      293       define variable v-position      as integer      no-undo.
      294       define variable v-last-position as integer      no-undo.
      295       define variable v-temp-integer  as integer      no-undo.
      296       define variable v-current-char  as character    no-undo.
      297       define variable v-next-char     as character    no-undo.
      298       define variable v-success       as logical      no-undo.
      299   do
      300   on error undo, return error
      301   :
      302       assign
      303           p-out-string = "":U
      304           v-position   = 0
      305       .
      306       replace-cycle:
      307       do while yes
      308       on error undo, return error
      309       :
      310           assign
      311               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      312           .
      313           if v-last-position <= v-position
      314           then do:
      315               if v-position = 0
      316               then do:
      317                   assign
      318                       p-out-string = p-in-string
      319                   .
      320               end.
      321               else do:
      322                   assign
      323                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      324                   .
      325               end.
      326               leave replace-cycle.
      327           end.
      328           else do:
      329               assign
      330                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      331                   v-position      = v-last-position
      332                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      333               .
      334               if v-current-char = "#":U
      335               then do:
      336                   assign
      337                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      338                   .
      339                   if v-last-position > 0
      340                   then do:
      341                       xmlchar-read-integer
      342                        (
      343                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      344                           , output v-temp-integer
      345                           , output v-success
      346                       ).
      347                       if v-success = yes
      348                       and v-temp-integer >= 1
      349                       and v-temp-integer <= 255
      350                       then do:
      351                           assign
      352                               p-out-string = p-out-string + chr( v-temp-integer )
      353                               v-position   = v-last-position + 1
      354                           .
      355                       end.
      356                       else do:
      357                           assign
      358                               p-out-string = p-out-string + "&":U
      359                               v-position   = v-position   + 1
      360                           .
      361                       end.
      362                   end.
      363                   else do:
      364                       assign
      365                           p-out-string = p-out-string + "&":U
      366                           v-position   = v-position   + 1
      367                       .
      368                   end.
      369               end.
      370               else do:
      371                   case substring( p-in-string, v-position + 1, 3 )
      372                   :
      373                       when "lt;":U
      374                       then do:
      375                           assign
      376                               p-out-string = p-out-string + "<":U
      377                               v-position   = v-position   + 3
      378                           .
      379                       end.
      380                       when "gt;":U
      381                       then do:
      382                           assign
      383                               p-out-string = p-out-string + ">":U
      384                               v-position   = v-position   + 3
      385                           .
      386                       end.
      387                       otherwise do:
      388                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      389                           then do:
      390                               assign
      391                                   p-out-string = p-out-string + "&":U
      392                                   v-position   = v-position   + 4
      393                               .
      394                           end.
      395                           else do:
      396                               case substring( p-in-string, v-position + 1, 5 )
      397                               :
      398                                   when "quot;":U
      399                                   then do:
      400                                       assign
      401                                           p-out-string = p-out-string + '"':U
      402                                           v-position   = v-position   + 5
      403                                       .
      404                                   end.
      405                                   when "apos;":U
      406                                   then do:
      407                                       assign
      408                                           p-out-string = p-out-string + "'":U
      409                                           v-position   = v-position   + 5
      410                                       .
      411                                   end.
      412                                   otherwise do:
      413                                       assign
      414                                           p-out-string = p-out-string + "&":U
      415                                       .
      416                                   end.
      417                               end case.
      418                           end.
      419                       end.
      420                   end case.
      421               end.
      422           end.
      423       end.
      424   end.
      425   end .
      426   method private void xmlchar-read-integer (input  p-input-string       as character,
      427                                             output p-output-integer     as integer,
      428                                             output p-success            as logical):
      429   do
      430   on error undo, return error
      431   :
      432       assign
      433           p-output-integer = integer( p-input-string )
      434       no-error.
      435       if error-status :error
      436       then do:
      437           assign
      438               p-success           = no
      439               p-output-integer    = 0
      440           .
      441       end.
      442       else do:
      443           assign
      444               p-success           = yes
      445           .
      446       end.
      447   end.
      448   end.
      449   define variable mMRCCode  as logical    no-undo.
      450   define variable mTypeMark as character  no-undo.
      451   method private logical IS-NeedMark
      452   ( input ib-code as integer  ,
      453     input ib-str as character ):
      454      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      455      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      456                                    and buf_prod-bc-attr.b-str  eq ib-str
      457                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      458        no-lock no-error.
      459      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      460   end.
      461   method private character repTegforDm
      462   (iDM as char ):
      463       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      464       define variable vteg as character no-undo.
      465       define variable oDM as character no-undo.
      466       define variable vi as integer no-undo.
      467       oDM = iDm.
      468       do vi = 1 to num-entries(vTeglist):
      469          vTeg = entry(vi,vTeglist).
      470          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      471       end.
      472       return oDM.
      473   end.
      474   method private character repSpecSimbforDm
      475   (iDM as char ):
      476       define variable oDM as character no-undo.
      477       xmlchar-decode(iDM, output oDM).
      478     return repTegforDm (oDM).
      479   end.
      480   method private logical CheckGtin
      481   (iGtin as char):
      482      define variable bar_code as character no-undo.
      483      define variable vGtin as logical no-undo init "yes".
      484      if length(iGtin) eq 14
      485      then do:
      486         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      487         run str/chk-sum.p
      488          (input-output bar_code ) no-error .
      489         if iGtin ne  bar_code
      490         then
      491            vGtin = no.
      492      end.
      493      else
      494         vGtin = no.
      495      return vgtin.
      496   end.
      497   method private character repSpecSimbforXlm
      498   (iDM as char ):
      499       iDM = replace(iDM,chr(29),"").
      500       return iDM.
      501   end.
      502   method private character getGtinByDM
      503   (IDM as char):
      504      define variable VTXT as char no-undo.
      505      define variable vGtin as char no-undo.
      506      vTXt = IdM.
      507      vGtin = IDM.
      508      if    length(vtxt) > 14
      509      then do:
      510         if   vtxt begins "(01)"
      511                or vtxt begins "(02)"
      512         then
      513            vGtin = substring(vtxt,5,14).
      514         else if   (vtxt begins "01"
      515                or vtxt begins "02" )
      516                and (   (    substring(iDm,17,2) eq "21"
      517                         and length(vtxt) >= 21)
      518                     or substring(iDm,17,2) eq "37"
      519                     or substring(iDm,17,4) eq "(37)" )
      520         then do:
      521            vGtin = substring(vtxt,3,14).
      522            if not checkGtin(vGtin)
      523            then
      524               vGtin = substring(vtxt,1,14).
      525         end.
      526         else if     length(vtxt) eq 14 + 7 + 4 + 4
      527             or length(vtxt) eq 14 + 7 + 4
      528             or length(vtxt) eq 14 + 7
      529         then
      530            vGtin = substring(vtxt,1,14).
      531      end.
      532      if not checkGtin(vGtin)
      533      then
      534         vGtin = "".
      535      return vgtin.
      536   end.
      537   method private integer getGdsCodeByGtin
      538   (iGtin as char):
      539      define buffer prod-bc  for ub.prod-bc.
      540      define buffer bar-code for ub.bar-code.
      541      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      542      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      543      return if avail bar-code then bar-code.gds-code else ?.
      544   end.
      545   method private decimal getQntyCodeByGtin
      546   (iGtin as char):
      547      define buffer prod-bc  for ub.prod-bc.
      548      define buffer bar-code for ub.bar-code.
      549      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      550      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      551      return if avail bar-code then bar-code.cli-base-rate else ?.
      552   end.
      553   method private integer getGdsCodeByDM
      554   (iDm as char):
      555      define variable vGtin as char no-undo.
      556      define buffer prod-bc for ub.prod-bc.
      557      vGtin  = getGtinByDM (IDM ).
      558      return getGdsCodeByGtin (vGtin).
      559   end.
      560   method private logical ChekTypeMarkByGds
      561   (iGds-code as integer ):
      562      define buffer goods-attr for ub.goods-attr.
      563      find first goods-attr where goods-attr.gds-code   = iGds-code
      564                              and goods-attr.attr-code  = 'mark-type':U
      565      no-lock no-error.
      566      if available goods-attr
      567      then do:
      568         mTypeMark = goods-attr.attr-value.
      569         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      570           .
      571      end.
      572      else
      573         return no.
      574   end.
      575   method private logical ChekTypeMarkByDm
      576   (iDM as char ):
      577      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      578   end.
      579   method private logical ChekTypeMarkByGtin
      580   (iGtin as char ):
      581      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      582   end.
      583   method private character  GetNextElement
      584     (input iAllTeg        as logical
      585     ,output oteg          as character
      586     ,output otegval       as character
      587     ,input-output pstr    as character
      588      ):
      589        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      590        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      591        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      592        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      593        define variable vTeg as character no-undo.
      594        define variable vLength as integer no-undo.
      595        define variable vi as integer no-undo.
      596        define variable vj as integer no-undo.
      597        define buffer code for ub.code.
      598        find first code where Code.parent eq "MarkType"
      599                          and Code.CodeValue   eq mTypeMark
      600                          no-lock no-error.
      601        if     available code
      602           and Code.misc1 ne ""
      603           and Code.misc1 ne ?
      604        then do:
      605           integer (Code.misc1) no-error.
      606           if not error-status:error
      607           then
      608             entry (4,vlistleng) = Code.misc1.
      609        end.
      610        if iAllTeg
      611        then
      612           assign
      613              vlistElem     = vlistElem    + vlistElemDop
      614              vlistleng     = vlistleng    + vlistlengDop
      615           .
      616        else if mMRCCode
      617        then
      618           assign
      619              vlistElem     = vlistElem    + ",(8005),8005"
      620              vlistleng     = vlistleng    + ",000006,0006"
      621           .
      622       block-elem:
      623       do vi = 1 to num-entries(vlistElem):
      624          vTeg = entry(vi,vlistElem).
      625          if pstr begins vTeg
      626          then do:
      627             if    vTeg eq "21"
      628             then
      629                vLength = index(pstr,chr(29)) - 2 no-error.
      630             if vLength  <= 0
      631             then
      632                vLength = int(entry(vi,vlistleng)).
      633             otegval = substring (pstr,length(vteg) + 1, vLength).
      634             oteg = replace(replace(vteg,")",""),"(","").
      635             vTeg = vteg + otegval.
      636             otegval = replace(otegval,chr(29),"").
      637             oteg = replace(replace(oteg,")",""),"(","").
      638             pstr = substring (pstr,length(vTeg)+ 1).
      639             vTeg = replace(vTeg,chr(29),"").
      640             leave block-elem.
      641          end.
      642          else
      643             vTeg = "".
      644       end.
      645       return vteg.
      646   end.
      647   method private character  GetCodeIdent
      648   (iDm as char):
      649      define variable Velement   as character no-undo init "first".
      650      define variable oCodeIdent as character no-undo.
      651      define variable vteg as character no-undo.
      652      define variable vtegval as character no-undo.
      653      define variable vGtin as character no-undo.
      654      define buffer marking for ub.marking.
      655      for first marking no-lock where
      656                marking.mark eq iDm
      657            and marking.unit-ext = "LEVEL2"
      658      :
      659        return iDm.
      660      end.
      661      vGtin  = getGtinByDM (iDm ).
      662      ChekTypeMarkByDm(idm).
      663      if iDm begins 'tech_':U
      664      then
      665         oCodeIdent = iDm.
      666      else if length(iDm) < 21
      667      then do:
      668         find first marking where marking.mark eq idm
      669         no-lock no-error.
      670         oCodeIdent = if available marking then marking.mark else  ?.
      671      end.
      672      else if     length(iDm) eq 29
      673         and not iDm begins "01"
      674         and not iDm begins "02"
      675      then
      676         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      677      else  if     length(iDm) >= 24
      678               and (  iDm begins "01"
      679                   or iDm begins "02")
      680               and  substring(iDm,17,2) ne "21"
      681      then do:
      682         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      683                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      684         then
      685            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      686         else
      687            oCodeIdent = iDM.
      688      end.
      689      else  if     (   length(iDm) eq 25
      690                    or length(iDm) eq 21)
      691               and (not iDm begins "01"
      692               and  not iDm begins "02")
      693      then
      694         oCodeIdent = substring(iDm,1,21).
      695      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      696      then
      697         oCodeIdent = substring(iDm,1,21).
      698      else do while Velement ne "" and idm ne "":
      699         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      700         oCodeIdent = oCodeIdent + Velement.
      701      end.
      702      return oCodeIdent.
      703   end.
      704   method private character  GetTegCod
      705   (icodeIdent as char, iTeg as char):
      706      define variable Velement   as character no-undo init "first".
      707      define variable oTeg as character no-undo init ?.
      708      define variable vteg as character no-undo.
      709      define variable vtegval as character no-undo.
      710      if     ((length(icodeIdent) eq 21
      711         and not icodeIdent begins "01"
      712         and not icodeIdent begins "02")
      713         or
      714             ( length(icodeIdent) eq 25
      715               and not icodeIdent begins "01"
      716               and not icodeIdent begins "02"))
      717      then do:
      718         if iTeg eq "01" or iTeg eq "02"
      719         then
      720            oTeg = substring(icodeIdent,1,21).
      721         else  if  iTeg eq "21"
      722         then
      723            oTeg = substring(icodeIdent,15,7).
      724      end.
      725      else do:
      726         ChekTypeMarkByDm(icodeIdent).
      727         block-teg:
      728            do while Velement ne "" and icodeIdent ne "":
      729            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      730            if    Velement begins iTeg
      731               or Velement begins "(" + iTeg + ")"
      732            then do:
      733               oTeg = vtegval.
      734               leave block-teg.
      735            end.
      736         end.
      737      end.
      738      return oTeg.
      739   end.
      740   method private logical isOAD
      741   (icodeIdent as character):
      742      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      743   end.
      744   method private logical isMark
      745   (icodeIdent as character):
      746      define buffer buf_marking for ub.marking.
      747      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      748             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      749   end.
      750   method private character  addBracketForCode
      751   (icodeIdent as char):
      752      define variable Velement   as character no-undo init "first".
      753      define variable oTeg as character no-undo.
      754      define variable vteg as character no-undo.
      755      define variable vtegval as character no-undo.
      756      define buffer marking for ub.marking.
      757      find first marking no-lock where
      758                 marking.mark begins icodeIdent no-error.
      759      if    not ChekTypeMarkByDm(icodeIdent)
      760         or length(icodeIdent) le 24
      761         or (avail marking and marking.unit-ext = "LEVEL2")
      762      then
      763         oTeg = icodeIdent.
      764      else do:
      765         if (  icodeIdent begins "01"
      766            or icodeIdent begins "02"
      767            ) and CheckGtin(substring (icodeIdent,3,14))
      768            and substring (icodeIdent,17,2) eq "21"
      769         then do:
      770            mMRCCode = yes.
      771            ChekTypeMarkByDm(icodeIdent).
      772            block-teg:
      773            do while Velement ne "" and icodeIdent ne "":
      774               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      775               if vteg ne ""
      776               then
      777                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      778            end.
      779            mMRCCode = no.
      780         end.
      781         else do:
      782            oTeg = icodeIdent.
      783         end.
      784      end.
      785      return oTeg.
      786   end.
      787   method private integer getlevelByCodId
      788   (iCode as char):
      789      define variable vLength as int no-undo.
      790      define variable vLevel  as int no-undo.
      791      if not ChekTypeMarkByDM (icode) then return ?.
      792      vLength = length(iCode).
      793      if    vLength eq 18
      794         or vLength eq 20
      795      then
      796         Vlevel = 4.
      797      else if vLength eq 21
      798      then
      799         Vlevel = 1.
      800      else if vLength eq 25
      801      then do:
      802         if  iCode begins "01"
      803         then
      804            Vlevel = 3.
      805         else
      806            Vlevel = 1.
      807      end.
      808      else if     vLength >= 26
      809              and vLength <= 46
      810      then do:
      811         if    substring(iCode,17,2) eq "11"
      812            or substring(iCode,17,2) eq "13"
      813            or (    substring(iCode,17,2) eq "21"
      814                and vLength >= 33
      815                and substring(iCode,26,4) ne "8005")
      816         then
      817            Vlevel = 4.
      818         else if    vLength eq 31
      819                 or vLength eq 38
      820                 or vLength eq 39
      821                 or vLength eq 45
      822         then
      823            Vlevel = 1.
      824         else if    vLength eq 35
      825                 or vLength eq 43
      826         then
      827            Vlevel = 3.
      828         else
      829            Vlevel = ?.
      830      end.
      831      else
      832         Vlevel = ?.
      833      return Vlevel.
      834   end.
      835   method private character  getLevelMotpBycodid
      836   (iDm as char):
      837      define variable vLevel as integer no-undo.
      838      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      839      vLevel = getlevelByCodId(iDm).
      840      if    vLevel eq ?
      841         or vLevel < 1
      842         or vLevel > 6
      843      then
      844         return ?.
      845      else
      846         return entry(vlevel,vList).
      847   end.
      848   method private character    getLevelUTDByLevelMotp
      849   (iUnit as char):
      850      define variable vLevel as integer no-undo.
      851      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      852      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      853      vLevel = lookup(iUnit,vListMOTP).
      854      if    vLevel eq ?
      855         or vLevel < 1
      856         or vLevel > 4
      857      then
      858         return ?.
      859      else
      860         return entry(vlevel,vListutd).
      861   end.
      862   method private character  getLevelMotpByDM
      863   (iDm as char):
      864      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      865   end.
      866   method private character  getLevelUTDByCodId
      867   (iDm as char):
      868      define variable vLevel as integer no-undo.
      869      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      870      vLevel = getlevelByCodId(iDm).
      871      if    vLevel eq ?
      872         or vLevel < 1
      873         or vLevel > 4
      874      then
      875         return ?.
      876      else
      877         return entry(vlevel,vList).
      878   end.
      879   method private character  getLevelUTDByDM
      880   (iDm as char):
      881      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      882   end.
      883   define variable mNotMarkQnty as logical no-undo.
      884   method private decimal getQntyUTDByCodId
      885   (iDM as char):
      886      define variable vLevel as integer no-undo.
      887      define variable vList as character no-undo init "1,5,10,500".
      888      define variable vGtin as character no-undo.
      889      define variable vqnty as decimal no-undo init ?.
      890      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      891      if vqnty eq ?
      892      then do:
      893         if not mNotMarkQnty
      894         then do:
      895            define buffer marking for ub.marking.
      896            define variable vCodident as character no-undo.
      897            vCodident = GetCodeIdent(idm).
      898            find first marking where marking.mark begins vCodident no-lock no-error.
      899            if     available marking
      900               and marking.box-qnty ne ?
      901            then
      902               return marking.box-qnty.
      903         end.
      904         vGtin = getGtinByDm(iDM).
      905         if ChekTypeMarkByGtin (vGtin)
      906         then do:
      907            vLevel = getlevelByCodId(iDM).
      908            if     vLevel >= 1
      909               and vLevel <= 4
      910            then
      911               vqnty = int(entry(vlevel,vList)).
      912         end.
      913         else
      914            vqnty = getQntyCodeByGtin(vgtin).
      915      end.
      916      return vqnty.
      917   end.
      918   method private decimal getQntyUTDByDM
      919   (iDm as char):
      920      define variable vDM as character no-undo.
      921      if     length (iDm) ne 25
      922         and length (iDm) ne 29
      923         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      924      then
      925         vDM = substring (iDm,1,length (iDm) - 6 ).
      926      else
      927         vDM = substring (iDm,1,length (iDm) - 4 ).
      928      return getQntyUTDByCodId(vDM).
      929   end.
      930   method private decimal    getMRC4
      931   (iMRC as char):
      932      define variable oMrc     as decimal no-undo init ?.
      933      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      934      define variable vi       as integer no-undo.
      935      define variable vfound   as integer no-undo.
      936      define variable vposStart   as integer no-undo.
      937      do:
      938      OMRc = 0.
      939      do vi = 1 to 4:
      940         define variable vsimb as character no-undo.
      941         vsimb = substring(iMRC,vi,1).
      942         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      943         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      944         if vfound > 0
      945         then
      946            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      947         end.
      948         OMRc = OMRc / 100.
      949      end.
      950      return OMRc.
      951   end.
      952   method private decimal    getMRCByDM
      953   (iDm as char):
      954      define variable vMRC     as character no-undo.
      955      define variable oMrc     as decimal no-undo init ?.
      956      define variable Velement as character no-undo init "empty".
      957      define variable vteg as character no-undo.
      958      define variable vtegval as character no-undo.
      959      if    length(idm) eq 14 + 7 + 4 + 4
      960         or length(idm) eq 14 + 7 + 4
      961      then do:
      962         vMRC = substring(idm,22,4).
      963         omrc = getMRC4(vMRC).
      964      end.
      965      else do:
      966          ChekTypeMarkByDm(iDm).
      967          block-mrc:
      968          do while Velement ne "" and idm ne "":
      969             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      970             if Velement begins "8005"
      971             then do:
      972                vMRC = substring(Velement,5,6).
      973                leave block-mrc.
      974             end.
      975             else if Velement begins "(8005)"
      976             then do:
      977                vMRC = substring(Velement,7,6).
      978                leave block-mrc.
      979             end.
      980          end.
      981          if vMRC ne ""
      982          then
      983             OMRc = dec(vmrc) / 100 no-error.
      984      end.
      985      return OMRc.
      986   end.
      987   method private date    MoveDate
      988   (idate as date,
      989    iMonth as int64):
      990      define variable vMonth   as int64 no-undo.
      991      define variable vYear    as int64 no-undo.
      992      define variable vDateNew as date  no-undo.
      993       define variable vDay     as int64 no-undo.
      994       vMonth = month(iDate) + iMonth.
      995       vYear =  year(iDate).
      996       if vMonth <= 0
      997       then assign
      998          vMonth = vMonth + 12
      999           vYear  = vYear - 1
     1000       .
     1001       else if vMonth > 12
     1002       then assign
     1003          vMonth = vMonth - 12
     1004           vYear  = vYear + 1
     1005       .
     1006       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1007       do while error-status:error eq yes:
     1008          VDay = vDay + 1.
     1009          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1010       end.
     1011       if VDay > 0
     1012       then
     1013          vDateNew + 1.
     1014       return vDateNew.
     1015   end.
     1016   method private logical    checkEMRC
     1017   (input  iDm as char,
     1018    output vOk as logical):
     1019      define variable v-value-emrc as character no-undo.
     1020      define variable v-type-emrc  as character no-undo.
     1021      define variable vDateIso     as character no-undo.
     1022      define variable vMRC         as decimal no-undo.
     1023      define variable vqnty        as decimal no-undo.
     1024      define variable vPrice       as decimal no-undo.
     1025      define variable vparent      as character no-undo.
     1026      define variable vgds-code    as integer no-undo.
     1027      define buffer code for ub.code.
     1028      vMRC = getMRCByDM(iDm).
     1029      if vMRC > 0
     1030      then do:
     1031         vgds-code = getGdsCodeByDM(iDm).
     1032         vqnty     = getQntyUTDByDM(iDm).
     1033               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1034            (
     1035             input   vgds-code
     1036            ,input   'emrc-type':U
     1037            ,output   v-value-emrc
     1038            ,output   v-type-emrc
     1039          ) no-error.
     1040          if     v-value-emrc ne ""
     1041             and v-value-emrc ne ?
     1042          then do:
     1043             vDateIso = iso-date(today).
     1044             vPrice = vMRC / vqnty.
     1045             vparent ="emc" + chr(4) + v-value-emrc.
     1046             find last code where Code.parent      eq vparent
     1047                              and Code.code        le vDateIso
     1048                              and code.status_  eq 0
     1049             no-lock no-error.
     1050             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1051             then
     1052                vOk = true .
     1053             else do:
     1054                 define variable vText      as character no-undo.
     1055                 define variable vDate      as date no-undo.
     1056                 define variable vDateLast  as character no-undo.
     1057                 define variable vDateFirst as character no-undo.
     1058                 define variable vDate3     as date no-undo.
     1059                 vdate = date(code.misc1).
     1060                 vDateLast = code.misc1.
     1061                 vDate3 = MoveDate(today, - 3 ).
     1062                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1063                                      string(vDate3  , "99/99/9999"),
     1064                                      string(vDate   , "99/99/9999")
     1065                                      ).
     1066                 vdateIso = iso-date(vdate3).
     1067                 find last code  where Code.parent      eq vparent
     1068                                   and Code.code        le vDateIso
     1069                                   and code.status_  eq 0 no-lock no-error.
     1070                 if available code
     1071                 then
     1072                    vDateIso = code.code.
     1073                 vDateFirst = vDateIso.
     1074                 vDateLast = iso-date(vdate).
     1075                 define variable vGood as logical no-undo.
     1076                 define variable vDateSale as date no-undo.
     1077                 define buffer bcode for code.
     1078                 for last code where Code.parent   eq vparent
     1079                                 and code.status_  eq 0
     1080                                 and code.code     < vDateLast
     1081                                 and code.code     >= vDateFirst
     1082                 no-lock:
     1083                    find first bcode where bCode.parent   eq vparent
     1084                                       and bcode.status_  eq 0
     1085                                       and bcode.code     > code.code no-lock no-error.
     1086                    if available bcode
     1087                    then do:
     1088                       if vPrice < dec(Code.CodeValue)
     1089                       then
     1090                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1091                                                     chr(10),
     1092                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1093                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1094                                                     ).
     1095                       else do:
     1096                          vGood = yes.
     1097                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1098                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1099                                                     chr(10),
     1100                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1101                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1102                                                     string(         vDateSale            ,"99/99/9999"),
     1103                                                     string(vDateSale - today)
     1104                                                     ).
     1105                       end.
     1106                    end.
     1107                 end.
     1108                 if vgood
     1109                 then do:
     1110                    define variable choice as integer no-undo .
     1111                    run gbl/d-askw.w (input "Уточнение"
     1112                           ,input  vText
     1113                           ,input "|"
     1114                           ,input "Принять|Вернуть"
     1115                           ,input "Принять данный товар|Вернуть товар постащику"
     1116                           ,input 1
     1117                           ,input 2
     1118                           ,output choice) no-error.
     1119                    vok = choice eq 1.
     1120                 end.
     1121                 else
     1122                    vok =false.
     1123             end.
     1124          end.
     1125      end.
     1126   end.
     1127   method private character addGs2Mark
     1128   (iMark as char):
     1129      define variable vDM   as character no-undo.
     1130      define variable vIdx  as integer   no-undo.
     1131      if index(iMark,chr(29),1) > 0
     1132      then return iMark.
     1133      if substring(iMark,26,4) = "8005" then
     1134      do:
     1135        vIdx = index(iMark,"93",26 + 4 + 5).
     1136        if vIdx > 1 then do:
     1137          vDM = substitute("&1&4&2&4&3",
     1138                           substring(iMark,1,25),
     1139                           substring(iMark,26,vIdx - 25 - 1),
     1140                           substring(iMark,vIdx),
     1141                           chr(29)) no-error.
     1142          vIdx = index(vDm,"240",vIdx + 4).
     1143          if vIdx > 0 then
     1144          do:
     1145            vDM = substitute("&1&3&2",
     1146                             substring(vDm,1,vIdx - 1),
     1147                             substring(vDm,vIdx),
     1148                             chr(29)) no-error.
     1149          end.
     1150        end.
     1151        else
     1152          vDM = substitute("&1&3&2",
     1153                           substring(iMark,1,25),
     1154                           substring(iMark,26),
     1155                           chr(29)) no-error.
     1156      end.
     1157      else if substring(iMark,32,2) = "91" then
     1158      do:
     1159        vIdx = index(iMark,"92",32).
     1160        if vIdx > 1 then
     1161          vDM = substitute("&1&4&2&4&3",
     1162                           substring(iMark,1,31),
     1163                           substring(iMark,32,vIdx - 31 - 1),
     1164                           substring(iMark,vIdx),
     1165                           chr(29)) no-error.
     1166        else
     1167          vDM = substitute("&1&3&2",
     1168                           substring(iMark,1,31),
     1169                           substring(iMark,32),
     1170                           chr(29)) no-error.
     1171      end.
     1172      else if substring(iMark,39,2) = "91" then
     1173      do:
     1174        vIdx = index(iMark,"92",38).
     1175        if vIdx > 1 then
     1176          vDM = substitute("&1&4&2&4&3",
     1177                           substring(iMark,1,38),
     1178                           substring(iMark,39,vIdx - 38 - 1),
     1179                           substring(iMark,vIdx),
     1180                           chr(29)) no-error.
     1181        else
     1182          vDM = substitute("&1&3&2",
     1183                           substring(iMark,1,38),
     1184                           substring(iMark,39),
     1185                           chr(29)) no-error.
     1186      end.
     1187      else if substring(iMark,25,2) = "93" then
     1188      do:
     1189        vIdx = index(iMark,"92",25).
     1190        if vIdx > 1 then
     1191          vDM = substitute("&1&4&2&4&3",
     1192                           substring(iMark,1,24),
     1193                           substring(iMark,25,vIdx - 24 - 1),
     1194                           substring(iMark,vIdx),
     1195                           chr(29)) no-error.
     1196        else
     1197          vIdx = index(iMark,"3103",25).
     1198          if vIdx > 0 then
     1199          vDM = substitute("&1&4&2&4&3",
     1200                           substring(iMark,1,24),
     1201                           substring(iMark,25,vIdx - 24 - 1),
     1202                           substring(iMark,vIdx),
     1203                           chr(29)) no-error.
     1204          else
     1205            vDM = substitute("&1&3&2",
     1206                             substring(iMark,1,24),
     1207                             substring(iMark,25),
     1208                             chr(29)) no-error.
     1209      end.
     1210      else if substring(iMark,32,2) = "93" then
     1211      do:
     1212        vDM = substitute("&1&3&2",
     1213              substring(iMark,1,31),
     1214              substring(iMark,32),
     1215              chr(29)) no-error.
     1216      end.
     1217      return if vDM <> "" then vDm else iMark.
     1218   end.
     1219     define temp-table buf_trn-doc like ub.trn-doc.
     1220     define buffer buf_inv-line for ub.inv-line.
     1221     define buffer buf_doc-line for ub.doc-line.
     1222     define buffer buf_doc-line-attr for ub.doc-line-attr.
     1223     define buffer bf_doc-line-sum for ub.doc-line-sum.
     1224     define buffer buf_doc-pl for ub.doc-pl.
     1225     define buffer buf_gds for ub.goods.
     1226     define buffer buf_doc-attr for ub.doc-attr.
     1227     define buffer buf_units for ub.units.
     1228     define buffer bf_rvs-line for ub.rvs-line.
     1229     define buffer bf_rvs-doc for ub.rvs-doc.
     1230     define buffer bf_gen-attr for ub.gen-attr.
     1231     define property Msg as character no-undo
     1232       get:
     1233         return trim (Msg, chr(10)).
     1234       end.
     1235       private set (inArg as char):
     1236         Msg = Msg + chr(10) + inArg.
     1237       end.
     1238     define property InitSecTag as character no-undo
     1239       get.
     1240       private set.
     1241     define property BufTableHndlNew as handle no-undo
     1242       get.
     1243       set.
     1244     define property BufTableHndlOld as handle no-undo
     1245       get.
     1246       set.
     1247     define public property sendTableName as character no-undo init "trn-doc"
     1248       get.
     1249     define public property sendOldRowid as rowid  no-undo
     1250       get.
     1251       set.
     1252     define public property sendNewRowid as rowid  no-undo
     1253       get.
     1254       set.
     1255     define variable rvsinvObj        as class rvsinvsub no-undo .
     1256     define variable sw               as handle    no-undo.
     1257     define variable v-is-petrol-trn  as logical   no-undo.
     1258     define variable v-is-pieces      as logical   no-undo.
     1259     define variable isDel            as logical   no-undo.
     1260     define variable varinvclcwt      as logical   no-undo.
     1261     define variable varinvclcas      as logical   no-undo.
     1262     define variable varinvclcex      as logical   no-undo.
     1263     define variable varinvclcms      as logical   no-undo.
     1264     define variable varinvclcbef     as logical   no-undo.
     1265     define variable prtvalue         as character no-undo.
     1266     define variable varinvclcspvalue as character no-undo.
     1267     define variable varr-b           as character no-undo.
     1268     define variable is-cdinv         as character no-undo .
     1269     define variable v-bufhnd         as handle    no-undo.
     1270     define variable v-doc-num        as character no-undo .
     1271     define variable dprice-sale      as decimal   no-undo .
     1272     define variable droad-tax        as decimal   no-undo .
     1273     define variable dexcise          as decimal   no-undo .
     1274     define variable v-qnty-type      as character no-undo .
     1275     define variable dcurr-price      as decimal   no-undo .
     1276     define variable prc-density      as decimal   no-undo .
     1277     define variable dLoss-qnty       as decimal   no-undo .
     1278     define variable dLoss-sum        as decimal   no-undo .
     1279     define temp-table tt-marks no-undo
     1280       field mark as character.
     1281     constructor public inv-gd-doc():
     1282       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib) then
     1283         run str/trdcalib.p persistent no-error .
     1284     end constructor.
     1285     method public void CrContentToSW (insw as handle):
     1286   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1287   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1288       define variable p-value      as character no-undo.
     1289       define variable p-type       as character no-undo.
     1290       sw = insw.
     1291       create buf_trn-doc.
     1292       v-bufhnd = buffer buf_trn-doc:handle.
     1293       if valid-handle (BufTableHndlNew)
     1294       then do:
     1295         sendNewRowid  = BufTableHndlNew:rowid.
     1296         v-bufhnd:buffer-copy (BufTableHndlNew) no-error.
     1297         if error-status:error
     1298         then do:
     1299           Msg = "Ошибка выгрузки inv-gd-doc, неверный буфер BufTableHndlNew".
     1300           undo, return error Msg.
     1301         end.
     1302         isDel = false.
     1303       end.
     1304       else do:
     1305         if not valid-handle (BufTableHndlOld)
     1306         then do:
     1307           Msg = "Ошибка выгрузки inv-gd-doc, неопеределен ни старый ни новый буфер".
     1308           undo, return error Msg.
     1309         end.
     1310         sendOldRowid  = BufTableHndlOld:rowid.
     1311         v-bufhnd:buffer-copy (BufTableHndlOld) no-error.
     1312         if error-status:error
     1313         then do:
     1314           Msg = "Ошибка выгрузки inv-gd-doc, неверный буфер BufTableHndlOld".
     1315           undo, return error Msg.
     1316         end.
     1317         isDel = true.
     1318       end.
     1319       for each buf_inv-line no-lock where buf_inv-line.doc-code = buf_trn-doc.doc-code:
     1320   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in ibs.th.gbl.gbl-hndllib:g#lib-trn
     1321     (
     1322        input buf_inv-line.artic
     1323     ,  input buf_inv-line.prod-type
     1324     ,  input buf_inv-line.prod-code
     1325     , output v-is-petrol-trn
     1326     , output v-is-pieces
     1327     ) .
     1328         if v-is-petrol-trn
     1329           then leave.
     1330       end.
     1331   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1332                           input 'addsum':U ,
     1333                          output p-value ,
     1334                          output p-type )  .
     1335       assign
     1336         varinvclcbef = no
     1337         varinvclcas  = no
     1338         varinvclcex  = no
     1339         varinvclcms  = no
     1340         varinvclcwt  = no
     1341       .
     1342       if lookup( 'bd':U, p-value ) <> 0 then do:
     1343         assign
     1344           varinvclcbef = yes
     1345         .
     1346       end.
     1347       if lookup( 'gen':U, p-value ) <> 0 then do:
     1348         assign
     1349           varinvclcas = yes
     1350         .
     1351       end.
     1352       if lookup( 'ext':U, p-value ) <> 0 then do:
     1353         assign
     1354           varinvclcex = yes
     1355         .
     1356       end.
     1357       if lookup( 'mis':U, p-value ) <> 0 then do:
     1358         assign
     1359           varinvclcms = yes
     1360         .
     1361       end.
     1362       if lookup( 'wst':U, p-value ) <> 0 then do:
     1363         assign
     1364           varinvclcwt = yes
     1365         .
     1366       end.
     1367       run str/invdcfrd.p (  input buf_trn-doc.doc-code,
     1368                        output varinvclcspvalue,
     1369                        output prtvalue,
     1370                        output varr-b ,
     1371                        output is-cdinv
     1372                        ) no-error.
     1373       if v-is-petrol-trn
     1374       then do:
     1375         StartDocInvFuel().
     1376         GdsLineFuel().
     1377         EndDocInvFuel().
     1378       end.
     1379       else do:
     1380         StartDocInv().
     1381         GdsLine().
     1382         EndDocInv().
     1383       end.
     1384     end.
     1385     method private void GdsLine ():
     1386       define variable vGT as integer no-undo .
     1387       define variable vGtin as character no-undo .
     1388       define variable vGtinQnty as integer no-undo .
     1389       sw:start-element ("gds").
     1390       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code:
     1391         find first buf_gds where
     1392               buf_gds.artic = buf_doc-line.artic
     1393           and buf_gds.prod-code = buf_doc-line.prod-code
     1394           and buf_gds.prod-type = buf_doc-line.prod-type.
     1395         find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_doc-line.doc-code
     1396                                                and buf_doc-line-attr.gds-code = buf_gds.gds-code
     1397                                                and buf_doc-line-attr.attr-code = "GTIN-qnty"
     1398                                                no-error .
     1399         sw:start-element ("gd").
     1400           write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     1401           write-data-element ("qnty-b", string-mth (round (buf_doc-line.doc-qnty - buf_doc-line.fact-qnty, 3))).
     1402           write-data-element ("qnty-a", string-mth (round (buf_doc-line.doc-qnty, 3))).
     1403           write-data-element ("qnty-df", string-mth (round (buf_doc-line.fact-qnty, 3))).
     1404           write-data-element ("qnty-izl", string-mth (round (fncextra-qnty( buffer buf_doc-line ), 3))).
     1405           write-data-element ("qnty-ned", string-mth (round (fncmiss-qnty( buffer buf_doc-line ), 3))).
     1406           write-data-element ("qnty-eu", string-mth (round (0.0, 3))).
     1407           write-data-element ("sum-b", string-mth (round (fncbefore-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1408           write-data-element ("sum-a", string-mth (round (fncafter-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1409           write-data-element ("sum-izl", string-mth (round (fncextra-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1410           write-data-element ("sum-ned", string-mth (round (fncmiss-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1411           write-data-element ("sum-eu", string-mth (round ( fncwastage( buffer buf_doc-line, buffer buf_gds ), 2))).
     1412           write-data-element ("sum-b-s", string-mth (round (fncbefore-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1413           write-data-element ("sum-a-s", string-mth (round (fncafter-rubl( buffer buf_doc-line, buffer buf_gds ), 2))).
     1414           define variable vqnty as decimal no-undo.
     1415           run str/getost.p (buf_doc-line.obj-type,buf_doc-line.obj-code,buf_gds.gds-code, buf_doc-line.doc-code, output vqnty ).
     1416           write-data-element ("qnty-delta",string(round (buf_doc-line.doc-qnty - buf_doc-line.fact-qnty - vqnty, 3))).
     1417           if can-find (first bf_gen-attr no-lock where bf_gen-attr.table-name = "inv-doc-mark" and bf_gen-attr.attr-code = buf_trn-doc.doc-code
     1418             and bf_gen-attr.attr-value = string(buf_gds.gds-code) and not bf_gen-attr.p-key begins 'tech_':U)
     1419           then do:
     1420             sw:start-element ("marks").
     1421             for each bf_gen-attr no-lock where bf_gen-attr.table-name = "inv-doc-mark" and bf_gen-attr.attr-code = buf_trn-doc.doc-code
     1422               and bf_gen-attr.attr-value = string(buf_gds.gds-code) and not bf_gen-attr.p-key begins 'tech_':U:
     1423               sw:start-element ("mark").
     1424               write-data-element ("mark-code", repSpecSimbforXlm( addBracketForCode(bf_gen-attr.p-key))).
     1425               sw:end-element ("mark").
     1426             end.
     1427             sw:end-element ("marks").
     1428           end.
     1429           else
     1430           if available buf_doc-line-attr
     1431           and buf_doc-line-attr.attr-value > ""
     1432           then do :
     1433             sw:start-element ("marks").
     1434             GT_ :
     1435             do vGT = 1 to num-entries(buf_doc-line-attr.attr-value, ";") :
     1436               assign
     1437                 vGtin = entry(1, entry(vGT, buf_doc-line-attr.attr-value, ";"), "=")
     1438                 vGtinQnty = integer(entry(2, entry(vGT, buf_doc-line-attr.attr-value, ";"), "="))
     1439               no-error .
     1440               if error-status:error
     1441               then next GT_ .
     1442               sw:start-element ("mark").
     1443               write-data-element ("gtin", vGtin) .
     1444               write-data-element ("gtin-qnt", string-mth(vGtinQnty)) .
     1445               sw:end-element ("mark").
     1446             end .
     1447             sw:end-element ("marks").
     1448           end .
     1449         sw:end-element ("gd").
     1450       end.
     1451       sw:end-element ("gds").
     1452     end.
     1453     method private void GdsLineFuel ():
     1454       define variable dAddCliQnty       as decimal   no-undo .
     1455       define variable dAddQnty          as decimal   no-undo .
     1456       define variable v-sum-b           as decimal   no-undo .
     1457       define variable v-sum-a           as decimal   no-undo .
     1458       define variable v-sum-b-s         as decimal   no-undo .
     1459       define variable v-sum-a-s         as decimal   no-undo .
     1460       define variable v-sum-df          as decimal   no-undo .
     1461       find first bf_rvs-doc no-lock where
     1462                bf_rvs-doc.rvs-code = buf_trn-doc.out-code no-error .
     1463       sw:start-element ("gds").
     1464       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code:
     1465         find first buf_gds where
     1466               buf_gds.artic = buf_doc-line.artic
     1467           and buf_gds.prod-code = buf_doc-line.prod-code
     1468           and buf_gds.prod-type = buf_doc-line.prod-type.
     1469         for each buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_doc-line.obj-type and buf_doc-pl.obj-code = buf_doc-line.obj-code
     1470           and buf_doc-pl.out-code = buf_doc-line.doc-code and buf_doc-pl.gds-code = buf_gds.gds-code:
     1471           assign
     1472             dAddCliQnty = 0.0
     1473             dAddQnty = 0.0
     1474           .
     1475           find first bf_rvs-line no-lock where
     1476             available (bf_rvs-doc) and
     1477             bf_rvs-line.rvs-code = buf_trn-doc.out-code and
     1478             bf_rvs-line.obj-type = buf_doc-line.obj-type and
     1479             bf_rvs-line.obj-code = buf_doc-line.obj-code and
     1480             bf_rvs-line.gds-code = buf_doc-pl.gds-code and
     1481             bf_rvs-line.pl-code = buf_doc-pl.pl-code no-error.
     1482           if available (bf_rvs-line)
     1483           then
     1484             assign
     1485               dAddCliQnty   = bf_rvs-line.state-add-qnty * bf_rvs-line.state-density
     1486               dAddQnty  = bf_rvs-line.state-add-qnty.
     1487           assign
     1488             v-sum-b-s = fncbefore-rubl( buffer buf_doc-line, buffer buf_gds)
     1489             v-sum-a-s = fncafter-rubl( buffer buf_doc-line, buffer buf_gds)
     1490             v-sum-b = v-sum-b-s / (buf_doc-line.doc-qnty - buf_doc-line.fact-qnty) * buf_doc-pl.rest-bf-qnty
     1491             v-sum-a = v-sum-a-s / buf_doc-line.doc-qnty * buf_doc-pl.rest-af-qnty
     1492             v-sum-df = v-sum-a - v-sum-b
     1493           .
     1494           find first buf_units where buf_units.unit-name = buf_gds.unit-base.
     1495           sw:start-element ("gd").
     1496             write-data-element ("tank-num", string-mth (buf_doc-pl.pl-code)).
     1497             write-data-element ("gd-code", string-mth (buf_gds.gds-code)).
     1498             write-data-element ("cap-b", string-mth (round (buf_doc-pl.rest-bf-qnty, 3))).
     1499             write-data-element ("cap-a", string-mth (round (buf_doc-pl.rest-af-qnty, 3))).
     1500             write-data-element ("cap-df", string-mth (round (buf_doc-pl.rest-af-qnty - buf_doc-pl.rest-bf-qnty, 3))).
     1501             write-data-element ("wght-b", string-mth (round (buf_doc-pl.cli-rest-bf-qnty, 3))).
     1502             write-data-element ("wght-a", string-mth (round ( buf_doc-pl.cli-rest-af-qnty , 3))).
     1503             write-data-element ("wght-df", string-mth (round (buf_doc-pl.cli-fact-qnty, 3))).
     1504             write-data-element ("sum-b", string-mth (round
     1505                   (
     1506                     v-sum-b
     1507                   , 2))).
     1508             write-data-element ("sum-a", string-mth (round
     1509                   (
     1510                     v-sum-a
     1511                   , 2))).
     1512             write-data-element ("sum-df", string-mth (round
     1513                   (
     1514                     v-sum-df
     1515                   , 2))).
     1516             write-data-element ("wght-izl", string-mth (round ((if buf_doc-pl.cli-fact-qnty > 0 then buf_doc-pl.cli-fact-qnty else 0.0), 3))).
     1517             write-data-element ("wght-ned", string-mth (round ((if buf_doc-pl.cli-fact-qnty < 0 then absolute (buf_doc-pl.cli-fact-qnty) else 0.0), 3))).
     1518             write-data-element ("sum-izl", string-mth (round ((if v-sum-df > 0 then v-sum-df else 0.0), 2))).
     1519             write-data-element ("sum-ned", string-mth (round ((if v-sum-df < 0 then absolute (v-sum-df) else 0), 2))).
     1520   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   run bcodeprc in ibs.th.gbl.gbl-hndllib:g#library
     1522     (input  buf_trn-doc.obj-type
     1523     ,input  buf_trn-doc.obj-code
     1524     ,input  buf_gds.gds-code
     1525     ,input  0
     1526     ,input  buf_trn-doc.fact-order
     1527     ,output v-doc-num
     1528     ,output dprice-sale
     1529     ,output droad-tax
     1530     ,output dexcise
     1531     ) no-error .
     1532             if error-status :error
     1533             then do:
     1534               Msg = 'Не могу определить текущие продажные цены.'.
     1535               undo, return error Msg.
     1536             end.
     1537             assign
     1538               v-qnty-type = "cli":U
     1539             .
     1540             assign
     1541               dcurr-price = dprice-sale
     1542             .
     1543             assign
     1544               dLoss-qnty = 0.0
     1545             .
     1546             find first bf_doc-line-sum no-lock
     1547               where bf_doc-line-sum.doc-code  = buf_trn-doc.doc-code
     1548                 and bf_doc-line-sum.gds-code  = buf_gds.gds-code
     1549                 and bf_doc-line-sum.sum-type  = substitute( "&1&2&3&2&4", 'wst':U, chr(4), 'base', buf_doc-pl.pl-code )
     1550               no-error .
     1551             if available bf_doc-line-sum then do:
     1552               assign
     1553                 dLoss-qnty = bf_doc-line-sum.fact-qnty
     1554               .
     1555             end.
     1556             assign
     1557               dLoss-sum  = dLoss-qnty  * dcurr-price
     1558             .
     1559             assign
     1560               dLoss-qnty = 0.0
     1561             .
     1562             find first bf_doc-line-sum no-lock
     1563               where bf_doc-line-sum.doc-code  = buf_trn-doc.doc-code
     1564                 and bf_doc-line-sum.gds-code  = buf_gds.gds-code
     1565                 and bf_doc-line-sum.sum-type  = substitute( "&1&2&3&2&4", 'wst':U, chr(4), 'cli', buf_doc-pl.pl-code )
     1566               no-error .
     1567             if available bf_doc-line-sum then do:
     1568               assign
     1569                 dLoss-qnty = bf_doc-line-sum.fact-qnty
     1570               .
     1571             end.
     1572             write-data-element ("wght-eu", string-mth (round (dLoss-qnty, 2))).
     1573             write-data-element ("sum-eu", string-mth (round ( dLoss-sum, 2))).
     1574             write-data-element ("pipeline-cap", string-mth (round (dAddQnty, 2))).
     1575             write-data-element ("pipeline-wght", string-mth (round (dAddCliQnty, 2))).
     1576             rvsinvObj = new rvsinvsub ().
     1577             if available (bf_rvs-line)
     1578             then do:
     1579             assign
     1580               rvsinvObj:RvsCode = bf_rvs-line.rvs-code
     1581               rvsinvObj:ObjCode = buf_trn-doc.obj-code
     1582               rvsinvObj:ObjType = buf_trn-doc.obj-type
     1583               rvsinvObj:PlCode = bf_rvs-line.pl-code
     1584               rvsinvObj:GdsCode =  buf_gds.gds-code
     1585             .
     1586             end.
     1587             if rvsinvObj:RvsInvStrObj:FillSub(rvsinvObj)
     1588             then do:
     1589               write-data-element ("wght-tp-N", string-mth (round (rvsinvObj:TPNormal, 3))).
     1590               write-data-element ("wght-tp-F", string-mth (round (rvsinvObj:TPWast, 3))).
     1591             end.
     1592             else do:
     1593               write-data-element ("wght-tp-N", string-mth (round (0.0, 3))).
     1594               write-data-element ("wght-tp-F", string-mth (round (0.0, 3))).
     1595             end.
     1596           sw:end-element ("gd").
     1597         end.
     1598       end.
     1599       sw:end-element ("gds").
     1600     end.
     1601     method private void StartDocInv ():
     1602         InitSecTag =  "inv-gd-docs".
     1603         sw:start-element ("inv-gd-doc") .
     1604           write-data-element ("doc-code", buf_trn-doc.doc-code).
     1605           write-data-element ("doc-num", buf_trn-doc.doc-code).
     1606           write-data-element ("del-f", string (isDel, "1/0") ).
     1607           write-data-element ("doc-date", if buf_trn-doc.doc-date = ? then "" else iso-date (datetime (buf_trn-doc.doc-date, buf_trn-doc.real-time-create * 1000))).
     1608           write-data-element ("fact-date", if buf_trn-doc.fact-date = ? then "" else iso-date (datetime (buf_trn-doc.fact-date, buf_trn-doc.fact-time * 1000))).
     1609           write-data-element ("shift-date", if buf_trn-doc.shift-date = ? then "" else iso-date (date (buf_trn-doc.shift-date))).
