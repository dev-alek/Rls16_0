     1800     method private void write-data-element (inTag as char, inValue as char):
     1801       if inValue = ?
     1802       then do:
     1803         Msg = substitute ('Предупреждение отладки: тег &1 иммет неопределнное значение. Работа будет продолжена...', inTag).
     1804       end.
     1805       if inTag = ?
     1806       then do:
     1807         Msg = substitute ('Предупреждение отладки: Имя тега не может быть пустым...').
     1808         return.
     1809       end.
     1810       if inTag = "acc-ship"
     1811       then do:
     1812         if string (inValue) begins "."
     1813           then inValue = "0" + inValue.
     1814       end.
     1815       inTag = lc (InTag).
     1816       if inValue = ?
     1817         then sw:write-empty-element (inTag).
     1818         else sw:write-data-element (inTag, inValue).
     1819     end.
     1820     method private character string-mth (inValue as integer):
     1821       def var v-str as character no-undo.
     1822       if inValue = ?
     1823         then v-str = "0".
     1824         else v-str = string (inValue).
     1825       return v-str.
     1826     end.
     1827     method private character string-mth (inValue as decimal):
     1828       def var v-str as character no-undo.
     1829       if inValue = ?
     1830         then v-str = "0".
     1831       if string (inValue) begins "."
     1832         then v-str = "0" + string (inValue).
     1833         else v-str = string (inValue).
     1834       return v-str.
     1835     end.
     1836     method private decimal fncwastage ( buffer local-doc-line for ub.doc-line,
     1837                                           buffer local-goods for ub.goods ) :
     1838       define buffer bf_doc-line-sum      for ub.doc-line-sum.
     1839       define buffer bf-wst_doc-line-sum  for ub.doc-line-sum.
     1840       if varinvclcas = yes and
     1841          varinvclcwt = yes then do:
     1842         find first bf_doc-line-sum no-lock where
     1843                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1844                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1845                    bf_doc-line-sum.sum-type = 'gen':U.
     1846         find first bf-wst_doc-line-sum no-lock where
     1847                    bf-wst_doc-line-sum.doc-code = local-doc-line.doc-code and
     1848                    bf-wst_doc-line-sum.gds-code = local-goods.gds-code and
     1849                    bf-wst_doc-line-sum.sum-type = 'wst':U.
     1850         if bf_doc-line-sum.sale-sum-base < 0 then do:
     1851           if varr-b = "base" then do:
     1852             if bf-wst_doc-line-sum.sale-sum-base > - bf_doc-line-sum.sale-sum-base then do:
     1853               return - bf_doc-line-sum.sale-sum-base.
     1854             end.
     1855             else do:
     1856               return bf-wst_doc-line-sum.sale-sum-base.
     1857             end.
     1858           end.
     1859           else do:
     1860             if bf-wst_doc-line-sum.sale-sum-rubl > - bf_doc-line-sum.sale-sum-rubl then do:
     1861               return - bf_doc-line-sum.sale-sum-rubl.
     1862             end.
     1863             else do:
     1864               return bf-wst_doc-line-sum.sale-sum-rubl.
     1865             end.
     1866           end.
     1867         end.
     1868         else do:
     1869           return 0.00.
     1870         end.
     1871       end.
     1872       return 0.00.
     1873     end.
     1874     method private decimal fncextra-qnty ( buffer local-doc-line for ub.doc-line ) :
     1875       if local-doc-line.fact-qnty > 0 then do:
     1876         return local-doc-line.fact-qnty.
     1877       end.
     1878       else do:
     1879         return 0.00.
     1880       end.
     1881     end.
     1882     method private decimal fncmiss-qnty ( buffer local-doc-line for ub.doc-line ) :
     1883       if local-doc-line.fact-qnty < 0 then do:
     1884         return - local-doc-line.fact-qnty.
     1885       end.
     1886       else do:
     1887         return 0.00.
     1888       end.
     1889     end.
     1890     method private decimal fncextra-qntykg ( buffer local-doc-line for ub.doc-line ) :
     1891       if fncdiffqntykg( buffer buf_doc-line ) > 0 then do:
     1892         return local-doc-line.fact-qnty.
     1893       end.
     1894       else do:
     1895         return 0.00.
     1896       end.
     1897     end.
     1898     method private decimal fncmiss-qntykg ( buffer local-doc-line for ub.doc-line ) :
     1899       if fncdiffqntykg( buffer buf_doc-line ) < 0 then do:
     1900         return - local-doc-line.fact-qnty.
     1901       end.
     1902       else do:
     1903         return 0.00.
     1904       end.
     1905     end.
     1906     method private decimal fncbefore-sale-rubl ( buffer local-doc-line for ub.doc-line ,
     1907                                             buffer local-goods for ub.goods) :
     1908       define variable varreturn as decimal no-undo.
     1909       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1910       if varinvclcbef = yes then do:
     1911         find first bf_doc-line-sum no-lock where
     1912                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1913                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1914                    bf_doc-line-sum.sum-type = 'bd':U.
     1915         assign
     1916           varreturn = bf_doc-line-sum.sale-sum-rubl
     1917         .
     1918       end.
     1919       else do:
     1920         assign
     1921           varreturn = 0.00
     1922         .
     1923       end.
     1924       return varreturn.
     1925     end.
     1926     method private decimal fncafter-sale-rubl ( buffer local-doc-line for ub.doc-line,
     1927                                            buffer local-goods for ub.goods ) :
     1928       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1929       if varinvclcas = yes then do:
     1930         find first bf_doc-line-sum no-lock where
     1931                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1932                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1933                    bf_doc-line-sum.sum-type = 'ad':U.
     1934         return bf_doc-line-sum.sale-sum-rubl.
     1935       end.
     1936       else do:
     1937         return 0.00.
     1938       end.
     1939     end.
     1940     method private decimal fncbefore-rubl ( buffer local-doc-line for ub.doc-line ,
     1941                                             buffer local-goods for ub.goods) :
     1942       define variable varreturn as decimal no-undo.
     1943       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1944       if varinvclcbef = yes then do:
     1945         find first bf_doc-line-sum no-lock where
     1946                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1947                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1948                    bf_doc-line-sum.sum-type = 'bd':U.
     1949         assign
     1950           varreturn = bf_doc-line-sum.cost-sum-rubl - bf_doc-line-sum.cost-VAT-rubl
     1951         .
     1952       end.
     1953       else do:
     1954         assign
     1955           varreturn = 0.00
     1956         .
     1957       end.
     1958       return varreturn.
     1959     end.
     1960     method private decimal fncafter-rubl ( buffer local-doc-line for ub.doc-line,
     1961                                            buffer local-goods for ub.goods ) :
     1962       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1963       if varinvclcas = yes then do:
     1964         find first bf_doc-line-sum no-lock where
     1965                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1966                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1967                    bf_doc-line-sum.sum-type = 'ad':U.
     1968         return bf_doc-line-sum.cost-sum-rubl - bf_doc-line-sum.cost-VAT-rubl.
     1969       end.
     1970       else do:
     1971         return 0.00.
     1972       end.
     1973     end.
     1974     method private decimal fncextra-rubl ( buffer local-doc-line for ub.doc-line,
     1975                                            buffer local-goods for ub.goods ) :
     1976       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1977       if varinvclcas = yes then do:
     1978         find first bf_doc-line-sum no-lock where
     1979                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1980                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     1981                    bf_doc-line-sum.sum-type = 'gen':U.
     1982         if bf_doc-line-sum.cost-sum-rubl > 0 then do:
     1983           return bf_doc-line-sum.sale-sum-rubl.
     1984         end.
     1985         else do:
     1986           return 0.00.
     1987         end.
     1988       end.
     1989       else do:
     1990         return 0.00.
     1991       end.
     1992     end.
     1993     method private decimal fncmiss-rubl ( buffer local-doc-line for ub.doc-line,
     1994                                            buffer local-goods for ub.goods ) :
     1995       define buffer bf_doc-line-sum for ub.doc-line-sum.
     1996       if varinvclcas = yes then do:
     1997         find first bf_doc-line-sum no-lock where
     1998                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     1999                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     2000                    bf_doc-line-sum.sum-type = 'gen':U.
     2001         if bf_doc-line-sum.cost-sum-rubl < 0 then do:
     2002           return - bf_doc-line-sum.sale-sum-rubl.
     2003         end.
     2004         else do:
     2005           return 0.00.
     2006         end.
     2007       end.
     2008       else do:
     2009         return 0.00.
     2010       end.
     2011     end.
     2012     method private decimal fncdiff-rubl ( buffer local-doc-line for ub.doc-line,
     2013                                            buffer local-goods for ub.goods ) :
     2014       define buffer bf_doc-line-sum for ub.doc-line-sum.
     2015       if varinvclcas = yes then do:
     2016         find first bf_doc-line-sum no-lock where
     2017                    bf_doc-line-sum.doc-code = local-doc-line.doc-code and
     2018                    bf_doc-line-sum.gds-code = local-goods.gds-code and
     2019                    bf_doc-line-sum.sum-type = 'gen':U.
     2020         return bf_doc-line-sum.cost-sum-rubl.
     2021       end.
     2022       else do:
     2023         return 0.00.
     2024       end.
     2025     end.
     2026     method private decimal fncwasqntykg ( buffer local-doc-line for ub.doc-line ) :
     2027       define variable d_out-qnty-kg as decimal no-undo.
     2028       inv-line_qnty( input recid( local-doc-line ), input "was",  output d_out-qnty-kg ) no-error.
     2029       return ( if error-status :error then 0 else d_out-qnty-kg ).
     2030     end.
     2031     method private decimal fncareqntykg ( buffer local-doc-line for ub.doc-line ) :
     2032       define variable d_out-qnty-kg as decimal no-undo.
     2033       inv-line_qnty( input recid( local-doc-line ), input "are",  output d_out-qnty-kg ) no-error.
     2034       return ( if error-status :error then 0 else d_out-qnty-kg ).
     2035     end.
     2036     method private decimal fncdiffqntykg ( buffer local-doc-line for ub.doc-line ) :
     2037     define variable d_out-qnty-kg as decimal no-undo.
     2038     inv-line_qnty( input recid( local-doc-line ), input "diff", output d_out-qnty-kg ) no-error.
     2039       return ( if error-status :error then 0 else d_out-qnty-kg ).
     2040     end.
     2041     method private void inv-line_qnty ( p-doc-line-rec as recid,
     2042                                            p-mode as character,
     2043                                            output p-qnty-kg as decimal ) :
     2044       define buffer buf_doc-line for ub.doc-line.
     2045       define buffer buf_inv-line for ub.inv-line.
     2046       do on error undo, return error return-value :
     2047         find first buf_doc-line no-lock where
     2048             recid( buf_doc-line ) = p-doc-line-rec no-error.
     2049         if not available buf_doc-line then do:
     2050           assign
     2051             p-qnty-kg = 0.0
     2052           .
     2053           return.
     2054         end.
     2055         find first buf_inv-line no-lock where
     2056                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2057                    buf_inv-line.artic     = buf_doc-line.artic     and
     2058                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2059                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error.
     2060         if not available buf_inv-line then do:
     2061           assign
     2062             p-qnty-kg = 0.0
     2063           .
     2064           return.
     2065         end.
     2066         case p-mode :
     2067           when "was"  then do:
     2068             assign
     2069               p-qnty-kg = buf_inv-line.before-cli-qnty
     2070             .
     2071           end.
     2072           when "are"  then do:
     2073             assign
     2074               p-qnty-kg = buf_inv-line.wast-cli-qnty
     2075             .
     2076           end.
     2077           when "diff" then do:
     2078             assign
     2079               p-qnty-kg = buf_doc-line.cli-qnty
     2080             .
     2081           end.
     2082         end case.
     2083       end.
     2084     end.
     2085   end class.
