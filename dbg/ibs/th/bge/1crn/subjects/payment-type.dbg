        1   USING Progress.Lang.*.
        2   using System.Boolean from assembly.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.payment-type inherits ibs.th.bge.1crn.subjects.asubject:
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define property code_         as character    no-undo get. private set.
       11     define property del-l         as integer      no-undo get. private set.
       12     define property del-f         as integer      no-undo get. private set.
       13     define property name_         as character    no-undo get. private set.
       14     define property curr-code     as character    no-undo get. private set.
       15     define property ptg-code      as character    no-undo get. private set.
       16     define property pay-type_     as integer      no-undo get. private set.
       17     define override property InitTag as character no-undo init "payment-type"
       18       get.
       19     method override protected void SetPropProtected (inTag as char, inValue as char):
       20       case inTag:
       21         when "code" then do:
       22           assign code_ = inValue .
       23         end.
       24         when "del-l" then do:
       25           assign del-l = integer (inValue).
       26         end.
       27         when "del-f" then do:
       28           assign del-f = integer (inValue).
       29         end.
       30         when "name" then do:
       31           assign name_ = inValue .
       32         end.
       33         when "curr-code" then do:
       34           assign curr-code = inValue .
       35         end.
       36         when "ptg-code" then do:
       37           assign ptg-code = inValue .
       38         end.
       39         when "pay-type" then do:
       40           assign pay-type_ = integer(inValue) .
       41         end.
       42       end case.
       43     end.
       44     method override protected void CheckData ():
       45       def var v-str as char no-undo.
       46       assign
       47         v-str = "code" when code_ = ?
       48         v-str = v-str + ",name" when name_ = ?
       49         v-str = v-str + ",curr-code" when curr-code = ?
       50         v-str = v-str + ",ptg-code" when ptg-code = ?
       51       .
       52       v-str = trim (v-str, ",").
       53       if v-str > ''
       54       then
       55         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       56     end.
       57     method override protected void ClearSub():
       58       assign
       59         code_     = ?
       60         del-l     = ?
       61         del-f     = ?
       62         name_     = ?
       63         curr-code = ?
       64         ptg-code  = ?
       65         pay-type_ = ?
       66       .
       67     end.
       68   END CLASS.
