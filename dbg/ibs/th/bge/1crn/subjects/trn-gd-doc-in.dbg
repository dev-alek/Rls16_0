        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects from propath.
        3   using ibs.th.bge.1crn.subjects.trn-gd-doc from propath.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.subjects.trn-gd-doc-in inherits ibs.th.bge.1crn.subjects.asubject:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define property doc-code as character no-undo
       12       get.
       13       private set.
       14     define property doc-num as character no-undo
       15       get.
       16       private set.
       17     define property del-f as integer no-undo
       18       get.
       19       private set.
       20     define property doc-date as date no-undo
       21       get.
       22       private set.
       23     define property doc-type as character no-undo
       24       get.
       25       private set.
       26     define property shift-date as date no-undo
       27       get.
       28       private set.
       29     define property shift-num as integer no-undo
       30       get.
       31       private set.
       32     define property ttn-num as character no-undo
       33       get.
       34       private set.
       35     define property ttn-date as date no-undo
       36       get.
       37       private set.
       38     define property contr-code as character no-undo
       39       get.
       40       private set.
       41     define property dog-code as character no-undo
       42       get.
       43       private set.
       44     define property fuel-st-code as character no-undo
       45       get.
       46       private set.
       47     define property doc-id as character no-undo
       48       get.
       49       private set.
       50     define property GDS as subjects no-undo
       51       get.
       52       private set.
       53     define property prts as subjects no-undo
       54       get.
       55       private set.
       56     define override property InitTag as character no-undo init "trn-gd-doc"
       57       get.
       58     define property source-doc as character no-undo
       59       get.
       60       private set.
       61     constructor public trn-gd-doc-in ():
       62       InitListTag = "gds,prts".
       63     end constructor.
       64     method override protected void SetPropProtected(SubsObj as subjects):
       65       case SubsObj:InitTag:
       66         when "gds" then
       67           do:
       68             gds = SubsObj.
       69           end.
       70         when "prts" then
       71           do:
       72             prts = SubsObj.
       73           end.
       74       end case.
       75     end.
       76     method override protected void SetPropProtected (inTag as char, inValue as char):
       77       case inTag:
       78         when "doc-code" then do:
       79           assign doc-code = inValue.
       80         end.
       81         when "doc-num" then do:
       82           assign doc-num = inValue.
       83         end.
       84         when "del-f" then do:
       85           assign del-f = integer (inValue).
       86         end.
       87         when "doc-date" then do:
       88           assign doc-date = date-mth (inValue) .
       89         end.
       90         when "doc-type" then do:
       91           assign doc-type = inValue .
       92         end.
       93         when "shift-date" then do:
       94           assign shift-date = date-mth (inValue) .
       95         end.
       96         when "shift-num" then do:
       97           assign shift-num = integer (inValue) .
       98         end.
       99         when "ttn-num" then do:
      100           assign ttn-num = inValue .
      101         end.
      102         when "ttn-date" then do:
      103           assign ttn-date = date-mth (inValue) .
      104         end.
      105         when "contr-code" then do:
      106           assign contr-code = inValue .
      107         end.
      108         when "dog-code" then do:
      109           assign dog-code = inValue .
      110         end.
      111         when "fuel-st-code" then do:
      112           assign fuel-st-code = inValue .
      113         end.
      114         when "doc-id" then do:
      115           assign doc-id = inValue .
      116         end.
      117         when "source-doc" then do:
      118           assign source-doc = inValue .
      119         end.
      120       end case.
      121     end.
      122     method override protected void CheckData ():
      123       def var v-str as char no-undo.
      124       assign
      125         v-str = "doc-code" when doc-code = ?
      126         v-str = v-str + ",doc-type" when doc-type = ?
      127       .
      128       v-str = trim (v-str, ",").
      129       if v-str > ''
      130       then
      131         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      132     end.
      133     method override protected void ClearSub():
      134       assign
      135         doc-code     = ?
      136         doc-num      = ?
      137         del-f        = ?
      138         doc-date     = ?
      139         doc-type     = ?
      140         shift-date   = ?
      141         shift-num    = ?
      142         ttn-num      = ?
      143         ttn-date     = ?
      144         contr-code   = ?
      145         dog-code     = ?
      146         fuel-st-code = ?
      147         source-doc   = ?
      148       .
      149       delete object gds no-error.
      150       delete object prts no-error.
      151     end.
      152     method private date date-mth (inValue as character):
      153       inValue = entry (1, inValue, "T").
      154       return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
      155     end.
      156   end class.
