        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.payment-system inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property code_         as character    no-undo get. private set.
        9     define property name_         as character    no-undo get. private set.
       10     define property del-l         as integer      no-undo get. private set.
       11     define property del-f         as integer      no-undo get. private set.
       12     define public property validateCodeOnly as logical      no-undo get. set.
       13     define property bin-ranges            as ibs.th.bge.1crn.subjects.subjects no-undo
       14       get.
       15       private set.
       16     define property bins-tokens            as ibs.th.bge.1crn.subjects.subjects no-undo
       17       get.
       18       private set.
       19     define override property InitTag as character no-undo init "payment-system"
       20       get.
       21     constructor public payment-system ():
       22       InitListTag = "bin-ranges,bins-tokens".
       23     end constructor.
       24             method override protected void SetPropProtected (inTag as char, inValue as char):
       25       case inTag:
       26         when "code"         then code_        = if inValue >= "" then inValue else "" .
       27         when "name"         then name_        = if inValue >= "" then inValue else "" .
       28         when "del-l"        then del-l        = if inValue >= "" then integer (inValue) else 0 .
       29         when "del-f"        then del-f        = if inValue >= "" then integer (inValue) else 0 .
       30       end case.
       31       catch exProErrors as class Progress.Lang.ProError :
       32         case exProErrors:GetMessageNum(1):
       33           when 18207 then undo, throw new Progress.Lang.AppError(
       34             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       35           ) .
       36           otherwise undo, throw new Progress.Lang.AppError(
       37             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       38           ) .
       39         end case .
       40       end catch .
       41     end method.
       42     method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
       43       case SubsObj:InitTag:
       44         when "bin-ranges"   then bin-ranges   = SubsObj.
       45         when "bins-tokens"  then bins-tokens  = subsObj.
       46       end case.
       47     end method.
       48     method override protected void CheckData ():
       49       def var v-str as char no-undo.
       50       assign
       51         v-str =         ",code"           when code_          = ?
       52         v-str = v-str + ",name"           when name_          = ? and not validateCodeOnly
       53       .
       54       v-str = substring(v-str, 2).
       55       if v-str > "" then undo, throw new Progress.Lang.AppError(
       56         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       57       ) .
       58     end method.
       59     method override protected void ClearSub():
       60       assign
       61         code_           = ?
       62         name_           = ?
       63         del-l = ?
       64         del-f = ?
       65         validateCodeOnly = no
       66       .
       67       if valid-object(bin-ranges)        then delete object bin-ranges .
       68     end method.
       69   end class.
