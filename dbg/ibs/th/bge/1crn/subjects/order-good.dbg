        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.order-good inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-code   as integer no-undo
       10       get.
       11       private set.
       12     define property amount    as integer no-undo
       13       get.
       14       private set.
       15     define override property InitTag as character no-undo init "order-good"
       16       get.
       17     method override protected void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "gd-code" then
       20           gd-code = integer(inValue).
       21         when "amount" then
       22           amount  = integer(inValue) .
       23       end case.
       24     end.
       25     method override protected void CheckData ():
       26       def var v-str as char no-undo.
       27       assign
       28         v-str = "gd-code" when gd-code = ?
       29         v-str = v-str + ",amount" when amount = ?
       30       .
       31       v-str = trim (v-str, ",").
       32       if v-str > ''
       33       then
       34         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределенное значение", v-str)).
       35     end.
       36     method override protected void ClearSub():
       37       assign
       38         gd-code   = ?
       39         amount    = ?
       40       .
       41     end.
       42   end class.
