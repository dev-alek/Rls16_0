        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.price-doc_gds-sale inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gds-code      as character    no-undo get. private set.
       10     define property price-sale    as character    no-undo get. private set.
       11     define override property InitTag as character no-undo init "gds-sale"
       12       get.
       13     method override protected void SetPropProtected (inTag as char, inValue as char) :
       14        case inTag:
       15         when "gds-code" then
       16           do:
       17             assign
       18               gds-code = inValue .
       19           end.
       20         when "price-sale" then
       21           do:
       22             assign
       23               price-sale = inValue.
       24           end.
       25       end case.
       26     end method.
       27     method override protected void CheckData ():
       28       def var v-str as char no-undo.
       29       assign
       30         v-str = "gds-code" when gds-code = ?
       31         v-str = v-str + ",price-sale" when price-sale = ?
       32       .
       33       v-str = trim (v-str, ",").
       34       if v-str > ''
       35       then
       36         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
       37     end method .
       38     method override protected void ClearSub():
       39       assign
       40           gds-code = ?
       41           price-sale = ?
       42       .
       43     end method .
       44   end class.
