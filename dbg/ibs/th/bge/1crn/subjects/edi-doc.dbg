        1   block-level on error undo, throw.
        2   class ibs.th.bge.1crn.subjects.edi-doc inherits ibs.th.bge.1crn.subjects.asubject:
        3     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        4     define override public property vss-author      as character no-undo init "$Author:$":U get.
        5     define override public property vss-date        as character no-undo init "$Date:$":U get.
        6     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        7     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        8     define property edoc-id         as character    no-undo get. private set.
        9     define property edoc-num        as character    no-undo get. private set.
       10     define property edoc-date       as date         no-undo get. private set.
       11     define property edoc-type       as character    no-undo get. private set.
       12     define property edoc-stts       as character    no-undo get. private set.
       13     define property contr-code      as character    no-undo get. private set.
       14     define property dog-code        as integer      no-undo get. private set.
       15     define property orig-edoc-id    as character    no-undo get. private set.
       16     define property sum             as decimal      no-undo get. private set.
       17     define property sum-nonds       as decimal      no-undo get. private set.
       18     define property order-item      as character    no-undo get. private set.
       19     define property comment         as character    no-undo get. private set.
       20     define property del-l         as integer      no-undo get. private set.
       21     define property del-f         as integer      no-undo get. private set.
       22     define property obj-load        as character    no-undo get.
       23     set(arg as char):
       24        obj-load = arg.
       25        this-object:InitTag = arg.
       26     end.
       27     define property gds            as ibs.th.bge.1crn.subjects.subjects no-undo
       28       get.
       29       private set.
       30     define override property InitTag as character no-undo init "edi-doc"
       31         get.
       32         private set.
       33     constructor public edi-doc ():
       34       InitListTag = "gds".
       35     end constructor.
       36     method private date date-mth (inValue as character):
       37       inValue = entry (1, inValue, "T").
       38       return date (integer (entry (2, Invalue, "-")), integer (entry (3, Invalue, "-")), integer (entry (1, Invalue, "-")) ).
       39     end.
       40             method override protected void SetPropProtected (inTag as char, inValue as char):
       41       case inTag:
       42         when "edoc-id"      then edoc-id         = if inValue >= "" then inValue else "" .
       43         when "edoc-num"     then edoc-num         = if inValue >= "" then inValue else "" .
       44         when "del-l"        then del-l            = if inValue >= "" then integer (inValue) else 0 .
       45         when "del-f"        then del-f            = if inValue >= "" then integer (inValue) else 0 .
       46         when "edoc-date"    then edoc-date        = if inValue >= "" then date-mth (inValue) else ? .
       47         when "edoc-type"    then edoc-type        = if inValue >= "" then inValue else "" .
       48         when "edoc-stts"    then edoc-stts        = if inValue >= "" then inValue else "" .
       49         when "contr-code"   then contr-code       = if inValue >= "" then inValue else "" .
       50         when "dog-code"     then dog-code         = if inValue >= "" then integer (inValue) else 0 .
       51         when "orig-edoc-id" then orig-edoc-id     = if inValue >= "" then inValue else "" .
       52         when "comment"      then comment          = if inValue >= "" then inValue else "" .
       53         when "sum"          then sum              = if inValue >= "" then decimal (inValue) else 0.0 .
       54         when "sum-nonds"    then sum-nonds        = if inValue >= "" then decimal (inValue) else 0.0 .
       55         when "order-item-external" then order-item = if inValue >= "" then inValue else "" .
       56       end case.
       57       catch exProErrors as class Progress.Lang.ProError :
       58         case exProErrors:GetMessageNum(1):
       59           when 18207 then undo, throw new Progress.Lang.AppError(
       60             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       61           ) .
       62           otherwise undo, throw new Progress.Lang.AppError(
       63             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       64           ) .
       65         end case .
       66       end catch .
       67     end method.
       68     method override protected void SetPropProtected (SubsObj as ibs.th.bge.1crn.subjects.subjects):
       69       case SubsObj:InitTag:
       70         when "gds"     then gds   = SubsObj.
       71       end case.
       72     end method.
       73     method override protected void CheckData ():
       74       def var v-str as char no-undo.
       75       assign
       76         v-str =         ",edoc-id"            when edoc-id           = ?
       77         v-str =         ",edoc-num"           when edoc-num          = ? and obj-load = "edi-doc"
       78         v-str = v-str + ",edoc-date"          when edoc-date         = ? and obj-load = "edi-doc"
       79         v-str = v-str + ",edoc-type"          when edoc-type         = ? and obj-load = "edi-doc"
       80         v-str = v-str + ",edoc-stts"          when edoc-stts         = ?
       81         v-str = v-str + ",del-f"              when edoc-stts         = ? and obj-load = "edi-doc"
       82       .
       83       v-str = substring(v-str, 2).
       84       if v-str > "" then undo, throw new Progress.Lang.AppError(
       85         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       86       ) .
       87     end method.
       88     method override protected void ClearSub():
       89       assign
       90         edoc-id           = ?
       91         edoc-num           = ?
       92         del-l              = ?
       93         del-f              = ?
       94         edoc-date          = ?
       95         edoc-type          = ?
       96         edoc-stts          = ?
       97         contr-code         = ?
       98         dog-code           = ?
       99         orig-edoc-id       = ?
      100         comment            = ?
      101         sum                = ?
      102         sum-nonds          = ?
      103         order-item         = ?
      104       .
      105       if valid-object(gds)          then delete object gds .
      106     end method.
      107   end class.
