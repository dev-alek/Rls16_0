        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   class ibs.th.bge.1crn.subjects.promotion_gds-gd inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property gd-code  as character  no-undo get. private set. // 1-1 Объект акции  Код товара
       10     define property gd-price as decimal    no-undo get. private set. // 0-1 Цена товара Используется в акциях с фиксированной ценой
       11     define property promotion-code as character no-undo get. private set. // 0-1 Акционный код
       12     define override property InitTag as character no-undo init "gd"
       13       get.
       14             method override protected void SetPropProtected (inTag as char, inValue as char):
       15       case inTag:
       16         when "gd-code"  then gd-code  = if inValue >= "" then inValue else "" .
       17         when "gd-price" then gd-price = if inValue >= "" then decimal (inValue) else 0.0 .
       18         when "promotion-code" then promotion-code = if inValue >= "" then inValue else "" .
       19       end case.
       20       catch exProErrors as class Progress.Lang.ProError :
       21         case exProErrors:GetMessageNum(1):
       22           when 18207 then undo, throw new Progress.Lang.AppError(
       23             substitute("Поле <&1> содержит ошибочное значение [&2]", inTag, inValue)
       24           ) .
       25           otherwise undo, throw new Progress.Lang.AppError(
       26             substitute("Ошибка значения для поля <&1>: &2", inTag, exProErrors:GetMessage(1))
       27           ) .
       28         end case .
       29       end catch .
       30     end method.
       31     method override protected void CheckData ():
       32       def var v-str as char no-undo.
       33       assign
       34         v-str = ",gd-code" when gd-code = ?
       35       .
       36       v-str = substring(v-str, 2).
       37       if v-str > "" then undo, throw new Progress.Lang.AppError(
       38         substitute("Теги [&1] отсутствуют в сообщении [&2]", v-str, InitTag)
       39       ) .
       40     end method .
       41     method override protected void ClearSub():
       42       assign
       43         gd-code  = ?
       44         gd-price = ?
       45         promotion-code = ?
       46       .
       47     end method .
       48   end class.
