        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.contracts inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property code_       as character    no-undo get.
       10       private set.
       11     define property del-l       as integer      no-undo get.
       12       private set.
       13     define property del-f       as integer      no-undo get.
       14       private set.
       15     define property status_     as integer    no-undo get.
       16       private set.
       17     define property org-code    as character    no-undo get.
       18       private set.
       19     define property contr-code  as character    no-undo get.
       20       private set.
       21     define property date-srt    as character    no-undo get.
       22       private set.
       23     define property date-end    as character    no-undo get.
       24       private set.
       25     define property number      as character    no-undo get.
       26       private set.
       27     define property date_       as character    no-undo get.
       28       private set.
       29     define property code-SCVD   as character    no-undo get.
       30       private set.
       31     define property edi_        as integer      no-undo get.
       32       private set.
       33     define property edi-orders   as integer    no-undo
       34       get.
       35       private set.
       36     define property return-code as integer      no-undo get.
       37       private set.
       38     define override property InitTag as character no-undo init "contract"
       39       get.
       40     method OVERRIDE PROTECTED void SetPropProtected (inTag as char, inValue as char):
       41       case inTag:
       42         when "code" then
       43           do:
       44             assign
       45               code_ = inValue .
       46           end.
       47         when "del-l" then
       48           do:
       49             assign
       50               del-l = integer (inValue).
       51           end.
       52         when "del-f" then
       53           do:
       54             assign
       55               del-f = integer (inValue).
       56           end.
       57         when "status" then
       58           do:
       59             assign
       60               status_ = integer (inValue) .
       61           end.
       62         when "org-code" then
       63           do:
       64             assign
       65               org-code = inValue .
       66           end.
       67         when "contr-code" then
       68           do:
       69             assign
       70               contr-code = inValue .
       71           end.
       72         when "date-srt" then
       73           do:
       74             assign
       75               date-srt = inValue .
       76           end.
       77         when "date-end" then
       78           do:
       79             assign
       80               date-end = inValue .
       81           end.
       82         when "number" then
       83           do:
       84             assign
       85               number = inValue .
       86           end.
       87         when "date" then
       88           do:
       89             assign
       90               date_ = inValue .
       91           end.
       92         when "code-SCVD" then
       93           do:
       94             assign
       95               code-SCVD = inValue .
       96           end.
       97         when "edi" then
       98           do:
       99             assign
      100               edi_ = integer(inValue) .
      101           end.
      102         when "edi-orders"  then
      103           edi-orders    = if inValue >= "" then int(inValue) else 0 .
      104         when "return-code" then
      105           do:
      106             assign
      107               return-code = integer(inValue) .
      108           end.
      109       end case.
      110     end.
      111     method override protected void CheckData ():
      112       def var v-str as char no-undo.
      113       assign
      114         v-str = "code"
      115         when code_ = ?
      116         v-str = v-str + ",org-code"
      117         when org-code = ?
      118         v-str = v-str + ",contr-code"
      119         when contr-code = ?
      120         v-str = v-str + ",date"
      121         when date_ = ?
      122         .
      123       v-str = trim (v-str, ",").
      124       if v-str > ''
      125         then
      126         undo, throw new Progress.Lang.AppError( substitute ("“еги &1 не могут иметь неопределное значение", v-str)).
      127     end.
      128     method override protected void ClearSub():
      129       assign
      130         code_      = ?
      131         del-l      = ?
      132         del-f      = ?
      133         status_    = ?
      134         org-code   = ?
      135         contr-code = ?
      136         date-srt   = ?
      137         date-end   = ?
      138         number     = ?
      139         date_      = ?
      140         code-SCVD  = ?
      141         edi_       = ?
      142         edi-orders = ?
      143         return-code = ?
      144         .
      145     end.
      146   end class.
