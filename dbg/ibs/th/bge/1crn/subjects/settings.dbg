        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.1crn.subjects.settings inherits ibs.th.bge.1crn.subjects.asubject:
        4     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5     define override public property vss-author      as character no-undo init "$Author:$":U get.
        6     define override public property vss-date        as character no-undo init "$Date:$":U get.
        7     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9     define property org-code as character no-undo
       10       get.
       11       private set.
       12     define property MaxApiToken as character no-undo
       13       get.
       14       private set.
       15     define override property InitTag as character no-undo init "setting"
       16       get.
       17     method override protected void SetPropProtected (inTag as char, inValue as char):
       18       case inTag:
       19         when "org-code"    then org-code    = if inValue >= "" then inValue else "" .
       20         when "MaxApiToken" then MaxApiToken = if inValue >= "" then inValue else "" .
       21       end case.
       22     end method.
       23     method override protected void CheckData ():
       24     end method.
       25     method override protected void ClearSub():
       26       assign
       27         org-code    = ?
       28         MaxApiToken = ?
       29       .
       30     end method.
       31   end class.
