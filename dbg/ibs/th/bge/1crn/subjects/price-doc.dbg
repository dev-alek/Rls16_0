        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.subjects.price-doc implements iexpsubject:
        5     define buffer buf_price-doc for ub.price-doc .
        6     define buffer buf_price-list for ub.price-list .
        7     define buffer buf_bar-code for ub.bar-code .
        8     define property Msg as character no-undo
        9       get.
       10       private set.
       11     define property InitSecTag as character no-undo init "price-docs"
       12       get.
       13       private set.
       14     define public property sendTableName as character no-undo init "price-doc"
       15       get.
       16     define public property sendOldRowid as rowid  no-undo
       17       get.
       18       set.
       19     define public property sendNewRowid as rowid  no-undo
       20       get.
       21       set.
       22     define property DocNum as character no-undo
       23       get.
       24       set.
       25     define property ToDel as logical no-undo
       26       get.
       27       set.
       28     define property pr-doc-hndl as handle no-undo
       29       get.
       30       set.
       31     define variable sw               as handle    no-undo.
       32     method public void CrContentToSW (insw as handle):
       33       sendOldRowid  = pr-doc-hndl:rowid.
       34       sw = insw .
       35       if ToDel
       36       then do :
       37             sw:start-element ("price-doc") .
       38             if pr-doc-hndl::uid-es <> ? and string(pr-doc-hndl::uid-es) <> ""
       39             then
       40               sw:write-data-element ("doc-id", string(pr-doc-hndl::uid-es)).
       41             if pr-doc-hndl::doc-num-es <> ? and string(pr-doc-hndl::doc-num-es) <> ""
       42             then
       43               sw:write-data-element ("doc-num", string(pr-doc-hndl::doc-num-es)).
       44               sw:write-data-element ("doc-code", string(pr-doc-hndl::doc-num)).
       45               sw:write-data-element ("doc-num-gs", string(pr-doc-hndl::doc-num)).
       46               sw:write-data-element ("doc-date", if pr-doc-hndl::doc-date = ? then "" else iso-date(pr-doc-hndl::doc-date) ).
       47               sw:write-data-element ("doc-status", "4").
       48               sw:write-data-element ("status-date", (iso-date(TODAY) + "T" + string(TIME, "HH:MM:SS") ) ).
       49             sw:end-element ("price-doc") .
       50       end.
       51       else do :
       52           find first buf_price-doc no-lock where buf_price-doc.doc-num = DocNum no-error.
       53           if not available (buf_price-doc)
       54             then return.
       55             sw:start-element ("price-doc") .
       56             if buf_price-doc.uid-es <> ? and buf_price-doc.uid-es <> ""
       57             then
       58               sw:write-data-element ("doc-id", buf_price-doc.uid-es).
       59             if buf_price-doc.doc-num-es <> ? and buf_price-doc.doc-num-es <> ""
       60             then
       61               sw:write-data-element ("doc-num", buf_price-doc.doc-num-es).
       62               sw:write-data-element ("doc-code", buf_price-doc.doc-num).
       63               sw:write-data-element ("doc-num-gs", buf_price-doc.doc-num).
       64               sw:write-data-element ("doc-date", if buf_price-doc.doc-date = ? then "" else iso-date(buf_price-doc.doc-date) ).
       65             if buf_price-doc.status_ = 'приказ':U
       66             then do :
       67               sw:write-data-element ("doc-status", "2").
       68               sw:write-data-element ("status-date", (iso-date(TODAY) + "T" + string(TIME, "HH:MM:SS") ) ).
       69             end.
       70             if buf_price-doc.status_ = 'акт':U
       71             then do :
       72               sw:write-data-element ("doc-status", "3").
       73               sw:write-data-element ("status-date", (iso-date(buf_price-doc.fact-date) + "T" + string(buf_price-doc.fact-time, "HH:MM:SS") ) ).
       74             end.
       75             if   (buf_price-doc.doc-num-es = ? or trim(buf_price-doc.doc-num-es) = "")
       76             and  (buf_price-doc.uid-es = ? or trim(buf_price-doc.uid-es) = "")
       77             then do :
       78               sw:write-data-element ("cr-gs", string(1)).
       79             end.
       80             else do :
       81               sw:write-data-element ("cr-gs", string(0)).
       82             end.
       83             if   (buf_price-doc.doc-num-es = ? or trim(buf_price-doc.doc-num-es) = "")
       84             and  (buf_price-doc.uid-es = ? or trim(buf_price-doc.uid-es) = "")
       85             or buf_price-doc.status_ = 'акт':U
       86             then do :
       87               sw:start-element ("price-list") .
       88               for each buf_price-list no-lock where buf_price-list.doc-num = buf_price-doc.doc-num
       89                                                 and buf_price-list.price-type = '',
       90                 first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-list.b-code :
       91                 sw:start-element ("gds-sale") .
       92                   sw:write-data-element ("gds-code", string(buf_bar-code.gds-code)).
       93                   sw:write-data-element ("price-sale", string(buf_price-list.price-sale)).
       94                   if buf_price-list.price-prev <> ?
       95                   then sw:write-data-element ("price-sale-old", string(buf_price-list.price-prev)).
       96                   if buf_price-list.doc-qnty <> ?
       97                   then sw:write-data-element ("qnty", string(buf_price-list.doc-qnty)).
       98                 sw:end-element ("gds-sale")  .
       99               end.
      100               sw:end-element ("price-list") .
      101             end.
      102             sw:end-element ("price-doc") .
      103       end.
      104     end.
      105   end class.
