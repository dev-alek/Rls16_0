        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.gbl.*.
        4   USING ibs.th.trg.newbcod from propath.
        5   USING ibs.th.gbl.curdburt from propath.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.1crn.import.impcontracts implements ibs.th.bge.1crn.import.iimpsubject:
        8     define variable newbcod1 as class newbcod  no-undo .
        9     define variable curdburt as class curdburt no-undo .
       10     define property Msg as character no-undo
       11       get.
       12       set.
       13     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       14       define variable ri     as recid   no-undo .
       15       define variable f-code as integer no-undo .
       16       define buffer b_contract for ub.contract .
       17       define variable p-sys-date     as date      no-undo .
       18       define variable p-sys-time     as character no-undo .
       19       define variable p-sys-time-int as integer   no-undo .
       20       define variable v-cli-code     as integer   no-undo .
       21       define variable v-cli-name     as character no-undo .
       22       define variable v-status       as character no-undo .
       23       define variable v-curr-code    as integer   no-undo .
       24       define variable objContracts   as class     contracts no-undo.
       25       define variable v-user-db-num  as integer   no-undo .
       26       define variable v-user-name    as character no-undo .
       27       objContracts = cast (subjectObj, contracts).
       28       if objContracts:date-srt <> ? and objContracts:date-end <> ? and objContracts:date_ <> ? and objContracts:date-srt <> "0001-01-01" then
       29       do:
       30         if objContracts:date_ > objContracts:date-srt then
       31         do:
       32           Msg = "Договор с кодом " + objContracts:code_ + " . Дата контракта позже даты начала действия!" .
       33           return error.
       34         end.
       35         else
       36         do:
       37           if objContracts:date-srt > objContracts:date-end and objContracts:date-end <> "0001-01-01" then
       38           do:
       39             Msg ="Договор с кодом " + objContracts:code_ +  " . Дата начала действия позже даты окончания действия!" .
       40             return error.
       41           end.
       42         end.
       43       end.
       44       if objContracts:contr-code = "" or objContracts:contr-code = ? then
       45       do:
       46         Msg = "Договор с кодом " + objContracts:code_ + " . Не задан контрагент".
       47         return error.
       48       end.
       49       if objContracts:org-code = "" or objContracts:org-code = ? then
       50       do:
       51         Msg = "Договор с кодом " + objContracts:code_ + " . Не задана организация" .
       52         return error Msg.
       53       end.
       54       find first ub.clients no-lock where ub.clients.obj-code = integer(objContracts:org-code)
       55         and ub.clients.obj-type = 'орг':U no-error .
       56       if not AVAILABLE ub.clients then
       57       do:
       58         Msg = "Договор с кодом " + objContracts:code_ + " . Нет такой организации - " + objContracts:org-code .
       59         return error Msg.
       60       end.
       61       find first ub.clients no-lock where ub.clients.obj-code = integer(objContracts:contr-code)
       62         and ub.clients.obj-type = 'орг':U no-error .
       63       if AVAILABLE ub.clients then
       64       do:
       65         assign
       66           v-cli-code = ub.clients.obj-code
       67           v-cli-name = ub.clients.obj-name
       68           .
       69       end.
       70       else
       71       do:
       72         Msg = "Договор с кодом " + objContracts:code_ + " . Нет такого контрагента - " + objContracts:contr-code .
       73         return error Msg.
       74       end.
       75       find first ub.contract EXCLUSIVE-LOCK
       76         where ub.contract.contract-code = integer(objContracts:code_)
       77         and ub.contract.host-code         = integer(objContracts:org-code)
       78         and ub.contract.contract-type     = 'Купли-продажи':U
       79         no-error .
       80       if AVAILABLE ub.contract then
       81       do:
       82         assign
       83           v-cli-code  = ub.contract.cli-code
       84           v-cli-name  = ub.contract.cli-name
       85           v-curr-code = ub.contract.curr-code
       86           .
       87       end.
       88       else
       89       do:
       90         create ub.contract .
       91         assign
       92           ub.contract.host-code         = integer(objContracts:org-code)
       93           ub.contract.contract-type     = 'Купли-продажи':U
       94           ub.contract.db-num            = gbl-var:g#db-num
       95           ub.contract.user-db-num       = gbl-var:g#db-num
       96           ub.contract.usl-opl           = 'Не определено':U
       97           ub.contract.contract-code     = integer(objContracts:code_)
       98           .
       99         find first ub.sysconf no-lock where ub.sysconf.host-code = integer(objContracts:org-code) no-error.
      100         if AVAILABLE ub.sysconf then
      101         do:
      102           v-curr-code = ub.sysconf.base-code .
      103         end.
      104         else
      105         do:
      106           Msg = "Договор с кодом " + objContracts:code_ + " . Не найдены системные настройки для фирмы с кодом: " + objContracts:org-code .
      107           find first ub.currency no-lock no-error.
      108           if AVAILABLE ub.currency then
      109           do:
      110             v-curr-code = ub.currency.curr-code .
      111           end.
      112           else
      113           do:
      114             Msg = "Договор с кодом " + objContracts:code_ + " . Не найден справочник видов оплат".
      115             return error .
      116           end.
      117         end.
      118       end.
      119       assign
      120         ub.contract.contract-prn-code = objContracts:number
      121         ub.contract.doc-type          = 'при':U
      122         ub.contract.status_           = if objContracts:status_ = 1 then 'тек':U else 'зкр':U
      123         ub.contract.curr-code         = v-curr-code
      124         ub.contract.own-name          = 'фирма':U
      125         ub.contract.cli-type          = 'орг':U
      126         ub.contract.cli-code          = v-cli-code
      127         ub.contract.cli-name          = v-cli-name
      128         ub.contract.contract-date     = if objContracts:date_ = "0001-01-01" then today else date(date-1C(objContracts:date_))
      129         ub.contract.contract-date-beg = if objContracts:date-srt = "0001-01-01" then ? else date(date-1C(objContracts:date-srt))
      130         ub.contract.contract-date-end = if objContracts:date-end = "0001-01-01" then ? else date(date-1C(objContracts:date-end))
      131         ub.contract.spec-check = if objContracts:return-code = ? then 0 else objContracts:return-code
      132       .
      133       find first ub.contract-attr exclusive-lock where ub.contract-attr.host-code = ub.contract.host-code and
      134         ub.contract-attr.contract-code = ub.contract.contract-code and
      135         ub.contract-attr.attr-code = "contract-edi"  no-error .
      136       if not available (ub.contract-attr) then
      137       do:
      138         create ub.contract-attr .
      139         assign
      140           ub.contract-attr.host-code     = ub.contract.host-code
      141           ub.contract-attr.contract-code = ub.contract.contract-code
      142           ub.contract-attr.attr-code     = "contract-edi"
      143           .
      144       end.
      145       ub.contract-attr.attr-value = string(if objContracts:edi_ = 1 then "yes" else "no") .
      146       find first ub.contract-attr exclusive-lock where ub.contract-attr.host-code = ub.contract.host-code and
      147         ub.contract-attr.contract-code = ub.contract.contract-code and
      148         ub.contract-attr.attr-code = "contract-diadoc"  no-error .
      149       if not available (ub.contract-attr) then
      150       do:
      151         create ub.contract-attr .
      152         assign
      153           ub.contract-attr.host-code     = ub.contract.host-code
      154           ub.contract-attr.contract-code = ub.contract.contract-code
      155           ub.contract-attr.attr-code     = "contract-diadoc"
      156           .
      157       end.
      158       ub.contract-attr.attr-value = string(if objContracts:edi_ = 2 then "yes" else "no") .
      159       find first ub.contract-attr exclusive-lock where ub.contract-attr.host-code = ub.contract.host-code and
      160         ub.contract-attr.contract-code = ub.contract.contract-code and
      161         ub.contract-attr.attr-code = "contract-edi_orders"  no-error .
      162       if not available (ub.contract-attr) then
      163       do:
      164         create ub.contract-attr .
      165         assign
      166           ub.contract-attr.host-code     = ub.contract.host-code
      167           ub.contract-attr.contract-code = ub.contract.contract-code
      168           ub.contract-attr.attr-code     = "contract-edi_orders"
      169           .
      170       end.
      171       ub.contract-attr.attr-value = string(if objContracts:edi-orders = 1 then "yes" else "no") .
      172     end method.
      173     method private character date-1C (inValue as character):
      174       def var v-str as character no-undo.
      175       if inValue = "0001-01-01" then v-str = ? .
      176       else v-str = entry (3, string(inValue), "-") + "/" + entry (2, string(inValue), "-") + "/" + entry (1, string(inValue), "-") .
      177       return v-str.
      178     end.
      179   end class.
