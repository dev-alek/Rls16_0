        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impfuelcodeinfo implements ibs.th.bge.1crn.import.iimpsubject:
        6      define buffer buf_code       for ub.code .
        7      define property Msg as character no-undo
        8         get.
        9         set.
       10      method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11         define variable ri              as recid no-undo .
       12         define variable objfuelcodeinfo as class fuelcodeinfo no-undo.
       13         objFuelCodeInfo = cast (subjectObj, fuelcodeinfo).
       14         find first buf_code exclusive-lock where
       15                    buf_code.parent = "FuelCodeInfo"
       16                and buf_code.code = string(integer(objfuelcodeinfo:IntCode))
       17              no-error .
       18         if    objfuelcodeinfo:del-f = 0
       19            or objfuelcodeinfo:del-f = ? then
       20         do:
       21             if not avail buf_code then
       22             do:
       23                 create buf_code.
       24                 assign
       25                   buf_code.parent  = "FuelCodeInfo"
       26                   buf_code.code    = string(integer(objfuelcodeinfo:IntCode))
       27                   buf_code.status_ = 0
       28                 .
       29             end.
       30             buf_code.CodeValue  = string(integer(objfuelcodeinfo:ExtCode)).
       31         end.
       32         else
       33         do:
       34           if avail buf_code then
       35               delete buf_code.
       36         end.
       37      end method.
       38   end class.
