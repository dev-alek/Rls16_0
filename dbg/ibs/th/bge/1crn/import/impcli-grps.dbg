        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impcli-grps implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9       define variable objImp       as class cli-grps no-undo.
       10       define variable v-mode       as character no-undo.
       11       define variable v-doc-rec    as recid no-undo.
       12       define variable v-node-code  as integer no-undo .
       13       define variable v-upper-code as integer no-undo .
       14       define variable v-retfl      as logical no-undo .
       15       define buffer buf_cli-grp for ub.cli-grp .
       16       objImp = cast (subjectObj, cli-grps).
       17       assign
       18         v-node-code  = integer(objImp:code_)
       19         v-upper-code = integer(objImp:upper-code)
       20         Msg = ""
       21       .
       22       if objImp:del-f > 0 then do:
       23         run ref/cligrp03.p ( input v-node-code ) .
       24         v-retfl = true .
       25       end .
       26       else if objImp:del-l > 0 then do:
       27         run ref/cligrp01.p
       28         (input 'ИЗМЕНЕНИЕ':U
       29         ,input true
       30         ,input true
       31         ,input-output v-node-code
       32         ,input-output v-upper-code
       33         ,input "УДАЛЕНО " + objImp:name_
       34         ,output v-doc-rec
       35         ) .
       36         v-retfl = true .
       37       end.
       38       else do:
       39         assign
       40            v-mode   = if can-find (first buf_cli-grp where buf_cli-grp.node-code = v-node-code) then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U
       41         .
       42         run ref/cligrp01.p
       43         (input v-mode
       44         ,input true
       45         ,input true
       46         ,input-output v-node-code
       47         ,input-output v-upper-code
       48         ,input objImp:name_
       49         ,output v-doc-rec
       50         ) .
       51         v-retfl = true .
       52       end .
       53       catch exAppErrors as class Progress.Lang.AppError :
       54         Msg = exAppErrors:ReturnValue .
       55         if Msg > "" then . else do :
       56           Msg = exAppErrors:GetMessage(1) .
       57           if Msg > "" then . else Msg = "AppError в группах клиентов" .
       58         end .
       59         v-retfl = false .
       60         undo, throw exAppErrors .
       61       end catch .
       62       catch exProErrors as class Progress.Lang.ProError :
       63         Msg = exProErrors:GetMessage(1) .
       64         if Msg > "" then . else Msg = "ProError в группах клиентов" .
       65         v-retfl = false .
       66         undo, throw exProErrors .
       67       end catch .
       68       catch exAnyErrors as class Progress.Lang.Error:
       69         Msg = "Unexpected error в группах клиентов" .
       70         v-retfl = false .
       71         undo, throw exAnyErrors .
       72       end catch .
       73       finally :
       74         return v-retfl .
       75       end finally .
       76     end method.
       77   end class.
