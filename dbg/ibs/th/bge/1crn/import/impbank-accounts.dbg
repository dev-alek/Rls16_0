        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.trg.newbcod from propath.
        4   USING ibs.th.gbl.curdburt from propath.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.impbank-accounts implements ibs.th.bge.1crn.import.iimpsubject:
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable ri as recid no-undo .
       12       define buffer buf_fin-bank    for ub.fin-bank .
       13       define buffer buf_fin-schet   for ub.fin-schet .
       14       define buffer X_schet-clients for ub.clients .
       15       DEFINE BUFFER X_currency      FOR ub.currency.
       16       define variable v-curr-code       as integer   no-undo .
       17       define variable v-code-bank       as integer   no-undo .
       18       define variable v-code-bank-schet as integer   no-undo .
       19       define variable v-mode            as character no-undo .
       20       define variable v-mode-bank       as character no-undo .
       21       define variable v-doc-rec         as recid     no-undo .
       22       define variable v-host-code       as integer   no-undo .
       23       define variable v-obj-code        as integer   no-undo .
       24       define variable v-status_         as character no-undo .
       25       define variable objBank-Accounts  as class     bank-accounts      no-undo.
       26       define variable objBank           as class     bank-accounts_bank no-undo .
       27       objBank-Accounts = cast (subjectObj, bank-accounts).
       28       if objBank-Accounts:del-f > 0 then do:
       29         Msg = "физическое удаление банковских счетов не предусмотрено".
       30         return false.
       31       end.
       32       find first sysconf no-lock no-error.
       33       if AVAILABLE (sysconf) then v-host-code = sysconf.host-code .
       34       else do:
       35         Msg = "Не найдена фирма" .
       36         return false.
       37       end.
       38       v-obj-code = integer(objBank-Accounts:cont-code) no-error .
       39       if error-status:error then do :
       40         Msg = substitute("ошибка преобразования в число значения cont-code = &1", objBank-Accounts:cont-code) .
       41         return false.
       42       end .
       43       if objBank-Accounts:del-l > 0 then do:
       44         find first buf_fin-schet EXCLUSIVE-LOCK
       45              where buf_fin-schet.r-schet   = objBank-Accounts:r-schet
       46                and buf_fin-schet.cli-code  = v-obj-code
       47                 and buf_fin-schet.cli-type = 'орг':U no-error .
       48         if available (buf_fin-schet) then do :
       49           v-status_ = 'удал':U .
       50           run ref/finscht2.p (
       51             input recid(buf_fin-schet)
       52            ,input yes
       53            ,input ''
       54            ,input-output v-status_
       55           ) no-error .
       56           if error-status:error then do :
       57             Msg = return-value .
       58             return false .
       59           end .
       60           else return true .
       61         end .
       62         else do :
       63           return true.
       64         end .
       65       end.
       66       objBank  = objBank-Accounts:bank .
       67       find first X_schet-clients no-lock where X_schet-clients.obj-code = v-obj-code and
       68         X_schet-clients.obj-type = 'орг':U no-error .
       69       if not available X_schet-clients then
       70       do:
       71         Msg = "Не найден держатель счета в справочнике клиентов с кодом:" + string(objBank-Accounts:cont-code) .
       72         return error.
       73       end.
       74       find first buf_fin-bank no-LOCK where buf_fin-bank.bik = objBank:bik
       75         and buf_fin-bank.host-code = v-host-code no-error .
       76       if not available buf_fin-bank then
       77       do:
       78         find last ub.fin-bank no-error.
       79         if AVAILABLE ub.fin-bank then v-code-bank = ub.fin-bank.code-bank + 1 .
       80         else v-code-bank = 1 .
       81         assign
       82           v-doc-rec   = ?
       83           v-mode-bank = 'ДОБАВЛЕНИЕ':U
       84           .
       85       end.
       86       else
       87       do:
       88         assign
       89           v-doc-rec   = recid (buf_fin-bank)
       90           v-mode-bank = 'ИЗМЕНЕНИЕ':U
       91           v-code-bank = buf_fin-bank.code-bank
       92           .
       93       end.
       94       run ref/finbank1.p (
       95         input-output v-doc-rec
       96         ,input v-mode-bank
       97         ,input yes
       98         ,input ""
       99         ,input "":U
      100         ,input v-host-code
      101         ,input v-code-bank
      102         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.addres else ""
      103         ,input objBank:bank-city
      104         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.addres1 else ""
      105         ,input objBank:bank-name
      106         ,input objBank:bik
      107         ,input objBank:cor-acc
      108         ,input objBank:qr-rule
      109         ,input objBank:bank-deposit-debit
      110         ,input objBank:bank-deposit-kredit
      111         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.e-mail else ""
      112         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.fax else ""
      113         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.inn else ""
      114         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.kpp else ""
      115         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.licenz else ""
      116         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.okato else ""
      117         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.okonx else ""
      118         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.okpo else ""
      119         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.otdel else ""
      120         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.phone else ""
      121         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.PS else ""
      122         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.rkc else ""
      123         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.short-name else ""
      124         ,input if AVAILABLE buf_fin-bank then buf_fin-bank.cl-bank else ""
      125         )
      126         no-error.
      127       if error-status:error then
      128       do:
      129         Msg = return-value.
      130         return error.
      131       end.
      132       find first buf_fin-bank no-LOCK where RECID (buf_fin-bank) = v-doc-rec no-error.
      133       if AVAILABLE buf_fin-bank then
      134       do:
      135         v-code-bank-schet = buf_fin-bank.code-bank .
      136         find first ub.sysconf no-lock where ub.sysconf.host-code = buf_fin-bank.host-code no-error.
      137         if AVAILABLE ub.sysconf then
      138         do:
      139           v-curr-code = ub.sysconf.base-code .
      140         end.
      141         else
      142         do:
      143           Msg = "Не найдены системные настройки для фирмы с кодом:" + string(buf_fin-bank.host-code) .
      144           find first X_currency no-lock no-error.
      145           if AVAILABLE x_currency then
      146           do:
      147             v-curr-code = ub.currency.curr-code .
      148           end.
      149           else
      150           do:
      151             Msg = "Вы не выбрали валюту счета".
      152             return error .
      153           end.
      154         end.
      155         find first buf_fin-schet EXCLUSIVE-LOCK where buf_fin-schet.r-schet = objBank-Accounts:r-schet
      156           and buf_fin-schet.cli-code = X_schet-clients.obj-code
      157           and buf_fin-schet.cli-type = X_schet-clients.obj-type
      158           and buf_fin-schet.code-bank = v-code-bank-schet no-error .
      159         if AVAILABLE buf_fin-schet then
      160         do:
      161           v-mode = 'ИЗМЕНЕНИЕ':U .
      162           ri = recid(buf_fin-schet) .
      163           if (objBank-Accounts:del-l = 0) and (buf_fin-schet.status_ <> 'тек':U) then do :
      164             v-status_ = 'тек':U .
      165             run ref/finscht2.p (
      166             input ri
      167            ,input yes
      168            ,input ''
      169            ,input-output v-status_
      170             ) no-error .
      171             if error-status:error then do :
      172               Msg = return-value .
      173               return false .
      174             end .
      175           end .
      176         end.
      177         else
      178         do:
      179           v-mode = 'ДОБАВЛЕНИЕ':U .
      180           ri = ? .
      181         end.
      182         run ref/finscht1.p (
      183           input-output ri
      184           ,input v-mode
      185           ,input yes
      186           ,input ""
      187           ,input v-host-code
      188           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then 0 else buf_fin-schet.code-schet)
      189           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.c-schet)
      190           ,input X_schet-clients.obj-type
      191           ,input X_schet-clients.obj-code
      192           ,input v-code-bank-schet
      193           ,input v-curr-code
      194           ,INPUT (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.dop1)
      195           ,INPUT (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.dop2)
      196           ,input objBank-Accounts:r-schet
      197           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.ps)
      198           )
      199           no-error.
      200         if error-status:error then
      201         do:
      202           Msg = return-value.
      203           return false.
      204         end.
      205       end.
      206     end method.
      207   end class.
