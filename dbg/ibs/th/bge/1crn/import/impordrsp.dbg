        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.import.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impordrsp implements ibs.th.bge.1crn.import.iimpsubject:
        6   method private void getAttrLib ():
        7      define variable g#attr-lib  as handle no-undo .
        8      run gbl/getgattrlib.p (output g#attr-lib).
        9   end.
       10     define buffer buf_db for ub.db.
       11     define buffer buf_clients for ub.clients.
       12     define variable orderStatus  as class ibs.th.str.order.sts.order no-undo .
       13     define property Msg as character no-undo
       14       get.
       15       set.
       16     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       17       define variable vResult    as logical   no-undo.
       18       define variable vCount     as integer   no-undo.
       19       define variable vOrdrsp    as class ordrsp no-undo.
       20       define variable vOrderGood as class order-good no-undo.
       21       define variable vOrderGoods as class subjects no-undo.
       22       define buffer sys-ctrl       for ub.sys-ctrl .
       23       define buffer buf_order-doc  for ub.order-doc .
       24       define buffer buf_order-line for ub.order-line .
       25       define buffer buf_goods      for ub.goods .
       26       orderStatus =  new ibs.th.str.order.sts.order().
       27       vOrdrsp     = cast (subjectObj, ordrsp).
       28       vOrderGoods = vOrdrsp:order-good.
       29       find first sys-ctrl no-lock .
       30       find first buf_order-doc exclusive-lock where
       31                  buf_order-doc.db-num   = sys-ctrl.db-num
       32              and buf_order-doc.doc-code = int(vOrdrsp:order-item) no-error no-wait.
       33       if not avail buf_order-doc then
       34       do:
       35         Msg = if locked(buf_order-doc)
       36               then substitute("Заказ &1 занят другим пользователем.", vOrdrsp:order-item)
       37               else substitute("Заказ &1 не найден.", vOrdrsp:order-item).
       38         return error.
       39       end.
       40       do vCount = 1 to vOrderGoods:Get(vCount):
       41           vOrderGood = cast(vOrderGoods:SubjectObjCurr, order-good) .
       42           find first buf_order-line exclusive-lock where
       43                      buf_order-line.db-num   = buf_order-doc.db-num
       44                  and buf_order-line.doc-code = buf_order-doc.doc-code
       45                  and buf_order-line.gds-code = vOrderGood:gd-code no-error.
       46           if not avail buf_order-line then
       47           do:
       48             find first buf_goods where
       49                        buf_goods.gds-code = vOrderGood:gd-code no-lock no-error.
       50             if not avail buf_goods then
       51             do:
       52               Msg = substitute("Товар &1 не может быть добавлен в заказ. Товар с таким кодом не найден.",
       53                                vOrderGood:gd-code).
       54               return error.
       55             end.
       56             create buf_order-line.
       57             assign
       58               buf_order-line.db-num    = buf_order-doc.db-num
       59               buf_order-line.doc-code  = buf_order-doc.doc-code
       60               buf_order-line.gds-code  = vOrderGood:gd-code
       61               buf_order-line.artic     = buf_goods.artic
       62               buf_order-line.prod-type = buf_goods.prod-type
       63               buf_order-line.prod-code = buf_goods.prod-code
       64             .
       65           end.
       66           assign
       67             buf_order-line.fact-qnty = vOrderGood:amount
       68           .
       69       end.
       70       assign
       71         buf_order-doc.order-date = vOrdrsp:order-date
       72       .
       73       vResult = true.
       74       catch exAppErrors as class Progress.Lang.AppError :
       75         Msg = Msg + "; " + exAppErrors:ReturnValue .
       76         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
       77         vResult = false.
       78       end catch .
       79       catch exProErrors as class Progress.Lang.ProError :
       80         Msg = exProErrors:GetMessage(1) .
       81         vResult = false.
       82       end catch .
       83       catch exAnyErrors as class Progress.Lang.Error:
       84         Msg = "Unexpected error occurred..." .
       85         vResult = false.
       86       end catch .
       87       finally:
       88         return vResult.
       89       end.
       90     end method.
       91   end class.
