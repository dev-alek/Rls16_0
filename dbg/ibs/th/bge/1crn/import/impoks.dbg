        1   using ibs.th.bge.1crn.subjects.subjects.
        2   using ibs.th.bge.1crn.subjects.oks.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impoks inherits ibs.th.gbl.sys.objth implements ibs.th.bge.1crn.import.iimpsubject :
        5       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6       define override public property vss-author      as character no-undo init "$Author:$":U get.
        7       define override public property vss-date        as character no-undo init "$Date:$":U get.
        8       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10       define override public property vss-description as character no-undo init "Импорт okei-kkt" get.
       11     define property Msg as character no-undo
       12       get.
       13       set.
       14      method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       15         define variable objImp as class ibs.th.bge.1crn.subjects.oks no-undo.
       16         define buffer code for code.
       17         define variable v-retfl as logical no-undo.
       18         objImp = cast (subjectObj, oks).
       19         find first Code where Code.parent eq "okei-kkt"
       20                           and Code.code   eq objImp:Code_ok
       21         exclusive-lock no-error.
       22         if available code
       23         then do:
       24            if objImp:del-f > 0
       25            then do:
       26               delete code.
       27            end.
       28            else do:
       29               assign
       30                  code.CodeName  = objImp:Code_ei_kkt
       31                  code.misc1     = objImp:Code_pf_kkt
       32                  Code.CodeValue = objImp:notation
       33                  code.status_   = if objImp:del-l > 0
       34                                   then 1
       35                                   else 0
       36               .
       37            end.
       38         end.
       39         else do:
       40            if objImp:del-f > 0
       41            then do:
       42            end.
       43            else if objImp:del-l > 0
       44            then
       45               undo, throw new Progress.Lang.AppError(substitute("Нельзя пометить запись &1 в собщение &2 так как ее нет в системе.",objImp:Code_ok, objImp:InitTag)) .
       46            else do:
       47               create code.
       48               assign
       49                  Code.parent = "okei-kkt"
       50                  Code.code   = objImp:Code_ok
       51                  code.CodeName  = objImp:Code_ei_kkt
       52                  code.misc1     = objImp:Code_pf_kkt
       53                  Code.CodeValue = objImp:notation
       54                  code.status_  = if objImp:del-l > 0
       55                                  then 1
       56                                  else 0
       57               .
       58            end.
       59         end.
       60         v-retfl = true .
       61       define variable i as integer no-undo .
       62       catch exAppErrors as class Progress.Lang.AppError :
       63         Msg = exAppErrors:ReturnValue .
       64         if Msg > "" then . else do :
       65           do i = 1 to exAppErrors:NumMessages :
       66             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
       67           end .
       68           if Msg > "" then . else Msg = substitute ("AppError в &1",objImp:InitTag) .
       69         end .
       70         v-retfl = false .
       71         undo, throw exAppErrors .
       72       end catch .
       73       catch exProErrors as class Progress.Lang.ProError :
       74         do i = 1 to exProErrors:NumMessages :
       75           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
       76         end .
       77         if Msg > "" then . else Msg = substitute ("ProError в &1",objImp:InitTag) .
       78         v-retfl = false.
       79         undo, throw exProErrors .
       80       end catch .
       81       catch exAnyErrors as class Progress.Lang.Error:
       82         Msg = substitute ("Unexpected error в &1",objImp:InitTag) .
       83         v-retfl = false .
       84         undo, throw exAnyErrors .
       85       end catch .
       86       finally :
       87         return v-retfl .
       88       end finally .
       89     end method.
       90   end class.
