       36     field takenfromAvans    as character
       37     field RuleOsnPkoAvans   as character
       38     .
       39   define dataset ds-cashbook for tt-cashbook .
       40   method private character getRuleOsnName (input p-rule-reason as character) :
       41       define variable v-name as character no-undo .
       42       case p-rule-reason :
       43         when "0" then v-name = "Выручка от реализации" .
       44         when "1" then v-name = "Номера Z-отчетов" .
       45         when "2" then v-name = "Не заполнять" .
       46           otherwise v-name = p-rule-reason .
       47       end case .
       48       return v-name .
       49     end method .
       50     method private character getRuleOsnID (input p-rule-reason as character) :
       51       define variable v-id as character no-undo .
       52       case p-rule-reason :
       53         when "Выручка от реализации" then v-id = "0" .
       54         when "Номера Z-отчетов" then v-id = "1" .
       55         when "Не заполнять" then v-id = "2" .
       56           otherwise v-id = p-rule-reason .
       57       end case .
       58       return v-id .
       59     end method .
       60     method private character getRulePrilName (input p-rule-att as integer) :
       61       define variable v-name as character no-undo .
       62       case p-rule-att :
       63         when 1 then v-name = "Не заполнять" .
       64           otherwise v-name = "Номера Z-отчетов" .
       65       end case .
       66       return v-name .
       67     end method .
       68       method private character getRulePrilID (input p-rule-att as character) :
       69       define variable v-id as character no-undo .
       70       case p-rule-att :
       71         when "Не заполнять" then v-id = "1" .
       72           otherwise v-id = "0" .
       73       end case .
       74       return v-id .
       75     end method .
       76   define temp-table tt-cashbookrule like ub.cashbookrule
       77     field RkoMask         as character
       78     field PkoMask         as character
       79     field currPko         as character
       80     field currRko         as character
       81     field ManagerPosition as character
       82     field ManagerFIO      as character
       83     field BuhFIO          as character
       84     field struct          as character
       85     field uchet           as character
       86     field DptName         as character
       87     field DptType         as character
       88     field DptCode         as integer
       89     field obj             as character
       90     field stat            as character
       91     field Pin             as character
       92   .
       93   define dataset ds-cashbookrule for tt-cashbookrule .
       94    method private character getMgrPositionName (input p-post-chief as character) :
       95       define variable v-name as character no-undo .
       96       case p-post-chief :
       97         when "1" then v-name = "Директор" .
       98         when "2" then v-name = "Управляющий" .
       99         when "0" then v-name = "Должность рук-ля фирмы" .
      100         otherwise v-name = p-post-chief .
      101       end case .
      102       return v-name .
      103     end method .
      104    method private character getMgrPositionID (input p-post-chief as character) :
      105       define variable v-id as character no-undo .
      106       case p-post-chief :
      107         when "Директор" then v-id = "1" .
      108         when "Управляющий" then v-id = "2" .
      109         when "Должность рук-ля фирмы" then v-id = "0" .
      110         otherwise v-id = p-post-chief.
      111       end case .
      112       return v-id .
      113     end method .
      114     method private character getMgrFioName (input p-fio-chief as character) :
      115       define variable v-name as character no-undo .
      116       case p-fio-chief :
      117         when "1" then v-name = "ФИО руководителя магазина" .
      118         when "0" then v-name = "ФИО руководителя фирмы" .
      119         otherwise v-name = p-fio-chief .
      120       end case .
      121       return v-name .
      122     end method .
      123     method private character getMgrFioID (input p-fio-chief as character) :
      124       define variable v-id as character no-undo .
      125       case p-fio-chief :
      126         when "ФИО руководителя магазина" then v-id = "1" .
      127         when "ФИО руководителя фирмы" then v-id = "0" .
      128           otherwise v-id = p-fio-chief .
      129       end case .
      130       return v-id .
      131     end method .
      132     method private character getBuhFioName (input p-fio-booker as character) :
      133       define variable v-name as character no-undo .
      134       case p-fio-booker :
      135         when "1" then v-name = "ФИО бухгалтера магазина" .
      136         when "0" then v-name = "ФИО гл. бухгалтера фирмы" .
      137         otherwise v-name = p-fio-booker .
      138       end case .
      139       return v-name .
      140     end method .
      141     method private character getBuhFioID (input p-fio-booker as character) :
      142       define variable v-id as character no-undo .
      143       case p-fio-booker :
      144         when "ФИО бухгалтера магазина" then v-id = "1" .
      145         when "ФИО гл. бухгалтера фирмы" then v-id = "0" .
      146         otherwise v-id = p-fio-booker .
      147       end case .
      148       return v-id .
      149     end method .
      150     method private character getStructName (input p-struct-unit as integer) :
      151       define variable v-name as character no-undo .
      152       case p-struct-unit :
      153         when 1 then v-name = "Взять из объекта" .
      154         when 2 then v-name = "Значение по умолчанию" .
      155         when 0 then v-name = "Заполняет оператор" .
      156           otherwise v-name = string(p-struct-unit) .
      157       end case .
      158       return v-name .
      159     end method .
      160     method private character getStructID (input p-struct-unit as character) :
      161       define variable v-id as character no-undo .
      162       case p-struct-unit :
      163         when "Взять из объекта" then v-id = "1" .
      164         when "Значение по умолчанию" then v-id = "2" .
      165         when "Заполняет оператор" then v-id = "0" .
      166           otherwise v-id = p-struct-unit .
      167       end case .
      168       return v-id .
      169     end method .
      170     method private character getUchetName (input p-acc-shift as integer) :
      171       define variable v-name as character no-undo .
      172       case p-acc-shift :
      173         when 1 then v-name = "по сменным датам" .
      174         when 0 then v-name = "по календарным датам" .
      175           otherwise v-name = string (p-acc-shift) .
      176       end case .
      177       return v-name .
      178     end method .
      179     method private character getUchetID (input p-acc-shift as character) :
      180       define variable v-id as character no-undo .
      181       case p-acc-shift :
      182         when "по сменным датам" then v-id = "1" .
      183         when "по календарным датам" then v-id = "0" .
      184           otherwise v-id = p-acc-shift .
      185       end case .
      186       return v-id .
      187     end method .
      188     define private temp-table tt-gds no-undo
      189       field gds-code as integer
      190       .
      191     define property Msg as character no-undo
      192       get.
      193       set.
      194     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
      195       define variable objImp          as class     kass-book                           no-undo.
      196       define variable v-retfl         as logical   no-undo .
      197       define variable v-mode          as character no-undo.
      198       define variable v-storage       as class     ibs.th.ref.cashbookstorage            no-undo .
      199       define variable v-code          as character no-undo .
      200       define variable v-basic-kb      as integer   no-undo .
      201       define variable v-objlist       as class     ibs.th.bge.1crn.subjects.subjects     no-undo . // imp:kb-gds[]
      202       define variable v-gds-gd        as class     ibs.th.bge.1crn.subjects.kass-book-gd no-undo .
      203       define variable v-i-counter     as integer   no-undo .
      204       define variable v-i-num         as integer   no-undo .
      205       define variable v-stub          as integer   no-undo .
      206       define variable v-gds-code      as integer   no-undo .
      207       define variable v-str-kb-id     as character no-undo .
      208       define variable v-cashbookid    as int64     no-undo .
      209       define variable v-commentrytype as integer   no-undo .
      210       define variable v-host-code     as integer   no-undo .
      211       define buffer buf_clients          for ub.clients .
      212       define buffer buf_goods            for ub.goods .
      213       define buffer buf_goods-attr       for ub.goods-attr .
      214       define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc .
      215       objImp = cast (subjectObj, kass-book).
      216       if objImp:del-f > 0 then
      217         undo, throw new Progress.Lang.AppError("физичесткое удаление Типа кассовых книг не предусмотрено") .
      218       assign
      219         v-code     = objImp:code_
      220         v-basic-kb = objImp:basic-kb
      221         Msg        = "":U
      222         .
      223       empty temp-table tt-cashbook .
      224       v-storage = new ibs.th.ref.cashbookstorage () .
      225       if v-basic-kb ne 0 then
      226       do :
      227         v-basic-kb = ? .
      228         v-storage:getcashbook(v-code, output dataset ds-cashbook by-reference) .
      229         find first tt-cashbook no-error .
      230         if available tt-cashbook then
      231         do :
      232           v-str-kb-id = string(tt-cashbook.id) .
      233           if objImp:del-l > 0 then
      234           do :
      235             if tt-cashbook.id = 0 then undo, throw new Progress.Lang.AppError(
      236                 substitute("Ошибка логического удаления. Попытка удаления кассовой книги по признаку «Основная деятельность».")
      237                 ) .
      238             v-mode = 'удаление':U .
      239           end .
      240           else v-mode = 'ИЗМЕНЕНИЕ':U .
      241         end .
      242         else
      243         do :
      244           if objImp:del-l > 0 then
      245           do :
      246             undo, throw new Progress.Lang.AppError(
      247               substitute("Ошибка логического удаления. Тип кассовой книги с кодом [&1] отсутствует в БД.", v-code)
      248               ) .
      249           end .
      250           v-mode = 'ДОБАВЛЕНИЕ':U .
      251           create tt-cashbook .
      252           assign
      253             tt-cashbook.ext-code = v-code
      254             .
      255         end .
      256       end .
      257       else
      258       do :
      259         if objImp:del-l > 0 then
      260           undo, throw new Progress.Lang.AppError("Удаление основной кассовой книги не возможно.").
      261         v-storage:getcashbook(0, output dataset ds-cashbook by-reference) .
      262         find first tt-cashbook no-error .
      263         if available tt-cashbook
      264           then
      265         do:
      266           if     tt-cashbook.ext-code ne "0"
      267             and tt-cashbook.ext-code ne v-code
      268             then
      269             undo, throw new Progress.Lang.AppError(substitute ("Редактирование номера основной кассовой книги во внешней ВС запрещено. Старый номер: &1 Новый номер: &2", tt-cashbook.ext-code, v-code)).
      270           assign
      271             tt-cashbook.ext-code = v-code
      272             v-str-kb-id          = "0"
      273             v-mode               = 'ИЗМЕНЕНИЕ':U
      274             .
      275         end.
      276         else
      277         do:
      278           v-mode = 'ДОБАВЛЕНИЕ':U .
      279           create tt-cashbook .
      280           assign
      281             tt-cashbook.ext-code = v-code
      282             tt-cashbook.id       = 0
      283             tt-cashbook.basic-kb = yes
      284             .
      285         end.
      286       end.
      287       if v-mode = 'удаление':U then
      288       do :
      289         if tt-cashbook.Status_ = 0  then
      290         do :
      291           for each buf_goods-attr exclusive-lock
      292             where buf_goods-attr.attr-code  = 'cash-book-id':U
      293             and buf_goods-attr.attr-value = v-str-kb-id :
      294             delete buf_goods-attr.
      295           end .
      296           v-storage:deleteDB(input dataset ds-cashbook by-reference) .
      297         end .
      298         v-retfl = true.
      299         return true .
      300       end .
      301       v-host-code = -1 .
      302       define variable v-int-schet   as integer   no-undo .
      303       define variable v-schet-found as logical   no-undo .
      304       define variable v-code-value  as character no-undo .
      305       if objImp:kredit <> ? then
      306       do :
      307         v-int-schet = integer (objImp:kredit) no-error .
      308         v-code-value = objImp:kredit .
      309         v-schet-found = false .
      310         for each buf_clients no-lock
      311           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      312           and buf_clients.obj-type = 'маг':U
      313           and buf_clients.stts     = 0 :
      314           if can-find (first buf_fin-code-cor-acc
      315             where buf_fin-code-cor-acc.host-code  = buf_clients.host-code
      316             AND buf_fin-code-cor-acc.code-value = v-code-value) then
      317           do :
      318             v-host-code   = buf_clients.host-code .
      319             v-schet-found = true .
      320             leave.
      321           end .
      322         end .
      323         if not v-schet-found then
      324           undo, throw new Progress.Lang.AppError( substitute(
      325             "Счёт кредита [&1] из кассовой книги [&2 &3] отсутствует в справочнике счетов."
      326             , objImp:kredit, v-code, objImp:name_
      327             ) ) .
      328       end .
      329       if objImp:kredit-nonop-inc <> ? then
      330       do :
      331         v-int-schet = integer (objImp:kredit-nonop-inc) no-error .
      332         v-code-value = objImp:kredit-nonop-inc .
      333         v-schet-found = false .
      334         for each buf_clients no-lock
      335           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      336           and buf_clients.obj-type = 'маг':U
      337           and buf_clients.stts     = 0 :
      338           if can-find (first buf_fin-code-cor-acc
      339             where buf_fin-code-cor-acc.host-code  = buf_clients.host-code
      340             AND buf_fin-code-cor-acc.code-value = v-code-value) then
      341           do :
      342             v-host-code   = buf_clients.host-code .
      343             v-schet-found = true .
      344             leave.
      345           end .
      346         end .
      347         if not v-schet-found then
      348           undo, throw new Progress.Lang.AppError( substitute(
      349             "Счёт кредита для формирования ПКО «Внереализационный доход» [&1] из кассовой книги [&2 &3] отсутствует в справочнике счетов."
      350             , objImp:kredit-nonop-inc, v-code, objImp:name_
      351             ) ) .
      352       end .
      353       if objImp:credit-prepayment <> ? then
      354       do :
      355         v-int-schet = integer (objImp:credit-prepayment) no-error .
      356         v-code-value = objImp:credit-prepayment .
      357         v-schet-found = false .
      358         for each buf_clients no-lock
      359           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      360           and buf_clients.obj-type = 'маг':U
      361           and buf_clients.stts     = 0 :
      362           if can-find (first buf_fin-code-cor-acc
      363             where buf_fin-code-cor-acc.host-code  = buf_clients.host-code
      364             AND buf_fin-code-cor-acc.code-value = v-code-value) then
      365           do :
      366             v-host-code   = buf_clients.host-code .
      367             v-schet-found = true .
      368             leave.
      369           end .
      370         end .
      371         if not v-schet-found then
      372           undo, throw new Progress.Lang.AppError( substitute(
      373             "Счёт кредита для формирования ПКО «Аванс» [&1] из кассовой книги [&2 &3] отсутствует в справочнике счетов."
      374             , objImp:credit-prepayment, v-code, objImp:name_
      375             ) ) .
      376       end .
      377       if objImp:debit <> ? then
      378       do :
      379         v-int-schet = integer (objImp:debit) no-error .
      380         v-code-value = objImp:debit .
      381         v-schet-found = false .
      382         for each buf_clients no-lock
      383           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      384           and buf_clients.obj-type = 'маг':U
      385           and buf_clients.stts     = 0 :
      386           if can-find (first buf_fin-code-cor-acc
      387             where buf_fin-code-cor-acc.host-code  = buf_clients.host-code
      388             AND buf_fin-code-cor-acc.code-value = v-code-value) then
      389           do :
      390             v-host-code   = buf_clients.host-code .
      391             v-schet-found = true .
      392             leave.
      393           end .
      394         end .
      395         if not v-schet-found then
      396           undo, throw new Progress.Lang.AppError( substitute(
      397             "Счёт дебета [&1] из кассовой книги [&2 &3] отсутствует в справочнике счетов."
      398             , objImp:debit, v-code, objImp:name_
      399             ) ) .
      400       end .
      401       if objImp:code-payer <> ? then
      402       do :
      403         if not can-find (first buf_clients
      404           where buf_clients.obj-type = 'орг':U
      405           and buf_clients.obj-code = objImp:code-payer) then
      406           undo, throw new Progress.Lang.AppError( substitute(
      407             "Контрагент для оформления ПКО [&1 &2] из кассовой книги [&3 &4] отсутствует в справочнике клиентов."
      408             , 'орг':U, objImp:code-payer, v-code, objImp:name_
      409             ) ) .
      410       end .
      411       if objImp:code-payer-nonop-inc <> ? then
      412       do :
      413         if not can-find (first buf_clients
      414           where buf_clients.obj-type = 'орг':U
      415           and buf_clients.obj-code = objImp:code-payer-nonop-inc) then
      416           undo, throw new Progress.Lang.AppError( substitute(
      417             "Контрагент для внереализационный доход ПКО [&1 &2] из кассовой книги [&3 &4] отсутствует в справочнике клиентов."
      418             , 'орг':U, objImp:code-payer-nonop-inc, v-code, objImp:name_
      419             ) ) .
      420       end .
      421       if objImp:code-payer-prepayment <> ? then
      422       do :
      423         if not can-find (first buf_clients
      424           where buf_clients.obj-type = 'орг':U
      425           and buf_clients.obj-code = objImp:code-payer-prepayment) then
      426           undo, throw new Progress.Lang.AppError( substitute(
      427             "Контрагент для аванса ПКО [&1 &2] из кассовой книги [&3 &4] отсутствует в справочнике клиентов."
      428             , 'орг':U, objImp:code-payer-prepayment, v-code, objImp:name_
      429             ) ) .
      430       end .
      431       define variable vbank-resive      as integer no-undo.
      432       define variable vbank-resive-host as integer no-undo.
      433       find first fin-bank where fin-bank.bik eq objImp:bank-resive
      434         no-lock no-error.
      435       if available fin-bank
      436         then
      437       do:
      438         vbank-resive = fin-bank.code-bank.
      439         vbank-resive-host = fin-bank.host-code .
      440       end.
      441       define variable vbank-deposit      as integer no-undo.
      442       define variable vbank-deposit-host as integer no-undo.
      443       find first fin-bank where fin-bank.bik eq objImp:bank-deposit
      444         no-lock no-error.
      445       if available fin-bank
      446         then
      447       do:
      448         vbank-deposit = fin-bank.code-bank.
      449         vbank-deposit-host = fin-bank.host-code .
      450       end.
      451       assign
      452         tt-cashbook.CashBookName      = objImp:name_
      453         when objImp:name_ <> ?
      454         tt-cashbook.CorrPko           = objImp:kredit
      455         when objImp:kredit <> ?
      456         tt-cashbook.corrPkoVne        = objImp:kredit-nonop-inc
      457         when objImp:kredit-nonop-inc <> ?
      458         tt-cashbook.corrPkoAvans        = objImp:credit-prepayment
      459         when objImp:credit-prepayment <> ?
      460         tt-cashbook.CorrRko           = objImp:Corr-Rko
      461         when objImp:Corr-Rko <> ?
      462         tt-cashbook.RuleOsnPko        = objImp:rule-reason
      463         when objImp:rule-reason <> ?
      464         tt-cashbook.RuleOsnPkoVne     = objImp:rule-reason-nonop-inc
      465         when objImp:rule-reason-nonop-inc <> ?
      466         tt-cashbook.RuleOsnPkoAvans     = objImp:rule-reason-prepayment
      467         when objImp:rule-reason-prepayment <> ?
      468         tt-cashbook.OsnAcct           = objImp:debit
      469         when objImp:debit <> ?
      470         tt-cashbook.RuleOsnRko        = objImp:Rule-Osn-Rko
      471         when objImp:Rule-Osn-Rko <> ?
      472         tt-cashbook.cli-type          = 'орг':U
      473               when objImp:code-payer-prepayment <> ?
      474         tt-cashbook.RulePril          = string(objImp:rule-att)
      475         when objImp:rule-att <> ?
      476         tt-cashbook.FlagSepCash       = (objImp:ind-kass-pko = 1)
      477         when objImp:ind-kass-pko <> ?
      478         tt-cashbook.FlagSepFull       = (objImp:apart-np-tnp = 1)
      479         when objImp:apart-np-tnp <> ?
      480         tt-cashbook.SourceCode        = string(objImp:code-symbol)
      481         when objImp:code-symbol <> ?
      482         tt-cashbook.BankRecip-code    = vbank-resive
      483         when vbank-resive <> ?
      484         tt-cashbook.BankDepos-code    = vbank-deposit
      485         when vbank-deposit <> ?
      486         tt-cashbook.BankDepos-host    = vbank-deposit-host
      487         tt-cashbook.BankRecip-host    = vbank-resive-host
      488         tt-cashbook.CountCollect-type = 'орг':U
      489         when  objImp:cont-inkass <> ?
      490         tt-cashbook.CountCollect-Code = objImp:cont-inkass
      491         when objImp:cont-inkass <> ?
      492         tt-cashbook.CountCash-type    = 'орг':U
      493         when objImp:contr-code-rko <> ?
      494         tt-cashbook.CountCash-code    = objImp:contr-code-rko
      495         when objImp:contr-code-rko <> ?
      496         tt-cashbook.Corr-transf       = objImp:Corr-transf
      497         when objImp:Corr-transf <> ?
      498         tt-cashbook.contr-type-transf = 'орг':U
      499         when objImp:contr-code-transf <> ?
      500         tt-cashbook.contr-code-transf = objImp:contr-code-transf
      501         when objImp:contr-code-transf <> ?
      502         tt-cashbook.rule-payer-transf = objImp:rule-payer-transf
      503         when objImp:rule-payer-transf <> ?
      504         tt-cashbook.rule-payer-rko    = objImp:rule-payer-rko
      505         when objImp:rule-payer-rko    <> ?
      506         tt-cashbook.rule-payer-inkass = objImp:rule-payer-inkass
      507         when objImp:rule-payer-inkass <> ?
      508         tt-cashbook.BankRecip-acct    = objImp:bank-resive-acc
      509         when objImp:bank-resive-acc  <> ?
      510         tt-cashbook.CorrAcctIncas     = objImp:Corr-inkass
      511         when objImp:Corr-inkass  <> ?
      512         tt-cashbook.BasisIncas        = objImp:rule-osn-incass
      513         when objImp:rule-osn-incass  <> ?
      514         tt-cashbook.Status_           = objImp:del-l
      515         .
      516         if objImp:code-payer <> ? then
      517         assign
      518         tt-cashbook.cli-code          = objImp:code-payer
      519         tt-cashbook.cli-type          = 'орг':U  .
      520         if objImp:code-payer-nonop-inc <> ? then
      521         assign
      522         tt-cashbook.Vnecli-type       = 'орг':U
      523         tt-cashbook.Vnecli-code       = objImp:code-payer-nonop-inc
      524         tt-cashbook.Avanscli-type       = 'орг':U .
      525         if objImp:code-payer-prepayment <> ? then
      526         tt-cashbook.Avanscli-code       = integer(objImp:code-payer-prepayment)  .
      527       assign
      528         tt-cashbook.rule-osn-transf = objImp:rule-reason
      529         when objImp:rule-reason <> ?  and tt-cashbook.id ne 0
      530         tt-cashbook.rule-osn-transf = objImp:Rule-Osn-Rko
      531         when objImp:Rule-Osn-Rko <> ? and tt-cashbook.id eq 0
      532         tt-cashbook.rule-osn-transf = objImp:rule-osn-transf
      533         when objImp:rule-osn-transf <> ?
      534         .
      535       tt-cashbook.takenfrom    = objImp:rule-payer .
      536       tt-cashbook.takenfromVne = objImp:rule-payer-nonop-inc .
      537       tt-cashbook.takenfromAvans = objImp:rule-payer-prepayment .
      538       if v-mode = 'ДОБАВЛЕНИЕ':U then
      539       do :
      540         v-storage:insertDB(buffer tt-cashbook, output v-cashbookid) .
      541         if v-storage:Msg <> "" then undo, throw new Progress.Lang.AppError(
      542             substitute("Ошибка импорта кассовой книги [&1]: &2", objImp:name_, v-storage:Msg)
      543             ) .
      544         tt-cashbook.id = v-cashbookid .
      545         v-str-kb-id = string(tt-cashbook.id) .
      546         for each buf_clients no-lock
      547           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      548           and buf_clients.obj-type = 'маг':U
      549           and buf_clients.stts     = 0 :
      550           empty temp-table tt-cashbookrule .
      551           create tt-cashbookrule .
      552           assign
      553             tt-cashbookrule.cashbookId      = tt-cashbook.id
      554             tt-cashbookrule.obj-type        = buf_clients.obj-type
      555             tt-cashbookrule.obj-code        = buf_clients.obj-code
      556             tt-cashbookrule.obj             = substitute("&1&2", tt-cashbookrule.obj-type, tt-cashbookrule.obj-code)
      557             tt-cashbookrule.host-code       = if buf_clients.obj-type = 'орг':U then string(buf_clients.obj-code) else string(buf_clients.host-code)
      558             tt-cashbookrule.RkoMask         = substitute("&1[NNNN]", objImp:pko-prefix)
      559             when objImp:pko-prefix <> ?
      560             tt-cashbookrule.PkoMask         = substitute("&1[NNNN]", objImp:rko-prefix)
      561             when objImp:rko-prefix <> ?
      562             tt-cashbookrule.ManagerPosition = string(objImp:post-chief)
      563             when objImp:post-chief <> ?
      564             tt-cashbookrule.ManagerFIO      = string(objImp:fio-chief)
      565             when objImp:fio-chief <> ?
      566             tt-cashbookrule.BuhFIO          = string(objImp:fio-booker)
      567             when objImp:fio-booker <> ?
      568             tt-cashbookrule.Struct          = string(objImp:struct-unit)
      569             when objImp:struct-unit <> ?
      570             tt-cashbookrule.DptName         = objImp:struct-unit-name
      571             when objImp:struct-unit-name <> ?
      572             tt-cashbookrule.DptType         = objImp:struct-unit-type
      573             when objImp:struct-unit-type <> ?
      574             tt-cashbookrule.DptCode         = objImp:struct-unit-code
      575             when objImp:struct-unit-code <> ?
      576             tt-cashbookrule.uchet           = string(objImp:acc-shift)
      577             when objImp:acc-shift <> ?
      578             tt-cashbookrule.Pin             = objImp:pin
      579             when objImp:pin <> ?
      580             .
      581           v-storage:updateDBobj(input dataset ds-cashbookrule by-reference) .
      582           if v-storage:Msg <> "" then undo, throw new Progress.Lang.AppError(
      583               substitute("Ошибка импорта кассовой книги [&1]: &2", objImp:name_, v-storage:Msg)
      584               ) .
      585         end .
      586       end .
      587       else
      588       do :
      589         v-storage:updateDB(buffer tt-cashbook) .
      590         if v-storage:Msg <> "" then undo, throw new Progress.Lang.AppError(
      591             substitute("Ошибка импорта кассовой книги [&1]: &2", objImp:name_, v-storage:Msg)
      592             ) .
      593         for each buf_clients no-lock
      594           where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
      595           and buf_clients.obj-type = 'маг':U
      596           and buf_clients.stts     = 0 :
      597           empty temp-table tt-cashbookrule .
      598           v-storage:getCashBookRule (tt-cashbook.id, buf_clients.obj-type, buf_clients.obj-code, output dataset ds-cashbookrule by-reference) .
      599           find first tt-cashbookrule no-error .
      600           if not available tt-cashbookrule then
      601           do :
      602             create tt-cashbookrule .
      603             assign
      604               tt-cashbookrule.cashbookId = tt-cashbook.id
      605               tt-cashbookrule.obj-type   = buf_clients.obj-type
      606               tt-cashbookrule.obj-code   = buf_clients.obj-code
      607               tt-cashbookrule.obj        = substitute("&1&2", tt-cashbookrule.obj-type, tt-cashbookrule.obj-code)
      608               tt-cashbookrule.host-code  = if buf_clients.obj-type = 'орг':U then string(buf_clients.obj-code) else string(buf_clients.host-code)
      609               .
      610           end .
      611           assign
      612             tt-cashbookrule.RkoMask         = substitute("&1[NNNN]", objImp:pko-prefix)
      613             when objImp:pko-prefix <> ?
      614             tt-cashbookrule.PkoMask         = substitute("&1[NNNN]", objImp:rko-prefix)
      615             when objImp:rko-prefix <> ?
      616             tt-cashbookrule.ManagerPosition = string(objImp:post-chief)
      617             when objImp:post-chief <> ?
      618             tt-cashbookrule.ManagerFIO      = string(objImp:fio-chief)
      619             when objImp:fio-chief <> ?
      620             tt-cashbookrule.BuhFIO          = string(objImp:fio-booker)
      621             when objImp:fio-booker <> ?
      622             tt-cashbookrule.Struct          = string(objImp:struct-unit)
      623             when objImp:struct-unit <> ?
      624             tt-cashbookrule.DptName         = objImp:struct-unit-name
      625             when objImp:struct-unit-name <> ?
      626             tt-cashbookrule.DptType         = objImp:struct-unit-type
      627             when objImp:struct-unit-type <> ?
      628             tt-cashbookrule.DptCode         = objImp:struct-unit-code
      629             when objImp:struct-unit-code <> ?
      630             tt-cashbookrule.uchet           = string(objImp:acc-shift)
      631             when objImp:acc-shift <> ?
      632             tt-cashbookrule.Pin             = objImp:pin
      633             when objImp:pin <> ?
      634             .
      635           v-storage:updateDBobj(input dataset ds-cashbookrule by-reference) .
      636           if v-storage:Msg <> "" then undo, throw new Progress.Lang.AppError(
      637               substitute("Ошибка импорта кассовой книги [&1]: &2", objImp:name_, v-storage:Msg)
      638               ) .
      639         end .
      640       end .
      641           empty temp-table tt-gds .
      642       if (v-mode = 'ИЗМЕНЕНИЕ':U) and (v-basic-kb = 0) then
      643       do :
      644       end .
      645       else
      646       do :
      647         v-objlist = objImp:kb-gds .
      648         if valid-object(v-objlist) then
      649         do :
      650           v-i-counter = v-objlist:iCounter .
      651           do v-i-num = 1 to v-i-counter :
      652             v-stub = v-objlist:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      653             v-gds-gd = cast(v-objlist:SubjectObjCurr, ibs.th.bge.1crn.subjects.kass-book-gd) .
      654             v-gds-code = integer(v-gds-gd:gd-code) .
      655             if not can-find (first buf_goods where buf_goods.gds-code = v-gds-code) then
      656               undo, throw new Progress.Lang.AppError( substitute(
      657                 "Код товара [&1] из кассовой книги [&2 &3] отсутствует в справочнике товаров."
      658                 , v-gds-code, v-code, objImp:name_
      659                 ) ) .
      660             create tt-gds.
      661             tt-gds.gds-code = v-gds-code .
      662           end . // end_of_objImp:gds[]
      663           if v-mode = 'ИЗМЕНЕНИЕ':U then
      664           do :
      665             for each buf_goods-attr exclusive-lock
      666               where buf_goods-attr.attr-code  = 'cash-book-id':U
      667               and buf_goods-attr.attr-value = v-str-kb-id :
      668               if not can-find (first tt-gds where tt-gds.gds-code = buf_goods-attr.gds-code) then
      669                 delete buf_goods-attr.
      670             end .
      671           end .
      672           for each tt-gds :
      673             find first buf_goods-attr exclusive-lock
      674               where buf_goods-attr.gds-code  = tt-gds.gds-code
      675               and buf_goods-attr.attr-code = 'cash-book-id':U no-error .
      676             if available buf_goods-attr then assign
      677                 buf_goods-attr.attr-value = v-str-kb-id when (buf_goods-attr.attr-value <> v-str-kb-id)
      678                 .
      679             else
      680             do:
      681               create buf_goods-attr .
      682               assign
      683                 buf_goods-attr.gds-code   = tt-gds.gds-code
      684                 buf_goods-attr.attr-code  = 'cash-book-id':U
      685                 buf_goods-attr.attr-value = v-str-kb-id
      686                 .
      687             end.
      688           end .
      689         end. // end_of_gds
      690         else
      691         do:
      692           for each buf_goods-attr exclusive-lock
      693             where buf_goods-attr.attr-code  = 'cash-book-id':U
      694             and buf_goods-attr.attr-value = v-str-kb-id :
      695             delete buf_goods-attr.
      696           end .
      697         end.
      698       end .
      699       v-retfl = true.
      700       define variable i as integer no-undo .
      701       catch exAppErrors as class Progress.Lang.AppError :
      702         Msg = exAppErrors:ReturnValue .
      703         if Msg > "" then .
      704         else
      705         do :
      706           do i = 1 to exAppErrors:NumMessages :
      707             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
      708           end .
      709           if Msg > "" then .
      710           else Msg = "AppError в типах кассовых книг" .
      711         end .
      712         v-retfl = false .
      713         undo, throw exAppErrors .
      714       end catch .
      715       catch exProErrors as class Progress.Lang.ProError :
      716         do i = 1 to exProErrors:NumMessages :
      717           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
      718         end .
      719         if Msg > "" then .
      720         else Msg = "ProError в типах кассовых книг" .
      721         v-retfl = false.
      722         undo, throw exProErrors .
      723       end catch .
      724       catch exAnyErrors as class Progress.Lang.Error:
      725         Msg = "Unexpected error в типах кассовых книг" .
      726         v-retfl = false .
      727         undo, throw exAnyErrors .
      728       end catch .
      729       finally :
      730         dataset ds-cashbook:empty-dataset() .
      731         if valid-object(v-storage) then delete object v-storage .
      732         return v-retfl .
      733       end finally .
      734     end method.
      735   end class.
