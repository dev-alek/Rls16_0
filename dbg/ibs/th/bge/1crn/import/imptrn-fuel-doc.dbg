        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.import.*.
        4   using ibs.th.skt.Adapters.AdapterOra-i516-1c from propath.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.imptrn-fuel-doc implements ibs.th.bge.1crn.import.iimpsubject:
        7     define temp-table TempTrnDoc no-undo
        8       field line-num      as integer
        9       field ext-doc-code  as character
       10       field doc-date      as date
       11       field ext-doc-type  as character
       12       field cli-type      as character
       13       field cli-code      as integer
       14       field obj-type      as character
       15       field obj-code      as integer
       16       field ps            as character
       17       field doc-id        as character
       18       field dog-code      as character
       19       field source-doc    as character
       20       field out-code      as character
       21       index pi line-num ext-doc-code
       22     .
       23     define temp-table TempDocLine no-undo
       24       field line-num     as integer
       25       field gds-code     as integer
       26       field doc-qnty     as decimal
       27       field fact-qnty    as decimal
       28       field price-rubl   as decimal
       29       field RowSum       as decimal
       30       field vat-pc       as decimal
       31       field fact-dnsty   as decimal
       32       field cli-qnty     as decimal
       33       field koef         as decimal
       34       field unit-code    as character
       35       field b-code       as character
       36       field is-tsd-qnty  as logical init no
       37       field vsd-uuid     as character
       38       field part-id      as character
       39       field aclMarksList as character
       40       field PartIDTH     as character
       41       index pi
       42       line-num
       43       gds-code
       44     .
       45     define temp-table TempDocPart no-undo
       46       field gds-code     as integer
       47       field doc-qnty     as decimal
       48       field fact-qnty    as decimal
       49       field price-rubl   as decimal
       50       field vat-pc       as decimal
       51       field fact-dnsty   as decimal
       52       field vsd-uuid     as character
       53       field part-id      as character
       54       field in-doc-id    as character
       55       field edoc-id      as character
       56       index pi
       57       in-doc-id
       58       part-id
       59       gds-code
       60     .
       61     define temp-table TempDocMark no-undo
       62       field gtin as character
       63       field gtin_qnt as integer
       64       field upd_id as character
       65       field prt-id as character
       66       field in-doc-id as character
       67       field mark as character
       68       field gds-code as integer
       69       index pi mark
       70     .
       71     define buffer buf_clients for ub.clients.
       72     define property Msg as character no-undo
       73       get.
       74       set.
       75     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       76       define variable v-doc-rec as recid     no-undo.
       77       define variable result    as logical   no-undo.
       78       define variable glog      as logical   no-undo.
       79       define variable mode      as character no-undo.
       80       define variable ii        as integer   no-undo.
       81       define variable objTrnDoc  as class     trn-fuel-doc-in no-undo.
       82       define variable objGd      as class     trn-gd-fuel     no-undo.
       83       define variable adapObj    as class     AdapterOra-i516-1c no-undo.
       84       define variable objGds     as class     subjects        no-undo.
       85       objTrnDoc = cast (subjectObj, trn-fuel-doc-in).
       86       adapObj = new AdapterOra-i516-1c ().
       87       find first ub.sys-ctrl.
       88       empty temp-table TempTrnDoc.
       89       empty temp-table TempDocLine.
       90       empty temp-table TempDocMark.
       91       find first buf_clients where buf_clients.db-num = ub.sys-ctrl.db-num.
       92       create TempTrnDoc.
       93       assign
       94         TempTrnDoc.obj-type = buf_clients.obj-type
       95         TempTrnDoc.obj-code = buf_clients.obj-code
       96         TempTrnDoc.cli-code = integer (objTrnDoc:fuel-st-code)
       97         TempTrnDoc.cli-type = "маг"
       98         TempTrnDoc.doc-date = objTrnDoc:doc-date
       99         TempTrnDoc.ext-doc-code = replace (objTrnDoc:doc-code, "-", "=").
      100         TempTrnDoc.doc-id = objTrnDoc:doc-id
      101       .
      102       case trim (objTrnDoc:doc-type, '0'):
      103         when '4' then do:
      104           TempTrnDoc.ext-doc-type = 'ie':U .
      105         end.
      106         otherwise do:
      107           Msg = "Не поддерживаемый тип документа на загрузку: " + objTrnDoc:doc-type.
      108           return false.
      109         end.
      110       end case.
      111       objGds = objTrnDoc:GDS.
      112       do ii = 1 to objGds:Get(ii):
      113         objGd = cast (objGds:SubjectObjCurr, trn-gd-fuel).
      114         create TempDocLine.
      115         assign
      116           TempDocLine.gds-code = objGd:gd-code
      117           TempDocLine.fact-qnty = objGd:cap-fact
      118           TempDocLine.doc-qnty = objGd:cap-fact
      119           TempDocLine.price-rubl = round (objGd:sum / objGd:cap-fact, 2)
      120           TempDocLine.fact-dnsty = objGd:dnsty-fact
      121           TempDocLine.cli-qnty = objGd:wght-fact
      122         .
      123       end.
      124       adapObj:SetTempTable(table TempTrnDoc, table TempDocLine, table TempDocPart, table TempDocMark, "").
      125       adapObj:WriteDB(output glog).
      126       if error-status:error then
      127       do:
      128         Msg = return-value.
      129         result = false.
      130       end.
      131       else do:
      132         result = true.
      133       end.
      134       return result.
      135     end method.
      136   end class.
