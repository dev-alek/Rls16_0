        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.gbl.ggoattr FROM PROPATH.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impgood-grps implements ibs.th.bge.1crn.import.iimpsubject:
        6     define variable ggoattr as class ggoattr no-undo .
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable v-rec  as recid     no-undo .
       12       define variable v-mode as character no-undo .
       13       define buffer buf_gds-grp for ub.gds-grp .
       14       DEFINE VARIABLE varnode-code          like ub.gds-grp.node-code no-undo .
       15       DEFINE VARIABLE varupper-code         like ub.gds-grp.upper-code no-undo .
       16       define variable v-fill-tax-from-upper as LOGICAL no-undo .
       17       define variable v-perenos             as logical no-undo .
       18       define variable v-value               as logical no-undo .
       19       define variable objGood-Grps          as class   good-grps no-undo.
       20       objGood-Grps = cast (subjectObj, good-grps).
       21       if objGood-Grps:code_ = "1" then
       22       do:
       23         Msg = "Группа товара не должна иметь код равный 1 !!!".
       24         return false.
       25       end.
       26       if objGood-Grps:del-f = 1 then
       27       do:
       28         find first buf_gds-grp EXCLUSIVE-LOCK
       29           where buf_gds-grp.node-code = integer(objGood-Grps:code_)
       30           no-error.
       31         if error-status :error
       32           then
       33         do:
       34           Msg = "Нет группы БД, соответствующей значению в списке.".
       35           return false.
       36         end.
       37         run ref/gdsgrp03.p ( input yes
       38           ,input recid(buf_gds-grp)
       39           ,input "up"
       40           ,input "up"
       41           ) no-error.
       42         if error-status:error then
       43         do:
       44           Msg = return-value.
       45           return false.
       46         end.
       47       end.
       48       else
       49       do:
       50         ASSIGN
       51           varnode-code  = INTEGER(objGood-Grps:code_)
       52           varupper-code = if objGood-Grps:upper-code = ? or objGood-Grps:upper-code = "" then 1 else INTEGER (objGood-Grps:upper-code)
       53           .
       54         find first buf_gds-grp EXCLUSIVE-LOCK
       55           where buf_gds-grp.node-code = integer(objGood-Grps:code_)
       56           no-error.
       57         if AVAILABLE buf_gds-grp then
       58         do:
       59           assign
       60             v-rec                 = RECID (buf_gds-grp)
       61             v-mode                = 'ИЗМЕНЕНИЕ':U
       62             v-fill-tax-from-upper = no
       63             .
       64           if varupper-code <> buf_gds-grp.upper-code then
       65           do:
       66             assign
       67               varupper-code = buf_gds-grp.upper-code
       68               v-perenos     = yes.
       69             .
       70           end.
       71         end.
       72         else
       73         do:
       74           assign
       75             v-rec                 = ?
       76             v-mode                = 'ДОБАВЛЕНИЕ':U
       77             v-fill-tax-from-upper = yes
       78             .
       79         end.
       80         run ref/gdsgrp01.p (
       81           input v-mode
       82           ,input yes
       83           ,input yes
       84           ,input v-fill-tax-from-upper
       85           ,input-output  varnode-code
       86           ,input-output  varupper-code
       87           ,input objGood-Grps:name_
       88           ,input 'Не-считать':U
       89           ,input ""
       90           ,input objGood-Grps:rn-code
       91           ,input 'Отключено':U
       92           ,input 0
       93           ,output v-rec
       94           ) no-error .
       95         if error-status:error then
       96         do:
       97           Msg = return-value.
       98           return false.
       99         end.
      100         else
      101         do:
      102           ggoattr = new ggoattr ().
      103           if objGood-Grps:r-mat = 1 then
      104           do:
      105             ggoattr:ggoattr-write(
      106               varnode-code
      107               ,0
      108               ,""
      109               ,0
      110               ,'no-inc-auto-rep':U
      111               ,"yes"
      112               ).
      113           end.
      114           else
      115           do:
      116             ggoattr:ggoattr-delete(
      117               varnode-code
      118               ,0
      119               ,""
      120               ,0
      121               ,'no-inc-auto-rep':U
      122               ,v-value
      123               ).
      124           end.
      125   define var old_val as character no-undo.
      126   define var old_tipe as character no-undo.
      127   ggoattr:ggoattr-value(varnode-code
      128               ,0
      129               ,""
      130               ,0
      131               ,'no-inc-auto-rep':U
      132               ,output old_val
      133                           ,output old_tipe
      134               ).
      135           if objGood-Grps:Prohibition-sale = 1 or objGood-Grps:r-mat = 1 then
      136           do:
      137             ggoattr:ggoattr-write(
      138               varnode-code
      139               ,0
      140               ,""
      141               ,0
      142               ,'ban-sales-via-cd':U
      143               ,"yes"
      144               ).
      145             old_tipe = "yes".
      146           end.
      147           else
      148           do:
      149             ggoattr:ggoattr-delete(
      150               varnode-code
      151               ,0
      152               ,""
      153               ,0
      154               ,'ban-sales-via-cd':U
      155               ,v-value
      156               ).
      157               old_tipe = ?.
      158   end.
      159           if  old_tipe <> old_val then do:
      160       define variable mImp2CdH as handle no-undo.
      161       run str/imp2cdgeth.p(output mImp2CdH).
      162           for each ub.goods no-lock where ub.goods.grp-code = varnode-code:
      163              run fill-g-list in mImp2CdH  ( input ub.goods.gds-code, input ?, input ?).
      164           END.
      165       END.
      166         end.
      167       end.
      168     end method.
      169   end class.
