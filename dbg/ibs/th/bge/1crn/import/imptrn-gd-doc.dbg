       17   method private void xmlchar-test (input  p-in-string          as character,
       18                                     output p-out-string-enc     as character,
       19                                     output p-out-string-dec    as character):
       20   do
       21   on error undo, return error
       22   :
       23          xmlchar-encode
       24       (
       25             input p-in-string
       26           , output p-out-string-enc
       27       ).
       28          xmlchar-decode
       29       (
       30             input p-out-string-enc
       31           , output p-out-string-dec
       32       ).
       33   end.
       34   end .
       35   method private void xmlchar-encode (input  p-in-string          as character,
       36                                     output p-out-string         as character):
       37       define variable v-position      as integer      no-undo.
       38       define variable v-current-char  as character    no-undo.
       39   do
       40   on error undo, return error
       41   :
       42       assign
       43           p-out-string = "":U
       44       .
       45       case p-in-string
       46       :
       47           when ?
       48           then do:
       49               assign
       50                   p-out-string = "?":U
       51               .
       52           end.
       53           when "?":U
       54           then do:
       55               assign
       56                   p-out-string = "&#63;":U
       57               .
       58           end.
       59           otherwise do:
       60               do v-position = 1 to length( p-in-string )
       61               :
       62                   assign
       63                       v-current-char = substring( p-in-string, v-position, 1 )
       64                   .
       65                   case v-current-char
       66                   :
       67                       when "&":U
       68                       then do:
       69                           assign
       70                               p-out-string = p-out-string + "&amp;":U
       71                           .
       72                       end.
       73                       when ">":U
       74                       then do:
       75                           assign
       76                               p-out-string = p-out-string + "&gt;":U
       77                           .
       78                       end.
       79                       when "<":U
       80                       then do:
       81                           assign
       82                               p-out-string = p-out-string + "&lt;":U
       83                           .
       84                       end.
       85                       when "'":U
       86                       then do:
       87                           assign
       88                               p-out-string = p-out-string + "&apos;":U
       89                           .
       90                       end.
       91                       when '"':U
       92                       then do:
       93                           assign
       94                               p-out-string = p-out-string + "&quot;":U
       95                           .
       96                       end.
       97                       when chr(1)
       98                       then do:
       99                           assign
      100                               p-out-string = p-out-string + "":U
      101                           .
      102                       end.
      103                       when chr(2)
      104                       then do:
      105                           assign
      106                               p-out-string = p-out-string + "":U
      107                           .
      108                       end.
      109                       when chr(3)
      110                       then do:
      111                           assign
      112                               p-out-string = p-out-string + "":U
      113                           .
      114                       end.
      115                       when chr(4)
      116                       then do:
      117                           assign
      118                               p-out-string = p-out-string + "":U
      119                           .
      120                       end.
      121                       when chr(5)
      122                       then do:
      123                           assign
      124                               p-out-string = p-out-string + "":U
      125                           .
      126                       end.
      127                       when chr(6)
      128                       then do:
      129                           assign
      130                               p-out-string = p-out-string + "":U
      131                           .
      132                       end.
      133                       when chr(7)
      134                       then do:
      135                           assign
      136                               p-out-string = p-out-string + "":U
      137                           .
      138                       end.
      139                       when chr(8)
      140                       then do:
      141                           assign
      142                               p-out-string = p-out-string + "":U
      143                           .
      144                       end.
      145                       when chr(9)
      146                       then do:
      147                           assign
      148                               p-out-string = p-out-string + "":U
      149                           .
      150                       end.
      151                       when chr(29)
      152                       then do:
      153                           assign
      154                               p-out-string = p-out-string + "":U
      155                           .
      156                       end.
      157                       when chr(10)
      158                       then do:
      159                           assign
      160                               p-out-string = p-out-string + "&#10;":U
      161                           .
      162                       end.
      163                       when chr(13)
      164                       then do:
      165                           assign
      166                               p-out-string = p-out-string + "&#13;":U
      167                           .
      168                       end.
      169                       otherwise do:
      170                           assign
      171                               p-out-string = p-out-string + v-current-char
      172                           .
      173                       end.
      174                   end case.
      175               end.
      176           end.
      177       end case.
      178   end.
      179   end .
      180   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      181   define variable p-out-string as character no-undo.
      182       define variable v-position      as integer      no-undo.
      183       define variable v-current-char  as character    no-undo.
      184   do
      185   on error undo, return error
      186   :
      187       assign
      188           p-out-string = "":U
      189       .
      190       case p-in-string
      191       :
      192           when ?
      193           then do:
      194               assign
      195                   p-out-string = "?":U
      196               .
      197           end.
      198           otherwise do:
      199               do v-position = 1 to length( p-in-string )
      200               :
      201                   assign
      202                       v-current-char = substring( p-in-string, v-position, 1 )
      203                   .
      204                   case v-current-char
      205                   :
      206                       when chr(1)
      207                       then do:
      208                           assign
      209                               p-out-string = p-out-string + " ":U
      210                           .
      211                       end.
      212                       when chr(2)
      213                       then do:
      214                           assign
      215                               p-out-string = p-out-string + " ":U
      216                           .
      217                       end.
      218                       when chr(3)
      219                       then do:
      220                           assign
      221                               p-out-string = p-out-string + " ":U
      222                           .
      223                       end.
      224                       when chr(4)
      225                       then do:
      226                           assign
      227                               p-out-string = p-out-string + " ":U
      228                           .
      229                       end.
      230                       when chr(5)
      231                       then do:
      232                           assign
      233                               p-out-string = p-out-string + " ":U
      234                           .
      235                       end.
      236                       when chr(6)
      237                       then do:
      238                           assign
      239                               p-out-string = p-out-string + " ":U
      240                           .
      241                       end.
      242                       when chr(7)
      243                       then do:
      244                           assign
      245                               p-out-string = p-out-string + " ":U
      246                           .
      247                       end.
      248                       when chr(8)
      249                       then do:
      250                           assign
      251                               p-out-string = p-out-string + " ":U
      252                           .
      253                       end.
      254                       when chr(9)
      255                       then do:
      256                           assign
      257                               p-out-string = p-out-string + " ":U
      258                           .
      259                       end.
      260                       when chr(29)
      261                       then do:
      262                           assign
      263                               p-out-string = p-out-string + " ":U
      264                           .
      265                       end.
      266                       when chr(10)
      267                       then do:
      268                           assign
      269                               p-out-string = p-out-string + " ":U
      270                           .
      271                       end.
      272                       when chr(13)
      273                       then do:
      274                           assign
      275                               p-out-string = p-out-string + " ":U
      276                           .
      277                       end.
      278                       otherwise do:
      279                           assign
      280                               p-out-string = p-out-string + v-current-char
      281                           .
      282                       end.
      283                   end case.
      284               end.
      285           end.
      286       end case.
      287   end.
      288   return p-out-string.
      289   end .
      290   method private void xmlchar-decode (input  p-in-string          as character,
      291                                     output p-out-string         as character):
      292       define variable v-position      as integer      no-undo.
      293       define variable v-last-position as integer      no-undo.
      294       define variable v-temp-integer  as integer      no-undo.
      295       define variable v-current-char  as character    no-undo.
      296       define variable v-next-char     as character    no-undo.
      297       define variable v-success       as logical      no-undo.
      298   do
      299   on error undo, return error
      300   :
      301       assign
      302           p-out-string = "":U
      303           v-position   = 0
      304       .
      305       replace-cycle:
      306       do while yes
      307       on error undo, return error
      308       :
      309           assign
      310               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      311           .
      312           if v-last-position <= v-position
      313           then do:
      314               if v-position = 0
      315               then do:
      316                   assign
      317                       p-out-string = p-in-string
      318                   .
      319               end.
      320               else do:
      321                   assign
      322                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      323                   .
      324               end.
      325               leave replace-cycle.
      326           end.
      327           else do:
      328               assign
      329                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      330                   v-position      = v-last-position
      331                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      332               .
      333               if v-current-char = "#":U
      334               then do:
      335                   assign
      336                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      337                   .
      338                   if v-last-position > 0
      339                   then do:
      340                       xmlchar-read-integer
      341                        (
      342                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      343                           , output v-temp-integer
      344                           , output v-success
      345                       ).
      346                       if v-success = yes
      347                       and v-temp-integer >= 1
      348                       and v-temp-integer <= 255
      349                       then do:
      350                           assign
      351                               p-out-string = p-out-string + chr( v-temp-integer )
      352                               v-position   = v-last-position + 1
      353                           .
      354                       end.
      355                       else do:
      356                           assign
      357                               p-out-string = p-out-string + "&":U
      358                               v-position   = v-position   + 1
      359                           .
      360                       end.
      361                   end.
      362                   else do:
      363                       assign
      364                           p-out-string = p-out-string + "&":U
      365                           v-position   = v-position   + 1
      366                       .
      367                   end.
      368               end.
      369               else do:
      370                   case substring( p-in-string, v-position + 1, 3 )
      371                   :
      372                       when "lt;":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + "<":U
      376                               v-position   = v-position   + 3
      377                           .
      378                       end.
      379                       when "gt;":U
      380                       then do:
      381                           assign
      382                               p-out-string = p-out-string + ">":U
      383                               v-position   = v-position   + 3
      384                           .
      385                       end.
      386                       otherwise do:
      387                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      388                           then do:
      389                               assign
      390                                   p-out-string = p-out-string + "&":U
      391                                   v-position   = v-position   + 4
      392                               .
      393                           end.
      394                           else do:
      395                               case substring( p-in-string, v-position + 1, 5 )
      396                               :
      397                                   when "quot;":U
      398                                   then do:
      399                                       assign
      400                                           p-out-string = p-out-string + '"':U
      401                                           v-position   = v-position   + 5
      402                                       .
      403                                   end.
      404                                   when "apos;":U
      405                                   then do:
      406                                       assign
      407                                           p-out-string = p-out-string + "'":U
      408                                           v-position   = v-position   + 5
      409                                       .
      410                                   end.
      411                                   otherwise do:
      412                                       assign
      413                                           p-out-string = p-out-string + "&":U
      414                                       .
      415                                   end.
      416                               end case.
      417                           end.
      418                       end.
      419                   end case.
      420               end.
      421           end.
      422       end.
      423   end.
      424   end .
      425   method private void xmlchar-read-integer (input  p-input-string       as character,
      426                                             output p-output-integer     as integer,
      427                                             output p-success            as logical):
      428   do
      429   on error undo, return error
      430   :
      431       assign
      432           p-output-integer = integer( p-input-string )
      433       no-error.
      434       if error-status :error
      435       then do:
      436           assign
      437               p-success           = no
      438               p-output-integer    = 0
      439           .
      440       end.
      441       else do:
      442           assign
      443               p-success           = yes
      444           .
      445       end.
      446   end.
      447   end.
      448   method private void getAttrLib ():
      449      define variable g#attr-lib  as handle no-undo .
      450      run gbl/getgattrlib.p (output g#attr-lib).
      451   end.
      452   define variable mMRCCode  as logical    no-undo.
      453   define variable mTypeMark as character  no-undo.
      454   method private logical IS-NeedMark
      455   ( input ib-code as integer  ,
      456     input ib-str as character ):
      457      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      458      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      459                                    and buf_prod-bc-attr.b-str  eq ib-str
      460                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      461        no-lock no-error.
      462      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      463   end.
      464   method private character repTegforDm
      465   (iDM as char ):
      466       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      467       define variable vteg as character no-undo.
      468       define variable oDM as character no-undo.
      469       define variable vi as integer no-undo.
      470       oDM = iDm.
      471       do vi = 1 to num-entries(vTeglist):
      472          vTeg = entry(vi,vTeglist).
      473          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      474       end.
      475       return oDM.
      476   end.
      477   method private character repSpecSimbforDm
      478   (iDM as char ):
      479       define variable oDM as character no-undo.
      480       xmlchar-decode(iDM, output oDM).
      481     return repTegforDm (oDM).
      482   end.
      483   method private logical CheckGtin
      484   (iGtin as char):
      485      define variable bar_code as character no-undo.
      486      define variable vGtin as logical no-undo init "yes".
      487      if length(iGtin) eq 14
      488      then do:
      489         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      490         run str/chk-sum.p
      491          (input-output bar_code ) no-error .
      492         if iGtin ne  bar_code
      493         then
      494            vGtin = no.
      495      end.
      496      else
      497         vGtin = no.
      498      return vgtin.
      499   end.
      500   method private character repSpecSimbforXlm
      501   (iDM as char ):
      502       iDM = replace(iDM,chr(29),"").
      503       return iDM.
      504   end.
      505   method private character getGtinByDM
      506   (IDM as char):
      507      define variable VTXT as char no-undo.
      508      define variable vGtin as char no-undo.
      509      vTXt = IdM.
      510      vGtin = IDM.
      511      if    length(vtxt) > 14
      512      then do:
      513         if   vtxt begins "(01)"
      514                or vtxt begins "(02)"
      515         then
      516            vGtin = substring(vtxt,5,14).
      517         else if   (vtxt begins "01"
      518                or vtxt begins "02" )
      519                and (   (    substring(iDm,17,2) eq "21"
      520                         and length(vtxt) >= 21)
      521                     or substring(iDm,17,2) eq "37"
      522                     or substring(iDm,17,4) eq "(37)" )
      523         then do:
      524            vGtin = substring(vtxt,3,14).
      525            if not checkGtin(vGtin)
      526            then
      527               vGtin = substring(vtxt,1,14).
      528         end.
      529         else if     length(vtxt) eq 14 + 7 + 4 + 4
      530             or length(vtxt) eq 14 + 7 + 4
      531             or length(vtxt) eq 14 + 7
      532         then
      533            vGtin = substring(vtxt,1,14).
      534      end.
      535      if not checkGtin(vGtin)
      536      then
      537         vGtin = "".
      538      return vgtin.
      539   end.
      540   method private integer getGdsCodeByGtin
      541   (iGtin as char):
      542      define buffer prod-bc  for ub.prod-bc.
      543      define buffer bar-code for ub.bar-code.
      544      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      545      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      546      return if avail bar-code then bar-code.gds-code else ?.
      547   end.
      548   method private decimal getQntyCodeByGtin
      549   (iGtin as char):
      550      define buffer prod-bc  for ub.prod-bc.
      551      define buffer bar-code for ub.bar-code.
      552      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      553      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      554      return if avail bar-code then bar-code.cli-base-rate else ?.
      555   end.
      556   method private integer getGdsCodeByDM
      557   (iDm as char):
      558      define variable vGtin as char no-undo.
      559      define buffer prod-bc for ub.prod-bc.
      560      vGtin  = getGtinByDM (IDM ).
      561      return getGdsCodeByGtin (vGtin).
      562   end.
      563   method private logical ChekTypeMarkByGds
      564   (iGds-code as integer ):
      565      define buffer goods-attr for ub.goods-attr.
      566      find first goods-attr where goods-attr.gds-code   = iGds-code
      567                              and goods-attr.attr-code  = 'mark-type':U
      568      no-lock no-error.
      569      if available goods-attr
      570      then do:
      571         mTypeMark = goods-attr.attr-value.
      572         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      573           .
      574      end.
      575      else
      576         return no.
      577   end.
      578   method private logical ChekTypeMarkByDm
      579   (iDM as char ):
      580      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      581   end.
      582   method private logical ChekTypeMarkByGtin
      583   (iGtin as char ):
      584      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      585   end.
      586   method private character  GetNextElement
      587     (input iAllTeg        as logical
      588     ,output oteg          as character
      589     ,output otegval       as character
      590     ,input-output pstr    as character
      591      ):
      592        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      593        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      594        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      595        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      596        define variable vTeg as character no-undo.
      597        define variable vLength as integer no-undo.
      598        define variable vi as integer no-undo.
      599        define variable vj as integer no-undo.
      600        define buffer code for ub.code.
      601        find first code where Code.parent eq "MarkType"
      602                          and Code.CodeValue   eq mTypeMark
      603                          no-lock no-error.
      604        if     available code
      605           and Code.misc1 ne ""
      606           and Code.misc1 ne ?
      607        then do:
      608           integer (Code.misc1) no-error.
      609           if not error-status:error
      610           then
      611             entry (4,vlistleng) = Code.misc1.
      612        end.
      613        if iAllTeg
      614        then
      615           assign
      616              vlistElem     = vlistElem    + vlistElemDop
      617              vlistleng     = vlistleng    + vlistlengDop
      618           .
      619        else if mMRCCode
      620        then
      621           assign
      622              vlistElem     = vlistElem    + ",(8005),8005"
      623              vlistleng     = vlistleng    + ",000006,0006"
      624           .
      625       block-elem:
      626       do vi = 1 to num-entries(vlistElem):
      627          vTeg = entry(vi,vlistElem).
      628          if pstr begins vTeg
      629          then do:
      630             if    vTeg eq "21"
      631             then
      632                vLength = index(pstr,chr(29)) - 2 no-error.
      633             if vLength  <= 0
      634             then
      635                vLength = int(entry(vi,vlistleng)).
      636             otegval = substring (pstr,length(vteg) + 1, vLength).
      637             oteg = replace(replace(vteg,")",""),"(","").
      638             vTeg = vteg + otegval.
      639             otegval = replace(otegval,chr(29),"").
      640             oteg = replace(replace(oteg,")",""),"(","").
      641             pstr = substring (pstr,length(vTeg)+ 1).
      642             vTeg = replace(vTeg,chr(29),"").
      643             leave block-elem.
      644          end.
      645          else
      646             vTeg = "".
      647       end.
      648       return vteg.
      649   end.
      650   method private character  GetCodeIdent
      651   (iDm as char):
      652      define variable Velement   as character no-undo init "first".
      653      define variable oCodeIdent as character no-undo.
      654      define variable vteg as character no-undo.
      655      define variable vtegval as character no-undo.
      656      define variable vGtin as character no-undo.
      657      define buffer marking for ub.marking.
      658      for first marking no-lock where
      659                marking.mark eq iDm
      660            and marking.unit-ext = "LEVEL2"
      661      :
      662        return iDm.
      663      end.
      664      vGtin  = getGtinByDM (iDm ).
      665      ChekTypeMarkByDm(idm).
      666      if iDm begins 'tech_':U
      667      then
      668         oCodeIdent = iDm.
      669      else if length(iDm) < 21
      670      then do:
      671         find first marking where marking.mark eq idm
      672         no-lock no-error.
      673         oCodeIdent = if available marking then marking.mark else  ?.
      674      end.
      675      else if     length(iDm) eq 29
      676         and not iDm begins "01"
      677         and not iDm begins "02"
      678      then
      679         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      680      else  if     length(iDm) >= 24
      681               and (  iDm begins "01"
      682                   or iDm begins "02")
      683               and  substring(iDm,17,2) ne "21"
      684      then do:
      685         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      686                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      687         then
      688            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      689         else
      690            oCodeIdent = iDM.
      691      end.
      692      else  if     (   length(iDm) eq 25
      693                    or length(iDm) eq 21)
      694               and (not iDm begins "01"
      695               and  not iDm begins "02")
      696      then
      697         oCodeIdent = substring(iDm,1,21).
      698      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      699      then
      700         oCodeIdent = substring(iDm,1,21).
      701      else do while Velement ne "" and idm ne "":
      702         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      703         oCodeIdent = oCodeIdent + Velement.
      704      end.
      705      return oCodeIdent.
      706   end.
      707   method private character  GetTegCod
      708   (icodeIdent as char, iTeg as char):
      709      define variable Velement   as character no-undo init "first".
      710      define variable oTeg as character no-undo init ?.
      711      define variable vteg as character no-undo.
      712      define variable vtegval as character no-undo.
      713      if     ((length(icodeIdent) eq 21
      714         and not icodeIdent begins "01"
      715         and not icodeIdent begins "02")
      716         or
      717             ( length(icodeIdent) eq 25
      718               and not icodeIdent begins "01"
      719               and not icodeIdent begins "02"))
      720      then do:
      721         if iTeg eq "01" or iTeg eq "02"
      722         then
      723            oTeg = substring(icodeIdent,1,21).
      724         else  if  iTeg eq "21"
      725         then
      726            oTeg = substring(icodeIdent,15,7).
      727      end.
      728      else do:
      729         ChekTypeMarkByDm(icodeIdent).
      730         block-teg:
      731            do while Velement ne "" and icodeIdent ne "":
      732            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      733            if    Velement begins iTeg
      734               or Velement begins "(" + iTeg + ")"
      735            then do:
      736               oTeg = vtegval.
      737               leave block-teg.
      738            end.
      739         end.
      740      end.
      741      return oTeg.
      742   end.
      743   method private logical isOAD
      744   (icodeIdent as character):
      745      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      746   end.
      747   method private logical isMark
      748   (icodeIdent as character):
      749      define buffer buf_marking for ub.marking.
      750      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      751             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      752   end.
      753   method private character  addBracketForCode
      754   (icodeIdent as char):
      755      define variable Velement   as character no-undo init "first".
      756      define variable oTeg as character no-undo.
      757      define variable vteg as character no-undo.
      758      define variable vtegval as character no-undo.
      759      define buffer marking for ub.marking.
      760      find first marking no-lock where
      761                 marking.mark begins icodeIdent no-error.
      762      if    not ChekTypeMarkByDm(icodeIdent)
      763         or length(icodeIdent) le 24
      764         or (avail marking and marking.unit-ext = "LEVEL2")
      765      then
      766         oTeg = icodeIdent.
      767      else do:
      768         if (  icodeIdent begins "01"
      769            or icodeIdent begins "02"
      770            ) and CheckGtin(substring (icodeIdent,3,14))
      771            and substring (icodeIdent,17,2) eq "21"
      772         then do:
      773            mMRCCode = yes.
      774            ChekTypeMarkByDm(icodeIdent).
      775            block-teg:
      776            do while Velement ne "" and icodeIdent ne "":
      777               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      778               if vteg ne ""
      779               then
      780                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      781            end.
      782            mMRCCode = no.
      783         end.
      784         else do:
      785            oTeg = icodeIdent.
      786         end.
      787      end.
      788      return oTeg.
      789   end.
      790   method private integer getlevelByCodId
      791   (iCode as char):
      792      define variable vLength as int no-undo.
      793      define variable vLevel  as int no-undo.
      794      if not ChekTypeMarkByDM (icode) then return ?.
      795      vLength = length(iCode).
      796      if    vLength eq 18
      797         or vLength eq 20
      798      then
      799         Vlevel = 4.
      800      else if vLength eq 21
      801      then
      802         Vlevel = 1.
      803      else if vLength eq 25
      804      then do:
      805         if  iCode begins "01"
      806         then
      807            Vlevel = 3.
      808         else
      809            Vlevel = 1.
      810      end.
      811      else if     vLength >= 26
      812              and vLength <= 46
      813      then do:
      814         if    substring(iCode,17,2) eq "11"
      815            or substring(iCode,17,2) eq "13"
      816            or (    substring(iCode,17,2) eq "21"
      817                and vLength >= 33
      818                and substring(iCode,26,4) ne "8005")
      819         then
      820            Vlevel = 4.
      821         else if    vLength eq 31
      822                 or vLength eq 38
      823                 or vLength eq 39
      824                 or vLength eq 45
      825         then
      826            Vlevel = 1.
      827         else if    vLength eq 35
      828                 or vLength eq 43
      829         then
      830            Vlevel = 3.
      831         else
      832            Vlevel = ?.
      833      end.
      834      else
      835         Vlevel = ?.
      836      return Vlevel.
      837   end.
      838   method private character  getLevelMotpBycodid
      839   (iDm as char):
      840      define variable vLevel as integer no-undo.
      841      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      842      vLevel = getlevelByCodId(iDm).
      843      if    vLevel eq ?
      844         or vLevel < 1
      845         or vLevel > 6
      846      then
      847         return ?.
      848      else
      849         return entry(vlevel,vList).
      850   end.
      851   method private character    getLevelUTDByLevelMotp
      852   (iUnit as char):
      853      define variable vLevel as integer no-undo.
      854      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      855      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      856      vLevel = lookup(iUnit,vListMOTP).
      857      if    vLevel eq ?
      858         or vLevel < 1
      859         or vLevel > 4
      860      then
      861         return ?.
      862      else
      863         return entry(vlevel,vListutd).
      864   end.
      865   method private character  getLevelMotpByDM
      866   (iDm as char):
      867      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      868   end.
      869   method private character  getLevelUTDByCodId
      870   (iDm as char):
      871      define variable vLevel as integer no-undo.
      872      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      873      vLevel = getlevelByCodId(iDm).
      874      if    vLevel eq ?
      875         or vLevel < 1
      876         or vLevel > 4
      877      then
      878         return ?.
      879      else
      880         return entry(vlevel,vList).
      881   end.
      882   method private character  getLevelUTDByDM
      883   (iDm as char):
      884      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      885   end.
      886   define variable mNotMarkQnty as logical no-undo.
      887   method private decimal getQntyUTDByCodId
      888   (iDM as char):
      889      define variable vLevel as integer no-undo.
      890      define variable vList as character no-undo init "1,5,10,500".
      891      define variable vGtin as character no-undo.
      892      define variable vqnty as decimal no-undo init ?.
      893      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      894      if vqnty eq ?
      895      then do:
      896         if not mNotMarkQnty
      897         then do:
      898            define buffer marking for ub.marking.
      899            define variable vCodident as character no-undo.
      900            vCodident = GetCodeIdent(idm).
      901            find first marking where marking.mark begins vCodident no-lock no-error.
      902            if     available marking
      903               and marking.box-qnty ne ?
      904            then
      905               return marking.box-qnty.
      906         end.
      907         vGtin = getGtinByDm(iDM).
      908         if ChekTypeMarkByGtin (vGtin)
      909         then do:
      910            vLevel = getlevelByCodId(iDM).
      911            if     vLevel >= 1
      912               and vLevel <= 4
      913            then
      914               vqnty = int(entry(vlevel,vList)).
      915         end.
      916         else
      917            vqnty = getQntyCodeByGtin(vgtin).
      918      end.
      919      return vqnty.
      920   end.
      921   method private decimal getQntyUTDByDM
      922   (iDm as char):
      923      define variable vDM as character no-undo.
      924      if     length (iDm) ne 25
      925         and length (iDm) ne 29
      926         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      927      then
      928         vDM = substring (iDm,1,length (iDm) - 6 ).
      929      else
      930         vDM = substring (iDm,1,length (iDm) - 4 ).
      931      return getQntyUTDByCodId(vDM).
      932   end.
      933   method private decimal    getMRC4
      934   (iMRC as char):
      935      define variable oMrc     as decimal no-undo init ?.
      936      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      937      define variable vi       as integer no-undo.
      938      define variable vfound   as integer no-undo.
      939      define variable vposStart   as integer no-undo.
      940      do:
      941      OMRc = 0.
      942      do vi = 1 to 4:
      943         define variable vsimb as character no-undo.
      944         vsimb = substring(iMRC,vi,1).
      945         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      946         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      947         if vfound > 0
      948         then
      949            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      950         end.
      951         OMRc = OMRc / 100.
      952      end.
      953      return OMRc.
      954   end.
      955   method private decimal    getMRCByDM
      956   (iDm as char):
      957      define variable vMRC     as character no-undo.
      958      define variable oMrc     as decimal no-undo init ?.
      959      define variable Velement as character no-undo init "empty".
      960      define variable vteg as character no-undo.
      961      define variable vtegval as character no-undo.
      962      if    length(idm) eq 14 + 7 + 4 + 4
      963         or length(idm) eq 14 + 7 + 4
      964      then do:
      965         vMRC = substring(idm,22,4).
      966         omrc = getMRC4(vMRC).
      967      end.
      968      else do:
      969          ChekTypeMarkByDm(iDm).
      970          block-mrc:
      971          do while Velement ne "" and idm ne "":
      972             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      973             if Velement begins "8005"
      974             then do:
      975                vMRC = substring(Velement,5,6).
      976                leave block-mrc.
      977             end.
      978             else if Velement begins "(8005)"
      979             then do:
      980                vMRC = substring(Velement,7,6).
      981                leave block-mrc.
      982             end.
      983          end.
      984          if vMRC ne ""
      985          then
      986             OMRc = dec(vmrc) / 100 no-error.
      987      end.
      988      return OMRc.
      989   end.
      990   method private date    MoveDate
      991   (idate as date,
      992    iMonth as int64):
      993      define variable vMonth   as int64 no-undo.
      994      define variable vYear    as int64 no-undo.
      995      define variable vDateNew as date  no-undo.
      996       define variable vDay     as int64 no-undo.
      997       vMonth = month(iDate) + iMonth.
      998       vYear =  year(iDate).
      999       if vMonth <= 0
     1000       then assign
     1001          vMonth = vMonth + 12
     1002           vYear  = vYear - 1
     1003       .
     1004       else if vMonth > 12
     1005       then assign
     1006          vMonth = vMonth - 12
     1007           vYear  = vYear + 1
     1008       .
     1009       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1010       do while error-status:error eq yes:
     1011          VDay = vDay + 1.
     1012          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1013       end.
     1014       if VDay > 0
     1015       then
     1016          vDateNew + 1.
     1017       return vDateNew.
     1018   end.
     1019   method private logical    checkEMRC
     1020   (input  iDm as char,
     1021    output vOk as logical):
     1022      define variable v-value-emrc as character no-undo.
     1023      define variable v-type-emrc  as character no-undo.
     1024      define variable vDateIso     as character no-undo.
     1025      define variable vMRC         as decimal no-undo.
     1026      define variable vqnty        as decimal no-undo.
     1027      define variable vPrice       as decimal no-undo.
     1028      define variable vparent      as character no-undo.
     1029      define variable vgds-code    as integer no-undo.
     1030      define buffer code for ub.code.
     1031      vMRC = getMRCByDM(iDm).
     1032      if vMRC > 0
     1033      then do:
     1034         vgds-code = getGdsCodeByDM(iDm).
     1035         vqnty     = getQntyUTDByDM(iDm).
     1036               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1037            (
     1038             input   vgds-code
     1039            ,input   'emrc-type':U
     1040            ,output   v-value-emrc
     1041            ,output   v-type-emrc
     1042          ) no-error.
     1043          if     v-value-emrc ne ""
     1044             and v-value-emrc ne ?
     1045          then do:
     1046             vDateIso = iso-date(today).
     1047             vPrice = vMRC / vqnty.
     1048             vparent ="emc" + chr(4) + v-value-emrc.
     1049             find last code where Code.parent      eq vparent
     1050                              and Code.code        le vDateIso
     1051                              and code.status_  eq 0
     1052             no-lock no-error.
     1053             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1054             then
     1055                vOk = true .
     1056             else do:
     1057                 define variable vText      as character no-undo.
     1058                 define variable vDate      as date no-undo.
     1059                 define variable vDateLast  as character no-undo.
     1060                 define variable vDateFirst as character no-undo.
     1061                 define variable vDate3     as date no-undo.
     1062                 vdate = date(code.misc1).
     1063                 vDateLast = code.misc1.
     1064                 vDate3 = MoveDate(today, - 3 ).
     1065                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1066                                      string(vDate3  , "99/99/9999"),
     1067                                      string(vDate   , "99/99/9999")
     1068                                      ).
     1069                 vdateIso = iso-date(vdate3).
     1070                 find last code  where Code.parent      eq vparent
     1071                                   and Code.code        le vDateIso
     1072                                   and code.status_  eq 0 no-lock no-error.
     1073                 if available code
     1074                 then
     1075                    vDateIso = code.code.
     1076                 vDateFirst = vDateIso.
     1077                 vDateLast = iso-date(vdate).
     1078                 define variable vGood as logical no-undo.
     1079                 define variable vDateSale as date no-undo.
     1080                 define buffer bcode for code.
     1081                 for last code where Code.parent   eq vparent
     1082                                 and code.status_  eq 0
     1083                                 and code.code     < vDateLast
     1084                                 and code.code     >= vDateFirst
     1085                 no-lock:
     1086                    find first bcode where bCode.parent   eq vparent
     1087                                       and bcode.status_  eq 0
     1088                                       and bcode.code     > code.code no-lock no-error.
     1089                    if available bcode
     1090                    then do:
     1091                       if vPrice < dec(Code.CodeValue)
     1092                       then
     1093                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1094                                                     chr(10),
     1095                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1096                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1097                                                     ).
     1098                       else do:
     1099                          vGood = yes.
     1100                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1101                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1102                                                     chr(10),
     1103                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1104                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1105                                                     string(         vDateSale            ,"99/99/9999"),
     1106                                                     string(vDateSale - today)
     1107                                                     ).
     1108                       end.
     1109                    end.
     1110                 end.
     1111                 if vgood
     1112                 then do:
     1113                    define variable choice as integer no-undo .
     1114                    run gbl/d-askw.w (input "Уточнение"
     1115                           ,input  vText
     1116                           ,input "|"
     1117                           ,input "Принять|Вернуть"
     1118                           ,input "Принять данный товар|Вернуть товар постащику"
     1119                           ,input 1
     1120                           ,input 2
     1121                           ,output choice) no-error.
     1122                    vok = choice eq 1.
     1123                 end.
     1124                 else
     1125                    vok =false.
     1126             end.
     1127          end.
     1128      end.
     1129   end.
     1130   method private character addGs2Mark
     1131   (iMark as char):
     1132      define variable vDM   as character no-undo.
     1133      define variable vIdx  as integer   no-undo.
     1134      if index(iMark,chr(29),1) > 0
     1135      then return iMark.
     1136      if substring(iMark,26,4) = "8005" then
     1137      do:
     1138        vIdx = index(iMark,"93",26 + 4 + 5).
     1139        if vIdx > 1 then do:
     1140          vDM = substitute("&1&4&2&4&3",
     1141                           substring(iMark,1,25),
     1142                           substring(iMark,26,vIdx - 25 - 1),
     1143                           substring(iMark,vIdx),
     1144                           chr(29)) no-error.
     1145          vIdx = index(vDm,"240",vIdx + 4).
     1146          if vIdx > 0 then
     1147          do:
     1148            vDM = substitute("&1&3&2",
     1149                             substring(vDm,1,vIdx - 1),
     1150                             substring(vDm,vIdx),
     1151                             chr(29)) no-error.
     1152          end.
     1153        end.
     1154        else
     1155          vDM = substitute("&1&3&2",
     1156                           substring(iMark,1,25),
     1157                           substring(iMark,26),
     1158                           chr(29)) no-error.
     1159      end.
     1160      else if substring(iMark,32,2) = "91" then
     1161      do:
     1162        vIdx = index(iMark,"92",32).
     1163        if vIdx > 1 then
     1164          vDM = substitute("&1&4&2&4&3",
     1165                           substring(iMark,1,31),
     1166                           substring(iMark,32,vIdx - 31 - 1),
     1167                           substring(iMark,vIdx),
     1168                           chr(29)) no-error.
     1169        else
     1170          vDM = substitute("&1&3&2",
     1171                           substring(iMark,1,31),
     1172                           substring(iMark,32),
     1173                           chr(29)) no-error.
     1174      end.
     1175      else if substring(iMark,39,2) = "91" then
     1176      do:
     1177        vIdx = index(iMark,"92",38).
     1178        if vIdx > 1 then
     1179          vDM = substitute("&1&4&2&4&3",
     1180                           substring(iMark,1,38),
     1181                           substring(iMark,39,vIdx - 38 - 1),
     1182                           substring(iMark,vIdx),
     1183                           chr(29)) no-error.
     1184        else
     1185          vDM = substitute("&1&3&2",
     1186                           substring(iMark,1,38),
     1187                           substring(iMark,39),
     1188                           chr(29)) no-error.
     1189      end.
     1190      else if substring(iMark,25,2) = "93" then
     1191      do:
     1192        vIdx = index(iMark,"92",25).
     1193        if vIdx > 1 then
     1194          vDM = substitute("&1&4&2&4&3",
     1195                           substring(iMark,1,24),
     1196                           substring(iMark,25,vIdx - 24 - 1),
     1197                           substring(iMark,vIdx),
     1198                           chr(29)) no-error.
     1199        else
     1200          vIdx = index(iMark,"3103",25).
     1201          if vIdx > 0 then
     1202          vDM = substitute("&1&4&2&4&3",
     1203                           substring(iMark,1,24),
     1204                           substring(iMark,25,vIdx - 24 - 1),
     1205                           substring(iMark,vIdx),
     1206                           chr(29)) no-error.
     1207          else
     1208            vDM = substitute("&1&3&2",
     1209                             substring(iMark,1,24),
     1210                             substring(iMark,25),
     1211                             chr(29)) no-error.
     1212      end.
     1213      else if substring(iMark,32,2) = "93" then
     1214      do:
     1215        vDM = substitute("&1&3&2",
     1216              substring(iMark,1,31),
     1217              substring(iMark,32),
     1218              chr(29)) no-error.
     1219      end.
     1220      return if vDM <> "" then vDm else iMark.
     1221   end.
     1222     define temp-table TempTrnDoc no-undo
     1223       field line-num      as integer
     1224       field ext-doc-code  as character
     1225       field doc-date      as date
     1226       field ext-doc-type  as character
     1227       field cli-type      as character
     1228       field cli-code      as integer
     1229       field obj-type      as character
     1230       field obj-code      as integer
     1231       field ps            as character
     1232       field doc-id        as character
     1233       field dog-code      as character
     1234       field source-doc    as character
     1235       field out-code      as character
     1236       index pi line-num ext-doc-code
     1237     .
     1238     define temp-table TempDocLine no-undo
     1239       field line-num     as integer
     1240       field gds-code     as integer
     1241       field doc-qnty     as decimal
     1242       field fact-qnty    as decimal
     1243       field price-rubl   as decimal
     1244       field RowSum       as decimal
     1245       field vat-pc       as decimal
     1246       field fact-dnsty   as decimal
     1247       field cli-qnty     as decimal
     1248       field koef         as decimal
     1249       field unit-code    as character
     1250       field b-code       as character
     1251       field is-tsd-qnty  as logical init no
     1252       field vsd-uuid     as character
     1253       field part-id      as character
     1254       field aclMarksList as character
     1255       field PartIDTH     as character
     1256       index pi
     1257       line-num
     1258       gds-code
     1259     .
     1260     define temp-table TempDocPart no-undo
     1261       field gds-code     as integer
     1262       field doc-qnty     as decimal
     1263       field fact-qnty    as decimal
     1264       field price-rubl   as decimal
     1265       field vat-pc       as decimal
     1266       field fact-dnsty   as decimal
     1267       field vsd-uuid     as character
     1268       field part-id      as character
     1269       field in-doc-id    as character
     1270       field edoc-id      as character
     1271       index pi
     1272       in-doc-id
     1273       part-id
     1274       gds-code
     1275     .
     1276     define temp-table TempDocMark no-undo
     1277       field gtin as character
     1278       field gtin_qnt as integer
     1279       field upd_id as character
     1280       field prt-id as character
     1281       field in-doc-id as character
     1282       field mark as character
     1283       field gds-code as integer
     1284       index pi mark
     1285     .
     1286     define buffer buf_clients for ub.clients.
     1287     define property Msg as character no-undo
     1288       get.
     1289       set.
     1290     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
     1291       define variable v-doc-rec as recid     no-undo.
     1292       define variable result    as logical   no-undo.
     1293       define variable v-valid-prt-trn as logical no-undo .
     1294       define variable glog      as logical   no-undo.
     1295       define variable mode      as character no-undo.
     1296       define variable ii        as integer   no-undo.
     1297       define variable jj        as integer   no-undo.
     1298       define variable mMRCCodeSave as logical   no-undo.
     1299       define variable objTrnDoc  as class     trn-gd-doc-in   no-undo.
     1300       define variable objGd      as class     trn-gd          no-undo.
     1301       define variable objPrt     as class     trn-prt         no-undo.
     1302       define variable objMark    as class     trn-mark        no-undo.
     1303       define variable adapObj    as class     AdapterOra-i516-1c no-undo.
     1304       define variable objGds     as class     subjects        no-undo.
     1305       define variable objPrts    as class     subjects        no-undo.
     1306       define variable objMarks   as class     subjects        no-undo.
     1307       objTrnDoc = cast (subjectObj, trn-gd-doc-in).
     1308       adapObj = new AdapterOra-i516-1c ().
     1309       mMRCCodeSave = mMRCCode.
     1310       mMRCCode  = yes.
     1311       find first ub.sys-ctrl no-lock.
     1312       find first buf_clients where buf_clients.db-num = ub.sys-ctrl.db-num.
     1313       empty temp-table TempTrnDoc.
     1314       empty temp-table TempDocLine.
     1315       empty temp-table TempDocMark.
     1316       empty temp-table TempDocPart.
     1317       create TempTrnDoc.
     1318       assign
     1319         TempTrnDoc.obj-type = buf_clients.obj-type
     1320         TempTrnDoc.obj-code = buf_clients.obj-code
     1321         TempTrnDoc.doc-date = objTrnDoc:doc-date
     1322         TempTrnDoc.doc-id = objTrnDoc:doc-id
     1323         TempTrnDoc.dog-code = objTrnDoc:dog-code
     1324         TempTrnDoc.source-doc = objTrnDoc:source-doc
     1325       .
     1326       case trim (objTrnDoc:doc-type, '0'):
     1327         when '1' then do:
     1328           assign
     1329             TempTrnDoc.ext-doc-code = objTrnDoc:doc-code
     1330             TempTrnDoc.cli-type = "орг"
     1331             TempTrnDoc.cli-code = integer (objTrnDoc:contr-code)
     1332           .
     1333         end.
     1334         when '4' then do:
     1335           assign
     1336             TempTrnDoc.ext-doc-type = 'iv':U
     1337             TempTrnDoc.ext-doc-code = replace (objTrnDoc:doc-code, "-", "=")
     1338             TempTrnDoc.cli-type = "маг"
     1339             TempTrnDoc.cli-code = integer (objTrnDoc:fuel-st-code)
     1340             TempTrnDoc.out-code = objTrnDoc:doc-code
     1341           .
     1342         end.
     1343         when '8' then do:
     1344           assign
     1345             TempTrnDoc.ext-doc-type = 'rv':U
     1346             TempTrnDoc.ext-doc-code = replace (objTrnDoc:doc-code, "=", "*")
     1347             TempTrnDoc.cli-type = "маг"
     1348             TempTrnDoc.cli-code = integer (objTrnDoc:fuel-st-code)
     1349             TempTrnDoc.out-code = objTrnDoc:doc-code
     1350           .
     1351         end.
     1352         when '2' then do:
     1353           TempTrnDoc.ext-doc-type = 'ee':U .
     1354         end.
     1355         otherwise do:
     1356           Msg = "Не поддерживаемый тип документа на загрузку: " + objTrnDoc:doc-type.
     1357           return false.
     1358         end.
     1359       end case.
     1360       objGds = objTrnDoc:GDS.
     1361       objPrts = objTrnDoc:prts.
     1362       v-valid-prt-trn = no .
     1363       do ii = 1 to objGds:Get(ii):
     1364         objGd = cast (objGds:SubjectObjCurr, trn-gd).
     1365         objMarks = objGd:marks.
     1366         if valid-object (objPrts)
     1367         then do jj = 1 to objPrts:Get(jj):
     1368           objPrt =  cast (objPrts:SubjectObjCurr, trn-prt).
     1369           if objPrt:gd-line-num > ""
     1370           then do :
     1371             v-valid-prt-trn = yes .
     1372           end .
     1373           if objPrt:gd-line-num = objGd:line-num
     1374           then do:
     1375             create TempDocLine.
     1376             assign
     1377               TempDocLine.gds-code = objGd:gd-code
     1378               TempDocLine.fact-qnty = objPrt:qnty
     1379               TempDocLine.doc-qnty = objPrt:qnty
     1380               TempDocLine.vsd-uuid = objPrt:vad-guid
     1381               TempDocLine.part-id = objPrt:prt-id
     1382               TempDocLine.price-rubl = objGd:sum / objGd:qnty-fact
     1383               TempDocLine.vat-pc = if objGd:nds-code > 0 then objGd:nds-code else (objGd:sum-nds / (objGd:sum - objGd:sum-nds)) * 100.
     1384           end.
     1385         end.
     1386         if not v-valid-prt-trn
     1387         then do :
     1388           objPrts = objGd:prts .
     1389           if valid-object (objPrts)
     1390           then do jj = 1 to objPrts:Get(jj):
     1391             objPrt =  cast (objPrts:SubjectObjCurr, trn-prt).
     1392             if objPrt:gds-code = objGd:gd-code
     1393             then do :
     1394               create TempDocPart .
     1395               assign
     1396                 TempDocPart.gds-code = objGd:gd-code
     1397                 TempDocPart.doc-qnty = objPrt:qnty-ttn
     1398                 TempDocPart.fact-qnty = objPrt:qnty-fact
     1399                 TempDocPart.price-rubl = objPrt:sum / objPrt:qnty-fact
     1400                 TempDocPart.vat-pc = if objPrt:nds-code > 0 then objPrt:nds-code else (objPrt:sum-nds / (objPrt:sum - objPrt:sum-nds)) * 100
     1401                 TempDocPart.part-id = objPrt:prt-id
     1402                 TempDocPart.in-doc-id = objPrt:in-doc-id
     1403                 TempDocPart.edoc-id = objPrt:edoc-id
     1404                 TempDocPart.vsd-uuid = objPrt:vad-guid
     1405               .
     1406             end .
     1407           end .
     1408         end .
     1409         if available (TempDocLine)
     1410         then do:
     1411           release TempDocLine.
     1412           next.
     1413         end.
     1414         else do:
     1415           create TempDocLine.
     1416           assign
     1417             TempDocLine.gds-code = objGd:gd-code
     1418             TempDocLine.fact-qnty = objGd:qnty-fact
     1419             TempDocLine.doc-qnty = objGd:qnty-ttn
     1420             TempDocLine.price-rubl = objGd:sum / objGd:qnty-fact
     1421             TempDocLine.vat-pc = if objGd:nds-code > 0 then objGd:nds-code else (objGd:sum-nds / (objGd:sum - objGd:sum-nds)) * 100
     1422             TempDocLine.koef = objGd:koef
     1423             TempDocLine.unit-code = objGd:unit-code
     1424           .
     1425           release TempDocLine.
     1426         end.
     1427         if valid-object (objMarks)
     1428         then do jj = 1 to objMarks:Get(jj):
     1429           objMark = cast (objMarks:SubjectObjCurr, trn-mark).
     1430           if objMark:gds-code = objGd:gd-code
     1431           then do :
     1432             create TempDocMark.
     1433             assign
     1434             TempDocMark.mark = GetCodeIdent(repTegforDm(objMark:mark-code))
     1435               TempDocMark.prt-id = objMark:prt-id
     1436               TempDocMark.in-doc-id = objMark:in-doc-id
     1437               TempDocMark.gtin = objMark:gtin
     1438               TempDocMark.gtin_qnt = objMark:gtin_qnt
     1439               TempDocMark.upd_id = objMark:upd_id
     1440               TempDocMark.gds-code = objGd:gd-code
     1441             .
     1442           end .
     1443         end.
     1444       end.
     1445       adapObj:SetTempTable(table TempTrnDoc, table TempDocLine, table TempDocPart, table TempDocMark, "").
     1446       adapObj:WriteDB(output glog).
     1447       if error-status:error then
     1448       do:
     1449         Msg = return-value.
     1450         result = false.
     1451       end.
     1452       else do:
     1453         result = true.
     1454       end.
     1455           mMRCCode = mMRCCodeSave.
     1456       return result.
     1457     end method.
     1458   end class.
