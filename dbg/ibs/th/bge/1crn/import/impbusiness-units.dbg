        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impbusiness-units implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9       define buffer buf_regions for regions.
       10       define variable objBusiness as class business-units no-undo.
       11       objBusiness = cast (subjectObj, business-units).
       12       on write  of ub.regions override
       13         do:
       14         end.
       15       on delete of ub.regions override
       16         do:
       17         end.
       18       do
       19         on error undo, return error
       20         :
       21         if objBusiness:del-f = 1 then
       22         do:
       23           for each buf_regions exclusive-lock where
       24             buf_regions.reg-code = integer (objBusiness:code_):
       25             delete buf_regions.
       26           end.
       27         end.
       28         else
       29         do:
       30           find first buf_regions exclusive-lock where
       31             buf_regions.reg-code = integer (objBusiness:code_) no-error .
       32           if AVAILABLE buf_regions then
       33           do:
       34             assign
       35               buf_regions.reg-name = objBusiness:name_
       36               buf_regions.status_  = objBusiness:del-l
       37               .
       38           end.
       39           else
       40           do:
       41             create buf_regions.
       42             assign
       43               buf_regions.reg-code = integer (objBusiness:code_)
       44               buf_regions.reg-name = objBusiness:name_
       45               buf_regions.status_  = objBusiness:del-l
       46               .
       47           end.
       48         end.
       49       end.
       50     end method.
       51   end class.
