        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impreasons-suspicious-check implements ibs.th.bge.1crn.import.iimpsubject:
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7       define buffer buf_code for ub.code .
        8       define variable v-code as character no-undo .
        9       define property Msg as character no-undo
       10           get.
       11           set.
       12       method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       13           define variable ri        as recid no-undo .
       14           define variable objReason as class reasons-suspicious-check no-undo.
       15           objReason = cast (subjectObj, reasons-suspicious-check).
       16           if objReason:code_ = "" or objReason:code_ = ? then
       17           do:
       18               Msg = "Причина подозрительных чеков не задана".
       19               return error Msg .
       20           end.
       21           if objReason:name_ = "" or objReason:name_ = ? then
       22           do:
       23               Msg = "Причина подозрительных чеков с кодом " + objReason:code_ + ". Не задано наименование" .
       24               return error Msg .
       25           end.
       26           find first buf_code where buf_code.parent eq ""
       27               and buf_code.code   eq 'reasons-suspicious-check':U
       28               exclusive-lock no-error.
       29           if not available buf_code
       30               then
       31           do:
       32               create buf_code.
       33               assign
       34                   buf_code.parent = ""
       35                   buf_code.code   = 'reasons-suspicious-check':U
       36                   .
       37           end.
       38           assign
       39               buf_code.Codename = 'Справочник "Причины подозрительных чеков"'
       40               buf_code.nwsgbd   = yes
       41               buf_code.export_  = yes
       42               buf_code.procview = ""
       43               .
       44           find first buf_code exclusive-lock where buf_code.code = objReason:code_
       45               and buf_code.parent = 'reasons-suspicious-check':U
       46               no-error .
       47           if available buf_code
       48               then
       49           do:
       50               delete buf_code .
       51           end .
       52           create buf_code .
       53           assign
       54               buf_code.parent   = 'reasons-suspicious-check':U
       55               buf_code.code     = objReason:code_
       56               buf_code.CodeName = objReason:name_
       57               buf_code.status_  = objReason:del-l
       58               .
       59       end method.
       60   end class.
