       14   method private void xmlchar-test (input  p-in-string          as character,
       15                                     output p-out-string-enc     as character,
       16                                     output p-out-string-dec    as character):
       17   do
       18   on error undo, return error
       19   :
       20          xmlchar-encode
       21       (
       22             input p-in-string
       23           , output p-out-string-enc
       24       ).
       25          xmlchar-decode
       26       (
       27             input p-out-string-enc
       28           , output p-out-string-dec
       29       ).
       30   end.
       31   end .
       32   method private void xmlchar-encode (input  p-in-string          as character,
       33                                     output p-out-string         as character):
       34       define variable v-position      as integer      no-undo.
       35       define variable v-current-char  as character    no-undo.
       36   do
       37   on error undo, return error
       38   :
       39       assign
       40           p-out-string = "":U
       41       .
       42       case p-in-string
       43       :
       44           when ?
       45           then do:
       46               assign
       47                   p-out-string = "?":U
       48               .
       49           end.
       50           when "?":U
       51           then do:
       52               assign
       53                   p-out-string = "&#63;":U
       54               .
       55           end.
       56           otherwise do:
       57               do v-position = 1 to length( p-in-string )
       58               :
       59                   assign
       60                       v-current-char = substring( p-in-string, v-position, 1 )
       61                   .
       62                   case v-current-char
       63                   :
       64                       when "&":U
       65                       then do:
       66                           assign
       67                               p-out-string = p-out-string + "&amp;":U
       68                           .
       69                       end.
       70                       when ">":U
       71                       then do:
       72                           assign
       73                               p-out-string = p-out-string + "&gt;":U
       74                           .
       75                       end.
       76                       when "<":U
       77                       then do:
       78                           assign
       79                               p-out-string = p-out-string + "&lt;":U
       80                           .
       81                       end.
       82                       when "'":U
       83                       then do:
       84                           assign
       85                               p-out-string = p-out-string + "&apos;":U
       86                           .
       87                       end.
       88                       when '"':U
       89                       then do:
       90                           assign
       91                               p-out-string = p-out-string + "&quot;":U
       92                           .
       93                       end.
       94                       when chr(1)
       95                       then do:
       96                           assign
       97                               p-out-string = p-out-string + "":U
       98                           .
       99                       end.
      100                       when chr(2)
      101                       then do:
      102                           assign
      103                               p-out-string = p-out-string + "":U
      104                           .
      105                       end.
      106                       when chr(3)
      107                       then do:
      108                           assign
      109                               p-out-string = p-out-string + "":U
      110                           .
      111                       end.
      112                       when chr(4)
      113                       then do:
      114                           assign
      115                               p-out-string = p-out-string + "":U
      116                           .
      117                       end.
      118                       when chr(5)
      119                       then do:
      120                           assign
      121                               p-out-string = p-out-string + "":U
      122                           .
      123                       end.
      124                       when chr(6)
      125                       then do:
      126                           assign
      127                               p-out-string = p-out-string + "":U
      128                           .
      129                       end.
      130                       when chr(7)
      131                       then do:
      132                           assign
      133                               p-out-string = p-out-string + "":U
      134                           .
      135                       end.
      136                       when chr(8)
      137                       then do:
      138                           assign
      139                               p-out-string = p-out-string + "":U
      140                           .
      141                       end.
      142                       when chr(9)
      143                       then do:
      144                           assign
      145                               p-out-string = p-out-string + "":U
      146                           .
      147                       end.
      148                       when chr(29)
      149                       then do:
      150                           assign
      151                               p-out-string = p-out-string + "":U
      152                           .
      153                       end.
      154                       when chr(10)
      155                       then do:
      156                           assign
      157                               p-out-string = p-out-string + "&#10;":U
      158                           .
      159                       end.
      160                       when chr(13)
      161                       then do:
      162                           assign
      163                               p-out-string = p-out-string + "&#13;":U
      164                           .
      165                       end.
      166                       otherwise do:
      167                           assign
      168                               p-out-string = p-out-string + v-current-char
      169                           .
      170                       end.
      171                   end case.
      172               end.
      173           end.
      174       end case.
      175   end.
      176   end .
      177   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      178   define variable p-out-string as character no-undo.
      179       define variable v-position      as integer      no-undo.
      180       define variable v-current-char  as character    no-undo.
      181   do
      182   on error undo, return error
      183   :
      184       assign
      185           p-out-string = "":U
      186       .
      187       case p-in-string
      188       :
      189           when ?
      190           then do:
      191               assign
      192                   p-out-string = "?":U
      193               .
      194           end.
      195           otherwise do:
      196               do v-position = 1 to length( p-in-string )
      197               :
      198                   assign
      199                       v-current-char = substring( p-in-string, v-position, 1 )
      200                   .
      201                   case v-current-char
      202                   :
      203                       when chr(1)
      204                       then do:
      205                           assign
      206                               p-out-string = p-out-string + " ":U
      207                           .
      208                       end.
      209                       when chr(2)
      210                       then do:
      211                           assign
      212                               p-out-string = p-out-string + " ":U
      213                           .
      214                       end.
      215                       when chr(3)
      216                       then do:
      217                           assign
      218                               p-out-string = p-out-string + " ":U
      219                           .
      220                       end.
      221                       when chr(4)
      222                       then do:
      223                           assign
      224                               p-out-string = p-out-string + " ":U
      225                           .
      226                       end.
      227                       when chr(5)
      228                       then do:
      229                           assign
      230                               p-out-string = p-out-string + " ":U
      231                           .
      232                       end.
      233                       when chr(6)
      234                       then do:
      235                           assign
      236                               p-out-string = p-out-string + " ":U
      237                           .
      238                       end.
      239                       when chr(7)
      240                       then do:
      241                           assign
      242                               p-out-string = p-out-string + " ":U
      243                           .
      244                       end.
      245                       when chr(8)
      246                       then do:
      247                           assign
      248                               p-out-string = p-out-string + " ":U
      249                           .
      250                       end.
      251                       when chr(9)
      252                       then do:
      253                           assign
      254                               p-out-string = p-out-string + " ":U
      255                           .
      256                       end.
      257                       when chr(29)
      258                       then do:
      259                           assign
      260                               p-out-string = p-out-string + " ":U
      261                           .
      262                       end.
      263                       when chr(10)
      264                       then do:
      265                           assign
      266                               p-out-string = p-out-string + " ":U
      267                           .
      268                       end.
      269                       when chr(13)
      270                       then do:
      271                           assign
      272                               p-out-string = p-out-string + " ":U
      273                           .
      274                       end.
      275                       otherwise do:
      276                           assign
      277                               p-out-string = p-out-string + v-current-char
      278                           .
      279                       end.
      280                   end case.
      281               end.
      282           end.
      283       end case.
      284   end.
      285   return p-out-string.
      286   end .
      287   method private void xmlchar-decode (input  p-in-string          as character,
      288                                     output p-out-string         as character):
      289       define variable v-position      as integer      no-undo.
      290       define variable v-last-position as integer      no-undo.
      291       define variable v-temp-integer  as integer      no-undo.
      292       define variable v-current-char  as character    no-undo.
      293       define variable v-next-char     as character    no-undo.
      294       define variable v-success       as logical      no-undo.
      295   do
      296   on error undo, return error
      297   :
      298       assign
      299           p-out-string = "":U
      300           v-position   = 0
      301       .
      302       replace-cycle:
      303       do while yes
      304       on error undo, return error
      305       :
      306           assign
      307               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      308           .
      309           if v-last-position <= v-position
      310           then do:
      311               if v-position = 0
      312               then do:
      313                   assign
      314                       p-out-string = p-in-string
      315                   .
      316               end.
      317               else do:
      318                   assign
      319                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      320                   .
      321               end.
      322               leave replace-cycle.
      323           end.
      324           else do:
      325               assign
      326                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      327                   v-position      = v-last-position
      328                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      329               .
      330               if v-current-char = "#":U
      331               then do:
      332                   assign
      333                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      334                   .
      335                   if v-last-position > 0
      336                   then do:
      337                       xmlchar-read-integer
      338                        (
      339                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      340                           , output v-temp-integer
      341                           , output v-success
      342                       ).
      343                       if v-success = yes
      344                       and v-temp-integer >= 1
      345                       and v-temp-integer <= 255
      346                       then do:
      347                           assign
      348                               p-out-string = p-out-string + chr( v-temp-integer )
      349                               v-position   = v-last-position + 1
      350                           .
      351                       end.
      352                       else do:
      353                           assign
      354                               p-out-string = p-out-string + "&":U
      355                               v-position   = v-position   + 1
      356                           .
      357                       end.
      358                   end.
      359                   else do:
      360                       assign
      361                           p-out-string = p-out-string + "&":U
      362                           v-position   = v-position   + 1
      363                       .
      364                   end.
      365               end.
      366               else do:
      367                   case substring( p-in-string, v-position + 1, 3 )
      368                   :
      369                       when "lt;":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + "<":U
      373                               v-position   = v-position   + 3
      374                           .
      375                       end.
      376                       when "gt;":U
      377                       then do:
      378                           assign
      379                               p-out-string = p-out-string + ">":U
      380                               v-position   = v-position   + 3
      381                           .
      382                       end.
      383                       otherwise do:
      384                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      385                           then do:
      386                               assign
      387                                   p-out-string = p-out-string + "&":U
      388                                   v-position   = v-position   + 4
      389                               .
      390                           end.
      391                           else do:
      392                               case substring( p-in-string, v-position + 1, 5 )
      393                               :
      394                                   when "quot;":U
      395                                   then do:
      396                                       assign
      397                                           p-out-string = p-out-string + '"':U
      398                                           v-position   = v-position   + 5
      399                                       .
      400                                   end.
      401                                   when "apos;":U
      402                                   then do:
      403                                       assign
      404                                           p-out-string = p-out-string + "'":U
      405                                           v-position   = v-position   + 5
      406                                       .
      407                                   end.
      408                                   otherwise do:
      409                                       assign
      410                                           p-out-string = p-out-string + "&":U
      411                                       .
      412                                   end.
      413                               end case.
      414                           end.
      415                       end.
      416                   end case.
      417               end.
      418           end.
      419       end.
      420   end.
      421   end .
      422   method private void xmlchar-read-integer (input  p-input-string       as character,
      423                                             output p-output-integer     as integer,
      424                                             output p-success            as logical):
      425   do
      426   on error undo, return error
      427   :
      428       assign
      429           p-output-integer = integer( p-input-string )
      430       no-error.
      431       if error-status :error
      432       then do:
      433           assign
      434               p-success           = no
      435               p-output-integer    = 0
      436           .
      437       end.
      438       else do:
      439           assign
      440               p-success           = yes
      441           .
      442       end.
      443   end.
      444   end.
      445   method private void getAttrLib ():
      446      define variable g#attr-lib  as handle no-undo .
      447      run gbl/getgattrlib.p (output g#attr-lib).
      448   end.
      449   define variable mMRCCode  as logical    no-undo.
      450   define variable mTypeMark as character  no-undo.
      451   method private logical IS-NeedMark
      452   ( input ib-code as integer  ,
      453     input ib-str as character ):
      454      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      455      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      456                                    and buf_prod-bc-attr.b-str  eq ib-str
      457                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      458        no-lock no-error.
      459      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      460   end.
      461   method private character repTegforDm
      462   (iDM as char ):
      463       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      464       define variable vteg as character no-undo.
      465       define variable oDM as character no-undo.
      466       define variable vi as integer no-undo.
      467       oDM = iDm.
      468       do vi = 1 to num-entries(vTeglist):
      469          vTeg = entry(vi,vTeglist).
      470          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      471       end.
      472       return oDM.
      473   end.
      474   method private character repSpecSimbforDm
      475   (iDM as char ):
      476       define variable oDM as character no-undo.
      477       xmlchar-decode(iDM, output oDM).
      478     return repTegforDm (oDM).
      479   end.
      480   method private logical CheckGtin
      481   (iGtin as char):
      482      define variable bar_code as character no-undo.
      483      define variable vGtin as logical no-undo init "yes".
      484      if length(iGtin) eq 14
      485      then do:
      486         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      487         run str/chk-sum.p
      488          (input-output bar_code ) no-error .
      489         if iGtin ne  bar_code
      490         then
      491            vGtin = no.
      492      end.
      493      else
      494         vGtin = no.
      495      return vgtin.
      496   end.
      497   method private character repSpecSimbforXlm
      498   (iDM as char ):
      499       iDM = replace(iDM,chr(29),"").
      500       return iDM.
      501   end.
      502   method private character getGtinByDM
      503   (IDM as char):
      504      define variable VTXT as char no-undo.
      505      define variable vGtin as char no-undo.
      506      vTXt = IdM.
      507      vGtin = IDM.
      508      if    length(vtxt) > 14
      509      then do:
      510         if   vtxt begins "(01)"
      511                or vtxt begins "(02)"
      512         then
      513            vGtin = substring(vtxt,5,14).
      514         else if   (vtxt begins "01"
      515                or vtxt begins "02" )
      516                and (   (    substring(iDm,17,2) eq "21"
      517                         and length(vtxt) >= 21)
      518                     or substring(iDm,17,2) eq "37"
      519                     or substring(iDm,17,4) eq "(37)" )
      520         then do:
      521            vGtin = substring(vtxt,3,14).
      522            if not checkGtin(vGtin)
      523            then
      524               vGtin = substring(vtxt,1,14).
      525         end.
      526         else if     length(vtxt) eq 14 + 7 + 4 + 4
      527             or length(vtxt) eq 14 + 7 + 4
      528             or length(vtxt) eq 14 + 7
      529         then
      530            vGtin = substring(vtxt,1,14).
      531      end.
      532      if not checkGtin(vGtin)
      533      then
      534         vGtin = "".
      535      return vgtin.
      536   end.
      537   method private integer getGdsCodeByGtin
      538   (iGtin as char):
      539      define buffer prod-bc  for ub.prod-bc.
      540      define buffer bar-code for ub.bar-code.
      541      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      542      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      543      return if avail bar-code then bar-code.gds-code else ?.
      544   end.
      545   method private decimal getQntyCodeByGtin
      546   (iGtin as char):
      547      define buffer prod-bc  for ub.prod-bc.
      548      define buffer bar-code for ub.bar-code.
      549      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      550      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      551      return if avail bar-code then bar-code.cli-base-rate else ?.
      552   end.
      553   method private integer getGdsCodeByDM
      554   (iDm as char):
      555      define variable vGtin as char no-undo.
      556      define buffer prod-bc for ub.prod-bc.
      557      vGtin  = getGtinByDM (IDM ).
      558      return getGdsCodeByGtin (vGtin).
      559   end.
      560   method private logical ChekTypeMarkByGds
      561   (iGds-code as integer ):
      562      define buffer goods-attr for ub.goods-attr.
      563      find first goods-attr where goods-attr.gds-code   = iGds-code
      564                              and goods-attr.attr-code  = 'mark-type':U
      565      no-lock no-error.
      566      if available goods-attr
      567      then do:
      568         mTypeMark = goods-attr.attr-value.
      569         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      570           .
      571      end.
      572      else
      573         return no.
      574   end.
      575   method private logical ChekTypeMarkByDm
      576   (iDM as char ):
      577      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      578   end.
      579   method private logical ChekTypeMarkByGtin
      580   (iGtin as char ):
      581      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      582   end.
      583   method private character  GetNextElement
      584     (input iAllTeg        as logical
      585     ,output oteg          as character
      586     ,output otegval       as character
      587     ,input-output pstr    as character
      588      ):
      589        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      590        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      591        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      592        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      593        define variable vTeg as character no-undo.
      594        define variable vLength as integer no-undo.
      595        define variable vi as integer no-undo.
      596        define variable vj as integer no-undo.
      597        define buffer code for ub.code.
      598        find first code where Code.parent eq "MarkType"
      599                          and Code.CodeValue   eq mTypeMark
      600                          no-lock no-error.
      601        if     available code
      602           and Code.misc1 ne ""
      603           and Code.misc1 ne ?
      604        then do:
      605           integer (Code.misc1) no-error.
      606           if not error-status:error
      607           then
      608             entry (4,vlistleng) = Code.misc1.
      609        end.
      610        if iAllTeg
      611        then
      612           assign
      613              vlistElem     = vlistElem    + vlistElemDop
      614              vlistleng     = vlistleng    + vlistlengDop
      615           .
      616        else if mMRCCode
      617        then
      618           assign
      619              vlistElem     = vlistElem    + ",(8005),8005"
      620              vlistleng     = vlistleng    + ",000006,0006"
      621           .
      622       block-elem:
      623       do vi = 1 to num-entries(vlistElem):
      624          vTeg = entry(vi,vlistElem).
      625          if pstr begins vTeg
      626          then do:
      627             if    vTeg eq "21"
      628             then
      629                vLength = index(pstr,chr(29)) - 2 no-error.
      630             if vLength  <= 0
      631             then
      632                vLength = int(entry(vi,vlistleng)).
      633             otegval = substring (pstr,length(vteg) + 1, vLength).
      634             oteg = replace(replace(vteg,")",""),"(","").
      635             vTeg = vteg + otegval.
      636             otegval = replace(otegval,chr(29),"").
      637             oteg = replace(replace(oteg,")",""),"(","").
      638             pstr = substring (pstr,length(vTeg)+ 1).
      639             vTeg = replace(vTeg,chr(29),"").
      640             leave block-elem.
      641          end.
      642          else
      643             vTeg = "".
      644       end.
      645       return vteg.
      646   end.
      647   method private character  GetCodeIdent
      648   (iDm as char):
      649      define variable Velement   as character no-undo init "first".
      650      define variable oCodeIdent as character no-undo.
      651      define variable vteg as character no-undo.
      652      define variable vtegval as character no-undo.
      653      define variable vGtin as character no-undo.
      654      define buffer marking for ub.marking.
      655      for first marking no-lock where
      656                marking.mark eq iDm
      657            and marking.unit-ext = "LEVEL2"
      658      :
      659        return iDm.
      660      end.
      661      vGtin  = getGtinByDM (iDm ).
      662      ChekTypeMarkByDm(idm).
      663      if iDm begins 'tech_':U
      664      then
      665         oCodeIdent = iDm.
      666      else if length(iDm) < 21
      667      then do:
      668         find first marking where marking.mark eq idm
      669         no-lock no-error.
      670         oCodeIdent = if available marking then marking.mark else  ?.
      671      end.
      672      else if     length(iDm) eq 29
      673         and not iDm begins "01"
      674         and not iDm begins "02"
      675      then
      676         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      677      else  if     length(iDm) >= 24
      678               and (  iDm begins "01"
      679                   or iDm begins "02")
      680               and  substring(iDm,17,2) ne "21"
      681      then do:
      682         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      683                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      684         then
      685            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      686         else
      687            oCodeIdent = iDM.
      688      end.
      689      else  if     (   length(iDm) eq 25
      690                    or length(iDm) eq 21)
      691               and (not iDm begins "01"
      692               and  not iDm begins "02")
      693      then
      694         oCodeIdent = substring(iDm,1,21).
      695      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      696      then
      697         oCodeIdent = substring(iDm,1,21).
      698      else do while Velement ne "" and idm ne "":
      699         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      700         oCodeIdent = oCodeIdent + Velement.
      701      end.
      702      return oCodeIdent.
      703   end.
      704   method private character  GetTegCod
      705   (icodeIdent as char, iTeg as char):
      706      define variable Velement   as character no-undo init "first".
      707      define variable oTeg as character no-undo init ?.
      708      define variable vteg as character no-undo.
      709      define variable vtegval as character no-undo.
      710      if     ((length(icodeIdent) eq 21
      711         and not icodeIdent begins "01"
      712         and not icodeIdent begins "02")
      713         or
      714             ( length(icodeIdent) eq 25
      715               and not icodeIdent begins "01"
      716               and not icodeIdent begins "02"))
      717      then do:
      718         if iTeg eq "01" or iTeg eq "02"
      719         then
      720            oTeg = substring(icodeIdent,1,21).
      721         else  if  iTeg eq "21"
      722         then
      723            oTeg = substring(icodeIdent,15,7).
      724      end.
      725      else do:
      726         ChekTypeMarkByDm(icodeIdent).
      727         block-teg:
      728            do while Velement ne "" and icodeIdent ne "":
      729            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      730            if    Velement begins iTeg
      731               or Velement begins "(" + iTeg + ")"
      732            then do:
      733               oTeg = vtegval.
      734               leave block-teg.
      735            end.
      736         end.
      737      end.
      738      return oTeg.
      739   end.
      740   method private logical isOAD
      741   (icodeIdent as character):
      742      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      743   end.
      744   method private logical isMark
      745   (icodeIdent as character):
      746      define buffer buf_marking for ub.marking.
      747      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      748             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      749   end.
      750   method private character  addBracketForCode
      751   (icodeIdent as char):
      752      define variable Velement   as character no-undo init "first".
      753      define variable oTeg as character no-undo.
      754      define variable vteg as character no-undo.
      755      define variable vtegval as character no-undo.
      756      define buffer marking for ub.marking.
      757      find first marking no-lock where
      758                 marking.mark begins icodeIdent no-error.
      759      if    not ChekTypeMarkByDm(icodeIdent)
      760         or length(icodeIdent) le 24
      761         or (avail marking and marking.unit-ext = "LEVEL2")
      762      then
      763         oTeg = icodeIdent.
      764      else do:
      765         if (  icodeIdent begins "01"
      766            or icodeIdent begins "02"
      767            ) and CheckGtin(substring (icodeIdent,3,14))
      768            and substring (icodeIdent,17,2) eq "21"
      769         then do:
      770            mMRCCode = yes.
      771            ChekTypeMarkByDm(icodeIdent).
      772            block-teg:
      773            do while Velement ne "" and icodeIdent ne "":
      774               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      775               if vteg ne ""
      776               then
      777                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      778            end.
      779            mMRCCode = no.
      780         end.
      781         else do:
      782            oTeg = icodeIdent.
      783         end.
      784      end.
      785      return oTeg.
      786   end.
      787   method private integer getlevelByCodId
      788   (iCode as char):
      789      define variable vLength as int no-undo.
      790      define variable vLevel  as int no-undo.
      791      if not ChekTypeMarkByDM (icode) then return ?.
      792      vLength = length(iCode).
      793      if    vLength eq 18
      794         or vLength eq 20
      795      then
      796         Vlevel = 4.
      797      else if vLength eq 21
      798      then
      799         Vlevel = 1.
      800      else if vLength eq 25
      801      then do:
      802         if  iCode begins "01"
      803         then
      804            Vlevel = 3.
      805         else
      806            Vlevel = 1.
      807      end.
      808      else if     vLength >= 26
      809              and vLength <= 46
      810      then do:
      811         if    substring(iCode,17,2) eq "11"
      812            or substring(iCode,17,2) eq "13"
      813            or (    substring(iCode,17,2) eq "21"
      814                and vLength >= 33
      815                and substring(iCode,26,4) ne "8005")
      816         then
      817            Vlevel = 4.
      818         else if    vLength eq 31
      819                 or vLength eq 38
      820                 or vLength eq 39
      821                 or vLength eq 45
      822         then
      823            Vlevel = 1.
      824         else if    vLength eq 35
      825                 or vLength eq 43
      826         then
      827            Vlevel = 3.
      828         else
      829            Vlevel = ?.
      830      end.
      831      else
      832         Vlevel = ?.
      833      return Vlevel.
      834   end.
      835   method private character  getLevelMotpBycodid
      836   (iDm as char):
      837      define variable vLevel as integer no-undo.
      838      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      839      vLevel = getlevelByCodId(iDm).
      840      if    vLevel eq ?
      841         or vLevel < 1
      842         or vLevel > 6
      843      then
      844         return ?.
      845      else
      846         return entry(vlevel,vList).
      847   end.
      848   method private character    getLevelUTDByLevelMotp
      849   (iUnit as char):
      850      define variable vLevel as integer no-undo.
      851      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      852      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      853      vLevel = lookup(iUnit,vListMOTP).
      854      if    vLevel eq ?
      855         or vLevel < 1
      856         or vLevel > 4
      857      then
      858         return ?.
      859      else
      860         return entry(vlevel,vListutd).
      861   end.
      862   method private character  getLevelMotpByDM
      863   (iDm as char):
      864      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      865   end.
      866   method private character  getLevelUTDByCodId
      867   (iDm as char):
      868      define variable vLevel as integer no-undo.
      869      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      870      vLevel = getlevelByCodId(iDm).
      871      if    vLevel eq ?
      872         or vLevel < 1
      873         or vLevel > 4
      874      then
      875         return ?.
      876      else
      877         return entry(vlevel,vList).
      878   end.
      879   method private character  getLevelUTDByDM
      880   (iDm as char):
      881      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      882   end.
      883   define variable mNotMarkQnty as logical no-undo.
      884   method private decimal getQntyUTDByCodId
      885   (iDM as char):
      886      define variable vLevel as integer no-undo.
      887      define variable vList as character no-undo init "1,5,10,500".
      888      define variable vGtin as character no-undo.
      889      define variable vqnty as decimal no-undo init ?.
      890      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      891      if vqnty eq ?
      892      then do:
      893         if not mNotMarkQnty
      894         then do:
      895            define buffer marking for ub.marking.
      896            define variable vCodident as character no-undo.
      897            vCodident = GetCodeIdent(idm).
      898            find first marking where marking.mark begins vCodident no-lock no-error.
      899            if     available marking
      900               and marking.box-qnty ne ?
      901            then
      902               return marking.box-qnty.
      903         end.
      904         vGtin = getGtinByDm(iDM).
      905         if ChekTypeMarkByGtin (vGtin)
      906         then do:
      907            vLevel = getlevelByCodId(iDM).
      908            if     vLevel >= 1
      909               and vLevel <= 4
      910            then
      911               vqnty = int(entry(vlevel,vList)).
      912         end.
      913         else
      914            vqnty = getQntyCodeByGtin(vgtin).
      915      end.
      916      return vqnty.
      917   end.
      918   method private decimal getQntyUTDByDM
      919   (iDm as char):
      920      define variable vDM as character no-undo.
      921      if     length (iDm) ne 25
      922         and length (iDm) ne 29
      923         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      924      then
      925         vDM = substring (iDm,1,length (iDm) - 6 ).
      926      else
      927         vDM = substring (iDm,1,length (iDm) - 4 ).
      928      return getQntyUTDByCodId(vDM).
      929   end.
      930   method private decimal    getMRC4
      931   (iMRC as char):
      932      define variable oMrc     as decimal no-undo init ?.
      933      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      934      define variable vi       as integer no-undo.
      935      define variable vfound   as integer no-undo.
      936      define variable vposStart   as integer no-undo.
      937      do:
      938      OMRc = 0.
      939      do vi = 1 to 4:
      940         define variable vsimb as character no-undo.
      941         vsimb = substring(iMRC,vi,1).
      942         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      943         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      944         if vfound > 0
      945         then
      946            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      947         end.
      948         OMRc = OMRc / 100.
      949      end.
      950      return OMRc.
      951   end.
      952   method private decimal    getMRCByDM
      953   (iDm as char):
      954      define variable vMRC     as character no-undo.
      955      define variable oMrc     as decimal no-undo init ?.
      956      define variable Velement as character no-undo init "empty".
      957      define variable vteg as character no-undo.
      958      define variable vtegval as character no-undo.
      959      if    length(idm) eq 14 + 7 + 4 + 4
      960         or length(idm) eq 14 + 7 + 4
      961      then do:
      962         vMRC = substring(idm,22,4).
      963         omrc = getMRC4(vMRC).
      964      end.
      965      else do:
      966          ChekTypeMarkByDm(iDm).
      967          block-mrc:
      968          do while Velement ne "" and idm ne "":
      969             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      970             if Velement begins "8005"
      971             then do:
      972                vMRC = substring(Velement,5,6).
      973                leave block-mrc.
      974             end.
      975             else if Velement begins "(8005)"
      976             then do:
      977                vMRC = substring(Velement,7,6).
      978                leave block-mrc.
      979             end.
      980          end.
      981          if vMRC ne ""
      982          then
      983             OMRc = dec(vmrc) / 100 no-error.
      984      end.
      985      return OMRc.
      986   end.
      987   method private date    MoveDate
      988   (idate as date,
      989    iMonth as int64):
      990      define variable vMonth   as int64 no-undo.
      991      define variable vYear    as int64 no-undo.
      992      define variable vDateNew as date  no-undo.
      993       define variable vDay     as int64 no-undo.
      994       vMonth = month(iDate) + iMonth.
      995       vYear =  year(iDate).
      996       if vMonth <= 0
      997       then assign
      998          vMonth = vMonth + 12
      999           vYear  = vYear - 1
     1000       .
     1001       else if vMonth > 12
     1002       then assign
     1003          vMonth = vMonth - 12
     1004           vYear  = vYear + 1
     1005       .
     1006       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1007       do while error-status:error eq yes:
     1008          VDay = vDay + 1.
     1009          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1010       end.
     1011       if VDay > 0
     1012       then
     1013          vDateNew + 1.
     1014       return vDateNew.
     1015   end.
     1016   method private logical    checkEMRC
     1017   (input  iDm as char,
     1018    output vOk as logical):
     1019      define variable v-value-emrc as character no-undo.
     1020      define variable v-type-emrc  as character no-undo.
     1021      define variable vDateIso     as character no-undo.
     1022      define variable vMRC         as decimal no-undo.
     1023      define variable vqnty        as decimal no-undo.
     1024      define variable vPrice       as decimal no-undo.
     1025      define variable vparent      as character no-undo.
     1026      define variable vgds-code    as integer no-undo.
     1027      define buffer code for ub.code.
     1028      vMRC = getMRCByDM(iDm).
     1029      if vMRC > 0
     1030      then do:
     1031         vgds-code = getGdsCodeByDM(iDm).
     1032         vqnty     = getQntyUTDByDM(iDm).
     1033               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1034            (
     1035             input   vgds-code
     1036            ,input   'emrc-type':U
     1037            ,output   v-value-emrc
     1038            ,output   v-type-emrc
     1039          ) no-error.
     1040          if     v-value-emrc ne ""
     1041             and v-value-emrc ne ?
     1042          then do:
     1043             vDateIso = iso-date(today).
     1044             vPrice = vMRC / vqnty.
     1045             vparent ="emc" + chr(4) + v-value-emrc.
     1046             find last code where Code.parent      eq vparent
     1047                              and Code.code        le vDateIso
     1048                              and code.status_  eq 0
     1049             no-lock no-error.
     1050             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1051             then
     1052                vOk = true .
     1053             else do:
     1054                 define variable vText      as character no-undo.
     1055                 define variable vDate      as date no-undo.
     1056                 define variable vDateLast  as character no-undo.
     1057                 define variable vDateFirst as character no-undo.
     1058                 define variable vDate3     as date no-undo.
     1059                 vdate = date(code.misc1).
     1060                 vDateLast = code.misc1.
     1061                 vDate3 = MoveDate(today, - 3 ).
     1062                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1063                                      string(vDate3  , "99/99/9999"),
     1064                                      string(vDate   , "99/99/9999")
     1065                                      ).
     1066                 vdateIso = iso-date(vdate3).
     1067                 find last code  where Code.parent      eq vparent
     1068                                   and Code.code        le vDateIso
     1069                                   and code.status_  eq 0 no-lock no-error.
     1070                 if available code
     1071                 then
     1072                    vDateIso = code.code.
     1073                 vDateFirst = vDateIso.
     1074                 vDateLast = iso-date(vdate).
     1075                 define variable vGood as logical no-undo.
     1076                 define variable vDateSale as date no-undo.
     1077                 define buffer bcode for code.
     1078                 for last code where Code.parent   eq vparent
     1079                                 and code.status_  eq 0
     1080                                 and code.code     < vDateLast
     1081                                 and code.code     >= vDateFirst
     1082                 no-lock:
     1083                    find first bcode where bCode.parent   eq vparent
     1084                                       and bcode.status_  eq 0
     1085                                       and bcode.code     > code.code no-lock no-error.
     1086                    if available bcode
     1087                    then do:
     1088                       if vPrice < dec(Code.CodeValue)
     1089                       then
     1090                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1091                                                     chr(10),
     1092                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1093                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1094                                                     ).
     1095                       else do:
     1096                          vGood = yes.
     1097                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1098                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1099                                                     chr(10),
     1100                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1101                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1102                                                     string(         vDateSale            ,"99/99/9999"),
     1103                                                     string(vDateSale - today)
     1104                                                     ).
     1105                       end.
     1106                    end.
     1107                 end.
     1108                 if vgood
     1109                 then do:
     1110                    define variable choice as integer no-undo .
     1111                    run gbl/d-askw.w (input "Уточнение"
     1112                           ,input  vText
     1113                           ,input "|"
     1114                           ,input "Принять|Вернуть"
     1115                           ,input "Принять данный товар|Вернуть товар постащику"
     1116                           ,input 1
     1117                           ,input 2
     1118                           ,output choice) no-error.
     1119                    vok = choice eq 1.
     1120                 end.
     1121                 else
     1122                    vok =false.
     1123             end.
     1124          end.
     1125      end.
     1126   end.
     1127   method private character addGs2Mark
     1128   (iMark as char):
     1129      define variable vDM   as character no-undo.
     1130      define variable vIdx  as integer   no-undo.
     1131      if index(iMark,chr(29),1) > 0
     1132      then return iMark.
     1133      if substring(iMark,26,4) = "8005" then
     1134      do:
     1135        vIdx = index(iMark,"93",26 + 4 + 5).
     1136        if vIdx > 1 then do:
     1137          vDM = substitute("&1&4&2&4&3",
     1138                           substring(iMark,1,25),
     1139                           substring(iMark,26,vIdx - 25 - 1),
     1140                           substring(iMark,vIdx),
     1141                           chr(29)) no-error.
     1142          vIdx = index(vDm,"240",vIdx + 4).
     1143          if vIdx > 0 then
     1144          do:
     1145            vDM = substitute("&1&3&2",
     1146                             substring(vDm,1,vIdx - 1),
     1147                             substring(vDm,vIdx),
     1148                             chr(29)) no-error.
     1149          end.
     1150        end.
     1151        else
     1152          vDM = substitute("&1&3&2",
     1153                           substring(iMark,1,25),
     1154                           substring(iMark,26),
     1155                           chr(29)) no-error.
     1156      end.
     1157      else if substring(iMark,32,2) = "91" then
     1158      do:
     1159        vIdx = index(iMark,"92",32).
     1160        if vIdx > 1 then
     1161          vDM = substitute("&1&4&2&4&3",
     1162                           substring(iMark,1,31),
     1163                           substring(iMark,32,vIdx - 31 - 1),
     1164                           substring(iMark,vIdx),
     1165                           chr(29)) no-error.
     1166        else
     1167          vDM = substitute("&1&3&2",
     1168                           substring(iMark,1,31),
     1169                           substring(iMark,32),
     1170                           chr(29)) no-error.
     1171      end.
     1172      else if substring(iMark,39,2) = "91" then
     1173      do:
     1174        vIdx = index(iMark,"92",38).
     1175        if vIdx > 1 then
     1176          vDM = substitute("&1&4&2&4&3",
     1177                           substring(iMark,1,38),
     1178                           substring(iMark,39,vIdx - 38 - 1),
     1179                           substring(iMark,vIdx),
     1180                           chr(29)) no-error.
     1181        else
     1182          vDM = substitute("&1&3&2",
     1183                           substring(iMark,1,38),
     1184                           substring(iMark,39),
     1185                           chr(29)) no-error.
     1186      end.
     1187      else if substring(iMark,25,2) = "93" then
     1188      do:
     1189        vIdx = index(iMark,"92",25).
     1190        if vIdx > 1 then
     1191          vDM = substitute("&1&4&2&4&3",
     1192                           substring(iMark,1,24),
     1193                           substring(iMark,25,vIdx - 24 - 1),
     1194                           substring(iMark,vIdx),
     1195                           chr(29)) no-error.
     1196        else
     1197          vIdx = index(iMark,"3103",25).
     1198          if vIdx > 0 then
     1199          vDM = substitute("&1&4&2&4&3",
     1200                           substring(iMark,1,24),
     1201                           substring(iMark,25,vIdx - 24 - 1),
     1202                           substring(iMark,vIdx),
     1203                           chr(29)) no-error.
     1204          else
     1205            vDM = substitute("&1&3&2",
     1206                             substring(iMark,1,24),
     1207                             substring(iMark,25),
     1208                             chr(29)) no-error.
     1209      end.
     1210      else if substring(iMark,32,2) = "93" then
     1211      do:
     1212        vDM = substitute("&1&3&2",
     1213              substring(iMark,1,31),
     1214              substring(iMark,32),
     1215              chr(29)) no-error.
     1216      end.
     1217      return if vDM <> "" then vDm else iMark.
     1218   end.
     1219     define private temp-table tt-mark no-undo
     1220        field mark as character case-sensitive
     1221     .
     1222     define property Msg as character no-undo
     1223       get.
     1224       set.
     1225     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
     1226       define variable objImp    as class ibs.th.bge.1crn.subjects.code no-undo.
     1227       define variable v-retfl   as logical no-undo .
     1228       define variable v-mode    as character no-undo.
     1229       define variable v-del-f as logical no-undo.
     1230       define buffer code for ub.code .
     1231       objImp = cast (subjectObj, code).
     1232       v-del-f = objImp:del-f > 0.
     1233       if v-del-f eq ?
     1234       then
     1235          v-del-f = false.
     1236       find first code where Code.parent eq objImp:old_parent_
     1237                         and code.code   eq objImp:old_code_
     1238       exclusive-lock no-error.
     1239       if available code
     1240       then do:
     1241          if v-del-f
     1242          then
     1243             delete Code.
     1244       end.
     1245       else do:
     1246          if not v-del-f
     1247          then
     1248             create code.
     1249       end.
     1250       if not v-del-f
     1251       then assign
     1252          code.code      = objImp:code_
     1253          Code.parent    = objImp:parent_
     1254          Code.CodeName  = objImp:codeName
     1255          Code.CodeValue = objImp:codeValue
     1256          Code.status_   = objImp:status_
     1257          Code.misc1     = objImp:misc1
     1258          Code.misc2     = objImp:misc2
     1259          Code.misc3     = objImp:misc3
     1260          Code.misc4     = objImp:misc4
     1261          Code.misc5     = objImp:misc5
     1262          Code.misc6     = objImp:misc6
     1263          Code.misc7     = objImp:misc7
     1264          Code.misc8     = objImp:misc8
     1265          Code.misc9     = objImp:misc9
     1266          Code.misc10    = objImp:misc10
     1267       .
     1268       define variable mImp2CdH as handle no-undo.
     1269       run str/imp2cdgeth.p(output mImp2CdH).
     1270       run fill-code in mImp2CdH (objImp:old_parent_,
     1271                                  objImp:old_code_).
     1272       run fill-code in mImp2CdH (objImp:parent_,
     1273                                  objImp:code_).
     1274       v-retfl = true .
     1275       define variable i as integer no-undo .
     1276       catch exAppErrors as class Progress.Lang.AppError :
     1277         Msg = exAppErrors:ReturnValue .
     1278         if Msg > "" then . else do :
     1279           do i = 1 to exAppErrors:NumMessages :
     1280             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
     1281           end .
     1282           if Msg > "" then . else Msg = "AppError в impcode" .
     1283         end .
     1284         v-retfl = false .
     1285         undo, throw exAppErrors .
     1286       end catch .
     1287       catch exProErrors as class Progress.Lang.ProError :
     1288         do i = 1 to exProErrors:NumMessages :
     1289           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
     1290         end .
     1291         if Msg > "" then . else Msg = "ProError в impcode" .
     1292         v-retfl = false.
     1293         undo, throw exProErrors .
     1294       end catch .
     1295       catch exAnyErrors as class Progress.Lang.Error:
     1296         Msg = "Unexpected error в impcode" .
     1297         v-retfl = false .
     1298         undo, throw exAnyErrors .
     1299       end catch .
     1300       finally :
     1301         return v-retfl .
     1302       end finally .
     1303     end method.
     1304   end class.
