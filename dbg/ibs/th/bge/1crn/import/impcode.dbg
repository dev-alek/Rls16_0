        1   using ibs.th.bge.1crn.subjects.subjects.
        2   using ibs.th.bge.1crn.subjects.code.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impCode inherits ibs.th.gbl.sys.objth implements ibs.th.bge.1crn.import.iimpsubject :
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Загрузка code" get.
       11   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define variable vss-include-info1 as character format "X(65)" no-undo
