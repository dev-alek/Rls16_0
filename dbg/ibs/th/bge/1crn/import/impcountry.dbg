        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.import.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impcountry implements ibs.th.bge.1crn.import.iimpsubject:
        6     define buffer buf_cnt for ub.country.
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable v-doc-rec  as recid     no-undo.
       12       define variable result     as logical   no-undo.
       13       define variable mode       as character no-undo.
       14       define variable objCountry as class     country no-undo.
       15       objCountry = cast (subjectObj, country).
       16       find first buf_cnt where buf_cnt.num-code = integer (objCountry:code_) no-error.
       17       if available (buf_cnt)
       18       then do:
       19         if objCountry:del-f = integer (true)
       20         then do:
       21           delete buf_cnt.
       22           result = true.
       23           return result.
       24         end.
       25         assign
       26           mode = 'хглемемхе':U
       27           v-doc-rec = recid (buf_cnt).
       28       end.
       29         else mode = 'днаюбкемхе':U.
       30       run ref/country1.p (
       31         input-output v-doc-rec
       32         ,input mode
       33         ,input objCountry:alfa2
       34         ,input objCountry:alfa3
       35         ,input integer (objCountry:code_)
       36         ,input objCountry:name_
       37         ,input objCountry:full-name
       38         ) no-error.
       39       if error-status:error then
       40       do:
       41         Msg = return-value.
       42         result = false.
       43       end.
       44       else do:
       45         result = true.
       46       end.
       47       return result.
       48     end method.
       49   end class.
