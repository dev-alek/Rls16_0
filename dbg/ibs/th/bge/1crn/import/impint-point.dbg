        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.import.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impint-point implements ibs.th.bge.1crn.import.iimpsubject:
        6   method private void getAttrLib ():
        7      define variable g#attr-lib  as handle no-undo .
        8      run gbl/getgattrlib.p (output g#attr-lib).
        9   end.
       10     define buffer buf_db for ub.db.
       11     define buffer buf_clients for ub.clients.
       12     define property Msg as character no-undo
       13       get.
       14       set.
       15     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       16       define variable result      as logical   no-undo.
       17       define variable mode        as character no-undo.
       18       define variable objIntPoint as class     int-point no-undo.
       19       objIntPoint = cast (subjectObj, int-point).
       20       if not (objIntPoint:azk-code = ? or integer (objIntPoint:azk-code) = 0)
       21       then do:
       22         find first buf_clients where buf_clients.obj-code = integer (objIntPoint:azk-code) and buf_clients.db-num <> ? no-error.
       23         if error-status:error then
       24         do:
       25           undo, throw new Progress.Lang.AppError("Нет объект с кодом (azk-code) - " + objIntPoint:azk-code).
       26         end.
       27       end.
       28           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run db-attr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib
       29         (input (if not available (buf_clients) then 0 else buf_clients.db-num)
       30         ,input 'int-point':U
       31         ,input objIntPoint:code_
       32         ) no-error .
       33       if error-status:error then
       34       do:
       35         undo, throw new Progress.Lang.AppError(return-value).
       36       end.
       37       result = true.
       38       catch exAppErrors as class Progress.Lang.AppError :
       39         Msg = Msg + "; " + exAppErrors:ReturnValue .
       40         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
       41         result = false.
       42       end catch .
       43       catch exProErrors as class Progress.Lang.ProError :
       44         Msg = exProErrors:GetMessage(1) .
       45         result = false.
       46       end catch .
       47       catch exAnyErrors as class Progress.Lang.Error:
       48         Msg = "Unexpected error occurred..." .
       49         result = false.
       50       end catch .
       51       finally:
       52         return result.
       53       end.
       54     end method.
       55   end class.
