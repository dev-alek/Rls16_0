        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.imprvd-reason implements ibs.th.bge.1crn.import.iimpsubject:
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7     define buffer buf_ext-classif for ub.ext-classif .
        8     define variable v-code as character no-undo .
        9     define property Msg as character no-undo
       10       get.
       11       set.
       12     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       13       define variable ri           as recid no-undo .
       14       define variable objRvd-reason as class rvd-reason no-undo.
       15       objRvd-reason = cast (subjectObj, rvd-reason).
       16       if objRvd-reason:code_ = "" or objRvd-reason:code_ = ? then
       17       do:
       18         Msg = "Основание/причина разрешения РВД не задано".
       19         return error Msg .
       20       end.
       21       if objRvd-reason:name_ = "" or objRvd-reason:name_ = ? then
       22       do:
       23         Msg = "Основание/причина разрешения РВД с кодом " + objRvd-reason:code_ + ". Не задано наименование" .
       24         return error Msg .
       25       end.
       26       if objRvd-reason:del-f = 0 then
       27       do:
       28         find first buf_ext-classif exclusive-lock where buf_ext-classif.CharKey_One = objRvd-reason:code_
       29                                                     and buf_ext-classif.classif-subject = 'rvd-reason':U
       30                                                     and buf_ext-classif.classif-name = 'rvd-reason':U
       31                                                     no-error .
       32         if available buf_ext-classif
       33         then do:
       34           delete buf_ext-classif .
       35         end .
       36         create buf_ext-classif .
       37         assign
       38           buf_ext-classif.classif-subject = 'rvd-reason':U
       39           buf_ext-classif.classif-name    = 'rvd-reason':U
       40           buf_ext-classif.Key#_One        = 0
       41           buf_ext-classif.Key#_Two        = objRvd-reason:type_
       42           buf_ext-classif.key#_three      = 0
       43           buf_ext-classif.CharKey_One     = objRvd-reason:code_
       44           buf_ext-classif.charkey_two     = objRvd-reason:name_
       45           buf_ext-classif.charkey_three   = if objRvd-reason:description_ <> ? then objRvd-reason:description_ else ""
       46           buf_ext-classif.db-num          = 0
       47           buf_ext-classif.nonunique       = objRvd-reason:del-l
       48           buf_ext-classif.uniq-key-rec    = 'rvd-reason':U + chr(3)
       49                                           + buf_ext-classif.charkey_one
       50         .
       51       end.
       52       else do:
       53         find first buf_ext-classif exclusive-lock where buf_ext-classif.CharKey_One = objRvd-reason:code_
       54                                                     and buf_ext-classif.classif-subject = 'rvd-reason':U
       55                                                     and buf_ext-classif.classif-name = 'rvd-reason':U
       56                                                     no-error .
       57         if not available (buf_ext-classif) then
       58         do:
       59           Msg = "Удаление основания/причины разрешения РВД с кодом " + objRvd-reason:code_ + " не возможно" .
       60           return error Msg.
       61         end.
       62         else
       63           delete buf_ext-classif .
       64       end.
       65     end method.
       66   end class.
