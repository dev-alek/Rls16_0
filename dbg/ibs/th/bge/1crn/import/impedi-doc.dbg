     2547   method public logical WghProdVariable
     2548       (input p-obj-type as char,
     2549        input p-obj-code as integer,
     2550        input p-gds-code as integer) :
     2551      define variable v-wgh-val  as character no-undo.
     2552      define variable v-par-val  as character no-undo.
     2553      define variable v-par-type as character no-undo.
     2554      define variable vMarking        as logical no-undo.
     2555      define variable vArtic          as logical no-undo.
     2556      define variable vTransitional   as logical no-undo.
     2557      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2558         if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2559           ( p-gds-code,
     2560             'weighed-gds':U,
     2561              output v-wgh-val,
     2562              output v-par-type
     2563           ).
     2564       if logical(v-wgh-val) = yes then do:
     2565           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2566               ( p-gds-code,
     2567                 'mark-type':U,
     2568                  output v-par-val,
     2569                  output v-par-type
     2570               ).
     2571           if v-par-val <> "" then do:
     2572               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2573               assign
     2574                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2575                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2576                  .
     2577           end.
     2578      end.
     2579      if v-wgh-val > "" and (vMarking or vArtic)
     2580      then return yes.
     2581      else return no.
     2582   end.
     2583   method public decimal MarkWeight
     2584      ( input p-mark as character) :
     2585      define buffer  buf_marking-attr for  ub.marking-attr.
     2586      define variable vMarkWeight as decimal no-undo.
     2587      vMarkWeight = 0.
     2588      if p-mark <> "" and p-mark <> ?
     2589      then do:
     2590          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2591                                        and buf_marking-attr.attr-code eq "weight"
     2592             no-lock no-error.
     2593          if not available buf_marking-attr
     2594          then do :
     2595            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2596                                          and buf_marking-attr.attr-code eq "weight"
     2597               no-lock no-error.
     2598          end .
     2599          if avail buf_marking-attr
     2600          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2601      end.
     2602      return vMarkWeight.
     2603   end.
     2604   method public void CheckQnty
     2605   (  input idb-num  as integer,
     2606      input idoc-id  as integer,
     2607      input iErrType as character
     2608   ):
     2609      if iErrType ne "loadUTD"
     2610      then do:
     2611         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     2612         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     2613         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     2614      end.
     2615      if iErrType ne "CheckQnty"
     2616      then do:
     2617         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     2618         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     2619         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     2620      end.
     2621      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     2622      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     2623      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     2624      define buffer marking               for marking.
     2625      define buffer utd-lines             for utd-lines.
     2626      define buffer utd-marking-lines     for utd-marking-lines.
     2627      define buffer Buf_utd-marking-lines for utd-marking-lines.
     2628      block-line:
     2629      for each utd-lines where utd-lines.db-num eq idb-num
     2630                           and utd-lines.doc-id eq idoc-id
     2631      no-lock:
     2632         define variable Vflagmark as logical no-undo.
     2633         find first buf_utd-marking-lines
     2634                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     2635                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     2636                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     2637                         and length(buf_utd-marking-lines.mark) > 13
     2638         no-lock no-error.
     2639         if not available buf_utd-marking-lines
     2640         then
     2641            next block-line.
     2642         define variable vqntyMark as integer no-undo.
     2643         define variable vqntyOAD  as integer no-undo.
     2644         vqntyMark = 0.
     2645         vqntyOAD  = 0.
     2646         block-mark:
     2647         for each utd-marking-lines
     2648              where utd-marking-lines.db-num  = utd-lines.db-num
     2649                and utd-marking-lines.doc-id  = utd-lines.doc-id
     2650                and utd-marking-lines.LineNum = utd-lines.LineNum
     2651                and length(utd-marking-lines.mark) > 13
     2652                and utd-marking-lines.doc-level  = 1
     2653         no-lock:
     2654            if isMark(utd-marking-lines.mark)
     2655            then do:
     2656               find first marking where marking.mark eq utd-marking-lines.mark
     2657               no-lock no-error.
     2658               if available marking
     2659               then do:
     2660                  if marking.box-qnty ne ?
     2661                  then
     2662                     vqntyMark = vqntyMark + marking.box-qnty.
     2663               end.
     2664            end.
     2665            else do:
     2666               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     2667                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     2668                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     2669                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     2670                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     2671               no-lock no-error.
     2672               if available utd-marking-lines-attr
     2673               then
     2674                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     2675            end.
     2676         end.
     2677         if     utd-lines.gds-code   gt 0
     2678            and utd-lines.gds-code   ne ?
     2679            and vqntyMark            ne 0
     2680         then do:
     2681            if utd-lines.Quantity  < vqntyMark
     2682            then
     2683               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     2684            else if utd-lines.Quantity  <> vqntyMark
     2685            then
     2686               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     2687         end.
     2688         else if     utd-lines.gds-code   gt 0
     2689            and utd-lines.gds-code   ne ?
     2690            and vqntyOAD ne 0
     2691            and utd-lines.Quantity  ne vqntyOAD
     2692         then
     2693            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     2694      end.
     2695   end.
     2696   method public void CheckGds
     2697   (  input idb-num   as integer,
     2698      input idoc-id   as integer,
     2699      input iobj-type as character,
     2700      input iobj-code as integer,
     2701      input iErrType as character
     2702   ):
     2703      if iErrType ne "loadUTD"
     2704      then do:
     2705         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     2706         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     2707         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     2708         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     2709         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     2710         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     2711         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     2712         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     2713         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     2714         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     2715         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     2716      end.
     2717      if iErrType ne "CheckGds"
     2718      then do:
     2719         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     2720         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     2721         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     2722         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     2723         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     2724         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     2725         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     2726         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     2727         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     2728         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     2729         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     2730      end.
     2731      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     2732      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     2733      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     2734      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     2735      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     2736      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     2737      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     2738      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     2739      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     2740      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     2741      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     2742      define variable v-par-type as character no-undo.
     2743      define variable v-par-val  as character no-undo.
     2744      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2745      define buffer marking               for marking.
     2746      define buffer utd-lines             for utd-lines.
     2747      define buffer buf_utd-lines         for utd-lines.
     2748      define buffer utd-marking-lines     for utd-marking-lines.
     2749      define buffer Buf_utd-marking-lines for utd-marking-lines.
     2750      define variable vGdsCode as integer no-undo.
     2751      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     2752      block-line:
     2753      for each utd-lines where utd-lines.db-num eq idb-num
     2754                           and utd-lines.doc-id eq idoc-id
     2755      no-lock:
     2756         vGdsCode = ?.
     2757         define variable Vflagmark as logical no-undo.
     2758         define variable VflagOAD  as logical no-undo.
     2759         assign
     2760            Vflagmark = no
     2761            VflagOAD = no
     2762         .
     2763         block-mark:
     2764         for each utd-marking-lines
     2765                  where utd-marking-lines.db-num  = utd-lines.db-num
     2766                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     2767                    and utd-marking-lines.LineNum = utd-lines.LineNum
     2768         no-lock:
     2769            if    isMark(utd-marking-lines.mark)
     2770               or isOAD (utd-marking-lines.mark)
     2771            then do:
     2772               define variable vnewGdsCode as integer no-undo.
     2773               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     2774               if isMark(utd-marking-lines.mark)
     2775               then do:
     2776                  Vflagmark = yes.
     2777                  find first marking where marking.mark eq utd-marking-lines.mark
     2778                  no-lock no-error.
     2779                  if not available marking
     2780                  then do:
     2781                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     2782                     next block-mark.
     2783                  end.
     2784                  if vnewGdsCode eq ?
     2785                  then
     2786                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     2787                  if    marking.gds-code eq 0
     2788                     or marking.gds-code eq ?
     2789                     or marking.sts eq 0
     2790                     or marking.sts eq ?
     2791                     or marking.box-qnty eq ?
     2792                     or (marking.gds-code ne vnewGdsCode
     2793                         and vnewGdsCode ne ?
     2794                         and vnewGdsCode ne 0)
     2795                  then do:
     2796                     find first marking where marking.mark eq utd-marking-lines.mark
     2797                     exclusive-lock no-error.
     2798                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     2799                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     2800                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     2801                     if    marking.gds-ext-id eq ""
     2802                        or marking.gds-ext-id eq ?
     2803                     then do:
     2804                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     2805                     end.
     2806                     else if    marking.gds-code eq 0
     2807                             or marking.gds-code eq ?
     2808                     then
     2809                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     2810                     else if     marking.sts eq 0
     2811                             or  marking.sts eq ?
     2812                     then
     2813                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     2814                  end.
     2815                  if utd-marking-lines.doc-level eq 1
     2816                  then do:
     2817                     if marking.box-qnty eq ?
     2818                     then
     2819                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     2820                  end.
     2821               end.
     2822               else do:
     2823                  VflagOAD = yes.
     2824                  define variable vQnty as decimal no-undo.
     2825                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     2826                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     2827                                          utd-marking-lines.doc-id,
     2828                                          utd-marking-lines.LineNum,
     2829                                          utd-marking-lines.mark,
     2830                                          "box-qnty",
     2831                                           string(vQnty)).
     2832                  define variable vgtin as character no-undo.
     2833                  vgtin = getGtinByDM(utd-marking-lines.mark).
     2834                  if getQntyCodeByGtin(vgtin) ne 1
     2835                  then
     2836                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     2837               end.
     2838               if utd-marking-lines.gds-code ne vnewGdsCode
     2839               and vnewGdsCode ne ?
     2840               and vnewGdsCode ne 0
     2841               then do:
     2842                  find first buf_utd-marking-lines
     2843                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     2844                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     2845                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     2846                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     2847                  exclusive-lock no-error.
     2848                  if available buf_utd-marking-lines
     2849                  then do:
     2850                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     2851                  end.
     2852               end.
     2853            end.
     2854            else  do:
     2855               define variable vgdsbar as integer no-undo.
     2856               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     2857               if    utd-marking-lines.gds-code ne vgdsbar
     2858               then do:
     2859                  find first buf_utd-marking-lines
     2860                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     2861                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     2862                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     2863                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     2864                  exclusive-lock no-error.
     2865                  if available buf_utd-marking-lines
     2866                  then do:
     2867                     buf_utd-marking-lines.gds-code = vgdsbar.
     2868                  end.
     2869               end.
     2870               if vgdsbar ne ?
     2871               then do:
     2872                                 if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2873                            ( vgdsbar,
     2874                              'mark-type':U,
     2875                              output v-par-val,
     2876                              output v-par-type
     2877                             ).
     2878                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     2879                       or  EDOParSec:GetIsArticForType(v-par-val))
     2880                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     2881                   and     EDOParSec:IsEdo
     2882                  then do:
     2883                     AddUtdErr(utd-marking-lines.db-num,
     2884                               utd-marking-lines.doc-id,
     2885                               buffer utd-marking-lines:handle,
     2886                               iErrType,
     2887                               "MarkingForTypeEDO",
     2888                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     2889                  end.
     2890               end.
     2891            end.
     2892            if vGdsCode eq ?
     2893            then
     2894               vGdsCode = utd-marking-lines.gds-code.
     2895            if vGdsCode ne utd-marking-lines.gds-code
     2896            and utd-marking-lines.gds-code > 0
     2897            then do:
     2898               vGdsCode = -1.
     2899            end.
     2900         end.
     2901         if  vGdsCode = -1
     2902         then do:
     2903            vGdsCode = ?.
     2904            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     2905            next block-line.
     2906         end.
     2907         if vGdsCode ne ?
     2908         then do:
     2909                     if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2910                      ( vGdsCode,
     2911                        'mark-type':U,
     2912                        output v-par-val,
     2913                        output v-par-type
     2914                       ).
     2915            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     2916                and(
     2917                 (    EDOParSec:GetIsEDOForType(v-par-val)
     2918                     and not Vflagmark)
     2919                 or  (EDOParSec:GetIsArticForType(v-par-val)
     2920                     and not VflagOAD
     2921                     and not Vflagmark))
     2922            then do:
     2923               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     2924            end.
     2925         end.
     2926         if utd-lines.gds-code ne vGdsCode
     2927         then do:
     2928            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     2929                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     2930                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     2931            exclusive-lock no-error.
     2932            if available buf_utd-lines
     2933            then
     2934               buf_utd-lines.gds-code = vGdsCode.
     2935            release buf_utd-lines.
     2936         end.
     2937         define variable VBarCode as character no-undo.
     2938         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     2939         if VBarCode ne ?
     2940         then do:
     2941            if num-entries(VBarCode," ") > 0
     2942            then
     2943               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     2944            vgdsbar = GetGdsCodeByGtin(VBarCode).
     2945            if vgdsbar eq ? or vgdsbar eq 0
     2946            then do:
     2947               AddUtdErr(utd-lines.db-num,
     2948                         utd-lines.doc-id,
     2949                         buffer utd-lines:handle,
     2950                         iErrType,
     2951                         "NotFindGdsForBarCode",
     2952                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     2953            end.
     2954            else do:
     2955               if    utd-lines.gds-code eq ?
     2956                  or utd-lines.gds-code eq 0
     2957               then do:
     2958                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     2959                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     2960                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     2961                  exclusive-lock no-error.
     2962                  if available buf_utd-lines
     2963                  then
     2964                     buf_utd-lines.gds-code = vgdsbar.
     2965                  release buf_utd-lines.
     2966               end.
     2967               else if utd-lines.gds-code ne vgdsbar
     2968               then do:
     2969                  AddUtdErr(utd-lines.db-num,
     2970                         utd-lines.doc-id,
     2971                         buffer utd-lines:handle,
     2972                         iErrType,
     2973                         "NotEqGgsForLineAndMark",
     2974                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     2975               end.
     2976            end.
     2977         end.
     2978         if vGdsCode eq ? and utd-lines.gds-code eq ?
     2979         then
     2980            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     2981      end.
     2982   end.
     2983   method public logical GetUtdLineForOrig
     2984   (input idb-num as integer,
     2985    input idoc-id as integer,
     2986    input ilineNum as integer,
     2987    input idb-numOrig as integer,
     2988    input idoc-idOrig as integer,
     2989    buffer edoc-lines for utd-lines):
     2990      define buffer edoc-marking-lines for ub.utd-marking-lines.
     2991      block-mark:
     2992      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     2993                                   and utd-marking-lines.doc-id  eq idoc-id
     2994                                   and utd-marking-lines.LineNum eq iLineNum
     2995                                   and utd-marking-lines.site eq "-"
     2996      no-lock:
     2997         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     2998                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     2999                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3000                     no-lock no-error.
     3001         if available edoc-marking-lines
     3002         then do:
     3003            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3004                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3005                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3006            no-lock no-error.
     3007               leave block-mark.
     3008          end.
     3009      end.
     3010       if not available edoc-lines
     3011       then do:
     3012          find  first  utd-lines where utd-lines.db-num      = idb-num
     3013                                   and utd-lines.doc-id      = idoc-id
     3014                                   and utd-lines.LineNum     = ilinenum
     3015             no-lock no-error.
     3016          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3017                                  and edoc-lines.doc-id      = idoc-idOrig
     3018                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3019          no-lock no-error.
     3020       end.
     3021       if not available edoc-lines
     3022       then
     3023          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3024                                  and edoc-lines.doc-id      = idoc-idOrig
     3025                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3026          no-lock no-error.
     3027   end.
     3028   method public logical getObgFns
     3029   (input iDocumentNumber   as character ,
     3030    input iFnsParticipantId as character ,
     3031    input ikpp              as character ,
     3032    output ohost-code       as integer,
     3033    output oobj-type        as character ,
     3034    output oobj-code        as integer ,
     3035    output otext            as character  ):
     3036       define buffer ext-classif   for ext-classif.
     3037       define buffer clients       for clients.
     3038       define buffer buf_clients   for clients.
     3039       define buffer clients-attr  for clients-attr.
     3040       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3041                                and ext-classif.charkey_three eq iFnsParticipantId
     3042       no-lock no-error.
     3043       if available ext-classif
     3044       then do:
     3045          if ext-classif.CharKey_One eq 'маг':U
     3046          then do:
     3047             assign
     3048                oobj-type = ext-classif.CharKey_One
     3049                oobj-code = ext-classif.Key#_One
     3050             .
     3051             find first clients
     3052                  where clients.obj-type   = ext-classif.CharKey_One
     3053                    and clients.obj-code   = ext-classif.Key#_One
     3054             no-lock no-error .
     3055             if available clients
     3056             then
     3057                ohost-code =  clients.host-code.
     3058          end.
     3059          else do:
     3060             find first clients
     3061                  where clients.obj-type   = ext-classif.CharKey_One
     3062                    and clients.obj-code   = ext-classif.Key#_One
     3063                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3064             no-lock no-error .
     3065             if not available clients
     3066             then do:
     3067                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3068                return no.
     3069             end.
     3070             ohost-code = ext-classif.Key#_One.
     3071             block-cl:
     3072             for each clients-attr
     3073                where clients-attr.attr-code  = 'kpp':U
     3074                  and clients-attr.obj-type   = 'маг':U
     3075                  and clients-attr.attr-value = ikpp
     3076                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3077                                             and buf_clients.obj-code   = clients-attr.obj-code
     3078                                             and buf_clients.host-code  = ohost-code)
     3079             no-lock :
     3080                leave block-cl.
     3081             end.
     3082             if     available clients
     3083                and clients.obj-type eq 'маг':U
     3084             then do:
     3085                assign
     3086                   oobj-type = clients.obj-type
     3087                   oobj-code = clients.obj-code
     3088                .
     3089             end.
     3090             else if available clients-attr
     3091             then do:
     3092                assign
     3093                   oobj-type = clients-attr.obj-type
     3094                   oobj-code = clients-attr.obj-code
     3095                .
     3096             end.
     3097             else do:
     3098                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3099                return yes.
     3100             end.
     3101          end.
     3102       end.
     3103       else do:
     3104          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3105          return no.
     3106       end.
     3107       return ?.
     3108   end.
     3109   method public logical CheckUcdForReturn
     3110   (input idb-numUcd as integer,
     3111    input idoc-idUcd as integer,
     3112    input idb-numRet as integer,
     3113    input idoc-idRet as integer  ):
     3114       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3115                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3116                                    and utd-marking-lines.doc-level eq 1
     3117       no-lock:
     3118          create tt-utd-mark.
     3119          buffer-copy utd-marking-lines to tt-utd-mark
     3120          assign
     3121             tt-utd-mark.side = "+"
     3122          .
     3123       end.
     3124       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3125                                    and utd-marking-lines.doc-id eq idoc-idRet
     3126                                    and utd-marking-lines.doc-level eq 1
     3127       no-lock:
     3128          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3129          no-lock no-error.
     3130          if available tt-utd-mark
     3131          then
     3132             tt-utd-mark.side = "".
     3133          else do:
     3134             create tt-utd-mark.
     3135             buffer-copy utd-marking-lines to tt-utd-mark
     3136             assign
     3137                tt-utd-mark.side = "-"
     3138             .
     3139          end.
     3140       end.
     3141       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3142       no-lock:
     3143          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3144       end.
     3145       for each tt-utd-mark:
     3146          delete tt-utd-mark.
     3147       end.
     3148   end.
     3149   method public character  SaturateAndCheckUTD
     3150   (input idb-num as integer,
     3151    input idoc-id as integer  ):
     3152      define buffer clients-attr          for clients-attr.
     3153      define buffer clients               for clients.
     3154      define buffer Utd                   for Utd.
     3155      define buffer utd_ret               for ub.utd.
     3156      define buffer utd-lines             for utd-lines.
     3157      define buffer buf_utd-lines         for utd-lines.
     3158      define buffer buf_utddoc-lines      for utd-lines.
     3159      define buffer marking               for marking.
     3160      define buffer marking-lines         for marking-lines.
     3161      define buffer utd-marking-lines     for utd-marking-lines.
     3162      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3163      define buffer contract              for contract.
     3164      define buffer old_utd               for Utd.
     3165      define variable vError as character no-undo.
     3166      define variable vGdsCode as integer no-undo.
     3167      define variable vcli-type as character no-undo.
     3168      define variable vcli-code as integer no-undo.
     3169      define variable vhost-code as integer no-undo init ?.
     3170      define variable vcontract-code as integer no-undo.
     3171      define variable vobj-type as character no-undo init ?.
     3172      define variable vobj-code as integer no-undo init ?.
     3173      define variable volddb-num as integer no-undo.
     3174      define variable volddoc-id as integer no-undo.
     3175      define variable vMark as logical no-undo.
     3176      define variable VUcd as logical no-undo.
     3177      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3178      define variable v-par-type as character no-undo.
     3179      define variable v-par-val  as character no-undo.
     3180      define variable VFileMark as logical no-undo.
     3181      define variable vunit     as int no-undo.
     3182      define variable vunitCode as character no-undo.
     3183      define variable vMarkingUtd as logical no-undo.
     3184      find first Utd where utd.db-num eq idb-num
     3185                       and utd.doc-id eq idoc-id
     3186      no-lock no-error.
     3187      if available Utd
     3188      then do:
     3189         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3190         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3191         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3192         assign
     3193               vobj-type  = utd.obj-type
     3194               vobj-code  = utd.obj-code
     3195               vhost-code = utd.host-code
     3196         .
     3197         do:
     3198            define variable vtext       as character no-undo.
     3199            define variable vhost-code1 as integer   no-undo.
     3200            define variable vobj-type1  as character no-undo.
     3201            define variable vobj-code1  as integer   no-undo.
     3202             getObgFns
     3203                       (input utd.DocumentNumber ,
     3204                        input utd.obj-FnsParticipantId ,
     3205                        input utd.obj-kpp,
     3206                        output vhost-code1,
     3207                        output vobj-type1,
     3208                        output vobj-code1,
     3209                        output vtext ).
     3210            assign
     3211               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3212               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3213               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3214            .
     3215            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3216            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3217            block-line:
     3218            for each utd-lines where utd-lines.db-num eq utd.db-num
     3219                                 and utd-lines.doc-id eq utd.doc-id
     3220            no-lock:
     3221               vGdsCode =?.
     3222               define variable vNotMarkForLine as logical no-undo.
     3223               vNotMarkForLine = no.
     3224               if not VUcd
     3225               then do:
     3226                  find first utd-marking-lines
     3227                       where utd-marking-lines.db-num  = utd-lines.db-num
     3228                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3229                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3230                  no-lock no-error.
     3231                  if not available utd-marking-lines
     3232                  then do:
     3233                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3234                     vNotMarkForLine = yes.
     3235                  end.
     3236               end.
     3237               block-mark:
     3238               for each utd-marking-lines
     3239                  where utd-marking-lines.db-num  = utd-lines.db-num
     3240                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3241                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3242               no-lock:
     3243                  vMark = yes.
     3244                  if     isMark(utd-marking-lines.mark)
     3245                     and utd-marking-lines.gds-code  ne 0
     3246                     and utd-marking-lines.gds-code ne ?
     3247                  then do:
     3248                                       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     3249                           ( utd-marking-lines.gds-code,
     3250                            'mark-type':U,
     3251                            output v-par-val,
     3252                            output v-par-type
     3253                            ).
     3254                      if     not VFileMark
     3255                         and not VUcd
     3256                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3257                      then do:
     3258                          AddUtdErr(utd.db-num,
     3259                                     utd.doc-id,
     3260                                     buffer utd-marking-lines:handle,
     3261                                     "loadUtd",
     3262                                     "NotON_NSCHFDOPPRMARK",
     3263                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3264                     end.
     3265                  end.
     3266               end.
     3267               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3268               then do :
     3269                  if     VUcd
     3270                  then do:
     3271                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3272                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3273                     if available buf_utddoc-lines
     3274                     then do:
     3275                        vGdsCode = buf_utddoc-lines.gds-code.
     3276                        vunitCode = buf_utddoc-lines.UnitCode.
     3277                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3278                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3279                        then
     3280                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3281                               "loadUtd",
     3282                               "UcdUnitChangForUtd",
     3283                               string(utd-lines.LineNum )                  + chr(4) +
     3284                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3285                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3286                     end.
     3287                     if     utd-lines.UnitCode ne ?
     3288                        and utd-lines.UnitCode ne ""
     3289                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3290                     then
     3291                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3292                               "loadUtd",
     3293                               "UcdUnitChang",
     3294                               string(utd-lines.LineNum )                  + chr(4) +
     3295                               utd-lines.UnitCode                          + chr(4) +
     3296                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3297                  end.
     3298               end.
     3299               else
     3300                  vGdsCode = utd-lines.gds-code.
     3301               define variable vValText as character no-undo.
     3302               define variable vValDec  as decimal no-undo.
     3303               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3304               if VValText = ?
     3305               then do:
     3306                  vValDec = utd-lines.Quantity.
     3307                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3308               end.
     3309               else
     3310                  vValDec = dec(VValText).
     3311               release bar-code .
     3312               if     vGdsCode > 0 and vGdsCode ne ?
     3313               then do:
     3314                  assign
     3315                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3316                     vunit = ?
     3317                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3318                  no-error.
     3319                  if vunit ne 0 and vunit ne ?
     3320                  then do:
     3321                     find units where units.OKEI eq vunit no-lock no-error.
     3322                     if available units
     3323                     then
     3324                        vunitCode = units.unit-name.
     3325                  end.
     3326                  find first bar-code where bar-code.gds-code eq vGdsCode
     3327                                        and bar-code.unit-cli eq vUnitCode
     3328                  no-lock no-error.
     3329                  if not available bar-code
     3330                  then
     3331                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3332                               "loadUtd",
     3333                               "Unit",
     3334                               string(utd-lines.LineNum )                  + chr(4) +
     3335                               string(vGdsCode)                            + chr(4) +
     3336                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3337                               vunitCode).
     3338               end.
     3339               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3340               then do:
     3341                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3342                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3343                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3344                  exclusive-lock no-error.
     3345                  if available buf_utd-lines
     3346                  then do:
     3347                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3348                     release buf_utd-lines.
     3349                  end.
     3350               end.
     3351               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3352               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3353               if     not VUcd
     3354                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3355               then
     3356                  vMarkingUtd = yes .
     3357            end.
     3358            if not VUcd
     3359            then
     3360               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3361            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3362                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3363            no-lock no-error.
     3364            if available ext-classif
     3365            then
     3366               assign
     3367                  vcli-type = ext-classif.CharKey_One
     3368                  vcli-code = ext-classif.Key#_One
     3369               .
     3370            else do:
     3371               assign
     3372                 vcli-type = ?
     3373                 vcli-code = ?
     3374               .
     3375               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3376            end.
     3377            find first contract  where contract.host-code eq vhost-code
     3378                                   and contract.cli-type  eq vcli-type
     3379                                   and contract.cli-code  eq vcli-code
     3380                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     3381            no-lock no-error.
     3382            define variable VContractEdo as logical no-undo init yes.
     3383            if available contract
     3384            then do:
     3385               assign
     3386                  VContractEdo = contract.whole-send-news > 0
     3387                  vcontract-code = contract.contract-code
     3388               .
     3389               if not VContractEdo
     3390               then
     3391                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     3392            end.
     3393            else do:
     3394               vcontract-code = ?.
     3395            end.
     3396         end.
     3397         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     3398         then do:
     3399            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     3400         end.
     3401         define variable vdoc-code as character no-undo init ?.
     3402         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     3403         then do:
     3404            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     3405                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     3406                                 and utd_ret.Timestamp             le utd.Timestamp
     3407                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     3408            no-lock no-error.
     3409            if available utd_ret
     3410            then do:
     3411               vdoc-code = utd_ret.doc-code.
     3412               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     3413            end.
     3414         end.
     3415      end.
     3416      find current utd exclusive-lock no-error.
     3417      if available utd
     3418      then do:
     3419         assign
     3420            utd.cli-type      = vcli-type      when vcli-type      ne ?
     3421            utd.cli-code      = vcli-code      when vcli-type      ne ?
     3422            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     3423            utd.contract-code = vcontract-code when vcontract-code ne ?
     3424            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     3425            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     3426            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     3427         .
     3428         if   ( utd.contract-code eq ?
     3429            or utd.contract-code eq 0)
     3430            and not vucd
     3431         then
     3432            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     3433         if utd.host-code eq ?
     3434            or utd.host-code eq 0
     3435         then
     3436            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     3437         if utd.obj-code eq ?
     3438            or utd.obj-code eq 0
     3439         then
     3440            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     3441      end.
     3442      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     3443      if vError eq ""
     3444      then do:
     3445         if utd.sts eq 0 or utd.sts eq ?
     3446         then
     3447            utd.sts = if VUcd
     3448                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     3449                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3450         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     3451         then do:
     3452            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3453         end.
     3454         if     not VUcd
     3455            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     3456         then do:
     3457            if not vMarkingUtd
     3458            then
     3459               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     3460         end.
     3461      end.
     3462      else do:
     3463         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     3464         then
     3465            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     3466      end.
     3467      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3468         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     3469      then
     3470         utd.sts-edi = ?.
     3471      else if     (not vMark and  not vucd) or not VContractEdo
     3472              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3473      then
     3474         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     3475      release utd no-error.
     3476      if error-status:error
     3477      then
     3478         return error return-value.
     3479      return vError.
     3480   end.
     3481   method public logical ReCheckload
     3482   (idb-num as integer,
     3483    idoc-id as integer,
     3484    iload   as logical ):
     3485      define buffer buf_c-utd for ub.c-utd .
     3486      define buffer buf_utd   for ub.utd .
     3487      find first buf_utd where buf_utd.db-num eq idb-num
     3488                           and buf_utd.doc-id eq idoc-id
     3489      exclusive-lock no-error.
     3490      if available buf_utd
     3491      then do:
     3492         if    iload
     3493            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     3494         then do:
     3495            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     3496            if  error-status:error then
     3497            do:
     3498               message return-value view-as alert-box.
     3499            end.
     3500         end.
     3501         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3502            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3503            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3504            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     3505         then do:
     3506            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     3507                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     3508                                              buf_c-utd.sts    eq buf_utd.sts and
     3509                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3510            no-error .
     3511            if available (buf_c-utd)
     3512            then do:
     3513               buf_utd.sts = buf_c-utd.sts .
     3514               buf_utd.sts-edi = buf_c-utd.sts-edi .
     3515            end.
     3516            else do:
     3517               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3518                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3519               then
     3520                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     3521               else
     3522                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     3523               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     3524            end.
     3525         end.
     3526         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     3527         then do:
     3528            run utl/utd-checkSpec.p (input buf_utd.db-num,
     3529                                     input buf_utd.doc-id) .
     3530         end.
     3531      end.
     3532      release buf_utd.
     3533   end.
     3534   method public logical ReCheck
     3535   (idb-num as integer,
     3536    idoc-id as integer ):
     3537      ReCheckload(idb-num,idoc-id,no).
     3538   end.
     3539   method public logical GetLastUTDForPac
     3540   (iPackegeId as character ,
     3541    iTimestamp as datetime,
     3542    output odb-num as integer,
     3543    output odoc-id as integer ):
     3544      define buffer buf_utd for utd.
     3545      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     3546                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3547                                and Buf_utd.Timestamp gt iTimestamp
     3548      no-lock no-error.
     3549      if available  buf_utd
     3550      then
     3551         assign
     3552            odb-num = buf_utd.db-num
     3553            odoc-id = buf_utd.doc-id
     3554         no-error.
     3555      else
     3556         assign
     3557            odb-num = ?
     3558            odoc-id = ?
     3559         no-error.
     3560   end.
     3561   method public logical GetprevUTDForPac
     3562   (iPackegeId as character ,
