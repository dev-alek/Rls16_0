     3583   method public logical GetLastUTDinPackAft
     3584   (input idb-num as integer,
     3585    input idoc-id as integer,
     3586    output odb-num as integer,
     3587    output odoc-id as integer ):
     3588      define buffer buf_utd for utd.
     3589      define buffer     utd for utd.
     3590      find first utd where utd.db-num eq idb-num
     3591                       and utd.doc-id eq idoc-id
     3592      no-lock no-error.
     3593      if available utd
     3594      then do:
     3595         if utd.PackageId eq ""
     3596         then do:
     3597            assign
     3598               odb-num = utd.db-num
     3599               odoc-id = utd.doc-id
     3600            .
     3601            return yes.
     3602         end.
     3603         else do:
     3604            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     3605            if    odb-num eq ?
     3606               or odoc-id eq ?
     3607            then do:
     3608               assign
     3609                  odb-num = utd.db-num
     3610                  odoc-id = utd.doc-id
     3611               .
     3612               return yes.
     3613            end.
     3614            else
     3615               return odoc-id = utd.doc-id.
     3616         end.
     3617      end.
     3618      return ?.
     3619   end.
