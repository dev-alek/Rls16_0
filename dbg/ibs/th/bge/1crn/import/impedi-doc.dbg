      271   method public void setattrUtdlines
      272   (idb-num   as integer,
      273    idoc-id   as integer,
      274    ilinenum  as integer,
      275    iattrcode as character,
      276    iattrval  as character ):
      277      define buffer utd-lines-attr for utd-lines-attr.
      278      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      279                                  and utd-lines-attr.doc-id    eq idoc-id
      280                                  and utd-lines-attr.lineNum   eq ilineNum
      281                                  and utd-lines-attr.attr-code eq iattrcode
      282      no-lock no-error.
      283      if not available utd-lines-attr
      284      then do:
      285         if iattrval ne ?
      286            and iattrval ne ""
      287         then do:
      288            create utd-lines-attr.
      289            assign
      290               utd-lines-attr.db-num    = idb-num
      291               utd-lines-attr.doc-id    = idoc-id
      292               utd-lines-attr.lineNum   = ilineNum
      293               utd-lines-attr.attr-code = iattrcode
      294               utd-lines-attr.attr-value = iattrval
      295            .
      296         end.
      297      end.
      298      else do:
      299         if utd-lines-attr.attr-value ne iattrval
      300         then do:
      301            find current utd-lines-attr exclusive-lock no-error.
      302            if available utd-lines-attr
      303            then do:
      304               if    iattrval eq ?
      305                  or iattrval eq ""
      306               then do:
      307                  delete utd-lines-attr.
      308               end.
      309               else do:
      310                  utd-lines-attr.attr-value = iattrval.
      311               end.
      312            end.
      313         end.
      314      end.
      315      release utd-lines-attr.
      316   end.
