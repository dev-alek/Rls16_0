      251   (idb-num   as integer,
      252    idoc-id   as integer,
      253    ilinenum  as integer,
      254    iattrcode as character,
      255    iExValue  as character  ):
      256      define buffer utd-lines-attr for utd-lines-attr.
      257      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      258                                  and utd-lines-attr.doc-id    eq idoc-id
      259                                  and utd-lines-attr.lineNum   eq ilineNum
      260                                  and utd-lines-attr.attr-code eq iattrcode
      261      no-lock no-error.
      262      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      263   end.
