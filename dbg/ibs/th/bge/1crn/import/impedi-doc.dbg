      393   method private void xmlchar-test (input  p-in-string          as character,
      394                                     output p-out-string-enc     as character,
      395                                     output p-out-string-dec    as character):
      396   do
      397   on error undo, return error
      398   :
      399          xmlchar-encode
      400       (
      401             input p-in-string
      402           , output p-out-string-enc
      403       ).
      404          xmlchar-decode
      405       (
      406             input p-out-string-enc
      407           , output p-out-string-dec
      408       ).
      409   end.
      410   end .
      411   method private void xmlchar-encode (input  p-in-string          as character,
      412                                     output p-out-string         as character):
      413       define variable v-position      as integer      no-undo.
      414       define variable v-current-char  as character    no-undo.
      415   do
      416   on error undo, return error
      417   :
      418       assign
      419           p-out-string = "":U
      420       .
      421       case p-in-string
      422       :
      423           when ?
      424           then do:
      425               assign
      426                   p-out-string = "?":U
      427               .
      428           end.
      429           when "?":U
      430           then do:
      431               assign
      432                   p-out-string = "&#63;":U
      433               .
      434           end.
      435           otherwise do:
      436               do v-position = 1 to length( p-in-string )
      437               :
      438                   assign
      439                       v-current-char = substring( p-in-string, v-position, 1 )
      440                   .
      441                   case v-current-char
      442                   :
      443                       when "&":U
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + "&amp;":U
      447                           .
      448                       end.
      449                       when ">":U
      450                       then do:
      451                           assign
      452                               p-out-string = p-out-string + "&gt;":U
      453                           .
      454                       end.
      455                       when "<":U
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + "&lt;":U
      459                           .
      460                       end.
      461                       when "'":U
      462                       then do:
      463                           assign
      464                               p-out-string = p-out-string + "&apos;":U
      465                           .
      466                       end.
      467                       when '"':U
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&quot;":U
      471                           .
      472                       end.
      473                       when chr(1)
      474                       then do:
      475                           assign
      476                               p-out-string = p-out-string + "":U
      477                           .
      478                       end.
      479                       when chr(2)
      480                       then do:
      481                           assign
      482                               p-out-string = p-out-string + "":U
      483                           .
      484                       end.
      485                       when chr(3)
      486                       then do:
      487                           assign
      488                               p-out-string = p-out-string + "":U
      489                           .
      490                       end.
      491                       when chr(4)
      492                       then do:
      493                           assign
      494                               p-out-string = p-out-string + "":U
      495                           .
      496                       end.
      497                       when chr(5)
      498                       then do:
      499                           assign
      500                               p-out-string = p-out-string + "":U
      501                           .
      502                       end.
      503                       when chr(6)
      504                       then do:
      505                           assign
      506                               p-out-string = p-out-string + "":U
      507                           .
      508                       end.
      509                       when chr(7)
      510                       then do:
      511                           assign
      512                               p-out-string = p-out-string + "":U
      513                           .
      514                       end.
      515                       when chr(8)
      516                       then do:
      517                           assign
      518                               p-out-string = p-out-string + "":U
      519                           .
      520                       end.
      521                       when chr(9)
      522                       then do:
      523                           assign
      524                               p-out-string = p-out-string + "":U
      525                           .
      526                       end.
      527                       when chr(29)
      528                       then do:
      529                           assign
      530                               p-out-string = p-out-string + "":U
      531                           .
      532                       end.
      533                       when chr(10)
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + "&#10;":U
      537                           .
      538                       end.
      539                       when chr(13)
      540                       then do:
      541                           assign
      542                               p-out-string = p-out-string + "&#13;":U
      543                           .
      544                       end.
      545                       otherwise do:
      546                           assign
      547                               p-out-string = p-out-string + v-current-char
      548                           .
      549                       end.
      550                   end case.
      551               end.
      552           end.
      553       end case.
      554   end.
      555   end .
      556   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      557   define variable p-out-string as character no-undo.
      558       define variable v-position      as integer      no-undo.
      559       define variable v-current-char  as character    no-undo.
      560   do
      561   on error undo, return error
      562   :
      563       assign
      564           p-out-string = "":U
      565       .
      566       case p-in-string
      567       :
      568           when ?
      569           then do:
      570               assign
      571                   p-out-string = "?":U
      572               .
      573           end.
      574           otherwise do:
      575               do v-position = 1 to length( p-in-string )
      576               :
      577                   assign
      578                       v-current-char = substring( p-in-string, v-position, 1 )
      579                   .
      580                   case v-current-char
      581                   :
      582                       when chr(1)
      583                       then do:
      584                           assign
      585                               p-out-string = p-out-string + " ":U
      586                           .
      587                       end.
      588                       when chr(2)
      589                       then do:
      590                           assign
      591                               p-out-string = p-out-string + " ":U
      592                           .
      593                       end.
      594                       when chr(3)
      595                       then do:
      596                           assign
      597                               p-out-string = p-out-string + " ":U
      598                           .
      599                       end.
      600                       when chr(4)
      601                       then do:
      602                           assign
      603                               p-out-string = p-out-string + " ":U
      604                           .
      605                       end.
      606                       when chr(5)
      607                       then do:
      608                           assign
      609                               p-out-string = p-out-string + " ":U
      610                           .
      611                       end.
      612                       when chr(6)
      613                       then do:
      614                           assign
      615                               p-out-string = p-out-string + " ":U
      616                           .
      617                       end.
      618                       when chr(7)
      619                       then do:
      620                           assign
      621                               p-out-string = p-out-string + " ":U
      622                           .
      623                       end.
      624                       when chr(8)
      625                       then do:
      626                           assign
      627                               p-out-string = p-out-string + " ":U
      628                           .
      629                       end.
      630                       when chr(9)
      631                       then do:
      632                           assign
      633                               p-out-string = p-out-string + " ":U
      634                           .
      635                       end.
      636                       when chr(29)
      637                       then do:
      638                           assign
      639                               p-out-string = p-out-string + " ":U
      640                           .
      641                       end.
      642                       when chr(10)
      643                       then do:
      644                           assign
      645                               p-out-string = p-out-string + " ":U
      646                           .
      647                       end.
      648                       when chr(13)
      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + " ":U
      652                           .
      653                       end.
      654                       otherwise do:
      655                           assign
      656                               p-out-string = p-out-string + v-current-char
      657                           .
      658                       end.
      659                   end case.
      660               end.
      661           end.
      662       end case.
      663   end.
      664   return p-out-string.
      665   end .
      666   method private void xmlchar-decode (input  p-in-string          as character,
      667                                     output p-out-string         as character):
      668       define variable v-position      as integer      no-undo.
      669       define variable v-last-position as integer      no-undo.
      670       define variable v-temp-integer  as integer      no-undo.
      671       define variable v-current-char  as character    no-undo.
      672       define variable v-next-char     as character    no-undo.
      673       define variable v-success       as logical      no-undo.
      674   do
      675   on error undo, return error
      676   :
      677       assign
      678           p-out-string = "":U
      679           v-position   = 0
      680       .
      681       replace-cycle:
      682       do while yes
      683       on error undo, return error
      684       :
      685           assign
      686               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      687           .
      688           if v-last-position <= v-position
      689           then do:
      690               if v-position = 0
      691               then do:
      692                   assign
      693                       p-out-string = p-in-string
      694                   .
      695               end.
      696               else do:
      697                   assign
      698                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      699                   .
      700               end.
      701               leave replace-cycle.
      702           end.
      703           else do:
      704               assign
      705                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      706                   v-position      = v-last-position
      707                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      708               .
      709               if v-current-char = "#":U
      710               then do:
      711                   assign
      712                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      713                   .
      714                   if v-last-position > 0
      715                   then do:
      716                       xmlchar-read-integer
      717                        (
      718                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      719                           , output v-temp-integer
      720                           , output v-success
      721                       ).
      722                       if v-success = yes
      723                       and v-temp-integer >= 1
      724                       and v-temp-integer <= 255
      725                       then do:
      726                           assign
      727                               p-out-string = p-out-string + chr( v-temp-integer )
      728                               v-position   = v-last-position + 1
      729                           .
      730                       end.
      731                       else do:
      732                           assign
      733                               p-out-string = p-out-string + "&":U
      734                               v-position   = v-position   + 1
      735                           .
      736                       end.
      737                   end.
      738                   else do:
      739                       assign
      740                           p-out-string = p-out-string + "&":U
      741                           v-position   = v-position   + 1
      742                       .
      743                   end.
      744               end.
      745               else do:
      746                   case substring( p-in-string, v-position + 1, 3 )
      747                   :
      748                       when "lt;":U
      749                       then do:
      750                           assign
      751                               p-out-string = p-out-string + "<":U
      752                               v-position   = v-position   + 3
      753                           .
      754                       end.
      755                       when "gt;":U
      756                       then do:
      757                           assign
      758                               p-out-string = p-out-string + ">":U
      759                               v-position   = v-position   + 3
      760                           .
      761                       end.
      762                       otherwise do:
      763                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      764                           then do:
      765                               assign
      766                                   p-out-string = p-out-string + "&":U
      767                                   v-position   = v-position   + 4
      768                               .
      769                           end.
      770                           else do:
      771                               case substring( p-in-string, v-position + 1, 5 )
      772                               :
      773                                   when "quot;":U
      774                                   then do:
      775                                       assign
      776                                           p-out-string = p-out-string + '"':U
      777                                           v-position   = v-position   + 5
      778                                       .
      779                                   end.
      780                                   when "apos;":U
      781                                   then do:
      782                                       assign
      783                                           p-out-string = p-out-string + "'":U
      784                                           v-position   = v-position   + 5
      785                                       .
      786                                   end.
      787                                   otherwise do:
      788                                       assign
      789                                           p-out-string = p-out-string + "&":U
      790                                       .
      791                                   end.
      792                               end case.
      793                           end.
      794                       end.
      795                   end case.
      796               end.
      797           end.
      798       end.
      799   end.
      800   end .
      801   method private void xmlchar-read-integer (input  p-input-string       as character,
      802                                             output p-output-integer     as integer,
      803                                             output p-success            as logical):
      804   do
      805   on error undo, return error
      806   :
      807       assign
      808           p-output-integer = integer( p-input-string )
      809       no-error.
      810       if error-status :error
      811       then do:
      812           assign
      813               p-success           = no
      814               p-output-integer    = 0
      815           .
      816       end.
      817       else do:
      818           assign
      819               p-success           = yes
      820           .
      821       end.
      822   end.
      823   end.
      824   define variable mMRCCode  as logical    no-undo.
      825   define variable mTypeMark as character  no-undo.
      826   method private logical IS-NeedMark
      827   ( input ib-code as integer  ,
      828     input ib-str as character ):
      829      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      830      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      831                                    and buf_prod-bc-attr.b-str  eq ib-str
      832                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      833        no-lock no-error.
      834      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      835   end.
      836   method private character repTegforDm
      837   (iDM as char ):
      838       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      839       define variable vteg as character no-undo.
      840       define variable oDM as character no-undo.
      841       define variable vi as integer no-undo.
      842       oDM = iDm.
      843       do vi = 1 to num-entries(vTeglist):
      844          vTeg = entry(vi,vTeglist).
      845          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      846       end.
      847       return oDM.
      848   end.
      849   method private character repSpecSimbforDm
      850   (iDM as char ):
      851       define variable oDM as character no-undo.
      852       xmlchar-decode(iDM, output oDM).
      853     return repTegforDm (oDM).
      854   end.
      855   method private logical CheckGtin
      856   (iGtin as char):
      857      define variable bar_code as character no-undo.
      858      define variable vGtin as logical no-undo init "yes".
      859      if length(iGtin) eq 14
      860      then do:
      861         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      862         run str/chk-sum.p
      863          (input-output bar_code ) no-error .
      864         if iGtin ne  bar_code
      865         then
      866            vGtin = no.
      867      end.
      868      else
      869         vGtin = no.
      870      return vgtin.
      871   end.
      872   method private character repSpecSimbforXlm
      873   (iDM as char ):
      874       iDM = replace(iDM,chr(29),"").
      875       return iDM.
      876   end.
      877   method private character getGtinByDM
      878   (IDM as char):
      879      define variable VTXT as char no-undo.
      880      define variable vGtin as char no-undo.
      881      vTXt = IdM.
      882      vGtin = IDM.
      883      if    length(vtxt) > 14
      884      then do:
      885         if   vtxt begins "(01)"
      886                or vtxt begins "(02)"
      887         then
      888            vGtin = substring(vtxt,5,14).
      889         else if   (vtxt begins "01"
      890                or vtxt begins "02" )
      891                and (   (    substring(iDm,17,2) eq "21"
      892                         and length(vtxt) >= 21)
      893                     or substring(iDm,17,2) eq "37"
      894                     or substring(iDm,17,4) eq "(37)" )
      895         then do:
      896            vGtin = substring(vtxt,3,14).
      897            if not checkGtin(vGtin)
      898            then
      899               vGtin = substring(vtxt,1,14).
      900         end.
      901         else if     length(vtxt) eq 14 + 7 + 4 + 4
      902             or length(vtxt) eq 14 + 7 + 4
      903             or length(vtxt) eq 14 + 7
      904         then
      905            vGtin = substring(vtxt,1,14).
      906      end.
      907      if not checkGtin(vGtin)
      908      then
      909         vGtin = "".
      910      return vgtin.
      911   end.
      912   method private integer getGdsCodeByGtin
      913   (iGtin as char):
      914      define buffer prod-bc  for ub.prod-bc.
      915      define buffer bar-code for ub.bar-code.
      916      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      917      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      918      return if avail bar-code then bar-code.gds-code else ?.
      919   end.
      920   method private decimal getQntyCodeByGtin
      921   (iGtin as char):
      922      define buffer prod-bc  for ub.prod-bc.
      923      define buffer bar-code for ub.bar-code.
      924      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      925      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      926      return if avail bar-code then bar-code.cli-base-rate else ?.
      927   end.
      928   method private integer getGdsCodeByDM
      929   (iDm as char):
      930      define variable vGtin as char no-undo.
      931      define buffer prod-bc for ub.prod-bc.
      932      vGtin  = getGtinByDM (IDM ).
      933      return getGdsCodeByGtin (vGtin).
      934   end.
      935   method private logical ChekTypeMarkByGds
      936   (iGds-code as integer ):
      937      define buffer goods-attr for ub.goods-attr.
      938      find first goods-attr where goods-attr.gds-code   = iGds-code
      939                              and goods-attr.attr-code  = 'mark-type':U
      940      no-lock no-error.
      941      if available goods-attr
      942      then do:
      943         mTypeMark = goods-attr.attr-value.
      944         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      945           .
      946      end.
      947      else
      948         return no.
      949   end.
      950   method private logical ChekTypeMarkByDm
      951   (iDM as char ):
      952      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      953   end.
      954   method private logical ChekTypeMarkByGtin
      955   (iGtin as char ):
      956      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      957   end.
      958   method private character  GetNextElement
      959     (input iAllTeg        as logical
      960     ,output oteg          as character
      961     ,output otegval       as character
      962     ,input-output pstr    as character
      963      ):
      964        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      965        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      966        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      967        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      968        define variable vTeg as character no-undo.
      969        define variable vLength as integer no-undo.
      970        define variable vi as integer no-undo.
      971        define variable vj as integer no-undo.
      972        define buffer code for ub.code.
      973        find first code where Code.parent eq "MarkType"
      974                          and Code.CodeValue   eq mTypeMark
      975                          no-lock no-error.
      976        if     available code
      977           and Code.misc1 ne ""
      978           and Code.misc1 ne ?
      979        then do:
      980           integer (Code.misc1) no-error.
      981           if not error-status:error
      982           then
      983             entry (4,vlistleng) = Code.misc1.
      984        end.
      985        if iAllTeg
      986        then
      987           assign
      988              vlistElem     = vlistElem    + vlistElemDop
      989              vlistleng     = vlistleng    + vlistlengDop
      990           .
      991        else if mMRCCode
      992        then
      993           assign
      994              vlistElem     = vlistElem    + ",(8005),8005"
      995              vlistleng     = vlistleng    + ",000006,0006"
      996           .
      997       block-elem:
      998       do vi = 1 to num-entries(vlistElem):
      999          vTeg = entry(vi,vlistElem).
     1000          if pstr begins vTeg
     1001          then do:
     1002             if    vTeg eq "21"
     1003             then
     1004                vLength = index(pstr,chr(29)) - 2 no-error.
     1005             if vLength  <= 0
     1006             then
     1007                vLength = int(entry(vi,vlistleng)).
     1008             otegval = substring (pstr,length(vteg) + 1, vLength).
     1009             oteg = replace(replace(vteg,")",""),"(","").
     1010             vTeg = vteg + otegval.
     1011             otegval = replace(otegval,chr(29),"").
     1012             oteg = replace(replace(oteg,")",""),"(","").
     1013             pstr = substring (pstr,length(vTeg)+ 1).
     1014             vTeg = replace(vTeg,chr(29),"").
     1015             leave block-elem.
     1016          end.
     1017          else
     1018             vTeg = "".
     1019       end.
     1020       return vteg.
     1021   end.
     1022   method private character  GetCodeIdent
     1023   (iDm as char):
     1024      define variable Velement   as character no-undo init "first".
     1025      define variable oCodeIdent as character no-undo.
     1026      define variable vteg as character no-undo.
     1027      define variable vtegval as character no-undo.
     1028      define variable vGtin as character no-undo.
     1029      define buffer marking for ub.marking.
     1030      for first marking no-lock where
     1031                marking.mark eq iDm
     1032            and marking.unit-ext = "LEVEL2"
     1033      :
     1034        return iDm.
     1035      end.
     1036      vGtin  = getGtinByDM (iDm ).
     1037      ChekTypeMarkByDm(idm).
     1038      if iDm begins 'tech_':U
     1039      then
     1040         oCodeIdent = iDm.
     1041      else if length(iDm) < 21
     1042      then do:
     1043         find first marking where marking.mark eq idm
     1044         no-lock no-error.
     1045         oCodeIdent = if available marking then marking.mark else  ?.
     1046      end.
     1047      else if     length(iDm) eq 29
     1048         and not iDm begins "01"
     1049         and not iDm begins "02"
     1050      then
     1051         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1052      else  if     length(iDm) >= 24
     1053               and (  iDm begins "01"
     1054                   or iDm begins "02")
     1055               and  substring(iDm,17,2) ne "21"
     1056      then do:
     1057         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1058                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1059         then
     1060            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1061         else
     1062            oCodeIdent = iDM.
     1063      end.
     1064      else  if     (   length(iDm) eq 25
     1065                    or length(iDm) eq 21)
     1066               and (not iDm begins "01"
     1067               and  not iDm begins "02")
     1068      then
     1069         oCodeIdent = substring(iDm,1,21).
     1070      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1071      then
     1072         oCodeIdent = substring(iDm,1,21).
     1073      else do while Velement ne "" and idm ne "":
     1074         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1075         oCodeIdent = oCodeIdent + Velement.
     1076      end.
     1077      return oCodeIdent.
     1078   end.
     1079   method private character  GetTegCod
     1080   (icodeIdent as char, iTeg as char):
     1081      define variable Velement   as character no-undo init "first".
     1082      define variable oTeg as character no-undo init ?.
     1083      define variable vteg as character no-undo.
     1084      define variable vtegval as character no-undo.
     1085      if     ((length(icodeIdent) eq 21
     1086         and not icodeIdent begins "01"
     1087         and not icodeIdent begins "02")
     1088         or
     1089             ( length(icodeIdent) eq 25
     1090               and not icodeIdent begins "01"
     1091               and not icodeIdent begins "02"))
     1092      then do:
     1093         if iTeg eq "01" or iTeg eq "02"
     1094         then
     1095            oTeg = substring(icodeIdent,1,21).
     1096         else  if  iTeg eq "21"
     1097         then
     1098            oTeg = substring(icodeIdent,15,7).
     1099      end.
     1100      else do:
     1101         ChekTypeMarkByDm(icodeIdent).
     1102         block-teg:
     1103            do while Velement ne "" and icodeIdent ne "":
     1104            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1105            if    Velement begins iTeg
     1106               or Velement begins "(" + iTeg + ")"
     1107            then do:
     1108               oTeg = vtegval.
     1109               leave block-teg.
     1110            end.
     1111         end.
     1112      end.
     1113      return oTeg.
     1114   end.
     1115   method private logical isOAD
     1116   (icodeIdent as character):
     1117      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1118   end.
     1119   method private logical isMark
     1120   (icodeIdent as character):
     1121      define buffer buf_marking for ub.marking.
     1122      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1123             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1124   end.
     1125   method private character  addBracketForCode
     1126   (icodeIdent as char):
     1127      define variable Velement   as character no-undo init "first".
     1128      define variable oTeg as character no-undo.
     1129      define variable vteg as character no-undo.
     1130      define variable vtegval as character no-undo.
     1131      define buffer marking for ub.marking.
     1132      find first marking no-lock where
     1133                 marking.mark begins icodeIdent no-error.
     1134      if    not ChekTypeMarkByDm(icodeIdent)
     1135         or length(icodeIdent) le 24
     1136         or (avail marking and marking.unit-ext = "LEVEL2")
     1137      then
     1138         oTeg = icodeIdent.
     1139      else do:
     1140         if (  icodeIdent begins "01"
     1141            or icodeIdent begins "02"
     1142            ) and CheckGtin(substring (icodeIdent,3,14))
     1143            and substring (icodeIdent,17,2) eq "21"
     1144         then do:
     1145            mMRCCode = yes.
     1146            ChekTypeMarkByDm(icodeIdent).
     1147            block-teg:
     1148            do while Velement ne "" and icodeIdent ne "":
     1149               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1150               if vteg ne ""
     1151               then
     1152                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1153            end.
     1154            mMRCCode = no.
     1155         end.
     1156         else do:
     1157            oTeg = icodeIdent.
     1158         end.
     1159      end.
     1160      return oTeg.
     1161   end.
     1162   method private integer getlevelByCodId
     1163   (iCode as char):
     1164      define variable vLength as int no-undo.
     1165      define variable vLevel  as int no-undo.
     1166      if not ChekTypeMarkByDM (icode) then return ?.
     1167      vLength = length(iCode).
     1168      if    vLength eq 18
     1169         or vLength eq 20
     1170      then
     1171         Vlevel = 4.
     1172      else if vLength eq 21
     1173      then
     1174         Vlevel = 1.
     1175      else if vLength eq 25
     1176      then do:
     1177         if  iCode begins "01"
     1178         then
     1179            Vlevel = 3.
     1180         else
     1181            Vlevel = 1.
     1182      end.
     1183      else if     vLength >= 26
     1184              and vLength <= 46
     1185      then do:
     1186         if    substring(iCode,17,2) eq "11"
     1187            or substring(iCode,17,2) eq "13"
     1188            or (    substring(iCode,17,2) eq "21"
     1189                and vLength >= 33
     1190                and substring(iCode,26,4) ne "8005")
     1191         then
     1192            Vlevel = 4.
     1193         else if    vLength eq 31
     1194                 or vLength eq 38
     1195                 or vLength eq 39
     1196                 or vLength eq 45
     1197         then
     1198            Vlevel = 1.
     1199         else if    vLength eq 35
     1200                 or vLength eq 43
     1201         then
     1202            Vlevel = 3.
     1203         else
     1204            Vlevel = ?.
     1205      end.
     1206      else
     1207         Vlevel = ?.
     1208      return Vlevel.
     1209   end.
     1210   method private character  getLevelMotpBycodid
     1211   (iDm as char):
     1212      define variable vLevel as integer no-undo.
     1213      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1214      vLevel = getlevelByCodId(iDm).
     1215      if    vLevel eq ?
     1216         or vLevel < 1
     1217         or vLevel > 6
     1218      then
     1219         return ?.
     1220      else
     1221         return entry(vlevel,vList).
     1222   end.
     1223   method private character    getLevelUTDByLevelMotp
     1224   (iUnit as char):
     1225      define variable vLevel as integer no-undo.
     1226      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1227      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1228      vLevel = lookup(iUnit,vListMOTP).
     1229      if    vLevel eq ?
     1230         or vLevel < 1
     1231         or vLevel > 4
     1232      then
     1233         return ?.
     1234      else
     1235         return entry(vlevel,vListutd).
     1236   end.
     1237   method private character  getLevelMotpByDM
     1238   (iDm as char):
     1239      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1240   end.
     1241   method private character  getLevelUTDByCodId
     1242   (iDm as char):
     1243      define variable vLevel as integer no-undo.
     1244      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1245      vLevel = getlevelByCodId(iDm).
     1246      if    vLevel eq ?
     1247         or vLevel < 1
     1248         or vLevel > 4
     1249      then
     1250         return ?.
     1251      else
     1252         return entry(vlevel,vList).
     1253   end.
     1254   method private character  getLevelUTDByDM
     1255   (iDm as char):
     1256      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1257   end.
     1258   define variable mNotMarkQnty as logical no-undo.
     1259   method private decimal getQntyUTDByCodId
     1260   (iDM as char):
     1261      define variable vLevel as integer no-undo.
     1262      define variable vList as character no-undo init "1,5,10,500".
     1263      define variable vGtin as character no-undo.
     1264      define variable vqnty as decimal no-undo init ?.
     1265      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1266      if vqnty eq ?
     1267      then do:
     1268         if not mNotMarkQnty
     1269         then do:
     1270            define buffer marking for ub.marking.
     1271            define variable vCodident as character no-undo.
     1272            vCodident = GetCodeIdent(idm).
     1273            find first marking where marking.mark begins vCodident no-lock no-error.
     1274            if     available marking
     1275               and marking.box-qnty ne ?
     1276            then
     1277               return marking.box-qnty.
     1278         end.
     1279         vGtin = getGtinByDm(iDM).
     1280         if ChekTypeMarkByGtin (vGtin)
     1281         then do:
     1282            vLevel = getlevelByCodId(iDM).
     1283            if     vLevel >= 1
     1284               and vLevel <= 4
     1285            then
     1286               vqnty = int(entry(vlevel,vList)).
     1287         end.
     1288         else
     1289            vqnty = getQntyCodeByGtin(vgtin).
     1290      end.
     1291      return vqnty.
     1292   end.
     1293   method private decimal getQntyUTDByDM
     1294   (iDm as char):
     1295      define variable vDM as character no-undo.
     1296      if     length (iDm) ne 25
     1297         and length (iDm) ne 29
     1298         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1299      then
     1300         vDM = substring (iDm,1,length (iDm) - 6 ).
     1301      else
     1302         vDM = substring (iDm,1,length (iDm) - 4 ).
     1303      return getQntyUTDByCodId(vDM).
     1304   end.
     1305   method private decimal    getMRC4
     1306   (iMRC as char):
     1307      define variable oMrc     as decimal no-undo init ?.
     1308      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1309      define variable vi       as integer no-undo.
     1310      define variable vfound   as integer no-undo.
     1311      define variable vposStart   as integer no-undo.
     1312      do:
     1313      OMRc = 0.
     1314      do vi = 1 to 4:
     1315         define variable vsimb as character no-undo.
     1316         vsimb = substring(iMRC,vi,1).
     1317         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1318         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1319         if vfound > 0
     1320         then
     1321            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1322         end.
     1323         OMRc = OMRc / 100.
     1324      end.
     1325      return OMRc.
     1326   end.
     1327   method private decimal    getMRCByDM
     1328   (iDm as char):
     1329      define variable vMRC     as character no-undo.
     1330      define variable oMrc     as decimal no-undo init ?.
     1331      define variable Velement as character no-undo init "empty".
     1332      define variable vteg as character no-undo.
     1333      define variable vtegval as character no-undo.
     1334      if    length(idm) eq 14 + 7 + 4 + 4
     1335         or length(idm) eq 14 + 7 + 4
     1336      then do:
     1337         vMRC = substring(idm,22,4).
     1338         omrc = getMRC4(vMRC).
     1339      end.
     1340      else do:
     1341          ChekTypeMarkByDm(iDm).
     1342          block-mrc:
     1343          do while Velement ne "" and idm ne "":
     1344             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1345             if Velement begins "8005"
     1346             then do:
     1347                vMRC = substring(Velement,5,6).
     1348                leave block-mrc.
     1349             end.
     1350             else if Velement begins "(8005)"
     1351             then do:
     1352                vMRC = substring(Velement,7,6).
     1353                leave block-mrc.
     1354             end.
     1355          end.
     1356          if vMRC ne ""
     1357          then
     1358             OMRc = dec(vmrc) / 100 no-error.
     1359      end.
     1360      return OMRc.
     1361   end.
     1362   method private date    MoveDate
     1363   (idate as date,
     1364    iMonth as int64):
     1365      define variable vMonth   as int64 no-undo.
     1366      define variable vYear    as int64 no-undo.
     1367      define variable vDateNew as date  no-undo.
     1368       define variable vDay     as int64 no-undo.
     1369       vMonth = month(iDate) + iMonth.
     1370       vYear =  year(iDate).
     1371       if vMonth <= 0
     1372       then assign
     1373          vMonth = vMonth + 12
     1374           vYear  = vYear - 1
     1375       .
     1376       else if vMonth > 12
     1377       then assign
     1378          vMonth = vMonth - 12
     1379           vYear  = vYear + 1
     1380       .
     1381       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1382       do while error-status:error eq yes:
     1383          VDay = vDay + 1.
     1384          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1385       end.
     1386       if VDay > 0
     1387       then
     1388          vDateNew + 1.
     1389       return vDateNew.
     1390   end.
     1391   method private logical    checkEMRC
     1392   (input  iDm as char,
     1393    output vOk as logical):
     1394      define variable v-value-emrc as character no-undo.
     1395      define variable v-type-emrc  as character no-undo.
     1396      define variable vDateIso     as character no-undo.
     1397      define variable vMRC         as decimal no-undo.
     1398      define variable vqnty        as decimal no-undo.
     1399      define variable vPrice       as decimal no-undo.
     1400      define variable vparent      as character no-undo.
     1401      define variable vgds-code    as integer no-undo.
     1402      define buffer code for ub.code.
     1403      vMRC = getMRCByDM(iDm).
     1404      if vMRC > 0
     1405      then do:
     1406         vgds-code = getGdsCodeByDM(iDm).
     1407         vqnty     = getQntyUTDByDM(iDm).
     1408               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1409            (
     1410             input   vgds-code
     1411            ,input   'emrc-type':U
     1412            ,output   v-value-emrc
     1413            ,output   v-type-emrc
     1414          ) no-error.
     1415          if     v-value-emrc ne ""
     1416             and v-value-emrc ne ?
     1417          then do:
     1418             vDateIso = iso-date(today).
     1419             vPrice = vMRC / vqnty.
     1420             vparent ="emc" + chr(4) + v-value-emrc.
     1421             find last code where Code.parent      eq vparent
     1422                              and Code.code        le vDateIso
     1423                              and code.status_  eq 0
     1424             no-lock no-error.
     1425             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1426             then
     1427                vOk = true .
     1428             else do:
     1429                 define variable vText      as character no-undo.
     1430                 define variable vDate      as date no-undo.
     1431                 define variable vDateLast  as character no-undo.
     1432                 define variable vDateFirst as character no-undo.
     1433                 define variable vDate3     as date no-undo.
     1434                 vdate = date(code.misc1).
     1435                 vDateLast = code.misc1.
     1436                 vDate3 = MoveDate(today, - 3 ).
     1437                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1438                                      string(vDate3  , "99/99/9999"),
     1439                                      string(vDate   , "99/99/9999")
     1440                                      ).
     1441                 vdateIso = iso-date(vdate3).
     1442                 find last code  where Code.parent      eq vparent
     1443                                   and Code.code        le vDateIso
     1444                                   and code.status_  eq 0 no-lock no-error.
     1445                 if available code
     1446                 then
     1447                    vDateIso = code.code.
     1448                 vDateFirst = vDateIso.
     1449                 vDateLast = iso-date(vdate).
     1450                 define variable vGood as logical no-undo.
     1451                 define variable vDateSale as date no-undo.
     1452                 define buffer bcode for code.
     1453                 for last code where Code.parent   eq vparent
     1454                                 and code.status_  eq 0
     1455                                 and code.code     < vDateLast
     1456                                 and code.code     >= vDateFirst
     1457                 no-lock:
     1458                    find first bcode where bCode.parent   eq vparent
     1459                                       and bcode.status_  eq 0
     1460                                       and bcode.code     > code.code no-lock no-error.
     1461                    if available bcode
     1462                    then do:
     1463                       if vPrice < dec(Code.CodeValue)
     1464                       then
     1465                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1466                                                     chr(10),
     1467                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1468                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1469                                                     ).
     1470                       else do:
     1471                          vGood = yes.
     1472                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1473                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1474                                                     chr(10),
     1475                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1476                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1477                                                     string(         vDateSale            ,"99/99/9999"),
     1478                                                     string(vDateSale - today)
     1479                                                     ).
     1480                       end.
     1481                    end.
     1482                 end.
     1483                 if vgood
     1484                 then do:
     1485                    define variable choice as integer no-undo .
     1486                    run gbl/d-askw.w (input "Уточнение"
     1487                           ,input  vText
     1488                           ,input "|"
     1489                           ,input "Принять|Вернуть"
     1490                           ,input "Принять данный товар|Вернуть товар постащику"
     1491                           ,input 1
     1492                           ,input 2
     1493                           ,output choice) no-error.
     1494                    vok = choice eq 1.
     1495                 end.
     1496                 else
     1497                    vok =false.
     1498             end.
     1499          end.
     1500      end.
     1501   end.
     1502   method private character addGs2Mark
     1503   (iMark as char):
     1504      define variable vDM   as character no-undo.
     1505      define variable vIdx  as integer   no-undo.
     1506      if index(iMark,chr(29),1) > 0
     1507      then return iMark.
     1508      if substring(iMark,26,4) = "8005" then
     1509      do:
     1510        vIdx = index(iMark,"93",26 + 4 + 5).
     1511        if vIdx > 1 then do:
     1512          vDM = substitute("&1&4&2&4&3",
     1513                           substring(iMark,1,25),
     1514                           substring(iMark,26,vIdx - 25 - 1),
     1515                           substring(iMark,vIdx),
     1516                           chr(29)) no-error.
     1517          vIdx = index(vDm,"240",vIdx + 4).
     1518          if vIdx > 0 then
     1519          do:
     1520            vDM = substitute("&1&3&2",
     1521                             substring(vDm,1,vIdx - 1),
     1522                             substring(vDm,vIdx),
     1523                             chr(29)) no-error.
     1524          end.
     1525        end.
     1526        else
     1527          vDM = substitute("&1&3&2",
     1528                           substring(iMark,1,25),
     1529                           substring(iMark,26),
     1530                           chr(29)) no-error.
     1531      end.
     1532      else if substring(iMark,32,2) = "91" then
     1533      do:
     1534        vIdx = index(iMark,"92",32).
     1535        if vIdx > 1 then
     1536          vDM = substitute("&1&4&2&4&3",
     1537                           substring(iMark,1,31),
     1538                           substring(iMark,32,vIdx - 31 - 1),
     1539                           substring(iMark,vIdx),
     1540                           chr(29)) no-error.
     1541        else
     1542          vDM = substitute("&1&3&2",
     1543                           substring(iMark,1,31),
     1544                           substring(iMark,32),
     1545                           chr(29)) no-error.
     1546      end.
     1547      else if substring(iMark,39,2) = "91" then
     1548      do:
     1549        vIdx = index(iMark,"92",38).
     1550        if vIdx > 1 then
     1551          vDM = substitute("&1&4&2&4&3",
     1552                           substring(iMark,1,38),
     1553                           substring(iMark,39,vIdx - 38 - 1),
     1554                           substring(iMark,vIdx),
     1555                           chr(29)) no-error.
     1556        else
     1557          vDM = substitute("&1&3&2",
     1558                           substring(iMark,1,38),
     1559                           substring(iMark,39),
     1560                           chr(29)) no-error.
     1561      end.
     1562      else if substring(iMark,25,2) = "93" then
     1563      do:
     1564        vIdx = index(iMark,"92",25).
     1565        if vIdx > 1 then
     1566          vDM = substitute("&1&4&2&4&3",
     1567                           substring(iMark,1,24),
     1568                           substring(iMark,25,vIdx - 24 - 1),
     1569                           substring(iMark,vIdx),
     1570                           chr(29)) no-error.
     1571        else
     1572          vIdx = index(iMark,"3103",25).
     1573          if vIdx > 0 then
     1574          vDM = substitute("&1&4&2&4&3",
     1575                           substring(iMark,1,24),
     1576                           substring(iMark,25,vIdx - 24 - 1),
     1577                           substring(iMark,vIdx),
     1578                           chr(29)) no-error.
     1579          else
     1580            vDM = substitute("&1&3&2",
     1581                             substring(iMark,1,24),
     1582                             substring(iMark,25),
     1583                             chr(29)) no-error.
     1584      end.
     1585      else if substring(iMark,32,2) = "93" then
     1586      do:
     1587        vDM = substitute("&1&3&2",
     1588              substring(iMark,1,31),
     1589              substring(iMark,32),
     1590              chr(29)) no-error.
     1591      end.
     1592      return if vDM <> "" then vDm else iMark.
     1593   end.
     1594   method private logical AddUtdErrForTab
     1595   (idb-num         as integer ,
     1596    idoc-id         as integer ,
     1597    iTab            as character,
     1598    iObj            as handle ,
     1599    iCheckType      as character,
     1600    iCodeErr        as character,
     1601    iCheckObj       as character ):
     1602      define buffer utd-err for utd-err.
     1603      define buffer utd for utd.
     1604      find first utd where utd.db-num     eq idb-num
     1605                       and utd.doc-id     eq idoc-id
     1606                       and utd.Direction  eq 'Outbound'
     1607      no-lock no-error.
     1608      if available utd
     1609      then
     1610         return no.
     1611      define variable vRecKey as character no-undo.
     1612            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1613            objKeyRec = new ibs.th.gbl.keyrec().
     1614            objKeyRec:GenKeyRec ( input iTab
     1615                                 ,input iObj
     1616                                 ,output vRecKey).
     1617            delete object objKeyRec.
     1618      find first utd-err where utd-err.db-num     eq idb-num
     1619                           and utd-err.doc-id     eq idoc-id
     1620                           and utd-err.CheckType  eq iCheckType
     1621                           and utd-err.CodeErr    eq iCodeErr
     1622                           and utd-err.CheckObj   eq iCheckObj
     1623      exclusive-lock no-error.
     1624      if not available utd-err
     1625      then do:
     1626         create utd-err.
     1627         assign
     1628            utd-err.db-num         = idb-num
     1629            utd-err.doc-id         = idoc-id
     1630            utd-err.CheckType      = iCheckType
     1631            utd-err.CodeErr        = iCodeErr
     1632            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     1633            utd-err.reckey         = vRecKey
     1634            utd-err.qnty           = 1
     1635         .
     1636      end.
     1637      else
     1638         utd-err.qnty = utd-err.qnty + 1.
     1639      return utd-err.qnty eq 1.
     1640   end.
     1641   method private logical AddUtdErr
     1642   (idb-num         as integer ,
     1643    idoc-id         as integer ,
     1644    iObj            as handle ,
     1645    iCheckType      as character,
     1646    iCodeErr        as character,
     1647    iCheckObj       as character ):
     1648      AddUtdErrForTab
     1649         (idb-num,
     1650          idoc-id,
     1651          iObj:table,
     1652          iObj,
     1653          iCheckType,
     1654          iCodeErr,
     1655          iCheckObj).
     1656   end.
     1657   method private void ClearUtdErrTypeCode
     1658   (idb-num         as integer,
     1659    idoc-id         as integer ,
     1660    iCheckType      as character,
     1661    iCodeErr        as character
     1662    ):
     1663      define buffer utd-err for utd-err.
     1664      if    iCheckType eq "*"
     1665         or iCheckType eq ?
     1666      then do:
     1667         if     iCodeErr ne ?
     1668            and iCodeErr ne "*"
     1669         then
     1670            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     1671            view-as alert-box.
     1672         else
     1673         for each utd-err where utd-err.db-num  eq idb-num
     1674                            and utd-err.doc-id  eq idoc-id
     1675         exclusive-lock:
     1676            delete utd-err.
     1677         end.
     1678      end.
     1679      else do:
     1680         if    iCodeErr eq ?
     1681            or iCodeErr eq "*"
     1682         then do:
     1683            for each utd-err where utd-err.db-num     eq idb-num
     1684                               and utd-err.doc-id     eq idoc-id
     1685                               and utd-err.CheckType  eq iCheckType
     1686            exclusive-lock:
     1687               delete utd-err.
     1688            end.
     1689         end.
     1690         else do:
     1691            for each utd-err where utd-err.db-num     eq idb-num
     1692                               and utd-err.doc-id     eq idoc-id
     1693                               and utd-err.CheckType  eq iCheckType
     1694                               and ub.utd-err.CodeErr eq iCodeErr
     1695            exclusive-lock:
     1696               delete utd-err.
     1697            end.
     1698         end.
     1699      end.
     1700   end.
     1701   method private void ClearUtdErr
     1702   (idb-num         as integer,
     1703    idoc-id         as integer ,
     1704    iCheckType      as character
     1705    ):
     1706      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     1707   end.
     1708   method private character GetMesError
     1709   (itxt as character,
     1710    iobj as character ):
     1711    define variable vi as integer no-undo.
     1712    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     1713       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     1714    end.
     1715    return itxt.
     1716   end.
     1717   method private character GetTextErrorType
     1718   (iCheckType as character,
     1719    iCodeErr   as character,
     1720    iChechObj  as character,
     1721    iType      as character  ):
     1722      define buffer code    for code.
     1723      define variable vError as character no-undo.
     1724      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1725                        and code.code   eq iCodeErr
     1726      no-lock no-error.
     1727      if available code
     1728      then do:
     1729         define variable vType as integer no-undo.
     1730         if code.misc3 eq "error"
     1731         then
     1732            vType = 0.
     1733         else if code.misc3 eq "warning"
     1734         then
     1735            vType = 1.
     1736         else if code.misc3 eq "Hiden"
     1737         then
     1738            vType = 2.
     1739         else
     1740            vtype = int(code.misc3) no-error.
     1741         case itype:
     1742            when "error"
     1743            then do:
     1744               if vtype eq 0
     1745               then
     1746                  vError = GetMesError(Code.CodeValue,iChechObj).
     1747            end.
     1748            when "warning"
     1749            then do:
     1750               if vtype <= 1
     1751               then
     1752                  vError = GetMesError(Code.CodeValue,iChechObj).
     1753            end.
     1754            otherwise do:
     1755               vError = GetMesError(Code.CodeValue,iChechObj).
     1756            end.
     1757         end.
     1758      end.
     1759      else
     1760         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     1761      return vError.
     1762   end.
     1763   method private integer  GetTypeError
     1764   (iCheckType as character,
     1765    iCodeErr   as character):
     1766      define buffer code    for code.
     1767      define variable vType as integer no-undo.
     1768      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1769                        and code.code   eq iCodeErr
     1770      no-lock no-error.
     1771      if     not available code
     1772         and code.misc3 eq "error"
     1773      then
     1774         vType = 0.
     1775      else if code.misc3 eq "warning"
     1776      then
     1777         vType = 1.
     1778      else if code.misc3 eq "Hiden"
     1779      then
     1780         vType = 2.
     1781      else
     1782         vtype = int(code.misc3) no-error.
     1783      return vtype.
     1784   end.
     1785   method private character GetTextError
     1786   (iCheckType as character,
     1787    iCodeErr   as character,
     1788    iChechObj  as character ):
     1789      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     1790   end.
     1791   method private character GetErrForUtdstr
     1792   (idb-num     as integer ,
     1793    idoc-id     as integer ,
     1794    iCheckType  as character
     1795    ):
     1796      define buffer utd-err for utd-err.
     1797      define buffer code    for code.
     1798      define variable vHQry as handle no-undo.
     1799      define variable vError as longchar no-undo.
     1800      define variable vErrorOne as longchar  no-undo.
     1801      define variable oError as character no-undo.
     1802      create query vHQry.
     1803      vHQry:set-buffers(buffer utd-err:handle).
     1804      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1805                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1806                               + if    iCheckType eq "*"
     1807                                    or iCheckType eq ?
     1808                                 then       ""
     1809                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1810      vHQry:query-open().
     1811      vHQry:get-first().
     1812      QRY-BLOCK:
     1813      repeat while not vHQry:query-off-end:
     1814         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1815         if     vErrorOne ne ""
     1816            and vErrorOne ne ?
     1817         then
     1818            vError = vError + ", " + vErrorOne.
     1819         vHQry:get-next().
     1820      end.
     1821      oError = substring(vError,3,4002).
     1822      return oError.
     1823   end.
     1824   method private character GetErrJsonForUtd
     1825   (idb-num         as integer ,
     1826    idoc-id         as integer ,
     1827    iCheckType      as character
     1828    ):
     1829      define buffer utd-err for utd-err.
     1830      define variable vHQry as handle no-undo.
     1831      define variable vError as longchar no-undo.
     1832      define variable oError as character no-undo.
     1833      create query vHQry.
     1834      define variable vi as integer no-undo.
     1835      vHQry:set-buffers(buffer utd-err:handle).
     1836      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1837                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1838                               + if    iCheckType eq "*"
     1839                                    or iCheckType eq ?
     1840                                 then       ""
     1841                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1842      vHQry:query-open().
     1843      vHQry:get-first().
     1844      QRY-BLOCK:
     1845      repeat while not vHQry:query-off-end:
     1846         define variable vErrorOne as character no-undo.
     1847         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1848         if     vErrorOne ne ?
     1849            and vErrorOne ne ""
     1850         then do:
     1851            vi = vi + 1.
     1852            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1853                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     1854                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1855         end.
     1856         vHQry:get-next().
     1857      end.
     1858      for first utd where utd.db-num eq idb-num
     1859                      and utd.doc-id eq idoc-id
     1860                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     1861      no-lock,
     1862         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1863                                  and utd-marking-lines.doc-id eq idoc-id
     1864                                  and utd-marking-lines.doc-level eq 1
     1865      no-lock,
     1866         first marking where marking.mark eq utd-marking-lines.mark
     1867                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1868      no-lock:
     1869         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     1870         if     vErrorOne ne ?
     1871            and vErrorOne ne ""
     1872         then do:
     1873            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     1874                            + '","ОбъектОш":"' + marking.mark
     1875                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1876         end.
     1877      end.
     1878      if vError ne ""
     1879      then
     1880         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     1881      return oError.
     1882   end.
     1883   method private character GetErrJsonForUtdReturn
     1884   (idb-num         as integer ,
     1885    idoc-id         as integer ,
     1886    iCheckType      as character
     1887    ):
     1888      define buffer utd-err for utd-err.
     1889      define variable vHQry as handle no-undo.
     1890      define variable vError as longchar no-undo.
     1891      define variable oError as character no-undo.
     1892      define variable vi as integer no-undo.
     1893      create query vHQry.
     1894      vHQry:set-buffers(buffer utd-err:handle).
     1895      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1896                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1897                               + if    iCheckType eq "*"
     1898                                    or iCheckType eq ?
     1899                                 then       ""
     1900                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1901      vHQry:query-open().
     1902      vHQry:get-first().
     1903      QRY-BLOCK:
     1904      repeat while not vHQry:query-off-end:
     1905         define variable vErrorOne as character no-undo.
     1906         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1907         if     vErrorOne ne ?
     1908            and vErrorOne ne ""
     1909         then do:
     1910            vi = vi + 1.
     1911            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1912                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     1913                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     1914         end.
     1915         vHQry:get-next().
     1916      end.
     1917      if vError ne ""
     1918      then
     1919         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     1920      return oError.
     1921   end.
     1922   method private character GetCodeTextError
     1923   (iCheckType as character,
     1924    iCodeErr   as character,
     1925    iChechObj  as character,
     1926    output oCode as character,
     1927    output ovalue as character ):
     1928      define buffer code    for code.
     1929      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1930                        and code.code   eq iCodeErr
     1931      no-lock no-error.
     1932      if     available code
     1933      then do:
     1934         define variable vi as integer no-undo init ?.
     1935         vi = int(Code.misc3) no-error.
     1936         if    code.misc3 ne "error"
     1937            and vi ne 0
     1938         then
     1939            oCode = ?.
     1940         else if     Code.misc1 ne ?
     1941                 and Code.misc1 ne ""
     1942         then
     1943            assign
     1944               oCode  = GetMesError(Code.misc1,iChechObj)
     1945               ovalue = GetMesError(Code.misc2,iChechObj)
     1946            .
     1947      end.
     1948      return if oCode eq ""
     1949             then ""
     1950             else (oCode + "_" + ovalue).
     1951   end.
     1952   define temp-table TT-err no-undo
     1953     field code_ as character
     1954     field text_ as character
     1955   index code_ code_.
     1956   method private character GetErrTxtForUtd
     1957   (idb-num         as integer ,
     1958    idoc-id         as integer ,
     1959    iCheckType      as character
     1960    ):
     1961      define buffer utd-err for utd-err.
     1962      define variable vHQry as handle no-undo.
     1963      define variable oError as character no-undo.
     1964      create query vHQry.
     1965      define variable vi as integer no-undo.
     1966      for each tt-err :
     1967         delete tt-err.
     1968      end.
     1969      vHQry:set-buffers(buffer utd-err:handle).
     1970      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1971                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1972                               + if    iCheckType eq "*"
     1973                                    or iCheckType eq ?
     1974                                 then       ""
     1975                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1976      vHQry:query-open().
     1977      vHQry:get-first().
     1978      define variable vcode as character no-undo.
     1979      define variable vvalue as character no-undo.
     1980      QRY-BLOCK:
     1981      repeat while not vHQry:query-off-end:
     1982         vi = vi + 1.
     1983         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     1984         if vcode ne ?
     1985         then do:
     1986            find first tt-err where tt-err.code eq vcode
     1987            no-error.
     1988            if not available tt-err
     1989            then do:
     1990               create tt-err.
     1991               assign
     1992                  tt-err.code_ = vcode
     1993                  tt-err.text_ = vvalue
     1994               .
     1995            end.
     1996            else
     1997               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1998         end.
     1999         vHQry:get-next().
     2000      end.
     2001     find first utd where utd.db-num eq idb-num
     2002                         and utd.doc-id eq idoc-id
     2003         no-lock.
     2004      define buffer cancel_utd-lines for utd-lines.
     2005      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2006                                  and cancel_utd-lines.doc-id eq idoc-id
     2007      no-lock:
     2008         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2009         then do:
     2010            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2011                                        and utd-marking-lines.doc-id eq idoc-id
     2012                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2013            no-lock,
     2014               first marking where marking.mark eq utd-marking-lines.mark
     2015                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2016            no-lock:
     2017               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2018               find first tt-err where tt-err.code eq vcode
     2019               no-error.
     2020               if not available tt-err
     2021               then do:
     2022                  create tt-err.
     2023                  assign
     2024                     tt-err.code_ = vcode
     2025                     tt-err.text_ = vvalue
     2026                  .
     2027               end.
     2028               else
     2029                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2030            end.
     2031         end.
     2032         else do:
     2033            define variable vqnty as decimal no-undo.
     2034            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2035            if vqnty eq ? then vqnty = 0.
     2036            if vqnty ne cancel_utd-lines.Quantity
     2037            then do:
     2038               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2039               find first tt-err where tt-err.code eq vcode
     2040               no-error.
     2041               if not available tt-err
     2042               then do:
     2043                  create tt-err.
     2044                  assign
     2045                     tt-err.code_ = vcode
     2046                     tt-err.text_ = vvalue
     2047                  .
     2048               end.
     2049               else
     2050                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2051            end.
     2052         end.
     2053      end.
     2054      for each tt-err:
     2055         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2056      end.
     2057      return oError.
     2058   end.
     2059   define variable mFormatErr as character no-undo init "text".
     2060   method private character GetErrForUtd
     2061   (idb-num         as integer ,
     2062    idoc-id         as integer ,
     2063    iType           as character
     2064    ):
     2065      if mFormatErr eq "text"
     2066      then
     2067         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2068      else do:
     2069         if itype eq "return"
     2070         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2071         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2072      end.
     2073   end.
     2074   method private longchar GetErrComText
     2075   (icomment as character,
     2076    itext    as longchar ):
     2077       define variable vText as longchar no-undo.
     2078      if mFormatErr eq "text"
     2079      then do:
     2080         if icomment ne ""
     2081         then
     2082            icomment = substitute("comment:|&1|",icomment).
     2083         vText = icomment + itext.
     2084      end.
     2085      else do:
     2086         icomment = if icomment begins  '"'
     2087                    then icomment
     2088                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2089         vText = icomment + "," + itext.
     2090         vText = "~{" + trim(vText,",") + "~}".
     2091      end.
     2092      return vText.
     2093   end.
     2094   method private logical  CheckTypeForMarkLineType
     2095   (iObj            as handle,
     2096    iCheckType      as character,
     2097    iCodeErr        as character ,
     2098    iTypeErr        as character ):
     2099      define variable vRecKey-markLine as character no-undo.
     2100      define variable vGoodMark        as logical no-undo.
     2101      define variable vdb-num          as integer no-undo.
     2102      define variable vdoc-id          as integer no-undo.
     2103      define variable vlinenum         as integer no-undo.
     2104      define variable vErrorOne as character no-undo.
     2105      define buffer buf_utd-err for utd-err.
     2106       define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2107       objKeyRec = new ibs.th.gbl.keyrec().
     2108       objKeyRec:GenKeyRec ( input "utd-marking-lines"
     2109                            ,input iObj
     2110                            ,output  vRecKey-markLine).
     2111       delete object objKeyRec.
     2112      vGoodMark = yes.
     2113      vdb-num = iObj::db-num.
     2114      vdoc-id = iObj::doc-id.
     2115      vlinenum = iObj::linenum.
     2116      block-mark-err:
     2117      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2118                               and buf_utd-err.db-num = vdb-num
     2119                               and buf_utd-err.reckey = vRecKey-markLine
     2120                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2121                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2122      no-lock:
     2123         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2124         if     vErrorOne ne ?
     2125            and vErrorOne ne ""
     2126         then do:
     2127            vGoodMark = no.
     2128            leave block-mark-err.
     2129         end.
     2130      end.
     2131      return not vGoodMark.
     2132   end.
     2133   method private logical  CheckErrForMarkLineType
     2134   (iObj            as handle,
     2135    iType           as character  ):
     2136      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2137   end.
     2138   method private logical  CheckErrForMarkLine
     2139   (iObj            as handle):
     2140      return CheckErrForMarkLineType(iObj,"*").
     2141   end.
     2142   method private logical  CheckErrForLineTypeCode
     2143   (iObj                 as handle,
     2144    iCheckType           as character,
     2145    iCodeErr             as character,
     2146    iTypeErr             as character,
     2147    iOneErr              as logical):
     2148      define variable vRecKey-line     as character no-undo.
     2149      define buffer buf_utd-err for utd-err.
     2150      define variable vUtdlineError as logical no-undo.
     2151      define variable vErrorOne as character no-undo.
     2152            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2153            objKeyRec = new ibs.th.gbl.keyrec().
     2154            objKeyRec:GenKeyRec ( input "utd-lines"
     2155                                 ,input iObj
     2156                                 ,output vRecKey-line).
     2157            delete object objKeyRec.
     2158         define variable vdb-num as integer no-undo.
     2159         define variable vdoc-id as integer no-undo.
     2160         define variable vlinenum as integer no-undo.
     2161         vdb-num = iObj::db-num.
     2162         vdoc-id = iObj::doc-id.
     2163         vlinenum = iObj::linenum.
     2164         block-err:
     2165         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2166                                  and buf_utd-err.db-num = vdb-num
     2167                                  and buf_utd-err.reckey = vRecKey-line
     2168                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2169                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2170         no-lock:
     2171            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2172            if     vErrorOne ne ?
     2173               and vErrorOne ne ""
     2174            then do:
     2175               vUtdlineError = yes.
     2176               leave block-err.
     2177            end.
     2178         end.
     2179         if  not vUtdlineError
     2180         then do:
     2181            define variable vGoodMark as logical no-undo.
     2182            vGoodMark = yes.
     2183            block-line-err:
     2184            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2185                                         and utd-marking-lines.doc-id  eq vdoc-id
     2186                                         and utd-marking-lines.LineNum eq vLineNum
     2187            no-lock:
     2188               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2189               if     vGoodMark
     2190                  and iOneErr eq no
     2191               then
     2192                  leave block-line-err.
     2193               if     iOneErr = yes
     2194                  and not vGoodMark
     2195               then
     2196                  leave block-line-err.
     2197            end.
     2198            vUtdlineError = not vGoodMark.
     2199         end.
     2200      return vUtdlineError.
     2201   end.
     2202   method private character   getErrForLineType
     2203   (iObj            as handle,
     2204    iType           as character  ):
     2205      define variable vRecKey-line     as character no-undo.
     2206      define buffer buf_utd-err for utd-err.
     2207      define variable vUtdlineError as logical no-undo.
     2208      define variable vErrorOne as character no-undo.
     2209      define variable oError as character no-undo.
     2210            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2211            objKeyRec = new ibs.th.gbl.keyrec().
     2212            objKeyRec:GenKeyRec ( input "utd-lines"
     2213                                 ,input iObj
     2214                                 ,output vRecKey-line).
     2215            delete object objKeyRec.
     2216         define variable vdb-num as integer no-undo.
     2217         define variable vdoc-id as integer no-undo.
     2218         define variable vlinenum as integer no-undo.
     2219         vdb-num = iObj::db-num.
     2220         vdoc-id = iObj::doc-id.
     2221         vlinenum = iObj::linenum.
     2222         block-err:
     2223         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2224                                  and buf_utd-err.db-num = vdb-num
     2225                                  and buf_utd-err.reckey = vRecKey-line
     2226                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2227         no-lock:
     2228            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2229            if     vErrorOne ne ?
     2230               and vErrorOne ne ""
     2231            then do:
     2232               oError = oError + vErrorOne + " ".
     2233            end.
     2234         end.
     2235      return oError.
     2236   end.
     2237   method private logical  CheckErrForLineType
     2238   (iObj            as handle,
     2239    iType           as character  ):
     2240       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2241   end.
     2242   method private logical  CheckErrForLine
     2243   (iObj            as handle):
     2244      return CheckErrForLineType(iobj,"*").
     2245   end.
     2246   method private logical  CheckErrForUtd
     2247   (idb-num         as integer ,
     2248    idoc-id         as integer ):
     2249      for each utd-lines where utd-lines.db-num eq idb-num
     2250                           and utd-lines.doc-id eq idoc-id
     2251      no-lock :
     2252         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2253         then
     2254            return no.
     2255      end.
     2256      return yes.
     2257   end.
     2258   method public logical CheckMarkUtd-28rel
     2259    (input idb-num as integer,
     2260    input idoc-id as integer):
     2261    define buffer utd                   for utd.
     2262    define buffer utd-lines             for utd-lines.
     2263    define buffer utd-marking-lines     for utd-marking-lines.
     2264    define variable v-par-type as character no-undo.
     2265    define variable vgdsNoMark as logical no-undo.
     2266    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2267      define variable v-par-val  as character no-undo.
     2268      find first utd where utd.db-num eq idb-num
     2269                       and utd.doc-id eq idoc-id
     2270      no-lock no-error.
     2271      if available utd
     2272      then do:
     2273         if     utd.obj-code ne ?
     2274            and utd.obj-type ne ?
     2275         then do:
     2276            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2277            Block-utd-lines:
     2278            for each utd-lines where utd-lines.db-num eq idb-num
     2279                                 and utd-lines.doc-id eq idoc-id
     2280            no-lock:
     2281               if     utd-lines.gds-code ne ?
     2282                  and utd-lines.gds-code ne 0
     2283               then do:
     2284                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2285                       ( utd-lines.gds-code,
     2286                         'mark-type':U,
     2287                          output v-par-val,
     2288                          output v-par-type
     2289                       ).
     2290                  if     EDOParSec:IsEdo
     2291                     and EDOParSec:GetIsEDOForType(v-par-val)
     2292                  then do:
     2293                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2294                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2295                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2296                                                    and length(utd-marking-lines.mark) > 13
     2297                     no-lock no-error.
     2298                     if     avail utd-marking-lines
     2299                        and not CheckErrForLine(buffer utd-lines:handle)
     2300                     then
     2301                        leave Block-utd-lines.
     2302                  end.
     2303                  else
     2304                     vgdsNoMark = yes.
     2305               end.
     2306            end.
     2307            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2308            if vgdsNoMark then return available utd-lines . else return yes .
     2309         end.
     2310      end.
     2311      return yes.
     2312   end.
     2313     def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2314   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2315   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2316     field side as character.
     2317   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2318   method public logical CheckMarkUtd
     2319    (input idb-num  as integer,
     2320     input idoc-id  as integer):
     2321     define buffer utd-lines             for ub.utd-lines.
     2322     block-line:
     2323     for each utd-lines where utd-lines.db-num eq idb-num
     2324                          and utd-lines.doc-id eq idoc-id
     2325     no-lock:
     2326        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2327        then
     2328           leave block-line.
     2329     end.
     2330     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
