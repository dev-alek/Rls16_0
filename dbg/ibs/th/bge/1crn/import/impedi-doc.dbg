     3657   method public logical GetLastUTDinPack
     3658   (input idb-num as integer,
     3659    input idoc-id as integer,
     3660    output odb-num as integer,
     3661    output odoc-id as integer ):
     3662      define buffer buf_utd for utd.
     3663      define buffer     utd for utd.
     3664      find first utd where utd.db-num eq idb-num
     3665                       and utd.doc-id eq idoc-id
     3666      no-lock no-error.
     3667      if available utd
     3668      then do:
     3669         if utd.PackageId eq ""
     3670         then do:
     3671            assign
     3672               odb-num = utd.db-num
     3673               odoc-id = utd.doc-id
     3674            .
     3675            return yes.
     3676         end.
     3677         else do:
     3678            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     3679            if    odb-num eq ?
     3680               or odoc-id eq ?
     3681            then do:
     3682               assign
     3683                  odb-num = utd.db-num
     3684                  odoc-id = utd.doc-id
     3685               .
     3686               return yes.
     3687            end.
     3688            else
     3689               return odoc-id = utd.doc-id.
     3690         end.
     3691      end.
     3692      return ?.
     3693   end.
     3694   method public void delMark
     3695   ( buffer utd-marking-lines for utd-marking-lines ):
     3696      define buffer buf_utd-marking-line for utd-marking-lines.
     3697      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     3698         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     3699                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     3700                                           and buf_utd-marking-line.mark      eq marking.mark
     3701         no-lock no-error.
     3702         if available  buf_utd-marking-line
     3703         then do:
     3704            delMark(buffer buf_utd-marking-line).
     3705            delete buf_utd-marking-line.
     3706         end.
     3707      end.
     3708   end.
     3709   method public void addMark
     3710   ( buffer utd-marking-lines for utd-marking-lines ):
     3711      define buffer buf_utd-marking-line for utd-marking-lines.
     3712      define buffer par_utd-marking-line for utd-marking-lines.
     3713      define buffer buf_utd for ub.utd .
     3714      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     3715         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     3716                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     3717                                           and buf_utd-marking-line.mark      eq marking.mark
     3718         no-lock no-error.
     3719         if available  buf_utd-marking-line
     3720         then do:
     3721            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     3722            then do:
     3723               find current  buf_utd-marking-line exclusive-lock no-error.
     3724               if available buf_utd-marking-line
     3725               then
     3726                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     3727            end.
     3728         end.
     3729         else do:
     3730            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     3731                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     3732                                         no-error .
     3733            create buf_utd-marking-line.
     3734            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     3735            assign
     3736               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     3737               buf_utd-marking-line.mark      = marking.mark
     3738               buf_utd-marking-line.gds-code  = marking.Gds-code
     3739               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     3740                                               then marking.sts
     3741                                               else
     3742                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     3743                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     3744                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     3745                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     3746                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3747                                                else marking.sts
     3748            .
     3749            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     3750            do:
     3751              for first par_utd-marking-line no-lock where
     3752                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     3753                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     3754                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     3755                    and par_utd-marking-line.mark    = marking.mark-parent
     3756                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     3757              :
     3758                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     3759              end.
     3760            end.
     3761         end.
     3762         addMark(buffer buf_utd-marking-line).
     3763      end.
     3764   end.
     3765   method public void unLockUTDMarkbuf
     3766   (buffer old_utd for utd,
     3767    iAll as logical ):
     3768      define variable voldkey    as character no-undo.
     3769         define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     3770         objKeyRec = new ibs.th.gbl.keyrec().
     3771         objKeyRec:GenKeyRec ( input 'utd':U
     3772                              ,input buffer old_utd:handle
     3773                              ,output voldkey).
     3774         delete object objKeyRec.
     3775      for each marking where marking.loc-key eq voldkey
     3776      exclusive-lock:
     3777         if    iAll
     3778            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     3779                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     3780         then do:
     3781            marking.loc-key = "".
     3782            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     3783         end.
     3784      end.
     3785   end.
     3786   method public void unLockUTDMark
     3787   (idb-num as integer ,idoc-id as integer ,iall as logical):
     3788      define buffer old_utd for utd.
     3789      find first old_utd where old_utd.db-num eq idb-num
     3790                           and old_utd.db-num eq idoc-id
     3791      no-lock no-error.
     3792      if available old_utd
     3793      then do:
     3794         UnLockUTDMarkbuf(buffer old_utd,iall).
     3795      end.
     3796   end.
     3797   method public void changSts
     3798   (idb-num as integer ,
     3799    idoc-id as integer ,
     3800    old_sts_edo as character ,
     3801    new_sts_edo as character  ):
     3802      if     old_sts_edo ne new_sts_edo
     3803         and ( new_sts_edo eq "RevocationAccepted"
     3804              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     3805              )
     3806      then
     3807         UnLockUTDMark(idb-num,idoc-id,yes).
     3808      if     old_sts_edo ne new_sts_edo
     3809         and ( new_sts_edo eq "WithRecipientSignature"
     3810           or  new_sts_edo eq "WithRecipientPartiallySignature"
     3811              )
     3812      then
     3813         UnLockUTDMark(idb-num,idoc-id,no).
     3814   end.
     3815   method public void SetLockUTDMark
     3816   (idb-num as integer ,idoc-id as integer ):
     3817      define buffer new_utd for utd.
     3818      define buffer old_utd for utd.
     3819      define variable volddb-num as integer no-undo.
     3820      define variable volddoc-id as integer no-undo.
     3821      define variable voldkey    as character no-undo.
     3822      define variable vnewkey    as character no-undo.
     3823      find first new_utd where new_utd.db-num eq idb-num
     3824                           and new_utd.doc-id eq idoc-id
     3825      no-lock no-error.
     3826      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     3827      then do trans:
     3828         find first old_utd where old_utd.db-num eq volddb-num
     3829                              and old_utd.doc-id eq volddoc-id
     3830         no-lock no-error.
     3831            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     3832            objKeyRec = new ibs.th.gbl.keyrec().
     3833            objKeyRec:GenKeyRec ( input 'utd':U
     3834                                 ,input buffer new_utd:handle
     3835                                 ,output vnewkey).
     3836            objKeyRec:GenKeyRec ( input 'utd':U
     3837                                 ,input buffer old_utd:handle
     3838                                 ,output voldkey).
     3839            delete object objKeyRec.
     3840         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     3841                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     3842         no-lock:
     3843            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     3844            if available  marking
     3845            then do:
     3846               if    marking.loc-key eq ""
     3847                  or marking.loc-key eq ?
     3848                  or marking.loc-key eq voldkey
     3849               then do:
     3850                  find current marking exclusive-lock no-error.
     3851                  if available marking
     3852                  then do:
     3853                     marking.loc-key = vnewkey.
     3854                     release marking.
     3855                  end.
     3856               end.
     3857               else if marking.loc-key ne vnewkey
     3858               then do:
     3859                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     3860               end.
     3861            end.
     3862         end.
     3863         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     3864      end.
     3865   end.
     3866     define private temp-table tt-mark no-undo
     3867        field mark as character case-sensitive
     3868     .
     3869     define stream myProt.
     3870     define variable isOpenProt as logical no-undo init no.
     3871     define property Msg as character no-undo
     3872       get.
     3873       set.
     3874     define variable GrayZoneQnty  as integer no-undo .
     3875   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3876   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3877     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
     3878       define variable objImp    as class ibs.th.bge.1crn.subjects.edi-doc no-undo.
     3879       define variable v-retfl   as logical no-undo .
     3880       define variable v-mode    as character no-undo.
     3881       define variable v-objlist   as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:kb-gds[]
     3882       define variable v-gds-gd    as class ibs.th.bge.1crn.subjects.edi-gd no-undo .
     3883       define variable v-objlistmark   as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:kb-gds[]
     3884       define variable v-marks-mark    as class ibs.th.bge.1crn.subjects.mark no-undo .
     3885       define variable v-i-counter as integer no-undo .
     3886       define variable v-i-num     as integer no-undo .
     3887       define variable v-i-counter2 as integer no-undo .
     3888       define variable v-i-num2     as integer no-undo .
     3889       define variable v-stub      as integer no-undo .
     3890       define variable v-value-character     as character     no-undo .
     3891       define variable v-value-decimal       as decimal       no-undo .
     3892       define variable v-value-integer       as integer       no-undo .
     3893       define variable v-value-logical       as logical       no-undo .
     3894       define variable v-value-type          as character     no-undo .
     3895       define variable v-value-date          as date          no-undo .
     3896       define variable v-host-code  as integer no-undo .
     3897       define buffer buf_clients    for ub.clients .
     3898       define buffer buf_goods      for ub.goods .
     3899       define buffer buf_goods-attr for ub.goods-attr .
     3900       define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc .
     3901       define buffer utd for ub.utd .
     3902       define buffer utd-attr for ub.utd-attr .
     3903      define buffer utd-lines              for ub.utd-lines .
     3904      define buffer utd-lines-attr         for ub.utd-lines-attr .
     3905      define buffer utd-marking-lines      for ub.utd-marking-lines .
     3906      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr .
     3907      define buffer marking                for ub.marking .
     3908      define buffer marking-attr           for ub.marking-attr .
     3909      define buffer contract               for ub.contract .
     3910      define buffer order-doc              for ub.order-doc .
     3911       objImp = cast (subjectObj, edi-doc).
     3912       if objImp:del-f > 0 then
     3913         undo, throw new Progress.Lang.AppError("физичесткое удаление edi-doc не предусмотрено") .
     3914      find first utd where utd.OrganizationExt eq ""
     3915                       and utd.DocumentExt     eq objImp:edoc-id
     3916      exclusive-lock no-error.
     3917      if not available utd
     3918      then do:
     3919         if objImp:obj-load ne "edi-doc"
     3920         then
     3921            undo, throw new Progress.Lang.AppError(substitute("Создание &1 не предусмотрено",objImp:obj-load)) .
     3922         create utd.
     3923         utd.DocumentExt     = objImp:edoc-id.
     3924         validate utd no-error.
     3925         if error-status:error
     3926         then
     3927            undo, throw new Progress.Lang.AppError(substitute("&1 &2",return-value,error-status:get-message (1))) .
     3928      end.
     3929      if objImp:obj-load eq "edi-doc-stts"
     3930      then do:
     3931         utd.sts  = ObjSrv:Env:Utd:Sts:th:GetKeyIntDB(objImp:edoc-stts).
     3932         for each utd-marking-lines where utd-marking-lines.db-num    eq utd.db-num
     3933                                      and utd-marking-lines.doc-id    eq utd.doc-id
     3934                                      and utd-marking-lines.doc-level eq 1
     3935         exclusive-lock:
     3936            addMark(buffer utd-marking-lines ).
     3937                        find first marking exclusive-lock where marking.mark = utd-marking-lines.mark no-error .
     3938                          if available (marking) then do:
     3939                          if marking.unit-ext <> "UNIT" and utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     3940                          and marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     3941                          marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB.
     3942                          end.
     3943         end.
     3944      end.
     3945      else do:
     3946         assign
     3947            utd.comment  = objImp:comment
     3948            utd.CounteragentId  = objImp:contr-code                  when objImp:contr-code ne ?
     3949            utd.contract-code  = objImp:dog-code                     when objImp:dog-code ne ?
     3950            utd.DocumentDate  = objImp:edoc-date
     3951            utd.DocumentNumber  = objImp:edoc-num
     3952            utd.sts  = ObjSrv:Env:Utd:Sts:th:GetKeyIntDB(objImp:edoc-stts)
     3953            utd.sts-edi  = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB
     3954            utd.EDocType  = ObjSrv:Env:Utd:edoctype:GetKeyIntDB(objImp:edoc-type)
     3955            utd.parentDocumentExt  = objImp:orig-edoc-id             when objImp:orig-edoc-id ne ?
     3956            utd.PackageId          = objImp:orig-edoc-id             when objImp:orig-edoc-id ne ?
     3957            utd.total  = objImp:sum                                  when objImp:sum ne ?
     3958            utd.vat  = utd.total - objImp:sum-nonds                  when objImp:sum ne ? and objImp:sum-nonds ne ?
     3959         .
     3960         define variable vflag as logical no-undo.
     3961         for first buf_clients no-lock
     3962               where buf_clients.obj-type = 'орг':U
     3963                 and buf_clients.obj-code = int(objImp:contr-code) :
     3964            assign
     3965               utd.cli-type   = buf_clients.obj-type
     3966               utd.cli-code   = buf_clients.obj-code
     3967              vflag = yes
     3968            .
     3969         end.
     3970         if  not vflag
     3971         then
     3972            undo, throw new Progress.Lang.AppError(substitute("Не найдена организация с кодом &1 в БД &2",int(objImp:contr-code),ibs.th.gbl.gbl-var:g#db-num)) .
     3973         for first buf_clients no-lock
     3974               where buf_clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
     3975                 and buf_clients.obj-type = 'маг':U
     3976                 and buf_clients.stts     = 0 :
     3977            assign
     3978               utd.obj-type   = buf_clients.obj-type
     3979               utd.obj-code   = buf_clients.obj-code
     3980               utd.host-code  = buf_clients.host-code
     3981            .
     3982             run adm/shattri.p (
     3983                  input "get":U
     3984                  ,input utd.obj-type
     3985                  ,input utd.obj-code
     3986                  ,input 'marking':U
     3987                  ,input "gray_zone_qnty"
     3988                  ,output v-value-character
     3989                  ,output v-value-date
     3990                  ,output v-value-decimal
     3991                  ,output v-value-integer
     3992                  ,output v-value-logical
     3993                  ,output v-value-type
     3994                  ,input-output TABLE thbjattr_thbj-attr
     3995                  ) no-error .
     3996              if v-value-integer <> ?
     3997              then
     3998                 GrayZoneQnty = 100
     3999              .
     4000            find first shop where shop.obj-code eq buf_clients.obj-code
     4001            no-lock no-error.
     4002            if available shop
     4003            then
     4004               utd.obj-info = shop.addres1.
     4005         end.
     4006         find first contract  where contract.host-code     eq utd.host-code
     4007                                and contract.contract-code eq utd.contract-code
     4008         no-lock no-error.
     4009         if  not available contract
     4010         then
     4011            undo, throw new Progress.Lang.AppError(substitute("В &1, указанный в УПД, не найден в системе.",utd.contract-code)) .
     4012         if     contract.cli-type  ne utd.cli-type
     4013            or  contract.cli-code  ne utd.cli-code
     4014         then
     4015            undo, throw new Progress.Lang.AppError(substitute("В договоре &1 и в УПД разные контр агенты",utd.contract-code)) .
     4016         Utd.BaseDocumentNumber = contract.contract-prn-code.
     4017         utd.BaseDocumentDate       = contract-date.
     4018         if objImp:order-item ne ? and
     4019            can-find(first order-doc where order-doc.order-item = objImp:order-item)
     4020         then
     4021           setattrutd(utd.db-num, utd.doc-id, "order-item", objImp:order-item).
     4022         v-objlist = objImp:gds .
     4023         if valid-object(v-objlist)
     4024         then do :
     4025            v-i-counter = v-objlist:iCounter .
     4026            do v-i-num = 1 to v-i-counter :
     4027               v-stub = v-objlist:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
     4028               v-gds-gd = cast(v-objlist:SubjectObjCurr, ibs.th.bge.1crn.subjects.edi-gd) .
     4029               find first utd-lines where utd-lines.db-num  eq utd.db-num
     4030                                      and utd-lines.doc-id  eq utd.doc-id
     4031                                      and utd-lines.LineNum eq v-gds-gd:line-num
     4032               exclusive-lock no-error.
     4033               if not available utd-lines
     4034               then do:
     4035                  create utd-lines.
     4036                  assign
     4037                     utd-lines.db-num   = utd.db-num
     4038                     utd-lines.doc-id   = utd.doc-id
     4039                     utd-lines.LineNum  = v-gds-gd:line-num
     4040                  .
     4041               end.
     4042               utd-lines.TaxRate = v-gds-gd:nds-code.
     4043               if v-gds-gd:gds-code ne ?
     4044               then do:
     4045                  find first goods where goods.gds-code eq v-gds-gd:gds-code
     4046                  no-lock no-error.
     4047                  if not available goods
     4048                  then
     4049                     undo, throw new Progress.Lang.AppError(substitute("Нет товара с кодом &1",v-gds-gd:gds-code)).
     4050               end.
     4051               assign
     4052                  utd-lines.Price     = v-gds-gd:price-nonds
     4053                  utd-lines.Quantity  = v-gds-gd:qnty-ttn
     4054                  utd-lines.Total     = v-gds-gd:sum
     4055                  utd-lines.gds-code  = v-gds-gd:gds-code
     4056               .
     4057               if available  goods
     4058               then
     4059                  assign
     4060                     utd-lines.UnitCode  = goods.unit-base
     4061                     utd-lines.GdsName   = goods.gds-name
     4062                  .
     4063               release goods.
     4064               if v-gds-gd:sum-nds eq ?
     4065               then
     4066                  assign
     4067                     utd-lines.TotalWithVatExcluded  = utd-lines.Price * utd-lines.Quantity
     4068                  .
     4069               else
     4070                  assign
     4071                     utd-lines.Vat                   = v-gds-gd:sum-nds
     4072                     utd-lines.TotalWithVatExcluded  = utd-lines.Total - utd-lines.Vat
     4073                  .
     4074               if v-gds-gd:stts-desc ne ?
     4075               then
     4076                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"Load1C","stts-desc-line",v-gds-gd:stts-desc + chr(4) + string( utd-lines.LineNum)).
     4077               if v-gds-gd:cert-decl ne ""
     4078               then
     4079                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"doc_sertif",v-gds-gd:cert-decl).
     4080               if v-gds-gd:Qnty-accepted ne ?
     4081               then
     4082                  setattrutdlines(utd-lines.db-num, utd-lines.doc-id, utd-lines.lineNum,"QuantityBarCode",string(v-gds-gd:Qnty-accepted)).
     4083               if v-gds-gd:manual-selection eq 1
     4084               then
     4085                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"manual-selection","yes").
     4086               else
     4087                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"manual-selection","").
     4088               define variable vqnty as integer no-undo.
     4089               vqnty = 0.
     4090               define variable vGdsCode as integer no-undo.
     4091               v-objlistmark = v-gds-gd:marks .
     4092               if valid-object(v-objlistmark)
     4093               then do :
     4094                  vGdsCode = 0.
     4095                  v-i-counter2 = v-objlistmark:iCounter .
     4096                  for each tt-mark:
     4097                     delete tt-mark.
     4098                  end.
     4099                  for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4100                                               and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4101                                               and utd-marking-lines.LineNum eq utd-lines.LineNum
     4102                  exclusive-lock:
     4103                     delete utd-marking-lines.
     4104                  end.
     4105                  do v-i-num2 = 1 to v-i-counter2 :
     4106                     v-objlistmark:Get(v-i-num2) .
     4107                     v-marks-mark = cast(v-objlistmark:SubjectObjCurr, ibs.th.bge.1crn.subjects.mark) .
     4108                     define variable vmark as character no-undo.
     4109                     vmark = repTegforDm(v-marks-mark:mark-code).
     4110                     release marking.
     4111                     if ismark(vmark)
     4112                     then do:
     4113                        find first marking where marking.mark eq vmark
     4114                           no-lock no-error.
     4115                        if not available marking
     4116                        then
     4117                           undo, throw new Progress.Lang.AppError(substitute("Нет марки &1 .",v-marks-mark:mark-code)) .
     4118                     end.
     4119                     define variable vrec as recid no-undo.
     4120                     vrec = addMarkforUtd (utd-lines.db-num ,
     4121                                    utd-lines.doc-id,
     4122                                    utd-lines.Linenum,
     4123                                    vmark,
     4124                                    "1c",
     4125                                    objImp:edoc-type).
     4126                     find first utd-marking-lines where recid(utd-marking-lines)   eq vrec
     4127                     exclusive-lock no-error.
     4128                     if available marking
     4129                     then
     4130                        utd-marking-lines.gds-code = marking.gds-code.
     4131                     else
     4132                        utd-marking-lines.gds-code = v-gds-gd:gds-code.
     4133                     if     vGdsCode eq 0
     4134                        and utd-marking-lines.gds-code ne ?
     4135                     then
     4136                        vGdsCode = utd-marking-lines.gds-code.
     4137                     else if      utd-marking-lines.gds-code ne ?
     4138                         and vGdsCode ne utd-marking-lines.gds-code
     4139                     then
     4140                        vGdsCode = ?.
     4141                     if not ismark(vmark)
     4142                     then do:
     4143                        define variable vQntyMark as decimal no-undo.
     4144                        vQntyMark = getQntyUTDByCodId(vmark) .
     4145                        setattrUtdMarkingLines(utd-lines.db-num, utd-lines.doc-id, utd-lines.Linenum, vmark,"box-qnty",string(vQntyMark)).
     4146                     end.
     4147                     else
     4148                        vQntyMark = marking.box-qnty.
     4149                     if utd-marking-lines.doc-level eq 1
     4150                     then
     4151                        vqnty = vqnty + vQntyMark.
     4152                     utd-marking-lines.sts = if not avail ub.marking then ObjSrv:Env:marking:Sts:mark:GetKeyIntDB(v-marks-mark:stts)
     4153                                             else
     4154                                    if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(ub.marking.sts)) or
     4155                                       can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(ub.marking.sts)) or
     4156                                       ub.marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4157                                       ub.marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4158                                    then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4159                                    else ub.marking.sts.
     4160                     if     v-marks-mark:stts-desc ne ?
     4161                        and available marking
     4162                     then
     4163                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"Load1C","stts-desc-mark",v-marks-mark:stts-desc + chr(4) + string( utd-lines.LineNum) + chr(4) +  vmark).
     4164                     release utd-marking-lines.
     4165                  end.
     4166   run gbl/inidebug.p.
     4167                  for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4168                                               and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4169                                               and utd-marking-lines.LineNum eq utd-lines.LineNum
     4170                                               and utd-marking-lines.doc-level = 1
     4171                  exclusive-lock:
     4172                     do:
     4173                        MarkGray(utd-marking-lines.mark, utd.db-num, utd.doc-id).
     4174                        addMark( buffer utd-marking-lines).
     4175                          find first marking exclusive-lock where marking.mark = utd-marking-lines.mark no-error .
     4176                          if available (marking) then do:
     4177                             if marking.unit-ext <> "UNIT" and utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     4178                             and marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4179                             marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB.
     4180                          end.
     4181                     end.
     4182                  end.
     4183                  if     vGdsCode     eq ?
     4184                     and v-i-counter2 > 0
     4185                  then
     4186                     utd-lines.gds-code = ?.
     4187               end. //
     4188               release utd-lines.
     4189            end.
     4190         end.
     4191      end.
     4192      for each utd-lines where utd-lines.db-num eq utd.db-num
     4193                           and utd-lines.doc-id eq utd.doc-id
     4194      no-lock:
     4195         CheckMarkUtdLine(utd-lines.db-num,
     4196                          utd-lines.doc-id,
     4197                          utd-lines.LineNum).
     4198      end.
     4199      CheckMarkUtd(utd.db-num,utd.doc-id).
     4200      CheckMarking(utd.db-num,utd.doc-id,"CheckСontract").
     4201      CheckMarkUtd(utd.db-num,utd.doc-id).
     4202      if ibs.th.gbl.gbl-var:g#db-num ne 0 and utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB
     4203         and (utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB )
     4204        then
     4205      do:
     4206        def var v-file-name as character no-undo.
     4207        def var v-msg       as character no-undo.
     4208        run ibs\th\str\utd\adaputd.p
     4209          (utd.db-num,
     4210          utd.doc-id,
     4211          ibs.th.gbl.gbl-var:g#userid
     4212          ) no-error.
     4213        if not error-status:error
     4214        then do:
     4215           v-msg = "".
     4216           if return-value matches "*ошибка*"
     4217           or return-value begins "need-user-action"
     4218           then v-msg = substitute ('Документ № &1 от &2. Сформирована ПН: &3. &4', utd.DocumentNumber, string (utd.DocumentDate) , utd.doc-code, trim(return-value, "need-user-action")).
     4219           else do:
     4220              if     utd.sts ne objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
     4221              then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &6 &4',
     4222                                          utd.DocumentNumber,
     4223                                          string (utd.DocumentDate) ,
     4224                                          utd.doc-code,
     4225                                          return-value,
     4226                                          if ChecknotMarkUtd(utd.db-num,utd.doc-id) then "Немаркированные товары можно продавать на кассе." else "",
     4227                                          if CheckMarkUtd(utd.db-num,utd.doc-id) then "Продажа маркированных товаров из данной поставки запрещена до получения дополнительного уведомления." else "").
     4228              else if     utd.sts eq objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
     4229                      and CheckMarkUtd(utd.db-num,utd.doc-id)
     4230              then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &4', utd.DocumentNumber, string (utd.DocumentDate) , utd.doc-code, return-value, "Маркированные товары данной поставки можно продавать на кассе").
     4231           end.
     4232        end.
     4233        else v-msg = substitute ('Документ: &1 от &2. Ошибка при формировании ПН. &3. &4', utd.DocumentNumber, string (utd.DocumentDate), trim(return-value, ".")).
     4234        if v-msg ne ""
     4235        then
     4236           run utl\proc-msg.p (v-msg) no-error.
     4237      end.
     4238      if ibs.th.gbl.gbl-var:g#db-num ne 0 and utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     4239      then do:
     4240          v-msg = substitute ('MsgBox "Докумет № &1 от &2. ", ,"Получен документ первоначального ввода"', utd.DocumentNumber, string (utd.DocumentDate)).
     4241          v-file-name = string (guid(generate-uuid)) + ".vbs".
     4242          output to value (v-file-name).
     4243          put unformatted v-msg.
     4244          output close.
     4245          file-info:file-name = (v-file-name).
     4246          os-command no-wait value (file-info:full-pathname).
     4247      end.
     4248      release utd.
     4249      v-retfl = true .
     4250       define variable i as integer no-undo .
     4251       catch exAppErrors as class Progress.Lang.AppError :
     4252         Msg = exAppErrors:ReturnValue .
     4253         if Msg > "" then . else do :
     4254           do i = 1 to exAppErrors:NumMessages :
     4255             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
     4256           end .
     4257           if Msg > "" then . else Msg = "AppError в edi-doc" .
     4258         end .
     4259         v-retfl = false .
     4260         undo, throw exAppErrors .
     4261       end catch .
     4262       catch exProErrors as class Progress.Lang.ProError :
     4263         do i = 1 to exProErrors:NumMessages :
     4264           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
     4265         end .
     4266         if Msg > "" then . else Msg = "ProError в edi-doc" .
     4267         v-retfl = false.
     4268         undo, throw exProErrors .
     4269       end catch .
     4270       catch exAnyErrors as class Progress.Lang.Error:
     4271         Msg = "Unexpected error в edi-doc" .
     4272         v-retfl = false .
     4273         undo, throw exAnyErrors .
     4274       end catch .
     4275       finally :
     4276         return v-retfl .
     4277       end finally .
     4278     end method.
     4279     method public void MarkGray(imark as char, idb-num as int, idoc-id as int):
     4280        define buffer marking for marking.
     4281        define buffer BuF_marking for marking.
     4282        define buffer bf_bar-code for ub.bar-code .
     4283        define buffer bf2_bar-code for ub.bar-code .
     4284        define buffer bf_goods-attr for ub.goods-attr .
     4285        define buffer bf_utd-marking-lines for utd-marking-lines .
     4286        define variable vAllQnty as integer no-undo init ?.
     4287        define variable vQnty as integer no-undo.
     4288        define variable v-must-be-childs as integer no-undo .
     4289        define variable cisGdsCode as integer no-undo .
     4290        define variable v-mark-type  as character no-undo .
     4291        define variable v-err-childs as logical no-undo .
     4292        define variable v-gray-zone  as logical no-undo .
     4293        define variable errMsg as character no-undo .
     4294        v-err-childs = false .
     4295        v-gray-zone = false .
     4296        find first marking where marking.mark eq imark
     4297        no-lock no-error.
     4298        if available marking
     4299           and marking.box-qnty ne 1
     4300        then do:
     4301           find first bf_utd-marking-lines where bf_utd-marking-lines.db-num eq idb-num
     4302                                             and bf_utd-marking-lines.doc-id eq idoc-id
     4303                                             and bf_utd-marking-lines.mark   eq marking.mark
     4304           no-lock no-error.
     4305           if marking.gds-code > 0
     4306           then do :
     4307              cisGdsCode = marking.gds-code .
     4308           end .
     4309           else do :
     4310              cisGdsCode = getGdsCodeByGtin(marking.gds-ext-id) .
     4311           end .
     4312           v-mark-type = "" .
     4313           for first bf_goods-attr no-lock where bf_goods-attr.attr-code = 'mark-type':U
     4314                                             and bf_goods-attr.gds-code = cisGdsCode
     4315                                             :
     4316              v-mark-type = bf_goods-attr.attr-value .
     4317           end .
     4318           for each buf_marking where buf_marking.mark-parent eq marking.mark
     4319           no-lock:
     4320              if vAllQnty eq ?
     4321              then
     4322                 vAllQnty = marking.box-qnty / buf_marking.box-qnty.
     4323              vQnty = vQnty + 1.
     4324           end.
     4325           if marking.unit-ext = "LEVEL1"
     4326           or marking.unit-ext = "GROUP"
     4327           then do :
     4328              if cisGdsCode > 0
     4329              then do :
     4330                 v-must-be-childs = 10 .
     4331                 if v-mark-type = "tabak"
     4332                 then do:
     4333                   find first bf_bar-code no-lock where bf_bar-code.gds-code = cisGdsCode
     4334                                                    and bf_bar-code.unit-cli = "бл"
     4335                                                    and bf_bar-code.stts_ = 0
     4336                   no-error .
     4337                   if available bf_bar-code
     4338                   then do :
     4339                     v-must-be-childs = bf_bar-code.cli-base-rate .
     4340                   end .
     4341                   else do :
     4342                     errMSG = "Для товара с кодом " + string(cisGdsCode) + " не найден код с ед. изм. 'бл'" .
     4343                     v-err-childs = true .
     4344                   end .
     4345                 end.
     4346                 else do:
     4347                     v-must-be-childs = getQntyCodeByGtin(marking.gds-ext-id).
     4348                     if v-must-be-childs = ?
     4349                     then do:
     4350                       errMSG = "Для товара с кодом " + string(cisGdsCode) + " не найден коэф. ед. изм. по GTIN" .
     4351                       v-err-childs = true .
     4352                     end.
     4353                 end.
     4354                 if not v-err-childs
     4355                 then do :
     4356                   if v-mark-type = "tabak"
     4357                   or v-mark-type = "stiki"
     4358                   then do :
     4359                     if vQnty <> v-must-be-childs and GrayZoneQnty <> 100
     4360                     then do:
     4361                       if (v-must-be-childs - vQnty) <= GrayZoneQnty
     4362                       then v-gray-zone = true .
     4363                       else v-err-childs = true .
     4364                     end .
     4365                     if v-gray-zone
     4366                     then do :
     4367                        MarkChangeSts(marking.mark,
     4368                                      objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB,
     4369                                      "",
     4370                                      no).
     4371                     end .
     4372                   end .
     4373                   else do :
     4374                     if vQnty <> v-must-be-childs then v-err-childs = true .
     4375                   end .
     4376                   if v-err-childs
     4377                   then do :
     4378                     errMSG = "В блоке " + string(vQnty) + " пачек." .
     4379                   end .
     4380                 end .
     4381                 if v-err-childs
     4382                 then do :
     4383                    MarkChangeSts(marking.mark,
     4384                                  objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB,
     4385                                  errMSG,
     4386                                  yes).
     4387                    if marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4388                    then
     4389                    AddUtdErr(idb-num,
     4390                              idoc-id,
     4391                              if available bf_utd-marking-lines
     4392                              then buffer bf_utd-marking-lines:handle
     4393                              else buffer marking:handle,
     4394                              "CheckMOTP",
     4395                              "MotpMarkErr",
     4396                              (marking.mark + chr(4) + errMSG)).
     4397                 end .
     4398              end .
     4399           end .
     4400           else do :
     4401              if vAllQnty <> vQnty and GrayZoneQnty <> 100
     4402              then do:
     4403                 if vAllQnty - vQnty <= GrayZoneQnty
     4404                 then do :
     4405                    MarkChangeSts(marking.mark,
     4406                                  objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB,
     4407                                  "",
     4408                                  no).
     4409                 end .
     4410                 else do :
     4411                   errMSG = "В блоке " + string(vQnty) + " пачек." .
     4412                   MarkChangeSts(marking.mark,
     4413                                  objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB,
     4414                                  errMSG,
     4415                                  yes).
     4416                   if marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4417                   then
     4418                   AddUtdErr(idb-num,
     4419                             idoc-id,
     4420                             if available bf_utd-marking-lines
     4421                             then buffer bf_utd-marking-lines:handle
     4422                             else buffer marking:handle,
     4423                             "CheckMOTP",
     4424                             "MotpMarkErr",
     4425                             (marking.mark + chr(4) + errMSG)).
     4426                 end .
     4427              end.
     4428           end.
     4429        end.
     4430        else if available marking
     4431        then do:
     4432           if marking.gds-code > 0
     4433           then do :
     4434              cisGdsCode = marking.gds-code .
     4435           end .
     4436           else do :
     4437              cisGdsCode = getGdsCodeByGtin(marking.gds-ext-id) .
     4438           end .
     4439           if cisGdsCode > 0 and
     4440              WeighedProd(cisGdsCode) and
     4441              MarkWeight(marking.mark) = 0 then do:
     4442               find first bf_utd-marking-lines where bf_utd-marking-lines.db-num eq idb-num
     4443                                                 and bf_utd-marking-lines.doc-id eq idoc-id
     4444                                                 and bf_utd-marking-lines.mark   eq marking.mark
     4445               no-lock no-error.
     4446               errMSG = "Марка не содержит информации о весе товара." .
     4447               MarkChangeSts(marking.mark,
     4448                              objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB,
     4449                              errMSG,
     4450                              yes).
     4451               if marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     4452                  and available bf_utd-marking-lines
     4453               then
     4454                   AddUtdErr(idb-num,
     4455                             idoc-id,
     4456                             if available bf_utd-marking-lines
     4457                             then buffer bf_utd-marking-lines:handle
     4458                             else buffer marking:handle,
     4459                             "LoadUtd",
     4460                             "NoWeightMark",
     4461                             (marking.mark + chr(4) + errMSG)).
     4462           end.
     4463        end.
     4464     end.
     4465     method public void MarkChangeSts(imark as char, ists as int, ierrMSG as char, ichld as log):
     4466        define buffer buf_marking for ub.marking.
     4467        define buffer chld_marking for ub.marking.
     4468        do transaction
     4469        on error undo, return:
     4470            find first buf_marking where buf_marking.mark eq imark
     4471            exclusive-lock no-error no-wait.
     4472            if available buf_marking and
     4473               buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     4474            then do:
     4475               buf_marking.sts = ists.
     4476               if ierrMSG > "" then
     4477                  buf_marking.comment = ierrMSG.
     4478               if ichld then
     4479               for each chld_marking exclusive-lock where
     4480                        chld_marking.mark-parent = buf_marking.mark:
     4481                   chld_marking.sts = ists.
     4482               end.
     4483            end.
     4484        end.
     4485     end method.
     4486     method private void out2log (iDbNum as integer, iDocId as integer, imark as char, iLevel as int):
     4487       define buffer bf_utd-marking-lines for ub.utd-marking-lines.
     4488       define buffer bf_marking for ub.marking.
     4489       if not isOpenProt then
     4490       do:
     4491         output stream myProt to c:\wrk\impedi-doc.log.
     4492         isOpenProt = yes.
     4493       end.
     4494       else
     4495         output stream myProt to c:\wrk\impedi-doc.log append.
     4496       for first bf_utd-marking-lines no-lock where
     4497                 bf_utd-marking-lines.db-num = iDbNum
     4498             and bf_utd-marking-lines.doc-id = iDocId
     4499             and bf_utd-marking-lines.mark   = imark,
     4500           first bf_marking no-lock where
     4501                 bf_marking.mark = imark
     4502       :
     4503         put stream myProt unformatted
     4504           fill("  ", iLevel)
     4505           bf_utd-marking-lines.gds-code " "
     4506           bf_utd-marking-lines.doc-level " "
     4507           bf_marking.mark " "
     4508           objSrv:Env:Marking:Sts:Mark:GetLabel(bf_marking.sts) " "
     4509           objSrv:Env:Marking:Sts:Mark:GetLabel(bf_utd-marking-lines.sts)
     4510           skip
     4511         .
     4512       end.
     4513       output stream myProt close.
     4514       for each bf_marking no-lock where
     4515                bf_marking.mark-parent eq iMark,
     4516           first bf_utd-marking-lines no-lock where
     4517                 bf_utd-marking-lines.db-num = iDbNum
     4518             and bf_utd-marking-lines.doc-id = iDocId
     4519             and bf_utd-marking-lines.mark = bf_marking.mark
     4520       :
     4521         out2log(iDbNum, iDocId, bf_marking.mark, iLevel + 1).
     4522       end.
     4523     end method.
     4524   end class.
