        1   using ibs.th.bge.1crn.subjects.subjects.
        2   using ibs.th.bge.1crn.subjects.edi-doc.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impedi-doc inherits ibs.th.gbl.sys.objth implements ibs.th.bge.1crn.import.iimpsubject :
        5     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        6     define override public property vss-author      as character no-undo init "$Author:$":U get.
        7     define override public property vss-date        as character no-undo init "$Date:$":U get.
        8     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        9     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       10     define override public property vss-description as character no-undo init "Импорт edi-doc" get.
       11   method public integer AddOADLine
       12   (iDb-num  as integer ,
       13    iDoc-id  as integer ,
       14    ilinenum as integer ,
       15    iGtin    as char,
       16    iQnty    as int,
       17    isite    as character ):
       18       define buffer utd-marking-lines      for ub.utd-marking-lines.
       19       define variable vnewMark as character no-undo.
       20       define variable vQnty    as integer   no-undo.
       21       vnewMark = "02" + iGtin + "37" + string(iQnty).
       22       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
       23                                      and utd-marking-lines.db-num     = idb-num
       24                                      and utd-marking-lines.doc-id     = idoc-id
       25                                      and utd-marking-lines.Linenum    = iLinenum
       26       exclusive-lock no-error.
       27       if available utd-marking-lines
       28       then do:
       29          delete utd-marking-lines.
       30          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
       31       end.
       32       else do:
       33          create utd-marking-lines.
       34          assign
       35             utd-marking-lines.mark      = vnewMark
       36             utd-marking-lines.db-num    = idb-num
       37             utd-marking-lines.doc-id    = idoc-id
       38             utd-marking-lines.Linenum   = iLinenum
       39             utd-marking-lines.site      = isite
       40             utd-marking-lines.doc-level = 1
       41             utd-marking-lines.gds-code  = ?
       42          .
       43          vQnty = iQnty.
       44       end.
       45       return vQnty.
       46    end.
       47   method public recid addMarkforUtd
       48   (iDb-num  as integer ,
       49    iDoc-id  as integer ,
       50    ilinenum as integer ,
       51    iMark as character  ,
       52    isite   as character,
       53    iUtdType as character    ):
       54       define buffer     marking            for ub.marking.
       55       define buffer     marking-attr       for ub.marking-attr.
       56       define buffer utd-marking-lines      for ub.utd-marking-lines.
       57       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
       58       define variable vMRC  as decimal no-undo.
       59       define variable vQnty as decimal no-undo.
       60      define variable vRec as recid no-undo.
       61      if     imark ne "-"
       62         and imark ne ""
       63         and imark ne ?
       64      then do:
       65         imark = repTegforDm(imark).
       66         vQnty = getQntyUTDByCodId(imark) .
       67         find first utd-marking-lines where utd-marking-lines.mark       = imark
       68                                        and utd-marking-lines.db-num     = idb-num
       69                                        and utd-marking-lines.doc-id     = idoc-id
       70                                        and utd-marking-lines.Linenum    = iLinenum
       71         exclusive-lock no-error.
       72         if not available utd-marking-lines
       73         then do:
       74            create utd-marking-lines.
       75            assign
       76               utd-marking-lines.mark      = imark
       77               utd-marking-lines.db-num    = idb-num
       78               utd-marking-lines.doc-id    = idoc-id
       79               utd-marking-lines.Linenum   = iLinenum
       80               utd-marking-lines.site      = isite
       81               utd-marking-lines.doc-level = 1
       82               utd-marking-lines.gds-code  = ?
       83            .
       84            create utd-marking-lines-attr.
       85            assign
       86               utd-marking-lines-attr.mark      = imark
       87               utd-marking-lines-attr.db-num    = idb-num
       88               utd-marking-lines-attr.doc-id    = idoc-id
       89               utd-marking-lines-attr.Linenum   = iLinenum
       90               utd-marking-lines-attr.attr-code = "box-qnty"
       91               utd-marking-lines-attr.attr-value = string(vQnty)
       92            .
       93            vRec = recid(utd-marking-lines).
       94            release utd-marking-lines-attr.
       95            release utd-marking-lines.
       96         end.
       97         else do:
       98            if    (    isite eq "-"
       99               and utd-marking-lines.site eq "+")
      100            or (    isite eq "+"
      101               and utd-marking-lines.site eq "-")
      102            then
      103               delete utd-marking-lines.
      104            else if isOAD (imark)
      105            then do:
      106               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
      107               create utd-marking-lines-attr.
      108               assign
      109                  utd-marking-lines-attr.mark      = imark
      110                  utd-marking-lines-attr.db-num    = idb-num
      111                  utd-marking-lines-attr.doc-id    = idoc-id
      112                  utd-marking-lines-attr.Linenum   = iLinenum
      113                  utd-marking-lines-attr.attr-code = "box-qnty"
      114                  utd-marking-lines-attr.attr-value = string(vQnty)
      115               .
      116            end.
      117            vRec = recid(utd-marking-lines).
      118            release utd-marking-lines.
      119         end.
      120         if isMark (imark)
      121         then do:
      122            find first marking where marking.mark eq iMark exclusive-lock no-error.
      123            if not available marking
      124            then do:
      125               create marking.
      126               marking.mark = iMark.
      127               marking.gds-code = ?.
      128               marking.unit     = getLevelUTDByCodId(marking.mark) .
      129            end.
      130            assign
      131              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
      132                                      getLevelMotpByCodId(marking.mark)
      133                                   else marking.unit-ext
      134              marking.box-qnty   = vQnty
      135              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
      136            .
      137            if        (     iUtdType eq "UniversalTransferDocument"
      138                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
      139            then
      140               marking.sts = ?.
      141         end.
      142      end.
      143      return vRec.
      144   end.
      145   method public logical isSaleMarkInUpak
      146   (iMark    as char ):
      147      define buffer buf_marking       for ub.marking.
      148      for each buf_marking no-lock where
      149               buf_marking.mark-parent = iMark
      150      :
      151        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
      152           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
      153          return true.
      154        if isSaleMarkInUpak(buf_marking.mark) then
      155          return true.
      156      end.
      157      return false.
      158    end.
      159   method public logical setStatusUpak
      160   (iDbNum   as integer ,
      161    iDocId   as integer ,
      162    iLineNum as integer ,
      163    iMark    as char ,
      164    iSts     as integer):
      165      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
      166      define buffer buf_marking           for ub.marking.
      167      for each buf_marking exclusive-lock where
      168               buf_marking.mark-parent = iMark,
      169         first buf_utd-marking-lines exclusive-lock where
      170               buf_utd-marking-lines.doc-id  = iDocId
      171           and buf_utd-marking-lines.db-num  = iDbNum
      172           and buf_utd-marking-lines.lineNum = iLineNum
      173           and buf_utd-marking-lines.mark = buf_marking.mark
      174      :
      175        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
      176      end.
      177      for first buf_utd-marking-lines exclusive-lock where
      178                buf_utd-marking-lines.doc-id  = iDocId
      179            and buf_utd-marking-lines.db-num  = iDbNum
      180            and buf_utd-marking-lines.lineNum = iLineNum
      181            and buf_utd-marking-lines.mark = iMark,
      182          first buf_marking exclusive-lock where
      183                buf_marking.mark = buf_utd-marking-lines.mark
      184      :
      185        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
      186        then do:
      187          assign
      188            buf_utd-marking-lines.sts = iSts
      189            buf_marking.sts           = iSts
      190          .
      191        end.
      192      end.
      193      return true.
      194   end.
