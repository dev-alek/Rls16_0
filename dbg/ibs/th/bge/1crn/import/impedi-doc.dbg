      200   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   method public char getattrUtdEx
      202   (idb-num   as integer,
      203    idoc-id   as integer,
      204    iattrcode as character,
      205    iExValue  as character  ):
      206      define buffer utd-attr for utd-attr.
      207      find first utd-attr where utd-attr.db-num eq idb-num
      208                            and utd-attr.doc-id eq idoc-id
      209                            and utd-attr.attr-code eq iattrcode
      210      no-lock no-error.
      211      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      212   end.
      213   method public char getattrUtd
      214   (idb-num   as integer,
      215    idoc-id   as integer,
      216    iattrcode as character ):
      217     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      218   end.
      219   method public void setattrUtd
      220   (idb-num   as integer,
      221    idoc-id   as integer,
      222    iattrcode as character,
      223    iattrval  as character ):
      224      define buffer utd-attr for utd-attr.
      225      find first utd-attr where utd-attr.db-num eq idb-num
      226                            and utd-attr.doc-id eq idoc-id
      227                            and utd-attr.attr-code eq iattrcode
      228      no-lock no-error.
      229      if not available utd-attr
      230      then do:
      231         create utd-attr.
      232         assign
      233            utd-attr.db-num    = idb-num
      234            utd-attr.doc-id    = idoc-id
      235            utd-attr.attr-code = iattrcode
      236            utd-attr.attr-value = iattrval
      237         .
      238      end.
      239      else do:
      240         if utd-attr.attr-value ne iattrval
      241         then do:
      242            find current utd-attr exclusive-lock no-error.
      243            if available utd-attr
      244            then
      245               utd-attr.attr-value = iattrval.
      246         end.
      247      end.
      248      release utd-attr.
      249   end.
