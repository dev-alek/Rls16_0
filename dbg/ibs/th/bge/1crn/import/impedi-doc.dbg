     2346   method public logical CheckMarkUtdLine
     2347    (input idb-num  as integer,
     2348     input idoc-id  as integer,
     2349     input iLineNum as integer):
     2350    define buffer utd                   for utd.
     2351    define buffer utd-lines             for utd-lines.
     2352    define buffer utd-marking-lines     for utd-marking-lines.
     2353    define variable v-par-type as character no-undo.
     2354    define variable vMarking        as logical no-undo.
     2355    define variable vArtic          as logical no-undo.
     2356    define variable vTransitional   as logical no-undo.
     2357    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2358      define variable v-par-val  as character no-undo.
     2359      find first utd where utd.db-num eq idb-num
     2360                       and utd.doc-id eq idoc-id
     2361      no-lock no-error.
     2362      if available utd
     2363      then do:
     2364         if     utd.obj-code ne ?
     2365            and utd.obj-type ne ?
     2366         then do:
     2367            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2368            Block-utd-lines:
     2369            for each utd-lines where utd-lines.db-num   eq idb-num
     2370                                 and utd-lines.doc-id   eq idoc-id
     2371                                 and utd-lines.LineNum  eq iLineNum
     2372            no-lock:
     2373               if     utd-lines.gds-code ne ?
     2374                  and utd-lines.gds-code ne 0
     2375               then do:
     2376                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2377                       ( utd-lines.gds-code,
     2378                         'mark-type':U,
     2379                          output v-par-val,
     2380                          output v-par-type
     2381                       ).
     2382                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2383                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2384                  if vMarking
     2385                  then do:
     2386                     block-marking:
     2387                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2388                                                    and utd-marking-lines.doc-id   eq idoc-id
     2389                                                    and utd-marking-lines.LineNum  eq iLineNum
     2390                                                    and length(utd-marking-lines.mark) > 13
     2391                     no-lock:
     2392                        if isOAD(utd-marking-lines.mark)
     2393                        then do:
     2394                           assign
     2395                              vArtic   = yes
     2396                              vMarking = no
     2397                           .
     2398                           leave block-marking.
     2399                        end.
     2400                     end.
     2401                  end.
     2402                  if vArtic
     2403                  then do:
     2404                     block-artic:
     2405                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2406                                                    and utd-marking-lines.doc-id   eq idoc-id
     2407                                                    and utd-marking-lines.LineNum  eq iLineNum
     2408                                                    and length(utd-marking-lines.mark) > 13
     2409                     no-lock:
     2410                        if isMark(utd-marking-lines.mark)
     2411                        then do:
     2412                           assign
     2413                              vArtic   = no
     2414                              vMarking = yes
     2415                           .
     2416                           leave block-artic.
     2417                        end.
     2418                     end.
     2419                  end.
     2420                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2421                  if vTransitional
     2422                  then do:
     2423                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2424                                                    and utd-marking-lines.doc-id   eq idoc-id
     2425                                                    and utd-marking-lines.LineNum  eq iLineNum
     2426                                                    and length(utd-marking-lines.mark) > 13
     2427                     no-lock no-error.
     2428                     if not available utd-marking-lines
     2429                     then assign
     2430                        vMarking = no
     2431                        vArtic   = no
     2432                     .
     2433                  end.
     2434               end.
     2435               else
     2436                  assign
     2437                     vMarking      = yes
     2438                     vArtic        = no
     2439                     vTransitional = no
     2440                  .
     2441               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2442               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2443               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2444            end.
     2445         end.
     2446      end.
     2447      return vMarking or vArtic.
     2448   end.
     2449   method public logical getMarkUtdLine
     2450    (input  idb-num  as integer,
     2451     input  idoc-id  as integer,
     2452     input  iLineNum as integer,
     2453     output oMarking        as logical,
     2454     output oArtic          as logical,
     2455     output oTransitional   as logical):
     2456     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2457     oArtic        = not oMarking
     2458            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2459     oTransitional = (oMarking or oArtic)
     2460            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2461   end.
     2462   method public logical CheckMarking
     2463    (input idb-num as integer,
     2464    input idoc-id as integer,
     2465    input iTypeErr as character ):
     2466     define variable vMarkutd as logical no-undo.
     2467     define variable vCrErr   as logical no-undo.
     2468     define buffer utd-lines         for utd-lines.
     2469     define buffer utd-marking-lines for utd-marking-lines.
     2470     define buffer marking           for marking.
     2471     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2472      block-line:
     2473      for each utd-lines where utd-lines.db-num eq idb-num
     2474                           and utd-lines.doc-id eq idoc-id
     2475      no-lock:
     2476         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2477         then do:
     2478            for each utd-marking-lines
     2479                     where utd-marking-lines.db-num  = utd-lines.db-num
     2480                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2481                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2482            no-lock:
     2483               if isMark(utd-marking-lines.mark)
     2484               then do:
     2485                  find first marking where marking.mark eq utd-marking-lines.mark
     2486                  no-lock no-error.
     2487                  if not available marking
     2488                  then do:
     2489                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2490                     vCrErr = yes.
     2491                     next block-line.
     2492                  end.
     2493               end.
     2494            end.
     2495         end.
     2496      end.
     2497      return vCrErr.
     2498   end.
     2499   method public logical CheckMarkForType
     2500    (input idb-num   as integer,
     2501     input idoc-id   as integer):
     2502      define variable vMarking        as logical no-undo.
     2503      define variable vArtic          as logical no-undo.
     2504      define variable vTransitional   as logical no-undo.
     2505      define buffer utd-lines         for utd-lines.
     2506      define buffer utd-marking-lines for utd-marking-lines.
     2507      block-line:
     2508      for each utd-lines where utd-lines.db-num eq idb-num
     2509                           and utd-lines.doc-id eq idoc-id
     2510      no-lock:
     2511         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2512                          output vMarking         , output vArtic          , output vTransitional).
     2513         for each utd-marking-lines
     2514                     where utd-marking-lines.db-num  = utd-lines.db-num
     2515                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2516                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2517         no-lock:
     2518            if length(utd-marking-lines.mark) < 14
     2519            then do:
     2520               if (vMarking or vArtic) and not vTransitional
     2521               then
     2522                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2523            end.
     2524            else if not isMark(utd-marking-lines.mark)
     2525            then do:
     2526               if vMarking
     2527               then
     2528                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2529            end.
     2530            else do:
     2531            end.
     2532         end.
     2533      end.
     2534   end.
     2535   method public logical WeighedProd
     2536      ( input p-gds-code as integer) :
     2537      define variable v-par-val  as character no-undo.
     2538      define variable v-par-type as character no-undo.
     2539              if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2540               ( p-gds-code,
     2541                 'weighed-gds':U,
