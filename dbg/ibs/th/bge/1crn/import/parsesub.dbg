      536             v-iImpSub  = impkass-bookEventHndlrObj .
      537             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      538             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
