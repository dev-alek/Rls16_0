      616             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      617           end.
      618           when "ordrsp" then do:
      619             if not valid-object(ordrspSubjectObj) then ordrspSubjectObj = new ordrsp ().
      620             if not valid-object(impordrspEventHndlrObj) then do :
      621               impordrspEventHndlrObj = new impordrsp ().
      622             end .
      623             v-iSubject = ordrspSubjectObj .
      624             v-iImpSub  = impordrspEventHndlrObj .
      625             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      626             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      627             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      628           end.
      629           when "ordansw" then do:
      630             if not valid-object(ordanswSubjectObj) then ordanswSubjectObj = new ordansw ().
      631             if not valid-object(impordanswEventHndlrObj) then do :
      632               impordanswEventHndlrObj = new impordansw ().
      633             end .
      634             v-iSubject = ordanswSubjectObj .
      635             v-iImpSub  = impordanswEventHndlrObj .
      636             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      637             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      638             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      639           end.
      640           when "setting" then do:
      641             if not valid-object(settingsSubjectObj) then settingsSubjectObj = new settings ().
