      243     method public void setParent (
      244     input parparentproc   as handle
      245   , input p-parent-handle as handle
      246   , input p-log-handle    as handle
      247     ) :
      248       assign
      249         this-object:parparentproc   = parparentproc
      250         this-object:p-parent-handle = p-parent-handle
      251         this-object:p-log-handle    = p-log-handle
      252       .
      253     end method .
      254     method public logical Parse1CRNSub (input inFileName as character):
      255       define variable result as logical no-undo.
      256       define variable hDoc as handle no-undo.
      257       define variable hRoot as handle no-undo.
      258       create x-document hDoc.
      259       create x-noderef hRoot.
      260       hDoc:load("file",inFileName,false).
      261       hDoc:get-document-element(hRoot).
      262       iNum = 3.
      263       GetChildren(hRoot, 1).
      264       return result.
      265       finally :
      266          delete object hDoc  no-error.
      267          delete object hRoot no-error.
      268       end finally .
      269     end method.
      270     method public logical Parse1CRNSub (input inFileMem as memptr):
      271       define variable result as logical no-undo.
      272       define variable hDoc as handle no-undo.
      273       define variable hRoot as handle no-undo.
      274       create x-document hDoc.
      275       create x-noderef hRoot.
      276       hDoc:load("memptr",inFileMem,false).
      277       hDoc:get-document-element(hRoot).
      278       iNum = 3.
      279       GetChildren(hRoot, 1).
      280       return result.
      281       finally :
      282          delete object hDoc  no-error.
      283          delete object hRoot no-error.
      284       end finally .
      285     end method.
      286     method private void GetChildren (
      287       input hParent as handle,
      288       input level as integer):
      289       define variable i            as integer   no-undo.
      290       define variable hNoderef     as handle    no-undo.
      291       define variable hText        as handle    no-undo.
      292       define variable client       as character no-undo.
      293       define variable v-iSubject   as class ibs.th.bge.1crn.subjects.isubject no-undo .
      294       define variable v-iImpSub    as class ibs.th.bge.1crn.import.iimpsubject no-undo .
      295       create x-noderef hNoderef.
      296       create x-noderef hText .
      297       repeat i = 1 to hParent:num-children:
      298         good = hparent:get-child(hnoderef,i).
      299         if not good then
      300             leave.
      301         if hnoderef:subtype <> "element" then
      302             next.
      303         hnoderef:get-child(htext, 1) no-error .
      304         iNum = iNum + 1.
      305         if hnoderef:child-num = 2
      306         then do:
      307           nameChildrenCurr = hnoderef:name.
      308         end.
      309         case hNoderef:name:
      310           // экземпляр xxxSubjectObj создаётся перед первым импортом
      311           // экземпляр xxxSubjectObj очищается перед началом каждого нового объекта внутри GetChildrenSub()
      312           when "country":U then do:
      313             if not valid-object(countrySubjectObj)       then countrySubjectObj       = new country (). // <country>
      314             if not valid-object(impcountryEventHndlrObj) then impcountryEventHndlrObj = new impcountry () .
      315             v-iSubject = countrySubjectObj .
      316             v-iImpSub  = impcountryEventHndlrObj .
      317             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      318             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      319             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      320           end.
      321           when "org-unit":U then do:
      322             if not valid-object(firmsSubjectObj)       then firmsSubjectObj       = new firms (). // <org-unit>
      323             if not valid-object(impFirmsEventHndlrObj) then impFirmsEventHndlrObj = new impfirms () .
      324             v-iSubject = firmsSubjectObj .
      325             v-iImpSub  = impFirmsEventHndlrObj .
      326             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      327             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      328             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      329           end.
      330           when "good":U then do:
      331             if not valid-object(goodSubjectObj)       then goodSubjectObj         = new goods (). // <good>
      332             if not valid-object(impGoodEventHndlrObj) then do :
      333               impGoodEventHndlrObj = new impgoods () .
      334             end .
      335             v-iSubject = goodSubjectObj .
      336             v-iImpSub  = impGoodEventHndlrObj .
      337             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      338             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      339             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      340           end.
      341           when "recipe":U then do:
      342             if not valid-object(recipeSubjectObj)       then recipeSubjectObj       = new recipe (). // <recipe>
      343             if not valid-object(imprecipeEventHndlrObj) then do :
      344               imprecipeEventHndlrObj = new imprecipe ().
      345               // imprecipeEventHndlrObj:setParent (parparentproc, p-parent-handle, p-log-handle) . - пока не требуется
      346             end .
      347             v-iSubject = recipeSubjectObj .
      348             v-iImpSub  = imprecipeEventHndlrObj .
      349             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      350             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      351             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      352           end.
      353           when "azk":U then do:
      354             if not valid-object(shopsSubjectObj)       then shopsSubjectObj       = new shops (). // <azk>
      355             if not valid-object(impShopsEventHndlrObj) then do :
      356               impShopsEventHndlrObj = new impshops ().
      357               // impShopsEventHndlrObj:setParent (parparentproc, p-parent-handle, p-log-handle) . - пока не требуется
      358             end .
      359             v-iSubject = shopsSubjectObj .
      360             v-iImpSub  = impShopsEventHndlrObj .
      361             // внести new внутрь остальных case, и потом вынести GetChildrenSub и ReceivedSubjectPublish вниз под case
      362             GetChildrenSub (hNoderef, (level + 1), v-iSubject).
      363             ReceivedSubjectPublish(v-iSubject, v-iImpSub).
      364           end.
      365           when "osnovcorr":U then do:
      366             if not valid-object(OsnovCurrSubj)       then OsnovCurrSubj       = new osnovcorr(). // <promotion>
      367             if not valid-object(impOsnocCorr) then do :
      368               impOsnocCorr = new imposnovcorr ().
      369             end .
