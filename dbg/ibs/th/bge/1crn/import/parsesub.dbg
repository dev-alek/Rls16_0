      730           end.
      731         end case.
      732         // --> вставить GetChildrenSub и ReceivedSubjectPublish сюда
      733         // после отработки GetChildrenSub() вызывает GetChildren() и ещё раз просматривает все дочерние элементы сущности верхнего уровня
      734         GetChildren(hNoderef, (level + 1)).
      735         case hNoderef:name:
      736           when "marks":U
      737           then do:
      738             if level < 2 // если загрузка не из в составе edoc
      739             then do:
      740               if valid-object(impmarkEventHndlrObj) then
      741               do:
      742                 impmarkEventHndlrObj:WriteDB().
      743                 delete object impmarkEventHndlrObj.
      744               end.
      745             end.
      746           end.
      747           when "ordansws" then do:
      748             if valid-object(impordanswEventHndlrObj) then
      749             do:
      750               impordanswEventHndlrObj:sendNotification().
      751               delete object impordanswEventHndlrObj.
      752             end.
      753           end.
      754         end case.
      755       end.
      756       catch exAppErrors as class Progress.Lang.AppError :
      757         MsgPrivate = exAppErrors:ReturnValue .
      758         MsgPrivate = exAppErrors:GetMessage(1) .
      759         ErrSts = true.
      760         undo, throw exAppErrors .
      761       end catch .
      762       catch exProErrors as class Progress.Lang.ProError :
      763         MsgPrivate = exProErrors:GetMessage(1) .
      764         ErrSts = true.
      765         undo, throw exProErrors .
      766       end catch .
      767       catch exAnyErrors as class Progress.Lang.Error:
      768         MsgPrivate = "Unexpected error occurred..." .
      769         ErrSts   = true.
      770         undo, throw exAnyErrors .
      771       end catch .
      772       finally :
      773         // если мы зашли внутрь пустого элемента <tag/> - его num-children = 0 и объекты hNoderef и hText не созданы
      774         if valid-object(hNoderef) then delete object hNoderef.
      775         if valid-object(hText)    then delete object hText.
      776       end finally .
      777     end method.
      778     method private void ReceivedSubjectPublish (
      779         input Subject as class ibs.th.bge.1crn.subjects.isubject, input EventHndlrImpSub as class ibs.th.bge.1crn.import.iimpsubject):
      780       ReceivedSubject:Publish(Subject, EventHndlrImpSub).
      781       ibs.th.bge.1crn.import.impmsgs:writeSec(substitute ("Секция &1 элемент № &2", nameChildrenCurr, string (iNum))).
      782       catch exAppErrors as class Progress.Lang.AppError :
      783         MsgPrivate = EventHndlrImpSub:Msg .
      784         MsgPrivate = exAppErrors:GetMessage(1) .
      785         ErrSts = true.
      786         return error.
      787       end catch .
      788       catch exProErrors as class Progress.Lang.ProError :
      789         MsgPrivate = exProErrors:GetMessage(1) .
      790         ErrSts = true.
      791         return error.
      792       end catch .
      793       catch exAnyErrors as class Progress.Lang.Error:
      794         MsgPrivate = "Unexpected error occurred..." .
      795         ErrSts = true.
      796         return error.
      797       end catch .
      798     end method.
      799     method private void GetChildrenSub (
      800       input hParent as handle,
      801       input level as integer, input subjectObj as class isubject):
      802       define variable i            as integer   no-undo.
      803       define variable hNoderef     as handle    no-undo.
      804       define variable hText        as handle    no-undo.
      805       define variable v-need-parse as logical   no-undo .
