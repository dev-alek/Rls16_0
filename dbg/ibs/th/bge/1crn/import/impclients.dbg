        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impclients implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9       define variable v-mode               as character no-undo.
       10       define variable v-rid                as recid     no-undo.
       11       define variable v-retfl              as logical   no-undo .
       12       define variable v-firm-code          as integer   no-undo .
       13       define variable v-grp-code           as integer   no-undo .
       14       define variable v-stts               as integer   no-undo .
       15       define variable v-agnt               as characte  no-undo .
       16       define variable v-e-mail             as character no-undo .
       17       define variable v-okpo               as character no-undo .
       18       define variable v-city               as character no-undo .
       19       define variable v-ind                as character no-undo .
       20       define variable v-addr1              as character no-undo .
       21       define variable v-addr2              as character no-undo .
       22       define variable v-addr3              as character no-undo .
       23       define variable v-addr4              as character no-undo .
       24       define variable v-lim-kr             as decimal   decimals 2 no-undo .
       25       define variable v-ps                 as character no-undo .
       26       define variable v-director           as character no-undo .
       27       define variable v-fax                as character no-undo .
       28       define variable v-given-by           as character no-undo .
       29       define variable v-is-pboul           as logical   no-undo .
       30       define variable v-okonh              as character no-undo .
       31       define variable v-passp-num          as character no-undo .
       32       define variable v-passp-ser          as character no-undo .
       33       define variable v-phone              as character no-undo .
       34       define variable v-phone1-note        as character no-undo .
       35       define variable v-post-city          as character no-undo .
       36       define variable v-post-ind           as integer   no-undo .
       37       define variable v-reg-code           as integer   no-undo .
       38       define variable v-telex              as character no-undo .
       39       define variable v-tobj-code          as integer   no-undo .
       40       define variable v-turnover-buyer     as logical   no-undo .
       41       define variable v-turnover-buyer-gds as logical   no-undo .
       42       define buffer buf_clients      for ub.clients .
       43       define buffer buf_firm         for ub.firm .
       44       define buffer bf_clients       for ub.clients .
       45       define buffer buf_clients-attr for ub.clients-attr .
       46       define variable ii           as integer   no-undo .
       47       define variable jj           as integer   no-undo .
       48       define variable kk           as integer   no-undo .
       49       define variable objImp       as class     clients           no-undo.
       50       define variable v-carrier    as class     clients_carriers  no-undo .
       51       define variable v-supplier   as class     clients_suppliers no-undo .
       52       define variable v_carrier    as class     subjects          no-undo .
       53       define variable v_supplier   as class     subjects          no-undo .
       54       define variable v-attr-value as character no-undo .
       55       objImp = cast (subjectObj, clients).
       56       v_carrier = objImp:nb-carriers .
       57       v_supplier  = objImp:nb-suppliers .
       58       if objImp:del-f > 0 then
       59       do:
       60         Msg = "физическое удаление контрагентов не предусмотрено".
       61         v-retfl = false .
       62         return false .
       63       end .
       64       assign
       65         v-firm-code = integer(objImp:code_)
       66         v-grp-code  = 3
       67         .
       68       find first buf_clients no-lock
       69         where buf_clients.obj-type = 'орг':U
       70         and buf_clients.obj-code = v-firm-code no-error .
       71       if available buf_clients then
       72       do:
       73         if objImp:del-l > 0 and buf_clients.stts = 0 then
       74         do:
       75           run ref/clients2.p
       76             (input ?
       77             ,input recid(buf_clients)
       78             ,input 1
       79             ,input true
       80             ,input no
       81             ,input '':U
       82             ,input '':U
       83             ,input '':U
       84             ) .
       85           v-retfl = true .
       86           return true .
       87         end.
       88         else if (objImp:del-l = 0) and (buf_clients.stts <> 0) then
       89           do:
       90             run ref/clients2.p
       91               (input ?
       92               ,input recid(buf_clients)
       93               ,input 0
       94               ,input true
       95               ,input no
       96               ,input '':U
       97               ,input '':U
       98               ,input '':U
       99               ) .
      100           end.
      101         find first buf_firm no-lock where buf_firm.firm-code = v-firm-code no-error .
      102         if available buf_firm then
      103         do:
      104           sliceAddress
      105             ( input  objImp:leg-adr
      106             , input  buf_firm.addres1
      107             , input  buf_firm.addres2
      108             , output v-addr1
      109             , output v-addr2
      110             ) .
      111           sliceAddress
      112             ( input  objImp:post-adr
      113             , input  buf_firm.post-addr1
      114             , input  buf_firm.post-addr2
      115             , output v-addr3
      116             , output v-addr4
      117             ) .
      118           assign
      119             v-ind         = if objImp:ind    >= "" then objImp:ind    else string(buf_firm.ind)
      120             v-city        = if objImp:city   >= "" then objImp:city   else buf_firm.city
      121             v-agnt        = if objImp:agnt   >= "" then objImp:agnt   else buf_firm.contact-psn
      122             v-e-mail      = if objImp:e-mail >= "" then objImp:e-mail else buf_firm.e-mail
      123             v-okpo        = if objImp:okpo   >= "" then objImp:okpo   else buf_firm.okpo
      124             v-director    = buf_firm.director
      125             v-fax         = buf_firm.fax
      126             v-given-by    = buf_firm.given-by
      127             v-is-pboul    = buf_firm.is-pboul
      128             v-okonh       = buf_firm.okonh
      129             v-passp-num   = buf_firm.passp-num
      130             v-passp-ser   = buf_firm.passp-ser
      131             v-phone       = buf_firm.phone
      132             v-phone1-note = buf_firm.phone1-note
      133             v-post-city   = buf_firm.post-city
      134             v-post-ind    = buf_firm.post-ind
      135             v-telex       = buf_firm.telex
      136             v-tobj-code   = buf_firm.tobj-code
      137             .
      138         end .
      139         else undo, throw new Progress.Lang.AppError(
      140             substitute("Не найдена запись ОРГАНИЗАЦИЯ - [&1] для изменения записи о клиенте [&1]", v-firm-code)
      141             ) .
      142         assign
      143           v-mode               = 'ИЗМЕНЕНИЕ':U
      144           v-rid                = recid(buf_clients)
      145           v-lim-kr             = buf_clients.lim-kr
      146           v-ps                 = buf_clients.PS
      147           v-reg-code           = buf_clients.reg-code
      148           v-turnover-buyer     = buf_clients.turnover-buyer
      149           v-turnover-buyer-gds = buf_clients.turnover-buyer-gds
      150           .
      151       end.
      152       else
      153       do:
      154         assign
      155           v-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U
      156           v-rid  = ?
      157           v-stts = if (objImp:del-l > 0) then objImp:del-l else 0
      158           v-lim-kr    = 0.0
      159           v-ps        = ""
      160           v-city      = if objImp:city   > "" then objImp:city   else ""
      161           v-agnt      = if objImp:agnt   > "" then objImp:agnt   else ""
      162           v-e-mail    = if objImp:e-mail > "" then objImp:e-mail else ""
      163           v-ind       = if objImp:ind    > "" then objImp:ind    else ""
      164           v-okpo      = if objImp:okpo   > "" then objImp:okpo   else ""
      165           v-director  = ""
      166           v-fax       = ""
      167           v-given-by  = ""
      168           v-is-pboul  = false
      169           v-okonh     = ""
      170           v-passp-num = ""
      171           v-passp-ser = ""
      172           v-phone     = ""
      173           v-phone1-note = ""
      174           v-post-city = ""
      175           v-post-ind  = 0
      176           v-reg-code  = 0
      177           v-telex     = ""
      178           v-tobj-code = 0
      179           v-turnover-buyer     = false
      180           v-turnover-buyer-gds = false
      181           .
      182         sliceAddress
      183           ( input  objImp:leg-adr
      184           , input  ""
      185           , input  ""
      186           , output v-addr1
      187           , output v-addr2
      188           ) .
      189         sliceAddress
      190           ( input  objImp:post-adr
      191           , input  ""
      192           , input  ""
      193           , output v-addr3
      194           , output v-addr4
      195           ) .
      196       end .
      197       run ref/firm1.p (
      198         input ?
      199         ,input-output v-rid
      200         ,input v-mode
      201         ,input "discards"
      202         ,input yes
      203         ,input v-firm-code
      204         ,input v-stts
      205         ,input objImp:name_
      206         ,input v-lim-kr
      207         ,input v-ps
      208         ,input v-grp-code
      209         ,input v-addr1
      210         ,input v-addr2
      211         ,input v-city
      212         ,input v-agnt
      213         ,input v-director
      214         ,input v-e-mail
      215         ,input objImp:full-name
      216         ,input v-fax
      217         ,INPUT v-given-by
      218         ,input string(v-ind)
      219         ,input objImp:inn
      220         ,INPUT yes
      221         ,INPUT v-is-pboul
      222         ,input objImp:kpp
      223         ,input v-okonh
      224         ,input v-okpo
      225         ,INPUT v-passp-num
      226         ,INPUT v-passp-ser
      227         ,input v-phone
      228         ,input v-phone1-note
      229         ,input v-addr3
      230         ,input v-addr4
      231         ,input v-post-city
      232         ,input v-post-ind
      233         ,input v-reg-code
      234         ,input v-telex
      235         ,input v-tobj-code
      236         ,input v-turnover-buyer
      237         ,input v-turnover-buyer-gds
      238         ) .
      239       assign
      240         Msg     = ""
      241         v-retfl = true
      242         .
      243       find first bf_clients no-lock where recid(bf_clients) eq v-rid  no-error .
      244       if avail bf_clients
      245       then do:
      246         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      247                                   and clients-attr.obj-code  eq bf_clients.obj-code
      248                                   and clients-attr.attr-code eq 'supp-np':U
      249         exclusive-lock no-error.
      250         if avail clients-attr
      251         then do:
      252            if objImp:post-np eq 1
      253            then
      254               clients-attr.attr-value = "yes".
      255            else
      256               delete clients-attr.
      257         end.
      258         else do:
      259            if objImp:post-np eq 1
      260            then do:
      261               create clients-attr.
      262               assign
      263                  clients-attr.obj-type  = bf_clients.obj-type
      264                  clients-attr.obj-code  = bf_clients.obj-code
      265                  clients-attr.attr-code = 'supp-np':U
      266                  clients-attr.attr-value = "yes"
      267               .
      268            end.
      269         end.
      270         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      271                                   and clients-attr.obj-code  eq bf_clients.obj-code
      272                                   and clients-attr.attr-code eq 'supp-lgas':U
      273         exclusive-lock no-error.
      274         if avail clients-attr
      275         then do:
      276            if objImp:post-sug eq 1
      277            then
      278               clients-attr.attr-value = "yes".
      279            else
      280               delete clients-attr.
      281         end.
      282         else do:
      283            if objImp:post-sug eq 1
      284            then do:
      285               create clients-attr.
      286               assign
      287                  clients-attr.obj-type  = bf_clients.obj-type
      288                  clients-attr.obj-code  = bf_clients.obj-code
      289                  clients-attr.attr-code = 'supp-lgas':U
      290                  clients-attr.attr-value = "yes"
      291               .
      292            end.
      293         end.
      294         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      295                                   and clients-attr.obj-code  eq bf_clients.obj-code
      296                                   and clients-attr.attr-code eq 'own-supp':U
      297         exclusive-lock no-error.
      298         if avail clients-attr
      299         then do:
      300            if objImp:own-post eq 1
      301            then
      302               clients-attr.attr-value = "yes".
      303            else
      304               delete clients-attr.
      305         end.
      306         else do:
      307            if objImp:own-post eq 1
      308            then do:
      309               create clients-attr.
      310               assign
      311                  clients-attr.obj-type  = bf_clients.obj-type
      312                  clients-attr.obj-code  = bf_clients.obj-code
      313                  clients-attr.attr-code = 'own-supp':U
      314                  clients-attr.attr-value = "yes"
      315               .
      316            end.
      317         end.
      318         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      319                                   and clients-attr.obj-code  eq bf_clients.obj-code
      320                                   and clients-attr.attr-code eq 'NPZ':U
      321         exclusive-lock no-error.
      322         if avail clients-attr
      323         then do:
      324            if objImp:post-npz eq 1
      325            then
      326               clients-attr.attr-value = "yes".
      327            else
      328               delete clients-attr.
      329         end.
      330         else do:
      331            if objImp:post-npz eq 1
      332            then do:
      333               create clients-attr.
      334               assign
      335                  clients-attr.obj-type  = bf_clients.obj-type
      336                  clients-attr.obj-code  = bf_clients.obj-code
      337                  clients-attr.attr-code = 'NPZ':U
      338                  clients-attr.attr-value = "yes"
      339               .
      340            end.
      341         end.
      342         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      343                                   and clients-attr.obj-code  eq bf_clients.obj-code
      344                                   and clients-attr.attr-code eq 'code-KSK':U
      345         exclusive-lock no-error.
      346         if trim(objImp:code-KSK) > ""
      347         and objImp:code-KSK <> ?
      348         then do :
      349           if not available clients-attr
      350           then do :
      351             create clients-attr.
      352             assign
      353                clients-attr.obj-type  = bf_clients.obj-type
      354                clients-attr.obj-code  = bf_clients.obj-code
      355                clients-attr.attr-code = 'code-KSK':U
      356             .
      357           end .
      358           clients-attr.attr-value = string(integer(objImp:code-KSK)) no-error .
      359           if error-status:error
      360           then
      361             clients-attr.attr-value = objImp:code-KSK .
      362         end .
      363         else do :
      364           if available clients-attr
      365           then
      366            delete clients-attr.
      367         end .
      368         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      369                                   and clients-attr.obj-code  eq bf_clients.obj-code
      370                                   and clients-attr.attr-code eq 'code-AIS':U
      371         exclusive-lock no-error.
      372         if trim(objImp:code-AIS) > ""
      373         and objImp:code-AIS <> ?
      374         then do :
      375           if not available clients-attr
      376           then do :
      377             create clients-attr.
      378             assign
      379                clients-attr.obj-type  = bf_clients.obj-type
      380                clients-attr.obj-code  = bf_clients.obj-code
      381                clients-attr.attr-code = 'code-AIS':U
      382             .
      383           end .
      384           clients-attr.attr-value = string(integer(objImp:code-AIS)) no-error .
      385           if error-status:error
      386           then
      387             clients-attr.attr-value = objImp:code-AIS .
      388         end .
      389         else do :
      390           if available clients-attr
      391           then
      392            delete clients-attr.
      393         end .
      394         find first clients-attr where clients-attr.obj-type  eq bf_clients.obj-type
      395                                   and clients-attr.obj-code  eq bf_clients.obj-code
      396                                   and clients-attr.attr-code eq 'owner-code':U
      397         exclusive-lock no-error.
      398         if trim(objImp:org-code) > ""
      399         and objImp:org-code <> ?
      400         then do :
      401           if not available clients-attr
      402           then do :
      403             create clients-attr.
      404             assign
      405                clients-attr.obj-type  = bf_clients.obj-type
      406                clients-attr.obj-code  = bf_clients.obj-code
      407                clients-attr.attr-code = 'owner-code':U
      408             .
      409           end .
      410           clients-attr.attr-value = 'орг':U + string(integer(objImp:org-code)) no-error .
      411           if error-status:error
      412           then
      413             clients-attr.attr-value = 'орг':U + objImp:org-code .
      414         end .
      415         else do :
      416           if available clients-attr
      417           then
      418            delete clients-attr.
      419         end .
      420       end.
      421       if valid-object (v_carrier) then
      422       do:
      423         for each buf_clients-attr EXCLUSIVE-LOCK where LOOKUP(('орг':U + string(v-firm-code)),buf_clients-attr.attr-value) > 0:
      424           do kk = 1 to NUM-ENTRIES(buf_clients-attr.attr-value,",") :
      425             if ENTRY (kk,buf_clients-attr.attr-value,",") <> 'орг':U + string(v-firm-code) then
      426             do:
      427               v-attr-value = if v-attr-value = "" then ENTRY (kk,buf_clients-attr.attr-value,",") else "," + ENTRY (kk,buf_clients-attr.attr-value,",") .
      428             end.
      429           end.
      430           buf_clients-attr.attr-value = v-attr-value .
      431         end.
      432         do ii = 1 to v_carrier:Get(ii):
      433           v-carrier = cast(v_carrier:SubjectObjCurr, clients_carriers) .
      434           find first bf_clients no-lock where bf_clients.obj-code = integer(v-carrier:code_) and bf_clients.obj-type = 'орг':U no-error .
      435           if AVAILABLE (bf_clients) then
      436           do:
      437             find first buf_clients-attr EXCLUSIVE-LOCK where buf_clients-attr.attr-code = 'auto-tank-for':U and buf_clients-attr.obj-code = bf_clients.obj-code
      438               and buf_clients-attr.obj-type = bf_clients.obj-type no-error .
      439             if AVAILABLE (buf_clients-attr) then
      440             do:
      441               buf_clients-attr.attr-value = if buf_clients-attr.attr-value <> "" then buf_clients-attr.attr-value + "," + 'орг':U + string(v-firm-code) else 'орг':U + string(v-firm-code) .
      442             end.
      443             else
      444             do:
      445               create buf_clients-attr .
      446               assign
      447                 buf_clients-attr.attr-code  = 'auto-tank-for':U
      448                 buf_clients-attr.obj-code   = bf_clients.obj-code
      449                 buf_clients-attr.obj-type   = bf_clients.obj-type
      450                 buf_clients-attr.attr-value = 'орг':U + string(v-firm-code)
      451                 .
      452             end.
      453           end.
      454           else
      455           do:
      456             Msg = "В справочнике нет клиента с кодом:" + STRING (v-carrier:code_).
      457             return error .
      458           end.
      459         end.
      460       end.
      461       if valid-object (v_supplier) then
      462       do:
      463         find first buf_clients-attr EXCLUSIVE-LOCK where buf_clients-attr.attr-code = 'tank-farm-for':U and buf_clients-attr.obj-code = v-firm-code
      464           and buf_clients-attr.obj-type = 'орг':U no-error .
      465         if AVAILABLE (buf_clients-attr) then
      466         do:
      467           delete buf_clients-attr .
      468         end.
      469         do jj = 1 to v_supplier:Get(jj):
      470           v-supplier = cast(v_supplier:SubjectObjCurr, clients_suppliers) .
      471           find first bf_clients no-lock where bf_clients.obj-code = integer(v-supplier:code_) and bf_clients.obj-type = 'орг':U no-error .
      472           if AVAILABLE (bf_clients) then
      473           do:
      474             find first buf_clients-attr EXCLUSIVE-LOCK where buf_clients-attr.attr-code = 'tank-farm-for':U and buf_clients-attr.obj-code = v-firm-code
      475               and buf_clients-attr.obj-type = 'орг':U no-error .
      476             if AVAILABLE (buf_clients-attr) then
      477             do:
      478               if lookup((bf_clients.obj-type + string(bf_clients.obj-code)), buf_clients-attr.attr-value) = 0 then
      479               buf_clients-attr.attr-value = buf_clients-attr.attr-value + "," + bf_clients.obj-type + string(bf_clients.obj-code) .
      480             end.
      481             else
      482             do:
      483               create buf_clients-attr .
      484               assign
      485                 buf_clients-attr.attr-code  = 'tank-farm-for':U
      486                 buf_clients-attr.obj-code   = v-firm-code
      487                 buf_clients-attr.obj-type   = 'орг':U
      488                 buf_clients-attr.attr-value = bf_clients.obj-type + string(bf_clients.obj-code)
      489                 .
      490             end.
      491           end.
      492           else
      493           do:
      494             Msg = "В справочнике нет клиента с кодом:" + STRING (v-carrier:code_).
      495             return error .
      496           end.
      497         end.
      498       end.
      499       catch exAppErrors as class Progress.Lang.AppError :
      500         Msg = exAppErrors:ReturnValue .
      501         if Msg > "" then .
      502         else
      503         do :
      504           Msg = exAppErrors:GetMessage(1) .
      505           if Msg > "" then .
      506           else Msg = "AppError в контрагентах" .
      507         end .
      508         v-retfl = false .
      509         undo, throw exAppErrors .
      510       end catch .
      511       catch exProErrors as class Progress.Lang.ProError :
      512         Msg = exProErrors:GetMessage(1) .
      513         if Msg > "" then .
      514         else Msg = "ProError в контрагентах" .
      515         v-retfl = false .
      516         undo, throw exProErrors .
      517       end catch .
      518       catch exAnyErrors as class Progress.Lang.Error:
      519         Msg = "Unexpected error в контрагентах" .
      520         v-retfl = false .
      521         undo, throw exAnyErrors .
      522       end catch .
      523       finally :
      524         return v-retfl .
      525       end finally .
      526     end method.
      527     method private void sliceAddress (input p-address   as character,
      528       input p-curraddr1 as character,
      529       input p-curraddr2 as character,
      530       output p-addr1     as character,
      531       output p-addr2     as character) :
      532       if p-address > "" then assign
      533           p-addr1 = substitute(  "&1&2",  substring(p-address,  1, 50),  substring(p-address, 101)  )
      534           p-addr2 = substring(p-address, 51, 50)
      535           .
      536       else if p-address = "" then assign
      537             p-addr1 = ""
      538             p-addr2 = ""
      539             .
      540         else assign
      541             p-addr1 = p-curraddr1
      542             p-addr2 = p-curraddr2
      543             .
      544     end method .
      545   end class.
