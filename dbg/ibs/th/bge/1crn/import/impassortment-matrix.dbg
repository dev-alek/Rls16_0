        1   using Progress.Lang.*.
        2   using ibs.th.gbl.gbl-var.
        3   using ibs.th.bge.1crn.enum-assortment-stg.
        4   using ibs.th.bge.1crn.subjects.*.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.impassortment-matrix implements ibs.th.bge.1crn.import.iimpsubject:
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable objImp       as class assortment-matrix no-undo.
       12       define variable v-retfl      as logical no-undo .
       13       define variable v-gds-code   as integer no-undo .
       14       define variable v-obj-type   as character no-undo .
       15       define variable v-obj-code   as integer no-undo .
       16       define buffer buf_gds-obj-prop for ub.gds-obj-prop .
       17       objImp = cast (subjectObj, assortment-matrix).
       18       assign
       19         v-gds-code = integer(objImp:gds-code)
       20         v-obj-type = 'маг':U
       21       .
       22       if v-gds-code > 0 then . else undo, throw new Progress.Lang.AppError("Не задан код товара") .
       23       v-obj-code = currObjCode (v-obj-type, gbl-var:g#db-num) .
       24       find first buf_gds-obj-prop exclusive-lock
       25            where buf_gds-obj-prop.gds-code = v-gds-code
       26              and buf_gds-obj-prop.obj-type = v-obj-type
       27              and buf_gds-obj-prop.obj-code = v-obj-code no-error .
       28       if locked(buf_gds-obj-prop) then do:
       29         undo, throw new Progress.Lang.AppError(
       30             substitute("Запись о признаках товара [&1] на объекте [&2&3] занята другим пользователем",
       31                        v-gds-code, v-obj-type, v-obj-code)
       32         ) .
       33       end .
       34       if not available buf_gds-obj-prop then do:
       35         define variable v-date1 as date      no-undo .
       36         define variable v-date2 as date      no-undo .
       37         define variable v-time  as integer   no-undo .
       38         assign
       39           v-date1 = today
       40           v-time  = time
       41           v-date2 = today
       42         .
       43         if v-date1 <> v-date2 then assign
       44           v-date1 = today
       45           v-time  = time
       46         .
       47         create buf_gds-obj-prop .
       48         assign
       49           buf_gds-obj-prop.gds-code           = v-gds-code
       50           buf_gds-obj-prop.grop-date-update   = v-date1
       51           buf_gds-obj-prop.grop-time-update   = v-time
       52           buf_gds-obj-prop.grop-db-num-update = gbl-var:g#db-num
       53           buf_gds-obj-prop.grop-who-update    = gbl-var:g#userid
       54           buf_gds-obj-prop.obj-type           = v-obj-type
       55           buf_gds-obj-prop.obj-code           = v-obj-code
       56           buf_gds-obj-prop.gdop-assort-min    = false
       57         .
       58       end .
       59       assign
       60         buf_gds-obj-prop.gdop-igt = mapAssortStage (objImp:stg)
       61         v-retfl = true
       62       .
       63       catch exAppErrors as class Progress.Lang.AppError :
       64         Msg = exAppErrors:ReturnValue .
       65         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
       66         v-retfl = false.
       67         undo, throw exAppErrors .
       68       end catch .
       69       catch exProErrors as class Progress.Lang.ProError :
       70         Msg = exProErrors:GetMessage(1) .
       71         v-retfl = false.
       72         undo, throw exProErrors .
       73       end catch .
       74       catch exAnyErrors as class Progress.Lang.Error:
       75         Msg = "Unexpected error occurred..." .
       76         v-retfl = false.
       77         undo, throw exAnyErrors .
       78       end catch .
       79       finally :
       80         return v-retfl.
       81       end finally .
       82     end method.
       83     method private integer currObjCode (input p-obj-type as character,
       84                                         input p-db-num   as integer) :
       85       define buffer buf_clients for ub.clients .
       86       find first buf_clients no-lock
       87            where buf_clients.db-num   = p-db-num
       88              and buf_clients.obj-type = p-obj-type
       89              and buf_clients.stts     = 0 no-error .
       90       return if available buf_clients then buf_clients.obj-code else 0 .
       91     end method .
       92     method private character mapAssortStage (p-stg as enum-assortment-stg) :
       93       define variable v-th-igt as character no-undo .
       94       case p-stg :
       95         when enum-assortment-stg:enactive     then v-th-igt = 'Основная группа':U .
       96         when enum-assortment-stg:endelay      then v-th-igt = 'Новинка':U .
       97         when enum-assortment-stg:enchange     then v-th-igt = 'Основная группа':U .
       98         when enum-assortment-stg:enwithdrawal then v-th-igt = 'На вывод из ассортимента':U .
       99         when enum-assortment-stg:enarchive    then v-th-igt = 'Пусто':U .
      100         otherwise v-th-igt = 'Пусто':U .
      101       end case .
      102       return v-th-igt .
      103     end method .
      104   end class.
