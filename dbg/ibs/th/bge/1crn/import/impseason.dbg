        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impseason implements ibs.th.bge.1crn.import.iimpsubject:
        6     define property Msg as character no-undo
        7       get.
        8       set.
        9     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       10                   define buffer buf_season for ub.season .
       11                   define buffer buf_gds-season for ub.gds-season .
       12                   define buffer buf_blob-bind for ub.blob-bind .
       13       define variable objSeason as class     season no-undo.
       14       define variable keyrecObj as class keyrec no-undo.
       15       define variable keyrec as character no-undo.
       16       define variable v-dir-name as character no-undo .
       17       define variable v-dir1-name as character no-undo .
       18       define variable v-file-name as character no-undo .
       19       define variable v-param-type as character no-undo .
       20       define variable v-value-character as character no-undo .
       21       define variable v-value-date as date no-undo .
       22       define variable v-value-decimal as decimal no-undo .
       23       define variable v-value-integer as INTEGER no-undo .
       24       define variable v-value-logical AS LOGICAL no-undo .
       25       define variable v-tth as handle no-undo .
       26       define variable v-part-num as integer   no-undo .
       27       define variable v-blob-db-num as integer   no-undo .
       28       define variable v-int64-id as int64 no-undo .
       29       define variable mem1    as memptr no-undo .
       30       define variable v-size  as integer no-undo .
       31       find first ub.clients no-lock where ub.clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
       32                                       and ub.clients.obj-type = 'маг':U
       33                                       and ub.clients.stts = 0  no-error.
       34       if not available ub.clients
       35       then do:
       36         Msg = substitute("Не найден ни один активный магазин для бд &1", ibs.th.gbl.gbl-var:g#db-num ) .
       37         undo, return false .
       38       end.
       39       objSeason = cast (subjectObj, season).
       40       delete object v-tth no-error.
       41       run adm/shattri.p (
       42              input "get":U
       43             ,input ub.clients.obj-type
       44             ,input ub.clients.obj-code
       45             ,input 'gds-ref_obj':U
       46             ,input 'image-dir':U
       47             ,output v-value-character
       48             ,output v-value-date
       49             ,output v-value-decimal
       50             ,output v-value-integer
       51             ,output v-value-logical
       52             ,output v-param-type
       53             ,INPUT-OUTPUT table-handle v-tth
       54             ) no-error .
       55       delete object v-tth no-error.
       56       if trim(v-value-character) > ""
       57       then do :
       58         v-dir1-name = trim(v-value-character, "\") .
       59         v-dir1-name = trim(v-dir1-name, "/") .
       60         v-dir1-name = v-dir1-name + "\" .
       61         v-dir-name = v-dir1-name + "grp\" .
       62       end.
       63       else do :
       64         v-dir1-name = "C:\TB-image\" .
       65         v-dir-name = "C:\TB-image\grp\" .
       66       end.
       67       if objSeason:del-f = 1
       68       or objSeason:del-l = 1
       69       then
       70       do:
       71         find first buf_season where buf_season.sea-code = integer(objSeason:Tbg-code) no-error .
       72         if AVAILABLE buf_season then
       73         do:
       74           for each buf_gds-season no-lock where buf_gds-season.db-num   = buf_season.db-num
       75                                             and buf_gds-season.sea-code = buf_season.sea-code :
       76             v-file-name = v-dir1-name + "gds\" + string(buf_season.sea-code) + ".png" .
       77             os-delete value(v-file-name) no-error .
       78           end.
       79           v-file-name = v-dir-name + string(buf_season.sea-code) + ".png" .
       80           os-delete value(v-file-name) no-error .
       81           delete buf_season .
       82         end.
       83       end.
       84       else
       85       do:
       86         find first buf_season where buf_season.sea-code = integer(objSeason:Tbg-code) no-error .
       87         if AVAILABLE buf_season then
       88         do:
       89           assign
       90             buf_season.sea-name = objSeason:Tb-name
       91             buf_season.sea-month-1 = 0
       92             buf_season.sea-month-2 = 0
       93           .
       94         end.
       95         else
       96         do:
       97           create buf_season .
       98           assign
       99             buf_season.db-num   = gbl-var:g#db-num
      100             buf_season.sea-code = integer(objSeason:Tbg-code)
      101             buf_season.sea-name = objSeason:Tb-name
      102             buf_season.sea-month-1 = 0
      103             buf_season.sea-month-2 = 0
      104           .
      105         end.
      106         if objSeason:Tb-image > ''
      107         then do :
      108           file-info:file-name = v-dir1-name .
      109           if file-info:full-pathname = ?
      110           then do :
      111             os-create-dir value(right-trim(v-dir1-name, "\")) .
      112             if os-error <> 0 then do:
      113               Msg =  substitute("Невозможно создать директорию &1 для изображений",v-dir1-name) .
      114               return false .
      115             end.
      116           end.
      117           file-info:file-name = v-dir-name .
      118           if file-info:full-pathname = ?
      119           then do :
      120             os-create-dir value(right-trim(v-dir-name, "\")) .
      121             if os-error <> 0 then do:
      122               Msg =  substitute("Невозможно создать директорию &1 для изображений",v-dir-name) .
      123               return false .
      124             end.
      125           end.
      126           v-file-name = v-dir-name + string(buf_season.sea-code) + ".png" .
      127           v-size = length(objSeason:Tb-image) .
      128           set-size(mem1) = integer(8 / 6 * v-size) + 1.
      129           mem1 = BASE64-DECODE(objSeason:Tb-image).
      130           copy-lob from mem1 to file v-file-name no-convert no-error .
      131           if error-status:error
      132           then do :
      133             os-delete value(v-file-name) .
      134             if os-error <> 0
      135             then do :
      136               Msg =  substitute("Не могу обновить изображение &1",v-file-name) .
      137               return false .
      138             end.
      139             copy-lob from mem1 to file v-file-name no-convert no-error .
      140             if error-status:error
      141             then do :
      142               Msg =  substitute("Не могу сохранить изображение &1",v-file-name) .
      143               return false .
      144             end.
      145           end .
      146           keyrecObj = new keyrec ().
      147           keyrecObj:GenKeyRec('season':U, buffer buf_season:handle, output keyrec).
      148           delete object keyrecObj.
      149           find first buf_blob-bind exclusive-lock where buf_blob-bind.uniq-key-rec = keyrec
      150                                                     and buf_blob-bind.field-name_  = 'collec-image':U
      151                                                     no-error .
      152           if available buf_blob-bind
      153           then do :
      154             v-blob-db-num = buf_blob-bind.db-num .
      155             v-int64-id = buf_blob-bind.int64-id .
      156             v-part-num = buf_blob-bind.part-num .
      157             run gbl/file2blb.p ( input 'ИЗМЕНЕНИЕ':U
      158                                 ,input  "override"
      159                                 ,input (buffer buf_season:handle)
      160                                 ,input keyrec
      161                                 ,input 'collec-image':U
      162                                 ,input 'collec-image':U
      163                                 ,input-output v-part-num
      164                                 ,input 'data':U
      165                                 ,input-output v-blob-db-num
      166                                 ,input-output v-int64-id
      167                                 ,input v-file-name
      168                                 ) no-error .
      169             if error-status :error then do:
      170               Msg = substitute("Не могу обновить изображение &1 в базe",v-file-name) .
      171               return false .
      172             end.
      173           end.
      174           else do :
      175             v-blob-db-num = ? .
      176             v-int64-id = 0 .
      177             run gbl/file2blb.p ( input 'ДОБАВЛЕНИЕ':U
      178                                 ,input  "yes"
      179                                 ,input (buffer buf_season:handle)
      180                                 ,input keyrec
      181                                 ,input 'collec-image':U
      182                                 ,input 'collec-image':U
      183                                 ,input-output v-part-num
      184                                 ,input 'data':U
      185                                 ,input-output v-blob-db-num
      186                                 ,input-output v-int64-id
      187                                 ,input v-file-name
      188                                 ) no-error .
      189             if error-status :error then do:
      190               Msg = substitute("Не могу сохранить изображение &1 в базу",v-file-name) .
      191               return false .
      192             end.
      193           end.
      194         end .
      195       end.
      196       return true.
      197     end method.
      198   end class.
