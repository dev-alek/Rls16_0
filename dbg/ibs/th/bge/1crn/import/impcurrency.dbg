        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impcurrency implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9       def    var      v-rec       as recid   no-undo .
       10       def    var      v-curr-code as integer no-undo .
       11       define variable objCurrency as class   currency no-undo.
       12       objCurrency = cast (subjectObj, currency).
       13       if objCurrency:del-f = 1 then
       14       do:
       15         find first ub.currency where ub.currency.okv-code = integer(objCurrency:code_) no-error .
       16         if AVAILABLE ub.currency then
       17         do:
       18           delete ub.currency .
       19         end.
       20       end.
       21       else
       22       do:
       23         find first ub.currency where ub.currency.okv-code = integer(objCurrency:code_) no-error .
       24         if AVAILABLE ub.currency then
       25         do:
       26           v-rec = recid(ub.currency) .
       27           run ref/currenc1.p (
       28             input-output v-rec
       29             ,input 'хглемемхе':U
       30             ,input true
       31             ,input ub.currency.curr-code
       32             ,input ub.currency.curr-abbr
       33             ,input ub.currency.part-abbr
       34             ,input objCurrency:name_
       35             ,input objCurrency:name-in-words-1
       36             ,input objCurrency:name-in-words-2
       37             ,input objCurrency:name-in-words-3
       38             ,input ub.currency.curr-eng-name
       39             ,input ub.currency.curr-eng-name-one
       40             ,input ub.currency.curr-eng-name-three
       41             ,input ub.currency.curr-eng-name-five
       42             ,input ub.currency.part-name
       43             ,input objCurrency:name-in-words-4
       44             ,input objCurrency:name-in-words-5
       45             ,input objCurrency:name-in-words-6
       46             ,input objCurrency:code_
       47             ,input ""
       48             ) no-error .
       49           if error-status:error then
       50           do:
       51             Msg = return-value.
       52             return false.
       53           end.
       54         end.
       55         else
       56         do:
       57           find last ub.currency no-error .
       58           if AVAILABLE ub.currency then
       59           do:
       60             v-curr-code = ub.currency.curr-code + 1 .
       61           end.
       62           else
       63           do:
       64             v-curr-code = 0 .
       65           end.
       66             v-rec = ?.
       67           run ref/currenc1.p (
       68             input-output v-rec
       69             ,input 'днаюбкемхе':U
       70             ,input true
       71             ,input v-curr-code
       72             ,input objCurrency:sym-name
       73             ,input ""
       74             ,input objCurrency:name_
       75             ,input objCurrency:name-in-words-1
       76             ,input objCurrency:name-in-words-2
       77             ,input objCurrency:name-in-words-3
       78             ,input ""
       79             ,input ""
       80             ,input ""
       81             ,input ""
       82             ,input ""
       83             ,input objCurrency:name-in-words-4
       84             ,input objCurrency:name-in-words-5
       85             ,input objCurrency:name-in-words-6
       86             ,input objCurrency:code_
       87             ,input ""
       88             ) no-error .
       89           if error-status:error then
       90           do:
       91             Msg = return-value.
       92             return false.
       93           end.
       94         end.
       95         return true.
       96       end.
       97     end method.
       98   end class.
