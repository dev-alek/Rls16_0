        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.imppermissible-deviation implements ibs.th.bge.1crn.import.iimpsubject:
        6     define buffer buf_shift-param for ub.shift-param .
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable ri           as recid no-undo .
       12       define variable permissible as class permissible-deviations no-undo.
       13       define buffer buf_clients for ub.clients .
       14       find first ub.sys-ctrl no-lock.
       15       find first buf_clients where buf_clients.db-num = ub.sys-ctrl.db-num.
       16       permissible = cast (subjectObj, permissible-deviations).
       17       if permissible:code_ = 0 or permissible:code_ = ? then
       18       do:
       19         Msg = "Код интеграции допустимого отклонения не задано".
       20         return error Msg .
       21       end.
       22       if permissible:name_ = "" or permissible:name_ = ? then
       23       do:
       24         Msg = "Наименование допустимого отклонения с кодом " + string(permissible:code_) + ". Не задано название" .
       25         return error Msg .
       26       end.
       27         find first buf_shift-param exclusive-lock where
       28         buf_shift-param.obj-code = 0 and
       29         buf_shift-param.obj-type = "" and
       30         buf_shift-param.shift-date = 01.01.1900  no-error .
       31         if not available (buf_shift-param) then do:
       32           create buf_shift-param .
       33           assign
       34           buf_shift-param.obj-code = 0
       35           buf_shift-param.obj-type = ""
       36           buf_shift-param.shift-date = 01.01.1900
       37           .
       38         end.
       39         else do:
       40             find last ub.shift-obj no-lock where ub.shift-obj.obj-code = buf_clients.obj-code and
       41             ub.shift-obj.obj-type = buf_clients.obj-type and
       42             ub.shift-obj.status_ = "ТЕК" no-error .
       43             if available (ub.shift-obj) then do:
       44             find first ub.shift-param exclusive-lock where ub.shift-param.obj-code = ub.shift-obj.obj-code and
       45             ub.shift-param.obj-type = ub.shift-obj.obj-type and
       46             ub.shift-param.shift-date = ub.shift-obj.shift-date and
       47             ub.shift-param.shift-num = ub.shift-obj.shift-num no-error .
       48             if not available (ub.shift-param) then do:
       49                 create ub.shift-param .
       50                 assign
       51                 ub.shift-param.obj-code = ub.shift-obj.obj-code
       52                 ub.shift-param.obj-type = ub.shift-obj.obj-type
       53                 ub.shift-param.shift-date = ub.shift-obj.shift-date
       54                 ub.shift-param.shift-num = ub.shift-obj.shift-num
       55                 ub.shift-param.shift-name = ub.shift-obj.shift-name
       56                 ub.shift-param.dev-paid-trans = buf_shift-param.dev-paid-trans
       57                 ub.shift-param.prc-dev-mass = buf_shift-param.prc-dev-mass
       58                 .
       59             end.
       60             end.
       61         end.
       62         case permissible:code_:
       63          when 1 then buf_shift-param.prc-dev-mass = decimal(permissible:value_) .
       64          when 2 then buf_shift-param.dev-paid-trans = decimal(permissible:value_) .
       65         end.
       66     end method.
       67   end class.
