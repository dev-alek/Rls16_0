        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.imppayment-type-group implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9       def var v-rec  as recid     no-undo .
       10       def var v-mode as character no-undo .
       11       define variable objPaymentTypeGroup as class payment-type-group no-undo.
       12       objPaymentTypeGroup = cast (subjectObj, payment-type-group).
       13                   if objPaymentTypeGroup:del-f = 1 then do:
       14                     Msg = "Физическое удаление в базе не реализовано".
       15                   end.
       16                   else do:
       17         find first ub.pay-type where ub.pay-type.obj-code = integer(objPaymentTypeGroup:code_) no-error .
       18         if AVAILABLE ub.pay-type then do:
       19           assign
       20             v-mode = 'ИЗМЕНЕНИЕ':U
       21             v-rec = recid (ub.pay-type)
       22             .
       23         end.
       24         else do:
       25           assign
       26             v-mode = 'ДОБАВЛЕНИЕ':U
       27             v-rec = ?
       28           .
       29         end.
       30      run ref/paytype1.p
       31        ( input-output v-rec
       32        , input v-mode
       33        , input yes
       34        , input objPaymentTypeGroup:code_
       35        , input objPaymentTypeGroup:name_
       36        ) no-error.
       37           if error-status:error then do:
       38             Msg = return-value.
       39             return false.
       40           end.
       41                   return true.
       42       end.
       43           end method.
       44   end class.
