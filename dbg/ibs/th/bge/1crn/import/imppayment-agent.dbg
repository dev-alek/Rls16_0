        1   using ibs.th.bge.1crn.subjects.subjects.
        2   using ibs.th.bge.1crn.subjects.payment-agent.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.imppayment-agent implements ibs.th.bge.1crn.import.iimpsubject:
        5     define private temp-table tt-gds no-undo
        6       field gds-code as integer
        7     .
        8     define private temp-table tt-operserv no-undo like ub.OperServ .
        9     define property Msg as character no-undo
       10       get.
       11       set.
       12     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       13       define variable objImp    as class payment-agent no-undo.
       14       define variable v-retfl   as logical no-undo .
       15       define variable v-mode    as character no-undo.
       16       define variable v-pay-agent as class ibs.th.bge.1crn.subjects.payment-agent no-undo .
       17       define variable v-code      as character no-undo .
       18       define variable v-name      as character no-undo .
       19       define variable v-operservid as int64 no-undo .
       20       define variable v-commentrytype as integer no-undo .
       21       define variable v-objlist   as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:kb-gds[]
       22       define variable v-i-counter as integer no-undo .
       23       define variable v-i-num     as integer no-undo .
       24       define variable v-stub      as integer no-undo .
       25       define variable v-gds-gd    as class ibs.th.bge.1crn.subjects.kass-book-gd no-undo .
       26       define variable v-gds-code  as integer no-undo .
       27       define variable v-str-ossid as character no-undo .
       28       define buffer buf_OperServ   for ub.OperServ .
       29       define buffer buf_goods      for ub.goods .
       30       define buffer buf_goods-attr for ub.goods-attr .
       31       Msg        = "":U .
       32       objImp = cast (subjectObj, payment-agent).
       33       v-pay-agent = objImp .
       34       v-code = v-pay-agent:code_ .
       35       v-name = v-pay-agent:name_ .
       36     do :
       37       if (v-pay-agent:sign-pa = 1) or (v-pay-agent:sign-pa = 2) or
       38          (v-pay-agent:sign-pa = 4) or (v-pay-agent:sign-pa = 8) or
       39          (v-pay-agent:sign-pa = 16) or (v-pay-agent:sign-pa = 32) or
       40          (v-pay-agent:sign-pa = 64) then .
       41       else undo, throw new Progress.Lang.AppError( substitute(
       42           "Признак агента [&1] для платёжного агента [&2 &3] может принимать только значения значения: " +
       43           "1-Банковский платежный агент, 2-Банковский платежный субагент, 4-Платежный агент, " +
       44           "8-Платежный субагент, 16-Поверенный пользователь, 32-Комиссионер, 64-Агент, не явл. никем из перечисленных"
       45           , v-pay-agent:sign-pa, v-code, v-name
       46       ) ) .
       47       if (v-pay-agent:sign-pa-subj = 1) or (v-pay-agent:sign-pa-subj = 2) or
       48          (v-pay-agent:sign-pa-subj = 4) or (v-pay-agent:sign-pa-subj = 8) or
       49          (v-pay-agent:sign-pa-subj = 16) or (v-pay-agent:sign-pa-subj = 32) or
       50          (v-pay-agent:sign-pa-subj = 64) then .
       51       else undo, throw new Progress.Lang.AppError( substitute(
       52           "Признак агента по предмету расчета [&1] для платёжного агента [&2 &3] может принимать только значения значения: " +
       53           "1-Банковский платежный агент, 2-Банковский платежный субагент, 4-Платежный агент, " +
       54           "8-Платежный субагент, 16-Поверенный пользователь, 32-Комиссионер, 64-Агент, не явл. никем из перечисленных"
       55           , v-pay-agent:sign-pa-subj, v-code, v-name
       56       ) ) .
       57       if (v-pay-agent:type-calc-repl = 1) or (v-pay-agent:type-calc-repl = 4) or
       58          (v-pay-agent:type-calc-repl = 5) then .
       59       else undo, throw new Progress.Lang.AppError( substitute(
       60           "Тип расчета с опер.пополн. [&1] для платёжного агента [&2 &3] может принимать только значения: " +
       61           "1-Оплата Сотовой связи, 4-Начисление на карту, 5-Платежный агент"
       62           , v-pay-agent:type-calc-repl, v-code, v-name
       63       ) ) .
       64       v-commentrytype = integer(v-pay-agent:comm-entry-type) no-error .
       65       if v-commentrytype > 0 then do :
       66         if (v-commentrytype = 1) then .
       67         else undo, throw new Progress.Lang.AppError( substitute(
       68             "Тип ввода комиссии [&1] для платёжного агента [&2 &3] может принимать только значения: " +
       69             "0–процент, 1–сумма"
       70           , v-pay-agent:comm-entry-type, v-code, v-name
       71         ) ) .
       72       end .
       73     end .
       74       empty temp-table tt-operserv .
       75       find first buf_OperServ exclusive-lock
       76            where buf_OperServ.ext-code = v-code no-error .
       77       if available buf_OperServ then do :
       78         v-mode = 'ИЗМЕНЕНИЕ':U .
       79         create tt-operserv .
       80         buffer-copy buf_OperServ to tt-operserv .
       81       end .
       82       else do :
       83         create tt-operserv .
       84         assign
       85           v-mode = 'ДОБАВЛЕНИЕ':U
       86           tt-operserv.id       = next-value (s-operserv-id)
       87           tt-operserv.ext-code = v-code
       88         .
       89       end .
       90       assign
       91         v-operservid = tt-operserv.id
       92    tt-operserv.OSname    = v-name
       93    tt-operserv.SummMin   = v-pay-agent:min-sum     when v-pay-agent:min-sum <> ?
       94    tt-operserv.SummMax   = v-pay-agent:max-sum
       95    tt-operserv.SummAtent = v-pay-agent:warning-sum when v-pay-agent:warning-sum <> ?
       96       .
       97       if v-commentrytype <> ? then do :
       98         case v-commentrytype:
       99           when 0 then tt-operserv.CommType = 5 .
      100           when 1 then tt-operserv.CommType = 4 .
      101           otherwise .
      102         end case .
      103         if v-pay-agent:value-comm <> ? then case v-commentrytype :
      104           when 0 then assign
      105    tt-operserv.CommPerc  = v-pay-agent:value-comm
      106           .
      107           when 1 then assign
      108    tt-operserv.CommSumm  = v-pay-agent:value-comm
      109           .
      110           otherwise .
      111         end case .
      112       end .
      113       assign
      114    tt-operserv.gds-code  = v-pay-agent:gds-comm when v-pay-agent:gds-comm <> ?
      115    tt-operserv.PreAAvt   = (v-pay-agent:auth-req > 0)    when v-pay-agent:auth-req <> ?
      116    tt-operserv.PreSlip   = (v-pay-agent:prt-slp-req > 0) when v-pay-agent:prt-slp-req <> ?
      117    tt-operserv.SlipName  = v-pay-agent:name-slp          when v-pay-agent:name-slp <> ?
      118    tt-operserv.CalcType  = v-pay-agent:type-calc-repl
      119    tt-operserv.OperAddr  = v-pay-agent:adr-trans-op
      120    tt-operserv.OperInn   = v-pay-agent:inn-trans-op
      121    tt-operserv.OperName  = v-pay-agent:name-trans-op
      122    tt-operserv.AgentFlag = v-pay-agent:sign-pa
      123    tt-operserv.AgentTel  = v-pay-agent:tel-pa
      124    tt-operserv.OperTel   = v-pay-agent:tel-acceptor
      125    tt-operserv.AgentFlagRasch = v-pay-agent:sign-pa-subj
      126    tt-operserv.InnSupp   = v-pay-agent:inn-prov    when v-pay-agent:inn-prov <> ?
      127    tt-operserv.OperTelTran    = v-pay-agent:tel-trans-op
      128    tt-operserv.AgentOpere     = v-pay-agent:oper-pa
      129    tt-operserv.SuppTel   = v-pay-agent:tel-prov    when v-pay-agent:tel-prov <> ?
      130    tt-operserv.SuppName  = v-pay-agent:name-prov   when v-pay-agent:name-prov <> ?
      131    tt-operserv.QuantMax  = v-pay-agent:max-num     when v-pay-agent:max-num <> ?
      132    tt-operserv.QuantMin  = v-pay-agent:min-num     when v-pay-agent:min-num <> ?
      133    tt-operserv.OsType    = v-pay-agent:oper-type   when v-pay-agent:oper-type <> ?
      134       .
      135         if tt-operserv.CalcType eq 1
      136         then
      137            tt-operserv.OsType = 1.
      138         else if tt-operserv.CalcType eq 4
      139         then
      140            tt-operserv.OsType = 3.
      141       if available buf_OperServ then do :
      142         buffer-copy tt-operserv to buf_OperServ .
      143       end .
      144       else do :
      145         create buf_OperServ .
      146         buffer-copy tt-operserv to buf_OperServ .
      147       end .
      148           empty temp-table tt-gds .
      149       v-objlist = objImp:kb-gds .
      150       if valid-object(v-objlist) then do :
      151         v-i-counter = v-objlist:iCounter .
      152         do v-i-num = 1 to v-i-counter :
      153           v-stub = v-objlist:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      154           v-gds-gd = cast(v-objlist:SubjectObjCurr, ibs.th.bge.1crn.subjects.kass-book-gd) .
      155           v-gds-code = integer(v-gds-gd:gd-code) .
      156           if not can-find (first buf_goods where buf_goods.gds-code = v-gds-code) then
      157             undo, throw new Progress.Lang.AppError( substitute(
      158               "Код товара [&1] платёжного агента [&2 &3] отсутствует в справочнике товаров."
      159               , v-gds-code, v-code, v-name
      160           ) ) .
      161           create tt-gds.
      162           tt-gds.gds-code = v-gds-code .
      163         end . // end_of_objImp:gds[]
      164         v-str-ossid = string(v-operservid) no-error .
      165         if v-mode = 'ИЗМЕНЕНИЕ':U then do :
      166           for each buf_goods-attr exclusive-lock
      167              where buf_goods-attr.attr-code  = 'oper-serv-idd':U
      168                and buf_goods-attr.attr-value = v-str-ossid :
      169             if not can-find (first tt-gds where tt-gds.gds-code = buf_goods-attr.gds-code) then
      170               delete buf_goods-attr.
      171           end .
      172         end .
      173         for each tt-gds :
      174           find first buf_goods-attr exclusive-lock
      175                where buf_goods-attr.gds-code  = tt-gds.gds-code
      176                  and buf_goods-attr.attr-code = 'oper-serv-idd':U no-error .
      177           if available buf_goods-attr then assign
      178             buf_goods-attr.attr-value = v-str-ossid when (buf_goods-attr.attr-value <> v-str-ossid)
      179           .
      180           else do:
      181             create buf_goods-attr .
      182             assign
      183               buf_goods-attr.gds-code   = tt-gds.gds-code
      184               buf_goods-attr.attr-code  = 'oper-serv-idd':U
      185               buf_goods-attr.attr-value = v-str-ossid
      186             .
      187           end.
      188         end .
      189       end. // end_of_gds
      190       v-retfl = true.
      191       define variable i as integer no-undo .
      192       catch exAppErrors as class Progress.Lang.AppError :
      193         Msg = exAppErrors:ReturnValue .
      194         if Msg > "" then . else do :
      195           do i = 1 to exAppErrors:NumMessages :
      196             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
      197           end .
      198           if Msg > "" then . else Msg = "AppError в платёжных агентах" .
      199         end .
      200         v-retfl = false .
      201         undo, throw exAppErrors .
      202       end catch .
      203       catch exProErrors as class Progress.Lang.ProError :
      204         do i = 1 to exProErrors:NumMessages :
      205           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
      206         end .
      207         if Msg > "" then . else Msg = "ProError в платёжных агентах" .
      208         v-retfl = false.
      209         undo, throw exProErrors .
      210       end catch .
      211       catch exAnyErrors as class Progress.Lang.Error:
      212         Msg = "Unexpected error в платёжных агентах" .
      213         v-retfl = false .
      214         undo, throw exAnyErrors .
      215       end catch .
      216       finally :
      217         return v-retfl .
      218       end finally .
      219     end method.
      220   end class.
