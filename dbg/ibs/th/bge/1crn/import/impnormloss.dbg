        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.bge.1crn.import.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impnormloss implements ibs.th.bge.1crn.import.iimpsubject:
        6     define buffer buf_norm-loss for ub.norm-loss.
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable result      as logical no-undo.
       12       define variable objNormLoss as class   normloss no-undo.
       13       define variable ii          as integer no-undo .
       14       objNormLoss = cast (subjectObj, normloss).
       15       find first buf_norm-loss where buf_norm-loss.type = integer (objNormLoss:type_) and
       16         buf_norm-loss.clim-grp = objNormLoss:clim-grp and buf_norm-loss.sec-vol1 = objNormLoss:sec-vol1 and buf_norm-loss.sec-vol2 = objNormLoss:sec-vol2 and buf_norm-loss.oil-grp    = objNormLoss:oil-grp
       17         and buf_norm-loss.position   = string(objNormLoss:position_) and buf_norm-loss.season     = objNormLoss:season_ no-error.
       18       if available (buf_norm-loss)
