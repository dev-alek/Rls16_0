       20       do:
       21         assign
       22           buf_norm-loss.oil-grp    = objNormLoss:oil-grp
       23           buf_norm-loss.position   = string(objNormLoss:position_)
       24           buf_norm-loss.season     = objNormLoss:season_
       25           buf_norm-loss.sec-vol1    = objNormLoss:sec-vol1
       26           buf_norm-loss.sec-vol2    = objNormLoss:sec-vol2
       27           buf_norm-loss.value-loss = objNormLoss:value_
       28           .
       29       end.
       30       else
       31       do:
       32         create ub.norm-loss .
       33         assign
       34           ub.norm-loss.id         = next-value( s-norm-loss , ub )
       35           ub.norm-loss.type       = objNormLoss:type_
       36           ub.norm-loss.clim-grp   = objNormLoss:clim-grp
       37           ub.norm-loss.oil-grp    = objNormLoss:oil-grp
       38           ub.norm-loss.position   = string(objNormLoss:position_)
       39           ub.norm-loss.season     = objNormLoss:season_
       40           ub.norm-loss.sec-vol1   = objNormLoss:sec-vol1
       41           ub.norm-loss.sec-vol2   = objNormLoss:sec-vol2
       42           ub.norm-loss.value-loss = objNormLoss:value_
       43           .
