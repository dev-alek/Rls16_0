        1   using Progress.Lang.*.
        2   using ibs.th.str.utd.sts.*.
        3   using ibs.th.str.marking.sts.*.
        4   using ibs.th.gbl.sys.objth.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.impmsgs:
        7       define public property vss-revision    as character no-undo init "$Revision:$":U get .
        8       define public property vss-author      as character no-undo init "$Author:$":U get.
        9       define public property vss-date        as character no-undo init "$Date:$":U get.
       10       define public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11       define public property vss-archive     as character no-undo init "$Archive:$":U get.
       12       define public property vss-description as character no-undo init "Статусы электронных документов" get.
       13     define static private temp-table msgs no-undo
       14        field msg as character
       15        field sec as character
       16        field err as character
       17     .
       18     constructor static impmsgs (  ):
       19     end constructor.
       20     method public static void writeMsg( iMsg as character, iErr as character ):
       21         create msgs.
       22         assign
       23           msgs.msg = iMsg
       24           msgs.err = iErr
       25         .
       26     end method.
       27     method public static void writeSec( iSec as character ):
       28         for each msgs where msgs.sec = "":
       29           msgs.sec = iSec.
       30         end.
       31     end method.
       32     method public static void clearMsg():
       33         empty temp-table msgs.
       34     end method.
       35     method public static void writeError2Db(
       36       iEsysId as integer,
       37       iDbNum as integer,
       38       iCrDbNum as integer,
       39       iPackNum as integer
       40       ):
       41       define variable vCount as integer no-undo.
       42       define buffer esys-pck-rcvd-err for ub.esys-pck-rcvd-err.
       43       for each msgs:
       44         create esys-pck-rcvd-err.
       45         assign
       46           vCount = vCount + 1
       47           esys-pck-rcvd-err.esys-id        = iEsysId
       48           esys-pck-rcvd-err.db-num         = iDbNum
       49           esys-pck-rcvd-err.espr-cr-db-num = iCrDbNum
       50           esys-pck-rcvd-err.espr-pack-num  = iPackNum
       51           esys-pck-rcvd-err.num            = vCount
       52           esys-pck-rcvd-err.msg            = msgs.msg
       53           esys-pck-rcvd-err.section        = msgs.sec
       54           esys-pck-rcvd-err.error          = msgs.err
       55         .
       56       end.
       57     end method.
       58   end class.
