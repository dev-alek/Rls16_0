        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.enum-deg-auto.
        3   using ibs.th.bge.1crn.enum-dnst-ms-type.
        4   using ibs.th.bge.1crn.enum-level-ms-type.
        5   using ibs.th.bge.1crn.subjects.*.
        6   block-level on error undo, throw.
        7   class ibs.th.bge.1crn.import.impmeasuring implements ibs.th.bge.1crn.import.iimpsubject:
        8     define property Msg as character no-undo
        9       get.
       10       set.
       11     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       12       define variable objImp       as class measuring no-undo.
       13       define variable v-retfl      as logical no-undo .
       14       define variable v-ms-code    as integer no-undo .
       15       define buffer buf_sr-izmerenia for ub.sr-izmerenia .
       16       objImp = cast (subjectObj, measuring).
       17       assign
       18         v-ms-code = integer(objImp:code_)
       19       .
       20       if v-ms-code > 0 then . else undo, throw new Progress.Lang.AppError("Не задан код средства измерения") .
       21       if objImp:del-f > 0 then do:
       22         run ref/sr-izm03.p ( input v-ms-code ) .
       23       end .
       24       else do:
       25         run ref/sr-izm01.p
       26         (input v-ms-code
       27         ,input mapDegAuto (objImp:deg-auto)
       28         ,input objImp:name_
       29         ,input objImp:dimension-level
       30         ,input objImp:dimension-temp
       31         ,input objImp:dimension-dnst
       32         ,input objImp:dimension-wght
       33         ,input mapLevelMsType (objImp:level-ms-type)
       34         ,input mapDnstMsType (objImp:dnst-ms-type)
       35         ,input objImp:level-abs-me
       36         ,input objImp:level-rel-me-np
       37         ,input objImp:level-abs-me-wtr
       38         ,input objImp:level-rel-me-wtr
       39         ,input objImp:dnst-abs-me-np
       40         ,input objImp:temp-abs-me-vlm
       41         ,input objImp:temp-abs-me-dnst
       42         ,input objImp:dnst-rel-me-np
       43         ,input objImp:dnst-abs-me-lpg-l
       44         ,input objImp:dnst-rel-me-lpg-l
       45         ,input objImp:dnst-abs-me-lpg-v
       46         ,input objImp:wght-rel-me
       47         ,input objImp:level-tk
       48         ,input objImp:del-l
       49         ) .
       50       end .
       51       assign
       52         Msg = "":U
       53         v-retfl = true
       54       .
       55       catch exAppErrors as class Progress.Lang.AppError :
       56         Msg = exAppErrors:ReturnValue .
       57         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
       58         v-retfl = false.
       59         undo, throw exAppErrors .
       60       end catch .
       61       catch exProErrors as class Progress.Lang.ProError :
       62         Msg = exProErrors:GetMessage(1) .
       63         v-retfl = false.
       64         undo, throw exProErrors .
       65       end catch .
       66       catch exAnyErrors as class Progress.Lang.Error:
       67         Msg = "Unexpected error occurred..." .
       68         v-retfl = false.
       69         undo, throw exAnyErrors .
       70       end catch .
       71       finally :
       72         return v-retfl.
       73       end finally .
       74     end method.
       75     method private integer mapDnstMsType (p-ms-type as enum-dnst-ms-type) :
       76       define variable v-ms-type as integer no-undo .
       77       case p-ms-type :
       78         when enum-dnst-ms-type:enare15     then v-ms-type = 1 .
       79         when enum-dnst-ms-type:enare20     then v-ms-type = 2 .
       80         when enum-dnst-ms-type:endensflow  then v-ms-type = 3 .
       81         when enum-dnst-ms-type:endenssubm  then v-ms-type = 4 .
       82         when enum-dnst-ms-type:enchannelfl then v-ms-type = 5 .
       83         when enum-dnst-ms-type:enchannelno then v-ms-type = 6 .
       84         otherwise v-ms-type = 1 .
       85       end case .
       86       return v-ms-type .
       87     end method .
       88     method private integer mapDegAuto (p-deg-auto as enum-deg-auto) :
       89       define variable v-deg-auto as integer no-undo .
       90       case p-deg-auto :
       91         when enum-deg-auto:enautoms         then v-deg-auto = 0 .
       92         when enum-deg-auto:ennonautomatedms then v-deg-auto = 1 .
       93         when enum-deg-auto:enmssys          then v-deg-auto = 2 .
       94         otherwise v-deg-auto = 0 .
       95       end case .
       96       return v-deg-auto .
       97     end method .
       98     method private integer mapLevelMsType (p-level-ms-type as enum-level-ms-type) :
       99       define variable v-level-ms-type as integer no-undo .
      100       case p-level-ms-type :
      101         when enum-level-ms-type:enstatic            then v-level-ms-type = 0 .
      102         when enum-level-ms-type:enroulette2class    then v-level-ms-type = 1 .
      103         when enum-level-ms-type:endensitylevelmeter then v-level-ms-type = 2 .
      104         otherwise v-level-ms-type = 0 .
      105       end case .
      106       return v-level-ms-type .
      107     end method .
      108   end class.
