        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.ref.cpattr FROM PROPATH.
        4   USING ibs.th.gbl.getcntxt FROM PROPATH.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.imppayment-type implements ibs.th.bge.1crn.import.iimpsubject:
        7     define variable cpattr   as class cpattr   no-undo .
        8     define variable getcntxt as class getcntxt no-undo .
        9     define property Msg as character no-undo
       10       get.
       11       set.
       12     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       13       define var v-rec         as recid         no-undo .
       14       define var parparentproc as widget-handle no-undo .
       15       define var v-delete      as logical       no-undo .
       16       define var v-dop-doc     as character     no-undo .
       17       define var v-name        as character     no-undo .
       18       define var v-ptg-code    as integer       no-undo .
       19       define var v-mode        as character     no-undo .
       20       define var v-status      as character     no-undo .
       21       define var v-is-cash     as LOGICAL       no-undo .
       22       define var v-atr1        as LOGICAL       no-undo .
       23       define var v-has-return  as integer       no-undo .
       24       define var v-can-mix     as integer       no-undo .
       25       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
       26       define variable objPaymentType as class payment-type no-undo.
       27       cpattr = new cpattr ().
       28       objPaymentType = cast (subjectObj, payment-type).
       29       if objPaymentType:del-f = 1 then
       30       do:
       31         find first ub.cash-pay EXCLUSIVE-LOCK where ub.cash-pay.cdpay-code = integer(objPaymentType:code_) no-error .
       32         if AVAILABLE ub.cash-pay then
       33         do:
       34           for each ub.cash-pay-attr EXCLUSIVE-LOCK where ub.cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code
       35             and ub.cash-pay-attr.curr-code = ub.cash-pay.curr-code:
       36             CpAttr:CpAttrDelete(ub.cash-pay-attr.cdpay-code,
       37               ub.cash-pay-attr.curr-code,
       38               ub.cash-pay-attr.host-code,
       39               ub.cash-pay-attr.obj-type,
       40               ub.cash-pay-attr.obj-code,
       41               ub.cash-pay-attr.attr-code,
       42               output v-delete
       43               ).
       44           end.
       45           delete ub.cash-pay .
       46         end.
       47       end.
       48       else
       49       do:
       50         find first ub.cash-pay EXCLUSIVE-LOCK where ub.cash-pay.cdpay-code = integer(objPaymentType:code_) no-error .
       51         if AVAILABLE ub.cash-pay then
       52         do:
       53           assign
       54             v-rec  = recid(ub.cash-pay)
       55             v-mode = '»«Ã≈Õ≈Õ»≈':U
       56             .
       57         end.
       58         else
       59         do:
       60           ASSIGN
       61             v-rec  = ?
       62             v-mode = 'ƒŒ¡¿¬À≈Õ»≈':U
       63             .
       64         end.
       65         find first ub.currency no-lock where ub.currency.okv-code = INTEGER (objPaymentType:curr-code) no-error .
       66         if not AVAILABLE (ub.currency) then
       67         do:
       68           Msg = "ÕÂÚ ‚‡Î˛Ú˚ Ò ÍÓ‰ÓÏ" + objPaymentType:curr-code.
       69           return false.
       70         end.
       71         if integer(objPaymentType:code_) = 1 then
       72         do:
       73           assign
       74             v-is-cash    = yes
       75             v-atr1       = yes
       76             v-has-return = 1
       77             v-can-mix    = 1
       78             .
       79         end.
       80         if AVAILABLE ub.cash-pay then
       81         do:
       82           assign
       83             v-is-cash    = ub.cash-pay.is-cash
       84             v-atr1       = ub.cash-pay.atr1
       85             v-has-return = ub.cash-pay.has-return
       86             v-can-mix    = ub.cash-pay.can-mix
       87             .
       88         end.
       89         run ref/cashpay1.p (
       90           input ?
       91           ,input yes
       92           ,input-output v-rec
       93           ,input v-mode
       94           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.cdpay-code else integer(objPaymentType:code_)
       95           ,input objPaymentType:name_
       96           ,input ub.currency.curr-code
       97           ,input integer(objPaymentType:ptg-code)
       98           ,input 0
       99           ,input 0
      100           ,input v-is-cash
      101           ,input v-atr1
      102           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr2 else no
      103           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr4 else no
      104           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr8 else no
      105           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr16 else no
      106           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr32 else no
      107           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr64 else no
      108           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.atr128 else no
      109           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.pay-card-view else ""
      110           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-advance else no
      111           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-credit else no
      112           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-credit-card else no
      113           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-debet-card else no
      114           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-all-pay else no
      115           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-bar-read else no
      116           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-card-swap else no
      117           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-goods-pay else no
      118           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-service-pay else no
      119           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-kbo else 0
      120           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.is-lnr else 0
      121           ,input v-can-mix
      122           ,input v-has-return
      123           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.has-overpay else 0
      124           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.rule-file-name else ""
      125           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.slip-file-name else ""
      126           ,input if AVAILABLE ub.cash-pay then ub.cash-pay.register else 0
      127           ) no-error .
      128         if error-status:error then
      129         do:
      130           Msg = return-value.
      131           return false.
      132         end.
      133         find first ub.cash-pay EXCLUSIVE-LOCK where ub.cash-pay.cdpay-code = integer(objPaymentType:code_) no-error .
      134         if AVAILABLE ub.cash-pay then
      135         do:
      136           assign
      137             ub.cash-pay.status_ = if objPaymentType:del-l = 1 then 'Û‰‡Î':U else 'ÚÂÍ':U .
      138           .
      139         end.
      140         find first buf_cash-pay-attr EXCLUSIVE-LOCK where buf_cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code
      141           and buf_cash-pay-attr.curr-code = ub.cash-pay.curr-code
      142           and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
      143         if not AVAILABLE buf_cash-pay-attr then
      144         do:
      145           create buf_cash-pay-attr .
      146           assign
      147             buf_cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code
      148             buf_cash-pay-attr.curr-code  = ub.cash-pay.curr-code
      149             buf_cash-pay-attr.attr-code  = "cash-prop"
      150             .
      151         end.
      152         case objPaymentType:pay-type_:
      153           when 0 then
      154             do:
      155               buf_cash-pay-attr.attr-value = "0" .
      156             end.
      157           when 1 then
      158             do:
      159               buf_cash-pay-attr.attr-value = "1" .
      160             end.
      161           when 2 then
      162             do:
      163               buf_cash-pay-attr.attr-value = "2" .
      164             end.
      165           when 3 then
      166             do:
      167               buf_cash-pay-attr.attr-value = "4" .
      168             end.
      169           when 4 then
      170             do:
      171               buf_cash-pay-attr.attr-value = "5" .
      172             end.
      173           when 5 then
      174             do:
      175               buf_cash-pay-attr.attr-value = "13" .
      176             end.
      177           when 6 then
      178             do:
      179               buf_cash-pay-attr.attr-value = "6" .
      180             end.
      181           when 7 then
      182             do:
      183               buf_cash-pay-attr.attr-value = "7" .
      184             end.
      185         end case.
      186         if objPaymentType:pay-type_ <> 0 and objPaymentType:pay-type_ <> 1 and objPaymentType:pay-type_ <> 2
      187           and objPaymentType:pay-type_ <> 3 and objPaymentType:pay-type_ <> 4 and objPaymentType:pay-type_ <> 5
      188           and objPaymentType:pay-type_ <> 6 and objPaymentType:pay-type_ <> 7 then
      189         do:
      190           buf_cash-pay-attr.attr-value = "0" .
      191         end.
      192         return true.
      193       end.
      194     end method.
      195     method public logical CashPayAttr ():
      196     end METHOD .
      197   end class.
