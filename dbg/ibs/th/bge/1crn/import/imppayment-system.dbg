        1   using ibs.th.bge.1crn.subjects.subjects.
        2   using ibs.th.bge.1crn.subjects.payment-system.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.imppayment-system implements ibs.th.bge.1crn.import.iimpsubject:
        5     define private temp-table tt-code no-undo
        6       field f-code as character
        7     .
        8     define property Msg as character no-undo
        9       get.
       10       set.
       11     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       12       define variable objImp    as class payment-system no-undo.
       13       define variable v-retfl   as logical no-undo .
       14       define variable v-mode    as character no-undo.
       15       define variable v-payment-system as class ibs.th.bge.1crn.subjects.payment-system no-undo .
       16       define variable v-code      as character no-undo .
       17       define variable v-name      as character no-undo .
       18       define variable v-objlist   as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:kb-gds[]
       19       define variable v-i-counter as integer no-undo .
       20       define variable v-i-num     as integer no-undo .
       21       define variable v-stub      as integer no-undo .
       22       define variable v-bin-range as class ibs.th.bge.1crn.subjects.bin-range no-undo .
       23     //  define variable v-str-ossid as character no-undo .
       24       define buffer buf_code   for ub.code .
       25       define buffer buf_bin    for ub.code .
       26       Msg        = "":U .
       27       objImp = cast (subjectObj, payment-system).
       28       v-payment-system = objImp .
       29       v-code = v-payment-system:code_ .
       30       v-name = v-payment-system:name_ .
       31           find first buf_code no-lock
       32            where buf_code.code = "PlatSys" no-error .
       33       if not available buf_code
       34       then do:
       35          create buf_code .
       36          assign
       37             buf_code.code       = "PlatSys"
       38             buf_code.codename   = "Платежные системы".
       39             buf_code.procview   = "ibs\th\ref\code\platsys.p".
       40          .
       41       end.
       42       find first buf_code exclusive-lock
       43            where buf_code.parent     = "PlatSys"
       44              and buf_code.code = v-code no-error .
       45       if available buf_code then do :
       46         v-mode = 'ИЗМЕНЕНИЕ':U .
       47       end .
       48       else do :
       49         create buf_code .
       50         assign
       51           v-mode = 'ДОБАВЛЕНИЕ':U
       52           buf_code.code       = v-code
       53           buf_code.parent     = "PlatSys"
       54         .
       55       end .
       56       buf_code.codename       = v-name.
       57       empty temp-table tt-code .
       58       define variable mparent as character no-undo.
       59       mparent = buf_code.parent + chr(4) + buf_code.code.
       60       v-objlist = objImp:bin-ranges .
       61       if valid-object(v-objlist) then do :
       62         v-i-counter = v-objlist:iCounter .
       63         do v-i-num = 1 to v-i-counter :
       64           v-stub = v-objlist:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
       65           v-bin-range = cast(v-objlist:SubjectObjCurr, ibs.th.bge.1crn.subjects.bin-range) .
       66           create tt-code.
       67           tt-code.f-code = v-bin-range:range .
       68         end . // end_of_objImp:gds[]
       69         if v-mode = 'ИЗМЕНЕНИЕ':U then do :
       70           for each buf_bin exclusive-lock
       71              where buf_bin.parent  = mparent
       72                :
       73             if not can-find (first tt-code where tt-code.f-code = buf_bin.code) then
       74               delete buf_bin.
       75           end .
       76         end .
       77         for each tt-code :
       78           find first buf_bin exclusive-lock
       79                  where buf_bin.parent  = mparent
       80                    and buf_bin.code    = tt-code.f-code  no-error .
       81           if not available buf_bin
       82           then  do:
       83             create buf_bin .
       84             assign
       85               buf_bin.parent  = mparent
       86               buf_bin.code    = tt-code.f-code
       87             .
       88           end.
       89           buf_bin.CodeName = v-name.
       90         end .
       91       end. // end_of_gds
       92       v-retfl = true.
       93       define variable i as integer no-undo .
       94       catch exAppErrors as class Progress.Lang.AppError :
       95         Msg = exAppErrors:ReturnValue .
       96         if Msg > "" then . else do :
       97           do i = 1 to exAppErrors:NumMessages :
       98             Msg = Msg + chr(10) + exAppErrors:GetMessage(i) .
       99           end .
      100           if Msg > "" then . else Msg = "AppError в платёжных агентах" .
      101         end .
      102         v-retfl = false .
      103         undo, throw exAppErrors .
      104       end catch .
      105       catch exProErrors as class Progress.Lang.ProError :
      106         do i = 1 to exProErrors:NumMessages :
      107           Msg = Msg + chr(10) + exProErrors:GetMessage(i) .
      108         end .
      109         if Msg > "" then . else Msg = "ProError в платёжных агентах" .
      110         v-retfl = false.
      111         undo, throw exProErrors .
      112       end catch .
      113       catch exAnyErrors as class Progress.Lang.Error:
      114         Msg = "Unexpected error в платёжных агентах" .
      115         v-retfl = false .
      116         undo, throw exAnyErrors .
      117       end catch .
      118       finally :
      119         return v-retfl .
      120       end finally .
      121     end method.
      122   end class.
