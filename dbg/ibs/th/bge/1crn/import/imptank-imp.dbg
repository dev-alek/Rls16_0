        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.str.placelib from propath .
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.imptank-imp implements ibs.th.bge.1crn.import.iimpsubject:
        6     define variable placelib as class placelib no-undo .
        7   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        8   method private logical cur-time (output p-today as date,
        9                                    output p-time  as integer ):
       10     do
       11     on error undo, return error
       12     :
       13       define variable v-date1 as date      no-undo .
       14       define variable v-date2 as date      no-undo .
       15       define variable v-time  as integer   no-undo .
       16       assign
       17         v-date1 = today
       18         v-time  = time
       19         v-date2 = today
       20       .
       21       if v-date1 <> v-date2
       22       then do:
       23         assign
       24           v-date1 = today
       25           v-time  = v-time
       26         .
       27       end.
       28       assign
       29         p-today = v-date1
       30         p-time  = v-time
       31       .
       32     end.
       33   end.
       34   method private character  cur-time-date ()
       35   :
       36     return string(today, '99/99/9999':U) .
       37   end.
       38   method private decimal cur-time-mjd ()
       39   :
       40     define variable v-date as date      no-undo .
       41     define variable v-time as integer   no-undo .
       42     cur-time
       43       (output v-date
       44       ,output v-time
       45       ) .
       46     return integer(v-date) - 2400002 + (v-time / 86400) .
       47   end.
       48   method private integer cur-time-get-ending-index
       49   (input p-number as integer
       50   )
       51   :
       52     if p-number < 0
       53     or p-number = ?
       54     then do:
       55       return 1 .
       56     end.
       57     define variable v-rest as integer   no-undo .
       58     assign
       59       p-number = p-number modulo 100
       60     .
       61     if p-number < 20
       62     then do:
       63       assign
       64         v-rest = p-number
       65       .
       66     end.
       67     else do:
       68       assign
       69         v-rest = p-number modulo 10
       70       .
       71     end.
       72     case v-rest :
       73       when 1
       74       then do:
       75         return 2 .
       76       end.
       77       when 2 or
       78       when 3 or
       79       when 4
       80       then do:
       81         return 3 .
       82       end.
       83       otherwise do:
       84         return 1 .
       85       end.
       86     end case .
       87   end.
       88   method private character cur-time-mjd-to-date(
       89     input  i-mjd-diff as decimal
       90   ,output  o-Date     as date
       91   ,output  o-Time     as integer):
       92      define variable v-day-number as integer   no-undo .
       93      if    i-mjd-diff < 0
       94         or i-mjd-diff = ?
       95      then do:
       96         return "?" .
       97      end.
       98      assign
       99         v-day-number = truncate(i-mjd-diff,0).
      100         o-Date = date(v-day-number + 2400002).
      101         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      102     .
      103   end.
      104   method private character cur-time-mjd-to-string
      105   (input p-mjd-diff as decimal
      106   )
      107   :
      108     define variable v-day-number as integer   no-undo .
      109     define variable v-seconds    as integer   no-undo .
      110     define variable v-hour       as integer   no-undo .
      111     define variable v-min        as integer   no-undo .
      112     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      113     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      114     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      115     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      116     if p-mjd-diff < 0
      117     or p-mjd-diff = ?
      118     then do:
      119       return "?" .
      120     end.
      121     assign
      122       v-day-number = integer(truncate(p-mjd-diff,0))
      123       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      124     .
      125     if v-seconds > 86400
      126     then do:
      127       assign
      128         v-seconds = 86400 - 1
      129       .
      130     end.
      131     if v-seconds < 0
      132     then do:
      133       assign
      134         v-seconds = 0
      135       .
      136     end.
      137     assign
      138       v-hour = truncate(v-seconds / 3600, 0)
      139     .
      140     assign
      141       v-seconds = v-seconds modulo 3600
      142     .
      143     assign
      144       v-min = truncate(v-seconds / 60, 0)
      145     .
      146     assign
      147       v-seconds = v-seconds modulo 60
      148     .
      149     return
      150         (if v-day-number <> 0
      151           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      152           else ""
      153         )
      154       + (if v-day-number <> 0 or v-hour <> 0
      155           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      156           else ""
      157         )
      158       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      159           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      160           else ""
      161         )
      162       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      163       .
      164   end.
      165   method private character cur-time-string ()
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     cur-time
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      174   end.
      175   method private character cur-time-string-sec ()
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     cur-time
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      184   end.
      185   method private character cur-time-custom
      186   (input p-prefix as character
      187   ,input p-date-format as character
      188   ,input p-delimiter as character
      189   ,input p-time-format as character
      190   ,input p-suffix as character
      191   )
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     cur-time
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return
      200       p-prefix
      201       + string(v-date, p-date-format)
      202       + p-delimiter
      203       + string(v-time, p-time-format)
      204       + p-suffix
      205       .
      206   end.
      207   method private character cur-time-print ()
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     cur-time
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      216   end.
      217   method private datetime cur-time-datetime ()
      218   :
      219     define variable v-char as character no-undo .
      220     define variable v-datetime as datetime no-undo .
      221     v-char = cur-time-string().
      222     v-datetime = datetime(v-char).
      223     return  v-datetime.
      224   end.
      225   method private character cur-time-string-msec ()
      226   :
      227     define variable v-date as datetime  no-undo .
      228     v-date = now.
      229     return string(v-date) .
      230   end.
      231     define property Msg as character no-undo
      232       get.
      233       set.
      234     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
      235       define variable v-tank         as class tank-imp         no-undo.
      236       define variable v-cal-tbl-line as class tank-imp_cal-tbl no-undo.
      237       define variable v-belt-tbl-line as class tank-imp_belt-tbl no-undo.
      238       define variable v_cal-tbl      as class subjects         no-undo.
      239       define variable v_belt-tbl      as class subjects         no-undo.
      240       define buffer buf_place-imp      for ub.place-imp .
      241       define buffer bf_place-imp       for ub.place-imp .
      242       define buffer buf_place-imp-attr for ub.place-imp-attr .
      243       define buffer buf_pl-level-imp   for ub.pl-level-imp .
      244       define buffer bf_pl-level-imp    for ub.pl-level-imp .
      245       define buffer buf_clients        for ub.clients .
      246       define buffer buf_pl-level-attr  for ub.pl-level-attr .
      247       define buffer buf_pl-level-mm-imp   for ub.pl-level-mm-imp .
      248       define buffer buf_shift-obj      for ub.shift-obj .
      249       define buffer buf_place-attr     for ub.place-attr .
      250       define variable v-mode  as character no-undo .
      251       define variable v-rec   as recid     no-undo .
      252       define variable ii      as integer   no-undo .
      253       define variable v-code  as character no-undo .
      254       define variable v-value as character no-undo .
      255       define variable v-ok    as logical   no-undo .
      256       define variable v-today as date      no-undo .
      257       define variable v-time  as integer   no-undo .
      258       v-tank = cast (subjectObj, tank-imp).
      259       v_cal-tbl = v-tank:cal-tbl .
      260       v_belt-tbl = v-tank:belt-tbl .
      261       find first buf_clients no-lock  where buf_clients.obj-type = 'маг':U
      262         and buf_clients.obj-code = integer(v-tank:gs-code) no-error .
      263       if not AVAILABLE (buf_clients) then
      264       do:
      265         Msg = "Нет объекта с кодом: " + v-tank:gs-code .
      266         return error .
      267       end.
      268       find first buf_place-imp no-lock where buf_place-imp.obj-type = buf_clients.obj-type
      269                                          and buf_place-imp.obj-code = buf_clients.obj-code
      270                                          and buf_place-imp.pl-code  = integer(v-tank:tank-code)
      271                                          and buf_place-imp.table-version >= v-tank:table-version
      272                                          no-error .
      273       if NOT AVAILABLE (buf_place-imp) then
      274       do:
      275         create buf_place-imp .
      276         assign
      277           buf_place-imp.obj-type      = buf_clients.obj-type
      278           buf_place-imp.obj-code      = buf_clients.obj-code
      279           buf_place-imp.pl-code       = integer(v-tank:tank-code)
      280           buf_place-imp.table-version = v-tank:table-version
      281           buf_place-imp.status_       = 0
      282           buf_place-imp.max-qnty      = v-tank:max-qnty
      283           buf_place-imp.d-qnty        = v-tank:d-qnty
      284           buf_place-imp.tank-d        = v-tank:tank-d
      285           buf_place-imp.dc-height     = v-tank:dc-height
      286           buf_place-imp.dnsty         = v-tank:dnsty
      287           buf_place-imp.main-mi-code  = if v-tank:main-mi-code <> ? then integer(v-tank:main-mi-code) else ?
      288           buf_place-imp.position      = v-tank:position_ + 1
      289           buf_place-imp.tank-tk       = v-tank:tank-tk
      290           buf_place-imp.pontoon       = v-tank:pontoon
      291           buf_place-imp.wght-pntn     = v-tank:wght-pntn
      292           buf_place-imp.srfcng-pntn   = v-tank:srfcng-pntn
      293         .
      294         for each bf_pl-level-imp where bf_pl-level-imp.obj-code = buf_place-imp.obj-code
      295           and bf_pl-level-imp.obj-type = buf_place-imp.obj-type
      296           and bf_pl-level-imp.pl-code = buf_place-imp.pl-code
      297           and bf_pl-level-imp.table-version = buf_place-imp.table-version:
      298           delete bf_pl-level-imp .
      299         end.
      300         for each buf_pl-level-mm-imp where buf_pl-level-mm-imp.obj-code = buf_place-imp.obj-code
      301           and buf_pl-level-mm-imp.obj-type = buf_place-imp.obj-type
      302           and buf_pl-level-mm-imp.pl-code = buf_place-imp.pl-code
      303           and buf_pl-level-mm-imp.table-version = buf_place-imp.table-version:
      304           delete buf_pl-level-mm-imp .
      305         end.
      306         if VALID-OBJECT (v_cal-tbl) then
      307         do:
      308           do ii = 1 to v_cal-tbl:Get(ii):
      309             v-cal-tbl-line = cast(v_cal-tbl:SubjectObjCurr, tank-imp_cal-tbl) .
      310             find first buf_pl-level-imp EXCLUSIVE-LOCK where buf_pl-level-imp.obj-code = buf_place-imp.obj-code
      311               and buf_pl-level-imp.obj-type = buf_place-imp.obj-type
      312               and buf_pl-level-imp.pl-code = buf_place-imp.pl-code
      313               and buf_pl-level-imp.table-version = buf_place-imp.table-version
      314               and buf_pl-level-imp.pl-level = v-cal-tbl-line:lvl_ no-error .
      315             if not AVAILABLE (buf_pl-level-imp) then
      316             do:
      317               create buf_pl-level-imp.
      318               assign
      319                 buf_pl-level-imp.obj-type = buf_place-imp.obj-type
      320                 buf_pl-level-imp.obj-code = buf_place-imp.obj-code
      321                 buf_pl-level-imp.pl-code  = buf_place-imp.pl-code
      322                 buf_pl-level-imp.table-version = buf_place-imp.table-version
      323                 buf_pl-level-imp.pl-level = v-cal-tbl-line:lvl_
      324                 buf_pl-level-imp.pl-qnty  = v-cal-tbl-line:amnt
      325                 buf_pl-level-imp.tarir-delta = v-cal-tbl-line:comp-err
      326                 buf_pl-level-imp.deltaV   = v-cal-tbl-line:deltaV
      327               .
      328             end.
      329           end.
      330         end.
      331         if VALID-OBJECT (v_belt-tbl) then
      332         do:
      333           do ii = 1 to v_belt-tbl:Get(ii):
      334             v-belt-tbl-line = cast(v_belt-tbl:SubjectObjCurr, tank-imp_belt-tbl) .
      335             find first buf_pl-level-mm-imp EXCLUSIVE-LOCK where buf_pl-level-mm-imp.obj-code = buf_place-imp.obj-code
      336               and buf_pl-level-mm-imp.obj-type = buf_place-imp.obj-type
      337               and buf_pl-level-mm-imp.pl-code = buf_place-imp.pl-code
      338               and buf_pl-level-mm-imp.table-version = buf_place-imp.table-version
      339               and buf_pl-level-mm-imp.zone = v-belt-tbl-line:num-belt
      340               and buf_pl-level-mm-imp.level = v-belt-tbl-line:tbl-lvl no-error .
      341             if not AVAILABLE (buf_pl-level-mm-imp) then
      342             do:
      343               create buf_pl-level-mm-imp.
      344               assign
      345                 buf_pl-level-mm-imp.obj-type  = buf_place-imp.obj-type
      346                 buf_pl-level-mm-imp.obj-code  = buf_place-imp.obj-code
      347                 buf_pl-level-mm-imp.pl-code   = buf_place-imp.pl-code
      348                 buf_pl-level-mm-imp.table-version = buf_place-imp.table-version
      349                 buf_pl-level-mm-imp.zone      = v-belt-tbl-line:num-belt
      350                 buf_pl-level-mm-imp.min-level = v-belt-tbl-line:low-lvl
      351                 buf_pl-level-mm-imp.max-level = v-belt-tbl-line:up-lvl
      352                 buf_pl-level-mm-imp.level     = v-belt-tbl-line:tbl-lvl
      353                 buf_pl-level-mm-imp.capacity  = v-belt-tbl-line:belt-capacity * 1000
      354               .
      355             end.
      356           end.
      357         end.
      358         cur-time (output v-today
      359                  ,output v-time
      360                  ).
      361         assign
      362           buf_place-imp.corr-date     = v-today
      363           buf_place-imp.corr-time     = v-time
      364         .
      365         run str/prep1C-status-cal-tbl.p (input buf_place-imp.table-version,
      366                                          input buf_place-imp.pl-code,
      367                                          input buf_place-imp.corr-date,
      368                                          input buf_place-imp.corr-time,
      369                                          input buf_place-imp.status_)
      370                                          no-error .
      371         find first buf_shift-obj
      372           where buf_shift-obj.obj-type = buf_clients.obj-type
      373             and buf_shift-obj.obj-code = buf_clients.obj-code
      374             and buf_shift-obj.status_ = 'тек':U
      375         use-index pi
      376         no-error.
      377         if not available buf_shift-obj
      378         then do :
      379           run str/apply_place-imp.p (input buf_place-imp.obj-type,
      380                                      input buf_place-imp.obj-code,
      381                                      input buf_place-imp.pl-code,
      382                                      input buf_place-imp.table-version)
      383                                      no-error .
      384           if error-status:error
      385           then do :
      386             Msg = "Ошибка при применении новых параметров резервуара " + v-tank:tank-code + " и градуировочных таблиц" .
      387             return error .
      388           end .
      389         end .
      390         else do :
      391           find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = buf_place-imp.obj-type
      392                                                      and buf_place-attr.obj-code = buf_place-imp.obj-code
      393                                                      and buf_place-attr.pl-code  = buf_place-imp.pl-code
      394                                                      and buf_place-attr.attr-code = "pending-table-version"
      395                                                      no-error .
      396           if not available buf_place-attr
      397           then do :
      398             create buf_place-attr .
      399             assign
      400               buf_place-attr.obj-type = buf_place-imp.obj-type
      401               buf_place-attr.obj-code = buf_place-imp.obj-code
      402               buf_place-attr.pl-code  = buf_place-imp.pl-code
      403               buf_place-attr.attr-code = "pending-table-version"
      404             .
      405           end .
      406           assign
      407             buf_place-attr.attr-value = buf_place-attr.attr-value + "," + string(buf_place-imp.table-version)
      408             buf_place-attr.attr-value = trim(buf_place-attr.attr-value, ",")
      409           .
      410           find first buf_place-attr exclusive-lock where buf_place-attr.obj-type = buf_place-imp.obj-type
      411                                                      and buf_place-attr.obj-code = buf_place-imp.obj-code
      412                                                      and buf_place-attr.pl-code  = buf_place-imp.pl-code
      413                                                      and buf_place-attr.attr-code = "message-table-version"
      414                                                      no-error .
      415           if not available buf_place-attr
      416           then do :
      417             create buf_place-attr .
      418             assign
      419               buf_place-attr.obj-type = buf_place-imp.obj-type
      420               buf_place-attr.obj-code = buf_place-imp.obj-code
      421               buf_place-attr.pl-code  = buf_place-imp.pl-code
      422               buf_place-attr.attr-code = "message-table-version"
      423             .
      424           end .
      425           assign buf_place-attr.attr-value = "pending" .
      426         end .
      427       end.
      428       else do:
      429         Msg = "Уже есть данные для резервуара " + v-tank:tank-code + " с номером версии " + string(v-tank:table-version) .
      430         return true .
      431       end.
      432     end method.
      433   end class.
