        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   USING ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.imposnovcorr implements ibs.th.bge.1crn.import.iimpsubject:
        6     define buffer buf_code for ub.code .
        7     define variable v-code as character no-undo .
        8     define property Msg as character no-undo
        9       get.
       10       set.
       11     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       12       define variable ri           as recid no-undo .
       13       define variable objOsnovCorr as class osnovcorr no-undo.
       14       objOsnovCorr = cast (subjectObj, osnovcorr).
       15       if objOsnovCorr:code_ = 0 or objOsnovCorr:code_ = ? then
       16       do:
       17         Msg = "Основание коррекции не задано".
       18         return error.
       19       end.
       20       if objOsnovCorr:osn_name = "" or objOsnovCorr:osn_name = ? then
       21       do:
       22         Msg = "Основание коррекции " + string(objOsnovCorr:code_) + " . Не задана" .
       23         return error Msg.
       24       end.
       25           find first buf_code no-lock
       26         where buf_code.code = "OsnovCorr" no-error .
       27       if not available buf_code
       28         then
       29       do:
       30         create buf_code .
       31         assign
       32           buf_code.code     = "OsnovCorr"
       33           buf_code.codename = "Основание коррекции".
       34         buf_code.procview   = "ibs\th\ref\code\corrsys.p".
       35         .
       36       end.
       37       if objOsnovCorr:del-f = 0 then
       38       do:
       39         find first buf_code exclusive-lock where buf_code.parent = "OsnovCorr"
       40           and buf_code.code = string(objOsnovCorr:code_) no-error .
       41         if not available (buf_code) then
       42         do:
       43           create buf_code .
       44           assign
       45             buf_code.parent = "OsnovCorr"
       46             buf_code.code   = string(objOsnovCorr:code_)
       47             .
       48         end.
       49         assign
       50           buf_code.CodeName  = objOsnovCorr:osn_name
       51           buf_code.status_   = objOsnovCorr:del-l
       52           .
       53       end.
       54       else
       55       do:
       56         find first buf_code exclusive-lock where buf_code.parent = "OsnovCorr"
       57           and buf_code.code = string(objOsnovCorr:code_) no-error .
       58         if not available (buf_code) then
       59         do:
       60           Msg = "Удаление основания коррекции с кодом " + string(objOsnovCorr:code_) + ". Не возможно" .
       61           return error Msg.
       62         end.
       63         else
       64           delete buf_code .
       65       end.
       66     end method.
       67   end class.
