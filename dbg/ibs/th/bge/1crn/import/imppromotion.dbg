      444       assign
      445         v-promo-crit:discont = v-promoset:ps-Price
      446         v-promo-crit:Mode    = 'с':U
      447       .
      448       v-promo-crits:AddItem (v-promo-crit) .
      449       v-promo-goods = v-promo-action:PromoSet .
      450       v-objlist7 = v-promoset:ps-sections .
      451       v-i-counter = v-objlist7:iCounter .
      452       do v-i-num = 1 to v-i-counter :
      453         v-stub = v-objlist7:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      454         v-ps-section = cast(v-objlist7:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_ps-section) .
      455         v-promo-good = new ibs.th.ref.promo.promogoodssub () .
      456         v-objlist8 = v-ps-section:gds .
      457         if valid-object(v-objlist8) then do:
      458           v-promo-good:refreshChildObj() .
      459           v-pssec-goods = v-promo-good:promoSetGoods. // ibs.th.ref.promo.promogoodssubs = пустая коллекция для промо-набора
      460           v-j-counter = v-objlist8:iCounter .
      461           do v-j-num = 1 to v-j-counter :
      462             v-stub = v-objlist8:Get(v-j-num) .
      463             v-promoset-gd = cast(v-objlist8:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_gd) .
      464             assign
      465               v-pssec-good = new ibs.th.ref.promo.promogoodssub ()
      466               v-gds-code   = integer(v-promoset-gd:gd-code)
      467             .
      468             if not can-find (first buf_goods where buf_goods.gds-code = v-gds-code) then
      469             undo, throw new Progress.Lang.AppError( substitute(
      470               "Код товара [&1] из промо-акции [&2] отсутствует в справочнике товаров."
      471               , v-gds-code, objImp:name_
      472             ) ) .
