        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.subjects.
        3   using ibs.th.bge.1crn.subjects.promotion.
        4   using ibs.th.ref.promo.enum-type-discount .
        5   using ibs.th.ref.promo.enum-promo-status .
        6   using ibs.th.ref.promo.enum-sched-status .
        7   block-level on error undo, throw.
        8   class ibs.th.bge.1crn.import.imppromotion implements ibs.th.bge.1crn.import.iimpsubject:
        9     // &h-create, &delim-key, &delim-par
       10     define property Msg as character no-undo
       11       get.
       12       set.
       13     define private variable parparentproc   as handle no-undo .
       14     define private variable p-parent-handle as handle no-undo .
       15     define private variable p-log-handle    as handle no-undo .
       16     method public void setParent (
       17     input parparentproc   as handle
       18   , input p-parent-handle as handle
       19   , input p-log-handle    as handle
       20     ) :
       21       assign
       22         this-object:parparentproc   = parparentproc
       23         this-object:p-parent-handle = p-parent-handle
       24         this-object:p-log-handle    = p-log-handle
       25       .
       26     end method .
       27     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       28       define variable objImp   as class promotion no-undo.
       29       define variable v-retfl  as logical no-undo .
       30       define variable v-i-num          as integer no-undo .
       31       define variable v-i-counter      as integer no-undo .
       32       define variable v-j-num          as integer no-undo .
       33       define variable v-j-counter      as integer no-undo .
       34       define variable v-stub           as integer no-undo .
       35       define variable v-schedule       as class ibs.th.bge.1crn.subjects.promotion_schedule no-undo .
       36       define variable v-objlist1       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:schedule:sched-lines[]
       37       define variable v-sched-line     as class ibs.th.bge.1crn.subjects.promotion_schedule-line no-undo .
       38       define variable v-objlist2       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:thresholds[]
       39       define variable v-threshold      as class ibs.th.bge.1crn.subjects.promotion_threshold no-undo .
       40       define variable v-objlist3       as class ibs.th.bge.1crn.subjects.subjects no-undo . // :gifts[{gd-code,gd-qnty}]
       41       define variable v-gift-gd        as class ibs.th.bge.1crn.subjects.promotion_gift-gd no-undo .
       42       define variable v-objlist4       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:gds[]
       43       define variable v-gds-gd         as class ibs.th.bge.1crn.subjects.promotion_gds-gd no-undo .
       44       define variable v-objlist5       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:gds-addcond[]
       45       define variable v-addcond-gd     as class ibs.th.bge.1crn.subjects.promotion_gd no-undo .
       46       define variable v-promoset       as class ibs.th.bge.1crn.subjects.promotion_promoset no-undo .
       47    // define variable v-objlist6       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp: запасной
       48       define variable v-objlist7       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:promoset:ps-sections[]
       49       define variable v-ps-section     as class ibs.th.bge.1crn.subjects.promotion_ps-section no-undo .
       50       define variable v-objlist8       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:promoset:ps-sections:ps-section:gds[]
       51       define variable v-promoset-gd    as class ibs.th.bge.1crn.subjects.promotion_gd no-undo .
       52       define variable v-objlist9       as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:gifts[]
       53       define variable v-PaymentSystems as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:payment-systems[]
       54       define variable v-PaymentSystem  as class ibs.th.bge.1crn.subjects.payment-system no-undo . // imp:payment-systems:payment-system[]
       55       define variable v-bins-tokens    as class ibs.th.bge.1crn.subjects.subjects no-undo . // imp:payment-systems:payment-system:bins-tokens[]
       56       define variable v-bin-token      as class ibs.th.bge.1crn.subjects.bin-token no-undo . // imp:payment-systems:payment-system:bins-tokens:bin-token[]
       57       define variable v-promotion-code as character no-undo .
       58       define variable v-schedule-code  as character no-undo .
       59       define variable v-promo-delete   as class ibs.th.ref.promo.promoactionsub no-undo .
       60       define variable v-promo-action   as class ibs.th.ref.promo.promoactionsub no-undo .
       61       define variable v-promo-sched    as class ibs.th.ref.promo.promoSchedsub no-undo .
       62       define variable v-promo-schdws   as class ibs.th.ref.promo.promoSchedwsubs no-undo .
       63       define variable v-promo-schdw    as class ibs.th.ref.promo.promoSchedwsub no-undo .
       64       define variable v-promo-crits    as class ibs.th.ref.promo.promoCriterionsubs no-undo .
       65       define variable v-promo-crit     as class ibs.th.ref.promo.promoCriterionsub no-undo .
       66       define variable v-promo-gifts    as class ibs.th.ref.promo.promoGiftsubs no-undo .
       67       define variable v-promo-gift     as class ibs.th.ref.promo.promoGiftsub no-undo .
       68       define variable v-promo-goods    as class ibs.th.ref.promo.promogoodssubs no-undo .
       69       define variable v-pssec-goods    as class ibs.th.ref.promo.promogoodssubs no-undo .
       70       define variable v-promo-good     as class ibs.th.ref.promo.promogoodssub no-undo .
       71       define variable v-pssec-good     as class ibs.th.ref.promo.promogoodssub no-undo .
       72       define variable v-promo-objs     as class ibs.th.ref.promo.promoObjectsubs no-undo .
       73       define variable v-promo-obj      as class ibs.th.ref.promo.promoObjectsub no-undo .
       74       define variable v-gds-code as integer no-undo .
       75       define variable v-obj-type as character no-undo .
       76       define variable v-obj-code as integer no-undo .
       77       define variable v-db-num   as integer no-undo .
       78       define variable v-message  as logical no-undo .
       79       define variable v-storage        as class ibs.th.gbl.storage.promoactionstorage no-undo .
       80       define buffer buf_PromoAction for ub.PromoAction .
       81       define buffer buf_PromoSched  for ub.promo-schedule .
       82       define buffer buf_goods       for ub.goods .
       83       define buffer buf_clients     for ub.clients .
       84       define buffer buf_goods-attr  for ub.goods-attr .
       85       define buffer buf_PromoAttr   for ub.PromoAttr .
       86   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       87   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       88       define variable v-ban-recipes as logical no-undo init false.
       89       objImp = cast (subjectObj, promotion).
       90       assign
       91         v-promotion-code = objImp:code_
       92         Msg              = "":U
       93       .
       94       if v-promotion-code > "" then . else undo, throw new Progress.Lang.AppError("Не задан ид. промо-акции") .
       95       if objImp:del-f > 0 then do:
       96         Msg = "физическое удаление промо-акций не предусмотрено".
       97         v-retfl = false .
       98         return false.
       99       end.
      100       if objImp:del-l > 0 then do:
      101         Msg = "Логическое удаление промо-акций не предусмотрено. Акцию завершает досрочное погашение.".
      102         v-retfl = false .
      103         return false.
      104       end.
      105       v-promo-action = new ibs.th.ref.promo.promoactionsub () .
      106       v-promo-action:refreshChildObj(). // - создаёт пустые экземпляры всех дочерних объектов
      107       v-promo-action:ext-code = v-promotion-code .
      108   do: // заголок промо-акции
      109       find first buf_PromoAction no-lock where buf_PromoAction.ext-code = v-promotion-code no-error .
      110       if available buf_PromoAction then do:
      111         v-promo-delete = new ibs.th.ref.promo.promoactionsub () .
      112         assign
      113           v-promo-delete:ID     = buf_PromoAction.id
      114           v-promo-delete:db-num = buf_PromoAction.db-num
      115           v-promo-delete:promosched-id = buf_PromoAction.promosched-id
      116           v-promo-action:ID     = buf_PromoAction.id
      117         .
      118       end .
      119       else do:
      120         assign
      121           // v-promo-action:Mode        = {&h-create}
      122         .
      123       end .
      124         assign
      125           v-promo-action:beg-date    = objImp:strt-date
      126           v-promo-action:end-date    = objImp:end-date
      127           v-promo-action:changeDate  = objImp:earlyend-day
      128           v-promo-action:NameAction  = objImp:name_
      129        // обработка enum при взаимодействии со справочниками реализована в обход
      130        // v-promo-action:TypeDiscont = objImp:dscnt-type
      131           v-promo-action:TypeDiscontenum = if objImp:dscnt-value-type eq 8 then enum-type-discount:enVISA else objImp:dscnt-type
      132           v-promo-action:methodCalc      = if objImp:dscnt-value-type eq 8 then 7                         else objImp:dscnt-value-type
      133        // v-promo-action:status_     = getPromoStatus(objImp:status_)
      134           v-promo-action:status_enum = getPromoStatus(objImp:status_)
      135           v-promo-action:priority    = objImp:priority
      136           v-promo-action:comment     = objImp:comment
      137           v-promo-action:description = objImp:description_
      138        // v-promo-action:paymenttype = objImp:pmnt-types
      139           v-promo-action:paymenttype = replace(objImp:pmnt-types, ",",chr(3) + "0" + chr(4)) +  chr(3)+ "0"
      140           .
      141         if available (buf_PromoAction) and (buf_PromoAction.beg-date <> v-promo-action:beg-date or buf_PromoAction.end-date <> v-promo-action:end-date) then do:
      142            v-message = true .
      143         end.
      144   define variable v-txt-typedisc      as character extent 2 no-undo initial ["временная скидка", "промо-набор"] .
      145   define variable v-txt-method-calc   as character extent 7 no-undo initial ["Скидка процентом", "Абсолютная (скидка суммой от цены)", "Скидка количеством", "Скидка процентом за количество", "Фиксированная цена", "Выдача сообщения", "Подарок"] .
      146   define variable v-txt-dscnt-type    as character extent 7 no-undo initial ["процентная", "абсолютная", "натуральная", "процентная за количество", "фиксированная цена", "Выдача сообщения,подарок"] .
      147   define variable v-txt-thresholdtype as character extent 4 no-undo initial ["Количество по строке", "Сумма по строке", "Итог чека", "Скидка по ШК"] .
      148   // "Количество по строке,Сумма по строке[,Сумма в документе]"
      149   define variable v-txt-error         as character no-undo .
      150       v-txt-error = "" .
      151       case v-promo-action:TypeDiscontenum :
      152         when enum-type-discount:ensolo then do:
      153           case v-promo-action:methodCalc:
      154             when 1 then do: // 1 – процентная
      155               if not can-do("1,2,3,4", string(objImp:threshold-type)) then
      156                 v-txt-error = substitute(
      157                 "Для типа скидки [&1] и значения [&2] вид условия должен быть [&3], [&4], [&5] или [&6]",
      158                 v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()],
      159                 v-txt-method-calc[v-promo-action:methodCalc],
      160                 v-txt-thresholdtype[1],
      161                 v-txt-thresholdtype[2],
      162                 v-txt-thresholdtype[3],
      163                 v-txt-thresholdtype[4]
      164               ) .
      165             end .
      166             when 2 then do: // 2 – абсолютная
      167               if not can-do("1,2,4", string(objImp:threshold-type)) then
      168                 v-txt-error = substitute(
      169                 "Для типа скидки [&1] и значения [&2] вид условия должен быть [&3], [&4] или [&5]",
      170                 v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()],
      171                 v-txt-method-calc[v-promo-action:methodCalc],
      172                 v-txt-thresholdtype[1],
      173                 v-txt-thresholdtype[2],
      174                 v-txt-thresholdtype[4]
      175               ) .
      176             end .
      177             when 5 then do: // 5 – фиксированная
      178               if not can-do("4", string(objImp:threshold-type)) then
      179                 v-txt-error = substitute(
      180                 "Для типа скидки [&1] и значения [&2] вид условия должен быть [&3]",
      181                 v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()],
      182                 v-txt-method-calc[v-promo-action:methodCalc],
      183                 v-txt-thresholdtype[4]
      184               ) .
      185             end .
      186             when 6 or when 7 then do: // 1 – процентная, 6 – Выдача сообщения, 7 – подарок
      187               if not can-do("1,2,3", string(objImp:threshold-type)) then
      188                 v-txt-error = substitute(
      189                 "Для типа скидки [&1] и значения [&2] вид условия должен быть [&3], [&4] или [&5]",
      190                 v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()],
      191                 v-txt-method-calc[v-promo-action:methodCalc],
      192                 v-txt-thresholdtype[1],
      193                 v-txt-thresholdtype[2],
      194                 v-txt-thresholdtype[3]
      195               ) .
      196             end .
      197             otherwise do:
      198               if objImp:threshold-type > 0 then
      199                 v-txt-error = substitute(
      200                 "Для типа скидки [&1] и значения [&2] вид условия не применяется",
      201                 v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()],
      202                 v-txt-method-calc[v-promo-action:methodCalc]
      203               ) .
      204             end.
      205           end case .
      206         end . // end_of_ensolo
      207         when enum-type-discount:encombo then do:
      208           if objImp:threshold-type > 0 then
      209             v-txt-error = substitute(
      210             "Для типа скидки [&1] вид условия не применяется",
      211             v-txt-typedisc[v-promo-action:TypeDiscontenum:GetValue()]
      212           ) .
      213         end. // end_of_encombo
      214         when enum-type-discount:enVISA then do:
      215         END.
      216         otherwise v-txt-error = substitute("Тип скидки [&1] не поддерживается.", v-promo-action:TypeDiscontenum:GetValue()) .
      217       end case .
      218        v-promo-action:typecond = objImp:threshold-type .
      219   end. // end_of заголовок_промоакции
      220       // вложенные объекты &impclass
      221       assign
      222         v-schedule = objImp:schedule
      223         v-objlist2 = objImp:thresholds
      224         v-objlist4 = objImp:gds
      225         v-objlist5 = objImp:gds-addcond
      226         v-promoset = objImp:promoset
      227         v-objlist9 = objImp:gifts
      228         v-PaymentSystems = objImp:Payment-Systems
      229       .
      230   do: // объекты
      231       v-obj-type = 'маг':U.
      232       v-db-num   = ibs.th.gbl.gbl-var:g#db-num .
      233       find first buf_clients no-lock
      234            where buf_clients.db-num   = v-db-num
      235              and buf_clients.obj-type = v-obj-type no-error .
      236       v-obj-code = if available buf_clients then buf_clients.obj-code else v-db-num .
      237       v-promo-obj  = new ibs.th.ref.promo.promoObjectsub () .
      238       assign
      239         v-promo-obj:obj-type = v-obj-type
      240         v-promo-obj:obj-code = v-obj-code
      241         v-promo-obj:end-date = v-promo-action:end-date
      242         v-promo-obj:Mode     = 'с':U
      243       .
      244       v-promo-objs = v-promo-action:Objects .
      245       v-promo-objs:AddItem (v-promo-obj) .
      246       if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-obj-type, v-obj-code):IsBanRecipes then v-ban-recipes = true .
      247   end . // end_of объекты
      248   if valid-object (v-schedule) then do: // schedule - расписание
      249       v-promo-sched  = new ibs.th.ref.promo.promoSchedsub () .
      250       assign
      251         v-schedule-code            = v-schedule:sch-code
      252         v-promo-sched:Mode         = 'с':U
      253         v-promo-sched:extCodeSched = v-schedule-code
      254      // v-promo-sched:status_      = getSchedStatus (v-promo-action:status_)
      255         v-promo-sched:status_      = getSchedStatus (v-promo-action:status_enum) // обработка enum при взаимодействии со справочниками реализована в обход
      256       .
      257           assign
      258             v-promo-sched:dispname  = v-schedule:sch-name
      259             v-promo-sched:schedType = integer(v-schedule:Sch-type)
      260             v-objlist1              = v-schedule:schedule-lines
      261           .
      262       v-promo-action:Schedule     = v-promo-sched .
      263       if valid-object(v-objlist1) then do : // schedule-lines - дни расписания
      264         v-promo-schdws = v-promo-action:ScheduleWeek . // создаётся пустая коллекция дней расписания
      265         v-i-counter = v-objlist1:iCounter .
      266         do v-i-num = 1 to v-i-counter :
      267           v-stub = v-objlist1:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      268           v-sched-line = cast(v-objlist1:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_schedule-line) .
      269           v-promo-schdw = new ibs.th.ref.promo.promoSchedwsub () .
      270           assign
      271             v-promo-schdw:wdaylist = v-sched-line:day_
      272             v-promo-schdw:timebeg  = parseTime(v-sched-line:strt-time)
      273             v-promo-schdw:timeend  = parseTime(v-sched-line:end-time)
      274             v-promo-schdw:Mode     = v-promo-sched:Mode
      275           .
      276           v-promo-schdws:AddItem (v-promo-schdw) .
      277         end. // end_of_objImp:schedule:sched-lines[]
      278       end . // end_of дни расписания
      279   end. // end_of расписание
      280   else do :
      281       v-promo-sched  = new ibs.th.ref.promo.promoSchedsub () .
      282       assign
      283         v-promo-sched:Mode         = 'с':U
      284         v-promo-sched:status_      = getSchedStatus (v-promo-action:status_enum) // обработка enum при взаимодействии со справочниками реализована в обход
      285         v-promo-sched:dispname     = "Расписание для акции " + string(v-promo-action:ID)
      286         v-promo-sched:schedType    = 0
      287       .
      288       v-promo-action:Schedule     = v-promo-sched .
      289       v-promo-schdws = v-promo-action:ScheduleWeek . // создаётся пустая коллекция дней расписания
      290       v-promo-schdw = new ibs.th.ref.promo.promoSchedwsub () .
      291       assign
      292          v-promo-schdw:wdaylist = "0"
      293          v-promo-schdw:timebeg  = 0
      294          v-promo-schdw:timeend  = 86399
      295          v-promo-schdw:Mode     = 'с':U
      296       .
      297       v-promo-schdws:AddItem (v-promo-schdw) .
      298   end.
      299   if valid-object(v-objlist2) then do: // threshold - пороговые значения
      300       define variable valueupto as decimal no-undo init 0 .
      301       define variable logupto as logical no-undo .
      302       define variable valuemin  as decimal no-undo init 0 .
      303       v-promo-crits = v-promo-action:Criterion .
      304       v-i-counter = v-objlist2:iCounter .
      305       do v-i-num = 1 to v-i-counter :
      306         if logupto then leave .
      307         else do:
      308         v-stub = v-objlist2:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      309         v-threshold = cast(v-objlist2:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_threshold) .
      310         v-promo-crit = new ibs.th.ref.promo.promoCriterionsub () .
      311         v-promo-crit:refreshChildObj().
      312         if v-threshold:value_ = ? then valuemin = 0 .
      313         else valuemin = v-threshold:value_ .
      314         valueupto = v-threshold:valueupto .
      315         assign
      316           v-promo-crit:mincrit = valuemin
      317           v-promo-crit:maxcrit = v-threshold:valueupto
      318           v-promo-crit:discont = v-threshold:dscnt
      319           v-promo-crit:Mode    = 'с':U
      320           v-promo-gifts        = v-promo-crit:Gifts
      321         .
      322         if v-threshold:message_ <> ? then do:
      323           v-promo-gift = new ibs.th.ref.promo.promoGiftsub () .
      324           assign
      325             v-promo-gift:mess = v-threshold:message_
      326             v-promo-gift:Mode = v-promo-crit:Mode
      327           .
      328           v-promo-gifts:AddItem (v-promo-gift) .
      329         end .
      330         if v-threshold:message-gks <> ? then do:
      331           v-promo-gift = new ibs.th.ref.promo.promoGiftsub () .
      332           assign
      333             v-promo-gift:mess-gks = v-threshold:message-gks
      334             v-promo-gift:Mode = v-promo-crit:Mode
      335           .
      336           v-promo-gifts:AddItem (v-promo-gift) .
      337         end .
      338         v-objlist3 = v-threshold:Gifts .
      339         if valid-object(v-objlist3) then do :
      340           v-j-counter = v-objlist3:iCounter .
      341           do v-j-num = 1 to v-j-counter :
      342             v-stub = v-objlist3:Get(v-j-num) .
      343             v-gift-gd = cast(v-objlist3:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_gift-gd) .
      344             assign
      345               v-promo-gift = new ibs.th.ref.promo.promoGiftsub ()
      346               v-gds-code   = integer(v-gift-gd:gd-code)
      347             .
      348             if not can-find (first buf_goods where buf_goods.gds-code = v-gds-code) then
      349             undo, throw new Progress.Lang.AppError( substitute(
      350               "Код товара [&1] из промо-акции [&2] отсутствует в справочнике товаров."
      351               , v-gds-code, objImp:name_
      352             ) ) .
      353             assign
      354               v-promo-gift:GdsCode = v-gds-code
      355               v-promo-gift:qnty    = v-gift-gd:gd-qnty
      356               v-promo-gift:Mode    = v-promo-crit:Mode
      357             .
