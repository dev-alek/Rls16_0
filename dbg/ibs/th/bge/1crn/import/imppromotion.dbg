      359               if can-find (first buf_goods-attr no-lock where buf_goods-attr.gds-code = v-promo-gift:GdsCode and
      360                  buf_goods-attr.attr-code = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" and
      361                  buf_goods-attr.attr-value <> "") then
      362               do:
