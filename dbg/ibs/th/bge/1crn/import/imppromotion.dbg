      481           v-promo-good:NameSet = v-ps-section:ps-name
      482           v-promo-good:qnty    = v-ps-section:ps-amount
      483           v-promo-good:price   = v-ps-section:ps-discount
      484           v-promo-good:Mode    = v-promo-crit:Mode
      485         .
