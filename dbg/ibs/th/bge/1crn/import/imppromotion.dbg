      489   if valid-object (v-objlist9) then do: // gifts - подарки на всю акцию
      490       v-promo-gifts = v-promo-action:gifts .
      491       v-i-counter = v-objlist9:iCounter .
      492       do v-i-num = 1 to v-i-counter :
      493         v-stub = v-objlist9:Get(v-i-num) . // возвращает кол-во элементов и переключает currItem
      494         v-gift-gd = cast(v-objlist9:SubjectObjCurr, ibs.th.bge.1crn.subjects.promotion_gift-gd) .
      495         assign
      496           v-promo-gift = new ibs.th.ref.promo.promoGiftsub ()
      497           v-gds-code   = integer(v-gift-gd:gd-code)
      498         .
      499         if not can-find (first buf_goods where buf_goods.gds-code = v-gds-code) then
      500         undo, throw new Progress.Lang.AppError( substitute(
      501           "Код товара [&1] из промо-акции [&2] отсутствует в справочнике товаров."
      502           , v-gds-code, objImp:name_
      503         ) ) .
      504         assign
      505           v-promo-gift:GdsCode = v-gds-code
      506           v-promo-gift:qnty    = v-gift-gd:gd-qnty
      507           v-promo-gift:Mode    = 'с':U
      508         .
      509      if v-ban-recipes then do:
      510      if can-find (first buf_goods-attr no-lock where buf_goods-attr.gds-code = v-promo-gift:GdsCode and
      511         buf_goods-attr.attr-code = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" and
      512         buf_goods-attr.attr-value <> "") then
      513      do:
      514         v-promo-action:end-date = today - 1 .
      515         v-promo-action:status_ = 2 .
