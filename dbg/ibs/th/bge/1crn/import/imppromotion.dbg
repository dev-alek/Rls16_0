      521       v-storage = new ibs.th.gbl.storage.promoactionstorage () .
      522       // если прочитанная акция ранее присутствовала в БД - сначала удаляем её, затем - создаём;
      523       // если прочитанная акция пришла впервые - создаём её как новую
      524       if valid-object(v-promo-delete)
      525       then do:
      526          define variable mStorsed as class ibs.th.gbl.storage.promoSchedstorage NO-UNDO.
      527          mstorsed = new ibs.th.gbl.storage.promoSchedstorage().
      528          v-promo-delete:refreshChildObj().
      529          mstorsed:deleteDB(v-promo-delete:Schedule) .
      530          delete object  mStorsed.
      531          v-storage:deleteDB(v-promo-delete) .
      532       end.
      533       v-storage:insertDB(v-promo-action) .
      534           find first buf_PromoAttr exclusive-lock  where
      535           buf_PromoAttr.attr-code = "charge-BL" and
      536           buf_promoAttr.tablename = "PromoPay" and
      537           v-promo-action:ID = int64(entry(1,buf_PromoAttr.p-key,chr(3))) and
      538           v-db-num = integer(entry(2,buf_PromoAttr.p-key,chr(3))) no-error .
      539           if not available (buf_PromoAttr) then do:
      540       create buf_promoAttr.
      541       assign
      542         buf_promoAttr.attr-code  = "charge-BL"
      543         buf_promoAttr.tablename  = "PromoPay"
      544         buf_promoAttr.p-key      = string(v-promo-action:ID) + chr(3) +
      545                             string(v-db-num)
      546       no-error .
      547           end.
      548           buf_PromoAttr.attr-value  = if objImp:prohibition-charge-BL = 1 then string(true) else string(false)
      549           .
      550       define variable mDelCd as logical no-undo.
      551       mDelCd =
      552                 (v-promo-action:changeDate <> ?
      553              and v-promo-action:changeDate <= today)
      554               or  v-promo-action:end-date  < today
      555               or  v-promo-action:status_enum = enum-promo-status:encompleted.
      556       if v-message then
      557       do:
      558          create ub.PromoAttr .
      559          assign
      560              ub.PromoAttr.tablename  = "PromoAction"
      561              ub.PromoAttr.p-key      = string(v-promo-action:ID) + chr(3) + string(v-promo-action:db-num)
      562              ub.PromoAttr.attr-code  = "promo-message"
      563              ub.PromoAttr.attr-value = "Внимание!!! Перезагрузите кассу, для обновления промоакций!"
      564              .
      565       end.
      566       define variable mImp2CdH as handle no-undo.
      567       run str/imp2cdgeth.p(output mImp2CdH).
      568       if v-promo-action:status_enum = enum-promo-status:encompleted or (v-promo-action:status_enum = enum-promo-status:enactive and v-promo-action:changeDate <> ?) then
      569       do:
      570         run fill-PromoAction in mImp2CdH (v-promo-action:ID, v-promo-action:db-num).
      571       end.
      572       v-retfl = true .
      573       catch exAppErrors as class Progress.Lang.AppError :
      574         Msg = exAppErrors:ReturnValue .
      575         if Msg = "" then Msg = exAppErrors:GetMessage(1) .
      576         v-retfl = false.
      577         undo, throw exAppErrors .
      578       end catch .
      579       catch exProErrors as class Progress.Lang.ProError :
      580         Msg = exProErrors:GetMessage(1) .
      581         v-retfl = false.
      582         undo, throw exProErrors .
      583       end catch .
      584       catch exAnyErrors as class Progress.Lang.Error:
      585         Msg = "Unexpected error occurred..." .
      586         v-retfl = false.
      587         undo, throw exAnyErrors .
      588       end catch .
      589       finally :
      590         if valid-object(v-storage)      then delete object v-storage .
      591         if valid-object(v-promo-delete) then delete object v-promo-delete .
      592         if valid-object(v-promo-action) then delete object v-promo-action .
      593         return v-retfl.
      594       end finally .
      595     end method.
      596     method private enum-promo-status getPromoStatus (input p-status as integer):
      597       define variable v-promo-status as enum-promo-status no-undo .
      598       case p-status:
      599         when 0 then // 0 – настройки в работе. Присылать из 1С если акция была сохранена, но потом опять переведена в настройки
      600           v-promo-status = enum-promo-status:ensetting .
      601         when 1 then // 1 – настройки выполнены
      602           v-promo-status = enum-promo-status:enactive .
      603         when 2 then // 2 – акция заблокирована (при досрочном погашении или другом виде удаления\блокировки акции)
      604           v-promo-status = enum-promo-status:encompleted .
      605       end case .
      606       return v-promo-status .
      607     end method. // end_of getPromoStatus
      608     method private enum-sched-status getSchedStatus (input p-promo-status as enum-promo-status) :
      609       define variable v-sched-status as enum-sched-status no-undo .
      610       case p-promo-status:
      611         when enum-promo-status:ensetting then
      612           v-sched-status = enum-sched-status:ensetting .
      613         when enum-promo-status:enactive or
      614         when enum-promo-status:encompleted then
      615           v-sched-status = enum-sched-status:enactive .
      616       end case .
      617       return v-sched-status .
      618     end method. // end_of getSchedStatus
      619     method private integer parseTime (input p-time-str as character):
      620       define variable v-time as integer no-undo .
      621         v-time = integer(substring(p-time-str, 1, 2)) * 3600 +
      622                  integer(substring(p-time-str, 4, 2)) * 60 +
      623                  integer(substring(p-time-str, 7, 2)) .
      624       return v-time.
      625     end method. // end_of parseTime
      626   end class.
