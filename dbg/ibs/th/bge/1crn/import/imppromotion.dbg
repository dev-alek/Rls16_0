      426         v-paymentsystem = cast(v-paymentsystems:SubjectObjCurr, ibs.th.bge.1crn.subjects.payment-system) .
      427         v-bins-tokens = v-paymentsystem:bins-tokens.
      428         v-j-counter = v-bins-tokens:iCounter .
