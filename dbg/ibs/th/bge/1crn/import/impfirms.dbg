        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impfirms implements ibs.th.bge.1crn.import.iimpsubject:
        5   method private void getAttrLib ():
        6      define variable g#attr-lib  as handle no-undo .
        7      run gbl/getgattrlib.p (output g#attr-lib).
        8   end.
        9     define property Msg as character no-undo
       10       get.
       11       set.
       12     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       13       define variable v-mode       as character no-undo .
       14       define variable v-rid        as recid no-undo .
       15       define variable v-is-deploy  as logical no-undo .
       16       define variable v-host-code  as integer no-undo .
       17       define variable v-retfl      as logical no-undo .
       18       define buffer buf_sysconf for ub.sysconf .
       19       define buffer buf_firm    for ub.firm .
       20       define buffer buf_clients for ub.clients .
       21       define variable v-avrg-price    as logical no-undo .
       22       define variable v-artic-disable as logical no-undo .
       23       define variable v-base-code     as integer no-undo .
       24       define variable v-branch        as character no-undo .
       25       define variable v-cash-pay      as integer no-undo .
       26       define variable v-cashier       as character no-undo .
       27       define variable v-cons-vat-pc   as decimal decimals 10 no-undo .
       28       define variable v-credit-pay    as integer no-undo .
       29       define variable v-firm-db-num   as integer no-undo .
       30       define variable v-head-position as character no-undo .
       31       define variable v-KOPF          as character no-undo .
       32       define variable v-negative-rest as logical no-undo .
       33       define variable v-ord-prt       as logical no-undo .
       34       define variable v-osn-base      as logical no-undo .
       35       define variable v-property      as character no-undo .
       36       define variable v-purch-code    as integer no-undo .
       37       define variable v-ret-credit-pay as integer no-undo .
       38       define variable v-sale-type     as character no-undo .
       39       define variable v-sale-code     as integer no-undo .
       40       define variable v-snr-accnt     as character no-undo .
       41       define variable v-SOEI          as character no-undo .
       42       define variable v-transport-cli-type as character no-undo .
       43       define variable v-transport-cli-code as integer no-undo .
       44       define variable v-transport-host     as integer no-undo .
       45       define variable v-transport-contract as integer no-undo .
       46       define variable v-transport-uslov    as integer no-undo .
       47       define variable v-transport-value    as decimal decimals 2 no-undo .
       48       define variable v-main-obj-type      as character no-undo .
       49       define variable v-main-obj-code      as integer no-undo .
       50       define variable v-als-gds            as logical no-undo .
       51       define variable varals-gds-str       as character no-undo .
       52       define variable varals-gds-str-type  as character no-undo .
       53       define variable v-egrip-date         as date no-undo .
       54       define variable v-egrip-date-str     as character no-undo .
       55       define variable var-type             as character no-undo .
       56       define variable v-egrip-num          as character no-undo .
       57       define variable v-gen-s-f-office     as logical no-undo .
       58       define variable v-cli-grp-name       as character no-undo .
       59       define variable obj-cli-grp as class cli-grps no-undo .
       60       define variable imp-cli-grp as class ibs.th.bge.1crn.import.impcli-grps no-undo .
       61       define variable obj-clients as class clients no-undo .
       62       define variable imp-clients as class ibs.th.bge.1crn.import.impclients no-undo .
       63       define variable objImp as class firms no-undo.
       64       objImp = cast (subjectObj, firms).
       65       if objImp:del-f > 0 then do:
       66         Msg = "физическое удаление фирм не предусмотрено".
       67         v-retfl = false .
       68         return false.
       69       end.
       70       assign
       71         v-host-code = integer(objImp:code_)
       72         Msg = ""
       73       .
       74       if v-host-code > 0 then . else undo, throw new Progress.Lang.AppError("Не задан код фирмы") .
       75       find first buf_sysconf no-lock where buf_sysconf.host-code = v-host-code no-error .
       76       if objImp:del-l > 0 then do:
       77         find first buf_clients no-lock
       78              where buf_clients.obj-type = 'орг':U
       79                and buf_clients.obj-code = v-host-code no-error .
       80         if not available buf_clients then undo, throw new Progress.Lang.AppError(
       81           substitute("Не найдена запись КЛИЕНТ для записи СВОЯ ФИРМА с кодом [&1]", v-host-code)
       82         ) .
       83         if buf_clients.stts = 0 then do:
       84                 run ref/clients2.p
       85              (input ?
       86              ,input recid(buf_clients)
       87              ,input 1
       88              ,input true
       89              ,input no
       90              ,input '':U
       91              ,input '':U
       92              ,input '':U
       93              ) .
       94         end.
       95       end.
       96       else if (available buf_sysconf) and (objImp:del-l = 0) then do:
       97         find first buf_clients no-lock
       98              where buf_clients.obj-type = 'орг':U
       99                and buf_clients.obj-code = v-host-code no-error .
      100         if not available buf_clients then undo, throw new Progress.Lang.AppError(
      101           substitute("Не найдена запись КЛИЕНТ для записи СВОЯ ФИРМА с кодом [&1]", v-host-code)
      102         ) .
      103         if buf_clients.stts <> 0 then do:
      104           run ref/clients2.p
      105           (input ?
      106           ,input recid(buf_clients)
      107           ,input 0
      108           ,input true
      109           ,input no
      110           ,input '':U
      111           ,input '':U
      112           ,input '':U
      113           ) .
      114         end.
      115       end .
      116       if available buf_sysconf then do:
      117           find first buf_firm no-lock where buf_firm.firm-code = v-host-code no-error .
      118           if not available buf_firm then undo, throw new Progress.Lang.AppError(
      119             substitute("Не найдена запись ФИРМА для записи СВОЯ ФИРМА с кодом [&1]", v-host-code)
      120           ) .
      121                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      122           (input  'орг':U
      123           ,input  v-host-code
      124           ,input  'als-gds':U
      125           ,output varals-gds-str
      126           ,output varals-gds-str-type
      127           ) .
      128                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      129           (input  'орг':U
      130           ,input  v-host-code
      131           ,input  'egrip-date':U
      132           ,output v-egrip-date-str
      133           ,output var-type
      134           ) .
      135                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      136           (input  'орг':U
      137           ,input  v-host-code
      138           ,input  'egrip-num':U
      139           ,output v-egrip-num
      140           ,output var-type
      141           ) .
      142           assign
      143             v-mode      = 'ИЗМЕНЕНИЕ':U
      144             v-is-deploy = false
      145             v-rid       = recid(buf_sysconf)
      146             v-avrg-price    = buf_sysconf.avrg-price
      147             v-artic-disable = buf_sysconf.artic-disable
      148             v-base-code     = buf_sysconf.base-code
      149             v-branch        = buf_sysconf.branch
      150             v-cash-pay      = buf_sysconf.cash-pay
      151             v-cashier       = buf_sysconf.cashier
      152             v-cons-vat-pc   = buf_sysconf.cons-vat-pc
      153             v-credit-pay    = buf_sysconf.credit-pay
      154             v-firm-db-num   = buf_sysconf.firm-db-num
      155             v-head-position = buf_sysconf.head-position
      156             v-KOPF          = buf_sysconf.KOPF
      157             v-negative-rest = buf_sysconf.negative-rest
      158             v-ord-prt       = buf_sysconf.ord-prt
      159             v-osn-base      = buf_sysconf.osn-base
      160             v-property      = buf_sysconf.property
      161             v-purch-code    = buf_sysconf.purch-code
      162             v-ret-credit-pay = buf_sysconf.ret-credit-pay
      163             v-sale-type     = buf_sysconf.sale-type
      164             v-sale-code     = buf_sysconf.sale-code
      165             v-snr-accnt     = buf_sysconf.snr-accnt
      166             v-SOEI          = buf_sysconf.SOEI
      167             v-transport-cli-type = buf_sysconf.transport-cli-type
      168             v-transport-cli-code = buf_sysconf.transport-cli-code
      169             v-transport-host     = buf_sysconf.transport-host
      170             v-transport-contract = buf_sysconf.transport-contract
      171             v-transport-uslov    = buf_sysconf.transport-uslov
      172             v-transport-value    = buf_sysconf.transport-value
      173             v-main-obj-type = buf_firm.main-obj-type
      174             v-main-obj-code = buf_firm.main-obj-code
      175             v-als-gds       = (varals-gds-str = "yes")
      176             v-egrip-date    = date( v-egrip-date-str )
      177             v-gen-s-f-office = buf_sysconf.gen-s-f-office
      178           .
      179       end.
      180       else do:
      181           assign
      182             v-cli-grp-name = replace ( objImp:name_  , '/', '' )
      183             v-cli-grp-name = replace ( v-cli-grp-name, '\', '' )
      184             v-cli-grp-name = replace ( v-cli-grp-name, ':', '' )
      185             v-cli-grp-name = replace ( v-cli-grp-name, '*', '' )
      186             v-cli-grp-name = replace ( v-cli-grp-name, '?', '' )
      187             v-cli-grp-name = replace ( v-cli-grp-name, '"', '' )
      188             v-cli-grp-name = replace ( v-cli-grp-name, '<', '' )
      189             v-cli-grp-name = replace ( v-cli-grp-name, '>', '' )
      190             v-cli-grp-name = replace ( v-cli-grp-name, '|', '' )
      191             v-cli-grp-name = replace ( v-cli-grp-name, '«', '' )
      192             v-cli-grp-name = replace ( v-cli-grp-name, '»', '' )
      193             v-cli-grp-name = replace ( v-cli-grp-name, '·', '' )
      194           .
      195           obj-cli-grp = new cli-grps ().
      196           obj-cli-grp:SetProp(obj-cli-grp:InitTag, "").
      197           obj-cli-grp:SetProp("code",       string(v-host-code)).
      198           obj-cli-grp:SetProp("upper-code", "2").
      199           obj-cli-grp:SetProp("del-l",      "0").
      200           obj-cli-grp:SetProp("del-f",      "0").
      201           obj-cli-grp:SetProp("name",       v-cli-grp-name).
      202           obj-cli-grp:SetProp(obj-cli-grp:InitTag, "").
      203           imp-cli-grp = new ibs.th.bge.1crn.import.impcli-grps ().
      204           v-retfl = imp-cli-grp:Excute(obj-cli-grp).
      205           if not v-retfl then
      206             undo, throw new Progress.Lang.AppError(imp-cli-grp:Msg) .
      207           assign
      208             v-mode      = 'ДОБАВЛЕНИЕ':U
      209             v-is-deploy = true
      210             v-rid       = ?
      211             v-avrg-price    = no
      212             v-artic-disable = no
      213             v-base-code     = 0
      214             v-branch        = ""
      215             v-cash-pay      = 0
      216             v-cashier       = ""
      217             v-cons-vat-pc   = 0.0
      218             v-credit-pay    = 0
      219             v-firm-db-num   = 0
      220             v-head-position = ""
      221             v-KOPF          = ""
      222             v-negative-rest = no
      223             v-ord-prt       = no
      224             v-osn-base      = no
      225             v-property      = ""
      226             v-purch-code    = 1
      227             v-ret-credit-pay = 0
      228             v-sale-type     = 'орг':U
      229             v-sale-code     = 800000001
      230             v-snr-accnt     = ""
      231             v-SOEI          = ""
      232             v-transport-cli-type = ""
      233             v-transport-cli-code = 0
      234             v-transport-host     = 0
      235             v-transport-contract = 0
      236             v-transport-uslov    = 0
      237             v-transport-value    = 0.0
      238             v-main-obj-type = ""
      239             v-main-obj-code = 0
      240             v-als-gds       = no
      241             v-egrip-date    = ?
      242             v-egrip-num     = ""
      243             v-gen-s-f-office = yes
      244           .
      245       end.
      246         obj-clients = new clients ().
      247         obj-clients:SetProp(obj-clients:InitTag, "").
      248         obj-clients:SetProp("code",         objImp:code_).
      249         obj-clients:SetProp("del-l", string(objImp:del-l)).
      250         obj-clients:SetProp("del-f", string(objImp:del-f)).
      251         obj-clients:SetProp("name",         objImp:name_).
      252         obj-clients:SetProp("full-name",    objImp:name_).
      253         obj-clients:SetProp("city",      objImp:city).
      254         obj-clients:SetProp("ind",       objImp:ind).
      255         obj-clients:SetProp("inn",       objImp:inn).
      256         obj-clients:SetProp("kpp",       objImp:kpp).
      257         obj-clients:SetProp("agnt",      objImp:agnt).
      258         obj-clients:SetProp("post-adr",  objImp:post-adr).
      259         obj-clients:SetProp("e-mail",    objImp:e-mail).
      260         obj-clients:SetProp("leg-adr",   objImp:leg-adr).
      261         obj-clients:SetProp("okpo",      objImp:okpo).
      262         obj-clients:SetProp(obj-clients:InitTag, "").
      263         imp-clients = new ibs.th.bge.1crn.import.impclients ().
      264         v-retfl = imp-clients:Excute(obj-clients).
      265         if not v-retfl then undo, throw new Progress.Lang.AppError(imp-clients:Msg) .
      266         run adm/sysconf1.p
      267         (input-output v-rid
      268         ,input v-mode
      269         ,input yes
      270         ,input v-is-deploy
      271         ,input v-host-code
      272         ,input v-host-code
      273         ,input objImp:name_
      274         ,input v-avrg-price
      275         ,input v-artic-disable
      276         ,input v-base-code
      277         ,input v-branch
      278         ,input v-cash-pay
      279         ,input v-cashier
      280         ,input v-cons-vat-pc
      281         ,input v-credit-pay
      282         ,input v-firm-db-num
      283         ,input v-head-position
      284         ,input v-KOPF
      285         ,input v-negative-rest
      286         ,input v-ord-prt
      287         ,input v-osn-base
      288         ,input v-property
      289         ,input v-purch-code
      290         ,input v-ret-credit-pay
      291         ,input v-sale-type
      292         ,input v-sale-code
      293         ,input v-snr-accnt
      294         ,input v-SOEI
      295         ,input v-transport-cli-type
      296         ,input v-transport-cli-code
      297         ,input v-transport-host
      298         ,input v-transport-contract
      299         ,input v-transport-uslov
      300         ,input v-transport-value
      301         ,input v-main-obj-type
      302         ,input v-main-obj-code
      303         ,input v-als-gds
      304         ,input v-egrip-date
      305         ,input v-egrip-num
      306         ,input yes
      307         ) .
      308         v-retfl = true .
      309       catch exAppErrors as class Progress.Lang.AppError :
      310         Msg = exAppErrors:ReturnValue .
      311         if Msg > "" then . else do :
      312           Msg = exAppErrors:GetMessage(1) .
      313           if Msg > "" then . else Msg = "AppError в фирмах" .
      314         end .
      315         v-retfl = false .
      316         undo, throw exAppErrors .
      317       end catch .
      318       catch exProErrors as class Progress.Lang.ProError :
      319         Msg = exProErrors:GetMessage(1) .
      320         if Msg > "" then . else Msg = "ProError в фирмах" .
      321         v-retfl = false .
      322         undo, throw exProErrors .
      323       end catch .
      324       catch exAnyErrors as class Progress.Lang.Error:
      325         Msg = "Unexpected error в фирмах" .
      326         v-retfl = false .
      327         undo, throw exAnyErrors .
      328       end catch .
      329       finally :
      330         if valid-object(imp-clients) then delete object imp-clients .
      331         if valid-object(obj-clients) then delete object obj-clients .
      332         if valid-object(imp-cli-grp) then delete object imp-cli-grp .
      333         if valid-object(obj-cli-grp) then delete object obj-cli-grp .
      334         return v-retfl .
      335       end finally .
      336     end method.
      337   end class.
