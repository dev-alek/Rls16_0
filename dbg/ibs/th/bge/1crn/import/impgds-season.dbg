        1   using Progress.Lang.*.
        2   using ibs.th.gbl.*.
        3   using ibs.th.bge.1crn.subjects.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impgds-season implements ibs.th.bge.1crn.import.iimpsubject:
        6     define property Msg as character no-undo
        7       get.
        8       set.
        9     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       10                   define buffer buf_season for ub.season .
       11                   define buffer buf_goods for ub.goods .
       12                   define buffer buf_gds-season for ub.gds-season .
       13                   define buffer buf_blob-data for ub.blob-data.
       14       define buffer self_blob-bind for ub.blob-bind.
       15       define variable objGds-season as class     gds-season no-undo.
       16       define variable keyrecObj as class keyrec no-undo.
       17       define variable keyrec as character no-undo.
       18       define variable v-dir-name as character no-undo .
       19       define variable v-dir1-name as character no-undo .
       20       define variable v-file-name as character no-undo .
       21       define variable v-param-type as character no-undo .
       22       define variable v-value-character as character no-undo .
       23       define variable v-value-date as date no-undo .
       24       define variable v-value-decimal as decimal no-undo .
       25       define variable v-value-integer as INTEGER no-undo .
       26       define variable v-value-logical AS LOGICAL no-undo .
       27       define variable v-tth as handle no-undo .
       28       objGds-season = cast (subjectObj, gds-season).
       29       find first ub.clients no-lock where ub.clients.db-num   = ibs.th.gbl.gbl-var:g#db-num
       30                                       and ub.clients.obj-type = 'маг':U
       31                                       and ub.clients.stts = 0  no-error.
       32       if not available ub.clients
       33       then do:
       34         Msg = substitute("Не найден ни один активный магазин для бд &1", ibs.th.gbl.gbl-var:g#db-num ) .
       35         undo, return false .
       36       end.
       37       delete object v-tth no-error.
       38       run adm/shattri.p (
       39              input "get":U
       40             ,input ub.clients.obj-type
       41             ,input ub.clients.obj-code
       42             ,input 'gds-ref_obj':U
       43             ,input 'image-dir':U
       44             ,output v-value-character
       45             ,output v-value-date
       46             ,output v-value-decimal
       47             ,output v-value-integer
       48             ,output v-value-logical
       49             ,output v-param-type
       50             ,INPUT-OUTPUT table-handle v-tth
       51             ) no-error .
       52       delete object v-tth no-error.
       53       if trim(v-value-character) > ""
       54       then do :
       55         v-dir1-name = trim(v-value-character, "\") .
       56         v-dir1-name = trim(v-dir1-name, "/") .
       57         v-dir1-name = v-dir1-name + "\" .
       58         v-dir-name = v-dir1-name + "gds\" .
       59       end.
       60       else do :
       61         v-dir1-name = "C:\TB-image\" .
       62         v-dir-name = "C:\TB-image\gds\" .
       63       end.
       64       if objGds-season:del-f = 1
       65       or objGds-season:del-l = 1
       66       then
       67       do:
       68         find first buf_gds-season where buf_gds-season.sea-code = integer(objGds-season:Tbg-code)
       69                                    and buf_gds-season.gds-code = integer(objGds-season:gds-code) no-error .
       70         if AVAILABLE buf_gds-season then
       71         do:
       72           v-file-name = v-dir-name + string(buf_gds-season.gds-code) + ".png" .
       73           os-delete value(v-file-name) no-error .
       74           delete buf_gds-season .
       75         end.
       76       end.
       77       else
       78       do:
       79         find first buf_goods no-lock where buf_goods.gds-code = integer(objGds-season:gds-code) no-error .
       80         if not available buf_goods
       81         then do:
       82           Msg = substitute("Не найден товар с кодом &1", objGds-season:gds-code ) .
       83           undo, return false .
       84         end.
       85         find first buf_season where buf_season.sea-code = integer(objGds-season:Tbg-code) no-error .
       86         if AVAILABLE buf_season then
       87         do:
       88           find first buf_gds-season where buf_gds-season.sea-code = integer(objGds-season:Tbg-code)
       89                                       and buf_gds-season.gds-code = integer(objGds-season:gds-code) no-error .
       90           if not available buf_gds-season
       91           then do :
       92             create buf_gds-season .
       93             assign
       94               buf_gds-season.db-num   = gbl-var:g#db-num
       95               buf_gds-season.sea-code = integer(objGds-season:Tbg-code)
       96               buf_gds-season.gds-code = integer(objGds-season:gds-code)
       97             .
       98           end .
       99           assign buf_gds-season.min-stock = 0 .
      100           v-file-name = v-dir-name + string(buf_gds-season.gds-code) + ".png" .
      101           keyrecObj = new keyrec ().
      102           keyrecObj:GenKeyRec('goods':U, buffer buf_goods:handle, output keyrec).
      103           delete object keyrecObj.
      104           find first self_blob-bind  no-lock where
      105                   self_blob-bind.uniq-key-rec = keyrec
      106               and self_blob-bind.field-name = 'gds-collec-image':U
      107               and self_blob-bind.part-num = 1
      108               no-error.
      109           if available self_blob-bind then do:
      110             find first buf_blob-data  no-lock where
      111                   buf_blob-data.db-num = self_blob-bind.db-num
      112               and buf_blob-data.int64-id = self_blob-bind.int64-id no-error.
      113           end.
      114           if available buf_blob-data then do:
      115             COPY-LOB
      116               FROM  OBJECT buf_blob-data.bdata
      117               TO    FILE   v-file-name
      118               No-convert
      119               NO-ERROR .
      120             if error-status :error
      121             then do :
      122               os-delete value(v-file-name) .
      123               if os-error <> 0
      124               then do :
      125                 Msg =  substitute("Не могу обновить изображение &1",v-file-name) .
      126                 return false .
      127               end.
      128               COPY-LOB
      129                 FROM  OBJECT buf_blob-data.bdata
      130                 TO    FILE   v-file-name
      131                 No-convert
      132                 NO-ERROR .
      133               if error-status :error
      134               then do :
      135                 Msg =  substitute("Не могу сохранить изображение &1",v-file-name) .
      136                 return false .
      137               end .
      138             end .
      139           end .
      140         end.
      141         else
      142         do:
      143           Msg = "Не найдена коллекция с кодом " + objGds-season:Tbg-code .
      144           return false .
      145         end.
      146         return true.
      147       end.
      148     end method.
      149   end class.
