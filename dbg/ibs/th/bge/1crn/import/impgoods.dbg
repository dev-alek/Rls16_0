        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.impgoods implements ibs.th.bge.1crn.import.iimpsubject:
        5     define property Msg as character no-undo
        6       get.
        7       set.
        8     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9         define buffer buf_goods for ub.goods.
       10         define buffer buf_bar-code for ub.bar-code.
       11         define buffer buf_prod-bc for ub.prod-bc.
       12         define variable objGoods as class goods no-undo .
       13         define variable v-stts            as integer      no-undo .
       14         define variable v-is-petrol       as logical      no-undo.
       15         define variable v-is-pieces       as logical      no-undo.
       16         objGoods = cast (subjectObj, goods).
       17         find first buf_goods no-lock where buf_goods.gds-code = integer(objGoods:code_) no-error.
       18         if available buf_goods and buf_goods.stts = integer('1':U)
       19         then do :
       20             v-stts = integer('0':U) .
       21             run ref/goods02.p (
       22                       input recid(buf_goods)
       23                       ,input yes
       24                       ,input-output v-stts) no-error.
       25   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in ibs.th.gbl.gbl-hndllib:g#lib-trn
       26     (
       27        input buf_goods.artic
       28     ,  input buf_goods.prod-type
       29     ,  input buf_goods.prod-code
       30     , output v-is-petrol
       31     , output v-is-pieces
       32     ) .
       33             if v-is-petrol = yes
       34             then do:
       35               Msg = includeShortBarCode(buf_goods.gds-code).
       36               if Msg <> "" then
       37                 return false.
       38             end.
       39         end.
       40         run ref/imp-goods-1C-RN.p (input objGoods) no-error .
       41         if error-status:error
       42         then do :
       43             Msg = return-value + " " + error-status:get-message (1) .
       44             return false.
       45         end.
       46         if objGoods:del-f = 1
       47         or objGoods:del-l = 1
       48         then do :
       49             find first buf_goods no-lock where buf_goods.gds-code = integer(objGoods:code_) no-error.
       50             if not available buf_goods
       51             then do :
       52                 Msg = ("Нет товара с кодом " + objGoods:code_ + " . Удаление невозможно") .
       53                 return false .
       54             end.
       55             for each buf_bar-code no-lock where buf_bar-code.gds-code = integer(objGoods:code_),
       56               each buf_prod-bc exclusive-lock where buf_prod-bc.b-code = buf_bar-code.b-code :
       57                  buf_prod-bc.bc-on = false .
       58             end.
       59             v-stts = integer('1':U) .
       60             run ref/goods02.p (
       61                       input recid(buf_goods)
       62                       ,input yes
       63                       ,input-output v-stts) no-error.
       64         end.
       65         return true .
       66         catch exAppErrors as class Progress.Lang.AppError :
       67            Msg = exAppErrors:ReturnValue .
       68            if Msg > "" then . else do :
       69               Msg = exAppErrors:GetMessage(1) .
       70               if Msg > "" then . else Msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\bge\1crn\import\impgoods.cls" .
       71            end .
       72            return false.
       73         end catch .
       74         catch exProErrors as class Progress.Lang.ProError :
       75            msg = exProErrors:GetMessage(1) .
       76            if msg > "" then . else msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\bge\1crn\import\impgoods.cls" .
       77            return false.
       78         end catch .
       79         catch exAnyErrors as class Progress.Lang.Error:
       80            msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\bge\1crn\import\impgoods.cls " + exAnyErrors:GetMessage(1).
       81            return false.
       82         end catch .
       83     end method.
       84     method private character includeShortBarCode(
       85       input iGdsCode like ub.goods.gds-code
       86     ):
       87       define variable vError     as  character no-undo.
       88       define buffer buf_bar-code for ub.bar-code .
       89       define buffer buf_prod-bc  for ub.prod-bc .
       90       for each buf_bar-code where
       91                buf_bar-code.gds-code = iGdsCode
       92           no-lock,
       93           each buf_prod-bc where
       94                buf_prod-bc.b-code = buf_bar-code.b-code
       95           exclusive-lock:
       96          if length(buf_prod-bc.b-str) <= 2 then
       97          do:
       98             buf_prod-bc.bc-on = true.
       99             validate buf_prod-bc no-error.
      100             if error-status:error then do:
      101               vError = substitute("&1;&2", vError, error-status:get-message(1)).
      102             end.
      103          end.
      104       end.
      105       return left-trim(vError, ";").
      106     end method.
      107   end class.
