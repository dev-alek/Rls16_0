        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   block-level on error undo, throw.
        4   class ibs.th.bge.1crn.import.imptransport implements ibs.th.bge.1crn.import.iimpsubject:
        5      define property Msg as character no-undo
        6         get.
        7         set.
        8      method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
        9         define variable v-transport  as class   transport                           no-undo.
       10         define variable v-section    as class   transport_section                   no-undo.
       11         define variable v-ct-lvl     as class   transport_section_calibration-table no-undo.
       12         define variable v_sections   as class   subjects                            no-undo.
       13         define variable v_CalibTable as class   subjects                            no-undo.
       14         define variable ii           as integer no-undo .
       15         define variable jj           as integer no-undo .
       16         define variable kk           as integer no-undo .
       17         define variable is-create    as logical no-undo .
       18         define buffer buf_auto-tank          for ub.auto-tank .
       19         define buffer buf_auto-section       for ub.auto-section .
       20         define buffer buf_auto-tank-attr     for ub.auto-tank-attr .
       21         define buffer buf_auto-section-table for ub.auto-section-table .
       22         define buffer buf_clients            for ub.clients .
       23         v-transport = cast (subjectObj, transport).
       24         v_sections = v-transport:sections .
       25         v_CalibTable = v-transport:calibration-table .
       26         if v-transport:del-f = 1 then
       27         do:
       28            Msg = "Нет физического удаления автотранспорта".
       29         end.
       30         else
       31         do:
       32            find first buf_auto-tank EXCLUSIVE-LOCK where buf_auto-tank.auto-num = v-transport:reg-num no-error .
       33            if not AVAILABLE (buf_auto-tank) then
       34            do:
       35               create buf_auto-tank .
       36               buf_auto-tank.auto-num = v-transport:reg-num .
       37            end.
       38            assign
       39               buf_auto-tank.status_   = if v-transport:del-l = 1 then 'удал':U else 'тек':U
       40               buf_auto-tank.name      = v-transport:name_
       41               buf_auto-tank.firm-type = 'орг':U
       42               buf_auto-tank.firm-code = integer(v-transport:tr-owner)
       43               buf_auto-tank.type-AC   = v-transport:ac-type
       44               buf_auto-tank.type-neck = v-transport:neck-type
       45               .
       46            find first buf_auto-tank-attr EXCLUSIVE-LOCK where buf_auto-tank-attr.auto-num = buf_auto-tank.auto-num and buf_auto-tank-attr.attr-code = "auto-error" no-error .
       47            if not AVAILABLE (buf_auto-tank-attr) then
       48            do:
       49               create buf_auto-tank-attr.
       50               assign
       51                  buf_auto-tank-attr.attr-code = "auto-error"
       52                  buf_auto-tank-attr.auto-num  = buf_auto-tank.auto-num
       53                  .
       54            end.
       55            buf_auto-tank-attr.attr-value = string(v-transport:me-vlm) .
       56            find first buf_auto-tank-attr EXCLUSIVE-LOCK where buf_auto-tank-attr.auto-num = buf_auto-tank.auto-num and buf_auto-tank-attr.attr-code = "auto-temp" no-error .
       57            if not AVAILABLE (buf_auto-tank-attr) then
       58            do:
       59               create buf_auto-tank-attr.
       60               assign
       61                  buf_auto-tank-attr.attr-code = "auto-temp"
       62                  buf_auto-tank-attr.auto-num  = buf_auto-tank.auto-num
       63                  .
       64            end.
       65            buf_auto-tank-attr.attr-value = string(v-transport:ac-tk) .
       66            find first buf_auto-tank-attr EXCLUSIVE-LOCK where buf_auto-tank-attr.auto-num = buf_auto-tank.auto-num and buf_auto-tank-attr.attr-code = "auto-sep" no-error .
       67            if not AVAILABLE (buf_auto-tank-attr) then
       68            do:
       69               create buf_auto-tank-attr.
       70               assign
       71                  buf_auto-tank-attr.attr-code = "auto-sep"
       72                  buf_auto-tank-attr.auto-num  = buf_auto-tank.auto-num
       73                  .
       74            end.
       75            if v-transport:ess <> 1 then buf_auto-tank-attr.attr-value = "no" .
       76            else buf_auto-tank-attr.attr-value = "yes" .
       77            find first buf_auto-tank-attr EXCLUSIVE-LOCK where buf_auto-tank-attr.auto-num = buf_auto-tank.auto-num and buf_auto-tank-attr.attr-code = "valve" no-error .
       78            if not AVAILABLE (buf_auto-tank-attr) then
       79            do:
       80               create buf_auto-tank-attr.
       81               assign
       82                  buf_auto-tank-attr.attr-code = "valve"
       83                  buf_auto-tank-attr.auto-num  = buf_auto-tank.auto-num
       84                  .
       85            end.
       86            if v-transport:valve <> 1 then buf_auto-tank-attr.attr-value = "no" .
       87            else buf_auto-tank-attr.attr-value = "yes" .
       88            if v-transport:con-sleeve > 0
       89            then do :
       90              find first buf_auto-tank-attr EXCLUSIVE-LOCK where buf_auto-tank-attr.auto-num = buf_auto-tank.auto-num and buf_auto-tank-attr.attr-code = "con-sleeve" no-error .
       91              if not AVAILABLE (buf_auto-tank-attr) then
       92              do:
       93                 create buf_auto-tank-attr.
       94                 assign
       95                    buf_auto-tank-attr.attr-code = "con-sleeve"
       96                    buf_auto-tank-attr.auto-num  = buf_auto-tank.auto-num
       97                    .
       98              end.
       99              buf_auto-tank-attr.attr-value = string(v-transport:con-sleeve) .
      100            end .
      101            for each buf_auto-section where buf_auto-section.auto-num = v-transport:reg-num:
      102               delete buf_auto-section .
      103            end.
      104            for each buf_auto-section-table where buf_auto-section-table.auto-num = v-transport:reg-num:
      105               delete buf_auto-section-table .
      106            end.
      107            if VALID-OBJECT (v_sections) then
      108            do:
      109               buf_auto-tank.brutto-qnty = 0 .
      110               do ii = 1 to v_sections:Get(ii):
      111                  v-section = cast(v_sections:SubjectObjCurr, transport_section) .
      112                  find first buf_auto-section EXCLUSIVE-LOCK where buf_auto-section.auto-num = v-transport:reg-num and
      113                     buf_auto-section.section-num = v-section:sec-num no-error .
      114                  if not AVAILABLE (buf_auto-section) then
      115                  do:
      116                     create buf_auto-section.
      117                     buf_auto-section.auto-num = v-transport:reg-num .
      118                     buf_auto-section.section-num = v-section:sec-num .
      119                  end.
      120                  ASSIGN
      121                     buf_auto-section.brutto-qnty = v-section:capacity
      122                     buf_auto-section.add-volume  = v-section:pipe-vlm
      123                     buf_auto-tank.brutto-qnty    = buf_auto-tank.brutto-qnty + v-section:capacity.
      124                  .
      125                  case buf_auto-tank.type-neck:
      126                     when 1 then
      127                        do:
      128                           assign
      129                              buf_auto-section.length        = v-section:length_
      130                              buf_auto-section.width         = v-section:width_
      131                              buf_auto-section.section-depth = v-section:wall
      132                              .
      133                        end.
      134                     when 2 then
      135                        do:
      136                           assign
      137                              buf_auto-section.diameter-max  = v-section:length_
      138                              buf_auto-section.diameter-min  = v-section:width_
      139                              buf_auto-section.section-depth = v-section:wall
      140                              .
      141                        end.
      142                     when 3 then
      143                        do:
      144                           assign
      145                              buf_auto-section.diameter-min  = v-section:diameter
      146                              buf_auto-section.length  = v-section:circumference
      147                              buf_auto-section.section-depth = v-section:wall
      148                              .
      149                        end.
      150                     when 0 then
      151                        do:
      152                           if buf_auto-tank.type-AC = 1 then
      153                           do:
      154                              if VALID-OBJECT (v_CalibTable) then
      155                              do:
      156                                 do jj = 1 to v_CalibTable:Get(jj):
      157                                    v-ct-lvl = cast(v_CalibTable:SubjectObjCurr, transport_section_calibration-table) .
      158                                    if v-ct-lvl:sec-num = v-section:sec-num then
      159                                    do:
      160                                       find first buf_auto-section-table EXCLUSIVE-LOCK where buf_auto-section-table.auto-num = v-transport:reg-num and
      161                                          buf_auto-section-table.section-num = v-ct-lvl:sec-num and
      162                                          buf_auto-section-table.error = v-ct-lvl:deviation no-error .
      163                                       IF NOT AVAILABLE (buf_auto-section-table) THEN
      164                                       DO:
      165                                          create buf_auto-section-table .
      166                                          assign
      167                                             buf_auto-section-table.auto-num    = v-transport:reg-num
      168                                             buf_auto-section-table.section-num = v-ct-lvl:sec-num
      169                                             buf_auto-section-table.error       = v-ct-lvl:deviation
      170                                             .
      171                                       end.
      172                                       assign
      173                                          buf_auto-section-table.volume-error = v-ct-lvl:amount
      174                                          buf_auto-section-table.volume-between = v-ct-lvl:deltaV * 100
      175                                       .
      176                                    end.
      177                                 end.
      178                              end.
      179                              do kk = -10 to 10:
      180                                 find first ub.auto-section-table exclusive-lock where ub.auto-section-table.auto-num = v-transport:reg-num
      181                                    and ub.auto-section-table.section-num = v-section:sec-num
      182                                    and ub.auto-section-table.error = kk no-error .
      183                                 if not available (ub.auto-section-table) then
      184                                 do:
      185                                    create ub.auto-section-table .
      186                                    assign
      187                                       ub.auto-section-table.auto-num     = v-transport:reg-num
      188                                       ub.auto-section-table.section-num  = v-section:sec-num
      189                                       ub.auto-section-table.error        = kk
      190                                       ub.auto-section-table.volume-error = 0
      191                                       .
      192                                 end.
      193                              end.
      194                           end.
      195                        end.
      196                  end case .
      197               end.
      198            end.
      199         end.
      200      end method.
      201   end class.
