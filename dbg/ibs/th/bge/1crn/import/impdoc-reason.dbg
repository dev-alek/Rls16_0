        1   using Progress.Lang.*.
        2   using ibs.th.bge.1crn.subjects.*.
        3   using ibs.th.gbl.*.
        4   block-level on error undo, throw.
        5   class ibs.th.bge.1crn.import.impdoc-reason implements ibs.th.bge.1crn.import.iimpsubject:
        6     define buffer buf_trn-reason for ub.trn-reason .
        7     define property Msg as character no-undo
        8       get.
        9       set.
       10     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       11       define variable ri           as recid no-undo .
       12       define variable objDoc-reason as class doc-reason no-undo.
       13       objDoc-reason = cast (subjectObj, doc-reason).
       14       if objDoc-reason:code_ = "" or objDoc-reason:code_ = ? then
       15       do:
       16         Msg = "ќснование/причина создани€ документа не задано".
       17         return error Msg .
       18       end.
       19       if objDoc-reason:name_ = "" or objDoc-reason:name_ = ? then
       20       do:
       21         Msg = "ќснование/причина создани€ документа с кодом " + objDoc-reason:code_ + ". Ќе задано название" .
       22         return error Msg .
       23       end.
       24       if objDoc-reason:del-f = 0
       25       then do:
       26         find first buf_trn-reason exclusive-lock where buf_trn-reason.reason-code = integer(objDoc-reason:code_) no-error .
       27         if not available buf_trn-reason
       28         then do :
       29           create buf_trn-reason .
       30           assign buf_trn-reason.reason-code = integer(objDoc-reason:code_) .
       31         end .
       32         assign
       33           buf_trn-reason.reason-name = objDoc-reason:name_
       34           buf_trn-reason.PS = if objDoc-reason:description_ <> ? then objDoc-reason:description_ else ""
       35         .
       36       end.
       37       else do:
       38         find first buf_trn-reason exclusive-lock where buf_trn-reason.reason-code = integer(objDoc-reason:code_) no-error .
       39         if not available buf_trn-reason
       40         then do :
       41           Msg = "”даление основани€/причины создани€ документа с кодом " + objDoc-reason:code_ + " не возможно" .
       42           return error Msg.
       43         end.
       44         else
       45           delete buf_trn-reason
       46         .
       47       end.
       48     end method.
       49   end class.
