        1   using Progress.Lang.*.
        2   using ibs.th.gbl.gbl-var.
        3   using ibs.th.ref.typl-ad.
        4   using ibs.th.bge.1crn.subjects.*.
        5   block-level on error undo, throw.
        6   class ibs.th.bge.1crn.import.impshops implements ibs.th.bge.1crn.import.iimpsubject:
        7   method private void getAttrLib ():
        8      define variable g#attr-lib  as handle no-undo .
        9      run gbl/getgattrlib.p (output g#attr-lib).
       10   end.
       11   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       13     // thbjattr_thbj-attr
       14     define property Msg as character no-undo
       15       get.
       16       set.
       17   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
       18   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
       19   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
       20   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
       21     method public logical Excute( subjectObj as class ibs.th.bge.1crn.subjects.isubject ):
       22       define variable v-mode      as character no-undo.
       23       define variable v-rid1      as recid no-undo .
       24       define variable v-rid2      as recid no-undo .
       25       define variable v-obj-code  as integer no-undo .
       26       define variable v-db-num    as integer no-undo .
       27       define variable v-host-code as integer no-undo .
       28       define variable v-grp-code  as integer no-undo .
       29       define variable v-addr1     as character no-undo .
       30       define variable v-addr2     as character no-undo .
       31       define variable v-tel       as character no-undo .
       32       define variable v-retfl     as logical no-undo .
       33       define buffer buf_shop    for ub.shop .
       34       define buffer buf_clients for ub.clients .
       35       define variable v-ps             as character no-undo .
       36       define variable v-all-prt        as logical no-undo .
       37       define variable v-buy-goods      as logical no-undo .
       38       define variable v-cd-bc-alt      as logical no-undo .
       39       define variable v-cd-bc-base     as logical no-undo .
       40       define variable v-cd-loc-alt     as logical no-undo .
       41       define variable v-cd-loc-base    as logical no-undo .
       42       define variable v-cd-parts-all   as logical no-undo .
       43       define variable v-cd-parts-not-blank as logical no-undo .
       44       define variable v-cd-parts-ser   as logical no-undo .
       45       define variable v-cd-pb-alt      as logical no-undo .
       46       define variable v-cd-pb-base     as logical no-undo .
       47       define variable v-cd-sc-base     as logical no-undo .
       48       define variable v-chk-pay        as integer no-undo .
       49       define variable v-day-only       as logical no-undo .
       50       define variable v-discaloc       as logical no-undo .
       51       define variable v-doc-prt        as logical no-undo .
       52       define variable v-down-pay       as integer no-undo .
       53       define variable v-fax            as character no-undo .
       54       define variable v-goods-man      as character no-undo .
       55       define variable v-in-ov          as logical no-undo .
       56       define variable v-in-pay         as integer no-undo .
       57       define variable v-in-perm        as logical no-undo .
       58       define variable v-inout-price    as logical no-undo .
       59       define variable v-inv-pay        as integer no-undo .
       60       define variable v-is-catering        as logical no-undo .
       61       define variable v-is-kitchen         as logical no-undo .
       62       define variable v-is-kitchen-store   as logical no-undo .
       63       define variable v-kitchen-store-code as integer no-undo .
       64       define variable v-kitchen-store-type as character no-undo .
       65       define variable v-no-eq          as logical no-undo .
       66       define variable v-out-line-discnt as logical no-undo .
       67       define variable v-out-pay        as integer no-undo .
       68       define variable v-out-rate       as logical no-undo .
       69       define variable v-pr-cash        as logical no-undo .
       70       define variable v-price-calc     as logical no-undo .
       71       define variable v-ret-pay        as integer no-undo .
       72       define variable v-ret-sup-pay    as integer no-undo .
       73       define variable v-fbr-pay        as integer no-undo .
       74       define variable v-rsrv-time      as integer no-undo .
       75       define variable v-shift-on       as logical no-undo .
       76       define variable v-store-boss     as character no-undo .
       77       define variable v-store-man      as character no-undo .
       78       define variable v-sub-store-on   as logical no-undo .
       79       define variable v-sub-store-code as integer no-undo .
       80       define variable v-sub-store-type as character no-undo .
       81       define variable v-unit-cli-perm  as logical no-undo .
       82       define variable v-with-serv      as logical no-undo .
       83       define variable v-work-hours     as character no-undo .
       84       define variable v-purch-code     as integer no-undo .
       85       define variable v-envd           as logical no-undo .
       86       define variable v-envd-str       as character no-undo .
       87       define variable v-par-type       as character no-undo .
       88       define variable v-pharm          as logical no-undo .
       89       define variable v-pharm-str      as character no-undo .
       90       define variable v-KPP            as character no-undo .
       91       define variable v-clim-grp       as character no-undo .
       92       define variable v-decommissioned as logical no-undo .
       93       define variable v-decommiss-str  as character no-undo .
       94       define variable v-begin-summer   as character no-undo .
       95       define variable v-begin-winter   as character no-undo .
       96       define variable v-edi            as logical   no-undo .
       97       define variable objImp as class shops no-undo.
       98       objImp = cast (subjectObj, shops).
       99       if objImp:del-f > 0 then do:
      100         Msg = "физичесткое удаление АЗС/АЗК не предусмотрено" .
      101         v-retfl = false .
      102         return false.
      103       end .
      104       assign
      105         v-obj-code  = integer(objImp:code_)
      106       .
      107       if v-obj-code > 0 then . else undo, throw new Progress.Lang.AppError("Не задан код АЗК/АЗС") .
      108       if (objImp:clim-grp > "") and (not can-do("1 (1),1 (2),2 (1),2 (2),2 (3),3 (1),3 (2)", objImp:clim-grp)) then do :
      109         undo, throw new Progress.Lang.AppError(
      110           substitute("значение clim-grp = [&1] отсутствует в обозначении климатических групп", objImp:clim-grp)
      111         ) .
      112       end .
      113       find first buf_shop no-lock where buf_shop.obj-code = v-obj-code no-error .
      114       find first buf_clients no-lock
      115            where buf_clients.obj-type = 'маг':U
      116              and buf_clients.obj-code = v-obj-code no-error .
      117       if objImp:del-l > 0  then do:
      118         if available buf_clients and buf_clients.stts = 0 then do:
      119           run ref/clients2.p
      120           (input ?
      121           ,input recid(buf_clients)
      122           ,input 1
      123           ,input true
      124           ,input yes
      125           ,input '':U
      126           ,input '':U
      127           ,input '':U
      128           ) .
      129         end .
      130         else undo, throw new Progress.Lang.AppError(
      131           substitute("Не найдена запись КЛИЕНТ для записи МАГАЗИН с кодом [&1]", v-obj-code)
      132         ) .
      133       end .
      134       else if (available buf_shop) and (objImp:del-l = 0) then do:
      135         if available buf_clients then do:
      136           if buf_clients.stts <> 0 then do:
      137             run ref/clients2.p
      138             (input ?
      139             ,input recid(buf_clients)
      140             ,input 0
      141             ,input true
      142             ,input yes
      143             ,input '':U
      144             ,input '':U
      145             ,input '':U
      146             ) .
      147           end.
      148         end .
      149         else undo, throw new Progress.Lang.AppError(
      150           substitute("Не найдена запись КЛИЕНТ для записи МАГАЗИН с кодом [&1]", v-obj-code)
      151         ) .
      152       end .
      153       assign
      154         Msg = ""
      155         v-host-code = integer(objImp:frm-code)
      156         v-db-num    = v-obj-code
      157         v-grp-code  = v-host-code
      158       .
      159       if available buf_shop then do:
      160         if available buf_clients then do:
      161           assign
      162             v-rid2 = recid(buf_clients)
      163             v-ps   = buf_clients.PS
      164           .
      165         end .
      166         else undo, throw new Progress.Lang.AppError(
      167           substitute("Не найдена запись КЛИЕНТ для записи МАГАЗИН с кодом [&1]", v-obj-code)
      168         ) .
      169                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      170         (input 'маг':U
      171         ,input  v-obj-code
      172         ,input  'envd':U
      173         ,output v-envd-str
      174         ,output v-par-type
      175         ) .
      176                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      177         (input 'маг':U
      178         ,input  v-obj-code
      179         ,input  'pharm':U
      180         ,output v-pharm-str
      181         ,output v-par-type
      182         ) .
      183                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      184         (input 'маг':U
      185         ,input  v-obj-code
      186         ,input  'kpp':U
      187         ,output v-KPP
      188         ,output v-par-type
      189         ) .
      190                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      191         (input 'маг':U
      192         ,input  v-obj-code
      193         ,input  'cli-clim-grp':U
      194         ,output v-clim-grp
      195         ,output v-par-type
      196         ) .
      197                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
      198         (input 'маг':U
      199         ,input  v-obj-code
      200         ,input  'cli-decommissioned':U
      201         ,output v-decommiss-str
      202         ,output v-par-type
      203         ) .
      204         sliceAddress
      205            ( input  objImp:address
      206            , input  buf_shop.addres1
      207            , input  buf_shop.addres2
      208            , output v-addr1
      209            , output v-addr2
      210            ) .
      211         assign
      212           v-tel = if objImp:tel >= "" then objImp:tel else buf_shop.phone
      213         .
      214         assign
      215           v-chk-pay        = buf_shop.chk-pay
      216           v-down-pay       = buf_shop.down-pay
      217           v-in-pay         = buf_shop.in-pay
      218           v-inv-pay        = buf_shop.inv-pay
      219           v-out-pay        = buf_shop.out-pay
      220           v-ret-pay        = buf_shop.ret-pay
      221           v-ret-sup-pay    = buf_shop.ret-sup-pay
      222           v-fbr-pay        = buf_shop.fbr-pay
      223         .
      224         assign
      225           v-mode = 'ИЗМЕНЕНИЕ':U
      226           v-all-prt         = buf_shop.all-prt
      227           v-buy-goods       = buf_shop.buy-goods
      228           v-cd-bc-alt       = buf_shop.cd-bc-alt
      229           v-cd-bc-base      = buf_shop.cd-bc-base
      230           v-cd-loc-alt      = buf_shop.cd-loc-alt
      231           v-cd-loc-base     = buf_shop.cd-loc-base
      232           v-cd-parts-all    = buf_shop.cd-parts-all
      233           v-cd-parts-not-blank = buf_shop.cd-parts-not-blank
      234           v-cd-parts-ser    = buf_shop.cd-parts-ser
      235           v-cd-pb-alt       = buf_shop.cd-pb-alt
      236           v-cd-pb-base      = buf_shop.cd-pb-base
      237           v-cd-sc-base      = buf_shop.cd-sc-base
      238           v-day-only        = buf_shop.day-only
      239           v-discaloc        = buf_shop.discaloc
      240           v-doc-prt         = buf_shop.doc-prt
      241           v-fax             = buf_shop.fax
      242           v-goods-man       = buf_shop.goods-man
      243           v-in-ov           = buf_shop.in-ov
      244           v-in-perm         = buf_shop.in-perm
      245           v-inout-price     = buf_shop.inout-price
      246           v-is-catering        = buf_shop.is-catering
      247           v-is-kitchen         = buf_shop.is-kitchen
      248           v-is-kitchen-store   = buf_shop.is-kitchen-store
      249           v-kitchen-store-code = buf_shop.kitchen-store-code
      250           v-kitchen-store-type = buf_shop.kitchen-store-type
      251           v-no-eq           = buf_shop.no-eq
      252           v-out-line-discnt = buf_shop.out-line-discnt
      253           v-out-rate        = buf_shop.out-rate
      254           v-pr-cash         = buf_shop.pr-cash
      255           v-price-calc      = buf_shop.price-calc
      256           v-rsrv-time       = buf_shop.rsrv-time
      257           v-shift-on        = buf_shop.shift-on
      258           v-store-boss      = buf_shop.store-boss
      259           v-store-man       = buf_shop.store-man
      260           v-sub-store-on    = buf_shop.sub-store-on
      261           v-sub-store-code  = buf_shop.sub-store-code
      262           v-sub-store-type  = buf_shop.sub-store-type
      263           v-unit-cli-perm   = buf_shop.unit-cli-perm
      264           v-with-serv       = buf_shop.with-serv
      265           v-work-hours      = buf_shop.work-hours
      266           v-purch-code      = buf_shop.purch-code
      267           v-envd            = (v-envd-str = "yes":u)
      268           v-pharm           = (v-pharm-str = "yes":u)
      269           v-decommissioned  = (v-decommiss-str = "yes":u)
      270         .
      271         if num-entries(v-clim-grp) = 3 then assign
      272           v-begin-summer = entry(2, v-clim-grp)
      273           v-begin-winter = entry(3, v-clim-grp)
      274           v-clim-grp     = entry(1, v-clim-grp)
      275         .
      276         assign
      277           v-clim-grp       = objImp:clim-grp     when objImp:clim-grp > ""
      278           v-begin-summer   = objImp:begin-summer when objImp:begin-summer > ""
      279           v-begin-winter   = objImp:begin-winter when objImp:begin-winter > ""
      280           v-decommissioned = (objImp:decommissioned > 0) when (objImp:decommissioned <> ?)
      281           v-edi            = (objImp:edi > 0) when (objImp:edi <> ?)
      282           v-KPP            = objImp:kpp when objImp:kpp > ""
      283         .
      284       end .
      285       else do :
      286         assign
      287           v-mode = 'ДОБАВЛЕНИЕ':U
      288           v-rid1 = ?
      289         .
      290         run adm/db01.p
      291         (input-output v-rid1
      292         ,input v-mode
      293         ,input v-db-num
      294         ,input objImp:name_
      295         ,input true
      296         ,input true
      297         ,input true
      298         ,10
      299         ) .
      300         sliceAddress
      301            ( input  objImp:address
      302            , input  ""
      303            , input  ""
      304            , output v-addr1
      305            , output v-addr2
      306            ) .
      307         assign
      308           v-in-pay         = 2
      309           v-out-pay        = 2
      310           v-ret-pay        = 2
      311           v-ret-sup-pay    = 3
      312           v-down-pay       = 2
      313           v-inv-pay        = 2
      314           v-chk-pay        = 1
      315           v-fbr-pay        = 2
      316         .
      317         assign
      318           v-tel = if objImp:tel >= "" then objImp:tel else ""
      319           v-clim-grp       = objImp:clim-grp
      320           v-begin-summer   = objImp:begin-summer
      321           v-begin-winter   = objImp:begin-winter
      322           v-decommissioned = if objImp:decommissioned > 0 then true else ?
      323           v-edi            = if objImp:edi > 0 then true else ?
      324           v-KPP = if objImp:kpp >= "" then objImp:kpp else ""
      325         .
      326         assign
      327           v-rid2 = ?
      328           v-ps             = ""
      329           v-all-prt        = false
      330           v-buy-goods      = true
      331           v-cd-bc-alt      = false
      332           v-cd-bc-base     = true
      333           v-cd-loc-alt     = false
      334           v-cd-loc-base    = true
      335           v-cd-parts-all   = false
      336           v-cd-parts-not-blank = false
      337           v-cd-parts-ser   = false
      338           v-cd-pb-alt      = false
      339           v-cd-pb-base     = true
      340           v-cd-sc-base     = true
      341           v-day-only       = yes
      342           v-discaloc       = yes
      343           v-doc-prt        = no
      344           v-fax            = ""
      345           v-goods-man      = ""
      346           v-in-ov          = no
      347           v-in-perm        = no
      348           v-inout-price    = yes
      349           v-is-catering        = yes
      350           v-is-kitchen         = no
      351           v-is-kitchen-store   = no
      352           v-kitchen-store-code = 0
      353           v-kitchen-store-type = ""
      354           v-no-eq           = yes
      355           v-out-line-discnt = no
      356           v-out-rate       = no
      357           v-pr-cash        = yes
      358           v-price-calc     = no
      359           v-rsrv-time      = 0
      360           v-shift-on       = yes
      361           v-store-boss     = ""
      362           v-store-man      = ""
      363           v-sub-store-on   = no
      364           v-sub-store-code = 0
      365           v-sub-store-type = ""
      366           v-unit-cli-perm  = yes
      367           v-with-serv      = yes
      368           v-work-hours     = ""
      369           v-purch-code     = ?
      370           v-envd           = no
      371           v-pharm          = no
      372         .
      373       end.
      374       run adm/shop01.p
      375       (input-output v-rid2
      376       ,input v-mode
      377       ,input v-obj-code
      378       ,input v-db-num
      379       ,input v-host-code
      380       ,input v-grp-code
      381       ,input objImp:name_
      382       ,input v-ps
      383       ,input objImp:accr
      384       ,input v-addr1
      385       ,input v-addr2
      386       ,input v-all-prt
      387       ,input v-buy-goods
      388       ,input v-cd-bc-alt
      389       ,input v-cd-bc-base
      390       ,input v-cd-loc-alt
      391       ,input v-cd-loc-base
      392       ,input v-cd-parts-all
      393       ,input v-cd-parts-not-blank
      394       ,input v-cd-parts-ser
      395       ,input v-cd-pb-alt
      396       ,input v-cd-pb-base
      397       ,input v-cd-sc-base
      398       ,input v-chk-pay
      399       ,input v-day-only
      400       ,input objImp:director
      401       ,input v-discaloc
      402       ,input v-doc-prt
      403       ,input v-down-pay
      404       ,input v-fax
      405       ,input v-goods-man
      406       ,input v-in-ov
      407       ,input v-in-pay
      408       ,input v-in-perm
      409       ,input v-inout-price
      410       ,input v-inv-pay
      411       ,input v-is-catering
      412       ,input v-is-kitchen
      413       ,input v-is-kitchen-store
      414       ,input v-kitchen-store-code
      415       ,input v-kitchen-store-type
      416       ,input v-no-eq
      417       ,input v-out-line-discnt
      418       ,input v-out-pay
      419       ,input v-out-rate
      420       ,input v-tel
      421       ,input v-pr-cash
      422       ,input v-price-calc
      423       ,input v-ret-pay
      424       ,input v-ret-sup-pay
      425       ,input v-fbr-pay
      426       ,input v-rsrv-time
      427       ,input v-shift-on
      428       ,input v-store-boss
      429       ,input v-store-man
      430       ,input v-sub-store-on
      431       ,input v-sub-store-code
      432       ,input v-sub-store-type
      433       ,input v-unit-cli-perm
      434       ,input v-with-serv
      435       ,input v-work-hours
      436       ,input v-purch-code
      437       ,INPUT v-envd
      438       ,INPUT v-pharm
      439       ,input v-KPP
      440       ) .
      441       for first buf_shop exclusive-lock
      442           where buf_shop.obj-code = v-obj-code:
      443         assign
      444           buf_shop.is-kitchen         = yes
      445           buf_shop.kitchen-store-type = 'маг':U
      446           buf_shop.kitchen-store-code = v-obj-code
      447         .
      448       end.
      449       If objimp:hist-code ne ?
      450       then do:
      451           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run db-attr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib  ( input v-db-num
      452                                           , input 'hist-code':U
      453                                           , input objimp:hist-code
      454                                           ) no-error .
      455       end.
      456       If objimp:hist-name ne ?
      457       then do:
      458           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run db-attr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib  ( input v-db-num
      459                                           , input 'hist-name':U
      460                                           , input objimp:hist-name
      461                                           ) no-error .
      462        end.
      463                if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib
      464         (input 'маг':U
      465         ,input v-obj-code
      466         ,input 'cli-clim-grp':U
      467         ,input substitute("&1,&2,&3", v-clim-grp, v-begin-summer, v-begin-winter)
      468         ) .
      469         if v-decommissioned <> ? then do :
      470                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run clntattr-write in ibs.th.gbl.gbl-hndllib:g#attr-lib
      471         (input 'маг':U
      472         ,input v-obj-code
      473         ,input 'cli-decommissioned':U
      474         ,input string(v-decommissioned)
      475         ) .
      476         end .
      477       define buffer buf_sysconf for ub.sysconf .
      478       define variable v-param-type as character no-undo .
      479       define variable v-value-character as character no-undo .
      480       define variable v-value-date as date no-undo .
      481       define variable v-value-decimal as decimal no-undo .
      482       define variable v-value-integer as INTEGER no-undo .
      483       define variable v-value-logical AS LOGICAL no-undo .
      484       define variable v-tth as handle no-undo .
      485       v-tth = buffer thbjattr_thbj-attr:table-handle .
      486       empty temp-table thbjattr_thbj-attr .
      487       run adm/shattri.p (
      488               input "init":U
      489             , input 'маг':U
      490             , input v-obj-code
      491             , input 'marking':U
      492             , input "":U
      493             , output v-value-character
      494             , output v-value-date
      495             , output v-value-decimal
      496             , output v-value-integer
      497             , output v-value-logical
      498             , output v-param-type
      499             , INPUT-OUTPUT table-handle v-tth
      500             ) no-error .
      501       if error-status:error then do:
      502         undo, throw new Progress.Lang.AppError(
      503           substitute(  "Ошибка чтения начальных значений настроек работы со справочниками товаров в контексте объекта [&1 &2]",
      504                        error-status:get-message(1), return-value  )
      505         ) .
      506       end .
      507       FOR EACH thbjattr_thbj-attr:
      508         case thbjattr_thbj-attr.prop-code :
      509           when 'marking-EDO':U then do: // объект работает с EDI
      510             thbjattr_thbj-attr.property-value-logical = v-edi .
      511             define variable mImp2CdH as handle no-undo.
      512             run str/imp2cdgeth.p(output mImp2CdH).
      513             run fill-setting in mImp2CdH ('thbj-attr':U,
      514                                        'маг':U,
      515                                        v-obj-code,
      516                                        thbjattr_thbj-attr.upper-prop-code,
      517                                        thbjattr_thbj-attr.prop-code).
      518           end.
      519         end case .
      520       END .
      521       thbjattr_set-section ('маг':U, v-obj-code, 'marking':U, input table thbjattr_thbj-attr) .
      522       if v-mode = 'ДОБАВЛЕНИЕ':U then do :
      523         v-tth = buffer thbjattr_thbj-attr:table-handle .
      524         empty temp-table thbjattr_thbj-attr .
      525         run adm/shattri.p (
      526                 input "init":U
      527               , input 'маг':U
      528               , input v-obj-code
      529               , input 'gds-ref_obj':U
      530               , input "":U
      531               , output v-value-character
      532               , output v-value-date
      533               , output v-value-decimal
      534               , output v-value-integer
      535               , output v-value-logical
      536               , output v-param-type
      537               , INPUT-OUTPUT table-handle v-tth
      538               ) no-error .
      539         if error-status:error then do:
      540           undo, throw new Progress.Lang.AppError(
      541             substitute(  "Ошибка чтения начальных значений настроек работы со справочниками товаров в контексте объекта [&1 &2]",
      542                          error-status:get-message(1), return-value  )
      543           ) .
      544         end .
      545         FOR EACH thbjattr_thbj-attr:
      546           case thbjattr_thbj-attr.prop-code :
      547             when 'chg-bcod':U then // Запрещена работа с Доп-БК
      548               thbjattr_thbj-attr.property-value-logical = true .
      549           end case .
      550         END .
      551         thbjattr_set-section ('маг':U, v-obj-code, 'gds-ref_obj':U, input table thbjattr_thbj-attr) .
      552         empty temp-table thbjattr_thbj-attr .
      553       end . // end_of опции при создании объекта
      554       define variable proc-typl-ad as class typl-ad no-undo .
      555       define variable v-plt-id     as integer no-undo .
      556       define variable v-plt-recid  as recid no-undo .
      557       proc-typl-ad = new typl-ad () .
      558       if v-mode = 'ДОБАВЛЕНИЕ':U then do :
      559         v-plt-id = next-value (s-plt, ub)  .
      560         proc-typl-ad:type-price-list-ADD
      561         (input v-plt-id
      562         ,input v-db-num
      563         ,substitute("ГТПЛ по объекту &1&2", 'маг':U, v-obj-code)
      564         ,0
      565         ,'Отключено':U
      566         ,0.0
      567         ,0.0
      568         ,'Отсутствует':U
      569         ,1
      570         ,false
      571         ,false
      572         ,true
      573         ,0
      574         ,v-db-num
      575         ,0
      576         ,1
      577         ,0
      578         ,?
      579         ,?
      580         ,1
      581         ,1
      582         ,0
      583         ,0
      584         ,0
      585         ,0
      586         ,0
      587         ,0
      588         ,0
      589         ,v-db-num
      590         ,0
      591         ,false
      592         ,v-db-num
      593         ,0
      594         ,0
      595         ,v-db-num
      596         ,0
      597         ,?
      598         ,v-db-num
      599         ,0
      600         ,v-db-num
      601         ,0
      602         ,0
      603         ,0
      604         ,v-db-num
      605         ,0
      606         ,2
      607         ,v-db-num
      608         ,0
      609         ,gbl-var:g#userid
      610         ,0
      611       ,output v-plt-recid
      612        ,input table TT_cassa
      613        ,input table TT_grp
      614        ,input table TT_pay-type
      615        ,input table TT_cash-pay
      616         ) .
      617       end .
      618       v-retfl = true.
      619       catch exAppErrors as class Progress.Lang.AppError :
      620         define variable v-is-delim as logical no-undo .
      621         v-is-delim = (num-entries(exAppErrors:ReturnValue, chr(4)) > 1) .
      622         Msg = if v-is-delim then entry(2, exAppErrors:ReturnValue, chr(4)) else exAppErrors:ReturnValue .
      623         if Msg > "" then . else do :
      624           Msg = exAppErrors:GetMessage(1) .
      625           if Msg > "" then . else Msg = "AppError в АЗС АЗК" .
      626         end .
      627         v-retfl = false .
      628         undo, throw exAppErrors .
      629       end catch .
      630       catch exProErrors as class Progress.Lang.ProError :
      631         Msg = exProErrors:GetMessage(1) .
      632         if Msg > "" then . else Msg = "ProError в АЗС АЗК" .
      633         v-retfl = false.
      634         undo, throw exProErrors .
      635       end catch .
      636       catch exAnyErrors as class Progress.Lang.Error:
      637         Msg = "Unexpected error в АЗС АЗК" .
      638         v-retfl = false .
      639         undo, throw exAnyErrors .
      640       end catch .
      641       finally :
      642         if valid-object(proc-typl-ad) then delete object proc-typl-ad .
      643         return v-retfl .
      644       end finally .
      645     end method.
      646     method private void sliceAddress (input p-address   as character,
      647                                       input p-curraddr1 as character,
      648                                       input p-curraddr2 as character,
      649                                      output p-addr1     as character,
      650                                      output p-addr2     as character) :
      651       if p-address > "" then assign
      652         p-addr1 = substring(p-address,  1, 63)
      653         p-addr2 = substring(p-address, 64)
      654       .
      655       else if p-address = "" then assign
      656         p-addr1 = ""
      657         p-addr2 = ""
      658       .
      659       else assign
      660         p-addr1 = p-curraddr1
      661         p-addr2 = p-curraddr2
      662       .
      663     end method .
      664     method private void thbjattr_get-section (input p-obj-type   as character,
      665                                               input p-obj-code   as integer,
      666                                               input p-upper-code as character,
      667                                               output table-handle p-tth) :
      668     end method .
      669     method private void thbjattr_set-section (input p-obj-type   as character,
      670                                               input p-obj-code   as integer,
      671                                               input p-upper-code as character,
      672                                               input table-handle p-tth) :
      673       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run thbjattr_set-section in ibs.th.gbl.gbl-hndllib:g#attr-lib
      674       (input  p-obj-type
      675       ,input  p-obj-code
      676       ,input  p-upper-code
      677       ,input  table-handle p-tth
      678       ) .
      679     end method .
      680   end class.
