     2958                           .
     2959                       end.
     2960                       otherwise do:
     2961                           assign
     2962                               p-out-string = p-out-string + v-current-char
     2963                           .
     2964                       end.
     2965                   end case.
     2966               end.
     2967           end.
     2968       end case.
     2969   end.
     2970   return p-out-string.
     2971   end .
     2972   method private void xmlchar-decode (input  p-in-string          as character,
     2973                                     output p-out-string         as character):
     2974       define variable v-position      as integer      no-undo.
     2975       define variable v-last-position as integer      no-undo.
     2976       define variable v-temp-integer  as integer      no-undo.
     2977       define variable v-current-char  as character    no-undo.
     2978       define variable v-next-char     as character    no-undo.
     2979       define variable v-success       as logical      no-undo.
     2980   do
     2981   on error undo, return error
     2982   :
     2983       assign
     2984           p-out-string = "":U
     2985           v-position   = 0
     2986       .
     2987       replace-cycle:
     2988       do while yes
     2989       on error undo, return error
     2990       :
     2991           assign
     2992               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2993           .
     2994           if v-last-position <= v-position
     2995           then do:
     2996               if v-position = 0
     2997               then do:
     2998                   assign
     2999                       p-out-string = p-in-string
     3000                   .
     3001               end.
     3002               else do:
     3003                   assign
     3004                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3005                   .
     3006               end.
     3007               leave replace-cycle.
     3008           end.
     3009           else do:
     3010               assign
     3011                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3012                   v-position      = v-last-position
     3013                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3014               .
     3015               if v-current-char = "#":U
     3016               then do:
     3017                   assign
     3018                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3019                   .
     3020                   if v-last-position > 0
     3021                   then do:
     3022                       xmlchar-read-integer
     3023                        (
     3024                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3025                           , output v-temp-integer
     3026                           , output v-success
     3027                       ).
     3028                       if v-success = yes
     3029                       and v-temp-integer >= 1
     3030                       and v-temp-integer <= 255
     3031                       then do:
     3032                           assign
     3033                               p-out-string = p-out-string + chr( v-temp-integer )
     3034                               v-position   = v-last-position + 1
     3035                           .
     3036                       end.
     3037                       else do:
     3038                           assign
     3039                               p-out-string = p-out-string + "&":U
     3040                               v-position   = v-position   + 1
     3041                           .
     3042                       end.
     3043                   end.
     3044                   else do:
     3045                       assign
     3046                           p-out-string = p-out-string + "&":U
     3047                           v-position   = v-position   + 1
     3048                       .
     3049                   end.
     3050               end.
     3051               else do:
     3052                   case substring( p-in-string, v-position + 1, 3 )
     3053                   :
     3054                       when "lt;":U
     3055                       then do:
     3056                           assign
     3057                               p-out-string = p-out-string + "<":U
     3058                               v-position   = v-position   + 3
     3059                           .
     3060                       end.
     3061                       when "gt;":U
     3062                       then do:
     3063                           assign
     3064                               p-out-string = p-out-string + ">":U
     3065                               v-position   = v-position   + 3
     3066                           .
     3067                       end.
     3068                       otherwise do:
     3069                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3070                           then do:
     3071                               assign
     3072                                   p-out-string = p-out-string + "&":U
     3073                                   v-position   = v-position   + 4
     3074                               .
     3075                           end.
     3076                           else do:
     3077                               case substring( p-in-string, v-position + 1, 5 )
     3078                               :
     3079                                   when "quot;":U
     3080                                   then do:
     3081                                       assign
     3082                                           p-out-string = p-out-string + '"':U
     3083                                           v-position   = v-position   + 5
     3084                                       .
     3085                                   end.
     3086                                   when "apos;":U
     3087                                   then do:
     3088                                       assign
     3089                                           p-out-string = p-out-string + "'":U
     3090                                           v-position   = v-position   + 5
     3091                                       .
     3092                                   end.
     3093                                   otherwise do:
     3094                                       assign
     3095                                           p-out-string = p-out-string + "&":U
     3096                                       .
     3097                                   end.
     3098                               end case.
     3099                           end.
     3100                       end.
     3101                   end case.
     3102               end.
     3103           end.
     3104       end.
     3105   end.
     3106   end .
     3107   method private void xmlchar-read-integer (input  p-input-string       as character,
     3108                                             output p-output-integer     as integer,
     3109                                             output p-success            as logical):
     3110   do
     3111   on error undo, return error
     3112   :
     3113       assign
     3114           p-output-integer = integer( p-input-string )
     3115       no-error.
     3116       if error-status :error
     3117       then do:
     3118           assign
     3119               p-success           = no
     3120               p-output-integer    = 0
     3121           .
     3122       end.
     3123       else do:
     3124           assign
     3125               p-success           = yes
     3126           .
     3127       end.
     3128   end.
     3129   end.
     3130   define variable mMRCCode  as logical    no-undo.
     3131   define variable mTypeMark as character  no-undo.
     3132   method private logical IS-NeedMark
     3133   ( input ib-code as integer  ,
     3134     input ib-str as character ):
     3135      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3136      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3137                                    and buf_prod-bc-attr.b-str  eq ib-str
     3138                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3139        no-lock no-error.
     3140      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3141   end.
     3142   method private character repTegforDm
     3143   (iDM as char ):
     3144       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3145       define variable vteg as character no-undo.
     3146       define variable oDM as character no-undo.
     3147       define variable vi as integer no-undo.
     3148       oDM = iDm.
     3149       do vi = 1 to num-entries(vTeglist):
     3150          vTeg = entry(vi,vTeglist).
     3151          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3152       end.
     3153       return oDM.
     3154   end.
     3155   method private character repSpecSimbforDm
     3156   (iDM as char ):
     3157       define variable oDM as character no-undo.
     3158       xmlchar-decode(iDM, output oDM).
     3159     return repTegforDm (oDM).
     3160   end.
     3161   method private logical CheckGtin
     3162   (iGtin as char):
     3163      define variable bar_code as character no-undo.
     3164      define variable vGtin as logical no-undo init "yes".
     3165      if length(iGtin) eq 14
     3166      then do:
     3167         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3168         run str/chk-sum.p
     3169          (input-output bar_code ) no-error .
     3170         if iGtin ne  bar_code
     3171         then
     3172            vGtin = no.
     3173      end.
     3174      else
     3175         vGtin = no.
     3176      return vgtin.
     3177   end.
     3178   method private character repSpecSimbforXlm
     3179   (iDM as char ):
     3180       iDM = replace(iDM,chr(29),"").
     3181       return iDM.
     3182   end.
     3183   method private character getGtinByDM
     3184   (IDM as char):
     3185      define variable VTXT as char no-undo.
     3186      define variable vGtin as char no-undo.
     3187      vTXt = IdM.
     3188      vGtin = IDM.
     3189      if    length(vtxt) > 14
     3190      then do:
     3191         if   vtxt begins "(01)"
     3192                or vtxt begins "(02)"
     3193         then
     3194            vGtin = substring(vtxt,5,14).
     3195         else if   (vtxt begins "01"
     3196                or vtxt begins "02" )
     3197                and (   (    substring(iDm,17,2) eq "21"
     3198                         and length(vtxt) >= 21)
     3199                     or substring(iDm,17,2) eq "37"
     3200                     or substring(iDm,17,4) eq "(37)" )
     3201         then do:
     3202            vGtin = substring(vtxt,3,14).
     3203            if not checkGtin(vGtin)
     3204            then
     3205               vGtin = substring(vtxt,1,14).
     3206         end.
     3207         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3208             or length(vtxt) eq 14 + 7 + 4
     3209             or length(vtxt) eq 14 + 7
     3210         then
     3211            vGtin = substring(vtxt,1,14).
     3212      end.
     3213      if not checkGtin(vGtin)
     3214      then
     3215         vGtin = "".
     3216      return vgtin.
     3217   end.
     3218   method private integer getGdsCodeByGtin
     3219   (iGtin as char):
     3220      define buffer prod-bc  for ub.prod-bc.
     3221      define buffer bar-code for ub.bar-code.
     3222      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3223      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3224      return if avail bar-code then bar-code.gds-code else ?.
     3225   end.
     3226   method private decimal getQntyCodeByGtin
     3227   (iGtin as char):
     3228      define buffer prod-bc  for ub.prod-bc.
     3229      define buffer bar-code for ub.bar-code.
     3230      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3231      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3232      return if avail bar-code then bar-code.cli-base-rate else ?.
     3233   end.
     3234   method private integer getGdsCodeByDM
     3235   (iDm as char):
     3236      define variable vGtin as char no-undo.
     3237      define buffer prod-bc for ub.prod-bc.
     3238      vGtin  = getGtinByDM (IDM ).
     3239      return getGdsCodeByGtin (vGtin).
     3240   end.
     3241   method private logical ChekTypeMarkByGds
     3242   (iGds-code as integer ):
     3243      define buffer goods-attr for ub.goods-attr.
     3244      find first goods-attr where goods-attr.gds-code   = iGds-code
     3245                              and goods-attr.attr-code  = 'mark-type':U
     3246      no-lock no-error.
     3247      if available goods-attr
     3248      then do:
     3249         mTypeMark = goods-attr.attr-value.
     3250         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3251           .
     3252      end.
     3253      else
     3254         return no.
     3255   end.
     3256   method private logical ChekTypeMarkByDm
     3257   (iDM as char ):
     3258      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3259   end.
     3260   method private logical ChekTypeMarkByGtin
     3261   (iGtin as char ):
     3262      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3263   end.
     3264   method private character  GetNextElement
     3265     (input iAllTeg        as logical
     3266     ,output oteg          as character
     3267     ,output otegval       as character
     3268     ,input-output pstr    as character
     3269      ):
     3270        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3271        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3272        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3273        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3274        define variable vTeg as character no-undo.
     3275        define variable vLength as integer no-undo.
     3276        define variable vi as integer no-undo.
     3277        define variable vj as integer no-undo.
     3278        define buffer code for ub.code.
     3279        find first code where Code.parent eq "MarkType"
     3280                          and Code.CodeValue   eq mTypeMark
     3281                          no-lock no-error.
     3282        if     available code
     3283           and Code.misc1 ne ""
     3284           and Code.misc1 ne ?
     3285        then do:
     3286           integer (Code.misc1) no-error.
     3287           if not error-status:error
     3288           then
     3289             entry (4,vlistleng) = Code.misc1.
     3290        end.
     3291        if iAllTeg
     3292        then
     3293           assign
     3294              vlistElem     = vlistElem    + vlistElemDop
     3295              vlistleng     = vlistleng    + vlistlengDop
     3296           .
     3297        else if mMRCCode
     3298        then
     3299           assign
     3300              vlistElem     = vlistElem    + ",(8005),8005"
     3301              vlistleng     = vlistleng    + ",000006,0006"
     3302           .
     3303       block-elem:
     3304       do vi = 1 to num-entries(vlistElem):
     3305          vTeg = entry(vi,vlistElem).
     3306          if pstr begins vTeg
     3307          then do:
     3308             if    vTeg eq "21"
     3309             then
     3310                vLength = index(pstr,chr(29)) - 2 no-error.
     3311             if vLength  <= 0
     3312             then
     3313                vLength = int(entry(vi,vlistleng)).
     3314             otegval = substring (pstr,length(vteg) + 1, vLength).
     3315             oteg = replace(replace(vteg,")",""),"(","").
     3316             vTeg = vteg + otegval.
     3317             otegval = replace(otegval,chr(29),"").
     3318             oteg = replace(replace(oteg,")",""),"(","").
     3319             pstr = substring (pstr,length(vTeg)+ 1).
     3320             vTeg = replace(vTeg,chr(29),"").
     3321             leave block-elem.
     3322          end.
     3323          else
     3324             vTeg = "".
     3325       end.
     3326       return vteg.
     3327   end.
     3328   method private character  GetCodeIdent
     3329   (iDm as char):
     3330      define variable Velement   as character no-undo init "first".
     3331      define variable oCodeIdent as character no-undo.
     3332      define variable vteg as character no-undo.
     3333      define variable vtegval as character no-undo.
     3334      define variable vGtin as character no-undo.
     3335      define buffer marking for ub.marking.
     3336      for first marking no-lock where
     3337                marking.mark eq iDm
     3338            and marking.unit-ext = "LEVEL2"
     3339      :
     3340        return iDm.
     3341      end.
     3342      vGtin  = getGtinByDM (iDm ).
     3343      ChekTypeMarkByDm(idm).
     3344      if iDm begins 'tech_':U
     3345      then
     3346         oCodeIdent = iDm.
     3347      else if length(iDm) < 21
     3348      then do:
     3349         find first marking where marking.mark eq idm
     3350         no-lock no-error.
     3351         oCodeIdent = if available marking then marking.mark else  ?.
     3352      end.
     3353      else if     length(iDm) eq 29
     3354         and not iDm begins "01"
     3355         and not iDm begins "02"
     3356      then
     3357         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3358      else  if     length(iDm) >= 24
     3359               and (  iDm begins "01"
     3360                   or iDm begins "02")
     3361               and  substring(iDm,17,2) ne "21"
     3362      then do:
     3363         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3364                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3365         then
     3366            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3367         else
     3368            oCodeIdent = iDM.
     3369      end.
     3370      else  if     (   length(iDm) eq 25
     3371                    or length(iDm) eq 21)
     3372               and (not iDm begins "01"
     3373               and  not iDm begins "02")
     3374      then
     3375         oCodeIdent = substring(iDm,1,21).
     3376      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3377      then
     3378         oCodeIdent = substring(iDm,1,21).
     3379      else do while Velement ne "" and idm ne "":
     3380         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3381         oCodeIdent = oCodeIdent + Velement.
     3382      end.
     3383      return oCodeIdent.
     3384   end.
     3385   method private character  GetTegCod
     3386   (icodeIdent as char, iTeg as char):
     3387      define variable Velement   as character no-undo init "first".
     3388      define variable oTeg as character no-undo init ?.
     3389      define variable vteg as character no-undo.
     3390      define variable vtegval as character no-undo.
     3391      if     ((length(icodeIdent) eq 21
     3392         and not icodeIdent begins "01"
     3393         and not icodeIdent begins "02")
     3394         or
     3395             ( length(icodeIdent) eq 25
     3396               and not icodeIdent begins "01"
     3397               and not icodeIdent begins "02"))
     3398      then do:
     3399         if iTeg eq "01" or iTeg eq "02"
     3400         then
     3401            oTeg = substring(icodeIdent,1,21).
     3402         else  if  iTeg eq "21"
     3403         then
     3404            oTeg = substring(icodeIdent,15,7).
     3405      end.
     3406      else do:
     3407         ChekTypeMarkByDm(icodeIdent).
     3408         block-teg:
     3409            do while Velement ne "" and icodeIdent ne "":
     3410            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3411            if    Velement begins iTeg
     3412               or Velement begins "(" + iTeg + ")"
     3413            then do:
     3414               oTeg = vtegval.
     3415               leave block-teg.
     3416            end.
     3417         end.
     3418      end.
     3419      return oTeg.
     3420   end.
     3421   method private logical isOAD
     3422   (icodeIdent as character):
     3423      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3424   end.
     3425   method private logical isMark
     3426   (icodeIdent as character):
     3427      define buffer buf_marking for ub.marking.
     3428      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3429             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3430   end.
     3431   method private character  addBracketForCode
     3432   (icodeIdent as char):
     3433      define variable Velement   as character no-undo init "first".
     3434      define variable oTeg as character no-undo.
     3435      define variable vteg as character no-undo.
     3436      define variable vtegval as character no-undo.
     3437      define buffer marking for ub.marking.
     3438      find first marking no-lock where
     3439                 marking.mark begins icodeIdent no-error.
     3440      if    not ChekTypeMarkByDm(icodeIdent)
     3441         or length(icodeIdent) le 24
     3442         or (avail marking and marking.unit-ext = "LEVEL2")
     3443      then
     3444         oTeg = icodeIdent.
     3445      else do:
     3446         if (  icodeIdent begins "01"
     3447            or icodeIdent begins "02"
     3448            ) and CheckGtin(substring (icodeIdent,3,14))
     3449            and substring (icodeIdent,17,2) eq "21"
     3450         then do:
     3451            mMRCCode = yes.
     3452            ChekTypeMarkByDm(icodeIdent).
     3453            block-teg:
     3454            do while Velement ne "" and icodeIdent ne "":
     3455               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3456               if vteg ne ""
     3457               then
     3458                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3459            end.
     3460            mMRCCode = no.
     3461         end.
     3462         else do:
     3463            oTeg = icodeIdent.
     3464         end.
     3465      end.
     3466      return oTeg.
     3467   end.
     3468   method private integer getlevelByCodId
     3469   (iCode as char):
     3470      define variable vLength as int no-undo.
     3471      define variable vLevel  as int no-undo.
     3472      if not ChekTypeMarkByDM (icode) then return ?.
     3473      vLength = length(iCode).
     3474      if    vLength eq 18
     3475         or vLength eq 20
     3476      then
     3477         Vlevel = 4.
     3478      else if vLength eq 21
     3479      then
     3480         Vlevel = 1.
     3481      else if vLength eq 25
     3482      then do:
     3483         if  iCode begins "01"
     3484         then
     3485            Vlevel = 3.
     3486         else
     3487            Vlevel = 1.
     3488      end.
     3489      else if     vLength >= 26
     3490              and vLength <= 46
     3491      then do:
     3492         if    substring(iCode,17,2) eq "11"
     3493            or substring(iCode,17,2) eq "13"
     3494            or (    substring(iCode,17,2) eq "21"
     3495                and vLength >= 33
     3496                and substring(iCode,26,4) ne "8005")
     3497         then
     3498            Vlevel = 4.
     3499         else if    vLength eq 31
     3500                 or vLength eq 38
     3501                 or vLength eq 39
     3502                 or vLength eq 45
     3503         then
     3504            Vlevel = 1.
     3505         else if    vLength eq 35
     3506                 or vLength eq 43
     3507         then
     3508            Vlevel = 3.
     3509         else
     3510            Vlevel = ?.
     3511      end.
     3512      else
     3513         Vlevel = ?.
     3514      return Vlevel.
     3515   end.
     3516   method private character  getLevelMotpBycodid
     3517   (iDm as char):
     3518      define variable vLevel as integer no-undo.
     3519      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3520      vLevel = getlevelByCodId(iDm).
     3521      if    vLevel eq ?
     3522         or vLevel < 1
     3523         or vLevel > 6
     3524      then
     3525         return ?.
     3526      else
     3527         return entry(vlevel,vList).
     3528   end.
     3529   method private character    getLevelUTDByLevelMotp
     3530   (iUnit as char):
     3531      define variable vLevel as integer no-undo.
     3532      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3533      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3534      vLevel = lookup(iUnit,vListMOTP).
     3535      if    vLevel eq ?
     3536         or vLevel < 1
     3537         or vLevel > 4
     3538      then
     3539         return ?.
     3540      else
     3541         return entry(vlevel,vListutd).
     3542   end.
     3543   method private character  getLevelMotpByDM
     3544   (iDm as char):
     3545      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3546   end.
     3547   method private character  getLevelUTDByCodId
     3548   (iDm as char):
     3549      define variable vLevel as integer no-undo.
     3550      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3551      vLevel = getlevelByCodId(iDm).
     3552      if    vLevel eq ?
     3553         or vLevel < 1
     3554         or vLevel > 4
     3555      then
     3556         return ?.
     3557      else
     3558         return entry(vlevel,vList).
     3559   end.
     3560   method private character  getLevelUTDByDM
     3561   (iDm as char):
     3562      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3563   end.
     3564   define variable mNotMarkQnty as logical no-undo.
     3565   method private decimal getQntyUTDByCodId
     3566   (iDM as char):
     3567      define variable vLevel as integer no-undo.
     3568      define variable vList as character no-undo init "1,5,10,500".
     3569      define variable vGtin as character no-undo.
     3570      define variable vqnty as decimal no-undo init ?.
     3571      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3572      if vqnty eq ?
     3573      then do:
     3574         if not mNotMarkQnty
     3575         then do:
     3576            define buffer marking for ub.marking.
     3577            define variable vCodident as character no-undo.
     3578            vCodident = GetCodeIdent(idm).
     3579            find first marking where marking.mark begins vCodident no-lock no-error.
     3580            if     available marking
     3581               and marking.box-qnty ne ?
     3582            then
     3583               return marking.box-qnty.
     3584         end.
     3585         vGtin = getGtinByDm(iDM).
     3586         if ChekTypeMarkByGtin (vGtin)
     3587         then do:
     3588            vLevel = getlevelByCodId(iDM).
     3589            if     vLevel >= 1
     3590               and vLevel <= 4
     3591            then
     3592               vqnty = int(entry(vlevel,vList)).
     3593         end.
     3594         else
     3595            vqnty = getQntyCodeByGtin(vgtin).
     3596      end.
     3597      return vqnty.
     3598   end.
     3599   method private decimal getQntyUTDByDM
     3600   (iDm as char):
     3601      define variable vDM as character no-undo.
     3602      if     length (iDm) ne 25
     3603         and length (iDm) ne 29
     3604         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     3605      then
     3606         vDM = substring (iDm,1,length (iDm) - 6 ).
     3607      else
     3608         vDM = substring (iDm,1,length (iDm) - 4 ).
     3609      return getQntyUTDByCodId(vDM).
     3610   end.
     3611   method private decimal    getMRC4
     3612   (iMRC as char):
     3613      define variable oMrc     as decimal no-undo init ?.
     3614      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     3615      define variable vi       as integer no-undo.
     3616      define variable vfound   as integer no-undo.
     3617      define variable vposStart   as integer no-undo.
     3618      do:
     3619      OMRc = 0.
     3620      do vi = 1 to 4:
     3621         define variable vsimb as character no-undo.
     3622         vsimb = substring(iMRC,vi,1).
     3623         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     3624         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     3625         if vfound > 0
     3626         then
     3627            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     3628         end.
     3629         OMRc = OMRc / 100.
     3630      end.
     3631      return OMRc.
     3632   end.
     3633   method private decimal    getMRCByDM
     3634   (iDm as char):
     3635      define variable vMRC     as character no-undo.
     3636      define variable oMrc     as decimal no-undo init ?.
     3637      define variable Velement as character no-undo init "empty".
     3638      define variable vteg as character no-undo.
     3639      define variable vtegval as character no-undo.
     3640      if    length(idm) eq 14 + 7 + 4 + 4
     3641         or length(idm) eq 14 + 7 + 4
     3642      then do:
     3643         vMRC = substring(idm,22,4).
     3644         omrc = getMRC4(vMRC).
     3645      end.
     3646      else do:
     3647          ChekTypeMarkByDm(iDm).
     3648          block-mrc:
     3649          do while Velement ne "" and idm ne "":
     3650             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     3651             if Velement begins "8005"
     3652             then do:
     3653                vMRC = substring(Velement,5,6).
     3654                leave block-mrc.
     3655             end.
     3656             else if Velement begins "(8005)"
     3657             then do:
     3658                vMRC = substring(Velement,7,6).
     3659                leave block-mrc.
     3660             end.
     3661          end.
     3662          if vMRC ne ""
     3663          then
     3664             OMRc = dec(vmrc) / 100 no-error.
     3665      end.
     3666      return OMRc.
     3667   end.
     3668   method private date    MoveDate
     3669   (idate as date,
     3670    iMonth as int64):
     3671      define variable vMonth   as int64 no-undo.
     3672      define variable vYear    as int64 no-undo.
     3673      define variable vDateNew as date  no-undo.
     3674       define variable vDay     as int64 no-undo.
     3675       vMonth = month(iDate) + iMonth.
     3676       vYear =  year(iDate).
     3677       if vMonth <= 0
     3678       then assign
     3679          vMonth = vMonth + 12
     3680           vYear  = vYear - 1
     3681       .
     3682       else if vMonth > 12
     3683       then assign
     3684          vMonth = vMonth - 12
     3685           vYear  = vYear + 1
     3686       .
     3687       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     3688       do while error-status:error eq yes:
     3689          VDay = vDay + 1.
     3690          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     3691       end.
     3692       if VDay > 0
     3693       then
     3694          vDateNew + 1.
     3695       return vDateNew.
     3696   end.
     3697   method private logical    checkEMRC
     3698   (input  iDm as char,
     3699    output vOk as logical):
     3700      define variable v-value-emrc as character no-undo.
     3701      define variable v-type-emrc  as character no-undo.
     3702      define variable vDateIso     as character no-undo.
     3703      define variable vMRC         as decimal no-undo.
     3704      define variable vqnty        as decimal no-undo.
     3705      define variable vPrice       as decimal no-undo.
     3706      define variable vparent      as character no-undo.
     3707      define variable vgds-code    as integer no-undo.
     3708      define buffer code for ub.code.
     3709      vMRC = getMRCByDM(iDm).
     3710      if vMRC > 0
     3711      then do:
     3712         vgds-code = getGdsCodeByDM(iDm).
     3713         vqnty     = getQntyUTDByDM(iDm).
     3714               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     3715            (
     3716             input   vgds-code
     3717            ,input   'emrc-type':U
     3718            ,output   v-value-emrc
     3719            ,output   v-type-emrc
     3720          ) no-error.
     3721          if     v-value-emrc ne ""
     3722             and v-value-emrc ne ?
     3723          then do:
     3724             vDateIso = iso-date(today).
     3725             vPrice = vMRC / vqnty.
     3726             vparent ="emc" + chr(4) + v-value-emrc.
     3727             find last code where Code.parent      eq vparent
     3728                              and Code.code        le vDateIso
     3729                              and code.status_  eq 0
     3730             no-lock no-error.
     3731             if not available code or ( vPrice  >= dec(Code.CodeValue))
     3732             then
     3733                vOk = true .
     3734             else do:
     3735                 define variable vText      as character no-undo.
     3736                 define variable vDate      as date no-undo.
     3737                 define variable vDateLast  as character no-undo.
     3738                 define variable vDateFirst as character no-undo.
     3739                 define variable vDate3     as date no-undo.
     3740                 vdate = date(code.misc1).
     3741                 vDateLast = code.misc1.
     3742                 vDate3 = MoveDate(today, - 3 ).
     3743                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     3744                                      string(vDate3  , "99/99/9999"),
     3745                                      string(vDate   , "99/99/9999")
     3746                                      ).
     3747                 vdateIso = iso-date(vdate3).
     3748                 find last code  where Code.parent      eq vparent
     3749                                   and Code.code        le vDateIso
     3750                                   and code.status_  eq 0 no-lock no-error.
     3751                 if available code
     3752                 then
     3753                    vDateIso = code.code.
     3754                 vDateFirst = vDateIso.
     3755                 vDateLast = iso-date(vdate).
     3756                 define variable vGood as logical no-undo.
     3757                 define variable vDateSale as date no-undo.
     3758                 define buffer bcode for code.
     3759                 for last code where Code.parent   eq vparent
     3760                                 and code.status_  eq 0
     3761                                 and code.code     < vDateLast
     3762                                 and code.code     >= vDateFirst
     3763                 no-lock:
     3764                    find first bcode where bCode.parent   eq vparent
     3765                                       and bcode.status_  eq 0
     3766                                       and bcode.code     > code.code no-lock no-error.
     3767                    if available bcode
     3768                    then do:
     3769                       if vPrice < dec(Code.CodeValue)
     3770                       then
     3771                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     3772                                                     chr(10),
     3773                                                     string(    date( code.misc1)       ,"99/99/9999"),
     3774                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     3775                                                     ).
     3776                       else do:
     3777                          vGood = yes.
     3778                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     3779                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     3780                                                     chr(10),
     3781                                                     string(    date( code.misc1)         ,"99/99/9999"),
     3782                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     3783                                                     string(         vDateSale            ,"99/99/9999"),
     3784                                                     string(vDateSale - today)
     3785                                                     ).
     3786                       end.
     3787                    end.
     3788                 end.
     3789                 if vgood
     3790                 then do:
     3791                    define variable choice as integer no-undo .
     3792                    run gbl/d-askw.w (input "Уточнение"
     3793                           ,input  vText
     3794                           ,input "|"
     3795                           ,input "Принять|Вернуть"
     3796                           ,input "Принять данный товар|Вернуть товар постащику"
     3797                           ,input 1
     3798                           ,input 2
     3799                           ,output choice) no-error.
     3800                    vok = choice eq 1.
     3801                 end.
     3802                 else
     3803                    vok =false.
     3804             end.
     3805          end.
     3806      end.
     3807   end.
     3808   method private character addGs2Mark
     3809   (iMark as char):
     3810      define variable vDM   as character no-undo.
     3811      define variable vIdx  as integer   no-undo.
     3812      if index(iMark,chr(29),1) > 0
     3813      then return iMark.
     3814      if substring(iMark,26,4) = "8005" then
     3815      do:
     3816        vIdx = index(iMark,"93",26 + 4 + 5).
     3817        if vIdx > 1 then do:
     3818          vDM = substitute("&1&4&2&4&3",
     3819                           substring(iMark,1,25),
     3820                           substring(iMark,26,vIdx - 25 - 1),
     3821                           substring(iMark,vIdx),
     3822                           chr(29)) no-error.
     3823          vIdx = index(vDm,"240",vIdx + 4).
     3824          if vIdx > 0 then
     3825          do:
     3826            vDM = substitute("&1&3&2",
     3827                             substring(vDm,1,vIdx - 1),
     3828                             substring(vDm,vIdx),
     3829                             chr(29)) no-error.
     3830          end.
     3831        end.
     3832        else
     3833          vDM = substitute("&1&3&2",
     3834                           substring(iMark,1,25),
     3835                           substring(iMark,26),
     3836                           chr(29)) no-error.
     3837      end.
     3838      else if substring(iMark,32,2) = "91" then
     3839      do:
     3840        vIdx = index(iMark,"92",32).
     3841        if vIdx > 1 then
     3842          vDM = substitute("&1&4&2&4&3",
     3843                           substring(iMark,1,31),
     3844                           substring(iMark,32,vIdx - 31 - 1),
     3845                           substring(iMark,vIdx),
     3846                           chr(29)) no-error.
     3847        else
     3848          vDM = substitute("&1&3&2",
     3849                           substring(iMark,1,31),
     3850                           substring(iMark,32),
     3851                           chr(29)) no-error.
     3852      end.
     3853      else if substring(iMark,39,2) = "91" then
     3854      do:
     3855        vIdx = index(iMark,"92",38).
     3856        if vIdx > 1 then
     3857          vDM = substitute("&1&4&2&4&3",
     3858                           substring(iMark,1,38),
     3859                           substring(iMark,39,vIdx - 38 - 1),
     3860                           substring(iMark,vIdx),
     3861                           chr(29)) no-error.
     3862        else
     3863          vDM = substitute("&1&3&2",
     3864                           substring(iMark,1,38),
     3865                           substring(iMark,39),
     3866                           chr(29)) no-error.
     3867      end.
     3868      else if substring(iMark,25,2) = "93" then
     3869      do:
     3870        vIdx = index(iMark,"92",25).
     3871        if vIdx > 1 then
     3872          vDM = substitute("&1&4&2&4&3",
     3873                           substring(iMark,1,24),
     3874                           substring(iMark,25,vIdx - 24 - 1),
     3875                           substring(iMark,vIdx),
     3876                           chr(29)) no-error.
     3877        else
     3878          vIdx = index(iMark,"3103",25).
     3879          if vIdx > 0 then
     3880          vDM = substitute("&1&4&2&4&3",
     3881                           substring(iMark,1,24),
     3882                           substring(iMark,25,vIdx - 24 - 1),
     3883                           substring(iMark,vIdx),
     3884                           chr(29)) no-error.
     3885          else
     3886            vDM = substitute("&1&3&2",
     3887                             substring(iMark,1,24),
     3888                             substring(iMark,25),
     3889                             chr(29)) no-error.
     3890      end.
     3891      else if substring(iMark,32,2) = "93" then
     3892      do:
     3893        vDM = substitute("&1&3&2",
     3894              substring(iMark,1,31),
     3895              substring(iMark,32),
     3896              chr(29)) no-error.
     3897      end.
     3898      return if vDM <> "" then vDm else iMark.
     3899   end.
     3900   method private logical AddUtdErrForTab
     3901   (idb-num         as integer ,
     3902    idoc-id         as integer ,
     3903    iTab            as character,
     3904    iObj            as handle ,
     3905    iCheckType      as character,
     3906    iCodeErr        as character,
     3907    iCheckObj       as character ):
     3908      define buffer utd-err for utd-err.
     3909      define buffer utd for utd.
     3910      find first utd where utd.db-num     eq idb-num
     3911                       and utd.doc-id     eq idoc-id
     3912                       and utd.Direction  eq 'Outbound'
     3913      no-lock no-error.
     3914      if available utd
     3915      then
     3916         return no.
     3917      define variable vRecKey as character no-undo.
     3918            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     3919            objKeyRec = new ibs.th.gbl.keyrec().
     3920            objKeyRec:GenKeyRec ( input iTab
     3921                                 ,input iObj
     3922                                 ,output vRecKey).
     3923            delete object objKeyRec.
     3924      find first utd-err where utd-err.db-num     eq idb-num
     3925                           and utd-err.doc-id     eq idoc-id
     3926                           and utd-err.CheckType  eq iCheckType
     3927                           and utd-err.CodeErr    eq iCodeErr
     3928                           and utd-err.CheckObj   eq iCheckObj
     3929      exclusive-lock no-error.
     3930      if not available utd-err
     3931      then do:
     3932         create utd-err.
     3933         assign
     3934            utd-err.db-num         = idb-num
     3935            utd-err.doc-id         = idoc-id
     3936            utd-err.CheckType      = iCheckType
     3937            utd-err.CodeErr        = iCodeErr
     3938            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     3939            utd-err.reckey         = vRecKey
     3940            utd-err.qnty           = 1
     3941         .
     3942      end.
     3943      else
     3944         utd-err.qnty = utd-err.qnty + 1.
     3945      return utd-err.qnty eq 1.
     3946   end.
     3947   method private logical AddUtdErr
     3948   (idb-num         as integer ,
     3949    idoc-id         as integer ,
     3950    iObj            as handle ,
     3951    iCheckType      as character,
     3952    iCodeErr        as character,
     3953    iCheckObj       as character ):
     3954      AddUtdErrForTab
     3955         (idb-num,
     3956          idoc-id,
     3957          iObj:table,
     3958          iObj,
     3959          iCheckType,
     3960          iCodeErr,
     3961          iCheckObj).
     3962   end.
     3963   method private void ClearUtdErrTypeCode
     3964   (idb-num         as integer,
     3965    idoc-id         as integer ,
     3966    iCheckType      as character,
     3967    iCodeErr        as character
     3968    ):
     3969      define buffer utd-err for utd-err.
     3970      if    iCheckType eq "*"
     3971         or iCheckType eq ?
     3972      then do:
     3973         if     iCodeErr ne ?
     3974            and iCodeErr ne "*"
     3975         then
     3976            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     3977            view-as alert-box.
     3978         else
     3979         for each utd-err where utd-err.db-num  eq idb-num
     3980                            and utd-err.doc-id  eq idoc-id
     3981         exclusive-lock:
     3982            delete utd-err.
     3983         end.
     3984      end.
     3985      else do:
     3986         if    iCodeErr eq ?
     3987            or iCodeErr eq "*"
     3988         then do:
     3989            for each utd-err where utd-err.db-num     eq idb-num
     3990                               and utd-err.doc-id     eq idoc-id
     3991                               and utd-err.CheckType  eq iCheckType
     3992            exclusive-lock:
     3993               delete utd-err.
     3994            end.
     3995         end.
     3996         else do:
     3997            for each utd-err where utd-err.db-num     eq idb-num
     3998                               and utd-err.doc-id     eq idoc-id
     3999                               and utd-err.CheckType  eq iCheckType
     4000                               and ub.utd-err.CodeErr eq iCodeErr
     4001            exclusive-lock:
     4002               delete utd-err.
     4003            end.
     4004         end.
     4005      end.
     4006   end.
     4007   method private void ClearUtdErr
     4008   (idb-num         as integer,
     4009    idoc-id         as integer ,
     4010    iCheckType      as character
     4011    ):
     4012      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     4013   end.
     4014   method private character GetMesError
     4015   (itxt as character,
     4016    iobj as character ):
     4017    define variable vi as integer no-undo.
     4018    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     4019       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     4020    end.
     4021    return itxt.
     4022   end.
     4023   method private character GetTextErrorType
     4024   (iCheckType as character,
     4025    iCodeErr   as character,
     4026    iChechObj  as character,
     4027    iType      as character  ):
     4028      define buffer code    for code.
     4029      define variable vError as character no-undo.
     4030      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4031                        and code.code   eq iCodeErr
     4032      no-lock no-error.
     4033      if available code
     4034      then do:
     4035         define variable vType as integer no-undo.
     4036         if code.misc3 eq "error"
     4037         then
     4038            vType = 0.
     4039         else if code.misc3 eq "warning"
     4040         then
     4041            vType = 1.
     4042         else if code.misc3 eq "Hiden"
     4043         then
     4044            vType = 2.
     4045         else
     4046            vtype = int(code.misc3) no-error.
     4047         case itype:
     4048            when "error"
     4049            then do:
     4050               if vtype eq 0
     4051               then
     4052                  vError = GetMesError(Code.CodeValue,iChechObj).
     4053            end.
     4054            when "warning"
     4055            then do:
     4056               if vtype <= 1
     4057               then
     4058                  vError = GetMesError(Code.CodeValue,iChechObj).
     4059            end.
     4060            otherwise do:
     4061               vError = GetMesError(Code.CodeValue,iChechObj).
     4062            end.
     4063         end.
     4064      end.
     4065      else
     4066         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     4067      return vError.
     4068   end.
     4069   method private integer  GetTypeError
     4070   (iCheckType as character,
     4071    iCodeErr   as character):
     4072      define buffer code    for code.
     4073      define variable vType as integer no-undo.
     4074      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4075                        and code.code   eq iCodeErr
     4076      no-lock no-error.
     4077      if     not available code
     4078         and code.misc3 eq "error"
     4079      then
     4080         vType = 0.
     4081      else if code.misc3 eq "warning"
     4082      then
     4083         vType = 1.
     4084      else if code.misc3 eq "Hiden"
     4085      then
     4086         vType = 2.
     4087      else
     4088         vtype = int(code.misc3) no-error.
     4089      return vtype.
     4090   end.
     4091   method private character GetTextError
     4092   (iCheckType as character,
     4093    iCodeErr   as character,
     4094    iChechObj  as character ):
     4095      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     4096   end.
     4097   method private character GetErrForUtdstr
     4098   (idb-num     as integer ,
     4099    idoc-id     as integer ,
     4100    iCheckType  as character
     4101    ):
     4102      define buffer utd-err for utd-err.
     4103      define buffer code    for code.
     4104      define variable vHQry as handle no-undo.
     4105      define variable vError as longchar no-undo.
     4106      define variable vErrorOne as longchar  no-undo.
     4107      define variable oError as character no-undo.
     4108      create query vHQry.
     4109      vHQry:set-buffers(buffer utd-err:handle).
     4110      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4111                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4112                               + if    iCheckType eq "*"
     4113                                    or iCheckType eq ?
     4114                                 then       ""
     4115                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4116      vHQry:query-open().
     4117      vHQry:get-first().
     4118      QRY-BLOCK:
     4119      repeat while not vHQry:query-off-end:
     4120         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4121         if     vErrorOne ne ""
     4122            and vErrorOne ne ?
     4123         then
     4124            vError = vError + ", " + vErrorOne.
     4125         vHQry:get-next().
     4126      end.
     4127      oError = substring(vError,3,4002).
     4128      return oError.
     4129   end.
     4130   method private character GetErrJsonForUtd
     4131   (idb-num         as integer ,
     4132    idoc-id         as integer ,
     4133    iCheckType      as character
     4134    ):
     4135      define buffer utd-err for utd-err.
     4136      define variable vHQry as handle no-undo.
     4137      define variable vError as longchar no-undo.
     4138      define variable oError as character no-undo.
     4139      create query vHQry.
     4140      define variable vi as integer no-undo.
     4141      vHQry:set-buffers(buffer utd-err:handle).
     4142      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4143                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4144                               + if    iCheckType eq "*"
     4145                                    or iCheckType eq ?
     4146                                 then       ""
     4147                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4148      vHQry:query-open().
     4149      vHQry:get-first().
     4150      QRY-BLOCK:
     4151      repeat while not vHQry:query-off-end:
     4152         define variable vErrorOne as character no-undo.
     4153         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4154         if     vErrorOne ne ?
     4155            and vErrorOne ne ""
     4156         then do:
     4157            vi = vi + 1.
     4158            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     4159                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     4160                            + '","ТекстОш":"' + vErrorOne + '"}'.
     4161         end.
     4162         vHQry:get-next().
     4163      end.
     4164      for first utd where utd.db-num eq idb-num
     4165                      and utd.doc-id eq idoc-id
     4166                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     4167      no-lock,
     4168         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     4169                                  and utd-marking-lines.doc-id eq idoc-id
     4170                                  and utd-marking-lines.doc-level eq 1
     4171      no-lock,
     4172         first marking where marking.mark eq utd-marking-lines.mark
     4173                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4174      no-lock:
     4175         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     4176         if     vErrorOne ne ?
     4177            and vErrorOne ne ""
     4178         then do:
     4179            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     4180                            + '","ОбъектОш":"' + marking.mark
     4181                            + '","ТекстОш":"' + vErrorOne + '"}'.
     4182         end.
     4183      end.
     4184      if vError ne ""
     4185      then
     4186         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     4187      return oError.
     4188   end.
     4189   method private character GetErrJsonForUtdReturn
     4190   (idb-num         as integer ,
     4191    idoc-id         as integer ,
     4192    iCheckType      as character
     4193    ):
     4194      define buffer utd-err for utd-err.
     4195      define variable vHQry as handle no-undo.
     4196      define variable vError as longchar no-undo.
     4197      define variable oError as character no-undo.
     4198      define variable vi as integer no-undo.
     4199      create query vHQry.
     4200      vHQry:set-buffers(buffer utd-err:handle).
     4201      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4202                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4203                               + if    iCheckType eq "*"
     4204                                    or iCheckType eq ?
     4205                                 then       ""
     4206                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4207      vHQry:query-open().
     4208      vHQry:get-first().
     4209      QRY-BLOCK:
     4210      repeat while not vHQry:query-off-end:
     4211         define variable vErrorOne as character no-undo.
     4212         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     4213         if     vErrorOne ne ?
     4214            and vErrorOne ne ""
     4215         then do:
     4216            vi = vi + 1.
     4217            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     4218                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     4219                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     4220         end.
     4221         vHQry:get-next().
     4222      end.
     4223      if vError ne ""
     4224      then
     4225         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     4226      return oError.
     4227   end.
     4228   method private character GetCodeTextError
     4229   (iCheckType as character,
     4230    iCodeErr   as character,
     4231    iChechObj  as character,
     4232    output oCode as character,
     4233    output ovalue as character ):
     4234      define buffer code    for code.
     4235      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     4236                        and code.code   eq iCodeErr
     4237      no-lock no-error.
     4238      if     available code
     4239      then do:
     4240         define variable vi as integer no-undo init ?.
     4241         vi = int(Code.misc3) no-error.
     4242         if    code.misc3 ne "error"
     4243            and vi ne 0
     4244         then
     4245            oCode = ?.
     4246         else if     Code.misc1 ne ?
     4247                 and Code.misc1 ne ""
     4248         then
     4249            assign
     4250               oCode  = GetMesError(Code.misc1,iChechObj)
     4251               ovalue = GetMesError(Code.misc2,iChechObj)
     4252            .
     4253      end.
     4254      return if oCode eq ""
     4255             then ""
     4256             else (oCode + "_" + ovalue).
     4257   end.
     4258   define temp-table TT-err no-undo
     4259     field code_ as character
     4260     field text_ as character
     4261   index code_ code_.
     4262   method private character GetErrTxtForUtd
     4263   (idb-num         as integer ,
     4264    idoc-id         as integer ,
     4265    iCheckType      as character
     4266    ):
     4267      define buffer utd-err for utd-err.
     4268      define variable vHQry as handle no-undo.
     4269      define variable oError as character no-undo.
     4270      create query vHQry.
     4271      define variable vi as integer no-undo.
     4272      for each tt-err :
     4273         delete tt-err.
     4274      end.
     4275      vHQry:set-buffers(buffer utd-err:handle).
     4276      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     4277                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     4278                               + if    iCheckType eq "*"
     4279                                    or iCheckType eq ?
     4280                                 then       ""
     4281                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     4282      vHQry:query-open().
     4283      vHQry:get-first().
     4284      define variable vcode as character no-undo.
     4285      define variable vvalue as character no-undo.
     4286      QRY-BLOCK:
     4287      repeat while not vHQry:query-off-end:
     4288         vi = vi + 1.
     4289         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     4290         if vcode ne ?
     4291         then do:
     4292            find first tt-err where tt-err.code eq vcode
     4293            no-error.
     4294            if not available tt-err
     4295            then do:
     4296               create tt-err.
     4297               assign
     4298                  tt-err.code_ = vcode
     4299                  tt-err.text_ = vvalue
     4300               .
     4301            end.
     4302            else
     4303               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4304         end.
     4305         vHQry:get-next().
     4306      end.
     4307     find first utd where utd.db-num eq idb-num
     4308                         and utd.doc-id eq idoc-id
     4309         no-lock.
     4310      define buffer cancel_utd-lines for utd-lines.
     4311      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     4312                                  and cancel_utd-lines.doc-id eq idoc-id
     4313      no-lock:
     4314         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     4315         then do:
     4316            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     4317                                        and utd-marking-lines.doc-id eq idoc-id
     4318                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     4319            no-lock,
     4320               first marking where marking.mark eq utd-marking-lines.mark
     4321                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4322            no-lock:
     4323               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     4324               find first tt-err where tt-err.code eq vcode
     4325               no-error.
     4326               if not available tt-err
     4327               then do:
     4328                  create tt-err.
     4329                  assign
     4330                     tt-err.code_ = vcode
     4331                     tt-err.text_ = vvalue
     4332                  .
     4333               end.
     4334               else
     4335                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4336            end.
     4337         end.
     4338         else do:
     4339            define variable vqnty as decimal no-undo.
     4340            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     4341            if vqnty eq ? then vqnty = 0.
     4342            if vqnty ne cancel_utd-lines.Quantity
     4343            then do:
     4344               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     4345               find first tt-err where tt-err.code eq vcode
     4346               no-error.
     4347               if not available tt-err
     4348               then do:
     4349                  create tt-err.
     4350                  assign
     4351                     tt-err.code_ = vcode
     4352                     tt-err.text_ = vvalue
     4353                  .
     4354               end.
     4355               else
     4356                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     4357            end.
     4358         end.
     4359      end.
     4360      for each tt-err:
     4361         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     4362      end.
     4363      return oError.
     4364   end.
     4365   define variable mFormatErr as character no-undo init "text".
     4366   method private character GetErrForUtd
     4367   (idb-num         as integer ,
     4368    idoc-id         as integer ,
     4369    iType           as character
     4370    ):
     4371      if mFormatErr eq "text"
     4372      then
     4373         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     4374      else do:
     4375         if itype eq "return"
     4376         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     4377         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     4378      end.
     4379   end.
     4380   method private longchar GetErrComText
     4381   (icomment as character,
     4382    itext    as longchar ):
     4383       define variable vText as longchar no-undo.
     4384      if mFormatErr eq "text"
     4385      then do:
     4386         if icomment ne ""
     4387         then
     4388            icomment = substitute("comment:|&1|",icomment).
     4389         vText = icomment + itext.
     4390      end.
     4391      else do:
     4392         icomment = if icomment begins  '"'
     4393                    then icomment
     4394                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     4395         vText = icomment + "," + itext.
     4396         vText = "~{" + trim(vText,",") + "~}".
     4397      end.
     4398      return vText.
     4399   end.
     4400   method private logical  CheckTypeForMarkLineType
     4401   (iObj            as handle,
     4402    iCheckType      as character,
     4403    iCodeErr        as character ,
     4404    iTypeErr        as character ):
     4405      define variable vRecKey-markLine as character no-undo.
     4406      define variable vGoodMark        as logical no-undo.
     4407      define variable vdb-num          as integer no-undo.
     4408      define variable vdoc-id          as integer no-undo.
     4409      define variable vlinenum         as integer no-undo.
     4410      define variable vErrorOne as character no-undo.
     4411      define buffer buf_utd-err for utd-err.
     4412       define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     4413       objKeyRec = new ibs.th.gbl.keyrec().
     4414       objKeyRec:GenKeyRec ( input "utd-marking-lines"
     4415                            ,input iObj
     4416                            ,output  vRecKey-markLine).
     4417       delete object objKeyRec.
     4418      vGoodMark = yes.
     4419      vdb-num = iObj::db-num.
     4420      vdoc-id = iObj::doc-id.
     4421      vlinenum = iObj::linenum.
     4422      block-mark-err:
     4423      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4424                               and buf_utd-err.db-num = vdb-num
     4425                               and buf_utd-err.reckey = vRecKey-markLine
     4426                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     4427                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     4428      no-lock:
     4429         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     4430         if     vErrorOne ne ?
     4431            and vErrorOne ne ""
     4432         then do:
     4433            vGoodMark = no.
     4434            leave block-mark-err.
     4435         end.
     4436      end.
     4437      return not vGoodMark.
     4438   end.
     4439   method private logical  CheckErrForMarkLineType
     4440   (iObj            as handle,
     4441    iType           as character  ):
     4442      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     4443   end.
     4444   method private logical  CheckErrForMarkLine
     4445   (iObj            as handle):
     4446      return CheckErrForMarkLineType(iObj,"*").
     4447   end.
     4448   method private logical  CheckErrForLineTypeCode
     4449   (iObj                 as handle,
     4450    iCheckType           as character,
     4451    iCodeErr             as character,
     4452    iTypeErr             as character,
     4453    iOneErr              as logical):
     4454      define variable vRecKey-line     as character no-undo.
     4455      define buffer buf_utd-err for utd-err.
     4456      define variable vUtdlineError as logical no-undo.
     4457      define variable vErrorOne as character no-undo.
     4458            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     4459            objKeyRec = new ibs.th.gbl.keyrec().
     4460            objKeyRec:GenKeyRec ( input "utd-lines"
     4461                                 ,input iObj
     4462                                 ,output vRecKey-line).
     4463            delete object objKeyRec.
     4464         define variable vdb-num as integer no-undo.
     4465         define variable vdoc-id as integer no-undo.
     4466         define variable vlinenum as integer no-undo.
     4467         vdb-num = iObj::db-num.
     4468         vdoc-id = iObj::doc-id.
     4469         vlinenum = iObj::linenum.
     4470         block-err:
     4471         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4472                                  and buf_utd-err.db-num = vdb-num
     4473                                  and buf_utd-err.reckey = vRecKey-line
     4474                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     4475                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     4476         no-lock:
     4477            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     4478            if     vErrorOne ne ?
     4479               and vErrorOne ne ""
     4480            then do:
     4481               vUtdlineError = yes.
     4482               leave block-err.
     4483            end.
     4484         end.
     4485         if  not vUtdlineError
     4486         then do:
     4487            define variable vGoodMark as logical no-undo.
     4488            vGoodMark = yes.
     4489            block-line-err:
     4490            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     4491                                         and utd-marking-lines.doc-id  eq vdoc-id
     4492                                         and utd-marking-lines.LineNum eq vLineNum
     4493            no-lock:
     4494               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     4495               if     vGoodMark
     4496                  and iOneErr eq no
     4497               then
     4498                  leave block-line-err.
     4499               if     iOneErr = yes
     4500                  and not vGoodMark
     4501               then
     4502                  leave block-line-err.
     4503            end.
     4504            vUtdlineError = not vGoodMark.
     4505         end.
     4506      return vUtdlineError.
     4507   end.
     4508   method private character   getErrForLineType
     4509   (iObj            as handle,
     4510    iType           as character  ):
     4511      define variable vRecKey-line     as character no-undo.
     4512      define buffer buf_utd-err for utd-err.
     4513      define variable vUtdlineError as logical no-undo.
     4514      define variable vErrorOne as character no-undo.
     4515      define variable oError as character no-undo.
     4516            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     4517            objKeyRec = new ibs.th.gbl.keyrec().
     4518            objKeyRec:GenKeyRec ( input "utd-lines"
     4519                                 ,input iObj
     4520                                 ,output vRecKey-line).
     4521            delete object objKeyRec.
     4522         define variable vdb-num as integer no-undo.
     4523         define variable vdoc-id as integer no-undo.
     4524         define variable vlinenum as integer no-undo.
     4525         vdb-num = iObj::db-num.
     4526         vdoc-id = iObj::doc-id.
     4527         vlinenum = iObj::linenum.
     4528         block-err:
     4529         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     4530                                  and buf_utd-err.db-num = vdb-num
     4531                                  and buf_utd-err.reckey = vRecKey-line
     4532                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     4533         no-lock:
     4534            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     4535            if     vErrorOne ne ?
     4536               and vErrorOne ne ""
     4537            then do:
     4538               oError = oError + vErrorOne + " ".
     4539            end.
     4540         end.
     4541      return oError.
     4542   end.
     4543   method private logical  CheckErrForLineType
     4544   (iObj            as handle,
     4545    iType           as character  ):
     4546       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     4547   end.
     4548   method private logical  CheckErrForLine
     4549   (iObj            as handle):
     4550      return CheckErrForLineType(iobj,"*").
     4551   end.
     4552   method private logical  CheckErrForUtd
     4553   (idb-num         as integer ,
     4554    idoc-id         as integer ):
     4555      for each utd-lines where utd-lines.db-num eq idb-num
     4556                           and utd-lines.doc-id eq idoc-id
     4557      no-lock :
     4558         if not CheckErrForLine (buffer ub.utd-lines:handle)
     4559         then
     4560            return no.
     4561      end.
     4562      return yes.
     4563   end.
     4564   method public logical CheckMarkUtd-28rel
     4565    (input idb-num as integer,
     4566    input idoc-id as integer):
     4567    define buffer utd                   for utd.
     4568    define buffer utd-lines             for utd-lines.
     4569    define buffer utd-marking-lines     for utd-marking-lines.
     4570    define variable v-par-type as character no-undo.
     4571    define variable vgdsNoMark as logical no-undo.
     4572    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4573      define variable v-par-val  as character no-undo.
     4574      find first utd where utd.db-num eq idb-num
     4575                       and utd.doc-id eq idoc-id
     4576      no-lock no-error.
     4577      if available utd
     4578      then do:
     4579         if     utd.obj-code ne ?
     4580            and utd.obj-type ne ?
     4581         then do:
     4582            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     4583            Block-utd-lines:
     4584            for each utd-lines where utd-lines.db-num eq idb-num
     4585                                 and utd-lines.doc-id eq idoc-id
     4586            no-lock:
     4587               if     utd-lines.gds-code ne ?
     4588                  and utd-lines.gds-code ne 0
     4589               then do:
     4590                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     4591                       ( utd-lines.gds-code,
     4592                         'mark-type':U,
     4593                          output v-par-val,
     4594                          output v-par-type
     4595                       ).
     4596                  if     EDOParSec:IsEdo
     4597                     and EDOParSec:GetIsEDOForType(v-par-val)
     4598                  then do:
     4599                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4600                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4601                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     4602                                                    and length(utd-marking-lines.mark) > 13
     4603                     no-lock no-error.
     4604                     if     avail utd-marking-lines
     4605                        and not CheckErrForLine(buffer utd-lines:handle)
     4606                     then
     4607                        leave Block-utd-lines.
     4608                  end.
     4609                  else
     4610                     vgdsNoMark = yes.
     4611               end.
     4612            end.
     4613            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     4614            if vgdsNoMark then return available utd-lines . else return yes .
     4615         end.
     4616      end.
     4617      return yes.
     4618   end.
     4619     def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4620   method public character objExists
     4621   (input  ifolder as character,
     4622    input  iType   as character  ):
     4623       define variable vFileType as character no-undo init "D,F".
     4624       define variable vi        as integer no-undo.
     4625       define variable vtype as character no-undo.
     4626       if iType ne ?
     4627       then
     4628          vFileType = iType.
     4629       do vi = 1 to num-entries(vFileType):
     4630          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     4631          vtype = file-information:file-type.
     4632          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     4633             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     4634             index(vtype , entry(vi,vFileType )) > 0
     4635          then return file-information:full-pathname .
     4636          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     4637          vtype = file-information:file-type.
     4638          if file-information:file-name <> "" and
     4639             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     4640             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     4641             index( vtype, entry(vi,vFileType )) > 0
     4642          then return file-information:full-pathname .
     4643       end.
     4644       return ? .
     4645   end.
     4646   method public character SearchFile
     4647   (input  ifile as character):
     4648      return objExists(ifile,?).
     4649   end.
     4650   method public character SearchPFile
     4651   (input inFile as char):
     4652        define variable oFile       as character no-undo.
     4653        define variable vFileSearch as character no-undo.
     4654        define variable vNumEntry   as integer no-undo.
     4655        if inFile = "" then return ?.
     4656        vNumEntry = num-entries(inFile,".").
     4657        vFileSearch = inFile.
     4658        if    vNumEntry > 0
     4659           and (   entry(vNumEntry,inFile,".") eq "p"
     4660                or entry(vNumEntry,inFile,".") eq "w")
     4661        then do:
     4662           entry(vNumEntry,vFileSearch, ".") = "r".
     4663           oFile = search(vFileSearch ).
     4664           if oFile eq ?
     4665           then
     4666              oFile = search(inFile).
     4667        end.
     4668        else
     4669           oFile = search(vFileSearch).
     4670        return oFile.
     4671     end.
     4672   end class.
