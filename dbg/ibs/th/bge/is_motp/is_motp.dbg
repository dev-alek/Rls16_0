     2669               utd-marking-lines-attr.doc-id     = idoc-id
     2670               utd-marking-lines-attr.lineNum    = ilineNum
     2671               utd-marking-lines-attr.mark       = imark
     2672               utd-marking-lines-attr.attr-code  = iattrcode
     2673               utd-marking-lines-attr.attr-value = iattrval
     2674            .
