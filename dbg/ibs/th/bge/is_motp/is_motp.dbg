        9   block-level on error undo, throw.
       10   class ibs.th.bge.is_motp.is_motp inherits objth:
       11       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       12       define override public property vss-author      as character no-undo init "$Author:$":U get.
       13       define override public property vss-date        as character no-undo init "$Date:$":U get.
       14       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       15       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       16       define override public property vss-description as character no-undo init "Класс для работы с МОТП" get.
       17   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       18   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       20     define temp-table tt-childs no-undo
       21       field mark    as character case-sensitive
       22       field parent_ as character
       23       index pi as primary unique
       24         mark parent_
