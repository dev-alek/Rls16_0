     2498       put stream LK_RECEIPT unformatted now " " itext skip .
     2499       output stream LK_RECEIPT close .
     2500     end.
     2501   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2502   method private void getAttrLib ():
     2503      define variable g#attr-lib  as handle no-undo .
     2504      run gbl/getgattrlib.p (output g#attr-lib).
     2505   end.
     2506   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2507   method public char getattrUtdEx
     2508   (idb-num   as integer,
     2509    idoc-id   as integer,
     2510    iattrcode as character,
     2511    iExValue  as character  ):
     2512      define buffer utd-attr for utd-attr.
     2513      find first utd-attr where utd-attr.db-num eq idb-num
     2514                            and utd-attr.doc-id eq idoc-id
     2515                            and utd-attr.attr-code eq iattrcode
     2516      no-lock no-error.
     2517      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     2518   end.
     2519   method public char getattrUtd
     2520   (idb-num   as integer,
     2521    idoc-id   as integer,
     2522    iattrcode as character ):
     2523     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     2524   end.
     2525   method public void setattrUtd
     2526   (idb-num   as integer,
     2527    idoc-id   as integer,
     2528    iattrcode as character,
     2529    iattrval  as character ):
     2530      define buffer utd-attr for utd-attr.
     2531      find first utd-attr where utd-attr.db-num eq idb-num
     2532                            and utd-attr.doc-id eq idoc-id
     2533                            and utd-attr.attr-code eq iattrcode
     2534      no-lock no-error.
     2535      if not available utd-attr
     2536      then do:
     2537         create utd-attr.
     2538         assign
     2539            utd-attr.db-num    = idb-num
     2540            utd-attr.doc-id    = idoc-id
     2541            utd-attr.attr-code = iattrcode
     2542            utd-attr.attr-value = iattrval
     2543         .
     2544      end.
     2545      else do:
     2546         if utd-attr.attr-value ne iattrval
     2547         then do:
     2548            find current utd-attr exclusive-lock no-error.
     2549            if available utd-attr
     2550            then
     2551               utd-attr.attr-value = iattrval.
     2552         end.
     2553      end.
     2554      release utd-attr.
     2555   end.
     2556   method public char GetAttrUtdlinesEx
     2557   (idb-num   as integer,
     2558    idoc-id   as integer,
     2559    ilinenum  as integer,
     2560    iattrcode as character,
     2561    iExValue  as character  ):
     2562      define buffer utd-lines-attr for utd-lines-attr.
     2563      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2564                                  and utd-lines-attr.doc-id    eq idoc-id
     2565                                  and utd-lines-attr.lineNum   eq ilineNum
     2566                                  and utd-lines-attr.attr-code eq iattrcode
     2567      no-lock no-error.
     2568      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     2569   end.
     2570   method public char GetAttrUtdlines
     2571   (idb-num   as integer,
     2572    idoc-id   as integer,
     2573    ilinenum  as integer,
     2574    iattrcode as character ):
     2575      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     2576   end.
     2577   method public void setattrUtdlines
     2578   (idb-num   as integer,
     2579    idoc-id   as integer,
     2580    ilinenum  as integer,
     2581    iattrcode as character,
     2582    iattrval  as character ):
     2583      define buffer utd-lines-attr for utd-lines-attr.
     2584      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     2585                                  and utd-lines-attr.doc-id    eq idoc-id
     2586                                  and utd-lines-attr.lineNum   eq ilineNum
     2587                                  and utd-lines-attr.attr-code eq iattrcode
     2588      no-lock no-error.
     2589      if not available utd-lines-attr
     2590      then do:
     2591         if iattrval ne ?
     2592            and iattrval ne ""
     2593         then do:
     2594            create utd-lines-attr.
     2595            assign
     2596               utd-lines-attr.db-num    = idb-num
     2597               utd-lines-attr.doc-id    = idoc-id
     2598               utd-lines-attr.lineNum   = ilineNum
     2599               utd-lines-attr.attr-code = iattrcode
     2600               utd-lines-attr.attr-value = iattrval
     2601            .
     2602         end.
     2603      end.
     2604      else do:
     2605         if utd-lines-attr.attr-value ne iattrval
     2606         then do:
     2607            find current utd-lines-attr exclusive-lock no-error.
     2608            if available utd-lines-attr
     2609            then do:
     2610               if    iattrval eq ?
     2611                  or iattrval eq ""
     2612               then do:
     2613                  delete utd-lines-attr.
     2614               end.
     2615               else do:
     2616                  utd-lines-attr.attr-value = iattrval.
     2617               end.
     2618            end.
     2619         end.
     2620      end.
     2621      release utd-lines-attr.
     2622   end.
