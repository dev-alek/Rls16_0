      112     define property currToken as character no-undo
      113       get :
      114         define buffer buf_ext-system-attr for ub.ext-system-attr .
      115         find first buf_ext-system-attr no-lock where buf_ext-system-attr.db-num   = esysDbNum
      116                                                  and buf_ext-system-attr.esys-id  = esysId
      117                                                  and buf_ext-system-attr.esya-attr-code = "AuthToken"
      118                                                  no-error .
      119         if not available buf_ext-system-attr
      120         then do :
      121           return ? .
      122         end.
      123         return buf_ext-system-attr.esya-attr-value .
      124       end.
      125       protected set .
      126     define property currTokenDT as datetime-tz no-undo
      127       get :
      128         define buffer buf_ext-system-attr for ub.ext-system-attr .
      129         find first buf_ext-system-attr no-lock where buf_ext-system-attr.db-num   = esysDbNum
      130                                                  and buf_ext-system-attr.esys-id  = esysId
      131                                                  and buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
      132                                                  no-error .
      133         if not available buf_ext-system-attr
      134         or (available buf_ext-system-attr and trim(buf_ext-system-attr.esya-attr-value) = "")
      135         then do :
      136           return ? .
      137         end.
      138         return datetime-tz(buf_ext-system-attr.esya-attr-value) .
      139       end.
      140       protected set .
      141     define property addCurlKeys as character no-undo initial ""
      142       get.
      143       protected set.
      144     define variable mFileAuth      as character no-undo.
      145     define variable mFileCades     as character no-undo.
      146     define variable mFileAuthTest  as character no-undo.
      147     define variable mFilecisesInfo as character no-undo.
      148     define variable mFileLK_RECEIPT as character no-undo.
      149     define variable v-section   as character no-undo .
      150     define variable v-key       as character no-undo .
      151     define stream sLog .
      152     constructor public is_motp (  ):
      153       define buffer buf_ext-system for ub.ext-system .
      154       define buffer buf_ext-system-attr for ub.ext-system-attr .
      155       find first clients no-lock where clients.obj-type = 'маг':U
      156                                    and clients.db-num = gbl-var:g#db-num
      157                                    and clients.stts = 0
      158                                    no-error .
      159       if not available clients
      160       then do :
      161         assign
      162           MSG = "Нет активного магазина в БД" + string(gbl-var:g#db-num)
      163           StatusErr = true
      164         .
      165         return error .
      166       end .
      167       for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'host-code':U
      168                                              and buf_ext-system-attr.esya-attr-value  = string(clients.host-code)
      169                                              :
      170         find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
      171                                             and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
      172                                             no-error .
      173         if available buf_ext-system then leave .
      174       end .
      175       if not available buf_ext-system
      176       then do :
      177         assign
      178           MSG = "Нет внешней системы с типом ИС МОТП, привязанной к фирме Орг" + string(clients.host-code)
      179           StatusErr = true
      180         .
      181         return error .
      182       end .
      183       setProps(buf_ext-system.db-num, buf_ext-system.esys-id, gbl-var:g#db-num) .
      184     end constructor .
      185     constructor public is_motp
      186     (
      187     input pEsysDbNum as integer,
      188     input pEsysId as integer
      189     ) :
      190       setProps(pEsysDbNum, pEsysId, gbl-var:g#db-num) .
      191     end constructor .
      192     constructor public is_motp
      193     (
      194     input pEsysDbNum as integer,
      195     input pEsysId as integer,
      196     input pDbNum as integer
      197     ) :
      198       setProps(pEsysDbNum, pEsysId, pDbNum) .
      199     end constructor .
      200     method private void setProps
      201     (
      202     input pEsysDbNum as integer,
      203     input pEsysId as integer,
      204     input pDbNum as integer
      205     ) :
      206       define buffer buf_ext-system for ub.ext-system .
      207       define buffer buf_ext-system-attr for ub.ext-system-attr .
      208       DB-num = pDbNum .
      209       find first buf_ext-system no-lock where buf_ext-system.db-num = pEsysDbNum
      210                                           and buf_ext-system.esys-id = pEsysId
      211                                           .
      212       esysId = buf_ext-system.esys-id .
      213       esysDbNum = buf_ext-system.db-num .
      214       for each buf_ext-system-attr no-lock where buf_ext-system-attr.db-num = buf_ext-system.db-num
      215                                              and buf_ext-system-attr.esys-id = buf_ext-system.esys-id
      216                                              :
      217         case buf_ext-system-attr.esya-attr-code :
      218           when 'user-id':U then do:
      219             user-id_ = buf_ext-system-attr.esya-attr-value .
      220           end.
      221           when 'server-addr':U then do:
      222             server_ = buf_ext-system-attr.esya-attr-value.
      223           end.
      224           when 'proxy-addr':U then do:
      225              get-key-value section "ProxyServ" key buf_ext-system-attr.esya-attr-code value proxy-addr.
      226              if proxy-addr eq ?
      227              then
      228                 proxy-addr = buf_ext-system-attr.esya-attr-value .
      229           end.
      230           when 'proxy-login':U then do:
      231              get-key-value section "ProxyServ" key buf_ext-system-attr.esya-attr-code value proxy-login.
      232              if proxy-login eq ?
      233              then
      234                 proxy-login = buf_ext-system-attr.esya-attr-value .
      235           end.
      236           when 'proxy-pswd':U then do:
      237              get-key-value section "ProxyServ" key buf_ext-system-attr.esya-attr-code value proxy-pswd.
      238              if proxy-pswd eq ?
      239              then
      240                 proxy-pswd = buf_ext-system-attr.esya-attr-value .
      241           end.
      242           when 'proxy-ssl':U then do:
      243              define variable vtext as character no-undo.
      244              get-key-value section "ProxyServ" key buf_ext-system-attr.esya-attr-code value vtext.
      245              if vtext eq ?
      246              then
      247                 proxy-ssl = logical(buf_ext-system-attr.esya-attr-value) .
      248              else
      249                 proxy-ssl = logical(vtext) .
      250           end.
      251           when 'mail-list':U then do:
      252             mail-list = buf_ext-system-attr.esya-attr-value .
      253           end.
      254           when 'host-code':U then do:
      255             find first firm no-lock where firm.firm-code = integer(buf_ext-system-attr.esya-attr-value) no-error .
      256             if available firm
      257             then do :
      258               INN = firm.inn .
      259             end .
      260           end.
      261         end case .
      262       end .
      263       if trim(proxy-addr) <> "" and proxy-addr <> ?
      264       then do :
      265         if proxy-ssl
      266         then do:
      267           assign
      268             CmdParamProxy    = substitute ('-k --proxy-negotiate -x &1 -U : ',proxy-addr)
      269             CmdParamProxyLog = CmdParamProxy
      270           .
      271         end.
      272         else do:
      273           assign
      274             CmdParamProxy     = substitute ('-x &1 -U &2:&3', proxy-addr, proxy-login, proxy-pswd )
      275             CmdParamProxyLog  = substitute ('-x &1 -U &2:',   proxy-addr, proxy-login             )
      276           .
      277         end.
      278       end.
      279       else
      280         assign
      281           CmdParamProxy    = ""
      282           CmdParamProxyLog = ""
      283         .
      284       mFileAuth      = "IsMotp_auth_db" + string(DB-num) + ".log".
      285       mFileCades     = "IsMotp_cadescom_db" + string(DB-num) + ".log".
      286       mFileAuthTest  = "IsMotp_authTest_db" + string(DB-num) + ".log".
      287       mFilecisesInfo = "IsMotp_cisesInfo_db" + string(DB-num) + ".log".
      288       mFileLK_RECEIPT = "IsMotp_LK_RECEIPT_db" + string(DB-num) + ".log".
      289       assign
      290         v-section = 'CURL':u
      291         v-key     = 'motp-keys':u
      292       .
      293       get-key-value section v-section key v-key value addCurlKeys .
      294       addCurlKeys = trim(addCurlKeys) .
      295       if addCurlKeys = ? then addCurlKeys = "" .
      296     end method .
      297     method public character SignDoc
      298     (
      299     input pKey as character,
      300     input pMode as character,
      301     input pData as longchar
      302     ):
      303       define variable oStore as component-handle no-undo .
      304       define variable oCerts as com-handle no-undo .
      305       define variable oCert as com-handle no-undo .
      306       define variable oSigner as com-handle no-undo .
      307       define variable oSignedData as com-handle no-undo .
      308       define variable signedDataLong as longchar no-undo .
      309       define variable vRetValue as character no-undo .
      310       define variable ii as integer no-undo .
      311       define variable ix as integer no-undo .
      312       define variable v-found as logical no-undo .
      313       define variable cmd as character no-undo .
      314       define variable vLine  as character no-undo .
      315       define variable vStr   as character no-undo .
      316       signedDataLong = ? .
      317       MSG = "".
      318       StatusErr = true.
      319       create "CAdESCOM.Store" oStore no-error .
      320       if error-status:num-messages > 0
      321       then do ix = 1 to  error-status:num-messages:
      322         putcades( error-status:get-message(ix) ) .
      323       end .
      324       oStore:Open (2, "My", 0) no-error .
      325       if error-status:num-messages > 0
      326       then do ix = 1 to  error-status:num-messages:
      327         putcades( error-status:get-message(ix) ) .
      328       end .
      329       create "CAPICOM.Certificates" oCerts no-error .
      330       if error-status:num-messages > 0
      331       then do ix = 1 to  error-status:num-messages:
      332         putcades( error-status:get-message(ix) ). .
      333       end .
      334       oCerts = oStore:Certificates .
      335       release object oStore .
      336       .
      337       create "CAdESCOM.Certificate" oCert  no-error.
      338       if error-status:num-messages > 0
      339       then do ix = 1 to  error-status:num-messages:
      340         putcades( error-status:get-message(ix) ). .
      341       end .
      342       assign v-found = false .
      343       do ii = 1 to oCerts:Count :
      344         oCert = oCerts:item(ii) .
      345         case pMode :
      346           when "ThumbPrint"
      347           then do :
      348             if oCert:Thumbprint = pKey
      349             then do :
      350               v-found = true .
      351               leave .
      352             end .
      353           end .
      354           when "SerialNumber"
      355           then do :
      356             if oCert:SerialNumber = pKey
      357             then do :
      358               v-found = true .
      359               leave .
      360             end .
      361           end .
      362         end case.
      363       end.
      364       release object oCerts .
      365       if not v-found
      366       then do :
      367          case pMode :
      368             when "ThumbPrint"
      369             then
      370                MSG = "В личном хранилище сертификатов не найден сертификат с отпечатком " + pKey .
      371             when "SerialNumber"
      372             then
      373                MSG = "В личном хранилище сертификатов не найден сертификат с серийным номером " + pKey .
      374          end case .
      375          putauth ( MSG ) .
      376       end.
      377       else do:
      378         create "CAdESCOM.CPSigner" oSigner no-error .
      379         if error-status:num-messages > 0
      380         then do ix = 1 to  error-status:num-messages:
      381           putcades( error-status:get-message(ix) ) .
      382         end .
      383         create "CAdESCOM.CadesSignedData" oSignedData no-error .
      384         if error-status:num-messages > 0
      385         then do ix = 1 to  error-status:num-messages:
      386           putcades( error-status:get-message(ix) ) .
      387         end .
      388         oSigner:Certificate = oCert .
      389         oSigner:TSAAddress = "http://testca2012.cryptopro.ru/tsp/tsp.srf" .
      390         oSignedData:ContentEncoding = 1 .
      391         oSignedData:Content = pData .
      392         signedDataLong = oSignedData:SignCades(oSigner, 1, true, 0) no-error .
      393         if error-status:num-messages > 0
      394         then do ix = 1 to  error-status:num-messages:
      395           putcades( error-status:get-message(ix)).
      396         end .
      397         if signedDataLong = ?
      398         or signedDataLong = ""
      399         then do :
      400           MSG = "Ошибка при попытке подписания документа открепленной подписью!".
      401           putauth ( MSG ) .
      402         end .
      403         else do:
      404           signedDataLong = replace(signedDataLong, chr(10), "") .
      405           signedDataLong = replace(signedDataLong, chr(13), "") .
      406         end .
      407       end .
      408       error-status:error = no .
      409       vRetValue = string(signedDataLong) no-error .
      410       if error-status:error
      411       then do :
      412         MSG = "Подпись слишком большая!".
      413         return ? .
      414       end .
      415       if trim(vRetValue) = "" then vRetValue = ? .
      416       return vRetValue .
      417     end method .
      418     method public character SendDoc_LK_RECEIPT
      419     (
      420     input pToken  as character,
      421     input pDB-num as integer,
      422     input pDoc-id as integer,
      423     input pKey as character,
      424     input pMode as character
      425     ):
      426       define buffer buf_utd for ub.utd .
      427       define variable cmd    as character no-undo .
      428       define variable cmdlog as character no-undo .
      429       define variable vFileToken as character no-undo.
      430       define variable tmpcmdfile  as character no-undo .
      431       define variable vBase64Doc as longchar no-undo .
      432       define variable vSignature as character no-undo .
      433       define variable vDataLong as longchar no-undo .
      434       define variable vFileResult as character no-undo .
      435       define variable vFileResultErr as character no-undo .
      436       define variable vfilereq as character no-undo .
      437       define variable vProductGroup as character no-undo .
      438       define variable vLine  as character no-undo .
      439       define variable vDocUUID as character no-undo .
      440       define variable vOk as logical no-undo .
      441       find first buf_utd no-lock where buf_utd.db-num = pDB-num
      442                                    and buf_utd.doc-id = pDoc-id
      443                                    .
      444       putLK_RECEIPT ( "Обработка документа " + string(buf_utd.db-num) + "_" + string(buf_utd.doc-id) ) .
      445       vProductGroup = getattrUtd(input buf_utd.db-num, input buf_utd.doc-id, input "LK_RECEIPT_PG") .
      446       if vProductGroup = ?
      447       or trim(vProductGroup) = ""
      448       then do :
      449         MSG = "В документе не заполнен атрибут Продуктовая Группа!".
      450         putLK_RECEIPT ( MSG ) .
      451         return ? .
      452       end .
      453       run str/makeBase64doc-LK_RECEIPT.p (input buf_utd.db-num,
      454                                           input buf_utd.doc-id,
      455                                           output vBase64Doc)
      456                                           no-error .
      457       if error-status:error
      458       then do :
      459         MSG = return-value .
      460         putLK_RECEIPT ( MSG ) .
      461         return ? .
      462       end .
      463       vSignature = getattrUtd(buf_utd.db-num, buf_utd.doc-id, "LK_RECEIPT_Signature") .
      464       if vSignature = ?
      465       or trim(vSignature) = ""
      466       then do :
      467         if pKey = ?
      468         or pMode = ?
      469         then do :
      470           MSG = "SendDoc_LK_RECEIPT: ошибка входных параметров сертификата".
      471           putLK_RECEIPT ( MSG ) .
      472           return ? .
      473         end .
      474         vSignature = SignDoc(pKey, pMode, vBase64Doc) .
      475         if vSignature = ?
      476         then do :
      477           putLK_RECEIPT ( MSG ) .
      478           return ? .
      479         end .
      480         setattrUtd (input buf_utd.db-num,
      481                     input buf_utd.doc-id,
      482                     input "LK_RECEIPT_Signature",
      483                     input vSignature)
      484                     .
      485         updateUtdStatus(input buf_utd.db-num, input buf_utd.doc-id, input ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Signed:KeyIntDB) .
      486       end .
      487       vDataLong = "" .
      488       vDataLong = vDataLong + "~{" .
      489       vDataLong = vDataLong + quoter("document_format") + ":" + quoter("MANUAL") + "," .
      490       vDataLong = vDataLong + quoter("product_document") + ":" +  '"' + vBase64Doc + '"'  + "," .
      491       vDataLong = vDataLong + quoter("type") + ":" + quoter("LK_GTIN_RECEIPT") + "," .
      492       vDataLong = vDataLong + quoter("signature") + ":" + quoter(vSignature) .
      493       vDataLong = vDataLong + "~}" .
      494       vfilereq = "IsMotp_reqLK_RECEIPT_db" + string(pDB-num) + "_" + string(pDoc-id) + ".json".
      495       vFileResult    = "IsMotp_respLK_RECEIPT_db" + string(pDB-num) + "_" + string(pDoc-id) + ".json".
      496       vFileResultErr = "IsMotp_respLK_RECEIPT_db" + string(pDB-num) + "_" + string(pDoc-id) + ".err".
      497       vFileToken = "IsMotp_token_db" + string(pDB-num) + ".txt".
      498       copy-lob vDataLong to file (vfilereq) no-convert .
      499       putLK_RECEIPT ( "  out-data:" ) .
      500       if isDebug
      501       then
      502         os-append value(vfilereq) value(mFileLK_RECEIPT) .
      503       output stream sLog to value(vFileToken) .
      504         put stream sLog unformatted "Authorization: Bearer " pToken .
      505       output stream sLog close .
      506       cmd = substitute ('&1 &8 -d @&5 --stderr &7 -H "Content-Type: application/json" -H @&4 &6 &3/lk/documents/create?pg=&9 >&2',
      507                         search ("exe/curl.exe"),
      508                         vFileResult,
      509                         server_,
      510                         searchfile (vFileToken),
      511                         searchfile (vfilereq),
      512                         CmdParamProxy,
      513                         vFileResultErr,
      514                         addCurlKeys,
      515                         vProductGroup).
      516       cmdlog = substitute ('&1 &8 -d @&5 --stderr &7 -H "Content-Type: application/json" -H "Authorization: Bearer &4" &6 &3/lk/documents/create?pg=&9 >&2',
      517                         search ("exe/curl.exe"),
      518                         vFileResult,
      519                         server_,
      520                         pToken,
      521                         searchfile (vfilereq),
      522                         CmdParamProxyLOG,
      523                         vFileResultErr,
      524                         addCurlKeys,
      525                         vProductGroup).
      526       putLK_RECEIPT ( "command: " ).
      527       putLK_RECEIPT ( cmdLOG   ).
      528       os-command silent value(cmd) .
      529       if searchFile(vfileresult) = ?
      530       then do :
      531         MSG = "Запрос не выполнен! Нет ответа от МОТП. Не могу найти файл " + search(vfileresult) .
      532         return ? .
      533       end .
      534       file-info:file-name = searchFile(vfileresult) .
      535       if file-info:file-size = 0
      536       then do :
      537         MSG = "Запрос не выполнен! Файл-ответ из МОТП " + search(vfileresult) + " пустой (размер 0 байт)." .
      538         return ? .
      539       end .
      540       output stream sLog to value (searchFile(vfileresult)) append .
      541       put stream sLog unformatted " " skip " _ ".
      542       output stream sLog close .
      543       input from value (searchFile(vfileresult)) .
      544       import unformatted vLine .
      545       input close .
      546       vLine = trim(vLine) .
      547       vLine = trim(vLine, chr(123)) .
      548       vLine = trim(vLine, "}") .
      549       if vLine begins '"error_message"'
      550       then do :
      551         MSG = trim(trim(substring(vLine, 17)), '"').
      552         putLK_RECEIPT ( MSG ) .
      553         return ? .
      554       end.
      555       vDocUUID = trim(vLine, '"') .
      556       if trim(vDocUUID) = ""
      557       then do :
      558         vDocUUID = ? .
      559       end .
      560       if vDocUUID > ""
      561       then do :
      562         vOK = updateUtdStatusUUID(input buf_utd.db-num, input buf_utd.doc-id, input ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Sent:KeyIntDB, input vDocUUID) .
      563         if not vOK
      564         then do :
      565           MSG  = "Ошибка при обновлении статуса и UUID документа! Документ не найден либо запись захвачена" .
      566           return ? .
      567         end .
      568       end .
      569       return vDocUUID .
      570     end method .
      571     method public character authorize
      572     (
      573     input pKey as character,
      574     input pMode as character
      575     ):
      576       define buffer buf_ext-system-attr for ub.ext-system-attr .
      577       define variable oStore as component-handle no-undo .
      578       define variable oCerts as com-handle no-undo .
      579       define variable oCert as com-handle no-undo .
      580       define variable oSigner as com-handle no-undo .
      581       define variable oSignedData as com-handle no-undo .
      582       define variable signedData1Long as longchar no-undo .
      583       define variable signedData2Long as longchar no-undo .
      584       define variable ii as integer no-undo .
      585       define variable ix as integer no-undo .
      586       define variable v-found as logical no-undo .
      587       define variable cmd as character no-undo .
      588       define variable cmdlog as character no-undo .
      589       define variable vData1 as character no-undo .
      590       define variable vData2 as character no-undo .
      591       define variable vLine  as character no-undo .
      592       define variable vStr   as character no-undo .
      593       define variable vAuthDataLong as longchar no-undo .
      594       define variable vToken as character no-undo .
      595       MSG = "".
      596       StatusErr = true.
      597       create "CAdESCOM.Store" oStore no-error .
      598       if error-status:num-messages > 0
      599       then do ix = 1 to  error-status:num-messages:
      600         putcades( error-status:get-message(ix) ) .
      601       end .
      602       oStore:Open (2, "My", 0) no-error .
      603       if error-status:num-messages > 0
      604       then do ix = 1 to  error-status:num-messages:
      605         putcades( error-status:get-message(ix) ) .
      606       end .
      607       create "CAPICOM.Certificates" oCerts no-error .
      608       if error-status:num-messages > 0
      609       then do ix = 1 to  error-status:num-messages:
      610         putcades( error-status:get-message(ix) ). .
      611       end .
      612       oCerts = oStore:Certificates .
      613       release object oStore .
      614       .
      615       create "CAdESCOM.Certificate" oCert  no-error.
      616       if error-status:num-messages > 0
      617       then do ix = 1 to  error-status:num-messages:
      618         putcades( error-status:get-message(ix) ). .
      619       end .
      620       assign v-found = false .
      621       do ii = 1 to oCerts:Count :
      622         oCert = oCerts:item(ii) .
      623         case pMode :
      624           when "ThumbPrint"
      625           then do :
      626             if oCert:Thumbprint = pKey
      627             then do :
      628               v-found = true .
      629               leave .
      630             end .
      631           end .
      632           when "SerialNumber"
      633           then do :
      634             if oCert:SerialNumber = pKey
      635             then do :
      636               v-found = true .
      637               leave .
      638             end .
      639           end .
      640         end case.
      641       end.
      642       release object oCerts .
      643       if not v-found
      644       then do :
      645          case pMode :
      646             when "ThumbPrint"
      647             then
      648                MSG = "В личном хранилище сертификатов не найден сертификат с отпечатком " + pKey .
      649             when "SerialNumber"
      650             then
      651                MSG = "В личном хранилище сертификатов не найден сертификат с серийным номером " + pKey .
      652          end case .
      653          putauth ( MSG ) .
      654       end.
      655       else do:
      656         define variable vFileResult as character no-undo.
      657         define variable vFileResultErr as character no-undo.
      658         assign
      659           vFileResult    = "IsMotp_AuthData_db" + string(DB-num) + ".json"
      660           vFileResultErr = "IsMotp_AuthData_db" + string(DB-num) + ".err"
      661           cmd    = substitute ('&1 &6 &4 --stderr &5 &3/auth/key >&2', search ("exe/curl.exe"), vFileResult, server_, CmdParamProxy, vFileResultErr, addCurlKeys)
      662           cmdlog = substitute ('&1 &6 &4 --stderr &5 &3/auth/key >&2', search ("exe/curl.exe"), vFileResult, server_, CmdParamProxylog, vFileResultErr, addCurlKeys)
      663         .
      664         putauth(" command   " + cmdlog ).
      665         os-command silent value (cmd).
      666         define variable VFile as character no-undo.
      667         vfile =  SearchFile(vFileResult).
      668         if vfile eq ?
      669         then do:
      670           MSG = "Нет ответа от ИС МОТП. Не найден " + vFileResult.
      671           putauth (MSG ).
      672         end.
      673         else do:
      674           file-info:file-name = vfile .
      675           if file-info:file-size = 0
      676           then do :
      677             MSG = "Нет ответа от ИС МОТП. Файл пустой " + vfile.
      678             putauth ( MSG ).
      679           end.
      680           else do:
      681             copy-lob from file vfile to vAuthDataLong no-convert .
      682             output stream sLog to value (vfile) append .
      683             put stream sLog unformatted " " skip " _ ".
      684             output stream sLog close .
      685             input from value (vfile) convert source "UTF-8"  .
      686             import unformatted vLine .
      687             input close .
      688             do ii = 1 to num-entries(vLine) :
      689               vStr = entry(ii, vLine) .
      690               vStr = trim(vStr) .
      691               vStr = trim(vStr, "[") .
      692               vStr = trim(vStr, "]") .
      693               vStr = trim(vStr, chr(123)) .
      694               vStr = trim(vStr, "}") .
      695               if num-entries(vStr, ":") <> 2 then next .
      696               if vStr begins '"data"'
      697               then do :
      698                 if ii < 3
      699                 then vData1 = trim(trim(entry(2, vStr, ":")), '"') .
      700                 else vData2 = trim(trim(entry(2, vStr, ":")), '"') .
      701               end.
      702               else
      703               if vStr begins '"error_message"'
      704               then do :
      705                 MSG = trim(trim(entry(2, vStr, ":")), '"') .
      706                 putauth ( MSG ).
      707                 StatusErr = yes .
      708                 return error MSG .
      709               end .
      710             end .
      711             create "CAdESCOM.CPSigner" oSigner no-error .
      712             if error-status:num-messages > 0
      713             then do ix = 1 to  error-status:num-messages:
      714               putcades( error-status:get-message(ix) ) .
      715             end .
      716             create "CAdESCOM.CadesSignedData" oSignedData no-error .
      717             if error-status:num-messages > 0
      718             then do ix = 1 to  error-status:num-messages:
      719               putcades( error-status:get-message(ix) ) .
      720             end .
      721             oSigner:Certificate = oCert .
      722             oSigner:TSAAddress = "http://testca2012.cryptopro.ru/tsp/tsp.srf" .
      723             oSignedData:ContentEncoding = 0 .
      724             oSignedData:Content = vData1 .
      725             signedData1Long = oSignedData:SignCades(oSigner, 1, false, 0) no-error .
      726             if error-status:num-messages > 0
      727             then do ix = 1 to  error-status:num-messages:
      728               putcades( error-status:get-message(ix)).
      729             end .
      730             if    signedData1Long = ?
      731             or signedData1Long = ""
      732             then do :
      733               MSG = "Ошибка при попытке подписания строки для получения токена авторизации!".
      734               putauth ( MSG ) .
      735             end .
      736             else do:
      737               signedData1Long = replace(signedData1Long, chr(10), "") .
      738               signedData1Long = replace(signedData1Long, chr(13), "") .
      739               define variable vFlagError as logical no-undo.
      740               if vData2 > ""
      741               then do :
      742                 oSignedData:Content = vData2 .
      743                 signedData2Long = oSignedData:SignCades(oSigner, 1, false, 0) no-error .
      744                 if error-status:num-messages > 0
      745                 then do ix = 1 to  error-status:num-messages:
      746                   putcades( error-status:get-message(ix)) .
      747                 end .
      748                 if    signedData2Long = ?
      749                 or signedData1Long = ""
      750                 then do :
      751                   MSG = "Ошибка при попытке подписания строки (2) для получения токена авторизации!".
      752                   putauth ( MSG ) .
      753                   vFlagError = yes.
      754                 end .
      755                 else do:
      756                   signedData2Long = replace(signedData2Long, chr(10), "") .
      757                   signedData2Long = replace(signedData2Long, chr(13), "") .
      758                 end.
      759               end.
      760               if not vFlagError
      761               then do:
      762                 if vData1 > ""
      763                 then
      764                   vAuthDataLong = replace(vAuthDataLong, vData1, signedData1Long) .
      765                 if vData2 > ""
      766                 then
      767                   vAuthDataLong = replace(vAuthDataLong, vData2, signedData2Long) .
      768                 copy-lob vAuthDataLong to file ("IsMotp_AuthDataSigned_db" + string(DB-num) + ".json") no-convert .
      769                 vFileResult = "IsMotp_AuthToken_db" + string(DB-num) + ".json".
      770                 vFileResulterr = "IsMotp_AuthToken_db" + string(DB-num) + ".err".
      771                 cmd = substitute ('&1 &7 -H "Content-Type: application/json" &5 -d @&4 --stderr &6 &3/auth/simpleSignIn >&2',
      772                                    search ("exe/curl.exe"),
      773                                    vFileResult,
      774                                    server_,
      775                                    searchfile ("IsMotp_AuthDataSigned_db" + string(DB-num) + ".json"),
      776                                    CmdParamProxy,
      777                                    vFileResulterr,
      778                                    addCurlKeys).
      779                 cmdlog = substitute ('&1 &7 -H "Content-Type: application/json" &5 -d @&4 --stderr &6 &3/auth/simpleSignIn >&2',
      780                                       search ("exe/curl.exe"),
      781                                       vFileResult,
      782                                       server_,
      783                                       searchfile ("IsMotp_AuthDataSigned_db" + string(DB-num) + ".json"),
      784                                       CmdParamProxyLog,
      785                                       vFileResulterr,
      786                                       addCurlKeys).
      787                 putauth (" command   " + cmdlog ) .
      788                 os-command silent value (cmd).
      789                 vfile =  SearchFile(vFileResult).
      790                 if vfile eq ?
      791                 then do:
      792                   MSG = "Нет ответа от ИС МОТП. Не найден " + vFileResult.
      793                   putauth (MSG ).
      794                 end.
      795                 else do:
      796                   file-info:file-name = vfile .
      797                   if file-info:file-size = 0
      798                   then do :
      799                     MSG = "Нет ответа от ИС МОТП. Файл пустой " + vfile.
      800                     putauth ( MSG ).
      801                   end.
      802                   else do:
      803                     output stream sLog to value (vfile) append .
      804                     put stream sLog unformatted " " skip " _ ".
      805                     output stream sLog close .
      806                     input from value (vfile) convert source "UTF-8" .
      807                     import unformatted vLine .
      808                     input close .
      809                     do ii = 1 to num-entries(vLine) :
      810                       vStr = entry(ii, vLine) .
      811                       vStr = trim(vStr) .
      812                       vStr = trim(vStr, "[") .
      813                       vStr = trim(vStr, "]") .
      814                       vStr = trim(vStr, chr(123)) .
      815                       vStr = trim(vStr, "}") .
      816                       if num-entries(vStr, '":"') < 2 then next .
      817                       if vStr begins '"token"'
      818                       then do :
      819                         vStr = trim(trim(substring(vStr, 9)), '"') .
      820                         if index(vStr, '"') > 0
      821                         then do :
      822                           vToken = trim(trim(substring(vStr, 1, index(vStr, '"'))), '"') .
      823                         end .
      824                         else do :
      825                           vToken = vStr .
      826                         end .
      827                       end.
      828                       if vStr begins '"error_message"'
      829                       then do :
      830                         MSG = trim(trim(substring(vStr, 17)), '"').
      831                         putauth ( MSG ) .
      832                       end.
      833                       else do trans:
      834                         find first buf_ext-system-attr where buf_ext-system-attr.db-num   = esysDbNum
      835                                                          and buf_ext-system-attr.esys-id  = esysId
      836                                                          and buf_ext-system-attr.esya-attr-code = "AuthToken"
      837                                                          exclusive-lock no-error .
      838                         if not available buf_ext-system-attr
      839                         then do :
      840                           create buf_ext-system-attr.
      841                           assign
      842                             buf_ext-system-attr.db-num         = esysDbNum
      843                             buf_ext-system-attr.esys-id        = esysId
      844                             buf_ext-system-attr.esya-attr-code = "AuthToken"
      845                           .
      846                         end.
      847                         buf_ext-system-attr.esya-attr-value = vToken .
      848                         find first buf_ext-system-attr where buf_ext-system-attr.db-num   = esysDbNum
      849                                                          and buf_ext-system-attr.esys-id  = esysId
      850                                                          and buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
      851                                                          exclusive-lock no-error .
      852                         if not available buf_ext-system-attr
      853                         then do :
      854                           create buf_ext-system-attr.
      855                           assign
      856                             buf_ext-system-attr.db-num         = esysDbNum
      857                             buf_ext-system-attr.esys-id        = esysId
      858                             buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
      859                           .
      860                         end.
      861                         buf_ext-system-attr.esya-attr-value = string(datetime-tz(now)) .
      862                       end.
      863                     end.
      864                   end.
      865                 end.
      866               end.
      867             end.
      868             release object oSigner .
      869             release object oSignedData .
      870           end.
      871         end.
      872       end.
      873       release object oCert .
      874       if MSG <> ""
      875       then
      876          return error MSG .
      877       else do:
      878          StatusErr = no .
      879          return vToken .
      880       end.
      881     end method .
      882     method public character updateToken
      883     (
      884     input pToken as character
      885     ) :
      886       define variable cmd         as character no-undo .
      887       define variable cmdlog      as character no-undo .
      888       define variable vLine       as character no-undo .
      889       define variable vFileResult as character no-undo.
      890       define variable vFileResultErr as character no-undo.
      891       define variable vFileToken  as character no-undo.
      892       define variable VFile       as character no-undo.
      893       define variable vStr        as character no-undo.
      894       define variable tmpcmdfile  as character no-undo .
      895       define variable vNewToken   as character no-undo.
      896       define variable vPath       as character no-undo.
      897       define variable ii          as integer   no-undo .
      898       define variable vHTTPstatus as character no-undo .
      899       define buffer buf_ext-system-attr for ub.ext-system-attr .
      900       MSG = "".
      901       StatusErr = true.
      902       vPath = substring(server_, 1, (length(server_) - 8)) + "auth/login/refresh" .
      903       vFileResult    = "IsMotp_updateToken_db" + string(DB-num) + ".test".
      904       vFileResultErr = "IsMotp_updateToken_db" + string(DB-num) + ".err".
      905       vFileToken = "IsMotp_token_db" + string(DB-num) + ".txt".
      906       output stream sLog to value(vFileToken) .
      907         put stream sLog unformatted "Authorization: Bearer " pToken .
      908       output stream sLog close .
      909       cmd = substitute ('&1 &7 -X POST -L -i --stderr &6 -H "Content-Type: application/json;charset=UTF-8" -H @&4 &5 &3 >&2',
      910                         search ("exe/curl.exe"),
      911                         vFileResult,
      912                         vPath,
      913                         searchfile(vFileToken),
      914                         CmdParamProxy,
      915                         vFileResultErr,
      916                         addCurlKeys).
      917       cmdlog = substitute ('&1 &7 -X POST -L -i --stderr &6 -H "Content-Type: application/json;charset=UTF-8" -H "Authorization: Bearer &4" &5 &3 >&2',
      918                         search ("exe/curl.exe"),
      919                         vFileResult,
      920                         vPath,
      921                         pToken,
      922                         CmdParamProxyLOG,
      923                         vFileResultErr,
      924                         addCurlKeys).
      925       putauth (" command   " + cmdlog ) .
      926       os-command silent value(cmd) .
      927       vfile =  SearchFile(vFileResult).
      928       if vfile eq ?
      929       then do:
      930         MSG = "Нет ответа от ИС МОТП. Не найден " + vFileResult.
      931         putauth (MSG ).
      932       end.
      933       else do:
      934         file-info:file-name = vfile .
      935         if file-info:file-size = 0
      936         then do :
      937           MSG = "Нет ответа от ИС МОТП. Файл пустой " + vfile.
      938           putauth ( MSG ).
      939         end.
      940         else do:
      941           output stream sLog to value (vfile) append .
      942           put stream sLog unformatted " " skip " _ ".
      943           output stream sLog close .
      944           input from value (vfile) .
      945           import unformatted vLine .
      946           input close .
      947           HttpStatus = ? .
      948           assign vHTTPstatus = "unknown" .
      949           if vLine begins 'HTTP/2'
      950           then do :
      951             vHTTPstatus = trim(substring(vLine, 8)) .
      952             HttpStatus = integer(vHTTPstatus) .
      953           end.
      954           if vLine begins 'HTTP/1.1'
      955           then do :
      956             vHTTPstatus = trim(substring(vLine, 10,3)) .
      957             HttpStatus = integer(vHTTPstatus) .
      958           end.
      959           if HttpStatus = 502
      960           then do :
      961             MSG = "Невозможно обновить токен. Ответ от МОТП - 502 Bad Gateway. Пробуем работать с текущим" .
      962           end .
      963           else do :
      964             input from value (vfile) .
      965             read-file_ :
      966             repeat :
      967               import unformatted vStr .
      968               vStr = trim(vStr) .
      969               vStr = trim(vStr, "[") .
      970               vStr = trim(vStr, "]") .
      971               vStr = trim(vStr, chr(123)) .
      972               vStr = trim(vStr, "}") .
      973               if num-entries(vStr, '":"') < 2 then next .
      974               if vStr begins '"token"'
      975               then do :
      976                 vStr = trim(trim(substring(vStr, 9)), '"') .
      977                 if index(vStr, '"') > 0
      978                 then do :
      979                   vNewToken = trim(trim(substring(vStr, 1, index(vStr, '"'))), '"') .
      980                 end .
      981                 else do :
      982                   vNewToken = vStr .
      983                 end .
      984               end.
      985               if vStr begins '"error_message"'
      986               then do :
      987                 MSG = trim(trim(substring(vStr, 17)), '"').
      988                 putauth ( MSG ) .
      989               end.
      990               else do trans:
      991                 find first buf_ext-system-attr where buf_ext-system-attr.db-num   = esysDbNum
      992                                                  and buf_ext-system-attr.esys-id  = esysId
      993                                                  and buf_ext-system-attr.esya-attr-code = "AuthToken"
      994                 exclusive-lock no-error .
      995                 if not available buf_ext-system-attr
      996                 then do :
      997                   create buf_ext-system-attr.
      998                   assign
      999                     buf_ext-system-attr.db-num         = esysDbNum
     1000                     buf_ext-system-attr.esys-id        = esysId
     1001                     buf_ext-system-attr.esya-attr-code = "AuthToken"
     1002                   .
     1003                 end.
     1004                 buf_ext-system-attr.esya-attr-value = vNewToken .
     1005                 find first buf_ext-system-attr where buf_ext-system-attr.db-num   = esysDbNum
     1006                                                  and buf_ext-system-attr.esys-id  = esysId
     1007                                                  and buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
     1008                 exclusive-lock no-error .
     1009                 if not available buf_ext-system-attr
     1010                 then do :
     1011                   create buf_ext-system-attr.
     1012                   assign
     1013                     buf_ext-system-attr.db-num         = esysDbNum
     1014                     buf_ext-system-attr.esys-id        = esysId
     1015                     buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
     1016                   .
     1017                 end.
     1018                 buf_ext-system-attr.esya-attr-value = string(datetime-tz(now)) .
     1019                 leave read-file_ .
     1020               end.
     1021             end.
     1022             input close .
     1023           end .
     1024         end.
     1025       end.
     1026       if MSG <> ""
     1027       then
     1028         return error MSG .
     1029       else do:
     1030         StatusErr = no .
     1031         return vNewToken .
     1032       end.
     1033     end method .
     1034     method public logical needTokenUpd ()
     1035     :
     1036       define buffer buf_ext-system-attr for ub.ext-system-attr .
     1037       define variable vTokenDTdiff as datetime-tz no-undo .
     1038       find first buf_ext-system-attr where buf_ext-system-attr.db-num   = esysDbNum
     1039                                        and buf_ext-system-attr.esys-id  = esysId
     1040                                        and buf_ext-system-attr.esya-attr-code = "AuthTokenDT"
     1041       no-lock no-error .
     1042       if not available buf_ext-system-attr
     1043       then do :
     1044         return false .
     1045       end .
     1046       vTokenDTdiff = datetime-tz(buf_ext-system-attr.esya-attr-value) + 21600000 .
     1047       if vTokenDTdiff <= datetime-tz(now)
     1048       then do :
     1049         return true .
     1050       end .
     1051       else do :
     1052         return false .
     1053       end .
     1054     end method .
     1055     method public logical authTest
     1056     (
     1057     input pToken as character
     1058     ) :
     1059       define variable cmd         as character no-undo .
     1060       define variable cmdlog      as character no-undo .
     1061       define variable vLine       as character no-undo .
     1062       define variable vHTTPstatus as character no-undo .
     1063       define variable ii          as integer   no-undo .
     1064       define variable tmpfile     as character no-undo .
     1065       define variable tmpcmdfile  as character no-undo .
     1066       define variable vFileResult as character no-undo.
     1067       define variable vFileResultErr as character no-undo.
     1068       define variable vFileToken  as character no-undo.
     1069       StatusErr = true.
     1070       tmpfile = "tmpmotp_db" + string(DB-num) + ".json" .
     1071       output stream sLog to value(tmpfile) .
     1072         put stream sLog unformatted  '~{"gtin":"00000046210654"}' skip .
     1073       output stream sLog close .
     1074       putauthTest ( "  out-data:" ) .
     1075       if isDebug
     1076       then
     1077         os-append value(tmpfile) value(mFileAuthTest) .
     1078       vFileResult    = "IsMotp_AuthTest_db" + string(DB-num) + ".test".
     1079       vFileResultErr = "IsMotp_AuthTest_db" + string(DB-num) + ".err".
     1080       vFileToken = "IsMotp_token_db" + string(DB-num) + ".txt".
     1081       output stream sLog to value(vFileToken) .
     1082         put stream sLog unformatted "Authorization: Bearer " pToken .
     1083       output stream sLog close .
     1084       cmd = substitute ('&1 &8 -i -d @&5 --stderr &7 -H "Content-Type: application/json" -H @&4 &6 &3/cises/my >&2',
     1085                         search ("exe/curl.exe"),
     1086                         vFileResult,
     1087                         server_,
     1088                         searchfile (vFileToken),
     1089                         searchfile (tmpfile),
     1090                         CmdParamProxy,
     1091                         vFileResultErr,
     1092                         addCurlKeys).
     1093       cmdlog = substitute ('&1 &8 -i -d @&5 --stderr &7 -H "Content-Type: application/json" -H "Authorization: Bearer &4" &6 &3/cises/my >&2',
     1094                         search ("exe/curl.exe"),
     1095                         vFileResult,
     1096                         server_,
     1097                         pToken,
     1098                         searchfile (tmpfile),
     1099                         CmdParamProxyLOG,
     1100                         vFileResultErr,
     1101                         addCurlKeys).
     1102       putauthTest ( "command: " ).
     1103       putauthTest ( cmdLOG   ).
     1104       os-command silent value(cmd) .
     1105       define variable vfile as character no-undo.
     1106       vfile =  SearchFile(vFileResult).
     1107       if vfile eq ?
     1108       then do:
     1109          MSG = "Нет ответа от ИС МОТП. Не найден " + vFileResult.
     1110          putauth (MSG ).
     1111       end.
     1112       else do:
     1113          file-info:file-name = vfile .
     1114          if file-info:file-size = 0
     1115          then do :
     1116             MSG = "Нет ответа от ИС МОТП. Файл пустой " + vfile.
     1117             putauth ( MSG ).
     1118          end.
     1119          else do:
     1120             putauthTest (" in-data:" ) .
     1121             if isDebug
     1122             then
     1123               os-append value(vFileResult) value(mFileAuthTest) .
     1124             output stream sLog to value (searchfile(vFileResult)) append .
     1125             put stream sLog unformatted " " skip " _ ".
     1126             output stream sLog close .
     1127             input from value (searchfile(vFileResult)) .
     1128             import unformatted vLine .
     1129             input close .
     1130             HttpStatus = ? .
     1131             assign vHTTPstatus = "unknown" .
     1132             if vLine begins 'HTTP/2'
     1133             then do :
     1134               vHTTPstatus = trim(substring(vLine, 8)) .
     1135               HttpStatus = integer(vHTTPstatus) .
     1136             end.
     1137             if vLine begins 'HTTP/1.1'
     1138             then do :
     1139               vHTTPstatus = trim(substring(vLine, 10,3)) .
     1140               HttpStatus = integer(vHTTPstatus) .
     1141             end.
     1142             StatusErr = no.
     1143             if HttpStatus = 401
     1144             then do :
     1145               MSG = "Токен авторизации в ИС МОТП - НЕ ДЕЙСТВИТЕЛЕН" .
     1146               return false .
     1147             end .
     1148             else if HttpStatus = 502
     1149             then do :
     1150               MSG = "Невозможно определить валидность токена. Ответ от МОТП - 502 Bad Gateway. Пробуем работать с текущим" .
     1151               return true .
     1152             end .
     1153             else do :
     1154               MSG = "Токен авторизации в ИС МОТП - ДЕЙСТВИТЕЛЕН" .
     1155               return true .
     1156             end .
     1157          end.
     1158       end.
     1159     end method .
     1160     method public logical sendEMail
     1161     (
     1162     input pMessage as character
     1163     ) :
     1164       define variable email as character no-undo .
     1165       define variable ii as integer no-undo .
     1166       do ii = 1 to num-entries(mail-list):
     1167         email = trim(entry(ii, mail-list)).
     1168         if email = ? or email = "" then next.
     1169         run gbl/sendmail.p(
     1170             email,
     1171             "Ошибка авторизации в ИС МОТП",
     1172             pMessage,
     1173             ""
     1174         ) no-error.
     1175         if error-status:error
     1176         then do :
     1177           MSG = MSG + substitute("Ошибка при отправке на почту &1 - &2", email, return-value) + chr(10) .
     1178           StatusErr = true .
     1179         end .
     1180       end.
     1181     end method .
     1182     define variable GrayZoneQnty  as integer no-undo .
     1183     method public void cisesInfo
     1184     (
     1185     input pToken as character,
     1186     input pDB-num as integer,
     1187     input pDoc-id as integer,
     1188     input pLevel2 as logical,
     1189     output v-ok as logical
     1190     ) :
     1191       if pToken > ""
     1192       then .
     1193       else do :
     1194          v-ok = no.
     1195          MSG = "Запрос не выполнен. Нет токена для авторизации" .
     1196          return.
     1197       end.
     1198       define variable cmd    as character no-undo .
     1199       define variable cmdlog as character no-undo .
     1200       define variable vLine as character no-undo .
     1201       define variable vlongJson as longchar no-undo case-sensitive .
     1202       define variable v-num-marks as integer no-undo .
     1203       define variable vMark as character no-undo .
     1204       define variable vFileToken  as character no-undo.
     1205       define variable v-value-character     as character     no-undo .
     1206       define variable v-value-decimal       as decimal       no-undo .
     1207       define variable v-value-integer       as integer       no-undo .
     1208       define variable v-value-logical       as logical       no-undo .
     1209       define variable v-value-type          as character     no-undo .
     1210       define variable v-value-date          as date          no-undo .
     1211       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1212       define buffer buf_utd-lines for ub.utd-lines .
     1213       define buffer buf_marking for ub.marking .
     1214       define buffer buf_marking-parent for ub.marking .
     1215       define buffer buf_utd-err for ub.utd-err .
     1216       define buffer buf_utd for ub.utd .
     1217       Level2 = pLevel2 .
     1218       foundLevel2 = no .
     1219       if not checkINN
     1220       and lastLineCisInfo = 0
     1221       then do :
     1222         ClearUtdErrTypeCode(pDB-num, pDoc-id, "CheckMOTP", "MotpMarkErr").
     1223       end .
     1224       GrayZoneQnty = 100 .
     1225       find first buf_utd no-lock where buf_utd.db-num = pDB-num
     1226                                    and buf_utd.doc-id = pDoc-id
     1227                                    .
     1228       run adm/shattri.p (
     1229         input "get":U
     1230         ,input buf_utd.obj-type
     1231         ,input buf_utd.obj-code
     1232         ,input 'marking':U
     1233         ,input "gray_zone_qnty"
     1234         ,output v-value-character
     1235         ,output v-value-date
     1236         ,output v-value-decimal
     1237         ,output v-value-integer
     1238         ,output v-value-logical
     1239         ,output v-value-type
     1240         ,input-output TABLE thbjattr_thbj-attr
     1241         ) no-error .
     1242       if v-value-integer <> ?
     1243       then
     1244         GrayZoneQnty = v-value-integer
     1245       .
     1246       v-ok = true .
     1247       v-num-marks = 0 .
     1248       define variable vfilereq as character no-undo.
     1249       vfilereq = "IsMotp_cisesInfoReq_db" + string(DB-num) + ".json".
     1250       os-delete value (searchFile(vfilereq)) no-error .
     1251       if searchFile(vfilereq) = ?
     1252       then do : end .
     1253       else do :
     1254         v-ok = false .
     1255         Msg = "Запрос не выполнен! Не могу удалить файл-запрос " + vfilereq .
     1256         return .
     1257       end .
     1258       output stream sLog to value(vfilereq) .
     1259       put stream sLog unformatted "[" skip .
     1260       lines_:
     1261       for each buf_utd-lines no-lock where buf_utd-lines.db-num = pDB-num
     1262                                        and buf_utd-lines.doc-id = pDoc-id
     1263                                        and buf_utd-lines.LineNum >= lastLineCisInfo
     1264                                        break by buf_utd-lines.LineNum
     1265                                        :
     1266         if CheckErrForLine(buffer buf_utd-lines:handle)
     1267         then next lines_ .
     1268         marks_:
     1269         for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     1270                                                  and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     1271                                                  and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum,
     1272         first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
     1273                                                  break by  buf_utd-marking-lines.doc-id :
     1274           if CheckErrForMarkLine(buffer buf_utd-marking-lines:handle)
     1275           then
     1276             next marks_ .
     1277           if v-num-marks = 999
     1278           then do :
     1279             lastLineCisInfo = buf_utd-lines.LineNum .
     1280             leave lines_ .
     1281           end .
     1282           if needCheckUnit
     1283           then do :
     1284             if buf_marking.unit-ext = "UNIT"
     1285             and buf_marking.sts = objSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB
     1286             then do : end .
     1287             else
     1288               next marks_ .
     1289           end .
     1290           else do :
     1291             if pLevel2 and buf_marking.unit-ext <> "LEVEL2" then next marks_ .
     1292             if not pLevel2 and buf_marking.unit-ext = "LEVEL2" then next marks_ .
     1293             if checkINN and buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then next marks_ .
     1294             if buf_marking.unit-ext = "UNIT"
     1295             then do :
     1296               find first buf_marking-parent no-lock where buf_marking-parent.mark = buf_marking.mark-parent
     1297                                                       and (buf_marking-parent.sts  = objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB
     1298                                                          or buf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:DeliveryControl:KeyIntDB)
     1299                                                       no-error .
     1300               if available buf_marking-parent then next marks_ .
     1301             end .
     1302           end .
     1303           vMark = buf_utd-marking-lines.mark .
     1304           vMark = replace(vMark, '\', '\\') .
     1305           vMark = replace(vMark, '/', '\/') .
     1306           vMark = replace(vMark, '"', '\"') .
     1307           put stream sLog unformatted '"' vMark '"' .
     1308           v-num-marks = v-num-marks + 1 .
     1309           put stream sLog unformatted ',' skip .
     1310         end .
     1311       end .
     1312       put stream sLog unformatted '""' skip .
     1313       put stream sLog unformatted skip "]" skip.
     1314       output stream sLog close .
     1315       if v-num-marks <> 999 then lastLineCisInfo = 0 .
     1316       needCheckUnit = no .
     1317       if v-num-marks = 0
     1318       then do :
     1319         return .
     1320       end .
     1321       putcisesInfo (vfilereq + " (out-data):" ) .
     1322       if isDebug
     1323       then
     1324         os-append value(vfilereq) value(mFilecisesInfo) .
     1325       vFileToken     = "IsMotp_token_db" + string(DB-num) + ".txt".
     1326       output stream sLog to value(vFileToken) .
     1327         put stream sLog unformatted "Authorization: Bearer " pToken .
     1328       output stream sLog close .
     1329       define variable vCmdToken as character no-undo.
     1330       if pToken > ""
     1331       then
     1332          vCmdToken = substitute (' -H @&1', searchfile (vFileToken)).
     1333       define variable vfileresult as character no-undo.
     1334       define variable vfileresulterr as character no-undo.
     1335       vfileresult    = "IsMotp_cisesInfoResp_db" + string(DB-num) + ".json".
     1336       vfileresulterr = "IsMotp_cisesInfoResp_db" + string(DB-num) + ".err".
     1337       os-delete value (searchFile(vfileresult)) no-error .
     1338       if searchFile(vfileresult) = ?
     1339       then do : end .
     1340       else do :
     1341         v-ok = false .
     1342         Msg = "Запрос не выполнен! Не могу удалить файл-ответ " + vfileresult .
     1343         return .
     1344       end .
     1345       cmd = substitute ('&1 &8 -H "Content-Type: application/json" &5 &6 -d @&4 --stderr &7 &3/cises/info >&2',
     1346                         search ("exe/curl.exe"),
     1347                         vfileresult,
     1348                         server_,
     1349                         searchfile (vfilereq),
     1350                         vCmdToken,
     1351                         CmdParamProxy,
     1352                         vfileresulterr,
     1353                         addCurlKeys).
     1354       cmdlog = substitute ('&1 &8 -H "Content-Type: application/json" &5 &6 -d @&4 --stderr &7 &3/cises/info >&2',
     1355                         search ("exe/curl.exe"),
     1356                         vfileresult,
     1357                         server_,
     1358                         searchfile (vfilereq),
     1359                         vCmdToken,
     1360                         CmdParamProxylog,
     1361                         vfileresulterr,
     1362                         addCurlKeys).
     1363       putcisesInfo (" command:" ).
     1364       putcisesInfo ( cmdlog ) .
     1365       os-command silent value (cmd) .
     1366       if searchFile(vfileresult) = ?
     1367       then do :
     1368         v-ok = false .
     1369         MSG = "Запрос не выполнен! Нет ответа от МОТП. Не могу найти файл " + search(vfileresult) .
     1370         return .
     1371       end .
     1372       file-info:file-name = searchFile(vfileresult) .
     1373       if file-info:file-size = 0
     1374       then do :
     1375         v-ok = false .
     1376         MSG = "Запрос не выполнен! Файл-ответ из МОТП " + search(vfileresult) + " пустой (размер 0 байт)." .
     1377         return .
     1378       end .
     1379       copy-lob from file vfileresult to vlongJson .
     1380       vlongJson = replace(vlongJson, "&lt;", "###lo-then###") .
     1381       vlongJson = replace(vlongJson, "&Lt;", "###LO-then###") .
     1382       vlongJson = replace(vlongJson, "&lT;", "###lo-THEN###") .
     1383       vlongJson = replace(vlongJson, "&LT;", "###LO-THEN###") .
     1384       vlongJson = replace(vlongJson, "&gt;", "###gr-then###") .
     1385       vlongJson = replace(vlongJson, "&Gt;", "###GR-then###") .
     1386       vlongJson = replace(vlongJson, "&gT;", "###gr-THEN###") .
     1387       vlongJson = replace(vlongJson, "&GT;", "###GR-THEN###") .
     1388       vlongJson = replace(vlongJson, "&", "&amp;") .
     1389       vlongJson = replace(vlongJson, "<", "&lt;") .
     1390       vlongJson = replace(vlongJson, ">", "&gt;") .
     1391       vlongJson = replace(vlongJson, ':null', ':""') .
     1392       vlongJson = replace(vlongJson, (':' + CHR(91) + CHR(123) + CHR(125) + CHR(93)), ':""') .
     1393       copy-lob from vlongJson to file vfileresult .
     1394       putcisesInfo ( vfileresult + " (in-data):") .
     1395       if isDebug
     1396       then
     1397         os-append value(vfileresult) value(mFilecisesInfo) .
     1398       define variable vfileresultxml as character no-undo.
     1399       vfileresultxml = "IsMotp_cisesInfoResp_db" + string(DB-num) + ".xml".
     1400       os-delete value (searchFile(vfileresultxml)) no-error .
     1401       if searchFile(vfileresultxml) = ?
     1402       then do : end .
     1403       else do :
     1404         v-ok = false .
     1405         Msg = "Запрос не выполнен! Не могу удалить сконвертированный в xml файл-ответ " + vfileresultxml .
     1406         return .
     1407       end .
     1408       cmd = substitute ('&1 -file=&2 >&3',
     1409                          search("exe/json2xml.exe"),
     1410                          searchfile(vfileresult),
     1411                          vfileresultxml
     1412                          ) .
     1413       os-command silent value (cmd).
     1414       file-info:file-name = search(vfileresultxml) .
     1415       if file-info:file-size = 0
     1416       then do :
     1417         v-ok = false .
     1418         MSG = "Запрос не выполнен! Ошибка при конвертации json в XML. Файл " + search(vfileresultxml) + " пустой (размер 0 байт)." .
     1419         return .
     1420       end .
     1421       empty temp-table tt-childs .
     1422       Doc-Id = pDoc-id .
     1423       docdb-num = pDB-num .
     1424       ParseResponseInfoCises(searchfile(vfileresultxml)) .
     1425       Doc-Id = ? .
     1426       docdb-num = ? .
     1427       if Msg = "empty_file"
     1428       then do :
     1429         v-ok = false .
     1430         MSG = "Запрос не выполнен! Файл " + search(vfileresultxml) + " пустой (размер 0 байт)." .
     1431         return .
     1432       end .
     1433       if BadAuth
     1434       then do :
     1435         v-ok = false .
     1436         MSG = "Запрос не выполнен! Авторизация не пройдена. Попробуйте запросить новый токен." .
     1437         return .
     1438       end .
     1439     end method .
     1440     define variable v-cis as character case-sensitive no-undo .
     1441     define variable v-cis-child as character case-sensitive no-undo .
     1442     define variable v-unit as character no-undo .
     1443     define variable v-unit-child as character no-undo .
     1444     define variable v-gtin as character no-undo .
     1445     define variable v-num-childs as integer no-undo .
     1446     define variable v-must-be-childs as integer no-undo .
     1447     define variable v-err-childs as logical no-undo .
     1448     define variable v-gray-zone  as logical no-undo .
     1449     define buffer bf_marking for ub.marking .
     1450     define buffer bf_prod-bc for ub.prod-bc .
     1451     define buffer bf_bar-code for ub.bar-code .
     1452     define buffer bf2_bar-code for ub.bar-code .
     1453     define buffer bf_goods-attr for ub.goods-attr.
     1454     define variable cis-found-bc as logical no-undo .
     1455     define variable cisGtin as character no-undo .
     1456     define variable cisGdsCode as integer no-undo .
     1457     define variable v-mark-type  as character no-undo .
     1458     method private void ParseResponseInfoCises(inFileName as char):
     1459       define variable hDoc  as handle no-undo .
     1460       define variable hRoot as handle no-undo .
     1461       create x-document hDoc.
     1462       create x-noderef hRoot.
     1463       hDoc:load("file", inFileName, false) no-error.
     1464       if inFileName = ? then
     1465       do:
     1466         Msg = "empty_file" .
     1467         return .
     1468       end.
     1469       INNchecked = false .
     1470       BadAuth = false .
     1471       hDoc:get-document-element(hRoot).
     1472       GetChildrenInfoCises(hRoot, 1).
     1473       delete object hDoc.
     1474       delete object hRoot.
     1475     end.
     1476     method private void GetChildrenInfoCises(hParent as handle, level as integer):
     1477       define variable i           as integer no-undo .
     1478       define variable hNoderef    as handle  no-undo .
     1479       define variable hText       as handle  no-undo .
     1480       define variable tt          as integer no-undo .
     1481       define variable good        as logical   no-undo .
     1482       define variable v-item      as character no-undo .
     1483       define variable v-err-code  as integer no-undo .
     1484       define variable v-text      as character no-undo .
     1485       tt = hParent:num-children no-error .
     1486       if tt = ? then
     1487       do:
     1488         Msg = "Ошибка запроса. См. в файле ответа" .
     1489         return .
     1490       end.
     1491       create x-noderef hNoderef.
     1492       create x-noderef hText .
     1493       repeat i = 1 to hParent:num-children:
     1494         good = hParent:get-child(hNoderef,i).
     1495         if not good
     1496         then leave .
     1497         if hNoderef:name = "cisinfo" then
     1498         do:
     1499           assign
     1500             v-num-childs = 0
     1501             v-err-childs = false
     1502             v-gray-zone  = false
     1503             v-err-code   = 0
     1504             v-item       = ""
     1505             v-cis        = ""
     1506             v-gtin       = ""
     1507             v-cis-child  = ""
     1508             v-unit       = ""
     1509             v-unit-child = ""
     1510           .
     1511         end .
     1512         if hNoderef:subtype <> "element" then
     1513           next.
     1514         hNoderef:get-child(hText, 1) no-error .
     1515         assign
     1516           v-text = hText:node-value
     1517         no-error .
     1518         if v-text = ""
     1519         or v-text = ?
     1520         then next .
     1521         if hNoderef:name = "child" then
     1522         do:
     1523           assign
     1524             v-cis-child = hText:node-value
     1525           no-error .
     1526           v-cis-child = repSpecSimbforDm(v-cis-child) .
     1527           v-cis-child = replace(v-cis-child, "###lo-then###", "&lt;") .
     1528           v-cis-child = replace(v-cis-child, "###LO-then###", "&Lt;") .
     1529           v-cis-child = replace(v-cis-child, "###lo-THEN###", "&lT;") .
     1530           v-cis-child = replace(v-cis-child, "###LO-THEN###", "&LT;") .
     1531           v-cis-child = replace(v-cis-child, "###gr-then###", "&gt;") .
     1532           v-cis-child = replace(v-cis-child, "###GR-then###", "&Gt;") .
     1533           v-cis-child = replace(v-cis-child, "###gr-THEN###", "&gT;") .
     1534           v-cis-child = replace(v-cis-child, "###GR-THEN###", "&GT;") .
     1535           v-cis-child = replace(v-cis-child, '\\', '\') .
     1536           v-cis-child = replace(v-cis-child, '\/', '/') .
     1537           v-cis-child = replace(v-cis-child, '\"', '"') .
     1538           create tt-childs .
     1539           assign tt-childs.mark    = v-cis-child .
     1540           assign tt-childs.parent_ = "temp" .
     1541         end .
     1542         if hNoderef:name = "gtin" then
     1543         do:
     1544           v-item = "gtin" .
     1545           v-gtin = hText:node-value no-error .
     1546         end .
     1547         if hNoderef:name = "cis" then
     1548         do:
     1549           v-item = "cis" .
     1550           v-unit = "" .
     1551           v-unit-child = "" .
     1552           MSG = "" .
     1553           assign
     1554             v-cis = hText:node-value
     1555           no-error .
     1556           v-cis = repSpecSimbforDm(v-cis) .
     1557           v-cis = replace(v-cis, "###lo-then###", "&lt;") .
     1558           v-cis = replace(v-cis, "###LO-then###", "&Lt;") .
     1559           v-cis = replace(v-cis, "###lo-THEN###", "&lT;") .
     1560           v-cis = replace(v-cis, "###LO-THEN###", "&LT;") .
     1561           v-cis = replace(v-cis, "###gr-then###", "&gt;") .
     1562           v-cis = replace(v-cis, "###GR-then###", "&Gt;") .
     1563           v-cis = replace(v-cis, "###gr-THEN###", "&gT;") .
     1564           v-cis = replace(v-cis, "###GR-THEN###", "&GT;") .
     1565           v-cis = replace(v-cis, '\\', '\') .
     1566           v-cis = replace(v-cis, '\/', '/') .
     1567           v-cis = replace(v-cis, '\"', '"') .
     1568           if trim(v-cis) = "" or v-cis = ? then next .
     1569           for each tt-childs exclusive-lock where tt-childs.parent_ = "temp" :
     1570             assign tt-childs.parent_ = v-cis .
     1571           end.
     1572         end .
     1573         if hNoderef:name = "packageType" then
     1574         do:
     1575           v-item = "packageType" .
     1576           assign v-unit = hText:node-value no-error .
     1577           case v-unit :
     1578             when "LEVEL1" then v-unit-child = "UNIT" .
     1579             when "LEVEL2" then v-unit-child = "LEVEL1" .
     1580             when "LEVEL3" then v-unit-child = "LEVEL2" .
     1581             when "LEVEL4" then v-unit-child = "LEVEL3" .
     1582             when "LEVEL5" then v-unit-child = "LEVEL4" .
     1583           end case .
     1584         end .
     1585         if hNoderef:name = "ownerinn"
     1586         and checkINN
     1587         and INN > ""
     1588         then do :
     1589           v-item = "ownerinn" .
     1590           INNchecked = false .
     1591           if INN = hText:node-value
     1592           then do :
     1593             INNchecked = true .
     1594             updateUtdStatus(input docDB-num, input Doc-Id, input ObjSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB) .
     1595             return .
     1596           end .
     1597         end .
     1598         if hNoderef:name = "status"
     1599         and trim(v-cis) > ""
     1600         then do:
     1601           for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1602             assign v-num-childs = v-num-childs + 1 .
     1603           end .
     1604           find first bf_marking no-lock where bf_marking.mark begins v-cis no-error .
     1605           if not available bf_marking
     1606           or (available bf_marking
     1607               and bf_marking.gds-code = ?)
     1608           then do :
     1609             cisGdsCode = getGdsCodeByGtin(v-gtin) .
     1610           end .
     1611           else do :
     1612             cisGdsCode = bf_marking.gds-code .
     1613           end .
     1614           v-mark-type = "" .
     1615           for first bf_goods-attr no-lock where bf_goods-attr.attr-code = 'mark-type':U
     1616                                             and bf_goods-attr.gds-code = cisGdsCode
     1617                                             :
     1618             v-mark-type = bf_goods-attr.attr-value .
     1619           end .
     1620           if v-unit = "LEVEL2"
     1621           then do :
     1622             if cisGdsCode > 0
     1623             then do :
     1624               v-must-be-childs = 50 .
     1625               find first bf_bar-code no-lock where bf_bar-code.gds-code = cisGdsCode
     1626                                                and bf_bar-code.unit-cli = "кор"
     1627                                                and bf_bar-code.stts_ = 0
     1628               no-error .
     1629               if available bf_bar-code
     1630               then do :
     1631                 v-must-be-childs = bf_bar-code.cli-base-rate .
     1632                 find first bf2_bar-code no-lock where bf2_bar-code.gds-code = cisGdsCode
     1633                                                   and bf2_bar-code.unit-cli = "бл"
     1634                                                   and bf2_bar-code.stts_ = 0
     1635                 no-error .
     1636                 if available bf2_bar-code
     1637                 then do :
     1638                   v-must-be-childs = v-must-be-childs / bf2_bar-code.cli-base-rate .
     1639                 end .
     1640                 else do :
     1641                   MSG = "Для товара с кодом " + string(cisGdsCode) + " не найден код с ед. изм. 'бл'" .
     1642                   v-err-childs = true .
     1643                 end .
     1644               end .
     1645               else do :
     1646                 MSG = "Для товара с кодом " + string(cisGdsCode) + " не найден код с ед. изм. 'кор'" .
     1647                 v-err-childs = true .
     1648               end .
     1649               if not v-err-childs
     1650               then do :
     1651                 if isFirstEnter
     1652                 then do :
     1653                   if v-num-childs <> v-must-be-childs then v-err-childs = true .
     1654                 end .
     1655                 else do :
     1656                   if v-mark-type = "tabak"
     1657                   or v-mark-type = "stiki"
     1658                   then do :
     1659                     if v-num-childs <> v-must-be-childs
     1660                     then do:
     1661                       if GrayZoneQnty = 100
     1662                       then do :
     1663                         v-gray-zone = true .
     1664                       end .
     1665                       else do :
     1666                         if (v-must-be-childs - v-num-childs) <= GrayZoneQnty
     1667                         then v-gray-zone = true .
     1668                         else v-err-childs = true .
     1669                       end .
     1670                     end .
     1671                   end .
     1672                   else do :
     1673                     if v-num-childs <> v-must-be-childs then v-err-childs = true .
     1674                   end .
     1675                 end .
     1676                 if v-err-childs
     1677                 then do :
     1678                   MSG = "В коробе " + string(v-num-childs) + " блоков." .
     1679                 end .
     1680               end .
     1681             end .
     1682           end .
     1683           if v-unit = "LEVEL1"
     1684           or v-unit = "GROUP"
     1685           then do :
     1686             if cisGdsCode > 0
     1687             then do :
     1688               if available bf_marking
     1689               and bf_marking.gds-ext-id > ""
     1690               then do :
     1691                 cisGtin = bf_marking.gds-ext-id .
     1692               end .
     1693               else do :
     1694                 cisGtin = v-gtin .
     1695               end .
     1696               v-must-be-childs = 10 .
     1697               find first bf_bar-code no-lock where bf_bar-code.gds-code = cisGdsCode
     1698                                               and bf_bar-code.unit-cli = "бл"
     1699                                               and bf_bar-code.stts_ = 0
     1700               no-error .
     1701               if available bf_bar-code
     1702               then do :
     1703                 v-must-be-childs = bf_bar-code.cli-base-rate .
     1704               end .
     1705               else do :
     1706                 MSG = "Для товара с кодом " + string(cisGdsCode) + " не найден код с ед. изм. 'бл'" .
     1707                 v-err-childs = true .
     1708               end .
     1709               if not v-err-childs
     1710               then do :
     1711                 if isFirstEnter
     1712                 then do :
     1713                   if v-num-childs <> v-must-be-childs then v-err-childs = true .
     1714                 end .
     1715                 else do :
     1716                   if v-mark-type = "tabak"
     1717                   or v-mark-type = "stiki"
     1718                   then do :
     1719                     if v-num-childs <> v-must-be-childs and GrayZoneQnty <> 100
     1720                     then do:
     1721                       if (v-must-be-childs - v-num-childs) <= GrayZoneQnty
     1722                       then v-gray-zone = true .
     1723                       else v-err-childs = true .
     1724                     end .
     1725                   end .
     1726                   else do :
     1727                     if v-num-childs <> v-must-be-childs then v-err-childs = true .
     1728                   end .
     1729                 end .
     1730                 if v-err-childs
     1731                 then do :
     1732                   MSG = "В блоке " + string(v-num-childs) + " пачек." .
     1733                 end .
     1734               end .
     1735             end .
     1736           end .
     1737           if isFirstEnter
     1738           then do :
     1739             if hText:node-value = "DISAGGREGATED"
     1740             and v-unit = "LEVEL1"
     1741             then do :
     1742               UpdateMark(v-cis,
     1743                          if isFirstEnter then objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB else objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB,
     1744                          "",
     1745                          v-unit,
     1746                          v-gtin,
     1747                          hText:node-value) .
     1748               for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1749                 UpdateMark(tt-childs.mark,
     1750                            if isFirstEnter then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB else objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB,
     1751                            v-cis,
     1752                            v-unit-child,
     1753                            v-gtin,
     1754                            hText:node-value) .
     1755               end .
     1756             end .
     1757             else do :
     1758               if v-err-childs
     1759               then do :
     1760                 UpdateMark(v-cis,
     1761                            objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB,
     1762                            "",
     1763                            v-unit,
     1764                            v-gtin,
     1765                            hText:node-value) .
     1766               end .
     1767               else do :
     1768                 UpdateMark(v-cis,
     1769                            objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB,
     1770                            "",
     1771                            v-unit,
     1772                            v-gtin,
     1773                            hText:node-value) .
     1774               end .
     1775               for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1776                 UpdateMark(tt-childs.mark,
     1777                            objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB,
     1778                            v-cis,
     1779                            v-unit-child,
     1780                            v-gtin,
     1781                            hText:node-value) .
     1782               end .
     1783             end .
     1784           end .
     1785           else do :
     1786             case hText:node-value :
     1787               when "APPLIED" or
     1788               when "INTRODUCED" or
     1789               when "INTRODUCED_RETURNED"
     1790               then do :
     1791                 if v-err-childs
     1792                 then do :
     1793                   UpdateMark(v-cis,
     1794                              objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB,
     1795                              "",
     1796                              v-unit,
     1797                              v-gtin,
     1798                              hText:node-value) .
     1799                 end .
     1800                 else
     1801                 if v-gray-zone
     1802                 then do :
     1803                   UpdateMark(v-cis,
     1804                              objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB,
     1805                              "",
     1806                              v-unit,
     1807                              v-gtin,
     1808                              hText:node-value) .
     1809                 end .
     1810                 else do :
     1811                   UpdateMark(v-cis,
     1812                              objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB,
     1813                              "",
     1814                              v-unit,
     1815                              v-gtin,
     1816                              hText:node-value) .
     1817                 end .
     1818                 if v-mark-type = "tabak"
     1819                 or v-mark-type = "stiki"
     1820                 then do :
     1821                   for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1822                     UpdateMark(tt-childs.mark,
     1823                                objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB,
     1824                                v-cis,
     1825                                v-unit-child,
     1826                                v-gtin,
     1827                                hText:node-value) .
     1828                   end .
     1829                 end .
     1830                 else do :
     1831                   for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1832                     UpdateMark(tt-childs.mark,
     1833                                if v-err-childs then objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB else objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB,
     1834                                v-cis,
     1835                                v-unit-child,
     1836                                v-gtin,
     1837                                hText:node-value) .
     1838                   end .
     1839                 end .
     1840               end .
     1841               when "DISAGGREGATED"
     1842               then do :
     1843                 UpdateMark(v-cis,
     1844                            objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB,
     1845                            "",
     1846                            v-unit,
     1847                            v-gtin,
     1848                            hText:node-value) .
     1849                 for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1850                   needCheckUnit = yes .
     1851                   UpdateMark(tt-childs.mark,
     1852                              objSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB,
     1853                              v-cis,
     1854                              v-unit-child,
     1855                              v-gtin,
     1856                              "") .
     1857                 end .
     1858               end .
     1859               otherwise do :
     1860                 MSG = "Статус марки в МОТП - " + hText:node-value .
     1861                 UpdateMark(v-cis, objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB, "", v-unit, v-gtin, hText:node-value) .
     1862                 for each tt-childs no-lock where tt-childs.parent_ = v-cis :
     1863                   UpdateMark(tt-childs.mark, objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB, v-cis, v-unit-child, v-gtin, hText:node-value) .
     1864                 end .
     1865               end .
     1866             end case .
     1867           end .
     1868         end .
     1869         if hNoderef:name = "errormessage" then
     1870         do:
     1871           if trim(v-cis) = ""
     1872           or v-cis = ?
     1873           then next .
     1874           v-item = "errormessage" .
     1875           MSG = hText:node-value .
     1876           if v-err-code = 404
     1877           then do :
     1878             UpdateMark(v-cis, objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB, "", v-unit, v-gtin, "") .
     1879           end .
     1880         end .
     1881         if hNoderef:name = "errorCode" then
     1882         do:
     1883           BadAuth = false .
     1884           if integer(hText:node-value) = 401
     1885           then do :
     1886             BadAuth = true .
     1887             return .
     1888           end .
     1889           if trim(v-cis) = ""
     1890           or v-cis = ?
     1891           then next .
     1892           v-item = "errorCode" .
     1893           v-err-code = integer(hText:node-value) no-error .
     1894         end .
     1895         if hNoderef:name = "error_message" then
     1896         do:
     1897           if hText:node-value = "Для доступа к этому ресурсу требуется полная аутентификация"
     1898           then do :
     1899             BadAuth = true .
     1900             return .
     1901           end .
     1902         end .
     1903         if INNchecked then return .
     1904         if BadAuth then return .
     1905         GetChildrenInfoCises(hNoderef, (level + 1)) .
     1906         if INNchecked then return .
     1907         if BadAuth then return .
     1908       end.
     1909       delete object hNoderef.
     1910       delete object hText.
     1911     end method .
     1912     method private void UpdateMark
     1913     (
     1914     input pMark as character,
     1915     input pSts as integer,
     1916     input pParent as character,
     1917     input pUnit as character,
     1918     input pGtin as character,
     1919     input pMOTPsts as character
     1920     ) :
     1921       define buffer buf_utd for ub.utd .
     1922       define buffer buf_marking for ub.marking .
     1923       define buffer buf_marking-attr for ub.marking-attr .
     1924       define buffer buf_marking-parent for ub.marking .
     1925       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1926       define buffer buf_utd-marking-lines-parent for ub.utd-marking-lines .
     1927       define buffer buf_prod-bc for ub.prod-bc .
     1928       define buffer buf_bar-code for ub.bar-code .
     1929       define variable v-found-bc as logical no-undo .
     1930       define variable vGtin as character no-undo .
     1931       define variable vMarkType as character no-undo .
     1932       if checkINN then return .
     1933       if pMark = ?
     1934       or trim(pMark) = ""
     1935       then return .
     1936       find first buf_utd no-lock where buf_utd.db-num = docDB-num
     1937                                    and buf_utd.doc-id = Doc-id
     1938                                    no-error .
     1939       find first buf_marking exclusive-lock where buf_marking.mark begins pMark no-error .
     1940       if not available buf_marking
     1941       then do :
     1942         find first buf_marking-parent no-lock where buf_marking-parent.mark begins pParent and pParent <> "" no-error .
     1943         create buf_marking .
     1944         assign
     1945           buf_marking.mark = pMark
     1946           buf_marking.unit-ext = pUnit when pUnit <> ""
     1947         .
     1948         if available buf_utd
     1949         then
     1950         assign
     1951           buf_marking.obj-type = buf_utd.obj-type
     1952           buf_marking.obj-code = buf_utd.obj-code
     1953         .
     1954         buf_marking.box-qnty = ? .
     1955         if available buf_marking-parent
     1956         then do :
     1957           assign
     1958             buf_marking.mark-parent = buf_marking-parent.mark
     1959             buf_marking.gds-code    = buf_marking-parent.gds-code
     1960             buf_marking.gds-ext-id  = buf_marking-parent.gds-ext-id
     1961           .
     1962         end .
     1963       end .
     1964       assign
     1965         buf_marking.sts = pSts
     1966         buf_marking.unit-ext = pUnit when pUnit <> ""
     1967       .
     1968       if pUnit = "LEVEL2"
     1969       and not Level2
     1970       then do :
     1971         foundLevel2 = yes .
     1972       end .
     1973       if (buf_marking.gds-code = 0
     1974        or buf_marking.gds-code = ?)
     1975       and pGtin > ""
     1976       then do :
     1977         buf_marking.gds-code = getGdsCodeByGtin(pGtin) .
     1978         find first buf_utd-marking-lines where buf_utd-marking-lines.db-num eq buf_utd.db-num
     1979                                            and buf_utd-marking-lines.doc-id eq buf_utd.doc-id
     1980                                            and buf_utd-marking-lines.mark   eq buf_marking.mark
     1981         exclusive-lock no-error.
     1982         if available buf_utd-marking-lines
     1983         then do :
     1984           buf_utd-marking-lines.gds-code = buf_marking.gds-code .
     1985         end .
     1986       end .
     1987       find first buf_marking-parent no-lock where buf_marking-parent.mark = buf_marking.mark-parent and buf_marking.mark-parent <> "" no-error .
     1988       if available buf_marking-parent
     1989       and (buf_marking.gds-code = 0
     1990         or buf_marking.gds-code = ?)
     1991       then do :
     1992         assign
     1993           buf_marking.gds-code    = buf_marking-parent.gds-code
     1994         .
     1995       end .
     1996       if buf_marking.box-qnty <= 0
     1997       or buf_marking.box-qnty = ?
     1998       then do :
     1999         case pUnit :
     2000           when "UNIT"
     2001           then do :
     2002             buf_marking.box-qnty = 1 .
     2003           end .
     2004           when "LEVEL1"
     2005           then do :
     2006             for first buf_bar-code no-lock where buf_bar-code.gds-code = buf_marking.gds-code
     2007                                              and buf_bar-code.unit-cli = "блк"
     2008                                              and buf_bar-code.stts_ = 0
     2009             :
     2010               buf_marking.box-qnty = buf_bar-code.cli-base-rate .
     2011             end .
     2012           end .
     2013           when "LEVEL2"
     2014           then do :
     2015             for first buf_bar-code no-lock where buf_bar-code.gds-code = buf_marking.gds-code
     2016                                              and buf_bar-code.unit-cli = "кор"
     2017                                              and buf_bar-code.stts_ = 0
     2018             :
     2019               buf_marking.box-qnty = buf_bar-code.cli-base-rate .
     2020             end .
     2021           end .
     2022         end case .
     2023       end .
     2024       if pMOTPsts > ""
     2025       then do :
     2026         find first buf_marking-attr exclusive-lock where buf_marking-attr.mark = buf_marking.mark
     2027                                                      and buf_marking-attr.attr-code = "MOTPsts"
     2028                                                      no-error .
     2029         if not available buf_marking-attr
     2030         then do :
     2031           create buf_marking-attr .
     2032           assign
     2033             buf_marking-attr.mark = buf_marking.mark
     2034             buf_marking-attr.attr-code = "MOTPsts"
     2035           .
     2036         end .
     2037         assign
     2038           buf_marking-attr.attr-value = pMOTPsts
     2039         .
     2040       end .
     2041       if trim(buf_marking.gds-ext-id) = ""
     2042       and pGtin > ""
     2043       then do :
     2044         assign
     2045           buf_marking.gds-ext-id = pGtin
     2046         .
     2047       end .
     2048       if trim(pGtin) > ""
     2049       and buf_marking.gds-code <> ?
     2050       and buf_marking.gds-code <> 0
     2051       then do :
     2052         if buf_marking.unit-ext = "UNIT"
     2053         then do :
     2054           assign
     2055             v-found-bc = false .
     2056           .
     2057           for each buf_bar-code no-lock where buf_bar-code.gds-code = buf_marking.gds-code,
     2058           each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code
     2059                                      and buf_prod-bc.b-str  = pGtin
     2060                                      :
     2061             assign
     2062               v-found-bc = true .
     2063             .
     2064             leave .
     2065           end .
     2066           if not v-found-bc
     2067           then do :
     2068             run utl/upd-gtin.p (input docDB-num,
     2069                                 input buf_marking.gds-code,
     2070                                 input pGtin,
     2071                                 input (docDB-num = gbl-var:g#db-num))
     2072                                 no-error .
     2073             if error-status:error
     2074             then do :
     2075             end .
     2076           end .
     2077         end .
     2078         if buf_marking.unit-ext = "LEVEL1"
     2079         then do :
     2080           assign
     2081             v-found-bc = false .
     2082           .
     2083           vGtin = getGtinByDM(buf_marking.mark) .
     2084           find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_marking.gds-code
     2085                                             and buf_bar-code.cli-base-rate = buf_marking.box-qnty
     2086                                             no-error .
     2087           if available buf_bar-code
     2088           then do :
     2089             for each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code
     2090                                            and buf_prod-bc.b-str  = vGtin :
     2091               assign
     2092                 v-found-bc = true .
     2093               .
     2094               leave .
     2095             end .
     2096             if not v-found-bc
     2097             then do :
     2098               run utl/upd-gtin.p (input docDB-num,
     2099                                   input buf_bar-code.b-code,
     2100                                   input vGtin,
     2101                                   input (docDB-num = gbl-var:g#db-num))
     2102                                   no-error .
     2103               if error-status:error
     2104               then do :
     2105               end .
     2106             end .
     2107           end .
     2108         end .
     2109       end .
     2110       if pSts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2111       then do :
     2112         assign buf_marking.comment = MSG .
     2113         find first buf_utd-marking-lines where buf_utd-marking-lines.db-num eq buf_utd.db-num
     2114                                            and buf_utd-marking-lines.doc-id eq buf_utd.doc-id
     2115                                            and buf_utd-marking-lines.mark   eq buf_marking.mark
     2116         no-lock no-error.
     2117         AddUtdErr(buf_utd.db-num,
     2118                   buf_utd.doc-id,
     2119                   if available buf_utd-marking-lines
     2120                   then buffer buf_utd-marking-lines:handle
     2121                   else buffer buf_marking:handle,
     2122                   "CheckMOTP",
     2123                   "MotpMarkErr",
     2124                   (buf_marking.mark + chr(4) + MSG)).
     2125         if buf_marking.unit-ext <> "UNIT" and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB then
     2126         do:
     2127           buf_marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB .
     2128           buf_marking.unit = getLevelUTDByCodId(buf_marking.mark) .
     2129         end.
     2130         if buf_utd.EDocType <> objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     2131         then do :
     2132           if buf_marking.unit-ext = "LEVEL1"
     2133           and buf_marking.mark-parent <> ""
     2134           then do :
     2135             vMarkType = "" .
     2136             for first bf_goods-attr no-lock where bf_goods-attr.attr-code = 'mark-type':U
     2137                                               and bf_goods-attr.gds-code = cisGdsCode
     2138                                               :
     2139               vMarkType = bf_goods-attr.attr-value .
     2140             end .
     2141             if vMarkType = "tabak"
     2142             or vMarkType = "stiki"
     2143             then do :
     2144             end .
     2145             else do :
     2146               find first buf_marking-parent exclusive-lock where buf_marking-parent.mark = buf_marking.mark-parent no-error .
     2147               if available buf_marking-parent
     2148               then do :
     2149                 if buf_marking-parent.unit-ext = "LEVEL2"
     2150                 and buf_marking-parent.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2151                 then do :
     2152                   buf_marking-parent.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB .
     2153                 end .
     2154                 release buf_marking-parent no-error .
     2155               end .
     2156             end .
     2157           end .
     2158         end .
     2159       end .
     2160       if pParent <> ""
     2161       then do :
     2162         find first buf_utd-marking-lines exclusive-lock where buf_utd-marking-lines.mark begins pMark
     2163                                                           and buf_utd-marking-lines.db-num = docDB-num
     2164                                                           and buf_utd-marking-lines.doc-id = Doc-Id no-error .
     2165         if not available buf_utd-marking-lines
     2166         then do :
     2167           find first buf_utd-marking-lines-parent no-lock where buf_utd-marking-lines-parent.mark begins pParent
     2168                                                         and buf_utd-marking-lines-parent.db-num = docDB-num
     2169                                                         and buf_utd-marking-lines-parent.doc-id = Doc-Id no-error .
     2170           create buf_utd-marking-lines .
     2171           if available buf_utd-marking-lines-parent
     2172           then do :
     2173             buffer-copy buf_utd-marking-lines-parent to buf_utd-marking-lines
     2174             assign
     2175               buf_utd-marking-lines.mark = pMark
     2176               buf_utd-marking-lines.doc-level = buf_utd-marking-lines-parent.doc-level + 1
     2177             .
     2178           end .
     2179           else do :
     2180             assign
     2181               buf_utd-marking-lines.mark = pMark
     2182               buf_utd-marking-lines.db-num = docDB-num
     2183               buf_utd-marking-lines.doc-id = Doc-Id
     2184               buf_utd-marking-lines.doc-level = 1
     2185             .
     2186           end .
     2187         end .
     2188       end .
     2189     end method .
     2190     method public logical CheckStatus
     2191     (
     2192     input pDb-num as integer,
     2193     input pDoc-id as integer
     2194     ) :
     2195       define buffer buf_utd for ub.utd .
     2196       define buffer buf_marking for ub.marking .
     2197       define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     2198       define variable v-ok      as logical no-undo .
     2199       define variable v-not-checked as logical no-undo .
     2200       assign v-not-checked = false .
     2201       for each buf_utd-marking-lines no-lock where  buf_utd-marking-lines.db-num = pDb-num
     2202                                                 and buf_utd-marking-lines.doc-id = pDoc-id,
     2203       first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     2204         if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB
     2205         then do :
     2206           assign v-not-checked = true .
     2207           leave .
     2208         end .
     2209       end .
     2210       if v-not-checked then return false .
     2211       assign v-ok = true .
     2212       for each buf_utd-marking-lines no-lock where  buf_utd-marking-lines.db-num = pDb-num
     2213                                                 and buf_utd-marking-lines.doc-id = pDoc-id,
     2214       first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark :
     2215         if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:CheckContr:KeyIntDB
     2216         then do :
     2217           assign v-ok = false .
     2218           leave .
     2219         end .
     2220       end .
     2221       if not v-ok
     2222       then do :
     2223         for first buf_utd exclusive-lock where buf_utd.db-num = pDb-num
     2224                                            and buf_utd.doc-id = pDoc-id :
     2225           assign
     2226             buf_utd.sts = objSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     2227           .
     2228         end.
     2229       end .
     2230       else do :
     2231         for first buf_utd exclusive-lock where buf_utd.db-num = pDb-num
     2232                                            and buf_utd.doc-id = pDoc-id :
     2233           assign
     2234             buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     2235           .
     2236         end.
     2237       end .
     2238       return true .
     2239     end method .
     2240     method public void CheckSpec
     2241     (
     2242     input pDb-num as integer,
     2243     input pDoc-id as integer
     2244     ) :
     2245       run utl/utd-checkSpec.p (input pDb-num,
     2246                                input pDoc-id) .
     2247     end method .
     2248     method public void checkUtd
     2249     (
     2250     input pToken  as character,
     2251     input pDb-num as integer,
     2252     input pDoc-id as integer
     2253     ) :
     2254       define buffer buf_utd for ub.utd .
     2255       define buffer buf_utd-attr for ub.utd-attr .
     2256       define variable v-ok            as logical no-undo .
     2257       define variable cmd             as character no-undo .
     2258       define variable v-out-file-name as character no-undo .
     2259       define variable v-out-file-name-err as character no-undo .
     2260       define variable v-doc-code      as character no-undo .
     2261       define variable vlongJson       as longchar no-undo case-sensitive .
     2262       define variable vFileToken  as character no-undo.
     2263       Doc-Id = pDoc-id .
     2264       db-num = pDB-num .
     2265       assign v-ok = true .
     2266       find first buf_utd no-lock where buf_utd.db-num = pDb-num
     2267                                    and buf_utd.doc-id = pDoc-id
     2268                                    no-error .
     2269       if not available buf_utd
     2270       then do :
     2271         MSG = "Не найден УПД в БД " + string(pDb-num) + " c doc-id " + string(pDoc-id) .
     2272         return error MSG .
     2273       end.
     2274       v-doc-code = buf_utd.DocumentExt .
     2275       for first buf_utd-attr no-lock where buf_utd-attr.db-num    = buf_utd.db-num
     2276                                        and buf_utd-attr.doc-id    = buf_utd.doc-id
     2277                                        and buf_utd-attr.attr-code = "FileName"
     2278                                        and buf_utd-attr.attr-value > ""
     2279                                        :
     2280         v-doc-code = buf_utd-attr.attr-value .
     2281       end .
     2282       v-out-file-name     = substitute("IsMotp_docinfo_&1.json", buf_utd.doc-id) .
     2283       v-out-file-name-err = substitute("IsMotp_docinfo_&1.err", buf_utd.doc-id) .
     2284       vFileToken = "IsMotp_token_db" + string(DB-num) + ".txt".
     2285       output stream sLog to value(vFileToken) .
     2286         put stream sLog unformatted "Authorization: Bearer " pToken .
     2287       output stream sLog close .
     2288       cmd = substitute ('&1 &8 -H @&5 &6 --stderr &7 &3/documents/&4/info >&2',
     2289                         search ("exe/curl.exe"),
     2290                         v-out-file-name,
     2291                         server_,
     2292                         v-doc-code,
     2293                         searchfile(vFileToken),
     2294                         CmdParamProxy,
     2295                         v-out-file-name-err,
     2296                         addCurlKeys).
     2297       os-command silent value (cmd) .
     2298       define variable vfile as character no-undo.
     2299       vfile =  SearchFile(v-out-file-name).
     2300       if vfile eq ?
     2301       then do:
     2302         MSG = "Нет ответа от ИС МОТП. Не найден " + v-out-file-name.
     2303         putauth (MSG ).
     2304       end.
     2305       else do:
     2306         file-info:file-name = vfile .
     2307         if file-info:file-size = 0
     2308         then do :
     2309           MSG = "Нет ответа от ИС МОТП. Файл пустой " + vfile.
     2310           putauth ( MSG ).
     2311         end.
     2312         else do:
     2313           copy-lob from file vfile to vlongJson .
     2314           vlongJson = replace(vlongJson, "&lt;", "###lo-then###") .
     2315           vlongJson = replace(vlongJson, "&Lt;", "###LO-then###") .
     2316           vlongJson = replace(vlongJson, "&lT;", "###lo-THEN###") .
     2317           vlongJson = replace(vlongJson, "&LT;", "###LO-THEN###") .
     2318           vlongJson = replace(vlongJson, "&gt;", "###gr-then###") .
     2319           vlongJson = replace(vlongJson, "&Gt;", "###GR-then###") .
     2320           vlongJson = replace(vlongJson, "&gT;", "###gr-THEN###") .
     2321           vlongJson = replace(vlongJson, "&GT;", "###GR-THEN###") .
     2322           vlongJson = replace(vlongJson, "&", "&amp;") .
     2323           vlongJson = replace(vlongJson, "<", "&lt;") .
     2324           vlongJson = replace(vlongJson, ">", "&gt;") .
     2325           vlongJson = replace(vlongJson, ':null', ':""') .
     2326           vlongJson = replace(vlongJson, (':' + CHR(91) + CHR(123) + CHR(125) + CHR(93)), ':""') .
     2327           vlongJson = replace(vlongJson, (':' + CHR(91) + CHR(93)), ':""') .
     2328           vlongJson = replace(vlongJson, ':""', ':" "') .
     2329           copy-lob from vlongJson to file vfile .
     2330           cmd = substitute ('&1 -file=&2 >&3',
     2331                              search("exe/json2xml.exe"),
     2332                              vfile,
     2333                              ("IsMotp_" + string(buf_utd.doc-id) + ".xml")
     2334                              ) .
     2335           os-command silent value (cmd).
     2336           ParseResponseInfoDoc(input ("IsMotp_" + string(buf_utd.doc-id) + ".xml")) .
     2337         end.
     2338       end.
     2339     end method .
     2340     method private void ParseResponseInfoDoc(inFileName as char):
     2341       define variable hDoc  as handle no-undo .
     2342       define variable hRoot as handle no-undo .
     2343       create x-document hDoc.
     2344       create x-noderef hRoot.
     2345       hDoc:load("file", inFileName, false) no-error.
     2346       if inFileName = ? then
     2347       do:
     2348         Msg = "Файл не найден" .
     2349         return .
     2350       end.
     2351       hDoc:get-document-element(hRoot).
     2352       GetChildrenInfoDoc(hRoot, 1).
     2353       delete object hDoc.
     2354       delete object hRoot.
     2355     end.
     2356     method private void GetChildrenInfoDoc(hParent as handle, level as integer):
     2357       define variable i           as integer no-undo .
     2358       define variable hNoderef    as handle  no-undo .
     2359       define variable hText       as handle  no-undo .
     2360       define variable tt          as integer no-undo .
     2361       define variable good        as logical   no-undo .
     2362       define variable v-error     as character no-undo .
     2363       tt = hParent:num-children no-error .
     2364       if tt = ? then
     2365       do:
     2366         Msg = "Ошибка запроса. См. в файле ответа" .
     2367         return.
     2368       end.
     2369       create x-noderef hNoderef.
     2370       create x-noderef hText .
     2371       repeat i = 1 to hParent:num-children:
     2372         good = hParent:get-child(hNoderef,i).
     2373         if not good
     2374         then leave .
     2375         if hNoderef:subtype <> "element" then
     2376           next.
     2377         hNoderef:get-child(hText, 1) no-error .
     2378         if error-status:error then
     2379           next.
     2380         hText:node-value no-error .
     2381         if error-status:error then
     2382           next.
     2383         if hText:node-value = ? then
     2384           next.
     2385         if hNoderef:name = "status" then
     2386         do:
     2387           case hText:node-value :
     2388             when "CHECKED_OK"
     2389             then do :
     2390               updateUtdStatus(input DB-num, input Doc-Id, input ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Confirmed:KeyIntDB) .
     2391             end .
     2392             when "IN_PROGRESS"
     2393             then do :
     2394             end .
     2395             otherwise do :
     2396               updateUtdStatus(input DB-num, input Doc-Id, input ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_Error:KeyIntDB) .
     2397             end .
     2398           end case .
     2399         end .
     2400         if hNoderef:name = "errors" then
     2401         do:
     2402           v-error = hText:node-value .
     2403           if trim(v-error) > ""
     2404           and v-error <> "null"
     2405           then do :
     2406             define buffer buf_utd for ub.utd .
     2407             find first buf_utd no-lock where buf_utd.db-num = Db-num
     2408                                          and buf_utd.doc-id = Doc-id
     2409                                          no-error .
     2410             if available buf_utd
     2411             then do :
     2412               AddUtdErr(buf_utd.db-num,
     2413                         buf_utd.doc-id,
     2414                         buffer buf_utd:handle,
     2415                         "CheckMOTP",
     2416                         "LK_RECEIPT_Error",
     2417                         v-error).
     2418             end .
     2419           end .
     2420         end .
     2421         GetChildrenInfoDoc(hNoderef, (level + 1)).
     2422       end.
     2423       delete object hNoderef.
     2424       delete object hText.
     2425     end method .
     2426     method private logical updateUtdStatus
     2427     (
     2428     input pDb-num as integer,
     2429     input pDoc-id as integer,
     2430     input pSts    as integer
     2431     ) :
     2432       define variable p-ok as logical no-undo .
     2433       define buffer buf_utd for ub.utd .
     2434       assign p-ok = false .
     2435       for first buf_utd exclusive-lock where buf_utd.db-num   = pDb-num
     2436                                          and buf_utd.doc-id   = pDoc-id
     2437                                          :
     2438         assign
     2439           buf_utd.sts = pSts
     2440           p-ok = true
     2441         .
     2442       end .
     2443       return p-ok .
     2444     end method .
     2445     method private logical updateUtdStatusUUID
     2446     (
     2447     input pDb-num as integer,
     2448     input pDoc-id as integer,
     2449     input pSts    as integer,
     2450     input pUUID   as character
     2451     ) :
     2452       define variable p-ok as logical no-undo .
     2453       define buffer buf_utd for ub.utd .
     2454       assign p-ok = false .
     2455       for first buf_utd exclusive-lock where buf_utd.db-num   = pDb-num
     2456                                          and buf_utd.doc-id   = pDoc-id
     2457                                          :
     2458         assign
     2459           buf_utd.sts = pSts
     2460           buf_utd.DocumentExt = pUUID
     2461           p-ok = true
     2462         .
     2463       end .
     2464       return p-ok .
     2465     end method .
     2466     define stream cades .
     2467     define stream auth .
     2468     define stream authtest .
     2469     define stream cisesInfo .
     2470     define stream LK_RECEIPT .
     2471     method public void putauth(input itext as character):
     2472       if not isDebug then return .
     2473       output stream auth to value (mFileauth) append .
     2474       put stream auth unformatted now " " itext skip .
     2475       output stream auth close .
     2476     end.
     2477     method public void putcades(input itext as character):
