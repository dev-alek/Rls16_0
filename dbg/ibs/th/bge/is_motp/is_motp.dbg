     2699   method private void xmlchar-test (input  p-in-string          as character,
     2700                                     output p-out-string-enc     as character,
     2701                                     output p-out-string-dec    as character):
     2702   do
     2703   on error undo, return error
     2704   :
     2705          xmlchar-encode
     2706       (
     2707             input p-in-string
     2708           , output p-out-string-enc
     2709       ).
     2710          xmlchar-decode
     2711       (
     2712             input p-out-string-enc
     2713           , output p-out-string-dec
     2714       ).
     2715   end.
     2716   end .
     2717   method private void xmlchar-encode (input  p-in-string          as character,
     2718                                     output p-out-string         as character):
     2719       define variable v-position      as integer      no-undo.
     2720       define variable v-current-char  as character    no-undo.
     2721   do
     2722   on error undo, return error
     2723   :
     2724       assign
     2725           p-out-string = "":U
     2726       .
     2727       case p-in-string
     2728       :
     2729           when ?
     2730           then do:
     2731               assign
     2732                   p-out-string = "?":U
     2733               .
     2734           end.
     2735           when "?":U
     2736           then do:
     2737               assign
     2738                   p-out-string = "&#63;":U
     2739               .
     2740           end.
     2741           otherwise do:
     2742               do v-position = 1 to length( p-in-string )
     2743               :
     2744                   assign
     2745                       v-current-char = substring( p-in-string, v-position, 1 )
     2746                   .
     2747                   case v-current-char
     2748                   :
     2749                       when "&":U
     2750                       then do:
     2751                           assign
     2752                               p-out-string = p-out-string + "&amp;":U
     2753                           .
     2754                       end.
     2755                       when ">":U
     2756                       then do:
     2757                           assign
     2758                               p-out-string = p-out-string + "&gt;":U
     2759                           .
     2760                       end.
     2761                       when "<":U
     2762                       then do:
     2763                           assign
     2764                               p-out-string = p-out-string + "&lt;":U
     2765                           .
     2766                       end.
     2767                       when "'":U
     2768                       then do:
     2769                           assign
     2770                               p-out-string = p-out-string + "&apos;":U
     2771                           .
     2772                       end.
     2773                       when '"':U
     2774                       then do:
     2775                           assign
     2776                               p-out-string = p-out-string + "&quot;":U
     2777                           .
     2778                       end.
     2779                       when chr(1)
     2780                       then do:
     2781                           assign
     2782                               p-out-string = p-out-string + "":U
     2783                           .
     2784                       end.
     2785                       when chr(2)
     2786                       then do:
     2787                           assign
     2788                               p-out-string = p-out-string + "":U
     2789                           .
     2790                       end.
     2791                       when chr(3)
     2792                       then do:
     2793                           assign
     2794                               p-out-string = p-out-string + "":U
     2795                           .
     2796                       end.
     2797                       when chr(4)
     2798                       then do:
     2799                           assign
     2800                               p-out-string = p-out-string + "":U
     2801                           .
     2802                       end.
     2803                       when chr(5)
     2804                       then do:
     2805                           assign
     2806                               p-out-string = p-out-string + "":U
     2807                           .
     2808                       end.
     2809                       when chr(6)
     2810                       then do:
     2811                           assign
     2812                               p-out-string = p-out-string + "":U
     2813                           .
     2814                       end.
     2815                       when chr(7)
     2816                       then do:
     2817                           assign
     2818                               p-out-string = p-out-string + "":U
     2819                           .
     2820                       end.
     2821                       when chr(8)
     2822                       then do:
     2823                           assign
     2824                               p-out-string = p-out-string + "":U
     2825                           .
     2826                       end.
     2827                       when chr(9)
     2828                       then do:
     2829                           assign
     2830                               p-out-string = p-out-string + "":U
     2831                           .
     2832                       end.
     2833                       when chr(29)
     2834                       then do:
     2835                           assign
     2836                               p-out-string = p-out-string + "":U
     2837                           .
     2838                       end.
     2839                       when chr(10)
     2840                       then do:
     2841                           assign
     2842                               p-out-string = p-out-string + "&#10;":U
     2843                           .
     2844                       end.
     2845                       when chr(13)
     2846                       then do:
     2847                           assign
     2848                               p-out-string = p-out-string + "&#13;":U
     2849                           .
     2850                       end.
     2851                       otherwise do:
     2852                           assign
     2853                               p-out-string = p-out-string + v-current-char
     2854                           .
     2855                       end.
     2856                   end case.
     2857               end.
     2858           end.
     2859       end case.
     2860   end.
     2861   end .
     2862   method private character  xmlchar-encode-1c (input  p-in-string          as character):
     2863   define variable p-out-string as character no-undo.
