     2907                       then do:
     2908                           assign
     2909                               p-out-string = p-out-string + " ":U
     2910                           .
     2911                       end.
     2912                       when chr(5)
     2913                       then do:
     2914                           assign
     2915                               p-out-string = p-out-string + " ":U
     2916                           .
     2917                       end.
     2918                       when chr(6)
     2919                       then do:
     2920                           assign
     2921                               p-out-string = p-out-string + " ":U
     2922                           .
     2923                       end.
     2924                       when chr(7)
     2925                       then do:
     2926                           assign
     2927                               p-out-string = p-out-string + " ":U
     2928                           .
     2929                       end.
     2930                       when chr(8)
     2931                       then do:
     2932                           assign
     2933                               p-out-string = p-out-string + " ":U
     2934                           .
     2935                       end.
     2936                       when chr(9)
     2937                       then do:
     2938                           assign
     2939                               p-out-string = p-out-string + " ":U
     2940                           .
     2941                       end.
     2942                       when chr(29)
     2943                       then do:
     2944                           assign
     2945                               p-out-string = p-out-string + " ":U
     2946                           .
     2947                       end.
     2948                       when chr(10)
     2949                       then do:
     2950                           assign
