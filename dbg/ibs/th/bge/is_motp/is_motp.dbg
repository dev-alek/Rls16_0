     2656                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     2657                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     2658                                          and utd-marking-lines-attr.mark      eq imark
     2659                                          and utd-marking-lines-attr.attr-code eq iattrcode
     2660      no-lock no-error.
     2661      if not available utd-marking-lines-attr
     2662      then do:
     2663         if iattrval ne ?
     2664            and iattrval ne ""
     2665         then do:
     2666            create utd-marking-lines-attr.
     2667            assign
