     2480       put stream cades unformatted now " " itext skip .
     2481       output stream cades close .
     2482     end.
     2483     method public void putauthtest(input itext as character):
     2484       if not isDebug then return .
     2485       output stream authtest to value (mFileauthtest) append .
     2486       put stream authtest unformatted now " " itext skip .
     2487       output stream authtest close .
     2488     end.
     2489     method public void putcisesInfo(input itext as character):
     2490       if not isDebug then return .
     2491       output stream cisesInfo to value (mFilecisesInfo) append .
     2492       put stream cisesInfo unformatted now " " itext skip .
     2493       output stream cisesInfo close .
     2494     end.
     2495     method public void putLK_RECEIPT(input itext as character):
     2496       if not isDebug then return .
