        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.xmlimpexp final:
        4      define variable vss-revision    as character no-undo init "$Revision:$":U .
        5      define variable vss-author      as character no-undo init "$Author:$":U .
        6      define variable vss-date        as character no-undo init "$Date:$":U .
        7      define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        8      define variable vss-archive     as character no-undo init "$Archive:$":U .
        9      define variable vss-description as character no-undo init "".
       10   define variable vss-include-info0 as character format "X(65)" no-undo
       11   initial "@(#)$Workfile$ $Revision$".
       12   define temp-table temp_testXML-node no-undo
       13       field xmh-key       as integer
       14       field xmhNodName    as character
       15       index pi is primary unique
       16           xmh-key
       17       index nnm
       18           xmhNodName
       19   .
       20   define temp-table temp_testXML-entity no-undo
       21       field xme-key       as integer
       22       field xmh-key       as integer
       23       field xmeEntName    as character
       24       field xmeEntValue   as character
       25       index pi is primary unique
       26           xme-key
       27       index enm
       28           xmh-key
       29           xmeEntName
       30   .
       31   define temp-table temp_testXML-atribut no-undo
       32       field xme-key       as integer
       33       field xmeAtrName    as character
       34       field xmeAtrValue   as character
       35       index pi is primary unique
       36           xme-key
       37           xmeAtrName
       38   .
       39   define variable mRoot  as character no-undo init "Root".
       40   define stream xmldom-out.
       41   define variable mverfile_text as character   no-undo.
       42   define variable mverfile      as integer  no-undo.
       43   define variable v-xmldom-key       as integer      no-undo.
       44   define public property mTransaction  as logical init yes no-undo
       45      get.
       46      private set.
       47   method public void   xmldom-clear ():
       48       define buffer buf_temp_testXML-node         for temp_testXML-node.
       49       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
       50       define buffer buf_temp_testXML-atribut      for temp_testXML-atribut.
       51   do
       52   for buf_temp_testXML-node
       53     , buf_temp_testXML-entity
       54     , buf_temp_testXML-atribut
       55   on error undo, return error
       56   :
       57       empty temp-table buf_temp_testXML-node   .
       58       empty temp-table buf_temp_testXML-entity .
       59       empty temp-table buf_temp_testXML-atribut.
       60       assign
       61           v-xmldom-key = 0
       62           mTransaction = yes
       63       .
       64   end.
       65   end .
       66   method public void xmldom-add(p-node-name      as character,
       67                                  p-entity-name    as character,
       68                                  p-entity-value   as character):
       69       define buffer buf_temp_testXML-node         for temp_testXML-node.
       70       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
       71   do
       72   for buf_temp_testXML-node
       73     , buf_temp_testXML-entity
       74   on error undo, return error
       75   :
       76       find last buf_temp_testXML-node
       77       use-index pi no-error.
       78       if not available buf_temp_testXML-node
       79       then do:
       80           assign
       81               v-xmldom-key = 0
       82           .
       83       end.
       84       else do:
       85           assign
       86               v-xmldom-key = buf_temp_testXML-node.xmh-key
       87           .
       88       end.
       89       find last buf_temp_testXML-entity
       90       use-index pi
       91       no-error.
       92       if available buf_temp_testXML-entity
       93       then do:
       94           assign
       95               v-xmldom-key = max(v-xmldom-key,buf_temp_testXML-entity.xme-key)
       96           .
       97       end.
       98       find first buf_temp_testXML-node
       99            where buf_temp_testXML-node.xmhNodName = p-node-name
      100       no-error.
      101       if not available buf_temp_testXML-node
      102       then do:
      103           assign
      104               v-xmldom-key = v-xmldom-key + 1
      105           .
      106           create buf_temp_testXML-node.
      107           assign
      108               buf_temp_testXML-node.xmh-key    = v-xmldom-key
      109               buf_temp_testXML-node.xmhNodName = p-node-name
      110           .
      111       end.
      112       assign
      113           v-xmldom-key = v-xmldom-key + 1
      114       .
      115       create buf_temp_testXML-entity.
      116       assign
      117           buf_temp_testXML-entity.xme-key      = v-xmldom-key
      118           buf_temp_testXML-entity.xmh-key      = buf_temp_testXML-node.xmh-key
      119           buf_temp_testXML-entity.xmeEntName   = p-entity-name
      120           buf_temp_testXML-entity.xmeEntValue  = p-entity-value
      121       .
      122   end.
      123   end.
      124   method public void  xmldom-save-next-level
      125      ( iKey         as integer,
      126      i-doc-handle as handle,
      127      i-row-handle as handle):
      128      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      129      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      130      define variable v-field-handle  as handle           no-undo.
      131      define variable v-text-handle   as handle           no-undo.
      132      create x-noderef v-field-handle.
      133      create x-noderef v-text-handle.
      134      for each buf_temp_testXML-entity
      135         where buf_temp_testXML-entity.xmh-key = iKey
      136           and not buf_temp_testXML-entity.xmeEntName begins "#"
      137      on error undo, return error:
      138         i-doc-handle :create-node ( v-field-handle, buf_temp_testXML-entity.xmeEntName , "ELEMENT" ).
      139         for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-entity.xme-key
      140         no-lock:
      141            v-field-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      142         end.
      143         i-row-handle :append-child ( v-field-handle ).
      144         i-doc-handle :create-node ( v-text-handle, buf_temp_testXML-entity.xmeEntValue, "TEXT" ).
      145         v-field-handle :append-child ( v-text-handle ).
      146         if buf_temp_testXML-entity.xmeEntValue eq ?  then buf_temp_testXML-entity.xmeEntValue = "unknown_value".
      147         v-text-handle :node-value = buf_temp_testXML-entity.xmeEntValue.
      148        xmldom-save-next-level(buf_temp_testXML-entity.xme-key, i-doc-handle,v-field-handle).
      149      end.
      150      delete object v-field-handle.
      151      delete object v-text-handle.
      152   end.
      153   method public void  xmldom-save(iType  as character):
      154      define variable result as memptr no-undo.
      155      xmldom-save(iType, output result).
      156   end.
      157   method public void  xmldom-save(iType  as character,
      158   output result as memptr):
      159       define variable v-doc-handle    as handle           no-undo.
      160       define variable v-root-handle   as handle           no-undo.
      161       define variable v-row-handle    as handle           no-undo.
      162       define variable v-buf-handle    as handle           no-undo.
      163       define buffer buf_temp_testXML-node         for temp_testXML-node.
      164   do
      165   for buf_temp_testXML-node
      166   on error undo, return error
      167   :
      168       create x-document v-doc-handle.
      169       assign
      170           v-doc-handle :encoding = "windows-1251":U
      171       .
      172       create x-noderef v-root-handle.
      173       v-doc-handle :create-node ( v-root-handle, mRoot, "ELEMENT" ).
      174       v-doc-handle :append-child ( v-root-handle ).
      175       for each buf_temp_testXML-node where not buf_temp_testXML-node.xmhNodName begins "#"
      176       on error undo, return error
      177       :
      178           assign
      179               v-buf-handle = buffer buf_temp_testxml-node :handle
      180           .
      181           create x-noderef v-row-handle.
      182           v-doc-handle :create-node ( v-row-handle, buf_temp_testXML-node.xmhNodName, "ELEMENT" ).
      183           for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-node.xmh-key
      184           no-lock:
      185              v-row-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      186           end.
      187           v-root-handle :append-child ( v-row-handle ).
      188           xmldom-save-next-level(buf_temp_testXML-node.xmh-key,v-doc-handle,v-row-handle).
      189           delete object v-row-handle.
      190       end.
      191       if    iType eq "file"
      192       then do:
      193          os-delete result.
      194          v-doc-handle :save ( iType, result ).
      195          output stream xmldom-out to value( result ) append.
      196          put stream xmldom-out unformatted chr(10).
      197          output stream xmldom-out close.
      198       end.
      199       else if iType eq "memptr"
      200       then
      201          v-doc-handle :save ( iType, result ).
      202       else
      203          v-doc-handle :save ( "file", iType ).
      204       delete object v-doc-handle.
      205       delete object v-root-handle.
      206   end.
      207   end .
      208   method public logical  xmldom-load-atribut
      209      (IParent    as handle,
      210      iParentkey as integer
      211      ):
      212      def var vanames as char no-undo.
      213      def var vname as char no-undo.
      214      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      215      def var vi      as integer  no-undo.
      216      vanames = IParent:ATTRIBUTE-NAMES.
      217      do vi = 1 TO NUM-ENTRIES(vanames):
      218         vname = ENTRY(vi, vanames).
      219         create temp_testXML-atribut.
      220         assign
      221            temp_testXML-atribut.xme-key     = iParentkey
      222            temp_testXML-atribut.xmeatrName  = vname
      223            temp_testXML-atribut.xmeAtrValue = IParent:GET-ATTRIBUTE(vname)
      224         .
      225      END.
      226   end.
      227   define variable m-xme-key       as integer      no-undo.
      228   method public logical  xmldom-load-next-level
      229      (IParent    as handle,
      230      iParentkey as integer ,
      231      ifilever as int):
      232      define variable v-field-handle  as handle           no-undo.
      233      define variable v-text-handle   as handle           no-undo.
      234      define variable v-field-counter as integer          no-undo.
      235      define variable v-field-amount  as integer          no-undo.
      236      define variable vDateActive as date no-undo.
      237      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      238      create x-noderef v-field-handle.
      239      create x-noderef v-text-handle.
      240      assign
      241         v-field-amount = IParent :num-children
      242      .
      243      repeat v-field-counter = 1 to v-field-amount:
      244         IParent :get-child ( v-field-handle, v-field-counter ).
      245         if v-field-handle :num-children < 1
      246         then do:
      247            next.
      248         end.
      249         create buf_temp_testXML-entity.
      250         assign
      251            m-xme-key = m-xme-key + 1
      252            buf_temp_testXML-entity.xme-key     = m-xme-key
      253            buf_temp_testXML-entity.xmh-key     = iParentkey
      254         .
      255         v-field-handle :get-child ( v-text-handle, 1 ).
      256         if     IParent:name         eq "file-info"
      257            and v-field-handle :name eq "version"
      258         then do:
      259            mverfile = int(v-text-handle :node-value)no-error.
      260            if     ifilever ne ?
      261            then do:
      262               if  mverfile  eq ifilever
      263               then do:
      264                  for each buf_temp_testXML-entity:
      265                     delete buf_temp_testXML-entity.
      266                  end.
      267                  return yes.
      268               end.
      269            end.
      270         end.
      271         else if     IParent:name         eq "file-info"
      272                 and v-field-handle :name eq "DateActive"
      273         then do:
      274            vDateActive = date(v-text-handle :node-value)no-error.
      275            if     vDateActive ne ?
      276            then do:
      277               if  vDateActive  lt today
      278               then do:
      279                  for each buf_temp_testXML-entity:
      280                     delete buf_temp_testXML-entity.
      281                  end.
      282                  return yes.
      283               end.
      284            end.
      285         end.
      286         else if     IParent:name         eq "file-info"
      287                 and v-field-handle :name eq "NoTransaction"
      288         then do:
      289           mTransaction = no.
      290         end.
      291         assign
      292            buf_temp_testXML-entity.xmeEntName   = v-field-handle :name
      293            buf_temp_testXML-entity.xmeEntValue  = v-text-handle :node-value
      294         .
      295         if buf_temp_testXML-entity.xmeEntValue eq "unknown_value"  then buf_temp_testXML-entity.xmeEntValue = ?.
      296         xmldom-load-atribut(v-field-handle,buf_temp_testXML-entity.xme-key).
      297         xmldom-load-next-level (v-field-handle,buf_temp_testXML-entity.xme-key, ifilever ).
      298      end.
      299      delete object v-text-handle.
      300      delete object v-field-handle.
      301   end.
      302   method public character   xmldom-load-ver
      303    (i-full-filename    as character ,
      304      ifilever as integer ):
      305      define variable v-doc-handle    as handle           no-undo.
      306      define variable v-root-handle   as handle           no-undo.
      307      define variable v-table-handle  as handle           no-undo.
      308      define variable v-table-counter as integer      no-undo.
      309      define variable v-table-amount  as integer      no-undo.
      310      define buffer buf_temp_testXML-node         for temp_testXML-node.
      311      mverfile = ?.
      312      mverfile_text = ?.
      313      do
      314      for buf_temp_testXML-node
      315      on error undo, return error
      316      :
      317         assign
      318            i-full-filename = search( i-full-filename )
      319         .
      320         if i-full-filename = ?
      321         then do:
      322            undo, return "Загружаемый файл не найден.".
      323         end.
      324         create x-document v-doc-handle.
      325         v-doc-handle :encoding = "windows-1251":U.
      326         create x-noderef v-root-handle.
      327         create x-noderef v-table-handle.
      328         v-doc-handle :load ( "file", i-full-filename, true ) no-error.
      329         if    error-status :error
      330            or not valid-handle ( v-doc-handle )
      331            or v-doc-handle = ?
      332         then do:
      333            undo, return error vss-description + substitute( "Ошибка загрузки XML-файла &1", i-full-filename ).
      334         end.
      335         v-doc-handle :get-document-element ( v-root-handle ) no-error.
      336         if    error-status :error
      337            or not valid-handle ( v-root-handle )
      338            or v-root-handle = ?
      339         then do:
      340            undo, return error vss-description + substitute( "Ошибка чтения корневого тэга XML-файла &1", i-full-filename ).
      341         end.
      342         assign
      343            v-table-amount = v-root-handle :num-children
      344         no-error.
      345         if    error-status :error
      346            or v-table-amount = ?
      347         then do:
      348            undo, return error vss-description + substitute( ".&1Неверная структура XML-файла &2", chr(10), i-full-filename ).
      349         end.
      350         m-xme-key = v-table-amount +  1.
      351           repeat v-table-counter = 1 to v-table-amount:
      352            v-root-handle :get-child ( v-table-handle, v-table-counter ).
      353            create buf_temp_testXML-node.
      354            assign
      355               buf_temp_testXML-node.xmh-key       = v-table-counter
      356               buf_temp_testXML-node.xmhNodName    = v-table-handle :name
      357            .
      358            xmldom-load-atribut(v-table-handle,buf_temp_testXML-node.xmh-key).
      359            if xmldom-load-next-level (v-table-handle,buf_temp_testXML-node.xmh-key,ifilever)
      360            then do:
      361               for each buf_temp_testXML-node:
      362                  delete buf_temp_testXML-node.
      363               end.
      364               undo, return "Данные уже загружены.".
      365            end.
      366         end.
      367         delete object v-root-handle.
      368         delete object v-doc-handle.
      369         return mverfile_text.
      370      end.
      371   end .
      372   method public void  xmldom-load (p-full-filename as character ):
      373    xmldom-load-ver(p-full-filename,?) .
      374   end.
      375   method public void  getEnties
      376   (input  i-parkey      as integer ,
      377                                            input i-entity-name    as character ,
      378                                            output o-entity-value  as character,
      379                                            output o-found         as logical ):
      380       define variable v-entity-name       as character no-undo.
      381       define variable v-entity-name-next  as character no-undo.
      382       define buffer buf_temp_testXML-entity    for temp_testXML-entity.
      383       v-entity-name     = entry(1,i-entity-name).
      384       if num-entries(i-entity-name) > 1
      385       then
      386          assign
      387             v-entity-name-next =  substring (i-entity-name,length(v-entity-name) + 2)
      388          .
      389       find first buf_temp_testXML-entity
      390                where buf_temp_testXML-entity.xmh-key      = i-parkey
      391                  and buf_temp_testXML-entity.xmeEntName   = v-entity-name
      392           no-error.
      393       if available buf_temp_testXML-entity
      394       then do:
      395          if v-entity-name-next eq ""
      396          then assign
      397             o-entity-value = buf_temp_testXML-entity.xmeEntValue
      398             o-found        = yes
      399          .
      400          else do :
      401              getEnties(buf_temp_testXML-entity.xme-key,v-entity-name-next,output o-entity-value,output o-found).
      402          end.
      403       end.
      404   end .
      405   method public void  xmldom-read-unique (input  i-node-name      as character,
      406                                            input i-entity-name    as character ,
      407                                            output o-entity-value  as character,
      408                                            output o-found         as logical ):
      409   define variable v-entity-l1-name  as character no-undo.
      410   define variable v-entity-l2-name  as character no-undo.
      411       define buffer buf_temp_testXML-node         for temp_testXML-node.
      412   do
      413   for buf_temp_testXML-node
      414   on error undo, return error
      415   :
      416       assign
      417           o-found = no
      418       .
      419       search-all-nodes:
      420       for each buf_temp_testXML-node
      421          where buf_temp_testXML-node.xmhNodName = i-node-name
      422       :
      423           getEnties(buf_temp_testXML-node.xmh-key,i-entity-name,output o-entity-value,output o-found).
      424      end.
      425   end.
      426   end .
      427      define variable objKeyRec as ibs.th.gbl.keyrec no-undo.
      428      define variable iAll as logical no-undo.
      429      define variable iDopInfo as logical no-undo.
      430      constructor public xmlimpexp (  ):
      431         super ().
      432         objKeyRec = new ibs.th.gbl.keyrec().
      433      end constructor.
      434      destructor public xmlimpexp ( ):
      435          delete object objKeyRec.
      436      end destructor.
      437      method public void  savecode():
      438         define variable hQuery   as handle  no-undo .
      439         define buffer Buf_code for code.
      440         create query hQuery.
      441         hQuery:set-buffers(buffer Buf_code :HANDLE).
      442         hQuery:query-prepare("FOR EACH Buf_code ").
      443         hQuery:query-open ().
      444         updatetableforxml(hQuery).
      445         delete object hQuery.
      446      end.
      447      method public void repspecTableforXml (ilog as logical):
      448         define buffer buf_XML-entity for temp_testXML-entity.
      449         if ilog
      450         then
      451         for each buf_XML-entity:
      452            buf_XML-entity.xmeEntName= replace (buf_XML-entity.xmeEntName,"#","CHRgriidCHR").
      453         end.
      454         else
      455            for each buf_XML-entity:
      456               buf_XML-entity.xmeEntName= replace (buf_XML-entity.xmeEntName,"CHRgriidCHR","#").
      457            end.
      458      end.
      459      method public void updatetableforxml(ihandle as handle):
      460         define variable vBuffer as handle no-undo.
      461         define variable hField  as handle no-undo.
      462         define variable VTableName as character no-undo.
      463         define variable vNodeName as character no-undo.
      464         define variable vItem as integer no-undo.
      465         define buffer buf_XML-node   for temp_testXML-node.
      466         define buffer buf_XML-entity for temp_testXML-entity.
      467         define buffer buf_XML-field for temp_testXML-entity.
      468         define buffer buf_XML-atribut for temp_testXML-atribut.
      469         if iDopInfo
      470         then do:
      471         vNodeName = "File-info".
      472         find first buf_XML-node
      473             where buf_XML-node.xmhNodName = vNodeName
      474         no-error.
      475         if not available buf_XML-node
      476         then do:
      477            assign
      478               v-xmldom-key = v-xmldom-key + 1
      479            .
      480            create buf_XML-node.
      481            assign
      482               buf_XML-node.xmh-key    = v-xmldom-key
      483               buf_XML-node.xmhNodName = vNodeName
      484            .
      485            assign
      486               v-xmldom-key = v-xmldom-key + 1
      487               vNodeName = "version"
      488            .
      489            create buf_XML-entity.
      490            assign
      491               buf_XML-entity.xme-key      = v-xmldom-key
      492               buf_XML-entity.xmh-key      = buf_XML-node.xmh-key
      493               buf_XML-entity.xmeEntName   = vNodeName
      494               buf_XML-entity.xmeEntValue  = "000"
      495            .
      496            assign
      497               v-xmldom-key = v-xmldom-key + 1
      498               vNodeName = "DateActive"
      499            .
      500            create buf_XML-entity.
      501            assign
      502               buf_XML-entity.xme-key      = v-xmldom-key
      503               buf_XML-entity.xmh-key      = buf_XML-node.xmh-key
      504               buf_XML-entity.xmeEntName   = vNodeName
      505               buf_XML-entity.xmeEntValue  = "01.01.2100"
      506            .
      507         end.
      508         end.
      509         define variable vHQry as handle no-undo.
      510         if ihandle:type eq "temp-table"
      511         then do:
      512            vBuffer = ihandle:default-buffer-handle.
      513            create query  vHQry.
      514            vhQry:set-buffers (vBuffer).
      515            vHQry:query-prepare ("FOR EACH " + vBuffer:name + "  NO-LOCK").
      516            vHQry:query-open ().
      517            vHQry:get-first().
      518            VTAbleName = vBuffer:serialize-name.
      519         end.
      520         else if ihandle:type eq "query"
      521         then do:
      522            vHQry = ihandle.
      523            vHQry:get-first().
      524            vBuffer = ihandle:get-buffer-handle ().
      525            VTAbleName = vBuffer:table.
      526         end.
      527         else
      528            return error "Данный тип handle не поддерживается поддерживается только temp-table и query".
      529         if not vHQry:query-off-end
      530         then do:
      531            vNodeName = "table-" + VTAbleName.
      532            find first buf_XML-node
      533                 where buf_XML-node.xmhNodName = vNodeName
      534            no-error.
      535            if not available buf_XML-node
      536            then do:
      537               assign
      538                  v-xmldom-key = v-xmldom-key + 1
      539               .
      540               create buf_XML-node.
      541               assign
      542                  buf_XML-node.xmh-key    = v-xmldom-key
      543                  buf_XML-node.xmhNodName = vNodeName
      544               .
      545               if iDopInfo
      546               then do:
      547               create buf_XML-atribut.
      548               assign
      549                  buf_XML-atribut.xme-key      = v-xmldom-key
      550                  buf_XML-atribut.xmeAtrName   = "NwsNotSend"
      551                  buf_XML-atribut.xmeAtrValue  = "TableList"
      552               .
      553               end.
      554            end.
      555            vNodeName = "record-" + VTAbleName.
      556         end.
      557         do while not vHQry:query-off-end:
      558            assign
      559               v-xmldom-key = v-xmldom-key + 1
      560            .
      561            create buf_XML-entity.
      562            assign
      563               buf_XML-entity.xme-key      = v-xmldom-key
      564               buf_XML-entity.xmh-key      = buf_XML-node.xmh-key
      565               buf_XML-entity.xmeEntName   = vNodeName
      566               buf_XML-entity.xmeEntValue  = ""
      567            .
      568            if iDopInfo
      569            then do:
      570            create buf_XML-atribut.
      571               assign
      572               buf_XML-atribut.xme-key      = v-xmldom-key
      573               buf_XML-atribut.xmeAtrName   = "record-delete"
      574               buf_XML-atribut.xmeAtrValue  = "no"
      575            .
      576            end.
      577            block-field:
      578            do vItem = 1 to vBuffer:num-fields:
      579               assign hField = vBuffer:buffer-field(vItem) .
      580              if not iAll and hField:buffer-value eq hField:initial then next block-field.
      581               v-xmldom-key = v-xmldom-key + 1.
      582               create buf_XML-field.
      583                  assign
      584                  buf_XML-field.xme-key      = v-xmldom-key
      585                  buf_XML-field.xmh-key      = buf_XML-entity.xme-key
      586                  buf_XML-field.xmeEntName   = hField:name
      587                  buf_XML-field.xmeEntValue  = hField:buffer-value
      588               .
      589            end.
      590            vHQry:get-next().
      591         end.
      592         vHQry:query-close().
      593         repspecTableforXml(yes).
      594      end.
      595      define variable mfirst as logical no-undo init yes.
      596      method private void put-log (itext as character ):
      597         output to "xmlimpexp.log" append.
      598         if mfirst
      599         then do:
      600            put unformatted now skip.
      601            mfirst = no.
      602         end.
      603         put unformatted itext skip.
      604         output close.
      605      end.
      606      method public char GetAtrXml(ikey as int64, iAttrCode as character ):
      607         define buffer buf_XML-atribut for temp_testXML-atribut.
      608         find first buf_XML-atribut where buf_XML-atribut.xme-key    eq ikey
      609                                      and buf_XML-atribut.xmeAtrName eq iattrCode
      610         no-lock no-error.
      611         return if available buf_XML-atribut then buf_XML-atribut.xmeAtrValue else ?.
      612      end.
      613      method public void updatetablefordb():
      614         updatetablefordb (?).
      615      end.
      616      method public void updatetablefordb(ipublicHahdel as handle):
      617         define buffer buf_XML-node    for temp_testXML-node.
      618         define buffer buf_XML-entity  for temp_testXML-entity.
      619         define buffer buf_XML-field   for temp_testXML-entity.
      620         define buffer buf_XML-atribut for temp_testXML-atribut.
      621         define variable VTablename as character no-undo.
      622         define variable Vkey-rec   as character no-undo.
      623         define variable VTemp_table-h as handle no-undo.
      624         define variable VTemp_buffer-h as handle no-undo.
      625         define variable Vbuffer-h as handle no-undo.
      626         define variable VTemp_field-h as handle no-undo.
      627         define variable v-tbl-row as rowid no-undo .
      628         define variable v-tbl-name as character no-undo .
      629         define variable vtexterr as character no-undo.
      630         define variable vi as integer no-undo.
      631         repspecTableforXml(no).
      632         for each buf_XML-node where buf_xml-node.xmhNodName begins "table-"
      633         no-lock:
      634            VTablename  = substring(buf_xml-node.xmhNodName,length("table-") + 1).
      635            define variable mglobnwsdis as character no-undo.
      636            mglobnwsdis = GetAtrXml (buf_xml-node.xmh-key,"NwsNotSend").
      637            create temp-table VTemp_table-h.
      638            VTemp_table-h:create-like( substitute('ub.&1',VTablename )) no-error.
      639            if error-status:error then do:
      640               vtexterr = substitute( "&1. Ошибка при создании temp-table &2 &3&4&5", vss-workfile,VTablename , return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      641               put-log(vtexterr).
      642               undo, return  error vtexterr.
      643            end.
      644            VTemp_table-h:temp-table-prepare( "tt-" + vtablename ) .
      645            VTemp_buffer-h = VTemp_table-h:default-buffer-handle.
      646            create buffer Vbuffer-h for table substitute('ub.&1', VTablename).
      647            for each buf_XML-entity where buf_XML-entity.xmh-key      = buf_XML-node.xmh-key
      648                                      and buf_XML-entity.xmeEntName   = "record-" + VTablename
      649            no-lock:
      650               define variable mlocalnwsdis as character no-undo.
      651               if ipublicHahdel ne ?
      652               then do:
      653                  mlocalnwsdis = GetAtrXml (buf_XML-entity.xme-key,"NwsNotSend").
      654                  if mlocalnwsdis ne ?
      655                  then
      656                     publish "DisableNwsTable" from ipublicHahdel (mlocalnwsdis).
      657                  else
      658                     publish "DisableNwsTable" from ipublicHahdel (mglobnwsdis).
      659               end.
      660               VTemp_buffer-h:buffer-create() no-error.
      661               if error-status:error then do:
      662                  vtexterr = substitute( "&1. Ошибка при создании записи в temp-table &2 &3&4&5", VTablename , vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      663                  put-log(vtexterr).
      664                  undo, return  error vtexterr.
      665               end.
      666               do vi = 1 to VTemp_buffer-h:num-fields:
      667                  VTemp_field-h = VTemp_buffer-h:buffer-field(vi).
      668                  find first buf_XML-field where buf_XML-field.xmh-key      = buf_XML-entity.xme-key
      669                                             and buf_XML-field.xmeEntName   = VTemp_field-h:name
      670                  no-lock no-error.
      671                  if available buf_XML-field
      672                  then
      673                     VTemp_field-h:buffer-value = buf_XML-field.xmeEntValue .
      674               end.
      675               objKeyRec:GenKeyRec
      676                 ( input  VTablename
      677                  ,input VTemp_buffer-h
      678                  ,output Vkey-rec
      679                  ) no-error .
      680               if error-status :error then do:
      681                   vtexterr = substitute( "&1. Ошибка при генерации пропущенного уникального ключа для таблицы &2.&3&4&3&5"
      682                                 ,vss-workfile
      683                                 ,VTablename
      684                                 ,chr(10)
      685                                 ,return-value
      686                                 ,error-status :get-message ( error-status :num-messages )
      687                               ).
      688                   put-log(vtexterr).
      689                   undo, return  error vtexterr.
      690               end.
      691               objKeyRec:genrowkeyr
      692                  ( input  Vkey-rec
      693                    ,input ?
      694                    ,input "ub"
      695                    ,input ?
      696                    ,input share-lock
      697                    ,output v-tbl-row
      698                    ,output v-tbl-name
      699                  ) no-error .
      700              if error-status :error then do:
      701                 vtexterr = substitute( "&1. Ошибка при поиске записи по уникальному ключу &2.&3&4&3&5"
      702                                ,vss-workfile
      703                                ,Vkey-rec
      704                                ,chr(10)
      705                                ,return-value
      706                                ,error-status :get-message ( error-status :num-messages )
      707                              ).
      708                 put-log(vtexterr).
      709                 undo, return  error vtexterr.
      710               end.
      711               if v-tbl-name <> VTablename then do:
      712                  vtexterr = substitute( "&1. Уникальный ключ &2 не соответствует принимаемой записи &3"
      713                                ,vss-workfile
      714                                ,Vkey-rec
      715                                ,VTablename
      716                              ).
      717                  put-log(vtexterr).
      718                  undo, return  error vtexterr.
      719               end.
      720               define variable  Vrecord-delete as logical no-undo.
      721               find first buf_XML-atribut where buf_XML-atribut.xme-key      = buf_XML-entity.xme-key
      722                                            and buf_XML-atribut.xmeAtrName   = "record-delete"
      723               no-lock no-error.
      724               if avail buf_XML-atribut
      725               then do:
      726                  assign
      727                     vrecord-delete = no
      728                     vrecord-delete = logical(buf_XML-field.xmeEntValue)
      729                  no-error.
      730               end.
      731               else do:
      732                  find first buf_XML-field where buf_XML-field.xmh-key      = buf_XML-entity.xme-key
      733                                             and buf_XML-field.xmeEntName   = "record-delete"
      734                  no-lock no-error.
      735                  assign
      736                     vrecord-delete = no
      737                     vrecord-delete = logical(buf_XML-field.xmeEntValue)
      738                  no-error.
      739               end.
      740               do trans:
      741                  Vbuffer-h:find-by-rowid( v-tbl-row, exclusive-lock ) no-error.
      742                  if vrecord-delete
      743                  then do:
      744                     if v-tbl-row ne ?
      745                     then do:
      746                        Vbuffer-h:buffer-delete() no-error.
      747                        if error-status:error then do:
      748                           vtexterr = substitute( "&1. Ошибка при удаление записи &2 с ключем &3 в БД  &4&5&6", vss-workfile, VTablename,Vkey-rec,  return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      749                           put-log(vtexterr).
      750                           undo, return  error vtexterr.
      751                        end.
      752                        put-log(substitute( "Запись с ключем &1 успешна удалена.",Vkey-rec)).
      753                     end.
      754                     else do:
      755                        put-log(substitute( "Запись с ключем &1 не существует в бд и не может быть удалена.",Vkey-rec)).
      756                     end.
      757                  end.
      758                  else do:
      759                     Vbuffer-h:buffer-copy(VTemp_buffer-h) no-error .
      760                     if error-status:error then do:
      761                        vtexterr = substitute( "&1. Ошибка при создание/изменение записи &2 с ключем &3 в БД  &3&4&5", vss-workfile, VTablename, Vkey-rec, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      762                        put-log(vtexterr).
      763                        undo, return  error vtexterr.
      764                     end.
      765                     Vbuffer-h:buffer-release no-error .
      766                     if error-status:error then do:
      767                        vtexterr = substitute( "&1. Ошибка при копировании записи &2 с ключем &3 в БД  &3&4&5", vss-workfile, VTablename, Vkey-rec, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
      768                        put-log(vtexterr).
      769                        undo, return  error vtexterr.
      770                     end.
      771                     put-log(substitute( "Запись с ключем &1 успешна обновлена.", Vkey-rec)).
      772                  end.
      773               end.
      774               VTemp_buffer-h:buffer-delete() no-error.
      775            end.
      776            if ipublicHahdel ne ?
      777            then
      778               publish "DisableNwsTable" from ipublicHahdel (?).
      779            delete object VTemp_table-h.
      780            delete object Vbuffer-h.
      781         end.
      782         for each buf_XML-node where buf_xml-node.xmhNodName eq "After-Imp-Run"
      783         no-lock:
      784            define variable vproc  as character no-undo.
      785            define variable vparam as character no-undo.
      786            define variable vOk as logical no-undo.
      787            vproc = GetAtrXml (buf_XML-node.xmh-key,"After-Imp-Run-Procedure").
      788            if vproc ne ""
      789            then do:
      790               vparam = "".
      791               for each buf_XML-entity where buf_XML-entity.xmh-key      = buf_XML-node.xmh-key
      792               no-lock:
      793                  vparam = vparam + chr(4) +  buf_XML-entity.xmeEntName + chr(4) + buf_XML-entity.xmeEntValue.
      794               end.
      795               vparam = trim( vparam, chr(4)).
      796               if ipublicHahdel ne ?
      797               then do:
      798                  publish "RunProcXmlImp" from ipublicHahdel (vproc, vparam, output vok).
      799                  if vOk ne true
      800                  then do:
      801                     vtexterr = substitute( "&1. Ошибка при Выполнение &2 спараметром &6.&3&4&3&5"
      802                                ,vss-workfile
      803                                ,vproc
      804                                ,chr(10)
      805                                ,return-value
      806                                ,error-status :get-message ( error-status :num-messages )
      807                                ,vparam
      808                              ).
      809                    put-log(vtexterr).
      810                    undo, return  error vtexterr.
      811                  end.
      812               end.
      813            end.
      814         end.
      815      end.
      816   end class.
