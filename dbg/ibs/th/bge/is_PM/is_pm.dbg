     1834                   tt-place.start-chk-fact-qnty = tt-place.start-chk-fact-qnty + (buf_chk-gds.doc-qnty * v-density) .
     1835                 end .
     1836                 else do :
     1837                   tt-place.start-chk-fact-qnty = tt-place.start-chk-fact-qnty + (buf_chk-gds.doc-qnty * buf_chk-gds.density) .
     1838                 end .
     1839               end .
     1840             end .
     1841             income-doc-line_ :
     1842             for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1843                                             and buf_doc-line.obj-code  = obj-code
     1844                                             and buf_doc-line.artic     = buf_goods.artic
     1845                                             and buf_doc-line.prod-type = buf_goods.prod-type
     1846                                             and buf_doc-line.prod-code = buf_goods.prod-code
     1847                                             and buf_doc-line.status_   = 'факт':U
     1848                                             ,
     1849             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1850                                         and (buf_trn-doc.ext-doc-type = 'ie':U or buf_trn-doc.ext-doc-type = 'iv':U or buf_trn-doc.ext-doc-type = 'vt':U)
     1851                                         and ((buf_trn-doc.fact-date > start_rvs-doc.fact-date) or
     1852                                              (buf_trn-doc.fact-date = start_rvs-doc.fact-date and buf_trn-doc.fact-time > start_rvs-doc.fact-time))
     1853                                         and ((buf_trn-doc.fact-date < date-start) or
     1854                                              (buf_trn-doc.fact-date = date-start and buf_trn-doc.fact-time <= time-start))
     1855                                         :
     1856   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1857                           input 'othermoves':U ,
     1858                          output vIsOtherMoves ,
     1859                          output vType )  .
     1860               if vIsOtherMoves > ""
     1861               and logical(vIsOtherMoves)
     1862               then next income-doc-line_ .
     1863               if buf_trn-doc.ext-doc-type <> 'vt':U
     1864               then
     1865               for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1866                                                    and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1867                                                    and buf_clients-attr.attr-code = 'shftrep2':U
     1868                                                    :
     1869                 if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     1870               end .
     1871               for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1872                                             and buf_doc-pl.obj-code = obj-code
     1873                                             and buf_doc-pl.pl-code  = tt-place.pl-code
     1874                                             and buf_doc-pl.out-code = buf_doc-line.doc-code
     1875                                             and buf_doc-pl.gds-code = tt-place.gds-code
     1876                                             :
     1877                 tt-place.start-trn-fact-qnty = tt-place.start-trn-fact-qnty + buf_doc-pl.cli-fact-qnty .
     1878               end .
     1879             end .
     1880             expense-doc-line_ :
     1881             for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1882                                             and buf_doc-line.obj-code  = obj-code
     1883                                             and buf_doc-line.artic     = buf_goods.artic
     1884                                             and buf_doc-line.prod-type = buf_goods.prod-type
     1885                                             and buf_doc-line.prod-code = buf_goods.prod-code
     1886                                             and buf_doc-line.status_   = 'факт':U
     1887                                             ,
     1888             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1889                                         and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
     1890                                         and ((buf_trn-doc.fact-date > start_rvs-doc.fact-date) or
     1891                                              (buf_trn-doc.fact-date = start_rvs-doc.fact-date and buf_trn-doc.fact-time > start_rvs-doc.fact-time))
     1892                                         and ((buf_trn-doc.fact-date < date-start) or
     1893                                              (buf_trn-doc.fact-date = date-start and buf_trn-doc.fact-time <= time-start))
     1894                                         :
     1895   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1896                           input 'othermoves':U ,
     1897                          output vIsOtherMoves ,
     1898                          output vType )  .
     1899               if vIsOtherMoves > ""
     1900               and logical(vIsOtherMoves)
     1901               then next expense-doc-line_ .
     1902               for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1903                                                    and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1904                                                    and buf_clients-attr.attr-code = 'shftrep2':U
     1905                                                    :
     1906                 if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
     1907               end .
