     2094     , output  v-density
     2095     , output v-Reconc-tank-attr
     2096     ) no-error .
     2097             end .
     2098             tt-result.wght-sale = tt-result.wght-sale + (buf_chk-gds.doc-qnty * v-density) .
     2099             if session:debug-alert
     2100             then do:
