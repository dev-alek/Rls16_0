     1189             and logical(vIsOtherMoves)
     1190             then next income-doc-line_ .
     1191             if buf_trn-doc.ext-doc-type <> 'vt':U
     1192             then
     1193             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1194                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1195                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1196                                                  :
     1197               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     1198             end .
     1199             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1200                                           and buf_doc-pl.obj-code = obj-code
     1201                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1202                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1203                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1204                                           :
     1205               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty + buf_doc-pl.cli-fact-qnty .
     1206             end .
     1207           end .
     1208           expense-doc-line_ :
     1209           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1210                                           and buf_doc-line.obj-code  = obj-code
     1211                                           and buf_doc-line.artic     = buf_goods.artic
     1212                                           and buf_doc-line.prod-type = buf_goods.prod-type
     1213                                           and buf_doc-line.prod-code = buf_goods.prod-code
     1214                                           and buf_doc-line.status_   = 'факт':U
     1215                                           ,
     1216           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1217                                       and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
     1218                                       and ((buf_trn-doc.fact-date > end_rvs-doc.fact-date) or
     1219                                            (buf_trn-doc.fact-date = end_rvs-doc.fact-date and buf_trn-doc.fact-time >  end_rvs-doc.fact-time))
     1220                                       and ((buf_trn-doc.fact-date < date-end) or
     1221                                            (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     1222                                       :
     1223   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1224                           input 'othermoves':U ,
     1225                          output vIsOtherMoves ,
     1226                          output vType )  .
     1227             if vIsOtherMoves > ""
     1228             and logical(vIsOtherMoves)
     1229             then next expense-doc-line_ .
     1230             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1231                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1232                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1233                                                  :
     1234               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
     1235             end .
     1236             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1237                                           and buf_doc-pl.obj-code = obj-code
     1238                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1239                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1240                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1241                                           :
     1242               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty - buf_doc-pl.cli-fact-qnty .
     1243             end .
     1244           end .
     1245           leave end_rvs-doc_ .
     1246         end .
     1247         for first tt-result where tt-result.gds-code = tt-place.gds-code :
     1248           tt-result.wght-fact-end = tt-result.wght-fact-end + (tt-place.end-rvs-fact-qnty - tt-place.end-chk-fact-qnty + tt-place.end-trn-fact-qnty) .
     1249           if abs(tt-result.wght-fact-end) < 0.001 then tt-result.wght-fact-end = 0 .
     1250           if session:debug-alert
     1251           then do:
     1252             put stream OutStr-html unformatted
     1253               "wght-fact-end Формула 1" skip
     1254               "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     1255               string(tt-place.end-rvs-fact-qnty) + " - " +  string (tt-place.end-chk-fact-qnty) +  " + " + string(tt-place.end-trn-fact-qnty) skip
     1256               string(tt-result.wght-fact-end) skip
     1257             .
     1258           end.
     1259         end .
     1260       end .
     1261       for each tt-place where tt-place.is-income,
     1262       first buf_goods no-lock where buf_goods.gds-code = tt-place.gds-code,
     1263       first gds-prt no-lock where gds-prt.upper-code = buf_goods.prt-root,
     1264       first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code
     1265                                    and buf_bar-code.node-code = gds-prt.node-code
     1266                                    and buf_bar-code.in-code = ""
     1267                                    and buf_bar-code.part-code = ""
     1268                                    and buf_bar-code.unit-cli = buf_goods.unit-base
     1269       :
     1270         for last end_rvs-doc no-lock where end_rvs-doc.obj-type = obj-type
     1271                                        and end_rvs-doc.obj-code = obj-code
     1272                                        and end_rvs-doc.rvs-type = 'контроль':U
     1273                                        and end_rvs-doc.status_  = 'факт':U
     1274                                        and ((integer(entry(1, end_rvs-doc.rvs-code, "-")) < tt-place.rvs-doc-num)
     1275                                          or (end_rvs-doc.fact-date = tt-place.income-date and end_rvs-doc.fact-time <= tt-place.income-time))
     1276                                        by end_rvs-doc.fact-order
     1277                                        :
     1278           tt-place.is-calc = true .
     1279           tt-place.rvs-doc-code = end_rvs-doc.rvs-code .
     1280           for first end_rvs-line no-lock where end_rvs-line.obj-type  = end_rvs-doc.obj-type
     1281                                            and end_rvs-line.obj-code  = end_rvs-doc.obj-code
     1282                                            and end_rvs-line.rvs-code  = end_rvs-doc.rvs-code
     1283                                            and end_rvs-line.pl-code   = tt-place.pl-code
     1284                                            and end_rvs-line.gds-code  = tt-place.gds-code
     1285                                            :
     1286             tt-place.end-rvs-fact-qnty = end_rvs-line.state-measure-cli-qnty + (end_rvs-line.state-add-qnty * end_rvs-line.state-density) .
     1287           end .
     1288           chk-doc_ :
     1289           for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-type
     1290                                          and buf_chk-doc.obj-code = obj-code
     1291                                          and buf_chk-doc.chk-date >= end_rvs-doc.fact-date
     1292                                          and buf_chk-doc.chk-date <= date-end
     1293                                          :
     1294             if buf_chk-doc.chk-date = end_rvs-doc.fact-date
     1295             and buf_chk-doc.chk-time <= end_rvs-doc.fact-time
     1296             then next chk-doc_ .
     1297             if buf_chk-doc.chk-date = date-end
     1298             and buf_chk-doc.chk-time > time-end
     1299             then next chk-doc_ .
     1300             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
     1301             chk-gds_ :
     1302             for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1303                                            and buf_chk-gds.b-code   = buf_bar-code.b-code
     1304                                            :
     1305               if buf_chk-doc.out-code = ?
     1306               then do :
     1307                 v-pl-code = findtank (buf_chk-doc.obj-type,
     1308                                       buf_chk-doc.obj-code,
     1309                                       buf_chk-gds.pump,
     1310                                       buf_chk-gds.nozzle-code,
     1311                                       buf_chk-gds.pl-code,
     1312                                       buf_bar-code.gds-code) .
     1313                 if v-pl-code = ?
     1314                 or v-pl-code = 0
     1315                 then do :
     1316                   v-pl-code = findblockedtank (buf_chk-doc.obj-type,
     1317                                                buf_chk-doc.obj-code,
     1318                                                buf_chk-gds.pump,
     1319                                                buf_chk-gds.nozzle-code,
     1320                                                buf_chk-gds.pl-code,
     1321                                                buf_bar-code.gds-code) .
     1322                 end .
     1323               end .
     1324               else do :
     1325                 v-pl-code = buf_chk-gds.pl-code .
     1326               end .
     1327               if v-pl-code <> tt-place.pl-code then next chk-gds_ .
     1328               if not valid-density (buf_chk-gds.density, (buf_goods.unit-base = buf_goods.unit-cli))
     1329               then do :
     1330                 v-density = 0 .
     1331                 if lookup('смн-ош':U, buf_chk-doc.office) > 0
     1332                 then do :
     1333                   find last buf_shift-obj no-lock where buf_shift-obj.obj-type = buf_chk-doc.obj-type
     1334                                                     and buf_shift-obj.obj-code = buf_chk-doc.obj-code
     1335                                                     and ((buf_shift-obj.open-date < buf_chk-doc.chk-date)
     1336                                                       or (buf_shift-obj.open-date = buf_chk-doc.chk-date and buf_shift-obj.open-time < buf_chk-doc.chk-time))
     1337                                                     no-error .
     1338                   if available buf_shift-obj
     1339                   then do :
     1340   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     1341     (  input  tt-place.gds-code
     1342     ,  input  buf_chk-doc.obj-type
     1343     ,  input  buf_chk-doc.obj-code
     1344     ,  input  tt-place.pl-code
     1345     ,  input  buf_shift-obj.shift-date
     1346     ,  input  buf_shift-obj.shift-num
     1347     ,  input  buf_chk-doc.chk-date
     1348     ,  input  buf_chk-doc.chk-time
     1349     , output  v-density
     1350     , output v-Reconc-tank-attr
     1351     ) no-error .
     1352                   end .
     1353                   else do :
     1354   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     1355     (  input  tt-place.gds-code
     1356     ,  input  buf_chk-doc.obj-type
     1357     ,  input  buf_chk-doc.obj-code
     1358     ,  input  tt-place.pl-code
     1359     ,  input  buf_chk-doc.chk-date
     1360     ,  input  1
     1361     ,  input  buf_chk-doc.chk-date
     1362     ,  input  buf_chk-doc.chk-time
     1363     , output  v-density
     1364     , output v-Reconc-tank-attr
     1365     ) no-error .
     1366                   end .
     1367                 end .
     1368                 else do :
     1369   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     1370     (  input  tt-place.gds-code
     1371     ,  input  buf_chk-doc.obj-type
     1372     ,  input  buf_chk-doc.obj-code
     1373     ,  input  tt-place.pl-code
     1374     ,  input  buf_chk-doc.shift-date
     1375     ,  input  buf_chk-doc.shift-num
     1376     ,  input  buf_chk-doc.chk-date
     1377     ,  input  buf_chk-doc.chk-time
     1378     , output  v-density
     1379     , output v-Reconc-tank-attr
     1380     ) no-error .
     1381                 end .
     1382                 tt-place.end-chk-fact-qnty = tt-place.end-chk-fact-qnty + (buf_chk-gds.doc-qnty * v-density) .
     1383               end .
     1384               else do :
     1385                 tt-place.end-chk-fact-qnty = tt-place.end-chk-fact-qnty + (buf_chk-gds.doc-qnty * buf_chk-gds.density) .
     1386               end .
     1387             end .
     1388           end .
     1389           income-doc-line_ :
     1390           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1391                                           and buf_doc-line.obj-code  = obj-code
     1392                                           and buf_doc-line.artic     = buf_goods.artic
     1393                                           and buf_doc-line.prod-type = buf_goods.prod-type
     1394                                           and buf_doc-line.prod-code = buf_goods.prod-code
     1395                                           and buf_doc-line.status_   = 'факт':U
     1396                                           ,
     1397           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1398                                       and (buf_trn-doc.ext-doc-type = 'ie':U or buf_trn-doc.ext-doc-type = 'iv':U or buf_trn-doc.ext-doc-type = 'vt':U)
     1399                                       and ((buf_trn-doc.fact-date > end_rvs-doc.fact-date) or
     1400                                            (buf_trn-doc.fact-date = end_rvs-doc.fact-date and buf_trn-doc.fact-time >  end_rvs-doc.fact-time))
     1401                                       and ((buf_trn-doc.fact-date < date-end) or
     1402                                            (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     1403                                       :
     1404   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1405                           input 'othermoves':U ,
     1406                          output vIsOtherMoves ,
     1407                          output vType )  .
     1408             if vIsOtherMoves > ""
     1409             and logical(vIsOtherMoves)
     1410             then next income-doc-line_ .
     1411             if buf_trn-doc.ext-doc-type <> 'vt':U
     1412             then
     1413             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1414                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1415                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1416                                                  :
     1417               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     1418             end .
     1419             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1420                                           and buf_doc-pl.obj-code = obj-code
     1421                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1422                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1423                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1424                                           :
     1425               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty + buf_doc-pl.cli-fact-qnty .
     1426             end .
     1427           end .
     1428           expense-doc-line_ :
     1429           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1430                                           and buf_doc-line.obj-code  = obj-code
     1431                                           and buf_doc-line.artic     = buf_goods.artic
     1432                                           and buf_doc-line.prod-type = buf_goods.prod-type
     1433                                           and buf_doc-line.prod-code = buf_goods.prod-code
     1434                                           and buf_doc-line.status_   = 'факт':U
     1435                                           ,
     1436           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1437                                       and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
     1438                                       and ((buf_trn-doc.fact-date > end_rvs-doc.fact-date) or
     1439                                            (buf_trn-doc.fact-date = end_rvs-doc.fact-date and buf_trn-doc.fact-time >  end_rvs-doc.fact-time))
     1440                                       and ((buf_trn-doc.fact-date < date-end) or
     1441                                            (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     1442                                       :
     1443   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     1444                           input 'othermoves':U ,
     1445                          output vIsOtherMoves ,
     1446                          output vType )  .
     1447             if vIsOtherMoves > ""
     1448             and logical(vIsOtherMoves)
     1449             then next expense-doc-line_ .
     1450             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1451                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1452                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1453                                                  :
     1454               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
     1455             end .
     1456             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1457                                           and buf_doc-pl.obj-code = obj-code
     1458                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1459                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1460                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1461                                           :
     1462               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty - buf_doc-pl.cli-fact-qnty .
     1463             end .
     1464           end .
     1465         end .
     1466         for first tt-result where tt-result.gds-code = tt-place.gds-code :
     1467           tt-result.wght-fact-end = tt-result.wght-fact-end + (tt-place.end-rvs-fact-qnty - tt-place.end-chk-fact-qnty + tt-place.end-trn-fact-qnty) .
     1468           if abs(tt-result.wght-fact-end) < 0.001 then tt-result.wght-fact-end = 0 .
     1469           if session:debug-alert
     1470           then do:
     1471             put stream OutStr-html unformatted
     1472               "wght-fact-end Формула 1" skip
     1473               "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     1474               string(tt-place.end-rvs-fact-qnty) + " - " +  string (tt-place.end-chk-fact-qnty) +  " + " + string(tt-place.end-trn-fact-qnty) skip
     1475               string(tt-result.wght-fact-end) skip
     1476             .
     1477           end.
     1478         end .
     1479       end .
     1480       for each tt-place :
     1481         run write-to-log in p-parent-handle ("place " + string(tt-place.pl-code) + ": " + tt-place.pl-name + "; " +
     1482                                               string(tt-place.is-income) + "; " +
     1483                                               tt-place.rvs-doc-code + "; " +
     1484                                               string(tt-place.is-calc) +
     1485                                               (if tt-place.is-calc
     1486                                                then
     1487                                                 ("; " +
     1488                                                  string-mth(tt-place.end-rvs-fact-qnty) + ": " +
     1489                                                  string-mth(tt-place.end-chk-fact-qnty) + ": " +
     1490                                                  string-mth(tt-place.end-trn-fact-qnty) + "; "
     1491                                                 )
     1492                                                else "; ") +
     1493                                               string-mth(tt-place.end-rvs-fact-qnty - tt-place.end-chk-fact-qnty + tt-place.end-trn-fact-qnty)
     1494                                               ) .
     1495       end .
     1496       for each tt-result,
     1497       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     1498       :
     1499         run write-to-log in p-parent-handle ("gds " + string(tt-result.gds-code) + ": " + buf_goods.gds-name + "; " +
     1500                                              string-mth(tt-result.wght-fact-end)
     1501                                              ) .
     1502       end .
     1503       run write-to-log in p-parent-handle (" END FACT-END UTC " + utc-time() ) .
     1504     end method .
     1505     method private void stage3 () :
     1506       define buffer buf_trn-doc for ub.trn-doc .
     1507       define buffer buf_doc-line for ub.doc-line .
     1508       define buffer buf_doc-pl for ub.doc-pl .
     1509       define buffer start_rvs-doc for ub.rvs-doc .
     1510       define buffer start_rvs-line for ub.rvs-line .
     1511       define buffer buf_chk-doc for ub.chk-doc .
     1512       define buffer buf_chk-gds for ub.chk-gds .
     1513       define buffer buf_bar-code for ub.bar-code .
     1514       define buffer buf_goods for ub.goods .
     1515       define buffer buf_clients-attr for ub.clients-attr .
     1516       define variable rvs-time-diff as integer no-undo .
     1517       define variable exec-time-diff as integer no-undo .
     1518       run write-to-log in p-parent-handle (" START FACT-BOOK-START UTC " + utc-time() ) .
     1519       for each tt-place,
     1520       first buf_goods no-lock where buf_goods.gds-code = tt-place.gds-code,
     1521       first gds-prt no-lock where gds-prt.upper-code = buf_goods.prt-root,
     1522       first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code
     1523                                    and buf_bar-code.node-code = gds-prt.node-code
     1524                                    and buf_bar-code.in-code = ""
     1525                                    and buf_bar-code.part-code = ""
     1526                                    and buf_bar-code.unit-cli = buf_goods.unit-base
     1527       :
     1528         for last start_rvs-doc no-lock where start_rvs-doc.obj-type = obj-type
     1529                                          and start_rvs-doc.obj-code = obj-code
     1530                                          and start_rvs-doc.rvs-type = 'смена':U
     1531                                          and start_rvs-doc.status_  = 'факт':U
     1532                                          and ((start_rvs-doc.fact-date < date-start)
     1533                                            or (start_rvs-doc.fact-date = date-start and start_rvs-doc.fact-time <= time-start))
     1534                                          by start_rvs-doc.fact-order
     1535                                          :
     1536           for first start_rvs-line no-lock where start_rvs-line.obj-type  = start_rvs-doc.obj-type
     1537                                              and start_rvs-line.obj-code  = start_rvs-doc.obj-code
     1538                                              and start_rvs-line.rvs-code  = start_rvs-doc.rvs-code
     1539                                              and start_rvs-line.pl-code   = tt-place.pl-code
     1540                                              and start_rvs-line.gds-code  = tt-place.gds-code
     1541                                              :
     1542             tt-place.start-rvs-doc-qnty = start_rvs-line.system-cli-qnty .
     1543           end .
     1544           chk-doc_ :
     1545           for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-type
     1546                                          and buf_chk-doc.obj-code = obj-code
     1547                                          and buf_chk-doc.chk-date >= start_rvs-doc.fact-date
     1548                                          and buf_chk-doc.chk-date <= date-start
     1549                                          :
     1550             if lookup('смн-ош':U, buf_chk-doc.office) > 0
     1551             or (buf_chk-doc.src-shift-date > buf_chk-doc.shift-date and buf_chk-doc.chk-date > buf_chk-doc.shift-date)
     1552             or buf_chk-doc.out-code = ?
     1553             then do :
     1554               if buf_chk-doc.chk-date = start_rvs-doc.fact-date
     1555               and buf_chk-doc.chk-time <= start_rvs-doc.fact-time
     1556               then next chk-doc_ .
     1557             end .
     1558             else do :
     1559               if buf_chk-doc.shift-date < start_rvs-doc.shift-date
     1560               then next chk-doc_ .
     1561               if buf_chk-doc.shift-date = start_rvs-doc.shift-date
     1562               and buf_chk-doc.shift-num <= start_rvs-doc.shift-num
     1563               then next chk-doc_ .
     1564             end .
     1565             if buf_chk-doc.chk-date = date-start
     1566             and buf_chk-doc.chk-time >= time-start
     1567             then next chk-doc_ .
     1568             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
     1569             chk-gds_ :
     1570             for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1571                                            and buf_chk-gds.b-code   = buf_bar-code.b-code
     1572                                            :
     1573               if buf_chk-doc.out-code = ?
     1574               then do :
     1575                 v-pl-code = findtank (buf_chk-doc.obj-type,
     1576                                       buf_chk-doc.obj-code,
     1577                                       buf_chk-gds.pump,
     1578                                       buf_chk-gds.nozzle-code,
     1579                                       buf_chk-gds.pl-code,
     1580                                       buf_bar-code.gds-code) .
     1581                 if v-pl-code = ?
     1582                 or v-pl-code = 0
     1583                 then do :
     1584                   v-pl-code = findblockedtank (buf_chk-doc.obj-type,
     1585                                                buf_chk-doc.obj-code,
     1586                                                buf_chk-gds.pump,
     1587                                                buf_chk-gds.nozzle-code,
     1588                                                buf_chk-gds.pl-code,
     1589                                                buf_bar-code.gds-code) .
     1590                 end .
     1591               end .
     1592               else do :
     1593                 v-pl-code = buf_chk-gds.pl-code .
     1594               end .
     1595               if v-pl-code <> tt-place.pl-code then next chk-gds_ .
     1596               if not valid-density (buf_chk-gds.density, (buf_goods.unit-base = buf_goods.unit-cli))
     1597               then do :
     1598                 v-density = 0 .
     1599                 if lookup('смн-ош':U, buf_chk-doc.office) > 0
     1600                 then do :
     1601   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     1602     (  input  tt-place.gds-code
     1603     ,  input  buf_chk-doc.obj-type
     1604     ,  input  buf_chk-doc.obj-code
     1605     ,  input  tt-place.pl-code
     1606     ,  input  start_rvs-doc.shift-date
     1607     ,  input  start_rvs-doc.shift-num
     1608     ,  input  buf_chk-doc.chk-date
     1609     ,  input  buf_chk-doc.chk-time
     1610     , output  v-density
     1611     , output v-Reconc-tank-attr
     1612     ) no-error .
     1613                 end .
     1614                 else do :
     1615   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     1616     (  input  tt-place.gds-code
     1617     ,  input  buf_chk-doc.obj-type
     1618     ,  input  buf_chk-doc.obj-code
     1619     ,  input  tt-place.pl-code
     1620     ,  input  buf_chk-doc.shift-date
     1621     ,  input  buf_chk-doc.shift-num
     1622     ,  input  buf_chk-doc.chk-date
     1623     ,  input  buf_chk-doc.chk-time
     1624     , output  v-density
     1625     , output v-Reconc-tank-attr
     1626     ) no-error .
     1627                 end .
     1628                 tt-place.start-chk-doc-qnty = tt-place.start-chk-doc-qnty + (buf_chk-gds.doc-qnty * v-density) .
     1629                 if session:debug-alert
     1630                 then do:
     1631                   put stream OutStr-html unformatted
     1632                     "tt-place.start-chk-doc-qnty Определение книжного остатка на начало периода" skip
     1633                     "чек: " + buf_chk-gds.doc-code + " не валидная плотность в чеке"   skip
     1634                     string(buf_chk-gds.doc-qnty) + " * " +  string (v-density)  skip
     1635                     string(tt-place.start-chk-doc-qnty) skip
     1636                   .
     1637                 end.
     1638               end .
     1639               else do :
     1640                 tt-place.start-chk-doc-qnty = tt-place.start-chk-doc-qnty + (buf_chk-gds.doc-qnty * buf_chk-gds.density) .
     1641                 if session:debug-alert
     1642                 then do:
     1643                   put stream OutStr-html unformatted
     1644                     "tt-place.start-chk-doc-qnty Определение книжного остатка на начало периода" skip
     1645                     "чек: " + buf_chk-gds.doc-code + "    валидная плотность в чеке"  skip
     1646                     string(buf_chk-gds.doc-qnty) + " * " +  string (buf_chk-gds.density)  skip
     1647                     string(tt-place.start-chk-doc-qnty) skip
     1648                   .
     1649                 end.
     1650               end .
     1651             end .
     1652           end .
     1653           income-doc-line_ :
     1654           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1655                                           and buf_doc-line.obj-code  = obj-code
     1656                                           and buf_doc-line.artic     = buf_goods.artic
     1657                                           and buf_doc-line.prod-type = buf_goods.prod-type
     1658                                           and buf_doc-line.prod-code = buf_goods.prod-code
     1659                                           and buf_doc-line.status_   = 'факт':U
     1660                                           ,
     1661           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1662                                       and (buf_trn-doc.ext-doc-type = 'ie':U or buf_trn-doc.ext-doc-type = 'iv':U or buf_trn-doc.ext-doc-type = 'vt':U)
     1663                                       and ((buf_trn-doc.fact-date < date-start) or
     1664                                            (buf_trn-doc.fact-date = date-start and buf_trn-doc.fact-time <= time-start))
     1665                                       and ((buf_trn-doc.shift-date > start_rvs-doc.shift-date) or
     1666                                            (buf_trn-doc.shift-date = start_rvs-doc.shift-date and buf_trn-doc.shift-num > start_rvs-doc.shift-num))
     1667           :
     1668             if buf_trn-doc.ext-doc-type <> 'vt':U
     1669             then
     1670             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1671                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1672                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1673                                                  :
     1674               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     1675             end .
     1676             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1677                                           and buf_doc-pl.obj-code = obj-code
     1678                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1679                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1680                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1681                                           :
     1682               tt-place.start-trn-doc-qnty = tt-place.start-trn-doc-qnty + buf_doc-pl.cli-fact-qnty .
     1683             end .
     1684           end .
     1685           expense-doc-line_ :
     1686           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     1687                                           and buf_doc-line.obj-code  = obj-code
     1688                                           and buf_doc-line.artic     = buf_goods.artic
     1689                                           and buf_doc-line.prod-type = buf_goods.prod-type
     1690                                           and buf_doc-line.prod-code = buf_goods.prod-code
     1691                                           and buf_doc-line.status_   = 'факт':U
     1692                                           ,
     1693           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1694                                       and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
     1695                                       and ((buf_trn-doc.fact-date < date-start) or
     1696                                            (buf_trn-doc.fact-date = date-start and buf_trn-doc.fact-time <= time-start))
     1697                                       and ((buf_trn-doc.shift-date > start_rvs-doc.shift-date) or
     1698                                            (buf_trn-doc.shift-date = start_rvs-doc.shift-date and buf_trn-doc.shift-num > start_rvs-doc.shift-num))
     1699           :
     1700             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1701                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     1702                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     1703                                                  :
     1704               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
     1705             end .
     1706             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     1707                                           and buf_doc-pl.obj-code = obj-code
     1708                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     1709                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     1710                                           and buf_doc-pl.gds-code = tt-place.gds-code
     1711                                           :
     1712               tt-place.start-trn-doc-qnty = tt-place.start-trn-doc-qnty - buf_doc-pl.cli-fact-qnty .
     1713             end .
     1714           end .
     1715         end .
     1716         for first tt-result where tt-result.gds-code = tt-place.gds-code :
     1717           tt-result.wght-doc-start = tt-result.wght-doc-start + (tt-place.start-rvs-doc-qnty - tt-place.start-chk-doc-qnty + tt-place.start-trn-doc-qnty) .
     1718           if session:debug-alert
     1719           then do:
     1720             put stream OutStr-html unformatted
     1721               "wght-doc-start Определение книжного остатка на начало периода" skip
     1722               "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     1723               string(tt-place.start-rvs-doc-qnty) + " - " +  string (tt-place.start-chk-doc-qnty) +  " + " + string(tt-place.end-trn-doc-qnty) skip
     1724               string(tt-result.wght-doc-start) skip
     1725             .
     1726           end.
     1727         end .
     1728         start_rvs-doc_ :
     1729         for each start_rvs-doc no-lock where start_rvs-doc.obj-type = obj-type
     1730                                          and start_rvs-doc.obj-code = obj-code
     1731                                          and start_rvs-doc.rvs-type = 'контроль':U
     1732                                          and start_rvs-doc.status_  = 'факт':U
     1733                                          and ((start_rvs-doc.fact-date < date-start)
     1734                                            or (start_rvs-doc.fact-date = date-start and start_rvs-doc.fact-time <= time-start))
     1735                                          ,
     1736         first start_rvs-line no-lock where start_rvs-line.obj-type  = start_rvs-doc.obj-type
     1737                                        and start_rvs-line.obj-code  = start_rvs-doc.obj-code
     1738                                        and start_rvs-line.rvs-code  = start_rvs-doc.rvs-code
     1739                                        and start_rvs-line.pl-code   = tt-place.pl-code
     1740                                        and start_rvs-line.gds-code  = tt-place.gds-code
     1741                                        by start_rvs-doc.fact-order desc
     1742         :
     1743           if start_rvs-doc.fact-date < date-start - 2
     1744           then do :
     1745             leave start_rvs-doc_ .
     1746           end .
     1747           tt-place.rvs-doc-code = start_rvs-doc.rvs-code .
     1748           rvs-time-diff = time-start - start_rvs-doc.fact-time .
     1749           if rvs-time-diff < 0
     1750           then do :
     1751             rvs-time-diff = 86400 - start_rvs-doc.fact-time + time-start .
     1752           end .
     1753           if rvs-time-diff > (rvs-doc-exist-diff * 60)
     1754           then do :
     1755             tt-place.start-rvs-fact-qnty = start_rvs-line.state-measure-cli-qnty + (start_rvs-line.state-add-qnty * start_rvs-line.state-density) .
     1756             tt-place.is-calc = true .
     1757             chk-doc_ :
     1758             for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-type
     1759                                            and buf_chk-doc.obj-code = obj-code
     1760                                            and buf_chk-doc.chk-date >= start_rvs-doc.fact-date
     1761                                            and buf_chk-doc.chk-date <= date-start
     1762                                            :
     1763               if buf_chk-doc.chk-date = start_rvs-doc.fact-date
     1764               and buf_chk-doc.chk-time <= start_rvs-doc.fact-time
     1765               then next chk-doc_ .
     1766               if buf_chk-doc.shift-date < start_rvs-doc.shift-date
     1767               then next chk-doc_ .
     1768               if buf_chk-doc.shift-date = start_rvs-doc.shift-date
     1769               and buf_chk-doc.shift-num < start_rvs-doc.shift-num
     1770               then next chk-doc_ .
     1771               if buf_chk-doc.chk-date = date-start
     1772               and buf_chk-doc.chk-time >= time-start
     1773               then next chk-doc_ .
     1774               if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
     1775               chk-gds_ :
     1776               for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1777                                              and buf_chk-gds.b-code   = buf_bar-code.b-code
     1778                                              :
     1779                 if buf_chk-doc.out-code = ?
     1780                 then do :
     1781                   v-pl-code = findtank (buf_chk-doc.obj-type,
     1782                                         buf_chk-doc.obj-code,
     1783                                         buf_chk-gds.pump,
     1784                                         buf_chk-gds.nozzle-code,
     1785                                         buf_chk-gds.pl-code,
     1786                                         buf_bar-code.gds-code) .
     1787                   if v-pl-code = ?
     1788                   or v-pl-code = 0
     1789                   then do :
     1790                     v-pl-code = findblockedtank (buf_chk-doc.obj-type,
     1791                                                  buf_chk-doc.obj-code,
     1792                                                  buf_chk-gds.pump,
     1793                                                  buf_chk-gds.nozzle-code,
     1794                                                  buf_chk-gds.pl-code,
     1795                                                  buf_bar-code.gds-code) .
     1796                   end .
     1797                 end .
     1798                 else do :
     1799                   v-pl-code = buf_chk-gds.pl-code .
     1800                 end .
     1801                 if v-pl-code <> tt-place.pl-code then next chk-gds_ .
     1802                 if not valid-density (buf_chk-gds.density, (buf_goods.unit-base = buf_goods.unit-cli))
