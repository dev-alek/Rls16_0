        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.bge.is_PM.is_PM:
        4   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        5     define temp-table tt-result no-undo
        6       field gds-code            as integer
        7       field gds-name            as character
        8       field wght-fact-start     as decimal
        9       field wght-fact-end       as decimal
       10       field wght-doc-start      as decimal
       11       field wght-doc-end        as decimal
       12       field delivery            as decimal
       13       field delivery-own-pnpo   as decimal
       14       field delivery-other-pnpo as decimal
       15       field delivery-other      as decimal
       16       field direct-delivery     as decimal
       17       field fuel-in-transit     as decimal
       18       field wght-sale           as decimal
       19       field wght-wholesale      as decimal
       20       field loss-own-needs      as decimal
       21       field Delivery-ned-izl    as decimal
       22       field wght-other          as decimal
       23       field othermoves          as decimal
       24       field change-place        as logical
       25     index pi as primary gds-code
       26     .
       27     define temp-table tt-gds no-undo
       28       field gds-code    as integer
       29     index pi as primary gds-code
       30     .
       31     define temp-table tt-place no-undo
       32       field pl-code             as integer
       33       field pl-name             as character
       34       field gds-code            as integer
       35       field is-meas             as logical
       36       field is-calc             as logical
       37       field rvd-level           as logical
       38       field is-income           as logical
       39       field income-date         as date
       40       field income-time         as integer
       41       field need-new-rvs        as logical
       42       field use-old-rvs         as logical
       43       field rvs-doc-code        as character
       44       field rvs-doc-num         as integer
       45       field end-rvs-fact-qnty   as decimal
       46       field end-chk-fact-qnty   as decimal
       47       field end-trn-fact-qnty   as decimal
       48       field start-rvs-fact-qnty as decimal
       49       field start-chk-fact-qnty as decimal
       50       field start-trn-fact-qnty as decimal
       51       field end-rvs-doc-qnty    as decimal
       52       field end-chk-doc-qnty    as decimal
       53       field end-trn-doc-qnty    as decimal
       54       field start-rvs-doc-qnty  as decimal
       55       field start-chk-doc-qnty  as decimal
       56       field start-trn-doc-qnty  as decimal
       57     index pi as primary pl-code gds-code
       58     .
       59     define property timezone-diff as integer no-undo init ?
       60       get.
       61       private set.
       62     define property rvs-doc-exist-diff as integer no-undo init ?
       63       get.
       64       private set.
       65     define property rvs-doc-create-diff as integer no-undo init ?
       66       get.
       67       private set.
       68     define property db-num  as integer no-undo init ?
       69       get.
       70       private set.
       71     define property obj-code as integer no-undo init ?
       72       get.
       73       private set.
       74     define property obj-type as character no-undo init ""
       75       get.
       76       private set.
       77     define property last-exp-date  as date no-undo init ?
       78       get.
       79       private set.
       80     define property date-start  as date no-undo init ?
       81       get.
       82       private set.
       83     define property time-start  as integer no-undo init ?
       84       get.
       85       private set.
       86     define property date-end  as date no-undo init ?
       87       get.
       88       private set.
       89     define property time-end  as integer no-undo init ?
       90       get.
       91       private set.
       92     define property is-full as logical no-undo init false
       93       get.
       94       private set.
       95     define property is-full-backdate as logical no-undo init false
       96       get.
       97       private set.
       98     define property checks-recieved as logical no-undo init false
       99       get.
      100       private set.
      101     define property parparentproc as widget-handle no-undo
      102       get.
      103       private set.
      104     define property p-parent-handle as widget-handle no-undo
      105       get.
      106       private set.
      107     define property Data  as memptr no-undo
      108       get.
      109       private set.
      110     define property toDate  as date no-undo initial ?
      111       get.
      112       private set.
      113     define property otherOneDate as logical no-undo initial false
      114       get.
      115       private set.
      116     define property rep-file-name as character no-undo
      117       get.
      118       private set.
      119     define property oneMoreTime as logical no-undo initial false
      120       get.
      121       set.
      122     define buffer buf_clients for ub.clients .
      123     define buffer buf_clients-attr for ub.clients-attr .
      124     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
      125     define variable v-density       as decimal   no-undo .
      126     define variable v-pl-code       as integer   no-undo .
      127     define variable vMoscowDate     as date      no-undo .
      128     define variable vMoscowTime     as integer   no-undo .
      129     define variable vMoscowTimeEnd  as integer   no-undo .
      130     define variable cTime           as character no-undo .
      131     define variable vHour           as integer   no-undo .
      132     define variable cMoscowTime     as character no-undo .
      133     define variable vMoscowHour     as integer   no-undo .
      134     define variable vIsOtherMoves   as character no-undo .
      135     define variable vType           as character no-undo .
      136     define variable v-Reconc-tank-attr as character no-undo .
      137     define stream OutStr-html .
      138     constructor public is_PM
      139     (
      140     input pDbNum  as integer,
      141     input pObjCode as integer,
      142     input paramList as character,
      143     input pParentProc as widget-handle,
      144     input pParHandle as widget-handle
      145     ) :
      146       db-num = pDbNum .
      147       obj-code = pObjCode .
      148       obj-type = 'маг':U .
      149       parparentproc = pParentProc .
      150       p-parent-handle = pParHandle .
      151       find first buf_clients no-lock where buf_clients.obj-code = obj-code
      152                                        and buf_clients.obj-type = obj-type
      153                                        .
      154       timezone-diff = integer(entry(1,paramList)) * 60 .
      155       rvs-doc-exist-diff = integer(entry(2,paramList)) .
      156       rvs-doc-create-diff = integer(entry(3,paramList)) .
      157       toDate = ? .
      158       otherOneDate = false .
      159       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
      160       then run str/lib-trn3.p persistent no-error .
      161       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
      162       then run str/lib-trn.p persistent no-error .
      163       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
      164       then run str/trdcalib.p persistent no-error .
      165     end constructor .
      166     constructor public is_PM
      167     (
      168     input pDbNum  as integer,
      169     input pObjCode as integer,
      170     input paramList as character,
      171     input pParentProc as widget-handle,
      172     input pParHandle as widget-handle,
      173     input pToDate as date
      174     ) :
      175       db-num = pDbNum .
      176       obj-code = pObjCode .
      177       obj-type = 'маг':U .
      178       parparentproc = pParentProc .
      179       p-parent-handle = pParHandle .
      180       find first buf_clients no-lock where buf_clients.obj-code = obj-code
      181                                        and buf_clients.obj-type = obj-type
      182                                        .
      183       timezone-diff = integer(entry(1,paramList)) * 60 .
      184       rvs-doc-exist-diff = integer(entry(2,paramList)) .
      185       rvs-doc-create-diff = integer(entry(3,paramList)) .
      186       toDate = pToDate .
      187       otherOneDate = true .
      188       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn3)
      189       then run str/lib-trn3.p persistent no-error .
      190       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#lib-trn)
      191       then run str/lib-trn.p persistent no-error .
      192       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
      193       then run str/trdcalib.p persistent no-error .
      194     end constructor .
      195     method public void exec_1c () :
      196       if session:debug-alert then output stream OutStr-html to PM_wght_lc.txt append convert target 'UTF-8'.
      197       stage1() .
      198       stage2() .
      199       stage3() .
      200       stage4() .
      201       stage5() .
      202       create-esys-data() .
      203       if session:debug-alert then output stream OutStr-html close .
      204     end method .
      205     method public void exec_rep () :
      206       if session:debug-alert then output stream OutStr-html to PM_wght_rep.txt append convert target 'UTF-8'.
      207       stage1() .
      208       stage2() .
      209       stage3() .
      210       stage4() .
      211       stage5() .
      212       if session:debug-alert then output stream OutStr-html close .
      213       make-rep() .
      214     end method .
      215     method private void stage1 () :
      216       define buffer buf_place  for ub.place .
      217       define buffer buf_place-attr  for ub.place-attr .
      218       define buffer buf_c-pl-gds for ub.c-pl-gds .
      219       define buffer buf2_c-pl-gds for ub.c-pl-gds .
      220       define buffer buf_goods for ub.goods .
      221       define buffer buf_goods-attr for ub.goods-attr .
      222       empty temp-table tt-gds .
      223       empty temp-table tt-place .
      224       empty temp-table tt-result .
      225       run write-to-log in p-parent-handle (" START PRESTAGE UTC " + utc-time() ) .
      226       is-full = false .
      227       is-full-backdate = false .
      228       if not otherOneDate
      229       or (otherOneDate and toDate = today)
      230       then do :
      231         cTime = string(time, "HH:MM:SS") .
      232         vHour = integer(substring(cTime, 1, 2)) .
      233         vMoscowTime = time - (timezone-diff * 60) .
      234         if vMoscowTime < 0
      235         then do :
      236           vMoscowTime = vMoscowTime + 86400 .
      237         end .
      238         cMoscowTime = string(vMoscowTime, "HH:MM:SS") .
      239         vMoscowHour = integer(substring(cMoscowTime, 1, 2)) .
      240         if vMoscowHour = 0
      241         then do :
      242           is-full = true .
      243           vMoscowTimeEnd = 86399 .
      244         end .
      245         else do :
      246           vMoscowTimeEnd = (vMoscowHour - 1) * 3600 + (59 * 60) + 59 .
      247         end .
      248         vMoscowDate = date(now - (timezone-diff * 60 * 1000)) .
      249         last-exp-date = today - 1 .
      250         for first buf_clients-attr no-lock where buf_clients-attr.obj-type = buf_clients.obj-type
      251                                              and buf_clients-attr.obj-code = buf_clients.obj-code
      252                                              and buf_clients-attr.attr-code = 'exp-isPM-last-date':U
      253                                              :
      254           last-exp-date = date(buf_clients-attr.attr-value) .
      255         end .
      256         if last-exp-date = (vMoscowDate - 1)
      257         then do :
      258           date-start = vMoscowDate - if is-full then 1 else 0.
      259           time-start = timezone-diff * 60 .
      260           if time-start < 0
      261           then do :
      262             date-start = vMoscowDate - 1 .
      263             time-start = time-start + 86400 .
      264           end .
      265           date-end   = today .
      266           time-end   = (vHour - 1) * 3600 + (59 * 60) + 60 .
      267           if time-end <= 0
      268           then do :
      269             date-end   = today - 1 .
      270             time-end   = time-end + 86400 .
      271           end .
      272         end .
      273         else do :
      274           run write-to-log in p-parent-handle (("Последняя выгруженная дата по московскому времени - " + string(last-exp-date, "99/99/9999"))) .
      275           is-full-backdate = true .
      276           if vMoscowHour > 0 then oneMoreTime = true .
      277           vMoscowDate = vMoscowDate - 1 .
      278           vMoscowTimeEnd = 86399 .
      279           date-start = vMoscowDate .
      280           time-start = timezone-diff * 60 .
      281           if time-start < 0
      282           then do :
      283             date-start = vMoscowDate - 2 .
      284             time-start = time-start + 86400 .
      285           end .
      286           date-end   = vMoscowDate + 1 .
      287           time-end   = timezone-diff * 60 .
      288           if time-end <= 0
      289           then do :
      290             date-end   = vMoscowDate .
      291             time-end   = time-end + 86400 .
      292           end .
      293         end .
      294       end .
      295       else do :
      296         is-full = true .
      297         vMoscowDate = toDate .
      298         vMoscowTimeEnd = 86399 .
      299         date-start = toDate .
      300         time-start = timezone-diff * 60 .
      301         if time-start < 0
      302         then do :
      303           date-start = toDate - 1 .
      304           time-start = time-start + 86400 .
      305         end .
      306         date-end   = toDate + 1 .
      307         time-end   = timezone-diff * 60 .
      308         if time-end <= 0
      309         then do :
      310           date-end   = toDate .
      311           time-end   = time-end + 86400 .
      312         end .
      313       end .
      314       place_ :
      315       for each buf_place  no-lock
      316         where buf_place.obj-type = obj-type
      317           and buf_place.obj-code = obj-code
      318       on error undo, return error return-value
      319       :
      320         for first buf_place-attr no-lock where buf_place-attr.obj-type = buf_place.obj-type
      321                                            and buf_place-attr.obj-code = buf_place.obj-code
      322                                            and buf_place-attr.pl-code  = buf_place.pl-code
      323                                            and buf_place-attr.attr-code = "place-virtual"
      324                                            :
      325           if lookup(buf_place-attr.attr-value, 'true,yes':u) > 0 then next place_ .
      326         end .
      327         c-pl-gds_ :
      328         for each buf_c-pl-gds no-lock
      329             where buf_c-pl-gds.obj-type = buf_place.obj-type
      330               and buf_c-pl-gds.obj-code = buf_place.obj-code
      331               and buf_c-pl-gds.pl-code  = buf_place.pl-code
      332               and (buf_c-pl-gds.corr-date < date-end
      333                or (buf_c-pl-gds.corr-date = date-end and buf_c-pl-gds.corr-time <= time-end) )
      334                by buf_c-pl-gds.chip-num desc
      335         on error undo, return error return-value
      336         :
      337           for first buf2_c-pl-gds no-lock where buf2_c-pl-gds.obj-type = buf_c-pl-gds.obj-type
      338                                             and buf2_c-pl-gds.obj-code = buf_c-pl-gds.obj-code
      339                                             and buf2_c-pl-gds.pl-code  = buf_c-pl-gds.pl-code
      340                                             and buf2_c-pl-gds.gds-code <> buf_c-pl-gds.gds-code
      341                                             and buf2_c-pl-gds.corr-date = buf_c-pl-gds.corr-date
      342                                             and buf2_c-pl-gds.corr-date >= date-start
      343                                             :
      344             for first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf2_c-pl-gds.gds-code
      345                                                and buf_goods-attr.attr-code = 'ptrl-without-rvs':U
      346                                                :
      347               if lookup(buf_goods-attr.attr-value, 'true,yes':u) > 0 then next c-pl-gds_ .
      348             end .
      349             find first tt-gds where tt-gds.gds-code = buf2_c-pl-gds.gds-code no-error .
      350             if not available tt-gds
      351             then do :
      352               create tt-gds .
      353               assign
      354                 tt-gds.gds-code = buf2_c-pl-gds.gds-code
      355               .
      356             end .
      357             find first tt-result where tt-result.gds-code = buf2_c-pl-gds.gds-code no-error .
      358             if not available tt-result
      359             then do :
      360               create tt-result .
      361               assign
      362                 tt-result.gds-code = buf2_c-pl-gds.gds-code
      363                 tt-result.change-place = yes
      364               .
      365             end .
      366             find first tt-place where tt-place.pl-code  = buf_place.pl-code
      367                                   and tt-place.gds-code = buf2_c-pl-gds.gds-code
      368                                   no-error .
      369             if not available tt-place
      370             then do :
      371               create tt-place .
      372               assign
      373                 tt-place.pl-code  = buf_place.pl-code
      374                 tt-place.pl-name  = buf_place.pl-name
      375                 tt-place.gds-code = buf2_c-pl-gds.gds-code
      376                 tt-place.is-meas  = buf_place.is-meas
      377                 tt-place.is-calc  = no
      378               .
      379               for first buf_place-attr no-lock where buf_place-attr.obj-type = buf_place.obj-type
      380                                                  and buf_place-attr.obj-code = buf_place.obj-code
      381                                                  and buf_place-attr.pl-code  = buf_place.pl-code
      382                                                  and buf_place-attr.attr-code = "place-rvd-lvl"
      383                                                  :
      384                 if lookup(buf_place-attr.attr-value, 'true,yes':u) > 0 then tt-place.rvd-level = yes .
      385               end .
      386             end .
      387           end .
      388           for first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_c-pl-gds.gds-code
      389                                              and buf_goods-attr.attr-code = 'ptrl-without-rvs':U
      390                                              :
      391             if lookup(buf_goods-attr.attr-value, 'true,yes':u) > 0 then next c-pl-gds_ .
      392           end .
      393           find first tt-gds where tt-gds.gds-code = buf_c-pl-gds.gds-code no-error .
      394           if not available tt-gds
      395           then do :
      396             create tt-gds .
      397             assign
      398               tt-gds.gds-code = buf_c-pl-gds.gds-code
      399             .
      400           end .
      401           find first tt-result where tt-result.gds-code = buf_c-pl-gds.gds-code no-error .
      402           if not available tt-result
      403           then do :
      404             create tt-result .
      405             assign
      406               tt-result.gds-code = buf_c-pl-gds.gds-code
      407               tt-result.change-place = no
      408             .
      409           end .
      410           find first tt-place where tt-place.pl-code  = buf_place.pl-code
      411                                 and tt-place.gds-code = buf_c-pl-gds.gds-code
      412                                 no-error .
      413           if not available tt-place
      414           then do :
      415             create tt-place .
      416             assign
      417               tt-place.pl-code  = buf_place.pl-code
      418               tt-place.pl-name  = buf_place.pl-name
      419               tt-place.gds-code = buf_c-pl-gds.gds-code
      420               tt-place.is-meas  = buf_place.is-meas
      421               tt-place.is-calc  = no
      422             .
      423             for first buf_place-attr no-lock where buf_place-attr.obj-type = buf_place.obj-type
      424                                                and buf_place-attr.obj-code = buf_place.obj-code
      425                                                and buf_place-attr.pl-code  = buf_place.pl-code
      426                                                and buf_place-attr.attr-code = "place-rvd-lvl"
      427                                                :
      428               if lookup(buf_place-attr.attr-value, 'true,yes':u) > 0 then tt-place.rvd-level = yes .
      429             end .
      430           end .
      431           leave c-pl-gds_ .
      432         end .
      433       end .
      434       for each tt-gds,
      435       first buf_goods no-lock where buf_goods.gds-code = tt-gds.gds-code
      436       :
      437         run write-to-log in p-parent-handle (buf_goods.artic + ": " + buf_goods.gds-name) .
      438       end .
      439       run write-to-log in p-parent-handle (if is-full-backdate then "Суточная за прошедшие сутки" else  (if is-full then "Суточная" else "Промежуточная")) .
      440       run write-to-log in p-parent-handle (string(date-start) + " " + string(time-start, "HH:MM:SS") + " - " + string(date-end) + " " + (if time-end = 86400 then "23:59:59" else string(time-end, "HH:MM:SS"))) .
      441       run write-to-log in p-parent-handle (string(vMoscowDate) + " " + string(0, "HH:MM:SS") + " - " + string(vMoscowDate) + " " + string(vMoscowTimeEnd, "HH:MM:SS")) .
      442       run write-to-log in p-parent-handle (" END PRESTAGE UTC " + utc-time() ) .
      443     end method .
      444     method private void stage2 () :
      445       define buffer buf_trn-doc for ub.trn-doc .
      446       define buffer buf_c-trn-doc for ub.c-trn-doc .
      447       define buffer buf_doc-line for ub.doc-line .
      448       define buffer buf_doc-pl for ub.doc-pl .
      449       define buffer end_rvs-doc for ub.rvs-doc .
      450       define buffer end_rvs-line for ub.rvs-line .
      451       define buffer new_rvs-doc for ub.rvs-doc .
      452       define buffer new_rvs-line for ub.rvs-line .
      453       define buffer buf_chk-doc for ub.chk-doc .
      454       define buffer buf_chk-gds for ub.chk-gds .
      455       define buffer buf_bar-code for ub.bar-code .
      456       define buffer buf_goods for ub.goods .
      457       define buffer buf_clients-attr for ub.clients-attr .
      458       define buffer before_rvs-doc for ub.rvs-doc .
      459       define buffer buf_shift-obj for ub.shift-obj .
      460       define variable v-found-income as logical no-undo .
      461       define variable v-income-doc-code as character no-undo .
      462       run write-to-log in p-parent-handle (" START FACT-END UTC " + utc-time() ) .
      463       run write-to-log in p-parent-handle ( "Поиск открытых на конец периода приемок" ) .
      464       v-found-income = false .
      465       v-income-doc-code = "" .
      466       trn_ :
      467       for each buf_trn-doc no-lock where buf_trn-doc.obj-type = obj-type
      468                                      and buf_trn-doc.obj-code = obj-code
      469                                      and buf_trn-doc.ext-doc-type = 'ie':U
      470                                      and buf_trn-doc.status_ <> 'факт':U
      471                                      and buf_trn-doc.sys-date >= date-start
      472                                      and buf_trn-doc.sys-date <= date-end
      473                                      :
      474         find first buf_c-trn-doc no-lock where buf_c-trn-doc.doc-code = buf_trn-doc.doc-code no-error .
      475         if available buf_c-trn-doc
      476         then do :
      477           if buf_c-trn-doc.real-date-create = date-start
      478           and buf_c-trn-doc.real-time-create < time-start
      479           then next trn_ .
      480           if buf_c-trn-doc.real-date-create = date-end
      481           and buf_c-trn-doc.real-time-create > time-end
      482           then next trn_ .
      483           place_ :
      484           for each tt-place,
      485           first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
      486                                      and buf_doc-pl.obj-code = buf_trn-doc.obj-code
      487                                      and buf_doc-pl.pl-code  = tt-place.pl-code
      488                                      and buf_doc-pl.out-code = buf_trn-doc.doc-code
      489                                      and buf_doc-pl.gds-code = tt-place.gds-code
      490                                      :
      491             assign
      492               tt-place.is-income = true
      493               tt-place.income-date = buf_c-trn-doc.real-date-create
      494               tt-place.income-time = buf_c-trn-doc.real-time-create
      495               v-found-income = true .
      496             .
      497             if v-income-doc-code <> buf_trn-doc.doc-code
      498             then do :
      499               v-income-doc-code = buf_trn-doc.doc-code .
      500               run write-to-log in p-parent-handle ( "Найдена приемка по ПН №" + v-income-doc-code ) .
      501             end .
      502             tt-place.rvs-doc-num = 2000000000 .
      503             for first before_rvs-doc no-lock where before_rvs-doc.out-code = buf_trn-doc.doc-code
      504                                                and before_rvs-doc.rvs-type = 'перед_док':U
      505                                                :
      506               tt-place.rvs-doc-num = integer(entry(1, before_rvs-doc.rvs-code, "-")) no-error .
      507               if before_rvs-doc.fact-date <> ?
      508               then do :
      509                 assign
      510                   tt-place.income-date = before_rvs-doc.fact-date
      511                   tt-place.income-time = before_rvs-doc.fact-time
      512                 .
      513               end .
      514             end .
      515           end .
      516         end .
      517         else do :
      518           if buf_trn-doc.sys-date = date-start
      519           and buf_trn-doc.sys-time-int < time-start
      520           then next trn_ .
      521           if buf_trn-doc.sys-date = date-end
      522           and buf_trn-doc.sys-time-int > time-end
      523           then next trn_ .
      524           place_ :
      525           for each tt-place,
      526           first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_trn-doc.obj-type
      527                                      and buf_doc-pl.obj-code = buf_trn-doc.obj-code
      528                                      and buf_doc-pl.pl-code  = tt-place.pl-code
      529                                      and buf_doc-pl.out-code = buf_trn-doc.doc-code
      530                                      and buf_doc-pl.gds-code = tt-place.gds-code
      531                                      :
      532             assign
      533               tt-place.is-income = true
      534               tt-place.income-date = buf_trn-doc.sys-date
      535               tt-place.income-time = buf_trn-doc.sys-time-int
      536               v-found-income = true .
      537             .
      538             if v-income-doc-code <> buf_trn-doc.doc-code
      539             then do :
      540               v-income-doc-code = buf_trn-doc.doc-code .
      541               run write-to-log in p-parent-handle ( "Найдена приемка по ПН №" + v-income-doc-code ) .
      542             end .
      543             tt-place.rvs-doc-num = 2000000000 .
      544             for first before_rvs-doc no-lock where before_rvs-doc.out-code = buf_trn-doc.doc-code
      545                                                and before_rvs-doc.rvs-type = 'перед_док':U
      546                                                :
      547               tt-place.rvs-doc-num = integer(entry(1, before_rvs-doc.rvs-code, "-")) no-error .
      548               if before_rvs-doc.fact-date <> ?
      549               then do :
      550                 assign
      551                   tt-place.income-date = before_rvs-doc.fact-date
      552                   tt-place.income-time = before_rvs-doc.fact-time
      553                 .
      554               end .
      555             end .
      556           end .
      557         end .
      558       end .
      559       if not v-found-income
      560       then do :
      561         run write-to-log in p-parent-handle ( "Приемки не найдены" ) .
      562       end .
      563       if not otherOneDate
      564       then
      565       for first tt-place where tt-place.need-new-rvs
      566                             or tt-place.is-income
      567                             :
      568         run write-to-log in p-parent-handle ( "Прием чеков" ) .
      569         checks-recieved = get-check() .
      570       end .
      571       define variable rvs-time-diff as integer no-undo .
      572       define variable exec-time-diff as integer no-undo .
      573       for each tt-place where not tt-place.is-income :
      574         if not otherOneDate
      575         then
      576         run write-to-log in p-parent-handle ( "Проверка необходимости создания сверки по резервуару " + string(tt-place.pl-code) + " . Товар " + string(tt-place.gds-code) ) .
      577         end_rvs-doc_ :
      578         for each end_rvs-doc no-lock where end_rvs-doc.obj-type = obj-type
      579                                        and end_rvs-doc.obj-code = obj-code
      580                                        and end_rvs-doc.rvs-type = 'контроль':U
      581                                        and end_rvs-doc.status_  = 'факт':U
      582                                        and ((end_rvs-doc.fact-date < date-end)
      583                                          or (end_rvs-doc.fact-date = date-end and end_rvs-doc.fact-time <= time-end))
      584                                        ,
      585         first end_rvs-line no-lock where end_rvs-line.obj-type  = end_rvs-doc.obj-type
      586                                      and end_rvs-line.obj-code  = end_rvs-doc.obj-code
      587                                      and end_rvs-line.rvs-code  = end_rvs-doc.rvs-code
      588                                      and end_rvs-line.pl-code   = tt-place.pl-code
      589                                      and end_rvs-line.gds-code  = tt-place.gds-code
      590                                      by end_rvs-doc.fact-order desc
      591                                      :
      592           rvs-time-diff = time-end - end_rvs-doc.fact-time + ((date-end - end_rvs-doc.fact-date) * 86400) .
      593           if rvs-time-diff < 0
      594           then do :
      595             rvs-time-diff = 86400 - end_rvs-doc.fact-time + time-end .
      596           end .
      597           exec-time-diff = time - time-end .
      598           if exec-time-diff < 0
      599           then do :
      600             exec-time-diff = 86400 - time-end + time .
      601           end .
      602           if rvs-time-diff > (rvs-doc-exist-diff * 60)
      603           and exec-time-diff < (rvs-doc-create-diff * 60)
      604           and not otherOneDate
      605           then do :
      606             if is-full
      607             and tt-place.is-meas
      608             and not tt-place.rvd-level
      609             and rvs-time-diff > exec-time-diff
      610             then do :
      611               run write-to-log in p-parent-handle ( "Требуется создание сверки" ) .
      612               tt-place.need-new-rvs = true .
      613             end .
      614             else do :
      615               run write-to-log in p-parent-handle (if is-full-backdate then "Выгрузка за прошедшие сутки, сверка не создается" else "Выгрузка промежуточная, сверка не создается" ) .
      616               tt-place.use-old-rvs = true .
      617             end .
      618           end .
      619           else do :
      620             if rvs-time-diff > (rvs-doc-exist-diff * 60)
      621             then do :
      622               tt-place.use-old-rvs = true .
      623               run write-to-log in p-parent-handle ( "Cоздание сверки не требуется" ) .
      624             end .
      625             else do :
      626               if not otherOneDate
      627               then
      628               run write-to-log in p-parent-handle ( "Есть актуальная сверка, создание сверки не требуется" ) .
      629               tt-place.end-rvs-fact-qnty = end_rvs-line.state-measure-cli-qnty + (end_rvs-line.state-add-qnty * end_rvs-line.state-density) .
      630               tt-place.rvs-doc-code = end_rvs-doc.rvs-code .
      631               tt-place.is-calc = false .
      632               for first tt-result where tt-result.gds-code = tt-place.gds-code :
      633                 tt-result.wght-fact-end = tt-result.wght-fact-end + tt-place.end-rvs-fact-qnty .
      634                 if abs(tt-result.wght-fact-end) < 0.001 then tt-result.wght-fact-end = 0 .
      635                 if session:debug-alert
      636                 then do:
      637                   put stream OutStr-html unformatted
      638                     "wght-fact-end Поиск контрольных сверок на конец периода" skip
      639                     "Резервуар " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
      640                     string(tt-place.end-rvs-fact-qnty) skip
      641                     string (tt-result.wght-fact-end) skip
      642                   .
      643                 end.
      644               end .
      645             end .
      646           end .
      647           leave end_rvs-doc_ .
      648         end .
      649       end .
      650       define variable new-rvs-doc-code as character no-undo init "" .
      651       if not otherOneDate
      652       then
      653       for first tt-place where tt-place.need-new-rvs :
      654         run write-to-log in p-parent-handle ( "Создание контрольной сверки" ) .
      655         new-rvs-doc-code = make-rvs-doc() .
      656         if new-rvs-doc-code = "error"
      657         then do :
      658           run write-to-log in p-parent-handle ( "Ошибка при создании контрольной сверки" ) .
      659         end .
      660         else do :
      661           run write-to-log in p-parent-handle ( "Создана сверка №" + new-rvs-doc-code ) .
      662         end .
      663       end .
      664       if new-rvs-doc-code = "error"
      665       then do :
      666         for each tt-place where tt-place.need-new-rvs :
      667           assign
      668             tt-place.need-new-rvs = false
      669             tt-place.use-old-rvs = true
      670           .
      671         end .
      672       end .
      673       for each tt-place where tt-place.need-new-rvs,
      674       first buf_goods no-lock where buf_goods.gds-code = tt-place.gds-code,
      675       first gds-prt no-lock where gds-prt.upper-code = buf_goods.prt-root,
      676       first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code
      677                                    and buf_bar-code.node-code = gds-prt.node-code
      678                                    and buf_bar-code.in-code = ""
      679                                    and buf_bar-code.part-code = ""
      680                                    and buf_bar-code.unit-cli = buf_goods.unit-base
      681       :
      682         for first new_rvs-doc where new_rvs-doc.rvs-code = new-rvs-doc-code :
      683           tt-place.is-calc = true .
      684           tt-place.rvs-doc-code = new_rvs-doc.rvs-code .
      685           for first new_rvs-line no-lock where new_rvs-line.obj-type  = new_rvs-doc.obj-type
      686                                            and new_rvs-line.obj-code  = new_rvs-doc.obj-code
      687                                            and new_rvs-line.rvs-code  = new_rvs-doc.rvs-code
      688                                            and new_rvs-line.pl-code   = tt-place.pl-code
      689                                            and new_rvs-line.gds-code  = tt-place.gds-code
      690                                            :
      691             tt-place.end-rvs-fact-qnty = new_rvs-line.state-measure-cli-qnty + (new_rvs-line.state-add-qnty * new_rvs-line.state-density) .
      692           end .
      693           chk-doc_ :
      694           for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-type
      695                                          and buf_chk-doc.obj-code = obj-code
      696                                          and buf_chk-doc.chk-date = new_rvs-doc.fact-date
      697                                          and buf_chk-doc.chk-time >= (if time-end = 86399 then 0 else time-end)
      698                                          and buf_chk-doc.chk-time <= new_rvs-doc.fact-time
      699                                          :
      700             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
      701             chk-gds_ :
      702             for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code
      703                                            and buf_chk-gds.b-code   = buf_bar-code.b-code
      704                                            :
      705               if buf_chk-doc.out-code = ?
      706               then do :
      707                 v-pl-code = findtank (buf_chk-doc.obj-type,
      708                                       buf_chk-doc.obj-code,
      709                                       buf_chk-gds.pump,
      710                                       buf_chk-gds.nozzle-code,
      711                                       buf_chk-gds.pl-code,
      712                                       buf_bar-code.gds-code) .
      713                 if v-pl-code = ?
      714                 or v-pl-code = 0
      715                 then do :
      716                   v-pl-code = findblockedtank (buf_chk-doc.obj-type,
      717                                                buf_chk-doc.obj-code,
      718                                                buf_chk-gds.pump,
      719                                                buf_chk-gds.nozzle-code,
      720                                                buf_chk-gds.pl-code,
      721                                                buf_bar-code.gds-code) .
      722                 end .
      723               end .
      724               else do :
      725                 v-pl-code = buf_chk-gds.pl-code .
      726               end .
      727               if v-pl-code <> tt-place.pl-code then next chk-gds_ .
      728               if not valid-density (buf_chk-gds.density, (buf_goods.unit-base = buf_goods.unit-cli))
      729               then do :
      730                 v-density = 0 .
      731                 if lookup('смн-ош':U, buf_chk-doc.office) > 0
      732                 then do :
      733   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
      734     (  input  tt-place.gds-code
      735     ,  input  buf_chk-doc.obj-type
      736     ,  input  buf_chk-doc.obj-code
      737     ,  input  tt-place.pl-code
      738     ,  input  new_rvs-doc.shift-date
      739     ,  input  new_rvs-doc.shift-num
      740     ,  input  buf_chk-doc.chk-date
      741     ,  input  buf_chk-doc.chk-time
      742     , output  v-density
      743     , output v-Reconc-tank-attr
      744     ) no-error .
