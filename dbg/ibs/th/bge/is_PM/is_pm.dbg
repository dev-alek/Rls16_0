      746                 else do :
      747   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
      748     (  input  tt-place.gds-code
      749     ,  input  buf_chk-doc.obj-type
      750     ,  input  buf_chk-doc.obj-code
      751     ,  input  tt-place.pl-code
      752     ,  input  buf_chk-doc.shift-date
      753     ,  input  buf_chk-doc.shift-num
      754     ,  input  buf_chk-doc.chk-date
      755     ,  input  buf_chk-doc.chk-time
      756     , output  v-density
      757     , output v-Reconc-tank-attr
      758     ) no-error .
      759                 end .
      760                 tt-place.end-chk-fact-qnty = tt-place.end-chk-fact-qnty + (buf_chk-gds.doc-qnty * v-density) .
      761               end .
      762               else do :
      763                 tt-place.end-chk-fact-qnty = tt-place.end-chk-fact-qnty + (buf_chk-gds.doc-qnty * buf_chk-gds.density) .
      764               end .
      765             end .
      766           end .
      767           income-doc-line_ :
      768           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
      769                                           and buf_doc-line.obj-code  = obj-code
      770                                           and buf_doc-line.artic     = buf_goods.artic
      771                                           and buf_doc-line.prod-type = buf_goods.prod-type
      772                                           and buf_doc-line.prod-code = buf_goods.prod-code
      773                                           and buf_doc-line.status_   = 'факт':U
      774                                           ,
      775           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
      776                                       and (buf_trn-doc.ext-doc-type = 'ie':U or buf_trn-doc.ext-doc-type = 'iv':U or buf_trn-doc.ext-doc-type = 'vt':U)
      777                                       and buf_trn-doc.fact-date = new_rvs-doc.fact-date
      778                                       and buf_trn-doc.fact-time >= (if time-end = 86399 then 0 else time-end)
      779                                       and buf_trn-doc.fact-time <= new_rvs-doc.fact-time
      780                                       :
      781   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
      782                           input 'othermoves':U ,
      783                          output vIsOtherMoves ,
      784                          output vType )  .
      785             if vIsOtherMoves > ""
      786             and logical(vIsOtherMoves)
      787             then next income-doc-line_ .
      788             if buf_trn-doc.ext-doc-type <> 'vt':U
      789             then
      790             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
      791                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
      792                                                  and buf_clients-attr.attr-code = 'shftrep2':U
      793                                                  :
      794               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
      795             end .
      796             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
      797                                           and buf_doc-pl.obj-code = obj-code
      798                                           and buf_doc-pl.pl-code  = tt-place.pl-code
      799                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
      800                                           and buf_doc-pl.gds-code = tt-place.gds-code
      801                                           :
      802               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty + buf_doc-pl.cli-fact-qnty .
      803             end .
      804           end .
      805           expense-doc-line_ :
      806           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
      807                                           and buf_doc-line.obj-code  = obj-code
      808                                           and buf_doc-line.artic     = buf_goods.artic
      809                                           and buf_doc-line.prod-type = buf_goods.prod-type
      810                                           and buf_doc-line.prod-code = buf_goods.prod-code
      811                                           and buf_doc-line.status_   = 'факт':U
      812                                           ,
      813           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
      814                                       and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
      815                                       and buf_trn-doc.fact-date = new_rvs-doc.fact-date
      816                                       and buf_trn-doc.fact-time >= (if time-end = 86399 then 0 else time-end)
      817                                       and buf_trn-doc.fact-time <= new_rvs-doc.fact-time
      818                                       :
      819   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
      820                           input 'othermoves':U ,
      821                          output vIsOtherMoves ,
      822                          output vType )  .
      823             if vIsOtherMoves > ""
      824             and logical(vIsOtherMoves)
      825             then next expense-doc-line_ .
      826             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
      827                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
      828                                                  and buf_clients-attr.attr-code = 'shftrep2':U
      829                                                  :
      830               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
      831             end .
      832             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
      833                                           and buf_doc-pl.obj-code = obj-code
      834                                           and buf_doc-pl.pl-code  = tt-place.pl-code
      835                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
      836                                           and buf_doc-pl.gds-code = tt-place.gds-code
      837                                           :
      838               tt-place.end-trn-fact-qnty = tt-place.end-trn-fact-qnty - buf_doc-pl.cli-fact-qnty .
      839             end .
      840           end .
      841         end .
      842         for first tt-result where tt-result.gds-code = tt-place.gds-code :
      843           tt-result.wght-fact-end = tt-result.wght-fact-end + (tt-place.end-rvs-fact-qnty + tt-place.end-chk-fact-qnty - tt-place.end-trn-fact-qnty) .
      844           if abs(tt-result.wght-fact-end) < 0.001 then tt-result.wght-fact-end = 0 .
      845           if session:debug-alert
      846           then do:
      847             put stream OutStr-html unformatted
      848               "wght-fact-end Формула 2" skip
      849               "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
      850               string(tt-place.end-rvs-fact-qnty) + " + " +  string (tt-place.end-chk-fact-qnty) +  " - " + string(tt-place.end-trn-fact-qnty) skip
      851               string(tt-result.wght-fact-end) skip
      852             .
      853           end.
      854         end .
      855       end .
      856       for each tt-place where tt-place.use-old-rvs,
      857       first buf_goods no-lock where buf_goods.gds-code = tt-place.gds-code,
      858       first gds-prt no-lock where gds-prt.upper-code = buf_goods.prt-root,
      859       first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code
      860                                    and buf_bar-code.node-code = gds-prt.node-code
      861                                    and buf_bar-code.in-code = ""
      862                                    and buf_bar-code.part-code = ""
      863                                    and buf_bar-code.unit-cli = buf_goods.unit-base
      864       :
      865         end_rvs-doc_ :
      866         for each end_rvs-doc no-lock where end_rvs-doc.obj-type = obj-type
      867                                        and end_rvs-doc.obj-code = obj-code
      868                                        and end_rvs-doc.rvs-type = 'контроль':U
      869                                        and end_rvs-doc.status_  = 'факт':U
