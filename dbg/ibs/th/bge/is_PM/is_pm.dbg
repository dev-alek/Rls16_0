     1909                                             and buf_doc-pl.obj-code = obj-code
     1910                                             and buf_doc-pl.pl-code  = tt-place.pl-code
     1911                                             and buf_doc-pl.out-code = buf_doc-line.doc-code
     1912                                             and buf_doc-pl.gds-code = tt-place.gds-code
     1913                                             :
     1914                 tt-place.start-trn-fact-qnty = tt-place.start-trn-fact-qnty - buf_doc-pl.cli-fact-qnty .
     1915               end .
     1916             end .
     1917             for first tt-result where tt-result.gds-code = tt-place.gds-code :
     1918               tt-result.wght-fact-start = tt-result.wght-fact-start + (tt-place.start-rvs-fact-qnty - tt-place.start-chk-fact-qnty + tt-place.start-trn-fact-qnty) .
     1919               if abs(tt-result.wght-fact-start) < 0.001 then tt-result.wght-fact-start = 0 .
     1920               if session:debug-alert
     1921               then do:
     1922                 put stream OutStr-html unformatted
     1923                   "wght-fact-start Формула 4 Определение фактического остатка на начало периода is-calc = true" skip
     1924                   "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     1925                   string(tt-place.start-rvs-fact-qnty) + " - " +  string (tt-place.start-chk-fact-qnty) +  " + " + string(tt-place.start-trn-fact-qnty) skip
     1926                   string(tt-result.wght-fact-start) skip
     1927                 .
     1928               end.
     1929             end .
     1930           end .
     1931           else do :
     1932             tt-place.is-calc = false .
     1933             for first tt-result where tt-result.gds-code = tt-place.gds-code :
     1934               tt-result.wght-fact-start = tt-result.wght-fact-start + start_rvs-line.state-measure-cli-qnty + (start_rvs-line.state-add-qnty * start_rvs-line.state-density) .
     1935               if abs(tt-result.wght-fact-start) < 0.001 then tt-result.wght-fact-start = 0 .
     1936               if session:debug-alert
     1937               then do:
     1938                 put stream OutStr-html unformatted
     1939                   "wght-fact-start Формула 4 Определение фактического остатка на начало периода is-calc = false" skip
     1940                   "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     1941                   string(start_rvs-line.state-measure-cli-qnty) + " + (" +  string (start_rvs-line.state-add-qnty) +  " * " + string(start_rvs-line.state-density) + ")" skip
     1942                   string(tt-result.wght-fact-start) skip
     1943                 .
     1944               end.
     1945             end .
     1946           end .
     1947           leave start_rvs-doc_ .
     1948         end .
     1949       end .
     1950       for each tt-place :
     1951         run write-to-log in p-parent-handle ("fact_place " + string(tt-place.pl-code) + ": " + tt-place.pl-name + "; " +
     1952                                               string(tt-place.is-income) + "; " +
     1953                                               tt-place.rvs-doc-code + "; " +
     1954                                               string(tt-place.is-calc) +
     1955                                               (if tt-place.is-calc
     1956                                                then
     1957                                                 ("; " +
     1958                                                  string-mth(tt-place.start-rvs-fact-qnty) + ": " +
     1959                                                  string-mth(tt-place.start-chk-fact-qnty) + ": " +
     1960                                                  string-mth(tt-place.start-trn-fact-qnty) + "; "
     1961                                                 )
     1962                                                else "; ") +
     1963                                               string-mth(tt-place.start-rvs-fact-qnty - tt-place.start-chk-fact-qnty + tt-place.start-trn-fact-qnty)
     1964                                               ) .
     1965       end .
     1966       for each tt-result,
     1967       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     1968       :
