     2102                 "wght-sale Формула 6 Расчет реализации" skip
     2103                 "Чек: " + string(buf_chk-gds.doc-code) + " " +  string(buf_chk-doc.chk-type) + " " + string(buf_chk-gds.b-code) skip
     2104                 string(buf_chk-gds.doc-qnty) + " * " +  string (v-density) skip
     2105                 string(tt-result.wght-sale) skip
     2106               .
     2107             end.
     2108           end .
     2109           else do :
     2110             tt-result.wght-sale = tt-result.wght-sale + (buf_chk-gds.doc-qnty * buf_chk-gds.density) .
     2111             if session:debug-alert
     2112             then do:
     2113               put stream OutStr-html unformatted
     2114                 "wght-sale Формула 6 Расчет реализации" skip
     2115                 "Чек: " + string(buf_chk-gds.doc-code) + " " +  string(buf_chk-doc.chk-type) + " " + string(buf_chk-gds.b-code) skip
     2116                 string(buf_chk-gds.doc-qnty) + " * " +  string (buf_chk-gds.density) skip
     2117                 string(tt-result.wght-sale) skip
     2118               .
     2119             end.
     2120           end .
     2121         end .
     2122       end .
     2123       for each tt-result,
     2124       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     2125       :
     2126         income-doc-line_ :
     2127         for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     2128                                         and buf_doc-line.obj-code  = obj-code
     2129                                         and buf_doc-line.artic     = buf_goods.artic
     2130                                         and buf_doc-line.prod-type = buf_goods.prod-type
     2131                                         and buf_doc-line.prod-code = buf_goods.prod-code
     2132                                         and buf_doc-line.status_   = 'факт':U
     2133                                         ,
     2134         first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2135                                     and buf_trn-doc.ext-doc-type = 'ie':U
     2136                                     and ((buf_trn-doc.fact-date > date-start) or
     2137                                          (buf_trn-doc.fact-date = date-start and buf_trn-doc.fact-time >= time-start))
     2138                                     and ((buf_trn-doc.fact-date < date-end) or
     2139                                          (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     2140                                     :
     2141   run trdcalib_tdat-val in ibs.th.gbl.gbl-hndllib:g#trdcalib (  input buf_trn-doc.doc-code ,
     2142                           input 'othermoves':U ,
     2143                          output vIsOtherMoves ,
     2144                          output vType )  .
     2145           if vIsOtherMoves > ""
     2146           and logical(vIsOtherMoves)
     2147           then next income-doc-line_ .
     2148           for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2149                                                and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2150                                                and buf_clients-attr.attr-code = 'shftrep2':U
     2151                                                :
     2152             if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     2153           end .
     2154           assign
     2155             v-is-npz = false
     2156             v-is-own = false
     2157             v-is-own-nb  = false
     2158           .
     2159           for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2160                                                and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2161                                                and buf_clients-attr.attr-code = 'own-supp':U
     2162                                                :
     2163             if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then v-is-own = true . else v-is-own = false .
     2164           end .
     2165           for first buf_doc-attr where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     2166                                    and buf_doc-attr.attr-code = 'ptbobj':U
     2167                                    :
     2168             assign
     2169               v-nb-obj-type = entry(1, buf_doc-attr.attr-value, ";")
     2170               v-nb-obj-code = integer(entry(2, buf_doc-attr.attr-value, ";"))
     2171             no-error .
     2172           end .
     2173           for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = v-nb-obj-type
     2174                                                and buf_clients-attr.obj-code  = v-nb-obj-code
