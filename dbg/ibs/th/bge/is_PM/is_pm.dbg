     1991       define buffer buf_clients-attr for ub.clients-attr .
     1992       define buffer buf_inv-line for ub.inv-line .
     1993       define buffer buf_shift-obj for ub.shift-obj .
     1994       define variable v-is-npz    as logical no-undo .
     1995       define variable v-is-own    as logical no-undo .
     1996       define variable v-is-own-nb as logical no-undo .
     1997       define variable v-nb-obj-type as character no-undo .
     1998       define variable v-nb-obj-code as integer no-undo .
     1999       run write-to-log in p-parent-handle (" START TURNOVER UTC " + utc-time() ) .
     2000       if not checks-recieved
     2001       and not otherOneDate
     2002       then
     2003         checks-recieved = get-check() .
     2004       chk-doc_ :
     2005       for each buf_chk-doc no-lock where buf_chk-doc.obj-type = obj-type
     2006                                      and buf_chk-doc.obj-code = obj-code
     2007                                      and buf_chk-doc.chk-date >= date-start
     2008                                      and buf_chk-doc.chk-date <= date-end
     2009                                      :
     2010         if buf_chk-doc.chk-date = date-start
     2011         and buf_chk-doc.chk-time < time-start
     2012         then next chk-doc_ .
     2013         if buf_chk-doc.chk-date = date-end
     2014         and buf_chk-doc.chk-time > time-end
     2015         then next chk-doc_ .
     2016         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next chk-doc_ .
     2017         chk-gds_ :
     2018         for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     2019         first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
     2020         first tt-result where tt-result.gds-code = buf_bar-code.gds-code
     2021         :
     2022           if not valid-density (buf_chk-gds.density, false)
     2023           then do :
     2024             if buf_chk-doc.out-code = ?
     2025             then do :
     2026               v-pl-code = findtank (buf_chk-doc.obj-type,
     2027                                     buf_chk-doc.obj-code,
     2028                                     buf_chk-gds.pump,
     2029                                     buf_chk-gds.nozzle-code,
     2030                                     buf_chk-gds.pl-code,
     2031                                     buf_bar-code.gds-code) .
     2032               if v-pl-code = ?
     2033               or v-pl-code = 0
     2034               then do :
     2035                 v-pl-code = findblockedtank (buf_chk-doc.obj-type,
     2036                                              buf_chk-doc.obj-code,
     2037                                              buf_chk-gds.pump,
     2038                                              buf_chk-gds.nozzle-code,
     2039                                              buf_chk-gds.pl-code,
     2040                                              buf_bar-code.gds-code) .
     2041               end .
     2042             end .
     2043             else do :
     2044               v-pl-code = buf_chk-gds.pl-code .
     2045             end .
     2046             v-density = 0 .
     2047             if lookup('смн-ош':U, buf_chk-doc.office) > 0
     2048             then do :
     2049               find last buf_shift-obj no-lock where buf_shift-obj.obj-type = buf_chk-doc.obj-type
     2050                                                 and buf_shift-obj.obj-code = buf_chk-doc.obj-code
     2051                                                 and ((buf_shift-obj.open-date < buf_chk-doc.chk-date)
     2052                                                   or (buf_shift-obj.open-date = buf_chk-doc.chk-date and buf_shift-obj.open-time < buf_chk-doc.chk-time))
     2053                                                 no-error .
     2054               if available buf_shift-obj
     2055               then do :
     2056   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avrgdens in ibs.th.gbl.gbl-hndllib:g#lib-trn3
     2057     (  input  tt-result.gds-code
     2058     ,  input  buf_chk-doc.obj-type
     2059     ,  input  buf_chk-doc.obj-code
