     2889     method private character fnc-convert-dot-to-colon (input p-data as decimal,
     2890                                                        input p-accur as character,
     2891                                                        input p-num as integer)
     2892     :
     2893     define variable result       as character no-undo.
     2894     define variable v-str-result as character no-undo.
     2895     if p-data = ? then p-data = 0 .
     2896     p-data = round(p-data, p-num).
     2897     v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2898     return v-str-result.
     2899     end method .
     2900     method private character string-mth (inValue as decimal):
     2901       def var v-str as character no-undo.
     2902       if inValue = ?
     2903       then do :
     2904         v-str = "0".
     2905         return v-str.
     2906       end .
     2907       if string (inValue) begins "."
     2908         then v-str = "0" + string (inValue).
     2909         else v-str = string (inValue).
     2910       return v-str.
     2911     end method .
     2912     method private character utc-time () :
     2913       define variable v-dt as datetime no-undo .
     2914       v-dt = now - (timezone * 60 * 1000) .
     2915       return string(v-dt) .
     2916     end method .
     2917     method private logical valid-density
     2918     (input p-density as decimal,
     2919      input p-unit-base-cli-eq as logical
     2920     ) :
     2921       define variable v-answ as logical no-undo .
     2922       if ( p-unit-base-cli-eq = true
     2923            and p-density = 1.0
     2924          )
     2925         or ( p-unit-base-cli-eq = false
     2926              and p-density <> ?
     2927              and p-density > 0.0
     2928              and p-density < 1.0
     2929            )
     2930       then do:
     2931         assign
     2932           v-answ = true
     2933         .
     2934       end.
     2935       else do:
     2936         assign
     2937           v-answ = false
     2938         .
     2939       end.
     2940       return v-answ.
     2941     end method .
     2942     method private integer findtank
     2943     (
     2944       input p-obj-type     as character,
     2945       input p-obj-code     as integer,
     2946       input p-pump-code    as integer,
     2947       input p-nozzle-code  as integer,
     2948       input p-from-pl-code as integer,
     2949       input p-gds-code     as integer
     2950     ) :
     2951       define variable v-pl-code            like ub.place.pl-code no-undo .
     2952       define variable p-pl-code            like ub.place.pl-code no-undo .
     2953       define variable v-dopstr             as character no-undo .
     2954       define buffer buf_place for ub.place.
     2955       define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     2956       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     2957       define buffer buf_pl-gds for ub.pl-gds.
     2958       do
     2959       on error undo, return error return-value
     2960       :
     2961         assign
     2962           v-pl-code = 0
     2963           p-pl-code = ?
     2964         .
     2965         if p-from-pl-code <> ?
     2966           and p-from-pl-code <> 0
     2967         then do:
     2968           find first buf_pl-gds no-lock
     2969             where buf_pl-gds.obj-type  = p-obj-type
     2970               and buf_pl-gds.obj-code  = p-obj-code
     2971               and buf_pl-gds.pl-code   = p-from-pl-code
     2972               and buf_pl-gds.gds-code  = p-gds-code
     2973             no-error.
     2974           if available buf_pl-gds then do:
     2975             assign
     2976               v-pl-code = buf_pl-gds.pl-code
     2977             .
     2978           end.
     2979         end.
     2980         if v-pl-code <> 0
     2981           and p-nozzle-code <> ?
     2982           and p-nozzle-code <> 0
     2983         then do:
     2984           find first buf_pl-pump-nozzle no-lock
     2985             where buf_pl-pump-nozzle.obj-type    = p-obj-type
     2986               and buf_pl-pump-nozzle.obj-code    = p-obj-code
     2987               and buf_pl-pump-nozzle.pl-code     = v-pl-code
     2988               and buf_pl-pump-nozzle.pump-code   = p-pump-code
     2989               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     2990             no-error .
     2991           if not available buf_pl-pump-nozzle then do:
     2992             return p-pl-code .
     2993           end.
     2994         end.
     2995         if v-pl-code = 0 then do:
     2996           if p-nozzle-code = 0 then do:
     2997             find first buf_pl-gds-pump no-lock
     2998               where buf_pl-gds-pump.obj-type  = p-obj-type
     2999                 and buf_pl-gds-pump.obj-code  = p-obj-code
     3000                 and buf_pl-gds-pump.pump-code = p-pump-code
     3001                 and buf_pl-gds-pump.gds-code  = p-gds-code
     3002                 and buf_pl-gds-pump.status_   = 'тек':U
     3003               no-error.
     3004             if available buf_pl-gds-pump then do:
     3005               assign
     3006                 v-pl-code = buf_pl-gds-pump.pl-code
     3007               .
     3008             end.
     3009           end.
     3010           else do:
     3011             _ppnz:
     3012             for each buf_pl-pump-nozzle no-lock
     3013               where buf_pl-pump-nozzle.obj-type = p-obj-type
     3014                 and buf_pl-pump-nozzle.obj-code = p-obj-code
     3015                 and buf_pl-pump-nozzle.pump-code = p-pump-code
     3016                 and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     3017               ,first buf_pl-gds-pump no-lock
     3018               where buf_pl-gds-pump.obj-type  = p-obj-type
     3019                 and buf_pl-gds-pump.obj-code  = p-obj-code
     3020                 and buf_pl-gds-pump.pump-code = p-pump-code
     3021                 and buf_pl-gds-pump.gds-code  = p-gds-code
     3022                 and buf_pl-gds-pump.status_   = 'тек':U
     3023                 and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     3024             on error undo, return error return-value
     3025             :
     3026               assign
     3027                 v-pl-code = buf_pl-pump-nozzle.pl-code
     3028               .
     3029               leave _ppnz.
     3030             end.
     3031           end.
     3032         end.
     3033         if v-pl-code <> 0 then do:
     3034           assign
     3035             p-pl-code = v-pl-code
     3036           .
     3037         end .
     3038         return p-pl-code .
     3039       end .
     3040     end method .
     3041     method private integer findblockedtank
     3042     (
     3043       input p-obj-type     as character,
     3044       input p-obj-code     as integer,
     3045       input p-pump-code    as integer,
     3046       input p-nozzle-code  as integer,
     3047       input p-from-pl-code as integer,
     3048       input p-gds-code     as integer
     3049     ) :
     3050       define variable v-pl-code            like ub.place.pl-code no-undo .
     3051       define variable p-pl-code            like ub.place.pl-code no-undo .
     3052       define variable v-dopstr             as character no-undo .
     3053       define buffer buf_place for ub.place.
     3054       define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     3055       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     3056       define buffer buf_pl-gds for ub.pl-gds.
     3057       do
     3058       on error undo, return error return-value
     3059       :
     3060         assign
     3061           v-pl-code = 0
     3062           p-pl-code = ?
     3063         .
     3064         if p-from-pl-code <> ?
     3065           and p-from-pl-code <> 0
     3066         then do:
     3067           find first buf_pl-gds no-lock
     3068             where buf_pl-gds.obj-type  = p-obj-type
     3069               and buf_pl-gds.obj-code  = p-obj-code
     3070               and buf_pl-gds.pl-code   = p-from-pl-code
     3071               and buf_pl-gds.gds-code  = p-gds-code
     3072             no-error.
     3073           if available buf_pl-gds then do:
     3074             assign
     3075               v-pl-code = buf_pl-gds.pl-code
     3076             .
     3077           end.
     3078         end.
     3079         if v-pl-code <> 0
     3080           and p-nozzle-code <> ?
     3081           and p-nozzle-code <> 0
     3082         then do:
     3083           find first buf_pl-pump-nozzle no-lock
     3084             where buf_pl-pump-nozzle.obj-type    = p-obj-type
     3085               and buf_pl-pump-nozzle.obj-code    = p-obj-code
     3086               and buf_pl-pump-nozzle.pl-code     = v-pl-code
     3087               and buf_pl-pump-nozzle.pump-code   = p-pump-code
     3088               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     3089             no-error .
     3090           if not available buf_pl-pump-nozzle then do:
     3091             return p-pl-code .
     3092           end.
     3093         end.
     3094         if v-pl-code = 0 then do:
     3095           if p-nozzle-code = 0 then do:
     3096             find first buf_pl-gds-pump no-lock
     3097               where buf_pl-gds-pump.obj-type  = p-obj-type
     3098                 and buf_pl-gds-pump.obj-code  = p-obj-code
     3099                 and buf_pl-gds-pump.pump-code = p-pump-code
     3100                 and buf_pl-gds-pump.gds-code  = p-gds-code
     3101               no-error.
     3102             if available buf_pl-gds-pump then do:
     3103               assign
     3104                 v-pl-code = buf_pl-gds-pump.pl-code
     3105               .
     3106             end.
     3107           end.
     3108           else do:
     3109             _ppnz:
     3110             for each buf_pl-pump-nozzle no-lock
     3111               where buf_pl-pump-nozzle.obj-type = p-obj-type
     3112                 and buf_pl-pump-nozzle.obj-code = p-obj-code
     3113                 and buf_pl-pump-nozzle.pump-code = p-pump-code
     3114                 and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     3115               ,first buf_pl-gds-pump no-lock
     3116               where buf_pl-gds-pump.obj-type  = p-obj-type
     3117                 and buf_pl-gds-pump.obj-code  = p-obj-code
     3118                 and buf_pl-gds-pump.pump-code = p-pump-code
     3119                 and buf_pl-gds-pump.gds-code  = p-gds-code
     3120                 and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     3121             on error undo, return error return-value
     3122             :
     3123               assign
     3124                 v-pl-code = buf_pl-pump-nozzle.pl-code
     3125               .
     3126               leave _ppnz.
     3127             end.
     3128           end.
     3129         end.
     3130         if v-pl-code <> 0 then do:
     3131           assign
     3132             p-pl-code = v-pl-code
     3133           .
     3134         end .
     3135         return p-pl-code .
     3136       end .
     3137     end method .
     3138   end class .
