     1970                                              string-mth(tt-result.wght-fact-start)
     1971                                              ) .
     1972       end .
     1973       for each tt-result,
     1974       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     1975       :
     1976         run write-to-log in p-parent-handle ("book_gds " + string(tt-result.gds-code) + ": " + buf_goods.gds-name + "; " +
     1977                                              string-mth(tt-result.wght-doc-start)
     1978                                              ) .
     1979       end .
     1980       run write-to-log in p-parent-handle (" END FACT-BOOK-START UTC " + utc-time() ) .
     1981     end method .
     1982     method private void stage4 () :
     1983       define buffer buf_trn-doc for ub.trn-doc .
     1984       define buffer buf_doc-attr for ub.doc-attr .
     1985       define buffer buf_doc-line for ub.doc-line .
     1986       define buffer buf_doc-pl for ub.doc-pl .
     1987       define buffer buf_chk-doc for ub.chk-doc .
     1988       define buffer buf_chk-gds for ub.chk-gds .
