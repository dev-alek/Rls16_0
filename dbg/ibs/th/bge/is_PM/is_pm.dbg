     2525                                            (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     2526                                       and ((buf_trn-doc.shift-date > end_rvs-doc.shift-date) or
     2527                                            (buf_trn-doc.shift-date = end_rvs-doc.shift-date and buf_trn-doc.shift-num > end_rvs-doc.shift-num))
     2528           :
     2529             if buf_trn-doc.ext-doc-type <> 'vt':U
     2530             then
     2531             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2532                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2533                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     2534                                                  :
     2535               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next income-doc-line_ .
     2536             end .
     2537             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     2538                                           and buf_doc-pl.obj-code = obj-code
     2539                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     2540                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     2541                                           and buf_doc-pl.gds-code = tt-place.gds-code
     2542                                           :
     2543               tt-place.end-trn-doc-qnty = tt-place.end-trn-doc-qnty + buf_doc-pl.cli-fact-qnty .
     2544             end .
     2545           end .
     2546           expense-doc-line_ :
     2547           for each buf_doc-line no-lock where buf_doc-line.obj-type  = obj-type
     2548                                           and buf_doc-line.obj-code  = obj-code
     2549                                           and buf_doc-line.artic     = buf_goods.artic
     2550                                           and buf_doc-line.prod-type = buf_goods.prod-type
     2551                                           and buf_doc-line.prod-code = buf_goods.prod-code
     2552                                           and buf_doc-line.status_   = 'факт':U
     2553                                           ,
     2554           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2555                                       and (buf_trn-doc.ext-doc-type = 'ee':U or buf_trn-doc.ext-doc-type = 'ep':U or buf_trn-doc.ext-doc-type = 'ev':U or buf_trn-doc.ext-doc-type = 'we':U)
     2556                                       and ((buf_trn-doc.fact-date < date-end) or
     2557                                            (buf_trn-doc.fact-date = date-end and buf_trn-doc.fact-time <= time-end))
     2558                                       and ((buf_trn-doc.shift-date > end_rvs-doc.shift-date) or
     2559                                            (buf_trn-doc.shift-date = end_rvs-doc.shift-date and buf_trn-doc.shift-num > end_rvs-doc.shift-num))
     2560           :
     2561             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     2562                                                  and buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     2563                                                  and buf_clients-attr.attr-code = 'shftrep2':U
     2564                                                  :
     2565               if lookup(buf_clients-attr.attr-value, 'true,yes':u) > 0 then next expense-doc-line_ .
     2566             end .
     2567             for each buf_doc-pl no-lock where buf_doc-pl.obj-type = obj-type
     2568                                           and buf_doc-pl.obj-code = obj-code
     2569                                           and buf_doc-pl.pl-code  = tt-place.pl-code
     2570                                           and buf_doc-pl.out-code = buf_doc-line.doc-code
     2571                                           and buf_doc-pl.gds-code = tt-place.gds-code
     2572                                           :
     2573               tt-place.end-trn-doc-qnty = tt-place.end-trn-doc-qnty - buf_doc-pl.cli-fact-qnty .
     2574             end .
     2575           end .
     2576         end .
     2577         for first tt-result where tt-result.gds-code = tt-place.gds-code :
     2578           tt-result.wght-doc-end = tt-result.wght-doc-end + (tt-place.end-rvs-doc-qnty - tt-place.end-chk-doc-qnty + tt-place.end-trn-doc-qnty) .
     2579           if session:debug-alert
     2580           then  do:
     2581             put stream OutStr-html unformatted
     2582               "wght-doc-end Формула 9 Определение книжного остатка на конец периода" skip
     2583               "Резервуар: " + string(tt-place.gds-code) + " " +  string(tt-place.pl-code) + " " +  string(tt-place.pl-name) skip
     2584               string(tt-place.end-rvs-doc-qnty) + " - " +  string (tt-place.end-chk-doc-qnty) +  " + " + string(tt-place.end-trn-doc-qnty) skip
     2585               string(tt-result.wght-doc-end) skip
     2586             .
     2587           end.
     2588         end .
     2589       end .
     2590       for each tt-result where (tt-result.wght-doc-end = 0 or tt-result.wght-doc-end = ?)
     2591                            and (tt-result.wght-doc-start = 0 or tt-result.wght-doc-start = ?)
     2592                            and tt-result.change-place
     2593                             :
     2594         delete tt-result .
     2595       end .
     2596       for each tt-result where tt-result.change-place :
     2597         if tt-result.wght-doc-end = 0 then tt-result.wght-fact-end = 0 .
     2598       end .
     2599       for each tt-result :
     2600         tt-result.wght-other = tt-result.wght-doc-end - tt-result.wght-doc-start - tt-result.delivery + tt-result.wght-sale - tt-result.othermoves .
     2601         if session:debug-alert
     2602         then do:
     2603           put stream OutStr-html unformatted
     2604             "wght-other Формула 10 Расчет расхода на прочие нужды" skip
     2605             "Товар: " + string(tt-result.gds-code) + " " +  string(tt-result.gds-name) skip
     2606             string(tt-result.wght-doc-end) + " - " +  string (tt-result.wght-doc-start) +  " - " + string(tt-result.delivery) + " + " + string (tt-result.wght-sale) skip
     2607             string(tt-result.wght-other) skip
     2608           .
     2609         end.
     2610         tt-result.loss-own-needs = tt-result.wght-fact-end - tt-result.wght-doc-end .
     2611       end .
     2612       for each tt-result,
     2613       first buf_goods-attr no-lock where buf_goods-attr.gds-code = tt-result.gds-code
     2614                                      and buf_goods-attr.attr-code = 'fuel-type':U
     2615       :
     2616         if buf_goods-attr.attr-value = 'metan':U
     2617         then do :
     2618           assign
     2619             tt-result.wght-doc-start = 0
     2620             tt-result.wght-fact-start = 0
     2621             tt-result.wght-doc-end = 0
     2622             tt-result.wght-fact-end = 0
     2623             tt-result.Delivery-ned-izl = 0
     2624           .
     2625         end .
     2626       end .
     2627       for each tt-result,
     2628       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     2629       :
     2630         run write-to-log in p-parent-handle ("book_gds " + string(tt-result.gds-code) + ": " + buf_goods.gds-name + "; " +
     2631                                              string-mth(tt-result.wght-doc-end) + "; " +
     2632                                              string-mth(tt-result.wght-other)
     2633                                              ) .
     2634       end .
     2635       if (is-full or is-full-backdate)
     2636       and not otherOneDate
     2637       then do :
     2638         find first buf_clients-attr exclusive-lock where buf_clients-attr.obj-type = buf_clients.obj-type
     2639                                                      and buf_clients-attr.obj-code = buf_clients.obj-code
     2640                                                      and buf_clients-attr.attr-code = 'exp-isPM-last-date':U
     2641                                                      no-error .
     2642         if not available buf_clients-attr
     2643         then do :
     2644           create buf_clients-attr .
     2645           assign
     2646             buf_clients-attr.obj-type = buf_clients.obj-type
     2647             buf_clients-attr.obj-code = buf_clients.obj-code
     2648             buf_clients-attr.attr-code = 'exp-isPM-last-date':U
     2649           .
     2650         end .
     2651         buf_clients-attr.attr-value = string(vMoscowDate) .
     2652         last-exp-date = vMoscowDate .
     2653       end .
     2654       run write-to-log in p-parent-handle (" END BOOK-END UTC " + utc-time() ) .
     2655     end method .
     2656     method private character make-rvs-doc () :
     2657       define variable v-new-rvs-code as character no-undo init ? .
     2658       run str/rvs-auto-is_PM.p (
     2659                                 input parparentproc,
     2660                                 input obj-type,
     2661                                 input obj-code,
     2662                                 output v-new-rvs-code)
     2663       no-error .
     2664       if error-status:error
     2665       or v-new-rvs-code = ?
     2666       then do :
     2667         return "error" .
     2668       end .
     2669       return v-new-rvs-code .
     2670     end method .
     2671     method private logical get-check () :
     2672       define variable v-parameter as character no-undo .
     2673       assign
     2674         v-parameter =
     2675                        obj-type         + chr(4) +
     2676                        string(obj-code) + chr(4) +
     2677                        string(0)        + chr(4) +
     2678                        string(1)
     2679       .
     2680       run str/get-chkf.p (
     2681                           input parparentproc,
     2682                           input p-parent-handle,
     2683                           input parparentproc,
     2684                           input v-parameter )
     2685       no-error .
     2686       if error-status:error then do:
     2687         return false .
     2688       end .
     2689       return true .
     2690     end method .
     2691     method private memptr create-esys-data () :
     2692       define variable sw as handle no-undo.
     2693       define variable ii as integer no-undo .
     2694       define variable currMoscowTime as integer no-undo .
     2695       define variable currMoscowDate as date no-undo .
     2696       currMoscowTime = time - (timezone-diff * 60) .
     2697       if currMoscowTime < 0
     2698       then do :
     2699         currMoscowTime = currMoscowTime + 86400 .
     2700       end .
     2701       currMoscowDate = date(now - (timezone-diff * 60 * 1000)) .
     2702       create sax-writer sw.
     2703       sw:set-output-destination ("memptr", Data).
     2704       sw:encoding = "UTF-8".
     2705       sw:fragment = true .
     2706       sw:formatted = true .
     2707       sw:start-document () .
     2708         sw:start-element ("operating-balance") .
     2709           sw:write-data-element ("org-unit-code", string(buf_clients.host-code)).
     2710           sw:write-data-element ("azk-code", string(buf_clients.obj-code)).
     2711           sw:write-data-element ("doc-date", (iso-date(currMoscowDate) + "T" + string(currMoscowTime, "HH:MM:SS")) ).
     2712           sw:write-data-element ("start-date", (iso-date(vMoscowDate) + "T" + string(0, "HH:MM:SS")) ).
     2713           sw:write-data-element ("end-date", (iso-date(vMoscowDate) + "T" + string(vMoscowTimeEnd, "HH:MM:SS")) ).
     2714           sw:start-element ("gds") .
     2715           ii = 0 .
     2716           for each tt-result by tt-result.gds-code :
     2717             sw:start-element ("gd") .
     2718               ii = ii + 1 .
     2719               sw:write-data-element ("line-num",  string(ii)).
     2720               sw:write-data-element ("gd-code",   string(tt-result.gds-code)).
     2721               sw:write-data-element ("wght-fact-start",     string-mth(tt-result.wght-fact-start)).
     2722               sw:write-data-element ("wght-fact-end",       string-mth(tt-result.wght-fact-end)).
     2723               sw:write-data-element ("wght-doc-start",      string-mth(tt-result.wght-doc-start)).
     2724               sw:write-data-element ("wght-doc-end",        string-mth(tt-result.wght-doc-end)).
     2725               sw:write-data-element ("delivery",            string-mth(tt-result.delivery)).
     2726               sw:write-data-element ("delivery-own-pnpo",   string-mth(tt-result.delivery-own-pnpo)).
     2727               sw:write-data-element ("delivery-other-pnpo", string-mth(tt-result.delivery-other-pnpo)).
     2728               sw:write-data-element ("delivery-other",      string-mth(tt-result.delivery-other)).
     2729               sw:write-data-element ("direct-delivery",     string-mth(tt-result.direct-delivery)).
     2730               sw:write-data-element ("fuel-in-transit",     string-mth(tt-result.fuel-in-transit)).
     2731               sw:write-data-element ("wght-sale",           string-mth(tt-result.wght-sale)).
     2732               sw:write-data-element ("wght-wholesale",      string-mth(tt-result.wght-wholesale)).
     2733               sw:write-data-element ("loss-own-needs",      string-mth(tt-result.loss-own-needs)).
     2734               sw:write-data-element ("Delivery-ned-izl",    string-mth(tt-result.Delivery-ned-izl)).
     2735               sw:write-data-element ("wght-other",          string-mth(tt-result.wght-other)).
     2736               sw:write-data-element ("othermoves",          string-mth(tt-result.othermoves)).
     2737             sw:end-element ("gd") .
     2738           end .
     2739           sw:end-element ("gds") .
     2740         sw:end-element ("operating-balance") .
     2741       sw:end-document () .
     2742     end method .
     2743     method private void make-rep () :
     2744       define variable v-now as datetime no-undo .
     2745       define variable v-msk-dt as datetime no-undo .
     2746       define variable v-host-code as integer no-undo .
     2747       define variable v-host-name as character no-undo .
     2748       define buffer host_clients for ub.clients .
     2749       define buffer buf_goods for ub.goods .
     2750       v-host-code = buf_clients.host-code .
     2751       find first host_clients no-lock where host_clients.obj-code = buf_clients.host-code
     2752                                         and host_clients.obj-type = 'орг':U
     2753                                         no-error .
     2754       if available host_clients
     2755       then do :
     2756         v-host-code = host_clients.obj-code .
     2757         v-host-name = host_clients.obj-name .
     2758       end .
     2759       rep-file-name = "PM_" + replace(string(vMoscowDate, "99/99/9999"), "/", "") + "_" + replace(string(vMoscowTimeEnd, "HH:MM:SS"), ":", "") + ".html" .
     2760       output stream OutStr-html to value(rep-file-name) convert target 'UTF-8' .
     2761       put stream OutStr-html unformatted
     2762         "<!DOCTYPE HTML>" skip
     2763         ' <html>' skip
     2764         '  <head>' skip
     2765         '   <meta charset="utf-8">' skip
     2766         '    <style type="text/css">' skip
     2767         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2768         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2769         '      tbody, td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     2770         '   </style>' skip
     2771         '  </head>' skip
     2772       .
     2773       put stream OutStr-html unformatted
     2774         '<body>' skip
     2775         '<table name="Лист1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     2776         '<thead>' skip
     2777       .
     2778       put stream OutStr-html unformatted
     2779           '<tr class="set_columns">' skip
     2780             '<td style="width: 100px; border: none;"></td>' skip
     2781             '<td style="width: 70px; border: none;"></td>' skip
     2782             '<td style="width: 70px; border: none;"></td>' skip
     2783             '<td style="width: 70px; border: none;"></td>' skip
     2784             '<td style="width: 70px; border: none;"></td>' skip
     2785             '<td style="width: 70px; border: none;"></td>' skip
     2786             '<td style="width: 70px; border: none;"></td>' skip
     2787             '<td style="width: 70px; border: none;"></td>' skip
     2788             '<td style="width: 70px; border: none;"></td>' skip
     2789             '<td style="width: 70px; border: none;"></td>' skip
     2790             '<td style="width: 70px; border: none;"></td>' skip
     2791             '<td style="width: 70px; border: none;"></td>' skip
     2792             '<td style="width: 70px; border: none;"></td>' skip
     2793             '<td style="width: 70px; border: none;"></td>' skip
     2794             '<td style="width: 70px; border: none;"></td>' skip
     2795             '<td style="width: 70px; border: none;"></td>' skip
     2796             '<td style="width: 70px; border: none;"></td>' skip
     2797             '<td style="width: 70px; border: none;"></td>' skip
     2798             '<td style="width: 70px; border: none;"></td>' skip
     2799             '<td style="width: 70px; border: none;"></td>' skip
     2800             '<td style="width: 70px; border: none;"></td>' skip
     2801             '<td style="width: 70px; border: none;"></td>' skip
     2802             '<td style="width: 70px; border: none;"></td>' skip
     2803             '<td style="width: 70px; border: none;"></td>' skip
     2804           '</tr>' skip
     2805       .
     2806       v-now = now .
     2807       v-msk-dt = now - (timezone-diff * 60 * 1000) .
     2808       put stream OutStr-html unformatted
     2809           '<tr>' skip
     2810             '<td colspan="24" style="text-align: center; font-weight:bold;">Ежедневный отчет по движению топлива за сутки на АЗС/АЗК </td>' skip
     2811           '</tr>' skip
     2812           '<tr>' skip
     2813             '<td colspan="12" style="text-align: left; font-weight:bold;">' + string(v-msk-dt, "99.99.9999 HH:MM:SS") + '</td>' skip
     2814             '<td colspan="12" style="text-align: left; font-weight:bold;">' + string(v-now, "99.99.9999 HH:MM:SS") + '</td>' skip
     2815           '</tr>' skip
     2816         '</thead>' skip
     2817       .
     2818       put stream OutStr-html unformatted
     2819         '     <tbody>' skip
     2820         '       <tr>' skip
     2821         '         <th style="text-align: center; font-weight:bold; background-color: silver; height: 30px">Наименование организации</th>' skip
     2822         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код организации</th>' skip
     2823         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование АЗС/АЗК</th>' skip
     2824         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код АЗС/АЗК</th>' skip
     2825         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Дата актуальности</th>' skip
     2826         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Время актуальности</th>' skip
     2827         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Название товара</th>' skip
     2828         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код товара</th>' skip
     2829         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Книж. остатки на начало дня, кг</th>' skip
     2830         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Книж. остатки на конец дня, кг</th>' skip
     2831         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Факт. остатки на начало дня, кг</th>' skip
     2832         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Факт. остатки на конец дня, кг</th>' skip
     2833         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Поступления, кг</th>' skip
     2834         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Поступления от собственных нефтебаз ПНПО, кг</th>' skip
     2835         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Прямые поставки, кг</th>' skip
     2836         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Поступления от собственных нефтебаз других ПНПО, кг</th>' skip
     2837         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Поступления от сторонних поставщиков, кг</th>' skip
     2838         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Нефтепродукты в пути, кг</th>' skip
     2839         '         <th style="text-align: center; font-weight:bold; background-color: silver;">АЗС/АЗК, кг</th>' skip
     2840         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Мелкий опт, кг</th>' skip
     2841         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Потери и потребление на собственные нужды, кг</th>' skip
     2842         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Недостачи и излишки при приеме, кг</th>' skip
     2843         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Расход на прочие нужды, кг</th>' skip
     2844         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Прочие перемещения на АЗС, кг</th>' skip
     2845         '       </tr>' skip
     2846       .
     2847       for each tt-result,
     2848       first buf_goods no-lock where buf_goods.gds-code = tt-result.gds-code
     2849       by tt-result.gds-code
     2850       :
     2851         put stream OutStr-html unformatted
     2852           '     <tbody>' skip
     2853           '       <tr>' skip
     2854           '         <th style="text-align: left; ">' + v-host-name + '</th>' skip
     2855           '         <th style="text-align: right;">' + string(v-host-code) + '</th>' skip
     2856           '         <th style="text-align: left; ">' + buf_clients.obj-name + '</th>' skip
     2857           '         <th style="text-align: right;">' + string(buf_clients.obj-code) + '</th>' skip
     2858           '         <th style="text-align: left; ">' + string(vMoscowDate, "99.99.9999") + '</th>' skip
     2859           '         <th style="text-align: left; ">' + string(vMoscowTimeEnd, "HH:MM:SS") + '</th>' skip
     2860           '         <th style="text-align: left; ">' + buf_goods.gds-name + '</th>' skip
     2861           '         <th style="text-align: right;">' + string(buf_goods.gds-code) + '</th>' skip
