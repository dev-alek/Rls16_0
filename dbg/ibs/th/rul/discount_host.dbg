        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Discount_host:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: discount_host.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_lh as widget-handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected buffer buf_Discount_host for ub.dis-card-property.
       10     define protected temp-table t-Discount_host no-undo like ub.dis-card-property
       11     field recid_ as recid
       12     field h-n-action as integer
       13     field ordinal as integer
       14     field init-value-character as character
       15     field init-value-date as date
       16     field init-value-decimal as decimal
       17     field init-value-integer as integer
       18     field init-value-logical as logical
       19     field node-name as character
       20    .
       21     define protected buffer buft_Discount_host for t-Discount_host.
       22     define public variable v_bh as handle no-undo.
       23     define protected variable v_tbh as handle no-undo.
       24     define protected variable v_tcbh as handle no-undo .
       25     define public variable temp as integer no-undo.
       26     define public property lock as integer
       27     get.
       28     set.
       29     define public property wait as integer
       30     get.
       31     set.
       32     define private buffer buf_prop-map for ub.prop-map.
       33     define protected variable dtm-code as integer no-undo .
       34     define protected variable node-code# as integer no-undo .
       35     define protected variable dt-code as integer no-undo .
       36     define protected variable num-members as integer no-undo .
       37     define private variable v-error-flag as logical no-undo.
       38     define public variable card-num as integer no-undo .
       39     define public variable d-card as character no-undo .
       40     define public variable first-card as character no-undo .
       41     define public variable first-main-card as character no-undo .
       42     define public variable main-card as character no-undo .
       43     define public variable type# as character no-undo .
       44     define public variable emitent-host-code# as integer no-undo .
       45     define public variable host-code as integer no-undo .
       46     define public variable d-pcnt as decimal no-undo .
       47     define public variable cash-d-pcnt as decimal no-undo .
       48     define public variable category as integer no-undo .
       49     CONSTRUCTOR PUBLIC Discount_host(
       50                                  input parparentproc as widget-handle
       51                                 ,input p-parent-handle as handle
       52                                 ,input p-log-handle as handle
       53                                 ,input p-gc-handle as handle
       54                                 ,input p-cont-handle as handle
       55                                 ,input p-lock as integer
       56                                 ,input p-wait as integer
       57                                 ,input p-temp as integer
       58                                 ,input p-dtm-code as integer
       59                               ):
       60   define variable glog as logical no-undo .
       61   assign
       62   v_pp = parparentproc
       63   v_lh = p-log-handle
       64   v_ph = p-parent-handle
       65   v_gc = p-gc-handle
       66   v_cnt = p-cont-handle
       67   lock = p-lock
       68   wait = p-wait
       69   temp = p-temp
       70   .
       71   run garbcoll_create-gc-entry in p-gc-handle (input 'Discount_host',  input this-object) no-error.
       72   if error-status:error then do:
       73     return error substitute("&1 Ошибка создания объекта Discount_host", vss-include-info0).
       74   end.
       75   v_bh = buffer buf_Discount_host:handle.
       76   v_tbh = buffer buft_Discount_host:handle.
       77       if temp < 0 then do:
       78         run tempcont_get-buffer-handle in v_cnt ( input 'dis-card-property':U
       79                                                   ,output v_tcbh).
       80       end.
       81       define buffer buf_prop-ref for ub.prop-ref.
       82       find first buf_prop-ref no-lock where
       83                buf_prop-ref.dtm-code = p-dtm-code no-error .
       84       if error-status:error then do:
       85          undo, return error substitute( "&1. Не найден срез &2 в справочнике итогов для ОБЪЕКТА СКИДКА-КАТЕГОРИЯ ПО ФИРМЕ-ОБЪЕКТУ&4"
       86                                          , vss-include-info0
       87                                          , chr(10)
       88                                          ).
       89       end.
       90       assign
       91       d-card = '':U
       92       dtm-code = p-dtm-code
       93       dt-code = buf_prop-ref.dt-code
       94       node-code# = 0
       95      .
       96       for each buf_prop-map  where buf_prop-map.dtm-code = p-dtm-code
       97       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
       98       :
       99         create buft_Discount_host.
      100         assign
      101         buft_Discount_host.dtm-code = buf_prop-map.dtm-code
      102         buft_Discount_host.node-code = buf_prop-map.node-code
      103         buft_Discount_host.node-name = buf_prop-map.node-name
      104         buft_Discount_host.ordinal = buf_prop-map.ordinal
      105         buft_Discount_host.init-value-character = buf_prop-map.init-value-character
      106         buft_Discount_host.init-value-date      = buf_prop-map.init-value-date
      107         buft_Discount_host.init-value-decimal   = buf_prop-map.init-value-decimal
      108         buft_Discount_host.init-value-integer   = buf_prop-map.init-value-integer
      109         buft_Discount_host.init-value-logical   = buf_prop-map.init-value-logical
      110         num-members = num-members + 1
      111         .
      112       end.
      113     end constructor.
      114     destructor public Discount_host():
      115       define variable glog as logical no-undo .
      116       for each buft_Discount_host:
      117         delete buft_Discount_host.
      118       end.
      119       find_Discount_host ( input '':U
      120                          ,input host-code
      121                            ).
      122     end destructor.
      123     method public void Discount_hostrelease_ ( ):
      124       define variable glog as logical no-undo .
      125       glog = v_bh:buffer-release() no-error .
      126       clear_().
      127     end method.
      128     method public handle get_Discount_host ( ):
      129       return v_bh.
      130     end method.
      131     method public logical set_Discount_host ( input p-bh as handle):
      132       define variable glog as logical no-undo .
      133       glog = v_bh:buffer-copy ( p-bh).
      134       return glog.
      135     end method.
      136     method public logical Discount_hostsave ( ):
      137      define variable glog as logical no-undo .
      138      define variable v-tosave as logical no-undo .
      139      define buffer buf_dis-card for ub.dis-card.
      140       if d-card <> '':U then do:
      141           _save:
      142           for each buft_Discount_host
      143           on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      144           :
      145             v-tosave = no.
      146             if buft_Discount_host.node-name = "d-pcnt"
      147             then do:
      148               if buft_Discount_host.init-value-decimal = d-pcnt then next _save.
      149               assign
      150               buft_Discount_host.property-value-decimal = d-pcnt
      151               .
      152             end.
      153             if buft_Discount_host.node-name = "cash-d-pcnt" then do:
      154               if buft_Discount_host.init-value-decimal = cash-d-pcnt then next _save.
      155               assign
      156               buft_Discount_host.property-value-decimal = cash-d-pcnt
      157               .
      158             end.
      159             if buft_Discount_host.node-name = "category" then do:
      160               if buft_Discount_host.init-value-integer = category then next _save.
      161               assign
      162               buft_Discount_host.property-value-integer = category
      163               .
      164             end.
      165             if buft_Discount_host.h-n-action = integer('2':U)
      166             or buft_Discount_host.h-n-action = integer('1':U)
      167             then do:
      168               if temp >= 0 then do:
      169                 if buft_Discount_host.recid_ <> ? then do:
      170                   find first buf_Discount_host exclusive-lock where
      171                       recid(buf_Discount_host) = buft_Discount_host.recid_.
      172                   v-tosave = not (v_bh:buffer-compare(v_tbh)).
      173                 end.
      174                 else do:
      175                   glog = v_bh:buffer-create().
      176                   glog = v_bh:buffer-copy( v_tbh, "property-value-character,property-value-date,property-value-decimal,property-value-integer,property-value-logical").
      177                   v-tosave = yes.
      178                 end.
      179                 if temp = 1 then do:
      180                   run tempcont_create-changes in v_cnt (
      181                                                  input 'dis-card-property':U
      182                                                 ,input v_bh
      183                                                 ,input v_tbh
      184                                                 ,input buft_discount_host.h-n-action
      185                                                 ) no-error.
      186                   if error-status:error then do:
      187                     undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      188                   end.
      189                 end.
      190                 if v-tosave then do:
      191                 run disproph_write-dis-card-property-rul in v_gc ( buffer buf_Discount_host
      192                                                         ,input type#
      193                                                         ,input emitent-host-code#
      194                                                         ,input 26
      195                                                         ,input buft_Discount_host.h-n-action) no-error .
      196                 if error-status:error then do:
      197                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      198                 end.
      199                 glog = v_bh:buffer-copy( v_tbh).
      200                 run disproph_send-dis-card-property-rul in v_gc ( buffer buf_Discount_host
      201                                                         ,input type#
      202                                                         ,input emitent-host-code#
      203                                                           ,input 26
      204                                                         ,input buft_Discount_host.h-n-action) no-error .
      205                 if error-status:error then do:
      206                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      207                 end.
      208                 end.
      209               end.
      210               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      211               if temp >= 0
      212               and v-tosave then do:
      213                 run cb_create-dc-list in v_ph ( input v_bh) no-error.
      214               end.
      215               glog = v_bh:buffer-release() no-error .
      216               if error-status:error then do:
      217                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      218               end.
      219               if temp = -1 then do:
      220                 run tempcont_create-changes in v_cnt (
      221                                                 input 'dis-card-property':U
      222                                                ,input v_bh
      223                                                ,input v_tbh
      224                                                ,input buft_Discount_host.h-n-action) no-error.
      225                 if error-status:error then do:
      226                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      227                 end.
      228               end.
      229               if temp = -2 then do:
      230                 run tempcont_create-record in v_cnt (
      231                                                 input 'dis-card-property':U
      232                                                ,input v_tbh
      233                                                ,input buft_discount_host.h-n-action) no-error.
      234                 if error-status:error then do:
      235                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      236                 end.
      237               end.
      238             end.
      239           end.
      240       end.
      241       return yes.
      242     end method.
      243      method public logical find_Discount_host ( input p-d-card as character
      244                                                ,input p-host-code as integer
      245                                               ):
      246      define variable glog as logical no-undo .
      247      define variable v-jj as integer no-undo .
      248      define variable v-where as character no-undo .
      249      define buffer buf_dis-card for ub.dis-card.
      250      define buffer buf_sysconf for ub.sysconf.
      251       Discount_hostrelease_().
      252       clear_().
      253       if p-d-card <> '':U then do:
      254         find first buf_dis-card no-lock where
      255                   buf_dis-card.d-card = p-d-card no-error.
      256         if not available buf_dis-card then do:
      257            return error substitute("Не найдена ДК &1", p-d-card).
      258         end.
      259         find first buf_sysconf no-lock where
      260                   buf_sysconf.host-code = p-host-code no-error.
      261         if not available buf_sysconf then do:
      262           run set-error in v_gc (substitute("Неверно задан объект для создания свойства <Скидка по фирме> - не найдена фирма &2 (ДК &1)"
      263                                             , d-card
      264                                             , p-host-code
      265                                             )).
      266           return no.
      267         end.
      268         assign
      269         card-num                 = buf_dis-card.card-num
      270         d-card                   = buf_dis-card.d-card
      271         first-card               = buf_dis-card.first-card
      272         first-main-card          = buf_dis-card.first-main-card
      273         main-card                = buf_dis-card.main-card
      274         emitent-host-code#       = buf_dis-card.emitent-host-code
      275         type#                    = buf_dis-card.type
      276         host-code                = p-host-code
      277         .
      278         define variable v-ii as integer no-undo .
      279         _buft_dis-card-property:
      280         for each buft_Discount_host
      281         by buft_Discount_host.dt-code
      282         by buft_Discount_host.node-code
      283         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      284         :
      285           if temp < 0 then do:
      286             v-where =  substitute('where d-card = "&1" and host-code = &4 and obj-type = "" and obj-code = 0 and dt-code = &2 and node-code = &3'
      287                                   , p-d-card
      288                                   , dt-code
      289                                   , buft_Discount_host.node-code
      290                                   , p-host-code
      291                                   ).
      292             assign
      293             glog = v_tcbh:find-first( v-where) no-error .
      294             if v_tcbh:available then do:
      295               glog = v_tbh:buffer-copy( v_tcbh).
      296               assign
      297               buft_discount_host.h-n-action             = integer('2':U)
      298               v-jj = v-jj + 1
      299               .
      300             end.
      301           end.
      302           if temp >= 0 or v_tcbh:available = no then do:
      303           assign
      304           buft_Discount_host.card-num                 = buf_dis-card.card-num
      305           buft_Discount_host.d-card                   = buf_dis-card.d-card
      306           buft_Discount_host.first-card               = buf_dis-card.first-card
      307           buft_Discount_host.first-main-card          = buf_dis-card.first-main-card
      308           buft_Discount_host.main-card                = buf_dis-card.main-card
      309           buft_Discount_host.recid_ = ?
      310           buft_Discount_host.h-n-action = 0
      311           buft_Discount_host.property-value-decimal   = buft_Discount_host.init-value-decimal
      312           buft_Discount_host.property-value-integer   = buft_Discount_host.init-value-integer
      313           buft_Discount_host.dt-code                  = dt-code
      314           buft_Discount_host.sum-id                   = 'Discount'
      315           buft_Discount_host.host-code                = p-host-code
      316           buft_Discount_host.obj-type                 = ''
      317           buft_Discount_host.obj-code                 = 0
      318           v-jj = v-jj + 1
      319           .
      320           v-where =  substitute('where d-card = "&1" and host-code = &4 and obj-type = "" and obj-code = 0 and dt-code = &2 and node-code = &3'
      321                                   , p-d-card
      322                                   , dt-code
      323                                   , buft_Discount_host.node-code
      324                                   , p-host-code
      325                                   ).
      326           assign
      327           glog =  v_bh:find-first( v-where
      328                                   , lock
      329                                   , wait) no-error .
      330           if not glog then do:
      331             if wait = NO-WAIT
      332             and v_bh:locked then do:
      333               return error substitute("Запись свойств ДК &1 занята", p-d-card).
      334             end.
      335             assign
      336             buft_Discount_host.h-n-action = integer('1':U).
      337             if v-jj = num-members then leave _buft_dis-card-property.
      338             next _buft_dis-card-property.
      339           end.
      340           else do:
      341             assign
      342             buft_Discount_host.h-n-action = integer('2':U)
      343             .
      344           end.
      345           assign
      346           v-ii = v-ii + 1
      347           buft_Discount_host.recid_ = recid(buf_Discount_host)
      348           .
      349           glog = v_tbh:buffer-copy( v_bh).
      350           end.
      351           if buft_Discount_host.node-name = "d-pcnt" then do:
      352              assign
      353              d-pcnt = buft_Discount_host.property-value-decimal
      354              node-code#                = buft_Discount_host.node-code
      355              .
      356           end.
      357           if buft_Discount_host.node-name = "cash-d-pcnt" then do:
      358              assign
      359              cash-d-pcnt = buft_Discount_host.property-value-decimal
      360              node-code#                = buft_Discount_host.node-code
      361              .
      362           end.
      363           if buft_Discount_host.node-name = "category" then do:
      364              assign
      365              category = buft_Discount_host.property-value-integer
      366              node-code#                = buft_Discount_host.node-code
      367              .
      368           end.
      369           if v-jj = num-members then leave _buft_dis-card-property.
      370         end.
      371         if v-ii = 0 then do:
      372           return no.
      373         end.
      374       end.
      375       return yes.
      376     end method.
      377     method public logical create_Discount_host ( input p-d-card as character
      378                                                ,input p-host-code as integer
      379                                                  ):
      380       define buffer buft2_ for t-Discount_host.
      381       for each buft2_ :
      382         if buft2_.recid_ = ?
      383         and buft2_.init-value-decimal <> 0.0
      384         then do:
      385           assign
      386           buft2_.h-n-action     = integer('1':U)
      387           .
      388         end.
      389         if buft2_.recid_ = ?
      390         and buft2_.init-value-integer <> 0
      391         then do:
      392           assign
      393           buft2_.h-n-action     = integer('1':U)
      394           .
      395         end.
      396       end.
      397       return yes.
      398     end method.
      399     method protected void clear_():
      400       define variable glog as logical no-undo .
      401       v-error-flag = no.
      402       assign
      403       d-card = ''
      404       .
      405       for each buft_Discount_host:
      406         assign
      407         buft_Discount_host.card-num                 = 0
      408         buft_Discount_host.d-card                   = '':U
      409         buft_Discount_host.first-card               = '':U
      410         buft_Discount_host.first-main-card          = '':U
      411         buft_Discount_host.main-card                = '':U
      412         buft_Discount_host.recid_ = ?
      413         buft_Discount_host.h-n-action = 0
      414         buft_Discount_host.property-value-decimal = buft_Discount_host.init-value-decimal
      415         buft_Discount_host.property-value-integer = buft_Discount_host.init-value-integer
      416         buft_Discount_host.dt-code                 = 0
      417         buft_Discount_host.sum-id                  = '':U
      418         buft_Discount_host.obj-type                = '':U
      419         buft_Discount_host.obj-code                = 0
      420         buft_Discount_host.host-code                = 0
      421         .
      422       end.
      423     end method.
      424     method public override character ToString( ):
      425       return substitute("ДК &1 объект-операнд &2, фирма &3, свойство &4"
      426                         , d-card
      427                         , dtm-code
      428                         , host-code
      429                         , node-code#).
      430     end method.
      431   end class.
