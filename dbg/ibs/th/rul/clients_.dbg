        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.clients_:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: clients_.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_gc as handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_pp as widget-handle no-undo.
        7     define protected variable v_lh as widget-handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define public variable v_bh as handle no-undo.
       10     define public variable v_bfh as handle no-undo.
       11     define public variable v_bph as handle no-undo.
       12     define protected buffer buf_clients_ for ub.clients.
       13     define protected temp-table t-clients_ no-undo like ub.clients.
       14     define protected buffer buft_clients_ for t-clients_.
       15     define protected buffer buf_person_ for ub.person.
       16     define protected temp-table t-person_ no-undo like ub.person.
       17     define protected buffer buft_person_ for t-person_.
       18     define protected buffer buf_firm_ for ub.firm.
       19     define protected temp-table t-firm_ no-undo like ub.firm.
       20     define protected buffer buft_firm_ for t-firm_.
       21     define public variable v_tbh as handle no-undo.
       22     define public variable v_tbfh as handle no-undo.
       23     define public variable v_tbph as handle no-undo.
       24     define private variable v-h-action as integer no-undo .
       25     define private variable v-callpoint as character no-undo .
       26     define private variable v-error-flag as logical no-undo .
       27     define public variable temp as integer no-undo.
       28     define public property lock as integer
       29     get.
       30     set.
       31     define public property wait as integer
       32     get.
       33     set.
       34     define protected variable find_no-error as logical no-undo .
       35     define public variable obj-type as character no-undo .
       36     define public variable obj-code as integer no-undo .
       37     define public variable obj-name as character no-undo .
       38     define public variable grp-code as integer no-undo .
       39     define public variable PS as character no-undo .
       40     define public variable stts as integer no-undo .
       41     define public variable phone   as character no-undo .
       42     define public variable name1 as character no-undo .
       43     define public variable name2 as character no-undo .
       44     CONSTRUCTOR PUBLIC clients_(
       45                                  input parparentproc as widget-handle
       46                                 ,input p-parent-handle as handle
       47                                 ,input p-log-handle as handle
       48                                 ,input p-gc-handle as handle
       49                                 ,input p-cont-handle as handle
       50                                 ,input p-lock as integer
       51                                 ,input p-wait as integer
       52                                 ,input p-temp as integer
       53                                 ,input p-callpoint as character
       54                               ):
       55   define variable glog as logical no-undo .
       56   assign
       57   v_pp = parparentproc
       58   v_lh = p-log-handle
       59   v_ph = p-parent-handle
       60   v_gc = p-gc-handle
       61   v_cnt = p-cont-handle
       62   lock = p-lock
       63   wait = p-wait
       64   temp = p-temp
       65   .
       66   run garbcoll_create-gc-entry in p-gc-handle (input 'clients_',  input this-object) no-error.
       67   if error-status:error then do:
       68     return error substitute("&1 Ошибка создания объекта clients_", vss-include-info0).
       69   end.
       70   v_bh = buffer buf_clients_:handle.
       71   v_tbh = buffer buft_clients_:handle.
       72       v_bfh = buffer buf_firm_:handle.
       73       v_tbfh = buffer buft_firm_:handle.
       74       v_bph = buffer buf_person_:handle.
       75       v_tbph = buffer buft_person_:handle.
       76       assign
       77       obj-type = '':U
       78       obj-code = 0
       79       v-callpoint = p-callpoint
       80       .
       81     end constructor.
       82     destructor public clients_():
       83       define variable glog as logical no-undo .
       84       assign
       85       glog = v_tbh:empty-temp-table() no-error .
       86       assign
       87       glog = v_tbfh:empty-temp-table() no-error .
       88       assign
       89       glog = v_tbph:empty-temp-table() no-error .
       90       find_clients_ ( input '':U, input 0).
       91     end destructor.
       92     method public void clients_release_ ( ):
       93       define variable glog as logical no-undo .
       94       define variable glogf as logical no-undo .
       95       define variable glogp as logical no-undo .
       96       glog = v_bh:buffer-release() no-error .
       97       if obj-type = 'орг':U then do:
       98         glogf = v_bfh:buffer-release() no-error .
       99       end.
      100       if obj-type = 'чел':U then do:
      101         glogp = v_bph:buffer-release() no-error .
      102       end.
      103       clear_().
      104     end method.
      105     method public handle get_clients_ ( ):
      106       return v_bh.
      107     end method.
      108     method public logical find_clients_no-error ( p-obj-type as character, p-obj-code as integer):
      109       define variable glog as logical no-undo .
      110       assign
      111       find_no-error = yes.
      112       glog = find_clients_ ( input p-obj-type, input p-obj-code) no-error.
      113       return glog.
      114     end method.
      115     method public logical clients_save ( ):
      116      define variable glog as logical no-undo .
      117      define variable glogf as logical no-undo .
      118      define variable glogp as logical no-undo .
      119      define variable loc-action as integer no-undo .
      120       if obj-code <> 0
      121       or v-h-action = integer('1':U) then do:
      122         assign
      123         buft_clients_.obj-name    = obj-name
      124         buft_clients_.PS          = PS
      125         buft_clients_.stts        = stts
      126         buft_clients_.grp-code    = grp-code
      127         .
      128         if obj-type = 'орг':U then do:
      129           assign
      130           buft_firm_.phone = phone
      131           .
      132         end.
      133         if obj-type = 'чел':U then do:
      134           assign
      135           buft_person_.phone1 = phone
      136           buft_person_.name1  = name1
      137           buft_person_.name2  = name2
      138           .
      139         end.
      140         glog = no.
      141         if v_bh:available then do:
      142           glog = v_bh:buffer-compare(v_tbh).
      143           glogf = yes.
      144           glogp = yes.
      145           if obj-type = 'орг':U then
      146           glogf = v_bfh:buffer-compare(v_tbfh).
      147           if obj-type = 'чел':U then
      148           glogp = v_bph:buffer-compare(v_tbph).
      149         end.
      150         if not glog
      151         or not glogf
      152         or not glogp
      153         or v-h-action = integer('1':U)
      154         then do:
      155           if temp >= 0 then do:
      156             loc-action = v-h-action .
      157             if v-h-action = integer('1':U) then do:
      158               define variable v-rid as recid no-undo .
      159               if obj-type = 'орг':U then do:
      160                 run ref/firm1.p (
      161                               input v_pp
      162                               ,input-output v-rid
      163                               ,input 'ДОБАВЛЕНИЕ-ИМПОРТ':U
      164                               ,input v-callpoint
      165                               ,input yes
      166                               ,input - buft_firm_.firm-code
      167                               ,input buft_clients_.stts
      168                               ,input buft_clients_.obj-name
      169                               ,input buft_clients_.lim-kr
      170                               ,input buft_clients_.PS
      171                               ,input buft_clients_.grp-code
      172                               ,input buft_firm_.addres1
      173                               ,input buft_firm_.addres2
      174                               ,input buft_firm_.city
      175                               ,input buft_firm_.contact-psn
      176                               ,input buft_firm_.director
      177                               ,input buft_firm_.e-mail
      178                               ,input buft_firm_.engl-name
      179                               ,input buft_firm_.fax
      180                               ,INPUT buft_firm_.given-by
      181                               ,input buft_firm_.ind
      182                               ,input buft_firm_.inn
      183                               ,INPUT yes
      184                               ,INPUT buft_firm_.is-pboul
      185                               ,input buft_firm_.kpp
      186                               ,input buft_firm_.okonh
      187                               ,input buft_firm_.okpo
      188                               ,INPUT buft_firm_.passp-num
      189                               ,INPUT buft_firm_.passp-ser
      190                               ,input buft_firm_.phone
      191                               ,input buft_firm_.phone1-note
      192                               ,input buft_firm_.post-addr1
      193                               ,input buft_firm_.post-addr2
      194                               ,input buft_firm_.post-city
      195                               ,input buft_firm_.post-ind
      196                               ,input buft_clients_.reg-code
      197                               ,input buft_firm_.telex
      198                               ,input buft_firm_.tobj-code
      199                               ,input buft_clients_.turnover-buyer
      200                               ,input buft_clients_.turnover-buyer-gds
      201                 ) no-error .
      202               end.
      203               if obj-type = 'чел':U then do:
      204                 run ref/person1.p (
      205                               input v_pp
      206                             ,input v_ph
      207                             ,input-output v-rid
      208                             ,input 'ДОБАВЛЕНИЕ-ИМПОРТ':U
      209                             ,input v-callpoint
      210                             ,input yes
      211                             ,input - buft_person_.psn-code
      212                             ,input buft_clients_.stts
      213                             ,input buft_clients_.obj-name
      214                             ,input buft_clients_.lim-kr
      215                             ,input buft_clients_.PS
      216                             ,input buft_clients_.grp-code
      217                             ,input buft_person_.address
      218                             ,input buft_person_.city
      219                             ,input buft_person_.date-birth
      220                             ,input buft_person_.e-mail
      221                             ,input buft_person_.fax
      222                             ,input buft_person_.firm-code
      223                             ,input buft_person_.firm-name
      224                             ,input buft_person_.gender
      225                             ,input buft_person_.given-by
      226                             ,input buft_person_.ind
      227                             ,input buft_person_.inn
      228                             ,input yes
      229                             ,input buft_person_.is-pboul
      230                             ,input buft_person_.kpp
      231                             ,input buft_person_.name1
      232                             ,input buft_person_.name2
      233                             ,input buft_person_.okonh
      234                             ,input buft_person_.okpo
      235                             ,input buft_person_.passp-num
      236                             ,input buft_person_.passp-ser
      237                             ,input buft_person_.phone1
      238                             ,input buft_person_.phone1-note
      239                             ,input buft_person_.position
      240                             ,input buft_person_.post-box
      241                             ,input buft_person_.post-address
      242                             ,input buft_person_.post-city
      243                             ,input buft_person_.post-ind
      244                             ,input buft_clients_.reg-code
      245                             ,input buft_clients_.turnover-buyer
      246                             ,input buft_clients_.turnover-buyer-gds
      247                             ) no-error .
      248               end.
      249               if error-status:error then do:
      250                 run set-error in v_gc (substitute("Ошибка при создании клиента с типом &1:&2&3&2&4"
      251                                       , obj-type
      252                                       , chr(10)
      253                                       , error-status:get-message(1)
      254                                       , return-value
      255                                       )).
      256                 return no.
      257               end.
      258               assign
      259               glog =  v_bh:find-first( substitute('where recid(buf_clients_) = &1', v-rid), lock, wait) no-error .
      260               if not glog then do:
      261                 run set-error in v_gc (substitute("Ошибка при создании клиента с типом &1:&2не найден Клиент с recid &3"
      262                                       , obj-type
      263                                       , chr(10)
      264                                       , string(v-rid)
      265                                       )).
      266                 return no.
      267               end.
      268               assign
      269               obj-code = buf_clients_.obj-code
      270               buft_clients_.obj-code = obj-code
      271               v-h-action = integer('2':U).
      272               if available buft_person_ then do:
      273                  buft_person_.psn-code = obj-code.
      274               end.
      275               if available buft_firm_ then do:
      276                  buft_firm_.firm-code = obj-code.
      277               end.
      278               if obj-type = 'орг':U then do:
      279                 assign
      280                 glog =  v_bfh:find-first( substitute('where buf_firm_.firm-code = &1', obj-code), lock, wait) no-error .
      281                 if not glog then do:
      282                   run set-error in v_gc (substitute("Ошибка при создании клиента с типом &1:&2не найдена &1 с кодом &3"
      283                                         , obj-type
      284                                         , chr(10)
      285                                         , obj-code
      286                                         )).
      287                   return no.
      288                 end.
      289               end.
      290               if obj-type = 'чел':U then do:
      291                 assign
      292                 glog =  v_bph:find-first( substitute('where buf_person_.psn-code = &1', obj-code), lock, wait) no-error .
      293                 if not glog then do:
      294                   run set-error in v_gc (substitute("Ошибка при создании клиента с типом &1:&2не найден &1 с кодом &3"
      295                                         , obj-type
      296                                         , chr(10)
      297                                         , obj-code
      298                                         )).
      299                   return no.
      300                 end.
      301               end.
      302               glog = v_bh:buffer-copy( v_tbh).
      303               run clientsh_send-clients-rul in v_gc ( buffer buf_clients_
      304                                                     ,input loc-action).
      305               if obj-type = 'орг':U then do:
      306                 glogf = v_tbfh:buffer-copy( v_bfh).
      307                 run clientsh_send-firm-rul in v_gc ( buffer buf_firm_
      308                                                     ,input loc-action).
      309               end.
      310               if obj-type = 'чел':U then do:
      311                 glogp = v_tbph:buffer-copy( v_bph).
      312                 run clientsh_send-person-rul in v_gc ( buffer buf_person_
      313                                                       ,input loc-action).
      314               end.
      315             end.
      316             else do:
      317               if glog then do:
      318                 run clientsh_write-clients-rul in v_gc ( buffer buf_clients_
      319                                                         ,input loc-action).
      320                 glog = v_bh:buffer-copy( v_tbh).
      321                 run clientsh_send-clients-rul in v_gc ( buffer buf_clients_
      322                                                       ,input loc-action).
      323                 v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U.
      324                 glog = v_bh:buffer-release() no-error .
      325                 if error-status:error then do:
      326                   undo, return error substitute( "&1. &2&3&4", vss-include-info0 , return-value, chr(10), error-status :get-message (1)).
      327                 end.
      328               end.
      329               if glogf and obj-type = 'орг':U then do:
      330                 run clientsh_write-firm-rul in v_gc (
      331                                                         buffer buf_firm_
      332                                                         ,input loc-action).
      333                 glogf = v_bfh:buffer-copy( v_tbfh).
      334                 run clientsh_send-firm-rul in v_gc ( buffer buf_firm_
      335                                                     ,input loc-action).
      336                 v_bfh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      337                 glogf = v_bfh:buffer-release() no-error .
      338                 if error-status:error then do:
      339                   undo, return error substitute( "&1. &2&3&4", vss-include-info0 , return-value, chr(10), error-status :get-message (1)).
      340                 end.
      341               end.
      342               if glogp and obj-type = 'чел':U then do:
      343                 run clientsh_write-person-rul in v_gc (
      344                                                         buffer buf_person_
      345                                                         ,input loc-action).
      346                 glogp = v_bph:buffer-copy( v_tbph).
      347                 run clientsh_send-person-rul in v_gc ( buffer buf_person_
      348                                                       ,input loc-action).
      349                 v_bph:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      350                 glogp = v_bph:buffer-release() no-error .
      351                 if error-status:error then do:
      352                   undo, return error substitute( "&1. &2&3&4", vss-include-info0 , return-value, chr(10), error-status :get-message (1)).
      353                 end.
      354               end.
      355             end.
      356           end.
      357           if temp < 0 then do:
      358             run tempcont_create-changes in v_cnt (
      359                                            input 'clients':U
      360                                           ,input v_bh
      361                                           ,input v_tbh
      362                                           ,input v-h-action
      363                                           ) no-error.
      364             if error-status:error then do:
      365               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      366             end.
      367             if obj-type = 'орг':U then do:
      368               run tempcont_create-changes in v_cnt (
      369                                               input 'firm':U
      370                                              ,input v_bfh
      371                                              ,input v_tbfh
      372                                              ,input v-h-action
      373                                              ) no-error.
      374               if error-status:error then do:
      375                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      376               end.
      377             end.
      378             if obj-type = 'чел':U then do:
      379               run tempcont_create-changes in v_cnt (
      380                                               input 'person':U
      381                                              ,input v_bph
      382                                              ,input v_tbph
      383                                              ,input v-h-action
      384                                              ) no-error.
      385               if error-status:error then do:
      386                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      387               end.
      388             end.
      389           end.
      390         end.
      391       end.
      392       return yes.
      393     end method.
      394     method public logical find_clients_ ( p-obj-type as character, p-obj-code as integer):
      395      define variable glog as logical no-undo .
      396      define variable glogf as logical no-undo .
      397      define variable glogp as logical no-undo .
      398       clients_release_().
      399       clear_().
      400       if p-obj-code <> 0 then do:
      401         v-h-action           = integer('2':U).
      402         assign
      403         glog =  v_bh:find-first( substitute('where obj-type = "&1" and obj-code = &2', p-obj-type, p-obj-code), lock, wait) no-error .
      404         if not glog then do:
      405           if lock = No-LOCK then do:
      406             if find_no-error then do:
      407               return no.
      408             end.
      409             else do:
      410               return error substitute("Не найден клиент &1&2", p-obj-type, p-obj-code).
      411             end.
      412           end.
      413           if wait = NO-WAIT
      414           and v_bh:locked then do:
      415             if find_no-error then do:
      416               return no.
      417             end.
      418             else do:
      419               return error substitute("Клиент &1&2 занят", p-obj-type, p-obj-code).
      420             end.
      421           end.
      422         end.
      423         if v_tbh:available then
      424         glog = v_tbh:buffer-create().
      425         if v_tbfh:available then
      426           glogf = v_tbfh:buffer-delete() no-error .
      427         if v_tbph:available then
      428         glogp = v_tbph:buffer-delete() no-error .
      429         if p-obj-type  = 'орг':U then do:
      430           assign
      431           glogf =  v_bfh:find-first( substitute('where firm-code = &1', p-obj-code), lock, wait) no-error .
      432         end.
      433         if p-obj-type  = 'чел':U then do:
      434           assign
      435           glogp =  v_bph:find-first( substitute('where psn-code = &1', p-obj-code), lock, wait) no-error .
      436         end.
      437         glogf = v_tbfh:buffer-create().
      438         glogp = v_tbph:buffer-create().
      439         assign
      440         v-h-action           = integer('2':U)
      441         obj-type             = buf_clients_.obj-type
      442         obj-code             = buf_clients_.obj-code
      443         obj-name             = buf_clients_.obj-name
      444         PS                   = buf_clients_.ps
      445         grp-code             = buf_clients_.grp-code
      446         stts                 = buf_clients_.stts
      447         .
      448         glog = v_tbh:buffer-copy( v_bh).
      449         if obj-type = 'орг':U then do:
      450           glogf = v_tbfh:buffer-copy( v_bfh).
      451           assign
      452           phone       = buft_firm_.phone
      453           .
      454         end.
      455         if obj-type = 'чел':U then do:
      456           glogp = v_tbph:buffer-copy( v_bph).
      457           assign
      458           phone = buft_person_.phone1
      459           name1 = buft_person_.name1
      460           name2 = buft_person_.name2
      461           .
      462         end.
      463       end.
      464       return yes.
      465     end method.
      466     method public logical create_clients_ (
      467                                                input p-obj-type as character
      468                                               ,input p-obj-code as integer
      469                                               ,input p-obj-name as character
      470                                               ,input p-grp-code as integer
      471                                               ):
      472       define variable glog as logical no-undo .
      473       define variable glogf as logical no-undo .
      474       define variable glogp as logical no-undo .
      475       DEFINE VARIABLE v-today as date no-undo .
      476       DEFINE VARIABLE v-time as integer no-undo .
      477       define buffer buf_clients for ub.clients.
      478       define buffer buf_cli-grp  for ub.cli-grp.
      479       define buffer buf2_cli-grp  for ub.cli-grp.
      480       if p-obj-type <> 'орг':U
      481       and p-obj-type <> 'чел':U then do:
      482         run set-error in v_gc (substitute("Нельзя создать клиента с типом &1", p-obj-type)).
      483         return no.
      484       end.
      485       find first buf_cli-grp no-lock where
      486                 buf_cli-grp.node-code = p-grp-code no-error.
      487       if not available buf_cli-grp then do:
      488         run set-error in v_gc (substitute("Неверно задана группа клиента - нет группы с вн.кодом &1", p-grp-code)).
      489         return no.
      490       end.
      491       find first buf2_cli-grp no-lock where
      492                buf2_cli-grp.upper-code = buf_cli-grp.node-code no-error.
      493       if available buf2_cli-grp then do:
      494         run set-error in v_gc (substitute("Неверно задана группа клиента -  группа с вн.кодом &1 - нетерминальная", p-grp-code)).
      495         return no.
      496       end.
      497       find first buf_clients no-lock where
      498                buf_clients.obj-type = p-obj-type
      499            and buf_clients.obj-code = p-obj-code no-error.
      500       if available buf_clients then do:
      501         return no.
      502       end.
      503       glog = v_tbh:buffer-create().
      504       if p-obj-type = 'орг':U then do:
      505         glogf = v_tbfh:buffer-create().
      506       end.
      507       if p-obj-type = 'чел':U then do:
      508         glogp = v_tbph:buffer-create().
      509       end.
      510       assign
      511       obj-type                        = p-obj-type
      512       obj-code                        = p-obj-code
      513       obj-name                        = p-obj-name
      514       grp-code                        = p-grp-code
      515       buft_clients_.obj-type          = obj-type
      516       buft_clients_.obj-code          = obj-code
      517       buft_clients_.obj-name          = obj-name
      518       v-h-action                      = integer('1':U)
      519       .
      520       if p-obj-type = 'орг':U then do:
      521         assign
      522         buft_firm_.firm-code = obj-code
      523         .
      524       end.
      525       if p-obj-type = 'чел':U then do:
      526         assign
      527         buft_person_.psn-code = obj-code
      528         .
      529       end.
      530       if obj-code > 0 then do:
      531         run create_clients_ in v_gc ( input obj-type, input obj-code) no-error .
      532       end.
      533       return yes.
      534     end method.
      535     method public override character ToString( ):
      536       return substitute("&1&2", obj-type, obj-code).
      537     end method.
      538     method protected void clear_():
      539       define variable glog as logical no-undo .
      540       define variable glogf as logical no-undo .
      541       define variable glogp as logical no-undo .
      542       v-error-flag = no.
      543       if v_tbh:available then
      544       glog = v_tbh:buffer-delete() no-error .
      545       if obj-type  = 'орг':U then do:
      546         if v_tbfh:available then
      547         glogf = v_tbfh:buffer-delete() no-error .
      548       end.
      549       if obj-type = 'чел':U then do:
      550         if v_tbph:available then
      551         glogp = v_tbph:buffer-delete() no-error .
      552       end.
      553       assign
      554       obj-type = ''
      555       obj-code = 0
      556       v-h-action = 0
      557       .
      558     end method.
      559   end class.
