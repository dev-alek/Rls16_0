        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Dis-card-sale_obj:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-card-sale_obj.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_lh as widget-handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define public variable v_tbh as handle no-undo.
       10     define private variable v-error-flag as logical no-undo.
       11     define public variable gds-dis-base as decimal no-undo .
       12     define public variable gds-dis-rubl as decimal no-undo .
       13     define public variable gds-tot-b0 as decimal   no-undo .
       14     define public variable gds-tot-base as decimal no-undo .
       15     define public variable gds-tot-r0 as decimal   no-undo .
       16     define public variable gds-tot-rubl as decimal no-undo .
       17     define public variable num-chk as integer      no-undo .
       18     define public variable pay-tot-base as decimal no-undo .
       19     define public variable pay-tot-rubl as decimal no-undo .
       20     define public variable obj-code as integer no-undo.
       21     define public variable obj-type as character no-undo.
       22     define public variable host-code as integer no-undo.
       23     define public variable d-card as character no-undo .
       24     define public variable sale-doc as character no-undo.
       25     define public variable doc-date as date no-undo.
       26     define public variable base-code as integer no-undo.
       27     define public variable type as character no-undo.
       28     define public variable emitent-host-code as integer no-undo.
       29     define public variable cli-type as character no-undo.
       30     define public variable cli-code as integer no-undo.
       31     define public variable sale-type as character no-undo.
       32     define public variable action as integer no-undo.
       33     define protected variable codex_id as integer no-undo.
       34     define protected variable ruleset_id as integer no-undo.
       35     define private variable v-h-action as integer no-undo .
       36     CONSTRUCTOR PUBLIC dis-card-sale_obj(
       37                                          input parparentproc as widget-handle
       38                                         ,input p-parent-handle as handle
       39                                         ,input p-log-handle as handle
       40                                         ,input p-gc-handle as handle
       41                                         ,input p-tbh as handle
       42                                         ,input p-codex-id as integer
       43                                         ,input p-ruleset-id as integer
       44                                         ):
       45       define variable glog as logical no-undo .
       46       run garbcoll_create-gc-entry in p-gc-handle (input "dis-card-sale_obj",  input this-object) no-error.
       47       if error-status:error then do:
       48         message error-status:get-message(1) view-as alert-box .
       49         return error "Ошибка создания объекта итоги ДК по одной продаже".
       50       end.
       51       assign
       52       v_ph = p-parent-handle
       53       v_gc = p-gc-handle
       54       v_tbh = p-tbh
       55       d-card = '':U
       56       codex_id = p-codex-id
       57       ruleset_id = p-ruleset-id
       58       .
       59     end constructor.
       60     destructor public dis-card-sale_obj():
       61       find_dis-card-sale_obj ( input '':U).
       62     end destructor.
       63     method public handle get_dis-card-sale_obj ( ):
       64       return v_tbh.
       65     end method.
       66     method public logical set_dis-card-sale_obj ( input p-src-bh as handle):
       67       define variable glog as logical no-undo .
       68       if v_tbh:available = no then do:
       69         undo, return error substitute("В настоящий момент в буфере-приемнике нет записи").
       70       end.
       71       do transaction :
       72         assign
       73         glog = v_tbh:buffer-copy( p-src-bh, "d-card,obj-type,obj-code")
       74         no-error .
       75       end.
       76       if glog then  do:
       77         setfields_from_bh().
       78       end.
       79       return glog.
       80     end method.
       81     method public handle get_dis-card-sale_obj_field ( input p-field-name as character ):
       82       return v_tbh:buffer-field(p-field-name).
       83     end method.
       84     method public void Dis-card-sale_objrelease_ (  ):
       85       define variable glog as logical no-undo .
       86       do transaction :
       87         glog = v_tbh:buffer-release() no-error .
       88       end.
       89       clear_().
       90     end method.
       91     method public logical dis-card-sale_objsave ():
       92      define variable glog as logical no-undo .
       93      define variable v-rate as decimal no-undo .
       94      define buffer buf_curr-shop for ub.curr-shop.
       95      define buffer buf_curr-accnt for ub.curr-accnt.
       96      define buffer buf_dis-card for ub.dis-card.
       97       if d-card <> '':U then do:
       98           find first buf_dis-card no-lock where
       99                   buf_dis-card.d-card = d-card no-error.
      100           if not available buf_dis-card then do:
      101             run set-error in v_gc (substitute("Не найдена ДК для создания итогов по ДК(ДК &1 &2&3)"
      102                                               , d-card
      103                                               , obj-type
      104                                               , obj-code)).
      105             return no.
      106           end.
      107           if (pay-tot-base + pay-tot-rubl +
      108               gds-dis-base + gds-dis-rubl +
      109               gds-tot-base + gds-tot-rubl +
      110               num-chk) = ? then do:
      111             run set-error in v_gc (substitute("Не задано ( =  ?) значение одной из сумм или кол-во чеков для ДК &1 &2&3"
      112                                               , d-card
      113                                               , obj-type
      114                                               , obj-code
      115                                               )).
      116             return no.
      117           end.
      118           if (pay-tot-base = 0.0) <> (pay-tot-rubl = 0.0) then do:
      119             run set-error in v_gc (substitute("Если сумма оплат в нац.вал. = 0, то сумма оплат в баз.вал. тоже должна = 0 и наборот (ДК &1 &2&3)"
      120                                               , d-card
      121                                               , obj-type
      122                                               , obj-code)).
      123             return no.
      124           end.
      125           if codex_id = 4 then do:
      126             if base-code = 0
      127             and pay-tot-base <> pay-tot-rubl then do:
      128               run set-error in v_gc (substitute("Баз.вал. фирмы = нац.вал. но сумма оплат в баз.вал. <> сумме оплат в нац.вал.(ДК &1 &2&3)"
      129                                                 , d-card
      130                                                 , obj-type
      131                                                 , obj-code)).
      132               return no.
      133             end.
      134             if doc-date = ? then do:
      135               run set-error in v_gc (substitute("Не задана дата итогов по ДК(ДК &1 &2&3)"
      136                                                 , d-card
      137                                                 , obj-type
      138                                                 , obj-code)).
      139               return no.
      140             end.
      141             if base-code <> 0 then do:
      142               if obj-type = 'маг':U then do:
      143                 find first buf_curr-shop no-lock where
      144                           buf_curr-shop.obj-type = 'маг':U
      145                       and buf_curr-shop.obj-code = obj-code
      146                       and buf_curr-shop.curr-code = base-code
      147                       and buf_curr-shop.exch-date <= doc-date no-error .
      148                 if not available buf_curr-shop then do:
      149                   run set-error in v_gc (substitute("Невозможно определить курс для баз. вал. на день импорта итогов по ДК(ДК &1 &2&3 код.баз.вал. &4 )"
      150                                                     , d-card
      151                                                     , obj-type
      152                                                     , obj-code
      153                                                     , base-code
      154                                                     , doc-date
      155                                                     )).
      156                   return no.
      157                 end.
      158                 v-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale.
      159               end.
      160               else do:
      161                 find first buf_curr-accnt no-lock where
      162                         buf_curr-accnt.curr-code = base-code
      163                       and buf_curr-accnt.exch-date <= doc-date no-error .
      164                 if not available buf_curr-accnt then do:
      165                   run set-error in v_gc (substitute("Невозможно определить курс для баз. вал. на день импорта итогов по ДК(ДК &1 &2&3 код.баз.вал. &4 )"
      166                                                     , d-card
      167                                                     , obj-type
      168                                                     , obj-code
      169                                                     , base-code
      170                                                     , doc-date
      171                                                     )).
      172                   return no.
      173                 end.
      174                 v-rate = buf_curr-accnt.exch-rate / buf_curr-accnt.exch-scale.
      175               end.
      176               if ((pay-tot-base = pay-tot-rubl
      177               and v-rate <> 0 )
      178               or pay-tot-base * v-rate / pay-tot-rubl > 1.5
      179               or pay-tot-base * v-rate / pay-tot-rubl < 0.5)
      180               and
      181               not (pay-tot-base = 0 and pay-tot-rubl = 0)
      182               then do:
      183                 run set-error in v_gc (substitute("Суммы итогов указаны неверно: сумма в баз.вал. не совпадает с рассчитанной по курсу в пределах погрешности&6(ДК &1 &2&3 код.баз.вал. &4 )"
      184                                                   , d-card
      185                                                   , obj-type
      186                                                   , obj-code
      187                                                   , base-code
      188                                                   , doc-date
      189                                                   , chr(10)
      190                                                   )).
      191                 return no.
      192               end.
      193             end.
      194           end.
      195           assign
      196           v_tbh:buffer-field("gds-dis-base"):buffer-value  = gds-dis-base
      197           v_tbh:buffer-field("gds-dis-rubl"):buffer-value  = gds-dis-rubl
      198           v_tbh:buffer-field("gds-tot-base"):buffer-value  = gds-tot-base
      199           v_tbh:buffer-field("gds-tot-rubl"):buffer-value  = gds-tot-rubl
      200           v_tbh:buffer-field("pay-tot-base"):buffer-value  = pay-tot-base
      201           v_tbh:buffer-field("pay-tot-rubl"):buffer-value  = pay-tot-rubl
      202           v_tbh:buffer-field("gds-tot-b0"):buffer-value    = gds-tot-b0
      203           v_tbh:buffer-field("gds-tot-r0"):buffer-value    = gds-tot-r0
      204           v_tbh:buffer-field("num-chk"):buffer-value       = num-chk
      205           v_tbh:buffer-field("type"):buffer-value          = type
      206           v_tbh:buffer-field("emitent-host-code"):buffer-value = emitent-host-code
      207           v_tbh:buffer-field("cli-type"):buffer-value      = cli-type
      208           v_tbh:buffer-field("cli-code"):buffer-value      = cli-code
      209           v_tbh:buffer-field("sale-type"):buffer-value      = sale-type
      210           v_tbh:buffer-field("obj-type"):buffer-value      = obj-type
      211           v_tbh:buffer-field("obj-code"):buffer-value      = obj-code
      212           .
      213           if codex_id = 4 then do:
      214             run 00040000_set-vpay-chk in v_gc( input v_tbh) no-error.
      215           end.
      216           if not error-status :error then do:
      217             glog = yes.
      218           end.
      219       end.
      220       return glog.
      221     end method.
      222     method public logical find_dis-card-sale_obj_no-error ( p-d-card as character):
      223       define variable glog as logical no-undo .
      224       glog = find_dis-card-sale_obj( input p-d-card, input '':U, input 0) no-error .
      225       if error-status:error then return no .
      226       return glog.
      227     end method.
      228     method public logical find_dis-card-sale_obj ( p-d-card as character):
      229       define variable glog as logical no-undo .
      230       glog = find_dis-card-sale_obj( input p-d-card, input '':U, input 0) no-error .
      231       if error-status:error then return error return-value .
      232       return glog.
      233     end method.
      234     method public logical find_dis-card-sale_obj ( p-d-card as character, p-obj-type as character, p-obj-code as integer):
      235      define variable glog as logical no-undo .
      236      define variable v-rate as decimal no-undo .
      237      define buffer buf_curr-shop for ub.curr-shop.
      238      define buffer buf_curr-accnt for ub.curr-accnt.
      239      define buffer buf_dis-card for ub.dis-card.
      240       dis-card-sale_objrelease_().
      241       clear_().
      242       if p-d-card <> '':U then do:
      243         v-h-action = integer('2':U).
      244         if p-obj-type = '':U
      245         or p-obj-code = 0 then do:
      246           assign
      247           glog =  v_tbh:find-first( substitute('where d-card = "&1"'
      248                                   , p-d-card)
      249                                   ) no-error .
      250         end.
      251         else do:
      252           assign
      253           glog =  v_tbh:find-first( substitute('where d-card = "&1" and obj-type = "&2" and obj-code = &3'
      254                                   , p-d-card
      255                                   ,p-obj-type
      256                                   ,p-obj-code
      257                                   )
      258                                   ) no-error .
      259         end.
      260         if not glog then do:
      261           return error substitute("Не найдены итоги по ДК &1 по продаже", p-d-card).
      262         end.
      263         assign
      264         v-h-action = integer('2':U)
      265         .
      266         setfields_from_bh ().
      267       end.
      268       return glog.
      269     end method.
      270     method private void setfields_from_bh ():
      271         assign
      272         gds-dis-base         = v_tbh:buffer-field("gds-dis-base"):buffer-value
      273         gds-dis-rubl         = v_tbh:buffer-field("gds-dis-rubl"):buffer-value
      274         gds-tot-base         = v_tbh:buffer-field("gds-tot-base"):buffer-value
      275         gds-tot-rubl         = v_tbh:buffer-field("gds-tot-rubl"):buffer-value
      276         gds-tot-b0           = v_tbh:buffer-field("gds-tot-b0"):buffer-value
      277         gds-tot-r0           = v_tbh:buffer-field("gds-tot-r0"):buffer-value
      278         pay-tot-base         = v_tbh:buffer-field("pay-tot-base"):buffer-value
      279         pay-tot-rubl         = v_tbh:buffer-field("pay-tot-rubl"):buffer-value
      280         num-chk              = v_tbh:buffer-field("num-chk"):buffer-value
      281         d-card               = v_tbh:buffer-field("d-card"):buffer-value
      282         sale-doc             = v_tbh:buffer-field("sale-doc"):buffer-value
      283         doc-date             = v_tbh:buffer-field("doc-date"):buffer-value
      284         base-code            = v_tbh:buffer-field("base-code"):buffer-value
      285         obj-code             = v_tbh:buffer-field("obj-code"):buffer-value
      286         obj-type             = v_tbh:buffer-field("obj-type"):buffer-value
      287         type                 = v_tbh:buffer-field("type"):buffer-value
      288         emitent-host-code    = v_tbh:buffer-field("emitent-host-code"):buffer-value
      289         cli-type             = v_tbh:buffer-field("cli-type"):buffer-value
      290         cli-code             = v_tbh:buffer-field("cli-code"):buffer-value
      291         sale-type            = v_tbh:buffer-field("sale-type"):buffer-value
      292         action               = v_tbh:buffer-field("action"):buffer-value
      293         .
      294     end.
      295     method public logical create_dis-card-sale_obj ( input p-d-card as character
      296                                                ,input p-obj-type as character
      297                                                ,input p-obj-code as integer
      298                                                ,input p-doc-code as character
      299                                                ,input p-doc-date as date
      300                                                ):
      301       define variable glog as logical no-undo .
      302       define buffer buf_clients for ub.clients.
      303       define buffer buf_dis-card for ub.dis-card.
      304       define buffer buf_sysconf for ub.sysconf.
      305       find first buf_clients no-lock where
      306                 buf_clients.obj-type = p-obj-type
      307             and buf_clients.obj-code = p-obj-code no-error.
      308       if not available buf_clients
      309       or not (p-obj-type = 'маг':U or p-obj-type = 'скл':U)
      310       then do:
      311         run set-error in v_gc (substitute("Неверно задан объект для создания итогов по ДК(ДК &1 &2&3)"
      312                                           , d-card
      313                                           , p-obj-type
      314                                           , p-obj-code)).
      315         return no.
      316       end.
      317       find first buf_sysconf no-lock where
      318                 buf_sysconf.host-code = buf_clients.host-code no-error.
      319       if not available buf_clients then do:
      320         run set-error in v_gc (substitute("Неверно задан объект для создания итогов по ДК - не найдена фирма &4(ДК &1 &2&3)"
      321                                           , d-card
      322                                           , p-obj-type
      323                                           , p-obj-code
      324                                           , buf_clients.host-code
      325                                           )).
      326         return no.
      327       end.
      328       find first buf_Dis-card no-lock where
      329                 buf_Dis-card.d-card = p-d-card no-error.
      330       if not available buf_dis-card then do:
      331         glog = no.
      332         run can-find_dis-card_ in v_gc ( input p-d-card
      333                                         ,output glog) no-error .
      334         if not glog then do:
      335           run set-error in v_gc (substitute("Неверно задана ДК для создания итогов по ДК(ДК &1 &2&3)"
      336                                           , d-card
      337                                           , p-obj-type
      338                                           , p-obj-code
      339                                             )).
      340           return no.
      341         end.
      342       end.
      343       do transaction :
      344         glog = v_tbh:buffer-create( ).
      345       end.
      346       assign
      347       d-card = p-d-card
      348       v-h-action = integer('1':U)
      349       host-code            = buf_clients.host-code
      350       base-code            = buf_sysconf.base-code
      351       obj-type             = p-obj-type
      352       obj-code             = p-obj-code
      353       sale-doc             = p-doc-code
      354       doc-date             = p-doc-date
      355       sale-type            = '':U
      356       v_tbh:buffer-field("d-card"):buffer-value = d-card
      357       v_tbh:buffer-field("host-code"):buffer-value = host-code
      358       v_tbh:buffer-field("base-code"):buffer-value = base-code
      359       v_tbh:buffer-field("obj-type"):buffer-value = obj-type
      360       v_tbh:buffer-field("obj-code"):buffer-value = obj-code
      361       v_tbh:buffer-field("sale-doc"):buffer-value = sale-doc
      362       v_tbh:buffer-field("doc-date"):buffer-value = doc-date
      363       v_tbh:buffer-field("sale-type"):buffer-value = sale-type
      364       gds-dis-base         = 0.0
      365       gds-dis-rubl         = 0.0
      366       gds-tot-base         = 0.0
      367       gds-tot-rubl         = 0.0
      368       gds-tot-b0           = 0.0
      369       gds-tot-r0           = 0.0
      370       pay-tot-base         = 0.0
      371       pay-tot-rubl         = 0.0
      372       num-chk              = 0
      373       action               = 0
      374       type                 = (if available buf_Dis-card
      375                               then buf_Dis-card.type
      376                               else '')
      377       emitent-host-code    = (if available buf_Dis-card
      378                               then buf_Dis-card.emitent-host-code
      379                               else 0)
      380       cli-type             = (if available buf_Dis-card
      381                               then buf_Dis-card.cli-type
      382                               else '')
      383       cli-code             = (if available buf_Dis-card
      384                               then buf_Dis-card.cli-code
      385                               else 0)
      386       v_tbh:buffer-field("emitent-host-code"):buffer-value = emitent-host-code
      387       v_tbh:buffer-field("type"):buffer-value = type
      388       v_tbh:buffer-field("cli-type"):buffer-value = cli-type
      389       v_tbh:buffer-field("cli-code"):buffer-value = cli-code
      390       .
      391       return yes.
      392     end method.
      393     method protected void clear_():
      394       define variable glog as logical no-undo .
      395       v-error-flag = no.
      396       assign
      397       d-card = ''
      398       v-h-action = 0
      399       .
      400     end method.
      401     method public override character ToString( ):
      402       return substitute("&1 &2", d-card, sale-doc).
      403     end method.
      404   method public logical esys-add-dump (
      405                                             input p-esys-cmd-proc-handle as handle
      406                                           , input p-esys-cmd-code as integer
      407                                           , input p-action as character     ):
      408     define variable v-esys-rec-ord as integer no-undo .
      409     run add-dump in p-esys-cmd-proc-handle
      410       (input p-esys-cmd-code
      411       ,input 'dis-host':U
      412       ,input p-action
      413       ,input v_tbh
      414       ,input '':U
      415       ,output v-esys-rec-ord
      416       ) no-error .
      417     if error-status :error
      418     then do:
      419       delete procedure p-esys-cmd-proc-handle .
      420       run set-error in v_gc (substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
      421                                           ,chr(10)
      422                                           ,'dis-host':U
      423                                           ,p-esys-cmd-code
      424                                           ,error-status:get-message(1)
      425                                           ,return-value
      426                                           )) .
      427       return no.
      428     end.
      429     return yes.
      430   end method.
      431   end class.
