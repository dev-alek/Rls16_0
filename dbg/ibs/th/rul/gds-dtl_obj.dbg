       89     CONSTRUCTOR PUBLIC gds-dtl_obj(
       90                                  input parparentproc as widget-handle
       91                                 ,input p-parent-handle as handle
       92                                 ,input p-log-handle as handle
       93                                 ,input p-gc-handle as handle
       94                                 ,input p-cont-handle as handle
       95                                 ,input p-lock as integer
       96                                 ,input p-wait as integer
       97                                 ,input p-temp as integer
       98                               ):
       99   define variable glog as logical no-undo .
      100   assign
      101   v_pp = parparentproc
      102   v_lh = p-log-handle
      103   v_ph = p-parent-handle
      104   v_gc = p-gc-handle
      105   v_cnt = p-cont-handle
      106   lock = p-lock
      107   wait = p-wait
      108   temp = p-temp
      109   .
      110   run garbcoll_create-gc-entry in p-gc-handle (input 'gds-dtl_obj',  input this-object) no-error.
      111   if error-status:error then do:
      112     return error substitute("&1 ќшибка создани€ объекта gds-dtl_obj", vss-include-info0).
      113   end.
      114   v_bh = buffer buf_gds-dtl_obj:handle.
      115   v_tbh = buffer buft_gds-dtl_obj:handle.
      116       assign
      117       doc-code = '':U
      118       artic = '':U
      119       prod-type = '':U
      120       prod-code = 0
      121       prt-code = 0
      122       .
      123       v_qh = query query_gds-dtl_obj:handle.
      124       v_bdh = buffer buf_trn-doc_obj:handle.
      125       v_tbdh = buffer buft_trn-doc_obj:handle.
      126       v_bbh = buffer buf_bar-code_:handle.
      127       v_bgh = buffer buf_goods_:handle.
      128       v_tbbh = buffer buft_bar-code_:handle.
      129   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      130   if (valid-handle(g#library) <> true) then do:   run library-cls_get-handle in v_gc ( input "library", output g#library) no-error.   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      131     (output v-curr-r-b
      132     )  .
      133     end constructor.
      134     destructor public gds-dtl_obj():
      135       define variable glog as logical no-undo .
      136       assign
      137       glog = v_tbh:empty-temp-table() no-error .
      138       assign
      139       glog = v_tbdh:empty-temp-table() no-error .
      140       assign
      141       glog = v_tbbh:empty-temp-table() no-error .
      142       find_gds-dtl_obj ( input '':U, input '':U, input '':U, input 0, input 0).
      143     end destructor.
      144     method public logical find_gds-dtl_obj ( p-doc-code as character
      145                                            , p-artic as character
      146                                            , p-prod-type as character
      147                                            , p-prod-code as integer
      148                                            , p-prt-code as integer
      149                                            ):
      150      define variable glog as logical no-undo .
      151      gds-dtl_objrelease_().
      152      clear_().
      153       if p-doc-code <> '':U then do:
      154         assign
      155         glog =  v_bh:find-first( substitute('where doc-code = "&1" and artic = "&2" and prod-type = "&3" and prod-code = &4 '
      156                                             , p-doc-code
      157                                             , p-artic
      158                                             , p-prod-type
      159                                             , p-prod-code
      160                                             , p-prt-code
      161                                             ), lock, wait) no-error .
      162         if not glog then do:
      163           if find_no-error then do:
      164             return no.
      165           end.
      166           if lock = No-LOCK then do:
      167             if v_tbh:available then
      168             assign glog = v_tbh:buffer-delete() no-error .
      169             return error substitute("Ќе найдена строка накладной &1 &2 &3&4 (код признака &5)"
      170                                    , p-doc-code
      171                                    , p-artic
      172                                    , p-prod-type
      173                                    , p-prod-code
      174                                    , p-prt-code
      175                                    ).
      176           end.
      177           if wait = NO-WAIT
      178           and v_bh:locked then do:
      179             if v_tbh:available then
      180             assign glog = v_tbh:buffer-delete() no-error .
      181             if find_no-error then do:
      182               return no.
      183             end.
      184             else do:
      185               return error substitute("&2 &3&4 (код признака &5) строка накладной &1 зан€та"
      186                                      , p-doc-code
      187                                      , p-artic
      188                                      , p-prod-type
      189                                      , p-prod-code
      190                                      , p-prt-code
      191                                      ).
      192             end.
      193           end.
      194         end.
      195         if p-doc-code <> doc-code then do:
      196           assign
      197           glog =  v_bdh:find-first( substitute('where doc-code = "&1"'
      198                                               , p-doc-code
      199                                               ), lock, wait) no-error .
      200           if not glog then do:
      201             return error substitute("Ќе найдена накладна€ &1", p-doc-code).
      202           end.
      203         end.
      204         assign
      205         glog =  v_bgh:find-first( substitute('where artic = "&1" and prod-type = "&2" and prod-code = &3'
      206                                             , buf_gds-dtl_obj.artic
      207                                             , buf_gds-dtl_obj.prod-type
      208                                             , buf_gds-dtl_obj.prod-code
      209                                             ), no-lock, wait) no-error .
      210         if not glog then do:
      211           return error substitute("Ќе найден товар &1 &2&3 (код признака &4) дл€ строки накладной &5"
      212                                   , buf_gds-dtl_obj.artic
      213                                   , buf_gds-dtl_obj.prod-type
      214                                   , buf_gds-dtl_obj.prod-code
      215                                   , buf_gds-dtl_obj.prt-code
      216                                   ,p-doc-code
      217                                   ).
      218         end.
      219         assign
      220         doc-code             = buf_gds-dtl_obj.doc-code
      221         d-card#              = buf_trn-doc_obj.d-card
      222         artic                = buf_gds-dtl_obj.artic
      223         prod-type            = buf_gds-dtl_obj.prod-type
      224         prod-code            = buf_gds-dtl_obj.prod-code
      225         discnt-base          = buf_gds-dtl_obj.discnt-base
      226         price-base           = buf_gds-dtl_obj.price-base
      227         discnt-rubl          = buf_gds-dtl_obj.discnt-rubl
      228         price-rubl           = buf_gds-dtl_obj.price-rubl
      229         fact-qnty            = buf_gds-dtl_obj.fact-qnty
      230         prt-code             = buf_gds-dtl_obj.prt-code
      231         gds-code#            = buf_bar-code_.gds-code
      232         obj-type             = buf_gds-dtl_obj.obj-type
      233         obj-code             = buf_gds-dtl_obj.obj-code
      234         base-rate#           = buf_trn-doc_obj.base-rate
      235         base-scale#          = buf_trn-doc_obj.base-scale
      236         discnt-pc            = buf_gds-dtl_obj.discnt-pc
      237         discnt-type          = buf_gds-dtl_obj.discnt-type
      238         .
      239         glog = v_tbh:buffer-create( ).
      240         glog = v_tbh:buffer-copy( v_bh).
      241         glog = v_tbbh:buffer-create( ).
      242         glog = v_tbbh:buffer-copy( v_bbh).
      243         glog = v_tbdh:buffer-create( ).
      244         glog = v_tbdh:buffer-copy( v_bdh).
      245       end.
      246       return yes.
      247     end method.
      248     method public logical select_gds-dtl_obj ( input p-prepare-phrase-doc as character
      249                                                  , input p-prepare-phrase-gds as character):
      250       define variable glog as logical no-undo.
      251       assign
      252       glog = v_qh:query-prepare( substitute("for each bufq_gds-dtl_obj no-lock where &1, " +
      253                                                  "each bufq_gds-dtl_obj no-lock where " +
      254                                                   "bufq_gds-dtl_obj.doc-code = bufq_trn-doc_obj.doc-code and &2"
      255                                ,p-prepare-phrase-doc
      256                                ,p-prepare-phrase-gds)
      257                                ) no-error .
      258       if not glog then do:
      259         return error substitute("ќшибка подготовки выборки по строкам накладной:&1&2&1&3&1&4"
      260                                  , chr(10)
      261                                  , error-status:get-message(1)
      262                                  , p-prepare-phrase-doc
      263                                  , p-prepare-phrase-gds
      264                                  ).
      265       end.
      266       assign
      267       glog = v_qh:query-open no-error .
      268       if error-status:error then do:
      269         return error substitute("ќшибка открыти€ выборки по строкам накладной:&1&2&1&3"
      270                                  , chr(10)
      271                                  , error-status:get-message(1)
      272                                  , v_qh:prepare-string ).
      273       end.
      274     end method.
      275     method public logical get_gds-dtl_obj( input p-rec-pos as character):
      276       define variable glog as logical no-undo .
      277       if not v_qh:is-open then do:
      278         return error substitute("¬ыборка по строкам накладной:&1(&2)&1еще на открыта"
      279                                 , chr(10)
      280                                 , v_qh:prepare-string
      281                                  ).
      282       end.
      283       case p-rec-pos:
      284         when "first" then do:
      285           glog = v_qh:get-first(lock, wait)  .
      286         end.
      287         when "last" then do:
      288           glog = v_qh:get-last(lock, wait)  .
      289         end.
      290         when "next" then do:
      291           glog = v_qh:get-next(lock, wait)  .
      292         end.
      293         when "prev" then do:
      294           glog = v_qh:get-prev(lock, wait)  .
      295         end.
      296       end case.
      297       if glog then do:
      298          assign
      299          glog = find_gds-dtl_obj ( input bufq_gds-dtl_obj.doc-code
      300                                   ,input bufq_gds-dtl_obj.artic
      301                                   ,input bufq_gds-dtl_obj.prod-type
      302                                   ,input bufq_gds-dtl_obj.prod-code
      303                                   ,input bufq_gds-dtl_obj.prt-code
      304                                   ) no-error .
      305       end.
      306       return glog.
      307     end method.
      308     method public logical has_dis-rule( input  p-rule-num as integer):
      309       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      310       if doc-code = '':U
      311       or artic = '':U
      312       or prod-type = '':U
      313       or prod-code = 0
      314       then do:
      315         return error substitute("ќстутствует строка накладной").
      316       end.
      317       find first buf_dis-gds-rule no-lock where
      318                 buf_dis-gds-rule.gds-code = gds-code#
      319             and buf_dis-gds-rule.rule-num = p-rule-num no-error .
      320       return (available buf_dis-gds-rule).
      321     end method.
      322     method public logical run_dis-rule ( input p-rule-num as integer
      323                                              ,input p-discnt-role as character
      324                                              ,input p-pos-type as character
      325                                              ):
      326       define variable jj as integer no-undo .
      327       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      328   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   define variable v-ii as integer no-undo .
      330   define buffer buf_temp-call-param for temp-call-param.
      331   define buffer buf2_temp-call-param for temp-call-param.
      332   define buffer buf_drt-prop for ub.drt-prop.
      333       if doc-code = '':U
      334       or artic = '':U
      335       or prod-type = '':U
      336       or prod-code = 0  then do:
      337         return error substitute("ќстутствует строка док-та").
      338       end.
      339       do jj = 1 to 2:
      340         if jj = 1 then do:
      341           find first buf_dis-gds-rule no-lock where
      342                     buf_dis-gds-rule.gds-code = gds-code#
      343                 and (p-rule-num = 0 or buf_dis-gds-rule.rule-num = p-rule-num)
      344                 and (p-pos-type = '':U or buf_dis-gds-rule.pos-type = p-pos-type)
      345                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      346                 and buf_dis-gds-rule.obj-type = obj-type
      347                 and buf_dis-gds-rule.obj-code = obj-code
      348                 no-error .
      349         end.
      350         if jj = 2 then do:
      351           find first buf_dis-gds-rule no-lock where
      352                     buf_dis-gds-rule.gds-code = gds-code#
      353                 and (p-rule-num = 0 or buf_dis-gds-rule.rule-num = p-rule-num)
      354                 and (p-pos-type = '':U or buf_dis-gds-rule.pos-type = p-pos-type)
      355                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      356                 and buf_dis-gds-rule.obj-type = '':U
      357                 and buf_dis-gds-rule.obj-code = 0
      358                 no-error .
      359         end.
      360         if available buf_Dis-gds-rule then do:
      361   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   find first buf_temp-call-param where
      363           buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      364       and buf_temp-call-param.param-num = 0 no-error .
      365   if not available buf_temp-call-param then do:
      366     if v_gc:get-signature(substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))) = '':u then do:
      367       undo, return error substitute("ќпределение &1 отсутствует в &2"
      368                                      ,substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      369                                      , v_gc:file-name).
      370     end.
      371     create buf_temp-call-param.
      372     assign
      373     buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      374     buf_temp-call-param.param-number_ = 0
      375     .
      376     for each buf_drt-prop no-lock where
      377             buf_drt-prop.templ-rl-root = buf_dis-gds-rule.templ-rl-root
      378         and buf_drt-prop.upper-prop-code = "Call-params"
      379       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info5,  return-value, chr(10), error-status :get-message (1))
      380       on stop   undo , return error substitute( "&1. stop", vss-include-info5 )
      381       on endkey undo , return error substitute( "&1. endkey", vss-include-info5 ):
      382       if integer(buf_drt-prop.prop-code) = 0 then do:
      383         assign
      384         buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      385         buf_temp-call-param.param-number_ = integer(buf_drt-prop.prop-code)
      386         buf_temp-call-param.param-name_ = entry(1, buf_drt-prop.property-value)
      387         buf_temp-call-param.param-datatype_ = entry(2, buf_drt-prop.property-value)
      388         buf_temp-call-param.io-mode_ = entry(3, buf_drt-prop.property-value)
      389         buf_temp-call-param.param-label_ = entry(4, buf_drt-prop.property-value)
      390         .
      391       end.
      392       else do:
      393         create buf2_temp-call-param.
      394         assign
      395         v-ii = v-ii + 1
      396         buf2_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      397         buf2_temp-call-param.param-number_ = integer(buf_drt-prop.prop-code)
      398         buf2_temp-call-param.param-name_ = entry(1, buf_drt-prop.property-value)
      399         buf2_temp-call-param.param-datatype_ = entry(2, buf_drt-prop.property-value)
      400         buf2_temp-call-param.io-mode_ = entry(3, buf_drt-prop.property-value)
      401         buf2_temp-call-param.param-label_ = entry(4, buf_drt-prop.property-value)
      402         .
      403       end.
      404     end.
      405     assign
      406     buf_temp-call-param.num-params = v-ii
      407     .
      408   end.
      409           for each buf_temp-call-param where
      410                   buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      411           on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0,  return-value, chr(10), error-status :get-message (1))
      412           on stop   undo , return error substitute( "&1. stop", vss-include-info0 )
      413           on endkey undo , return error substitute( "&1. endkey", vss-include-info0 )
      414           :
      415             case buf_temp-call-param.param-name_:
      416               when "p-rule-num" then do:
      417                 assign
      418                 buf_temp-call-param.integer_ = p-rule-num
      419                 .
      420               end.
      421               when "p-date" then do:
      422                 assign
      423                 buf_temp-call-param.date_ = doc-date#
      424                 .
      425               end.
      426               when "p-time" then do:
      427                 assign
      428                 buf_temp-call-param.integer_ = doc-time#
      429                 .
      430               end.
      431               when "p-doc-qnty" then do:
      432                 assign
      433                 buf_temp-call-param.decimal_ = fact-qnty
      434                 .
      435               end.
      436               when "p-tot-sum" then do:
      437                 assign
      438                 buf_temp-call-param.decimal_ = fact-qnty * (if v-curr-r-b = 'rubl':U
      439                                                             then price-base
      440                                                             else price-rubl)
      441                 .
      442               end.
      443               when "p-grp-code" then do:
      444               end.
      445               when "p-dis-kat" then do:
      446               end.
      447             end case.
      448           end.
      449   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      450     find first buf_temp-call-param where
      451               buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      452           and buf_temp-call-param.param-number = 0.
      453     if not valid-handle(buf_temp-call-param.call-handle_) then do:
      454       create call buf_temp-call-param.call-handle_.
      455       assign
      456       buf_temp-call-param.call-handle_:call-name = buf_temp-call-param.call-name_
      457       buf_temp-call-param.call-handle_:call-type = FUNCTION-CALL-TYPE
      458       buf_temp-call-param.call-handle_:in-handle = v_gc
      459       buf_temp-call-param.call-handle_:num-parameters = buf_temp-call-param.num-params
      460       .
      461     end.
      462   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463     for each buf2_temp-call-param where
      464             buf2_temp-call-param.param-num > 0
      465     on error  undo , return error substitute( "&1. &2&3&4", vss-include-info7,  return-value, chr(10), error-status :get-message (1))
      466     on stop   undo , return error substitute( "&1. stop", vss-include-info7 )
      467     on endkey undo , return error substitute( "&1. endkey", vss-include-info7 ):
      468       buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
      469                                                       ,buf2_temp-call-param.param-datatype_
      470                                                       ,buf2_temp-call-param.io-mode
      471                                                       ,buffer buf2_temp-call-param:buffer-field( substitute("&1_", buf2_temp-call-param.param-datatype_)):buffer-value).
      472     end.
      473     assign
      474     buf_temp-call-param.call-number = buf_temp-call-param.call-number + 1
      475     v-last-call-number = buf_temp-call-param.call-number
      476     v-last-call-name = buf_temp-call-param.call-name_
      477     .
      478     buf_temp-call-param.call-handle_:invoke.
      479     assign
      480     buf_temp-call-param.param-datatype_ = buf_temp-call-param.call-handle_:return-value-data-type.
      481     case buf_temp-call-param.param-datatype_:
      482         when 'character':U then do:
      483           assign
      484           buf_temp-call-param.character_ = buf_temp-call-param.call-handle_:return-value.
      485         end.
      486         when 'date':U then do:
      487           assign
      488           buf_temp-call-param.date_ = buf_temp-call-param.call-handle_:return-value.
      489         end.
      490         when 'decimal':U then do:
      491           assign
      492           buf_temp-call-param.decimal_ = buf_temp-call-param.call-handle_:return-value.
      493         end.
      494         when 'integer':U then do:
      495           assign
      496           buf_temp-call-param.integer_ = buf_temp-call-param.call-handle_:return-value.
      497         end.
      498         when 'logical':U then do:
      499           assign
      500           buf_temp-call-param.logical_ = buf_temp-call-param.call-handle_:return-value.
      501         end.
      502     end case.
      503           RETURN  YES.
      504         end.
      505       end.
      506       return no.
      507     end method.
      508   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509     method public decimal get_dis-rule-value_decimal ( input p-param-name as character):
      510       define buffer buf_temp-call-param for temp-call-param.
