      629       return substitute("Ќакладна€ &1, товар &2 &3&4 (код признака &5)"
      630                         , doc-code
      631                         , artic
      632                         , prod-type
      633                         , prod-code
      634                         , prt-code
      635                         ).
      636     end method.
