      566     method protected void clear_():
      567       define variable glog as logical no-undo .
      568       v-error-flag = no.
      569       if v_tbh:available then
      570       glog = v_tbh:buffer-delete() no-error .
      571       if v_tbbh:available then
      572       glog = v_tbbh:buffer-delete() no-error .
      573       if v_tbdh:available then
      574       glog = v_tbdh:buffer-delete() no-error .
      575       if v_tbgh:available then
      576       glog = v_tbgh:buffer-delete() no-error .
      577       assign
      578       doc-code = ''
      579       artic = '':U
      580       prod-type = '':U
      581       prod-code = 0
      582       gds-code# = 0
      583       .
      584     end method.
      585      method public logical gds-dtl_obj_save ( ):
      586      define variable glog as logical no-undo .
      587      define variable loc-action  as integer no-undo .
      588      define buffer buf_dis-card for ub.dis-card.
      589       if artic <> '':U then do:
      590           assign
      591           buft_gds-dtl_obj.discnt-rubl  = discnt-rubl
      592           buft_gds-dtl_obj.discnt-base  = discnt-base
      593           buft_gds-dtl_obj.discnt-pc  = discnt-pc
      594           buft_gds-dtl_obj.discnt-type  = discnt-type
      595           .
      596           glog = no.
      597           if v_bh:available then  do:
      598             glog = v_bh:buffer-compare(v_tbh).
      599           end.
      600           if not glog
      601           then do:
      602             if temp >= 0 then do:
      603               assign
      604               glog = v_bh:buffer-copy( v_tbh) no-error .
      605               if error-status:error then do:
      606                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      607               end.
      608             end.
      609             glog = v_bh:buffer-release() no-error .
      610             if error-status:error then do:
      611               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      612             end.
      613           end.
      614        end.
      615        return yes.
      616      end method.
      617     method public void gds-dtl_objrelease_ ( ):
      618       define variable glog as logical no-undo .
      619       glog = v_bh:buffer-release() no-error .
      620       glog = v_bdh:buffer-release() no-error .
      621       glog = v_bbh:buffer-release() no-error .
      622       glog = v_bgh:buffer-release() no-error .
      623       clear_().
      624     end method.
      625     method public handle get_gds-dtl_obj ( ):
      626       return v_bh.
      627     end method.
