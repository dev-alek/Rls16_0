      246     method protected void clear_():
      247       define variable glog as logical no-undo .
      248       v-error-flag = no.
      249       if v_tbh:available then
      250       glog = v_tbh:buffer-delete() no-error .
      251       assign
      252       doc-code = ''
      253       .
      254     end method.
      255     method public void trn-doc_objrelease_ ( ):
      256       define variable glog as logical no-undo .
