       69     CONSTRUCTOR PUBLIC trn-doc_obj(
       70                                  input parparentproc as widget-handle
       71                                 ,input p-parent-handle as handle
       72                                 ,input p-log-handle as handle
       73                                 ,input p-gc-handle as handle
       74                                 ,input p-cont-handle as handle
       75                                 ,input p-lock as integer
       76                                 ,input p-wait as integer
       77                                 ,input p-temp as integer
       78                                 ,input p-codex-id as integer
       79                                 ,input p-ruleset-id as integer
       80                               ):
       81   define variable glog as logical no-undo .
       82   assign
       83   v_pp = parparentproc
       84   v_lh = p-log-handle
       85   v_ph = p-parent-handle
       86   v_gc = p-gc-handle
       87   v_cnt = p-cont-handle
       88   lock = p-lock
       89   wait = p-wait
       90   temp = p-temp
       91   .
       92   run garbcoll_create-gc-entry in p-gc-handle (input 'trn-doc_obj',  input this-object) no-error.
       93   if error-status:error then do:
       94     return error substitute("&1 ќшибка создани€ объекта trn-doc_obj", vss-include-info0).
       95   end.
       96   v_bh = buffer buf_trn-doc_obj:handle.
       97   v_tbh = buffer buft_trn-doc_obj:handle.
       98       assign
       99       doc-code = '':U
      100       .
      101   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      102   if (valid-handle(g#library) <> true) then do:   run library-cls_get-handle in v_gc ( input "library", output g#library) no-error.   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      103     (output v-curr-r-b
      104     )  .
      105     end constructor.
      106     destructor public trn-doc_obj():
      107       define variable glog as logical no-undo .
      108       assign
      109       glog = v_tbh:empty-temp-table() no-error .
      110       find_trn-doc_obj ( input '':U).
      111     end destructor.
      112     method public logical find_trn-doc_obj ( input p-doc-code as character
      113                                            ,input-output p-cycle-id as integer
      114                                            ):
      115     define variable glog as logical no-undo .
      116       p-cycle-id = p-cycle-id + 1.
      117       if p-cycle-id > 1 then do:
      118         return yes.
      119       end.
      120       glog = find_trn-doc_obj ( input p-doc-code) no-error.
      121       return glog.
      122     end.
      123     method public logical find_trn-doc_obj ( p-doc-code as character
      124                                            ):
      125      define variable glog as logical no-undo .
      126      trn-doc_objrelease_().
      127      clear_().
      128       if p-doc-code <> '':U then do:
      129         assign
      130         glog =  v_bh:find-first( substitute('where doc-code = "&1" '
      131                                             , p-doc-code
      132                                             ), lock, wait) no-error .
      133         if not glog then do:
      134           if find_no-error then do:
      135             return no.
      136           end.
      137           if lock = No-LOCK then do:
      138             if v_tbh:available then
      139             assign glog = v_tbh:buffer-delete() no-error .
      140             return error substitute("Ќе найдена накладна€ &1"
      141                                    , p-doc-code
      142                                    ).
      143           end.
      144           if wait = NO-WAIT
      145           and v_bh:locked then do:
      146             if v_tbh:available then
      147             assign glog = v_tbh:buffer-delete() no-error .
      148             if find_no-error then do:
      149               return no.
      150             end.
      151             else do:
      152               return error substitute("накладна€ &1 зан€та"
      153                                      , p-doc-code
      154                                      ).
      155             end.
      156           end.
      157         end.
      158         if p-doc-code <> doc-code then do:
      159           assign
      160           glog =  v_bdh:find-first( substitute('where doc-code = "&1"'
      161                                               , p-doc-code
      162                                               ), lock, wait) no-error .
      163           if not glog then do:
      164             return error substitute("Ќе найдена накладна€ &1", p-doc-code).
      165           end.
      166         end.
      167         assign
      168         doc-code             = buf_trn-doc_obj.doc-code
      169         d-card#              = buf_trn-doc_obj.d-card
      170         cli-type             = buf_trn-doc_obj.cli-type
      171         cli-code             = buf_trn-doc_obj.cli-code
      172         tot-calc             = buf_trn-doc_obj.tot-calc
      173         discnt-rubl          = buf_trn-doc_obj.discnt-rubl
      174         tot-rubl             = buf_trn-doc_obj.tot-rubl
      175         tot-doc              = buf_trn-doc_obj.tot-doc
      176         print-rubl           = buf_trn-doc_obj.print-rubl
      177         obj-type             = buf_trn-doc_obj.obj-type
      178         obj-code             = buf_trn-doc_obj.obj-code
      179         base-rate            = buf_trn-doc_obj.base-rate
      180         base-scale           = buf_trn-doc_obj.base-scale
      181         discnt-pc            = buf_trn-doc_obj.discnt-pc
      182         .
      183         glog = v_tbh:buffer-create( ).
      184         glog = v_tbh:buffer-copy( v_bh).
      185       end.
      186       return yes.
      187     end method.
      188   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189     method public decimal get_dis-rule-value_decimal ( input p-param-name as character):
      190       define buffer buf_temp-call-param for temp-call-param.
      191       find first buf_temp-call-param where
      192                 buf_temp-call-param.param-name_ = p-param-name
      193             and buf_temp-call-param.call-name_ = v-last-call-name no-error .
      194       if not available buf_temp-call-param then do:
      195         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - отсутствуют"
      196                                      ,vss-include-info4
      197                                      ,v-last-call-name
      198                                      ,p-param-name).
      199       end.
      200       if buf_temp-call-param.call-number <> v-last-call-number then do:
      201         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - уже затерты"
      202                                      ,vss-include-info4
      203                                      ,v-last-call-name
      204                                      ,p-param-name).
      205       end.
      206       return buf_temp-call-param.decimal_.
      207     end method.
