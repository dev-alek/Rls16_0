        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Dis-card_:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-card_.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_gc as handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_pp as widget-handle no-undo.
        7     define protected variable v_lh as widget-handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected variable v_qh as handle no-undo.
       10     define public variable v_bh as handle no-undo.
       11     define protected buffer buf_dis-card_ for ub.dis-card.
       12     define protected temp-table t-dis-card_ no-undo like ub.dis-card.
       13     define protected buffer buft_dis-card_ for t-dis-card_.
       14     define protected buffer bufq_dis-card_ for ub.dis-card.
       15     define query query_dis-card_ for bufq_dis-card_ scrolling.
       16     define public variable v_tbh as handle no-undo.
       17     define protected variable v_tcbh as handle no-undo .
       18     define private variable v-h-action as integer no-undo .
       19     define public variable temp as integer no-undo.
       20     define public variable v-curr-obj-type as character no-undo .
       21     define public variable v-curr-obj-code as integer no-undo .
       22     define public property lock as integer
       23     get.
       24     set.
       25     define public property wait as integer
       26     get.
       27     set.
       28     define protected variable release-flag as logical no-undo .
       29     define private variable v-error-flag as logical no-undo .
       30     define protected variable find_no-error as logical no-undo .
       31     define private temp-table tt0-dis-card-property  no-undo like ub.dis-card-property.
       32     define public variable card-num as integer no-undo .
       33     define public variable cash-d-pcnt as decimal no-undo .
       34     define public variable category as integer no-undo .
       35     define public variable cli-code as integer no-undo .
       36     define public variable cli-message as character no-undo .
       37     define public variable cli-type as character no-undo .
       38     define public variable credit-card as logical no-undo .
       39     define public variable d-card as character no-undo .
       40     define public variable d-pcnt-method as integer no-undo .
       41     define public variable d-pcnt as decimal no-undo .
       42     define public variable debet-card as logical no-undo .
       43     define public variable emitent-host-code as integer no-undo .
       44     define public variable first-card as character no-undo .
       45     define public variable first-main-card as character no-undo .
       46     define public variable is-subsid as logical no-undo .
       47     define public variable issue-code as integer no-undo .
       48     define public variable issue-date as date no-undo .
       49     define public variable lim-kr as decimal no-undo .
       50     define public variable main-card as character no-undo .
       51     define public variable mask-card as logical no-undo .
       52     define public variable overissue-num as integer no-undo .
       53     define public variable saldo-base as decimal no-undo .
       54     define public variable saldo-rubl as decimal no-undo .
       55     define public variable service-db-num as integer no-undo .
       56     define public variable sourced-card as character no-undo .
       57     define public variable staff-card as logical no-undo .
       58     define public variable status_ as character no-undo .
       59     define public variable type as character no-undo .
       60     define public variable valid-date as date no-undo .
       61     define public variable valid-from as date no-undo .
       62     define public property issue-date# as date
       63     get:
       64     define buffer buf_dis-card for ub.dis-card.
       65       if d-card = first-card then return issue-date.
       66       else do:
       67         find first buf_Dis-card no-lock where
       68                   buf_Dis-card.d-card = first-card no-error.
       69         if available buf_Dis-card then do:
       70           return buf_dis-card.issue-date.
       71         end.
       72         else do:
       73           run set-error in v_gc (substitute("Неверное значение № первой карты &1 для карты &2"
       74                                           , first-card
       75                                           , d-card)).
       76           return ?.
       77         end.
       78       end.
       79     end get.
       80     private set.
       81     define public property is-over# as logical
       82     get.
       83     private set.
       84     define public property is-main-first-card# as logical
       85     get.
       86     private set.
       87     define public property is-first-card# as logical
       88     get.
       89     private set.
       90     CONSTRUCTOR PUBLIC dis-card_(
       91                                  input parparentproc as widget-handle
       92                                 ,input p-parent-handle as handle
       93                                 ,input p-log-handle as handle
       94                                 ,input p-gc-handle as handle
       95                                 ,input p-cont-handle as handle
       96                                 ,input p-lock as integer
       97                                 ,input p-wait as integer
       98                                 ,input p-temp as integer
       99                               ):
      100   define variable glog as logical no-undo .
      101   assign
      102   v_pp = parparentproc
      103   v_lh = p-log-handle
      104   v_ph = p-parent-handle
      105   v_gc = p-gc-handle
      106   v_cnt = p-cont-handle
      107   lock = p-lock
      108   wait = p-wait
      109   temp = p-temp
      110   .
      111   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-card_',  input this-object) no-error.
      112   if error-status:error then do:
      113     return error substitute("&1 Ошибка создания объекта dis-card_", vss-include-info0).
      114   end.
      115   v_bh = buffer buf_dis-card_:handle.
      116   v_tbh = buffer buft_dis-card_:handle.
      117      if temp < 0 then do:
      118         run tempcont_get-buffer-handle in v_cnt ( input 'dis-card':U
      119                                                  ,output v_tcbh).
      120      end.
      121       d-card = '':U .
      122       v_qh = query query_dis-card_:handle.
      123     end constructor.
      124     destructor public dis-card_():
      125       define variable glog as logical no-undo .
      126       assign
      127       glog = v_tbh:empty-temp-table() no-error .
      128       find_dis-card_ ( input '':U).
      129     end destructor.
      130     method public void Dis-card_release_ ( ):
      131       define variable glog as logical no-undo .
      132       do transaction :
      133         glog = v_bh:buffer-release() no-error .
      134       end.
      135       clear_().
      136     end method.
      137     method public handle get_dis-card_ ( ):
      138       return v_tbh.
      139     end method.
      140     method public handle get_dis-card_field ( input p-field-name as character ):
      141       return v_tbh:buffer-field(p-field-name).
      142     end method.
      143     method public logical find_dis-card_no-error ( p-d-card as character):
      144       define variable glog as logical no-undo .
      145       assign
      146       find_no-error = yes.
      147       glog = find_dis-card_ ( input p-d-card) no-error.
      148       return glog.
      149     end method.
      150     method public logical dis-card_save ( ):
      151      define variable glog as logical no-undo .
      152      define variable loc-action as integer no-undo .
      153      if d-card <> '':U then do:
      154         if cash-d-pcnt = ?
      155         or cash-d-pcnt > 100
      156         or cash-d-pcnt < 0 then do:
      157           run set-error in v_gc (substitute("Неверное значение % скидки на итог &1 для ДК &2"
      158                                           , cash-d-pcnt
      159                                           , d-card)).
      160           return no.
      161         end.
      162         if d-pcnt = ?
      163         or d-pcnt > 100
      164         or d-pcnt < 0 then do:
      165           run set-error in v_gc (substitute("Неверное значение % скидки &1 для ДК &2"
      166                                           , d-pcnt
      167                                           , d-card)).
      168           return no.
      169         end.
      170         assign
      171         buft_dis-card_.cash-d-pcnt =  cash-d-pcnt
      172         buft_dis-card_.category    =  category
      173         buft_dis-card_.cli-message =  cli-message
      174         buft_dis-card_.d-pcnt      =  d-pcnt
      175         buft_dis-card_.valid-date  =  valid-date
      176         buft_dis-card_.valid-from  =  valid-from
      177         buft_dis-card_.cli-code    =  (if v-h-action = integer('1':U)
      178                                        then cli-code
      179                                        else buft_dis-card_.cli-code)
      180         buft_dis-card_.cli-type    =  (if v-h-action = integer('1':U)
      181                                        then cli-type
      182                                        else buft_dis-card_.cli-type)
      183         buft_dis-card_.issue-code  =  (if v-h-action = integer('1':U)
      184                                        then issue-code
      185                                        else buft_dis-card_.issue-code)
      186         buft_dis-card_.issue-date  =   issue-date
      187         buft_dis-card_.status_     =  (if buft_dis-card_.status_ <> status_
      188                                        and  lookup(status_, 'тек':U + chr(4) +
      189                                                             'удал':U + chr(4) +
      190                                                             'блок':U, chr(4) ) > 0
      191                                        and lookup(buft_dis-card_.status_ , 'неисп':U + chr(4) + 'смкли':U, chr(4) ) = 0
      192                                        then status_
      193                                        else buft_dis-card_.status_)
      194         .
      195         glog = no.
      196         if v_bh:available then  do:
      197           glog = v_bh:buffer-compare(v_tbh).
      198         end.
      199         if not glog
      200         or v-h-action = integer('1':U)
      201         then do:
      202           if temp >= 0 then do:
      203             loc-action = v-h-action.
      204             if temp = 1 then do:
      205               run tempcont_create-changes in v_cnt (
      206                                               input 'dis-card':U
      207                                             ,input v_bh
      208                                             ,input v_tbh
      209                                             ,input v-h-action
      210                                             ) no-error.
      211               if error-status:error then do:
      212                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      213               end.
      214             end.
      215             if v-h-action = integer('1':U) then do:
      216               define variable dc-ri as recid no-undo .
      217               run ref/dcardi01.p (
      218                                input v_pp
      219                               ,input v_ph
      220                               ,input v_lh
      221                               ,input v_gc
      222                               ,input yes
      223                               ,input-output dc-ri
      224                               ,input 'ДОБАВЛЕНИЕ-ИМПОРТ':U
      225                               ,input "rum"
      226                               ,input v-curr-obj-type
      227                               ,input v-curr-obj-code
      228                               ,input buft_dis-card_.d-card
      229                               ,input buft_dis-card_.emitent-host-code
      230                               ,input buft_dis-card_.cli-type
      231                               ,input buft_dis-card_.cli-code
      232                               ,input 'тек':U
      233                               ,input buft_dis-card_.type
      234                               ,input buft_dis-card_.d-pcnt
      235                               ,input buft_dis-card_.cash-d-pcnt
      236                               ,input buft_dis-card_.category
      237                               ,input buft_dis-card_.d-pcnt-method
      238                               ,input buft_dis-card_.credit-card
      239                               ,input buft_dis-card_.lim-kr
      240                               ,input buft_dis-card_.debet-card
      241                               ,input buft_dis-card_.staff-card
      242                               ,input buft_dis-card_.issue-date
      243                               ,input buft_dis-card_.issue-code
      244                               ,input buft_dis-card_.valid-from
      245                               ,input buft_dis-card_.valid-date
      246                               ,input buft_dis-card_.sourced-card
      247                               ,input buft_dis-card_.cli-message
      248                               ,input buft_dis-card_.mask-card
      249                               ,input (if is-subsid
      250                                       then buft_dis-card_.main-card
      251                                       else buft_dis-card_.d-card)
      252                               ,input buft_dis-card_.is-subsid
      253                               ,INPUT no
      254                               ,INPUT table tt0-dis-card-property
      255                               ) no-error .
      256               if error-status:error then do:
      257                 run set-error in v_gc (substitute("Ошибка при сохранении записи ДК &1:&2&3&2&4"
      258                                                 , d-card
      259                                                 , chr(10)
      260                                                 , error-status:get-message(1)
      261                                                 , return-value )).
      262                 return no.
      263               end.
      264               do transaction:
      265                 assign
      266                 glog =  v_bh:find-first( substitute('where recid(buf_dis-card_) = &1', dc-ri), lock, wait) no-error .
      267               end.
      268               if not glog then do:
      269                 run set-error in v_gc (substitute("Ошибка при создании ДК &1:&2не найдена ДК с recid &3"
      270                                       , d-card
      271                                       , chr(10)
      272                                       , string(dc-ri)
      273                                       )).
      274                 return no.
      275               end.
      276               v-h-action = integer('2':U).
      277             end.
      278             else do:
      279               run discardh_write-dis-card-rul in v_gc ( buffer buf_dis-card_
      280                                                         ,input type
      281                                                         ,input emitent-host-code
      282                                                         ,input loc-action).
      283               do transaction :
      284                 glog = v_bh:buffer-copy( v_tbh).
      285               end.
      286               run discardh_send-dis-card-rul in v_gc ( buffer buf_dis-card_
      287                                                         ,input type
      288                                                         ,input emitent-host-code
      289                                                         ,input loc-action).
      290               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      291               run cb_create-dc-list in v_ph ( input v_bh) no-error.
      292               do transaction :
      293                 glog = v_bh:buffer-release() no-error .
      294               end.
      295               if error-status:error then do:
      296                 undo, return error substitute( "&1. &2&3&4", vss-include-info0 , return-value, chr(10), error-status :get-message (1)).
      297               end.
      298             end.
      299           end.
      300           if temp = -1 then do:
      301             run tempcont_create-changes in v_cnt (
      302                                             input 'dis-card':U
      303                                            ,input v_bh
      304                                            ,input v_tbh
      305                                            ,input v-h-action
      306                                            ) no-error.
      307             if error-status:error then do:
      308               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      309             end.
      310           end.
      311           if temp = -2 then do:
      312             run tempcont_create-record in v_cnt (
      313                                             input 'dis-card':U
      314                                            ,input v_tbh
      315                                            ,input v-h-action
      316                                            ) no-error.
      317             if error-status:error then do:
      318               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      319             end.
      320           end.
      321         end.
      322       end.
      323       return yes.
      324     end method.
      325     method public logical find_dis-card_ ( p-d-card as character):
      326      define variable glog as logical no-undo .
      327      dis-card_release_().
      328      clear_().
      329       if p-d-card <> '':U then do:
      330         v-h-action           = integer('2':U).
      331         do transaction:
      332           assign
      333           glog =  v_bh:find-first( substitute('where d-card = "&1"', p-d-card), lock, wait) no-error .
      334         end.
      335         if not glog then do:
      336           if find_no-error then do:
      337             return no.
      338           end.
      339           else do:
      340             run set-error in v_gc (substitute("Не найдена ДК &1", p-d-card)).
      341             return error .
      342           end.
      343           if lock = No-LOCK then do:
      344             if v_tbh:available then do:
      345               do transaction :
      346                 assign glog = v_tbh:buffer-delete() no-error .
      347               end.
      348             end.
      349             return error substitute("Не найдена ДК &1", p-d-card).
      350           end.
      351           if wait = NO-WAIT
      352           and v_bh:locked then do:
      353             if v_tbh:available then do:
      354               do transaction :
      355                 assign glog = v_tbh:buffer-delete() no-error .
      356               end.
      357             end.
      358             if find_no-error then do:
      359               return no.
      360             end.
      361             else do:
      362               return error substitute("ДК &1 занята", p-d-card).
      363             end.
      364           end.
      365         end.
      366         if temp < 0 then do:
      367           assign
      368           glog = v_tcbh:find-first( substitute( ' where d-card = "&1"', p-d-card)) no-error .
      369           if v_tcbh:available then do:
      370             glog = v_tbh:find-first( substitute( ' where d-card = "&1"', p-d-card)) no-error .
      371             do transaction :
      372               if not v_tbh:available then do:
      373                 glog = v_tbh:buffer-create( ).
      374               end.
      375               glog = v_tbh:buffer-copy( v_tcbh).
      376             end.
      377             assign
      378             v-h-action           = integer('2':U)
      379             card-num             = buft_dis-card_.card-num
      380             cash-d-pcnt          = buft_dis-card_.cash-d-pcnt
      381             category             = buft_dis-card_.category
      382             cli-code             = buft_dis-card_.cli-code
      383             cli-message          = buft_dis-card_.cli-message
      384             cli-type             = buft_dis-card_.cli-type
      385             credit-card          = buft_dis-card_.credit-card
      386             d-card               = buft_dis-card_.d-card
      387             d-pcnt-method        = buft_dis-card_.d-pcnt-method
      388             d-pcnt               = buft_dis-card_.d-pcnt
      389             debet-card           = buft_dis-card_.debet-card
      390             emitent-host-code    = buft_dis-card_.emitent-host-code
      391             first-card           = buft_dis-card_.first-card
      392             first-main-card      = buft_dis-card_.first-main-card
      393             is-subsid            = buft_dis-card_.is-subsid
      394             issue-code           = buft_dis-card_.issue-code
      395             issue-date           = buft_dis-card_.issue-date
      396             lim-kr               = buft_dis-card_.lim-kr
      397             main-card            = buft_dis-card_.main-card
      398             mask-card            = buft_dis-card_.mask-card
      399             overissue-num        = buft_dis-card_.overissue-num
      400             saldo-base           = buft_dis-card_.saldo-base
      401             saldo-rubl           = buft_dis-card_.saldo-rubl
      402             sourced-card         = buft_dis-card_.sourced-card
      403             staff-card           = buft_dis-card_.staff-card
      404             status_              = buft_dis-card_.status_
      405             type                 = buft_dis-card_.type
      406             valid-from           = buft_dis-card_.valid-from
      407             valid-date           = buft_dis-card_.valid-date
      408             service-db-num       = buft_dis-card_.service-db-num
      409             is-over#             = (buft_dis-card_.sourced-card <> '':U)
      410             is-main-first-card#  = (buft_dis-card_.d-card = buft_dis-card_.first-main-card)
      411             is-first-card#       = (buft_dis-card_.d-card = buft_dis-card_.first-card)
      412             .
      413           end.
      414         end.
      415         if temp >= 0 or v_tcbh:available = no then do:
      416           assign
      417           v-h-action           = integer('2':U)
      418           card-num             = buf_dis-card_.card-num
      419           cash-d-pcnt          = buf_dis-card_.cash-d-pcnt
      420           category             = buf_dis-card_.category
      421           cli-code             = buf_dis-card_.cli-code
      422           cli-message          = buf_dis-card_.cli-message
      423           cli-type             = buf_dis-card_.cli-type
      424           credit-card          = buf_dis-card_.credit-card
      425           d-card               = buf_dis-card_.d-card
      426           d-pcnt-method        = buf_dis-card_.d-pcnt-method
      427           d-pcnt               = buf_dis-card_.d-pcnt
      428           debet-card           = buf_dis-card_.debet-card
      429           emitent-host-code    = buf_dis-card_.emitent-host-code
      430           first-card           = buf_dis-card_.first-card
      431           first-main-card      = buf_dis-card_.first-main-card
      432           is-subsid            = buf_dis-card_.is-subsid
      433           issue-code           = buf_dis-card_.issue-code
      434           issue-date           = buf_dis-card_.issue-date
      435           lim-kr               = buf_dis-card_.lim-kr
      436           main-card            = buf_dis-card_.main-card
      437           mask-card            = buf_dis-card_.mask-card
      438           overissue-num        = buf_dis-card_.overissue-num
      439           saldo-base           = buf_dis-card_.saldo-base
      440           saldo-rubl           = buf_dis-card_.saldo-rubl
      441           sourced-card         = buf_dis-card_.sourced-card
      442           staff-card           = buf_dis-card_.staff-card
      443           status_              = buf_dis-card_.status_
      444           type                 = buf_dis-card_.type
      445           valid-from           = buf_dis-card_.valid-from
      446           valid-date           = buf_dis-card_.valid-date
      447           service-db-num       = buf_dis-card_.service-db-num
      448           is-over#             = (buf_dis-card_.sourced-card <> '':U)
      449           is-main-first-card#  = (buf_dis-card_.d-card = buf_dis-card_.first-main-card)
      450           is-first-card#       = (buf_dis-card_.d-card = buf_dis-card_.first-card)
      451           .
      452           do transaction :
      453             glog = v_tbh:buffer-create( ).
      454             glog = v_tbh:buffer-copy( v_bh).
      455           end.
      456         end.
      457       end.
      458       return yes.
      459     end method.
      460     method public logical create_dis-card_ (
      461                                                input p-curr-obj-type as character
      462                                               ,input p-curr-obj-code as integer
      463                                               ,input p-d-card as character
      464                                               ,input p-emitent-host-code as integer
      465                                               ,input p-type as character
      466                                               ,input p-cli-type-code as character
      467                                               ):
      468       define variable glog as logical no-undo .
      469       glog = create_dis-card_ ( p-curr-obj-type
      470                       ,p-curr-obj-code
      471                       ,p-d-card
      472                       ,p-emitent-host-code
      473                       ,p-type
      474                       ,p-cli-type-code
      475                       ,p-d-card
      476                       ,p-d-card
      477                       ,p-d-card
      478                       ,'':U
      479                       ) no-error .
      480       return glog.
      481     end method.
      482     method public logical create_dis-card_ (
      483                                                input p-curr-obj-type as character
      484                                               ,input p-curr-obj-code as integer
      485                                               ,input p-d-card as character
      486                                               ,input p-emitent-host-code as integer
      487                                               ,input p-type as character
      488                                               ,input p-cli-type-code as character
      489                                               ,input p-first-main-card as character
      490                                               ,input p-first-card as character
      491                                               ,input p-main-card as character
      492                                               ,input p-sourced-card as character
      493                                               ):
      494       define variable glog as logical no-undo .
      495       DEFINE VARIABLE v-today as date no-undo .
      496       DEFINE VARIABLE v-time as integer no-undo .
      497       define buffer buf_sysconf for ub.sysconf.
      498       define buffer buf_dis-card for ub.dis-card.
      499       define buffer buf_dis-card-type for ub.dis-card-type.
      500       define buffer buf_clients for ub.clients.
      501       find first buf_dis-card no-lock where
      502                buf_dis-card.d-card = p-d-card no-error.
      503       if available buf_dis-card then do:
      504         return no.
      505       end.
      506       if length(p-d-card) > 19 then do:
      507         run set-error in v_gc (substitute("Нельзя создать ДК (&1) с номером длиннее 19 символов", p-d-card)).
      508         return no.
      509       end.
      510       if trim(p-d-card, "1234567890") <> '':U then do:
      511         run set-error in v_gc (substitute("№ ДК (&1) может состоять только из цифр", p-d-card)).
      512         return no.
      513       end.
      514       find first buf_dis-card-type no-lock where
      515                 buf_dis-card-type.type = p-type
      516             and buf_dis-card-type.emitent-host-code = p-emitent-host-code no-error.
      517       if not available buf_Dis-card-type then do:
      518         run set-error in v_gc (substitute("Не найден тип ДК &3: эмитент &1 тип &2", p-emitent-host-code, p-type, p-d-card)).
      519         return no.
      520       end.
      521       find first buf_clients no-lock where
      522                 buf_clients.obj-type = substring(p-cli-type-code, 1, 3)
      523             and buf_clients.obj-code = integer(substring(p-cli-type-code, 4)) no-error.
      524       if (not available buf_clients and integer(substring(p-cli-type-code, 4)) > 0)
      525       or not (substring(p-cli-type-code, 1, 3) = 'чел':U
      526               or
      527               substring(p-cli-type-code, 1, 3) = 'орг':U) then do:
      528         run can-find_clients_  in v_gc ( input substring(p-cli-type-code, 1, 3)
      529                                         ,integer(substring(p-cli-type-code, 4))
      530                                         ,output glog) no-error .
      531         if not glog then do:
      532           run set-error in v_gc (substitute("Не найден клиент-держатель &1 или неверный тип клиента &2 для &3"
      533                                           , p-cli-type-code
      534                                           , substring(p-cli-type-code, 1, 3)
      535                                           , p-d-card
      536                                           )).
      537           return no.
      538         end.
      539       end.
      540       if p-first-main-card <> p-d-card then do:
      541          find first buf_dis-card no-lock where
      542                   buf_Dis-card.d-card = p-first-main-card no-error.
      543          if not available buf_Dis-card then do:
      544           run set-error in v_gc (substitute("Не найдена ДК &1, указанная как ПЕРВАЯ ОСНОВНАЯ КАРТА для  &2"
      545                                           , p-first-main-card
      546                                           ,p-d-card
      547                                           )).
      548           return no.
      549          end.
      550       end.
      551       if p-main-card <> p-d-card then do:
      552          find first buf_dis-card no-lock where
      553                   buf_Dis-card.d-card = p-main-card no-error.
      554          if not available buf_Dis-card then do:
      555           run set-error in v_gc (substitute("Не найдена ДК &1, указанная как ОСНОВНАЯ КАРТА для &2"
      556                                           , p-main-card
      557                                           ,p-d-card
      558                                           )).
      559           return no.
      560          end.
      561       end.
      562       if p-first-card <> p-d-card then do:
      563          find first buf_dis-card no-lock where
      564                   buf_Dis-card.d-card = p-first-card no-error.
      565          if not available buf_Dis-card then do:
      566           run set-error in v_gc (substitute("Не найдена ДК &1, указанная как ПЕРВАЯ КАРТА для &1"
      567                                           , p-first-card
      568                                           ,p-d-card
      569                                           )).
      570           return no.
      571          end.
      572       end.
      573       if p-sourced-card <> '':U then do:
      574          find first buf_dis-card no-lock where
      575                   buf_Dis-card.d-card = p-sourced-card no-error.
      576          if not available buf_Dis-card then do:
      577           run set-error in v_gc (substitute("Не найдена ДК &1, указанная как ПЕРЕВЫПУСКАЕМАЯ к &2"
      578                                           , p-sourced-card
      579                                           ,p-d-card)).
      580           return no.
      581          end.
      582       end.
      583       if p-curr-obj-type <> '':U
      584         or p-curr-obj-code <> 0 then do:
      585         find first buf_clients no-lock where
      586                   buf_clients.obj-type = p-curr-obj-type
      587               and buf_clients.obj-code = p-curr-obj-code no-error.
      588         if not available buf_clients
      589         or not(buf_clients.obj-type = 'маг':U
      590               or
      591               buf_clients.obj-type = 'скл':U)
      592         then do:
      593           run set-error in v_gc (substitute("Не найден текущий объект &1&2 или неверный тип объекта &2"
      594                                           , p-curr-obj-type
      595                                           , p-curr-obj-code)).
      596           return no.
      597         end.
      598         if p-emitent-host-code <> 0
      599         and buf_clients.host-code <> p-emitent-host-code then do:
      600           run set-error in v_gc (substitute("Текущий объект &1&2 принадлежит фирме &3, а эмитент карты - фирма &4"
      601                                           , p-curr-obj-type
      602                                           , p-curr-obj-code
      603                                           , buf_clients.host-code
      604                                           , p-emitent-host-code
      605                                           )).
      606           return no.
      607         end.
      608       end.
      609       assign
      610       v-curr-obj-type = p-curr-obj-type
      611       v-curr-obj-code = p-curr-obj-code
      612       .
      613       do transaction :
      614         glog = v_tbh:buffer-create().
      615       end.
      616       assign
      617       d-card                           = p-d-card
      618       emitent-host-code                = p-emitent-host-code
      619       type                             = p-type
      620       first-card                       = p-first-card
      621       first-main-card                  = p-first-main-card
      622       main-card                        = p-main-card
      623       is-subsid                        = (d-card <> main-card)
      624       mask-card                        = no
      625       card-num                         = 0
      626       cli-code                         = integer(substring(p-cli-type-code, 4))
      627       cli-type                         = substring(p-cli-type-code, 1, 3)
      628       sourced-card                     = p-sourced-card
      629       overissue-num                    = ?
      630       issue-code                       = 0
      631       issue-date                       = v-today
      632       cash-d-pcnt                      = 0.0
      633       category                         = 0
      634       cli-message                      = '':U
      635       credit-card                      = no
      636       d-pcnt-method                    = integer('1':U)
      637       d-pcnt                           = 0.0
      638       debet-card                       = no
      639       lim-kr                           = 0.0
      640       saldo-base                       = 0.0
      641       saldo-rubl                       = 0.0
      642       staff-card                       = no
      643       status_                          = 'тек':U
      644       valid-date                       = ?
      645       valid-from                       = v-today
      646       service-db-num                   = 0
      647       is-over#                         = (sourced-card <> '':U)
      648       is-main-first-card#              = (d-card = first-main-card)
      649       is-first-card#                   = (d-card = first-card)
      650       buft_dis-card_.d-card            = d-card
      651       buft_dis-card_.emitent-host-code = emitent-host-code
      652       buft_dis-card_.type              = type
      653       buft_dis-card_.first-card        = first-card
      654       buft_dis-card_.first-main-card   = first-main-card
      655       buft_dis-card_.main-card         = main-card
      656       buft_dis-card_.is-subsid         = is-subsid
      657       buft_dis-card_.card-num          = 0
      658       buft_dis-card_.mask-card         = mask-card
      659       buft_dis-card_.cli-code          = cli-code
      660       buft_dis-card_.cli-type          = cli-type
      661       buft_dis-card_.sourced-card      = sourced-card
      662       buft_dis-card_.overissue-num     = overissue-num
      663       buft_dis-card_.issue-code        = issue-code
      664       buft_dis-card_.issue-date        = issue-date
      665       buft_dis-card_.cash-d-pcnt       = cash-d-pcnt
      666       buft_dis-card_.category          = category
      667       buft_dis-card_.cli-message       = cli-message
      668       buft_dis-card_.credit-card       = credit-card
      669       buft_dis-card_.d-pcnt-method     = d-pcnt-method
      670       buft_dis-card_.d-pcnt            = d-pcnt
      671       buft_dis-card_.debet-card        = debet-card
      672       buft_dis-card_.lim-kr            = lim-kr
      673       buft_dis-card_.saldo-base        = saldo-base
      674       buft_dis-card_.saldo-rubl        = saldo-rubl
      675       buft_dis-card_.staff-card        = no
      676       buft_dis-card_.status_           = status_
      677       buft_dis-card_.valid-date        = valid-date
      678       buft_dis-card_.valid-from        = valid-from
      679       buft_dis-card_.service-db-num    = service-db-num
      680       v-h-action                       = integer('1':U)
      681       .
      682       run create_dis-card_ in v_gc ( input d-card) no-error .
      683       return yes.
      684     end method.
      685     method public logical select_dis-cards ( input p-prepare-phrase as character):
      686       define variable glog as logical no-undo.
      687       assign
      688       glog = v_qh:query-prepare( "for each bufq_dis-card_ where " + p-prepare-phrase) no-error .
      689       if not glog then do:
      690         return error substitute("Ошибка подготовки выборки по ДК:&1&2&1&3"
      691                                  , chr(10)
      692                                  , error-status:get-message(1)
      693                                  , p-prepare-phrase).
      694       end.
      695       assign
      696       glog = v_qh:query-open no-error .
      697       if error-status:error then do:
      698         return error substitute("Ошибка открытия выборки по ДК:&1&2&1&3"
      699                                  , chr(10)
      700                                  , error-status:get-message(1)
      701                                  , v_qh:prepare-string ).
      702       end.
      703     end method.
      704     method public logical get_dis-card_( input p-rec-pos as character):
      705       define variable glog as logical no-undo .
      706       if not v_qh:is-open then do:
      707         return error substitute("Выборка по ДК:&1(&2)&1еще на открыта"
      708                                 , chr(10)
      709                                 , v_qh:prepare-string
      710                                  ).
      711       end.
      712       do transaction:
      713         case p-rec-pos:
      714           when "first" then do:
      715             glog = v_qh:get-first(lock, wait)  .
      716           end.
      717           when "last" then do:
      718             glog = v_qh:get-last(lock, wait)  .
      719           end.
      720           when "next" then do:
      721             glog = v_qh:get-next(lock, wait)  .
      722           end.
      723           when "prev" then do:
      724             glog = v_qh:get-prev(lock, wait)  .
      725           end.
      726         end case.
      727       end.
      728       if glog then do:
      729          assign
      730          glog = find_dis-card_ ( input bufq_dis-card_.d-card) no-error .
      731       end.
      732       return glog.
      733     end method.
      734     method protected void clear_():
      735       define variable glog as logical no-undo .
      736       v-error-flag = no.
      737       if v_tbh:available then do:
      738         do transaction :
      739           glog = v_tbh:buffer-delete() no-error .
      740         end.
      741       end.
      742       assign
      743       d-card = ''
      744       v-h-action = 0
      745       .
      746     end method.
      747   method public logical esys-add-dump (
      748                                             input p-esys-cmd-proc-handle as handle
      749                                           , input p-esys-cmd-code as integer
      750                                           , input p-action as character     ):
      751     define variable v-esys-rec-ord as integer no-undo .
      752     run add-dump in p-esys-cmd-proc-handle
      753       (input p-esys-cmd-code
      754       ,input 'dis-card':U
      755       ,input p-action
      756       ,input v_tbh
      757       ,input '':U
      758       ,output v-esys-rec-ord
      759       ) no-error .
      760     if error-status :error
      761     then do:
      762       delete procedure p-esys-cmd-proc-handle .
      763       run set-error in v_gc (substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
      764                                           ,chr(10)
      765                                           ,'dis-card':U
      766                                           ,p-esys-cmd-code
      767                                           ,error-status:get-message(1)
      768                                           ,return-value
      769                                           )) .
      770       return no.
      771     end.
      772     return yes.
      773   end method.
      774     method public override character ToString( ):
      775       return d-card.
      776     end method.
      777   end class.
