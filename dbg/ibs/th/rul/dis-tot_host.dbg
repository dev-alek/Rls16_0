      176     CONSTRUCTOR PUBLIC dis-tot_host(
      177                                  input parparentproc as widget-handle
      178                                 ,input p-parent-handle as handle
      179                                 ,input p-log-handle as handle
      180                                 ,input p-gc-handle as handle
      181                                 ,input p-cont-handle as handle
      182                                 ,input p-lock as integer
      183                                 ,input p-wait as integer
      184                                 ,input p-temp as integer
      185                               ):
      186   define variable glog as logical no-undo .
      187   assign
      188   v_pp = parparentproc
      189   v_lh = p-log-handle
      190   v_ph = p-parent-handle
      191   v_gc = p-gc-handle
      192   v_cnt = p-cont-handle
      193   lock = p-lock
      194   wait = p-wait
      195   temp = p-temp
      196   .
      197   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_host',  input this-object) no-error.
      198   if error-status:error then do:
      199     return error substitute("&1 Ошибка создания объекта dis-tot_host", vss-include-info0).
      200   end.
      201   v_bh = buffer buf_dis-tot_host:handle.
      202   v_tbh = buffer buft_dis-tot_host:handle.
      203       d-card = '':U.
      204       dtm-code  = 1.
      205       dt-code = 0.
      206       caller_id = '':U.
      207     end constructor.
      208     CONSTRUCTOR PUBLIC dis-tot_host(
      209                                  input parparentproc as widget-handle
      210                                 ,input p-parent-handle as handle
      211                                 ,input p-log-handle as handle
      212                                 ,input p-gc-handle as handle
      213                                 ,input p-cont-handle as handle
      214                                 ,input p-lock as integer
      215                                 ,input p-wait as integer
      216                                 ,input p-temp as integer
      217                                 ,input p-dtm-code as integer
      218                               ):
      219   define variable glog as logical no-undo .
      220   assign
      221   v_pp = parparentproc
      222   v_lh = p-log-handle
      223   v_ph = p-parent-handle
      224   v_gc = p-gc-handle
      225   v_cnt = p-cont-handle
      226   lock = p-lock
      227   wait = p-wait
      228   temp = p-temp
      229   .
      230   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_host',  input this-object) no-error.
      231   if error-status:error then do:
      232     return error substitute("&1 Ошибка создания объекта dis-tot_host", vss-include-info0).
      233   end.
      234   v_bh = buffer buf_dis-tot_host:handle.
      235   v_tbh = buffer buft_dis-tot_host:handle.
      236       d-card = '':U.
      237       dtm-code = p-dtm-code.
      238     end constructor.
      239     destructor public dis-tot_host():
      240       define variable glog as logical no-undo .
      241       assign
      242       glog = v_tbh:empty-temp-table() no-error .
      243       find_dis-tot_host ( input '':U, input 0).
      244     end destructor.
      245     method public void Dis-tot_hostrelease_ ( ):
      246       define variable glog as logical no-undo .
      247       do transaction :
      248         glog = v_bh:buffer-release() no-error .
      249       end.
      250       clear_().
      251     end method.
      252     method public handle get_dis-tot_host ( ):
      253       return v_bh.
      254     end method.
      255     method public logical set_dis-tot_host ( input p-bh as handle):
      256       define variable glog as logical no-undo .
      257       do transaction :
      258         glog = v_bh:buffer-copy ( p-bh).
      259       end.
      260       return glog.
      261     end method.
      262     method public character get_prev-sum-id( ):
      263       define buffer buf_prop-ref for ub.prop-ref.
      264       if sum-id = '':U then do:
      265          if dtm-code = 0 then do:
      266            return '':U.
      267          end.
      268          else do:
      269            return error substitute("(Еще)не задан объект-операнд - невозможно получить идентификатор предыдущего итога").
      270          end.
      271       end.
      272       find first buf_prop-ref no-lock where
      273                 buf_prop-ref.dtm-code = dtm-code
      274             and buf_prop-ref.sum-id < sum-id no-error.
      275       if not available buf_prop-ref then do:
      276         return chr(63).
      277       end.
      278       return buf_prop-ref.sum-id.
      279     end method.
      280     method public logical find_dis-tot_host_sum-id ( p-d-card as character
      281                                         , p-host-code as integer
      282                                         , p-sum-id as character
      283                                         , p-caller-id as character
      284                                             ):
      285       define variable glog as logical no-undo .
      286       define buffer buf_prop-ref for ub.prop-ref.
      287        find first buf_prop-ref no-lock where
      288                   buf_prop-ref.dtm-code = dtm-code
      289               and buf_prop-ref.sum-id  = p-sum-id
      290               and buf_prop-ref.caller_id  = p-caller-id
      291               no-error .
      292        if error-status:error then do:
      293           undo, return error substitute( "&1. Не найден ИТОГ(СРЕЗ) c ID &2 в справочнике итогов&3"
      294                                          , vss-include-info0
      295                                          , p-sum-id
      296                                          , chr(10)
      297                                          ).
      298        end.
      299        dt-code = buf_prop-ref.dt-code.
      300        sum-id = buf_prop-ref.sum-id.
      301        caller_id = buf_prop-ref.caller_id.
      302        glog = find_dis-tot_host ( p-d-card, p-host-code ) no-error .
      303        if error-status:error then do:
      304          undo, return error return-value .
      305        end.
      306        return glog.
      307      end method.
      308      method public logical find_dis-tot_host_date ( p-d-card as character
      309                                             , p-host-code as integer
      310                                             , p-date as date
      311                                             , p-caller-id as character
      312                                             ):
      313       define variable glog as logical no-undo .
      314       define variable v-date-char as character no-undo .
      315       define buffer buf_prop-ref for ub.prop-ref.
      316       assign
      317       v-date-char = string(year(p-date), "9999") + "/" +
      318                     string(month(p-date), "99") + "/" +
      319                     string(day(p-date), "99")
      320        v-date-char = v-date-char + "-" + v-date-char
      321        .
      322        find last buf_prop-ref no-lock where
      323                   buf_prop-ref.dtm-code = dtm-code
      324               and buf_prop-ref.sum-id <= v-date-char
      325               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      326               no-error .
      327        if error-status:error then do:
      328           undo, return error substitute( "&1. Не найден Период для даты &2 в справочнике итогов&3"
      329                                          , vss-include-info0
      330                                          , string(p-date, "99/99/9999")
      331                                          , chr(10)
      332                                          ).
      333        end.
      334        dt-code = buf_prop-ref.dt-code.
      335        sum-id = buf_prop-ref.sum-id.
      336        caller_id = buf_prop-ref.caller_id.
      337        glog = find_dis-tot_host ( p-d-card , p-host-code ) no-error .
      338        if error-status:error then do:
      339          undo, return error return-value .
      340        end.
      341        return glog.
      342      end method.
      343      method public logical dis-tot_hostsave ( ):
      344      define variable glog as logical no-undo .
      345      define variable loc-action as integer no-undo .
      346       if d-card <> '':U then do:
      347           assign
      348           buft_Dis-tot_host.gds-dis-base  = gds-dis-base
      349           buft_Dis-tot_host.gds-dis-rubl  = gds-dis-rubl
      350           buft_Dis-tot_host.gds-tot-base  = gds-tot-base
      351           buft_Dis-tot_host.gds-tot-rubl  = gds-tot-rubl
      352           buft_Dis-tot_host.pay-tot-base  = pay-tot-base
      353           buft_Dis-tot_host.pay-tot-rubl  = pay-tot-rubl
      354           buft_Dis-tot_host.num-chk       = num-chk
      355           .
      356           glog = no.
      357           if v_bh:available then  do:
      358             glog = v_bh:buffer-compare(v_tbh).
      359           end.
      360           if not glog
      361           or v-h-action = integer('1':U)
      362           then do:
      363             if temp >= 0 then do:
      364             loc-action = v-h-action.
      365             if v-h-action = integer('1':U) then do:
      366                 find first buf_Dis-card no-lock where
      367                 buf_Dis-card.d-card = d-card no-error.
      368                 if not available buf_dis-card then do:
      369                   undo, return error substitute( "&1. Не найдена ДК &2 при создании итога по ДК по фирме &3"
      370                                                 , vss-include-info0
      371                                                 , d-card
      372                                                 , host-code
      373                                                 ).
      374                 end.
      375                 assign
      376                 type#                        = buf_dis-card.type
      377                 emitent-host-code#           = buf_dis-card.emitent-host-code
      378                 .
      379                 do transaction :
      380                   glog = v_tbh:buffer-copy( buffer buf_Dis-card:handle).
      381                   glog = v_bh:buffer-create( ).
      382                   glog = v_bh:buffer-copy( v_tbh).
      383                 end.
      384                 v-h-action = integer('2':U) .
      385             end.
      386             run dis-hsth_write-dis-host-rul  in v_gc ( buffer buf_dis-tot_host
      387                                                       ,input type#
      388                                                       ,input emitent-host-code#
      389                                                       ,input 1
      390                                                       ,input loc-action).
      391               do transaction :
      392                 glog = v_bh:buffer-copy( v_tbh).
      393               end.
      394               run dis-hsth_send-dis-host-rul  in v_gc ( buffer buf_dis-tot_host
      395                                                       ,input type#
      396                                                       ,input emitent-host-code#
      397                                                       ,input 1
      398                                                       ,input loc-action).
      399             end.
      400             do transaction :
      401               glog = v_bh:buffer-release() no-error .
      402             end.
      403             if error-status:error then do:
      404               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      405             end.
      406             if temp < 0 then do:
      407               run tempcont_create-changes in v_cnt (
      408                                                input 'dis-host':U
      409                                               ,input v_bh
      410                                               ,input v_tbh
      411                                               ,input v-h-action) no-error.
      412               if error-status:error then do:
      413                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      414               end.
      415             end.
      416           end.
      417       end.
      418       return yes.
      419     end method.
      420      method public logical find_dis-tot_host ( p-d-card as character, p-host-code as integer):
      421      define variable glog as logical no-undo .
      422       dis-tot_hostrelease_().
      423       clear_().
      424       if p-d-card <> '':U then do:
      425         v-h-action           = integer('2':U).
      426         do transaction :
      427           assign
      428           glog =  v_bh:find-first( substitute('where d-card = "&1" and host-code = &2 and dt-code = &3'
      429                                   , p-d-card
      430                                   , p-host-code
      431                                   , dt-code
      432                                   )
      433                                   , lock
      434                                   , wait) no-error .
      435         end.
      436         if not glog then do:
      437           if lock = No-LOCK then do:
      438             if v_tbh:available then do:
      439               do transaction :
      440                 assign glog = v_tbh:buffer-delete() no-error .
      441               end.
      442             end.
      443             return no.
      444           end.
      445           if wait = NO-WAIT
      446           and v_bh:locked then do:
      447             if v_tbh:available then do:
      448               do transaction :
      449                 assign glog = v_tbh:buffer-delete() no-error .
      450               end.
      451             end.
      452             return error substitute("Запись итогов ДК &1 по фирме&2 занята", p-d-card, p-host-code).
      453           end.
      454           if v_tbh:available then do:
      455             do transaction :
      456               assign glog = v_tbh:buffer-delete() no-error .
      457             end.
      458           end.
      459           return no.
      460         end.
      461         find first buf_dis-card no-lock where
      462                   buf_dis-card.d-card = p-d-card no-error .
      463         if not available buf_dis-card then do:
      464           return error substitute("Не найдена ДК &1", p-d-card).
      465         end.
      466         assign
      467         v-h-action           = integer('2':U)
      468         card-num             = buf_dis-tot_host.card-num
      469         gds-dis-base         = buf_dis-tot_host.gds-dis-base
      470         gds-dis-rubl         = buf_dis-tot_host.gds-dis-rubl
      471         gds-tot-base         = buf_dis-tot_host.gds-tot-base
      472         gds-tot-rubl         = buf_dis-tot_host.gds-tot-rubl
      473         pay-tot-base         = buf_dis-tot_host.pay-tot-base
      474         pay-tot-rubl         = buf_dis-tot_host.pay-tot-rubl
      475         num-chk              = buf_dis-tot_host.num-chk
      476         d-card               = buf_dis-tot_host.d-card
      477         first-card           = buf_dis-tot_host.first-card
      478         first-main-card      = buf_dis-tot_host.first-main-card
      479         main-card            = buf_dis-tot_host.main-card
      480         host-code            = buf_dis-tot_host.host-code
      481         v-byfm               = no
      482         v-bym                = no
      483         v-byf                = no
      484         emitent-host-code#   = buf_dis-card.emitent-host-code
      485         type#                = buf_dis-card.type
      486         .
      487         do transaction :
      488           glog = v_tbh:buffer-create( ).
      489           glog = v_tbh:buffer-copy( v_bh).
      490         end.
      491       end.
      492       return yes.
      493     end method.
      494     method public logical create_dis-tot_host_date ( input p-d-card as character
      495                                                ,input p-host-code as integer
      496                                                ,input p-date as date
      497                                                ,input p-caller-id as character
      498                                             ):
      499       define variable glog as logical no-undo .
      500       define variable v-date-char as character no-undo .
      501       define buffer buf_prop-ref for ub.prop-ref.
      502       assign
      503       v-date-char = string(year(p-date), "9999") + "/" +
      504                     string(month(p-date), "99") + "/" +
      505                     string(day(p-date), "99")
      506        v-date-char = v-date-char + "-" + v-date-char
      507        .
      508        find last buf_prop-ref no-lock where
      509                   buf_prop-ref.dtm-code = dtm-code
      510               and buf_prop-ref.sum-id <= v-date-char
      511               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      512        if error-status:error then do:
      513           undo, return error substitute( "&1. Не найден Период для даты &2 (доп.иден-р &3) в справочнике итогов&4"
      514                                          , vss-include-info0
      515                                          , string(p-date, "99/99/9999")
      516                                          , p-caller-id
      517                                          , chr(10)
      518                                          ).
      519        end.
      520        dt-code = buf_prop-ref.dt-code.
      521        caller_id = buf_prop-ref.caller_id.
      522        glog = create_dis-tot_host ( p-d-card , p-host-code ) no-error .
      523        if error-status:error then do:
      524          undo, return error return-value .
      525        end.
      526     end.
      527     method public logical create_dis-tot_host_sum-id ( input p-d-card as character
      528                                                ,input p-host-code as integer
      529                                                ,input p-sum-id as character
      530                                                ,input p-caller-id as character
      531                                             ):
      532       define variable glog as logical no-undo .
      533       define buffer buf_prop-ref for ub.prop-ref.
      534        find last buf_prop-ref no-lock where
      535                   buf_prop-ref.dtm-code = dtm-code
      536               and buf_prop-ref.sum-id = p-sum-id
      537               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      538        if error-status:error then do:
      539           undo, return error substitute( "&1. Не найден ИТОГ &2 (доп.иден-р &3) в справочнике итогов&4"
      540                                          , vss-include-info0
      541                                          , p-sum-id
      542                                          , p-caller-id
      543                                          , chr(10)
      544                                          ).
      545        end.
      546        dt-code = buf_prop-ref.dt-code.
      547        caller_id = buf_prop-ref.caller_id.
      548        glog = create_dis-tot_host ( p-d-card , p-host-code ) no-error .
      549        if error-status:error then do:
      550          undo, return error return-value .
      551        end.
      552     end.
      553     method public logical create_dis-tot_host ( input p-d-card as character
      554                                                ,input p-host-code as integer):
      555       define variable glog as logical no-undo .
      556       define buffer buf_sysconf for ub.sysconf.
      557       define buffer buf_dis-card for ub.dis-card.
      558       find first buf_sysconf no-lock where
      559                 buf_sysconf.host-code = p-host-code no-error.
      560       if not available buf_sysconf then do:
      561         run set-error in v_gc (substitute("Неверно задана фирма для создания итогов по ДК(ДК &1 фирма &2)"
      562                                           , d-card
      563                                           , p-host-code
      564                                           )).
      565         return no.
      566       end.
      567       do transaction :
      568         glog = v_tbh:buffer-create().
      569       end.
      570       find first buf_dis-card no-lock where
      571                buf_dis-card.d-card = p-d-card no-error.
      572       if not available buf_dis-card then do:
      573         glog = no.
      574         run can-find_dis-card_ in v_gc ( input p-d-card
      575                                         ,output glog) no-error .
      576         if not glog then do:
      577           run set-error in v_gc (substitute("Неверно задана ДК для создания итогов по ДК(ДК &1 фирма &2)"
      578                                             , d-card
      579                                             , p-host-code
      580                                             )).
      581           return no.
      582         end.
      583         assign
      584         d-card                  = p-d-card
      585         host-code            = buf_sysconf.host-code
      586         buft_dis-tot_host.d-card = p-d-card
      587         buft_dis-tot_host.host-code = buf_sysconf.host-code
      588         .
      589       end.
      590       else do:
      591         assign
      592         d-card                  = p-d-card
      593         card-num             = buf_dis-card.card-num
      594         first-card           = buf_dis-card.first-card
      595         first-main-card      = buf_dis-card.first-main-card
      596         main-card            = buf_dis-card.main-card
      597         host-code            = buf_sysconf.host-code
      598         buft_dis-tot_host.d-card = p-d-card
      599         buft_dis-tot_host.card-num       = buf_dis-card.card-num
      600         buft_dis-tot_host.host-code = buf_sysconf.host-code
      601         buft_dis-tot_host.first-card     = buf_dis-card.first-card
      602         buft_dis-tot_host.first-main-card = buf_dis-card.first-main-card
      603         buft_dis-tot_host.main-card      = buf_dis-card.main-card
      604         type#                        = buf_dis-card.type
      605         emitent-host-code#           = buf_dis-card.emitent-host-code
      606         .
      607       end.
      608       assign
      609       buft_dis-tot_host.dt-code        = dt-code
      610       gds-dis-base         = 0.0
      611       gds-dis-rubl         = 0.0
      612       gds-tot-base         = 0.0
      613       gds-tot-rubl         = 0.0
      614       pay-tot-base         = 0.0
      615       pay-tot-rubl         = 0.0
      616       num-chk              = 0
      617       v-byfm = no
      618       v-bym = no
      619       v-byf = no
      620       v-h-action           = integer('1':U)
      621       .
      622       return yes.
      623     end method.
      624     method private void get-byfm():
      625       define variable v-dis-base as decimal no-undo.
      626       define variable v-dis-rubl as decimal no-undo.
      627       define variable v-tot-base as decimal no-undo.
      628       define variable v-tot-rubl as decimal no-undo.
      629       define variable v-pay-base as decimal no-undo.
      630       define variable v-pay-rubl as decimal no-undo.
      631       define variable v-num-chk as integer no-undo .
      632       define buffer buf_dis-host for ub.dis-host.
      633       if not v-byfm then do:
      634         for each buf_dis-host no-lock where
      635                 buf_dis-host.first-main-card = first-main-card
      636              and buf_dis-host.host-code > 0
      637              and buf_dis-host.dt-code = dt-code:
      638           assign
      639           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      640           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      641           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      642           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      643           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      644           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      645           v-num-chk = v-num-chk + buf_dis-host.num-chk
      646           .
      647         end.
      648         assign
      649         gds-dis-base_byfm#  = v-dis-base
      650         gds-dis-rubl_byfm#  = v-dis-rubl
      651         gds-tot-base_byfm#  = v-tot-base
      652         gds-tot-rubl_byfm#  = v-tot-rubl
      653         pay-tot-base_byfm#  = v-pay-base
      654         pay-tot-rubl_byfm#  = v-pay-rubl
      655         num-chk_byfm#  = v-num-chk
      656         v-byfm = yes
      657         .
      658       end.
      659     end method.
      660     method private void get-bym():
      661       define variable v-dis-base as decimal no-undo.
      662       define variable v-dis-rubl as decimal no-undo.
      663       define variable v-tot-base as decimal no-undo.
      664       define variable v-tot-rubl as decimal no-undo.
      665       define variable v-pay-base as decimal no-undo.
      666       define variable v-pay-rubl as decimal no-undo.
      667       define variable v-num-chk as integer no-undo .
      668       define buffer buf_dis-host for ub.dis-host.
      669       if not v-bym then do:
      670         for each buf_dis-host no-lock where
      671                 buf_dis-host.main-card = main-card
      672              and buf_dis-host.host-code > 0
      673              and buf_dis-host.dt-code = dt-code:
      674           assign
      675           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      676           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      677           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      678           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      679           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      680           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      681           v-num-chk = v-num-chk + buf_dis-host.num-chk
      682           .
      683         end.
      684         assign
      685         gds-dis-base_bym#  = v-dis-base
      686         gds-dis-rubl_bym#  = v-dis-rubl
      687         gds-tot-base_bym#  = v-tot-base
      688         gds-tot-rubl_bym#  = v-tot-rubl
      689         pay-tot-base_bym#  = v-pay-base
      690         pay-tot-rubl_bym#  = v-pay-rubl
      691         num-chk_bym#  = v-num-chk
      692         v-bym = yes
      693         .
      694       end.
      695     end method.
      696     method private void get-byf():
      697       define variable v-dis-base as decimal no-undo.
      698       define variable v-dis-rubl as decimal no-undo.
      699       define variable v-tot-base as decimal no-undo.
      700       define variable v-tot-rubl as decimal no-undo.
      701       define variable v-pay-base as decimal no-undo.
      702       define variable v-pay-rubl as decimal no-undo.
      703       define variable v-num-chk as integer no-undo .
      704       define buffer buf_dis-host for ub.dis-host.
      705       if not v-byf then do:
      706         for each buf_dis-host no-lock where
      707                 buf_dis-host.first-card = first-card
      708              and buf_dis-host.host-code > 0
      709              and buf_dis-host.dt-code = dt-code:
      710           assign
      711           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      712           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      713           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      714           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      715           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      716           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      717           v-num-chk = v-num-chk + buf_dis-host.num-chk
      718           .
      719         end.
      720         assign
      721         gds-dis-base_byf#  = v-dis-base
      722         gds-dis-rubl_byf#  = v-dis-rubl
      723         gds-tot-base_byf#  = v-tot-base
      724         gds-tot-rubl_byf#  = v-tot-rubl
      725         pay-tot-base_byf#  = v-pay-base
      726         pay-tot-rubl_byf#  = v-pay-rubl
      727         num-chk_byf#  = v-num-chk
      728         v-byf = yes
      729         .
      730       end.
      731     end method.
      732     method protected void clear_():
      733       define variable glog as logical no-undo .
      734       v-error-flag = no.
      735       if v_tbh:available then do:
      736         do transaction :
      737           glog = v_tbh:buffer-delete() no-error .
      738         end.
      739       end.
      740       assign
      741       d-card = ''
      742       v-h-action = 0
      743       .
      744     end method.
      745     method public override character ToString( ):
      746       return substitute("&1 фирма &2 срез &3", d-card , host-code, dt-code ).
      747     end method.
      748   end class.
