      174     CONSTRUCTOR PUBLIC dis-tot_(
      175                                  input parparentproc as widget-handle
      176                                 ,input p-parent-handle as handle
      177                                 ,input p-log-handle as handle
      178                                 ,input p-gc-handle as handle
      179                                 ,input p-cont-handle as handle
      180                                 ,input p-lock as integer
      181                                 ,input p-wait as integer
      182                                 ,input p-temp as integer
      183                               ):
      184   define variable glog as logical no-undo .
      185   assign
      186   v_pp = parparentproc
      187   v_lh = p-log-handle
      188   v_ph = p-parent-handle
      189   v_gc = p-gc-handle
      190   v_cnt = p-cont-handle
      191   lock = p-lock
      192   wait = p-wait
      193   temp = p-temp
      194   .
      195   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_',  input this-object) no-error.
      196   if error-status:error then do:
      197     return error substitute("&1 Ошибка создания объекта dis-tot_", vss-include-info0).
      198   end.
      199   v_bh = buffer buf_dis-tot_:handle.
      200   v_tbh = buffer buft_dis-tot_:handle.
      201       assign
      202       d-card = '':U
      203       dtm-code  = 1
      204       dt-code = 0
      205       caller_id = '':U
      206       .
      207     end constructor.
      208     CONSTRUCTOR PUBLIC dis-tot_(
      209                                  input parparentproc as widget-handle
      210                                 ,input p-parent-handle as handle
      211                                 ,input p-log-handle as handle
      212                                 ,input p-gc-handle as handle
      213                                 ,input p-cont-handle as handle
      214                                 ,input p-lock as integer
      215                                 ,input p-wait as integer
      216                                 ,input p-temp as integer
      217                                 ,input p-dtm-code as integer
      218                               ):
      219   define variable glog as logical no-undo .
      220   assign
      221   v_pp = parparentproc
      222   v_lh = p-log-handle
      223   v_ph = p-parent-handle
      224   v_gc = p-gc-handle
      225   v_cnt = p-cont-handle
      226   lock = p-lock
      227   wait = p-wait
      228   temp = p-temp
      229   .
      230   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_',  input this-object) no-error.
      231   if error-status:error then do:
      232     return error substitute("&1 Ошибка создания объекта dis-tot_", vss-include-info0).
      233   end.
      234   v_bh = buffer buf_dis-tot_:handle.
      235   v_tbh = buffer buft_dis-tot_:handle.
      236       d-card = '':U.
      237       dtm-code = p-dtm-code.
      238     end constructor.
      239     destructor public dis-tot_():
      240       define variable glog as logical no-undo .
      241       assign
      242       glog = v_tbh:empty-temp-table() no-error .
      243       find_dis-tot_ ( input '':U).
      244     end destructor.
      245     method public void Dis-tot_release_ (  ):
      246       define variable glog as logical no-undo .
      247       do transaction :
      248         glog = v_bh:buffer-release() no-error .
      249       end.
      250       clear_().
      251     end method.
      252     method public handle get_dis-tot_ ( ):
      253       return v_bh.
      254     end method.
      255     method public logical set_dis-tot_ ( input p-bh as handle):
      256       define variable glog as logical no-undo .
      257       do transaction :
      258         glog = v_bh:buffer-copy ( p-bh).
      259       end.
      260       return glog.
      261     end method.
      262     method public character get_prev-sum-id( ):
      263       define buffer buf_prop-ref for ub.prop-ref.
      264       if sum-id = '':U then do:
      265          if dtm-code = 0 then do:
      266            return '':U.
      267          end.
      268          else do:
      269            return error substitute("(Еще)не задан объект-операнд - невозможно получить идентификатор предыдущего итога").
      270          end.
      271       end.
      272       find first buf_prop-ref no-lock where
      273                 buf_prop-ref.dtm-code = dtm-code
      274             and buf_prop-ref.sum-id < sum-id
      275             and buf_prop-ref.caller_id = caller_id
      276             no-error.
      277       if not available buf_prop-ref then do:
      278         return chr(63).
      279       end.
      280       return buf_prop-ref.sum-id.
      281     end method.
      282     method public logical find_dis-tot_sum-id ( p-d-card as character
      283                                         , p-sum-id as character
      284                                         , p-caller-id as character
      285                                             ):
      286       define variable glog as logical no-undo .
      287       define buffer buf_prop-ref for ub.prop-ref.
      288        find first buf_prop-ref no-lock where
      289                   buf_prop-ref.dtm-code = dtm-code
      290               and buf_prop-ref.sum-id  = p-sum-id
      291               and buf_prop-ref.caller_id = p-caller-id
      292               no-error .
      293        if error-status:error then do:
      294           undo, return error substitute( "&1. Не найден ИТОГ(СРЕЗ) c ID &2 (доп иден-р &3) в справочнике итогов&4" +
      295                                          "Код объекта-операнда &5"
      296                                          , vss-include-info0
      297                                          , p-sum-id
      298                                          , p-caller-id
      299                                          , chr(10)
      300                                          , dtm-code
      301                                          ).
      302        end.
      303        dt-code = buf_prop-ref.dt-code.
      304        sum-id = buf_prop-ref.sum-id.
      305        caller_id = buf_prop-ref.caller_id.
      306        glog = find_dis-tot_ ( p-d-card ) no-error .
      307        if error-status:error then do:
      308          undo, return error return-value .
      309        end.
      310        return glog.
      311      end method.
      312     method public logical find_dis-tot_date ( p-d-card as character
      313                                         , p-date as date
      314                                         , p-caller-id as character
      315                                             ):
      316       define variable glog as logical no-undo .
      317       define variable v-date-char as character no-undo .
      318       define buffer buf_prop-ref for ub.prop-ref.
      319       assign
      320       v-date-char = string(year(p-date), "9999") + "/" +
      321                     string(month(p-date), "99") + "/" +
      322                     string(day(p-date), "99")
      323        v-date-char = v-date-char + "-" + v-date-char
      324        .
      325        find last buf_prop-ref no-lock where
      326                   buf_prop-ref.dtm-code = dtm-code
      327               and buf_prop-ref.sum-id <= v-date-char
      328               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      329               no-error .
      330        if error-status:error then do:
      331           undo, return error substitute( "&1. Не найден Период для даты &2 в справочнике итогов&3"
      332                                          , vss-include-info0
      333                                          , string(p-date, "99/99/9999")
      334                                          , chr(10)
      335                                          ).
      336        end.
      337        dt-code = buf_prop-ref.dt-code.
      338        sum-id = buf_prop-ref.sum-id.
      339        caller_id = buf_prop-ref.caller_id.
      340        glog = find_dis-tot_ ( p-d-card ) no-error .
      341        if error-status:error then do:
      342          undo, return error return-value .
      343        end.
      344        return glog.
      345      end method.
      346      method public logical dis-tot_save ( ):
      347      define variable glog as logical no-undo .
      348      define variable loc-action  as integer no-undo .
      349      define buffer buf_dis-card for ub.dis-card.
      350       if d-card <> '':U then do:
      351           assign
      352           buft_Dis-tot_.gds-dis-base  = gds-dis-base
      353           buft_Dis-tot_.gds-dis-rubl  = gds-dis-rubl
      354           buft_Dis-tot_.gds-tot-base  = gds-tot-base
      355           buft_Dis-tot_.gds-tot-rubl  = gds-tot-rubl
      356           buft_Dis-tot_.pay-tot-base  = pay-tot-base
      357           buft_Dis-tot_.pay-tot-rubl  = pay-tot-rubl
      358           buft_Dis-tot_.num-chk       = num-chk
      359           .
      360           glog = no.
      361           if v_bh:available then  do:
      362             glog = v_bh:buffer-compare(v_tbh).
      363           end.
      364           if not glog
      365           or v-h-action = integer('1':U)
      366           then do:
      367             if temp >= 0 then do:
      368               loc-action = v-h-action.
      369               if v-h-action = integer('1':U) then do:
      370                 find first buf_Dis-card no-lock where
      371                           buf_Dis-card.d-card = d-card no-error.
      372                 if not available buf_dis-card then do:
      373                   undo, return error substitute( "&1. Не найдена ДК &2 при создании итога по ДК"
      374                                                 , vss-include-info0
      375                                                 , d-card
      376                                                 ).
      377                 end.
      378                 assign
      379                 type#                         = buf_dis-card.type
      380                 emitent-host-code#            = buf_dis-card.emitent-host-code
      381                 .
      382                 do transaction :
      383                   glog = v_tbh:buffer-copy( buffer buf_Dis-card:handle).
      384                   glog = v_bh:buffer-create( ).
      385                   glog = v_bh:buffer-copy( v_tbh).
      386                 end.
      387                 if dt-code = 0 then do:
      388                   do transaction :
      389                     v_bh::whole-send-news = integer('-1':U).
      390                   end.
      391                 end.
      392                 v-h-action = integer('2':U) .
      393               end.
      394               run dis-hsth_write-dis-host-rul in v_gc ( buffer buf_dis-tot_
      395                                                       ,input type#
      396                                                       ,input emitent-host-code#
      397                                                       ,input 1
      398                                                       ,input loc-action) no-error .
      399               if error-status:error then do:
      400                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      401               end.
      402               do transaction :
      403                 glog = v_bh:buffer-copy( v_tbh, "whole-send-news").
      404               end.
      405               run dis-hsth_send-dis-host-rul in v_gc ( buffer buf_dis-tot_
      406                                                       ,input type#
      407                                                       ,input emitent-host-code#
      408                                                       ,input 1
      409                                                       ,input loc-action) no-error .
      410               if error-status:error then do:
      411                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      412               end.
      413               do transaction :
      414                 v_bh::whole-send-news = integer('0':U).
      415               end.
      416             end.
      417             do transaction :
      418               glog = v_bh:buffer-release() no-error .
      419             end.
      420             if error-status:error then do:
      421               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      422             end.
      423             if temp < 0 then do:
      424               run tempcont_create-changes in v_cnt (
      425                                               input 'dis-host':U
      426                                              ,input v_bh
      427                                              ,input v_tbh
      428                                              ,input v-h-action
      429                                              ) no-error.
      430               if error-status:error then do:
      431                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      432               end.
      433             end.
      434           end.
      435        end.
      436        return yes.
      437      end method.
      438      method public logical find_dis-tot_ ( p-d-card as character):
      439      define variable glog as logical no-undo .
      440      define buffer buf_dis-card for ub.dis-card.
      441       dis-tot_release_().
      442       clear_().
      443       if p-d-card <> '':U then do:
      444         v-h-action           = integer('2':U).
      445         do transaction :
      446           assign
      447           glog =  v_bh:find-first( substitute('where d-card = "&1" and host-code = 0 and dt-code = &2'
      448                                   , p-d-card
      449                                   , dt-code
      450                                   )
      451                                   , lock
      452                                   , wait) no-error .
      453         end.
      454         if not glog then do:
      455           if wait = NO-WAIT
      456           and v_bh:locked then do:
      457             if v_tbh:available then do:
      458               do transaction :
      459                 assign glog = v_tbh:buffer-delete() no-error .
      460               end.
      461             end.
      462             return error substitute("Запись глобальных итогов ДК &1 занята", p-d-card).
      463           end.
      464           if v_tbh:available then do:
      465             do transaction :
      466               assign glog = v_tbh:buffer-delete() no-error .
      467             end.
      468           end.
      469           return no.
      470         end.
      471         find first buf_dis-card no-lock where
      472                   buf_dis-card.d-card = p-d-card no-error.
      473         if not available buf_dis-card then do:
      474            if v_tbh:available then do:
      475             do transaction :
      476                assign glog = v_tbh:buffer-delete() no-error .
      477              end.
      478            end.
      479            return error substitute("Не найдена ДК &1", p-d-card).
      480         end.
      481         assign
      482         v-h-action           = integer('2':U)
      483         card-num             = buf_dis-tot_.card-num
      484         gds-dis-base         = buf_dis-tot_.gds-dis-base
      485         gds-dis-rubl         = buf_dis-tot_.gds-dis-rubl
      486         gds-tot-base         = buf_dis-tot_.gds-tot-base
      487         gds-tot-rubl         = buf_dis-tot_.gds-tot-rubl
      488         pay-tot-base         = buf_dis-tot_.pay-tot-base
      489         pay-tot-rubl         = buf_dis-tot_.pay-tot-rubl
      490         num-chk              = buf_dis-tot_.num-chk
      491         d-card               = buf_dis-tot_.d-card
      492         first-card           = buf_dis-tot_.first-card
      493         first-main-card      = buf_dis-tot_.first-main-card
      494         main-card            = buf_dis-tot_.main-card
      495         v-byfm               = no
      496         v-bym                = no
      497         v-byf                = no
      498         emitent-host-code#   = buf_dis-card.emitent-host-code
      499         type#                = buf_dis-card.type
      500         .
      501         do transaction :
      502           glog = v_tbh:buffer-create( ).
      503           glog = v_tbh:buffer-copy( v_bh).
      504         end.
      505       end.
      506       return yes.
      507     end method.
      508     method public logical create_dis-tot_date ( input p-d-card as character
      509                                                ,input p-date as date
      510                                                ,input p-caller-id as character
      511                                             ):
      512       define variable glog as logical no-undo .
      513       define variable v-date-char as character no-undo .
      514       define buffer buf_prop-ref for ub.prop-ref.
      515       assign
      516       v-date-char = string(year(p-date), "9999") + "/" +
      517                     string(month(p-date), "99") + "/" +
      518                     string(day(p-date), "99")
      519        v-date-char = v-date-char + "-" + v-date-char
      520        .
      521        find last buf_prop-ref no-lock where
      522                   buf_prop-ref.dtm-code = dtm-code
      523               and buf_prop-ref.sum-id <= v-date-char
      524               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      525               no-error .
      526        if error-status:error then do:
      527           undo, return error substitute( "&1. Не найден Период для даты &2 (доп.иден-р &3) в справочнике итогов&4"
      528                                          , vss-include-info0
      529                                          , string(p-date, "99/99/9999")
      530                                          , p-caller-id
      531                                          , chr(10)
      532                                          ).
      533        end.
      534        dt-code = buf_prop-ref.dt-code.
      535        caller_id = buf_prop-ref.caller_id.
      536        glog = create_dis-tot_ ( p-d-card ) no-error .
      537        if error-status:error then do:
      538          undo, return error return-value .
      539        end.
      540        return glog.
      541     end.
      542     method public logical create_dis-tot_sum-id ( input p-d-card as character
      543                                                ,input p-sum-id as character
      544                                                ,input p-caller-id as character
      545                                             ):
      546       define variable glog as logical no-undo .
      547       define buffer buf_prop-ref for ub.prop-ref.
      548        find last buf_prop-ref no-lock where
      549                   buf_prop-ref.dtm-code = dtm-code
      550               and buf_prop-ref.sum-id   = p-sum-id
      551               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      552               no-error .
      553        if error-status:error then do:
      554           undo, return error substitute( "&1. Не найден ИТОГ &2 (доп.иден-р &3) в справочнике итогов&4"
      555                                          , vss-include-info0
      556                                          , p-sum-id
      557                                          , p-caller-id
      558                                          , chr(10)
      559                                          ).
      560        end.
      561        dt-code = buf_prop-ref.dt-code.
      562        caller_id = buf_prop-ref.caller_id.
      563        glog = create_dis-tot_ ( p-d-card ) no-error .
      564        if error-status:error then do:
      565          undo, return error return-value .
      566        end.
      567        return glog.
      568     end.
      569     method public logical create_dis-tot_ ( input p-d-card as character ):
      570       define variable glog as logical no-undo .
      571       define buffer buf_sysconf for ub.sysconf.
      572       define buffer buf_dis-card for ub.dis-card.
      573       find first buf_dis-card no-lock where
      574                buf_dis-card.d-card = p-d-card no-error.
      575       do transaction :
      576         glog = v_tbh:buffer-create().
      577       end.
      578       if not available buf_dis-card then do:
      579         glog = no.
      580         run can-find_dis-card_ in v_gc ( input p-d-card
      581                                         ,output glog) no-error .
      582         if not glog then do:
      583           run set-error in v_gc (substitute("Неверно задана ДК для создания итогов по ДК(ДК &1)"
      584                                           , d-card
      585                                             )).
      586           return no.
      587         end.
      588         assign
      589         d-card               = p-d-card
      590         buft_dis-tot_.d-card = p-d-card
      591         buft_dis-tot_.host-code = 0
      592         buft_dis-tot_.dt-code        = dt-code
      593         .
      594       end.
      595       else do:
      596         assign
      597         d-card               = p-d-card
      598         first-card           = buf_dis-card.first-card
      599         first-main-card      = buf_dis-card.first-main-card
      600         main-card            = buf_dis-card.main-card
      601         card-num             = buf_dis-card.card-num
      602         buft_dis-tot_.d-card = p-d-card
      603         buft_dis-tot_.host-code = 0
      604         buft_dis-tot_.first-card     = buf_dis-card.first-card
      605         buft_dis-tot_.first-main-card = buf_dis-card.first-main-card
      606         buft_dis-tot_.main-card      = buf_dis-card.main-card
      607         buft_dis-tot_.card-num       = buf_dis-card.card-num
      608         buft_dis-tot_.dt-code        = dt-code
      609         type#                        = buf_dis-card.type
      610         emitent-host-code#           = buf_dis-card.emitent-host-code
      611         .
      612       end.
      613       assign
      614       gds-dis-base         = 0.0
      615       gds-dis-rubl         = 0.0
      616       gds-tot-base         = 0.0
      617       gds-tot-rubl         = 0.0
      618       pay-tot-base         = 0.0
      619       pay-tot-rubl         = 0.0
      620       num-chk              = 0
      621       v-byfm = no
      622       v-bym = no
      623       v-byf = no
      624       v-h-action           = integer('1':U)
      625       .
      626       return yes.
      627     end method.
      628     method private void get-byfm():
      629       define variable v-dis-base as decimal no-undo.
      630       define variable v-dis-rubl as decimal no-undo.
      631       define variable v-tot-base as decimal no-undo.
      632       define variable v-tot-rubl as decimal no-undo.
      633       define variable v-pay-base as decimal no-undo.
      634       define variable v-pay-rubl as decimal no-undo.
      635       define variable v-num-chk as integer no-undo .
      636       define buffer buf_dis-host for ub.dis-host.
      637       if not v-byfm then do:
      638         for each buf_dis-host no-lock where
      639                 buf_dis-host.first-main-card = first-main-card
      640              and buf_dis-host.host-code = 0
      641              and buf_dis-host.dt-code = dt-code:
      642           assign
      643           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      644           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      645           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      646           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      647           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      648           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      649           v-num-chk = v-num-chk + buf_dis-host.num-chk
      650           .
      651         end.
      652         assign
      653         gds-dis-base_byfm#  = v-dis-base
      654         gds-dis-rubl_byfm#  = v-dis-rubl
      655         gds-tot-base_byfm#  = v-tot-base
      656         gds-tot-rubl_byfm#  = v-tot-rubl
      657         pay-tot-base_byfm#  = v-pay-base
      658         pay-tot-rubl_byfm#  = v-pay-rubl
      659         num-chk_byfm#  = v-num-chk
      660         v-byfm = yes
      661         .
      662       end.
      663     end method.
      664     method private void get-bym():
      665       define variable v-dis-base as decimal no-undo.
      666       define variable v-dis-rubl as decimal no-undo.
      667       define variable v-tot-base as decimal no-undo.
      668       define variable v-tot-rubl as decimal no-undo.
      669       define variable v-pay-base as decimal no-undo.
      670       define variable v-pay-rubl as decimal no-undo.
      671       define variable v-num-chk as integer no-undo .
      672       define buffer buf_dis-host for ub.dis-host.
      673       if not v-bym then do:
      674         for each buf_dis-host no-lock where
      675                 buf_dis-host.main-card = main-card
      676              and buf_dis-host.host-code = 0
      677              and buf_dis-host.dt-code = dt-code:
      678           assign
      679           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      680           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      681           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      682           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      683           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      684           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      685           v-num-chk = v-num-chk + buf_dis-host.num-chk
      686           .
      687         end.
      688         assign
      689         gds-dis-base_bym#  = v-dis-base
      690         gds-dis-rubl_bym#  = v-dis-rubl
      691         gds-tot-base_bym#  = v-tot-base
      692         gds-tot-rubl_bym#  = v-tot-rubl
      693         pay-tot-base_bym#  = v-pay-base
      694         pay-tot-rubl_bym#  = v-pay-rubl
      695         num-chk_bym#  = v-num-chk
      696         v-bym = yes
      697         .
      698       end.
      699     end method.
      700     method private void get-byf():
      701       define variable v-dis-base as decimal no-undo.
      702       define variable v-dis-rubl as decimal no-undo.
      703       define variable v-tot-base as decimal no-undo.
      704       define variable v-tot-rubl as decimal no-undo.
      705       define variable v-pay-base as decimal no-undo.
      706       define variable v-pay-rubl as decimal no-undo.
      707       define variable v-num-chk as integer no-undo .
      708       define buffer buf_dis-host for ub.dis-host.
      709       if not v-byf then do:
      710         for each buf_dis-host no-lock where
      711                 buf_dis-host.first-card = first-card
      712              and buf_dis-host.host-code = 0
      713              and buf_dis-host.dt-code = dt-code:
      714           assign
      715           v-dis-base = v-dis-base + buf_dis-host.gds-dis-base
      716           v-dis-rubl = v-dis-rubl + buf_dis-host.gds-dis-rubl
      717           v-tot-base = v-tot-base + buf_dis-host.gds-tot-base
      718           v-tot-rubl = v-tot-rubl + buf_dis-host.gds-tot-rubl
      719           v-pay-base = v-pay-base + buf_dis-host.pay-tot-base
      720           v-pay-rubl = v-pay-rubl + buf_dis-host.pay-tot-rubl
      721           v-num-chk = v-num-chk + buf_dis-host.num-chk
      722           .
      723         end.
      724         assign
      725         gds-dis-base_byf#  = v-dis-base
      726         gds-dis-rubl_byf#  = v-dis-rubl
      727         gds-tot-base_byf#  = v-tot-base
      728         gds-tot-rubl_byf#  = v-tot-rubl
      729         pay-tot-base_byf#  = v-pay-base
      730         pay-tot-rubl_byf#  = v-pay-rubl
      731         num-chk_byf#  = v-num-chk
      732         v-byf = yes
      733         .
      734       end.
      735     end method.
      736     method protected void clear_():
      737       define variable glog as logical no-undo .
      738       v-error-flag = no.
      739       if v_tbh:available then do:
      740         do transaction :
      741           glog = v_tbh:buffer-delete() no-error .
      742         end.
      743       end.
      744       assign
      745       d-card = ''
      746       v-h-action = 0
      747       .
      748     end method.
      749     method public override character ToString( ):
      750       return substitute("ДК &1 глобальный итог срез &2", d-card, dt-code ).
      751     end method.
      752   end class.
