        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Dis-rule:
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: dis-rule.cls $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ibs/th/rul/dis-rule.cls $":U .
        8   define variable vss-description as character no-undo init "Класс Dis-rule".
        9   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10     define protected buffer buf_dis-rule for ub.dis-rule.
       11     define protected property locked_templ-rl-root as integer no-undo
       12     get.
       13     set.
       14     define private property time-templ-rl-root as integer no-undo
       15     get.
       16     set.
       17     define public property current-lock as integer no-undo
       18     get.
       19     set( input p-current-lock as integer):
       20       case p-current-lock:
       21         when no-lock
       22         or when share-lock
       23         or when exclusive-lock then do:
       24           define variable glog as logical no-undo .
       25           glog  = buffer buf_dis-rule:find-current(p-current-lock).
       26           if not glog then do:
       27             return error substitute("Не удалось изменить свойство LOCK для скидки &1", buf_dis-rule.rule-num).
       28           end.
       29         end.
       30       end case.
       31     end set.
       32     define public property rule-num as integer no-undo
       33     get():
       34        if not available buf_dis-rule then do:
       35           return error substitute("Не установлено правило скидки").
       36        end.
       37        return buf_dis-rule.rule-num.
       38     end get.
       39     set( input p-rule-num as integer):
       40       define variable glog as logical no-undo .
       41       glog  = buffer buf_dis-rule:find-first( substitute('where rule-num = "&1"', p-rule-num), current-lock).
       42       if not glog then do:
       43         return error substitute("Не найдено правило скидки с № &1", p-rule-num).
       44       end.
       45       time-templ-rl-root = buf_Dis-rule.time-templ-rl-root.
       46     end set.
       47     CONSTRUCTOR PUBLIC Dis-rule(  input p-rule-num as integer
       48                                  ,input p-current-lock as integer
       49                                ):
       50       define variable glog as logical no-undo .
       51       glog  = buffer buf_dis-rule:find-first( substitute('where rule-num = "&1"', p-rule-num), p-current-lock).
       52       if not glog then do:
       53         return error substitute("Не найдено правило скидки с № &1", p-rule-num).
       54       end.
       55       assign
       56       current-lock = p-current-lock
       57       locked_templ-rl-root = ?
       58       time-templ-rl-root = buf_dis-rule.time-templ-rl-root
       59       .
       60     END CONSTRUCTOR.
       61     method public override character ToString ():
       62       return string(buf_dis-rule.rule-num).
       63     end method.
       64     method public integer ToInteger ():
       65       return buf_dis-rule.rule-num.
       66     end method.
       67     method public integer select-value ( input parParentProc  AS WIDGET-HANDLE
       68                                         ,input p-curr-obj-type as character
       69                                         ,input p-curr-obj-code as integer
       70                                         ,input p-mode as character
       71                                         ,input p-upper-rule-num as integer
       72                                         ,input p-b-code as integer
       73                                         ,input-output p-sts as integer ) :
       74       define variable v-ok as logical no-undo.
       75       define variable v-rid-list as character no-undo .
       76       define buffer buf_dis-rule for ub.dis-rule.
       77       run ref/dis-ruls.w (   input  parparentproc
       78                             ,input p-curr-obj-type
       79                             ,input p-curr-obj-code
       80                             ,input "b-sel"
       81                             ,input p-mode
       82                             ,input p-upper-rule-num
       83                             ,input ?
       84                             ,input p-b-code
       85                             ,input-output p-sts
       86                             ,input-OUTPUT v-rid-list) NO-ERROR.
       87       if v-rid-list <> '':U then do:
       88         define variable glog as logical no-undo .
       89         glog  = buffer buf_dis-rule:find-first( substitute('where recid(rule-num = "&1"', integer(v-rid-list)), current-lock).
       90         find first buf_dis-rule no-lock where
       91                   recid(buf_dis-rule) = integer(v-rid-list) no-error.
       92         if not available buf_dis-rule then return error substitute("Не найдено правило скидки c recid &1", v-rid-list).
       93         assign
       94         rule-num = buf_dis-rule.rule-num
       95         time-templ-rl-root = buf_dis-rule.time-templ-rl-root
       96         .
       97       end.
       98     end method.
       99     method public decimal dis-rule_l20 (
      100                                             input p-rule-num as integer
      101                                            ,input p-date as date
      102                                            ,input p-time as integer
      103                                            ,input p-tot-sum as decimal
      104                                           ):
      105       define variable v-delta as decimal no-undo .
      106       define variable v-start as logical no-undo init yes.
      107       define variable v-discnt-value as decimal no-undo .
      108       define buffer buf_term-dis-rule for ub.dis-rule.
      109       p-rule-num = rule-num.
      110       if buf_dis-rule.sts = integer('0':U)
      111       and yes
      112       then do:
      113         for each buf_term-dis-rule no-lock where
      114                 buf_term-dis-rule.upper-rule-num = p-rule-num:
      115           if buf_term-dis-rule.tot-sum < p-tot-sum then do:
      116             if v-start
      117             or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
      118             then do:
      119               assign
      120               v-discnt-value = buf_term-dis-rule.discnt-value
      121               v-start = no
      122               v-delta = p-tot-sum - buf_term-dis-rule.tot-sum
      123               .
      124             end.
      125           end.
      126         end.
      127         return v-discnt-value.
      128       end.
      129       return 0.0.
      130     end method.
      131   end class.
