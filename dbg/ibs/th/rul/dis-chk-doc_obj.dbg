        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Dis-chk-doc_obj:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-chk-doc_obj.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_gc as handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_pp as widget-handle no-undo.
        7     define protected variable v_lh as widget-handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected variable v_qh as handle no-undo.
       10     define public variable v_bh as handle no-undo.
       11     define public variable v_bdh as handle no-undo.
       12     define public variable v_bbh as handle no-undo.
       13     define protected buffer buf_dis-chk-doc_obj for ub.chk-doc.
       14     define protected temp-table t-dis-chk-doc_obj no-undo like ub.chk-doc.
       15     define protected buffer buft_dis-chk-doc_obj for t-dis-chk-doc_obj.
       16     define protected buffer bufq_dis-chk-doc_obj for ub.chk-doc.
       17     define query query_dis-chk-doc_obj for bufq_dis-chk-doc_obj scrolling.
       18     define public variable v_tbh as handle no-undo.
       19     define private variable v-h-action as integer no-undo .
       20     define public variable temp as integer no-undo.
       21     define public property lock as integer
       22     get.
       23     set.
       24     define public property wait as integer
       25     get.
       26     set.
       27     define protected variable release-flag as logical no-undo .
       28     define private variable v-error-flag as logical no-undo .
       29     define protected variable find_no-error as logical no-undo .
       30     define public variable doc-code as character no-undo .
       31     define public variable d-card as character no-undo .
       32     define public variable discnt as decimal no-undo .
       33     define public variable tot-doc as decimal no-undo .
       34     define public variable netto as decimal no-undo .
       35     define public variable doc-qnty as decimal no-undo .
       36     define public variable chk-type as integer no-undo .
       37     define public variable obj-type  as character no-undo .
       38     define public variable obj-code as integer no-undo .
       39     define public variable base-rate as decimal no-undo .
       40     define public variable base-scale as integer no-undo .
       41     define public variable chk-date as date no-undo .
       42     define public variable chk-time as integer no-undo .
       43   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       44   define protected temp-table temp-call-param no-undo
       45   field call-number as integer
       46   field call-name_ as character
       47   field param-name_ as character
       48   field param-label_ as character
       49   field num-params_ as integer
       50   field call-handle_ as handle
       51   field param-number_ as integer
       52   field param-datatype_ as character
       53   field io-mode_ as character
       54   field character_ as character
       55   field date_ as date
       56   field decimal_ as decimal
       57   field integer_ as integer
       58   field logical_ as logical
       59   index pi is unique primary call-name_ param-number_.
       60   define protected variable v-last-call-name as character no-undo .
       61   define protected variable v-last-call-number as int64 no-undo .
       62     CONSTRUCTOR PUBLIC dis-chk-doc_obj(
       63                                  input parparentproc as widget-handle
       64                                 ,input p-parent-handle as handle
       65                                 ,input p-log-handle as handle
       66                                 ,input p-gc-handle as handle
       67                                 ,input p-cont-handle as handle
       68                                 ,input p-lock as integer
       69                                 ,input p-wait as integer
       70                                 ,input p-temp as integer
       71                               ):
       72   define variable glog as logical no-undo .
       73   assign
       74   v_pp = parparentproc
       75   v_lh = p-log-handle
       76   v_ph = p-parent-handle
       77   v_gc = p-gc-handle
       78   v_cnt = p-cont-handle
       79   lock = p-lock
       80   wait = p-wait
       81   temp = p-temp
       82   .
       83   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-chk-doc_obj',  input this-object) no-error.
       84   if error-status:error then do:
       85     return error substitute("&1 Ошибка создания объекта dis-chk-doc_obj", vss-include-info0).
       86   end.
       87   v_bh = buffer buf_dis-chk-doc_obj:handle.
       88   v_tbh = buffer buft_dis-chk-doc_obj:handle.
       89       doc-code = '':U .
       90       v_qh = query query_dis-chk-doc_obj:handle.
       91       v_bdh = buffer buf_dis-chk-doc_obj:handle.
       92       v_tbh = buffer buft_dis-chk-doc_obj:handle.
       93     end constructor.
       94     destructor public dis-chk-doc_obj():
       95       define buffer buf_temp-call-param for temp-call-param.
       96       define variable glog as logical no-undo .
       97       assign
       98       glog = v_tbh:empty-temp-table() no-error .
       99       find_dis-chk-doc_obj ( input '':U).
      100       for each buf_temp-call-param:
      101         if buf_temp-call-param.param-number = 0 then do:
      102           delete object buf_temp-call-param.call-handle_.
      103         end.
      104         delete buf_temp-call-param.
      105       end.
      106     end destructor.
      107     method public logical find_dis-chk-doc_obj ( p-doc-code as character):
      108      define variable glog as logical no-undo .
      109      dis-chk-doc_objrelease_().
      110      clear_().
      111       if p-doc-code <> '':U then do:
      112         assign
      113         glog =  v_bh:find-first( substitute('where doc-code = "&1" '
      114                                             , p-doc-code
      115                                             ), lock, wait) no-error .
      116         if not glog then do:
      117           if find_no-error then do:
      118             return no.
      119           end.
      120           if lock = No-LOCK then do:
      121             if v_tbh:available then
      122             assign glog = v_tbh:buffer-delete() no-error .
      123             return error substitute("Не найден чек &1", p-doc-code).
      124           end.
      125           if wait = NO-WAIT
      126           and v_bh:locked then do:
      127             if v_tbh:available then
      128             assign glog = v_tbh:buffer-delete() no-error .
      129             if find_no-error then do:
      130               return no.
      131             end.
      132             else do:
      133               return error substitute("чек &1 занята", p-doc-code).
      134             end.
      135           end.
      136         end.
      137         if p-doc-code <> doc-code then do:
      138           assign
      139           glog =  v_bdh:find-first( substitute('where doc-code = "&1"'
      140                                               , p-doc-code
      141                                               ), lock, wait) no-error .
      142           if not glog then do:
      143             return error substitute("Не найден чек &1", p-doc-code).
      144           end.
      145         end.
      146         assign
      147         doc-code             = buf_dis-chk-doc_obj.doc-code
      148         d-card               = buf_dis-chk-doc_obj.d-card
      149         discnt               = buf_dis-chk-doc_obj.discnt
      150         doc-qnty             = buf_dis-chk-doc_obj.doc-qnty
      151         chk-type             = buf_dis-chk-doc_obj.chk-type
      152         obj-type             = buf_dis-chk-doc_obj.obj-type
      153         obj-code             = buf_dis-chk-doc_obj.obj-code
      154         base-rate            = buf_dis-chk-doc_obj.base-rate
      155         base-scale           = 1
      156         chk-date             = buf_dis-chk-doc_obj.chk-date
      157         chk-time             = buf_dis-chk-doc_obj.chk-time
      158         .
      159         glog = v_tbh:buffer-create( ).
      160         glog = v_tbh:buffer-copy( v_bh).
      161       end.
      162       return yes.
      163     end method.
      164     method public logical select_dis-chk-doc_obj ( input p-prepare-phrase-doc as character
      165                                                  ):
      166       define variable glog as logical no-undo.
      167       assign
      168       glog = v_qh:query-prepare( substitute("for each bufq_dis-chk-doc_obj no-lock where &1 "
      169                                ,p-prepare-phrase-doc
      170                                )
      171                                ) no-error .
      172       if not glog then do:
      173         return error substitute("Ошибка подготовки выборки по чекам:&1&2&1&3"
      174                                  , chr(10)
      175                                  , error-status:get-message(1)
      176                                  , p-prepare-phrase-doc
      177                                  ).
      178       end.
      179       assign
      180       glog = v_qh:query-open no-error .
      181       if error-status:error then do:
      182         return error substitute("Ошибка открытия выборки по чекам:&1&2&1&3"
      183                                  , chr(10)
      184                                  , error-status:get-message(1)
      185                                  , v_qh:prepare-string ).
      186       end.
      187     end method.
      188     method public logical get_dis-chk-doc_obj( input p-rec-pos as character):
      189       define variable glog as logical no-undo .
      190       if not v_qh:is-open then do:
      191         return error substitute("Выборка по чекам:&1(&2)&1еще на открыта"
      192                                 , chr(10)
      193                                 , v_qh:prepare-string
      194                                  ).
      195       end.
      196       case p-rec-pos:
      197         when "first" then do:
      198           glog = v_qh:get-first(lock, wait)  .
      199         end.
      200         when "last" then do:
      201           glog = v_qh:get-last(lock, wait)  .
      202         end.
      203         when "next" then do:
      204           glog = v_qh:get-next(lock, wait)  .
      205         end.
      206         when "prev" then do:
      207           glog = v_qh:get-prev(lock, wait)  .
      208         end.
      209       end case.
      210       if glog then do:
      211          assign
      212          glog = find_dis-chk-doc_obj ( input bufq_dis-chk-doc_obj.doc-code) no-error .
      213       end.
      214       return glog.
      215     end method.
      216   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217     method public decimal get_dis-rule-value_decimal ( input p-param-name as character):
      218       define buffer buf_temp-call-param for temp-call-param.
      219       find first buf_temp-call-param where
      220                 buf_temp-call-param.param-name_ = p-param-name
      221             and buf_temp-call-param.call-name_ = v-last-call-name no-error .
      222       if not available buf_temp-call-param then do:
      223         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - отсутствуют"
      224                                      ,vss-include-info2
      225                                      ,v-last-call-name
      226                                      ,p-param-name).
      227       end.
      228       if buf_temp-call-param.call-number <> v-last-call-number then do:
      229         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - уже затерты"
      230                                      ,vss-include-info2
      231                                      ,v-last-call-name
      232                                      ,p-param-name).
      233       end.
      234       return buf_temp-call-param.decimal_.
      235     end method.
      236     method public integer get_dis-rule-value_integer ( input p-param-name as character):
      237       define buffer buf_temp-call-param for temp-call-param.
      238       find first buf_temp-call-param where
      239                 buf_temp-call-param.param-name_ = p-param-name
      240             and buf_temp-call-param.call-name_ = v-last-call-name no-error .
      241       if not available buf_temp-call-param then do:
      242         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - отсутствуют"
      243                                      ,vss-include-info2
      244                                      ,v-last-call-name
      245                                      ,p-param-name).
      246       end.
      247       if buf_temp-call-param.call-number <> v-last-call-number then do:
      248         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - уже затерты"
      249                                      ,vss-include-info2
      250                                      ,v-last-call-name
      251                                      ,p-param-name).
      252       end.
      253       return buf_temp-call-param.integer_.
      254     end method.
      255     method public logical get_dis-rule-value_logical ( input p-param-name as character):
      256       define buffer buf_temp-call-param for temp-call-param.
      257       find first buf_temp-call-param where
      258                 buf_temp-call-param.param-name_ = p-param-name
      259             and buf_temp-call-param.call-name_ = v-last-call-name no-error .
      260       if not available buf_temp-call-param then do:
      261         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - отсутствуют"
      262                                      ,vss-include-info2
      263                                      ,v-last-call-name
      264                                      ,p-param-name).
      265       end.
      266       if buf_temp-call-param.call-number <> v-last-call-number then do:
      267         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - уже затерты"
      268                                      ,vss-include-info2
      269                                      ,v-last-call-name
      270                                      ,p-param-name).
      271       end.
      272       return buf_temp-call-param.logical_.
      273     end method.
      274     method protected void clear_():
      275       define variable glog as logical no-undo .
      276       v-error-flag = no.
      277       if v_tbh:available then
      278       glog = v_tbh:buffer-delete() no-error .
      279       assign
      280       doc-code = ''
      281       chk-type = 0
      282       base-rate = 0
      283       base-scale = 0
      284       .
      285     end method.
      286     method public void Dis-chk-doc_objrelease_ ( ):
      287       define variable glog as logical no-undo .
      288       glog = v_bh:buffer-release() no-error .
      289       glog = v_bdh:buffer-release() no-error .
      290       clear_().
      291     end method.
      292     method public handle get_dis-chk-doc_obj ( ):
      293       return v_bh.
      294     end method.
      295   method public logical esys-add-dump (
      296                                             input p-esys-cmd-proc-handle as handle
      297                                           , input p-esys-cmd-code as integer
      298                                           , input p-action as character     ):
      299     define variable v-esys-rec-ord as integer no-undo .
      300     run add-dump in p-esys-cmd-proc-handle
      301       (input p-esys-cmd-code
      302       ,input 'chk-doc':U
      303       ,input p-action
      304       ,input v_tbh
      305       ,input '':U
      306       ,output v-esys-rec-ord
      307       ) no-error .
      308     if error-status :error
      309     then do:
      310       delete procedure p-esys-cmd-proc-handle .
      311       run set-error in v_gc (substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
      312                                           ,chr(10)
      313                                           ,'dis-card':U
      314                                           ,p-esys-cmd-code
      315                                           ,error-status:get-message(1)
      316                                           ,return-value
      317                                           )) .
      318       return no.
      319     end.
      320     return yes.
      321   end method.
      322     method public override character ToString( ):
      323       return substitute("Чек &1", doc-code).
      324     end method.
      325   end class.
