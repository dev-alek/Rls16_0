      216     CONSTRUCTOR PUBLIC dis-tot_obj(
      217                                  input parparentproc as widget-handle
      218                                 ,input p-parent-handle as handle
      219                                 ,input p-log-handle as handle
      220                                 ,input p-gc-handle as handle
      221                                 ,input p-cont-handle as handle
      222                                 ,input p-lock as integer
      223                                 ,input p-wait as integer
      224                                 ,input p-temp as integer
      225                               ):
      226   define variable glog as logical no-undo .
      227   assign
      228   v_pp = parparentproc
      229   v_lh = p-log-handle
      230   v_ph = p-parent-handle
      231   v_gc = p-gc-handle
      232   v_cnt = p-cont-handle
      233   lock = p-lock
      234   wait = p-wait
      235   temp = p-temp
      236   .
      237   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_obj',  input this-object) no-error.
      238   if error-status:error then do:
      239     return error substitute("&1 Ошибка создания объекта dis-tot_obj", vss-include-info0).
      240   end.
      241   v_bh = buffer buf_dis-tot_obj:handle.
      242   v_tbh = buffer buft_dis-tot_obj:handle.
      243       d-card = '':U.
      244       dtm-code  = 1.
      245       dt-code = 0.
      246       caller_id = '':U.
      247     end constructor.
      248     CONSTRUCTOR PUBLIC dis-tot_obj(
      249                                  input parparentproc as widget-handle
      250                                 ,input p-parent-handle as handle
      251                                 ,input p-log-handle as handle
      252                                 ,input p-gc-handle as handle
      253                                 ,input p-cont-handle as handle
      254                                 ,input p-lock as integer
      255                                 ,input p-wait as integer
      256                                 ,input p-temp as integer
      257                                 ,input p-dtm-code as integer
      258                               ):
      259   define variable glog as logical no-undo .
      260   assign
      261   v_pp = parparentproc
      262   v_lh = p-log-handle
      263   v_ph = p-parent-handle
      264   v_gc = p-gc-handle
      265   v_cnt = p-cont-handle
      266   lock = p-lock
      267   wait = p-wait
      268   temp = p-temp
      269   .
      270   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-tot_obj',  input this-object) no-error.
      271   if error-status:error then do:
      272     return error substitute("&1 Ошибка создания объекта dis-tot_obj", vss-include-info0).
      273   end.
      274   v_bh = buffer buf_dis-tot_obj:handle.
      275   v_tbh = buffer buft_dis-tot_obj:handle.
      276       d-card = '':U.
      277       dtm-code = p-dtm-code.
      278     end constructor.
      279     destructor public dis-tot_obj():
      280       define variable glog as logical no-undo .
      281       assign
      282       glog = v_tbh:empty-temp-table() no-error .
      283       find_dis-tot_obj ( input '':U, input '':U, input 0).
      284     end destructor.
      285     method public void Dis-tot_objrelease_ (  ):
      286       define variable glog as logical no-undo .
      287       do transaction :
      288         glog = v_bh:buffer-release() no-error .
      289       end.
      290       clear_().
      291     end method.
      292     method public handle get_dis-tot_obj ( ):
      293       return v_bh.
      294     end method.
      295     method public logical set_dis-tot_obj ( input p-bh as handle):
      296       define variable glog as logical no-undo .
      297       do transaction :
      298         glog = v_bh:buffer-copy ( p-bh).
      299       end.
      300       return glog.
      301     end method.
      302     method public logical find_dis-tot_obj_sum-id ( p-d-card as character
      303                                         , p-obj-type as character
      304                                         , p-obj-code as integer
      305                                         , p-sum-id as character
      306                                         , p-caller-id as character
      307                                             ):
      308       define variable glog as logical no-undo .
      309       define buffer buf_prop-ref for ub.prop-ref.
      310        find first buf_prop-ref no-lock where
      311                   buf_prop-ref.dtm-code = dtm-code
      312               and buf_prop-ref.sum-id  = p-sum-id
      313               and buf_prop-ref.caller_id = p-caller-id
      314               no-error .
      315        if error-status:error then do:
      316           undo, return error substitute( "&1. Не найден ИТОГ(СРЕЗ) c ID &2 (доп иден-р &3) в справочнике итогов&4" +
      317                                          "Код объекта-операнда &5"
      318                                          , vss-include-info0
      319                                          , p-sum-id
      320                                          , p-caller-id
      321                                          , chr(10)
      322                                          ,dtm-code
      323                                          ).
      324        end.
      325        dt-code = buf_prop-ref.dt-code.
      326        sum-id = buf_prop-ref.sum-id.
      327        caller_id = buf_prop-ref.caller_id.
      328        glog = find_dis-tot_obj ( p-d-card, p-obj-type, p-obj-code ) no-error .
      329        if error-status:error then do:
      330          undo, return error return-value .
      331        end.
      332        return glog.
      333      end method.
      334      method public logical find_dis-tot_obj_date ( p-d-card as character
      335                                             , p-obj-type as character
      336                                             , p-obj-code as integer
      337                                             , p-date as date
      338                                             , p-caller-id as character
      339                                             ):
      340       define variable glog as logical no-undo .
      341       define variable v-date-char as character no-undo .
      342       define buffer buf_prop-ref for ub.prop-ref.
      343       assign
      344       v-date-char = string(year(p-date), "9999") + "/" +
      345                     string(month(p-date), "99") + "/" +
      346                     string(day(p-date), "99")
      347        v-date-char = v-date-char + "-" + v-date-char
      348        .
      349        find last buf_prop-ref no-lock where
      350                   buf_prop-ref.dtm-code = dtm-code
      351               and buf_prop-ref.sum-id <= v-date-char
      352               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      353        if error-status:error then do:
      354           undo, return error substitute( "&1. Не найден Период для даты &2 (доп.иден-р &3) в справочнике итогов&4"
      355                                          , vss-include-info0
      356                                          , string(p-date, "99/99/9999")
      357                                          , p-caller-id
      358                                          , chr(10)
      359                                          ).
      360        end.
      361        dt-code = buf_prop-ref.dt-code.
      362        caller_id = buf_prop-ref.caller_id.
      363        glog = find_dis-tot_obj ( p-d-card , p-obj-type , p-obj-code ) no-error .
      364        if error-status:error then do:
      365          undo, return error return-value .
      366        end.
      367        return glog.
      368      end method.
      369      method public logical dis-tot_objsave ( ):
      370      define variable glog as logical no-undo .
      371      define variable loc-action as integer no-undo .
      372      define buffer buf_dis-card for ub.dis-card.
      373       if d-card <> '':U then do:
      374           if (pay-tot-base + pay-tot-rubl +
      375               gds-dis-base + gds-dis-rubl +
      376               gds-tot-base + gds-tot-rubl +
      377               num-chk) = ? then do:
      378             run set-error in v_gc (substitute("Не задано ( =  ?) значение одной из сумм или кол-во чеков для ДК &1 &2&3"
      379                                               , d-card
      380                                               , obj-type
      381                                               , obj-code
      382                                               )).
      383             return no.
      384           end.
      385           if (pay-tot-base = 0.0) <> (pay-tot-rubl = 0.0) then do:
      386             run set-error in v_gc (substitute("Если сумма оплат в нац.вал. = 0, то сумма оплат в баз.вал. тоже должна = 0 и наборот (ДК &1 &2&3)"
      387                                               , d-card
      388                                               , obj-type
      389                                               , obj-code)).
      390             return no.
      391           end.
      392           assign
      393           buft_Dis-tot_obj.gds-dis-base  = gds-dis-base
      394           buft_Dis-tot_obj.gds-dis-rubl  = gds-dis-rubl
      395           buft_Dis-tot_obj.gds-tot-base  = gds-tot-base
      396           buft_Dis-tot_obj.gds-tot-rubl  = gds-tot-rubl
      397           buft_Dis-tot_obj.pay-tot-base  = pay-tot-base
      398           buft_Dis-tot_obj.pay-tot-rubl  = pay-tot-rubl
      399           buft_dis-tot_obj.gds-tot-b0    = gds-tot-b0
      400           buft_dis-tot_obj.gds-tot-r0    = gds-tot-r0
      401           buft_Dis-tot_obj.num-chk       = num-chk
      402           .
      403           glog = no.
      404           if v_bh:available then  do:
      405             glog = v_bh:buffer-compare(v_tbh).
      406           end.
      407           if not glog
      408           or v-h-action = integer('1':U)
      409           then do:
      410             if temp >= 0 then do:
      411               loc-action = v-h-action .
      412               if v-h-action = integer('1':U) then do:
      413                 find first buf_Dis-card no-lock where
      414                 buf_Dis-card.d-card = d-card no-error.
      415                 if not available buf_dis-card then do:
      416                   undo, return error substitute( "&1. Не найдена ДК &2 при создании итога по ДК по &3&4"
      417                                                 , vss-include-info0
      418                                                 , d-card
      419                                                 , obj-type
      420                                                 , obj-code
      421                                                 ).
      422                 end.
      423                 assign
      424                 type#                        = buf_dis-card.type
      425                 emitent-host-code#           = buf_dis-card.emitent-host-code
      426                 .
      427                 do transaction :
      428                   glog = v_tbh:buffer-copy( buffer buf_Dis-card:handle).
      429                   glog = v_bh:buffer-create( ).
      430                   glog = v_bh:buffer-copy( v_tbh).
      431                 end.
      432                 v-h-action = integer('2':U) .
      433             end.
      434               run dis-objh_write-dis-obj-rul in v_gc ( buffer buf_dis-tot_obj
      435                                                       ,input type#
      436                                                       ,input emitent-host-code#
      437                                                       ,input 1
      438                                                       ,input loc-action).
      439               do transaction :
      440                 glog = v_bh:buffer-copy( v_tbh).
      441               end.
      442               run dis-objh_send-dis-obj-rul in v_gc ( buffer buf_dis-tot_obj
      443                                                       ,input type#
      444                                                       ,input emitent-host-code#
      445                                                       ,input 1
      446                                                       ,input loc-action).
      447             end.
      448             do transaction :
      449               glog = v_bh:buffer-release() no-error .
      450             end.
      451             if error-status:error then do:
      452               undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      453             end.
      454             if temp < 0 then do:
      455               run tempcont_create-changes in v_cnt (
      456                                               input 'dis-obj':U
      457                                              ,input v_bh
      458                                              ,input v_tbh
      459                                              ,input v-h-action) no-error.
      460               if error-status:error then do:
      461                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      462               end.
      463             end.
      464           end.
      465       end.
      466     end method.
      467      method public logical find_dis-tot_obj ( p-d-card as character, p-obj-type as character, p-obj-code as integer):
      468      define variable glog as logical no-undo .
      469      define buffer buf_dis-card for ub.dis-card.
      470       dis-tot_objrelease_().
      471       clear_().
      472       if p-d-card <> '':U then do:
      473         v-h-action           = integer('2':U).
      474         do transaction :
      475           assign
      476           glog =  v_bh:find-first( substitute('where d-card = "&1" and obj-type = "&2" and obj-code = &3 and dt-code = &4'
      477                                   , p-d-card
      478                                   , p-obj-type
      479                                   , p-obj-code
      480                                   , dt-code
      481                                   ), lock, wait) no-error .
      482         end.
      483         if not glog then do:
      484           if lock = No-LOCK then do:
      485             if v_tbh:available then do:
      486               do transaction :
      487                 assign glog = v_tbh:buffer-delete() no-error .
      488               end.
      489             end.
      490             return no.
      491           end.
      492           if wait = NO-WAIT
      493           and v_bh:locked then do:
      494             if v_tbh:available then do:
      495               do transaction :
      496                 assign glog = v_tbh:buffer-delete() no-error .
      497               end.
      498             end.
      499             return error substitute("Запись итогов ДК &1 по &2&3 занята", p-d-card, p-obj-type, p-obj-code).
      500           end.
      501           if v_tbh:available then do:
      502             do transaction :
      503               assign glog = v_tbh:buffer-delete() no-error .
      504             end.
      505           end.
      506           return no.
      507         end.
      508         find first buf_dis-card no-lock where
      509                   buf_dis-card.d-card = p-d-card no-error .
      510         if not available buf_dis-card then do:
      511            return error substitute("Не найдена ДК &1", p-d-card).
      512         end.
      513         assign
      514         v-h-action           = integer('2':U)
      515         card-num             = buf_dis-tot_obj.card-num
      516         gds-dis-base         = buf_dis-tot_obj.gds-dis-base
      517         gds-dis-rubl         = buf_dis-tot_obj.gds-dis-rubl
      518         gds-tot-base         = buf_dis-tot_obj.gds-tot-base
      519         gds-tot-rubl         = buf_dis-tot_obj.gds-tot-rubl
      520         gds-tot-b0           = buf_dis-tot_obj.gds-tot-b0
      521         gds-tot-r0           = buf_dis-tot_obj.gds-tot-r0
      522         pay-tot-base         = buf_dis-tot_obj.pay-tot-base
      523         pay-tot-rubl         = buf_dis-tot_obj.pay-tot-rubl
      524         num-chk              = buf_dis-tot_obj.num-chk
      525         d-card               = buf_dis-tot_obj.d-card
      526         first-card           = buf_dis-tot_obj.first-card
      527         first-main-card      = buf_dis-tot_obj.first-main-card
      528         main-card            = buf_dis-tot_obj.main-card
      529         obj-type             = buf_dis-tot_obj.obj-type
      530         obj-code             = buf_dis-tot_obj.obj-code
      531         host-code            = buf_dis-tot_obj.host-code
      532         v-byfm               = no
      533         v-bym                = no
      534         v-byf                = no
      535         emitent-host-code#   = buf_dis-card.emitent-host-code
      536         type#                = buf_dis-card.type
      537         .
      538         do transaction :
      539           glog = v_tbh:buffer-create( ).
      540           glog = v_tbh:buffer-copy( v_bh).
      541         end.
      542       end.
      543       return yes.
      544     end method.
      545     method public logical create_dis-tot_obj_date ( input p-d-card as character
      546                                                ,input p-obj-type as character
      547                                                ,input p-obj-code as integer
      548                                                ,input p-date as date
      549                                                ,input p-caller-id as character
      550                                             ):
      551       define variable glog as logical no-undo .
      552       define variable v-date-char as character no-undo .
      553       define buffer buf_prop-ref for ub.prop-ref.
      554       assign
      555       v-date-char = string(year(p-date), "9999") + "/" +
      556                     string(month(p-date), "99") + "/" +
      557                     string(day(p-date), "99")
      558        v-date-char = v-date-char + "-" + v-date-char
      559        .
      560        find last buf_prop-ref no-lock where
      561                   buf_prop-ref.dtm-code = dtm-code
      562               and buf_prop-ref.sum-id <= v-date-char
      563               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      564               no-error .
      565        if error-status:error then do:
      566           undo, return error substitute( "&1. Не найден Период для даты &2 в справочнике итогов&3"
      567                                          , vss-include-info0
      568                                          , string(p-date, "99/99/9999")
      569                                          , chr(10)
      570                                          ).
      571        end.
      572        dt-code = buf_prop-ref.dt-code.
      573        caller_id = buf_prop-ref.caller_id.
      574        glog = create_dis-tot_obj ( p-d-card , p-obj-type , p-obj-code ) no-error .
      575        if error-status:error then do:
      576          undo, return error return-value .
      577        end.
      578        return glog.
      579     end.
      580     method public logical create_dis-tot_obj_sum-id ( input p-d-card as character
      581                                                ,input p-obj-type as character
      582                                                ,input p-obj-code as integer
      583                                                ,input p-sum-id as character
      584                                                ,input p-caller-id as character
      585                                             ):
      586       define variable glog as logical no-undo .
      587       define buffer buf_prop-ref for ub.prop-ref.
      588        find last buf_prop-ref no-lock where
      589                   buf_prop-ref.dtm-code = dtm-code
      590               and buf_prop-ref.sum-id = p-sum-id
      591               and buf_prop-ref.caller_id = p-caller-id use-index idtsum
      592               no-error .
      593        if error-status:error then do:
      594           undo, return error substitute( "&1. Не найден ИТОГ &2 в справочнике итогов&3"
      595                                          , vss-include-info0
      596                                          , p-sum-id
      597                                          , chr(10)
      598                                          ).
      599        end.
      600        dt-code = buf_prop-ref.dt-code.
      601        caller_id = buf_prop-ref.caller_id.
      602        glog = create_dis-tot_obj ( p-d-card , p-obj-type , p-obj-code ) no-error .
      603        if error-status:error then do:
      604          undo, return error return-value .
      605        end.
      606        return glog.
      607     end.
      608     method public logical create_dis-tot_obj ( input p-d-card as character
      609                                                ,input p-obj-type as character
      610                                                ,input p-obj-code as integer):
      611       define variable glog as logical no-undo .
      612       define buffer buf_clients for ub.clients.
      613       define buffer buf_dis-card for ub.dis-card.
      614       define buffer buf_sysconf for ub.sysconf.
      615       find first buf_clients no-lock where
      616                 buf_clients.obj-type = p-obj-type
      617             and buf_clients.obj-code = p-obj-code no-error.
      618       if not available buf_clients
      619       or not (p-obj-type = 'маг':U or p-obj-type = 'скл':U)
      620       then do:
      621         run set-error in v_gc (substitute("Неверно задан объект для создания итого по ДК(ДК &1 &2&3)"
      622                                           , d-card
      623                                           , p-obj-type
      624                                           , p-obj-code)).
      625         return no.
      626       end.
      627       find first buf_sysconf no-lock where
      628                 buf_sysconf.host-code = buf_clients.host-code no-error.
      629       if not available buf_clients then do:
      630         run set-error in v_gc (substitute("Неверно задан объект для создания итогов по ДК - не найдена фирма &4(ДК &1 &2&3)"
      631                                           , d-card
      632                                           , p-obj-type
      633                                           , p-obj-code
      634                                           , buf_clients.host-code
      635                                           )).
      636         return no.
      637       end.
      638       find first buf_dis-card no-lock where
      639                buf_dis-card.d-card = p-d-card no-error.
      640       do transaction :
      641         glog = v_tbh:buffer-create( ).
      642       end.
      643       if not available buf_dis-card then do:
      644         glog = no.
      645         run can-find_dis-card_ in v_gc ( input p-d-card
      646                                         ,output glog) no-error .
      647         if not glog then do:
      648           run set-error in v_gc (substitute("Неверно задана ДК для создания итогов по ДК(ДК &1 &2&3)"
      649                                           , d-card
      650                                           , p-obj-type
      651                                           , p-obj-code
      652                                             )).
      653           return no.
      654         end.
      655         assign
      656         d-card = p-d-card
      657         host-code            = buf_clients.host-code
      658         base-code            = buf_sysconf.base-code
      659         obj-type             = p-obj-type
      660         obj-code             = p-obj-code
      661         buft_dis-tot_obj.d-card = p-d-card
      662         buft_dis-tot_obj.obj-type = p-obj-type
      663         buft_dis-tot_obj.obj-code = p-obj-code
      664         buft_dis-tot_obj.host-code = buf_clients.host-code
      665         .
      666       end.
      667       else do:
      668         assign
      669         d-card = p-d-card
      670         card-num             = buf_dis-card.card-num
      671         first-card           = buf_dis-card.first-card
      672         first-main-card      = buf_dis-card.first-main-card
      673         main-card            = buf_dis-card.main-card
      674         host-code            = buf_clients.host-code
      675         base-code            = buf_sysconf.base-code
      676         obj-type             = p-obj-type
      677         obj-code             = p-obj-code
      678         buft_dis-tot_obj.d-card = p-d-card
      679         buft_dis-tot_obj.obj-type = p-obj-type
      680         buft_dis-tot_obj.obj-code = p-obj-code
      681         buft_dis-tot_obj.host-code = buf_clients.host-code
      682         buft_dis-tot_obj.card-num = buf_dis-card.card-num
      683         buft_dis-tot_obj.first-card     = buf_dis-card.first-card
      684         buft_dis-tot_obj.first-main-card = buf_dis-card.first-main-card
      685         buft_dis-tot_obj.main-card      = buf_dis-card.main-card
      686         type#                        = buf_dis-card.type
      687         emitent-host-code#           = buf_dis-card.emitent-host-code
      688         .
      689       end.
      690       assign
      691       buft_dis-tot_obj.dt-code        = dt-code
      692       gds-dis-base         = 0.0
      693       gds-dis-rubl         = 0.0
      694       gds-tot-base         = 0.0
      695       gds-tot-rubl         = 0.0
      696       gds-tot-b0           = 0.0
      697       gds-tot-r0           = 0.0
      698       pay-tot-base         = 0.0
      699       pay-tot-rubl         = 0.0
      700       num-chk              = 0
      701       v-byfm = no
      702       v-bym = no
      703       v-byf = no
      704       v-h-action           = integer('1':U)
      705       .
      706       return yes.
      707     end method.
      708     method private void get-byfm():
      709       define variable v-dis-base as decimal no-undo.
      710       define variable v-dis-rubl as decimal no-undo.
      711       define variable v-tot-base as decimal no-undo.
      712       define variable v-tot-rubl as decimal no-undo.
      713       define variable v-tot-b0 as decimal no-undo.
      714       define variable v-tot-r0 as decimal no-undo.
      715       define variable v-pay-base as decimal no-undo.
      716       define variable v-pay-rubl as decimal no-undo.
      717       define variable v-num-chk as integer no-undo .
      718       define buffer buf_dis-obj for ub.dis-obj.
      719       if not v-byfm then do:
      720         for each buf_dis-obj no-lock where
      721                 buf_dis-obj.first-main-card = first-main-card
      722              and buf_dis-obj.dt-code = dt-code:
      723           assign
      724           v-dis-base = v-dis-base + buf_dis-obj.gds-dis-base
      725           v-dis-rubl = v-dis-rubl + buf_dis-obj.gds-dis-rubl
      726           v-tot-base = v-tot-base + buf_dis-obj.gds-tot-base
      727           v-tot-rubl = v-tot-rubl + buf_dis-obj.gds-tot-rubl
      728           v-pay-base = v-pay-base + buf_dis-obj.pay-tot-base
      729           v-pay-rubl = v-pay-rubl + buf_dis-obj.pay-tot-rubl
      730           v-tot-b0 = v-tot-b0 + buf_dis-obj.gds-tot-b0
      731           v-tot-r0 = v-tot-r0 + buf_dis-obj.gds-tot-r0
      732           v-num-chk = v-num-chk + buf_dis-obj.num-chk
      733           .
      734         end.
      735         assign
      736         gds-dis-base_byfm#  = v-dis-base
      737         gds-dis-rubl_byfm#  = v-dis-rubl
      738         gds-tot-base_byfm#  = v-tot-base
      739         gds-tot-rubl_byfm#  = v-tot-rubl
      740         gds-tot-b0_byfm#  = v-tot-b0
      741         gds-tot-r0_byfm#  = v-tot-r0
      742         pay-tot-base_byfm#  = v-pay-base
      743         pay-tot-rubl_byfm#  = v-pay-rubl
      744         num-chk_byfm#  = v-num-chk
      745         v-byfm = yes
      746         .
      747       end.
      748     end method.
      749     method private void get-bym():
      750       define variable v-dis-base as decimal no-undo.
      751       define variable v-dis-rubl as decimal no-undo.
      752       define variable v-tot-base as decimal no-undo.
      753       define variable v-tot-rubl as decimal no-undo.
      754       define variable v-tot-b0 as decimal no-undo.
      755       define variable v-tot-r0 as decimal no-undo.
      756       define variable v-pay-base as decimal no-undo.
      757       define variable v-pay-rubl as decimal no-undo.
      758       define variable v-num-chk as integer no-undo .
      759       define buffer buf_dis-obj for ub.dis-obj.
      760       if not v-bym then do:
      761         for each buf_dis-obj no-lock where
      762                 buf_dis-obj.main-card = main-card
      763              and buf_dis-obj.dt-code = dt-code:
      764           assign
      765           v-dis-base = v-dis-base + buf_dis-obj.gds-dis-base
      766           v-dis-rubl = v-dis-rubl + buf_dis-obj.gds-dis-rubl
      767           v-tot-base = v-tot-base + buf_dis-obj.gds-tot-base
      768           v-tot-rubl = v-tot-rubl + buf_dis-obj.gds-tot-rubl
      769           v-pay-base = v-pay-base + buf_dis-obj.pay-tot-base
      770           v-pay-rubl = v-pay-rubl + buf_dis-obj.pay-tot-rubl
      771           v-tot-b0 = v-tot-b0 + buf_dis-obj.gds-tot-b0
      772           v-tot-r0 = v-tot-r0 + buf_dis-obj.gds-tot-r0
      773           v-num-chk = v-num-chk + buf_dis-obj.num-chk
      774           .
      775         end.
      776         assign
      777         gds-dis-base_bym#  = v-dis-base
      778         gds-dis-rubl_bym#  = v-dis-rubl
      779         gds-tot-base_bym#  = v-tot-base
      780         gds-tot-rubl_bym#  = v-tot-rubl
      781         gds-tot-b0_bym#  = v-tot-b0
      782         gds-tot-r0_bym#  = v-tot-r0
      783         pay-tot-base_bym#  = v-pay-base
      784         pay-tot-rubl_bym#  = v-pay-rubl
      785         num-chk_bym#  = v-num-chk
      786         v-bym = yes
      787         .
      788       end.
      789     end method.
      790     method private void get-byf():
      791       define variable v-dis-base as decimal no-undo.
      792       define variable v-dis-rubl as decimal no-undo.
      793       define variable v-tot-base as decimal no-undo.
      794       define variable v-tot-rubl as decimal no-undo.
      795       define variable v-tot-b0 as decimal no-undo.
      796       define variable v-tot-r0 as decimal no-undo.
      797       define variable v-pay-base as decimal no-undo.
      798       define variable v-pay-rubl as decimal no-undo.
      799       define variable v-num-chk as integer no-undo .
      800       define buffer buf_dis-obj for ub.dis-obj.
      801       if not v-byf then do:
      802         for each buf_dis-obj no-lock where
      803                 buf_dis-obj.first-card = first-card
      804              and buf_dis-obj.dt-code = dt-code:
      805           assign
      806           v-dis-base = v-dis-base + buf_dis-obj.gds-dis-base
      807           v-dis-rubl = v-dis-rubl + buf_dis-obj.gds-dis-rubl
      808           v-tot-base = v-tot-base + buf_dis-obj.gds-tot-base
      809           v-tot-rubl = v-tot-rubl + buf_dis-obj.gds-tot-rubl
      810           v-pay-base = v-pay-base + buf_dis-obj.pay-tot-base
      811           v-pay-rubl = v-pay-rubl + buf_dis-obj.pay-tot-rubl
      812           v-tot-b0 = v-tot-b0 + buf_dis-obj.gds-tot-b0
      813           v-tot-r0 = v-tot-r0 + buf_dis-obj.gds-tot-r0
      814           v-num-chk = v-num-chk + buf_dis-obj.num-chk
      815           .
      816         end.
      817         assign
      818         gds-dis-base_byf#  = v-dis-base
      819         gds-dis-rubl_byf#  = v-dis-rubl
      820         gds-tot-base_byf#  = v-tot-base
      821         gds-tot-rubl_byf#  = v-tot-rubl
      822         gds-tot-b0_byf#  = v-tot-b0
      823         gds-tot-r0_byf#  = v-tot-r0
      824         pay-tot-base_byf#  = v-pay-base
      825         pay-tot-rubl_byf#  = v-pay-rubl
      826         num-chk_byf#  = v-num-chk
      827         v-byf = yes
      828         .
      829       end.
      830     end method.
      831     method protected void clear_():
      832       define variable glog as logical no-undo .
      833       v-error-flag = no.
      834       if v_tbh:available then do:
      835         do transaction :
      836           glog = v_tbh:buffer-delete() no-error .
      837         end.
      838       end.
      839       assign
      840       d-card = ''
      841       v-h-action = 0
      842       .
      843     end method.
      844     method public override character ToString( ):
      845       return substitute("&1 &2&3 срез", d-card , obj-type, obj-code, dt-code ).
      846     end method.
      847   end class.
