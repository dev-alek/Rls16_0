       52     CONSTRUCTOR PUBLIC Sel-goods-discount_(
       53                                  input parparentproc as widget-handle
       54                                 ,input p-parent-handle as handle
       55                                 ,input p-log-handle as handle
       56                                 ,input p-gc-handle as handle
       57                                 ,input p-cont-handle as handle
       58                                 ,input p-lock as integer
       59                                 ,input p-wait as integer
       60                                 ,input p-temp as integer
       61                                 ,input p-dtm-code as integer
       62                               ):
       63   define variable glog as logical no-undo .
       64   assign
       65   v_pp = parparentproc
       66   v_lh = p-log-handle
       67   v_ph = p-parent-handle
       68   v_gc = p-gc-handle
       69   v_cnt = p-cont-handle
       70   lock = p-lock
       71   wait = p-wait
       72   temp = p-temp
       73   .
       74   run garbcoll_create-gc-entry in p-gc-handle (input 'Sel-goods-discount_',  input this-object) no-error.
       75   if error-status:error then do:
       76     return error substitute("&1 Ошибка создания объекта Sel-goods-discount_", vss-include-info0).
       77   end.
       78   v_bh = buffer buf_Sel-goods-discount_:handle.
       79   v_tbh = buffer buft_Sel-goods-discount_:handle.
       80       assign
       81       d-card = '':U
       82       dtm-code = p-dtm-code
       83       dt-code = 0
       84       node-code# = 0
       85       caller_id = '':U
       86       .
       87       for each buf_prop-map  where buf_prop-map.dtm-code = p-dtm-code
       88       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
       89       :
       90         create buft_Sel-goods-discount_.
       91         assign
       92         buft_Sel-goods-discount_.dtm-code = buf_prop-map.dtm-code
       93         buft_Sel-goods-discount_.node-code = buf_prop-map.node-code
       94         buft_Sel-goods-discount_.node-name = buf_prop-map.node-name
       95         buft_Sel-goods-discount_.ordinal = buf_prop-map.ordinal
       96         buft_Sel-goods-discount_.init-value-character = buf_prop-map.init-value-character
       97         buft_Sel-goods-discount_.init-value-date      = buf_prop-map.init-value-date
       98         buft_Sel-goods-discount_.init-value-decimal   = buf_prop-map.init-value-decimal
       99         buft_Sel-goods-discount_.init-value-integer   = buf_prop-map.init-value-integer
      100         buft_Sel-goods-discount_.init-value-logical   = buf_prop-map.init-value-logical
      101         num-members = num-members + 1
      102         .
      103       end.
      104     end constructor.
      105     destructor public Sel-goods-discount_():
      106       define variable glog as logical no-undo .
      107       for each buft_Sel-goods-discount_:
      108         delete buft_Sel-goods-discount_.
      109       end.
      110       find_Sel-goods-discount_ ( input '':U).
      111     end destructor.
      112     method public void Sel-goods-discount_release_ ( ):
      113       define variable glog as logical no-undo .
      114       glog = v_bh:buffer-release() no-error .
      115       clear_().
      116     end method.
      117     method public handle get_Sel-goods-discount_ ( ):
      118       return v_bh.
      119     end method.
      120     method public logical set_Sel-goods-discount_ ( input p-bh as handle):
      121       define variable glog as logical no-undo .
      122       glog = v_bh:buffer-copy ( p-bh).
      123       return glog.
      124     end method.
      125     method public logical find_Sel-goods-discount_sum-id ( p-d-card as character
      126                                         , p-sum-id as character
      127                                         , p-caller-id as character
      128                                             ):
      129       define variable glog as logical no-undo .
      130       define variable v-date-char as character no-undo .
      131       define buffer buf_prop-ref for ub.prop-ref.
      132       find first buf_prop-ref no-lock where
      133                   buf_prop-ref.dtm-code = dtm-code
      134               and buf_prop-ref.sum-id = p-sum-id
      135               and buf_prop-ref.caller_id = p-caller-id no-error .
      136        if error-status:error then do:
      137           undo, return error substitute( "&1. Не найден Итог &2 (доп.иден-р &3) в справочнике итогов&4"
      138                                          , vss-include-info0
      139                                          , p-sum-id
      140                                          , p-caller-id
      141                                          , chr(10)
      142                                          ).
      143        end.
      144        assign
      145        dt-code = buf_prop-ref.dt-code
      146        sum-id = buf_prop-ref.sum-id
      147        caller_id = buf_prop-ref.caller_id
      148        .
      149        glog = find_Sel-goods-discount_ ( p-d-card ) no-error .
      150        if error-status:error then do:
      151          undo, return error return-value .
      152        end.
      153        return glog.
      154      end method.
      155      method public logical Sel-goods-discount_save ( ):
      156      define variable glog as logical no-undo .
      157      define variable v-tosave as logical no-undo .
      158      define buffer buf_dis-card for ub.dis-card.
      159       if d-card <> '':U then do:
      160           _save:
      161           for each buft_Sel-goods-discount_
      162           on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      163           :
      164             v-tosave = no.
      165             if buft_Sel-goods-discount_.node-name = "d-pcnt"
      166             then do:
      167               if buft_Sel-goods-discount_.init-value-decimal = d-pcnt then next _save.
      168               assign
      169               buft_Sel-goods-discount_.property-value-decimal = d-pcnt
      170               .
      171             end.
      172             if buft_Sel-goods-discount_.node-name = "cash-d-pcnt" then do:
      173               if buft_Sel-goods-discount_.init-value-decimal = cash-d-pcnt then next _save.
      174               assign
      175               buft_Sel-goods-discount_.property-value-decimal = cash-d-pcnt
      176               .
      177             end.
      178             if buft_Sel-goods-discount_.node-name = "category" then do:
      179               if buft_Sel-goods-discount_.init-value-integer = category then next _save.
      180               assign
      181               buft_Sel-goods-discount_.property-value-integer = category
      182               .
      183             end.
      184             if buft_Sel-goods-discount_.h-n-action = integer('2':U)
      185             or buft_Sel-goods-discount_.h-n-action = integer('1':U)
      186             then do:
      187               if temp >= 0 then do:
      188                 if buft_Sel-goods-discount_.recid_ <> ? then do:
      189                   find first buf_Sel-goods-discount_ exclusive-lock where
      190                       recid(buf_Sel-goods-discount_) = buft_Sel-goods-discount_.recid_.
      191                    v-tosave = not (v_bh:buffer-compare(v_tbh)).
      192                 end.
      193                 else do:
      194                   glog = v_bh:buffer-create().
      195                   glog = v_bh:buffer-copy( v_tbh, "property-value-character,property-value-date,property-value-decimal,property-value-integermproperty-value-logical").
      196                   v-tosave = yes.
      197                 end.
      198                 if v-tosave then do:
      199                 run disproph_write-dis-card-property-rul in v_gc ( buffer buf_Sel-goods-discount_
      200                                                         ,input type#
      201                                                         ,input emitent-host-code#
      202                                                         ,input 17
      203                                                         ,input buft_Sel-goods-discount_.h-n-action) no-error .
      204                 if error-status:error then do:
      205                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      206                 end.
      207                 glog = v_bh:buffer-copy( v_tbh).
      208                 run disproph_send-dis-card-property-rul in v_gc ( buffer buf_Sel-goods-discount_
      209                                                         ,input type#
      210                                                         ,input emitent-host-code#
      211                                                         ,input 17
      212                                                         ,input buft_Sel-goods-discount_.h-n-action) no-error .
      213                 if error-status:error then do:
      214                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      215                 end.
      216                 end.
      217               end.
      218               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      219               glog = v_bh:buffer-release() no-error .
      220               if error-status:error then do:
      221                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      222               end.
      223               if temp < 0 then do:
      224                 run tempcont_create-changes in v_cnt (
      225                                                 input 'dis-card-property':U
      226                                                ,input v_bh
      227                                                ,input v_tbh
      228                                                ,input buft_Sel-goods-discount_.h-n-action) no-error.
      229                 if error-status:error then do:
      230                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      231                 end.
      232               end.
      233             end.
      234           end.
      235       end.
      236       return yes.
      237     end method.
      238      method public logical find_Sel-goods-discount_ ( p-d-card as character):
      239      define variable glog as logical no-undo .
      240      define variable v-jj as integer no-undo .
      241      define buffer buf_dis-card for ub.dis-card.
      242       Sel-goods-discount_release_().
      243       clear_().
      244       if p-d-card <> '':U then do:
      245         find first buf_dis-card no-lock where
      246                   buf_dis-card.d-card = p-d-card no-error.
      247         if not available buf_dis-card then do:
      248            return error substitute("Не найдена ДК &1", p-d-card).
      249         end.
      250         assign
      251         card-num                 = buf_dis-card.card-num
      252         d-card                   = buf_dis-card.d-card
      253         first-card               = buf_dis-card.first-card
      254         first-main-card          = buf_dis-card.first-main-card
      255         main-card                = buf_dis-card.main-card
      256         emitent-host-code#       = buf_dis-card.emitent-host-code
      257         type#                    = buf_dis-card.type
      258         .
      259         define variable v-ii as integer no-undo .
      260         _buft_dis-card-property:
      261         for each buft_Sel-goods-discount_
      262         by buft_Sel-goods-discount_.dt-code
      263         by buft_Sel-goods-discount_.node-code
      264         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      265         :
      266           assign
      267           buft_Sel-goods-discount_.card-num                 = buf_dis-card.card-num
      268           buft_Sel-goods-discount_.d-card                   = buf_dis-card.d-card
      269           buft_Sel-goods-discount_.first-card               = buf_dis-card.first-card
      270           buft_Sel-goods-discount_.first-main-card          = buf_dis-card.first-main-card
      271           buft_Sel-goods-discount_.main-card                = buf_dis-card.main-card
      272           buft_Sel-goods-discount_.recid_ = ?
      273           buft_Sel-goods-discount_.h-n-action = 0
      274           buft_Sel-goods-discount_.property-value-decimal = buft_Sel-goods-discount_.init-value-decimal
      275           buft_Sel-goods-discount_.property-value-integer = buft_Sel-goods-discount_.init-value-integer
      276           buft_Sel-goods-discount_.dt-code                 = dt-code
      277           buft_Sel-goods-discount_.sum-id                  = sum-id
      278           v-jj = v-jj + 1
      279           .
      280           define variable v-where as character no-undo .
      281           v-where =  substitute('where d-card = "&1" and host-code = 0 and obj-type = "" and obj-code = 0 and dt-code = &2 and node-code = &3'
      282                                   , p-d-card
      283                                   , dt-code
      284                                   , buft_Sel-goods-discount_.node-code
      285                                   ).
      286           assign
      287           glog =  v_bh:find-first( v-where
      288                                   , lock
      289                                   , wait) no-error .
      290           if not glog then do:
      291             if wait = NO-WAIT
      292             and v_bh:locked then do:
      293               return error substitute("Запись свойств ДК &1 занята", p-d-card).
      294             end.
      295             assign
      296             buft_Sel-goods-discount_.h-n-action = integer('1':U).
      297             if v-jj = num-members then leave _buft_dis-card-property.
      298             next _buft_dis-card-property.
      299           end.
      300           else do:
      301             assign
      302             buft_Sel-goods-discount_.h-n-action = integer('2':U)
      303             .
      304           end.
      305           assign
      306           v-ii = v-ii + 1
      307           buft_Sel-goods-discount_.recid_ = recid(buf_Sel-goods-discount_)
      308           .
      309           glog = v_tbh:buffer-copy( v_bh).
      310           if buft_Sel-goods-discount_.node-name = "d-pcnt" then do:
      311              assign
      312              d-pcnt = buft_Sel-goods-discount_.property-value-decimal
      313              node-code#                = buft_Sel-goods-discount_.node-code
      314              .
      315           end.
      316           if buft_Sel-goods-discount_.node-name = "cash-d-pcnt" then do:
      317              assign
      318              cash-d-pcnt = buft_Sel-goods-discount_.property-value-decimal
      319              node-code#                = buft_Sel-goods-discount_.node-code
      320              .
      321           end.
      322           if buft_Sel-goods-discount_.node-name = "category" then do:
      323              assign
      324              category = buft_Sel-goods-discount_.property-value-integer
      325              node-code#                = buft_Sel-goods-discount_.node-code
      326              .
      327           end.
      328           if v-jj = num-members then leave _buft_dis-card-property.
      329         end.
      330         if v-ii = 0 then do:
      331           return no.
      332         end.
      333       end.
      334       return yes.
      335     end method.
      336     method public logical create_Sel-goods-discount_sum-id ( input p-d-card as character
      337                                                ,input p-sum-id as character
      338                                                ,input p-caller-id as character
      339                                             ):
      340       define variable glog as logical no-undo .
      341       define buffer buf_prop-ref for ub.prop-ref.
      342        find last buf_prop-ref no-lock where
      343                   buf_prop-ref.dtm-code = dtm-code
      344               and buf_prop-ref.sum-id = p-sum-id
      345               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      346        if error-status:error then do:
      347           undo, return error substitute( "&1. Не найден Итог &2 (доп.иден-р &3) в справочнике итогов&4"
      348                                          , vss-include-info0
      349                                          , p-sum-id
      350                                          , p-caller-id
      351                                          , chr(10)
      352                                          ).
      353        end.
      354        dt-code = buf_prop-ref.dt-code.
      355        caller_id = buf_prop-ref.caller_id.
      356        glog = create_Sel-goods-discount_ ( p-d-card ) no-error .
      357        if error-status:error then do:
      358          undo, return error return-value .
      359        end.
      360     end.
      361     method public logical create_Sel-goods-discount_ ( input p-d-card as character ):
      362       define buffer buft2_ for t-Sel-goods-discount_.
      363       for each buft2_ :
      364         if buft2_.recid_ = ?
      365         and buft2_.init-value-decimal <> 0.0
      366         then do:
      367           assign
      368           buft2_.h-n-action     = integer('1':U)
      369           .
      370         end.
      371         if buft2_.recid_ = ?
      372         and buft2_.init-value-integer <> 0
      373         then do:
      374           assign
      375           buft2_.h-n-action     = integer('1':U)
      376           .
      377         end.
      378         assign
      379         buft2_.dt-code = dt-code
      380         buft2_.sum-id = sum-id
      381         .
      382       end.
      383       return yes.
      384     end method.
      385     method protected void clear_():
      386       define variable glog as logical no-undo .
      387       v-error-flag = no.
      388       assign
      389       d-card = ''
      390       .
      391       for each buft_Sel-goods-discount_:
      392         assign
      393         buft_Sel-goods-discount_.card-num                 = 0
      394         buft_Sel-goods-discount_.d-card                   = '':U
      395         buft_Sel-goods-discount_.first-card               = '':U
      396         buft_Sel-goods-discount_.first-main-card          = '':U
      397         buft_Sel-goods-discount_.main-card                = '':U
      398         buft_Sel-goods-discount_.recid_ = ?
      399         buft_Sel-goods-discount_.h-n-action = 0
      400         buft_Sel-goods-discount_.property-value-decimal = buft_Sel-goods-discount_.init-value-decimal
      401         buft_Sel-goods-discount_.property-value-integer = buft_Sel-goods-discount_.init-value-integer
      402         buft_Sel-goods-discount_.dt-code                 = 0
      403         buft_Sel-goods-discount_.sum-id                  = '':U
      404         .
      405       end.
      406     end method.
      407     method public override character ToString( ):
      408       return substitute("ДК &1 объект-операнд &2, срез &2, свойство &4"
      409                         , d-card
      410                         , dtm-code
      411                         , dt-code
      412                         , node-code#).
      413     end method.
      414   end class.
