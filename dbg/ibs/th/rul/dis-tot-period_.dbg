        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.Dis-tot-period_ inherits Ibs.Th.Rul.Dis-tot_:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-tot-period_.cls $ $Revision: aea5316774be, 0, rls $".
        4     CONSTRUCTOR PUBLIC dis-tot-period_(
        5                                  input parparentproc as widget-handle
        6                                 ,input p-parent-handle as handle
        7                                 ,input p-log-handle as handle
        8                                 ,input p-gc-handle as handle
        9                                 ,input p-cont-handle as handle
       10                                 ,input p-lock as integer
       11                                 ,input p-wait as integer
       12                                 ,input p-temp as integer
       13                                 ,input p-dtm-code as integer
       14                               ):
       15       super( p-parent-handle
       16             ,p-parent-handle
       17             ,p-log-handle
       18             ,p-gc-handle
       19             ,p-cont-handle
       20             ,p-lock
       21             ,p-wait
       22             ,p-temp).
       23       dtm-code = p-dtm-code.
       24     end constructor.
       25     method public logical find_dis-tot-period_ ( p-d-card as character
       26                                         , p-sum-id as character
       27                                             ):
       28        define variable glog as logical no-undo .
       29        define buffer buf_prop-ref for ub.prop-ref.
       30        find first buf_prop-ref no-lock where
       31                   buf_prop-ref.dtm-code = dtm-code
       32               and buf_prop-ref.sum-id = p-sum-id no-error .
       33        if error-status:error then do:
       34           undo, return error substitute( "&1. Не найден Идентификатор итогов &2 в справочнике итогов&3"
       35                                          , vss-include-info0
       36                                          , p-sum-id
       37                                          , chr(10)
       38                                          ).
       39        end.
       40        dt-code = buf_prop-ref.dt-code.
       41        glog = super:find_dis-tot_ ( p-d-card ) no-error .
       42        if error-status:error then do:
       43          undo, return error return-value .
       44        end.
       45        return glog.
       46      end method.
       47     method public logical create_dis-tot-period_ ( input p-d-card as character
       48                                                ,input p-sum-id as character
       49                                                ):
       50        define variable glog as logical no-undo .
       51        define buffer buf_prop-ref for ub.prop-ref.
       52        find first buf_prop-ref no-lock where
       53                   buf_prop-ref.dtm-code = dtm-code
       54               and buf_prop-ref.sum-id = p-sum-id no-error .
       55        if error-status:error then do:
       56           undo, return error substitute( "&1. Не найден Идентификатор итогов &2 в справочнике итогов&3"
       57                                          , vss-include-info0
       58                                          , p-sum-id
       59                                          , chr(10)
       60                                          ).
       61        end.
       62        dt-code = buf_prop-ref.dt-code.
       63        glog = super:create_dis-tot_ ( p-d-card ) no-error .
       64        if error-status:error then do:
       65          undo, return error return-value .
       66        end.
       67        return glog.
       68     end.
       69   end class.
