       61   index iparenthandle parent-buffer-handle child-buffer-handle
       62   .
       63   method public void tmpreldf_get-relations ( input p-dataseth as handle ):
       64   define variable v-ii as integer no-undo .
       65   define buffer buf_temp-rel-handle for temp-rel-handle.
       66   do
       67   on error undo, return error
       68   :
       69     if not valid-handle(p-dataseth)
       70     or p-dataseth:type <> "DATASET"
       71     then do:
       72       return error substitute("Не определен dataset с handle &1", p-dataseth).
       73     end.
       74     for each buf_temp-rel-handle where
       75             buf_temp-rel-handle.dh = p-dataseth:
       76       delete buf_temp-rel-handle.
       77     end.
       78     do v-ii = 1 to p-dataseth:num-relations:
       79       create buf_temp-rel-handle.
       80       assign
       81       buf_temp-rel-handle.ii = v-ii
       82       buf_temp-rel-handle.dh = p-dataseth
       83       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
       84       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
       85       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
       86       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
       87       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
       88       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
       89       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
       90       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
       91       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
       92       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
       93       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
       94       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
       95       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
       96       .
       97     end.
       98   end.
       99   end method.
      100   method public void tmpreldf_set-relations ( input p-srcdataseth as handle
      101                                             , input p-trgdataseth as handle ):
      102   define variable gh as handle no-undo .
      103   define buffer buf_temp-rel-handle for temp-rel-handle.
      104   do
      105   on error undo, return error
      106   :
      107     if not valid-handle(p-srcdataseth)
      108     or p-srcdataseth:type <> "DATASET"
      109     then do:
      110       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
      111     end.
      112     if not valid-handle(p-trgdataseth)
      113     or p-trgdataseth:type <> "DATASET"
      114     then do:
      115       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
      116     end.
      117     for each buf_temp-rel-handle no-lock where
      118             buf_temp-rel-handle.dh = p-srcdataseth
      119     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      120     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      121     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      122     :
      123       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
      124                                         , buf_temp-rel-handle.child-buffer-handle
      125                                         , buf_temp-rel-handle.relation-fields_
      126                                         , buf_temp-rel-handle.reposition_
      127                                         , buf_temp-rel-handle.nested_).
      128      if error-status:error
      129      or not valid-handle(gh) then do:
      130        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
      131      end.
      132     end.
      133   end.
      134   end method.
      135     define protected variable v_gc as handle no-undo.
      136     define protected variable v_ph as handle no-undo.
      137     define protected variable v_pp as widget-handle no-undo.
      138     define protected variable v_lh as widget-handle no-undo.
      139     define protected variable v_eh as widget-handle no-undo.
      140     define protected variable v_libg as handle no-undo .
      141     define private variable v_dataseth as handle no-undo.
      142     define private variable direction as integer no-undo .
      143     define private variable v-xmlh as handle no-undo .
      144     define private variable v-headerh as handle no-undo .
      145     define private variable v-gate-key-rec as character no-undo .
      146     define private variable v_qh as handle no-undo .
      147     define public variable name_ as character no-undo.
      148     define private variable v-esys-id as integer no-undo .
      149     define private variable v-esys-id-list as character no-undo .
      150     define private variable v-esys-name as character no-undo .
      151     define private variable v-tot-recs as integer no-undo .
      152     define private variable v-pack-num as integer no-undo .
      153     define variable objSetError as ibs.th.rul.route_date_error no-undo.
      154     CONSTRUCTOR PUBLIC route-data_(      input objError as ibs.th.rul.route_date_error
      155                                         ,input parparentproc as widget-handle
      156                                         ,input p-parent-handle as handle
      157                                         ,input p-log-handle as handle
      158                                         ):
      159        this-object(parparentproc,p-parent-handle,p-log-handle,?).
      160        objSetError = objError.
      161     end.
      162     CONSTRUCTOR PUBLIC route-data_(
      163                                          input parparentproc as widget-handle
      164                                         ,input p-parent-handle as handle
      165                                         ,input p-log-handle as handle
      166                                         ,input p-gc-handle as handle
      167                                         ):
      168       define variable glog as logical no-undo .
      169       define buffer buf_temp-xml-tables for temp-xml-tables.
      170       if valid-handle (p-gc-handle)
      171       then do:
      172          run garbcoll_create-gc-entry in p-gc-handle (input "route-data_",  input this-object) no-error.
      173          if error-status:error then do:
      174            message error-status:get-message(1) view-as alert-box .
      175            return error "Ошибка создания объекта ЭКСПОРТ ДАННЫХ".
      176          end.
      177       end.
      178       assign
      179       v_ph = p-parent-handle
      180       v_gc = p-gc-handle
      181       v_eh = v_gc
      182       v_libg = v_gc
      183       v_pp = parparentproc
      184       v_lh = p-log-handle
      185       name_ = '':U
      186       direction = 1
      187       .
      188     end constructor.
      189     CONSTRUCTOR PUBLIC route-data_(
      190                                          input parparentproc as widget-handle
      191                                         ,input p-parent-handle as handle
      192                                         ,input p-log-handle as handle
      193                                         ,input p-gc-handle as handle
      194                                         ,input p-libg-handle as handle
      195                                         ):
      196       define variable glog as logical no-undo .
      197       define buffer buf_temp-xml-tables for temp-xml-tables.
      198       run garbcoll_create-gc-entry in p-libg-handle (input "route-data_",  input this-object) no-error.
      199       if error-status:error then do:
      200         message error-status:get-message(1) view-as alert-box .
      201         return error "Ошибка создания объекта ЭКСПОРТ ДАННЫХ".
      202       end.
      203       assign
      204       v_ph = p-parent-handle
      205       v_gc = p-libg-handle
      206       v_eh = p-gc-handle
      207       v_pp = parparentproc
      208       v_lh = p-log-handle
      209       v_libg = p-libg-handle
      210       name_ = '':U
      211       direction = 1
      212       .
      213     end constructor.
      214     CONSTRUCTOR PUBLIC route-data_(
      215                                          input parparentproc as widget-handle
      216                                         ,input p-parent-handle as handle
      217                                         ,input p-log-handle as handle
      218                                         ,input p-gc-handle as handle
      219                                         ,input p-dataseth as handle
      220                                         ,input p-xmlh as handle
      221                                         ):
      222       define variable glog as logical no-undo .
      223       define buffer buf_temp-xml-tables for temp-xml-tables.
      224       run garbcoll_create-gc-entry in p-gc-handle (input "route-data_",  input this-object) no-error.
      225       if error-status:error then do:
      226         message error-status:get-message(1) view-as alert-box .
      227         return error "Ошибка создания объекта ИМПОРТ ДАННЫХ".
      228       end.
      229       assign
      230       v_ph = p-parent-handle
      231       v_gc = p-gc-handle
      232       v_eh = v_gc
      233       v_pp = parparentproc
      234       v_lh = p-log-handle
      235       v_libg = v_gc
      236       name_ = '':U
      237       direction = (if direction = 0 then -1 else direction)
      238       v_dataseth = p-dataseth
      239       v-gate-key-rec = (if num-entries(p-dataseth:private-data, chr(4)) > 1
      240                     then entry(2, p-dataseth:private-data, chr(4))
      241                     else '')
      242       v-xmlh = p-xmlh
      243       .
      244     end constructor.
      245     destructor public route-data_():
      246       define buffer buf_temp-xml-tables for temp-xml-tables.
      247       name_ = '':U.
      248       if direction = 1 then do:
      249         if valid-handle(v_libg) then do:
      250           run gate-clear in v_libg ( input v_dataseth, input buffer buf_temp-xml-tables:handle).
      251         end.
      252         else if valid-handle(v_gc) then do:
      253           run gate-clear in v_gc ( input v_dataseth, input buffer buf_temp-xml-tables:handle).
      254         end.
      255         else do :
      256         end.
      257       end.
      258     end destructor.
      259     method public void change-direction ( input p-direction as integer):
      260      direction = p-direction.
      261     end method.
      262     method public character current-tbl-name ():
      263       define variable v-character as character no-undo .
      264       if v-xmlh:available = yes then do:
      265         v-character = v-xmlh:buffer-field("tbl-name"):buffer-value.
      266       end.
      267       return v-character.
      268     end method.
      269     method public logical route-data_read-xmlschema ( input p-xsd-file as character):
      270      define variable glog as logical no-undo .
      271      define variable v-ii as integer no-undo .
      272      define variable v-longchar as longchar no-undo .
      273      define variable v-xmlh as handle no-undo .
      274      define buffer buf_clob-bind for ub.clob-bind.
      275      define buffer buf_clob-data for ub.clob-data.
      276      define buffer buf_temp-xml-tables for temp-xml-tables.
      277      if direction = -1 then do:
      278         undo, return error substitute("Нельзя получить XML-схему из файла в режиме импорта").
      279      end.
      280      if not valid-handle (v_dataseth) then do:
      281         v-xmlh = buffer buf_temp-xml-tables:handle.
      282         run get-gate-by-name in v_libg ( input  p-xsd-file
      283                                       ,output v-gate-key-rec
      284                                       ,output v_dataseth
      285                                       ,input-output v-xmlh) no-error.
      286         if error-status :error then do:
      287           setError ( input return-value ).
      288           return no.
      289         end.
      290         name_ = v_dataseth:name.
      291         return yes.
      292       end.
      293       else do:
      294         return yes.
      295       end.
      296     end method.
      297     method void route-data_init (
      298                                              input parparentproc as widget-handle
      299                                             ,input p-parent-handle as handle
      300                                             ,input p-log-handle as handle
      301                                             ,input p-gc-handle as handle
      302                                             ,input p-libg-handle as handle
      303                                             ):
      304       assign
      305       v_ph = p-parent-handle
      306       v_gc = p-gc-handle
      307       v_pp = parparentproc
      308       v_lh = p-log-handle
      309       v_libg = p-libg-handle
      310       .
      311       assign
      312       v_dataseth = ?
      313       direction = 1
      314       v-xmlh = ?
      315       v-headerh = ?
      316       v-gate-key-rec = ''
      317       name_ = ''
      318       v-esys-id-list = ''
      319       v-esys-id = 0
      320       v-esys-name = ''
      321       v-tot-recs = 0
      322       v-pack-num = 0
      323       .
      324     end.
      325     method public logical route-data_push-xmlschema ( input p-xsd-file as character
      326                                                      ):
      327      define variable v-xmlh as handle no-undo .
      328      define buffer buf_temp-xml-tables for temp-xml-tables.
      329      if direction = -1 then do:
      330         undo, return error substitute("Нельзя получить XML-схему из файла в режиме импорта").
      331      end.
      332      if not valid-handle (v_dataseth) then do:
      333         v-xmlh = buffer buf_temp-xml-tables:handle.
      334         run get-gate-by-name in v_libg ( input  p-xsd-file
      335                                       ,output v-gate-key-rec
      336                                       ,output v_dataseth
      337                                       ,input-output v-xmlh) no-error.
      338         if error-status :error then do:
      339           setError ( input return-value ).
      340           return no.
      341         end.
      342         name_ = v_dataseth:name.
      343         return yes.
      344       end.
      345       else do:
      346         return yes.
      347       end.
      348     end method.
      349     method public void route-data_clear-xmlschema ( ):
      350       define buffer buf_temp-xml-tables for temp-xml-tables.
      351       name_ = '':U.
      352      if direction = -1 then do:
      353         undo, return error substitute("Нельзя очищать структуру буфера маршрутизации в режиме импорта").
      354      end.
      355       run gate-clear in v_libg ( input v_dataseth, input buffer buf_temp-xml-tables:handle).
      356     end method.
      357     method public void route-data_clear-data ( ):
      358       define buffer buf_temp-xml-tables for temp-xml-tables.
      359       v-tot-recs = 0.
      360       v-esys-id-list = ''.
      361       v-esys-id = 0.
      362       v-pack-num = 0.
      363       v-esys-name = ''.
      364       for each buf_temp-xml-tables:
      365          buf_temp-xml-tables.tbl-handle_:empty-temp-table().
      366       end.
      367     end method.
      368     method public void route-data_dump ( ):
      369     end method.
      370     method public logical route-data_create-record ( input p-table-name as character ):
      371       define variable glog as logical no-undo .
      372       define buffer buf_temp-xml-tables for temp-xml-tables.
      373       if direction = -1 then do:
      374           undo, return error substitute("Нельзя создать запись в буфере маршрутизации в режиме импорта").
      375       end.
      376       find first buf_temp-xml-tables where
      377                 buf_temp-xml-tables.tbl-name = p-table-name no-error.
      378       if not available buf_temp-xml-tables then do:
      379         return error substitute("Таблица &1 не найдена в dataset &2"
      380                                , p-table-name
      381                                , name_).
      382       end.
      383       do transaction :
      384         assign
      385         glog = buf_temp-xml-tables.tbl-handle_:buffer-create no-error.
      386         .
      387       end.
      388       if glog
      389       and buf_temp-xml-tables.is-parent
      390       then v-tot-recs = v-tot-recs + 1.
      391       return glog.
      392     end method.
      393     method public logical route-data_copy-field ( input p-table-name as character
      394                                                   ,input p-field-name as character
      395                                                   ,input p-src-fh as handle
      396                                                ):
      397       define variable glog as logical no-undo .
      398       define buffer buf_temp-xml-tables for temp-xml-tables.
      399       if direction = -1 then do:
      400           undo, return error substitute("Нельзя скопировать поле в буфер маршрутизации в режиме импорта").
      401       end.
      402       find first buf_temp-xml-tables where
      403                 buf_temp-xml-tables.tbl-name = p-table-name no-error.
      404       if not available buf_temp-xml-tables then do:
      405         return error substitute("Таблица &1 не найдена в dataset &2"
      406                                , p-table-name
      407                                , name_).
      408       end.
      409       if buf_temp-xml-tables.tbl-handle_:available = no then do:
      410         glog = route-data_create-record( input p-table-name).
      411         if not glog then do:
      412           return no.
      413         end.
      414       end.
      415       assign
      416       buf_temp-xml-tables.tbl-handle_:buffer-field(p-field-name):buffer-value = p-src-fh:buffer-value
      417       no-error.
      418       .
      419       return not error-status:error .
      420     end method.
