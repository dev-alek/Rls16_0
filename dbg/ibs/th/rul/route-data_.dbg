      913         undo, return error substitute("В настоящий момент в буфере маршрутизации запись &1, а не &2"
      914                                       ,p-xmlbh::tbl-handle:name
      915                                       ,p-table-name).
      916       end.
      917       if p-xmlbh:buffer-field("tbl-handle_"):buffer-value:available = no then do:
      918         undo, return error substitute("В настоящий момент в буфере маршрутизации нет записи").
      919       end.
