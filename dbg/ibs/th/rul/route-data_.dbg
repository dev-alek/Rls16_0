        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.route-data_
        3      inherits   ibs.th.gbl.sys.objth:
        4       define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        5       define override public property vss-author      as character no-undo init "$Author:$":U get.
        6       define override public property vss-date        as character no-undo init "$Date:$":U get.
        7       define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
        8       define override public property vss-archive     as character no-undo init "$Archive:$":U get.
        9       define override public property vss-description as character no-undo init "Класс  Данные для экспорта/импорта" get.
       10       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: route-data_.cls $ $Revision: 84dd6171ad45, 3327, rls $".
       11   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       12   define variable tempcxml_v-num_ as integer no-undo .
       13   define  temp-table temp-xml-tables no-undo
       14   field order as integer
       15   field tbl-name as character
       16   field tbl-handle_ as handle
       17   field table-handle_ as handle
       18   field uniq-gate-rec as character
       19   field gate-name as character
       20   field gate-handle_ as handle
       21   field is-parent as logical
       22   index pi is unique primary
       23   uniq-gate-rec
       24   tbl-name
       25   index iorder
       26   order
       27   index gr
       28   uniq-gate-rec
       29   index gh
       30   gate-handle_
       31   index iparent
       32   is-parent
       33   .
