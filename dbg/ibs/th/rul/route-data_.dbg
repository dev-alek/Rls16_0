      872       define variable v-src-bh as handle no-undo .
      873       if direction = 1 then do:
      874           undo, return error substitute("Нельзя скопировать поле из буфера маршрутизации в режиме экспорта").
      875       end.
      876       if v-xmlh:available = no then do:
      877         undo, return error substitute("В настоящий момент в буфере маршрутизации нет записи").
      878       end.
