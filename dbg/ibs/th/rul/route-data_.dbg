       41   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       42   define temp-table temp-rel-handle no-undo
       43   field dh as handle
       44   field ii as integer
       45   field active_ as logical
       46   field child-buffer_ as character
       47   field parent-buffer_ as character
       48   field child-buffer-handle as handle
       49   field parent-buffer-handle as handle
       50   field name_ as character
       51   field nested_ as logical
       52   field relation-fields_ as character
       53   field reposition_ as logical
       54   field type_ as character
       55   field query_ as handle
       56   field where-string_ as character
       57   field tbl-handle_ as handle
