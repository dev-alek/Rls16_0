      922     method public logical route-data_copy-record ( input p-table-name as character
      923                                                   ,input p-src-bh as handle
      924                                                ):
      925       define variable glog as logical no-undo .
      926       define buffer buf_temp-xml-tables for temp-xml-tables.
      927       if direction = -1 then do:
      928           undo, return error substitute("Нельзя скопировать запись в буфер маршрутизации в режиме импорта").
      929       end.
      930       find first buf_temp-xml-tables where
      931                 buf_temp-xml-tables.tbl-name = p-table-name no-error.
      932       if not available buf_temp-xml-tables then do:
      933         return error substitute("Таблица &1 не найдена в dataset &2"
      934                                , p-table-name
      935                                , name_).
      936       end.
      937       if buf_temp-xml-tables.tbl-handle_:available = no then do:
      938         glog = route-data_create-record( input p-table-name).
      939         if not glog then do:
      940           return no.
      941         end.
      942       end.
      943       do transaction :
      944         assign
      945         glog = buf_temp-xml-tables.tbl-handle_:buffer-copy(p-src-bh)
      946         no-error.
      947       end.
      948       .
      949       return glog.
      950     end method.
      951     method public logical esys-add-dump (     input p-table-name as character
      952                                             , input p-esys-cmd-proc-handle as handle
      953                                             , input p-esys-cmd-code as integer
      954                                             , input p-action as character     ):
      955       define variable v-esys-rec-ord as integer no-undo .
      956       define variable v-local-xmlh as handle no-undo .
      957       define buffer buf_temp-xml-tables for temp-xml-tables.
      958       if valid-handle(v-xmlh) then do:
      959         v-local-xmlh = v-xmlh.
      960       end.
      961       else do:
      962         v-local-xmlh = buffer buf_temp-xml-tables:handle.
      963       end.
      964       if direction = -1 then do:
      965           undo, return error substitute("Нельзя маршрутизировать буфер маршрутизации в режиме импорта").
      966       end.
      967       v-local-xmlh:find-first( substitute(" where tbl-name = &1&2&1", chr(34), p-table-name)) no-error.
      968       if not v-local-xmlh:available then do:
      969         return error substitute("Таблица &1 не найдена в dataset &2"
      970                                , p-table-name
      971                                , name_).
      972       end.
      973       run add-dump in p-esys-cmd-proc-handle
      974         (input p-esys-cmd-code
      975         ,input p-table-name
      976         ,input p-action
      977         ,input v-local-xmlh::tbl-handle_
      978         ,input v-gate-key-rec
      979         ,output v-esys-rec-ord
      980         ) no-error .
      981       if error-status :error
      982       then do:
      983         if valid-handle (p-esys-cmd-proc-handle ) then do:
      984           delete procedure p-esys-cmd-proc-handle .
      985         end.
      986         setError (substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
      987                                             ,chr(10)
      988                                             ,p-table-name
      989                                             ,p-esys-cmd-code
      990                                             ,error-status:get-message(1)
      991                                             ,return-value
      992                                             )) .
      993         return no.
      994       end.
      995       return yes.
      996     end method.
      997     method public logical set-esys ( input p-esys-id as integer, p-esys-name as character):
      998       assign
      999       v-esys-id-list = string(p-esys-id)
     1000       v-esys-id = p-esys-id
     1001       v-esys-name = p-esys-name
     1002       .
     1003       return yes.
     1004     end.
     1005     method public logical set-pack-num ( input p-pack-num as integer):
     1006       assign
     1007       v-pack-num = p-pack-num
     1008       .
     1009       return yes.
     1010     end.
     1011     method public logical set-field-hidden ( input p-table-name as character, input p-field-name as character ):
     1012       define buffer buf_temp-xml-tables for temp-xml-tables.
     1013       find first buf_temp-xml-tables where
     1014                 buf_temp-xml-tables.tbl-name = p-table-name.
     1015       assign
     1016       buf_temp-xml-tables.tbl-Handle_:buffer-field(p-field-name):xml-node-type = "hidden" no-error.
     1017       if not error-status:error
     1018       and buf_temp-xml-tables.tbl-Handle_:buffer-field(p-field-name):xml-node-type = "hidden"
     1019       then return yes.
     1020       return no.
     1021     end method.
     1022     method public logical write-xml ( input p-file-name as character, p-file-num as integer):
     1023     define variable glog as logical no-undo .
     1024       define variable v-header-schema-name as character no-undo .
     1025       define variable v-header-name as character no-undo .
     1026       define variable v-header-rec as character no-undo .
     1027       define variable v-header-th as handle no-undo .
     1028       define buffer buf_sys-ctrl  for ub.sys-ctrl.
     1029       define buffer buf_temp-xml-tables for temp-xml-tables.
     1030       find first buf_sys-ctrl no-lock.
     1031       v-header-schema-name = "exe/ThHeader.xsd".
     1032       v-header-name = "ThHeader".
     1033       run get-gate-rec in v_libg ( input v-header-schema-name
     1034                                           ,output v-header-rec) no-error.
     1035       if error-status:error then do:
     1036               .
     1037         undo, return error ''.
     1038       end.
     1039       run get-header-by-rec in v_libg        ( input v-header-rec
     1040                                             ,output v-header-th
     1041                                             ) no-error.
     1042       if error-status:error then do:
     1043               .
     1044         undo, return error '':U.
     1045       end.
     1046       v-headerh = v-header-th:default-buffer-handle.
     1047       if v-headerh:available = no then do:
     1048         do transaction :
     1049           v-headerh:buffer-create().
     1050         end.
     1051         find first buf_temp-xml-tables where
     1052                 buf_temp-xml-tables.tbl-name = v-headerh:table no-error.
     1053         if not available buf_temp-xml-tables then do:
     1054           create buf_temp-xml-tables.
     1055           assign
     1056           buf_temp-xml-tables.tbl-name = v-headerh:table
     1057           buf_temp-xml-tables.tbl-handle_ = v-headerh
     1058           buf_temp-xml-tables.table-handle_ = v-headerh:table-handle
     1059           buf_temp-xml-tables.uniq-gate-rec = v-gate-key-rec
     1060           buf_temp-xml-tables.gate-name = v_dataseth:name
     1061           buf_temp-xml-tables.gate-handle_ = v_dataseth
     1062           buf_temp-xml-tables.order = -3
     1063           .
     1064           tmpreldf_get-relations  ( input v_dataseth).
     1065           for each buf_temp-xml-tables
     1066           break
     1067           by buf_temp-xml-tables.order:
     1068           if first(buf_temp-xml-tables.order) then do:
     1069             glog = v_dataseth:set-buffers ( buf_temp-xml-tables.tbl-handle_) no-error.
     1070           end.
     1071           else do:
     1072             glog = v_dataseth:add-buffer ( buf_temp-xml-tables.tbl-handle_) no-error.
     1073           end.
     1074           if error-status:error
     1075           or not glog
     1076           then do:
     1077                           .
     1078               run gate-clear in v_libg ( input v_dataseth, input v-xmlh).
     1079               undo, return error '':U.
     1080             end.
     1081           end.
     1082           tmpreldf_set-relations  ( input v_dataseth, input v_dataseth).
     1083         end.
     1084       end.
     1085       do transaction :
     1086         assign
     1087         v-headerh::THfilename     = p-file-name
     1088         v-headerh::THfilenumber   = p-file-num
     1089         v-headerh::THformat_      = "IBS TH"
     1090         v-headerh::THversion_     = trim( replace( substring( vss-archive, 15, 4 ), "$":U, "":U ) )
     1091         v-headerh::THrevision     = trim( replace( substring( vss-revision, 12 ), "$":U, "":U ) )
     1092         v-headerh::THcurrentDbNum = buf_sys-ctrl.db-num
     1093         v-headerh::THschema-name  = substitute("exe/&1.xsd", v_dataseth:name)
     1094         v-headerh::THesysname     = v-esys-name
     1095         v-headerh::THpack-num     = v-pack-num
     1096         v-headerh::THexport-esys-id  = (if direction = 1 then v-esys-id else 0)
     1097         v-headerh::THimport-esys-id  = (if direction = -1 then v-esys-id else 0)
     1098         v-headerh::THtotal-recs = v-tot-recs + 1
     1099         .
     1100       end.
     1101       glog = v_dataseth:WRITE-XML("FILE"
     1102                                 ,p-file-name
     1103                                 ,yes
     1104                                 ,"windows-1251"
     1105                                 ,?
     1106                                 ,no
     1107                                 ,no
     1108                                 ) no-error.
     1109       if error-status:error then do:
     1110         setError ( substitute("Ошибка при записи XML файла данными через гейт &1:&2&3"
     1111                                         , v_dataseth:name
     1112                                         , chr(10), error-status:get-message(1))).
     1113         return no.
     1114       end.
     1115       return yes.
     1116     end method.
     1117     method public logical esys-add-dump-data ( input p-data as memptr
     1118                                             , input p-esys-cmd-proc-handle as handle
     1119                                             , input p-esys-cmd-code as integer
     1120                                             , input p-action as character     ):
     1121       define variable v-esys-rec-ord as integer no-undo .
     1122       define variable v-local-xmlh as handle no-undo .
     1123       define variable v-dump-name as character no-undo .
     1124       define buffer buf_temp-xml-tables for temp-xml-tables.
     1125       v-dump-name = "" .
     1126       if num-entries(p-action, chr(4)) >= 2
     1127       then do :
     1128           v-dump-name = entry(2, p-action, chr(4)) no-error.
     1129           if num-entries(p-action, chr(4)) = 3
     1130             then v-dump-name = substitute("&1&2&3", v-dump-name, chr(4), entry(3, p-action, chr(4))) no-error.
     1131           p-action = entry(1, p-action, chr(4)) no-error.
     1132       end.
     1133       if direction = -1 then do:
     1134           undo, return error substitute("Нельзя маршрутизировать буфер маршрутизации в режиме импорта").
     1135       end.
     1136       run add-dump-data in p-esys-cmd-proc-handle
     1137         (input p-esys-cmd-code
     1138         ,input if v-dump-name = "" then "xml data" else v-dump-name
     1139         ,input p-action
     1140         ,input p-data
     1141         ,output v-esys-rec-ord
     1142         ) no-error .
     1143       if error-status :error
     1144       then do:
     1145         if valid-handle (p-esys-cmd-proc-handle ) then do:
     1146           delete procedure p-esys-cmd-proc-handle .
     1147         end.
     1148         setError (substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
     1149                                             ,chr(10)
     1150                                             ,"xml data"
     1151                                             ,p-esys-cmd-code
     1152                                             ,error-status:get-message(1)
     1153                                             ,return-value
     1154                                             )) .
     1155         return no.
     1156       end.
     1157       return yes.
     1158     end method.
     1159     method private void setError (iTxt as char):
     1160        if valid-handle (v_eh)
     1161        then
     1162           run set-error in v_eh (iTxt).
     1163        if valid-object (objSetError)
     1164        then
     1165           objSetError:setError(iTxt).
     1166      end.
     1167   end class.
