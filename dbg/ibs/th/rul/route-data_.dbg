      888         undo, return error substitute("В настоящий момент в буфере-приемнике &1 нет записи", p-trg-bh:table ).
      889       end.
      890       do transaction :
      891         assign
      892         v-src-bh = v-xmlh:buffer-field("tbl-handle_"):buffer-value
      893         glog = p-trg-bh:buffer-copy( v-src-bh)
      894         no-error.
