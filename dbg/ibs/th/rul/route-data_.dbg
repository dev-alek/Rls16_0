      907     method public handle route-data_get-record ( input p-xmlbh as handle, input p-table-name as character ):
      908       define variable glog as logical no-undo .
      909       if p-xmlbh:available = no then do:
      910         undo, return error substitute("В настоящий момент в буфере маршрутизации нет записи").
      911       end.
