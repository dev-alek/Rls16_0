      505     method public logical route-data_copy-field-logical ( input p-table-name as character
      506                                                   ,input p-field-name as character
      507                                                   ,input p-value-logical as logical
      508                                                ):
      509       define variable glog as logical no-undo .
      510       define buffer buf_temp-xml-tables for temp-xml-tables.
      511       if direction = -1 then do:
      512           undo, return error substitute("Нельзя скопировать поле в буфер маршрутизации в режиме импорта").
      513       end.
      514       find first buf_temp-xml-tables where
      515                 buf_temp-xml-tables.tbl-name = p-table-name no-error.
