       14     define protected buffer buf_dis-chk-doc_obj for ub.chk-doc.
       15     define protected buffer buf_bar-code_ for ub.bar-code.
       16     define protected temp-table t-dis-chk-gds_obj no-undo like ub.chk-gds.
