      508     method protected void clear_():
      509       define variable glog as logical no-undo .
      510       v-error-flag = no.
      511       if v_tbh:available then
      512       glog = v_tbh:buffer-delete() no-error .
      513       if v_tbbh:available then
      514       glog = v_tbbh:buffer-delete() no-error .
      515       if v_tbdh:available then
      516       glog = v_tbdh:buffer-delete() no-error .
      517       assign
      518       doc-code = ''
      519       line-num = 0
      520       gds-code# = 0
      521       chk-type# = 0
      522       base-rate# = 0
      523       base-scale# = 0
      524       .
      525     end method.
      526     method public void Dis-chk-gds_objrelease_ ( ):
      527       define variable glog as logical no-undo .
      528       glog = v_bh:buffer-release() no-error .
      529       glog = v_bdh:buffer-release() no-error .
      530       glog = v_bbh:buffer-release() no-error .
      531       clear_().
      532     end method.
      533     method public handle get_dis-chk-gds_obj ( ):
      534       return v_bh.
      535     end method.
      536     method public override character ToString( ):
      537       return substitute("Чек &1, строка &2", doc-code, line-num).
      538     end method.
      539   end class.
