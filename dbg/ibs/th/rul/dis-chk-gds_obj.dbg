       73     CONSTRUCTOR PUBLIC dis-chk-gds_obj(
       74                                  input parparentproc as widget-handle
       75                                 ,input p-parent-handle as handle
       76                                 ,input p-log-handle as handle
       77                                 ,input p-gc-handle as handle
       78                                 ,input p-cont-handle as handle
       79                                 ,input p-lock as integer
       80                                 ,input p-wait as integer
       81                                 ,input p-temp as integer
       82                               ):
       83   define variable glog as logical no-undo .
       84   assign
       85   v_pp = parparentproc
       86   v_lh = p-log-handle
       87   v_ph = p-parent-handle
       88   v_gc = p-gc-handle
       89   v_cnt = p-cont-handle
       90   lock = p-lock
       91   wait = p-wait
       92   temp = p-temp
       93   .
       94   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-chk-gds_obj',  input this-object) no-error.
       95   if error-status:error then do:
       96     return error substitute("&1 Ошибка создания объекта dis-chk-gds_obj", vss-include-info0).
       97   end.
       98   v_bh = buffer buf_dis-chk-gds_obj:handle.
       99   v_tbh = buffer buft_dis-chk-gds_obj:handle.
      100       doc-code = '':U .
      101       line-num = 0 .
      102       v_qh = query query_dis-chk-gds_obj:handle.
      103       v_bdh = buffer buf_dis-chk-doc_obj:handle.
      104       v_tbdh = buffer buft_dis-chk-doc_obj:handle.
      105       v_bbh = buffer buf_bar-code_:handle.
      106       v_tbbh = buffer buft_bar-code_:handle.
      107     end constructor.
      108     destructor public dis-chk-gds_obj():
      109       define buffer buf_temp-call-param for temp-call-param.
      110       define variable glog as logical no-undo .
      111       assign
      112       glog = v_tbh:empty-temp-table() no-error .
      113       assign
      114       glog = v_tbdh:empty-temp-table() no-error .
      115       assign
      116       glog = v_tbbh:empty-temp-table() no-error .
      117       find_dis-chk-gds_obj ( input '':U, input 0).
      118       for each buf_temp-call-param:
      119         if buf_temp-call-param.param-number = 0 then do:
      120           delete object buf_temp-call-param.call-handle_.
      121         end.
      122         delete buf_temp-call-param.
      123       end.
      124     end destructor.
      125     method public logical find_dis-chk-gds_obj ( p-doc-code as character, p-line-num as integer):
      126      define variable glog as logical no-undo .
      127      dis-chk-gds_objrelease_().
      128      clear_().
      129       if p-doc-code <> '':U then do:
      130         assign
      131         glog =  v_bh:find-first( substitute('where doc-code = "&1" and line-num = &2'
      132                                             , p-doc-code
      133                                             , p-line-num
      134                                             ), lock, wait) no-error .
      135         if not glog then do:
      136           if find_no-error then do:
      137             return no.
      138           end.
      139           if lock = No-LOCK then do:
      140             if v_tbh:available then
      141             assign glog = v_tbh:buffer-delete() no-error .
      142             return error substitute("Не найдена строка чека &1 &2", p-doc-code, p-line-num).
      143           end.
      144           if wait = NO-WAIT
      145           and v_bh:locked then do:
      146             if v_tbh:available then
      147             assign glog = v_tbh:buffer-delete() no-error .
      148             if find_no-error then do:
      149               return no.
      150             end.
      151             else do:
      152               return error substitute("&2 строка чека &1 занята", p-doc-code, p-line-num).
      153             end.
      154           end.
      155         end.
      156         if p-doc-code <> doc-code then do:
      157           assign
      158           glog =  v_bdh:find-first( substitute('where doc-code = "&1"'
      159                                               , p-doc-code
      160                                               ), lock, wait) no-error .
      161           if not glog then do:
      162             return error substitute("Не найден чек &1", p-doc-code).
      163           end.
      164         end.
      165         assign
      166         glog =  v_bbh:find-first( substitute('where b-code = "&1"'
      167                                             , buf_dis-chk-gds_obj.b-code
      168                                             ), no-lock, wait) no-error .
      169         if not glog then do:
      170           return error substitute("Не найден баркод &1 для строки &2 чека &3"
      171                                   , buf_dis-chk-gds_obj.b-code
      172                                   ,line-num
      173                                   ,p-doc-code
      174                                   ).
      175         end.
      176         assign
      177         doc-code             = buf_dis-chk-gds_obj.doc-code
      178         line-num             = buf_dis-chk-gds_obj.line-num
      179         d-card               = buf_dis-chk-gds_obj.d-card
      180         discnt               = buf_dis-chk-gds_obj.discnt
      181         price-base           = buf_dis-chk-gds_obj.price-base
      182         doc-qnty             = buf_dis-chk-gds_obj.doc-qnty
      183         b-code               = buf_dis-chk-gds_obj.b-code
      184         gds-code#            = buf_bar-code_.gds-code
      185         chk-type#            = buf_dis-chk-doc_obj.chk-type
      186         obj-type#            = buf_dis-chk-doc_obj.obj-type
      187         obj-code#            = buf_dis-chk-doc_obj.obj-code
      188         base-rate#           = buf_dis-chk-doc_obj.base-rate
      189         base-scale#          = 1
      190         chk-date#            = buf_dis-chk-doc_obj.chk-date
      191         chk-time#            = buf_dis-chk-doc_obj.chk-time
      192         .
      193         glog = v_tbh:buffer-create( ).
      194         glog = v_tbh:buffer-copy( v_bh).
      195         glog = v_tbbh:buffer-create( ).
      196         glog = v_tbbh:buffer-copy( v_bbh).
      197         glog = v_tbdh:buffer-create( ).
      198         glog = v_tbdh:buffer-copy( v_bdh).
      199       end.
      200       return yes.
      201     end method.
      202     method public logical select_dis-chk-gds_obj ( input p-prepare-phrase-doc as character
      203                                                  , input p-prepare-phrase-gds as character):
      204       define variable glog as logical no-undo.
      205       assign
      206       glog = v_qh:query-prepare( substitute("for each bufq_dis-chk-doc_obj no-lock where &1, " +
      207                                                  "each bufq_dis-chk-gds_obj no-lock where " +
      208                                                   "bufq_dis-chk-gds_obj.doc-code = bufq_dis-chk-doc_obj.doc-code and &2"
      209                                ,p-prepare-phrase-doc
      210                                ,p-prepare-phrase-gds)
      211                                ) no-error .
      212       if not glog then do:
      213         return error substitute("Ошибка подготовки выборки по строкам чека:&1&2&1&3&1&4"
      214                                  , chr(10)
      215                                  , error-status:get-message(1)
      216                                  , p-prepare-phrase-doc
      217                                  , p-prepare-phrase-gds
      218                                  ).
      219       end.
      220       assign
      221       glog = v_qh:query-open no-error .
      222       if error-status:error then do:
      223         return error substitute("Ошибка открытия выборки по строкам чека:&1&2&1&3"
      224                                  , chr(10)
      225                                  , error-status:get-message(1)
      226                                  , v_qh:prepare-string ).
      227       end.
      228     end method.
      229     method public logical get_dis-chk-gds_obj( input p-rec-pos as character):
      230       define variable glog as logical no-undo .
      231       if not v_qh:is-open then do:
      232         return error substitute("Выборка по строкам чека:&1(&2)&1еще на открыта"
      233                                 , chr(10)
      234                                 , v_qh:prepare-string
      235                                  ).
      236       end.
      237       case p-rec-pos:
      238         when "first" then do:
      239           glog = v_qh:get-first(lock, wait)  .
      240         end.
      241         when "last" then do:
      242           glog = v_qh:get-last(lock, wait)  .
      243         end.
      244         when "next" then do:
      245           glog = v_qh:get-next(lock, wait)  .
      246         end.
      247         when "prev" then do:
      248           glog = v_qh:get-prev(lock, wait)  .
      249         end.
      250       end case.
      251       if glog then do:
      252          assign
      253          glog = find_dis-chk-gds_obj ( input bufq_dis-chk-gds_obj.doc-code, input bufq_dis-chk-gds_obj.line-num) no-error .
      254       end.
      255       return glog.
      256     end method.
      257     method public logical has_dis-rule( input  p-rule-num as integer):
      258       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      259       if doc-code = '':U
      260       or line-num = 0 then do:
      261         return error substitute("Остутствует строка чека").
      262       end.
      263       find first buf_dis-gds-rule no-lock where
      264                 buf_dis-gds-rule.gds-code = gds-code#
      265             and buf_dis-gds-rule.rule-num = p-rule-num no-error .
      266       return (available buf_dis-gds-rule).
      267     end method.
      268     method public logical run_dis-rule ( input p-rule-num as integer
      269                                              ,input p-discnt-role as character
      270                                              ,input p-pos-type as character
      271                                              ):
      272       define variable jj as integer no-undo .
      273       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   define variable v-ii as integer no-undo .
      276   define buffer buf_temp-call-param for temp-call-param.
      277   define buffer buf2_temp-call-param for temp-call-param.
      278   define buffer buf_drt-prop for ub.drt-prop.
      279       if doc-code = '':U
      280       or line-num = 0 then do:
      281         return error substitute("Остутствует строка чека").
      282       end.
      283       do jj = 1 to 2:
      284         if jj = 1 then do:
      285           find first buf_dis-gds-rule no-lock where
      286                     buf_dis-gds-rule.gds-code = gds-code#
      287                 and (p-rule-num = 0 or buf_dis-gds-rule.rule-num = p-rule-num)
      288                 and (p-pos-type = '':U or buf_dis-gds-rule.pos-type = p-pos-type)
      289                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      290                 and buf_dis-gds-rule.obj-type = obj-type#
      291                 and buf_dis-gds-rule.obj-code = obj-code#
      292                 no-error .
      293         end.
      294         if jj = 2 then do:
      295           find first buf_dis-gds-rule no-lock where
      296                     buf_dis-gds-rule.gds-code = gds-code#
      297                 and (p-rule-num = 0 or buf_dis-gds-rule.rule-num = p-rule-num)
      298                 and (p-pos-type = '':U or buf_dis-gds-rule.pos-type = p-pos-type)
      299                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      300                 and buf_dis-gds-rule.obj-type = '':U
      301                 and buf_dis-gds-rule.obj-code = 0
      302                 no-error .
      303         end.
      304         if available buf_Dis-gds-rule then do:
      305   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   find first buf_temp-call-param where
      307           buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      308       and buf_temp-call-param.param-num = 0 no-error .
      309   if not available buf_temp-call-param then do:
      310     if v_gc:get-signature(substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))) = '':u then do:
      311       undo, return error substitute("Определение &1 отсутствует в &2"
      312                                      ,substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      313                                      , v_gc:file-name).
      314     end.
      315     create buf_temp-call-param.
      316     assign
      317     buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      318     buf_temp-call-param.param-number_ = 0
      319     .
      320     for each buf_drt-prop no-lock where
      321             buf_drt-prop.templ-rl-root = buf_dis-gds-rule.templ-rl-root
      322         and buf_drt-prop.upper-prop-code = "Call-params"
      323       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info3,  return-value, chr(10), error-status :get-message (1))
      324       on stop   undo , return error substitute( "&1. stop", vss-include-info3 )
      325       on endkey undo , return error substitute( "&1. endkey", vss-include-info3 ):
      326       if integer(buf_drt-prop.prop-code) = 0 then do:
      327         assign
      328         buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      329         buf_temp-call-param.param-number_ = integer(buf_drt-prop.prop-code)
      330         buf_temp-call-param.param-name_ = entry(1, buf_drt-prop.property-value)
      331         buf_temp-call-param.param-datatype_ = entry(2, buf_drt-prop.property-value)
      332         buf_temp-call-param.io-mode_ = entry(3, buf_drt-prop.property-value)
      333         buf_temp-call-param.param-label_ = entry(4, buf_drt-prop.property-value)
      334         .
      335       end.
      336       else do:
      337         create buf2_temp-call-param.
      338         assign
      339         v-ii = v-ii + 1
      340         buf2_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      341         buf2_temp-call-param.param-number_ = integer(buf_drt-prop.prop-code)
      342         buf2_temp-call-param.param-name_ = entry(1, buf_drt-prop.property-value)
      343         buf2_temp-call-param.param-datatype_ = entry(2, buf_drt-prop.property-value)
      344         buf2_temp-call-param.io-mode_ = entry(3, buf_drt-prop.property-value)
      345         buf2_temp-call-param.param-label_ = entry(4, buf_drt-prop.property-value)
      346         .
      347       end.
      348     end.
      349     assign
      350     buf_temp-call-param.num-params = v-ii
      351     .
      352   end.
      353           for each buf_temp-call-param where
      354                   buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      355           on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0,  return-value, chr(10), error-status :get-message (1))
      356           on stop   undo , return error substitute( "&1. stop", vss-include-info0 )
      357           on endkey undo , return error substitute( "&1. endkey", vss-include-info0 )
      358           :
      359             case buf_temp-call-param.param-name_:
      360               when "p-rule-num" then do:
      361                 assign
      362                 buf_temp-call-param.integer_ = p-rule-num
      363                 .
      364               end.
      365               when "p-date" then do:
      366                 assign
      367                 buf_temp-call-param.date_ = chk-date#
      368                 .
      369               end.
      370               when "p-time" then do:
      371                 assign
      372                 buf_temp-call-param.integer_ = chk-time#
      373                 .
      374               end.
      375               when "p-doc-qnty" then do:
      376                 assign
      377                 buf_temp-call-param.decimal_ = doc-qnty
      378                 .
      379               end.
      380               when "p-tot-sum" then do:
      381                 assign
      382                 buf_temp-call-param.decimal_ = doc-qnty * price-base
      383                 .
      384               end.
      385               when "p-grp-code" then do:
      386               end.
      387               when "p-dis-kat" then do:
      388               end.
      389             end case.
      390           end.
      391   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392     find first buf_temp-call-param where
      393               buf_temp-call-param.call-name_ = substitute("dis-rule_&1", string(buf_dis-gds-rule.templ-rl-root, "99999"))
      394           and buf_temp-call-param.param-number = 0.
      395     if not valid-handle(buf_temp-call-param.call-handle_) then do:
      396       create call buf_temp-call-param.call-handle_.
      397       assign
      398       buf_temp-call-param.call-handle_:call-name = buf_temp-call-param.call-name_
      399       buf_temp-call-param.call-handle_:call-type = FUNCTION-CALL-TYPE
      400       buf_temp-call-param.call-handle_:in-handle = v_gc
      401       buf_temp-call-param.call-handle_:num-parameters = buf_temp-call-param.num-params
      402       .
      403     end.
      404   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405     for each buf2_temp-call-param where
      406             buf2_temp-call-param.param-num > 0
      407     on error  undo , return error substitute( "&1. &2&3&4", vss-include-info5,  return-value, chr(10), error-status :get-message (1))
      408     on stop   undo , return error substitute( "&1. stop", vss-include-info5 )
      409     on endkey undo , return error substitute( "&1. endkey", vss-include-info5 ):
      410       buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
      411                                                       ,buf2_temp-call-param.param-datatype_
      412                                                       ,buf2_temp-call-param.io-mode
      413                                                       ,buffer buf2_temp-call-param:buffer-field( substitute("&1_", buf2_temp-call-param.param-datatype_)):buffer-value).
      414     end.
      415     assign
      416     buf_temp-call-param.call-number = buf_temp-call-param.call-number + 1
      417     v-last-call-number = buf_temp-call-param.call-number
      418     v-last-call-name = buf_temp-call-param.call-name_
      419     .
      420     buf_temp-call-param.call-handle_:invoke.
      421     assign
      422     buf_temp-call-param.param-datatype_ = buf_temp-call-param.call-handle_:return-value-data-type.
      423     case buf_temp-call-param.param-datatype_:
      424         when 'character':U then do:
      425           assign
      426           buf_temp-call-param.character_ = buf_temp-call-param.call-handle_:return-value.
      427         end.
      428         when 'date':U then do:
      429           assign
      430           buf_temp-call-param.date_ = buf_temp-call-param.call-handle_:return-value.
      431         end.
      432         when 'decimal':U then do:
      433           assign
      434           buf_temp-call-param.decimal_ = buf_temp-call-param.call-handle_:return-value.
      435         end.
      436         when 'integer':U then do:
      437           assign
      438           buf_temp-call-param.integer_ = buf_temp-call-param.call-handle_:return-value.
      439         end.
      440         when 'logical':U then do:
      441           assign
      442           buf_temp-call-param.logical_ = buf_temp-call-param.call-handle_:return-value.
      443         end.
      444     end case.
      445           RETURN  YES.
      446         end.
      447       end.
      448       return no.
      449     end method.
      450   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451     method public decimal get_dis-rule-value_decimal ( input p-param-name as character):
      452       define buffer buf_temp-call-param for temp-call-param.
      453       find first buf_temp-call-param where
      454                 buf_temp-call-param.param-name_ = p-param-name
      455             and buf_temp-call-param.call-name_ = v-last-call-name no-error .
      456       if not available buf_temp-call-param then do:
      457         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - отсутствуют"
      458                                      ,vss-include-info6
      459                                      ,v-last-call-name
      460                                      ,p-param-name).
      461       end.
      462       if buf_temp-call-param.call-number <> v-last-call-number then do:
      463         undo, return error substitute("&1 данные о результатах расчета &2 по правилу скидки - параметр &3 - уже затерты"
      464                                      ,vss-include-info6
      465                                      ,v-last-call-name
      466                                      ,p-param-name).
      467       end.
      468       return buf_temp-call-param.decimal_.
      469     end method.
