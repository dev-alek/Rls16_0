        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.dis-card-payment_host:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-card-payment_host.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_lh as widget-handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define private variable v_tbh as handle no-undo.
       10     define private variable v-error-flag as logical no-undo.
       11     define public variable pay-tot-base as decimal no-undo .
       12     define public variable pay-tot-rubl as decimal no-undo .
       13     define public variable host-code as integer no-undo.
       14     define public variable d-card as character no-undo .
       15     define public variable sale-doc as character no-undo.
       16     define public variable doc-date as date no-undo.
       17     define public variable base-code as integer no-undo.
       18     define protected variable codex_id as integer no-undo.
       19     define protected variable ruleset_id as integer no-undo.
       20     define private variable v-h-action as integer no-undo .
       21     CONSTRUCTOR PUBLIC dis-card-payment_host(
       22                                          input parparentproc as widget-handle
       23                                         ,input p-parent-handle as handle
       24                                         ,input p-log-handle as handle
       25                                         ,input p-gc-handle as handle
       26                                         ,input p-tbh as handle
       27                                         ,input p-codex-id as integer
       28                                         ,input p-ruleset-id as integer
       29                                         ):
       30       define variable glog as logical no-undo .
       31       run garbcoll_create-gc-entry in p-gc-handle (input "dis-card-payment_host",  input this-object) no-error.
       32       if error-status:error then do:
       33         message error-status:get-message(1) view-as alert-box .
       34         return error "Ошибка создания объекта платеж на ДК".
       35       end.
       36       assign
       37       v_ph = p-parent-handle
       38       v_gc = p-gc-handle
       39       v_tbh = p-tbh
       40       d-card = '':U
       41       codex_id = p-codex-id
       42       ruleset_id = p-ruleset-id
       43       .
       44     end constructor.
       45     destructor public dis-card-payment_host():
       46       find_dis-card-payment_host ( input '':U).
       47     end destructor.
       48     method public handle get_dis-card-payment_host ( ):
       49       return v_tbh.
       50     end method.
       51     method public void dis-card-payment_hostrelease_ (  ):
       52       define variable glog as logical no-undo .
       53       glog = v_tbh:buffer-release() no-error .
       54       clear_().
       55     end method.
       56     method public logical dis-card-payment_hostsave ():
       57      define variable glog as logical no-undo .
       58      define variable v-rate as decimal no-undo .
       59      define buffer buf_curr-shop for ub.curr-shop.
       60      define buffer buf_curr-accnt for ub.curr-accnt.
       61      define buffer buf_dis-card for ub.dis-card.
       62       if d-card <> '':U then do:
       63           find first buf_dis-card no-lock where
       64                   buf_dis-card.d-card = d-card no-error.
       65           if not available buf_dis-card then do:
       66             run set-error in v_gc (substitute("Не найдена ДК для создания итогов по ДК(ДК &1 фирма &2)"
       67                                               , d-card
       68                                               , host-code)).
       69             return no.
       70           end.
       71           if (pay-tot-base + pay-tot-rubl ) = ? then do:
       72             run set-error in v_gc (substitute("Не задано ( =  ?) значение одной из сумм для ДК &1 фирма &2"
       73                                               , d-card
       74                                               , host-code
       75                                               )).
       76             return no.
       77           end.
       78           if (pay-tot-base = 0.0) <> (pay-tot-rubl = 0.0) then do:
       79             run set-error in v_gc (substitute("Если сумма оплат в нац.вал. = 0, то сумма оплат в баз.вал. тоже должна = 0 и наборот (ДК &1 фирма &2)"
       80                                               , d-card
       81                                               , host-code)).
       82             return no.
       83           end.
       84           if base-code = 0
       85           and pay-tot-base <> pay-tot-rubl then do:
       86             run set-error in v_gc (substitute("Баз.вал. фирмы = нац.вал. но сумма оплат в баз.вал. <> сумме оплат в нац.вал.(ДК &1 фирма &2)"
       87                                               , d-card
       88                                               , host-code)).
       89             return no.
       90           end.
       91           if doc-date = ? then do:
       92             run set-error in v_gc (substitute("Не задана дата итогов по ДК(ДК &1 фирма &2)"
       93                                               , d-card
       94                                               , host-code)).
       95             return no.
       96           end.
       97           assign
       98           v_tbh:buffer-field("pay-tot-base"):buffer-value  = pay-tot-base
       99           v_tbh:buffer-field("pay-tot-rubl"):buffer-value  = pay-tot-rubl
      100           .
      101       end.
      102       return glog.
      103     end method.
      104     method public logical find_dis-card-payment_host ( p-d-card as character):
      105       define variable glog as logical no-undo .
      106       glog = find_dis-card-payment_host( input p-d-card, input 0) no-error .
      107       if error-status:error then return error return-value .
      108       return glog.
      109     end method.
      110     method public logical find_dis-card-payment_host ( p-d-card as character, p-host-code as integer):
      111      define variable glog as logical no-undo .
      112      define variable v-rate as decimal no-undo .
      113      define buffer buf_curr-accnt for ub.curr-accnt.
      114      define buffer buf_dis-card for ub.dis-card.
      115       dis-card-payment_hostrelease_().
      116       clear_().
      117       if p-d-card <> '':U then do:
      118         v-h-action = integer('2':U).
      119         assign
      120         glog =  v_tbh:find-first( substitute('where d-card = "&1" and host-code = &2'
      121                                 , p-d-card
      122                                 ,p-host-code
      123                                 )
      124                                 ) no-error .
      125         if not glog then do:
      126           return error substitute("Не найдены платеж по ДК &1", p-d-card).
      127         end.
      128         assign
      129         v-h-action = integer('2':U)
      130         pay-tot-base         = v_tbh:buffer-field("pay-tot-base"):buffer-value
      131         pay-tot-rubl         = v_tbh:buffer-field("pay-tot-rubl"):buffer-value
      132         d-card               = v_tbh:buffer-field("d-card"):buffer-value
      133         sale-doc             = v_tbh:buffer-field("sale-doc"):buffer-value
      134         doc-date             = v_tbh:buffer-field("doc-date"):buffer-value
      135         base-code            =  v_tbh:buffer-field("base-code"):buffer-value
      136         host-code            =  v_tbh:buffer-field("host-code"):buffer-value
      137         .
      138       end.
      139       return glog.
      140     end method.
      141     method public logical create_dis-card-payment_host ( input p-d-card as character
      142                                                ,input p-host-code as integer
      143                                                ,input p-sale-doc as character
      144                                                ,input p-doc-date as date
      145                                                ):
      146       define variable glog as logical no-undo .
      147       define buffer buf_clients for ub.clients.
      148       define buffer buf_dis-card for ub.dis-card.
      149       define buffer buf_sysconf for ub.sysconf.
      150       find first buf_clients no-lock where
      151                 buf_clients.obj-type = 'орг':U
      152             and buf_clients.obj-code = p-host-code no-error.
      153       if not available buf_clients
      154       then do:
      155         run set-error in v_gc (substitute("Неверно задана фирма для создания платежа по ДК(ДК &1 фирма &2)"
      156                                           , d-card
      157                                           , p-host-code)).
      158         return no.
      159       end.
      160       find first buf_sysconf no-lock where
      161                 buf_sysconf.host-code = buf_clients.obj-code no-error.
      162       if not available buf_clients then do:
      163         run set-error in v_gc (substitute("Неверно задана фирма для создания платежа по ДК - клиент &2&3  не является фирмой IBS TH(ДК &1)"
      164                                           , d-card
      165                                           , buf_clients.obj-type
      166                                           , p-host-code
      167                                           )).
      168         return no.
      169       end.
      170       find first buf_Dis-card no-lock where
      171                 buf_Dis-card.d-card = p-d-card no-error.
      172       if not available buf_dis-card then do:
      173         glog = no.
      174         run can-find_dis-card_ in v_gc ( input p-d-card
      175                                         ,output glog) no-error .
      176         if not glog then do:
      177           run set-error in v_gc (substitute("Неверно задана ДК для создания платежа по ДК(ДК &1 фирма &2)"
      178                                           , d-card
      179                                           , p-host-code
      180                                             )).
      181           return no.
      182         end.
      183       end.
      184       glog = v_tbh:buffer-create( ).
      185       assign
      186       d-card = p-d-card
      187       v-h-action = integer('1':U)
      188       host-code            = buf_clients.host-code
      189       base-code            = buf_sysconf.base-code
      190       host-code            = p-host-code
      191       sale-doc             = p-sale-doc
      192       doc-date             = p-doc-date
      193       v_tbh:buffer-field("d-card"):buffer-value = d-card
      194       v_tbh:buffer-field("host-code"):buffer-value = host-code
      195       v_tbh:buffer-field("base-code"):buffer-value = base-code
      196       v_tbh:buffer-field("host-code"):buffer-value = obj-code
      197       v_tbh:buffer-field("sale-doc"):buffer-value = sale-doc
      198       v_tbh:buffer-field("doc-date"):buffer-value = doc-date
      199       pay-tot-base         = 0.0
      200       pay-tot-rubl         = 0.0
      201       .
      202       return yes.
      203     end method.
      204     method protected void clear_():
      205       define variable glog as logical no-undo .
      206       v-error-flag = no.
      207       glog = v_tbh:buffer-delete() no-error .
      208       assign
      209       d-card = ''
      210       v-h-action = 0
      211       .
      212     end method.
      213     method public override character ToString( ):
      214       return substitute("&1 &2", d-card, sale-doc).
      215     end method.
      216   end class.
