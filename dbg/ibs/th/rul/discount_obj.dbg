        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.discount_obj:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: discount_obj.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_lh as widget-handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected buffer buf_discount_obj for ub.dis-card-property.
       10     define protected temp-table t-discount_obj no-undo like ub.dis-card-property
       11     field recid_ as recid
       12     field h-n-action as integer
       13     field ordinal as integer
       14     field init-value-character as character
       15     field init-value-date as date
       16     field init-value-decimal as decimal
       17     field init-value-integer as integer
       18     field init-value-logical as logical
       19     field node-name as character
       20    .
       21     define protected buffer buft_discount_obj for t-discount_obj.
       22     define public variable v_bh as handle no-undo.
       23     define protected variable v_tbh as handle no-undo.
       24     define protected variable v_tcbh as handle no-undo .
       25     define public variable temp as integer no-undo.
       26     define public property lock as integer
       27     get.
       28     set.
       29     define public property wait as integer
       30     get.
       31     set.
       32     define private buffer buf_prop-map for ub.prop-map.
       33     define protected variable dtm-code as integer no-undo .
       34     define protected variable node-code# as integer no-undo .
       35     define protected variable dt-code as integer no-undo .
       36     define protected variable num-members as integer no-undo .
       37     define private variable v-error-flag as logical no-undo.
       38     define public variable card-num as integer no-undo .
       39     define public variable d-card as character no-undo .
       40     define public variable first-card as character no-undo .
       41     define public variable first-main-card as character no-undo .
       42     define public variable main-card as character no-undo .
       43     define public variable type# as character no-undo .
       44     define public variable emitent-host-code# as integer no-undo .
       45     define public variable host-code as integer no-undo .
       46     define public variable obj-type as character no-undo .
       47     define public variable obj-code as integer no-undo .
       48     define public variable d-pcnt as decimal no-undo .
       49     define public variable cash-d-pcnt as decimal no-undo .
       50     define public variable category as integer no-undo .
       51     CONSTRUCTOR PUBLIC discount_obj(
       52                                  input parparentproc as widget-handle
       53                                 ,input p-parent-handle as handle
       54                                 ,input p-log-handle as handle
       55                                 ,input p-gc-handle as handle
       56                                 ,input p-cont-handle as handle
       57                                 ,input p-lock as integer
       58                                 ,input p-wait as integer
       59                                 ,input p-temp as integer
       60                                 ,input p-dtm-code as integer
       61                               ):
       62   define variable glog as logical no-undo .
       63   assign
       64   v_pp = parparentproc
       65   v_lh = p-log-handle
       66   v_ph = p-parent-handle
       67   v_gc = p-gc-handle
       68   v_cnt = p-cont-handle
       69   lock = p-lock
       70   wait = p-wait
       71   temp = p-temp
       72   .
       73   run garbcoll_create-gc-entry in p-gc-handle (input 'discount_obj',  input this-object) no-error.
       74   if error-status:error then do:
       75     return error substitute("&1 Ошибка создания объекта discount_obj", vss-include-info0).
       76   end.
       77   v_bh = buffer buf_discount_obj:handle.
       78   v_tbh = buffer buft_discount_obj:handle.
       79       if temp < 0 then do:
       80         run tempcont_get-buffer-handle in v_cnt ( input 'dis-card-property':U
       81                                                   ,output v_tcbh).
       82       end.
       83       define buffer buf_prop-ref for ub.prop-ref.
       84       find first buf_prop-ref no-lock where
       85                buf_prop-ref.dtm-code = p-dtm-code no-error .
       86       if error-status:error then do:
       87          undo, return error substitute( "&1. Не найден срез &2 в справочнике итогов для ОБЪЕКТА СКИДКА-КАТЕГОРИЯ ПО ФИРМЕ-ОБЪЕКТУ&4"
       88                                          , vss-include-info0
       89                                          , chr(10)
       90                                          ).
       91       end.
       92       assign
       93       d-card = '':U
       94       dtm-code = p-dtm-code
       95       dt-code = buf_prop-ref.dt-code
       96       node-code# = 0
       97      .
       98       for each buf_prop-map  where buf_prop-map.dtm-code = p-dtm-code
       99       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      100       :
      101         create buft_discount_obj.
      102         assign
      103         buft_discount_obj.dtm-code = buf_prop-map.dtm-code
      104         buft_discount_obj.node-code = buf_prop-map.node-code
      105         buft_discount_obj.node-name = buf_prop-map.node-name
      106         buft_discount_obj.ordinal = buf_prop-map.ordinal
      107         buft_discount_obj.init-value-character = buf_prop-map.init-value-character
      108         buft_discount_obj.init-value-date      = buf_prop-map.init-value-date
      109         buft_discount_obj.init-value-decimal   = buf_prop-map.init-value-decimal
      110         buft_discount_obj.init-value-integer   = buf_prop-map.init-value-integer
      111         buft_discount_obj.init-value-logical   = buf_prop-map.init-value-logical
      112         num-members = num-members + 1
      113         .
      114       end.
      115     end constructor.
      116     destructor public discount_obj():
      117       define variable glog as logical no-undo .
      118       for each buft_discount_obj:
      119         delete buft_discount_obj.
      120       end.
      121       find_discount_obj ( input '':U
      122                          ,input obj-type
      123                          ,input obj-code
      124                            ).
      125     end destructor.
      126     method public void Discount_objrelease_ ( ):
      127       define variable glog as logical no-undo .
      128       glog = v_bh:buffer-release() no-error .
      129       clear_().
      130     end method.
      131     method public handle get_discount_obj ( ):
      132       return v_bh.
      133     end method.
      134     method public logical set_discount_obj ( input p-bh as handle):
      135       define variable glog as logical no-undo .
      136       glog = v_bh:buffer-copy ( p-bh).
      137       return glog.
      138     end method.
      139     method public logical discount_objsave ( ):
      140      define variable glog as logical no-undo .
      141      define variable v-tosave as logical no-undo .
      142      define buffer buf_dis-card for ub.dis-card.
      143       if d-card <> '':U then do:
      144           _save:
      145           for each buft_discount_obj
      146           on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      147           :
      148             v-tosave = no.
      149             if buft_discount_obj.node-name = "d-pcnt"
      150             then do:
      151               if buft_discount_obj.init-value-decimal = d-pcnt then next _save.
      152               assign
      153               buft_discount_obj.property-value-decimal = d-pcnt
      154               .
      155             end.
      156             if buft_discount_obj.node-name = "cash-d-pcnt" then do:
      157               if buft_discount_obj.init-value-decimal = cash-d-pcnt then next _save.
      158               assign
      159               buft_discount_obj.property-value-decimal = cash-d-pcnt
      160               .
      161             end.
      162             if buft_discount_obj.node-name = "category" then do:
      163               if buft_discount_obj.init-value-integer = category then next _save.
      164               assign
      165               buft_discount_obj.property-value-integer = category
      166               .
      167             end.
      168             if buft_discount_obj.h-n-action = integer('2':U)
      169             or buft_discount_obj.h-n-action = integer('1':U)
      170             then do:
      171               if temp >= 0 then do:
      172                 if buft_discount_obj.recid_ <> ? then do:
      173                   find first buf_discount_obj exclusive-lock where
      174                       recid(buf_discount_obj) = buft_discount_obj.recid_.
      175                   v-tosave = not (v_bh:buffer-compare(v_tbh)).
      176                 end.
      177                 else do:
      178                   glog = v_bh:buffer-create().
      179                   glog = v_bh:buffer-copy( v_tbh, "property-value-character,property-value-date,property-value-decimal,property-value-integer,property-value-logical").
      180                   v-tosave = yes.
      181                 end.
      182                 if temp = 1 then do:
      183                   run tempcont_create-changes in v_cnt (
      184                                                   input 'dis-card-property':U
      185                                                 ,input v_bh
      186                                                 ,input v_tbh
      187                                                 ,input buft_discount_obj.h-n-action
      188                                                 ) no-error.
      189                   if error-status:error then do:
      190                     undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      191                   end.
      192                 end.
      193                 if v-tosave then do:
      194                 run disproph_write-dis-card-property-rul in v_gc ( buffer buf_discount_obj
      195                                                         ,input type#
      196                                                         ,input emitent-host-code#
      197                                                         ,input 26
      198                                                         ,input buft_discount_obj.h-n-action) no-error .
      199                 if error-status:error then do:
      200                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      201                 end.
      202                 glog = v_bh:buffer-copy( v_tbh).
      203                 run disproph_send-dis-card-property-rul in v_gc ( buffer buf_discount_obj
      204                                                         ,input type#
      205                                                         ,input emitent-host-code#
      206                                                           ,input 26
      207                                                         ,input buft_discount_obj.h-n-action) no-error .
      208                 if error-status:error then do:
      209                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      210                 end.
      211                 end.
      212               end.
      213               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      214               if temp >= 0
      215               and v-tosave
      216               then do:
      217                 run cb_create-dc-list in v_ph ( input v_bh) no-error.
      218               end.
      219               glog = v_bh:buffer-release() no-error .
      220               if error-status:error then do:
      221                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      222               end.
      223               if temp = -1 then do:
      224                 run tempcont_create-changes in v_cnt (
      225                                                 input 'dis-card-property':U
      226                                                ,input v_bh
      227                                                ,input v_tbh
      228                                                ,input buft_discount_obj.h-n-action) no-error.
      229                 if error-status:error then do:
      230                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      231                 end.
      232               end.
      233               if temp = -2 then do:
      234                 run tempcont_create-record in v_cnt (
      235                                                 input 'dis-card-property':U
      236                                                ,input v_tbh
      237                                                ,input buft_discount_obj.h-n-action) no-error.
      238                 if error-status:error then do:
      239                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      240                 end.
      241               end.
      242             end.
      243           end.
      244       end.
      245       return yes.
      246     end method.
      247      method public logical find_discount_obj ( input p-d-card as character
      248                                              , input p-obj-type as character
      249                                              , input p-obj-code as integer
      250                                               ):
      251      define variable glog as logical no-undo .
      252      define variable v-jj as integer no-undo .
      253      define variable v-where as character no-undo .
      254      define buffer buf_dis-card for ub.dis-card.
      255      define buffer buf_sysconf for ub.sysconf.
      256      define buffer buf_clients for ub.clients.
      257       discount_objrelease_().
      258       clear_().
      259       if p-d-card <> '':U then do:
      260         find first buf_dis-card no-lock where
      261                   buf_dis-card.d-card = p-d-card no-error.
      262         if not available buf_dis-card then do:
      263            return error substitute("Не найдена ДК &1", p-d-card).
      264         end.
      265         find first buf_clients no-lock where
      266                   buf_clients.obj-type = p-obj-type
      267               and buf_clients.obj-code = p-obj-code no-error.
      268         if not available buf_clients
      269         or not (p-obj-type = 'маг':U or p-obj-type = 'скл':U)
      270         then do:
      271           run set-error in v_gc (substitute("Неверно задан объект для создания свойства <Скидка по объекту> (ДК &1 &2&3)"
      272                                             , d-card
      273                                             , p-obj-type
      274                                             , p-obj-code)).
      275           return no.
      276         end.
      277         find first buf_sysconf no-lock where
      278                   buf_sysconf.host-code = buf_clients.host-code no-error.
      279         if not available buf_clients then do:
      280           run set-error in v_gc (substitute("Неверно задан объект для создания свойства <Скидка по объекту> - не найдена фирма &4(ДК &1 &2&3)"
      281                                             , d-card
      282                                             , p-obj-type
      283                                             , p-obj-code
      284                                             , buf_clients.host-code
      285                                             )).
      286           return no.
      287         end.
      288         assign
      289         card-num                 = buf_dis-card.card-num
      290         d-card                   = buf_dis-card.d-card
      291         first-card               = buf_dis-card.first-card
      292         first-main-card          = buf_dis-card.first-main-card
      293         main-card                = buf_dis-card.main-card
      294         emitent-host-code#       = buf_dis-card.emitent-host-code
      295         type#                    = buf_dis-card.type
      296         host-code                = buf_sysconf.host-code
      297         obj-type                 = p-obj-type
      298         obj-code                 = p-obj-code
      299         .
      300         define variable v-ii as integer no-undo .
      301         _buft_dis-card-property:
      302         for each buft_discount_obj
      303         by buft_discount_obj.dt-code
      304         by buft_discount_obj.node-code
      305         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      306         :
      307           if temp < 0 then do:
      308             v-where =  substitute('where d-card = "&1" and host-code = &6 and obj-type = "&4" and obj-code = &5 and dt-code = &2 and node-code = &3'
      309                                   , p-d-card
      310                                   , dt-code
      311                                   , buft_discount_obj.node-code
      312                                   , p-obj-type
      313                                   , p-obj-code
      314                                   , buf_sysconf.host-code
      315                                   ).
      316             assign
      317             glog = v_tcbh:find-first( v-where) no-error .
      318             if v_tcbh:available then do:
      319               glog = v_tbh:buffer-copy( v_tcbh).
      320               assign
      321               buft_discount_obj.h-n-action             = integer('2':U)
      322               v-jj = v-jj + 1
      323               .
      324             end.
      325           end.
      326           if temp >= 0 or v_tcbh:available = no then do:
      327           assign
      328           buft_discount_obj.card-num                 = buf_dis-card.card-num
      329           buft_discount_obj.d-card                   = buf_dis-card.d-card
      330           buft_discount_obj.first-card               = buf_dis-card.first-card
      331           buft_discount_obj.first-main-card          = buf_dis-card.first-main-card
      332           buft_discount_obj.main-card                = buf_dis-card.main-card
      333           buft_discount_obj.recid_ = ?
      334           buft_discount_obj.h-n-action = 0
      335           buft_discount_obj.property-value-decimal   = buft_discount_obj.init-value-decimal
      336           buft_discount_obj.property-value-integer   = buft_discount_obj.init-value-integer
      337           buft_discount_obj.dt-code                  = dt-code
      338           buft_discount_obj.sum-id                   = 'Discount'
      339           buft_discount_obj.host-code                = buf_sysconf.host-code
      340           buft_discount_obj.obj-type                 = p-obj-type
      341           buft_discount_obj.obj-code                 = p-obj-code
      342           v-jj = v-jj + 1
      343           .
      344           v-where =  substitute('where d-card = "&1" and host-code = &6 and obj-type = "&4" and obj-code = &5 and dt-code = &2 and node-code = &3'
      345                                   , p-d-card
      346                                   , dt-code
      347                                   , buft_discount_obj.node-code
      348                                   , p-obj-type
      349                                   , p-obj-code
      350                                   , buf_sysconf.host-code
      351                                   ).
      352           assign
      353           glog =  v_bh:find-first( v-where
      354                                   , lock
      355                                   , wait) no-error .
      356           if not glog then do:
      357             if wait = NO-WAIT
      358             and v_bh:locked then do:
      359               return error substitute("Запись свойств ДК &1 занята", p-d-card).
      360             end.
      361             assign
      362             buft_discount_obj.h-n-action = integer('1':U).
      363             if v-jj = num-members then leave _buft_dis-card-property.
      364             next _buft_dis-card-property.
      365           end.
      366           else do:
      367             assign
      368             buft_discount_obj.h-n-action = integer('2':U)
      369             .
      370           end.
      371           assign
      372           v-ii = v-ii + 1
      373           buft_discount_obj.recid_ = recid(buf_discount_obj)
      374           .
      375           glog = v_tbh:buffer-copy( v_bh).
      376           end.
      377           if buft_discount_obj.node-name = "d-pcnt" then do:
      378              assign
      379              d-pcnt = buft_discount_obj.property-value-decimal
      380              node-code#                = buft_discount_obj.node-code
      381              .
      382           end.
      383           if buft_discount_obj.node-name = "cash-d-pcnt" then do:
      384              assign
      385              cash-d-pcnt = buft_discount_obj.property-value-decimal
      386              node-code#                = buft_discount_obj.node-code
      387              .
      388           end.
      389           if buft_discount_obj.node-name = "category" then do:
      390              assign
      391              category = buft_discount_obj.property-value-integer
      392              node-code#                = buft_discount_obj.node-code
      393              .
      394           end.
      395           if v-jj = num-members then leave _buft_dis-card-property.
      396         end.
      397         if v-ii = 0 then do:
      398           return no.
      399         end.
      400       end.
      401       return yes.
      402     end method.
      403     method public logical create_discount_obj ( input p-d-card as character
      404                                                ,input p-obj-type as character
      405                                                ,input p-obj-code as integer
      406                                                  ):
      407       define buffer buft2_ for t-discount_obj.
      408       for each buft2_ :
      409         if buft2_.recid_ = ?
      410         and buft2_.init-value-decimal <> 0.0
      411         then do:
      412           assign
      413           buft2_.h-n-action     = integer('1':U)
      414           .
      415         end.
      416         if buft2_.recid_ = ?
      417         and buft2_.init-value-integer <> 0
      418         then do:
      419           assign
      420           buft2_.h-n-action     = integer('1':U)
      421           .
      422         end.
      423       end.
      424       return yes.
      425     end method.
      426     method protected void clear_():
      427       define variable glog as logical no-undo .
      428       v-error-flag = no.
      429       assign
      430       d-card = ''
      431       .
      432       for each buft_discount_obj:
      433         assign
      434         buft_discount_obj.card-num                 = 0
      435         buft_discount_obj.d-card                   = '':U
      436         buft_discount_obj.first-card               = '':U
      437         buft_discount_obj.first-main-card          = '':U
      438         buft_discount_obj.main-card                = '':U
      439         buft_discount_obj.recid_ = ?
      440         buft_discount_obj.h-n-action = 0
      441         buft_discount_obj.property-value-decimal = buft_discount_obj.init-value-decimal
      442         buft_discount_obj.property-value-integer = buft_discount_obj.init-value-integer
      443         buft_discount_obj.dt-code                 = 0
      444         buft_discount_obj.sum-id                  = '':U
      445         buft_discount_obj.obj-type                = '':U
      446         buft_discount_obj.obj-code                = 0
      447         buft_discount_obj.host-code                = 0
      448         .
      449       end.
      450     end method.
      451     method public override character ToString( ):
      452       return substitute("ДК &1 объект-операнд &2, фирма &3 &4&5, свойство &6"
      453                         , d-card
      454                         , dtm-code
      455                         , host-code
      456                         , obj-type
      457                         , obj-code
      458                         , node-code#).
      459     end method.
      460   end class.
