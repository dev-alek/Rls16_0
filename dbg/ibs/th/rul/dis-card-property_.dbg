      487       buft_dis-card-property_.h-n-action = (if buft_dis-card-property_.recid_ = ?
      488                                             then integer('1':U)
      489                                             else buft_dis-card-property_.h-n-action)
      490       .
      491     end method.
      492     method public integer get-property-value-integer ( input p-node-code as integer):
      493        if p-node-code <> node-code# then do:
      494          find first buft_dis-card-property_ where
      495                    buft_dis-card-property_.dt-code = dt-code
