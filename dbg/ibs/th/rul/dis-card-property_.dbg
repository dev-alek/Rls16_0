      502        return property-value-integer#.
      503     end method.
      504     method public void set-property-value-integer  ( input p-integer as integer, input p-node-code as integer):
      505       if p-node-code <> node-code# then do:
      506          find first buft_dis-card-property_ where
      507                    buft_dis-card-property_.dt-code = dt-code
      508                and buft_dis-card-property_.node-code = p-node-code.
      509          assign
      510          node-code# = p-node-code.
      511       end.
      512       assign
      513       buft_dis-card-property_.property-value-integer = p-integer
      514       property-value-integer# = p-integer
      515       buft_dis-card-property_.h-n-action = (if buft_dis-card-property_.recid_ = ?
      516                                             then integer('1':U)
      517                                             else buft_dis-card-property_.h-n-action)
      518       .
      519     end method.
      520     method public logical get-property-value-logical ( input p-node-code as integer):
      521        if p-node-code <> node-code# then do:
      522          find first buft_dis-card-property_ where
      523                    buft_dis-card-property_.dt-code = dt-code
      524                and buft_dis-card-property_.node-code = p-node-code.
      525          assign
      526          property-value-logical# = buft_dis-card-property_.property-value-logical
      527          node-code# = buft_dis-card-property_.node-code
      528          .
      529        end.
      530        return property-value-logical#.
      531     end method.
      532     method public void set-property-value-logical  ( input p-logical as logical, input p-node-code as integer):
      533       if p-node-code <> node-code# then do:
      534          find first buft_dis-card-property_ where
      535                    buft_dis-card-property_.dt-code = dt-code
      536                and buft_dis-card-property_.node-code = p-node-code.
      537          assign
      538          node-code# = p-node-code.
      539       end.
      540       assign
      541       buft_dis-card-property_.property-value-logical = p-logical
      542       property-value-logical# = p-logical
      543       buft_dis-card-property_.h-n-action = (if buft_dis-card-property_.recid_ = ?
      544                                             then integer('1':U)
      545                                             else buft_dis-card-property_.h-n-action)
      546       .
      547     end method.
      548   end class.
