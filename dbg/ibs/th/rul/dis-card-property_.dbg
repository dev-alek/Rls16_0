        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.dis-card-property_:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: dis-card-property_.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_lh as widget-handle no-undo.
        6     define protected variable v_ph as handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected buffer buf_dis-card-property_ for ub.dis-card-property.
       10     define protected temp-table t-dis-card-property_ no-undo like ub.dis-card-property
       11     field recid_ as recid
       12     field h-n-action as integer
       13     field ordinal as integer
       14     field init-value-character as character
       15     field init-value-date as date
       16     field init-value-decimal as decimal
       17     field init-value-integer as integer
       18     field init-value-logical as logical
       19     .
       20     define protected buffer buft_dis-card-property_ for t-dis-card-property_.
       21     define public variable v_bh as handle no-undo.
       22     define protected variable v_tbh as handle no-undo.
       23     define private variable v-error-flag as logical no-undo .
       24     define public variable temp as integer no-undo.
       25     define public property lock as integer
       26     get.
       27     set.
       28     define public property wait as integer
       29     get.
       30     set.
       31     define private buffer buf_prop-map for ub.prop-map.
       32     define protected variable dtm-code as integer no-undo .
       33     define protected variable node-code# as integer no-undo .
       34     define protected variable dt-code as integer no-undo .
       35     define protected variable sum-id as character no-undo .
       36     define protected variable num-members as integer no-undo .
       37     define public variable card-num as integer no-undo .
       38     define public variable d-card as character no-undo .
       39     define public variable first-card as character no-undo .
       40     define public variable first-main-card as character no-undo .
       41     define public variable main-card as character no-undo .
       42     define public variable type# as character no-undo .
       43     define public variable emitent-host-code# as integer no-undo .
       44     define public variable host-code as integer no-undo .
       45     define public variable obj-type as character no-undo .
       46     define public variable obj-code as integer no-undo .
       47     define protected variable property-value-character# as character no-undo .
       48     define protected variable property-value-date# as date no-undo .
       49     define protected variable property-value-decimal# as decimal no-undo .
       50     define protected variable property-value-integer# as integer no-undo .
       51     define protected variable property-value-logical# as logical no-undo .
       52     CONSTRUCTOR PUBLIC dis-card-property_(
       53                                  input parparentproc as widget-handle
       54                                 ,input p-parent-handle as handle
       55                                 ,input p-log-handle as handle
       56                                 ,input p-gc-handle as handle
       57                                 ,input p-cont-handle as handle
       58                                 ,input p-lock as integer
       59                                 ,input p-wait as integer
       60                                 ,input p-temp as integer
       61                               ):
       62   define variable glog as logical no-undo .
       63   assign
       64   v_pp = parparentproc
       65   v_lh = p-log-handle
       66   v_ph = p-parent-handle
       67   v_gc = p-gc-handle
       68   v_cnt = p-cont-handle
       69   lock = p-lock
       70   wait = p-wait
       71   temp = p-temp
       72   .
       73   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-card-property_',  input this-object) no-error.
       74   if error-status:error then do:
       75     return error substitute("&1 Ошибка создания объекта dis-card-property_", vss-include-info0).
       76   end.
       77   v_bh = buffer buf_dis-card-property_:handle.
       78   v_tbh = buffer buft_dis-card-property_:handle.
       79       assign
       80       d-card = '':U
       81       dtm-code  = 0
       82       dt-code = 0
       83       node-code# = 0
       84       .
       85     end constructor.
       86     CONSTRUCTOR PUBLIC dis-card-property_(
       87                                  input parparentproc as widget-handle
       88                                 ,input p-parent-handle as handle
       89                                 ,input p-log-handle as handle
       90                                 ,input p-gc-handle as handle
       91                                 ,input p-cont-handle as handle
       92                                 ,input p-lock as integer
       93                                 ,input p-wait as integer
       94                                 ,input p-temp as integer
       95                                 ,input p-dtm-code as integer
       96                               ):
       97   define variable glog as logical no-undo .
       98   assign
       99   v_pp = parparentproc
      100   v_lh = p-log-handle
      101   v_ph = p-parent-handle
      102   v_gc = p-gc-handle
      103   v_cnt = p-cont-handle
      104   lock = p-lock
      105   wait = p-wait
      106   temp = p-temp
      107   .
      108   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-card-property_',  input this-object) no-error.
      109   if error-status:error then do:
      110     return error substitute("&1 Ошибка создания объекта dis-card-property_", vss-include-info0).
      111   end.
      112   v_bh = buffer buf_dis-card-property_:handle.
      113   v_tbh = buffer buft_dis-card-property_:handle.
      114       d-card = '':U.
      115       dtm-code = p-dtm-code.
      116       for each buf_prop-map  where buf_prop-map.dtm-code = p-dtm-code
      117       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      118       :
      119         create buft_dis-card-property_.
      120         assign
      121         buft_Dis-card-property_.dtm-code = buf_prop-map.dtm-code
      122         buft_Dis-card-property_.node-code = buf_prop-map.node-code
      123         buft_Dis-card-property_.ordinal = buf_prop-map.ordinal
      124         buft_Dis-card-property_.init-value-character = buf_prop-map.init-value-character
      125         buft_Dis-card-property_.init-value-date      = buf_prop-map.init-value-date
      126         buft_Dis-card-property_.init-value-decimal   = buf_prop-map.init-value-decimal
      127         buft_Dis-card-property_.init-value-integer   = buf_prop-map.init-value-integer
      128         buft_Dis-card-property_.init-value-logical   = buf_prop-map.init-value-logical
      129         .
      130       end.
      131     end constructor.
      132     destructor public dis-card-property_():
      133       define variable glog as logical no-undo .
      134       for each buft_dis-card-property_:
      135         delete buft_dis-card-property_.
      136       end.
      137       find_dis-card-property_ ( input '':U).
      138     end destructor.
      139     method public void dis-card-property_release_ ( ):
      140       define variable glog as logical no-undo .
      141       glog = v_bh:buffer-release() no-error .
      142       clear_().
      143     end method.
      144     method public handle get_dis-card-property_ ( ):
      145       return v_bh.
      146     end method.
      147     method public logical set_dis-card-property_ ( input p-bh as handle):
      148       define variable glog as logical no-undo .
      149       glog = v_bh:buffer-copy ( p-bh).
      150       return glog.
      151     end method.
      152     method public logical find_dis-card-property_date ( p-d-card as character
      153                                         , p-date as date
      154                                         , p-caller-id as character
      155                                             ):
      156       define variable glog as logical no-undo .
      157       define variable v-date-char as character no-undo .
      158       define buffer buf_prop-ref for ub.prop-ref.
      159       assign
      160       v-date-char = string(year(p-date), "9999") + "/" +
      161                     string(month(p-date), "99") + "/" +
      162                     string(day(p-date), "99")
      163        v-date-char = v-date-char + "-" + v-date-char
      164        .
      165        find last buf_prop-ref no-lock where
      166                   buf_prop-ref.dtm-code = dtm-code
      167               and buf_prop-ref.sum-id <= v-date-char
      168               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      169        if error-status:error then do:
      170           undo, return error substitute( "&1. Не найден Период для даты &2 в справочнике итогов&3"
      171                                          , vss-include-info0
      172                                          , string(p-date, "99/99/9999")
      173                                          , chr(10)
      174                                          ).
      175        end.
      176        assign
      177        dt-code = buf_prop-ref.dt-code
      178        sum-id = buf_prop-ref.sum-id
      179        .
      180        glog = find_dis-card-property_ ( p-d-card ) no-error .
      181        if error-status:error then do:
      182          undo, return error return-value .
      183        end.
      184        return yes.
      185      end method.
      186      method public logical dis-card-property_save ( ):
      187      define variable glog as logical no-undo .
      188      define buffer buf_dis-card for ub.dis-card.
      189       if d-card <> '':U then do:
      190         for each buft_dis-card-property_
      191         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      192         :
      193           if v-error-flag then do:
      194             glog = v_bh:buffer-release() no-error .
      195           end.
      196           else do:
      197             if buft_dis-card-property_.h-n-action = integer('2':U)
      198             or buft_dis-card-property_.h-n-action = integer('1':U)
      199             then do:
      200               if temp >= 0 then do:
      201                 if buft_dis-card-property_.recid_ <> ? then do:
      202                   find first buf_dis-card-property_ exclusive-lock where
      203                       recid(buf_Dis-card-property_) = buft_dis-card-property_.recid_.
      204                 end.
      205                 else do:
      206                   glog = v_bh:buffer-create().
      207                 end.
      208                 run disproph_write-dis-card-property-rul in v_gc ( buffer buf_dis-card-property_
      209                                                         ,input type#
      210                                                         ,input emitent-host-code#
      211                                                         ,input 1
      212                                                         ,input buft_dis-card-property_.h-n-action) no-error .
      213                 if error-status:error then do:
      214                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      215                 end.
      216                 glog = v_bh:buffer-copy( v_tbh).
      217                 run disproph_send-dis-card-property-rul in v_gc ( buffer buf_dis-card-property_
      218                                                         ,input type#
      219                                                         ,input emitent-host-code#
      220                                                         ,input 1
      221                                                         ,input buft_dis-card-property_.h-n-action) no-error .
      222                 if error-status:error then do:
      223                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      224                 end.
      225               end.
      226               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      227               glog = v_bh:buffer-release() no-error .
      228               if error-status:error then do:
      229                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      230               end.
      231               if temp < 0 then do:
      232                 run tempcont_create-changes in v_cnt (
      233                                                 input 'dis-card-property':U
      234                                                ,input v_bh
      235                                                ,input v_tbh
      236                                                ,input buft_dis-card-property_.h-n-action) no-error.
      237                 if error-status:error then do:
      238                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      239                 end.
      240               end.
      241             end.
      242           end.
      243         end.
      244         v-error-flag = no.
      245       end.
      246       return yes.
      247     end method.
      248      method public logical find_dis-card-property_ ( p-d-card as character):
      249      define variable glog as logical no-undo .
      250      define buffer buf_dis-card for ub.dis-card.
      251       dis-card-property_release_().
      252       clear_().
      253       if p-d-card <> '':U then do:
      254         find first buf_dis-card no-lock where
      255                   buf_dis-card.d-card = p-d-card no-error.
      256         if not available buf_dis-card then do:
      257            return error substitute("Не найдена ДК &1", p-d-card).
      258         end.
      259         assign
      260         card-num                 = buf_dis-card-property_.card-num
      261         d-card                   = buf_dis-card-property_.d-card
      262         first-card               = buf_dis-card-property_.first-card
      263         first-main-card          = buf_dis-card-property_.first-main-card
      264         main-card                = buf_dis-card-property_.main-card
      265         emitent-host-code#       = buf_dis-card.emitent-host-code
      266         type#                    = buf_dis-card.type
      267         .
      268         define variable v-ii as integer no-undo .
      269         _buft_dis-card-property:
      270         for each buft_dis-card-property_
      271         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      272         :
      273           assign
      274           v-ii = v-ii + 1
      275           buft_dis-card-property_.recid_ = ?
      276           buft_dis-card-property_.d-card = '':U
      277           buft_dis-card-property_.main-card = '':U
      278           buft_dis-card-property_.first-main-card = '':U
      279           buft_dis-card-property_.first-card = '':U
      280           buft_dis-card-property_.card-num = 0
      281           buft_dis-card-property_.h-n-action = 0
      282           buft_dis-card-property_.property-value-character = buft_dis-card-property_.init-value-character
      283           buft_dis-card-property_.property-value-date      = buft_dis-card-property_.init-value-date
      284           buft_dis-card-property_.property-value-decimal = buft_dis-card-property_.init-value-decimal
      285           buft_dis-card-property_.property-value-integer = buft_dis-card-property_.init-value-integer
      286           buft_dis-card-property_.property-value-logical = buft_dis-card-property_.init-value-logical
      287           .
      288           assign
      289           glog =  v_bh:find-first( substitute('where d-card = "&1" and host-code = 0 and and obj-type = "" and obj-code = 0 and dt-code = &2 and node-code = &3'
      290                                   , p-d-card
      291                                   , dt-code
      292                                   , buft_dis-card-property_.node-code
      293                                   )
      294                                   , lock
      295                                   , wait) no-error .
      296           if not glog then do:
      297             if wait = NO-WAIT
      298             and v_bh:locked then do:
      299               return error substitute("Запись свойств ДК &1 занята", p-d-card).
      300             end.
      301             assign
      302             buft_dis-card-property_.h-n-action = integer('1':U).
      303             next _buft_dis-card-property.
      304           end.
      305           glog = v_tbh:buffer-copy( v_bh).
      306           if v-ii = 1 then do:
      307              assign
      308              property-value-character# = buft_dis-card-property_.property-value-character
      309              property-value-date#      = buft_dis-card-property_.property-value-date
      310              property-value-decimal#   = buft_dis-card-property_.property-value-decimal
      311              property-value-integer#   = buft_dis-card-property_.property-value-integer
      312              property-value-logical#   = buft_dis-card-property_.property-value-logical
      313              node-code#                = buft_dis-card-property_.node-code
      314              .
      315           end.
      316         end.
      317         if v-ii = 0 then do:
      318           return no.
      319         end.
      320       end.
      321       return yes.
      322     end method.
      323     method public logical create_dis-card-property_date ( input p-d-card as character
      324                                                ,input p-date as date
      325                                                ,input p-caller-id as character
      326                                             ):
      327       define variable glog as logical no-undo .
      328       define variable v-date-char as character no-undo .
      329       define buffer buf_prop-ref for ub.prop-ref.
      330       assign
      331       v-date-char = string(year(p-date), "9999") + "/" +
      332                     string(month(p-date), "99") + "/" +
      333                     string(day(p-date), "99")
      334        v-date-char = v-date-char + "-" + v-date-char
      335        .
      336        find last buf_prop-ref no-lock where
      337                   buf_prop-ref.dtm-code = dtm-code
      338               and buf_prop-ref.sum-id <= v-date-char
      339               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      340        if error-status:error then do:
      341           undo, return error substitute( "&1. Не найден Период для даты &2 в справочнике итогов&3"
      342                                          , vss-include-info0
      343                                          , string(p-date, "99/99/9999")
      344                                          , chr(10)
      345                                          ).
      346        end.
      347        dt-code = buf_prop-ref.dt-code.
      348        glog = create_dis-card-property_ ( p-d-card ) no-error .
      349        if error-status:error then do:
      350          undo, return error return-value .
      351        end.
      352     end.
      353     method public logical create_dis-card-property_ ( input p-d-card as character ):
      354       define buffer buft2_ for t-dis-card-property_.
      355       for each buft2_ :
      356         if buft2_.recid_ = ?
      357         and buft2_.init-value-character <> '':U
      358         then do:
      359           assign
      360           buft2_.h-n-action     = integer('1':U)
      361           .
      362         end.
      363         if buft2_.recid_ = ?
      364         and buft2_.init-value-date <> ?
      365         then do:
      366           assign
      367           buft2_.h-n-action     = integer('1':U)
      368           .
      369         end.
      370         if buft2_.recid_ = ?
      371         and buft2_.init-value-decimal <> 0.0
      372         then do:
      373           assign
      374           buft2_.h-n-action     = integer('1':U)
      375           .
      376         end.
      377         if buft2_.recid_ = ?
      378         and buft2_.init-value-integer <> 0
      379         then do:
      380           assign
      381           buft2_.h-n-action     = integer('1':U)
      382           .
      383         end.
      384         if buft2_.recid_ = ?
      385         and buft2_.init-value-logical <> no
      386         then do:
      387           assign
      388           buft2_.h-n-action     = integer('1':U)
      389           .
      390         end.
      391       end.
      392       return yes.
      393     end method.
      394     method protected void clear_():
      395       define variable glog as logical no-undo .
      396       v-error-flag = no.
      397       assign
      398       d-card = ''
      399       .
      400     end method.
      401     method public override character ToString( ):
      402       return substitute("ДК &1 объект-операнд &2, срез &2, свойство &4"
      403                         , d-card
      404                         , dtm-code
      405                         , dt-code
      406                         , node-code#).
      407     end method.
      408     method public character get-property-value-character ( input p-node-code as integer):
      409        if p-node-code <> node-code# then do:
      410          find first buft_dis-card-property_ where
      411                    buft_dis-card-property_.dt-code = dt-code
      412                and buft_dis-card-property_.node-code = p-node-code.
      413          assign
      414          property-value-character# = buft_dis-card-property_.property-value-character
      415          node-code# = buft_dis-card-property_.node-code
      416          .
      417        end.
      418        return property-value-character#.
      419     end method.
      420     method public void set-property-value-character  ( input p-character as character, input p-node-code as integer):
      421       if p-node-code <> node-code# then do:
      422          find first buft_dis-card-property_ where
      423                    buft_dis-card-property_.dt-code = dt-code
      424                and buft_dis-card-property_.node-code = p-node-code.
      425          assign
      426          node-code# = p-node-code.
      427       end.
      428       assign
      429       buft_dis-card-property_.property-value-character = p-character
      430       property-value-character# = p-character
      431       buft_dis-card-property_.h-n-action = (if buft_dis-card-property_.recid_ = ?
      432                                             then integer('1':U)
      433                                             else buft_dis-card-property_.h-n-action)
      434       .
      435     end method.
      436     method public date get-property-value-date ( input p-node-code as integer):
      437        if p-node-code <> node-code# then do:
      438          find first buft_dis-card-property_ where
      439                    buft_dis-card-property_.dt-code = dt-code
      440                and buft_dis-card-property_.node-code = p-node-code.
      441          assign
      442          property-value-date# = buft_dis-card-property_.property-value-date
      443          node-code# = buft_dis-card-property_.node-code
      444          .
      445        end.
      446        return property-value-date#.
      447     end method.
      448     method public void set-property-value-date  ( input p-date as date, input p-node-code as integer):
      449       if p-node-code <> node-code# then do:
      450          find first buft_dis-card-property_ where
      451                    buft_dis-card-property_.dt-code = dt-code
      452                and buft_dis-card-property_.node-code = p-node-code.
      453          assign
      454          node-code# = p-node-code.
      455       end.
      456       assign
      457       buft_dis-card-property_.property-value-date = p-date
      458       property-value-date# = p-date
      459       buft_dis-card-property_.h-n-action = (if buft_dis-card-property_.recid_ = ?
      460                                             then integer('1':U)
      461                                             else buft_dis-card-property_.h-n-action)
      462       .
      463     end method.
      464     method public decimal get-property-value-decimal ( input p-node-code as integer):
      465        if p-node-code <> node-code# then do:
      466          find first buft_dis-card-property_ where
