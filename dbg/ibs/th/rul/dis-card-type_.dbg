       55     CONSTRUCTOR PUBLIC dis-card-type_(
       56                                  input parparentproc as widget-handle
       57                                 ,input p-parent-handle as handle
       58                                 ,input p-log-handle as handle
       59                                 ,input p-gc-handle as handle
       60                                 ,input p-cont-handle as handle
       61                                 ,input p-lock as integer
       62                                 ,input p-wait as integer
       63                                 ,input p-temp as integer
       64                               ):
       65   define variable glog as logical no-undo .
       66   assign
       67   v_pp = parparentproc
       68   v_lh = p-log-handle
       69   v_ph = p-parent-handle
       70   v_gc = p-gc-handle
       71   v_cnt = p-cont-handle
       72   lock = p-lock
       73   wait = p-wait
       74   temp = p-temp
       75   .
       76   run garbcoll_create-gc-entry in p-gc-handle (input 'dis-card-type_',  input this-object) no-error.
       77   if error-status:error then do:
       78     return error substitute("&1 Ошибка создания объекта dis-card-type_", vss-include-info0).
       79   end.
       80   v_bh = buffer buf_dis-card-type_:handle.
       81   v_tbh = buffer buft_dis-card-type_:handle.
       82       emitent-host-code = 0.
       83       type = '':U .
       84     end constructor.
       85     destructor public dis-card-type_():
       86       define variable glog as logical no-undo .
       87       assign
       88       glog = v_tbh:empty-temp-table() no-error .
       89       find_dis-card-type_ ( input 0, input '':U).
       90     end destructor.
       91     method public void dis-card-type_release_ ( input p-error-flag as logical ):
       92     define variable glog as logical no-undo .
       93       v-error-flag = p-error-flag.
       94       release-flag = yes.
       95       glog = find_dis-card-type_ ( input 0, input '':U) no-error .
       96       if error-status:error
       97       or not glog then do:
       98         return error return-value .
       99       end.
      100     end method.
      101     method public void Dis-card-type_release_ ( ):
      102       define variable glog as logical no-undo .
      103       glog = v_bh:buffer-release() no-error .
      104       clear_().
      105     end method.
      106     method public handle get_dis-card-type_ ( ):
      107       return v_bh.
      108     end method.
      109     method public logical find_dis-card-type_no-error ( p-emitent-host-code as integer, p-type as character):
      110       define variable glog as logical no-undo .
      111       assign
      112       find_no-error = yes.
      113       glog = find_dis-card-type_ ( input p-emitent-host-code, input p-type) no-error .
      114       if error-status:error then do:
      115         return error .
      116       end.
      117       return glog.
      118     end method.
      119     method public logical find_dis-card-type_ ( p-emitent-host-code as integer, p-type as character):
      120      define variable glog as logical no-undo .
      121       dis-card-type_release_().
      122       clear_().
      123       if p-type <> '':U then do:
      124         assign
      125         glog =  v_bh:find-first( substitute('where emitent-host-code = &1 and type = "&2"', p-emitent-host-code, p-type), lock, wait) no-error .
      126         if not glog then do:
      127           if lock = No-LOCK then do:
      128             if v_tbh:available then
      129             assign glog = v_tbh:buffer-delete() no-error .
      130             if find_no-error then do:
      131               return no.
      132             end.
      133             else do:
      134               return error substitute("Не найден тип ДК: эмитент &1 тип &2", p-emitent-host-code, p-type).
      135             end.
      136           end.
      137           if wait = NO-WAIT
      138           and v_bh:locked then do:
      139             if v_tbh:available then
      140             assign glog = v_tbh:buffer-delete() no-error .
      141             if find_no-error then do:
      142               return no.
      143             end.
      144             else do:
      145               return error substitute("тип ДК занят: эмитент &1 тип &2", p-emitent-host-code, p-type).
      146             end.
      147           end.
      148         end.
      149         assign
      150         emitent-host-code    = buf_dis-card-type_.emitent-host-code
      151         type                 = buf_dis-card-type_.type
      152         cardname-sent        = buf_dis-card-type_.cardname-sent
      153         card-media           = buf_dis-card-type_.card-media
      154         check-by-mask        = buf_dis-card-type_.check-by-mask
      155         dc-pfx               = buf_dis-card-type_.dc-pfx
      156         d-pcnt-byshop        = buf_dis-card-type_.d-pcnt-byshop
      157         dcbyshop             = buf_dis-card-type_.dcbyshop
      158         dflt-credit-card     = buf_dis-card-type_.dflt-credit-card
      159         dflt-d-pcnt-method   = buf_dis-card-type_.dflt-d-pcnt-method
      160         dflt-debet-card      = buf_dis-card-type_.dflt-debet-card
      161         fiscal-pay           = buf_dis-card-type_.fiscal-pay
      162         ho-join              = buf_dis-card-type_.ho-join
      163         lim-kr               = buf_dis-card-type_.lim-kr
      164         mixed-pay            = buf_dis-card-type_.mixed-pay
      165         pay-code             = buf_dis-card-type_.pay-code
      166         dflt-staff-card      = buf_dis-card-type_.dflt-staff-card
      167         .
