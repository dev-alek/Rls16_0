        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.next-discount_:
        3       define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: next-discount_.cls $ $Revision: aea5316774be, 0, rls $".
        4     define protected variable v_pp as widget-handle no-undo.
        5     define protected variable v_ph as handle no-undo.
        6     define protected variable v_lh as widget-handle no-undo.
        7     define protected variable v_gc as handle no-undo.
        8     define protected variable v_cnt as widget-handle no-undo.
        9     define protected buffer buf_next-discount_ for ub.dis-card-property.
       10     define protected temp-table t-next-discount_ no-undo like ub.dis-card-property
       11     field recid_ as recid
       12     field h-n-action as integer
       13     field ordinal as integer
       14     field init-value-character as character
       15     field init-value-date as date
       16     field init-value-decimal as decimal
       17     field init-value-integer as integer
       18     field init-value-logical as logical
       19     field node-name as character
       20    .
       21     define protected buffer buft_next-discount_ for t-next-discount_.
       22     define public variable v_bh as handle no-undo.
       23     define protected variable v_tbh as handle no-undo.
       24     define public variable temp as integer no-undo.
       25     define public property lock as integer
       26     get.
       27     set.
       28     define public property wait as integer
       29     get.
       30     set.
       31     define private buffer buf_prop-map for ub.prop-map.
       32     define protected variable dtm-code as integer no-undo .
       33     define protected variable node-code# as integer no-undo .
       34     define protected variable dt-code as integer no-undo .
       35     define protected variable caller_id as character no-undo .
       36     define protected variable sum-id as character no-undo .
       37     define protected variable num-members as integer no-undo .
       38     define private variable v-error-flag as logical no-undo.
       39     define public variable card-num as integer no-undo .
       40     define public variable d-card as character no-undo .
       41     define public variable first-card as character no-undo .
       42     define public variable first-main-card as character no-undo .
       43     define public variable main-card as character no-undo .
       44     define public variable type# as character no-undo .
       45     define public variable emitent-host-code# as integer no-undo .
       46     define public variable host-code as integer no-undo .
       47     define public variable obj-type as character no-undo .
       48     define public variable obj-code as integer no-undo .
       49     define public variable d-pcnt as decimal no-undo .
       50     define public variable cash-d-pcnt as decimal no-undo .
       51     define public variable category as integer no-undo .
       52     CONSTRUCTOR PUBLIC next-discount_(
       53                                  input parparentproc as widget-handle
       54                                 ,input p-parent-handle as handle
       55                                 ,input p-log-handle as handle
       56                                 ,input p-gc-handle as handle
       57                                 ,input p-cont-handle as handle
       58                                 ,input p-lock as integer
       59                                 ,input p-wait as integer
       60                                 ,input p-temp as integer
       61                                 ,input p-dtm-code as integer
       62                               ):
       63   define variable glog as logical no-undo .
       64   assign
       65   v_pp = parparentproc
       66   v_lh = p-log-handle
       67   v_ph = p-parent-handle
       68   v_gc = p-gc-handle
       69   v_cnt = p-cont-handle
       70   lock = p-lock
       71   wait = p-wait
       72   temp = p-temp
       73   .
       74   run garbcoll_create-gc-entry in p-gc-handle (input 'next-discount_',  input this-object) no-error.
       75   if error-status:error then do:
       76     return error substitute("&1 Ошибка создания объекта next-discount_", vss-include-info0).
       77   end.
       78   v_bh = buffer buf_next-discount_:handle.
       79   v_tbh = buffer buft_next-discount_:handle.
       80       assign
       81       d-card = '':U
       82       dtm-code = p-dtm-code
       83       dt-code = 0
       84       node-code# = 0
       85       caller_id = '':U
       86       .
       87       for each buf_prop-map  where buf_prop-map.dtm-code = p-dtm-code
       88       on error  undo , return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
       89       :
       90         create buft_next-discount_.
       91         assign
       92         buft_next-discount_.dtm-code = buf_prop-map.dtm-code
       93         buft_next-discount_.node-code = buf_prop-map.node-code
       94         buft_next-discount_.node-name = buf_prop-map.node-name
       95         buft_next-discount_.ordinal = buf_prop-map.ordinal
       96         buft_next-discount_.init-value-character = buf_prop-map.init-value-character
       97         buft_next-discount_.init-value-date      = buf_prop-map.init-value-date
       98         buft_next-discount_.init-value-decimal   = buf_prop-map.init-value-decimal
       99         buft_next-discount_.init-value-integer   = buf_prop-map.init-value-integer
      100         buft_next-discount_.init-value-logical   = buf_prop-map.init-value-logical
      101         num-members = num-members + 1
      102         .
      103       end.
      104     end constructor.
      105     destructor public next-discount_():
      106       define variable glog as logical no-undo .
      107       for each buft_next-discount_:
      108         delete buft_next-discount_.
      109       end.
      110       find_next-discount_ ( input '':U).
      111     end destructor.
      112     method public void next-discount_release_ ( ):
      113       define variable glog as logical no-undo .
      114       glog = v_bh:buffer-release() no-error .
      115       clear_().
      116     end method.
      117     method public handle get_next-discount_ ( ):
      118       return v_bh.
      119     end method.
      120     method public logical set_next-discount_ ( input p-bh as handle):
      121       define variable glog as logical no-undo .
      122       glog = v_bh:buffer-copy ( p-bh).
      123       return glog.
      124     end method.
      125     method public logical find_next-discount_sum-id ( p-d-card as character
      126                                         , p-sum-id as character
      127                                         , p-caller-id as character
      128                                             ):
      129       define variable glog as logical no-undo .
      130       define variable v-date-char as character no-undo .
      131       define buffer buf_prop-ref for ub.prop-ref.
      132       find first buf_prop-ref no-lock where
      133                   buf_prop-ref.dtm-code = dtm-code
      134               and buf_prop-ref.sum-id = p-sum-id
      135               and buf_prop-ref.caller_id = p-caller-id no-error .
      136        if error-status:error then do:
      137           undo, return error substitute( "&1. Не найден Период &2 (доп.иден-р &3) в справочнике итогов&4"
      138                                          , vss-include-info0
      139                                          , p-sum-id
      140                                          , p-caller-id
      141                                          , chr(10)
      142                                          ).
      143        end.
      144        assign
      145        dt-code = buf_prop-ref.dt-code
      146        sum-id = buf_prop-ref.sum-id
      147        caller_id = buf_prop-ref.caller_id
      148        .
      149        glog = find_next-discount_ ( p-d-card ) no-error .
      150        if error-status:error then do:
      151          undo, return error return-value .
      152        end.
      153        return glog.
      154      end method.
      155     method public logical find_next-discount_date ( p-d-card as character
      156                                         , p-date as date
      157                                         , p-caller-id as character
      158                                             ):
      159       define variable glog as logical no-undo .
      160       define variable v-date-char as character no-undo .
      161       define buffer buf_prop-ref for ub.prop-ref.
      162       assign
      163       v-date-char = string(year(p-date), "9999") + "/" +
      164                     string(month(p-date), "99") + "/" +
      165                     string(day(p-date), "99")
      166        v-date-char = v-date-char + "-" + v-date-char
      167        .
      168        find last buf_prop-ref no-lock where
      169                   buf_prop-ref.dtm-code = dtm-code
      170               and buf_prop-ref.sum-id <= v-date-char
      171               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      172        if error-status:error then do:
      173           undo, return error substitute( "&1. Не найден Период для даты &2 (доп.иден-р &3) в справочнике итогов&4"
      174                                          , vss-include-info0
      175                                          , string(p-date, "99/99/9999")
      176                                          , p-caller-id
      177                                          , chr(10)
      178                                          ).
      179        end.
      180        assign
      181        dt-code = buf_prop-ref.dt-code
      182        sum-id = buf_prop-ref.sum-id
      183        caller_id = buf_prop-ref.caller_id
      184        .
      185        glog = find_next-discount_ ( p-d-card ) no-error .
      186        if error-status:error then do:
      187          undo, return error return-value .
      188        end.
      189        return glog.
      190      end method.
      191      method public logical next-discount_save ( ):
      192      define variable glog as logical no-undo .
      193      define variable v-tosave as logical no-undo .
      194      define buffer buf_dis-card for ub.dis-card.
      195       if d-card <> '':U then do:
      196           _save:
      197           for each buft_next-discount_
      198           on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      199           :
      200             v-tosave = no.
      201             if buft_next-discount_.node-name = "d-pcnt"
      202             then do:
      203               if buft_next-discount_.init-value-decimal = d-pcnt then next _save.
      204               assign
      205               buft_next-discount_.property-value-decimal = d-pcnt
      206               .
      207             end.
      208             if buft_next-discount_.node-name = "cash-d-pcnt" then do:
      209               if buft_next-discount_.init-value-decimal = cash-d-pcnt then next _save.
      210               assign
      211               buft_next-discount_.property-value-decimal = cash-d-pcnt
      212               .
      213             end.
      214             if buft_next-discount_.node-name = "category" then do:
      215               if buft_next-discount_.init-value-integer = category then next _save.
      216               assign
      217               buft_next-discount_.property-value-integer = category
      218               .
      219             end.
      220             if buft_next-discount_.h-n-action = integer('2':U)
      221             or buft_next-discount_.h-n-action = integer('1':U)
      222             then do:
      223               if temp >= 0 then do:
      224                 if buft_next-discount_.recid_ <> ? then do:
      225                   find first buf_next-discount_ exclusive-lock where
      226                       recid(buf_next-discount_) = buft_next-discount_.recid_.
      227                   v-tosave = not (v_bh:buffer-compare(v_tbh)).
      228                 end.
      229                 else do:
      230                   glog = v_bh:buffer-create().
      231                   glog = v_bh:buffer-copy( v_tbh, "property-value-character,property-value-date,property-value-decimal,property-value-integer,property-value-logical").
      232                   v-tosave = yes.
      233                 end.
      234                 if v-tosave then do:
      235                 run disproph_write-dis-card-property-rul in v_gc ( buffer buf_next-discount_
      236                                                         ,input type#
      237                                                         ,input emitent-host-code#
      238                                                         ,input 7
      239                                                         ,input buft_next-discount_.h-n-action) no-error .
      240                 if error-status:error then do:
      241                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      242                 end.
      243                 glog = v_bh:buffer-copy( v_tbh).
      244                 run disproph_send-dis-card-property-rul in v_gc ( buffer buf_next-discount_
      245                                                         ,input type#
      246                                                         ,input emitent-host-code#
      247                                                         ,input 7
      248                                                         ,input buft_next-discount_.h-n-action) no-error .
      249                 if error-status:error then do:
      250                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      251                 end.
      252                 end.
      253               end.
      254               v_bh:buffer-field("trg-param"):buffer-value = 'no-callnews':U + chr(44) + 'no-hist':U.
      255               glog = v_bh:buffer-release() no-error .
      256               if error-status:error then do:
      257                 undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      258               end.
      259               if temp < 0 then do:
      260                 run tempcont_create-changes in v_cnt (
      261                                                 input 'dis-card-property':U
      262                                                ,input v_bh
      263                                                ,input v_tbh
      264                                                ,input buft_next-discount_.h-n-action) no-error.
      265                 if error-status:error then do:
      266                   undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      267                 end.
      268               end.
      269             end.
      270           end.
      271       end.
      272       return yes.
      273     end method.
      274      method public logical find_next-discount_ ( p-d-card as character):
      275      define variable glog as logical no-undo .
      276      define variable v-jj as integer no-undo .
      277      define buffer buf_dis-card for ub.dis-card.
      278       next-discount_release_().
      279       clear_().
      280       if p-d-card <> '':U then do:
      281         find first buf_dis-card no-lock where
      282                   buf_dis-card.d-card = p-d-card no-error.
      283         if not available buf_dis-card then do:
      284            return error substitute("Не найдена ДК &1", p-d-card).
      285         end.
      286         assign
      287         card-num                 = buf_dis-card.card-num
      288         d-card                   = buf_dis-card.d-card
      289         first-card               = buf_dis-card.first-card
      290         first-main-card          = buf_dis-card.first-main-card
      291         main-card                = buf_dis-card.main-card
      292         emitent-host-code#       = buf_dis-card.emitent-host-code
      293         type#                    = buf_dis-card.type
      294         .
      295         define variable v-ii as integer no-undo .
      296         _buft_dis-card-property:
      297         for each buft_next-discount_
      298         by buft_next-discount_.dt-code
      299         by buft_next-discount_.node-code
      300         on error undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1))
      301         :
      302           assign
      303           buft_next-discount_.card-num                 = buf_dis-card.card-num
      304           buft_next-discount_.d-card                   = buf_dis-card.d-card
      305           buft_next-discount_.first-card               = buf_dis-card.first-card
      306           buft_next-discount_.first-main-card          = buf_dis-card.first-main-card
      307           buft_next-discount_.main-card                = buf_dis-card.main-card
      308           buft_next-discount_.recid_ = ?
      309           buft_next-discount_.h-n-action = 0
      310           buft_next-discount_.property-value-decimal = buft_next-discount_.init-value-decimal
      311           buft_next-discount_.property-value-integer = buft_next-discount_.init-value-integer
      312           buft_next-discount_.dt-code                 = dt-code
      313           buft_next-discount_.sum-id                  = sum-id
      314           v-jj = v-jj + 1
      315           .
      316           define variable v-where as character no-undo .
      317           v-where =  substitute('where d-card = "&1" and host-code = 0 and obj-type = "" and obj-code = 0 and dt-code = &2 and node-code = &3'
      318                                   , p-d-card
      319                                   , dt-code
      320                                   , buft_next-discount_.node-code
      321                                   ).
      322           assign
      323           glog =  v_bh:find-first( v-where
      324                                   , lock
      325                                   , wait) no-error .
      326           if not glog then do:
      327             if wait = NO-WAIT
      328             and v_bh:locked then do:
      329               return error substitute("Запись свойств ДК &1 занята", p-d-card).
      330             end.
      331             assign
      332             buft_next-discount_.h-n-action = integer('1':U).
      333             if v-jj = num-members then leave _buft_dis-card-property.
      334             next _buft_dis-card-property.
      335           end.
      336           else do:
      337             assign
      338             buft_next-discount_.h-n-action = integer('2':U)
      339             .
      340           end.
      341           assign
      342           v-ii = v-ii + 1
      343           buft_next-discount_.recid_ = recid(buf_next-discount_)
      344           .
      345           glog = v_tbh:buffer-copy( v_bh).
      346           if buft_next-discount_.node-name = "d-pcnt" then do:
      347              assign
      348              d-pcnt = buft_next-discount_.property-value-decimal
      349              node-code#                = buft_next-discount_.node-code
      350              .
      351           end.
      352           if buft_next-discount_.node-name = "cash-d-pcnt" then do:
      353              assign
      354              cash-d-pcnt = buft_next-discount_.property-value-decimal
      355              node-code#                = buft_next-discount_.node-code
      356              .
      357           end.
      358           if buft_next-discount_.node-name = "category" then do:
      359              assign
      360              category = buft_next-discount_.property-value-integer
      361              node-code#                = buft_next-discount_.node-code
      362              .
      363           end.
      364           if v-jj = num-members then leave _buft_dis-card-property.
      365         end.
      366         if v-ii = 0 then do:
      367           return no.
      368         end.
      369       end.
      370       return yes.
      371     end method.
      372     method public logical create_next-discount_date ( input p-d-card as character
      373                                                ,input p-date as date
      374                                                ,input p-caller-id as character
      375                                             ):
      376       define variable glog as logical no-undo .
      377       define variable v-date-char as character no-undo .
      378       define buffer buf_prop-ref for ub.prop-ref.
      379       assign
      380       v-date-char = string(year(p-date), "9999") + "/" +
      381                     string(month(p-date), "99") + "/" +
      382                     string(day(p-date), "99")
      383        v-date-char = v-date-char + "-" + v-date-char
      384        .
      385        find last buf_prop-ref no-lock where
      386                   buf_prop-ref.dtm-code = dtm-code
      387               and buf_prop-ref.sum-id <= v-date-char
      388               and buf_prop-ref.caller_id = p-caller-id use-index idtsum no-error .
      389        if error-status:error then do:
      390           undo, return error substitute( "&1. Не найден Период для даты &2 (доп.иден-р &3) в справочнике итогов&4"
      391                                          , vss-include-info0
      392                                          , string(p-date, "99/99/9999")
      393                                          , p-caller-id
      394                                          , chr(10)
      395                                          ).
      396        end.
      397        dt-code = buf_prop-ref.dt-code.
      398        caller_id = buf_prop-ref.caller_id.
      399        glog = create_next-discount_ ( p-d-card ) no-error .
      400        if error-status:error then do:
      401          undo, return error return-value .
      402        end.
      403     end.
      404     method public logical create_next-discount_ ( input p-d-card as character ):
      405       define buffer buft2_ for t-next-discount_.
      406       for each buft2_ :
      407         if buft2_.recid_ = ?
      408         and buft2_.init-value-decimal <> 0.0
      409         then do:
      410           assign
      411           buft2_.h-n-action     = integer('1':U)
      412           .
      413         end.
      414         if buft2_.recid_ = ?
      415         and buft2_.init-value-integer <> 0
      416         then do:
      417           assign
      418           buft2_.h-n-action     = integer('1':U)
      419           .
      420         end.
      421         assign
      422         buft2_.dt-code = dt-code
      423         buft2_.sum-id = sum-id
      424         .
      425       end.
      426       return yes.
      427     end method.
      428     method protected void clear_():
      429       define variable glog as logical no-undo .
      430       v-error-flag = no.
      431       assign
      432       d-card = ''
      433       .
      434       for each buft_next-discount_:
      435         assign
      436         buft_next-discount_.card-num                 = 0
      437         buft_next-discount_.d-card                   = '':U
      438         buft_next-discount_.first-card               = '':U
      439         buft_next-discount_.first-main-card          = '':U
      440         buft_next-discount_.main-card                = '':U
      441         buft_next-discount_.recid_ = ?
      442         buft_next-discount_.h-n-action = 0
      443         buft_next-discount_.property-value-decimal = buft_next-discount_.init-value-decimal
      444         buft_next-discount_.property-value-integer = buft_next-discount_.init-value-integer
      445         buft_next-discount_.dt-code                 = 0
      446         buft_next-discount_.sum-id                  = '':U
      447         .
      448       end.
      449     end method.
      450     method public override character ToString( ):
      451       return substitute("ДК &1 объект-операнд &2, срез &2, свойство &4"
      452                         , d-card
      453                         , dtm-code
      454                         , dt-code
      455                         , node-code#).
      456     end method.
      457   end class.
