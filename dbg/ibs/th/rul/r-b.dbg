        1   block-level on error undo, throw.
        2   class Ibs.Th.Rul.R-b:
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: r-b.cls $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: ibs/th/rul/r-b.cls $":U .
        8   define variable vss-description as character no-undo init "Класс r-b".
        9     define public property R-b as character no-undo
       10     get.
       11     set( input p-R-b as character ):
       12       if p-R-b <> 'rubl':U
       13       and p-R-b <> 'base':U then do:
       14         return error substitute("Неверное значение R-b &1", p-R-b).
       15       end.
       16       assign
       17       R-b = p-R-b.
       18     end set.
       19     CONSTRUCTOR PUBLIC R-b(  input g#language as character  ):
       20       if g#language <> "rus" then do:
       21         message
       22         vss-workfile vss-revision vss-description skip
       23         'incorrect language':U skip
       24         'str-glbl:':U 'rus':U skip
       25         'db:':U g#language skip
       26         view-as alert-box error.
       27         undo, return error .
       28       end.
       29       assign
       30       R-b = 'rubl':U.
       31     END CONSTRUCTOR.
       32     method public override character ToString ():
       33        return R-b.
       34     end method.
       35     method public character select-value ( input p-title as character):
       36       define variable v-ok as logical no-undo.
       37       define variable v-r-b as character no-undo .
       38       run ref/s-R-b.w ( input p-title
       39                        ,input-output v-R-b
       40                        ,output v-ok) no-error.
       41       if v-ok = yes then do:
       42         R-b = v-R-b.
       43       end.
       44     end method.
       45   end class.
