        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.file.asyncproc:
        4   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        5   method private logical cur-time (output p-today as date,
        6                                    output p-time  as integer ):
        7     do
        8     on error undo, return error
        9     :
       10       define variable v-date1 as date      no-undo .
       11       define variable v-date2 as date      no-undo .
       12       define variable v-time  as integer   no-undo .
       13       assign
       14         v-date1 = today
       15         v-time  = time
       16         v-date2 = today
       17       .
       18       if v-date1 <> v-date2
       19       then do:
       20         assign
       21           v-date1 = today
       22           v-time  = v-time
       23         .
       24       end.
       25       assign
       26         p-today = v-date1
       27         p-time  = v-time
       28       .
       29     end.
       30   end.
       31   method private character  cur-time-date ()
       32   :
       33     return string(today, '99/99/9999':U) .
       34   end.
       35   method private decimal cur-time-mjd ()
       36   :
       37     define variable v-date as date      no-undo .
       38     define variable v-time as integer   no-undo .
       39     cur-time
       40       (output v-date
       41       ,output v-time
       42       ) .
       43     return integer(v-date) - 2400002 + (v-time / 86400) .
       44   end.
       45   method private integer cur-time-get-ending-index
       46   (input p-number as integer
       47   )
       48   :
       49     if p-number < 0
       50     or p-number = ?
       51     then do:
       52       return 1 .
       53     end.
       54     define variable v-rest as integer   no-undo .
       55     assign
       56       p-number = p-number modulo 100
       57     .
       58     if p-number < 20
       59     then do:
       60       assign
       61         v-rest = p-number
       62       .
       63     end.
       64     else do:
       65       assign
       66         v-rest = p-number modulo 10
       67       .
       68     end.
       69     case v-rest :
       70       when 1
       71       then do:
       72         return 2 .
       73       end.
       74       when 2 or
       75       when 3 or
       76       when 4
       77       then do:
       78         return 3 .
       79       end.
       80       otherwise do:
       81         return 1 .
       82       end.
       83     end case .
       84   end.
       85   method private character cur-time-mjd-to-date(
       86     input  i-mjd-diff as decimal
       87   ,output  o-Date     as date
       88   ,output  o-Time     as integer):
       89      define variable v-day-number as integer   no-undo .
       90      if    i-mjd-diff < 0
       91         or i-mjd-diff = ?
       92      then do:
       93         return "?" .
       94      end.
       95      assign
       96         v-day-number = truncate(i-mjd-diff,0).
       97         o-Date = date(v-day-number + 2400002).
       98         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
       99     .
      100   end.
      101   method private character cur-time-mjd-to-string
      102   (input p-mjd-diff as decimal
      103   )
      104   :
      105     define variable v-day-number as integer   no-undo .
      106     define variable v-seconds    as integer   no-undo .
      107     define variable v-hour       as integer   no-undo .
      108     define variable v-min        as integer   no-undo .
      109     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      110     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      111     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      112     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      113     if p-mjd-diff < 0
      114     or p-mjd-diff = ?
      115     then do:
      116       return "?" .
      117     end.
      118     assign
      119       v-day-number = integer(truncate(p-mjd-diff,0))
      120       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      121     .
      122     if v-seconds > 86400
      123     then do:
      124       assign
      125         v-seconds = 86400 - 1
      126       .
      127     end.
      128     if v-seconds < 0
      129     then do:
      130       assign
      131         v-seconds = 0
      132       .
      133     end.
      134     assign
      135       v-hour = truncate(v-seconds / 3600, 0)
      136     .
      137     assign
      138       v-seconds = v-seconds modulo 3600
      139     .
      140     assign
      141       v-min = truncate(v-seconds / 60, 0)
      142     .
      143     assign
      144       v-seconds = v-seconds modulo 60
      145     .
      146     return
      147         (if v-day-number <> 0
      148           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      149           else ""
      150         )
      151       + (if v-day-number <> 0 or v-hour <> 0
      152           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      153           else ""
      154         )
      155       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      156           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      157           else ""
      158         )
      159       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      160       .
      161   end.
      162   method private character cur-time-string ()
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     cur-time
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      171   end.
      172   method private character cur-time-string-sec ()
      173   :
      174     define variable v-date as date      no-undo .
      175     define variable v-time as integer   no-undo .
      176     cur-time
      177       (output v-date
      178       ,output v-time
      179       ) .
      180     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      181   end.
      182   method private character cur-time-custom
      183   (input p-prefix as character
      184   ,input p-date-format as character
      185   ,input p-delimiter as character
      186   ,input p-time-format as character
      187   ,input p-suffix as character
      188   )
      189   :
      190     define variable v-date as date      no-undo .
      191     define variable v-time as integer   no-undo .
      192     cur-time
      193       (output v-date
      194       ,output v-time
      195       ) .
      196     return
      197       p-prefix
      198       + string(v-date, p-date-format)
      199       + p-delimiter
      200       + string(v-time, p-time-format)
      201       + p-suffix
      202       .
      203   end.
      204   method private character cur-time-print ()
      205   :
      206     define variable v-date as date      no-undo .
      207     define variable v-time as integer   no-undo .
      208     cur-time
      209       (output v-date
      210       ,output v-time
      211       ) .
      212     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      213   end.
      214   method private datetime cur-time-datetime ()
      215   :
      216     define variable v-char as character no-undo .
      217     define variable v-datetime as datetime no-undo .
      218     v-char = cur-time-string().
      219     v-datetime = datetime(v-char).
      220     return  v-datetime.
      221   end.
      222   method private character cur-time-string-msec ()
      223   :
      224     define variable v-date as datetime  no-undo .
      225     v-date = now.
      226     return string(v-date) .
      227   end.
      228      define temp-table tt-Param no-undo
      229          field nameParam as character
      230          field objParam  as Progress.Lang.Object
      231      index nameParam nameParam.
      232      define variable mWriteLogTime  as datetime-tz no-undo.
      233      define variable mWriteLogNum   as integer     no-undo.
      234      define variable mWriteLogMes   as logical     no-undo.
      235      define public variable WritelogInter as decimal no-undo init 0.
      236      define public variable mProcPublish as handle     no-undo.
      237      define public variable ErrorProc    as logical    no-undo.
      238      method public logical CheckStop ():
      239         NextLog().
      240         return not FileExists("stop.txt").
      241      end.
      242      method public logical NextLog():
      243         nextLog(no).
      244      end.
      245      define stream sLogMes.
      246      define stream sWriteFile.
      247      define variable vWritelog as logical no-undo.
      248      method public logical BegRec():
      249         output stream sLogMes to "meslogasync.log".
      250         vWritelog = yes.
      251      end.
      252      method public logical EndRec():
      253         vWritelog = no.
      254         output stream sLogMes close.
      255         mWriteLogNum = mWriteLogNum + 1.
      256         os-delete             value ("meslogasync.log" + string(mWriteLogNum)).
      257         define variable vfile as character no-undo.
      258         vfile = search ("meslogasync.log").
      259         os-rename value(vfile) value ("meslogasync.log" + string(mWriteLogNum)).
      260         if     ErrorProc
      261            and log-manager:logfile-name ne ?
      262         then do:
      263         mWriteLogNum = mWriteLogNum + 1.
      264         os-delete             value ("meslogasync.log" + string(mWriteLogNum)).
      265         vfile = search (log-manager:logfile-name).
      266         os-command value (substitute ("copy &1 meslogasync.log&2 > copy.log &3 Exit",vFile,string(mWriteLogNum),chr(38)) ).
      267         end.
      268      end.
      269      method public logical NextLog(iFlagInter as logical):
      270         define variable vend    as datetime-tz no-undo.
      271         define variable vint as int64 no-undo.
      272         if     mWriteLogMes
      273            and (WritelogInter > 0 or iFlagInter)
      274         then do:
      275            vend   = getnow().
      276            vint = vend - mWriteLogTime.
      277            vint = WritelogInter - vint / 1000.
      278            if     vint < 0
      279                or iFlagInter
      280            then do:
      281               output stream sLogMes close.
      282               mWriteLogNum = mWriteLogNum + 1.
      283               os-delete             value ("meslogasync.log" + string(mWriteLogNum)).
      284               os-rename "meslogasync.log" value ("meslogasync.log" + string(mWriteLogNum)).
      285               output stream sLogMes to "meslogasync.log".
      286               assign
      287                  mWriteLogTime = getnow()
      288                  mWriteLogMes  = no
      289               .
      290            end.
      291         end.
      292      end.
      293      method public logical NextLog(iFile as char):
      294         NextLog(yes).
      295         mWriteLogNum = mWriteLogNum + 1.
      296         os-delete            value ("meslogasync.log" + string(mWriteLogNum)).
      297         os-command value(substitute ("copy &1 meslogasync.log&2 > copy.log &3 Exit",iFile,string(mWriteLogNum),chr(38)) ).
      298      end.
      299      method public void putStatus (itext as character ):
      300         putStatus (itext,no).
      301      end.
      302      define variable putStatusText as character no-undo.
      303      method public void putStatus (itext as character, iAdd as logical ):
      304         define variable vText as character no-undo.
      305         if iAdd
      306         then
      307            vText = putStatusText + " " + iText.
      308         else assign
      309            putStatusText = iText
      310            vtext         = iText
      311         .
      312         os-delete VALUE ("procstatus.txt").
      313         Writefile("procstatus.txt", vtext + chr(10)).
      314         NextLog().
      315      end.
      316      method public datetime-tz getnow():
      317         return datetime-tz(cur-time-string-sec()).
      318      end.
      319      method public datetime-tz getnowday():
      320         return datetime-tz(today).
      321      end.
      322      method public void  creatProcInfo (input iAllobj as integer,iProcnum as integer,iAllproc as integer   ):
      323          define variable vMyPid as int64 no-undo.
      324         run utl/getpid.p (output vMyPid) no-error.
      325         Writefile("procinfo.txt", substitute("&1~001&2~001&3~001&4&5",vMyPID ,iAllobj,iProcnum,iAllproc,chr(10))).
      326         mWriteLogTime = getnow().
      327      end method.
      328      method public logical myProcInfo():
      329         return FileExists("procinfo.txt").
      330      end.
      331      method public logical PutMes
      332        (input Itext as character  ):
      333         PutMes(Itext,yes).
      334      end.
      335      method public logical PutMes
      336        (input Itext as character ,
      337         input IFlagtime as logical):
      338         if Itext begins "error"
      339         then
      340            ErrorProc = yes.
      341         if IFlagtime
      342         then do:
      343            put stream sLogMes unformatted substitute ("&1 &2",cur-time-string-sec(), Itext) skip .
      344            if Itext begins "error"
      345            then
      346               put stream sLogMes unformatted "ERROR Произошла ошибка во время выполнения." skip.
      347         end.
      348         else
      349            put stream sLogMes unformatted Itext skip .
      350         mWriteLogMes = yes.
      351         NextLog().
      352      end.
      353         method public character  SetGblError (input itext as character ):
      354         putmes (itext).
      355         if  log-manager:logfile-name ne ?
      356         then
      357            put unformatted (substitute ("#### Error Read ClientLog #### :&1",searchfile (log-manager:logfile-name)))  skip.
      358      end.
      359      method public logical CheckParam ():
      360         return FileExists("param.txt").
      361      end.
      362            define variable mxmlParam as longchar no-undo init "".
      363      method public  void SavePARAM ( input iName as char, input iValue as char ):
      364         if iName eq ?
      365         then
      366            mxmlParam = "".
      367         else
      368            mxmlParam = mxmlParam + substitute ("&1&2&3&4&5",
      369                                               SUBSTITUTE("<PARAM name='&1'>", iName),
      370                                               iValue,
      371                                               SUBSTITUTE("</PARAM name='&1'>", iName),
      372                                               chr(13),
      373                                               chr(10)
      374            ).
      375      end method.
      376      method public  void  SavefilePARAM (ifile as character ):
      377         define variable vLob as longchar no-undo.
      378         run utl\filecrypchar.p(mxmlParam,
      379                               "sysadmasync",
      380                               yes,
      381                               output vLob
      382                               ).
      383         copy-lob vLob to file ifile no-error.
      384      end.
      385      method public ibs.th.file.asyncparam GetPARAM (  input iName as char ):
      386         return GetPARAM("param.txt",iName).
      387      end.
      388      method public char GetPARAM (  input iNum as integer ):
      389         define variable vresult as ibs.th.file.asyncparam no-undo.
      390         vresult = GetPARAM("param.txt","ParamProc_" + string(iNum)).
      391         return vresult:valueParam.
      392      end.
      393      method public ibs.th.file.asyncparam GetPARAM ( input iFile as char, input iName as char ):
      394         def var vLob  as longchar no-undo.
      395         def var vFrom as int64    no-undo.
      396         def var vTo   as int64    no-undo.
      397         def var vParInt as integer no-undo.
      398         define variable paramObj as ibs.th.file.asyncparam no-undo.
      399         vParInt = int(iname) no-error.
      400         if not error-status:error
      401         then
      402            iname = "ParamProc_" + string(vParInt).
      403         paramObj = getParamObj(iname).
      404         if paramObj:valueParam eq ? and mxmlParam eq ""
      405         then do:
      406            if not FileExists (iFile) then return ?.
      407            copy-lob file iFile to vLob no-error.
      408            run utl\filecrypchar.p(vLob,
      409                               "sysadmasync",
      410                               no,
      411                               output mxmlParam
      412                               ).
      413         end.
      414         vFrom = index(mxmlParam, SUBSTITUTE("<PARAM name='&1'>", iName)).
      415         if vFrom <= 0 then return paramObj.
      416         assign
      417            vTo = index(mxmlParam, SUBSTITUTE("</PARAM name='&1'>", iName))
      418            vFrom = vFrom + LENGTH(SUBSTITUTE("<PARAM name='&1'>", iName)).
      419         if vTo < vFrom then return paramObj.
      420         paramObj:valueParam = string(substring(mxmlParam, vFrom, vTo - vFrom)).
      421         return paramObj.
      422      end method.
      423      method ibs.th.file.asyncparam getParamObj (iName as character ):
      424           find first tt-Param where tt-Param.nameParam eq iName no-lock no-error.
      425           if not available tt-Param
      426           then do:
      427               create tt-Param.
      428               assign
      429                  tt-Param.nameParam = iName
      430               .
      431               tt-Param.objParam  = new ibs.th.file.asyncparam(iName).
      432           end.
      433           return cast (tt-Param.objParam,ibs.th.file.asyncparam).
      434      end.
      435      constructor public asyncproc (  ):
      436         super ().
      437      end constructor.
      438      destructor public asyncproc ( ):
      439         for each tt-Param:
      440             delete object tt-Param.objParam.
      441         end.
      442         empty temp-table tt-Param.
      443      end destructor.
      444   method public character objExists
      445   (input  ifolder as character,
      446    input  iType   as character  ):
      447       define variable vFileType as character no-undo init "D,F".
      448       define variable vi        as integer no-undo.
      449       define variable vtype as character no-undo.
      450       if iType ne ?
      451       then
      452          vFileType = iType.
      453       do vi = 1 to num-entries(vFileType):
      454          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      455          vtype = file-information:file-type.
      456          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      457             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      458             index(vtype , entry(vi,vFileType )) > 0
      459          then return file-information:full-pathname .
      460          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      461          vtype = file-information:file-type.
      462          if file-information:file-name <> "" and
      463             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      464             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      465             index( vtype, entry(vi,vFileType )) > 0
      466          then return file-information:full-pathname .
      467       end.
      468       return ? .
      469   end.
      470   method public character SearchFile
      471   (input  ifile as character):
      472      return objExists(ifile,?).
      473   end.
      474   method public character SearchPFile
      475   (input inFile as char):
      476        define variable oFile       as character no-undo.
      477        define variable vFileSearch as character no-undo.
      478        define variable vNumEntry   as integer no-undo.
      479        if inFile = "" then return ?.
      480        vNumEntry = num-entries(inFile,".").
      481        vFileSearch = inFile.
      482        if    vNumEntry > 0
      483           and (   entry(vNumEntry,inFile,".") eq "p"
      484                or entry(vNumEntry,inFile,".") eq "w")
      485        then do:
      486           entry(vNumEntry,vFileSearch, ".") = "r".
      487           oFile = search(vFileSearch ).
      488           if oFile eq ?
      489           then
      490              oFile = search(inFile).
      491        end.
      492        else
      493           oFile = search(vFileSearch).
      494        return oFile.
      495     end.
      496      method public logical FolderExists  (input  ifolder as character ):
      497         return objExists(ifolder,"D") ne ?.
      498      end.
      499      method public logical FileExists  (input  ifolder as character ):
      500         return objExists(ifolder,"F") ne ?.
      501      end.
      502      method public logical  objExists  (input  ifile as character):
      503         return    (objExists(ifile,"D") ne ?) or ( objExists(ifile,"F") ne ?) .
      504      end.
      505      method public char Writefile (ifile as character ,itext as character):
      506         define variable vFile       as character no-undo.
      507         define variable vNameFolder as character no-undo.
      508         define variable vFileName   as character no-undo.
      509         define variable vNum        as integer   no-undo.
      510         if itext eq ""
      511         then do:
      512           if ifile <> ? then
      513            if num-entries(ifile,"\") > 1 or
      514               num-entries(ifile,"/") > 1
      515            then do:
      516              vFile = replace(ifile,"/","\").
      517              vFileName = entry(num-entries(vFile,"\"),vFile,"\").
      518              vNum = index(vFile,vFileName) - 1.
      519              vNameFolder = substring(vFile, 1, vNum).
      520              if not FolderExists(vNameFolder) then do:
      521                  if vWritelog
      522                  then
      523                     putmes (substitute ("Не удалось записать файл &1 : Не найден рабочий каталог &2 ",ifile,vNameFolder)).
      524                  else
      525                     return substitute ("Не удалось записать файл &1 : Не найден рабочий каталог &2 ",ifile,vNameFolder).
      526              end.
      527            end.
      528            output stream sWriteFile to value(ifile).
      529            output stream sWriteFile close.
      530         end.
      531         else do:
      532         run gbl/fileapnd.p (
      533             input ifile
      534           , input itext
      535           , input 3
      536       ) no-error.
      537       if error-status :error
      538       then do:
      539          if vWritelog
      540          then
      541             putmes (substitute ("Не удалось записать файл &1 : &2 ",ifile,return-value)).
      542          else
      543             return substitute ("Не удалось записать файл &1 : &2 ",ifile,return-value).
      544       end.
      545       end.
      546       return "".
      547      end.
      548   end class.
