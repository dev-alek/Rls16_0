      128      define public property m-prowin32FileName as character no-undo
      129      get.
      130      set (arg as char):
      131         if arg eq ""
      132         then
      133            arg = "bin/prowin32.exe".
      134         arg = search(arg).
      135         if arg ne ?
      136         then
