      139      define variable myPID      as int64     no-undo.
      140      define variable myCompName as character no-undo.
      141      define variable myCompUser as character no-undo.
      142      define variable preWorkDir as character no-undo.
      143      define public property MyWorkDir as character no-undo
      144      get():
      145         return (if MyWorkDir  ne "" then( MyWorkDir + v-path-tls-dir-delim ) else "").
      146      end.
      147      set (arg as char):
      148         if arg ne ?
      149         then do:
      150            define variable vi   as integer no-undo.
      151            if  arg eq "pid_"
      152            then do:
      153               if     myPID ne 0
      154                  and myPID ne ?
      155               then do:
      156                  block-cr:
      157                  do vi = 1 to 1:
      158                     MyWorkDir = substitute("&1&2_&3" , preWorkDir, string(mypid), string(random(1,9999999))).
      159                     if objExists( MyWorkDir)
      160                     then
      161                        next block-cr.
      162                     os-create-dir VALUE(MyWorkDir).
      163                     MyWorkDir = objExists( MyWorkDir,"D").
      164                     if MyWorkDir ne ?
      165                     then
      166                        leave block-cr.
      167                  end.
      168               end.
      169               else
      170                  MyWorkDir = ?.
      171            end.
      172            else
      173               MyWorkDir = objExists( arg,"D").
      174            if MyWorkDir ne ?
      175            then
      176               Writefile(MyWorkDir + "parentPid.txt", string(mypid) + chr(10)).
      177          end.
      178       end.
