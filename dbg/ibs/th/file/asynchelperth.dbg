      188       define public property myUser as character initial ? no-undo
      189       get:
      190          if myUser eq ?
      191          then do:
      192             if connected ("ub":U)
      193             then do:
      194                define variable vSystemUser as ibs.th.file.asyncparam no-undo.
      195                define variable vSystemPass as ibs.th.file.asyncparam no-undo.
      196                vSystemUser = mAsyncProc:getParamObj("SystemUser").
      197                vSystemPass = mAsyncProc:getParamObj("SystemPass").
      198                run utl/syspwd.p(input vSystemUser, input vSystemPass)no-error.
      199                myUser = vSystemUser:valueParam.
      200             end.
      201          end.
      202          return myUser.
      203       end.
      204       set.
      205       define public property myPass as character initial ? no-undo
      206       get:
      207          if myPass eq ?
      208          then do:
      209             if connected ("ub":U)
      210             then do:
      211                define variable vSystemUser as ibs.th.file.asyncparam no-undo.
      212                define variable vSystemPass as ibs.th.file.asyncparam no-undo.
      213                vSystemUser = mAsyncProc:getParamObj("SystemUser").
      214                vSystemPass = mAsyncProc:getParamObj("SystemPass").
      215                run utl/syspwd.p(input vSystemUser, input vSystemPass)no-error.
      216                myPass = substitute("nocrypt:&1",vSystemPass:valueParam).
      217             end.
      218          end.
      219          return myPass.
      220       end.
