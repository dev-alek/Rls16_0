       46   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       47   method public integer IsProcessRunning
       48     (PID AS INTEGER) :
       49     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
       50     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
       51     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
       52     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
       53     define variable rv          as integer no-undo .
       54     RUN OpenProcess in hpapi
       55                     ( 1024,
       56                       0,
       57                       PID,
       58                       OUTPUT hProcess).
       59     IF hProcess NE 0 THEN DO:
       60        RUN GetExitcodeProcess in hpapi
       61                     ( hProcess,
       62                       OUTPUT ExitCode,
       63                       OUTPUT ReturnValue).
       64        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
       65             then  - 1
       66             else ReturnValue).
       67        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
       68     END.
       69     RETURN rv.
       70   end.
       71   define temp-table ttfileList no-undo like ttfile.
