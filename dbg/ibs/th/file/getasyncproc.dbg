        1   define new global shared variable mAsyncProc as class ibs.th.file.asyncproc no-undo.
        2   define output parameter oAsyncProc as class ibs.th.file.asyncproc no-undo.
        3   if not valid-object (mAsyncProc)
        4   then
        5      mAsyncProc = new ibs.th.file.asyncproc().
        6   oAsyncProc = mAsyncProc.
