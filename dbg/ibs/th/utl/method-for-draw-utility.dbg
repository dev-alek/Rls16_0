     3130                         and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     3131                         and fin-doc-attr.attr-code    eq "pre-vedom"
     3132                         exclusive-lock no-error.
     3133                       if not available fin-doc-attr
     3134                         then
     3135                       do:
     3136                         create fin-doc-attr.
     3137                         assign
     3138                           fin-doc-attr.host-code    = buf_fin-doc.host-code
     3139                           fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     3140                           fin-doc-attr.attr-code    = "pre-vedom"
     3141                           .
     3142                       end.
     3143                       define variable mPin as character no-undo.
     3144                       mPin   = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "Pin") .
     3145                       fin-doc-attr.attr-value = substitute("&1;&2;&3;&4;&5;&6;&7"
     3146                         ,mOsnbag
     3147                         ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BankDepos-code")
     3148                         ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BankRecip-code")
     3149                         ,mPin
     3150                         ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "SourceCode")
     3151                         ,msumInc-save
     3152                         ,mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BankRecip-acct")).
     3153                       define variable Vparentrec as character no-undo.
     3154                       if Vparentrec eq ""
     3155                         then
     3156                         Vparentrec = gen-key-rec ("fin-doc",(buffer buf_fin-doc:handle)).
     3157                       find first fin-doc-attr where fin-doc-attr.host-code       eq buf_fin-doc.host-code
     3158                         and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     3159                         and fin-doc-attr.attr-code    eq "ParentMoney"
     3160                         exclusive-lock no-error.
     3161                       if not available fin-doc-attr
     3162                         then
     3163                       do:
     3164                         create fin-doc-attr.
     3165                         assign
     3166                           fin-doc-attr.host-code    = buf_fin-doc.host-code
     3167                           fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     3168                           fin-doc-attr.attr-code    = "ParentMoney"
     3169                           .
     3170                       end.
     3171                       fin-doc-attr.attr-value = Vparentrec.
     3172                       if mMoney ne ""
     3173                         then
     3174                       do:
     3175                         find first fin-doc-attr where fin-doc-attr.host-code eq buf_fin-doc.host-code
     3176                           and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     3177                           and fin-doc-attr.attr-code eq "cover_sheet"
     3178                           exclusive-lock no-error.
     3179                         if not available fin-doc-attr
     3180                           then
     3181                         do:
     3182                           create fin-doc-attr.
     3183                           assign
     3184                             fin-doc-attr.host-code    = buf_fin-doc.host-code
     3185                             fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     3186                             fin-doc-attr.attr-code    = "cover_sheet"
     3187                             .
     3188                         end.
     3189                         fin-doc-attr.attr-value = mMoney.
     3190                         mMoney = "".
     3191                       end.
     3192                       proc-close ( buffer buf_fin-doc) no-error.
     3193                       if error-status :error then
     3194                       do:
     3195                         put-log("Ошибки при сохранении фин.док-та").
     3196                       END.
     3197                       if buf_fin-doc.status_ <> 'факт':U then
     3198                       do:
     3199                         proc-close ( buffer buf_fin-doc) NO-ERROR.
     3200                         if error-status :error then
     3201                         do:
     3202                           put-log("Не удалось сменить статус фин.док-та").
     3203                         END.
     3204                       end.
     3205                       if buf_fin-doc.status_ <> 'факт':U then
     3206                       do:
     3207                         proc-close ( buffer buf_fin-doc) no-error .
     3208                         if error-status :error then
     3209                         do:
     3210                           put-log("Не удалось сменить статус фин.док-та").
     3211                         END.
     3212                       end.
     3213                     end.
     3214                     vok = yes.
     3215                     finally:
     3216                       if not mDebug then
     3217                       do:
     3218                         os-delete value("rest-fin-temp.json") .
     3219                         os-delete value("restfin.json") .
     3220                       end.
     3221                       vok = chek_rest_fin() and vok.
     3222                       put-log( string( now) + if  vok then "   Денежные остатки загружены!" else "   Денежные остатки не загружены!") .
     3223                       put-log("").
     3224                       return vok.
     3225                     end finally.
     3226                   end method .
     3227                   method public void proc-close (buffer buf_fin-doc for ub.fin-doc) :
     3228                     define variable v-status_         as character no-undo .
     3229                     define variable v-old-status_     as character no-undo .
     3230                     define variable v-ask-date        as logical   no-undo .
     3231                     define variable v-ask-message     as character no-undo .
     3232                     define variable v-status-date-chr as character no-undo.
     3233                     define variable v-date1           as date      no-undo .
     3234                     assign
     3235                       v-old-status_ = buf_fin-doc.status_
     3236                       .
     3237                     run trg/findgraf.p (
     3238                       input  buf_fin-doc.host-code
     3239                       ,input  buf_fin-doc.fin-doc-code
     3240                       ,input  '<закрытие документа>':U
     3241                       ,input  ''
     3242                       ,input  v-old-status_
     3243                       ,input  ?
     3244                       ,output v-status_
     3245                       ,output v-ask-date
     3246                       ,output v-ask-message
     3247                       ) no-error.
     3248                     if error-status:error then
     3249                     do:
     3250                       return error substitute("Ошибка при проверке возможности &1&2&3"
     3251                         ,'<закрытие документа>':U
     3252                         , chr(10)
     3253                         , return-value ).
     3254                     end.
     3255                     v-date1 = buf_fin-doc.doc-date.
     3256                     run trg/findstat.p (
     3257                       input parparentproc
     3258                       ,input buf_fin-doc.host-code
     3259                       ,input buf_fin-doc.fin-doc-code
     3260                       ,input '<закрытие документа>':U
     3261                       ,input 'auto':U
     3262                       ,input v-status_
     3263                       ,input-output v-date1
     3264                       ,input no
     3265                       ) no-error .
     3266                     if error-status:error then
     3267                     do:
     3268                       return error substitute("Ошибка при переводе статуса финансового документа:&1&2&1&3"
     3269                         ,'<закрытие документа>':U
     3270                         , chr(10)
     3271                         , return-value ).
     3272                     end.
     3273                   end method.
     3274                   method public character gen-key-rec (p-tbl-name    as character,
     3275                     p-bh_tbl-name as handle):
     3276                     define variable p-key-rec        as character no-undo.
     3277                     define variable fh               as handle    no-undo .
     3278                     define variable v-ok             as logical   no-undo .
     3279                     define variable v-inform         as character no-undo .
     3280                     define variable v-ind            as integer   no-undo .
     3281                     define variable v-idx-field-qnty as integer   no-undo .
     3282                     if p-tbl-name = ?
     3283                       or p-tbl-name = "":U
     3284                       then
     3285                     do:
     3286                       return error substitute( "(gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы." ).
     3287                     end.
     3288                     if not p-bh_tbl-name:available then
     3289                     do:
     3290                       return error substitute( "(gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", p-tbl-name ).
     3291                     end.
     3292                     assign
     3293                       p-key-rec = p-tbl-name
     3294                       v-inform  = p-bh_tbl-name:index-information(1)
     3295                       v-ind     = 2
     3296                       .
     3297                     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3298                       on error undo, return error
     3299                       :
     3300                       assign
     3301                         v-inform = p-bh_tbl-name:index-information( v-ind )
     3302                         v-ind    = v-ind + 1
     3303                         .
     3304                     end.
     3305                     if v-inform = ?
     3306                       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3307                       or entry( 3, v-inform, ",":U ) <> "1":U
     3308                       then
     3309                     do:
     3310                       return error substitute( "Таблица &2 не имеет первичного ключа в БД",  p-tbl-name ).
     3311                     end.
     3312                     else
     3313                     do:
     3314                       assign
     3315                         v-idx-field-qnty = num-entries( v-inform ) - 4
     3316                         .
     3317                       if v-idx-field-qnty < 2 then
     3318                       do:
     3319                         return error substitute( "Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", v-inform, p-tbl-name ).
     3320                       end.
     3321                       do v-ind = 1 to v-idx-field-qnty by 2
     3322                         on error undo, return error
     3323                         :
     3324                         assign
     3325                           fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3326                         p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3327                           .
     3328                       end.
     3329                     end.
     3330                     if p-key-rec = ? then
     3331                     do:
     3332                       assign
     3333                         p-key-rec = "":U
     3334                         .
     3335                       return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", p-tbl-name ).
     3336                     end.
     3337                     return p-key-rec.
     3338                   end method.
     3339                   method public character StrTax (str as character):
     3340                     define variable v-envd as logical no-undo .
     3341                     assign
     3342                       str = " В т.ч.: "  .
     3343                     for each tt0-fin-doc-tax :
     3344                       if str <> " В т.ч.: " then str = str + "," .
     3345                       if not tt0-fin-doc-tax.with-vat then assign str = str + "без НДС - (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3346                       else
     3347                       do:
     3348                         if tt-fin-doc.curr-code = 0 then
     3349                         do:
     3350                           assign
     3351                             str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3352                         end.
     3353                         else
     3354                         do:
     3355                           assign
     3356                             str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     3357                         end.
     3358                       end.
     3359                       if str = " В т.ч.: " then assign str = "" .
     3360                     end.
     3361                     return str .
     3362                   end method.
     3363                   method public void RoundTax() :
     3364                     for each tt0-fin-doc-tax :
     3365                       assign
     3366                         tt0-fin-doc-tax.sum-line-doc      = ROUND( tt0-fin-doc-tax.sum-line-doc      , 2)
     3367                         tt0-fin-doc-tax.sum-vat-line-doc  = ROUND( tt0-fin-doc-tax.sum-vat-line-doc  , 2)
     3368                         tt0-fin-doc-tax.sum-line-rubl     = ROUND( tt0-fin-doc-tax.sum-line-rubl     , 2)
     3369                         tt0-fin-doc-tax.sum-vat-line-rubl = ROUND( tt0-fin-doc-tax.sum-vat-line-rubl , 2)
     3370                         tt0-fin-doc-tax.sum-line-base     = ROUND( tt0-fin-doc-tax.sum-line-base     , 2)
     3371                         tt0-fin-doc-tax.sum-vat-line-base = ROUND( tt0-fin-doc-tax.sum-vat-line-base , 2)
     3372                         .
     3373                     end.
     3374                   END method.
     3375                   method public logical sendcode(icode as integer ):
     3376                     run utl/sendcode.p(this-object,icode,?).
     3377                     put-log("").
     3378                     return yes.
     3379                   end method.
     3380                   method public logical sendnum(text-num as character ):
     3381                     run utl/sendnum.p(this-object,text-num,v-cntxt-obj-code).
     3382                     put-log("").
     3383                     return yes.
     3384                   end method.
     3385                   method public logical sendparam(text_file as character ):
     3386                     define variable cmd as character no-undo .
     3387                     define buffer buf_cash-desk for ub.cash-desk .
     3388                     define variable ii as integer no-undo .
     3389                     do ii = 1 to num-entries (text_file,chr(4)):
     3390                       if search (entry (ii,text_file,chr(4))) > ""
     3391                         then
     3392                         for each buf_cash-desk no-lock where buf_cash-desk.db-num   = v-cntxt-db-num
     3393                           and buf_cash-desk.obj-code = v-cntxt-obj-code
     3394                           and buf_cash-desk.pos-type = 'IBM-XML':U
     3395                           and buf_cash-desk.cash-on
     3396                           :
     3397                           assign
     3398                             cmd = substitute('&1 -X POST -H "Content-Type: text/xml" -d @&2 &3 >&4'
     3399                         , search ("exe/curl.exe")
     3400                         , search (entry (ii,text_file,chr(4)))
     3401                         , (entry(1, buf_cash-desk.addr-path, chr(4)) + '://' + entry(2, buf_cash-desk.addr-path, chr(4)))
     3402                         , "cashParResp.txt")
     3403                             .
     3404                           os-command silent value (cmd) .
     3405                         end .
     3406                     end.
     3407                     return yes.
     3408                   end method.
     3409                   method public logical  chek_rest():
     3410                     for each ub.trn-doc no-lock where ub.trn-doc.obj-type = v-cntxt-obj-type
     3411                       and ub.trn-doc.obj-code = v-cntxt-obj-code,
     3412                       each ub.doc-line no-lock where ub.doc-line.doc-code = ub.trn-doc.doc-code:
     3413                       for first ub.goods no-lock where ub.goods.artic = ub.doc-line.artic and
     3414                         ub.goods.prod-code = ub.doc-line.prod-code and
     3415                         ub.goods.prod-type = ub.doc-line.prod-type,
     3416                         first ub.units no-lock where ub.units.unit-name = ub.goods.unit-base:
     3417                         if lookup( 'топ':U, ub.units.type ) > 0 then next .
     3418                         else return yes .
     3419                       end.
     3420                     end.
     3421                     return no .
     3422                   end  method.
     3423                   method public logical  chek_rest_ptrl():
     3424                     for each ub.trn-doc no-lock where ub.trn-doc.obj-type = v-cntxt-obj-type
     3425                       and ub.trn-doc.obj-code = v-cntxt-obj-code,
     3426                       each ub.doc-line no-lock where ub.doc-line.doc-code = ub.trn-doc.doc-code:
     3427                       for first ub.goods no-lock where ub.goods.artic = ub.doc-line.artic and
     3428                         ub.goods.prod-code = ub.doc-line.prod-code and
     3429                         ub.goods.prod-type = ub.doc-line.prod-type,
     3430                         first ub.units no-lock where ub.units.unit-name = ub.goods.unit-base:
     3431                         if lookup( 'топ':U, ub.units.type ) > 0 then return yes .
     3432                         else next .
     3433                       end.
     3434                     end.
     3435                     return no .
     3436                   end  method.
     3437                   method public logical  chek_rest_fin():
     3438                     return can-find (first ub.fin-doc where ub.fin-doc.obj-type = v-cntxt-obj-type
     3439                       and ub.fin-doc.obj-code = v-cntxt-obj-code).
     3440                   end  method.
     3441                   method public logical  load_rvs(ifile-path as character):
     3442                     return load_rvs(mAddr,ifile-path).
     3443                   end  method.
     3444                   method public logical load_rvs(iAddr as character,ifile-path as character  ):
     3445                     define variable vcmd       as character no-undo.
     3446                     define variable v-rvs-code as character no-undo.
     3447                     define variable vOk        as logical   no-undo.
     3448                     define buffer open-shift       for ub.shift-obj .
     3449                     define buffer buf_rvs-doc-prev for ub.rvs-doc .
     3450                     put-log("Загрузка последней сменной сверки").
     3451                     find first tt-gds-mapping no-error.
     3452                     if not available tt-gds-mapping
     3453                       then
     3454                     do:
     3455                       load_gds_maping(ifile-path ).
     3456                       find first tt-gds-mapping no-error.
     3457                       if not available tt-gds-mapping
     3458                         then
     3459                         return error.
     3460                     end.
     3461                     find last open-shift where
     3462                       open-shift.obj-type = v-cntxt-obj-type and
     3463                       open-shift.obj-code = v-cntxt-obj-code and
     3464                       open-shift.status_ = 'тек':U
     3465                       use-index pi no-error.
     3466                     if available  open-shift
     3467                       then
     3468                     do:
     3469                       for each tt-rvs-doc-attr:
     3470                         delete tt-rvs-doc-attr.
     3471                       end.
     3472                       for each tt-rvs-line-attr:
     3473                         delete tt-rvs-line-attr.
     3474                       end.
     3475                       for each tt-rvs-pump-attr:
     3476                         delete tt-rvs-pump-attr.
     3477                       end.
     3478                       for each tt-rvs-line-pump-attr:
     3479                         delete tt-rvs-line-attr.
     3480                       end.
     3481                       for each tt-rvs-line:
     3482                         delete tt-rvs-line-pump-attr.
     3483                       end.
     3484                       for each tt-rvs-pump:
     3485                         delete tt-rvs-pump.
     3486                       end.
     3487                       for each tt-rvs-line-pump:
     3488                         delete tt-rvs-line-pump.
     3489                       end.
     3490                       for each tt-rvs-doc:
     3491                         delete tt-rvs-doc.
     3492                       end.
     3493                       vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetRvs >&3", search ("exe/curl.exe"), iaddr, "rvs-temp.json").
     3494                       os-command silent value (vcmd).
     3495                       fix-codepage_and_SetJsonObj(input "rvs-temp.json") .
     3496                       parse-json(input temp-table tt-rvs-doc              :default-buffer-handle, input "rvs-doc") .
     3497                       parse-json(input temp-table tt-rvs-doc-attr         :default-buffer-handle, input "rvs-doc-attr") .
     3498                       parse-json(input temp-table tt-rvs-line             :default-buffer-handle, input "rvs-line") .
     3499                       parse-json(input temp-table tt-rvs-line-attr        :default-buffer-handle, input "rvs-line-attr") .
     3500                       parse-json(input temp-table tt-rvs-pump             :default-buffer-handle, input "rvs-pump") .
     3501                       parse-json(input temp-table tt-rvs-pump-attr        :default-buffer-handle, input "rvs-pump-attr") .
     3502                       parse-json(input temp-table tt-rvs-line-pump        :default-buffer-handle, input "rvs-line-pump") .
     3503                       parse-json(input temp-table tt-rvs-line-pump-attr   :default-buffer-handle, input "rvs-line-pump-attr") .
     3504                       find first  buf_rvs-doc-prev where buf_rvs-doc-prev.obj-type eq v-cntxt-obj-type
     3505                         and buf_rvs-doc-prev.obj-code eq v-cntxt-obj-code
     3506                         and buf_rvs-doc-prev.shift-date eq open-shift.shift-date
     3507                         and buf_rvs-doc-prev.shift-num  eq open-shift.shift-num
     3508                         no-lock no-error.
     3509                       if available  buf_rvs-doc-prev
     3510                         then
     3511       // изменения от базы к базе
     3512                         for first tt-rvs-doc:
     3513                           if tt-rvs-doc.doc-date eq ? then  tt-rvs-doc.doc-date =  open-shift.shift-date.
     3514                           doc-code
     3515                             (  input 'main':U
     3516                             ,  input v-cntxt-obj-type
     3517                             ,  input v-cntxt-obj-code
     3518                             ,  input ?
     3519                             , output v-rvs-code
     3520                             ) .
     3521                           for each tt-rvs-doc-attr where tt-rvs-doc-attr.rvs-code eq tt-rvs-doc.rvs-code:
     3522                             tt-rvs-doc-attr.rvs-code = v-rvs-code.
     3523                           end.
     3524                           for each tt-rvs-line where tt-rvs-line.rvs-code eq tt-rvs-doc.rvs-code:
     3525                             assign
     3526                               tt-rvs-line.obj-type      = v-cntxt-obj-type
     3527                               tt-rvs-line.obj-code      = v-cntxt-obj-code
     3528                               tt-rvs-line.rvs-code      = v-rvs-code
     3529                               tt-rvs-line.rvs-prev-code = buf_rvs-doc-prev.rvs-code
     3530                               .
     3531                             find first tt-gds-mapping where tt-gds-mapping.gds-code15 eq tt-rvs-line.gds-code
     3532                               no-lock no-error.
     3533                             if available tt-gds-mapping
     3534                               then
     3535                             do:
     3536                               find first goods where goods.gds-code eq tt-gds-mapping.gds-code16 no-lock no-error.
     3537                               if not available goods
     3538                                 then
     3539                               do:
     3540                                 put-log(substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16)).
     3541                                 return error substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16).
     3542                               end.
     3543                               else
     3544                                 tt-rvs-line.gds-code = tt-gds-mapping.gds-code16.
     3545                             end.
     3546                             else
     3547                             do:
     3548                               put-log(substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line.gds-code)).
     3549                               return error substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line.gds-code).
     3550                             end.
     3551                             find first ub.place where ub.place.loc1 eq tt-rvs-line.loc1
     3552                               no-lock no-error.
     3553                             if available ub.place
     3554                               then
     3555                               tt-rvs-line.pl-code = ub.place.pl-code.
     3556                           end.
     3557                           for each tt-rvs-line-attr where tt-rvs-line-attr.rvs-code eq tt-rvs-doc.rvs-code:
     3558                             assign
     3559                               tt-rvs-line-attr.obj-type = v-cntxt-obj-type
     3560                               tt-rvs-line-attr.obj-code = v-cntxt-obj-code
     3561                               tt-rvs-line-attr.rvs-code = v-rvs-code
     3562                               .
     3563                             find first tt-gds-mapping where tt-gds-mapping.gds-code15 eq tt-rvs-line-attr.gds-code
     3564                               no-lock no-error.
     3565                             if available tt-gds-mapping
     3566                               then
     3567                             do:
     3568                               find first goods where goods.gds-code eq tt-gds-mapping.gds-code16 no-lock no-error.
     3569                               if not available goods
     3570                                 then
     3571                               do:
     3572                                 put-log(substitute ("Отсутствует товар с кодом  &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16)).
     3573                                 return error substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16).
     3574                               end.
     3575                               else
     3576                                 tt-rvs-line-attr.gds-code = tt-gds-mapping.gds-code16.
     3577                             end.
     3578                             else
     3579                             do:
     3580                               put-log(substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-attr.gds-code)).
     3581                               return error substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-attr.gds-code).
     3582                             end.
     3583                             find first ub.place where ub.place.loc1 eq tt-rvs-line.loc1
     3584                               no-lock no-error.
     3585                             if available ub.place
     3586                               then
     3587                               tt-rvs-line.pl-code = ub.place.pl-code.
     3588                           end.
     3589                           for each tt-rvs-pump where tt-rvs-pump.rvs-code eq tt-rvs-doc.rvs-code:
     3590                             assign
     3591                               tt-rvs-pump.obj-type = v-cntxt-obj-type
     3592                               tt-rvs-pump.obj-code = v-cntxt-obj-code
     3593                               tt-rvs-pump.rvs-code = v-rvs-code
     3594                               .
     3595                             find first tt-gds-mapping where tt-gds-mapping.gds-code15 eq tt-rvs-pump.gds-code
     3596                               no-lock no-error.
     3597                             if available tt-gds-mapping
     3598                               then
     3599                             do:
     3600                               find first goods where goods.gds-code eq tt-gds-mapping.gds-code16 no-lock no-error.
     3601                               if not available goods
     3602                                 then
     3603                               do:
     3604                                 put-log(substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16)).
     3605                                 return error substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16).
     3606                               end.
     3607                               else
     3608                                 tt-rvs-pump.gds-code = tt-gds-mapping.gds-code16.
     3609                             end.
     3610                             else
     3611                             do:
     3612                               put-log(substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-pump.gds-code)).
     3613                               return error substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-pump.gds-code).
     3614                             end.
     3615                           end.
     3616                           for each tt-rvs-pump-attr where tt-rvs-pump-attr.rvs-code eq tt-rvs-doc.rvs-code:
     3617                             assign
     3618                               tt-rvs-pump-attr.obj-type = v-cntxt-obj-type
     3619                               tt-rvs-pump-attr.obj-code = v-cntxt-obj-code
     3620                               tt-rvs-pump-attr.rvs-code = v-rvs-code
     3621                               .
     3622                           end.
     3623                           for each tt-rvs-line-pump where tt-rvs-line-pump.rvs-code eq tt-rvs-doc.rvs-code:
     3624                             assign
     3625                               tt-rvs-line-pump.obj-type      = v-cntxt-obj-type
     3626                               tt-rvs-line-pump.obj-code      = v-cntxt-obj-code
     3627                               tt-rvs-line-pump.rvs-code      = v-rvs-code
     3628                               tt-rvs-line-pump.rvs-prev-code = buf_rvs-doc-prev.rvs-code
     3629                               .
     3630                             find first tt-gds-mapping where tt-gds-mapping.gds-code15 eq tt-rvs-line-pump.gds-code
     3631                               no-lock no-error.
     3632                             if available tt-gds-mapping
     3633                               then
     3634                             do:
     3635                               find first goods where goods.gds-code eq tt-gds-mapping.gds-code16 no-lock no-error.
     3636                               if not available goods
     3637                                 then
     3638                               do:
     3639                                 put-log(substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16)).
     3640                                 return error substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16).
     3641                               end.
     3642                               else
     3643                                 tt-rvs-line-pump.gds-code = tt-gds-mapping.gds-code16.
     3644                             end.
     3645                             else
     3646                             do:
     3647                               put-log(substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-pump.gds-code)).
     3648                               return error substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-pump.gds-code).
     3649                             end.
     3650                             find first ub.place where ub.place.loc1 eq tt-rvs-line-pump.loc1
     3651                               no-lock no-error.
     3652                             if available ub.place
     3653                               then
     3654                               tt-rvs-line-pump.pl-code = ub.place.pl-code.
     3655                           end.
     3656                           for each tt-rvs-line-pump-attr where tt-rvs-line-pump-attr.rvs-code eq tt-rvs-doc.rvs-code:
     3657                             assign
     3658                               tt-rvs-line-pump-attr.obj-type = v-cntxt-obj-type
     3659                               tt-rvs-line-pump-attr.obj-code = v-cntxt-obj-code
     3660                               tt-rvs-line-pump-attr.rvs-code = v-rvs-code
     3661                               .
     3662                             find first tt-gds-mapping where tt-gds-mapping.gds-code15 eq tt-rvs-line-pump-attr.gds-code
     3663                               no-lock no-error.
     3664                             if available tt-gds-mapping
     3665                               then
     3666                             do:
     3667                               find first goods where goods.gds-code eq tt-gds-mapping.gds-code16 no-lock no-error.
     3668                               if not available goods
     3669                                 then
     3670                               do:
     3671                                 put-log(substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16)).
     3672                                 return error substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16",tt-gds-mapping.gds-code16).
     3673                               end.
     3674                               else
     3675                                 tt-rvs-line-pump-attr.gds-code = tt-gds-mapping.gds-code16.
     3676                             end.
     3677                             else
     3678                             do:
     3679                               put-log(substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-pump-attr.gds-code)).
     3680                               return error substitute ("В файле соответствия отсутствует товар с кодом &1",tt-rvs-line-pump-attr.gds-code).
     3681                             end.
     3682                             find first ub.place where ub.place.loc1 eq tt-rvs-line-pump-attr.loc1
     3683                               no-lock no-error.
     3684                             if available ub.place
     3685                               then
     3686                               tt-rvs-line-pump-attr.pl-code = ub.place.pl-code.
     3687                           end.
     3688                           assign
     3689                             tt-rvs-doc.shift-date = open-shift.shift-date
     3690                             tt-rvs-doc.shift-num  = open-shift.shift-num
     3691                             tt-rvs-doc.shift-name = open-shift.shift-name
     3692                             tt-rvs-doc.doc-date   = today
     3693                             tt-rvs-doc.fact-date  = today
     3694                             tt-rvs-doc.fact-time  = time
     3695                             tt-rvs-doc.obj-type   = v-cntxt-obj-type
     3696                             tt-rvs-doc.obj-code   = v-cntxt-obj-code
     3697                             tt-rvs-doc.rvs-code   = v-rvs-code
     3698                             tt-rvs-doc.status_    = 'новый':U
     3699                             tt-rvs-doc.fact-order = ?
     3700                             tt-rvs-doc.host-code  = v-host-code
     3701                             tt-rvs-doc.PS         = "Последняя сменная сверка из " + string(version-name)
     3702                             .
     3703                         end.
     3704                       for each tt-rvs-doc:
     3705                         create ub.rvs-doc.
     3706                         buffer-copy tt-rvs-doc to ub.rvs-doc.
     3707                       end.
     3708                       for each tt-rvs-doc-attr:
     3709                         create ub.rvs-doc-attr.
     3710                         buffer-copy tt-rvs-doc-attr to ub.rvs-doc-attr.
     3711                       end.
     3712                       for each tt-rvs-line:
     3713                         create ub.rvs-line.
     3714                         buffer-copy tt-rvs-line to ub.rvs-line.
     3715                       end.
     3716                       for each tt-rvs-line-attr:
     3717                         create ub.rvs-line-attr.
     3718                         buffer-copy tt-rvs-line-attr to ub.rvs-line-attr.
     3719                       end.
     3720                       for each tt-rvs-pump:
     3721                         create ub.rvs-pump.
     3722                         buffer-copy tt-rvs-pump to ub.rvs-pump.
     3723                       end.
     3724                       for each tt-rvs-pump-attr:
     3725                         create ub.rvs-pump-attr.
     3726                         buffer-copy tt-rvs-pump-attr to ub.rvs-pump-attr.
     3727                       end.
     3728                       for each tt-rvs-line-pump:
     3729                         create ub.rvs-line-pump.
     3730                         buffer-copy tt-rvs-line-pump to ub.rvs-line-pump.
     3731                       end.
     3732                       for each tt-rvs-line-pump-attr:
     3733                         create ub.rvs-line-pump-attr.
     3734                         buffer-copy tt-rvs-line-pump-attr to ub.rvs-line-pump-attr.
     3735                       end.
     3736                     end.
     3737                     vOk = yes.
     3738                     finally:
     3739                       if not mDebug then
     3740                       do:
     3741                         os-delete value("rvs-temp.json") .
     3742                         os-delete value("rvs.json") .
     3743                       end.
     3744                       vOk = chek_rvs-shift() and vok.
     3745                       put-log(if vOk then "Сверка загружена" else "Сверка не загружена").
     3746                       put-log("").
     3747                       return vOk .
     3748                     end finally.
     3749                   end method.
     3750                   method public logical chek_rvs-shift():
     3751                     define buffer open-shift  for ub.shift-obj .
     3752                     define buffer buf_rvs-doc for ub.rvs-doc .
     3753                     find last open-shift where
     3754                       open-shift.obj-type = v-cntxt-obj-type and
     3755                       open-shift.obj-code = v-cntxt-obj-code and
     3756                       open-shift.status_ = 'тек':U
     3757                       use-index pi no-error.
     3758                     if available open-shift
     3759                       then
     3760                       find first  buf_rvs-doc where buf_rvs-doc.obj-type eq v-cntxt-obj-type
     3761                         and buf_rvs-doc.obj-code eq v-cntxt-obj-code
     3762                         and buf_rvs-doc.shift-date eq open-shift.shift-date
     3763                         and buf_rvs-doc.shift-num  eq open-shift.shift-num
     3764                         and buf_rvs-doc.rvs-type eq 'смена':U
     3765                         no-lock no-error.
     3766                     return  available buf_rvs-doc.
     3767                   end method.
     3768                   method public logical close-rvs-all ():
     3769                     put-log("Закрытие сменной сверки и смены.").
     3770                     define variable vok as logical no-undo.
     3771                     vok = close-rvs ().
     3772                     if not vok
     3773                       then
     3774                       vok = close-rvs ().
     3775                     finally:
     3776                       vok =   chek_rvs-close() and vok.
     3777                       put-log(if vOk then "Сверка закрыта" else "Сверка не закрыта").
     3778                       return vok.
     3779                     end.
     3780                   end method.
     3781                   method public logical close-rvs ():
     3782                     define buffer buf_rvs-doc for ub.rvs-doc .
     3783                     define buffer open-shift  for ub.shift-obj .
     3784                     define variable vok as logical no-undo.
     3785                     find last open-shift where
     3786                       open-shift.obj-type = v-cntxt-obj-type and
     3787                       open-shift.obj-code = v-cntxt-obj-code and
     3788                       open-shift.status_ = 'тек':U
     3789                       use-index pi no-error.
     3790                     if available open-shift
     3791                       then
     3792                       find first  buf_rvs-doc where buf_rvs-doc.obj-type eq v-cntxt-obj-type
     3793                         and buf_rvs-doc.obj-code eq v-cntxt-obj-code
     3794                         and buf_rvs-doc.shift-date eq open-shift.shift-date
     3795                         and buf_rvs-doc.shift-num  eq open-shift.shift-num
     3796                         and buf_rvs-doc.rvs-type eq 'смена':U
     3797                         no-lock no-error.
     3798                     if available buf_rvs-doc
     3799                       then
     3800                       run str/rvs-close.p (this-object,buf_rvs-doc.rvs-code) .
     3801                     vok = yes.
     3802                     finally:
     3803                       vok =   chek_rvs-close() and vok.
     3804                       return vok.
     3805                     end finally.
     3806                   end method.
     3807                   method public logical chek_rvs-close():
     3808                     define buffer open-shift  for ub.shift-obj .
     3809                     define buffer buf_rvs-doc for ub.rvs-doc .
     3810                     find first  buf_rvs-doc where buf_rvs-doc.obj-type eq v-cntxt-obj-type
     3811                       and buf_rvs-doc.obj-code   eq v-cntxt-obj-code
     3812                       and buf_rvs-doc.rvs-type   eq 'смена':U
     3813                       and buf_rvs-doc.status_    =  'факт':U
     3814                       no-lock no-error.
     3815                     return  available buf_rvs-doc.
     3816                   end method.
     3817                   method public logical chek_cash_passwd():
     3818                     define variable v-has-records as logical no-undo.
     3819                     v-has-records = can-find (first ub.staff where ub.staff.role     = 'C':U
     3820                       and ub.staff.password <> "").
     3821                     return v-has-records .
     3822                   end method.
     3823                   method public logical load_cash_passwd ( ) :
     3824                     load_cash_passwd(mAddr).
     3825                   end method.
     3826                   method public logical load_cash_passwd (iaddr as character) :
     3827                     define variable vcmd as character no-undo.
     3828                     define variable vOk  as logical   no-undo.
     3829                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetCashp >&3", search ("exe/curl.exe"), iaddr, "cashp-temp.json").
     3830                     os-command silent value (vcmd).
     3831                     fix-codepage_and_SetJsonObj (input "cashp-temp.json") .
     3832                     empty temp-table tt-cash-passwd.
     3833                     parse-json(input temp-table tt-cash-passwd:default-buffer-handle, input "tt-cash-passwd") .
     3834                     define variable v-count-confirm   as integer   no-undo .
     3835                     define variable v-count-decline   as integer   no-undo .
     3836                     define variable v-logfile-confirm as character no-undo .
     3837                     define variable v-logfile-decline as character no-undo .
     3838                     assign
     3839                       v-logfile-confirm = substitute("&1darw_util_pswd_ok.log", ibs.th.gbl.gbl-inipar:logDir)
     3840                       v-logfile-decline = substitute("&1darw_util_pswd_err.log", ibs.th.gbl.gbl-inipar:logDir)
     3841                       v-count-confirm   = 0
     3842                       v-count-decline   = 0
     3843                       .
     3844                     output STREAM lsIN  to value(v-logfile-confirm).
     3845                     put stream lsIN unformatted
     3846                       "Загружено (код, пароль);код;пароль" skip .
     3847                     output STREAM lsOUT to value(v-logfile-decline).
     3848                     put stream lsOUT unformatted
     3849                       "Отвергнуто (код, пароль);код;пароль;причина" skip .
     3850                     put-log ( string(now) +  "   Начинаем загрузку паролей кассиров...") .
     3851                     define buffer buf_staff for ub.staff .
     3852                     for each tt-cash-passwd :
     3853                       find first buf_staff no-lock
     3854                         where buf_staff.staff-code = tt-cash-passwd.staff-code no-error.
     3855                       if not available buf_staff
     3856                         then
     3857                       do:
     3858                         v-count-decline = v-count-decline + 1 .
     3859                         put stream lsOUT unformatted
     3860                           substitute ("Отвергнуто (код, пароль);&1;&2;запись отсутствует в вер.16"
     3861                           , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)))
     3862                           skip.
     3863                       end.
     3864                       else if buf_staff.role ne 'C':U
     3865                           then
     3866                         do:
     3867                           v-count-decline = v-count-decline + 1 .
     3868                           put stream lsOUT unformatted
     3869                             substitute ("Отвергнуто (код, пароль);&1;&2;пользователь не является кассиром в вер.16"
     3870                             , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)))
     3871                             skip.
     3872                         end.
     3873                         else
     3874                         do:
     3875                           find current buf_staff exclusive-lock no-error no-wait .
     3876                           if available buf_staff then
     3877                           do :
     3878                             buf_staff.password = tt-cash-passwd.password no-error .
     3879                             if error-status:error then
     3880                             do :
     3881                               v-count-decline = v-count-decline + 1 .
     3882                               put stream lsOUT unformatted
     3883                                 substitute ("Отвергнуто (код, пароль);&1;&2;&3 в вер.16"
     3884                                 , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)), error-status:get-message(1))
     3885                                 skip.
     3886                             end .
     3887                             else
     3888                             do :
     3889                               v-count-confirm = v-count-confirm + 1 .
     3890                               put stream lsIN unformatted
     3891                                 substitute ("Загружено (код, пароль);&1;&2"
     3892                                 , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)))
     3893                                 skip.
     3894                             end .
     3895                           end .
     3896                           else if locked buf_staff then
     3897                             do :
     3898                               v-count-decline = v-count-decline + 1 .
     3899                               put stream lsOUT unformatted
     3900                                 substitute ("Отвергнуто (код, пароль);&1;&2;запись кассира занята другим пользователем в вер.16"
     3901                                 , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)))
     3902                                 skip.
     3903                             end .
     3904                             else
     3905                             do :
     3906                               v-count-decline = v-count-decline + 1 .
     3907                               put stream lsOUT unformatted
     3908                                 substitute ("Отвергнуто (код, пароль);&1;&2;запись кассира кто-то уже удалил в вер.16"
     3909                                 , tt-cash-passwd.staff-code, fill("*",length(tt-cash-passwd.password)))
     3910                                 skip.
     3911                             end .
     3912                         end .
     3913                     end .
     3914                     vok = yes.
     3915                     define variable Msg as character no-undo .
     3916                     catch exAppErrors as class Progress.Lang.AppError :
     3917                       Msg = exAppErrors:ReturnValue .
     3918                       if Msg > "" then .
     3919                       else
     3920                       do :
     3921                         Msg = exAppErrors:GetMessage(1) .
     3922                         if Msg > "" then .
     3923                         else Msg = "AppError в фирмах" .
     3924                       end .
     3925                       put-log ( string(now) +  "   AppError " + Msg) .
     3926                     end catch .
     3927                     catch exProErrors as class Progress.Lang.ProError :
     3928                       Msg = exProErrors:GetMessage(1) .
     3929                       if Msg > "" then .
     3930                       else Msg = "ProError в фирмах" .
     3931                       put-log ( string(now) +  "   ProError " + Msg) .
     3932                     end catch .
     3933                     catch exAnyErrors as class Progress.Lang.Error:
     3934                       Msg = "Unexpected error в фирмах" .
     3935                       put-log ( string(now) +  "   LangError " + Msg) .
     3936                     end catch .
     3937                     finally:
     3938                       if not mDebug then
     3939                       do:
     3940                         os-delete value("cashp-temp.json") .
     3941                         os-delete value("cashp.json") .
     3942                       end.
     3943                       output STREAM lsIN close.
     3944                       output STREAM lsOUT close.
     3945                       if vok then
     3946                         put-log( string( now) +
     3947                           substitute("   Пароли кассиров загружены. Загружено &1 записей, отвергнуто &2 записей.",
     3948                           v-count-confirm, v-count-decline
     3949                           )
     3950                           ) .
     3951                       else
     3952                         put-log( string( now) + "   Пароли кассиров не загружены!") .
     3953                       put-log("").
     3954                       return vok.
     3955                     end finally.
     3956                   end method .
     3957                   method public character  cangecash (input pcashlist as character ):
     3958                     define variable v-rid-list as character no-undo.
     3959                     define variable ii         as integer   no-undo .
     3960                     define buffer buf_cash-desk for ub.cash-desk.
     3961                     run ref/cashlist.w (input parparentproc
     3962                       ,input "b-sel,b-mark"
     3963                       ,input 'объект':U
     3964                       ,input v-cntxt-db-num
     3965                       ,input v-host-code
     3966                       ,input obj-type
     3967                       ,input obj-code
     3968                       ,input ?
     3969                       ,output v-rid-list) no-error.
     3970                     if error-status:error
     3971                       or v-rid-list = '':U then
     3972                     do:
     3973                       return error.
     3974                     end.
     3975                     do ii = 1 to num-entries(v-rid-list):
     3976                       find first buf_cash-desk no-lock where
     3977                         recid(buf_cash-desk) = integer(entry(ii, v-rid-list)) no-error .
     3978                       if available buf_cash-desk then
     3979                       do:
     3980                         if lookup(string(buf_cash-desk.cash-num),pcashlist) eq 0
     3981                           then
     3982                           pcashlist = pcashlist + "," + string(buf_cash-desk.cash-num).
     3983                       end.
     3984                     end.
     3985                     pcashlist = trim(pcashlist,",").
     3986                     return pcashlist.
     3987                   end method.
     3988                   method public logical  sendcleanCash (input pcashlist as character ):
     3989                     define variable vi       as integer   no-undo.
     3990                     define variable vreclist as character no-undo.
     3991                     define buffer buf_cash-desk for ub.cash-desk.
     3992                     put-log("Начинаем отправку команды 'резервного копирования базы кассы и удаления всех чеков' на кассы ").
     3993                     do vi = 1 to num-entries(pcashlist):
     3994                       find first buf_cash-desk no-lock where
     3995                         buf_cash-desk.db-num   eq v-cntxt-db-num
     3996                         and buf_cash-desk.obj-code eq obj-code
     3997                         and buf_cash-desk.pos-type eq 'IBM-XML':U
     3998                         and buf_cash-desk.cash-num = integer(entry(vi, pcashlist)) no-error .
     3999                       if available buf_cash-desk
     4000                         then
     4001                       do:
     4002                         if buf_cash-desk.cash-on  = yes
     4003                           then
     4004                           vreclist = vreclist + "," + string(recid(buf_cash-desk)).
     4005                         else
     4006                           put-log("Касса с номером '" + entry(vi, pcashlist) + "' выключена. Касса будет пропущена.").
     4007                       end.
     4008                       else
     4009                         put-log("Не найдена касса с номером '" + entry(vi, pcashlist) + "'. Касса будет пропущена.").
     4010                     end.
     4011                     vreclist = trim(vreclist,",").
     4012                     run utl/sendcode.p(this-object,15,vreclist).
     4013                     put-log("").
     4014                     return yes.
     4015                   end method.
     4016                 end class.
