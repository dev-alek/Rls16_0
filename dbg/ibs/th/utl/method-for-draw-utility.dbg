       49   method private void nozzleav(
       50   parobj-type    like ub.clients.obj-type,
       51   parobj-code    like ub.clients.obj-code,
       52   parnozzle-code like ub.nozzle.nozzle-code
       53   ):
       54   define buffer bf_clients for ub.clients.
       55   define buffer bf_nozzle  for ub.nozzle.
       56   find first bf_clients where bf_clients.obj-type = parobj-type and
       57                               bf_clients.obj-code = parobj-code no-lock no-error.
       58   if not available bf_clients then
       59      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
       60   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
       61                              bf_nozzle.obj-code    = parobj-code    and
       62                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
       63   if available bf_nozzle then
       64                return error SUBSTITUTE("Уже есть пистолет с номером &1", parnozzle-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
       65   create bf_nozzle.
       66   assign bf_nozzle.obj-type    = parobj-type
       67          bf_nozzle.obj-code    = parobj-code
       68          bf_nozzle.nozzle-code = parnozzle-code.
       69   end. // procedure/method
       70   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   method private logical nzpl-spl
       72   (input p-obj-type as character
       73                                   , input p-obj-code as integer):
       74   define variable v-dopi    as integer no-undo .
       75   define variable v-param-type as character no-undo .
       76   define variable v-value-character as character no-undo .
       77   define variable v-value-date as date no-undo .
       78   define variable v-value-decimal as decimal no-undo .
       79   define variable v-value-integer as integer no-undo .
       80   define variable v-value-logical as logical no-undo .
       81   define variable v-tth as handle no-undo .
       82   define variable dflt-cd as character no-undo .
       83   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define variable v-param-type4 as character no-undo .
       85   define variable v-value-date4 as date no-undo .
       86   define variable v-value-decimal4 as decimal no-undo .
       87   define variable v-value-integer4 as INTEGER no-undo .
       88   define variable v-value-logical4 AS LOGICAL no-undo .
       89   define variable v-tth4 as handle no-undo .
       90   run adm/shattri.p (
       91       input "get":U
       92       ,input  p-obj-type
       93       ,input  p-obj-code
       94       ,input  'cd-sending':U
       95       ,input  'dflt-cd':U
       96       ,output dflt-cd
       97       ,output v-value-date4
       98       ,output v-value-decimal4
       99       ,output v-value-integer4
      100       ,output v-value-logical4
      101       ,output v-param-type4
      102       ,INPUT-OUTPUT table-handle v-tth4
      103       ) no-error .
      104   delete object v-tth4 no-error.
      105   if dflt-cd <> 'IBM':U
      106   and dflt-cd <> 'IBM-XML':U then return no.
      107   if dflt-cd = 'IBM-XML':U then return yes.
      108   run adm/shattri.p (
      109       input "get":U
      110       ,input  p-obj-type
      111       ,input  p-obj-code
      112       ,input  'cd-type-ibm':U
      113       ,input  'ibmspool':U
      114       ,output v-value-character
      115       ,output v-value-date
      116       ,output v-value-decimal
      117       ,output v-value-integer
      118       ,output v-value-logical
      119       ,output v-param-type
      120       ,INPUT-OUTPUT table-handle v-tth
      121       ) no-error .
      122   if error-status:error then do:
      123     delete object v-tth.
      124     return no.
      125   end.
      126   delete object v-tth.
      127   assign
      128   v-dopi = v-value-integer no-error .
      129   if v-dopi >= 6 then return yes.
      130   end. // FUNCTION/method
      131   method private logical nzpl-two
      132                                    (input p-obj-type as character
      133                                     , input p-obj-code as integer):
      134     define variable v-nzpl-two as logical no-undo.
      135     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      136     return v-nzpl-two.
      137   end. // FUNCTION/method
      138   method private void nzpl-two-proc
      139   ( input p-obj-type   as character,
      140     input p-obj-code   as integer ,
      141     output varge-two-pl as logical
      142   ):
      143   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      144   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      145   //do on error undo, return error return-value :
      146   assign
      147     varge-two-pl = no.
      148   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      149                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      150                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      151     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      152                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      153                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      154                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      155                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      156                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      157     if available bf-other_pl-gds-pump then do:
      158       assign
      159         varge-two-pl = yes.
      160       leave.
      161     end.
      162   end.
      163   //end.
      164   end. // procedure/method .
      165   method private void cplgdspm
      166   ( parobj-type  like ub.pl-gds-pump.obj-type ,
      167     parobj-code  like ub.pl-gds-pump.obj-code ,
      168     parpl-code   like ub.pl-gds-pump.pl-code  ,
      169     pargds-code  like ub.pl-gds-pump.gds-code ,
      170     parpump-code like ub.pl-gds-pump.pump-code,
      171     parstatus    like ub.pl-gds-pump.status_  ):
      172       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      173       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      174       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      175       define buffer bf-place                for ub.place.
      176       if parstatus = 'тек':U then do:
      177         for each bf_pl-gds-pump no-lock
      178           where bf_pl-gds-pump.obj-type  =  parobj-type
      179             and bf_pl-gds-pump.obj-code  =  parobj-code
      180             and bf_pl-gds-pump.gds-code  =  pargds-code
      181             and bf_pl-gds-pump.pump-code =  parpump-code
      182             and bf_pl-gds-pump.pl-code   <> parpl-code
      183             and bf_pl-gds-pump.status_   =  'тек':U
      184         on error undo, return error
      185         :
      186           find first place where
      187                      place.obj-type = parobj-type
      188                  and place.obj-code = parobj-code
      189                  and place.pl-code  = parpl-code
      190                no-lock no-error.
      191           find first bf-place where
      192                      bf-place.obj-type = parobj-type
      193                  and bf-place.obj-code = parobj-code
      194                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      195                no-lock no-error.
      196           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      197             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      198                                        ,parobj-type
      199                                        ,parobj-code
      200                                        ,if available place then place.loc1 else string(parpl-code)
      201                                        ,pargds-code
      202                                        ,parpump-code
      203                                        ,parstatus
      204                                        ,chr(10)
      205                                       )
      206                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      207                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      208                                     ).
      209           end.
      210           else do:
      211             find first bf_pl-pump-nozzle no-lock
      212               where bf_pl-pump-nozzle.obj-type  = parobj-type
      213                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      214                 and bf_pl-pump-nozzle.pump-code = parpump-code
      215                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      216               no-error.
      217             if available bf_pl-pump-nozzle then do:
      218               find first bf-other_pl-pump-nozzle no-lock
      219                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      220                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      221                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      222                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      223                 no-error.
      224               if available bf-other_pl-pump-nozzle
      225                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      226               then do:
      227                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      228                                          ,parobj-type
      229                                          ,parobj-code
      230                                          ,if available place then place.loc1 else string(parpl-code)
      231                                          ,pargds-code
      232                                          ,parpump-code
      233                                          ,parstatus
      234                                          ,chr(10)
      235                                        )
      236                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      237                                           ,bf_pl-gds-pump.obj-type
      238                                           ,bf_pl-gds-pump.obj-code
      239                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      240                                           ,bf_pl-gds-pump.status_
      241                                         ).
      242               end.
      243             end.
      244           end.
      245         end.
      246       end.
      247   end . // procedure/method
      248   method private void getAttrLib ():
      249      define variable g#attr-lib  as handle no-undo .
      250      run gbl/getgattrlib.p (output g#attr-lib).
      251   end.
      252               define variable g#language as character no-undo init "rus".
      253   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   method private void doc-code (
      255                                 parmode          as   character,
      256                                 parobj-type      like ub.clients.obj-type,
      257                                 parobj-code      like ub.clients.obj-code,
      258                                 parroot-doc-code like ub.trn-doc.doc-code,
      259                      output     pardoc-code      like ub.trn-doc.doc-code
      260   ):
      261   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      262   define variable vardb-remote     as   logical             no-undo.
      263   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      264   define variable v-delimiter as character no-undo .
      265   do
      266   :
      267   find first buf_sys-ctrl no-lock .
      268   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      269     CASE parmode:
      270       when "main":u then do:
      271         if vardb-remote then do:
      272           assign
      273             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      274         end.
      275         else do:
      276           assign
      277             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      278         end.
      279       end.
      280       when "trio" then do:
      281         assign
      282           pardoc-code = replace (parroot-doc-code, "=", "*").
      283       end.
      284       otherwise do:
      285         assign
      286         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      287         no-error
      288         .
      289         if error-status:error  then do:
      290           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      291                                         ,chr(10)
      292                                         ,parmode
      293                                         ).
      294         end.
      295         if num-entries(parmode) = 1
      296         and parmode <> "chip":U
      297         and parmode <> "chip_s":U
      298         then do:
      299           assign
      300           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      301         end.
      302         else if (lookup("chip":U, parmode) > 0
      303                  or
      304                  lookup("chip_s":U, parmode) > 0) then do:
      305           assign
      306             vartemp-doc-code = parroot-doc-code.
      307           do while true:
      308             if index (vartemp-doc-code , ".") = 0 then
      309               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      310             else
      311               vartemp-doc-code  =
      312               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      313               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      314               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      315             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      316           end.
      317           assign
      318             pardoc-code = vartemp-doc-code.
      319         end.
      320       end.
      321     end CASE.
      322     if pardoc-code = '':U
      323     or (parroot-doc-code <> '':U
      324     and pardoc-code = parroot-doc-code) then do:
      325       undo, return error substitute("Ошибка при генерации номера документа&1"
      326                                     ,chr(10)).
      327     end.
      328   end.
      329   end. // procedure/method
      330   method private int64 get-doc-code-int64
      331     ( input p-doc-code as character ) :
      332     define variable v-ind              as integer   no-undo .
      333     define variable v-num-entries      as integer   no-undo .
      334     define variable v-doc-code-int64   as int64     no-undo .
      335     define variable v-canonic-doc-code as character no-undo .
      336     assign
      337       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      338       v-canonic-doc-code = p-doc-code
      339     .
      340     do v-ind = 1 to v-num-entries
      341     :
      342       assign
      343         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      344       .
      345     end.
      346     assign
      347       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      348     .
      349     return v-doc-code-int64 .
      350   end. // function/method
