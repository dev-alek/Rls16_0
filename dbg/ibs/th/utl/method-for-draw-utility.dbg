      607                   define public property version-name as character
      608                     get:
      609                       return if available tt-version then tt-version.version-name else "15.X".
      610                     end.
      611                   define variable mJsonObj      as JsonObject        no-undo.
      612                   define variable mParser       as ObjectModelParser no-undo.
      613                   define variable results-array as JsonArray         no-undo.
      614                   define variable myResultObj   as JsonObject        no-undo.
