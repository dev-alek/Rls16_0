       24       (output v-cntxt-db-num
       25       ,output v-cntxt-userid
       26       ,output v-cntxt-level
       27       ,output v-cntxt-host-code-obj
       28       ,output v-cntxt-obj-type
       29       ,output v-cntxt-obj-code
       30       ,output v-cntxt-db-num-obj
       31       ,output v-cntxt-is-admin
       32       ) .
       33   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       34   run hostcode in ibs.th.gbl.gbl-hndllib:g#library
       35     (input  v-cntxt-obj-type
       36     ,input  v-cntxt-obj-code
