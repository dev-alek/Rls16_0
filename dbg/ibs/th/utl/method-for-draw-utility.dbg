      617                   define stream lsOUT.
      618                   constructor public method-for-draw-utility (  ):
      619                     super ().
      620                     mplacelib = new ibs.th.str.placelib().
      621                     mParser = new ObjectModelParser().
      622                     mDebug = session:debug-alert.
      623                   end constructor.
      624                   destructor public method-for-draw-utility ( ):
      625                     delete object mJsonObj no-error.
      626                     delete object mParser  no-error.
      627                     delete object mplacelib.
      628                   end destructor.
      629                   define public event write-log
      630                     signature void ( input pcCustName as character ).
      631                   method public void put-log (iText as character ):
      632                     put-log-all(Itext).
      633                     publish "write-log" from parparentproc (Itext ).
      634                     write-log:PUBLISH (iText).
      635                   end method.
      636                   method public void put-err-log (iText as character ):
      637                     publish "write-log-err" from parparentproc (Itext ).
      638                     put-log-all(Itext).
      639                   end method.
      640                   method public void put-log-all(itext as char):
      641                     output to value(substitute("&1darw_util_&2.log", ibs.th.gbl.gbl-inipar:logDir,v-cntxt-obj-code)) append.
      642                     if itext = ""
      643                       then
      644                       put unformatted skip(1) .
      645                     else
      646                       put unformatted itext skip .
      647                     output close.
      648                   end.
      649                   method public void put-log-allerr(itext as char):
      650                     output to value(substitute("&1darw_util_&2.err", ibs.th.gbl.gbl-inipar:logDir,v-cntxt-obj-code)) append.
      651                     if itext = ""
      652                       then
      653                       put unformatted skip(1) .
      654                     else
      655                       put unformatted itext skip .
      656                     output close.
      657                   end.
      658                   method private void pumpav(
      659                     parobj-type  like ub.clients.obj-type,
      660                     parobj-code  like ub.clients.obj-code,
      661                     parpump-code like ub.pump.pump-code
      662                     ):
      663                     define buffer bf_clients for ub.clients.
      664                     define buffer bf_pump    for ub.pump.
      665   find first bf_clients where bf_clients.obj-type = parobj-type and
      666                               bf_clients.obj-code = parobj-code no-lock no-error.
      667   if not available bf_clients then
      668      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      669                     find first bf_pump no-lock
      670                       where bf_pump.obj-type  = parobj-type
      671                       and bf_pump.obj-code  = parobj-code
      672                       and bf_pump.pump-code = parpump-code
      673                       no-error.
      674                     if available bf_pump then
      675                     do:
      676                       put-log(substitute("Уже есть ТРК с номером &1", parpump-code) +  "").
      677                       return error substitute("Уже есть ТРК с номером &1", parpump-code) .
      678                     end.
      679                     create bf_pump.
      680                     assign
      681                       bf_pump.obj-type  = parobj-type
      682                       bf_pump.obj-code  = parobj-code
      683                       bf_pump.pump-code = parpump-code
      684                       .
      685                   end method.
      686                   method private void pumpnzav(
      687                     parobj-type    like ub.clients.obj-type,
      688                     parobj-code    like ub.clients.obj-code,
      689                     parpump-code   like ub.pump.pump-code,
      690                     parnozzle-code like ub.nozzle.nozzle-code,
      691                     paris-meas     like ub.pump-nozzle.is-meas,
      692                     paref-nid      like ub.pump-nozzle.ef-nid
      693                     ):
      694                     define buffer bf_clients     for ub.clients.
      695                     define buffer bf_pump        for ub.pump.
      696                     define buffer bf_nozzle      for ub.nozzle.
      697                     define buffer bf_pump-nozzle for ub.pump-nozzle.
      698                     define buffer bf_rvs-doc     for ub.rvs-doc.
      699                     define buffer bf_icnt-doc    for ub.icnt-doc.
      700   find first bf_clients where bf_clients.obj-type = parobj-type and
      701                               bf_clients.obj-code = parobj-code no-lock no-error.
      702   if not available bf_clients then
      703      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      704   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      705                            bf_pump.obj-code  = parobj-code  and
      706                            bf_pump.pump-code = parpump-code no-lock no-error.
      707   if not available bf_pump then
      708      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) .
      709   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      710                              bf_nozzle.obj-code    = parobj-code    and
      711                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      712   if not available bf_nozzle then
      713      return error SUBSTITUTE("Нет пистолета ТРК с номером &1", parnozzle-code) .
      714    find first bf_rvs-doc where bf_rvs-doc.obj-type =  parobj-type       and
      715                                bf_rvs-doc.obj-code =  parobj-code       and
      716                                bf_rvs-doc.status_  <> 'факт':U           and
      717                                bf_rvs-doc.rvs-type <> 'перед_док':U and
      718                                bf_rvs-doc.rvs-type <> 'после_док':U  and
      719                                bf_rvs-doc.rvs-type <> 'проверка':U       no-lock no-error.
      720   if available bf_rvs-doc then do:
      721      return error SUBSTITUTE("На объекте есть открытый документ сверки &1 .", bf_rvs-doc.rvs-code).
      722   end.
      723   find first bf_icnt-doc where bf_icnt-doc.obj-type  =  parobj-type and
      724                                bf_icnt-doc.obj-code  =  parobj-code and
      725                                bf_icnt-doc.status_   <> 'факт':U     no-lock no-error.
      726   if available bf_icnt-doc then do:
      727      return error SUBSTITUTE("На объекте есть открытый документ инвентаризации счетчиков ТРК &1 .", bf_icnt-doc.doc-code).
      728   end.
      729                     find first bf_pump-nozzle where bf_pump-nozzle.obj-type    = parobj-type    and
      730                       bf_pump-nozzle.obj-code    = parobj-code    and
      731                       bf_pump-nozzle.pump-code   = parpump-code   and
      732                       bf_pump-nozzle.nozzle-code = parnozzle-code no-lock no-error.
      733                     if available bf_pump-nozzle then
      734                     do:
      735                       put-log(substitute ("Уже есть запись ТРК-пистолет с номером ТРК &1 и номером пистолета &2", parpump-code, parnozzle-code) + " " + "").
      736                       return error substitute ("Уже есть запись ТРК-пистолет с номером ТРК &1 и номером пистолета &2", parpump-code, parnozzle-code) .
      737                     end.
      738                     create bf_pump-nozzle.
      739                     assign
      740                       bf_pump-nozzle.obj-type    = parobj-type
      741                       bf_pump-nozzle.obj-code    = parobj-code
      742                       bf_pump-nozzle.pump-code   = parpump-code
      743                       bf_pump-nozzle.nozzle-code = parnozzle-code
      744                       bf_pump-nozzle.is-meas     = paris-meas
      745                       bf_pump-nozzle.ef-nid      = paref-nid
      746                       .
      747                   end method.
      748                   method private void plpumpav(
      749                     parobj-type  like ub.clients.obj-type,
      750                     parobj-code  like ub.clients.obj-code,
      751                     parpl-code   like ub.place.pl-code,
      752                     parpump-code like ub.pump.pump-code
      753                     ):
      754                     define buffer bf_clients           for ub.clients.
      755                     define buffer bf_pump              for ub.pump.
      756                     define buffer bf_place             for ub.place.
      757                     define buffer bf_pl-pump           for ub.pl-pump.
      758                     define buffer bf_pl-gds            for ub.pl-gds.
      759                     define buffer bf_goods             for ub.goods.
      760                     define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      761                     define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      762                     define variable varstatus as character no-undo.
      763   find first bf_clients where bf_clients.obj-type = parobj-type and
      764                               bf_clients.obj-code = parobj-code no-lock no-error.
      765   if not available bf_clients then
      766      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      767   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      768                            bf_pump.obj-code  = parobj-code  and
      769                            bf_pump.pump-code = parpump-code no-lock no-error.
      770   if not available bf_pump then
      771      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) .
      772   find first bf_place where bf_place.obj-type = parobj-type and
      773                             bf_place.obj-code = parobj-code and
      774                             bf_place.pl-code  = parpl-code  no-lock no-error.
      775   if not available bf_place then return error SUBSTITUTE("Нет такого складского места &1", parpl-code) .
      776                     find first bf_pl-pump no-lock
      777                       where bf_pl-pump.obj-type   = parobj-type
      778                       and bf_pl-pump.obj-code   = parobj-code
      779                       and bf_pl-pump.pl-code    = parpl-code
      780                       and bf_pl-pump.pump-code  = parpump-code
      781                       no-error.
      782                     if available bf_pl-pump then
      783                     do:
      784                       put-log(substitute("Уже есть запись резервуар-ТРК с номером резервуара &1 и номером ТРК &2", parpl-code, parpump-code) + " " + "").
      785                       return error substitute("Уже есть запись резервуар-ТРК с номером резервуара &1 и номером ТРК &2", parpl-code, parpump-code) .
      786                     end.
      787                     find first bf_pl-gds no-lock
      788                       where bf_pl-gds.obj-type = parobj-type
      789                       and bf_pl-gds.obj-code = parobj-code
      790                       and bf_pl-gds.pl-code  = parpl-code
      791                       no-error.
      792                     tr:
      793                     do transaction
      794                       on error undo tr, return error return-value
      795                       :
      796                       if available bf_pl-gds then
      797                       do:
      798                         find first bf_goods no-lock
      799                           where bf_goods.gds-code = bf_pl-gds.gds-code
      800                           .
      801                         assign
      802                           varstatus = 'тек':U
      803                           .
      804                         find first bf-other_pl-gds-pump no-lock
      805                           where bf-other_pl-gds-pump.obj-type  = parobj-type
      806                           and bf-other_pl-gds-pump.obj-code  = parobj-code
      807                           and bf-other_pl-gds-pump.gds-code  = bf_goods.gds-code
      808                           and bf-other_pl-gds-pump.pump-code = parpump-code
      809                           and bf-other_pl-gds-pump.status_   = 'тек':U
      810                           no-error.
      811                         if available bf-other_pl-gds-pump
      812                           and nzpl-spl(bf-other_pl-gds-pump.obj-type, bf-other_pl-gds-pump.obj-code) <> yes
      813                           then
      814                         do:
      815                           assign
      816                             varstatus = 'блок':U
      817                             .
      818                         end.
      819                         create bf_pl-gds-pump.
      820                         assign
      821                           bf_pl-gds-pump.obj-type  = parobj-type
      822                           bf_pl-gds-pump.obj-code  = parobj-code
      823                           bf_pl-gds-pump.pl-code   = parpl-code
      824                           bf_pl-gds-pump.gds-code  = bf_goods.gds-code
      825                           bf_pl-gds-pump.pump-code = parpump-code
      826                           bf_pl-gds-pump.status_   = varstatus
      827                           .
      828                         cplgdspm
      829                           ( input bf_pl-gds-pump.obj-type
      830                           ,input bf_pl-gds-pump.obj-code
      831                           ,input bf_pl-gds-pump.pl-code
      832                           ,input bf_pl-gds-pump.gds-code
      833                           ,input bf_pl-gds-pump.pump-code
      834                           ,input bf_pl-gds-pump.status_
      835                           ) no-error.
      836                         if error-status:error then
      837                         do:
      838                           put-log(substitute ("Ошибка при смене статуса записи резервуар-ТРК-пистолет: &1 &2.", return-value, error-status:get-message(1))).
      839                           undo tr, return error substitute ("Ошибка при смене статуса записи резервуар-ТРК-пистолет: &1 &2.", return-value, error-status:get-message(1)).
      840                         end.
      841                       end.
      842                       create bf_pl-pump.
      843                       assign
      844                         bf_pl-pump.obj-type  = parobj-type
      845                         bf_pl-pump.obj-code  = parobj-code
      846                         bf_pl-pump.pl-code   = parpl-code
      847                         bf_pl-pump.pump-code = parpump-code
      848                         .
      849                     end.
      850                   end method.
      851                   method private void plpmnzav(
      852                     parobj-type    like ub.clients.obj-type  ,
      853                     parobj-code    like ub.clients.obj-code  ,
      854                     parpl-code     like ub.place.pl-code     ,
      855                     parpump-code   like ub.pump.pump-code    ,
      856                     parnozzle-code like ub.nozzle.nozzle-code
      857                     ):
      858                     define buffer bf_clients              for ub.clients.
      859                     define buffer bf_place                for ub.place.
      860                     define buffer bf_pump                 for ub.pump.
      861                     define buffer bf_nozzle               for ub.nozzle.
      862                     define buffer bf_pl-pump              for ub.pl-pump.
      863                     define buffer bf_pump-nozzle          for ub.pump-nozzle.
      864                     define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      865                     define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      866                     define buffer bf_rvs-doc              for ub.rvs-doc.
      867                     define buffer bf_icnt-doc             for ub.icnt-doc.
      868                     define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      869                     define buffer bf-other_pl-gds-pump    for ub.pl-gds-pump.
      870   find first bf_clients where bf_clients.obj-type = parobj-type and
      871                               bf_clients.obj-code = parobj-code no-lock no-error.
      872   if not available bf_clients then
      873      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      874   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      875                            bf_pump.obj-code  = parobj-code  and
      876                            bf_pump.pump-code = parpump-code no-lock no-error.
      877   if not available bf_pump then
      878      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) .
      879   find first bf_place where bf_place.obj-type = parobj-type and
      880                             bf_place.obj-code = parobj-code and
      881                             bf_place.pl-code  = parpl-code  no-lock no-error.
      882   if not available bf_place then return error SUBSTITUTE("Нет такого складского места &1", parpl-code) .
      883   find first bf_nozzle where bf_nozzle.obj-type    = parobj-type    and
      884                              bf_nozzle.obj-code    = parobj-code    and
      885                              bf_nozzle.nozzle-code = parnozzle-code no-lock no-error.
      886   if not available bf_nozzle then
      887      return error SUBSTITUTE("Нет пистолета ТРК с номером &1", parnozzle-code) .
      888   find first bf_pl-pump where bf_pl-pump.obj-type  = parobj-type  and
      889                               bf_pl-pump.obj-code  = parobj-code  and
      890                               bf_pl-pump.pl-code   = parpl-code   and
      891                               bf_pl-pump.pump-code = parpump-code no-lock no-error.
      892   if not available bf_pl-pump then
      893      return error SUBSTITUTE("Нет записи резервуар-ТРК с номером резервуара &1 и номером ТРК &2",
      894                              parpl-code, parpump-code) .
      895   find first bf_pump-nozzle where bf_pump-nozzle.obj-type    = parobj-type    and
      896                                   bf_pump-nozzle.obj-code    = parobj-code    and
      897                                   bf_pump-nozzle.pump-code   = parpump-code   and
      898                                   bf_pump-nozzle.nozzle-code = parnozzle-code no-lock no-error.
      899   if not available bf_pump-nozzle then
      900      return error SUBSTITUTE("Нет записи ТРК-пистолет с номером ТРК &1 и номером пистолета &2",
      901                                                           parpump-code,
      902                                                           parnozzle-code) .
      903    find first bf_rvs-doc where bf_rvs-doc.obj-type =  parobj-type       and
      904                                bf_rvs-doc.obj-code =  parobj-code       and
      905                                bf_rvs-doc.status_  <> 'факт':U           and
      906                                bf_rvs-doc.rvs-type <> 'перед_док':U and
      907                                bf_rvs-doc.rvs-type <> 'после_док':U  and
      908                                bf_rvs-doc.rvs-type <> 'проверка':U       no-lock no-error.
      909   if available bf_rvs-doc then do:
      910      return error SUBSTITUTE("На объекте есть открытый документ сверки &1 .", bf_rvs-doc.rvs-code).
      911   end.
      912   find first bf_icnt-doc where bf_icnt-doc.obj-type  =  parobj-type and
      913                                bf_icnt-doc.obj-code  =  parobj-code and
      914                                bf_icnt-doc.status_   <> 'факт':U     no-lock no-error.
      915   if available bf_icnt-doc then do:
      916      return error SUBSTITUTE("На объекте есть открытый документ инвентаризации счетчиков ТРК &1 .", bf_icnt-doc.doc-code).
      917   end.
      918                     do
      919                       on error undo, return error return-value
      920                       :
      921                       create bf_pl-pump-nozzle.
      922                       assign
      923                         bf_pl-pump-nozzle.obj-type    = parobj-type
      924                         bf_pl-pump-nozzle.obj-code    = parobj-code
      925                         bf_pl-pump-nozzle.pl-code     = parpl-code
      926                         bf_pl-pump-nozzle.pump-code   = parpump-code
      927                         bf_pl-pump-nozzle.nozzle-code = parnozzle-code
      928                         .
      929                     end.
      930                   end method.
      931   // перенос топологии
      932                   method public void load_schem (ifile-path as character):
      933                     load_schem(mAddr, ifile-path).
      934                   end.
      935                   method public void load_schem (iAddr as character, ifile-path as character ):
      936                     define variable v-rep-rec as recid     no-undo .
      937                     define variable v-ok      as logical   no-undo.
      938                     define variable VFlag     as logical   no-undo.
      939                     define variable cmd       as character no-undo.
      940                     put-log(string (now) + "   Отправляем запрос для получения топологии...").
      941                     load_gds_maping(ifile-path).
      942                     empty temp-table tt-gds-prod .
      943                     empty temp-table tt-place.
      944                     empty temp-table tt-place-attr.
      945                     empty temp-table tt-pump.
      946                     empty temp-table tt-nozzle.
      947                     empty temp-table tt-pl-pump.
      948                     empty temp-table tt-pump-nozzle.
      949                     empty temp-table tt-pl-pump-nozzle.
      950                     empty temp-table tt-pl-level.
      951                     empty temp-table tt-pl-gds.
      952                     empty temp-table tt-pl-gds-pump.
      953                     cmd = substitute ("&1 --http0.9 &2/THGetInfo?GetSchem >&3", search ("exe/curl.exe"), iAddr, "schem-temp.json").
      954                     os-command silent value (cmd).
      955                     put-log(string (now) + "   Разбираем полученные данные...").
      956                     fix-codepage_and_SetJsonObj (input "schem-temp.json") .
      957                     parse-json(input temp-table tt-place:default-buffer-handle, input "place") .
      958                     parse-json(input temp-table tt-place-attr:default-buffer-handle, input "place-attr") .
      959                     parse-json(input temp-table tt-pump:default-buffer-handle, input "pump") .
      960                     parse-json(input temp-table tt-nozzle:default-buffer-handle, input "nozzle") .
      961                     parse-json(input temp-table tt-pl-pump:default-buffer-handle, input "pl-pump") .
      962                     parse-json(input temp-table tt-pump-nozzle:default-buffer-handle, input "pump-nozzle") .
      963                     parse-json(input temp-table tt-pl-pump-nozzle:default-buffer-handle, input "pl-pump-nozzle") .
      964                     parse-json(input temp-table tt-pl-level:default-buffer-handle, input "pl-level") .
      965                     parse-json(input temp-table tt-pl-gds:default-buffer-handle, input "pl-gds") .
      966                     parse-json(input temp-table tt-pl-gds-pump:default-buffer-handle, input "pl-gds-pump") .
      967                     parse-json(input temp-table tt-gds-prod:default-buffer-handle, input "tt-gds-prod") .
      968     //  delete object myResultObj no-error.
      969     //delete object results-array no-error.
      970                     for each tt-gds-prod no-lock :
      971                       find first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-gds-prod.gds-code no-error .
      972                       if not available tt-gds-mapping
      973                         then
      974                       do :
      975                         put-log(("В файле соответсвий нет топлива " + string(tt-gds-prod.gds-code) + " с коротким кодом " + tt-gds-prod.b-str)).
      976                         undo, return error ("В файле соответсвий нет топлива " + string(tt-gds-prod.gds-code) + " с коротким кодом " + tt-gds-prod.b-str) .
      977                       end.
      978                       find first ub.goods no-lock where ub.goods.gds-code = tt-gds-mapping.gds-code16 no-error.
      979                       if not available ub.goods
      980                         then
      981                       do :
      982                         put-log(("Нет топлива с кодом " + string(tt-gds-mapping.gds-code16) + " . Код в v" + string(version-name) +  " - " + string(tt-gds-mapping.gds-code15)) ).
      983                         undo, return error ("Нет топлива с кодом " + string(tt-gds-mapping.gds-code16) + " . Код в v" + string(version-name) +  " - " + string(tt-gds-mapping.gds-code15)) .
      984                       end.
      985                       else
      986                       do:
      987                         find first ub.prod-bc no-lock where ub.prod-bc.b-code = ub.goods.gds-code and ub.prod-bc.b-str = tt-gds-prod.b-str no-error .
      988                         if not available (ub.prod-bc) then
      989                         do:
      990                           create ub.prod-bc.
      991                           assign
      992                             ub.prod-bc.b-code     = ub.goods.gds-code
      993                             ub.prod-bc.b-str      = tt-gds-prod.b-str
      994                             ub.prod-bc.bc-on      = true
      995                             ub.prod-bc.bc-on-type = tt-gds-prod.bc-on-type
      996                             ub.prod-bc.cr-db-num  = v-cntxt-db-num-obj
      997                             .
      998                         end.
      999                       end.
     1000                     end.
     1001                     put-log(string (now) + "   Начинаем загрузку топологии...").
     1002                     for each tt-pump no-lock :
     1003                       put-log("ТРК №" + string(tt-pump.pump-code)).
     1004                       pumpav
     1005                         ( input v-cntxt-obj-type
     1006                         ,input v-cntxt-obj-code
     1007                         ,input tt-pump.pump-code
     1008                         ) no-error.
     1009                       if error-status:error then
     1010                       do:
     1011                         put-Log(return-value).
     1012                         undo, return error return-value.
     1013                       end.
     1014                     end.
     1015                     for each tt-nozzle no-lock :
     1016                       put-log( "Пистолет №" + string(tt-nozzle.nozzle-code)).
     1017                       nozzleav (input v-cntxt-obj-type,
     1018                         v-cntxt-obj-code,
     1019                         tt-nozzle.nozzle-code) no-error.
     1020                       if error-status:error then
     1021                       do:
     1022                         put-Log(return-value).
     1023                         undo, return error return-value.
     1024                       end.
     1025                     end.
     1026                     for each tt-pump-nozzle no-lock :
     1027                       put-log( "Связка ТРК-Пистолет №" + string(tt-pump-nozzle.pump-code) +  "-" +  string(tt-pump-nozzle.nozzle-code)) .
     1028                       pumpnzav( input v-cntxt-obj-type
     1029                         ,input v-cntxt-obj-code
     1030                         ,input tt-pump-nozzle.pump-code
     1031                         ,input tt-pump-nozzle.nozzle-code
     1032                         ,input tt-pump-nozzle.is-meas
     1033                         ,input ""
     1034                         ) no-error.
     1035                       if error-status:error then
     1036                       do:
     1037                         put-Log(return-value).
     1038                         undo, return error return-value.
     1039                       end.
     1040                     end.
     1041                     for each tt-place no-lock :
     1042                       if tt-place.status_ = "удал" then next .
     1043                       put-log( "Резервуар координата1 " + string(tt-place.loc1)) .
     1044                       run ref/place01.p
     1045                         ( input-output v-rep-rec
     1046                         , input 'ДОБАВЛЕНИЕ':U
     1047                         , input yes
     1048                         , input v-cntxt-obj-type
     1049                         , input v-cntxt-obj-code
     1050                         , input 0
     1051                         , input tt-place.loc1
     1052                         , input tt-place.loc2
     1053                         , input tt-place.loc3
     1054                         , input tt-place.loc4
     1055                         , input tt-place.pl-name
     1056                         , input tt-place.ps
     1057                         , input tt-place.add-qnty
     1058                         , input tt-place.is-meas
     1059                         , input tt-place.max-qnty
     1060                         , input tt-place.issue-year
     1061                         , input tt-place.start-date
     1062                         , input no
     1063                         ) no-error.
     1064                       if error-status:error then
     1065                       do:
     1066                         put-Log(return-value).
     1067                         undo, return error return-value.
     1068                       end.
     1069                       find first ub.place no-lock where recid(ub.place) = v-rep-rec .
     1070                       for each tt-place-attr no-lock where tt-place-attr.obj-type = tt-place.obj-type
     1071                         and tt-place-attr.obj-code = tt-place.obj-code
     1072                         and tt-place-attr.pl-code  = tt-place.pl-code :
     1073                         mplacelib:placelib_write-attr
     1074                           (input tt-place-attr.attr-code
     1075                           ,input v-cntxt-obj-code
     1076                           ,input v-cntxt-obj-type
     1077                           ,input ub.place.pl-code
     1078                           ,input tt-place-attr.attr-value
     1079                           ,output v-ok      )
     1080                           no-error.
     1081                         if error-status:error then
     1082                         do:
     1083                           put-Log(return-value).
     1084                           undo, return error return-value.
     1085                         end.
     1086                       end.
     1087                       find first ub.place-attr no-lock where ub.place-attr.obj-type = v-cntxt-obj-type
     1088                         and ub.place-attr.obj-code = v-cntxt-obj-code
     1089                         and ub.place-attr.pl-code  = ub.place.pl-code
     1090                         and ub.place-attr.attr-code = "place-error-mass"
     1091                         no-error .
     1092                       if not available ub.place-attr
     1093                         then
     1094                       do :
     1095                         mplacelib:placelib_write-attr
     1096                           (input "place-error-mass"
     1097                           ,input v-cntxt-obj-code
     1098                           ,input v-cntxt-obj-type
     1099                           ,input ub.place.pl-code
     1100                           ,input string(0.15)
     1101                           ,output v-ok      )
     1102                           no-error.
     1103                         if error-status:error then
     1104                         do:
     1105                           put-Log(return-value).
     1106                           undo, return error return-value.
     1107                         end.
     1108                       end.
     1109                       find first ub.place-attr no-lock where ub.place-attr.obj-type = v-cntxt-obj-type
     1110                         and ub.place-attr.obj-code = v-cntxt-obj-code
     1111                         and ub.place-attr.pl-code  = ub.place.pl-code
     1112                         and ub.place-attr.attr-code = "place-local"
     1113                         no-error .
     1114                       if not available ub.place-attr
     1115                         then
     1116                       do :
     1117                         mplacelib:placelib_write-attr
     1118                           (input "place-local"
     1119                           ,input v-cntxt-obj-code
     1120                           ,input v-cntxt-obj-type
     1121                           ,input ub.place.pl-code
     1122                           ,input string(2)
     1123                           ,output v-ok      )
     1124                           no-error.
     1125                         if error-status:error then
     1126                         do:
     1127                           put-Log(return-value).
     1128                           undo, return error return-value.
     1129                         end.
     1130                       end.
     1131                       for each tt-pl-level no-lock where tt-pl-level.obj-type = tt-place.obj-type
     1132                         and tt-pl-level.obj-code = tt-place.obj-code
     1133                         and tt-pl-level.pl-code  = tt-place.pl-code :
     1134                         create ub.pl-level.
     1135                         assign
     1136                           ub.pl-level.obj-type = v-cntxt-obj-type
     1137                           ub.pl-level.obj-code = v-cntxt-obj-code
     1138                           ub.pl-level.pl-code  = ub.place.pl-code
     1139                           ub.pl-level.pl-level = tt-pl-level.pl-level
     1140                           ub.pl-level.pl-qnty  = tt-pl-level.pl-qnty
     1141                           .
     1142                       end.
     1143                       for each tt-pl-gds no-lock where tt-pl-gds.obj-type = tt-place.obj-type
     1144                         and tt-pl-gds.obj-code = tt-place.obj-code
     1145                         and tt-pl-gds.pl-code  = tt-place.pl-code,
     1146                         first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-pl-gds.gds-code  :
     1147                         run trg/plgdpmvc.p (
     1148                           input  v-cntxt-obj-type,
     1149                           input  v-cntxt-obj-code,
     1150                           input  ub.place.pl-code,
     1151                           input  tt-gds-mapping.gds-code16,
     1152                           output v-ok) no-error.
     1153                         if error-status:error then
     1154                         do:
     1155                           put-Log(return-value).
     1156                           undo, return error return-value.
     1157                         end.
     1158                         if not v-ok then
     1159                         do:
     1160                         end.
     1161                       end.
     1162                       for each tt-pl-pump no-lock where tt-pl-pump.obj-type   = tt-place.obj-type
     1163                         and tt-pl-pump.obj-code   = tt-place.obj-code
     1164                         and tt-pl-pump.pl-code    = tt-place.pl-code :
     1165                         put-log(  "Связка Резервуар-ТРК №" + string(ub.place.loc1) +  "-" + string(tt-pl-pump.pump-code) ) .
     1166                         plpumpav
     1167                           (input v-cntxt-obj-type,
     1168                           input v-cntxt-obj-code,
     1169                           input ub.place.pl-code,
     1170                           input tt-pl-pump.pump-code) no-error.
     1171                         if error-status:error then
     1172                         do:
     1173                           put-Log(return-value).
     1174                           undo, return error return-value.
     1175                         end.
     1176                       end.
     1177                       for each tt-pl-pump-nozzle no-lock where  tt-pl-pump-nozzle.obj-type   = tt-place.obj-type
     1178                         and tt-pl-pump-nozzle.obj-code   = tt-place.obj-code
     1179                         and tt-pl-pump-nozzle.pl-code    = tt-place.pl-code :
     1180                         put-log( "Связка Резервуар-ТРК-Пистолет №" + string(ub.place.loc1) + "-" +  string(tt-pl-pump-nozzle.pump-code) + "-" + string(tt-pl-pump-nozzle.nozzle-code)).
     1181                         plpmnzav
     1182                           ( input v-cntxt-obj-type
     1183                           ,input v-cntxt-obj-code
     1184                           ,input ub.place.pl-code
     1185                           ,input tt-pl-pump-nozzle.pump-code
     1186                           ,input tt-pl-pump-nozzle.nozzle-code
     1187                           ) no-error.
     1188                         if error-status:error then
     1189                         do:
     1190                           put-Log(return-value).
     1191                           undo, return error return-value.
     1192                         end.
     1193                       end.
     1194                       for each tt-pl-gds-pump where tt-pl-gds-pump.obj-type = tt-place.obj-type and
     1195                         tt-pl-gds-pump.obj-code = tt-place.obj-code and
     1196                         tt-pl-gds-pump.pl-code = tt-place.pl-code,
     1197                         first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-pl-gds-pump.gds-code :
     1198                         find first pl-gds-pump exclusive-lock where pl-gds-pump.obj-type = v-cntxt-obj-type
     1199                           and pl-gds-pump.obj-code = v-cntxt-obj-code
     1200                           and pl-gds-pump.pl-code  = ub.place.pl-code
     1201                           and pl-gds-pump.gds-code = tt-gds-mapping.gds-code16
     1202                           and pl-gds-pump.pump-code = tt-pl-gds-pump.pump-code
     1203                           no-error.
     1204                         if available pl-gds-pump
     1205                           then
     1206                         do :
     1207                           pl-gds-pump.status_ = tt-pl-gds-pump.status_ .
     1208                         end.
     1209                       end.
     1210                     end.
     1211                     vflag  = yes.
     1212                     finally:
     1213                       if not mDebug then
     1214                       do:
     1215                         os-delete value("schem-temp.json") .
     1216                         os-delete value("schem.json") .
     1217                       end.
     1218                       if vflag and Chek_Shem() then
     1219                         put-log( string(now) + "   Топология загружена!" ).
     1220                       else
     1221                         put-log( string(now) + "   Топология не загружена!" ).
     1222                     end finally.
     1223                   end method.
     1224                   method public logical Chek_Shem(
     1225                     ):
     1226                     define variable v-has-records as logical no-undo.
     1227                     for each ub.place no-lock where ub.place.obj-type = v-cntxt-obj-type
     1228                       and ub.place.obj-code = v-cntxt-obj-code :
     1229                       v-has-records = true .
     1230                       leave.
     1231                     end.
     1232                     if not v-has-records
     1233                       then
     1234                       for each ub.place-attr no-lock where ub.place-attr.obj-type = v-cntxt-obj-type
     1235                         and ub.place-attr.obj-code = v-cntxt-obj-code :
     1236                         v-has-records = true .
     1237                         leave.
     1238                       end.
     1239                     if not v-has-records
     1240                       then
     1241                       for each ub.pump no-lock where ub.pump.obj-type = v-cntxt-obj-type
     1242                         and ub.pump.obj-code = v-cntxt-obj-code :
     1243                         v-has-records = true .
     1244                         leave.
     1245                       end.
     1246                     if not v-has-records
     1247                       then
     1248                       for each ub.nozzle no-lock where ub.nozzle.obj-type = v-cntxt-obj-type
     1249                         and ub.nozzle.obj-code = v-cntxt-obj-code :
     1250                         v-has-records = true .
     1251                         leave.
     1252                       end.
     1253                     if not v-has-records
     1254                       then
     1255                       for each ub.pump-nozzle no-lock where ub.pump-nozzle.obj-type = v-cntxt-obj-type
     1256                         and ub.pump-nozzle.obj-code = v-cntxt-obj-code :
     1257                         v-has-records = true .
     1258                         leave.
     1259                       end.
     1260                     if not v-has-records
     1261                       then
     1262                       for each ub.pl-pump-nozzle no-lock where ub.pl-pump-nozzle.obj-type = v-cntxt-obj-type
     1263                         and ub.pl-pump-nozzle.obj-code = v-cntxt-obj-code :
     1264                         v-has-records = true .
     1265                         leave.
     1266                       end.
     1267                     if not v-has-records
     1268                       then
     1269                       for each ub.pl-pump no-lock where ub.pl-pump.obj-type = v-cntxt-obj-type
     1270                         and ub.pl-pump.obj-code = v-cntxt-obj-code :
     1271                         v-has-records = true .
     1272                         leave.
     1273                       end.
     1274                     if not v-has-records
     1275                       then
     1276                       for each ub.pl-gds no-lock where ub.pl-gds.obj-type = v-cntxt-obj-type
     1277                         and ub.pl-gds.obj-code = v-cntxt-obj-code :
     1278                         v-has-records = true .
     1279                         leave.
     1280                       end.
     1281                     if not v-has-records
     1282                       then
     1283                       for each ub.pl-gds-pump no-lock where ub.pl-gds-pump.obj-type = v-cntxt-obj-type
     1284                         and ub.pl-gds-pump.obj-code = v-cntxt-obj-code :
     1285                         v-has-records = true .
     1286                         leave.
     1287                       end.
     1288                     return v-has-records.
     1289                   end method.
     1290                   method public logical chek_schedule():
     1291                     define variable v-has-records as logical no-undo.
     1292                     for each ub.schedule no-lock where ub.schedule.cre-db-num = v-cntxt-db-num-obj :
     1293                       v-has-records = true .
     1294                       leave.
     1295                     end.
     1296                     if not v-has-records
     1297                       then
     1298                       for each ub.schedule-attr no-lock where ub.schedule-attr.cre-db-num = v-cntxt-db-num-obj :
     1299                         v-has-records = true .
     1300                         leave.
     1301                       end.
     1302                     return  v-has-records.
     1303                   end method.
     1304                   method public logical chek_fbrgds():
     1305                     define variable v-has-records as logical no-undo.
     1306                     for each ub.fbr-gds-obj no-lock where ub.fbr-gds-obj.obj-code = v-cntxt-obj-code and ub.fbr-gds-obj.obj-type = v-cntxt-obj-type and
     1307                       ub.fbr-gds-obj.is-modificator = true :
     1308                       v-has-records = true .
     1309                       leave.
     1310                     end.
     1311                     return  v-has-records.
     1312                   end method.
     1313                   method public void load_schedule ():
     1314                     define variable v-file-sch  as character no-undo .
     1315                     define variable v-file-attr as character no-undo .
     1316                     define variable vFlag       as logical   no-undo.
     1317                     define buffer buf_schedule      for ub.schedule .
     1318                     define buffer buf_schedule-attr for ub.schedule-attr .
     1319                     define buffer buf_rp-by-call    for ub.rp-by-call.
     1320                     define variable v-uniq-key-rec as character no-undo .
     1321                     define variable v-call#-id     as integer   no-undo .
     1322                     define variable p-call-id      as character no-undo .
     1323                     define variable p-profile-id   as integer   no-undo .
     1324                     define variable p-once-more    as integer   no-undo .
     1325                     define buffer buf_rule-by-call        for ub.rule-by-call.
     1326                     define buffer buf_Rule-call-param     for ub.rule-call-param .
     1327                     define buffer buf_tt-rule-call-param  for tt-rule-call-param.
     1328                     define buffer buf_tt0-rp-by-call      for tt0-rp-by-call.
     1329                     define buffer buf_tt0-rule-by-call    for tt0-rule-by-call.
     1330                     define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1331                     vFlag = no .
     1332                     empty temp-table tt-schedule .
     1333                     empty temp-table tt-schedule-attr .
     1334                     put-log(string (now) + "   Создаем расписания для автозаданий...").
     1335                     v-file-sch = search("cmp/schedule.txt") .
     1336                     file-info:file-name = v-file-sch .
     1337                     if file-info:file-type = ? then
     1338                     do :
     1339                       put-log("Отсутствует файл с эталонным расписанием для автозаданий schedule.txt") .
     1340                       return error "Отсутствует файл с эталонным расписанием для автозаданий schedule.txt" .
     1341                     end.
     1342                     v-file-attr = search("cmp/schedule-attr.txt") .
     1343                     file-info:file-name = v-file-attr .
     1344                     if file-info:file-type = ? then
     1345                     do :
     1346                       put-log("Отсутствует файл с атрибутами для эталонного расписания автозаданий utl/schedule-attr.txt") .
     1347                       return error "Отсутствует файл с атрибутами для эталонного расписания автозаданий utl/schedule-attr.txt" .
     1348                     end.
     1349                     input from value(v-file-sch) .
     1350                     repeat :
     1351                       create tt-schedule .
     1352                       import tt-schedule .
     1353                     end.
     1354                     input close .
     1355                     input from value(v-file-attr) .
     1356                     repeat :
     1357                       create tt-schedule-attr .
     1358                       import tt-schedule-attr .
     1359                     end.
     1360                     input close .
     1361                     for each tt-schedule no-lock :
     1362                       if tt-schedule.task-num = ? or tt-schedule.task-num <= 0 then next .
     1363                       create buf_schedule.
     1364                       buffer-copy tt-schedule to buf_schedule
     1365                         assign
     1366                         buf_schedule.cre-db-num  = v-cntxt-db-num-obj
     1367                         buf_schedule.db-num-char = string(v-cntxt-db-num-obj)
     1368                         .
     1369                       if buf_schedule.task-type = "autonws" then buf_schedule.db-num-char = "0" .
     1370                       if buf_schedule.task-type = "autosuz" then
     1371                       do:
     1372                         v-uniq-key-rec = gen-key-rec ('schedule':U,(buffer buf_schedule:handle)).
     1373                         run rul/g-callid.p ( input 'rep':U
     1374                           ,input v-uniq-key-rec
     1375                           ,output v-call#-id).
     1376                         p-call-id = "thbj-attr" + chr(3) + chr(3) + string(0) + chr(3) + "rum" + chr(3) + "rep"  .
     1377                         p-profile-id = 50 .
     1378                         p-once-more = 1 .
     1379                         for each  buf_rp-by-call where
     1380                           buf_rp-by-call.call_id = p-call-id
     1381                           and buf_rp-by-call.profile_id = p-profile-id
     1382                           and buf_rp-by-call.once-more = p-once-more
     1383                           :
     1384                           create buf_tt0-rp-by-call.
     1385                           buffer-copy buf_rp-by-call
     1386                             except once-more call_id call#_id
     1387                             to buf_tt0-rp-by-call
     1388                             assign
     1389                             buf_tt0-rp-by-call.call_id = v-uniq-key-rec
     1390                             buf_tt0-rp-by-call.call#_id = v-call#-id
     1391                             buf_tt0-rp-by-call.once-more = 1
     1392                             .
     1393                           RELEASE buf_tt0-rp-by-call.
     1394                         end.
     1395                         for each  buf_rule-by-call where
     1396                           buf_rule-by-call.call_id = p-call-id
     1397                           and buf_rule-by-call.profile_id = p-profile-id
     1398                           and buf_rule-by-call.once-more = p-once-more
     1399                           :
     1400                           create buf_tt0-rule-by-call.
     1401                           buffer-copy buf_rule-by-call
     1402                             except once-more call_id call#_id
     1403                             to buf_tt0-rule-by-call
     1404                             assign
     1405                             buf_tt0-rule-by-call.call_id = v-uniq-key-rec
     1406                             buf_tt0-rule-by-call.call#_id = v-call#-id
     1407                             buf_tt0-rule-by-call.once-more = 1
     1408                             .
     1409                           RELEASE buf_tt0-rule-by-call.
     1410                         end.
     1411                         for each buf_Rule-call-param no-lock where
     1412                           buf_rule-call-param.call_id = p-call-id
     1413                           and  buf_rule-call-param.profile_id = p-profile-id
     1414                           AND buf_rule-call-param.once-more = p-once-more:
     1415                           create buf_tt0-rule-call-param.
     1416                           buffer-copy buf_Rule-call-param
     1417                             except once-more call_id call#_id
     1418                             to buf_tt0-rule-call-param
     1419                             assign
     1420                             buf_tt0-rule-call-param.call_id = v-uniq-key-rec
     1421                             buf_tt0-rule-call-param.call#_id = v-call#-id
     1422                             buf_tt0-rule-call-param.once-more = 1
     1423                             .
     1424                           if buf_rule-call-param.param-num = 1 and buf_rule-call-param.param-value-integer <> 0 then buf_tt0-rule-call-param.param-value-integer = v-cntxt-db-num-obj .
     1425                         end.
     1426                         run rul/g-callid.p ( input 'rep':U
     1427                           ,input v-uniq-key-rec
     1428                           ,output v-call#-id).
     1429                         run rul/thbjrum1.p (
     1430                           input 'ДОБАВЛЕНИЕ':U
     1431                           ,input 'rep':U
     1432                           ,input v-uniq-key-rec
     1433                           ,input 0
     1434                           ,input "":U
     1435                           ,input 0
     1436                           ,input ?
     1437                           ,INPUT TABLE tt0-rp-by-call
     1438                           ,INPUT TABLE tt0-rule-by-call
     1439                           ,INPUT TABLE tt0-rule-call-param) no-error .
     1440                         if error-status :error then
     1441                         do:
     1442                           message
     1443                             error-status:get-message(1)  skip
     1444                             return-value
     1445                             view-as alert-box error .
     1446                           return error.
     1447                         end.
     1448                       end.
     1449                     end.
     1450                     for each tt-schedule-attr no-lock :
     1451                       if tt-schedule-attr.task-num = ? or tt-schedule-attr.task-num <= 0 then next .
     1452                       create buf_schedule-attr.
     1453                       buffer-copy tt-schedule-attr to buf_schedule-attr
     1454                         assign
     1455                         buf_schedule-attr.cre-db-num = v-cntxt-db-num-obj
     1456                         .
     1457                       if buf_schedule-attr.task-type = "autogcd"
     1458                         and buf_schedule-attr.attr-code = "schedule-obj-list"
     1459                         then
     1460                       do :
     1461                         buf_schedule-attr.attr-value = replace(buf_schedule-attr.attr-value, string(tt-schedule-attr.cre-db-num), string(v-cntxt-db-num-obj)) .
     1462                       end.
     1463                       if buf_schedule-attr.task-type = "autoexp"
     1464                         then
     1465                       do :
     1466                         case buf_schedule-attr.attr-code:
     1467                           when "schedule-obj-list" then
     1468                             do:
     1469                               assign
     1470                                 buf_schedule-attr.attr-value = v-cntxt-obj-type + "," + string(v-cntxt-obj-code) .
     1471                               .
     1472                             end.
     1473                           when "schedule-param-list" then
     1474                             do:
     1475                               assign
     1476                                 entry(15,buf_schedule-attr.attr-value,",") = string(v-cntxt-host-code-obj)
     1477                                 .
     1478                             end.
     1479                         end case .
     1480                       end.
     1481                       if buf_schedule-attr.task-type = "autosale"
     1482                         then
     1483                       do :
     1484                         case buf_schedule-attr.attr-code:
     1485                           when "schedule-param-list" then
     1486                             do:
     1487                               assign
     1488                                 entry(2,buf_schedule-attr.attr-value,",") = string(v-cntxt-host-code-obj)
     1489                                 .
     1490                             end.
     1491                         end case .
     1492                       end.
     1493                       if buf_schedule-attr.task-type = "autosuz"
     1494                         then
     1495                       do :
     1496                         define variable formatObjCode as character no-undo .
     1497                         case buf_schedule-attr.attr-code:
     1498                           when "schedule-param-list" then
     1499                             do:
     1500                               case length(v-cntxt-obj-code):
     1501                                 when 1 or
     1502                                 when 2 then
     1503                                   do:
     1504                                     formatObjCode = "999" .
     1505                                   end.
     1506                                 when 4 then
     1507                                   do:
     1508                                     formatObjCode = "99999" .
     1509                                   end.
     1510                               end case .
     1511                               assign
     1512                                 entry(1,buf_schedule-attr.attr-value,"|") = "C:\Trade_House16x\Exchange\news-dir\exch\" + (if formatObjCode <> "" then string(v-cntxt-obj-code, formatObjCode) else string(v-cntxt-obj-code)) + "-000"
     1513                                 entry(2,buf_schedule-attr.attr-value,"|") = "C:\Trade_House16x\Exchange\news-dir\exch\" + (if formatObjCode <> "" then string(v-cntxt-obj-code, formatObjCode) else string(v-cntxt-obj-code)) + "-000"
     1514                                 .
     1515                             end.
     1516                         end case .
     1517                       end.
     1518                     end.
     1519                     vflag  = yes.
     1520                     finally:
     1521                       if not mDebug then
     1522                       do:
     1523                         os-delete value("schem-temp.json") .
     1524                         os-delete value("schem.json") .
     1525                       end.
     1526                       if vflag and Chek_Schedule() then
     1527                         put-log( string(now) + "   Расписания для автозаданий созданы!") .
     1528                       else
     1529                         put-log( string(now) + "   Расписания для автозаданий не созданы!") .
     1530                     end finally.
     1531                   end.
     1532                   method public void  load_fbrgds (ifile-path as character ):
     1533                     load_fbrgds (maddr,ifile-path ).
     1534                   end method .
     1535                   method public void  load_fbrgds (iAddr as character,ifile-path as character ):
     1536                     define variable v-rid as recid     no-undo .
     1537                     define variable vcmd  as character no-undo.
     1538                     define variable vFlag as logical   no-undo.
     1539                     define buffer buf_fbr-gds-obj for ub.fbr-gds-obj .
     1540                     empty temp-table tt-fbr-gds-obj.
     1541                     put-log(string (now) + "   Отправляем запрос для получения атрибутов автопроизводства...").
     1542                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetFbrGds >&3", search ("exe/curl.exe"), iAddr, "fbrgds-temp.json").
     1543                     os-command silent value (vcmd).
     1544                     put-log(string (now) + "   Разбираем полученные данные...").
     1545                     fix-codepage_and_SetJsonObj (input "fbrgds-temp.json") .
     1546                     parse-json(input temp-table tt-fbr-gds-obj:default-buffer-handle, input "fbr-gds-obj") .
     1547                     put-log( string(now) + "   Начинаем загрузку атрибутов автопроизводства...") .
     1548                     load_gds_maping(ifile-path).
     1549                     for each tt-fbr-gds-obj no-lock :
     1550                       find first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-fbr-gds-obj.gds-code no-error .
     1551                       if available tt-gds-mapping
     1552                         then
     1553                       do :
     1554                         if tt-gds-mapping.gds-code15 = 0 or tt-gds-mapping.gds-code15 = ?
     1555                           or tt-gds-mapping.gds-code16 = 0 or tt-gds-mapping.gds-code16 = ?
     1556                           then next .
     1557                         find first ub.goods no-lock where ub.goods.gds-code = tt-gds-mapping.gds-code16 no-error.
     1558                         if available ub.goods
     1559                           then
     1560                         do :
     1561                           find first buf_fbr-gds-obj exclusive-lock where buf_fbr-gds-obj.gds-code = ub.goods.gds-code no-error .
     1562                           if not available (buf_fbr-gds-obj) then
     1563                           do:
     1564                             if tt-fbr-gds-obj.is-menu then
     1565                             do:
     1566                               put-err-log(
     1567                                 "Товар с кодом " + string(tt-gds-mapping.gds-code16) + " .Код в " + string(version-name) +  " " + string(tt-fbr-gds-obj.gds-code) + " " +
     1568                                 "Атрибут: Является блюдом меню, в " + string(version-name) +  " версии имеет значение: " + string(tt-fbr-gds-obj.is-menu) + " а в 16 " + "no").
     1569                               next .
     1570                             end.
     1571                             create buf_fbr-gds-obj .
     1572                             assign
     1573                               buf_fbr-gds-obj.gds-code     = ub.goods.gds-code
     1574                               buf_fbr-gds-obj.obj-code     = v-cntxt-obj-code
     1575                               buf_fbr-gds-obj.obj-type     = v-cntxt-obj-type
     1576                               buf_fbr-gds-obj.fbr-obj-code = v-cntxt-obj-code
     1577                               buf_fbr-gds-obj.fbr-obj-type = v-cntxt-obj-type
     1578                               .
     1579                             buffer-copy tt-fbr-gds-obj except tt-fbr-gds-obj.obj-code
     1580                               tt-fbr-gds-obj.obj-type
     1581                               tt-fbr-gds-obj.gds-code
     1582                               tt-fbr-gds-obj.fbr-obj-code
     1583                               tt-fbr-gds-obj.fbr-obj-type to buf_fbr-gds-obj no-error .
     1584                             if error-status:error then
     1585                             do:
     1586                               put-Log(return-value).
     1587                               undo, return error return-value.
     1588                             end.
     1589                           end.
     1590                           else
     1591                           do:
     1592                             if tt-fbr-gds-obj.is-menu <> buf_fbr-gds-obj.is-menu then
     1593                             do:
     1594                               put-err-log(
     1595                                 "Товар с кодом " + string(tt-gds-mapping.gds-code16) + " .Код в " + string(version-name) +  " " + string(tt-fbr-gds-obj.gds-code) + " " +
     1596                                 "Атрибут: Является блюдом меню, в " + string(version-name) +  " версии имеет значение: " + string(tt-fbr-gds-obj.is-menu) + " а в 16 " + string (buf_fbr-gds-obj.is-menu)).
     1597                               next .
     1598                             end.
     1599                             else buf_fbr-gds-obj.is-modificator = tt-fbr-gds-obj.is-modificator .
     1600                             buffer-copy tt-fbr-gds-obj except tt-fbr-gds-obj.obj-code
     1601                               tt-fbr-gds-obj.obj-type
     1602                               tt-fbr-gds-obj.gds-code
     1603                               tt-fbr-gds-obj.is-menu
     1604                               tt-fbr-gds-obj.is-modificator
     1605                               tt-fbr-gds-obj.fbr-obj-code
     1606                               tt-fbr-gds-obj.fbr-obj-type to buf_fbr-gds-obj no-error .
     1607                             if error-status:error then
     1608                             do:
     1609                               put-Log(return-value).
     1610                               undo, return error return-value.
     1611                             end.
     1612                           end.
     1613                         end.
     1614                         else
     1615                         do :
     1616                           put-err-log(
     1617                             "Не найден товар с кодом " + string(tt-gds-mapping.gds-code16) + " .Код в " + string(version-name) +  " " + string(tt-fbr-gds-obj.gds-code)).
     1618                         end.
     1619                       end.
     1620                       else
     1621                       do :
     1622                         put-err-log(
     1623                           "В файле соответствия " + ifile-path + " нет данных по товару с кодом " + string(tt-fbr-gds-obj.gds-code)).
     1624                       end.
     1625                     end.
     1626                     vflag  = yes.
     1627                     finally:
     1628                       if not mDebug then
     1629                       do:
     1630                         os-delete value("fbrgds-temp.json") .
     1631                         os-delete value("fbrgds.json") .
     1632                       end.
     1633                       if vflag and Chek_fbrgds() then
     1634                         put-log( string(now) + "   Атрибуты автопроизводства загружены!") .
     1635                       else
     1636                         put-log( string(now) + "   Атрибуты автопроизводства не загружены!") .
     1637                     end finally.
     1638                   end.
     1639                   method public void  load_version ():
     1640                     load_version (maddr).
     1641                   end method .
     1642                   method public void  load_version (iAddr as character):
     1643                     define variable vcmd as character no-undo.
     1644                     define variable vOk  as logical   no-undo.
     1645                     put-log(string (now) + "   Отправляем запрос для получения верcии.").
     1646                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetVersion >&3", search ("exe/curl.exe"), iaddr, "version-temp.json").
     1647                     os-command silent value (vcmd).
     1648                     fix-codepage_and_SetJsonObj (input "version-temp.json") no-error.
     1649     //empty temp-table tt-version.
     1650                     if error-status:error
     1651                       then
     1652                     do:
     1653                       put-log("Не удалось узнать версию.").
     1654                       return.
     1655                     end.
     1656                     parse-json(input temp-table tt-version:default-buffer-handle, input "tt-version") .
     1657                     delete object mJsonObj no-error.
     1658                     find first tt-version no-lock no-error .
     1659                     put-log(substitute ("Версия &1 по адресу &2", version-name, iAddr)).
     1660                     finally:
     1661                       if not mDebug then
     1662                       do:
     1663                         os-delete value("version-temp.json") .
     1664                         os-delete value("version.json") .
     1665                       end.
     1666                     end finally.
     1667                   end.
     1668                   method public logical chek_cash_desk():
     1669                     define variable v-has-records as logical no-undo.
     1670                     for each ub.cash-desk no-lock where ub.cash-desk.db-num = v-cntxt-db-num-obj
     1671                       and ub.cash-desk.obj-code = v-cntxt-obj-code :
     1672                       v-has-records = true .
     1673                       leave.
     1674                     end.
     1675                     if not v-has-records
     1676                       then
     1677                       for each ub.cash-desk-attr no-lock where ub.cash-desk-attr.db-num = v-cntxt-db-num-obj
     1678                         and ub.cash-desk-attr.obj-code = v-cntxt-obj-code :
     1679                         v-has-records = true .
     1680                         leave.
     1681                       end.
     1682                     return  v-has-records.
     1683                   end method.
     1684   // Перенос справочника касс
     1685                   method public character load_cashdesk ():
     1686                     return load_cashdesk(mAddr ).
     1687                   end.
     1688                   method public character load_cashdesk(iAddr as character ) :
     1689                     define variable v-rid       as recid     no-undo .
     1690                     define variable vcmd        as character no-undo.
     1691                     define variable vFlag       as logical   no-undo.
     1692                     define variable v-addr-path as character no-undo .
     1693                     define buffer buf_tt-cash-desk for tt-cash-desk .
     1694                     define buffer bf_tt-cash-desk  for tt-cash-desk .
     1695                     define variable isCashDesk as logical no-undo init true .
     1696                     empty temp-table tt-cash-desk.
     1697                     empty temp-table tt-cash-desk-attr.
     1698                     put-log(string (now) + "   Отправляем запрос для получения касс...").
     1699                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetCashDesk >&3", search ("exe/curl.exe"), iAddr, "cashdesk-temp.json").
     1700                     os-command silent value (vcmd).
     1701                     put-log(string (now) + "   Разбираем полученные данные...").
     1702                     fix-codepage_and_SetJsonObj (input "cashdesk-temp.json") .
     1703                     parse-json(input temp-table tt-cash-desk:default-buffer-handle, input "cash-desk") .
     1704                     parse-json(input temp-table tt-cash-desk-attr:default-buffer-handle, input "cash-desk-attr") .
     1705                     put-log( string(now) + "   Начинаем загрузку касс...") .
     1706                     v-cash-num = 0 .
     1707                     for each tt-cash-desk where exclusive-lock by tt-cash-desk.cash-num by tt-cash-desk.pos-type:
     1708                       if tt-cash-desk.is-del then next .
     1709                       tt-cash-desk.addr-path = replace(tt-cash-desk.addr-path, "|", chr(4)) .
     1710                       for first tt-cash-desk-attr no-lock where tt-cash-desk-attr.db-num = tt-cash-desk.db-num
     1711                         and tt-cash-desk-attr.obj-code = tt-cash-desk.obj-code
     1712                         and tt-cash-desk-attr.pos-type = tt-cash-desk.pos-type
     1713                         and tt-cash-desk-attr.cash-num = tt-cash-desk.cash-num
     1714                         and tt-cash-desk-attr.attr-code = "fr-type" :
     1715                         tt-cash-desk.fr-type = tt-cash-desk-attr.attr-value .
     1716                       end.
     1717                     end.
     1718                     do while isCashDesk:
     1719                       if can-find (first tt-cash-desk where tt-cash-desk.isSave = false) then
     1720                       do:
     1721                         load_cashdesk1 () .
     1722                       end.
     1723                       else isCashDesk = false .
     1724                     end.
     1725                     v-string-cash = trim(v-string-cash,";") .
     1726                     vflag  = yes.
     1727                     finally:
     1728                       if not mDebug then
     1729                       do:
     1730                         os-delete value("cashdesk-temp.json") .
     1731                         os-delete value("cashdesk.json") .
     1732                       end.
     1733                       if vflag and chek_cash_desk() then
     1734                       do:
     1735                         if v-RfNumber <> 0 then v-string-cash = string(v-cash-rf) + chr(4) + string(v-RfNumber) + chr(4) + v-string-cash .
     1736                         find first ub.cash-desk-attr exclusive-lock where ub.cash-desk-attr.attr-code = "string-cash" and
     1737                           ub.cash-desk-attr.cash-num = 0 and
     1738                           ub.cash-desk-attr.db-num = v-cntxt-db-num and
     1739                           ub.cash-desk-attr.obj-code = v-cntxt-obj-code no-error .
     1740                         if not available (ub.cash-desk-attr) then
     1741                         do:
     1742                           create ub.cash-desk-attr .
     1743                           assign
     1744                             ub.cash-desk-attr.attr-code = "string-cash"
     1745                             ub.cash-desk-attr.cash-num  = 0
     1746                             ub.cash-desk-attr.db-num    = v-cntxt-db-num
     1747                             ub.cash-desk-attr.obj-code  = v-cntxt-obj-code
     1748                             .
     1749                         end.
     1750                         ub.cash-desk-attr.attr-value-character = v-string-cash .
     1751                         put-log( string(now) + "   Кассы загружены!") .
     1752                         return v-string-cash .
     1753                       end.
     1754                       else
     1755                       do:
     1756                         put-log( string(now) + "   Кассы не загружены!") .
     1757                         return "" .
     1758                       end.
     1759                     end finally.
     1760                   end method.
     1761                   method public void load_cashdesk1() :
     1762                     define variable v-rid       as recid     no-undo .
     1763                     define variable v-addr-path as character no-undo .
     1764                     define buffer buf_tt-cash-desk for tt-cash-desk .
     1765                     define variable v-send as logical no-undo .
     1766                     for each tt-cash-desk where not tt-cash-desk.is-del and not tt-cash-desk.isSave exclusive-lock:
     1767                       v-send = false .
     1768                       find first buf_tt-cash-desk where not buf_tt-cash-desk.isSave and buf_tt-cash-desk.pos-type = "Autotank" and buf_tt-cash-desk.autonomy = 2 no-error .
     1769                       if available (buf_tt-cash-desk) then
     1770                       do:
     1771                         buf_tt-cash-desk.isSave = true .
     1772                         if integer(entry (2,buf_tt-cash-desk.addr-path,":")) = 7999 then
     1773                           v-addr-path = entry (1,buf_tt-cash-desk.addr-path,":") .
     1774                       end.
     1775                       else
     1776                       do:
     1777                         find first buf_tt-cash-desk where not buf_tt-cash-desk.isSave and buf_tt-cash-desk.pos-type = "IBM-XML" no-error .
     1778                         if available (buf_tt-cash-desk) then
     1779                         do:
     1780                           v-cash-num = v-cash-num + 1 .
     1781                           if v-addr-path = entry (1,buf_tt-cash-desk.addr-path,":") then
     1782                           do:
     1783                             v-cash-rf = v-cash-num .
     1784                             v-send-Rf = true .
     1785                           end.
     1786                           buf_tt-cash-desk.isSave = true .
     1787                         end.
     1788                         else
     1789                         do:
     1790                           find first buf_tt-cash-desk where not buf_tt-cash-desk.isSave and buf_tt-cash-desk.pos-type = "Autotank" no-error .
     1791                           if available (buf_tt-cash-desk) then
     1792                           do:
     1793                             v-cash-num = v-cash-num + 1 .
     1794                             if v-send-Rf then v-RfNumber = v-cash-num .
     1795                             v-send-Rf = false .
     1796                             buf_tt-cash-desk.isSave = true .
     1797                           end.
     1798                         end .
     1799                       end.
     1800                       put-log(  "Касса " + buf_tt-cash-desk.pos-type
     1801                         + " №"     + string(buf_tt-cash-desk.cash-num)
     1802                         + " IP: "  + entry(if buf_tt-cash-desk.addr-path eq "" then 1 else num-entries(buf_tt-cash-desk.addr-path, chr(4)) ,
     1803                         buf_tt-cash-desk.addr-path,
     1804                         chr(4))).
     1805                       define variable vOldCashNum as integer no-undo.
     1806                       vOldCashNum = buf_tt-cash-desk.cash-num.
     1807                       if buf_tt-cash-desk.cash-num <> v-cash-num then
     1808                         assign
     1809                           buf_tt-cash-desk.cash-num = v-cash-num
     1810                           v-send                    = true .
     1811                       run ref/cashdsk1.p (
     1812                         input-output v-rid
     1813                         ,input 'ДОБАВЛЕНИЕ':U
     1814                         ,input v-cntxt-db-num-obj
     1815                         ,input v-cntxt-obj-code
     1816                         ,input buf_tt-cash-desk.pos-type
     1817                         ,input buf_tt-cash-desk.cash-num
     1818                         ,input buf_tt-cash-desk.autonomy
     1819                         ,input buf_tt-cash-desk.addr-path
     1820                         ,input no
     1821                         ,input buf_tt-cash-desk.cash-os
     1822                         ,input buf_tt-cash-desk.is-del
     1823                         ,input buf_tt-cash-desk.remote
     1824                         ,input buf_tt-cash-desk.version
     1825                         ,input buf_tt-cash-desk.registration-code
     1826                         ,input buf_tt-cash-desk.serial-code
     1827                         ,input buf_tt-cash-desk.fr-type
     1828                         ,input ?
     1829                         ) no-error .
     1830                       if error-status:error then
     1831                       do:
     1832                         put-Log(return-value).
     1833                         undo, return error return-value.
     1834                       end.
     1835                       if v-send then
     1836                       do:
     1837                         v-string-cash = v-string-cash + ";" + string(buf_tt-cash-desk.cash-num) .
     1838                       end.
     1839                     end.
     1840                   end method.
     1841                   method public void parse-json (
     1842                     pBuff as handle,
     1843                     p-array-name as character):
     1844                     define variable v-data-type as character no-undo .
     1845                     define variable vCount      as integer   no-undo.
     1846                     define variable vLength     as integer   no-undo.
     1847                     define variable vI          as integer   no-undo.
     1848                     results-array = mJsonObj:GetJsonArray(p-array-name) no-error.
     1849                     if error-status:error then return.
     1850                     vLength = results-array:LENGTH.
     1851                     do vCount = 1 to vLength:
     1852                       myResultObj = results-array:GetJsonObject(vCount).
     1853                       pBuff:buffer-create () .
     1854                       do vI = 1 to pBuff:num-fields:
     1855                         v-data-type = pBuff:buffer-field[vI]:data-type .
     1856                         case v-data-type :
     1857                           when "character" then
     1858                             do:
     1859                               pBuff:buffer-field[vI]:buffer-value = myResultObj:GetCharacter(pBuff:buffer-field[vI]:name) no-error .
     1860                             end.
     1861                           when "integer" then
     1862                             do:
     1863                               pBuff:buffer-field[vI]:buffer-value = integer(myResultObj:GetCharacter(pBuff:buffer-field[vI]:name)) no-error .
     1864                             end.
     1865                           when "int64" then
     1866                             do:
     1867                               pBuff:buffer-field[vI]:buffer-value = int64(myResultObj:GetCharacter(pBuff:buffer-field[vI]:name)) no-error .
     1868                             end.
     1869                           when "decimal" then
     1870                             do:
     1871                               pBuff:buffer-field[vI]:buffer-value = decimal(myResultObj:GetCharacter(pBuff:buffer-field[vI]:name)) no-error .
     1872                             end.
     1873                           when "logical" then
     1874                             do:
     1875                               pBuff:buffer-field[vI]:buffer-value = logical(myResultObj:GetCharacter(pBuff:buffer-field[vI]:name)) no-error .
     1876                             end.
     1877                           when "date" then
     1878                             do:
     1879                               pBuff:buffer-field[vI]:buffer-value = date(myResultObj:GetCharacter(pBuff:buffer-field[vI]:name)) no-error .
     1880                             end.
     1881                         end.
     1882                       end.
     1883                     end.
     1884                   end method .
     1885                   method public logical chek_price():
     1886                     define variable v-has-records as logical no-undo.
     1887                     for each ub.price-doc no-lock where ub.price-doc.obj-type = v-cntxt-obj-type
     1888                       and ub.price-doc.obj-code = v-cntxt-obj-code :
     1889                       v-has-records = true .
     1890                       leave.
     1891                     end.
     1892                     for each ub.price-list no-lock where ub.price-list.obj-type = v-cntxt-obj-type
     1893                       and ub.price-list.obj-code = v-cntxt-obj-code :
     1894                       v-has-records = true .
     1895                       leave.
     1896                     end.
     1897                     return v-has-records.
     1898                   end method.
     1899                   method public void load_gds_maping(ifile-path as character ):
     1900                     define variable v-line    as character no-undo.
     1901                     define variable v-err-msg as character no-undo.
     1902                     file-info:file-name = ifile-path .
     1903                     if file-info:file-type = ? then
     1904                     do :
     1905                       v-err-msg = substitute("Отсутствует файл соответствия товаров &1", ifile-path) .
     1906                       message v-err-msg
     1907                         view-as alert-box.
     1908                       undo, throw new Progress.Lang.AppError (v-err-msg) .
     1909                     end .
     1910                     empty temp-table tt-gds-mapping .
     1911                     input from value(ifile-path) .
     1912                     repeat:
     1913                       import unformatted v-line.
     1914                       create tt-gds-mapping .
     1915                       assign
     1916                         tt-gds-mapping.gds-code15 = integer(trim(entry(1, v-line, ";")))
     1917                         tt-gds-mapping.gds-code16 = integer(trim(entry(2, v-line, ";"))) no-error .
     1918                       if error-status:error then leave .
     1919                     end.
     1920                   end method.
     1921                   method public void  load_price (ifile-path as character ):
     1922                     load_price (maddr,ifile-path ).
     1923                   end method .
     1924                   method public void  load_price (iAddr as character,ifile-path as character ):
     1925                     define variable vFlag as logical no-undo.
     1926                     load_gds_maping(ifile-path).
     1927                     put-log(string (now) + "   Отправляем запрос для получения цен...").
     1928                     define variable vcmd       as character no-undo.
     1929                     define variable num-rec-ok as integer   no-undo .
     1930                     define variable ii         as integer   no-undo initial 0 .
     1931                     define variable jj         as integer   no-undo initial 0 .
     1932                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetPrice >&3", search ("exe/curl.exe"), iaddr, "price-temp.json").
     1933                     os-command silent value (vcmd).
     1934                     put-log(string (now) + "   Разбираем полученные данные...").
     1935                     fix-codepage_and_SetJsonObj(input "price-temp.json") .
     1936                     empty temp-table tt-gds-price.
     1937                     parse-json(input temp-table tt-gds-price:default-buffer-handle, input "tt-gds-price") .
     1938                     create temp-price-doc .
     1939                     assign
     1940                       temp-price-doc.doc-date = today
     1941                       temp-price-doc.doc-num  = 1
     1942                       temp-price-doc.line-num = 1
     1943                       temp-price-doc.obj-code = v-cntxt-obj-code
     1944                       temp-price-doc.obj-type = v-cntxt-obj-type
     1945                       temp-price-doc.doc-id   = "_"
     1946                       .
     1947                     put-log( string (now) +  "    Начинаем загрузку цен...").
     1948                     for each tt-gds-price no-lock :
     1949                       find first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-gds-price.gds-code no-error .
     1950                       if available tt-gds-mapping
     1951                         then
     1952                       do :
     1953                         if tt-gds-mapping.gds-code15 = 0 or tt-gds-mapping.gds-code15 = ?
     1954                           or tt-gds-mapping.gds-code16 = 0 or tt-gds-mapping.gds-code16 = ?
     1955                           then next .
     1956                         find first ub.goods no-lock where ub.goods.gds-code = tt-gds-mapping.gds-code16 no-error.
     1957                         if available ub.goods
     1958                           then
     1959                         do :
     1960                           create temp-price-list.
     1961                           assign
     1962                             temp-price-list.doc-num    = 1
     1963                             temp-price-list.line-num   = 1
     1964                             temp-price-list.gds-code   = tt-gds-mapping.gds-code16
     1965                             temp-price-list.price-sale = tt-gds-price.price
     1966                             .
     1967                           put-log(
     1968                             "Код в " + string(version-name) + " " +  string(tt-gds-price.gds-code) + " .Код в 16.0 " +  string(tt-gds-mapping.gds-code16) +
     1969                             " . Цена: " + string(tt-gds-price.price)) .
     1970                         end.
     1971                         else
     1972                         do :
     1973                           ii = ii + 1 .
     1974                           put-err-log(
     1975                             "Не найден товар с кодом " + string(tt-gds-mapping.gds-code16) + " .Код в " + string(version-name) + " " + string(tt-gds-price.gds-code) +
     1976                             " . Цена: " + string(tt-gds-price.price) ).
     1977                         end.
     1978                       end.
     1979                       else
     1980                       do :
     1981                         jj = jj + 1 .
     1982                         put-err-log(
     1983                           "В файле соответствия " + ifile-path + " нет данных по товару с кодом " + string(tt-gds-price.gds-code) +
     1984                           " . Цена: " + string(tt-gds-price.price)).
     1985                       end.
     1986                     end.
     1987                     run utl/ora-i301-draw-util.p (
     1988                       input parparentproc, //this-procedure ,
     1989                       input this-object , //this-procedure ,
     1990                       input table temp-price-doc ,
     1991                       input table temp-price-list ,
     1992                       output num-rec-ok
     1993                       ) no-error .
     1994                     if error-status:error
     1995                       then
     1996                     do :
     1997                       put-Log(return-value).
     1998                       undo, return error return-value.
     1999                     end.
     2000                     if ii > 0 or jj > 0
     2001                       then
     2002                     do :
     2003                       put-log( substitute("Всего отвергнуто &1 записей при загрузке цен. Из них:",ii )).
     2004                       put-log( substitute("  нет соответствий по товарам &1", ii )).
     2005                       put-log( substitute("В файле соотвествия нет данных по &1 товаров.",jj)) .
     2006                     end.
     2007                     vflag  = yes.
     2008                     finally:
     2009                       if not mDebug then
     2010                       do:
     2011                         os-delete value("price-temp.json") .
     2012                         os-delete value("price.json") .
     2013                       end.
     2014                       if vflag and chek_price() then
     2015                         put-log( string( now) + "   Цены загружены!") .
     2016                       else
     2017                         put-log( string( now) + "   Цены  не загружены!") .
     2018                       put-log("").
     2019                     end finally.
     2020                   end method .
     2021                   method public logical chek_user():
     2022                     define variable v-has-records as logical no-undo.
     2023                     v-has-records = can-find (first ub.user-login where ub.user-login.user-login <> "адм" and ub.user-login.user-login <> "sysadm"  ).
     2024                     return v-has-records .
     2025                   end method.
     2026                   method public logical load_user ( ) :
     2027                     load_user(mAddr).
     2028                   end method.
     2029                   method public void load_user(iAddr as character ) :
     2030                     define variable v-rid     as recid     no-undo .
     2031                     define variable vcmd      as character no-undo.
     2032                     define variable vFlag     as logical   no-undo.
     2033                     define variable v-user-id as character no-undo .
     2034                     empty temp-table tt-user-account.
     2035                     empty temp-table tt-user-login.
     2036                     empty temp-table tt-user-host.
     2037                     empty temp-table tt-user-obj.
     2038                     empty temp-table tt-user-menu-group.
     2039                     define buffer buf_user-login      for ub.user-login .
     2040                     define buffer buf_user-host       for ub.user-host .
     2041                     define buffer buf_user-obj        for ub.user-obj .
     2042                     define buffer buf_user-menu-group for ub.user-menu-group .
     2043                     define buffer buf_user-account    for ub.user-account .
     2044                     define buffer buf_tt-user-login   for tt-user-login .
     2045                     define buffer bf_tt-user-login    for tt-user-login .
     2046                     put-log(string (now) + "   Отправляем запрос для получения пользователей...").
     2047                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetUser >&3", search ("exe/curl.exe"), iAddr, "user-temp.json").
     2048                     os-command silent value (vcmd).
     2049                     put-log(string (now) + "   Разбираем полученные данные...").
     2050                     fix-codepage_and_SetJsonObj (input "user-temp.json") .
     2051                     parse-json(input temp-table tt-user-account:default-buffer-handle, input "user-account") .
     2052                     parse-json(input temp-table tt-user-login:default-buffer-handle, input "user-login") .
     2053                     parse-json(input temp-table tt-user-host:default-buffer-handle, input "user-host") .
     2054                     parse-json(input temp-table tt-user-obj:default-buffer-handle, input "user-obj") .
     2055                     parse-json(input temp-table tt-user-menu-group:default-buffer-handle, input "user-menu-group") .
     2056                     put-log( string(now) + "   Начинаем загрузку пользователей...") .
     2057                     user_:
     2058                     for each tt-user-account where tt-user-account.status_ = 0 exclusive-lock,
     2059                       first buf_tt-user-login where buf_tt-user-login.user-id = tt-user-account.user-id:
     2060                       put-log(  "Пользователь " + string(tt-user-account.user-id) ).
     2061                       find first buf_user-account exclusive-lock where buf_user-account.user-id = tt-user-account.user-id no-error .
     2062                       if available (buf_user-account) then
     2063                       do:
     2064                         next user_ .
     2065                       end.
     2066                       for each tt-user-login no-lock where tt-user-login.user-id = tt-user-account.user-id and tt-user-login.status_ = 0:
     2067                         find first bf_tt-user-login where bf_tt-user-login.user-id = tt-user-login.user-id and bf_tt-user-login.user-login = "адм" no-error .
     2068                         if available (bf_tt-user-login) then
     2069                         do:
     2070                           next user_ .
     2071                         end.
     2072                         else
     2073                         do:
     2074                           run str/usracc01.p (
     2075                             input 'ДОБАВЛЕНИЕ':U
     2076                             , input v-cntxt-db-num
     2077                             , input "":U
     2078                             , input tt-user-account.last-name
     2079                             , input tt-user-account.first-name
     2080                             , input tt-user-account.second-name
     2081                             , input tt-user-account.nik
     2082                             , input tt-user-account.phone-number
     2083                             , input tt-user-account.mobile-phone-number
     2084                             , input tt-user-account.company
     2085                             , input tt-user-account.department
     2086                             , input tt-user-account.position
     2087                             , input tt-user-account.room
     2088                             , input tt-user-account.e-mail
     2089                             , input tt-user-account.internal-phone-number
     2090                             , input tt-user-account.PS
     2091                             , input tt-user-account.psn-code
     2092                             , input no
     2093                             , output v-user-id
     2094                             ) no-error.
     2095                           if error-status :error
     2096                             then
     2097                           do:
     2098                             put-Log(return-value).
     2099                           end.
     2100                           create buf_user-login .
     2101                           buffer-copy tt-user-login except tt-user-login.user-id tt-user-login.db-num to buf_user-login .
     2102                           assign
     2103                             buf_user-login.user-id = v-user-id
     2104                             buf_user-login.db-num  = v-cntxt-db-num
     2105                             .
     2106                         end.
     2107                       end.
     2108                       for each tt-user-host no-lock where tt-user-host.user-id = tt-user-account.user-id:
     2109                         create buf_user-host .
     2110                         assign
     2111                           buf_user-host.user-id         = v-user-id
     2112                           buf_user-host.host-code       = v-host-code
     2113                           buf_user-host.db-num          = v-cntxt-db-num
     2114                           buf_user-host.whole-send-news = tt-user-host.whole-send-news
     2115                           .
     2116                       end.
     2117                       for each tt-user-obj no-lock where tt-user-obj.user-id = tt-user-account.user-id:
     2118                         create buf_user-obj .
     2119                         assign
     2120                           buf_user-obj.user-id         = v-user-id
     2121                           buf_user-obj.db-num          = v-cntxt-db-num
     2122                           buf_user-obj.obj-type        = v-cntxt-obj-type
     2123                           buf_user-obj.obj-code        = v-cntxt-obj-code
     2124                           buf_user-obj.host-code       = v-host-code
     2125                           buf_user-obj.whole-send-news = tt-user-obj.whole-send-news
     2126                           .
     2127                       end.
     2128                       for each tt-user-menu-group no-lock where tt-user-menu-group.user-id = tt-user-account.user-id,
     2129                         first ub.menu-group where ub.menu-group.menu-group-id = tt-user-menu-group.menu-group-id and ub.menu-group.menu-code = tt-user-menu-group.menu-code:
     2130                         create buf_user-menu-group .
     2131                         assign
     2132                           buf_user-menu-group.db-num               = v-cntxt-db-num
     2133                           buf_user-menu-group.menu-code            = ub.menu-group.menu-code
     2134                           buf_user-menu-group.menu-group-code      = ub.menu-group.menu-group-code
     2135                           buf_user-menu-group.menu-group-context   = tt-user-menu-group.menu-group-context
     2136                           buf_user-menu-group.menu-group-id        = ub.menu-group.menu-group-id
     2137                           buf_user-menu-group.user-id              = v-user-id
     2138                           buf_user-menu-group.host-code            = v-host-code
     2139                           buf_user-menu-group.obj-code             = v-cntxt-obj-code
     2140                           buf_user-menu-group.obj-type             = v-cntxt-obj-type
     2141                           buf_user-menu-group.user-menu-group-code = next-value(s-user-menu-group)
     2142                           .
     2143                       end.
     2144                     end.
     2145                     vflag  = yes.
     2146                     finally:
     2147                       if not mDebug then
     2148                       do:
     2149                         os-delete value("user-temp.json") .
     2150                         os-delete value("user.json") .
     2151                       end.
     2152                       if vflag and chek_user() then
     2153                         put-log( string(now) + "   Пользователи загружены!") .
     2154                       else
     2155                         put-log( string(now) + "   Пользователи не загружены!") .
     2156                     end finally.
     2157                   end method.
     2158                   method public void fix-codepage_and_SetJsonObj (p-file as character):
     2159                     define variable vline      as char      no-undo .
     2160                     define variable vline2     as char      no-undo .
     2161                     define variable v-out-file as character no-undo .
     2162                     case p-file :
     2163                       when "schem-temp.json"       then
     2164                         v-out-file = "schem.json" .
     2165                       when "pumpdoc-temp.json"     then
     2166                         v-out-file = "pumpdoc.json" .
     2167                       when "cashdesk-temp.json"    then
     2168                         v-out-file = "cashdesk.json" .
     2169                       when "price-temp.json"       then
     2170                         v-out-file = "price.json" .
     2171                       when "rest-temp.json"        then
     2172                         v-out-file = "rest.json" .
     2173                       when "rest-ptrl-temp.json"   then
     2174                         v-out-file = "rest-ptrl.json" .
     2175                       when "verify-rest-temp.json" then
     2176                         v-out-file = "verify-rest.json" .
     2177                       when "rvs-temp.json"         then
     2178                         v-out-file = "rvs.json" .
     2179                       when "cashp-temp.json"       then
     2180                         v-out-file = "cashp.json" .
     2181                       when "user-temp.json"        then
     2182                         v-out-file = "user.json" .
     2183                       when "fbrgds-temp.json"  then
     2184                         v-out-file = "fbrgds.json" .
     2185                       when "rest-fin-temp.json"    then
     2186                         v-out-file = "restfin.json" .
     2187                       when "version-temp.json" then
     2188                         v-out-file = "version.json" .
     2189                     end case.
     2190                     input STREAM lsIN from value(search(p-file)) convert target "UTF-8" source "1251".
     2191                     output STREAM lsOUT to value(v-out-file).
     2192                     repeat:
     2193                       vline2 = vline.
     2194                       import stream lsIN unformatted vline.
     2195                       vLine = replace(vline, chr(4), "|") .
     2196                       if vline2 = vline and length(vline2) < 3 then leave.
     2197                       put stream lsOUT unformatted  vline skip .
     2198                     end.
     2199                     input STREAM lsIN close.
     2200                     output STREAM lsOUT close.
     2201                     delete object mJsonObj no-error.
     2202                     mJsonObj = cast(mParser:ParseFile(search(v-out-file)), JsonObject) no-error.
     2203                     if error-status:error
     2204                       then
     2205                     do:
     2206                       put-log("Данные не получены либо содержат ошибку в формате.").
     2207                       return error "Данные не получены либо содержат ошибку в формате.".
     2208                     end.
     2209                   end method.
     2210                   method public logical chek_pumpdoc ():
     2211                     define variable v-has-records as logical no-undo.
     2212                     for each ub.icnt-doc no-lock where ub.icnt-doc.obj-type = v-cntxt-obj-type
     2213                       and ub.icnt-doc.obj-code = v-cntxt-obj-code :
     2214                       v-has-records = true .
     2215                       leave.
     2216                     end.
     2217                     for each ub.icnt-line no-lock where ub.icnt-line.obj-type = v-cntxt-obj-type
     2218                       and ub.icnt-line.obj-code = v-cntxt-obj-code :
     2219                       v-has-records = true .
     2220                       leave.
     2221                     end.
     2222                     return v-has-records.
     2223                   end method.
     2224                   method public void load_pumpdoc (ifile-path as character ) :
     2225                     load_pumpdoc (maddr, ifile-path ).
     2226                   end.
     2227                   method public void load_pumpdoc (iaddr as character, ifile-path as character ) :
     2228                     define variable v-doc-code as character no-undo .
     2229                     define variable v-recid    as recid     no-undo .
     2230                     define variable vcmd       as character no-undo.
     2231                     define variable vFlag      as logical   no-undo.
     2232                     put-log(string (now) + "   Отправляем запрос для получения инвентаризации счётчиков ТРК...").
     2233                     load_gds_maping(ifile-path).
     2234                     empty temp-table tt-gds-prod .
     2235                     empty temp-table tt-place-loc .
     2236                     empty temp-table tt-icnt-doc.
     2237                     empty temp-table tt-icnt-line.
     2238                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetPumpDoc >&3", search ("exe/curl.exe"), iaddr, "pumpdoc-temp.json").
     2239                     os-command silent value (vcmd).
     2240                     put-log(string (now) + "   Разбираем полученные данные...").
     2241                     fix-codepage_and_SetJsonObj(input "pumpdoc-temp.json") .
     2242                     parse-json(input temp-table tt-icnt-doc:default-buffer-handle, input "icnt-doc") .
     2243                     parse-json(input temp-table tt-icnt-line:default-buffer-handle, input "icnt-line") .
     2244                     parse-json(input temp-table tt-gds-prod:default-buffer-handle, input "tt-gds-prod") .
     2245                     parse-json(input temp-table tt-place-loc:default-buffer-handle, input "tt-place-loc") .
     2246                     put-log(string( now) + "   Начинаем загрузку инвентаризации счётчиков ТРК...") .
     2247                     for each tt-icnt-doc no-lock :
     2248                       put-log( "Номер документа в " + string(version-name) +  "   " + tt-icnt-doc.doc-code).
     2249                       for each tt-icnt-line exclusive-lock where tt-icnt-line.doc-code = tt-icnt-doc.doc-code :
     2250                         find first tt-gds-mapping no-lock where tt-gds-mapping.gds-code15 = tt-icnt-line.gds-code no-error .
     2251                         if not available tt-gds-mapping
     2252                           then
     2253                         do :
     2254                           put-log(("В файле соответсвий нет топлива " + string(tt-icnt-line.gds-code))).
     2255                           undo, return error ("В файле соответсвий нет топлива " + string(tt-icnt-line.gds-code)) .
     2256                         end.
     2257                         find first ub.goods no-lock where ub.goods.gds-code = tt-gds-mapping.gds-code16 no-error.
     2258                         if not available ub.goods
     2259                           then
     2260                         do :
     2261                           put-log(("Нет топлива с кодом " + string(tt-gds-mapping.gds-code16) + " . Код в v" + string(version-name) +  " - " + string(tt-gds-mapping.gds-code15)) ).
     2262                           undo, return error ("Нет топлива с кодом " + string(tt-gds-mapping.gds-code16) + " . Код в v" + string(version-name) +  " - " + string(tt-gds-mapping.gds-code15)) .
     2263                         end.
     2264                         find first tt-place-loc no-lock where tt-place-loc.pl-code = tt-icnt-line.pl-code no-error.
     2265                         if not available tt-place-loc
     2266                           then
     2267                         do :
     2268                           put-log(substitute ("Не найдено место хранения с кодом &1 в переданных данных",tt-icnt-line.pl-code )).
     2269                           undo, return error "No place-loc" .
     2270                         end.
     2271                         find first ub.place no-lock where ub.place.loc1 = tt-place-loc.loc1 no-error.
     2272                         if not available ub.place
     2273                           then
     2274                         do :
     2275                           put-log(substitute ("Не найдено место хранения с коротким кодом &1",tt-place-loc.loc1)).
     2276                           undo, return error "No place" .
     2277                         end.
     2278                         assign
     2279                           tt-icnt-line.obj-code = v-cntxt-obj-code
     2280                           tt-icnt-line.obj-type = v-cntxt-obj-type
     2281                           tt-icnt-line.gds-code = tt-gds-mapping.gds-code16
     2282                           tt-icnt-line.pl-code  = ub.place.pl-code
     2283                           .
     2284                       end.
     2285                       run str/icntdoc1.p (
     2286                         input 'ДОБАВЛЕНИЕ':U
     2287                         ,input yes
     2288                         ,input-output v-recid
     2289                         ,input ""
     2290                         ,input v-cntxt-obj-type
     2291                         ,input v-cntxt-obj-code
     2292                         ,input v-cntxt-host-code-obj
     2293                         ,input 'инв-сч-трк':U
     2294                         ,input 'ip':U
     2295                         ,input tt-icnt-doc.wrkr
     2296                         ,input tt-icnt-doc.agnt
     2297                         ,input tt-icnt-doc.boss
     2298                         ,input tt-icnt-doc.doc-date
     2299                         ,input tt-icnt-doc.meas-el-cnt
     2300                         ,input tt-icnt-doc.state-el-cnt
     2301                         ,input tt-icnt-doc.state-mh-cnt
     2302                         ,input tt-icnt-doc.PS
     2303                         ,input tt-icnt-doc.creid
     2304                         ,input '':U
     2305                         ,input table tt-icnt-line
     2306                         ) no-error.
     2307                       if error-status:error then
     2308                       do:
     2309                         put-log(return-value).
     2310                         undo, return error return-value.
     2311                       end.
     2312                       run str/icntdoc2.p ( input v-recid
     2313                         ,input yes
     2314                         ) no-error.
     2315                       if error-status:error then
     2316                       do:
     2317                         put-log(return-value).
     2318                         undo, return error return-value.
     2319                       end.
     2320                     end.
     2321                     vflag  = yes.
     2322                     finally:
     2323                       if not mDebug then
     2324                       do:
     2325                         os-delete value("pumpdoc-temp.json") .
     2326                         os-delete value("pumpdoc.json") .
     2327                       end.
     2328                       if vflag and chek_pumpdoc() then
     2329                         put-log( string( now) +  "   Инвентаризация счётчиков ТРК загружена!" ) .
     2330                       else
     2331                         put-log( string( now) +  "   Инвентаризация счётчиков ТРК не загружена!" ) .
     2332                       put-log("").
     2333                     end finally.
     2334                   end method.
     2335                   method public logical chek-sht-open():
     2336                     define buffer open-shift for ub.shift-obj .
     2337                     find last open-shift where
     2338                       open-shift.obj-type = v-cntxt-obj-type and
     2339                       open-shift.obj-code = v-cntxt-obj-code and
     2340                       open-shift.status_ = 'тек':U
     2341                       use-index pi no-error.
     2342                     return  available open-shift.
     2343                   end method.
     2344                   method public void  sht-open(): // открытие смены
     2345                     define variable vOk as logical no-undo.
     2346                     put-log("Открытие смены").
     2347                     run gbl/sht-open-bach.p (this-object,output vOk,parparentproc, input v-cntxt-obj-type, input v-cntxt-obj-code ).
     2348                     put-log(if chek-sht-open() then "Смены открыта" else "Смена не открыта").
     2349                   end method.
     2350                   method public logical chek_rvs():
     2351                     define buffer open-shift  for ub.shift-obj .
     2352                     define buffer buf_rvs-doc for ub.rvs-doc .
     2353                     find last open-shift where
     2354                       open-shift.obj-type = v-cntxt-obj-type and
     2355                       open-shift.obj-code = v-cntxt-obj-code and
     2356                       open-shift.status_ = 'тек':U
     2357                       use-index pi no-error.
     2358                     if available open-shift
     2359                       then
     2360                       find first  buf_rvs-doc where buf_rvs-doc.obj-type eq v-cntxt-obj-type
     2361                         and buf_rvs-doc.obj-code eq v-cntxt-obj-code
     2362                         and buf_rvs-doc.shift-date eq open-shift.shift-date
     2363                         and buf_rvs-doc.shift-num  eq open-shift.shift-num
     2364                         no-lock no-error.
     2365                     return  available buf_rvs-doc.
     2366                   end method.
     2367                   method public void  rvs-auto(): // содание сверки
     2368                     define variable vOk as logical no-undo.
     2369                     put-log("Создание нулевой сверки").
     2370                     run str/rvs-auto-draw.p (this-object).
     2371                     put-log(if chek_rvs() then "Нулевая сверка создана" else "Нулевая сверка не создана").
     2372                     put-log("").
     2373                   end method.
     2374                   method public logical load_rest (
     2375                     iosn-fname   as character,  // список соответствия поставщиков
     2376                     iart-fname   as  character, // список соответствия товаров
     2377                     iretry-fname as character   // файл для повторного импорта
     2378                     ):
     2379                     return load_rest(maddr, iosn-fname, iart-fname, iretry-fname).
     2380                   end method.
     2381                   method public logical load_rest (iaddr as character,
     2382                     iosn-fname   as character,  // список соответствия поставщиков
     2383                     iart-fname   as  character, // список соответствия товаров
     2384                     iretry-fname as character   // файл для повторного импорта
     2385                     ):
     2386                     define variable vcmd as character no-undo.
     2387                     define variable vOk  as logical   no-undo.
     2388                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetRest >&3", search ("exe/curl.exe"), iaddr, "rest-temp.json").
     2389                     os-command silent value (vcmd).
     2390                     fix-codepage_and_SetJsonObj (input "rest-temp.json") .
     2391                     empty temp-table tt-imp-parts.
     2392                     parse-json(input temp-table tt-imp-parts:default-buffer-handle, input "tt-imp-parts") .
     2393                     delete object mJsonObj no-error.
     2394                     put-log ( string(now) +  "   Начинаем загрузку остатков...") .
     2395                     define variable v-count-err as integer no-undo .
     2396                     run utl/imp-doc4cr-draw.p ( this-object
     2397                       , iosn-fname // список соответствия поставщиков
     2398                       , iart-fname // список соответствия товаров
     2399                       , iretry-fname // файл для повторного импорта
     2400                       , input table tt-imp-parts
     2401                       ) .
     2402                     vok = yes.
     2403                     finally:
     2404                       if not mDebug then
     2405                       do:
     2406                         os-delete value("rest-temp.json") .
     2407                         os-delete value("rest.json") .
     2408                       end.
     2409                       vok = chek_rest() and vok.
     2410                       put-log( string( now) + if  vok then "   Остатки по товарам загружены!" else "   Остатки по товарам не загружены!") .
     2411                       put-log("").
     2412                       return vok.
     2413                     end finally.
     2414                   end method .
     2415                   method public logical load_rest_ptrl (
     2416                     iosn-fname   as character,  // список соответствия поставщиков
     2417                     iart-fname   as  character, // список соответствия товаров
     2418                     iretry-fname as character   // файл для повторного импорта
     2419                     ):
     2420                     return load_rest_ptrl (maddr, iosn-fname, iart-fname, iretry-fname).
     2421                   end method.
     2422                   method public logical load_rest_ptrl (iaddr as character,
     2423                     iosn-fname   as character,  // список соответствия поставщиков
     2424                     iart-fname   as  character, // список соответствия товаров
     2425                     iretry-fname as character   // файл для повторного импорта
     2426                     ):
     2427                     define variable vcmd as character no-undo.
     2428                     define variable vOk  as logical   no-undo.
     2429                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetRestPtrl >&3", search ("exe/curl.exe"), iaddr, "rest-ptrl-temp.json").
     2430                     os-command silent value (vcmd).
     2431                     fix-codepage_and_SetJsonObj (input "rest-ptrl-temp.json") .
     2432                     empty temp-table tt-imp-parts-ptrl.
     2433                     parse-json(input temp-table tt-imp-parts-ptrl:default-buffer-handle, input "tt-imp-parts-ptrl") .
     2434                     put-log ( string(now) +  "   Начинаем загрузку остатков по топливу...") .
     2435                     define variable v-count-err as integer no-undo .
     2436                     run utl/imp-doc4cr-draw-ptrl.p ( this-object
     2437                       , iosn-fname // список соответствия поставщиков
     2438                       , iart-fname // список соответствия товаров
     2439                       , iretry-fname // файл для повторного импорта
     2440                       , input table tt-imp-parts-ptrl
     2441                       ) .
     2442   // ?? Журналировать каждую загруженную строку ??
     2443   //        put stream log-stream unformatted
     2444   //          "Код в 15.0 " string(tt-gds-price.gds-code) " .Код в 16.0 " string(tt-gds-mapping.gds-code16)
     2445   //          " . Цена: " string(tt-gds-price.price) skip .
     2446   //  &scop my-message substitute("Всего прочитано &1 записей. Из них отвергнуто &2", v-count-all, v-count-err )
     2447   //  {&display-message}.
     2448                     vok = yes.
     2449                     finally:
     2450                       if not mDebug then
     2451                       do:
     2452                         os-delete value("rest-ptrl-temp.json") .
     2453                         os-delete value("rest-ptrl.json") .
     2454                       end.
     2455                       vok = chek_rest_ptrl() and vok.
     2456                       put-log( string( now) + if  vok then "   Остатки по топливу загружены!" else "   Остатки по топливу не загружены!") .
     2457                       put-log("").
     2458                       return vok.
     2459                     end finally.
     2460                   end method .
     2461                   method public logical verify_rest (ifile-path as character):
     2462                     return verify_rest(mAddr,ifile-path).
     2463                   end  method.
     2464                   method public logical verify_rest (iAddr as character, ifile-path as character) :
     2465                     define variable vcmd              as character no-undo.
     2466                     define variable vok               as logical   no-undo.
     2467                     define variable v-count-confirm   as integer   no-undo .
     2468                     define variable v-count-decline   as integer   no-undo .
     2469                     define variable v-count-mismatch  as integer   no-undo .
     2470                     define variable v-logfile-gd      as character no-undo .
     2471                     define variable v-logfile-fu      as character no-undo .
     2472                     define variable v-logfile-rj      as character no-undo .
     2473                     define variable v-err-message     as character no-undo .
     2474                     define variable v-today           as date      no-undo .
     2475                     define variable v-fact-qnty16     as decimal   no-undo .
     2476                     define variable v-sum-rubl-cost16 as decimal   no-undo .
     2477                     define variable v-vat-rubl16      as decimal   no-undo .
     2478                     define variable v-sum-rubl-crsa16 as decimal   no-undo .
     2479                     define variable v-fact-qnty-lt16  as decimal   no-undo .
     2480                     define variable v-fact-qnty-kg16  as decimal   no-undo .
     2481                     define variable v-vat-rubl-delta  as decimal   no-undo .
     2482                     define variable v-sum-rubl-delta  as decimal   no-undo .
     2483                     define buffer buf_pl-gds   for ub.pl-gds .
     2484                     define buffer buf_stk-line for ub.stk-line .
     2485                     define buffer buf_goods    for ub.goods .
     2486                     put-log(string (now) + "   Расчет архивов перед сравнением остатков...").
     2487                     define variable v-date-start as date      no-undo .
     2488                     define variable v-date-end   as date      no-undo .
     2489                     define variable v-archive-ok as logical   no-undo .
     2490                     define variable v-comment    as character no-undo .
     2491                     define variable v-can-print  as logical   no-undo .
     2492                     assign
     2493                       v-today      = today
     2494                       v-date-start = v-today
     2495                       v-date-end   = v-today
     2496                       .
     2497                     run rep/chk-ahz.p
     2498                       (input Obj-type
     2499                       ,input Obj-code
     2500                       ,input false
     2501                       ,input true
     2502                       ,input false
     2503                       ,input false
     2504                       ,input false
     2505                       ,input 0
     2506                       ,input ""
     2507                       ,input-output v-date-start
     2508                       ,input-output v-date-end
     2509                       ,output       v-archive-ok
     2510                       ,output       v-comment
     2511                       ,output       v-can-print
     2512                       ) .
     2513                     load_version (iaddr).
     2514                     put-log(string (now) + "   Отправляем запрос для сравнения остатков...").
     2515                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?VerifyRest >&3", search ("exe/curl.exe"), iaddr, "verify-rest-temp.json").
     2516                     os-command silent value (vcmd).
     2517                     put-log(string (now) + "   Разбираем полученные данные...").
     2518                     fix-codepage_and_SetJsonObj(input "verify-rest-temp.json") .
     2519                     empty temp-table tt-stk-gd .
     2520                     parse-json(input temp-table tt-stk-gd:default-buffer-handle, input "tt-stk-gd") .
     2521                     empty temp-table tt-stk-fu .
     2522                     parse-json(input temp-table tt-stk-fu:default-buffer-handle, input "tt-stk-fu") .
     2523                     load_gds_maping(ifile-path).
     2524                     assign
     2525                       v-logfile-gd    = substitute("&1darw_util_verified_good.log", ibs.th.gbl.gbl-inipar:logDir)
     2526                       v-logfile-fu    = substitute("&1darw_util_verified_fuel.log", ibs.th.gbl.gbl-inipar:logDir)
     2527                       v-logfile-rj    = substitute("&1darw_util_rest_mismatch.log", ibs.th.gbl.gbl-inipar:logDir)
     2528                       v-count-confirm = 0
     2529                       v-count-decline = 0
     2530                       .
     2531                     put-log(string( now) + "   Начинаем сравнение остатков...") .
     2532                     empty temp-table tt-stk-fu2 .
     2533                     for each tt-stk-fu:
     2534                       find first tt-gds-mapping where tt-gds-mapping.gds-code15 = tt-stk-fu.gds-code no-error .
     2535                       if not available tt-gds-mapping then
     2536                       do :
     2537                         v-count-decline = v-count-decline + 1 .
     2538                         v-err-message = substitute("В файле соответствия отсутствует топливо &1", tt-stk-fu.gds-code) .
     2539                         put-log(v-err-message).
     2540                         next .
     2541                       end.
     2542                       assign
     2543                         v-fact-qnty-lt16 = 0
     2544                         v-fact-qnty-kg16 = 0
     2545                         .
     2546                       for each buf_pl-gds no-lock
     2547                         where buf_pl-gds.gds-code = tt-gds-mapping.gds-code16
     2548                         and buf_pl-gds.obj-type = Obj-type
     2549                         and buf_pl-gds.obj-code = Obj-code :
     2550                         assign
     2551                           v-fact-qnty-lt16 = v-fact-qnty-lt16 + buf_pl-gds.fact-qnty
     2552                           v-fact-qnty-kg16 = v-fact-qnty-kg16 + buf_pl-gds.cli-fact-qnty
     2553                           .
     2554                       end .
     2555                       find first tt-stk-fu2 where tt-stk-fu2.gds-code16 = tt-gds-mapping.gds-code16 no-error .
     2556                       if available tt-stk-fu2 then
     2557                       do :
     2558                         assign
     2559                           tt-stk-fu2.fact-qnty-lt16 = tt-stk-fu2.fact-qnty-lt16 + v-fact-qnty-lt16
     2560                           tt-stk-fu2.fact-qnty-kg16 = tt-stk-fu2.fact-qnty-kg16 + v-fact-qnty-kg16
     2561                           v-count-confirm           = v-count-confirm + 1
     2562         no-error .
     2563                       end .
     2564                       else
     2565                       do :
     2566                         create tt-stk-fu2 .
     2567                         buffer-copy tt-stk-fu to tt-stk-fu2 assign
     2568                           tt-stk-fu2.gds-code16     = tt-gds-mapping.gds-code16
     2569                           tt-stk-fu2.fact-qnty-lt16 = v-fact-qnty-lt16
     2570                           tt-stk-fu2.fact-qnty-kg16 = v-fact-qnty-kg16
     2571                           v-count-confirm = v-count-confirm + 1
     2572         no-error .
     2573                       end .
     2574                     end .
     2575                     empty temp-table tt-stk-gd2 .
     2576                     for each tt-stk-gd:
     2577                       find first tt-gds-mapping where tt-gds-mapping.gds-code15 = integer(tt-stk-gd.gds-code) no-error .
     2578                       if not available tt-gds-mapping then
     2579                       do :
     2580                         v-count-decline = v-count-decline + 1 .
     2581                         v-err-message = substitute("В файле соответствия отсутствует товар &1", tt-stk-gd.gds-code) .
     2582                         put-log(v-err-message).
     2583                         next .
     2584                       end.
     2585                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-mapping.gds-code16 no-error .
     2586                       if not available buf_goods then
     2587                       do :
     2588                         v-count-decline = v-count-decline + 1 .
     2589                         v-err-message = substitute( "В справочнике товаров отсутствует товар &1. Код в v&3 - &2"
     2590                           , tt-gds-mapping.gds-code16, tt-gds-mapping.gds-code15, version-name ) .
     2591                         put-log(v-err-message).
     2592                         next .
     2593                       end.
     2594                       assign
     2595                         v-fact-qnty16     = 0
     2596                         v-sum-rubl-cost16 = 0
     2597                         v-vat-rubl16      = 0
     2598                         v-sum-rubl-crsa16 = 0
     2599                         .
     2600                       find last buf_stk-line no-lock
     2601                         where buf_stk-line.obj-type   = Obj-type
     2602                         and buf_stk-line.obj-code   = Obj-code
     2603                         and buf_stk-line.artic      = buf_goods.artic
     2604                         and buf_stk-line.prod-type  = buf_goods.prod-type
     2605                         and buf_stk-line.prod-code  = buf_goods.prod-code
     2606                         and buf_stk-line.sum-type   = 'cost':U
     2607                         and buf_stk-line.cat-id     = '##,##':U
     2608                         and buf_stk-line.fact-date <= v-today
     2609                         use-index category no-error.
     2610                       if available buf_stk-line then assign
     2611                           v-fact-qnty16     = buf_stk-line.fact-qnty
     2612                           v-sum-rubl-cost16 = buf_stk-line.sum-rubl
     2613                           v-vat-rubl16      = buf_stk-line.VAT-rubl
     2614                           .
     2615                       find last buf_stk-line no-lock
     2616                         where buf_stk-line.obj-type   = Obj-type
     2617                         and buf_stk-line.obj-code   = Obj-code
     2618                         and buf_stk-line.artic      = buf_goods.artic
     2619                         and buf_stk-line.prod-type  = buf_goods.prod-type
     2620                         and buf_stk-line.prod-code  = buf_goods.prod-code
     2621                         and buf_stk-line.sum-type   = 'crsa':U
     2622                         and buf_stk-line.cat-id     = '##,##':U
     2623                         and buf_stk-line.fact-date <= v-today
     2624                         use-index category no-error.
     2625                       if available buf_stk-line then assign
     2626                           v-fact-qnty16     = buf_stk-line.fact-qnty when v-fact-qnty16 = 0
     2627                           v-sum-rubl-crsa16 = buf_stk-line.sum-rubl
     2628                           .
     2629                       find first tt-stk-gd2 where tt-stk-gd2.gds-code16 = tt-gds-mapping.gds-code16 no-error .
     2630                       if not available tt-stk-gd2 then
     2631                       do :
     2632                         create tt-stk-gd2 .
     2633                         buffer-copy tt-stk-gd to tt-stk-gd2
     2634                           assign
     2635                           tt-stk-gd2.gds-code16      = tt-gds-mapping.gds-code16
     2636                           tt-stk-gd2.fact-qnty16     = v-fact-qnty16
     2637                           tt-stk-gd2.sum-rubl-cost16 = v-sum-rubl-cost16
     2638                           tt-stk-gd2.vat-rubl16      = v-vat-rubl16
     2639                           tt-stk-gd2.sum-rubl-crsa16 = v-sum-rubl-crsa16
     2640                           tt-stk-gd2.gds-code15 = string(tt-stk-gd.gds-code)
     2641                           tt-stk-gd2.gds-name = buf_goods.gds-name
     2642                           v-count-confirm = v-count-confirm + 1
     2643                           no-error .
     2644                       end .
     2645                       else
     2646                       do:
     2647                         assign
     2648                           tt-stk-gd2.gds-code15      = string(tt-stk-gd2.gds-code15) + ", " + string(tt-stk-gd.gds-code)
     2649                           tt-stk-gd2.fact-qnty16     = v-fact-qnty16
     2650                           tt-stk-gd2.sum-rubl-cost16 = v-sum-rubl-cost16
     2651                           tt-stk-gd2.vat-rubl16      = v-vat-rubl16
     2652                           tt-stk-gd2.sum-rubl-crsa16 = v-sum-rubl-crsa16
     2653                           tt-stk-gd2.fact-qnty       = tt-stk-gd2.fact-qnty + tt-stk-gd.fact-qnty
     2654                           tt-stk-gd2.sum-rubl-cost   = tt-stk-gd2.sum-rubl-cost + tt-stk-gd.sum-rubl-cost
     2655                           tt-stk-gd2.vat-rubl        = tt-stk-gd2.vat-rubl + tt-stk-gd.vat-rubl
     2656                           tt-stk-gd2.sum-rubl-crsa   = tt-stk-gd2.sum-rubl-crsa + tt-stk-gd.sum-rubl-crsa
     2657                           v-count-confirm            = v-count-confirm + 1
     2658                           .
     2659                       end.
     2660                       tt-stk-gd2.gds-code15 = trim(tt-stk-gd2.gds-code15,",").
     2661                     end .
     2662                     v-count-mismatch = 0 .
     2663                     define variable vFirst as logical no-undo.
     2664                     output STREAM lsOut to value(v-logfile-rj).
     2665                     output STREAM lsIN  to value(v-logfile-gd).
     2666                     put stream lsIn unformatted
     2667                       "наименование товара в 16.0;"
     2668                       "код товара в " + string(version-name) +  ";"
     2669                       "количество в " + string(version-name) +  ";"
     2670                       "сумма в учетных ценах в " + string(version-name) +  ";"
     2671                       "сумма НДС в учетных ценах в " + string(version-name) +  ";"
     2672                       "сумма в продажных ценах в " + string(version-name) +  ";"
     2673                       "код товара в 16.0;"
     2674                       "количество в 16.0;"
     2675                       "сумма в учетных ценах в 16.0;"
     2676                       "сумма НДС в учетных ценах в 16.0;"
     2677                       "сумма в продажных ценах в 16.0" skip
     2678                       .
     2679                     Vfirst = yes.
     2680                     put stream lsOut unformatted skip
     2681                       "Расхождения по товарам:" skip.
     2682                     for each tt-stk-gd2:
     2683                       export stream lsIN delimiter ';':U tt-stk-gd2 .
     2684                       assign
     2685                         v-sum-rubl-delta = truncate(tt-stk-gd2.sum-rubl-cost16 - tt-stk-gd2.sum-rubl-cost, 4)
     2686                         v-vat-rubl-delta = truncate(tt-stk-gd2.vat-rubl16      - tt-stk-gd2.vat-rubl,      4)
     2687                         .
     2688                       if (tt-stk-gd2.fact-qnty16     <> tt-stk-gd2.fact-qnty)
     2689                         or (v-sum-rubl-delta <> 0)
     2690                         or (v-vat-rubl-delta <> 0)
     2691                         or (tt-stk-gd2.sum-rubl-crsa16 <> tt-stk-gd2.sum-rubl-crsa)
     2692                         then
     2693                       do :
     2694                         if vFirst
     2695                           then
     2696                         do:
     2697                           vfirst = no.
     2698                           put stream lsOut unformatted
     2699                             "наименование товара в 16.0;"
     2700                             "код товара в " + string(version-name) +  ";"
     2701                             "количество в " + string(version-name) +  ";"
     2702                             "сумма в учетных ценах в " + string(version-name) +  ";"
     2703                             "сумма НДС в учетных ценах в " + string(version-name) +  ";"
     2704                             "сумма в продажных ценах в " + string(version-name) +  ";"
     2705                             "код товара в 16.0;"
     2706                             "количество в 16.0;"
     2707                             "сумма в учетных ценах в 16.0;"
     2708                             "сумма НДС в учетных ценах в 16.0;"
     2709                             "сумма в продажных ценах в 16.0" skip
     2710                             .
     2711                         end.
     2712                         export stream lsOut delimiter ';':U tt-stk-gd2 .
     2713                         v-count-mismatch = v-count-mismatch + 1 .
     2714                       end .
     2715                     end.
     2716                     if Vfirst
     2717                       then
     2718                       put stream lsOut unformatted "Расхождений не обнаружено." skip.
     2719                     else
     2720                       Vfirst = yes.
     2721                     output STREAM lsIN close.
     2722                     put stream lsOut unformatted skip
     2723                       "Расхождения по топливу:" skip.
     2724                     output STREAM lsIN to value(v-logfile-fu).
     2725                     put stream lsIn unformatted
     2726                       "наименование товара в 16.0;"
     2727                       "код товара в " + string(version-name) +  ";"
     2728                       "остатки в лт в " + string(version-name) +  ";"
     2729                       "остатки в кг в " + string(version-name) +  ";"
     2730                       "код товара в 16.0;"
     2731                       "остатки в лт в 16.0;"
     2732                       "остатки в кг в 16.0" skip
     2733                       .
     2734                     for each tt-stk-fu2:
     2735                       export stream lsIN delimiter ';':U tt-stk-fu2 .
     2736                       if (tt-stk-fu2.fact-qnty-lt16 <> tt-stk-fu2.fact-qnty-lt)
     2737                         or (tt-stk-fu2.fact-qnty-kg16 <> tt-stk-fu2.fact-qnty-kg)
     2738                         then
     2739                       do :
     2740                         if vfirst
     2741                           then
     2742                         do:
     2743                           vfirst = no.
     2744                           put stream lsOut unformatted
     2745                             "наименование товара в 16.0;"
     2746                             "код товара в " + string(version-name) +  ";"
     2747                             "остатки в лт в " + string(version-name) +  ";"
     2748                             "остатки в кг в " + string(version-name) +  ";"
     2749                             "код товара в 16.0;"
     2750                             "остатки в лт в 16.0;"
     2751                             "остатки в кг в 16.0" skip
     2752                             .
     2753                         end.
     2754                         export stream lsOut delimiter ';':U tt-stk-fu2 .
     2755                         v-count-mismatch = v-count-mismatch + 1 .
     2756                       end .
     2757                     end.
     2758                     if Vfirst
     2759                       then
     2760                       put stream lsOut unformatted "Расхождений не обнаружено." skip.
     2761                     vok = yes.
     2762                     finally:
     2763                       if not mDebug then
     2764                       do:
     2765                         os-delete value("verify-rest-temp.json") .
     2766                         os-delete value("verify-rest.json") .
     2767                       end.
     2768                       output STREAM lsIN close.
     2769                       output STREAM lsOUT close.
     2770                       if vok then
     2771                       do :
     2772                         put-log( string(now) + "   Сравнение остатков выполнено." ) .
     2773                         put-log(    substitute("   Всего в сравнении &1 записей о товарах и о топливе,", v-count-confirm + v-count-decline) ) .
     2774                         put-log(    substitute("   из них для &1 записей найдены товары для сравнения в вер.16.0, а для &2 записей товары для сравнения в вер.16.0 отсутствуют.",
     2775                           v-count-confirm, v-count-decline) ) .
     2776                         put-log(    substitute("   При сравнении остатков выявлено &1 расхождений среди &2 товаров, найденных для сравнения в вер.16.", v-count-mismatch, v-count-confirm) ) .
     2777                         put-log(    substitute("   Файл со сравнением товаров: &1",                  v-logfile-gd)     ) .
     2778                         put-log(    substitute("   Файл со сравнением топлива: &1",                  v-logfile-fu)     ) .
     2779                         put-log(    substitute("   Файл с расхождениями: &1",                        v-logfile-rj)     ) .
     2780                       end .
     2781                       else
     2782                         put-log( string(now) + "   Сравнение остатков не выполнено!") .
     2783                       put-log("").
     2784                       return vok.
     2785                     end finally.
     2786                   end method .
     2787                   method public logical load_rest_fin (
     2788                     iosn-fname   as character,  // список соответствия поставщиков
     2789                     iart-fname   as  character, // список соответствия товаров
     2790                     icontr       as character,  // контрагент для ПКО РКО
     2791                     iretry-fname as character   // файл для повторного импорта
     2792                     ):
     2793                     return load_rest_fin(maddr, iosn-fname, iart-fname, icontr, iretry-fname).
     2794                   end method.
     2795                   method public logical load_rest_fin (iaddr as character,
     2796                     iosn-fname   as character,  // список соответствия поставщиков
     2797                     iart-fname   as  character, // список соответствия товаров
     2798                     icontr       as character,  // контрагент для ПКО РКО
     2799                     iretry-fname as character   // файл для повторного импорта
     2800                     ):
     2801                     define variable vcmd              as character no-undo.
     2802                     define variable vOk               as logical   no-undo.
     2803                     define variable p-doc-rec         as recid     no-undo .
     2804                     define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     2805                     define variable p-by-cash-desk    as logical   no-undo .
     2806                     define variable p-by-petrol-goods as logical   no-undo .
     2807                     define variable p-by-osnovanie    as character no-undo .
     2808                     define variable p-by-pril         as character no-undo .
     2809                     define variable v-naznach-plat    as character no-undo .
     2810                     define variable v-naznach-plat2   as character no-undo .
     2811                     define variable o-uchet           as character no-undo .
     2812                     define variable v-uchet           as character no-undo .
     2813                     define variable v-real-obj-type   as character no-undo .
     2814                     define variable v-real-obj-code   as integer   no-undo .
     2815                     define variable v-limit-access    as integer   no-undo .
     2816                     define variable v-base-code       as integer   no-undo .
     2817                     define variable mOsnbag           as character no-undo.
     2818                     define variable msumInc-save      as decimal   no-undo.
     2819                     define variable mMoney            as character no-undo.
     2820   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2821   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2822   run basecode in ibs.th.gbl.gbl-hndllib:g#library
     2823     (input  v-cntxt-host-code-obj
     2824     ,output v-base-code
     2825     )  .
     2826                       mCashBook = new ibs.th.ref.cashbookstorage () .
     2827                     define buffer buf_temp-fin-sum for temp-fin-sum .
     2828                     define buffer buf_temp-tax     for temp-tax .
     2829                     define buffer buf_fin-doc      for ub.fin-doc .
     2830                     define buffer buf_fin-doc-tax  for ub.fin-doc-tax .
     2831                     define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     2832                     define buffer buf_payment      for ub.payment .
     2833                     define buffer buf_shift-obj    for ub.shift-obj.
     2834                     empty temp-table tt-rest-fin .
     2835                     empty temp-table temp-tax .
     2836                     put-log(string (now) + "   Отправляем запрос для получения денежных остатков...").
     2837                     vcmd = substitute ("&1 --http0.9 &2/THGetInfo?GetRestFin >&3", search ("exe/curl.exe"), iaddr, "rest-fin-temp.json").
     2838                     os-command silent value (vcmd).
     2839                     fix-codepage_and_SetJsonObj (input "rest-fin-temp.json") .
     2840                     parse-json(input temp-table tt-rest-fin:default-buffer-handle, input "tt-rest-fin") .
     2841                     put-log ( string(now) +  "   Начинаем загрузку денежных остатков...") .
     2842                     define variable v-count-err as integer no-undo .
     2843                     find last buf_shift-obj
     2844                       where buf_shift-obj.obj-type    = v-cntxt-obj-type
     2845                       and buf_shift-obj.obj-code    = v-cntxt-obj-code
     2846                       no-error.
     2847                     for each tt-rest-fin:
     2848                       find first ub.CashBook no-lock where ub.CashBook.id = tt-rest-fin.CashBookId no-error .
     2849                       if not available (ub.CashBook) then next .
     2850                       find first buf_temp-fin-sum
     2851                         where buf_temp-fin-sum.curr-code = 0
     2852                         and buf_temp-fin-sum.cashbookid = tt-rest-fin.CashBookId
     2853                         and buf_temp-fin-sum.is-expense_cash = no
     2854                         no-error.
     2855                       if not available buf_temp-fin-sum
     2856                         then
     2857                       do:
     2858                         create buf_temp-fin-sum.
     2859                         assign
     2860                           buf_temp-fin-sum.curr-code       = 0
     2861                           buf_temp-fin-sum.cash-desk       = 0
     2862                           buf_temp-fin-sum.is-petrol       = no
     2863                           buf_temp-fin-sum.cashbookid      = tt-rest-fin.CashBookId
     2864                           buf_temp-fin-sum.is-expense_cash = no
     2865                           .
     2866                       end.
     2867                       assign
     2868                         buf_temp-fin-sum.tot-rubl = buf_temp-fin-sum.tot-rubl + tt-rest-fin.ostatok
     2869                         buf_temp-fin-sum.tot-base = buf_temp-fin-sum.tot-base + tt-rest-fin.ostatok
     2870                         buf_temp-fin-sum.tot-sum  = buf_temp-fin-sum.tot-sum + tt-rest-fin.ostatok
     2871                         .
     2872                       if buf_temp-fin-sum.tot-sum eq 0
     2873                         then delete buf_temp-fin-sum.
     2874                       else
     2875                       do:
     2876                         create buf_temp-tax.
     2877                         assign
     2878                           buf_temp-tax.curr-code        = buf_temp-fin-sum.curr-code
     2879                           buf_temp-tax.cash-desk        = buf_temp-fin-sum.cash-desk
     2880                           buf_temp-tax.is-petrol        = buf_temp-fin-sum.is-petrol
     2881                           buf_temp-tax.cashbookId       = buf_temp-fin-sum.cashbookid
     2882                           buf_temp-tax.is-expense_cash  = buf_temp-fin-sum.is-expense_cash
     2883                           buf_temp-tax.num-expense_cash = buf_temp-fin-sum.num-expense_cash
     2884                           buf_temp-tax.sum-rubl         = buf_temp-fin-sum.tot-sum
     2885                           buf_temp-tax.sum-base         = buf_temp-fin-sum.tot-sum
     2886                           buf_temp-tax.sum-doc          = buf_temp-fin-sum.tot-sum
     2887                           .
     2888                       end.
     2889                     end.
     2890                     _temp-fin-sum:
     2891                     for each buf_temp-fin-sum no-lock
     2892                       by buf_temp-fin-sum.cashbookid desc
     2893                       :
     2894                       empty temp-table tt0-fin-doc-tax.
     2895                       empty temp-table tt0-fin-doc-attr.
     2896                       empty temp-table tt-fin-doc.
     2897                       if buf_temp-fin-sum.tot-sum = 0  then
     2898                       do:
     2899                         next _temp-fin-sum.
     2900                       end.
     2901                       find first ub.CashBook no-lock where ub.CashBook.id = buf_temp-fin-sum.CashBookId no-error .
     2902                       define variable mCashbookName as character no-undo.
     2903                       mCashbookName = string(ub.CashBook.id).
     2904                       if available ub.CashBook then
     2905                       do:
     2906                         assign
     2907                           v-real-obj-type = mCashBook:getSinglRule(buf_temp-fin-sum.CashBookId, 'всем':U, 0, "CountCollect-type") .
     2908                         v-real-obj-code = int(mCashBook:getSinglRule(buf_temp-fin-sum.CashBookId, 'всем':U, 0, "CountCollect-code") ).
     2909                         mCashbookName = string(ub.CashBook.id) + " (" + CashBook.CashBookName + ")".
     2910                         .
     2911                       end.
     2912                       define variable v-doc-rec          as recid     no-undo .
     2913                       define variable v-fin-doc-type     as character no-undo .
     2914                       define variable v-fin-ext-doc-type as character no-undo .
     2915                       if  buf_temp-fin-sum.tot-rubl > 0 then
     2916                         assign
     2917                           v-fin-doc-type     = 'пко':U
     2918                           v-fin-ext-doc-type = 'пко':U.
     2919                       else
     2920                         assign
     2921                           v-fin-doc-type     = 'рко':U
     2922                           v-fin-ext-doc-type = 'рко':U.
     2923                       run ref/finfnoco.p (
     2924                         INPUT parParentProc
     2925                         ,INPUT ?
     2926                         ,input v-host-code
     2927                         ,input ('ДОБАВЛЕНИЕ':U + chr(4) + 'auto':U + chr(4) + "тех_")
     2928                         ,input v-host-code
     2929                         ,input v-doc-rec
     2930                         ,input 0
     2931                         ,input v-fin-doc-type
     2932                         ,input v-fin-ext-doc-type
     2933                         ,input v-cntxt-obj-type
     2934                         ,input v-cntxt-obj-code
     2935                         ,input 0
     2936                         ,input ''
     2937                         ,input 'орг':U
     2938                         ,input v-host-code
     2939                         ,input 0
     2940                         ,input v-real-obj-type
     2941                         ,input v-real-obj-code
     2942                         ,input 0
     2943                         ,input buf_temp-fin-sum.curr-code
     2944                         ,input 0
     2945                         ,input 0
     2946                         ,input 0
     2947                         ,input 0
     2948                         ,input buf_temp-fin-sum.cashbookid
     2949                         ,input ""
     2950                         ,INPUT-OUTPUT table tt-fin-doc
     2951                         ,INPUT-OUTPUT table ttc-fin-doc
     2952                         ,output table tt0-fin-doc-attr
     2953                         ,output v-limit-access ) no-error.
     2954                       if error-status:error then
     2955                       do:
     2956                         put-log(substitute("Ошибки при заполнении фин.док-та значениями по умолчанию &1 &2 ",chr(10),RETURN-VALUE)).
     2957                       end.
     2958                       find first tt-fin-doc.
     2959                       define variable v-line-num as integer no-undo .
     2960                       for each buf_temp-tax no-lock
     2961                         where buf_temp-tax.curr-code        = buf_temp-fin-sum.curr-code
     2962                         and buf_temp-tax.cash-desk         = buf_temp-fin-sum.cash-desk
     2963                         and buf_temp-tax.is-petrol        = buf_temp-fin-sum.is-petrol
     2964                         and buf_temp-tax.cashbookId       = buf_temp-fin-sum.cashbookId
     2965                         and buf_temp-tax.is-expense_cash  = buf_temp-fin-sum.is-expense_cash
     2966                         and buf_temp-tax.num-expense_cash = buf_temp-fin-sum.num-expense_cash
     2967                         :
     2968                         v-line-num = v-line-num + 1.
     2969                         create tt0-fin-doc-tax .
     2970                         assign
     2971                           tt0-fin-doc-tax.fin-doc-code       = tt-fin-doc.fin-doc-code
     2972                           tt0-fin-doc-tax.host-code          = tt-fin-doc.host-code
     2973                           tt0-fin-doc-tax.line-num           = v-line-num
     2974                           tt0-fin-doc-tax.VAT-pc             = buf_temp-tax.vat-pc
     2975                           tt0-fin-doc-tax.slt-pc             = buf_temp-tax.slt-pc
