       12     define variable v-cntxt-db-num-obj    as integer   no-undo .
       13     define variable v-cntxt-is-admin      as logical   no-undo .
       14     define public variable Obj-type    as character no-undo.
       15     define public variable Obj-code    as integer   no-undo.
       16     define public variable v-host-code as integer   no-undo .
       17     define public variable mDebug      as logical   no-undo.
       18     define property parparentproc as handle no-undo
