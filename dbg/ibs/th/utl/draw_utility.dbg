      122           method private void button12_Click( input sender as System.Object, input e as System.EventArgs ):
      123      define variable vi as integer no-undo.
      124      define variable vleg as integer no-undo.
      125      this-object:openFileDialog1:FileName = this-object:listBox2:Text.
      126      this-object:openFileDialog1:Multiselect = true .
      127      wait-for this-object:openFileDialog1:ShowDialog().
      128      do vi = 0 to this-object:openFileDialog1:FileNames:Length - 1:
      129      if not listBox2:Items:Contains(this-object:openFileDialog1:FileNames:GetValue(vi))
      130      then do:
      131         listBox2:Items:add(this-object:openFileDialog1:FileNames:GetValue(vi)).
      132         listBox2:SetSelected(listBox2:Items:IndexOf(this-object:openFileDialog1:FileNames:GetValue(vi)), true).
      133      end.
      134     end.
      135         return.
      136           end method.
