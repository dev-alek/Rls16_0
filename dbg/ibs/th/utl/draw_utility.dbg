       77     constructor public draw_utility (  ):
       78       super().
       79       InitializeComponent().
       80       this-object:ComponentsCollection:ADD(this-object:components).
       81       mUtil  = new ibs.th.utl.method-for-draw-utility().
       82       mutil:write-log:SUBSCRIBE (this-object:write-log).
       83         textBox1:text = getPARAM("host").
       84         if textBox1:text eq ""
       85         then
       86         textBox1:text = "localhost:8080".
       87         textBox2:text = getPARAM("correspondence_gds").
       88         textBox3:text = getPARAM("correspondence_supp").
       89       catch e as Progress.Lang.Error:
       90         undo, throw e.
       91       end catch.
       92     end constructor.
