      336     method private void load_rest(  ):
      337       if not mutil:chek_rvs()
      338       then do:
      339          message "Выполните этап 1"
      340          view-as alert-box.
      341          return.
      342       end.
      343       mutil:mAddr = textbox1:Text.
      344       if checkBox19:checked and checkBox19:Enabled = true
      345       then do:
      346          checkBox19:checked = mutil:load_rest(textbox3:text,textbox2:text,"").
      347       if not checkBox19:checked
      348         then .
      349       else checkBox19:Enabled = false .
      350       end.
      351       if checkBox20:checked and checkBox20:Enabled = true
      352       then do:
      353          checkBox20:checked = mutil:load_rest_ptrl(textbox3:text,textbox2:text,"").
      354       if not checkBox20:checked
      355         then .
      356       else checkBox20:Enabled = false .
      357       end.
      358       if checkBox30:checked and checkBox30:Enabled = true
      359       then do:
      360          checkBox30:checked = mutil:load_rest_fin(textbox3:text,textbox2:text,Lincasagent:Text,"").
      361       if not checkBox30:checked
      362         then .
      363       else checkBox30:Enabled = false .
      364       end.
      365      end method.
      366      method private void close_shift(  ):
      367       if not checkBox20:checked
      368       then do:
      369          message "Выполните этап 3"
      370          view-as alert-box.
      371          return.
      372       end.
      373       mutil:mAddr = textbox1:Text.
      374       checkBox21:checked =  mutil:chek_rvs-shift().
      375       if not checkBox21:checked
      376       then
      377          checkBox21:checked = mutil:load_rvs(textbox2:text).
      378       if    checkBox21:checked
      379       then
      380          checkBox22:checked =  mutil:chek_rvs-close().
      381       if        checkBox21:checked
      382         and not checkBox22:checked
      383       then
      384           checkBox22:checked = mutil:close-rvs-all ().
      385       return.
      386     end method.
