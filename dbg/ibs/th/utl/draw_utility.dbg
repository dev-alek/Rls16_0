     1112                method public  void SavePARAMs ():
     1113           SavePARAMs("draw-util-param.txt").
     1114       end method.
     1115       method public  void SavePARAMs (  input iFile as char ):
     1116           output to value (iFile).
     1117           SavePARAM("host",textBox1:Text).
     1118           SavePARAM("correspondence_gds",  textBox2:Text).
     1119           SavePARAM("correspondence_supp", textBox3:Text).
     1120           SavePARAM("darw_util_pswd",      string(checkBox25:checked)).
     1121           SavePARAM("darw_util_user",      string(checkBox26:checked)).
     1122           output close.
     1123       end method.
     1124       method public  void SavePARAM ( input iName as char, input iValue as char ):
     1125           put unformatted SUBSTITUTE("<PARAM name='&1'>", iName).
     1126           put unformatted iValue.
     1127           put unformatted SUBSTITUTE("</PARAM name='&1'>", iName) skip.
     1128       end method.
     1129       method public char GetPARAM (  input iName as char ):
     1130            return GetPARAM ( "draw-util-param.txt", iName  ).
     1131       end method.
     1132       method public char GetPARAM ( input iFile as char, input iName as char ):
     1133           def var vLob  as longchar no-undo.
     1134           def var vFrom as int64    no-undo.
     1135           def var vTo   as int64    no-undo.
     1136           if not FileExists (iFile) then return ?.
     1137           copy-lob file iFile to vLob no-error.
     1138           vFrom = index(vLob, SUBSTITUTE("<PARAM name='&1'>", iName)).
     1139           if vFrom <= 0 then return ?.
     1140           assign
     1141               vTo = index(vLob, SUBSTITUTE("</PARAM name='&1'>", iName))
     1142               vFrom = vFrom + LENGTH(SUBSTITUTE("<PARAM name='&1'>", iName)).
     1143           if vTo < vFrom then return ?.
     1144           return string(substring(vLob, vFrom, vTo - vFrom)).
     1145       end method.
     1146       method public logical FileExists  (input  ifolder as character ):
     1147           return objExists(ifolder,"F") ne ?.
     1148       end.
     1149       method public character  objExists  (input  ifolder as character,
     1150           input  iType   as character  ):
     1151           define variable vPureName  as character no-undo.
     1152           define variable vFullPath as character no-undo.
     1153           define variable vFileType as character no-undo.
     1154           file-information:file-name = ifolder.
     1155           if index( file-information:file-type, iType ) > 0 then return file-information:full-pathname .
     1156           file-information:file-name = "./" + ifolder.
     1157           if index( file-information:file-type, iType ) > 0 then return file-information:full-pathname .
     1158           return ? .
     1159      end method.
