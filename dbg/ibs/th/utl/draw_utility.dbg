      391     method private void InitChekBox():
      392        checkBox1:checked = mutil:Chek_Shem().
      393        checkBox2:checked = mutil:chek_cash_desk().
      394        checkBox3:checked = mutil:chek-sht-open().
      395        checkBox4:checked = mutil:chek_rvs().
      396        checkBox5:checked = mutil:chek_price().
      397        checkBox6:checked = mutil:chek_pumpdoc().
      398        define variable v-log-param as logical no-undo .
      399        v-log-param = logical( getPARAM("darw_util_pswd") ) no-error .
      400        checkBox25:checked = if v-log-param then true else false.
      401        v-log-param = logical( getPARAM("darw_util_user") ) no-error .
      402       checkBox21:checked =  mutil:chek_rvs-shift().
      403       checkBox22:checked = mutil:chek_rvs-close().
      404       checkBox26:checked = if v-log-param then true else false.
      405       checkBox19:checked = mutil:chek_rest().
      406       if checkBox19:Checked then checkBox19:Enabled = false .
      407       checkBox20:checked = mutil:chek_rest_ptrl().
      408       if checkBox20:Checked then checkBox20:Enabled = false .
      409       checkBox30:checked = mutil:chek_rest_fin().
      410       if checkBox30:Checked then checkBox30:Enabled = false .
      411       checkBox27:checked = mutil:chek_schedule().
      412       checkBox29:checked = mutil:chek_fbrgds().
      413     end method .
      414     method private void BtnStart():
      415       define variable string-cash as character no-undo .
      416       mutil:mAddr = textbox1:Text.
      417       mUtil:load_version().
      418       checkBox1:checked = mutil:Chek_Shem().
      419       if not checkBox1:checked
      420       then do:
      421          mutil:load_schem(textBox2:text).
      422          checkBox1:checked = mutil:Chek_Shem().
      423       end.
      424        checkBox2:checked = mutil:chek_cash_desk().
      425        if         checkBox1:checked
      426           and not checkBox2:checked
      427        then do:
      428           string-cash = mutil:load_cashdesk().
      429           checkBox2:checked = mutil:chek_cash_desk().
      430        end.
      431        checkBox3:checked = mutil:chek-sht-open().
      432        if         checkBox2:checked
      433           and not checkBox3:checked
      434        then do:
      435           mutil:sht-open().
      436           checkBox3:checked = mutil:chek-sht-open().
      437        end.
      438         checkBox5:checked = mutil:chek_price().
      439        if         checkBox3:checked
      440           and not checkBox5:checked
      441        then do:
      442           mutil:load_price(textBox2:text).
      443          checkBox5:checked = mutil:chek_price().
      444       end.
      445        checkBox4:checked = mutil:chek_rvs().
