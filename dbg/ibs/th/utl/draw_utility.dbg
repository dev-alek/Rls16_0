       99           method private void button11_Click( input sender as System.Object, input e as System.EventArgs ):
      100         define variable ref-rec  as recid     no-undo .
      101         define variable ref-list as character no-undo.
      102         run ref/cli-all.w ( input parParentProc
      103            ,input "b-sel"
      104            ,input "все"
      105            ,input ?
      106            ,input ?
      107            ,input ?
      108            ,input ?
      109            ,input ?
      110            ,output ref-list) .
      111         if ref-list = "" then
      112         do:
      113            return .
      114         end.
      115         ref-rec = integer( ref-list ).
      116         FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
      117         this-object:Lincasagent:Text = ub.clients.obj-type + string(ub.clients.obj-code) + "_" + ub.clients.obj-name .
      118         this-object:Lincasagent:Focus().
      119         return.
      120           end method.
