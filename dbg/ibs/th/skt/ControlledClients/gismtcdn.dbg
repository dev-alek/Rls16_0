        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.Adapters.LogWrite.
        4   using ibs.th.gbl.propmap.
        5   using ibs.th.gbl.sys.objsrv.
        6   using ibs.th.gbl.sys.objth.
        7   using Progress.Lang.*.
        8   block-level on error undo, throw.
        9   class ibs.th.skt.ControlledClients.GisMtCDN inherits objth :
       10     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       11     define override public property vss-author      as character no-undo init "$Author:$":U get.
       12     define override public property vss-date        as character no-undo init "$Date:$":U get.
       13     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       14     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       15     define override public property vss-description as character no-undo init "Работа с CDN площадками ГИС МТ" get.
       16     define temp-table tthosts-body  no-undo serialize-name  "bodys"
       17      field code            as int
       18      field description     as char
       19      field avgTimeMs       as int
       20      .
       21     define temp-table tthosts no-undo
       22      SERIALIZE-NAME "hosts"
       23      field reqid        as recid serialize-hidden
       24      field host_adr     as char SERIALIZE-NAME "host"
       25      index reqidpar reqid host_adr
       26      .
       27     define temp-table tthosts-adr  no-undo serialize-name  "bodys"
       28      field code            as int
       29      field description     as char
       30      field avgTimeMs       as int
       31      .
       32     define temp-table tt-code no-undo like ub.code.
       33     define dataset gismt-host-body SERIALIZE-HIDDEN  for tthosts-body, tthosts
       34        PARENT-ID-RELATION FOR tthosts-body, tthosts PARENT-ID-FIELD reqid .
       35     define dataset gismt-host-adr SERIALIZE-HIDDEN  for tthosts-adr .
       36     define stream out_data.
       37   method public character objExists
       38   (input  ifolder as character,
       39    input  iType   as character  ):
       40       define variable vFileType as character no-undo init "D,F".
       41       define variable vi        as integer no-undo.
       42       define variable vtype as character no-undo.
       43       if iType ne ?
       44       then
       45          vFileType = iType.
       46       do vi = 1 to num-entries(vFileType):
       47          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       48          vtype = file-information:file-type.
       49          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       50             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       51             index(vtype , entry(vi,vFileType )) > 0
       52          then return file-information:full-pathname .
       53          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       54          vtype = file-information:file-type.
       55          if file-information:file-name <> "" and
       56             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       57             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       58             index( vtype, entry(vi,vFileType )) > 0
       59          then return file-information:full-pathname .
       60       end.
       61       return ? .
       62   end.
       63   method public character SearchFile
       64   (input  ifile as character):
       65      return objExists(ifile,?).
       66   end.
       67   method public character SearchPFile
       68   (input inFile as char):
       69        define variable oFile       as character no-undo.
       70        define variable vFileSearch as character no-undo.
       71        define variable vNumEntry   as integer no-undo.
       72        if inFile = "" then return ?.
       73        vNumEntry = num-entries(inFile,".").
       74        vFileSearch = inFile.
       75        if    vNumEntry > 0
       76           and (   entry(vNumEntry,inFile,".") eq "p"
       77                or entry(vNumEntry,inFile,".") eq "w")
       78        then do:
       79           entry(vNumEntry,vFileSearch, ".") = "r".
       80           oFile = search(vFileSearch ).
       81           if oFile eq ?
       82           then
       83              oFile = search(inFile).
       84        end.
       85        else
       86           oFile = search(vFileSearch).
       87        return oFile.
       88     end.
       89    define variable gismt-AdressPort   as character no-undo.
       90    define variable gismt-DopParam     as character no-undo.
       91    define variable gismt-GisAdress    as character no-undo.
       92    define variable gismt-ProxyLogin   as character no-undo.
       93    define variable gismt-ProxyPswd    as character no-undo.
       94    define variable gismt-MaxTime      as integer   no-undo.
       95    define variable gismt-RegKey       as character no-undo.
       96    define variable gismt-TimeFalStart as integer   no-undo.
       97    define variable gismt-WaitTime     as decimal   no-undo.
       98    define variable gismt-WaitTimePlus as decimal   no-undo.
       99    define variable gismt-CrashSituat  as logical   no-undo.
      100    define variable gismt-BanDate      as integer   no-undo.
      101    define variable gismt-cdnTurnOn    as logical   no-undo.
      102    define variable gismt-cdnAdress    as character no-undo.
      103    define variable gismt-cdnRepeat    as logical   no-undo.
      104    define variable gismt-cdnChange    as logical   no-undo.
      105    define variable gismt-cdnTimeUpd   as integer   no-undo.
      106    define variable gismt-UpdateRequest as logical   no-undo.
      107    define variable gismt-OflineAdress  as character no-undo.
      108    define variable gismt-OflineAutoriz as character no-undo.
      109    define variable gismt-OflineLogin   as character no-undo.
      110    define variable gismt-OflinePswd    as character no-undo.
      111    define variable gismt-OflineDate    as date      no-undo.
      112   method public character ConvBase64
      113   (input iString as char):
      114     define variable vSize       as integer   no-undo.
      115     define variable vDataDc1    as memptr    no-undo.
      116     define variable vDataDc2    as memptr    no-undo.
      117     define variable vEnCode     as character no-undo.
      118     define variable vBase64Str  as character no-undo.
      119     do
      120     on error undo, return error return-value
      121     :
      122       if iString = ?
      123       then return "".
      124       vSize  = length(iString).
      125       SET-SIZE(vDataDc1 ) = vSize + 1.
      126       SET-SIZE(vDataDc2 ) = vSize.
      127       put-string(vDataDc1, 1, vSize) = iString.
      128       copy-lob from vDataDc1 starting at 1 for vSize to vDataDc2 no-convert.
      129       vEnCode =  base64-encode (vDataDc2).
      130       vBase64Str = substring(vEnCode,1).
      131       SET-SIZE(vDataDc1)  = 0 no-error.
      132       SET-SIZE(vDataDc2)  = 0 no-error.
      133     end.
      134     return vBase64Str.
      135   end.
      136   method public character get-thbj-attr-prop
      137   (input p-obj-type as char,
      138    input p-obj-code as int,
      139    input p-upper-prop-code as char,
      140    input p-prop-code as char
      141    ):
      142       define buffer buf_thbj-attr for ub.thbj-attr.
      143       define variable v-reg-code as integer no-undo.
      144       find first buf_thbj-attr no-lock where
      145                  buf_thbj-attr.obj-type = p-obj-type
      146              and buf_thbj-attr.obj-code = p-obj-code
      147              and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      148              and buf_thbj-attr.prop-code = p-prop-code
      149       no-error.
      150       if not available buf_thbj-attr and p-obj-type = 'БД':U then
      151       do:
      152   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   run regcode in ibs.th.gbl.gbl-hndllib:g#library
      154     (input  p-obj-type
      155     ,input  p-obj-code
      156     ,output v-reg-code
      157     )  .
      158          if v-reg-code <> ? and v-reg-code <> 0 then do:
      159              find first buf_thbj-attr no-lock where
      160                         buf_thbj-attr.obj-type = 'регион':U
      161                     and buf_thbj-attr.obj-code = v-reg-code
      162                     and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      163                     and buf_thbj-attr.prop-code = p-prop-code
      164              no-error.
      165          end.
      166       end.
      167       if not available buf_thbj-attr and p-obj-type <> ""
      168       then do:
      169          find first buf_thbj-attr no-lock where
      170                     buf_thbj-attr.obj-type = ""
      171                 and buf_thbj-attr.obj-code = 0
      172                 and buf_thbj-attr.upper-prop-code = p-upper-prop-code
      173                 and buf_thbj-attr.prop-code = p-prop-code
      174          no-error.
      175       end.
      176       if avail buf_thbj-attr then do:
      177           case buf_thbj-attr.prop-value-type:
      178               when "character"
      179                  then return buf_thbj-attr.property-value-character.
      180               when "integer"
      181                  then return string(buf_thbj-attr.property-value-integer).
      182               when "decimal"
      183                  then return string(buf_thbj-attr.property-value-decimal).
      184               when "logical"
      185                  then return string(buf_thbj-attr.property-value-logical).
      186           end case.
      187       end.
      188       return "".
      189   end.
      190   method public character get-gismt-prop
      191   (input p-obj-type as char,
      192    input p-obj-code as int):
      193       define buffer buf_code for ub.code.
      194       define buffer buf_thbj-attr for ub.thbj-attr.
      195       assign
      196          gismt-AdressPort = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'adressPort':U)
      197          gismt-DopParam   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'dopParam':U)
      198          gismt-GisAdress  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'gisAdress':U)
      199          gismt-ProxyLogin = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'proxyLogin':U)
      200          gismt-ProxyPswd  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'proxyPswd':U)
      201          gismt-MaxTime    = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'maxTime':U))
      202          gismt-RegKey     = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'regKey':U)
      203          gismt-TimeFalStart = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'timeFalStart':U))
      204          gismt-WaitTime    = decimal(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'waitTime':U))
      205          gismt-CrashSituat = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'crashSituat':U))
      206          gismt-BanDate     = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'banDate':U))
      207          gismt-cdnTurnOn   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnTurnOn':U))
      208          gismt-cdnAdress   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnAdress':U)
      209          gismt-cdnRepeat   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnRepeat':U))
      210          gismt-cdnChange   = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnChange':U))
      211          gismt-cdnTimeUpd  = integer(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'cdnTimeUpdate':U))
      212          gismt-UpdateRequest = logical(get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'UpdateRequest':U))
      213          gismt-OflineAdress  = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflineAdress':U)
      214          gismt-OflineLogin   = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflineLogin':U)
      215          gismt-OflinePswd    = get-thbj-attr-prop(p-obj-type,p-obj-code,'gisMT':U,'OflinePswd':U)
      216          .
      217       if gismt-OflineLogin <> "" and gismt-OflinePswd <> ""
      218       then gismt-OflineAutoriz = ConvBase64(gismt-OflineLogin + ":" + gismt-OflinePswd).
      219       find first buf_code no-lock where
      220                  buf_code.parent eq "GisMtOffline"
      221              and buf_code.code   eq string(p-obj-code)
      222          no-error.
      223       if not avail buf_code then
      224       find first buf_code no-lock where
      225                  buf_code.parent eq "GisMtOffline"
      226              and buf_code.code   eq "0"
      227          no-error.
      228       if avail buf_code then  gismt-OflineDate = date(buf_code.CodeValue) no-error.
      229       else gismt-OflineDate = today.
      230     return "".
      231   end.
      232     method public character GetParamProxy ():
      233        define variable vParamProxy as character no-undo.
      234        define variable vRetProp as character no-undo.
      235        define buffer buf_sys-ctrl for ub.sys-ctrl .
      236        find first buf_sys-ctrl no-lock no-error.
      237        if available buf_sys-ctrl and buf_sys-ctrl.db-num <> 0
      238        then do:
      239            vRetProp = get-gismt-prop ('БД':U,
      240                                       buf_sys-ctrl.db-num) no-error.
      241        end.
      242        if gismt-AdressPort <> "" and gismt-ProxyLogin <> "" and gismt-ProxyPswd <> ""
      243           then vParamProxy = substitute ('-x &1 -U &2:&3',gismt-AdressPort,gismt-ProxyLogin,gismt-ProxyPswd).
      244        else if gismt-AdressPort <> "" then vParamProxy = substitute ('-x &1',gismt-AdressPort).
      245        else vParamProxy = "".
      246        return vParamProxy.
      247     end method.
      248      method public void GetListCdn ():
      249        def variable vTimeStart as datetime-tz no-undo.
      250        define variable vlongJson as longchar no-undo.
      251        define variable hDS as handle no-undo.
      252        define variable vRetOk as logical no-undo.
      253        define variable vCdnAdr as character no-undo.
      254        define variable cmd as character   no-undo.
      255        define variable vFileResult    as character   no-undo.
      256        define variable vFileResJson    as character   no-undo.
      257        define variable vFileErr as character   no-undo.
      258        define variable vParamProxy as character no-undo.
      259        define variable vReqSDN as logical no-undo.
      260        define variable vFileCmd as char no-undo.
      261        vParamProxy = GetParamProxy().
      262        if not gismt-cdnTurnOn then return .
      263        vlongJson = "".
      264        vTimeStart = now.
      265        for each tthosts-body:
      266            delete tthosts-body.
      267        end.
      268        for each tthosts:
      269            delete tthosts.
      270        end.
      271        for each tt-code:
      272            delete tt-code.
      273        end.
      274        do transaction
      275        on error undo, return error:
      276            vRetOk = SetCdnUpd(vTimeStart).
      277            run gbl/_tmpfile.p ( "CdnListGisMTRes", ".txt", output vFileResult ) .
      278            run gbl/_tmpfile.p ( "CdnListGisMTErr", ".txt", output vFileErr ) .
      279            run gbl/_tmpfile.p ( "CdnListGisMTRes", ".json", output vFileResJson ) .
      280            if session:debug-alert then run gbl/_tmpfile.p ( "CdnListGisMTCmd", ".txt", output vFileCmd ) .
      281            cmd = substitute ('&1 --connect-timeout &8 --max-time &8 &7 -X GET &3 -H "Content-Type: application/json" -H &4 &5 >&2 --stderr &6',
      282                             search ("exe/curl.exe"),
      283                             vFileResult,
      284                             quoter(gismt-cdnAdress),
      285                             quoter("X-api-Key: " + gismt-RegKey),
      286                             vParamProxy,
      287                             vFileErr,
      288                             gismt-DopParam,
      289                             trim(replace(string(gismt-WaitTime * 2, "zzzz9.99999"),".",","),"")).
      290            if session:debug-alert then
      291            do:
      292                OUTPUT STREAM out_data TO value(vFileCmd).
      293                PUT STREAM out_data UNFORMATTED
      294                 cmd .
      295                OUTPUT STREAM out_data CLOSE.
      296            end.
      297            os-command silent value(cmd).
      298            if searchFile(vfileresult) <> ? then do:
      299               file-info:file-name = searchFile(vfileresult).
      300               if file-info:file-size <> 0 then do:
      301                   copy-lob from file vFileResult to vlongJson no-error.
      302                   vlongJson = '~{"bodys":[' + vlongJson + "]}" .
      303                   hDS = dataset gismt-host-body:handle.
      304                   vRetOk  = hDS:read-json("longchar":U, vlongJson) no-error.
      305                   dataset gismt-host-body:write-json("FILE":U, vFileResJson) no-error.
      306                   find first tthosts-body no-error.
      307                   if avail tthosts-body  and tthosts-body.code = 0 then
      308                   do:
      309                       for each tthosts:
      310                          vReqSDN = yes.
      311                          ReqHost(tthosts.host_adr, vParamProxy, vTimeStart).
      312                       end.
      313                       UpdCdNAdrFormTT().
      314                   end.
      315               end.
      316            end.
      317            DelOldCdn(vTimeStart).
      318            DelCdnUpd().
      319            WriteLogCdn(vReqSDN).
      320            if not session:debug-alert
      321            then do:
      322                os-delete silent value(vFileResult)     no-error.
      323                os-delete silent value(vFileErr)        no-error.
      324                os-delete silent value(vFileResJson)     no-error.
      325            end.
      326        end.
      327      end method.
      328      method public void UpdTimetCdn ():
      329        define variable vTimeStart  as datetime-tz no-undo.
      330        define variable vTimeUnbl   as datetime-tz no-undo.
      331        define variable vParamProxy as character   no-undo.
      332        define variable vRetOk      as logical     no-undo.
      333        define variable vFileName   as character   no-undo.
      334        define buffer buf_code for ub.code.
      335        vParamProxy = GetParamProxy().
      336        if not gismt-cdnTurnOn then return .
      337        vTimeStart = now.
      338        empty temp-table tthosts-body.
      339        empty temp-table tthosts.
      340        empty temp-table tt-code.
      341        do transaction
      342        on error undo, return error:
      343            vRetOk = SetCdnUpd(vTimeStart).
      344            for each buf_code no-lock where
      345                     buf_code.parent = "CDN_GisMt"
      346                 and buf_code.misc2 <> "":
      347               vTimeUnbl = datetime-tz(buf_code.misc2) no-error.
      348               if vTimeUnbl < vTimeStart then do:
      349                  ReqHost(buf_code.code, vParamProxy, vTimeStart).
      350               end.
      351            end.
      352            UpdCdNAdrFormTT().
      353            DelCdnUpd().
      354            vFileName = GetLogName().
      355            OUTPUT STREAM out_data TO value(vFileName) APPEND.
      356            PUT STREAM out_data UNFORMATTED
      357              now  chr(9) "Установлено новое время доступа к ранее заблокированным площадкам:" skip.
      358            OUTPUT STREAM out_data CLOSE.
      359            for each tt-code,
      360               first buf_code no-lock where
      361                     buf_code.parent = tt-code.parent
      362                 and buf_code.code = tt-code.code:
      363               OUTPUT STREAM out_data TO value(vFileName) APPEND.
      364               PUT STREAM out_data UNFORMATTED
      365                   buf_code.misc1 chr(9) buf_code.code chr(9) buf_code.codeval chr(9) buf_code.misc2 chr(9) skip.
      366               OUTPUT STREAM out_data CLOSE.
      367            end.
      368            empty temp-table tt-code.
      369        end.
      370      end method.
      371      method public void ReqHost
      372          (iHostAdr as char,
      373           iParamProxy as char,
      374           iTimeStart as datetime-tz):
      375           def var vHostAdress as char no-undo.
      376           define variable vlongJson as longchar no-undo.
      377           define variable hDS as handle no-undo.
      378           define variable vRetOk as logical no-undo.
      379           define variable vCdnAdr as character no-undo.
      380           define variable cmd as character   no-undo.
      381           define variable vFileResult    as character   no-undo.
      382           define variable vFileErr as character   no-undo.
      383           define variable vFileResJson    as character   no-undo.
      384           define variable vTimeCur as datetime-tz no-undo.
      385           def var vReqTime as int64 no-undo.
      386           define variable vFlagOk as log no-undo.
      387           vHostAdress = iHostAdr + "/api/v4/true-api/cdn/health/check".
      388           vlongJson = "".
      389           vFlagOk = no.
      390           for each tthosts-adr:
      391               delete tthosts-adr.
      392           end.
      393           run gbl/_tmpfile.p ( "CdnGisMTRes", ".txt", output vFileResult ) .
      394           run gbl/_tmpfile.p ( "CdnGisMTErr", ".txt", output vFileErr ) .
      395           run gbl/_tmpfile.p ( "CdnListGisMTRes", ".json", output vFileResJson ) .
      396           cmd = substitute ('&1  --connect-timeout &8 --max-time &8 &7 -X GET &3 -H "Content-Type: application/json" -H &4 &5 >&2 --stderr &6',
      397                             search ("exe/curl.exe"),
      398                             vFileResult,
      399                             quoter(vHostAdress),
      400                             quoter("X-api-Key: " + gismt-RegKey),
      401                             iParamProxy,
      402                             vFileErr,
      403                             gismt-DopParam,
      404                             trim(replace(string(gismt-WaitTime, "zzzz9.99999"),".",","),"")).
      405            vTimeCur = now.
      406            os-command silent value(cmd).
      407            vReqTime = now -  vTimeCur.
      408            if searchFile(vfileresult) <> ? then do:
      409               file-info:file-name = searchFile(vfileresult).
      410               if file-info:file-size <> 0 then do:
      411                   copy-lob from file vFileResult to vlongJson no-error.
      412                   vlongJson = '~{"bodys":[' + vlongJson + "]}" .
      413                   hDS = dataset gismt-host-adr:handle.
      414                   vRetOk  = hDS:read-json("longchar":U, vlongJson) no-error.
      415                   dataset gismt-host-adr:write-json("FILE":U, vFileResJson) no-error.
      416                   find first tthosts-adr no-error.
      417                   if avail tthosts-adr  and
      418                      tthosts-adr.code = 0 then
      419                   do:
      420                       UpdCdNAdr(iHostAdr, iTimeStart, vReqTime, tthosts-adr.avgTimeMs).
      421                       vFlagOk = yes.
      422                   end.
      423               end.
      424            end.
      425            if not vFlagOk
      426            then do:
      427               vReqTime = 5 * 3600 * 1000.
      428               UpdCdNAdr(iHostAdr, iTimeStart, vReqTime, -1).
      429            end.
      430            if not session:debug-alert
      431            then do:
      432                os-delete silent value(vFileResult)     no-error.
      433                os-delete silent value(vFileErr)        no-error.
      434                os-delete silent value(vFileResJson)     no-error.
      435            end.
      436      end method.
      437      method public logical CheckCdnUpd ():
      438          def buffer buf_code for ub.code.
      439          def var vCheck as logical no-undo.
      440          find first buf_code where
      441                     buf_code.parent = "CDN_GisMt"
      442                 and buf_code.code = "CDN_Upd"
      443              no-lock no-error.
      444          if not avail buf_code then vCheck = yes.
      445          return vCheck.
      446      end method.
      447      method public logical CheckCdnUpdTime (iTimeStart as datetime-tz):
      448         def buffer buf_code for ub.code.
      449         def var vCheck as logical no-undo.
      450         def var vTimeUpd as datetime-tz no-undo.
      451         vCheck = no.
      452         find first buf_code where
      453                    buf_code.parent = "CDN_GisMt"
      454            no-lock no-error.
      455         if avail buf_code then vTimeUpd = datetime-tz(buf_code.misc1) no-error.
      456         if (not avail buf_code) or
      457            vTimeUpd = ? or
      458            (vTimeUpd <> ? and
      459             datetime-tz(vTimeUpd) < iTimeStart and
      460             (iTimeStart - datetime-tz(vTimeUpd)) >= gismt-cdnTimeUpd * 3600 * 1000)
      461         then vCheck = yes.
      462         return vCheck.
      463      end.
      464      method public logical SetCdnUpd (iTimeStart as datetime-tz):
      465          def buffer buf_code for ub.code.
      466          def var vCheck as logical no-undo.
      467          find first buf_code where
      468                     buf_code.parent = "CDN_GisMt"
      469                 and buf_code.code = "CDN_Upd"
      470              no-lock no-error.
      471          if not avail buf_code then do:
      472              create buf_code.
      473              assign
      474                 buf_code.parent = "CDN_GisMt"
      475                 buf_code.code = "CDN_Upd"
      476                 buf_code.codename = "Запущен процесс обновления площадок ГИС МТ"
      477                 buf_code.codeval = string(iTimeStart)
      478                 .
      479              vCheck = yes.
      480          end.
      481          return vCheck.
      482      end method.
      483      method public void DelCdnUpd ():
      484          def buffer buf_code for ub.code.
      485          for each buf_code where
      486                   buf_code.parent = "CDN_GisMt"
      487               and buf_code.code = "CDN_Upd"
      488              exclusive-lock:
      489             delete buf_code.
      490          end.
      491      end method.
      492      method public void UpdCdNAdr
      493          (iCdnAdr as char,
      494           iTimeStart as datetime-tz,
      495           iReqTime as int64,
      496           iavgTimeMs as int):
      497           find first tt-code where
      498                      tt-code.parent = "CDN_GisMt"
      499                  and tt-code.code = iCdnAdr
      500               no-error.
      501           if not avail tt-code then do:
      502              create tt-code.
      503           end.
      504           assign
      505              tt-code.parent = "CDN_GisMt"
      506              tt-code.code = iCdnAdr
      507              tt-code.codename = "Адрес площадки ГИС МТ"
      508              tt-code.codeval = string(iReqTime)
      509              tt-code.misc1 = String(iTimeStart)
      510              tt-code.misc2 = if iavgTimeMs = -1 then string(now + 15000 * 60) else  ""
      511              .
      512      end method.
      513      method public void UpdCdNAdrFormTT ():
      514           def buffer buf_code for ub.code.
      515           for each tt-code:
      516               find first buf_code where
      517                          buf_code.parent = tt-code.parent
      518                      and buf_code.code = tt-code.code
      519                  exclusive-lock no-wait no-error.
      520               if not avail buf_code then do:
      521                 if locked buf_code then do:
      522                 end.
      523                 else do:
      524                    create buf_code.
      525                 end.
      526               end.
      527               if avail buf_code then do:
      528                  buffer-copy tt-code to buf_code.
      529               end.
      530           end.
      531      end method.
      532      method public void DelOldCdn
      533           (iTimeStart as datetime-tz):
      534           def buffer buf_code for ub.code.
      535           def buffer chg_code for ub.code.
      536           if can-find(first buf_code no-lock where
      537                        buf_code.parent = "CDN_GisMt"
      538                    and buf_code.misc1 = String(iTimeStart)
      539                    ) then
      540           do:
      541               for each buf_code no-lock where
      542                        buf_code.parent = "CDN_GisMt"
      543                  :
      544                  if  buf_code.misc1 <> String(iTimeStart)
      545                  and buf_code.code <> "CDN_Upd" then
      546                  do:
      547                      find first chg_code where rowid(chg_code) = rowid(buf_code)
      548                         exclusive-lock no-wait no-error.
      549                      if avail chg_code then
      550                         delete chg_code.
      551                  end.
      552               end.
      553           end.
      554           else do:
      555               for each buf_code no-lock where
      556                        buf_code.parent = "CDN_GisMt"
      557                  :
      558                  find first chg_code where rowid(chg_code) = rowid(buf_code)
      559                     exclusive-lock no-wait no-error.
      560                  if avail chg_code then
      561                     chg_code.misc2 = "".
      562               end.
      563           end.
      564      end method.
      565      method private character GetLogName ():
      566           define variable vFileName as character no-undo.
      567           define variable vCh as character no-undo.
      568           define variable vFullCh as character no-undo.
      569           define variable vWork as character no-undo.
      570           define variable vNum as int no-undo.
      571           vFileName = "GisMtCDN-" + replace(string(today),"/","-") +  ".log".
      572           assign
      573              vWork = ""
      574              vCh = "param.txt"
      575              .
      576           vFullCh = searchfile(vCh).
      577           if vFullCh <> ? and vFullCh <> ""
      578           then vNum = index(vFullCh,"\pid_").
      579           if vNum <> 0 then vWork = substring(vFullCh, 1, vNum).
      580           vFileName =  vWork + vFileName.
      581           return vFileName.
      582      end method.
      583      method  private void WriteLogCdn
      584          (iFlagOk as logical):
      585           def buffer buf_code for ub.code.
      586           define variable vFileName as character no-undo.
      587           define variable vCh as character no-undo.
      588           define variable vFullCh as character no-undo.
      589           define variable vWork as character no-undo.
      590           define variable vNum as int no-undo.
      591           define variable vStrLong as longchar no-undo.
      592           define variable vTimeUnBlock as character no-undo.
      593           vFileName = GetLogName().
      594           if not iFlagOk then do:
      595               OUTPUT STREAM out_data TO value(vFileName) APPEND.
      596               PUT STREAM out_data UNFORMATTED
      597                 now chr(9) "Не удалось обновить CDN площадки. Текущие площадки:" skip.
      598               OUTPUT STREAM out_data CLOSE.
      599           end.
      600           else do:
      601               OUTPUT STREAM out_data TO value(vFileName) APPEND.
      602               PUT STREAM out_data UNFORMATTED
      603                 now chr(9) "CDN площадки обновлены:" skip.
      604               OUTPUT STREAM out_data CLOSE.
      605           end.
      606           for each buf_code no-lock where
      607                    buf_code.parent = "CDN_GisMt":
      608              vTimeUnBlock = if buf_code.misc2 = "" then "null" else buf_code.misc2.
      609              OUTPUT STREAM out_data TO value(vFileName) APPEND.
      610              PUT STREAM out_data UNFORMATTED
      611                buf_code.misc1 chr(9) buf_code.code chr(9) buf_code.codeval chr(9) vTimeUnBlock chr(9) skip.
      612              OUTPUT STREAM out_data CLOSE.
      613           end.
      614      end method.
      615      constructor public GisMtCDN (  ):
      616         super ().
      617      end constructor.
      618      destructor public GisMtCDN ( ):
      619      end destructor.
      620   end class.
