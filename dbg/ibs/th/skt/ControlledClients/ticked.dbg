       52   FIELD abs-discnt-rule  as integer
       53   FIELD tot-discnt-rule  as integer
       54   FIELD fact-qnty        like ub.gds-obj.fact-qnty
       55   FIELD free-qnty        like ub.gds-obj.free-qnty
       56   FIELD producer         as character format "X(40)"
       57   FIELD ingredient       as character format "X(40)"
       58   FIELD GTD              as character format "X(31)"
       59   FIELD alpha1           like ub.goods.alpha
       60   FIELD node-code        like ub.bar-code.node-code
       61   FIELD okei             like ub.units.okei
       62   FIELD kkt              as integer
       63   FIELD is-gas           as logical
       64   FIELD ptrl-as-good     as logical
       65   FIELD taracode         as character
       66   FIELD crf              as integer
       67   FIELD new-good         as logical
       68   FIELD rc               as recid
       69   FIELD obj-type         as character
       70   FIELD obj-code         as integer
       71   field is-main-code     as logical
       72   field bc-on-type       as character
       73   field main-prt-b-code  as integer
       74   field ean-lz as character
       75   field ean-rz as character
