       28   FIELD wd-rule          as integer
       29   FIELD wgd-rule         as integer
       30   FIELD fp               as logical
       31   FIELD zp               as integer
       32   FIELD pp               as integer
       33   FIELD need-auth        as integer
       34   FIELD is-menu          as integer
       35   FIELD is-semi-finished as integer
       36   FIELD is-modificator   as integer
       37   FIELD DepartId         as integer
       38   FIELD fbr-grp-code-0   as integer
       39   FIELD fbr-grp-code     as integer
       40   FIELD office           as integer
       41   field office-type      as character
       42   FIELD CalculationMethod      as integer
       43   FIELD CalculationMethodRestr as integer
       44   FIELD price-sale       like ub.price-list.price-sale
       45   FIELD unit-type        like ub.units.type
       46   FIELD unit-cli-type    like ub.units.type
       47   FIELD tax-string       as char FORMAT "X(255)"
       48   FIELD qnty-discnt-rule as integer
       49   FIELD kat-discnt-rule  as integer
