       99     define public property SomeStr as char no-undo
      100       get.
      101       set.
      102     define temp-table in-ItemHowMany no-undo
      103       field ItemCode   as char
      104       field IHMObject  as char
      105       field IHMObjCode as integer
      106       field IHMFact    as decimal
      107       field IHMFree    as decimal
      108       index idx-code ItemCode
      109       .
      110     define temp-table Out-ItemHowMany no-undo
      111       field ItemCode   as char
      112       field IHMObject  as char
      113       field IHMObjCode as integer
      114       field IHMFact    as decimal
      115       field IHMFree    as decimal
      116       index idx-code ItemCode
      117       .
      118     define variable hDoc-out    as handle no-undo.
      119     define variable hDoc          as handle  no-undo.
      120     define variable hRow-out      as handle  no-undo.
      121     define variable hRow          as handle  no-undo.
      122     define variable hRoot         as handle  no-undo.
      123     define variable hRoot-out     as handle  no-undo.
      124     define variable hText-out     as handle  no-undo.
      125     define variable req-type      as char    no-undo.
      126     define variable req-id        as int     no-undo.
      127     define variable req-from      as char    no-undo.
      128     define variable req-to        as char    no-undo.
      129     define variable req-tstamp    as int     no-undo.
      130     define variable i             as int     no-undo.
      131     define variable req-encod     as char    init 'koi8-r' no-undo.
      132     define variable logWrite      as class   LogWrite no-undo.
      133     define variable mbuffer-out   as memptr  no-undo.
      134     define variable v-cont-length as integer no-undo.
      135     constructor Ticked (  ):
      136       create x-noderef hRow-out.
      137       create x-noderef hText-out.
      138     end constructor.
      139     method private character get-error (p-str as char, p-code as int, p-severity as int, p-hparentout as handle ):
      140       hDoc-Out:create-node(hRow-out,'Error','ELEMENT':U).
      141       p-hParentOut:append-child(hRow-out).
      142       hDoc-Out:create-node(hText-out,'','TEXT':U).
      143       hRow-out:append-child(hText-out).
      144       hText-out:node-value = string(p-code).
      145       hDoc-Out:create-node(hRow-out,'ErrorMessage','ELEMENT':U).
      146       p-hParentOut:append-child(hRow-out).
      147       hDoc-Out:create-node(hText-out,'','TEXT':U).
      148       hRow-out:append-child(hText-out).
      149       hText-out:node-value = p-str.
      150       hDoc-Out:create-node(hRow-out,'ErrorSeverity','ELEMENT':U).
      151       p-hParentOut:append-child(hRow-out).
      152       hDoc-Out:create-node(hText-out,'','TEXT':U).
      153       hRow-out:append-child(hText-out).
      154       hText-out:node-value = string(p-severity).
      155       return "ERROR: " + p-str.
      156     end method.
      157     method public void ParsHowMany (p-hNode as handle, p-ctrl as char, p-code  as char, p-hParentOut as handle):
      158       define variable hField     as handle no-undo.
      159       define variable hBuf       as handle no-undo.
      160       define variable hDBFld     as handle no-undo.
      161       define variable hText      as handle no-undo.
      162       define variable hBuf-out   as handle no-undo.
      163       define variable hDBFld-out as handle no-undo.
      164       define variable hField-out as handle no-undo.
      165       define variable hText-out  as handle no-undo.
      166       def    var      v-ctrl     as char   no-undo.
      167       def    var      v-code     as char   no-undo.
      168       def    var      i          as int    no-undo.
      169       def    var      j          as int    no-undo.
      170       hBuf     = buffer in-ItemHowMany:handle.
      171       hBuf-out = buffer out-ItemHowMany:handle.
      172       v-ctrl = p-hNode:get-attribute("ctrl":U).
      173       if v-ctrl > ''  then.
      174       else v-ctrl = p-ctrl.
      175       v-code = p-hNode:get-attribute("code":U).
      176       if v-code > '' then.
      177       else v-code = p-code.
      178       create in-ItemHowMany.
      179       assign
      180         in-ItemHowMany.ItemCode = v-code.
      181       create x-noderef  hField.
      182       create x-noderef  hText.
      183       create x-noderef  hField-out.
      184       create x-noderef  hText-out.
      185       create x-noderef  hRow-out.
      186       do i = 1 to p-hNode:num-children:
      187         p-hNode:get-child(hField,i).
      188         if hField:name = '#text' then next.
      189         hDBFld = hBuf:buffer-field(hField:name) no-error.
      190         if valid-handle(hDBFld) then
      191         do:
      192           hField:get-child(hText,1).
      193           hDbFld:buffer-value = hText:node-value.
      194         end.
      195       end.
      196       if v-ctrl = 'read' then
      197       do:
      198         empty temp-table out-ItemHowMany.
      199         empty temp-table cash-gds.
      200         if in-ItemHowMany.ItemCode = '*' then
      201         do:
      202           create out-ItemHowMany.
      203           assign
      204             out-ItemHowMany.ItemCode   = '105107'
      205             out-ItemHowMany.IHMObject  = 'маг'
      206             out-ItemHowMany.IHMObjCode = 20
      207             out-ItemHowMany.IHMFact    = 10
      208             out-ItemHowMany.IHMFree    = 10.
      209           create out-ItemHowMany.
      210           assign
      211             out-ItemHowMany.ItemCode   = '27'
      212             out-ItemHowMany.IHMObject  = 'маг'
      213             out-ItemHowMany.IHMObjCode = 20
      214             out-ItemHowMany.IHMFact    = 20
      215             out-ItemHowMany.IHMFree    = 20.
      216         end.
      217         else
      218         do:
      219           run str/sendirst.p (input substitute('&1&3&2',in-ItemHowMany.ItemCode,in-ItemHowMany.IHMObjCode,chr(4)),
      220             output table cash-gds) no-error.
      221           if error-status:error then
      222           do:
      223             hDoc-Out:create-node(hRow-out,'ItemHowMany','ELEMENT').
      224             p-hParentOut:append-child(hRow-out).
      225             hRow-out:set-attribute("code",string(in-ItemHowMany.ItemCode)).
      226             hRow-out:set-attribute("ctrl", "READ":U).
      227             write-error (return-value
      228               ,1
      229               ,2
      230               ,hRow-out:handle).
      231             logWrite:LogStr = (return-value).
      232           end.
      233         end.
      234         for each cash-gds no-lock
      235           where cash-gds.fact-qnty <> 0 and cash-gds.free-qnty <> 0 :
      236           hDoc-Out:create-node(hRow-out,'ItemHowMany','ELEMENT').
      237           p-hParentOut:append-child(hRow-out).
      238           hRow-out:set-attribute("code",string(cash-gds.b-code)).
      239           hRow-out:set-attribute("ctrl", "ADD":U).
      240           out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'IHMObject' , cash-gds.obj-type ).
      241           out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'IHMObjCode' , string(cash-gds.obj-code) ).
      242           out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'IHMFact' , string(cash-gds.fact-qnty) ).
      243           out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'IHMFree' , string(cash-gds.free-qnty) ).
      244         end.
      245       end.
      246       delete object hField.
      247       delete object hText.
      248       delete object hField-out.
      249       delete object hText-out.
      250     end method.
      251     method public void ParsPayMeans (p-hNode as handle, p-hParentOut as handle):
      252       define variable hRow-out      as handle  no-undo.
      253       define variable hField-out    as handle  no-undo.
      254       define variable hText-out     as handle  no-undo.
      255       define variable hRowField-out as handle  no-undo.
      256       define variable v-ser-code    as integer no-undo.
      257       define variable v-db-num      as integer no-undo.
      258       define variable v-stts        as integer no-undo.
      259       define variable v-wth-code    as integer no-undo.
      260       define variable v-gds-code    as integer no-undo.
      261       define variable v-par-code    as integer no-undo.
      262       define variable v-FromDate    as date    no-undo.
      263       define variable v-ToDate      as date    no-undo.
      264       define variable v-zone        as char    no-undo.
      265       define variable v-rangeNum    as integer no-undo.
      266       define variable v-prod-bc     as char    no-undo.
      267       define buffer buf_wth-par  for ub.wth-par.
      268       define buffer buf_wth-ser  for ub.wth-ser.
      269       define buffer buf_wealth   for ub.wealth.
      270       define buffer buf_cash-pay for ub.cash-pay.
      271       def var v-ctrl as char no-undo.
      272       def var v-code as char no-undo.
      273       def var i      as int  no-undo.
      274       def var j      as int  no-undo.
      275       v-ctrl = p-hNode:get-attribute("ctrl":U).
      276       v-code = p-hNode:get-attribute("code":U).
      277       create x-noderef  hField-out.
      278       create x-noderef  hRow-out.
      279       create x-noderef  hRowField-out.
      280       create x-noderef  hText-out.
      281       if v-ctrl = 'read' then
      282       ReadBlock: do:
      283         hDoc-Out:create-node(hRow-out,'PayMeans','ELEMENT').
      284         p-hParentOut:append-child(hRow-out).
      285         hRow-out:set-attribute("code",v-code).
      286         hRow-out:set-attribute("ctrl", "READ":U).
      287         run str/wthidnt.p ( input v-code
      288           ,output v-ser-code
      289           ,output v-db-num
      290           ,output v-stts
      291           ,output v-wth-code
      292           ,output v-gds-code
      293           ,output v-par-code
      294           ,output v-zone
      295           ,output v-FromDate
      296           ,output v-ToDate
      297           ,output v-rangeNum
      298           ) no-error.
      299         if error-status:error then
      300         do:
      301           write-error (return-value
      302             ,1
      303             ,2
      304             ,hRow-out:handle).
      305           return .
      306         end.
      307         logWrite:LogStr = (substitute('Идентифицирована маска: серия &1-&2, МЦ &3, зона &4, номер &5!',v-ser-code,v-db-num,v-wth-code,v-zone, v-rangeNum)).
      308         find first buf_wth-ser no-lock where
      309           buf_wth-ser.ser-code = v-ser-code
      310           and buf_wth-ser.db-num = v-db-num no-error.
      311         if not available buf_wth-ser then
      312         do:
      313           write-error('Ошибка идентификации талона.'
      314             ,2
      315             ,2
      316             ,hRow-out:handle).
      317           logWrite:LogStr = (substitute('ERROR: Не найдена маска с кодом &1-&2!',v-ser-code,v-db-num)).
      318           leave ReadBlock.
      319         end.
      320         find first buf_wealth no-lock where
      321           buf_wealth.wth-code = v-wth-code no-error.
      322         if not available buf_wealth then
      323         do:
      324           write-error ('Ошибка идентификации талона.'
      325             ,2
      326             ,2
      327             ,hRow-out:handle).
      328           logWrite:LogStr = (substitute('ERROR: Не найдена МЦ с кодом &1!',v-wth-code)).
      329           leave ReadBlock.
      330         end.
      331         find first buf_wth-par no-lock where
      332           buf_wth-par.par-code = v-par-code no-error.
      333         if not available buf_wth-par then
      334         do:
      335           write-error ('Ошибка идентификации талона.'
      336             ,2
      337             ,2
      338             ,hRow-out:handle).
      339           logWrite:LogStr = (substitute('ERROR: Не найден номинал с кодом &1!',v-par-code)).
      340           leave ReadBlock.
      341         end.
      342         find first buf_cash-pay no-lock where
      343           buf_cash-pay.wth-code = v-wth-code no-error.
      344         if not available buf_cash-pay then
      345         do:
      346           write-error ('Ошибка идентификации талона.'
      347             ,2
      348             ,2
      349             ,hRow-out:handle).
      350           logWrite:LogStr = (substitute('ERROR: Не найден тип платежа с кодом МЦ &1!',v-wth-code)).
      351           leave ReadBlock.
      352         end.
      353         v-prod-bc = pet-code(v-gds-code).
      354         if v-prod-bc > '' then.
      355         else
      356         do:
      357           write-error ('Ошибка идентификации талона.'
      358             ,2
      359             ,2
      360             ,hRow-out:handle).
      361           logWrite:LogStr = (substitute('ERROR: Не определен короткий код для кода товара  &1!',v-gds-code)).
      362           leave ReadBlock.
      363         end.
      364         if v-zone <> 'cli-zone':U then
      365         do:
      366           if v-zone = 'put-zone':U then write-error(substitute('Талон с номером &1 уже погашен.',v-code)
      367               ,4
      368               ,2
      369               ,hRow-out:handle).
      370           else write-error (substitute('Нет информации о наличии у клиента талона с номером &1.',v-code)
      371               ,5
      372               ,2
      373               ,hRow-out:handle).
      374           leave ReadBlock.
      375         end.
      376         hRow-out:set-attribute("ctrl", "ADD":U).
      377         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMName' , buf_wealth.wth-name ).
      378         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMProperty' , string(buf_wth-ser.authr) ).
      379         out-tag-put (hRow-out:handle, hRowField-out:handle, hText-out:handle, 'PMMark' , '':U ).
      380         out-tag-put (hRowField-out:handle, hField-out:handle, hText-out:handle, 'PMMCode' , v-prod-bc ).
      381         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMCoupType' , '0' ).
      382         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMValue' , string(buf_wth-par.par-val) ).
      383         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMPayCode' , string(buf_cash-pay.cdpay-code) ).
      384         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateSrartYY' , substring(string(year(v-fromDate)),3,2)).
      385         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateStartMM' , string(month(v-fromDate)) ).
      386         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateStartDD' , string(day(v-fromDate)) ).
      387         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateEndYY' , substring(string(year(v-ToDate)),3,2) ).
      388         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateEndMM' , string(month(v-ToDate)) ).
      389         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMDateEndDD' , string(day(v-ToDate)) ).
      390         out-tag-put (hRow-out:handle, hField-out:handle, hText-out:handle, 'PMLock' , string(if buf_wth-ser.stts = 0 then 0 else 1) ).
      391       end.
      392       delete object  hField-out.
      393       delete object  hRow-out.
      394       delete object  hRowField-out.
      395       delete object  hText-out.
      396     end method.
      397     method private void out-tag-put (p-hrow as handle, p-hfield as handle, p-htext  as handle, p-name as char, p-value as char):
      398       hDoc-Out:create-node(p-hField,p-name,'Element').
      399       p-hRow:append-child(p-hField).
      400       if p-value > '' then
      401       do:
      402         hDoc-Out:create-node(p-hText,'','TEXT':U).
      403         p-hField:append-child(p-hText).
      404         p-hText:node-value = p-value.
      405       end.
      406     end method.
      407     method private character pet-code
      408       ( input p-gds-code as integer ) :
      409       define variable main-b-code      like ub.bar-code.b-code no-undo.
      410       define variable l-is-petrol-code as logical no-undo.
      411       define buffer buf_prod-bc for ub.prod-bc.
      412       if p-gds-code = 0 then return "":U.
      413       run ibs/th/skt/Adapters/AdapteeProcGdsbcode.p
      414         (input p-gds-code, input ?, output main-b-code)
      415       no-error.
      416       if error-status:error then return "":U.
      417       for each buf_prod-bc no-lock where
      418         buf_prod-bc.b-code = main-b-code:
      419         run ibs/th/skt/Adapters/AdapteeProcProdbcat.p
      420           (buffer buf_prod-bc, output l-is-petrol-code)
      421         no-error.
      422         if l-is-petrol-code then return buf_prod-bc.b-str.
      423       end.
      424       return "".
      425     end method.
      426     method public void xml-router ( p-hNode as handle, p-ctrl as char, p-code as char, p-hParentOut as handle ):
      427       case p-hNode:name:
      428         when 'Item' then
      429           do:
      430           end.
      431         when 'PayMeans' then
      432           do:
      433             ParsPayMeans(p-hNode,
      434               p-hParentOut) no-error.
      435           end.
      436         when 'ItemHowMany' then
      437           do:
      438             ParsHowMany (p-hNode
      439               ,p-ctrl
      440               ,p-code
      441               ,p-hParentOut
      442               ) no-error.
      443           end.
      444       end case.
      445       if error-status:error then
      446       do:
      447         logWrite:LogStr = (return-value).
      448       end.
      449     end method.
      450     method private void write-error
      451       (p-str  as char, p-code   as int, p-severity   as int, p-hParentOut as handle):
      452       define variable hRow-out  as handle no-undo.
      453       define variable hText-out  as handle no-undo.
      454       create x-noderef hRow-out.
      455       create x-noderef hText-out.
      456       hDoc-Out:create-node(hRow-out,'Error','ELEMENT':U).
      457       p-hParentOut:append-child(hRow-out).
      458       hDoc-Out:create-node(hText-out,'','TEXT':U).
      459       hRow-out:append-child(hText-out).
      460       hText-out:node-value = string(p-code).
      461       hDoc-Out:create-node(hRow-out,'ErrorMessage','ELEMENT':U).
      462       p-hParentOut:append-child(hRow-out).
      463       hDoc-Out:create-node(hText-out,'','TEXT':U).
      464       hRow-out:append-child(hText-out).
      465       hText-out:node-value = p-str.
      466       hDoc-Out:create-node(hRow-out,'ErrorSeverity','ELEMENT':U).
      467       p-hParentOut:append-child(hRow-out).
      468       hDoc-Out:create-node(hText-out,'','TEXT':U).
      469       hRow-out:append-child(hText-out).
      470       hText-out:node-value = string(p-severity).
      471       logWrite:LogStr = ("ERROR: " + p-str).
      472     end method.
      473     method public character AuthorizationTicked (req as class ibs.th.skt.Commands.IRequest):
      474       define variable str as character no-undo.
      475       logWrite = new LogWrite().
      476       create x-document hdoc.
      477       create x-noderef  hroot.
      478       create x-noderef  hrow.
      479       hDoc:load("longchar",cast(req, ibs.th.skt.Commands.SimpleRequest):Content,no).
      480       hdoc:get-document-element(hRoot).
      481       req-type   = hroot:get-attribute("type").
      482       req-id     = int(hroot:get-attribute("id")).
      483       req-from   = hroot:get-attribute("from").
      484       req-to     = hroot:get-attribute("to").
      485       req-tstamp = int(hroot:get-attribute("tstamp")).
      486       req-encod  = hdoc:encoding.
      487       create x-document hdoc-out.
      488       create x-noderef hroot-out.
      489       hdoc-out:encoding = req-encod.
      490       hdoc-out:create-node(hroot-out,'data','element').
      491       hdoc-out:append-child(hroot-out).
      492       if req-id <> 0 and req-id <> ? then   hroot-out:set-attribute('id',string(req-id)).
      493       if req-to > '':U then                 hroot-out:set-attribute('from',req-to).
      494       if req-from > '':U then               hroot-out:set-attribute('to',req-from).
      495       if req-tstamp <> 0 and req-tstamp <> ? then hroot-out:set-attribute('tstamp',string(req-tstamp)).
      496       hroot-out:set-attribute('type','replay').
      497       do i = 1 to hRoot:num-children:
      498         hRoot:get-child(hRow,i).
      499         xml-router(hRow:handle
      500           ,'':U
      501           ,'':U
      502           ,hRoot-out:handle ) no-error.
      503       end.
      504       set-size(mbuffer-out) = 0.
      505       hdoc-out:save('memptr',mbuffer-out).
      506       str = get-string(mbuffer-out,1).
      507       v-cont-length = length(str,"RAW":U).
      508       delete object hdoc.
      509       delete object hroot.
      510       delete object hrow.
      511       delete object hdoc-out.
      512       delete object hroot-out.
      513       SomeStr = substitute("HTTP/1.0 200 OK&1Server: 4GL&1Content-Type: text/xml&1Content-Length: &3&2&4",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10),string(v-cont-length),get-string(mbuffer-out,1)).
      514     end method.
      515   end class.
