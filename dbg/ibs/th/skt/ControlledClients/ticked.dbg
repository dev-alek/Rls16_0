        4   class ibs.th.skt.ControlledClients.Ticked:
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
        6   DEFINE  TEMP-TABLE cash-gds no-undo
