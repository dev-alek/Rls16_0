      217   method private void xmlchar-test (input  p-in-string          as character,
      218                                     output p-out-string-enc     as character,
      219                                     output p-out-string-dec    as character):
      220   do
      221   on error undo, return error
      222   :
      223          xmlchar-encode
      224       (
      225             input p-in-string
      226           , output p-out-string-enc
      227       ).
      228          xmlchar-decode
      229       (
      230             input p-out-string-enc
      231           , output p-out-string-dec
      232       ).
      233   end.
      234   end .
      235   method private void xmlchar-encode (input  p-in-string          as character,
      236                                     output p-out-string         as character):
      237       define variable v-position      as integer      no-undo.
      238       define variable v-current-char  as character    no-undo.
      239   do
      240   on error undo, return error
      241   :
      242       assign
      243           p-out-string = "":U
      244       .
      245       case p-in-string
      246       :
      247           when ?
      248           then do:
      249               assign
      250                   p-out-string = "?":U
      251               .
      252           end.
      253           when "?":U
      254           then do:
      255               assign
      256                   p-out-string = "&#63;":U
      257               .
      258           end.
      259           otherwise do:
      260               do v-position = 1 to length( p-in-string )
      261               :
      262                   assign
      263                       v-current-char = substring( p-in-string, v-position, 1 )
      264                   .
      265                   case v-current-char
      266                   :
      267                       when "&":U
      268                       then do:
      269                           assign
      270                               p-out-string = p-out-string + "&amp;":U
      271                           .
      272                       end.
      273                       when ">":U
      274                       then do:
      275                           assign
      276                               p-out-string = p-out-string + "&gt;":U
      277                           .
      278                       end.
      279                       when "<":U
      280                       then do:
      281                           assign
      282                               p-out-string = p-out-string + "&lt;":U
      283                           .
      284                       end.
      285                       when "'":U
      286                       then do:
      287                           assign
      288                               p-out-string = p-out-string + "&apos;":U
      289                           .
      290                       end.
      291                       when '"':U
      292                       then do:
      293                           assign
      294                               p-out-string = p-out-string + "&quot;":U
      295                           .
      296                       end.
      297                       when chr(1)
      298                       then do:
      299                           assign
      300                               p-out-string = p-out-string + "":U
      301                           .
      302                       end.
      303                       when chr(2)
      304                       then do:
      305                           assign
      306                               p-out-string = p-out-string + "":U
      307                           .
      308                       end.
      309                       when chr(3)
      310                       then do:
      311                           assign
      312                               p-out-string = p-out-string + "":U
      313                           .
      314                       end.
      315                       when chr(4)
      316                       then do:
      317                           assign
      318                               p-out-string = p-out-string + "":U
      319                           .
      320                       end.
      321                       when chr(5)
      322                       then do:
      323                           assign
      324                               p-out-string = p-out-string + "":U
      325                           .
      326                       end.
      327                       when chr(6)
      328                       then do:
      329                           assign
      330                               p-out-string = p-out-string + "":U
      331                           .
      332                       end.
      333                       when chr(7)
      334                       then do:
      335                           assign
      336                               p-out-string = p-out-string + "":U
      337                           .
      338                       end.
      339                       when chr(8)
      340                       then do:
      341                           assign
      342                               p-out-string = p-out-string + "":U
      343                           .
      344                       end.
      345                       when chr(9)
      346                       then do:
      347                           assign
      348                               p-out-string = p-out-string + "":U
      349                           .
      350                       end.
      351                       when chr(29)
      352                       then do:
      353                           assign
      354                               p-out-string = p-out-string + "":U
      355                           .
      356                       end.
      357                       when chr(10)
      358                       then do:
      359                           assign
      360                               p-out-string = p-out-string + "&#10;":U
      361                           .
      362                       end.
      363                       when chr(13)
      364                       then do:
      365                           assign
      366                               p-out-string = p-out-string + "&#13;":U
      367                           .
      368                       end.
      369                       otherwise do:
      370                           assign
      371                               p-out-string = p-out-string + v-current-char
      372                           .
      373                       end.
      374                   end case.
      375               end.
      376           end.
      377       end case.
      378   end.
      379   end .
      380   method private character  xmlchar-encode-1c (input  p-in-string          as character):
      381   define variable p-out-string as character no-undo.
      382       define variable v-position      as integer      no-undo.
      383       define variable v-current-char  as character    no-undo.
      384   do
      385   on error undo, return error
      386   :
      387       assign
      388           p-out-string = "":U
      389       .
      390       case p-in-string
      391       :
      392           when ?
      393           then do:
      394               assign
      395                   p-out-string = "?":U
      396               .
      397           end.
      398           otherwise do:
      399               do v-position = 1 to length( p-in-string )
      400               :
      401                   assign
      402                       v-current-char = substring( p-in-string, v-position, 1 )
      403                   .
      404                   case v-current-char
      405                   :
      406                       when chr(1)
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + " ":U
      410                           .
      411                       end.
      412                       when chr(2)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + " ":U
      416                           .
      417                       end.
      418                       when chr(3)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + " ":U
      422                           .
      423                       end.
      424                       when chr(4)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + " ":U
      428                           .
      429                       end.
      430                       when chr(5)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + " ":U
      434                           .
      435                       end.
      436                       when chr(6)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + " ":U
      440                           .
      441                       end.
      442                       when chr(7)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + " ":U
      446                           .
      447                       end.
      448                       when chr(8)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + " ":U
      452                           .
      453                       end.
      454                       when chr(9)
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + " ":U
      458                           .
      459                       end.
      460                       when chr(29)
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + " ":U
      464                           .
      465                       end.
      466                       when chr(10)
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + " ":U
      470                           .
      471                       end.
      472                       when chr(13)
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + " ":U
      476                           .
      477                       end.
      478                       otherwise do:
      479                           assign
      480                               p-out-string = p-out-string + v-current-char
      481                           .
      482                       end.
      483                   end case.
      484               end.
      485           end.
      486       end case.
      487   end.
      488   return p-out-string.
      489   end .
      490   method private void xmlchar-decode (input  p-in-string          as character,
      491                                     output p-out-string         as character):
      492       define variable v-position      as integer      no-undo.
      493       define variable v-last-position as integer      no-undo.
      494       define variable v-temp-integer  as integer      no-undo.
      495       define variable v-current-char  as character    no-undo.
      496       define variable v-next-char     as character    no-undo.
      497       define variable v-success       as logical      no-undo.
      498   do
      499   on error undo, return error
      500   :
      501       assign
      502           p-out-string = "":U
      503           v-position   = 0
      504       .
      505       replace-cycle:
      506       do while yes
      507       on error undo, return error
      508       :
      509           assign
      510               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      511           .
      512           if v-last-position <= v-position
      513           then do:
      514               if v-position = 0
      515               then do:
      516                   assign
      517                       p-out-string = p-in-string
      518                   .
      519               end.
      520               else do:
      521                   assign
      522                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      523                   .
      524               end.
      525               leave replace-cycle.
      526           end.
      527           else do:
      528               assign
      529                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      530                   v-position      = v-last-position
      531                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      532               .
      533               if v-current-char = "#":U
      534               then do:
      535                   assign
      536                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      537                   .
      538                   if v-last-position > 0
      539                   then do:
      540                       xmlchar-read-integer
      541                        (
      542                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      543                           , output v-temp-integer
      544                           , output v-success
      545                       ).
      546                       if v-success = yes
      547                       and v-temp-integer >= 1
      548                       and v-temp-integer <= 255
      549                       then do:
      550                           assign
      551                               p-out-string = p-out-string + chr( v-temp-integer )
      552                               v-position   = v-last-position + 1
      553                           .
      554                       end.
      555                       else do:
      556                           assign
      557                               p-out-string = p-out-string + "&":U
      558                               v-position   = v-position   + 1
      559                           .
      560                       end.
      561                   end.
      562                   else do:
      563                       assign
      564                           p-out-string = p-out-string + "&":U
      565                           v-position   = v-position   + 1
      566                       .
      567                   end.
      568               end.
      569               else do:
      570                   case substring( p-in-string, v-position + 1, 3 )
      571                   :
      572                       when "lt;":U
      573                       then do:
      574                           assign
      575                               p-out-string = p-out-string + "<":U
      576                               v-position   = v-position   + 3
      577                           .
      578                       end.
      579                       when "gt;":U
      580                       then do:
      581                           assign
      582                               p-out-string = p-out-string + ">":U
      583                               v-position   = v-position   + 3
      584                           .
      585                       end.
      586                       otherwise do:
      587                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      588                           then do:
      589                               assign
      590                                   p-out-string = p-out-string + "&":U
      591                                   v-position   = v-position   + 4
      592                               .
      593                           end.
      594                           else do:
      595                               case substring( p-in-string, v-position + 1, 5 )
      596                               :
      597                                   when "quot;":U
      598                                   then do:
      599                                       assign
      600                                           p-out-string = p-out-string + '"':U
      601                                           v-position   = v-position   + 5
      602                                       .
      603                                   end.
      604                                   when "apos;":U
      605                                   then do:
      606                                       assign
      607                                           p-out-string = p-out-string + "'":U
      608                                           v-position   = v-position   + 5
      609                                       .
      610                                   end.
      611                                   otherwise do:
      612                                       assign
      613                                           p-out-string = p-out-string + "&":U
      614                                       .
      615                                   end.
      616                               end case.
      617                           end.
      618                       end.
      619                   end case.
      620               end.
      621           end.
      622       end.
      623   end.
      624   end .
      625   method private void xmlchar-read-integer (input  p-input-string       as character,
      626                                             output p-output-integer     as integer,
      627                                             output p-success            as logical):
      628   do
      629   on error undo, return error
      630   :
      631       assign
      632           p-output-integer = integer( p-input-string )
      633       no-error.
      634       if error-status :error
      635       then do:
      636           assign
      637               p-success           = no
      638               p-output-integer    = 0
      639           .
      640       end.
      641       else do:
      642           assign
      643               p-success           = yes
      644           .
      645       end.
      646   end.
      647   end.
      648   define variable mMRCCode  as logical    no-undo.
      649   define variable mTypeMark as character  no-undo.
      650   method private logical IS-NeedMark
      651   ( input ib-code as integer  ,
      652     input ib-str as character ):
      653      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      654      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      655                                    and buf_prod-bc-attr.b-str  eq ib-str
      656                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      657        no-lock no-error.
      658      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      659   end.
      660   method private character repTegforDm
      661   (iDM as char ):
      662       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      663       define variable vteg as character no-undo.
      664       define variable oDM as character no-undo.
      665       define variable vi as integer no-undo.
      666       oDM = iDm.
      667       do vi = 1 to num-entries(vTeglist):
      668          vTeg = entry(vi,vTeglist).
      669          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      670       end.
      671       return oDM.
      672   end.
      673   method private character repSpecSimbforDm
      674   (iDM as char ):
      675       define variable oDM as character no-undo.
      676       xmlchar-decode(iDM, output oDM).
      677     return repTegforDm (oDM).
      678   end.
      679   method private logical CheckGtin
      680   (iGtin as char):
      681      define variable bar_code as character no-undo.
      682      define variable vGtin as logical no-undo init "yes".
      683      if length(iGtin) eq 14
      684      then do:
      685         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      686         run str/chk-sum.p
      687          (input-output bar_code ) no-error .
      688         if iGtin ne  bar_code
      689         then
      690            vGtin = no.
      691      end.
      692      else
      693         vGtin = no.
      694      return vgtin.
      695   end.
      696   method private character repSpecSimbforXlm
      697   (iDM as char ):
      698       iDM = replace(iDM,chr(29),"").
      699       return iDM.
      700   end.
      701   method private character getGtinByDM
      702   (IDM as char):
      703      define variable VTXT as char no-undo.
      704      define variable vGtin as char no-undo.
      705      vTXt = IdM.
      706      vGtin = IDM.
      707      if    length(vtxt) > 14
      708      then do:
      709         if   vtxt begins "(01)"
      710                or vtxt begins "(02)"
      711         then
      712            vGtin = substring(vtxt,5,14).
      713         else if   (vtxt begins "01"
      714                or vtxt begins "02" )
      715                and (   (    substring(iDm,17,2) eq "21"
      716                         and length(vtxt) >= 21)
      717                     or substring(iDm,17,2) eq "37"
      718                     or substring(iDm,17,4) eq "(37)" )
      719         then do:
      720            vGtin = substring(vtxt,3,14).
      721            if not checkGtin(vGtin)
      722            then
      723               vGtin = substring(vtxt,1,14).
      724         end.
      725         else if     length(vtxt) eq 14 + 7 + 4 + 4
      726             or length(vtxt) eq 14 + 7 + 4
      727             or length(vtxt) eq 14 + 7
      728         then
      729            vGtin = substring(vtxt,1,14).
      730      end.
      731      if not checkGtin(vGtin)
      732      then
      733         vGtin = "".
      734      return vgtin.
      735   end.
      736   method private integer getGdsCodeByGtin
      737   (iGtin as char):
      738      define buffer prod-bc  for ub.prod-bc.
      739      define buffer bar-code for ub.bar-code.
      740      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      741      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      742      return if avail bar-code then bar-code.gds-code else ?.
      743   end.
      744   method private decimal getQntyCodeByGtin
      745   (iGtin as char):
      746      define buffer prod-bc  for ub.prod-bc.
      747      define buffer bar-code for ub.bar-code.
      748      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      749      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      750      return if avail bar-code then bar-code.cli-base-rate else ?.
      751   end.
      752   method private integer getGdsCodeByDM
      753   (iDm as char):
      754      define variable vGtin as char no-undo.
      755      define buffer prod-bc for ub.prod-bc.
      756      vGtin  = getGtinByDM (IDM ).
      757      return getGdsCodeByGtin (vGtin).
      758   end.
      759   method private logical ChekTypeMarkByGds
      760   (iGds-code as integer ):
      761      define buffer goods-attr for ub.goods-attr.
      762      find first goods-attr where goods-attr.gds-code   = iGds-code
      763                              and goods-attr.attr-code  = 'mark-type':U
      764      no-lock no-error.
      765      if available goods-attr
      766      then do:
      767         mTypeMark = goods-attr.attr-value.
      768         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      769           .
      770      end.
      771      else
      772         return no.
      773   end.
      774   method private logical ChekTypeMarkByDm
      775   (iDM as char ):
      776      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      777   end.
      778   method private logical ChekTypeMarkByGtin
      779   (iGtin as char ):
      780      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      781   end.
      782   method private character  GetNextElement
      783     (input iAllTeg        as logical
      784     ,output oteg          as character
      785     ,output otegval       as character
      786     ,input-output pstr    as character
      787      ):
      788        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      789        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      790        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      791        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      792        define variable vTeg as character no-undo.
      793        define variable vLength as integer no-undo.
      794        define variable vi as integer no-undo.
      795        define variable vj as integer no-undo.
      796        define buffer code for ub.code.
      797        find first code where Code.parent eq "MarkType"
      798                          and Code.CodeValue   eq mTypeMark
      799                          no-lock no-error.
      800        if     available code
      801           and Code.misc1 ne ""
      802           and Code.misc1 ne ?
      803        then do:
      804           integer (Code.misc1) no-error.
      805           if not error-status:error
      806           then
      807             entry (4,vlistleng) = Code.misc1.
      808        end.
      809        if iAllTeg
      810        then
      811           assign
      812              vlistElem     = vlistElem    + vlistElemDop
      813              vlistleng     = vlistleng    + vlistlengDop
      814           .
      815        else if mMRCCode
      816        then
      817           assign
      818              vlistElem     = vlistElem    + ",(8005),8005"
      819              vlistleng     = vlistleng    + ",000006,0006"
      820           .
      821       block-elem:
      822       do vi = 1 to num-entries(vlistElem):
      823          vTeg = entry(vi,vlistElem).
      824          if pstr begins vTeg
      825          then do:
      826             if    vTeg eq "21"
      827             then
      828                vLength = index(pstr,chr(29)) - 2 no-error.
      829             if vLength  <= 0
      830             then
      831                vLength = int(entry(vi,vlistleng)).
      832             otegval = substring (pstr,length(vteg) + 1, vLength).
      833             oteg = replace(replace(vteg,")",""),"(","").
      834             vTeg = vteg + otegval.
      835             otegval = replace(otegval,chr(29),"").
      836             oteg = replace(replace(oteg,")",""),"(","").
      837             pstr = substring (pstr,length(vTeg)+ 1).
      838             vTeg = replace(vTeg,chr(29),"").
      839             leave block-elem.
      840          end.
      841          else
      842             vTeg = "".
      843       end.
      844       return vteg.
      845   end.
      846   method private character  GetCodeIdent
      847   (iDm as char):
      848      define variable Velement   as character no-undo init "first".
      849      define variable oCodeIdent as character no-undo.
      850      define variable vteg as character no-undo.
      851      define variable vtegval as character no-undo.
      852      define variable vGtin as character no-undo.
      853      define buffer marking for ub.marking.
      854      for first marking no-lock where
      855                marking.mark eq iDm
      856            and marking.unit-ext = "LEVEL2"
      857      :
      858        return iDm.
      859      end.
      860      vGtin  = getGtinByDM (iDm ).
      861      ChekTypeMarkByDm(idm).
      862      if iDm begins 'tech_':U
      863      then
      864         oCodeIdent = iDm.
      865      else if length(iDm) < 21
      866      then do:
      867         find first marking where marking.mark eq idm
      868         no-lock no-error.
      869         oCodeIdent = if available marking then marking.mark else  ?.
      870      end.
      871      else if     length(iDm) eq 29
      872         and not iDm begins "01"
      873         and not iDm begins "02"
      874      then
      875         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      876      else  if     length(iDm) >= 24
      877               and (  iDm begins "01"
      878                   or iDm begins "02")
      879               and  substring(iDm,17,2) ne "21"
      880      then do:
      881         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      882                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      883         then
      884            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      885         else
      886            oCodeIdent = iDM.
      887      end.
      888      else  if     (   length(iDm) eq 25
      889                    or length(iDm) eq 21)
      890               and (not iDm begins "01"
      891               and  not iDm begins "02")
      892      then
      893         oCodeIdent = substring(iDm,1,21).
      894      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      895      then
      896         oCodeIdent = substring(iDm,1,21).
      897      else do while Velement ne "" and idm ne "":
      898         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      899         oCodeIdent = oCodeIdent + Velement.
      900      end.
      901      return oCodeIdent.
      902   end.
      903   method private character  GetTegCod
      904   (icodeIdent as char, iTeg as char):
      905      define variable Velement   as character no-undo init "first".
      906      define variable oTeg as character no-undo init ?.
      907      define variable vteg as character no-undo.
      908      define variable vtegval as character no-undo.
      909      if     ((length(icodeIdent) eq 21
      910         and not icodeIdent begins "01"
      911         and not icodeIdent begins "02")
      912         or
      913             ( length(icodeIdent) eq 25
      914               and not icodeIdent begins "01"
      915               and not icodeIdent begins "02"))
      916      then do:
      917         if iTeg eq "01" or iTeg eq "02"
      918         then
      919            oTeg = substring(icodeIdent,1,21).
      920         else  if  iTeg eq "21"
      921         then
      922            oTeg = substring(icodeIdent,15,7).
      923      end.
      924      else do:
      925         ChekTypeMarkByDm(icodeIdent).
      926         block-teg:
      927            do while Velement ne "" and icodeIdent ne "":
      928            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      929            if    Velement begins iTeg
      930               or Velement begins "(" + iTeg + ")"
      931            then do:
      932               oTeg = vtegval.
      933               leave block-teg.
      934            end.
      935         end.
      936      end.
      937      return oTeg.
      938   end.
      939   method private logical isOAD
      940   (icodeIdent as character):
      941      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      942   end.
      943   method private logical isMark
      944   (icodeIdent as character):
      945      define buffer buf_marking for ub.marking.
      946      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      947             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      948   end.
      949   method private character  addBracketForCode
      950   (icodeIdent as char):
      951      define variable Velement   as character no-undo init "first".
      952      define variable oTeg as character no-undo.
      953      define variable vteg as character no-undo.
      954      define variable vtegval as character no-undo.
      955      define buffer marking for ub.marking.
      956      find first marking no-lock where
      957                 marking.mark begins icodeIdent no-error.
      958      if    not ChekTypeMarkByDm(icodeIdent)
      959         or length(icodeIdent) le 24
      960         or (avail marking and marking.unit-ext = "LEVEL2")
      961      then
      962         oTeg = icodeIdent.
      963      else do:
      964         if (  icodeIdent begins "01"
      965            or icodeIdent begins "02"
      966            ) and CheckGtin(substring (icodeIdent,3,14))
      967            and substring (icodeIdent,17,2) eq "21"
      968         then do:
      969            mMRCCode = yes.
      970            ChekTypeMarkByDm(icodeIdent).
      971            block-teg:
      972            do while Velement ne "" and icodeIdent ne "":
      973               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      974               if vteg ne ""
      975               then
      976                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      977            end.
      978            mMRCCode = no.
      979         end.
      980         else do:
      981            oTeg = icodeIdent.
      982         end.
      983      end.
      984      return oTeg.
      985   end.
      986   method private integer getlevelByCodId
      987   (iCode as char):
      988      define variable vLength as int no-undo.
      989      define variable vLevel  as int no-undo.
      990      if not ChekTypeMarkByDM (icode) then return ?.
      991      vLength = length(iCode).
      992      if    vLength eq 18
      993         or vLength eq 20
      994      then
      995         Vlevel = 4.
      996      else if vLength eq 21
      997      then
      998         Vlevel = 1.
      999      else if vLength eq 25
     1000      then do:
     1001         if  iCode begins "01"
     1002         then
     1003            Vlevel = 3.
     1004         else
     1005            Vlevel = 1.
     1006      end.
     1007      else if     vLength >= 26
     1008              and vLength <= 46
     1009      then do:
     1010         if    substring(iCode,17,2) eq "11"
     1011            or substring(iCode,17,2) eq "13"
     1012            or (    substring(iCode,17,2) eq "21"
     1013                and vLength >= 33
     1014                and substring(iCode,26,4) ne "8005")
     1015         then
     1016            Vlevel = 4.
     1017         else if    vLength eq 31
     1018                 or vLength eq 38
     1019                 or vLength eq 39
     1020                 or vLength eq 45
     1021         then
     1022            Vlevel = 1.
     1023         else if    vLength eq 35
     1024                 or vLength eq 43
     1025         then
     1026            Vlevel = 3.
     1027         else
     1028            Vlevel = ?.
     1029      end.
     1030      else
     1031         Vlevel = ?.
     1032      return Vlevel.
     1033   end.
     1034   method private character  getLevelMotpBycodid
     1035   (iDm as char):
     1036      define variable vLevel as integer no-undo.
     1037      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1038      vLevel = getlevelByCodId(iDm).
     1039      if    vLevel eq ?
     1040         or vLevel < 1
     1041         or vLevel > 6
     1042      then
     1043         return ?.
     1044      else
     1045         return entry(vlevel,vList).
     1046   end.
     1047   method private character    getLevelUTDByLevelMotp
     1048   (iUnit as char):
     1049      define variable vLevel as integer no-undo.
     1050      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1051      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1052      vLevel = lookup(iUnit,vListMOTP).
     1053      if    vLevel eq ?
     1054         or vLevel < 1
     1055         or vLevel > 4
     1056      then
     1057         return ?.
     1058      else
     1059         return entry(vlevel,vListutd).
     1060   end.
     1061   method private character  getLevelMotpByDM
     1062   (iDm as char):
     1063      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1064   end.
     1065   method private character  getLevelUTDByCodId
     1066   (iDm as char):
     1067      define variable vLevel as integer no-undo.
     1068      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1069      vLevel = getlevelByCodId(iDm).
     1070      if    vLevel eq ?
     1071         or vLevel < 1
     1072         or vLevel > 4
     1073      then
     1074         return ?.
     1075      else
     1076         return entry(vlevel,vList).
     1077   end.
     1078   method private character  getLevelUTDByDM
     1079   (iDm as char):
     1080      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1081   end.
     1082   define variable mNotMarkQnty as logical no-undo.
     1083   method private decimal getQntyUTDByCodId
     1084   (iDM as char):
     1085      define variable vLevel as integer no-undo.
     1086      define variable vList as character no-undo init "1,5,10,500".
     1087      define variable vGtin as character no-undo.
     1088      define variable vqnty as decimal no-undo init ?.
     1089      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1090      if vqnty eq ?
     1091      then do:
     1092         if not mNotMarkQnty
     1093         then do:
     1094            define buffer marking for ub.marking.
     1095            define variable vCodident as character no-undo.
     1096            vCodident = GetCodeIdent(idm).
     1097            find first marking where marking.mark begins vCodident no-lock no-error.
     1098            if     available marking
     1099               and marking.box-qnty ne ?
     1100            then
     1101               return marking.box-qnty.
     1102         end.
     1103         vGtin = getGtinByDm(iDM).
     1104         if ChekTypeMarkByGtin (vGtin)
     1105         then do:
     1106            vLevel = getlevelByCodId(iDM).
     1107            if     vLevel >= 1
     1108               and vLevel <= 4
     1109            then
     1110               vqnty = int(entry(vlevel,vList)).
     1111         end.
     1112         else
     1113            vqnty = getQntyCodeByGtin(vgtin).
     1114      end.
     1115      return vqnty.
     1116   end.
     1117   method private decimal getQntyUTDByDM
     1118   (iDm as char):
     1119      define variable vDM as character no-undo.
     1120      if     length (iDm) ne 25
     1121         and length (iDm) ne 29
     1122         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1123      then
     1124         vDM = substring (iDm,1,length (iDm) - 6 ).
     1125      else
     1126         vDM = substring (iDm,1,length (iDm) - 4 ).
     1127      return getQntyUTDByCodId(vDM).
     1128   end.
     1129   method private decimal    getMRC4
     1130   (iMRC as char):
     1131      define variable oMrc     as decimal no-undo init ?.
     1132      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1133      define variable vi       as integer no-undo.
     1134      define variable vfound   as integer no-undo.
     1135      define variable vposStart   as integer no-undo.
     1136      do:
     1137      OMRc = 0.
     1138      do vi = 1 to 4:
     1139         define variable vsimb as character no-undo.
     1140         vsimb = substring(iMRC,vi,1).
     1141         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1142         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1143         if vfound > 0
     1144         then
     1145            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1146         end.
     1147         OMRc = OMRc / 100.
     1148      end.
     1149      return OMRc.
     1150   end.
     1151   method private decimal    getMRCByDM
     1152   (iDm as char):
     1153      define variable vMRC     as character no-undo.
     1154      define variable oMrc     as decimal no-undo init ?.
     1155      define variable Velement as character no-undo init "empty".
     1156      define variable vteg as character no-undo.
     1157      define variable vtegval as character no-undo.
     1158      if    length(idm) eq 14 + 7 + 4 + 4
     1159         or length(idm) eq 14 + 7 + 4
     1160      then do:
     1161         vMRC = substring(idm,22,4).
     1162         omrc = getMRC4(vMRC).
     1163      end.
     1164      else do:
     1165          ChekTypeMarkByDm(iDm).
     1166          block-mrc:
     1167          do while Velement ne "" and idm ne "":
     1168             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1169             if Velement begins "8005"
     1170             then do:
     1171                vMRC = substring(Velement,5,6).
     1172                leave block-mrc.
     1173             end.
     1174             else if Velement begins "(8005)"
     1175             then do:
     1176                vMRC = substring(Velement,7,6).
     1177                leave block-mrc.
     1178             end.
     1179          end.
     1180          if vMRC ne ""
     1181          then
     1182             OMRc = dec(vmrc) / 100 no-error.
     1183      end.
     1184      return OMRc.
     1185   end.
     1186   method private date    MoveDate
     1187   (idate as date,
     1188    iMonth as int64):
     1189      define variable vMonth   as int64 no-undo.
     1190      define variable vYear    as int64 no-undo.
     1191      define variable vDateNew as date  no-undo.
     1192       define variable vDay     as int64 no-undo.
     1193       vMonth = month(iDate) + iMonth.
     1194       vYear =  year(iDate).
     1195       if vMonth <= 0
     1196       then assign
     1197          vMonth = vMonth + 12
     1198           vYear  = vYear - 1
     1199       .
     1200       else if vMonth > 12
     1201       then assign
     1202          vMonth = vMonth - 12
     1203           vYear  = vYear + 1
     1204       .
     1205       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1206       do while error-status:error eq yes:
     1207          VDay = vDay + 1.
     1208          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1209       end.
     1210       if VDay > 0
     1211       then
     1212          vDateNew + 1.
     1213       return vDateNew.
     1214   end.
     1215   method private logical    checkEMRC
     1216   (input  iDm as char,
     1217    output vOk as logical):
     1218      define variable v-value-emrc as character no-undo.
     1219      define variable v-type-emrc  as character no-undo.
     1220      define variable vDateIso     as character no-undo.
     1221      define variable vMRC         as decimal no-undo.
     1222      define variable vqnty        as decimal no-undo.
     1223      define variable vPrice       as decimal no-undo.
     1224      define variable vparent      as character no-undo.
     1225      define variable vgds-code    as integer no-undo.
     1226      define buffer code for ub.code.
     1227      vMRC = getMRCByDM(iDm).
     1228      if vMRC > 0
     1229      then do:
     1230         vgds-code = getGdsCodeByDM(iDm).
     1231         vqnty     = getQntyUTDByDM(iDm).
     1232               if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     1233            (
     1234             input   vgds-code
     1235            ,input   'emrc-type':U
     1236            ,output   v-value-emrc
     1237            ,output   v-type-emrc
     1238          ) no-error.
     1239          if     v-value-emrc ne ""
     1240             and v-value-emrc ne ?
     1241          then do:
     1242             vDateIso = iso-date(today).
     1243             vPrice = vMRC / vqnty.
     1244             vparent ="emc" + chr(4) + v-value-emrc.
     1245             find last code where Code.parent      eq vparent
     1246                              and Code.code        le vDateIso
     1247                              and code.status_  eq 0
     1248             no-lock no-error.
     1249             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1250             then
     1251                vOk = true .
     1252             else do:
     1253                 define variable vText      as character no-undo.
     1254                 define variable vDate      as date no-undo.
     1255                 define variable vDateLast  as character no-undo.
     1256                 define variable vDateFirst as character no-undo.
     1257                 define variable vDate3     as date no-undo.
     1258                 vdate = date(code.misc1).
     1259                 vDateLast = code.misc1.
     1260                 vDate3 = MoveDate(today, - 3 ).
     1261                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1262                                      string(vDate3  , "99/99/9999"),
     1263                                      string(vDate   , "99/99/9999")
     1264                                      ).
     1265                 vdateIso = iso-date(vdate3).
     1266                 find last code  where Code.parent      eq vparent
     1267                                   and Code.code        le vDateIso
     1268                                   and code.status_  eq 0 no-lock no-error.
     1269                 if available code
     1270                 then
     1271                    vDateIso = code.code.
     1272                 vDateFirst = vDateIso.
     1273                 vDateLast = iso-date(vdate).
     1274                 define variable vGood as logical no-undo.
     1275                 define variable vDateSale as date no-undo.
     1276                 define buffer bcode for code.
     1277                 for last code where Code.parent   eq vparent
     1278                                 and code.status_  eq 0
     1279                                 and code.code     < vDateLast
     1280                                 and code.code     >= vDateFirst
     1281                 no-lock:
     1282                    find first bcode where bCode.parent   eq vparent
     1283                                       and bcode.status_  eq 0
     1284                                       and bcode.code     > code.code no-lock no-error.
     1285                    if available bcode
     1286                    then do:
     1287                       if vPrice < dec(Code.CodeValue)
     1288                       then
     1289                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1290                                                     chr(10),
     1291                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1292                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1293                                                     ).
     1294                       else do:
     1295                          vGood = yes.
     1296                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1297                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1298                                                     chr(10),
     1299                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1300                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1301                                                     string(         vDateSale            ,"99/99/9999"),
     1302                                                     string(vDateSale - today)
     1303                                                     ).
     1304                       end.
     1305                    end.
     1306                 end.
     1307                 if vgood
     1308                 then do:
     1309                    define variable choice as integer no-undo .
     1310                    run gbl/d-askw.w (input "Уточнение"
     1311                           ,input  vText
     1312                           ,input "|"
     1313                           ,input "Принять|Вернуть"
     1314                           ,input "Принять данный товар|Вернуть товар постащику"
     1315                           ,input 1
     1316                           ,input 2
     1317                           ,output choice) no-error.
     1318                    vok = choice eq 1.
     1319                 end.
     1320                 else
     1321                    vok =false.
     1322             end.
     1323          end.
     1324      end.
     1325   end.
     1326   method private character addGs2Mark
     1327   (iMark as char):
     1328      define variable vDM   as character no-undo.
     1329      define variable vIdx  as integer   no-undo.
     1330      if index(iMark,chr(29),1) > 0
     1331      then return iMark.
     1332      if substring(iMark,26,4) = "8005" then
     1333      do:
     1334        vIdx = index(iMark,"93",26 + 4 + 5).
     1335        if vIdx > 1 then do:
     1336          vDM = substitute("&1&4&2&4&3",
     1337                           substring(iMark,1,25),
     1338                           substring(iMark,26,vIdx - 25 - 1),
     1339                           substring(iMark,vIdx),
     1340                           chr(29)) no-error.
     1341          vIdx = index(vDm,"240",vIdx + 4).
     1342          if vIdx > 0 then
     1343          do:
     1344            vDM = substitute("&1&3&2",
     1345                             substring(vDm,1,vIdx - 1),
     1346                             substring(vDm,vIdx),
     1347                             chr(29)) no-error.
     1348          end.
     1349        end.
     1350        else
     1351          vDM = substitute("&1&3&2",
     1352                           substring(iMark,1,25),
     1353                           substring(iMark,26),
     1354                           chr(29)) no-error.
     1355      end.
     1356      else if substring(iMark,32,2) = "91" then
     1357      do:
     1358        vIdx = index(iMark,"92",32).
     1359        if vIdx > 1 then
     1360          vDM = substitute("&1&4&2&4&3",
     1361                           substring(iMark,1,31),
     1362                           substring(iMark,32,vIdx - 31 - 1),
     1363                           substring(iMark,vIdx),
     1364                           chr(29)) no-error.
     1365        else
     1366          vDM = substitute("&1&3&2",
     1367                           substring(iMark,1,31),
     1368                           substring(iMark,32),
     1369                           chr(29)) no-error.
     1370      end.
     1371      else if substring(iMark,39,2) = "91" then
     1372      do:
     1373        vIdx = index(iMark,"92",38).
     1374        if vIdx > 1 then
     1375          vDM = substitute("&1&4&2&4&3",
     1376                           substring(iMark,1,38),
     1377                           substring(iMark,39,vIdx - 38 - 1),
     1378                           substring(iMark,vIdx),
     1379                           chr(29)) no-error.
     1380        else
     1381          vDM = substitute("&1&3&2",
     1382                           substring(iMark,1,38),
     1383                           substring(iMark,39),
     1384                           chr(29)) no-error.
     1385      end.
     1386      else if substring(iMark,25,2) = "93" then
     1387      do:
     1388        vIdx = index(iMark,"92",25).
     1389        if vIdx > 1 then
     1390          vDM = substitute("&1&4&2&4&3",
     1391                           substring(iMark,1,24),
     1392                           substring(iMark,25,vIdx - 24 - 1),
     1393                           substring(iMark,vIdx),
     1394                           chr(29)) no-error.
     1395        else
     1396          vIdx = index(iMark,"3103",25).
     1397          if vIdx > 0 then
     1398          vDM = substitute("&1&4&2&4&3",
     1399                           substring(iMark,1,24),
     1400                           substring(iMark,25,vIdx - 24 - 1),
     1401                           substring(iMark,vIdx),
     1402                           chr(29)) no-error.
     1403          else
     1404            vDM = substitute("&1&3&2",
     1405                             substring(iMark,1,24),
     1406                             substring(iMark,25),
     1407                             chr(29)) no-error.
     1408      end.
     1409      else if substring(iMark,32,2) = "93" then
     1410      do:
     1411        vDM = substitute("&1&3&2",
     1412              substring(iMark,1,31),
     1413              substring(iMark,32),
     1414              chr(29)) no-error.
     1415      end.
     1416      return if vDM <> "" then vDm else iMark.
     1417   end.
     1418   method private logical AddUtdErrForTab
     1419   (idb-num         as integer ,
     1420    idoc-id         as integer ,
     1421    iTab            as character,
     1422    iObj            as handle ,
     1423    iCheckType      as character,
     1424    iCodeErr        as character,
     1425    iCheckObj       as character ):
     1426      define buffer utd-err for utd-err.
     1427      define buffer utd for utd.
     1428      find first utd where utd.db-num     eq idb-num
     1429                       and utd.doc-id     eq idoc-id
     1430                       and utd.Direction  eq 'Outbound'
     1431      no-lock no-error.
     1432      if available utd
     1433      then
     1434         return no.
     1435      define variable vRecKey as character no-undo.
     1436            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1437            objKeyRec = new ibs.th.gbl.keyrec().
     1438            objKeyRec:GenKeyRec ( input iTab
     1439                                 ,input iObj
     1440                                 ,output vRecKey).
     1441            delete object objKeyRec.
     1442      find first utd-err where utd-err.db-num     eq idb-num
     1443                           and utd-err.doc-id     eq idoc-id
     1444                           and utd-err.CheckType  eq iCheckType
     1445                           and utd-err.CodeErr    eq iCodeErr
     1446                           and utd-err.CheckObj   eq iCheckObj
     1447      exclusive-lock no-error.
     1448      if not available utd-err
     1449      then do:
     1450         create utd-err.
     1451         assign
     1452            utd-err.db-num         = idb-num
     1453            utd-err.doc-id         = idoc-id
     1454            utd-err.CheckType      = iCheckType
     1455            utd-err.CodeErr        = iCodeErr
     1456            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     1457            utd-err.reckey         = vRecKey
     1458            utd-err.qnty           = 1
     1459         .
     1460      end.
     1461      else
     1462         utd-err.qnty = utd-err.qnty + 1.
     1463      return utd-err.qnty eq 1.
     1464   end.
     1465   method private logical AddUtdErr
     1466   (idb-num         as integer ,
     1467    idoc-id         as integer ,
     1468    iObj            as handle ,
     1469    iCheckType      as character,
     1470    iCodeErr        as character,
     1471    iCheckObj       as character ):
     1472      AddUtdErrForTab
     1473         (idb-num,
     1474          idoc-id,
     1475          iObj:table,
     1476          iObj,
     1477          iCheckType,
     1478          iCodeErr,
     1479          iCheckObj).
     1480   end.
     1481   method private void ClearUtdErrTypeCode
     1482   (idb-num         as integer,
     1483    idoc-id         as integer ,
     1484    iCheckType      as character,
     1485    iCodeErr        as character
     1486    ):
     1487      define buffer utd-err for utd-err.
     1488      if    iCheckType eq "*"
     1489         or iCheckType eq ?
     1490      then do:
     1491         if     iCodeErr ne ?
     1492            and iCodeErr ne "*"
     1493         then
     1494            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     1495            view-as alert-box.
     1496         else
     1497         for each utd-err where utd-err.db-num  eq idb-num
     1498                            and utd-err.doc-id  eq idoc-id
     1499         exclusive-lock:
     1500            delete utd-err.
     1501         end.
     1502      end.
     1503      else do:
     1504         if    iCodeErr eq ?
     1505            or iCodeErr eq "*"
     1506         then do:
     1507            for each utd-err where utd-err.db-num     eq idb-num
     1508                               and utd-err.doc-id     eq idoc-id
     1509                               and utd-err.CheckType  eq iCheckType
     1510            exclusive-lock:
     1511               delete utd-err.
     1512            end.
     1513         end.
     1514         else do:
     1515            for each utd-err where utd-err.db-num     eq idb-num
     1516                               and utd-err.doc-id     eq idoc-id
     1517                               and utd-err.CheckType  eq iCheckType
     1518                               and ub.utd-err.CodeErr eq iCodeErr
     1519            exclusive-lock:
     1520               delete utd-err.
     1521            end.
     1522         end.
     1523      end.
     1524   end.
     1525   method private void ClearUtdErr
     1526   (idb-num         as integer,
     1527    idoc-id         as integer ,
     1528    iCheckType      as character
     1529    ):
     1530      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     1531   end.
     1532   method private character GetMesError
     1533   (itxt as character,
     1534    iobj as character ):
     1535    define variable vi as integer no-undo.
     1536    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     1537       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     1538    end.
     1539    return itxt.
     1540   end.
     1541   method private character GetTextErrorType
     1542   (iCheckType as character,
     1543    iCodeErr   as character,
     1544    iChechObj  as character,
     1545    iType      as character  ):
     1546      define buffer code    for code.
     1547      define variable vError as character no-undo.
     1548      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1549                        and code.code   eq iCodeErr
     1550      no-lock no-error.
     1551      if available code
     1552      then do:
     1553         define variable vType as integer no-undo.
     1554         if code.misc3 eq "error"
     1555         then
     1556            vType = 0.
     1557         else if code.misc3 eq "warning"
     1558         then
     1559            vType = 1.
     1560         else if code.misc3 eq "Hiden"
     1561         then
     1562            vType = 2.
     1563         else
     1564            vtype = int(code.misc3) no-error.
     1565         case itype:
     1566            when "error"
     1567            then do:
     1568               if vtype eq 0
     1569               then
     1570                  vError = GetMesError(Code.CodeValue,iChechObj).
     1571            end.
     1572            when "warning"
     1573            then do:
     1574               if vtype <= 1
     1575               then
     1576                  vError = GetMesError(Code.CodeValue,iChechObj).
     1577            end.
     1578            otherwise do:
     1579               vError = GetMesError(Code.CodeValue,iChechObj).
     1580            end.
     1581         end.
     1582      end.
     1583      else
     1584         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     1585      return vError.
     1586   end.
     1587   method private integer  GetTypeError
     1588   (iCheckType as character,
     1589    iCodeErr   as character):
     1590      define buffer code    for code.
     1591      define variable vType as integer no-undo.
     1592      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1593                        and code.code   eq iCodeErr
     1594      no-lock no-error.
     1595      if     not available code
     1596         and code.misc3 eq "error"
     1597      then
     1598         vType = 0.
     1599      else if code.misc3 eq "warning"
     1600      then
     1601         vType = 1.
     1602      else if code.misc3 eq "Hiden"
     1603      then
     1604         vType = 2.
     1605      else
     1606         vtype = int(code.misc3) no-error.
     1607      return vtype.
     1608   end.
     1609   method private character GetTextError
     1610   (iCheckType as character,
     1611    iCodeErr   as character,
     1612    iChechObj  as character ):
     1613      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     1614   end.
     1615   method private character GetErrForUtdstr
     1616   (idb-num     as integer ,
     1617    idoc-id     as integer ,
     1618    iCheckType  as character
     1619    ):
     1620      define buffer utd-err for utd-err.
     1621      define buffer code    for code.
     1622      define variable vHQry as handle no-undo.
     1623      define variable vError as longchar no-undo.
     1624      define variable vErrorOne as longchar  no-undo.
     1625      define variable oError as character no-undo.
     1626      create query vHQry.
     1627      vHQry:set-buffers(buffer utd-err:handle).
     1628      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1629                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1630                               + if    iCheckType eq "*"
     1631                                    or iCheckType eq ?
     1632                                 then       ""
     1633                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1634      vHQry:query-open().
     1635      vHQry:get-first().
     1636      QRY-BLOCK:
     1637      repeat while not vHQry:query-off-end:
     1638         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1639         if     vErrorOne ne ""
     1640            and vErrorOne ne ?
     1641         then
     1642            vError = vError + ", " + vErrorOne.
     1643         vHQry:get-next().
     1644      end.
     1645      oError = substring(vError,3,4002).
     1646      return oError.
     1647   end.
     1648   method private character GetErrJsonForUtd
     1649   (idb-num         as integer ,
     1650    idoc-id         as integer ,
     1651    iCheckType      as character
     1652    ):
     1653      define buffer utd-err for utd-err.
     1654      define variable vHQry as handle no-undo.
     1655      define variable vError as longchar no-undo.
     1656      define variable oError as character no-undo.
     1657      create query vHQry.
     1658      define variable vi as integer no-undo.
     1659      vHQry:set-buffers(buffer utd-err:handle).
     1660      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1661                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1662                               + if    iCheckType eq "*"
     1663                                    or iCheckType eq ?
     1664                                 then       ""
     1665                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1666      vHQry:query-open().
     1667      vHQry:get-first().
     1668      QRY-BLOCK:
     1669      repeat while not vHQry:query-off-end:
     1670         define variable vErrorOne as character no-undo.
     1671         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1672         if     vErrorOne ne ?
     1673            and vErrorOne ne ""
     1674         then do:
     1675            vi = vi + 1.
     1676            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1677                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     1678                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1679         end.
     1680         vHQry:get-next().
     1681      end.
     1682      for first utd where utd.db-num eq idb-num
     1683                      and utd.doc-id eq idoc-id
     1684                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     1685      no-lock,
     1686         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1687                                  and utd-marking-lines.doc-id eq idoc-id
     1688                                  and utd-marking-lines.doc-level eq 1
     1689      no-lock,
     1690         first marking where marking.mark eq utd-marking-lines.mark
     1691                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1692      no-lock:
     1693         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     1694         if     vErrorOne ne ?
     1695            and vErrorOne ne ""
     1696         then do:
     1697            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     1698                            + '","ОбъектОш":"' + marking.mark
     1699                            + '","ТекстОш":"' + vErrorOne + '"}'.
     1700         end.
     1701      end.
     1702      if vError ne ""
     1703      then
     1704         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     1705      return oError.
     1706   end.
     1707   method private character GetErrJsonForUtdReturn
     1708   (idb-num         as integer ,
     1709    idoc-id         as integer ,
     1710    iCheckType      as character
     1711    ):
     1712      define buffer utd-err for utd-err.
     1713      define variable vHQry as handle no-undo.
     1714      define variable vError as longchar no-undo.
     1715      define variable oError as character no-undo.
     1716      define variable vi as integer no-undo.
     1717      create query vHQry.
     1718      vHQry:set-buffers(buffer utd-err:handle).
     1719      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1720                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1721                               + if    iCheckType eq "*"
     1722                                    or iCheckType eq ?
     1723                                 then       ""
     1724                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1725      vHQry:query-open().
     1726      vHQry:get-first().
     1727      QRY-BLOCK:
     1728      repeat while not vHQry:query-off-end:
     1729         define variable vErrorOne as character no-undo.
     1730         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     1731         if     vErrorOne ne ?
     1732            and vErrorOne ne ""
     1733         then do:
     1734            vi = vi + 1.
     1735            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     1736                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     1737                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     1738         end.
     1739         vHQry:get-next().
     1740      end.
     1741      if vError ne ""
     1742      then
     1743         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     1744      return oError.
     1745   end.
     1746   method private character GetCodeTextError
     1747   (iCheckType as character,
     1748    iCodeErr   as character,
     1749    iChechObj  as character,
     1750    output oCode as character,
     1751    output ovalue as character ):
     1752      define buffer code    for code.
     1753      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     1754                        and code.code   eq iCodeErr
     1755      no-lock no-error.
     1756      if     available code
     1757      then do:
     1758         define variable vi as integer no-undo init ?.
     1759         vi = int(Code.misc3) no-error.
     1760         if    code.misc3 ne "error"
     1761            and vi ne 0
     1762         then
     1763            oCode = ?.
     1764         else if     Code.misc1 ne ?
     1765                 and Code.misc1 ne ""
     1766         then
     1767            assign
     1768               oCode  = GetMesError(Code.misc1,iChechObj)
     1769               ovalue = GetMesError(Code.misc2,iChechObj)
     1770            .
     1771      end.
     1772      return if oCode eq ""
     1773             then ""
     1774             else (oCode + "_" + ovalue).
     1775   end.
     1776   define temp-table TT-err no-undo
     1777     field code_ as character
     1778     field text_ as character
     1779   index code_ code_.
     1780   method private character GetErrTxtForUtd
     1781   (idb-num         as integer ,
     1782    idoc-id         as integer ,
     1783    iCheckType      as character
     1784    ):
     1785      define buffer utd-err for utd-err.
     1786      define variable vHQry as handle no-undo.
     1787      define variable oError as character no-undo.
     1788      create query vHQry.
     1789      define variable vi as integer no-undo.
     1790      for each tt-err :
     1791         delete tt-err.
     1792      end.
     1793      vHQry:set-buffers(buffer utd-err:handle).
     1794      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     1795                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     1796                               + if    iCheckType eq "*"
     1797                                    or iCheckType eq ?
     1798                                 then       ""
     1799                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     1800      vHQry:query-open().
     1801      vHQry:get-first().
     1802      define variable vcode as character no-undo.
     1803      define variable vvalue as character no-undo.
     1804      QRY-BLOCK:
     1805      repeat while not vHQry:query-off-end:
     1806         vi = vi + 1.
     1807         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     1808         if vcode ne ?
     1809         then do:
     1810            find first tt-err where tt-err.code eq vcode
     1811            no-error.
     1812            if not available tt-err
     1813            then do:
     1814               create tt-err.
     1815               assign
     1816                  tt-err.code_ = vcode
     1817                  tt-err.text_ = vvalue
     1818               .
     1819            end.
     1820            else
     1821               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1822         end.
     1823         vHQry:get-next().
     1824      end.
     1825     find first utd where utd.db-num eq idb-num
     1826                         and utd.doc-id eq idoc-id
     1827         no-lock.
     1828      define buffer cancel_utd-lines for utd-lines.
     1829      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     1830                                  and cancel_utd-lines.doc-id eq idoc-id
     1831      no-lock:
     1832         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     1833         then do:
     1834            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     1835                                        and utd-marking-lines.doc-id eq idoc-id
     1836                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     1837            no-lock,
     1838               first marking where marking.mark eq utd-marking-lines.mark
     1839                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     1840            no-lock:
     1841               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     1842               find first tt-err where tt-err.code eq vcode
     1843               no-error.
     1844               if not available tt-err
     1845               then do:
     1846                  create tt-err.
     1847                  assign
     1848                     tt-err.code_ = vcode
     1849                     tt-err.text_ = vvalue
     1850                  .
     1851               end.
     1852               else
     1853                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1854            end.
     1855         end.
     1856         else do:
     1857            define variable vqnty as decimal no-undo.
     1858            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     1859            if vqnty eq ? then vqnty = 0.
     1860            if vqnty ne cancel_utd-lines.Quantity
     1861            then do:
     1862               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     1863               find first tt-err where tt-err.code eq vcode
     1864               no-error.
     1865               if not available tt-err
     1866               then do:
     1867                  create tt-err.
     1868                  assign
     1869                     tt-err.code_ = vcode
     1870                     tt-err.text_ = vvalue
     1871                  .
     1872               end.
     1873               else
     1874                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     1875            end.
     1876         end.
     1877      end.
     1878      for each tt-err:
     1879         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     1880      end.
     1881      return oError.
     1882   end.
     1883   define variable mFormatErr as character no-undo init "text".
     1884   method private character GetErrForUtd
     1885   (idb-num         as integer ,
     1886    idoc-id         as integer ,
     1887    iType           as character
     1888    ):
     1889      if mFormatErr eq "text"
     1890      then
     1891         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     1892      else do:
     1893         if itype eq "return"
     1894         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     1895         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     1896      end.
     1897   end.
     1898   method private longchar GetErrComText
     1899   (icomment as character,
     1900    itext    as longchar ):
     1901       define variable vText as longchar no-undo.
     1902      if mFormatErr eq "text"
     1903      then do:
     1904         if icomment ne ""
     1905         then
     1906            icomment = substitute("comment:|&1|",icomment).
     1907         vText = icomment + itext.
     1908      end.
     1909      else do:
     1910         icomment = if icomment begins  '"'
     1911                    then icomment
     1912                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     1913         vText = icomment + "," + itext.
     1914         vText = "~{" + trim(vText,",") + "~}".
     1915      end.
     1916      return vText.
     1917   end.
     1918   method private logical  CheckTypeForMarkLineType
     1919   (iObj            as handle,
     1920    iCheckType      as character,
     1921    iCodeErr        as character ,
     1922    iTypeErr        as character ):
     1923      define variable vRecKey-markLine as character no-undo.
     1924      define variable vGoodMark        as logical no-undo.
     1925      define variable vdb-num          as integer no-undo.
     1926      define variable vdoc-id          as integer no-undo.
     1927      define variable vlinenum         as integer no-undo.
     1928      define variable vErrorOne as character no-undo.
     1929      define buffer buf_utd-err for utd-err.
     1930       define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1931       objKeyRec = new ibs.th.gbl.keyrec().
     1932       objKeyRec:GenKeyRec ( input "utd-marking-lines"
     1933                            ,input iObj
     1934                            ,output  vRecKey-markLine).
     1935       delete object objKeyRec.
     1936      vGoodMark = yes.
     1937      vdb-num = iObj::db-num.
     1938      vdoc-id = iObj::doc-id.
     1939      vlinenum = iObj::linenum.
     1940      block-mark-err:
     1941      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1942                               and buf_utd-err.db-num = vdb-num
     1943                               and buf_utd-err.reckey = vRecKey-markLine
     1944                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1945                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1946      no-lock:
     1947         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1948         if     vErrorOne ne ?
     1949            and vErrorOne ne ""
     1950         then do:
     1951            vGoodMark = no.
     1952            leave block-mark-err.
     1953         end.
     1954      end.
     1955      return not vGoodMark.
     1956   end.
     1957   method private logical  CheckErrForMarkLineType
     1958   (iObj            as handle,
     1959    iType           as character  ):
     1960      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     1961   end.
     1962   method private logical  CheckErrForMarkLine
     1963   (iObj            as handle):
     1964      return CheckErrForMarkLineType(iObj,"*").
     1965   end.
     1966   method private logical  CheckErrForLineTypeCode
     1967   (iObj                 as handle,
     1968    iCheckType           as character,
     1969    iCodeErr             as character,
     1970    iTypeErr             as character,
     1971    iOneErr              as logical):
     1972      define variable vRecKey-line     as character no-undo.
     1973      define buffer buf_utd-err for utd-err.
     1974      define variable vUtdlineError as logical no-undo.
     1975      define variable vErrorOne as character no-undo.
     1976            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     1977            objKeyRec = new ibs.th.gbl.keyrec().
     1978            objKeyRec:GenKeyRec ( input "utd-lines"
     1979                                 ,input iObj
     1980                                 ,output vRecKey-line).
     1981            delete object objKeyRec.
     1982         define variable vdb-num as integer no-undo.
     1983         define variable vdoc-id as integer no-undo.
     1984         define variable vlinenum as integer no-undo.
     1985         vdb-num = iObj::db-num.
     1986         vdoc-id = iObj::doc-id.
     1987         vlinenum = iObj::linenum.
     1988         block-err:
     1989         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     1990                                  and buf_utd-err.db-num = vdb-num
     1991                                  and buf_utd-err.reckey = vRecKey-line
     1992                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     1993                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     1994         no-lock:
     1995            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     1996            if     vErrorOne ne ?
     1997               and vErrorOne ne ""
     1998            then do:
     1999               vUtdlineError = yes.
     2000               leave block-err.
     2001            end.
     2002         end.
     2003         if  not vUtdlineError
     2004         then do:
     2005            define variable vGoodMark as logical no-undo.
     2006            vGoodMark = yes.
     2007            block-line-err:
     2008            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2009                                         and utd-marking-lines.doc-id  eq vdoc-id
     2010                                         and utd-marking-lines.LineNum eq vLineNum
     2011            no-lock:
     2012               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2013               if     vGoodMark
     2014                  and iOneErr eq no
     2015               then
     2016                  leave block-line-err.
     2017               if     iOneErr = yes
     2018                  and not vGoodMark
     2019               then
     2020                  leave block-line-err.
     2021            end.
     2022            vUtdlineError = not vGoodMark.
     2023         end.
     2024      return vUtdlineError.
     2025   end.
     2026   method private character   getErrForLineType
     2027   (iObj            as handle,
     2028    iType           as character  ):
     2029      define variable vRecKey-line     as character no-undo.
     2030      define buffer buf_utd-err for utd-err.
     2031      define variable vUtdlineError as logical no-undo.
     2032      define variable vErrorOne as character no-undo.
     2033      define variable oError as character no-undo.
     2034            define variable objKeyRec as class ibs.th.gbl.keyrec no-undo.
     2035            objKeyRec = new ibs.th.gbl.keyrec().
     2036            objKeyRec:GenKeyRec ( input "utd-lines"
     2037                                 ,input iObj
     2038                                 ,output vRecKey-line).
     2039            delete object objKeyRec.
     2040         define variable vdb-num as integer no-undo.
     2041         define variable vdoc-id as integer no-undo.
     2042         define variable vlinenum as integer no-undo.
     2043         vdb-num = iObj::db-num.
     2044         vdoc-id = iObj::doc-id.
     2045         vlinenum = iObj::linenum.
     2046         block-err:
     2047         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2048                                  and buf_utd-err.db-num = vdb-num
     2049                                  and buf_utd-err.reckey = vRecKey-line
     2050                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2051         no-lock:
     2052            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2053            if     vErrorOne ne ?
     2054               and vErrorOne ne ""
     2055            then do:
     2056               oError = oError + vErrorOne + " ".
     2057            end.
     2058         end.
     2059      return oError.
     2060   end.
     2061   method private logical  CheckErrForLineType
     2062   (iObj            as handle,
     2063    iType           as character  ):
     2064       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2065   end.
     2066   method private logical  CheckErrForLine
     2067   (iObj            as handle):
     2068      return CheckErrForLineType(iobj,"*").
     2069   end.
     2070   method private logical  CheckErrForUtd
     2071   (idb-num         as integer ,
     2072    idoc-id         as integer ):
     2073      for each utd-lines where utd-lines.db-num eq idb-num
     2074                           and utd-lines.doc-id eq idoc-id
     2075      no-lock :
     2076         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2077         then
     2078            return no.
     2079      end.
     2080      return yes.
     2081   end.
     2082   method public logical CheckMarkUtd-28rel
     2083    (input idb-num as integer,
     2084    input idoc-id as integer):
     2085    define buffer utd                   for utd.
     2086    define buffer utd-lines             for utd-lines.
     2087    define buffer utd-marking-lines     for utd-marking-lines.
     2088    define variable v-par-type as character no-undo.
     2089    define variable vgdsNoMark as logical no-undo.
     2090    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2091      define variable v-par-val  as character no-undo.
     2092      find first utd where utd.db-num eq idb-num
     2093                       and utd.doc-id eq idoc-id
     2094      no-lock no-error.
     2095      if available utd
     2096      then do:
     2097         if     utd.obj-code ne ?
     2098            and utd.obj-type ne ?
     2099         then do:
     2100            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2101            Block-utd-lines:
     2102            for each utd-lines where utd-lines.db-num eq idb-num
     2103                                 and utd-lines.doc-id eq idoc-id
     2104            no-lock:
     2105               if     utd-lines.gds-code ne ?
     2106                  and utd-lines.gds-code ne 0
     2107               then do:
     2108                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2109                       ( utd-lines.gds-code,
     2110                         'mark-type':U,
     2111                          output v-par-val,
     2112                          output v-par-type
     2113                       ).
     2114                  if     EDOParSec:IsEdo
     2115                     and EDOParSec:GetIsEDOForType(v-par-val)
     2116                  then do:
     2117                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2118                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2119                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2120                                                    and length(utd-marking-lines.mark) > 13
     2121                     no-lock no-error.
     2122                     if     avail utd-marking-lines
     2123                        and not CheckErrForLine(buffer utd-lines:handle)
     2124                     then
     2125                        leave Block-utd-lines.
     2126                  end.
     2127                  else
     2128                     vgdsNoMark = yes.
     2129               end.
     2130            end.
     2131            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2132            if vgdsNoMark then return available utd-lines . else return yes .
     2133         end.
     2134      end.
     2135      return yes.
     2136   end.
     2137     def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2138   method public logical CheckMarkUtd
     2139    (input idb-num  as integer,
     2140     input idoc-id  as integer):
     2141     define buffer utd-lines             for ub.utd-lines.
     2142     block-line:
     2143     for each utd-lines where utd-lines.db-num eq idb-num
     2144                          and utd-lines.doc-id eq idoc-id
     2145     no-lock:
     2146        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2147        then
     2148           leave block-line.
     2149     end.
     2150     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2151     return available utd-lines.
     2152   end.
     2153   method public logical CheckNotMarkUtd
     2154    (input idb-num  as integer,
     2155     input idoc-id  as integer):
     2156     define buffer utd-lines             for ub.utd-lines.
     2157     for each utd-lines where utd-lines.db-num eq idb-num
     2158                          and utd-lines.doc-id eq idoc-id
     2159     no-lock:
     2160        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2161        then
     2162           return yes.
     2163     end.
     2164     return no.
     2165   end.
     2166   method public logical CheckMarkUtdLine
     2167    (input idb-num  as integer,
     2168     input idoc-id  as integer,
     2169     input iLineNum as integer):
     2170    define buffer utd                   for utd.
     2171    define buffer utd-lines             for utd-lines.
     2172    define buffer utd-marking-lines     for utd-marking-lines.
     2173    define variable v-par-type as character no-undo.
     2174    define variable vMarking        as logical no-undo.
     2175    define variable vArtic          as logical no-undo.
     2176    define variable vTransitional   as logical no-undo.
     2177    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2178      define variable v-par-val  as character no-undo.
     2179      find first utd where utd.db-num eq idb-num
     2180                       and utd.doc-id eq idoc-id
     2181      no-lock no-error.
     2182      if available utd
     2183      then do:
     2184         if     utd.obj-code ne ?
     2185            and utd.obj-type ne ?
     2186         then do:
     2187            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2188            Block-utd-lines:
     2189            for each utd-lines where utd-lines.db-num   eq idb-num
     2190                                 and utd-lines.doc-id   eq idoc-id
     2191                                 and utd-lines.LineNum  eq iLineNum
     2192            no-lock:
     2193               if     utd-lines.gds-code ne ?
     2194                  and utd-lines.gds-code ne 0
     2195               then do:
     2196                                  if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2197                       ( utd-lines.gds-code,
     2198                         'mark-type':U,
     2199                          output v-par-val,
     2200                          output v-par-type
     2201                       ).
     2202                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2203                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2204                  if vMarking
     2205                  then do:
     2206                     block-marking:
     2207                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2208                                                    and utd-marking-lines.doc-id   eq idoc-id
     2209                                                    and utd-marking-lines.LineNum  eq iLineNum
     2210                                                    and length(utd-marking-lines.mark) > 13
     2211                     no-lock:
     2212                        if isOAD(utd-marking-lines.mark)
     2213                        then do:
     2214                           assign
     2215                              vArtic   = yes
     2216                              vMarking = no
     2217                           .
     2218                           leave block-marking.
     2219                        end.
     2220                     end.
     2221                  end.
     2222                  if vArtic
     2223                  then do:
     2224                     block-artic:
     2225                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2226                                                    and utd-marking-lines.doc-id   eq idoc-id
     2227                                                    and utd-marking-lines.LineNum  eq iLineNum
     2228                                                    and length(utd-marking-lines.mark) > 13
     2229                     no-lock:
     2230                        if isMark(utd-marking-lines.mark)
     2231                        then do:
     2232                           assign
     2233                              vArtic   = no
     2234                              vMarking = yes
     2235                           .
     2236                           leave block-artic.
     2237                        end.
     2238                     end.
     2239                  end.
     2240                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2241                  if vTransitional
     2242                  then do:
     2243                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2244                                                    and utd-marking-lines.doc-id   eq idoc-id
     2245                                                    and utd-marking-lines.LineNum  eq iLineNum
     2246                                                    and length(utd-marking-lines.mark) > 13
     2247                     no-lock no-error.
     2248                     if not available utd-marking-lines
     2249                     then assign
     2250                        vMarking = no
     2251                        vArtic   = no
     2252                     .
     2253                  end.
     2254               end.
     2255               else
     2256                  assign
     2257                     vMarking      = yes
     2258                     vArtic        = no
     2259                     vTransitional = no
     2260                  .
     2261               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2262               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2263               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2264            end.
     2265         end.
     2266      end.
     2267      return vMarking or vArtic.
     2268   end.
     2269   method public logical getMarkUtdLine
     2270    (input  idb-num  as integer,
     2271     input  idoc-id  as integer,
     2272     input  iLineNum as integer,
     2273     output oMarking        as logical,
     2274     output oArtic          as logical,
     2275     output oTransitional   as logical):
     2276     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2277     oArtic        = not oMarking
     2278            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2279     oTransitional = (oMarking or oArtic)
     2280            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2281   end.
     2282   method public logical CheckMarking
     2283    (input idb-num as integer,
     2284    input idoc-id as integer,
     2285    input iTypeErr as character ):
     2286     define variable vMarkutd as logical no-undo.
     2287     define variable vCrErr   as logical no-undo.
     2288     define buffer utd-lines         for utd-lines.
     2289     define buffer utd-marking-lines for utd-marking-lines.
     2290     define buffer marking           for marking.
     2291     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2292      block-line:
     2293      for each utd-lines where utd-lines.db-num eq idb-num
     2294                           and utd-lines.doc-id eq idoc-id
     2295      no-lock:
     2296         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2297         then do:
     2298            for each utd-marking-lines
     2299                     where utd-marking-lines.db-num  = utd-lines.db-num
     2300                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2301                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2302            no-lock:
     2303               if isMark(utd-marking-lines.mark)
     2304               then do:
     2305                  find first marking where marking.mark eq utd-marking-lines.mark
     2306                  no-lock no-error.
     2307                  if not available marking
     2308                  then do:
     2309                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2310                     vCrErr = yes.
     2311                     next block-line.
     2312                  end.
     2313               end.
     2314            end.
     2315         end.
     2316      end.
     2317      return vCrErr.
     2318   end.
     2319   method public logical CheckMarkForType
     2320    (input idb-num   as integer,
     2321     input idoc-id   as integer):
     2322      define variable vMarking        as logical no-undo.
     2323      define variable vArtic          as logical no-undo.
     2324      define variable vTransitional   as logical no-undo.
     2325      define buffer utd-lines         for utd-lines.
     2326      define buffer utd-marking-lines for utd-marking-lines.
     2327      block-line:
     2328      for each utd-lines where utd-lines.db-num eq idb-num
     2329                           and utd-lines.doc-id eq idoc-id
     2330      no-lock:
     2331         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2332                          output vMarking         , output vArtic          , output vTransitional).
     2333         for each utd-marking-lines
     2334                     where utd-marking-lines.db-num  = utd-lines.db-num
     2335                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2336                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2337         no-lock:
     2338            if length(utd-marking-lines.mark) < 14
     2339            then do:
     2340               if (vMarking or vArtic) and not vTransitional
     2341               then
     2342                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2343            end.
     2344            else if not isMark(utd-marking-lines.mark)
     2345            then do:
     2346               if vMarking
     2347               then
     2348                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2349            end.
     2350            else do:
     2351            end.
     2352         end.
     2353      end.
     2354   end.
     2355   method public logical WeighedProd
     2356      ( input p-gds-code as integer) :
     2357      define variable v-par-val  as character no-undo.
     2358      define variable v-par-type as character no-undo.
     2359              if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2360               ( p-gds-code,
     2361                 'weighed-gds':U,
     2362                  output v-par-val,
     2363                  output v-par-type
     2364               ).
     2365      return logical(v-par-val).
     2366   end.
     2367   method public logical WghProdVariable
     2368       (input p-obj-type as char,
     2369        input p-obj-code as integer,
     2370        input p-gds-code as integer) :
     2371      define variable v-wgh-val  as character no-undo.
     2372      define variable v-par-val  as character no-undo.
     2373      define variable v-par-type as character no-undo.
     2374      define variable vMarking        as logical no-undo.
     2375      define variable vArtic          as logical no-undo.
     2376      define variable vTransitional   as logical no-undo.
     2377      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2378         if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2379           ( p-gds-code,
     2380             'weighed-gds':U,
     2381              output v-wgh-val,
     2382              output v-par-type
     2383           ).
     2384       if logical(v-wgh-val) = yes then do:
     2385           if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     2386               ( p-gds-code,
     2387                 'mark-type':U,
     2388                  output v-par-val,
     2389                  output v-par-type
     2390               ).
     2391           if v-par-val <> "" then do:
     2392               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2393               assign
     2394                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2395                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2396                  .
     2397           end.
     2398      end.
     2399      if v-wgh-val > "" and (vMarking or vArtic)
     2400      then return yes.
     2401      else return no.
     2402   end.
     2403   method public decimal MarkWeight
     2404      ( input p-mark as character) :
     2405      define buffer  buf_marking-attr for  ub.marking-attr.
     2406      define variable vMarkWeight as decimal no-undo.
     2407      vMarkWeight = 0.
     2408      if p-mark <> "" and p-mark <> ?
     2409      then do:
     2410          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2411                                        and buf_marking-attr.attr-code eq "weight"
     2412             no-lock no-error.
     2413          if not available buf_marking-attr
     2414          then do :
     2415            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2416                                          and buf_marking-attr.attr-code eq "weight"
     2417               no-lock no-error.
     2418          end .
     2419          if avail buf_marking-attr
     2420          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2421      end.
     2422      return vMarkWeight.
     2423   end.
