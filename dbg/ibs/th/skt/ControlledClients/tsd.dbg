     6827             end.
     6828             for each utd no-lock where utd.doc-code = buf_doc-line.doc-code:
     6829               for each utd-marking-lines no-lock where utd-marking-lines.doc-id = utd.doc-id and utd-marking-lines.db-num = utd.db-num and utd-marking-lines.gds-code = buf_goods.gds-code
     6830                 and (utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB or utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB):
     6831                 for each marking no-lock where marking.mark = utd-marking-lines.mark.
     6832                   if can-find (buf_utd-marking-lines where
     6833                         buf_utd-marking-lines.doc-id = utd.doc-id and buf_utd-marking-lines.db-num = utd.db-num and buf_utd-marking-lines.mark = marking.mark-parent
     6834                       )
     6835                     then next.
     6836                   v-qnty = v-qnty + marking.box-qnty.
     6837                 end.
     6838               end.
     6839               decDocQnty = buf_doc-line.doc-qnty - buf_doc-line.fact-qnty.
     6840               decFactQnty = v-qnty.
     6841             end.
     6842           end.
     6843           else do:
     6844             for each marking-attr no-lock where (    marking-attr.attr-code = "inv-doc"
     6845                                                  and marking-attr.attr-value = buf_doc-line.doc-code)
     6846                                               or (marking-attr.attr-code = "inv-doc-scan"
     6847                                                   and marking-attr.attr-value = buf_doc-line.doc-code)  :
     6848               if not can-find (first marking no-lock where marking.mark = marking-attr.mark and marking.unit-ext = "UNIT" and marking.gds-code = buf_goods.gds-code)
     6849                 then next.
     6850               v-qnty = v-qnty + 1.
     6851             end.
     6852             decDocQnty = buf_doc-line.doc-qnty - buf_doc-line.fact-qnty.
     6853             decFactQnty = v-qnty.
     6854           end.
     6855           assign
     6856             priceSale   = if buf_doc-line.price-rubl <> ? then buf_doc-line.price-rubl else 0
     6857             .
     6858           jjm = jjm + 1.
     6859           addDocLine(jjm,
     6860                          v-doc-num,
     6861                          pos,
     6862                          buf_goods.gds-code,
     6863                          buf_goods.gds-name ,
     6864                         buf_goods.unit-base,
     6865                         full-b-code,
     6866                          priceSale,
     6867                          decDocQnty,
     6868                          decFactQnty,
     6869                          "",
     6870                         v-doc-num + "_" + string (buf_goods.gds-code),
     6871                          myflagsDocLine:FlagsToInt  ).
     6872           if not v-is-introduce
     6873           then do:
     6874             for each buf_m-l no-lock where buf_m-l.obj-type = buf_doc-line.obj-type
     6875                 and buf_m-l.obj-code = buf_doc-line.obj-code
     6876                 and buf_m-l.out-code = 'free-zone':U
     6877                 and buf_m-l.gds-code = buf_goods.gds-code
     6878               :
     6879                  vmark = isMark(buf_m-l.mark).
     6880               if vmark
     6881               then do:
     6882                  find first buf_m no-lock where buf_m.mark = buf_m-l.mark no-error.
     6883                  if available (buf_m)
     6884                  then do:
     6885                     if buf_m.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     6886                       then next.
     6887                     if not buf_m.unit-ext = "UNIT"
     6888                     then do:
     6889                       find first buf_m-chi no-lock where buf_m-chi.mark-parent = buf_m.mark
     6890                         and buf_m-chi.unit-ext = "UNIT" no-error.
     6891                       if not available (buf_m-chi)
     6892                         then next.
     6893                     end.
     6894                     block-attr:
     6895                     for each marking-attr where (marking-attr.attr-code = "inv-doc"
     6896                                                            and marking-attr.mark = buf_m.mark)
     6897                                                         or (marking-attr.attr-code = "inv-doc-scan"
     6898                                                             and marking-attr.mark = buf_m.mark)
     6899                     no-lock:
     6900                     leave block-attr.
     6901                     end.
     6902                    if available marking-attr
     6903                    then v-sts = "Check".
     6904                    else v-sts = "UTD".
     6905                  end.
     6906                  else next.
     6907               end.
     6908               else v-sts = "Check".
     6909               jj = jj + 1.
     6910               if vmark
     6911                 and available buf_m
     6912               then vqnty = buf_m.box-qnty.
     6913               if vqnty = ? then vqnty = 0.
     6914               addDocLineMark(
     6915                       jj,
     6916                         v-doc-num,
     6917                       pos,
     6918                         buf_m-l.mark,
     6919                         v-doc-num + "_" + string (buf_goods.gds-code),
     6920                         "Check",
     6921                         (if available buf_m then buf_m.mark-parent else ""),
     6922                       vqnty,
     6923                       if available buf_m then  buf_m.unit-ext else ""
     6924                       ).
     6925             end.
     6926           end.
     6927           else do:
     6928             find first buf_utd no-lock where buf_utd.doc-code = buf_trn-doc.doc-code.
     6929             l_utdf:
     6930             for each buf_utd-l where buf_utd-l.db-num = buf_utd.db-num and buf_utd-l.doc-id = buf_utd.doc-id
     6931               and buf_utd-l.gds-code = buf_goods.gds-code no-lock:
     6932               find first buf_goods no-lock where buf_goods.gds-code = buf_utd-l.gds-code no-error.
     6933               if not available (buf_goods)
     6934               then do:
     6935                 logWrite:WriteFileToLog( substitute ( "Не указан товар TH в документе УТД &1.", v-doc-num)).
     6936                 next l_utdf.
     6937               end.
     6938               find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code.
     6939               internal-b-code = buf_bar-code.b-code.
     6940   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6941     define variable tmp-str14  as character no-undo.
     6942     define variable tmp-num14  as character no-undo.
     6943     define variable i14        as integer   no-undo.
     6944     define variable sum14      as integer   no-undo.
     6945     define variable len-code14 as integer   no-undo.
     6946     define variable varcont14  as logical   initial yes no-undo.
     6947     CASE bc-frmt :
     6948       WHEN "EAN13" THEN do:
     6949         assign
     6950           tmp-str14 = string( internal-b-code, "999999999999" )
     6951         .
     6952       end.
     6953       WHEN "EAN8" THEN do:
     6954         assign
     6955           tmp-str14 = string( internal-b-code, "9999999" )
     6956         .
     6957       end.
     6958       OTHERWISE DO:
     6959           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     6960           view-as alert-box error.
     6961           return error.
     6962       END.
     6963     END CASE.
     6964     if varcont14 = yes then do:
     6965       if integer( substring( tmp-str14, 1, length( bc-pfx ) ) ) <> 0
     6966       then do:
     6967         message
     6968           "Невозможно сформировать бар-код" SKIP
     6969           "для товара с кодом: " internal-b-code
     6970           view-as alert-box error title "подрезание кода".
     6971         return error.
     6972       end.
     6973       else do:
     6974         assign
     6975           full-b-code = bc-pfx + substring( tmp-str14, length( bc-pfx ) + 1, length( tmp-str14 ) - length( bc-pfx ) )
     6976           len-code14    = length( full-b-code )
     6977         .
     6978         define variable v-sum-char14 as character no-undo .
     6979         assign
     6980           sum14 = 0
     6981         .
     6982         do i14 = 1 to len-code14 by 2
     6983         :
     6984           assign
     6985             v-sum-char14 = substr(full-b-code, len-code14 - i14 + 1, 1)
     6986           .
     6987           if v-sum-char14 < "0"
     6988           or v-sum-char14 > "9"
     6989           then do:
     6990             message
     6991               "Невозможно сформировать бар-код" skip
     6992               "для товара с кодом: " internal-b-code skip
     6993               view-as alert-box error title "подсчет контрольной суммы".
     6994             return error.
     6995           end.
     6996           assign
     6997             sum14 = sum14 + integer(v-sum-char14)
     6998           .
     6999         end.
     7000         if varcont14 = yes then do:
     7001           assign
     7002             sum14 = sum14 * 3
     7003           .
     7004           do i14 = 2 to len-code14 by 2
     7005           :
     7006             assign
     7007               v-sum-char14 = substr(full-b-code, len-code14 - i14 + 1, 1)
     7008             .
     7009             if v-sum-char14 < "0"
     7010             or v-sum-char14 > "9"
     7011             then do:
     7012               message
     7013                 "Невозможно сформировать бар-код" skip
     7014                 "для товара с кодом: " internal-b-code skip
     7015                 view-as alert-box error title "подсчет контрольной суммы".
     7016               return error.
     7017             end.
     7018             assign
     7019               sum14 = sum14 + integer(v-sum-char14)
     7020             .
     7021           end.
     7022           if varcont14 = yes then do:
     7023              if sum14 mod 10 = 0 then do:
     7024                assign
     7025                  full-b-code = full-b-code + '0'
     7026                .
     7027              end.
     7028              else do:
     7029                assign
     7030                  full-b-code = full-b-code + string(10 - sum14 mod 10)
     7031                .
     7032              end.
     7033           end.
     7034         end.
     7035       end.
     7036     end.
     7037               PriceSale = buf_utd-l.Total / buf_utd-l.Quantity.
     7038               decDocQnty = buf_utd-l.Quantity.
     7039               for each buf_utd-m-l where buf_utd-m-l.db-num = buf_utd.db-num and buf_utd-m-l.doc-id = buf_utd.doc-id and buf_utd-m-l.LineNum = buf_utd-l.LineNum
     7040                 no-lock
     7041                 :
     7042                 vmark = ismark(buf_utd-m-l.mark).
     7043                 if vmark
     7044                 then do:
     7045                    find first buf_m no-lock where buf_m.mark = buf_utd-m-l.mark no-error.
     7046                    if not available (buf_m)
     7047                    then do:
     7048                      logWrite:WriteFileToLog(substitute ("Некорректная марка &1.", buf_utd-m-l.mark)).
     7049                      next.
     7050                    end.
     7051                 end.
     7052                 jj = jj + 1.
     7053                 if vmark
     7054                    and available buf_m
     7055                 then do:
     7056                    vqnty = buf_m.box-qnty.
     7057                    if vqnty = ? then vqnty = decimal(GetAttrUtdlinesEx (buf_utd-m-l.db-num,buf_utd-m-l.doc-id,buf_utd-m-l.lineNum,"box-qnty","0")) no-error.
     7058                 end.
     7059                 else vqnty = decimal(GetAttrUtdlinesEx (buf_utd-m-l.db-num,buf_utd-m-l.doc-id,buf_utd-m-l.lineNum,"box-qnty","0")) no-error.
     7060                 if vqnty = ? then vqnty = 0.
     7061                 addDocLineMark(
     7062                       jj,
     7063                         v-doc-num,
     7064                       buf_utd-l.linenum,
     7065                       buf_m-l.mark,
     7066                         v-doc-num + "_" + string (buf_goods.gds-code),
     7067                         "CrTSD",
     7068                         (if available buf_m then buf_m.mark-parent else ""),
     7069                       vqnty,
     7070                       if available buf_m then  buf_m.unit-ext else ""
     7071                       ).
     7072               end.
     7073             end.
     7074           end.
     7075         end.
     7076         if v-is-introduce
     7077           then doctype = "InvIntroduce".
     7078           else docType = "InvMarks".
     7079         addDoc(
     7080              v-doc-num,
     7081              docType,
     7082              false,
     7083              buf_trn-doc.status_ + string (buf_trn-doc.flag, "+/-"),
     7084              buf_trn-doc.cli-code,
     7085              buf_trn-doc.cli-type,
     7086              buf_trn-doc.obj-code,
     7087              buf_trn-doc.obj-type,
     7088              "",
     7089               "",
     7090              0,
     7091              now,
     7092              myflagsDoc:FlagsToInt
     7093         ).
     7094         logWrite:WriteDebugLog( "Выгружен документ " + buf_trn-doc.doc-code).
     7095       end.
     7096     end.
     7097     method private character decToString (iValue as decimal ):
     7098        return replace(trim(string(iValue, "->>>>>>>>>>>>9.9<<<<<")),".",",").
     7099     end.
     7100     method private void addDoc(
     7101        idoc-num as char,
     7102        idocType as char,
     7103        icomplite as logical,
     7104        istatus as char,
     7105        icli-code as int,
     7106        icli-type as char,
     7107        iobj-code as int,
     7108        iobj-type as char,
     7109        iuser-id as character,
     7110        iuser-login as char,
     7111        iFactSum as dec,
     7112        idoc-date as datetime-tz,
     7113        iflags as int
     7114     ):
     7115        find first TempTrnDocMT where TempTrnDocMT.DocName eq idoc-num no-lock no-error.
     7116        if not available TempTrnDocMT
     7117        then do:
     7118           create TempTrnDocMT.
     7119           TempTrnDocMT.DocName = idoc-num.
     7120        end.
     7121        assign
     7122           TempTrnDocMT.DocType     = idocType
     7123           TempTrnDocMT.Complete_   = icomplite
     7124           TempTrnDocMT.Status_     = istatus
     7125           TempTrnDocMT.ClientID    = icli-code
     7126           TempTrnDocMT.ClientType  = icli-type
     7127           TempTrnDocMT.ObjectID    = iobj-code
     7128           TempTrnDocMT.ObjectType  = iobj-type
     7129           TempTrnDocMT.UserID_     = iuser-id
     7130           TempTrnDocMT.UserName    = iuser-login
     7131           TempTrnDocMT.FactSum     = iFactSum
     7132           TempTrnDocMT.StartDate   = idoc-date
     7133           TempTrnDocMT.Flags_      = iflags
     7134         .
     7135     end.
     7136     method public void docPrint(idir as char):
     7137        tsdstreamopenapp(idir + "\MT_documents.txt").
     7138        for each TempTrnDocMT no-lock:
     7139           put stream tsdstream unformatted
     7140           TempTrnDocMT.DocName + chr(30) +
     7141           TempTrnDocMT.DocType + chr(30) +
     7142           string(TempTrnDocMT.Complete_,"true/false") + chr(30) +
     7143           TempTrnDocMT.Status_ + chr(30) +
     7144           string (TempTrnDocMT.ClientID) + chr(30) +
     7145           TempTrnDocMT.ObjectType + chr(30) +
     7146           string (TempTrnDocMT.ObjectID) + chr(30) +
     7147           TempTrnDocMT.ObjectType + chr(30) +
     7148           TempTrnDocMT.UserID_ + chr(30) +
     7149           TempTrnDocMT.UserName + chr(30) +
     7150           decToString(TempTrnDocMT.FactSum) + chr(30) +
     7151           iso-date (TempTrnDocMT.StartDate) + chr(30)
     7152           + string(TempTrnDocMT.Flags_) + chr(31).
     7153        end.
     7154        tsdstreamclose().
     7155     end.
     7156     method private void addDocLine(pos as integer,
     7157                          idoc-num as char,
     7158                          iline-num as int,
     7159                          igds-code as int,
     7160                          igds-name as character ,
     7161                          iunit-base as character ,
     7162                          ifull-b-code as char,
     7163                          ipriceSale as dec,
     7164                          idocQnty as dec,
     7165                          ifactQnty as  dec,
     7166                          iError as char,
     7167                          iRecKey as char,
     7168                          iflags as int
     7169     ):
     7170        find first TempTrnLineMT where TempTrnLineMT.docname eq idoc-num
     7171                                 and TempTrnLineMT.pos eq pos
     7172        no-lock no-error.
     7173        if not available TempTrnLineMT
     7174        then do:
     7175           create TempTrnLineMT.
     7176           assign
     7177              TempTrnLineMT.docname = idoc-num
     7178              TempTrnLineMT.pos = pos
     7179           .
     7180        end.
     7181        assign
     7182           TempTrnLineMT.goodsid     = igds-code
     7183           TempTrnLineMT.goodsname   = igds-name
     7184           TempTrnLineMT.UnitBC      = iunit-base
     7185           TempTrnLineMT.BC          = ifull-b-code
     7186           TempTrnLineMT.Price_      = ipriceSale
     7187           TempTrnLineMT.DocQnty     = idocQnty
     7188           TempTrnLineMT.FactQnty    = ifactQnty
     7189           TempTrnLineMT.Error       = iError
     7190           TempTrnLineMT.PartIDTH    = iRecKey
     7191           TempTrnLineMT.Flags_      = iflags
     7192           TempTrnLineMT.lineId      = iline-num
     7193        .
     7194     end.
     7195     method public void docLinePrint(idir as char):
     7196         tsdstreamopenapp(idir + "\MT_lines.txt").
     7197         for each TempTrnLineMT no-lock:
     7198           put stream tsdstream unformatted
     7199             substitute ("&2&1&3&1&4&1&5&1&6&1&7&1&8&1&9&1",
     7200                         chr(30),
     7201                         TempTrnLineMT.pos,
     7202                         TempTrnLineMT.docname ,
     7203                         TempTrnLineMT.lineid,
     7204                         TempTrnLineMT.goodsid,
     7205                         TempTrnLineMT.goodsname,
     7206                         TempTrnLineMT.UnitBC,
     7207                         TempTrnLineMT.BC,
     7208                         decToString(TempTrnLineMT.Price_)
     7209                        )
     7210           +
     7211            substitute ("&3&1&4&1&5&1&6&1&7&2",
     7212                         chr(30),
     7213                         chr(31),
     7214                         decToString(TempTrnLineMT.DocQnty),
     7215                         decToString(TempTrnLineMT.FactQnty),
     7216                         TempTrnLineMT.Error,
     7217                         TempTrnLineMT.PartIDTH,
     7218                         TempTrnLineMT.Flags_
     7219                         )
     7220                        .
     7221         end.
     7222         tsdstreamclose().
     7223     end.
     7224     method private void addDocLineMark(
     7225        iline-num as integer,
     7226        idoc-num as char,
     7227        pos as int,
     7228        imark as char,
     7229        iRecKey as char,
     7230        iStatus as char,
     7231        iMarkParent as char,
     7232        iMarkQnty as int,
     7233        iUnitBox as char
     7234     ):
     7235        find first TempMarkLineMT where TempMarkLineMT.DocName  eq idoc-num
     7236                                     and TempMarkLineMT.MarkCode     eq imark
     7237        no-error.
     7238        if not available TempMarkLineMT
     7239        then do:
     7240           create TempMarkLineMT.
     7241           assign
     7242              TempMarkLineMT.DocName = idoc-num
     7243              TempMarkLineMT.MarkCode     = imark
     7244           .
     7245        end.
     7246        assign
     7247           TempMarkLineMT.pos         = pos
     7248           TempMarkLineMT.lineID      = iline-num
     7249           TempMarkLineMT.PartIDTH      = iRecKey
     7250           TempMarkLineMT.Status_     = iStatus
     7251           TempMarkLineMT.MarkParent  = iMarkParent
     7252           TempMarkLineMT.BoxQnty    = iMarkQnty
     7253           TempMarkLineMT.UnitBox    = iUnitBox
     7254        .
     7255     end.
     7256     method public void docLineMarkPrint(idir as char):
     7257        tsdstreamopenapp(idir + "\MT_MarkLines.txt").
     7258        for each TempMarkLineMT no-lock:
     7259        put stream tsdstream unformatted
     7260            substitute ("&3&1&4&1&5&1&6&1&7&8&2",
     7261                   chr(30),
     7262                   chr(31),
     7263                   TempMarkLineMT.lineId,
     7264                   TempMarkLineMT.DocName,
     7265                   TempMarkLineMT.MarkCode,
     7266                   TempMarkLineMT.PartIDTH,
     7267                   TempMarkLineMT.Status_,
     7268                   if     TempMarkLineMT.MarkParent ne ?
     7269                      and TempMarkLineMT.BoxQnty   ne ?
     7270                   then
     7271                      substitute ("&1&2&1&3",chr(30),
     7272                                           TempMarkLineMT.MarkParent,
     7273                                           TempMarkLineMT.BoxQnty)
     7274                   else ""
     7275                  )
     7276         .
     7277         end.
     7278         tsdstreamclose().
     7279       end.
     7280     method public void docWrite():
     7281        docPrint(resType,cp).
     7282     end.
     7283     method public void docPrint(type as char,encoding as char):
     7284        for each TempTrnDocMT no-lock:
     7285           create TempTrnLineMTs.
     7286           TempTrnLineMTs.DocName = TempTrnDocMT.DocName.
     7287        end.
     7288        ttPrint(type,
     7289           DATASET  ds-doc:handle,encoding).
     7290        empty temp-table TempTrnLineMTs .
     7291     end.
     7292     method public logical parseCSV( idir as char ):
     7293       define variable lResult    as logical   no-undo.
     7294       define variable cFactQnty  as decimal  no-undo.
     7295       define variable cDocQnty   as decimal  no-undo.
     7296       define variable cPriceRubl as decimal  no-undo.
     7297       define variable RowSum     as decimal   no-undo.
     7298       define variable iDbNum     as integer   no-undo.
     7299       define variable docType    as character no-undo.
     7300       define variable vFilename  as character no-undo.
     7301       myflagsDoc:unSetAllFlags().
     7302       iDbNum = GetDbNum().
     7303       empty temp-table TempTrnDocMT.
     7304       empty temp-table TempTrnLineMT.
     7305       empty temp-table TempMarkLineMT.
     7306       vFilename = idir + "\MT_documentsSend.json".
     7307       if SearchFile(vFilename) ne ?
     7308       then do:
     7309          dataset ds-doc:read-json ("file",SearchFile(vFilename),"EMPTY").
     7310       end.
     7311       for each TempTrnDocMT where TempTrnDocMT.Complete_ = true:
     7312         logWrite:WriteDebugLog("Загружаем документ " + TempTrnDocMT.DocName).
     7313         empty temp-table TempTrnDoc.
     7314         empty temp-table TempDocLine.
     7315         empty temp-table TempMarkLine.
     7316         case TempTrnDocMT.DocType:
     7317           when "ExtSalesWB" then do:
     7318             docType = 'ee':U.
     7319           end.
     7320           when "IntSalesWB" then do:
     7321             docType = 'ev':U.
     7322           end.
     7323           when "ExtPurchWB" then do:
     7324             docType = 'ie':U.
     7325           end.
     7326           when "IntPurchWB" then do:
     7327             docType = 'iv':U.
     7328           end.
     7329           when "Inv" then do:
     7330             docType = 'vt':U.
     7331           end.
     7332           when "Introduce" then do:
     7333             docType = "UTD_Introduce".
     7334           end.
     7335           when "UTD" then do:
     7336             docType = "UTD_DOC".
     7337           end.
     7338           when "InvMarks" then do:
     7339             docType = "invmark".
     7340           end.
     7341           when "MarksInv" then do:
     7342             docType = "MarksInv".
     7343           end.
     7344           when "InvIntroduce" then do:
     7345             docType = "InvIntroduce".
     7346           end.
     7347         end case.
     7348         userId_ = TempTrnDocMT.UserID_.
     7349         find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = userId_ no-lock no-error.
     7350         create TempTrnDoc.
     7351         assign
     7352           TempTrnDoc.line-num     = 1
     7353           TempTrnDoc.doc-date     = today
     7354           TempTrnDoc.ext-doc-code = TempTrnDocMT.DocName
     7355           TempTrnDoc.ext-doc-type = docType
     7356           TempTrnDoc.cli-type     = TempTrnDocMT.ClientType
     7357           TempTrnDoc.cli-code     = integer(TempTrnDocMT.ClientID)
     7358           TempTrnDoc.obj-type     = TempTrnDocMT.ObjectType
     7359           TempTrnDoc.obj-code     = TempTrnDocMT.ObjectID
     7360           TempTrnDoc.ps           = if available (ub.user-login) then "" else " Пользователь: " + TempTrnDocMT.UserName
     7361           TempTrnDoc.Status_      = TempTrnDocMT.Status_
     7362           TempTrnDoc.Flags_       = TempTrnDocMT.Flags_
     7363           .
     7364         myflagsDoc:setFlagsToInt(TempTrnDocMT.Flags_).
     7365         define variable cFactQntyDec as decimal no-undo .
     7366         define variable cPriceRublDec as decimal no-undo .
     7367         for each TempTrnLineMT where TempTrnLineMT.docname = TempTrnDocMT.DocName:
     7368             cDocQnty   = TempTrnLineMT.DocQnty .
     7369             cFactQnty  = TempTrnLineMT.FactQnty .
     7370             cPriceRubl = TempTrnLineMT.Price_ .
     7371             RowSum    = cFactQnty * cPriceRubl .
     7372           if myflagsDoc:isDocMarkOn and (docType = 'ie':U or docType = 'iv':U)
     7373           then do:
     7374             find first TempDocLine no-lock
     7375               where TempDocLine.gds-code = integer (TempTrnLineMT.goodsid)
     7376                 and TempDocLine.b-code = (TempTrnLineMT.BC) no-error.
     7377             if not available (TempDocLine)
     7378             then do:
     7379               create TempDocLine.
     7380               assign
     7381                 TempDocLine.line-num     = integer (TempTrnLineMT.pos)
     7382                 TempDocLine.gds-code     = integer (TempTrnLineMT.goodsid)
     7383                 TempDocLine.b-code       = string (TempTrnLineMT.BC)
     7384                 TempDocLine.fact-qnty    = decimal(cFactQnty)
     7385                 TempDocLine.doc-qnty     = decimal(cDocQnty)
     7386                 TempDocLine.price-rubl   = ?
     7387                 TempDocLine.RowSum       = ?
     7388                 TempDocLine.PartIDTH     = TempTrnLineMT.PartIDTH
     7389                 TempDocLine.NotDict      = TempTrnLineMT.goodsid eq 0
     7390                 .
     7391             end.
     7392             else do:
     7393               assign
     7394                 TempDocLine.fact-qnty    = TempDocLine.fact-qnty + cFactQnty
     7395                 TempDocLine.PartIDTH     = TempDocLine.PartIDTH + chr(4) + TempTrnLineMT.PartIDTH
     7396               .
     7397             end.
     7398           end.
     7399           else do:
     7400             create TempDocLine.
     7401             assign
     7402               TempDocLine.line-num     = TempTrnLineMT.pos
     7403               TempDocLine.gds-code     = TempTrnLineMT.goodsid
     7404               TempDocLine.b-code       = TempTrnLineMT.BC
     7405               TempDocLine.fact-qnty    = cFactQnty
     7406               TempDocLine.doc-qnty     = cDocQnty
     7407               TempDocLine.price-rubl   = cPriceRubl
     7408               TempDocLine.RowSum       = RowSum
     7409               TempDocLine.PartIDTH = TempTrnLineMT.PartIDTH
     7410               TempDocLine.NotDict      = TempTrnLineMT.goodsid eq 0
     7411               .
     7412           end.
     7413         end.
     7414         for each TempMarkLineMT
     7415             :
     7416           create TempMarkLine.
     7417           assign
     7418             TempMarkLine.DocName     =  TempMarkLineMT.DocName
     7419             TempMarkLine.PartIDTH    =  TempMarkLineMT.PartIDTH
     7420             TempMarkLine.MarkCode    =  TempMarkLineMT.MarkCode
     7421             TempMarkLine.Sts         =  TempMarkLineMT.Status_
     7422             TempMarkLine.MarkParent  =  TempMarkLineMT.MarkParent
     7423             .
     7424         end.
     7425         updatedocument(doctype, table TempTrnDoc, table TempDocLine, table TempMarkLine, userId_).
     7426         logWrite:WriteDebugLog("Загружен документ " + TempTrnDocMT.DocName).
     7427       end.
     7428       return true.
     7429     end.
     7430     method public void ttPrint(type as char,htable as handle):
     7431        ttPrint(type, htable, cp).
     7432     end.
     7433     method public void ttPrint(type as char, htable as handle, encoding as char):
     7434        if type eq "xml"
     7435        then
     7436           htable:WRITE-XML("longchar",SomeStr, true, encoding, ?, false, true ,false,true).
     7437        else if type eq "json"
     7438        then do:
     7439           htable:WRITE-json("longchar",SomeStr,TRUE,?,true,true,false).
     7440        end.
     7441        else
     7442           SomeStr = getStatusXml(false,"Тип ответа не подерживается responseType должно быть xml или json") .
     7443     end.
     7444     method public void docClear():
     7445        empty temp-table TempTrnDocMT.
     7446        empty temp-table TempTrnLineMTs.
     7447        empty temp-table TempTrnLineMT.
     7448        empty temp-table TempTrnLineMTs.
     7449        empty temp-table TempTrnLineMT.
     7450     end.
     7451     define STREAM sReadDir.
     7452     define temp-table tt-version no-undo
     7453        field fnAME    as character
     7454        field FullPath as character
     7455        field device   as character
     7456        field version  as character
     7457     index version device version
     7458     index fnAME FullPath fnAME.
     7459     method private void importVersion():
     7460        define variable vPureName as character no-undo.
     7461        define variable vFullPath as character no-undo.
     7462        define variable vFileType as character no-undo.
     7463        define variable mpos as integer no-undo.
     7464        define buffer ttfile for tt-version.
     7465        empty temp-table tt-version.
     7466        define variable vDir as character no-undo.
     7467        vdir = replace(search("exe/7z.exe"),"7z.exe","tsd").
     7468        if objExists(vdir,"d") ne ?
     7469        then do:
     7470           input STREAM sReadDir FROM os-dir(vdir).
     7471           repeat:
     7472              import stream sReadDir vPureName vFullPath vFileType.
     7473              if vPureName begins "." then next.
     7474              if vFileType =  "f" then
     7475              do:
     7476                 find first ttfile where ttfile.FullPath = vFullPath
     7477                                     and ttfile.fnAME     = vPureName
     7478                 no-error.
     7479                 if not available ttfile
     7480                 then do:
     7481                    create ttfile.
     7482                    assign
     7483                       ttfile.fnAME         = vPureName
     7484                       ttfile.FullPath      = vFullPath
     7485                    no-error.
     7486                    mpos = r-index (vPureName,".").
     7487                    if mpos > 0
     7488                    then
     7489                       vPureName = substring (vPureName,1,mpos - 1).
     7490                    mpos = index (vPureName,"_").
     7491                    if mpos = 0
     7492                    then
     7493                       ttfile.device = vPureName.
     7494                    else assign
     7495                       ttfile.device  = CAPS(substring (vPureName,1,mpos - 1))
     7496                       ttfile.version = substring (vPureName,  mpos + 1)
     7497                    .
     7498                 end.
     7499              end.
     7500            end.
     7501         end.
     7502      end.
     7503      method public void getListVersions():
     7504          importVersion().
     7505          SomeStr = getStatusXml(true,"",getVersion()).
     7506      end.
     7507      method private longchar getVersion():
     7508         define variable vVertion as longchar no-undo.
     7509         for each tt-version break by tt-version.device:
     7510            if first-of (tt-version.device)
     7511            then do:
     7512                vVertion = vVertion + substitute ("<&1><VERSIONS>",tt-version.device).
     7513            end.
     7514            vVertion = vVertion + substitute ("<VERSION>&1</VERSION>",tt-version.version).
     7515            if last-of (tt-version.device)
     7516            then do:
     7517               vVertion = vVertion + substitute ("</VERSIONS><LASTVERSION>&2</LASTVERSION></&1>",tt-version.device,tt-version.version).
     7518            end.
     7519         end.
     7520         return vVertion.
     7521      end.
     7522      method public char getFileVersion(iDevice as char,iversion as char):
     7523         importVersion().
     7524         if iversion = "" or iversion = ?
     7525         then
     7526            find last tt-version where tt-version.device = iDevice no-lock no-error.
     7527         else
     7528            find first tt-version where tt-version.device = iDevice
     7529                                    and tt-version.version = iversion
     7530            no-lock no-error.
     7531         return if available tt-version then tt-version.FullPath else ?.
     7532      end.
     7533      method public character addPrintBc(igds-code as integer, iqnty as decimal):
     7534         define buffer code for code.
     7535         define buffer goods for goods.
     7536         define buffer bar-code for bar-code.
     7537         find first goods where goods.gds-code =  igds-code no-lock no-error.
     7538         if not available goods
     7539         then
     7540            return substitute ("Не известный код товара &1", igds-code).
     7541         find first code  where code.parent eq "TiketPrint"
     7542                            and code.code   eq string(igds-code)
     7543         exclusive-lock no-error.
     7544         if not available code
     7545         then do:
     7546            create code.
     7547            assign
     7548               code.parent = "TiketPrint"
     7549               code.code = string(igds-code)
     7550               Code.CodeValue = string(iqnty)
     7551            .
     7552         end.
     7553         assign
     7554            Code.CodeName = goods.gds-name
     7555            code.status_ = 0
     7556         .
     7557     end.
     7558   end class.
