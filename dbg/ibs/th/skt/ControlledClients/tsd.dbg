     4650     method public void UsersPrint (type as char, file as char):
     4651       if    type eq "xml"
     4652          or type eq "json"
     4653       then do:
     4654          ttprint(type, dataset ds-user :handle).
     4655          if (file ne "" and file ne ?)
     4656          then
     4657             writeResult(file,"utf-8").
     4658       end.
     4659       else do:
     4660          if file eq ?
     4661          then
     4662             file = "temp_tsd.txt".
     4663          tsdstreamopen(file).
     4664          for each tt-user no-lock:
     4665            put stream tsdstream unformatted tt-user.user-id + chr(30) + tt-user.user-login + chr(31).
     4666       end.
     4667       tsdstreamclose().
     4668          if file = "temp_tsd.txt"
     4669          then
     4670             setResult(file).
     4671     end.
     4672     end.
