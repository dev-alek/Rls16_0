     4781     method public void GoodsClear ():
     4782        empty temp-table tt-Goods.
     4783     end.
     4784     method public void getGoods ():
     4785        getGoodsAndBarcodes(yes,no,?).
     4786     end.
     4787     method public void getGoodsAndBarcodes (iGoods as logical ,ibarcode as logical, input iprotocol as char):
     4788        define variable factQnty    as dec no-undo.
     4789        define variable freeQnty    as dec no-undo.
     4790        define variable countryName as character no-undo.
     4791        define variable dPriceSale  as decimal   no-undo.
     4792        define variable dVatPc      as decimal   no-undo.
     4793        define variable is-petrol   as logical no-undo.
     4794        define variable is-pieces   as logical no-undo.
     4795        define variable priceSale   as decimal no-undo.
     4796        define variable cliBaseRate as decimal no-undo.
     4797        define buffer buf_goods     for ub.goods.
     4798        define buffer buf_gds-obj   for ub.gds-obj.
     4799        define buffer buf_bar-code  for ub.bar-code.
     4800        define buffer buf_price-all for ub.price-all.
     4801        define buffer buf_prod-bc   for ub.prod-bc.
     4802        define buffer utd-lines for ub.utd-lines.
     4803        define buffer country for ub.country .
     4804        define variable vMarkingType   as integer no-undo init 0.
     4805        define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     4806        if ibarcode
     4807        then
     4808           EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(ObjType, ObjCode).
     4809        cicle:
     4810        for each buf_goods where buf_goods.stts = 0
     4811                             and buf_goods.gds-type = 'т'
     4812        no-lock :
     4813   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in ibs.th.gbl.gbl-hndllib:g#lib-trn
     4814     (
     4815        input buf_goods.artic
     4816     ,  input buf_goods.prod-type
     4817     ,  input buf_goods.prod-code
     4818     , output is-petrol
     4819     , output is-pieces
     4820     ) no-error.
     4821          if is-petrol = yes and is-pieces = no then do:
     4822             next cicle.
     4823          end.
     4824          find first buf_gds-obj where buf_gds-obj.gds-code = buf_goods.gds-code no-lock no-error.
     4825          if not available (buf_gds-obj)
     4826          then do:
     4827             find first utd-lines where utd-lines.gds-code = buf_goods.gds-code no-lock no-error.
     4828             if not available (utd-lines)
     4829             then next cicle.
     4830          end.
     4831          if(igoods)
     4832          then do:
     4833             find first country where country.alpha1 = buf_goods.alpha1 no-lock no-error.
     4834             assign
     4835                factQnty    = if available buf_gds-obj then buf_gds-obj.fact-qnty else 0
     4836                freeQnty    = if available buf_gds-obj then buf_gds-obj.free-qnty else 0
     4837                countryName = if available ub.country then ub.country.long-name else ""
     4838             .
     4839             create tt-goods.
     4840             assign
     4841                tt-goods.gds-code  = buf_goods.gds-code
     4842                tt-goods.gds-name  = buf_goods.gds-name
     4843                tt-goods.unit-base = buf_goods.unit-base
     4844                tt-goods.countryName = countryName
     4845                tt-goods.factQnty  = factQnty
     4846                tt-goods.freeQnty  = freeQnty
     4847             .
     4848          end.
     4849          if ibarcode
     4850          then do:
     4851             if iprotocol > ""
     4852             then do:
     4853                define variable v-value as character no-undo.
     4854                define variable v-type  as character no-undo.
     4855                             if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     4856                  (input  buf_goods.gds-code
     4857                  ,input  'mark-type':U
     4858                  ,output v-value
     4859                  ,output v-type
     4860                  ) no-error .
     4861                if error-status :error
     4862                then do:
     4863                   undo, return error return-value .
     4864                end.
     4865                myflagsbarcode:unSetAllFlags().
     4866                myflagsbarcode:isEDO = EDOParSec:GetIsEDOForType(v-value) .
     4867                myflagsbarcode:isArtic = EDOParSec:GetIsArticForType(v-value) .
     4868                myflagsBarcode:IsTransitional = EDOParSec:GetIsTransitionalForType(v-value) .
     4869             end.
     4870             for each buf_bar-code where buf_bar-code.in-code = ""
     4871                                     and buf_bar-code.gds-code = buf_goods.gds-code
     4872                                     and buf_bar-code.stts_ = 0
     4873             no-lock use-index prt-parts:
     4874                find last buf_price-all where
     4875                   buf_price-all.b-code          = buf_bar-code.b-code and
     4876                   buf_price-all.gds-code        = buf_goods.gds-code  and
     4877                   buf_price-all.obj-code        = ObjCode and
     4878                   buf_price-all.obj-type        = ObjType and
     4879                   buf_price-all.plt-priority    = 0                   and
     4880                   buf_price-all.last-pr         = true
     4881                no-lock no-error.
     4882                find first ub.gds-obj no-lock where
     4883                           ub.gds-obj.artic = buf_goods.artic
     4884                       and ub.gds-obj.prod-type = buf_goods.prod-type
     4885                       and ub.gds-obj.prod-code = buf_goods.prod-code no-error.
     4886                if available buf_price-all and not buf_price-all.price-sale = ?
     4887                then priceSale = buf_price-all.price-sale.
     4888                else if available (ub.gds-obj) and not ub.gds-obj.price-sale = ?
     4889                then priceSale = ub.gds-obj.price-sale.
     4890                else priceSale = 0.
     4891                if iprotocol eq "1.0" then do:
     4892                   if priceSale = 0
     4893                   then
     4894                      priceSale =  1 / 100000.
     4895                end.
     4896                assign
     4897                   cliBaseRate = buf_bar-code.cli-base-rate
     4898                .
     4899                for each buf_prod-bc where buf_prod-bc.b-code = buf_bar-code.b-code
     4900                                       and buf_prod-bc.bc-on = yes
     4901                no-lock:
     4902                   if iprotocol > ""
     4903                   then do:
     4904                      myflagsbarcode:isMark = false .
     4905                      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4906                      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq buf_prod-bc.b-code
     4907                                                    and buf_prod-bc-attr.b-str eq buf_prod-bc.b-str
     4908                                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4909                      no-lock no-error.
     4910                   end.
     4911                   create TempBCode.
     4912                   assign
     4913                      TempBCode.gds-code = buf_goods.gds-code
     4914                      TempBCode.b-str = buf_prod-bc.b-str
     4915                      TempBCode.unit-cli = buf_bar-code.unit-cli
     4916                      TempBCode.cliBaseRate = cliBaseRate
     4917                   no-error.
     4918                   if error-status:error
     4919                   then do:
     4920                      delete TempBCode.
     4921                      logWrite:WriteFileToLog(substitute ( "Ошибка передачи бар-кода &1 в ТСД.", buf_prod-bc.b-str)).
     4922                   end.
     4923                   if available buf_prod-bc-attr and logical(buf_prod-bc-attr.attr-value) then myflagsbarcode:isMark = true .
     4924                   if iprotocol eq "1.0"
     4925                   then
     4926                      TempBCode.priceSale = if (myflagsbarcode:isMark) then (-1 * priceSale ) else priceSale .
     4927                   else
     4928                      TempBCode.priceSale = priceSale .
     4929                      TempBCode.flags = myflagsbarcode:FlagsToInt .
     4930                end.
     4931             end.
     4932          end.
     4933       end.
     4934     end.
     4935     method public void GoodsPrint (type as char):
     4936       if    type eq "xml"
     4937          or type eq "json"
     4938       then do on error undo, leave:
     4939          define variable hDset as handle no-undo.
     4940          hDset = CreateDsGoods().
     4941          ttprint(type, hDset).
     4942          finally:
     4943              delete object hDset no-error.
     4944           end.
     4945       end.
     4946       else do:
     4947          if type eq ""
     4948          then
     4949             type = "temp_tsd.txt".
     4950       tsdstreamopen( type).
     4951       cicle:
     4952       for each tt-goods:
     4953               put stream tsdstream unformatted
     4954           string (tt-goods.gds-code) + chr(30) +
     4955           trim (tt-goods.gds-name, chr (9)) + chr(30) +
     4956           tt-goods.unit-base + chr(30) +
     4957           decToString( 0 ) + chr(30) +
     4958           decToString(0 ) + chr(30) +
     4959           tt-goods.countryName  + chr(30) +
     4960                   "Состав"  + chr(30) +
     4961           decToString(tt-goods.factQnty) + chr(30) +
     4962           decToString(tt-goods.freeQnty) + chr(31).
     4963       end.
     4964       tsdstreamclose().
     4965        if type = "temp_tsd.txt"
     4966          then
     4967             setResult(type).
     4968        end.
     4969     end.
     4970     method public void BarcodesClear ():
     4971        empty temp-table TempBCode.
     4972     end.
     4973     method public void GoodsAndBarcodesClear ():
     4974        GoodsClear().
     4975        BarcodesClear().
     4976        empty temp-table tt-barcodes.
     4977     end.
     4978     method public void getGoodsAndBarcodes (input iprotocol as char, idir as char):
     4979        GoodsAndBarcodesClear().
     4980        getGoodsAndBarcodes (yes, yes, iprotocol).
     4981        GoodsAndBarcodesPrint(resType,idir,iprotocol).
     4982     end.
     4983     method public void GoodsAndBarcodesPrint (input type as char, idir as character, iprotocol as character):
     4984        if    type eq "xml"
     4985           or type eq "json"
     4986        then do on error undo, leave:
     4987           define variable hDset as handle no-undo.
     4988           hDset = CreateDsGoodsAndBarcodes().
     4989           for each tt-Goods no-lock:
     4990              create tt-barcodes.
     4991              tt-barcodes.gds-code = tt-Goods.gds-code.
     4992           end.
     4993           ttprint(type, hDset).
     4994           if (idir ne "" and idir ne ?)
     4995           then
     4996              writeResult(idir + "\TH_goods." + resType,"utf-8").
     4997           finally:
     4998              delete object hDset no-error.
     4999           end.
     5000        end.
     5001        else do:
     5002           GoodsPrint(idir + "\TH_goods.txt").
     5003           BarcodesPrint(idir + "\TH_barcodes.txt", iprotocol).
     5004        end.
     5005     end.
     5006     method public void getBarcodes (input iprotocol as char):
     5007       getGoodsAndBarcodes(no,yes,iprotocol).
     5008     end.
     5009     method public void BarcodesPrint (type as char, iprotocol as character):
     5010        if    type eq "xml"
     5011          or type eq "json"
     5012       then do on error undo, leave:
     5013          define variable hDset as handle no-undo.
     5014          hdset = CreateDsBarcodes ().
     5015          ttprint(type,hDset).
     5016          finally:
     5017              delete object hDset no-error.
     5018           end.
     5019       end.
     5020       else do:
     5021          if type eq ""
     5022          then
     5023             type = "temp_tsd.txt".
     5024          tsdstreamopen(type).
     5025       if iprotocol = "1.0" or iprotocol = ""  then do:
     5026           for each TempBCode:
     5027               put stream tsdstream unformatted
     5028               string (TempBCode.gds-code) + chr(30) +
     5029               TempBCode.b-str + chr(30) +
     5030               decToString( TempBCode.priceSale) + chr(30) +
     5031               TempBCode.unit-cli + chr(30) +
     5032               decToString(TempBCode.cliBaseRate) + chr(31) .
     5033           end .
     5034           end.
     5035        else do:
     5036           for each TempBCode:
     5037               put stream tsdstream unformatted
     5038               string (TempBCode.gds-code) + chr(30) +
     5039               TempBCode.b-str + chr(30) +
     5040               decToString( TempBCode.priceSale) + chr(30) +
     5041               TempBCode.unit-cli + chr(30) +
     5042               decToString(TempBCode.cliBaseRate) + chr(30) +
     5043               string(TempBCode.flags) + chr(31) .
     5044           end.
     5045       end.
     5046       tsdstreamclose().
     5047          if type = "temp_tsd.txt"
     5048          then
     5049             setResult(type).
     5050        end.
     5051       BarcodesClear().
     5052     end.
     5053     method public logical ImpWB (table TempTrnDoc, table TempDocLine, table TempMarkLine, userId_ as char):
     5054       define buffer buf_trn-doc       for ub.trn-doc.
     5055       define buffer buf_doc-line      for ub.doc-line.
     5056       define buffer buf_doc-line-attr for ub.doc-line-attr.
     5057       define buffer gen-attr for ub.gen-attr.
     5058       define buffer goods for ub.goods.
     5059       define variable adapterOra-i516 as class   AdapterOra-i516.
     5060       define variable glog           as logical   no-undo.
     5061       define variable mes            as character no-undo.
     5062       define variable hLibMarks      as handle    no-undo.
     5063       define variable ii             as integer   no-undo.
     5064       define variable varzero-string as logical   no-undo.
     5065       define variable myflagsDoc     as class flagsdoc     no-undo.
     5066       find first TempTrnDoc.
     5067       if TempTrnDoc.ext-doc-code = 'vt':U then TempTrnDoc.Flags_ = 1 .
     5068       myflagsDoc = new flagsdoc ().
     5069       myflagsDoc:setFlagsToInt(TempTrnDoc.Flags_).
     5070       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = TempTrnDoc.ext-doc-code
     5071               and
     5072               (
     5073                 ((buf_trn-doc.ext-doc-type = 'ee':U
     5074                 or buf_trn-doc.ext-doc-type = 'ev':U
     5075                 or buf_trn-doc.ext-doc-type = 'vt':U)
     5076                 and buf_trn-doc.flag_ = true
     5077                 and buf_trn-doc.status_ = 'разрешен':U)
     5078               or
     5079                 ((buf_trn-doc.ext-doc-type = 'ie':U
     5080                 or buf_trn-doc.ext-doc-type = 'iv':U)
     5081                 and buf_trn-doc.flag_ = true
     5082                 and buf_trn-doc.status_ = 'накл':U)
     5083               )  no-error.
     5084       if available buf_trn-doc then
     5085       do:
     5086         if myflagsDoc:isDocMarkOn
     5087         then do:
     5088           for each TempDocLine no-lock where not TempDocLine.fact-qnty = 0 break by TempDocLine.gds-code:
     5089             for each TempMarkLine where lookup (TempMarkLine.PartIDTH, TempDocLine.PartIDTH, chr(4)) > 0 and TempMarkLine.Sts = "TH" no-lock:
     5090               for each gen-attr where gen-attr.p-key = TempMarkLine.PartIDTH and gen-attr.attr-code = TempMarkLine.MarkCode and gen-attr.table-name = 'excise-mark':U:
     5091                 delete gen-attr.
     5092               end.
     5093             end.
     5094           end.
     5095           for each TempMarkLine where TempMarkLine.Sts = "crTSD" no-lock:
     5096             create gen-attr.
     5097             gen-attr.p-key = TempMarkLine.PartIDTH.
     5098             gen-attr.attr-code = TempMarkLine.MarkCode.
     5099             gen-attr.table-name = 'excise-mark':U.
     5100             gen-attr.whole-send-news = 0.
     5101           end.
     5102         end.
     5103         for each TempDocLine no-lock break by TempDocLine.gds-code:
     5104           find first goods where goods.gds-code  = TempDocLine.gds-code
     5105             no-lock no-error .
     5106           find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5107             and buf_doc-line.artic = goods.artic
     5108             and buf_doc-line.prod-type = goods.prod-type
     5109             and buf_doc-line.prod-code = goods.prod-code
     5110             no-error  .
     5111           if available buf_doc-line then do:
     5112           end.
     5113           else do:
     5114             logWrite:WriteFileToLog( substitute ( "В накладной &1 отсутсвует товар с кодом &2.", TempTrnDoc.ext-doc-code, TempDocLine.gds-code )).
     5115             buf_trn-doc.ps = if buf_trn-doc.ps begins "@" then substitute ( "пропущен товар с кодом (штрих-код &3) &1&2.", TempDocLine.gds-code, chr(10), TempDocLine.b-code ) else substitute ( "&1&3 пропущен товар с кодом &2.",buf_trn-doc.ps, TempDocLine.gds-code, chr(10) ).
     5116             delete TempDocLine.
     5117             next.
     5118           end.
     5119         end.
     5120         os-delete value (search ("doctsd.txt")) no-error.
     5121         os-delete value (search ("newdoctsd.txt")) no-error.
     5122         output stream str1 to value ("doctsd.txt").
     5123         output stream str2 to value ("newdoctsd.txt").
     5124         for each TempDocLine where TempDocLine.is-tsd-qnty = true:
     5125           put stream str1 unformatted TempDocLine.b-code "," TempDocLine.fact-qnty skip.
     5126         end.
     5127         for each TempDocLine where TempDocLine.is-tsd-qnty = false:
     5128           put stream str2 unformatted TempDocLine.b-code "," TempDocLine.fact-qnty skip.
     5129         end.
     5130         output stream str1 close.
     5131         output stream str2 close.
     5132         if can-find (first TempDocLine)
     5133         then do:
     5134           run gbl/filnline.p (input ("doctsd.txt"), output varzero-string).
     5135           if varzero-string
     5136           then do:
     5137             run str/scantsd.p ( 2, input no , input recid(buf_trn-doc) ,input "doctsd.txt", if myflagsDoc:isDocMarkOn then "rsvmarks" else "" ) no-error.
     5138             if error-status:error then do:
     5139               LogWrite:LogStr = LogWrite:LogStr + chr(10) + return-value.
     5140               logWrite:WriteFileToLog(LogWrite:LogStr).
     5141               SomeStr = getStatusXml(false, LogWrite:LogStr).
     5142               os-delete value (search ("doctsd.txt")) no-error.
     5143               os-delete value (search ("newdoctsd.txt")) no-error.
     5144               return false.
     5145             end.
     5146           end.
     5147           run gbl/filnline.p (input ("newdoctsd.txt"), output varzero-string).
     5148           if varzero-string
     5149           then do:
     5150             run str/scantsd.p ( 1, input no , input recid(buf_trn-doc) ,input "newdoctsd.txt", if myflagsDoc:isDocMarkOn then "rsvmarks" else "" ) no-error.
     5151             if error-status:error then do:
     5152               LogWrite:LogStr = LogWrite:LogStr + chr(10) + return-value.
     5153               logWrite:WriteFileToLog(LogWrite:LogStr).
     5154               SomeStr = getStatusXml(false, LogWrite:LogStr).
     5155               os-delete value (search ("doctsd.txt")) no-error.
     5156               os-delete value (search ("newdoctsd.txt")) no-error.
     5157               return false.
     5158             end.
     5159           end.
     5160         end.
     5161         os-delete value (search ("doctsd.txt")) no-error.
     5162         os-delete value (search ("newdoctsd.txt")) no-error.
     5163         run gbl/calc-trn.p (?, recid(buf_trn-doc)) no-error .
     5164         SomeStr = getStatusXml(true, "").
     5165         return true.
     5166       end.
     5167       else
     5168       do:
     5169         adapterOra-i516 = new AdapterOra-i516().
     5170         adapterOra-i516:SetTempTable(table TempTrnDoc, table TempDocLine, userId_).
     5171         adapterOra-i516:WriteDB(output glog).
     5172         logWrite:WriteFileToLog(adapterOra-i516:StrLog).
     5173         delete object AdapterOra-i516.
     5174         if glog
     5175           then do:
     5176             SomeStr = getStatusXml(true, "").
     5177             return true.
     5178           end.
     5179           else do:
     5180             SomeStr = getStatusXml(false, LogWrite:LogStr).
     5181             return false.
     5182           end.
     5183       end.
     5184     end.
     5185       method public logical ImpMarksInv (table TempTrnDoc, table TempDocLine, table TempMarkLine):
     5186           def    var      v-utd-db-num   as integer   no-undo.
     5187           def    var      v-utd-doc-id   as integer   no-undo.
     5188           def    var      v-ext-doc-code as character no-undo.
     5189           define variable vLineNumWith   as integer   no-undo .
     5190           define variable vLineNum       as integer   no-undo .
     5191           define variable vError         as logical   no-undo .
     5192           define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5193           define buffer buf_utd               for ub.utd .
     5194           define buffer bf_utd                for ub.utd .
     5195           define buffer buf_utd-attr          for ub.utd-attr .
     5196           define buffer bf_utd-attr           for ub.utd-attr .
     5197           define buffer buf_utd-lines         for ub.utd-lines .
     5198           define buffer bf_utd-lines          for ub.utd-lines .
     5199           define buffer bf_utd-marking-lines  for ub.utd-marking-lines .
     5200           for each TempTrnDoc :
     5201               find first ub.clients no-lock where ub.clients.obj-code = TempTrnDoc.obj-code and
     5202                   ub.clients.obj-type = TempTrnDoc.obj-type no-error .
     5203               if error-status:error
     5204                   then next.
     5205               create buf_utd .
     5206               assign
     5207                   buf_utd.DocumentDate = today
     5208                   buf_utd.sts          = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     5209                   buf_utd.obj-code     = ub.clients.obj-code
     5210                   buf_utd.obj-type     = ub.clients.obj-type
     5211                   buf_utd.host-code    = ub.clients.host-code
     5212                   buf_utd.EDocType     = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     5213                   .
     5214               validate buf_utd .
     5215               assign
     5216                   buf_utd.DocumentNumber = string(buf_utd.doc-id) + "-" + string(ub.clients.obj-code) + substring(ub.clients.obj-type,1,1) .
     5217               create buf_utd-attr .
     5218               assign
     5219                   buf_utd-attr.db-num     = buf_utd.db-num
     5220                   buf_utd-attr.doc-id     = buf_utd.doc-id
     5221                   buf_utd-attr.attr-code  = "is-initial-set"
     5222                   buf_utd-attr.attr-value = string(true) .
     5223               .
     5224               release buf_utd-attr .
     5225               create bf_utd .
     5226               assign
     5227                   bf_utd.DocumentDate = today
     5228                   bf_utd.sts          = ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     5229                   bf_utd.obj-code     = ub.clients.obj-code
     5230                   bf_utd.obj-type     = ub.clients.obj-type
     5231                   bf_utd.host-code    = ub.clients.host-code
     5232                   bf_utd.EDocType     = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     5233                   .
     5234               validate bf_utd .
     5235               assign
     5236                   bf_utd.DocumentNumber = string(bf_utd.doc-id) + "-" + string(ub.clients.obj-code) + substring(ub.clients.obj-type,1,1) .
     5237               create bf_utd-attr .
     5238               assign
     5239                   bf_utd-attr.db-num     = bf_utd.db-num
     5240                   bf_utd-attr.doc-id     = bf_utd.doc-id
     5241                   bf_utd-attr.attr-code  = "is-initial-set"
     5242                   bf_utd-attr.attr-value = string(false) .
     5243               .
     5244               release bf_utd-attr .
     5245               vLineNum = 0 .
     5246               vLineNumWith = 0 .
     5247               for each TempDocLine:
     5248                   find first ub.goods no-lock where ub.goods.gds-code = TempDocLine.gds-code no-error .
     5249                   if error-status:error
     5250                       then
     5251                   do:
     5252                       logWrite:WriteFileToLog(substitute ("Товар не найден &1", TempDocLine.gds-code)).
     5253                       vError = true .
     5254                       next .
     5255                   end.
     5256                   find first ub.gds-obj-attr where ub.gds-obj-attr.gds-code = ub.goods.gds-code and
     5257                       ub.gds-obj-attr.obj-code = ub.clients.obj-code and ub.gds-obj-attr.obj-type = ub.clients.obj-type
     5258                       and ub.gds-obj-attr.attr-code = 'mark-collect-type':U no-lock no-error.
     5259                           tml_:
     5260                           for each TempMarkLine where TempMarkLine.PartIDTH = TempDocLine.PartIDTH and TempMarkLine.MarkCode <> "" :
     5261                                  define variable vmes as character no-undo.
     5262                                 if not (available ub.gds-obj-attr and (gds-obj-attr.attr-value eq "1" or gds-obj-attr.attr-value eq "2"))
     5263                                 then
     5264                                 vmes = CrCheckMarkDoc(buf_utd.obj-type, buf_utd.obj-code,
     5265                                             buf_utd.db-num, buf_utd.doc-id,
     5266                                             TempMarkLine.MarkCode,
     5267                                         true).
     5268                                 else
     5269                                 vmes = CrCheckMarkDoc(bf_utd.obj-type, bf_utd.obj-code,
     5270                                             bf_utd.db-num, bf_utd.doc-id,
     5271                                             TempMarkLine.MarkCode,
     5272                                          false).
     5273                                  if vmes ne ? and vmes ne ""
     5274                                  then
     5275                                     logWrite:WriteFileToLog(vmes).
     5276                           end.
     5277               end.
     5278               find first bf_utd-lines no-lock where bf_utd-lines.doc-id = bf_utd.doc-id and
     5279               bf_utd-lines.db-num = bf_utd.db-num no-error .
     5280               if not available (bf_utd-lines) then delete bf_utd .
     5281               find first buf_utd-lines no-lock where buf_utd-lines.doc-id = buf_utd.doc-id and
     5282               buf_utd-lines.db-num = buf_utd.db-num no-error .
     5283               if not available (buf_utd-lines) then delete buf_utd .
     5284               if vError = true then  undo, return false.
     5285           end.
     5286       end.
     5287     method public logical ImpInventory (table TempTrnDoc, table TempDocLine, userId_ as char):
     5288       define buffer buf_trn-doc       for ub.trn-doc.
     5289       define buffer buf_doc-line      for ub.doc-line.
     5290       define buffer buf_doc-line-attr for ub.doc-line-attr.
     5291       define buffer bfTempDocLine for TempDocLine.
     5292       define buffer bfTempDocLineTSD  for TempDocLineTSD .
     5293       define buffer bf_inv-doc-attr   for ub.inv-doc-attr .
     5294       define buffer inv-doc-attr for ub.inv-doc-attr.
     5295       define buffer trn-doc for ub.trn-doc.
     5296       define buffer goods for ub.goods.
     5297       define buffer doc-line for ub.doc-line.
     5298       define buffer prod-bc for ub.prod-bc.
     5299       define buffer clients for ub.clients.
     5300       define buffer bar-code for ub.bar-code.
     5301       define buffer marking for ub.marking.
     5302       define variable adapterOra-i506 as class   AdapterOra-i506.
     5303       define variable varzero-string  as logical no-undo.
     5304       define variable myflagsDoc     as class flagsdoc     no-undo.
     5305       define variable myflagsDocLine as class flagsdocline no-undo.
     5306       define variable invMulti as logical no-undo .
     5307       define variable ii              as integer   no-undo init 0 .
     5308       define variable vardoc-code     like ub.trn-doc.doc-code no-undo.
     5309       define variable v-marking-type  as character no-undo .
     5310       define variable v-type          as character no-undo .
     5311       define variable isManual        as logical   no-undo .
     5312       def    var      Marking         as class     mark            no-undo .
     5313       find first TempTrnDoc.
     5314       myflagsDoc = new flagsdoc ().
     5315       myflagsDocLine = new flagsdocline ().
     5316       myflagsDoc:setFlagsToInt(TempTrnDoc.Flags_).
     5317       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = TempTrnDoc.ext-doc-code
     5318         and buf_trn-doc.status_ = 'разрешен':U no-error.
     5319       if available buf_trn-doc then
     5320       do:
     5321         invMulti = false .
     5322         ii = 0 .
     5323         find first inv-doc-attr no-lock where inv-doc-attr.doc-code = TempTrnDoc.ext-doc-code and
     5324           inv-doc-attr.attr-code = 'invMultDevice' and inv-doc-attr.attr-value = string(true) no-error .
     5325         if available (inv-doc-attr) then invMulti = true .
     5326         if invMulti = false then next .
     5327         if invMulti then
     5328         do:
     5329           block-trn:
     5330           for each trn-doc no-lock where
     5331                                         (trn-doc.doc-code eq TempTrnDoc.ext-doc-code
     5332                                         and trn-doc.status_ = 'запрос':U)
     5333                                      or (trn-doc.doc-code begins TempTrnDoc.ext-doc-code + "/"
     5334                                      and trn-doc.status_ = 'запрос':U) by trn-doc.doc-code desc:
     5335             leave block-trn.
     5336           end.
     5337           if available (trn-doc) then
     5338           do:
     5339             ii = integer(entry(2,trn-doc.doc-code,"/")) .
     5340             TempTrnDoc.ext-doc-code = entry(1,trn-doc.doc-code,"/") + "/" + string(ii + 1) .
     5341           end.
     5342           else TempTrnDoc.ext-doc-code = TempTrnDoc.ext-doc-code + "/" + string(ii + 1) .
     5343           TempTrnDoc.Status_= 'запрос':U .
     5344         end.
     5345         if invMulti then
     5346         do:
     5347           create trn-doc .
     5348           trn-doc.doc-code = TempTrnDoc.ext-doc-code .
     5349           trn-doc.status_ = 'запрос':U .
     5350           trn-doc.flag_ = no .
     5351           buffer-copy buf_trn-doc except doc-code status_ flag_ to trn-doc .
     5352           find first inv-doc-attr exclusive-lock where inv-doc-attr.doc-code = trn-doc.doc-code
     5353           and inv-doc-attr.attr-code = 'invMultDevice' no-error .
     5354           if not available (inv-doc-attr) then do:
     5355           create inv-doc-attr .
     5356           assign
     5357           inv-doc-attr.doc-code = trn-doc.doc-code
     5358           inv-doc-attr.attr-code = 'invMultDevice' .
     5359           end.
     5360           inv-doc-attr.attr-value = string(true) .
     5361         end.
     5362         for each TempDocLine no-lock break by TempDocLine.gds-code:
     5363           find first goods where goods.gds-code  = TempDocLine.gds-code
     5364             no-lock no-error .
     5365           find first buf_doc-line exclusive-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5366             and buf_doc-line.artic = goods.artic
     5367             and buf_doc-line.prod-type = goods.prod-type
     5368             and buf_doc-line.prod-code = goods.prod-code
     5369             no-error  .
     5370           if available buf_doc-line then do:
     5371             if invMulti then do:
     5372             create doc-line .
     5373             doc-line.doc-code = TempTrnDoc.ext-doc-code .
     5374             buffer-copy buf_doc-line except doc-code to doc-line .
     5375             assign
     5376             doc-line.doc-qnty = TempDocLine.fact-qnty .
     5377             doc-line.fact-qnty = TempDocLine.fact-qnty - TempDocLine.doc-qnty .
     5378             end.
     5379             find first buf_doc-line-attr where buf_doc-line-attr.doc-code = buf_doc-line.doc-code and buf_doc-line-attr.gds-code = goods.gds-code and buf_doc-line-attr.attr-code = "tsd-qnty" no-lock no-error.
     5380             if not available buf_doc-line-attr and first-of (TempDocLine.gds-code)
     5381               then do:
     5382                 create buf_doc-line-attr.
     5383                 assign
     5384                   buf_doc-line-attr.attr-code = "tsd-qnty"
     5385                   buf_doc-line-attr.gds-code = goods.gds-code
     5386                   buf_doc-line-attr.doc-code = buf_doc-line.doc-code
     5387                 .
     5388               end.
     5389               else do:
     5390                 TempDocLine.is-tsd-qnty = true.
     5391               end.
     5392               release doc-line .
     5393           end.
     5394           else do:
     5395             logWrite:WriteFileToLog(substitute ( "В инвентаризации &1 отсутсвует товар с кодом &2.", TempTrnDoc.ext-doc-code, TempDocLine.gds-code )).
     5396             buf_trn-doc.ps = if buf_trn-doc.ps begins "@" then substitute ( "пропущен товар с кодом (штрих-код &3) &1&2.", TempDocLine.gds-code, chr(10), TempDocLine.b-code ) else substitute ( "&1&3 пропущен товар с кодом &2.",buf_trn-doc.ps, TempDocLine.gds-code, chr(10) ).
     5397             delete TempDocLine.
     5398             next.
     5399           end.
     5400         end.
     5401       end.
     5402       else
     5403       do:
     5404         if not (TempTrnDoc.ext-doc-code begins "TSD-") then do:
     5405         return true.
     5406         end.
     5407       find first bf_inv-doc-attr no-lock where bf_inv-doc-attr.attr-code = "ItogInv" and bf_inv-doc-attr.attr-value = TempTrnDoc.ext-doc-code no-error .
     5408       if available (bf_inv-doc-attr) then leave .
     5409       empty temp-table TempDocLineTSD .
     5410       find first clients no-lock where clients.obj-code = TempTrnDoc.obj-code and
     5411         clients.obj-type = TempTrnDoc.obj-type no-error .
     5412       if available (clients) then
     5413       do:
     5414         isManual = true .
     5415         for each TempDocLine:
     5416           find first goods no-lock where string(goods.gds-code) = TempDocLine.b-code no-error .
     5417           if available (goods) then
     5418           do:
     5419             createTempGoods(buffer goods,1, false) .
     5420           end.
     5421           else
     5422           do:
     5423             find first prod-bc no-lock where (string(prod-bc.b-code) = TempDocLine.b-code or prod-bc.b-str = TempDocLine.b-code) no-error .
     5424             if available (prod-bc) then
     5425             do:
     5426               find first bar-code no-lock where bar-code.b-code = prod-bc.b-code .
     5427               find first goods no-lock where goods.gds-code = bar-code.gds-code .
     5428               createTempGoods(buffer goods,bar-code.cli-base-rate,false) .
     5429             end.
     5430             else
     5431             do:
     5432               find first marking no-lock where marking.mark = TempDocLine.b-code no-error .
     5433               if available (marking) then
     5434               do:
     5435                 find first goods no-lock where goods.gds-code = marking.gds-code .
     5436                 createTempGoods(buffer goods,marking.box-qnty,true) .
     5437               end.
     5438               else
     5439               do:
     5440                 createTempGoodsError() .
     5441               end.
     5442             end.
     5443           end.
     5444         end.
     5445         for each TempDocLineTSD where not TempDocLineTSD.Flags_error:
     5446                   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     5447             (input  TempDocLineTSD.gds-code
     5448             ,input  'mark-type':U
     5449             ,output v-marking-type
     5450             ,output v-type
     5451             ) no-error .
     5452           if error-status :error
     5453             then
     5454           do:
     5455             undo, return error return-value .
     5456           end.
     5457           if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(clients.obj-type, clients.obj-code):GetIsMarkingForType(v-marking-type)
     5458             then
     5459           do:
     5460             TempDocLineTSD.mark-type = v-marking-type .
     5461             find first marking no-lock where marking.mark = TempDocLineTSD.mark and marking.sts = Marking:FreeZone:KeyIntDB no-error .
     5462             if not available (marking) then
     5463             do:
     5464               TempDocLineTSD.Flags_error = true.
     5465             end.
     5466           end.
     5467         end.
     5468         if can-find(TempDocLineTSD where TempDocLineTSD.mark-type <> "") then
     5469         do:
     5470           if can-find(TempDocLineTSD where TempDocLineTSD.mark-type = "") then
     5471           do:
     5472             for each TempDocLineTSD where not TempDocLineTSD.Flags_error and TempDocLineTSD.mark-type <> "":
     5473               TempDocLineTSD.Flags_error = true .
     5474             end.
     5475           end.
     5476         end.
     5477         find first TempDocLineTSD no-error .
     5478         if available (TempDocLineTSD) then
     5479         do:
     5480           vardoc-code = docCode("main", clients.obj-type, clients.obj-code, ?) no-error .
     5481           if error-status:error then
     5482           do:
     5483             logWrite:WriteFileToLog("Ошибка при генерации номера документа.") .
     5484             SomeStr = getStatusXml(false, "Ошибка при генерации номера документа.").
     5485             return false.
     5486           end.
     5487         end.
     5488         find first TempDocLineTSD where not TempDocLineTSD.Flags_error no-error .
     5489         if available (TempDocLineTSD) then
     5490         do:
     5491           createTrn( buffer clients ,vardoc-code,userId_).
     5492           createAttrInv(vardoc-code,"isManual",string(true)).
     5493           for each bfTempDocLineTSD where not bfTempDocLineTSD.Flags_:
     5494             createDocLine(vardoc-code, bfTempDocLineTSD.gds-code, bfTempDocLineTSD.fact-qnty).
     5495           end.
     5496         end.
     5497         find first TempDocLineTSD where TempDocLineTSD.Flags_error no-error .
     5498         if available (TempDocLineTSD) then
     5499         do:
     5500           createTrn(buffer clients, vardoc-code + "-M",userId_).
     5501           createAttrInv(vardoc-code + "-M","isManualError",string(true)).
     5502           for each bfTempDocLineTSD where bfTempDocLineTSD.Flags_:
     5503             find first goods where goods.gds-code = bfTempDocLineTSD.gds-code no-error .
     5504             if available (goods) then do:
     5505               createDocLine(vardoc-code + "-M", bfTempDocLineTSD.gds-code, bfTempDocLineTSD.fact-qnty).
     5506             end.
     5507             else do:
     5508               createDocLineError(vardoc-code + "-M", bfTempDocLineTSD.artic, bfTempDocLineTSD.prod-code, bfTempDocLineTSD.prod-type, bfTempDocLineTSD.fact-qnty).
     5509             end.
     5510           end.
     5511         end.
     5512       end.
     5513       end.
     5514       if can-find (first TempDocLine where TempDocLine.is-tsd-qnty = true) and
     5515          not invMulti then
     5516       do:
     5517         empty temp-table TempDocLineIsTSD.
     5518       for each TempDocLine where TempDocLine.is-tsd-qnty = true:
     5519           create TempDocLineIsTSD.
     5520           buffer-copy TempDocLine to TempDocLineIsTSD no-error.
     5521           if error-status:error then do:
     5522             logWrite:WriteFileToLog(error-status:get-message(1)).
     5523             SomeStr = getStatusXml(false, LogWrite:LogStr).
     5524             return false.
     5525       end.
     5526       end.
     5527         run str/scantsd.p ( 2, input no , input recid(buf_trn-doc) ,input table TempDocLineIsTSD, if myflagsDoc:isDocMarkOn then "rsvmarks" else "" ) no-error.
     5528           if error-status:error then do:
     5529           logWrite:WriteFileToLog(return-value).
     5530             SomeStr = getStatusXml(false, LogWrite:LogStr).
     5531             return false.
     5532           end.
     5533         end.
     5534       if can-find (first TempDocLine where TempDocLine.is-tsd-qnty = false) and
     5535          not isManual and
     5536          not invMulti then
     5537       do:
     5538         empty temp-table TempDocLineIsTSD.
     5539         for each TempDocLine where TempDocLine.is-tsd-qnty = false:
     5540           create TempDocLineIsTSD.
     5541           buffer-copy TempDocLine to TempDocLineIsTSD no-error.
     5542           if error-status:error then do:
     5543              logWrite:WriteFileToLog(error-status:get-message(1)).
     5544             SomeStr = getStatusXml(false, LogWrite:LogStr).
     5545             return false.
     5546           end.
     5547           end.
     5548         run str/scantsd.p ( 1, input no , input recid(buf_trn-doc) ,input table TempDocLineIsTSD, if myflagsDoc:isDocMarkOn then "rsvmarks" else "" ) no-error.
     5549         if error-status:error then do:
     5550           logWrite:WriteFileToLog(return-value).
     5551           SomeStr = getStatusXml(false, LogWrite:LogStr).
     5552           return false.
     5553         end.
     5554         end.
     5555       SomeStr = getStatusXml(true, "").
     5556       return true.
     5557     end method.
     5558     method public logical updatedocument (
     5559         docType as char,
     5560         table TempTrnDoc   ,
     5561         table TempDocLine ,
     5562         table TempMarkLine ,
     5563         userid_ as char
     5564         ):
     5565        define variable ErrStatus as logical no-undo.
     5566       define buffer bfTempDocLine for TempDocLine.
     5567       define buffer buf_bar-code  for ub.bar-code.
     5568       define buffer buf_prod-bc   for ub.prod-bc.
     5569       define buffer buf_place     for ub.place.
     5570        case docType:
     5571           when 'vt':U then
     5572             do:
     5573               if ImpInventory (table TempTrnDoc, table TempDocLine, userId_)
     5574               then ErrStatus = false.
     5575               else ErrStatus = true.
     5576             end.
     5577           when "UTD_DOC" then
     5578             do:
     5579               if ImpUTDDOC (table TempTrnDoc, table TempDocLine, table TempMarkLine)
     5580               then ErrStatus = false.
     5581               else ErrStatus = true.
     5582             end.
     5583           when "InvIntroduce" then
     5584             do:
     5585               if ImpUTDIntroduce(table TempTrnDoc, table TempDocLine, table TempMarkLine)
     5586               then ErrStatus = false.
     5587               else ErrStatus = true.
     5588             end.
     5589           when "invmark" then
     5590             do:
     5591               if ImpInvMarksDOC (table TempTrnDoc, table TempDocLine, table TempMarkLine)
     5592               then ErrStatus = false.
     5593               else ErrStatus = true.
     5594             end.
     5595           when "UTD_Introduce" then
     5596             do:
     5597               if ImpUTDIntroduce(table TempTrnDoc, table TempDocLine, table TempMarkLine)
     5598               then ErrStatus = false.
     5599               else ErrStatus = true.
     5600             end.
     5601            when "MarksInv" then
     5602             do:
     5603               if ImpMarksInv (table TempTrnDoc, table TempDocLine, table TempMarkLine)
     5604               then ErrStatus = false.
     5605               else ErrStatus = true.
     5606             end.
     5607           otherwise
     5608           do:
     5609             for each TempDocLine no-lock where not TempDocLine.b-code matches ("*" + string (TempDocLine.gds-code) + "*"):
     5610               find first bfTempDocLine where bfTempDocLine.gds-code = TempDocLine.gds-code and bfTempDocLine.b-code matches ( "*" + string (bfTempDocLine.gds-code) + "*")  no-error.
     5611               find buf_bar-code no-lock where
     5612                 buf_bar-code.gds-code = TempDocLine.gds-code and TempDocLine.b-code matches ("*" + string(buf_bar-code.b-code)+ "*") no-error.
     5613               if not available buf_bar-code then
     5614               do:
     5615                 find first buf_prod-bc no-lock where buf_prod-bc.b-str = TempDocLine.b-code no-error.
     5616                 if available buf_prod-bc
     5617                   then
     5618                 do:
     5619                   find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code and buf_bar-code.gds-code = TempDocLine.gds-code no-error.
     5620                 end.
     5621                 if not available buf_bar-code then
     5622                 do:
     5623                   LogWrite:LogStr =  LogWrite:LogStr + chr(10) + 'Отправлен ответ на запрос типа "WAYBILL".' + chr(10) + "Не известный штрих-код:" + TempDocLine.b-code.
     5624                   logWrite:WriteFileToLog( "Не известный штрих-код:" + TempDocLine.b-code).
     5625                   SomeStr = "Не известный штрих-код:" + TempDocLine.b-code.
     5626                   ErrStatus = true.
     5627                   return false.
     5628                 end.
     5629               end.
     5630               if not available bfTempDocLine
     5631                 then
     5632               do:
     5633                 create bfTempDocLine.
     5634                 assign
     5635                   bfTempDocLine.gds-code = TempDocLine.gds-code
     5636                   bfTempDocLine.b-code   = string (TempDocLine.gds-code)
     5637                   .
     5638               end.
     5639               assign
     5640                 bfTempDocLine.doc-qnty  = bfTempDocLine.doc-qnty + TempDocLine.doc-qnty * buf_bar-code.cli-base-rate
     5641                 bfTempDocLine.fact-qnty = bfTempDocLine.fact-qnty + TempDocLine.fact-qnty * buf_bar-code.cli-base-rate
     5642                 bfTempDocLine.RowSum    = bfTempDocLine.RowSum + TempDocLine.RowSum
     5643                 .
     5644               delete TempDocLine.
     5645             end.
     5646             for each TempDocLine no-lock:
     5647               assign
     5648                 TempDocLine.price-rubl = TempDocLine.RowSum / TempDocLine.fact-qnty.
     5649               .
     5650             end.
     5651             if ImpWB(table TempTrnDoc, table TempDocLine, table TempMarkLine, userId_)
     5652             then ErrStatus = false.
     5653             else ErrStatus = true.
     5654           end.
     5655         end.
     5656         return ErrStatus.
     5657      end.
     5658   method public void createTempGoods(buffer goods for goods, icli-base-rate as decimal , mark_ as logical):
     5659     define buffer del_TempDocLineTSD for TempDocLineTSD .
     5660     define buffer marking for ub.marking.
     5661     if not mark_ then do:
     5662     find first TempDocLineTSD where TempDocLineTSD.artic = goods.artic and
     5663       TempDocLineTSD.prod-code = goods.prod-code and
     5664       TempDocLineTSD.prod-type = goods.prod-type no-error .
     5665     if not available (TempDocLineTSD) then
     5666     do:
     5667       create TempDocLineTSD .
     5668       assign
     5669         TempDocLineTSD.gds-code  = goods.gds-code
     5670         TempDocLineTSD.artic     = goods.artic
     5671         TempDocLineTSD.prod-code = goods.prod-code
     5672         TempDocLineTSD.prod-type = goods.prod-type
     5673         .
     5674     end.
     5675     if TempDocLine.NotDict then
     5676     TempDocLineTSD.fact-qnty = TempDocLineTSD.fact-qnty + TempDocLine.fact-qnty * icli-base-rate .
     5677     else TempDocLineTSD.fact-qnty = TempDocLineTSD.fact-qnty + TempDocLine.fact-qnty .
     5678     end.
     5679     else
     5680     do:
     5681       find first marking no-lock where marking.mark = TempDocLine.b-code no-error .
     5682       if available (marking) then do:
     5683             find first TempDocLineTSD where TempDocLineTSD.artic = goods.artic and
     5684       TempDocLineTSD.prod-code = goods.prod-code and
     5685       TempDocLineTSD.prod-type = goods.prod-type no-error .
     5686         if not available (TempDocLineTSD) then
     5687     do:
     5688       create TempDocLineTSD .
     5689       assign
     5690         TempDocLineTSD.gds-code  = goods.gds-code
     5691         TempDocLineTSD.artic     = goods.artic
     5692         TempDocLineTSD.prod-code = goods.prod-code
     5693         TempDocLineTSD.prod-type = goods.prod-type
     5694         TempDocLineTSD.mark = marking.mark
     5695         TempDocLineTSD.mark-parent = marking.mark-parent
     5696         .
     5697         if marking.mark-parent = "" then do:
     5698           for each del_TempDocLineTSD where del_TempDocLineTSD.mark-parent = marking.mark:
     5699             delete del_TempDocLineTSD .
     5700           end.
     5701         end.
     5702               TempDocLineTSD.fact-qnty   = TempDocLineTSD.fact-qnty + TempDocLine.fact-qnty * marking.box-qnty.
     5703         end.
     5704         else do:
     5705           if not TempDocLineTSD.mark = marking.mark-parent then do:
     5706       create TempDocLineTSD .
     5707       assign
     5708         TempDocLineTSD.gds-code  = goods.gds-code
     5709         TempDocLineTSD.artic     = goods.artic
     5710         TempDocLineTSD.prod-code = goods.prod-code
     5711         TempDocLineTSD.prod-type = goods.prod-type
     5712         TempDocLineTSD.mark = marking.mark
     5713         TempDocLineTSD.mark-parent = marking.mark-parent
     5714         .
     5715         if marking.mark-parent = "" then do:
     5716           for each del_TempDocLineTSD where del_TempDocLineTSD.mark-parent = marking.mark:
     5717             delete del_TempDocLineTSD .
     5718           end.
     5719         end.
     5720               TempDocLineTSD.fact-qnty   = TempDocLineTSD.fact-qnty + TempDocLine.fact-qnty * marking.box-qnty.
     5721           end.
     5722         end.
     5723     end.
     5724   end.
     5725   end.
     5726   method public void createTempGoodsError():
     5727     find first TempDocLineTSD where TempDocLineTSD.artic = TempDocLine.b-code and
     5728       TempDocLineTSD.prod-code = 999999 and
     5729       TempDocLineTSD.prod-type = "орг" no-error .
     5730     if not available (TempDocLineTSD) then
     5731     do:
     5732       create TempDocLineTSD .
     5733       assign
     5734         TempDocLineTSD.artic       = TempDocLine.b-code
     5735         TempDocLineTSD.prod-code   = 999999
     5736         TempDocLineTSD.prod-type   = "орг"
     5737         TempDocLineTSD.Flags_error = true
     5738         .
     5739     end.
     5740       .
     5741     TempDocLineTSD.fact-qnty = TempDocLineTSD.fact-qnty + TempDocLine.fact-qnty .
     5742   end.
     5743   method public void createTrn(buffer clients for clients, docCode as character, parUserId as character):
     5744     define buffer bf_trn-doc    for ub.trn-doc .
     5745     define buffer bf_curr-accnt for ub.curr-accnt .
     5746     define buffer bf_sysconf    for ub.sysconf .
     5747     define buffer shop       for ub.shop .
     5748     if not available clients
     5749     then
     5750        return error "createTrn не передан клиент".
     5751     find first shop no-lock where shop.obj-code = clients.obj-code no-error .
     5752     if not available shop
     5753     then
     5754        return error "Не найден Магазин с кодом " + string(clients.obj-code).
     5755     find first bf_sysconf no-lock where bf_sysconf.host-code = clients.host-code .
     5756     if not available shop
     5757     then
     5758        return error "Не найден Фирма с кодом " + string(clients.host-code).
     5759     v-today = today .
     5760   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in ibs.th.gbl.gbl-hndllib:g#lib-trn
     5761   (input ?
     5762   ,input ?
     5763   ,input 1
     5764   ,input 1
     5765   ,input clients.host-code
     5766   ,input 'орг':U
     5767   ,input clients.obj-name
     5768   ,input clients.db-num
     5769   ,input parUserId
     5770   ,input ' '
     5771   ,input docCode
     5772   ,input v-today
     5773   ,input 'инв':U
     5774   ,input no
     5775   ,input clients.host-code
     5776   ,input no
     5777   ,input clients.obj-code
     5778   ,input clients.obj-type
     5779   ,input no
     5780   ,input shop.inv-pay
     5781   ,input '@  '
     5782   ,input no
     5783   ,input ?
     5784   ,input 'накл':U
     5785   ,input ?
     5786   ,input 'vt':U
     5787   ,input ?
     5788   ) no-error
     5789   .
     5790     if error-status:error then
     5791     do:
     5792       return error return-value.
     5793     end.
     5794     find bf_trn-doc where bf_trn-doc.doc-code = docCode.
     5795     assign
     5796       bf_trn-doc.tot-calc = ?.
     5797     assign
     5798       bf_trn-doc.status_ = 'запрос':U
     5799       bf_trn-doc.flag_   = no
     5800       bf_trn-doc.PS      = TempTrnDoc.ext-doc-code + ", " + string(TempTrnDoc.doc-date)
     5801       .
     5802     find last bf_curr-accnt where bf_curr-accnt.curr-code = bf_sysconf.base-code
     5803       and bf_curr-accnt.exch-date <= v-today use-index pi no-lock no-error.
     5804     if not available bf_curr-accnt then
     5805     do:
     5806       message "На дату" v-today "неизвестен курс базовой валюты." SKIP
     5807         "Сумма по документу в валюте будет рассчитана при закрытии на факт".
     5808     end.
     5809     else
     5810     do:
     5811       assign
     5812         bf_trn-doc.base-rate  = bf_curr-accnt.exch-rate
     5813         bf_trn-doc.base-scale = bf_curr-accnt.exch-scale.
     5814     END.
     5815     ASSIGN
     5816       bf_trn-doc.exch-code  = 0
     5817       bf_trn-doc.exch-rate  = 1
     5818       bf_trn-doc.exch-scale = 1.
     5819   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:   run str/lib-trn2.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn2) <> true) then do:     message       "Error starting lib-trn2.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.  run lib-trn2_crinvdoc in ibs.th.gbl.gbl-hndllib:g#lib-trn2
     5820   (input bf_trn-doc.doc-code
     5821   ) no-error
     5822   .
     5823     if error-status:error then return error return-value.
     5824   end.
     5825   method public void createAttrInv(docCode as character, attrCode as character, attrValue as character):
     5826     define buffer inv-doc-attr for ub.inv-doc-attr.
     5827     create inv-doc-attr .
     5828     assign
     5829       inv-doc-attr.doc-code   = docCode
     5830       inv-doc-attr.attr-code  = attrCode
     5831       inv-doc-attr.attr-value = attrValue
     5832       .
     5833   end.
     5834   method public void createDocLine(pardoc-code as character,
     5835     pargds-code as integer, factQnty as decimal):
     5836     define variable varis-petrolium as logical no-undo.
     5837     define variable varis-pieces    as logical no-undo.
     5838     define buffer cr_doc-line   for ub.doc-line.
     5839     define buffer last_doc-line for ub.doc-line.
     5840     define buffer new_trn-doc   for ub.trn-doc .
     5841     define buffer new_goods     for ub.goods .
     5842     define variable varline-num  as integer no-undo.
     5843     define variable rec-inv-line as recid   no-undo.
     5844     define variable v-vat-pc     as decimal no-undo .
     5845     define variable v-slt-pc     as decimal no-undo .
     5846     define buffer bf_sysconf for ub.sysconf .
     5847     define buffer prt-obj for ub.prt-obj .
     5848     find first new_trn-doc no-lock where new_trn-doc.doc-code = pardoc-code no-error .
     5849     find first new_goods no-lock where new_goods.gds-code = pargds-code no-error .
     5850     find first bf_sysconf where bf_sysconf.host-code = new_trn-doc.host-code no-lock no-error .
     5851     find last last_doc-line where last_doc-line.doc-code = pardoc-code use-index line-num no-lock no-error.
     5852     if not available last_doc-line then
     5853     do:
     5854       assign
     5855         varline-num = 1.
     5856     end.
     5857     else
     5858     do:
     5859       assign
     5860         varline-num = last_doc-line.line-num + 1.
     5861     end.
     5862     find first cr_doc-line where cr_doc-line.doc-code  = pardoc-code  and
     5863       cr_doc-line.artic     = new_goods.artic     and
     5864       cr_doc-line.prod-type = new_goods.prod-type and
     5865       cr_doc-line.prod-code = new_goods.prod-code no-error.
     5866     if not available cr_doc-line then
     5867     do:
     5868       v-vat-pc = pftxvalg(new_goods.gds-code, 1, ?, new_trn-doc.host-code, new_trn-doc.obj-type, new_trn-doc.obj-code) .
     5869       v-slt-pc = st-sltpc(recid(new_goods), recid(new_trn-doc), if available(bf_sysconf) then bf_sysconf.cash-pay else 0) .
     5870       create cr_doc-line.
     5871       assign
     5872         cr_doc-line.doc-code     = pardoc-code
     5873         cr_doc-line.artic        = new_goods.artic
     5874         cr_doc-line.prod-type    = new_goods.prod-type
     5875         cr_doc-line.prod-code    = new_goods.prod-code
     5876         cr_doc-line.obj-type     = new_trn-doc.obj-type
     5877         cr_doc-line.obj-code     = new_trn-doc.obj-code
     5878         cr_doc-line.status_      = new_trn-doc.status_
     5879         cr_doc-line.ext-doc-type = new_trn-doc.ext-doc-type
     5880         cr_doc-line.prt-root     = new_goods.prt-root
     5881         cr_doc-line.vat-pc       = v-vat-pc
     5882         cr_doc-line.slt-pc       = v-slt-pc
     5883         cr_doc-line.cons-vat-pc  = bf_sysconf.cons-vat-pc
     5884         cr_doc-line.line-num     = varline-num
     5885         .
     5886       if ( cr_doc-line.cli-base-rate = 0 or cr_doc-line.cli-base-rate = ? )
     5887         then
     5888         cr_doc-line.cli-base-rate = 1 .
     5889     end.
     5890     find first prt-obj no-lock where prt-obj.artic = cr_doc-line.artic and
     5891       prt-obj.prod-code = cr_doc-line.prod-code and
     5892       prt-obj.prod-type = cr_doc-line.prod-type and
     5893       prt-obj.obj-code = cr_doc-line.obj-code and
     5894       prt-obj.obj-type = cr_doc-line.obj-type no-error .
     5895     if available (prt-obj) then cr_doc-line.fact-qnty = factQnty - prt-obj.fact-qnty .
     5896     cr_doc-line.doc-qnty = factQnty .
     5897   end.
     5898   method public void createDocLineError(pardoc-code as character,
     5899     parartic as character, parprod-code as integer, parprod-type as character, factQnty as decimal):
     5900     define variable varis-petrolium as logical no-undo.
     5901     define variable varis-pieces    as logical no-undo.
     5902     define buffer cr_doc-line   for ub.doc-line.
     5903     define buffer last_doc-line for ub.doc-line.
     5904     define buffer new_trn-doc   for ub.trn-doc .
     5905     define buffer new_goods     for ub.goods .
     5906     define variable varline-num  as integer no-undo.
     5907     define variable rec-inv-line as recid   no-undo.
     5908     define variable v-vat-pc     as decimal no-undo .
     5909     define variable v-slt-pc     as decimal no-undo .
     5910     define buffer bf_sysconf for ub.sysconf .
     5911     find first new_trn-doc no-lock where new_trn-doc.doc-code = pardoc-code no-error .
     5912     find first bf_sysconf where bf_sysconf.host-code = new_trn-doc.host-code no-lock.
     5913     find last last_doc-line where last_doc-line.doc-code = pardoc-code use-index line-num no-lock no-error.
     5914     if not available last_doc-line then
     5915     do:
     5916       assign
     5917         varline-num = 1.
     5918     end.
     5919     else
     5920     do:
     5921       assign
     5922         varline-num = last_doc-line.line-num + 1.
     5923     end.
     5924       create cr_doc-line.
     5925       assign
     5926         cr_doc-line.doc-code     = pardoc-code
     5927         cr_doc-line.artic        = parartic
     5928         cr_doc-line.prod-type    = parprod-type
     5929         cr_doc-line.prod-code    = parprod-code
     5930         cr_doc-line.obj-type     = new_trn-doc.obj-type
     5931         cr_doc-line.obj-code     = new_trn-doc.obj-code
     5932         cr_doc-line.status_      = new_trn-doc.status_
     5933         cr_doc-line.ext-doc-type = new_trn-doc.ext-doc-type
     5934         cr_doc-line.line-num     = varline-num
     5935         .
     5936     cr_doc-line.doc-qnty = factQnty .
     5937     cr_doc-line.fact-qnty = factQnty .
     5938   end.
     5939     method public logical ImpUTDDOC (table TempTrnDoc, table TempDocLine, table TempMarkLine):
     5940       def var v-utd-db-num as integer no-undo.
     5941       def var v-utd-doc-id as integer no-undo.
     5942       def var v-ext-doc-code as character no-undo.
     5943       define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5944       define buffer utd-marking-lines for ub.utd-marking-lines.
     5945       define buffer utd-lines for ub.utd-lines.
     5946       define buffer marking for ub.marking.
     5947       for each TempTrnDoc :
     5948         v-ext-doc-code = replace (entry (2, TempTrnDoc.ext-doc-code, "("),")","").
     5949         assign
     5950           v-utd-db-num = integer (entry (1, v-ext-doc-code, "_"))
     5951           v-utd-doc-id = integer (entry (2, v-ext-doc-code, "_"))
     5952         no-error.
     5953         if error-status:error
     5954           then next.
     5955         tml_:
     5956         for each TempMarkLine where TempMarkLine.Sts = "Check" or TempMarkLine.Sts = "CheckScan" or TempMarkLine.Sts = "CrTsd" or TempMarkLine.Sts = "Ungrouped" :
     5957           find first utd-marking-lines where utd-marking-lines.db-num = v-utd-db-num and utd-marking-lines.doc-id = v-utd-doc-id
     5958             and utd-marking-lines.mark = TempMarkLine.MarkCode
     5959             exclusive-lock no-error.
     5960           if available (utd-marking-lines)
     5961           then do:
     5962             utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5963             find first marking where marking.mark = TempMarkLine.MarkCode no-lock no-error.
     5964             if available  marking and TempMarkLine.Sts = "CheckScan"
     5965               then ungrg(marking.mark-parent).
     5966           end.
     5967           else do:
     5968             def var v-GTIN as char no-undo.
     5969             def var v-mark-ident as char no-undo.
     5970             v-GTIN = getGtinByDM(TempMarkLine.MarkCode) .
     5971             v-mark-ident = GetCodeIdent(TempMarkLine.MarkCode).
     5972             if v-GTIN <> "" then
     5973             do:
     5974               find first buf_utd-marking-lines where
     5975                     buf_utd-marking-lines.db-num = v-utd-db-num and buf_utd-marking-lines.doc-id = v-utd-doc-id
     5976                 and buf_utd-marking-lines.mark begins TempMarkLine.MarkParent exclusive-lock no-error.
     5977               if not available (buf_utd-marking-lines)
     5978               then do:
     5979                 logWrite:WriteFileToLog(substitute ("Нарушена целостности либо изменен документ &1 на стороне TH", v-utd-doc-id)).
     5980                 undo, return false.
     5981               end.
     5982               buf_utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     5983               ungrg(buf_utd-marking-lines.mark).
     5984               create utd-marking-lines .
     5985               assign
     5986                 utd-marking-lines.db-num    = buf_utd-marking-lines.db-num
     5987                 utd-marking-lines.doc-id    = buf_utd-marking-lines.doc-id
     5988                 utd-marking-lines.gds-code  = buf_utd-marking-lines.gds-code
     5989                 utd-marking-lines.LineNum   = buf_utd-marking-lines.LineNum
     5990                 utd-marking-lines.doc-level = buf_utd-marking-lines.doc-level + 1
     5991                 utd-marking-lines.mark      = v-mark-ident
     5992                .
     5993               if ismark(v-mark-ident)
     5994               then do:
     5995                  find first marking where marking.mark = v-mark-ident exclusive-lock no-error.
     5996                  if not available (marking)
     5997                    then create marking .
     5998                  assign
     5999                    marking.gds-code    = utd-marking-lines.gds-code
     6000                    marking.mark        = v-mark-ident
     6001                    marking.mark-parent = buf_utd-marking-lines.mark
     6002                    marking.sts         = ObjSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB
     6003                    marking.gds-ext-id  = v-GTIN
     6004                    marking.obj-code    = TempTrnDoc.obj-code
     6005                    marking.obj-type    = TempTrnDoc.obj-type
     6006                    .
     6007                  marking.unit-ext = getLevelMotpByDM(v-mark-ident) .
     6008                  marking.box-qnty = getQntyUTDByDM(v-mark-ident) .
     6009                  marking.unit = getLevelUTDByDM(v-mark-ident) .
     6010               end.
     6011               utd-marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     6012               if available marking
     6013               THEN
     6014                  utd-marking-lines.mark = marking.mark.
     6015            end.
     6016           end.
     6017         end.
     6018         for each TempDocLine:
     6019            find first utd-lines no-lock where utd-lines.doc-id = v-utd-doc-id
     6020                                              and utd-lines.db-num = v-utd-db-num
     6021                                              and utd-lines.LineNum eq TempDocLine.line-num no-error.
     6022            if available ( utd-lines)
     6023            then
     6024               SetAttrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.linenum,"QuantityBarCode",string(TempDocLine.fact-qnty)).
     6025         end.
     6026         for each TempMarkLine where TempMarkLine.Sts = "Ungrouped" :
     6027           find first utd-marking-lines where utd-marking-lines.mark = TempMarkLine.MarkCode no-error.
     6028           if available (utd-marking-lines)
     6029           then do:
     6030             find first marking where marking.mark = TempMarkLine.MarkCode no-error.
     6031             marking.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB.
     6032           end.
     6033         end.
     6034       end.
     6035     end.
     6036     method private void ungrg (mark-parent as char):
     6037       define buffer buf_m for ub.marking.
     6038       for each buf_m where buf_m.mark = mark-parent exclusive-lock :
     6039         buf_m.sts = ObjSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB.
     6040         ungrg(buf_m.mark-parent).
     6041       end.
     6042     end.
     6043     method public logical ImpUTDIntroduce (table TempTrnDoc, table TempDocLine, table TempMarkLine):
     6044       def var chAddIntoduce as class introduce no-undo.
     6045       def var v-utd-db-num as integer no-undo.
     6046       def var v-utd-doc-id as integer no-undo.
     6047       def var v-ext-doc-code as character no-undo.
     6048       define buffer utd-marking-lines for ub.utd-marking-lines.
     6049       define buffer utd for ub.utd.
     6050       define buffer marking for marking.
     6051       chAddIntoduce = new introduce ().
     6052       for each TempTrnDoc :
     6053         if TempTrnDoc.ext-doc-type = "InvIntroduce"
     6054         then do:
     6055           find first utd where utd.doc-code = TempTrnDoc.ext-doc-code no-lock no-error.
     6056           if not available (utd)
     6057             then next.
     6058           v-utd-db-num = utd.db-num.
     6059           v-utd-doc-id = utd.doc-id.
     6060         end.
     6061         else do:
     6062           v-ext-doc-code = replace (entry (2, TempTrnDoc.ext-doc-code, "("),")","").
     6063           assign
     6064             v-utd-db-num = integer (entry (1, v-ext-doc-code, "_"))
     6065             v-utd-doc-id = integer (entry (2, v-ext-doc-code, "_"))
     6066           no-error.
     6067         end.
     6068         if error-status:error
     6069           then next.
     6070         for each TempMarkLine where TempMarkLine.Sts = "CrTsd" :
     6071           find first utd-marking-lines no-lock where utd-marking-lines.mark = TempMarkLine.MarkCode and utd-marking-lines.doc-id = v-utd-doc-id and utd-marking-lines.db-num = v-utd-db-num no-error.
     6072           if available ( utd-marking-lines)
     6073             then next.
     6074           find first marking where marking.mark = utd-marking-lines.mark exclusive-lock no-error.
     6075           if available (marking)
     6076           then do:
     6077             marking.sts = ObjSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB.
     6078           end.
     6079           chAddIntoduce:AddMarkUTD(TempMarkLine.MarkCode, v-utd-doc-id, v-utd-db-num, "CrTsd") no-error.
     6080           if error-status:error
     6081           then do:
     6082             dispmessage (return-value, false).
     6083             delete object chAddIntoduce no-error.
     6084             return false.
     6085           end.
     6086         end.
     6087       end.
     6088       delete object chAddIntoduce no-error.
     6089     end.
     6090     method public logical ImpInvMarksDOC (table TempTrnDoc, table TempDocLine, table TempMarkLine):
     6091       def buffer buf_marking for ub.marking.
     6092       def buffer buf_marking-lines for ub.marking-lines.
     6093       def buffer bf_doc-line for ub.doc-line.
     6094       define buffer marking-attr for ub.marking-attr.
     6095       define buffer goods for ub.goods.
     6096       def var v-inv-doc as character no-undo.
     6097       for each TempTrnDoc :
     6098         assign
     6099           v-inv-doc = TempTrnDoc.ext-doc-code
     6100         no-error.
     6101         if error-status:error
     6102           then next.
     6103         for each TempMarkLine where TempMarkLine.Sts = "CheckScan" :
     6104           find first marking-attr no-lock where (    marking-attr.attr-code = "inv-doc"
     6105                                                  and marking-attr.mark = TempMarkLine.MarkCode)
     6106                                               or (marking-attr.attr-code = "inv-doc-scan"
     6107                                                  and marking-attr.mark = TempMarkLine.MarkCode)
     6108             no-error.
     6109           if available (marking-attr) and not marking-attr.attr-value = v-inv-doc
     6110           then do:
     6111             dispmessage ("Марка находится в инвентаризации - " + marking-attr.attr-value, false).
     6112             return false.
     6113           end.
     6114           else do:
     6115             if available (marking-attr)
     6116               then next.
     6117          end.
     6118           find first buf_marking where (buf_marking.mark = TempMarkLine.MarkCode) no-lock no-error.
     6119           if not available (buf_marking)
     6120           then do:
     6121             dispmessage ("Марка не найдена в системе.", false).
     6122             return false.
     6123           end.
     6124           find first buf_marking-lines where (buf_marking-lines.mark = TempMarkLine.MarkCode)
     6125             and buf_marking-lines.out-code = 'free-zone':U no-error.
     6126           find first goods no-lock where goods.gds-code = buf_marking-lines.gds-code no-error.
     6127           find first bf_doc-line where bf_doc-line.doc-code = v-inv-doc
     6128             and bf_doc-line.artic = goods.artic
     6129             and bf_doc-line.prod-type = goods.prod-type
     6130             and bf_doc-line.prod-code = goods.prod-code no-lock no-error.
     6131           if not available (bf_doc-line)
     6132           then do:
     6133             dispmessage (substitute ("В накладной к линии с товаром &1 &2 к марке &3.", string (goods.gds-code), goods.gds-name, buf_marking-lines.mark), false).
     6134             return false.
     6135           end.
     6136           if available (buf_marking) and available (buf_marking-lines)
     6137           then do:
     6138             create marking-attr.
     6139             marking-attr.mark = TempMarkLine.MarkCode.
     6140             marking-attr.attr-code = "inv-doc-scan".
     6141             marking-attr.attr-value = v-inv-doc.
     6142             ObjSrv:Lib:MarkingTree:UnGroupMark(buf_marking.mark).
     6143             if ObjSrv:Lib:MarkingTree:LevelDown(buf_marking.mark  )
     6144             then do:
     6145               ObjSrv:Lib:MarkingTree:LockInvChildeMark(buf_marking.mark, v-inv-doc).
     6146             end.
     6147           end.
     6148         end.
     6149       end.
     6150       return true.
     6151     end.
     6152     method public void WriteUnknown ():
     6153       SomeStr = getStatusXml(false, "Неизвестный запрос.").
     6154     end.
     6155     method public integer GetDbNum ():
     6156       return dbNum.
     6157     end method.
     6158     method private integer GetDbNumLocal ():
     6159       define buffer buf_sys-ctrl for ub.sys-ctrl .
     6160       do
     6161       on error undo, return error return-value
     6162       :
     6163         for first buf_sys-ctrl field (db-num) no-lock :
     6164          return buf_sys-ctrl.db-num.
     6165         end.
     6166       end.
     6167     end method.
     6168     method public character gds-attr-mark-type (
     6169     p-gds-code as integer
     6170     ):
     6171     define buffer goods-attr for goods-attr.
     6172     do
     6173     on error undo, return error
     6174     :
     6175       find first goods-attr where goods-attr.gds-code = p-gds-code and goods-attr.attr-code = 'mark-type':U no-lock no-error.
     6176       if available goods-attr
     6177         then return goods-attr.attr-value.
     6178       return "".
     6179     end.
     6180     end method.
     6181     destructor public TSD ( ):
     6182       delete object keyrec no-error.
     6183     end destructor.
     6184     method public void dispmessage (p-str as char, p-sts as logical):
     6185       LogWrite:LogStr = p-str.
     6186       SomeStr = getStatusXml(p-sts, p-str).
     6187     end.
     6188     method public void getUTDDoc (iProtocol as char):
     6189       define buffer buf_utd         for ub.utd.
     6190       define buffer buf_utd-err     for ub.utd-err.
     6191       define buffer buf_utd-m-l     for ub.utd-marking-lines.
     6192       define buffer buf_utd-m-l-par for ub.utd-marking-lines.
     6193       define buffer buf_m-l         for ub.marking-lines.
     6194       define buffer buf_m-chi       for ub.marking.
     6195       define buffer buf_m-par       for ub.marking.
     6196       define buffer buf_utd-l       for ub.utd-lines.
     6197       define buffer buf_m           for ub.marking.
     6198       define buffer buf_goods     for ub.goods.
     6199       define buffer buf_bar-code  for ub.bar-code.
     6200       define buffer buf_trn-doc   for ub.trn-doc.
     6201       define buffer buf_doc-line  for ub.doc-line.
     6202       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     6203       define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6204       define buffer marking-attr for ub.marking-attr.
     6205       define buffer marking for ub.marking.
     6206       define buffer utd-marking-lines for ub.utd-marking-lines.
     6207       define buffer utd for ub.utd.
     6208       define variable dFactSum   as decimal   no-undo.
     6209       define variable priceSale  as dec no-undo.
     6210       define variable docType    as character no-undo.
     6211       define variable decDocQnty as decimal no-undo.
     6212       define variable jj as integer no-undo.
     6213       define variable jjm as integer no-undo.
     6214       define variable iim as integer no-undo.
     6215       define variable myflagsDoc     as class flagsdoc     no-undo.
     6216       define variable myflagsDocLine as class flagsdocline no-undo.
     6217       define variable pos as integer no-undo.
     6218       def    var      internal-b-code like ub.bar-code.b-code no-undo .
     6219       def    var      full-b-code     as character init "" no-undo .
     6220       def    var      v-doc-num       as character no-undo .
     6221       def var v-sts as character no-undo.
     6222       def var vRecKey-line as character no-undo.
     6223       myflagsDoc = new flagsdoc ().
     6224       myflagsDocLine = new flagsdocline ().
     6225       l_utd:
     6226       for each buf_utd where buf_utd.obj-type = ObjType and buf_utd.obj-code = ObjCode and buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:AwaitingDelivery:KeyIntDB
     6227         and buf_utd.EDocType = ObjSrv:Env:Utd:EDocType:UTD:KeyIntDB:
     6228         v-doc-num = buf_utd.DocumentNumber + "(" + string(buf_utd.db-num) + "_" + string(buf_utd.doc-id) + ")".
     6229         logWrite:WriteDebugLog( "Выгружаем документ УПД " + v-doc-num).
     6230         myflagsDoc:unSetAllFlags().
     6231         myflagsDoc:isDocMarkOn = false.
     6232         for each buf_utd-l where buf_utd-l.db-num = buf_utd.db-num and buf_utd-l.doc-id = buf_utd.doc-id no-lock:
     6233            if WeighedProd(buf_utd-l.gds-code)
     6234            then do:
     6235               logWrite:WriteDebugLog( substitute ("Документ &1 содержит весовой товар &2. Документ пропущен.", v-doc-num, buf_utd-l.gds-code)).
     6236               next l_utd.
     6237            end.
     6238         end.
     6239         block-u-l:
     6240         for each buf_utd-l where buf_utd-l.db-num = buf_utd.db-num and buf_utd-l.doc-id = buf_utd.doc-id no-lock:
     6241            block-mark:
     6242            for each buf_utd-m-l where buf_utd-m-l.db-num = buf_utd-l.db-num
     6243                                and buf_utd-m-l.doc-id    = buf_utd-l.doc-id
     6244                                and buf_utd-m-l.LineNum   = buf_utd-l.LineNum
     6245            no-lock:
     6246               if    ismark(buf_utd-m-l.mark)
     6247                  or isOAD (buf_utd-m-l.mark)
     6248               then do:
     6249                  ObjSrv:Lib:KeyRec:GenKeyRec ( input "utd-lines",
     6250                     input  buffer buf_utd-l:handle,
     6251                     output vRecKey-line).
     6252                  find first buf_utd-err no-lock where buf_utd-err.doc-id = buf_utd-l.doc-id and buf_utd-err.db-num = buf_utd-l.db-num and buf_utd-err.reckey = vRecKey-line no-error .
     6253                  if not available buf_utd-err
     6254                  then do:
     6255                     myflagsDoc:isDocMarkOn = true.
     6256                     leave block-u-l.
     6257                  end.
     6258                  else
     6259                     leave block-mark.
     6260               end.
     6261            end.
     6262         end.
     6263         if buf_utd.cli-code = ? or buf_utd.obj-code = ? or buf_utd.cli-type = ? or buf_utd.obj-type = ?
     6264         then do:
     6265           logWrite:WriteFileToLog( substitute ( "Не указан контрагент/объект TH в документе УТД &1.", v-doc-num)).
     6266           next l_utd.
     6267         end.
     6268         pos = 0.
     6269         for each buf_utd-l where buf_utd-l.db-num = buf_utd.db-num and buf_utd-l.doc-id = buf_utd.doc-id no-lock:
     6270           myflagsDocLine:unSetAllFlags().
     6271           myflagsDocLine:isMarkOn            = logical(GetAttrUtdlinesEx (buf_utd-l.db-num,buf_utd-l.doc-id,buf_utd-l.lineNum,"MarkUtdLine","no")).
     6272           myflagsDocLine:isVarietalVolumeOn  = logical(GetAttrUtdlinesEx (buf_utd-l.db-num,buf_utd-l.doc-id,buf_utd-l.lineNum,"ArticUtdLine","no")).
     6273           myflagsDocLine:isNotEditManualQnty = not (myflagsDocLine:isMarkOn).
     6274           find first buf_goods no-lock where buf_goods.gds-code = buf_utd-l.gds-code no-error.
     6275           if not available (buf_goods)
     6276           then do:
     6277             logWrite:WriteFileToLog( substitute ( "Не указан товар TH в документе УТД &1.", v-doc-num)).
     6278             next l_utd.
     6279           end.
     6280           find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code.
     6281          internal-b-code = buf_bar-code.b-code.
     6282   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6283     define variable tmp-str11  as character no-undo.
     6284     define variable tmp-num11  as character no-undo.
     6285     define variable i11        as integer   no-undo.
     6286     define variable sum11      as integer   no-undo.
     6287     define variable len-code11 as integer   no-undo.
     6288     define variable varcont11  as logical   initial yes no-undo.
     6289     CASE bc-frmt :
     6290       WHEN "EAN13" THEN do:
     6291         assign
     6292           tmp-str11 = string( internal-b-code, "999999999999" )
     6293         .
     6294       end.
     6295       WHEN "EAN8" THEN do:
     6296         assign
     6297           tmp-str11 = string( internal-b-code, "9999999" )
     6298         .
     6299       end.
     6300       OTHERWISE DO:
     6301           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     6302           view-as alert-box error.
     6303           return error.
     6304       END.
     6305     END CASE.
     6306     if varcont11 = yes then do:
     6307       if integer( substring( tmp-str11, 1, length( bc-pfx ) ) ) <> 0
     6308       then do:
     6309         message
     6310           "Невозможно сформировать бар-код" SKIP
     6311           "для товара с кодом: " internal-b-code
     6312           view-as alert-box error title "подрезание кода".
     6313         return error.
     6314       end.
     6315       else do:
     6316         assign
     6317           full-b-code = bc-pfx + substring( tmp-str11, length( bc-pfx ) + 1, length( tmp-str11 ) - length( bc-pfx ) )
     6318           len-code11    = length( full-b-code )
     6319         .
     6320         define variable v-sum-char11 as character no-undo .
     6321         assign
     6322           sum11 = 0
     6323         .
     6324         do i11 = 1 to len-code11 by 2
     6325         :
     6326           assign
     6327             v-sum-char11 = substr(full-b-code, len-code11 - i11 + 1, 1)
     6328           .
     6329           if v-sum-char11 < "0"
     6330           or v-sum-char11 > "9"
     6331           then do:
     6332             message
     6333               "Невозможно сформировать бар-код" skip
     6334               "для товара с кодом: " internal-b-code skip
     6335               view-as alert-box error title "подсчет контрольной суммы".
     6336             return error.
     6337           end.
     6338           assign
     6339             sum11 = sum11 + integer(v-sum-char11)
     6340           .
     6341         end.
     6342         if varcont11 = yes then do:
     6343           assign
     6344             sum11 = sum11 * 3
     6345           .
     6346           do i11 = 2 to len-code11 by 2
     6347           :
     6348             assign
     6349               v-sum-char11 = substr(full-b-code, len-code11 - i11 + 1, 1)
     6350             .
     6351             if v-sum-char11 < "0"
     6352             or v-sum-char11 > "9"
     6353             then do:
     6354               message
     6355                 "Невозможно сформировать бар-код" skip
     6356                 "для товара с кодом: " internal-b-code skip
     6357                 view-as alert-box error title "подсчет контрольной суммы".
     6358               return error.
     6359             end.
     6360             assign
     6361               sum11 = sum11 + integer(v-sum-char11)
     6362             .
     6363           end.
     6364           if varcont11 = yes then do:
     6365              if sum11 mod 10 = 0 then do:
     6366                assign
     6367                  full-b-code = full-b-code + '0'
     6368                .
     6369              end.
     6370              else do:
     6371                assign
     6372                  full-b-code = full-b-code + string(10 - sum11 mod 10)
     6373                .
     6374              end.
     6375           end.
     6376         end.
     6377       end.
     6378     end.
     6379           pos = pos + 1.
     6380           PriceSale = buf_utd-l.Total / buf_utd-l.Quantity.
     6381           decDocQnty = buf_utd-l.Quantity.
     6382           define variable vErrorLine as logical no-undo.
     6383           ObjSrv:Lib:KeyRec:GenKeyRec ( input "utd-lines",
     6384               input  buffer buf_utd-l:handle,
     6385               output vRecKey-line).
