       22     def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23   method public char getattrUtdEx
       24   (idb-num   as integer,
       25    idoc-id   as integer,
       26    iattrcode as character,
       27    iExValue  as character  ):
       28      define buffer utd-attr for utd-attr.
       29      find first utd-attr where utd-attr.db-num eq idb-num
       30                            and utd-attr.doc-id eq idoc-id
       31                            and utd-attr.attr-code eq iattrcode
       32      no-lock no-error.
       33      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
       34   end.
       35   method public char getattrUtd
       36   (idb-num   as integer,
       37    idoc-id   as integer,
       38    iattrcode as character ):
       39     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
       40   end.
       41   method public void setattrUtd
       42   (idb-num   as integer,
       43    idoc-id   as integer,
       44    iattrcode as character,
       45    iattrval  as character ):
       46      define buffer utd-attr for utd-attr.
       47      find first utd-attr where utd-attr.db-num eq idb-num
       48                            and utd-attr.doc-id eq idoc-id
       49                            and utd-attr.attr-code eq iattrcode
       50      no-lock no-error.
       51      if not available utd-attr
       52      then do:
       53         create utd-attr.
       54         assign
       55            utd-attr.db-num    = idb-num
       56            utd-attr.doc-id    = idoc-id
       57            utd-attr.attr-code = iattrcode
       58            utd-attr.attr-value = iattrval
       59         .
       60      end.
       61      else do:
       62         if utd-attr.attr-value ne iattrval
       63         then do:
       64            find current utd-attr exclusive-lock no-error.
       65            if available utd-attr
       66            then
       67               utd-attr.attr-value = iattrval.
       68         end.
       69      end.
       70      release utd-attr.
       71   end.
       72   method public char GetAttrUtdlinesEx
       73   (idb-num   as integer,
       74    idoc-id   as integer,
       75    ilinenum  as integer,
       76    iattrcode as character,
       77    iExValue  as character  ):
       78      define buffer utd-lines-attr for utd-lines-attr.
       79      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
       80                                  and utd-lines-attr.doc-id    eq idoc-id
       81                                  and utd-lines-attr.lineNum   eq ilineNum
       82                                  and utd-lines-attr.attr-code eq iattrcode
       83      no-lock no-error.
       84      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
       85   end.
       86   method public char GetAttrUtdlines
       87   (idb-num   as integer,
       88    idoc-id   as integer,
       89    ilinenum  as integer,
       90    iattrcode as character ):
       91      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
       92   end.
       93   method public void setattrUtdlines
       94   (idb-num   as integer,
       95    idoc-id   as integer,
       96    ilinenum  as integer,
       97    iattrcode as character,
       98    iattrval  as character ):
       99      define buffer utd-lines-attr for utd-lines-attr.
      100      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      101                                  and utd-lines-attr.doc-id    eq idoc-id
      102                                  and utd-lines-attr.lineNum   eq ilineNum
      103                                  and utd-lines-attr.attr-code eq iattrcode
      104      no-lock no-error.
      105      if not available utd-lines-attr
      106      then do:
      107         if iattrval ne ?
      108            and iattrval ne ""
      109         then do:
      110            create utd-lines-attr.
      111            assign
      112               utd-lines-attr.db-num    = idb-num
      113               utd-lines-attr.doc-id    = idoc-id
      114               utd-lines-attr.lineNum   = ilineNum
      115               utd-lines-attr.attr-code = iattrcode
      116               utd-lines-attr.attr-value = iattrval
      117            .
      118         end.
      119      end.
      120      else do:
      121         if utd-lines-attr.attr-value ne iattrval
      122         then do:
      123            find current utd-lines-attr exclusive-lock no-error.
      124            if available utd-lines-attr
      125            then do:
      126               if    iattrval eq ?
      127                  or iattrval eq ""
      128               then do:
      129                  delete utd-lines-attr.
      130               end.
      131               else do:
      132                  utd-lines-attr.attr-value = iattrval.
      133               end.
      134            end.
      135         end.
      136      end.
      137      release utd-lines-attr.
      138   end.
