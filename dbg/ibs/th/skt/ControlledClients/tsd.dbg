       11   class ibs.th.skt.ControlledClients.TSD inherits objth:
       12        define override public property vss-revision    as character no-undo init "$Revision:$":U get .
       13        define override public property vss-author      as character no-undo init "$Author:$":U get.
       14        define override public property vss-date        as character no-undo init "$Date:$":U get.
       15        define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       16        define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       17        define override public property vss-description as character no-undo init "клас для подготовки даныных для ТСД и загрузки из него" get.
       18   method private void getAttrLib ():
       19      define variable g#attr-lib  as handle no-undo .
       20      run gbl/getgattrlib.p (output g#attr-lib).
