     2600     method public handle CreateDsGoodsAndBarcodes ():
     2601        define variable hDset as handle no-undo.
     2602        buffer TempBCode:handle:BUFFER-FIELD("gds-code"):serialize-hidden = yes .
     2603        create dataset hDset.
     2604        hDset:set-buffers(buffer tt-goods:handle,
     2605                          buffer tt-barcodes:handle,
     2606                          buffer TempBCode:handle).
     2607        hDset:serialize-name = "Goods".
     2608        hDset:add-relation(buffer tt-goods:handle,
     2609                           buffer tt-barcodes:handle,
     2610                           "gds-code,gds-code",
     2611                           false,
     2612                           true).
     2613        hDset:add-relation(buffer tt-barcodes:handle,
     2614                           buffer TempBCode:handle,
     2615                           "gds-code,gds-code",
     2616                           false,
     2617                           true).
     2618        return hDset.
     2619     end.
     2620   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile: doc-code.i $ $Revision: f7f4e950f623, 0, rls $".
     2621   method public character docCode (parmode as character, parobj-type as character, parobj-code as integer, parroot-doc-code as character):
     2622   define variable pardoc-code as character no-undo .
     2623   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2624   define variable vardb-remote     as   logical             no-undo.
     2625   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2626   define variable v-delimiter as character no-undo .
     2627   find first buf_sys-ctrl no-lock .
     2628   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2629     CASE parmode:
     2630       when "main":u then do:
     2631         if vardb-remote then do:
     2632           assign
     2633             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, 1, 1).
     2634         end.
     2635         else do:
     2636           assign
     2637             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2638         end.
     2639       end.
     2640       when "trio" then do:
     2641         assign
     2642           pardoc-code = replace (parroot-doc-code, "=", "*").
     2643       end.
     2644       otherwise do:
     2645         assign
     2646         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2647         no-error
     2648         .
     2649         if error-status:error  then do:
     2650           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2651                                         ,chr(10)
     2652                                         ,parmode
     2653                                         ).
     2654         end.
     2655         if num-entries(parmode) = 1
     2656         and parmode <> "chip":U
     2657         and parmode <> "chip_s":U
     2658         then do:
     2659           assign
     2660           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2661         end.
     2662         else if (lookup("chip":U, parmode) > 0
     2663                  or
     2664                  lookup("chip_s":U, parmode) > 0) then do:
     2665           assign
     2666             vartemp-doc-code = parroot-doc-code.
     2667           do while true:
     2668             if index (vartemp-doc-code , ".") = 0 then
     2669               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2670             else
     2671               vartemp-doc-code  =
     2672               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2673               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2674               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2675             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2676           end.
     2677           assign
     2678             pardoc-code = vartemp-doc-code.
     2679         end.
     2680       end.
     2681     end CASE.
     2682     if pardoc-code = '':U
     2683     or (parroot-doc-code <> '':U
     2684     and pardoc-code = parroot-doc-code) then do:
     2685       undo, return error substitute("Ошибка при генерации номера документа&1"
     2686                                     ,chr(10)).
     2687     end.
     2688     else return pardoc-code .
     2689   end method.
     2690   method public integer baseCode (p-host-code  as integer) :
     2691     define variable p-ok        as logical no-undo.
     2692     define variable p-base-code as integer no-undo .
     2693     do
     2694       on error undo, return error return-value
     2695       :
     2696       define buffer buf_sysconf for ub.sysconf .
     2697       for first buf_sysconf field (base-code) no-lock
     2698         where buf_sysconf.host-code = p-host-code :
     2699       assign
     2700         p-base-code = buf_sysconf.base-code
     2701         p-ok        = yes
     2702         .
     2703     end.
     2704     if not p-ok
     2705       then
     2706     do:
     2707       message
     2708         vss-workfile vss-revision vss-description skip
     2709         "Не найдена фирма" skip
     2710         "host-code" p-host-code skip
     2711         view-as alert-box error .
     2712       undo, return error return-value .
     2713     end.
     2714     else return p-base-code .
     2715   end.
     2716   end method.
     2717   method public character hostName (p-obj-type as character, p-obj-code as integer):
     2718     do
     2719       on error undo, return error return-value
     2720       :
     2721       define variable p-host-code               like ub.price-doc.host-code no-undo .
     2722       define variable p-host-name               like ub.clients.obj-name no-undo .
     2723       define variable l-last-hostname-exist     as logical no-undo initial false .
     2724       define variable v-last-hostname-obj-type  like ub.price-doc.obj-type no-undo .
     2725       define variable v-last-hostname-obj-code  like ub.price-doc.obj-code no-undo .
     2726       define variable v-last-hostname-host-name like ub.clients.obj-name no-undo .
     2727       define variable l-last-hostcode-exist     as logical no-undo initial false .
     2728       define variable v-last-hostcode-obj-type  like ub.price-doc.obj-type no-undo .
     2729       define variable v-last-hostcode-obj-code  like ub.price-doc.obj-code no-undo .
     2730       define variable v-last-hostcode-host-code like ub.price-doc.host-code no-undo .
     2731       if  l-last-hostname-exist = true
     2732         and p-obj-type            = v-last-hostname-obj-type
     2733         and p-obj-code            = v-last-hostname-obj-code
     2734         then
     2735       do:
     2736         assign
     2737           p-host-code = v-last-hostcode-host-code
     2738           p-host-name = v-last-hostname-host-name
     2739           .
     2740         return p-host-name.
     2741       end.
     2742       if  l-last-hostname-exist = true
     2743         and p-obj-type = 'орг':U
     2744         and v-last-hostcode-host-code = p-obj-code then
     2745       do:
     2746         assign
     2747           p-host-code = v-last-hostcode-host-code
     2748           p-host-name = v-last-hostname-host-name
     2749           .
     2750         return p-host-name.
     2751       end.
     2752       define buffer buf_store   for ub.store .
     2753       define buffer buf_shop    for ub.shop .
     2754       define buffer buf_clients for ub.clients.
     2755       define buffer buf_sysconf for ub.sysconf .
     2756       case p-obj-type :
     2757         when 'скл':U
     2758         then
     2759           do:
     2760             find first buf_store no-lock
     2761               where buf_store.obj-code = p-obj-code
     2762               no-error .
     2763             if not available buf_store
     2764               then
     2765             do:
     2766               message
     2767                 vss-workfile vss-revision vss-description skip
     2768                 "Не найден склад" skip
     2769                 "p-obj-type" p-obj-type skip
     2770                 "p-obj-code" p-obj-code skip
     2771                 view-as alert-box error .
     2772               undo, return error return-value .
     2773             end.
     2774             assign
     2775               p-host-code = buf_store.host-code
     2776               .
     2777           end.
     2778         when 'маг':U
     2779         then
     2780           do:
     2781             find first buf_shop no-lock
     2782               where buf_shop.obj-code = p-obj-code
     2783               no-error .
     2784             if not available buf_shop
     2785               then
     2786             do:
     2787               message
     2788                 vss-workfile vss-revision vss-description skip
     2789                 "Не найден магазин" skip
     2790                 "p-obj-type" p-obj-type skip
     2791                 "p-obj-code" p-obj-code skip
     2792                 view-as alert-box error .
     2793               undo, return error return-value .
     2794             end.
     2795             assign
     2796               p-host-code = buf_shop.host-code
     2797               .
     2798           end.
     2799         when 'орг':U
     2800         then
     2801           do:
     2802             find first buf_sysconf no-lock
     2803               where buf_sysconf.host-code = p-host-code
     2804               no-error.
     2805             if not available buf_sysconf
     2806               then
     2807             do:
     2808               message
     2809                 vss-workfile vss-revision vss-description skip
     2810                 "Не найдена СВОЯ фирма" skip
     2811                 "p-obj-type" p-obj-type skip
     2812                 "p-obj-code" p-obj-code skip
     2813                 view-as alert-box error .
     2814               undo, return error return-value .
     2815             end.
     2816             assign
     2817               p-host-code = buf_sysconf.host-code
     2818               .
     2819           end.
     2820         otherwise
     2821         do:
     2822           message
     2823             vss-workfile vss-revision vss-description skip
     2824             "Неизвестный тип объекта" skip
     2825             "p-obj-type" p-obj-type skip
     2826             "p-obj-code" p-obj-code skip
     2827             view-as alert-box error .
     2828           undo, return error return-value .
     2829         end.
     2830       end.
     2831       if p-obj-type <> 'орг':U then
     2832       do:
     2833         assign
     2834           l-last-hostcode-exist     = true
     2835           v-last-hostcode-obj-type  = p-obj-type
     2836           v-last-hostcode-obj-code  = p-obj-code
     2837           v-last-hostcode-host-code = p-host-code
     2838           .
     2839       end.
     2840       find first buf_clients no-lock
     2841         where buf_clients.obj-type = 'орг':U
     2842         and buf_clients.obj-code = p-host-code
     2843         no-error.
     2844       if not available buf_clients
     2845         then
     2846       do:
     2847         message
     2848           vss-workfile vss-revision vss-description skip
     2849           "Не найдена фирма" skip
     2850           "p-host-code" p-host-code skip
     2851           view-as alert-box error .
     2852         undo, return error return-value .
     2853       end.
     2854       assign
     2855         p-host-name = buf_clients.obj-name
     2856         .
     2857       if p-obj-type <> 'орг':U then
     2858       do:
     2859         assign
     2860           l-last-hostname-exist     = true
     2861           v-last-hostname-obj-type  = p-obj-type
     2862           v-last-hostname-obj-code  = p-obj-code
     2863           v-last-hostname-host-name = p-host-name
     2864           .
     2865       end.
     2866     end.
     2867     return p-host-name .
     2868   end method.
     2869   method public integer objdnpay (p-obj-type as character, p-obj-code as integer):
     2870     define variable p-down-pay like ub.store.down-pay no-undo .
     2871     define buffer buf_store for ub.store .
     2872     define buffer buf_shop  for ub.shop  .
     2873     if p-obj-type = 'скл':U
     2874       then
     2875     do:
     2876       for buf_store field (down-pay) no-lock
     2877           where buf_store.obj-code = p-obj-code
     2878         .
     2879         assign
     2880           p-down-pay = buf_store.down-pay
     2881           .
     2882       end.
     2883     end.
     2884     else
     2885     do:
     2886       for buf_shop field (down-pay) no-lock
     2887           where buf_shop.obj-code = p-obj-code
     2888         .
     2889         assign
     2890           p-down-pay = buf_shop.down-pay
     2891           .
     2892       end.
     2893     end.
     2894     return p-down-pay .
     2895   end method.
     2896   method public character  setCurrentUser():
     2897     define variable vSystemUser as ibs.th.file.asyncparam no-undo.
     2898     define variable vSystemPass as ibs.th.file.asyncparam no-undo.
     2899     define variable mAsyncProc  as class                  ibs.th.file.asyncproc no-undo.
     2900     define variable myUser      as character              initial ? no-undo .
     2901     mAsyncProc = new ibs.th.file.asyncproc().
     2902     vSystemUser = mAsyncProc:getParamObj("SystemUser").
     2903     vSystemPass = mAsyncProc:getParamObj("SystemPass").
     2904     run utl/syspwd.p(input vSystemUser, input vSystemPass)no-error.
     2905     myUser = vSystemUser:valueParam.
     2906     delete object mAsyncProc.
     2907     return myUser .
     2908   end.
     2909   method public integer gen-b-code(type-code as character):
     2910     define variable p-b-code like ub.bar-code.b-code no-undo .
     2911     define buffer buf_config     for ub.config .
     2912     define buffer buf_sys-ctrl   for ub.sys-ctrl .
     2913     define buffer buf_code-range for ub.code-range .
     2914     define variable l-code         as integer no-undo .
     2915     define variable v-db-num       like ub.db.db-num no-undo .
     2916     define variable cfg-param-code like ub.config.param-code no-undo .
     2917     if type-code = 'sslc':U
     2918       or type-code = 'ssgb':U
     2919       then
     2920     do:
     2921       message
     2922         "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     2923         "Обратитесь к администратору системы."
     2924         view-as alert-box error .
     2925       undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     2926     end.
     2927     run trg/getpcode.p ( input  type-code
     2928       ,output cfg-param-code
     2929       ).
     2930     l-code = get-next-seq( type-code ).
     2931     find first buf_sys-ctrl no-lock.
     2932     if type-code = 'sclc':U
     2933       or type-code = 'pglc':U
     2934       then
     2935     do:
     2936       assign
     2937         v-db-num = 0
     2938         .
     2939     end.
     2940     else
     2941     do:
     2942       assign
     2943         v-db-num = buf_sys-ctrl.db-num
     2944         .
     2945     end.
     2946     find first buf_code-range no-lock
     2947       where buf_code-range.db-num     = v-db-num
     2948       and buf_code-range.range-type = type-code
     2949       and buf_code-range.stts       = "a"
     2950       use-index stts
     2951       no-error .
     2952     if available buf_code-range
     2953       and l-code <= buf_code-range.last-code
     2954       and l-code >= buf_code-range.first-code then
     2955     do:
     2956       assign
     2957         p-b-code = l-code
     2958         .
     2959     end.
     2960     else
     2961     do:
     2962       if available buf_code-range
     2963         and l-code < buf_code-range.last-code then
     2964       do:
     2965         message
     2966           substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     2967           "Обратитесь к администратору системы."
     2968           view-as alert-box error .
     2969         undo, return error "sequence":U .
     2970       end.
     2971       do transaction
     2972         on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2973         on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     2974         on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     2975         :
     2976         find first buf_config exclusive-lock
     2977           where buf_config.param-code = cfg-param-code
     2978           and buf_config.host-code  = 0
     2979           and buf_config.obj-type   = ""
     2980           and buf_config.obj-code   = 0
     2981           and buf_config.beg-date   = 01/01/1900
     2982           and buf_config.end-date   = 01/01/9999
     2983           and buf_config.db-num     = buf_sys-ctrl.db-num
     2984           no-error .
     2985         if not available buf_config then
     2986         do:
     2987           if not locked buf_config then
     2988           do:
     2989             message
     2990               substitute( "Отсутствует конфигурационный параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     2991               "Он должен быть без привязки и с неограниченным сроком действия лицензии."
     2992               "Обратитесь к администратору системы."
     2993               view-as alert-box error .
     2994           end.
     2995           undo, return error "config":U .
     2996         end.
     2997         l-code = get-next-seq( type-code ).
     2998         find first buf_code-range
     2999           where buf_code-range.db-num     = v-db-num
     3000           and buf_code-range.range-type = type-code
     3001           and buf_code-range.stts       = "a"
     3002           use-index stts
     3003           no-error .
     3004         if available buf_code-range
     3005           and l-code <= buf_code-range.last-code
     3006           and l-code >= buf_code-range.first-code
     3007           then
     3008         do:
     3009           assign
     3010             p-b-code = l-code
     3011             .
     3012         end.
     3013         else
     3014         do:
     3015           if available buf_code-range then
     3016           do:
     3017             assign
     3018               buf_code-range.stts = "u"
     3019               .
     3020           end.
     3021           find first buf_code-range
     3022             where buf_code-range.db-num     = v-db-num
     3023             and buf_code-range.range-type = type-code
     3024             and buf_code-range.stts       = "f"
     3025             use-index stts
     3026             no-error .
     3027           if not available buf_code-range then
     3028           do:
     3029             message
     3030               substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     3031               "Обратитесь к администратору системы"
     3032               view-as alert-box error .
     3033             undo, return error "code-range":U .
     3034           end.
     3035           assign
     3036             buf_code-range.stts = "a"
     3037             .
     3038           if buf_code-range.first-code = 1 then
     3039           do:
     3040             set-seq-cr( type-code, buf_code-range.first-code ).
     3041             assign
     3042               p-b-code = 1
     3043               .
     3044           end.
     3045           else
     3046           do:
     3047             set-seq-cr( type-code, ( buf_code-range.first-code - 1 )).
     3048             p-b-code = get-next-seq( type-code ).
     3049           end.
     3050         end.
     3051       end.
     3052     end.
     3053   end method.
     3054   method public integer get-next-seq (type-code as character):
     3055     define variable next-seq as integer no-undo .
     3056       case type-code:
     3057         when 'bcgb':U then do:
     3058           assign
     3059             next-seq = next-value(s-bcgb-code, ub)
     3060           .
     3061         end.
     3062         when 'scgb':U then do:
     3063           assign
     3064             next-seq = next-value(s-scgb-code, ub)
     3065           .
     3066         end.
     3067         when 'sclc':U then do:
     3068           assign
     3069             next-seq = next-value(s-sclc-code, ub)
     3070           .
     3071         end.
     3072         when 'pglc':U then do:
     3073           assign
     3074             next-seq = next-value(s-pglc-code, ub)
     3075           .
     3076         end.
     3077         when 'dcgb':U then do:
     3078           assign
     3079             next-seq = next-value(s-dcgb-code, ub)
     3080           .
     3081         end.
     3082         when 'ctgb':U then do:
     3083           assign
     3084             next-seq = next-value(s-ctgb-code, ub)
     3085           .
     3086         end.
     3087         when 'drgb':U then do:
     3088           assign
     3089             next-seq = next-value(s-drgb-code, ub)
     3090           .
     3091         end.
     3092         when 'fmgb':U then do:
     3093           assign
     3094             next-seq = next-value(s-fmgb-code, ub)
     3095           .
     3096         end.
     3097         when 'pngb':U then do:
     3098           assign
     3099             next-seq = next-value(s-pngb-code, ub)
     3100           .
     3101         end.
     3102         when 'cagb':U then do:
     3103           assign
     3104             next-seq = next-value(s-cagb-code, ub)
     3105           .
     3106         end.
     3107         when 'fdgb':U then do:
     3108           assign
     3109             next-seq = next-value(s-fin-doc, ub)
     3110           .
     3111         end.
     3112       end case.
     3113     return next-seq .
     3114   end method.
     3115   method public void set-seq-cr (type-code as character, set-val as integer) :
     3116       case type-code:
     3117         when 'bcgb':U then do:
     3118           assign
     3119             current-value(s-bcgb-code, ub) = set-val
     3120           .
     3121         end.
     3122         when 'scgb':U then do:
     3123           assign
     3124             current-value(s-scgb-code, ub) = set-val
     3125           .
     3126         end.
     3127         when 'sclc':U then do:
     3128           assign
     3129             current-value(s-sclc-code, ub) = set-val
     3130           .
     3131         end.
     3132         when 'pglc':U then do:
     3133           assign
     3134             current-value(s-pglc-code, ub) = set-val
     3135           .
     3136         end.
     3137         when 'dcgb':U then do:
     3138           assign
     3139             current-value(s-dcgb-code, ub) = set-val
     3140           .
     3141         end.
     3142         when 'ctgb':U then do:
     3143           assign
     3144             current-value(s-ctgb-code, ub) = set-val
     3145           .
     3146         end.
     3147         when 'drgb':U then do:
     3148           assign
     3149             current-value(s-drgb-code, ub) = set-val
     3150           .
     3151         end.
     3152         when 'fmgb':U then do:
     3153           assign
     3154             current-value(s-fmgb-code, ub) = set-val
     3155           .
     3156         end.
     3157         when 'pngb':U then do:
     3158           assign
     3159             current-value(s-pngb-code, ub) = set-val
     3160           .
     3161         end.
     3162         when 'cagb':U then do:
     3163           assign
     3164             current-value(s-cagb-code, ub) = set-val
     3165           .
     3166         end.
     3167         when 'fdgb':U then do:
     3168           assign
     3169             current-value(s-fin-doc, ub) = set-val
     3170           .
     3171         end.
     3172       end case.
     3173   end method.
     3174   method public decimal pftxvalg (pargds-code as integer,
     3175     partax-code as integer, par-date as date, parhost-code as integer,
     3176     parobj-type as character, parobj-code as integer):
     3177     define variable partax-value    as decimal   no-undo .
     3178     DEFINE VARIABLE v-fact-order    as decimal   no-undo .
     3179     define buffer buf_tax-rate-gds for ub.tax-rate-gds.
     3180     define buffer buf_goods        for ub.goods.
     3181       assign
     3182         partax-value = ?
     3183         .
     3184       if not can-find (first buf_goods no-lock
     3185         where buf_goods.gds-code = pargds-code)
     3186         then
     3187       do:
     3188         message
     3189           vss-workfile vss-revision vss-description skip
     3190           "Ошибка задания входных параметров" skip
     3191           "Не найден товар" skip
     3192           "Код товара" pargds-code skip
     3193           view-as alert-box error .
     3194         undo, return error return-value .
     3195       end.
     3196       if par-date = ?
     3197         then
     3198       do:
     3199         assign
     3200           par-date = today
     3201           .
     3202       end.
     3203        v-fact-order = factord-end-day (par-date).
     3204       find last buf_tax-rate-gds no-lock
     3205         where buf_tax-rate-gds.gds-code   = pargds-code
     3206         and buf_tax-rate-gds.tax-code   = partax-code
     3207         and buf_tax-rate-gds.host-code  = 0
     3208         and buf_tax-rate-gds.obj-type   = ""
     3209         and buf_tax-rate-gds.obj-code   = 0
     3210         and buf_tax-rate-gds.fact-order <= v-fact-order
     3211         no-error .
     3212       IF AVAIL buf_tax-rate-gds
     3213         then
     3214       do:
     3215         partax-value = pftxvalo(?, buf_tax-rate-gds.tax-code, buf_tax-rate-gds.rate-code,
     3216           v-fact-order, parhost-code, parobj-type, parobj-code) .
     3217         return partax-value.
     3218       end.
     3219     end method.
     3220   method public decimal pftxvalo (par-rc as recid, partax-code as integer, parrate-code  as integer,
     3221     parfact-order as decimal, parhost-code as integer, parobj-type as character, parobj-code   as integer):
     3222     define variable partax-value    as decimal   no-undo .
     3223     define buffer buf_tax-rate       for ub.tax-rate.
     3224     define buffer buf_tax-rate-value for ub.tax-rate-value.
     3225       assign
     3226         partax-value = ?
     3227         .
     3228       if partax-code  = 0
     3229         or parrate-code = 0
     3230         then
     3231       do:
     3232         if par-rc = ?
     3233           then
     3234         do:
     3235           undo, return error "Неверный параметр - recid tax-rate" .
     3236         end.
     3237         find first buf_tax-rate no-lock
     3238           where recid(buf_tax-rate) = par-rc
     3239           no-error .
     3240         if not available buf_tax-rate
     3241           then
     3242         do:
     3243           undo, return error "Не найдена ставка налога " + "recid " + string(par-rc) .
     3244         end.
     3245         if buf_tax-rate.status_ = 'удал':U
     3246           then
     3247         do:
     3248           undo, return error "Ставка налога недействительна "
     3249             + "налог: " + string(buf_tax-rate.tax-code) + " ставка: " + string(buf_tax-rate.rate-code) .
     3250         end.
     3251         assign
     3252           partax-code  = buf_tax-rate.tax-code
     3253           parrate-code = buf_tax-rate.rate-code
     3254           .
     3255       end.
     3256       find last buf_tax-rate-value no-lock
     3257         where buf_tax-rate-value.tax-code   = partax-code
     3258         and buf_tax-rate-value.rate-code  = parrate-code
     3259         and buf_tax-rate-value.host-code  = parhost-code
     3260         and buf_tax-rate-value.obj-type   = parobj-type
     3261         and buf_tax-rate-value.obj-code   = parobj-code
     3262         and buf_tax-rate-value.fact-order <= parfact-order
     3263         and buf_tax-rate-value.status_    = 'тек':U
     3264         no-error .
     3265       if available buf_tax-rate-value
     3266         then
     3267       do:
     3268         assign
     3269           partax-value = buf_tax-rate-value.rate-value
     3270           .
     3271         return partax-value.
     3272       end.
     3273       find last buf_tax-rate-value no-lock
     3274         where buf_tax-rate-value.tax-code   = partax-code
     3275         and buf_tax-rate-value.rate-code  = parrate-code
     3276         and buf_tax-rate-value.host-code  = parhost-code
     3277         and buf_tax-rate-value.obj-type   = ""
     3278         and buf_tax-rate-value.obj-code   = 0
     3279         and buf_tax-rate-value.fact-order <= parfact-order
     3280         and buf_tax-rate-value.status_    = 'тек':U
     3281         no-error .
     3282       if available buf_tax-rate-value
     3283         then
     3284       do:
     3285         assign
     3286           partax-value = buf_tax-rate-value.rate-value
     3287           .
     3288         return partax-value.
     3289       end.
     3290       find last buf_tax-rate-value no-lock
     3291         where buf_tax-rate-value.tax-code   = partax-code
     3292         and buf_tax-rate-value.rate-code  = parrate-code
     3293         and buf_tax-rate-value.host-code  = 0
     3294         and buf_tax-rate-value.obj-type   = ""
     3295         and buf_tax-rate-value.obj-code   = 0
     3296         and buf_tax-rate-value.fact-order <= parfact-order
     3297         and buf_tax-rate-value.status_    = 'тек':U
     3298         no-error .
     3299       if available buf_tax-rate-value
     3300         then
     3301       do:
     3302         assign
     3303           partax-value = buf_tax-rate-value.rate-value
     3304           .
     3305         return partax-value.
     3306       end.
     3307   end method.
     3308   method public decimal st-sltpc (p-goods-recid    as recid, p-trn-doc-recid  as recid, p-cash-pay as integer):
     3309     define variable p-st-sltpc-slt like ub.doc-line.SLT-pc no-undo.
     3310     def    var      v-host-code    like ub.sysconf.host-code no-undo.
     3311     define variable varslt-yes     as logical no-undo.
     3312     def buffer buf_st-sltpc_goods   for ub.goods.
     3313     def buffer buf_st-sltpc_trn-doc for ub.trn-doc.
     3314     find first buf_st-sltpc_goods   where recid(buf_st-sltpc_goods)     = p-goods-recid.
     3315     find first buf_st-sltpc_trn-doc where recid(buf_st-sltpc_trn-doc)   = p-trn-doc-recid.
     3316   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_chpsltpc in ibs.th.gbl.gbl-hndllib:g#lib-trn
     3317   (
     3318    input  buf_st-sltpc_trn-doc.internal
     3319   ,input  buf_st-sltpc_trn-doc.doc-type
     3320   ,input  buf_st-sltpc_trn-doc.pay-code
     3321   ,input  p-cash-pay
     3322   ,input  buf_st-sltpc_trn-doc.slt-type
     3323   ,input  buf_st-sltpc_trn-doc.ext-doc-type
     3324   ,output varslt-yes
     3325   )
     3326   no-error.
     3327     if error-status :error then
     3328     do:
     3329       message
     3330         vss-workfile vss-revision vss-description skip
     3331         "Ошибка при проверке установки налога с продаж " skip
     3332         " для товара " buf_st-sltpc_goods.artic buf_st-sltpc_goods.prod-type buf_st-sltpc_goods.prod-code skip
     3333         " в документе " buf_st-sltpc_trn-doc.doc-code skip
     3334         return-value skip
     3335         trim(error-status :get-message(1))
     3336         trim(error-status :get-message(2))
     3337         trim(error-status :get-message(3))
     3338         trim(error-status :get-message(4))
     3339         trim(error-status :get-message(5)) skip
     3340         view-as alert-box error.
     3341       undo, return error .
     3342     end.
     3343     if varslt-yes
     3344       then
     3345     do:
     3346       v-host-code = hostcode(buf_st-sltpc_trn-doc.obj-type, buf_st-sltpc_trn-doc.obj-code) .
     3347       p-st-sltpc-slt = pftxvalg(buf_st-sltpc_goods.gds-code, 2, ?, v-host-code,
     3348         buf_st-sltpc_trn-doc.obj-type, buf_st-sltpc_trn-doc.obj-code) .
     3349     end.
     3350     else
     3351     do:
     3352       assign
     3353         p-st-sltpc-slt = 0
     3354         .
     3355     end.
     3356   end method.
     3357   method public integer hostcode (p-obj-type  as character, p-obj-code  as integer):
     3358     define variable p-host-code     as integer   no-undo .
     3359     define variable p-ok            as logical   no-undo .
     3360       define variable l-last-hostcode-exist     as logical no-undo initial false .
     3361       define variable v-last-hostcode-obj-type  like ub.price-doc.obj-type no-undo .
     3362       define variable v-last-hostcode-obj-code  like ub.price-doc.obj-code no-undo .
     3363       define variable v-last-hostcode-host-code like ub.price-doc.host-code no-undo .
     3364     if  l-last-hostcode-exist = true
     3365       and p-obj-type            = v-last-hostcode-obj-type
     3366       and p-obj-code            = v-last-hostcode-obj-code
     3367       then
     3368     do:
     3369       assign
     3370         p-host-code = v-last-hostcode-host-code
     3371         .
     3372       return p-host-code.
     3373     end.
     3374     define buffer buf_store for ub.store .
     3375     define buffer buf_shop  for ub.shop .
     3376     case p-obj-type :
     3377       when 'скл':U
     3378       then
     3379         do:
     3380           for first buf_store field (host-code) no-lock
     3381           where buf_store.obj-code = p-obj-code :
     3382           assign
     3383             p-host-code = buf_store.host-code
     3384             p-ok        = yes
     3385             .
     3386         end.
     3387       if not p-ok
     3388         then
     3389       do:
     3390         message
     3391           vss-workfile vss-revision vss-description skip
     3392           "Не найден склад" skip
     3393           "p-obj-type" p-obj-type skip
     3394           "p-obj-code" p-obj-code skip
     3395           view-as alert-box error .
     3396         undo, return error return-value .
     3397       end.
     3398     end.
     3399       when 'маг':U
     3400       then do:
     3401   for first buf_shop field (host-code) no-lock
     3402           where buf_shop.obj-code = p-obj-code :
     3403   assign
     3404     p-host-code = buf_shop.host-code
     3405     p-ok        = yes
     3406     .
     3407   end.
     3408   if not p-ok
     3409     then
     3410   do:
     3411     message
     3412       vss-workfile vss-revision vss-description skip
     3413       "Не найден магазин" skip
     3414       "p-obj-type" p-obj-type skip
     3415       "p-obj-code" p-obj-code skip
     3416       view-as alert-box error .
     3417     undo, return error return-value .
     3418   end.
     3419   end.
     3420       otherwise do:
     3421   message
     3422     vss-workfile vss-revision vss-description skip
     3423     "Неизвестный тип объекта" skip
     3424     "p-obj-type" p-obj-type skip
     3425     "p-obj-code" p-obj-code skip
     3426     view-as alert-box error .
     3427   undo, return error return-value .
     3428   end.
     3429   end.
     3430   assign
     3431     l-last-hostcode-exist     = true
     3432     v-last-hostcode-obj-type  = p-obj-type
     3433     v-last-hostcode-obj-code  = p-obj-code
     3434     v-last-hostcode-host-code = p-host-code
     3435     .
     3436   end method.
     3437   method public decimal factord-end-day(p-fact-date            as date) :
     3438     define variable  p-day-end-fact-order   as decimal no-undo .
     3439       if p-fact-date = ?
     3440       then do:
     3441         return error "Не указана фактическая дата" .
     3442       end.
     3443       assign
     3444         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3445       .
     3446   end method.
     3447   method public character objExists
     3448   (input  ifolder as character,
     3449    input  iType   as character  ):
     3450       define variable vFileType as character no-undo init "D,F".
     3451       define variable vi        as integer no-undo.
     3452       define variable vtype as character no-undo.
     3453       if iType ne ?
     3454       then
     3455          vFileType = iType.
     3456       do vi = 1 to num-entries(vFileType):
     3457          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     3458          vtype = file-information:file-type.
     3459          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     3460             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     3461             index(vtype , entry(vi,vFileType )) > 0
     3462          then return file-information:full-pathname .
     3463          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     3464          vtype = file-information:file-type.
     3465          if file-information:file-name <> "" and
     3466             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     3467             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     3468             index( vtype, entry(vi,vFileType )) > 0
     3469          then return file-information:full-pathname .
     3470       end.
     3471       return ? .
     3472   end.
     3473   method public character SearchFile
     3474   (input  ifile as character):
     3475      return objExists(ifile,?).
     3476   end.
     3477   method public character SearchPFile
     3478   (input inFile as char):
     3479        define variable oFile       as character no-undo.
     3480        define variable vFileSearch as character no-undo.
     3481        define variable vNumEntry   as integer no-undo.
     3482        if inFile = "" then return ?.
     3483        vNumEntry = num-entries(inFile,".").
     3484        vFileSearch = inFile.
     3485        if    vNumEntry > 0
     3486           and (   entry(vNumEntry,inFile,".") eq "p"
     3487                or entry(vNumEntry,inFile,".") eq "w")
     3488        then do:
     3489           entry(vNumEntry,vFileSearch, ".") = "r".
     3490           oFile = search(vFileSearch ).
     3491           if oFile eq ?
     3492           then
     3493              oFile = search(inFile).
     3494        end.
     3495        else
     3496           oFile = search(vFileSearch).
     3497        return oFile.
     3498     end.
     3499   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
