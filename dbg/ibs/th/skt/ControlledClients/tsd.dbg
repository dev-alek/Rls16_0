     4535              buf_trn-doc.obj-type,
     4536              buf_trn-doc.user-name,
     4537              if available (buf_user-login) then buf_user-login.user-login else "",
     4538              dFactSum,
     4539              datetime-tz (buf_trn-doc.doc-date, buf_trn-doc.real-time-create * 1000),
     4540              myflagsDoc:FlagsToInt
     4541         ).
     4542           logWrite:WriteDebugLog( "Выгружен документ " + buf_trn-doc.doc-code).
     4543       end.
     4544     end method.
     4545     method public void Check_ ():
     4546       define variable confPar   as character no-undo.
     4547       define variable parType   as character no-undo.
     4548       define variable statusOK  as logical   no-undo init false.
     4549       define buffer buf_clients   for ub.clients.
     4550       run gbl/conf-rd.p ("tsd-list", "", "", 0, "", "", "", no, output confPar, output parType) no-error.
     4551       if lookup (SN, confPar, ";") > 0
     4552         then statusOK = true.
     4553       find first buf_clients no-lock
     4554         where buf_clients.obj-type = ObjType and buf_clients.obj-code = ObjCode no-error.
     4555       if available (buf_clients)
     4556         then statusOK = true.
     4557             else statusOK = false.
     4558       if true // Зачем неписать сообщение об ошибке если в ответ всеравно отправляется ошибка
     4559       then do:
     4560          importVersion().
     4561          SomeStr = getStatusXml(statusOK, "",getVersion()).
     4562       end.
     4563       else SomeStr = if lookup (SN, confPar) = 0 then getStatusXml(statusOK, "LIC") else getStatusXml(statusOK, "OBJ").
     4564     end method.
     4565     method public character createTegLogical (iTeg as char,
     4566                                        iValue as logical):
     4567         if ivalue eq ? then return createTeg(iteg,?).
     4568         return createTeg(iteg,trim(string(ivalue,"true/false"))).
     4569     end.
     4570     method public character createTeg (iTeg as char,
     4571                                        iValue as char):
     4572         if ivalue eq "" or ivalue eq ? then return "".
     4573         return substitute ("<&1>&2</&1>",iteg,ivalue).
     4574     end.
     4575     method public void getSettings ():
     4576       define variable confPar   as character no-undo.
     4577       define variable parType   as character no-undo.
     4578       define variable validSN   as logical   no-undo init ?.
     4579       define variable validObj  as logical   no-undo init ?.
     4580       define buffer buf_clients   for ub.clients.
     4581       run gbl/conf-rd.p ("tsd-list", "", "", 0, "", "", "", no, output confPar, output parType) no-error.
     4582       if SN ne ? and SN ne ""
     4583       then
     4584          validSN = lookup (SN, confPar, ";") > 0.
     4585       ObjectsClear().
     4586       getCurrentObjects().
     4587       ObjectsPrint("xml").
     4588       SomeStr = substring (SomeStr,index(SomeStr,">") + 1).
     4589       if ObjType ne ? and ObjType ne ""
     4590       then do:
     4591         find first buf_clients no-lock
     4592            where buf_clients.obj-type = ObjType and buf_clients.obj-code = ObjCode no-error.
     4593         validObj = available (buf_clients).
     4594       end.
     4595       importVersion().
     4596       SomeStr = getStatusXml(true, "",
     4597       substitute ("&1&2&3&4",
     4598       getVersion(),
     4599       SomeStr,
     4600       createTegLogical("validSN",validSN),
     4601       createTegLogical("validObj",validObj))).
     4602     end method.
     4603     method public void setResult (iFile as char):
     4604         copy-lob
     4605             from  file search(iFile)
     4606             to object SomeStr
     4607             no-convert
     4608          no-error .
     4609     end.
     4610     method public void writeResult (iFile as char):
     4611         writeResult(iFile,?).
     4612     end.
     4613     method public void writeResult (iFile as char, iencode as char):
     4614         if(iencode eq ?)
     4615         then do:
     4616            copy-lob
     4617               from object SomeStr
     4618               to file iFile
     4619               no-convert
     4620            .
     4621          end.
     4622          else do:
     4623             copy-lob
     4624               from object SomeStr
     4625               to  file iFile
     4626               convert  TARGET CODEPAGE iencode
     4627             .
     4628          end.
     4629     end.
     4630     method public void WriteUsers (idir as char):
     4631        GetUsers ().
