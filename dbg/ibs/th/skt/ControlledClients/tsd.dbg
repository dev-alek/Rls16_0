     6511     define variable len-code12 as integer   no-undo.
     6512     define variable varcont12  as logical   initial yes no-undo.
     6513     CASE bc-frmt :
     6514       WHEN "EAN13" THEN do:
     6515         assign
     6516           tmp-str12 = string( internal-b-code, "999999999999" )
     6517         .
     6518       end.
     6519       WHEN "EAN8" THEN do:
     6520         assign
     6521           tmp-str12 = string( internal-b-code, "9999999" )
     6522         .
     6523       end.
     6524       OTHERWISE DO:
     6525           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     6526           view-as alert-box error.
     6527           return error.
     6528       END.
     6529     END CASE.
     6530     if varcont12 = yes then do:
     6531       if integer( substring( tmp-str12, 1, length( bc-pfx ) ) ) <> 0
     6532       then do:
     6533         message
     6534           "Невозможно сформировать бар-код" SKIP
     6535           "для товара с кодом: " internal-b-code
     6536           view-as alert-box error title "подрезание кода".
     6537         return error.
     6538       end.
     6539       else do:
     6540         assign
     6541           full-b-code = bc-pfx + substring( tmp-str12, length( bc-pfx ) + 1, length( tmp-str12 ) - length( bc-pfx ) )
     6542           len-code12    = length( full-b-code )
     6543         .
     6544         define variable v-sum-char12 as character no-undo .
     6545         assign
     6546           sum12 = 0
     6547         .
     6548         do i12 = 1 to len-code12 by 2
     6549         :
     6550           assign
     6551             v-sum-char12 = substr(full-b-code, len-code12 - i12 + 1, 1)
     6552           .
     6553           if v-sum-char12 < "0"
     6554           or v-sum-char12 > "9"
     6555           then do:
     6556             message
     6557               "Невозможно сформировать бар-код" skip
     6558               "для товара с кодом: " internal-b-code skip
     6559               view-as alert-box error title "подсчет контрольной суммы".
     6560             return error.
     6561           end.
     6562           assign
     6563             sum12 = sum12 + integer(v-sum-char12)
     6564           .
     6565         end.
     6566         if varcont12 = yes then do:
     6567           assign
     6568             sum12 = sum12 * 3
     6569           .
     6570           do i12 = 2 to len-code12 by 2
     6571           :
     6572             assign
     6573               v-sum-char12 = substr(full-b-code, len-code12 - i12 + 1, 1)
     6574             .
     6575             if v-sum-char12 < "0"
     6576             or v-sum-char12 > "9"
     6577             then do:
     6578               message
     6579                 "Невозможно сформировать бар-код" skip
     6580                 "для товара с кодом: " internal-b-code skip
     6581                 view-as alert-box error title "подсчет контрольной суммы".
     6582               return error.
     6583             end.
     6584             assign
     6585               sum12 = sum12 + integer(v-sum-char12)
     6586             .
     6587           end.
     6588           if varcont12 = yes then do:
     6589              if sum12 mod 10 = 0 then do:
     6590                assign
     6591                  full-b-code = full-b-code + '0'
     6592                .
     6593              end.
     6594              else do:
     6595                assign
     6596                  full-b-code = full-b-code + string(10 - sum12 mod 10)
     6597                .
     6598              end.
     6599           end.
     6600         end.
