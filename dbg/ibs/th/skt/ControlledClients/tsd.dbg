     4745         or buf_clients.obj-type = "чел" or buf_clients.obj-type = 'маг':U or buf_clients.obj-type = 'скл':U)
     4746         and not (buf_clients.obj-type = ObjType and buf_clients.obj-code = ObjCode) no-lock:
     4747         create tt-Clients.
     4748          assign
