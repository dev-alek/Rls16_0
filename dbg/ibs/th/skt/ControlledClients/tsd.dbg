      163   method public void setattrUtdMarkingLines
      164   (idb-num   as integer,
      165    idoc-id   as integer,
      166    ilinenum  as integer,
      167    imark     as character,
      168    iattrcode as character,
      169    iattrval  as character ):
      170      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      171      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      172                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      173                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      174                                          and utd-marking-lines-attr.mark      eq imark
      175                                          and utd-marking-lines-attr.attr-code eq iattrcode
      176      no-lock no-error.
      177      if not available utd-marking-lines-attr
      178      then do:
      179         if iattrval ne ?
      180            and iattrval ne ""
      181         then do:
      182            create utd-marking-lines-attr.
      183            assign
      184               utd-marking-lines-attr.db-num     = idb-num
      185               utd-marking-lines-attr.doc-id     = idoc-id
      186               utd-marking-lines-attr.lineNum    = ilineNum
      187               utd-marking-lines-attr.mark       = imark
      188               utd-marking-lines-attr.attr-code  = iattrcode
      189               utd-marking-lines-attr.attr-value = iattrval
      190            .
      191         end.
      192      end.
      193      else do:
      194         if utd-marking-lines-attr.attr-value ne iattrval
      195         then do:
      196            find current utd-marking-lines-attr exclusive-lock no-error.
      197            if available utd-marking-lines-attr
