     3832   method public char CrCheckMarkDoc
     3833      (v-cntxt-obj-type as char,
     3834      v-cntxt-obj-code as int,
     3835      idb-num as int,
     3836       idoc-id as int,
     3837      imark as char,
     3838       is-initial-set-p as logical
     3839      )
     3840         :
     3841     define buffer buf_marking-child for ub.marking .
     3842     define buffer buf_marking for ub.marking.
     3843     define buffer buf_marking-attr for  ub.marking-attr.
     3844     define buffer buf_marking-parent for ub.marking .
     3845     define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     3846     define buffer buf_utd-marking-lines-child for ub.utd-marking-lines .
     3847     define buffer buf_utd-lines for ub.utd-lines.
     3848     define buffer buf_goods for ub.goods.
     3849     define buffer buf_gds-obj for ub.gds-obj.
     3850     define variable v-par-type as character no-undo.
     3851     define variable v-par-val  as character no-undo.
     3852     define variable v-gds-code as integer no-undo .
     3853     define variable v-num-recipes as integer no-undo .
     3854     define variable v-GTIN as character no-undo .
     3855     define variable v-GTIN-qnty as decimal no-undo .
     3856     define variable v-GTIN-child as character no-undo .
     3857     define variable v-GTIN-qnty-child as decimal no-undo .
     3858     define variable v-free-qnty as decimal no-undo .
     3859     define variable v-old-sts as integer no-undo .
     3860     define variable v-mark-short as character no-undo.
     3861     define variable v-GisMTcheckStatus as integer no-undo .
     3862     define variable v-is-off-line as logical no-undo .
     3863     define variable v-mark-weight as decimal no-undo .
     3864     define variable v-isweighed as logical no-undo .
     3865     define variable v-ok        as logical no-undo .
     3866     if imark = ""
     3867       then return "".
     3868     v-mark-short = GetCodeIdent(imark).
     3869     if v-mark-short = "" or v-mark-short = ?
     3870     then do:
     3871       return "Неизвестный формат марки.".
     3872     end.
     3873     find first buf_marking where (buf_marking.mark begins v-mark-short) no-error.
     3874     if available buf_marking
     3875     then do :
     3876       if buf_marking.unit-ext = "LEVEL2" then
     3877         return "Неизвестный формат марки.".
     3878       v-GTIN = getGtinByDM(buf_marking.mark) .
     3879     end .
     3880     else do :
     3881       v-GTIN = getGtinByDM(imark) .
     3882     end .
     3883     v-gds-code = getGdsCodeByGtin(v-GTIN) .
     3884     v-GTIN-qnty = getQntyCodeByGtin(v-GTIN) .
     3885     if v-gds-code = ?
     3886     then do :
     3887       return substitute ("Не удалось найти товар по gtin &1",v-GTIN).
     3888     end .
     3889     find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     3890     if not available buf_goods
     3891     then do :
     3892       return substitute ( "Не найден товар по коду &1.",v-gds-code ).
     3893     end .
     3894       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     3895     ( buf_goods.gds-code,
     3896      'weighed-gds':U,
     3897      output v-par-val,
     3898      output v-par-type
     3899     ).
     3900     v-isweighed = logical(v-par-val) .
     3901     if v-GTIN-qnty = ?
     3902     or v-GTIN-qnty <= 0.0
     3903     then do :
     3904       return substitute ("Не установлен коэффициент для упаковки для марки &1.",imark).
     3905     end .
     3906       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
     3907     ( buf_goods.gds-code,
     3908      'mark-type':U,
     3909      output v-par-val,
     3910      output v-par-type
     3911     ).
     3912     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsArticForType(v-par-val)
     3913     or (not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsArticForType(v-par-val)
     3914       and not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     3915       and not ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsMarkingForType(v-par-val)
     3916         )
     3917     then do :
     3918       return substitute ("Сверка марок товара &1 '&2' не требуется", buf_goods.gds-code,buf_goods.gds-name).
     3919     end .
     3920     if v-isweighed
     3921     and v-par-val > ""
     3922     and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):GetIsEDOForType(v-par-val)
     3923     and not available buf_marking
     3924     then do :
     3925       return "Марка не найдена в БД" .
     3926     end .
     3927     define variable v-attr-value as character no-undo.
     3928     define variable v-attr-type as character no-undo.
     3929   v-attr-value = gdsoattr-value (input   'mark-collect-type':U,
     3930                                           input   buf_goods.gds-code,
     3931                                           input   v-cntxt-obj-type,
     3932                                           input   v-cntxt-obj-code,
     3933                                           output  v-attr-type
     3934                                           ) no-error.
     3935     find first buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = idb-num
     3936                                                and buf_utd-marking-lines.doc-id = idoc-id
     3937                                                and buf_utd-marking-lines.mark begins v-mark-short
     3938                                                no-error.
     3939     if available buf_utd-marking-lines
     3940     then do :
     3941        return substitute ("Марка &1 добавлена в документ ранее.",imark).
     3942     end .
     3943     find first buf_utd-lines exclusive-lock where buf_utd-lines.db-num    = idb-num
     3944                                               and buf_utd-lines.doc-id    = idoc-id
     3945                                               and buf_utd-lines.gds-code  = buf_goods.gds-code
     3946                                               no-error .
     3947     if not available buf_utd-lines
     3948     then do :
     3949       if is-initial-set-p
     3950       then do :
     3951         if v-attr-value = "1"
     3952         or v-attr-value = "2"
     3953         then do :
     3954               return substitute("Для товара &1 ранее был выполнен первоначальный сбор марок.", buf_goods.gds-name).
     3955         end .
     3956       end .
     3957       else do :
     3958         if v-attr-value = ""
     3959         or v-attr-value = "0"
     3960         then do :
     3961              return substitute("Для товара &1 не выполнен первоначальный сбор марок, товар не может быть добавлен в документ без признака «Первоначальный сбор марок». Создайте для товара отдельный документ", buf_goods.gds-name).
     3962         end .
     3963       end .
     3964       define buffer bf_utd-lines for ub.utd-lines.
     3965       find last bf_utd-lines no-lock where bf_utd-lines.db-num    = idb-num
     3966                                        and bf_utd-lines.doc-id    = idoc-id
     3967       no-error .
     3968       define variable vLineNum as integer no-undo.
     3969       vLineNum = if available bf_utd-lines then (bf_utd-lines.linenum + 1) else 1.
     3970       create buf_utd-lines .
     3971       assign
     3972         buf_utd-lines.db-num    = idb-num
     3973         buf_utd-lines.doc-id    = idoc-id
     3974         buf_utd-lines.gds-code  = buf_goods.gds-code
     3975         buf_utd-lines.UnitCode  = buf_goods.unit-base
     3976         buf_utd-lines.LineNum   = vLineNum
     3977       .
     3978       assign v-free-qnty = 0 .
     3979       find first buf_gds-obj no-lock where buf_gds-obj.obj-type  = v-cntxt-obj-type
     3980                                        and buf_gds-obj.obj-code  = v-cntxt-obj-code
     3981                                        and buf_gds-obj.artic     = buf_goods.artic
     3982                                        and buf_gds-obj.prod-type = buf_goods.prod-type
     3983                                        and buf_gds-obj.prod-code = buf_goods.prod-code
     3984                                        no-error .
     3985       if available buf_gds-obj
     3986       then do :
     3987         assign v-free-qnty = buf_gds-obj.free-qnty .
     3988       end .
     3989     end .
     3990     if v-isweighed
     3991     then do :
     3992       find first buf_marking-attr where buf_marking-attr.mark      eq buf_marking.mark
     3993                                     and buf_marking-attr.attr-code eq "weight"
     3994       no-lock no-error.
     3995       if avail buf_marking-attr
     3996       then
     3997         v-mark-weight = dec(buf_marking-attr.attr-value) .
     3998       .
     3999       assign
     4000         buf_utd-lines.Quantity = buf_utd-lines.Quantity + v-mark-weight
     4001       .
     4002     end .
     4003     else do :
     4004       assign
     4005         buf_utd-lines.Quantity = buf_utd-lines.Quantity + v-GTIN-qnty
     4006       .
     4007     end .
     4008     for each buf_marking-child no-lock where buf_marking-child.mark-parent begins v-mark-short,
     4009     first buf_utd-marking-lines-child no-lock where buf_utd-marking-lines-child.mark = buf_marking-child.mark
     4010                                                 and buf_utd-marking-lines-child.db-num  = buf_utd-lines.db-num
     4011                                                 and buf_utd-marking-lines-child.doc-id  = buf_utd-lines.doc-id
     4012                                                 and buf_utd-marking-lines-child.LineNum = buf_utd-lines.LineNum
     4013     :
     4014       assign
     4015         v-GTIN-child = getGtinByDM(buf_marking-child.mark)
     4016         v-GTIN-qnty-child = getQntyCodeByGtin(v-GTIN-child)
     4017         buf_utd-lines.Quantity = buf_utd-lines.Quantity - v-GTIN-qnty-child
     4018       .
     4019     end .
     4020     if available buf_marking
     4021     then do :
     4022       create buf_utd-marking-lines .
     4023       assign
     4024         buf_utd-marking-lines.mark      = buf_marking.mark
     4025         buf_utd-marking-lines.gds-code  = buf_goods.gds-code
     4026         buf_utd-marking-lines.sts       = buf_marking.sts
     4027         buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     4028         buf_utd-marking-lines.doc-id    = idoc-id
     4029         buf_utd-marking-lines.db-num    = idb-num
     4030         buf_utd-marking-lines.doc-level = 1
     4031       .
     4032     end .
     4033     else do :
     4034       create buf_marking .
     4035       assign
     4036         buf_marking.mark = v-mark-short
     4037         buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB
     4038         buf_marking.box-qnty = v-GTIN-qnty
     4039         buf_marking.obj-type = v-cntxt-obj-type
     4040         buf_marking.obj-code = v-cntxt-obj-code
     4041         buf_marking.gds-code = buf_goods.gds-code
     4042         buf_marking.gds-ext-id = v-GTIN
     4043         buf_marking.unit-ext = (if v-GTIN-qnty = 1 then "UNIT" else if v-GTIN-qnty > 1 then "LEVEL1" else "")
     4044       .
     4045       create buf_utd-marking-lines .
     4046       assign
     4047         buf_utd-marking-lines.mark      = buf_marking.mark
     4048         buf_utd-marking-lines.gds-code  = buf_goods.gds-code
     4049         buf_utd-marking-lines.sts       = 0
     4050         buf_utd-marking-lines.LineNum   = buf_utd-lines.LineNum
     4051         buf_utd-marking-lines.doc-id    = idoc-id
     4052         buf_utd-marking-lines.db-num    = idb-num
     4053         buf_utd-marking-lines.doc-level = 1
     4054       .
     4055     end .
     4056     validate buf_utd-marking-lines .
     4057     return "" .
     4058   end.
     4059     define stream str1 .
     4060     define stream str2 .
     4061     define stream logTSD .
     4062     define public property SomeStr as longchar no-undo
     4063       get.
     4064       set.
     4065     define public property ObjCode as integer no-undo
     4066       private get.
     4067       set.
     4068     define public property ObjType as character no-undo
     4069       private get.
     4070       set (arg as char):
     4071          ObjType = if arg eq "sho"
     4072                    then
     4073                       "маг"
     4074                    else
     4075                       arg.
     4076       end.
     4077     define public property SN as character no-undo
     4078       private get.
     4079       set.
     4080     define public property ReqType as character no-undo
     4081       get.
     4082       set.
     4083     define public property ResType as character no-undo
     4084       get.
     4085       set.
     4086     define public property CurrDecSeparator as character no-undo init ","
     4087         get.
     4088         set.
     4089     define public property CurrDecSeparatorTH as character no-undo
     4090         get:
     4091           return session:numeric-decimal-point.
     4092         end.
     4093     define public property IsMarkOn as logical no-undo init false
     4094         get.
     4095         set.
     4096     define public property CP as character no-undo init "UTF-8"
     4097       get.
     4098       set.
     4099     define private stream tsdstream.
     4100     define private variable logWrite     as class     LogWrite     no-undo.
     4101     define private variable keyrec       as class     keyrec       no-undo.
     4102     define private variable v-keyrec     as character no-undo.
     4103     define         variable v-today  as date      no-undo .
     4104     define variable bc-frmt         as character no-undo .
     4105     define variable bc-pfx          as character no-undo .
     4106     define variable dbNum as integer no-undo.
     4107     define variable myflagsDoc         as class flagsdoc         no-undo.
     4108     define variable myflagsBarcode     as class flagsbarcode     no-undo.
     4109     constructor public TSD (  ):
     4110       super().
     4111       dbNum = GetDbNumLocal().
     4112       myflagsDoc     = new flagsdoc ().
     4113       myflagsbarcode = new flagsbarcode ().
     4114       define variable v-par-type as character no-undo.
     4115       keyrec = new keyrec ().
     4116       logWrite = new LogWrite().
     4117       if not valid-handle (ibs.th.gbl.gbl-hndllib:g#trdcalib)
     4118       then do:
     4119         run str/trdcalib.p persistent no-error.
     4120       end.
     4121   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4122       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "", yes, output bc-pfx, output v-par-type) no-error.
     4123       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "", yes, output bc-frmt, output v-par-type) no-error.
     4124       os-delete value (search ("MT_documents.txt")) no-error.
     4125       os-delete value (search ("MT_lines.txt")) no-error.
     4126       os-delete value (search ("MT_MarkLines.txt")) no-error.
     4127     end constructor.
     4128     method public void clear():
     4129        os-delete value (search ("MT_documents.txt")) no-error.
     4130       os-delete value (search ("MT_lines.txt")) no-error.
     4131       os-delete value (search ("MT_MarkLines.txt")) no-error.
     4132       docClear().
     4133     end.
     4134     method private void tsdstreamopen (streamFile as char):
     4135       output stream tsdstream to value (streamFile).
     4136     end method.
     4137     method private void tsdstreamopenapp (streamFile as char):
     4138       output stream tsdstream to value (streamFile) append.
     4139     end method.
     4140     method private void tsdstreamclose ():
     4141       output stream tsdstream close.
     4142     end method.
     4143     method public longchar getStatusXml (statusOk as logical, statusMsg as longchar):
     4144        return getStatusXml(statusOk,statusMsg,"").
     4145     end.
     4146     method public longchar getStatusXml (statusOk as logical, statusMsg as longchar, iDopTag as longchar):
     4147       define variable statusOkTag as character no-undo.
     4148       define variable statusMsgTag as character no-undo.
     4149       assign
     4150         statusOkTag = substitute ('<STATUS>&1</STATUS>', if statusOk then "OK" else "ERROR")
     4151         statusMsgTag = if statusOk then '' else substitute ('<STATUS_MESSAGE>&1</STATUS_MESSAGE>', statusMsg)
     4152       .
     4153       return substitute ('<?xml version="1.0" encoding="&1"?><TSD>&2&3&4</TSD>', CP, statusOkTag, statusMsgTag,iDopTag).
     4154     end method.
     4155     method public void getWB ():
     4156       define variable dFactSum   as decimal   no-undo.
     4157       define variable priceSale  as dec no-undo.
     4158       define variable docType    as character no-undo.
     4159       define variable hour     as integer no-undo.
     4160       define variable minute   as integer no-undo.
     4161       define variable sec      as integer no-undo.
     4162       define variable timeleft as integer no-undo.
     4163       define variable decDocQnty as decimal no-undo.
     4164       define variable decFactQnty as decimal no-undo.
     4165       define variable jj as integer no-undo.
     4166       define variable jjm as integer no-undo.
     4167       define variable iim as integer no-undo.
     4168       define buffer buf_trn-doc    for ub.trn-doc.
     4169       define buffer buf_doc-line   for ub.doc-line.
     4170       define buffer buf_goods      for ub.goods.
     4171       define buffer buf_bar-code   for ub.bar-code.
     4172       define buffer buf_parts      for ub.parts.
     4173       define buffer buf_gen-attr   for ub.gen-attr.
     4174       define buffer buf_user-login for ub.user-login.
     4175       define buffer inv-doc-attr for ub.inv-doc-attr.
     4176       define buffer goods-attr for ub.goods-attr.
     4177       def    var      internal-b-code like ub.bar-code.b-code no-undo .
     4178       def    var      full-b-code     as character init "" no-undo .
     4179       define variable myflagsDoc     as class flagsdoc     no-undo.
     4180       define variable myflagsDocLine as class flagsdocline no-undo.
     4181       myflagsDoc = new flagsdoc ().
     4182       myflagsDocLine = new flagsdocline ().
     4183       block-trn:
     4184       for each buf_trn-doc where
     4185               buf_trn-doc.obj-type = ObjType
     4186           and buf_trn-doc.obj-code = ObjCode
     4187           and ( ((buf_trn-doc.ext-doc-type = 'ee':U
     4188                 or buf_trn-doc.ext-doc-type = 'ev':U
     4189                 or buf_trn-doc.ext-doc-type = 'vt':U)
     4190                 and buf_trn-doc.flag_ = true
     4191                 and buf_trn-doc.status_ = 'разрешен':U)
     4192               or
     4193                 ((buf_trn-doc.ext-doc-type = 'ie':U
     4194                 or buf_trn-doc.ext-doc-type = 'iv':U)
     4195                 and buf_trn-doc.flag_ = true
     4196                 and buf_trn-doc.status_ = 'накл':U)
     4197               )
     4198         no-lock:
     4199       for each inv-doc-attr no-lock where (inv-doc-attr.doc-code = buf_trn-doc.doc-code
     4200                                   and inv-doc-attr.attr-code = "ItogInv") or ( inv-doc-attr.doc-code = buf_trn-doc.doc-code
     4201                                     and inv-doc-attr.attr-code = "ItogInvManual" ):
     4202          next block-trn.
     4203       end.
     4204       find first inv-doc-attr no-lock where inv-doc-attr.doc-code = buf_trn-doc.doc-code and inv-doc-attr.attr-code = "invMultDevice" and inv-doc-attr.attr-value = string(true) no-error .
     4205       if not available (inv-doc-attr) and buf_trn-doc.ext-doc-type = 'vt':U then next .
     4206       logWrite:WriteDebugLog( "Выгружаем документ " + buf_trn-doc.doc-code).
     4207         myflagsDoc:unSetAllFlags().
     4208         case buf_trn-doc.ext-doc-type:
     4209           when 'ee':U then do:
     4210             docType = "ExtSalesWB".
     4211           end.
     4212           when 'ev':U then do:
     4213             docType = "IntSalesWB".
     4214           end.
     4215           when 'ie':U then do:
     4216             docType = "ExtPurchWB".
     4217           end.
     4218           when 'iv':U then do:
     4219             docType = "IntPurchWB".
     4220           end.
     4221           when 'vt':U then do:
     4222             docType = "Inv".
     4223           end.
     4224         end case.
     4225         if IsMarkOn and not docType = 'Inv'
     4226         then do:
     4227           for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code no-lock:
     4228             find first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and buf_goods.prod-code = buf_doc-line.prod-code
     4229               and buf_goods.prod-type = buf_doc-line.prod-type.
     4230             find first goods-attr where goods-attr.gds-code = buf_goods.gds-code
     4231               and goods-attr.attr-code = 'mark':U and goods-attr.attr-value = "yes" no-lock no-error.
     4232             if available (goods-attr)
     4233             then do:
     4234               myflagsDoc:isDocMarkOn = true.
     4235               leave.
     4236             end.
     4237           end.
     4238         end.
     4239         def var pos as int no-undo.
     4240         if not myflagsDoc:isDocMarkOn
     4241         then do:
     4242           pos = 0.
     4243           for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code no-lock:
     4244             find first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and buf_goods.prod-code = buf_doc-line.prod-code and buf_goods.prod-type = buf_doc-line.prod-type.
     4245             find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code
     4246               and buf_bar-code.unit-cli = buf_goods.unit-base.
     4247             myflagsDocLine:unSetAllFlags().
     4248             internal-b-code = buf_bar-code.b-code.
     4249   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4250     define variable tmp-str9  as character no-undo.
     4251     define variable tmp-num9  as character no-undo.
     4252     define variable i9        as integer   no-undo.
     4253     define variable sum9      as integer   no-undo.
     4254     define variable len-code9 as integer   no-undo.
     4255     define variable varcont9  as logical   initial yes no-undo.
     4256     CASE bc-frmt :
     4257       WHEN "EAN13" THEN do:
     4258         assign
     4259           tmp-str9 = string( internal-b-code, "999999999999" )
     4260         .
     4261       end.
     4262       WHEN "EAN8" THEN do:
     4263         assign
     4264           tmp-str9 = string( internal-b-code, "9999999" )
     4265         .
     4266       end.
     4267       OTHERWISE DO:
     4268           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     4269           view-as alert-box error.
     4270           return error.
     4271       END.
     4272     END CASE.
     4273     if varcont9 = yes then do:
     4274       if integer( substring( tmp-str9, 1, length( bc-pfx ) ) ) <> 0
     4275       then do:
     4276         message
     4277           "Невозможно сформировать бар-код" SKIP
     4278           "для товара с кодом: " internal-b-code
     4279           view-as alert-box error title "подрезание кода".
     4280         return error.
     4281       end.
     4282       else do:
     4283         assign
     4284           full-b-code = bc-pfx + substring( tmp-str9, length( bc-pfx ) + 1, length( tmp-str9 ) - length( bc-pfx ) )
     4285           len-code9    = length( full-b-code )
     4286         .
     4287         define variable v-sum-char9 as character no-undo .
     4288         assign
     4289           sum9 = 0
     4290         .
     4291         do i9 = 1 to len-code9 by 2
     4292         :
     4293           assign
     4294             v-sum-char9 = substr(full-b-code, len-code9 - i9 + 1, 1)
     4295           .
     4296           if v-sum-char9 < "0"
     4297           or v-sum-char9 > "9"
     4298           then do:
     4299             message
     4300               "Невозможно сформировать бар-код" skip
     4301               "для товара с кодом: " internal-b-code skip
     4302               view-as alert-box error title "подсчет контрольной суммы".
     4303             return error.
     4304           end.
     4305           assign
     4306             sum9 = sum9 + integer(v-sum-char9)
     4307           .
     4308         end.
     4309         if varcont9 = yes then do:
     4310           assign
     4311             sum9 = sum9 * 3
     4312           .
     4313           do i9 = 2 to len-code9 by 2
     4314           :
     4315             assign
     4316               v-sum-char9 = substr(full-b-code, len-code9 - i9 + 1, 1)
     4317             .
     4318             if v-sum-char9 < "0"
     4319             or v-sum-char9 > "9"
     4320             then do:
     4321               message
     4322                 "Невозможно сформировать бар-код" skip
     4323                 "для товара с кодом: " internal-b-code skip
     4324                 view-as alert-box error title "подсчет контрольной суммы".
     4325               return error.
     4326             end.
     4327             assign
     4328               sum9 = sum9 + integer(v-sum-char9)
     4329             .
     4330           end.
     4331           if varcont9 = yes then do:
     4332              if sum9 mod 10 = 0 then do:
     4333                assign
     4334                  full-b-code = full-b-code + '0'
     4335                .
     4336              end.
     4337              else do:
     4338                assign
     4339                  full-b-code = full-b-code + string(10 - sum9 mod 10)
     4340                .
     4341              end.
     4342           end.
     4343         end.
     4344       end.
     4345     end.
     4346             pos = pos + 1.
     4347             decDocQnty = if docType = 'inv' then buf_doc-line.doc-qnty - buf_doc-line.fact-qnty else buf_doc-line.doc-qnty.
     4348             decFactQnty = if docType = 'inv' then buf_doc-line.doc-qnty else buf_doc-line.fact-qnty.
     4349             assign
     4350               priceSale   = if buf_doc-line.price-rubl <> ? then buf_doc-line.price-rubl else 0
     4351               .
     4352            jjm = jjm + 1.
     4353            addDocLine(jjm,
     4354                         buf_trn-doc.doc-code,
     4355                          if docType = 'inv' then pos else buf_doc-line.line-num,
     4356                         buf_goods.gds-code,
     4357                          buf_goods.gds-name ,
     4358                         buf_goods.unit-base,
     4359                         full-b-code,
     4360                          priceSale,
     4361                          decDocQnty,
     4362                          0,
     4363                         "",
     4364                         "",
     4365                          myflagsDocLine:FlagsToInt  ).
     4366           end.
     4367         end.
     4368         else do:
     4369           def var v-alc-code as char no-undo.
     4370           pos = 0.
     4371           for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code no-lock:
     4372             find first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and buf_goods.prod-code = buf_doc-line.prod-code and buf_goods.prod-type = buf_doc-line.prod-type.
     4373             find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code.
     4374             for each buf_parts no-lock where
     4375               buf_parts.obj-type = buf_trn-doc.obj-type and
     4376               buf_parts.obj-code = buf_trn-doc.obj-code and
     4377               buf_parts.artic = buf_doc-line.artic and
     4378               buf_parts.prod-type = buf_doc-line.prod-type and
     4379               buf_parts.prod-code = buf_doc-line.prod-code and
     4380               buf_parts.out-code = buf_trn-doc.doc-code:
     4381               internal-b-code = buf_bar-code.b-code.
     4382   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4383     define variable tmp-str10  as character no-undo.
