     4407       if integer( substring( tmp-str10, 1, length( bc-pfx ) ) ) <> 0
     4408       then do:
     4409         message
     4410           "Невозможно сформировать бар-код" SKIP
     4411           "для товара с кодом: " internal-b-code
     4412           view-as alert-box error title "подрезание кода".
     4413         return error.
     4414       end.
     4415       else do:
     4416         assign
     4417           full-b-code = bc-pfx + substring( tmp-str10, length( bc-pfx ) + 1, length( tmp-str10 ) - length( bc-pfx ) )
     4418           len-code10    = length( full-b-code )
     4419         .
     4420         define variable v-sum-char10 as character no-undo .
     4421         assign
     4422           sum10 = 0
     4423         .
     4424         do i10 = 1 to len-code10 by 2
     4425         :
     4426           assign
     4427             v-sum-char10 = substr(full-b-code, len-code10 - i10 + 1, 1)
     4428           .
     4429           if v-sum-char10 < "0"
     4430           or v-sum-char10 > "9"
     4431           then do:
     4432             message
     4433               "Невозможно сформировать бар-код" skip
     4434               "для товара с кодом: " internal-b-code skip
     4435               view-as alert-box error title "подсчет контрольной суммы".
     4436             return error.
     4437           end.
     4438           assign
     4439             sum10 = sum10 + integer(v-sum-char10)
     4440           .
     4441         end.
     4442         if varcont10 = yes then do:
     4443           assign
     4444             sum10 = sum10 * 3
     4445           .
     4446           do i10 = 2 to len-code10 by 2
     4447           :
     4448             assign
     4449               v-sum-char10 = substr(full-b-code, len-code10 - i10 + 1, 1)
     4450             .
     4451             if v-sum-char10 < "0"
     4452             or v-sum-char10 > "9"
     4453             then do:
     4454               message
     4455                 "Невозможно сформировать бар-код" skip
     4456                 "для товара с кодом: " internal-b-code skip
     4457                 view-as alert-box error title "подсчет контрольной суммы".
     4458               return error.
     4459             end.
     4460             assign
     4461               sum10 = sum10 + integer(v-sum-char10)
     4462             .
     4463           end.
     4464           if varcont10 = yes then do:
     4465              if sum10 mod 10 = 0 then do:
     4466                assign
     4467                  full-b-code = full-b-code + '0'
     4468                .
     4469              end.
     4470              else do:
     4471                assign
     4472                  full-b-code = full-b-code + string(10 - sum10 mod 10)
     4473                .
     4474              end.
     4475           end.
     4476         end.
     4477       end.
     4478     end.
     4479               myflagsDocLine:unSetAllFlags().
     4480               decDocQnty = buf_parts.qnty.
     4481               decFactQnty = buf_parts.fact-qnty.
     4482               assign
     4483                 priceSale   = if buf_parts.price-rubl <> ? then buf_parts.price-rubl else 0
     4484                 .
     4485               assign
     4486                 .
     4487               keyrec:GenKeyRec('parts':U, buffer buf_parts:handle, output v-keyrec).
     4488               v-alc-code = if num-entries  (buf_parts.alc-ref-ab-path, ",") < 3 then "" else entry (3, buf_parts.alc-ref-ab-path, ",").
     4489               pos = pos + 1.
     4490               iim = 0.
     4491               for each buf_gen-attr no-lock where buf_gen-attr.p-key = v-keyrec and buf_gen-attr.table-name = 'excise-mark':U:
     4492                 iim = iim + 1.
     4493                 jj = jj + 1.
     4494                 addDocLineMark(
     4495                       jj,
     4496                         buf_trn-doc.doc-code,
     4497                       pos,
     4498                         buf_gen-attr.attr-code,
     4499                         v-keyrec,
     4500                       "TH",
     4501                       ?,
     4502                       ?,
     4503                       "").
     4504               end.
     4505                 jjm = jjm + 1.
     4506                 if decimal (iim) = buf_parts.qnty
     4507                   then myflagsDocLine:isEditManualFullQnty = true.
     4508                   else myflagsDocLine:isNotEditManualQnty = true.
     4509                addDocLine(jjm,
     4510                         buf_trn-doc.doc-code,
     4511                          pos,
     4512                          buf_goods.gds-code,
     4513                          buf_goods.gds-name ,
     4514                         buf_goods.unit-base,
     4515                         full-b-code,
     4516                          priceSale,
     4517                          decDocQnty,
     4518                          0,
     4519                         "",
     4520                         v-keyrec,
     4521                          myflagsDocLine:FlagsToInt  ).
     4522             end.
     4523           end.
     4524         end.
     4525         if buf_trn-doc.ext-doc-type = 'vt':U then myflagsDoc:isDocMarkOn = yes.
     4526         find first buf_user-login where buf_user-login.user-id = buf_trn-doc.user-name  no-lock no-error.
     4527         addDoc(
     4528              buf_trn-doc.doc-code,
     4529              docType,
     4530              false,
     4531              buf_trn-doc.status_ + string (buf_trn-doc.flag, "+/-"),
     4532              buf_trn-doc.cli-code,
