        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.*.
        5   using ibs.th.skt.Adapters.*.
        6   block-level on error undo, throw.
        7   class ibs.th.skt.ControlledClients.atdclient :
        8     define private variable logWrite as class LogWrite no-undo.
        9     define public property SomeStr as longchar no-undo
       10       get.
       11       set.
       12     constructor public atdclient (  ):
       13       logWrite = new LogWrite().
       14     end.
       15     method public void hndler (req as class ibs.th.skt.Commands.IRequest):
       16       define variable vExp as class ibs.th.bge.atd.dict-atd-exp no-undo.
       17       define variable mbuffer-out as character no-undo.
       18       define variable vLC as longchar no-undo.
       19       define variable v-cont-length as integer no-undo.
       20       define buffer bclients    for ub.clients.
       21       find first bclients where bclients.obj-type = 'маг'
       22                             and bclients.db-num   = ibs.th.gbl.gbl-var:g#db-num
       23                             and bclients.stts     = 0
       24       no-lock no-error.
       25       if available bclients then do:
       26          vExp = new ibs.th.bge.atd.dict-atd-exp(bclients.db-num,
       27                                                 bclients.obj-type,
       28                                                 bclients.obj-code).
       29          LogWrite:LogStr = substitute("Обработка &1:&2:&3:&4:&5",
       30                                       "atdclient",
       31                                       req:QueryPar,
       32                                       bclients.db-num,
       33                                       bclients.obj-type,
       34                                       bclients.obj-code).
       35         req:Content.
       36         case req:HeadHTTP:QueryPar:
       37           when "GetObj"
       38           then
       39             vLC = vExp:GetNObjectTable().
       40           when "GetCashDesk"
       41           then
       42             vLC = vExp:GetNCassaTable().
       43           when "GetFuel"
       44           then
       45             vLC = vExp:GetReCodesTable().
       46           when "GetTank"
       47           then
       48             vLC = vExp:GetNTankTable().
       49           when "GetSched"
       50           then
       51             vLC = vExp:GetNSchedTable().
       52           otherwise
       53           vLC = "".
       54         end case.
       55         delete object vExp.
       56         SomeStr = vLC.
       57       end.
       58     end method.
       59           destructor public atdclient ( ):
       60         delete object logWrite.
       61           end destructor.
       62   end class.
