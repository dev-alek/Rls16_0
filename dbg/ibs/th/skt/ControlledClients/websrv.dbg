        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   using ibs.th.skt.*.
        6   block-level on error undo, throw.
        7   class ibs.th.skt.ControlledClients.websrv :
        8     define temp-table TempTrnDoc no-undo
        9       field SuppInDocNo   as character
       10       field stts          as character
       11       field ext-doc-type  as character
       12       field doc-date      as date
       13       field cli-type      as character
       14       field cli-code      as integer
       15       field obj-type      as character
       16       field obj-code      as integer
       17       field ContractID    as integer
       18       field ContractNum   as character
       19       field vat-type      as character
       20       field tot-transp    as decimal
       21       field tot-other     as decimal
       22       field wrkr          as integer
       23       field agnt          as integer
       24       field boss          as integer
       25       field pay-code      as integer
       26       field discnt-type   as character
       27       field discnt-pc     as decimal
       28       field user-id       as character
       29       field reason-code   as integer
       30       field ps            as character
       31       field hold-obj-type as character
       32       field hold-obj-code as integer
       33       field ship-num      as character
       34       field ship-date     as date
       35       index pi SuppInDocNo .
       36     define temp-table TempDocLine no-undo
       37       field SuppInDocNo  as character
       38       field line-num     as integer
       39       field gds-code     as integer
       40       field doc-qnty     as decimal
       41       field fact-qnty    as decimal
       42       field price-rubl   as decimal
       43       field vat-pc       as decimal
       44       field b-code       as character
       45       index pi
       46       SuppInDocNo
       47       line-num
       48       gds-code
       49       .
       50     define temp-table TempGdsDtl no-undo
       51       field SuppInDocNo  as character
       52       field line-num     as integer
       53       field gds-code     as integer
       54       field prt-code     as integer
       55       field b-code       as integer
       56       field doc-qnty     as decimal
       57       field price-rubl   as decimal
       58       index pi
       59       SuppInDocNo
       60       line-num
       61       gds-code
       62       prt-code
       63       .
       64     define temp-table TempParts no-undo
       65       field SuppInDocNo  as character
       66       field line-num     as integer
