       78       field attr-code    as character
       79       field attr-value   as character
       80       index pi
       81       SuppInDocNo
       82       attr-code
       83       .
       84     define stream str1 .
       85     define stream str2 .
       86     define public property SomeStr as longchar no-undo
       87       get.
       88       set.
       89     define public property ObjCode as integer no-undo
       90       private get.
       91       set.
       92     define public property ObjType as character no-undo
       93       private get.
       94       set.
       95     define public property SN as character no-undo
       96       private get.
       97       set.
       98     define public property ReqType as character no-undo
       99       get.
      100       set.
      101     define public property CP as character no-undo
      102       get.
      103       set.
      104     define private buffer buf_user      for ub.user-login.
      105     define private buffer buf_goods     for ub.goods.
      106     define private buffer buf_clients   for ub.clients.
      107     define private buffer buf_shop      for ub.shop.
      108     define private buffer buf_store     for ub.store.
      109     define private buffer buf_bar-code  for ub.bar-code.
      110     define private buffer buf_gds-obj   for ub.gds-obj.
      111     define private buffer buf_price-all for ub.price-all.
      112     define private buffer buf_prod-bc   for ub.prod-bc.
      113     define private buffer buf_trn-doc   for ub.trn-doc.
      114     define private buffer buf_doc-line  for ub.doc-line.
      115     define private variable tthDocument as handle no-undo.
      116     define private stream webstream.
      117     define private variable logWrite as class LogWrite no-undo.
      118     constructor public websrv (  ):
      119       logWrite = new LogWrite().
      120     end constructor.
      121     method private void webstreamopen (streamFile as char):
      122       output stream webstream to value (streamFile).
      123     end method.
      124     method private void webstreamclose ():
      125       output stream webstream close.
      126     end method.
      127     method public character getStatusXml (statusOk as logical, statusMsg as char):
      128       define variable statusOkTag as character no-undo.
      129       define variable statusMsgTag as character no-undo.
      130       assign
      131         statusOkTag = substitute ('<STATUS>&1</STATUS>', if statusOk then "OK" else "ERROR")
      132         statusMsgTag = if statusOk then '' else substitute ('<STATUS_MESSAGE>&1</STATUS_MESSAGE>', statusMsg)
      133       .
      134       return substitute ('<?xml version="1.0" encoding="&1"?><websrv>&2&3</websrv>', CP, statusOkTag, statusMsgTag).
      135     end method.
      136     method public void ImpWB (table TempTrnDoc, table TempDocLine, table TempGdsDtl, table TempParts, table TempDocAttr, output ANS as logical):
      137       define variable adapter         as class AdapterWebSrv-TrnDoc.
      138       define variable glog            as logical         no-undo.
      139       define variable varzero-string  as logical no-undo.
      140       find first TempTrnDoc.
      141         adapter = new AdapterWebSrv-TrnDoc().
      142         adapter:SetTempTable(table TempTrnDoc, table TempDocLine, table TempGdsDtl, table TempParts, table TempDocAttr).
      143         adapter:WriteDB(glog) no-error.
      144         LogWrite:LogStr = LogWrite:LogStr + chr(10) + adapter:StrLog.
      145         delete object adapter.
      146         if glog
      147           then do:
      148             SomeStr = getStatusXml(true, "").
      149             ANS = true.
      150           end.
      151           else do:
      152             SomeStr = getStatusXml(false, LogWrite:LogStr).
      153             ANS = false.
      154           end.
      155     end.
      156     method public void CodePageConvert ():
      157       define variable str as char no-undo.
      158       if session:charset <> replace (CP, "windows-", "")
      159         then do:
      160           str = codepage-convert (SomeStr, replace (CP, "windows-", ""), session:charset) no-error.
      161           if str = ?
      162             then.
      163             else SomeStr = str.
      164         end.
      165     end.
      166     method public void WriteUnknown ():
      167       SomeStr = getStatusXml(false, "Неизвестный запрос.").
      168     end.
      169     method public integer GetDbNum ():
      170       define buffer buf_sys-ctrl for ub.sys-ctrl .
      171       do
      172       on error undo, return error return-value
      173       :
      174         for first buf_sys-ctrl field (db-num) no-lock :
      175          return buf_sys-ctrl.db-num.
      176         end.
      177       end.
      178     end method.
      179   end class.
