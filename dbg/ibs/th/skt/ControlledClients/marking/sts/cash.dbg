        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.propmap.
        4   using ibs.th.gbl.map.mapstring.
        5   using ibs.th.gbl.TypeMap.
        6   block-level on error undo, throw.
        7   class ibs.th.skt.ControlledClients.marking.sts.cash inherits TypeMap:
        8     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        9     define override public property vss-author      as character no-undo init "$Author:$":U get.
       10     define override public property vss-date        as character no-undo init "$Date:$":U get.
       11     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       12     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       13     define override public property vss-description as character no-undo init "Статус марки по запросам с кассы" get.
       14     define public property  NotAccessible as class propmap no-undo get.
       15       protected set.
       16     define public property  NotAccessibleRet as class propmap no-undo get.
       17       protected set.
       18     define public property  NotReadyForSale as class propmap no-undo get.
       19       protected set.
       20     define public property  OutZone as class propmap no-undo get.
       21       protected set.
       22     define public property  Received as class propmap no-undo get.
       23       protected set.
       24     define public property  Return_ as class propmap no-undo get.
       25       protected set.
       26     define public property  SaleLock as class propmap no-undo get.
       27       protected set.
       28     define public property  ReturnLock as class propmap no-undo get.
       29       protected set.
       30     define public property  Unlock as class propmap no-undo get.
       31       protected set.
       32     define public property  UnlockAll as class propmap no-undo get.
       33       protected set.
       34     define public property  Commit as class propmap no-undo get.
       35       protected set.
       36     define public property  LockOtherCash as class propmap no-undo get.
       37       protected set.
       38     define public property  NotSaleSts as class propmap no-undo get.
       39       protected set.
       40     define public property CashMap as class mapstring no-undo get.
       41       protected set.
       42     constructor public cash ():
       43       CashMap = new mapstring(true).
       44       NotAccessible  = crProp(1,"NotAccessible","Маркированный товар еще не поступил в продажу на АЗК. Его реализация невозможна").
       45       NotAccessibleRet = crProp(9,"NotAccessibleRet","Маркированный товар еще не поступил в продажу на АЗК. Его оборот невозможен").
       46       SaleLock  = crProp(2,"sale_lock","Маркированный товар заблокирован для продажи.").
       47       ReturnLock  = crProp(3,"return_lock","Маркированный товар заблокирован для возврата.").
       48       Unlock  = crProp(4,"unlock","Блокировка по кассе сброшена.").
       49       UnlockAll  = crProp(5,"unlock_all","Блокировки по кассе сброшены.").
       50       Commit  = crProp(6,"commit","Чек завершен.").
       51       LockOtherCash  = crProp(7,"LockOtherCash","Маркированный товар заблокирован другой кассой.").
       52       NotSaleSts  = crProp(8,"NotSaleSts","Товар не был продан.").
       53     end.
       54   end class.
