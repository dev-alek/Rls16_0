        1   using Progress.Lang.*.
        2   using ibs.th.skt.Adapters.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.ControlledClients.TableMenu:
        5     define public property CSVStr as longchar no-undo
        6       get.
        7       private set.
        8     define public property SomeStr as char no-undo
        9       get.
       10       set.
       11     define variable logWrite      as class   LogWrite no-undo.
       12     define variable mbuffer-out   as memptr  no-undo.
       13     define variable v-cont-length as integer no-undo.
       14   method private void getAttrLib ():
       15      define variable g#attr-lib  as handle no-undo .
       16      run gbl/getgattrlib.p (output g#attr-lib).
       17   end.
       18   define public var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       19     constructor public TableMenu (  ):
       20       define variable vTmpStr as character no-undo.
       21   getAttrLib ().
       22   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       23       logWrite = new LogWrite().
       24     end constructor.
       25     method public void WriteCSVGrp ():
       26       define variable response   as character no-undo.
       27       define variable v-grp-rus  as character no-undo.
       28       define variable v-grp-eng  as character no-undo.
       29       for each ub.season no-lock:
       30         if ub.season.stts <> 0 then next.
       31         v-grp-rus = entry(1, ub.season.sea-name, '/').
       32         v-grp-eng = ''.
       33         assign
       34           v-grp-eng = entry(2, ub.season.sea-name, '/') no-error.
       35         response = response + string(ub.season.sea-code) + ',' + v-grp-rus + ',' + v-grp-eng + '|'.
       36       end.
       37       SomeStr = response.
       38     end method.
       39     method public void WriteCSVGds (cont as longchar):
       40       define variable response   as character no-undo.
       41       define variable v-parsed   as character no-undo.
       42       define variable v-sea-code as integer   no-undo.
       43       define variable v-obj-code as integer   no-undo.
       44       v-parsed = trim(substring(cont, (index(cont, 'grp=') + 4), (index(cont, '/') - (index(cont, 'grp=') + 4))), '"').
       45       v-obj-code = integer(entry(1, v-parsed, ';')) no-error.
       46       if error-status:error
       47       then do:
       48          SomeStr = "Не передан объект в запросе".
       49          return .
       50       end.
       51       v-sea-code = integer(entry(2, v-parsed, ';')) no-error.
       52       if error-status:error
       53       then do:
       54          SomeStr = "Не передан группа в запросе".
       55          return .
       56       end.
       57       logWrite:LogStr = "".
       58       for each ub.gds-season where ub.gds-season.sea-code = v-sea-code no-lock:
       59         find first ub.goods where ub.goods.gds-code = ub.gds-season.gds-code no-lock no-error.
       60         if ub.goods.stts <> 0 then next.
       61         find first ub.gds-obj where ub.gds-obj.obj-code = v-obj-code
       62           and ub.gds-obj.obj-type = 'маг'
       63           and ub.gds-obj.gds-code = ub.goods.gds-code no-lock no-error.
       64         if not available(ub.gds-obj) then
       65         do:
       66           logWrite:WriteFileToLog( substitute ('&3Ошибка: Товар "&1" Код: "&2". Убедитесь, что на товар назначена цена.', ub.goods.gds-name, ub.goods.gds-code,chr(10))).
       67           next.
       68         end.
       69         define variable v-value as character no-undo.
       70         define variable v-type  as character no-undo.
       71                if (valid-handle(ibs.th.gbl.gbl-hndllib:g#attr-lib) <> true) then do:     message       "Не загружена библиотека attr-lib"       view-as alert-box error .     stop . end. run gds-attr-value in ibs.th.gbl.gbl-hndllib:g#attr-lib
       72            (input  ub.goods.gds-code
       73            ,input  'mark-type':U
       74            ,output v-value
       75            ,output v-type
       76            ) no-error .
       77          if error-status :error
       78          then do:
       79            undo, return error return-value .
       80          end.
       81         define variable MarkType as ibs.th.str.marking.Types no-undo.
       82         MarkType = ObjSrv:Env:Marking:Types.
       83         define variable objType  as ibs.th.gbl.propmap no-undo.
       84         objType = MarkType:GetProp(v-value).
       85         if objType ne MarkType:Unknow
       86         then do:
       87            logWrite:WriteFileToLog( substitute ('&4Товар "&1" Код: "&2" установлен тип маркировки "&3". Товар пропущен.',  ub.goods.gds-name, string(ub.goods.gds-code), objType:Label_,chr(10))).
       88            next.
       89         end.
       90         find first ub.bar-code where ub.bar-code.gds-code = ub.goods.gds-code
       91           and ub.bar-code.unit-cli = ub.goods.unit-base
       92           and ub.bar-code.in-code = ''
       93           and ub.bar-code.part-code = '' no-lock no-error.
       94         if not available(ub.bar-code) then next.
       95         response = response + string(ub.bar-code.b-code) + ',' +
       96           replace(replace(replace(replace(ub.goods.label-name, "&", "&amp;"), '"', "&quot;") , "'", "&apos;"), ',', '.') + ',' +
       97           replace(replace(replace(replace(if ub.goods.engl-name = ? then "" else ub.goods.engl-name, "&", "&amp;"), '"', "&quot;") , "'", "&apos;"), ',', '.') + ',' +
       98           trim(string(ub.gds-obj.price-sale, "->>>>>>>>>>>9.99")) + '|'.
       99       end.
      100       SomeStr = response.
      101     end method.
      102   end class.
