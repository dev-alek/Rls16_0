        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.TickedCommand inherits ICommand:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Обработка запросов в сокет по Ticked" get.
       13     define public property ErrStatus as logical no-undo
       14       get.
       15       set.
       16     define public property LogMsg as character no-undo
       17       get.
       18       private set.
       19      define private variable ticked     as class  Ticked no-undo.
       20      constructor public TickedCommand (  ):
       21         super ().
       22         ticked = new Ticked().
       23      end constructor.
       24     define private variable hndlSocket as handle no-undo.
       25     method public override void Execute_( input req as ibs.th.skt.Commands.IRequest, resp as class IResponse ):
       26       hndlsocket = req:HndlSocket.
       27       ticked:AuthorizationTicked(req).
       28       writeSock("").
       29     end method.
       30     method private logical writeSock ( arg as character ):
       31       define variable mbuffer  as memptr   no-undo.
       32       define variable mbuffer1 as memptr   no-undo.
       33       define variable tempStr  as longchar no-undo.
       34       define variable glog     as logical  no-undo.
       35       set-size(mbuffer1) = length (ticked:SomeStr, "RAW":U) + 1.
       36       put-string(mbuffer1,1) = ticked:SomeStr.
       37       assign
       38         glog = hndlsocket:write(mbuffer1,1,get-size(mbuffer1)) no-error.
       39       set-size(mbuffer1) = 0.
       40       if not glog
       41         then do:
       42           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
       43           ErrStatus = true.
       44         end.
       45       return true.
       46     end method.
       47           destructor public TickedCommand ( ):
       48         delete object ticked.
       49           end destructor.
       50   end class.
