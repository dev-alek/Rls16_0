        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Commands.CashSend inherits ICommand:
        5   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   method private logical cur-time (output p-today as date,
        7                                    output p-time  as integer ):
        8     do
        9     on error undo, return error
       10     :
       11       define variable v-date1 as date      no-undo .
       12       define variable v-date2 as date      no-undo .
       13       define variable v-time  as integer   no-undo .
       14       assign
       15         v-date1 = today
       16         v-time  = time
       17         v-date2 = today
       18       .
       19       if v-date1 <> v-date2
       20       then do:
       21         assign
       22           v-date1 = today
       23           v-time  = v-time
       24         .
       25       end.
       26       assign
       27         p-today = v-date1
       28         p-time  = v-time
       29       .
       30     end.
       31   end.
       32   method private character  cur-time-date ()
       33   :
       34     return string(today, '99/99/9999':U) .
       35   end.
       36   method private decimal cur-time-mjd ()
       37   :
       38     define variable v-date as date      no-undo .
       39     define variable v-time as integer   no-undo .
       40     cur-time
       41       (output v-date
       42       ,output v-time
       43       ) .
       44     return integer(v-date) - 2400002 + (v-time / 86400) .
       45   end.
       46   method private integer cur-time-get-ending-index
       47   (input p-number as integer
       48   )
       49   :
       50     if p-number < 0
       51     or p-number = ?
       52     then do:
       53       return 1 .
       54     end.
       55     define variable v-rest as integer   no-undo .
       56     assign
       57       p-number = p-number modulo 100
       58     .
       59     if p-number < 20
       60     then do:
       61       assign
       62         v-rest = p-number
       63       .
       64     end.
       65     else do:
       66       assign
       67         v-rest = p-number modulo 10
       68       .
       69     end.
       70     case v-rest :
       71       when 1
       72       then do:
       73         return 2 .
       74       end.
       75       when 2 or
       76       when 3 or
       77       when 4
       78       then do:
       79         return 3 .
       80       end.
       81       otherwise do:
       82         return 1 .
       83       end.
       84     end case .
       85   end.
       86   method private character cur-time-mjd-to-date(
       87     input  i-mjd-diff as decimal
       88   ,output  o-Date     as date
       89   ,output  o-Time     as integer):
       90      define variable v-day-number as integer   no-undo .
       91      if    i-mjd-diff < 0
       92         or i-mjd-diff = ?
       93      then do:
       94         return "?" .
       95      end.
       96      assign
       97         v-day-number = truncate(i-mjd-diff,0).
       98         o-Date = date(v-day-number + 2400002).
       99         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      100     .
      101   end.
      102   method private character cur-time-mjd-to-string
      103   (input p-mjd-diff as decimal
      104   )
      105   :
      106     define variable v-day-number as integer   no-undo .
      107     define variable v-seconds    as integer   no-undo .
      108     define variable v-hour       as integer   no-undo .
      109     define variable v-min        as integer   no-undo .
      110     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      111     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      112     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      113     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      114     if p-mjd-diff < 0
      115     or p-mjd-diff = ?
      116     then do:
      117       return "?" .
      118     end.
      119     assign
      120       v-day-number = integer(truncate(p-mjd-diff,0))
      121       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      122     .
      123     if v-seconds > 86400
      124     then do:
      125       assign
      126         v-seconds = 86400 - 1
      127       .
      128     end.
      129     if v-seconds < 0
      130     then do:
      131       assign
      132         v-seconds = 0
      133       .
      134     end.
      135     assign
      136       v-hour = truncate(v-seconds / 3600, 0)
      137     .
      138     assign
      139       v-seconds = v-seconds modulo 3600
      140     .
      141     assign
      142       v-min = truncate(v-seconds / 60, 0)
      143     .
      144     assign
      145       v-seconds = v-seconds modulo 60
      146     .
      147     return
      148         (if v-day-number <> 0
      149           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      150           else ""
      151         )
      152       + (if v-day-number <> 0 or v-hour <> 0
      153           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      154           else ""
      155         )
      156       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      157           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      158           else ""
      159         )
      160       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      161       .
      162   end.
      163   method private character cur-time-string ()
      164   :
      165     define variable v-date as date      no-undo .
      166     define variable v-time as integer   no-undo .
      167     cur-time
      168       (output v-date
      169       ,output v-time
      170       ) .
      171     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      172   end.
      173   method private character cur-time-string-sec ()
      174   :
      175     define variable v-date as date      no-undo .
      176     define variable v-time as integer   no-undo .
      177     cur-time
      178       (output v-date
      179       ,output v-time
      180       ) .
      181     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      182   end.
      183   method private character cur-time-custom
      184   (input p-prefix as character
      185   ,input p-date-format as character
      186   ,input p-delimiter as character
      187   ,input p-time-format as character
      188   ,input p-suffix as character
      189   )
      190   :
      191     define variable v-date as date      no-undo .
      192     define variable v-time as integer   no-undo .
      193     cur-time
      194       (output v-date
      195       ,output v-time
      196       ) .
      197     return
      198       p-prefix
      199       + string(v-date, p-date-format)
      200       + p-delimiter
      201       + string(v-time, p-time-format)
      202       + p-suffix
      203       .
      204   end.
      205   method private character cur-time-print ()
      206   :
      207     define variable v-date as date      no-undo .
      208     define variable v-time as integer   no-undo .
      209     cur-time
      210       (output v-date
      211       ,output v-time
      212       ) .
      213     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      214   end.
      215   method private datetime cur-time-datetime ()
      216   :
      217     define variable v-char as character no-undo .
      218     define variable v-datetime as datetime no-undo .
      219     v-char = cur-time-string().
      220     v-datetime = datetime(v-char).
      221     return  v-datetime.
      222   end.
      223   method private character cur-time-string-msec ()
      224   :
      225     define variable v-date as datetime  no-undo .
      226     v-date = now.
      227     return string(v-date) .
      228   end.
      229      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
      230     define override public property vss-author      as character no-undo init "$Author:$":U get.
      231     define override public property vss-date        as character no-undo init "$Date:$":U get.
      232     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
      233     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
      234     define override public property vss-description as character no-undo init "премер отложеных запросов в сокет" get.
      235      define variable mAsyncHelper as class ibs.th.file.AsyncHelperth  no-undo.
      236      constructor public CashSend (ilogh as handle  ):
      237         super ().
      238         mAsyncHelper = new ibs.th.file.AsyncHelperth().
      239         mAsyncHelper:mProcPublish = ilogh.
      240         mAsyncHelper:setCurrentUserPasswd().
      241         mAsyncHelper:MyBachMode = yes.
      242         mAsyncHelper:maxproc    = 1.
      243      end constructor.
      244      method override public void ContinueExecution(input req as IRequest, input resp as IResponse ):
      245         define variable vParam as longchar no-undo.
      246         define variable vTask as character no-undo.
      247         vTask = resp:ParamWait:getParamValue("task").
      248         if EndProcShed(vTask)
      249         then do:
      250            define variable vlogfile as longchar no-undo.
      251            vlogfile = Putlog(vTask).
      252            resp:condition = resp:STSlist:WriteResponse:NameProp.
      253            if vlogfile eq ""
      254            then
      255               resp:setContent("ok").
      256            else
      257               resp:setContent(vlogfile).
      258         end.
      259      end method.
      260      define variable ShedCount as integer no-undo.
      261      method override public void Execute_( input req as IRequest, input resp as IResponse ):
      262         define variable vTask as character no-undo.
      263         resp:condition = resp:STSlist:WaitResult:NameProp.
      264         ShedCount = ShedCount + 1.
      265         vTask = "CashSend" + string(ShedCount).
      266         define variable vadr as character no-undo.
      267         vadr = replace(req:queryadr, "\", "/").
      268         vadr = if num-entries (req:queryAdr, "/") > 1
      269                 then entry(2,req:queryAdr,"/")
      270                 else "".
      271         if vadr ne ""
      272         then do:
      273            addtask(vTask, "utl/proc-cashsend.p",substitute ("cashsend.txt&1&2&1&3&1&4&1&5",
      274                                                             chr(4),
      275                                                             vadr,
      276                                                             req:getQueryParam("shop-num"),
      277                                                             req:getQueryParam("cash"),
      278                                                             req:getQueryParam("max-count")  )
      279                   ) .
      280            resp:ParamWait:setParam("task",vTask).
      281         end.
      282         else do:
      283            resp:condition = resp:STSlist:WriteResponse:NameProp.
      284            resp:setContent("Не уазано, что нужно отправить").
      285         end.
      286      end method.
      287      define variable mLableText as character no-undo.
      288      define variable mStartTime as datetime-tz no-undo init ?.
      289      method public void addtask(ITask  as character,
      290                                 iProc  as character,
      291                                 iParam as character):
      292         if mStartTime ne ?
      293         then
      294            mAsyncHelper:AddTask (ITask,iProc,iParam,mStartTime).
      295         else
      296            mAsyncHelper:AddTask (ITask,iProc,iParam).
      297         mAsyncHelper:AsyncRun().
      298      end.
      299      method public void  addTask(ITask  as character,
      300                                 iProc  as character,
      301                                 iParam as character,
      302                                 iStartTime as datetime-tz
      303                                 ):
      304         mAsyncHelper:AddTask (ITask,iProc,iParam,iStartTime).
      305         mAsyncHelper:AsyncRun().
      306   end.
      307      method public void  waitproc(itext  as character):
      308         run ibs\th\file\waithelper.p (mAsyncHelper,?,1,itext + " " + mLableText).
      309      end.
      310      method public void  waitProcLable(itext  as character):
      311         mLableText = itext.
      312      end.
      313      method public void  waitProcShed(iSched as character,
      314                                       itext  as character):
      315         run ibs\th\file\waithelper.p (mAsyncHelper,iSched,1,itext).
      316      end.
      317      define stream sReadfile.
      318      method public longchar  putlog (iSched as character):
      319         define variable vlogfile   as character no-undo.
      320         define variable vText      as character no-undo.
      321         define variable vErrorText as longchar no-undo.
      322         mAsyncHelper:DelShedDirEndProc(iSched).
      323         vlogfile = mAsyncHelper:getLog(iSched).
      324         if mAsyncHelper:FileExists(vlogfile)
      325         then do:
      326            input stream sReadfile FROM  VALUE(vlogfile).
      327            repeat:
      328               import stream sReadfile unformatted vText.
      329               if    vtext begins "error"
      330                  or entry(3,vtext," ") eq "error"
      331               then
      332                  vErrorText = vErrorText + " " +  vtext.
      333               logWrite:WriteFileToLog(vtext).
      334            end.
      335            input stream sReadfile close  .
      336            os-delete value(vlogfile).
      337         end.
      338         mAsyncHelper:DelShedDirEndProc(iSched).
      339         if vErrorText ne ""
      340         then
      341            logWrite:LogStr = "Возникла ошибка при отправке данных на кассу".
      342         return vErrorText.
      343      end.
      344      method public logical  EndProcShed(iSched as character):
      345         mAsyncHelper:WaitForOne(iSched).
      346         return not mAsyncHelper:isWorkShed(iSched).
      347      end.
      348           destructor public CashSend ( ):
      349         delete object mAsyncHelper no-error.
      350           end destructor.
      351   end class.
