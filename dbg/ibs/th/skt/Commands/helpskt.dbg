        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.HelpSkt inherits ICommand:
        7      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8      define override public property vss-author      as character no-undo init "$Author:$":U get.
        9      define override public property vss-date        as character no-undo init "$Date:$":U get.
       10      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12      define override public property vss-description as character no-undo init "Обработка запросов в сокет сервер для help" get.
       13      constructor public HelpSkt (  ):
       14         super ().
       15         addMethod("",         "ATD",          "Запросы Атд").
       16         addMethod("ATD",      "CashDesk",     "Список касс").
       17         addMethod("ATD",      "GetTank",      "Список резервуаров").
       18         addMethod("",         "SaleMark",     "Продажа маркированого товара").
       19         addMethod("SaleMark", "sale_lock",    "Заблокировать для продажи").
       20         addMethod("SaleMark", "unlock_all",   "Разблокировать все").
       21         addMethod("SaleMark", "commit",       "Закрыть чек").
       22         addMethod("SaleMark", "return_lock",  "Заблокировать для возврата").
       23         addMethod("",         "SendCash",     "Отправка данных на кассу").
       24         addMethod("SendCash", "goods",        "Отправка товаров на кассу").
       25         addMethod("SendCash", "posonline",    "Отправка настроек для проверки КМ на кассу").
       26         addMethod("",          "TableMenu",   "TableMenu").
       27         addMethod("TableMenu", "grp",         "Группы товаров").
       28         addMethod("TableMenu", "gds",         "Товары в группе grp=<номер магазина>;<номер группы>").
       29         addMethod("",          "ThInfo",      "Информация по TradeHousse").
       30         addMethod("ThInfo",    "getcashdesk", "Список касс").
       31         addMethod("ThInfo",    "VerifyRest",  "Выгрузка остатков").
       32         addMethod("",          "TSD",                   "ТСД").
       33         addMethod("TSD",       "Descr",                 "Запрос справочников").
       34         addMethod("TSD",       "Doc",                   "Обмен документами (база mysql)").
       35         addMethod("TSD",       "Users" ,                "Пользователи").
       36         addMethod("TSD",       "Object" ,               "Обекты (магазины)").
       37         addMethod("TSD",       "Client" ,               "Клиенты(организации и люди)").
       38         addMethod("TSD",       "goods" ,                "Товары").
       39         addMethod("TSD",       "TH_barcodes" ,          "Баркоды").
       40         addMethod("TSD",       "TH_goodsAndBarcodes" ,  "Товары и баркоды").
       41         addMethod("TSD",       "documents" ,            "Запрос документов (xml)").
       42         addMethod("TSD",       "Setting" ,              "Настройки и версии").
       43         addMethod("TSD",       "getnewversion" ,        "Получить файл версии").
       44      end constructor.
       45      define temp-table tt-Method
       46          field ftype   as character
       47          field fmethod as char
       48          field fdesc   as char
       49          index ftype ftype fmethod
       50          .
       51      method override public void Execute_( input req as ibs.th.skt.Commands.IRequest, input resp as class IResponse ):
       52         define variable vAdr as character no-undo.
       53         vAdr = "http://" + req:HndlSocket:local-host + ":" + string(req:HndlSocket:local-port).
       54         resp:ConvertPage = "utf-8".
       55         if req:queryPar ne ""
       56         then
       57            resp:setContent(MainHelp(req:queryPar,vAdr)).
       58         else
       59            resp:setContent(MainHelp(vAdr)).
       60         resp:Content-Type = "text/html".
       61         resp:condition = resp:STSlist:WriteResponse:NameProp.
       62      end method.
       63      method private longchar MainHelp(iAdr as char):
       64         define variable vHtml as character no-undo.
       65         vHtml =
       66   "<!DOCTYPE HTML>"  + chr(13) + chr(10) +
       67   ' <html>'  + chr(13) + chr(10) +
       68   '  <head>'  + chr(13) + chr(10) +
       69   '   <meta charset="utf-8">'  + chr(13) + chr(10) +
       70   '    <style type="text/css">'  + chr(13) + chr(10) +
       71   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125)  + chr(13) + chr(10) +
       72   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125)  + chr(13) + chr(10) +
       73   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125)  + chr(13) + chr(10) +
       74   '   </style>'  + chr(13) + chr(10) +
       75   '  </head>'  + chr(13) + chr(10) +
       76                 '<body>' + chr(13) + chr(10) +
       77                 '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">' + chr(13) + chr(10) +
       78                 '<thead>'                        + chr(13) + chr(10) +
       79                 ' <tr class="set_columns">'      + chr(13) + chr(10) +
       80                 ' <td style="width:150px"></td>'  + chr(13) + chr(10) +
       81                 ' <td style="width:250px"></td>' + chr(13) + chr(10) +
       82                 ' <td style="width:250px"></td>' + chr(13) + chr(10) +
       83                 ' <td style="width:50px"></td>' + chr(13) + chr(10) +
       84                 '</tr>'                          + chr(13) + chr(10) .
       85         vHtml = vHtml +
       86                 '<tr><!-- шапка таблицы -->' + chr(13) + chr(10) +
       87                 '<td colspan="11" style="text-align: right;"></td>' + chr(13) + chr(10) +
       88                 '</tr>' + chr(13) + chr(10) +
       89                 '<tr>' + chr(13) + chr(10) +
       90                 '<td colspan="11" style="text-align: right;">Дата формирования ' + string(today,"99.99.9999") + " " + string(time,"HH:MM:SS") + '</td>' + chr(13) + chr(10) +
       91                 '</tr>' + chr(13) + chr(10) +
       92                 '<tr>' + chr(13) + chr(10) +
       93                 '<td colspan="11" style="font-weight: bold; text-align: center;">Список запросов Socet Server</td>' + chr(13) + chr(10) +
       94                 '</tr>' + chr(13) + chr(10)
       95                 .
       96         vHtml = vHtml +
       97                 '</thead>'  + chr(13) + chr(10) +
       98                 '<tr>'  + chr(13) + chr(10) +
       99                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Виды запросов</td>'        + chr(13) + chr(10) +
      100                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Описание</td>'             + chr(13) + chr(10) +
      101                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Postman file import</td>'  + chr(13) + chr(10) +
      102                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Cкачать json</td>'         + chr(13) + chr(10) +
      103                 '</tr>'  + chr(13) + chr(10) +
      104                 '<tbody>' + chr(13) + chr(10)
      105                 .
      106         for each tt-Method where tt-Method.ftype eq "" no-lock:
      107            vHtml = vHtml + addString(tt-Method.fdesc     ,iadr + "/help?" + tt-Method.fmethod    ,iadr + "/postman/" + tt-Method.fmethod + ".json" ).
      108         end.
      109         vHtml = vHtml +
      110                 '<tbody>' + chr(13) + chr(10) +
      111                 '</table>'
      112                 .
      113         return vHtml.
      114      end.
      115      method private longchar MainHelp(itype as character, iAdr as char):
      116         define variable vHtml as character no-undo.
      117         vHtml =
      118   "<!DOCTYPE HTML>"  + chr(13) + chr(10) +
      119   ' <html>'  + chr(13) + chr(10) +
      120   '  <head>'  + chr(13) + chr(10) +
      121   '   <meta charset="utf-8">'  + chr(13) + chr(10) +
      122   '    <style type="text/css">'  + chr(13) + chr(10) +
      123   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125)  + chr(13) + chr(10) +
      124   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125)  + chr(13) + chr(10) +
      125   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125)  + chr(13) + chr(10) +
      126   '   </style>'  + chr(13) + chr(10) +
      127   '  </head>'  + chr(13) + chr(10) +
      128                 '<body>' + chr(13) + chr(10) +
      129                 '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">' + chr(13) + chr(10) +
      130                 '<thead>'                        + chr(13) + chr(10) +
      131                 ' <tr class="set_columns">'      + chr(13) + chr(10) +
      132                 ' <td style="width:150px"></td>'  + chr(13) + chr(10) +
      133                 ' <td style="width:450px"></td>' + chr(13) + chr(10) +
      134                 '</tr>'                          + chr(13) + chr(10) .
      135         find first tt-Method where tt-Method.ftype eq ""
      136                                and tt-Method.fmethod eq itype
      137         no-lock no-error.
      138         vHtml = vHtml +
      139                 '<tr><!-- шапка таблицы -->' + chr(13) + chr(10) +
      140                 '<td colspan="11" style="text-align: right;"></td>' + chr(13) + chr(10) +
      141                 '</tr>' + chr(13) + chr(10) +
      142                 '<tr>' + chr(13) + chr(10) +
      143                 '<td colspan="11" style="font-weight: bold; text-align: center;">' + (if available tt-Method then tt-Method.fdesc else "") + '</td>' + chr(13) + chr(10) +
      144                 '</tr>' + chr(13) + chr(10) +
      145                 '<tr>' + chr(13) + chr(10) +
      146                 '<td colspan="11" style="text-align: center;">' + getfile("Открыть json", iadr + "/postman/" + itype + ".json" ) + '</td>' + chr(13) + chr(10) +
      147                 '</tr>' + chr(13) + chr(10) +
      148                 '<tr>' + chr(13) + chr(10) +
      149                 '<td colspan="11" style="text-align: center;">' + getfile("Скачать json", iadr + "/postman/" + itype + ".json", yes ) + '</td>' + chr(13) + chr(10) +
      150                 '</tr>' + chr(13) + chr(10)
      151                 .
      152         vHtml = vHtml +
      153                 '</thead>'  + chr(13) + chr(10) +
      154                 '<tr>'  + chr(13) + chr(10) +
      155                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Виды запросов</td>'        + chr(13) + chr(10) +
      156                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Описание</td>'             + chr(13) + chr(10) +
      157                 '</tr>'  + chr(13) + chr(10) +
      158                 '<tbody>' + chr(13) + chr(10)
      159                 .
      160         for each tt-Method where tt-Method.ftype eq itype no-lock:
      161            vHtml = vHtml + substitute (
      162                  '<tr>&1'+
      163                  '<td text_wrap="true">&2</td>&1' +
      164                  '<td text_wrap="true">&3</td>&1' +
      165                  '</tr>&1' ,
      166                  chr(13) + chr(10) ,
      167                  tt-Method.fmethod,
      168                  tt-Method.fdesc).
      169         end.
      170         vHtml = vHtml +
      171                 '<tbody>' + chr(13) + chr(10) +
      172                 '</table>'
      173                 .
      174         return vHtml.
      175      end.
      176      method private longchar addString(iStr1 as char,
      177                                        iStr2 as char,
      178                                        iStr3 as char):
      179         return substitute (
      180         '<tr>&1'+
      181         '<td text_wrap="true">&2</td>&1' +
      182         '<td text_wrap="true">&3</td>&1' +
      183         '<td text_wrap="true">&4</td>&1' +
      184         '<td text_wrap="true">&5</td>&1' +
      185         '</tr>&1' ,
      186         chr(13) + chr(10) ,
      187         iStr1,
      188         getfile(iStr1 + " help",istr2),
      189         getfile(iStr1 + " json",istr3),
      190         getfile("Скачать",istr3,yes)
      191         ).
      192      end.
      193      method private char getfile (iText as character, iAdr as char):
      194         return getfile (ITEXT,IADR, no).
      195      end.
      196      method private char getfile (iText as character,iAdr as char,iSave as logical):
      197         return substitute ('<a href="&2"  target="_blank">&1</a>',itext,iadr + if iSave then "?SaveFile" else "").
      198      end.
      199      method  private void addMethod(iType  as char,iMethod as char, iDesc as char):
      200         create tt-Method.
      201         assign
      202            tt-Method.ftype   = itype
      203            tt-Method.fmethod = iMethod
      204            tt-Method.fdesc   = iDesc
      205         .
      206      end.
      207   end class.
