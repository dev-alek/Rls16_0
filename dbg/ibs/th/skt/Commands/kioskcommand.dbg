        1   using Progress.Lang.*.
        2   using ibs.th.skt.Adapters.*.
        3   using ibs.th.skt.Commands.*.
        4   block-level on error undo, throw.
        5   class ibs.th.skt.Commands.KioskCommand inherits ICommand:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Обработка запросов в сокет по Kiosk" get.
       12     define public property ErrStatus as logical no-undo
       13       get.
       14       set.
       15     define public property LogMsg as character no-undo
       16       get.
       17       set.
       18     define private property ObjCode as integer no-undo
       19       get.
       20       set.
       21     define private property ObjType as character no-undo
       22       get.
       23       set.
       24     define private buffer buf_bar-code  for ub.bar-code.
       25     define private buffer buf_prod-bc   for ub.prod-bc.
       26     define private buffer buf_price-all for ub.price-all.
       27     define private buffer buf_goods     for ub.goods.
       28     define private buffer buf_gds-grp   for ub.gds-grp.
       29     define private buffer buf_clients   for ub.clients.
       30     define private buffer buf_place     for ub.place.
       31     define private buffer buf_gds-attr  for ub.goods-attr.
       32     define private buffer buf_gds-obj   for ub.gds-obj.
       33     define private buffer buf_country   for ub.country.
       34     define private variable hndlSocket as handle    no-undo.
       35     define private variable contLenght as integer   no-undo.
       36     define private variable content    as character no-undo.
       37     define private variable hRoot      as handle    no-undo.
       38     define private variable hDoc       as handle    no-undo.
       39     define private variable hRow       as handle    no-undo.
       40     define private variable hText      as handle    no-undo.
       41     define private variable i          as integer   no-undo.
       42     define private variable bcode      as character no-undo.
       43     method public override void Execute_( input req as ibs.th.skt.Commands.IRequest, resp as class IResponse):
       44       define variable contLength     as integer   no-undo.
       45       define variable priceSale      as character no-undo.
       46       define variable chHeader       as character no-undo.
       47       define variable chImage        as character no-undo.
       48       define variable chGallery      as character no-undo.
       49       define variable chCashinfo     as character no-undo.
       50       define variable chBullets      as character no-undo.
       51       define variable chSpecificaion as character no-undo.
       52       define variable confPar        as character no-undo.
       53       define variable parType        as character no-undo.
       54       define variable v-param-types  as character no-undo.
       55       define variable v-value-char   as character no-undo.
       56       define variable v-val-date     as date      no-undo.
       57       define variable v-val-decimal  as decimal   no-undo.
       58       define variable v-val-integer  as integer   no-undo.
       59       define variable v-val-logical  as logical   no-undo.
       60       define variable v-tthd         as handle    no-undo.
       61       define variable mPhotomgd      as logical     no-undo.
       62       run gbl/conf-rd.p ("gdsscrvw", "", "", 0, "", "", "", no, output confPar, output parType) no-error.
       63       create x-document hDoc.
       64       create x-noderef  hRoot.
       65       create x-noderef  hRow.
       66       create x-noderef  hText.
       67       hndlsocket = req:HndlSocket.
       68       hDoc:load("longchar",req:Content,no).
       69       hDoc:encoding = "UTF-8".
       70       hDoc:get-document-element(hRoot) .
       71       assign
       72         ObjType = if hRoot:get-attribute("obj-type") = "shop" then "маг" else "скл"
       73         ObjCode = integer (hRoot:get-attribute("obj-code"))
       74       .
       75       parseXML().
       76       run ibs/th/skt/Adapters/AdapteeProcBcrcnz.p
       77         ( input ObjType
       78         , input ObjCode
       79         , input bcode
       80         , buffer buf_bar-code
       81         , buffer buf_prod-bc
       82         , buffer buf_place
       83         )
       84       .
       85       if available (buf_bar-code)
       86       then do:
       87         find first buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock.
       88         find first buf_gds-grp where buf_gds-grp.node-code = buf_goods.grp-code no-lock.
       89         find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and
       90           buf_clients.obj-code = buf_goods.prod-code no-lock.
       91         find first buf_country where buf_country.alpha1 = buf_goods.alpha1 no-lock no-error.
       92         find first buf_gds-obj where buf_gds-obj.obj-type  = ObjType  and
       93                               buf_gds-obj.obj-code  = ObjCode  and
       94                               buf_gds-obj.artic     = buf_goods.artic     and
       95                               buf_gds-obj.prod-type = buf_goods.prod-type and
       96                               buf_gds-obj.prod-code = buf_goods.prod-code no-lock no-error.
       97         find last buf_price-all where
       98           buf_price-all.b-code          = buf_bar-code.b-code and
       99           buf_price-all.gds-code        = buf_goods.gds-code and
      100           buf_price-all.obj-code        = ObjCode and
      101           buf_price-all.obj-type        = ObjType and
      102           buf_price-all.plt-priority    = 0 and
      103           buf_price-all.last-pr         = true
      104           no-lock no-error.
      105         run adm/shattri.p (
      106           input "get":U
      107           ,input  '':U
      108           ,input  0
      109           ,input  'gds-ref':U
      110           ,input  'shema-foto':U
      111           ,output v-value-char
      112           ,output v-val-date
      113           ,output v-val-decimal
      114           ,output v-val-integer
      115           ,output v-val-logical
      116           ,output v-param-types
      117           ,input-output table-handle v-tthd
      118           ) no-error.
      119         mPhotomgd = if v-val-integer = 2 then yes else no.
      120         for each buf_gds-attr where buf_gds-attr.gds-code = buf_goods.gds-code and buf_gds-attr.attr-code = 'image-list':U no-lock.
      121           chImage = if true
      122             then "" + (if mPhotomgd then string(buf_goods.gds-code) + "/":U else '':U) + entry (1, buf_gds-attr.attr-value) + ""
      123             else "".
      124           do i = 1 to num-entries (buf_gds-attr.attr-value):
      125             chGallery = chGallery + if true
      126               then "<img>" + (if mPhotomgd then string(buf_goods.gds-code) + "/":U else '':U) + entry (i, buf_gds-attr.attr-value) + "</img>"
      127               else "".
      128           end.
      129         end.
      130         assign
      131           priceSale = if available buf_price-all then trim (string (buf_price-all.price-sale, "->>>>>>>>>>>>>>>>>>>>>>>>>>9.99"), " ") else "0.00"
      132           priceSale = replace (priceSale, ".", ",")
      133           chCashinfo = ""
      134           chBullets = chBullets + substitute ( "<item>&1: &2</item>", "Артикул", buf_goods.artic )
      135           chBullets = chBullets + substitute ( "<item>&1: &2</item>", "Код", buf_goods.gds-code )
      136           chSpecificaion = chSpecificaion + if lookup ("grp-name", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Группа", buf_gds-grp.node-name) else ""
      137           chSpecificaion = chSpecificaion + if not buf_goods.engl-name = "" and lookup ("engl-name", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Название", buf_goods.engl-name) else ""
      138           chSpecificaion = chSpecificaion + if available (buf_clients) and lookup ("prod-name", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Производитель", buf_clients.obj-name) else ""
      139           chSpecificaion = chSpecificaion + if available (buf_country) and not buf_country.long-name = "" and lookup ("alpha1", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Страна", buf_country.long-name) else ""
      140           chSpecificaion = chSpecificaion + if not buf_goods.sert = "" and lookup ("sert", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Сертификат", buf_goods.sert) else ""
      141           chSpecificaion = chSpecificaion + if not buf_goods.destin = "" and lookup ("destin", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Назначение товара", buf_goods.destin) else ""
      142           chSpecificaion = chSpecificaion + if not buf_goods.user-rule = "" and lookup ("user-rule", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Правила эксплуатации", buf_goods.user-rule) else ""
      143           chSpecificaion = chSpecificaion + if not buf_goods.struct = "" and lookup ("struct", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Состав", buf_goods.struct) else ""
      144           chSpecificaion = chSpecificaion + if not buf_goods.deadline = ? and not buf_goods.deadline = 0 and lookup ("deadline", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Срок хранения", buf_goods.deadline) else ""
      145           chSpecificaion = chSpecificaion + if available ( buf_gds-obj ) and lookup ("fact-qnty", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Остаток ", buf_gds-obj.fact-qnty) else ""
      146           chSpecificaion = chSpecificaion + if available ( buf_gds-obj ) and lookup ("in-date", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Дата последнего прихода", buf_gds-obj.in-date) else ""
      147           chSpecificaion = chSpecificaion + if buf_goods.PS <> "" and lookup ("PS", confPar) > 0 then substitute ( "<row><key>&1</key><value>&2</value></row>", "Примечание", buf_goods.PS) else ""
      148         .
      149         content =  codepage-convert(
      150         substitute ('<?xml version="1.0" encoding="utf-8"?><page>
      151           <barcode>&1</barcode>
      152           <header>&2</header>
      153           <image>&3</image>
      154           <gallery>&4</gallery>
      155           <name>&5</name> 
      156           <price>&6</price>
      157           <cashinfo>&7</cashinfo>
      158           <bullets>&8</bullets>
      159           <specification>&9</specification>
      160           </page>',
      161           buf_bar-code.b-code
      162           , " "
      163           , chImage
      164           , chGallery
      165           , buf_goods.gds-name
      166           , priceSale
      167           , chCashinfo
      168           , chBullets
      169           , chSpecificaion
      170           ), "utf-8" , session:charset).
      171       end.
      172       else do:
      173       end.
      174       writeSock ( "").
      175       LogWrite:LogStr = "Ответ отправлен".
      176     end method.
      177     method private logical writeSock ( arg as character ):
      178       define variable mbuffer  as memptr   no-undo.
      179       define variable mbuffer1 as memptr   no-undo.
      180       define variable tempStr  as longchar no-undo.
      181       define variable glog     as logical  no-undo.
      182       set-size(mbuffer1) = length (content, "RAW":U) + 1.
      183       put-string(mbuffer1,1) = content.
      184       tempStr = substitute("HTTP/1.0 200 OK&1Server: 4GL&1Content-Type: text/csv&1Content-Length: &3&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10),get-size(mbuffer1) - 1 ).
      185       set-size(mbuffer) = length (tempStr, "RAW":U) + 1 .
      186       put-string(mbuffer,1) = tempstr.
      187       assign
      188         glog = hndlsocket:write(mbuffer,1,length(tempStr,'RAW':U)) no-error.
      189       set-size(mbuffer) = 0.
      190       if not glog
      191         then do:
      192           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
      193           ErrStatus = true.
      194         end.
      195       assign
      196         glog = hndlsocket:write(mbuffer1,1,get-size(mbuffer1) - 1) no-error.
      197       set-size(mbuffer1) = 0.
      198       if not glog
      199         then do:
      200           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
      201           ErrStatus = true.
      202         end.
      203       return true.
      204     end method.
      205     method private logical parseXML(  ):
      206       do i = 1 to hRoot:num-children:
      207         hRoot:get-child(hRow,i).
      208         case hRow:name:
      209           when "barcode" then
      210             do:
      211               hRow:get-child(hText,i).
      212               bcode = hText:node-value.
      213             end.
      214         end case.
      215       end.
      216       return true.
      217     end method.
      218   end class.
