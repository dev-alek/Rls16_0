        1   using Progress.Lang.*.
        2   using ibs.th.gbl.TypeMap.
        3   using ibs.th.gbl.propmap.
        4   block-level on error undo, throw.
        5   class ibs.th.skt.Commands.ICommandStatus inherits TypeMap:
        6     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7     define override public property vss-author      as character no-undo init "$Author:$":U get.
        8     define override public property vss-date        as character no-undo init "$Date:$":U get.
        9     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11     define override public property vss-description as character no-undo init "Статусы обработки запросов в сокет" get.
       12     define public property  GetCommand          as class propmap no-undo get.  protected set.
       13     define public property  WriteStatusAndWait  as class propmap no-undo get.  protected set.
       14     define public property  WaitResult          as class propmap no-undo get.  protected set.
       15     define public property  WriteResponse       as class propmap no-undo get.  protected set.
       16     define public property  ReciveCommand       as class propmap no-undo get.  protected set.
       17      constructor public ICommandStatus (  ):
       18         super ().
       19         GetCommand         = crProp(1,"GetCommand"        ,"Получена комманда").
       20         WriteStatusAndWait = crProp(2,"WriteStatusAndWait","Ожидает вывода статуса послечего перейдет в режим ожидания завершения").
       21         WaitResult         = crProp(3,"WaitResult"        ,"Ожидает завершения").
       22         WriteResponse      = crProp(4,"WriteResponse"     ,"ОТвет сформироваан и должен быть записан в сокет").
       23         ReciveCommand      = crProp(5,"ReciveCommand"     ,"Результат отправлен").
       24      end constructor.
       25   end class.
