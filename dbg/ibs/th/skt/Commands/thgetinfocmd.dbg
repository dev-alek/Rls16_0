      129     index pi is primary obj-code obj-type CashBookId
      130     .
      131     define private variable i           as integer   no-undo.
      132     define private variable userId_     as character no-undo.
      133     define private variable sn          as character no-undo.
      134     define private variable hndlSocket  as handle    no-undo.
      135     define private variable good        AS LOGICAL   NO-UNDO.
      136     define private variable line-num    as integer no-undo .
      137     define private variable v-type      as character no-undo .
      138     define private variable expJsonQry  as handle    no-undo.
      139     define private variable v-curr-obj-type as character no-undo .
      140     define private variable v-curr-obj-code as integer no-undo .
      141     constructor public THGetInfoCmd ():
      142       v-curr-obj-type = 'маг' .
      143       find first ub.clients no-lock where ub.clients.obj-type = v-curr-obj-type
      144                                       and ub.clients.stts = 0
      145                                       and ub.clients.db-num = ibs.th.gbl.gbl-var:g#db-num
      146                                       no-error.
      147       if available ub.clients
      148       then do :
      149       v-curr-obj-code = ub.clients.obj-code .
      150       end.
      151       create query expJsonQry .
      152     end constructor.
      153     destructor public THGetInfoCmd ( ):
      154       if valid-handle(expJsonQry) then delete object expJsonQry no-error .
      155     end destructor.
      156     method public override void Execute_( input req as IRequest, resp as class IResponse ):
      157     do transaction:
      158       define variable contLength as integer   no-undo.
      159       define variable strLog     as character no-undo.
      160       define variable str        as character no-undo.
      161       define variable reqtype    as character no-undo.
      162       define variable ANS as logical .
      163       reqtype = req:QueryPar.
      164       SomeStr = "" .
      165       case reqtype :
      166         when "GetVersion"  then GetVersion().
      167         when "GetCashDesk" then GetCashDesk() .
      168         when "GetSchem"    then GetSchem() .
      169         when "GetPumpDoc"  then GetPumpDoc() .
      170         when "GetPrice"    then GetPrice() .
      171         when "GetRest"     then GetRest() .
      172         when "VerifyRest"  then VerifyRest() .
      173         when "GetRvs"      then GetRvs() .
      174         when "GetRestPtrl" then GetRestPtrl() .
      175         when "GetUser"     then GetUser() .
      176         when "GetCashp"    then GetCashPasswd () .
      177         when "GetFbrGds"   then GetFbrGds () .
      178         when "GetRestFin"  then GetRestFin() .
      179         otherwise do :
      180         end.
      181       end case.
      182       SomeStr = SomeStr + chr(13) + chr(10) .
      183       output to 123.txt.
      184       export SomeStr.
      185       hndlsocket = cast(req, ibs.th.skt.Commands.SimpleRequest):HndlSocket.
      186       SomeStr = substring(SomeStr, 3) .
      187       if ErrStatus then
      188       do:
      189         writeSock("").
      190       end.
      191       else do:
      192         writeSock(str).
      193       end.
      194     end .
      195     end method.
      196     define temp-table tt-rvs-line like rvs-line
      197       field loc1 as character
      198     .
      199       define temp-table tt-rvs-line-attr like rvs-line-attr
      200           field loc1 as character
      201           .
      202     define temp-table tt-rvs-line-pump like rvs-line-pump
      203       field loc1 as character
      204     .
      205     define temp-table tt-rvs-line-pump-attr like rvs-line-pump-attr
      206       field loc1 as character
      207     .
      208     method private void GetRvs () :
      209       define variable v-str as longchar no-undo .
      210       define variable v-where-phrase as character no-undo .
      211       define buffer buf_rvs-doc            for ub.rvs-doc .
      212       define buffer buf_rvs-doc-exp        for ub.rvs-doc .
      213       define buffer buf_rvs-doc-attr       for ub.rvs-doc-attr .
      214       define buffer buf_rvs-line           for ub.rvs-line.
      215       define buffer buf_rvs-line-attr      for ub.rvs-line-attr.
      216       define buffer buf_rvs-pump           for ub.rvs-pump.
      217       define buffer buf_rvs-pump-attr      for ub.rvs-pump-attr.
      218       define buffer buf_rvs-line-pump      for ub.rvs-line-pump.
      219       define buffer buf_rvs-line-pump-attr for ub.rvs-line-pump-attr.
      220       define buffer place                  for place.
      221       block-rvs:
      222           for each buf_rvs-doc where buf_rvs-doc.obj-type  = v-curr-obj-type
      223                                  and buf_rvs-doc.obj-code  = v-curr-obj-code
      224                                  and buf_rvs-doc.status_   = 'факт':U
      225                                  no-lock
      226                   by buf_rvs-doc.obj-type desc
      227                   by buf_rvs-doc.obj-code desc
      228                   by buf_rvs-doc.status_    desc
      229                   by buf_rvs-doc.fact-order desc
      230           :
      231              if buf_rvs-doc.rvs-type eq 'смена':U
      232              then
      233                 leave block-rvs.
      234           end.
      235           if available  buf_rvs-doc
      236           then do:
      237               v-where-phrase = substitute("FOR each buf_rvs-doc-exp no-lock where buf_rvs-doc-exp.rvs-code = '&1' ", buf_rvs-doc.rvs-code).
      238               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-doc": ['       + ExpJson(buffer buf_rvs-doc-exp:handle  , v-where-phrase) + chr(10) + "~],"  .
      239               v-where-phrase = substitute("FOR EACH buf_rvs-doc-attr no-lock where buf_rvs-doc-attr.rvs-code = '&1' ", buf_rvs-doc.rvs-code) .
      240               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-doc-attr": ['  + ExpJson(buffer buf_rvs-doc-attr:handle  , v-where-phrase) + chr(10) + "~],"  .
      241                           block-rvs-line:
      242               FOR EACH buf_rvs-line where buf_rvs-line.rvs-code     = buf_rvs-doc.rvs-code
      243               no-lock:
      244                   find first place where place.pl-code eq buf_rvs-line.pl-code
      245                                      and place.status_ ne 'удал':U
      246                   no-lock no-error.
      247                   if not avail place
      248                   then
      249                      next block-rvs-line.
      250                   create tt-rvs-line.
      251                   buffer-copy buf_rvs-line to tt-rvs-line.
      252                   tt-rvs-line.loc1 = place.loc1.
      253               end.
      254               v-where-phrase = substitute("FOR EACH tt-rvs-line     no-lock where tt-rvs-line.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      255               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-line": ['      + ExpJson(buffer tt-rvs-line:handle      , v-where-phrase) + chr(10) + "~],"  .
      256                           block-rvs-line-attr:
      257               FOR EACH buf_rvs-line-attr where buf_rvs-line-attr.rvs-code     = buf_rvs-doc.rvs-code
      258                   no-lock:
      259                   find first place where place.pl-code eq buf_rvs-line-attr.pl-code
      260                       and place.status_ ne 'удал':U
      261                       no-lock no-error.
      262                   if not avail place
      263                       then
      264                       next block-rvs-line-attr.
      265                   create tt-rvs-line-attr.
      266                   buffer-copy buf_rvs-line-attr to tt-rvs-line-attr.
      267                   tt-rvs-line-attr.loc1 = place.loc1.
      268               end.
      269               v-where-phrase = substitute("FOR EACH tt-rvs-line-attr     no-lock where tt-rvs-line-attr.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      270               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-line-attr": ['      + ExpJson(buffer tt-rvs-line-attr:handle      , v-where-phrase) + chr(10) + "~],"  .
      271               v-where-phrase = substitute("FOR EACH buf_rvs-pump     no-lock where buf_rvs-pump.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      272               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-pump": [' + ExpJson(buffer buf_rvs-pump:handle , v-where-phrase) + chr(10) + "~],"  .
      273               v-where-phrase = substitute("FOR EACH buf_rvs-pump-attr     no-lock where buf_rvs-pump-attr.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      274               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-pump-attr": [' + ExpJson(buffer buf_rvs-pump-attr:handle , v-where-phrase) + chr(10) + "~],"  .
      275                           block-rvs-line-pump:
      276               FOR EACH buf_rvs-line-pump where buf_rvs-line-pump.rvs-code     = buf_rvs-doc.rvs-code
      277                   no-lock:
      278                   find first place where place.pl-code eq buf_rvs-line-pump.pl-code
      279                       and place.status_ ne 'удал':U
      280                       no-lock no-error.
      281                   if not avail place
      282                       then
      283                       next block-rvs-line-pump.
      284                   create tt-rvs-line-pump.
      285                   buffer-copy buf_rvs-line-pump to tt-rvs-line-pump.
      286                   tt-rvs-line-pump.loc1 = place.loc1.
      287               end.
      288               v-where-phrase = substitute("FOR EACH tt-rvs-line-pump     no-lock where tt-rvs-line-pump.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      289               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-line-pump": ['      + ExpJson(buffer tt-rvs-line-pump:handle      , v-where-phrase) + chr(10) + "~],"  .
      290                           block-rvs-line-pump-attr:
      291               FOR EACH buf_rvs-line-pump-attr where buf_rvs-line-pump-attr.rvs-code     = buf_rvs-doc.rvs-code
      292                   no-lock:
      293                   find first place where place.pl-code eq buf_rvs-line-pump-attr.pl-code
      294                       and place.status_ ne 'удал':U
      295                       no-lock no-error.
      296                   if not avail place
      297                       then
      298                       next block-rvs-line-pump-attr.
      299                   create tt-rvs-line-pump-attr.
      300                   buffer-copy buf_rvs-line-pump-attr to tt-rvs-line-pump-attr.
      301                   tt-rvs-line-pump-attr.loc1 = place.loc1.
      302               end.
      303               v-where-phrase = substitute("FOR EACH tt-rvs-line-pump-attr     no-lock where tt-rvs-line-pump-attr.rvs-code     = '&1'", buf_rvs-doc.rvs-code) .
      304               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"rvs-line-pump-attr": ['      + ExpJson(buffer tt-rvs-line-pump-attr:handle      , v-where-phrase) + chr(10) + "~]"  .
      305               SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      306           end.
      307     end method .
      308     method private void GetRestPtrl () :
      309       empty temp-table tt-rest-prtl.
      310       run utl/exp-doc4crptrl.p
      311       ( input v-curr-obj-code
      312       , input v-curr-obj-type
      313       , input ""
      314       , input ""
      315       , output table tt-rest-prtl
      316       ) .
      317       empty temp-table tt-imp-parts-ptrl .
      318       define variable v-contn     as character no-undo .
      319       define buffer buf_tt-rest-prtl   for tt-rest-prtl .
      320       define buffer buf_contract  for ub.contract .
      321       for each buf_tt-rest-prtl break by buf_tt-rest-prtl.supp-code by buf_tt-rest-prtl.contract-code :
      322         if first-of (buf_tt-rest-prtl.contract-code) then do :
      323           if buf_tt-rest-prtl.contract-code > 0 then do :
      324             find first buf_contract no-lock
      325                  where  buf_contract.contract-code = buf_tt-rest-prtl.contract-code no-error .
      326             if available buf_contract then do:
      327                  v-contn = buf_contract.contract-prn-code .
      328             end .
      329             else v-contn = "0" .
      330           end .
      331           else   v-contn = "0" .
      332         end .
      333         create tt-imp-parts-ptrl .
      334         assign
      335           tt-imp-parts-ptrl.artic         = substitute("PART: &1", buf_tt-rest-prtl.artic)
      336           tt-imp-parts-ptrl.part-code     = buf_tt-rest-prtl.part-code
      337           tt-imp-parts-ptrl.in-code       = buf_tt-rest-prtl.in-code
      338           tt-imp-parts-ptrl.gds-code      = buf_tt-rest-prtl.gds-code
      339           tt-imp-parts-ptrl.price-rubl    = buf_tt-rest-prtl.prc_rubl
      340           tt-imp-parts-ptrl.fact-qnty     = buf_tt-rest-prtl.fact-qnty
      341           tt-imp-parts-ptrl.vat-tax-value = buf_tt-rest-prtl.vat-tax-value
      342           tt-imp-parts-ptrl.name-gtd      = buf_tt-rest-prtl.name-gtd
      343           tt-imp-parts-ptrl.srok-god      = buf_tt-rest-prtl.srok-god
      344           tt-imp-parts-ptrl.supp-code     = buf_tt-rest-prtl.supp-code
      345           tt-imp-parts-ptrl.supp-type     = buf_tt-rest-prtl.supp-type
      346           tt-imp-parts-ptrl.cont-prn-code = v-contn
      347           tt-imp-parts-ptrl.pl-loc1       = buf_tt-rest-prtl.pl-loc1
      348           tt-imp-parts-ptrl.cli-qnty      = buf_tt-rest-prtl.cli-qnty
      349         .
      350       end .
      351       if can-find (first tt-imp-parts-ptrl) then do :
      352         define variable v-where-phrase as character no-undo .
      353         define variable v-str as longchar no-undo .
      354         v-where-phrase = "FOR EACH tt-imp-parts-ptrl" .
      355         v-str = '"tt-imp-parts-ptrl": [' + ExpJson(temp-table tt-imp-parts-ptrl:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      356         SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      357       end .
      358     end method .
      359     method private void GetVersion () :
      360       define variable v-str as longchar no-undo .
      361       define variable v-where-phrase as character no-undo .
      362       define buffer buf_version for tt-version .
      363       create buf_version .
      364       buf_version.version-name = "15_0" .
      365       v-where-phrase = "FOR each tt-version" .
      366       v-str = '"tt-version": [' + ExpJson(temp-table tt-version:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      367         SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .   end method .
      368     method private void GetCashDesk () :
      369       define variable v-str as longchar no-undo .
      370       define variable v-where-phrase as character no-undo .
      371       define buffer buf_cash-desk for ub.cash-desk .
      372       define buffer buf_cash-desk-attr for ub.cash-desk-attr .
      373       v-where-phrase = substitute("FOR EACH buf_cash-desk no-lock where buf_cash-desk.obj-code = &1 and not buf_cash-desk.is-del and buf_cash-desk.pos-type <> 'IBM' and buf_cash-desk.pos-type <> 'R-Keeper'", v-curr-obj-code) .
      374       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"cash-desk": [' + ExpJson(buffer buf_cash-desk:handle, v-where-phrase) + chr(10) + "~],"  .
      375       v-where-phrase = substitute("FOR EACH buf_cash-desk-attr no-lock where buf_cash-desk-attr.obj-code = &1 and buf_cash-desk-attr.pos-type <> 'IBM' and buf_cash-desk-attr.pos-type <> 'R-Keeper'", v-curr-obj-code) .
      376       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"cash-desk-attr": [' + ExpJson(buffer buf_cash-desk-attr:handle, v-where-phrase) + chr(10) + "~]"  .
      377       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      378     end method .
      379     method private void GetFbrGds () :
      380       define variable v-str as longchar no-undo .
      381       define variable v-where-phrase as character no-undo .
      382       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj .
      383       v-where-phrase = substitute("FOR EACH  buf_fbr-gds-obj no-lock where  buf_fbr-gds-obj.obj-code = &1", v-curr-obj-code) .
      384       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"fbr-gds-obj": [' + ExpJson(buffer buf_fbr-gds-obj:handle, v-where-phrase) + chr(10) + "~]"  .
      385       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      386     end method .
      387     method private void GetRestFin () :
      388       define variable v-str as longchar no-undo .
      389       define variable v-where-phrase as character no-undo .
      390       define buffer bf_fin-doc for ub.fin-doc .
      391       define buffer buf_fin-doc for ub.fin-doc .
      392       define buffer bf_fin-doc-tax for ub.fin-doc-tax .
      393       define buffer buf_fin-doc-tax for ub.fin-doc-tax .
      394       define buffer bf_fin-doc-attr for ub.fin-doc-attr .
      395       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      396       define buffer bf_payment for ub.payment .
      397       define buffer buf_payment for ub.payment .
      398       define buffer buf_shift-obj for ub.shift-obj .
      399           define variable flag_rest as logical no-undo .
      400       empty temp-table tt-rest-fin .
      401       find last buf_shift-obj
      402             where buf_shift-obj.obj-type    = v-curr-obj-type
      403               and buf_shift-obj.obj-code    = v-curr-obj-code
      404         no-error.
      405       for each ub.cashbook no-lock where ub.cashBook.Status_ = 0:
      406         find first tt-rest-fin where tt-rest-fin.obj-code = buf_shift-obj.obj-code and
      407         tt-rest-fin.obj-type = buf_shift-obj.obj-type and
      408         tt-rest-fin.CashBookId = ub.CashBook.id no-error .
      409         if not available (tt-rest-fin) then do:
      410           create tt-rest-fin .
      411           assign
      412           tt-rest-fin.obj-code = buf_shift-obj.obj-code
      413           tt-rest-fin.obj-type = buf_shift-obj.obj-type
      414           tt-rest-fin.CashBookId = ub.CashBook.id
      415           .
      416         end.
      417         find last ub.arh-fin-doc-schet-nal-obj no-lock where
      418           ub.arh-fin-doc-schet-nal-obj.obj-type = buf_shift-obj.obj-type
      419           and ub.arh-fin-doc-schet-nal-obj.obj-code = buf_shift-obj.obj-code
      420           and ub.arh-fin-doc-schet-nal-obj.cli-code = buf_shift-obj.host-code
      421           and ub.arh-fin-doc-schet-nal-obj.cli-type = 'орг':U
      422           and ub.arh-fin-doc-schet-nal-obj.calc-curr-code = 0
      423           and ub.arh-fin-doc-schet-nal-obj.cashbookid = ub.CashBook.id
      424           and ub.arh-fin-doc-schet-nal-obj.curr-code = 0
      425           and ub.arh-fin-doc-schet-nal-obj.sum-type = "shift-obj" no-error .
      426         if available (ub.arh-fin-doc-schet-nal-obj) then tt-rest-fin.ostatok = ub.arh-fin-doc-schet-nal-obj.income - ub.arh-fin-doc-schet-nal-obj.expense .
      427       end.
      428           for each tt-rest-fin:
      429           if tt-rest-fin.ostatok <> 0 then flag_rest = true .
      430           end.
      431           if not flag_rest then do:
      432           find first tt-rest-fin where tt-rest-fin.obj-code = buf_shift-obj.obj-code and
      433         tt-rest-fin.obj-type = buf_shift-obj.obj-type and
      434         tt-rest-fin.CashBookId = 0 no-error .
      435         if not available (tt-rest-fin) then do:
      436           create tt-rest-fin .
      437           assign
      438           tt-rest-fin.obj-code = buf_shift-obj.obj-code
      439           tt-rest-fin.obj-type = buf_shift-obj.obj-type
      440           tt-rest-fin.CashBookId = 0
      441           .
      442         end.
      443   find first ub.pay-type no-lock where ub.pay-type.obj-name begins "наличны" no-error .
      444   if available(ub.pay-type) then do:
      445           for last wth-line no-lock where wth-line.obj-code = buf_shift-obj.obj-code and
      446           wth-line.obj-type = buf_shift-obj.obj-type and
      447           wth-line.status_ = 'факт':U and
      448           wth-line.shift-date = buf_shift-obj.shift-date and
      449           wth-line.shift-num = buf_shift-obj.shift-num and
      450           wth-line.wth-code = ub.pay-type.obj-code:
      451           tt-rest-fin.ostatok = wth-line.income - wth-line.incass .
      452           end.
      453   end.
      454           end.
      455           v-where-phrase = substitute("FOR EACH  tt-rest-fin no-lock ") .
      456           v-str = v-str + (if v-str = "" then "" else chr(10)) + '"tt-rest-fin": [' + ExpJson(buffer tt-rest-fin:handle, v-where-phrase) + chr(10) + "~]"  .
      457        SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      458     end method .
      459     method private void GetSchem () :
      460       define variable v-str as longchar no-undo .
      461       define variable v-where-phrase as character no-undo .
      462       define buffer buf_place for ub.place .
      463       define buffer buf_place-attr for ub.place-attr .
      464       define buffer buf_pump for ub.pump .
      465       define buffer buf_nozzle for ub.nozzle .
      466       define buffer buf_pl-pump for ub.pl-pump .
      467       define buffer buf_pump-nozzle for ub.pump-nozzle .
      468       define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle .
      469       define buffer buf_pl-level for ub.pl-level .
      470       define buffer buf_pl-gds for ub.pl-gds .
      471       define buffer buf_pl-gds-pump for ub.pl-gds-pump .
      472       define buffer buf_bar-code for ub.bar-code .
      473       define buffer buf_prod-bc for ub.prod-bc .
      474       for each buf_pl-gds no-lock where buf_pl-gds.obj-type = v-curr-obj-type and buf_pl-gds.obj-code = v-curr-obj-code,
      475       each buf_bar-code no-lock where buf_bar-code.gds-code = buf_pl-gds.gds-code:
      476       for each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code and buf_prod-bc.bc-on:
      477         find first tt-gds-prod where tt-gds-prod.gds-code = buf_pl-gds.gds-code and tt-gds-prod.b-str = buf_prod-bc.b-str no-error.
      478         if not available tt-gds-prod
      479         then do :
      480           create tt-gds-prod .
      481           assign
      482             tt-gds-prod.gds-code = buf_pl-gds.gds-code
      483             tt-gds-prod.b-str    = buf_prod-bc.b-str
      484             tt-gds-prod.bc-on-type = buf_prod-bc.bc-on-type
      485           .
      486         end.
      487       end.
      488       end.
      489       v-where-phrase = substitute("FOR EACH buf_place no-lock where buf_place.obj-type = '&1' and buf_place.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      490       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"place": [' + ExpJson(buffer buf_place:handle, v-where-phrase) + chr(10) + "~],"  .
      491       v-where-phrase = substitute("FOR EACH buf_place-attr no-lock where buf_place-attr.obj-type = '&1' and buf_place-attr.obj-code = &2 and not buf_place-attr.attr-code begins 'place-SI'", v-curr-obj-type, v-curr-obj-code) .
      492       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"place-attr": [' + ExpJson(buffer buf_place-attr:handle, v-where-phrase) + chr(10) + "~],"  .
      493       v-where-phrase = substitute("FOR EACH buf_pump no-lock where buf_pump.obj-type = '&1' and buf_pump.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      494       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pump": [' + ExpJson(buffer buf_pump:handle, v-where-phrase) + chr(10) + "~]," .
      495       v-where-phrase = substitute("FOR EACH buf_nozzle no-lock where buf_nozzle.obj-type = '&1' and buf_nozzle.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      496       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"nozzle": [' + ExpJson(buffer buf_nozzle:handle, v-where-phrase) + chr(10) + "~]," .
      497       v-where-phrase = substitute("FOR EACH buf_pl-pump no-lock where buf_pl-pump.obj-type = '&1' and buf_pl-pump.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      498       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pl-pump": [' + ExpJson(buffer buf_pl-pump:handle, v-where-phrase) + chr(10) + "~]," .
      499       v-where-phrase = substitute("FOR EACH buf_pump-nozzle no-lock where buf_pump-nozzle.obj-type = '&1' and buf_pump-nozzle.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      500       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pump-nozzle": [' + ExpJson(buffer buf_pump-nozzle:handle, v-where-phrase) + chr(10) + "~]," .
      501       v-where-phrase = substitute("FOR EACH buf_pl-pump-nozzle no-lock where buf_pl-pump-nozzle.obj-type = '&1' and buf_pl-pump-nozzle.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      502       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pl-pump-nozzle": [' + ExpJson(buffer buf_pl-pump-nozzle:handle, v-where-phrase) + chr(10) + "~]," .
      503       v-where-phrase = substitute("FOR EACH buf_pl-level no-lock where buf_pl-level.obj-type = '&1' and buf_pl-level.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      504       if can-find(first buf_pl-level no-lock where buf_pl-level.obj-type = v-curr-obj-type and buf_pl-level.obj-code = v-curr-obj-code)
      505       then
      506       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pl-level": [' + ExpJson(buffer buf_pl-level:handle, v-where-phrase) + chr(10) + "~]," .
      507       v-where-phrase = substitute("FOR EACH buf_pl-gds no-lock where buf_pl-gds.obj-type = '&1' and buf_pl-gds.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      508       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pl-gds": [' + ExpJson(buffer buf_pl-gds:handle, v-where-phrase) + chr(10) + "~]," .
      509       v-where-phrase = substitute("FOR EACH buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = '&1' and buf_pl-gds-pump.obj-code = &2", v-curr-obj-type, v-curr-obj-code) .
      510       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"pl-gds-pump": [' + ExpJson(buffer buf_pl-gds-pump:handle, v-where-phrase) + chr(10) + "~]," .
      511       v-where-phrase = "FOR EACH tt-gds-prod" .
      512       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"tt-gds-prod": [' + ExpJson(temp-table tt-gds-prod:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      513       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      514     end method .
      515     method private void GetPumpDoc () :
      516       define variable v-str as longchar no-undo .
      517       define variable v-where-phrase as character no-undo .
      518       define buffer buf_icnt-doc for ub.icnt-doc .
      519       define buffer buf_icnt-line for ub.icnt-line .
      520       define buffer buf_place for ub.place .
      521       define buffer buf_pl-gds for ub.pl-gds .
      522       define buffer buf_bar-code for ub.bar-code .
      523       define buffer buf_prod-bc for ub.prod-bc .
      524       for each buf_pl-gds no-lock where buf_pl-gds.obj-type = v-curr-obj-type and buf_pl-gds.obj-code = v-curr-obj-code,
      525       each buf_bar-code no-lock where buf_bar-code.gds-code = buf_pl-gds.gds-code,
      526       each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code and buf_prod-bc.bc-on and length(trim(buf_prod-bc.b-str)) < 3 :
      527         find first tt-gds-prod where tt-gds-prod.gds-code = buf_pl-gds.gds-code no-error.
      528         if not available tt-gds-prod
      529         then do :
      530           create tt-gds-prod .
      531           assign
      532             tt-gds-prod.gds-code = buf_pl-gds.gds-code
      533             tt-gds-prod.b-str    = buf_prod-bc.b-str
      534             tt-gds-prod.bc-on-type = buf_prod-bc.bc-on-type
      535           .
      536         end.
      537       end.
      538       for each buf_place no-lock where buf_place.obj-type = v-curr-obj-type and buf_place.obj-code = v-curr-obj-code :
      539         find first tt-place-loc where tt-place-loc.pl-code = buf_place.pl-code no-error.
      540         if not available tt-place-loc
      541         then do :
      542           create tt-place-loc .
      543           assign
      544             tt-place-loc.pl-code = buf_place.pl-code
      545             tt-place-loc.loc1    = buf_place.loc1
      546           .
      547         end.
      548       end.
      549       find last icnt-doc no-lock where icnt-doc.obj-type = v-curr-obj-type and icnt-doc.obj-code = v-curr-obj-code and icnt-doc.doc-type = 'инв-сч-трк':U use-index stat-fact no-error.
      550       if not available icnt-doc
      551       then do :
      552       end.
      553       v-where-phrase = substitute("FOR each buf_icnt-doc no-lock where buf_icnt-doc.obj-type = '&1' and buf_icnt-doc.obj-code = &2 and buf_icnt-doc.doc-code = '&3'", v-curr-obj-type, v-curr-obj-code, icnt-doc.doc-code) .
      554       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"icnt-doc": [' + ExpJson(buffer buf_icnt-doc:handle, v-where-phrase) + chr(10) + "~],"  .
      555       v-where-phrase = substitute("FOR EACH buf_icnt-line no-lock where buf_icnt-line.obj-type = '&1' and buf_icnt-line.obj-code = &2 and buf_icnt-line.doc-code = '&3'", v-curr-obj-type, v-curr-obj-code, icnt-doc.doc-code) .
      556       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"icnt-line": [' + ExpJson(buffer buf_icnt-line:handle, v-where-phrase) + chr(10) + "~],"  .
      557       v-where-phrase = "FOR EACH tt-gds-prod" .
      558       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"tt-gds-prod": [' + ExpJson(temp-table tt-gds-prod:default-buffer-handle, v-where-phrase) + chr(10) + "~]," .
      559       v-where-phrase = "FOR EACH tt-place-loc" .
      560       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"tt-place-loc": [' + ExpJson(temp-table tt-place-loc:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      561       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      562     end method .
      563     method private void GetPrice () :
      564       define variable v-str as longchar no-undo .
      565       define variable v-where-phrase as character no-undo .
      566       define variable v-price as decimal   no-undo .
      567       define variable v-cur-dn as character no-undo .
      568       define variable v-cur-rt as decimal   no-undo .
      569       define variable v-cur-ex as decimal   no-undo .
      570       define buffer buf_gds-obj   for ub.gds-obj.
      571       define buffer buf_bar-code  for ub.bar-code.
      572       define buffer buf_goods     for ub.goods .
      573       empty temp-table tt-gds-price .
      574       for each buf_gds-obj no-lock where
      575                buf_gds-obj.obj-type = v-curr-obj-type and
      576                buf_gds-obj.obj-code = v-curr-obj-code
      577                    :
      578             if  buf_gds-obj.fact-qnty = 0 and buf_gds-obj.last-doc <= today - 200 then next.
      579             v-price =   buf_gds-obj.price-sale.
      580             if v-price = 0 or v-price = ? then next.
      581           find first tt-gds-price where tt-gds-price.gds-code = buf_gds-obj.gds-code no-error.
      582           if not available tt-gds-price
      583           then do :
      584             create tt-gds-price .
      585             assign tt-gds-price.gds-code = buf_gds-obj.gds-code .
      586           end.
      587           assign tt-gds-price.price = v-price .
      588       end.
      589       v-where-phrase = "FOR EACH tt-gds-price" .
      590       v-str = v-str + (if v-str = "" then "" else chr(10)) + '"tt-gds-price": [' + ExpJson(temp-table tt-gds-price:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      591       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      592     end method .
      593     method private void GetUser () :
      594       define variable v-str          as longchar  no-undo .
      595       define variable v-where-phrase as character no-undo .
      596       define buffer buf_user-account for ub.user-account .
      597       define buffer buf_user-login   for ub.user-login .
      598       define buffer buf_user-host    for ub.user-host .
      599       define buffer buf_user-obj     for ub.user-obj .
      600       define buffer buf_user-menu-group   for ub.user-menu-group .
      601       for each buf_user-login no-lock where buf_user-login.user-administrator <> yes and buf_user-login.db-num = ibs.th.gbl.gbl-var:g#db-num:
      602       for each buf_user-account no-lock where buf_user-account.status_ = 0 and buf_user-login.user-id = buf_user-account.user-id
      603         :
      604           create tt-user-account.
      605           buffer-copy buf_user-account to tt-user-account .
      606           create tt-user-login .
      607           buffer-copy buf_user-login to tt-user-login .
      608           for each buf_user-host no-lock where buf_user-host.user-id = buf_user-account.user-id:
      609             create tt-user-host .
      610             buffer-copy buf_user-host to tt-user-host .
      611           end.
      612           for each buf_user-obj no-lock where buf_user-obj.user-id = buf_user-account.user-id:
      613             create tt-user-obj .
      614             buffer-copy buf_user-obj to tt-user-obj .
      615           end.
      616           for each buf_user-menu-group no-lock where buf_user-menu-group.user-id = buf_user-account.user-id:
      617             create tt-user-menu-group .
      618             buffer-copy buf_user-menu-group to tt-user-menu-group .
      619           end.
      620         end.
      621       end.
      622               v-where-phrase = "FOR EACH tt-user-account".
      623               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"user-account": ['       + ExpJson(temp-table tt-user-account:default-buffer-handle  , v-where-phrase) + chr(10) + "~],"  .
      624               v-where-phrase = "FOR EACH tt-user-login" .
      625               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"user-login": ['  + ExpJson(temp-table tt-user-login:default-buffer-handle, v-where-phrase) + chr(10) + "~],"  .
      626               v-where-phrase = "FOR EACH tt-user-host" .
      627               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"user-host": ['  + ExpJson(temp-table tt-user-host:default-buffer-handle  , v-where-phrase) + chr(10) + "~],"  .
      628               v-where-phrase = "FOR EACH tt-user-obj" .
      629               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"user-obj": ['  + ExpJson(temp-table tt-user-obj:default-buffer-handle  , v-where-phrase) + chr(10) + "~],"  .
      630               v-where-phrase = "FOR EACH tt-user-menu-group" .
      631               v-str = v-str + (if v-str = "" then "" else chr(10)) + '"user-menu-group": ['  + ExpJson(temp-table tt-user-menu-group:default-buffer-handle  , v-where-phrase) + chr(10) + "~]"  .
      632               SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      633     end method .
      634     method private void GetRest () :
      635       empty temp-table tt-rest.
      636       run utl/exp-doc4cr.p
      637       ( input v-curr-obj-code
      638       , input v-curr-obj-type
      639       , input ""
      640       , input ""
      641       , output table tt-rest
      642       ) .
      643       empty temp-table tt-imp-parts .
      644     define variable v-contn     as character no-undo .
      645     define buffer buf_tt-rest   for tt-rest .
      646     define buffer buf_contract  for ub.contract .
      647     for each buf_tt-rest break by buf_tt-rest.supp-code by buf_tt-rest.contract-code :
      648       if first-of (buf_tt-rest.contract-code) then do :
      649         if buf_tt-rest.contract-code > 0 then do :
      650           find first buf_contract no-lock
      651                where  buf_contract.contract-code = buf_tt-rest.contract-code no-error .
      652           if available buf_contract then do:
      653                v-contn = buf_contract.contract-prn-code .
      654           end .
      655           else v-contn = "0" .
      656         end .
      657         else   v-contn = "0" .
      658       end .
      659       create tt-imp-parts .
      660       assign
      661         tt-imp-parts.artic         = substitute("PART: &1", buf_tt-rest.artic)
      662         tt-imp-parts.part-code     = buf_tt-rest.part-code
      663         tt-imp-parts.in-code       = buf_tt-rest.in-code
      664         tt-imp-parts.gds-code      = buf_tt-rest.gds-code
      665         tt-imp-parts.price-rubl    = buf_tt-rest.prc_rubl
      666         tt-imp-parts.fact-qnty     = buf_tt-rest.fact-qnty
      667         tt-imp-parts.vat-tax-value = buf_tt-rest.vat-tax-value
      668         tt-imp-parts.name-gtd      = buf_tt-rest.name-gtd
      669         tt-imp-parts.srok-god      = buf_tt-rest.srok-god
      670         tt-imp-parts.supp-code     = buf_tt-rest.supp-code
      671         tt-imp-parts.supp-type     = buf_tt-rest.supp-type
      672         tt-imp-parts.cont-prn-code = v-contn
      673       .
      674     end .
      675     if can-find (first tt-imp-parts) then do :
      676       define variable v-where-phrase as character no-undo .
      677       define variable v-str as longchar no-undo .
      678       v-where-phrase = "FOR EACH tt-imp-parts" .
      679       v-str = '"tt-imp-parts": [' + ExpJson(temp-table tt-imp-parts:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      680       SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      681     end .
      682     end method .
      683     method private void VerifyRest () :
      684     define variable th-stk-gd as handle no-undo .
      685     define variable th-stk-fu as handle no-undo .
      686     define variable tb-stk-gd as handle no-undo .
      687     define variable tb-stk-fu as handle no-undo .
      688     define variable v-contn   as character no-undo .
      689     define variable v-where-phrase as character no-undo .
      690     define variable v-str-gd       as longchar no-undo .
      691     define variable v-str-fu       as longchar no-undo .
      692     define variable v-exp-json     as longchar no-undo .
      693     define variable v-open-array   as character no-undo .
      694     define variable v-close-array  as character no-undo .
      695       run utl/exp-rest.p
      696       ( input v-curr-obj-code
      697       , input v-curr-obj-type
      698       , output table-handle th-stk-gd
      699       , output table-handle th-stk-fu
      700       ) .
      701       v-close-array = substitute('&1]', chr(10)) .
      702       if th-stk-gd:has-records then do :
      703         tb-stk-gd = th-stk-gd:default-buffer-handle .
      704         assign
      705           v-where-phrase = substitute("for each &1", tb-stk-gd:name)
      706           v-open-array   = substitute('"&1":['     , tb-stk-gd:name)
      707         .
      708         v-exp-json = ExpJson(tb-stk-gd, v-where-phrase) .
      709         v-str-gd   = v-open-array + v-exp-json + v-close-array .
      710       end .
      711       else v-str-gd = "" .
      712       if th-stk-fu:has-records then do :
      713         tb-stk-fu = th-stk-fu:default-buffer-handle .
      714         assign
      715           v-where-phrase = substitute("for each &1", tb-stk-fu:name)
      716           v-open-array   = substitute('"&1":['     , tb-stk-fu:name)
      717         .
      718         v-exp-json = ExpJson(tb-stk-fu, v-where-phrase) .
      719         v-str-fu   = v-open-array + v-exp-json + v-close-array .
      720       end .
      721       else v-str-fu = "" .
      722       SomeStr = "~{" + chr(10) .
      723       SomeStr = SomeStr + "~{" + chr(10) .
      724       if v-str-gd <> "" then assign
      725         SomeStr = (SomeStr + v-str-gd)
      726         SomeStr = (SomeStr + "," + chr(10)) when (v-str-fu <> "")
      727       .
      728       if v-str-fu <> "" then assign
      729         SomeStr = (SomeStr + v-str-fu)
      730       .
      731       SomeStr = SomeStr + chr(10) + "~}" .
      732     end method .
      733     method private void GetCashPasswd () :
      734       define buffer buf_staff for ub.staff .
      735       define variable v-str as longchar no-undo .
      736       define variable v-where-phrase as character no-undo .
      737       empty temp-table tt-cash-passwd .
      738       for each buf_staff no-lock where buf_staff.role = 'C':U :
      739         create tt-cash-passwd .
      740         assign
      741           tt-cash-passwd.staff-code = buf_staff.staff-code
      742           tt-cash-passwd.password   = buf_staff.password
      743         .
      744       end .
      745       if can-find (first tt-cash-passwd) then do :
      746         v-where-phrase = "FOR EACH tt-cash-passwd" .
      747         v-str = '"tt-cash-passwd": [' + ExpJson(temp-table tt-cash-passwd:default-buffer-handle, v-where-phrase) + chr(10) + "~]" .
      748         SomeStr = "~{" + chr(10) + "~{" + chr(10) + v-str + chr(10) + "~}" .
      749       end .
      750     end method .
      751     method private longchar ExpJson(input hTab as handle, input where-phrase as character):
      752       define variable vI    as int64    no-undo.
      753       define variable vBuff as handle   no-undo.
      754       define variable vRes  as longchar no-undo.
      755       define variable v-field-value as character no-undo .
      756       define variable v-line-start  as character no-undo .
      757       define variable v-line-next   as character no-undo .
      758       define variable v-from as character extent 5 initial ['\' , '"' , 'здесь chr 10' , 'здесь chr 13', 'здесь tab' ] no-undo .
      759       define variable v-to   as character extent 5 initial ['\\', '\"', ''             , ''            , ''          ] no-undo .
      760       v-from[3]= chr(10).
      761       v-from[4]= chr(13).
      762       v-from[5]= chr(9).
      763       define variable vJ    as int    no-undo.
      764       define variable v-is-first as logical no-undo .
      765       vRes = "" .
      766       vBuff = hTab.
      767       v-line-start = substitute("&1~{&1", chr(10)) .
      768       v-line-next  = substitute(",&1",    chr(10)) .
      769       v-is-first = true .
      770       expJsonQry:set-buffers(vBuff).
      771       expJsonQry:query-prepare(where-phrase).
      772       expJsonQry:query-open.
      773     loop:
      774       repeat:
      775         expJsonQry:get-next().
      776         if expJsonQry:query-off-end then leave loop.
      777         if v-is-first then v-is-first = false .
      778                       else vRes = vRes + "," .
      779         vRes = vRes + v-line-start .
      780         do vI = 1 to vBuff:num-fields:
      781           if vBuff:buffer-field[vI]:buffer-value = ?
      782           then v-field-value = "" .
      783           else do :
      784             v-field-value = replace( vBuff:buffer-field[vI]:buffer-value, v-from[1], v-to[1] ) .
      785             do vJ = 2 to extent(v-from) :
      786               v-field-value = replace( v-field-value, v-from[vJ], v-to[vJ] ) .
      787             end .
      788           end .
      789           vRes = vRes + quoter(vBuff:buffer-field[vI]:name) + ':"' + v-field-value + '"'.
      790           if vI < vBuff:num-fields then vRes = vRes + v-line-next.
      791         end.
      792         vRes = vRes + chr(10) + "~}".
      793       end.
      794       expJsonQry:query-close().
      795       return vRes.
      796     end method.
      797     method private logical writeSock ( arg as character ):
      798       define variable mbuffer  as memptr   no-undo.
      799       define variable mbuffer1 as memptr   no-undo.
      800       define variable tempStr  as longchar no-undo.
      801       define variable glog     as logical  no-undo.
      802       set-size(mbuffer1) = 0.
      803       set-size(mbuffer1) = length (SomeStr, "RAW":U) + 1.
      804       put-string(mbuffer1,1) = SomeStr.
      805       tempStr = substitute("HTTP/1.0 200 OK&1Server: 4GL&1Content-Type: text/csv&1Content-Length: &3&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10),get-size(mbuffer1)).
      806       set-size(mbuffer) = 0.
      807       set-size(mbuffer) = length (tempStr, "RAW":U) + 1.
      808       put-string(mbuffer,1) = tempstr.
      809       assign
      810         glog = hndlsocket:write(mbuffer,1,length(tempStr,'RAW':U)) no-error.
      811       set-size(mbuffer) = 0.
      812       if not glog
      813       then do:
      814          LogWrite:LogStr = LogWrite:LogStr + " " + "ќшибка при отправке сообщени€ удаленному клиенту.".
      815       end.
      816       assign
      817         glog = hndlsocket:write(mbuffer1,1,get-size(mbuffer1)) no-error.
      818       if not glog
      819         then do:
      820           LogWrite:LogStr = LogWrite:LogStr + " " + "ќшибка при отправке сообщени€ удаленному клиенту.".
      821         end.
      822       set-size(mbuffer1) = 0.
      823       return true.
      824     end method.
      825   end class.
