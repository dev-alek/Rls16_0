        1   using ibs.th.skt.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.THGetInfoCmd inherits ICommand:
        7       define override property vss-revision       as character no-undo init "$Revision$":U get.
        8       define override property  vss-author         as character no-undo init "$Author$":U get.
        9       define override property  vss-date           as character no-undo init "$Date$":U get.
       10       define override property  vss-workfile       as character no-undo init "$Workfile$":U get.
       11       define override property  vss-archive        as character no-undo init "$Archive$":U get.
       12       define override property  vss-description    as character no-undo init "Ёкранные триггеры промо-акций" get.
       13     define public property ErrStatus as logical no-undo
       14       get.
       15       private set.
       16     define public property LogMsg as character no-undo
       17       get.
       18       private set.
       19     define public property SomeData as memptr no-undo
       20       get.
       21       private set.
       22     define public property SomeStr as longchar no-undo
       23       get.
       24       private set.
