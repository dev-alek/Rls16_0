       65   define temp-table tt-rest-prtl no-undo
       66     field artic         like ub.parts.artic
       67     field part-code     as character
       68     field in-code       as character
       69     field gds-code      like ub.gds-obj.gds-code
       70     field prc_rubl      as decimal
       71     field sum_rubl      as decimal
       72     field fact-qnty     as decimal
       73     field vat-tax-value as decimal
       74     field name-gtd      as character
       75     field srok-god      as character
       76     field supp-code     as integer
       77     field supp-type     like ub.parts.supp-type
       78     field contract-code as integer
       79     field pl-loc1       as character
       80     field cli-qnty      as decimal
       81     index pi is primary in-code
       82     index i-supp supp-code contract-code
       83     index i-gds gds-code
