      115       define temp-table tt-user-login like ub.user-login .
      116       define temp-table tt-user-host  like ub.user-host .
      117       define temp-table tt-user-obj   like ub.user-obj .
      118       define temp-table tt-user-menu-group  like ub.user-menu-group .
      119       define temp-table tt-user-account  like ub.user-account .
      120   define temp-table tt-cash-passwd
