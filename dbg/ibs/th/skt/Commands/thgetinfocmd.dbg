       85   define temp-table tt-imp-parts no-undo
       86      field artic         as character
       87      field part-code     as character
       88      field in-code       like ub.parts.in-code
       89      field gds-code      as integer
       90      field price-rubl    like ub.parts.price-rubl
       91      field fact-qnty     like ub.parts.fact-qnty
       92      field vat-tax-value as decimal
       93      field name-gtd      as character
       94      field srok-god      as character
       95      field supp-code     as integer
       96      field supp-type     as character
       97      field cont-prn-code like ub.contract.contract-prn-code
