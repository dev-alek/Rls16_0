       99   define temp-table tt-imp-parts-ptrl no-undo
      100      field artic         as character
      101      field part-code     as character
      102      field in-code       like ub.parts.in-code
      103      field gds-code      as integer
      104      field price-rubl    like ub.parts.price-rubl
      105      field fact-qnty     like ub.parts.fact-qnty
      106      field vat-tax-value as decimal
      107      field name-gtd      as character
      108      field srok-god      as character
      109      field supp-code     as integer
      110      field supp-type     as character
      111      field cont-prn-code like ub.contract.contract-prn-code
      112              field pl-loc1       as character
      113              field cli-qnty      as decimal
