        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.Filesend inherits ICommand:
        7      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8      define override public property vss-author      as character no-undo init "$Author:$":U get.
        9      define override public property vss-date        as character no-undo init "$Date:$":U get.
       10      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12      define override public property vss-description as character no-undo init "Обработка запросов в сокет сервер для отправки файлов" get.
       13      method override public void Execute_( input req as ibs.th.skt.Commands.IRequest, input resp as class IResponse ):
       14         sendfile(resp, req:queryAdr,req:queryPar).
       15      end method.
       16      method public void sendfile (input resp as class IResponse, ifilename as char):
       17         sendfile(resp, ifilename, "").
       18      end.
       19      method public void sendfile (input resp as class IResponse, ifilename as char, iparam as char):
       20         resp:setFile(ifilename, iparam).
       21         resp:condition = resp:STSlist:WriteResponse:NameProp.
       22      end.
       23   end class.
