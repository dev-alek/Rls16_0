        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Commands.ICommandProc inherits ICommand  abstract:
        5      define public property hpApi as handle no-undo
        6      get.
        7      private set.
        8   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        9   method public integer IsProcessRunning
       10     (PID AS INTEGER) :
       11     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
       12     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
       13     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
       14     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
       15     define variable rv          as integer no-undo .
       16     RUN OpenProcess in hpapi
       17                     ( 1024,
       18                       0,
       19                       PID,
       20                       OUTPUT hProcess).
       21     IF hProcess NE 0 THEN DO:
       22        RUN GetExitcodeProcess in hpapi
       23                     ( hProcess,
       24                       OUTPUT ExitCode,
       25                       OUTPUT ReturnValue).
       26        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
       27             then  - 1
       28             else ReturnValue).
       29        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
       30     END.
       31     RETURN rv.
       32   end.
       33      method public int64 runProc (icmd as character):
       34         return runProc(?, icmd).
       35      end.
       36      method public int64 runProc (idir as char, icmd as character):
       37        define variable bat-file as character no-undo.
       38        define variable v-pid as int64 no-undo.
       39        run gbl/_tmpfile.p (
       40                           input ""
       41                         , input "bat"
       42                         , output bat-file) .
       43        v-pid = runProcFile(idir,icmd, bat-file).
       44        return v-pid.
       45     end.
       46     method public int64 runProcFile (icmd as character, iFileName as character):
       47         return runProcFile(?, icmd,iFileName).
       48     end.
       49     method public int64 runProcFile (idir as char,icmd as character, iFileName as character):
       50        define variable v-pid as int64 no-undo.
       51        output to value(iFileName) convert target "ibm866".
       52        if idir ne ?
       53        then
       54           put  unformatted "cd " idir skip.
       55        put  unformatted icmd skip.
       56        output close.
       57        run gbl/run-gpid.p (input iFileName
       58                           ,input '':U
       59                           ,output v-pid).
       60        return v-pid.
       61     end.
       62      constructor public ICommandProc (  ):
       63         super ().
       64         run gbl\getwindows.p(output hpApi).
       65      end constructor.
       66      destructor public ICommandProc ( ):
       67      end destructor.
       68   end class.
