        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.TableMenuCommand inherits ICommand:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Обработка запросов в сокет сервер для TableMenu" get.
       13     define public property ErrStatus as logical no-undo
       14       get.
       15       set.
       16     define public property LogMsg as character no-undo
       17       get.
       18       set.
       19      define         variable tm         as class  TableMenu no-undo.
       20      constructor public TableMenuCommand (  ):
       21         super ().
       22         tm = new TableMenu().
       23      end constructor.
       24     define private variable hndlSocket as handle no-undo.
       25     method override public void Execute_( input req as ibs.th.skt.Commands.IRequest, input resp as class IResponse ):
       26       hndlsocket = req:HndlSocket.
       27       case true:
       28         when req:Content matches '*<data req="grp"*' then
       29           do:
       30             tm:WriteCSVGrp().
       31           end.
       32         when req:Content matches '*<data req="gds"*' then
       33           do:
       34             tm:WriteCSVGds(req:Content).
       35           end.
       36       end case.
       37   writeSock("").
       38     end method.
       39           destructor public TableMenuCommand ( ):
       40         delete object tm.
       41           end destructor.
       42     method private logical writeSock ( arg as character ):
       43       define variable mbuffer  as memptr   no-undo.
       44       define variable mbuffer1 as memptr   no-undo.
       45       define variable tempStr  as longchar no-undo.
       46       define variable glog     as logical  no-undo.
       47       set-size(mbuffer1) = 0.
       48       set-size(mbuffer1) = length (tm:SomeStr, "RAW":U) + 1.
       49       put-string(mbuffer1,1) = tm:SomeStr.
       50       tempStr = substitute("HTTP/1.0 200 OK&1Server: 4GL&1Content-Type: text/csv&1Content-Length: &3&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10),get-size(mbuffer1)).
       51       set-size(mbuffer) = 0.
       52       set-size(mbuffer) = length (tempStr, "RAW":U) + 1.
       53       put-string(mbuffer,1) = tempstr.
       54       assign
       55         glog = hndlsocket:write(mbuffer,1,length(tempStr,'RAW':U)) no-error.
       56       set-size(mbuffer) = 0.
       57       if not glog
       58         then do:
       59           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
       60           ErrStatus = true.
       61         end.
       62       assign
       63         glog = hndlsocket:write(mbuffer1,1,get-size(mbuffer1)) no-error.
       64       set-size(mbuffer1) = 0.
       65       if not glog
       66         then do:
       67           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
       68           ErrStatus = true.
       69         end.
       70       return true.
       71     end method.
       72   end class.
