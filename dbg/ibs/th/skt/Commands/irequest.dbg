        1   using ibs.th.skt.ControlledClients.*.
        2   using ibs.th.skt.HeadHttp from propath.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Commands.IRequest abstract:
        5     define public property ContentBuff as memptr no-undo
        6       get.
        7       set.
        8     define public property HeadHTTP as HeadHTTP no-undo
        9       get.
       10       set.
       11     define public property Content as longchar no-undo
       12       get:
       13          if Content eq ? or Content = ""
       14          then do:
       15             if not (              ContentBuff = ?
       16                        or get-size (ContentBuff) = ?
       17                        or get-size (ContentBuff) = 0)
       18                  and not HeadHttp:contentType = 'raw'
       19             then
       20                  copy-lob from ContentBuff to Content no-error.
       21          end.
       22          return Content.
       23       end.
       24       set.
       25     define public property HndlSocket as handle no-undo
       26       get.
       27       set.
       28     define public property queryAdr as character  no-undo
       29     get:
       30        return if valid-object (HeadHTTP) then HeadHTTP:queryAdr else "".
       31     end.
       32     define public property queryPar as character  no-undo
       33     get:
       34        return if valid-object (HeadHTTP) then HeadHTTP:queryPar else "".
       35     end.
       36     method public character getQueryParam(iParam as char):
       37        return if valid-object (HeadHTTP) then HeadHTTP:getQueryParam(iParam) else ?.
       38     end.
       39     method public character convertContentInCharset(encoding as char):
       40        if     not (   ContentBuff = ?
       41                    or get-size (ContentBuff) = ?
       42                    or get-size (ContentBuff) = 0)
       43           and not HeadHttp:contentType = 'raw'
       44        then do:
       45           if encoding eq ?
       46           then
       47              copy-lob from ContentBuff to Content no-error.
       48           else
       49              copy-lob from ContentBuff to Content convert source codepage encoding no-error.
       50           if error-status:error
       51           then return error "Ошибка при преобразовании кодировки " + error-status:get-message(1).
       52        end.
       53     end.
       54   end class.
