        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.atdclientcmd inherits ICommand:
        7   define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Обработка запросов в сокет сервер для ATD client" get.
       13     define public property ErrStatus as logical no-undo
       14       get.
       15       set.
       16     define public property LogMsg as character no-undo
       17       get.
       18       private set.
       19      define private variable atdcli     as class  atdclient no-undo.
       20      constructor public atdclientcmd (  ):
       21         super ().
       22         atdcli = new atdclient().
       23      end constructor.
       24     define private variable hndlSocket as handle no-undo.
       25     method public override void Execute_( input req as ibs.th.skt.Commands.IRequest, resp as class IResponse ):
       26       hndlsocket = req:HndlSocket.
       27       atdcli:hndler(req).
       28       resp:Content-Type = "application/json".
       29       resp:setContent(atdcli:SomeStr).
       30       resp:condition = resp:STSlist:WriteResponse:NameProp.
       31     end method.
       32           destructor public atdclientcmd ( ):
       33         delete object atdcli.
       34      end destructor.
       35   end class.
