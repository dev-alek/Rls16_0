        1   using ibs.th.gbl.collection.paramCol.
        2   using ibs.th.skt.Commands.ICommandStatus.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Commands.IResponse abstract:
        5      define public variable STSlist as class ICommandStatus no-undo.
        6      define public property ParamWait as class paramCol no-undo
        7      get.
        8      set.
        9      constructor public IResponse (  ):
       10         super ().
       11         STSlist   = new ICommandStatus().
       12         ParamWait = new paramCol().
       13      end constructor.
       14      define public property condition as char no-undo
       15      get.
       16      set(arg as char):
       17         if STSlist:GetProp(arg) ne STSlist:Unknow
       18         then
       19            condition = arg.
       20      end.
       21      define public property Content-Type as character  no-undo init "text/html; charset=UTF-8"
       22      get.
       23      set.
       24      define public property content-disposition as character  no-undo
       25      get.
       26      set.
       27     define public property content-Md5 as character  no-undo
       28     get.
       29     set.
       30      define public property saveFile as character  no-undo
       31      set (arg as char):
       32         content-disposition = substitute ('attachment; filename="&1"',arg).
       33      end.
       34      define public property ContentLongChar as longchar no-undo
       35      get.
       36      private set .
       37      define public property ConvertPage as character  no-undo
       38      get.
       39      set(arg as char):
       40         ConvertPage = arg.
       41         if arg begins "windows-"
       42         then
       43            arg = substring (arg,9).
       44         FIX-CODEPAGE(ContentLongChar) = arg.
       45      end.
       46      define public property Content as memptr no-undo
       47      get.
       48      set(arg as memptr):
       49         Content = arg.
       50      end.
       51      define public property ContentLength as int64 no-undo
       52      get : return get-size(Content)
       53      .
       54      end.
       55      method public void setContent(arg as longchar ):
       56         setContent(arg, false).
       57      end.
       58      method public void setContent(arg as longchar, saveOrigin as logical ):
       59         set-size(Content) = 0.
       60         ContentLongChar = arg.
       61         set-size(Content) = 1.
       62         if ConvertPage eq ""
       63         then
       64            copy-lob
       65            from object arg
       66            to object Content.
       67         else do:
       68            define variable pagecode as character no-undo.
       69            if ConvertPage begins "windows-"
       70            then
       71               pagecode = substring (ConvertPage,9).
       72            else
       73               pagecode = ConvertPage.
       74            copy-lob
       75            from object ContentLongChar
       76            to object Content
       77            convert target codepage pagecode.
       78         end.
       79      end.
       80      method public void setContent(arg as char ):
       81         setContent(arg, false).
       82      end.
       83      method public void setFile(arg as char ):
       84         setFile(arg,"").
       85      end.
       86      method public void setFile(arg as char,iparam as char ):
       87         define variable vtype    as character no-undo.
       88         define variable vConType as character no-undo.
       89         define variable vRas     as character no-undo.
       90         file-information:file-name =  arg.
       91         vtype = file-information:file-type.
       92         if    file-information:file-name eq ""
       93            or vtype eq ?
       94            or index( vtype, "F") = 0
       95         then do:
       96            file-information:file-name = "cmp/" + arg.
       97            vtype = file-information:file-type.
       98            if    file-information:file-name eq ""
       99               or vtype eq ?
      100               or index( vtype, "F") = 0
      101            then
      102               file-information:file-name = "cmp/dontknow.jpg".
      103         end.
      104         vRas = entry(2,file-information:file-name,".").
      105         case vRas:
      106            when "icon" then vConType = "image/vnd.microsoft.icon".
      107            when "jpg"  then vConType = "image/jpeg".
      108            when "jpeg" then vConType = "image/jpeg".
      109            when "png"  then vConType = "image/png".
      110            when "txt"
      111         or when "xml"  then vConType = "text/xml".
      112            when "json" then vConType = "application/json".
      113            when "html" then vConType = "text/html".
      114            otherwise vConType = "raw".
      115         end.
      116         set-size(Content) = 0.
      117         run gbl/md5.p (
      118             input  file-information:full-pathname
      119            ,output content-Md5
      120            ) .
      121         set-size(Content) = file-information:file-size + 1.
      122         copy-lob from file file-information:full-pathname to Content.
      123         Content-Type = vConType.
      124         if iparam = "savefile"
      125         then do:
      126            define variable vSaveFile  as character no-undo.
      127            define variable vpos       as integer no-undo.
      128            vSaveFile = replace (file-information:file-name,"\","/").
      129            vpos = index(vSaveFile,"/").
      130            vSaveFile = substring (vSaveFile,vpos + 1).
      131            vSaveFile = replace (vSaveFile,"/","_").
      132            saveFile = vSaveFile.
      133         end.
      134      end.
      135           destructor public IResponse ( ):
      136              define variable vFiles as character no-undo.
      137              define variable vi     as integer no-undo.
      138              vFiles = paramWait:getParamValue("DeleteFile").
      139              if vFiles ne ?
      140              then do vi = 1 to num-entries(vFiles):
      141                 os-delete value(entry(vi,vFiles)) recursive.
      142              end.
      143              delete object ParamWait.
      144              set-size(Content) = 0.
      145              delete object STSlist.
      146           end destructor.
      147   end class.
