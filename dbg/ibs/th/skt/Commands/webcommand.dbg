       89     define public property ErrStatus as logical no-undo
       90       get.
       91       private set.
       92     define public property LogMsg as character no-undo
       93       get.
       94       private set.
       95     define private variable websrv      as class     websrv .
       96     define private variable hRoot       as handle    no-undo.
       97     define private variable hDoc        as handle    no-undo.
       98     define private variable hRow        as handle    no-undo.
       99     define private variable tthDocument as handle    no-undo.
      100     define private variable i           as integer   no-undo.
      101     define private variable userId_     as character no-undo.
      102     define private variable sn          as character no-undo.
      103     define private variable hndlSocket  as handle    no-undo.
      104     define private variable good        AS LOGICAL   NO-UNDO.
      105     define private variable line-num    as integer no-undo .
      106     define private variable v-type      as character no-undo .
      107     method public override void Execute_( input req as IRequest, resp as class IResponse ):
      108     do transaction:
      109       define variable contLength as integer   no-undo.
      110       define variable strLog     as character no-undo.
      111       define variable str        as character no-undo.
      112       define buffer buf_bar-code  for ub.bar-code.
      113       define buffer buf_prod-bc   for ub.prod-bc.
      114       define buffer buf_place     for ub.place.
      115       define buffer bfTempDocLine for TempDocLine.
      116       define variable ANS as logical .
      117       websrv = new websrv().
      118       create x-document hDoc.
      119       create x-noderef  hRoot.
      120       hDoc:load("longchar",req:Content,no).
      121       websrv:CP = hDoc:encoding.
      122       if hDoc:encoding <> "windows-" + session:charset then
      123       do:
      124         str = req:Content.
      125         str = codepage-convert (str, session:charset, hDoc:encoding) no-error.
      126         if error-status:error
      127           then return error "Ошибка при преобразовании кодировки".
      128         req:Content = str.
      129         delete object hDoc.
      130         create x-document hDoc.
      131         hDoc:load("longchar",req:Content,no).
      132       end.
      133       hDoc:encoding = if session:charset begins "12" then "windows-" + session:charset else session:charset.
      134       hDoc:get-document-element(hRoot) .
      135       assign
      136         websrv:ReqType = hRoot:get-attribute("item")
      137       .
      138       hndlsocket = req:HndlSocket.
      139       case websrv:ReqType :
      140         when "WAYBILL" then
      141           do:
      142             parseXML(hRoot, 1).
      143             websrv:ImpWB(table TempTrnDoc, table TempDocLine, table TempGdsDtl, table TempParts, table TempDocAttr, output ANS) .
      144               if ANS then ErrStatus = false.
      145               else ErrStatus = true.
      146           end.
      147         otherwise
      148         do:
      149           websrv:WriteUnknown().
      150         end.
      151       end.
      152       case websrv:ReqType :
      153         when "WAYBILL" then
      154           do:
      155             LogWrite:LogStr = 'Отправлен ответ на запрос типа "WAYBILL".' + chr(10) + LogWrite:LogStr.
      156           end.
      157       end case.
      158       if ErrStatus then
      159       do:
      160         writeSock("").
      161       end.
      162       else do:
      163         writeSock(str).
      164       end.
      165     end .
      166       delete object websrv.
      167     end method.
      168     method private void parseXML(hParent AS HANDLE, level AS INTEGER):
      169       DEFINE VARIABLE ii AS INTEGER NO-UNDO.
      170       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      171       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      172       CREATE X-NODEREF hNoderef.
      173       CREATE X-NODEREF hText .
      174       REPEAT ii = 1 TO hParent:NUM-CHILDREN:
      175           good = hParent:GET-CHILD(hNoderef,ii).
      176           IF NOT good THEN
      177               LEAVE.
      178           IF hNoderef:SUBTYPE <> "element" THEN
      179               NEXT.
      180           hNoderef:GET-CHILD(hText, 1) no-error .
      181           if hNoderef:NAME = "trn-doc" then do :
      182               create TempTrnDoc .
      183               line-num = 0 .
      184           end.
      185           if hNoderef:NAME = "SuppInDocNo"        then do :
      186               assign TempTrnDoc.SuppInDocNo =        hText:node-value no-error .
      187           end.
      188           if hNoderef:NAME = "Stts"               then assign TempTrnDoc.Stts =               hText:node-value no-error .
      189           if hNoderef:NAME = "ExtDocType"         then assign TempTrnDoc.ext-doc-type =       hText:node-value no-error .
      190           if hNoderef:NAME = "DocDate"            then assign TempTrnDoc.doc-date =           date(hText:node-value) no-error .
      191           if hNoderef:NAME = "ContractId"         then assign TempTrnDoc.ContractID =         integer(hText:node-value) no-error .
      192           if hNoderef:NAME = "ContractNum"        then assign TempTrnDoc.ContractNum =        hText:node-value no-error .
      193           if hNoderef:NAME = "CliType"            then assign TempTrnDoc.cli-type =           hText:node-value no-error .
      194           if hNoderef:NAME = "CliCode"            then assign TempTrnDoc.cli-code =           integer(hText:node-value) no-error .
      195           if hNoderef:NAME = "ObjType"            then assign TempTrnDoc.obj-type =           hText:node-value no-error .
      196           if hNoderef:NAME = "ObjCode"            then assign TempTrnDoc.obj-code =           integer(hText:node-value) no-error .
      197           if hNoderef:NAME = "VatType"            then assign TempTrnDoc.vat-type =           hText:node-value no-error .
      198           if hNoderef:NAME = "TransportExpSuppl"  then assign TempTrnDoc.tot-transp =         decimal(hText:node-value) no-error .
      199           if hNoderef:NAME = "OtherExpSuppl"      then assign TempTrnDoc.tot-other =          decimal(hText:node-value) no-error .
      200           if hNoderef:NAME = "Wrkr"               then assign TempTrnDoc.wrkr =               integer(hText:node-value) no-error .
      201           if hNoderef:NAME = "Agnt"               then assign TempTrnDoc.agnt =               integer(hText:node-value) no-error .
      202           if hNoderef:NAME = "Boss"               then assign TempTrnDoc.boss =               integer(hText:node-value) no-error .
      203           if hNoderef:NAME = "PayCode"            then assign TempTrnDoc.pay-code =           integer(hText:node-value) no-error .
      204           if hNoderef:NAME = "DiscntType"         then assign TempTrnDoc.discnt-type =        hText:node-value no-error .
      205           if hNoderef:NAME = "DiscntPc"           then assign TempTrnDoc.discnt-pc =          decimal(hText:node-value) no-error .
      206           if hNoderef:NAME = "User-id"            then assign TempTrnDoc.user-id =            hText:node-value no-error .
      207           if hNoderef:NAME = "PS"                 then assign TempTrnDoc.ps =                 hText:node-value no-error .
      208           if hNoderef:NAME = "ReasonCode"         then assign TempTrnDoc.reason-code =        integer(hText:node-value) no-error .
      209           if hNoderef:NAME = "hold-obj-type"      then assign TempTrnDoc.hold-obj-type =      hText:node-value no-error .
      210           if hNoderef:NAME = "hold-obj-code"      then assign TempTrnDoc.hold-obj-code =      integer(hText:node-value) no-error .
      211           if hNoderef:NAME = "ShipNum"            then assign TempTrnDoc.ship-num =           hText:node-value no-error .
      212           if hNoderef:NAME = "ShipDate"           then assign TempTrnDoc.ship-date =          date(hText:node-value) no-error .
      213           if hNoderef:NAME = "PlaceStorage" then do :
      214               create TempDocAttr .
