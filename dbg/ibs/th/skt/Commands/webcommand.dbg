      840     end method.
      841     method private logical writeSock ( arg as character ):
      842       define variable mbuffer  as memptr   no-undo.
      843       define variable mbuffer1 as memptr   no-undo.
      844       define variable tempStr  as longchar no-undo.
      845       define variable glog     as logical  no-undo.
      846       set-size(mbuffer1) = length (websrv:SomeStr, "RAW":U) + 1.
      847       put-string(mbuffer1,1) = websrv:SomeStr.
      848       assign
      849         glog = hndlsocket:write(mbuffer1,1,get-size(mbuffer1)) no-error.
      850       set-size(mbuffer1) = 0.
      851       if not glog
      852         then do:
      853           LogWrite:LogStr = LogWrite:LogStr + " " + "Ошибка при отправке сообщения удаленному клиенту.".
      854           ErrStatus = true.
      855         end.
      856       return true.
      857     end method.
      858   end class.
