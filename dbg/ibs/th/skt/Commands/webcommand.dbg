        1   using ibs.th.skt.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.Adapters.*.
        5   block-level on error undo, throw.
        6   class ibs.th.skt.Commands.webCommand inherits ICommand:
        7     define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        8     define override public property vss-author      as character no-undo init "$Author:$":U get.
        9     define override public property vss-date        as character no-undo init "$Date:$":U get.
       10     define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       11     define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       12     define override public property vss-description as character no-undo init "Обработка запросов в сокет по web" get.
       13     define temp-table TempTrnDoc no-undo
       14       field SuppInDocNo   as character
       15       field stts          as character
       16       field ext-doc-type  as character
       17       field doc-date      as date
       18       field cli-type      as character
       19       field cli-code      as integer
       20       field obj-type      as character
       21       field obj-code      as integer
       22       field ContractID    as integer
       23       field ContractNum   as character
       24       field vat-type      as character
       25       field tot-transp    as decimal
       26       field tot-other     as decimal
       27       field wrkr          as integer
       28       field agnt          as integer
       29       field boss          as integer
       30       field pay-code      as integer
       31       field discnt-type   as character
       32       field discnt-pc     as decimal
       33       field user-id       as character
       34       field reason-code   as integer
       35       field ps            as character
       36       field hold-obj-type as character
       37       field hold-obj-code as integer
       38       field ship-num      as character
       39       field ship-date     as date
       40       index pi SuppInDocNo .
