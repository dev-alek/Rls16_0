        1   block-level on error undo, throw.
        2   define input parameter objType as character no-undo.
        3   define input parameter objCode as integer no-undo.
        4   define input parameter barCode as character no-undo.
        5   define parameter buffer buf_bar-code  for ub.bar-code.
        6   define parameter buffer buf_prod-bc   for ub.prod-bc.
        7   define parameter buffer buf_place     for ub.place.
        8   define variable parresult  as character no-undo.
        9   define variable partype-bc as character no-undo.
       10   define variable parweight  as decimal   no-undo.
       11   define new global shared variable g#libbcrcn as handle no-undo .
       12   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
       13   (
       14    input  ?
       15   ,input  barCode
       16   ,input  ?
       17   ,input  objType
       18   ,input  objCode
       19   ,input  no
       20   ,input  no
       21   ,input  ?
       22   ,input  ?
       23   ,output parresult
       24   ,output partype-bc
       25   ,output parweight
       26   ,buffer buf_bar-code
       27   ,buffer buf_prod-bc
       28   ,buffer buf_place
       29   ) no-error.
