        1   block-level on error undo, throw.
        2   using ibs.th.skt.*.
        3   using ibs.th.skt.Adapters.*.
        4   define new global shared variable g#library  as handle no-undo .
        5   define new global shared variable g#library2 as handle no-undo .
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define temp-table temp_trn-doc no-undo
        8   field line-num as integer
        9   field doc-code as character
       10   field doc-date as date
       11   field ext-doc-type as character
       12   field cli-type as character
       13   field cli-code as integer
       14   field obj-type as character
       15   field obj-code as integer
       16   field wrkr as integer
       17   field agnt as integer
       18   field boss as integer
       19   field creid as character
       20   field ps as character
       21   field host-code as integer
       22   field contract-code as integer
       23   index pi line-num doc-code .
       24   define temp-table temp_gds-line no-undo
       25   field line-num    as integer
       26   field doc-code    as character
       27   field gds-code    as integer
       28   field line-qnty        as integer
       29   index pi
       30   doc-code
       31   line-num
       32   gds-code
       33   .
       34   define temp-table temp_grp-line no-undo
       35   field line-num    as integer
       36   field doc-code    as character
       37   field depart-code   as integer
       38   field class-code    as integer
       39   field subclass-code as integer
       40   index pi
       41   doc-code
       42   line-num
       43   depart-code
       44   class-code
       45   subclass-code
       46   .
       47     define temp-table TempTrnDoc no-undo
       48       field line-num      as integer
       49       field ext-doc-code  as character
       50       field doc-date      as date
       51       field ext-doc-type  as character
       52       field cli-type      as character
       53       field cli-code      as integer
       54       field obj-type      as character
       55       field obj-code      as integer
       56       field ps            as character
       57       field doc-id        as character
       58       field dog-code      as character
       59       field source-doc    as character
       60       field out-code      as character
       61       index pi line-num ext-doc-code
       62     .
       63     define temp-table TempDocLine no-undo
       64       field line-num     as integer
       65       field gds-code     as integer
       66       field doc-qnty     as decimal
       67       field fact-qnty    as decimal
       68       field price-rubl   as decimal
       69       field RowSum       as decimal
       70       field vat-pc       as decimal
       71       field fact-dnsty   as decimal
       72       field cli-qnty     as decimal
       73       field koef         as decimal
       74       field unit-code    as character
       75       field b-code       as character
       76       field is-tsd-qnty  as logical init no
       77       field vsd-uuid     as character
       78       field part-id      as character
       79       field aclMarksList as character
       80       field PartIDTH     as character
       81       index pi
       82       line-num
       83       gds-code
       84     .
       85     define temp-table TempDocPart no-undo
       86       field gds-code     as integer
       87       field doc-qnty     as decimal
       88       field fact-qnty    as decimal
       89       field price-rubl   as decimal
       90       field vat-pc       as decimal
       91       field fact-dnsty   as decimal
       92       field vsd-uuid     as character
       93       field part-id      as character
       94       field in-doc-id    as character
       95       field edoc-id      as character
       96       index pi
       97       in-doc-id
       98       part-id
       99       gds-code
      100     .
      101     define temp-table TempDocMark no-undo
      102       field gtin as character
      103       field gtin_qnt as integer
      104       field upd_id as character
      105       field prt-id as character
      106       field in-doc-id as character
      107       field mark as character
      108       field gds-code as integer
      109       index pi mark
      110     .
      111   define shared variable g#auto-user-id as character no-undo .
      112   define input  parameter table for  TempTrnDoc.
      113   define input  parameter table for  TempDocLine.
      114   define input  parameter userId_ as character no-undo.
      115   define variable iDbNum as integer no-undo.
      116   MAIN-BLOCK:
      117   do:
      118     define variable num-rec-ok as logical no-undo.
      119     define variable ii         as integer no-undo.
      120     define variable logWrite   as class   LogWrite no-undo.
      121     logWrite = new LogWrite().
      122     for each TempTrnDoc no-lock:
      123       ii = ii + 1.
      124       create temp_trn-doc.
      125       assign
      126         temp_trn-doc.line-num      = ii
      127         temp_trn-doc.doc-date      = TempTrnDoc.doc-date
      128         temp_trn-doc.ps            = TempTrnDoc.ps
      129         temp_trn-doc.ext-doc-type  = TempTrnDoc.ext-doc-type
      130         temp_trn-doc.doc-code      = TempTrnDoc.ext-doc-code
      131         temp_trn-doc.cli-type      = TempTrnDoc.cli-type
      132         temp_trn-doc.cli-code      = TempTrnDoc.cli-code
      133         temp_trn-doc.obj-type      = TempTrnDoc.obj-type
      134         temp_trn-doc.obj-code      = TempTrnDoc.obj-code
      135         temp_trn-doc.contract-code = ?
      136         .
      137       for each TempDocLine no-lock:
      138         create temp_gds-line.
      139         assign
      140           temp_gds-line.doc-code   = TempTrnDoc.ext-doc-code
      141           temp_gds-line.line-num   = TempDocLine.line-num
      142           temp_gds-line.gds-code   = TempDocLine.gds-code
      143           temp_gds-line.line-qnty  = TempDocLine.fact-qnty
      144           .
      145       end.
      146     end.
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      149     (output iDbNum
      150     )  .
      151     run utl/ora-i506-1c.p (
      152       input this-procedure ,
      153       input this-procedure ,
      154       input table temp_trn-doc ,
      155       input table temp_gds-line ,
      156       input table temp_grp-line ,
      157       output num-rec-ok
      158       ) no-error .
      159     if error-status:error
      160       then return error return-value.
      161   end.
      162   procedure pcall-log-file:
      163     define input parameter msg as character no-undo.
      164     assign
      165       LogWrite:LogStr = msg
      166       .
      167   end.
      168   procedure get-db-num:
      169     define output parameter pDbNum as integer no-undo.
      170     pDbNum = iDbNum.
      171   end.
      172   procedure get-userid:
      173     define output parameter pUserId as character no-undo.
      174     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = userId_ no-error.
      175     if available ub.user-login
      176     then
      177     do:
      178       assign
      179         pUserId  = userId_
      180         .
      181     end.
      182     else
      183     do:
      184       assign
      185         pUserId = g#auto-user-id
      186         userId_ = g#auto-user-id
      187         .
      188     end.
      189   end.
