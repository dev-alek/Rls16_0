        1   using Progress.Lang.*.
        2   using ibs.th.skt.Adapters.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Adapters.AdapterOra-i516-1c implements IAdapter:
        5     define temp-table TempTrnDoc no-undo
        6       field line-num      as integer
        7       field ext-doc-code  as character
        8       field doc-date      as date
        9       field ext-doc-type  as character
       10       field cli-type      as character
       11       field cli-code      as integer
       12       field obj-type      as character
       13       field obj-code      as integer
       14       field ps            as character
       15       field doc-id        as character
       16       field dog-code      as character
       17       field source-doc    as character
       18       field out-code      as character
       19       index pi line-num ext-doc-code
       20     .
       21     define temp-table TempDocLine no-undo
       22       field line-num     as integer
       23       field gds-code     as integer
       24       field doc-qnty     as decimal
       25       field fact-qnty    as decimal
       26       field price-rubl   as decimal
       27       field RowSum       as decimal
       28       field vat-pc       as decimal
       29       field fact-dnsty   as decimal
       30       field cli-qnty     as decimal
       31       field koef         as decimal
       32       field unit-code    as character
       33       field b-code       as character
       34       field is-tsd-qnty  as logical init no
       35       field vsd-uuid     as character
       36       field part-id      as character
       37       field aclMarksList as character
       38       field PartIDTH     as character
       39       index pi
       40       line-num
       41       gds-code
       42     .
       43     define temp-table TempDocPart no-undo
       44       field gds-code     as integer
       45       field doc-qnty     as decimal
       46       field fact-qnty    as decimal
       47       field price-rubl   as decimal
       48       field vat-pc       as decimal
       49       field fact-dnsty   as decimal
       50       field vsd-uuid     as character
       51       field part-id      as character
       52       field in-doc-id    as character
       53       field edoc-id      as character
       54       index pi
       55       in-doc-id
       56       part-id
       57       gds-code
       58     .
       59     define temp-table TempDocMark no-undo
       60       field gtin as character
       61       field gtin_qnt as integer
       62       field upd_id as character
       63       field prt-id as character
       64       field in-doc-id as character
       65       field mark as character
       66       field gds-code as integer
       67       index pi mark
       68     .
       69     define property StrLog as character no-undo
       70       get.
       71       set.
       72     define property UserId_ as character no-undo
       73       get.
       74       set.
       75     method public void WriteDB (output glog as log):
       76       run ibs/th/skt/Adapters/AdapteeProcOra-i516-1c.p
       77         (
       78         input table TempTrnDoc,
       79         input table TempDocLine,
       80         input table TempDocPart,
       81         input table TempDocMark,
       82         input UserId_
       83         ) no-error.
       84       if error-status:error then
       85       do:
       86         assign
       87           StrLog = return-value
       88           .
       89         glog = false.
       90       end.
       91       else
       92         glog = true.
       93     end method.
       94     method public void SetTempTable (input table TempTrnDoc, input table TempDocLine, input table TempDocPart, input table TempDocMark, userId_ as char):
       95       UserId_ = userId_.
       96     end method.
       97   end class.
