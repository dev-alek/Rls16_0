      161   MAIN-BLOCK:
      162   do:
      163     define variable num-rec-ok as logical no-undo.
      164     define variable ii         as integer no-undo.
      165     define variable logWrite   as class   LogWrite no-undo.
      166     logWrite = new LogWrite().
      167     for each TempTrnDoc no-lock:
      168       ii = ii + 1.
      169       create temp_trn-doc.
      170       assign
      171         temp_trn-doc.line-num      = ii
      172         temp_trn-doc.doc-date      = TempTrnDoc.doc-date
      173         temp_trn-doc.ps            = TempTrnDoc.ps
      174         temp_trn-doc.doc-code      = TempTrnDoc.ext-doc-code
      175         temp_trn-doc.ext-doc-type  = TempTrnDoc.ext-doc-type
      176         temp_trn-doc.cli-type      = TempTrnDoc.cli-type
      177         temp_trn-doc.cli-code      = TempTrnDoc.cli-code
      178         temp_trn-doc.obj-type      = TempTrnDoc.obj-type
      179         temp_trn-doc.obj-code      = TempTrnDoc.obj-code
      180         temp_trn-doc.exch-code     = 0
      181         temp_trn-doc.exch-rate     = 1
      182         temp_trn-doc.exch-scale    = 1
      183         temp_trn-doc.contract-code = ?
      184         temp_trn-doc.price-type    = if TempTrnDoc.ext-doc-type = 'ee':U then "TSFTSD" else ""
      185         .
      186     end.
      187     for each TempDocLine no-lock:
      188       create temp_doc-line.
      189       assign
      190         temp_doc-line.line-num   = TempDocLine.line-num
      191         temp_doc-line.gds-code   = TempDocLine.gds-code
      192         temp_doc-line.fact-qnty  = TempDocLine.fact-qnty
      193         temp_doc-line.doc-qnty   = TempDocLine.doc-qnty
      194         temp_doc-line.price-cli  = TempDocLine.price-rubl
      195         temp_doc-line.price-rubl = TempDocLine.price-rubl
      196         temp_doc-line.doc-code   = temp_trn-doc.doc-code
      197         .
      198     end.
      199   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      201     (output iDbNum
      202     )  .
      203     run utl/ora-i516.p (
      204       input this-procedure ,
      205       input this-procedure ,
      206       input table temp_trn-doc ,
      207       input table temp_doc-line ,
      208       input table tt-excisemarks,
