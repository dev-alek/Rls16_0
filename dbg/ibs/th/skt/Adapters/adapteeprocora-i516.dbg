      214   procedure pcall-log-file:
      215     define input parameter msg as character no-undo.
      216     assign
      217       LogWrite:LogStr = LogWrite:LogStr + chr(10) + msg
      218       .
      219   end.
      220   procedure get-db-num:
      221     define output parameter pDbNum as integer no-undo.
      222     pDbNum = iDbNum.
      223   end.
      224   procedure get-userid:
      225     define output parameter pUserId as character no-undo.
      226     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = userId_ no-error.
      227     if available ub.user-login
      228     then
      229     do:
      230       assign
      231         pUserId  = userId_
      232         .
      233     end.
      234     else
      235     do:
      236       assign
      237         pUserId = g#auto-user-id
      238         userId_ = g#auto-user-id
      239         .
      240     end.
      241   end.
      242   procedure mainmenu_getcntxt :
      243   define output parameter p-cntxt-db-num                as integer   no-undo .
      244   define output parameter p-cntxt-userid                as character no-undo .
      245   define output parameter p-cntxt-level                 as character no-undo .
