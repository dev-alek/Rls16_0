        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define new global shared variable g#library  as handle no-undo .
        9   define new global shared variable g#library2 as handle no-undo .
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   define temp-table temp_trn-doc no-undo
