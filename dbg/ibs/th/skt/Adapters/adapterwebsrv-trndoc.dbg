        1   using Progress.Lang.*.
        2   using ibs.th.skt.Adapters.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Adapters.AdapterWebSrv-TrnDoc implements IAdapter:
        5     define temp-table TempTrnDoc no-undo
        6       field SuppInDocNo   as character
        7       field stts          as character
        8       field ext-doc-type  as character
        9       field doc-date      as date
       10       field cli-type      as character
       11       field cli-code      as integer
       12       field obj-type      as character
       13       field obj-code      as integer
       14       field ContractID    as integer
       15       field ContractNum   as character
       16       field vat-type      as character
       17       field tot-transp    as decimal
       18       field tot-other     as decimal
       19       field wrkr          as integer
       20       field agnt          as integer
       21       field boss          as integer
       22       field pay-code      as integer
       23       field discnt-type   as character
       24       field discnt-pc     as decimal
       25       field user-id       as character
       26       field reason-code   as integer
       27       field ps            as character
       28       field hold-obj-type as character
       29       field hold-obj-code as integer
       30       field ship-num      as character
       31       field ship-date     as date
       32       index pi SuppInDocNo .
       33     define temp-table TempDocLine no-undo
       34       field SuppInDocNo  as character
       35       field line-num     as integer
       36       field gds-code     as integer
       37       field doc-qnty     as decimal
       38       field fact-qnty    as decimal
       39       field price-rubl   as decimal
       40       field vat-pc       as decimal
       41       field b-code       as character
       42       index pi
       43       SuppInDocNo
       44       line-num
       45       gds-code
       46       .
       47     define temp-table TempGdsDtl no-undo
       48       field SuppInDocNo  as character
