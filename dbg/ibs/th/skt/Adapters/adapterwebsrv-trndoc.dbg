       77       index pi
       78       SuppInDocNo
       79       attr-code
       80       .
       81     define property StrLog as character no-undo
       82       get.
       83       set.
       84     define property UserId_ as character no-undo
       85       get.
       86       set.
       87     method public void WriteDB (output glog as log):
       88       define variable ERR as logical no-undo init no .
       89       run ibs/th/skt/Adapters/AdapteeWebSrv-TrnDoc.p
       90         (
       91         input table TempTrnDoc,
       92         input table TempDocLine,
       93         input table TempDocAttr,
       94         input table TempGdsDtl,
       95         input table TempParts,
       96         output ERR
       97         ) no-error.
       98       if ERR then
       99       do:
      100         assign
      101           StrLog = return-value
      102           .
      103         glog = false.
      104       end.
      105       else
      106         glog = true.
      107     end method.
      108     method public void SetTempTable (input table TempTrnDoc,
      109                                      input table TempDocLine,
      110                                      input table TempGdsDtl,
      111                                      input table TempParts,
      112                                      input table TempDocAttr):
      113     end method.
      114   end class.
