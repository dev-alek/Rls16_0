       51       field prt-code     as integer
       52       field b-code       as integer
       53       field doc-qnty     as decimal
       54       field price-rubl   as decimal
       55       index pi
       56       SuppInDocNo
       57       line-num
       58       gds-code
       59       prt-code
       60       .
       61     define temp-table TempParts no-undo
       62       field SuppInDocNo  as character
       63       field line-num     as integer
