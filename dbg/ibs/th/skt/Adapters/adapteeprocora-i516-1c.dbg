      218   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      219   procedure doc-code:
      220   define input  parameter parmode          as   character           no-undo.
      221   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      222   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      223   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      224   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      225   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      226   define variable vardb-remote     as   logical             no-undo.
      227   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      228   define variable v-delimiter as character no-undo .
      229   do
      230   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      231   :
      232   find first buf_sys-ctrl no-lock .
      233   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      234     CASE parmode:
      235       when "main":u then do:
      236         if vardb-remote then do:
      237           assign
      238             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      239         end.
      240         else do:
      241           assign
      242             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      243         end.
      244       end.
      245       when "trio" then do:
      246         assign
      247           pardoc-code = replace (parroot-doc-code, "=", "*").
      248       end.
      249       otherwise do:
      250         assign
      251         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      252         no-error
      253         .
      254         if error-status:error  then do:
      255           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      256                                         ,chr(10)
      257                                         ,parmode
      258                                         ).
      259         end.
      260         if num-entries(parmode) = 1
      261         and parmode <> "chip":U
      262         and parmode <> "chip_s":U
      263         then do:
      264           assign
      265           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      266         end.
      267         else if (lookup("chip":U, parmode) > 0
      268                  or
      269                  lookup("chip_s":U, parmode) > 0) then do:
      270           assign
      271             vartemp-doc-code = parroot-doc-code.
      272           do while true:
      273             if index (vartemp-doc-code , ".") = 0 then
      274               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      275             else
      276               vartemp-doc-code  =
      277               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      278               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      279               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      280             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      281           end.
      282           assign
      283             pardoc-code = vartemp-doc-code.
      284         end.
      285       end.
      286     end CASE.
      287     if pardoc-code = '':U
      288     or (parroot-doc-code <> '':U
      289     and pardoc-code = parroot-doc-code) then do:
      290       undo, return error substitute("Ошибка при генерации номера документа&1"
      291                                     ,chr(10)).
      292     end.
      293   end.
      294   end. // procedure/method
      295   function get-doc-code-int64 returns int64
      296     ( input p-doc-code as character ) :
      297     define variable v-ind              as integer   no-undo .
      298     define variable v-num-entries      as integer   no-undo .
      299     define variable v-doc-code-int64   as int64     no-undo .
      300     define variable v-canonic-doc-code as character no-undo .
      301     assign
      302       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      303       v-canonic-doc-code = p-doc-code
      304     .
      305     do v-ind = 1 to v-num-entries
      306     :
      307       assign
      308         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      309       .
      310     end.
      311     assign
      312       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      313     .
      314     return v-doc-code-int64 .
      315   end. // function/method
      316   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   define new global shared variable g#trdcalib as handle no-undo.
      318   define shared variable g#auto-user-id as character no-undo .
      319   define input  parameter table for  TempTrnDoc.
      320   define input  parameter table for  TempDocLine.
      321   define input  parameter table for  TempDocPart.
      322   define input  parameter table for  TempDocMark.
      323   define input  parameter userId_ as character no-undo.
      324   define variable iDbNum as integer no-undo.
      325   MAIN-BLOCK:
      326   do:
      327     define variable num-rec-ok as logical no-undo.
      328     define variable ii         as integer no-undo.
      329     define variable logWrite   as class   LogWrite no-undo.
      330     define variable v-doc-code as character no-undo.
      331     logWrite = new LogWrite().
      332     empty temp-table temp_trn-doc.
      333     empty temp-table temp_doc-line.
      334     empty temp-table temp_doc-mark.
      335     for each TempTrnDoc no-lock:
      336       ii = ii + 1.
      337       if TempTrnDoc.ext-doc-code = ? or TempTrnDoc.ext-doc-code = ""
      338       then do:
      339         run doc-code in this-procedure
      340           ( input  "main":U,
      341             input  TempTrnDoc.obj-type,
      342             input  TempTrnDoc.obj-code,
      343             input  ? ,
      344             output TempTrnDoc.ext-doc-code ) no-error.
      345       end.
      346       create temp_trn-doc.
      347       assign
      348         temp_trn-doc.line-num      = ii
      349         temp_trn-doc.doc-date      = TempTrnDoc.doc-date
      350         temp_trn-doc.ps            = TempTrnDoc.ps
      351         temp_trn-doc.doc-code      = TempTrnDoc.ext-doc-code
      352         temp_trn-doc.ext-doc-type  = TempTrnDoc.ext-doc-type
      353         temp_trn-doc.cli-type      = TempTrnDoc.cli-type
      354         temp_trn-doc.cli-code      = TempTrnDoc.cli-code
      355         temp_trn-doc.obj-type      = TempTrnDoc.obj-type
      356         temp_trn-doc.obj-code      = TempTrnDoc.obj-code
      357         temp_trn-doc.exch-code     = 0
      358         temp_trn-doc.exch-rate     = 1
      359         temp_trn-doc.exch-scale    = 1
      360         temp_trn-doc.contract-code = if TempTrnDoc.dog-code <> ? then integer (TempTrnDoc.dog-code) else 0
      361         temp_trn-doc.price-type    = if TempTrnDoc.ext-doc-type = 'ee':U then "TSFTSD" else ""
      362         temp_trn-doc.doc-code      = TempTrnDoc.ext-doc-code
      363         temp_trn-doc.doc-id        = TempTrnDoc.doc-id
      364         .
      365       if TempTrnDoc.source-doc ne ? and TempTrnDoc.source-doc ne ""
      366       then do:
      367         find first ub.doc-attr no-lock where ub.doc-attr.attr-code = 'nids':U and ub.doc-attr.attr-value = TempTrnDoc.source-doc no-error.
      368         find first ub.trn-doc no-lock where ub.trn-doc.doc-code = ub.doc-attr.doc-code no-error.
      369         if available (ub.doc-attr) and available (ub.trn-doc)
      370         then do:
      371           assign
      372             temp_trn-doc.cli-type = ub.trn-doc.cli-type
      373             temp_trn-doc.cli-code = ub.trn-doc.cli-code
      374             temp_trn-doc.out-code = ub.doc-attr.doc-code
      375             temp_trn-doc.contract-code = ub.trn-doc.contract-code.
      376         end.
      377         else do:
      378           if error-status:error
      379             then return error "Не найдена накладная-источник внешней системы с ИД  - " + TempTrnDoc.source-doc .
      380         end.
      381       end.
      382     end.
      383     for each TempDocLine no-lock:
      384       create temp_doc-line.
      385       assign
      386         temp_doc-line.line-num     = TempDocLine.line-num
      387         temp_doc-line.gds-code     = TempDocLine.gds-code
      388         temp_doc-line.fact-qnty    = TempDocLine.fact-qnty
      389         temp_doc-line.doc-qnty     = TempDocLine.doc-qnty
      390         temp_doc-line.price-cli    = TempDocLine.price-rubl
      391         temp_doc-line.price-rubl   = TempDocLine.price-rubl
      392         temp_doc-line.doc-code     = temp_trn-doc.doc-code
      393         temp_doc-line.doc-density  = TempDocLine.fact-dnsty
      394         temp_doc-line.fact-density = TempDocLine.fact-dnsty
      395         temp_doc-line.cli-qnty     = TempDocLine.cli-qnty
      396         temp_doc-line.part-id      = TempDocLine.part-id
      397         temp_doc-line.vsd-uuid     = TempDocLine.vsd-uuid
      398         temp_doc-line.vat-pc       = TempDocLine.vat-pc
      399         .
      400     end.
      401     for each TempDocMark no-lock:
      402       create temp_doc-mark.
      403       assign
      404         temp_doc-mark.part-id  = TempDocMark.prt-id
      405         temp_doc-mark.mark     = TempDocMark.mark
      406         temp_doc-mark.gds-code = TempDocMark.gds-code
      407         temp_doc-mark.gtin     = TempDocMark.gtin
      408         temp_doc-mark.gtin_qnt = TempDocMark.gtin_qnt
      409         temp_doc-mark.upd_id   = TempDocMark.upd_id
      410       .
      411     end.
      412   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      414     (output iDbNum
      415     )  .
      416     find first temp_doc-line where temp_doc-line.fact-density > 0 no-error.
      417     if available (temp_doc-line)
      418     then do:
      419       run utl/ora-i517.p (
      420         input this-procedure ,
      421         input this-procedure ,
      422         input table temp_trn-doc ,
      423         input table temp_doc-line ,
      424         output v-doc-code,
      425         output num-rec-ok
      426         ) no-error .
      427       if error-status:error
      428         then return error return-value.
      429     end.
      430     else do:
      431       find first TempTrnDoc .
      432       if TempTrnDoc.ext-doc-type = 'iv':U
      433       or TempTrnDoc.ext-doc-type = 'rv':U
      434       then do :
      435         run utl/trndocmv-1c.p (
      436           input this-procedure ,
      437           input table TempTrnDoc ,
      438           input table TempDocLine ,
      439           input table TempDocPart ,
      440           input table TempDocMark
      441           ) no-error .
      442         if error-status:error
      443           then return error return-value.
      444         return .
      445       end .
      446       else do :
      447         run utl/ora-i516-1c.p (
      448           input this-procedure ,
      449           input this-procedure ,
      450           input table temp_trn-doc ,
      451           input table temp_doc-line ,
      452           input table temp_doc-mark ,
      453           output v-doc-code,
      454           output num-rec-ok
      455           ) no-error .
      456         if error-status:error
      457           then return error return-value.
      458       end .
      459     end.
      460     find first ub.trn-doc no-lock where ub.trn-doc.doc-code  = v-doc-code no-error.
      461     case ub.trn-doc.ext-doc-type:
      462       when 'ie':U then do:
      463         if ub.trn-doc.cli-type = 'маг'
      464         then do:
      465           disable triggers for load of ub.trn-doc.
      466           find current ub.trn-doc exclusive-lock .
      467           ub.trn-doc.ext-doc-type = 'iv':U.
      468           ub.trn-doc.internal = true.
      469           ub.trn-doc.discnt-type = 'процент':U.
      470         end.
      471       end.
      472       when 're':U then do:
      473         if ub.trn-doc.cli-type = 'маг'
      474         then do:
      475           disable triggers for load of ub.trn-doc.
      476           find current ub.trn-doc exclusive-lock .
      477           ub.trn-doc.ext-doc-type = 'rv':U.
      478           ub.trn-doc.internal = true.
      479           ub.trn-doc.discnt-type = 'процент':U.
      480         end.
      481       end.
      482     end case.
      483     if ub.trn-doc.ext-doc-type = 'iv':U
      484     then do:
      485   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input ub.trn-doc.doc-code ,
      486                          input 'othermoves':U ,
      487                          input yes ) no-error .
      488        if error-status:error
      489           then return error return-value.
      490     end.
      491   end.
      492   procedure pcall-log-file:
      493     define input parameter msg as character no-undo.
      494     assign
      495       LogWrite:LogStr = LogWrite:LogStr + chr(10) + msg
      496       .
      497   end.
      498   procedure get-db-num:
      499     define output parameter pDbNum as integer no-undo.
      500     pDbNum = iDbNum.
      501   end.
      502   procedure get-userid:
      503     define output parameter pUserId as character no-undo.
      504     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = userId_ no-error.
      505     if available ub.user-login
      506     then
      507     do:
      508       assign
      509         pUserId  = userId_
      510         .
      511     end.
      512     else
      513     do:
      514       assign
      515         pUserId = g#auto-user-id
      516         userId_ = g#auto-user-id
      517         .
      518     end.
      519   end.
      520   procedure mainmenu_getcntxt :
      521   define output parameter p-cntxt-db-num                as integer   no-undo .
      522   define output parameter p-cntxt-userid                as character no-undo .
      523   define output parameter p-cntxt-level                 as character no-undo .
      524   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
      525   define output parameter p-cntxt-obj-type              as character no-undo .
      526   define output parameter p-cntxt-obj-code              as integer   no-undo .
      527   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
      528   define output parameter p-cntxt-is-admin              as logical   no-undo .
      529     do
      530     on error undo, return error return-value
      531     :
      532     define variable vt-host-code as integer   no-undo .
      533     find first temp_trn-doc no-error.
      534   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      536     (input  temp_trn-doc.obj-type
      537     ,input  temp_trn-doc.obj-code
      538     ,output p-cntxt-db-num-obj
      539     )  .
      540   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      542     (input  temp_trn-doc.obj-type
      543     ,input  temp_trn-doc.obj-code
      544     ,output vt-host-code
      545     )  .
      546     assign
      547       p-cntxt-db-num          =  p-cntxt-db-num-obj
      548       p-cntxt-userid          =  userId_
      549       p-cntxt-level           =  v-cntxt-level
      550       p-cntxt-host-code-obj   =  vt-host-code
      551       p-cntxt-obj-type        =  temp_trn-doc.obj-type
      552       p-cntxt-obj-code        =  temp_trn-doc.obj-code
      553       p-cntxt-is-admin        =  v-cntxt-is-admin
      554     .
      555     end.
      556   end procedure.
