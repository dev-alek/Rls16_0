      209   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      210     define variable v-cntxt-db-num        as integer   no-undo .
      211     define variable v-cntxt-userid        as character no-undo .
      212     define variable v-cntxt-level         as character no-undo .
      213     define variable v-cntxt-host-code-obj as integer   no-undo .
      214     define variable v-cntxt-obj-type      as character no-undo .
