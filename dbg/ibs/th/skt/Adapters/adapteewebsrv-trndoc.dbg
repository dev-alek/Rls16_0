        1   block-level on error undo, throw.
        2   using ibs.th.skt.*.
        3   using ibs.th.skt.Adapters.*.
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define new global shared variable g#library  as handle no-undo .
        9   define new global shared variable g#library2 as handle no-undo .
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   define temp-table temp_trn-doc no-undo
       12   field line-num as integer
       13   field doc-code as character
       14   field doc-date as date
       15   field ext-doc-type as character
       16   field cli-type as character
       17   field cli-code as integer
       18   field obj-type as character
       19   field obj-code as integer
       20   field wrkr as integer
       21   field agnt as integer
       22   field boss as integer
       23   field creid as character
       24   field ps as character
       25   field host-code as integer
       26   field contract-code as integer
       27   field pay-code   as integer
       28   field reason-code   as integer
       29   field exch-code  as integer
       30   field exch-rate  as decimal
       31   field exch-scale as integer
       32   field vat-type as character
       33   field price-type as character
       34   field cargo-from as character
