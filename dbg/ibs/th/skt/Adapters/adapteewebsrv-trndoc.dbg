      148   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149     define variable v-cntxt-db-num        as integer   no-undo .
      150     define variable v-cntxt-userid        as character no-undo .
      151     define variable v-cntxt-level         as character no-undo .
      152     define variable v-cntxt-host-code-obj as integer   no-undo .
      153     define variable v-cntxt-obj-type      as character no-undo .
      154     define variable v-cntxt-obj-code      as integer   no-undo .
      155     define variable v-cntxt-db-num-obj    as integer   no-undo .
      156     define variable v-cntxt-is-admin      as logical   no-undo .
      157   define shared variable g#auto-user-id as character no-undo .
      158   define input  parameter table for  TempTrnDoc.
      159   define input  parameter table for  TempDocLine.
      160   define input  parameter table for  TempDocAttr.
      161   define input  parameter table for  TempGdsDtl.
      162   define input  parameter table for  TempParts.
      163   define output parameter ERROR_ as logical no-undo .
      164   define variable iDbNum as integer no-undo.
      165   MAIN-BLOCK:
      166   do:
      167     define variable num-rec-ok as logical no-undo.
      168     define variable logWrite   as class   LogWrite no-undo.
      169     logWrite = new LogWrite().
      170     for each TempTrnDoc no-lock:
      171       create temp_trn-doc.
      172       assign
      173         temp_trn-doc.doc-date      = TempTrnDoc.doc-date
      174         temp_trn-doc.ps            = TempTrnDoc.ps
      175         temp_trn-doc.doc-code      = TempTrnDoc.SuppInDocNo
      176         temp_trn-doc.ext-doc-type  = TempTrnDoc.ext-doc-type
      177         temp_trn-doc.cli-type      = TempTrnDoc.cli-type
      178         temp_trn-doc.cli-code      = TempTrnDoc.cli-code
      179         temp_trn-doc.obj-type      = TempTrnDoc.obj-type
      180         temp_trn-doc.obj-code      = TempTrnDoc.obj-code
      181         temp_trn-doc.exch-code     = 0
      182         temp_trn-doc.exch-rate     = 1
      183         temp_trn-doc.exch-scale    = 1
      184         temp_trn-doc.contract-code = TempTrnDoc.ContractID
      185         temp_trn-doc.price-type    = ""
      186         temp_trn-doc.agnt          = TempTrnDoc.agnt
      187         temp_trn-doc.wrkr          = TempTrnDoc.wrkr
      188         temp_trn-doc.boss          = TempTrnDoc.boss
      189         temp_trn-doc.creid         = TempTrnDoc.user-id
      190         temp_trn-doc.vat-type      = TempTrnDoc.vat-type
      191         temp_trn-doc.pay-code      = TempTrnDoc.pay-code
      192         temp_trn-doc.reason-code   = TempTrnDoc.reason-code
      193         temp_trn-doc.stts          = TempTrnDoc.stts
      194         temp_trn-doc.hold-obj-type = TempTrnDoc.hold-obj-type
      195         temp_trn-doc.hold-obj-code = TempTrnDoc.hold-obj-code
      196         temp_trn-doc.ship-num      = TempTrnDoc.ship-num
      197         temp_trn-doc.ship-date     = TempTrnDoc.ship-date
      198         .
      199         for each TempDocLine no-lock where TempDocLine.SuppInDocNo = TempTrnDoc.SuppInDocNo :
      200           create temp_doc-line.
      201           assign
      202             temp_doc-line.line-num   = TempDocLine.line-num
      203             temp_doc-line.gds-code   = TempDocLine.gds-code
      204             temp_doc-line.fact-qnty  = TempDocLine.doc-qnty
      205             temp_doc-line.doc-qnty   = TempDocLine.doc-qnty
      206             temp_doc-line.price-cli  = TempDocLine.price-rubl
      207             temp_doc-line.price-rubl = TempDocLine.price-rubl
      208             temp_doc-line.vat-pc     = TempDocLine.vat-pc
      209             temp_doc-line.doc-code   = temp_trn-doc.doc-code
      210             .
      211         end.
      212     end.
      213   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      214   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      215     (output iDbNum
      216     )  .
      217     run utl/websrv_trn-doc.p (
      218       input this-procedure ,
      219       input this-procedure ,
      220       input table temp_trn-doc ,
      221       input table temp_doc-line ,
      222       input table TempGdsDtl ,
      223       input table TempParts ,
      224       input table TempDocAttr ,
      225       output num-rec-ok,
