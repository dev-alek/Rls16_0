      229   procedure pcall-log-file:
      230     define input parameter msg as character no-undo.
      231     assign
      232       LogWrite:LogStr = LogWrite:LogStr + chr(10) + msg
      233       .
      234   end.
      235   procedure get-db-num:
      236     define output parameter pDbNum as integer no-undo.
      237     pDbNum = iDbNum.
      238   end.
      239   procedure get-userid:
      240     define output parameter pUserId as character no-undo.
      241     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = temp_trn-doc.creid no-error.
      242     if available ub.user-login
      243     then
      244     do:
      245       assign
      246         pUserId  = temp_trn-doc.creid
      247         .
      248     end.
      249     else
      250     do:
      251       assign
      252         pUserId = g#auto-user-id
      253         .
      254     end.
      255   end.
      256   procedure mainmenu_getcntxt :
      257   define output parameter p-cntxt-db-num                as integer   no-undo .
      258   define output parameter p-cntxt-userid                as character no-undo .
      259   define output parameter p-cntxt-level                 as character no-undo .
      260   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
      261   define output parameter p-cntxt-obj-type              as character no-undo .
      262   define output parameter p-cntxt-obj-code              as integer   no-undo .
      263   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
      264   define output parameter p-cntxt-is-admin              as logical   no-undo .
      265     do
      266     on error undo, return error return-value
      267     :
      268     define variable vt-host-code as integer   no-undo .
      269     find first temp_trn-doc no-error.
      270   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      272     (input  temp_trn-doc.obj-type
      273     ,input  temp_trn-doc.obj-code
      274     ,output p-cntxt-db-num-obj
      275     )  .
      276   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      277   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      278     (input  temp_trn-doc.obj-type
      279     ,input  temp_trn-doc.obj-code
      280     ,output vt-host-code
      281     )  .
      282     assign
      283       p-cntxt-db-num          =  p-cntxt-db-num-obj
      284       p-cntxt-userid          =  temp_trn-doc.creid
      285       p-cntxt-level           =  v-cntxt-level
      286       p-cntxt-host-code-obj   =  vt-host-code
      287       p-cntxt-obj-type        =  temp_trn-doc.obj-type
      288       p-cntxt-obj-code        =  temp_trn-doc.obj-code
      289       p-cntxt-is-admin        =  v-cntxt-is-admin
      290     .
      291     end.
      292   end procedure.
