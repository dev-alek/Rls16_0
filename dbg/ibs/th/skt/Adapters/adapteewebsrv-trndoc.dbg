      100     define temp-table TempDocLine no-undo
      101       field SuppInDocNo  as character
      102       field line-num     as integer
      103       field gds-code     as integer
      104       field doc-qnty     as decimal
      105       field fact-qnty    as decimal
      106       field price-rubl   as decimal
