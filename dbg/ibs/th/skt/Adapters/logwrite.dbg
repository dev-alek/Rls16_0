        1   using Progress.Lang.*.
        2   block-level on error undo, throw.
        3   class ibs.th.skt.Adapters.LogWrite:
        4     define public static property isDebugMod as logical init yes
        5     get.
        6     set.
        7     define public property LogStr as character no-undo
        8       get ():
        9         def var str as char no-undo.
       10         run ibs/th/skt/Adapters/GetLogStrProc.p (output str).
       11         return str.
       12       end  .
       13       set (str as char):
       14         run ibs/th/skt/Adapters/SetLogStrProc.p (input str).
       15       end.
       16       method public void WriteDebugLog(ifile as char) :
       17         if isDebugMod
       18         then
       19            WriteFileToLog (ifile).
       20       end.
       21       method public void WriteDebugLog(iText as longchar) :
       22         if isDebugMod
       23         then
       24            WriteFileToLog (iText).
       25       end.
       26       method public void WriteFileToLog(ifile as char, icodepage as char) :
       27         run ibs/th/skt/Adapters/WriteFileToLog.p (ifile,icodepage).
       28       end.
       29       method public void WriteFileToLog(ifile as char) :
       30         run ibs/th/skt/Adapters/WriteFileToLog.p (ifile,?).
       31       end.
       32       method public void WriteFileToLog(iText as longchar) :
       33          if length (iText) < 1000
       34          then do:
       35             define variable vTempStr as character no-undo.
       36             vTempStr = iText.
       37             WriteFileToLog(vTempStr).
       38          end.
       39          else do:
       40             os-delete "filewrireLog.txt".
       41             copy-lob iText to
       42                      file "filewrireLog.txt".
       43             WriteFileToLog ("filewrireLog.txt").
       44          end.
       45       end.
       46   end class.
