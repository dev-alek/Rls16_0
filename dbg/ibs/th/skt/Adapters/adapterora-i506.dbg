        1   using Progress.Lang.*.
        2   using ibs.th.skt.Adapters.*.
        3   block-level on error undo, throw.
        4   class ibs.th.skt.Adapters.AdapterOra-i506 implements IAdapter:
        5   define temp-table TempTrnDoc no-undo
        6     field line-num     as integer
        7     field ext-doc-code as character
        8     field doc-date     as date
        9     field ext-doc-type as character
       10     field cli-type     as character
       11     field cli-code     as integer
       12     field obj-type     as character
       13     field obj-code     as integer
       14     field ps           as character
       15     field Status_      as character
       16     field Flags_       as integer
       17     index pi line-num ext-doc-code .
       18   define temp-table TempDocLine no-undo
       19     field line-num     as integer
       20     field gds-code     as integer
       21     field doc-qnty     as decimal
       22     field fact-qnty    as decimal
       23     field price-rubl   as decimal
       24     field RowSum       as decimal
       25     field vat-pc       as decimal
       26     field b-code       as character
       27     field is-tsd-qnty  as logical   init no
       28     field aclMarksList as character
       29     field PartIDTH     as character
       30     field Flags_       as integer
       31     field NotDict      as logical
       32     index pi
       33     line-num
       34     gds-code
       35     .
       36   define temp-table TempDocLineIsTSD like TempDocLine.
       37   define temp-table TempDocLineTSD no-undo
       38     field gds-code     as integer
       39     field doc-qnty     as decimal
       40     field fact-qnty    as decimal
       41     field artic        as character
       42     field prod-code    as integer
       43     field prod-type    as character
       44     field Flags_error  as logical
       45     field mark-type    as character
       46     field mark         as character
       47     field mark-parent  as character
       48     index pi
       49     artic
       50     prod-code
       51     prod-type
       52     mark
       53     .
       54   define temp-table TempMarkLine no-undo
       55     field DocName    as character
       56     field MarkCode   as character
       57     field PartIDTH   as character
       58     field Sts        as character
       59     field MarkParent as character
       60     field QntyBox    as character
       61     index pi
       62     DocName
       63     MarkCode
       64     .
       65     define temp-table TempTSDSetting no-undo
       66     field sn   as character
       67     field obj-code  as integer
       68     field obj-type as character
       69     field version_ as character
       70     field lastDate as datetime
       71     index pi
       72     sn
       73     .
       74     define property StrLog as character no-undo
       75       get.
       76       set.
       77     define property UserId_ as character no-undo
       78       get.
       79       set.
       80     method public void WriteDB (output glog as log):
       81       run ibs/th/skt/Adapters/AdapteeProcOra-i506.p
       82         (
       83         input table TempTrnDoc,
       84         input table TempDocLine,
       85         input UserId_
       86         ) no-error.
       87       if error-status:error then
       88       do:
       89         assign
       90           StrLog = return-value
       91           .
       92         glog = false.
       93       end.
       94       else
       95         glog = true.
       96     end method.
       97     method public void SetTempTable (input table TempTrnDoc, input table TempDocLine, input userId_ as char):
       98       UserId_ = userId_.
       99     end method.
      100   end class.
