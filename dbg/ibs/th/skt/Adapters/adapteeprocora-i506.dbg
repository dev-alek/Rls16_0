        1   block-level on error undo, throw.
        2   using ibs.th.skt.*.
        3   using ibs.th.skt.Adapters.*.
        4   define new global shared variable g#library  as handle no-undo .
        5   define new global shared variable g#library2 as handle no-undo .
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   define temp-table temp_trn-doc no-undo
        8   field line-num as integer
        9   field doc-code as character
       10   field doc-date as date
       11   field ext-doc-type as character
       12   field cli-type as character
       13   field cli-code as integer
       14   field obj-type as character
       15   field obj-code as integer
       16   field wrkr as integer
       17   field agnt as integer
       18   field boss as integer
       19   field creid as character
       20   field ps as character
       21   field host-code as integer
       22   field contract-code as integer
       23   index pi line-num doc-code .
       24   define temp-table temp_gds-line no-undo
       25   field line-num    as integer
       26   field doc-code    as character
       27   field gds-code    as integer
       28   field line-qnty        as integer
       29   index pi
       30   doc-code
       31   line-num
       32   gds-code
       33   .
       34   define temp-table temp_grp-line no-undo
       35   field line-num    as integer
       36   field doc-code    as character
       37   field depart-code   as integer
       38   field class-code    as integer
       39   field subclass-code as integer
       40   index pi
       41   doc-code
       42   line-num
       43   depart-code
       44   class-code
       45   subclass-code
       46   .
       47   define temp-table tt-marks
       48       field exciseMark   as character label "Марка"    format "X(150)"
       49       field alc-code     as character label "Алк. код" format "X(20)"
       50       field artic        as character label "Артикл"   format "X(20)"
       51       field prod-type    as character
       52       field prod-code    as integer
       53       field gds-code     as integer
       54       field doc-code     as character
       55       field partID       as character
       56       field refB         as character
       57       field rowid-part   as rowid
       58       field line-num     as integer
       59       field isCurr       as logical
       60       index pi as primary unique
       61           exciseMark
       62   .
       63   define temp-table tt-alc-qnty
       64       field artic        as character label "Артикл"   format "X(20)"
       65       field prod-type    as character
       66       field prod-code    as integer
       67       field gds-code     as integer
       68       field alc-code     as character label "Алк. код" format "X(20)"
       69       field qnty         as integer   label "Кол."
       70       field isCurr       as logical
       71       index pi as primary unique
       72           artic prod-type prod-code alc-code
       73   .
       74   define temp-table TempTrnDoc no-undo
       75     field line-num     as integer
       76     field ext-doc-code as character
       77     field doc-date     as date
       78     field ext-doc-type as character
       79     field cli-type     as character
       80     field cli-code     as integer
       81     field obj-type     as character
       82     field obj-code     as integer
       83     field ps           as character
       84     field Status_      as character
       85     field Flags_       as integer
       86     index pi line-num ext-doc-code .
       87   define temp-table TempDocLine no-undo
       88     field line-num     as integer
       89     field gds-code     as integer
       90     field doc-qnty     as decimal
       91     field fact-qnty    as decimal
       92     field price-rubl   as decimal
       93     field RowSum       as decimal
       94     field vat-pc       as decimal
       95     field b-code       as character
       96     field is-tsd-qnty  as logical   init no
       97     field aclMarksList as character
       98     field PartIDTH     as character
       99     field Flags_       as integer
      100     field NotDict      as logical
      101     index pi
      102     line-num
      103     gds-code
      104     .
      105   define temp-table TempDocLineIsTSD like TempDocLine.
      106   define temp-table TempDocLineTSD no-undo
      107     field gds-code     as integer
      108     field doc-qnty     as decimal
      109     field fact-qnty    as decimal
      110     field artic        as character
      111     field prod-code    as integer
      112     field prod-type    as character
      113     field Flags_error  as logical
      114     field mark-type    as character
      115     field mark         as character
      116     field mark-parent  as character
      117     index pi
      118     artic
      119     prod-code
      120     prod-type
      121     mark
      122     .
      123   define temp-table TempMarkLine no-undo
      124     field DocName    as character
      125     field MarkCode   as character
      126     field PartIDTH   as character
      127     field Sts        as character
      128     field MarkParent as character
      129     field QntyBox    as character
      130     index pi
      131     DocName
      132     MarkCode
      133     .
      134     define temp-table TempTSDSetting no-undo
      135     field sn   as character
      136     field obj-code  as integer
      137     field obj-type as character
      138     field version_ as character
      139     field lastDate as datetime
      140     index pi
      141     sn
      142     .
      143   define shared variable g#auto-user-id as character no-undo .
      144   define input  parameter table for  TempTrnDoc.
      145   define input  parameter table for  TempDocLine.
      146   define input  parameter table for  tt-marks.
      147   define input  parameter userId_ as character no-undo.
      148   define variable iDbNum as integer no-undo.
      149   MAIN-BLOCK:
      150   do:
      151     define variable num-rec-ok as logical no-undo.
      152     define variable ii         as integer no-undo.
      153     define variable logWrite   as class   LogWrite no-undo.
      154     logWrite = new LogWrite().
      155     for each TempTrnDoc no-lock:
      156       ii = ii + 1.
      157       create temp_trn-doc.
      158       assign
      159         temp_trn-doc.line-num      = ii
      160         temp_trn-doc.doc-date      = TempTrnDoc.doc-date
      161         temp_trn-doc.ps            = TempTrnDoc.ps
      162         temp_trn-doc.ext-doc-type  = TempTrnDoc.ext-doc-type
      163         temp_trn-doc.doc-code      = TempTrnDoc.ext-doc-code
      164         temp_trn-doc.cli-type      = TempTrnDoc.cli-type
      165         temp_trn-doc.cli-code      = TempTrnDoc.cli-code
      166         temp_trn-doc.obj-type      = TempTrnDoc.obj-type
      167         temp_trn-doc.obj-code      = TempTrnDoc.obj-code
      168         temp_trn-doc.contract-code = ?
      169         .
      170       for each TempDocLine no-lock:
      171         create temp_gds-line.
      172         assign
      173           temp_gds-line.doc-code   = TempTrnDoc.ext-doc-code
      174           temp_gds-line.line-num   = TempDocLine.line-num
      175           temp_gds-line.gds-code   = TempDocLine.gds-code
      176           temp_gds-line.line-qnty  = TempDocLine.fact-qnty
      177           .
      178       end.
      179     end.
      180   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      182     (output iDbNum
      183     )  .
      184     run utl/ora-i506.p (
      185       input this-procedure ,
      186       input this-procedure ,
      187       input table temp_trn-doc ,
      188       input table temp_gds-line ,
      189       input table temp_grp-line ,
      190       input table tt-marks ,
      191       output num-rec-ok
      192       ) no-error .
      193     if error-status:error
      194       then return error return-value.
      195   end.
      196   procedure pcall-log-file:
      197     define input parameter msg as character no-undo.
      198     assign
      199       LogWrite:LogStr = msg
      200       .
      201   end.
      202   procedure get-db-num:
      203     define output parameter pDbNum as integer no-undo.
      204     pDbNum = iDbNum.
      205   end.
      206   procedure get-userid:
      207     define output parameter pUserId as character no-undo.
      208     find first ub.user-login where ub.user-login.db-num = iDbNum and ub.user-login.user-id = userId_ no-error.
      209     if available ub.user-login
      210     then
      211     do:
      212       assign
      213         pUserId  = userId_
      214         .
      215     end.
      216     else
      217     do:
      218       assign
      219         pUserId = g#auto-user-id
      220         userId_ = g#auto-user-id
      221         .
      222     end.
      223   end.
