        1   using Progress.Lang.*.
        2   using ibs.th.gbl.sys.objth.
        3   using ibs.th.gbl.map.ParamColection.
        4   block-level on error undo, throw.
        5   class ibs.th.skt.HeadHttp inherits objth:
        6      define override public property vss-revision    as character no-undo init "$Revision:$":U get .
        7      define override public property vss-author      as character no-undo init "$Author:$":U get.
        8      define override public property vss-date        as character no-undo init "$Date:$":U get.
        9      define override public property vss-workfile    as character no-undo init "$Workfile:$":U get.
       10      define override public property vss-archive     as character no-undo init "$Archive:$":U get.
       11      define override public property vss-description as character no-undo init "Заголовок НТТP запроса" get.
       12      define public property queryPar as character no-undo get.
       13      set.
       14      define public property queryAdr as character no-undo get.
       15      set.
       16      define public property queryReq as character no-undo get.
       17      set (arg as character ):
       18         queryReq = arg.
       19         define variable vPosPar as integer no-undo.
       20         vPosPar = index(arg,"?").
       21         if vPosPar eq 0
       22         then
       23            assign
       24               queryPar = ""
       25               queryAdr = trim(arg,"/")
       26            .
       27         else
       28            assign
       29               queryAdr = trim(substring (arg, 1, vPosPar - 1), "/")
       30               queryPar =      substring (arg,    vPosPar + 1).
       31      end.
       32      define public property contentLength as int64     no-undo get. set.
       33      define public property userAgent     as character no-undo get. set.
       34      define public property contentType   as character no-undo get. set.
       35      define variable paramCol as ParamColection no-undo.
       36      define variable queryParamCol as ParamColection no-undo.
       37      constructor public HeadHttp (  ):
       38         super ().
       39         paramCol      = new ParamColection().
       40      end constructor.
       41      constructor public HeadHttp (iHeader as character):
       42         this-object().
       43         parshead(iHeader).
       44      end constructor.
       45            method public void parshead (iHeader as character) :
       46         define variable idxQuerypar as integer no-undo.
       47         queryReq = entry(2,iHeader, " ") no-error.
       48         define variable i as integer no-undo.
       49         define variable v-hd-line as character no-undo.
       50         iHeader = replace (iHeader,";",chr(13) + chr(10)).
       51         do i = 2 to num-entries(iHeader,chr(13) + chr(10)):
       52            v-hd-line = trim(entry(i,iHeader,chr(13) + chr(10))).
       53            if num-entries (v-hd-line,":") eq 2
       54            then do:
       55               if  v-hd-line  begins "Content-Length"  then  do:
       56                   contentLength = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
       57               end.
       58               else if  v-hd-line  begins "content-type:"  then  do:
       59                  contentType = trim(substring(v-hd-line,14,length(v-hd-line))).
       60               end.
       61               else if  v-hd-line  begins "user-agent:"  then  do:
       62                  userAgent = trim(substring(v-hd-line,13,length(v-hd-line))).
       63               end.
       64               else do:
       65                  paramCol:setParam(entry(1,v-hd-line,":"), trim (entry(2,v-hd-line,":")," ")).
       66               end.
       67            end.
       68         end.
       69      end.
       70      method public character getValue(iParam as char):
       71         return paramCol:getValue(iParam).
       72      end method.
       73      method public void setParam(iParam as char, iValue as char):
       74         paramCol:setParam(iParam, iValue).
       75      end method.
       76      method public character getQueryParam(iParam as char):
       77         define variable vi as integer no-undo.
       78         define variable par as character no-undo.
       79         define variable val as character no-undo.
       80         define variable str as character no-undo.
       81         if not valid-object (queryParamCol)
       82         then do:
       83            queryParamCol = new ParamColection().
       84            do vi = 1 to num-entries (QueryPar,"&"):
       85               assign
       86                 str = entry (vi, QueryPar, "&")
       87                 par = entry (1, str, "=")
       88                 val = if num-entries (str,"=") > 1 then entry (2, str, "=") else ""
       89               no-error.
       90               queryParamCol:setParam(par, Val).
       91            end.
       92         end.
       93         return queryParamCol:getValue(iParam).
       94      end method.
       95      method private void setQueryParam(iParam as char, iValue as char):
       96         queryParamCol:setParam(iParam, iValue).
       97      end method.
       98           destructor public HeadHttp ( ):
       99         delete object paramCol no-error.
      100           end destructor.
      101   end class.
