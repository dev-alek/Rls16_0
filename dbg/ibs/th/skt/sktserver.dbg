        1   using Progress.Lang.*.
        2   using ibs.th.skt.Commands.*.
        3   using ibs.th.skt.ControlledClients.*.
        4   using ibs.th.skt.*.
        5   using ibs.th.skt.Adapters.*.
        6   block-level on error undo, throw.
        7   class ibs.th.skt.SktServer:
        8     define private variable clientControl as class     ClientControl no-undo.
        9     define private variable hLog          as handle no-undo.
       10     define public property LogMsg as character no-undo
       11       get.
       12       set.
       13     define private variable logWrite as class   LogWrite no-undo.
       14     define variable us-tmo           as integer   init 180 no-undo.
       15     constructor SktServer (  ):
       16        this-object(?).
       17     end.
       18     constructor SktServer (iLog as handle ,iUstmo as integer ):
       19         this-object(iLog).
       20         us-tmo = iUstmo.
       21     end.
       22     constructor SktServer (iLog as handle ):
       23            hLog = iLog.
       24       define variable conf-par   as character no-undo .
       25       define variable par-type   as character no-undo .
       26       define variable tsdCommand    as class TSDCommand.
       27       define variable tickedCommand as class TickedCommand.
       28       define variable tmCommand     as class TableMenuCommand.
       29       define variable kioskCommand  as class KioskCommand.
       30       define variable webCommand    as class webCommand.
       31       define variable atdclientcmd  as class atdclientcmd.
       32       define variable THGetInfoCmd  as class THGetInfoCmd.
       33       define variable AuthMarking   as class markingcmd.
       34       define variable DeferredCommand   as class DeferredCommand.
       35       define variable CashSend      as class CashSend.
       36       define variable FileSend      as class FileSend.
       37       define variable HelpSkt       as class HelpSkt.
       38       clientControl = new ClientControl(hLog).
       39       logWrite = new LogWrite().
       40       run gbl/conf-rd.p ("ser-wth", "", "", 0, "", "", "", no, output conf-par, output par-type) no-error.
       41       if not error-status:error  and logical (conf-par) then do:
       42         tickedCommand = new TickedCommand().
       43         clientControl:SetCommandForClient("Ticked", tickedCommand).
       44       end.
       45       tmCommand = new TableMenuCommand().
       46       clientControl:SetCommandForClient("TableMenu", tmCommand).
       47       run gbl/conf-rd.p ("is-byscr", "", "", 0, "", "", "", no, output conf-par, output par-type) no-error.
       48       if  not error-status:error  and logical (conf-par) then do:
       49         kioskCommand = new KioskCommand().
       50         clientControl:SetCommandForClient("kiosk", kioskCommand).
       51       end.
       52       run gbl/conf-rd.p ("is-wbsrv", "", "", 0, "", "", "", no, output conf-par, output par-type) no-error.
       53       if  not error-status:error  and logical (conf-par) then do:
       54         webCommand = new webCommand().
       55         clientControl:SetCommandForClient("websrv", webCommand).
       56       end.
       57       atdclientcmd = new atdclientcmd ().
       58       clientControl:SetCommandForClient("atdclient", atdclientcmd).
       59       THGetInfoCmd = new THGetInfoCmd ().
       60       clientControl:SetCommandForClient("ThGetInfo", THGetInfoCmd).
       61       AuthMarking = new markingcmd ().
       62       clientControl:SetCommandForClient("AuthMarking", AuthMarking).
       63       DeferredCommand = new DeferredCommand ().
       64       clientControl:SetCommandForClient("DeferredCommand", DeferredCommand).
       65       CashSend = new CashSend (hLog).
       66       clientControl:SetCommandForClient("CashSend", CashSend).
       67       FileSend = new FileSend ().
       68       clientControl:SetCommandForClient("FileSend", FileSend).
       69       run gbl/conf-rd.p ("is-tsd", "", "", 0, "", "", "", no, output conf-par, output par-type) no-error.
       70       if not error-status:error  and  logical (conf-par) then do:
       71         tsdCommand = new TSDCommand(FileSend).
       72         clientControl:SetCommandForClient("TSD", tsdCommand).
       73       end.
       74       HelpSkt = new HelpSkt ().
       75       clientControl:SetCommandForClient("Help", HelpSkt).
       76     end constructor.
       77      method public void RequestProcessing (HeadHttp as HeadHttp, content as memptr, hndlSocket as handle):
       78         define variable req           as class     IRequest      no-undo.
       79         define variable resp          as class     IResponse     no-undo.
       80         define variable client_       as character no-undo.
       81         define variable vDelete as logical no-undo.
       82         req = new SimpleRequest(HeadHttp).
       83         resp = new SimpleResponse().
       84         req:ContentBuff = content.
       85         logWrite:WriteFileToLog('REQUEST-CONTENT:' + req:Content).
       86         req:HndlSocket = hndlSocket.
       87         client_ = identifyClients(req).
       88         if client_ <> ? then
       89         do:
       90            vDelete = clientControl:SendRequest(client_, req, resp).
       91         end.
       92         define variable v-err-msg as character no-undo .
       93         catch exAppErrors as class Progress.Lang.AppError :
       94            v-err-msg = exAppErrors:ReturnValue .
       95            if v-err-msg > ""
       96            then .
       97            else do :
       98               v-err-msg = exAppErrors:GetMessage(1) .
       99               if v-err-msg > ""
      100               then .
      101               else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls" .
      102            end .
      103            logWrite:LogStr = v-err-msg + exAppErrors:CallStack.
      104            vDelete = yes.
      105         end catch .
      106         catch exProErrors as class Progress.Lang.ProError :
      107            v-err-msg = exProErrors:GetMessage(1) .
      108            if v-err-msg > ""
      109            then .
      110            else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls" .
      111            logWrite:LogStr = v-err-msg + exProErrors:CallStack.
      112            vDelete = yes.
      113         end catch .
      114         catch exAnyErrors as class Progress.Lang.Error:
      115            v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls " + exAnyErrors:GetMessage(1).
      116            logWrite:LogStr = v-err-msg + exAnyErrors:CallStack.
      117            vDelete = yes.
      118         end catch .
      119         finally:
      120            if vDelete
      121            then do:
      122               socketDisconnect(hndlSocket).
      123               delete object req no-error.
      124               delete object resp no-error.
      125            end.
      126         end finally.
      127     end.
      128      method public void RequestProcessing (HeadHttp as HeadHttp, content as memptr, hndlSocket as handle, lpar as character):
      129         define variable vDelete as logical no-undo.
      130         define variable req           as class     IRequest      no-undo.
      131         define variable resp          as class     IResponse     no-undo.
      132         define variable client_       as character no-undo.
      133         req = new SimpleRequest(HeadHttp).
      134         resp = new SimpleResponse().
      135         req:ContentBuff = content.
      136         req:HndlSocket = hndlSocket.
      137         client_ = identifyClients(req) no-error.
      138         if    client_ eq ""
      139            or client_ eq ?
      140         then
      141            client_ = "tsd".
      142         if client_ <> ? then
      143         do:
      144            vDelete = clientControl:SendRequest(client_, req, resp, lpar).
      145         end.
      146         define variable v-err-msg as character no-undo .
      147         catch exAppErrors as class Progress.Lang.AppError :
      148            v-err-msg = exAppErrors:ReturnValue .
      149            if v-err-msg > ""
      150            then .
      151            else do :
      152               v-err-msg = exAppErrors:GetMessage(1) .
      153               if v-err-msg > ""
      154               then .
      155               else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls" .
      156            end .
      157            logWrite:LogStr = v-err-msg.
      158            vDelete = yes.
      159         end catch .
      160         catch exProErrors as class Progress.Lang.ProError :
      161            v-err-msg = exProErrors:GetMessage(1) .
      162            if v-err-msg > ""
      163            then .
      164            else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls" .
      165            logWrite:LogStr = v-err-msg + exProErrors:CallStack.
      166            vDelete = yes.
      167         end catch .
      168         catch exAnyErrors as class Progress.Lang.Error:
      169            v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ibs\th\skt\sktserver.cls " + exAnyErrors:GetMessage(1).
      170            logWrite:LogStr = v-err-msg + exAnyErrors:CallStack.
      171            vDelete = yes.
      172         end catch .
      173         finally:
      174            if vDelete
      175            then do:
      176               socketDisconnect(hndlSocket).
      177               delete object req no-error.
      178               delete object resp no-error.
      179            end.
      180         end finally.
      181      end.
      182     method private char identifyClients (req           as class     IRequest):
      183       define variable hRoot   as handle.
      184       define variable hDoc    as handle.
      185       def    var      mbuffer as memptr.
      186       define variable client_ as character no-undo.
      187       if req:HeadHTTP:queryAdr <> ""
      188       then do:
      189         client_ = entry(1,req:HeadHTTP:queryAdr,"/").
      190         if     not clientControl:availClient(client_)
      191            and num-entries (req:HeadHTTP:queryAdr,".") eq 2
      192         then
      193            client_= "FileSend".
      194         return client_.
      195       end.
      196       else
      197          client_ = "".
      198       if not    req:Content matches '*<data req="gds"*'
      199              or req:Content matches '*<data req="grp"*'
      200         then do:
      201         create x-document hDoc.
      202         create x-noderef  hRoot.
      203         set-size(mbuffer) = 0.
      204         set-size(mbuffer) = length(cast(req, ibs.th.skt.Commands.SimpleRequest):Content,'raw') + 2.
      205         put-string(mbuffer,1) = cast(req, ibs.th.skt.Commands.SimpleRequest):Content.
      206         define variable loadok as logical no-undo.
      207         loadok = hDoc:load("memptr",mbuffer,no) no-error.
      208         if error-status:error or loadok ne yes
      209         then
      210            return error "Ошибка при разборе XML документа".
      211         hdoc:get-document-element(hRoot) no-error.
      212         assign
      213           client_ = hRoot:name no-error.
      214       end.
      215       if client_ = "slips" or client_ = "spool" or  client_ = "config" or client_ = "fuels" or client_ = "reports"
      216       then do:
      217          req:HeadHTTP:queryAdr = client_ + ".xml".
      218          client_= "FileSend".
      219       end.
      220       if not clientControl:availClient(client_) then
      221       do:
      222         if    req:Content matches '*<data req="gds"*'
      223            or req:Content matches '*<data req="grp"*'
      224           then
      225         do:
      226           client_ = "TableMenu".
      227           logWrite:WriteFileToLog( req:Content + chr(13) + chr(10)).
      228         end.
      229         else
      230         do:
      231           client_ = "ticked".
      232         end.
      233       end.
      234       return client_.
      235     end.
      236     method public logical checkEnd ():
      237        return clientControl:checkEnd().
      238     end.
      239           destructor public SktServer ( ):
      240       delete object logWrite.
      241       delete object clientControl no-error.
      242           end destructor.
      243                      method public void connproc(hSocket as handle) :
      244              logWrite:WriteDebugLog(substitute ("Подключено устройстов id подключения &1 Ip: &2 Port: &3",hSocket,hSocket:REMOTE-HOST,hSocket:REMOTE-PORT)).
      245         def var n as int no-undo.
      246         define variable v-header      as character no-undo.
      247         define variable mbuffer-in    as memptr   no-undo.
      248         define variable mbuffer-hdr   as memptr   no-undo.
      249         define variable v-bytes       as integer  no-undo.
      250         define variable v-str         as char     no-undo init "".
      251         define variable resp-head     as longchar no-undo.
      252         define variable v-read        as logical  no-undo.
      253         define variable v-pos-buf     as integer  no-undo.
      254         define variable HeadHttp as HeadHttp no-undo.
      255         fix-codepage(resp-head) = "1251" .
      256         hSocket:set-socket-option('TCP-NODELAY', 'true').
      257         hSocket:set-socket-option('SO-KEEPALIVE', 'true').
      258         hSocket:set-socket-option('SO-REUSEADDR', 'true').
      259         assign
      260            v-header  = '':U
      261            v-bytes   = 0
      262            n         = 0
      263            v-str     = ""
      264         resp-head = substitute("HTTP/1.0 400 Bad Request&1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      265         ContBlock:
      266         do:
      267            etime(yes).
      268            set-size (mbuffer-in) = 0.
      269            mbuffer-in = ?.
      270            set-size (mbuffer-hdr) = 33000.
      271            dwhdr_:
      272            do while etime < 5000 :
      273               if n = v-bytes
      274               then do:
      275                  n = 0.
      276                  v-bytes = hsocket:get-bytes-available().
      277               end.
      278               do while n < v-bytes :
      279                  n = n + 1.
      280                  v-pos-buf = v-pos-buf + 1.
      281                  v-read = hSocket:read(mbuffer-hdr, v-pos-buf, 1, 2) no-error .
      282                  if not v-read
      283                  then
      284                     leave.
      285                  if v-pos-buf > 4
      286                  then
      287                     v-str = get-string (mbuffer-hdr, v-pos-buf - 3, 4).
      288                  if v-pos-buf > 32000
      289                  then
      290                     leave.
      291                  if v-str = chr(13) + chr(10) + chr(13) + chr(10)
      292                  then do:
      293                     v-header = get-string (mbuffer-hdr, 1).
      294                     v-str = "".
      295                     v-pos-buf = 0.
      296                     logWrite:WriteFileToLog('REQUEST-HEADER:' + chr(13) + chr(10) + v-header ).
      297                     HeadHttp = new HeadHttp(v-header).
      298                     set-size (mbuffer-in) = 0.
      299                     set-size (mbuffer-hdr) = 0.
      300                     set-size (mbuffer-in) = HeadHttp:contentLength.
      301                     leave dwhdr_.
      302                  end.
      303               end.
      304            end.
      305            if v-header eq ""
      306            then do:
      307               logWrite:WriteFileToLog("Test request").
      308               resp-head =  substitute("HTTP/1.0 200 OK &1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      309               writeResponse (hSocket , resp-head).
      310               leave ContBlock.
      311            end.
      312            if not valid-object (HeadHttp)
      313            then do:
      314               resp-head =  substitute("HTTP/1.0 408 Request Timeout or bad request &1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      315               writeResponse (hSocket , resp-head).
      316               leave ContBlock.
      317            end.
      318            dw_:
      319            do while     HeadHttp:contentLength > v-pos-buf
      320              and etime < us-tmo * 1000
      321              and hSocket:connected () :
      322                  v-bytes = hsocket:get-bytes-available().
      323                  assign
      324                     v-read = false
      325                  .
      326                  if v-pos-buf + v-bytes > HeadHttp:contentLength
      327                  then do:
      328                     logWrite:WriteFileToLog(substitute ('Error:  В Сontent-Length : &1 Пришло: &2 Проигнорировано &3 поледних байт',HeadHttp:contentLength, v-pos-buf + v-bytes, v-pos-buf + v-bytes - HeadHttp:contentLength)).
      329                     v-bytes = HeadHttp:contentLength - v-pos-buf.
      330                  end.
      331                  v-read = hSocket:read(mbuffer-in, v-pos-buf + 1, v-bytes) .
      332                  if v-read
      333                  then
      334                  assign
      335                     v-pos-buf = v-pos-buf + v-bytes
      336                  .
      337            end.
      338            if       ( mbuffer-in = ?
      339                     or get-size (mbuffer-in) = ?
      340                     or get-size (mbuffer-in) = 0)
      341               and (    HeadHttp:contentType <> "raw"
      342               and HeadHttp:queryReq = "")
      343            then do:
      344               resp-head =  substitute("HTTP/1.0 408 Request Timeout or bad request &1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      345               writeResponse (hSocket , resp-head).
      346               leave ContBlock.
      347            end.
      348            if     HeadHttp:contentType ne 'text/xml':U
      349               and HeadHttp:contentType ne 'raw'
      350               and HeadHttp:queryReq    eq ""
      351            then do:
      352               resp-head = substitute("HTTP/1.0 501 Not Implemented&1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      353               writeResponse (hSocket , resp-head).
      354               leave ContBlock.
      355            end.
      356            if     HeadHttp:contentLength = 0
      357               and HeadHttp:queryReq eq ""
      358            then do:
      359               resp-head = substitute("HTTP/1.0 411 No Content&1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      360               writeResponse (hSocket , resp-head).
      361               leave ContBlock.
      362            end.
      363            if (
      364               HeadHttp:contentLength > v-pos-buf)
      365            then do:
      366               resp-head =  substitute("HTTP/1.0 408 Request Timeout&1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      367               writeResponse (hSocket , resp-head).
      368               leave ContBlock.
      369            end.
      370            case true:
      371               when HeadHttp:queryAdr <> ''
      372               or
      373               when HeadHttp:contentType = 'text/xml'
      374               then do:
      375                  RequestProcessing(HeadHttp,mbuffer-in, hsocket) no-error.
      376                  resp-head = if logWrite:LogStr <> "" then logWrite:LogStr else "OK".
      377               end.
      378               when HeadHttp:contentType = 'raw'
      379               then do:
      380                  RequestProcessing(HeadHttp,mbuffer-in, hsocket, HeadHttp:userAgent) no-error.
      381                  resp-head = if logWrite:LogStr <> "" then logWrite:LogStr else "OK".
      382               end.
      383               otherwise do:
      384                  resp-head =  substitute("HTTP/1.0 400 Bad Request&1Server: 4GL&2",chr(13) + chr(10),chr(13) + chr(10) + chr(13) + chr(10)).
      385                  writeResponse (hSocket , resp-head).
      386               end.
      387            end case.
      388            logWrite:LogStr = "".
      389         end.
      390         logWrite:WriteFileToLog('RESPONSE: ' + resp-head).
      391      end.
      392      method public logical writeResponse (hSocket as handle, resp-head as longchar ):
      393         define variable mbuffer-out   as memptr   no-undo.
      394         SET-SIZE(mbuffer-out) = 0.
      395         SET-SIZE(mbuffer-out) = length(resp-head,'RAW') + 2.
      396         PUT-STRING(mbuffer-out,1) = resp-head.
      397         hsocket:write(mbuffer-out,1,length(resp-head,'RAW':U)) no-error.
      398         socketDisconnect(hsocket).
      399         set-size (mbuffer-out) = 0.
      400      end.
      401      method public logical socketDisconnect (hSocket as handle):
      402         clientControl:socketDisconnect (hSocket).
      403      end.
      404   end class.
