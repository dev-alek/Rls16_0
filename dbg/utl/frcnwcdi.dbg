        1   block-level on error undo, throw.
        2   define input parameter p-install as logical no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: frcnwcdi.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/frcnwcdi.p $":U .
        8   define variable vss-description as character no-undo init "Форсированная передача по новостям товаров, клиентов и и т.д. по кассе".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   if not p-install then do:
       79     message vss-workfile vss-revision vss-description skip
       80     "Вы уверены, что хотите запустить пересылку по новостям товаров, клиентов и т.д. по кассе"
       81     view-as alert-box question buttons yes-no update loc#log as logical  .
       82     if not loc#log then return.
       83   end.
       84   main-block:
       85   do on error undo, return error
       86   :
       87     for each ub.cash-desk no-lock
       88     where ub.cash-desk.db-num = g#db-num
       89     on error undo, return error
       90     :
       91       if not (ub.cash-desk.pos-type = 'MARIA':U
       92             or
       93             ub.cash-desk.pos-type = 'r-keeper':U
       94             ) then next.
       95       for each ub.cd-clu no-lock where
       96               ub.cd-clu.obj-type = 'маг':U
       97           and ub.cd-clu.obj-code = ub.cash-desk.obj-code
       98           and ub.cd-clu.pos-type = ub.cash-desk.pos-type
       99       on error undo, return error
      100       :
      101         run str/callnews.p
      102           (input 'cd-clu':U
      103           ,input (buffer ub.cd-clu:handle)
      104           ) no-error .
      105         if error-status:error then do:
      106           undo main-block,  return error return-value .
      107         end.
      108       end.
      109       for each ub.cd-dlu no-lock where
      110               ub.cd-dlu.obj-type = 'маг':U
      111           and ub.cd-dlu.obj-code = ub.cash-desk.obj-code
      112           and ub.cd-dlu.pos-type = ub.cash-desk.pos-type
      113       on error undo, return error
      114       :
      115         run str/callnews.p
      116           (input 'cd-dlu':U
      117           ,input (buffer ub.cd-dlu:handle)
      118           ) no-error .
      119         if error-status:error then do:
      120           undo main-block,  return error return-value .
      121         end.
      122       end.
      123       for each ub.cd-grp no-lock where
      124               ub.cd-grp.obj-type = 'маг':U
      125           and ub.cd-grp.obj-code = ub.cash-desk.obj-code
      126           and ub.cd-grp.pos-type = ub.cash-desk.pos-type
      127       on error undo, return error
      128       :
      129         run str/callnews.p
      130           (input 'cd-grp':U
      131           ,input (buffer ub.cd-grp:handle)
      132           ) no-error .
      133         if error-status:error then do:
      134           undo main-block,  return error return-value .
      135         end.
      136       end.
      137       for each ub.cd-grp no-lock where
      138               ub.cd-grp.obj-type = 'маг':U
      139           and ub.cd-grp.obj-code = ub.cash-desk.obj-code
      140           and ub.cd-grp.pos-type = ub.cash-desk.pos-type
      141       on error undo, return error
      142       :
      143         run str/callnews.p
      144           (input 'cd-grp':U
      145           ,input (buffer ub.cd-grp:handle)
      146           ) no-error .
      147         if error-status:error then do:
      148           undo main-block,  return error return-value .
      149         end.
      150       end.
      151       for each ub.c-cd-clu no-lock where
      152               ub.c-cd-clu.obj-type = 'маг':U
      153           and ub.c-cd-clu.obj-code = ub.cash-desk.obj-code
      154           and ub.c-cd-clu.pos-type = ub.cash-desk.pos-type
      155       on error undo, return error
      156       :
      157         run str/callnews.p
      158           (input 'c-cd-clu':U
      159           ,input (buffer ub.c-cd-clu:handle)
      160           ) no-error .
      161         if error-status:error then do:
      162           undo main-block,  return error return-value .
      163         end.
      164       end.
      165       for each ub.c-cd-dlu no-lock where
      166               ub.c-cd-dlu.obj-type = 'маг':U
      167           and ub.c-cd-dlu.obj-code = ub.cash-desk.obj-code
      168           and ub.c-cd-dlu.pos-type = ub.cash-desk.pos-type
      169       on error undo, return error
      170       :
      171         run str/callnews.p
      172           (input 'c-cd-dlu':U
      173           ,input (buffer ub.c-cd-dlu:handle)
      174           ) no-error .
      175         if error-status:error then do:
      176           undo main-block,  return error return-value .
      177         end.
      178       end.
      179       for each ub.c-cd-grp no-lock where
      180               ub.c-cd-grp.obj-type = 'маг':U
      181           and ub.c-cd-grp.obj-code = ub.cash-desk.obj-code
      182           and ub.c-cd-grp.pos-type = ub.cash-desk.pos-type
      183       on error undo, return error
      184       :
      185         run str/callnews.p
      186           (input 'c-cd-grp':U
      187           ,input (buffer ub.c-cd-grp:handle)
      188           ) no-error .
      189         if error-status:error then do:
      190           undo main-block,  return error return-value .
      191         end.
      192       end.
      193       for each ub.c-cd-grp no-lock where
      194               ub.c-cd-grp.obj-type = 'маг':U
      195           and ub.c-cd-grp.obj-code = ub.cash-desk.obj-code
      196           and ub.c-cd-grp.pos-type = ub.cash-desk.pos-type
      197       on error undo, return error
      198       :
      199         run str/callnews.p
      200           (input 'c-cd-grp':U
      201           ,input (buffer ub.c-cd-grp:handle)
      202           ) no-error .
      203         if error-status:error then do:
      204           undo main-block,  return error return-value .
      205         end.
      206       end.
      207       for each ub.c-cd-doc no-lock where
      208               ub.c-cd-doc.obj-type = 'маг':U
      209           and ub.c-cd-doc.obj-code = ub.cash-desk.obj-code
      210           and ub.c-cd-doc.pos-type = ub.cash-desk.pos-type
      211       on error undo, return error
      212       :
      213         run str/callnews.p
      214           (input 'c-cd-doc':U
      215           ,input (buffer ub.c-cd-doc:handle)
      216           ) no-error .
      217         if error-status:error then do:
      218           undo main-block,  return error return-value .
      219         end.
      220       end.
      221       for each ub.c-cd-doc no-lock where
      222               ub.c-cd-doc.obj-type = 'маг':U
      223           and ub.c-cd-doc.obj-code = ub.cash-desk.obj-code
      224           and ub.c-cd-doc.pos-type = ub.cash-desk.pos-type
      225       on error undo, return error
      226       :
      227         run str/callnews.p
      228           (input 'c-cd-doc':U
      229           ,input (buffer ub.c-cd-doc:handle)
      230           ) no-error .
      231         if error-status:error then do:
      232           undo main-block,  return error return-value .
      233         end.
      234       end.
      235     end.
      236   end.
      237   if not p-install then do:
      238     message
      239     "Завершилась утилита пересылки по новостям товаров, клиентов и т.д. по кассе"
      240     view-as alert-box .
      241   end.
