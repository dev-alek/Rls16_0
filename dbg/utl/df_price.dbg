        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        7   procedure cur-time :
        8      define output parameter p-today as date      no-undo .
        9      define output parameter p-time  as integer   no-undo .
       10     do
       11     on error undo, return error
       12     :
       13       define variable v-date1 as date      no-undo .
       14       define variable v-date2 as date      no-undo .
       15       define variable v-time  as integer   no-undo .
       16       assign
       17         v-date1 = today
       18         v-time  = time
       19         v-date2 = today
       20       .
       21       if v-date1 <> v-date2
       22       then do:
       23         assign
       24           v-date1 = today
       25           v-time  = v-time
       26         .
       27       end.
       28       assign
       29         p-today = v-date1
       30         p-time  = v-time
       31       .
       32     end.
       33   end.
       34   function cur-time-date returns character
       35   :
       36     return string(today, '99/99/9999':U) .
       37   end.
       38   function cur-time-mjd returns decimal
       39   :
       40     define variable v-date as date      no-undo .
       41     define variable v-time as integer   no-undo .
       42     run cur-time in this-procedure
       43       (output v-date
       44       ,output v-time
       45       ) .
       46     return integer(v-date) - 2400002 + (v-time / 86400) .
       47   end.
       48   function cur-time-get-ending-index returns integer
       49   (input p-number as integer
       50   )
       51   :
       52     if p-number < 0
       53     or p-number = ?
       54     then do:
       55       return 1 .
       56     end.
       57     define variable v-rest as integer   no-undo .
       58     assign
       59       p-number = p-number modulo 100
       60     .
       61     if p-number < 20
       62     then do:
       63       assign
       64         v-rest = p-number
       65       .
       66     end.
       67     else do:
       68       assign
       69         v-rest = p-number modulo 10
       70       .
       71     end.
       72     case v-rest :
       73       when 1
       74       then do:
       75         return 2 .
       76       end.
       77       when 2 or
       78       when 3 or
       79       when 4
       80       then do:
       81         return 3 .
       82       end.
       83       otherwise do:
       84         return 1 .
       85       end.
       86     end case .
       87   end.
       88   procedure cur-time-mjd-to-date :
       89      define input  parameter i-mjd-diff as decimal no-undo.
       90      define output parameter o-Date     as date    no-undo.
       91      define output parameter o-Time     as integer no-undo.
       92      define variable v-day-number as integer   no-undo .
       93      if    i-mjd-diff < 0
       94         or i-mjd-diff = ?
       95      then do:
       96         return "?" .
       97      end.
       98      assign
       99         v-day-number = truncate(i-mjd-diff,0).
      100         o-Date = date(v-day-number + 2400002).
      101         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      102     .
      103   end.
      104   function cur-time-mjd-to-string returns character
      105   (input p-mjd-diff as decimal
      106   )
      107   :
      108     define variable v-day-number as integer   no-undo .
      109     define variable v-seconds    as integer   no-undo .
      110     define variable v-hour       as integer   no-undo .
      111     define variable v-min        as integer   no-undo .
      112     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      113     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      114     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      115     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      116     if p-mjd-diff < 0
      117     or p-mjd-diff = ?
      118     then do:
      119       return "?" .
      120     end.
      121     assign
      122       v-day-number = integer(truncate(p-mjd-diff,0))
      123       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      124     .
      125     if v-seconds > 86400
      126     then do:
      127       assign
      128         v-seconds = 86400 - 1
      129       .
      130     end.
      131     if v-seconds < 0
      132     then do:
      133       assign
      134         v-seconds = 0
      135       .
      136     end.
      137     assign
      138       v-hour = truncate(v-seconds / 3600, 0)
      139     .
      140     assign
      141       v-seconds = v-seconds modulo 3600
      142     .
      143     assign
      144       v-min = truncate(v-seconds / 60, 0)
      145     .
      146     assign
      147       v-seconds = v-seconds modulo 60
      148     .
      149     return
      150         (if v-day-number <> 0
      151           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      152           else ""
      153         )
      154       + (if v-day-number <> 0 or v-hour <> 0
      155           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      156           else ""
      157         )
      158       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      159           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      160           else ""
      161         )
      162       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      163       .
      164   end.
      165   function cur-time-string returns character
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      174   end.
      175   function cur-time-string-sec returns character
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      184   end.
      185   function cur-time-custom  returns character
      186   (input p-prefix as character
      187   ,input p-date-format as character
      188   ,input p-delimiter as character
      189   ,input p-time-format as character
      190   ,input p-suffix as character
      191   )
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     run cur-time in this-procedure
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return
      200       p-prefix
      201       + string(v-date, p-date-format)
      202       + p-delimiter
      203       + string(v-time, p-time-format)
      204       + p-suffix
      205       .
      206   end.
      207   function cur-time-print  returns character
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     run cur-time in this-procedure
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      216   end.
      217   function cur-time-datetime returns datetime
      218   :
      219     define variable v-char as character no-undo .
      220     define variable v-datetime as datetime no-undo .
      221     v-char = cur-time-string().
      222     v-datetime = datetime(v-char).
      223     return  v-datetime.
      224   end.
      225   function cur-time-string-msec returns character
      226   :
      227     define variable v-date as datetime  no-undo .
      228     v-date = now.
      229     return string(v-date) .
      230   end.
      231   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   define variable v-waitfram-action01         as character   no-undo .
      233   define variable v-waitfram-action02         as character   no-undo .
      234   define variable v-waitfram-action03         as character   no-undo .
      235   define variable mWaitFramTextBeg            as character   no-undo.
      236   define variable mWaitFramTextEnd            as character   no-undo.
      237   define variable mWaitFramView               as logical     no-undo.
      238   define variable mWaitProcEvent              as logical     no-undo init yes.
      239   define variable mWaitFramInterval           as integer     no-undo init 1 .
      240   define variable mWaitFramStop               as logical     no-undo.
      241   define variable mWaitFramStopUser           as logical     no-undo.
      242   define variable mWaitFramStopTimeOut        as logical     no-undo.
      243   define variable mWaitFramStartProc          as datetime-tz no-undo.
      244   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      245   define button B-WaitFramStop auto-end-key
      246        label "Стоп"
      247        size 10 by 1 tooltip "Остоновить процесс".
      248   define button B-viewProcInfo
      249        label "Информация"
      250        size 15 by 1 tooltip "Информация о процесс".
      251   define frame waitfram
      252     v-waitfram-action01 format "x(72)" no-label skip
      253     v-waitfram-action02 format "x(72)" no-label skip
      254     v-waitfram-action03 format "x(72)" no-label skip
      255     B-viewProcInfo
      256     B-WaitFramStop at row 4 col 30
      257     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      258     .
      259   define new global shared variable mBatchMode as logical no-undo init ?.
      260   define variable mFramBachModHandle as handle no-undo.
      261   mFramBachModHandle = frame waitfram:handle.
      262   define variable mFameOldVis as logical no-undo.
      263   define variable mVisCUrentVin as logical no-undo.
      264   if session:batch-mode
      265   then
      266      mBatchMode = yes.
      267   if mBatchMode = ? then do:
      268     mVisCUrentVin = current-window:visible.
      269     mFameOldVis = mFramBachModHandle:visible.
      270     mFramBachModHandle:visible  = yes.
      271     mBatchMode = mFramBachModHandle:visible ne yes.
      272     mFramBachModHandle:visible = mFameOldVis.
      273     current-window:visible = mVisCUrentVin.
      274   end.
      275    if  log-manager:logfile-name ne ?
      276     then DO:
      277         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      278         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      279         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      280     end.
      281   on choose of B-WaitFramStop in frame waitfram
      282   do:
      283     mWaitFramStop = yes.
      284     mWaitFramStopUser = yes.
      285   end.
      286   function waitfram-check-timeout returns logical():
      287      define variable vtime as int64 no-undo.
      288      if mWaitFramStopTimeOut
      289      then
      290         return yes.
      291      vtime = ( now - mWaitFramStartProc ) / 1000 .
      292      if     mWaitFramTimeOut ne ?
      293         and mWaitFramTimeOut ne 0
      294         and mWaitFramTimeOut lt vtime
      295      then do:
      296         mWaitFramStopTimeOut = yes.
      297      end.
      298      return mWaitFramStopTimeOut.
      299   end.
      300   procedure waitfram-hide :
      301     if not session:batch-mode
      302     then do
      303     on error undo, return error return-value
      304     :
      305       pause 0 before-hide .
      306       if not mBatchMode then
      307         hide frame waitfram .
      308     if     not mWaitFramView
      309        and mWaitProcEvent
      310     then
      311       process events .
      312     end.
      313   end procedure.
      314   procedure waitfram-show :
      315     define input  parameter p-message as character no-undo .
      316     define variable v-left-margin as integer   no-undo .
      317     if not session:batch-mode
      318     then do
      319     on error undo, return error return-value
      320     :
      321       if length(p-message) <= 70 then do:
      322         assign
      323           v-left-margin = integer((70 - length(p-message)) / 2)
      324         .
      325         assign
      326           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      327         .
      328         assign
      329           v-waitfram-action01 = " "
      330           v-waitfram-action02 = " "
      331                                    + fill(" ", v-left-margin)
      332                                    + p-message
      333           v-waitfram-action03 = " "
      334         .
      335       end.
      336       else do:
      337         define variable vRindex1 as integer no-undo.
      338         define variable vRindex2 as integer no-undo.
      339         vRindex1 = r-index(p-message," ",70).
      340         if vRindex1 = 0
      341         then
      342            vRindex1 = 70.
      343         if length(p-message)  <= vRindex1 + 70 then do:
      344           assign
      345             v-waitfram-action01 = " "
      346             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      347             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      348           .
      349         end.
      350         else do:
      351           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      352           if vRindex2 <= vRindex1
      353           then
      354              vRindex2 = vRindex1 + 70.
      355           assign
      356             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      357             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      358             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      359           .
      360         end.
      361       end.
      362       B-viewProcInfo:visible   in frame waitfram = no.
      363       B-viewProcInfo:sensitive in frame waitfram = no.
      364       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      365       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      366       if  (   mWaitFramView
      367          or  mWaitProcEvent)
      368          and not mBatchMode
      369       then
      370          display
      371             v-waitfram-action01 skip
      372             v-waitfram-action02 skip
      373             v-waitfram-action03 skip
      374          with frame waitfram .
      375       if     mWaitFramView
      376          then do:
      377             if     mWaitFramInterval ne ?
      378                and not mBatchMode
      379             then
      380                wait-for go of frame waitfram pause mWaitFramInterval.
      381          end.
      382          else
      383             if     mWaitProcEvent
      384                and not mBatchMode
      385             then
      386                process events .
      387     end.
      388   end procedure.
      389      procedure waitfram-show-this:
      390         define input  parameter iInterval as int64 no-undo.
      391         define variable vtime as int64 no-undo.
      392         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      393         mWaitFramInterval = iInterval.
      394         run waitfram-show (substitute("&1&2 &3&4" ,
      395                                       mWaitFramTextBeg ,
      396                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      397                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      398                                       mWaitFramTextEnd
      399                                      )
      400                           ).
      401      end.
      402      procedure WaitFramRunPause:
      403         define input  parameter iInterval as dec no-undo.
      404         define variable vStart  as datetime-tz no-undo.
      405         define variable vend    as datetime-tz no-undo.
      406         define variable vint as int64 no-undo.
      407         define variable vOk as logical no-undo.
      408         vStart = now.
      409         vend   = vStart.
      410         publish "WaitFramPause" (iInterval,output vOk).
      411         vend   =  now.
      412         vint = vend - vStart.
      413         vint = iInterval - vint / 1000.
      414         if     not mWaitFramStop
      415            and (   vint > 0
      416                 or (    not vOk
      417                     and iInterval eq ?
      418                     )
      419                 )
      420         then
      421            run waitfram-show-this (iInterval).
      422         vend   =  now.
      423         vint = vend - vStart.
      424         vint = iInterval - vint / 1000.
      425         if     not mWaitFramStop
      426            and vint > 0
      427         then do:
      428            run gbl/pause.p (vint * 1000).
      429         end.
      430         if iInterval ne ?
      431         then
      432            publish "WaitFramStop".
      433         waitfram-check-timeout().
      434      end.
      435      procedure WaitFramWaitFor:
      436         define input  parameter iInterval as dec no-undo.
      437         assign
      438            mWaitFramStartProc   = now
      439            mWaitFramStopUser    = no
      440            mWaitFramStopTimeOut = no
      441         .
      442         block-wait:
      443         do while not mWaitFramStop:
      444            run WaitFramRunPause (iInterval).
      445            if  waitfram-check-timeout()
      446            then do:
      447               leave block-wait.
      448            end.
      449         end.
      450         run waitfram-hide.
      451      end.
      452   procedure waitfram-join :
      453     define input  parameter p-line-1  as character no-undo .
      454     define input  parameter p-line-2  as character no-undo .
      455     define input  parameter p-line-3  as character no-undo .
      456     define output parameter p-message as character no-undo .
      457     do
      458     on error undo, return error return-value
      459     :
      460       assign
      461         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      462                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      463                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      464       .
      465     end.
      466   end procedure.
      467   function waitfram-join-function returns character
      468     (input p-line-1 as character
      469     ,input p-line-2 as character
      470     ,input p-line-3 as character
      471     ).
      472     define variable v-message as character no-undo .
      473     run waitfram-join in this-procedure
      474       (input  p-line-1
      475       ,input  p-line-2
      476       ,input  p-line-3
      477       ,output v-message
      478       ) .
      479     return v-message .
      480   end function .
      481   define variable v-new-format as character no-undo .
      482   define variable l-ok  as logical no-undo .
      483   define variable v-today as date      no-undo.
      484   define variable v-time  as integer   no-undo.
      485   message
      486     "Вы хотите сгенерировать файл изменения форматов БД" skip
      487     "для деноминации сумм." skip
      488     view-as alert-box question buttons yes-no update l-ok .
      489   if l-ok <> true then do:
      490     return .
      491   end.
      492   output to price.df .
      493   run cur-time in this-procedure ( output v-today
      494                                  , output v-time
      495                                  ).
      496   put unformatted
      497     '# Файл деноминации полей, хранящих денежные суммы' + chr(10)
      498     '# !!!! Внимание !!!!' + chr(10)
      499     '# Данный файл сгенерирован автоматически при помощи программы df_price.p' + chr(10)
      500     '# Дата  ' + string(v-today, "99/99/9999") + chr(10)
      501     '# Время ' + string(v-time, "hh:mm") + chr(10)
      502     + chr(10)
      503   .
      504   output close .
      505   run waitfram-show in this-procedure
      506     (input "Анализ структуры БД"
      507     ) .
      508   for each _File no-lock
      509     where not _File._Hidden
      510   :
      511     run waitfram-show in this-procedure
      512       (input "Анализ таблицы " + string(_File._File-Name, "x(40)") + "."
      513       ).
      514     field-block:
      515     for each _Field of _File no-lock
      516       where _Field._Decimals > 0
      517         and substring(_Field._Desc, 1, 1) = "$"
      518     :
      519       define variable ind as integer no-undo .
      520       run process-format
      521         (input _Field._Format
      522         ,output v-new-format
      523         ).
      524       output to price.df append .
      525       put unformatted
      526         'UPDATE FIELD "' + _Field._Field-Name + '" OF "' + _File._File-Name + '"' + chr(10)
      527         '# DESCRIPTION "' + _Field._Desc + '"' + chr(10)
      528         '# DECIMALS ' + STRING(_Field._Decimals) + chr(10)
      529         '# FORMAT "' + _Field._Format + '"' + chr(10)
      530         '  FORMAT "' + v-new-format + '"' + chr(10)
      531         + chr(10)
      532       .
      533       output close .
      534     end.
      535   end.
      536   run waitfram-hide in this-procedure .
      537   procedure process-format :
      538     define input  parameter p-format as character no-undo .
      539     define output parameter p-new-format as character no-undo .
      540     define variable l-minus-sign as logical no-undo .
      541     define variable v-length as integer no-undo .
      542     if substring(p-format, 1, 1 ) = '-' then do:
      543       assign
      544         l-minus-sign = true
      545         v-length     = length(p-format) - 1
      546       .
      547     end.
      548     else do:
      549       assign
      550         l-minus-sign = false
      551         v-length     = length(p-format)
      552       .
      553     end.
      554     define variable v-base-format as character no-undo .
      555     assign
      556       v-base-format = fill(">>>,", 20) + ">>9"
      557     .
      558     assign
      559       p-new-format = substring( v-base-format, length(v-base-format) - v-length + 1, v-length )
      560     .
      561     if substring(p-new-format, 1, 1 ) = "," then do:
      562       assign
      563         overlay(p-new-format, 1, 1) = ">"
      564       .
      565     end.
      566     assign
      567       p-new-format = (if l-minus-sign then "-" else "" ) + p-new-format
      568     .
      569     if length (p-new-format) <> length(p-format) then do:
      570       message
      571         "Warning different formats" skip
      572         "p-format"      p-format     skip
      573         "p-new-format"  p-new-format skip
      574         view-as alert-box .
      575     end.
      576   end procedure.
      577   message
      578     "Создание файла для деноминации форматов завершено" skip
      579     "Файл price.df." skip
      580     view-as alert-box information .
