        1   using utl.*.
        2   block-level on error undo, throw.
        3   define input parameter parParentProc as handle no-undo .
        4   define variable mForm as class gpwdbrw no-undo.
        5   define variable mForm2 as class gpwdbrw2 no-undo.
        6       define variable vss-revision       as character no-undo init "$Revision$":U .
        7       define variable vss-author         as character no-undo init "$Author$":U .
        8       define variable vss-date           as character no-undo init "$Date$":U .
        9       define variable vss-workfile       as character no-undo init "$Workfile$":U .
       10       define variable vss-archive        as character no-undo init "$Archive$":U .
       11       define variable vss-description    as character no-undo init "Экранные триггеры промо-акций".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   if ibs.th.gbl.gbl-var:g#db-num ne 0 then
       71   do:
       72      System.Windows.Forms.MessageBox:Show(
       73         "Пункт меню доступен только в ГБД.",
       74         "Внимание!",
       75         System.Windows.Forms.MessageBoxButtons:OK,
       76         System.Windows.Forms.MessageBoxIcon:Error).
       77      return.
       78   end.
       79   assign
       80      session:debug-alert = yes
       81      session:error-stack-trace = yes
       82   .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84     define variable v-cntxt-db-num        as integer   no-undo .
       85     define variable v-cntxt-userid        as character no-undo .
       86     define variable v-cntxt-level         as character no-undo .
       87     define variable v-cntxt-host-code-obj as integer   no-undo .
       88     define variable v-cntxt-obj-type      as character no-undo .
       89     define variable v-cntxt-obj-code      as integer   no-undo .
       90     define variable v-cntxt-db-num-obj    as integer   no-undo .
       91     define variable v-cntxt-is-admin      as logical   no-undo .
       92   define new global shared variable g#library  as handle no-undo .
       93   define new global shared variable g#library2 as handle no-undo .
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95     run mainmenu_getcntxt in parparentproc
       96       (output v-cntxt-db-num
       97       ,output v-cntxt-userid
       98       ,output v-cntxt-level
       99       ,output v-cntxt-host-code-obj
      100       ,output v-cntxt-obj-type
      101       ,output v-cntxt-obj-code
      102       ,output v-cntxt-db-num-obj
      103       ,output v-cntxt-is-admin
      104       ) .
      105    define variable mOk as logical no-undo.
      106   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      108     (input  v-cntxt-obj-type
      109     ,input  v-cntxt-obj-code
      110     ,output v-cntxt-host-code-obj
      111     )  .
      112   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   do:
      114     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      115       (input  v-cntxt-db-num
      116       ,input  v-cntxt-userid
      117       ,input  0
      118       ,input  'actn_gen-pwd':U
      119       ,input  'firm':U
      120       ,input  v-cntxt-host-code-obj
      121       ,input  '':U
      122       ,input  0
      123       ,input  0
      124       ,input  0
      125       ,input  0
      126       ,input  true
      127       ,output mOK
      128       )  .
      129   end.
      130    if not mOk then
      131         return .
      132    gpwdbrw:parParentProc = parParentProc.
      133   define variable v-sys-key   as character         no-undo.
      134   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      136     (output v-sys-key
      137     ) no-error .
      138      if v-sys-key eq "SibintekTechProl"
      139      then do:
      140         mForm2 = new utl.gpwdbrw2().
      141         if valid-object(mForm2) then
      142             mForm2:Wait().
      143      end.
      144      else do:
      145         mForm = new utl.gpwdbrw().
      146         if valid-object(mForm) then
      147             mForm:Wait().
      148      end.
      149   catch mErr as Progress.Lang.Error :
      150      System.Windows.Forms.MessageBox:Show(
      151         quoter(mErr:GetMessage(1)) + " " +
      152         quoter(mErr:GetMessage(2)) + " " +
      153         quoter(mErr:GetMessage(3)) + " " +
      154         quoter(mErr:CallStack),
      155         "Ошибка!",
      156         System.Windows.Forms.MessageBoxButtons:OK,
      157         System.Windows.Forms.MessageBoxIcon:Error).
      158   end catch.
      159   finally:
      160      mForm:DisposeForm().
      161   end finally.
