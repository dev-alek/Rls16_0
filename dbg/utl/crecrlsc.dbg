        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: crecrlsc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/crecrlsc.p $":U .
        7   define variable vss-description as character no-undo init "отправка по новостям запроса значения seq s-sclc-code и создания, на его основе, диапазона локальных весовых кодов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure cur-time :
       68      define output parameter p-today as date      no-undo .
       69      define output parameter p-time  as integer   no-undo .
       70     do
       71     on error undo, return error
       72     :
       73       define variable v-date1 as date      no-undo .
       74       define variable v-date2 as date      no-undo .
       75       define variable v-time  as integer   no-undo .
       76       assign
       77         v-date1 = today
       78         v-time  = time
       79         v-date2 = today
       80       .
       81       if v-date1 <> v-date2
       82       then do:
       83         assign
       84           v-date1 = today
       85           v-time  = v-time
       86         .
       87       end.
       88       assign
       89         p-today = v-date1
       90         p-time  = v-time
       91       .
       92     end.
       93   end.
       94   function cur-time-date returns character
       95   :
       96     return string(today, '99/99/9999':U) .
       97   end.
       98   function cur-time-mjd returns decimal
       99   :
      100     define variable v-date as date      no-undo .
      101     define variable v-time as integer   no-undo .
      102     run cur-time in this-procedure
      103       (output v-date
      104       ,output v-time
      105       ) .
      106     return integer(v-date) - 2400002 + (v-time / 86400) .
      107   end.
      108   function cur-time-get-ending-index returns integer
      109   (input p-number as integer
      110   )
      111   :
      112     if p-number < 0
      113     or p-number = ?
      114     then do:
      115       return 1 .
      116     end.
      117     define variable v-rest as integer   no-undo .
      118     assign
      119       p-number = p-number modulo 100
      120     .
      121     if p-number < 20
      122     then do:
      123       assign
      124         v-rest = p-number
      125       .
      126     end.
      127     else do:
      128       assign
      129         v-rest = p-number modulo 10
      130       .
      131     end.
      132     case v-rest :
      133       when 1
      134       then do:
      135         return 2 .
      136       end.
      137       when 2 or
      138       when 3 or
      139       when 4
      140       then do:
      141         return 3 .
      142       end.
      143       otherwise do:
      144         return 1 .
      145       end.
      146     end case .
      147   end.
      148   procedure cur-time-mjd-to-date :
      149      define input  parameter i-mjd-diff as decimal no-undo.
      150      define output parameter o-Date     as date    no-undo.
      151      define output parameter o-Time     as integer no-undo.
      152      define variable v-day-number as integer   no-undo .
      153      if    i-mjd-diff < 0
      154         or i-mjd-diff = ?
      155      then do:
      156         return "?" .
      157      end.
      158      assign
      159         v-day-number = truncate(i-mjd-diff,0).
      160         o-Date = date(v-day-number + 2400002).
      161         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163   end.
      164   function cur-time-mjd-to-string returns character
      165   (input p-mjd-diff as decimal
      166   )
      167   :
      168     define variable v-day-number as integer   no-undo .
      169     define variable v-seconds    as integer   no-undo .
      170     define variable v-hour       as integer   no-undo .
      171     define variable v-min        as integer   no-undo .
      172     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      173     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      174     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      175     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      176     if p-mjd-diff < 0
      177     or p-mjd-diff = ?
      178     then do:
      179       return "?" .
      180     end.
      181     assign
      182       v-day-number = integer(truncate(p-mjd-diff,0))
      183       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185     if v-seconds > 86400
      186     then do:
      187       assign
      188         v-seconds = 86400 - 1
      189       .
      190     end.
      191     if v-seconds < 0
      192     then do:
      193       assign
      194         v-seconds = 0
      195       .
      196     end.
      197     assign
      198       v-hour = truncate(v-seconds / 3600, 0)
      199     .
      200     assign
      201       v-seconds = v-seconds modulo 3600
      202     .
      203     assign
      204       v-min = truncate(v-seconds / 60, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 60
      208     .
      209     return
      210         (if v-day-number <> 0
      211           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      212           else ""
      213         )
      214       + (if v-day-number <> 0 or v-hour <> 0
      215           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      219           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      220           else ""
      221         )
      222       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      223       .
      224   end.
      225   function cur-time-string returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-string-sec returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      244   end.
      245   function cur-time-custom  returns character
      246   (input p-prefix as character
      247   ,input p-date-format as character
      248   ,input p-delimiter as character
      249   ,input p-time-format as character
      250   ,input p-suffix as character
      251   )
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return
      260       p-prefix
      261       + string(v-date, p-date-format)
      262       + p-delimiter
      263       + string(v-time, p-time-format)
      264       + p-suffix
      265       .
      266   end.
      267   function cur-time-print  returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-datetime returns datetime
      278   :
      279     define variable v-char as character no-undo .
      280     define variable v-datetime as datetime no-undo .
      281     v-char = cur-time-string().
      282     v-datetime = datetime(v-char).
      283     return  v-datetime.
      284   end.
      285   function cur-time-string-msec returns character
      286   :
      287     define variable v-date as datetime  no-undo .
      288     v-date = now.
      289     return string(v-date) .
      290   end.
      291   on delete of ub.code-range override
      292   do :
      293     define variable v-cmd     as character no-undo .
      294     define variable v-db-send as character no-undo .
      295     define buffer buf_db for ub.db .
      296     for each buf_db no-lock
      297       where buf_db.db-num > 0
      298     on error undo, return error :
      299       assign
      300         v-cmd = "dlcr" + chr(1) + string(code-range.range-type) + chr(1) + string(code-range.first-code)
      301       .
      302       if v-db-send = "":U then do:
      303         assign
      304           v-db-send = string( buf_db.db-num )
      305         .
      306       end.
      307       else do:
      308         assign
      309           v-db-send = v-db-send + chr(1) + string( buf_db.db-num )
      310         .
      311       end.
      312     end.
      313     if v-db-send <> "":U then do:
      314       run nws/cr-route.p ( input 'send-cmd':U, input v-cmd, input ?, input v-db-send ).
      315     end.
      316   end.
      317   do
      318   on error undo, return error :
      319     define temp-table tmp-c-range no-undo like ub.code-range .
      320     define temp-table curr-seq-value no-undo
      321       field db-num    like ub.db.db-num
      322       field seq-value as   integer
      323       index pi db-num
      324       .
      325     define variable g#loq         as   logical               no-undo .
      326     define variable db-wait       as   character             no-undo .
      327     define variable max-seq-value as   integer               no-undo .
      328     define variable ind           as   integer               no-undo .
      329     define variable v-cmd     as character no-undo .
      330     define variable v-db-send as character no-undo .
      331     define stream info .
      332     define buffer buf_code-range  for ub.code-range .
      333     define buffer buf_db for ub.db .
      334     find first ub.sys-ctrl no-lock.
      335     if ub.sys-ctrl.db-num <> 0 then do:
      336       message "Запуск утилиты возможен только в ГБД."
      337               view-as alert-box ERROR.
      338       return error.
      339     end.
      340     if can-find( first ub.code-range where ub.code-range.range-type = 'sclc':U no-lock ) then do:
      341       message "БД уже содержит диапазон(ы) локальных весовых кодов." skip
      342               "Запуск утилиты невозможен."
      343               view-as alert-box ERROR.
      344       return error.
      345     end.
      346     if can-find( first ub.db where ub.db.db-num > 0 no-lock ) then do:
      347       for each ub.rep
      348         where ub.rep.doc-num = -27091997
      349       on error undo, return error :
      350         find curr-seq-value where curr-seq-value.db-num = ub.rep.gr no-error.
      351         if available curr-seq-value then do:
      352           if ub.rep.num <= curr-seq-value.seq-value then do:
      353             next.
      354           end.
      355         end.
      356         else do:
      357           create curr-seq-value.
      358         end.
      359         assign
      360           curr-seq-value.db-num    = ub.rep.gr
      361           curr-seq-value.seq-value = ub.rep.num
      362           .
      363       end.
      364     end.
      365     else do:
      366       message "Вы действительно ходите начать процедуру создания начального диапазона локальных весовых кодов?"
      367               view-as alert-box QUESTION buttons YES-NO update g#loq.
      368       if not g#loq then do:
      369         return.
      370       end.
      371       create curr-seq-value.
      372       assign
      373         curr-seq-value.db-num    = 0
      374         curr-seq-value.seq-value = current-value( s-sclc-code, ub )
      375         .
      376     end.
      377     assign
      378       max-seq-value = 0
      379       db-wait = ""
      380     .
      381     for each buf_db no-lock
      382        where buf_db.db-num >= 0
      383     on error undo, return error :
      384       if max-seq-value <> ? then do:
      385         find curr-seq-value where curr-seq-value.db-num = buf_db.db-num no-lock no-error.
      386       end.
      387       if not available curr-seq-value then do:
      388         assign
      389           max-seq-value = ?
      390           db-wait       = db-wait + " " + string( buf_db.db-num )
      391         .
      392       end.
      393       else do:
      394         if curr-seq-value.seq-value > max-seq-value then do:
      395           assign
      396             max-seq-value = curr-seq-value.seq-value
      397           .
      398         end.
      399       end.
      400     end.
      401     if can-find( first curr-seq-value no-lock ) then do:
      402       if max-seq-value = ? then do:
      403         message "Еще не собрана информация из УБД" db-wait skip
      404                 "Дождаться сбора информации и запустить эту утилиту позже?"
      405                 view-as alert-box QUESTION buttons YES-NO update g#loq.
      406         if g#loq then do:
      407           return.
      408         end.
      409         else do:
      410           run clear-temp-table.
      411         end.
      412       end.
      413       else do:
      414         assign
      415           ind = 999
      416         .
      417         do while max-seq-value >= ind :
      418           assign
      419             ind = ind + 1000
      420           .
      421         end.
      422         assign
      423           max-seq-value = ind
      424         .
      425         output stream info to "del-cdrg.inf" append page-size 0 .
      426         put stream info unformatted cur-time-string-sec() skip .
      427         output stream info close .
      428         for each ub.code-range
      429           where ub.code-range.first-code >= 100
      430             and ub.code-range.last-code  <= 100000
      431         on error undo, return error
      432         :
      433           if lookup( ub.code-range.range-type, 'sslc,bcgb,sclc,scgb,ssgb,pglc,ptlc':U ) <> 0 then do:
      434             output stream info to "del-cdrg.inf" append page-size 0 .
      435             put stream info unformatted "code-range delete:" skip .
      436             export stream info ub.code-range .
      437             output stream info close .
      438             delete ub.code-range.
      439           end.
      440         end.
      441         for each ub.code-range
      442           where ub.code-range.first-code < 100
      443             and ub.code-range.last-code  <= 100000
      444         on error undo, return error
      445         :
      446           if lookup( ub.code-range.range-type, 'sslc,bcgb,sclc,scgb,ssgb,pglc,ptlc':U ) <> 0 then do:
      447             create tmp-c-range.
      448             buffer-copy ub.code-range to tmp-c-range .
      449             delete ub.code-range.
      450           end.
      451         end.
      452         for each tmp-c-range
      453         on error undo, return error
      454         :
      455           output stream info to "del-cdrg.inf" append page-size 0 .
      456           put stream info unformatted "code-range.last-code -> 99 :" skip .
      457           create buf_code-range.
      458           buffer-copy tmp-c-range to buf_code-range
      459             assign
      460               buf_code-range.range-type = 'ptlc':U
      461               buf_code-range.last-code  = 99
      462           .
      463           if buf_code-range.db-num = -1
      464              or buf_code-range.stts <> "f"
      465           then do:
      466             run str/callnews.p
      467               (input "code-range"
      468               ,input (buffer buf_code-range:handle)
      469               ).
      470           end.
      471           export stream info tmp-c-range .
      472           output stream info close .
      473           delete tmp-c-range.
      474         end.
      475         for each ub.code-range
      476           where ub.code-range.first-code < 100000
      477             and ub.code-range.last-code  > 100000
      478         on error undo, return error
      479         :
      480           if lookup( ub.code-range.range-type, 'sslc,bcgb,sclc,scgb,ssgb,pglc,ptlc':U ) <> 0 then do:
      481             create tmp-c-range.
      482             buffer-copy ub.code-range to tmp-c-range .
      483             delete ub.code-range.
      484           end.
      485         end.
      486         for each tmp-c-range
      487         on error undo, return error
      488         :
      489           output stream info to "del-cdrg.inf" append page-size 0 .
      490           put stream info unformatted "code-range.first-code -> 100000 :" skip.
      491           create buf_code-range.
      492           buffer-copy tmp-c-range to buf_code-range
      493             assign
      494               buf_code-range.first-code = 100000
      495           .
      496           if buf_code-range.db-num = -1
      497              or buf_code-range.stts <> "f"
      498           then do:
      499             run str/callnews.p
      500               (input "code-range"
      501               ,input (buffer buf_code-range:handle)
      502               ).
      503           end.
      504           export stream info tmp-c-range .
      505           output stream info close .
      506           if tmp-c-range.first-code < 100 then do:
      507             output stream info to "del-cdrg.inf" append page-size 0 .
      508             put stream info unformatted "create code-range:" skip.
      509             create buf_code-range.
      510             assign
      511               buf_code-range.range-type = 'ptlc':U
      512               buf_code-range.PS         = "auto"
      513               buf_code-range.beg-date   = today
      514               buf_code-range.first-code = 1
      515               buf_code-range.last-code  = 99
      516               buf_code-range.db-num     = 0
      517               buf_code-range.stts       = "u":U
      518             .
      519             export stream info buf_code-range .
      520             output stream info close .
      521             run str/callnews.p
      522               (input "code-range"
      523               ,input (buffer buf_code-range:handle)
      524               ).
      525           end.
      526           delete tmp-c-range.
      527         end.
      528         create ub.code-range.
      529         assign
      530           ub.code-range.range-type = 'sclc':U
      531           ub.code-range.PS         = "локальный весовой код"
      532           ub.code-range.beg-date   = today
      533           ub.code-range.first-code = 100
      534           ub.code-range.last-code  = max-seq-value
      535           ub.code-range.db-num     = 0
      536           ub.code-range.stts       = "a":U
      537         .
      538         run str/callnews.p
      539           (input "code-range"
      540           ,input (buffer ub.code-range:handle)
      541           ).
      542         release ub.code-range.
      543         run clear-temp-table.
      544         for each ub.rep
      545           where ub.rep.doc-num = -27091997
      546         on error undo, return error :
      547           delete ub.rep.
      548         end.
      549         message "Начальный диапазон локальных весовых кодов создан."
      550                 view-as alert-box information.
      551         return.
      552       end.
      553     end.
      554     if not can-find( first curr-seq-value no-lock ) then do:
      555       message "Вы действительно ходите начать процедуру создания начального диапазона локальных весовых кодов?"
      556               view-as alert-box QUESTION buttons YES-NO update g#loq.
      557       if not g#loq then do:
      558         return.
      559       end.
      560       for each buf_db no-lock
      561         where buf_db.db-num >= 0
      562       on error undo, return error :
      563         assign
      564           v-cmd = "get-seq" + chr(1) + "s-sclc-code" + chr(1) + ""
      565         .
      566         if v-db-send = "":U then do:
      567           assign
      568             v-db-send = string( buf_db.db-num )
      569           .
      570         end.
      571         else do:
      572           assign
      573             v-db-send = v-db-send + chr(1) + string( buf_db.db-num )
      574           .
      575         end.
      576       end.
      577       if v-db-send <> "":U then do:
      578         run nws/cr-route.p ( input 'send-cmd':U, input v-cmd, input ?, input v-db-send ).
      579       end.
      580       create ub.rep.
      581       assign
      582         ub.rep.doc-num = -27091997
      583         ub.rep.gr      = 0
      584         ub.rep.num     = current-value( s-sclc-code, ub )
      585       .
      586       message "Процедура создания начального диапазона локальных весовых кодов начата" skip
      587               "Необходимо обменяться новостями со всеми УБД." skip
      588               "После обмена запустите эти утилиты повторно."
      589               view-as alert-box information.
      590     end.
      591     run clear-temp-table.
      592   end.
      593   procedure clear-temp-table:
      594     for each curr-seq-value
      595     on error undo, return error :
      596       delete curr-seq-value.
      597     end.
      598   end procedure.
