        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-install     as logical no-undo init no .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: objprtat.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: utl/objprtat.p $":U .
        9   define variable vss-description as character no-undo init "Создание атрибутов партий".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table userobjs_temp-user-obj no-undo
       81     field obj-type as character
       82     field obj-code as integer
       83     index xpk is primary unique obj-type obj-code
       84     .
       85   procedure userobjs_clear :
       86     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       87     do
       88     on error undo, return error return-value
       89     :
       90       for each buf_userobjs_temp-user-obj
       91       on error undo, return error return-value
       92       :
       93         delete buf_userobjs_temp-user-obj .
       94       end.
       95     end.
       96   end .
       97   procedure userobjs_object-count :
       98     define output parameter p-total-count as integer   no-undo .
       99     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      100     do
      101     on error undo, return error return-value
      102     :
      103       assign
      104         p-total-count = 0
      105       .
      106       for each buf_userobjs_temp-user-obj
      107       on error undo, return error return-value
      108       :
      109         assign
      110           p-total-count = p-total-count + 1
      111         .
      112       end.
      113     end.
      114   end.
      115   procedure userobjs_append :
      116      define input  parameter p-obj-type as character no-undo .
      117      define input  parameter p-obj-code as integer   no-undo .
      118     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      119     do
      120     on error undo, return error return-value
      121     :
      122       find first buf_userobjs_temp-user-obj
      123         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      124           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      125         no-error .
      126       if not available buf_userobjs_temp-user-obj
      127       then do:
      128         create buf_userobjs_temp-user-obj .
      129         assign
      130           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      131           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      132         .
      133       end.
      134     end.
      135   end.
      136   procedure userobjs_object-exist :
      137     define output parameter p-object-exist as logical   no-undo .
      138     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      139     do
      140     on error undo, return error return-value
      141     :
      142       find first buf_userobjs_temp-user-obj
      143         no-error .
      144       if not available buf_userobjs_temp-user-obj
      145       then do:
      146         assign
      147           p-object-exist = false
      148         .
      149       end.
      150       else do:
      151         assign
      152           p-object-exist = true
      153         .
      154       end.
      155     end.
      156   end.
      157   procedure userobjs_transfer :
      158     define input  parameter p-callback-handle as handle no-undo .
      159     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      160     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      161     do
      162     on error undo, return error return-value
      163     :
      164       if valid-handle(p-callback-handle) <> true
      165       then do:
      166         message
      167           vss-workfile vss-revision vss-description skip
      168           "Ошибка задания входных параметров" skip
      169           "Неизвестный указатель на процедуру" skip
      170           view-as alert-box error .
      171         undo, return error return-value .
      172       end.
      173       if p-callback-handle :get-signature("userobjs_append") = ""
      174       then do:
      175         message
      176           vss-workfile vss-revision vss-description skip
      177           "Ошибка задания входных параметров" skip
      178           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      179                     ,p-callback-handle :file-name
      180                     ) skip
      181           view-as alert-box error .
      182         undo, return error return-value .
      183       end.
      184       for each buf_userobjs_temp-user-obj
      185       on error undo, return error return-value
      186       :
      187         run userobjs_append in p-callback-handle
      188           (input  buf_userobjs_temp-user-obj.obj-type
      189           ,input  buf_userobjs_temp-user-obj.obj-code
      190           ) .
      191       end.
      192     end.
      193   end procedure.
      194   procedure userobjs_select-one :
      195      define input  parameter parparentproc     as widget-handle no-undo .
      196      define input  parameter p-db-num          as integer   no-undo .
      197      define input  parameter p-user-id         as character no-undo .
      198      define input  parameter p-host-code-obj   as integer   no-undo .
      199      define input  parameter p-obj-type        as character no-undo .
      200      define input  parameter p-obj-code        as integer   no-undo .
      201      define output parameter p-user-select     as logical   no-undo .
      202      define output parameter p-select-obj-type as character no-undo .
      203      define output parameter p-select-obj-code as character no-undo .
      204     do
      205     on error undo, return error return-value
      206     :
      207       run gbl/userobjs.w
      208         (input  parparentproc
      209         ,input  this-procedure :handle
      210         ,input  p-db-num
      211         ,input  p-user-id
      212         ,input  p-host-code-obj
      213         ,input  p-obj-type
      214         ,input  p-obj-code
      215         ,INPUT  "b-sel"
      216         ,output p-user-select
      217         ,output p-select-obj-type
      218         ,output p-select-obj-code
      219         ) .
      220     end.
      221   end.
      222   procedure userobjs_select-many :
      223     define input  parameter parparentproc   as widget-handle no-undo .
      224     define input  parameter p-db-num        as integer   no-undo .
      225     define input  parameter p-user-id       as character no-undo .
      226     define input  parameter p-host-code-obj as integer   no-undo .
      227     define input  parameter p-obj-type      as character no-undo .
      228     define input  parameter p-obj-code      as integer   no-undo .
      229     define output parameter p-user-select   as logical   no-undo .
      230     define variable v-select-obj-type as character no-undo .
      231     define variable v-select-obj-code as integer   no-undo .
      232     do
      233     on error undo, return error return-value
      234     :
      235       run gbl/userobjs.w
      236         (input  parparentproc
      237         ,input  this-procedure :handle
      238         ,input  p-db-num
      239         ,input  p-user-id
      240         ,input  p-host-code-obj
      241         ,input  p-obj-type
      242         ,input  p-obj-code
      243         ,INPUT  "b-sel,b-mark"
      244         ,output p-user-select
      245         ,output v-select-obj-type
      246         ,output v-select-obj-code
      247         ) .
      248     end.
      249   end.
      250   procedure thobjs :
      251      define input        parameter parparentproc     as widget-handle no-undo .
      252      define input        parameter i-bttns           as character     no-undo .
      253      define input        parameter i-list-mode       as character     no-undo.
      254      define input        parameter i-obj-type        as character     no-undo.
      255      define input        parameter i-db-num          as integer       no-undo.
      256      define input        parameter i-host-code       as integer       no-undo.
      257      define input-output parameter p-rid-list        as character     no-undo .
      258   run ref/thobjs.p
      259           ( input parparentproc
      260            ,input  this-procedure :handle
      261           , input i-bttns
      262           , input i-list-mode
      263           , input i-obj-type
      264           , input i-db-num
      265           , input i-host-code
      266           , input-output p-rid-list ) no-error .
      267   end.
      268   define buffer buf_db      for ub.db .
      269   define buffer buf_clients for ub.clients .
      270   do
      271   on error undo, return error
      272   :
      273     define variable v-num as integer no-undo .
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275     run mainmenu_getcntxt in parparentproc
      276       (output v-cntxt-db-num
      277       ,output v-cntxt-userid
      278       ,output v-cntxt-level
      279       ,output v-cntxt-host-code-obj
      280       ,output v-cntxt-obj-type
      281       ,output v-cntxt-obj-code
      282       ,output v-cntxt-db-num-obj
      283       ,output v-cntxt-is-admin
      284       ) .
      285     if p-install = true then do:
      286       assign
      287         v-num = 1
      288       .
      289     end.
      290     else do:
      291       run gbl/d-askw.w
      292         (input "Вопрос"
      293         ,input "Создать атрибуты партий" + chr(10)
      294         ,input "|^"
      295         ,input "Все объекты^confirm|Выбрать объекты|Отмена"
      296         ,input "|"
      297             + "|"
      298             + ""
      299         ,input 1
      300         ,input 3
      301         ,output v-num
      302         ).
      303     end.
      304     case v-num :
      305       when 1 then do:
      306         for each buf_db no-lock
      307         on error undo, return error
      308         :
      309           for each buf_clients no-lock
      310             where buf_clients.db-num = buf_db.db-num
      311               and buf_clients.stts   = 0
      312           on error undo, return error
      313           :
      314             run utl/objatrcr.p
      315               (input buf_clients.obj-type
      316               ,input buf_clients.obj-code
      317               ) no-error .
      318             if error-status :error then do:
      319               message
      320                 vss-workfile vss-revision vss-description skip
      321                 "Ошибка при создании атрибутов партий" skip
      322                 "Объект" buf_clients.obj-type buf_clients.obj-code skip
      323                 error-status :get-message(1) skip
      324                 return-value skip
      325                 view-as alert-box error .
      326               undo, return error .
      327             end.
      328           end.
      329         end.
      330       end.
      331       when 2 then do:
      332         define variable v-user-select as logical   no-undo .
      333   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   run userobjs_select-many in this-procedure
      335     (input  parparentproc
      336     ,input  v-cntxt-db-num
      337     ,input  v-cntxt-userid
      338     ,input  v-cntxt-host-code-obj
      339     ,input  v-cntxt-obj-type
      340     ,input  v-cntxt-obj-code
      341     ,output v-user-select
      342     )  .
      343         if v-user-select <> true
      344         then do:
      345           message
      346             "Объект не выбран"
      347             view-as alert-box information .
      348           return .
      349         end.
      350         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      351         for each buf_userobjs_temp-user-obj
      352         :
      353           run utl/objatrcr.p
      354             (input buf_userobjs_temp-user-obj.obj-type
      355             ,input buf_userobjs_temp-user-obj.obj-code
      356             ) no-error .
      357           if error-status :error then do:
      358             message
      359               vss-workfile vss-revision vss-description skip
      360               "Ошибка при создании атрибутов партий" skip
      361               "Объект" buf_userobjs_temp-user-obj.obj-type buf_userobjs_temp-user-obj.obj-code skip
      362               error-status :get-message(1) skip
      363               return-value skip
      364               view-as alert-box error .
      365             undo, return error .
      366           end.
      367         end.
      368       end.
      369       when 3 then do:
      370         return .
      371       end.
      372     end.
      373     if p-install = false then do:
      374       message
      375         "Создание атрибутов партий закончено" skip
      376         view-as alert-box information .
      377     end.
      378     return .
      379   end.
