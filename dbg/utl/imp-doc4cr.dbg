      287   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288   procedure doc-code:
      289   define input  parameter parmode          as   character           no-undo.
      290   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      291   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      292   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      293   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      294   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      295   define variable vardb-remote     as   logical             no-undo.
      296   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      297   define variable v-delimiter as character no-undo .
      298   do
      299   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      300   :
      301   find first buf_sys-ctrl no-lock .
      302   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      303     CASE parmode:
      304       when "main":u then do:
      305         if vardb-remote then do:
      306           assign
      307             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      308         end.
      309         else do:
      310           assign
      311             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      312         end.
      313       end.
      314       when "trio" then do:
      315         assign
      316           pardoc-code = replace (parroot-doc-code, "=", "*").
      317       end.
      318       otherwise do:
      319         assign
      320         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      321         no-error
      322         .
      323         if error-status:error  then do:
      324           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      325                                         ,chr(10)
      326                                         ,parmode
      327                                         ).
      328         end.
      329         if num-entries(parmode) = 1
      330         and parmode <> "chip":U
      331         and parmode <> "chip_s":U
      332         then do:
      333           assign
      334           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      335         end.
      336         else if (lookup("chip":U, parmode) > 0
      337                  or
      338                  lookup("chip_s":U, parmode) > 0) then do:
      339           assign
      340             vartemp-doc-code = parroot-doc-code.
      341           do while true:
      342             if index (vartemp-doc-code , ".") = 0 then
      343               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      344             else
      345               vartemp-doc-code  =
      346               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      347               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      348               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      349             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      350           end.
      351           assign
      352             pardoc-code = vartemp-doc-code.
      353         end.
      354       end.
      355     end CASE.
      356     if pardoc-code = '':U
      357     or (parroot-doc-code <> '':U
      358     and pardoc-code = parroot-doc-code) then do:
      359       undo, return error substitute("Ошибка при генерации номера документа&1"
      360                                     ,chr(10)).
      361     end.
      362   end.
      363   end. // procedure/method
      364   function get-doc-code-int64 returns int64
      365     ( input p-doc-code as character ) :
      366     define variable v-ind              as integer   no-undo .
      367     define variable v-num-entries      as integer   no-undo .
      368     define variable v-doc-code-int64   as int64     no-undo .
      369     define variable v-canonic-doc-code as character no-undo .
      370     assign
      371       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      372       v-canonic-doc-code = p-doc-code
      373     .
      374     do v-ind = 1 to v-num-entries
      375     :
      376       assign
      377         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      378       .
      379     end.
      380     assign
      381       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      382     .
      383     return v-doc-code-int64 .
      384   end. // function/method
      385   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
