      688   .
      689   define temp-table tt-trn-close no-undo
      690     field trn-code as character
      691   .
      692   define temp-table tt-trn-doc   no-undo like ub.trn-doc .
      693   define temp-table tt2-doc-line no-undo like lib-trn_ret-line .
      694   define temp-table tt-doc-line  no-undo like ub.doc-line .
      695   define temp-table tt-gds-dtl   no-undo like ub.gds-dtl .
      696   define temp-table tt-parts     no-undo like ub.parts.
      697   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr .
      698   define temp-table gds-list1    no-undo like gds-list .
      699   define variable v-f-cli-code as integer   no-undo .
      700   define variable new_obj-code   as integer   no-undo .
      701   define variable new_obj-type   as character no-undo .
      702   define variable new_host-code  as integer   no-undo .
      703   define variable new_purch-code as integer no-undo .
      704   define variable v-tti as integer   no-undo .
      705   define variable v-print-rubl as logical   no-undo .
      706   define variable v-ii          as integer   no-undo .
      707   define buffer new_ext-classif for ub.ext-classif  .
      708   define buffer new_line        for temp-line  .
      709   define buffer buf2_temp_parts for temp_parts  .
      710   define buffer old_contract-specif for ub.contract-specif  .
      711   define buffer buf_shop        for ub.shop .
      712   define variable local-trace-on as logical no-undo .
      713   local-trace-on = false .
      714   define variable p-from-version as character initial 'v15_0000':U no-undo .
      715   run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Перенос партий свободной зоны из &1 в 16.0 ...", p-from-version) ).
      716     define variable v-db-num as integer   no-undo .
      717   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      719     (input  p-obj-type
      720     ,input  p-obj-code
      721     ,output v-db-num
      722     )  .
      723     if v-db-num <> ibs.th.gbl.gbl-var:g#db-num then do :
      724           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Накладные разрешается вкачивать только в объект текущей БД. Номер текущей базы данных &1, номер базы данных выбранного объекта &2", ibs.th.gbl.gbl-var:g#db-num, v-db-num) ).
      725       undo, throw new Progress.Lang.AppError (substitute("Накладные разрешается вкачивать только в объект текущей БД. Номер текущей базы данных &1, номер базы данных выбранного объекта &2", ibs.th.gbl.gbl-var:g#db-num, v-db-num)) .
      726     end .
      727     if p-is-close then do :
      728       if not can-find (first ub.pay-type where ub.pay-type.obj-code = v-cntxp-in-pay) then do:
      729               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("В настройках объекта &1 указан вид оплаты прихода &2, который отсутствует в справочнике.", p-obj-code, v-cntxp-in-pay) ).
      730         undo, throw new Progress.Lang.AppError (substitute("В настройках объекта &1 указан вид оплаты прихода &2, который отсутствует в справочнике.", p-obj-code, v-cntxp-in-pay)) .
      731       end .
      732     end .
      733   define stream fosnid.
      734   define temp-table w-osn no-undo
      735     field supp-type-15_0 as character
      736     field supp-code-15_0 as integer
      737     field supp-code-16_0 as integer
      738   .
      739   // 19/IX-2018 сопоставление товаров потребовалось переделать с артикулов на коды товаров
      740   define temp-table w-gds no-undo
      741     field gds-code-15_0 as int64
      742     field gds-code-16_0 as integer
      743   .
      744   run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("чтение файла соответствия поставщиков &1", p-osn-fname) ).
      745     file-info:file-name = p-osn-fname .
      746     if file-info:file-type = ? then do :
      747           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Отсутствует файл для импорта &1", p-osn-fname) ).
      748       undo, throw new Progress.Lang.AppError (substitute("Отсутствует файл для импорта &1", p-osn-fname)) .
      749     end .
      750   input stream fosnid from value (p-osn-fname).
      751   repeat:
      752     define variable v-osn-15 as character no-undo .
      753     define variable v-osn-16 as integer no-undo .
      754     define variable v-error  as logical no-undo .
      755     import stream fosnid delimiter ';' v-osn-15 v-osn-16.
      756     create w-osn.
      757       w-osn.supp-type-15_0 =         substring(v-osn-15, 1, 3) no-error .
      758       if error-status:error then v-error = true .
      759       w-osn.supp-code-15_0 = integer(substring(v-osn-15, 4)) no-error .
      760       if error-status:error then v-error = true .
      761       w-osn.supp-code-16_0 =                   v-osn-16 no-error .
      762   if v-error then do:
      763           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Не правильная кодировка в файле для импорта &1", p-osn-fname) ).
      764   end.
      765   end.
      766   input stream fosnid close.
      767   run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("чтение файла соответствия товаров &1", p-art-fname) ).
      768   input stream fosnid from value (p-art-fname).
      769   repeat:
      770     create w-gds.
      771     import stream fosnid delimiter ';' w-gds.
      772   end.
      773   input stream fosnid close.
      774   find w-gds where w-gds.gds-code-16_0 = 0 and w-gds.gds-code-15_0 = 0 no-error.
      775   if available w-gds then delete w-gds.
      776     assign
      777       new_obj-type = p-obj-type
      778       new_obj-code = p-obj-code
      779     .
      780     find first buf_shop no-lock where buf_shop.obj-code = new_obj-code no-error .
      781     if available buf_shop then do:
      782       new_purch-code = if buf_shop.purch-code > 0 then buf_shop.purch-code else 1 .
      783     end .
      784     else new_purch-code = 1 .
      785   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      787     (input  new_obj-type
      788     ,input  new_obj-code
      789     ,output new_host-code
      790     )  .
      791   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtget in g#library
      793     (input  new_obj-type
      794     ,input  new_obj-code
      795     ,output to-day
      796     ) no-error .
      797       empty temp-table temp-line no-error .
      798       EMPTY TEMP-TABLE temp_parts no-error .
      799       empty temp-table tt-parts .
      800   define stream f-err-lines .
      801   if p-retry-fname > '' then . else do :
      802     p-retry-fname = substitute("&1imp-parts.err", ibs.th.gbl.gbl-inipar:logDir ) .
      803   end .
      804   output stream f-err-lines to value(p-retry-fname) .
      805   run create_temp_parts in this-procedure
      806      (new_obj-code
      807     , new_obj-type
      808     , new_host-code
      809     , output p-count-err
      810     , output p-count-err1
      811     , output p-count-err2
      812     ).
      813   output stream f-err-lines close .
      814   empty temp-table tt-trn-close .
      815   run import-hed in this-procedure no-error .
      816       if error-status :error then do:
      817               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("ошибка при импорте ПН  &1 &2" , error-status :get-message(1) , return-value ) ).
      818         return error  .
      819       end.
      820     for each tt-trn-close :
      821   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input tt-trn-close.trn-code ,
      822                          input 'is-auto-trn':U ,
      823                          input yes ) no-error .
      824           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute(" Закрытие документа &1 на ФАКТ" , tt-trn-close.trn-code ) ).
      825       run clos-trn2 in this-procedure (tt-trn-close.trn-code) no-error .
      826       if not can-find (first trn-doc where trn-doc.doc-code = tt-trn-close.trn-code
      827                                        and trn-doc.status_  = 'факт':U) then do:
      828               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Не удалось закрыть на факт ПН &1 &2 &3" ,tt-trn-close.trn-code , return-value , error-status :get-message(1) ) ).
      829        end.
      830     end .
      831       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("При переносе остатков по товарам отвергнуто &1 записей. Из них:", p-count-err ) ).
      832       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("  нет соответствий по товарам &1", p-count-err1 ) ).
      833       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("  нет соответствий по поставщикам &1", p-count-err2 ) ).
      834       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("  прочие ошибки &1", p-count-err - p-count-err2 - p-count-err1 ) ).
      835   define stream f-tgds .
      836   function getImpRow returns character private (buffer buf_tt-parts for tt-imp-parts) :
      837   define variable v-imp-row as character no-undo .
      838     v-imp-row =
      839             substitute("&1;", buf_tt-parts.artic) +
      840             ";" +
      841             substitute("&1;", buf_tt-parts.part-code) +
      842             substitute("&1;", buf_tt-parts.in-code) +
      843             substitute("&1;", buf_tt-parts.gds-code) +
      844             substitute("&1;", buf_tt-parts.price-rubl) +
      845             substitute("&1;", buf_tt-parts.fact-qnty) +
      846             ";" +
      847             ";" +
      848             ";" +
      849             substitute("&1;", buf_tt-parts.vat-tax-value) +
      850             ";" +
      851             ";" +
      852             substitute("&1;", buf_tt-parts.name-gtd) +
      853             ";" +
      854             ";" +
      855             substitute("&1;", buf_tt-parts.srok-god) +
      856             ";" +
      857             ";" +
      858             substitute("&1;", buf_tt-parts.supp-code) +
      859             substitute("&1;", buf_tt-parts.supp-type) +
      860             substitute("&1", buf_tt-parts.cont-prn-code)
      861     .
      862     return v-imp-row .
      863   end function .
      864   procedure create_temp_parts private :
      865   define input  parameter p-obj-code  as integer no-undo .
      866   define input  parameter p-obj-type  as character no-undo .
      867   define input  parameter p-host-code as integer no-undo .
      868   define output parameter p-count-err as integer no-undo .
      869   define output parameter p-count-err1 as integer no-undo .
      870   define output parameter p-count-err2 as integer no-undo .
      871   define variable v-last-date as date no-undo .
      872   define variable v-artic     as character no-undo .
      873   define variable v-prod-type as character no-undo .
      874   define variable v-prod-code as integer no-undo .
      875   define variable v-contract-code as integer no-undo .
      876   define variable new_cli-type  as character no-undo .
      877   define variable new_cli-code  as integer   no-undo .
      878   define variable new_gds-code  as integer no-undo .
      879   define variable v-is-supp-err as logical no-undo .
      880   define variable v-is-cont-err as logical no-undo .
      881   define variable v-is-good-err as logical no-undo .
      882   define variable v-my-message  as character no-undo .
      883   define variable v-today       as date no-undo .
      884   define buffer buf_tt-parts for tt-imp-parts .
      885   define buffer buf_goods    for ub.goods .
      886   define buffer buf_contract for ub.contract .
      887   define buffer new_clients  for ub.clients .
      888     assign
      889       p-count-err  = 0
      890       p-count-err1 = 0
      891       p-count-err2 = 0
      892       v-today = today
      893     .
      894     for each buf_tt-parts
      895     break by buf_tt-parts.supp-code
      896           by buf_tt-parts.cont-prn-code
      897           by buf_tt-parts.gds-code
      898     :
      899       if first-of (buf_tt-parts.supp-code) then do:
      900           v-is-supp-err = no.
      901         if buf_tt-parts.supp-type = ""
      902         then assign
      903           v-my-message  = substitute ("Фиктивный контрагент &1 &2", buf_tt-parts.supp-type, buf_tt-parts.supp-code )
      904           v-is-supp-err = true
      905         .
      906         else do :
      907           find first w-osn where w-osn.supp-code-15_0 = buf_tt-parts.supp-code
      908                              and w-osn.supp-type-15_0 = buf_tt-parts.supp-type no-error .
      909           if available w-osn then do:
      910             assign
      911               new_cli-type = 'орг':U
      912               new_cli-code = w-osn.supp-code-16_0
      913             .
      914             v-is-supp-err = not can-find (first new_clients no-lock
      915                                           where new_clients.obj-type = new_cli-type
      916                                             and new_clients.obj-code = new_cli-code) .
      917             if v-is-supp-err then v-my-message = substitute("ошибка (новый клиент &1 &2)", new_cli-type , new_cli-code) .
      918           end .
      919           else assign
      920             v-my-message  = substitute ( "Отсутствует код поставщика &1 &2 в файле соответствия &3"
      921                                        , buf_tt-parts.supp-type, buf_tt-parts.supp-code, p-osn-fname )
      922             v-is-supp-err = true
      923           .
      924         end .
      925         if v-is-supp-err then do :
      926           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
      927         end .
      928       end .
      929       if v-is-supp-err then do :
      930         if buf_tt-parts.imp-row > "" then
      931           put stream f-err-lines unformatted buf_tt-parts.imp-row skip .
      932         else
      933           put stream f-err-lines unformatted getImpRow(buffer buf_tt-parts) skip .
      934         p-count-err = p-count-err + 1 .
      935         p-count-err2 = p-count-err2 + 1 .
      936         next .
      937       end .
      938       if first-of (buf_tt-parts.cont-prn-code) then do:
      939         find first buf_contract no-lock
      940              where buf_contract.contract-prn-code = buf_tt-parts.cont-prn-code
      941              and buf_contract.cli-type = new_cli-type
      942              and buf_contract.cli-code = new_cli-code no-error .
      943         if available buf_contract then assign
      944           v-contract-code = buf_contract.contract-code
      945           v-is-cont-err   = false
      946         .
      947         else do :
      948           v-my-message  = substitute (
      949             "Предупреждение. Отсутствует договор № &2 (вер.15) по поставщику &3 в вер.16. Товар &1 в вер.15",
      950             buf_tt-parts.gds-code, buf_tt-parts.cont-prn-code, new_cli-code ) .
      951           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
      952           assign
      953             v-contract-code = 0
      954             v-is-cont-err   = true
      955           .
      956           for each buf_contract no-lock
      957              where buf_contract.cli-type = new_cli-type
      958                and buf_contract.cli-code = new_cli-code
      959                 by buf_contract.contract-date-beg descending :
      960             if buf_contract.contract-date-end < v-today then . else do :
      961               v-my-message  = substitute (
      962                 "Предупреждение. Вместо договора № &2 (вер.15) по поставщику &3 в вер.16 используется договор &4 (код=&5). Товар &1 в вер.15&6",
      963                 buf_tt-parts.gds-code, buf_tt-parts.cont-prn-code, new_cli-code,
      964                 buf_contract.contract-prn-code, buf_contract.contract-code, chr(10) ) .
      965               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
      966               assign
      967                 v-contract-code = buf_contract.contract-code
      968                 v-is-cont-err   = false
      969               .
      970               leave .
      971             end .
      972           end .
      973           if v-is-cont-err then do :
      974             v-my-message  = substitute (
      975               "Ошибка. Отсутствует действующий договор на дату &3 по поставщику &2 в вер.16. Товар &1 в вер.15&4",
      976               buf_tt-parts.gds-code, new_cli-code, v-today, chr(10) ) .
      977             run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
      978           end .
      979         end .
      980       end .
      981       if v-is-cont-err then do :
      982         if buf_tt-parts.imp-row > "" then
      983           put stream f-err-lines unformatted buf_tt-parts.imp-row skip .
      984         else
      985           put stream f-err-lines unformatted getImpRow(buffer buf_tt-parts) skip .
      986         p-count-err = p-count-err + 1 .
      987         p-count-err2 = p-count-err2 + 1 .
      988         next .
      989       end .
      990       if first-of (buf_tt-parts.gds-code) then do:
      991         find first w-gds where w-gds.gds-code-15_0 = buf_tt-parts.gds-code no-error .
      992         if available w-gds then do :
      993           new_gds-code = w-gds.gds-code-16_0 .
      994           find first buf_goods no-lock
      995                where buf_goods.gds-code = new_gds-code no-error .
      996           if available buf_goods then assign
      997             v-artic     = buf_goods.artic
      998             v-prod-type = buf_goods.prod-type
      999             v-prod-code = buf_goods.prod-code
     1000             v-is-good-err = false
     1001           .
     1002           else assign
     1003             v-artic     = ""
     1004             v-prod-type = ""
     1005             v-prod-code = 0
     1006             v-is-good-err = true
     1007             v-my-message  = substitute ("Отсутствует товар с кодом &1 в справочнике товаров БД вер.16. Код в 15 &2", new_gds-code ,buf_tt-parts.gds-code )
     1008           .
     1009         end .
     1010         IF AVAILABLE buf_goods THEN DO:
     1011               run unitqnty (
     1012                input "",
     1013                input buf_goods.artic,
     1014                input buf_goods.prod-type,
     1015                input buf_goods.prod-code,
     1016                input "",
     1017                input buf_tt-parts.fact-qnty )
     1018                no-error.
     1019               if error-status:error then   do:
     1020                    v-is-good-err = TRUE .
     1021                    v-my-message  = RETURN-VALUE .
     1022               end.
     1023         END.
     1024         else assign
     1025           v-my-message  = substitute ("Отсутствует код товара &1 из вер.15 в файле соответствия &2", buf_tt-parts.gds-code, p-art-fname )
     1026           v-is-good-err = true
     1027         .
     1028         if v-is-good-err then do :
     1029           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
     1030         end .
     1031       end .
     1032       if v-is-good-err then do :
     1033         if buf_tt-parts.imp-row > "" then
     1034           put stream f-err-lines unformatted buf_tt-parts.imp-row skip .
     1035         else
     1036           put stream f-err-lines unformatted getImpRow(buffer buf_tt-parts) skip .
     1037         p-count-err = p-count-err + 1 .
     1038         p-count-err1 = p-count-err1 + 1 .
     1039         next .
     1040       end .
     1041       if buf_tt-parts.srok-god = "" then v-last-date = 01/01/2001 .
     1042                                     else v-last-date = date(buf_tt-parts.srok-god) no-error .
     1043       do :
     1044       create temp_parts.
     1045       assign
     1046         temp_parts.artic      = v-artic // 19/IX-2018 поле из импорта buf_tt-parts.artic игнорируется
     1047         temp_parts.prod-type  = v-prod-type
     1048         temp_parts.prod-code  = v-prod-code
     1049         temp_parts.obj-type   = p-obj-type
     1050         temp_parts.obj-code   = p-obj-code
     1051         temp_parts.host-code  = p-host-code
     1052         temp_parts.supp-code  = new_cli-code
     1053         temp_parts.supp-type  = new_cli-type
     1054         temp_parts.new-cli-type = new_cli-type
     1055         temp_parts.new-cli-code = new_cli-code
     1056         temp_parts.contract-code = v-contract-code
     1057   //  field cont-prn-code like ub.contract.contract-prn-code
     1058         temp_parts.in-code    = buf_tt-parts.in-code // temp_parts.in-code используется для распределения партий по накладным; далее после записи документа в БД перезатирается номером созданного документа внутри стандартных процедур
     1059   //      temp_parts.out-code создаётся пустым и потом заполняется номером документа, в который внесён товар по данной партии
     1060         temp_parts.part-code  = buf_tt-parts.part-code // Код, определяющий конкретную партию внутри одного прихода
     1061   //  field gds-code      as integer - в таблице parts не предусмотрено поле gds-code
     1062         temp_parts.price-rubl = buf_tt-parts.price-rubl // вместо price-cli используется price-rubl
     1063         temp_parts.fact-qnty  = buf_tt-parts.fact-qnty
     1064         temp_parts.VAT-type   = 'в т. ч.':U
     1065         temp_parts.VAT-pc     = buf_tt-parts.vat-tax-value
     1066         temp_parts.cst-code   = buf_tt-parts.name-gtd
     1067         temp_parts.last-date  = v-last-date
     1068       .
     1069       end .
     1070       do :
     1071       end .
     1072     end .
     1073   // output stream f-tgds close .
     1074     if p-count-err > 0 then do :
     1075       v-my-message  = substitute (
     1076         "Строки с ошибками выведены в файл &1. Файл предназначен для повторного импорта в ручном режиме"
     1077       , p-retry-fname ) .
     1078       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, v-my-message ).
     1079     end .
     1080   if local-trace-on then do:
     1081    define variable dsXmlFileName as character no-undo .
     1082    dsXmlFileName = substitute("&1/&2.xml", ibs.th.gbl.gbl-inipar:logDir, "temp_parts").
     1083    temp-table temp_parts:WRITE-XML ( "FILE", dsXmlFileName, true, "UTF-8").
     1084   end .
     1085   end procedure .
     1086   procedure import-hed :
     1087   define variable v-qnty-fact as decimal   no-undo .
     1088   define variable v-qnty-cli  as decimal   no-undo .
     1089   define variable v-num       as integer   no-undo .
     1090   define variable dsXmlFileName as character no-undo .
     1091   define variable dsLineCount   as integer no-undo .
     1092   // Message "Обработка файла" p-in-file view-as alert-box .
     1093   do on error undo, return error substitute("ошибка &1 &2", error-status:get-message(1) , return-value) :
     1094     assign
     1095     v-qnty-fact = 0
     1096     v-qnty-cli  = 0
     1097     dsLineCount = 0
     1098     .
     1099       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Подготовка партий..."  ) ).
     1100     for each temp_parts break
     1101      by temp_parts.supp-type
     1102      by temp_parts.supp-code
     1103      by temp_parts.host-code
     1104      by temp_parts.contract-code
     1105      by temp_parts.VAT-type
     1106      by temp_parts.VAT-PC
     1107      by temp_parts.prod-type
     1108      by temp_parts.prod-code
     1109      by temp_parts.artic
     1110      by temp_parts.price-rubl
     1111      :
     1112       dsLineCount = dsLineCount + 1 .
     1113       do on error undo, next :
     1114               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Товар &1 " , temp_parts.artic ) ).
     1115       create tt-parts.
     1116       assign
     1117         tt-parts.prod-type      = temp_parts.prod-type
     1118         tt-parts.prod-code      = temp_parts.prod-code
     1119         tt-parts.artic          = temp_parts.artic
     1120         tt-parts.obj-type       = new_obj-type
     1121         tt-parts.obj-code       = new_obj-code
     1122         tt-parts.host-code      = new_host-code
     1123         tt-parts.supp-type      = temp_parts.new-cli-type
     1124         tt-parts.supp-code      = temp_parts.new-cli-code
     1125         tt-parts.price-base     = temp_parts.price-rubl
     1126         tt-parts.price-rubl     = temp_parts.price-rubl
     1127         tt-parts.price-cli      = temp_parts.price-rubl
     1128         tt-parts.cli-base-rate  = 1
     1129         tt-parts.qnty           = temp_parts.fact-qnty
     1130         tt-parts.fact-qnty      = temp_parts.fact-qnty
     1131         tt-parts.cli-qnty       = temp_parts.fact-qnty
     1132         tt-parts.VAT-pc         = temp_parts.vat-pc
     1133         tt-parts.VAT-type       = temp_parts.vat-type
     1134         tt-parts.SLT-pc         = 0
     1135         tt-parts.SLT-type       = 'без':U
     1136         tt-parts.road-tax-base  = 0
     1137         tt-parts.road-tax-rubl  = 0
     1138         tt-parts.transport-base = 0
     1139         tt-parts.transport-rubl = 0
     1140         tt-parts.other-base     = 0
     1141         tt-parts.other-rubl     = 0
     1142         tt-parts.PS             = ""
     1143         tt-parts.fact-date      = ? // источник заполнения new_trn-doc.fact-date отсутствует
     1144         tt-parts.fact-num       = 0
     1145         // tt-parts.pay-code заполняется непосредственно в tt-trn-doc
     1146         tt-parts.rsrv-free      = ?
     1147         tt-parts.pl-code        = 0
     1148         tt-parts.exch-code      = 0
     1149         tt-parts.is-supp        = yes
     1150         tt-parts.last-date      = ?
     1151         tt-parts.purch-code     = ? // источник заполнения new_trn-doc.purch-code отсутствует
     1152         tt-parts.contract-code  = temp_parts.contract-code
     1153         tt-parts.doc-type       = 'при':U
     1154         tt-parts.part-code      = temp_parts.part-code + string(dsLineCount)
     1155         tt-parts.in-code        = temp_parts.in-code   // в исходной версии - new_trn-doc.doc-code
     1156         tt-parts.out-code       = "" // new_trn-doc.doc-code
     1157         tt-parts.cst-code       = ""
     1158         tt-parts.status_        = no
     1159         no-error.
     1160        if error-status:error then do:
     1161            message 'ошибка импорта товара с артикулом' tt-parts.artic temp_parts.in-code temp_parts.out-code view-as alert-box.
     1162            end.
     1163       end .
     1164       v-qnty-fact = v-qnty-fact + temp_parts.fact-qnty  .
     1165       v-qnty-cli  = v-qnty-cli  + temp_parts.cli-qnty  . // - не заполняется
     1166       if last-of ( temp_parts.price-rubl ) then do:
     1167         create temp-line .
     1168         assign
     1169         temp-line.supp-type     = temp_parts.supp-type
     1170         temp-line.supp-code     = temp_parts.supp-code
     1171         temp-line.host-code     = temp_parts.host-code
     1172         temp-line.contract-code = temp_parts.contract-code
     1173         temp-line.vat-type      = temp_parts.vat-type
     1174         temp-line.vat-pc        = temp_parts.vat-pc
     1175         temp-line.prod-type     = temp_parts.prod-type
     1176         temp-line.prod-code     = temp_parts.prod-code
     1177         temp-line.artic         = temp_parts.artic
     1178         temp-line.price-rubl    = temp_parts.price-rubl
     1179   // 21/V-2018 temp-line.part-code     = temp_parts.part-code
     1180   //  field num           as integer
     1181         temp-line.fact-qnty     = v-qnty-fact
     1182         temp-line.cli-qnty      = v-qnty-cli
     1183         temp-line.new-cli-type  = temp_parts.new-cli-type
     1184         temp-line.new-cli-code  = temp_parts.new-cli-code
     1185         v-qnty-fact = 0
     1186         v-qnty-cli  = 0
     1187         .
     1188       end.
     1189   if local-trace-on then do:
     1190    dsXmlFileName = substitute("&1/&2-&3.xml", ibs.th.gbl.gbl-inipar:logDir, "tt_parts", string(dsLineCount, "9999999")).
     1191    temp-table tt-parts:WRITE-XML ( "FILE", dsXmlFileName, true, "UTF-8").
     1192   end.
     1193     end.
     1194       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("обработано &1 партий", dsLineCount  ) ).
     1195     for each temp-line  break
     1196     by temp-line.supp-type
     1197     by temp-line.supp-code
     1198     by temp-line.host-code
     1199     by temp-line.contract-code
     1200     by temp-line.vat-type
     1201     by temp-line.vat-pc
     1202     by temp-line.prod-type
     1203     by temp-line.prod-code
     1204     by temp-line.artic
     1205     :
     1206       if first-of (temp-line.artic) then do:
     1207         v-num = 0 .
     1208       end.
     1209       v-num = v-num + 1 .
     1210       temp-line.num = v-num .
     1211     end.
     1212   if local-trace-on then do:
     1213    dsXmlFileName = substitute("&1/&2.xml", ibs.th.gbl.gbl-inipar:logDir, "temp_line").
     1214    temp-table temp-line:WRITE-XML ( "FILE", dsXmlFileName, true, "UTF-8").
     1215   end.
     1216     for each temp-line break
     1217     by temp-line.supp-type
     1218     by temp-line.supp-code
     1219     by temp-line.host-code
     1220     by temp-line.contract-code
     1221     by temp-line.vat-type
     1222     by temp-line.vat-pc
     1223     by temp-line.num
     1224     :
     1225       if first-of (temp-line.num) then do:
     1226         empty temp-table tt-trn-doc .
     1227         empty temp-table tt2-doc-line .
     1228         empty temp-table tt-doc-line .
     1229         empty temp-table tt-gds-dtl .
     1230         for each lib-trn_ret-doc :
     1231           delete lib-trn_ret-doc.
     1232         end.
     1233         for each lib-trn_ret-line :
     1234           delete lib-trn_ret-line      .
     1235         end.
     1236         for each lib-trn_ret-line-attr :
     1237           delete lib-trn_ret-line.
     1238         end.
     1239         for each lib-trn_ret-dtl :
     1240           delete lib-trn_ret-dtl.
     1241         end.
     1242         for each lib-trn_ret-parts :
     1243           delete lib-trn_ret-parts .
     1244         end.
     1245                   run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Обработка линий &1 " , temp_parts.artic ) ).
     1246         run create-nakl in this-procedure  ( temp-line.num, temp-line.new-cli-type, temp-line.new-cli-code ) .
     1247       end.
     1248     end.
     1249   end.
     1250   end procedure.
     1251   procedure create-nakl :
     1252   define input parameter p-num        as integer no-undo .
     1253   define input parameter new_cli-type as character no-undo .
     1254   define input parameter new_cli-code as integer no-undo .
     1255   define variable n-d as character no-undo .
     1256   define variable v-ext-doc-type as character no-undo .
     1257   define buffer buf_goods for ub.goods .
     1258   define buffer new_trn-doc     for ub.trn-doc  .
     1259   do on error undo, return error return-value :
     1260     run doc-code in this-procedure
     1261       (input  "main":u,
     1262        input  new_obj-type,
     1263        input  new_obj-code,
     1264        input  ?,
     1265        output n-d ) no-error.
     1266     if error-status:error then do:
     1267           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Ошибка при генерации номера документа &1 &2: &3 | &4" ,new_obj-type, new_obj-code, error-status:get-message(1), return-value ) ).
     1268       undo, throw new Progress.Lang.AppError(substitute("Ошибка при генерации номера документа &1 &2: &3 | &4" ,new_obj-type, new_obj-code, error-status:get-message(1), return-value )) .
     1269     end.
     1270       run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Создание ПН № &1 объект &2&3 контраг &4&5 &6 Товар " , n-d  , new_obj-type , new_obj-code ,  new_cli-type ,  new_cli-code , temp-line.contract-code ) ).
     1271     assign
     1272       v-ext-doc-type = 'ie':U
     1273     .
     1274     find first temp_parts where
     1275                temp_parts.artic         = temp-line.artic     and
     1276                temp_parts.prod-type     = temp-line.prod-type and
     1277                temp_parts.prod-code     = temp-line.prod-code and
     1278                temp_parts.supp-code     = temp-line.supp-code and
     1279                temp_parts.supp-type     = temp-line.supp-type and
     1280                temp_parts.host-code     = temp-line.host-code and
     1281                temp_parts.vat-type      = temp-line.vat-type  and
     1282                temp_parts.vat-pc        = temp-line.vat-pc    and
     1283                temp_parts.contract-code = temp-line.contract-code  and
     1284                temp_parts.price-rubl    = temp-line.price-rubl no-error .
     1285     if not available temp_parts then do:
     1286       message "Parts not found" skip
     1287    "artic:" temp-line.artic skip
     1288    "prod-type:" temp-line.prod-type skip
     1289    "prod-code:" temp-line.prod-code skip
     1290    "supp-code:" temp-line.supp-code skip
     1291    "supp-type:" temp-line.supp-type skip
     1292    "host-code:" temp-line.host-code skip
     1293    "vat-type:" temp-line.vat-type skip
     1294    "vat-pc:" temp-line.vat-pc skip
     1295    "contract-code:" temp-line.contract-code skip
     1296    "part-code:" temp-line.part-code skip
     1297    "price-rubl:" temp-line.price-rubl skip
     1298       view-as alert-box.
     1299       return.
     1300     end .
     1301     do :
     1302     create  tt-trn-doc.
     1303     buffer-copy temp_parts to tt-trn-doc
     1304     assign
     1305       tt-trn-doc.status_       = "temp"
     1306       tt-trn-doc.doc-code      = n-d
     1307       tt-trn-doc.doc-date      = to-day
     1308       tt-trn-doc.cli-type      = new_cli-type
     1309       tt-trn-doc.cli-code      = new_cli-code
     1310       tt-trn-doc.obj-type      = new_obj-type
     1311       tt-trn-doc.obj-code      = new_obj-code
     1312       tt-trn-doc.host-code     = new_host-code
     1313       tt-trn-doc.contract-code = temp-line.contract-code
     1314       tt-trn-doc.doc-type      = 'при':U
     1315       tt-trn-doc.internal      = false
     1316       tt-trn-doc.cr-db-num     = ibs.th.gbl.gbl-var:g#db-num
     1317       tt-trn-doc.office        = false
     1318       tt-trn-doc.fact-num      = 0
     1319       tt-trn-doc.PS            = "Перенос остатков"
     1320       tt-trn-doc.creid         = ibs.th.gbl.gbl-var:g#userid
     1321       tt-trn-doc.flag_         = false
     1322       tt-trn-doc.ext-doc-type  = v-ext-doc-type
     1323       tt-trn-doc.discnt-type   = ""
     1324       tt-trn-doc.ret-supp      = false
     1325       tt-trn-doc.pay-code      = v-cntxp-in-pay
     1326       tt-trn-doc.purch-code    = new_purch-code
     1327       tt-trn-doc.SLT-type      = 'без':U // ранее это значение присвоилось во все tt-parts.SLT-type, но не в temp_parts
     1328     .
     1329     if tt-trn-doc.exch-code = ? then tt-trn-doc.exch-code = 0 .
     1330   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1332     (input  new_host-code
     1333     ,input  temp_parts.fact-date
     1334     ,output tt-trn-doc.base-rate
     1335     ,output tt-trn-doc.base-scale
     1336     ) no-error .
     1337     if tt-trn-doc.base-rate  = ? or tt-trn-doc.base-rate  = 0 then tt-trn-doc.base-rate  = 1 .
     1338     if tt-trn-doc.base-scale = ? or tt-trn-doc.base-scale = 0 then tt-trn-doc.base-scale = 1 .
     1339     if tt-trn-doc.exch-rate  = ? or tt-trn-doc.exch-rate  = 0 then tt-trn-doc.exch-rate  = 1 .
     1340     if tt-trn-doc.exch-scale = ? or tt-trn-doc.exch-scale = 0 then tt-trn-doc.exch-scale = 1 .
     1341   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
     1342   (input tt-trn-doc.acc-date
     1343   ,input tt-trn-doc.bge-date
     1344   ,input tt-trn-doc.base-rate
     1345   ,input tt-trn-doc.base-scale
     1346   ,input tt-trn-doc.cli-code
     1347   ,input tt-trn-doc.cli-type
     1348   ,input tt-trn-doc.cli-name
     1349   ,input tt-trn-doc.cr-db-num
     1350   ,input tt-trn-doc.creid
     1351   ,input tt-trn-doc.discnt-type
     1352   ,input tt-trn-doc.doc-code
     1353   ,input tt-trn-doc.doc-date
     1354   ,input tt-trn-doc.doc-type
     1355   ,input tt-trn-doc.flag_
     1356   ,input tt-trn-doc.host-code
     1357   ,input tt-trn-doc.internal
     1358   ,input tt-trn-doc.obj-code
     1359   ,input tt-trn-doc.obj-type
     1360   ,input tt-trn-doc.office
     1361   ,input tt-trn-doc.pay-code
     1362   ,input tt-trn-doc.ps
     1363   ,input tt-trn-doc.ret-supp
     1364   ,input tt-trn-doc.slt-type
     1365   ,input tt-trn-doc.status_
     1366   ,input tt-trn-doc.vat-type
     1367   ,input tt-trn-doc.ext-doc-type
     1368   ,input tt-trn-doc.purch-code
     1369   ) no-error
     1370   .
     1371     if error-status :error then do:
     1372           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Ошибка при генерации  документа1 &1 &2" , return-value , error-status :get-message(1) ) ).
     1373       return error return-value .
     1374     end.
     1375     end .
     1376     find first new_trn-doc where new_trn-doc.doc-code = n-d  exclusive-lock no-error .
     1377     if error-status :error then do:
     1378           run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Ошибка при генерации  документа2 &1 &2" , return-value , error-status :get-message(1) ) ).
     1379       return error return-value .
     1380     end.
     1381     assign
     1382      new_trn-doc.contract-code = temp-line.contract-code
     1383      new_trn-doc.exch-rate   = tt-trn-doc.exch-rate
     1384      new_trn-doc.exch-scale  = tt-trn-doc.exch-scale
     1385      new_trn-doc.exch-date   = to-day
     1386      new_trn-doc.exch-code   = tt-trn-doc.exch-code
     1387      new_trn-doc.status_     = 'накл':U
     1388      new_trn-doc.hold-doc-code-child   = "no-hold"
     1389      new_trn-doc.hold-doc-code-parent  = "no-hold"
     1390      new_trn-doc.print-rubl  = v-print-rubl
     1391      new_trn-doc.reason-code = 24
     1392     .
     1393    define variable dsXmlFileName1 as character no-undo .
     1394    define variable dsXmlFileName2 as character no-undo .
     1395    define variable dsXmlFileName3 as character no-undo .
     1396   // dsXmlFileName1 = substitute("&1/&2.xml", ibs.th.gbl.gbl-inipar:logDir, "tt-doc-line0").
     1397   // dsXmlFileName2 = substitute("&1/&2.xml", ibs.th.gbl.gbl-inipar:logDir, "tt2-doc-line0").
     1398     for each    new_line where
     1399                 new_line.supp-type      = temp_parts.supp-type     and
     1400                 new_line.supp-code      = temp_parts.supp-code     and
     1401                 new_line.host-code      = temp_parts.host-code     and
     1402                 new_line.vat-type       = temp_parts.vat-type      and
     1403                 new_line.vat-pc         = temp_parts.vat-pc        and
     1404                 new_line.contract-code  = temp_parts.contract-code and
     1405                 new_line.num            = p-num :
     1406       if new_line.price-rubl <= 0  or new_line.price-rubl = ? then do:
     1407               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Цена &2   = &1 Пропускаю " , new_line.price-rubl  , new_line.artic ) ).
     1408         next.
     1409       end.
     1410       if new_line.fact-qnty <= 0 then do:
     1411               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Количество &2   = &1 Пропускаю " , new_line.fact-qnty  , new_line.artic ) ).
     1412         next.
     1413       end.
     1414     for each buf2_temp_parts no-lock where
     1415           buf2_temp_parts.host-code      = temp_parts.host-code and
     1416           buf2_temp_parts.price-rubl <> ? and
     1417           buf2_temp_parts.price-rubl <> 0 and
     1418           buf2_temp_parts.vat-type       = temp_parts.vat-type and
     1419           buf2_temp_parts.contract-code  = temp_parts.contract-code and
     1420           buf2_temp_parts.supp-type      = temp_parts.supp-type and
     1421           buf2_temp_parts.supp-code      = temp_parts.supp-code and
     1422           buf2_temp_parts.vat-pc         = temp_parts.vat-pc    and
     1423           buf2_temp_parts.artic          = new_line.artic       and
     1424           buf2_temp_parts.prod-type      = new_line.prod-type   and
     1425           buf2_temp_parts.prod-code      = new_line.prod-code   and
     1426           buf2_temp_parts.price-rubl     = new_line.price-rubl
     1427     :
     1428       find first tt-doc-line exclusive-lock where
     1429                 tt-doc-line.doc-code       = n-d and
     1430                 tt-doc-line.artic          = buf2_temp_parts.artic   and
     1431                 tt-doc-line.prod-type      = buf2_temp_parts.prod-type and
     1432                 tt-doc-line.prod-code      = buf2_temp_parts.prod-code no-error .
     1433       if not available tt-doc-line then do:
     1434         find first buf_goods no-lock
     1435              where buf_goods.artic     = buf2_temp_parts.artic
     1436                and buf_goods.prod-type = buf2_temp_parts.prod-type
     1437                and buf_goods.prod-code = buf2_temp_parts.prod-code no-error .
     1438         if not available buf_goods then next .
     1439         create  tt-doc-line.
     1440         assign
     1441         tt-doc-line.doc-code       = n-d
     1442         tt-doc-line.obj-type       = new_obj-type
     1443         tt-doc-line.obj-code       = new_obj-code
     1444         tt-doc-line.line-num       = next-value (s-line-num, ub)
     1445         tt-doc-line.artic          = buf2_temp_parts.artic
     1446         tt-doc-line.prod-type      = buf2_temp_parts.prod-type
     1447         tt-doc-line.prod-code      = buf2_temp_parts.prod-code
     1448         tt-doc-line.prt-root       = buf_goods.prt-root
     1449         tt-doc-line.unit-cli       = buf_goods.unit-base
     1450         tt-doc-line.slt-pc         = buf2_temp_parts.slt-pc
     1451         tt-doc-line.vat-pc         = buf2_temp_parts.vat-pc
     1452         tt-doc-line.ext-doc-type   = v-ext-doc-type
     1453         tt-doc-line.price-base     = buf2_temp_parts.price-rubl
     1454         tt-doc-line.price-cli      = buf2_temp_parts.price-rubl
     1455         tt-doc-line.price-rubl     = buf2_temp_parts.price-rubl
     1456         tt-doc-line.cli-base-rate  = 1
     1457         tt-doc-line.doc-density    = 1 / tt-doc-line.cli-base-rate
     1458         tt-doc-line.fact-density   = 1 / tt-doc-line.cli-base-rate
     1459         tt-doc-line.status_        = "temp"
     1460         tt-doc-line.cli-qnty       = 0
     1461         tt-doc-line.doc-qnty       = 0
     1462         tt-doc-line.fact-qnty      = 0
     1463         .
     1464         create temp-2exists.
     1465         assign
     1466         temp-2exists.artic = buf2_temp_parts.artic
     1467         temp-2exists.prod-type = buf2_temp_parts.prod-type
     1468         temp-2exists.prod-code = buf2_temp_parts.prod-code
     1469         temp-2exists.doc-code = n-d
     1470         .
     1471         release temp-2exists.
     1472       end.
     1473       assign
     1474         tt-doc-line.cli-qnty  = tt-doc-line.cli-qnty  + buf2_temp_parts.fact-qnty
     1475         tt-doc-line.doc-qnty  = tt-doc-line.doc-qnty  + buf2_temp_parts.fact-qnty
     1476         tt-doc-line.fact-qnty = tt-doc-line.fact-qnty + buf2_temp_parts.fact-qnty
     1477       .
     1478       find first tt2-doc-line exclusive-lock where
     1479                 tt2-doc-line.doc-code       = n-d and
     1480                 tt2-doc-line.artic          = tt-doc-line.artic   and
     1481                 tt2-doc-line.prod-code      = tt-doc-line.prod-code and
     1482                 tt2-doc-line.prod-type      = tt-doc-line.prod-type  no-error .
     1483       if not available tt2-doc-line then do:
     1484         create  tt2-doc-line .
     1485       end.
     1486       BUFFER-COPY tt-doc-line to tt2-doc-line no-error.
     1487       if error-status:error then do:
     1488         message "buf-copy1 err" skip
     1489         "doc-code:" n-d
     1490         "artic:" tt-doc-line.artic
     1491         view-as alert-box .
     1492       end .
     1493       find first tt-gds-dtl exclusive-lock where
     1494                 tt-gds-dtl.doc-code   = n-d and
     1495                 tt-gds-dtl.prt-code   = tt-doc-line.prt-root and
     1496                 tt-gds-dtl.artic      = tt-doc-line.artic   and
     1497                 tt-gds-dtl.prod-code  = tt-doc-line.prod-code and
     1498                 tt-gds-dtl.prod-type  = tt-doc-line.prod-type  no-error .
     1499       if not available tt-gds-dtl then do:
     1500         create  tt-gds-dtl .
     1501       end.
     1502       buffer-copy  tt-doc-line  to  tt-gds-dtl
     1503       assign
     1504       tt-gds-dtl.prt-code  =  tt-doc-line.prt-root
     1505       no-error .
     1506       if error-status:error then do:
     1507         message "buf-copy2 err" skip
     1508         "doc-code:" n-d
     1509         "artic:" tt-doc-line.artic
     1510         view-as alert-box .
     1511       end .
     1512   // temp-table tt-doc-line:WRITE-XML ( "FILE", dsXmlFileName1, true, "UTF-8").
     1513   // temp-table tt2-doc-line:WRITE-XML ( "FILE", dsXmlFileName2, true, "UTF-8").
     1514     end .
     1515     end .
     1516   if local-trace-on then do:
     1517    dsXmlFileName1 = substitute("&1/&2-&3.xml", ibs.th.gbl.gbl-inipar:logDir, "tt-doc-line", n-d).
     1518    temp-table tt-doc-line:WRITE-XML ( "FILE", dsXmlFileName1, true, "UTF-8").
     1519    dsXmlFileName2 = substitute("&1/&2-&3.xml", ibs.th.gbl.gbl-inipar:logDir, "tt2-doc-line", n-d).
     1520    temp-table tt2-doc-line:WRITE-XML ( "FILE", dsXmlFileName2, true, "UTF-8").
     1521   end .
     1522     for each tt2-doc-line :
     1523       // pi линий:  doc-code artic prod-type prod-code
     1524       // pi партий: obj-type obj-code artic prod-type prod-code in-code out-code part-code prt-code
     1525       for each tt-parts
     1526          where tt-parts.obj-type  = tt2-doc-line.obj-type
     1527            and tt-parts.obj-code  = tt2-doc-line.obj-code
     1528            and tt-parts.artic     = tt2-doc-line.artic
     1529            and tt-parts.prod-type = tt2-doc-line.prod-type
     1530            and tt-parts.prod-code = tt2-doc-line.prod-code
     1531            and tt-parts.supp-type     = new_trn-doc.cli-type
     1532            and tt-parts.supp-code     = new_trn-doc.cli-code
     1533            and tt-parts.contract-code = new_trn-doc.contract-code
     1534            and tt-parts.vat-type      = new_trn-doc.vat-type
     1535            and tt-parts.vat-pc        = tt2-doc-line.vat-pc
     1536            and tt-parts.price-rubl    = tt2-doc-line.price-rubl
     1537       :
     1538         tt-parts.out-code = tt2-doc-line.doc-code no-error .
     1539       end . // end_of for_each tt-parts
     1540     end.
     1541   if local-trace-on then do:
     1542    dsXmlFileName3 = substitute("&1/&2-&3.xml", ibs.th.gbl.gbl-inipar:logDir, "tt_parts-2", n-d).
     1543    temp-table tt-parts:WRITE-XML ( "FILE", dsXmlFileName3, true, "UTF-8").
     1544   end .
     1545   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_copy-in in g#lib-trn4
     1547   ( input parParentProc
     1548    ,input recid(new_trn-doc)
     1549    ,input table tt-trn-doc
     1550    ,input table tt2-doc-line
     1551    ,input table tt-doc-line-attr
     1552    ,input table tt-gds-dtl
     1553    ,input table tt-parts
     1554    ,input yes
     1555    ,input yes
     1556    ,input no
     1557    ,input yes
     1558    ,input this-procedure
     1559     ) no-error .
     1560     if error-status:error then do :
     1561               run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute("Не удалось добавить товар в приходную накладную  (copy-in.i)! &1 &2" , return-value , error-status :get-message(1) ) ).
     1562         return error return-value .
     1563     end.
     1564     v-ii = v-ii + 1.
     1565     run gbl/calc-trn.p ( input parparentproc, input recid(new_trn-doc)) no-error.
     1566     find first new_trn-doc where new_trn-doc.doc-code = n-d  exclusive-lock no-error .
     1567     assign
     1568     new_trn-doc.tot-cli = new_trn-doc.tot-calc
     1569     .
     1570     if p-is-close then do :
     1571         create tt-trn-close .
     1572         assign tt-trn-close.trn-code = new_trn-doc.doc-code .
     1573     end .
     1574   end.
     1575   end procedure.
     1576   procedure clos-trn2 :
     1577   define input parameter p-trn-code as character no-undo .
     1578   define variable v-cntxt-rsrv-time  as integer   no-undo .
     1579   define variable v-cntxt-load-time  as integer   no-undo .
     1580   define variable v-cntxt-holidays  as character no-undo .
     1581   define variable varchg-inv as logical no-undo .
     1582   do
     1583   on error undo, return error return-value
     1584   :
     1585     run str/trn-stat.p (
     1586       input  parparentproc  ,
     1587       input  this-procedure ,
     1588       input  '<закрытие документа на факт>':U ,
     1589       input  p-trn-code,
     1590       input  false  ,
     1591       input  ibs.th.gbl.gbl-var:g#db-num,
     1592       input  false ,
     1593       input  v-cntxt-rsrv-time,
     1594       input  v-cntxt-load-time,
     1595       input  v-cntxt-holidays,
     1596       input  false ,
     1597       output varchg-inv ,
     1598       output table gds-list1 )
     1599       no-error.
     1600       if error-status:error then do :
     1601                   run write-log-and-file in p-log-handle ( 1, p-log-filename, 1, substitute(" Ошибка при закрытии документа &2 &1" , return-value , p-trn-code ) ).
     1602       end.
     1603   end.
     1604   end procedure.
     1605   procedure unitqnty :
     1606     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     1607     define input parameter  p-artic            like ub.goods.artic     no-undo .
     1608     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     1609     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     1610     define input parameter  p-unit-description as character            no-undo .
     1611     define input parameter  p-qnty             as decimal              no-undo .
     1612     define variable vss-description as character no-undo initial "unitqnty-01: Контроль допустимых количеств для данной единицы измерения (товара)".
     1613     define variable message_err as character no-undo .
     1614     define buffer buf_units for ub.units .
     1615     define buffer buf_goods for ub.goods .
     1616     define variable v-artic as character no-undo .
     1617     if p-unit-description = ''
     1618     or p-unit-description = ?
     1619     then do:
     1620       assign
     1621         p-unit-description = "Единица измерения"
     1622       .
     1623     end.
     1624     if  p-unit-name <> ''
     1625     and p-unit-name <> ?
     1626     then do:
     1627       find first buf_units no-lock
     1628         where buf_units.unit-name = p-unit-name
     1629         no-error .
     1630       if not available buf_units
     1631       then do:
     1632         message
     1633           vss-workfile vss-revision vss-description skip
     1634           "Не найдена единица измерения" skip
     1635           "p-unit-name"   p-unit-name skip
     1636           "p-artic"       p-artic  skip
     1637           "p-prod-type"   p-prod-type skip
     1638           "p-proc-code"   p-prod-code skip
     1639           "p-qnty"        p-qnty skip
     1640           view-as alert-box error .
     1641         message_err = substitute("Не найдена единица измерения &1 &2 &3 &4 &4",p-unit-name, p-artic, p-prod-type, p-prod-code, p-qnty ).
     1642         undo, return error message_err .
     1643       end.
     1644     end.
     1645     else do:
     1646       find first buf_goods no-lock
     1647         where buf_goods.artic     = p-artic
     1648           and buf_goods.prod-type = p-prod-type
     1649           and buf_goods.prod-code = p-prod-code
     1650         no-error .
     1651       if not available buf_goods
     1652       then do:
     1653         message
     1654           vss-workfile vss-revision vss-description skip
     1655           "Не найден товар" skip
     1656           "p-unit-name"   p-unit-name skip
     1657           "p-artic"       p-artic  skip
     1658           "p-prod-type"   p-prod-type skip
     1659           "p-proc-code"   p-prod-code skip
     1660           "p-qnty"        p-qnty skip
     1661           view-as alert-box error .
     1662           message_err = substitute("Не найден товар &1 &2 &3", p-artic, p-prod-code, p-qnty ).
     1663         undo, return error message_err .
     1664       end.
     1665       find first buf_units no-lock
     1666         where buf_units.unit-name = buf_goods.unit-base
     1667         no-error .
     1668       if not available buf_units
     1669       then do:
     1670         message
     1671           vss-workfile vss-revision vss-description skip
     1672           "Не найдена единица измерения" skip
     1673           "p-unit-name"   p-unit-name skip
     1674           "p-artic"       p-artic  skip
     1675           "p-prod-type"   p-prod-type skip
     1676           "p-proc-code"   p-prod-code skip
     1677           "p-qnty"        p-qnty skip
     1678           view-as alert-box error .
     1679         message_err = substitute("Не найдена единица измерения &1 &2 &3 &4 &4",p-unit-name, p-artic, p-prod-type, p-prod-code, p-qnty ).
     1680         undo, return error message_err .
     1681       end.
     1682       assign
     1683         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     1684                 + " " + string(p-prod-code)
     1685         p-unit-description = "Базовая единица измерения"
     1686       .
     1687     end.
     1688     if lookup('шту':U, buf_units.type) > 0
     1689     or lookup('сер':U, buf_units.type) > 0
     1690     then do:
     1691       if p-qnty <> truncate(p-qnty, 0)
     1692       then do:
     1693       message_err = substitute("Ошибка. Для штучного и серийного товаров резервируемое количество должно быть целым &1 &2 &3 Запрошено количество &4", v-artic, p-unit-description, buf_units.unit-name, p-qnty ).
     1694         message
     1695           "Для штучного и серийного товаров резервируемое количество должно быть целым" skip
     1696           v-artic skip
     1697           p-unit-description buf_units.unit-name skip
     1698           "Запрошено количество " p-qnty skip
     1699           view-as alert-box .
     1700         undo, return error message_err .
     1701       end.
     1702     end.
     1703   end procedure.
