      434               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      435               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      436               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      437               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      438               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      439               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      440               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      441               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      442               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      443         otherwise do:
      444           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      445         end.
      446       end.
      447     end.
      448   end procedure.
      449   procedure thth150-db-attr-value :
      450     do
      451     on error undo, return error
      452     :
      453       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      454       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      455       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      456       define output parameter p-type      as character no-undo .
      457       define buffer buf_db-attr for ub.db-attr .
      458       define variable v-format         as character no-undo .
      459       define variable v-label          as character no-undo .
      460       define variable v-user-can-edit  as logical   no-undo .
      461       define variable v-output-display as logical   no-undo .
      462       define variable v-other          as character no-undo .
      463       run thth150-db-attr-code in this-procedure
      464         (input  p-code
      465         ,output p-type
      466         ,output v-format
      467         ,output v-label
      468         ,output v-user-can-edit
      469         ,output v-output-display
      470         ,output v-other
      471         ) no-error .
      472       if error-status :error then do:
      473         undo, return error return-value .
      474       end.
      475       find first buf_db-attr no-lock
      476         where buf_db-attr.db-num    = p-db-num
      477           and buf_db-attr.attr-code = p-code
      478         no-error .
      479       if avail buf_db-attr then do:
      480         assign
      481           p-value =  buf_db-attr.attr-value
      482         .
      483       end.
      484       else do:
      485         assign
      486           p-value = if p-type = 'L':U then "no":U else ""
      487         .
      488       end.
      489     end.
      490   end procedure.
      491   procedure thth150-db-attr-write :
      492     do
      493     on error undo, return error
      494     :
      495       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      496       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      497       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      498       define buffer buf_db-attr for ub.db-attr .
      499       define variable v-type           as character no-undo .
      500       define variable v-format         as character no-undo .
      501       define variable v-label          as character no-undo .
      502       define variable v-user-can-edit  as logical   no-undo .
      503       define variable v-output-display as logical   no-undo .
      504       define variable v-other          as character no-undo .
      505       run thth150-db-attr-code in this-procedure
      506         (input  p-code
      507         ,output v-type
      508         ,output v-format
      509         ,output v-label
      510         ,output v-user-can-edit
      511         ,output v-output-display
      512         ,output v-other
      513         ) no-error .
      514       if error-status :error then do:
      515         undo, return error return-value .
      516       end.
      517       find first buf_db-attr exclusive-lock
      518         where buf_db-attr.db-num    = p-db-num
      519           and buf_db-attr.attr-code = p-code
      520         no-error .
      521       if not available buf_db-attr then do:
      522         create buf_db-attr .
      523         assign
      524           buf_db-attr.db-num    = p-db-num
      525           buf_db-attr.attr-code = p-code
      526         .
      527       end.
      528       assign
      529         buf_db-attr.attr-value = p-value
      530       .
      531     end.
      532   end procedure.
      533   procedure thth150-db-attr-exist :
      534     do
      535     on error undo, return error
      536     :
      537       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      538       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      539       define output parameter p-exist    as logical  no-undo .
      540       define buffer buf_db-attr for ub.db-attr .
      541       define variable v-type           as character no-undo .
      542       define variable v-format         as character no-undo .
      543       define variable v-label          as character no-undo .
      544       define variable v-user-can-edit  as logical   no-undo .
      545       define variable v-output-display as logical   no-undo .
      546       define variable v-other          as character no-undo .
      547       run thth150-db-attr-code in this-procedure
      548         (input  p-code
      549         ,output v-type
      550         ,output v-format
      551         ,output v-label
      552         ,output v-user-can-edit
      553         ,output v-output-display
      554         ,output v-other
      555         ) no-error .
      556       if error-status :error then do:
      557         undo, return error return-value .
      558       end.
      559       find first buf_db-attr no-lock
      560         where buf_db-attr.db-num    = p-db-num
      561           and buf_db-attr.attr-code = p-code
      562         no-error .
      563       if  available buf_db-attr then do:
      564         p-exist = yes.
      565       end.
      566     end.
      567   end procedure.
      568   procedure thth150-db-attr-delete :
      569     do
      570     on error undo, return error
      571     :
      572       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      573       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      574       define output parameter p-deleted  as logical no-undo.
      575       define buffer buf_db-attr for ub.db-attr .
      576       define variable v-type           as character no-undo .
      577       define variable v-format         as character no-undo .
      578       define variable v-label          as character no-undo .
      579       define variable v-user-can-edit  as logical   no-undo .
      580       define variable v-output-display as logical   no-undo .
      581       define variable v-other          as character no-undo .
      582       run thth150-db-attr-code in this-procedure
      583         (input  p-code
      584         ,output v-type
      585         ,output v-format
      586         ,output v-label
      587         ,output v-user-can-edit
      588         ,output v-output-display
      589         ,output v-other
      590         ) no-error .
      591       if error-status :error then do:
      592         undo, return error return-value .
      593       end.
      594       find first buf_db-attr exclusive-lock
      595         where buf_db-attr.db-num    = p-db-num
      596           and buf_db-attr.attr-code = p-code
      597         no-error NO-WAIT.
      598       if not available buf_db-attr then do:
      599         p-deleted = no.
      600       end.
      601       else do:
      602         delete buf_db-attr.
      603         p-deleted = yes.
      604       end.
      605     end.
      606   end procedure.
      607   procedure thth150-db-attr-news :
      608     do
      609     on error undo, return error
      610     :
      611       define input  parameter p-code           as character no-undo .
      612       define output parameter p-news           as logical   no-undo .
      613       case p-code :
      614               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
      615               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
      616               when 'thth150-clients':U then do:     assign     p-news = no.   end.
      617               when 'thth150-goods':U then do:     assign     p-news = no.   end.
      618               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
      619               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
      620               when 'thth150-shop':U then do:     assign     p-news = no.   end.
      621               when 'thth150-contract':U then do:     assign     p-news = no.   end.
      622               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
      623               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
      624         otherwise do:
      625           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      626         end.
      627       end.
      628     end.
      629   end procedure.
