        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: renattr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/renattr.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define temp-table temp-clients no-undo
       63     field obj-type as character
       64     field obj-code as integer
       65     index xpk is primary obj-type obj-code
       66   .
       67   define temp-table temp-attr no-undo
       68     field obj-type   as character
       69     field obj-code   as integer
       70     field attr-code  as character
       71     field attr-value as character
       72     index xpk is primary unique obj-type obj-code attr-code
       73   .
       74   define temp-table temp-new-attr no-undo
       75     field obj-type   as character
       76     field obj-code   as integer
       77     field attr-code  as character
       78     field attr-value as character
       79     index xpk is primary unique obj-type obj-code attr-code
       80   .
       81   define stream sout .
       82   on write of ub.clients-attr override do: end.
       83   on delete of ub.clients-attr override do: end.
       84   do
       85   on error undo, return error return-value
       86   :
       87     define variable v-ok as logical   no-undo .
       88     message
       89       "Переименование атрибутов архивов" skip
       90       "Эту процедуру следует запустить один раз непосредственно после первой установки" skip
       91       "обновления версии 12_3 с датой компиляции 1 января 2004 года." skip
       92       "Данную процедуру обязательно необходимо запустить до первого расчета архивов." skip
       93       "" skip
       94       "Продолжить?" skip
       95       view-as alert-box question buttons yes-no update v-ok .
       96     if v-ok <> true
       97     then do:
       98       return .
       99     end.
      100     do transaction
      101     on error undo, return error return-value
      102     :
      103       define variable v-old-attr-list             as character no-undo .
      104       define variable v-new-attr-list             as character no-undo .
      105       define variable v-new-find-attr-list        as character no-undo .
      106       define variable v-num-entries-new-attr-list as integer   no-undo .
      107       assign
      108         v-old-attr-list =
      109                     'cut-date':u
      110           + ',':u + 'ah-start-date':u
      111           + ',':u + 'aht-start-date':u
      112           + ',':u + 'ah-del-crash':u
      113           + ',':u + 'aht-del-crash':u
      114           + ',':u + 'arhcalc':u
      115           + ',':u + 'ahtcalc':u
      116           + ',':u + 'ahspcalc':u
      117           + ',':u + 'arh-recalc':u
      118           + ',':u + 'aht-recalc':u
      119           + ',':u + 'ahsp-recalc':u
      120       .
      121       assign
      122         v-new-attr-list =
      123                     'arh-calc':u
      124           + ',':u + 'arh-del':u
      125           + ',':u + 'arh-start':u
      126           + ',':u + 'arh-detail':u
      127           + ',':u + 'arh-recalc':u
      128           + ',':u + 'ahsp-calc':u
      129           + ',':u + 'ahsp-del':u
      130           + ',':u + 'ahsp-start':u
      131           + ',':u + 'ahsp-detail':u
      132           + ',':u + 'ahsp-recalc':u
      133           + ',':u + 'aht-calc':u
      134           + ',':u + 'aht-del':u
      135           + ',':u + 'aht-start':u
      136           + ',':u + 'aht-detail':u
      137           + ',':u + 'aht-recalc':u
      138       .
      139       assign
      140         v-new-find-attr-list =
      141                     'arhcalc':u
      142           + ',':u + 'ah-del-crash':u
      143           + ',':u + 'ah-start-date':u
      144           + ',':u + 'cut-date':u
      145           + ',':u + 'arh-recalc':u
      146           + ',':u + 'ahspcalc':u
      147           + ',':u + 'ah-del-crash':u
      148           + ',':u + 'ah-start-date':u
      149           + ',':u + 'cut-date':u
      150           + ',':u + 'ahsp-recalc':u
      151           + ',':u + 'ahtcalc':u
      152           + ',':u + 'aht-del-crash':u
      153           + ',':u + 'aht-start-date':u
      154           + ',':u + 'aht-start-date':u
      155           + ',':u + 'aht-recalc':u
      156       .
      157       define buffer buf_db            for ub.db .
      158       define buffer buf_clients       for ub.clients .
      159       define buffer buf_clients-attr  for ub.clients-attr .
      160       define buffer buf_temp-clients  for temp-clients .
      161       define buffer buf_temp-attr     for temp-attr .
      162       define buffer buf_temp-new-attr for temp-new-attr .
      163       for each buf_db no-lock
      164       on error undo, return error return-value
      165       :
      166         for each buf_clients no-lock
      167           where buf_clients.db-num = buf_db.db-num
      168         on error undo, return error return-value
      169         :
      170           create buf_temp-clients .
      171           assign
      172             buf_temp-clients.obj-type = buf_clients.obj-type
      173             buf_temp-clients.obj-code = buf_clients.obj-code
      174           .
      175           for each buf_clients-attr no-lock
      176             where buf_clients-attr.obj-type = buf_clients.obj-type
      177               and buf_clients-attr.obj-code = buf_clients.obj-code
      178           on error undo, return error return-value
      179           :
      180             if lookup(buf_clients-attr.attr-code, v-old-attr-list) > 0
      181             then do:
      182               create buf_temp-attr .
      183               assign
      184                 buf_temp-attr.obj-type   = buf_clients-attr.obj-type
      185                 buf_temp-attr.obj-code   = buf_clients-attr.obj-code
      186                 buf_temp-attr.attr-code  = buf_clients-attr.attr-code
      187                 buf_temp-attr.attr-value = buf_clients-attr.attr-value
      188               .
      189             end.
      190           end.
      191         end.
      192       end.
      193       for each buf_temp-clients
      194       :
      195         assign
      196           v-num-entries-new-attr-list = num-entries(v-new-attr-list)
      197         .
      198         define variable v-ind           as integer   no-undo .
      199         define variable v-new-attr-code as character no-undo .
      200         define variable v-old-attr-code as character no-undo .
      201         do v-ind = 1 to v-num-entries-new-attr-list
      202         :
      203           assign
      204             v-new-attr-code = entry(v-ind,v-new-attr-list)
      205             v-old-attr-code = entry(v-ind,v-new-find-attr-list)
      206           .
      207           find first buf_temp-attr
      208             where buf_temp-attr.obj-type  = buf_temp-clients.obj-type
      209               and buf_temp-attr.obj-code  = buf_temp-clients.obj-code
      210               and buf_temp-attr.attr-code = v-old-attr-code
      211             no-error .
      212           if available buf_temp-attr
      213           then do:
      214             create buf_temp-new-attr .
      215             assign
      216               buf_temp-new-attr.obj-type   = buf_temp-attr.obj-type
      217               buf_temp-new-attr.obj-code   = buf_temp-attr.obj-code
      218               buf_temp-new-attr.attr-code  = v-new-attr-code
      219               buf_temp-new-attr.attr-value = buf_temp-attr.attr-value
      220             .
      221           end.
      222           else do:
      223             if v-old-attr-code = 'ah-start-date':u
      224             then do:
      225               find first buf_temp-attr
      226                 where buf_temp-attr.obj-type  = buf_temp-clients.obj-type
      227                   and buf_temp-attr.obj-code  = buf_temp-clients.obj-code
      228                   and buf_temp-attr.attr-code = 'cut-date':u
      229                 no-error .
      230               if available buf_temp-attr
      231               then do:
      232                 create buf_temp-new-attr .
      233                 assign
      234                   buf_temp-new-attr.obj-type   = buf_temp-attr.obj-type
      235                   buf_temp-new-attr.obj-code   = buf_temp-attr.obj-code
      236                   buf_temp-new-attr.attr-code  = v-new-attr-code
      237                   buf_temp-new-attr.attr-value = buf_temp-attr.attr-value
      238                 .
      239               end.
      240             end.
      241           end.
      242         end.
      243       end.
      244       output stream sout to renattr.txt .
      245       export stream sout 'rename_archive_attributes':u string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U) .
      246       export stream sout 'old_attr_delete':u .
      247       for each buf_temp-attr
      248       on error undo, return error return-value
      249       :
      250         export stream sout buf_temp-attr .
      251       end.
      252       export stream sout 'new_attr_create':u .
      253       for each buf_temp-new-attr
      254       on error undo, return error return-value
      255       :
      256         export stream sout buf_temp-new-attr .
      257       end.
      258       output stream sout close .
      259       for each buf_temp-attr
      260       on error undo, return error return-value
      261       :
      262         find first buf_clients-attr exclusive-lock
      263           where buf_clients-attr.obj-type = buf_temp-attr.obj-type
      264             and buf_clients-attr.obj-code = buf_temp-attr.obj-code
      265             and buf_clients-attr.attr-code = buf_temp-attr.attr-code
      266             and buf_clients-attr.attr-value = buf_temp-attr.attr-value
      267           no-error .
      268         if not available buf_clients-attr
      269         then do:
      270           undo, return error "Ошибка при удалении записи атрибут клиента" .
      271         end.
      272         delete buf_clients-attr .
      273       end.
      274       for each buf_temp-new-attr
      275       on error undo, return error return-value
      276       :
      277         find first buf_clients-attr exclusive-lock
      278           where buf_clients-attr.obj-type = buf_temp-new-attr.obj-type
      279             and buf_clients-attr.obj-code = buf_temp-new-attr.obj-code
      280             and buf_clients-attr.attr-code = buf_temp-new-attr.attr-code
      281             and buf_clients-attr.attr-value = buf_temp-new-attr.attr-value
      282           no-error .
      283         if available buf_clients-attr
      284         then do:
      285           undo, return error "Ошибка при создании записи атрибут клиента" .
      286         end.
      287         create buf_clients-attr .
      288         assign
      289           buf_clients-attr.obj-type   = buf_temp-new-attr.obj-type
      290           buf_clients-attr.obj-code   = buf_temp-new-attr.obj-code
      291           buf_clients-attr.attr-code  = buf_temp-new-attr.attr-code
      292           buf_clients-attr.attr-value = buf_temp-new-attr.attr-value
      293         .
      294       end.
      295     end.
      296     message
      297       "Переименование атрибутов успешно завершено" skip
      298       "Сохраните файл renattr.txt" skip
      299       view-as alert-box information .
      300   end.
