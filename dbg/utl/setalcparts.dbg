      502   define variable v-db-num            as integer   no-undo .
      503   define variable v-user-id           as character no-undo .
      504   define variable bh-wb-gds-EG-header as handle    no-undo.
      505   define variable bh-wb-gds-EG        as handle    no-undo.
      506   define variable v-value-character   as character no-undo .
      507   define variable v-value-decimal     as decimal   no-undo .
      508   define variable v-value-integer     as integer   no-undo .
      509   define variable v-value-logical     as logical   no-undo .
      510   define variable v-value-type        as character no-undo .
      511   define variable v-value-date        as date      no-undo .
      512   define variable v-ext-sys           as integer   no-undo .
      513   define variable v-glog     as logical   no-undo .
      514   define variable v-fs-rar as character no-undo view-as text format "X(15)" label "Код ФС РАР (FSRAR ID)" .
      515   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      517     (output v-db-num
      518     ,output v-user-id
      519     ) no-error .
      520   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      521   do:
      522     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      523       (input  v-cntxt-db-num
      524       ,input  v-cntxt-userid
      525       ,input  0
      526       ,input  'actn_egais-doc':U
      527       ,input  'object':U
      528       ,input  v-cntxt-host-code-obj
      529       ,input  v-cntxt-obj-type
      530       ,input  v-cntxt-obj-code
      531       ,input  0
      532       ,input  0
      533       ,input  0
      534       ,input  true
      535       ,output glog
      536       )  .
      537   end.
      538     if not glog then  return .
      539     empty temp-table thbjattr_thbj-attr .
      540     run adm/shattri.p (
      541          input "get":U
      542         ,input v-cntxt-obj-type
      543         ,input v-cntxt-obj-code
      544         ,input 'egais':U
      545         ,input 'egais-fsrar':U
      546         ,output v-value-character
      547         ,output v-value-date
      548         ,output v-value-decimal
      549         ,output v-value-integer
      550         ,output v-value-logical
      551         ,output v-value-type
      552         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      553         ) no-error .
      554     assign
      555       v-fs-rar = v-value-character
      556     .
      557     run adm/shattri.p (
      558          input "get":U
      559         ,input '':U
      560         ,input 0
      561         ,input 'egais':U
      562         ,input 'egais-exsys':U
      563         ,output v-value-character
      564         ,output v-value-date
      565         ,output v-value-decimal
      566         ,output v-value-integer
      567         ,output v-value-logical
      568         ,output v-value-type
      569         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      570         ) no-error .
      571     assign v-ext-sys = v-value-integer .
      572     egais = new EGAIS(v-db-num, v-user-id).
      573     egais:EGAISImpl = new WayBill (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
      574     for each ub.clob-bind where ub.clob-bind.field-name_ = 'egais-wb':U no-lock:
      575       bh-wb-gds-EG-header = egais:GetHndlTable(1, ub.clob-bind.uniq-key-rec).
      576       bh-wb-gds-EG = egais:GetHndlTable(2, ub.clob-bind.uniq-key-rec).
      577       def var refA as char no-undo.
      578       def var refB as char no-undo.
      579       def var alc-code as char no-undo.
      580       def var alc-type-code as char no-undo.
      581       find first buf_trn-doc where buf_trn-doc.doc-code = entry (6, ub.clob-bind.descr, chr(4)) no-error.
      582       if not available (buf_trn-doc) then next.
      583       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code:
      584         for each buf_parts no-lock where
      585           buf_parts.obj-type = buf_trn-doc.obj-type and
      586           buf_parts.obj-code = buf_trn-doc.obj-code and
      587           buf_parts.artic = buf_doc-line.artic and
      588           buf_parts.prod-type = buf_doc-line.prod-type and
      589           buf_parts.prod-code = buf_doc-line.prod-code and
      590           buf_parts.out-code = buf_trn-doc.doc-code and
      591           buf_parts.in-code = buf_trn-doc.doc-code and
      592           not buf_trn-doc.doc-code matches "*=*":
      593           ii = ii + 1.
      594         find first buf_gds no-lock where buf_gds.artic = buf_parts.artic and buf_gds.prod-code = buf_parts.prod-code and buf_gds.prod-type = buf_parts.prod-type.
      595         bh-wb-gds-EG:find-first ('where tt-wb-gds-EG.gds-code = ' + string ( buf_gds.gds-code) + ' and tt-wb-gds-EG.qnty = ' + string (buf_parts.qnty), no-lock) no-error.
      596         if not bh-wb-gds-EG:available
      597           then next.
      598         refA = bh-wb-gds-EG:buffer-field ("refA"):buffer-value.
      599         refB = bh-wb-gds-EG:buffer-field ("refB"):buffer-value.
      600         alc-code = bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value.
      601         alc-type-code = bh-wb-gds-EG:buffer-field ("alc-type-code"):buffer-value.
      602         if (refA + ',' + refB + ',' + alc-code  + ',' + alc-type-code) = "" or (refA + ',' + refB + ',' + alc-code  + ',' + alc-type-code) = ?
      603         or buf_parts.alc-ref-ab-path = "" or buf_parts.alc-ref-ab-path = ?
      604           then .
      605           else next.
      606         if true  then
      607           run trg/partps.p ( input buf_gds.gds-code
      608                          , input buf_parts.in-code
      609                          , input ?
      610                          , input buf_parts.part-code
      611                          , input buf_parts.mark-db-num
      612                          , input buf_parts.mark-code
      613                          , input buf_parts.alc-bottling-date
      614                          , input refA + ',' + refB + ',' + alc-code  + ',' + alc-type-code
      615                          , input buf_parts.alc-quality-certif-path
      616                          , input buf_parts.alc-certif-path
      617                          , input buf_parts.alc-imp-type
      618                          , input buf_parts.alc-imp-code
      619                          ) no-error .
      620         end.
      621       end.
      622     end.
      623   delete object egais.
      624   message "Завершено" view-as alert-box.
