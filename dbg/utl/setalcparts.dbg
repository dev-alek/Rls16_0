      481   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   define new global shared variable g#trdcalib as handle no-undo.
      483   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   define variable egais               as class     EGAIS no-undo.
      485   def var ii as int no-undo.
      486   def var glog as  log no-undo.
      487   define buffer buf_gds           for ub.goods.
      488   define buffer buf_gds-attr      for ub.goods-attr.
      489   define buffer buf_trn-doc       for ub.trn-doc.
      490   define buffer buf_doc-attr      for ub.doc-attr.
      491   define buffer buf_parts         for ub.parts.
      492   define buffer buf_doc-line      for ub.doc-line.
      493   define buffer buf_doc-line-attr for ub.doc-line-attr.
      494   define buffer buf_clients       for ub.clients.
