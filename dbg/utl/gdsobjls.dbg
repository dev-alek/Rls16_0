        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: gdsobjls.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/gdsobjls.p $":U .
        8   define variable vss-description as character no-undo init "Редактирование списка количества товара на объекте".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table userobjs_temp-user-obj no-undo
       80     field obj-type as character
       81     field obj-code as integer
       82     index xpk is primary unique obj-type obj-code
       83     .
       84   procedure userobjs_clear :
       85     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       86     do
       87     on error undo, return error return-value
       88     :
       89       for each buf_userobjs_temp-user-obj
       90       on error undo, return error return-value
       91       :
       92         delete buf_userobjs_temp-user-obj .
       93       end.
       94     end.
       95   end .
       96   procedure userobjs_object-count :
       97     define output parameter p-total-count as integer   no-undo .
       98     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       assign
      103         p-total-count = 0
      104       .
      105       for each buf_userobjs_temp-user-obj
      106       on error undo, return error return-value
      107       :
      108         assign
      109           p-total-count = p-total-count + 1
      110         .
      111       end.
      112     end.
      113   end.
      114   procedure userobjs_append :
      115      define input  parameter p-obj-type as character no-undo .
      116      define input  parameter p-obj-code as integer   no-undo .
      117     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first buf_userobjs_temp-user-obj
      122         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      123           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      124         no-error .
      125       if not available buf_userobjs_temp-user-obj
      126       then do:
      127         create buf_userobjs_temp-user-obj .
      128         assign
      129           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      130           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      131         .
      132       end.
      133     end.
      134   end.
      135   procedure userobjs_object-exist :
      136     define output parameter p-object-exist as logical   no-undo .
      137     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      138     do
      139     on error undo, return error return-value
      140     :
      141       find first buf_userobjs_temp-user-obj
      142         no-error .
      143       if not available buf_userobjs_temp-user-obj
      144       then do:
      145         assign
      146           p-object-exist = false
      147         .
      148       end.
      149       else do:
      150         assign
      151           p-object-exist = true
      152         .
      153       end.
      154     end.
      155   end.
      156   procedure userobjs_transfer :
      157     define input  parameter p-callback-handle as handle no-undo .
      158     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      159     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      160     do
      161     on error undo, return error return-value
      162     :
      163       if valid-handle(p-callback-handle) <> true
      164       then do:
      165         message
      166           vss-workfile vss-revision vss-description skip
      167           "Ошибка задания входных параметров" skip
      168           "Неизвестный указатель на процедуру" skip
      169           view-as alert-box error .
      170         undo, return error return-value .
      171       end.
      172       if p-callback-handle :get-signature("userobjs_append") = ""
      173       then do:
      174         message
      175           vss-workfile vss-revision vss-description skip
      176           "Ошибка задания входных параметров" skip
      177           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      178                     ,p-callback-handle :file-name
      179                     ) skip
      180           view-as alert-box error .
      181         undo, return error return-value .
      182       end.
      183       for each buf_userobjs_temp-user-obj
      184       on error undo, return error return-value
      185       :
      186         run userobjs_append in p-callback-handle
      187           (input  buf_userobjs_temp-user-obj.obj-type
      188           ,input  buf_userobjs_temp-user-obj.obj-code
      189           ) .
      190       end.
      191     end.
      192   end procedure.
      193   procedure userobjs_select-one :
      194      define input  parameter parparentproc     as widget-handle no-undo .
      195      define input  parameter p-db-num          as integer   no-undo .
      196      define input  parameter p-user-id         as character no-undo .
      197      define input  parameter p-host-code-obj   as integer   no-undo .
      198      define input  parameter p-obj-type        as character no-undo .
      199      define input  parameter p-obj-code        as integer   no-undo .
      200      define output parameter p-user-select     as logical   no-undo .
      201      define output parameter p-select-obj-type as character no-undo .
      202      define output parameter p-select-obj-code as character no-undo .
      203     do
      204     on error undo, return error return-value
      205     :
      206       run gbl/userobjs.w
      207         (input  parparentproc
      208         ,input  this-procedure :handle
      209         ,input  p-db-num
      210         ,input  p-user-id
      211         ,input  p-host-code-obj
      212         ,input  p-obj-type
      213         ,input  p-obj-code
      214         ,INPUT  "b-sel"
      215         ,output p-user-select
      216         ,output p-select-obj-type
      217         ,output p-select-obj-code
      218         ) .
      219     end.
      220   end.
      221   procedure userobjs_select-many :
      222     define input  parameter parparentproc   as widget-handle no-undo .
      223     define input  parameter p-db-num        as integer   no-undo .
      224     define input  parameter p-user-id       as character no-undo .
      225     define input  parameter p-host-code-obj as integer   no-undo .
      226     define input  parameter p-obj-type      as character no-undo .
      227     define input  parameter p-obj-code      as integer   no-undo .
      228     define output parameter p-user-select   as logical   no-undo .
      229     define variable v-select-obj-type as character no-undo .
      230     define variable v-select-obj-code as integer   no-undo .
      231     do
      232     on error undo, return error return-value
      233     :
      234       run gbl/userobjs.w
      235         (input  parparentproc
      236         ,input  this-procedure :handle
      237         ,input  p-db-num
      238         ,input  p-user-id
      239         ,input  p-host-code-obj
      240         ,input  p-obj-type
      241         ,input  p-obj-code
      242         ,INPUT  "b-sel,b-mark"
      243         ,output p-user-select
      244         ,output v-select-obj-type
      245         ,output v-select-obj-code
      246         ) .
      247     end.
      248   end.
      249   procedure thobjs :
      250      define input        parameter parparentproc     as widget-handle no-undo .
      251      define input        parameter i-bttns           as character     no-undo .
      252      define input        parameter i-list-mode       as character     no-undo.
      253      define input        parameter i-obj-type        as character     no-undo.
      254      define input        parameter i-db-num          as integer       no-undo.
      255      define input        parameter i-host-code       as integer       no-undo.
      256      define input-output parameter p-rid-list        as character     no-undo .
      257   run ref/thobjs.p
      258           ( input parparentproc
      259            ,input  this-procedure :handle
      260           , input i-bttns
      261           , input i-list-mode
      262           , input i-obj-type
      263           , input i-db-num
      264           , input i-host-code
      265           , input-output p-rid-list ) no-error .
      266   end.
      267   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268   define new shared temp-table scn-list no-undo like ub.goods
      269     field qnty   as decimal
      270     field to-del as logical
      271     field order-num as integer
      272     field to-sel as logical
      273     field promo-code as character
      274     field ActionId  as int64
      275     field db-num as integer
      276     index art  is primary unique artic prod-type prod-code
      277     index code is         unique gds-code
      278     index oi order-num
      279     index isel to-sel
      280     .
      281   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   define  new shared  temp-table scn-list-hist no-undo
      283   field list-table as character
      284   field id as integer
      285   field line as integer
      286   field hist-mode as character
      287   field des as character
      288   field num-recs as integer
      289   field option_ as character
      290   field item_ as character
      291   field status_ as character
      292   field num-add as integer
      293   field num-ignored as integer
      294   field done as logical
      295   field err_ as logical
      296   field err-mes as character
      297   index pi is primary
      298   id
      299   line
      300   index isdone
      301   done
      302   .
      303   do
      304   on error undo, return error
      305   :
      306     define variable v-user-select as logical   no-undo .
      307     define variable v-obj-type as character no-undo .
      308     define variable v-obj-code as integer   no-undo .
      309   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310     run mainmenu_getcntxt in parparentproc
      311       (output v-cntxt-db-num
      312       ,output v-cntxt-userid
      313       ,output v-cntxt-level
      314       ,output v-cntxt-host-code-obj
      315       ,output v-cntxt-obj-type
      316       ,output v-cntxt-obj-code
      317       ,output v-cntxt-db-num-obj
      318       ,output v-cntxt-is-admin
      319       ) .
      320   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   run userobjs_select-one in this-procedure
      322     (input  parparentproc
      323     ,input  v-cntxt-db-num
      324     ,input  v-cntxt-userid
      325     ,input  v-cntxt-host-code-obj
      326     ,input  v-cntxt-obj-type
      327     ,input  v-cntxt-obj-code
      328     ,output v-user-select
      329     ,output v-obj-type
      330     ,output v-obj-code
      331     )  .
      332     if v-user-select <> true
      333     then do:
      334       message
      335         "Объект не выбран"
      336         view-as alert-box information .
      337       return .
      338     end.
      339     run str/scn-list.w
      340       (input parparentproc
      341       ,input v-cntxt-host-code-obj
      342       ,input v-cntxt-obj-type
      343       ,input v-cntxt-obj-code
      344       ) .
      345     define variable v-file-name as character no-undo .
      346     assign
      347       v-file-name = "imp-out.txt"
      348     .
      349     run gbl/d-prompt.w
      350       (input 'title=Создание файла импорта партий расходной зоны\'
      351       + 'text1=Введите имя файла импорта\'
      352       + 'text2=Выбранный файл будет перезаписан\'
      353       + 'format=x(40)\'
      354       + 'type=char\'
      355       + 'boxprog=getfile.p\'
      356       ,input-output v-file-name
      357       ).
      358     if return-value = "false":u then do:
      359       return .
      360     end.
      361     define variable v-ind as integer   no-undo .
      362     output to value(v-file-name) .
      363     for each scn-list
      364       where scn-list.qnty > 0
      365     on error undo, return error
      366     :
      367       assign
      368         v-ind = v-ind + 1
      369       .
      370       export
      371         v-obj-type
      372         v-obj-code
      373         scn-list.artic
      374         scn-list.prod-type
      375         scn-list.prod-code
      376         scn-list.qnty
      377         .
      378     end.
      379     output close .
      380     message
      381       "Создание файла импорта успешно" skip
      382       "Создано строк в файле импорта" v-ind skip
      383       "Передайте файл ответсвенному за импорт расходной зоны" skip
      384       view-as alert-box information .
      385   end.
