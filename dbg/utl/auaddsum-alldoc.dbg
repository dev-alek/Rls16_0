        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: auaddsum-alldoc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/auaddsum-alldoc.p $":U .
        7   define variable vss-description as character no-undo init "ПЕРЕСЧЕТ сумм для всех закрытых документов инвентаризации данной БД
        8   ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define new global shared variable g#trdcalib as handle no-undo.
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     end.
      147   end procedure.
      148   procedure waitfram-show :
      149     define input  parameter p-message as character no-undo .
      150     define variable v-left-margin as integer   no-undo .
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       if length(p-message) <= 70 then do:
      156         assign
      157           v-left-margin = integer((70 - length(p-message)) / 2)
      158         .
      159         assign
      160           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      161         .
      162         assign
      163           v-waitfram-action01 = " "
      164           v-waitfram-action02 = " "
      165                                    + fill(" ", v-left-margin)
      166                                    + p-message
      167           v-waitfram-action03 = " "
      168         .
      169       end.
      170       else do:
      171         define variable vRindex1 as integer no-undo.
      172         define variable vRindex2 as integer no-undo.
      173         vRindex1 = r-index(p-message," ",70).
      174         if vRindex1 = 0
      175         then
      176            vRindex1 = 70.
      177         if length(p-message)  <= vRindex1 + 70 then do:
      178           assign
      179             v-waitfram-action01 = " "
      180             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      181             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      182           .
      183         end.
      184         else do:
      185           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      186           if vRindex2 <= vRindex1
      187           then
      188              vRindex2 = vRindex1 + 70.
      189           assign
      190             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      191             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      193           .
      194         end.
      195       end.
      196       B-viewProcInfo:visible   in frame waitfram = no.
      197       B-viewProcInfo:sensitive in frame waitfram = no.
      198       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       if  (   mWaitFramView
      201          or  mWaitProcEvent)
      202          and not mBatchMode
      203       then
      204          display
      205             v-waitfram-action01 skip
      206             v-waitfram-action02 skip
      207             v-waitfram-action03 skip
      208          with frame waitfram .
      209     end.
      210   end procedure.
      211      procedure waitfram-show-this:
      212         define input  parameter iInterval as int64 no-undo.
      213         define variable vtime as int64 no-undo.
      214         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      215         mWaitFramInterval = iInterval.
      216         run waitfram-show (substitute("&1&2 &3&4" ,
      217                                       mWaitFramTextBeg ,
      218                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      219                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      220                                       mWaitFramTextEnd
      221                                      )
      222                           ).
      223      end.
      224      procedure WaitFramRunPause:
      225         define input  parameter iInterval as dec no-undo.
      226         define variable vStart  as datetime-tz no-undo.
      227         define variable vend    as datetime-tz no-undo.
      228         define variable vint as int64 no-undo.
      229         define variable vOk as logical no-undo.
      230         vStart = now.
      231         vend   = vStart.
      232         publish "WaitFramPause" (iInterval,output vOk).
      233         vend   =  now.
      234         vint = vend - vStart.
      235         vint = iInterval - vint / 1000.
      236         if     not mWaitFramStop
      237            and (   vint > 0
      238                 or (    not vOk
      239                     and iInterval eq ?
      240                     )
      241                 )
      242         then
      243            run waitfram-show-this (iInterval).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and vint > 0
      249         then do:
      250            run gbl/pause.p (vint * 1000).
      251         end.
      252         if iInterval ne ?
      253         then
      254            publish "WaitFramStop".
      255         waitfram-check-timeout().
      256      end.
      257      procedure WaitFramWaitFor:
      258         define input  parameter iInterval as dec no-undo.
      259         assign
      260            mWaitFramStartProc   = now
      261            mWaitFramStopUser    = no
      262            mWaitFramStopTimeOut = no
      263         .
      264         block-wait:
      265         do while not mWaitFramStop:
      266            run WaitFramRunPause (iInterval).
      267            if  waitfram-check-timeout()
      268            then do:
      269               leave block-wait.
      270            end.
      271         end.
      272         run waitfram-hide.
      273      end.
      274   procedure waitfram-join :
      275     define input  parameter p-line-1  as character no-undo .
      276     define input  parameter p-line-2  as character no-undo .
      277     define input  parameter p-line-3  as character no-undo .
      278     define output parameter p-message as character no-undo .
      279     do
      280     on error undo, return error return-value
      281     :
      282       assign
      283         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      284                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      285                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      286       .
      287     end.
      288   end procedure.
      289   function waitfram-join-function returns character
      290     (input p-line-1 as character
      291     ,input p-line-2 as character
      292     ,input p-line-3 as character
      293     ).
      294     define variable v-message as character no-undo .
      295     run waitfram-join in this-procedure
      296       (input  p-line-1
      297       ,input  p-line-2
      298       ,input  p-line-3
      299       ,output v-message
      300       ) .
      301     return v-message .
      302   end function .
      303   define buffer bf_trn-doc  for ub.trn-doc.
      304   define buffer bf_clients  for ub.clients.
      305   define buffer bf_db       for ub.db.
      306   define variable varvalue       like ub.doc-attr.attr-value no-undo.
      307   define variable vartype        as character                no-undo.
      308   do on error undo, return error return-value :
      309   run waitfram-show in this-procedure ("").
      310   for each bf_db on error undo, return error return-value :
      311     for each bf_clients where bf_clients.db-num = bf_db.db-num on error undo, return error return-value :
      312       for each bf_trn-doc where bf_trn-doc.obj-type = bf_clients.obj-type and
      313                                 bf_trn-doc.obj-code = bf_clients.obj-code and
      314                                 bf_trn-doc.internal = no                  and
      315                                 bf_trn-doc.doc-type = 'инв':U        and
      316                                 bf_trn-doc.status_  = 'факт':U             on error undo, return error return-value :
      317          run waitfram-show in this-procedure (substitute ("Объект: &1 &2. Документ &3.", bf_clients.obj-type, bf_clients.obj-code, bf_trn-doc.doc-code)).
      318   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
      319                           input 'addsum':U ,
      320                          output varvalue ,
      321                          output vartype ) no-error .
      322          if error-status:error then do:
      323            message "Ошибка при считывании атрибутов документа " bf_trn-doc.doc-code " ." skip
      324                    "Прерываем расчет сумм." skip
      325                    return-value skip
      326                    error-status:get-message(1)
      327            view-as alert-box.
      328            return error.
      329          end.
      330          if  true
      331              then do:
      332             run utl/uaddsum.p (input bf_trn-doc.doc-code, no, ?, ?) no-error.
      333             if error-status:error then do:
      334               message "Ошибка при расчете сумм документа " bf_trn-doc.doc-code " ." skip
      335                       "Прерываем расчет сумм." skip
      336                       return-value skip
      337                       error-status:get-message(1)
      338               view-as alert-box.
      339               return error.
      340             end.
      341          end.
      342       end.
      343     end.
      344   end.
      345   run waitfram-hide in this-procedure.
      346   end.
