        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: mov-grp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/mov-grp.p $":U .
        8   define variable vss-description as character no-undo init "Перемещение в группу по списку товаров".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       25     define variable v-cntxt-db-num        as integer   no-undo .
       26     define variable v-cntxt-userid        as character no-undo .
       27     define variable v-cntxt-level         as character no-undo .
       28     define variable v-cntxt-host-code-obj as integer   no-undo .
       29     define variable v-cntxt-obj-type      as character no-undo .
       30     define variable v-cntxt-obj-code      as integer   no-undo .
       31     define variable v-cntxt-db-num-obj    as integer   no-undo .
       32     define variable v-cntxt-is-admin      as logical   no-undo .
       33   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       34   define new shared temp-table gds-list no-undo like ub.goods
       35     field qnty   as decimal
       36     field to-del as logical
       37     field order-num as integer
       38     field to-sel as logical
       39     field promo-code as character
       40     field ActionId  as int64
       41     field db-num as integer
       42     index art  is primary unique artic prod-type prod-code
       43     index code is         unique gds-code
       44     index oi order-num
       45     index isel to-sel
       46     .
       47   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       48   define  new shared  temp-table gds-list-hist no-undo
       49   field list-table as character
       50   field id as integer
       51   field line as integer
       52   field hist-mode as character
       53   field des as character
       54   field num-recs as integer
       55   field option_ as character
       56   field item_ as character
       57   field status_ as character
       58   field num-add as integer
       59   field num-ignored as integer
       60   field done as logical
       61   field err_ as logical
       62   field err-mes as character
       63   index pi is primary
       64   id
       65   line
       66   index isdone
       67   done
       68   .
       69       define variable v-goods-counter as integer      no-undo.
       70       define variable v-yesno         as logical      no-undo .
       71       define variable v-grp           as character    no-undo .
       72       define variable v-grp-recid     as recid        no-undo.
       73       define frame f-progress
       74           v-goods-counter label "Обработано товаров"
       75       with side-labels view-as dialog-box.
       76       define buffer buf_gds-grp       for ub.gds-grp.
       77       define buffer buf_goods         for ub.goods.
       78   do
       79   for buf_gds-grp
       80     , buf_goods
       81   on error undo, return error
       82   :
       83   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84     run mainmenu_getcntxt in parparentproc
       85       (output v-cntxt-db-num
       86       ,output v-cntxt-userid
       87       ,output v-cntxt-level
       88       ,output v-cntxt-host-code-obj
       89       ,output v-cntxt-obj-type
       90       ,output v-cntxt-obj-code
       91       ,output v-cntxt-db-num-obj
       92       ,output v-cntxt-is-admin
       93       ) .
       94       run str/gds-list.w (
       95             input parparentproc
       96           , input v-cntxt-host-code-obj
       97           , input v-cntxt-obj-type
       98           , input v-cntxt-obj-code
       99       ).
      100       assign
      101           v-yesno = yes
      102       .
      103       message
      104           "Переместить в выбранную группу все товары списка ?  Вы уверены ?"
      105       view-as alert-box question
      106       buttons OK-Cancel
      107       update v-yesno.
      108       if v-yesno = yes
      109       then do:
      110           assign
      111               v-grp = "":U
      112           .
      113           run ref/gds-grp.w (
      114                 input parparentproc
      115               , input "b-sel":U
      116               , input v-cntxt-obj-type
      117               , input v-cntxt-obj-code
      118               , input-output v-grp
      119           ).
      120           assign
      121               v-grp-recid = integer( v-grp )
      122           no-error.
      123           if not error-status :error
      124           and v-grp-recid <> 0
      125           then do:
      126               find first buf_gds-grp no-lock
      127                    where recid( buf_gds-grp ) = v-grp-recid
      128               .
      129               if buf_gds-grp.is-term = no
      130               then do:
      131                   message
      132                       "Товары можно переместить "
      133                       skip "только в терминальную группу."
      134                   view-as alert-box information.
      135               end.
      136               else do:
      137                   view frame f-progress.
      138                   v-goods-counter = 0.
      139                   for each gds-list
      140                   :
      141                       assign
      142                           v-goods-counter = v-goods-counter + 1
      143                       .
      144                       find first buf_goods exclusive-lock
      145                            where buf_goods.artic = gds-list.artic
      146                              and buf_goods.prod-type = gds-list.prod-type
      147                              and buf_goods.prod-code = gds-list.prod-code
      148                       .
      149                       assign
      150                           buf_goods.grp-code = buf_gds-grp.node-code
      151                       .
      152                       display
      153                           v-goods-counter
      154                       with frame f-progress.
      155                       process events.
      156                   end.
      157                   message
      158                       "Перемещение товаров в выбранную группу закончено успешно"
      159                       skip
      160                   view-as alert-box information.
      161               end.
      162           end.
      163       end.
      164   end.
