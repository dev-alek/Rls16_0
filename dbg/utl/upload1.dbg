        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: upload1.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/upload1.p $":U .
        8   define variable vss-description as character no-undo init "Экспорт сгенеренный кодов Морозко".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new shared temp-table gds-list no-undo like ub.goods
       80     field qnty   as decimal
       81     field to-del as logical
       82     field order-num as integer
       83     field to-sel as logical
       84     field promo-code as character
       85     field ActionId  as int64
       86     field db-num as integer
       87     index art  is primary unique artic prod-type prod-code
       88     index code is         unique gds-code
       89     index oi order-num
       90     index isel to-sel
       91     .
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define  new shared  temp-table gds-list-hist no-undo
       94   field list-table as character
       95   field id as integer
       96   field line as integer
       97   field hist-mode as character
       98   field des as character
       99   field num-recs as integer
      100   field option_ as character
      101   field item_ as character
      102   field status_ as character
      103   field num-add as integer
      104   field num-ignored as integer
      105   field done as logical
      106   field err_ as logical
      107   field err-mes as character
      108   index pi is primary
      109   id
      110   line
      111   index isdone
      112   done
      113   .
      114   def new shared var bc-frmt as character no-undo .
      115   def new shared var bc-pfx  as character no-undo .
      116   def var bc-par-type as character no-undo .
      117       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      118       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      119           do:
      120               message "Не задан или не верно задан ТИП собственного бар-кода!"
      121                   view-as alert-box ERROR TITLE "".
      122               return error.
      123           end.
      124       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      125       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      126           do:
      127               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      128                   view-as alert-box ERROR TITLE "".
      129               return error.
      130           end.
      131   PROCEDURE gen-bc:
      132     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      133     def output parameter full-b-code     as character init ""    no-undo .
      134   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135     define variable tmp-str2  as character no-undo.
      136     define variable tmp-num2  as character no-undo.
      137     define variable i2        as integer   no-undo.
      138     define variable sum2      as integer   no-undo.
      139     define variable len-code2 as integer   no-undo.
      140     define variable varcont2  as logical   initial yes no-undo.
      141     CASE bc-frmt :
      142       WHEN "EAN13" THEN do:
      143         assign
      144           tmp-str2 = string( internal-b-code, "999999999999" )
      145         .
      146       end.
      147       WHEN "EAN8" THEN do:
      148         assign
      149           tmp-str2 = string( internal-b-code, "9999999" )
      150         .
      151       end.
      152       OTHERWISE DO:
      153           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      154           view-as alert-box error.
      155           return error.
      156       END.
      157     END CASE.
      158     if varcont2 = yes then do:
      159       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      160       then do:
      161         message
      162           "Невозможно сформировать бар-код" SKIP
      163           "для товара с кодом: " internal-b-code
      164           view-as alert-box error title "подрезание кода".
      165         return error.
      166       end.
      167       else do:
      168         assign
      169           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      170           len-code2    = length( full-b-code )
      171         .
      172         define variable v-sum-char2 as character no-undo .
      173         assign
      174           sum2 = 0
      175         .
      176         do i2 = 1 to len-code2 by 2
      177         :
      178           assign
      179             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      180           .
      181           if v-sum-char2 < "0"
      182           or v-sum-char2 > "9"
      183           then do:
      184             message
      185               "Невозможно сформировать бар-код" skip
      186               "для товара с кодом: " internal-b-code skip
      187               view-as alert-box error title "подсчет контрольной суммы".
      188             return error.
      189           end.
      190           assign
      191             sum2 = sum2 + integer(v-sum-char2)
      192           .
      193         end.
      194         if varcont2 = yes then do:
      195           assign
      196             sum2 = sum2 * 3
      197           .
      198           do i2 = 2 to len-code2 by 2
      199           :
      200             assign
      201               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      202             .
      203             if v-sum-char2 < "0"
      204             or v-sum-char2 > "9"
      205             then do:
      206               message
      207                 "Невозможно сформировать бар-код" skip
      208                 "для товара с кодом: " internal-b-code skip
      209                 view-as alert-box error title "подсчет контрольной суммы".
      210               return error.
      211             end.
      212             assign
      213               sum2 = sum2 + integer(v-sum-char2)
      214             .
      215           end.
      216           if varcont2 = yes then do:
      217              if sum2 mod 10 = 0 then do:
      218                assign
      219                  full-b-code = full-b-code + '0'
      220                .
      221              end.
      222              else do:
      223                assign
      224                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      225                .
      226              end.
      227           end.
      228         end.
      229       end.
      230     end.
      231   END PROCEDURE.
      232   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233     define variable v-cntxt-db-num        as integer   no-undo .
      234     define variable v-cntxt-userid        as character no-undo .
      235     define variable v-cntxt-level         as character no-undo .
      236     define variable v-cntxt-host-code-obj as integer   no-undo .
      237     define variable v-cntxt-obj-type      as character no-undo .
      238     define variable v-cntxt-obj-code      as integer   no-undo .
      239     define variable v-cntxt-db-num-obj    as integer   no-undo .
      240     define variable v-cntxt-is-admin      as logical   no-undo .
      241   define variable atr-txt as char format "x(50)"  no-undo.
      242   define variable bk-txt as char format "x(50)"  no-undo.
      243   define variable kf-txt as char format "x(50)"  no-undo.
      244   define variable dbk-txt-txt as char format "x(50)"  no-undo.
      245   define variable bar_code as char no-undo.
      246   define variable b_c as char no-undo.
      247   define variable v-vat-pc like ub.doc-line.vat-pc no-undo.
      248   define variable v-slt-pc like ub.doc-line.slt-pc no-undo.
      249   def stream txt.
      250   message " Будем экспортировать в текстовый файл БарКоды ? "
      251   view-as alert-box Warning buttons yes-no UPDATE choice AS LOGICAL.
      252   if choice = false then return.
      253   do transaction :
      254   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255     run mainmenu_getcntxt in parparentproc
      256       (output v-cntxt-db-num
      257       ,output v-cntxt-userid
      258       ,output v-cntxt-level
      259       ,output v-cntxt-host-code-obj
      260       ,output v-cntxt-obj-type
      261       ,output v-cntxt-obj-code
      262       ,output v-cntxt-db-num-obj
      263       ,output v-cntxt-is-admin
      264       ) .
      265     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      266   end.
      267   output stream txt to value("Bar-Code.txt") no-echo.
      268   FOR EACH gds-list USE-INDEX art :
      269        display
      270           gds-list.artic
      271           with frame ff view-as dialog-box
      272        title ": Экспорт ".
      273        pause 0.
      274        atr-txt = trim(gds-list.artic).
      275        find goods where goods.artic     = gds-list.artic     and
      276                         goods.prod-type = gds-list.prod-type and
      277                         goods.prod-code = gds-list.prod-code no-lock no-error.
      278        find gds-prt where gds-prt.upper-code = goods.prt-root no-lock.
      279        find bar-code WHERE bar-code.gds-code  = goods.gds-code
      280                        and bar-code.node-code = gds-prt.node-code
      281                        and bar-code.part-code = ""
      282                        and bar-code.in-code   = ""
      283                        and bar-code.unit-cli  =  goods.unit-base
      284        no-lock.
      285        RUN gen-bc( input bar-code.b-code, output bar_code ).
      286   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      288     (input  goods.gds-code
      289     ,input  '1':U
      290     ,input  today
      291     ,input  v-cntxt-host-code-obj
      292     ,input  v-cntxt-obj-type
      293     ,input  v-cntxt-obj-code
      294     ,output v-vat-pc
      295     )  .
      296   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      298     (input  goods.gds-code
      299     ,input  '2':U
      300     ,input  today
      301     ,input  v-cntxt-host-code-obj
      302     ,input  v-cntxt-obj-type
      303     ,input  v-cntxt-obj-code
      304     ,output v-slt-pc
      305     )  .
      306        put stream txt unformatted  trim(atr-txt) ";"
      307                             trim(string(bar-code.b-code)) ";" trim(goods.gds-name)  ";" v-vat-pc  ";" v-slt-pc skip.
      308        put stream txt unformatted  trim(bar_code) skip.
      309        for each bar-code where bar-code.gds-code   = goods.gds-code
      310                            and bar-code.node-code  = gds-prt.node-code
      311                            and bar-code.part-code  = ""
      312                            and bar-code.in-code    = ""
      313                            no-lock :
      314          for each prod-bc where prod-bc.b-code = bar-code.b-code
      315                             and prod-bc.bc-on  = yes              no-lock :
      316              put stream txt unformatted  trim(prod-bc.b-str)  skip.
      317          end.
      318        end.
      319        for each bar-code WHERE bar-code.gds-code   = goods.gds-code
      320                            and bar-code.node-code  = gds-prt.node-code
      321                            and bar-code.part-code  = ""
      322                            and bar-code.in-code    = ""
      323                            and bar-code.unit-cli  <>  goods.unit-base    NO-LOCK:
      324           put stream txt unformatted  trim(string(bar-code.b-code))  skip.
      325           RUN gen-bc( input bar-code.b-code, output b_c ).
      326           put stream txt unformatted  trim(b_c)  skip.
      327        end.
      328   end.
      329   output stream txt close.
      330   message " Все, смотрите файл Bar-Code.txt в рабочей директории. "
      331   view-as alert-box information buttons ok.
