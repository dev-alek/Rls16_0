      363           v-prg-bar_progress-bar :frame-title = p-str
      364         .
      365       end.
      366     end.
      367     end procedure.
      368     procedure prg-bar_stepto-progress-bar :
      369       define input  parameter p-val as integer   no-undo .
      370     do
      371     on error undo, return error return-value
      372     :
      373       if v-prg-bar_progress-bar <> ?
      374       then do:
      375           v-prg-bar_progress-bar :stepto( p-val ) .
      376       end.
      377     end.
      378     end procedure.
      379   define variable vss-include-info2 as character format "X(65)" no-undo
