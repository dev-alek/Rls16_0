      338     :
      339       if v-prg-bar_progress-bar <> ?
      340       then do:
      341         v-prg-bar_progress-bar :show-bar() .
      342       end.
      343     end.
      344     end procedure.
      345     procedure prg-bar_increment-progress-bar :
      346     do
      347     on error undo, return error return-value
      348     :
      349       if v-prg-bar_progress-bar <> ?
      350       then do:
      351         v-prg-bar_progress-bar :increment() .
      352       end.
      353     end.
      354     end procedure.
      355     procedure prg-bar_title-progress-bar :
      356       define input  parameter p-str as character no-undo .
      357     do
