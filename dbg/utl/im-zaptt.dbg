      381   procedure xmlchar-test :
      382   define input parameter p-in-string          as character        no-undo.
      383   define output parameter p-out-string-enc    as character        no-undo.
      384   define output parameter p-out-string-dec    as character        no-undo.
      385   do
      386   on error undo, return error
      387   :
      388          run xmlchar-encode in this-procedure
      389       (
      390             input p-in-string
      391           , output p-out-string-enc
      392       ).
      393          run xmlchar-decode in this-procedure
      394       (
      395             input p-out-string-enc
      396           , output p-out-string-dec
      397       ).
      398   end.
      399   end .
      400   procedure xmlchar-encode :
      401   define input parameter p-in-string      as character        no-undo.
      402   define output parameter p-out-string    as character        no-undo.
      403       define variable v-position      as integer      no-undo.
      404       define variable v-current-char  as character    no-undo.
      405   do
      406   on error undo, return error
      407   :
      408       assign
      409           p-out-string = "":U
      410       .
      411       case p-in-string
      412       :
      413           when ?
      414           then do:
      415               assign
      416                   p-out-string = "?":U
      417               .
      418           end.
      419           when "?":U
      420           then do:
      421               assign
      422                   p-out-string = "&#63;":U
      423               .
      424           end.
      425           otherwise do:
      426               do v-position = 1 to length( p-in-string )
      427               :
      428                   assign
      429                       v-current-char = substring( p-in-string, v-position, 1 )
      430                   .
      431                   case v-current-char
      432                   :
      433                       when "&":U
      434                       then do:
      435                           assign
      436                               p-out-string = p-out-string + "&amp;":U
      437                           .
      438                       end.
      439                       when ">":U
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "&gt;":U
      443                           .
      444                       end.
      445                       when "<":U
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "&lt;":U
      449                           .
      450                       end.
      451                       when "'":U
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&apos;":U
      455                           .
      456                       end.
      457                       when '"':U
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&quot;":U
      461                           .
      462                       end.
      463                       when chr(1)
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "":U
      467                           .
      468                       end.
      469                       when chr(2)
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "":U
      473                           .
      474                       end.
      475                       when chr(3)
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "":U
      479                           .
      480                       end.
      481                       when chr(4)
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "":U
      485                           .
      486                       end.
      487                       when chr(5)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(6)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(7)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(8)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(9)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(29)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(10)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "&#10;":U
      527                           .
      528                       end.
      529                       when chr(13)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "&#13;":U
      533                           .
      534                       end.
      535                       otherwise do:
      536                           assign
      537                               p-out-string = p-out-string + v-current-char
      538                           .
      539                       end.
      540                   end case.
      541               end.
      542           end.
      543       end case.
      544   end.
      545   end .
