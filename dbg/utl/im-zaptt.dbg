      656   procedure xmlchar-decode :
      657   define input parameter p-in-string      as character        no-undo.
      658   define output parameter p-out-string    as character        no-undo.
      659       define variable v-position      as integer      no-undo.
      660       define variable v-last-position as integer      no-undo.
      661       define variable v-temp-integer  as integer      no-undo.
      662       define variable v-current-char  as character    no-undo.
      663       define variable v-next-char     as character    no-undo.
      664       define variable v-success       as logical      no-undo.
      665   do
      666   on error undo, return error
      667   :
      668       assign
      669           p-out-string = "":U
      670           v-position   = 0
      671       .
      672       replace-cycle:
      673       do while yes
      674       on error undo, return error
      675       :
      676           assign
      677               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      678           .
      679           if v-last-position <= v-position
      680           then do:
      681               if v-position = 0
      682               then do:
      683                   assign
      684                       p-out-string = p-in-string
      685                   .
      686               end.
      687               else do:
      688                   assign
      689                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      690                   .
      691               end.
      692               leave replace-cycle.
      693           end.
      694           else do:
      695               assign
      696                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      697                   v-position      = v-last-position
      698                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      699               .
      700               if v-current-char = "#":U
      701               then do:
      702                   assign
      703                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      704                   .
      705                   if v-last-position > 0
      706                   then do:
      707                       run xmlchar-read-integer in this-procedure
      708                        (
      709                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      710                           , output v-temp-integer
      711                           , output v-success
      712                       ).
      713                       if v-success = yes
      714                       and v-temp-integer >= 1
      715                       and v-temp-integer <= 255
      716                       then do:
      717                           assign
      718                               p-out-string = p-out-string + chr( v-temp-integer )
      719                               v-position   = v-last-position + 1
      720                           .
      721                       end.
      722                       else do:
      723                           assign
      724                               p-out-string = p-out-string + "&":U
      725                               v-position   = v-position   + 1
      726                           .
      727                       end.
      728                   end.
      729                   else do:
      730                       assign
      731                           p-out-string = p-out-string + "&":U
      732                           v-position   = v-position   + 1
      733                       .
      734                   end.
      735               end.
      736               else do:
      737                   case substring( p-in-string, v-position + 1, 3 )
      738                   :
      739                       when "lt;":U
      740                       then do:
      741                           assign
      742                               p-out-string = p-out-string + "<":U
      743                               v-position   = v-position   + 3
      744                           .
      745                       end.
      746                       when "gt;":U
      747                       then do:
      748                           assign
      749                               p-out-string = p-out-string + ">":U
      750                               v-position   = v-position   + 3
      751                           .
      752                       end.
      753                       otherwise do:
      754                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      755                           then do:
      756                               assign
      757                                   p-out-string = p-out-string + "&":U
      758                                   v-position   = v-position   + 4
      759                               .
      760                           end.
      761                           else do:
      762                               case substring( p-in-string, v-position + 1, 5 )
      763                               :
      764                                   when "quot;":U
      765                                   then do:
      766                                       assign
      767                                           p-out-string = p-out-string + '"':U
      768                                           v-position   = v-position   + 5
      769                                       .
      770                                   end.
      771                                   when "apos;":U
      772                                   then do:
      773                                       assign
      774                                           p-out-string = p-out-string + "'":U
      775                                           v-position   = v-position   + 5
      776                                       .
      777                                   end.
      778                                   otherwise do:
      779                                       assign
      780                                           p-out-string = p-out-string + "&":U
      781                                       .
      782                                   end.
      783                               end case.
      784                           end.
      785                       end.
      786                   end case.
      787               end.
      788           end.
      789       end.
      790   end.
      791   end .
      792   procedure xmlchar-read-integer :
      793   define input parameter p-input-string      as character        no-undo.
      794   define output parameter p-output-integer   as integer          no-undo.
      795   define output parameter p-success       as logical          no-undo.
      796   do
      797   on error undo, return error
      798   :
      799       assign
      800           p-output-integer = integer( p-input-string )
      801       no-error.
      802       if error-status :error
      803       then do:
      804           assign
      805               p-success           = no
      806               p-output-integer    = 0
      807           .
      808       end.
      809       else do:
      810           assign
      811               p-success           = yes
      812           .
      813       end.
      814   end.
      815   end.
      816   define variable vss-include-info3 as character format "X(65)" no-undo
      817   initial "@(#)$Workfile$ $Revision$".
      818   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      819   define stream stmXMLOut.
      820   define stream stmXMLLog.
      821   define stream strXMLIn.
      822   define temp-table temp_xmllib_rec-list no-undo
      823       field recName       as character
      824       field recLevel      as integer
      825       field recOpenLine   as integer
      826       field recCloseLine  as integer
      827       field closed        as logical
      828       index pi is primary unique
      829           recName
      830           recLevel
      831       index cl
      832           closed
      833   .
      834   define temp-table temp_xmllib_rec-fld-list no-undo
      835       field recName       as character
      836       field recLevel      as integer
      837       field fldName       as character
      838       field fldOpenLine   as integer
      839       field fldCloseLine  as integer
      840       field closed        as logical
      841       index pi is primary unique
      842           recName
      843           recLevel
      844           fldName
      845       index fn
      846           fldName
      847       index cl
      848           closed
      849   .
      850   define temp-table temp_xmllib_rec no-undo
      851       field rec-key       as integer
      852       field recLevel      as integer
      853       field recOpenLine   as integer
      854       field recCloseLine  as integer
      855       field recName       as character
      856       field closed        as logical
      857       index pi is primary unique
      858           rec-key
      859       index nm
      860           recName
      861           closed
      862           rec-key
      863       index cl
      864           closed
      865       index rlv
      866           recName
      867           recLevel
      868           closed
      869           rec-key
      870   .
      871   define temp-table temp_xmllib_rec-fld no-undo
      872       field fld-key       as integer
      873       field rec-key       as integer
      874       field fldOpenLine   as integer
      875       field fldCloseLine  as integer
      876       field fldName       as character
      877       field fldValue      as character
      878       field closed        as logical
      879       index pi is primary unique
      880           fld-key
      881       index nm
      882           rec-key
      883           fldName
      884           closed
      885           fld-key
      886       index cl
      887           closed
      888   .
      889   define variable v-xmllib-rec-key            as integer      no-undo .
      890   define variable v-xmllib-rec-fld-key        as integer      no-undo .
      891   define variable v-xmllib-dirname            as character    no-undo .
      892   define variable v-xmllib-filename           as character    no-undo .
      893   define variable v-xmllib-log-filename       as character    no-undo .
      894   define variable v-xmllib-log-handle         as handle       no-undo .
      895   define variable v-xmllib-log-proc-name      as character    no-undo .
      896   define variable v-xmllib-error-status       as logical      no-undo .
      897   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
      898   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
      899   define variable v-xmllib-codepage-convert   as logical      no-undo .
      900   define variable v-xmllib-codepage-source    as character    no-undo .
      901   define variable v-xmllib-codepage-target    as character    no-undo .
      902   procedure xmllib-clear-parse-data :
      903   do
      904   on error undo, return error
      905   :
      906       empty temp-table temp_xmllib_rec-list.
      907       empty temp-table temp_xmllib_rec-fld-list.
      908       empty temp-table temp_xmllib_rec.
      909       empty temp-table temp_xmllib_rec-fld.
      910   end.
      911   end procedure.
      912   procedure xmllib-add-rec-fld :
      913   define input parameter p-rec-name       as character        no-undo.
      914   define input parameter p-rec-fld-name   as character        no-undo.
      915       define buffer buf_rec-list        for temp_xmllib_rec-list.
      916       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
      917   do
      918   for buf_rec-list
      919     , buf_rec-fld-list
      920   on error undo, return error
      921   :
      922       find first buf_rec-list
      923            where buf_rec-list.recName = p-rec-name
      924       no-error.
      925       if not available buf_rec-list
      926       then do:
      927           create buf_rec-list.
      928           assign
      929               buf_rec-list.recName        = p-rec-name
      930               buf_rec-list.recOpenLine    = 0
      931               buf_rec-list.recCloseLine   = 0
      932               buf_rec-list.closed         = yes
      933           .
      934       end.
      935       find first buf_rec-fld-list
      936            where buf_rec-fld-list.recName = p-rec-name
      937              and buf_rec-fld-list.fldName = p-rec-fld-name
      938       no-error.
      939       if not available buf_rec-fld-list
      940       then do:
      941           create buf_rec-fld-list.
      942           assign
      943               buf_rec-fld-list.recName        = p-rec-name
      944               buf_rec-fld-list.fldName        = p-rec-fld-name
      945               buf_rec-fld-list.fldOpenLine    = 0
      946               buf_rec-fld-list.fldCloseLine   = 0
      947               buf_rec-fld-list.closed         = yes
      948           .
      949       end.
      950   end.
      951   end procedure.
      952   procedure xmllib-tag-open:
      953   define input parameter v-tag-level  as integer      no-undo.
      954   define input parameter v-tag-name   as character    no-undo.
      955   define input parameter v-tag-value  as character    no-undo.
      956   do
      957   on error undo, return error
      958   :
      959       assign
      960           v-tag-name = trim( v-tag-name )
      961       .
      962       put stream stmXMLOut unformatted
      963           substitute( "&1&2<&3&4&5>"
      964               , chr(10)
      965               , fill(" ", 4 * v-tag-level)
      966               , v-tag-name
      967               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
      968               , v-tag-value
      969           )
      970       .
      971   end.
      972   end procedure.
      973   procedure xmllib-tag-put:
      974   define input parameter v-tag-level      as integer      no-undo.
      975   define input parameter v-tag-name       as character    no-undo.
      976   define input parameter v-tag-value      as character    no-undo.
      977   define input parameter v-empty-mode     as integer      no-undo.
      978   do
      979   on error undo, return error
      980   :
      981       assign
      982           v-tag-name = trim( v-tag-name )
      983       .
      984       if  v-empty-mode = 1
      985       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
      986       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
      987       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
      988       then do:
      989           run xmlchar-encode in this-procedure (
      990                 input v-tag-value
      991               , output v-tag-value
      992           ).
      993           put stream stmXMLOut unformatted
      994               substitute( "&1&2<&3>&4</&3>"
      995                   , chr(10)
      996                   , fill(" ":U, 4 * v-tag-level)
      997                   , v-tag-name
      998                   , v-tag-value
      999               )
     1000           .
     1001       end.
     1002   end.
     1003   end procedure.
     1004   procedure xmllib-tag-put-null :
     1005   define input parameter p-tag-level  as integer      no-undo.
     1006   define input parameter p-tag-name   as character    no-undo.
     1007   do
     1008   on error undo, return error
     1009   :
     1010       assign
     1011           p-tag-name = trim( p-tag-name )
     1012       .
     1013       put stream stmXMLOut unformatted
     1014           substitute( '&1&2<&3 nil="true" /&3>'
     1015               , chr(10)
     1016               , fill(" ":U, 4 * p-tag-level)
     1017               , p-tag-name
     1018           )
     1019       .
     1020   end.
     1021   end procedure.
     1022   procedure xmllib-tag-close:
     1023   define input parameter v-tag-level as integer      no-undo.
     1024   define input parameter v-tag-name  as character    no-undo.
     1025   do
     1026   on error undo, return error
     1027   :
     1028       assign
     1029           v-tag-name = trim( v-tag-name )
     1030       .
     1031       put stream stmXMLOut unformatted
     1032           substitute( "&1&2</&3>"
     1033               , chr(10)
     1034               , fill( " ":U, 4 * v-tag-level)
     1035               , v-tag-name
     1036           )
     1037       .
     1038   end.
     1039   end procedure.
     1040   procedure xmllib-write-log:
     1041   define input parameter v-filename   as character    no-undo.
     1042   define input parameter v-log-level  as integer      no-undo.
     1043   define input parameter v-out-string as character    no-undo.
     1044   do
     1045   on error undo, return error
     1046   :
     1047       output stream stmXMLLog to value( v-filename ) append.
     1048       put stream stmXMLLog unformatted
     1049           chr(10)
     1050       .
     1051       put stream stmXMLLog unformatted
     1052           ( if v-log-level = 0
     1053             or v-out-string = "&DLine":U
     1054             or v-out-string = "&Line":U
     1055             then "":U
     1056             else cur-time-string-sec() + " ":U )
     1057       .
     1058       put stream stmXMLLog unformatted
     1059           ( if v-out-string = "&Line":U
     1060             then fill( "-":U, 80 )
     1061             else if v-out-string = "&DLine":U
     1062                  then fill( "=":U, 80 )
     1063                  else v-out-string )
     1064       .
     1065       output stream stmXMLLog close.
     1066   end.
     1067   end procedure.
     1068   procedure xmllib-write-edt:
     1069   define input parameter v-editor-handle    as handle       no-undo.
     1070   define input parameter v-log-level        as integer      no-undo.
     1071   define input parameter v-out-string       as character    no-undo.
     1072   do
     1073   on error undo, return error
     1074   :
     1075       if valid-handle ( v-editor-handle )
     1076       then do:
     1077           v-editor-handle :move-to-eof().
     1078           v-editor-handle :insert-string( ( if v-log-level = 0
     1079                                             or v-out-string = "&DLine":U
     1080                                             or v-out-string = "&Line":U
     1081                                             then "":U
     1082                                             else cur-time-string-sec() + " ":U
     1083                                         ) ).
     1084           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1085                                             then fill( "-":U, 80 )
     1086                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1087                                             else fill( " ":U, v-log-level) + v-out-string
     1088                                         ) ).
     1089           v-editor-handle :insert-string( chr(10) ).
     1090       end.
     1091   end.
     1092   end procedure.
     1093   procedure xmllib-show-cnt:
     1094   define input parameter v-fillin-handle     as handle   no-undo.
     1095   do
     1096   on error undo, return error
     1097   :
     1098       if valid-handle( v-fillin-handle )
     1099       then do:
     1100           assign
     1101               v-fillin-handle :visible = true
     1102           .
     1103       end.
     1104   end.
     1105   end procedure.
     1106   procedure xmllib-hide-cnt:
     1107   define input parameter v-fillin-handle     as handle   no-undo.
     1108   do
     1109   on error undo, return error
     1110   :
     1111       if valid-handle( v-fillin-handle )
     1112       then do:
     1113           assign v-fillin-handle :visible = false.
     1114       end.
     1115   end.
     1116   end procedure.
     1117   procedure xmllib-write-cnt:
     1118   define input parameter v-fillin-handle    as handle       no-undo.
     1119   define input parameter v-fillin-string    as character    no-undo.
     1120   do
     1121   on error undo, return error
     1122   :
     1123       if valid-handle( v-fillin-handle )
     1124       then do:
     1125           assign
     1126               v-fillin-handle :SCREEN-value = v-fillin-string
     1127           .
     1128       end.
     1129   end.
     1130   end procedure.
     1131   procedure xmllib-write-header:
     1132   define input parameter p-first-file     as logical      no-undo.
     1133   define input parameter p-xml-file-name  as character    no-undo.
     1134   define input parameter p-list-file-name as character    no-undo.
     1135   define input parameter p-file-number    as integer      no-undo.
     1136   define input parameter p-have-prev      as logical      no-undo.
     1137   define input parameter p-prev-filename  as character    no-undo.
     1138   define input parameter p-parameter-list as character    no-undo.
     1139       define variable v-counter    as integer        no-undo.
     1140   do
     1141   on error undo, return error
     1142   :
     1143       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1144       put stream stmXMLOut unformatted
     1145           "<?xml version='1.0' encoding='windows-1251'?>"
     1146       .
     1147       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     1148       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     1149       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     1150       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     1151       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     1152       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     1153       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1154       :
     1155           run xmllib-tag-put(
     1156                 input 1
     1157               , input entry( 2 * v-counter, p-parameter-list )
     1158               , input entry( 2 * v-counter + 1, p-parameter-list )
     1159               , input 0
     1160           ).
     1161       end.
     1162       run xmllib-tag-close( input 0, input "THheader" ).
     1163       output stream stmXMLOut close.
     1164       if p-list-file-name <> "":U
     1165       then do:
     1166           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1167           if p-first-file = yes
     1168           then do:
     1169               put stream stmXMLOut unformatted
     1170                   "<?xml version='1.0' encoding='windows-1251'?>"
     1171               .
     1172               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     1173           end.
     1174           run xmllib-tag-open( input 1, input "THfile", input "" ).
     1175           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1176           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     1177           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     1178           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     1179           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1180           :
     1181               run xmllib-tag-put(
     1182                   input 2
     1183                   , input entry( 2 * v-counter, p-parameter-list )
     1184                   , input entry( 2 * v-counter + 1, p-parameter-list )
     1185                   , input 0
     1186               ).
     1187           end.
     1188           run xmllib-tag-close( input 1, input "THfile" ).
     1189           output stream stmXMLOut close.
     1190       end.
     1191   end.
     1192   end procedure.
     1193   procedure xmllib-write-footer:
     1194   define input parameter p-last-file      as logical      no-undo.
     1195   define input parameter p-xml-file-name  as character    no-undo.
     1196   define input parameter p-list-file-name as character    no-undo.
     1197   define input parameter p-have-next      as logical      no-undo.
     1198   define input parameter p-next-file-name as character    no-undo.
     1199       define variable v-error-num     as integer           no-undo.
     1200   do
     1201   on error undo, return error
     1202   :
     1203       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1204       if p-have-next = yes
     1205       then do:
     1206           run xmllib-tag-open( input 0, input "footer", "" ).
     1207           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1208           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1209           run xmllib-tag-close( input 0, input "footer" ).
     1210       end.
     1211       run xmllib-tag-close( input 0, input "root" ).
     1212       output stream stmXMLOut close.
     1213       run bge/os_copy.p (
     1214             input "M"
     1215           , input p-xml-file-name + "tmp"
     1216           , input p-xml-file-name + "xml"
     1217           , output v-error-num
     1218       ).
     1219       if p-last-file = yes
     1220       and p-list-file-name <> "":U
     1221       then do:
     1222           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1223               run xmllib-tag-close( input 0, input "OpenXML" ).
     1224           output stream stmXMLOut close.
     1225           run bge/os_copy.p (
     1226                 input "M"
     1227               , input p-list-file-name + "tmp"
     1228               , input p-list-file-name + "xml":U
     1229               , output v-error-num
     1230           ).
     1231       end.
     1232   end.
     1233   end procedure.
     1234   procedure xmllib-filename :
     1235   define input parameter p-subdir             as character        no-undo.
     1236   define input parameter p-prefix             as character    no-undo.
     1237   define output parameter p-xml-file-name     as character    no-undo.
     1238   define output parameter p-log-file-name     as character    no-undo.
     1239   define output parameter p-list-file-name    as character    no-undo.
     1240       define variable v-home-dir  as character    no-undo.
     1241       define variable v-error-num as integer      no-undo.
     1242   do
     1243   on error undo, return error
     1244   :
     1245       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     1246       if v-home-dir = ?
     1247       then do:
     1248           message
     1249             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1250             skip "Нет параметра oxml-dir в секции [OXML]."
     1251             skip(1)
     1252             skip "Обратитесь к администратору."
     1253           view-as alert-box error.
     1254           undo, return error .
     1255       end.
     1256       if p-subdir <> "":U
     1257       then do:
     1258           assign
     1259               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     1260           .
     1261       end.
     1262       run gbl/dir-cre.p (
     1263           input v-home-dir
     1264       ) no-error.
     1265       if error-status :error
     1266       then do:
     1267           message
     1268             skip "Неверно задан каталог экспорта в ini-файле."
     1269             skip "Не удаётся создать каталог, указанный параметром"
     1270             skip "oxml-dir в секции [OXML]."
     1271             skip(1)
     1272             skip "Обратитесь к администратору."
     1273           view-as alert-box error.
     1274           undo, return error .
     1275       end.
     1276       run bge/genfname.p (
     1277             input v-home-dir
     1278           , input p-prefix
     1279           , input ""
     1280           , input "xml"
     1281           , input "tmp"
     1282           , output p-xml-file-name
     1283       ).
     1284       assign
     1285           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1286           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1287           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1288       .
     1289   end.
     1290   end procedure.
     1291   procedure xmllib-check-file-size :
     1292   define input parameter p-out-filename   as character    no-undo.
     1293   define output parameter p-is-big        as logical      no-undo.
     1294       define variable v-current-position    as integer        no-undo.
     1295   do
     1296   on error undo, return error
     1297   :
     1298       assign
     1299           v-current-position = seek( stmXMLOut )
     1300       .
     1301       if v-current-position / 1024 / 1024  >= 100
     1302       then do:
     1303           assign
     1304               p-is-big = yes
     1305           .
     1306       end.
     1307   end.
     1308   end procedure.
     1309   procedure xmllib-parse-file :
     1310   define input parameter p-full-filename      as character        no-undo.
     1311       define variable v-num-dirs              as integer      no-undo .
     1312       define variable v-str                   as character    no-undo .
     1313       define variable v-str-count             as int64        no-undo .
     1314   do
     1315   on error undo, return error
     1316   :
     1317       assign
     1318           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1319           v-xmllib-error-status   = no
     1320       .
     1321       if v-num-dirs > 1
     1322       then do:
     1323           assign
     1324               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1325               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1326           .
     1327       end.
     1328       else do:
     1329           assign
     1330               v-xmllib-filename = p-full-filename
     1331               v-xmllib-dirname  = "":U
     1332           .
     1333       end.
     1334       if valid-handle(v-xmllib-prg-bar-handle)
     1335       then do:
     1336   if session :set-wait-state( "compiler" ) then.
     1337         input stream strXMLIn from value(p-full-filename) .
     1338         repeat
     1339         :
     1340           import stream strXMLIn unformatted v-str no-error .
     1341           assign
     1342             v-str-count = v-str-count + 1
     1343           .
     1344         end.
     1345         input stream strXMLIn close .
     1346   if session :set-wait-state( "" ) then.
     1347         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     1348         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     1349         run prg-bar_show in this-procedure .
     1350       end.
     1351       create sax-reader v-xmllib-sax-reader-handle.
     1352       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     1353       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     1354       if error-status :error
     1355       then do:
     1356           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1357                                                                       ,vss-workfile
     1358                                                                       ,vss-revision
     1359                                                                       ,vss-description
     1360                                                                       ,chr(10)
     1361                                                                       ,return-value
     1362                                                                       ,trim(error-status :get-message(1))
     1363                                                                       ,trim(error-status :get-message(2))
     1364                                                                       ,trim(error-status :get-message(3)))
     1365                                                     ).
     1366           undo, return error .
     1367       end.
     1368       if v-xmllib-error-status <> no
     1369       then do:
     1370           run xmllib-parse-error in this-procedure (
     1371               input "*** При обработке XML файла были ошибки."
     1372           ).
     1373           delete object v-xmllib-sax-reader-handle.
     1374       end.
     1375       delete object v-xmllib-sax-reader-handle.
     1376       if valid-handle(v-xmllib-prg-bar-handle)
     1377       then do:
     1378         run prg-bar_delete in this-procedure .
     1379       end.
     1380   end.
     1381   end procedure.
     1382   procedure xmllib-parse-progressive :
     1383   define input parameter p-full-filename      as character no-undo .
     1384   define input parameter p-pack-data          as memptr no-undo .
     1385   define input parameter p-parse-first        as logical no-undo .
     1386   define input parameter p-first-err          as logical no-undo .
     1387   define output parameter p-parse-status as integer no-undo .
     1388   define variable v-num-dirs              as integer no-undo .
     1389   define variable glog                    as logical no-undo .
     1390   define variable v-pack-size             as int64 no-undo .
     1391   do
     1392   on error undo, return error
     1393   :
     1394     if p-parse-first then do:
     1395       if valid-handle(v-xmllib-sax-reader-handle)
     1396       then do:
     1397       end.
     1398       assign
     1399           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1400           v-xmllib-error-status   = no
     1401       .
     1402       if v-num-dirs > 1
     1403       then do:
     1404           assign
     1405               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1406               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1407           .
     1408       end.
     1409       else do:
     1410           assign
     1411               v-xmllib-filename = p-full-filename
     1412               v-xmllib-dirname  = "":U
     1413           .
     1414       end.
     1415       create sax-reader v-xmllib-sax-reader-handle.
     1416       v-pack-size = get-size (p-pack-data) .
     1417       if v-pack-size > 0 then
     1418         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     1419       else
     1420         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     1421       if error-status :error
     1422       or not glog
     1423       then do:
     1424         delete object v-xmllib-sax-reader-handle.
     1425         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1426                                                                     ,vss-workfile
     1427                                                                     ,vss-revision
     1428                                                                     ,vss-description
     1429                                                                     ,chr(10)
     1430                                                                     ,return-value
     1431                                                                     ,trim(error-status :get-message(1))
     1432                                                                     ,trim(error-status :get-message(2))
     1433                                                                     ,trim(error-status :get-message(3)) )
     1434                                                   ).
     1435         undo, return error .
     1436       end.
     1437       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     1438     end.
     1439     else do:
     1440       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     1441     end.
     1442     if error-status :error
     1443     then do:
     1444       delete object v-xmllib-sax-reader-handle.
     1445       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1446                                                                   ,vss-workfile
     1447                                                                   ,vss-revision
     1448                                                                   ,vss-description
     1449                                                                   ,chr(10)
     1450                                                                   ,return-value
     1451                                                                   ,trim(error-status :get-message(1))
     1452                                                                   ,trim(error-status :get-message(2))
     1453                                                                   ,trim(error-status :get-message(3)) )
     1454                                                 ).
     1455       undo, return error .
     1456     end.
     1457     if v-xmllib-error-status <> no
     1458     then do:
     1459       run xmllib-parse-error in this-procedure (
     1460           input "*** При обработке XML файла были ошибки."
     1461       ).
     1462       if p-first-err then do:
     1463         delete object v-xmllib-sax-reader-handle.
     1464       end.
     1465       else do:
     1466         v-xmllib-error-status = no.
     1467       end.
     1468     end.
     1469     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     1470       p-parse-status = SAX-COMPLETE.
     1471       delete object v-xmllib-sax-reader-handle.
     1472       return '':U.
     1473     end.
     1474     else do:
     1475       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     1476       return '':U.
     1477     end.
     1478   end.
     1479   end procedure.
     1480   procedure StartElement :
     1481   define input parameter p-name-space     as character        no-undo.
     1482   define input parameter p-local-name     as character        no-undo.
     1483   define input parameter p-q-name         as character        no-undo.
     1484   define input parameter p-attributes     as handle           no-undo.
     1485       define buffer buf_rec             for temp_xmllib_rec.
     1486       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1487       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1488       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1489   do
     1490   for buf_rec
     1491     , buf_rec-fld
     1492     , buf_rec-list
     1493     , buf_rec-fld-list
     1494   on error undo, return error
     1495   :
     1496       if valid-handle(v-xmllib-prg-bar-handle)
     1497       then do:
     1498         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     1499       end.
     1500       find first buf_rec-list
     1501            where buf_rec-list.recName = p-q-name
     1502       no-error.
     1503       if available buf_rec-list
     1504       then do:
     1505           if buf_rec-list.closed = no
     1506           then do:
     1507               find first buf_rec-fld-list
     1508                    where buf_rec-fld-list.recName = buf_rec-list.recName
     1509                      and buf_rec-fld-list.fldName = p-q-name
     1510               no-error.
     1511               if available buf_rec-fld-list
     1512               and buf_rec-list.recName = buf_rec-fld-list.recName
     1513               then do:
     1514                   if buf_rec-fld-list.closed = no
     1515                   then do:
     1516                       run xmllib-parse-error in this-procedure (
     1517                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     1518                                           , p-q-name
     1519                                           , p-q-name
     1520                                           , buf_rec-fld-list.fldOpenLine
     1521                                           )
     1522                       ).
     1523                   end.
     1524                   else do:
     1525                       run xmllib-parse-rec-fld-open in this-procedure (
     1526                             input buf_rec-list.recName
     1527                           , input buf_rec-list.recLevel
     1528                           , input buf_rec-fld-list.fldName
     1529                       ).
     1530                       assign
     1531                           buf_rec-fld-list.closed         = no
     1532                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1533                           buf_rec-fld-list.fldCloseLine   = 0
     1534                       .
     1535                   end.
     1536               end.
     1537               else do:
     1538                   assign
     1539                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     1540                   .
     1541                   run xmllib-parse-rec-open in this-procedure (
     1542                         input buf_rec-list.recName
     1543                       , input buf_rec-list.recLevel
     1544                   ).
     1545                   assign
     1546                       buf_rec-list.closed         = no
     1547                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1548                       buf_rec-list.recCloseLine   = 0
     1549                   .
     1550               end.
     1551           end.
     1552           else do:
     1553               run xmllib-parse-rec-open in this-procedure (
     1554                     input buf_rec-list.recName
     1555                   , input buf_rec-list.recLevel
     1556               ).
     1557               assign
     1558                   buf_rec-list.closed         = no
     1559                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1560                   buf_rec-list.recCloseLine   = 0
     1561               .
     1562           end.
     1563       end.
     1564       else do:
     1565           open-record:
     1566           for each buf_rec-fld-list
     1567              where buf_rec-fld-list.fldName = p-q-name
     1568           :
     1569               find first buf_rec-list
     1570                    where buf_rec-list.recName = buf_rec-fld-list.recName
     1571                      and buf_rec-list.closed  = no
     1572               no-error.
     1573               if available buf_rec-list
     1574               then do:
     1575                   run xmllib-parse-rec-fld-open in this-procedure (
     1576                         input buf_rec-list.recName
     1577                       , input buf_rec-list.recLevel
     1578                       , input buf_rec-fld-list.fldName
     1579                   ).
     1580                   assign
     1581                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     1582                       buf_rec-fld-list.closed         = no
     1583                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1584                       buf_rec-fld-list.fldCloseLine   = 0
     1585                   .
     1586                   leave open-record.
     1587               end.
     1588           end.
     1589       end.
     1590   end.
     1591   end procedure.
     1592   procedure Characters :
     1593   define input parameter p-char-data  as memptr.
     1594   define input parameter p-numchars   as integer.
     1595       define variable v-data-string    as character    no-undo.
     1596       define variable v-cp-utf8           as integer no-undo init 65001 .
     1597       define variable v-cp-windows1251    as integer no-undo init 1251 .
     1598       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     1599       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     1600       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     1601       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     1602   do
     1603   for buf_xmllib_rec
     1604     , buf_xmllib_rec-fld
     1605     , buf_xmllib_rec-list
     1606     , buf_xmllib_rec-fld-list
     1607   on error undo, return error
     1608   :
     1609       find first buf_xmllib_rec-list
     1610            where buf_xmllib_rec-list.closed = no
     1611       no-error.
     1612       if available buf_xmllib_rec-list
     1613       then do:
     1614           find first buf_xmllib_rec-fld-list
     1615                where buf_xmllib_rec-fld-list.closed = no
     1616           no-error.
     1617           if available buf_xmllib_rec-fld-list
     1618           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     1619           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     1620           then do:
     1621               find last buf_xmllib_rec
     1622                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     1623                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     1624                     and buf_xmllib_rec.closed   = no
     1625               use-index nm
     1626               no-error.
     1627               if available buf_xmllib_rec
     1628               then do:
     1629                   find last buf_xmllib_rec-fld
     1630                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     1631                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     1632                         and buf_xmllib_rec-fld.closed = no
     1633                   use-index nm
     1634                   no-error.
     1635                   if available buf_xmllib_rec-fld
     1636                   then do:
     1637                       assign
     1638                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     1639                       .
     1640                       if v-xmllib-codepage-convert = yes
     1641                       then do:
     1642                         assign
     1643                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     1644                         .
     1645                       end.
     1646                       run xmlchar-decode in this-procedure (
     1647                           input v-data-string
     1648                           , output v-data-string
     1649                       ).
     1650                       assign
     1651                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     1652                       .
     1653                   end.
     1654               end.
     1655           end.
     1656       end.
     1657   end.
     1658   end procedure.
     1659   procedure EndElement :
     1660   define input parameter p-name-space     as character        no-undo.
     1661   define input parameter p-local-name     as character        no-undo.
     1662   define input parameter p-q-name         as character        no-undo.
     1663       define buffer buf_rec             for temp_xmllib_rec.
     1664       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1665       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1666       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1667   do
     1668   for buf_rec
     1669     , buf_rec-fld
     1670     , buf_rec-list
     1671     , buf_rec-fld-list
     1672   on error undo, return error
     1673   :
     1674       find last buf_rec-list
     1675           where buf_rec-list.recName = p-q-name
     1676       use-index pi
     1677       no-error.
     1678       if available buf_rec-list
     1679       then do:
     1680           if buf_rec-list.closed = yes
     1681           then do:
     1682               run xmllib-parse-error in this-procedure (
     1683                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     1684                                   , p-q-name
     1685                                   )
     1686               ).
     1687           end.
     1688           else do:
     1689               find last buf_rec
     1690                   where buf_rec.recName  = buf_rec-list.recName
     1691                     and buf_rec.recLevel = buf_rec-list.recLevel
     1692                     and buf_rec.closed   = no
     1693               use-index nm
     1694               no-error.
     1695               if not available buf_rec
     1696               then do:
     1697                   run xmllib-parse-error in this-procedure (
     1698                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     1699                                       , p-q-name
     1700                                       , buf_rec-list.recLevel
     1701                                       )
     1702                   ).
     1703               end.
     1704               else do:
     1705                   find first buf_rec-fld-list
     1706                        where buf_rec-fld-list.recName  = buf_rec.recName
     1707                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     1708                          and buf_rec-fld-list.fldName  = p-q-name
     1709                          and buf_rec-fld-list.closed   = no
     1710                   no-error.
     1711                   if not available buf_rec-fld-list
     1712                   then do:
     1713                       if buf_rec.recName <> p-q-name
     1714                       then do:
     1715                           run xmllib-parse-error in this-procedure (
     1716                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     1717                                               , buf_rec.recName
     1718                                               )
     1719                           ).
     1720                       end.
     1721                       else do:
     1722                           assign
     1723                               buf_rec.closed              = yes
     1724                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1725                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1726                           .
     1727                           if buf_rec-list.recLevel > 0
     1728                           then do:
     1729                               assign
     1730                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     1731                               .
     1732                               for each buf_rec-fld-list
     1733                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     1734                               :
     1735                                   assign
     1736                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     1737                                   .
     1738                               end.
     1739                           end.
     1740                           else do:
     1741                               assign
     1742                                   buf_rec-list.closed         = yes
     1743                               .
     1744                           end.
     1745                       end.
     1746                   end.
     1747                   else do:
     1748                       find last buf_rec-fld
     1749                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1750                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1751                             and buf_rec-fld.closed  = no
     1752                       use-index nm
     1753                       no-error.
     1754                       if not available buf_rec-fld
     1755                       then do:
     1756                           run xmllib-parse-error in this-procedure (
     1757                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1758                                               , buf_rec-fld-list.fldName
     1759                                               , buf_rec.recName
     1760                                               , buf_rec.recLevel
     1761                                               )
     1762                           ).
     1763                       end.
     1764                       else do:
     1765                           assign
     1766                               buf_rec-fld.closed              = yes
     1767                               buf_rec-fld-list.closed         = yes
     1768                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1769                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1770                           .
     1771                       end.
     1772                   end.
     1773               end.
     1774           end.
     1775       end.
     1776       else do:
     1777           close-field-rec:
     1778           for each buf_rec-fld-list
     1779              where buf_rec-fld-list.fldName = p-q-name
     1780           :
     1781               find first buf_rec-list
     1782                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     1783                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     1784                      and buf_rec-list.closed   = no
     1785               no-error.
     1786               if available buf_rec-list
     1787               then do:
     1788                   find last buf_rec
     1789                       where buf_rec.recName  = buf_rec-list.recName
     1790                         and buf_rec.recLevel = buf_rec-list.recLevel
     1791                         and buf_rec.closed   = no
     1792                   use-index nm
     1793                   no-error.
     1794                   if not available buf_rec
     1795                   then do:
     1796                       run xmllib-parse-error in this-procedure (
     1797                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     1798                                           , p-q-name
     1799                                           )
     1800                       ).
     1801                   end.
     1802                   else do:
     1803                       find last buf_rec-fld
     1804                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1805                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1806                             and buf_rec-fld.closed  = no
     1807                       use-index nm
     1808                       no-error.
     1809                       if not available buf_rec-fld
     1810                       then do:
     1811                           run xmllib-parse-error in this-procedure (
     1812                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1813                                               , buf_rec-fld-list.fldName
     1814                                               , buf_rec.recName
     1815                                               , buf_rec.recLevel
     1816                                               )
     1817                           ).
     1818                       end.
     1819                       else do:
     1820                           assign
     1821                               buf_rec-fld.closed              = yes
     1822                               buf_rec-fld-list.closed         = yes
     1823                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1824                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1825                           .
     1826                       end.
     1827                   end.
     1828                   leave close-field-rec.
     1829               end.
     1830           end.
     1831       end.
     1832   end.
     1833   end procedure.
     1834   procedure Error :
     1835   define input parameter p-error-message     as character        no-undo.
     1836   do
     1837   on error undo, return error
     1838   :
     1839       run xmllib-parse-error in this-procedure (
     1840           input p-error-message
     1841       ).
     1842       assign
     1843           v-xmllib-error-status = yes
     1844       .
     1845   end.
     1846   end procedure.
     1847   procedure xmllib-parse-error :
     1848   define input parameter p-err-message    as character        no-undo.
     1849   do
     1850   on error undo, return error
     1851   :
     1852       if valid-handle(v-xmllib-log-handle) then do:
     1853         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     1854                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     1855                                    ,chr(10)
     1856                                    ,v-xmllib-dirname
     1857                                    ,v-xmllib-filename
     1858                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     1859                                      then v-xmllib-sax-reader-handle :locator-line-number
     1860                                      else ?)
     1861                                    ,p-err-message)).
     1862       end.
     1863       else do:
     1864         if v-xmllib-log-filename = "":U
     1865         then do:
     1866             message
     1867                     vss-workfile vss-revision vss-description
     1868                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     1869                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     1870                                  then v-xmllib-sax-reader-handle :locator-line-number
     1871                                  else ?)
     1872                 skip(1)
     1873                 skip p-err-message
     1874                 skip return-value
     1875                 skip trim( error-status :get-message( 1 ) )
     1876                     trim( error-status :get-message( 2 ) )
     1877                     trim( error-status :get-message( 3 ) )
     1878             view-as alert-box error.
     1879             undo, return error.
     1880         end.
     1881         else do:
     1882           output to value( v-xmllib-log-filename ).
     1883           put unformatted
     1884               substitute( "&1&2", chr(10), p-err-message )
     1885           .
     1886           output close.
     1887         end.
     1888       end.
     1889   end.
     1890   end procedure.
     1891   procedure xmllib-set-log-filename :
     1892   define input parameter p-log-filename   as character        no-undo.
     1893   do
     1894   on error undo, return error
     1895   :
     1896       run gbl/fileapnd.p (
     1897             input p-log-filename
     1898           , input "":U
     1899           , input 10
     1900       ) no-error.
     1901       if error-status :error
     1902       then do:
     1903           assign
     1904               v-xmllib-log-filename = "":U
     1905           .
     1906       end.
     1907       else do:
     1908           assign
     1909               v-xmllib-log-filename = p-log-filename
     1910           .
     1911       end.
     1912   end.
     1913   end procedure.
     1914   procedure xmllib-set-log-handle :
     1915   define input parameter p-log-handle    as handle        no-undo.
     1916   define input parameter p-log-proc-name as character no-undo .
     1917   do
     1918   on error undo, return error
     1919   :
     1920       if valid-handle(p-log-handle)
     1921       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     1922       then do:
     1923         assign
     1924         v-xmllib-log-handle    = p-log-handle
     1925         v-xmllib-log-proc-name = p-log-proc-name
     1926         .
     1927       end.
     1928       else do:
     1929         assign
     1930         v-xmllib-log-handle    = ?
     1931         v-xmllib-log-proc-name = '':U
     1932         .
     1933       end.
     1934   end.
     1935   end procedure.
     1936   procedure xmllib-set-prg-bar-handle :
     1937   define input parameter p-handle    as handle        no-undo.
     1938   do
     1939   on error undo, return error
     1940   :
     1941       if valid-handle(p-handle)
     1942       then do:
     1943         assign
     1944           v-xmllib-prg-bar-handle = p-handle
     1945         .
     1946       end.
     1947       else do:
     1948         assign
     1949           v-xmllib-prg-bar-handle = ?
     1950         .
     1951       end.
     1952   end.
     1953   end procedure.
     1954   procedure xmllib-set-codepage-convert :
     1955     define input  parameter p-codepage-source as character no-undo .
     1956     define input  parameter p-codepage-target as character no-undo .
     1957   do
     1958   on error undo, return error return-value
     1959   :
     1960     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     1961     then do:
     1962       assign
     1963         v-xmllib-codepage-convert = yes
     1964         v-xmllib-codepage-source  = p-codepage-source
     1965         v-xmllib-codepage-target  = p-codepage-target
     1966       .
     1967     end.
     1968     else do:
     1969       assign
     1970         v-xmllib-codepage-convert = no
     1971         v-xmllib-codepage-source  = ""
     1972         v-xmllib-codepage-target  = ""
     1973       .
     1974     end.
     1975   end.
     1976   end procedure.
     1977   procedure xmllib-parse-rec-open :
     1978   define input parameter p-rec-name   as character        no-undo.
     1979   define input parameter p-rec-level  as integer          no-undo.
     1980       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1981   do
     1982   for buf_temp_xmllib_rec
     1983   on error undo, return error
     1984   :
     1985        find first buf_temp_xmllib_rec
     1986            where buf_temp_xmllib_rec.recName = p-rec-name
     1987              and buf_temp_xmllib_rec.recLevel = p-rec-level
     1988              and buf_temp_xmllib_rec.closed  = no
     1989       use-index nm
     1990       no-error.
     1991       if available buf_temp_xmllib_rec
     1992       then do:
     1993           run xmllib-parse-error in this-procedure (
     1994               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     1995                               , p-rec-name
     1996                               , p-rec-level
     1997                               , buf_temp_xmllib_rec.recOpenLine
     1998                               )
     1999           ).
     2000       end.
     2001       else do:
     2002           assign
     2003               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     2004           .
     2005           create buf_temp_xmllib_rec.
     2006           assign
     2007               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     2008               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2009               buf_temp_xmllib_rec.recCloseLine    = 0
     2010               buf_temp_xmllib_rec.recName         = p-rec-name
     2011               buf_temp_xmllib_rec.recLevel        = p-rec-level
     2012               buf_temp_xmllib_rec.closed          = no
     2013           .
     2014       end.
     2015   end.
     2016   end procedure.
     2017   procedure xmllib-parse-rec-fld-open :
     2018   define input parameter p-rec-name   as character        no-undo.
     2019   define input parameter p-rec-level  as integer          no-undo.
     2020   define input parameter p-fld-name   as character        no-undo.
     2021       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     2022       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     2023   do
     2024   for buf_temp_xmllib_rec
     2025     , buf_temp_xmllib_rec-fld
     2026   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     2027                                           , return-value
     2028                                           , trim( error-status :get-message( 1 ) )
     2029                                           , trim( error-status :get-message( 2 ) ) )
     2030   :
     2031       find last buf_temp_xmllib_rec
     2032           where buf_temp_xmllib_rec.recName   = p-rec-name
     2033             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     2034             and buf_temp_xmllib_rec.closed    = no
     2035       use-index nm
     2036       no-error.
     2037       if not available buf_temp_xmllib_rec
     2038       then do:
     2039           run xmllib-parse-error in this-procedure (
     2040               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     2041                               , p-rec-name
     2042                               , p-fld-name
     2043                               , p-rec-level
     2044                               )
     2045           ).
     2046       end.
     2047       else do:
     2048           find last buf_temp_xmllib_rec-fld
     2049               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     2050                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     2051                 and buf_temp_xmllib_rec-fld.closed   = no
     2052           use-index nm
     2053           no-error.
     2054           if available buf_temp_xmllib_rec-fld
     2055           then do:
     2056               run xmllib-parse-error in this-procedure (
     2057                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     2058                                   , p-rec-name
     2059                                   , p-fld-name
     2060                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     2061                                   )
     2062               ).
     2063           end.
     2064           else do:
     2065               assign
     2066                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     2067               .
     2068               create buf_temp_xmllib_rec-fld.
     2069               assign
     2070                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     2071                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     2072                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2073                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2074                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2075                   buf_temp_xmllib_rec-fld.closed          = no
     2076               .
     2077           end.
     2078       end.
     2079   end.
     2080   end procedure.
     2081   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2082   define temp-table temp_trn-doc no-undo
     2083   field line-num as integer
     2084   field doc-code as character
     2085   field doc-date as date
     2086   field ext-doc-type as character
     2087   field cli-type as character
     2088   field cli-code as integer
     2089   field obj-type as character
     2090   field obj-code as integer
     2091   field wrkr as integer
     2092   field agnt as integer
     2093   field boss as integer
     2094   field creid as character
     2095   field ps as character
     2096   field host-code as integer
     2097   field contract-code as integer
     2098   field pay-code   as integer
     2099   field exch-code  as integer
     2100   field exch-rate  as decimal
     2101   field exch-scale as integer
     2102   field vat-type as character
     2103   index pi line-num doc-code .
     2104   define temp-table temp_doc-line no-undo
     2105   field line-num    as integer
     2106   field doc-code    as character
     2107   field gds-code    as integer
     2108   field artic       as character
     2109   field prod-type   as character
     2110   field prod-code   as integer
     2111   field fact-qnty   as decimal
     2112   field price-rubl  as decimal
     2113   field price-cli   as decimal
     2114   field vat-pc      as decimal
     2115   field cons-vat-pc as decimal
     2116   field line-num-str as integer
     2117   index pi
     2118   doc-code
     2119   line-num
     2120   gds-code
     2121   .
     2122   empty temp-table temp_trn-doc.
     2123   empty temp-table temp_doc-line.
     2124   v-ok = true  .
     2125   define variable v-full-filename as character  no-undo.
     2126   define buffer buf_rec-fld      for temp_xmllib_rec-fld.
     2127   define buffer buf_rec          for temp_xmllib_rec.
     2128   define buffer buf_goods for ub.goods  .
     2129       assign
     2130           v-full-filename   = search( p-full-name )
     2131       .
     2132       if v-full-filename <> ?
     2133       then do:
     2134           run xmllib-clear-parse-data in this-procedure.
     2135           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "line-num":U ).
     2136           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "doc-date":U ).
     2137           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "cli-code":U ).
     2138           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "cli-type":U ).
     2139           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "obj-code":U ).
     2140           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "obj-type":U ).
     2141           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "ext-doc-code":U ).
     2142           run xmllib-add-rec-fld in this-procedure ( input "trn-doc":U, input "ps":U ).
     2143           run xmllib-parse-file in this-procedure (
     2144               input v-full-filename
     2145               ) no-error.
     2146           if error-status :error
     2147           then do:
     2148               v-ok = false .
     2149               undo, return error substitute( "Ошибка разбора файла &1 теги trn-doc  &2", v-full-filename , return-value )  .
     2150           end.
     2151           run p-create no-error .
     2152           if error-status :error then do:
     2153               v-ok = false .
     2154               undo, return error substitute( "Ошибка разбора файла &1 теги trn-doc &2", v-full-filename , return-value )  .
     2155           end.
     2156           run xmllib-clear-parse-data in this-procedure.
     2157           run xmllib-add-rec-fld in this-procedure ( input "doc-line":U  , input "ext-doc-code":U ).
     2158           run xmllib-add-rec-fld in this-procedure ( input "doc-line":U  , input "line-num":U   ).
     2159           run xmllib-add-rec-fld in this-procedure ( input "doc-line":U  , input "fact-qnty":U   ).
     2160           run xmllib-add-rec-fld in this-procedure ( input "doc-line":U  , input "price-rubl":U   ).
     2161           run xmllib-add-rec-fld in this-procedure ( input "doc-line":U  , input "gds-code":U   ).
     2162           run xmllib-parse-file in this-procedure (
     2163               input v-full-filename
     2164               ) no-error.
     2165           if error-status :error
     2166           then do:
     2167               v-ok = false .
     2168               undo, return error substitute( "Ошибка разбора файла &1  теги doc-line &2", v-full-filename , return-value )  .
     2169           end.
     2170           run p-create no-error .
     2171           if error-status :error then do:
     2172               v-ok = false .
     2173               undo, return error substitute( "Ошибка разбора файла &1 теги doc-line &2", v-full-filename , return-value )  .
     2174           end.
     2175       end.
     2176   for each temp_doc-line :
     2177     if temp_doc-line.line-num = 0 or temp_doc-line.line-num = ? then do:
     2178        v-ok = false .
     2179        undo, return error
     2180        substitute(" В документе нет line-num  в тегах doc-line " ).
     2181     end.
     2182   end.
     2183   for each temp_trn-doc:
     2184     if temp_trn-doc.line-num = 0 or temp_trn-doc.line-num = ? then do:
     2185        v-ok = false .
     2186        undo, return error
     2187               substitute(" В документе нет line-num  в тегах trn-doc " ).
     2188     end.
     2189     for each temp_doc-line where
     2190              temp_doc-line.line-num = temp_trn-doc.line-num
     2191              :
     2192     if temp_doc-line.gds-code = 0 or temp_doc-line.gds-code = ? then do:
     2193        v-ok = false .
     2194        undo, return error
     2195               substitute(" В документе line-num = &1 тег &2 = &3 не верное значение  &4 &5 " , temp_doc-line.line-num ,
     2196                           "gds-code" , temp_doc-line.gds-code , return-value , error-status :get-message(1)  ) .
     2197     end.
     2198     if temp_doc-line.fact-qnty = 0 or temp_doc-line.fact-qnty = ? then do:
     2199        v-ok = false .
     2200        undo, return error
     2201               substitute(" В документе line-num = &1 тег &2 = &3 не верное значение  &4 &5 " , temp_doc-line.line-num ,
     2202                           "fact-qnty" , temp_doc-line.fact-qnty , return-value , error-status :get-message(1)  ) .
     2203     end.
     2204     if temp_doc-line.price-rubl = 0 or temp_doc-line.price-rubl = ? then do:
     2205        v-ok = false .
     2206        undo, return error
     2207               substitute(" В документе line-num = &1 тег &2 = &3 не верное значение  &4 &5 " , temp_doc-line.line-num ,
     2208                           "price-rubl" , temp_doc-line.price-rubl , return-value , error-status :get-message(1)  ) .
     2209     end.
     2210     find first buf_goods where buf_goods.gds-code  = temp_doc-line.gds-code  no-lock no-error .
     2211     if error-status :error then do:
     2212       v-ok = false .
     2213       undo, return error
     2214       substitute(" В документе line-num &1 тег &2  по нему не найден товар &3 &4 &5 " , temp_doc-line.line-num ,  "gds-code" , temp_doc-line.gds-code , return-value , error-status :get-message(1)  ) .
     2215     end.
     2216         temp_doc-line.artic     = buf_goods.artic .
     2217         temp_doc-line.prod-type = buf_goods.prod-type .
     2218         temp_doc-line.prod-code = buf_goods.prod-code .
     2219         temp_doc-line.price-cli  = temp_doc-line.price-rubl .
     2220     end.
     2221   end.
     2222   run utl/imp-izpr.p (
     2223     input parparentproc ,
     2224     input table temp_trn-doc ,
     2225     input table temp_doc-line ,
     2226     output p-trn-doc
     2227     ) no-error .
     2228     if error-status :error then do:
     2229       v-ok = false .
     2230       undo, return error  substitute("Создание запроса по &1 &2 &3" , temp_trn-doc.doc-code , return-value , error-status :get-message(1)  ) .
     2231     end.
     2232   RETURN.
     2233   procedure p-create :
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237           for each buf_rec
     2238           on error undo, return error
     2239           :
     2240               if buf_rec.recName = "trn-doc" then do:
     2241                 create temp_trn-doc.
     2242               end.
     2243               if buf_rec.recName = "doc-line" then do:
     2244                 create temp_doc-line.
     2245               end.
     2246               for each buf_rec-fld
     2247                  where buf_rec-fld.rec-key = buf_rec.rec-key
     2248               on error undo, return error
     2249               :
     2250               if buf_rec.recName = "trn-doc" then do:
     2251                  case buf_rec-fld.fldName:
     2252                   when "line-num":U then do: temp_trn-doc.line-num = INT(buf_rec-fld.fldValue) .  end.
     2253                   when "doc-date":U then do:
     2254                          temp_trn-doc.doc-date = date( int(substring(buf_rec-fld.fldValue,6,2)),int(substring(buf_rec-fld.fldValue,9,2)), int(substring(buf_rec-fld.fldValue,1,4))) no-error  .
     2255                          if error-status :error then do:
     2256                             return error substitute(" Не верно задана дата yyyy-mm-dd  &1" , buf_rec-fld.fldValue ) .
     2257                          end.
     2258                   end.
     2259                   when "cli-code":U then do: temp_trn-doc.cli-code = int(buf_rec-fld.fldValue) no-error . end.
     2260                   when "cli-type":U then do: temp_trn-doc.cli-type = buf_rec-fld.fldValue . end.
     2261                   when "obj-code":U then do: temp_trn-doc.obj-code = int(buf_rec-fld.fldValue) no-error  . end.
     2262                   when "obj-type":U then do: temp_trn-doc.obj-type = buf_rec-fld.fldValue . end.
     2263                   when "ps":U       then do: temp_trn-doc.ps       = buf_rec-fld.fldValue . end.
     2264                   when "ext-doc-code":U then do:
     2265                      if buf_rec-fld.fldValue <> "" then do:
     2266                         temp_trn-doc.doc-code = buf_rec-fld.fldValue .
     2267                      end.
     2268                   end.
     2269                  end case.
     2270               end.
     2271               if buf_rec.recName = "doc-line" then do:
     2272                   case buf_rec-fld.fldName:
     2273                     when "line-num":U     then do: temp_doc-line.line-num   = int(buf_rec-fld.fldValue) no-error .
     2274                          if error-status :error then do:
     2275                             return error substitute(" Не верно задан line-num &1" , buf_rec-fld.fldValue ) .
     2276                          end.
     2277                     end.
     2278                     when "fact-qnty":U    then do: temp_doc-line.fact-qnty  = decimal(buf_rec-fld.fldValue) .
     2279                          if error-status :error then do:
     2280                             return error substitute(" Не верно задан fact-qnty &1" , buf_rec-fld.fldValue ) .
     2281                          end.
     2282                     end.
     2283                     when "price-rubl":U   then do: temp_doc-line.price-rubl = decimal(buf_rec-fld.fldValue) .
     2284                          if error-status :error then do:
     2285                             return error substitute(" Не верно задан price-rubl &1" , buf_rec-fld.fldValue ) .
     2286                          end.
     2287                     end.
     2288                     when "gds-code":U     then do: temp_doc-line.gds-code   = int(buf_rec-fld.fldValue) .
     2289                          if error-status :error then do:
     2290                             return error substitute(" Не верно задан gds-code &1" , buf_rec-fld.fldValue ) .
     2291                          end.
     2292                     end.
     2293                     when "ext-doc-code":U then do:
     2294                           temp_doc-line.doc-code   = buf_rec-fld.fldValue .
     2295                          if error-status :error then do:
     2296                             return error substitute(" Не верно задан ext-doc-code &1" , buf_rec-fld.fldValue ) .
     2297                          end.
     2298                     end.
     2299                   end case.
     2300               end.
     2301               end.
     2302           end.
     2303     end.
     2304   end procedure.
