        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: h_toc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/h_toc.p $":U .
        7   define variable vss-description as character no-undo init "TOC ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "X(65)" no-undo
       63   initial "@(#)$Workfile$ $Revision$".
       64   define variable v-filelist-total-file-num           as integer      no-undo .
       65   define variable v-filelist-total-dir-num            as integer      no-undo .
       66   define variable v-filelist-main-procedure-handle    as handle       no-undo .
       67   define variable v-filelist-main-procedure-name      as character    no-undo .
       68   define temp-table temp-dirlist no-undo
       69       field dir-full-name     as character
       70       field dir-short-name    as character
       71       field need-process      as logical
       72       index xpk is primary unique dir-full-name
       73   .
       74   define temp-table temp-filelist no-undo
       75     field file-name        as character
       76     field file-name-no-ext as character
       77     field file-extension   as character
       78     field directory-name   as character
       79     field full-name        as character
       80     field dir-short-name   as character
       81     field need-process     as logical
       82     index xpk is unique primary full-name
       83     index xie1 directory-name file-name
       84     index xie2 directory-name file-name-no-ext
       85     index xie3 file-name
       86     index xie4 file-name-no-ext
       87     index xie5 need-process file-name
       88     .
       89   define stream dir-list .
       90   procedure filelist-get-file-num :
       91     define output parameter p-file-num as integer   no-undo .
       92     do
       93     on error undo, return error return-value
       94     :
       95       assign
       96         p-file-num = v-filelist-total-file-num
       97       .
       98     end.
       99   end procedure.
      100   procedure filelist-clear :
      101     do
      102     on error undo, return error return-value
      103     :
      104       define buffer buf_filelist for temp-filelist .
      105       assign
      106         v-filelist-total-file-num = 0
      107       .
      108       for each buf_filelist
      109       on error undo, return error
      110       :
      111         delete buf_filelist .
      112       end.
      113     end.
      114   end procedure.
      115   procedure filelist-init :
      116     do
      117     on error undo, return error
      118     :
      119       define input parameter p-dir-name       as character no-undo .
      120       define input parameter p-filter-ext     as logical   no-undo .
      121       define input parameter p-ext-list       as character no-undo .
      122       define input parameter p-dir-short-name as character no-undo .
      123       define buffer buf_temp-filelist for temp-filelist .
      124       if p-filter-ext = true
      125          and p-ext-list = ?
      126       or (p-filter-ext = false
      127          and p-ext-list <> ?
      128          and p-ext-list <> "":U
      129          )
      130       then do:
      131         message
      132           vss-workfile vss-revision vss-description skip
      133           "Ошибка задания входных параметров" skip
      134           "p-filter-ext" p-filter-ext skip
      135           "p-ext-list"   p-ext-list   skip
      136           view-as alert-box error .
      137         undo, return error .
      138       end.
      139       for each buf_temp-filelist
      140         where buf_temp-filelist.directory-name = p-dir-name
      141       on error undo, return error return-value
      142       :
      143         delete buf_temp-filelist .
      144       end.
      145       input stream dir-list from os-dir( p-dir-name ).
      146       define variable v-file                  as character no-undo .
      147       define variable v-path                  as character no-undo .
      148       define variable v-mask                  as character no-undo .
      149       define variable v-extension             as character no-undo .
      150       define variable v-file-name-without-ext as character no-undo .
      151       repeat
      152       on error undo, return error
      153       :
      154         import stream dir-list v-file v-path v-mask .
      155         if  v-mask <> ?
      156         and v-mask begins 'F':u
      157         then do:
      158         end.
      159         else do:
      160           next .
      161         end.
      162         if num-entries(v-file, '.':u) > 1
      163         then do:
      164           assign
      165             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      166             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      167           .
      168         end.
      169         else do:
      170           assign
      171             v-extension = ''
      172             v-file-name-without-ext = v-file
      173           .
      174         end.
      175         if p-filter-ext = true
      176         then do:
      177           if lookup(v-extension, p-ext-list) = 0
      178           then do:
      179             next .
      180           end.
      181         end.
      182         create buf_temp-filelist .
      183         assign
      184           buf_temp-filelist.file-name        = v-file
      185           buf_temp-filelist.directory-name   = p-dir-name
      186           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      187           buf_temp-filelist.file-extension   = v-extension
      188           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      189           buf_temp-filelist.dir-short-name   = p-dir-short-name
      190         .
      191         assign
      192           v-filelist-total-file-num = v-filelist-total-file-num + 1
      193         .
      194         if v-filelist-main-procedure-handle <> ?
      195         then do:
      196           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      197             (input "file":U
      198             , input v-filelist-total-file-num
      199             , input buf_temp-filelist.full-name
      200             , input buf_temp-filelist.file-name
      201             ) no-error.
      202           if error-status :error
      203           then do:
      204             message
      205               vss-workfile vss-revision vss-description skip
      206               "filelist-dirlist-subdir-init" skip(1)
      207               skip "Ошибка при вызове процедуры вывода"
      208               skip "результатов сканирования каталогов."
      209               skip return-value
      210               skip trim(error-status :get-message(1))
      211                       trim(error-status :get-message(2))
      212                       trim(error-status :get-message(3))
      213               view-as alert-box error.
      214             undo, return error .
      215           end.
      216         end.
      217       end.
      218       input stream dir-list close .
      219       return.
      220     end.
      221   end procedure.
      222   procedure filelist-dirlist-init-by-list :
      223     do
      224     on error undo, return error
      225     :
      226       define input parameter p-root-dir   as character no-undo .
      227       define input parameter p-dir-list   as character no-undo .
      228       define input parameter p-filter-ext as logical   no-undo .
      229       define input parameter p-ext-list   as character no-undo .
      230       define variable v-num-appdir as integer   no-undo .
      231       do v-num-appdir = 1 to num-entries(p-dir-list)
      232       :
      233         define variable v-curr-dir  as character no-undo .
      234         assign
      235           v-curr-dir = entry(v-num-appdir, p-dir-list)
      236         .
      237         run filelist-init in this-procedure
      238           (input p-root-dir + '/':u + v-curr-dir
      239           ,input p-filter-ext
      240           ,input p-ext-list
      241           ,input v-curr-dir
      242           ) .
      243       end.
      244     end.
      245   end procedure.
      246   procedure filelist-dirlist-clear :
      247     do
      248     on error undo, return error
      249     :
      250       define buffer buf_temp-dirlist for temp-dirlist .
      251       assign
      252           v-filelist-total-dir-num = 0
      253       .
      254       for each buf_temp-dirlist
      255       on error undo, return error
      256       :
      257         delete buf_temp-dirlist .
      258       end.
      259     end.
      260   end procedure.
      261   procedure filelist-dirlist-subdir-init :
      262   define input parameter p-dir-name   as character no-undo .
      263       define buffer buf_temp-dirlist for temp-dirlist .
      264   do
      265   for buf_temp-dirlist
      266   on error undo, return error
      267   :
      268       assign
      269           file-info :file-name = p-dir-name
      270       .
      271       if file-info :full-pathname = ?
      272       or index( file-info :file-type, "D" ) = 0
      273       then do:
      274           message
      275               vss-workfile vss-revision vss-description skip
      276               "filelist-dirlist-init: Заданного каталога не существует."
      277               skip (1)
      278               skip "Задан каталог:"
      279               skip substitute( "'&1'", p-dir-name )
      280           view-as alert-box error .
      281           undo, return error .
      282       end.
      283       input stream dir-list from os-dir( p-dir-name ).
      284       define variable v-file                  as character no-undo .
      285       define variable v-path                  as character no-undo .
      286       define variable v-mask                  as character no-undo .
      287       file-in-directory:
      288       repeat
      289       on error undo, return error
      290       :
      291           import stream dir-list
      292               v-file
      293               v-path
      294               v-mask
      295           .
      296           if  v-mask = ?
      297           or index( v-mask, 'D':u ) = 0
      298           or v-file = ".":U
      299           or v-file = "..":U
      300           then do:
      301               next file-in-directory.
      302           end.
      303           else do:
      304               find first buf_temp-dirlist
      305                    where buf_temp-dirlist.dir-full-name    = v-path
      306               no-error.
      307               if not available buf_temp-dirlist
      308               then do:
      309                   create buf_temp-dirlist .
      310                   assign
      311                       buf_temp-dirlist.dir-full-name    = v-path
      312                       buf_temp-dirlist.dir-short-name   = v-file
      313                       buf_temp-dirlist.need-process     = yes
      314                   .
      315               end.
      316               assign
      317                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      318               .
      319               if v-filelist-main-procedure-handle <> ?
      320               then do:
      321                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      322                         input "dir":U
      323                       , input v-filelist-total-dir-num
      324                       , input buf_temp-dirlist.dir-full-name
      325                       , input buf_temp-dirlist.dir-short-name
      326                   ) no-error.
      327                   if error-status :error
      328                   then do:
      329                       message
      330                           vss-workfile vss-revision vss-description skip
      331                           "filelist-dirlist-subdir-init"
      332                           skip(1)
      333                           skip "Ошибка при вызове процедуры вывода"
      334                           skip "результатов сканирования каталогов."
      335                           skip return-value
      336                           skip trim(error-status :get-message(1))
      337                                trim(error-status :get-message(2))
      338                                trim(error-status :get-message(3))
      339                       view-as alert-box error.
      340                       undo, return error .
      341                   end.
      342               end.
      343           end.
      344       end.
      345       input stream dir-list close .
      346   end.
      347   end procedure.
      348   procedure filelist-dirlist-init :
      349   define input parameter p-dir-name   as character no-undo .
      350       define variable v-file  as character no-undo.
      351       define variable v-path  as character no-undo.
      352       define variable v-mask  as character no-undo.
      353       define buffer buf_temp-dirlist for temp-dirlist .
      354   do
      355   for buf_temp-dirlist
      356   on error undo, return error
      357   :
      358       assign
      359           file-info :file-name = p-dir-name
      360       .
      361       if file-info :full-pathname = ?
      362       or index( file-info :file-type, "D" ) = 0
      363       then do:
      364           message
      365               vss-workfile vss-revision vss-description skip
      366               "filelist-dirlist-init: Заданного каталога не существует."
      367               skip (1)
      368               skip "Задан каталог:"
      369               skip substitute( "'&1'", p-dir-name )
      370           view-as alert-box error .
      371           undo, return error .
      372       end.
      373       for each buf_temp-dirlist
      374          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      375       on error undo, return error return-value
      376       :
      377           delete buf_temp-dirlist .
      378       end.
      379       create buf_temp-dirlist .
      380       assign
      381           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      382           buf_temp-dirlist.dir-short-name   = file-info :file-name
      383           buf_temp-dirlist.need-process     = yes
      384       .
      385       do
      386       while available buf_temp-dirlist
      387       on error undo, return error
      388       :
      389           run filelist-dirlist-subdir-init in this-procedure (
      390               input buf_temp-dirlist.dir-full-name
      391           ).
      392           assign
      393               buf_temp-dirlist.need-process = no
      394           .
      395           find first buf_temp-dirlist
      396                where buf_temp-dirlist.need-process = yes
      397           no-error.
      398       end.
      399   end.
      400   end procedure.
      401   procedure filelist-set-procedure-handle :
      402   define input parameter p-proc-handle    as handle           no-undo.
      403   define input parameter p-proc-name      as character        no-undo.
      404       define variable v-signature    as character    no-undo.
      405   do
      406   on error undo, return error
      407   :
      408       if p-proc-handle = ?
      409       or not valid-handle( p-proc-handle )
      410       or p-proc-handle :get-signature( p-proc-name ) = ""
      411       then do:
      412           assign
      413               v-filelist-main-procedure-handle = ?
      414               v-filelist-main-procedure-name   = ""
      415           .
      416           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      417       end.
      418       else do:
      419           assign
      420               v-signature = p-proc-handle :get-signature( p-proc-name )
      421           .
      422           if entry(   1, v-signature )    = "PROCEDURE":U
      423           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      424           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      425           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      426           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      427           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      428           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      429           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      430           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      431           then do:
      432               assign
      433                   v-filelist-main-procedure-handle = p-proc-handle
      434                   v-filelist-main-procedure-name   = p-proc-name
      435               .
      436           end.
      437           else do:
      438               assign
      439                   v-filelist-main-procedure-handle = ?
      440                   v-filelist-main-procedure-name   = ""
      441               .
      442               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      443           end.
      444       end.
      445   end.
      446   end procedure.
      447   procedure filelist-clear-procedure-handle :
      448   do
      449   on error undo, return error
      450   :
      451       assign
      452           v-filelist-main-procedure-handle = ?
      453           v-filelist-main-procedure-name   = ?
      454       .
      455   end.
      456   end procedure.
      457   procedure filelist-build-by-dirlist :
      458       define buffer buf_temp-dirlist      for temp-dirlist.
      459   do
      460   for buf_temp-dirlist
      461   on error undo, return error
      462   :
      463       for each buf_temp-dirlist
      464       on error undo, return error
      465       :
      466           run filelist-init in this-procedure (
      467                 input buf_temp-dirlist.dir-full-name
      468               , input no
      469               , input "":U
      470               , input buf_temp-dirlist.dir-short-name
      471           ).
      472       end.
      473   end.
      474   end procedure.
      475   procedure filelist-check-dir-exists :
      476   define input parameter p-dir-name   as character        no-undo.
      477   define output parameter p-exists    as logical          no-undo.
      478   do
      479   on error undo, return error
      480   :
      481       assign
      482           file-info :file-name = p-dir-name
      483       .
      484       if file-info :file-type <> ?
      485       and substring( file-info :file-type, 1, 1 ) = "D":U
      486       then do:
      487           assign
      488               p-exists = yes
      489           .
      490       end.
      491       else do:
      492           assign
      493               p-exists = no
      494           .
      495       end.
      496   end.
      497   end procedure.
      498   define variable  v-fill-name   as character no-undo .
      499   define variable  v-workfile_   as character no-undo .
      500   define variable  v-author      as character no-undo .
      501   define variable  v-description as character no-undo .
      502   define variable  v-hlp as logical no-undo .
      503   define variable g#log as logical no-undo .
      504   define variable my-dir as character no-undo init "c:\help\".
      505   define variable v-exist as logical no-undo init false .
      506   g#log =  session:SET-WAIT-STATE("GENERAL") .
      507   define stream old-stream .
      508   define stream toc-stream .
      509   define stream in-stream .
      510   input stream old-stream from value (my-dir + "toc.hhc") .
      511   output stream toc-stream to value ( my-dir + "new-toc.hhc") .
      512   define variable i as integer no-undo init 0 .
      513   define variable pp as integer no-undo init 0 .
      514   define work-table temp-tt no-undo
      515   field v-temp-char as character
      516   .
      517   repeat :
      518     create temp-tt.
      519     import stream old-Stream unformatted temp-tt.v-temp-char no-error .
      520     i = i + 1.
      521     temp-tt.v-temp-char = caps(temp-tt.v-temp-char).
      522   end.
      523   run filelist-init
      524       ( "c:/help" ,
      525         true                        ,
      526         "htm"                       ,
      527         "c:/help"
      528         )  no-error .
      529           if error-status :error then
      530                   message vss-workfile vss-revision vss-description skip
      531                 "Ошибка 2 " skip
      532                   skip
      533                   error-status :get-message(1) skip
      534                   return-value skip
      535                   view-as alert-box error
      536           .
      537         for each temp-filelist
      538             on error undo, return error :
      539             run h_tt (
      540                 input temp-filelist.full-name ,
      541                 output   v-fill-name   ,
      542                 output   v-workfile_   ,
      543                 output   v-author      ,
      544                 output   v-description ,
      545                 output   v-hlp
      546                   )
      547                 no-error .
      548                 if error-status :error then message vss-workfile vss-revision vss-description skip
      549                        "Ошибка 3 " skip
      550                         skip
      551                         error-status :get-message(1) skip
      552                         return-value skip
      553                         view-as alert-box error
      554                 .
      555               find first temp-tt where  index(temp-tt.v-temp-char , caps('"' + temp-filelist.file-name-no-ext + ".htm")) > 0 no-error .
      556               if not available temp-tt then do:
      557                           run make-toc (temp-filelist.file-name-no-ext , v-description ).
      558               end.
      559         end.
      560   input  stream old-stream close.
      561   output stream toc-stream close.
      562   input stream in-stream close.
      563   g#log =  session:SET-WAIT-STATE("") .
      564   message "ВСЕ готово в " my-dir "new-toc.txt" .
      565   procedure make-toc :
      566    do
      567    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      568    :
      569   define input  parameter  var-htm as character no-undo .
      570   define input  parameter  var-name as character no-undo .
      571   if var-htm  = ? then var-htm  = "" .
      572   if var-name  = ? then var-name  = "" .
      573   put stream toc-stream unformatted
      574   '  <LI> <OBJECT type="text/sitemap">'                    skip
      575   '    <param name="Name" value="' + var-name + '">'       skip
      576   '    <param name="Local" value="' + var-htm + '.htm">'   skip
      577   '    <param name="ImageNumber" value="41">           '   skip
      578   '    </OBJECT>'                                          skip
      579   .
      580    end.
      581   end procedure.
      582   procedure h_tt :
      583     do
      584     on error undo, return error return-value
      585     :
      586   define input parameter   p-file-name as character no-undo .
      587   define output parameter  fill-name   as character no-undo .
      588   define output parameter  workfile_   as character no-undo .
      589   define output parameter  author      as character no-undo .
      590   define output parameter  description as character no-undo .
      591   define output parameter app_help as logical no-undo .
      592   input stream in-stream from value( p-file-name ) .
      593   define variable v-temp-char as character no-undo .
      594   define variable start1 as integer   no-undo .
      595   define variable len as integer   no-undo .
      596   description = "".
      597   repeat :
      598     import stream In-Stream unformatted v-temp-char no-error .
      599     v-temp-char = trim (v-temp-char) no-error .
      600     if v-temp-char begins "<title>" then do:
      601       start1 = 7 + index(v-temp-char,"<title>") .
      602       len =  index(v-temp-char,"</title>")  - start1.
      603       if len < 0 then len = 10 .
      604       if start1 < 0 then start1 = 1.
      605       description = trim(substring(v-temp-char,start1,len )) .
      606       leave.
      607     end.
      608   end.
      609     end.
      610   end procedure.
