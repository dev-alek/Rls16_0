     1633           delete object buf_h9.
     1634        end.
     1635        if v-avail9 > 0
     1636           and buf_code-range.stts = "f":U
     1637         then do:
     1638           assign
     1639             buf_code-range.stts = "u":U
     1640             v-b-code            = v-b-code + 1
     1641             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1642                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1643                                               , chr(10)
     1644                                               , buf_code-range.first-code
     1645                                               , buf_code-range.last-code
     1646                                               , v-code-mess9
     1647                                             )
     1648           .
     1649           if p-view-mess = true then do:
     1650             message
     1651               v-msg
     1652               view-as alert-box information.
     1653           end.
     1654           else do:
     1655             output stream getmc-stream to "getmc.log" append.
     1656             put stream getmc-stream unformatted
     1657               string( today, "99/99/9999" ) space(1)
     1658               string( time, "HH:MM:SS" ) space(1)
     1659               v-msg skip
     1660             .
     1661             output stream getmc-stream close.
     1662           end.
     1663         end.
     1664         if v-avail9 = 0
     1665           and buf_code-range.stts = "u":U
     1666         then do:
     1667           find first buf-c_code-range exclusive-lock
     1668             where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1669           .
     1670           assign
     1671             buf-c_code-range.stts = "c":U
     1672           .
     1673           release buf-c_code-range .
     1674           assign
     1675             buf_code-range.stts = "f":U
     1676             v-b-code            = v-b-code + 1
     1677             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
     1678                                               + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1679                                               , chr(10)
     1680                                               , buf_code-range.first-code
     1681                                               , buf_code-range.last-code
     1682                                             )
     1683           .
     1684           if p-view-mess = true then do:
     1685             message
     1686               v-msg
     1687               view-as alert-box information.
     1688           end.
     1689           else do:
     1690             output stream getmc-stream to "getmc.log" append.
     1691             put stream getmc-stream unformatted
     1692               string( today, "99/99/9999" ) space(1)
     1693               string( time, "HH:MM:SS" ) space(1)
     1694               v-msg skip
     1695             .
     1696             output stream getmc-stream close.
     1697           end.
     1698         end.
     1699       end.
     1700     end.
     1701   end case.
     1702         end.
     1703         when 'scgb':U
     1704         or when 'sclc':U
     1705         then do:
     1706           case p-action :
     1707             when "get-m-code":U then do:
     1708               assign
     1709                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1710               .
     1711             end.
     1712             when "f-u":U then do:
     1713               assign
     1714                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1715               .
     1716               run mark-all-used-as-free in this-procedure (
     1717                                          input  p-db-num
     1718                                         ,input  p-curr-type-cdrg
     1719                                         ,output str-u-f
     1720                                         ,output str-u-f-rng
     1721                                       ).
     1722             end.
     1723           end case.
     1724           view frame get-max-code-inf.
     1725           assign
     1726             rec-cnt = 0
     1727           .
     1728           display
     1729             rec-cnt
     1730             with frame get-max-code-inf
     1731           .
     1732           for each buf_units no-lock
     1733               where lookup('вес':U, buf_units.type) > 0
     1734           on error undo, return error
     1735           :
     1736             for each buf_goods no-lock
     1737               where buf_goods.unit-base = buf_units.unit-name
     1738             on error undo, return error
     1739             :
     1740               assign
     1741                 rec-cnt = rec-cnt + 1
     1742               .
     1743               if ( rec-cnt modulo 10 ) = 0 then do:
     1744                 display
     1745                   rec-cnt
     1746                   with frame get-max-code-inf
     1747                 .
     1748               end.
     1749               run mc_gdsbcode in this-procedure (
     1750                                input  buf_goods.gds-code
     1751                               ,input  ?
     1752                               ,output v-main-bcode
     1753                             ) no-error .
     1754               if error-status :error then do:
     1755                 message
     1756                   vss-workfile vss-revision vss-description skip
     1757                   "Ошибка при поиске корневого бар-кода" skip
     1758                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1759                   error-status :get-message(1) skip
     1760                   return-value skip
     1761                   view-as alert-box error .
     1762                 undo, return error .
     1763               end.
     1764               for each buf_prod-bc no-lock
     1765                   where buf_prod-bc.b-code = v-main-bcode
     1766               on error undo, return error
     1767               :
     1768                 if p-curr-type-cdrg = 'sclc':U
     1769                   and buf_prod-bc.bc-on = FALSE
     1770                 then do:
     1771                   next.
     1772                 end.
     1773                 run mc_prodbcat in this-procedure (
     1774                                  buffer buf_prod-bc
     1775                                 ,input  'global=request':u
     1776                                 ,output l-prod-bc-global
     1777                               ) no-error .
     1778                 if error-status :error then do:
     1779                   message
     1780                     vss-workfile vss-revision vss-description skip
     1781                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1782                     "Основной бар-код" buf_prod-bc.b-code skip
     1783                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1784                     "Действие global=request" skip
     1785                     error-status :get-message(1) skip
     1786                     return-value skip
     1787                     view-as alert-box error .
     1788                   undo, return error .
     1789                 end.
     1790                 run mc_prodbcat in this-procedure (
     1791                                  buffer buf_prod-bc
     1792                                 ,input  'weight=request':u
     1793                                 ,output l-prod-bc-weight
     1794                               ) no-error .
     1795                 if error-status :error then do:
     1796                   message
     1797                     vss-workfile vss-revision vss-description skip
     1798                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1799                     "Основной бар-код" buf_prod-bc.b-code skip
     1800                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1801                     "Действие weight=request" skip
     1802                     error-status :get-message(1) skip
     1803                     return-value skip
     1804                     view-as alert-box error .
     1805                   undo, return error .
     1806                 end.
     1807                 if l-prod-bc-weight
     1808                   and ( ( l-prod-bc-global
     1809                           and p-curr-type-cdrg = 'scgb':U
     1810                         )
     1811                         or
     1812                         ( not l-prod-bc-global
     1813                           and p-curr-type-cdrg = 'sclc':U
     1814                         )
     1815                       )
     1816                 then do:
     1817                   case p-action :
     1818                     when "get-m-code":U then do:
     1819                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1820                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1821                         and integer( buf_prod-bc.b-str ) > v-b-code
     1822                       then do:
     1823                         assign
     1824                           v-b-code = integer( buf_prod-bc.b-str )
     1825                         .
     1826                       end.
     1827                     end.
     1828                     when "f-u":U then do:
     1829                       for each buf_code-range
     1830                         where buf_code-range.db-num     = p-db-num
     1831                           and buf_code-range.range-type = p-curr-type-cdrg
     1832                           and buf_code-range.stts       = "f":U
     1833                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1834                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1835                       on error undo, return error
     1836                       :
     1837                         assign
     1838                           buf_code-range.stts = "u":U
     1839                         .
     1840                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1841                           assign
     1842                             str-u-f-rng = diff-list( str-u-f-rng
     1843                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1844                                                     ,",":U
     1845                                                     )
     1846                           .
     1847                         end.
     1848                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1849                           assign
     1850                             v-b-code = v-b-code + 1
     1851                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1852                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1853                                                     , chr(10)
     1854                                                     , buf_code-range.first-code
     1855                                                     , buf_code-range.last-code
     1856                                                     , buf_prod-bc.b-str
     1857                                                   )
     1858                             v-ret-msg = v-ret-msg + v-msg
     1859                           .
     1860                           if p-view-mess = true then do:
     1861                             message
     1862                               v-msg
     1863                               view-as alert-box information.
     1864                           end.
     1865                         end.
     1866                       end.
     1867                     end.
     1868                   end case.
     1869                 end.
     1870               end.
     1871             end.
     1872           end.
     1873           if p-action = "f-u":U then do:
     1874             do ind = 1 to num-entries( str-u-f-rng ):
     1875               assign
     1876                 v-b-code  = v-b-code + 1
     1877                 v-msg     = substitute( "Диапазон кодов &2&1"
     1878                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1879                                         , chr(10)
     1880                                         , entry( ind, str-u-f-rng )
     1881                                       )
     1882                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1883               .
     1884               if p-view-mess = true then do:
     1885                 message
     1886                   v-msg
     1887                   view-as alert-box information.
     1888               end.
     1889             end.
     1890           end.
     1891           hide frame get-max-code-inf no-pause .
     1892         end.
     1893         when 'pglc':U
     1894         then do:
     1895           case p-action :
     1896             when "get-m-code":U then do:
     1897               assign
     1898                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1899               .
     1900             end.
     1901             when "f-u":U then do:
     1902               assign
     1903                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1904               .
     1905               run mark-all-used-as-free in this-procedure (
     1906                                          input  p-db-num
     1907                                         ,input  p-curr-type-cdrg
     1908                                         ,output str-u-f
     1909                                         ,output str-u-f-rng
     1910                                       ).
     1911             end.
     1912           end case.
     1913           view frame get-max-code-inf.
     1914           assign
     1915             rec-cnt = 0
     1916           .
     1917           display
     1918             rec-cnt
     1919             with frame get-max-code-inf
     1920           .
     1921           for each buf_prod-bc no-lock where
     1922                   buf_prod-bc.b-str >= "00100"
     1923               and buf_prod-bc.b-str <= "99999"
     1924               and buf_prod-bc.bc-on-type = 'pglc':U
     1925               and length(buf_prod-bc.b-str) = 5
     1926           on error undo, return error
     1927           :
     1928               assign
     1929                 rec-cnt = rec-cnt + 1
     1930               .
     1931               if ( rec-cnt modulo 10 ) = 0 then do:
     1932                 display
     1933                   rec-cnt
     1934                   with frame get-max-code-inf
     1935                 .
     1936               end.
     1937               if p-curr-type-cdrg = 'pglc':U
     1938                 and buf_prod-bc.bc-on = FALSE
     1939               then do:
     1940                 next.
     1941               end.
     1942               run mc_prodbcat in this-procedure (
     1943                                 buffer buf_prod-bc
     1944                               ,input  'pgweight=request':u
     1945                               ,output l-prod-bc-pgweight
     1946                             ) no-error .
     1947               if error-status :error then do:
     1948                 message
     1949                   vss-workfile vss-revision vss-description skip
     1950                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1951                   "Основной бар-код" buf_prod-bc.b-code skip
     1952                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1953                   "Действие weight=request" skip
     1954                   error-status :get-message(1) skip
     1955                   return-value skip
     1956                   view-as alert-box error .
     1957                 undo, return error .
     1958               end.
     1959               if l-prod-bc-pgweight
     1960               and p-curr-type-cdrg = 'pglc':U
     1961               then do:
     1962                 case p-action :
     1963                   when "get-m-code":U then do:
     1964                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1965                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1966                       and integer( buf_prod-bc.b-str ) > v-b-code
     1967                     then do:
     1968                       assign
     1969                         v-b-code = integer( buf_prod-bc.b-str )
     1970                       .
     1971                     end.
     1972                   end.
     1973                   when "f-u":U then do:
     1974                     for each buf_code-range
     1975                       where buf_code-range.db-num     = p-db-num
     1976                         and buf_code-range.range-type = p-curr-type-cdrg
     1977                         and buf_code-range.stts       = "f":U
     1978                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1979                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1980                     on error undo, return error
     1981                     :
     1982                     assign
     1983                     buf_code-range.stts = "u":U
     1984                       .
     1985                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1986                         assign
     1987                           str-u-f-rng = diff-list( str-u-f-rng
     1988                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1989                                                   ,",":U
     1990                                                   )
     1991                         .
     1992                     end.
     1993                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1994                         assign
     1995                           v-b-code = v-b-code + 1
     1996                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1997                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1998                                                   , chr(10)
     1999                                                   , buf_code-range.first-code
     2000                                                   , buf_code-range.last-code
     2001                                                   , buf_prod-bc.b-str
     2002                                                 )
     2003                           v-ret-msg = v-ret-msg + v-msg
     2004                         .
     2005                       if p-view-mess = true then do:
     2006                         message
     2007                           v-msg
     2008                           view-as alert-box information.
     2009                       end.
     2010                     end.
     2011                   end.
     2012                 end.
     2013               end case.
     2014             end.
     2015           end.
     2016           if p-action = "f-u":U then do:
     2017             do ind = 1 to num-entries( str-u-f-rng ):
     2018               assign
     2019                 v-b-code = v-b-code + 1
     2020                 v-msg     = substitute( "Диапазон кодов &2&1"
     2021                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     2022                                         , chr(10)
     2023                                         , entry( ind, str-u-f-rng )
     2024                                       )
     2025                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     2026               .
     2027               if p-view-mess = true then do:
     2028                 message
     2029                   v-msg
     2030                   view-as alert-box information.
     2031               end.
     2032             end.
     2033           end.
     2034           hide frame get-max-code-inf no-pause .
     2035         end.
     2036         otherwise do:
     2037           message
     2038             vss-workfile vss-revision vss-description skip
     2039             "get-max-code" skip
     2040             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     2041             view-as alert-box error.
     2042           return error.
     2043         end.
     2044       end case.
     2045     end.
     2046     return v-ret-msg.
     2047   end procedure.
     2048   procedure mark-all-used-as-free :
     2049     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     2050     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     2051     define output parameter p-str-u-f        as   character                 no-undo .
     2052     define output parameter p-str-u-f-rng    as   character                 no-undo .
     2053     do
     2054     on error undo, return error
     2055     :
     2056       define buffer buf_code-range   for ub.code-range.
     2057       define buffer buf-c_code-range for ub.code-range .
     2058       assign
     2059         p-str-u-f     = "":U
     2060         p-str-u-f-rng = "":U
     2061       .
     2062       for each buf_code-range share-lock
     2063           where buf_code-range.db-num     = p-db-num
     2064             and buf_code-range.range-type = p-curr-type-cdrg
     2065             and buf_code-range.stts       = "u":U
     2066       on error undo, return error
     2067       :
     2068         find first buf-c_code-range exclusive-lock
     2069           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     2070         .
     2071         assign
     2072           buf-c_code-range.stts = "c":U
     2073         .
     2074         release buf-c_code-range .
     2075         assign
     2076           buf_code-range.stts = "f":U
     2077           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     2078           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     2079         .
     2080       end.
     2081       assign
     2082         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     2083         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     2084       .
     2085     end.
     2086   end procedure.
     2087   procedure mc_prodbcat :
     2088     do
     2089     on error undo, return error
     2090     :
     2091       define parameter buffer buf_prod-bc  for ub.prod-bc .
     2092       define input  parameter p-action           as character no-undo .
     2093       define output parameter p-return-attribute as logical no-undo .
     2094       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     2095       define buffer buf_bar-code   for ub.bar-code   .
     2096       define buffer buf_units      for ub.units      .
     2097       define buffer buf_code-range for ub.code-range .
     2098       define variable p-code-int as integer no-undo .
     2099       define variable v-cdrg-type as character no-undo .
     2100       if not available buf_prod-bc then do:
     2101         message
     2102           vss-workfile vss-revision vss-description skip
     2103           "Ошибка задания входных параметров" skip
     2104           "Не задан дополнительный бар-код" skip
     2105           view-as alert-box error .
     2106         undo, return error .
     2107       end.
     2108       find first buf_bar-code no-lock
     2109         where buf_bar-code.b-code = buf_prod-bc.b-code
     2110         no-error .
     2111       if not available buf_bar-code then do:
     2112         message
     2113           vss-workfile vss-revision vss-description skip
     2114           "Неправильная ссылка на основной бар-код" skip
     2115           "Основной бар-код" buf_prod-bc.b-code skip
     2116           "Дополнительный бар-код" buf_prod-bc.b-str skip
     2117           view-as alert-box error .
     2118         undo, return error .
     2119       end.
     2120       find first buf_units no-lock
     2121         where buf_units.unit-name = buf_bar-code.unit-cli
     2122         no-error .
     2123       if not available buf_units then do:
     2124         message
     2125           vss-workfile vss-revision vss-description skip
     2126           "Не найдена единица измерения основного бар-кода" skip
     2127           "Основной бар-код" buf_bar-code.b-code skip
     2128           "Единица измерения" buf_bar-code.unit-cli skip
     2129           view-as alert-box error .
     2130         undo, return error .
     2131       end.
     2132       def var ind                    as integer   no-undo .
     2133       def var v-num-entries-p-action as integer   no-undo .
     2134       def var v-action               as character no-undo .
     2135       assign
     2136         v-num-entries-p-action = num-entries(p-action)
     2137       .
     2138       assign
     2139         p-return-attribute = true
     2140       .
     2141       _ind:
     2142       do ind = 1 to v-num-entries-p-action
     2143       :
     2144        if ind > 1 and p-return-attribute = false then return.
     2145         assign
     2146           v-action = entry(ind, p-action)
     2147         .
     2148         case v-action :
     2149           when "global=request":u
     2150           then do:
     2151             if not (buf_prod-bc.bc-on-type = ''
     2152             or buf_prod-bc.bc-on-type = 'scgb':U
     2153             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2154               assign
     2155                 p-return-attribute = false
     2156               .
     2157             end.
     2158           end.
     2159           when "weight=request":u
     2160           then do:
     2161             if not (buf_prod-bc.bc-on-type = 'sclc':U
     2162             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     2163               assign
     2164                 p-return-attribute = false.
     2165             end.
     2166           end.
     2167           when "pgweight=request":u
     2168           then do:
     2169             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     2170               assign
     2171                 p-return-attribute = false.
     2172             end.
     2173           end.
     2174           when "petrolium=request":u
     2175           then do:
     2176             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     2177               assign
     2178                 p-return-attribute = false.
     2179             end.
     2180           end.
     2181           when "scaleable=request":u
     2182           then do:
     2183             if not (buf_prod-bc.bc-on-type = 'sslc':U
     2184             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2185               assign
     2186                 p-return-attribute = false.
     2187             end.
     2188           end.
     2189           otherwise do:
     2190             message
     2191               vss-workfile vss-revision vss-description skip
     2192               "Неизвестное значение параметра v-action " skip
     2193               "v-action" v-action skip
     2194               "p-action" p-action skip
     2195               view-as alert-box error .
     2196             undo, return error .
     2197           end.
     2198         end case.
     2199       end.
     2200     end.
     2201   end procedure.
     2202   procedure mc_gdsbcode :
     2203     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     2204     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     2205     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     2206     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     2207     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     2208     define buffer buf_bar-code for ub.bar-code .
     2209     def var v-unit-base like ub.goods.unit-base no-undo .
     2210     do
     2211     on error undo, return error
     2212     :
     2213       if p-node-code = ? then do:
     2214         run mc_gdsrootnode in this-procedure (
     2215            input  p-gds-code
     2216           ,output p-node-code
     2217           ) no-error .
     2218         if error-status :error then do:
     2219           message
     2220             vss-workfile vss-revision vss-description skip
     2221             "Ошибка при определении корневого признака товара" skip
     2222             "Код товара" p-gds-code skip
     2223             error-status :get-message(1) skip
     2224             return-value skip
     2225             view-as alert-box error .
     2226           undo, return error .
     2227         end.
     2228       end.
     2229       run mc_unitbase in this-procedure (
     2230          input  p-gds-code
     2231         ,output v-unit-base
     2232         ) no-error .
     2233       if error-status :error then do:
     2234         message
     2235           vss-workfile vss-revision vss-description skip
     2236           "Ошибка определения базовой единицы измерения товара" skip
     2237           "Код товара" p-gds-code skip
     2238           view-as alert-box error .
     2239         undo, return error .
     2240       end.
     2241       find first buf_bar-code no-lock
     2242         where buf_bar-code.gds-code  = p-gds-code
     2243           and buf_bar-code.node-code = p-node-code
     2244           and buf_bar-code.part-code = ""
     2245           and buf_bar-code.in-code   = ""
     2246           and buf_bar-code.unit-cli  = v-unit-base
     2247         no-error .
     2248       if not available buf_bar-code then do:
     2249         undo, return error vss-proc-revision + ":" + chr(10)
     2250           + "Не найден первичный бар-кода признака " + chr(10)
     2251           + "Код товара " + string(p-gds-code) + chr(10)
     2252           + "Код признака " + string(p-node-code) + chr(10)
     2253           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2254           .
     2255       end.
     2256       assign
     2257         p-b-code = buf_bar-code.b-code
     2258       .
     2259     end.
     2260   end procedure.
     2261   procedure mc_gdsrootnode :
     2262     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2263     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2264     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2265     define buffer buf_goods   for ub.goods .
     2266     do
     2267     on error undo, return error
     2268     :
     2269       find first buf_goods no-lock
     2270         where buf_goods.gds-code  = p-gds-code
     2271         no-error .
     2272       if not available buf_goods then do:
     2273         message
     2274           vss-workfile vss-revision vss-description skip
     2275           "Не найден товар" skip
     2276           "Код товара" p-gds-code skip
     2277           view-as alert-box error .
     2278         undo, return error .
     2279       end.
     2280       run mc_prt-root-to-node-code in this-procedure (
     2281          input  buf_goods.prt-root
     2282         ,output p-root-node
     2283         ) no-error .
     2284       if error-status :error then do:
     2285         message
     2286           vss-workfile vss-revision vss-description skip
     2287           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2288           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2289           "Указатель на корень шкалы" buf_goods.prt-root skip
     2290           error-status :get-message(1) skip
     2291           return-value skip
     2292           view-as alert-box error .
     2293         undo, return error .
     2294       end.
     2295     end.
     2296   end procedure.
     2297   procedure mc_prt-root-to-node-code :
     2298     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2299     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2300     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2301     define buffer buf_gds-prt for ub.gds-prt .
     2302     do
     2303     on error undo, return error
     2304     :
     2305       find buf_gds-prt no-lock
     2306         where buf_gds-prt.upper-code = p-prt-root
     2307         no-error .
     2308       if not available buf_gds-prt then do:
     2309         message
     2310           vss-workfile vss-revision vss-description skip
     2311           "Не найден корень шкалы" skip
     2312           "Указатель на корень шкалы" p-prt-root skip
     2313           view-as alert-box error .
     2314         undo, return error .
     2315       end.
     2316       assign
     2317         p-root-node = buf_gds-prt.node-code
     2318       .
     2319     end.
     2320   end procedure.
     2321   procedure mc_unitbase :
     2322     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2323     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2324     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2325     define buffer buf_goods for ub.goods .
     2326     do
     2327     on error undo, return error
     2328     :
     2329       find first buf_goods no-lock
     2330         where buf_goods.gds-code = p-gds-code
     2331         no-error .
     2332       if not available buf_goods then do:
     2333         message
     2334           vss-workfile vss-revision vss-description skip
     2335           "Не найден товар" skip
     2336           "Код товара" p-gds-code skip
     2337           view-as alert-box error .
     2338         undo, return error .
     2339       end.
     2340       assign
     2341         p-unit-base = buf_goods.unit-base
     2342       .
     2343     end.
     2344   end procedure.
     2345   run write-log-and-file in p-log-handle (
     2346         input 1
     2347       , input log-file-name
     2348       , input 1
     2349       , input substitute("Диапазоны") ).
     2350   on write  of ub.code-range      override do: end .
     2351   on delete of ub.code-range      override do: end .
     2352     do
     2353     on error undo, return error return-value
     2354     :
     2355     for each ub.code-range exclusive-lock :
     2356         if ub.code-range.stts = 'a':U and ub.code-range.db-num <> p-db-num  then ub.code-range.stts = 'u':U .
     2357         if ub.code-range.db-num > 0 then ub.code-range.db-num = 0 .
     2358     end.
     2359   define variable v-b-code as integer   no-undo .
     2360   define variable v-curr-type-cdrg as character no-undo .
     2361   define variable i as integer   no-undo .
     2362   define variable vrv as character no-undo .
     2363     v-curr-type-cdrg =
     2364           'ssgb':U + "," +
     2365           'ctgb':U + "," +
     2366           'dcgb':U + "," +
     2367           'fmgb':U + "," +
     2368           'pngb':U + "," +
     2369           'drgb':U + "," +
     2370           'bcgb':U + "," +
     2371           'scgb':U .
     2372     do i = 1 to num-entries(v-curr-type-cdrg) :
     2373       run get-max-code in this-procedure
     2374         ( input "f-u":U
     2375           ,input 0
     2376           ,input entry (i , v-curr-type-cdrg )
     2377           ,input ?
     2378           ,input ?
     2379           ,input false
     2380           ,output v-b-code
     2381         ) no-error .
     2382         vrv =  return-value .
     2383         if vrv <> "" then do:
     2384         run write-log-and-file in p-log-handle (
     2385               input 1
     2386             , input log-file-name
     2387             , input 1
     2388             , input vrv  ).
     2389        end.
     2390     end.
     2391     end.
