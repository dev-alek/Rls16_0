        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mig_0090.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0090.p $":U .
        7   define variable vss-description as character no-undo init "Модификация тфблиц раздела Диапазоны".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter parparentproc    as widget-handle no-undo .
       63   define input parameter p-parent-handle  as widget-handle no-undo .
       64   define input parameter p-log-handle     as handle no-undo .
       65   define input parameter p-parameter      as character no-undo .
       66   define input parameter p-db-num         as integer   no-undo .
       67   define input parameter p-cli-code       as integer   no-undo .
       68   define input parameter log-file-name   as character  no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define new global shared variable g#library  as handle no-undo .
      300   define new global shared variable g#library2 as handle no-undo .
      301   function diff-list returns character (
      302     input parfirst-list  as character,
      303     input parsecond-list as character,
      304     input pardelim       as character).
      305     if pardelim = ""
      306     or pardelim = ?
      307     then do:
      308       assign
      309         pardelim = ","
      310       .
      311     end.
      312     def var ind as integer no-undo .
      313     def var v-elem as character no-undo .
      314     def var v-result-list as character no-undo init "".
      315     def var v-num-parfirst-list as integer no-undo .
      316     assign
      317       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      318     .
      319     do ind = 1 to v-num-parfirst-list
      320     :
      321       assign
      322         v-elem = entry(ind, parfirst-list, pardelim)
      323       .
      324       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      325         assign
      326           v-result-list = v-result-list
      327                         + (if v-result-list > "" then pardelim else "")
      328                         + v-elem
      329         .
      330       end.
      331     end.
      332     return v-result-list .
      333   end function.
      334   function add-list returns character (
      335    input parfirst-list  as character,
      336    input parsecond-list as character,
      337    input pardelim       as character).
      338     if pardelim = ""
      339     or pardelim = ?
      340     then do:
      341       assign
      342         pardelim = ","
      343       .
      344     end.
      345     def var ind as integer no-undo .
      346     def var v-elem as character no-undo .
      347     def var v-result-list as character no-undo init "".
      348     def var v-num-parfirst-list as integer no-undo .
      349     assign
      350       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      351     .
      352     do ind = 1 to v-num-parfirst-list
      353     :
      354       assign
      355         v-elem = entry(ind, parfirst-list, pardelim)
      356       .
      357       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      358         assign
      359           v-result-list = v-result-list
      360                         + (if v-result-list > "" then pardelim else "")
      361                         + v-elem
      362         .
      363       end.
      364     end.
      365     def var v-num-parsecond-list as integer no-undo .
      366     assign
      367       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      368     .
      369     do ind = 1 to v-num-parsecond-list
      370     :
      371       assign
      372         v-elem = entry(ind, parsecond-list, pardelim)
      373       .
      374       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      375         assign
      376           v-result-list = v-result-list
      377                         + (if v-result-list > "" then pardelim else "")
      378                         + v-elem
      379         .
      380       end.
      381     end.
      382     return v-result-list .
      383   end function.
      384   function cross-list returns character (
      385    input parfirst-list  as character,
      386    input parsecond-list as character,
      387    input pardelim       as character).
      388     if pardelim = ""
      389     or pardelim = ?
      390     then do:
      391       assign
      392         pardelim = ","
      393       .
      394     end.
      395     def var ind as integer no-undo .
      396     def var v-elem as character no-undo .
      397     def var v-result-list as character no-undo init "".
      398     def var v-num-parfirst-list as integer no-undo .
      399     assign
      400       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      401     .
      402     do ind = 1 to v-num-parfirst-list
      403     :
      404       assign
      405         v-elem = entry(ind, parfirst-list, pardelim)
      406       .
      407       if lookup(v-elem, v-result-list, pardelim) = 0
      408       and lookup(v-elem, parsecond-list, pardelim) > 0
      409       then do:
      410         assign
      411           v-result-list = v-result-list
      412                         + (if v-result-list > "" then pardelim else "")
      413                         + v-elem
      414         .
      415       end.
      416     end.
      417     return v-result-list .
      418   end function.
      419   function radio-label returns character (
      420    input par-rs-value  as character,
      421    input par-rs-radio-buttons as character)
      422    .
      423    DEFINE variable v-result-label as character no-undo.
      424    assign
      425    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      426                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      427                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      428                             ), par-rs-radio-buttons
      429                           )
      430    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      431    .
      432   return v-result-label.
      433   end function.
      434   function m-radio-label returns character (
      435    input par-rs-value  as character,
      436    input par-rs-radio-buttons as character,
      437    input par-delim as character
      438    )
      439    .
      440    DEFINE variable v-result-label as character no-undo.
      441    assign
      442    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      443                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      444                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      445                             ), par-rs-radio-buttons, par-delim
      446                           )
      447    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      448    .
      449   return v-result-label.
      450   end function.
      451   FUNCTION mixlist returns character
      452   (
      453    input parfirst-list  as character
      454    ,input parsecond-list as character
      455    ,input pardelim       as character
      456    ,input pardelim-result as character ) :
      457     if pardelim = ""
      458     or pardelim = ?
      459     then do:
      460       assign
      461         pardelim = ","
      462       .
      463     end.
      464     def var ind as integer no-undo .
      465     def var v-elem1 as character no-undo .
      466     def var v-elem2 as character no-undo .
      467     def var v-result-list as character no-undo init "".
      468     do ind = 1 to num-entries(parfirst-list, pardelim)
      469     :
      470       assign
      471         v-elem1 = entry(ind, parfirst-list, pardelim)
      472         v-elem2 = entry(ind, parsecond-list, pardelim)
      473       .
      474         assign
      475           v-result-list = v-result-list
      476                         + (if v-result-list > "" then pardelim-result else "")
      477                         + v-elem1 + pardelim-result + v-elem2
      478         .
      479     end.
      480     return v-result-list .
      481   END FUNCTION.
      482   define stream getmc-stream .
      483   procedure get-max-code :
      484     define input  parameter p-action         as   character                 no-undo .
      485     define input  parameter p-db-num         like ub.db.db-num             no-undo .
      486     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
      487     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
      488     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
      489     define input  parameter p-view-mess      as   logical                   no-undo .
      490     define output parameter v-b-code         as   integer                   no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
      495       define variable l-prod-bc-global as   logical             no-undo .
      496       define variable l-prod-bc-weight as   logical             no-undo .
      497       define variable l-prod-bc-pgweight as   logical             no-undo .
      498       define variable rec-cnt          as   integer             no-undo .
      499       define variable str-u-f          as   character           no-undo .
      500       define variable str-u-f-rng      as   character           no-undo .
      501       define variable ind              as   integer             no-undo .
      502       define variable v-msg              as   character           no-undo initial "":U.
      503       define variable v-ret-msg          as   character           no-undo initial "":U.
      504       define frame get-max-code-inf
      505         rec-cnt label "Просмотрено"
      506         with view-as dialog-box side-labels row 11 centered
      507         title "..........................................." three-d
      508       .
      509       define buffer buf_code-range   for ub.code-range .
      510       define buffer buf-c_code-range for ub.code-range .
      511       define buffer buf_bar-code     for ub.bar-code .
      512       define buffer buf_place        for ub.place .
      513       define buffer buf_goods        for ub.goods .
      514       define buffer buf_units        for ub.units .
      515       define buffer buf_prod-bc      for ub.prod-bc .
      516       define buffer buf_dis-card     for ub.dis-card .
      517       define buffer buf_dis-rule     for ub.dis-rule .
      518       define buffer buf_dis-time-rule     for ub.dis-time-rule .
      519       define buffer buf_firm         for ub.firm .
      520       define buffer buf_person       for ub.person .
      521       define buffer buf_contract     for ub.contract .
      522       if p-curr-type-cdrg = 'sslc':U
      523       or p-curr-type-cdrg = 'ssgb':U
      524       then do:
      525         assign
      526           v-b-code = ?
      527         .
      528         return.
      529       end.
      530       if p-curr-type-cdrg = 'sclc':U
      531       or p-curr-type-cdrg = 'pglc':U
      532         or p-curr-type-cdrg = 'sslc':U
      533       then do:
      534         assign
      535           p-db-num = 0
      536         .
      537       end.
      538       case p-action :
      539         when "get-m-code":U then do:
      540           assign
      541             v-b-code = p-first-code
      542           .
      543         end.
      544         when "f-u":U then do:
      545           assign
      546             v-b-code = 0
      547           .
      548         end.
      549       end case.
      550       case p-curr-type-cdrg :
      551         when 'dcgb':U then do:
      552   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   define variable v-ii2 as integer   no-undo .
      554   define variable v-table-name2 as character no-undo .
      555   define variable v-field-name2 as character no-undo .
      556   define variable buf_h2 as handle no-undo .
      557   define variable q_h2 as handle no-undo .
      558   define variable v-avail2 as integer   no-undo .
      559   define variable v-code-mess2 as character no-undo .
      560   define variable glog2 as logical   no-undo .
      561   define variable v-code_2 as integer   no-undo .
      562   case p-action :
      563     when "get-m-code":U then do:
      564       do v-ii2 = 1 to num-entries('ub.dis-card'):
      565         assign
      566         v-table-name2 = entry(v-ii2, 'ub.dis-card')
      567         v-field-name2 = entry(v-ii2, 'card-num')
      568         .
      569         create buffer buf_h2 for table v-table-name2.
      570         create query q_h2.
      571         q_h2:SET-BUFFERS(buf_h2).
      572         q_h2:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      573                           ,v-table-name2
      574                           ,v-field-name2
      575                           ,p-first-code
      576                           ,p-last-code)
      577                           ).
      578         q_h2:QUERY-OPEN.
