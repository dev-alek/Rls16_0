      399   procedure thth150-db-attr-code :
      400     do
      401     on error undo, return error
      402     :
      403       define input  parameter p-code           as character no-undo .
      404       define output parameter p-type           as character no-undo .
      405       define output parameter p-format         as character no-undo .
      406       define output parameter p-label          as character no-undo .
      407       define output parameter p-user-can-edit  as logical   no-undo .
      408       define output parameter p-output-display as logical   no-undo .
      409       define output parameter p-other          as character no-undo .
      410       case p-code :
      411               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      412               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      413               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      414               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      415               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      416               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      417               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      418               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      419               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      420               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      421         otherwise do:
      422           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      423         end.
      424       end.
      425     end.
      426   end procedure.
      427   procedure thth150-db-attr-tooltip :
      428     do
      429     on error undo, return error
      430     :
      431       define input  parameter p-code    as character no-undo .
      432       define output parameter p-tooltip as character no-undo .
      433       define output parameter p-label   as character no-undo .
      434       case p-code :
      435               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      436               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      437               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      438               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      439               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      440               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      441               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      442               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      443               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      444               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      445         otherwise do:
      446           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      447         end.
      448       end.
      449     end.
      450   end procedure.
      451   procedure thth150-db-attr-value :
      452     do
      453     on error undo, return error
      454     :
      455       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      456       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      457       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      458       define output parameter p-type      as character no-undo .
      459       define buffer buf_db-attr for ub.db-attr .
      460       define variable v-format         as character no-undo .
      461       define variable v-label          as character no-undo .
      462       define variable v-user-can-edit  as logical   no-undo .
      463       define variable v-output-display as logical   no-undo .
      464       define variable v-other          as character no-undo .
      465       run thth150-db-attr-code in this-procedure
      466         (input  p-code
      467         ,output p-type
      468         ,output v-format
      469         ,output v-label
      470         ,output v-user-can-edit
      471         ,output v-output-display
      472         ,output v-other
      473         ) no-error .
      474       if error-status :error then do:
      475         undo, return error return-value .
      476       end.
      477       find first buf_db-attr no-lock
      478         where buf_db-attr.db-num    = p-db-num
      479           and buf_db-attr.attr-code = p-code
      480         no-error .
      481       if avail buf_db-attr then do:
      482         assign
      483           p-value =  buf_db-attr.attr-value
      484         .
      485       end.
      486       else do:
      487         assign
      488           p-value = if p-type = 'L':U then "no":U else ""
      489         .
      490       end.
      491     end.
      492   end procedure.
      493   procedure thth150-db-attr-write :
      494     do
      495     on error undo, return error
      496     :
      497       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      498       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      499       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      500       define buffer buf_db-attr for ub.db-attr .
      501       define variable v-type           as character no-undo .
      502       define variable v-format         as character no-undo .
      503       define variable v-label          as character no-undo .
      504       define variable v-user-can-edit  as logical   no-undo .
      505       define variable v-output-display as logical   no-undo .
      506       define variable v-other          as character no-undo .
      507       run thth150-db-attr-code in this-procedure
      508         (input  p-code
      509         ,output v-type
      510         ,output v-format
      511         ,output v-label
      512         ,output v-user-can-edit
      513         ,output v-output-display
      514         ,output v-other
      515         ) no-error .
      516       if error-status :error then do:
      517         undo, return error return-value .
      518       end.
      519       find first buf_db-attr exclusive-lock
      520         where buf_db-attr.db-num    = p-db-num
      521           and buf_db-attr.attr-code = p-code
      522         no-error .
      523       if not available buf_db-attr then do:
      524         create buf_db-attr .
      525         assign
      526           buf_db-attr.db-num    = p-db-num
      527           buf_db-attr.attr-code = p-code
      528         .
      529       end.
      530       assign
      531         buf_db-attr.attr-value = p-value
      532       .
      533     end.
      534   end procedure.
      535   procedure thth150-db-attr-exist :
      536     do
      537     on error undo, return error
      538     :
      539       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      540       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      541       define output parameter p-exist    as logical  no-undo .
      542       define buffer buf_db-attr for ub.db-attr .
      543       define variable v-type           as character no-undo .
      544       define variable v-format         as character no-undo .
      545       define variable v-label          as character no-undo .
      546       define variable v-user-can-edit  as logical   no-undo .
      547       define variable v-output-display as logical   no-undo .
      548       define variable v-other          as character no-undo .
      549       run thth150-db-attr-code in this-procedure
      550         (input  p-code
      551         ,output v-type
      552         ,output v-format
      553         ,output v-label
      554         ,output v-user-can-edit
      555         ,output v-output-display
      556         ,output v-other
      557         ) no-error .
      558       if error-status :error then do:
      559         undo, return error return-value .
      560       end.
      561       find first buf_db-attr no-lock
      562         where buf_db-attr.db-num    = p-db-num
      563           and buf_db-attr.attr-code = p-code
      564         no-error .
      565       if  available buf_db-attr then do:
      566         p-exist = yes.
      567       end.
      568     end.
      569   end procedure.
      570   procedure thth150-db-attr-delete :
      571     do
      572     on error undo, return error
      573     :
      574       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      575       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      576       define output parameter p-deleted  as logical no-undo.
      577       define buffer buf_db-attr for ub.db-attr .
      578       define variable v-type           as character no-undo .
      579       define variable v-format         as character no-undo .
      580       define variable v-label          as character no-undo .
      581       define variable v-user-can-edit  as logical   no-undo .
      582       define variable v-output-display as logical   no-undo .
      583       define variable v-other          as character no-undo .
      584       run thth150-db-attr-code in this-procedure
      585         (input  p-code
      586         ,output v-type
      587         ,output v-format
      588         ,output v-label
      589         ,output v-user-can-edit
      590         ,output v-output-display
      591         ,output v-other
      592         ) no-error .
      593       if error-status :error then do:
      594         undo, return error return-value .
      595       end.
      596       find first buf_db-attr exclusive-lock
      597         where buf_db-attr.db-num    = p-db-num
      598           and buf_db-attr.attr-code = p-code
      599         no-error NO-WAIT.
      600       if not available buf_db-attr then do:
      601         p-deleted = no.
      602       end.
      603       else do:
      604         delete buf_db-attr.
      605         p-deleted = yes.
      606       end.
      607     end.
      608   end procedure.
      609   procedure thth150-db-attr-news :
      610     do
      611     on error undo, return error
      612     :
      613       define input  parameter p-code           as character no-undo .
      614       define output parameter p-news           as logical   no-undo .
      615       case p-code :
      616               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
      617               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
      618               when 'thth150-clients':U then do:     assign     p-news = no.   end.
      619               when 'thth150-goods':U then do:     assign     p-news = no.   end.
      620               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
      621               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
      622               when 'thth150-shop':U then do:     assign     p-news = no.   end.
      623               when 'thth150-contract':U then do:     assign     p-news = no.   end.
      624               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
      625               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
      626         otherwise do:
      627           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      628         end.
      629       end.
      630     end.
      631   end procedure.
      632   define temp-table temp_parts no-undo like ub.parts
      633     field cli-qnty1     as decimal
      634     field fact-qnty1    as decimal
      635     field qnty1         as decimal
      636     field new-cli-type  as character
      637     field new-cli-code  as integer
