      289   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   procedure doc-code:
      291   define input  parameter parmode          as   character           no-undo.
      292   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      293   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      294   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      295   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      296   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      297   define variable vardb-remote     as   logical             no-undo.
      298   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      299   define variable v-delimiter as character no-undo .
      300   do
      301   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      302   :
      303   find first buf_sys-ctrl no-lock .
      304   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      305     CASE parmode:
      306       when "main":u then do:
      307         if vardb-remote then do:
      308           assign
      309             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      310         end.
      311         else do:
      312           assign
      313             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      314         end.
      315       end.
      316       when "trio" then do:
      317         assign
      318           pardoc-code = replace (parroot-doc-code, "=", "*").
      319       end.
      320       otherwise do:
      321         assign
      322         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      323         no-error
      324         .
      325         if error-status:error  then do:
      326           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      327                                         ,chr(10)
      328                                         ,parmode
      329                                         ).
      330         end.
      331         if num-entries(parmode) = 1
      332         and parmode <> "chip":U
      333         and parmode <> "chip_s":U
      334         then do:
      335           assign
      336           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      337         end.
      338         else if (lookup("chip":U, parmode) > 0
      339                  or
      340                  lookup("chip_s":U, parmode) > 0) then do:
      341           assign
      342             vartemp-doc-code = parroot-doc-code.
      343           do while true:
      344             if index (vartemp-doc-code , ".") = 0 then
      345               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      346             else
      347               vartemp-doc-code  =
      348               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      349               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      350               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      351             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      352           end.
      353           assign
      354             pardoc-code = vartemp-doc-code.
      355         end.
      356       end.
      357     end CASE.
      358     if pardoc-code = '':U
      359     or (parroot-doc-code <> '':U
      360     and pardoc-code = parroot-doc-code) then do:
      361       undo, return error substitute("Ошибка при генерации номера документа&1"
      362                                     ,chr(10)).
      363     end.
      364   end.
      365   end. // procedure/method
      366   function get-doc-code-int64 returns int64
      367     ( input p-doc-code as character ) :
      368     define variable v-ind              as integer   no-undo .
      369     define variable v-num-entries      as integer   no-undo .
      370     define variable v-doc-code-int64   as int64     no-undo .
      371     define variable v-canonic-doc-code as character no-undo .
      372     assign
      373       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      374       v-canonic-doc-code = p-doc-code
      375     .
      376     do v-ind = 1 to v-num-entries
      377     :
      378       assign
      379         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      380       .
      381     end.
      382     assign
      383       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      384     .
      385     return v-doc-code-int64 .
      386   end. // function/method
      387   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
