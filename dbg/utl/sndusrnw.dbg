      405           ) no-error .
      406         if error-status:error then do:
      407           undo,  return error return-value .
      408         end.
      409       end.
      410       for each buf_user-login exclusive-lock
      411         where buf_user-login.db-num = v-cntxt-db-num
      412       on error undo, return error return-value
