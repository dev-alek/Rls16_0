      361       view-as alert-box question buttons yes-no update v-ok .
      362     if v-ok <> true
      363     then do:
      364       return .
      365     end.
      366     if v-cntxt-db-num = 0
      367     then do:
      368       for each buf_user-account exclusive-lock
      369       on error undo, return error return-value
      370       :
      371         assign
      372           v-ind = v-ind + 1
      373         .
      374         if v-ind modulo 10 = 0
      375         then do:
      376           run waitfram-show in this-procedure
      377             (input substitute("Отправлено записей &1", v-ind)
      378             ) .
      379         end.
      380         run str/callnews.p
      381           (input 'user-account':U
      382           ,input (buffer buf_user-account :handle)
      383           ) no-error .
      384         if error-status:error then do:
      385           undo,  return error return-value .
      386         end.
      387       end.
      388     end.
      389     else do:
      390       for each buf_user-account exclusive-lock
      391       on error undo, return error return-value
      392       :
      393         assign
      394           v-ind = v-ind + 1
      395         .
      396         if v-ind modulo 10 = 0
      397         then do:
      398           run waitfram-show in this-procedure
      399             (input substitute("Отправлено записей &1", v-ind)
      400             ) .
      401         end.
      402         run str/callnews.p
      403           (input 'user-account':U
