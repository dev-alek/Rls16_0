      342   define buffer buf_user-login-action-item for ub.user-login-action-item .
      343   define buffer buf_action-post-menu-group for ub.action-post-menu-group .
      344   do
      345   on error undo, return error return-value
      346   :
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348     run mainmenu_getcntxt in parparentproc
