     4142      return ?.
     4143   end.
     4144   function GetLastUTDinPack returns logical
     4145   (input idb-num as integer,
     4146    input idoc-id as integer,
     4147    output odb-num as integer,
     4148    output odoc-id as integer ):
     4149      define buffer buf_utd for utd.
     4150      define buffer     utd for utd.
     4151      find first utd where utd.db-num eq idb-num
     4152                       and utd.doc-id eq idoc-id
     4153      no-lock no-error.
     4154      if available utd
     4155      then do:
     4156         if utd.PackageId eq ""
     4157         then do:
     4158            assign
     4159               odb-num = utd.db-num
     4160               odoc-id = utd.doc-id
     4161            .
     4162            return yes.
     4163         end.
     4164         else do:
     4165            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4166            if    odb-num eq ?
     4167               or odoc-id eq ?
     4168            then do:
     4169               assign
     4170                  odb-num = utd.db-num
     4171                  odoc-id = utd.doc-id
     4172               .
     4173               return yes.
     4174            end.
     4175            else
     4176               return odoc-id = utd.doc-id.
     4177         end.
     4178      end.
     4179      return ?.
     4180   end.
     4181   function delMark returns logical
     4182   ( buffer utd-marking-lines for utd-marking-lines ):
     4183      define buffer buf_utd-marking-line for utd-marking-lines.
     4184      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4185         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4186                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4187                                           and buf_utd-marking-line.mark      eq marking.mark
     4188         no-lock no-error.
     4189         if available  buf_utd-marking-line
     4190         then do:
     4191            delMark(buffer buf_utd-marking-line).
     4192            delete buf_utd-marking-line.
     4193         end.
     4194      end.
     4195   end.
     4196   function addMark returns logical
     4197   ( buffer utd-marking-lines for utd-marking-lines ):
     4198      define buffer buf_utd-marking-line for utd-marking-lines.
     4199      define buffer par_utd-marking-line for utd-marking-lines.
     4200      define buffer buf_utd for ub.utd .
     4201      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4202         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4203                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4204                                           and buf_utd-marking-line.mark      eq marking.mark
     4205         no-lock no-error.
     4206         if available  buf_utd-marking-line
     4207         then do:
     4208            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4209            then do:
     4210               find current  buf_utd-marking-line exclusive-lock no-error.
     4211               if available buf_utd-marking-line
     4212               then
     4213                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4214            end.
     4215         end.
     4216         else do:
     4217            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4218                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4219                                         no-error .
     4220            create buf_utd-marking-line.
     4221            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4222            assign
     4223               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4224               buf_utd-marking-line.mark      = marking.mark
     4225               buf_utd-marking-line.gds-code  = marking.Gds-code
     4226               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4227                                               then marking.sts
     4228                                               else
     4229                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4230                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4231                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4232                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4233                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4234                                                else marking.sts
     4235            .
     4236            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4237            do:
     4238              for first par_utd-marking-line no-lock where
     4239                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4240                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4241                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4242                    and par_utd-marking-line.mark    = marking.mark-parent
     4243                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4244              :
     4245                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4246              end.
     4247            end.
     4248         end.
     4249         addMark(buffer buf_utd-marking-line).
     4250      end.
     4251   end.
     4252   function UnLockUTDMarkbuf returns logical
     4253   (buffer old_utd for utd,
     4254    iAll as logical ):
     4255      define variable voldkey    as character no-undo.
     4256         run gen-key-rec (input "utd",
     4257                          input  buffer old_utd:handle,
     4258                          output voldkey).
     4259      for each marking where marking.loc-key eq voldkey
     4260      exclusive-lock:
     4261         if    iAll
     4262            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4263                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4264         then do:
     4265            marking.loc-key = "".
     4266            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4267         end.
     4268      end.
     4269   end.
     4270   function UnLockUTDMark returns logical
     4271   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4272      define buffer old_utd for utd.
     4273      find first old_utd where old_utd.db-num eq idb-num
     4274                           and old_utd.db-num eq idoc-id
     4275      no-lock no-error.
     4276      if available old_utd
     4277      then do:
     4278         UnLockUTDMarkbuf(buffer old_utd,iall).
     4279      end.
     4280   end.
     4281   function changSts returns logical
     4282   (idb-num as integer ,
     4283    idoc-id as integer ,
     4284    old_sts_edo as character ,
     4285    new_sts_edo as character  ):
     4286      if     old_sts_edo ne new_sts_edo
     4287         and ( new_sts_edo eq "RevocationAccepted"
     4288              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4289              )
     4290      then
     4291         UnLockUTDMark(idb-num,idoc-id,yes).
     4292      if     old_sts_edo ne new_sts_edo
     4293         and ( new_sts_edo eq "WithRecipientSignature"
     4294           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4295              )
     4296      then
     4297         UnLockUTDMark(idb-num,idoc-id,no).
     4298   end.
     4299   function SetLockUTDMark returns logical
     4300   (idb-num as integer ,idoc-id as integer ):
     4301      define buffer new_utd for utd.
     4302      define buffer old_utd for utd.
     4303      define variable volddb-num as integer no-undo.
     4304      define variable volddoc-id as integer no-undo.
     4305      define variable voldkey    as character no-undo.
     4306      define variable vnewkey    as character no-undo.
     4307      find first new_utd where new_utd.db-num eq idb-num
     4308                           and new_utd.doc-id eq idoc-id
     4309      no-lock no-error.
     4310      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4311      then do trans:
     4312         find first old_utd where old_utd.db-num eq volddb-num
     4313                              and old_utd.doc-id eq volddoc-id
     4314         no-lock no-error.
     4315            run gen-key-rec (input "utd",
     4316                             input  buffer new_utd:handle,
     4317                             output vnewkey).
     4318            run gen-key-rec (input "utd",
     4319                             input  buffer old_utd:handle,
     4320                             output voldkey).
     4321         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4322                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4323         no-lock:
     4324            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4325            if available  marking
     4326            then do:
     4327               if    marking.loc-key eq ""
     4328                  or marking.loc-key eq ?
     4329                  or marking.loc-key eq voldkey
     4330               then do:
     4331                  find current marking exclusive-lock no-error.
     4332                  if available marking
     4333                  then do:
     4334                     marking.loc-key = vnewkey.
     4335                     release marking.
     4336                  end.
     4337               end.
     4338               else if marking.loc-key ne vnewkey
     4339               then do:
     4340                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4341               end.
     4342            end.
     4343         end.
     4344         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4345      end.
     4346   end.
     4347   function CheckedocMark return logical
     4348   (input idb-numorig as integer,
     4349    input idoc-idorig as integer,
     4350    input idb-numedoc as integer,
     4351    input idoc-idedoc as integer  ):
     4352       define variable VChekOk    as logical   no-undo init yes.
     4353       define variable vMarkUtd   as logical   no-undo.
     4354       define variable v-par-type as character no-undo.
     4355       define variable v-par-val  as character no-undo.
     4356       define buffer buf_utd-attr      for utd-attr.
     4357       define buffer buf_utd           for utd.
     4358       define buffer utd-marking-lines for utd-marking-lines.
     4359       define buffer utd-lines         for utd-lines.
     4360       define buffer marking           for marking.
     4361       define buffer edoc-lines        for utd-lines.
     4362          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     4363                                       and utd-marking-lines.doc-id    eq idoc-idorig
     4364                                       and utd-marking-lines.doc-level eq 1
     4365                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     4366          no-lock:
     4367             if    isMark (utd-marking-lines.mark)
     4368             then do:
     4369                create tt-utd-mark.
     4370                buffer-copy utd-marking-lines to tt-utd-mark
     4371                assign
     4372                   tt-utd-mark.side = "+"
     4373                .
     4374             end.
     4375          end.
     4376          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     4377                                       and utd-marking-lines.doc-id eq idoc-idedoc
     4378                                       and utd-marking-lines.doc-level eq 1
     4379          no-lock:
     4380             if    isMark (utd-marking-lines.mark)
     4381             then do:
     4382                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4383                no-lock no-error.
     4384                if available tt-utd-mark
     4385                then
     4386                   tt-utd-mark.side = "".
     4387                else do:
     4388                   create tt-utd-mark.
     4389                   buffer-copy utd-marking-lines to tt-utd-mark
     4390                   assign
     4391                      tt-utd-mark.side = "-"
     4392                   .
     4393                end.
     4394             end.
     4395          end.
     4396          for each tt-utd-mark where  tt-utd-mark.side ne ""
     4397          no-lock:
     4398             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     4399             VChekOk = no.
     4400          end.
     4401          for each utd-lines where utd-lines.db-num    eq idb-numorig
     4402                               and utd-lines.doc-id    eq idoc-idorig
     4403          no-lock:
     4404             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     4405                                     and edoc-lines.doc-id eq idoc-idedoc
     4406                                     and edoc-lines.LineNum eq utd-lines.LineNum
     4407             no-lock no-error.
     4408             define variable VUtdlinequentity as decimal no-undo.
     4409             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     4410             if     VUtdlinequentity eq ?
     4411                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     4412             then
     4413                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     4414          end.
     4415       for each tt-utd-mark:
     4416          delete tt-utd-mark.
     4417       end.
     4418   end.
     4419   function CheckEdoc returns character
     4420   (idb-numOrig as integer ,
     4421    idoc-idOrig as integer,
     4422    idb-num as integer ,
     4423    idoc-id as integer ):
     4424      define buffer utd  for ub.utd.
     4425      define buffer utd-lines  for ub.utd-lines.
     4426      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4427      define buffer edoc-lines for ub.utd-lines.
     4428      define variable vSts as integer no-undo.
     4429      define variable vMarkutd as logical no-undo.
     4430      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4431      Block-line:
     4432      for each utd-lines where utd-lines.db-num eq idb-num
     4433                           and utd-lines.doc-id eq idoc-id
     4434      exclusive-lock:
     4435         define variable ismarkin as logical no-undo.
     4436         define variable isOAD as logical no-undo.
     4437         define variable isper as logical no-undo.
     4438         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     4439              output ismarkin, output isOAD, output isper).
     4440         if    utd-lines.Price                eq 0
     4441            or utd-lines.Total                eq 0
     4442            or utd-lines.TotalWithVatExcluded eq 0
     4443            or utd-lines.Quantity             eq 0
     4444         then do:
     4445            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4446                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4447                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4448            no-lock:
     4449               if    isMark(utd-marking-lines.mark)
     4450                  or isOad(utd-marking-lines.mark)
     4451               then do:
     4452                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     4453                  next Block-line.
     4454               end.
     4455            end.
     4456            delete utd-lines.
     4457         end.
     4458         else if   ( utd-lines.Total                ne 0
     4459                 or utd-lines.Quantity             ne 0)
     4460                 and ismarkin or isOAD
     4461         then do:
     4462            Block-mark:
     4463            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4464                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4465                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4466            no-lock:
     4467               if  (isOAD and
     4468                     isMark(utd-marking-lines.mark)
     4469                  or isOad(utd-marking-lines.mark) )
     4470                  or (ismarkin and
     4471                     isMark(utd-marking-lines.mark))
     4472               then do:
     4473                  leave Block-mark.
     4474               end.
     4475            end.
     4476            if not available utd-marking-lines
     4477            then
     4478               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     4479         end.
     4480      end.
     4481      for each utd-lines where utd-lines.db-num eq idb-numOrig
     4482                           and utd-lines.doc-id eq idoc-idOrig
     4483      no-lock:
     4484         find first edoc-lines where edoc-lines.db-num eq idb-num
     4485                                 and edoc-lines.doc-id eq idoc-id
     4486                                 and edoc-lines.LineNum eq utd-lines.LineNum
     4487         no-lock no-error.
     4488         if     available edoc-lines
     4489         then do:
     4490            if edoc-lines.Quantity ne 0
     4491            then do:
     4492               if edoc-lines.Price ne utd-lines.Price
     4493               then
     4494                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     4495            end.
     4496         end.
     4497         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4498         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     4499      end.
     4500      define variable vError as character no-undo.
     4501      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     4502      if vError ne ""
     4503      then
     4504         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     4505      else
     4506         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4507      find first utd where utd.db-num eq idb-num
     4508                       and utd.doc-id eq idoc-id
     4509      exclusive-lock no-error.
     4510      if available utd
     4511      then do:
     4512         utd.sts = vsts.
     4513      end.
     4514   end.
     4515   function CrEdoc returns character
     4516   (iPack as character ,
     4517    iTimestamp as datetime):
     4518      define variable vdb-num as integer no-undo.
     4519      define variable vdoc-id as integer no-undo.
     4520      define buffer utd  for ub.utd.
     4521      define buffer edoc for ub.utd.
     4522      define buffer utd_ret   for ub.utd.
     4523      define buffer utd-attr  for ub.utd-attr.
     4524      define buffer edoc-attr for ub.utd-attr.
     4525      define buffer utd-lines  for ub.utd-lines.
     4526      define buffer edoc-lines for ub.utd-lines.
     4527      define buffer utd-lines-attr  for ub.utd-lines-attr.
     4528      define buffer edoc-lines-attr for ub.utd-lines-attr.
     4529      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4530      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4531      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     4532      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     4533      define variable vTimestamp  as datetime no-undo.
     4534      find last utd where utd.PackageId eq iPack
     4535                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4536                      and utd.Timestamp ge iTimestamp
     4537      no-lock no-error.
     4538      if available utd
     4539      then
     4540         return "Есть документ позже".
     4541      find last utd where utd.PackageId eq iPack
     4542                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4543                      and utd.Timestamp le iTimestamp
     4544      no-lock no-error.
     4545      if not available utd
     4546      then
     4547         return "Не найден УКД".
     4548      define variable vdb-numOrig as integer no-undo.
     4549      define variable vdoc-idOrig as integer no-undo.
     4550      find last utd where utd.PackageId eq iPack
     4551                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4552                      and utd.Timestamp le iTimestamp
     4553      no-lock no-error.
     4554      if available utd
     4555      then do:
     4556         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4557         MySeqUtd = ?.
     4558         vTimestamp = utd.Timestamp.
     4559         create edoc.
     4560         vdb-num = utd.db-num.
     4561         vdoc-id = utd.doc-id.
     4562         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     4563         assign
     4564            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4565            edoc.Timestamp = iTimestamp + 1
     4566            edoc.AmendmentRequested = no
     4567            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     4568         .
     4569         validate edoc.
     4570         for each utd-attr where utd-attr.db-num eq vdb-num
     4571                             and utd-attr.doc-id eq vdoc-id
     4572                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     4573                             and utd-attr.attr-code ne "sendcode"
     4574         no-lock:
     4575            create edoc-attr.
     4576            buffer-copy utd-attr except doc-id db-num to edoc-attr
     4577            assign
     4578               edoc-attr.db-num = edoc.db-num
     4579               edoc-attr.doc-id = edoc.doc-id
     4580            .
     4581         end.
     4582         for each utd-lines where utd-lines.db-num eq vdb-num
     4583                              and utd-lines.doc-id eq vdoc-id
     4584         no-lock:
     4585            create edoc-lines.
     4586            buffer-copy utd-lines except doc-id db-num to edoc-lines
     4587            assign
     4588               edoc-lines.db-num = edoc.db-num
     4589               edoc-lines.doc-id = edoc.doc-id
     4590            .
     4591            release edoc-lines.
     4592         end.
     4593         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     4594                                   and utd-lines-attr.doc-id eq vdoc-id
     4595         no-lock:
     4596            create edoc-lines-attr.
     4597            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     4598            assign
     4599               edoc-lines-attr.db-num = edoc.db-num
     4600               edoc-lines-attr.doc-id = edoc.doc-id
     4601            .
     4602         end.
     4603         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     4604                                      and utd-marking-lines.doc-id eq vdoc-id
     4605                                      and utd-marking-lines.doc-level eq 1
     4606         no-lock:
     4607            create edoc-marking-lines.
     4608            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4609            assign
     4610               edoc-marking-lines.db-num = edoc.db-num
     4611               edoc-marking-lines.doc-id = edoc.doc-id
     4612            .
     4613         end.
     4614         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     4615                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     4616         no-lock:
     4617            if utd-marking-lines-attr.attr-code eq "box-qnty"
     4618            then do:
     4619                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     4620                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     4621                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     4622                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     4623                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     4624                no-lock no-error.
     4625            end.
     4626            if not avail edoc-marking-lines-attr
     4627            then do:
     4628                create edoc-marking-lines-attr.
     4629                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     4630                assign
     4631                   edoc-marking-lines-attr.db-num = vdb-num
     4632                   edoc-marking-lines-attr.doc-id = vdoc-id
     4633                .
     4634            end.
     4635            release edoc-marking-lines-attr.
     4636         end.
     4637         for each utd where utd.PackageId eq iPack
     4638                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4639                        and utd.Timestamp gt vTimestamp
     4640                        and utd.Timestamp le iTimestamp
     4641                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     4642                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     4643                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     4644                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     4645                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     4646                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     4647         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     4648            edoc.Total = edoc.Total + utd.total.
     4649            edoc.Vat = edoc.Vat + utd.Vat.
     4650            edoc.DocumentDate = utd.DocumentDate.
     4651            edoc.Timestamp = utd.Timestamp + 1.
     4652            for each utd-lines where utd-lines.db-num     = utd.db-num
     4653                                 and utd-lines.doc-id     = utd.doc-id
     4654            no-lock:
     4655               block-mark:
     4656               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4657                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4658                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4659                                            and utd-marking-lines.site eq "-"
     4660                                            no-lock:
     4661                  if isOAD(utd-marking-lines.mark)
     4662                  then do:
     4663                     define variable VOAD as character no-undo.
     4664                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4665                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4666                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     4667                                                  and edoc-marking-lines.mark   begins VOAD
     4668                     no-lock no-error.
     4669                  end.
     4670                  else
     4671                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4672                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4673                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4674                        no-lock no-error.
     4675                  if available edoc-marking-lines
     4676                  then do:
     4677                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4678                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4679                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4680                     exclusive-lock no-error.
     4681                     leave block-mark.
     4682                  end.
     4683               end.
     4684               if not available edoc-lines
     4685               then
     4686                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     4687                                          and edoc-lines.doc-id      = edoc.doc-id
     4688                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     4689                  exclusive-lock no-error.
     4690               if not available edoc-lines
     4691               then do:
     4692                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     4693                                         and edoc-lines.doc-id      = edoc.doc-id
     4694                  no-lock no-error.
     4695                  define variable vline as integer no-undo.
     4696                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     4697                  create edoc-lines.
     4698                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     4699                  assign
     4700                     edoc-lines.db-num = edoc.db-num
     4701                     edoc-lines.doc-id = edoc.doc-id
     4702                     edoc-lines.linenum = vline
     4703                  .
     4704               end.
     4705               else
     4706                  assign
     4707                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     4708                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     4709                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     4710                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     4711                  .
     4712               define variable Vqnty as decimal no-undo.
     4713               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     4714                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     4715               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     4716               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4717                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4718               then
     4719                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4720                      "loadUtd",
     4721                      "UcdUnitChangForUtd",
     4722                      string(edoc-lines.LineNum )                  + chr(4) +
     4723                      edoc-lines.UnitCode                   + chr(4) +
     4724                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4725               if     utd-lines.UnitCode ne ?
     4726                  and utd-lines.UnitCode ne ""
     4727                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4728               then
     4729                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4730                         "loadUtd",
     4731                         "UcdUnitChang",
     4732                         string(edoc-lines.LineNum )                  + chr(4) +
     4733                         utd-lines.UnitCode                          + chr(4) +
     4734                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4735               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4736                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4737                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4738               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     4739                  if utd-marking-lines.site eq "-"
     4740                  then do:
     4741                     if isOAD(utd-marking-lines.mark)
     4742                     then do:
     4743                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4744                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4745                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4746                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4747                        exclusive-lock no-error.
     4748                        if not available edoc-marking-lines
     4749                        then
     4750                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4751                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     4752                                                        and edoc-marking-lines.mark   begins VOAD
     4753                           exclusive-lock no-error.
     4754                        if not available edoc-marking-lines
     4755                        then
     4756                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4757                        else do:
     4758                           define variable v37tegdoc as character no-undo.
     4759                           define variable v37tegedoc as character no-undo.
     4760                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4761                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4762                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     4763                           if error-status:error
     4764                           then
     4765                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4766                              view-as alert-box.
     4767                           else if vqnty = 0
     4768                           then
     4769                              delete edoc-marking-lines.
     4770                           else do:
     4771                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4772                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4773                                             edoc-marking-lines.doc-id,
     4774                                             edoc-marking-lines.LineNum,
     4775                                             edoc-marking-lines.mark,
     4776                                             "box-qnty",
     4777                                              string(vQnty)).
     4778                           end.
     4779                        end.
     4780                     end.
     4781                     else do:
     4782                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4783                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4784                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4785                        exclusive-lock no-error.
     4786                        if available edoc-marking-lines
     4787                        then
     4788                           delete edoc-marking-lines.
     4789                        else
     4790                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4791                     end.
     4792                  end.
     4793                  else if utd-marking-lines.site eq "+"
     4794                  then do:
     4795                     if isOAD(utd-marking-lines.mark)
     4796                     then do:
     4797                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4798                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4799                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4800                                                     and edoc-marking-lines.mark   begins VOAD
     4801                        exclusive-lock no-error.
     4802                        if available edoc-marking-lines
     4803                        then do:
     4804                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4805                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4806                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     4807                           if error-status:error
     4808                           then
     4809                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4810                              view-as alert-box.
     4811                           else if vqnty = 0
     4812                           then
     4813                              delete edoc-marking-lines.
     4814                           else do:
     4815                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4816                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4817                                             edoc-marking-lines.doc-id,
     4818                                             edoc-marking-lines.LineNum,
     4819                                             edoc-marking-lines.mark,
     4820                                             "box-qnty",
     4821                                              string(vQnty)).
     4822                           end.
     4823                        end.
     4824                        else do:
     4825                           create edoc-marking-lines.
     4826                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4827                           assign
     4828                              edoc-marking-lines.db-num = edoc.db-num
     4829                              edoc-marking-lines.doc-id = edoc.doc-id
     4830                           .
     4831                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4832                                             edoc-marking-lines.doc-id,
     4833                                             edoc-marking-lines.LineNum,
     4834                                             edoc-marking-lines.mark,
     4835                                             "box-qnty",
     4836                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     4837                        end.
     4838                     end.
     4839                     else do:
     4840                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4841                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4842                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4843                     no-lock no-error.
     4844                     if not available edoc-marking-lines
     4845                     then do:
     4846                        create edoc-marking-lines.
     4847                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     4848                        assign
     4849                           edoc-marking-lines.db-num  = edoc-lines.db-num
     4850                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     4851                           edoc-marking-lines.linenum = edoc-lines.linenum
     4852                        .
     4853                     end.
     4854                     else
     4855                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4856                  end.
     4857               end.
     4858               release edoc-lines.
     4859            end.
     4860            release edoc-lines.
     4861         end.
     4862         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4863                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4864                                 and utd_ret.Timestamp             le utd.Timestamp
     4865                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4866            no-lock no-error.
     4867         if not avail utd_ret
     4868         then
     4869            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     4870      end.
     4871      for each utd where utd.PackageId eq iPack
     4872                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4873                        and utd.Timestamp < iTimestamp
     4874         exclusive-lock:
     4875            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     4876            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     4877         end.
     4878         unsubscribe "getNextseq".
     4879      end.
     4880   end.
     4881   define variable Mext-sys as integer no-undo init ?.
     4882   define variable mdb-num-local as integer no-undo.
     4883   run gbl/getdbnum.p (output mdb-num-local).
     4884   function  getExtSys returns integer
     4885   ():
     4886      define buffer ext-system      for ext-system.
     4887      define buffer ext-system-attr for ext-system-attr.
     4888      Mext-sys = ?.
     4889      block-sys-obj:
     4890      for each ext-system where ext-system.esys-type eq 12
     4891                            and ext-system.db-num    eq mdb-num-local
     4892      no-lock:
     4893          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     4894                                       and ext-system-attr.esys-id eq ext-system.esys-id
     4895                                       and ext-system-attr.esya-attr-code eq 'obj':U
     4896          no-lock no-error.
     4897          if     available ext-system-attr
     4898             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     4899          then do:
     4900             Mext-sys = ext-system-attr.esys-id.
     4901             leave block-sys-obj.
     4902          end.
     4903      end.
     4904      if Mext-sys eq ?
     4905      then do:
     4906         block-sys-host:
     4907         for each ext-system where ext-system.esys-type eq 12
     4908                               and ext-system.db-num    eq mdb-num-local
     4909         no-lock:
     4910             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     4911                                          and ext-system-attr.esys-id eq ext-system.esys-id
     4912                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     4913             no-lock no-error.
     4914             if     available ext-system-attr
     4915                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     4916             then do:
     4917                Mext-sys = ext-system-attr.esys-id.
     4918                leave block-sys-host.
     4919             end.
     4920         end.
     4921      end.
     4922      return Mext-sys.
     4923   end.
     4924   function  getExtAttr returns character
     4925   (input icode as character ):
     4926      define variable oValue as character no-undo.
     4927      define variable vtype as character no-undo.
     4928      define buffer ext-system for ext-system.
     4929      get-key-value section "ProxyServ" key icode value oValue.
     4930      if oValue eq ?
     4931      then do:
     4932         if Mext-sys eq ?
     4933         then
     4934            getExtSys ().
     4935         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     4936                                         and ext-system.esys-id eq Mext-sys no-error.
     4937         if available ext-system
     4938         then do:
     4939                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     4940            (ext-system.esys-id,
     4941             mdb-num-local,
     4942             icode,
     4943             output oValue,
     4944             output vtype) no-error.
     4945          end.
     4946      end.
     4947      return if oValue eq ? then "" else oValue .
     4948   end.
     4949   function  SetExtAttr returns character
     4950   (input icode   as character,
     4951    input iValue  as character):
     4952      define variable vtype as character no-undo.
     4953      define buffer ext-system for ext-system.
     4954      if Mext-sys eq ?
     4955      then
     4956         getExtSys ().
     4957      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     4958                                      and ext-system.esys-id eq Mext-sys no-error.
     4959      if available ext-system
     4960      then do:
     4961          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     4962         (ext-system.esys-id,
     4963          mdb-num-local,
     4964          icode,
     4965          iValue) no-error.
     4966       end.
     4967   end.
     4968   define stream File-stream.
     4969   function PutMes returns character
     4970   (idext as character ):
     4971      if valid-handle(mPublishHand)
     4972      then
     4973         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     4974      else do:
     4975         if idext begins "error"
     4976         then do:
     4977            message substring (idext,6)
     4978               view-as alert-box.
     4979            if mDiadocApi ne ?
     4980            then
     4981               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     4982         end.
     4983         output stream File-stream to "diadoc_user.log" append.
     4984         put stream File-stream unformatted now " " idext skip.
     4985         output stream File-stream close.
     4986      end.
     4987   end.
     4988   function PutErr returns character
     4989   (idext as character ):
     4990      define variable vi as integer no-undo.
     4991      define variable vnumerr as integer no-undo.
     4992      define variable vtext as character extent 25 no-undo .
     4993      if error-status:num-messages > 0 then do:
     4994         vnumerr = error-status:num-messages.
     4995         vnumerr = min(vnumerr,extent(vtext)).
     4996         do vi = 1 to vnumerr:
     4997            vtext[vi] = error-status:get-message(vi).
     4998         end.
     4999         idext = idext + chr(10) + "Ошибка: [":U.
     5000         do vi = 1 to vnumerr:
     5001            idext = idext + chr(10) + vtext[vi] no-error.
     5002         end.
     5003         idext = idext +  chr(10) +  " ]" no-error.
     5004         if not  idext begins "Error"
     5005         then
     5006            idext = "Error " + idext.
     5007         PutMes(idext).
     5008      end.
     5009   end.
     5010   function PutStat returns character
     5011   (itext as character,
     5012    iflag as logical):
     5013      if valid-handle(mPublishHand)
     5014      then
     5015         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5016      PutMes(itext).
     5017   end.
     5018   function chekStop returns logical
     5019   ( ):
     5020      define variable oStop as logical no-undo.
     5021      if valid-handle(mPublishHand)
     5022      then
     5023         publish "StopProc" from mPublishHand (output oStop).
     5024      return oStop.
     5025   end.
     5026   function  putloggetdesc returns logical
     5027   (is1 as character ,is2 as character ,
     5028   is3 as character ):
     5029   end.
     5030   function  getdesc returns logical
     5031   (input iObj as component-handle):
     5032      if iObj eq ? then return false.
     5033      if mdebug
     5034      then do:
     5035      output stream File-stream to "diadoc_load.txt" append.
     5036      define variable vReflector as component-handle no-undo.
     5037      define variable vDescobj  as component-handle no-undo.
     5038      define variable vPropertyNames  as component-handle no-undo.
     5039      define variable vMethodsNames as component-handle no-undo.
     5040      define variable vMethodDesc as component-handle no-undo.
     5041      define variable vMethodsName as character  no-undo.
     5042      define variable vPropertyValue as char no-undo.
     5043      create "Diadoc.Reflector" vReflector.
     5044      vDescobj = vReflector:Describe(iObj).
     5045     put   stream File-stream  unformatted skip (1)
     5046      "------------------------------------------" skip
     5047      vDescobj:GetInterfaceName() skip.
     5048      define variable vPropertyName as character no-undo.
     5049      define variable vPropertyType as character no-undo.
     5050      .
     5051      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5052      putloggetdesc("property","","").
     5053      define variable vi as integer no-undo.
     5054      define variable vii as integer no-undo.
     5055     put stream File-stream  unformatted skip "property" skip.
     5056     vPropertyNames = vDescobj:GetPropertiesNames().
     5057      vi= vPropertyNames:count.
     5058      do vi= 1 to vPropertyNames:count :
     5059         vPropertyName = "".
     5060         vPropertyType = "".
     5061         vPropertyValue = "".
     5062         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5063         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5064         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5065         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5066        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5067      end.
     5068      release object vPropertyNames.
     5069      put stream File-stream  unformatted skip "method" skip.
     5070      vMethodsNames = vDescobj:GetMethodsNames().
     5071      vi = vMethodsNames:count.
     5072      do vi = 1 to vMethodsNames:count :
     5073         vMethodsName = "".
     5074         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5075         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5076         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5077         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5078         do vii  = 1 to vMethodDesc:args:count:
     5079            define variable varg as character no-undo.
     5080            varg = "".
     5081            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5082            put stream File-stream  unformatted " args " varg  skip .
     5083            putloggetdesc(" args ",varg, "").
     5084         end.
     5085         release object vMethodDesc.
     5086      end.
     5087      release object vMethodsNames.
     5088      put stream File-stream  unformatted "end---------------------------------------" skip.
     5089      output stream File-stream close.
     5090      release object vDescobj.
     5091      release object vReflector.
     5092      end.
     5093      return true.
     5094   end.
     5095   function getxsddocum returns logical
     5096   (iOrganization as component-handle):
     5097      if iOrganization eq ? then return false.
     5098      define variable vDocumentTypes as component-handle no-undo.
     5099      define variable vDocumentType as component-handle no-undo.
     5100      define variable vFunctions as component-handle no-undo.
     5101      define variable vFunction as component-handle no-undo.
     5102      define variable vVersions as component-handle no-undo.
     5103      define variable vVersion as component-handle no-undo.
     5104      define variable vTitles as component-handle no-undo.
     5105      define variable vTitle as component-handle no-undo.
     5106      define variable vi as integer no-undo.
     5107      define variable vii as integer no-undo.
     5108      define variable viii as integer no-undo.
     5109      define variable viiii as integer no-undo.
     5110      if mdebug
     5111      then do:
     5112      output stream File-stream to "diadoc_doc.txt" append.
     5113      vDocumentTypes = iOrganization:GetDocumentTypes().
     5114      do vi =1 to vDocumentTypes:count:
     5115         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5116         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5117         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5118         vFunctions = vDocumentType:Functions.
     5119         do vii =1 to vFunctions:count:
     5120            vFunction = vFunctions:GetItem(vii - 1 ).
     5121            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     5122            vVersions = vFunction:Versions.
     5123            do viii =1 to vVersions:count:
     5124               vVersion = vVersions:GetItem(viii - 1 ).
     5125               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     5126               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     5127               vTitles  = vVersion:Titles.
     5128               do viiii =1 to vTitles:count:
     5129                  vTitle = vTitles:GetItem(viiii - 1 ).
     5130                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     5131                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     5132                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     5133                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     5134                  release object vTitle.
     5135               end.
     5136              release object vTitles.
     5137               release object vVersion.
     5138            end.
     5139            release object vVersions.
     5140            release object vFunction.
     5141         end.
     5142         release object vFunctions.
     5143         release object vDocumentType.
     5144      end.
     5145      release object vDocumentTypes.
     5146      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     5147     output stream File-stream close.
     5148     end.
     5149      return true.
     5150   end.
     5151   function GetDocTitleType returns character
     5152   (iOrganizationGuid as character ,
     5153   itype as character ,
     5154   ifunction as character,
     5155   iversion as character
     5156   ):
     5157      if iOrganizationGuid eq ? then return "".
     5158      define variable vOrganization  as component-handle no-undo.
     5159      define variable vDocumentTypes as component-handle no-undo.
     5160      define variable vDocumentType  as component-handle no-undo.
     5161      define variable vFunctions     as component-handle no-undo.
     5162      define variable vFunction      as component-handle no-undo.
     5163      define variable vVersions      as component-handle no-undo.
     5164      define variable vVersion       as component-handle no-undo.
     5165      define variable vTitles        as component-handle no-undo.
     5166      define variable vTitle         as component-handle no-undo.
     5167      define variable vi             as integer no-undo.
     5168      define variable vii            as integer no-undo.
     5169      define variable viii           as integer no-undo.
     5170      define variable viiii          as integer no-undo.
     5171      define variable oTitleType as character no-undo.
     5172      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     5173      if vOrganization eq ? then return "".
     5174      vDocumentTypes = vOrganization:GetDocumentTypes().
     5175      do vi =1 to vDocumentTypes:count:
     5176         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5177         if vDocumentType:name eq iType
     5178         then do:
     5179            vFunctions = vDocumentType:Functions.
     5180            do vii =1 to vFunctions:count:
     5181               vFunction = vFunctions:GetItem(vii - 1 ).
     5182               if vFunction:name eq ifunction
     5183               then do:
     5184                  vVersions = vFunction:Versions.
     5185                  do viii =1 to vVersions:count:
     5186                     vVersion = vVersions:GetItem(viii - 1 ).
     5187                     if vVersion:version eq iversion
     5188                     then do:
     5189                        vTitles  = vVersion:Titles.
     5190                        do viiii =1 to vTitles:count:
     5191                           vTitle = vTitles:GetItem(viiii - 1 ).
     5192                           oTitleType = oTitleType + "," + vTitle:type.
     5193                           release object vTitle.
     5194                        end.
     5195                        release object vTitles.
     5196                     end.
     5197                     release object vVersion.
     5198                  end.
     5199                  release object vVersions.
     5200               end.
     5201               release object vFunction.
     5202            end.
     5203            release object vFunctions.
     5204         end.
     5205         release object vDocumentType.
     5206      end.
     5207      release object vDocumentTypes.
     5208      release object vOrganization.
     5209      return left-trim(oTitleType,",").
     5210   end.
     5211   define temp-table tt-type no-undo
     5212             field id as char
     5213             field name as character
     5214             index pi id .
     5215   define temp-table tt-Class no-undo like tt-type.
     5216   function crcode returns character
     5217   ():
     5218      define variable vtypelist as character no-undo.
     5219      define variable vtypename as character no-undo.
     5220      define variable vi as integer no-undo.
     5221      vtypelist =
     5222                 "UniversalTransferDocument|"
     5223                + "UniversalTransferDocumentRevision|"
     5224                + "UniversalCorrectionDocument|"
     5225                + "UniversalCorrectionDocumentRevision"
     5226                .
     5227      vtypename =
     5228                 "УПД|"
     5229                + "Исправление УПД|"
     5230                + "УКД|"
     5231                + "Исправление УКД"
     5232                .
     5233      do vi = 1 to num-entries(vtypelist,"|"):
     5234         create tt-type.
     5235         assign
     5236            tt-type.id   =  entry(vi,vtypelist,"|")
     5237            tt-type.name =  entry(vi,vtypename,"|")
     5238         .
     5239      end.
     5240      vtypelist = "Inbound|"
     5241                + "Outbound|"
     5242                + "Proxy".
     5243      vtypename = "входящий документ|"
     5244                + "исходящий документ|"
     5245                + "документ, переданный через промежуточного получателя|".
     5246      do vi = 1 to num-entries(vtypelist,"|"):
     5247         create tt-Class.
     5248         assign
     5249            tt-Class.id   =  entry(vi,vtypelist,"|")
     5250            tt-Class.name =  entry(vi,vtypename,"|")
     5251         .
     5252      end.
     5253   end.
     5254   crcode().
     5255   function getOrganizationInfo returns character
     5256   (input iContAgent as component-handle,
     5257                                                   output oinn as character,
     5258                                                   output oKpp as character,
     5259                                                   output oFnsParticipantId as character,
     5260                                                   output oOrgName as character,
     5261                                                   output oAdditionalInfo as character,
     5262                                                   output OarddrRus as character
     5263                                                    ):
     5264      define variable vi as integer no-undo.
     5265      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     5266      define variable vAddrRus                        as component-handle no-undo.
     5267      if iContAgent ne ?
     5268      then do:
     5269         getdesc(iContAgent).
     5270         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     5271         oinn = vContAgentOrganizationDetails:Inn.
     5272         oKpp = vContAgentOrganizationDetails:Kpp.
     5273         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     5274         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     5275         getdesc(vContAgentOrganizationDetails).
     5276         oOrgName = vContAgentOrganizationDetails:OrgName.
     5277         getdesc(vContAgentOrganizationDetails:Address).
     5278         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     5279         getdesc(vAddrRus ).
     5280         if vAddrRus ne ?
     5281         then do:
     5282            if vAddrRus:ZipCode ne ""
     5283            then
     5284               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     5285            if vAddrRus:Region ne ""
     5286            then
     5287               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     5288            if vAddrRus:Territory ne ""
     5289            then
     5290               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     5291            if vAddrRus:City ne ""
     5292            then
     5293               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     5294            if vAddrRus:Locality ne ""
     5295            then
     5296               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     5297            if vAddrRus:Street ne ""
     5298            then
     5299               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     5300            if vAddrRus:Block ne ""
     5301            then
     5302               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     5303            if vAddrRus:Building ne ""
     5304            then
     5305               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     5306            if vAddrRus:Apartment ne ""
     5307            then
     5308               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     5309         end.
     5310         release object vAddrRus.
     5311         release object vContAgentOrganizationDetails.
     5312      end.
     5313   end.
     5314   function ConectByCertif return component-handle
     5315   (iThumbprint as character ):
     5316     if mDiadocApi eq ? then return ?.
     5317     if iThumbprint eq ""
     5318     then do:
     5319        release object mDiadocConnection no-error.
     5320        return ?.
     5321     end.
     5322      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     5323      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     5324      define variable vSSl as character no-undo.
     5325      vSSl =  getextAttr('diadoc-ssl':U).
     5326      if vSSl ne ""
     5327         and logical(vSSl)
     5328      then
     5329         mDiadocApi:VerifySslCertificate = no.
     5330      if mDiadocApi:ApiClientId eq ""
     5331         or  mDiadocApi:ServerUrl eq ""
     5332      then do:
     5333        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     5334        view-as alert-box.
     5335        release object mDiadocConnection no-error.
     5336        return ?.
     5337     end.
     5338     define variable VProxy as character no-undo.
     5339      vProxy =  getextAttr('proxy-addr':U).
     5340      if     vProxy ne ""
     5341         and vProxy ne ?
     5342      then do:
     5343         mDiadocApi:ProxyMode =  "UseProxy".
     5344         mDiadocApi:ProxySettings:Url = vProxy.
     5345         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5346         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5347      end.
     5348      define variable vtest as component-handle no-undo.
     5349      vtest = mDiadocApi:TestConnection2().
     5350      if not vtest:ConnectionSuccess
     5351      then do:
     5352         PutMes(vtest:ErrorText).
     5353      end.
     5354      else
     5355         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     5356      if mDiadocConnection eq ?
     5357      then
     5358         PutErr("DiadocApi:CreateConnectionByCertificate:").
     5359      release object vtest.
     5360      return mDiadocConnection.
     5361   end.
     5362   function ConectByLogin return component-handle
     5363   ():
     5364      define variable vSSl as character no-undo.
     5365      if mDiadocApi eq ? then return ?.
     5366      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     5367      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     5368      if mDiadocApi:ApiClientId eq ""
     5369         or  mDiadocApi:ServerUrl eq ""
     5370      then do:
     5371        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     5372        release object mDiadocConnection no-error.
     5373        return ?.
     5374     end.
     5375     vSSl =  getextAttr('diadoc-ssl':U).
     5376     if vSSl ne ""
     5377        and logical(vSSl)
     5378     then
     5379         mDiadocApi:VerifySslCertificate = no.
     5380     define variable VProxy as character no-undo.
     5381      vProxy =  getextAttr('proxy-addr':U).
     5382      if     vProxy ne ""
     5383         and vProxy ne ?
     5384      then do:
     5385         mDiadocApi:ProxyMode =  "UseProxy".
     5386         mDiadocApi:ProxySettings:Url = vProxy.
     5387         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5388         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5389      end.
     5390      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     5391      define variable vi as integer no-undo.
     5392      if mDiadocConnection eq ?
     5393      then
     5394         PutErr("DiadocAPI:CreateConnectionByLogin").
     5395      return mDiadocConnection.
     5396   end.
     5397   function GetDocumforid returns character
     5398   (input  iorg as character ,
     5399    input  idoc-id as character ,
     5400    output oDocument      as component-handle
     5401     ):
     5402      define variable vOrganization  as component-handle no-undo.
     5403      define variable vDocument      as component-handle no-undo.
     5404      define buffer utd           for ub.utd.
     5405      if
     5406             iorg  ne ?
     5407         and iorg  ne ""
     5408         and idoc-id ne ?
     5409         and idoc-id ne ""
     5410      then do:
     5411         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     5412         if vOrganization ne ?
     5413         then do:
     5414            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     5415            if oDocument eq ?
     5416            then
     5417               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     5418         end.
     5419         else do:
     5420            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     5421            return "Нет доступа к организации " + iorg.
     5422         end.
     5423      end.
     5424      else
     5425         return "Нет доступа к организации не ЭДО".
     5426      release object vOrganization no-error.
     5427      return "".
     5428   end.
     5429   function GetDocum returns character
     5430   (input  idb-num as integer,
     5431    input  idoc-id as integer,
     5432    output oDocument      as component-handle
     5433     ):
     5434      define variable vOrganization  as component-handle no-undo.
     5435      define variable vDocument      as component-handle no-undo.
     5436      define buffer utd           for ub.utd.
     5437      find first utd where utd.db-num eq idb-num
     5438                       and utd.doc-id eq idoc-id
     5439      no-lock no-error.
     5440      if     available utd
     5441         and utd.OrganizationExt ne ?
     5442         and utd.OrganizationExt ne ""
     5443         and utd.DocumentExt ne ?
     5444         and utd.DocumentExt ne ""
     5445      then do:
     5446         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     5447         if vOrganization ne ?
     5448         then do:
     5449            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     5450            if oDocument eq ?
     5451            then
     5452               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     5453            release object vOrganization no-error.
     5454         end.
     5455         else do:
     5456            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     5457            return "Нет доступа к организации " + utd.OrganizationExt.
     5458         end.
     5459      end.
     5460      else
     5461         return "Нет доступа к организации не ЭДО".
     5462      return "".
     5463   end.
     5464   function GetFirstUTDinPack returns logical
     5465   (input idb-num as integer,
     5466    input idoc-id as integer,
     5467    output odb-num as integer,
     5468    output odoc-id as integer ):
     5469      define buffer buf_utd for utd.
     5470      define buffer     utd for utd.
     5471      find first utd where utd.db-num eq idb-num
     5472                       and utd.doc-id eq idoc-id
     5473      no-lock no-error.
     5474      if available utd
     5475      then do:
     5476         if utd.PackageId eq ""
     5477         then do:
     5478            assign
     5479               odb-num = utd.db-num
     5480               odoc-id = utd.doc-id
     5481            .
     5482            return yes.
     5483         end.
     5484         else do:
     5485            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     5486                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5487            no-lock.
     5488            assign
     5489               odb-num = buf_utd.db-num
     5490               odoc-id = buf_utd.doc-id
     5491            .
     5492            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     5493         end.
     5494      end.
     5495      return ?.
     5496   end.
     5497   function AddOADLine returns integer
     5498   (iDb-num  as integer ,
     5499    iDoc-id  as integer ,
     5500    ilinenum as integer ,
     5501    iGtin    as char,
     5502    iQnty    as int,
     5503    isite    as character ):
     5504       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5505       define variable vnewMark as character no-undo.
     5506       define variable vQnty    as integer   no-undo.
     5507       vnewMark = "02" + iGtin + "37" + string(iQnty).
     5508       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     5509                                      and utd-marking-lines.db-num     = idb-num
     5510                                      and utd-marking-lines.doc-id     = idoc-id
     5511                                      and utd-marking-lines.Linenum    = iLinenum
     5512       exclusive-lock no-error.
     5513       if available utd-marking-lines
     5514       then do:
     5515          delete utd-marking-lines.
     5516          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     5517       end.
     5518       else do:
     5519          create utd-marking-lines.
     5520          assign
     5521             utd-marking-lines.mark      = vnewMark
     5522             utd-marking-lines.db-num    = idb-num
     5523             utd-marking-lines.doc-id    = idoc-id
     5524             utd-marking-lines.Linenum   = iLinenum
     5525             utd-marking-lines.site      = isite
     5526             utd-marking-lines.doc-level = 1
     5527             utd-marking-lines.gds-code  = ?
     5528          .
     5529          vQnty = iQnty.
     5530       end.
     5531       return vQnty.
     5532    end.
     5533   function addMarkforUtd returns recid
     5534   (iDb-num  as integer ,
     5535    iDoc-id  as integer ,
     5536    ilinenum as integer ,
     5537    iMark as character  ,
     5538    isite   as character,
     5539    iUtdType as character    ):
     5540       define buffer     marking            for ub.marking.
     5541       define buffer     marking-attr       for ub.marking-attr.
     5542       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5543       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5544       define variable vMRC  as decimal no-undo.
     5545       define variable vQnty as decimal no-undo.
     5546      define variable vRec as recid no-undo.
     5547      if     imark ne "-"
     5548         and imark ne ""
     5549         and imark ne ?
     5550      then do:
     5551         imark = repTegforDm(imark).
     5552         vQnty = getQntyUTDByCodId(imark) .
     5553         find first utd-marking-lines where utd-marking-lines.mark       = imark
     5554                                        and utd-marking-lines.db-num     = idb-num
     5555                                        and utd-marking-lines.doc-id     = idoc-id
     5556                                        and utd-marking-lines.Linenum    = iLinenum
     5557         exclusive-lock no-error.
     5558         if not available utd-marking-lines
     5559         then do:
     5560            create utd-marking-lines.
     5561            assign
     5562               utd-marking-lines.mark      = imark
     5563               utd-marking-lines.db-num    = idb-num
     5564               utd-marking-lines.doc-id    = idoc-id
     5565               utd-marking-lines.Linenum   = iLinenum
     5566               utd-marking-lines.site      = isite
     5567               utd-marking-lines.doc-level = 1
     5568               utd-marking-lines.gds-code  = ?
     5569            .
     5570            create utd-marking-lines-attr.
     5571            assign
     5572               utd-marking-lines-attr.mark      = imark
     5573               utd-marking-lines-attr.db-num    = idb-num
     5574               utd-marking-lines-attr.doc-id    = idoc-id
     5575               utd-marking-lines-attr.Linenum   = iLinenum
     5576               utd-marking-lines-attr.attr-code = "box-qnty"
     5577               utd-marking-lines-attr.attr-value = string(vQnty)
     5578            .
     5579            vRec = recid(utd-marking-lines).
     5580            release utd-marking-lines-attr.
     5581            release utd-marking-lines.
     5582         end.
     5583         else do:
     5584            if    (    isite eq "-"
     5585               and utd-marking-lines.site eq "+")
     5586            or (    isite eq "+"
     5587               and utd-marking-lines.site eq "-")
     5588            then
     5589               delete utd-marking-lines.
     5590            else if isOAD (imark)
     5591            then do:
     5592               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     5593               create utd-marking-lines-attr.
     5594               assign
     5595                  utd-marking-lines-attr.mark      = imark
     5596                  utd-marking-lines-attr.db-num    = idb-num
     5597                  utd-marking-lines-attr.doc-id    = idoc-id
     5598                  utd-marking-lines-attr.Linenum   = iLinenum
     5599                  utd-marking-lines-attr.attr-code = "box-qnty"
     5600                  utd-marking-lines-attr.attr-value = string(vQnty)
     5601               .
     5602            end.
     5603            vRec = recid(utd-marking-lines).
     5604            release utd-marking-lines.
     5605         end.
     5606         if isMark (imark)
     5607         then do:
     5608            find first marking where marking.mark eq iMark exclusive-lock no-error.
     5609            if not available marking
     5610            then do:
     5611               create marking.
     5612               marking.mark = iMark.
     5613               marking.gds-code = ?.
     5614               marking.unit     = getLevelUTDByCodId(marking.mark) .
     5615            end.
     5616            assign
     5617              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     5618                                      getLevelMotpByCodId(marking.mark)
     5619                                   else marking.unit-ext
     5620              marking.box-qnty   = vQnty
     5621              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     5622            .
     5623            if        (     iUtdType eq "UniversalTransferDocument"
     5624                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     5625            then
     5626               marking.sts = ?.
     5627         end.
     5628      end.
     5629      return vRec.
     5630   end.
     5631   function isSaleMarkInUpak returns logical
     5632   (iMark    as char ):
     5633      define buffer buf_marking       for ub.marking.
     5634      for each buf_marking no-lock where
     5635               buf_marking.mark-parent = iMark
     5636      :
     5637        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     5638           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     5639          return true.
     5640        if isSaleMarkInUpak(buf_marking.mark) then
     5641          return true.
     5642      end.
     5643      return false.
     5644    end.
     5645   function setStatusUpak returns logical
     5646   (iDbNum   as integer ,
     5647    iDocId   as integer ,
     5648    iLineNum as integer ,
     5649    iMark    as char ,
     5650    iSts     as integer):
     5651      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5652      define buffer buf_marking           for ub.marking.
     5653      for each buf_marking exclusive-lock where
     5654               buf_marking.mark-parent = iMark,
     5655         first buf_utd-marking-lines exclusive-lock where
     5656               buf_utd-marking-lines.doc-id  = iDocId
     5657           and buf_utd-marking-lines.db-num  = iDbNum
     5658           and buf_utd-marking-lines.lineNum = iLineNum
     5659           and buf_utd-marking-lines.mark = buf_marking.mark
     5660      :
     5661        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     5662      end.
     5663      for first buf_utd-marking-lines exclusive-lock where
     5664                buf_utd-marking-lines.doc-id  = iDocId
     5665            and buf_utd-marking-lines.db-num  = iDbNum
     5666            and buf_utd-marking-lines.lineNum = iLineNum
     5667            and buf_utd-marking-lines.mark = iMark,
     5668          first buf_marking exclusive-lock where
     5669                buf_marking.mark = buf_utd-marking-lines.mark
     5670      :
     5671        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     5672        then do:
     5673          assign
     5674            buf_utd-marking-lines.sts = iSts
     5675            buf_marking.sts           = iSts
     5676          .
     5677        end.
     5678      end.
     5679      return true.
     5680   end.
     5681   define temp-table tt-recid no-undo
     5682             field orgid as char
     5683             field docid as char
     5684             field parent as char
     5685             field stamp as datetime
     5686             index pi orgid docid
     5687             index parent parent  stamp.
     5688   function ProcessSystemMessStart return component-handle
     5689   (IStartStop as logical):
     5690      if mDiadocConnection eq ? then
     5691      define variable vOrganizationList as component-handle no-undo.
     5692      define variable vOrganization as component-handle no-undo.
     5693      define variable vReceiptGenerationProcess as component-handle no-undo.
     5694      define variable vi as integer no-undo.
     5695      if mDiadocConnection ne ?
     5696      then do:
     5697         vOrganizationList = mDiadocConnection:GetOrganizationList().
     5698          do vi = 1 to vOrganizationList:count:
     5699             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     5700             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     5701             release object vOrganization.
     5702             if IStartStop
     5703             then
     5704                vReceiptGenerationProcess:Start().
     5705             else
     5706                vReceiptGenerationProcess:Stop().
     5707             release object vReceiptGenerationProcess.
     5708          end.
     5709          release object vOrganizationList.
     5710      end.
     5711   end.
     5712   procedure  changeIdToGuid :
     5713   define input  parameter iOrganization as component-handle no-undo.
     5714      define variable vOrgId   as character no-undo.
     5715      define variable vOrgGuid as character no-undo.
     5716      define buffer utd for utd.
     5717      assign
     5718         vOrgId   = iOrganization:id.
     5719         vOrgGuid = iOrganization:guid
     5720      no-error.
     5721      if     error-status:num-messages eq 0
     5722         and vOrgId   ne ""
     5723         and vOrgGuid ne ""
     5724      then do:
     5725         define variable vfirst as logical no-undo init yes.
     5726         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     5727            find next utd.
     5728            if vfirst
     5729            then do:
     5730               PutMes("Конвертация документов").
     5731               vfirst = no.
     5732            end.
     5733            utd.OrganizationExt = vOrgGuid.
     5734            validate utd.
     5735            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     5736         end.
     5737         if not vfirst
     5738         then
     5739            PutMes("Конвертация документов завершина.").
     5740      end.
     5741   end.
     5742   procedure getNewUpd :
     5743      define variable VLastDate as date no-undo init ?.
     5744      define variable vDocument     as component-handle no-undo.
     5745      define variable vYear         as integer no-undo.
     5746      define variable vMonth        as integer no-undo.
     5747      define variable vDay          as integer no-undo.
     5748      define variable vBegLoadDate  as date    no-undo.
     5749      define variable vLastLoadDate as date    no-undo.
     5750      define buffer utd for utd.
     5751      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     5752      find first sys-ctrl no-lock.
     5753      if VLastDate eq ?
     5754      then
     5755         VLastDate = sys-ctrl.cut-date + 3.
     5756      else if sys-ctrl.cut-date ne ?
     5757      then
     5758         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     5759      vLastLoadDate = VLastDate.
     5760      for each tt-recid:
     5761         delete tt-recid.
     5762      end.
     5763      if chekStop() then return "Остановка пользователем".
     5764       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     5765      if chekStop() then return "Остановка пользователем".
     5766      if VLastDate ne ?
     5767      then do:
     5768         setextAttr('diadoc-lastload':U,string(VLastDate)).
     5769         vYear = year(vLastLoadDate).
     5770         vMonth = month(vLastLoadDate) - 2.
     5771         vDay   = day(vLastLoadDate).
     5772         if vMonth <= 0 then
     5773            assign
     5774               vMonth = vMonth + 12
     5775               vYear  = vYear - 1
     5776               .
     5777         repeat:
     5778            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     5779            if error-status:error then
     5780               vDay = vDay - 1.
     5781            else
     5782               leave.
     5783         end.
     5784         vBegLoadDate = vBegLoadDate + 1.
     5785      end.
     5786      block-rec:
     5787      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     5788         if  tt-recid.parent eq ""
     5789         then next  block-rec.
     5790         if first-of (tt-recid.parent)
     5791         then do:
     5792            for each utd where utd.PackageId eq tt-recid.parent
     5793            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     5794               if chekStop() then return "Остановка пользователем".
     5795               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5796               then do:
     5797                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5798                  MySeqUtd = ?.
     5799                  CrEdoc(utd.PackageId,utd.Timestamp).
     5800                  unsubscribe "getNextseq".
     5801                  next block-rec.
     5802               end.
     5803            end.
     5804         end.
     5805      end.
     5806      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     5807                                                                                        string(vBegLoadDate)
     5808                                                                                     else "?")
     5809                                                                                     + " по " +
     5810                                                                                     (if vLastLoadDate <> ? then
     5811                                                                                         string(vLastLoadDate)
     5812                                                                                      else
     5813                                                                                         "?")
     5814                                                                                      ).
     5815      define variable vobj as character no-undo.
     5816      vobj = getExtAttr('host-code':U).
     5817      if vobj ne "0"
     5818      then
     5819          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5820                         and utd.host-code eq int(vobj)
     5821                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5822                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5823                              )
     5824          no-lock break by utd.OrganizationExt:
     5825             if chekStop() then return "Остановка пользователем".
     5826             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5827             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5828                                   and tt-recid.docid = utd.DocumentExt
     5829                    no-error.
     5830             if     not available tt-recid
     5831                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5832             then do:
     5833                 run  UpdateUTDInformOne(vDocument).
     5834                release object vDocument no-error.
     5835             end.
     5836          end.
     5837      vobj = getExtAttr('obj':U).
     5838      if vobj ne ""
     5839      then
     5840          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5841                         and utd.obj-type + string(utd.obj-code) eq vobj
     5842          no-lock break by utd.OrganizationExt:
     5843             if chekStop() then return "Остановка пользователем".
     5844             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5845             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5846                                   and tt-recid.docid = utd.DocumentExt
     5847                    no-error.
     5848             if     not available tt-recid
     5849                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5850             then do:
     5851                 run  UpdateUTDInformOne(vDocument).
     5852                release object vDocument no-error.
     5853             end.
     5854          end.
     5855   end.
     5856   procedure  SendAuto:
     5857    define variable vOrganization as component-handle no-undo.
     5858    define variable vOrganizationList as component-handle no-undo.
     5859    define variable vi as integer no-undo.
     5860      if mDiadocConnection eq ?
     5861      then do:
     5862         message "По данному сертификату не удалось подключиться к Диадок"
     5863         view-as alert-box.
     5864      end.
     5865      else do:
     5866         for each tt-recid:
     5867            delete tt-recid.
     5868         end.
     5869         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     5870         if vOrganizationList eq ? then return error ?.
     5871         vi = vOrganizationList:Count()no-error.
     5872         if vi eq ?
     5873         then
     5874            return error ?.
     5875         do vi = 1 to vOrganizationList:Count() :
     5876            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     5877            define variable vorgid as character no-undo.
     5878            vorgid = vOrganization:guid.
     5879            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5880                           and utd.host-code eq v-cntxt-host-code-obj
     5881                           and utd.OrganizationExt eq vorgid
     5882            no-lock:
     5883                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     5884            end.
     5885            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5886                           and utd.host-code eq v-cntxt-host-code-obj
     5887                           and utd.OrganizationExt eq vorgid
     5888            no-lock:
     5889                run  updOneUTD(utd.db-num,utd.doc-id).
     5890            end.
     5891         end.
     5892      end.
     5893   end.
     5894   define temp-table tt-pack no-undo
     5895             field orgid as char
     5896             field docid as char
     5897             field packid as char
     5898             field stamp as datetime
     5899             index pi packid   stamp   orgid  docid
     5900             .
     5901   function CheckLoad returns logical
     5902   (iDocument as component-handle,
     5903    output ohost-code as integer ,
     5904    output oObj-type  as character  ,
     5905    output oObj-code  as integer ):
     5906      define variable vFlag as logical no-undo.
     5907      define variable vDocumentChild as component-handle no-undo.
     5908      define variable vContent as component-handle no-undo.
     5909      define variable vConsignees as component-handle no-undo.
     5910      define variable vfilename as character no-undo.
     5911      oObj-type  = ?.
     5912      oObj-code  = ?.
     5913      ohost-code = ?.
     5914      define buffer ext-classif   for ext-classif.
     5915      define buffer clients       for clients.
     5916      define buffer buf_clients   for clients.
     5917      define buffer clients-attr  for clients-attr.
     5918      if   iDocument:type eq "UniversalTransferDocument"
     5919        or iDocument:type eq "UniversalTransferDocumentRevision"
     5920      then main-block :
     5921      do on error undo main-block, return error:
     5922         getdesc(iDocument).
     5923         vfilename = iDocument:filename.
     5924         if iDocument:Direction eq "Inbound"
     5925         then do:
     5926            define variable vOrganizationGuid as character no-undo.
     5927            define variable vDocumentid as character no-undo.
     5928            vOrganizationGuid = iDocument:OrganizationGuid.
     5929            vDocumentid     = iDocument:DocumentId.
     5930            find first utd where utd.DocumentExt     = vDocumentid
     5931                             and utd.OrganizationExt = vOrganizationGuid
     5932            no-lock no-error .
     5933            if available utd
     5934            then do:
     5935               assign
     5936                  Oobj-type = utd.obj-type
     5937                  Oobj-code = utd.obj-code
     5938                  ohost-code = utd.host-code.
     5939               .
     5940            end.
     5941            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     5942            getdesc(vDocumentChild).
     5943            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     5944               and ohost-code ne 0 and ohost-code ne ?)
     5945            then vFlag = no.
     5946            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     5947               and (ohost-code eq 0 and ohost-code eq ?))
     5948            then do:
     5949                find first clients  where clients.obj-type   = Oobj-type
     5950                                      and clients.obj-code   = Oobj-code
     5951                no-lock no-error .
     5952                if available clients
     5953                then
     5954                   ohost-code =  clients.host-code.
     5955                vFlag = no.
     5956            end.
     5957            else if vDocumentChild ne ?
     5958            then do:
     5959               if iDocument:version  eq "utd820_05_01_01"
     5960               then do:
     5961                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     5962               end.
     5963               else
     5964                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     5965               release object vDocumentChild.
     5966               if vContent ne ?
     5967               then do:
     5968                  getdesc(vContent).
     5969                  define variable vFnsParticipantId as character no-undo.
     5970                  define variable vinn as character no-undo.
     5971                  define variable vkpp as character no-undo.
     5972                  define variable vorgname as character no-undo.
     5973                  define variable vAddrOrg as character no-undo.
     5974                  define variable vAdditionalInfo as character no-undo.
     5975                  if iDocument:version  eq "utd820_05_01_01"
     5976                  then do:
     5977                     getdesc(vContent:Sellers).
     5978                     getdesc(vContent:Sellers:Seller).
     5979                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     5980                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     5981                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     5982                  end.
     5983                  else do:
     5984                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     5985                  end.
     5986                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     5987                                           and ext-classif.charkey_three eq vFnsParticipantId
     5988                  no-lock no-error.
     5989                  if available ext-classif
     5990                  then do:
     5991                     find first clients
     5992                       where clients.obj-type   = ext-classif.CharKey_One
     5993                         and clients.obj-code   = ext-classif.Key#_One
     5994                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     5995                     no-lock no-error .
     5996                     if not available clients
     5997                     then do:
     5998                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     5999                        return no.
     6000                     end.
     6001                  end.
     6002                  else do:
     6003                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6004                     return no.
     6005                  end.
     6006                  if iDocument:version  eq "utd820_05_01_01"
     6007                  then do:
     6008                     getdesc(vContent:Buyers).
     6009                     getdesc(vContent:Buyers:Buyer).
     6010                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     6011                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     6012                  end.
     6013                  else do:
     6014                     vConsignees = vContent:Consignees.
     6015                     getdesc(vConsignees).
     6016                     getdesc(vConsignees:Consignee).
     6017                     if vConsignees:Consignee:count > 0
     6018                     then do:
     6019                        getdesc(vConsignees:Consignee:GetItem(0)).
     6020                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6021                     end.
     6022                     release object vConsignees.
     6023                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     6024                  end.
     6025                  release object vContent.
     6026                  define variable otext as character no-undo.
     6027                  vFlag = getObgFns
     6028                             (input iDocument:DocumentNumber ,
     6029                              input vFnsParticipantId ,
     6030                              input vkpp,
     6031                              output ohost-code,
     6032                              output oobj-type,
     6033                              output oobj-code,
     6034                              output otext ).
     6035                  if otext ne "" and otext ne ?
     6036                  then
     6037                     PutMes( otext).
     6038                  if vFlag  eq no
     6039                  then
     6040                     return vFlag .
     6041               end.
     6042               else do:
     6043                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     6044                  return no.
     6045               end.
     6046            end.
     6047            else do:
     6048               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6049               return no.
     6050            end.
     6051         end.
     6052         else
     6053            return yes.
     6054         if ohost-code eq ? or ohost-code eq 0
     6055         then do:
     6056            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6057            return no.
     6058         end.
     6059      end.
     6060      else do:
     6061         define variable vdb-num as integer no-undo.
     6062         define variable vdoc-id as integer no-undo.
     6063         define variable vpack as character no-undo init ?.
     6064         define variable vcli-type as character no-undo.
     6065         define variable vcli-code as integer no-undo.
     6066         define variable vfns as character no-undo.
     6067         define variable vchar as character no-undo.
     6068         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     6069         if vDocumentChild eq ?
     6070         then do:
     6071            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6072            return no.
     6073         end.
     6074         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     6075         if vContent ne ?
     6076         then do:
     6077            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     6078            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6079                                     and ext-classif.charkey_three eq vFns
     6080            no-lock no-error.
     6081            if available ext-classif
     6082            then do:
     6083               assign
     6084                  vcli-type = ext-classif.CharKey_One
     6085                  vcli-code = ext-classif.Key#_One
     6086               .
     6087               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     6088               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     6089               release object vContent.
     6090            end.
     6091            else do:
     6092                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6093                     return no.
     6094                  end.
     6095         end.
     6096         else do:
     6097            PutErr("Error Ошибка получения данных из Диадок Seller").
     6098            return no.
     6099         end.
     6100         release object vDocumentChild.
     6101         define buffer     utd for utd.
     6102         find first utd where utd.db-num eq vdb-num
     6103                          and utd.doc-id eq vdoc-id
     6104         no-lock no-error.
     6105         if available utd
     6106         then do:
     6107            assign
     6108               oobj-type  = utd.obj-type
     6109               oobj-code  = utd.obj-code
     6110               ohost-code = utd.host-code
     6111               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     6112            .
     6113         end.
     6114         else do:
     6115            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     6116            return no.
     6117         end.
     6118      end.
     6119      if  yes
     6120      then do:
     6121         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6122         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     6123         if     not EDOParSec:IsEdo
     6124            and vfilename begins "ON_NSCHFDOPPRMARK_"
     6125         then do:
     6126            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     6127            vFlag = no.
     6128         end.
     6129         else if     not EDOParSec:IsEdoNotmark
     6130                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     6131         then do:
     6132            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     6133            vFlag = no.
     6134         end.
     6135         else
     6136            vFlag = yes.
     6137      end.
     6138      return vFlag.
     6139   end.
     6140   procedure  UpdateUTDInformOne :
     6141      define input  parameter iDocument as component-handle no-undo.
     6142      define variable vOrganizationGuid as character no-undo.
     6143      define variable vDocumentId as character no-undo.
     6144      define variable vi as integer no-undo.
     6145      define variable vii as integer no-undo.
     6146      define variable viii as integer no-undo.
     6147      define variable vtext as longchar no-undo.
     6148      define buffer utd           for ub.utd.
     6149      define buffer old_utd           for ub.utd.
     6150      define buffer utd-lines      for ub.utd-lines.
     6151      define buffer marking       for ub.marking.
     6152      define buffer marking-lines for ub.marking-lines.
     6153      define buffer utd-marking-lines for ub.utd-marking-lines.
     6154      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6155      define variable vDocumentChild               as component-handle no-undo.
     6156      define variable vContent                     as component-handle no-undo.
     6157      define variable vValues                      as component-handle no-undo.
     6158      define variable vSellers                     as component-handle no-undo.
     6159      define variable vConsignees                  as component-handle no-undo.
     6160      define variable vInvoiceTable                as component-handle no-undo.
     6161      define variable vItems                       as component-handle no-undo.
     6162      define variable vExtendedInvoiceItem         as component-handle no-undo.
     6163      define variable vItemIdentificationNumber    as component-handle no-undo.
     6164      define variable vTransferBaseCol             as component-handle no-undo.
     6165      define variable vTransferBase                as component-handle no-undo.
     6166      define variable vorgname as character no-undo.
     6167      define variable vAddrOrg as character no-undo.
     6168      define variable vAdditionalInfo as character no-undo.
     6169      define variable volddb-num as integer no-undo.
     6170      define variable volddoc-id as integer no-undo.
     6171      define variable vunits  as component-handle no-undo.
     6172      define variable vunit   as component-handle no-undo.
     6173      define variable VValue  as character        no-undo.
     6174      define variable vsite   as character        no-undo.
     6175      define variable vNewUtd as logical          no-undo.
     6176      if iDocument eq ?
     6177      then
     6178        return.
     6179      vOrganizationGuid = iDocument:OrganizationGuid.
     6180      vDocumentid     = iDocument:DocumentId.
     6181      find first utd where utd.DocumentExt     = vDocumentid
     6182                       and utd.OrganizationExt = vOrganizationGuid
     6183      no-lock no-error .
     6184      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     6185                            and tt-recid.docid eq vDocumentid
     6186      no-lock no-error.
     6187      if not available tt-recid
     6188      then do trans:
     6189         if iDocument  ne ?
     6190            and (
     6191                     iDocument:type eq "UniversalTransferDocument"
     6192                  or iDocument:type eq "UniversalTransferDocumentRevision"
     6193                  or iDocument:type eq "UniversalCorrectionDocument"
     6194                 )
     6195         then do:
     6196            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6197            define variable vhost-code as integer   no-undo.
     6198            define variable vobj-type  as character no-undo.
     6199            define variable vobj-code  as integer   no-undo.
     6200            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     6201            then do:
     6202               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6203               create tt-recid.
     6204               assign
     6205                  tt-recid.orgid = vOrganizationGuid
     6206                  tt-recid.docid = vDocumentid
     6207               .
     6208               return.
     6209            end.
     6210            find first utd where utd.DocumentExt     = vDocumentid
     6211                             and utd.OrganizationExt = vOrganizationGuid
     6212            no-lock no-error  .
     6213            if available utd
     6214            then do:
     6215               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6216                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     6217               then do:
     6218                  create tt-recid.
     6219                  assign
     6220                     tt-recid.orgid = vOrganizationGuid.
     6221                     tt-recid.docid = vDocumentid
     6222                  .
     6223                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6224               end.
     6225               find current utd exclusive-lock no-error  no-wait  .
     6226               if  not available  utd
     6227               then do:
     6228                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     6229                  return.
     6230               end.
     6231            end.
     6232            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6233            MySeqUtd = ?.
     6234            if     not available  utd
     6235            then do:
     6236               create utd.
     6237               assign
     6238                  utd.DocumentExt      = vDocumentid
     6239                  utd.OrganizationExt  = vOrganizationGuid
     6240                  vNewUtd              = yes
     6241               .
     6242               validate utd.
     6243            end.
     6244            assign
     6245               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     6246               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     6247               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     6248            .
     6249            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     6250            utd.RevocationStatus = iDocument:RevocationStatus.
     6251            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     6252            utd.TypeId           = iDocument:type.
     6253            utd.CounteragentId   = iDocument:Counteragent:guid.
     6254            utd.CustomDocumentId = iDocument:CustomDocumentId.
     6255            utd.sts-edi = ?.
     6256            utd.DocumentNumber = iDocument:DocumentNumber.
     6257            utd.DocumentDate   = date(iDocument:DocumentDate).
     6258            utd.Timestamp      = datetime(iDocument:Timestamp) .
     6259            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     6260            utd.Direction      = iDocument:Direction.
     6261            utd.ModifyDate = today.
     6262            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     6263            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     6264                             or iDocument:type eq "UniversalTransferDocumentRevision"
     6265                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6266                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     6267            getdesc(iDocument).
     6268            getdesc(iDocument:Counteragent).
     6269            getdesc(iDocument:RecipientReceiptMetadata).
     6270            getdesc(iDocument:ConfirmationMetadata).
     6271            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     6272            if iDocument:type ne "UniversalTransferDocumentRevision"
     6273            then do:
     6274                   utd.Revised = logical(iDocument:Revised).
     6275                   utd.Corrected = logical(iDocument:Corrected).
     6276            end.
     6277            vDocumentChild = iDocument:GetDynamicContent("Seller").
     6278            getdesc(vDocumentChild).
     6279            if   iDocument:type eq "UniversalTransferDocument"
     6280              or iDocument:type eq "UniversalTransferDocumentRevision"
     6281            then do:
     6282               utd.Total = iDocument:total.
     6283               utd.Vat = iDocument:Vat.
     6284            end.
     6285            else do:
     6286               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     6287               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     6288            end.
     6289            find first utd-lines where utd-lines.db-num     = utd.db-num
     6290                                   and utd-lines.doc-id     = utd.doc-id
     6291                                   no-lock no-error.
     6292            if     (   vNewUtd
     6293                    or utd.Direction ne "Inbound"
     6294                    or not available utd-lines)
     6295               and vDocumentChild ne ?
     6296            then do:
     6297               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6298               then do:
