        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   define variable mError as logical no-undo.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64     define variable v-cntxt-db-num        as integer   no-undo .
       65     define variable v-cntxt-userid        as character no-undo .
       66     define variable v-cntxt-level         as character no-undo .
       67     define variable v-cntxt-host-code-obj as integer   no-undo .
       68     define variable v-cntxt-obj-type      as character no-undo .
       69     define variable v-cntxt-obj-code      as integer   no-undo .
       70     define variable v-cntxt-db-num-obj    as integer   no-undo .
       71     define variable v-cntxt-is-admin      as logical   no-undo .
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable mAsyncProc as class ibs.th.file.AsyncProc.
       88   run ibs\th\file\getasyncproc.p (output mAsyncProc).
       89   define variable mstopAsunc as logical no-undo.
       90   function StopCheck returns logical:
       91      define variable oFlag as logical no-undo.
       92      run StopCheckAsync (output oFlag).
       93      return oFlag.
       94   end.
       95   procedure StopCheckAsync:
       96       define output  parameter oFlag as logical no-undo.
       97       if mstopAsunc
       98       then
       99          oFlag = mstopAsunc.
      100       else do:
      101          oFlag = mAsyncProc:CheckStop().
      102          mstopAsunc = oFlag.
      103       end.
      104   end.
      105   function GetParamAsunc returns character
      106   (input iNumPar as integer  ):
      107      return mAsyncProc:GetPARAM(iNumPar).
      108   end.
      109   function GetParamAsuncStr returns ibs.th.file.asyncparam
      110   (input iParamName as character ):
      111      return mAsyncProc:GetPARAM(iParamName).
      112   end.
      113   procedure PutMesAsunc:
      114       define input  parameter Itext as character no-undo.
      115       define variable vflag as logical no-undo.
      116       Publish "WriteLogAsunc" (Itext, yes)  .
      117   end.
      118   procedure PutMesAsuncNoTime:
      119       define input  parameter Itext as character no-undo.
      120       define variable vflag as logical no-undo.
      121       Publish "WriteLogAsunc" (Itext,no)  .
      122   end.
      123   procedure PutStatAsunc:
      124       define input  parameter Itext as character no-undo.
      125       Publish "PutStatAsunc" (Itext,no) .
      126        run
      127       PutMesAsunc (itext).
      128   end.
      129   procedure PutStatAsuncNoTime:
      130       define input  parameter Itext as character no-undo.
      131       Publish "PutStatAsunc" (Itext,no)  .
      132        run
      133       PutMesAsuncNoTime (itext).
      134   end.
      135   procedure PutStatAsuncAdd:
      136       define input  parameter Itext as character no-undo.
      137       Publish "PutStatAsunc" (Itext,yes)  .
      138   end.
      139   procedure PutFileLogAsunc:
      140       define input  parameter IFile as character no-undo.
      141       Publish "PutFileLogAsunc" (ifile)  .
      142   end.
      143          mAsyncProc:mProcPublish = this-procedure.
      144   define variable mDebug as logical no-undo.
      145   mDebug = session:debug-alert.
      146   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   define variable mDiadocApi as component-handle no-undo.
      148   define variable mDiadocConnection as component-handle no-undo.
      149   define variable m-sys-key as character no-undo.
      150   define variable marpar-type as character no-undo.
      151   define variable mPublishHand as handle  no-undo.
      152   define variable mFlaftest as logical no-undo.
      153      create "Diadoc.DiadocClient":U mDiadocApi no-error.
      154   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      155   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      156   define variable mySeqUtd as int64 no-undo init ?.
      157   if mDiadocApi eq ?
      158   then do:
      159      if  log-manager:logfile-name ne ?
      160      then
      161         log-manager:write-message("Нет библиотеки Diadoc или не удалось создать объект Diadoc.DiadocClient", "EDOError").
      162   end.
      163   else do:
      164      if  log-manager:logfile-name ne ?
      165      then
      166         log-manager:write-message(substitute ("Версия библиотеки Diadoc &1" , mDiadocApi:GetFullVersion()) , "EDOError").
      167   end.
      168   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure gen-key-rec :
      170     define input  parameter p-tbl-name    as character no-undo.
      171     define input  parameter p-bh_tbl-name as handle    no-undo.
      172     define output parameter p-key-rec     as character no-undo.
      173     do
      174     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      175     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      176     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      177     :
      178       define variable fh               as handle    no-undo .
      179       define variable v-ok             as logical   no-undo .
      180       define variable v-inform         as character no-undo .
      181       define variable v-ind            as integer   no-undo .
      182       define variable v-idx-field-qnty as integer   no-undo .
      183       if p-tbl-name = ?
      184         or p-tbl-name = "":U
      185       then do:
      186         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      187       end.
      188       if not p-bh_tbl-name:available then do:
      189         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      190       end.
      191       assign
      192         p-key-rec = p-tbl-name
      193         v-inform  = p-bh_tbl-name:index-information(1)
      194         v-ind     = 2
      195       .
      196       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      197       on error undo, return error
      198       :
      199         assign
      200           v-inform = p-bh_tbl-name:index-information( v-ind )
      201           v-ind    = v-ind + 1
      202         .
      203       end.
      204       if v-inform = ?
      205         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      206         or entry( 3, v-inform, ",":U ) <> "1":U
      207       then do:
      208         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      209       end.
      210       else do:
      211         assign
      212           v-idx-field-qnty = num-entries( v-inform ) - 4
      213         .
      214         if v-idx-field-qnty < 2 then do:
      215           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      216         end.
      217         do v-ind = 1 to v-idx-field-qnty by 2
      218         on error undo, return error
      219         :
      220           assign
      221             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      222             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      223           .
      224         end.
      225       end.
      226       if p-key-rec = ? then do:
      227         assign
      228           p-key-rec = "":U
      229         .
      230         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      231       end.
      232     end.
      233     return.
      234   end procedure.
      235   procedure gen-where-keyr-tab :
      236     define input  parameter i-tableSerach as character no-undo.
      237     define input  parameter i-tablekey   as character  no-undo.
      238     define input  parameter p-key-rec    as character  no-undo.
      239     define input  parameter p-key-handle as handle     no-undo .
      240     define input  parameter p-db-name    as character  no-undo .
      241     define input  parameter p-tt-handle  as handle     no-undo .
      242     define output parameter o-Where      as character  no-undo.
      243     do
      244     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      245     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      246     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      247     :
      248       define variable v-full-tbl-name  as character no-undo .
      249       define variable bh_tbl-name      as handle    no-undo .
      250       define variable fh_key           as handle    no-undo .
      251       define variable fh_search        as handle    no-undo .
      252       define variable v-field-num      as integer   no-undo .
      253       define variable v-count-fld      as integer   no-undo .
      254       define variable v-inform         as character no-undo .
      255       define variable v-ind            as integer   no-undo .
      256       define variable v-idx-field-qnty as integer   no-undo .
      257       define variable v-field-name     as character no-undo .
      258       define variable v-field-val      as character no-undo .
      259       define variable v-word-link      as character no-undo .
      260       define variable vTable           as character no-undo.
      261       define variable bh_tbl-key       as handle    no-undo .
      262       assign
      263         p-key-rec = trim( p-key-rec )
      264       .
      265       if p-key-handle <> ? then do:
      266         if not valid-handle(p-key-handle)
      267            or p-key-handle:type <> "buffer"
      268         then do:
      269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      270         end.
      271         if num-entries( p-key-rec, chr(3) ) > 1
      272           or p-key-rec = ?
      273           or p-key-rec = "":U
      274         then do:
      275           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      276         end.
      277       end.
      278       else do:
      279         if p-key-rec = ?
      280           or p-key-rec = "":U
      281         then do:
      282           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      283         end.
      284       end.
      285       assign
      286         vTable = entry( 1 , p-key-rec, chr(3) )
      287       .
      288       if p-tt-handle <> ?
      289         and ( not valid-handle(p-tt-handle)
      290               or p-tt-handle:type <> "buffer"
      291             )
      292       then do:
      293         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      294       end.
      295       if p-tt-handle = ? then do:
      296         assign
      297           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      298         .
      299         create buffer bh_tbl-name for table v-full-tbl-name .
      300       end.
      301       else do:
      302         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      303       end.
      304       assign
      305         v-inform = bh_tbl-name:index-information(1)
      306         v-ind    = 2
      307       .
      308       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      309       on error undo, return error
      310       :
      311         assign
      312           v-inform = bh_tbl-name:index-information( v-ind )
      313           v-ind    = v-ind + 1
      314         .
      315       end.
      316       if v-inform = ?
      317         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      318         or entry( 3, v-inform, ",":U ) <> "1":U
      319       then do:
      320         delete object bh_tbl-name no-error.
      321         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      322       end.
      323       assign
      324         v-idx-field-qnty = num-entries( v-inform ) - 4
      325       .
      326       if v-idx-field-qnty < 2 then do:
      327         delete object bh_tbl-name no-error.
      328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      329       end.
      330       assign
      331         o-where     = "where":U
      332         v-word-link = "":U
      333         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      334         v-count-fld = 0
      335       .
      336       if i-tablekey ne "" and i-tablekey ne ?
      337       then do:
      338         assign
      339           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      340         .
      341         create buffer bh_tbl-key for table v-full-tbl-name .
      342       end.
      343       if i-tableSerach ne "" and i-tableSerach ne ?
      344       then do:
      345         delete object bh_tbl-name no-error.
      346         assign
      347           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      348         .
      349         create buffer bh_tbl-name for table v-full-tbl-name .
      350       end.
      351       block_where:
      352       do v-ind = 1 to v-idx-field-qnty by 2
      353       on error undo, return error
      354       :
      355         assign
      356           v-count-fld = v-count-fld + 1
      357         .
      358         if p-key-handle = ?
      359           and v-count-fld > v-field-num
      360         then do:
      361           leave block_where.
      362         end.
      363         define variable VfieldKeyTable as handle no-undo.
      364         assign
      365           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      366           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      367         .
      368         if     bh_tbl-key ne ?
      369         then do:
      370            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      371            if VfieldKeyTable eq ?
      372            then next block_where.
      373         end.
      374         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      375         then
      376            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      377         else
      378            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      379         if p-key-handle = ? then do:
      380           assign
      381             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      382           .
      383         end.
      384         else do:
      385           assign
      386             fh_key = p-key-handle:buffer-field( v-field-name )
      387           .
      388           if fh_key = ?
      389             or not valid-handle( fh_key )
      390           then do:
      391             delete object bh_tbl-name.
      392             if     bh_tbl-key ne ?
      393             then
      394                delete object bh_tbl-key.
      395             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      396           end.
      397           assign
      398             v-field-val = fh_key:buffer-value
      399           .
      400         end.
      401         if fh_search:data-type ="character":U then do:
      402           assign
      403             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      404             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      405             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      406             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      407             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      408             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      409             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      410             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      411             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      412             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      413             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      414             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      415             v-field-val = substitute( '"&1"', v-field-val )
      416           .
      417         end.
      418         assign
      419           o-where = substitute( "&1 &2", o-where, v-field-val )
      420         .
      421         if v-word-link = "":U then do:
      422           assign
      423             v-word-link = "and":U
      424           .
      425         end.
      426       end.
      427       delete object bh_tbl-name.
      428       if     bh_tbl-key ne ?
      429       then
      430          delete object bh_tbl-key.
      431       if p-key-handle = ?
      432         and v-count-fld <> v-field-num
      433       then do:
      434         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      435       end.
      436     end.
      437   end procedure.
      438   procedure gen-hn-keyr-tab :
      439     define input  parameter i-tableSerach as character no-undo.
      440     define input  parameter i-tablekey   as character no-undo.
      441     define input  parameter p-key-rec    as character no-undo.
      442     define input  parameter p-key-handle as handle    no-undo .
      443     define input  parameter p-db-name    as character no-undo .
      444     define input  parameter p-tt-handle  as handle    no-undo .
      445     define input  parameter p-stts-lock  as integer   no-undo .
      446     define output parameter o-hn         as handle    no-undo.
      447     define variable v-full-tbl-name as character no-undo.
      448     define variable v-where         as character no-undo.
      449     define variable bh_tbl-name     as handle    no-undo.
      450     define variable vTable          as character no-undo.
      451     do
      452     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      453     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      455         run gen-where-keyr-tab(i-tableSerach,
      456                                i-tablekey,
      457                                p-key-rec,
      458                                p-key-handle,
      459                                p-db-name,
      460                                p-tt-handle,
      461                                output v-where).
      462         if i-tableSerach ne "" and i-tableSerach ne ?
      463         then do:
      464            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      465            create buffer bh_tbl-name for table v-full-tbl-name .
      466         end.
      467         else do:
      468            if p-tt-handle = ? then do:
      469               assign
      470                  vTable = entry( 1 , p-key-rec, chr(3) )
      471               .
      472               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      473               create buffer bh_tbl-name for table v-full-tbl-name .
      474            end.
      475            else do:
      476               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      477            end.
      478         end.
      479         if p-tt-handle = ? then do:
      480            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      481         end.
      482         else do:
      483            bh_tbl-name:find-first( v-where ) no-error .
      484         end.
      485         o-hn = bh_tbl-name.
      486      end.
      487   end procedure.
      488   procedure gen-hn-keyr :
      489     define input  parameter p-key-rec    as character no-undo.
      490     define input  parameter p-key-handle as handle    no-undo .
      491     define input  parameter p-db-name    as character no-undo .
      492     define input  parameter p-tt-handle  as handle    no-undo .
      493     define input  parameter p-stts-lock  as integer   no-undo .
      494     define output parameter o-hn         as handle    no-undo.
      495     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      496   end.
      497   procedure gen-row-keyr :
      498     define input  parameter p-key-rec    as character no-undo.
      499     define input  parameter p-key-handle as handle    no-undo .
      500     define input  parameter p-db-name    as character no-undo .
      501     define input  parameter p-tt-handle  as handle    no-undo .
      502     define input  parameter p-stts-lock  as integer   no-undo .
      503     define output parameter p-tbl-row    as rowid     no-undo.
      504     define output parameter p-tbl-name   as character no-undo.
      505     define variable vHn as handle no-undo.
      506       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      507       p-tbl-row = if vHn:available then vHn:rowid else ?.
      508       p-tbl-name =  vHn:table.
      509       delete object vHn no-error.
      510     if p-tbl-row = ? then do:
      511       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      512     end.
      513     else do:
      514       return.
      515     end.
      516   end procedure.
      517   procedure gen-key-fv :
      518     define input  parameter p-key-rec    as character no-undo .
      519     define output parameter p-field-list as character no-undo .
      520     define output parameter p-value-list as character no-undo.
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      525     :
      526       define variable v-full-tbl-name  as character no-undo .
      527       define variable bh_tbl-name      as handle    no-undo .
      528       define variable v-tbl-name       as character no-undo .
      529       define variable v-field-num      as integer   no-undo .
      530       define variable v-count-fld      as integer   no-undo .
      531       define variable v-inform         as character no-undo .
      532       define variable v-ind            as integer   no-undo .
      533       define variable v-idx-field-qnty as integer   no-undo .
      534       define variable v-delim-key      as character no-undo .
      535       if p-key-rec = ?
      536         or p-key-rec = "":U
      537       then do:
      538         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      539       end.
      540       assign
      541         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      542         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      543       .
      544       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      545       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      546       assign
      547         v-inform = bh_tbl-name:index-information(1)
      548         v-ind    = 2
      549       .
      550       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      551       on error undo, return error
      552       :
      553         assign
      554           v-inform = bh_tbl-name:index-information( v-ind )
      555           v-ind    = v-ind + 1
      556         .
      557       end.
      558       if v-inform = ?
      559         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      560         or entry( 3, v-inform, ",":U ) <> "1":U
      561       then do:
      562         delete object bh_tbl-name no-error.
      563         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      564       end.
      565       assign
      566         v-idx-field-qnty = num-entries( v-inform ) - 4
      567       .
      568       if v-idx-field-qnty < 2 then do:
      569         delete object bh_tbl-name no-error.
      570         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      571       end.
      572       assign
      573         p-field-list = "":U
      574         p-value-list = "":U
      575         v-delim-key  = "":U
      576         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      577         v-count-fld  = 0
      578       .
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         if v-count-fld > v-field-num then do:
      587           leave block_where.
      588         end.
      589         assign
      590           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      591           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      592         .
      593         if v-ind = 1 then do:
      594           assign
      595             v-delim-key = chr(3)
      596           .
      597         end.
      598       end.
      599       delete object bh_tbl-name.
      600       if v-count-fld <> v-field-num then do:
      601         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      602       end.
      603     end.
      604   end procedure.
      605   procedure gen-key-field :
      606     define input  parameter p-table      as character no-undo .
      607     define output parameter p-field-list as character no-undo .
      608     do
      609     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      610     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      611     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      612     :
      613       define variable v-full-tbl-name  as character no-undo .
      614       define variable bh_tbl-name      as handle    no-undo .
      615       define variable v-tbl-name       as character no-undo .
      616       define variable v-field-num      as integer   no-undo .
      617       define variable v-count-fld      as integer   no-undo .
      618       define variable v-inform         as character no-undo .
      619       define variable v-ind            as integer   no-undo .
      620       define variable v-idx-field-qnty as integer   no-undo .
      621       define variable v-delim-key      as character no-undo .
      622       if p-table = ?
      623         or p-table = "":U
      624       then do:
      625         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      626       end.
      627       assign
      628         v-tbl-name      = p-table
      629         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      630       .
      631       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      632       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      633       assign
      634         v-inform = bh_tbl-name:index-information(1)
      635         v-ind    = 2
      636       .
      637       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      638       on error undo, return error
      639       :
      640         assign
      641           v-inform = bh_tbl-name:index-information( v-ind )
      642           v-ind    = v-ind + 1
      643         .
      644       end.
      645       if v-inform = ?
      646         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      647         or entry( 3, v-inform, ",":U ) <> "1":U
      648       then do:
      649         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      650       end.
      651       assign
      652         v-idx-field-qnty = num-entries( v-inform ) - 4
      653       .
      654       if v-idx-field-qnty < 2 then do:
      655         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      656       end.
      657       assign
      658         p-field-list = "":U
      659         v-delim-key  = "":U
      660         v-count-fld  = 0
      661       .
      662       block_where:
      663       do v-ind = 1 to v-idx-field-qnty by 2
      664       on error undo, return error
      665       :
      666         assign
      667           v-count-fld = v-count-fld + 1
      668         .
      669         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      670         if v-ind = 1 then do:
      671           assign
      672             v-delim-key = chr(3)
      673           .
      674         end.
      675       end.
      676       delete object bh_tbl-name.
      677     end.
      678   end procedure.
      679   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   function getattrUtdex returns char
      681   (idb-num   as integer,
      682    idoc-id   as integer,
      683    iattrcode as character,
      684    iExValue  as character  ):
      685      define buffer utd-attr for utd-attr.
      686      find first utd-attr where utd-attr.db-num eq idb-num
      687                            and utd-attr.doc-id eq idoc-id
      688                            and utd-attr.attr-code eq iattrcode
      689      no-lock no-error.
      690      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      691   end.
      692   function getattrUtd returns char
      693   (idb-num   as integer,
      694    idoc-id   as integer,
      695    iattrcode as character ):
      696     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      697   end.
      698   function setattrUtd returns logical
      699   (idb-num   as integer,
      700    idoc-id   as integer,
      701    iattrcode as character,
      702    iattrval  as character ):
      703      define buffer utd-attr for utd-attr.
      704      find first utd-attr where utd-attr.db-num eq idb-num
      705                            and utd-attr.doc-id eq idoc-id
      706                            and utd-attr.attr-code eq iattrcode
      707      no-lock no-error.
      708      if not available utd-attr
      709      then do:
      710         create utd-attr.
      711         assign
      712            utd-attr.db-num    = idb-num
      713            utd-attr.doc-id    = idoc-id
      714            utd-attr.attr-code = iattrcode
      715            utd-attr.attr-value = iattrval
      716         .
      717      end.
      718      else do:
      719         if utd-attr.attr-value ne iattrval
      720         then do:
      721            find current utd-attr exclusive-lock no-error.
      722            if available utd-attr
      723            then
      724               utd-attr.attr-value = iattrval.
      725         end.
      726      end.
      727      release utd-attr.
      728   end.
      729   function GetAttrUtdlinesEx returns char
      730   (idb-num   as integer,
      731    idoc-id   as integer,
      732    ilinenum  as integer,
      733    iattrcode as character,
      734    iExValue  as character  ):
      735      define buffer utd-lines-attr for utd-lines-attr.
      736      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      737                                  and utd-lines-attr.doc-id    eq idoc-id
      738                                  and utd-lines-attr.lineNum   eq ilineNum
      739                                  and utd-lines-attr.attr-code eq iattrcode
      740      no-lock no-error.
      741      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      742   end.
      743   function GetAttrUtdlines returns char
      744   (idb-num   as integer,
      745    idoc-id   as integer,
      746    ilinenum  as integer,
      747    iattrcode as character ):
      748      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      749   end.
      750   function setattrUtdlines returns logical
      751   (idb-num   as integer,
      752    idoc-id   as integer,
      753    ilinenum  as integer,
      754    iattrcode as character,
      755    iattrval  as character ):
      756      define buffer utd-lines-attr for utd-lines-attr.
      757      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      758                                  and utd-lines-attr.doc-id    eq idoc-id
      759                                  and utd-lines-attr.lineNum   eq ilineNum
      760                                  and utd-lines-attr.attr-code eq iattrcode
      761      no-lock no-error.
      762      if not available utd-lines-attr
      763      then do:
      764         if iattrval ne ?
      765            and iattrval ne ""
      766         then do:
      767            create utd-lines-attr.
      768            assign
      769               utd-lines-attr.db-num    = idb-num
      770               utd-lines-attr.doc-id    = idoc-id
      771               utd-lines-attr.lineNum   = ilineNum
      772               utd-lines-attr.attr-code = iattrcode
      773               utd-lines-attr.attr-value = iattrval
      774            .
      775         end.
      776      end.
      777      else do:
      778         if utd-lines-attr.attr-value ne iattrval
      779         then do:
      780            find current utd-lines-attr exclusive-lock no-error.
      781            if available utd-lines-attr
      782            then do:
      783               if    iattrval eq ?
      784                  or iattrval eq ""
      785               then do:
      786                  delete utd-lines-attr.
      787               end.
      788               else do:
      789                  utd-lines-attr.attr-value = iattrval.
      790               end.
      791            end.
      792         end.
      793      end.
      794      release utd-lines-attr.
      795   end.
      796   function GetAttrUtdMarkingLinesEx returns char
      797   (idb-num   as integer,
      798    idoc-id   as integer,
      799    ilinenum  as integer,
      800    imark     as character,
      801    iattrcode as character,
      802    iExValue  as character  ):
      803      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      804      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      805                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      806                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      807                                          and utd-marking-lines-attr.mark      eq imark
      808                                          and utd-marking-lines-attr.attr-code eq iattrcode
      809      no-lock no-error.
      810      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      811   end.
      812   function GetAttrUtdMarkingLines returns char
      813   (idb-num   as integer,
      814    idoc-id   as integer,
      815    ilinenum  as integer,
      816    imark     as character,
      817    iattrcode as character ):
      818      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      819   end.
      820   function setattrUtdMarkingLines returns logical
      821   (idb-num   as integer,
      822    idoc-id   as integer,
      823    ilinenum  as integer,
      824    imark     as character,
      825    iattrcode as character,
      826    iattrval  as character ):
      827      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      828      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      829                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      830                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      831                                          and utd-marking-lines-attr.mark      eq imark
      832                                          and utd-marking-lines-attr.attr-code eq iattrcode
      833      no-lock no-error.
      834      if not available utd-marking-lines-attr
      835      then do:
      836         if iattrval ne ?
      837            and iattrval ne ""
      838         then do:
      839            create utd-marking-lines-attr.
      840            assign
      841               utd-marking-lines-attr.db-num     = idb-num
      842               utd-marking-lines-attr.doc-id     = idoc-id
      843               utd-marking-lines-attr.lineNum    = ilineNum
      844               utd-marking-lines-attr.mark       = imark
      845               utd-marking-lines-attr.attr-code  = iattrcode
      846               utd-marking-lines-attr.attr-value = iattrval
      847            .
      848         end.
      849      end.
      850      else do:
      851         if utd-marking-lines-attr.attr-value ne iattrval
      852         then do:
      853            find current utd-marking-lines-attr exclusive-lock no-error.
      854            if available utd-marking-lines-attr
      855            then do:
      856               if    iattrval eq ?
      857                  or iattrval eq ""
      858               then do:
      859                  delete utd-marking-lines-attr.
      860               end.
      861               else do:
      862                  utd-marking-lines-attr.attr-value = iattrval.
      863               end.
      864            end.
      865         end.
      866      end.
      867      release utd-marking-lines-attr.
      868   end.
      869   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   define new global shared variable g#attr-lib  as handle no-undo .
      871   define variable v-attr-lib-variable as handle no-undo .
      872   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   define variable vss-include-info7 as character format "X(65)" no-undo
      875   initial "@(#)$Workfile$ $Revision$".
      876   procedure xmlchar-test :
      877   define input parameter p-in-string          as character        no-undo.
      878   define output parameter p-out-string-enc    as character        no-undo.
      879   define output parameter p-out-string-dec    as character        no-undo.
      880   do
      881   on error undo, return error
      882   :
      883          run xmlchar-encode in this-procedure
      884       (
      885             input p-in-string
      886           , output p-out-string-enc
      887       ).
      888          run xmlchar-decode in this-procedure
      889       (
      890             input p-out-string-enc
      891           , output p-out-string-dec
      892       ).
      893   end.
      894   end .
      895   procedure xmlchar-encode :
      896   define input parameter p-in-string      as character        no-undo.
      897   define output parameter p-out-string    as character        no-undo.
      898       define variable v-position      as integer      no-undo.
      899       define variable v-current-char  as character    no-undo.
      900   do
      901   on error undo, return error
      902   :
      903       assign
      904           p-out-string = "":U
      905       .
      906       case p-in-string
      907       :
      908           when ?
      909           then do:
      910               assign
      911                   p-out-string = "?":U
      912               .
      913           end.
      914           when "?":U
      915           then do:
      916               assign
      917                   p-out-string = "&#63;":U
      918               .
      919           end.
      920           otherwise do:
      921               do v-position = 1 to length( p-in-string )
      922               :
      923                   assign
      924                       v-current-char = substring( p-in-string, v-position, 1 )
      925                   .
      926                   case v-current-char
      927                   :
      928                       when "&":U
      929                       then do:
      930                           assign
      931                               p-out-string = p-out-string + "&amp;":U
      932                           .
      933                       end.
      934                       when ">":U
      935                       then do:
      936                           assign
      937                               p-out-string = p-out-string + "&gt;":U
      938                           .
      939                       end.
      940                       when "<":U
      941                       then do:
      942                           assign
      943                               p-out-string = p-out-string + "&lt;":U
      944                           .
      945                       end.
      946                       when "'":U
      947                       then do:
      948                           assign
      949                               p-out-string = p-out-string + "&apos;":U
      950                           .
      951                       end.
      952                       when '"':U
      953                       then do:
      954                           assign
      955                               p-out-string = p-out-string + "&quot;":U
      956                           .
      957                       end.
      958                       when chr(1)
      959                       then do:
      960                           assign
      961                               p-out-string = p-out-string + "":U
      962                           .
      963                       end.
      964                       when chr(2)
      965                       then do:
      966                           assign
      967                               p-out-string = p-out-string + "":U
      968                           .
      969                       end.
      970                       when chr(3)
      971                       then do:
      972                           assign
      973                               p-out-string = p-out-string + "":U
      974                           .
      975                       end.
      976                       when chr(4)
      977                       then do:
      978                           assign
      979                               p-out-string = p-out-string + "":U
      980                           .
      981                       end.
      982                       when chr(5)
      983                       then do:
      984                           assign
      985                               p-out-string = p-out-string + "":U
      986                           .
      987                       end.
      988                       when chr(6)
      989                       then do:
      990                           assign
      991                               p-out-string = p-out-string + "":U
      992                           .
      993                       end.
      994                       when chr(7)
      995                       then do:
      996                           assign
      997                               p-out-string = p-out-string + "":U
      998                           .
      999                       end.
     1000                       when chr(8)
     1001                       then do:
     1002                           assign
     1003                               p-out-string = p-out-string + "":U
     1004                           .
     1005                       end.
     1006                       when chr(9)
     1007                       then do:
     1008                           assign
     1009                               p-out-string = p-out-string + "":U
     1010                           .
     1011                       end.
     1012                       when chr(29)
     1013                       then do:
     1014                           assign
     1015                               p-out-string = p-out-string + "":U
     1016                           .
     1017                       end.
     1018                       when chr(10)
     1019                       then do:
     1020                           assign
     1021                               p-out-string = p-out-string + "&#10;":U
     1022                           .
     1023                       end.
     1024                       when chr(13)
     1025                       then do:
     1026                           assign
     1027                               p-out-string = p-out-string + "&#13;":U
     1028                           .
     1029                       end.
     1030                       otherwise do:
     1031                           assign
     1032                               p-out-string = p-out-string + v-current-char
     1033                           .
     1034                       end.
     1035                   end case.
     1036               end.
     1037           end.
     1038       end case.
     1039   end.
     1040   end .
     1041   procedure xmlchar-encode-1c :
     1042   define input parameter p-in-string      as character        no-undo.
     1043   define output parameter p-out-string    as character        no-undo.
     1044       define variable v-position      as integer      no-undo.
     1045       define variable v-current-char  as character    no-undo.
     1046   do
     1047   on error undo, return error
     1048   :
     1049       assign
     1050           p-out-string = "":U
     1051       .
     1052       case p-in-string
     1053       :
     1054           when ?
     1055           then do:
     1056               assign
     1057                   p-out-string = "?":U
     1058               .
     1059           end.
     1060           otherwise do:
     1061               do v-position = 1 to length( p-in-string )
     1062               :
     1063                   assign
     1064                       v-current-char = substring( p-in-string, v-position, 1 )
     1065                   .
     1066                   case v-current-char
     1067                   :
     1068                       when chr(1)
     1069                       then do:
     1070                           assign
     1071                               p-out-string = p-out-string + " ":U
     1072                           .
     1073                       end.
     1074                       when chr(2)
     1075                       then do:
     1076                           assign
     1077                               p-out-string = p-out-string + " ":U
     1078                           .
     1079                       end.
     1080                       when chr(3)
     1081                       then do:
     1082                           assign
     1083                               p-out-string = p-out-string + " ":U
     1084                           .
     1085                       end.
     1086                       when chr(4)
     1087                       then do:
     1088                           assign
     1089                               p-out-string = p-out-string + " ":U
     1090                           .
     1091                       end.
     1092                       when chr(5)
     1093                       then do:
     1094                           assign
     1095                               p-out-string = p-out-string + " ":U
     1096                           .
     1097                       end.
     1098                       when chr(6)
     1099                       then do:
     1100                           assign
     1101                               p-out-string = p-out-string + " ":U
     1102                           .
     1103                       end.
     1104                       when chr(7)
     1105                       then do:
     1106                           assign
     1107                               p-out-string = p-out-string + " ":U
     1108                           .
     1109                       end.
     1110                       when chr(8)
     1111                       then do:
     1112                           assign
     1113                               p-out-string = p-out-string + " ":U
     1114                           .
     1115                       end.
     1116                       when chr(9)
     1117                       then do:
     1118                           assign
     1119                               p-out-string = p-out-string + " ":U
     1120                           .
     1121                       end.
     1122                       when chr(29)
     1123                       then do:
     1124                           assign
     1125                               p-out-string = p-out-string + " ":U
     1126                           .
     1127                       end.
     1128                       when chr(10)
     1129                       then do:
     1130                           assign
     1131                               p-out-string = p-out-string + " ":U
     1132                           .
     1133                       end.
     1134                       when chr(13)
     1135                       then do:
     1136                           assign
     1137                               p-out-string = p-out-string + " ":U
     1138                           .
     1139                       end.
     1140                       otherwise do:
     1141                           assign
     1142                               p-out-string = p-out-string + v-current-char
     1143                           .
     1144                       end.
     1145                   end case.
     1146               end.
     1147           end.
     1148       end case.
     1149   end.
     1150   end .
     1151   procedure xmlchar-decode :
     1152   define input parameter p-in-string      as character        no-undo.
     1153   define output parameter p-out-string    as character        no-undo.
     1154       define variable v-position      as integer      no-undo.
     1155       define variable v-last-position as integer      no-undo.
     1156       define variable v-temp-integer  as integer      no-undo.
     1157       define variable v-current-char  as character    no-undo.
     1158       define variable v-next-char     as character    no-undo.
     1159       define variable v-success       as logical      no-undo.
     1160   do
     1161   on error undo, return error
     1162   :
     1163       assign
     1164           p-out-string = "":U
     1165           v-position   = 0
     1166       .
     1167       replace-cycle:
     1168       do while yes
     1169       on error undo, return error
     1170       :
     1171           assign
     1172               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1173           .
     1174           if v-last-position <= v-position
     1175           then do:
     1176               if v-position = 0
     1177               then do:
     1178                   assign
     1179                       p-out-string = p-in-string
     1180                   .
     1181               end.
     1182               else do:
     1183                   assign
     1184                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1185                   .
     1186               end.
     1187               leave replace-cycle.
     1188           end.
     1189           else do:
     1190               assign
     1191                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1192                   v-position      = v-last-position
     1193                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1194               .
     1195               if v-current-char = "#":U
     1196               then do:
     1197                   assign
     1198                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1199                   .
     1200                   if v-last-position > 0
     1201                   then do:
     1202                       run xmlchar-read-integer in this-procedure
     1203                        (
     1204                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1205                           , output v-temp-integer
     1206                           , output v-success
     1207                       ).
     1208                       if v-success = yes
     1209                       and v-temp-integer >= 1
     1210                       and v-temp-integer <= 255
     1211                       then do:
     1212                           assign
     1213                               p-out-string = p-out-string + chr( v-temp-integer )
     1214                               v-position   = v-last-position + 1
     1215                           .
     1216                       end.
     1217                       else do:
     1218                           assign
     1219                               p-out-string = p-out-string + "&":U
     1220                               v-position   = v-position   + 1
     1221                           .
     1222                       end.
     1223                   end.
     1224                   else do:
     1225                       assign
     1226                           p-out-string = p-out-string + "&":U
     1227                           v-position   = v-position   + 1
     1228                       .
     1229                   end.
     1230               end.
     1231               else do:
     1232                   case substring( p-in-string, v-position + 1, 3 )
     1233                   :
     1234                       when "lt;":U
     1235                       then do:
     1236                           assign
     1237                               p-out-string = p-out-string + "<":U
     1238                               v-position   = v-position   + 3
     1239                           .
     1240                       end.
     1241                       when "gt;":U
     1242                       then do:
     1243                           assign
     1244                               p-out-string = p-out-string + ">":U
     1245                               v-position   = v-position   + 3
     1246                           .
     1247                       end.
     1248                       otherwise do:
     1249                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1250                           then do:
     1251                               assign
     1252                                   p-out-string = p-out-string + "&":U
     1253                                   v-position   = v-position   + 4
     1254                               .
     1255                           end.
     1256                           else do:
     1257                               case substring( p-in-string, v-position + 1, 5 )
     1258                               :
     1259                                   when "quot;":U
     1260                                   then do:
     1261                                       assign
     1262                                           p-out-string = p-out-string + '"':U
     1263                                           v-position   = v-position   + 5
     1264                                       .
     1265                                   end.
     1266                                   when "apos;":U
     1267                                   then do:
     1268                                       assign
     1269                                           p-out-string = p-out-string + "'":U
     1270                                           v-position   = v-position   + 5
     1271                                       .
     1272                                   end.
     1273                                   otherwise do:
     1274                                       assign
     1275                                           p-out-string = p-out-string + "&":U
     1276                                       .
     1277                                   end.
     1278                               end case.
     1279                           end.
     1280                       end.
     1281                   end case.
     1282               end.
     1283           end.
     1284       end.
     1285   end.
     1286   end .
     1287   procedure xmlchar-read-integer :
     1288   define input parameter p-input-string      as character        no-undo.
     1289   define output parameter p-output-integer   as integer          no-undo.
     1290   define output parameter p-success       as logical          no-undo.
     1291   do
     1292   on error undo, return error
     1293   :
     1294       assign
     1295           p-output-integer = integer( p-input-string )
     1296       no-error.
     1297       if error-status :error
     1298       then do:
     1299           assign
     1300               p-success           = no
     1301               p-output-integer    = 0
     1302           .
     1303       end.
     1304       else do:
     1305           assign
     1306               p-success           = yes
     1307           .
     1308       end.
     1309   end.
     1310   end.
     1311   define variable mMRCCode  as logical    no-undo.
     1312   define variable mTypeMark as character  no-undo.
     1313   function IS-NeedMark returns logical
     1314   ( input ib-code as integer  ,
     1315     input ib-str as character ):
     1316      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1317      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1318                                    and buf_prod-bc-attr.b-str  eq ib-str
     1319                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1320        no-lock no-error.
     1321      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1322   end.
     1323   function repTegforDm return char
     1324   (iDM as char ):
     1325       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1326       define variable vteg as character no-undo.
     1327       define variable oDM as character no-undo.
     1328       define variable vi as integer no-undo.
     1329       oDM = iDm.
     1330       do vi = 1 to num-entries(vTeglist):
     1331          vTeg = entry(vi,vTeglist).
     1332          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1333       end.
     1334       return oDM.
     1335   end.
     1336   function repSpecSimbforDm return char
     1337   (iDM as char ):
     1338       define variable oDM as character no-undo.
     1339     run
     1340       xmlchar-decode(iDM, output oDM).
     1341     return repTegforDm (oDM).
     1342   end.
     1343   function CheckGtin return logical
     1344   (iGtin as char):
     1345      define variable bar_code as character no-undo.
     1346      define variable vGtin as logical no-undo init "yes".
     1347      if length(iGtin) eq 14
     1348      then do:
     1349         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1350         run str/chk-sum.p
     1351          (input-output bar_code ) no-error .
     1352         if iGtin ne  bar_code
     1353         then
     1354            vGtin = no.
     1355      end.
     1356      else
     1357         vGtin = no.
     1358      return vgtin.
     1359   end.
     1360   function repSpecSimbforXlm return char
     1361   (iDM as char ):
     1362       iDM = replace(iDM,chr(29),"").
     1363       return iDM.
     1364   end.
     1365   function getGtinByDM return char
     1366   (IDM as char):
     1367      define variable VTXT as char no-undo.
     1368      define variable vGtin as char no-undo.
     1369      vTXt = IdM.
     1370      vGtin = IDM.
     1371      if    length(vtxt) > 14
     1372      then do:
     1373         if   vtxt begins "(01)"
     1374                or vtxt begins "(02)"
     1375         then
     1376            vGtin = substring(vtxt,5,14).
     1377         else if   (vtxt begins "01"
     1378                or vtxt begins "02" )
     1379                and (   (    substring(iDm,17,2) eq "21"
     1380                         and length(vtxt) >= 21)
     1381                     or substring(iDm,17,2) eq "37"
     1382                     or substring(iDm,17,4) eq "(37)" )
     1383         then do:
     1384            vGtin = substring(vtxt,3,14).
     1385            if not checkGtin(vGtin)
     1386            then
     1387               vGtin = substring(vtxt,1,14).
     1388         end.
     1389         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1390             or length(vtxt) eq 14 + 7 + 4
     1391             or length(vtxt) eq 14 + 7
     1392         then
     1393            vGtin = substring(vtxt,1,14).
     1394      end.
     1395      if not checkGtin(vGtin)
     1396      then
     1397         vGtin = "".
     1398      return vgtin.
     1399   end.
     1400   function getGdsCodeByGtin return int
     1401   (iGtin as char):
     1402      define buffer prod-bc  for ub.prod-bc.
     1403      define buffer bar-code for ub.bar-code.
     1404      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1405      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1406      return if avail bar-code then bar-code.gds-code else ?.
     1407   end.
     1408   function getQntyCodeByGtin return decimal
     1409   (iGtin as char):
     1410      define buffer prod-bc  for ub.prod-bc.
     1411      define buffer bar-code for ub.bar-code.
     1412      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1413      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1414      return if avail bar-code then bar-code.cli-base-rate else ?.
     1415   end.
     1416   function getGdsCodeByDM return int
     1417   (iDm as char):
     1418      define variable vGtin as char no-undo.
     1419      define buffer prod-bc for ub.prod-bc.
     1420      vGtin  = getGtinByDM (IDM ).
     1421      return getGdsCodeByGtin (vGtin).
     1422   end.
     1423   function ChekTypeMarkByGds return logical
     1424   (iGds-code as integer ):
     1425      define buffer goods-attr for ub.goods-attr.
     1426      find first goods-attr where goods-attr.gds-code   = iGds-code
     1427                              and goods-attr.attr-code  = 'mark-type':U
     1428      no-lock no-error.
     1429      if available goods-attr
     1430      then do:
     1431         mTypeMark = goods-attr.attr-value.
     1432         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1433           .
     1434      end.
     1435      else
     1436         return no.
     1437   end.
     1438   function ChekTypeMarkByDm return logical
     1439   (iDM as char ):
     1440      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1441   end.
     1442   function ChekTypeMarkByGtin return logical
     1443   (iGtin as char ):
     1444      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1445   end.
     1446   function GetNextElement return character
     1447     (input iAllTeg        as logical
     1448     ,output oteg          as character
     1449     ,output otegval       as character
     1450     ,input-output pstr    as character
     1451      ):
     1452        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1453        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1454        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1455        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1456        define variable vTeg as character no-undo.
     1457        define variable vLength as integer no-undo.
     1458        define variable vi as integer no-undo.
     1459        define variable vj as integer no-undo.
     1460        define buffer code for ub.code.
     1461        find first code where Code.parent eq "MarkType"
     1462                          and Code.CodeValue   eq mTypeMark
     1463                          no-lock no-error.
     1464        if     available code
     1465           and Code.misc1 ne ""
     1466           and Code.misc1 ne ?
     1467        then do:
     1468           integer (Code.misc1) no-error.
     1469           if not error-status:error
     1470           then
     1471             entry (4,vlistleng) = Code.misc1.
     1472        end.
     1473        if iAllTeg
     1474        then
     1475           assign
     1476              vlistElem     = vlistElem    + vlistElemDop
     1477              vlistleng     = vlistleng    + vlistlengDop
     1478           .
     1479        else if mMRCCode
     1480        then
     1481           assign
     1482              vlistElem     = vlistElem    + ",(8005),8005"
     1483              vlistleng     = vlistleng    + ",000006,0006"
     1484           .
     1485       block-elem:
     1486       do vi = 1 to num-entries(vlistElem):
     1487          vTeg = entry(vi,vlistElem).
     1488          if pstr begins vTeg
     1489          then do:
     1490             if    vTeg eq "21"
     1491             then
     1492                vLength = index(pstr,chr(29)) - 2 no-error.
     1493             if vLength  <= 0
     1494             then
     1495                vLength = int(entry(vi,vlistleng)).
     1496             otegval = substring (pstr,length(vteg) + 1, vLength).
     1497             oteg = replace(replace(vteg,")",""),"(","").
     1498             vTeg = vteg + otegval.
     1499             otegval = replace(otegval,chr(29),"").
     1500             oteg = replace(replace(oteg,")",""),"(","").
     1501             pstr = substring (pstr,length(vTeg)+ 1).
     1502             vTeg = replace(vTeg,chr(29),"").
     1503             leave block-elem.
     1504          end.
     1505          else
     1506             vTeg = "".
     1507       end.
     1508       return vteg.
     1509   end.
     1510   function GetCodeIdent return character
     1511   (iDm as char):
     1512      define variable Velement   as character no-undo init "first".
     1513      define variable oCodeIdent as character no-undo.
     1514      define variable vteg as character no-undo.
     1515      define variable vtegval as character no-undo.
     1516      define variable vGtin as character no-undo.
     1517      define buffer marking for ub.marking.
     1518      for first marking no-lock where
     1519                marking.mark eq iDm
     1520            and marking.unit-ext = "LEVEL2"
     1521      :
     1522        return iDm.
     1523      end.
     1524      vGtin  = getGtinByDM (iDm ).
     1525      ChekTypeMarkByDm(idm).
     1526      if iDm begins 'tech_':U
     1527      then
     1528         oCodeIdent = iDm.
     1529      else if length(iDm) < 21
     1530      then do:
     1531         find first marking where marking.mark eq idm
     1532         no-lock no-error.
     1533         oCodeIdent = if available marking then marking.mark else  ?.
     1534      end.
     1535      else if     length(iDm) eq 29
     1536         and not iDm begins "01"
     1537         and not iDm begins "02"
     1538      then
     1539         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1540      else  if     length(iDm) >= 24
     1541               and (  iDm begins "01"
     1542                   or iDm begins "02")
     1543               and  substring(iDm,17,2) ne "21"
     1544      then do:
     1545         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1546                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1547         then
     1548            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1549         else
     1550            oCodeIdent = iDM.
     1551      end.
     1552      else  if     (   length(iDm) eq 25
     1553                    or length(iDm) eq 21)
     1554               and (not iDm begins "01"
     1555               and  not iDm begins "02")
     1556      then
     1557         oCodeIdent = substring(iDm,1,21).
     1558      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1559      then
     1560         oCodeIdent = substring(iDm,1,21).
     1561      else do while Velement ne "" and idm ne "":
     1562         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1563         oCodeIdent = oCodeIdent + Velement.
     1564      end.
     1565      return oCodeIdent.
     1566   end.
     1567   function GetTegCod return character
     1568   (icodeIdent as char, iTeg as char):
     1569      define variable Velement   as character no-undo init "first".
     1570      define variable oTeg as character no-undo init ?.
     1571      define variable vteg as character no-undo.
     1572      define variable vtegval as character no-undo.
     1573      if     ((length(icodeIdent) eq 21
     1574         and not icodeIdent begins "01"
     1575         and not icodeIdent begins "02")
     1576         or
     1577             ( length(icodeIdent) eq 25
     1578               and not icodeIdent begins "01"
     1579               and not icodeIdent begins "02"))
     1580      then do:
     1581         if iTeg eq "01" or iTeg eq "02"
     1582         then
     1583            oTeg = substring(icodeIdent,1,21).
     1584         else  if  iTeg eq "21"
     1585         then
     1586            oTeg = substring(icodeIdent,15,7).
     1587      end.
     1588      else do:
     1589         ChekTypeMarkByDm(icodeIdent).
     1590         block-teg:
     1591            do while Velement ne "" and icodeIdent ne "":
     1592            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1593            if    Velement begins iTeg
     1594               or Velement begins "(" + iTeg + ")"
     1595            then do:
     1596               oTeg = vtegval.
     1597               leave block-teg.
     1598            end.
     1599         end.
     1600      end.
     1601      return oTeg.
     1602   end.
     1603   function isOAD return logical
     1604   (icodeIdent as character):
     1605      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1606   end.
     1607   function isMark return logical
     1608   (icodeIdent as character):
     1609      define buffer buf_marking for ub.marking.
     1610      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1611             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1612   end.
     1613   function addBracketForCode return character
     1614   (icodeIdent as char):
     1615      define variable Velement   as character no-undo init "first".
     1616      define variable oTeg as character no-undo.
     1617      define variable vteg as character no-undo.
     1618      define variable vtegval as character no-undo.
     1619      define buffer marking for ub.marking.
     1620      find first marking no-lock where
     1621                 marking.mark begins icodeIdent no-error.
     1622      if    not ChekTypeMarkByDm(icodeIdent)
     1623         or length(icodeIdent) le 24
     1624         or (avail marking and marking.unit-ext = "LEVEL2")
     1625      then
     1626         oTeg = icodeIdent.
     1627      else do:
     1628         if (  icodeIdent begins "01"
     1629            or icodeIdent begins "02"
     1630            ) and CheckGtin(substring (icodeIdent,3,14))
     1631            and substring (icodeIdent,17,2) eq "21"
     1632         then do:
     1633            mMRCCode = yes.
     1634            ChekTypeMarkByDm(icodeIdent).
     1635            block-teg:
     1636            do while Velement ne "" and icodeIdent ne "":
     1637               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1638               if vteg ne ""
     1639               then
     1640                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1641            end.
     1642            mMRCCode = no.
     1643         end.
     1644         else do:
     1645            oTeg = icodeIdent.
     1646         end.
     1647      end.
     1648      return oTeg.
     1649   end.
     1650   function getlevelByCodId return int
     1651   (iCode as char):
     1652      define variable vLength as int no-undo.
     1653      define variable vLevel  as int no-undo.
     1654      if not ChekTypeMarkByDM (icode) then return ?.
     1655      vLength = length(iCode).
     1656      if    vLength eq 18
     1657         or vLength eq 20
     1658      then
     1659         Vlevel = 4.
     1660      else if vLength eq 21
     1661      then
     1662         Vlevel = 1.
     1663      else if vLength eq 25
     1664      then do:
     1665         if  iCode begins "01"
     1666         then
     1667            Vlevel = 3.
     1668         else
     1669            Vlevel = 1.
     1670      end.
     1671      else if     vLength >= 26
     1672              and vLength <= 46
     1673      then do:
     1674         if    substring(iCode,17,2) eq "11"
     1675            or substring(iCode,17,2) eq "13"
     1676            or (    substring(iCode,17,2) eq "21"
     1677                and vLength >= 33
     1678                and substring(iCode,26,4) ne "8005")
     1679         then
     1680            Vlevel = 4.
     1681         else if    vLength eq 31
     1682                 or vLength eq 38
     1683                 or vLength eq 39
     1684                 or vLength eq 45
     1685         then
     1686            Vlevel = 1.
     1687         else if    vLength eq 35
     1688                 or vLength eq 43
     1689         then
     1690            Vlevel = 3.
     1691         else
     1692            Vlevel = ?.
     1693      end.
     1694      else
     1695         Vlevel = ?.
     1696      return Vlevel.
     1697   end.
     1698   function getLevelMotpBycodid return character
     1699   (iDm as char):
     1700      define variable vLevel as integer no-undo.
     1701      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1702      vLevel = getlevelByCodId(iDm).
     1703      if    vLevel eq ?
     1704         or vLevel < 1
     1705         or vLevel > 6
     1706      then
     1707         return ?.
     1708      else
     1709         return entry(vlevel,vList).
     1710   end.
     1711   function getLevelUTDByLevelMotp return character
     1712   (iUnit as char):
     1713      define variable vLevel as integer no-undo.
     1714      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1715      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1716      vLevel = lookup(iUnit,vListMOTP).
     1717      if    vLevel eq ?
     1718         or vLevel < 1
     1719         or vLevel > 4
     1720      then
     1721         return ?.
     1722      else
     1723         return entry(vlevel,vListutd).
     1724   end.
     1725   function getLevelMotpByDM return character
     1726   (iDm as char):
     1727      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1728   end.
     1729   function getLevelUTDByCodId return character
     1730   (iDm as char):
     1731      define variable vLevel as integer no-undo.
     1732      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1733      vLevel = getlevelByCodId(iDm).
     1734      if    vLevel eq ?
     1735         or vLevel < 1
     1736         or vLevel > 4
     1737      then
     1738         return ?.
     1739      else
     1740         return entry(vlevel,vList).
     1741   end.
     1742   function getLevelUTDByDM return character
     1743   (iDm as char):
     1744      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1745   end.
     1746   define variable mNotMarkQnty as logical no-undo.
     1747   function getQntyUTDByCodId return decimal
     1748   (iDM as char):
     1749      define variable vLevel as integer no-undo.
     1750      define variable vList as character no-undo init "1,5,10,500".
     1751      define variable vGtin as character no-undo.
     1752      define variable vqnty as decimal no-undo init ?.
     1753      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1754      if vqnty eq ?
     1755      then do:
     1756         if not mNotMarkQnty
     1757         then do:
     1758            define buffer marking for ub.marking.
     1759            define variable vCodident as character no-undo.
     1760            vCodident = GetCodeIdent(idm).
     1761            find first marking where marking.mark begins vCodident no-lock no-error.
     1762            if     available marking
     1763               and marking.box-qnty ne ?
     1764            then
     1765               return marking.box-qnty.
     1766         end.
     1767         vGtin = getGtinByDm(iDM).
     1768         if ChekTypeMarkByGtin (vGtin)
     1769         then do:
     1770            vLevel = getlevelByCodId(iDM).
     1771            if     vLevel >= 1
     1772               and vLevel <= 4
     1773            then
     1774               vqnty = int(entry(vlevel,vList)).
     1775         end.
     1776         else
     1777            vqnty = getQntyCodeByGtin(vgtin).
     1778      end.
     1779      return vqnty.
     1780   end.
     1781   function getQntyUTDByDM return decimal
     1782   (iDm as char):
     1783      define variable vDM as character no-undo.
     1784      if     length (iDm) ne 25
     1785         and length (iDm) ne 29
     1786         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1787      then
     1788         vDM = substring (iDm,1,length (iDm) - 6 ).
     1789      else
     1790         vDM = substring (iDm,1,length (iDm) - 4 ).
     1791      return getQntyUTDByCodId(vDM).
     1792   end.
     1793   function getMRC4 return decimal
     1794   (iMRC as char):
     1795      define variable oMrc     as decimal no-undo init ?.
     1796      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1797      define variable vi       as integer no-undo.
     1798      define variable vfound   as integer no-undo.
     1799      define variable vposStart   as integer no-undo.
     1800      do:
     1801      OMRc = 0.
     1802      do vi = 1 to 4:
     1803         define variable vsimb as character no-undo.
     1804         vsimb = substring(iMRC,vi,1).
     1805         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1806         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1807         if vfound > 0
     1808         then
     1809            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1810         end.
     1811         OMRc = OMRc / 100.
     1812      end.
     1813      return OMRc.
     1814   end.
     1815   function getMRCByDM return decimal
     1816   (iDm as char):
     1817      define variable vMRC     as character no-undo.
     1818      define variable oMrc     as decimal no-undo init ?.
     1819      define variable Velement as character no-undo init "empty".
     1820      define variable vteg as character no-undo.
     1821      define variable vtegval as character no-undo.
     1822      if    length(idm) eq 14 + 7 + 4 + 4
     1823         or length(idm) eq 14 + 7 + 4
     1824      then do:
     1825         vMRC = substring(idm,22,4).
     1826         omrc = getMRC4(vMRC).
     1827      end.
     1828      else do:
     1829          ChekTypeMarkByDm(iDm).
     1830          block-mrc:
     1831          do while Velement ne "" and idm ne "":
     1832             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1833             if Velement begins "8005"
     1834             then do:
     1835                vMRC = substring(Velement,5,6).
     1836                leave block-mrc.
     1837             end.
     1838             else if Velement begins "(8005)"
     1839             then do:
     1840                vMRC = substring(Velement,7,6).
     1841                leave block-mrc.
     1842             end.
     1843          end.
     1844          if vMRC ne ""
     1845          then
     1846             OMRc = dec(vmrc) / 100 no-error.
     1847      end.
     1848      return OMRc.
     1849   end.
     1850   function MoveDate return Date
     1851   (idate as date,
     1852    iMonth as int64):
     1853      define variable vMonth   as int64 no-undo.
     1854      define variable vYear    as int64 no-undo.
     1855      define variable vDateNew as date  no-undo.
     1856       define variable vDay     as int64 no-undo.
     1857       vMonth = month(iDate) + iMonth.
     1858       vYear =  year(iDate).
     1859       if vMonth <= 0
     1860       then assign
     1861          vMonth = vMonth + 12
     1862           vYear  = vYear - 1
     1863       .
     1864       else if vMonth > 12
     1865       then assign
     1866          vMonth = vMonth - 12
     1867           vYear  = vYear + 1
     1868       .
     1869       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1870       do while error-status:error eq yes:
     1871          VDay = vDay + 1.
     1872          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1873       end.
     1874       if VDay > 0
     1875       then
     1876          vDateNew + 1.
     1877       return vDateNew.
     1878   end.
     1879   procedure checkEMRC:
     1880   define input  parameter iDm as character no-undo.
     1881   define output parameter vok as logical   no-undo init yes.
     1882      define variable v-value-emrc as character no-undo.
     1883      define variable v-type-emrc  as character no-undo.
     1884      define variable vDateIso     as character no-undo.
     1885      define variable vMRC         as decimal no-undo.
     1886      define variable vqnty        as decimal no-undo.
     1887      define variable vPrice       as decimal no-undo.
     1888      define variable vparent      as character no-undo.
     1889      define variable vgds-code    as integer no-undo.
     1890      define buffer code for ub.code.
     1891      vMRC = getMRCByDM(iDm).
     1892      if vMRC > 0
     1893      then do:
     1894         vgds-code = getGdsCodeByDM(iDm).
     1895         vqnty     = getQntyUTDByDM(iDm).
     1896               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1897            (
     1898             input   vgds-code
     1899            ,input   'emrc-type':U
     1900            ,output   v-value-emrc
     1901            ,output   v-type-emrc
     1902          ) no-error.
     1903          if     v-value-emrc ne ""
     1904             and v-value-emrc ne ?
     1905          then do:
     1906             vDateIso = iso-date(today).
     1907             vPrice = vMRC / vqnty.
     1908             vparent ="emc" + chr(4) + v-value-emrc.
     1909             find last code where Code.parent      eq vparent
     1910                              and Code.code        le vDateIso
     1911                              and code.status_  eq 0
     1912             no-lock no-error.
     1913             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1914             then
     1915                vOk = true .
     1916             else do:
     1917                 define variable vText      as character no-undo.
     1918                 define variable vDate      as date no-undo.
     1919                 define variable vDateLast  as character no-undo.
     1920                 define variable vDateFirst as character no-undo.
     1921                 define variable vDate3     as date no-undo.
     1922                 vdate = date(code.misc1).
     1923                 vDateLast = code.misc1.
     1924                 vDate3 = MoveDate(today, - 3 ).
     1925                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1926                                      string(vDate3  , "99/99/9999"),
     1927                                      string(vDate   , "99/99/9999")
     1928                                      ).
     1929                 vdateIso = iso-date(vdate3).
     1930                 find last code  where Code.parent      eq vparent
     1931                                   and Code.code        le vDateIso
     1932                                   and code.status_  eq 0 no-lock no-error.
     1933                 if available code
     1934                 then
     1935                    vDateIso = code.code.
     1936                 vDateFirst = vDateIso.
     1937                 vDateLast = iso-date(vdate).
     1938                 define variable vGood as logical no-undo.
     1939                 define variable vDateSale as date no-undo.
     1940                 define buffer bcode for code.
     1941                 for last code where Code.parent   eq vparent
     1942                                 and code.status_  eq 0
     1943                                 and code.code     < vDateLast
     1944                                 and code.code     >= vDateFirst
     1945                 no-lock:
     1946                    find first bcode where bCode.parent   eq vparent
     1947                                       and bcode.status_  eq 0
     1948                                       and bcode.code     > code.code no-lock no-error.
     1949                    if available bcode
     1950                    then do:
     1951                       if vPrice < dec(Code.CodeValue)
     1952                       then
     1953                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1954                                                     chr(10),
     1955                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1956                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1957                                                     ).
     1958                       else do:
     1959                          vGood = yes.
     1960                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1961                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1962                                                     chr(10),
     1963                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1964                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1965                                                     string(         vDateSale            ,"99/99/9999"),
     1966                                                     string(vDateSale - today)
     1967                                                     ).
     1968                       end.
     1969                    end.
     1970                 end.
     1971                 if vgood
     1972                 then do:
     1973                    define variable choice as integer no-undo .
     1974                    run gbl/d-askw.w (input "Уточнение"
     1975                           ,input  vText
     1976                           ,input "|"
     1977                           ,input "Принять|Вернуть"
     1978                           ,input "Принять данный товар|Вернуть товар постащику"
     1979                           ,input 1
     1980                           ,input 2
     1981                           ,output choice) no-error.
     1982                    vok = choice eq 1.
     1983                 end.
     1984                 else
     1985                    vok =false.
     1986             end.
     1987          end.
     1988      end.
     1989   end.
     1990   function addGs2Mark return character
     1991   (iMark as char):
     1992      define variable vDM   as character no-undo.
     1993      define variable vIdx  as integer   no-undo.
     1994      if index(iMark,chr(29),1) > 0
     1995      then return iMark.
     1996      if substring(iMark,26,4) = "8005" then
     1997      do:
     1998        vIdx = index(iMark,"93",26 + 4 + 5).
     1999        if vIdx > 1 then do:
     2000          vDM = substitute("&1&4&2&4&3",
     2001                           substring(iMark,1,25),
     2002                           substring(iMark,26,vIdx - 25 - 1),
     2003                           substring(iMark,vIdx),
     2004                           chr(29)) no-error.
     2005          vIdx = index(vDm,"240",vIdx + 4).
     2006          if vIdx > 0 then
     2007          do:
     2008            vDM = substitute("&1&3&2",
     2009                             substring(vDm,1,vIdx - 1),
     2010                             substring(vDm,vIdx),
     2011                             chr(29)) no-error.
     2012          end.
     2013        end.
     2014        else
     2015          vDM = substitute("&1&3&2",
     2016                           substring(iMark,1,25),
     2017                           substring(iMark,26),
     2018                           chr(29)) no-error.
     2019      end.
     2020      else if substring(iMark,32,2) = "91" then
     2021      do:
     2022        vIdx = index(iMark,"92",32).
     2023        if vIdx > 1 then
     2024          vDM = substitute("&1&4&2&4&3",
     2025                           substring(iMark,1,31),
     2026                           substring(iMark,32,vIdx - 31 - 1),
     2027                           substring(iMark,vIdx),
     2028                           chr(29)) no-error.
     2029        else
     2030          vDM = substitute("&1&3&2",
     2031                           substring(iMark,1,31),
     2032                           substring(iMark,32),
     2033                           chr(29)) no-error.
     2034      end.
     2035      else if substring(iMark,39,2) = "91" then
     2036      do:
     2037        vIdx = index(iMark,"92",38).
     2038        if vIdx > 1 then
     2039          vDM = substitute("&1&4&2&4&3",
     2040                           substring(iMark,1,38),
     2041                           substring(iMark,39,vIdx - 38 - 1),
     2042                           substring(iMark,vIdx),
     2043                           chr(29)) no-error.
     2044        else
     2045          vDM = substitute("&1&3&2",
     2046                           substring(iMark,1,38),
     2047                           substring(iMark,39),
     2048                           chr(29)) no-error.
     2049      end.
     2050      else if substring(iMark,25,2) = "93" then
     2051      do:
     2052        vIdx = index(iMark,"92",25).
     2053        if vIdx > 1 then
     2054          vDM = substitute("&1&4&2&4&3",
     2055                           substring(iMark,1,24),
     2056                           substring(iMark,25,vIdx - 24 - 1),
     2057                           substring(iMark,vIdx),
     2058                           chr(29)) no-error.
     2059        else
     2060          vIdx = index(iMark,"3103",25).
     2061          if vIdx > 0 then
     2062          vDM = substitute("&1&4&2&4&3",
     2063                           substring(iMark,1,24),
     2064                           substring(iMark,25,vIdx - 24 - 1),
     2065                           substring(iMark,vIdx),
     2066                           chr(29)) no-error.
     2067          else
     2068            vDM = substitute("&1&3&2",
     2069                             substring(iMark,1,24),
     2070                             substring(iMark,25),
     2071                             chr(29)) no-error.
     2072      end.
     2073      else if substring(iMark,32,2) = "93" then
     2074      do:
     2075        vDM = substitute("&1&3&2",
     2076              substring(iMark,1,31),
     2077              substring(iMark,32),
     2078              chr(29)) no-error.
     2079      end.
     2080      return if vDM <> "" then vDm else iMark.
     2081   end.
     2082   function AddUtdErrForTab returns logical
     2083   (idb-num         as integer ,
     2084    idoc-id         as integer ,
     2085    iTab            as character,
     2086    iObj            as handle ,
     2087    iCheckType      as character,
     2088    iCodeErr        as character,
     2089    iCheckObj       as character ):
     2090      define buffer utd-err for utd-err.
     2091      define buffer utd for utd.
     2092      find first utd where utd.db-num     eq idb-num
     2093                       and utd.doc-id     eq idoc-id
     2094                       and utd.Direction  eq 'Outbound'
     2095      no-lock no-error.
     2096      if available utd
     2097      then
     2098         return no.
     2099      define variable vRecKey as character no-undo.
     2100            run gen-key-rec (input iTab,
     2101                             input  iObj,
     2102                             output vRecKey).
     2103      find first utd-err where utd-err.db-num     eq idb-num
     2104                           and utd-err.doc-id     eq idoc-id
     2105                           and utd-err.CheckType  eq iCheckType
     2106                           and utd-err.CodeErr    eq iCodeErr
     2107                           and utd-err.CheckObj   eq iCheckObj
     2108      exclusive-lock no-error.
     2109      if not available utd-err
     2110      then do:
     2111         create utd-err.
     2112         assign
     2113            utd-err.db-num         = idb-num
     2114            utd-err.doc-id         = idoc-id
     2115            utd-err.CheckType      = iCheckType
     2116            utd-err.CodeErr        = iCodeErr
     2117            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2118            utd-err.reckey         = vRecKey
     2119            utd-err.qnty           = 1
     2120         .
     2121      end.
     2122      else
     2123         utd-err.qnty = utd-err.qnty + 1.
     2124      return utd-err.qnty eq 1.
     2125   end.
     2126   function AddUtdErr returns logical
     2127   (idb-num         as integer ,
     2128    idoc-id         as integer ,
     2129    iObj            as handle ,
     2130    iCheckType      as character,
     2131    iCodeErr        as character,
     2132    iCheckObj       as character ):
     2133      AddUtdErrForTab
     2134         (idb-num,
     2135          idoc-id,
     2136          iObj:table,
     2137          iObj,
     2138          iCheckType,
     2139          iCodeErr,
     2140          iCheckObj).
     2141   end.
     2142   function ClearUtdErrTypeCode returns logical
     2143   (idb-num         as integer,
     2144    idoc-id         as integer ,
     2145    iCheckType      as character,
     2146    iCodeErr        as character
     2147    ):
     2148      define buffer utd-err for utd-err.
     2149      if    iCheckType eq "*"
     2150         or iCheckType eq ?
     2151      then do:
     2152         if     iCodeErr ne ?
     2153            and iCodeErr ne "*"
     2154         then
     2155            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2156            view-as alert-box.
     2157         else
     2158         for each utd-err where utd-err.db-num  eq idb-num
     2159                            and utd-err.doc-id  eq idoc-id
     2160         exclusive-lock:
     2161            delete utd-err.
     2162         end.
     2163      end.
     2164      else do:
     2165         if    iCodeErr eq ?
     2166            or iCodeErr eq "*"
     2167         then do:
     2168            for each utd-err where utd-err.db-num     eq idb-num
     2169                               and utd-err.doc-id     eq idoc-id
     2170                               and utd-err.CheckType  eq iCheckType
     2171            exclusive-lock:
     2172               delete utd-err.
     2173            end.
     2174         end.
     2175         else do:
     2176            for each utd-err where utd-err.db-num     eq idb-num
     2177                               and utd-err.doc-id     eq idoc-id
     2178                               and utd-err.CheckType  eq iCheckType
     2179                               and ub.utd-err.CodeErr eq iCodeErr
     2180            exclusive-lock:
     2181               delete utd-err.
     2182            end.
     2183         end.
     2184      end.
     2185   end.
     2186   function ClearUtdErr returns logical
     2187   (idb-num         as integer,
     2188    idoc-id         as integer ,
     2189    iCheckType      as character
     2190    ):
     2191      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2192   end.
     2193   function GetMesError returns character
     2194   (itxt as character,
     2195    iobj as character ):
     2196    define variable vi as integer no-undo.
     2197    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2198       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2199    end.
     2200    return itxt.
     2201   end.
     2202   function GetTextErrorType returns character
     2203   (iCheckType as character,
     2204    iCodeErr   as character,
     2205    iChechObj  as character,
     2206    iType      as character  ):
     2207      define buffer code    for code.
     2208      define variable vError as character no-undo.
     2209      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2210                        and code.code   eq iCodeErr
     2211      no-lock no-error.
     2212      if available code
     2213      then do:
     2214         define variable vType as integer no-undo.
     2215         if code.misc3 eq "error"
     2216         then
     2217            vType = 0.
     2218         else if code.misc3 eq "warning"
     2219         then
     2220            vType = 1.
     2221         else if code.misc3 eq "Hiden"
     2222         then
     2223            vType = 2.
     2224         else
     2225            vtype = int(code.misc3) no-error.
     2226         case itype:
     2227            when "error"
     2228            then do:
     2229               if vtype eq 0
     2230               then
     2231                  vError = GetMesError(Code.CodeValue,iChechObj).
     2232            end.
     2233            when "warning"
     2234            then do:
     2235               if vtype <= 1
     2236               then
     2237                  vError = GetMesError(Code.CodeValue,iChechObj).
     2238            end.
     2239            otherwise do:
     2240               vError = GetMesError(Code.CodeValue,iChechObj).
     2241            end.
     2242         end.
     2243      end.
     2244      else
     2245         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2246      return vError.
     2247   end.
     2248   function GetTypeError returns integer
     2249   (iCheckType as character,
     2250    iCodeErr   as character):
     2251      define buffer code    for code.
     2252      define variable vType as integer no-undo.
     2253      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2254                        and code.code   eq iCodeErr
     2255      no-lock no-error.
     2256      if     not available code
     2257         and code.misc3 eq "error"
     2258      then
     2259         vType = 0.
     2260      else if code.misc3 eq "warning"
     2261      then
     2262         vType = 1.
     2263      else if code.misc3 eq "Hiden"
     2264      then
     2265         vType = 2.
     2266      else
     2267         vtype = int(code.misc3) no-error.
     2268      return vtype.
     2269   end.
     2270   function GetTextError returns character
     2271   (iCheckType as character,
     2272    iCodeErr   as character,
     2273    iChechObj  as character ):
     2274      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2275   end.
     2276   function GetErrForUtdStr returns character
     2277   (idb-num     as integer ,
     2278    idoc-id     as integer ,
     2279    iCheckType  as character
     2280    ):
     2281      define buffer utd-err for utd-err.
     2282      define buffer code    for code.
     2283      define variable vHQry as handle no-undo.
     2284      define variable vError as longchar no-undo.
     2285      define variable vErrorOne as longchar  no-undo.
     2286      define variable oError as character no-undo.
     2287      create query vHQry.
     2288      vHQry:set-buffers(buffer utd-err:handle).
     2289      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2290                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2291                               + if    iCheckType eq "*"
     2292                                    or iCheckType eq ?
     2293                                 then       ""
     2294                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2295      vHQry:query-open().
     2296      vHQry:get-first().
     2297      QRY-BLOCK:
     2298      repeat while not vHQry:query-off-end:
     2299         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2300         if     vErrorOne ne ""
     2301            and vErrorOne ne ?
     2302         then
     2303            vError = vError + ", " + vErrorOne.
     2304         vHQry:get-next().
     2305      end.
     2306      oError = substring(vError,3,4002).
     2307      return oError.
     2308   end.
     2309   function GetErrJsonForUtd returns character
     2310   (idb-num         as integer ,
     2311    idoc-id         as integer ,
     2312    iCheckType      as character
     2313    ):
     2314      define buffer utd-err for utd-err.
     2315      define variable vHQry as handle no-undo.
     2316      define variable vError as longchar no-undo.
     2317      define variable oError as character no-undo.
     2318      create query vHQry.
     2319      define variable vi as integer no-undo.
     2320      vHQry:set-buffers(buffer utd-err:handle).
     2321      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2322                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2323                               + if    iCheckType eq "*"
     2324                                    or iCheckType eq ?
     2325                                 then       ""
     2326                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2327      vHQry:query-open().
     2328      vHQry:get-first().
     2329      QRY-BLOCK:
     2330      repeat while not vHQry:query-off-end:
     2331         define variable vErrorOne as character no-undo.
     2332         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2333         if     vErrorOne ne ?
     2334            and vErrorOne ne ""
     2335         then do:
     2336            vi = vi + 1.
     2337            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2338                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2339                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2340         end.
     2341         vHQry:get-next().
     2342      end.
     2343      for first utd where utd.db-num eq idb-num
     2344                      and utd.doc-id eq idoc-id
     2345                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2346      no-lock,
     2347         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2348                                  and utd-marking-lines.doc-id eq idoc-id
     2349                                  and utd-marking-lines.doc-level eq 1
     2350      no-lock,
     2351         first marking where marking.mark eq utd-marking-lines.mark
     2352                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2353      no-lock:
     2354         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2355         if     vErrorOne ne ?
     2356            and vErrorOne ne ""
     2357         then do:
     2358            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2359                            + '","ОбъектОш":"' + marking.mark
     2360                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2361         end.
     2362      end.
     2363      if vError ne ""
     2364      then
     2365         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2366      return oError.
     2367   end.
     2368   function GetErrJsonForUtdReturn returns character
     2369   (idb-num         as integer ,
     2370    idoc-id         as integer ,
     2371    iCheckType      as character
     2372    ):
     2373      define buffer utd-err for utd-err.
     2374      define variable vHQry as handle no-undo.
     2375      define variable vError as longchar no-undo.
     2376      define variable oError as character no-undo.
     2377      define variable vi as integer no-undo.
     2378      create query vHQry.
     2379      vHQry:set-buffers(buffer utd-err:handle).
     2380      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2381                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2382                               + if    iCheckType eq "*"
     2383                                    or iCheckType eq ?
     2384                                 then       ""
     2385                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2386      vHQry:query-open().
     2387      vHQry:get-first().
     2388      QRY-BLOCK:
     2389      repeat while not vHQry:query-off-end:
     2390         define variable vErrorOne as character no-undo.
     2391         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2392         if     vErrorOne ne ?
     2393            and vErrorOne ne ""
     2394         then do:
     2395            vi = vi + 1.
     2396            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2397                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2398                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2399         end.
     2400         vHQry:get-next().
     2401      end.
     2402      if vError ne ""
     2403      then
     2404         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2405      return oError.
     2406   end.
     2407   function GetCodeTextError returns character
     2408   (iCheckType as character,
     2409    iCodeErr   as character,
     2410    iChechObj  as character,
     2411    output oCode as character,
     2412    output ovalue as character ):
     2413      define buffer code    for code.
     2414      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2415                        and code.code   eq iCodeErr
     2416      no-lock no-error.
     2417      if     available code
     2418      then do:
     2419         define variable vi as integer no-undo init ?.
     2420         vi = int(Code.misc3) no-error.
     2421         if    code.misc3 ne "error"
     2422            and vi ne 0
     2423         then
     2424            oCode = ?.
     2425         else if     Code.misc1 ne ?
     2426                 and Code.misc1 ne ""
     2427         then
     2428            assign
     2429               oCode  = GetMesError(Code.misc1,iChechObj)
     2430               ovalue = GetMesError(Code.misc2,iChechObj)
     2431            .
     2432      end.
     2433      return if oCode eq ""
     2434             then ""
     2435             else (oCode + "_" + ovalue).
     2436   end.
     2437   define temp-table TT-err no-undo
     2438     field code_ as character
     2439     field text_ as character
     2440   index code_ code_.
     2441   function GetErrTxtForUtd returns character
     2442   (idb-num         as integer ,
     2443    idoc-id         as integer ,
     2444    iCheckType      as character
     2445    ):
     2446      define buffer utd-err for utd-err.
     2447      define variable vHQry as handle no-undo.
     2448      define variable oError as character no-undo.
     2449      create query vHQry.
     2450      define variable vi as integer no-undo.
     2451      for each tt-err :
     2452         delete tt-err.
     2453      end.
     2454      vHQry:set-buffers(buffer utd-err:handle).
     2455      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2456                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2457                               + if    iCheckType eq "*"
     2458                                    or iCheckType eq ?
     2459                                 then       ""
     2460                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2461      vHQry:query-open().
     2462      vHQry:get-first().
     2463      define variable vcode as character no-undo.
     2464      define variable vvalue as character no-undo.
     2465      QRY-BLOCK:
     2466      repeat while not vHQry:query-off-end:
     2467         vi = vi + 1.
     2468         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2469         if vcode ne ?
     2470         then do:
     2471            find first tt-err where tt-err.code eq vcode
     2472            no-error.
     2473            if not available tt-err
     2474            then do:
     2475               create tt-err.
     2476               assign
     2477                  tt-err.code_ = vcode
     2478                  tt-err.text_ = vvalue
     2479               .
     2480            end.
     2481            else
     2482               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2483         end.
     2484         vHQry:get-next().
     2485      end.
     2486     find first utd where utd.db-num eq idb-num
     2487                         and utd.doc-id eq idoc-id
     2488         no-lock.
     2489      define buffer cancel_utd-lines for utd-lines.
     2490      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2491                                  and cancel_utd-lines.doc-id eq idoc-id
     2492      no-lock:
     2493         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2494         then do:
     2495            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2496                                        and utd-marking-lines.doc-id eq idoc-id
     2497                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2498            no-lock,
     2499               first marking where marking.mark eq utd-marking-lines.mark
     2500                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2501            no-lock:
     2502               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2503               find first tt-err where tt-err.code eq vcode
     2504               no-error.
     2505               if not available tt-err
     2506               then do:
     2507                  create tt-err.
     2508                  assign
     2509                     tt-err.code_ = vcode
     2510                     tt-err.text_ = vvalue
     2511                  .
     2512               end.
     2513               else
     2514                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2515            end.
     2516         end.
     2517         else do:
     2518            define variable vqnty as decimal no-undo.
     2519            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2520            if vqnty eq ? then vqnty = 0.
     2521            if vqnty ne cancel_utd-lines.Quantity
     2522            then do:
     2523               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2524               find first tt-err where tt-err.code eq vcode
     2525               no-error.
     2526               if not available tt-err
     2527               then do:
     2528                  create tt-err.
     2529                  assign
     2530                     tt-err.code_ = vcode
     2531                     tt-err.text_ = vvalue
     2532                  .
     2533               end.
     2534               else
     2535                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2536            end.
     2537         end.
     2538      end.
     2539      for each tt-err:
     2540         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2541      end.
     2542      return oError.
     2543   end.
     2544   define variable mFormatErr as character no-undo init "text".
     2545   function GetErrForUtd returns character
     2546   (idb-num         as integer ,
     2547    idoc-id         as integer ,
     2548    iType           as character
     2549    ):
     2550      if mFormatErr eq "text"
     2551      then
     2552         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2553      else do:
     2554         if itype eq "return"
     2555         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2556         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2557      end.
     2558   end.
     2559   function GetErrComText returns longchar
     2560   (icomment as character,
     2561    itext    as longchar ):
     2562       define variable vText as longchar no-undo.
     2563      if mFormatErr eq "text"
     2564      then do:
     2565         if icomment ne ""
     2566         then
     2567            icomment = substitute("comment:|&1|",icomment).
     2568         vText = icomment + itext.
     2569      end.
     2570      else do:
     2571         icomment = if icomment begins  '"'
     2572                    then icomment
     2573                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2574         vText = icomment + "," + itext.
     2575         vText = "~{" + trim(vText,",") + "~}".
     2576      end.
     2577      return vText.
     2578   end.
     2579   function CheckTypeForMarkLineType returns logical
     2580   (iObj            as handle,
     2581    iCheckType      as character,
     2582    iCodeErr        as character ,
     2583    iTypeErr        as character ):
     2584      define variable vRecKey-markLine as character no-undo.
     2585      define variable vGoodMark        as logical no-undo.
     2586      define variable vdb-num          as integer no-undo.
     2587      define variable vdoc-id          as integer no-undo.
     2588      define variable vlinenum         as integer no-undo.
     2589      define variable vErrorOne as character no-undo.
     2590      define buffer buf_utd-err for utd-err.
     2591      run gen-key-rec (input "utd-marking-lines",
     2592                       input  iObj,
     2593                       output vRecKey-markLine).
     2594      vGoodMark = yes.
     2595      vdb-num = iObj::db-num.
     2596      vdoc-id = iObj::doc-id.
     2597      vlinenum = iObj::linenum.
     2598      block-mark-err:
     2599      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2600                               and buf_utd-err.db-num = vdb-num
     2601                               and buf_utd-err.reckey = vRecKey-markLine
     2602                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2603                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2604      no-lock:
     2605         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2606         if     vErrorOne ne ?
     2607            and vErrorOne ne ""
     2608         then do:
     2609            vGoodMark = no.
     2610            leave block-mark-err.
     2611         end.
     2612      end.
     2613      return not vGoodMark.
     2614   end.
     2615   function CheckErrForMarkLineType returns logical
     2616   (iObj            as handle,
     2617    iType           as character  ):
     2618      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2619   end.
     2620   function CheckErrForMarkLine returns logical
     2621   (iObj            as handle):
     2622      return CheckErrForMarkLineType(iObj,"*").
     2623   end.
     2624   function CheckErrForLineTypeCode returns logical
     2625   (iObj                 as handle,
     2626    iCheckType           as character,
     2627    iCodeErr             as character,
     2628    iTypeErr             as character,
     2629    iOneErr              as logical):
     2630      define variable vRecKey-line     as character no-undo.
     2631      define buffer buf_utd-err for utd-err.
     2632      define variable vUtdlineError as logical no-undo.
     2633      define variable vErrorOne as character no-undo.
     2634            run gen-key-rec (input "utd-lines",
     2635                             input  iObj,
     2636                             output vRecKey-line).
     2637         define variable vdb-num as integer no-undo.
     2638         define variable vdoc-id as integer no-undo.
     2639         define variable vlinenum as integer no-undo.
     2640         vdb-num = iObj::db-num.
     2641         vdoc-id = iObj::doc-id.
     2642         vlinenum = iObj::linenum.
     2643         block-err:
     2644         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2645                                  and buf_utd-err.db-num = vdb-num
     2646                                  and buf_utd-err.reckey = vRecKey-line
     2647                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2648                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2649         no-lock:
     2650            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2651            if     vErrorOne ne ?
     2652               and vErrorOne ne ""
     2653            then do:
     2654               vUtdlineError = yes.
     2655               leave block-err.
     2656            end.
     2657         end.
     2658         if  not vUtdlineError
     2659         then do:
     2660            define variable vGoodMark as logical no-undo.
     2661            vGoodMark = yes.
     2662            block-line-err:
     2663            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2664                                         and utd-marking-lines.doc-id  eq vdoc-id
     2665                                         and utd-marking-lines.LineNum eq vLineNum
     2666            no-lock:
     2667               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2668               if     vGoodMark
     2669                  and iOneErr eq no
     2670               then
     2671                  leave block-line-err.
     2672               if     iOneErr = yes
     2673                  and not vGoodMark
     2674               then
     2675                  leave block-line-err.
     2676            end.
     2677            vUtdlineError = not vGoodMark.
     2678         end.
     2679      return vUtdlineError.
     2680   end.
     2681   function getErrForLineType returns character
     2682   (iObj            as handle,
     2683    iType           as character  ):
     2684      define variable vRecKey-line     as character no-undo.
     2685      define buffer buf_utd-err for utd-err.
     2686      define variable vUtdlineError as logical no-undo.
     2687      define variable vErrorOne as character no-undo.
     2688      define variable oError as character no-undo.
     2689            run gen-key-rec (input "utd-lines",
     2690                             input  iObj,
     2691                             output vRecKey-line).
     2692         define variable vdb-num as integer no-undo.
     2693         define variable vdoc-id as integer no-undo.
     2694         define variable vlinenum as integer no-undo.
     2695         vdb-num = iObj::db-num.
     2696         vdoc-id = iObj::doc-id.
     2697         vlinenum = iObj::linenum.
     2698         block-err:
     2699         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2700                                  and buf_utd-err.db-num = vdb-num
     2701                                  and buf_utd-err.reckey = vRecKey-line
     2702                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2703         no-lock:
     2704            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2705            if     vErrorOne ne ?
     2706               and vErrorOne ne ""
     2707            then do:
     2708               oError = oError + vErrorOne + " ".
     2709            end.
     2710         end.
     2711      return oError.
     2712   end.
     2713   function CheckErrForLineType returns logical
     2714   (iObj            as handle,
     2715    iType           as character  ):
     2716       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2717   end.
     2718   function CheckErrForLine returns logical
     2719   (iObj            as handle):
     2720      return CheckErrForLineType(iobj,"*").
     2721   end.
     2722   function CheckErrForUtd returns logical
     2723   (idb-num         as integer ,
     2724    idoc-id         as integer ):
     2725      for each utd-lines where utd-lines.db-num eq idb-num
     2726                           and utd-lines.doc-id eq idoc-id
     2727      no-lock :
     2728         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2729         then
     2730            return no.
     2731      end.
     2732      return yes.
     2733   end.
     2734   function CheckMarkUtd-28rel return logical
     2735    (input idb-num as integer,
     2736    input idoc-id as integer):
     2737    define buffer utd                   for utd.
     2738    define buffer utd-lines             for utd-lines.
     2739    define buffer utd-marking-lines     for utd-marking-lines.
     2740    define variable v-par-type as character no-undo.
     2741    define variable vgdsNoMark as logical no-undo.
     2742    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2743      define variable v-par-val  as character no-undo.
     2744      find first utd where utd.db-num eq idb-num
     2745                       and utd.doc-id eq idoc-id
     2746      no-lock no-error.
     2747      if available utd
     2748      then do:
     2749         if     utd.obj-code ne ?
     2750            and utd.obj-type ne ?
     2751         then do:
     2752            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2753            Block-utd-lines:
     2754            for each utd-lines where utd-lines.db-num eq idb-num
     2755                                 and utd-lines.doc-id eq idoc-id
     2756            no-lock:
     2757               if     utd-lines.gds-code ne ?
     2758                  and utd-lines.gds-code ne 0
     2759               then do:
     2760                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2761                       ( utd-lines.gds-code,
     2762                         'mark-type':U,
     2763                          output v-par-val,
     2764                          output v-par-type
     2765                       ).
     2766                  if     EDOParSec:IsEdo
     2767                     and EDOParSec:GetIsEDOForType(v-par-val)
     2768                  then do:
     2769                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2770                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2771                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2772                                                    and length(utd-marking-lines.mark) > 13
     2773                     no-lock no-error.
     2774                     if     avail utd-marking-lines
     2775                        and not CheckErrForLine(buffer utd-lines:handle)
     2776                     then
     2777                        leave Block-utd-lines.
     2778                  end.
     2779                  else
     2780                     vgdsNoMark = yes.
     2781               end.
     2782            end.
     2783            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2784            if vgdsNoMark then return available utd-lines . else return yes .
     2785         end.
     2786      end.
     2787      return yes.
     2788   end.
     2789   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2791     field side as character.
     2792   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2793   function CheckMarkUtd return logical
     2794    (input idb-num  as integer,
     2795     input idoc-id  as integer):
     2796     define buffer utd-lines             for ub.utd-lines.
     2797     block-line:
     2798     for each utd-lines where utd-lines.db-num eq idb-num
     2799                          and utd-lines.doc-id eq idoc-id
     2800     no-lock:
     2801        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2802        then
     2803           leave block-line.
     2804     end.
     2805     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2806     return available utd-lines.
     2807   end.
     2808   function CheckNotMarkUtd return logical
     2809    (input idb-num  as integer,
     2810     input idoc-id  as integer):
     2811     define buffer utd-lines             for ub.utd-lines.
     2812     for each utd-lines where utd-lines.db-num eq idb-num
     2813                          and utd-lines.doc-id eq idoc-id
     2814     no-lock:
     2815        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2816        then
     2817           return yes.
     2818     end.
     2819     return no.
     2820   end.
     2821   function CheckMarkUtdLine return logical
     2822    (input idb-num  as integer,
     2823     input idoc-id  as integer,
     2824     input iLineNum as integer):
     2825    define buffer utd                   for utd.
     2826    define buffer utd-lines             for utd-lines.
     2827    define buffer utd-marking-lines     for utd-marking-lines.
     2828    define variable v-par-type as character no-undo.
     2829    define variable vMarking        as logical no-undo.
     2830    define variable vArtic          as logical no-undo.
     2831    define variable vTransitional   as logical no-undo.
     2832    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2833      define variable v-par-val  as character no-undo.
     2834      find first utd where utd.db-num eq idb-num
     2835                       and utd.doc-id eq idoc-id
     2836      no-lock no-error.
     2837      if available utd
     2838      then do:
     2839         if     utd.obj-code ne ?
     2840            and utd.obj-type ne ?
     2841         then do:
     2842            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2843            Block-utd-lines:
     2844            for each utd-lines where utd-lines.db-num   eq idb-num
     2845                                 and utd-lines.doc-id   eq idoc-id
     2846                                 and utd-lines.LineNum  eq iLineNum
     2847            no-lock:
     2848               if     utd-lines.gds-code ne ?
     2849                  and utd-lines.gds-code ne 0
     2850               then do:
     2851                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2852                       ( utd-lines.gds-code,
     2853                         'mark-type':U,
     2854                          output v-par-val,
     2855                          output v-par-type
     2856                       ).
     2857                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2858                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2859                  if vMarking
     2860                  then do:
     2861                     block-marking:
     2862                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2863                                                    and utd-marking-lines.doc-id   eq idoc-id
     2864                                                    and utd-marking-lines.LineNum  eq iLineNum
     2865                                                    and length(utd-marking-lines.mark) > 13
     2866                     no-lock:
     2867                        if isOAD(utd-marking-lines.mark)
     2868                        then do:
     2869                           assign
     2870                              vArtic   = yes
     2871                              vMarking = no
     2872                           .
     2873                           leave block-marking.
     2874                        end.
     2875                     end.
     2876                  end.
     2877                  if vArtic
     2878                  then do:
     2879                     block-artic:
     2880                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2881                                                    and utd-marking-lines.doc-id   eq idoc-id
     2882                                                    and utd-marking-lines.LineNum  eq iLineNum
     2883                                                    and length(utd-marking-lines.mark) > 13
     2884                     no-lock:
     2885                        if isMark(utd-marking-lines.mark)
     2886                        then do:
     2887                           assign
     2888                              vArtic   = no
     2889                              vMarking = yes
     2890                           .
     2891                           leave block-artic.
     2892                        end.
     2893                     end.
     2894                  end.
     2895                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2896                  if vTransitional
     2897                  then do:
     2898                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2899                                                    and utd-marking-lines.doc-id   eq idoc-id
     2900                                                    and utd-marking-lines.LineNum  eq iLineNum
     2901                                                    and length(utd-marking-lines.mark) > 13
     2902                     no-lock no-error.
     2903                     if not available utd-marking-lines
     2904                     then assign
     2905                        vMarking = no
     2906                        vArtic   = no
     2907                     .
     2908                  end.
     2909               end.
     2910               else
     2911                  assign
     2912                     vMarking      = yes
     2913                     vArtic        = no
     2914                     vTransitional = no
     2915                  .
     2916               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2917               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2918               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2919            end.
     2920         end.
     2921      end.
     2922      return vMarking or vArtic.
     2923   end.
     2924   function getMarkUtdLine return logical
     2925    (input  idb-num  as integer,
     2926     input  idoc-id  as integer,
     2927     input  iLineNum as integer,
     2928     output oMarking        as logical,
     2929     output oArtic          as logical,
     2930     output oTransitional   as logical):
     2931     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2932     oArtic        = not oMarking
     2933            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2934     oTransitional = (oMarking or oArtic)
     2935            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2936   end.
     2937   function CheckMarking return logical
     2938    (input idb-num as integer,
     2939    input idoc-id as integer,
     2940    input iTypeErr as character ):
     2941     define variable vMarkutd as logical no-undo.
     2942     define variable vCrErr   as logical no-undo.
     2943     define buffer utd-lines         for utd-lines.
     2944     define buffer utd-marking-lines for utd-marking-lines.
     2945     define buffer marking           for marking.
     2946     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2947      block-line:
     2948      for each utd-lines where utd-lines.db-num eq idb-num
     2949                           and utd-lines.doc-id eq idoc-id
     2950      no-lock:
     2951         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2952         then do:
     2953            for each utd-marking-lines
     2954                     where utd-marking-lines.db-num  = utd-lines.db-num
     2955                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2956                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2957            no-lock:
     2958               if isMark(utd-marking-lines.mark)
     2959               then do:
     2960                  find first marking where marking.mark eq utd-marking-lines.mark
     2961                  no-lock no-error.
     2962                  if not available marking
     2963                  then do:
     2964                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2965                     vCrErr = yes.
     2966                     next block-line.
     2967                  end.
     2968               end.
     2969            end.
     2970         end.
     2971      end.
     2972      return vCrErr.
     2973   end.
     2974   function CheckMarkForType return logical
     2975    (input idb-num   as integer,
     2976     input idoc-id   as integer):
     2977      define variable vMarking        as logical no-undo.
     2978      define variable vArtic          as logical no-undo.
     2979      define variable vTransitional   as logical no-undo.
     2980      define buffer utd-lines         for utd-lines.
     2981      define buffer utd-marking-lines for utd-marking-lines.
     2982      block-line:
     2983      for each utd-lines where utd-lines.db-num eq idb-num
     2984                           and utd-lines.doc-id eq idoc-id
     2985      no-lock:
     2986         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2987                          output vMarking         , output vArtic          , output vTransitional).
     2988         for each utd-marking-lines
     2989                     where utd-marking-lines.db-num  = utd-lines.db-num
     2990                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2991                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2992         no-lock:
     2993            if length(utd-marking-lines.mark) < 14
     2994            then do:
     2995               if (vMarking or vArtic) and not vTransitional
     2996               then
     2997                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2998            end.
     2999            else if not isMark(utd-marking-lines.mark)
     3000            then do:
     3001               if vMarking
     3002               then
     3003                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3004            end.
     3005            else do:
     3006            end.
     3007         end.
     3008      end.
     3009   end.
     3010   function WeighedProd return logical
     3011      ( input p-gds-code as integer) :
     3012      define variable v-par-val  as character no-undo.
     3013      define variable v-par-type as character no-undo.
     3014              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3015               ( p-gds-code,
     3016                 'weighed-gds':U,
     3017                  output v-par-val,
     3018                  output v-par-type
     3019               ).
     3020      return logical(v-par-val).
     3021   end.
     3022   function WghProdVariable return logical
     3023       (input p-obj-type as char,
     3024        input p-obj-code as integer,
     3025        input p-gds-code as integer) :
     3026      define variable v-wgh-val  as character no-undo.
     3027      define variable v-par-val  as character no-undo.
     3028      define variable v-par-type as character no-undo.
     3029      define variable vMarking        as logical no-undo.
     3030      define variable vArtic          as logical no-undo.
     3031      define variable vTransitional   as logical no-undo.
     3032      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3033         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3034           ( p-gds-code,
     3035             'weighed-gds':U,
     3036              output v-wgh-val,
     3037              output v-par-type
     3038           ).
     3039       if logical(v-wgh-val) = yes then do:
     3040           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3041               ( p-gds-code,
     3042                 'mark-type':U,
     3043                  output v-par-val,
     3044                  output v-par-type
     3045               ).
     3046           if v-par-val <> "" then do:
     3047               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3048               assign
     3049                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3050                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3051                  .
     3052           end.
     3053      end.
     3054      if v-wgh-val > "" and (vMarking or vArtic)
     3055      then return yes.
     3056      else return no.
     3057   end.
     3058   function MarkWeight return decimal
     3059      ( input p-mark as character) :
     3060      define buffer  buf_marking-attr for  ub.marking-attr.
     3061      define variable vMarkWeight as decimal no-undo.
     3062      vMarkWeight = 0.
     3063      if p-mark <> "" and p-mark <> ?
     3064      then do:
     3065          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3066                                        and buf_marking-attr.attr-code eq "weight"
     3067             no-lock no-error.
     3068          if not available buf_marking-attr
     3069          then do :
     3070            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3071                                          and buf_marking-attr.attr-code eq "weight"
     3072               no-lock no-error.
     3073          end .
     3074          if avail buf_marking-attr
     3075          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3076      end.
     3077      return vMarkWeight.
     3078   end.
     3079   function CheckQnty returns logical
     3080   (  input idb-num  as integer,
     3081      input idoc-id  as integer,
     3082      input iErrType as character
     3083   ):
     3084      if iErrType ne "loadUTD"
     3085      then do:
     3086         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3087         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3088         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3089      end.
     3090      if iErrType ne "CheckQnty"
     3091      then do:
     3092         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3093         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3094         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3095      end.
     3096      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3097      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3098      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3099      define buffer marking               for marking.
     3100      define buffer utd-lines             for utd-lines.
     3101      define buffer utd-marking-lines     for utd-marking-lines.
     3102      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3103      block-line:
     3104      for each utd-lines where utd-lines.db-num eq idb-num
     3105                           and utd-lines.doc-id eq idoc-id
     3106      no-lock:
     3107         define variable Vflagmark as logical no-undo.
     3108         find first buf_utd-marking-lines
     3109                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3110                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3111                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3112                         and length(buf_utd-marking-lines.mark) > 13
     3113         no-lock no-error.
     3114         if not available buf_utd-marking-lines
     3115         then
     3116            next block-line.
     3117         define variable vqntyMark as integer no-undo.
     3118         define variable vqntyOAD  as integer no-undo.
     3119         vqntyMark = 0.
     3120         vqntyOAD  = 0.
     3121         block-mark:
     3122         for each utd-marking-lines
     3123              where utd-marking-lines.db-num  = utd-lines.db-num
     3124                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3125                and utd-marking-lines.LineNum = utd-lines.LineNum
     3126                and length(utd-marking-lines.mark) > 13
     3127                and utd-marking-lines.doc-level  = 1
     3128         no-lock:
     3129            if isMark(utd-marking-lines.mark)
     3130            then do:
     3131               find first marking where marking.mark eq utd-marking-lines.mark
     3132               no-lock no-error.
     3133               if available marking
     3134               then do:
     3135                  if marking.box-qnty ne ?
     3136                  then
     3137                     vqntyMark = vqntyMark + marking.box-qnty.
     3138               end.
     3139            end.
     3140            else do:
     3141               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3142                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3143                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3144                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3145                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3146               no-lock no-error.
     3147               if available utd-marking-lines-attr
     3148               then
     3149                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3150            end.
     3151         end.
     3152         if     utd-lines.gds-code   gt 0
     3153            and utd-lines.gds-code   ne ?
     3154            and vqntyMark            ne 0
     3155         then do:
     3156            if utd-lines.Quantity  < vqntyMark
     3157            then
     3158               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3159            else if utd-lines.Quantity  <> vqntyMark
     3160            then
     3161               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3162         end.
     3163         else if     utd-lines.gds-code   gt 0
     3164            and utd-lines.gds-code   ne ?
     3165            and vqntyOAD ne 0
     3166            and utd-lines.Quantity  ne vqntyOAD
     3167         then
     3168            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3169      end.
     3170   end.
     3171   function CheckGds returns logical
     3172   (  input idb-num   as integer,
     3173      input idoc-id   as integer,
     3174      input iobj-type as character,
     3175      input iobj-code as integer,
     3176      input iErrType as character
     3177   ):
     3178      if iErrType ne "loadUTD"
     3179      then do:
     3180         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3181         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3182         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3183         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3184         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3185         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3186         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3187         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3188         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3189         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3190         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3191      end.
     3192      if iErrType ne "CheckGds"
     3193      then do:
     3194         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3195         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3196         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3197         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3198         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3199         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3200         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3201         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3202         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3203         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3204         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3205      end.
     3206      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3207      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3208      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3209      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3210      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3211      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3212      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3213      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3214      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3215      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3216      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3217      define variable v-par-type as character no-undo.
     3218      define variable v-par-val  as character no-undo.
     3219      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3220      define buffer marking               for marking.
     3221      define buffer utd-lines             for utd-lines.
     3222      define buffer buf_utd-lines         for utd-lines.
     3223      define buffer utd-marking-lines     for utd-marking-lines.
     3224      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3225      define variable vGdsCode as integer no-undo.
     3226      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3227      block-line:
     3228      for each utd-lines where utd-lines.db-num eq idb-num
     3229                           and utd-lines.doc-id eq idoc-id
     3230      no-lock:
     3231         vGdsCode = ?.
     3232         define variable Vflagmark as logical no-undo.
     3233         define variable VflagOAD  as logical no-undo.
     3234         assign
     3235            Vflagmark = no
     3236            VflagOAD = no
     3237         .
     3238         block-mark:
     3239         for each utd-marking-lines
     3240                  where utd-marking-lines.db-num  = utd-lines.db-num
     3241                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3242                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3243         no-lock:
     3244            if    isMark(utd-marking-lines.mark)
     3245               or isOAD (utd-marking-lines.mark)
     3246            then do:
     3247               define variable vnewGdsCode as integer no-undo.
     3248               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3249               if isMark(utd-marking-lines.mark)
     3250               then do:
     3251                  Vflagmark = yes.
     3252                  find first marking where marking.mark eq utd-marking-lines.mark
     3253                  no-lock no-error.
     3254                  if not available marking
     3255                  then do:
     3256                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3257                     next block-mark.
     3258                  end.
     3259                  if vnewGdsCode eq ?
     3260                  then
     3261                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3262                  if    marking.gds-code eq 0
     3263                     or marking.gds-code eq ?
     3264                     or marking.sts eq 0
     3265                     or marking.sts eq ?
     3266                     or marking.box-qnty eq ?
     3267                     or (marking.gds-code ne vnewGdsCode
     3268                         and vnewGdsCode ne ?
     3269                         and vnewGdsCode ne 0)
     3270                  then do:
     3271                     find first marking where marking.mark eq utd-marking-lines.mark
     3272                     exclusive-lock no-error.
     3273                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3274                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3275                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3276                     if    marking.gds-ext-id eq ""
     3277                        or marking.gds-ext-id eq ?
     3278                     then do:
     3279                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3280                     end.
     3281                     else if    marking.gds-code eq 0
     3282                             or marking.gds-code eq ?
     3283                     then
     3284                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3285                     else if     marking.sts eq 0
     3286                             or  marking.sts eq ?
     3287                     then
     3288                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3289                  end.
     3290                  if utd-marking-lines.doc-level eq 1
     3291                  then do:
     3292                     if marking.box-qnty eq ?
     3293                     then
     3294                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3295                  end.
     3296               end.
     3297               else do:
     3298                  VflagOAD = yes.
     3299                  define variable vQnty as decimal no-undo.
     3300                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3301                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3302                                          utd-marking-lines.doc-id,
     3303                                          utd-marking-lines.LineNum,
     3304                                          utd-marking-lines.mark,
     3305                                          "box-qnty",
     3306                                           string(vQnty)).
     3307                  define variable vgtin as character no-undo.
     3308                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3309                  if getQntyCodeByGtin(vgtin) ne 1
     3310                  then
     3311                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3312               end.
     3313               if utd-marking-lines.gds-code ne vnewGdsCode
     3314               and vnewGdsCode ne ?
     3315               and vnewGdsCode ne 0
     3316               then do:
     3317                  find first buf_utd-marking-lines
     3318                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3319                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3320                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3321                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3322                  exclusive-lock no-error.
     3323                  if available buf_utd-marking-lines
     3324                  then do:
     3325                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3326                  end.
     3327               end.
     3328            end.
     3329            else  do:
     3330               define variable vgdsbar as integer no-undo.
     3331               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3332               if    utd-marking-lines.gds-code ne vgdsbar
     3333               then do:
     3334                  find first buf_utd-marking-lines
     3335                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3336                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3337                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3338                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3339                  exclusive-lock no-error.
     3340                  if available buf_utd-marking-lines
     3341                  then do:
     3342                     buf_utd-marking-lines.gds-code = vgdsbar.
     3343                  end.
     3344               end.
     3345               if vgdsbar ne ?
     3346               then do:
     3347                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3348                            ( vgdsbar,
     3349                              'mark-type':U,
     3350                              output v-par-val,
     3351                              output v-par-type
     3352                             ).
     3353                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3354                       or  EDOParSec:GetIsArticForType(v-par-val))
     3355                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3356                   and     EDOParSec:IsEdo
     3357                  then do:
     3358                     AddUtdErr(utd-marking-lines.db-num,
     3359                               utd-marking-lines.doc-id,
     3360                               buffer utd-marking-lines:handle,
     3361                               iErrType,
     3362                               "MarkingForTypeEDO",
     3363                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3364                  end.
     3365               end.
     3366            end.
     3367            if vGdsCode eq ?
     3368            then
     3369               vGdsCode = utd-marking-lines.gds-code.
     3370            if vGdsCode ne utd-marking-lines.gds-code
     3371            and utd-marking-lines.gds-code > 0
     3372            then do:
     3373               vGdsCode = -1.
     3374            end.
     3375         end.
     3376         if  vGdsCode = -1
     3377         then do:
     3378            vGdsCode = ?.
     3379            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3380            next block-line.
     3381         end.
     3382         if vGdsCode ne ?
     3383         then do:
     3384                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3385                      ( vGdsCode,
     3386                        'mark-type':U,
     3387                        output v-par-val,
     3388                        output v-par-type
     3389                       ).
     3390            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3391                and(
     3392                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3393                     and not Vflagmark)
     3394                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3395                     and not VflagOAD
     3396                     and not Vflagmark))
     3397            then do:
     3398               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3399            end.
     3400         end.
     3401         if utd-lines.gds-code ne vGdsCode
     3402         then do:
     3403            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3404                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3405                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3406            exclusive-lock no-error.
     3407            if available buf_utd-lines
     3408            then
     3409               buf_utd-lines.gds-code = vGdsCode.
     3410            release buf_utd-lines.
     3411         end.
     3412         define variable VBarCode as character no-undo.
     3413         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3414         if VBarCode ne ?
     3415         then do:
     3416            if num-entries(VBarCode," ") > 0
     3417            then
     3418               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3419            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3420            if vgdsbar eq ? or vgdsbar eq 0
     3421            then do:
     3422               AddUtdErr(utd-lines.db-num,
     3423                         utd-lines.doc-id,
     3424                         buffer utd-lines:handle,
     3425                         iErrType,
     3426                         "NotFindGdsForBarCode",
     3427                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3428            end.
     3429            else do:
     3430               if    utd-lines.gds-code eq ?
     3431                  or utd-lines.gds-code eq 0
     3432               then do:
     3433                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3434                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3435                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3436                  exclusive-lock no-error.
     3437                  if available buf_utd-lines
     3438                  then
     3439                     buf_utd-lines.gds-code = vgdsbar.
     3440                  release buf_utd-lines.
     3441               end.
     3442               else if utd-lines.gds-code ne vgdsbar
     3443               then do:
     3444                  AddUtdErr(utd-lines.db-num,
     3445                         utd-lines.doc-id,
     3446                         buffer utd-lines:handle,
     3447                         iErrType,
     3448                         "NotEqGgsForLineAndMark",
     3449                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3450               end.
     3451            end.
     3452         end.
     3453         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3454         then
     3455            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3456      end.
     3457   end.
     3458   function GetUtdLineForOrig return logical
     3459   (input idb-num as integer,
     3460    input idoc-id as integer,
     3461    input ilineNum as integer,
     3462    input idb-numOrig as integer,
     3463    input idoc-idOrig as integer,
     3464    buffer edoc-lines for utd-lines):
     3465      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3466      block-mark:
     3467      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3468                                   and utd-marking-lines.doc-id  eq idoc-id
     3469                                   and utd-marking-lines.LineNum eq iLineNum
     3470                                   and utd-marking-lines.site eq "-"
     3471      no-lock:
     3472         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3473                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3474                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3475                     no-lock no-error.
     3476         if available edoc-marking-lines
     3477         then do:
     3478            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3479                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3480                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3481            no-lock no-error.
     3482               leave block-mark.
     3483          end.
     3484      end.
     3485       if not available edoc-lines
     3486       then do:
     3487          find  first  utd-lines where utd-lines.db-num      = idb-num
     3488                                   and utd-lines.doc-id      = idoc-id
     3489                                   and utd-lines.LineNum     = ilinenum
     3490             no-lock no-error.
     3491          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3492                                  and edoc-lines.doc-id      = idoc-idOrig
     3493                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3494          no-lock no-error.
     3495       end.
     3496       if not available edoc-lines
     3497       then
     3498          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3499                                  and edoc-lines.doc-id      = idoc-idOrig
     3500                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3501          no-lock no-error.
     3502   end.
     3503   function GetLastUTDinPack returns logical
     3504   (input idb-num as integer,
     3505    input idoc-id as integer,
     3506    output odb-num as integer,
     3507    output odoc-id as integer ) forward.
     3508   function getObgFns return logical
     3509   (input iDocumentNumber   as character ,
     3510    input iFnsParticipantId as character ,
     3511    input ikpp              as character ,
     3512    output ohost-code       as integer,
     3513    output oobj-type        as character ,
     3514    output oobj-code        as integer ,
     3515    output otext            as character  ):
     3516       define buffer ext-classif   for ext-classif.
     3517       define buffer clients       for clients.
     3518       define buffer buf_clients   for clients.
     3519       define buffer clients-attr  for clients-attr.
     3520       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3521                                and ext-classif.charkey_three eq iFnsParticipantId
     3522       no-lock no-error.
     3523       if available ext-classif
     3524       then do:
     3525          if ext-classif.CharKey_One eq 'маг':U
     3526          then do:
     3527             assign
     3528                oobj-type = ext-classif.CharKey_One
     3529                oobj-code = ext-classif.Key#_One
     3530             .
     3531             find first clients
     3532                  where clients.obj-type   = ext-classif.CharKey_One
     3533                    and clients.obj-code   = ext-classif.Key#_One
     3534             no-lock no-error .
     3535             if available clients
     3536             then
     3537                ohost-code =  clients.host-code.
     3538          end.
     3539          else do:
     3540             find first clients
     3541                  where clients.obj-type   = ext-classif.CharKey_One
     3542                    and clients.obj-code   = ext-classif.Key#_One
     3543                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3544             no-lock no-error .
     3545             if not available clients
     3546             then do:
     3547                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3548                return no.
     3549             end.
     3550             ohost-code = ext-classif.Key#_One.
     3551             block-cl:
     3552             for each clients-attr
     3553                where clients-attr.attr-code  = 'kpp':U
     3554                  and clients-attr.obj-type   = 'маг':U
     3555                  and clients-attr.attr-value = ikpp
     3556                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3557                                             and buf_clients.obj-code   = clients-attr.obj-code
     3558                                             and buf_clients.host-code  = ohost-code)
     3559             no-lock :
     3560                leave block-cl.
     3561             end.
     3562             if     available clients
     3563                and clients.obj-type eq 'маг':U
     3564             then do:
     3565                assign
     3566                   oobj-type = clients.obj-type
     3567                   oobj-code = clients.obj-code
     3568                .
     3569             end.
     3570             else if available clients-attr
     3571             then do:
     3572                assign
     3573                   oobj-type = clients-attr.obj-type
     3574                   oobj-code = clients-attr.obj-code
     3575                .
     3576             end.
     3577             else do:
     3578                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3579                return yes.
     3580             end.
     3581          end.
     3582       end.
     3583       else do:
     3584          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3585          return no.
     3586       end.
     3587       return ?.
     3588   end.
     3589   function CheckUcdForReturn return logical
     3590   (input idb-numUcd as integer,
     3591    input idoc-idUcd as integer,
     3592    input idb-numRet as integer,
     3593    input idoc-idRet as integer  ):
     3594       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3595                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3596                                    and utd-marking-lines.doc-level eq 1
     3597       no-lock:
     3598          create tt-utd-mark.
     3599          buffer-copy utd-marking-lines to tt-utd-mark
     3600          assign
     3601             tt-utd-mark.side = "+"
     3602          .
     3603       end.
     3604       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3605                                    and utd-marking-lines.doc-id eq idoc-idRet
     3606                                    and utd-marking-lines.doc-level eq 1
     3607       no-lock:
     3608          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3609          no-lock no-error.
     3610          if available tt-utd-mark
     3611          then
     3612             tt-utd-mark.side = "".
     3613          else do:
     3614             create tt-utd-mark.
     3615             buffer-copy utd-marking-lines to tt-utd-mark
     3616             assign
     3617                tt-utd-mark.side = "-"
     3618             .
     3619          end.
     3620       end.
     3621       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3622       no-lock:
     3623          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3624       end.
     3625       for each tt-utd-mark:
     3626          delete tt-utd-mark.
     3627       end.
     3628   end.
     3629   function GetLastUTDinPackAft returns logical
     3630   (input idb-num as integer,
     3631    input idoc-id as integer,
     3632    output odb-num as integer,
     3633    output odoc-id as integer ) forward.
     3634   function SaturateAndCheckUTD return character
     3635   (input idb-num as integer,
     3636    input idoc-id as integer  ):
     3637      define buffer clients-attr          for clients-attr.
     3638      define buffer clients               for clients.
     3639      define buffer Utd                   for Utd.
     3640      define buffer utd_ret               for ub.utd.
     3641      define buffer utd-lines             for utd-lines.
     3642      define buffer buf_utd-lines         for utd-lines.
     3643      define buffer buf_utddoc-lines      for utd-lines.
     3644      define buffer marking               for marking.
     3645      define buffer marking-lines         for marking-lines.
     3646      define buffer utd-marking-lines     for utd-marking-lines.
     3647      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3648      define buffer contract              for contract.
     3649      define buffer old_utd               for Utd.
     3650      define variable vError as character no-undo.
     3651      define variable vGdsCode as integer no-undo.
     3652      define variable vcli-type as character no-undo.
     3653      define variable vcli-code as integer no-undo.
     3654      define variable vhost-code as integer no-undo init ?.
     3655      define variable vcontract-code as integer no-undo.
     3656      define variable vobj-type as character no-undo init ?.
     3657      define variable vobj-code as integer no-undo init ?.
     3658      define variable volddb-num as integer no-undo.
     3659      define variable volddoc-id as integer no-undo.
     3660      define variable vMark as logical no-undo.
     3661      define variable VUcd as logical no-undo.
     3662      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3663      define variable v-par-type as character no-undo.
     3664      define variable v-par-val  as character no-undo.
     3665      define variable VFileMark as logical no-undo.
     3666      define variable vunit     as int no-undo.
     3667      define variable vunitCode as character no-undo.
     3668      define variable vMarkingUtd as logical no-undo.
     3669      find first Utd where utd.db-num eq idb-num
     3670                       and utd.doc-id eq idoc-id
     3671      no-lock no-error.
     3672      if available Utd
     3673      then do:
     3674         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3675         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3676         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3677         assign
     3678               vobj-type  = utd.obj-type
     3679               vobj-code  = utd.obj-code
     3680               vhost-code = utd.host-code
     3681         .
     3682         do:
     3683            define variable vtext       as character no-undo.
     3684            define variable vhost-code1 as integer   no-undo.
     3685            define variable vobj-type1  as character no-undo.
     3686            define variable vobj-code1  as integer   no-undo.
     3687             getObgFns
     3688                       (input utd.DocumentNumber ,
     3689                        input utd.obj-FnsParticipantId ,
     3690                        input utd.obj-kpp,
     3691                        output vhost-code1,
     3692                        output vobj-type1,
     3693                        output vobj-code1,
     3694                        output vtext ).
     3695            assign
     3696               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3697               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3698               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3699            .
     3700            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3701            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3702            block-line:
     3703            for each utd-lines where utd-lines.db-num eq utd.db-num
     3704                                 and utd-lines.doc-id eq utd.doc-id
     3705            no-lock:
     3706               vGdsCode =?.
     3707               define variable vNotMarkForLine as logical no-undo.
     3708               vNotMarkForLine = no.
     3709               if not VUcd
     3710               then do:
     3711                  find first utd-marking-lines
     3712                       where utd-marking-lines.db-num  = utd-lines.db-num
     3713                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3714                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3715                  no-lock no-error.
     3716                  if not available utd-marking-lines
     3717                  then do:
     3718                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3719                     vNotMarkForLine = yes.
     3720                  end.
     3721               end.
     3722               block-mark:
     3723               for each utd-marking-lines
     3724                  where utd-marking-lines.db-num  = utd-lines.db-num
     3725                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3726                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3727               no-lock:
     3728                  vMark = yes.
     3729                  if     isMark(utd-marking-lines.mark)
     3730                     and utd-marking-lines.gds-code  ne 0
     3731                     and utd-marking-lines.gds-code ne ?
     3732                  then do:
     3733                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3734                           ( utd-marking-lines.gds-code,
     3735                            'mark-type':U,
     3736                            output v-par-val,
     3737                            output v-par-type
     3738                            ).
     3739                      if     not VFileMark
     3740                         and not VUcd
     3741                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3742                      then do:
     3743                          AddUtdErr(utd.db-num,
     3744                                     utd.doc-id,
     3745                                     buffer utd-marking-lines:handle,
     3746                                     "loadUtd",
     3747                                     "NotON_NSCHFDOPPRMARK",
     3748                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3749                     end.
     3750                  end.
     3751               end.
     3752               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3753               then do :
     3754                  if     VUcd
     3755                  then do:
     3756                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3757                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3758                     if available buf_utddoc-lines
     3759                     then do:
     3760                        vGdsCode = buf_utddoc-lines.gds-code.
     3761                        vunitCode = buf_utddoc-lines.UnitCode.
     3762                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3763                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3764                        then
     3765                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3766                               "loadUtd",
     3767                               "UcdUnitChangForUtd",
     3768                               string(utd-lines.LineNum )                  + chr(4) +
     3769                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3770                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3771                     end.
     3772                     if     utd-lines.UnitCode ne ?
     3773                        and utd-lines.UnitCode ne ""
     3774                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3775                     then
     3776                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3777                               "loadUtd",
     3778                               "UcdUnitChang",
     3779                               string(utd-lines.LineNum )                  + chr(4) +
     3780                               utd-lines.UnitCode                          + chr(4) +
     3781                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3782                  end.
     3783               end.
     3784               else
     3785                  vGdsCode = utd-lines.gds-code.
     3786               define variable vValText as character no-undo.
     3787               define variable vValDec  as decimal no-undo.
     3788               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3789               if VValText = ?
     3790               then do:
     3791                  vValDec = utd-lines.Quantity.
     3792                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3793               end.
     3794               else
     3795                  vValDec = dec(VValText).
     3796               release bar-code .
     3797               if     vGdsCode > 0 and vGdsCode ne ?
     3798               then do:
     3799                  assign
     3800                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3801                     vunit = ?
     3802                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3803                  no-error.
     3804                  if vunit ne 0 and vunit ne ?
     3805                  then do:
     3806                     find units where units.OKEI eq vunit no-lock no-error.
     3807                     if available units
     3808                     then
     3809                        vunitCode = units.unit-name.
     3810                  end.
     3811                  find first bar-code where bar-code.gds-code eq vGdsCode
     3812                                        and bar-code.unit-cli eq vUnitCode
     3813                  no-lock no-error.
     3814                  if not available bar-code
     3815                  then
     3816                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3817                               "loadUtd",
     3818                               "Unit",
     3819                               string(utd-lines.LineNum )                  + chr(4) +
     3820                               string(vGdsCode)                            + chr(4) +
     3821                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3822                               vunitCode).
     3823               end.
     3824               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3825               then do:
     3826                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3827                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3828                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3829                  exclusive-lock no-error.
     3830                  if available buf_utd-lines
     3831                  then do:
     3832                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3833                     release buf_utd-lines.
     3834                  end.
     3835               end.
     3836               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3837               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3838               if     not VUcd
     3839                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3840               then
     3841                  vMarkingUtd = yes .
     3842            end.
     3843            if not VUcd
     3844            then
     3845               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3846            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3847                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3848            no-lock no-error.
     3849            if available ext-classif
     3850            then
     3851               assign
     3852                  vcli-type = ext-classif.CharKey_One
     3853                  vcli-code = ext-classif.Key#_One
     3854               .
     3855            else do:
     3856               assign
     3857                 vcli-type = ?
     3858                 vcli-code = ?
     3859               .
     3860               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3861            end.
     3862            find first contract  where contract.host-code eq vhost-code
     3863                                   and contract.cli-type  eq vcli-type
     3864                                   and contract.cli-code  eq vcli-code
     3865                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     3866            no-lock no-error.
     3867            define variable VContractEdo as logical no-undo init yes.
     3868            if available contract
     3869            then do:
     3870               assign
     3871                  VContractEdo = contract.whole-send-news > 0
     3872                  vcontract-code = contract.contract-code
     3873               .
     3874               if not VContractEdo
     3875               then
     3876                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     3877            end.
     3878            else do:
     3879               vcontract-code = ?.
     3880            end.
     3881         end.
     3882         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     3883         then do:
     3884            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     3885         end.
     3886         define variable vdoc-code as character no-undo init ?.
     3887         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     3888         then do:
     3889            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     3890                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     3891                                 and utd_ret.Timestamp             le utd.Timestamp
     3892                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     3893            no-lock no-error.
     3894            if available utd_ret
     3895            then do:
     3896               vdoc-code = utd_ret.doc-code.
     3897               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     3898            end.
     3899         end.
     3900      end.
     3901      find current utd exclusive-lock no-error.
     3902      if available utd
     3903      then do:
     3904         assign
     3905            utd.cli-type      = vcli-type      when vcli-type      ne ?
     3906            utd.cli-code      = vcli-code      when vcli-type      ne ?
     3907            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     3908            utd.contract-code = vcontract-code when vcontract-code ne ?
     3909            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     3910            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     3911            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     3912         .
     3913         if   ( utd.contract-code eq ?
     3914            or utd.contract-code eq 0)
     3915            and not vucd
     3916         then
     3917            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     3918         if utd.host-code eq ?
     3919            or utd.host-code eq 0
     3920         then
     3921            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     3922         if utd.obj-code eq ?
     3923            or utd.obj-code eq 0
     3924         then
     3925            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     3926      end.
     3927      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     3928      if vError eq ""
     3929      then do:
     3930         if utd.sts eq 0 or utd.sts eq ?
     3931         then
     3932            utd.sts = if VUcd
     3933                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     3934                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3935         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     3936         then do:
     3937            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3938         end.
     3939         if     not VUcd
     3940            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     3941         then do:
     3942            if not vMarkingUtd
     3943            then
     3944               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     3945         end.
     3946      end.
     3947      else do:
     3948         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     3949         then
     3950            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     3951      end.
     3952      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3953         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     3954      then
     3955         utd.sts-edi = ?.
     3956      else if     (not vMark and  not vucd) or not VContractEdo
     3957              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3958      then
     3959         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     3960      release utd no-error.
     3961      if error-status:error
     3962      then
     3963         return error return-value.
     3964      return vError.
     3965   end.
     3966   function ReCheckload returns logical
     3967   (idb-num as integer,
     3968    idoc-id as integer,
     3969    iload   as logical ):
     3970      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     3971      define buffer buf_c-utd for ub.c-utd .
     3972      define buffer buf_utd   for ub.utd .
     3973      find first buf_utd where buf_utd.db-num eq idb-num
     3974                           and buf_utd.doc-id eq idoc-id
     3975      exclusive-lock no-error.
     3976      if available buf_utd
     3977      then do:
     3978         if    iload
     3979            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     3980         then do:
     3981            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     3982            if  error-status:error then
     3983            do:
     3984               message return-value view-as alert-box.
     3985            end.
     3986         end.
     3987         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3988            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3989            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3990            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     3991         then do:
     3992            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     3993                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     3994                                              buf_c-utd.sts    eq buf_utd.sts and
     3995                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3996            no-error .
     3997            if available (buf_c-utd)
     3998            then do:
     3999               buf_utd.sts = buf_c-utd.sts .
     4000               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4001            end.
     4002            else do:
     4003               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4004                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4005               then
     4006                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4007               else
     4008                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4009               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4010            end.
     4011         end.
     4012         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4013         then do:
     4014            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4015                                     input buf_utd.doc-id) .
     4016         end.
     4017      end.
     4018      release buf_utd.
     4019      unsubscribe "getNextseq".
     4020   end.
     4021   function ReCheck returns logical
     4022   (idb-num as integer,
     4023    idoc-id as integer ):
     4024      ReCheckload(idb-num,idoc-id,no).
     4025   end.
     4026   function GetLastUTDForPac returns logical
     4027   (iPackegeId as character ,
     4028    iTimestamp as datetime,
     4029    output odb-num as integer,
     4030    output odoc-id as integer ):
     4031      define buffer buf_utd for utd.
     4032      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4033                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4034                                and Buf_utd.Timestamp gt iTimestamp
     4035      no-lock no-error.
     4036      if available  buf_utd
     4037      then
     4038         assign
     4039            odb-num = buf_utd.db-num
     4040            odoc-id = buf_utd.doc-id
     4041         no-error.
     4042      else
     4043         assign
     4044            odb-num = ?
     4045            odoc-id = ?
     4046         no-error.
     4047   end.
     4048   function GetprevUTDForPac returns logical
     4049   (iPackegeId as character ,
     4050    iTimestamp as datetime,
     4051    output odb-num as integer,
     4052    output odoc-id as integer ):
     4053      define buffer buf_utd for utd.
     4054      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4055                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4056                                and Buf_utd.Timestamp < iTimestamp
     4057      no-lock no-error.
     4058      if available  buf_utd
     4059      then
     4060         assign
     4061            odb-num = buf_utd.db-num
     4062            odoc-id = buf_utd.doc-id
     4063         no-error.
     4064      else
     4065         assign
     4066            odb-num = ?
     4067            odoc-id = ?
     4068         no-error.
     4069   end.
     4070   function GetLastUTDinPackAft returns logical
     4071   (input idb-num as integer,
     4072    input idoc-id as integer,
     4073    output odb-num as integer,
     4074    output odoc-id as integer ):
     4075      define buffer buf_utd for utd.
     4076      define buffer     utd for utd.
     4077      find first utd where utd.db-num eq idb-num
     4078                       and utd.doc-id eq idoc-id
     4079      no-lock no-error.
     4080      if available utd
     4081      then do:
     4082         if utd.PackageId eq ""
     4083         then do:
     4084            assign
     4085               odb-num = utd.db-num
     4086               odoc-id = utd.doc-id
     4087            .
     4088            return yes.
     4089         end.
     4090         else do:
     4091            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4092            if    odb-num eq ?
     4093               or odoc-id eq ?
     4094            then do:
     4095               assign
     4096                  odb-num = utd.db-num
     4097                  odoc-id = utd.doc-id
     4098               .
     4099               return yes.
     4100            end.
     4101            else
     4102               return odoc-id = utd.doc-id.
     4103         end.
     4104      end.
     4105      return ?.
     4106   end.
     4107   function GetLastUTDinPackbef returns logical
     4108   (input idb-num as integer,
     4109    input idoc-id as integer,
     4110    output odb-num as integer,
