     6682                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue.
     6683                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vExtendedInvoiceItem:Quantity:OriginalValue)).
     6684                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vExtendedInvoiceItem:Price:OriginalValue)).
     6685                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue)).
     6686                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vExtendedInvoiceItem:TaxRate:OriginalValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:OriginalValue,"/"),"%")))).
     6687                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vExtendedInvoiceItem:Vat:OriginalValue)).
     6688                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vExtendedInvoiceItem:Subtotal:OriginalValue)).
     6689                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"UnitCode_old", vExtendedInvoiceItem:UnitName:OriginalValue).
     6690                            end.
     6691                            vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     6692                            getdesc(vunits).
     6693                            do vii = 1 to vunits:count:
     6694                               vunit = vunits:GETITEM(vii - 1).
     6695                               getdesc(vunit).
     6696                               if     vunit:Id eq "штрихкод"
     6697                                   or vunit:Id eq "ean"
     6698                               then do:
     6699                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     6700                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     6701                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     6702                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     6703                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     6704                                  no-lock no-error.
     6705                                  if not available utd-marking-lines
     6706                                  then do:
     6707                                    vtext = vunit:Value.
     6708                                    do viii = 1 to num-entries(vtext," "):
     6709                                       VValue = entry(viii,vtext," ").
     6710                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     6711                                    end.
     6712                                 end.
     6713                              end.
     6714                              release object  vunit.
     6715                           end.
     6716                           release object  vunits.
     6717                            release object vExtendedInvoiceItem.
     6718                         end.
     6719                         release object vItems.
     6720                     end.
     6721                     release object vContent.
     6722                  end.
     6723                  else do:
     6724                     create tt-recid.
     6725                     assign
     6726                        tt-recid.orgid = vOrganizationGuid
     6727                        tt-recid.docid = vDocumentid
     6728                     .
     6729                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     6730                     release object vDocumentChild.
     6731                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     6732                  end.
     6733               end.
     6734            end.
     6735            release object vDocumentChild.
     6736            define variable vsetPAck as logical no-undo.
     6737            define variable vcli-type as character no-undo.
     6738            define variable vcli-code as integer no-undo.
     6739            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6740                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     6741            no-lock no-error.
     6742            if available ext-classif
     6743            then do:
     6744               assign
     6745                  vcli-type = ext-classif.CharKey_One
     6746                  vcli-code = ext-classif.Key#_One
     6747               .
     6748               define variable vPack as character no-undo.
     6749               if   iDocument:type eq "UniversalTransferDocument"
     6750               then
     6751                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     6752               else if iDocument:type eq "UniversalTransferDocumentRevision"
     6753               then
     6754                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     6755               else
     6756                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     6757               if vPack ne utd.PackageId
     6758               then
     6759                  assign
     6760                     vsetPAck      = yes
     6761                     utd.PackageId = vPack
     6762                  .
     6763            end.
     6764            if vNewUtd or vsetPAck then do:
     6765               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6766               then do:
     6767                  if vNewUtd  then do:
     6768                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     6769                     find first old_utd where old_utd.db-num eq volddb-num
     6770                                          and old_utd.doc-id eq volddoc-id
     6771                        no-lock no-error.
     6772                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     6773                                                  and utd-marking-lines.doc-id eq utd.doc-id
     6774                     exclusive-lock:
     6775                        if available old_utd
     6776                           and utd.db-num ne volddb-num
     6777                           and utd.doc-id ne volddoc-id
     6778                        then
     6779                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     6780                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     6781                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     6782                           no-lock no-error.
     6783                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     6784                     end.
     6785                     validate utd.
     6786                     ReCheckload( utd.db-num, utd.doc-id,yes).
     6787                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6788                  end.
     6789               end.
     6790               else do:
     6791                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     6792                  find first old_utd where old_utd.db-num eq volddb-num
     6793                                       and old_utd.doc-id eq volddoc-id
     6794                  no-lock no-error.
     6795                  if not available old_utd
     6796                     or (   utd.db-num eq volddb-num
     6797                        and utd.doc-id eq volddoc-id)
     6798                  then
     6799                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     6800                  else do:
     6801                      assign
     6802                          utd.obj-inn               = old_utd.obj-inn
     6803                          utd.obj-kpp               = old_utd.obj-kpp
     6804                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     6805                          utd.obj-info              = old_utd.obj-info
     6806                          utd.parentDocumentExt     = old_utd.DocumentExt
     6807                          utd.parentOrganizationExt = old_utd.OrganizationExt
     6808                          utd.contract-code         = old_utd.contract-code
     6809                      .
     6810                  end.
     6811                  validate utd.
     6812                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     6813               end.
     6814            end.
     6815            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     6816            find first old_utd where old_utd.db-num eq volddb-num
     6817                                 and old_utd.doc-id eq volddoc-id
     6818            no-lock no-error.
     6819            if available old_utd
     6820            then
     6821               assign
     6822                  utd.parentDocumentExt     = old_utd.DocumentExt
     6823                  utd.parentOrganizationExt = old_utd.OrganizationExt
     6824               .
     6825            create tt-recid.
     6826            assign
     6827               tt-recid.orgid = vOrganizationGuid
     6828               tt-recid.docid = vDocumentid
     6829            .
     6830            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     6831            then do:
     6832               tt-recid.parent = utd.PackageId.
     6833               tt-recid.stamp  = utd.Timestamp.
     6834            end.
     6835            release utd no-error.
     6836            if error-status:error
     6837            then
     6838               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     6839            else
     6840               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6841            unsubscribe "getNextseq".
     6842         end.
     6843      end.
     6844   end.
     6845   function packetupdd returns date
     6846   (iOrganization as component-handle, iDocument as component-handle):
     6847      define variable VPack as character no-undo.
     6848      define variable vorgid as character no-undo.
     6849      define variable vdocid as character no-undo.
     6850      define variable vstamp as datetime no-undo.
     6851      define variable VPack2 as character no-undo.
     6852      define variable vorgid2 as character no-undo.
     6853      define variable vdocid2 as character no-undo.
     6854      define variable vstamp2 as datetime no-undo.
     6855      define variable VPackage as component-handle no-undo.
     6856      define variable vi as integer no-undo.
     6857      define variable vDocument as component-handle no-undo.
     6858      define variable vDocuments as component-handle no-undo.
     6859         VPack = iDocument:PackageId.
     6860         vorgid = iDocument:OrganizationGuid.
     6861         vdocid = iDocument:DocumentId.
     6862         vstamp = iDocument:Timestamp.
     6863         find first tt-pack where tt-pack.packid eq VPack
     6864                              and tt-pack.stamp  eq vstamp
     6865                              and tt-pack.orgid  eq vorgid
     6866                              and tt-pack.docid  eq vdocid
     6867         no-lock no-error.
     6868         if not available tt-pack
     6869         then do:
     6870            create tt-pack.
     6871            assign
     6872               tt-pack.packid = VPack
     6873               tt-pack.stamp  = vstamp
     6874               tt-pack.orgid  = vorgid
     6875               tt-pack.docid  = vdocid
     6876            .
     6877         end.
     6878         getdesc(iDocument ).
     6879         getdesc(iDocument:InitialDocumentIds ).
     6880         vDocuments = iDocument:InitialDocumentIds.
     6881         do vi= 1 to vDocuments:Count:
     6882            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     6883            getdesc(vDocument ).
     6884            vorgid2 = vDocument:OrganizationGuid.
     6885            vdocid2 = vDocument:DocumentId.
     6886            vstamp2 = vDocument:Timestamp.
     6887            find first tt-pack where tt-pack.packid eq VPack
     6888                                 and tt-pack.stamp  eq vstamp2
     6889                                 and tt-pack.orgid  eq vorgid2
     6890                                 and tt-pack.docid  eq vdocid2
     6891            no-lock no-error.
     6892            if not available tt-pack
     6893            then do:
     6894               create tt-pack.
     6895               assign
     6896                  tt-pack.packid = VPack
     6897                  tt-pack.stamp  = vstamp2
     6898                  tt-pack.orgid  = vorgid2
     6899                  tt-pack.docid  = vdocid2
     6900               .
     6901            end.
     6902            release object vDocument.
     6903         end.
     6904         release object vDocuments.
     6905   end.
     6906   procedure UpdateUTDInform:
     6907      define input  parameter ibeg-date as date no-undo.
     6908      define input  parameter iend-date as date no-undo.
     6909      define output parameter odatelast as date no-undo.
     6910      define variable vOrganizationList as component-handle no-undo.
     6911      define variable vOrganization as component-handle no-undo.
     6912      define variable vDocumentsTask as component-handle no-undo.
     6913      define variable vDocumentList  as component-handle no-undo.
     6914      define variable vDocumentchildList  as component-handle no-undo.
     6915      define variable vDocument       as component-handle no-undo.
     6916      define buffer ext-classif_obj for ext-classif.
     6917      define buffer ext-classif_Cli  for ext-classif.
     6918      define variable vi  as integer no-undo.
     6919      define variable vii as integer no-undo.
     6920      odatelast = ibeg-date.
     6921      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6922      if vOrganizationList eq ? then return error ?.
     6923      vi = vOrganizationList:Count()no-error.
     6924      if vi eq ?
     6925      then
     6926         return error ?.
     6927      for each tt-recid:
     6928         delete tt-recid.
     6929      end.
     6930      for each tt-pack:
     6931         delete tt-pack.
     6932      end.
     6933      do vi = 1 to vOrganizationList:Count() :
     6934         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6935         getdesc(vOrganization).
     6936         run changeIdtoGuid(vOrganization).
     6937         vDocumentsTask = vOrganization:GetDocumentsTask().
     6938                     vDocumentsTask:FromSendDate = ibeg-date  .
     6939                     vDocumentsTask:ToSendDate   = iend-date.
     6940                     for each tt-type, each tt-Class:
     6941                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     6942                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     6943                                          chr(10),
     6944                                          ibeg-date ,
     6945                                          iend-date,
     6946                                          if tt-type .id eq "Any" then "" else tt-type.name,
     6947                                          tt-Class.name)).
     6948                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     6949                         if vDocumentList ne ?
     6950                         then do:
     6951                           do vii= 1 to vDocumentList:Count:
     6952                              if chekStop() then return ?.
     6953                              vDocument = vDocumentList:GetItem(vii - 1).
     6954                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     6955                              odatelast = min(odatelast,today).
     6956                              packetupdd(vOrganization, vDocument).
     6957                              release object vDocument.
     6958                            end.
     6959                            release object vDocumentList.
     6960                         end.
     6961                      end.
     6962                      define variable VAlldoc    as integer no-undo.
     6963                      define variable vprocessed as integer no-undo.
     6964                      for each tt-pack :
     6965                         VAlldoc = VAlldoc + 1.
     6966                      end.
     6967                      for each tt-pack :
     6968                          if chekStop() then return ?.
     6969                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     6970                         then do:
     6971                             run  UpdateUTDInformOne(vDocument).
     6972                            release object vDocument.
     6973                        end.
     6974                        vprocessed = vprocessed + 1.
     6975                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     6976                     end.
     6977         release object vOrganization.
     6978         release object vDocumentsTask.
     6979      end.
     6980      release object vOrganizationList.
     6981   end.
     6982   procedure updOneUTD:
     6983      define input  parameter idb-num as integer no-undo.
     6984      define input  parameter idoc-id as integer no-undo.
     6985      define variable vDocument as component-handle no-undo.
     6986      define buffer utd for utd.
     6987      for each tt-recid:
     6988         delete tt-recid.
     6989      end.
     6990      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6991      then do:
     6992          run  UpdateUTDInformOne(vDocument).
     6993         release object vDocument.
     6994      end.
     6995   end.
     6996   function CRnewDocum return character
     6997   (
     6998   iOrgGuid as character,
     6999   iContGuid as character,
     7000   iTypeUTD as character,
     7001    iFile as character
     7002    ):
     7003   define variable vOrganization as component-handle no-undo.
     7004   define variable vSendTask as component-handle no-undo.
     7005       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     7006       if vOrganization ne ?
     7007       then do:
     7008          vSendTask = vOrganization:CreatePackageSendTask2().
     7009          getdesc(vSendTask).
     7010          vSendTask:CounteragentId = iContGuid  .
     7011          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     7012          vSendTask:Send()no-error.
     7013          if error-status:num-messages > 0 then do:
     7014             PutErr("ERROR Ошибка отправки документа").
     7015             return error "ERROR Ошибка отправки документа".
     7016          end.
     7017          else do:
     7018             PutMes("Документ отправлен успешно.").
     7019             message "Документ отправлен успешно."
     7020             view-as alert-box.
     7021          end.
     7022          release object vSendTask.
     7023         release object vOrganization .
     7024      end.
     7025   end.
     7026   procedure MySeqForUtd:
     7027      define input  parameter iTable       as character no-undo.
     7028      define input  parameter iseqnamehist as character no-undo.
     7029      define input  parameter idb-name     as character no-undo.
     7030      define output parameter Oseq         as int64 no-undo.
     7031      if iTable begins "utd"
     7032      then do:
     7033         if myseqUtd eq ?
     7034         then
     7035            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     7036         Oseq = myseqUtd.
     7037      end.
     7038      else
     7039         Oseq = ?.
     7040      return.
     7041   end.
     7042   mPublishHand = this-procedure .
     7043   define variable mParam as character no-undo.
     7044   mParam = GetPARAMAsunc( 1).
     7045   if mParam eq ? then do:
     7046      run PutstatAsunc( "error   Получение данных было преврвано пользователем." ).
     7047      return.
     7048   end.
     7049   mdb-num-local  = int(mParam).
     7050   define variable MdebugStr as character no-undo.
     7051   MdebugStr = GetParamAsunc( 2).
     7052   if MdebugStr ne ?
     7053   then
     7054      mdebug = logical(MdebugStr) no-error.
     7055   if mdebug eq ?
     7056   then
     7057      mdebug = no.
     7058   if mDiadocApi eq ?
     7059   then
     7060      run PutstatAsunc(substitute("Error Не удалось создать объект Diadoc.DiadocClient. Проверьте установку библиоткеки Diadoc.") ).
     7061   else do:
     7062      run PutstatAsunc (substitute ("Версия библиотеки Diadoc &1" , mDiadocApi:GetFullVersion())).
     7063      define variable mFirst as logical no-undo init no.
     7064      run PutstatAsunc(substitute("Загрузка данных по БД &1",mdb-num-local) ).
     7065      g#esys = yes.
     7066      Block-extsys:
     7067      for each ext-system  where ext-system.db-num  eq mdb-num-local
     7068                             and ext-system.esys-type eq 12
     7069      no-lock,
     7070         first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     7071                                          and ext-system-attr.esys-id eq ext-system.esys-id
     7072                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     7073      no-lock:
     7074         mFirst = yes.
     7075         run PutstatAsunc(substitute("Загрузка данных по ВС &1",ext-system.esys-id) ).
     7076         v-cntxt-host-code-obj = int(ext-system-attr.esya-attr-value).
     7077         g#esys-source-esys = ext-system.esys-id.
     7078         mext-sys = ext-system.esys-id.
     7079         if    StopCheck()
     7080         then
     7081            leave Block-extsys.
     7082         mDiadocConnection = conectbylogin().
     7083         if mDiadocConnection eq ?
     7084         then do:
     7085            run PutstatAsunc ( substitute("error Не удалось подключиться к серверу Диадок в БД &1 ВС &2" ,
     7086                                     mdb-num-local, mext-sys)) .
     7087            mError= yes.
     7088         end.
     7089         else do:
     7090            run getNewUpd.
     7091         end.
     7092         if    StopCheck()
     7093         then
     7094            leave Block-extsys.
     7095         run PutstatAsunc(substitute("Загрузка данных по ВС &1 завершена.",ext-system.esys-id) ).
     7096      end.
     7097      if    StopCheck()
     7098      then .
     7099      else if not mFirst
     7100      then
     7101         run PutstatAsunc( substitute("Нет ВС Диадок для БД &1" , mdb-num-local)).
     7102      else if not mError
     7103      then do:
     7104         run PutstatAsunc( substitute("Данные загруженны в БД &1" , mdb-num-local)).
     7105      end.
     7106      else
     7107         run PutstatAsunc( substitute("Данные загруженны в БД &1 загружены с ошибками." , mdb-num-local)).
     7108   end.
     7109   if    StopCheck()
     7110   then do:
     7111      run PutstatAsunc( "error   Получение данных было преврвано пользователем." ).
     7112   end.
     7113   release object mDiadocApi.
