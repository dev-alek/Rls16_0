     4126         end.
     4127         else do:
     4128            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4129            if    odb-num eq ?
     4130               or odoc-id eq ?
     4131            then do:
     4132               assign
     4133                  odb-num = utd.db-num
     4134                  odoc-id = utd.doc-id
     4135               .
     4136               return yes.
     4137            end.
     4138            else
     4139               return odoc-id = utd.doc-id.
     4140         end.
