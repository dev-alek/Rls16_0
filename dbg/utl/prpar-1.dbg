        1   block-level on error undo, throw.
        2   define input  parameter  parparentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: prpar-1.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/prpar-1.p $":U .
        8   define variable vss-description as character no-undo init "Пересчет документов по продажным ценам по партиям".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define new global shared variable g#lib-trn  as handle no-undo .
       79   define new global shared variable g#lib-trn2 as handle no-undo .
       80   define new global shared variable g#lib-trn3 as handle no-undo .
       81   define new global shared variable g#lib-trn4 as handle no-undo .
       82   define variable p-doc-code as character no-undo .
       83   define variable v-r-b as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$".
       85   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
       86     (output v-r-b
       87     )  .
       88     run gbl/d-prompt.w
       89       ( 'title=Введите Номер документа\'
       90       + 'format=x(15)\'
       91       + 'type=char\'
       92       ,input-output p-doc-code
       93       ).
       94     if return-value = 'false':u
       95     then do:
       96       return .
       97     end.
       98   find first ub.trn-doc exclusive-lock where
       99              ub.trn-doc.doc-code = p-doc-code no-error .
      100     if ub.trn-doc.doc-type = 'при':U then do:
      101         message "Приходы не пересчитываем ! "  view-as alert-box error .
      102         return .
      103     end.
      104     for each ub.doc-line no-lock where
      105             ub.doc-line.doc-code = ub.trn-doc.doc-code :
      106         find first ub.gds-obj no-lock where
      107                   ub.gds-obj.obj-type   = ub.trn-doc.obj-type   and
      108                   ub.gds-obj.obj-code   = ub.trn-doc.obj-code   and
      109                   ub.gds-obj.artic      = ub.doc-line.artic     and
      110                   ub.gds-obj.prod-type  = ub.doc-line.prod-type and
      111                   ub.gds-obj.prod-code  = ub.doc-line.prod-code and
      112                   ub.gds-obj.cash-parts = true no-error .
      113          if not available ub.gds-obj then next.
      114          for each ub.gds-dtl exclusive-lock where
      115                   ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
      116                   ub.gds-dtl.artic     = ub.doc-line.artic     and
      117                   ub.gds-dtl.prod-type = ub.doc-line.prod-type and
      118                   ub.gds-dtl.prod-code = ub.doc-line.prod-code
      119                   :
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
      122     ( input recid(ub.gds-dtl)
      123     , input no
      124     , input ub.gds-dtl.doc-qnty
      125     ) no-error.
      126         end.
      127     end.
      128     run gbl/calc-trn.p (parparentproc ,recid(ub.trn-doc)) no-error .
      129     message "Все" view-as alert-box information .
