        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Просмотр документов".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   procedure proc-alt-shift-f2:
       62     if not ibs.th.gbl.gbl-var:rcode
       63   then
       64     run gbl\inidebug.p .
       65   end.
       66   procedure proc-alt-shift-f3:
       67     run gbl/prvssinf.p
       68       ( input this-procedure
       69       ) .
       70   end.
       71   define variable v-inform-launched as logical no-undo initial false .
       72   procedure proc-alt-shift-f4:
       73     define variable v-action as character no-undo .
       74     if v-inform-launched = false then do:
       75       assign
       76         v-inform-launched = true
       77       .
       78       run gbl/d-inform.w
       79         (  input self
       80         ,  input this-procedure
       81         , output v-action
       82         ) no-error .
       83       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       84       assign
       85         v-inform-launched = false
       86       .
       87     end.
       88   end.
       89   procedure proc-alt-f1:
       90     run gbl/corrhelp.p
       91       (input this-procedure
       92       ) .
       93   end .
       94   on alt-shift-f2 anywhere do:
       95     run proc-alt-shift-f2.
       96   end.
       97   on alt-shift-f3 anywhere do:
       98     run proc-alt-shift-f3 in this-procedure .
       99   end.
      100   on alt-shift-f4 anywhere do:
      101     run proc-alt-shift-f4 in this-procedure.
      102   end.
      103   on alt-f1 anywhere do:
      104     run proc-alt-f1 in this-procedure .
      105   end.
      106   CREATE WIDGET-POOL.
      107   DEFINE VARIABLE h_b-dl AS HANDLE NO-UNDO.
      108   DEFINE VARIABLE h_b-dl-2 AS HANDLE NO-UNDO.
      109   DEFINE VARIABLE h_b-gdsdtl AS HANDLE NO-UNDO.
      110   DEFINE VARIABLE h_b-ot-tot AS HANDLE NO-UNDO.
      111   DEFINE VARIABLE h_b-otline AS HANDLE NO-UNDO.
      112   DEFINE VARIABLE h_b-prt AS HANDLE NO-UNDO.
      113   DEFINE VARIABLE h_b-t-doc AS HANDLE NO-UNDO.
      114   DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
      115   DEFINE VARIABLE h_v-t-doc AS HANDLE NO-UNDO.
      116   DEFINE FRAME D-Dialog
      117        SPACE(99.01) SKIP(21.72)
      118       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      119            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      120            TITLE "Просмотр информации по документам".
      121   ASSIGN
      122          FRAME D-Dialog:SCROLLABLE       = FALSE
      123          FRAME D-Dialog:HIDDEN           = TRUE.
      124   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      125   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      126   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      127   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      128   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      129   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      130   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      131   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      132       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      133   RUN ensure-broker.
      134   THIS-PROCEDURE:ADM-DATA =
      135        'ADM1.1~`':U +
      136        'SmartDialog~`':U +
      137        'DIALOG-BOX~`':U +
      138        'NO ~`':U +
      139        '~`':U +
      140        '~`':U +
      141        '~`':U +
      142        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      143           + "~`":U +
      144        'Layout,Hide-on-Init~`':U +
      145        '~`':U +
      146        '~`':U +
      147        '~`~`~`~`~`~`~`~`~`~`~`':U +
      148        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      149            THEN "^^":U
      150        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      151             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      152   PROCEDURE adm-apply-entry :
      153     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      154   END PROCEDURE.
      155   PROCEDURE adm-destroy :
      156    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      157   END PROCEDURE.
      158   PROCEDURE adm-disable :
      159       DISABLE  WITH FRAME D-Dialog.
      160       RUN dispatch ('disable-fields':U).
      161       RUN set-attribute-list ('ENABLED=no':U).
      162       RETURN.
      163   END PROCEDURE.
      164   PROCEDURE adm-edit-attribute-list :
      165         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      166         RETURN.
      167   END PROCEDURE.
      168   PROCEDURE adm-enable :
      169       ENABLE UNLESS-HIDDEN  WITH FRAME D-Dialog.
      170       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      171       RUN set-attribute-list ('ENABLED=yes':U).
      172       RETURN.
      173   END PROCEDURE.
      174   PROCEDURE adm-exit :
      175        RUN notify ('exit':U).
      176     RETURN.
      177   END PROCEDURE.
      178   PROCEDURE adm-hide :
      179     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      180   END PROCEDURE.
      181   PROCEDURE adm-initialize :
      182     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      183   END PROCEDURE.
      184   PROCEDURE adm-show-errors :
      185       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      186       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      187           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      188       END.
      189       RETURN.
      190   END PROCEDURE.
      191   PROCEDURE adm-UIB-mode :
      192     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      193   END PROCEDURE.
      194   PROCEDURE adm-view :
      195     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      196   END PROCEDURE.
      197   PROCEDURE dispatch :
      198       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      199       RUN broker-dispatch IN adm-broker-hdl
      200           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      201       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      202   END PROCEDURE.
      203   PROCEDURE ensure-broker :
      204   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      205   IF RETURN-VALUE NE "ADM-Broker":U THEN
      206   DO:
      207       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      208       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      209   END.
      210   END PROCEDURE.
      211   PROCEDURE get-attribute :
      212     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      213     RUN broker-get-attribute IN adm-broker-hdl
      214         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      215     RETURN RETURN-VALUE.
      216   END PROCEDURE.
      217   PROCEDURE get-attribute-list :
      218     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      219     RUN broker-get-attribute-list IN adm-broker-hdl
      220         (INPUT THIS-PROCEDURE,
      221          INPUT ?,
      222          OUTPUT p-attr-list) NO-ERROR.
      223     RETURN.
      224   END PROCEDURE.
      225   PROCEDURE new-state :
      226     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      227     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      228     RETURN.
      229   END PROCEDURE.
      230   PROCEDURE notify :
      231     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      232     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      233     IF RETURN-VALUE = "ADM-ERROR":U THEN
      234         RETURN "ADM-ERROR":U.
      235     RETURN.
      236   END PROCEDURE.
      237   PROCEDURE set-attribute-list :
      238     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      239     RUN ensure-broker.
      240     RUN broker-set-attribute-list IN adm-broker-hdl
      241         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      242     RETURN.
      243   END PROCEDURE.
      244   PROCEDURE set-position :
      245       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      246       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      247       IF VALID-HANDLE(adm-object-hdl) THEN
      248       DO:
      249           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      250           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      251           DO:
      252             IF p-row = 0 THEN p-row =
      253               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      254             IF p-col = 0 THEN p-col =
      255               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      256           END.
      257           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      258           DO:
      259             parent-hdl = adm-object-hdl:PARENT.
      260             IF p-row = 0 THEN p-row =
      261               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      262                 parent-hdl:ROW.
      263             IF p-col = 0 THEN p-col =
      264               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      265                 parent-hdl:COL.
      266           END.
      267           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      268           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      269         ASSIGN adm-object-hdl:ROW    =   p-row
      270                adm-object-hdl:COLUMN =   p-col.
      271       END.
      272       RETURN.
      273   END PROCEDURE.
      274   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      275       STRING(adm-object-hdl)).
      276   PAUSE 0 BEFORE-HIDE.
      277   PROCEDURE adm-change-page :
      278     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      279     END PROCEDURE.
      280   PROCEDURE delete-page :
      281     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      282     RUN broker-delete-page IN adm-broker-hdl
      283         (INPUT THIS-PROCEDURE, INPUT p-page#).
      284     END PROCEDURE.
      285   PROCEDURE init-object :
      286     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      287     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      288     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      289     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      290     RUN broker-init-object IN adm-broker-hdl
      291         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      292          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      293     RETURN.
      294   END PROCEDURE.
      295   PROCEDURE init-pages :
      296     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      297     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      298         INPUT p-page-list) NO-ERROR.
      299     END PROCEDURE.
      300   PROCEDURE select-page :
      301     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      302     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      303         INPUT p-page#) NO-ERROR.
      304     END PROCEDURE.
      305   PROCEDURE view-page :
      306     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      307     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      308         INPUT p-page#).
      309     END PROCEDURE.
      310   ON WINDOW-CLOSE OF FRAME D-Dialog
      311   DO:
      312     APPLY "END-ERROR":U TO SELF.
      313   END.
      314   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      315       MESSAGE "A SmartDialog is not intended ":U SKIP
      316               "to be run Persistent or to be placed ":U SKIP
      317               "in another SmartObject at UIB design time.":U
      318               VIEW-AS ALERT-BOX ERROR.
      319       RUN disable_UI.
      320       DELETE PROCEDURE THIS-PROCEDURE.
      321       RETURN.
      322   END.
      323   RUN dispatch ('create-objects':U).
      324   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      325   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      326   MAIN-BLOCK:
      327   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      328      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      329     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      330     WAIT-FOR GO OF FRAME D-Dialog.
      331   END.
      332   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      333   PROCEDURE adm-create-objects :
      334     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      335     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      336     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      337     CASE adm-current-page:
      338       WHEN 0 THEN DO:
      339          RUN init-object IN THIS-PROCEDURE (
      340                INPUT  'adm/objects/folder.w':U ,
      341                INPUT  FRAME D-Dialog:HANDLE ,
      342                INPUT  'FOLDER-LABELS = ':U + 'документ|строки|архив' + ',
      343                        FOLDER-TAB-TYPE = 1':U ,
      344                OUTPUT h_folder ).
      345          RUN set-position IN h_folder ( 1.00 , 1.13 ) NO-ERROR.
      346          RUN set-size IN h_folder ( 21.63 , 98.75 ) NO-ERROR.
      347          RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).
      348       END.
      349       WHEN 1 THEN DO:
      350          RUN init-object IN THIS-PROCEDURE (
      351                INPUT  'utl/b-t-doc.w':U ,
      352                INPUT  FRAME D-Dialog:HANDLE ,
      353                INPUT  'Layout = ':U ,
      354                OUTPUT h_b-t-doc ).
      355          RUN set-position IN h_b-t-doc ( 2.13 , 1.63 ) NO-ERROR.
      356          RUN init-object IN THIS-PROCEDURE (
      357                INPUT  'utl/v-t-doc.w':U ,
      358                INPUT  FRAME D-Dialog:HANDLE ,
      359                INPUT  'Layout = ':U ,
      360                OUTPUT h_v-t-doc ).
      361          RUN set-position IN h_v-t-doc ( 8.88 , 1.63 ) NO-ERROR.
      362          RUN add-link IN adm-broker-hdl ( h_b-t-doc , 'Record':U , h_v-t-doc ).
      363       END.
      364       WHEN 2 THEN DO:
      365          RUN init-object IN THIS-PROCEDURE (
      366                INPUT  'utl/b-dl.w':U ,
      367                INPUT  FRAME D-Dialog:HANDLE ,
      368                INPUT  'Layout = ':U ,
      369                OUTPUT h_b-dl ).
      370          RUN set-position IN h_b-dl ( 2.33 , 1.63 ) NO-ERROR.
      371          RUN init-object IN THIS-PROCEDURE (
      372                INPUT  'utl/b-gdsdtl.w':U ,
      373                INPUT  FRAME D-Dialog:HANDLE ,
      374                INPUT  'Layout = ':U ,
      375                OUTPUT h_b-gdsdtl ).
      376          RUN set-position IN h_b-gdsdtl ( 9.08 , 1.63 ) NO-ERROR.
      377          RUN init-object IN THIS-PROCEDURE (
      378                INPUT  'utl/b-prt.w':U ,
      379                INPUT  FRAME D-Dialog:HANDLE ,
      380                INPUT  'Layout = ':U ,
      381                OUTPUT h_b-prt ).
      382          RUN set-position IN h_b-prt ( 15.88 , 1.63 ) NO-ERROR.
      383          RUN init-pages IN THIS-PROCEDURE ('1') NO-ERROR.
      384          RUN add-link IN adm-broker-hdl ( h_b-t-doc , 'Record':U , h_b-dl ).
      385          RUN add-link IN adm-broker-hdl ( h_b-dl , 'Record':U , h_b-gdsdtl ).
      386          RUN add-link IN adm-broker-hdl ( h_b-dl , 'Record':U , h_b-prt ).
      387       END.
      388       WHEN 3 THEN DO:
      389          RUN init-object IN THIS-PROCEDURE (
      390                INPUT  'utl/b-ot-tot.w':U ,
      391                INPUT  FRAME D-Dialog:HANDLE ,
      392                INPUT  'Layout = ':U ,
      393                OUTPUT h_b-ot-tot ).
      394          RUN set-position IN h_b-ot-tot ( 2.33 , 2.75 ) NO-ERROR.
      395          RUN init-object IN THIS-PROCEDURE (
      396                INPUT  'utl/b-dl.w':U ,
      397                INPUT  FRAME D-Dialog:HANDLE ,
      398                INPUT  'Layout = ':U ,
      399                OUTPUT h_b-dl-2 ).
      400          RUN set-position IN h_b-dl-2 ( 9.17 , 2.50 ) NO-ERROR.
      401          RUN init-object IN THIS-PROCEDURE (
      402                INPUT  'utl/b-otline.w':U ,
      403                INPUT  FRAME D-Dialog:HANDLE ,
      404                INPUT  'Layout = ':U ,
      405                OUTPUT h_b-otline ).
      406          RUN set-position IN h_b-otline ( 16.00 , 2.50 ) NO-ERROR.
      407          RUN init-pages IN THIS-PROCEDURE ('1') NO-ERROR.
      408          RUN add-link IN adm-broker-hdl ( h_b-t-doc , 'Record':U , h_b-ot-tot ).
      409          RUN add-link IN adm-broker-hdl ( h_b-t-doc , 'Record':U , h_b-dl-2 ).
      410          RUN add-link IN adm-broker-hdl ( h_b-dl-2 , 'Record':U , h_b-otline ).
      411       END.
      412     END CASE.
      413     IF adm-current-page eq 0
      414     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
      415   END PROCEDURE.
      416   PROCEDURE adm-row-available :
      417     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      418     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      419     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      420     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      421     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      422     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      423     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      424     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      425     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      426     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      427     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      428     IF adm-updating-record THEN RETURN.
      429     RUN get-attribute ('FIELDS-ENABLED':U).
      430     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      431     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      432         OUTPUT link-handle) NO-ERROR.
      433     IF link-handle = "":U THEN
      434         RETURN.
      435     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      436     IF NUM-ENTRIES(link-handle) > 1 THEN
      437         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      438             "encountered more than one RECORD-SOURCE.":U SKIP
      439             "The first - ":U record-source-hdl:file-name " - will be used.":U
      440                VIEW-AS ALERT-BOX ERROR.
      441     RUN get-attribute ('Key-Name':U).
      442     key-name = RETURN-VALUE.
      443     IF key-name = "":U THEN key-name = ?.
      444     IF key-name NE ? THEN DO:
      445       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      446         NO-ERROR.
      447       IF key-value NE ? THEN
      448         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      449     END.
      450   IF VALID-HANDLE (adm-object-hdl) THEN
      451       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      452   RUN notify IN THIS-PROCEDURE ('row-available':U).
      453   END PROCEDURE.
      454   PROCEDURE disable_UI :
      455     HIDE FRAME D-Dialog.
      456   END PROCEDURE.
      457   PROCEDURE enable_UI :
      458     VIEW FRAME D-Dialog.
      459   END PROCEDURE.
      460   PROCEDURE send-records :
      461   END PROCEDURE.
      462   PROCEDURE state-changed :
      463     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      464     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      465   END PROCEDURE.
