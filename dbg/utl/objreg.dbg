        1   define temp-table tt-objth no-undo
        2       field iNum       as integer
        3       field objhndl    as class Progress.Lang.Object
        4       field propname   as character
        5       field label_     as character
        6       field objname    as character
        7       field objparent  as character
        8       field procparent as character
        9   index pparent objparent propname
       10   index objname objname
       11   .
       12   define variable vss-revision    as character no-undo init "$Revision: $":U .
       13   define variable vss-author      as character no-undo init "$Author: $":U .
       14   define variable vss-date        as character no-undo init "$Date: $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: $":U .
       17   define variable vss-description as character no-undo init "Процедура просмотра объектов зарегистрированых в ObjSRV".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      122   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      123   objsrv:GetTableObjTh(output table tt-objth).
      124   define variable mParent as character no-undo.
      125   mParent = objsrv:ToString().
      126   function getPath returns character (input iobjname as char):
      127      define buffer buf-objth for tt-objth.
      128      define variable oPath as character no-undo.
      129      bloch-tt-obj:
      130      do while true:
      131         find first buf-objth where buf-objth.objname = iobjname no-lock no-error.
      132         if not available buf-objth
      133         then
      134            leave bloch-tt-obj.
      135         else do:
      136            oPath =  ":" + buf-objth.propname + oPath.
      137            iobjname = buf-objth.objparent.
      138         end.
      139      end.
      140      oPath = "ObjSrv" + oPath.
      141      return oPath.
      142   end.
      143   DEFINE BUTTON b-all
      144        LABEL "Все\Ирархия":L
      145        SIZE 15 BY 1.
      146   DEFINE BUTTON b-child
      147        LABEL "Потомоки"
      148        SIZE 10 BY 1.
      149   DEFINE BUTTON b-parent
      150        LABEL "Родитель":L
      151        SIZE 10 BY 1.
      152   DEFINE BUTTON b-exit AUTO-GO
      153        LABEL "&Выход ":L
      154        SIZE 10 BY 1.
      155   DEFINE BUTTON b-copy
      156        LABEL "В буфер ":L
      157        SIZE 10 BY 1.
      158   DEFINE QUERY BROWSE-objreg FOR
      159         tt-objth SCROLLING.
      160   DEFINE BROWSE BROWSE-objreg
      161     QUERY BROWSE-objreg NO-LOCK DISPLAY
      162     tt-objth.propname FORMAT "x(20)"  Label "Имя проперти"
      163     tt-objth.label_  FORMAT "x(20)"  Label "Описание"
      164     tt-objth.objname FORMAT "x(40)" Label "Имя объекта"
      165     tt-objth.objparent FORMAT "x(40)" Label "Имя родителя"
      166     tt-objth.procparent FORMAT "x(40)" Label "Процедура создания"
      167     WIDTH 100
      168       WITH NO-ROW-MARKERS SEPARATORS SIZE 104 BY 11 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      169   DEFINE FRAME f-objreg
      170        b-exit AT ROW 1 COL 1
      171        b-copy AT ROW 1 COL 14
      172        b-all AT ROW 1 COL 24
      173        b-parent AT ROW 1 COL 39 WIDGET-ID 10
      174        b-child AT ROW 1 COL 49 WIDGET-ID 12
      175        BROWSE-objreg AT ROW 2.15 COL 1 WIDGET-ID 300
      176       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      177            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      178            TITLE "Объекты objreg":L.
      179   ASSIGN
      180          FRAME f-objreg:SCROLLABLE       = true.
      181   ON go OF FRAME f-objreg
      182   do:
      183   end.
      184   ON choose OF b-all IN FRAME f-objreg
      185   do:
      186   if mParent = ""
      187   then
      188      mParent = objsrv:ToString().
      189   else
      190      mParent = "".
      191               OPEN QUERY BROWSE-objreg FOR EACH tt-objth       WHERE if mParent eq "" then true else tt-objth.objparent eq mParent NO-LOCK INDEXED-REPOSITION.
      192   end.
      193   ON choose OF b-child IN FRAME f-objreg
      194   do:
      195      if available tt-objth
      196      then do:
      197         mParent = tt-objth.objname.
      198         OPEN QUERY BROWSE-objreg FOR EACH tt-objth       WHERE if mParent eq "" then true else tt-objth.objparent eq mParent NO-LOCK INDEXED-REPOSITION.
      199      end.
      200   end.
      201   on ENTER of BROWSE-objreg in frame f-objreg
      202   anywhere
      203   do:
      204     apply "choose" to b-child IN FRAME f-objreg.
      205   end.
      206   on end-error of BROWSE-objreg in frame f-objreg
      207   anywhere
      208   do:
      209     if     available tt-objth
      210        and tt-objth.objparent ne objsrv:ToString()
      211        and mParent ne ""
      212     then do:
      213        apply "choose" to b-parent IN FRAME f-objreg.
      214        return no-apply.
      215     end.
      216     else
      217        APPLY "GO" TO FRAME f-objreg.
      218   end.
      219   ON choose OF b-copy IN FRAME f-objreg
      220   do:
      221      define variable vpathObj as character no-undo.
      222      if available tt-objth
      223      then do:
      224         vpathObj = getPath(tt-objth.objname).
      225         run gbl/clipbrd.p (vpathObj).
      226         message "Скопироваано в буфер обмена:" skip vpathObj
      227            view-as alert-box.
      228      end.
      229   end.
      230   ON choose OF b-parent IN FRAME f-objreg
      231   do:
      232      define buffer buf-objth for tt-objth.
      233      if available tt-objth
      234      then do:
      235         find first buf-objth where buf-objth.objname eq tt-objth.objparent no-lock no-error.
      236      end.
      237      else
      238         find first buf-objth where buf-objth.objname eq mParent no-lock no-error.
      239      if available buf-objth
      240      then
      241         mParent = buf-objth.objparent.
      242      OPEN QUERY BROWSE-objreg FOR EACH tt-objth       WHERE if mParent eq "" then true else tt-objth.objparent eq mParent NO-LOCK INDEXED-REPOSITION.
      243   end.
      244   if valid-handle(active-window) and frame f-objreg:PARENT eq ?
      245     then frame f-objreg:PARENT = active-window.
      246   on window-close of frame f-objreg
      247     apply "END-ERROR":U to self.
      248   MAIN-BLOCK:
      249   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      250      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK
      251         :
      252     run enable_UI in this-procedure .
      253     wait-for go of frame f-objreg focus BROWSE-objreg.
      254   end.
      255   run disable_UI in this-procedure .
      256   PROCEDURE disable_UI :
      257     HIDE FRAME f-objreg.
      258   END PROCEDURE.
      259   PROCEDURE enable_UI :
      260     enable
      261       BROWSE-objreg
      262       b-exit
      263       b-child
      264       b-all
      265       b-copy
      266       b-parent
      267       with frame f-objreg.
      268     OPEN QUERY BROWSE-objreg FOR EACH tt-objth       WHERE if mParent eq "" then true else tt-objth.objparent eq mParent NO-LOCK INDEXED-REPOSITION.
      269   end procedure.
