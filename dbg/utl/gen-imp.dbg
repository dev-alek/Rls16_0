      907   ':U .
      908   define variable oth-list1 as character no-undo .
      909   define variable oth-list2 as character no-undo .
      910   define variable v-old-sys-alert-box    as logical   no-undo .
      911   define variable v-lib-handle-name   as character no-undo .
      912   define variable file-name           as character no-undo .
      913   define variable file-name-no-ext    as character no-undo .
      914   define variable temp-file-name      as character no-undo .
      915   define variable tn                  as character no-undo init "".
      916   define variable counter-step        as integer   no-undo .
      917   define variable v-str               as character no-undo .
      918   define variable v-num-tbls          as integer   no-undo .
      919   define variable v-ind-tbl           as integer   no-undo init 0.
      920   define variable v-ind-tbl-ignor     as integer   no-undo init 0.
      921   define variable v-ind-tbl-curr      as integer   no-undo init 0.
      922   define variable v-ind-comp          as integer   no-undo init 0.
      923   define variable v-proc-num          as integer   no-undo init 0.
      924   define variable v-err-num           as integer   no-undo .
      925   define variable v-err-size          as integer   no-undo .
      926   define variable v-skip-proc         as integer   no-undo .
      927   define variable v-skip-proc-max     as integer   no-undo .
      928   define variable v-skip-proc-step    as integer   no-undo .
      929   define variable v-skip-proc-min     as integer   no-undo .
      930   define variable v-compile           as logical   no-undo .
      931   define variable inc-avail           as logical   no-undo init no.
      932   define variable inc-file-name       as character no-undo init "".
      933   define variable def-ins-avail       as logical   no-undo init no.
      934   define variable def-ins-file-name   as character no-undo init "".
      935   define variable def-out-avail       as logical   no-undo init no.
      936   define variable def-out-file-name   as character no-undo init "".
      937   define variable v-err-cmp as character no-undo .
      938   define variable v-tmp-str as character no-undo .
      939   define stream ImpStream .
      940   define stream ImpPckStream .
      941   define stream errstream .
      942   def frame ddd
      943     file-name format "x(32)" label "Файл" at row 1.5  col 17 colon-aligned
      944     fl as character format "x(32)" label "Таблица" at row 2.5  col 17 colon-aligned
      945     v-str format "x(35)" label "Обработано" at row 3.5  col 17 colon-aligned
      946     with view-as dialog-box side-labels three-d
      947     title "Генерация файлов " + program-name(1)
      948   .
      949   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   if trim( gen-dir ) = "":U then do:
      951     assign
      952       gen-dir = ".":U
      953     .
      954   end.
      955   assign
      956     file-info:file-name = gen-dir
      957   .
      958   if file-info :full-pathname = ""
      959   or file-info :full-pathname = ?  then do:
      960     message
      961       vss-workfile vss-revision vss-description skip
      962       substitute( "Уазанный каталог (&1) не найден!", gen-dir ) skip
      963       view-as alert-box error .
      964     undo, return error .
      965   end.
      966   assign
      967     gen-dir = file-info:full-pathname + "/":U
      968   .
      969     run gbl/dir-cre.p ( input gen-dir + "nws":U ) no-error .
      970     if error-status:error then do:
      971       message
      972         vss-workfile vss-revision vss-description skip
      973         substitute( "Ошибка при создании каталога &1", gen-dir + "nws":U ) skip
      974         error-status :get-message(1) skip
      975         return-value skip
      976         view-as alert-box error .
      977       undo, return error.
      978     end.
      979   view frame ddd.
      980   assign
      981     v-skip-proc-max  = 30
      982     v-skip-proc-step = 2
      983     v-skip-proc-min  = 2
      984     v-skip-proc      = v-skip-proc-max
      985     counter-step     = 0
      986     file-name        = "nws/load-rec.p":U
      987     file-name-no-ext = "load-rec":U
      988     temp-file-name   = substitute( "&1.p0":U, file-name-no-ext )
      989     gen-file-list    = gen-file-list + "," + "nws/imp-pck1.i":U
      990                                      + "," + "nws/imp-pck2.i":U
      991                                      + "," + "nws/imp-pck3.i":U
      992   .
      993   OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck1.i":U ) .
      994   PUT STREAM ImpStream UNFORMATTED
      995     chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + chr(10) + "Автор: Уханов Дмитрий Юрьевич":U + chr(10) + "Дата создания: 01/27/03":U + chr(10) + "Author: Dmitry Ukhanov":U + chr(10) + "Creation date: 01/27/03":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10) SKIP(1)
      996     '~&scoped-define vssseq ~{~&sequence~}             ' SKIP
      997     'define variable vss-include-info~{~&vssseq~} as character format "x(65)" no-undo initial "@(#)$Workfile: gen-imp.p $ $Revision: b39224d84de3, 3188, rls $".' SKIP(1)
      998     'define variable v-proc-name  as character no-undo .' SKIP
      999     'define variable v-proc-avail as logical   no-undo .' SKIP(1)
     1000   .
     1001   OUTPUT STREAM ImpStream CLOSE.
     1002   OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck2.i":U ) .
     1003   PUT STREAM ImpStream UNFORMATTED
     1004     chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + chr(10) + "Автор: Уханов Дмитрий Юрьевич":U + chr(10) + "Дата создания: 01/27/03":U + chr(10) + "Author: Dmitry Ukhanov":U + chr(10) + "Creation date: 01/27/03":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10) SKIP(1)
     1005     '~&scoped-define vssseq ~{~&sequence~}             ' SKIP
     1006     'define variable vss-include-info~{~&vssseq~} as character format "x(65)" no-undo initial "@(#)$Workfile: gen-imp.p $ $Revision: b39224d84de3, 3188, rls $".' SKIP(1)
     1007     'assign                                             ' SKIP
     1008     '  v-proc-name = substitute( "proc-load-&1", ~{1} ) ' SKIP
     1009     '  v-proc-avail = FALSE                             ' SKIP
     1010     '.                                                  ' SKIP
     1011   .
     1012   OUTPUT STREAM ImpStream CLOSE.
     1013   OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck3.i":U ) .
     1014   PUT STREAM ImpStream UNFORMATTED
     1015     chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + chr(10) + "Автор: Уханов Дмитрий Юрьевич":U + chr(10) + "Дата создания: 01/27/03":U + chr(10) + "Author: Dmitry Ukhanov":U + chr(10) + "Creation date: 01/27/03":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10) SKIP(1)
     1016     '~&scoped-define vssseq ~{~&sequence~}             ' SKIP
     1017     'define variable vss-include-info~{~&vssseq~} as character format "x(65)" no-undo initial "@(#)$Workfile: gen-imp.p $ $Revision: b39224d84de3, 3188, rls $".' SKIP(1)
     1018   .
     1019   OUTPUT STREAM ImpStream CLOSE.
     1020   assign
     1021     v-ind-tbl  = 0
     1022     v-proc-num = 0
     1023     v-num-tbls = num-entries( news-list )
     1024   .
     1025   block_compile:
     1026   do while v-ind-tbl < v-num-tbls
     1027   :
     1028     assign
     1029       v-lib-handle-name = 'g#' + file-name-no-ext .
     1030     .
     1031     OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck1.i":U ) APPEND.
     1032     PUT STREAM ImpStream UNFORMATTED
     1033       SPACE(0) 'define new global shared variable ' v-lib-handle-name '  as handle no-undo .' SKIP(1)
     1034     .
     1035     OUTPUT STREAM ImpStream CLOSE.
     1036     OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck2.i":U ) APPEND.
     1037     PUT STREAM ImpStream UNFORMATTED
     1038       SPACE(0) 'if (valid-handle(' v-lib-handle-name ') <> true) then do:                                           ' SKIP
     1039       SPACE(0) '  run ' file-name ' persistent no-error .                                                           ' SKIP
     1040       SPACE(0) '  if error-status :error or (valid-handle(' v-lib-handle-name ') <> true) then do:                  ' SKIP
     1041       SPACE(0) '    message                                                                                         ' SKIP
     1042       SPACE(0) '      "Error starting ' file-name '" skip                                                           ' SKIP
     1043       SPACE(0) '      error-status :get-message(1) skip                                                             ' SKIP
     1044       SPACE(0) '      return-value skip                                                                             ' SKIP
     1045       SPACE(0) '      view-as alert-box error .                                                                     ' SKIP
     1046       SPACE(0) '    stop .                                                                                          ' SKIP
     1047       SPACE(0) '  end.                                                                                              ' SKIP
     1048       SPACE(0) 'end.                                                                                                ' SKIP
     1049       SPACE(0) 'if lookup( v-proc-name, ' v-lib-handle-name ':internal-entries ) > 0 then do:                       ' SKIP
     1050       SPACE(0) '  if v-proc-avail = TRUE then do:                                                                   ' SKIP
     1051       SPACE(0) '    return error substitute( "&1. Рассогласованы библиотеки приема новостей для таблицы &2"         ' SKIP
     1052       SPACE(0) '                             ,vss-workfile                                                          ' SKIP
     1053       SPACE(0) '                             ,~{1~}                                                                 ' SKIP
     1054       SPACE(0) '                           ).                                                                       ' SKIP
     1055       SPACE(0) '  end.                                                                                              ' SKIP
     1056       SPACE(0) '  run value(v-proc-name) in ' v-lib-handle-name '                                                   ' SKIP
     1057       SPACE(0) '      ( input this-procedure                                                                        ' SKIP
     1058       SPACE(0) '       ,input ~{3~}                                                                                 ' SKIP
     1059       SPACE(0) '       ,input ~{4~}                                                                                 ' SKIP
     1060       SPACE(0) '      ).                                                                                            ' SKIP
     1061       SPACE(0) '  assign                                                                                            ' SKIP
     1062       SPACE(0) '    v-proc-avail = TRUE                                                                             ' SKIP
     1063       SPACE(0) '  .                                                                                                 ' SKIP
     1064       SPACE(0) 'end.                                                                                                ' SKIP(1)
     1065     .
     1066     OUTPUT STREAM ImpStream CLOSE.
     1067     assign
     1068       gen-file-list = gen-file-list + "," + file-name
     1069     .
     1070     OUTPUT STREAM ImpPckStream TO value( gen-dir + file-name ).
     1071     PUT STREAM ImpPckStream UNFORMATTED
     1072       chr(47) + chr(42) + chr(10) + chr(10) + chr(36) + 'Revision: ':U + chr(36) + chr(10) + chr(36) + 'Author: ':U + chr(36) + chr(10) + chr(36) + 'Date: ':U + chr(36) + chr(10) + chr(36) + 'Workfile: ':U + chr(36) + chr(10) + chr(36) + 'Archive: ':U + chr(36) + chr(10) + chr(10) + 'ФАЙЛ ГЕНЕРИРУЕТСЯ ПРОЦЕДУРОЙ ' + program-name(1) + chr(10) + chr(10) + chr(10) + "Автор: Уханов Дмитрий Юрьевич":U + chr(10) + "Дата создания: 01/27/03":U + chr(10) + "Author: Dmitry Ukhanov":U + chr(10) + "Creation date: 01/27/03":U + chr(10) + chr(10) + chr(42) + chr(47) + chr(10) SKIP
     1073       chr(47) + chr(42) + ' Импорт строки из файла ' + chr(42) + chr(47) SKIP(2)
     1074       'define variable vss-revision    as character no-undo init "$Revision: b39224d84de3, 3188, rls $":U .                    ' SKIP
     1075       'define variable vss-author      as character no-undo init "$Author: EShklyar $":U .                 ' SKIP
     1076       'define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:26 $":U .             ' SKIP
     1077       'define variable vss-workfile    as character no-undo init "$Workfile: gen-imp.p $":U .             ' SKIP
     1078       'define variable vss-archive     as character no-undo init "$Archive: utl/gen-imp.p $":U . ' SKIP
     1079       'define variable vss-description as character no-undo init "загрузка в БД строки".                  ' SKIP
     1080       '~{ cmp/vssrevis.i ~}                                                                               ' SKIP
     1081       '~{ cmp/trg-def.i  ~}                                                                               ' SKIP
     1082       '~{ nws/nws-def.i  ~}                                                                               ' SKIP
     1083       '~{ gbl/key-rec.i  ~}                                                                               ' SKIP
     1084       '~{ gbl/attr-lib.i  ~}                                                                              ' SKIP
     1085       '~{ ' "nws/imp-pck1.i":U ' ~}                                                                              ' SKIP(1)
     1086     .
     1087     OUTPUT STREAM ImpPckStream close.
     1088     os-copy value( gen-dir + file-name ) value( gen-dir + temp-file-name ) .
     1089     assign
     1090       v-compile       = true
     1091       v-ind-comp      = 0
     1092       v-ind-tbl-curr  = 0
     1093       v-ind-tbl-ignor = 0
     1094     .
     1095   bl-tn:
     1096     do while v-compile = true
     1097              and v-ind-tbl < v-num-tbls
     1098     :
     1099       assign
     1100         v-ind-tbl = v-ind-tbl + 1
     1101         tn        = entry( v-ind-tbl, news-list )
     1102       .
     1103       display
     1104         file-name
     1105         tn @ fl
     1106         substitute( "&1 из &2", v-ind-tbl, v-num-tbls ) @ v-str
     1107         with frame ddd .
     1108       find ub._file no-lock
     1109         where ub._file._file-name = tn  no-error.
     1110         if not available  ub._file
     1111         then do:
     1112            message "Базе нет таблицы " tn
     1113            view-as alert-box.
     1114            next bl-tn.
     1115         end.
     1116       assign
     1117         inc-file-name     = "nws/inc/imp/" + ub._File._Dump-name + ".i"
     1118         inc-avail     = ( if search( inc-file-name ) <> ? then TRUE else FALSE )
     1119         def-ins-file-name = "nws/inc/imp/def-ins/" + ub._File._Dump-name + ".i"
     1120         def-ins-avail = ( if search( def-ins-file-name ) <> ? then TRUE else FALSE )
     1121         def-out-file-name = "nws/inc/imp/def-out/" + ub._File._Dump-name + ".i"
     1122         def-out-avail = ( if search( def-out-file-name ) <> ? then TRUE else FALSE )
     1123         .
     1124       if tn = "pck-rcvd":U
     1125         or tn = "pck-sent":U
     1126         or ( inc-avail = false
     1127              and def-ins-avail = false
     1128              and def-out-avail = false
     1129            )
     1130       then do:
     1131         assign
     1132           v-ind-tbl-ignor = v-ind-tbl-ignor + 1
     1133         .
     1134       end.
     1135       else do:
     1136         assign
     1137           v-ind-tbl-curr = v-ind-tbl-curr + 1
     1138           v-proc-num     = v-proc-num + 1
     1139         .
     1140         OUTPUT STREAM ImpPckStream TO value( gen-dir + file-name ) append.
     1141         if v-ind-tbl-curr = 1 then do:
     1142           PUT STREAM ImpPckStream UNFORMATTED
     1143             SPACE(0) 'if valid-handle (' v-lib-handle-name ')                                 ' SKIP
     1144             SPACE(0) 'and ' v-lib-handle-name ' <> this-procedure :handle                     ' SKIP
     1145             SPACE(0) 'and lookup( "proc-load-' tn '":U, ' v-lib-handle-name ':internal-entries ) > 0 ' SKIP
     1146             SPACE(0) 'then do:                                                                ' SKIP
     1147             SPACE(0) '  message                                                               ' SKIP
     1148             SPACE(0) '    vss-workfile vss-revision vss-description skip                      ' SKIP
     1149             SPACE(0) '    "Попытка повторной загрузки библиотеки" skip                        ' SKIP
     1150             SPACE(0) '    ' v-lib-handle-name ' skip                                          ' SKIP
     1151             SPACE(0) '    ' v-lib-handle-name ' :type skip                                    ' SKIP
     1152             SPACE(0) '    ' v-lib-handle-name ' :file-name skip                               ' SKIP
     1153             SPACE(0) '    valid-handle(' v-lib-handle-name ') skip                            ' SKIP
     1154             SPACE(0) '    this-procedure :handle skip                                         ' SKIP
     1155             SPACE(0) '    this-procedure :type skip                                           ' SKIP
     1156             SPACE(0) '    this-procedure :file-name skip                                      ' SKIP
     1157             SPACE(0) '    valid-handle(this-procedure) skip                                   ' SKIP
     1158             SPACE(0) '    view-as alert-box error .                                           ' SKIP
     1159             SPACE(0) '  undo, return error return-value .                                     ' SKIP
     1160             SPACE(0) 'end.                                                                    ' SKIP
     1161             SPACE(0) 'else do:                                                                ' SKIP
     1162             SPACE(0) '  assign                                                                ' SKIP
     1163             SPACE(0) '    ' v-lib-handle-name ' = this-procedure :handle                      ' SKIP
     1164             SPACE(0) '  .                                                                     ' SKIP
     1165             SPACE(0) 'end.                                                                    ' SKIP
     1166             SPACE(0) '                                                                        ' SKIP
     1167             SPACE(0) 'if this-procedure :persistent <> true                                   ' SKIP
     1168             SPACE(0) 'then do:                                                                ' SKIP
     1169             SPACE(0) '  message                                                               ' SKIP
     1170             SPACE(0) '    vss-workfile vss-revision vss-description skip                      ' SKIP
     1171             SPACE(0) '    "Ошибка запуска библиотеки" program-name(1) skip                    ' SKIP
     1172             SPACE(0) '    "Попытка запустить ее как обычную процедуру" skip                   ' SKIP
     1173             SPACE(0) '    view-as alert-box error .                                           ' SKIP
     1174             SPACE(0) 'end.                                                                    ' SKIP
     1175             SPACE(0) '                                                                        ' SKIP
     1176             SPACE(0) 'on delete of this-procedure do:                                         ' SKIP
     1177             SPACE(0) '  assign                                                                ' SKIP
     1178             SPACE(0) '    ' v-lib-handle-name ' = ?                                           ' SKIP
     1179             SPACE(0) '  .                                                                     ' SKIP
     1180             SPACE(0) 'end.                                                                    ' SKIP(1)
     1181             .
     1182         end.
     1183         if def-out-avail then do:
     1184           PUT STREAM ImpPckStream UNFORMATTED
     1185             '~{ ' def-out-file-name ' }' SKIP
     1186             .
     1187         end.
     1188         PUT STREAM ImpPckStream UNFORMATTED
     1189           SPACE(0) 'define temp-table wt-' tn ' no-undo like ub.' tn '. ' SKIP
     1190           SPACE(0) 'PROCEDURE proc-load-' tn ': ' chr(47) + chr(42) ' ' v-proc-num ' ' chr(42) + chr(47) SKIP
     1191           SPACE(2) 'define input parameter p-imp-handle as handle  no-undo.' SKIP
     1192           SPACE(2) 'define input parameter p-pck-num    as integer no-undo.' SKIP
     1193           SPACE(2) 'define input parameter l-counter    as integer no-undo.' SKIP
     1194           SPACE(2) 'do                                                  ' SKIP
     1195           SPACE(2) 'on error  undo, return error substitute( "$proc-load-' tn '. &1&2&3", return-value, ~{&new-line~}, error-status :get-message ( error-status :num-messages ) ) ' SKIP
     1196           SPACE(2) 'on stop   undo, return error substitute( "$proc-load-' tn '. stop" )   ' SKIP
     1197           SPACE(2) 'on endkey undo, return error substitute( "$proc-load-' tn '. endkey" ) ' SKIP
     1198           SPACE(2) ':                                                   ' SKIP
     1199           SPACE(2) '  define buffer tb-' tn ' for ub.' tn '.            ' SKIP
     1200           SPACE(2) '  define variable compare-log as logical no-undo.   ' SKIP
     1201           .
     1202         if def-ins-avail then do:
     1203           PUT STREAM ImpPckStream UNFORMATTED
     1204             SPACE(2) '  ~{ ' def-ins-file-name ' }' SKIP
     1205             .
     1206         end.
     1207         PUT STREAM ImpPckStream UNFORMATTED
     1208           SPACE(2) '  for each wt-' tn '  ' SKIP
     1209           SPACE(2) '  on error undo, return error substitute( "$proc-load-' tn '(del-wt-). &1&2&3", return-value, ~{&new-line~}, error-status :get-message ( error-status :num-messages ) )  ' SKIP
     1210           SPACE(2) '  :' SKIP
     1211           SPACE(2) '    delete wt-' tn ' . ' SKIP
     1212           SPACE(2) '  end. ' SKIP
     1213           SPACE(2) '  create wt-' tn '.                    ' SKIP
     1214           SPACE(2) '  run nws-impl in p-imp-handle         ' SKIP
     1215           SPACE(2) '    ( input ~{&table_' tn '~}          ' SKIP
     1216           SPACE(2) '     ,input (buffer wt-' tn ':handle)  ' SKIP
     1217           SPACE(2) '    ) no-error.                        ' SKIP
     1218           SPACE(2) '  if error-status :error then do:      ' SKIP
     1219           SPACE(2) '    return error return-value .        ' SKIP
     1220           SPACE(2) '  end.                                 ' SKIP
     1221           SPACE(2) '  find first tb-' tn '                 ' SKIP
     1222           SPACE(2) '    where '
     1223           .
     1224         find ub._index no-lock
     1225           where recid( ub._index  ) = ub._file._prime-index.
     1226         for each ub._index-field of ub._index  no-lock ,
     1227             each ub._field of _index-field no-lock
     1228             break by _index-seq:
     1229           PUT STREAM ImpPckStream UNFORMATTED
     1230             'tb-' tn '.' ub._field._field-name ' = wt-' tn '.' ub._field._field-name SKIP.
     1231           if not last( _index-seq ) then do:
     1232             PUT STREAM ImpPckStream UNFORMATTED  SPACE(8) 'and ' .
     1233           end.
     1234         end.
     1235         PUT STREAM ImpPckStream UNFORMATTED
     1236           SPACE(6) 'exclusive-lock no-error.' SKIP
     1237           .
     1238         if not inc-avail then do:
     1239           PUT STREAM ImpPckStream UNFORMATTED
     1240             SPACE(2) '  if l-counter <> 0 then do:                                                                                      ' SKIP
     1241             SPACE(2) '    return error substitute( "&1 &2. Ошибка обработки записи &3", vss-workfile, vss-revision, ~{&table_' tn '~} ) ' SKIP
     1242             SPACE(2) '                 + ~{&new-line~} + "Есть привязанные записи, а обработка идет для одной".                         ' SKIP
     1243             SPACE(2) '  end.                                                                                                            ' SKIP
     1244             SPACE(2) '  if not available tb-' tn ' then do:                                                                             ' SKIP
     1245             SPACE(2) '    create tb-' tn '.                                                                                             ' SKIP
     1246             SPACE(2) '    assign compare-log = no.                                                                                      ' SKIP
     1247             SPACE(2) '  end.                                                                                                            ' SKIP
     1248             SPACE(2) '  else do:                                                                                                        ' SKIP
     1249             SPACE(2) '    buffer-compare tb-' tn ' TO wt-' tn ' case-sensitive save result in compare-log no-error.                     ' SKIP
     1250             SPACE(2) '  end.                                                                                                            ' SKIP
     1251             SPACE(2) '  if not compare-log then do:                                                                                     ' SKIP
     1252             SPACE(2) '    buffer-copy wt-' tn ' TO tb-' tn '.                                                                           ' SKIP
     1253             SPACE(2) '  end.                                                                                                            ' SKIP
     1254             .
     1255         end.
     1256         else do:
     1257           PUT STREAM ImpPckStream UNFORMATTED
     1258             SPACE(2)  '  ~{ ' inc-file-name ' ~} ' SKIP
     1259             .
     1260         end.
     1261         PUT STREAM ImpPckStream UNFORMATTED
     1262           SPACE(2)  '  delete wt-' tn '.                                                                  ' SKIP
     1263           SPACE(2)  'end.                                                                                 ' SKIP
     1264           SPACE(0)  'END PROCEDURE. ' chr(47) + chr(42) ' proc-load-' tn ' ' v-proc-num ' ' chr(42) + chr(47) '' SKIP(1)
     1265           .
     1266         OUTPUT STREAM ImpPckStream close.
     1267         assign
     1268           v-ind-comp = v-ind-comp + 1
     1269         .
     1270       end.
     1271       if v-ind-tbl = v-num-tbls then do:
     1272         assign
     1273           v-skip-proc = v-ind-comp
     1274         .
     1275       end.
     1276       if v-ind-comp = v-skip-proc then do:
     1277         assign
     1278           v-ind-comp = 0
     1279           v-old-sys-alert-box    = session :system-alert-boxes
     1280           session :system-alert-boxes = false
     1281         .
     1282         output to value( gen-dir + "cmp-err.txt":U) .
     1283         COMPILE value( gen-dir + file-name ) .
     1284         assign
     1285           v-err-num  = error-status :GET-NUMBER(1)
     1286           v-err-size = seek(output)
     1287         .
     1288         output close .
     1289         assign
     1290           session :system-alert-boxes = v-old-sys-alert-box
     1291         .
     1292         if error-status :error
     1293           or compiler :error
     1294         then do:
     1295           input stream errstream from value( gen-dir + "cmp-err.txt":U).
     1296           repeat :
     1297             import stream errstream unformatted v-tmp-str .
     1298             if substring( v-tmp-str, length(v-tmp-str) - 5, 6)  = "(3307)" then do:
     1299               assign
     1300                 v-err-num = 3307
     1301               .
     1302             end.
     1303             assign
     1304               v-err-cmp = v-err-cmp + chr(10) + v-tmp-str
     1305             .
     1306           end.
     1307           input stream errstream close.
     1308           if v-err-num <> 3307 then do:
     1309             message
     1310               vss-workfile vss-revision vss-description skip
     1311               substitute( "Ошибка компиляции файла &1 строка &2", COMPILER:FILENAME, COMPILER:ERROR-ROW ) skip
     1312               v-err-cmp skip
     1313               error-status :get-message(1) skip
     1314               view-as alert-box error .
     1315             return error.
     1316           end.
     1317           else do:
     1318             assign
     1319               v-err-size = 123
     1320             .
     1321           end.
     1322         end.
     1323         if compiler :warning
     1324           or v-err-size <> 0
     1325         then do:
     1326           assign
     1327             v-compile       = false
     1328             v-proc-num      = v-proc-num - v-skip-proc
     1329             v-ind-tbl       = v-ind-tbl - v-skip-proc - v-ind-tbl-ignor
     1330           .
     1331           if v-ind-tbl-curr > v-skip-proc
     1332             or ( v-ind-tbl-curr <= v-skip-proc
     1333                  and v-skip-proc > v-skip-proc-min
     1334                )
     1335           then do:
     1336             if v-skip-proc > v-skip-proc-min
     1337               and v-skip-proc > v-skip-proc-step
     1338             then do:
     1339               assign
     1340                 v-ind-tbl-curr = v-ind-tbl-curr - v-skip-proc
     1341                 v-compile   = true
     1342               .
     1343               if v-skip-proc - v-skip-proc-step >= v-skip-proc-min then do:
     1344                 assign
     1345                   v-skip-proc = v-skip-proc - v-skip-proc-step
     1346                 .
     1347               end.
     1348               else do:
     1349                 assign
     1350                   v-skip-proc = v-skip-proc-min
     1351                 .
     1352               end.
     1353             end.
     1354             else do:
     1355               assign
     1356                 v-skip-proc = v-skip-proc-max
     1357               .
     1358             end.
     1359             os-copy value( gen-dir + temp-file-name ) value( gen-dir + file-name ) .
     1360           end.
     1361           else do:
     1362             message
     1363               vss-workfile vss-revision vss-description skip
     1364               substitute( "&1 процедуры не помещаются в один генерируемый файл", v-skip-proc ) skip
     1365               view-as alert-box error .
     1366             leave block_compile.
     1367           end.
     1368         end.
     1369         else do:
     1370           os-copy value( gen-dir + file-name ) value( gen-dir + temp-file-name ) .
     1371           if v-skip-proc = v-skip-proc-min then do:
     1372             assign
     1373               v-compile   = false
     1374               v-skip-proc = v-skip-proc-max
     1375             .
     1376           end.
     1377           else do:
     1378             if v-skip-proc < v-skip-proc-max
     1379               and v-skip-proc - v-skip-proc-step >= v-skip-proc-min
     1380             then do:
     1381               assign
     1382                 v-skip-proc = v-skip-proc - v-skip-proc-step
     1383               .
     1384             end.
     1385           end.
     1386         end.
     1387         assign
     1388           v-ind-tbl-ignor = 0
     1389         .
     1390       end.
     1391     end.
     1392     os-delete
     1393       value( gen-dir + temp-file-name )
     1394       value( gen-dir + "cmp-err.txt":U)
     1395     .
     1396     if v-ind-tbl < v-num-tbls then do:
     1397       assign
     1398         file-name        = substitute( "nws/l-rec-&1.p":U, string( counter-step + 1, "99" ) )
     1399         file-name-no-ext = substitute( "l-rec-&1":U, string( counter-step + 1, "99" ) )
     1400         temp-file-name   = substitute( "&1.p0":U, file-name-no-ext )
     1401         counter-step     = counter-step + 1
     1402       .
     1403     end.
     1404   end.
     1405   OUTPUT STREAM ImpStream TO value( gen-dir + "nws/imp-pck2.i":U ) APPEND.
     1406   PUT STREAM ImpStream UNFORMATTED
     1407     'if v-proc-avail = FALSE then do:                                                                    ' SKIP
     1408     '  run proc-load-standart in this-procedure                                                          ' SKIP
     1409     '      ( input ~{1~}                                                                                 ' SKIP
     1410     '       ,input ~{2~}                                                                                 ' SKIP
     1411     '       ,input ?                                                                                     ' SKIP
     1412     '       ,input this-procedure                                                                        ' SKIP
     1413     '       ,input ~{4~}                                                                                 ' SKIP
     1414     '       ,output ~{5~}                                                                                ' SKIP
     1415     '      ) .                                                                                           ' SKIP
     1416     'end.                                                                                                ' SKIP
     1417   .
     1418   OUTPUT STREAM ImpStream CLOSE.
     1419   hide frame ddd no-pause.
     1420   RETURN.
