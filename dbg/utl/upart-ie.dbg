     1177           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1178         no-error .
     1179         if error-status :error
     1180         or error-status :get-message(1) <> ""
     1181         then do:
     1182           undo move_block, retry move_block.
     1183         end.
     1184         if frame Dialog-Frame :scrollable = true
     1185         then do:
     1186           assign
     1187             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1188           no-error .
     1189           if error-status :error
     1190           or error-status :get-message(1) <> ""
     1191           then do:
     1192             undo move_block, retry move_block.
     1193           end.
     1194         end.
     1195       end.
     1196       if p-move-resize
     1197       then do:
     1198         run diasize_position-resize-button in this-procedure .
     1199       end.
     1200       if v-diasize-wndstore = true
     1201       then do:
     1202         if connected("ub") = true
     1203         then do:
     1204           define variable v-cntxt-db-num        as integer   no-undo .
     1205           define variable v-cntxt-userid        as character no-undo .
     1206           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1207                                             , OUTPUT v-cntxt-userid
     1208                                             ) .
     1209           run gbl/wndsizew.p
     1210             (input  v-cntxt-db-num
     1211             ,input  v-cntxt-userid
     1212             ,input  v-diasize-proc-name
     1213             ,input  'width':u
     1214             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1215             ) .
     1216         end.
     1217       end.
     1218     end.
     1219     assign
     1220       v-diasize-change-size = false
     1221     .
     1222   end procedure.
     1223   procedure diasize_set-width :
     1224     define input  parameter p-new-width  as decimal   no-undo .
     1225     define input  parameter p-move-resize as logical   no-undo .
     1226     do
     1227     on error undo, return error return-value
     1228     :
     1229       run diasize_change-width in this-procedure
     1230         (input  (p-new-width - frame Dialog-Frame :width)
     1231         ,input  p-move-resize
     1232         ) .
     1233     end.
     1234   end procedure.
     1235   procedure diasize_position-resize-button :
     1236     do with frame Dialog-Frame
     1237     :
     1238       hide v-diasize-resize-button .
     1239       assign
     1240         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1241                     - 1
     1242                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1243         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1244                     - 1
     1245                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1246       .
     1247       view v-diasize-resize-button .
     1248     end.
     1249   end procedure.
     1250   on alt-right anywhere
     1251   do:
     1252     run diasize_change-width in this-procedure
     1253       (input 1
     1254       ,input true
     1255       ) .
     1256     return no-apply .
     1257   end.
     1258   on alt-left anywhere
     1259   do:
     1260     run diasize_change-width in this-procedure
     1261       (input -1
     1262       ,input true
     1263       ) .
     1264     return no-apply .
     1265   end.
     1266   on alt-down anywhere
     1267   do:
     1268     run diasize_change-height in this-procedure
     1269       (input 1
     1270       ,input true
     1271       ) .
     1272     return no-apply .
     1273   end.
     1274   on alt-up anywhere
     1275   do:
     1276     run diasize_change-height in this-procedure
     1277       (input -1
     1278       ,input true
     1279       ) .
     1280     return no-apply .
     1281   end.
     1282   on alt-enter of frame Dialog-Frame
     1283   do:
     1284     run diasize_maximize in this-procedure
     1285       (input  ?
     1286       ).
     1287     return no-apply .
     1288   end.
     1289   procedure diasize_end-move :
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       define variable v-row-delta as decimal   no-undo .
     1294       define variable v-col-delta as decimal   no-undo .
     1295       define variable v-new-row as decimal   no-undo .
     1296       define variable v-new-col as decimal   no-undo .
     1297       assign
     1298         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1299         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1300       .
     1301       assign
     1302         v-row-delta = v-new-row - frame Dialog-Frame :height
     1303         v-col-delta = v-new-col - frame Dialog-Frame :width
     1304       .
     1305       run diasize_change-height in this-procedure
     1306         (input v-row-delta
     1307         ,input true
     1308         ) .
     1309       run diasize_change-width in this-procedure
     1310         (input v-col-delta
     1311         ,input true
     1312         ) .
     1313     end.
     1314   end procedure.
     1315   procedure diasize_maximize :
     1316     define input  parameter p-action as logical   no-undo .
     1317     do
     1318     on error undo, return error return-value
     1319     :
     1320       if p-action = ?
     1321       then do:
     1322         if v-diasize-need-maximize = true
     1323         then do:
     1324           assign
     1325             p-action = true
     1326           .
     1327         end.
     1328         else do:
     1329           assign
     1330             p-action = false
     1331           .
     1332         end.
     1333       end.
     1334       if p-action = true
     1335       then do:
     1336         run diasize_change-height in this-procedure
     1337           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1338               - frame Dialog-Frame :height-chars
     1339           ,input true
     1340           ) .
     1341         run diasize_change-width in this-procedure
     1342           (input session :width-chars
     1343               - frame Dialog-Frame :width-chars
     1344           ,input true
     1345           ) .
     1346         assign
     1347           v-diasize-need-maximize = false
     1348         .
     1349       end.
     1350       else do:
     1351         run diasize_change-width in this-procedure
     1352           (input v-diasize-orig-frame-width
     1353               - frame Dialog-Frame :width-chars
     1354           ,input true
     1355           ) .
     1356         run diasize_change-height in this-procedure
     1357           (input v-diasize-orig-frame-height
     1358               - frame Dialog-Frame :height-chars
     1359           ,input true
     1360           ) .
     1361         assign
     1362           v-diasize-need-maximize = true
     1363         .
     1364       end.
     1365     end.
     1366   end procedure.
     1367   procedure diasize_restore-orig-size :
     1368     do
     1369     on error undo, return error return-value
     1370     :
     1371       assign
     1372         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1373         v-diasize-current-frame-height = frame Dialog-Frame :height
     1374       .
     1375       run diasize_set-height in this-procedure
     1376         (input  v-diasize-orig-frame-height
     1377         ,input  true
     1378         ) .
     1379       run diasize_set-width in this-procedure
     1380         (input  v-diasize-orig-frame-width
     1381         ,input  true
     1382         ) .
     1383     end.
     1384   end procedure.
     1385   procedure diasize_restore-current-size :
     1386     do
     1387     on error undo, return error return-value
     1388     :
     1389       run diasize_set-height in this-procedure
     1390         (input  v-diasize-current-frame-height
     1391         ,input  true
     1392         ) .
     1393       run diasize_set-width in this-procedure
     1394         (input  v-diasize-current-frame-width
     1395         ,input  true
     1396         ) .
     1397     end.
     1398   end procedure.
     1399   procedure diasize_set-browse-handle :
     1400     define input  parameter p-browse-handle as handle   no-undo .
     1401     define buffer buf_temp-browse-handle for temp-browse-handle .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       assign
     1406         v-diasize-browse-handle = p-browse-handle
     1407       .
     1408       for each buf_temp-browse-handle
     1409       on error undo, return error return-value
     1410       :
     1411         delete buf_temp-browse-handle .
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure diasize_add_browse :
     1416     define input  parameter p-browse-type   as character no-undo .
     1417     define input  parameter p-browse-handle as handle    no-undo .
     1418     define buffer buf_temp-browse-handle for temp-browse-handle .
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       assign
     1423         v-diasize-browse-number = v-diasize-browse-number + 1
     1424       .
     1425       create buf_temp-browse-handle .
     1426       assign
     1427         buf_temp-browse-handle.browse-type   = p-browse-type
     1428         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1429         buf_temp-browse-handle.browse-handle = p-browse-handle
     1430       .
     1431     end.
     1432   end procedure.
     1433   procedure diasize_init :
     1434     define variable v-default-value    as logical   no-undo .
     1435     define variable v-restore-saved    as logical   no-undo .
     1436     define variable v-resize-value-str as character no-undo .
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       do with frame Dialog-Frame
     1441       :
     1442         assign
     1443           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1444           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1445           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1446         .
     1447         create button v-diasize-resize-button
     1448         assign
     1449           parent        = frame Dialog-Frame :first-child
     1450           label         = "s"
     1451           height-pixels = 16
     1452           width-pixels  = 16
     1453           visible       = true
     1454           sensitive     = true
     1455           movable       = true
     1456           triggers:
     1457             on end-move persistent run diasize_end-move in this-procedure .
     1458           end triggers.
     1459         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1460         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1461         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1462         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1463         assign
     1464           v-diasize-wndmax = false
     1465         .
     1466         if connected("ub") = true
     1467         then do:
     1468           define variable v-cntxt-db-num        as integer   no-undo .
     1469           define variable v-cntxt-userid        as character no-undo .
     1470           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1471                                             , OUTPUT v-cntxt-userid
     1472                                             ) .
     1473           run gbl/wndpar_r.p
     1474             (input  v-cntxt-db-num
     1475             ,input  v-cntxt-userid
     1476             ,input  'wndmax':U
     1477             ,output v-diasize-wndmax
     1478             ,output v-default-value
     1479             ) .
     1480         end.
     1481         assign
     1482           v-diasize-wndstore = false
     1483         .
     1484         if connected("ub") = true
     1485         then do:
     1486           run gbl/wndpar_r.p
     1487             (input  v-cntxt-db-num
     1488             ,input  v-cntxt-userid
     1489             ,input  'wndstore':U
     1490             ,output v-diasize-wndstore
     1491             ,output v-default-value
     1492             ) .
     1493         end.
     1494         assign
     1495           v-diasize-proc-name = entry(1, program-name(2), '.')
     1496         .
     1497         if v-diasize-wndstore = true
     1498         then do:
     1499           assign
     1500             v-restore-saved = false
     1501           .
     1502           if connected("ub") = true
     1503           then do:
     1504             run gbl/wndsizer.p
     1505               (input  v-cntxt-db-num
     1506               ,input  v-cntxt-userid
     1507               ,input  v-diasize-proc-name
     1508               ,input  'height':u
     1509               ,output v-resize-value-str
     1510               ) .
     1511             if v-resize-value-str <> '':U
     1512             then do:
     1513               run diasize_change-height in this-procedure
     1514                 (input  integer(v-resize-value-str)
     1515                 ,input  true
     1516                 ) .
     1517               assign
     1518                 v-restore-saved = true
     1519               .
     1520             end.
     1521           end.
     1522           if connected("ub") = true
     1523           then do:
     1524             run gbl/wndsizer.p
     1525               (input  v-cntxt-db-num
     1526               ,input  v-cntxt-userid
     1527               ,input  v-diasize-proc-name
     1528               ,input  'width':u
     1529               ,output v-resize-value-str
     1530               ) .
     1531             if v-resize-value-str <> '':U
     1532             then do:
     1533               run diasize_change-width in this-procedure
     1534                 (input  integer(v-resize-value-str)
     1535                 ,input  true
     1536                 ) .
     1537               assign
     1538                 v-restore-saved = true
     1539               .
     1540             end.
     1541           end.
     1542           if v-restore-saved <> true
     1543           then do:
     1544             if v-diasize-wndmax = true
     1545             then do:
     1546               run diasize_maximize in this-procedure
     1547                 (input  true
     1548                 ) .
     1549             end.
     1550           end.
     1551         end.
     1552         else do:
     1553           if v-diasize-wndmax = true
     1554           then do:
     1555             run diasize_maximize in this-procedure
     1556               (input  true
     1557               ) .
     1558           end.
     1559         end.
     1560       end.
     1561     end.
     1562   end procedure.
     1563   procedure diasize_need-full-display :
     1564     define output parameter p-need-full-display as logical   no-undo .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       assign
     1569         p-need-full-display = v-diasize-need-full-display
     1570       .
     1571       assign
     1572         v-diasize-need-full-display = false
     1573       .
     1574     end.
     1575   end procedure.
     1576   procedure get-context :
     1577      define output parameter p-db-num as integer          no-undo.
     1578      define output parameter p-user-id as character        no-undo.
     1579      define variable v-login               as character    no-undo.
     1580      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1581      define buffer buf_user-login  for ub.user-login .
     1582      do
     1583      on error undo, return error
     1584      :
     1585            FIND FIRST buf_sys-ctrl no-lock.
     1586            ASSIGN
     1587               v-login = USERID("ub")
     1588               p-db-num = buf_sys-ctrl.db-num
     1589            .
     1590            FIND FIRST buf_user-login
     1591                 WHERE buf_user-login.db-num = p-db-num
     1592                   AND buf_user-login.user-login = v-login
     1593                 no-lock
     1594                 no-error
     1595                 .
     1596            IF AVAILABLE buf_user-login
     1597            THEN DO:
     1598               assign
     1599                  p-user-id = buf_user-login.user-id
     1600               .
     1601            END.
     1602      end.
     1603   end procedure.
     1604       run diasize_init in this-procedure .
     1605   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   on F9 of frame Dialog-Frame anywhere do:
     1607     run goods-recid.
     1608     if gds-rec = ? then
     1609       return no-apply.
     1610     run ref/gds-form.w ( input parparentproc
     1611                         ,input 'ПРОСМОТР':U
     1612                         ,input ?
     1613                         ,input ?
     1614                         ,input ?
     1615                         ,input-output gds-rec).
     1616     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1617     return no-apply.
     1618   end.
     1619   MAIN-BLOCK:
     1620   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1621      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1622     run init-proc.
     1623     RUN enable_UI.
     1624     WAIT-FOR GO OF FRAME Dialog-Frame.
     1625   END.
     1626   RUN disable_UI.
     1627   PROCEDURE data-changed :
     1628   END PROCEDURE.
     1629   PROCEDURE disable_UI :
     1630     HIDE FRAME Dialog-Frame.
     1631   END PROCEDURE.
     1632   PROCEDURE enable_UI :
     1633     ENABLE BROWSE-2 B-Cancel B-exit i-exit B-Help B-chg B-lkp B-lkp-In
     1634         WITH FRAME Dialog-Frame.
     1635     VIEW FRAME Dialog-Frame.
     1636     OPEN QUERY BROWSE-2 FOR EACH x_parts NO-LOCK,       EACH buf_goods OF x_parts NO-LOCK INDEXED-REPOSITION.
     1637   END PROCEDURE.
     1638   PROCEDURE get-attr-chg-qnty :
     1639   define output parameter p-chg-qnty as decimal   no-undo .
     1640   END PROCEDURE.
     1641   PROCEDURE goods-recid :
     1642   if available buf_goods then gds-rec = recid (buf_goods) .
     1643   else gds-rec = ?.
     1644   END PROCEDURE.
     1645   PROCEDURE init-proc :
     1646   find first buf_trn-doc exclusive-lock where
     1647           recid (buf_trn-doc) = p-recid
     1648           no-error .
     1649       if error-status :error then do:
     1650           message
     1651             vss-workfile vss-revision vss-description skip
     1652             error-status :get-message(1) skip
     1653             return-value skip
     1654             ""
     1655             view-as alert-box error
     1656           .
     1657           return error return-value .
     1658       end.
     1659   frame Dialog-Frame:title  = frame Dialog-Frame:title + ' ' + buf_trn-doc.doc-code .
     1660   for each buf_parts no-lock where
     1661            buf_parts.out-code = buf_trn-doc.doc-code
     1662   :
     1663       create x_parts.
     1664       buffer-copy buf_parts to x_parts .
     1665   end.
     1666   END PROCEDURE.
     1667   PROCEDURE reopen-query :
     1668   OPEN QUERY BROWSE-2 FOR EACH x_parts NO-LOCK,       EACH buf_goods OF x_parts NO-LOCK INDEXED-REPOSITION.
     1669   END PROCEDURE.
     1670   PROCEDURE reposition-parts :
     1671   define input  parameter p-direction   as character no-undo .
     1672   define output parameter p-parts-recid as recid no-undo .
     1673     case p-direction :
     1674       when "first":U
     1675       then do:
     1676         get first BROWSE-2 .
     1677       end.
     1678       when "last":U
     1679       then do:
     1680         get last BROWSE-2 .
     1681       end.
     1682       when "prev":U
     1683       then do:
     1684         get prev BROWSE-2 .
     1685       end.
     1686       when "next":U
     1687       then do:
     1688         get next BROWSE-2 .
     1689       end.
     1690       otherwise do:
     1691         reposition BROWSE-2  to recid integer(p-direction) no-error .
     1692       end.
     1693     end case .
     1694     assign
     1695       p-parts-recid = recid(x_parts)
     1696     .
     1697     run reposition-query in this-procedure
     1698       (input p-parts-recid
     1699       ).
     1700   END PROCEDURE.
     1701   PROCEDURE reposition-query :
     1702     define input parameter p-recid as recid no-undo .
     1703     if p-recid <> ?
     1704     then do:
     1705       reposition BROWSE-2 to recid p-recid no-error.
     1706     end.
     1707     do with frame Dialog-Frame:
     1708       apply "entry":u to browse BROWSE-2 .
     1709     end.
     1710   END PROCEDURE.
