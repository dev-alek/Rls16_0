      192   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      193   DO:
      194   if not available x_parts then return .
      195   define buffer buf_goods for ub.goods  .
      196   find first buf_goods no-lock
      197     where buf_goods.artic     = x_parts.artic
      198       and buf_goods.prod-type = x_parts.prod-type
      199       and buf_goods.prod-code = x_parts.prod-code
      200     no-error .
      201       if error-status :error then do:
      202       message
      203         vss-workfile vss-revision vss-description skip
      204         error-status :get-message(1) skip
      205         return-value skip
      206         ""
      207         view-as alert-box error
      208       .
      209       return .
      210       end.
      211   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      213     (input x_parts.obj-type
      214     ,input x_parts.obj-code
      215     ,input x_parts.artic
      216     ,input x_parts.prod-type
      217     ,input x_parts.prod-code
      218     ,input ?
      219     ,input 'return':u
      220     ) no-error .
      221       if error-status :error
      222       then do:
      223         message
      224            return-value
      225            view-as alert-box error .
      226         return .
      227       end.
      228      run utl/uparts-f.w
      229       ( input parparentproc ,
      230         input this-procedure ,
      231         input buf_trn-doc.doc-code ,
      232         input buf_goods.gds-code ,
      233         input x_parts.pl-code    ,
      234         input x_parts.in-code    ,
      235         input x_parts.part-code  ,
      236         input x_parts.out-code  ,
      237         input-output table x_parts ) no-error .
      238         if error-status :error then message
      239           vss-workfile vss-revision vss-description skip
      240           error-status :get-message(1) skip
      241           return-value skip
      242           "utl/uparts-f.w"
      243           view-as alert-box error
      244         .
      245       run reopen-query in this-procedure .
      246   END.
      247   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      248   DO:
      249   define variable v-ok as logical   no-undo .
      250     message "Запускать утилиту пересчета внешнего прихода № " buf_trn-doc.doc-code skip
      251     "Вы уверены ?"
      252     view-as alert-box question
      253     buttons yes-no
      254     title "Вопрос"
      255     update v-ok .
      256     if v-ok = false then  return no-apply .
      257     else do:
      258       run utl/trnfactb.p
      259           ( input parParentProc ,
      260             input buf_trn-doc.doc-code ,
      261             input table x_parts ) no-error .
      262             if error-status :error then message
      263               vss-workfile vss-revision vss-description skip
      264               error-status :get-message(1) skip
      265               return-value skip
      266               "utl/trnfactb.p"
      267               view-as alert-box error
      268             .
      269     end.
      270   END.
      271   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
      272   DO:
      273   if not available x_parts then return .
      274   define buffer buf_goods for ub.goods  .
      275   define variable v-prt-rec as recid no-undo .
      276   find first buf_goods no-lock
      277     where buf_goods.artic     = x_parts.artic
      278       and buf_goods.prod-type = x_parts.prod-type
      279       and buf_goods.prod-code = x_parts.prod-code
      280     no-error .
      281       if error-status :error then do:
      282       message
      283         vss-workfile vss-revision vss-description skip
      284         error-status :get-message(1) skip
      285         return-value skip
      286         ""
      287         view-as alert-box error
      288       .
      289       return .
      290       end.
      291       define buffer old-parts for ub.parts  .
      292       find first old-parts no-lock where
      293                  old-parts.out-code = buf_trn-doc.doc-code and
      294                  old-parts.obj-type = buf_trn-doc.obj-type and
      295                  old-parts.obj-code = buf_trn-doc.obj-code and
      296                  old-parts.artic      = x_parts.artic and
      297                  old-parts.prod-type  = x_parts.prod-type and
      298                  old-parts.prod-code  = x_parts.prod-code and
      299                  old-parts.in-code    = x_parts.in-code  no-error .
      300       if available old-parts then do:
      301           v-prt-rec = recid(old-parts) .
      302           run str/parts-f.w
      303             (input        parparentproc
      304             ,input        this-procedure
      305             ,input        'ПРОСМОТР':U
      306             ,input        buf_trn-doc.doc-code
      307             ,input        buf_goods.gds-code
      308             ,input        x_parts.pl-code
      309             ,input-output v-prt-rec
      310             ).
      311        end.
      312   END.
      313   ON CHOOSE OF B-lkp-In IN FRAME Dialog-Frame
      314   DO:
      315   if not available x_parts then return .
      316       run str/showdoc.p
      317       ( input parparentproc
      318        ,input x_parts.in-code
      319        ,input ?
      320        ,input ?
      321        ,input ?
      322        ,input true
      323       ) .
      324   END.
      325   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      326   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      327   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   on help of frame Dialog-Frame
      329   do:
      330     run gbl/app_help.p
      331       (input this-procedure :file-name
      332       ,input ''
      333       ,input ?
      334       ) no-error.
      335     if error-status :error then do:
      336       message
      337         "Ошибка при вызове помощи"
      338         error-status :get-message(1)
      339         view-as alert-box .
      340     end.
      341   end.
      342   run minbtn-set in this-procedure .
      343   on choose of b-help in frame Dialog-Frame
      344   do:
      345     apply "help":u to frame Dialog-Frame .
      346   end.
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   procedure minbtn-set :
      349       do
      350           on error undo, return error return-value
      351           :
      352           define variable ii              as integer       no-undo .
      353           define variable fh              as widget-handle no-undo .
      354           define variable hh              as widget-handle no-undo .
      355           define variable v-h             as handle        extent 4 no-undo .
      356           define variable v-name-button   as character     no-undo .
      357           define variable v-help-old-x    as decimal       no-undo .
      358           define variable v-help-old-y    as decimal       no-undo .
      359           define variable v-help-old-size as decimal       no-undo .
      360           define variable v-frame-width   as decimal       no-undo .
      361           define variable jj              as integer       no-undo .
      362           do
      363               on error undo, return error
      364               :
      365               assign
      366                   v-frame-width = frame Dialog-Frame:width - 0.3
      367                   fh            = frame Dialog-Frame:first-child
      368                   hh            = fh:first-child
      369                   ii            = 1
      370                   .
      371               do while valid-handle(hh):
      372                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      373                   do:
      374                       case lc(hh:name) :
      375                           when "b-help" then
      376                               do:
      377                                   hh:load-image-up("cmp/b-help.bmp":u) .
      378                                   hh:load-image-down("cmp/b-help.bmp":u) .
      379                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      380                                   hh:TOOLTIP = "Помощь" .
      381                                   v-help-old-x = hh:column .
      382                                   v-help-old-y = hh:row    .
      383                                   v-help-old-size = hh:width .
      384                                   hh:width-chars = 2.5 .
      385                               end.
      386                           when "b-print" then
      387                               do:
      388                                   hh:load-image("cmp/b-print.bmp":u) .
      389                                   hh:TOOLTIP = "Печать" .
      390                                   v-h[ii] = hh:handle .
      391                                   ii = ii + 1 .
      392                                   hh:width-chars = 3 .
      393                               end.
      394                           when "b-history" or
      395                           when "b-hist" then
      396                               do:
      397                                   hh:load-image("cmp/b-hist.bmp":u) .
      398                                   hh:TOOLTIP = "История" .
      399                                   v-h[ii] = hh:handle .
      400                                   ii = ii + 1 .
      401                                   hh:width-chars = 3 .
      402                               end.
      403                           when "b-sch" then
      404                               do:
      405                                   hh:load-image("cmp/b-sch.bmp":u) .
      406                                   hh:TOOLTIP = "Установка Фильтра" .
      407                                   v-h[ii] = hh:handle .
      408                                   ii = ii + 1 .
      409                                   hh:width-chars = 3 .
      410                               end.
      411                           when "b-hist-user" then
      412                               do:
      413                                   hh:load-image("cmp/b-hist.bmp":u) .
      414                                   hh:TOOLTIP = "История пользователя" .
      415                                   ii = ii + 1 .
      416                               end.
      417                       end case.
      418                   end.
      419                   hh = hh:next-sibling.
      420               end.
      421               b-help:column = v-frame-width - b-help:width-chars.
      422               jj = 0.
      423               repeat ii = 4 to 1 by -1 :
      424                   if valid-handle (v-h[ii] ) then
      425                   do:
      426                       jj  = jj + 1 .
      427                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      428                       v-h[ii]:row    = v-help-old-y .
      429                   end.
      430               end.
      431           end.
      432       end.
      433   end procedure.
      434   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      435   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      436   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      437   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      438   define variable v-diasize-current-frame-width  as decimal   no-undo .
      439   define variable v-diasize-current-frame-height as decimal   no-undo .
      440   define variable v-diasize-change-size          as logical   no-undo .
      441   define variable v-diasize-resize-button        as handle    no-undo .
      442   define variable v-diasize-wndmax               as logical   no-undo .
      443   define variable v-diasize-wndstore             as logical   no-undo .
      444   define variable v-diasize-proc-name            as character no-undo .
      445   define variable v-diasize-browse-handle        as handle    no-undo .
      446   define variable v-diasize-browse-number        as integer   no-undo .
      447   define variable v-diasize-need-full-display    as logical   no-undo init false .
      448   define temp-table temp-diasize-handle no-undo
      449     field handle-value  as handle
      450     field save-position as decimal
      451     index xpk is primary unique handle-value
      452     .
      453   define temp-table temp-browse-handle no-undo
      454     field browse-type   as character
      455     field browse-number as integer
      456     field browse-handle as handle
      457     field original-size as decimal
      458     index xpk is primary unique browse-type browse-number
      459     index xie browse-type browse-handle
      460   .
      461   procedure diasize_change-height :
      462     define input  parameter p-change-value  as decimal   no-undo .
      463     define input  parameter p-move-resize   as logical   no-undo .
      464     define variable v-field-group-handle    as handle    no-undo .
      465     define variable v-object-handle         as handle    no-undo .
      466     define variable v-frame-height          as decimal   no-undo .
      467     define variable v-frame-virtual-height  as decimal   no-undo .
      468     define variable v-browse-height         as decimal   no-undo .
      469     define variable v-window-height         as decimal   no-undo .
      470     define variable v-window-virtual-height as decimal   no-undo .
      471     define variable v-change-sign           as integer   no-undo .
      472     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      473     define buffer buf_temp-browse-handle  for temp-browse-handle .
      474     if p-change-value > 0
      475     then do:
      476       if frame Dialog-Frame :height + p-change-value
      477           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      478       then do:
      479         assign
      480           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      481                           - (frame Dialog-Frame :height-chars)
      482         .
      483         if p-change-value <= 0
      484         then do:
      485           run diasize_position-resize-button in this-procedure .
      486           return .
      487         end.
      488       end.
      489     end.
      490     if p-change-value < 0
      491     then do:
      492       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      493       then do:
      494         assign
      495           p-change-value = v-diasize-orig-frame-height
      496                          - (frame Dialog-Frame :height-chars)
      497         .
      498         if p-change-value >= 0
      499         then do:
      500           run diasize_position-resize-button in this-procedure .
      501           return .
      502         end.
      503       end.
      504     end.
      505     if p-change-value >= 0
      506     then do:
      507       assign
      508         v-change-sign = 1
      509       .
      510     end.
      511     else do:
      512       assign
      513         v-change-sign = -1
      514       .
      515     end.
      516     assign
      517       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      518     .
      519     if p-change-value = 0
      520     then do:
      521       run diasize_position-resize-button in this-procedure .
      522       return .
      523     end.
      524     move_block:
      525     do
      526     on error undo move_block, retry move_block
      527     :
      528       if retry
      529       then do:
      530         do
      531         on error undo move_block, leave move_block
      532         :
      533           if p-change-value > 0
      534           then do:
      535             for each buf_temp-diasize-handle
      536             on error undo, next
      537             :
      538               assign
