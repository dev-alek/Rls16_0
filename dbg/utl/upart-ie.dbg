      858     define variable v-change-sign          as integer   no-undo .
      859     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      860     define buffer buf_temp-browse-handle  for temp-browse-handle .
      861     if p-change-value > 0
      862     then do:
      863       if frame Dialog-Frame :width + p-change-value >
      864           session :width-chars
      865       then do:
      866         assign
      867           p-change-value = session :width-chars - frame Dialog-Frame :width
      868         .
      869         if p-change-value <= 0
      870         then do:
      871           run diasize_position-resize-button in this-procedure .
      872           return .
      873         end.
      874       end.
      875     end.
      876     if p-change-value < 0
      877     then do:
      878       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      879       then do:
      880         assign
      881           p-change-value = v-diasize-orig-frame-width
      882                          - frame Dialog-Frame :width
      883         .
      884         if p-change-value >= 0
      885         then do:
      886           run diasize_position-resize-button in this-procedure .
      887           return .
      888         end.
      889       end.
      890     end.
      891     if p-change-value >= 0
      892     then do:
      893       assign
      894         v-change-sign = 1
      895       .
      896     end.
      897     else do:
      898       assign
      899         v-change-sign = -1
      900       .
      901     end.
      902     assign
      903       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      904     .
      905     if p-change-value = 0
      906     then do:
      907       run diasize_position-resize-button in this-procedure .
      908       return .
      909     end.
