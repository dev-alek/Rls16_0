      843         (input  (p-new-height - frame Dialog-Frame :height)
      844         ,input  p-move-resize
      845         ) .
      846     end.
      847   end procedure.
      848   procedure diasize_change-width :
      849     define input  parameter p-change-value as decimal   no-undo .
      850     define input  parameter p-move-resize  as logical   no-undo .
