      259   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      260   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      261   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      262   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      263   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      264   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      265   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      266   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      267         adm-object-hdl = FRAME F-Main:HANDLE.
      268   RUN ensure-broker.
      269   THIS-PROCEDURE:ADM-DATA =
      270        'ADM1.1~`':U +
      271        'SmartObject~`':U +
      272        '~`':U +
      273        'NO ~`':U +
      274        'ub.trn-doc~`':U +
      275        '~`':U +
      276        'ub.trn-doc~`':U +
      277        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      278           + "~`":U +
      279        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      280        'Record-Source,Record-Target,TableIO-Target~`':U +
      281        '~`':U +
      282        '~`~`~`~`~`~`~`~`~`~`~`':U +
      283        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      284            THEN "^^":U
      285        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      286             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      287   PROCEDURE adm-apply-entry :
      288     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      289   END PROCEDURE.
      290   PROCEDURE adm-destroy :
      291    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      292   END PROCEDURE.
      293   PROCEDURE adm-disable :
      294       DISABLE  WITH FRAME F-Main.
      295       RUN dispatch ('disable-fields':U).
      296       RUN set-attribute-list ('ENABLED=no':U).
      297       RETURN.
      298   END PROCEDURE.
      299   PROCEDURE adm-edit-attribute-list :
      300         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      301         RETURN.
      302   END PROCEDURE.
      303   PROCEDURE adm-enable :
      304       ENABLE UNLESS-HIDDEN  WITH FRAME F-Main.
      305       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      306       RUN set-attribute-list ('ENABLED=yes':U).
      307       RETURN.
      308   END PROCEDURE.
      309   PROCEDURE adm-exit :
      310        RUN notify ('exit':U).
      311     RETURN.
      312   END PROCEDURE.
      313   PROCEDURE adm-hide :
      314     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      315   END PROCEDURE.
      316   PROCEDURE adm-initialize :
      317     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      318   END PROCEDURE.
      319   PROCEDURE adm-show-errors :
      320       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      321       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      322           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      323       END.
      324       RETURN.
      325   END PROCEDURE.
      326   PROCEDURE adm-UIB-mode :
      327     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      328   END PROCEDURE.
      329   PROCEDURE adm-view :
      330     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      331   END PROCEDURE.
      332   PROCEDURE dispatch :
      333       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      334       RUN broker-dispatch IN adm-broker-hdl
      335           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      336       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      337   END PROCEDURE.
      338   PROCEDURE ensure-broker :
      339   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      340   IF RETURN-VALUE NE "ADM-Broker":U THEN
      341   DO:
      342       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      343       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      344   END.
      345   END PROCEDURE.
      346   PROCEDURE get-attribute :
      347     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      348     RUN broker-get-attribute IN adm-broker-hdl
      349         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      350     RETURN RETURN-VALUE.
      351   END PROCEDURE.
      352   PROCEDURE get-attribute-list :
      353     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      354     RUN broker-get-attribute-list IN adm-broker-hdl
      355         (INPUT THIS-PROCEDURE,
      356          INPUT ?,
      357          OUTPUT p-attr-list) NO-ERROR.
      358     RETURN.
      359   END PROCEDURE.
      360   PROCEDURE new-state :
      361     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      362     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      363     RETURN.
      364   END PROCEDURE.
      365   PROCEDURE notify :
      366     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      367     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      368     IF RETURN-VALUE = "ADM-ERROR":U THEN
      369         RETURN "ADM-ERROR":U.
      370     RETURN.
      371   END PROCEDURE.
      372   PROCEDURE set-attribute-list :
      373     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      374     RUN ensure-broker.
      375     RUN broker-set-attribute-list IN adm-broker-hdl
      376         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      377     RETURN.
      378   END PROCEDURE.
      379   PROCEDURE set-position :
      380       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      381       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      382       IF VALID-HANDLE(adm-object-hdl) THEN
      383       DO:
      384         ASSIGN adm-object-hdl:ROW    =   p-row
      385                adm-object-hdl:COLUMN =   p-col.
      386       END.
      387       RETURN.
      388   END PROCEDURE.
      389   PROCEDURE adm-display-fields :
      390         IF AVAILABLE ub.trn-doc THEN
      391             DISPLAY UNLESS-HIDDEN ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      392               WITH FRAME F-Main NO-ERROR.
      393         ELSE DO:
      394             CLEAR FRAME F-Main ALL NO-PAUSE.
      395             RUN set-editors('CLEAR':U).
      396         END.
      397       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      398       RETURN.
      399   END PROCEDURE.
      400   PROCEDURE adm-open-query :
      401     RETURN.
      402   END PROCEDURE.
      403   PROCEDURE adm-row-changed :
      404         IF VALID-HANDLE(adm-object-hdl) THEN
      405           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      406         RUN notify ('row-available':U).
      407         RETURN.
      408   END PROCEDURE.
      409   PROCEDURE reposition-query :
      410       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      411       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      412       RETURN.
      413   END PROCEDURE.
      414     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      415     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      416     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      417     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      418     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      419     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      420     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      421     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      422     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      423     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      424     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      425     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      426     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      427     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      428     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      429     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      430     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      431     IF "ub.trn-doc":U = "":U THEN
      432       RUN modify-list-attribute IN adm-broker-hdl
      433         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      434     RUN use-create-on-add(?).
      435   PROCEDURE adm-add-record :
      436      DEFINE VARIABLE trans-hdl-string  AS CHARACTER NO-UNDO.
      437      DEFINE VARIABLE cntr              AS INTEGER   NO-UNDO.
      438      DEFINE VARIABLE temp-rowid        AS ROWID     NO-UNDO.
      439      DEFINE VARIABLE saved-dictdb      AS CHARACTER NO-UNDO.
      440         IF group-assign-target = ? THEN
      441           RUN init-group-assign.
      442         IF NOT group-assign-target THEN
      443           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      444         ASSIGN adm-first-table = ROWID(ub.trn-doc)
      445                adm-new-record = yes
      446                adm-adding-record = yes
      447                adm-query-empty = IF AVAILABLE(ub.trn-doc)
      448                                  THEN no ELSE yes.
      449         RUN set-attribute-list ("ADM-NEW-RECORD=yes,ADM-QUERY-EMPTY-ON-ADD=":U +
      450           IF adm-query-empty THEN "yes":U ELSE "no":U).
      451         RUN dispatch('enable-fields':U).
      452         IF (adm-create-on-add = no) AND (adm-first-tmpl-recid = ?) AND
      453            (DBTYPE(LDBNAME(BUFFER ub.trn-doc)) EQ "PROGRESS":U)
      454         THEN DO:
      455             saved-dictdb = LDBNAME("DICTDB":U).
      456             CREATE ALIAS DICTDB FOR DATABASE
      457               VALUE(LDBNAME(BUFFER ub.trn-doc)).
      458             RUN adm/objects/get-init.p (INPUT "ub.trn-doc":U,
      459               OUTPUT adm-first-tmpl-recid).
      460             CREATE ALIAS DICTDB FOR DATABASE
      461               VALUE(saved-dictdb).
      462           END.
      463             IF adm-create-on-add = no THEN
      464             DO:
      465              IF DBTYPE(LDBNAME(BUFFER ub.trn-doc))
      466                EQ "PROGRESS":U THEN
      467              DO:
      468               FIND ub.trn-doc WHERE
      469                 RECID(ub.trn-doc) = adm-first-tmpl-recid
      470                   NO-LOCK.
      471               DISPLAY UNLESS-HIDDEN ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      472                 WITH FRAME F-Main NO-ERROR.
      473              END.
      474             END.
      475             ELSE DO:
      476              DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
      477                             ON ERROR UNDO, RETURN "ADM-ERROR":U:
      478                adm-create-complete = no.
      479                RUN dispatch ('create-record':U).
      480                IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      481                DISPLAY UNLESS-HIDDEN ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      482                   WITH FRAME F-Main NO-ERROR.
      483              END.
      484              adm-create-complete = yes.
      485             END.
      486         RUN notify ('add-record, GROUP-ASSIGN-TARGET':U).
      487         RUN new-state('update':U).
      488         RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      489       RETURN.
      490   END PROCEDURE.
      491   PROCEDURE adm-assign-record :
      492           IF group-assign-target = ? THEN
      493             RUN init-group-assign.
      494           adm-updating-record = yes.
      495           IF adm-new-record THEN DO:
      496             IF (NOT adm-adding-record) OR
      497                 (NOT adm-create-on-add) THEN
      498             DO:
      499                RUN dispatch ('create-record':U).
      500                IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      501             END.
      502             IF adm-create-on-add = yes THEN
      503             DO:
      504               RUN dispatch ('current-changed':U).
      505               IF RETURN-VALUE = "ADM-ERROR":U THEN
      506                  RETURN "ADM-ERROR":U.
      507             END.
      508           END.
      509           ELSE DO:
      510               RUN dispatch ('current-changed':U).
      511               IF RETURN-VALUE = "ADM-ERROR":U THEN
      512                  RETURN "ADM-ERROR":U.
      513           END.
      514           RUN dispatch ('assign-statement':U).
      515           IF RETURN-VALUE = "ADM-ERROR":U THEN
      516               UNDO, RETURN "ADM-ERROR":U.
      517           RUN notify ('assign-record,GROUP-ASSIGN-TARGET':U).
      518           IF RETURN-VALUE = "ADM-ERROR":U THEN UNDO, RETURN "ADM-ERROR":U.
      519           IF adm-new-record THEN
      520           DO:
      521               RUN get-attribute('Query-Position':U).
      522               IF RETURN-VALUE = 'no-record-available':U THEN
      523               DO:
      524                 RUN new-state('record-available':U).
      525                 RUN set-attribute-list('Query-Position = record-available':U).
      526               END.
      527               RUN dispatch('display-fields':U).
      528           END.
      529      RETURN.
      530     END PROCEDURE.
      531   PROCEDURE adm-assign-statement :
      532           ASSIGN FRAME F-Main ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      533                 NO-ERROR.
      534       IF ERROR-STATUS:ERROR THEN
      535       DO:
      536         RUN dispatch('show-errors':U).
      537         UNDO, RETURN "ADM-ERROR":U.
      538       END.
      539     RETURN.
      540   END PROCEDURE.
      541   PROCEDURE adm-cancel-record :
      542     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      543      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      544      IF adm-new-record THEN
      545      DO:
      546         IF (adm-adding-record = yes) AND
      547            (adm-create-on-add = no)
      548         THEN DO:
      549           RELEASE ub.trn-doc NO-ERROR.
      550         END.
      551         ELSE IF (adm-adding-record = yes) AND
      552           (adm-create-on-add = yes) AND
      553             (adm-create-complete = yes)
      554         THEN RUN dispatch ('delete-record':U).
      555             IF adm-new-record THEN
      556             DO:
      557               IF group-assign-target THEN
      558               DO:
      559                 RUN request-attribute IN adm-broker-hdl
      560                   (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U,
      561                    'ADM-QUERY-EMPTY-ON-ADD':U).
      562                 adm-query-empty = IF RETURN-VALUE = "YES":U THEN yes
      563                   ELSE IF RETURN-VALUE = "NO":U THEN no ELSE ?.
      564               END.
      565               IF adm-query-empty THEN
      566               DO:
      567                 RUN dispatch ('disable-fields':U).
      568                 RUN dispatch ('display-fields':U).
      569               END.
      570             END.
      571         adm-new-record = no.
      572         RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
      573      END.
      574      ELSE RUN dispatch ('display-fields':U).
      575      RUN notify ('cancel-record, GROUP-ASSIGN-TARGET':U).
      576      RUN dispatch ('apply-entry':U).
      577      RUN get-link-handle IN adm-broker-hdl
      578          (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
      579      adm-updating-record = no.
      580      IF source-str EQ "":U THEN
      581        RUN new-state('update-complete':U).
      582      RETURN.
      583     END PROCEDURE.
      584   PROCEDURE adm-copy-record :
      585      DEFINE VARIABLE trans-hdl-string AS CHARACTER NO-UNDO.
      586         IF group-assign-target = ? THEN
      587           RUN init-group-assign.
      588         IF NOT group-assign-target THEN
      589           RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      590         ASSIGN adm-first-table = ROWID(ub.trn-doc)
      591                adm-new-record = yes
      592                adm-adding-record = no.
      593         RUN set-attribute-list ("ADM-NEW-RECORD=yes":U).
      594         RUN dispatch('enable-fields':U).
      595             RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      596         RUN notify ('copy-record, GROUP-ASSIGN-TARGET':U).
      597         RUN new-state('update':U).
      598       RETURN.
      599   END PROCEDURE.
      600   PROCEDURE adm-create-record :
      601       DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      602       DEFINE VARIABLE source-rowid-str    AS CHARACTER NO-UNDO.
      603          IF group-assign-target = yes THEN
      604          DO:
      605            RUN get-link-handle IN adm-broker-hdl
      606              (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U,
      607                 OUTPUT source-str).
      608            RUN send-records IN WIDGET-HANDLE (source-str)
      609                (INPUT "ub.trn-doc":U,
      610                 OUTPUT source-rowid-str).
      611            FIND ub.trn-doc WHERE
      612                ROWID (ub.trn-doc) =
      613                    TO-ROWID(source-rowid-str) NO-ERROR.
      614            IF ERROR-STATUS:ERROR THEN
      615            DO:
      616              RUN dispatch('show-errors':U).
      617              UNDO, RETURN "ADM-ERROR":U.
      618            END.
      619          END.
      620          ELSE DO:
      621              CREATE ub.trn-doc NO-ERROR.
      622              IF ERROR-STATUS:ERROR THEN
      623              DO:
      624                RUN dispatch('show-errors':U).
      625                UNDO, RETURN "ADM-ERROR":U.
      626              END.
      627          END.
      628      RETURN.
      629   END PROCEDURE.
      630   PROCEDURE adm-current-changed :
      631      ASSIGN adm-first-table = ROWID(ub.trn-doc).
      632     IF NOT group-assign-target THEN
      633     DO:
      634       FIND CURRENT ub.trn-doc EXCLUSIVE-LOCK NO-ERROR NO-WAIT.
      635       IF NOT AVAILABLE ub.trn-doc THEN
      636       DO:
      637         RUN dispatch('show-errors':U).
      638         IF ERROR-STATUS:GET-NUMBER(1) = 138 THEN
      639             RUN dispatch('get-next':U).
      640         ELSE FIND ub.trn-doc WHERE
      641             ROWID(ub.trn-doc) = adm-first-table NO-LOCK NO-ERROR.
      642         RETURN "ADM-ERROR":U.
      643       END.
      644       ELSE IF CURRENT-CHANGED ub.trn-doc THEN
      645       DO:
      646         MESSAGE  SUBSTITUTE
      647             ("Sorry, this &1 has been changed by another user. ",
      648               "ub.trn-doc") SKIP
      649               "Please note any differences and re-enter your changes."
      650                      VIEW-AS ALERT-BOX.
      651         RUN dispatch ('display-fields':U).
      652         UNDO, RETURN "ADM-ERROR":U.
      653       END.
      654     END.
      655     RETURN.
      656   END PROCEDURE.
      657   PROCEDURE adm-delete-record :
      658      DEFINE VARIABLE delete-failed AS LOGICAL NO-UNDO INIT no.
      659      IF group-assign-target = ? THEN
      660        RUN init-group-assign.
      661         DO TRANSACTION ON STOP UNDO, LEAVE ON ERROR UNDO, LEAVE:
      662           IF group-assign-target NE yes THEN
      663           DO:
      664             FIND CURRENT ub.trn-doc EXCLUSIVE-LOCK NO-WAIT
      665               NO-ERROR.
      666             IF ERROR-STATUS:ERROR THEN
      667             DO:
      668               RUN dispatch('show-errors':U).
      669               UNDO, RETURN "ADM-ERROR":U.
      670             END.
      671             DELETE ub.trn-doc NO-ERROR.
      672           END.
      673           IF ERROR-STATUS:ERROR THEN
      674           DO:
      675             RUN dispatch('show-errors':U).
      676             delete-failed = yes.
      677           END.
      678         END.
      679            IF (NOT delete-failed) AND
      680               (NOT adm-new-record) THEN
      681            RUN new-state ('delete-complete':U).
      682         IF delete-failed THEN
      683             UNDO, RETURN "ADM-ERROR":U.
      684       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      685       RETURN.
      686   END PROCEDURE.
      687   PROCEDURE adm-disable-fields :
      688              DISABLE UNLESS-HIDDEN ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      689                WITH FRAME F-Main.
      690              RUN set-editors('DISABLE':U).
      691          RUN set-attribute-list ("FIELDS-ENABLED=no":U).
      692         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      693       RETURN.
      694   END PROCEDURE.
      695   PROCEDURE adm-enable-fields :
      696           RUN get-attribute ("FIELDS-ENABLED":U).
      697           IF RETURN-VALUE NE "YES":U THEN
      698           DO:
      699             IF NOT adm-new-record THEN
      700             DO:
      701               IF AVAILABLE(ub.trn-doc) AND
      702                 adm-initial-lock = "SHARE-LOCK":U OR
      703                   adm-initial-lock = "EXCLUSIVE-LOCK":U THEN
      704               DO:
      705                   IF adm-initial-lock = "SHARE-LOCK":U THEN
      706                     FIND CURRENT ub.trn-doc SHARE-LOCK NO-WAIT
      707                       NO-ERROR.
      708                   ELSE IF AVAILABLE (ub.trn-doc) THEN
      709                   DO TRANSACTION:
      710                     FIND CURRENT ub.trn-doc
      711                      EXCLUSIVE-LOCK NO-WAIT NO-ERROR.
      712                   END.
      713                   IF ERROR-STATUS:ERROR THEN
      714                   DO:
      715                     RUN dispatch('show-errors':U).
      716                     UNDO, RETURN "ADM-ERROR":U.
      717                   END.
      718                   RUN dispatch ('display-fields':U).
      719               END.
      720            END.
      721                   ENABLE UNLESS-HIDDEN ub.trn-doc.tot-rubl ub.trn-doc.tot-other ub.trn-doc.fact-qnty ub.trn-doc.tot-sale ub.trn-doc.fact-base ub.trn-doc.doc-qnty ub.trn-doc.tot-transp ub.trn-doc.fact-rubl ub.trn-doc.discnt-type ub.trn-doc.exch-code ub.trn-doc.VAT-base ub.trn-doc.print-rubl ub.trn-doc.exch-date ub.trn-doc.VAT-rubl ub.trn-doc.shift-date ub.trn-doc.exch-rate ub.trn-doc.VAT-type ub.trn-doc.shift-num ub.trn-doc.exch-scale ub.trn-doc.SLT-base ub.trn-doc.ship-date ub.trn-doc.pay-code ub.trn-doc.SLT-rubl ub.trn-doc.tot-ov ub.trn-doc.tot-calc ub.trn-doc.SLT-type ub.trn-doc.base-rate ub.trn-doc.road-tax ub.trn-doc.tot-cli ub.trn-doc.base-scale ub.trn-doc.excise ub.trn-doc.tot-doc ub.trn-doc.discnt-pc ub.trn-doc.tot-fact ub.trn-doc.discnt-rubl
      722                     WITH FRAME F-Main.
      723                   RUN set-editors('ENABLE':U).
      724               RUN set-attribute-list ("FIELDS-ENABLED=yes":U).
      725           END.
      726           RUN notify ('enable-fields, GROUP-ASSIGN-TARGET':U).
      727           RUN dispatch ('apply-entry':U).
      728       RETURN.
      729   END PROCEDURE.
      730   PROCEDURE adm-end-update :
      731     DEFINE VARIABLE source-str          AS CHARACTER NO-UNDO.
      732      IF ERROR-STATUS:ERROR THEN
      733          RUN dispatch('show-errors':U).
      734      RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      735      RUN get-link-handle IN adm-broker-hdl
      736         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, OUTPUT source-str).
      737      IF adm-new-record AND NOT TRANSACTION THEN DO:
      738             adm-new-record = no.
      739             RUN set-attribute-list ("ADM-NEW-RECORD=no":U).
      740             ASSIGN adm-first-table = ROWID(ub.trn-doc).
      741             IF source-str EQ "":U THEN
      742             DO:
      743                 RUN set-link-attribute IN adm-broker-hdl
      744                     (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      745                      'REPOSITION-PENDING=yes':U).
      746                 RUN notify('open-query':U).
      747                 RUN request IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      748                     INPUT 'RECORD-SOURCE':U, INPUT 'reposition-query':U).
      749             END.
      750      END.
      751       FIND CURRENT ub.trn-doc NO-LOCK NO-ERROR.
      752       RUN notify('end-update, GROUP-ASSIGN-TARGET':U).
      753       IF source-str EQ "":U THEN
      754           RUN new-state('update-complete':U).
      755       adm-updating-record = no.
      756       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      757     RETURN.
      758   END PROCEDURE.
      759   PROCEDURE adm-reset-record :
      760        RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      761        RUN notify ('reset-record, GROUP-ASSIGN-TARGET':U).
      762        RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      763       RETURN.
      764   END PROCEDURE.
      765   PROCEDURE adm-update-record :
      766         DEFINE VARIABLE cRecordSrc AS CHARACTER NO-UNDO.
      767         DEFINE VARIABLE hRecordSrc AS HANDLE     NO-UNDO.
      768         DEFINE BUFFER bNewRecord FOR ub.trn-doc.
      769         DO TRANSACTION ON STOP  UNDO, RETURN "ADM-ERROR":U
      770                        ON ERROR UNDO, RETURN "ADM-ERROR":U :
      771           RUN dispatch ('assign-record':U).
      772           IF  RETURN-VALUE = "ADM-ERROR":U THEN
      773               RETURN "ADM-ERROR":U.
      774         END.
      775         RUN dispatch ('end-update':U).
      776         FIND FIRST bNewRecord NO-LOCK NO-ERROR.
      777         IF NOT ERROR-STATUS:ERROR AND ROWID(bNewRecord) = ROWID (ub.trn-doc) THEN
      778         DO:
      779           RUN get-link-handle IN adm-broker-hdl
      780               (INPUT THIS-PROCEDURE,
      781                INPUT "RECORD-SOURCE",
      782                OUTPUT cRecordSrc).
      783           hRecordSrc = WIDGET-HANDLE(cRecordSrc).
      784           IF VALID-HANDLE(hRecordSrc) THEN
      785           DO:
      786               RUN get-attribute IN hRecordSrc ("TYPE":U).
      787               IF RETURN-VALUE = "SmartQuery":U AND
      788                  CAN-DO(hRecordSrc:INTERNAL-ENTRIES,"new-first-record") THEN
      789                  RUN new-first-record IN hRecordSrc (INPUT ROWID (ub.trn-doc)).
      790           END.
      791         END.
      792      RETURN.
      793   END PROCEDURE.
      794   PROCEDURE check-modified :
      795   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      796   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      797   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      798   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      799     IF NOT VALID-HANDLE(adm-object-hdl) THEN RETURN.
      800     IF group-assign-target = ? THEN
      801       RUN init-group-assign.
      802     IF check-state = "check":U AND group-assign-target THEN
      803       RETURN "":U.
      804     ELSE IF check-state = "group-check":U THEN
      805        check-state = "check":U.
      806     IF VALID-HANDLE(FRAME F-Main:HANDLE) AND
      807         AVAILABLE(ub.trn-doc) THEN
      808     DO:
      809       ASSIGN curr-widget = FRAME F-Main:FIRST-CHILD.
      810       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      811       DO WHILE VALID-HANDLE (curr-widget):
      812           IF LOOKUP (curr-widget:TYPE,
      813           "FILL-IN,COMBO-BOX,EDITOR,RADIO-SET,SELECTION-LIST,SLIDER,TOGGLE-BOX":U)
      814               NE 0 AND
      815                    (adm-check-modified-all = yes OR curr-widget:SENSITIVE) AND
      816                    (adm-check-modified-all = yes OR curr-widget:TABLE NE ?)
      817                    AND curr-widget:MODIFIED THEN
      818           DO:
      819               IF check-state = "check":U THEN
      820               DO:
      821                   RUN check-modified-message(curr-widget:TABLE).
      822                   RETURN.
      823               END.
      824               ELSE IF check-state = "clear":U THEN
      825                   curr-widget:MODIFIED = no.
      826           END.
      827           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      828       END.
      829     END.
      830     IF check-state = "check":U THEN
      831     DO:
      832       RUN get-link-handle IN adm-broker-hdl
      833         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      834            OUTPUT group-target-list).
      835       IF group-target-list NE "":U THEN
      836       DO i = 1 TO NUM-ENTRIES(group-target-list):
      837         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      838         RUN check-modified IN curr-widget ('group-check':U).
      839         IF RETURN-VALUE NE "":U THEN
      840         DO:
      841           RUN check-modified-message(RETURN-VALUE).
      842           RETURN "":U.
      843         END.
      844       END.
      845     END.
      846     RETURN "":U.
      847   END PROCEDURE.
      848   PROCEDURE check-modified-message :
      849     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      850        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      851           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      852        IF RETURN-VALUE = "YES":U THEN
      853           RUN notify ('view,CONTAINER-SOURCE':U).
      854        MESSAGE IF p-changed-table NE ? THEN
      855           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      856           ELSE "Current values have been changed."
      857           SKIP "  Do you wish to save those changes?"
      858           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      859        IF ANS THEN
      860        DO:
      861           IF group-assign-target THEN
      862             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      863           ELSE RUN dispatch('update-record':U).
      864           IF RETURN-VALUE = "ADM-ERROR":U THEN
      865           DO:
      866               MESSAGE "Changes to the previous record were not saved."
      867                 VIEW-AS ALERT-BOX ERROR.
      868               IF group-assign-target THEN
      869                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      870               ELSE RUN dispatch ('cancel-record':U).
      871           END.
      872        END.
      873        ELSE DO:
      874          IF group-assign-target THEN
      875             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      876          ELSE RUN dispatch('cancel-record':U).
      877        END.
      878        RETURN.
      879   END PROCEDURE.
      880   PROCEDURE get-rowid :
      881       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      882       ASSIGN
      883       p-table   =   adm-first-table.
      884       RETURN.
      885   END PROCEDURE.
      886   PROCEDURE init-group-assign :
      887       RUN request-attribute IN adm-broker-hdl
      888         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      889       IF LOOKUP("ub.trn-doc":U, RETURN-VALUE, " ":U) NE 0 THEN
      890         group-assign-target = yes.
      891       ELSE group-assign-target = no.
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE set-editors :
      895       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      896       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      897       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      898       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      899       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      900       DO WHILE VALID-HANDLE (curr-widget):
      901           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      902              curr-widget:HIDDEN = no THEN DO:
      903             CASE p-field-setting:
      904               WHEN "INITIALIZE":U THEN
      905               DO:
      906                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      907                     read-only-list +
      908                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      909                        STRING(curr-widget).
      910               END.
      911               WHEN "DISABLE":U OR
      912               WHEN "ENABLE":U THEN
      913               DO:
      914                   curr-widget:SENSITIVE = yes.
      915                   RUN get-attribute ('Read-Only-Editors':U).
      916                   IF RETURN-VALUE = ? OR
      917                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      918                       curr-widget:READ-ONLY =
      919                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      920               END.
      921               WHEN "CLEAR":U THEN
      922                   curr-widget:SCREEN-VALUE = "":U.
      923             END CASE.
      924           END.
      925           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      926       END.
      927       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      928         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      929           + '"':U).
      930       RETURN.
      931   END PROCEDURE.
      932   PROCEDURE use-check-modified-all :
      933    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      934     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      935     RETURN.
      936   END PROCEDURE.
      937   PROCEDURE use-create-on-add :
      938   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      939         ASSIGN adm-create-on-add =
      940             IF (p-attr-value EQ "NO":U) OR
      941                (p-attr-value NE "YES":U AND
      942              DBTYPE(LDBNAME(BUFFER ub.trn-doc)) EQ "PROGRESS":U)
      943             THEN no ELSE yes.
      944      RETURN.
      945   END PROCEDURE.
      946   PROCEDURE use-initial-lock :
      947     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      948     ASSIGN adm-initial-lock = p-attr-value.
      949     RETURN.
      950   END PROCEDURE.
      951     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      952   ASSIGN
      953          FRAME F-Main:SCROLLABLE       = FALSE
      954          FRAME F-Main:HIDDEN           = TRUE.
      955   if not this-procedure :persistent
      956   then do:
      957     message
      958       vss-workfile vss-revision vss-description skip
      959       "Ошибка при запуске процедуры" skip
      960       "Данную процедуру следует запускать только с параметром persistent" skip
      961       view-as alert-box error .
      962     undo, return error .
      963   end.
      964   PROCEDURE adm-row-available :
      965     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      966     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      967     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      968     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      969     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      970     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      971     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      972     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      973     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      974     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      975     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      976     IF adm-updating-record THEN RETURN.
      977     RUN get-attribute ('FIELDS-ENABLED':U).
      978     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      979     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      980         OUTPUT link-handle) NO-ERROR.
      981     IF link-handle = "":U THEN
      982         RETURN.
      983     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      984     IF NUM-ENTRIES(link-handle) > 1 THEN
      985         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      986             "encountered more than one RECORD-SOURCE.":U SKIP
      987             "The first - ":U record-source-hdl:file-name " - will be used.":U
      988                VIEW-AS ALERT-BOX ERROR.
      989     RUN get-attribute ('Key-Name':U).
      990     key-name = RETURN-VALUE.
      991     IF key-name = "":U THEN key-name = ?.
      992     IF key-name NE ? THEN DO:
      993       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      994         NO-ERROR.
      995       IF key-value NE ? THEN
      996         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      997     END.
      998     IF key-name eq ? THEN tbl-list = "ub.trn-doc":U.
      999         RUN send-records IN record-source-hdl
     1000             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
     1001         IF ERROR-STATUS:ERROR THEN RETURN.
     1002     IF key-name ne ?
     1003     THEN DO:
     1004       RUN dispatch ('find-using-key':U).
     1005       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
     1006     END.
     1007     ELSE
     1008     DO:
     1009       row-avail-cntr = row-avail-cntr + 1.
     1010       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
     1011       IF row-avail-rowid NE ROWID(ub.trn-doc) THEN different-row = yes.
     1012       IF row-avail-rowid ne ? THEN DO:
     1013             IF adm-row-avail-state NE yes THEN DO:
     1014                RUN new-state ('record-available':U).
     1015                RUN set-attribute-list ('Query-Position = record-available':U).
     1016                adm-row-avail-state = yes.
     1017             END.
     1018          DO:
     1019            IF row-avail-enabled AND
     1020               (adm-initial-lock = "SHARE-LOCK":U OR
     1021                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
     1022            DO:
     1023              IF adm-initial-lock = "SHARE-LOCK":U
     1024              THEN FIND ub.trn-doc WHERE ROWID(ub.trn-doc) = row-avail-rowid SHARE-LOCK NO-ERROR.
     1025              ELSE DO TRANSACTION:
     1026                FIND ub.trn-doc WHERE ROWID(ub.trn-doc) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
     1027              END.
     1028            END.
     1029            ELSE FIND ub.trn-doc WHERE ROWID(ub.trn-doc) = row-avail-rowid  NO-LOCK NO-ERROR.
     1030            IF ERROR-STATUS:ERROR THEN DO:
     1031              RUN dispatch ('show-errors':U).
     1032              RETURN "ADM-ERROR":U.
     1033            END.
     1034          END.
     1035       END.
     1036       ELSE DO:
     1037            IF AVAILABLE ub.trn-doc THEN RELEASE ub.trn-doc.
     1038                 IF adm-row-avail-state NE no THEN
     1039                 DO:
     1040                   RUN new-state ('no-record-available':U).
     1041                   RUN set-attribute-list
     1042                     ('Query-Position = no-record-available':U).
     1043                   adm-row-avail-state = no.
     1044                 END.
     1045        END.
     1046     END.
     1047   IF VALID-HANDLE (adm-object-hdl) THEN
     1048       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1049   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1050   END PROCEDURE.
     1051   PROCEDURE disable_UI :
     1052     HIDE FRAME F-Main.
     1053     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1054   END PROCEDURE.
     1055   PROCEDURE send-records :
     1056     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1057     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1058     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1059     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1060     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1061     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1062         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1063         CASE ENTRY(i, p-tbl-list):
     1064       WHEN "ub.trn-doc":U THEN p-rowid-list = p-rowid-list +
     1065           IF AVAILABLE ub.trn-doc THEN STRING(ROWID(ub.trn-doc))
     1066           ELSE "?":U.
     1067           OTHERWISE
     1068           DO:
     1069               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1070                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1071               IF link-handle NE "":U THEN
     1072               DO:
     1073                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1074                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1075                               "encountered more than one RECORD-SOURCE.":U SKIP
     1076                               "The first will be used.":U
     1077                               VIEW-AS ALERT-BOX ERROR.
     1078                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1079                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1080                   p-rowid-list = p-rowid-list + rowid-string.
     1081               END.
     1082               ELSE
     1083               DO:
     1084                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1085                           "does not match tables in send-records":U
     1086                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1087                           "Check that objects are linked properly and that":U
     1088                           "database qualification is consistent.":U
     1089                       VIEW-AS ALERT-BOX ERROR.
     1090                   RETURN ERROR.
     1091               END.
     1092           END.
     1093           END CASE.
     1094       END.
     1095   END PROCEDURE.
     1096   PROCEDURE state-changed :
     1097     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1098     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1099     CASE p-state:
     1100       WHEN 'update-begin':U THEN DO:
     1101           RUN dispatch('enable-fields':U).
     1102           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1103           DO:
     1104             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1105             RUN new-state('update-complete':U).
     1106           END.
     1107           ELSE RUN new-state ('update':U).
     1108       END.
     1109       WHEN 'update-complete':U THEN DO:
     1110           RUN new-state ('update-complete':U).
     1111       END.
     1112     END CASE.
     1113   END PROCEDURE.
