     4094                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) +  " ошибка при сохранении записи ГРУППЫ ПРАВ (action-role):"                                             + STRING(temp-action-role.db-num)                                             + STRING(temp-action-role.action-head-code)                                             + STRING(temp-action-role.action-role-code)                                             ) )) .                NEXT _action-role.
     4095               end.
     4096            END.
     4097            run adm/restseqr.p
     4098              ( input "rest":U
     4099              , input "s-action-role":U
     4100              , input no
     4101              ) no-error .
     4102            if error-status :error then do:
     4103              return error return-value .
     4104            end.
     4105                              _action-role-item:
     4106            FOR EACH temp-action-role-item:
     4107               FIND FIRST ub.action-role-item No-LOCK
     4108                    WHERE ub.action-role-item.db-num           = temp-action-role-item.db-num
     4109                      and ub.action-role-item.action-head-code = temp-action-role-item.action-head-code
     4110                      and ub.action-role-item.action-role-code = temp-action-role-item.action-role-code
     4111                      and ub.action-role-item.action-item-id = temp-action-role-item.action-item-id
     4112                    NO-ERROR
     4113                    .
     4114               IF AVAILABLE ub.action-role-item then do:
     4115                              run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Уже есть привязка к ГРУППЕ ПРАВ (action-role-item):"                                             + STRING(temp-action-role-item.db-num)                                             + STRING(temp-action-role-item.action-head-code)                                             + STRING(temp-action-role-item.action-role-code)                                             + STRING(temp-action-role-item.action-role-item-code)                                             ) )) .              delete temp-action-role-item.                   NEXT _action-role-item.
     4116                END.
     4117             create ub.action-role-item.
     4118             assign
     4119               ub.action-role-item.action-head-code = temp-action-role-item.action-head-code
     4120               ub.action-role-item.action-item-id   = temp-action-role-item.action-item-id
     4121               ub.action-role-item.action-role-code = temp-action-role-item.action-role-code
     4122               ub.action-role-item.action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     4123               ub.action-role-item.db-num          = temp-action-role-item.db-num
     4124               ub.action-role-item.whole-send-news = temp-action-role-item.whole-send-news
     4125             .
     4126             find first ub.action-item
     4127               where ub.action-item.action-head-code = ub.action-role-item.action-head-code
     4128               and ub.action-item.action-item-id  = ub.action-role-item.action-item-id
     4129               no-lock
     4130               no-error
     4131               .
     4132             if available ub.action-item then
     4133             do:
     4134               assign
     4135                 ub.action-role-item.action-item-code = ub.action-item.action-item-code
     4136                 .
     4137             end.
     4138             release ub.action-role-item No-error.
     4139             if error-status:error then
     4140             do:
     4141               er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4142                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) +  " ошибка при сохранении привязки к ГРУППЕ ПРАВ (action-role-item):"                                             + STRING(temp-action-role-item.db-num)                                             + STRING(temp-action-role-item.action-head-code)                                             + STRING(temp-action-role-item.action-role-code)                                             + STRING(temp-action-role-item.action-role-item-code)                                             ) )) .                NEXT _action-role-item.
     4143               end.
     4144            END.
     4145            run adm/restseqr.p
     4146              ( input "rest":U
     4147              , input "s-action-role-item":U
     4148              , input no
     4149              ) no-error .
     4150            if error-status :error then do:
     4151              return error return-value .
     4152            end.
     4153         end.
     4154         otherwise do:
     4155            define variable v-global-action-role-code     as integer   no-undo .
     4156            define variable v-firm-action-role-code       as integer   no-undo .
     4157            define variable v-object-action-role-code     as integer   no-undo .
     4158            define variable v-action-role-code            as integer   no-undo .
     4159            define variable v-action-role-item-code       as integer   no-undo .
     4160            define buffer buf_action-role       for ub.action-role .
     4161            define buffer buf_action-role-item  for ub.action-role-item .
     4162            run p-right-i in this-procedure .
     4163            _gpr:
     4164            for each temp-grpa no-lock
     4165            on error undo, return error return-value
     4166            :
     4167               assign
     4168                  v-global-action-role-code = 0
     4169                  v-firm-action-role-code   = 0
     4170                  v-object-action-role-code = 0
     4171               .
     4172               for each temp-grp-acta no-lock
     4173                  where temp-grp-acta.grp-name = temp-grpa.grp-name
     4174                  and temp-grp-acta.arm-code = temp-grpa.arm-code
     4175               on error undo, return error return-value
     4176               :
     4177                  find first temp-action-item
     4178                  where temp-action-item.grp-acta-arm-code = temp-grp-acta.arm-code
     4179                     and temp-action-item.grp-acta-object   = temp-grp-acta.object
     4180                     and temp-action-item.grp-acta-act      = temp-grp-acta.act
     4181                  no-error .
     4182                  if not available temp-action-item
     4183                  then do:
     4184                  end.
     4185                  else do:
     4186                  case temp-action-item.action-context
     4187                  :
     4188                     when 'global':U
     4189                     then do:
     4190                        if v-global-action-role-code = 0
     4191                        then do:
     4192                           IF NOT CAN-FIND ( FIRST buf_action-role
     4193                                             WHERE buf_action-role.db-num            = g#db-num
     4194                                             and buf_action-role.action-head-code    = 0
     4195                                             and buf_action-role.action-role-context = 'global':U
     4196                                             and buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     4197                                          )
     4198                           THEN DO:
     4199                              assign
     4200                                 v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     4201                              .
     4202                              create buf_action-role .
     4203                              assign
     4204                                 buf_action-role.db-num              = g#db-num
     4205                                 buf_action-role.action-head-code    = 0
     4206                                 buf_action-role.action-role-code    = v-action-role-code
     4207                                 buf_action-role.action-role-context = temp-action-item.action-context
     4208                                 buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     4209                              .
     4210                              assign
     4211                                 v-global-action-role-code = v-action-role-code
     4212                              .
     4213                           END.
     4214                        end.
     4215                        IF NOT CAN-FIND ( FIRST buf_action-role-item
     4216                                          WHERE buf_action-role-item.db-num              = g#db-num
     4217                                            and buf_action-role-item.action-head-code    = 0
     4218                                            and buf_action-role-item.action-role-code    = v-global-action-role-code
     4219                                            and buf_action-role-item.action-item-id      = temp-action-item.action-item-id
     4220                                        )
     4221                        THEN DO:
     4222                           assign
     4223                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     4224                           .
     4225                           create buf_action-role-item .
     4226                           assign
     4227                              buf_action-role-item.db-num                = g#db-num
     4228                              buf_action-role-item.action-head-code      = 0
     4229                              buf_action-role-item.action-role-code      = v-global-action-role-code
     4230                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     4231                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     4232                           .
     4233                           find first buf_action-item
     4234                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     4235                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     4236                              no-lock
     4237                              no-error
     4238                              .
     4239                           if available buf_action-item then do:
     4240                              assign
     4241                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     4242                              .
     4243                           end.
     4244                        end.
     4245                     end.
     4246                     when 'firm':U
     4247                     then do:
     4248                        if v-firm-action-role-code = 0
     4249                        then do:
     4250                           assign
     4251                              v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     4252                           .
     4253                           create buf_action-role .
     4254                           assign
     4255                              buf_action-role.db-num              = g#db-num
     4256                              buf_action-role.action-head-code    = 0
     4257                              buf_action-role.action-role-code    = v-action-role-code
     4258                              buf_action-role.action-role-context = temp-action-item.action-context
     4259                              buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     4260                           .
     4261                           assign
     4262                              v-firm-action-role-code = v-action-role-code
     4263                           .
     4264                           end.
     4265                           assign
     4266                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     4267                           .
     4268                           create buf_action-role-item .
     4269                           assign
     4270                              buf_action-role-item.db-num                = g#db-num
     4271                              buf_action-role-item.action-head-code      = 0
     4272                              buf_action-role-item.action-role-code      = v-firm-action-role-code
     4273                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     4274                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     4275                           .
     4276                           find first buf_action-item
     4277                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     4278                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     4279                              no-lock
     4280                              no-error
     4281                              .
     4282                           if available buf_action-item then do:
     4283                              assign
     4284                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     4285                              .
     4286                           end.
     4287                     end.
     4288                     when 'object':U
     4289                     then do:
     4290                        if v-object-action-role-code = 0
     4291                        then do:
     4292                           assign
     4293                              v-action-role-code = dynamic-next-value("s-action-role":U, "ub":U)
     4294                           .
     4295                           create buf_action-role .
     4296                           assign
     4297                              buf_action-role.db-num              = g#db-num
     4298                              buf_action-role.action-head-code    = 0
     4299                              buf_action-role.action-role-code    = v-action-role-code
     4300                              buf_action-role.action-role-context = temp-action-item.action-context
     4301                              buf_action-role.action-role-name    = temp-grpa.arm-code + ' ':U + temp-grpa.grp-name
     4302                           .
     4303                           assign
     4304                              v-object-action-role-code = v-action-role-code
     4305                           .
     4306                           end.
     4307                           assign
     4308                              v-action-role-item-code = dynamic-next-value("s-action-role-item":U, "ub":U)
     4309                           .
     4310                           create buf_action-role-item .
     4311                           assign
     4312                              buf_action-role-item.db-num                = g#db-num
     4313                              buf_action-role-item.action-head-code      = 0
     4314                              buf_action-role-item.action-role-code      = v-object-action-role-code
     4315                              buf_action-role-item.action-role-item-code = v-action-role-item-code
     4316                              buf_action-role-item.action-item-id        = temp-action-item.action-item-id
     4317                           .
     4318                           find first buf_action-item
     4319                              where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     4320                                 and buf_action-item.action-item-id  = buf_action-role-item.action-item-id
     4321                              no-lock
     4322                              no-error
     4323                              .
     4324                           if available buf_action-item then do:
     4325                              assign
     4326                                 buf_action-role-item.action-item-code = buf_action-item.action-item-code
     4327                              .
     4328                           end.
     4329                     end.
     4330                     otherwise do:
     4331                     end.
     4332                  end.
     4333                  end.
     4334               end.
     4335            end.
     4336         end.
     4337      END CASE.
     4338   end.
     4339   if p-usr then do:
     4340      define buffer buf__user          for ub._user.
     4341      define buffer buf_user-account   for ub.user-account.
     4342      define buffer buf_menu-group     for ub.menu-group.
     4343      define buffer buf_clients        for ub.clients.
     4344      define buffer buf_user-login     for ub.user-login.
     4345      define buffer buf_user-context-history    for ubflt.user-context-history.
     4346      define buffer buf_user-login-action-role  for ub.user-login-action-role.
     4347      define buffer buf_user-menu-group      for ub.user-menu-group.
     4348      define buffer buf_user-host      for ub.user-host.
     4349      define buffer buf_user-obj       for ub.user-obj.
     4350           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ПОЛЬЗОВАТЕЛИ" ) ).
     4351      define variable v-ok                          as logical   no-undo .
     4352      define variable v-user-id                     as character no-undo .
     4353      define variable v-user-login                  as character no-undo .
     4354      define variable v-last-name                   as character no-undo .
     4355      define variable v-user-password-encoded       as character no-undo .
     4356      define variable v-cntxt-menu-group-id         as character no-undo .
     4357      define variable v-cntxt-level                 as character no-undo .
     4358      define variable v-cntxt-host-code-obj         as integer   no-undo .
     4359      define variable v-cntxt-obj-type              as character no-undo .
     4360      define variable v-cntxt-obj-code              as integer   no-undo .
     4361      define variable v-arm-code-list               as character no-undo .
     4362      define variable v-arm-code-lookup-index       as integer   no-undo .
     4363      define variable v-menu-group-id-list          as character no-undo .
     4364      define variable v-menu-group-id               as character no-undo .
     4365      define variable v-user-login-role-code        as integer   no-undo .
     4366      define variable v-obj-name                    as character no-undo .
     4367      define variable v-user-menu-group-code        as integer   no-undo .
     4368      CASE p-version:
     4369         when "15.0" then do:
     4370                              _user-account:
     4371            FOR EACH temp-user-account:
     4372               FIND FIRST ub.user-account No-LOCK
     4373                    WHERE ub.user-account.user-id = temp-user-account.user-id
     4374                    NO-ERROR
     4375                    .
     4376               IF AVAILABLE ub.user-account then do:
     4377                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть ПОЛЬЗОВАТЕЛЬ(user-account):" + temp-user-account.user-id) )) .              delete temp-user-account.                   NEXT _user-account.
     4378               END.
     4379               create ub.user-account.
     4380               buffer-copy temp-user-account to ub.user-account.
     4381               release ub.user-account No-error.
     4382               if error-status:error then do:
     4383                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4384                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении записи ПОЛЬЗОВАТЕЛЯ(user-account): " + temp-user-account.user-id + " " + er-mes) )) .                NEXT _user-account.
     4385               end.
     4386            END.
     4387            run adm/restseqr.p
     4388              ( input "rest":U
     4389              , input "s-user-id":U
     4390              , input no
     4391              ) no-error .
     4392            if error-status :error then do:
     4393              return error return-value .
     4394            end.
     4395                              _user-login:
     4396            FOR EACH temp-user-login:
     4397               FIND FIRST ub.user-login No-LOCK
     4398                    WHERE ub.user-login.user-id = temp-user-login.user-id
     4399                      AND ub.user-login.db-num  = temp-user-login.db-num
     4400                    NO-ERROR
     4401                    .
     4402               IF AVAILABLE ub.user-login then do:
     4403                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть логин ПОЛЬЗОВАТЕЛЯ(user-login): "                                             + temp-user-login.user-id                                             + "БД:" + string(temp-user-login.db-num)                                             ) )) .              delete temp-user-login.                   NEXT _user-login.
     4404               END.
     4405               FIND FIRST ub.user-account No-LOCK
     4406                    WHERE ub.user-account.user-id = temp-user-login.user-id
     4407                    NO-ERROR
     4408                    .
     4409               IF NOT AVAILABLE ub.user-account then do:
     4410                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден ПОЛЬЗОВАТЕЛЬ(user-account):" + temp-user-login.user-id) )) .              delete temp-user-login.                   NEXT _user-login.
     4411               END.
     4412               create ub.user-login.
     4413               buffer-copy temp-user-login to ub.user-login.
     4414               release ub.user-login No-error.
     4415               if error-status:error then do:
     4416                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4417                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении догина ПОЛЬЗОВАТЕЛЯ(user-login): " + temp-user-login.user-id + "БД:" + string(temp-user-login.db-num) + " " + er-mes) )) .                NEXT _user-login.
     4418               end.
     4419            END.
     4420                              _user-obj:
     4421            FOR EACH temp-user-obj:
     4422               FIND FIRST ub.user-obj No-LOCK
     4423                    WHERE ub.user-obj.user-id  = temp-user-obj.user-id
     4424                      AND ub.user-obj.db-num   = temp-user-obj.db-num
     4425                      AND ub.user-obj.obj-type = temp-user-obj.obj-type
     4426                      AND ub.user-obj.obj-code = temp-user-obj.obj-code
     4427                    NO-ERROR
     4428                    .
     4429               IF AVAILABLE ub.user-obj then do:
     4430                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть объект ПОЛЬЗОВАТЕЛЯ(user-obj): "                                             + temp-user-obj.user-id                                             + "БД:" + string(temp-user-obj.db-num) + " "                                             + temp-user-obj.obj-type + ","                                             + STRING(temp-user-obj.obj-code)                                                   ) )) .              delete temp-user-obj.                   NEXT _user-obj.
     4431               END.
     4432               FIND FIRST ub.user-login No-LOCK
     4433                    WHERE ub.user-login.user-id = temp-user-obj.user-id
     4434                      AND ub.user-login.db-num  = temp-user-obj.db-num
     4435                    NO-ERROR
     4436                    .
     4437               IF NOT AVAILABLE ub.user-login then do:
     4438                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден логин ПОЛЬЗОВАТЕЛЬ(user-obj):" + temp-user-obj.user-id + "БД:" + string(temp-user-obj.db-num)) )) .              delete temp-user-obj.                   NEXT _user-obj.
     4439               END.
     4440               if not can-find(first ub.clients no-lock where
     4441                                     ub.clients.obj-type = temp-user-obj.obj-type
     4442                                 and ub.clients.obj-code = temp-user-obj.obj-code) then do:
     4443                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден объект ПОЛЬЗОВАТЕЛЬ(user-obj):" + temp-user-obj.user-id + "БД:" + string(temp-user-obj.db-num)) )) .              delete temp-user-obj.                   NEXT _user-obj.
     4444               end.
     4445               create ub.user-obj.
     4446               buffer-copy temp-user-obj to ub.user-obj.
     4447               release ub.user-obj No-error.
     4448               if error-status:error then do:
     4449                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4450                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении объекта ПОЛЬЗОВАТЕЛЯ(user-obj): "                                            + temp-user-obj.user-id                                             + "БД:" + string(temp-user-obj.db-num) + " "                                             + temp-user-obj.obj-type + ","                                             + STRING(temp-user-obj.obj-code)                                                   ) )) .                NEXT _user-obj.
     4451               end.
     4452            END.
     4453                              _user-host:
     4454            FOR EACH temp-user-host:
     4455               FIND FIRST ub.user-host No-LOCK
     4456                    WHERE ub.user-host.user-id  = temp-user-host.user-id
     4457                      AND ub.user-host.db-num   = temp-user-host.db-num
     4458                      AND ub.user-host.host-code = temp-user-host.host-code
     4459                    NO-ERROR
     4460                    .
     4461               IF AVAILABLE ub.user-host then do:
     4462                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть фирма ПОЛЬЗОВАТЕЛЯ(user-host): "                                             + temp-user-host.user-id                                             + "БД:" + string(temp-user-host.db-num) + " "                                             + STRING(temp-user-host.host-code)                                                   ) )) .              delete temp-user-host.                   NEXT _user-host.
     4463               END.
     4464               FIND FIRST ub.user-login No-LOCK
     4465                    WHERE ub.user-login.user-id = temp-user-host.user-id
     4466                      AND ub.user-login.db-num  = temp-user-host.db-num
     4467                    NO-ERROR
     4468                    .
     4469               IF NOT AVAILABLE ub.user-login then do:
     4470                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден логин ПОЛЬЗОВАТЕЛЬ(user-host):" + temp-user-host.user-id + "БД:" + string(temp-user-host.db-num)) )) .              delete temp-user-host.                   NEXT _user-host.
     4471               END.
     4472               if not can-find(first ub.sysconf no-lock where
     4473                                     ub.sysconf.host-code = temp-user-host.host-code
     4474                                 ) then do:
     4475                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найдена фирма ПОЛЬЗОВАТЕЛЬ(user-host):" + temp-user-obj.user-id + "БД:" + string(temp-user-obj.db-num)) )) .              delete temp-user-host.                   NEXT _user-host.
     4476               end.
     4477               create ub.user-host.
     4478               buffer-copy temp-user-host to ub.user-host.
     4479               release ub.user-host No-error.
     4480               if error-status:error then do:
     4481                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4482                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении фирмы ПОЛЬЗОВАТЕЛЯ(user-host): "                                             + temp-user-host.user-id                                             + "БД:" + string(temp-user-host.db-num) + " "                                             + STRING(temp-user-host.host-code)                                                   + " " + er-mes) )) .                NEXT _user-host.
     4483               end.
     4484            END.
     4485                              _user-menu-group:
     4486            FOR EACH temp-user-menu-group:
     4487               FIND FIRST ub.user-menu-group No-LOCK
     4488                    WHERE ub.user-menu-group.user-id  = temp-user-menu-group.user-id
     4489                      AND ub.user-menu-group.db-num   = temp-user-menu-group.db-num
     4490                      AND ub.user-menu-group.user-menu-group-code = temp-user-menu-group.user-menu-group-code
     4491                    NO-ERROR
     4492                    .
     4493               IF AVAILABLE ub.user-menu-group then do:
     4494                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть группа меню ПОЛЬЗОВАТЕЛЯ(user-menu-group): "                                             + temp-user-menu-group.user-id                                             + "БД:" + string(temp-user-menu-group.db-num) + " "                                             + STRING(temp-user-menu-group.user-menu-group-code)                                                   ) )) .              delete temp-user-menu-group.                   NEXT _user-menu-group.
     4495               END.
     4496               FIND FIRST ub.user-login No-LOCK
     4497                    WHERE ub.user-login.user-id = temp-user-menu-group.user-id
     4498                      AND ub.user-login.db-num  = temp-user-menu-group.db-num
     4499                    NO-ERROR
     4500                    .
     4501               IF NOT AVAILABLE ub.user-login then do:
     4502                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден логин ПОЛЬЗОВАТЕЛЬ(user-menu-group):" + temp-user-menu-group.user-id + "БД:" + string(temp-user-menu-group.db-num)) )) .              delete temp-user-menu-group.                   NEXT _user-menu-group.
     4503               END.
     4504               if not can-find(first ub.sysconf no-lock where
     4505                                     ub.sysconf.host-code = temp-user-menu-group.host-code
     4506                                 ) then do:
     4507                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найдена фирма ПОЛЬЗОВАТЕЛЬ(user-menu-group):" + temp-user-menu-group.user-id + "БД:" + string(temp-user-menu-group.db-num)) )) .              delete temp-user-menu-group.                   NEXT _user-menu-group.
     4508               end.
     4509               if not can-find(first ub.clients no-lock where
     4510                                     ub.clients.obj-type = temp-user-menu-group.obj-type
     4511                                 and ub.clients.obj-code = temp-user-menu-group.obj-code) then do:
     4512                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден объект ПОЛЬЗОВАТЕЛЬ(user-menu-group):" + temp-user-menu-group.user-id + "БД:" + string(temp-user-menu-group.db-num)) )) .              delete temp-user-menu-group.                   NEXT _user-menu-group.
     4513               end.
     4514               create ub.user-menu-group.
     4515               buffer-copy temp-user-menu-group to ub.user-menu-group.
     4516               release ub.user-menu-group No-error.
     4517               if error-status:error then do:
     4518                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4519                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении группы меню ПОЛЬЗОВАТЕЛЯ(user-menu-group): "                                             + temp-user-menu-group.user-id                                             + "БД:" + string(temp-user-menu-group.db-num) + " "                                             + STRING(temp-user-menu-group.user-menu-group-code)                                                   + " " + er-mes) )) .                NEXT _user-menu-group.
     4520               end.
     4521            END.
     4522                              _user-login-action-role:
     4523            FOR EACH temp-user-login-action-role:
     4524               FIND FIRST ub.user-login-action-role No-LOCK
     4525                    WHERE
     4526                      ub.user-login-action-role.db-num   = temp-user-login-action-role.db-num
     4527                      AND ub.user-login-action-role.user-login-role-code = temp-user-login-action-role.user-login-role-code
     4528                      AND ub.user-login-action-role.action-head-code   =   temp-user-login-action-role.action-head-code
     4529                    NO-ERROR
     4530                    .
     4531               IF AVAILABLE ub.user-login-action-role then do:
     4532                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Уже есть группа прав ПОЛЬЗОВАТЕЛЯ(user-login-action-role): "                                             + temp-user-login-action-role.user-id                                             + "БД:" + string(temp-user-login-action-role.db-num) + " "                                             + STRING(temp-user-login-action-role.user-login-role-code)                                                   ) )) .              delete temp-user-login-action-role.                   NEXT _user-login-action-role.
     4533               END.
     4534               FIND FIRST ub.user-login No-LOCK
     4535                    WHERE ub.user-login.user-id = temp-user-login-action-role.user-id
     4536                      AND ub.user-login.db-num  = temp-user-login-action-role.db-num
     4537                    NO-ERROR
     4538                    .
     4539               IF NOT AVAILABLE ub.user-login then do:
     4540                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) + " Не найден логин ПОЛЬЗОВАТЕЛЬ(user-login):" + temp-user-login-action-role.user-id + "БД:" + string(temp-user-login-action-role.db-num)) )) .              delete temp-user-login-action-role.                   NEXT _user-login-action-role.
     4541               END.
     4542               create ub.user-login-action-role.
     4543               buffer-copy temp-user-login-action-role to ub.user-login-action-role.
     4544               release ub.user-login-action-role no-error.
     4545               if error-status:error then do:
     4546                  er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     4547                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ПОЛЬЗОВАТЕЛИ" + chr(10) +  " ошибка при сохранении группы прав ПОЛЬЗОВАТЕЛЯ(user-login-action-role): "                                             + temp-user-login-action-role.user-id                                             + "БД:" + string(temp-user-login-action-role.db-num) + " "                                             + STRING(temp-user-login-action-role.user-login-role-code)                                             + " " + er-mes ) )) .                NEXT _user-login-action-role.
     4548               end.
     4549            END.
     4550            run adm/restseqr.p
     4551              ( input "rest":U
     4552              , input "s-user-login-action-role":U
     4553              , input no
     4554              ) no-error .
     4555            if error-status :error then do:
     4556              return error return-value .
     4557            end.
     4558         end.
     4559         otherwise do:
     4560            if "rus" = "rus":U
     4561            then do:
     4562               assign
     4563                  v-arm-code-list = 'офи':U
     4564                  + chr(44) + 'скл':U
     4565                  + chr(44) + 'маг':U
     4566                  + chr(44) + 'рес':U
     4567                  + chr(44) + 'фин':U
     4568                  + chr(44) + 'бгх':U
     4569                  + chr(44) + 'бух':U
     4570                  + chr(44) + 'осн':U
     4571                  + chr(44) + 'адм':U
     4572                  v-obj-name      = 'объ':U
     4573                  .
     4574            end.
     4575            else do:
     4576               assign
     4577                  v-arm-code-list = 'off':U
     4578                  + chr(44) + 'str':U
     4579                  + chr(44) + 'shp':U
     4580                  + chr(44) + 'res':U
     4581                  + chr(44) + 'fin':U
     4582                  + chr(44) + 'eac':U
     4583                  + chr(44) + 'acc':U
     4584                  + chr(44) + 'fas':U
     4585                  + chr(44) + 'adm':U
     4586                  v-obj-name      = 'object':U
     4587               .
     4588            end.
     4589            assign
     4590               v-menu-group-id-list = 'off,str,shp,res,fin,bge,buh,fas,adm':U
     4591            .
     4592                              _userconf:
     4593            FOR EACH temp-userconf:
     4594               find first buf__user
     4595                  where buf__user._userid = temp-userconf.user-name
     4596                  no-error .
     4597               if available buf__user
     4598               then do:
     4599                  assign
     4600                  v-user-login            = buf__user._userid
     4601                  v-last-name             = buf__user._user-name
     4602                  v-user-password-encoded = buf__user._password
     4603                  .
     4604               end.
     4605               else do:
     4606                  assign
     4607                  v-user-login            = temp-userconf.userid_
     4608                  v-last-name             = temp-userconf.user-name_
     4609                  v-user-password-encoded = temp-userconf.password_
     4610                  .
     4611               end.
     4612               assign
     4613                  v-user-id = substitute('&1-&2':U
     4614                                       ,g#db-num
     4615                                       ,dynamic-next-value("s-user-id":U, "ub":U)
     4616                                       )
     4617               .
     4618               create buf_user-account .
     4619               assign
     4620                  buf_user-account.user-id               = v-user-id
     4621                  buf_user-account.status_               = 0
     4622                  buf_user-account.first-name            = '':U
     4623                  buf_user-account.second-name           = '':U
     4624                  buf_user-account.last-name             = v-last-name
     4625                  buf_user-account.company               = '':U
     4626                  buf_user-account.department            = '':U
     4627                  buf_user-account.e-mail                = '':U
     4628                  buf_user-account.internal-phone-number = '':U
     4629                  buf_user-account.mobile-phone-number   = '':U
     4630                  buf_user-account.phone-number          = '':U
     4631                  buf_user-account.position              = '':U
     4632                  buf_user-account.PS                    = '':U
     4633                  buf_user-account.room                  = '':U
     4634                  buf_user-account.parent-user-id        = '':U
     4635                  buf_user-account.check-parent          = false
     4636               .
     4637               assign
     4638                  v-cntxt-menu-group-id        = '':U
     4639                  v-cntxt-level                = 'global':U
     4640                  v-cntxt-host-code-obj        = ?
     4641                  v-cntxt-obj-type             = '':U
     4642                  v-cntxt-obj-code             = ?
     4643               .
     4644               assign
     4645                  v-arm-code-lookup-index = lookup(temp-userconf.ARM, v-arm-code-list)
     4646               .
     4647               if v-arm-code-lookup-index > 0
     4648               then do:
     4649                  assign
     4650                  v-menu-group-id = entry(v-arm-code-lookup-index
     4651                                          ,v-menu-group-id-list
     4652                                          ,chr(44)
     4653                                          )
     4654                  .
     4655                  find first buf_menu-group
     4656                       where buf_menu-group.menu-code     = 0
     4657                         and buf_menu-group.menu-group-id = v-menu-group-id
     4658                       no-lock
     4659                       no-error
     4660                       .
     4661                  if available buf_menu-group
     4662                  then do:
     4663                  assign
     4664                     v-cntxt-menu-group-id = buf_menu-group.menu-group-id
     4665                  .
     4666                  end.
     4667               end.
     4668               find first buf_clients
     4669                    where buf_clients.obj-type = temp-userconf.obj-type
     4670                      and buf_clients.obj-code = temp-userconf.obj-code
     4671                    no-lock
     4672                    no-error
     4673                    .
     4674               if available buf_clients
     4675               then do:
     4676                  assign
     4677                  v-cntxt-level         = 'object':U
     4678                  v-cntxt-host-code-obj = buf_clients.host-code
     4679                  v-cntxt-obj-type      = buf_clients.obj-type
     4680                  v-cntxt-obj-code      = buf_clients.obj-code
     4681                  .
     4682               end.
     4683               else do:
     4684                  find first buf_clients
     4685                       where buf_clients.obj-type = 'орг':U
     4686                         and buf_clients.obj-code = temp-userconf.arm-host-code
     4687                       no-lock
     4688                       no-error
     4689                       .
     4690                  if available buf_clients
     4691                  then do:
     4692                  assign
     4693                     v-cntxt-level         = 'firm':U
     4694                     v-cntxt-host-code-obj = buf_clients.host-code
     4695                     v-cntxt-obj-type      = buf_clients.obj-type
     4696                     v-cntxt-obj-code      = buf_clients.obj-code
     4697                  .
     4698                  end.
     4699               end.
     4700               IF NOT CAN-FIND (FIRST ub.user-login
     4701                                where ub.user-login.db-num  = g#db-num
     4702                                  and ub.user-login.user-id = v-user-id  )
     4703               then do:
     4704                  IF CAN-FIND (FIRST ub.user-login
     4705                               where ub.user-login.db-num  = g#db-num
     4706                                 and ub.user-login.user-login = v-user-login)
     4707                  THEN DO:
     4708                     message
     4709                        "В системе уже есть пользователь с логином" v-user-login
     4710                        skip
     4711                     view-as alert-box information.
     4712                  END.
     4713                  ELSE DO:
     4714                     create ub.user-login .
     4715                     assign
     4716                        ub.user-login.db-num                     = g#db-num
     4717                        ub.user-login.user-id                    = v-user-id
     4718                        ub.user-login.last-login-computer-name   = '':U
     4719                        ub.user-login.last-login-computer-userid = '':U
     4720                        ub.user-login.last-login-mjd             = 0.0
     4721                        ub.user-login.last-login-process-id      = 0
     4722                        ub.user-login.login-error-count          = 0
     4723                        ub.user-login.max-discnt                 = temp-userconf.max-discnt
     4724                        ub.user-login.quest-print                = temp-userconf.quest-print
     4725                        ub.user-login.status_                    = 0
     4726                        ub.user-login.user-administrator         = (if v-user-login = 'адм':U
     4727                                                                     then true
     4728                                                                     else false
     4729                                                                  )
     4730                        ub.user-login.user-login                 = v-user-login
     4731                        ub.user-login.user-password-encoded      = v-user-password-encoded
     4732                     .
     4733                  END.
     4734               end.
     4735               create buf_user-context-history .
     4736               assign
     4737                  buf_user-context-history.db-num                  = g#db-num
     4738                  buf_user-context-history.user-id                 = v-user-id
     4739                  buf_user-context-history.user-context-history-id = 1
     4740                  buf_user-context-history.cntxt-menu-code         = 0
     4741                  buf_user-context-history.cntxt-menu-group-id     = v-cntxt-menu-group-id
     4742                  buf_user-context-history.cntxt-level             = v-cntxt-level
     4743                  buf_user-context-history.cntxt-host-code         = v-cntxt-host-code-obj
     4744                  buf_user-context-history.cntxt-obj-type          = v-cntxt-obj-type
     4745                  buf_user-context-history.cntxt-obj-code          = v-cntxt-obj-code
     4746                  buf_user-context-history.cntxt-change-mjd        = 0
     4747               .
     4748            END.
     4749            _user-login:
     4750            for each buf_user-login no-lock
     4751            on error undo, return error return-value
     4752            :
     4753               _usr-grpa:
     4754               for each  temp-usr-grpa no-lock
     4755                   where temp-usr-grpa.user-name = buf_user-login.user-login
     4756               on error undo, return error return-value
     4757               :
     4758                  IF lookup( temp-usr-grpa.arm-code, v-arm-code-list) > 0 then do:
     4759                  assign
     4760                     v-menu-group-id = entry( lookup( temp-usr-grpa.arm-code, v-arm-code-list), v-menu-group-id-list)
     4761                  .
     4762                  end.
     4763                  else do:
     4764                     next _usr-grpa.
     4765                  end.
     4766                  FIND FIRST buf_menu-group
     4767                       where buf_menu-group.menu-code     = 0
     4768                         AND buf_menu-group.menu-group-id = v-menu-group-id
     4769                       no-lock
     4770                       no-error
     4771                       .
     4772                  IF NOT AVAILABLE buf_menu-group
     4773                  THEN DO:
     4774                     next _usr-grpa.
     4775                  END.
     4776                  find first buf_user-menu-group
     4777                  where buf_user-menu-group.db-num          = g#db-num
     4778                     and buf_user-menu-group.user-id         = buf_user-login.user-id
     4779                     and buf_user-menu-group.menu-code       = 0
     4780                     and buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     4781                     and buf_user-menu-group.menu-group-context = 'firm':U
     4782                     and buf_user-menu-group.host-code       = temp-usr-grpa.host-code
     4783                     and buf_user-menu-group.obj-type        = "":U
     4784                     and buf_user-menu-group.obj-code        = 0
     4785                     and buf_user-menu-group.menu-group-id   = v-menu-group-id
     4786                  no-error .
     4787                  if not available buf_user-menu-group then do:
     4788                     ASSIGN
     4789                        v-user-menu-group-code = next-value(s-user-menu-group, ub)
     4790                     .
     4791                     create buf_user-menu-group.
     4792                     assign
     4793                        buf_user-menu-group.db-num        = g#db-num
     4794                        buf_user-menu-group.user-id       = buf_user-login.user-id
     4795                        buf_user-menu-group.menu-code     = 0
     4796                        buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     4797                        buf_user-menu-group.menu-group-id = v-menu-group-id
     4798                        buf_user-menu-group.menu-group-context       = 'firm':U
     4799                        buf_user-menu-group.user-menu-group-code      = v-user-menu-group-code
     4800                        buf_user-menu-group.host-code     = temp-usr-grpa.host-code
     4801                        buf_user-menu-group.obj-type      = "":U
     4802                        buf_user-menu-group.obj-code      = 0
     4803                     .
     4804                     for each temp-usr-grpo no-lock
     4805                        where temp-usr-grpo.user-name = buf_user-login.user-login
     4806                     on error undo, return error return-value
     4807                     :
     4808                        find first buf_clients no-lock
     4809                           where buf_clients.obj-type   = temp-usr-grpo.obj-type
     4810                              and buf_clients.obj-code  = temp-usr-grpo.obj-code
     4811                              and buf_clients.host-code = temp-usr-grpa.host-code
     4812                           no-error .
     4813                        find first buf_user-menu-group
     4814                           where buf_user-menu-group.db-num          = g#db-num
     4815                              and buf_user-menu-group.user-id         = buf_user-login.user-id
     4816                              and buf_user-menu-group.menu-code       = 0
     4817                              and buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     4818                              and buf_user-menu-group.menu-group-context = 'object':U
     4819                              and buf_user-menu-group.host-code       = temp-usr-grpa.host-code
     4820                              and buf_user-menu-group.obj-type        = temp-usr-grpo.obj-type
     4821                              and buf_user-menu-group.obj-code        = temp-usr-grpo.obj-code
     4822                              and buf_user-menu-group.menu-group-id   = v-menu-group-id
     4823                           no-error .
     4824                        if  available buf_clients
     4825                        and not available buf_user-menu-group
     4826                        then DO:
     4827                           ASSIGN
     4828                              v-user-menu-group-code = next-value(s-user-menu-group, ub)
     4829                           .
