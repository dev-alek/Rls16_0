     3972                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " PLU больше Max кол-ва товаров на весах для ТОВАРА НА ВЕСАХ(scales-gds):" +                         " номер весов " + string(temp-scales-gds.scales-num) +                         " PLU " + string(temp-scales-gds.PLU-code)) )) .              delete temp-scales-gds.                   NEXT _scales-gdsv.
