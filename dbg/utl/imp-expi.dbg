     5644                                                         IF CAN-FIND(FIRST temp-user-account No-LOCK WHERE
     5645                                                temp-user-account.user-id = buf-user-account.user-id) then do:
     5646                                                                     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ПОЛЬЗОВАТЕЛЬ(user-account): " + buf-user-account.user-id) )) .              delete buf-user-account.                   NEXT _usr.
