     5033                              buf_user-login-action-role.obj-type             = '':U
     5034                              buf_user-login-action-role.obj-code             = 0
     5035                              buf_user-login-action-role.gds-grp-code         = ?
     5036                              buf_user-login-action-role.gds-code             = ?
     5037                              buf_user-login-action-role.cli-grp-code         = ?
     5038                           .
     5039                           end.
     5040                           if v-object-action-role-code <> 0
     5041                           then do:
     5042                           assign
