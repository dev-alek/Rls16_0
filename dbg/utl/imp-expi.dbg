     4070               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) +  " ошибка при сохранении записи ГРУППА ТОВАРОВ НА ВЕСАХ(scales-grp):" +                                       " номер группы " + string(temp-scales-grp.node-code) +                                       " номер весов " + string(temp-scales-grp.scales-num) +                                       er-mes) )) .                NEXT _scales-grpv.
