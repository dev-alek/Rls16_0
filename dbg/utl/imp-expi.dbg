     3079   procedure gdsoattr-delete :
     3080     define input  parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     3081     define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     3082     define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     3083     define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     3084     define output parameter p-deleted  as logical no-undo .
     3085     do
