     5635                     then do:
     5636                        current-table = ss.
     5637                        case current-table:
     5638                           when "user-account":U then do:
     5639                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5640                              create buf-user-account.
