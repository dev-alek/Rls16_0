     5144   if p-seq then do:
     5145           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных СЧЕТЧИКИ" ) ).
     5146         _sequencev:
     5147     FOR EACH temp_sequence NO-LOCK:
     5148       FIND FIRST ub._sequence No-LOCK WHERE
     5149                 ub._sequence._seq-name = temp_sequence.seq-name NO-ERROR.
     5150       IF NOT AVAILABLE ubflt.filter then do:
     5151               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных СЧЕТЧИКИ" + chr(10) + " В БД нет СЧЕТЧИКА(sequence):" +                       " название " + string(temp_sequence.seq-name)) )) .              delete temp_sequence.                   NEXT _sequencev.
     5152       end.
     5153       if dynamic-current-value( temp_sequence.seq-name, "ub":U ) < temp_sequence.seq-val then do:
     5154         assign
     5155           dynamic-current-value( temp_sequence.seq-name, "ub":U ) = temp_sequence.seq-val
     5156         .
     5157       end.
     5158     END.
     5159   end.
     5160   session:system-alert-boxes = loc-alert-box.
     5161   procedure p-gen-i :
     5162     do
     5163     on error undo, return error
     5164     :
     5165     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ИНФОРМАЦИЯ O БД" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "gen":U) )) .
     5166     run check-iefile in this-procedure(input p-dir-name,                                      input "gen":U,                                      input "import":U,                                      output loc#log).
     5167     ii = 0.
     5168     if loc#log then do:
     5169       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ИНФОРМАЦИЯ O БД" ) ).
     5170       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "gen":U).
     5171       _gen:
     5172       REPEAT:
     5173         import stream Instream unformatted ss.
     5174         CASE ss:
     5175           when "config":U then do:
     5176             current-table = ss.
     5177             case current-table:
     5178               when "config":U then do:
     5179                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5180                 create buf-config.
     5181                 CASE p-version:
     5182                   when "12.3" then do:
     5183                     import stream Instream buf-config.conf-type                                 v-log-gap                                            buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value no-error.
     5184                   end.
     5185                   when "14.1" then do:
     5186                     import stream Instream v-arm-code                                 buf-config.conf-type                                 v-grp-name                                 buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value                                 v-user-name no-error.
     5187                   end.
     5188                   otherwise do:
     5189                     import stream Instream buf-config.conf-type                                 buf-config.host-code                                 buf-config.obj-code                                 buf-config.obj-type                                 buf-config.param-code                                 buf-config.param-encoded                                 buf-config.param-type                                 buf-config.param-value no-error.
     5190                   end.
     5191                 END CASE.
     5192                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _gen.                   end.
     5193                               IF CAN-FIND(FIRST temp-config No-LOCK WHERE
     5194                                   temp-config.param-code = buf-config.param-code AND
     5195                                   temp-config.host-code = buf-config.host-code AND
     5196                                   temp-config.obj-type = buf-config.obj-type AND
     5197                                   temp-config.obj-code = buf-config.obj-code
     5198                                    )
     5199                                   then do:
     5200                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + " Уже есть запись НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                   " параметр " + buf-config.param-code +                                   " Фирма " + string(buf-config.host-code) +                                   " тип объекта " + buf-config.obj-type +                                   " код объекта " + string(buf-config.obj-code) ) )) .              delete buf-config.                   NEXT _gen.
     5201                 end.
     5202                 if lookup( buf-config.conf-type, 'к,п':U ) > 0 then do:
     5203                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ИНФОРМАЦИЯ O БД, СТРОКА " + string(ii) + chr(10)) + " НАСТРОЕЧНОГО ПАРАМЕТРА(config) является кодированным" +                                   " параметр " + buf-config.param-code +                                   " Фирма " + string(buf-config.host-code) +                                   " тип объекта " + buf-config.obj-type +                                   " код объекта " + string(buf-config.obj-code) ) )) .              delete buf-config.                   NEXT _gen.
     5204                 end.
     5205                 create temp-config.
     5206                 buffer-copy buf-config to temp-config.
     5207                 delete buf-config.
     5208               end.
     5209             end CASE.
     5210           end.
     5211           otherwise do:
     5212           end.
     5213         END CASE.
     5214       END.
     5215       input stream InStream close.
     5216     end.
     5217     end.
     5218   end procedure.
     5219   procedure p-flt-i :
     5220     do
     5221     on error undo, return error
     5222     :
     5223     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ФИЛЬТРЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "flt":U) )) .
     5224     run check-iefile in this-procedure(input p-dir-name,                                      input "flt":U,                                      input "import":U,                                      output loc#log).
     5225     ii = 0.
     5226     if loc#log then do:
     5227       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ФИЛЬТРЫ" ) ).
     5228       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "flt":U).
     5229       _flt:
     5230       REPEAT:
     5231         import stream Instream unformatted ss.
     5232         CASE ss:
     5233           when "filter":U then do:
     5234             current-table = ss.
     5235             case current-table:
     5236               when "filter":U then do:
     5237                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5238                 create buf-filter.
     5239                 import stream Instream buf-Filter.Fields-sort-rus                                 buf-Filter.Fields-sort                                 buf-Filter.Flds                                 buf-Filter.Naim                                 buf-Filter.Num-flt                                 buf-Filter.Tbl                                 buf-Filter.Where-ysl-rus                                 buf-Filter.Where-ysl                                 buf-Filter.call-point                                 buf-Filter.lst-cend no-error.
     5240                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ФИЛЬТРЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _flt.                   end.
     5241                               assign
     5242                 buf-filter.where-ysl = replace(buf-filter.where-ysl, chr(1), chr(4))
     5243                 buf-filter.where-ysl-rus = replace(buf-filter.where-ysl-rus, chr(1), chr(4))
     5244                 buf-filter.fields-sort-rus = replace(buf-filter.fields-sort-rus, chr(1), chr(4))
     5245                 buf-filter.fields-sort = replace(buf-filter.fields-sort, chr(1), chr(4))
     5246                 buf-filter.call-point = replace(buf-filter.call-point, chr(1), chr(4))
     5247                 .
     5248                 IF CAN-FIND(FIRST temp-filter No-LOCK WHERE
     5249                                   temp-filter.call-point = buf-filter.call-point AND
     5250                                   temp-filter.NAIM = buf-filter.NAIM
     5251                                   )
     5252                                   then do:
     5253                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ФИЛЬТРЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ФИЛЬТР(filter):" +                                  " название " + string(buf-filter.Naim) +                                  " точка вызова " + buf-filter.call-point) )) .              delete buf-filter.                   NEXT _flt.
     5254                 end.
     5255                 create temp-filter.
     5256                 buffer-copy buf-filter to temp-filter.
     5257                 delete buf-filter.
     5258               end.
     5259             end CASE.
     5260           end.
     5261           otherwise do:
     5262           end.
     5263         END CASE.
     5264       END.
     5265       input stream InStream close.
     5266     end.
     5267     end.
     5268   end procedure.
     5269   procedure p-pbc-i :
     5270     do
     5271     on error undo, return error
     5272     :
     5273     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ВЕС и ВЗВЕШ КОДЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "pbc":U) )) .
     5274     run check-iefile in this-procedure(input p-dir-name,                                      input "pbc":U,                                      input "import":U,                                      output loc#log).
     5275     ii = 0.
     5276     if loc#log then do:
     5277       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ВЕС и ВЗВЕШ КОДЫ" ) ).
     5278       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "pbc":U).
     5279       _pbc:
     5280       REPEAT:
     5281         import stream Instream unformatted ss.
     5282         CASE ss:
     5283           when "prod-bc":U then do:
     5284             current-table = ss.
     5285             case current-table:
     5286               when "prod-bc":U then do:
     5287                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5288                 create buf-prod-bc.
     5289                 import stream Instream buf-prod-bc.b-code                                 buf-prod-bc.b-str                                 buf-prod-bc.bc-on no-error.
     5290                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС и ВЗВЕШ КОДЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pbc.                   end.
     5291                               IF CAN-FIND(FIRST temp-prod-bc No-LOCK WHERE
     5292                                   temp-prod-bc.b-str = buf-prod-bc.b-str
     5293                               AND temp-prod-bc.b-code = buf-prod-bc.b-code )
     5294                                   then do:
     5295                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС и ВЗВЕШ КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ДопБК(prod-bc):" +                                  " ДопБК " + string(buf-prod-bc.b-str) +                                  " Бар-код " + string(buf-prod-bc.b-code)) )) .              delete buf-prod-bc.                   NEXT _pbc.
     5296                 end.
     5297                 create temp-prod-bc.
     5298                 buffer-copy buf-prod-bc to temp-prod-bc.
     5299                 delete buf-prod-bc.
     5300               end.
     5301               when "gds-obj-attr":U then do:
     5302                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5303                 create ub.gds-obj-attr.
     5304                 import stream Instream buf-gds-obj-attr.gds-code                                 buf-gds-obj-attr.obj-type                                 buf-gds-obj-attr.obj-code                                 buf-gds-obj-attr.attr-code                                 buf-gds-obj-attr.attr-value no-error.
     5305                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС и ВЗВЕШ КОДЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _pbc.                   end.
     5306                               IF CAN-FIND(FIRST temp-gds-obj-attr No-LOCK WHERE
     5307                                   temp-gds-obj-attr.gds-code = buf-gds-obj-attr.gds-code
     5308                               AND temp-gds-obj-attr.obj-type = buf-gds-obj-attr.obj-type
     5309                               AND temp-gds-obj-attr.obj-code = buf-gds-obj-attr.obj-code
     5310                               AND temp-gds-obj-attr.attr-code = buf-gds-obj-attr.attr-code )
     5311                                   then do:
     5312                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕС и ВЗВЕШ КОДЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть атрибут товара ВЕСОВОЙ КОД НА ОБЪЕКТЕ(gds-obj-attr):" +                                  " Код товара " + string(buf-gds-obj-attr.gds-code) +                                  " Объект " + gds-obj-attr.obj-type + string(buf-gds-obj-attr.obj-code) +                                  " Весовой код " + string(buf-gds-obj-attr.attr-value) ) )) .              delete buf-gds-obj-attr.                   NEXT _pbc.
     5313                 end.
     5314                 create temp-gds-obj-attr.
     5315                 buffer-copy buf-gds-obj-attr to temp-gds-obj-attr.
     5316                 delete buf-gds-obj-attr.
     5317               end.
     5318             end CASE.
     5319           end.
     5320           otherwise do:
     5321           end.
     5322         END CASE.
     5323       END.
     5324       input stream InStream close.
     5325     end.
     5326     end.
     5327   end procedure.
     5328   procedure p-scl-i :
     5329     do
     5330     on error undo, return error
     5331     :
     5332     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ВЕСЫ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "scl":U) )) .
     5333     run check-iefile in this-procedure(input p-dir-name,                                      input "scl":U,                                      input "import":U,                                      output loc#log).
     5334     ii = 0.
     5335     if loc#log then do:
     5336       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ВЕСЫ" ) ).
     5337       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "scl":U).
     5338       _scl:
     5339       REPEAT:
     5340         import stream Instream unformatted ss.
     5341         CASE ss:
     5342           when "scales":U or when "scales-gds":U or when "scales-grp":U then do:
     5343             current-table = ss.
     5344             case current-table:
     5345               when "scales":U then do:
     5346                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5347                 create buf-scales.
     5348                 CASE p-version:
     5349                   when "12.3" then do:
     5350                     import stream Instream buf-scales.address                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart no-error.
     5351                   end.
     5352                   when "14.1" then do:
     5353                     import stream Instream buf-scales.address                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart                                  buf-scales.remote no-error.
     5354                   end.
     5355                   when "15.0" then do:
     5356                     import stream Instream buf-scales.address                                 buf-scales.db-num                                 buf-scales.master                                 buf-scales.max-gds                                 buf-scales.max-plu                                 buf-scales.scales-name                                 buf-scales.scales-num                                 buf-scales.scales-type                                 buf-scales.to-send                                 buf-scales.tot-gds                                 buf-scales.unit-base                                 buf-scales.wt-cart                                  buf-scales.remote no-error.
     5357                   end.
     5358                 END CASE.
     5359                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _scl.                   end.
     5360                               IF CAN-FIND(FIRST temp-scales No-LOCK WHERE
     5361                                   temp-scales.db-num = buf-scales.db-num AND
     5362                                   temp-scales.scales-num = buf-scales.scales-num )
     5363                                   then do:
     5364                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ВЕСЫ(scales):" +                                  " номер " + string(buf-scales.scales-num)) )) .              delete buf-scales.                   NEXT _scl.
     5365                 end.
     5366                 create temp-scales.
     5367                 buffer-copy buf-scales to temp-scales.
     5368                 assign
     5369                 temp-scales.db-num = (if p-version < "15.0"
     5370                                       then g#db-num
     5371                                       else temp-scales.db-num)
     5372                 .
     5373                 delete buf-scales.
     5374               end.
     5375               when "scales-gds":U then do:
     5376                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5377                 create buf-scales-gds.
     5378                 CASE p-version:
     5379                   when "15.0" then do:
     5380                      import stream Instream buf-scales-gds.PLU-code                                 buf-scales-gds.b-code                                 buf-scales-gds.db-num                                 buf-scales-gds.deadline                                 buf-scales-gds.obj-code                                 buf-scales-gds.obj-type                                 buf-scales-gds.scales-num                                 buf-scales-gds.to-del                                 buf-scales-gds.to-send                                 buf-scales-gds.wt-cart                                 buf-scales-gds.deaddate                                 buf-scales-gds.deadflag                                 buf-scales-gds.deadtime no-error.
     5381                   end.
     5382                   otherwise do:
     5383                     import stream Instream buf-scales-gds.PLU-code                                 buf-scales-gds.b-code                                 buf-scales-gds.deadline                                 buf-scales-gds.obj-code                                 buf-scales-gds.obj-type                                 buf-scales-gds.scales-num                                 buf-scales-gds.to-del                                 buf-scales-gds.to-send                                 buf-scales-gds.wt-cart no-error.
     5384                   end.
     5385                 END CASE.
     5386                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _scl.                   end.
     5387                               IF CAN-FIND(FIRST temp-scales-gds No-LOCK WHERE
     5388                                   temp-scales-gds.db-num = buf-scales-gds.db-num AND
     5389                                   temp-scales-gds.scales-num = buf-scales-gds.scales-num AND
     5390                                   temp-scales-gds.PLU-code = buf-scales-gds.PLU-code)
     5391                                   then do:
     5392                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТОВАР НА ВЕСАХ(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " PLU " + string(buf-scales-gds.PLU-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     5393                 end.
     5394                 IF CAN-FIND(FIRST temp-scales-gds No-LOCK WHERE
     5395                                   temp-scales-gds.db-num = buf-scales-gds.db-num AND
     5396                                   temp-scales-gds.scales-num = buf-scales-gds.scales-num AND
     5397                                   temp-scales-gds.b-code = buf-scales-gds.b-code)
     5398                                   then do:
     5399                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ТОВАР НА ВЕСАХ(scales-gds):" +                                  " номер весов " + string(buf-scales-gds.scales-num) +                                  " бар-код " + string(buf-scales-gds.b-code)) )) .              delete buf-scales-gds.                   NEXT _scl.
     5400                 end.
     5401                 create temp-scales-gds.
     5402                 buffer-copy buf-scales-gds to temp-scales-gds
     5403                 assign
     5404                 temp-scales-gds.db-num = (if p-version < "15.0"
     5405                                       then g#db-num
     5406                                       else temp-scales-gds.db-num)
     5407                 .
     5408                 delete buf-scales-gds.
     5409               end.
     5410               when "scales-grp":U then do:
     5411                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5412                 create buf-scales-grp.
     5413                 import stream Instream buf-scales-grp.node-code                                 buf-scales-grp.scales-num no-error.
     5414                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _scl.                   end.
     5415                               IF CAN-FIND(FIRST temp-scales-grp No-LOCK WHERE
     5416                                   temp-scales-grp.db-num = buf-scales-grp.db-num AND
     5417                                   temp-scales-grp.scales-num = buf-scales-grp.scales-num AND
     5418                                   temp-scales-grp.node-code = buf-scales-grp.node-code)
     5419                                   then do:
     5420                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ВЕСЫ, СТРОКА " + string(ii) + chr(10)) + " Уже есть ГРУППА ТОВАРА НА ВЕСАХ(scales-grp):" +                                  " номер группы " + string(buf-scales-grp.node-code) +                                  " номер весов " + string(buf-scales-grp.scales-num)) )) .              delete buf-scales-grp.                   NEXT _scl.
     5421                 end.
     5422                 create temp-scales-grp.
     5423                 buffer-copy buf-scales-grp to temp-scales-grp.
     5424                 assign temp-scales-grp.db-num = g#db-num.
     5425                 delete buf-scales-grp.
     5426               end.
     5427             end CASE.
     5428           end.
     5429           otherwise do:
     5430           end.
     5431         END CASE.
     5432       END.
     5433       input stream InStream close.
     5434     end.
     5435     end.
     5436   end procedure.
     5437   procedure p-seq-i :
     5438     do
     5439     on error undo, return error
     5440     :
     5441     run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных СЧЕТЧИКИ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "seq":U) )) .
     5442     run check-iefile in this-procedure(input p-dir-name,                                      input "seq":U,                                      input "import":U,                                      output loc#log).
     5443     ii = 0.
     5444     if loc#log then do:
     5445       run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных СЧЕТЧИКИ" ) ).
     5446       input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "seq":U).
     5447       _seq:
     5448       REPEAT:
     5449         import stream Instream unformatted ss.
     5450         CASE ss:
     5451           when "_sequence":U then do:
     5452             current-table = ss.
     5453             case current-table:
     5454               when "sequence":U then do:
     5455                 ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5456                 create buf_sequence.
     5457                 import stream Instream  no-error.
     5458                               if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных СЧЕТЧИКИ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _seq.                   end.
     5459                               if LOOKUP(buf_sequence.seq-name, 'next-report,s-doc,s-doc-type,s-file-num,':U +                                 's-line-num,s-petrol-code,s-reserve2':U +                                 ',s-spool,s-task-num,s-tax-rate,synch-cli-grp,synch-gds-grp' ) = 0 then next _seq.
     5460                 IF CAN-FIND(FIRST temp_sequence No-LOCK WHERE
     5461                                   temp_sequence.seq-name = buf_sequence.seq-name
     5462                                   )
     5463                                   then do:
     5464                                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных СЧЕТЧИКИ, СТРОКА " + string(ii) + chr(10)) + " Уже есть СЧЕТЧИК(sequence):" +                                  " название " + string(buf_sequence.seq-name)) )) .              delete buf_sequence.                   NEXT _seq.
     5465                 end.
     5466                 create temp_sequence.
     5467                 buffer-copy buf_sequence to temp_sequence.
     5468                 delete buf_sequence.
     5469               end.
     5470             end CASE.
     5471           end.
     5472           otherwise do:
     5473           end.
     5474         END CASE.
     5475       END.
     5476       input stream InStream close.
     5477     end.
     5478     end.
     5479   end procedure.
     5480   procedure p-rht-i :
     5481   define variable v-curr-seek as integer no-undo .
     5482     do
     5483     on error undo, return error
     5484     :
     5485      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ПРАВА" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "rht":U) )) .
     5486      run check-iefile in this-procedure(input p-dir-name,                                      input "rht":U,                                      input "import":U,                                      output loc#log).
     5487      ii = 0.
     5488      if loc#log then do:
     5489         run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ПРАВА" ) ).
     5490         input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "rht":U).
     5491         CASE p-version:
     5492            when "15.0" then do:
     5493                  _rht:
     5494                  REPEAT:
     5495                     import stream Instream unformatted ss.
     5496                     ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5497                     CASE ss:
     5498                     when "action-role":U or
     5499                     when "action-role-item":U
     5500                     then do:
     5501                        current-table = ss.
     5502                        case current-table:
     5503                           when "action-role":U then do:
     5504                              ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
     5505                              create buf-action-role.
     5506                              v-curr-seek = seek(instream).
     5507                              import stream Instream buf-action-role.db-num                                  buf-action-role.action-head-code                                  buf-action-role.action-role-code                                  buf-action-role.action-role-context                                  buf-action-role.action-role-name                                  buf-action-role.action-role-description                                  buf-action-role.whole-send-news no-error.
     5508                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт группы данных ПРАВА, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _rht.                   end.
