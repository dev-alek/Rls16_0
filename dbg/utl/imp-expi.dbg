     3887               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " ошибка при сохранении записи АТРИБУТ ТОВАРА ВЕСОВОЙ КОД НА ОБЪЕКТЕ(gds-obj-attr):" +                       " код товара " + string(temp-gds-obj-attr.gds-code) +                       " объект " + temp-gds-obj-attr.obj-type + string(temp-gds-obj-attr.obj-code) +                       " весовой код " + temp-gds-obj-attr.attr-value +                       er-mes) )) .                NEXT _gds-obj-attrv.
