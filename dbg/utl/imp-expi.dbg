        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 826c1485520b, 1287, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        8   define variable vss-date        as character no-undo init "$Date: Tue Apr 10 12:02:59 2018 +0300 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: imp-expi.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/imp-expi.p $":U .
       11   define variable vss-description as character no-undo init "Процедура экспорта локальных таблиц УБД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable p-rht as logical no-undo .
       67   define variable p-gen as logical no-undo .
       68   define variable p-flt as logical no-undo .
       69   define variable p-pbc as logical no-undo .
       70   define variable p-scl as logical no-undo .
       71   define variable p-usr as logical no-undo .
       72   define variable p-seq as logical no-undo .
       73   define variable p-db-key as character no-undo .
       74   define variable p-dir-name as character no-undo .
       75   define variable p-version as character no-undo .
       76   define variable p-glb as logical no-undo .
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   function corr-file-name returns character (
       94    input p-file-name as character)
       95    .
       96   DEFINE variable v-corr-file-name as character no-undo.
       97   DEFINE VARIABLE ii as integer no-undo .
       98   DEFINE VARIABLE v-char-name-list as character no-undo .
       99   assign
      100   v-corr-file-name = p-file-name
      101   .
      102   do ii = 1 to length('\/:*?"<>|':U):
      103     assign
      104     v-corr-file-name = replace(
      105                                   v-corr-file-name
      106                                  , substr('\/:*?"<>|':U, ii, 1 )
      107                                  , entry(ii, 'b-slash,slash,colon,star,question,d-quote,d-quote,less-t,great-t,pipe':U)
      108                              )
      109     .
      110   end.
      111   return v-corr-file-name.
      112   end function.
      113   define variable log-file-name as character no-undo init "imp-exp.log".
      114   define variable v-view-log as logical no-undo .
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable v-log-gap as logical no-undo .
      117   define variable v-user-name    as character    no-undo.
      118   define variable v-grp-name    as character    no-undo.
      119   define variable v-arm-code    as character    no-undo.
      120   Procedure check-iefile:
      121   DEFINE INPUT PARAMETER p-dir-name as character no-undo.
      122   DEFINE INPUT PARAMETER p-file-extension as character no-undo.
      123   DEFINE INPUT PARAMETER p-mode as character no-undo.
      124   define output parameter p-ok as logical no-undo.
      125   define variable full_name as character no-undo.
      126   find first ub.sys-ctrl No-LOCK No-ERROR.
      127   if not avail ub.sys-ctrl then do:
      128       run write-log-and-file in p-log-handle (
      129             input 1
      130           , input log-file-name
      131           , input 1
      132           , input substitute( "!!!Отсутствует информация в таблице sys-ctrl"
      133                             )
      134                                             ).
      135       return error.
      136   end.
      137   FIND FIRST ub.db No-LOCK WHERE
      138              ub.db.db-num = ub.sys-ctrl.db-num NO-ERROR.
      139   if not avail ub.db then do:
      140       run write-log-and-file in p-log-handle (
      141             input 1
      142           , input log-file-name
      143           , input 1
      144           , input substitute( "!!!Отсутствует информация в таблице db"
      145                             )
      146                                             ).
      147       return error.
      148   end.
      149   full_name = p-dir-name + "\":U + corr-file-name(string(ub.db.db-key)) + "." + p-file-extension.
      150   if p-mode = "import":U then do:
      151       if search(full_name) = ? then do:
      152         run write-log-and-file in p-log-handle (
      153               input 1
      154             , input log-file-name
      155             , input 1
      156             , input substitute( "!!!Не найден файл данных &1", full_name
      157                               )
      158                                               ).
      159           p-ok = no.
      160           return.
      161       end.
      162       p-ok = yes.
      163       return.
      164   end.
      165   if p-mode = "export":U then do:
      166       if search(full_name) <> ? then do:
      167       message substitute("Уже имеется в выбранной директории файл с именем &1&2" +
      168                          "совпадающим с именем одного из файлов экспорта&2" +
      169                          "Перезаписывать?"
      170                          ,full_name
      171                          , chr(10))
      172       view-as alert-box QUESTION buttons YES-NO update p-ok.
      173       return.
      174     end.
      175     p-ok = yes.
      176     return.
      177   end.
      178   END PROCEDURE.
      179   function diff-list returns character (
      180     input parfirst-list  as character,
      181     input parsecond-list as character,
      182     input pardelim       as character).
      183     if pardelim = ""
      184     or pardelim = ?
      185     then do:
      186       assign
      187         pardelim = ","
      188       .
      189     end.
      190     def var ind as integer no-undo .
      191     def var v-elem as character no-undo .
      192     def var v-result-list as character no-undo init "".
      193     def var v-num-parfirst-list as integer no-undo .
      194     assign
      195       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      196     .
      197     do ind = 1 to v-num-parfirst-list
      198     :
      199       assign
      200         v-elem = entry(ind, parfirst-list, pardelim)
      201       .
      202       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      203         assign
      204           v-result-list = v-result-list
      205                         + (if v-result-list > "" then pardelim else "")
      206                         + v-elem
      207         .
      208       end.
      209     end.
      210     return v-result-list .
      211   end function.
      212   function add-list returns character (
      213    input parfirst-list  as character,
      214    input parsecond-list as character,
      215    input pardelim       as character).
      216     if pardelim = ""
      217     or pardelim = ?
      218     then do:
      219       assign
      220         pardelim = ","
      221       .
      222     end.
      223     def var ind as integer no-undo .
      224     def var v-elem as character no-undo .
      225     def var v-result-list as character no-undo init "".
      226     def var v-num-parfirst-list as integer no-undo .
      227     assign
      228       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      229     .
      230     do ind = 1 to v-num-parfirst-list
      231     :
      232       assign
      233         v-elem = entry(ind, parfirst-list, pardelim)
      234       .
      235       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      236         assign
      237           v-result-list = v-result-list
      238                         + (if v-result-list > "" then pardelim else "")
      239                         + v-elem
      240         .
      241       end.
      242     end.
      243     def var v-num-parsecond-list as integer no-undo .
      244     assign
      245       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      246     .
      247     do ind = 1 to v-num-parsecond-list
      248     :
      249       assign
      250         v-elem = entry(ind, parsecond-list, pardelim)
      251       .
      252       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      253         assign
      254           v-result-list = v-result-list
      255                         + (if v-result-list > "" then pardelim else "")
      256                         + v-elem
      257         .
      258       end.
      259     end.
      260     return v-result-list .
      261   end function.
      262   function cross-list returns character (
      263    input parfirst-list  as character,
      264    input parsecond-list as character,
      265    input pardelim       as character).
      266     if pardelim = ""
      267     or pardelim = ?
      268     then do:
      269       assign
      270         pardelim = ","
      271       .
      272     end.
      273     def var ind as integer no-undo .
      274     def var v-elem as character no-undo .
      275     def var v-result-list as character no-undo init "".
      276     def var v-num-parfirst-list as integer no-undo .
      277     assign
      278       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      279     .
      280     do ind = 1 to v-num-parfirst-list
      281     :
      282       assign
      283         v-elem = entry(ind, parfirst-list, pardelim)
      284       .
      285       if lookup(v-elem, v-result-list, pardelim) = 0
      286       and lookup(v-elem, parsecond-list, pardelim) > 0
      287       then do:
      288         assign
      289           v-result-list = v-result-list
      290                         + (if v-result-list > "" then pardelim else "")
      291                         + v-elem
      292         .
      293       end.
      294     end.
      295     return v-result-list .
      296   end function.
      297   function radio-label returns character (
      298    input par-rs-value  as character,
      299    input par-rs-radio-buttons as character)
      300    .
      301    DEFINE variable v-result-label as character no-undo.
      302    assign
      303    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      304                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      305                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      306                             ), par-rs-radio-buttons
      307                           )
      308    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      309    .
      310   return v-result-label.
      311   end function.
      312   function m-radio-label returns character (
      313    input par-rs-value  as character,
      314    input par-rs-radio-buttons as character,
      315    input par-delim as character
      316    )
      317    .
      318    DEFINE variable v-result-label as character no-undo.
      319    assign
      320    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      321                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      322                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      323                             ), par-rs-radio-buttons, par-delim
      324                           )
      325    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      326    .
      327   return v-result-label.
      328   end function.
      329   FUNCTION mixlist returns character
      330   (
      331    input parfirst-list  as character
      332    ,input parsecond-list as character
      333    ,input pardelim       as character
      334    ,input pardelim-result as character ) :
      335     if pardelim = ""
      336     or pardelim = ?
      337     then do:
      338       assign
      339         pardelim = ","
      340       .
      341     end.
      342     def var ind as integer no-undo .
      343     def var v-elem1 as character no-undo .
      344     def var v-elem2 as character no-undo .
      345     def var v-result-list as character no-undo init "".
      346     do ind = 1 to num-entries(parfirst-list, pardelim)
      347     :
      348       assign
      349         v-elem1 = entry(ind, parfirst-list, pardelim)
      350         v-elem2 = entry(ind, parsecond-list, pardelim)
      351       .
      352         assign
      353           v-result-list = v-result-list
      354                         + (if v-result-list > "" then pardelim-result else "")
      355                         + v-elem1 + pardelim-result + v-elem2
      356         .
      357     end.
      358     return v-result-list .
      359   END FUNCTION.
      360   define stream getmc-stream .
      361   procedure get-max-code :
      362     define input  parameter p-action         as   character                 no-undo .
      363     define input  parameter p-db-num         like ub.db.db-num             no-undo .
      364     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
      365     define input  parameter p-first-code     like ub.code-range.first-code no-undo .
      366     define input  parameter p-last-code      like ub.code-range.last-code  no-undo .
      367     define input  parameter p-view-mess      as   logical                   no-undo .
      368     define output parameter v-b-code         as   integer                   no-undo .
      369     do
      370     on error undo, return error return-value
      371     :
      372       define variable v-main-bcode     like ub.bar-code.b-code no-undo .
      373       define variable l-prod-bc-global as   logical             no-undo .
      374       define variable l-prod-bc-weight as   logical             no-undo .
      375       define variable l-prod-bc-pgweight as   logical             no-undo .
      376       define variable rec-cnt          as   integer             no-undo .
      377       define variable str-u-f          as   character           no-undo .
      378       define variable str-u-f-rng      as   character           no-undo .
      379       define variable ind              as   integer             no-undo .
      380       define variable v-msg              as   character           no-undo initial "":U.
      381       define variable v-ret-msg          as   character           no-undo initial "":U.
      382       define frame get-max-code-inf
      383         rec-cnt label "Просмотрено"
      384         with view-as dialog-box side-labels row 11 centered
      385         title "..........................................." three-d
      386       .
      387       define buffer buf_code-range   for ub.code-range .
      388       define buffer buf-c_code-range for ub.code-range .
      389       define buffer buf_bar-code     for ub.bar-code .
      390       define buffer buf_place        for ub.place .
      391       define buffer buf_goods        for ub.goods .
      392       define buffer buf_units        for ub.units .
      393       define buffer buf_prod-bc      for ub.prod-bc .
      394       define buffer buf_dis-card     for ub.dis-card .
      395       define buffer buf_dis-rule     for ub.dis-rule .
      396       define buffer buf_dis-time-rule     for ub.dis-time-rule .
      397       define buffer buf_firm         for ub.firm .
      398       define buffer buf_person       for ub.person .
      399       define buffer buf_contract     for ub.contract .
      400       if p-curr-type-cdrg = 'sslc':U
      401       or p-curr-type-cdrg = 'ssgb':U
      402       then do:
      403         assign
      404           v-b-code = ?
      405         .
      406         return.
      407       end.
      408       if p-curr-type-cdrg = 'sclc':U
      409       or p-curr-type-cdrg = 'pglc':U
      410         or p-curr-type-cdrg = 'sslc':U
      411       then do:
      412         assign
      413           p-db-num = 0
      414         .
      415       end.
      416       case p-action :
      417         when "get-m-code":U then do:
      418           assign
      419             v-b-code = p-first-code
      420           .
      421         end.
      422         when "f-u":U then do:
      423           assign
      424             v-b-code = 0
      425           .
      426         end.
      427       end case.
      428       case p-curr-type-cdrg :
      429         when 'dcgb':U then do:
      430   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   define variable v-ii2 as integer   no-undo .
      432   define variable v-table-name2 as character no-undo .
      433   define variable v-field-name2 as character no-undo .
      434   define variable buf_h2 as handle no-undo .
      435   define variable q_h2 as handle no-undo .
      436   define variable v-avail2 as integer   no-undo .
      437   define variable v-code-mess2 as character no-undo .
      438   define variable glog2 as logical   no-undo .
      439   define variable v-code_2 as integer   no-undo .
      440   case p-action :
      441     when "get-m-code":U then do:
      442       do v-ii2 = 1 to num-entries('ub.dis-card'):
      443         assign
      444         v-table-name2 = entry(v-ii2, 'ub.dis-card')
      445         v-field-name2 = entry(v-ii2, 'card-num')
      446         .
      447         create buffer buf_h2 for table v-table-name2.
      448         create query q_h2.
      449         q_h2:SET-BUFFERS(buf_h2).
      450         q_h2:QUERY-PREPARE(substitute(" for each &1 WHERE &1.&2 >= &3 and &1.&2 <= &4 by &1.&2 descending"
      451                           ,v-table-name2
      452                           ,v-field-name2
      453                           ,p-first-code
      454                           ,p-last-code)
      455                           ).
      456         q_h2:QUERY-OPEN.
      457         REPEAT while  q_h2:get-next().
      458           assign
      459             v-code_2 = buf_h2:buffer-field(v-field-name2):buffer-value
      460           .
      461           leave .
      462         END.
      463         q_h2:QUERY-CLOSE().
      464         delete object q_h2.
      465         delete object buf_h2.
      466         v-b-code = max(v-code_2, v-b-code).
      467       end.
      468     end.
      469     when "f-u":U then do:
      470       for each buf_code-range share-lock
      471           where ( buf_code-range.range-type = p-curr-type-cdrg
      472                   and buf_code-range.db-num = p-db-num
      473                   and buf_code-range.stts = "f":U
      474                 ) or
      475                 ( buf_code-range.range-type = p-curr-type-cdrg
      476                   and buf_code-range.db-num = p-db-num
      477                   and buf_code-range.stts = "u":U
      478                 )
      479       on error undo, return error
      480       :
      481         v-avail2 = 0.
      482         do v-ii2 = 1 to num-entries('ub.dis-card'):
      483           assign
      484           v-table-name2 = entry(v-ii2, 'ub.dis-card')
      485           v-field-name2 = entry(v-ii2, 'card-num')
      486           .
      487           create buffer buf_h2 for table v-table-name2.
      488           glog2 = buf_h2:find-first ( substitute(" where &1.&2 >= &3 and &1.&2 <= &4 "
      489                                   , v-table-name2
      490                                   , v-field-name2
      491                                   , buf_code-range.first-code
      492                                   , buf_code-range.last-code)
      493                                   ) no-error .
      494           if buf_h2:available then do:
      495             assign
      496             v-avail2 = v-avail2 + 1
      497             .
      498             if v-avail2 = 1 then do:
      499               v-code-mess2 = string(buf_h2:buffer-field(v-field-name2):buffer-value)
      500               .
      501             end.
      502           end.
      503           delete object buf_h2.
      504        end.
      505        if v-avail2 > 0
      506           and buf_code-range.stts = "f":U
      507         then do:
      508           assign
      509             buf_code-range.stts = "u":U
      510             v-b-code            = v-b-code + 1
      511             v-msg               = substitute( "Диапазон кодов с &2 по &3&1"
      512                                               + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
      513                                               , chr(10)
      514                                               , buf_code-range.first-code
      515                                               , buf_code-range.last-code
      516                                               , v-code-mess2
      517                                             )
      518           .
      519           if p-view-mess = true then do:
      520             message
      521               v-msg
      522               view-as alert-box information.
      523           end.
      524           else do:
      525             output stream getmc-stream to "getmc.log" append.
      526             put stream getmc-stream unformatted
      527               string( today, "99/99/9999" ) space(1)
      528               string( time, "HH:MM:SS" ) space(1)
      529               v-msg skip
      530             .
      531             output stream getmc-stream close.
      532           end.
      533         end.
      534         if v-avail2 = 0
      535           and buf_code-range.stts = "u":U
      536         then do:
      537           find first buf-c_code-range exclusive-lock
      538             where rowid( buf-c_code-range ) = rowid( buf_code-range )
      539           .
      540           assign
      541             buf-c_code-range.stts = "c":U
      542           .
      543           release buf-c_code-range .
      544           assign
