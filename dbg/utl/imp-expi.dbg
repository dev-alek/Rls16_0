     4087                                 run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) + " Уже есть ГРУППА ПРАВ (action-role):"                                             + STRING(temp-action-role.db-num)                                             + STRING(temp-action-role.action-head-code)                                             + STRING(temp-action-role.action-role-code)                                             ) )) .              delete temp-action-role.                   NEXT _action-role.
     4088               END.
     4089               create ub.action-role.
