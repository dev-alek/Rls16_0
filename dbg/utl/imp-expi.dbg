     5044                           .
     5045                           create buf_user-login-action-role .
     5046                           assign
     5047                              buf_user-login-action-role.db-num               = g#db-num
     5048                              buf_user-login-action-role.action-head-code     = 0
     5049                              buf_user-login-action-role.user-login-role-code = v-user-login-role-code
     5050                              buf_user-login-action-role.user-id              = buf_user-login.user-id
     5051                              buf_user-login-action-role.action-role-code     = v-object-action-role-code
     5052                              buf_user-login-action-role.action-role-context  = 'object':U
     5053                              buf_user-login-action-role.host-code            = buf_clients.host-code
     5054                              buf_user-login-action-role.obj-type             = buf_clients.obj-type
     5055                              buf_user-login-action-role.obj-code             = buf_clients.obj-code
     5056                              buf_user-login-action-role.gds-grp-code         = ?
