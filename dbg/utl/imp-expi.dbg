     3931               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕСЫ" + chr(10) +  " ошибка при сохранении записи ВЕСЫ(scales):" +                                       " номер " + string(temp-scales.scales-num) +                                       er-mes) )) .                NEXT _scalesv.
