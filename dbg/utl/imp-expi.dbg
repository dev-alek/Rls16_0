     5878   procedure create-scales-gds :
     5879   define parameter buffer bc for ub.bar-code.
     5880   define parameter buffer sc for ub.scales.
     5881   define parameter buffer goods for ub.goods.
     5882   define parameter buffer ltemp-scales-gds  for temp-scales-gds.
     5883   define variable ii as integer no-undo.
     5884   def buffer for-pbc for ub.prod-bc.
     5885   define variable sc-code like ub.bar-code.b-code no-undo .
     5886   define variable v-found as logical no-undo .
     5887   define variable v-on as logical no-undo .
     5888   define variable v-b-str like ub.prod-bc.b-str no-undo .
     5889   define variable f-sc-code as integer no-undo .
     5890   define buffer dubl_prod-bc for ub.prod-bc.
     5891   define buffer buf_units for ub.units.
     5892     do
     5893     on error undo, return error
     5894     :
     5895       if sc.tot-gds + 1 > sc.max-gds then do:
     5896         undo, return error ("Превышено максимальное количество товаров на весах" + chr(32) + string(sc.scales-num)).
     5897       end.
     5898       find first buf_units no-lock where buf_units.unit-name = goods.unit-base.
     5899   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5900   define variable v-rid18 as recid no-undo .
     5901   v-found = no.
     5902   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5903   define buffer locK-batchprocess19 for ub.batchprocess.
     5904   run gbl/lock-prc.p
     5905       (input 'lscc':U
     5906       ,input 0
     5907       ,input 0
     5908       ,input 0
     5909       ,input ""
     5910       ,input ""
     5911       ,input ""
     5912       ,input (
     5913               ",,,Вкл/выкл лок. вес. кодов"
     5914              )
     5915       ,input true
     5916       ,buffer lock-batchprocess19
     5917       ) no-error .
     5918     if error-status :error then do:
     5919       message
     5920         vss-workfile vss-revision vss-description skip
     5921         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     5922         view-as alert-box error .
     5923       undo, return error .
     5924     end.
     5925   if lookup('вес':U, buf_units.type) > 0 then do:
     5926     run trg/isvescod.p ( input bc.b-code
     5927                         ,input yes
     5928                         ,input no
     5929                         ,input yes
     5930                         ,input ""
     5931                         ,output v-found
     5932                         ,output v-on
     5933                         ,output v-b-str) no-error.
     5934   end.
     5935   else do:
     5936     run trg/ispgwcod.p (input bc.b-code
     5937                       ,input yes
     5938                       ,input no
     5939                       ,input yes
     5940                       ,input ""
     5941                       ,output v-found
     5942                       ,output v-on
     5943                       ,output v-b-str ) no-error.
     5944   end.
     5945   if error-status:error then do:
     5946     return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5947   end.
     5948   if v-found and v-on = no then do:
     5949     find first ub.prod-bc exclusive-lock where
     5950                ub.prod-bc.b-code = bc.b-code
     5951           AND  ub.prod-bc.b-str = v-b-str no-error no-wait.
     5952     if not avail prod-bc then do:
     5953       assign
     5954       v-found = no
     5955       .
     5956     end.
     5957     else do:
     5958       if prod-bc.bc-on = no then do:
     5959         run trg/bc-upd.p (
     5960                                  input parparentproc
     5961                   ,input bc.b-code
     5962                   ,input  ub.prod-bc.b-str
     5963                   ,input yes
     5964                   ,input yes
     5965                   ,input no
     5966                   ,input ?
     5967                   ,input ?
     5968                   ) no-error.
     5969         if error-status:error then do:
     5970           assign
     5971           v-found = no
     5972           .
     5973         end.
     5974       end.
     5975     end.
     5976   end.
     5977   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5979     (input  ltemp-scales-gds.obj-type
     5980     ,input  ltemp-scales-gds.obj-code
     5981     ,input  goods.artic
     5982     ,input  goods.prod-type
     5983     ,input  goods.prod-code
     5984     ,buffer ub.gds-obj
     5985     ) no-error .
     5986   release ub.gds-obj.
     5987   if lookup('вес':U, buf_units.type) = 0
     5988   or v-found = yes
     5989   then do:
     5990     define variable v-exist18 as logical no-undo .
     5991     run gdsoattr-exist in this-procedure (
     5992                                           input goods.gds-code
     5993                                          ,input ltemp-scales-gds.obj-type
     5994                                          ,input ltemp-scales-gds.obj-code
     5995                                          ,input 'scales-code':U
     5996                                          ,output v-exist18
     5997                                         ) .
     5998     if not v-exist18 then do:
     5999   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run sclcdattr in g#library
     6001     (input  goods.gds-code
     6002     ,input  ltemp-scales-gds.obj-type
     6003     ,input  ltemp-scales-gds.obj-code
     6004     ,input  v-b-str
     6005     ,input  no
     6006     ) no-error .
     6007   end.
     6008   if error-status:error then do:
     6009     return error '':U.
     6010   end.
     6011   end.
     6012   if not v-found
     6013   and lookup('вес':U, buf_units.type) > 0
     6014   then do:
     6015     v-rid18 = ?.
     6016     run trg/prod-bc1.p ( input parparentproc
     6017                         ,input yes
     6018                         ,input ?
     6019                         ,input ?
     6020                         ,input no
     6021                         ,input 'sclc':U
     6022                         ,input ""
     6023                         ,buffer goods
     6024                         ,input bc.b-code
     6025                         ,input-output v-b-str
     6026                         ,output v-rid18
     6027                         ) no-error.
     6028     if error-status:error
     6029     or v-rid18 = ? then do:
     6030       return error substitute("Ошибка при сохранении ДопБК для весов&2&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     6031     end.
     6032     find first prod-bc exclusive-lock where
     6033               recid(prod-bc) = v-rid18.
     6034   end.
     6035       _main:
     6036       DO ON ERROR undo, return error on stop undo, return error:
     6037         create ub.scales-gds.
     6038         assign
     6039         sc.tot-gds  = sc.tot-gds + 1
     6040         ub.scales-gds.db-num    = g#db-num
     6041         ub.scales-gds.obj-type  = ltemp-scales-gds.obj-type
     6042         ub.scales-gds.obj-code = ltemp-scales-gds.obj-code
     6043         ub.scales-gds.b-code = ltemp-scales-gds.b-code
     6044         ub.scales-gds.scales-num = ltemp-scales-gds.scales-num
     6045         ub.scales-gds.to-send = TRUE
     6046         sc.to-send = TRUE
     6047         ub.scales-gds.to-del = FALSE
     6048         ub.scales-gds.deadline = ltemp-scales-gds.deadline
     6049         ub.scales-gds.wt-cart = ltemp-scales-gds.wt-cart
     6050         ub.scales-gds.plu-code = ltemp-scales-gds.plu-code
     6051         .
     6052       END.
     6053     end.
     6054   end procedure.
     6055   procedure add-right :
     6056     define input parameter p-grp-acta-arm-code  as character no-undo .
     6057     define input parameter p-grp-acta-object    as character no-undo .
     6058     define input parameter p-grp-acta-act       as character no-undo .
     6059     define input parameter p-action-item-id     as character no-undo .
     6060     define input parameter p-action-context     as character no-undo .
     6061     define buffer buf_temp-action-item for temp-action-item .
     6062     do transaction
     6063     on error undo, return error return-value
     6064     :
     6065         create buf_temp-action-item .
     6066         assign
     6067           buf_temp-action-item.grp-acta-arm-code  = p-grp-acta-arm-code
     6068           buf_temp-action-item.grp-acta-object    = p-grp-acta-object
     6069           buf_temp-action-item.grp-acta-act       = p-grp-acta-act
     6070           buf_temp-action-item.action-item-id     = p-action-item-id
     6071           buf_temp-action-item.action-context     = p-action-context
     6072         .
     6073     end.
     6074   end procedure.
     6075   procedure p-right-i :
     6076   do
     6077   on error undo, return error
     6078   :
     6079     if "rus" = "rus":U
     6080     then do:
     6081       run fill-right-rus in this-procedure .
     6082     end.
     6083     else do:
     6084       run fill-right-eng in this-procedure .
     6085     end.
     6086   end.
     6087   end procedure.
