     5823                                                         if error-status:error then do:                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", (("Импорт ПОЛЬЗОВАТЕЛЕЙ, СТРОКА " + string(ii) + chr(10)) + error-status:get-message(error-status:num-messages)) )) .                       NEXT _usr.                   end.
