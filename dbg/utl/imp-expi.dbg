     1605           .
     1606           display
     1607             rec-cnt
     1608             with frame get-max-code-inf
     1609           .
     1610           for each buf_units no-lock
     1611               where lookup('вес':U, buf_units.type) > 0
     1612           on error undo, return error
     1613           :
     1614             for each buf_goods no-lock
     1615               where buf_goods.unit-base = buf_units.unit-name
     1616             on error undo, return error
     1617             :
     1618               assign
     1619                 rec-cnt = rec-cnt + 1
     1620               .
     1621               if ( rec-cnt modulo 10 ) = 0 then do:
     1622                 display
     1623                   rec-cnt
     1624                   with frame get-max-code-inf
     1625                 .
     1626               end.
     1627               run mc_gdsbcode in this-procedure (
     1628                                input  buf_goods.gds-code
     1629                               ,input  ?
     1630                               ,output v-main-bcode
     1631                             ) no-error .
     1632               if error-status :error then do:
     1633                 message
     1634                   vss-workfile vss-revision vss-description skip
     1635                   "Ошибка при поиске корневого бар-кода" skip
     1636                   "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     1637                   error-status :get-message(1) skip
     1638                   return-value skip
     1639                   view-as alert-box error .
     1640                 undo, return error .
     1641               end.
     1642               for each buf_prod-bc no-lock
     1643                   where buf_prod-bc.b-code = v-main-bcode
     1644               on error undo, return error
     1645               :
     1646                 if p-curr-type-cdrg = 'sclc':U
     1647                   and buf_prod-bc.bc-on = FALSE
     1648                 then do:
     1649                   next.
     1650                 end.
     1651                 run mc_prodbcat in this-procedure (
     1652                                  buffer buf_prod-bc
     1653                                 ,input  'global=request':u
     1654                                 ,output l-prod-bc-global
     1655                               ) no-error .
     1656                 if error-status :error then do:
     1657                   message
     1658                     vss-workfile vss-revision vss-description skip
     1659                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1660                     "Основной бар-код" buf_prod-bc.b-code skip
     1661                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1662                     "Действие global=request" skip
     1663                     error-status :get-message(1) skip
     1664                     return-value skip
     1665                     view-as alert-box error .
     1666                   undo, return error .
     1667                 end.
     1668                 run mc_prodbcat in this-procedure (
     1669                                  buffer buf_prod-bc
     1670                                 ,input  'weight=request':u
     1671                                 ,output l-prod-bc-weight
     1672                               ) no-error .
     1673                 if error-status :error then do:
     1674                   message
     1675                     vss-workfile vss-revision vss-description skip
     1676                     "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1677                     "Основной бар-код" buf_prod-bc.b-code skip
     1678                     "Дополнительный бар-код" buf_prod-bc.b-str skip
     1679                     "Действие weight=request" skip
     1680                     error-status :get-message(1) skip
     1681                     return-value skip
     1682                     view-as alert-box error .
     1683                   undo, return error .
     1684                 end.
     1685                 if l-prod-bc-weight
     1686                   and ( ( l-prod-bc-global
     1687                           and p-curr-type-cdrg = 'scgb':U
     1688                         )
     1689                         or
     1690                         ( not l-prod-bc-global
     1691                           and p-curr-type-cdrg = 'sclc':U
     1692                         )
     1693                       )
     1694                 then do:
     1695                   case p-action :
     1696                     when "get-m-code":U then do:
     1697                       if integer( buf_prod-bc.b-str ) >= p-first-code
     1698                         and integer( buf_prod-bc.b-str ) <= p-last-code
     1699                         and integer( buf_prod-bc.b-str ) > v-b-code
     1700                       then do:
     1701                         assign
     1702                           v-b-code = integer( buf_prod-bc.b-str )
     1703                         .
     1704                       end.
     1705                     end.
     1706                     when "f-u":U then do:
     1707                       for each buf_code-range
     1708                         where buf_code-range.db-num     = p-db-num
     1709                           and buf_code-range.range-type = p-curr-type-cdrg
     1710                           and buf_code-range.stts       = "f":U
     1711                           and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1712                           and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1713                       on error undo, return error
     1714                       :
     1715                         assign
     1716                           buf_code-range.stts = "u":U
     1717                         .
     1718                         if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1719                           assign
     1720                             str-u-f-rng = diff-list( str-u-f-rng
     1721                                                     ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1722                                                     ,",":U
     1723                                                     )
     1724                           .
     1725                         end.
     1726                         if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1727                           assign
     1728                             v-b-code = v-b-code + 1
     1729                             v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1730                                                     + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1731                                                     , chr(10)
     1732                                                     , buf_code-range.first-code
     1733                                                     , buf_code-range.last-code
     1734                                                     , buf_prod-bc.b-str
     1735                                                   )
     1736                             v-ret-msg = v-ret-msg + v-msg
     1737                           .
     1738                           if p-view-mess = true then do:
     1739                             message
     1740                               v-msg
     1741                               view-as alert-box information.
     1742                           end.
     1743                         end.
     1744                       end.
     1745                     end.
     1746                   end case.
     1747                 end.
     1748               end.
     1749             end.
     1750           end.
     1751           if p-action = "f-u":U then do:
     1752             do ind = 1 to num-entries( str-u-f-rng ):
     1753               assign
     1754                 v-b-code  = v-b-code + 1
     1755                 v-msg     = substitute( "Диапазон кодов &2&1"
     1756                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1757                                         , chr(10)
     1758                                         , entry( ind, str-u-f-rng )
     1759                                       )
     1760                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1761               .
     1762               if p-view-mess = true then do:
     1763                 message
     1764                   v-msg
     1765                   view-as alert-box information.
     1766               end.
     1767             end.
     1768           end.
     1769           hide frame get-max-code-inf no-pause .
     1770         end.
     1771         when 'pglc':U
     1772         then do:
     1773           case p-action :
     1774             when "get-m-code":U then do:
     1775               assign
     1776                 frame get-max-code-inf :title = "Поиск максимального значения кода"
     1777               .
     1778             end.
     1779             when "f-u":U then do:
     1780               assign
     1781                 frame get-max-code-inf :title = "Корректировка статуса code-range"
     1782               .
     1783               run mark-all-used-as-free in this-procedure (
     1784                                          input  p-db-num
     1785                                         ,input  p-curr-type-cdrg
     1786                                         ,output str-u-f
     1787                                         ,output str-u-f-rng
     1788                                       ).
     1789             end.
     1790           end case.
     1791           view frame get-max-code-inf.
     1792           assign
     1793             rec-cnt = 0
     1794           .
     1795           display
     1796             rec-cnt
     1797             with frame get-max-code-inf
     1798           .
     1799           for each buf_prod-bc no-lock where
     1800                   buf_prod-bc.b-str >= "00100"
     1801               and buf_prod-bc.b-str <= "99999"
     1802               and buf_prod-bc.bc-on-type = 'pglc':U
     1803               and length(buf_prod-bc.b-str) = 5
     1804           on error undo, return error
     1805           :
     1806               assign
     1807                 rec-cnt = rec-cnt + 1
     1808               .
     1809               if ( rec-cnt modulo 10 ) = 0 then do:
     1810                 display
     1811                   rec-cnt
     1812                   with frame get-max-code-inf
     1813                 .
     1814               end.
     1815               if p-curr-type-cdrg = 'pglc':U
     1816                 and buf_prod-bc.bc-on = FALSE
     1817               then do:
     1818                 next.
     1819               end.
     1820               run mc_prodbcat in this-procedure (
     1821                                 buffer buf_prod-bc
     1822                               ,input  'pgweight=request':u
     1823                               ,output l-prod-bc-pgweight
     1824                             ) no-error .
     1825               if error-status :error then do:
     1826                 message
     1827                   vss-workfile vss-revision vss-description skip
     1828                   "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
     1829                   "Основной бар-код" buf_prod-bc.b-code skip
     1830                   "Дополнительный бар-код" buf_prod-bc.b-str skip
     1831                   "Действие weight=request" skip
     1832                   error-status :get-message(1) skip
     1833                   return-value skip
     1834                   view-as alert-box error .
     1835                 undo, return error .
     1836               end.
     1837               if l-prod-bc-pgweight
     1838               and p-curr-type-cdrg = 'pglc':U
     1839               then do:
     1840                 case p-action :
     1841                   when "get-m-code":U then do:
     1842                     if integer( buf_prod-bc.b-str ) >= p-first-code
     1843                       and integer( buf_prod-bc.b-str ) <= p-last-code
     1844                       and integer( buf_prod-bc.b-str ) > v-b-code
     1845                     then do:
     1846                       assign
     1847                         v-b-code = integer( buf_prod-bc.b-str )
     1848                       .
     1849                     end.
     1850                   end.
     1851                   when "f-u":U then do:
     1852                     for each buf_code-range
     1853                       where buf_code-range.db-num     = p-db-num
     1854                         and buf_code-range.range-type = p-curr-type-cdrg
     1855                         and buf_code-range.stts       = "f":U
     1856                         and buf_code-range.first-code <= integer( buf_prod-bc.b-str )
     1857                         and buf_code-range.last-code  >= integer( buf_prod-bc.b-str )
     1858                     on error undo, return error
     1859                     :
     1860                     assign
     1861                     buf_code-range.stts = "u":U
     1862                       .
     1863                     if lookup( string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code ), str-u-f-rng ) <> 0 then do:
     1864                         assign
     1865                           str-u-f-rng = diff-list( str-u-f-rng
     1866                                                   ,string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1867                                                   ,",":U
     1868                                                   )
     1869                         .
     1870                     end.
     1871                     if lookup( buf_code-range.range-type + chr(3) + string( buf_code-range.first-code ), str-u-f ) = 0 then do:
     1872                         assign
     1873                           v-b-code = v-b-code + 1
     1874                           v-msg     = substitute( "Диапазон кодов с &2 по &3&1"
     1875                                                   + "Помечен как 'u' т.к. существующий код &4 попадает в данный диапазон.&1"
     1876                                                   , chr(10)
     1877                                                   , buf_code-range.first-code
     1878                                                   , buf_code-range.last-code
     1879                                                   , buf_prod-bc.b-str
     1880                                                 )
     1881                           v-ret-msg = v-ret-msg + v-msg
     1882                         .
     1883                       if p-view-mess = true then do:
     1884                         message
     1885                           v-msg
     1886                           view-as alert-box information.
     1887                       end.
     1888                     end.
     1889                   end.
     1890                 end.
     1891               end case.
     1892             end.
     1893           end.
     1894           if p-action = "f-u":U then do:
     1895             do ind = 1 to num-entries( str-u-f-rng ):
     1896               assign
     1897                 v-b-code = v-b-code + 1
     1898                 v-msg     = substitute( "Диапазон кодов &2&1"
     1899                                         + "Помечен как 'f' т.к. нет ни одного кода который попадает в данный диапазон.&1"
     1900                                         , chr(10)
     1901                                         , entry( ind, str-u-f-rng )
     1902                                       )
     1903                 v-ret-msg = v-ret-msg + chr(10) + v-msg
     1904               .
     1905               if p-view-mess = true then do:
     1906                 message
     1907                   v-msg
     1908                   view-as alert-box information.
     1909               end.
     1910             end.
     1911           end.
     1912           hide frame get-max-code-inf no-pause .
     1913         end.
     1914         otherwise do:
     1915           message
     1916             vss-workfile vss-revision vss-description skip
     1917             "get-max-code" skip
     1918             "Непредусмотрена обработка диапазона кодов " p-curr-type-cdrg
     1919             view-as alert-box error.
     1920           return error.
     1921         end.
     1922       end case.
     1923     end.
     1924     return v-ret-msg.
     1925   end procedure.
     1926   procedure mark-all-used-as-free :
     1927     define input  parameter p-db-num         like ub.db.db-num             no-undo .
     1928     define input  parameter p-curr-type-cdrg like ub.code-range.range-type no-undo .
     1929     define output parameter p-str-u-f        as   character                 no-undo .
     1930     define output parameter p-str-u-f-rng    as   character                 no-undo .
     1931     do
     1932     on error undo, return error
     1933     :
     1934       define buffer buf_code-range   for ub.code-range.
     1935       define buffer buf-c_code-range for ub.code-range .
     1936       assign
     1937         p-str-u-f     = "":U
     1938         p-str-u-f-rng = "":U
     1939       .
     1940       for each buf_code-range share-lock
     1941           where buf_code-range.db-num     = p-db-num
     1942             and buf_code-range.range-type = p-curr-type-cdrg
     1943             and buf_code-range.stts       = "u":U
     1944       on error undo, return error
     1945       :
     1946         find first buf-c_code-range exclusive-lock
     1947           where rowid( buf-c_code-range ) = rowid( buf_code-range )
     1948         .
     1949         assign
     1950           buf-c_code-range.stts = "c":U
     1951         .
     1952         release buf-c_code-range .
     1953         assign
     1954           buf_code-range.stts = "f":U
     1955           p-str-u-f     = p-str-u-f + ",":U + buf_code-range.range-type + chr(3) + string( buf_code-range.first-code )
     1956           p-str-u-f-rng = p-str-u-f-rng + ",":U + string( buf_code-range.first-code ) + "-":U + string( buf_code-range.last-code )
     1957         .
     1958       end.
     1959       assign
     1960         p-str-u-f     = substring( p-str-u-f, 2, length( p-str-u-f ) - 1 )
     1961         p-str-u-f-rng = substring( p-str-u-f-rng, 2, length( p-str-u-f-rng ) - 1 )
     1962       .
     1963     end.
     1964   end procedure.
     1965   procedure mc_prodbcat :
     1966     do
     1967     on error undo, return error
     1968     :
     1969       define parameter buffer buf_prod-bc  for ub.prod-bc .
     1970       define input  parameter p-action           as character no-undo .
     1971       define output parameter p-return-attribute as logical no-undo .
     1972       def var vss-description as character no-undo init "prodbcat-01: определение параметров дополнительного бар-кода".
     1973       define buffer buf_bar-code   for ub.bar-code   .
     1974       define buffer buf_units      for ub.units      .
     1975       define buffer buf_code-range for ub.code-range .
     1976       define variable p-code-int as integer no-undo .
     1977       define variable v-cdrg-type as character no-undo .
     1978       if not available buf_prod-bc then do:
     1979         message
     1980           vss-workfile vss-revision vss-description skip
     1981           "Ошибка задания входных параметров" skip
     1982           "Не задан дополнительный бар-код" skip
     1983           view-as alert-box error .
     1984         undo, return error .
     1985       end.
     1986       find first buf_bar-code no-lock
     1987         where buf_bar-code.b-code = buf_prod-bc.b-code
     1988         no-error .
     1989       if not available buf_bar-code then do:
     1990         message
     1991           vss-workfile vss-revision vss-description skip
     1992           "Неправильная ссылка на основной бар-код" skip
     1993           "Основной бар-код" buf_prod-bc.b-code skip
     1994           "Дополнительный бар-код" buf_prod-bc.b-str skip
     1995           view-as alert-box error .
     1996         undo, return error .
     1997       end.
     1998       find first buf_units no-lock
     1999         where buf_units.unit-name = buf_bar-code.unit-cli
     2000         no-error .
     2001       if not available buf_units then do:
     2002         message
     2003           vss-workfile vss-revision vss-description skip
     2004           "Не найдена единица измерения основного бар-кода" skip
     2005           "Основной бар-код" buf_bar-code.b-code skip
     2006           "Единица измерения" buf_bar-code.unit-cli skip
     2007           view-as alert-box error .
     2008         undo, return error .
     2009       end.
     2010       def var ind                    as integer   no-undo .
     2011       def var v-num-entries-p-action as integer   no-undo .
     2012       def var v-action               as character no-undo .
     2013       assign
     2014         v-num-entries-p-action = num-entries(p-action)
     2015       .
     2016       assign
     2017         p-return-attribute = true
     2018       .
     2019       _ind:
     2020       do ind = 1 to v-num-entries-p-action
     2021       :
     2022        if ind > 1 and p-return-attribute = false then return.
     2023         assign
     2024           v-action = entry(ind, p-action)
     2025         .
     2026         case v-action :
     2027           when "global=request":u
     2028           then do:
     2029             if not (buf_prod-bc.bc-on-type = ''
     2030             or buf_prod-bc.bc-on-type = 'scgb':U
     2031             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2032               assign
     2033                 p-return-attribute = false
     2034               .
     2035             end.
     2036           end.
     2037           when "weight=request":u
     2038           then do:
     2039             if not (buf_prod-bc.bc-on-type = 'sclc':U
     2040             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     2041               assign
     2042                 p-return-attribute = false.
     2043             end.
     2044           end.
     2045           when "pgweight=request":u
     2046           then do:
     2047             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     2048               assign
     2049                 p-return-attribute = false.
     2050             end.
     2051           end.
     2052           when "petrolium=request":u
     2053           then do:
     2054             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     2055               assign
     2056                 p-return-attribute = false.
     2057             end.
     2058           end.
     2059           when "scaleable=request":u
     2060           then do:
     2061             if not (buf_prod-bc.bc-on-type = 'sslc':U
     2062             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     2063               assign
     2064                 p-return-attribute = false.
     2065             end.
     2066           end.
     2067           otherwise do:
     2068             message
     2069               vss-workfile vss-revision vss-description skip
     2070               "Неизвестное значение параметра v-action " skip
     2071               "v-action" v-action skip
     2072               "p-action" p-action skip
     2073               view-as alert-box error .
     2074             undo, return error .
     2075           end.
     2076         end case.
     2077       end.
     2078     end.
     2079   end procedure.
     2080   procedure mc_gdsbcode :
     2081     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
     2082     define input  parameter p-node-code like ub.bar-code.node-code no-undo .
     2083     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     2084     def var vss-description as character no-undo init "gdsbcode-01: определение первичного бар-кода признака".
     2085     def var vss-proc-revision as character no-undo init "library.p gdsbcode-01" .
     2086     define buffer buf_bar-code for ub.bar-code .
     2087     def var v-unit-base like ub.goods.unit-base no-undo .
     2088     do
     2089     on error undo, return error
     2090     :
     2091       if p-node-code = ? then do:
     2092         run mc_gdsrootnode in this-procedure (
     2093            input  p-gds-code
     2094           ,output p-node-code
     2095           ) no-error .
     2096         if error-status :error then do:
     2097           message
     2098             vss-workfile vss-revision vss-description skip
     2099             "Ошибка при определении корневого признака товара" skip
     2100             "Код товара" p-gds-code skip
     2101             error-status :get-message(1) skip
     2102             return-value skip
     2103             view-as alert-box error .
     2104           undo, return error .
     2105         end.
     2106       end.
     2107       run mc_unitbase in this-procedure (
     2108          input  p-gds-code
     2109         ,output v-unit-base
     2110         ) no-error .
     2111       if error-status :error then do:
     2112         message
     2113           vss-workfile vss-revision vss-description skip
     2114           "Ошибка определения базовой единицы измерения товара" skip
     2115           "Код товара" p-gds-code skip
     2116           view-as alert-box error .
     2117         undo, return error .
     2118       end.
     2119       find first buf_bar-code no-lock
     2120         where buf_bar-code.gds-code  = p-gds-code
     2121           and buf_bar-code.node-code = p-node-code
     2122           and buf_bar-code.part-code = ""
     2123           and buf_bar-code.in-code   = ""
     2124           and buf_bar-code.unit-cli  = v-unit-base
     2125         no-error .
     2126       if not available buf_bar-code then do:
     2127         undo, return error vss-proc-revision + ":" + chr(10)
     2128           + "Не найден первичный бар-кода признака " + chr(10)
     2129           + "Код товара " + string(p-gds-code) + chr(10)
     2130           + "Код признака " + string(p-node-code) + chr(10)
     2131           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     2132           .
     2133       end.
     2134       assign
     2135         p-b-code = buf_bar-code.b-code
     2136       .
     2137     end.
     2138   end procedure.
     2139   procedure mc_gdsrootnode :
     2140     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2141     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2142     def var vss-description as character no-undo init "gdsrootnode-01: определение корневого признака товара по коду товара".
     2143     define buffer buf_goods   for ub.goods .
     2144     do
     2145     on error undo, return error
     2146     :
     2147       find first buf_goods no-lock
     2148         where buf_goods.gds-code  = p-gds-code
     2149         no-error .
     2150       if not available buf_goods then do:
     2151         message
     2152           vss-workfile vss-revision vss-description skip
     2153           "Не найден товар" skip
     2154           "Код товара" p-gds-code skip
     2155           view-as alert-box error .
     2156         undo, return error .
     2157       end.
     2158       run mc_prt-root-to-node-code in this-procedure (
     2159          input  buf_goods.prt-root
     2160         ,output p-root-node
     2161         ) no-error .
     2162       if error-status :error then do:
     2163         message
     2164           vss-workfile vss-revision vss-description skip
     2165           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     2166           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     2167           "Указатель на корень шкалы" buf_goods.prt-root skip
     2168           error-status :get-message(1) skip
     2169           return-value skip
     2170           view-as alert-box error .
     2171         undo, return error .
     2172       end.
     2173     end.
     2174   end procedure.
     2175   procedure mc_prt-root-to-node-code :
     2176     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     2177     define output parameter p-root-node like ub.goods.prt-root no-undo .
     2178     def var vss-description as character no-undo init "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     2179     define buffer buf_gds-prt for ub.gds-prt .
     2180     do
     2181     on error undo, return error
     2182     :
     2183       find buf_gds-prt no-lock
     2184         where buf_gds-prt.upper-code = p-prt-root
     2185         no-error .
     2186       if not available buf_gds-prt then do:
     2187         message
     2188           vss-workfile vss-revision vss-description skip
     2189           "Не найден корень шкалы" skip
     2190           "Указатель на корень шкалы" p-prt-root skip
     2191           view-as alert-box error .
     2192         undo, return error .
     2193       end.
     2194       assign
     2195         p-root-node = buf_gds-prt.node-code
     2196       .
     2197     end.
     2198   end procedure.
     2199   procedure mc_unitbase :
     2200     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     2201     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     2202     def var vss-description as character no-undo init "unitbase-01: определение базовой единицы измерения товара".
     2203     define buffer buf_goods for ub.goods .
     2204     do
     2205     on error undo, return error
     2206     :
     2207       find first buf_goods no-lock
     2208         where buf_goods.gds-code = p-gds-code
     2209         no-error .
     2210       if not available buf_goods then do:
     2211         message
     2212           vss-workfile vss-revision vss-description skip
     2213           "Не найден товар" skip
     2214           "Код товара" p-gds-code skip
     2215           view-as alert-box error .
     2216         undo, return error .
     2217       end.
     2218       assign
     2219         p-unit-base = buf_goods.unit-base
     2220       .
     2221     end.
     2222   end procedure.
     2223   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2224   procedure gen-b-code :
     2225     define input  parameter type-code like ub.code-range.range-type no-undo .
     2226     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     2227     do
     2228     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2229     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     2230     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     2231     :
     2232       define buffer buf_thbj-attr     for ub.thbj-attr .
     2233       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     2234       define buffer buf_code-range for ub.code-range .
     2235       define variable l-code         as   integer              no-undo .
     2236       define variable v-db-num       like ub.db.db-num         no-undo .
     2237       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2238       if type-code = 'sslc':U
     2239       or type-code = 'ssgb':U
     2240       then do:
     2241         message
     2242           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     2243           "Обратитесь к администратору системы."
     2244           view-as alert-box error .
     2245         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     2246       end.
     2247       run trg/getpcode.p ( input  type-code
     2248                      ,output cfg-param-code
     2249                     ).
     2250       run get-next-seq( input  type-code,
     2251                         output l-code
     2252                       ).
     2253       find first buf_sys-ctrl no-lock.
     2254       if type-code = 'sclc':U
     2255       or type-code = 'pglc':U
     2256       then do:
     2257         assign
     2258           v-db-num = 0
     2259         .
     2260       end.
     2261       else do:
     2262         assign
     2263           v-db-num = buf_sys-ctrl.db-num
     2264         .
     2265       end.
     2266       find first buf_code-range no-lock
     2267         where buf_code-range.db-num     = v-db-num
     2268           and buf_code-range.range-type = type-code
     2269           and buf_code-range.stts       = "a"
     2270         use-index stts
     2271         no-error .
     2272       if available buf_code-range
     2273          and l-code <= buf_code-range.last-code
     2274          and l-code >= buf_code-range.first-code then do:
     2275         assign
     2276           p-b-code = l-code
     2277         .
     2278       end.
     2279       else do:
     2280         if available buf_code-range
     2281            and l-code < buf_code-range.last-code then do:
     2282           message
     2283             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     2284             "Обратитесь к администратору системы."
     2285             view-as alert-box error .
     2286           undo, return error "sequence":U .
     2287         end.
     2288         do transaction
     2289         on error undo, return error
     2290         :
     2291           find first buf_thbj-attr exclusive-lock
     2292             where buf_thbj-attr.upper-prop-code = 'code-range':U
     2293               and buf_thbj-attr.prop-code = cfg-param-code
     2294               and buf_thbj-attr.obj-type   = 'БД':U
     2295               and buf_thbj-attr.obj-code   = v-db-num
     2296             no-error .
     2297           if not available buf_thbj-attr then do:
     2298             find first buf_thbj-attr exclusive-lock
     2299               where buf_thbj-attr.upper-prop-code = 'code-range':U
     2300                 and buf_thbj-attr.prop-code = cfg-param-code
     2301                 and buf_thbj-attr.obj-type   = ''
     2302                 and buf_thbj-attr.obj-code   = 0
     2303               no-error .
     2304             if not available buf_thbj-attr then do:
     2305               if not locked buf_thbj-attr then do:
     2306                 message
     2307                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     2308                   "Обратитесь к администратору системы."
     2309                   view-as alert-box error .
     2310               end.
     2311               undo, return error "config":U .
     2312             end.
     2313           end.
     2314           run get-next-seq( input type-code,
     2315                             output l-code
     2316                           ).
     2317           find first buf_code-range
     2318             where buf_code-range.db-num     = v-db-num
     2319               and buf_code-range.range-type = type-code
     2320               and buf_code-range.stts       = "a"
     2321             use-index stts
     2322             no-error .
     2323           if available buf_code-range
     2324           and l-code <= buf_code-range.last-code
     2325           and l-code >= buf_code-range.first-code
     2326           then do:
     2327             assign
     2328               p-b-code = l-code
     2329             .
     2330           end.
     2331           else do:
     2332             if available buf_code-range then do:
     2333               assign
     2334                 buf_code-range.stts = "u"
     2335               .
     2336             end.
     2337             find first buf_code-range
     2338               where buf_code-range.db-num     = v-db-num
     2339                 and buf_code-range.range-type = type-code
     2340                 and buf_code-range.stts       = "f"
     2341               use-index stts
     2342               no-error .
     2343             if not available buf_code-range then do:
     2344               message
     2345                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     2346                 "Обратитесь к администратору системы"
     2347                 view-as alert-box error .
     2348               undo, return error "code-range":U .
     2349             end.
     2350             assign
     2351               buf_code-range.stts           = "a"
     2352             .
     2353             if buf_code-range.first-code = 1 then do:
     2354               run set-seq-cr( input type-code,
     2355                               input buf_code-range.first-code
     2356                             ).
     2357               assign
     2358                 p-b-code = 1
     2359               .
     2360             end.
     2361             else do:
     2362               run set-seq-cr( input type-code,
     2363                               input ( buf_code-range.first-code - 1 )
     2364                             ).
     2365               run get-next-seq( input type-code,
     2366                                 output p-b-code
     2367                               ).
     2368             end.
     2369           end.
     2370         end.
     2371       end.
     2372     end.
     2373   end procedure.
     2374   procedure get-next-seq :
     2375     define input  parameter type-code like ub.code-range.range-type no-undo .
     2376     define output parameter next-seq  as   integer                  no-undo .
     2377     do
     2378     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2379     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     2380     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     2381     :
     2382       case type-code:
     2383         when 'bcgb':U then do:
     2384           assign
     2385             next-seq = next-value(s-bcgb-code, ub)
     2386           .
     2387         end.
     2388         when 'scgb':U then do:
     2389           assign
     2390             next-seq = next-value(s-scgb-code, ub)
     2391           .
     2392         end.
     2393         when 'sclc':U then do:
     2394           assign
     2395             next-seq = next-value(s-sclc-code, ub)
     2396           .
     2397         end.
     2398         when 'pglc':U then do:
     2399           assign
     2400             next-seq = next-value(s-pglc-code, ub)
     2401           .
     2402         end.
     2403         when 'dcgb':U then do:
     2404           assign
     2405             next-seq = next-value(s-dcgb-code, ub)
     2406           .
     2407         end.
     2408         when 'ctgb':U then do:
     2409           assign
     2410             next-seq = next-value(s-ctgb-code, ub)
     2411           .
     2412         end.
     2413         when 'drgb':U then do:
     2414           assign
     2415             next-seq = next-value(s-drgb-code, ub)
     2416           .
     2417         end.
     2418         when 'fmgb':U then do:
     2419           assign
     2420             next-seq = next-value(s-fmgb-code, ub)
     2421           .
     2422         end.
     2423         when 'pngb':U then do:
     2424           assign
     2425             next-seq = next-value(s-pngb-code, ub)
     2426           .
     2427         end.
     2428         when 'cagb':U then do:
     2429           assign
     2430             next-seq = next-value(s-cagb-code, ub)
     2431           .
     2432         end.
     2433         when 'fdgb':U then do:
     2434           assign
     2435             next-seq = next-value(s-fin-doc, ub)
     2436           .
     2437         end.
     2438       end case.
     2439     end.
     2440   end procedure.
     2441   procedure set-seq-cr :
     2442     define input parameter type-code like ub.code-range.range-type no-undo .
     2443     define input parameter set-val   like ub.code-range.first-code no-undo .
     2444     do
     2445     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2446     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     2447     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     2448     :
     2449       case type-code:
     2450         when 'bcgb':U then do:
     2451           assign
     2452             current-value(s-bcgb-code, ub) = set-val
     2453           .
     2454         end.
     2455         when 'scgb':U then do:
     2456           assign
     2457             current-value(s-scgb-code, ub) = set-val
     2458           .
     2459         end.
     2460         when 'sclc':U then do:
     2461           assign
     2462             current-value(s-sclc-code, ub) = set-val
     2463           .
     2464         end.
     2465         when 'pglc':U then do:
     2466           assign
     2467             current-value(s-pglc-code, ub) = set-val
     2468           .
     2469         end.
     2470         when 'dcgb':U then do:
     2471           assign
     2472             current-value(s-dcgb-code, ub) = set-val
     2473           .
     2474         end.
     2475         when 'ctgb':U then do:
     2476           assign
     2477             current-value(s-ctgb-code, ub) = set-val
     2478           .
     2479         end.
     2480         when 'drgb':U then do:
     2481           assign
     2482             current-value(s-drgb-code, ub) = set-val
     2483           .
     2484         end.
     2485         when 'fmgb':U then do:
     2486           assign
     2487             current-value(s-fmgb-code, ub) = set-val
     2488           .
     2489         end.
     2490         when 'pngb':U then do:
     2491           assign
     2492             current-value(s-pngb-code, ub) = set-val
     2493           .
     2494         end.
     2495         when 'cagb':U then do:
     2496           assign
     2497             current-value(s-cagb-code, ub) = set-val
     2498           .
     2499         end.
     2500         when 'fdgb':U then do:
     2501           assign
     2502             current-value(s-fin-doc, ub) = set-val
     2503           .
     2504         end.
     2505       end case.
     2506     end.
     2507   end procedure.
     2508   procedure new-bcod-gen-code-range :
     2509     do
     2510     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2511     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2512     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2513     :
     2514       define input parameter p-db-num  like ub.db.db-num             no-undo .
     2515       define input parameter type-code like ub.code-range.range-type no-undo .
     2516       define buffer buf_code-range      for ub.code-range .
     2517       define buffer last_code-range     for ub.code-range .
     2518       define buffer last-1_code-range   for ub.code-range .
     2519       define buffer last-2_code-range   for ub.code-range .
     2520       define buffer last-3_code-range   for ub.code-range .
     2521       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     2522       define variable conf-par       as character no-undo .
     2523       define variable par-type       as character no-undo .
     2524       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     2525       define variable v-cre-cdrg as logical   no-undo .
     2526       define variable v-cre-str  as character no-undo .
     2527       define variable v-cr1      as integer no-undo .
     2528       define variable v-cr2      as integer no-undo .
     2529       define variable v-cr3      as integer no-undo .
     2530       define variable v-cmax     as integer no-undo .
     2531       find first buf_sys-ctrl no-lock .
     2532       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     2533         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     2534                                       ,vss-workfile
     2535                                       ,vss-revision
     2536                                       ,vss-description
     2537                                       ,chr(10)
     2538                                       , p-db-num
     2539                                      ).
     2540       end.
     2541       run trg/getpcode.p ( input  type-code
     2542                      ,output cfg-param-code
     2543                     ).
     2544       for each buf_code-range
     2545         where buf_code-range.db-num     = -1
     2546           and buf_code-range.range-type = type-code
     2547           and buf_code-range.stts       = "f"
     2548       by buf_code-range.first-code
     2549       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2550       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     2551       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     2552       :
     2553         assign
     2554           buf_code-range.db-num = p-db-num
     2555         .
     2556         return .
     2557       end.
     2558       assign
     2559         v-cre-cdrg = TRUE
     2560       .
     2561       case type-code:
     2562         when 'sclc':U
     2563         or when 'scgb':U
     2564         or when 'pglc':U
     2565         then do:
     2566           find last last-1_code-range no-lock
     2567             where last-1_code-range.range-type = 'sclc':U
     2568             no-error .
     2569           if available last-1_code-range then do:
     2570             v-cr1 = last-1_code-range.last-code.
     2571           end.
     2572           find last last-2_code-range no-lock
     2573             where last-2_code-range.range-type = 'scgb':U
     2574             no-error .
     2575           if available last-2_code-range then do:
     2576             v-cr2 = last-2_code-range.last-code.
     2577             end.
     2578           find last last-3_code-range no-lock
     2579             where last-3_code-range.range-type = 'pglc':U
     2580             no-error .
     2581           if available last-3_code-range then do:
     2582             v-cr3 = last-3_code-range.last-code.
     2583           end.
     2584           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2585           .
     2586           if v-cmax = v-cr1  then do:
     2587               find last last_code-range no-lock
     2588                 where recid( last_code-range ) = recid( last-1_code-range )
     2589                 .
     2590             end.
     2591           if v-cmax = v-cr2  then do:
     2592               find last last_code-range no-lock
     2593                 where recid( last_code-range ) = recid( last-2_code-range )
     2594                 .
     2595             end.
     2596           if v-cmax = v-cr3  then do:
     2597             find last last_code-range no-lock
     2598               where recid( last_code-range ) = recid( last-3_code-range )
     2599               .
     2600           end.
     2601           if last_code-range.last-code + 1 > 99999 then do:
     2602             assign
     2603               v-cre-cdrg = FALSE
     2604             .
     2605           end.
     2606         end.
     2607         when 'bcgb':U
     2608         or when 'sslc':U
     2609         or when 'ssgb':U
     2610         then do:
     2611           find last last-1_code-range no-lock
     2612             where last-1_code-range.range-type = 'sslc':U
     2613             no-error .
     2614           if available last-1_code-range then do:
     2615             v-cr1 = last-1_code-range.last-code.
     2616           end.
     2617           find last last-2_code-range no-lock
     2618             where last-2_code-range.range-type = 'bcgb':U
     2619             no-error .
     2620           if available last-2_code-range then do:
     2621             v-cr2 = last-2_code-range.last-code.
     2622             end.
     2623           find last last-3_code-range no-lock
     2624             where last-3_code-range.range-type = 'ssgb':U
     2625             no-error .
     2626           if available last-3_code-range then do:
     2627             v-cr3 = last-3_code-range.last-code.
     2628           end.
     2629           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2630           .
     2631           if v-cmax = v-cr1  then do:
     2632               find last last_code-range no-lock
     2633                 where recid( last_code-range ) = recid( last-1_code-range )
     2634                 .
     2635             end.
     2636           if v-cmax = v-cr2  then do:
     2637               find last last_code-range no-lock
     2638                 where recid( last_code-range ) = recid( last-2_code-range )
     2639                 .
     2640             end.
     2641           if v-cmax = v-cr3  then do:
     2642             find last last_code-range no-lock
     2643               where recid( last_code-range ) = recid( last-3_code-range )
     2644               .
     2645           end.
     2646         end.
     2647         otherwise do:
     2648           find last last_code-range no-lock
     2649             where last_code-range.range-type = type-code
     2650             no-error .
     2651         end.
     2652       end case.
     2653       if not available last_code-range then do:
     2654         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     2655                                       ,vss-workfile
     2656                                       ,vss-revision
     2657                                       ,vss-description
     2658                                       , chr(10)
     2659                                       , type-code
     2660                                      ) .
     2661       end.
     2662       define variable v-mes10 as character no-undo .
     2663       define variable v-param-type10 as character no-undo .
     2664       define variable v-value-character10 as INTEGER no-undo .
     2665       define variable v-value-date10 as date no-undo .
     2666       define variable v-value-decimal10 as decimal no-undo .
     2667       define variable v-value-integer10 AS integer no-undo .
     2668       define variable v-value-logical10 AS LOGICAL no-undo .
     2669       define variable v-tth10 as handle no-undo .
     2670       run adm/shattri.p (
     2671           input "get":U
     2672           ,input  'БД':U
     2673           ,input  p-db-num
     2674           ,input  'code-range':U
     2675           ,input  cfg-param-code
     2676           ,output v-value-character10
     2677           ,output v-value-date10
     2678           ,output v-value-decimal10
     2679           ,output v-value-integer10
     2680           ,output v-value-logical10
     2681           ,output v-param-type10
     2682           ,INPUT-OUTPUT table-handle v-tth10
     2683           ) no-error .
     2684       if error-status :error then do:
     2685         delete object v-tth10.
     2686         v-mes10 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     2687                            , error-status:get-message(1)
     2688                            , chr(10)
     2689                            , return-value ).
     2690         undo, return error v-mes10.
     2691       end.
     2692       delete object v-tth10.
     2693       if v-cre-cdrg = TRUE then do:
     2694         create buf_code-range .
     2695         assign
     2696           buf_code-range.db-num     = p-db-num
     2697           buf_code-range.range-type = type-code
     2698           buf_code-range.stts       = "f"
     2699           buf_code-range.first-code = last_code-range.last-code + 1
     2700           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer10)
     2701           v-cre-str = "Свободный диапазон успешно создан"
     2702         .
     2703       end.
     2704       else do:
     2705         assign
     2706           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     2707                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     2708         .
     2709       end.
     2710     end.
     2711     return v-cre-str .
     2712   end procedure.
     2713   procedure gen-new-code-range-if-neces :
     2714     define input parameter v-db-num           like ub.db.db-num             no-undo .
     2715     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     2716     define input parameter v-cur-code         as   integer                  no-undo .
     2717     define input parameter v-g#news           as   logical                  no-undo .
     2718     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     2719     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     2720     do
     2721     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2722     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     2723     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     2724     :
     2725       define variable l-code-range-exist as logical   no-undo init false .
     2726       define variable v-db-for-send      as character no-undo .
     2727       define buffer buf_code-range  for ub.code-range .
     2728       define buffer buf1_code-range for ub.code-range .
     2729       define buffer buf_db          for ub.db .
     2730       find first buf_code-range
     2731         where buf_code-range.range-type = v-range-type
     2732           and buf_code-range.last-code >= v-cur-code
     2733         use-index last-codei
     2734         no-error .
     2735       if
     2736       (
     2737          available buf_code-range
     2738          and
     2739         (buf_code-range.db-num = v-db-num
     2740           and
     2741         buf_code-range.first-code <= v-cur-code
     2742         )
     2743       or
     2744         (
     2745           v-range-type = 'drgb':U
     2746           AND
     2747           v-cur-code = 0
     2748         )
     2749      )
     2750      then do:
     2751         assign
     2752           l-code-range-exist = true
     2753         .
     2754         if v-g#news
     2755         and buf_code-range.stts = "f" then do:
     2756           assign
     2757             buf_code-range.stts = "u"
     2758           .
     2759         end.
     2760       end.
     2761       if not l-code-range-exist
     2762          and v-g#news-source-db <> 0
     2763       then do:
     2764         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     2765                                       ,vss-workfile
     2766                                       ,vss-revision
     2767                                       ,vss-description
     2768                                       ,chr(10)
     2769                                       ,v-db-num
     2770                                       ,v-range-type
     2771                                       ,v-cur-code
     2772                                      ).
     2773       end.
     2774       if (not l-code-range-exist
     2775           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     2776          )
     2777       and ( not can-find (first buf1_code-range no-lock
     2778                           where buf1_code-range.db-num = v-db-num
     2779                             and buf1_code-range.range-type = v-range-type
     2780                             and buf1_code-range.stts = "f"
     2781                          )
     2782           )
     2783       then do:
     2784         if v-g#db-num = 0 then do:
     2785           run new-bcod-gen-code-range in this-procedure
     2786             (input v-db-num,
     2787              input v-range-type
     2788             ) no-error .
     2789           if error-status :error then do:
     2790             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     2791                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     2792                                           ,v-db-num
     2793                                           ,v-range-type
     2794                                           ,v-cur-code
     2795                                           ,chr(10)
     2796                                           ,error-status:get-message(1)
     2797                                           ,return-value
     2798                                          ).
     2799           end.
     2800         end.
     2801         else do:
     2802           if v-range-type = 'sclc':U
     2803           or v-range-type = 'pglc':U
     2804           then do:
     2805             assign
     2806               v-db-for-send = "":U
     2807             .
     2808             if v-g#db-num = 0 then do:
     2809               for each buf_db no-lock
     2810                 where buf_db.db-num > 0
     2811                   and buf_db.db-num <> v-g#news-source-db
     2812               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2813               :
     2814                 assign
     2815                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     2816                 .
     2817               end.
     2818               assign
     2819                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     2820               .
     2821             end.
     2822             else do:
     2823               if not v-g#news then do:
     2824                 assign
     2825                   v-db-for-send = "0":U
     2826                 .
     2827               end.
     2828             end.
     2829             run nws/cr-route.p ( input 'send-cmd':U
     2830                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     2831                                  "code-range":U + chr(1) +
     2832                                  (if v-range-type = 'sclc':U
     2833                                   then string( current-value(s-sclc-code, ub))
     2834                                   else string( current-value(s-pglc-code, ub))
     2835                                   ) + chr(1) +
     2836                                   v-range-type)
     2837                           ,input ?
     2838                           ,input v-db-for-send
     2839                           ) no-error .
     2840             if error-status :error then do:
     2841               undo, return error return-value.
     2842             end.
     2843           end.
     2844         end.
     2845       end.
     2846     end.
     2847   end procedure.
     2848   procedure cre-loc-sc-code-range :
     2849     define input parameter v-cur-code as integer no-undo .
     2850   define input parameter p-cdrg-type as character no-undo .
     2851     do
     2852     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2853     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     2854     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     2855     :
     2856       define buffer buf_code-range for ub.code-range .
     2857       find first buf_code-range
     2858            where buf_code-range.range-type = p-cdrg-type
     2859              and buf_code-range.first-code >= v-cur-code
     2860            no-error .
     2861       if not available buf_code-range then do:
     2862         run new-bcod-gen-code-range in this-procedure
     2863           ( input 0,
     2864             input p-cdrg-type
     2865           ) no-error .
     2866         if error-status :error then do:
     2867           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     2868                                          + "Код &2&1&3 &4"
     2869                                         , chr(10)
     2870                                         , v-cur-code
     2871                                         , error-status:get-message(1)
     2872                                         , return-value
     2873                                        ) .
     2874         end.
     2875       end.
     2876     end.
     2877   end procedure.
     2878   procedure mark-used-if-need :
     2879   define input parameter p-cur-code as integer no-undo .
     2880   define input parameter p-range-type like ub.code-range.range-type no-undo .
     2881   define input parameter p-db-num like ub.code-range.db-num no-undo .
     2882     do
     2883     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2884     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     2885     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     2886     :
     2887       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     2888       define buffer buf_code-range for ub.code-range .
     2889       assign
     2890       v-db-num = if p-range-type = 'sclc':U
     2891                  then 0
     2892                  else p-db-num
     2893       .
     2894   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2895   define buffer locK-batchprocess11 for ub.batchprocess.
     2896   run gbl/lock-prc.p
     2897       (input 'lscc':U
     2898       ,input 0
     2899       ,input 0
     2900       ,input 0
     2901       ,input ""
     2902       ,input ""
     2903       ,input ""
     2904       ,input (
     2905               ",,,Вкл/выкл лок. вес. кодов"
     2906              )
     2907       ,input true
     2908       ,buffer lock-batchprocess11
     2909       ) no-error .
     2910     if error-status :error then do:
     2911       message
     2912         vss-workfile vss-revision vss-description skip
     2913         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     2914         view-as alert-box error .
     2915       undo, return error .
     2916     end.
     2917       find first buf_code-range
     2918            where buf_code-range.range-type = p-range-type
     2919              and buf_code-range.first-code >= p-cur-code
     2920              and buf_code-range.last-code <= p-cur-code
     2921              and buf_code-range.db-num = v-db-num
     2922            no-error .
     2923       if not available buf_code-range then do:
     2924         message
     2925           vss-workfile vss-revision vss-description skip
     2926           "Ошибка при создании поиске диапазона" skip
     2927           "База данных" p-db-num skip
     2928           "Код" p-cur-code skip
     2929           "Тип" p-range-type
     2930           error-status :get-message(1) skip
     2931           return-value skip
     2932           view-as alert-box error .
     2933         undo, return error .
     2934       end.
     2935       if buf_code-range.stts = "f":U then do:
     2936         assign
     2937         buf_code-range.stts = "u":U
     2938         .
     2939       end.
     2940     end.
     2941   end procedure.
     2942   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2943   define new global shared variable g#attr-lib  as handle no-undo .
     2944   define variable v-attr-lib-variable as handle no-undo .
     2945   procedure gdsoattr-name :
     2946     define input  parameter p-code           as character no-undo .
     2947     define output parameter p-type           as character no-undo .
     2948     define output parameter p-format         as character no-undo .
     2949     define output parameter p-label          as character no-undo .
     2950     define output parameter p-user-can-edit  as logical   no-undo .
     2951     define output parameter p-output-display as logical   no-undo .
     2952     define output parameter p-other          as character no-undo .
     2953     do
     2954     on error undo, return error
     2955     :
     2956           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     2957         (input  p-code
     2958         ,output p-type
     2959         ,output p-format
     2960         ,output p-label
     2961         ,output p-user-can-edit
     2962         ,output p-output-display
     2963         ,output p-other
     2964         ) no-error .
     2965       if error-status :error
     2966       then do:
     2967         undo, return error return-value .
     2968       end.
     2969     end.
     2970   end.
