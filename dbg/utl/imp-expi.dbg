     5596                  end.
     5597                  END CASE.
     5598               END.
     5599               end.
     5600         END CASE.
     5601         input stream InStream close.
     5602        end.
     5603        else do:
     5604            return error.
     5605        end.
     5606     end.
     5607   end procedure.
     5608   procedure p-usr-i :
     5609   define variable v-curr-seek as integer no-undo .
     5610     do
     5611     on error undo, return error
     5612     :
     5613      run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Импорт группы данных ПОЛЬЗОВАТЕЛИ" + " Файл: " + p-dir-name + "\":U + p-db-key + ".":U + "usr":U) )) .
     5614      run check-iefile in this-procedure(input p-dir-name,                                      input "usr":U,                                      input "import":U,                                      output loc#log).
     5615      ii = 0.
     5616      if loc#log then do:
     5617         run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Импорт группы данных ПОЛЬЗОВАТЕЛИ" ) ).
     5618         input stream Instream from value(p-dir-name + "\":U + p-db-key + ".":U + "usr":U).
     5619         CASE p-version:
     5620            when "15.0" then do:
     5621                  _usr:
     5622                  REPEAT:
     5623                     import stream Instream unformatted ss.
     5624                     ii = ii + 1. run write-counter in p-log-handle (substitute("Считано &1 записей", ii)).
