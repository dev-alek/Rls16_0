     3401   define stream Instream.
     3402   DEFINE VARIABLE loc#log as logical no-undo .
     3403   DEFINE VARIABLE ss as character no-undo .
     3404   DEFINE VARIABLE current-table as character no-undo .
     3405   DEFINE VARIABLE loc-alert-box as logical no-undo .
     3406   DEFINE VARIABLE r-bar-code like ub.bar-code.b-code no-undo .
     3407   DEFINE VARIABLE v-is-global as logical no-undo .
     3408   DEFINE VARIABLE v-is-weight as logical no-undo .
     3409   DEFINE VARIABLE v-is-pgweight as logical no-undo .
     3410   DEFINE VARIABLE v-is-scaleable as logical no-undo .
     3411   DEFINE VARIABLE ii as integer no-undo .
     3412   DEFINE VARIABLE dopi as integer no-undo .
     3413   DEFINE VARIABLE scales-unit as character no-undo .
     3414   DEFINE VARIABLE scales-max-gds like ub.scales.max-gds no-undo.
     3415   DEFINE VARIABLE scales-tot-gds like ub.scales.tot-gds no-undo.
     3416   DEFINE VARIABLE  hnum as logical no-undo init no.
     3417   DEFINE VARIABLE  b-hnum as logical no-undo init no.
     3418   DEFINE VARIABLE  conf-par as char no-undo.
     3419   DEFINE VARIABLE  par-type as char no-undo.
     3420   DEFINE VARIABLE jj as integer no-undo .
     3421   DEFINE VARIABLE er-mes as character no-undo .
     3422   DEFINE VARIABLE v-b-code as integer no-undo .
     3423   define variable v-pbc-rid as recid no-undo .
     3424   define variable v-b-str as character no-undo .
     3425   define variable v-cdrg-type as character no-undo .
     3426   define buffer cli_units for ub.units.
     3427   define buffer buf_code-range for ub.code-range.
     3428   define buffer buf_config for ub.config.
     3429   define buffer ext_config for ub.config.
     3430   assign
     3431   p-rht = logical(entry(1, p-parameter, chr(4)))
     3432   p-gen = logical(entry(2, p-parameter, chr(4)))
     3433   p-flt = logical(entry(3, p-parameter, chr(4)))
     3434   p-pbc = logical(entry(4, p-parameter, chr(4)))
     3435   p-scl = logical(entry(5, p-parameter, chr(4)))
     3436   p-usr = logical(entry(6, p-parameter, chr(4)))
     3437   p-seq = logical(entry(7, p-parameter, chr(4)))
     3438   p-db-key = entry(8, p-parameter, chr(4))
     3439   p-dir-name  = entry(9, p-parameter, chr(4))
     3440   p-glb       = logical(entry(10, p-parameter, chr(4)))
     3441   p-version   = entry(11, p-parameter, chr(4))
     3442   no-error
     3443   .
     3444   if error-status:error then return error substitute("&1 &2", error-status:get-message(1) , return-value ).
     3445   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", " Импорт локальных таблиц" )) .
     3446   if p-gen then do:
     3447     run p-gen-i in this-procedure .
     3448   end.
     3449   if p-flt then do:
     3450     run p-flt-i in this-procedure .
     3451   end.
     3452   if p-scl then do:
     3453     run p-scl-i in this-procedure .
     3454   end.
     3455   if p-seq then do:
     3456     run p-seq-i in this-procedure .
     3457   end.
     3458   if p-pbc then do:
     3459     run p-pbc-i in this-procedure .
     3460   end.
     3461   if p-rht then do:
     3462     run p-rht-i in this-procedure .
     3463   end.
     3464   if p-usr then do:
     3465      if (not p-rht)
     3466      and (not (p-version = "15.0")) then do:
     3467         run p-rht-i in this-procedure .
     3468      end.
     3469      run p-usr-i in this-procedure .
     3470   end.
     3471   ii = 0.
     3472   if p-gen then do:
     3473           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ИНФОРМАЦИЯ О БД" ) ).
     3474         _configv:
     3475     FOR EACH temp-config:
     3476       find first ub.config no-lock where
     3477                 ub.config.param-code = temp-config.param-code
     3478             AND ub.config.host-code = 0
     3479             AND ub.config.obj-type = '':U
     3480             AND ub.config.obj-code = 0
     3481       NO-ERROR.
     3482       if not available ub.config then do:
     3483                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " НАСТРОЕЧНЫЙ ПАРАМЕТР(config)" +                                         " " + temp-config.param-code +                                         " Фирма " + string(temp-config.host-code) +                                         " тип объекта " + temp-config.obj-type +                                         " код объекта " + string(temp-config.obj-code) +                                         " не является валидным в данной конфигурации" ) )) .              delete temp-config.                   NEXT _configv.
     3484       end.
     3485       if lookup(ub.config.conf-type, 'к,п':U) > 0
     3486       then do:
     3487                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " НАСТРОЕЧНЫЙ ПАРАМЕТР(config)" +                                         " " + temp-config.param-code +                                         " является кодированным - импорт запрещен" ) )) .              delete temp-config.                   NEXT _configv.
     3488       end.
     3489       FIND FIRST ext_config No-LOCK WHERE
     3490                 ext_config.param-code = temp-config.param-code AND
     3491                 ext_config.host-code = temp-config.host-code AND
     3492                 ext_config.obj-type = temp-config.obj-type AND
     3493                 ext_config.obj-code = temp-config.obj-code
     3494       NO-ERROR.
     3495       IF AVAILABLE ext_config then do:
     3496                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " Уже есть запись НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                         " параметр " + temp-config.param-code +                                         " Фирма " + string(temp-config.host-code) +                                         " тип объекта " + temp-config.obj-type +                                         " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     3497       end.
     3498       if temp-config.host-code > 0 then do:
     3499         FIND FIRST ub.sysconf No-LOCK WHERE
     3500                   ub.sysconf.host-code = temp-config.host-code No-ERROR.
     3501         IF NOT AVAIL ub.sysconf then do:
     3502                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " Отсутствует фирма для НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     3503         END.
     3504       end.
     3505       if temp-config.obj-type <> "" or temp-config.obj-code > 0 then do:
     3506         FIND FIRST ub.clients No-LOCK WHERE
     3507                   ub.clients.obj-type = temp-config.obj-type AND
     3508                   ub.clients.obj-code = temp-config.obj-code NO-ERROR.
     3509         IF NOT AVAIL ub.clients then do:
     3510                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " Отсутствует объект для НАСТРОЕЧНОГО ПАРАМЕТРА(config)" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     3511         END.
     3512         IF ub.clients.db-num <> ub.db.db-num then do:
     3513                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) + " Объект для НАСТРОЕЧНОГО ПАРАМЕТРА(config) принадлежит другой БД" +                                           " параметр " + temp-config.param-code +                                           " Фирма " + string(temp-config.host-code) +                                           " тип объекта " + temp-config.obj-type +                                           " код объекта " + string(temp-config.obj-code) ) )) .              delete temp-config.                   NEXT _configv.
     3514         END.
     3515       end.
     3516       create buf_config.
     3517       buffer-copy ub.config to buf_config
     3518       assign
     3519       buf_config.host-code = temp-config.host-code
     3520       buf_config.obj-type = temp-config.obj-type
     3521       buf_config.obj-code = temp-config.obj-code
     3522       buf_config.param-value = temp-config.param-value
     3523       .
     3524       release buf_config no-error.
     3525       if error-status:error then do:
     3526         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     3527               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ИНФОРМАЦИЯ О БД" + chr(10) +  " ошибка при сохранении НАСТРОЕЧНОГО ПАРАМЕТРA(config):" +                                       " параметр " + temp-config.param-code +                                       " Фирма " + string(temp-config.host-code) +                                       " тип объекта " + temp-config.obj-type +                                       " код объекта " + string(temp-config.obj-code) +                                       er-mes) )) .                NEXT _configv.
     3528       end.
     3529     END.
     3530   end.
     3531   if p-flt then do:
     3532           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ФИЛЬТРЫ" ) ).
     3533         _filterv:
     3534     FOR EACH temp-filter NO-LOCK:
     3535       FIND FIRST ubflt.filter No-LOCK WHERE
     3536                 ubflt.filter.call-point = temp-filter.call-point AND
     3537                 ubflt.filter.NAIM = temp-filter.NAIM NO-ERROR.
     3538       IF AVAILABLE ubflt.filter then do:
     3539               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ФИЛЬТРЫ" + chr(10) + " Уже есть ФИЛЬТР(filter):" +                       " название " + string(temp-filter.Naim) +                       " точка вызова " + temp-filter.call-point) )) .              delete temp-filter.                   NEXT _filterv.
     3540       end.
     3541       create ubflt.filter.
     3542       buffer-copy temp-filter to ubflt.filter.
     3543       release ubflt.filter no-error.
     3544       if error-status:error then do:
     3545         er-mes = "".       do jj = 1 to error-status:num-messages:         er-mes = er-mes + chr(10) + error-status:get-message(JJ).       end.
     3546               run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ФИЛЬТРЫ" + chr(10) + " ошибка при сохранении записи ФИЛЬТР(filter):" +                       " название " + string(temp-filter.Naim) +                       " точка вызова " + temp-filter.call-point +                       er-mes) )) .                NEXT _filterv.
     3547       end.
     3548     run adm/restseqr.p
     3549       ( input "rest-no-msg":U
     3550        ,input "next-num-filter":U
     3551        ,input no
     3552       ) no-error .
     3553     if error-status :error then do:
     3554       return error return-value .
     3555     end.
     3556     END.
     3557   end.
     3558   if p-pbc then do:
     3559           run write-log-and-file in p-log-handle (                          input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "!!!&1",  "Проверка группы данных ВЕС и ВЗВЕШ КОДЫ" ) ).
     3560         _prod-bcv:
     3561     FOR EACH temp-prod-bc:
     3562       assign
     3563       v-is-global = no
     3564       v-is-weight = no
     3565       v-is-pgweight = no
     3566       v-is-scaleable = no
     3567       .
     3568       FIND FIRST ub.prod-bc No-LOCK WHERE
     3569                  ub.prod-bc.b-str = temp-prod-bc.b-str
     3570             AND  ub.prod-bc.b-code = temp-prod-bc.b-code NO-ERROR.
     3571       IF AVAILABLE ub.prod-bc then do:
     3572                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Уже есть ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3573       end.
     3574       find first ub.prod-bc no-lock where
     3575                 ub.prod-bc.b-str = temp-prod-bc.b-str
     3576             AND ub.prod-bc.bc-on = yes no-error.
     3577       IF AVAILABLE ub.prod-bc then do:
     3578                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Уже есть такой включенный ДопБК(prod-bc) на другом товаре:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код имеющегося включенного ДопБК" + string(ub.prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3579       end.
     3580       find first ub.bar-code no-lock where
     3581                  ub.bar-code.b-code = temp-prod-bc.b-code no-error.
     3582       if not avail ub.bar-code then do:
     3583                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Не найден бар-код для ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3584       end.
     3585       FIND FIRST ub.goods no-lock where
     3586                 ub.goods.gds-code = ub.bar-code.gds-code  NO-ERROR.
     3587       if not avail ub.bar-code then do:
     3588                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Не найден товар по бар-коду для ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3589       end.
     3590       find first ub.units no-lock where
     3591                  ub.units.unit-name = ub.goods.unit-base no-error .
     3592       if not avail ub.units then do:
     3593                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Не найдена основная ед. изм товара для ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code) +                         " Товар " + ub.goods.artic + chr(32) + ub.goods.prod-type + string(ub.goods.prod-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3594       end.
     3595       if LOOKUP('вес':U, ub.units.type) = 0
     3596       and not (LOOKUP('шту':U, ub.units.type) > 0
     3597            and can-find(first ub.code-range no-lock where
     3598                               ub.code-range.db-num = 0
     3599                           and ub.code-range.range-type = 'pglc':U
     3600                           and ub.code-range.first-code <= integer(temp-prod-bc.b-str)
     3601                           and ub.code-range.last-code >= integer(temp-prod-bc.b-str)))
     3602       then do:
     3603                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Товар по ДопБК(prod-bc) НЕ ((весовой или штучный) и ДопБК - код для весов):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code) +                         " Товар " + ub.goods.artic + chr(32) + ub.goods.prod-type + string(ub.goods.prod-code) +                         " Основн. ед. изм" + ub.goods.unit-base) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3604       end.
     3605       if ub.bar-code.unit-cli = ub.goods.unit-base then do:
     3606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3607     (input  ub.goods.gds-code
     3608     ,input  ?
     3609     ,output r-bar-code
     3610     ) no-error .
     3611         if error-status:error then do:
     3612                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Ошибка при поиске основного бар-кода товара для ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3613         end.
     3614         if r-bar-code <> ub.bar-code.b-code then do:
     3615                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Бар-код для ДопБК(prod-bc) не является основным бар-кодом товара:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3616         end.
     3617   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     3619     (input temp-prod-bc.b-str
     3620     ,input  ub.bar-code.unit-cli
     3621     ,input  ub.goods.unit-base
     3622     ,input  'global=request':U
     3623     ,output v-is-global
     3624     ) no-error .
     3625         if error-status:error then do:
     3626                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Ошибка при проверке на локальность ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3627         end.
     3628         if v-is-global
     3629         and not p-glb
     3630         then do:
     3631                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " ДопБК(prod-bc) не локальный:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3632         end.
     3633   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     3635     (input temp-prod-bc.b-str
     3636     ,input  ub.bar-code.unit-cli
     3637     ,input  ub.goods.unit-base
     3638     ,input  'weight=request':U
     3639     ,output v-is-weight
     3640     ) no-error .
     3641         if error-status:error then do:
     3642                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Ошибка при проверке весовой ли ДопБК(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3643         end.
     3644   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     3646     (input temp-prod-bc.b-str
     3647     ,input  ub.bar-code.unit-cli
     3648     ,input  ub.goods.unit-base
     3649     ,input  'pgweight=request':U
     3650     ,output v-is-pgweight
     3651     ) no-error .
     3652         if error-status:error then do:
     3653                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Ошибка при проверке штучный ли ДопБК для весов(prod-bc):" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3654         end.
     3655         if not v-is-weight
     3656         and not v-is-pgweight
     3657         then do:
     3658                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " ДопБК(prod-bc) не код для весов:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code)) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3659         end.
     3660         if v-is-weight then do:
     3661         v-cdrg-type = 'sclc':U.
     3662       end.
     3663       else do:
     3664           v-cdrg-type = 'pglc':U.
     3665         end.
     3666       end.
     3667       else do:
     3668         find first cli_units no-lock where
     3669                   cli_units.unit-name = ub.bar-code.unit-cli no-error .
     3670         if not avail cli_units then do:
     3671                       run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Не найдена ед. изм бар-кода для ДопБК(prod-bc):" +                           " ДопБК " + string(temp-prod-bc.b-str) +                           " Бар-код " + string(temp-prod-bc.b-code) +                           " Ед.изм.бар-кода "  + ub.bar-code.unit-cli) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3672         end.
     3673         if LOOKUP('дро':U, cli_units.type) = 0 then do:
     3674                   run write-log-and-file in p-log-handle (                              input 1                                                              , input log-file-name                                                  , input 1                                                              , input substitute( "&1 .......", ("Проверка группы данных ВЕС И ВЗВЕШ КОДЫ" + chr(10) + " Единица измерения бар-кода по ДопБК(prod-bc) не весовая и не дробная:" +                         " ДопБК " + string(temp-prod-bc.b-str) +                         " Бар-код " + string(temp-prod-bc.b-code) +                         " Ед. изм" + ub.bar-code.unit-cli) )) .              delete temp-prod-bc.                   NEXT _prod-bcv.
     3675         end.
