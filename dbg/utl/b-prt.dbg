        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр партий по строке документа".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE QUERY external_tables FOR doc-line.
      108   RUN set-attribute-list (
      109       'Keys-Accepted = ,
      110        Keys-Supplied = ':U).
      111   RUN set-attribute-list (
      112       'SortBy-Options = ""':U).
      113   DEFINE QUERY br_table FOR
      114         parts SCROLLING.
      115   DEFINE BROWSE br_table
      116     QUERY br_table NO-LOCK DISPLAY
      117         parts.part-code FORMAT "X(20)":U
      118         parts.pay-code FORMAT "99999":U
      119         parts.cli-qnty FORMAT "->>,>>>,>>9.999":U
      120         parts.cli-base-rate FORMAT ">>,>>9.<<<<":U
      121         parts.qnty FORMAT "->>,>>>,>>9.999":U
      122         parts.fact-qnty FORMAT "->>,>>>,>>9.999":U
      123         parts.price-cli FORMAT "->>,>>>,>>>,>>9.999":U
      124         parts.price-base FORMAT "->>,>>9.99":U
      125         parts.price-rubl FORMAT "->>,>>>,>>9.99":U
      126         parts.VAT-type FORMAT "X(8)":U
      127         parts.VAT-pc FORMAT ">9.9<%":U
      128         parts.SLT-type FORMAT "X(8)":U
      129         parts.SLT-pc FORMAT ">9.9<%":U
      130         parts.other-base FORMAT "->,>>>,>>9.99":U
      131         parts.other-rubl FORMAT "->,>>>,>>9.99":U
      132         parts.road-tax-base FORMAT "->,>>>,>>9.99":U
      133         parts.road-tax-rubl FORMAT "->,>>>,>>9.99":U
      134         parts.transport-base FORMAT "->,>>>,>>9.99":U
      135         parts.transport-rubl FORMAT "->,>>>,>>9.99":U
      136         parts.artic FORMAT "X(16)":U
      137         parts.cst-code FORMAT "X(31)":U
      138         parts.doc-type FORMAT "X(8)":U
      139         parts.exch-code FORMAT ">>9":U
      140         parts.fact-date FORMAT "99/99/99":U
      141         parts.fact-num FORMAT "->,>>>,>>9":U
      142         parts.host-code FORMAT "99999":U
      143         parts.in-code FORMAT "X(14)":U
      144         parts.is-supp FORMAT "yes/no":U
      145         parts.last-date FORMAT "99/99/9999":U
      146         parts.obj-code FORMAT "99999":U
      147         parts.obj-type FORMAT "X(3)":U
      148         parts.out-code FORMAT "X(14)":U
      149         parts.pl-code FORMAT "999999999":U
      150         parts.prod-code FORMAT ">>>>>>>>9":U
      151         parts.prod-type FORMAT "X(8)":U
      152         parts.PS FORMAT "X(50)":U
      153         parts.real-qnty FORMAT "->>,>>>,>>9.999":U
      154         parts.rsrv-free FORMAT "yes/no":U
      155         parts.status_ FORMAT "yes/no":U
      156         parts.supp-code FORMAT ">>>>>>>>9":U
      157         parts.supp-type FORMAT "X(3)":U
      158       WITH NO-ASSIGN SEPARATORS SIZE 97.63 BY 6.71.
      159   DEFINE FRAME F-Main
      160        br_table AT ROW 1 COL 1
      161       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      162            SIDE-LABELS NO-UNDERLINE THREE-D
      163            AT COL 1 ROW 1 SCROLLABLE
      164            BGCOLOR 8 FGCOLOR 0 .
      165   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      166   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      167   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      168   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      169   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      170   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      171   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      172   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      173   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      174   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      175   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      176         adm-object-hdl = FRAME F-Main:HANDLE.
      177   RUN ensure-broker.
      178   THIS-PROCEDURE:ADM-DATA =
      179        'ADM1.1~`':U +
      180        'SmartObject~`':U +
      181        '~`':U +
      182        'YES~`':U +
      183        'doc-line~`':U +
      184        'parts~`':U +
      185        '~`':U +
      186        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      187           + "~`":U +
      188        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      189        'Record-Source,Record-Target,TableIO-Target~`':U +
      190        '~`':U +
      191        '~`~`~`~`~`~`~`~`~`~`~`':U +
      192        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      193            THEN "^^":U
      194        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      195             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      196   PROCEDURE adm-apply-entry :
      197     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      198   END PROCEDURE.
      199   PROCEDURE adm-destroy :
      200    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      201   END PROCEDURE.
      202   PROCEDURE adm-disable :
      203       DISABLE br_table WITH FRAME F-Main.
      204       RUN dispatch ('disable-fields':U).
      205       RUN set-attribute-list ('ENABLED=no':U).
      206       RETURN.
      207   END PROCEDURE.
      208   PROCEDURE adm-edit-attribute-list :
      209         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      210         RETURN.
      211   END PROCEDURE.
      212   PROCEDURE adm-enable :
      213       ENABLE UNLESS-HIDDEN br_table WITH FRAME F-Main.
      214       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      215       RUN set-attribute-list ('ENABLED=yes':U).
      216       RETURN.
      217   END PROCEDURE.
      218   PROCEDURE adm-exit :
      219        RUN notify ('exit':U).
      220     RETURN.
      221   END PROCEDURE.
      222   PROCEDURE adm-hide :
      223     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      224   END PROCEDURE.
      225   PROCEDURE adm-initialize :
      226     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      227   END PROCEDURE.
      228   PROCEDURE adm-show-errors :
      229       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      230       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      231           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      232       END.
      233       RETURN.
      234   END PROCEDURE.
      235   PROCEDURE adm-UIB-mode :
      236     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      237   END PROCEDURE.
      238   PROCEDURE adm-view :
      239     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      240   END PROCEDURE.
      241   PROCEDURE dispatch :
      242       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      243       RUN broker-dispatch IN adm-broker-hdl
      244           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      245       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      246   END PROCEDURE.
      247   PROCEDURE ensure-broker :
      248   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      249   IF RETURN-VALUE NE "ADM-Broker":U THEN
      250   DO:
      251       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      252       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      253   END.
      254   END PROCEDURE.
      255   PROCEDURE get-attribute :
      256     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      257     RUN broker-get-attribute IN adm-broker-hdl
      258         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      259     RETURN RETURN-VALUE.
      260   END PROCEDURE.
      261   PROCEDURE get-attribute-list :
      262     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      263     RUN broker-get-attribute-list IN adm-broker-hdl
      264         (INPUT THIS-PROCEDURE,
      265          INPUT ?,
      266          OUTPUT p-attr-list) NO-ERROR.
      267     RETURN.
      268   END PROCEDURE.
      269   PROCEDURE new-state :
      270     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      271     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      272     RETURN.
      273   END PROCEDURE.
      274   PROCEDURE notify :
      275     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      276     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      277     IF RETURN-VALUE = "ADM-ERROR":U THEN
      278         RETURN "ADM-ERROR":U.
      279     RETURN.
      280   END PROCEDURE.
      281   PROCEDURE set-attribute-list :
      282     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      283     RUN ensure-broker.
      284     RUN broker-set-attribute-list IN adm-broker-hdl
      285         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      286     RETURN.
      287   END PROCEDURE.
      288   PROCEDURE set-position :
      289       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      290       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      291       IF VALID-HANDLE(adm-object-hdl) THEN
      292       DO:
      293         ASSIGN adm-object-hdl:ROW    =   p-row
      294                adm-object-hdl:COLUMN =   p-col.
      295       END.
      296       RETURN.
      297   END PROCEDURE.
      298     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      299     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      300     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      301     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      302     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      303     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      304     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      305     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      306     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      307     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      308     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      309     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      310     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      311     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      312     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      313     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      314     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      315     IF "":U = "":U THEN
      316       RUN modify-list-attribute IN adm-broker-hdl
      317         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      318     RUN use-create-on-add(?).
      319   PROCEDURE adm-add-record :
      320       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      321          "must have at least one Enabled Table to perform Add.":U
      322          VIEW-AS ALERT-BOX ERROR.
      323       RETURN.
      324   END PROCEDURE.
      325   PROCEDURE adm-assign-record :
      326    MESSAGE
      327          "Object ":U THIS-PROCEDURE:FILE-NAME
      328            "must have at least one Enabled Table to perform Assign.":U
      329              VIEW-AS ALERT-BOX ERROR.
      330      RETURN.
      331     END PROCEDURE.
      332   PROCEDURE adm-assign-statement :
      333     RETURN.
      334   END PROCEDURE.
      335   PROCEDURE adm-cancel-record :
      336      RETURN.
      337     END PROCEDURE.
      338   PROCEDURE adm-copy-record :
      339       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      340        "must have at least one Enabled Table to perform Copy.":U
      341          VIEW-AS ALERT-BOX ERROR.
      342       RETURN.
      343   END PROCEDURE.
      344   PROCEDURE adm-create-record :
      345      RETURN.
      346   END PROCEDURE.
      347   PROCEDURE adm-current-changed :
      348     RETURN.
      349   END PROCEDURE.
      350   PROCEDURE adm-delete-record :
      351    MESSAGE
      352          "Object ":U THIS-PROCEDURE:FILE-NAME
      353            "must have at least one Enabled Table to perform Delete.":U
      354              VIEW-AS ALERT-BOX ERROR.
      355       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      356       RETURN.
      357   END PROCEDURE.
      358   PROCEDURE adm-disable-fields :
      359         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      360       RETURN.
      361   END PROCEDURE.
      362   PROCEDURE adm-enable-fields :
      363       RETURN.
      364   END PROCEDURE.
      365   PROCEDURE adm-end-update :
      366     RETURN.
      367   END PROCEDURE.
      368   PROCEDURE adm-reset-record :
      369       RETURN.
      370   END PROCEDURE.
      371   PROCEDURE adm-update-record :
      372       MESSAGE
      373         "Object ":U THIS-PROCEDURE:FILE-NAME
      374           "must have at least one Enabled Table to perform Update.":U
      375             VIEW-AS ALERT-BOX ERROR.
      376      RETURN.
      377   END PROCEDURE.
      378   PROCEDURE check-modified :
      379   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      380   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      381   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      382   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      383     IF check-state = "check":U THEN
      384     DO:
      385       RUN get-link-handle IN adm-broker-hdl
      386         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      387            OUTPUT group-target-list).
      388       IF group-target-list NE "":U THEN
      389       DO i = 1 TO NUM-ENTRIES(group-target-list):
      390         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      391         RUN check-modified IN curr-widget ('group-check':U).
      392         IF RETURN-VALUE NE "":U THEN
      393         DO:
      394           RUN check-modified-message(RETURN-VALUE).
      395           RETURN "":U.
      396         END.
      397       END.
      398     END.
      399     RETURN "":U.
      400   END PROCEDURE.
      401   PROCEDURE check-modified-message :
      402     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      403        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      404           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      405        IF RETURN-VALUE = "YES":U THEN
      406           RUN notify ('view,CONTAINER-SOURCE':U).
      407        MESSAGE IF p-changed-table NE ? THEN
      408           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      409           ELSE "Current values have been changed."
      410           SKIP "  Do you wish to save those changes?"
      411           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      412        IF ANS THEN
      413        DO:
      414           IF group-assign-target THEN
      415             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      416           ELSE RUN dispatch('update-record':U).
      417           IF RETURN-VALUE = "ADM-ERROR":U THEN
      418           DO:
      419               MESSAGE "Changes to the previous record were not saved."
      420                 VIEW-AS ALERT-BOX ERROR.
      421               IF group-assign-target THEN
      422                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      423               ELSE RUN dispatch ('cancel-record':U).
      424           END.
      425        END.
      426        ELSE DO:
      427          IF group-assign-target THEN
      428             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      429          ELSE RUN dispatch('cancel-record':U).
      430        END.
      431        RETURN.
      432   END PROCEDURE.
      433   PROCEDURE get-rowid :
      434       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      435       ASSIGN
      436       p-table   =   adm-first-table.
      437       RETURN.
      438   END PROCEDURE.
      439   PROCEDURE init-group-assign :
      440       RUN request-attribute IN adm-broker-hdl
      441         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      442       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      443         group-assign-target = yes.
      444       ELSE group-assign-target = no.
      445       RETURN.
      446   END PROCEDURE.
      447   PROCEDURE set-editors :
      448       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      449       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      450       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      451       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      452       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      453       DO WHILE VALID-HANDLE (curr-widget):
      454           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      455              curr-widget:HIDDEN = no THEN DO:
      456             CASE p-field-setting:
      457               WHEN "INITIALIZE":U THEN
      458               DO:
      459                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      460                     read-only-list +
      461                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      462                        STRING(curr-widget).
      463               END.
      464               WHEN "DISABLE":U OR
      465               WHEN "ENABLE":U THEN
      466               DO:
      467                   curr-widget:SENSITIVE = yes.
      468                   RUN get-attribute ('Read-Only-Editors':U).
      469                   IF RETURN-VALUE = ? OR
      470                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      471                       curr-widget:READ-ONLY =
      472                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      473               END.
      474               WHEN "CLEAR":U THEN
      475                   curr-widget:SCREEN-VALUE = "":U.
      476             END CASE.
      477           END.
      478           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      479       END.
      480       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      481         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      482           + '"':U).
      483       RETURN.
      484   END PROCEDURE.
      485   PROCEDURE use-check-modified-all :
      486    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      487     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      488     RETURN.
      489   END PROCEDURE.
      490   PROCEDURE use-create-on-add :
      491   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      492      RETURN.
      493   END PROCEDURE.
      494   PROCEDURE use-initial-lock :
      495     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      496     ASSIGN adm-initial-lock = p-attr-value.
      497     RETURN.
      498   END PROCEDURE.
      499   PROCEDURE adm-display-fields :
      500         IF AVAILABLE parts THEN
      501             DISPLAY parts.part-code parts.pay-code parts.cli-qnty parts.cli-base-rate parts.qnty parts.fact-qnty parts.price-cli parts.price-base parts.price-rubl parts.VAT-type parts.VAT-pc parts.SLT-type parts.SLT-pc parts.other-base parts.other-rubl parts.road-tax-base parts.road-tax-rubl parts.transport-base parts.transport-rubl parts.artic parts.cst-code parts.doc-type parts.exch-code parts.fact-date parts.fact-num parts.host-code parts.in-code parts.is-supp parts.last-date parts.obj-code parts.obj-type parts.out-code parts.pl-code parts.prod-code parts.prod-type parts.PS parts.real-qnty parts.rsrv-free parts.status_ parts.supp-code parts.supp-type WITH BROWSE br_table
      502               NO-ERROR.
      503       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      504       RETURN.
      505   END PROCEDURE.
      506   PROCEDURE adm-open-query :
      507       IF AVAILABLE(doc-line) THEN DO:
      508               RUN dispatch ('open-query-cases':U).
      509           adm-query-opened = yes.
      510           IF NUM-RESULTS("br_table":U) = 0 THEN
      511               RUN new-state ('no-record-available,SELF':U).
      512           ELSE DO:
      513               RUN new-state ('record-available,SELF':U).
      514               RUN new-state ('first-record,SELF':U).
      515           END.
      516       END.
      517       ELSE
      518       DO:
      519           CLOSE QUERY br_table.
      520           RELEASE parts NO-ERROR.
      521           RUN new-state ('no-external-record-available,SELF':U).
      522       END.
      523           IF NOT adm-updating-record THEN
      524               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      525     RETURN.
      526   END PROCEDURE.
      527   PROCEDURE adm-row-changed :
      528         IF VALID-HANDLE(adm-object-hdl) THEN
      529           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      530         RUN notify ('row-available':U).
      531         RETURN.
      532   END PROCEDURE.
      533   PROCEDURE reposition-query :
      534       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      535       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      536       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      537       IF table-name <> ? THEN
      538           REPOSITION br_table TO ROWID table-name NO-ERROR.
      539       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      540       RETURN.
      541   END PROCEDURE.
      542     adm-sts = br_table:SET-REPOSITIONED-ROW
      543       (br_table:DOWN,"CONDITIONAL":U).
      544     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      545   PROCEDURE set-size :
      546     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      547     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      548     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      549     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      550     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      551     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      552     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      553     ASSIGN pd_height = MAX(pd_height, 2.0)
      554            pd_width  = MAX(pd_width, 2.0)
      555            hBrowse     = br_table:HANDLE IN FRAME F-Main
      556            hFieldGroup = hBrowse:PARENT
      557            htmpWidget  = hFieldGroup:FIRST-CHILD
      558            hFrame      = hFieldGroup:PARENT.
      559     Search-For-Siblings:
      560     REPEAT WHILE VALID-HANDLE(htmpWidget):
      561       IF htmpWidget NE hBrowse THEN DO:
      562         IF htmpWidget:TYPE NE "BUTTON" OR
      563            htmpWidget:X    NE 4 OR
      564            htmpWidget:Y    NE 4 THEN DO:
      565           RETURN.
      566         END.
      567       END.
      568       htmpWidget = htmpWidget:NEXT-SIBLING.
      569     END.
      570     IF pd_width < hBrowse:WIDTH THEN
      571       ASSIGN hBrowse:WIDTH = pd_width
      572              hFrame:WIDTH  = pd_width     NO-ERROR.
      573     ELSE
      574       ASSIGN hFrame:WIDTH  = pd_width
      575              hBrowse:WIDTH = pd_width     NO-ERROR.
      576     IF pd_height < hBrowse:HEIGHT THEN
      577       ASSIGN hBrowse:HEIGHT = pd_height
      578              hFrame:HEIGHT  = pd_height     NO-ERROR.
      579     ELSE
      580       ASSIGN hFrame:HEIGHT  = pd_height
      581              hBrowse:HEIGHT = pd_height     NO-ERROR.
      582   END PROCEDURE.
      583   ASSIGN
      584          FRAME F-Main:SCROLLABLE       = FALSE
      585          FRAME F-Main:HIDDEN           = TRUE.
      586   ON ROW-ENTRY OF br_table IN FRAME F-Main
      587   DO:
      588   END.
      589   ON ROW-LEAVE OF br_table IN FRAME F-Main
      590   DO:
      591   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      592   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      593   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      594     widget-enter = last-event:widget-enter.
      595     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      596     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      597       THEN widget-frame = widget-enter:FRAME.
      598     IF ((NOT VALID-HANDLE(widget-enter)) OR
      599         (widget-parent:TYPE = "BROWSE":U) OR
      600         (NOT VALID-HANDLE(widget-frame)) OR
      601         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      602     THEN DO:
      603         IF adm-brs-in-update THEN
      604         DO:
      605           MESSAGE
      606           "You must complete or cancel the update before leaving the current row."
      607               VIEW-AS ALERT-BOX WARNING.
      608           RETURN NO-APPLY.
      609         END.
      610         IF br_table:CURRENT-ROW-MODIFIED  OR
      611           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      612         DO:
      613           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      614           THEN DO:
      615             MESSAGE
      616             "Current record has been changed. " SKIP
      617             "Do you wish to save those changes?"
      618               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      619             IF l-save THEN
      620             DO:
      621                RUN dispatch('update-record':U).
      622                IF RETURN-VALUE = "ADM-ERROR":U THEN
      623                    RETURN NO-APPLY.
      624             END.
      625             ELSE RUN dispatch ('cancel-record':U).
      626           END.
      627           ELSE DO:
      628             RUN dispatch('update-record':U).
      629             IF RETURN-VALUE = "ADM-ERROR":U THEN
      630                 RETURN NO-APPLY.
      631           END.
      632         END.
      633     END.
      634   END.
      635   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      636   DO:
      637   RUN get-attribute('ADM-NEW-RECORD':U).
      638   IF RETURN-VALUE NE "YES":U THEN
      639     RUN notify ('row-available':U).
      640   END.
      641   if not this-procedure :persistent
      642   then do:
      643     message
      644       vss-workfile vss-revision vss-description skip
      645       "Ошибка при запуске процедуры" skip
      646       "Данную процедуру следует запускать только с параметром persistent" skip
      647       view-as alert-box error .
      648     undo, return error .
      649   end.
      650   PROCEDURE adm-open-query-cases :
      651     OPEN QUERY br_table FOR EACH parts WHERE parts.obj-type = doc-line.obj-type   AND parts.obj-code = doc-line.obj-code   AND parts.out-code = doc-line.doc-code   AND parts.artic = doc-line.artic   AND parts.prod-type = doc-line.prod-type   AND parts.prod-code = doc-line.prod-code NO-LOCK     .
      652   END PROCEDURE.
      653   PROCEDURE adm-row-available :
      654     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      655     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      656     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      657     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      658     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      659     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      660     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      661     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      662     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      663     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      664     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      665     IF adm-updating-record THEN RETURN.
      666     RUN get-attribute ('FIELDS-ENABLED':U).
      667     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      668     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      669         OUTPUT link-handle) NO-ERROR.
      670     IF link-handle = "":U THEN
      671         RETURN.
      672     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      673     IF NUM-ENTRIES(link-handle) > 1 THEN
      674         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      675             "encountered more than one RECORD-SOURCE.":U SKIP
      676             "The first - ":U record-source-hdl:file-name " - will be used.":U
      677                VIEW-AS ALERT-BOX ERROR.
      678     RUN get-attribute ('Key-Name':U).
      679     key-name = RETURN-VALUE.
      680     IF key-name = "":U THEN key-name = ?.
      681     IF key-name NE ? THEN DO:
      682       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      683         NO-ERROR.
      684       IF key-value NE ? THEN
      685         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      686     END.
      687     IF key-name eq ? THEN tbl-list = "doc-line":U.
      688         RUN send-records IN record-source-hdl
      689             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
      690         IF ERROR-STATUS:ERROR THEN RETURN.
      691     IF key-name ne ?
      692     THEN DO:
      693       RUN dispatch ('find-using-key':U).
      694       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
      695     END.
      696     ELSE
      697     DO:
      698       row-avail-cntr = row-avail-cntr + 1.
      699       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
      700       IF row-avail-rowid NE ROWID(doc-line) THEN different-row = yes.
      701       IF row-avail-rowid ne ? THEN DO:
      702          DO:
      703            IF row-avail-enabled AND
      704               (adm-initial-lock = "SHARE-LOCK":U OR
      705                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
      706            DO:
      707              IF adm-initial-lock = "SHARE-LOCK":U
      708              THEN FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid SHARE-LOCK NO-ERROR.
      709              ELSE DO TRANSACTION:
      710                FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
      711              END.
      712            END.
      713            ELSE FIND doc-line WHERE ROWID(doc-line) = row-avail-rowid  NO-LOCK NO-ERROR.
      714            IF ERROR-STATUS:ERROR THEN DO:
      715              RUN dispatch ('show-errors':U).
      716              RETURN "ADM-ERROR":U.
      717            END.
      718          END.
      719       END.
      720       ELSE DO:
      721            IF AVAILABLE doc-line THEN RELEASE doc-line.
      722              IF NOT different-row THEN
      723                RUN dispatch('open-query').
      724        END.
      725     END.
      726   IF VALID-HANDLE (adm-object-hdl) THEN
      727       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      728     IF key-name ne ? OR different-row
      729     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      730     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      731   END PROCEDURE.
      732   PROCEDURE disable_UI :
      733     HIDE FRAME F-Main.
      734     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      735   END PROCEDURE.
      736   PROCEDURE send-key :
      737   END PROCEDURE.
      738   PROCEDURE send-records :
      739     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      740     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      741     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      742     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      743     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      744     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      745         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      746         CASE ENTRY(i, p-tbl-list):
      747       WHEN "doc-line":U THEN p-rowid-list = p-rowid-list +
      748           IF AVAILABLE doc-line THEN STRING(ROWID(doc-line))
      749           ELSE "?":U.
      750       WHEN "parts":U THEN p-rowid-list = p-rowid-list +
      751           IF AVAILABLE parts THEN STRING(ROWID(parts))
      752           ELSE "?":U.
      753           OTHERWISE
      754           DO:
      755               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      756                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      757               IF link-handle NE "":U THEN
      758               DO:
      759                   IF NUM-ENTRIES(link-handle) > 1 THEN
      760                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      761                               "encountered more than one RECORD-SOURCE.":U SKIP
      762                               "The first will be used.":U
      763                               VIEW-AS ALERT-BOX ERROR.
      764                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      765                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      766                   p-rowid-list = p-rowid-list + rowid-string.
      767               END.
      768               ELSE
      769               DO:
      770                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      771                           "does not match tables in send-records":U
      772                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      773                           "Check that objects are linked properly and that":U
      774                           "database qualification is consistent.":U
      775                       VIEW-AS ALERT-BOX ERROR.
      776                   RETURN ERROR.
      777               END.
      778           END.
      779           END CASE.
      780       END.
      781   END PROCEDURE.
      782   PROCEDURE state-changed :
      783     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      784     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      785     CASE p-state:
      786       WHEN "update-begin":U THEN
      787       DO:
      788           adm-brs-in-update = yes.
      789           RUN dispatch ('enable-fields':U).
      790           IF RETURN-VALUE = "ADM-ERROR":U THEN
      791           DO:
      792             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      793             RUN new-state('update-complete':U).
      794           END.
      795           ELSE DO:
      796             RUN dispatch ('apply-entry':U).
      797             RUN new-state('update':U).
      798           END.
      799       END.
      800       WHEN "update":U THEN
      801         DO:
      802           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      803           RUN get-link-handle IN adm-broker-hdl
      804               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      805                   NO-ERROR.
      806           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      807             br_table:SENSITIVE IN FRAME F-Main = no.
      808         END.
      809       WHEN "update-complete":U THEN DO:
      810           br_table:SENSITIVE IN FRAME F-Main = yes.
      811           adm-brs-in-update = no.
      812           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      813           IF RETURN-VALUE NE "YES":U THEN
      814           DO:
      815             IF NUM-RESULTS("br_table":U) NE ? AND
      816                NUM-RESULTS("br_table":U) NE 0
      817             THEN DO:
      818               GET CURRENT br_table.
      819               RUN dispatch ('row-changed':U).
      820             END.
      821           END.
      822           RUN new-state ('update-complete':U).
      823       END.
      824       WHEN "delete-complete":U THEN DO:
      825          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      826          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      827          IF NUM-RESULTS("br_table":U) = 0 THEN
      828            RUN notify('row-available':U).
      829       END.
      830       WHEN   'first-record':U        OR
      831         WHEN 'last-record':U         OR
      832         WHEN 'only-record':U         OR
      833         WHEN 'not-first-or-last':U   OR
      834         WHEN 'no-record-available':U OR
      835         WHEN 'no-external-record-available':U THEN
      836           RUN set-attribute-list('Query-Position=':U + p-state).
      837     END CASE.
      838   END PROCEDURE.
