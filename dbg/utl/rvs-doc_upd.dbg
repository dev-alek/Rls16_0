     1321       menu-item m-meas-4 label "Текущей ТРК"             accelerator "alt-4".
     1322   define button r-acc
     1323        image-up          file "btn-down-arrow"
     1324        image-down        file "btn-down-arrow"
     1325        image-insensitive file "btn-down-arrow"
     1326        size 3 by .88.
     1327   define button r-agnt     like r-acc.
     1328   define button r-boss     like r-acc.
     1329   define button r-wrkr     like r-acc.
     1330   define variable agnt-name as character format "x(256)":u
     1331         view-as text
     1332        size 14 by 1 no-undo.
     1333   define variable boss-name as character format "x(256)":u
     1334         view-as text
     1335        size 14 by 1 no-undo.
     1336   define variable wrkr-name as character format "x(256)":u
     1337         view-as text
     1338        size 14 by 1 no-undo.
     1339   define variable del-list as character no-undo.
     1340   function get-mark return character (buffer local-rvs-line for ub.rvs-line ).
     1341      if lookup (string (recid (local-rvs-line)), del-list) > 0 then return "*".
     1342                                                                    else return "".
     1343   end function.
     1344   function deviation-fact    return decimal (buffer local-rvs-line for ub.rvs-line ).
     1345      return (local-rvs-line.state-measure-qnty   + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1346   end function.
     1347   function deviation-measure return decimal (buffer local-rvs-line for ub.rvs-line ).
     1348      return (local-rvs-line.measure-qnty + local-rvs-line.state-add-qnty - local-rvs-line.system-qnty).
     1349   end function.
     1350   define query br-line      for ub.rvs-line, ub.goods, ub.place scrolling.
     1351   define query br-pump for ub.rvs-line-pump                scrolling.
     1352   define browse br-line query br-line no-lock display
     1353         get-mark (buffer ub.rvs-line)  column-label '*'  format "x(1)"
     1354         ub.goods.artic  column-label 'Артикул'
     1355         ub.goods.gds-name  column-label 'Название'  format "x(15)"
     1356         ub.rvs-line.pl-code  column-label 'Скл.место'
     1357         place.loc1  column-label 'Номер резервуара'
     1358         ub.rvs-line.state-measure-qnty  column-label 'Факт остаток'
     1359         ub.rvs-line.measure-qnty  column-label 'Измер. остаток'
     1360         ub.rvs-line.system-qnty  column-label 'Учет'
     1361         ub.rvs-line.orig-system-qnty  column-label 'Первонач.учет'
     1362         ub.rvs-line.state-add-qnty column-label 'Факт в!трубопроводе' format "->>,>>>,>>>.<<<"
     1363         deviation-fact(buffer ub.rvs-line) column-label 'Отклонение(факт)' format "->>,>>>,>>>.<<<"
     1364         deviation-measure(buffer ub.rvs-line) column-label 'Отклонение(измер)'
     1365         ub.rvs-line.tolerance column-label 'Допустимое!отклонение'
     1366         ub.rvs-line.state-brutto-qnty column-label 'Факт брутто'
     1367         ub.rvs-line.brutto-qnty
     1368         ub.rvs-line.state-density
     1369         ub.rvs-line.density
     1370         ub.rvs-line.state-measure-cli-qnty
     1371         ub.rvs-line.measure-cli-qnty
     1372         ub.rvs-line.system-cli-qnty
     1373         ub.rvs-line.orig-system-cli-qnty
     1374         ub.rvs-line.state-brutto-cli-qnty
     1375         ub.rvs-line.brutto-cli-qnty
     1376         ub.rvs-line.state-mh-qnty
     1377         ub.rvs-line.meas-mh-qnty
     1378         ub.rvs-line.state-am-qnty
     1379         ub.rvs-line.meas-am-qnty
     1380         ub.rvs-line.state-cf-qnty
     1381         ub.rvs-line.meas-cf-qnty
     1382         ub.rvs-line.state-level-total
     1383         ub.rvs-line.level-total
     1384         ub.rvs-line.state-level-petrol format "->>,>>>,>>>.<<<"
     1385         ub.rvs-line.level-petrol
     1386         ub.rvs-line.state-level-water
     1387         ub.rvs-line.level-water
     1388         ub.rvs-line.state-temperature
     1389         ub.rvs-line.temperature
     1390         enable ub.rvs-line.temperature
     1391       with size 98.75 by 6 separators.
     1392   define browse br-pump query br-pump no-lock display
     1393         ub.rvs-line-pump.pump-code column-label 'ТРК'
     1394         ub.rvs-line-pump.nozzle-code column-label 'П'
     1395         ub.rvs-line-pump.state-mh-qnty
     1396         ub.rvs-line-pump.meas-mh-qnty
     1397         ub.rvs-line-pump.state-am-qnty
     1398         ub.rvs-line-pump.meas-am-qnty
     1399         ub.rvs-line-pump.state-cf-qnty
     1400         ub.rvs-line-pump.meas-cf-qnty
     1401         ub.rvs-line-pump.state-mh-cnt
     1402         ub.rvs-line-pump.meas-mh-cnt
     1403         ub.rvs-line-pump.state-el-cnt
     1404         ub.rvs-line-pump.meas-el-cnt
     1405         ub.rvs-line-pump.state-am-cnt
     1406         ub.rvs-line-pump.meas-am-cnt
     1407         ub.rvs-line-pump.state-cf-cnt
     1408         ub.rvs-line-pump.meas-cf-cnt
     1409         ub.rvs-line-pump.icnt-code
