     1176   procedure placelib_write-attr:
     1177   define input  parameter p-code     like ub.place-attr.attr-code .
     1178   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1179   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1180   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1181   define input  parameter p-value    like ub.place-attr.attr-value .
     1182   define output parameter p-ok       as logical.
     1183   define buffer buf_place-attr for ub.place-attr .
     1184     do on error undo, return error return-value :
     1185        p-ok = false.
     1186        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1187                                                   and buf_place-attr.obj-code    = p-obj-code
     1188                                                   and buf_place-attr.obj-type    = p-obj-type
     1189                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1190        if not available buf_place-attr then do :
     1191           create buf_place-attr.
     1192           assign
     1193             buf_place-attr.attr-code   = p-code
     1194             buf_place-attr.attr-value  = p-value
     1195             buf_place-attr.obj-code    = p-obj-code
     1196             buf_place-attr.obj-type    = p-obj-type
     1197             buf_place-attr.pl-code     = p-pl-code
     1198           .
     1199           p-ok = true.
     1200        end.
     1201        else do:
     1202           buf_place-attr.attr-value  = p-value .
     1203           p-ok = true.
     1204        end.
     1205     end.
     1206   end.
     1207   procedure placelib_get-attr:
     1208   define input  parameter  p-code     like ub.place-attr.attr-code .
     1209   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1210   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1211   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1212   define output parameter  p-value    like ub.place-attr.attr-value .
     1213   define output parameter  p-ok       as logical.
     1214   define buffer buf_place-attr for ub.place-attr .
     1215     do on error undo, return error return-value :
     1216        p-ok = false.
     1217        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1218                                                   and buf_place-attr.obj-code    = p-obj-code
     1219                                                   and buf_place-attr.obj-type    = p-obj-type
     1220                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1221        if available buf_place-attr then do :
     1222          p-value = buf_place-attr.attr-value.
     1223          p-ok = true.
     1224        end.
     1225        else do :
     1226          p-ok = false.
     1227        end.
     1228     end.
     1229   end.
     1230   procedure placelib_del-attr:
     1231   define input parameter  p-code     like ub.place-attr.attr-code .
     1232   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1233   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1234   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1235   define input parameter  p-value    like ub.place-attr.attr-value .
     1236   define output parameter p-ok       as logical.
     1237   define buffer buf_place-attr for ub.place-attr .
     1238     do on error undo, return error return-value :
     1239        p-ok = false.
     1240        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1241                                                   and buf_place-attr.obj-code    = p-obj-code
     1242                                                   and buf_place-attr.obj-type    = p-obj-type
     1243                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1244        if available buf_place-attr then do :
     1245           delete buf_place-attr.
     1246           p-ok = true.
     1247        end.
     1248     end.
     1249   end.
