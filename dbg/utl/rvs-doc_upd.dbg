     4537   procedure proc_m-meas-4 :
     4538   define buffer meas_pump-nozzle for ub.pump-nozzle.
     4539     if available ub.rvs-line-pump then do:
     4540       find first ub.rvs-line where ub.rvs-line.rvs-code = ub.rvs-line-pump.rvs-code and
     4541                                     ub.rvs-line.obj-type = ub.rvs-line-pump.obj-type and
     4542                                     ub.rvs-line.obj-code = ub.rvs-line-pump.obj-code and
     4543                                     ub.rvs-line.pl-code  = ub.rvs-line-pump.pl-code  and
     4544                                     ub.rvs-line.gds-code = ub.rvs-line-pump.gds-code no-error.
     4545       assign rvs-line-rec      = (if available ub.rvs-line then recid(ub.rvs-line) else ?)
     4546               rvs-line-pump-rec = recid(ub.rvs-line-pump).
     4547       find first meas_pump-nozzle where meas_pump-nozzle.obj-type    = ub.rvs-line-pump.obj-type    and
     4548                                         meas_pump-nozzle.obj-code    = ub.rvs-line-pump.obj-code    and
     4549                                         meas_pump-nozzle.pump-code   = ub.rvs-line-pump.pump-code   and
     4550                                         meas_pump-nozzle.nozzle-code = ub.rvs-line-pump.nozzle-code no-lock.
     4551       if meas_pump-nozzle.is-meas <> yes then do:
     4552           message "Пистолет " meas_pump-nozzle.nozzle-code " на ТРК " meas_pump-nozzle.pump-code " не измеряется приборами."
     4553           view-as alert-box error.
     4554           return error.
     4555       end.
     4556       run waitfram-show in this-procedure ( input "Просматриваем измеряемые ТРК" ).
     4557   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_measpmnz in g#lib-rvs ( input ub.rvs-line-pump.obj-type ,
     4558                         input ub.rvs-line-pump.obj-code ,
     4559                         input-output table tt-pump-nozzle ) no-error .
     4560       if error-status :error then do:
     4561           message "Ошибка при определении пистолетов ТРК для измерения."
     4562                   return-value
     4563           view-as alert-box error.
     4564           run waitfram-hide in this-procedure.
     4565           return error.
     4566       end.
     4567       if can-find(first tt-pump-nozzle) then do:
     4568           if ptoldfilvalue = "yes":u then do:
     4569             run gbl/d-askw.w ( input "Выбор источника данных с информацией по ТРК",
     4570                           "Будем читать текущие данные с ТРК или возьмем данные из файла?",
     4571                           "|^",
     4572                           "Текущие данные|Из файлов|Отмена",
     4573                           "Запускается программа для обращения к датчикам ТРК|Берутся уже сохраненные данные из файла|Ничего не делаем",
     4574                           1,
     4575                           3,
     4576                           output varnum
     4577                           ).
     4578             case varnum:
     4579             when 3 then do:
     4580               undo, return error.
     4581             end.
     4582             when 2 then do:
     4583               assign
     4584                 varcur-pump = no.
     4585             end.
     4586             when 1 then do:
     4587               assign
     4588                 varcur-pump = yes.
     4589             end.
     4590             end case.
     4591           end.
     4592           else do:
     4593               assign
     4594                 varcur-pump = yes.
     4595           end.
     4596           run waitfram-show in this-procedure ( input "Делаем сверку по всем ТРК" ).
     4597           tr:
     4598           do transaction
     4599           on error undo tr, return no-apply
     4600           :
     4601   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parParentProc ,
     4602                         input              r-doc.obj-type ,
     4603                         input              r-doc.obj-code ,
     4604                         input              yes ,
     4605                         input-output table tt-pump-nozzle-file ,
     4606                         input-output table tt-pump-nozzle ,
     4607                         input              varcur-pump ,
     4608                         input              yes ,
     4609                         input              no) no-error .
     4610             if error-status :error then do:
     4611               message "Ошибка при получении данных с приборов на ТРК (anls-pmp)." skip
     4612                       error-status :get-message( 1 )                              skip
     4613                       return-value
     4614               view-as alert-box error.
     4615               run waitfram-hide in this-procedure.
     4616               undo tr, return error.
     4617             end.
     4618             if return-value <> "":U then do:
     4619               message return-value view-as alert-box information.
     4620             end.
     4621   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill1pmp in g#lib-rvs ( input       recid( ub.rvs-line-pump ) ,
     4622                         input table tt-pump-nozzle ) no-error .
     4623             if error-status :error then do:
     4624               message
     4625                 "Ошибка при сохранении данных в строку счетчиков ТРК." skip
     4626                 error-status :get-message( 1 ) skip
     4627                 return-value
     4628                 view-as alert-box error.
     4629               run waitfram-hide in this-procedure.
     4630               undo tr, return error.
     4631             end.
     4632             run waitfram-show in this-procedure ( input "Пересчитывем строку и шапку" ).
     4633   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclcln in g#lib-rvs ( input recid( ub.rvs-line ) ) no-error .
     4634             if error-status :error then do:
     4635               message
     4636                 "Ошибка при пересчете линии." skip
     4637                 error-status :get-message( 1 ) skip
     4638                 return-value
     4639                 view-as alert-box error.
     4640               run waitfram-hide in this-procedure.
     4641               undo tr, return error.
     4642             end.
     4643   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( r-doc ) ,
     4644                         input no ) no-error .
     4645             if error-status :error then do:
     4646                 message "Ошибка при пересчете документа." skip
     4647                         return-value
     4648                 view-as alert-box error.
     4649                 run waitfram-hide in this-procedure.
     4650                 undo tr, return error.
     4651             end.
     4652           end.
     4653       end.
     4654       else message "Нет ни одного измеряемого счетчика ТРК."
     4655             view-as alert-box information.
     4656       run waitfram-hide in this-procedure.
     4657       run ui-on in this-procedure.
     4658     end.
     4659   else message "Неверно выбрана строка" view-as alert-box error.
     4660   end procedure.
     4661   procedure proc-chg-pump :
     4662     define buffer buf_goods for ub.goods.
     4663     assign rvs-line-rec      = ( if available ub.rvs-line then recid( ub.rvs-line ) else ? )
     4664            rvs-line-pump-rec = recid( ub.rvs-line-pump ).
     4665     case r-doc.rvs-type
     4666     :
     4667       when 'перед_док':U
     4668       or when 'после_док':U
     4669       then do:
     4670   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4671   do:
     4672     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4673       (input  v-cntxt-db-num
     4674       ,input  v-cntxt-userid
     4675       ,input  0
     4676       ,input  'actn_rvs-on-doc_upd-revision':U
     4677       ,input  'object':U
     4678       ,input  r-doc.host-code
     4679       ,input  r-doc.obj-type
     4680       ,input  r-doc.obj-code
     4681       ,input  0
     4682       ,input  0
     4683       ,input  0
     4684       ,input  true
     4685       ,output varlog
     4686       )  .
     4687   end.
     4688       end.
     4689       when 'смена':U
     4690       then do:
     4691   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4692   do:
     4693     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4694       (input  v-cntxt-db-num
     4695       ,input  v-cntxt-userid
     4696       ,input  0
     4697       ,input  'actn_rvs-shift_upd-revision-trk':U
     4698       ,input  'object':U
     4699       ,input  r-doc.host-code
     4700       ,input  r-doc.obj-type
     4701       ,input  r-doc.obj-code
     4702       ,input  0
     4703       ,input  0
     4704       ,input  0
     4705       ,input  true
     4706       ,output varlog
     4707       )  .
     4708   end.
     4709       end.
     4710       when 'контроль':U
     4711       then do:
     4712   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4713   do:
     4714     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4715       (input  v-cntxt-db-num
     4716       ,input  v-cntxt-userid
     4717       ,input  0
     4718       ,input  'actn_rvs-control_upd-revision-trk':U
     4719       ,input  'object':U
     4720       ,input  r-doc.host-code
     4721       ,input  r-doc.obj-type
     4722       ,input  r-doc.obj-code
     4723       ,input  0
     4724       ,input  0
     4725       ,input  0
     4726       ,input  true
     4727       ,output varlog
     4728       )  .
     4729   end.
     4730       end.
     4731       otherwise do:
     4732         message
     4733           vss-workfile vss-revision vss-description skip
     4734           "Неизвестный тип сверки" skip
     4735           "Тип сверки" r-doc.rvs-type skip
     4736           "Код сверки" r-doc.rvs-code skip
     4737           view-as alert-box error .
     4738         undo, return error return-value .
     4739       end.
     4740     end case .
     4741     if varlog <> yes then do: return no-apply. end.
     4742     find first buf_goods no-lock where
     4743                buf_goods.gds-code = ub.rvs-line-pump.gds-code.
     4744     run str/rvs-lnp.w
     4745       (input  parparentproc
