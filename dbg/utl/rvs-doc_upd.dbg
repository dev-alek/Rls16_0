     1413   define frame d-rvs
     1414   b-exit              at row 1  col 1
     1415   b-notes             at row 1  col 11
     1416   b-history           at row 1  col 71
     1417   b-help              at row 1  col 81
     1418   "Объект:"                         at row 2 col 10
     1419   r-doc.obj-code                    at row 2 col 16   colon-aligned no-label       view-as text size 7    by 1
     1420   r-doc.obj-type                    at row 2 col 23   colon-aligned no-label       view-as text size 7.13 by 1
     1421   ub.clients.obj-name               at row 2 col 33   colon-aligned no-label       view-as text size 40 by 1 fgcolor 4
     1422   r-doc.out-code                    at row 3 col 20   colon-aligned label "На основе документа" view-as text
     1423   r-doc.doc-date                    at row 3 col 40   colon-aligned view-as text
     1424   r-doc.state-measure-qnty          at row 4 col 38   colon-aligned view-as text
     1425   r-doc.measure-qnty                at row 4 col 63   colon-aligned label "Измер" view-as text
     1426   r-doc.system-qnty                 at row 4 col 85.5                          colon-aligned view-as text
     1427   r-doc.wrkr                        at row 5 col 4.5  colon-aligned format "999999999"  view-as fill-in size 10 by 1
     1428   wrkr-name                         at row 5 col 15   colon-aligned no-label fgcolor 4
     1429   r-wrkr                            at row 5 col 28   no-label
     1430   r-doc.state-measure-cli-qnty      at row 5 col 50   colon-aligned label "Вес"       view-as text
     1431   r-doc.measure-cli-qnty            at row 5 col 85.5 colon-aligned label "Измер.вес" view-as text
     1432   r-doc.agnt                        at row 6 col 4.5 colon-aligned format "999999999"  view-as fill-in size 10 by 1
     1433   agnt-name                         at row 6 col 15  colon-aligned no-label fgcolor 4
     1434   r-agnt                            at row 6 col 28  no-label
     1435   r-doc.system-cli-qnty         at row 6 col 50    colon-aligned label "Учет вес"         view-as text
     1436   r-doc.system-cli-avrg-qnty    at row 6 col 85.5  colon-aligned label "Вес по ср.пл-ти"  view-as text
     1437   r-doc.boss                    at row 7 col 4.5   colon-aligned format "999999999"       view-as fill-in size 10 by 1
     1438   boss-name                     at row 7 col 15    colon-aligned no-label                fgcolor 4
     1439   r-boss                        at row 7 col 28    no-label
     1440   r-doc.state-mh-qnty           at row 7 col 38    colon-aligned label "Оборот"           view-as text format "->,>>>,>>>,>>>.<<<"
     1441   r-doc.state-am-qnty           at row 7 col 63    colon-aligned label "Сумма"            view-as text format "->,>>>,>>>,>>>.<<<"
     1442   r-doc.state-cf-qnty           at row 7 col 85.5  colon-aligned label "Наливы"           view-as text
     1443   b-mark              at row 8  col 1
     1444   b-add               at row 8  col 4
     1445   b-del               at row 8  col 14
     1446   b-meas              at row 8  col 24
     1447   b-lkp               at row 8  col 34
     1448   b-chg               at row 8  col 44
     1449   br-line      at row 9  col 1
     1450   b-lkp-pump          at row 15 col 1
     1451   b-chg-pump          at row 15 col 11
     1452   br-pump at row 16 col 1
     1453   space(0) skip(0)
     1454   with view-as dialog-box side-labels three-d scrollable keep-tab-order.
     1455   assign
     1456     frame d-rvs:scrollable                                = false
     1457     br-line     :num-locked-columns in frame d-rvs = 5
     1458     br-pump:num-locked-columns in frame d-rvs = 2
     1459     b-add              :popup-menu in frame d-rvs         = menu m-add:handle
     1460     b-add              :menu-mouse                                = 1
     1461     b-meas             :popup-menu in frame d-rvs         = menu m-meas:handle
     1462     b-meas             :menu-mouse                                = 1.
     1463   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   DEF VAR cur-clmn-numbr-line as INT EXTENT 35 no-undo.
     1465   DEF VAR varmvibr-line       as INT no-undo.
     1466   DEF VAR varmvjbr-line       as INT no-undo.
     1467   DEF VAR varmvkbr-line       as INT no-undo.
     1468   DEF VAR varmvlbr-line       as INT no-undo.
     1469   DEF VAR move-elementbr-line as INT no-undo.
     1470   def var jjbr-line           as int no-undo.
     1471   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     1472     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     1473   END.
     1474   RUN start-mv-clmnbr-line.
     1475   PROCEDURE start-mv-clmnbr-line:
     1476   def var old-session as logical no-undo.
     1477      old-session = SESSION:IMMEDIATE-DISPLAY.
     1478      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1479      SESSION:IMMEDIATE-DISPLAY = old-session.
     1480   END.
     1481   ON ctrl-cursor-right OF BROWSE br-line do:
     1482     RUN re-move-clmnbr-line ( 6, 35).
     1483   END.
     1484   ON ctrl-cursor-left OF BROWSE br-line do:
     1485     RUN re-move-clmnbr-line (35, 6).
     1486   END.
     1487   PROCEDURE re-move-clmnbr-line:
     1488     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1489     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1490     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1491       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     1492     END.
     1493     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1494     if source-column > target-column THEN
     1495     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     1496       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1497           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1498             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     1499           END.
     1500       END.
     1501     END.
     1502     ELSE
     1503     DO varmvjbr-line = source-column + 1 to target-column:
     1504       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1505         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1506           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     1507         END.
     1508       END.
     1509     END.
     1510     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1511       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     1512     END.
     1513   END PROCEDURE.
     1514   PROCEDURE ch-clmnbr-line:
     1515     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1516     if cur-clmn-loc <= 6 then do:
     1517       return .
     1518     end.
     1519     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1520       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     1521     END.
     1522     RUN re-move-clmnbr-line (cur-clmn-loc, 6).
     1523   END PROCEDURE.
     1524   PROCEDURE mv-brw-defaultbr-line:
     1525   def var old-session as logical no-undo.
     1526     old-session = SESSION:IMMEDIATE-DISPLAY.
     1527     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1528     do varmvlbr-line = 6 to EXTENT(cur-clmn-numbr-line):
     1529       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     1530     END.
     1531     RUN start-mv-clmnbr-line.
     1532     SESSION:IMMEDIATE-DISPLAY = old-session.
     1533   END PROCEDURE.
     1534   .
     1535   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   DEF VAR cur-clmn-numbr-pump as INT EXTENT 18 no-undo.
     1537   DEF VAR varmvibr-pump       as INT no-undo.
     1538   DEF VAR varmvjbr-pump       as INT no-undo.
     1539   DEF VAR varmvkbr-pump       as INT no-undo.
     1540   DEF VAR varmvlbr-pump       as INT no-undo.
     1541   DEF VAR move-elementbr-pump as INT no-undo.
     1542   def var jjbr-pump           as int no-undo.
     1543   do varmvibr-pump = 1 to EXTENT(cur-clmn-numbr-pump):
     1544     ASSIGN cur-clmn-numbr-pump[varmvibr-pump] = varmvibr-pump.
     1545   END.
     1546   RUN start-mv-clmnbr-pump.
     1547   PROCEDURE start-mv-clmnbr-pump:
     1548   def var old-session as logical no-undo.
     1549      old-session = SESSION:IMMEDIATE-DISPLAY.
     1550      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1551      SESSION:IMMEDIATE-DISPLAY = old-session.
     1552   END.
     1553   ON ctrl-cursor-right OF BROWSE br-pump do:
     1554     RUN re-move-clmnbr-pump ( 3, 18).
     1555   END.
     1556   ON ctrl-cursor-left OF BROWSE br-pump do:
     1557     RUN re-move-clmnbr-pump (18, 3).
     1558   END.
     1559   PROCEDURE re-move-clmnbr-pump:
     1560     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1561     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1562     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1563       if cur-clmn-numbr-pump[varmvibr-pump] = source-column THEN cur-clmn-numbr-pump[varmvibr-pump] = -1.
     1564     END.
     1565     if br-pump:MOVE-COLUMN(source-column, target-column) IN FRAME d-rvs then.
     1566     if source-column > target-column THEN
     1567     DO varmvjbr-pump = source-column - 1 to target-column BY -1:
     1568       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1569           if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1570             cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] + 1.
     1571           END.
     1572       END.
     1573     END.
     1574     ELSE
     1575     DO varmvjbr-pump = source-column + 1 to target-column:
     1576       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1577         if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1578           cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] - 1.
     1579         END.
     1580       END.
     1581     END.
     1582     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1583       if cur-clmn-numbr-pump[varmvibr-pump] = -1 THEN cur-clmn-numbr-pump[varmvibr-pump] = target-column.
     1584     END.
     1585   END PROCEDURE.
     1586   PROCEDURE ch-clmnbr-pump:
     1587     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1588     if cur-clmn-loc <= 3 then do:
     1589       return .
     1590     end.
     1591     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1592       if cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-loc THEN move-elementbr-pump = varmvibr-pump.
     1593     END.
     1594     RUN re-move-clmnbr-pump (cur-clmn-loc, 3).
     1595   END PROCEDURE.
     1596   PROCEDURE mv-brw-defaultbr-pump:
     1597   def var old-session as logical no-undo.
     1598     old-session = SESSION:IMMEDIATE-DISPLAY.
     1599     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1600     do varmvlbr-pump = 3 to EXTENT(cur-clmn-numbr-pump):
     1601       RUN re-move-clmnbr-pump (cur-clmn-numbr-pump[varmvlbr-pump], varmvlbr-pump).
     1602     END.
     1603     RUN start-mv-clmnbr-pump.
     1604     SESSION:IMMEDIATE-DISPLAY = old-session.
     1605   END PROCEDURE.
     1606   .
     1607   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   on F9 of frame d-rvs anywhere do:
     1609     if not available ub.goods then
     1610       return no-apply.
     1611     gds-rec = recid (ub.goods).
     1612     run ref/gds-form.w ( input parparentproc
     1613                         ,input 'ПРОСМОТР':U
     1614                         ,input ?
     1615                         ,input ?
     1616                         ,input ?
     1617                         ,input-output gds-rec).
     1618     apply "entry" to br-line in frame d-rvs.
     1619     return no-apply.
     1620   end.
     1621   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   on F3 of frame d-rvs anywhere do:
     1623     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-rvs. END.
     1624     return no-apply.
     1625   end.
     1626   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1627   on F4 of frame d-rvs anywhere do:
     1628     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-rvs. END.
     1629     return no-apply.
     1630   end.
     1631   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   on F8 of frame d-rvs anywhere do:
     1633     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-rvs. END.
     1634     return no-apply.
     1635   end.
     1636   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   on INS of frame d-rvs anywhere do:
     1638     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-rvs. END.
     1639     return no-apply.
     1640   end.
     1641   on end-error, stop of frame d-rvs do:
     1642     apply "choose" to b-exit in frame d-rvs.
     1643     return no-apply.
     1644   end.
     1645   on choose of b-notes in frame d-rvs
     1646   do:
     1647     assign notes = r-doc.ps.
     1648     run gbl/notes.w ( input pardoc-mode, input-output notes ).
     1649     if r-doc.ps <> notes then do:
     1650       do on stop undo, return no-apply :
     1651         find r-doc exclusive-lock where recid (r-doc) = parrvs-rec.
     1652         assign r-doc.ps = notes.
     1653       end.
     1654     end.
     1655   end.
     1656   on choose of b-history in frame d-rvs
     1657   do:
     1658     define variable v-list as character no-undo.
     1659     if available r-doc then do:
     1660       run str/rvscdocs.w ( input        parparentproc,
     1661                        input        "":U,
     1662                        input        "one":U,
     1663                        input        r-doc.rvs-code,
     1664                        input-output v-list                  ).
     1665     end.
     1666   end.
     1667   on choose of b-exit in frame d-rvs
     1668   do:
     1669     if pardoc-mode = 'ИЗМЕНЕНИЕ':U  or
     1670        pardoc-mode = 'ДОБАВЛЕНИЕ':U then do:
     1671       if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then do:
     1672         varlog = yes.
     1673         message "В документе нет строк, поэтому он удаляется." view-as alert-box
     1674           question buttons ok-cancel update varlog.
     1675         if varlog then do:
     1676           delete r-doc.
     1677           parrvs-rec = ?.
     1678           return.
     1679         end.
     1680         else return no-apply.
     1681       end.
     1682       assign r-doc.wrkr r-doc.agnt r-doc.boss.
     1683     end.
     1684   end.
     1685   on mouse-select-dblclick, return of r-doc.agnt in frame d-rvs
     1686   do:
     1687     run local-psn-chk in this-procedure ( input "agnt", input "ret-mouse" ).
     1688     apply "entry" to r-doc.boss in frame d-rvs.
     1689     return no-apply.
     1690   end.
     1691   on mouse-select-dblclick, return of r-doc.boss in frame d-rvs
     1692   do:
     1693     run local-psn-chk in this-procedure ( input "boss", input "ret-mouse" ).
     1694     apply "entry" to b-exit in frame d-rvs.
     1695     return no-apply.
     1696   end.
     1697   on mouse-select-dblclick, return of r-doc.wrkr in frame d-rvs
     1698   do:
     1699     run local-psn-chk in this-procedure ( input "wrkr", input "ret-mouse" ).
     1700     apply "entry" to r-doc.agnt in frame d-rvs.
     1701     return no-apply.
     1702   end.
     1703   on choose of r-agnt in frame d-rvs
     1704   do:
     1705     run local-psn-chk in this-procedure ( input "agnt", input "button" ).
     1706     apply "entry" to r-doc.boss in frame d-rvs.
     1707     return no-apply.
     1708   end.
     1709   on choose of r-boss in frame d-rvs
     1710   do:
     1711      run local-psn-chk in this-procedure ( input "boss", input "button" ).
     1712     apply "entry" to b-exit in frame d-rvs.
     1713     return no-apply.
     1714   end.
     1715   on choose of r-wrkr in frame d-rvs
     1716   do:
     1717     run local-psn-chk in this-procedure ( input "wrkr", input "button" ).
     1718     apply "entry" to r-doc.agnt in frame d-rvs.
     1719     return no-apply.
     1720   end.
     1721   on leave of r-doc.agnt in frame d-rvs
     1722   do:
     1723      run local-psn-chk in this-procedure ( input "agnt", input "leave" ).
     1724   end.
     1725   on leave of r-doc.boss in frame d-rvs
     1726   do:
     1727      run local-psn-chk in this-procedure ( input "boss", input "leave" ).
     1728   end.
     1729   on leave of r-doc.wrkr in frame d-rvs
     1730   do:
     1731      run local-psn-chk in this-procedure ( input "wrkr", input "leave" ).
     1732   end.
     1733   on return, mouse-select-dblclick of br-line in frame d-rvs
     1734   do:
     1735     if b-chg:sensitive then apply "choose" to b-chg in frame d-rvs.
     1736                        else apply "choose" to b-lkp in frame d-rvs.
     1737   end.
     1738   on return, mouse-select-dblclick of br-pump in frame d-rvs
     1739   do:
     1740     if b-chg-pump :sensitive then do: apply "choose" to b-chg-pump in frame d-rvs. end.
     1741                              else do: apply "choose" to b-lkp-pump in frame d-rvs. end.
     1742   end.
     1743   on choose of b-mark in frame d-rvs do:
     1744     run local-mark in this-procedure.
     1745     varlog = br-line:select-next-row ().
     1746     apply "entry" to br-line in frame d-rvs.
     1747   end.
     1748   on choose of b-chg in frame d-rvs
     1749   do:
     1750     do on stop undo, return no-apply :
     1751       if not available ub.rvs-line then do:
     1752         message "Неправильный выбор строки.".
     1753         return no-apply.
     1754       end.
     1755       run local-chg in this-procedure no-error.
     1756       if error-status :error then do: return no-apply. end.
     1757       run ui-on in this-procedure .
     1758     end.
     1759   end.
     1760   on choose of b-chg-pump in frame d-rvs
     1761   do:
     1762     define buffer buf_goods for ub.goods.
     1763     if not available ub.rvs-line-pump then do:
     1764       message "Неправильный выбор строки.".
     1765       return no-apply.
     1766     end.
     1767     run proc-chg-pump in this-procedure no-error.
     1768     if error-status :error then do: return no-apply. end.
     1769   end.
     1770   on choose of b-lkp-pump in frame d-rvs
     1771   do:
     1772     run proc-lookup in this-procedure no-error.
     1773     if error-status :error then do: return no-apply. end.
     1774   end.
     1775   on choose of b-del in frame d-rvs
     1776   do:
     1777      run del-rvs-line in this-procedure no-error.
     1778      if error-status :error then do: return no-apply. end.
     1779      assign rvs-line-rec = rep-rec.
     1780      run ui-on in this-procedure.
     1781   end.
     1782   on choose of b-lkp in frame d-rvs
     1783   do:
     1784     run proc-lkp in this-procedure no-error.
     1785     if error-status :error then do: return no-apply. end.
     1786   end.
     1787   on choose of menu-item m-add-1 in menu m-add do:
     1788     run local-add in this-procedure no-error.
     1789     if error-status :error then do:
     1790       return no-apply.
     1791     end.
     1792     run ui-on in this-procedure no-error.
     1793     if error-status :error then do:
     1794       return no-apply.
     1795     end.
     1796     apply "entry" to b-add in frame d-rvs.
     1797     return no-apply.
     1798   end.
     1799   on choose of menu-item m-add-2 in menu m-add do:
     1800     run proc_m-add-2 in this-procedure no-error.
     1801     if error-status :error then do: return no-apply. end.
     1802     run ui-on in this-procedure .
     1803   end.
     1804   on choose of menu-item m-add-3 in menu m-add do:
     1805     run doc-plsh in this-procedure no-error.
     1806     if error-status :error then do: return no-apply. end.
     1807     run ui-on in this-procedure.
     1808   end.
     1809   on choose of menu-item m-meas-1 in menu m-meas do:
     1810     run proc_m-meas-1 in this-procedure no-error.
     1811     if error-status :error then do: return no-apply. end.
     1812   end.
     1813   on choose of menu-item m-meas-2 in menu m-meas do:
     1814     run proc_m-meas-2 in this-procedure no-error.
     1815     if error-status :error then do: return no-apply. end.
     1816   end.
     1817   on choose of menu-item m-meas-3 in menu m-meas do:
     1818     run proc_m-meas-3 in this-procedure no-error.
     1819     if error-status :error then do: return no-apply. end.
     1820   end.
     1821   on choose of menu-item m-meas-4 in menu m-meas do:
     1822     run proc_m-meas-4 in this-procedure no-error.
     1823     if error-status :error then do: return no-apply. end.
     1824   end.
     1825   def var sort-labelbr-line   as character no-undo .
     1826   def var sort-clmnbr-line    as handle    no-undo .
     1827   def var cur-clmnbr-line     as handle    no-undo .
     1828   def var cur-clmn-locbr-line as integer   no-undo .
     1829   def var re-querybr-line     as logical   initial no no-undo .
     1830   on start-search, ctrl-o of br-line in frame d-rvs do:
     1831      run sort-brbr-line
     1832        (input (if available ub.rvs-line
     1833                then recid(ub.rvs-line)
     1834                else ?
     1835               )
     1836        ).
     1837   end.
     1838   PROCEDURE sort-brbr-line :
     1839     define input parameter p-recid as recid no-undo .
     1840     if re-querybr-line = no then do:
     1841       assign
     1842          cur-clmnbr-line = br-line:current-column in frame d-rvs
     1843       .
     1844       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     1845       if cur-clmnbr-line = sort-clmnbr-line then do:
     1846         assign
     1847            sort-labelbr-line = ""
     1848            sort-clmnbr-line = ?
     1849         .
     1850        end.
     1851        else do:
     1852          assign
     1853            sort-labelbr-line = cur-clmnbr-line:label
     1854            sort-clmnbr-line  = cur-clmnbr-line
     1855            sort-clmnbr-line:column-fgcolor = 4
     1856          .
     1857        end.
     1858      end.
     1859     assign
     1860       cur-clmn-locbr-line = 1
     1861     .
     1862     def var column-handle as handle no-undo .
     1863     column-handle = br-line:first-column.
     1864     do while valid-handle(column-handle) :
     1865       if column-handle = cur-clmnbr-line then do:
     1866         leave .
     1867       end.
     1868       column-handle = column-handle:NEXT-COLUMN.
     1869       assign
     1870         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     1871       .
     1872     end.
     1873     case sort-labelbr-line:
     1874           when '*'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by get-mark (buffer ub.rvs-line) .   . END.
     1875           when 'Артикул'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.goods.artic .   . END.
     1876           when 'Название'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.goods.gds-name .   . END.
     1877           when 'Скл.место'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.pl-code .   . END.
     1878           when 'Номер резервуара'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by place.loc1 .   . END.
     1879           when 'Факт остаток'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-measure-qnty .   . END.
     1880           when 'Измер. остаток'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.measure-qnty .   . END.
     1881           when 'Учет'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.system-qnty .   . END.
     1882           when 'Первонач.учет'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.orig-system-qnty .   . END.
     1883           when 'Факт в!трубопроводе'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-add-qnty .   . END.
     1884           when 'Отклонение(факт)'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by deviation-fact(buffer ub.rvs-line) .   . END.
     1885           when 'Отклонение(измер)'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by deviation-measure(buffer ub.rvs-line) .   . END.
     1886           when 'Допустимое!отклонение'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.tolerance .   . END.
     1887           when 'Факт брутто'  then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-brutto-qnty .   . END.
     1888           when ub.rvs-line.brutto-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.brutto-qnty .   . END.
     1889           when ub.rvs-line.state-density:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-density .   . END.
     1890           when ub.rvs-line.density:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.density .   . END.
     1891           when ub.rvs-line.state-measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-measure-cli-qnty .   . END.
     1892           when ub.rvs-line.measure-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.measure-cli-qnty .   . END.
     1893           when ub.rvs-line.system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.system-cli-qnty .   . END.
     1894           when ub.rvs-line.orig-system-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.orig-system-cli-qnty .   . END.
     1895           when ub.rvs-line.state-brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-brutto-cli-qnty .   . END.
     1896           when ub.rvs-line.brutto-cli-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.brutto-cli-qnty .   . END.
     1897           when ub.rvs-line.state-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-mh-qnty .   . END.
     1898           when ub.rvs-line.meas-mh-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-mh-qnty .   . END.
     1899           when ub.rvs-line.state-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-am-qnty .   . END.
     1900           when ub.rvs-line.meas-am-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-am-qnty .   . END.
     1901           when ub.rvs-line.state-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-cf-qnty .   . END.
     1902           when ub.rvs-line.meas-cf-qnty:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.meas-cf-qnty .   . END.
     1903           when ub.rvs-line.state-level-total:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-total .   . END.
     1904           when ub.rvs-line.level-total:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-total .   . END.
     1905           when ub.rvs-line.state-level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-petrol .   . END.
     1906           when ub.rvs-line.level-petrol:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-petrol .   . END.
     1907           when ub.rvs-line.state-level-water:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-level-water .   . END.
     1908           when ub.rvs-line.level-water:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.level-water .   . END.
     1909           when ub.rvs-line.state-temperature:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.state-temperature .   . END.
     1910           when ub.rvs-line.temperature:label in browse br-line then DO:   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code by ub.rvs-line.temperature .   . END.
     1911       otherwise do:
     1912         open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     1913           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     1914             run mv-brw-defaultbr-line.
     1915           end.
     1916         if sort-labelbr-line <> "" then do:
     1917           assign
     1918             cur-clmnbr-line:column-fgcolor = 0
     1919           .
     1920         end.
     1921         assign
     1922           cur-clmn-locbr-line = ?
     1923         .
     1924       end.
     1925     end case.
     1926       if cur-clmn-locbr-line <> ? then do:
     1927         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     1928           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     1929         end.
     1930       end.
     1931     if p-recid <> ? then do:
     1932       reposition br-line to recid p-recid no-error.
     1933       apply "value-changed" to br-line in frame d-rvs.
     1934     end.
     1935     apply "entry" to br-line in frame d-rvs.
     1936   END PROCEDURE.
     1937   procedure re-open-query-srt-clmnbr-line:
     1938   if cur-clmnbr-line = ? then do:
     1939      open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     1940   end.
     1941   else do:
     1942      assign re-querybr-line = yes.
     1943      run sort-brbr-line
     1944        (input (if available ub.rvs-line
     1945                then recid(ub.rvs-line)
     1946                else ?
     1947               )
     1948        ).
     1949      assign re-querybr-line = no.
     1950   end.
     1951   end.
     1952   def var sort-labelbr-pump   as character no-undo .
     1953   def var sort-clmnbr-pump    as handle    no-undo .
     1954   def var cur-clmnbr-pump     as handle    no-undo .
     1955   def var cur-clmn-locbr-pump as integer   no-undo .
     1956   def var re-querybr-pump     as logical   initial no no-undo .
     1957   on start-search, ctrl-o of br-pump in frame d-rvs do:
     1958      run sort-brbr-pump
     1959        (input (if available ub.rvs-line-pump
     1960                then recid(ub.rvs-line-pump)
     1961                else ?
     1962               )
     1963        ).
     1964   end.
     1965   PROCEDURE sort-brbr-pump :
     1966     define input parameter p-recid as recid no-undo .
     1967     if re-querybr-pump = no then do:
     1968       assign
     1969          cur-clmnbr-pump = br-pump:current-column in frame d-rvs
     1970       .
     1971       if sort-clmnbr-pump <> ? then sort-clmnbr-pump:column-fgcolor = 0.
     1972       if cur-clmnbr-pump = sort-clmnbr-pump then do:
     1973         assign
     1974            sort-labelbr-pump = ""
     1975            sort-clmnbr-pump = ?
     1976         .
     1977        end.
     1978        else do:
     1979          assign
     1980            sort-labelbr-pump = cur-clmnbr-pump:label
     1981            sort-clmnbr-pump  = cur-clmnbr-pump
     1982            sort-clmnbr-pump:column-fgcolor = 4
     1983          .
     1984        end.
     1985      end.
     1986     assign
     1987       cur-clmn-locbr-pump = 1
     1988     .
     1989     def var column-handle as handle no-undo .
     1990     column-handle = br-pump:first-column.
     1991     do while valid-handle(column-handle) :
     1992       if column-handle = cur-clmnbr-pump then do:
     1993         leave .
     1994       end.
     1995       column-handle = column-handle:NEXT-COLUMN.
     1996       assign
     1997         cur-clmn-locbr-pump = cur-clmn-locbr-pump + 1
     1998       .
     1999     end.
     2000     case sort-labelbr-pump:
     2001           when 'ТРК'  then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.pump-code .   . END.
     2002           when 'П'  then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.nozzle-code .   . END.
     2003           when ub.rvs-line-pump.state-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-mh-qnty .   . END.
     2004           when ub.rvs-line-pump.meas-mh-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-mh-qnty .   . END.
     2005           when ub.rvs-line-pump.state-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-am-qnty .   . END.
     2006           when ub.rvs-line-pump.meas-am-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-am-qnty .   . END.
     2007           when ub.rvs-line-pump.state-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-cf-qnty .   . END.
     2008           when ub.rvs-line-pump.meas-cf-qnty:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-cf-qnty .   . END.
     2009           when ub.rvs-line-pump.state-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-mh-cnt .   . END.
     2010           when ub.rvs-line-pump.meas-mh-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-mh-cnt .   . END.
     2011           when ub.rvs-line-pump.state-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-el-cnt .   . END.
     2012           when ub.rvs-line-pump.meas-el-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-el-cnt .   . END.
     2013           when ub.rvs-line-pump.state-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-am-cnt .   . END.
     2014           when ub.rvs-line-pump.meas-am-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-am-cnt .   . END.
     2015           when ub.rvs-line-pump.state-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.state-cf-cnt .   . END.
     2016           when ub.rvs-line-pump.meas-cf-cnt:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.meas-cf-cnt .   . END.
     2017           when ub.rvs-line-pump.icnt-code:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.icnt-code .   . END.
     2018           when ub.rvs-line-pump.rvs-prev-code:label in browse br-pump then DO:   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code by ub.rvs-line-pump.rvs-prev-code .   . END.
     2019       otherwise do:
     2020         open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     2021           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pump') then do:
     2022             run mv-brw-defaultbr-pump.
     2023           end.
     2024         if sort-labelbr-pump <> "" then do:
     2025           assign
     2026             cur-clmnbr-pump:column-fgcolor = 0
     2027           .
     2028         end.
     2029         assign
     2030           cur-clmn-locbr-pump = ?
     2031         .
     2032       end.
     2033     end case.
     2034       if cur-clmn-locbr-pump <> ? then do:
     2035         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pump') then do:
     2036           run ch-clmnbr-pump in this-procedure (cur-clmn-locbr-pump).
     2037         end.
     2038       end.
     2039     if p-recid <> ? then do:
     2040       reposition br-pump to recid p-recid no-error.
     2041       apply "value-changed" to br-pump in frame d-rvs.
     2042     end.
     2043     apply "entry" to br-pump in frame d-rvs.
     2044   END PROCEDURE.
     2045   procedure re-open-query-srt-clmnbr-pump:
     2046   if cur-clmnbr-pump = ? then do:
     2047      open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     2048   end.
     2049   else do:
     2050      assign re-querybr-pump = yes.
     2051      run sort-brbr-pump
     2052        (input (if available ub.rvs-line-pump
     2053                then recid(ub.rvs-line-pump)
     2054                else ?
     2055               )
     2056        ).
     2057      assign re-querybr-pump = no.
     2058   end.
     2059   end.
     2060   on value-changed of br-line in frame d-rvs do:
     2061     if available ub.rvs-line then do:
     2062       run re-open-query-srt-clmnbr-pump in this-procedure.
     2063     end.
     2064   end.
     2065   if valid-handle(active-window) and frame d-rvs:parent eq ?
     2066   then frame d-rvs:parent = active-window.
     2067   on window-close of frame d-rvs apply "end-error":u to self.
     2068   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2069   on help of frame d-rvs
     2070   do:
     2071     run gbl/app_help.p
     2072       (input this-procedure :file-name
     2073       ,input ''
     2074       ,input ?
     2075       ) no-error.
     2076     if error-status :error then do:
     2077       message
     2078         "Ошибка при вызове помощи"
     2079         error-status :get-message(1)
     2080         view-as alert-box .
     2081     end.
     2082   end.
     2083   run minbtn-set in this-procedure .
     2084   on choose of b-help in frame d-rvs
     2085   do:
     2086     apply "help":u to frame d-rvs .
     2087   end.
     2088   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089   procedure minbtn-set :
     2090       do
     2091           on error undo, return error return-value
     2092           :
     2093           define variable ii              as integer       no-undo .
     2094           define variable fh              as widget-handle no-undo .
     2095           define variable hh              as widget-handle no-undo .
     2096           define variable v-h             as handle        extent 4 no-undo .
     2097           define variable v-name-button   as character     no-undo .
     2098           define variable v-help-old-x    as decimal       no-undo .
     2099           define variable v-help-old-y    as decimal       no-undo .
     2100           define variable v-help-old-size as decimal       no-undo .
     2101           define variable v-frame-width   as decimal       no-undo .
     2102           define variable jj              as integer       no-undo .
     2103           do
     2104               on error undo, return error
     2105               :
     2106               assign
     2107                   v-frame-width = frame d-rvs:width - 0.3
     2108                   fh            = frame d-rvs:first-child
     2109                   hh            = fh:first-child
     2110                   ii            = 1
     2111                   .
     2112               do while valid-handle(hh):
     2113                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2114                   do:
     2115                       case lc(hh:name) :
     2116                           when "b-help" then
     2117                               do:
     2118                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2119                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2120                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2121                                   hh:TOOLTIP = "Помощь" .
     2122                                   v-help-old-x = hh:column .
     2123                                   v-help-old-y = hh:row    .
     2124                                   v-help-old-size = hh:width .
     2125                                   hh:width-chars = 2.5 .
     2126                               end.
     2127                           when "b-print" then
     2128                               do:
     2129                                   hh:load-image("cmp/b-print.bmp":u) .
     2130                                   hh:TOOLTIP = "Печать" .
     2131                                   v-h[ii] = hh:handle .
     2132                                   ii = ii + 1 .
     2133                                   hh:width-chars = 3 .
     2134                               end.
     2135                           when "b-history" or
     2136                           when "b-hist" then
     2137                               do:
     2138                                   hh:load-image("cmp/b-hist.bmp":u) .
     2139                                   hh:TOOLTIP = "История" .
     2140                                   v-h[ii] = hh:handle .
     2141                                   ii = ii + 1 .
     2142                                   hh:width-chars = 3 .
     2143                               end.
     2144                           when "b-sch" then
     2145                               do:
     2146                                   hh:load-image("cmp/b-sch.bmp":u) .
     2147                                   hh:TOOLTIP = "Установка Фильтра" .
     2148                                   v-h[ii] = hh:handle .
     2149                                   ii = ii + 1 .
     2150                                   hh:width-chars = 3 .
     2151                               end.
     2152                           when "b-hist-user" then
     2153                               do:
     2154                                   hh:load-image("cmp/b-hist.bmp":u) .
     2155                                   hh:TOOLTIP = "История пользователя" .
     2156                                   ii = ii + 1 .
     2157                               end.
     2158                       end case.
     2159                   end.
     2160                   hh = hh:next-sibling.
     2161               end.
     2162               b-help:column = v-frame-width - b-help:width-chars.
     2163               jj = 0.
     2164               repeat ii = 4 to 1 by -1 :
     2165                   if valid-handle (v-h[ii] ) then
     2166                   do:
     2167                       jj  = jj + 1 .
     2168                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2169                       v-h[ii]:row    = v-help-old-y .
     2170                   end.
     2171               end.
     2172           end.
     2173       end.
     2174   end procedure.
     2175   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2176   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2177   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2178   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2179   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2180   define variable v-diasize-current-frame-height as decimal   no-undo .
     2181   define variable v-diasize-change-size          as logical   no-undo .
     2182   define variable v-diasize-resize-button        as handle    no-undo .
     2183   define variable v-diasize-wndmax               as logical   no-undo .
     2184   define variable v-diasize-wndstore             as logical   no-undo .
     2185   define variable v-diasize-proc-name            as character no-undo .
     2186   define variable v-diasize-browse-handle        as handle    no-undo .
     2187   define variable v-diasize-browse-number        as integer   no-undo .
     2188   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2189   define temp-table temp-diasize-handle no-undo
     2190     field handle-value  as handle
     2191     field save-position as decimal
     2192     index xpk is primary unique handle-value
     2193     .
     2194   define temp-table temp-browse-handle no-undo
     2195     field browse-type   as character
     2196     field browse-number as integer
     2197     field browse-handle as handle
     2198     field original-size as decimal
     2199     index xpk is primary unique browse-type browse-number
     2200     index xie browse-type browse-handle
     2201   .
     2202   procedure diasize_change-height :
     2203     define input  parameter p-change-value  as decimal   no-undo .
     2204     define input  parameter p-move-resize   as logical   no-undo .
     2205     define variable v-field-group-handle    as handle    no-undo .
     2206     define variable v-object-handle         as handle    no-undo .
     2207     define variable v-frame-height          as decimal   no-undo .
     2208     define variable v-frame-virtual-height  as decimal   no-undo .
     2209     define variable v-browse-height         as decimal   no-undo .
     2210     define variable v-window-height         as decimal   no-undo .
     2211     define variable v-window-virtual-height as decimal   no-undo .
     2212     define variable v-change-sign           as integer   no-undo .
     2213     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2214     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2215     if p-change-value > 0
     2216     then do:
     2217       if frame d-rvs :height + p-change-value
     2218           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2219       then do:
     2220         assign
     2221           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2222                           - (frame d-rvs :height-chars)
     2223         .
     2224         if p-change-value <= 0
     2225         then do:
     2226           run diasize_position-resize-button in this-procedure .
     2227           return .
     2228         end.
     2229       end.
     2230     end.
     2231     if p-change-value < 0
     2232     then do:
     2233       if frame d-rvs :height + p-change-value < v-diasize-orig-frame-height
     2234       then do:
     2235         assign
     2236           p-change-value = v-diasize-orig-frame-height
     2237                          - (frame d-rvs :height-chars)
     2238         .
     2239         if p-change-value >= 0
     2240         then do:
     2241           run diasize_position-resize-button in this-procedure .
     2242           return .
     2243         end.
     2244       end.
     2245     end.
     2246     if p-change-value >= 0
     2247     then do:
     2248       assign
     2249         v-change-sign = 1
     2250       .
     2251     end.
     2252     else do:
     2253       assign
     2254         v-change-sign = -1
     2255       .
     2256     end.
     2257     assign
     2258       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2259     .
     2260     if p-change-value = 0
     2261     then do:
     2262       run diasize_position-resize-button in this-procedure .
     2263       return .
     2264     end.
     2265     move_block:
     2266     do
     2267     on error undo move_block, retry move_block
     2268     :
     2269       if retry
     2270       then do:
     2271         do
     2272         on error undo move_block, leave move_block
     2273         :
     2274           if p-change-value > 0
     2275           then do:
     2276             for each buf_temp-diasize-handle
     2277             on error undo, next
     2278             :
     2279               assign
     2280                 v-object-handle = buf_temp-diasize-handle.handle-value
     2281               .
     2282               if v-object-handle <> v-diasize-resize-button
     2283               then do:
     2284                 assign
     2285                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2286                 .
     2287               end.
     2288             end.
     2289             assign
     2290               v-diasize-browse-handle :height = v-browse-height
     2291             .
     2292             for each buf_temp-browse-handle
     2293               where buf_temp-browse-handle.browse-type = 'height':u
     2294             on error undo, next
     2295             :
     2296               assign
     2297                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2298               .
     2299             end.
     2300             assign
     2301               frame d-rvs :height = v-frame-height
     2302             .
     2303             if frame d-rvs :scrollable = true
     2304             then do:
     2305               assign
     2306                 frame d-rvs :virtual-height = v-frame-virtual-height
     2307               .
     2308             end.
     2309             run diasize_position-resize-button in this-procedure .
     2310           end.
     2311           else do:
     2312             if frame d-rvs :scrollable = true
     2313             then do:
     2314               assign
     2315                 frame d-rvs :virtual-height = v-frame-virtual-height
     2316               .
     2317             end.
     2318             assign
     2319               frame d-rvs :height = v-frame-height
     2320             .
     2321             assign
     2322               v-diasize-browse-handle :height = v-browse-height
     2323             .
     2324             for each buf_temp-browse-handle
     2325               where buf_temp-browse-handle.browse-type = 'height':u
     2326             on error undo, next
     2327             :
     2328               assign
     2329                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2330               .
     2331             end.
     2332             for each buf_temp-diasize-handle
     2333             on error undo, next
     2334             :
     2335               assign
     2336                 v-object-handle = buf_temp-diasize-handle.handle-value
     2337               .
     2338               if v-object-handle <> v-diasize-resize-button
     2339               then do:
     2340                 assign
     2341                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2342                 .
     2343               end.
     2344             end.
     2345             run diasize_position-resize-button in this-procedure .
     2346           end.
     2347           assign
     2348             v-diasize-change-size = false
     2349           .
     2350           leave move_block .
     2351         end.
     2352       end.
     2353       assign
     2354         v-diasize-need-full-display = true
     2355       .
     2356       if v-diasize-change-size = false
     2357       then do:
     2358         assign
     2359           v-diasize-change-size = true
     2360         .
     2361       end.
     2362       else do:
     2363         return .
     2364       end.
     2365       assign
     2366         v-frame-height = frame d-rvs :height
     2367         v-frame-virtual-height = frame d-rvs :virtual-height
     2368         v-browse-height = v-diasize-browse-handle :height
     2369       .
     2370       for each buf_temp-browse-handle
     2371         where buf_temp-browse-handle.browse-type = 'height':u
     2372       :
     2373         assign
     2374           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2375         .
     2376       end.
     2377       for each buf_temp-diasize-handle
     2378       :
     2379         delete buf_temp-diasize-handle .
     2380       end.
     2381       assign
     2382         v-field-group-handle = frame d-rvs :first-child
     2383       .
     2384       do while valid-handle(v-field-group-handle)
     2385       :
     2386         assign
     2387           v-object-handle = v-field-group-handle :first-child
     2388         .
     2389         do while valid-handle(v-object-handle)
     2390         :
     2391           if  v-object-handle <> v-diasize-browse-handle :handle
     2392           and can-query(v-object-handle, "row")
     2393           and can-query(v-object-handle, "height")
     2394           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2395           then do:
     2396             find first buf_temp-browse-handle
     2397               where buf_temp-browse-handle.browse-type   = 'height':u
     2398                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2399               no-error .
     2400             if available buf_temp-browse-handle
     2401             then do:
     2402             end.
     2403             else do:
     2404               create buf_temp-diasize-handle .
     2405               assign
     2406                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2407                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2408               .
     2409             end.
     2410           end.
     2411           assign
     2412             v-object-handle = v-object-handle :next-sibling
     2413           .
     2414         end.
     2415         assign
     2416           v-field-group-handle = v-field-group-handle :next-sibling
     2417         .
     2418       end.
     2419       do with frame d-rvs
     2420       :
     2421         hide v-diasize-resize-button .
     2422         assign
     2423           v-diasize-resize-button :row    = 1
     2424           v-diasize-resize-button :column = 1
     2425         .
     2426       end.
     2427       if p-change-value > 0
     2428       then do:
     2429         if frame d-rvs :scrollable = true
     2430         then do:
     2431           assign
     2432             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     2433             no-error .
     2434           if error-status :error
     2435           or error-status :get-message(1) <> ""
     2436           then do:
     2437             undo move_block, retry move_block .
     2438           end.
     2439         end.
     2440         assign
     2441           frame d-rvs :height = frame d-rvs :height + p-change-value
     2442           no-error .
     2443         if error-status :error
     2444         or error-status :get-message(1) <> ""
     2445         then do:
     2446           undo move_block, retry move_block .
     2447         end.
     2448         assign
     2449           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2450           no-error .
     2451         if error-status :error
     2452         or error-status :get-message(1) <> ""
     2453         then do:
     2454           undo move_block, retry move_block .
     2455         end.
     2456         for each buf_temp-browse-handle
     2457           where buf_temp-browse-handle.browse-type = 'height':u
     2458         on error undo move_block, retry move_block
     2459         :
     2460           assign
     2461             buf_temp-browse-handle.browse-handle :height
     2462               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2463             no-error .
     2464           if error-status :error
     2465           or error-status :get-message(1) <> ""
     2466           then do:
     2467             undo move_block, retry move_block .
     2468           end.
     2469         end.
     2470         for each buf_temp-diasize-handle
     2471         on error undo move_block, retry move_block
     2472         :
     2473           assign
     2474             v-object-handle = buf_temp-diasize-handle.handle-value
     2475           .
     2476           if v-object-handle <> v-diasize-resize-button
     2477           then do:
     2478             assign
     2479               v-object-handle :row = v-object-handle :row + p-change-value
     2480               no-error .
     2481             if error-status :error
     2482             or error-status :get-message(1) <> ""
     2483             then do:
     2484               undo move_block, retry move_block .
     2485             end.
     2486           end.
     2487         end.
     2488       end.
     2489       else do:
     2490         for each buf_temp-diasize-handle
     2491         on error undo move_block, retry move_block
     2492         :
     2493           assign
     2494             v-object-handle = buf_temp-diasize-handle.handle-value
     2495           .
     2496           if v-object-handle <> v-diasize-resize-button
     2497           then do:
     2498             assign
     2499               v-object-handle :row = v-object-handle :row + p-change-value
     2500               no-error .
     2501             if error-status :error
     2502             or error-status :get-message(1) <> ""
     2503             then do:
     2504               undo move_block, retry move_block .
     2505             end.
     2506           end.
     2507         end.
     2508         assign
     2509           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2510           no-error .
     2511         if error-status :error
     2512         or error-status :get-message(1) <> ""
     2513         then do:
     2514           undo move_block, retry move_block .
     2515         end.
     2516         for each buf_temp-browse-handle
     2517           where buf_temp-browse-handle.browse-type = 'height':u
     2518         on error undo move_block, retry move_block
     2519         :
     2520           assign
     2521             buf_temp-browse-handle.browse-handle :height
     2522               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2523             no-error .
     2524           if error-status :error
     2525           or error-status :get-message(1) <> ""
     2526           then do:
     2527             undo move_block, retry move_block .
     2528           end.
     2529         end.
     2530         assign
     2531           frame d-rvs :height = frame d-rvs :height + p-change-value
     2532           no-error .
     2533         if error-status :error
     2534         or error-status :get-message(1) <> ""
     2535         then do:
     2536           undo move_block, retry move_block .
     2537         end.
     2538         if frame d-rvs :scrollable = true
     2539         then do:
     2540           assign
     2541             frame d-rvs :virtual-height = frame d-rvs :virtual-height + p-change-value
     2542             no-error .
     2543           if error-status :error
     2544           or error-status :get-message(1) <> ""
     2545           then do:
     2546             undo move_block, retry move_block .
     2547           end.
     2548         end.
     2549       end.
     2550       if p-move-resize = true
     2551       then do:
     2552         run diasize_position-resize-button in this-procedure .
     2553       end.
     2554       if v-diasize-wndstore = true
     2555       then do:
     2556         if connected("ub") = true
     2557         then do:
     2558           define variable v-cntxt-db-num        as integer   no-undo .
     2559           define variable v-cntxt-userid        as character no-undo .
     2560           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2561                                             , OUTPUT v-cntxt-userid
     2562                                             ) .
     2563           run gbl/wndsizew.p
     2564             (input  v-cntxt-db-num
     2565             ,input  v-cntxt-userid
     2566             ,input  v-diasize-proc-name
     2567             ,input  'height':u
     2568             ,input  string(frame d-rvs :height - v-diasize-orig-frame-height)
     2569             ) .
     2570         end.
     2571       end.
     2572     end.
     2573     assign
     2574       v-diasize-change-size = false
     2575     .
     2576   end procedure.
     2577   procedure diasize_set-height :
     2578     define input  parameter p-new-height  as decimal   no-undo .
     2579     define input  parameter p-move-resize as logical   no-undo .
     2580     do
     2581     on error undo, return error return-value
     2582     :
     2583       run diasize_change-height in this-procedure
     2584         (input  (p-new-height - frame d-rvs :height)
     2585         ,input  p-move-resize
     2586         ) .
     2587     end.
     2588   end procedure.
     2589   procedure diasize_change-width :
     2590     define input  parameter p-change-value as decimal   no-undo .
     2591     define input  parameter p-move-resize  as logical   no-undo .
     2592     define variable v-field-group-handle   as handle    no-undo .
     2593     define variable v-object-handle        as handle    no-undo .
     2594     define variable v-frame-width          as decimal   no-undo .
     2595     define variable v-frame-virtual-width  as decimal   no-undo .
     2596     define variable v-browse-width         as decimal   no-undo .
     2597     define variable v-window-width         as decimal   no-undo .
     2598     define variable v-window-virtual-width as decimal   no-undo .
     2599     define variable v-change-sign          as integer   no-undo .
     2600     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2601     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2602     if p-change-value > 0
     2603     then do:
     2604       if frame d-rvs :width + p-change-value >
     2605           session :width-chars
     2606       then do:
     2607         assign
     2608           p-change-value = session :width-chars - frame d-rvs :width
     2609         .
     2610         if p-change-value <= 0
     2611         then do:
     2612           run diasize_position-resize-button in this-procedure .
     2613           return .
     2614         end.
     2615       end.
     2616     end.
     2617     if p-change-value < 0
     2618     then do:
     2619       if frame d-rvs :width + p-change-value < v-diasize-orig-frame-width
     2620       then do:
     2621         assign
     2622           p-change-value = v-diasize-orig-frame-width
     2623                          - frame d-rvs :width
     2624         .
     2625         if p-change-value >= 0
     2626         then do:
     2627           run diasize_position-resize-button in this-procedure .
     2628           return .
     2629         end.
     2630       end.
     2631     end.
     2632     if p-change-value >= 0
     2633     then do:
     2634       assign
     2635         v-change-sign = 1
     2636       .
     2637     end.
     2638     else do:
     2639       assign
     2640         v-change-sign = -1
     2641       .
     2642     end.
     2643     assign
     2644       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2645     .
     2646     if p-change-value = 0
     2647     then do:
     2648       run diasize_position-resize-button in this-procedure .
     2649       return .
     2650     end.
     2651     move_block:
     2652     do
     2653     on error undo move_block, leave move_block
     2654     :
     2655       if retry
     2656       then do:
     2657         do
     2658         on error undo move_block, leave move_block
     2659         :
     2660           if p-change-value > 0
     2661           then do:
     2662             for each buf_temp-diasize-handle
     2663             on error undo, next
     2664             :
     2665               assign
     2666                 v-object-handle = buf_temp-diasize-handle.handle-value
     2667               .
     2668               if v-object-handle <> v-diasize-resize-button
     2669               then do:
     2670                 assign
     2671                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2672                 .
     2673               end.
     2674             end.
     2675             assign
     2676               v-diasize-browse-handle :width = v-browse-width
     2677             .
     2678             for each buf_temp-browse-handle
     2679               where buf_temp-browse-handle.browse-type = 'width':u
     2680             on error undo, next
     2681             :
     2682               assign
     2683                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2684               .
     2685             end.
     2686             assign
     2687               frame d-rvs :width = v-frame-width
     2688             .
     2689             if frame d-rvs :scrollable = true
     2690             then do:
     2691               assign
     2692                 frame d-rvs :virtual-width = v-frame-virtual-width
     2693               .
     2694             end.
     2695             run diasize_position-resize-button in this-procedure .
     2696           end.
     2697           else do:
     2698             if frame d-rvs :scrollable = true
     2699             then do:
     2700               assign
     2701                 frame d-rvs :virtual-width = v-frame-virtual-width
     2702               .
     2703             end.
     2704             assign
     2705               frame d-rvs :width = v-frame-width
     2706             .
     2707             for each buf_temp-browse-handle
     2708               where buf_temp-browse-handle.browse-type = 'width':u
     2709             on error undo, next
     2710             :
     2711               assign
     2712                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2713               .
     2714             end.
     2715             assign
     2716               v-diasize-browse-handle :width = v-browse-width
     2717             .
     2718             for each buf_temp-diasize-handle
     2719             on error undo, next
     2720             :
     2721               assign
     2722                 v-object-handle = buf_temp-diasize-handle.handle-value
     2723               .
     2724               if v-object-handle <> v-diasize-resize-button
     2725               then do:
     2726                 assign
     2727                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2728                 .
     2729               end.
     2730             end.
     2731             run diasize_position-resize-button in this-procedure .
     2732           end.
     2733           assign
     2734             v-diasize-change-size = false
     2735           .
     2736           leave move_block .
     2737         end.
     2738       end.
     2739       assign
     2740         v-diasize-need-full-display = true
     2741       .
     2742       if v-diasize-change-size = false
     2743       then do:
     2744         assign
     2745           v-diasize-change-size = true
     2746         .
     2747       end.
     2748       else do:
     2749         return .
     2750       end.
     2751       assign
     2752         v-frame-width = frame d-rvs :width
     2753         v-frame-virtual-width = frame d-rvs :virtual-width
     2754         v-browse-width = v-diasize-browse-handle :width
     2755       .
     2756       for each buf_temp-browse-handle
     2757         where buf_temp-browse-handle.browse-type = 'width':u
     2758       :
     2759         assign
     2760           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2761         .
     2762       end.
     2763       for each buf_temp-diasize-handle
     2764       :
     2765         delete buf_temp-diasize-handle .
     2766       end.
     2767       assign
     2768         v-field-group-handle = frame d-rvs :first-child
     2769       .
     2770       do while valid-handle(v-field-group-handle)
     2771       :
     2772         assign
     2773           v-object-handle = v-field-group-handle :first-child
     2774         .
     2775         do while valid-handle(v-object-handle)
     2776         :
     2777           if  v-object-handle <> v-diasize-browse-handle :handle
     2778           and v-object-handle <> v-diasize-resize-button
     2779           and can-query(v-object-handle, "row")
     2780           and can-query(v-object-handle, "height")
     2781           and ( v-object-handle :col + v-object-handle :width
     2782                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2783               )
     2784           then do:
     2785             find first buf_temp-browse-handle
     2786               where buf_temp-browse-handle.browse-type   = 'width':u
     2787                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2788               no-error .
     2789             if available buf_temp-browse-handle
     2790             then do:
     2791             end.
     2792             else do:
     2793               create buf_temp-diasize-handle .
     2794               assign
     2795                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2796                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2797               .
     2798             end.
     2799           end.
     2800           assign
     2801             v-object-handle = v-object-handle :next-sibling
     2802           .
     2803         end.
     2804         assign
     2805           v-field-group-handle = v-field-group-handle :next-sibling
     2806         .
     2807       end.
     2808       do with frame d-rvs
     2809       :
     2810         hide v-diasize-resize-button .
     2811         v-diasize-resize-button :row = 1.
     2812         v-diasize-resize-button :column = 1.
     2813       end.
     2814       if p-change-value > 0
     2815       then do:
     2816         if frame d-rvs :scrollable = true
     2817         then do:
     2818           assign
     2819             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     2820             no-error .
     2821           if error-status :error
     2822           or error-status :get-message(1) <> ""
     2823           then do:
     2824             undo move_block, retry move_block.
     2825           end.
     2826         end.
     2827         assign
     2828           frame d-rvs :width = v-frame-width + p-change-value
     2829           no-error .
     2830         if error-status :error
     2831         or error-status :get-message(1) <> ""
     2832         then do:
     2833           undo move_block, retry move_block.
     2834         end.
     2835         assign
     2836           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2837         no-error .
     2838         if error-status :error
     2839         or error-status :get-message(1) <> ""
     2840         then do:
     2841           undo move_block, retry move_block.
     2842         end.
     2843         for each buf_temp-browse-handle
     2844           where buf_temp-browse-handle.browse-type = 'width':u
     2845         on error undo move_block, retry move_block
     2846         :
     2847           assign
     2848             buf_temp-browse-handle.browse-handle :width
     2849               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2850             no-error .
     2851           if error-status :error
     2852           or error-status :get-message(1) <> ""
     2853           then do:
     2854             undo move_block, retry move_block .
     2855           end.
     2856         end.
     2857         for each buf_temp-diasize-handle
     2858         on error undo move_block, retry move_block
     2859         :
     2860           assign
     2861             v-object-handle = buf_temp-diasize-handle.handle-value
     2862           .
     2863           if v-object-handle <> v-diasize-resize-button
     2864           then do:
     2865             assign
     2866               v-object-handle :col = v-object-handle :col + p-change-value
     2867               no-error .
     2868             if error-status :error
     2869             or error-status :get-message(1) <> ""
     2870             then do:
     2871               undo move_block, retry move_block .
     2872             end.
     2873           end.
     2874         end.
     2875       end.
     2876       else do:
     2877         for each buf_temp-diasize-handle
     2878         on error undo move_block, retry move_block
     2879         :
     2880           assign
     2881             v-object-handle = buf_temp-diasize-handle.handle-value
     2882           .
     2883           if v-object-handle <> v-diasize-resize-button
     2884           then do:
     2885             assign
     2886               v-object-handle :col = v-object-handle :col + p-change-value
     2887               no-error .
     2888             if error-status :error
     2889             or error-status :get-message(1) <> ""
     2890             then do:
     2891               undo move_block, retry move_block .
     2892             end.
     2893           end.
     2894         end.
     2895         for each buf_temp-browse-handle
     2896           where buf_temp-browse-handle.browse-type = 'width':u
     2897         on error undo move_block, retry move_block
     2898         :
     2899           assign
     2900             buf_temp-browse-handle.browse-handle :width
     2901               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2902             no-error .
     2903           if error-status :error
     2904           or error-status :get-message(1) <> ""
     2905           then do:
     2906             undo move_block, retry move_block .
     2907           end.
     2908         end.
     2909         assign
     2910           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2911           no-error .
     2912         if error-status :error
     2913         or error-status :get-message(1) <> ""
     2914         then do:
     2915           undo move_block, retry move_block.
     2916         end.
     2917         assign
     2918           frame d-rvs :width = frame d-rvs :width + p-change-value
     2919         no-error .
     2920         if error-status :error
     2921         or error-status :get-message(1) <> ""
     2922         then do:
     2923           undo move_block, retry move_block.
     2924         end.
     2925         if frame d-rvs :scrollable = true
     2926         then do:
     2927           assign
     2928             frame d-rvs :virtual-width = frame d-rvs :virtual-width + p-change-value
     2929           no-error .
     2930           if error-status :error
     2931           or error-status :get-message(1) <> ""
     2932           then do:
     2933             undo move_block, retry move_block.
     2934           end.
     2935         end.
     2936       end.
     2937       if p-move-resize
     2938       then do:
     2939         run diasize_position-resize-button in this-procedure .
     2940       end.
     2941       if v-diasize-wndstore = true
     2942       then do:
     2943         if connected("ub") = true
     2944         then do:
     2945           define variable v-cntxt-db-num        as integer   no-undo .
     2946           define variable v-cntxt-userid        as character no-undo .
     2947           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2948                                             , OUTPUT v-cntxt-userid
     2949                                             ) .
     2950           run gbl/wndsizew.p
     2951             (input  v-cntxt-db-num
     2952             ,input  v-cntxt-userid
     2953             ,input  v-diasize-proc-name
     2954             ,input  'width':u
     2955             ,input  string(frame d-rvs :width - v-diasize-orig-frame-width)
     2956             ) .
     2957         end.
     2958       end.
     2959     end.
     2960     assign
     2961       v-diasize-change-size = false
     2962     .
     2963   end procedure.
     2964   procedure diasize_set-width :
     2965     define input  parameter p-new-width  as decimal   no-undo .
     2966     define input  parameter p-move-resize as logical   no-undo .
     2967     do
     2968     on error undo, return error return-value
     2969     :
     2970       run diasize_change-width in this-procedure
     2971         (input  (p-new-width - frame d-rvs :width)
     2972         ,input  p-move-resize
     2973         ) .
     2974     end.
     2975   end procedure.
     2976   procedure diasize_position-resize-button :
     2977     do with frame d-rvs
     2978     :
     2979       hide v-diasize-resize-button .
     2980       assign
     2981         v-diasize-resize-button :row = frame d-rvs :height - v-diasize-resize-button :height
     2982                     - 1
     2983                     - (frame d-rvs :border-bottom-pixels / session :pixels-per-row)
     2984         v-diasize-resize-button :col = frame d-rvs :width - v-diasize-resize-button :width
     2985                     - 1
     2986                     - (frame d-rvs :border-right-pixels / session :pixels-per-column)
     2987       .
     2988       view v-diasize-resize-button .
     2989     end.
     2990   end procedure.
     2991   on alt-right anywhere
     2992   do:
     2993     run diasize_change-width in this-procedure
     2994       (input 1
     2995       ,input true
     2996       ) .
     2997     return no-apply .
     2998   end.
     2999   on alt-left anywhere
     3000   do:
     3001     run diasize_change-width in this-procedure
     3002       (input -1
     3003       ,input true
     3004       ) .
     3005     return no-apply .
     3006   end.
     3007   on alt-down anywhere
     3008   do:
     3009     run diasize_change-height in this-procedure
     3010       (input 1
     3011       ,input true
     3012       ) .
     3013     return no-apply .
     3014   end.
     3015   on alt-up anywhere
     3016   do:
     3017     run diasize_change-height in this-procedure
     3018       (input -1
     3019       ,input true
     3020       ) .
     3021     return no-apply .
     3022   end.
     3023   on alt-enter of frame d-rvs
     3024   do:
     3025     run diasize_maximize in this-procedure
     3026       (input  ?
     3027       ).
     3028     return no-apply .
     3029   end.
     3030   procedure diasize_end-move :
     3031     do
     3032     on error undo, return error return-value
     3033     :
     3034       define variable v-row-delta as decimal   no-undo .
     3035       define variable v-col-delta as decimal   no-undo .
     3036       define variable v-new-row as decimal   no-undo .
     3037       define variable v-new-col as decimal   no-undo .
     3038       assign
     3039         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3040         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3041       .
     3042       assign
     3043         v-row-delta = v-new-row - frame d-rvs :height
     3044         v-col-delta = v-new-col - frame d-rvs :width
     3045       .
     3046       run diasize_change-height in this-procedure
     3047         (input v-row-delta
     3048         ,input true
     3049         ) .
     3050       run diasize_change-width in this-procedure
     3051         (input v-col-delta
     3052         ,input true
     3053         ) .
     3054     end.
     3055   end procedure.
     3056   procedure diasize_maximize :
     3057     define input  parameter p-action as logical   no-undo .
     3058     do
     3059     on error undo, return error return-value
     3060     :
     3061       if p-action = ?
     3062       then do:
     3063         if v-diasize-need-maximize = true
     3064         then do:
     3065           assign
     3066             p-action = true
     3067           .
     3068         end.
     3069         else do:
     3070           assign
     3071             p-action = false
     3072           .
     3073         end.
     3074       end.
     3075       if p-action = true
     3076       then do:
     3077         run diasize_change-height in this-procedure
     3078           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3079               - frame d-rvs :height-chars
     3080           ,input true
     3081           ) .
     3082         run diasize_change-width in this-procedure
     3083           (input session :width-chars
     3084               - frame d-rvs :width-chars
     3085           ,input true
     3086           ) .
     3087         assign
     3088           v-diasize-need-maximize = false
     3089         .
     3090       end.
     3091       else do:
     3092         run diasize_change-width in this-procedure
     3093           (input v-diasize-orig-frame-width
     3094               - frame d-rvs :width-chars
     3095           ,input true
     3096           ) .
     3097         run diasize_change-height in this-procedure
     3098           (input v-diasize-orig-frame-height
     3099               - frame d-rvs :height-chars
     3100           ,input true
     3101           ) .
     3102         assign
     3103           v-diasize-need-maximize = true
     3104         .
     3105       end.
     3106     end.
     3107   end procedure.
     3108   procedure diasize_restore-orig-size :
     3109     do
     3110     on error undo, return error return-value
     3111     :
     3112       assign
     3113         v-diasize-current-frame-width  = frame d-rvs :width
     3114         v-diasize-current-frame-height = frame d-rvs :height
     3115       .
     3116       run diasize_set-height in this-procedure
     3117         (input  v-diasize-orig-frame-height
     3118         ,input  true
     3119         ) .
     3120       run diasize_set-width in this-procedure
     3121         (input  v-diasize-orig-frame-width
     3122         ,input  true
     3123         ) .
     3124     end.
     3125   end procedure.
     3126   procedure diasize_restore-current-size :
     3127     do
     3128     on error undo, return error return-value
     3129     :
     3130       run diasize_set-height in this-procedure
     3131         (input  v-diasize-current-frame-height
     3132         ,input  true
     3133         ) .
     3134       run diasize_set-width in this-procedure
     3135         (input  v-diasize-current-frame-width
     3136         ,input  true
     3137         ) .
     3138     end.
     3139   end procedure.
     3140   procedure diasize_set-browse-handle :
     3141     define input  parameter p-browse-handle as handle   no-undo .
     3142     define buffer buf_temp-browse-handle for temp-browse-handle .
     3143     do
     3144     on error undo, return error return-value
     3145     :
     3146       assign
     3147         v-diasize-browse-handle = p-browse-handle
     3148       .
     3149       for each buf_temp-browse-handle
     3150       on error undo, return error return-value
     3151       :
     3152         delete buf_temp-browse-handle .
     3153       end.
     3154     end.
     3155   end procedure.
     3156   procedure diasize_add_browse :
     3157     define input  parameter p-browse-type   as character no-undo .
     3158     define input  parameter p-browse-handle as handle    no-undo .
     3159     define buffer buf_temp-browse-handle for temp-browse-handle .
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       assign
     3164         v-diasize-browse-number = v-diasize-browse-number + 1
     3165       .
     3166       create buf_temp-browse-handle .
     3167       assign
     3168         buf_temp-browse-handle.browse-type   = p-browse-type
     3169         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3170         buf_temp-browse-handle.browse-handle = p-browse-handle
     3171       .
     3172     end.
     3173   end procedure.
     3174   procedure diasize_init :
     3175     define variable v-default-value    as logical   no-undo .
     3176     define variable v-restore-saved    as logical   no-undo .
     3177     define variable v-resize-value-str as character no-undo .
     3178     do
     3179     on error undo, return error return-value
     3180     :
     3181       do with frame d-rvs
     3182       :
     3183         assign
     3184           v-diasize-orig-frame-height = frame d-rvs :height
     3185           v-diasize-orig-frame-width  = frame d-rvs :width
     3186           v-diasize-browse-handle     = browse br-line :handle
     3187         .
     3188         create button v-diasize-resize-button
     3189         assign
     3190           parent        = frame d-rvs :first-child
     3191           label         = "s"
     3192           height-pixels = 16
     3193           width-pixels  = 16
     3194           visible       = true
     3195           sensitive     = true
     3196           movable       = true
     3197           triggers:
     3198             on end-move persistent run diasize_end-move in this-procedure .
     3199           end triggers.
     3200         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3201         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3202         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3203         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3204         assign
     3205           v-diasize-wndmax = false
     3206         .
     3207         if connected("ub") = true
     3208         then do:
     3209           define variable v-cntxt-db-num        as integer   no-undo .
     3210           define variable v-cntxt-userid        as character no-undo .
     3211           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3212                                             , OUTPUT v-cntxt-userid
     3213                                             ) .
     3214           run gbl/wndpar_r.p
     3215             (input  v-cntxt-db-num
     3216             ,input  v-cntxt-userid
     3217             ,input  'wndmax':U
     3218             ,output v-diasize-wndmax
     3219             ,output v-default-value
     3220             ) .
     3221         end.
     3222         assign
     3223           v-diasize-wndstore = false
     3224         .
     3225         if connected("ub") = true
     3226         then do:
     3227           run gbl/wndpar_r.p
     3228             (input  v-cntxt-db-num
     3229             ,input  v-cntxt-userid
     3230             ,input  'wndstore':U
     3231             ,output v-diasize-wndstore
     3232             ,output v-default-value
     3233             ) .
     3234         end.
     3235         assign
     3236           v-diasize-proc-name = entry(1, program-name(2), '.')
     3237         .
     3238         if v-diasize-wndstore = true
     3239         then do:
     3240           assign
     3241             v-restore-saved = false
     3242           .
     3243           if connected("ub") = true
     3244           then do:
     3245             run gbl/wndsizer.p
     3246               (input  v-cntxt-db-num
     3247               ,input  v-cntxt-userid
     3248               ,input  v-diasize-proc-name
     3249               ,input  'height':u
     3250               ,output v-resize-value-str
     3251               ) .
     3252             if v-resize-value-str <> '':U
     3253             then do:
     3254               run diasize_change-height in this-procedure
     3255                 (input  integer(v-resize-value-str)
     3256                 ,input  true
     3257                 ) .
     3258               assign
     3259                 v-restore-saved = true
     3260               .
     3261             end.
     3262           end.
     3263           if connected("ub") = true
     3264           then do:
     3265             run gbl/wndsizer.p
     3266               (input  v-cntxt-db-num
     3267               ,input  v-cntxt-userid
     3268               ,input  v-diasize-proc-name
     3269               ,input  'width':u
     3270               ,output v-resize-value-str
     3271               ) .
     3272             if v-resize-value-str <> '':U
     3273             then do:
     3274               run diasize_change-width in this-procedure
     3275                 (input  integer(v-resize-value-str)
     3276                 ,input  true
     3277                 ) .
     3278               assign
     3279                 v-restore-saved = true
     3280               .
     3281             end.
     3282           end.
     3283           if v-restore-saved <> true
     3284           then do:
     3285             if v-diasize-wndmax = true
     3286             then do:
     3287               run diasize_maximize in this-procedure
     3288                 (input  true
     3289                 ) .
     3290             end.
     3291           end.
     3292         end.
     3293         else do:
     3294           if v-diasize-wndmax = true
     3295           then do:
     3296             run diasize_maximize in this-procedure
     3297               (input  true
     3298               ) .
     3299           end.
     3300         end.
     3301       end.
     3302     end.
     3303   end procedure.
     3304   procedure diasize_need-full-display :
     3305     define output parameter p-need-full-display as logical   no-undo .
     3306     do
     3307     on error undo, return error return-value
     3308     :
     3309       assign
     3310         p-need-full-display = v-diasize-need-full-display
     3311       .
     3312       assign
     3313         v-diasize-need-full-display = false
     3314       .
     3315     end.
     3316   end procedure.
     3317   procedure get-context :
     3318      define output parameter p-db-num as integer          no-undo.
     3319      define output parameter p-user-id as character        no-undo.
     3320      define variable v-login               as character    no-undo.
     3321      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3322      define buffer buf_user-login  for ub.user-login .
     3323      do
     3324      on error undo, return error
     3325      :
     3326            FIND FIRST buf_sys-ctrl no-lock.
     3327            ASSIGN
     3328               v-login = USERID("ub")
     3329               p-db-num = buf_sys-ctrl.db-num
     3330            .
     3331            FIND FIRST buf_user-login
     3332                 WHERE buf_user-login.db-num = p-db-num
     3333                   AND buf_user-login.user-login = v-login
     3334                 no-lock
     3335                 no-error
     3336                 .
     3337            IF AVAILABLE buf_user-login
     3338            THEN DO:
     3339               assign
     3340                  p-user-id = buf_user-login.user-id
     3341               .
     3342            END.
     3343      end.
     3344   end procedure.
     3345       run diasize_init in this-procedure .
     3346   main-block:
     3347   do on error   undo main-block, leave main-block
     3348      on end-key undo main-block, leave main-block
     3349      on stop    undo main-block, leave main-block:
     3350      run mode-on in this-procedure
     3351        no-error.
     3352      if error-status :error then do:
     3353        return error return-value .
     3354      end.
     3355      if pardoc-mode <> 'ПРОСМОТР':U then do:
     3356        assign
     3357          rvs-line-rec = ?
     3358        .
     3359      end.
     3360      run ui-on in this-procedure.
     3361      wait-for go of frame d-rvs focus b-add.
     3362   end.
     3363   run disable_ui in this-procedure.
     3364   procedure disable_ui :
     3365     hide frame d-rvs.
     3366   end procedure.
     3367   procedure ui-on :
     3368   del-list = "".
     3369   find first ub.clients where ub.clients.obj-type = r-doc.obj-type and
     3370                      ub.clients.obj-code = r-doc.obj-code no-lock.
     3371   assign frame d-rvs:title = "(" + substring (ub.clients.obj-name, 1, 35) +
     3372          ") :   ДОКУМЕНТ СВЕРКИ - " + r-doc.status_ + " № " + r-doc.rvs-code + "      - " + pardoc-mode.
     3373   disable all with frame d-rvs.
     3374   enable b-exit b-help b-lkp b-lkp-pump br-line br-pump b-history b-notes with frame d-rvs.
     3375   assign ub.rvs-line.temperature:read-only in browse br-line = yes
     3376          ub.rvs-line-pump.rvs-prev-code:read-only in browse br-pump = yes.
     3377   if r-doc.status_ = 'новый':U and
     3378      (pardoc-mode = 'ДОБАВЛЕНИЕ':U or
     3379       pardoc-mode = 'ИЗМЕНЕНИЕ':U        ) then do:
     3380         enable r-doc.wrkr
     3381                r-doc.agnt
     3382                r-doc.boss
     3383                r-wrkr r-agnt r-boss
     3384                with frame d-rvs.
     3385      if r-doc.rvs-type <> 'смена':U and
     3386         not (r-doc.rvs-type = 'контроль':U and r-doc.is-full = yes) then
     3387         enable b-add b-del b-mark with frame d-rvs.
     3388      enable b-meas with frame d-rvs.
     3389   end.
     3390   if
     3391      pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     3392      enable b-chg b-chg-pump with frame d-rvs.
     3393   end.
     3394   if available ub.clients then disp ub.clients.obj-name with frame d-rvs.
     3395   else disp ? @ ub.clients.obj-name with frame d-rvs.
     3396   disp r-doc.obj-code
     3397        r-doc.obj-type
     3398        r-doc.doc-date
     3399        r-doc.state-measure-qnty
     3400        r-doc.measure-qnty
     3401        r-doc.system-qnty
     3402        r-doc.state-measure-cli-qnty
     3403        r-doc.measure-cli-qnty
     3404        r-doc.system-cli-qnty
     3405        r-doc.system-cli-avrg-qnty
     3406        r-doc.state-mh-qnty
     3407        r-doc.state-am-qnty
     3408        r-doc.state-cf-qnty
     3409        r-doc.out-code
     3410        with frame d-rvs.
     3411     define variable v-ref-rec17   as recid no-undo .
     3412     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     3413                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3414   if not available cli-buf then do:
     3415     display r-doc.wrkr with frame d-rvs.
     3416     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.wrkr
     3417                            and cli-buf.obj-type = 'чел':U no-error.
     3418   end.
     3419   if available cli-buf then do:
     3420         display cli-buf.obj-code @ r-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-rvs.
     3421     end.
     3422     else display ? @ r-doc.wrkr ? @ wrkr-name with frame d-rvs.
     3423     define variable v-ref-rec18   as recid no-undo .
     3424     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3425                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3426   if not available cli-buf then do:
     3427     display r-doc.agnt with frame d-rvs.
     3428     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3429                            and cli-buf.obj-type = 'чел':U no-error.
     3430   end.
     3431   if available cli-buf then do:
     3432         display cli-buf.obj-code @ r-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3433     end.
     3434     else display ? @ r-doc.agnt ? @ agnt-name with frame d-rvs.
     3435     define variable v-ref-rec19   as recid no-undo .
     3436     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.boss
     3437                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3438   if not available cli-buf then do:
     3439     display r-doc.boss with frame d-rvs.
     3440     find cli-buf no-lock where cli-buf.obj-code = input frame d-rvs r-doc.boss
     3441                            and cli-buf.obj-type = 'чел':U no-error.
     3442   end.
     3443   if available cli-buf then do:
     3444         display cli-buf.obj-code @ r-doc.boss cli-buf.obj-name @ boss-name with frame d-rvs.
     3445     end.
     3446     else display ? @ r-doc.boss ? @ boss-name with frame d-rvs.
     3447   open query br-line    for each  ub.rvs-line no-lock where              ub.rvs-line.rvs-code =    r-doc.rvs-code      , first ub.goods        no-lock where              ub.goods.gds-code        = ub.rvs-line.gds-code      , first ub.place                where              ub.place.obj-type        = ub.rvs-line.obj-type and              ub.place.obj-code        = ub.rvs-line.obj-code and              ub.place.pl-code         = ub.rvs-line.pl-code.
     3448   if pardoc-mode = 'ПРОСМОТР':U then do:
     3449     if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     3450   end.
     3451   if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     3452     if not can-find (first ub.rvs-line where ub.rvs-line.rvs-code = r-doc.rvs-code no-lock) then
     3453       apply "entry" to b-add in frame d-rvs.
     3454     else do:
     3455       if rvs-line-rec      <> ? then reposition br-line      to recid rvs-line-rec      no-error.
     3456     end.
     3457   end.
     3458   open query br-pump    for each ub.rvs-line-pump no-lock where             ub.rvs-line-pump.rvs-code = ub.rvs-line.rvs-code and             ub.rvs-line-pump.obj-type = ub.rvs-line.obj-type and             ub.rvs-line-pump.obj-code = ub.rvs-line.obj-code and             ub.rvs-line-pump.pl-code  = ub.rvs-line.pl-code  and             ub.rvs-line-pump.gds-code = ub.rvs-line.gds-code.
     3459   if rvs-line-pump-rec <> ? then reposition br-pump to recid rvs-line-pump-rec no-error.
     3460   if num-results( "br-line" ) > 0 then do:
     3461      if br-line:refresh() then.
     3462   end.
     3463   end procedure.
     3464   PROCEDURE local-mark:
     3465     if not available ub.rvs-line then do:
     3466       message "Неправильный выбор строки.".
     3467       return no-apply.
     3468     end.
     3469   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3470   define variable v-str-recid21 as character no-undo .
     3471   define variable v-num-entry21 as integer   no-undo .
     3472   assign
     3473     v-str-recid21 = trim( string( recid( ub.rvs-line ) , "->>>>>>>>>>>9":U ) )
     3474     v-num-entry21 = lookup( v-str-recid21 , del-list )
     3475   .
     3476   if v-num-entry21 > 0 then do:
     3477     assign
     3478       entry( v-num-entry21, del-list ) = "":U
     3479       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3480     .
     3481   end.
     3482   else do:
     3483     assign
     3484       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid21
     3485     .
     3486   end.
     3487     br-line:refresh() in frame d-rvs .
     3488   END PROCEDURE.
     3489   procedure del-rvs-line:
     3490   if del-list = "" then do:
     3491     if not available ub.rvs-line then do:
     3492       message "Неправильный выбор строки.".
     3493       return error.
     3494     end.
     3495     varlog = no.
     3496     message "Удалить строку документа сверки ?   Вы уверены ?"
     3497             view-as alert-box question buttons ok-cancel update varlog.
     3498     if not varlog then return error.
     3499     rvs-line-rec = recid (ub.rvs-line).
     3500     del-list     = string (recid (ub.rvs-line)).
     3501     get next br-line.
     3502     if available ub.rvs-line then rep-rec = recid (ub.rvs-line).
     3503     else do:
     3504       reposition br-line to recid rvs-line-rec no-error.
     3505       get prev br-line.
     3506       rep-rec = recid (ub.rvs-line).
     3507     end.
     3508   end.
     3509   else do:
     3510     varlog = ?.
     3511     message "УДАЛЕНИЕ  ПО  ОТМЕТКАМ  строк документа ?" skip (2)
     3512                     "yes - удалить все отмеченные строки" skip
     3513                     "no - оставить только отмеченные строки и удалить все остальные" skip (2)
     3514                     "cancel - ничего не удалять"
     3515                     view-as alert-box question buttons yes-no-cancel update varlog.
     3516     if varlog = ? then return error.
     3517     rep-rec = ?.
     3518   end.
     3519   do transaction on error   undo, return error
     3520                  on end-key undo, return error
     3521                  on stop    undo, return error :
     3522      for each del-rvs-line where del-rvs-line.rvs-code = r-doc.rvs-code no-lock
     3523       :
     3524          if not varlog and     can-do (del-list, string (recid (del-rvs-line))) then next.
     3525          if     varlog and not can-do (del-list, string (recid (del-rvs-line))) then next.
     3526          assign rvs-line-rec = recid(del-rvs-line).
     3527          find ub.rvs-line where recid (ub.rvs-line) = rvs-line-rec exclusive.
     3528          delete ub.rvs-line.
     3529      end.
     3530   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid( r-doc ) ,
     3531                         input yes ) no-error .
     3532   end.
     3533   end procedure.
     3534   procedure cycle-add :
     3535     define buffer buf_rvs-line for ub.rvs-line.
     3536     define buffer buf_goods    for ub.goods.
     3537     define buffer buf_pl-gds   for ub.pl-gds.
     3538     define variable var-pl-code like ub.place.pl-code no-undo.
     3539     assign lns-cnt = 0.
     3540     do while lns-cnt < num-entries( notes ) :
     3541       assign lns-cnt = lns-cnt + 1
     3542              gds-rec = integer( entry( lns-cnt, notes ) ).
     3543       find buf_goods no-lock where recid( buf_goods ) = gds-rec.
     3544       run plgdsfnd in this-procedure (  input yes,
     3545                                         input r-doc.obj-type,
     3546                                         input r-doc.obj-code,
     3547                                         input buf_goods.gds-code,
     3548                                        output varres,
     3549                                        output var-pl-code ) no-error.
     3550       if error-status :error then do:
     3551          message "Ошибка при поиске складского места для товара: " skip
     3552                  buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code skip
     3553                  return-value
     3554                  "."
     3555          view-as alert-box error.
     3556          next.
     3557       end.
     3558       if varres <> yes then do:
     3559          message "Товар " buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code
     3560                  " не резевируется по складским местам на объекте "
     3561                  r-doc.obj-type r-doc.obj-code "."
     3562          view-as alert-box error.
     3563          next.
     3564       end.
     3565       find buf_pl-gds no-lock where
     3566            buf_pl-gds.obj-type = r-doc.obj-type and
     3567            buf_pl-gds.obj-code = r-doc.obj-code and
     3568            buf_pl-gds.pl-code  = var-pl-code            no-error.
     3569       if not available buf_pl-gds then do:
     3570          message "Ошибка при выборке складского места для товара: "
     3571                  buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code
     3572          view-as alert-box error.
     3573          next.
     3574       end.
     3575       find first buf_rvs-line no-lock where
     3576                  buf_rvs-line.rvs-code = r-doc.rvs-code and
     3577                  buf_rvs-line.gds-code = buf_goods.gds-code       and
     3578                  buf_rvs-line.pl-code  = buf_pl-gds.pl-code       no-error.
     3579       if available buf_rvs-line then do:
     3580           assign varlog = no.
     3581           message "Данный товар: " buf_goods.artic buf_goods.gds-name skip
     3582                   " и складское место " buf_pl-gds.pl-code
     3583                   "уже имеется в данном документе сверки." skip
     3584           view-as alert-box.
     3585           next.
     3586       end.
     3587       tr:
     3588       do transaction on error undo, return error return-value :
     3589   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input r-doc.obj-type ,
     3590                         input r-doc.obj-code ,
     3591                         input r-doc.rvs-code ,
     3592                         input r-doc.rvs-type ,
     3593                         input buf_pl-gds.pl-code ,
     3594                         input buf_pl-gds.gds-code ,
     3595                         input ( if available prev_rvs-doc then prev_rvs-doc.rvs-code else ? ) ,
     3596                         input cur_shift-obj.shift-date ,
     3597                         input cur_shift-obj.shift-num ) no-error .
     3598         if error-status :error then do:
     3599            message "Ошибка при создании линии."
     3600                    return-value
     3601            view-as alert-box error.
     3602            undo tr, return error.
     3603         end.
     3604   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslnp in g#lib-rvs ( input  r-doc.obj-type ,
     3605                         input  r-doc.obj-code ,
     3606                         input  r-doc.rvs-code ,
     3607                         input  r-doc.rvs-type ,
     3608                         input  buf_pl-gds.pl-code ,
     3609                         input  buf_pl-gds.gds-code ,
     3610                         input  yes ,
     3611                         input  ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     3612                         input  cur_shift-obj.shift-date ,
     3613                         input cur_shift-obj.shift-num ,
     3614                         input ( if available prev_icnt-doc then prev_icnt-doc.doc-code else ? ) ,
     3615                         input yes ) no-error .
     3616         if error-status :error then do:
     3617            message "Ошибка при создании строки данных по ТРК. " skip
     3618            return-value
     3619            error-status :get-message( 1 )
     3620            view-as alert-box.
     3621            undo tr, return error.
     3622         end.
     3623       end.
     3624     end.
     3625   end procedure.
     3626   procedure mode-on :
     3627   define variable v-shift-date like ub.shift-obj.shift-date no-undo.
     3628   define variable v-shift-num  like ub.shift-obj.shift-num  no-undo.
     3629   define variable v-shift-name as   character               no-undo.
     3630   define variable v-obj-date   as   date                    no-undo.
     3631   if pardoc-mode = 'ДОБАВЛЕНИЕ':U or
     3632      pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
     3633      find first cur_shift-obj
     3634           where cur_shift-obj.obj-type = v-cntxt-obj-type
     3635             and cur_shift-obj.obj-code = v-cntxt-obj-code
     3636             and cur_shift-obj.status_  = 'тек':U
     3637             use-index pi no-lock no-error .
     3638      if not available cur_shift-obj then do:
     3639         message "Нет открытой смены на объекте " v-cntxt-obj-type
     3640                                                  v-cntxt-obj-code
     3641         view-as alert-box error.
     3642         return error.
     3643      end.
