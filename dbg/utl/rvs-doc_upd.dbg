     4764                         input yes ) no-error .
     4765     find first r-doc where recid( r-doc ) = parrvs-rec.
     4766     run ui-on in this-procedure .
     4767   end procedure.
     4768   procedure proc_m-meas-3 :
     4769   define buffer meas-place for ub.place.
     4770   if available ub.rvs-line then do:
     4771      assign rvs-line-rec      = recid(ub.rvs-line)
     4772             rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     4773      find meas-place where meas-place.obj-type = ub.rvs-line.obj-type and
     4774                            meas-place.obj-code = ub.rvs-line.obj-code and
     4775                            meas-place.pl-code  = ub.rvs-line.pl-code  no-lock.
     4776      if meas-place.is-meas <> yes then do:
     4777         message "Резервуар " meas-place.pl-code " не измеряется приборами. "
     4778         view-as alert-box error.
     4779         return error.
     4780      end.
     4781      if meas-place.loc1 = "" or meas-place.loc1 = ? then do:
     4782         message "Не указан локальный код на складском месте " meas-place.pl-code
     4783         view-as alert-box error.
     4784         return error.
     4785      end.
     4786      for each tt-meas:
     4787          delete tt-meas.
     4788      end.
