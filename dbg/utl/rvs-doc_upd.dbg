     3950                     ,  input "b-sel"
     3951                     ,  input 'чел':U
     3952                     ,  input ?
     3953                     ,  input ?
     3954                     ,  input v-ref-rec
     3955                     ,  input ",,,,,,NO"
     3956                     ,  input "lock-cli-type"
     3957                     , output ref-list ) .
     3958       assign v-ref-rec24 = integer( ref-list ).
     3959       v-ref-rec = integer( ref-list ) .
     3960       find cli-buf where recid (cli-buf) =
     3961          v-ref-rec
     3962          no-lock no-error.
     3963       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3964         find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3965                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3966     end.
     3967     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3968       display cli-buf.obj-code @ r-doc.agnt
     3969               cli-buf.obj-name @ agnt-name with frame d-rvs.
     3970       assign frame d-rvs r-doc.agnt.
     3971     end.
     3972     else display ? @ r-doc.agnt
     3973                  ? @ agnt-name with frame d-rvs.
     3974     apply "entry" to r-doc.boss
     3975                               in frame d-rvs.
     3976   if available cli-buf then do:
     3977         display cli-buf.obj-code @ r-doc.agnt cli-buf.obj-name @ agnt-name with frame d-rvs.
     3978     end.
     3979     else display ? @ r-doc.agnt ? @ agnt-name with frame d-rvs.
     3980         return no-apply.
     3981   end.
