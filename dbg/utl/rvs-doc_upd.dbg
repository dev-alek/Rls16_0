     4214   procedure plgdsfnd :
     4215     define input  parameter p-chk-and-chs    as logical               no-undo .
     4216     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     4217     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     4218     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     4219     define output parameter p-reserv-pl-code as   logical             no-undo .
     4220     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     4221     define buffer buf_goods         for ub.goods .
     4222     define buffer buf_pl-gds        for ub.pl-gds .
     4223     define buffer buf_second_pl-gds for ub.pl-gds .
     4224     find first buf_goods no-lock where
     4225                buf_goods.gds-code = p-gds-code no-error .
     4226     if not available buf_goods
     4227     then do:
     4228       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     4229     end.
     4230   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4232     (input  p-obj-type
     4233     ,input  p-obj-code
     4234     ,input  buf_goods.artic
     4235     ,input  buf_goods.prod-type
     4236     ,input  buf_goods.prod-code
     4237     ,input  'place-rsrv=request'
     4238     ,output p-reserv-pl-code
     4239     ) no-error .
     4240     if error-status :error
     4241     then do:
     4242       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     4243     end.
     4244     if p-reserv-pl-code = no
     4245     then do:
     4246       return .
     4247     end.
     4248     if p-chk-and-chs <> yes
     4249     then do:
     4250       return .
     4251     end.
     4252     find first buf_pl-gds no-lock where
     4253                buf_pl-gds.obj-type = p-obj-type and
     4254                buf_pl-gds.obj-code = p-obj-code and
     4255                buf_pl-gds.gds-code = p-gds-code no-error .
     4256     if not available buf_pl-gds
     4257     then do:
     4258       return error "К товару не привязано ни одного места хранения" .
     4259     end.
     4260     find first buf_second_pl-gds no-lock where
     4261                buf_second_pl-gds.obj-type  = p-obj-type          and
     4262                buf_second_pl-gds.obj-code  = p-obj-code          and
     4263                buf_second_pl-gds.gds-code  = p-gds-code          and
     4264                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     4265     if not available buf_second_pl-gds
     4266     then do:
     4267       assign
     4268         p-pl-code = buf_pl-gds.pl-code
     4269       .
     4270     end.
     4271     else do:
     4272       run str/plgdssel.p
     4273         (
     4274            input parparentproc
     4275         ,  input p-obj-type
     4276         ,  input p-obj-code
     4277         ,  input p-gds-code
     4278         , output p-pl-code
     4279         ) no-error .
     4280       if error-status :error
     4281       then do:
     4282         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     4283                                , 'plgdssel.p':U
     4284                                , chr(10)
     4285                                , error-status :get-message( 1 )
     4286                                , return-value
     4287                                ) .
     4288       end.
     4289       if p-pl-code = ? or
     4290          p-pl-code = 0
     4291       then do:
     4292         return error "Не выбрано место хранения " + chr(10) .
     4293       end.
     4294     end.
     4295   end procedure.
     4296   procedure doc-plsh:
     4297     define buffer buf_trn-doc  for ub.trn-doc.
     4298     define buffer buf_doc-pl   for ub.doc-pl.
     4299     define buffer buf_rvs-line for ub.rvs-line.
     4300     for each buf_trn-doc no-lock
     4301       where buf_trn-doc.obj-type   = r-doc.obj-type
     4302         and buf_trn-doc.obj-code   = r-doc.obj-code
     4303         and buf_trn-doc.shift-date = r-doc.shift-date
     4304         and buf_trn-doc.shift-num  = r-doc.shift-num
     4305     on error undo, return error return-value
     4306     :
     4307       for each buf_doc-pl no-lock
     4308         where buf_doc-pl.out-code = buf_trn-doc.doc-code
     4309       on error undo, return error return-value
     4310       :
     4311         find first buf_rvs-line no-lock
     4312           where buf_rvs-line.rvs-code = r-doc.rvs-code
     4313             and buf_rvs-line.obj-type = r-doc.obj-type
     4314             and buf_rvs-line.obj-code = r-doc.obj-code
     4315             and buf_rvs-line.pl-code  = buf_doc-pl.pl-code
     4316             and buf_rvs-line.gds-code = buf_doc-pl.gds-code
     4317           no-error.
     4318         if not available buf_rvs-line then do:
     4319           tr:
     4320           do transaction
     4321           on error undo tr, return error return-value
     4322           :
     4323   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input r-doc.obj-type ,
     4324                         input r-doc.obj-code ,
     4325                         input r-doc.rvs-code ,
     4326                         input r-doc.rvs-type ,
     4327                         input buf_doc-pl.pl-code ,
     4328                         input buf_doc-pl.gds-code ,
     4329                         input ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     4330                         input cur_shift-obj.shift-date ,
     4331                         input cur_shift-obj.shift-num ) no-error .
     4332             if error-status :error then do:
     4333               message 'Ошибка при создании линии.' skip
     4334                       return-value
     4335                       error-status :get-message( 1 )
     4336               view-as alert-box error.
     4337               undo tr, return error.
     4338             end.
     4339   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslnp in g#lib-rvs ( input  r-doc.obj-type ,
     4340                         input  r-doc.obj-code ,
     4341                         input  r-doc.rvs-code ,
     4342                         input  r-doc.rvs-type ,
     4343                         input  buf_doc-pl.pl-code ,
     4344                         input  buf_doc-pl.gds-code ,
     4345                         input  yes ,
     4346                         input  ( if available prev_rvs-doc  then prev_rvs-doc.rvs-code  else ? ) ,
     4347                         input  cur_shift-obj.shift-date ,
     4348                         input cur_shift-obj.shift-num ,
     4349                         input ( if available prev_icnt-doc then prev_icnt-doc.doc-code else ? ) ,
     4350                         input yes ) no-error .
     4351             if error-status :error then do:
     4352               message 'Ошибка при создании строки данных по ТРК.' skip
     4353                       return-value
     4354                       error-status :get-message(1)
     4355               view-as alert-box.
     4356               undo tr, return error.
     4357             end.
     4358           end.
     4359         end.
     4360       end.
     4361     end.
     4362   end procedure.
     4363   procedure local-add :
     4364      assign notes = "".
     4365      run str/chs-gds.w
     4366        ( input        parparentproc
     4367         ,input        r-doc.obj-type
     4368         ,input        r-doc.obj-code
     4369         ,input        '':U
     4370         ,input        r-doc.status_
     4371         ,input        "Строка ДС № " + r-doc.rvs-code + " " + r-doc.status_
     4372         ,input        'все':U
     4373         ,input        ?
     4374         ,input        ?
     4375         ,input        r-doc.host-code
     4376         ,input        ?
     4377         ,input-output varartic
     4378         ,output       notes
     4379        ).
     4380      run cycle-add in this-procedure .
     4381   end procedure.
     4382   procedure local-chg:
     4383   define buffer buf_goods for ub.goods.
     4384   assign rvs-line-rec = recid(ub.rvs-line)
     4385          rvs-line-pump-rec = (if available ub.rvs-line-pump then recid(ub.rvs-line-pump) else ?).
     4386     case r-doc.rvs-type
     4387     :
     4388       when 'перед_док':U
     4389       or when 'после_док':U
     4390       then do:
     4391   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4392   do:
     4393     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4394       (input  v-cntxt-db-num
     4395       ,input  v-cntxt-userid
     4396       ,input  0
     4397       ,input  'actn_rvs-on-doc_upd-revision':U
     4398       ,input  'object':U
     4399       ,input  r-doc.host-code
     4400       ,input  r-doc.obj-type
     4401       ,input  r-doc.obj-code
     4402       ,input  0
     4403       ,input  0
     4404       ,input  0
     4405       ,input  true
     4406       ,output varlog
     4407       )  .
     4408   end.
     4409       end.
     4410       when 'смена':U
     4411       then do:
     4412   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4413   do:
