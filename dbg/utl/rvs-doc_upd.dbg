        1   define input        parameter parparentproc as handle    no-undo .
        2   define input        parameter pardoc-mode   as character no-undo .
        3   define input        parameter parrvs-type   as character no-undo .
        4   define input        parameter parall-place  as logical   no-undo .
        5   define input-output parameter parrvs-rec    as recid     no-undo .
        6   define variable        varlog            as   logical                    no-undo.
        7   define variable vss-revision    as character no-undo initial "$Revision$":U.
        8   define variable vss-author      as character no-undo initial "$Author$":U.
        9   define variable vss-date        as character no-undo initial "$Date$":U.
       10   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       11   define variable vss-archive     as character no-undo initial "$Archive$":U.
