     3938   procedure local-psn-chk:
     3939   define input parameter parman    as character no-undo.
     3940   define input parameter paraction as character no-undo.
     3941   if parman = "agnt" and paraction = "ret-mouse" then do:
     3942     define variable v-ref-rec24   as recid no-undo .
     3943     find cli-buf where cli-buf.obj-code = input frame d-rvs r-doc.agnt
     3944                    and cli-buf.obj-type = 'чел':U no-lock no-error.
