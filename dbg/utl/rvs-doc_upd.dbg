     4750                                     buf_goods.prod-type                   + " " +
     4751                                     string( buf_goods.prod-code )         +
     4752               " складское место " + string( ub.rvs-line-pump.pl-code )   +
     4753               " ТРК "             + string( ub.rvs-line-pump.pump-code ) +
     4754               " пистолет "        + string( ub.rvs-line-pump.nozzle-code )
     4755       ) no-error.
     4756     if error-status :error then do:
     4757       message "Ошибка при редактировании данных по ТРК." skip
     4758               return-value skip
     4759               error-status :get-message( 1 )
     4760       view-as alert-box error.
