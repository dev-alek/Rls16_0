        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: pr-u9.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: utl/pr-u9.p $":U .
       13   define variable vss-description as character no-undo init "".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable g#log as logical   no-undo .
       69   define variable g#ok as integer   no-undo .
       70   define variable v-exist as logical no-undo init false .
       71   define variable bbb as integer   no-undo .
       72   define variable rr as recid     no-undo .
       73   define variable str as character no-undo .
       74   g#log =  session:SET-WAIT-STATE("GENERAL") .
       75   define buffer buf_price-doc for price-doc.
       76   define buffer buf1_price-list for price-list.
       77   on WRITE of price-list override do: end.
       78   for each gds-obj no-lock where gds-obj.price-sale  <> 0
       79       break by gds-obj.obj-type by gds-obj.obj-code :
       80       if first-of (gds-obj.obj-code) then do:
       81           g#ok = 0.
       82          find first buf_price-doc no-lock where buf_price-doc.doc-num = "2-"+ gds-obj.obj-type + string(gds-obj.obj-code) no-error .
       83          if error-status :error then find first buf_price-doc no-lock where buf_price-doc.obj-type =  gds-obj.obj-type and buf_price-doc.obj-code = gds-obj.obj-code no-error .
       84          create price-doc.
       85          BUFFER-COPY buf_price-doc TO price-doc
       86          assign
       87            price-doc.doc-num = "3-"+ gds-obj.obj-type + string(gds-obj.obj-code)
       88            price-doc.status_  = 'новый':U
       89            price-doc.fact-num = 0
       90            price-doc.fact-order = 0
       91            price-doc.fact-date  = ?
       92            price-doc.creid  = "TradeHouse"
       93            price-doc.cr-db-num  =  0
       94            price-doc.ps  =  "Дополнение к обрезанию"
       95          .
       96       end.
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
       98     (input  gds-obj.gds-code
       99     ,input  ?
      100     ,output bbb
      101     ) no-error .
      102       find first buf1_price-list exclusive-lock  where
      103                  buf1_price-list.obj-type  = gds-obj.obj-type and
      104                  buf1_price-list.obj-code  = gds-obj.obj-code and
      105                  buf1_price-list.b-code    =  bbb and
      106                  buf1_price-list.price-type =  "" and
      107                  buf1_price-list.fact-order > 1  and
      108                  buf1_price-list.artic     = gds-obj.artic    and
      109                  buf1_price-list.prod-type = gds-obj.prod-type and
      110                  buf1_price-list.prod-code = gds-obj.prod-code no-error .
      111       if not available buf1_price-list then do:
      112           g#ok = g#ok + 1.
      113           find first price-doc no-lock where price-doc.doc-num = "3-"+ gds-obj.obj-type + string(gds-obj.obj-code) no-error .
      114           if error-status :error then message error-status :get-message(1) 123 view-as alert-box .
      115           create price-list.
      116           assign
      117             price-list.doc-num       =  price-doc.doc-num
      118             price-list.b-code        =  bbb
      119             price-list.calc-method   =  ""
      120             price-list.artic         =  gds-obj.artic
      121             price-list.prod-code     =  gds-obj.prod-code
      122             price-list.prod-type     =  gds-obj.prod-type
      123             price-list.d-pcnt        =  0
      124             price-list.doc-qnty      =  0
      125             price-list.excise        =  0
      126             price-list.fact-order    =  0
      127             price-list.line-num      =  g#ok
      128             price-list.main-price    =  true
      129             price-list.obj-code      =  gds-obj.obj-code
      130             price-list.obj-type      =  gds-obj.obj-type
      131             price-list.price-calc    =  0
      132             price-list.price-prev    =  0
      133             price-list.price-sale    =  gds-obj.price-sale
      134             price-list.price-type    =  ""
      135             price-list.road-tax      =  0
      136             no-error .
      137   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      139     (input  gds-obj.gds-code
      140     ,input  '1':U
      141     ,input  ?
      142     ,input  price-doc.host-code
      143     ,input  price-doc.obj-type
      144     ,input  price-doc.obj-code
      145     ,output price-list.vat-pc
      146     ) no-error .
      147                   if error-status :error
      148                   then do:
      149                    message error-status :get-message(1) 33
      150                    view-as alert-box .
      151                   end.
      152   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      154     (input  gds-obj.gds-code
      155     ,input  '2':U
      156     ,input  ?
      157     ,input  price-doc.host-code
      158     ,input  price-doc.obj-type
      159     ,input  price-doc.obj-code
      160     ,output price-list.slt-pc
      161     ) no-error .
      162                   if error-status :error
      163                   then do:
      164                    message error-status :get-message(1) 444
      165                    view-as alert-box .
      166                   end.
      167       end.
      168       if last-of (gds-obj.obj-code) then do:
      169          if g#ok = 0 then do:
      170          end.
      171          else str = str + price-doc.doc-num  + " " .
      172          g#ok = 0 .
      173       end.
      174   g#log =  session:SET-WAIT-STATE("") .
      175   end.
      176   message "ВСЕ готово" str view-as alert-box .
