        1   block-level on error undo, throw.
        2   define input parameter p-mode   as character        no-undo.
        3   on write of ub.gds-grp     override do: end.
        4   on write of ub.goods       override do: end.
        5   on write of ub.gds-obj     override do: end.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: ini-grp.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: utl/ini-grp.p $":U .
       11   define variable vss-description as character no-undo init "Инициализация полных имен групп в goods, gds-obj".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   define temp-table temp_grplib_grp no-undo
       84       field sel           as character
       85       field nabor         as character
       86       field full-name     as character
       87       field print-code    as character
       88       field sort-name     as character
       89       field node-code     as integer
       90       field upper-code    as integer
       91       field calc-method   as character
       92       field round-method  as character
       93       field increase-pc   as decimal
       94       field min-marg      as character
       95       field max-marg      as character
       96       field cli-type      as character
       97       field cli-code      as integer
       98       field notcorr      as character
       99       field name          as character
      100       field level         as integer
      101       field mark          as character
      102       index pi is primary unique sort-name
      103       index fn full-name
      104       index nc is unique node-code
      105       index sl sel
      106       index uc upper-code
      107   .
      108   define temp-table temp_grplib_found-grp no-undo
      109       field full-name   as character
      110       field sort-name   as character
      111       field node-code   as integer
      112       field level       as integer
      113       field is-terminal as logical
      114       index pi is primary unique sort-name
      115       index fn full-name
      116       index lv level
      117       index it is-terminal
      118   .
      119   define temp-table temp_found-result-nodelist no-undo
      120       field node-code     as recid
      121       field processed     as logical
      122       field sort-name     as character
      123       field full-name     as character
      124       index pi is primary unique node-code
      125       index ps processed
      126   .
      127   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      128   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      129   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      130   procedure grplib-get-parameters :
      131   define input parameter p-store-type     as character        no-undo.
      132   define input parameter p-store-code     as integer          no-undo.
      133   do
      134   on error undo, return error
      135   :
      136       assign
      137           v-grplib-not-fill-extra-info = no
      138       .
      139   end.
      140   end procedure.
      141   procedure grplib-get-sort-name :
      142   do
      143   on error undo, return error
      144   :
      145   define input parameter p-node-code  as integer      no-undo.
      146   define output parameter p-sort-name as character    no-undo.
      147       define variable v-upper-code    as integer           no-undo.
      148       define buffer buf_gds-grp       for ub.gds-grp.
      149       define buffer buf_upper_gds-grp for ub.gds-grp.
      150       find first buf_gds-grp no-lock
      151            where buf_gds-grp.node-code = p-node-code
      152       no-error.
      153       if not available buf_gds-grp
      154       then do:
      155           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      156       end.
      157       assign
      158           p-sort-name  = ""
      159           v-upper-code = 1
      160       .
      161       do while buf_gds-grp.upper-code <> 0
      162       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      163       :
      164           assign
      165               p-sort-name  = buf_gds-grp.node-name
      166                            + (if p-sort-name <> "" then chr(2) else "")
      167                            + p-sort-name
      168               v-upper-code = buf_gds-grp.upper-code
      169           .
      170           find first buf_gds-grp no-lock
      171                where buf_gds-grp.node-code = v-upper-code
      172           no-error.
      173           if not available buf_gds-grp
      174           then do:
      175               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      176                                   + string( v-upper-code )
      177                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      178           end.
      179       end.
      180   end.
      181   end procedure.
      182   define variable vss-include-info1 as character format "X(65)" no-undo
      183   initial "@(#)$Workfile$ $Revision$".
      184   procedure grplib-get-full-name :
      185      define input parameter p-node-code  as integer      no-undo.
      186      define output parameter p-full-name as character    no-undo.
      187      do
      188   on error undo, return error
      189   :
      190       define variable v-upper-code    as integer           no-undo.
      191       define buffer buf_gds-grp       for ub.gds-grp.
      192       define buffer buf_upper_gds-grp for ub.gds-grp.
      193       find first buf_gds-grp no-lock
      194            where buf_gds-grp.node-code = p-node-code
      195       no-error.
      196       if not available buf_gds-grp
      197       then do:
      198           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      199       end.
      200       assign
      201           p-full-name  = ""
      202           v-upper-code = 1
      203       .
      204       do while buf_gds-grp.upper-code <> 0
      205       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      206       :
      207           assign
      208               p-full-name  = buf_gds-grp.node-name
      209                            + (if p-full-name <> "" then chr(47) else "")
      210                            + p-full-name
      211               v-upper-code = buf_gds-grp.upper-code
      212           .
      213           find first buf_gds-grp no-lock
      214                where buf_gds-grp.node-code = v-upper-code
      215           no-error.
      216           if not available buf_gds-grp
      217           then do:
      218               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      219                                   + string( v-upper-code )
      220                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      221           end.
      222       end.
      223       assign
      224       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      225       .
      226   end.
      227   end .
      228   procedure grplib-get-node-from-full-name :
      229   define input parameter p-full-name as character no-undo .
      230   define output parameter p-node-code as integer no-undo .
      231   define variable v-ii as integer no-undo .
      232   define variable v-upper-code as integer no-undo .
      233   define variable v-root-code as integer no-undo .
      234   define variable v-entry as character no-undo .
      235   define buffer buf_gds-grp       for ub.gds-grp.
      236   do
      237   on error undo, return error
      238   :
      239     find first buf_gds-grp no-lock
      240         where buf_gds-grp.upper-code = 0
      241     no-error .
      242     if not available buf_gds-grp
      243     then do:
      244         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      245     end.
      246     else do:
      247       assign
      248       v-root-code = buf_gds-grp.node-code
      249       .
      250     end.
      251     v-upper-code = v-root-code.
      252     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      253       assign
      254       v-entry = entry(v-ii, p-full-name, chr(47)).
      255       if v-entry = '' then leave.
      256       find first buf_gds-grp no-lock where
      257                 buf_gds-grp.node-name = v-entry
      258             and buf_gds-grp.upper-code = v-upper-code
      259             no-error.
      260       if not available buf_gds-grp then do:
      261         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      262       end.
      263       else do:
      264         p-node-code = buf_gds-grp.node-code.
      265         v-upper-code = buf_gds-grp.node-code.
      266       end.
      267     end.
      268   end.
      269   end .
      270   procedure grplib-get-root-code :
      271   do
      272   on error undo, return error
      273   :
      274   define output parameter p-root-code as integer      no-undo.
      275       define buffer buf_gds-grp       for ub.gds-grp.
      276       find first buf_gds-grp no-lock
      277           where buf_gds-grp.upper-code = 0
      278       no-error .
      279       if not available buf_gds-grp
      280       then do:
      281           undo, return error .
      282       end.
      283       else do:
      284           assign
      285               p-root-code = buf_gds-grp.node-code
      286           .
      287       end.
      288   end.
      289   end procedure.
      290   procedure grplib-find-grp-by-full-name :
      291   do
      292   on error undo, return error
      293   :
      294   define input parameter p-search-name  as character    no-undo.
      295   define input parameter p-fill-path    as logical      no-undo.
      296   define output parameter p-found       as logical      no-undo.
      297       define variable v-upper-code    as integer          no-undo.
      298       define variable v-counter       as integer           no-undo.
      299       define variable v-level         as integer           no-undo.
      300       define variable v-full-name     as character         no-undo.
      301       define variable v-sort-name     as character         no-undo.
      302       define buffer buf_gds-grp       for ub.gds-grp.
      303       assign
      304           p-search-name = replace( p-search-name, chr(47), chr(2) )
      305       .
      306       run grplib-get-root-code ( output v-upper-code ) no-error .
      307       if error-status :error
      308       then do:
      309           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      310       end.
      311       assign
      312           v-full-name  = ""
      313           v-level      = num-entries( p-search-name, chr(2) )
      314       .
      315       for each temp_grplib_found-grp
      316       :
      317           delete temp_grplib_found-grp.
      318       end.
      319       start-name-analyze:
      320       do v-counter = 1 to v-level
      321       :
      322           if v-counter < v-level
      323           then do:
      324               find first buf_gds-grp no-lock
      325                    where buf_gds-grp.upper-code = v-upper-code
      326                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      327               no-error .
      328               if not available buf_gds-grp
      329               then do:
      330                   assign
      331                       v-full-name  = p-search-name
      332                       v-sort-name  = p-search-name
      333                   .
      334                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      335               end.
      336               else do:
      337                   assign
      338                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      339                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      340                       v-upper-code = buf_gds-grp.node-code
      341                   .
      342                   if p-fill-path = yes
      343                   then do:
      344                       create temp_grplib_found-grp.
      345                       assign
      346                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      347                           temp_grplib_found-grp.sort-name = v-sort-name
      348                           temp_grplib_found-grp.node-code = v-upper-code
      349                           temp_grplib_found-grp.level     = v-counter
      350                       .
      351                   end.
      352               end.
      353           end.
      354           else do:
      355               for each buf_gds-grp no-lock
      356                  where buf_gds-grp.upper-code = v-upper-code
      357                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      358               :
      359                   assign
      360                       p-found = yes
      361                   .
      362                   create temp_grplib_found-grp.
      363                   assign
      364                       temp_grplib_found-grp.full-name = v-full-name
      365                                                           + (if v-full-name = "" then "" else chr(47) )
      366                                                           + buf_gds-grp.node-name + chr(47)
      367                       temp_grplib_found-grp.sort-name = v-sort-name
      368                                                           + ( if v-sort-name = "" then "" else chr(2) )
      369                                                           + buf_gds-grp.node-name
      370                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      371                       temp_grplib_found-grp.level     = v-level
      372                   .
      373               end.
      374               if p-found = no
      375               then do:
      376                   assign
      377                       v-full-name  = p-search-name
      378                       v-sort-name  = p-search-name
      379                   .
      380                   for each temp_grplib_found-grp
      381                   :
      382                       delete temp_grplib_found-grp.
      383                   end.
      384                   assign
      385                       p-found = no
      386                   .
      387               end.
      388           end.
      389       end.
      390   end.
      391   end procedure.
      392   procedure grplib-find-all-subgroup :
      393   do
      394   on error undo, return error
      395   :
      396   define input parameter p-start-node-code    as integer      no-undo.
      397   define input parameter p-terminal-only      as logical      no-undo.
      398       define variable v-start-full-name   as character     no-undo.
      399       define variable v-start-sort-name   as character     no-undo.
      400       define variable v-not-found         as logical       no-undo.
      401       define variable v-is-terminal       as logical       no-undo.
      402       define buffer buf_gds-grp           for ub.gds-grp.
      403       create temp_found-result-nodelist.
      404       assign
      405           temp_found-result-nodelist.node-code = p-start-node-code
      406           temp_found-result-nodelist.processed = no
      407       .
      408       run grplib-get-full-name in this-procedure (
      409             input p-start-node-code
      410           , output v-start-full-name
      411       ).
      412       run grplib-get-full-name in this-procedure (
      413             input p-start-node-code
      414           , output v-start-sort-name
      415       ).
      416       process-nodes:
      417       do while yes
      418       :
      419           find first temp_found-result-nodelist
      420                where temp_found-result-nodelist.node-code = p-start-node-code
      421           .
      422           assign
      423               temp_found-result-nodelist.processed = yes
      424           .
      425           for each buf_gds-grp no-lock
      426              where buf_gds-grp.upper-code = p-start-node-code
      427           on error undo, return error
      428           :
      429               run grplib-is-terminal in this-procedure (
      430                     input buf_gds-grp.node-code
      431                   , output v-is-terminal
      432               ).
      433               if v-is-terminal = yes
      434               then do:
      435                   create temp_grplib_found-grp.
      436                   assign
      437                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      438                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      439                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      440                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      441                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      442                       temp_grplib_found-grp.is-terminal = yes
      443                   .
      444               end.
      445               else do:
      446                   create temp_found-result-nodelist.
      447                   assign
      448                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      449                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      450                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      451                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      452                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      453                       temp_found-result-nodelist.processed = no
      454                   .
      455                   if p-terminal-only = no
      456                   then do:
      457                       create temp_grplib_found-grp.
      458                       assign
      459                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      460                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      461                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      462                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      463                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      464                           temp_grplib_found-grp.is-terminal = no
      465                       .
      466                   end.
      467               end.
      468           end.
      469           find first temp_found-result-nodelist
      470                where temp_found-result-nodelist.processed = no
      471           no-error.
      472           if not available temp_found-result-nodelist
      473           then do:
      474               leave process-nodes.
      475           end.
      476           else do:
      477               assign
      478                   p-start-node-code = temp_found-result-nodelist.node-code
      479                   v-start-full-name = temp_found-result-nodelist.full-name
      480                   v-start-sort-name = temp_found-result-nodelist.sort-name
      481               .
      482           end.
      483       end.
      484   end.
      485   end procedure.
      486   procedure grplib-expand-name :
      487   define input parameter p-start-name as character        no-undo.
      488   define output parameter p-end-name  as character        no-undo.
      489       define variable v-is-terminal   as logical      no-undo.
      490       define variable v-found         as character    no-undo.
      491       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      492   do
      493   for buf_temp_grplib_found-grp
      494   on error undo, return error
      495   :
      496       run grplib-find-grp-by-full-name in this-procedure (
      497             input p-start-name
      498           , input no
      499           , output v-found
      500       ) no-error.
      501       run grplib-get-max-substring in this-procedure (
      502                   input length( p-start-name )
      503                 , output p-end-name
      504       ) no-error .
      505       if error-status :error
      506       then do:
      507           assign
      508               p-end-name = ""
      509           .
      510       end.
      511       else do:
      512           find first temp_grplib_found-grp
      513               where temp_grplib_found-grp.full-name = p-end-name
      514           no-error.
      515           if available temp_grplib_found-grp
      516           then do:
      517               find first buf_temp_grplib_found-grp
      518                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      519                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      520               no-error.
      521               if not available buf_temp_grplib_found-grp
      522               then do:
      523                   run grplib-is-terminal in this-procedure (
      524                       input temp_grplib_found-grp.node-code
      525                       , output v-is-terminal
      526                   ).
      527               end.
      528           end.
      529       end.
      530   end.
      531   end procedure.
      532   procedure grplib-get-max-substring :
      533   do
      534   on error undo, return error
      535   :
      536   define input parameter p-min-substring-length   as integer      no-undo.
      537   define output parameter p-substring             as character    no-undo.
      538           define variable v-char-counter  as integer           no-undo.
      539           define variable v-current-char  as character         no-undo.
      540           define variable v-names-counter  as integer           no-undo.
      541           define variable v-base-string   as character         no-undo.
      542           assign
      543               v-char-counter  = p-min-substring-length
      544           .
      545           find first temp_grplib_found-grp no-error.
      546           if not available temp_grplib_found-grp
      547           then do:
      548               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      549           end.
      550           else do:
      551               assign
      552                   v-base-string  = temp_grplib_found-grp.full-name
      553                   v-char-counter = 0
      554               .
      555               counter-block:
      556               do while yes
      557               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      558               :
      559                   assign
      560                       v-char-counter  = v-char-counter + 1
      561                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      562                       v-names-counter = 0
      563                   .
      564                   compare-block:
      565                   for each temp_grplib_found-grp
      566                   :
      567                       assign
      568                           v-names-counter = v-names-counter + 1
      569                       .
      570                       if v-names-counter = 1
      571                       then do:
      572                           next compare-block.
      573                       end.
      574                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      575                       then do:
      576                           leave counter-block.
      577                       end.
      578                   end.
      579                   if v-names-counter = 1
      580                   then do:
      581                       assign
      582                           p-substring = v-base-string
      583                       .
      584                       return.
      585                   end.
      586               end.
      587               assign
      588                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      589               .
      590           end.
      591   end.
      592   end procedure.
      593   procedure grplib-is-terminal :
      594   do
      595   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      596   :
      597   define input parameter p-node-code      as integer      no-undo.
      598   define output parameter p-is-terminal   as logical      no-undo.
      599       define buffer buf_gds-grp       for ub.gds-grp.
      600       find first buf_gds-grp no-lock
      601           where buf_gds-grp.upper-code = p-node-code
      602       no-error .
      603       if not available buf_gds-grp
      604       then do:
      605           assign
      606               p-is-terminal = yes
      607           .
      608       end.
      609       else do:
      610           assign
      611               p-is-terminal = no
      612           .
      613       end.
      614   end.
      615   end procedure.
      616   procedure grplib-have-goods :
      617   do
      618   on error undo, return error
      619   :
      620   define input parameter p-node-code      as integer      no-undo.
      621   define output parameter p-have-goods   as logical      no-undo.
      622       define buffer buf_goods         for ub.goods.
      623       find first buf_goods no-lock
      624            where buf_goods.grp-code = p-node-code
      625       no-error .
      626       if available buf_goods
      627       then do:
      628           assign
      629               p-have-goods = yes
      630           .
      631       end.
      632       else do:
      633           assign
      634               p-have-goods = no
      635           .
      636       end.
      637   end.
      638   end procedure.
      639   procedure grplib-find-by-substring :
      640   do
      641   on error undo, return error
      642   :
      643   define input parameter p-start-code         as integer      no-undo.
      644   define input parameter p-full-search-string as character    no-undo.
      645   define output parameter p-found-code        as integer      no-undo.
      646   define output parameter p-full-name         as character    no-undo.
      647       define variable v-start-code     as integer           no-undo.
      648       define variable v-found          as logical  init no  no-undo.
      649       define buffer buf_gds-grp       for ub.gds-grp.
      650       search-grp:
      651       for each buf_gds-grp no-lock
      652           where buf_gds-grp.node-code > p-start-code
      653       :
      654           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      655           then do:
      656               assign
      657                   p-found-code = buf_gds-grp.node-code
      658                   v-found      = yes
      659               .
      660               run grplib-get-full-name in this-procedure (
      661                     input p-found-code
      662                   , output p-full-name
      663               ) no-error .
      664               if error-status :error
      665               then do:
      666                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      667               end.
      668               leave search-grp.
      669           end.
      670       end.
      671       if v-found = yes
      672       then do:
      673       end.
      674       else do:
      675           assign
      676               p-full-name  = ""
      677               p-found-code = 0
      678           .
      679       end.
      680   end.
      681   end procedure.
      682   procedure grplib-analyze-grp-name :
      683   do
      684   on error undo, return error
      685   :
      686   define input parameter p-grp-name       as character            no-undo.
      687   define input parameter p-upper-code     as integer              no-undo.
      688   define output parameter p-error-message as character init ""    no-undo.
      689       define variable v-char-list     as character    no-undo.
      690       define variable v-char-counter  as integer      no-undo.
      691       define variable v-full-name     as character    no-undo.
      692       if p-grp-name = "" then do:
      693           assign
      694               p-error-message = "Название группы не может быть пустым.".
      695           .
      696       end.
      697       else do:
      698           assign
      699               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      700           .
      701           do v-char-counter = 1 to num-entries( v-char-list )
      702           :
      703               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      704               then do:
      705                   assign
      706                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      707                   .
      708                   return.
      709               end.
      710           end.
      711           if p-upper-code > 0
      712           then do:
      713               run grplib-get-full-name in this-procedure (
      714                     input p-upper-code
      715                   , output v-full-name
      716               ) no-error .
      717               if error-status :error
      718               then do:
      719                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      720               end.
      721               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      722               then do:
      723                   assign
      724                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      725                   .
      726               end.
      727           end.
      728       end.
      729   end.
      730   end procedure.
      731   procedure grplib-get-lvl-num :
      732   define input parameter p-node-code  as integer      no-undo.
      733   define output parameter p-lvl-num   as integer      no-undo.
      734       define variable v-full-name    as character    no-undo.
      735   do
      736   on error undo, return error
      737   :
      738       run grplib-get-full-name in this-procedure (
      739             input p-node-code
      740           , output v-full-name
      741       ).
      742       assign
      743           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      744       .
      745       if p-lvl-num = -1
      746       then do:
      747           assign
      748               p-lvl-num = 0
      749           .
      750       end.
      751   end.
      752   end procedure.
      753   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   procedure cur-time :
      755      define output parameter p-today as date      no-undo .
      756      define output parameter p-time  as integer   no-undo .
      757     do
      758     on error undo, return error
      759     :
      760       define variable v-date1 as date      no-undo .
      761       define variable v-date2 as date      no-undo .
      762       define variable v-time  as integer   no-undo .
      763       assign
      764         v-date1 = today
      765         v-time  = time
      766         v-date2 = today
      767       .
      768       if v-date1 <> v-date2
      769       then do:
      770         assign
      771           v-date1 = today
      772           v-time  = v-time
      773         .
      774       end.
      775       assign
      776         p-today = v-date1
      777         p-time  = v-time
      778       .
      779     end.
      780   end.
      781   function cur-time-date returns character
      782   :
      783     return string(today, '99/99/9999':U) .
      784   end.
      785   function cur-time-mjd returns decimal
      786   :
      787     define variable v-date as date      no-undo .
      788     define variable v-time as integer   no-undo .
      789     run cur-time in this-procedure
      790       (output v-date
      791       ,output v-time
      792       ) .
      793     return integer(v-date) - 2400002 + (v-time / 86400) .
      794   end.
      795   function cur-time-get-ending-index returns integer
      796   (input p-number as integer
      797   )
      798   :
      799     if p-number < 0
      800     or p-number = ?
      801     then do:
      802       return 1 .
      803     end.
      804     define variable v-rest as integer   no-undo .
      805     assign
      806       p-number = p-number modulo 100
      807     .
      808     if p-number < 20
      809     then do:
      810       assign
      811         v-rest = p-number
      812       .
      813     end.
      814     else do:
      815       assign
      816         v-rest = p-number modulo 10
      817       .
      818     end.
      819     case v-rest :
      820       when 1
      821       then do:
      822         return 2 .
      823       end.
      824       when 2 or
      825       when 3 or
      826       when 4
      827       then do:
      828         return 3 .
      829       end.
      830       otherwise do:
      831         return 1 .
      832       end.
      833     end case .
      834   end.
      835   procedure cur-time-mjd-to-date :
      836      define input  parameter i-mjd-diff as decimal no-undo.
      837      define output parameter o-Date     as date    no-undo.
      838      define output parameter o-Time     as integer no-undo.
      839      define variable v-day-number as integer   no-undo .
      840      if    i-mjd-diff < 0
      841         or i-mjd-diff = ?
      842      then do:
      843         return "?" .
      844      end.
      845      assign
      846         v-day-number = truncate(i-mjd-diff,0).
      847         o-Date = date(v-day-number + 2400002).
      848         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      849     .
      850   end.
      851   function cur-time-mjd-to-string returns character
      852   (input p-mjd-diff as decimal
      853   )
      854   :
      855     define variable v-day-number as integer   no-undo .
      856     define variable v-seconds    as integer   no-undo .
      857     define variable v-hour       as integer   no-undo .
      858     define variable v-min        as integer   no-undo .
      859     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      860     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      861     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      862     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      863     if p-mjd-diff < 0
      864     or p-mjd-diff = ?
      865     then do:
      866       return "?" .
      867     end.
      868     assign
      869       v-day-number = integer(truncate(p-mjd-diff,0))
      870       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      871     .
      872     if v-seconds > 86400
      873     then do:
      874       assign
      875         v-seconds = 86400 - 1
      876       .
      877     end.
      878     if v-seconds < 0
      879     then do:
      880       assign
      881         v-seconds = 0
      882       .
      883     end.
      884     assign
      885       v-hour = truncate(v-seconds / 3600, 0)
      886     .
      887     assign
      888       v-seconds = v-seconds modulo 3600
      889     .
      890     assign
      891       v-min = truncate(v-seconds / 60, 0)
      892     .
      893     assign
      894       v-seconds = v-seconds modulo 60
      895     .
      896     return
      897         (if v-day-number <> 0
      898           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      899           else ""
      900         )
      901       + (if v-day-number <> 0 or v-hour <> 0
      902           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      903           else ""
      904         )
      905       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      906           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      907           else ""
      908         )
      909       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      910       .
      911   end.
      912   function cur-time-string returns character
      913   :
      914     define variable v-date as date      no-undo .
      915     define variable v-time as integer   no-undo .
      916     run cur-time in this-procedure
      917       (output v-date
      918       ,output v-time
      919       ) .
      920     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      921   end.
      922   function cur-time-string-sec returns character
      923   :
      924     define variable v-date as date      no-undo .
      925     define variable v-time as integer   no-undo .
      926     run cur-time in this-procedure
      927       (output v-date
      928       ,output v-time
      929       ) .
      930     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      931   end.
      932   function cur-time-custom  returns character
      933   (input p-prefix as character
      934   ,input p-date-format as character
      935   ,input p-delimiter as character
      936   ,input p-time-format as character
      937   ,input p-suffix as character
      938   )
      939   :
      940     define variable v-date as date      no-undo .
      941     define variable v-time as integer   no-undo .
      942     run cur-time in this-procedure
      943       (output v-date
      944       ,output v-time
      945       ) .
      946     return
      947       p-prefix
      948       + string(v-date, p-date-format)
      949       + p-delimiter
      950       + string(v-time, p-time-format)
      951       + p-suffix
      952       .
      953   end.
      954   function cur-time-print  returns character
      955   :
      956     define variable v-date as date      no-undo .
      957     define variable v-time as integer   no-undo .
      958     run cur-time in this-procedure
      959       (output v-date
      960       ,output v-time
      961       ) .
      962     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      963   end.
      964   function cur-time-datetime returns datetime
      965   :
      966     define variable v-char as character no-undo .
      967     define variable v-datetime as datetime no-undo .
      968     v-char = cur-time-string().
      969     v-datetime = datetime(v-char).
      970     return  v-datetime.
      971   end.
      972   function cur-time-string-msec returns character
      973   :
      974     define variable v-date as datetime  no-undo .
      975     v-date = now.
      976     return string(v-date) .
      977   end.
      978       define stream out-stream.
      979       define variable v-goods-counter         as integer      init 0  no-undo.
      980       define variable v-relations-counter     as integer      init 0  no-undo.
      981       define variable v-full-grp-name         as character            no-undo.
      982       define variable v-yesno                 as logical              no-undo.
      983       define frame a
      984           v-goods-counter       label "Обработано товаров"
      985           v-relations-counter   label "Обработано связей"
      986       with.
      987       define buffer buf_goods         for ub.goods.
      988       define buffer buf_gds-grp       for ub.gds-grp.
      989   do
      990   for buf_goods
      991     , buf_gds-grp
      992   on error undo, return error
      993   :
      994       assign
      995           v-yesno = no
      996       .
      997       if p-mode = "update":U
      998       then do:
      999           message
     1000               "Инициализация полных названий групп во всех товарах."
     1001               skip "Вы уверены?"
     1002           view-as alert-box question
     1003           buttons OK-Cancel
     1004           title "Группы товаров"
     1005           update v-yesno.
     1006       end.
     1007       else do:
     1008           message
     1009               "Тест полных названий групп во всех товарах."
     1010               skip "Вы уверены?"
     1011           view-as alert-box question
     1012           buttons OK-Cancel
     1013           title "Группы товаров"
     1014           update v-yesno.
     1015       end.
     1016       if v-yesno <> yes
     1017       then do:
     1018           return.
     1019       end.
     1020   if session :set-wait-state( "compiler" ) then.
     1021       view frame a.
     1022       for each buf_goods no-lock
     1023       on error undo, return error
     1024       :
     1025           run set-full-grp-name in this-procedure (
     1026                 input p-mode
     1027               , input buf_goods.gds-code
     1028               , input-output v-goods-counter
     1029               , input-output v-relations-counter
     1030           ) no-error.
     1031           if error-status :error
     1032           then do:
     1033               run write-log in this-procedure (
     1034                     input 2
     1035                   , input substitute( "&1: *** Ошибка вычисления полного имени группы товара. Товар: &2. &3. &4."
     1036                                       , p-mode
     1037                                       , buf_goods.artic
     1038                                       , return-value
     1039                                       , trim(error-status :get-message(1))
     1040                                   )
     1041               ).
     1042           end.
     1043           display
     1044               v-goods-counter
     1045               v-relations-counter
     1046           with frame a
     1047           view-as dialog-box.
     1048       end.
     1049       for each buf_gds-grp no-lock
     1050       on error undo, return error
     1051       :
     1052           run set-grp-fields in this-procedure (
     1053                 input p-mode
     1054               , input buf_gds-grp.node-code
     1055           ) no-error.
     1056           if error-status :error
     1057           then do:
     1058               message
     1059                        vss-workfile vss-revision vss-description
     1060                   skip(1)
     1061                   skip "Ошибка вычисления полей группы."
     1062                   skip(1)
     1063                   skip "Код группы:" buf_gds-grp.node-code
     1064                   skip "Имя группы:" buf_gds-grp.node-name
     1065                   skip return-value
     1066                   skip trim(error-status :get-message(1))
     1067                        trim(error-status :get-message(2))
     1068                        trim(error-status :get-message(3))
     1069                   skip(1)
     1070                   skip "Будет сделана запись об ошибке в лог."
     1071               view-as alert-box error.
     1072               run write-log in this-procedure (
     1073                     input 2
     1074                   , input substitute( "&1: *** Ошибка вычисления полей группы товара. Группа: &2 &3. &4. &5."
     1075                                       , p-mode
     1076                                       , buf_gds-grp.node-code
     1077                                       , buf_gds-grp.node-name
     1078                                       , return-value
     1079                                       , trim(error-status :get-message(1))
     1080                                   )
     1081               ).
     1082           end.
     1083       end.
     1084       for each buf_gds-grp no-lock
     1085       by buf_gds-grp.lvl-num descending
     1086       on error undo, return error
     1087       :
     1088           run set-unit-base in this-procedure (
     1089                 input p-mode
     1090               , input buf_gds-grp.node-code
     1091           ) no-error.
     1092           if error-status :error
     1093           then do:
     1094               message
     1095                        vss-workfile vss-revision vss-description
     1096                   skip(1)
     1097                   skip "Ошибка установки unit-base для группы."
     1098                   skip(1)
     1099                   skip "Код группы:" buf_gds-grp.node-code
     1100                   skip "Имя группы:" buf_gds-grp.node-name
     1101                   skip return-value
     1102                   skip trim(error-status :get-message(1))
     1103                        trim(error-status :get-message(2))
     1104                        trim(error-status :get-message(3))
     1105                   skip(1)
     1106                   skip "Будет сделана запись об ошибке в лог."
     1107               view-as alert-box error.
     1108               run write-log in this-procedure (
     1109                     input 2
     1110                   , input substitute( "&1: *** Ошибка вычисления unit-base. Группа: &2 &3. &4. &5."
     1111                                       , p-mode
     1112                                       , buf_gds-grp.node-code
     1113                                       , buf_gds-grp.node-name
     1114                                       , return-value
     1115                                       , trim(error-status :get-message(1))
     1116                                   )
     1117               ).
     1118           end.
     1119       end.
     1120   if session :set-wait-state( "" ) then.
     1121       if p-mode = "update":U
     1122       then do:
     1123           message
     1124               "Инициализация групп товаров завершена."
     1125           view-as alert-box.
     1126       end.
     1127       else do:
     1128           message
     1129               "Тест групп товаров завершен."
     1130               skip(1)
     1131               skip "Результат проверки выведен в файл"
     1132               skip "ini-grp.txt":U
     1133           view-as alert-box.
     1134       end.
     1135   end.
     1136   procedure set-grp-fields :
     1137   define input parameter p-mode       as character        no-undo.
     1138   define input parameter p-node-code  as integer          no-undo.
     1139       define variable v-is-terminal   as logical      no-undo.
     1140       define variable v-lvl-num       as integer      no-undo.
     1141       define buffer buf_gds-grp       for ub.gds-grp.
     1142       define buffer buf_el_gds-grp    for ub.gds-grp.
     1143       define buffer buf_goods         for ub.goods.
     1144   do
     1145   for buf_gds-grp
     1146     , buf_el_gds-grp
     1147     , buf_goods
     1148   on error undo, return error
     1149   :
     1150       if p-mode = "update":U
     1151       then do:
     1152           find first buf_gds-grp exclusive-lock
     1153                where buf_gds-grp.node-code = p-node-code
     1154           .
     1155       end.
     1156       else do:
     1157           find first buf_gds-grp no-lock
     1158               where buf_gds-grp.node-code = p-node-code
     1159           .
     1160       end.
     1161       run grplib-is-terminal in this-procedure (
     1162             input p-node-code
     1163           , output v-is-terminal
     1164       ).
     1165       if buf_gds-grp.is-term <> v-is-terminal
     1166       then do:
     1167           run write-log in this-procedure (
     1168                 input 2
     1169               , input substitute( "&1: изменение is-terminal для группы &2 &3: &4|&5"
     1170                                   , p-mode
     1171                                   , buf_gds-grp.node-code
     1172                                   , buf_gds-grp.node-name
     1173                                   , buf_gds-grp.is-term
     1174                                   , v-is-terminal )
     1175           ).
     1176           if p-mode = "update":U
     1177           then do:
     1178               assign
     1179                   buf_gds-grp.is-term = v-is-terminal
     1180               .
     1181           end.
     1182       end.
     1183       if buf_gds-grp.is-term = no
     1184       then do:
     1185           find first buf_goods no-lock
     1186                where buf_goods.grp-code = buf_gds-grp.node-code
     1187           no-error.
     1188           if available buf_goods
     1189           then do:
     1190               run write-log in this-procedure (
     1191                     input 2
     1192                   , input substitute( "test: Товар привязан к нетерминальной группе. Код товара: &1. Артикул: &2. Группа &3 &4."
     1193                                       , buf_goods.gds-code
     1194                                       , buf_goods.artic
     1195                                       , buf_gds-grp.node-code
     1196                                       , buf_gds-grp.node-name
     1197                                     )
     1198               ).
     1199           end.
     1200       end.
     1201       run grplib-get-lvl-num in this-procedure (
     1202             input p-node-code
     1203           , output v-lvl-num
     1204       ).
     1205       if buf_gds-grp.lvl-num <> v-lvl-num
     1206       then do:
     1207           run write-log in this-procedure (
     1208                 input 2
     1209               , input substitute( "&1: изменение lvl-num для группы &2 &3: &4|&5"
     1210                                   , p-mode
     1211                                   , buf_gds-grp.node-code
     1212                                   , buf_gds-grp.node-name
     1213                                   , buf_gds-grp.lvl-num
     1214                                   , v-lvl-num )
     1215           ).
     1216           if p-mode = "update":U
     1217           then do:
     1218               assign
     1219                   buf_gds-grp.lvl-num = v-lvl-num
     1220               .
     1221           end.
     1222       end.
     1223   end.
     1224   end procedure.
     1225   procedure set-unit-base :
     1226   define input parameter p-mode       as character        no-undo.
     1227   define input parameter p-node-code  as integer          no-undo.
     1228       define variable v-is-first-goods-in-grp     as logical      no-undo.
     1229       define variable v-is-first-lower-grp        as logical      no-undo.
     1230       define variable v-unit-base                 as character    no-undo.
     1231       define variable v-is-terminal               as logical      no-undo.
     1232       define buffer buf_gds-grp       for ub.gds-grp.
     1233       define buffer buf_lower_gds-grp for ub.gds-grp.
     1234       define buffer buf_goods         for ub.goods.
     1235   do
     1236   for buf_gds-grp
     1237     , buf_lower_gds-grp
     1238     , buf_goods
     1239   on error undo, return error
     1240   :
     1241       assign
     1242           v-unit-base             = ?
     1243           v-is-first-goods-in-grp = yes
     1244           v-is-first-lower-grp    = yes
     1245       .
     1246       if p-mode = "update":U
     1247       then do:
     1248           find first buf_gds-grp exclusive-lock
     1249                where buf_gds-grp.node-code = p-node-code
     1250           .
     1251       end.
     1252       else do:
     1253           find first buf_gds-grp no-lock
     1254                where buf_gds-grp.node-code = p-node-code
     1255           .
     1256       end.
     1257       run grplib-is-terminal in this-procedure (
     1258             input p-node-code
     1259           , output v-is-terminal
     1260       ).
     1261       if v-is-terminal = yes
     1262       then do:
     1263           loop-by-goods:
     1264           for each buf_goods no-lock
     1265              where buf_goods.grp-code = buf_gds-grp.node-code
     1266           on error undo, return error
     1267           :
     1268               if v-is-first-goods-in-grp = yes
     1269               then do:
     1270                   assign
     1271                       v-unit-base             = buf_goods.unit-base
     1272                       v-is-first-goods-in-grp = no
     1273                   .
     1274               end.
     1275               else do:
     1276                   if buf_goods.unit-base <> v-unit-base
     1277                   then do:
     1278                       assign
     1279                           v-unit-base = ?
     1280                       .
     1281                       leave loop-by-goods.
     1282                   end.
     1283               end.
     1284           end.
     1285       end.
     1286       else do:
     1287           loop-by-lower-groups:
     1288           for each buf_lower_gds-grp no-lock
     1289              where buf_lower_gds-grp.upper-code = p-node-code
     1290           on error undo, return error
     1291           :
     1292               if v-is-first-lower-grp = yes
     1293               then do:
     1294                   assign
     1295                       v-unit-base             = buf_lower_gds-grp.unit-base
     1296                       v-is-first-lower-grp    = no
     1297                   .
     1298               end.
     1299               else do:
     1300                   if buf_lower_gds-grp.unit-base <> v-unit-base
     1301                   then do:
     1302                       assign
     1303                           v-unit-base = ?
     1304                       .
     1305                       leave loop-by-lower-groups.
     1306                   end.
     1307               end.
     1308           end.
     1309       end.
     1310       if buf_gds-grp.unit-base <> v-unit-base
     1311       then do:
     1312           run write-log in this-procedure (
     1313                 input 2
     1314               , input substitute( "&1: изменение unit-base для группы &2 &3: &4|&5"
     1315                       , p-mode
     1316                       , buf_gds-grp.node-code
     1317                       , buf_gds-grp.node-name
     1318                       , buf_gds-grp.unit-base
     1319                       , v-unit-base
     1320                       )
     1321           ).
     1322           if p-mode = "update":U
     1323           then do:
     1324               assign
     1325                   buf_gds-grp.unit-base = v-unit-base
     1326               .
     1327           end.
     1328       end.
     1329   end.
     1330   end procedure.
     1331   procedure write-log :
     1332   define input parameter p-tab-position   as integer          no-undo.
     1333   define input parameter p-log-text       as character        no-undo.
     1334   do
     1335   on error undo, return error
     1336   :
     1337       output stream out-stream to "ini-grp.txt":U append.
     1338       if p-tab-position <> 0
     1339       then do:
     1340           put stream out-stream unformatted
     1341               cur-time-string-sec()
     1342           .
     1343           put stream out-stream unformatted
     1344               space( p-tab-position * 2 + 1 )
     1345           .
     1346       end.
     1347       put stream out-stream unformatted
     1348           p-log-text
     1349       .
     1350       put stream out-stream unformatted
     1351           chr(10)
     1352       .
     1353       output stream out-stream close.
     1354   end.
     1355   end procedure.
     1356   procedure set-full-grp-name :
     1357   define input parameter p-mode                       as character        no-undo.
     1358   define input parameter p-gds-code                   as integer          no-undo.
     1359   define input-output parameter p-goods-counter       as integer          no-undo.
     1360   define input-output parameter p-relations-counter   as integer          no-undo.
     1361       define buffer buf_goods         for ub.goods.
     1362       define buffer buf_gds-obj       for ub.gds-obj.
     1363       define buffer buf_el_gds-obj    for ub.gds-obj.
     1364   do
     1365   for buf_goods
     1366     , buf_gds-obj
     1367     , buf_el_gds-obj
     1368   on error undo, return error
     1369   :
     1370       assign
     1371           p-goods-counter = p-goods-counter + 1
     1372       .
     1373       if p-mode = "update":U
     1374       then do:
     1375           find first buf_goods exclusive-lock
     1376                where buf_goods.gds-code = p-gds-code
     1377           .
     1378       end.
     1379       else do:
     1380           find first buf_goods no-lock
     1381                where buf_goods.gds-code = p-gds-code
     1382           .
     1383       end.
     1384       run grplib-get-full-name in this-procedure (
     1385             input buf_goods.grp-code
     1386           , output v-full-grp-name
     1387       ).
     1388       if buf_goods.grp-name <> v-full-grp-name
     1389       then do:
     1390           run write-log in this-procedure (
     1391                 input 2
     1392               , input substitute( "&1: изменение полного имени группы товара: &2|&3. Товар: &4."
     1393                                   , p-mode
     1394                                   , buf_goods.grp-name
     1395                                   , v-full-grp-name
     1396                                   , buf_goods.artic
     1397                                 )
     1398           ).
     1399           if p-mode = "update":U
     1400           then do:
     1401               assign
     1402                   buf_goods.grp-name = v-full-grp-name
     1403               .
     1404           end.
     1405       end.
     1406       for each buf_gds-obj no-lock
     1407          where buf_gds-obj.artic      = buf_goods.artic
     1408            and buf_gds-obj.prod-type  = buf_goods.prod-type
     1409            and buf_gds-obj.prod-code  = buf_goods.prod-code
     1410       :
     1411           assign
     1412               p-relations-counter     = p-relations-counter + 1
     1413           .
     1414           if buf_gds-obj.grp-name <> v-full-grp-name
     1415           then do:
     1416               run write-log in this-procedure (
     1417                     input 2
     1418                   , input substitute( "&1: изменение полного имени группы товара на объекте: &2|&3. Товар: &4. Объект: &5&6"
     1419                                       , p-mode
     1420                                       , buf_gds-obj.grp-name
     1421                                       , v-full-grp-name
     1422                                       , buf_goods.artic
     1423                                       , buf_gds-obj.obj-type
     1424                                       , buf_gds-obj.obj-code
     1425                                     )
     1426               ).
     1427               if p-mode = "update":U
     1428               then do:
     1429                   find first buf_el_gds-obj exclusive-lock
     1430                        where recid( buf_el_gds-obj ) = recid( buf_gds-obj )
     1431                   .
     1432                   assign
     1433                       buf_el_gds-obj.grp-name = v-full-grp-name
     1434                   .
     1435               end.
     1436           end.
     1437       end.
     1438   end.
     1439   end procedure.
