        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: delbtpr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: utl/delbtpr.p $":U .
        7   define variable vss-description as character no-undo init "Удаление зависшей записи Batchprocess для системы архивов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable v-doc-code  as character no-undo .
       67   define variable v-obj-type  as character no-undo .
       68   define variable v-obj-code  as integer   no-undo .
       69   define variable v-fact-date as date      no-undo .
       70   define variable v-ok        as logical   no-undo .
       71   define buffer buf_batchprocess for ub.batchprocess .
       72   define buffer buf_c-trn-doc    for ub.c-trn-doc .
       73   define stream sout .
       74   do
       75   on error undo, return error return-value
       76   :
       77     define variable v-bptr-recid as integer   no-undo .
       78     run gbl/d-prompt.w (
       79         'title=':u + "Введите номер записи BathProcess" + '\':u
       80       + 'text1=':u + "Введите номер записи BathProcess" + '\':u
       81       + 'format=>,>>>,>>>,>>9\':u
       82       + 'type=int\':u
       83       ,input-output v-bptr-recid
       84       ).
       85     if return-value = 'false':u
       86     then do:
       87       return .
       88     end.
       89     main_block:
       90     do transaction
       91     on error undo, return error return-value
       92     :
       93       find first buf_batchprocess exclusive-lock
       94         where recid(buf_batchprocess) = v-bptr-recid
       95         no-error .
       96       if not available buf_batchprocess
       97       then do:
       98         message
       99           substitute("Не найдена запись batchprocess с номером &1"
      100                     ,v-bptr-recid
      101                     ) skip
      102           view-as alert-box error .
      103         undo main_block, return error return-value .
      104       end.
      105       find first buf_c-trn-doc exclusive-lock
      106         where buf_c-trn-doc.doc-code = buf_batchprocess.charkey_one
      107         no-error .
      108       if not available buf_c-trn-doc
      109       then do:
      110         message
      111           "Не найден удаленный документ для записи batchprocess" skip
      112           "Возможно задан неправильный номер записи batchprocess" skip
      113           view-as alert-box error .
      114         undo main_block, return error return-value .
      115       end.
      116       if buf_c-trn-doc.status_ <> 'факт':U
      117       then do:
      118         message
      119           substitute("Удаленный документ имеет статус &1 отличный от &2"
      120                     ,buf_c-trn-doc.status_
      121                     ,'факт':U
      122                     ) skip
      123           "Возможно задан неправильный номер записи batchprocess" skip
      124           view-as alert-box error .
      125         undo main_block, return error return-value .
      126       end.
      127       assign
      128         v-doc-code  = buf_c-trn-doc.doc-code
      129         v-obj-type  = buf_c-trn-doc.obj-type
      130         v-obj-code  = buf_c-trn-doc.obj-code
      131         v-fact-date = buf_c-trn-doc.fact-date
      132       .
      133       case buf_batchprocess.bp_type
      134       :
      135         when 'arh':U
      136         then do:
      137           message
      138             substitute("Удалить запись batchprocess с номером &1"
      139                       ,v-bptr-recid
      140                       ) skip
      141             substitute("Номер документа &1"
      142                       ,v-doc-code
      143                       ) skip
      144             substitute("Складской архив по товарам будет помечен для перерасчета с даты &1"
      145                       , string(v-fact-date, '99/99/9999':U)
      146                       ) skip
      147             "Продолжить?"
      148             view-as alert-box question buttons yes-no update v-ok .
      149           if v-ok <> true
      150           then do:
      151             undo main_block, return error return-value .
      152           end.
      153           output stream sout to delbtpr.txt append .
      154           export stream sout string(today, '99/99/9999':U) "delete batchprocess" v-obj-type v-obj-code v-fact-date v-doc-code .
      155           export stream sout buf_batchprocess .
      156           output stream sout close .
      157           delete buf_batchprocess .
      158           run trg/markarh.p
      159             (input  v-obj-type
      160             ,input  v-obj-code
      161             ,input  v-fact-date
      162             ,input  v-doc-code
      163             ) .
      164         end.
      165         when 'ahsp':U
      166         then do:
      167           message
      168             substitute("Удалить запись batchprocess с номером &1"
      169                       ,v-bptr-recid
      170                       ) skip
      171             substitute("Номер документа &1"
      172                       ,v-doc-code
      173                       ) skip
      174             substitute("Складской архив по поставщикам будет помечен для перерасчета с даты &1"
      175                       , string(v-fact-date, '99/99/9999':U)
      176                       ) skip
      177             "Продолжить?"
      178             view-as alert-box question buttons yes-no update v-ok .
      179           if v-ok <> true
      180           then do:
      181             undo main_block, return error return-value .
      182           end.
      183           output stream sout to delbtpr.txt append .
      184           export stream sout string(today, '99/99/9999':U) "delete batchprocess" v-obj-type v-obj-code v-fact-date v-doc-code .
      185           export stream sout buf_batchprocess .
      186           output stream sout close .
      187           delete buf_batchprocess .
      188           run trg/markahsp.p
      189             (input  v-obj-type
      190             ,input  v-obj-code
      191             ,input  v-fact-date
      192             ,input  v-doc-code
      193             ) .
      194         end.
      195         when 'aht':U
      196         then do:
      197           message
      198             substitute("Удалить запись batchprocess с номером &1"
      199                       ,v-bptr-recid
      200                       ) skip
      201             substitute("Номер документа &1"
      202                       ,v-doc-code
      203                       ) skip
      204             substitute("Складской архив по типам приобретения будет помечен для перерасчета с даты &1"
      205                       , string(v-fact-date, '99/99/9999':U)
      206                       ) skip
      207             "Продолжить?"
      208             view-as alert-box question buttons yes-no update v-ok .
      209           if v-ok <> true
      210           then do:
      211             undo main_block, return error return-value .
      212           end.
      213           output stream sout to delbtpr.txt append .
      214           export stream sout string(today, '99/99/9999':U) "delete batchprocess" v-obj-type v-obj-code v-fact-date v-doc-code .
      215           export stream sout buf_batchprocess .
      216           output stream sout close .
      217           delete buf_batchprocess .
      218           run trg/markaht.p
      219             (input  v-obj-type
      220             ,input  v-obj-code
      221             ,input  v-fact-date
      222             ,input  v-doc-code
      223             ) .
      224         end.
      225         otherwise do:
      226           message
      227             substitute("Неизвестный тип записи batchprocess &1"
      228                       ,buf_batchprocess.bp_type
      229                       ) skip
      230             view-as alert-box error .
      231           undo main_block, return error return-value .
      232         end.
      233       end case .
      234     end.
      235     message
      236       "Запись batchprocess успешно удалена"
      237       view-as alert-box information .
      238   end.
