        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: exp-pric.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/exp-pric.p $":U .
        8   define variable vss-description as character no-undo init "Экспорт  строк ДНЦ в текстовый файл в формате импорта".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define stream txt.
       70   define variable g-log        as logical no-undo.
       71   define variable loc-ref-list as character no-undo .
       72   define variable v-dir-name   as character no-undo .
       73   define variable v-type       as character no-undo .
       74   define variable v-can-write  as logical   no-undo .
       75   define variable num-rec      as integer no-undo.
       76   define variable f-name     as character no-undo.
       77   define variable prtroot    as integer   no-undo .
       78   define variable name-item  as character no-undo .
       79   define variable name-scale as character no-undo .
       80   define variable name-bc    as character no-undo .
       81   define variable name-gtd   as character no-undo .
       82   define variable main-bar-code as integer   no-undo .
       83   define variable pp as character no-undo .
       84   define variable pd as character no-undo .
       85   define buffer buf_gds-prt for ub.gds-prt  .
       86   define buffer buf_price-doc-forming for ub.price-doc-forming  .
       87   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
       88   define buffer buf_goods for ub.goods  .
       89   g-log = no.
       90   message "Экспорт главных цен в файл, в формате импорта." skip (2)
       91           "Продолжать ?"
       92           view-as alert-box question buttons OK-Cancel update g-log.
       93   if not g-log then return.
       94   find first buf_gds-prt where buf_gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
       95   if available  buf_gds-prt then   prtroot = buf_gds-prt.prt-root.
       96                             else   prtroot = 0.
       97   run gbl/dir-sel.p
       98    ( output v-dir-name
       99     ,output v-type
      100     ,output v-can-write
      101     ).
      102   if NOT v-can-write THEN DO:
      103       message
      104         "Путь для сохранения файлов не указан."
      105         view-as alert-box error.
      106       return no-apply.
      107   END.
      108   run str/docsprls.w
      109        ( input parParentProc
      110        , input "all"
      111        , input ?
      112        , input ?
      113        , input "b-sel,b-mark":U
      114        , input-output loc-ref-list  ).
      115   if loc-ref-list = "" then do:
      116       message
      117         "Документы не выбраны"
      118         view-as alert-box error.
      119       return no-apply.
      120   END.
      121   do num-rec = 1 to num-entries(loc-ref-list):
      122      find buf_price-doc-forming where recid ( buf_price-doc-forming) = integer(entry(num-rec, loc-ref-list)) no-lock.
      123         f-name = v-dir-name + "\" + trim(string( buf_price-doc-forming.pdf-id)) + "bd" + trim(string( buf_price-doc-forming.pdf-db)) + ".adb".
      124         output stream txt to value (f-name ).
      125         for each buf_price-doc-forming-gds no-lock  where
      126                  buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
      127                  buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
      128                  buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
      129                  buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db ,
      130             first buf_goods no-lock
      131                where buf_goods.artic     = buf_price-doc-forming-gds.artic
      132                  and buf_goods.prod-type = buf_price-doc-forming-gds.prod-type
      133                  AND buf_goods.prod-code = buf_price-doc-forming-gds.prod-code
      134                  break by buf_goods.gds-code
      135             :
      136             if first-of ( buf_goods.gds-code) then do:
      137                 display
      138                   buf_goods.artic
      139                   with frame ff view-as dialog-box
      140                 title ": Экспорт ".
      141                 pause 0.
      142             pp = "" .
      143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      144     (input  buf_goods.gds-code
      145     ,input  ?
      146     ,output main-bar-code
      147     )  .
      148             end.
      149            if main-bar-code = buf_price-doc-forming-gds.b-code then  pp = trim(string( buf_price-doc-forming-gds.price-sale-doc)) .
      150             if last-of (buf_goods.gds-code) then do:
      151                 assign
      152                 name-item = "ITEM:"
      153                 name-scale = ""
      154                 name-bc    = string(main-bar-code)
      155                 pd = ""
      156                 .
      157                 put stream txt  unformatted
      158                     "ITEM:" +
      159                     buf_goods.artic + ";" +
      160                     trim(string(buf_goods.prod-code)) + ";;;"+
      161                     name-bc + ";" +
      162                     pp + ";;;;" +
      163                     pd + ";;;;;;" SKIP.
      164             end.
      165         END.
      166         output close.
      167   end.
      168   message "Экспорт ДНЦ в файл закончен."  view-as alert-box information buttons ok.
