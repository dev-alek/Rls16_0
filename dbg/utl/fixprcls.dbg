        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-install     as logical no-undo init no .
        4   define variable l-fix-errors as logical no-undo init false .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: fixprcls.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: utl/fixprcls.p $":U .
       10   define variable vss-description as character no-undo init "Проверка правильности переоценок".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define  temp-table temp-host no-undo
       71     field host-code like ub.store.host-code
       72     index xpk host-code
       73   .
       74   define  temp-table temp-obj no-undo
       75     field obj-type  like ub.clients.obj-type
       76     field obj-code  like ub.clients.obj-code
       77     field host-code like ub.store.host-code
       78     field db-num    like ub.clients.db-num
       79     index xpk  obj-type obj-code
       80     index xie1 host-code
       81     index xie2 db-num host-code
       82   .
       83   procedure init-temphost:
       84     define buffer buf_store   for ub.store .
       85     define buffer buf_shop    for ub.shop .
       86     define buffer buf_clients for ub.clients .
       87     define buffer buf_db for ub.db .
       88     define buffer buf_temp-host for temp-host .
       89     define buffer buf_temp-obj for temp-obj .
       90     do
       91     on error undo, return error return-value
       92     :
       93       for each buf_store
       94       on error undo, return error
       95       :
       96         find first buf_temp-host
       97           where buf_temp-host.host-code = buf_store.host-code
       98           no-error .
       99         if not available buf_temp-host
      100         then do:
      101           create buf_temp-host .
      102           assign
      103             buf_temp-host.host-code = buf_store.host-code
      104           .
      105         end.
      106         find first buf_clients no-lock
      107           where buf_clients.obj-type = 'скл':U
      108             and buf_clients.obj-code = buf_store.obj-code
      109           no-error .
      110         if not available buf_clients
      111         then do:
      112           message
      113             "Ошибка при поиске клиента" skip
      114             "Клиент" 'скл':U buf_store.obj-code skip
      115             view-as alert-box error .
      116           undo, return error .
      117         end.
      118         create buf_temp-obj .
      119         assign
      120           buf_temp-obj.obj-type  = 'скл':U
      121           buf_temp-obj.obj-code  = buf_store.obj-code
      122           buf_temp-obj.host-code = buf_store.host-code
      123           buf_temp-obj.db-num    = buf_clients.db-num
      124         .
      125       end.
      126       for each buf_shop
      127       on error undo, return error
      128       :
      129         find first buf_temp-host
      130           where buf_temp-host.host-code = buf_shop.host-code
      131           no-error .
      132         if not available buf_temp-host
      133         then do:
      134           create buf_temp-host .
      135           assign
      136             buf_temp-host.host-code = buf_shop.host-code
      137           .
      138         end.
      139         find first buf_clients no-lock
      140           where buf_clients.obj-type = 'маг':U
      141             and buf_clients.obj-code = buf_shop.obj-code
      142           no-error .
      143         if not available buf_clients then do:
      144           message
      145             "Ошибка при поиске клиента" skip
      146             "Клиент" 'маг':U buf_shop.obj-code skip
      147             view-as alert-box error .
      148           undo, return error .
      149         end.
      150         create buf_temp-obj .
      151         assign
      152           buf_temp-obj.obj-type  = 'маг':U
      153           buf_temp-obj.obj-code  = buf_shop.obj-code
      154           buf_temp-obj.host-code = buf_shop.host-code
      155           buf_temp-obj.db-num    = buf_clients.db-num
      156         .
      157       end.
      158     end.
      159   end.
      160   define new global shared variable g#library  as handle no-undo .
      161   define new global shared variable g#library2 as handle no-undo .
      162   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   procedure cur-time :
      164      define output parameter p-today as date      no-undo .
      165      define output parameter p-time  as integer   no-undo .
      166     do
      167     on error undo, return error
      168     :
      169       define variable v-date1 as date      no-undo .
      170       define variable v-date2 as date      no-undo .
      171       define variable v-time  as integer   no-undo .
      172       assign
      173         v-date1 = today
      174         v-time  = time
      175         v-date2 = today
      176       .
      177       if v-date1 <> v-date2
      178       then do:
      179         assign
      180           v-date1 = today
      181           v-time  = v-time
      182         .
      183       end.
      184       assign
      185         p-today = v-date1
      186         p-time  = v-time
      187       .
      188     end.
      189   end.
      190   function cur-time-date returns character
      191   :
      192     return string(today, '99/99/9999':U) .
      193   end.
      194   function cur-time-mjd returns decimal
      195   :
      196     define variable v-date as date      no-undo .
      197     define variable v-time as integer   no-undo .
      198     run cur-time in this-procedure
      199       (output v-date
      200       ,output v-time
      201       ) .
      202     return integer(v-date) - 2400002 + (v-time / 86400) .
      203   end.
      204   function cur-time-get-ending-index returns integer
      205   (input p-number as integer
      206   )
      207   :
      208     if p-number < 0
      209     or p-number = ?
      210     then do:
      211       return 1 .
      212     end.
      213     define variable v-rest as integer   no-undo .
      214     assign
      215       p-number = p-number modulo 100
      216     .
      217     if p-number < 20
      218     then do:
      219       assign
      220         v-rest = p-number
      221       .
      222     end.
      223     else do:
      224       assign
      225         v-rest = p-number modulo 10
      226       .
      227     end.
      228     case v-rest :
      229       when 1
      230       then do:
      231         return 2 .
      232       end.
      233       when 2 or
      234       when 3 or
      235       when 4
      236       then do:
      237         return 3 .
      238       end.
      239       otherwise do:
      240         return 1 .
      241       end.
      242     end case .
      243   end.
      244   procedure cur-time-mjd-to-date :
      245      define input  parameter i-mjd-diff as decimal no-undo.
      246      define output parameter o-Date     as date    no-undo.
      247      define output parameter o-Time     as integer no-undo.
      248      define variable v-day-number as integer   no-undo .
      249      if    i-mjd-diff < 0
      250         or i-mjd-diff = ?
      251      then do:
      252         return "?" .
      253      end.
      254      assign
      255         v-day-number = truncate(i-mjd-diff,0).
      256         o-Date = date(v-day-number + 2400002).
      257         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      258     .
      259   end.
      260   function cur-time-mjd-to-string returns character
      261   (input p-mjd-diff as decimal
      262   )
      263   :
      264     define variable v-day-number as integer   no-undo .
      265     define variable v-seconds    as integer   no-undo .
      266     define variable v-hour       as integer   no-undo .
      267     define variable v-min        as integer   no-undo .
      268     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      269     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      270     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      271     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      272     if p-mjd-diff < 0
      273     or p-mjd-diff = ?
      274     then do:
      275       return "?" .
      276     end.
      277     assign
      278       v-day-number = integer(truncate(p-mjd-diff,0))
      279       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      280     .
      281     if v-seconds > 86400
      282     then do:
      283       assign
      284         v-seconds = 86400 - 1
      285       .
      286     end.
      287     if v-seconds < 0
      288     then do:
      289       assign
      290         v-seconds = 0
      291       .
      292     end.
      293     assign
      294       v-hour = truncate(v-seconds / 3600, 0)
      295     .
      296     assign
      297       v-seconds = v-seconds modulo 3600
      298     .
      299     assign
      300       v-min = truncate(v-seconds / 60, 0)
      301     .
      302     assign
      303       v-seconds = v-seconds modulo 60
      304     .
      305     return
      306         (if v-day-number <> 0
      307           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      308           else ""
      309         )
      310       + (if v-day-number <> 0 or v-hour <> 0
      311           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      312           else ""
      313         )
      314       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      315           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      316           else ""
      317         )
      318       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      319       .
      320   end.
      321   function cur-time-string returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      330   end.
      331   function cur-time-string-sec returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      340   end.
      341   function cur-time-custom  returns character
      342   (input p-prefix as character
      343   ,input p-date-format as character
      344   ,input p-delimiter as character
      345   ,input p-time-format as character
      346   ,input p-suffix as character
      347   )
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return
      356       p-prefix
      357       + string(v-date, p-date-format)
      358       + p-delimiter
      359       + string(v-time, p-time-format)
      360       + p-suffix
      361       .
      362   end.
      363   function cur-time-print  returns character
      364   :
      365     define variable v-date as date      no-undo .
      366     define variable v-time as integer   no-undo .
      367     run cur-time in this-procedure
      368       (output v-date
      369       ,output v-time
      370       ) .
      371     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      372   end.
      373   function cur-time-datetime returns datetime
      374   :
      375     define variable v-char as character no-undo .
      376     define variable v-datetime as datetime no-undo .
      377     v-char = cur-time-string().
      378     v-datetime = datetime(v-char).
      379     return  v-datetime.
      380   end.
      381   function cur-time-string-msec returns character
      382   :
      383     define variable v-date as datetime  no-undo .
      384     v-date = now.
      385     return string(v-date) .
      386   end.
      387   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388     define variable v-cntxt-db-num        as integer   no-undo .
      389     define variable v-cntxt-userid        as character no-undo .
      390     define variable v-cntxt-level         as character no-undo .
      391     define variable v-cntxt-host-code-obj as integer   no-undo .
      392     define variable v-cntxt-obj-type      as character no-undo .
      393     define variable v-cntxt-obj-code      as integer   no-undo .
      394     define variable v-cntxt-db-num-obj    as integer   no-undo .
      395     define variable v-cntxt-is-admin      as logical   no-undo .
      396   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   define variable v-waitfram-action01         as character   no-undo .
      398   define variable v-waitfram-action02         as character   no-undo .
      399   define variable v-waitfram-action03         as character   no-undo .
      400   define variable mWaitFramTextBeg            as character   no-undo.
      401   define variable mWaitFramTextEnd            as character   no-undo.
      402   define variable mWaitFramView               as logical     no-undo.
      403   define variable mWaitProcEvent              as logical     no-undo init yes.
      404   define variable mWaitFramInterval           as integer     no-undo init 1 .
      405   define variable mWaitFramStop               as logical     no-undo.
      406   define variable mWaitFramStopUser           as logical     no-undo.
      407   define variable mWaitFramStopTimeOut        as logical     no-undo.
      408   define variable mWaitFramStartProc          as datetime-tz no-undo.
      409   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      410   define button B-WaitFramStop auto-end-key
      411        label "Стоп"
      412        size 10 by 1 tooltip "Остоновить процесс".
      413   define button B-viewProcInfo
      414        label "Информация"
      415        size 15 by 1 tooltip "Информация о процесс".
      416   define frame waitfram
      417     v-waitfram-action01 format "x(72)" no-label skip
      418     v-waitfram-action02 format "x(72)" no-label skip
      419     v-waitfram-action03 format "x(72)" no-label skip
      420     B-viewProcInfo
      421     B-WaitFramStop at row 4 col 30
      422     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      423     .
      424   define new global shared variable mBatchMode as logical no-undo init ?.
      425   define variable mFramBachModHandle as handle no-undo.
      426   mFramBachModHandle = frame waitfram:handle.
      427   define variable mFameOldVis as logical no-undo.
      428   define variable mVisCUrentVin as logical no-undo.
      429   if session:batch-mode
      430   then
      431      mBatchMode = yes.
      432   if mBatchMode = ? then do:
      433     mVisCUrentVin = current-window:visible.
      434     mFameOldVis = mFramBachModHandle:visible.
      435     mFramBachModHandle:visible  = yes.
      436     mBatchMode = mFramBachModHandle:visible ne yes.
      437     mFramBachModHandle:visible = mFameOldVis.
      438     current-window:visible = mVisCUrentVin.
      439   end.
      440    if  log-manager:logfile-name ne ?
      441     then DO:
      442         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      443         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      444         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      445     end.
      446   on choose of B-WaitFramStop in frame waitfram
      447   do:
      448     mWaitFramStop = yes.
      449     mWaitFramStopUser = yes.
      450   end.
      451   function waitfram-check-timeout returns logical():
      452      define variable vtime as int64 no-undo.
      453      if mWaitFramStopTimeOut
      454      then
      455         return yes.
      456      vtime = ( now - mWaitFramStartProc ) / 1000 .
      457      if     mWaitFramTimeOut ne ?
      458         and mWaitFramTimeOut ne 0
      459         and mWaitFramTimeOut lt vtime
      460      then do:
      461         mWaitFramStopTimeOut = yes.
      462      end.
      463      return mWaitFramStopTimeOut.
      464   end.
      465   procedure waitfram-hide :
      466     if not session:batch-mode
      467     then do
      468     on error undo, return error return-value
      469     :
      470       pause 0 before-hide .
      471       if not mBatchMode then
      472         hide frame waitfram .
      473     if     not mWaitFramView
      474        and mWaitProcEvent
      475     then
      476       process events .
      477     end.
      478   end procedure.
      479   procedure waitfram-show :
      480     define input  parameter p-message as character no-undo .
      481     define variable v-left-margin as integer   no-undo .
      482     if not session:batch-mode
      483     then do
      484     on error undo, return error return-value
      485     :
      486       if length(p-message) <= 70 then do:
      487         assign
      488           v-left-margin = integer((70 - length(p-message)) / 2)
      489         .
      490         assign
      491           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      492         .
      493         assign
      494           v-waitfram-action01 = " "
      495           v-waitfram-action02 = " "
      496                                    + fill(" ", v-left-margin)
      497                                    + p-message
      498           v-waitfram-action03 = " "
      499         .
      500       end.
      501       else do:
      502         define variable vRindex1 as integer no-undo.
      503         define variable vRindex2 as integer no-undo.
      504         vRindex1 = r-index(p-message," ",70).
      505         if vRindex1 = 0
      506         then
      507            vRindex1 = 70.
      508         if length(p-message)  <= vRindex1 + 70 then do:
      509           assign
      510             v-waitfram-action01 = " "
      511             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      512             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      513           .
      514         end.
      515         else do:
      516           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      517           if vRindex2 <= vRindex1
      518           then
      519              vRindex2 = vRindex1 + 70.
      520           assign
      521             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      522             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      523             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      524           .
      525         end.
      526       end.
      527       B-viewProcInfo:visible   in frame waitfram = no.
      528       B-viewProcInfo:sensitive in frame waitfram = no.
      529       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      530       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      531       if  (   mWaitFramView
      532          or  mWaitProcEvent)
      533          and not mBatchMode
      534       then
      535          display
      536             v-waitfram-action01 skip
      537             v-waitfram-action02 skip
      538             v-waitfram-action03 skip
      539          with frame waitfram .
      540       if     mWaitFramView
      541          then do:
      542             if     mWaitFramInterval ne ?
      543                and not mBatchMode
      544             then
      545                wait-for go of frame waitfram pause mWaitFramInterval.
      546          end.
      547          else
      548             if     mWaitProcEvent
      549                and not mBatchMode
      550             then
      551                process events .
      552     end.
      553   end procedure.
      554      procedure waitfram-show-this:
      555         define input  parameter iInterval as int64 no-undo.
      556         define variable vtime as int64 no-undo.
      557         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      558         mWaitFramInterval = iInterval.
      559         run waitfram-show (substitute("&1&2 &3&4" ,
      560                                       mWaitFramTextBeg ,
      561                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      562                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      563                                       mWaitFramTextEnd
      564                                      )
      565                           ).
      566      end.
      567      procedure WaitFramRunPause:
      568         define input  parameter iInterval as dec no-undo.
      569         define variable vStart  as datetime-tz no-undo.
      570         define variable vend    as datetime-tz no-undo.
      571         define variable vint as int64 no-undo.
      572         define variable vOk as logical no-undo.
      573         vStart = now.
      574         vend   = vStart.
      575         publish "WaitFramPause" (iInterval,output vOk).
      576         vend   =  now.
      577         vint = vend - vStart.
      578         vint = iInterval - vint / 1000.
      579         if     not mWaitFramStop
      580            and (   vint > 0
      581                 or (    not vOk
      582                     and iInterval eq ?
      583                     )
      584                 )
      585         then
      586            run waitfram-show-this (iInterval).
      587         vend   =  now.
      588         vint = vend - vStart.
      589         vint = iInterval - vint / 1000.
      590         if     not mWaitFramStop
      591            and vint > 0
      592         then do:
      593            run gbl/pause.p (vint * 1000).
      594         end.
      595         if iInterval ne ?
      596         then
      597            publish "WaitFramStop".
      598         waitfram-check-timeout().
      599      end.
      600      procedure WaitFramWaitFor:
      601         define input  parameter iInterval as dec no-undo.
      602         assign
      603            mWaitFramStartProc   = now
      604            mWaitFramStopUser    = no
      605            mWaitFramStopTimeOut = no
      606         .
      607         block-wait:
      608         do while not mWaitFramStop:
      609            run WaitFramRunPause (iInterval).
      610            if  waitfram-check-timeout()
      611            then do:
      612               leave block-wait.
      613            end.
      614         end.
      615         run waitfram-hide.
      616      end.
      617   procedure waitfram-join :
      618     define input  parameter p-line-1  as character no-undo .
      619     define input  parameter p-line-2  as character no-undo .
      620     define input  parameter p-line-3  as character no-undo .
      621     define output parameter p-message as character no-undo .
      622     do
      623     on error undo, return error return-value
      624     :
      625       assign
      626         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      627                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      628                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      629       .
      630     end.
      631   end procedure.
      632   function waitfram-join-function returns character
      633     (input p-line-1 as character
      634     ,input p-line-2 as character
      635     ,input p-line-3 as character
      636     ).
      637     define variable v-message as character no-undo .
      638     run waitfram-join in this-procedure
      639       (input  p-line-1
      640       ,input  p-line-2
      641       ,input  p-line-3
      642       ,output v-message
      643       ) .
      644     return v-message .
      645   end function .
      646   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   define temp-table userobjs_temp-user-obj no-undo
      648     field obj-type as character
      649     field obj-code as integer
      650     index xpk is primary unique obj-type obj-code
      651     .
      652   procedure userobjs_clear :
      653     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      654     do
      655     on error undo, return error return-value
      656     :
      657       for each buf_userobjs_temp-user-obj
      658       on error undo, return error return-value
      659       :
      660         delete buf_userobjs_temp-user-obj .
      661       end.
      662     end.
