      664   procedure userobjs_object-count :
      665     define output parameter p-total-count as integer   no-undo .
      666     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      667     do
      668     on error undo, return error return-value
      669     :
      670       assign
      671         p-total-count = 0
      672       .
      673       for each buf_userobjs_temp-user-obj
      674       on error undo, return error return-value
      675       :
      676         assign
      677           p-total-count = p-total-count + 1
      678         .
      679       end.
      680     end.
      681   end.
      682   procedure userobjs_append :
      683      define input  parameter p-obj-type as character no-undo .
      684      define input  parameter p-obj-code as integer   no-undo .
      685     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      686     do
      687     on error undo, return error return-value
      688     :
      689       find first buf_userobjs_temp-user-obj
      690         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      691           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      692         no-error .
      693       if not available buf_userobjs_temp-user-obj
      694       then do:
      695         create buf_userobjs_temp-user-obj .
      696         assign
      697           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      698           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      699         .
      700       end.
      701     end.
      702   end.
      703   procedure userobjs_object-exist :
      704     define output parameter p-object-exist as logical   no-undo .
      705     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      706     do
      707     on error undo, return error return-value
      708     :
      709       find first buf_userobjs_temp-user-obj
      710         no-error .
      711       if not available buf_userobjs_temp-user-obj
      712       then do:
      713         assign
      714           p-object-exist = false
      715         .
      716       end.
      717       else do:
      718         assign
      719           p-object-exist = true
      720         .
      721       end.
      722     end.
      723   end.
      724   procedure userobjs_transfer :
      725     define input  parameter p-callback-handle as handle no-undo .
      726     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      727     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      728     do
      729     on error undo, return error return-value
      730     :
      731       if valid-handle(p-callback-handle) <> true
      732       then do:
      733         message
      734           vss-workfile vss-revision vss-description skip
      735           "Ошибка задания входных параметров" skip
      736           "Неизвестный указатель на процедуру" skip
      737           view-as alert-box error .
      738         undo, return error return-value .
      739       end.
      740       if p-callback-handle :get-signature("userobjs_append") = ""
      741       then do:
      742         message
      743           vss-workfile vss-revision vss-description skip
      744           "Ошибка задания входных параметров" skip
      745           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      746                     ,p-callback-handle :file-name
      747                     ) skip
      748           view-as alert-box error .
      749         undo, return error return-value .
      750       end.
      751       for each buf_userobjs_temp-user-obj
      752       on error undo, return error return-value
      753       :
      754         run userobjs_append in p-callback-handle
      755           (input  buf_userobjs_temp-user-obj.obj-type
      756           ,input  buf_userobjs_temp-user-obj.obj-code
      757           ) .
      758       end.
      759     end.
      760   end procedure.
