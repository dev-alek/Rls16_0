      835   define buffer buf_price-list for ub.price-list .
      836   define variable v-err-count as integer no-undo .
      837   run init-temphost .
      838   define variable v-num as integer no-undo .
      839   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840     run mainmenu_getcntxt in parparentproc
      841       (output v-cntxt-db-num
      842       ,output v-cntxt-userid
      843       ,output v-cntxt-level
      844       ,output v-cntxt-host-code-obj
      845       ,output v-cntxt-obj-type
      846       ,output v-cntxt-obj-code
      847       ,output v-cntxt-db-num-obj
      848       ,output v-cntxt-is-admin
      849       ) .
      850   if p-install then do:
      851     assign
      852       v-num = 1
      853     .
      854   end.
      855   else do:
      856     run gbl/d-askw.w
      857       (input "Вопрос"
      858       ,input "Проверка переоценок." + chr(10)
      859         + "Будут проверены строки."
      860       ,input "|^"
      861       ,input "Все объекты|Выбрать объекты|Отмена"
      862       ,input "|"
      863           + "|"
      864           + ""
      865       ,input 1
      866       ,input 3
      867       ,output v-num
      868       ).
      869   end.
      870   case v-num :
      871     when 1 then do:
      872       run request-fix-errors in this-procedure .
      873       for each temp-obj
      874       :
      875         run process-object in this-procedure
      876           (input temp-obj.obj-type
      877           ,input temp-obj.obj-code
      878           ).
      879       end.
      880     end.
      881     when 2 then do:
      882       define variable v-user-select as logical   no-undo .
      883   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      884   run userobjs_select-many in this-procedure
      885     (input  parparentproc
      886     ,input  v-cntxt-db-num
      887     ,input  v-cntxt-userid
      888     ,input  v-cntxt-host-code-obj
      889     ,input  v-cntxt-obj-type
      890     ,input  v-cntxt-obj-code
      891     ,output v-user-select
      892     )  .
      893       if v-user-select <> true
      894       then do:
      895         message
      896           "Объекты не выбран"
      897           view-as alert-box information .
      898         return .
      899       end.
      900       run request-fix-errors in this-procedure .
      901       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      902       for each buf_userobjs_temp-user-obj
      903       on error undo, return error return-value
      904       :
      905         run process-object in this-procedure
      906           (input buf_userobjs_temp-user-obj.obj-type
      907           ,input buf_userobjs_temp-user-obj.obj-code
      908           ).
      909       end.
      910     end.
      911     when 3 then do:
      912       return .
      913     end.
      914   end case .
      915   if p-install = false then do:
      916     if v-err-count = 0 then do:
      917       message
      918         "Проверка строк переоценок закончена" skip
      919         "Ошибки не обнаружены" skip
      920         view-as alert-box information .
      921     end.
      922     else do:
      923       message
      924         "Проверка строк переоценок закончена" skip
      925         "Обнаружено" v-err-count skip
      926         view-as alert-box error .
      927     end.
      928   end.
      929   return .
      930   procedure process-object :
      931     define input parameter p-obj-type like ub.price-list.obj-type no-undo .
      932     define input parameter p-obj-code like ub.price-list.obj-code no-undo .
      933     define variable v-today as date      no-undo.
      934     define variable v-time  as integer   no-undo.
      935     output to fixprcls.txt append .
      936     run cur-time in this-procedure ( output v-today
      937                                    , output v-time
      938                                    ).
      939     export
      940       string(v-today, "99/99/9999":u)  string(v-time, "hh:mm":u ) skip
      941       p-obj-type skip
      942       p-obj-code skip
      943       .
      944     output close .
      945     if p-install = false
      946     then do:
      947       run waitfram-show in this-procedure
      948         (input "Объект " + string(p-obj-type) + " " + string(p-obj-code)
      949         ).
      950     end.
      951     define variable v-ind as integer   no-undo .
      952     for each ub.price-list no-lock
      953       where ub.price-list.obj-type = p-obj-type
      954         and ub.price-list.obj-code = p-obj-code
      955     :
      956       if p-install = false
      957       then do:
      958         assign
      959           v-ind = v-ind + 1
      960         .
      961         if v-ind modulo 10 = 0
      962         then do:
      963           run waitfram-show in this-procedure
      964             (input "Объект " + string(p-obj-type) + " " + string(p-obj-code) + ". "
      965             + "Обработано " + string(v-ind) + ". "
      966             ).
      967         end.
      968       end.
      969       find first ub.goods no-lock
      970         where ub.goods.artic     = price-list.artic
      971           and ub.goods.prod-type = price-list.prod-type
      972           and ub.goods.prod-code = price-list.prod-code
      973         no-error .
      974       if not available ub.goods then do:
      975         assign
      976           v-err-count = v-err-count + 1
      977         .
      978         output to fixprcls.err append .
      979         run cur-time in this-procedure ( output v-today
      980                                        , output v-time
      981                                        ).
      982         export
      983           string(v-today, "99/99/9999":u)  string(v-time, "hh:mm":u ) skip
      984           "goods_not_found"
      985           price-list.obj-type
      986           price-list.obj-code
      987           price-list.doc-num
      988           price-list.artic
      989           price-list.prod-type
      990           price-list.prod-code
      991           .
      992         output close .
      993         if l-fix-errors then do:
      994           output to fixprcls.fix append .
      995           export price-list .
      996           output close .
      997           find first buf_price-list exclusive-lock
      998             where recid(buf_price-list) = recid(price-list)
      999             .
     1000           delete buf_price-list .
     1001         end.
     1002         next .
     1003       end.
     1004       find first ub.price-doc no-lock
     1005         where ub.price-doc.doc-num = price-list.doc-num
     1006         no-error .
     1007       if not available ub.price-doc then do:
     1008         assign
     1009           v-err-count = v-err-count + 1
     1010         .
     1011         output to fixprcls.err append .
     1012         run cur-time in this-procedure ( output v-today
     1013                                        , output v-time
     1014                                        ).
     1015         export
     1016           string(v-today, "99/99/9999":u)  string(v-time, "hh:mm":u ) skip
     1017           "price-doc_not_found"
     1018           price-list.obj-type
     1019           price-list.obj-code
     1020           price-list.doc-num
     1021           price-list.artic
     1022           price-list.prod-type
     1023           price-list.prod-code
     1024           .
     1025         output close .
     1026         if l-fix-errors then do:
     1027           output to fixprcls.fix append .
     1028           export price-list .
     1029           output close .
     1030           find first buf_price-list exclusive-lock
     1031             where recid(buf_price-list) = recid(price-list)
     1032             .
     1033           delete buf_price-list .
     1034         end.
     1035         next .
     1036       end.
