     1143           price-list.obj-code
     1144           price-list.doc-num
     1145           price-list.artic
     1146           price-list.prod-type
     1147           price-list.prod-code
     1148           v-root-b-code
     1149           .
     1150         output close .
     1151       end.
     1152     end.
     1153     if p-install = false
     1154     then do:
     1155       run waitfram-hide in this-procedure .
     1156     end.
     1157   end procedure.
     1158   procedure request-fix-errors :
     1159     if p-install = false then do:
     1160       message
     1161         "Вы хотите исправлять обнаруженные ошибки?" skip
     1162         "Строки переоценок, не принадлежащие переоценкам будут удалены." skip
     1163         "Строки переоценок для специальных цен, в случае если корневая цена" skip
     1164         "отсутствует в переоценке, будут также удалены" skip
     1165         "Удаленные строки будут помещены в файл fixprcls.fix" skip
     1166         "Если вы выберете 'Да', то вам потребуется ввести системный пароль" skip
     1167         view-as alert-box question buttons yes-no update l-fix-errors .
     1168       if l-fix-errors then do:
     1169         run gbl/authoriz.p
     1170           (input  "fixprcls.p:fix"
     1171           ,output l-fix-errors
     1172           ) .
     1173         if l-fix-errors <> true then do:
     1174           message
     1175             "Пароль введен неправильно." skip
     1176             "Будет произведен анализ базы данных." skip
     1177             "Автоматическое исправление ошибок производиться не будет." skip
     1178             view-as alert-box information .
     1179         end.
     1180       end.
     1181     end.
     1182   end procedure.
