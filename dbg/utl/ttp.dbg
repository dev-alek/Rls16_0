        1   block-level on error undo, throw.
        2   define input parameter p-metka as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: c45d016aa072, 1756, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        5   define variable vss-date        as character no-undo init "$Date: Thu Feb 07 16:51:35 2019 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: ttp.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/ttp.p $":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   FUNCTION getFrequency RETURNS INTEGER
       64      ( INPUT pcString        AS CHARACTER,
       65        INPUT pcList          AS CHARACTER,
       66        INPUT plCaseSensitive AS LOGICAL):
       67      IF LENGTH(pcString) > 1  THEN
       68          ASSIGN
       69          pcString = REPLACE (pcString , pcString ,CHR(2) )
       70          pcList   = REPLACE ( pcList , pcString ,CHR(2) ).
       71      IF  NOT plCaseSensitive THEN
       72          ASSIGN
       73              pcString = CAPS(pcString)
       74              pcList   = CAPS(pcList).
       75      IF NUM-ENTRIES(pcList, pcString) > 0 THEN
       76   RETURN NUM-ENTRIES(pcList, pcString) .
       77   ELSE
       78   RETURN 0.
       79      END FUNCTION.
       80      DEFINE VARIABLE hProc AS HANDLE     NO-UNDO.
       81      DEFINE VARIABLE cList AS CHARACTER  NO-UNDO.
       82      DEFINE VARIABLE iCounter AS INTEGER    NO-UNDO.
       83      DEFINE VARIABLE cDelimiter AS CHARACTER  NO-UNDO.
       84      DEFINE VARIABLE cString AS CHARACTER  NO-UNDO.
       85      define variable v-freq as integer no-undo .
       86      define stream LogStream.
       87      ASSIGN
       88        hProc = SESSION:FIRST-PROCEDURE
       89        cList = "":U
       90        cDelimiter = CHR(1)
       91      .
       92      DO WHILE VALID-HANDLE(hProc):
       93          if cList = "":u then do:
       94             assign
       95               cList = hProc:file-name
       96             .
       97          end.
       98          else do:
       99             assign
      100               cList = cList + cDelimiter + hProc:file-name
      101             .
      102          end.
      103          assign
      104            hProc = hProc:next-sibling
      105          .
      106     END.
      107     IF NUM-ENTRIES(clist, cDelimiter) <> 0 THEN
      108         DO iCounter = 1 TO NUM-ENTRIES(clist, cDelimiter):
      109         cString = ENTRY(iCounter, cList, cDelimiter).
      110         v-freq = getFrequency(cString, cList, FALSE).
      111         if v-freq > 1 then do:
      112           OUTPUT stream LogStream TO "memdump.log" APPEND.
      113           put stream LogStream unformatted
      114               "Procedure No.:"   "~t" iCounter "~n"
      115               "Procedure:" "~t" cString "~n"
      116               "Frequency:" "~t"
      117           skip.
      118           output stream LogStream close.
      119         end.
      120      END.
