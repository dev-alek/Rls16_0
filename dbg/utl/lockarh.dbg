        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: lockarh.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/lockarh.p $":U .
        8   define variable vss-description as character no-undo init "Программа блокировки ресурса по расчёту архивов для тестировани ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table userobjs_temp-user-obj no-undo
       80     field obj-type as character
       81     field obj-code as integer
       82     index xpk is primary unique obj-type obj-code
       83     .
       84   procedure userobjs_clear :
       85     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       86     do
       87     on error undo, return error return-value
       88     :
       89       for each buf_userobjs_temp-user-obj
       90       on error undo, return error return-value
       91       :
       92         delete buf_userobjs_temp-user-obj .
       93       end.
       94     end.
       95   end .
       96   procedure userobjs_object-count :
       97     define output parameter p-total-count as integer   no-undo .
       98     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       assign
      103         p-total-count = 0
      104       .
      105       for each buf_userobjs_temp-user-obj
      106       on error undo, return error return-value
      107       :
      108         assign
      109           p-total-count = p-total-count + 1
      110         .
      111       end.
      112     end.
      113   end.
      114   procedure userobjs_append :
      115      define input  parameter p-obj-type as character no-undo .
      116      define input  parameter p-obj-code as integer   no-undo .
      117     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first buf_userobjs_temp-user-obj
      122         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      123           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      124         no-error .
      125       if not available buf_userobjs_temp-user-obj
      126       then do:
      127         create buf_userobjs_temp-user-obj .
      128         assign
      129           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      130           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      131         .
      132       end.
      133     end.
      134   end.
      135   procedure userobjs_object-exist :
      136     define output parameter p-object-exist as logical   no-undo .
      137     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      138     do
      139     on error undo, return error return-value
      140     :
      141       find first buf_userobjs_temp-user-obj
      142         no-error .
      143       if not available buf_userobjs_temp-user-obj
      144       then do:
      145         assign
      146           p-object-exist = false
      147         .
      148       end.
      149       else do:
      150         assign
      151           p-object-exist = true
      152         .
      153       end.
      154     end.
      155   end.
      156   procedure userobjs_transfer :
      157     define input  parameter p-callback-handle as handle no-undo .
      158     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      159     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      160     do
      161     on error undo, return error return-value
      162     :
      163       if valid-handle(p-callback-handle) <> true
      164       then do:
      165         message
      166           vss-workfile vss-revision vss-description skip
      167           "Ошибка задания входных параметров" skip
      168           "Неизвестный указатель на процедуру" skip
      169           view-as alert-box error .
      170         undo, return error return-value .
      171       end.
      172       if p-callback-handle :get-signature("userobjs_append") = ""
      173       then do:
      174         message
      175           vss-workfile vss-revision vss-description skip
      176           "Ошибка задания входных параметров" skip
      177           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      178                     ,p-callback-handle :file-name
      179                     ) skip
      180           view-as alert-box error .
      181         undo, return error return-value .
      182       end.
      183       for each buf_userobjs_temp-user-obj
      184       on error undo, return error return-value
      185       :
      186         run userobjs_append in p-callback-handle
      187           (input  buf_userobjs_temp-user-obj.obj-type
      188           ,input  buf_userobjs_temp-user-obj.obj-code
      189           ) .
      190       end.
      191     end.
      192   end procedure.
      193   procedure userobjs_select-one :
      194      define input  parameter parparentproc     as widget-handle no-undo .
      195      define input  parameter p-db-num          as integer   no-undo .
      196      define input  parameter p-user-id         as character no-undo .
      197      define input  parameter p-host-code-obj   as integer   no-undo .
      198      define input  parameter p-obj-type        as character no-undo .
      199      define input  parameter p-obj-code        as integer   no-undo .
      200      define output parameter p-user-select     as logical   no-undo .
      201      define output parameter p-select-obj-type as character no-undo .
      202      define output parameter p-select-obj-code as character no-undo .
      203     do
      204     on error undo, return error return-value
      205     :
      206       run gbl/userobjs.w
      207         (input  parparentproc
      208         ,input  this-procedure :handle
      209         ,input  p-db-num
      210         ,input  p-user-id
      211         ,input  p-host-code-obj
      212         ,input  p-obj-type
      213         ,input  p-obj-code
      214         ,INPUT  "b-sel"
      215         ,output p-user-select
      216         ,output p-select-obj-type
      217         ,output p-select-obj-code
      218         ) .
      219     end.
      220   end.
      221   procedure userobjs_select-many :
      222     define input  parameter parparentproc   as widget-handle no-undo .
      223     define input  parameter p-db-num        as integer   no-undo .
      224     define input  parameter p-user-id       as character no-undo .
      225     define input  parameter p-host-code-obj as integer   no-undo .
      226     define input  parameter p-obj-type      as character no-undo .
      227     define input  parameter p-obj-code      as integer   no-undo .
      228     define output parameter p-user-select   as logical   no-undo .
      229     define variable v-select-obj-type as character no-undo .
      230     define variable v-select-obj-code as integer   no-undo .
      231     do
      232     on error undo, return error return-value
      233     :
      234       run gbl/userobjs.w
      235         (input  parparentproc
      236         ,input  this-procedure :handle
      237         ,input  p-db-num
      238         ,input  p-user-id
      239         ,input  p-host-code-obj
      240         ,input  p-obj-type
      241         ,input  p-obj-code
      242         ,INPUT  "b-sel,b-mark"
      243         ,output p-user-select
      244         ,output v-select-obj-type
      245         ,output v-select-obj-code
      246         ) .
      247     end.
      248   end.
      249   procedure thobjs :
      250      define input        parameter parparentproc     as widget-handle no-undo .
      251      define input        parameter i-bttns           as character     no-undo .
      252      define input        parameter i-list-mode       as character     no-undo.
      253      define input        parameter i-obj-type        as character     no-undo.
      254      define input        parameter i-db-num          as integer       no-undo.
      255      define input        parameter i-host-code       as integer       no-undo.
      256      define input-output parameter p-rid-list        as character     no-undo .
      257   run ref/thobjs.p
      258           ( input parparentproc
      259            ,input  this-procedure :handle
      260           , input i-bttns
      261           , input i-list-mode
      262           , input i-obj-type
      263           , input i-db-num
      264           , input i-host-code
      265           , input-output p-rid-list ) no-error .
      266   end.
      267   define variable v-host-code   as integer   no-undo .
      268   define variable v-obj-type    as character no-undo .
      269   define variable v-obj-code    as character no-undo .
      270   define variable v-user-select as logical   no-undo .
      271   do
      272   on error undo, return error return-value
      273   :
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275     run mainmenu_getcntxt in parparentproc
      276       (output v-cntxt-db-num
      277       ,output v-cntxt-userid
      278       ,output v-cntxt-level
      279       ,output v-cntxt-host-code-obj
      280       ,output v-cntxt-obj-type
      281       ,output v-cntxt-obj-code
      282       ,output v-cntxt-db-num-obj
      283       ,output v-cntxt-is-admin
      284       ) .
      285   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      287     (input  v-cntxt-obj-type
      288     ,input  v-cntxt-obj-code
      289     ,output v-host-code
      290     )  .
      291   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   run userobjs_select-one in this-procedure
      293     (input  parparentproc
      294     ,input  v-cntxt-db-num
      295     ,input  v-cntxt-userid
      296     ,input  v-host-code
      297     ,input  v-cntxt-obj-type
      298     ,input  v-cntxt-obj-code
      299     ,output v-user-select
      300     ,output v-obj-type
      301     ,output v-obj-code
      302     )  .
      303     if v-user-select <> true
      304     then do:
      305       message
      306         "Объект не выбран" skip
      307         view-as alert-box information .
      308       undo, return error "Объект не выбран" .
      309     end.
      310     define variable v-num as integer   no-undo .
      311     run gbl/d-askw.w
      312       (input "Выбор типа архива"
      313       ,input "Выберите тип архива для блокировки"
      314       ,input "|^"
      315       ,input "Складской архив по товарам" + '|':u
      316         + "Складской архив по поставщикам" + '|':u
      317         + "Складской архив по типам приобретения" + '|':u
      318         + "Отказ"
      319       ,input '|':u
      320         + '|':u
      321         + '|':u
      322         + ''
      323       ,input 1
      324       ,input 4
      325       ,output v-num
      326       ).
      327     case v-num
      328     :
      329       when 1
      330       then do:
      331         define buffer calc-arh-lock_batchprocess for ub.batchprocess .
      332         run gbl/lock-prc.p
      333           (input  'btpr':U
      334           ,input  v-obj-code
      335           ,input  0
      336           ,input  0
      337           ,input  v-obj-type
      338           ,input  ""
      339           ,input  ""
      340           ,input  "Объект,,, ,,,Расчет складского архива по товарам"
      341           ,input  true
      342           ,buffer calc-arh-lock_batchprocess
      343           ) .
      344         message
      345           "Расчет складского архива по товарам заблокирован" skip
      346           "Объект" v-obj-type v-obj-code skip
      347           view-as alert-box .
      348       end.
      349       when 2
      350       then do:
      351         define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
      352         run gbl/lock-prc.p
      353           (input  'ahsp':U
      354           ,input  v-obj-code
      355           ,input  0
      356           ,input  0
      357           ,input  v-obj-type
      358           ,input  ""
      359           ,input  ""
      360           ,input  "Объект,,, ,,,Расчет складского архива по поставщикам"
      361           ,input  false
      362           ,buffer calc-supp-arh-lock_batchprocess
      363           ) .
      364         message
      365           "Расчет складского архива по поставщикам заблокирован" skip
      366           "Объект" v-obj-type v-obj-code skip
      367           view-as alert-box .
      368       end.
      369       when 3
      370       then do:
      371         define buffer calc-aht-lock_batchprocess for ub.batchprocess .
      372         run gbl/lock-prc.p
      373           (input  'ahtb':U
      374           ,input  v-obj-code
      375           ,input  0
      376           ,input  0
      377           ,input  v-obj-type
      378           ,input  ""
      379           ,input  ""
      380           ,input  "Объект,,, ,,,Расчет складского архива по типам приобретения"
      381           ,input  false
      382           ,buffer calc-aht-lock_batchprocess
      383           ) .
      384         message
      385           "Расчет складского архива по типам приобретения заблокирован" skip
      386           "Объект" v-obj-type v-obj-code skip
      387           view-as alert-box .
      388       end.
      389       when 4
      390       then do:
      391         return .
      392       end.
      393       otherwise do:
      394         message
      395           vss-workfile vss-revision vss-description skip
      396           "Внутренняя ошибка" skip
      397           "Неизвестное значение переменной v-num" skip
      398           view-as alert-box error .
      399       end.
      400     end.
      401   end.
