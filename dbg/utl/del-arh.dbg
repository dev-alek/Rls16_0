     1087   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1089     (input  v-obj-type
     1090     ,input  v-obj-code
     1091     ,output v-today
     1092     )  .
     1093     define variable v-attr-value as character no-undo .
     1094     define variable v-attr-type  as character no-undo .
     1095     define variable v-arh-calc          as logical   no-undo .
     1096     define variable v-arh-del           as logical   no-undo .
     1097     define variable v-arh-start-date    as date      no-undo .
     1098     define variable v-arh-detail-date   as date      no-undo .
     1099     define variable v-arh-recalc-date   as date      no-undo .
     1100     run clntattr-value in this-procedure
     1101       (input  v-obj-type
     1102       ,input  v-obj-code
     1103       ,input  'arh-calc':U
     1104       ,output v-attr-value
     1105       ,output v-attr-type
     1106       ) .
     1107     assign
     1108       v-arh-calc = (lookup(v-attr-value, 'yes,true') > 0)
     1109     .
     1110     run clntattr-value in this-procedure
     1111       (input  v-obj-type
     1112       ,input  v-obj-code
     1113       ,input  'arh-del':U
     1114       ,output v-attr-value
     1115       ,output v-attr-type
     1116       ) .
     1117     assign
     1118       v-arh-del = (lookup(v-attr-value, 'yes,true') > 0)
     1119     .
     1120     run clntattr-value in this-procedure
     1121       (input  v-obj-type
     1122       ,input  v-obj-code
     1123       ,input  'arh-start':U
     1124       ,output v-attr-value
     1125       ,output v-attr-type
     1126       ) .
     1127     assign
     1128       v-arh-start-date = date(v-attr-value)
     1129     .
     1130     run clntattr-value in this-procedure
     1131       (input  v-obj-type
     1132       ,input  v-obj-code
     1133       ,input  'arh-detail':U
     1134       ,output v-attr-value
     1135       ,output v-attr-type
     1136       ) .
     1137     assign
     1138       v-arh-detail-date = date(v-attr-value)
     1139     .
     1140     run clntattr-value in this-procedure
     1141       (input  v-obj-type
     1142       ,input  v-obj-code
     1143       ,input  'arh-recalc':U
     1144       ,output v-attr-value
     1145       ,output v-attr-type
     1146       ) .
     1147     assign
     1148       v-arh-recalc-date = date(v-attr-value)
     1149     .
     1150     define variable v-month     as integer   no-undo .
     1151     define variable v-new-month as integer   no-undo .
     1152     define variable v-day       as integer   no-undo .
     1153     define variable v-year      as integer   no-undo .
     1154     assign
     1155       v-month = month(v-arh-detail-date)
     1156       v-year  = year(v-arh-detail-date)
     1157     .
     1158     assign
     1159       v-month = v-month + 1
     1160     .
     1161     if v-month > 12
     1162     then do:
     1163       assign
     1164         v-month = 1
     1165         v-year  = v-year + 1
     1166       .
     1167     end.
     1168     run gbl/d-inpmnt.w
     1169       (input        "Введите месяц и год"
     1170       ,input        ?
     1171       ,input-output v-month
     1172       ,input-output v-year
     1173       ,output       v-ok
     1174       ).
     1175     if v-ok <> true
     1176     then do:
     1177       message
     1178         "Дата очистки складского архива по товарам не задана" skip
     1179         view-as alert-box information .
     1180       undo, return error .
     1181     end.
     1182     assign
     1183       v-new-detail-date = date(v-month, 1, v-year)
     1184     .
     1185     define variable v-num as integer   no-undo .
     1186     run gbl/d-askw.w
     1187       (input "Вопрос"
     1188       ,input "Выберите способ удаления складского архива по товарам" + chr(10)
     1189             + "Новая дата начала подробного складского архива по товарам " + string(v-new-detail-date, '99/99/9999':u) + chr(10)
     1190             + "Сегодня " + string(v-today, '99/99/9999':u) + chr(10)
     1191       ,input "|^"
     1192       ,input "Удаление подробной информации" + '^confirm|':u
     1193           + "Полная очистка складского архива по товарам" + '^confirm|':u
     1194           + "Отказ"
     1195       ,input "" + '|':u
     1196           + "" + '|':u
     1197           + ""
     1198       ,input 1
     1199       ,input 3
     1200       ,output v-num
     1201       ).
     1202     case v-num :
     1203       when 1
     1204       then do:
     1205         assign
     1206           v-clear-archive = false
     1207         .
     1208       end.
     1209       when 2
     1210       then do:
     1211         assign
     1212           v-clear-archive = true
     1213         .
     1214       end.
     1215       when 3
     1216       then do:
     1217         return .
     1218       end.
     1219       otherwise do:
     1220         message
     1221           vss-workfile vss-revision vss-description skip
     1222           "Ошибка при выборе способа очистки складского архива по товарам" skip
     1223           view-as alert-box error .
     1224         undo, return error .
     1225       end.
     1226     end case .
     1227     if v-arh-calc = true
     1228     then do:
     1229       message
     1230         "Складской архив по товарам" skip
     1231         "Объект" v-obj-type v-obj-code skip
     1232         "Невозможно произвести удаление складского архива по товарам" skip
     1233         "Складской архив не рассчитан" skip
     1234         view-as alert-box error .
     1235       undo, return error return-value .
     1236     end.
     1237     if v-arh-del = true
     1238     then do:
     1239       message
     1240         "Складской архив по товарам" skip
     1241         "Объект" v-obj-type v-obj-code skip
     1242         "Невозможно произвести удаление складского архива" skip
     1243         "Остатки имеют неопределенное значение" skip
     1244         "Возможные пути решения: повторная инициализация складского архива" skip
     1245         "или восстановление складского архива из файла в случае ошибки удаления" skip
     1246         view-as alert-box error .
     1247       undo, return error return-value .
     1248     end.
     1249     if (v-arh-start-date <> ?
     1250        and v-arh-detail-date = ?)
     1251     or (v-arh-start-date = ?
     1252        and v-arh-detail-date <> ?)
     1253     then do:
     1254       message
     1255         "Невозможно произвести удаление складского архива по товарам" skip
     1256         "Складской архив по товарам" skip
     1257         "Объект" v-obj-type v-obj-code skip
     1258         "Противоречивая информация в датах инициализации складского архива по товарам" skip
     1259         "Дата начала складского архива по товарам" string(v-arh-start-date, '99/99/9999':u) skip
     1260         "Дата начала подробного складского архива по товарам" string(v-arh-detail-date, '99/99/9999':u) skip
     1261         view-as alert-box error .
     1262       undo, return error return-value .
     1263     end.
     1264     if  v-arh-recalc-date <> ?
     1265     and v-arh-detail-date <> ?
     1266     and v-arh-recalc-date < v-arh-detail-date
     1267     then do:
     1268       message
     1269         "Невозможно произвести удаление складского архива по товарам" skip
     1270         "Складской архив по товарам" skip
     1271         "Объект" v-obj-type v-obj-code skip
     1272         "Дата перерасчета складского архива по товарам раньше, чем начало подробного складского архива" skip
     1273         "Возможные пути решения: повторная инициализация складского архива по товарам" skip
     1274         "Дата перерасчета складского архива по товарам" string(v-arh-recalc-date, '99/99/9999':u) skip
     1275         "Дата начала подробного складского архива по товарам" v-arh-detail-date skip
     1276         view-as alert-box error .
     1277       undo, return error return-value .
     1278     end.
     1279     if v-clear-archive = true
     1280     then do:
     1281       assign
     1282         v-new-start-date = v-new-detail-date
     1283       .
     1284     end.
     1285     else do:
     1286       if v-arh-start-date <> ?
     1287       then do:
     1288         assign
     1289           v-new-start-date = v-arh-start-date
     1290         .
     1291       end.
     1292       else do:
     1293         run find-arh-start-date in this-procedure
     1294           (input  v-obj-type
     1295           ,input  v-obj-code
     1296           ,input  v-new-detail-date
     1297           ,output v-new-start-date
     1298           ) .
     1299       end.
     1300     end.
     1301     run trg/bt_arh.p
     1302       (input v-obj-type
     1303       ,input v-obj-code
     1304       ,input v-new-detail-date
     1305       ,input true
     1306       ,input v-cntxt-db-num
     1307       ,input v-cntxt-userid
     1308       ) .
     1309     assign
     1310       v-year  = year(v-new-detail-date)
     1311       v-month = month(v-new-detail-date)
     1312       v-day   = day(v-new-detail-date)
     1313     .
     1314     assign
     1315       v-file-name = 'arhdel':u
     1316                   + '_':u
     1317                   + (if v-obj-type = 'скл':U then 'stock':u else 'shop':u)
     1318                   + '_':u
     1319                   + string(v-obj-code)
     1320                   + '_':u
     1321                   + string(v-year, '9999':u)
     1322                   + string(v-month, '99':u)
     1323                   + string(v-day, '99':u)
     1324                   + '.txt'
     1325     .
     1326     assign
     1327       v-ok = false
     1328     .
     1329     message
     1330       "ВНИМАНИЕ!" skip
     1331       "Последнее предупреждение перед удалением складского архива по товарам" skip
     1332       "" (if v-clear-archive = true then "ПОЛНАЯ ОЧИСТКА АРХИВОВ" else "УДАЛЕНИЕ ПОДРОБНОЙ ИНФОРМАЦИИ" ) skip
     1333       "Старая дата начала складского архива по товарам" string(v-arh-start-date, '99/99/9999':u) skip
     1334       "Старая дата начала подробного складского архива по товарам" string(v-arh-detail-date, '99/99/9999':u) skip
     1335       "" skip
     1336       "Новая дата начала складского архива по товарам" string(v-new-start-date, '99/99/9999':u) skip
     1337       "Новая дата начала подробного складского архива по товарам" string(v-new-detail-date, '99/99/9999':u) skip
     1338       "Сегодня" string(v-today, '99/99/9999':u) skip
     1339       "Удаленные данные будут сохранены в файле" v-file-name skip
     1340       "Продолжить?" skip
     1341       view-as alert-box question buttons yes-no update v-ok .
     1342     if v-ok <> true
     1343     then do:
     1344       return .
     1345     end.
     1346     define variable v-start-time     as integer   no-undo .
     1347     define variable v-current-time   as character no-undo .
     1348     define variable v-current-action as character no-undo .
     1349     define variable v-count          as integer   no-undo .
     1350     define variable v-sub-action     as character no-undo .
     1351     define frame a
     1352       v-obj-type       label "Объект"
     1353       v-obj-code       no-label skip
     1354       v-current-action format "x(40)" no-label skip
     1355       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
     1356       v-count          format ">>>,>>>,>>9" no-label skip
     1357       v-sub-action     format "x(40)" no-label skip
     1358       with view-as dialog-box side-labels three-d
     1359       title "Удаление складского архива по товарам"
     1360       .
     1361     assign
     1362       v-start-time = time
     1363     .
     1364     view frame a .
     1365     display
     1366       v-obj-type
     1367       v-obj-code
     1368       with frame a .
     1369     define variable v-fact-order           as decimal   no-undo .
     1370     define variable v-shift-end-fact-order as decimal   no-undo .
     1371     define variable v-day-end-fact-order   as decimal   no-undo .
     1372     define variable v-archive-date         as date      no-undo .
     1373     assign
     1374       v-archive-date = v-new-detail-date - 1
     1375     .
     1376     run factord in this-procedure
     1377       (input  v-archive-date
     1378       ,input  1
     1379       ,input  1
     1380       ,input  ?
     1381       ,input  0
     1382       ,input  false
     1383       ,output v-fact-order
     1384       ,output v-shift-end-fact-order
     1385       ,output v-day-end-fact-order
     1386       ) no-error .
     1387     if error-status :error
     1388     then do:
     1389       message
     1390         vss-workfile vss-revision vss-description skip
     1391         "Ошибка при вызове процедуры factord"
     1392         error-status :get-message(1) skip
     1393         return-value skip
     1394         view-as alert-box error .
     1395       undo, return error .
     1396     end.
     1397     run create-log-file in this-procedure
     1398       (input v-obj-type
     1399       ,input v-obj-code
     1400       ,input v-arh-start-date
     1401       ,input v-arh-detail-date
     1402       ,input v-new-start-date
     1403       ,input v-new-detail-date
     1404       ,input v-file-name
     1405       ) no-error .
     1406     if error-status :error
     1407     then do:
     1408       message
     1409         vss-workfile vss-revision vss-description skip
     1410         "Ошибка при создании файла архивации" skip
     1411         "Имя файла архивации" v-file-name skip
     1412         error-status :get-message(1) skip
     1413         return-value skip
     1414         view-as alert-box error .
     1415       undo, return error .
     1416     end.
     1417     run trg/arhclr.p
     1418       (input v-obj-type
     1419       ,input v-obj-code
     1420       ,input 0
     1421       ,input v-day-end-fact-order
     1422       ,input v-file-name
     1423       ) no-error .
     1424     if error-status :error
     1425     then do:
     1426       message
     1427         vss-workfile vss-revision vss-description skip
     1428         "Ошибка при cохранении складского архива по товарам"
     1429         error-status :get-message(1) skip
     1430         return-value skip
     1431         view-as alert-box error .
     1432       undo, return error .
     1433     end.
     1434     run close-log-file in this-procedure
     1435       (input v-obj-type
     1436       ,input v-obj-code
     1437       ,input v-arh-start-date
     1438       ,input v-arh-detail-date
     1439       ,input v-new-start-date
     1440       ,input v-new-detail-date
     1441       ,input v-file-name
     1442       ) no-error .
     1443     if error-status :error
     1444     then do:
     1445       message
     1446         vss-workfile vss-revision vss-description skip
     1447         "Ошибка при закрытии файла архивации" skip
     1448         "Имя файла архивации" v-file-name skip
     1449         error-status :get-message(1) skip
     1450         return-value skip
     1451         view-as alert-box error .
     1452       undo, return error .
     1453     end.
     1454     define variable v-md5-signature as character no-undo .
     1455     run gbl/md5.p
     1456       (input  v-file-name
     1457       ,output v-md5-signature
     1458       ) .
     1459     define variable v-create-chip-num as integer   no-undo .
     1460     define variable v-action-type     as character no-undo .
     1461     if v-clear-archive = true
     1462     then do:
     1463       assign
     1464         v-action-type = 'delall-start':U
     1465       .
     1466     end.
     1467     else do:
     1468       assign
     1469         v-action-type = 'deldet-start':U
     1470       .
     1471     end.
     1472     run utl/arhiscr.p
     1473       (input  v-obj-type
     1474       ,input  v-obj-code
     1475       ,input  'arh':U
     1476       ,input  v-action-type
     1477       ,input  v-file-name
     1478       ,input  v-md5-signature
     1479       ,input  0
     1480       ,input  ""
     1481       ,input  ""
     1482       ,input  v-new-detail-date
     1483       ,output v-create-chip-num
     1484       ) .
     1485     define buffer lock_shift-obj for ub.shift-obj .
     1486     run factord-lock-shift in this-procedure
     1487       (input  v-obj-type
     1488       ,input  v-obj-code
     1489       ,input  v-archive-date
     1490       ,buffer lock_shift-obj
     1491       ) no-error .
     1492     if error-status :error
     1493     then do:
     1494      define variable v-err as character no-undo .
     1495      v-err = substitute("Ошибка при блокировке смены на объекте &2&3 дата &1" , v-archive-date, v-obj-type , v-obj-code  ) .
     1496      run create-log-err in this-procedure
     1497         ( v-obj-type ,
     1498           v-obj-code ,
     1499           v-file-name ,
     1500           v-err  ).
     1501       undo, return error v-err .
     1502     end.
     1503     run ahrstutl-init in this-procedure
     1504       (input v-obj-type
     1505       ,input v-obj-code
     1506       ,input v-archive-date
     1507       ) .
     1508     run ahrstutl-store in this-procedure
     1509       (input v-obj-type
     1510       ,input v-obj-code
     1511       ,input v-archive-date
     1512       ) .
     1513     do transaction
     1514     on error undo, return error return-value
     1515     :
     1516       run clntattr-write in this-procedure
     1517         (input v-obj-type
     1518         ,input v-obj-code
     1519         ,input 'arh-start':U
     1520         ,input string(v-new-start-date, '99/99/9999':u)
     1521         ) no-error .
     1522       if error-status :error
     1523       then do:
     1524         message
     1525           vss-workfile vss-revision vss-description skip
     1526           "Ошибка при записи даты инициализации складского архива" skip
     1527           error-status :get-message(1) skip
     1528           return-value skip
     1529           view-as alert-box error .
     1530         undo, return error .
     1531       end.
     1532       run clntattr-write in this-procedure
     1533         (input v-obj-type
     1534         ,input v-obj-code
     1535         ,input 'arh-detail':U
     1536         ,input string(v-new-detail-date, '99/99/9999':u)
     1537         ) no-error .
     1538       if error-status :error
     1539       then do:
     1540         message
     1541           vss-workfile vss-revision vss-description skip
     1542           "Ошибка при записи даты инициализации складского архива" skip
     1543           error-status :get-message(1) skip
     1544           return-value skip
     1545           view-as alert-box error .
     1546         undo, return error .
     1547       end.
     1548       run clntattr-write in this-procedure
     1549         (input v-obj-type
     1550         ,input v-obj-code
     1551         ,input 'arh-rest':U
     1552         ,input 'true':u
     1553         ) .
     1554     end.
     1555     find current calc-arh-lock_batchprocess no-lock .
     1556     if v-clear-archive = true
     1557     then do:
     1558       run ahrstutl-clear-arh in this-procedure
     1559         (input  v-obj-type
     1560         ,input  v-obj-code
     1561         ,input  v-archive-date
     1562         ) .
     1563     end.
     1564     else do:
     1565       run utl/cmprarh.p
     1566         (input v-obj-type
     1567         ,input v-obj-code
     1568         ,input 0
     1569         ,input v-day-end-fact-order
     1570         )  no-error .
     1571       if error-status :error
     1572       then do:
     1573         message
     1574           vss-workfile vss-revision vss-description skip
     1575           "Ошибка при удалении складского архива по товарам" skip
     1576           error-status :get-message(1) skip
     1577           return-value skip
     1578           view-as alert-box error .
     1579         undo, return error .
     1580       end.
     1581     end.
     1582     define variable v-delete-attr-arh-del as logical   no-undo .
     1583     run clntattr-delete in this-procedure
     1584       (input v-obj-type
     1585       ,input v-obj-code
     1586       ,input 'arh-rest':U
     1587       ,output v-delete-attr-arh-del
     1588       ) .
     1589     if v-clear-archive = true
     1590     then do:
     1591       assign
     1592         v-action-type = 'delall-stop':U
     1593       .
     1594     end.
     1595     else do:
     1596       assign
     1597         v-action-type = 'deldet-stop':U
     1598       .
     1599     end.
     1600     run utl/arhiscr.p
     1601       (input  v-obj-type
     1602       ,input  v-obj-code
     1603       ,input  'arh':U
     1604       ,input  v-action-type
     1605       ,input  ""
     1606       ,input  ""
     1607       ,input  0
     1608       ,input  ""
     1609       ,input  ""
     1610       ,input  v-new-detail-date
     1611       ,output v-create-chip-num
     1612       ) .
     1613     message
     1614       "Удаление складского архива по товарам успешно закончилось" skip
     1615       "Сохраните файл" v-file-name "в надёжном месте" skip
     1616       "Затем вы можете восстановить складской архив по товарам на основании файла" skip
     1617       "На объекте существует складской архив по товарам с даты" string(v-new-start-date, '99/99/9999':u) skip
     1618       "На объекте существует подробный складской архив по товарам с даты" string(v-new-detail-date, '99/99/9999':u) skip
     1619       view-as alert-box information .
     1620   end.
     1621   procedure create-log-file :
     1622     define input  parameter p-obj-type        as character no-undo .
     1623     define input  parameter p-obj-code        as integer   no-undo .
     1624     define input  parameter p-arh-start-date  as date      no-undo .
     1625     define input  parameter p-arh-detail-date as date      no-undo .
     1626     define input  parameter p-new-start-date  as date      no-undo .
     1627     define input  parameter p-new-detail-date as date      no-undo .
     1628     define input  parameter p-file-name       as character no-undo .
     1629     do
     1630     on error undo, return error
     1631     :
     1632       output stream slog to value(p-file-name) .
     1633       export stream slog 'archive-log-version':u '2.1':u .
     1634       export stream slog 'obj-type':u            p-obj-type .
     1635       export stream slog 'obj-code':u            string(p-obj-code) .
     1636       export stream slog 'old-start-date':u      string(p-arh-start-date, '99/99/9999':u ) .
     1637       export stream slog 'old-detail-date':u     string(p-arh-detail-date, '99/99/9999':u ) .
     1638       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     1639       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     1640       output stream slog close .
     1641     end.
     1642   end procedure.
     1643   procedure close-log-file :
     1644     define input  parameter p-obj-type        as character no-undo .
     1645     define input  parameter p-obj-code        as integer   no-undo .
     1646     define input  parameter p-arh-start-date  as date      no-undo .
     1647     define input  parameter p-arh-detail-date as date      no-undo .
     1648     define input  parameter p-new-start-date  as date      no-undo .
     1649     define input  parameter p-new-detail-date as date      no-undo .
     1650     define input  parameter p-file-name       as character no-undo .
     1651     do
     1652     on error undo, return error
     1653     :
     1654       output stream slog to value(p-file-name) append .
     1655       export stream slog 'end-of-log':u .
     1656       export stream slog 'archive-log-version':u '2.1':u .
     1657       export stream slog 'obj-type':u            p-obj-type .
     1658       export stream slog 'obj-code':u            string(p-obj-code) .
     1659       export stream slog 'old-start-date':u      string(p-arh-start-date, '99/99/9999':u ) .
     1660       export stream slog 'old-detail-date':u     string(p-arh-detail-date, '99/99/9999':u ) .
     1661       export stream slog 'new-start-date':u      string(p-new-start-date, '99/99/9999':u ) .
     1662       export stream slog 'new-detail-date':u     string(p-new-detail-date, '99/99/9999':u ) .
     1663       export stream slog '.':u                   .
     1664       output stream slog close .
     1665     end.
     1666   end procedure.
     1667   procedure find-arh-start-date :
     1668     define input  parameter p-obj-type        as character no-undo .
     1669     define input  parameter p-obj-code        as integer   no-undo .
     1670     define input  parameter p-new-detail-date as date      no-undo .
     1671     define output parameter p-new-start-date  as date      no-undo .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       define buffer buf_stk-tot for ub.stk-tot .
     1676       find first buf_stk-tot no-lock
     1677         where buf_stk-tot.obj-type  = p-obj-type
     1678           and buf_stk-tot.obj-code  = p-obj-code
     1679           and buf_stk-tot.sum-type  = 'crsa':U
     1680           and buf_stk-tot.cat-id    = '##,##':U
     1681           and buf_stk-tot.fact-date <> ?
     1682         use-index category
     1683         no-error .
     1684       if  available buf_stk-tot
     1685       and buf_stk-tot.fact-date <= p-new-detail-date
     1686       then do:
     1687         assign
     1688           p-new-start-date = buf_stk-tot.fact-date
     1689         .
     1690       end.
     1691       else do:
     1692         assign
     1693           p-new-start-date = p-new-detail-date
     1694         .
     1695       end.
     1696     end.
     1697   end procedure.
     1698   procedure show-action :
     1699     do
     1700     on error undo, return error
     1701     :
     1702       define input parameter p-action as character no-undo .
     1703       assign
     1704         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1705         v-current-action = p-action
     1706       .
     1707       display
     1708         v-current-time
     1709         v-current-action
     1710         with frame a.
     1711     end.
     1712   end procedure.
     1713   procedure show-count :
     1714     define input  parameter p-count      as integer   no-undo .
     1715     define input  parameter p-sub-action as character no-undo .
     1716     do
     1717     on error undo, return error
     1718     :
     1719       assign
     1720         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1721         v-count        = p-count
     1722         v-sub-action   = p-sub-action
     1723       .
     1724       display
     1725         v-current-time
     1726         v-count
     1727         v-sub-action
     1728         with frame a.
     1729     end.
     1730   end procedure.
     1731   define temp-table temp-stk-tot no-undo like ub.stk-tot   field new-fact-qnty      like ub.stk-tot.fact-qnty            field new-sum-base       like ub.stk-tot.sum-base             field new-sum-rubl       like ub.stk-tot.sum-rubl             field new-vat-base       like ub.stk-tot.vat-base             field new-vat-rubl       like ub.stk-tot.vat-rubl             field new-slt-base       like ub.stk-tot.slt-base             field new-slt-rubl       like ub.stk-tot.slt-rubl             field new-road-tax-base  like ub.stk-tot.road-tax-base        field new-road-tax-rubl  like ub.stk-tot.road-tax-rubl        field new-excise-base    like ub.stk-tot.excise-base          field new-excise-rubl    like ub.stk-tot.excise-rubl          field new-transport-base like ub.stk-tot.transport-base       field new-transport-rubl like ub.stk-tot.transport-rubl       field new-other-base     like ub.stk-tot.other-base           field new-other-rubl     like ub.stk-tot.other-rubl         index pi is primary unique  obj-type obj-code fact-order sum-type cat-id   index category          obj-type obj-code sum-type cat-id fact-order   index sum-type          sum-type cat-id .
     1732   define temp-table temp-stk-line no-undo like ub.stk-line   field new-fact-qnty      like ub.stk-line.fact-qnty            field new-sum-base       like ub.stk-line.sum-base             field new-sum-rubl       like ub.stk-line.sum-rubl             field new-vat-base       like ub.stk-line.vat-base             field new-vat-rubl       like ub.stk-line.vat-rubl             field new-slt-base       like ub.stk-line.slt-base             field new-slt-rubl       like ub.stk-line.slt-rubl             field new-road-tax-base  like ub.stk-line.road-tax-base        field new-road-tax-rubl  like ub.stk-line.road-tax-rubl        field new-excise-base    like ub.stk-line.excise-base          field new-excise-rubl    like ub.stk-line.excise-rubl          field new-transport-base like ub.stk-line.transport-base       field new-transport-rubl like ub.stk-line.transport-rubl       field new-other-base     like ub.stk-line.other-base           field new-other-rubl     like ub.stk-line.other-rubl         index pi is primary unique  obj-type obj-code artic prod-type prod-code fact-order sum-type cat-id   index category          obj-type obj-code artic prod-type prod-code sum-type cat-id fact-order   index sum-type          sum-type cat-id .
     1733   define temp-table temp-shift-stk-tot no-undo like ub.stk-tot   field new-fact-qnty      like ub.stk-tot.fact-qnty            field new-sum-base       like ub.stk-tot.sum-base             field new-sum-rubl       like ub.stk-tot.sum-rubl             field new-vat-base       like ub.stk-tot.vat-base             field new-vat-rubl       like ub.stk-tot.vat-rubl             field new-slt-base       like ub.stk-tot.slt-base             field new-slt-rubl       like ub.stk-tot.slt-rubl             field new-road-tax-base  like ub.stk-tot.road-tax-base        field new-road-tax-rubl  like ub.stk-tot.road-tax-rubl        field new-excise-base    like ub.stk-tot.excise-base          field new-excise-rubl    like ub.stk-tot.excise-rubl          field new-transport-base like ub.stk-tot.transport-base       field new-transport-rubl like ub.stk-tot.transport-rubl       field new-other-base     like ub.stk-tot.other-base           field new-other-rubl     like ub.stk-tot.other-rubl         index pi is primary unique  obj-type obj-code fact-order sum-type cat-id   index category          obj-type obj-code sum-type cat-id fact-order   index sum-type sum-type cat-id .
     1734   define temp-table temp-shift-stk-line no-undo like ub.stk-line   field new-fact-qnty      like ub.stk-line.fact-qnty            field new-sum-base       like ub.stk-line.sum-base             field new-sum-rubl       like ub.stk-line.sum-rubl             field new-vat-base       like ub.stk-line.vat-base             field new-vat-rubl       like ub.stk-line.vat-rubl             field new-slt-base       like ub.stk-line.slt-base             field new-slt-rubl       like ub.stk-line.slt-rubl             field new-road-tax-base  like ub.stk-line.road-tax-base        field new-road-tax-rubl  like ub.stk-line.road-tax-rubl        field new-excise-base    like ub.stk-line.excise-base          field new-excise-rubl    like ub.stk-line.excise-rubl          field new-transport-base like ub.stk-line.transport-base       field new-transport-rubl like ub.stk-line.transport-rubl       field new-other-base     like ub.stk-line.other-base           field new-other-rubl     like ub.stk-line.other-rubl         index pi is primary unique  obj-type obj-code artic prod-type prod-code fact-order sum-type cat-id   index category          obj-type obj-code artic prod-type prod-code sum-type cat-id fact-order   index sum-type          sum-type cat-id .
     1735   procedure ahrstutl-init :
     1736     define input  parameter p-obj-type           as character no-undo .
     1737     define input  parameter p-obj-code           as integer   no-undo .
     1738     define input  parameter p-fact-date          as date      no-undo .
     1739     define buffer buf_gds-obj for ub.gds-obj .
     1740     define buffer buf_goods   for ub.goods .
     1741     define variable v-shift-on             as logical   no-undo .
     1742     define variable v-shift-date           as date      no-undo .
     1743     define variable v-shift-num            as integer   no-undo .
     1744     define variable v-day-end-fact-order   as decimal   no-undo .
     1745     define variable v-shift-end-fact-order as decimal   no-undo .
     1746     define variable v-sum-type-list as character no-undo .
     1747     do
     1748     on error undo, return error
     1749     :
     1750       run factord-cut-archive in this-procedure
     1751         (input  p-obj-type
     1752         ,input  p-obj-code
     1753         ,input  p-fact-date
     1754         ,output v-shift-on
     1755         ,output v-shift-date
     1756         ,output v-shift-num
     1757         ,output v-day-end-fact-order
     1758         ,output v-shift-end-fact-order
     1759         ) .
     1760       define variable v-ind as integer   no-undo .
     1761       run show-action in this-procedure
     1762         (input "Остаток по объекту"
     1763         ).
     1764       run ahrstutl-tot-sum-type-list in this-procedure
     1765         (output v-sum-type-list
     1766         ) .
     1767       do v-ind = 1 to num-entries(v-sum-type-list)
     1768       :
     1769         run ahrstutl-init-tot in this-procedure
     1770           (input p-obj-type
     1771           ,input p-obj-code
     1772           ,input entry(v-ind, v-sum-type-list)
     1773           ,input p-fact-date
     1774           ,input v-day-end-fact-order
     1775           ,input v-shift-on
     1776           ,input v-shift-date
     1777           ,input v-shift-num
     1778           ,input v-shift-end-fact-order
     1779           ) .
     1780       end.
     1781       run show-action in this-procedure
     1782         (input "Остаток по товарам"
     1783         ).
     1784       define variable v-total-count as integer   no-undo .
     1785       for each buf_gds-obj no-lock
     1786         where buf_gds-obj.obj-type = p-obj-type
     1787           and buf_gds-obj.obj-code = p-obj-code
     1788       on error undo, return error
     1789       :
     1790         assign
     1791           v-total-count = v-total-count + 1
     1792         .
     1793         if v-total-count modulo 10 = 0
     1794         then do:
     1795           run show-count in this-procedure
     1796             (input v-total-count
     1797             ,input "Артикул " + string(buf_gds-obj.artic)
     1798             ).
     1799         end.
     1800         find first buf_goods no-lock
     1801           where buf_goods.artic     = buf_gds-obj.artic
     1802             and buf_goods.prod-type = buf_gds-obj.prod-type
     1803             and buf_goods.prod-code = buf_gds-obj.prod-code
     1804           .
     1805         run ahrstutl-line-sum-type-list in this-procedure
     1806           (input buf_goods.gds-type = 'т':U
     1807           ,output v-sum-type-list
     1808           ) .
     1809         do v-ind = 1 to num-entries(v-sum-type-list)
     1810         :
     1811           run ahrstutl-init-line in this-procedure
     1812             (input p-obj-type
     1813             ,input p-obj-code
     1814             ,input buf_gds-obj.artic
     1815             ,input buf_gds-obj.prod-type
     1816             ,input buf_gds-obj.prod-code
     1817             ,input entry(v-ind, v-sum-type-list)
     1818             ,input p-fact-date
     1819             ,input v-day-end-fact-order
     1820             ,input v-shift-on
     1821             ,input v-shift-date
     1822             ,input v-shift-num
     1823             ,input v-shift-end-fact-order
     1824             ) .
     1825         end.
     1826       end.
     1827     end.
     1828   end procedure.
     1829   procedure ahrstutl-init-tot :
     1830     define input  parameter p-obj-type                 as character no-undo .
     1831     define input  parameter p-obj-code                 as integer   no-undo .
     1832     define input  parameter p-root-sum-type            as character no-undo .
     1833     define input  parameter p-fact-date                as date      no-undo .
     1834     define input  parameter p-stk-tot-fact-order       as decimal   no-undo .
     1835     define input  parameter p-shift-on                 as logical   no-undo .
     1836     define input  parameter p-shift-date               as date      no-undo .
     1837     define input  parameter p-shift-num                as integer   no-undo .
     1838     define input  parameter p-shift-stk-tot-fact-order as decimal   no-undo .
     1839     define buffer buf_stk-tot for ub.stk-tot .
     1840     define buffer buf_temp-stk-tot for temp-stk-tot .
     1841     define buffer buf_shift-stk-tot for ub.stk-tot .
     1842     define buffer buf_temp-shift-stk-tot for temp-shift-stk-tot .
     1843     define variable v-prev-stk-tot-fact-order       as decimal   no-undo .
     1844     define variable v-prev-shift-stk-tot-fact-order as decimal   no-undo .
     1845     do
     1846     on error undo, return error return-value
     1847     :
     1848       find last buf_stk-tot no-lock
     1849         where buf_stk-tot.obj-type   = p-obj-type
     1850           and buf_stk-tot.obj-code   = p-obj-code
     1851           and buf_stk-tot.sum-type   = p-root-sum-type
     1852           and buf_stk-tot.cat-id     = '##,##':U
     1853           and buf_stk-tot.fact-order <= p-stk-tot-fact-order
     1854         use-index category
     1855         no-error .
     1856       if  available buf_stk-tot
     1857       and buf_stk-tot.fact-order <> p-stk-tot-fact-order
     1858       then do:
     1859         assign
     1860           v-prev-stk-tot-fact-order = buf_stk-tot.fact-order
     1861         .
     1862         for each buf_stk-tot no-lock
     1863           where buf_stk-tot.obj-type   = p-obj-type
     1864             and buf_stk-tot.obj-code   = p-obj-code
     1865             and buf_stk-tot.fact-order = v-prev-stk-tot-fact-order
     1866             and buf_stk-tot.sum-type   begins p-root-sum-type
     1867         on error undo, return error
     1868         :
     1869           find first buf_temp-stk-tot
     1870             where buf_temp-stk-tot.obj-type   = buf_stk-tot.obj-type
     1871               and buf_temp-stk-tot.obj-code   = buf_stk-tot.obj-code
     1872               and buf_temp-stk-tot.fact-order = p-stk-tot-fact-order
     1873               and buf_temp-stk-tot.sum-type   = buf_stk-tot.sum-type
     1874               and buf_temp-stk-tot.cat-id     = buf_stk-tot.cat-id
     1875             no-error .
     1876           if not available buf_temp-stk-tot
     1877           then do:
     1878             create buf_temp-stk-tot .
     1879             assign
