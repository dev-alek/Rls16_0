     2190   procedure ahrstutl-clear-arh :
     2191     define input  parameter p-obj-type         as character no-undo .
     2192     define input  parameter p-obj-code         as integer   no-undo .
     2193     define input  parameter p-fact-date        as date      no-undo .
     2194     define buffer buf_ot-tot   for ub.ot-tot .
     2195     define buffer buf_ot-line  for ub.ot-line .
     2196     define buffer buf_stk-tot  for ub.stk-tot .
     2197     define buffer buf_stk-line for ub.stk-line .
     2198     define variable v-shift-on                as logical   no-undo .
     2199     define variable v-shift-date              as date      no-undo .
     2200     define variable v-shift-num               as integer   no-undo .
     2201     define variable v-day-end-fact-order      as decimal   no-undo .
     2202     define variable v-shift-end-fact-order    as decimal   no-undo .
     2203     define variable v-ind as integer no-undo .
     2204     do
     2205     on error undo, return error return-value
     2206     :
     2207       run factord-cut-archive in this-procedure
     2208         (input  p-obj-type
     2209         ,input  p-obj-code
     2210         ,input  p-fact-date
     2211         ,output v-shift-on
     2212         ,output v-shift-date
     2213         ,output v-shift-num
     2214         ,output v-day-end-fact-order
     2215         ,output v-shift-end-fact-order
     2216         ) .
     2217       assign
     2218         v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     2219         v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     2220       .
     2221       run show-action in this-procedure
     2222         (input "Удаление оборота по документам"
     2223         ).
     2224       assign
     2225         v-ind = 0
     2226       .
     2227       for each buf_ot-tot
     2228         where buf_ot-tot.obj-type   = p-obj-type
     2229           and buf_ot-tot.obj-code   = p-obj-code
     2230           and buf_ot-tot.fact-order <= v-day-end-fact-order
     2231       on error undo, return error return-value
     2232       :
     2233         assign
     2234           v-ind = v-ind + 1
     2235         .
     2236         if v-ind modulo 10 = 0
     2237         then do:
     2238           run show-count in this-procedure
     2239             (input v-ind
     2240             ,input "Документ " + string(buf_ot-tot.doc-code)
     2241             ).
     2242         end.
     2243         delete buf_ot-tot .
     2244       end.
     2245       run show-action in this-procedure
     2246         (input "Удаление оборота по строкам документов"
     2247         ).
     2248       assign
     2249         v-ind = 0
     2250       .
     2251       for each buf_ot-line
     2252         where buf_ot-line.obj-type   = p-obj-type
     2253           and buf_ot-line.obj-code   = p-obj-code
     2254           and buf_ot-line.fact-order <= v-day-end-fact-order
     2255       on error undo, return error return-value
     2256       :
     2257         assign
     2258           v-ind = v-ind + 1
     2259         .
     2260         if v-ind modulo 10 = 0
     2261         then do:
     2262           run show-count in this-procedure
     2263             (input v-ind
     2264             ,input "Документ " + string(buf_ot-line.doc-code)
     2265                     + " Артикул " + string(buf_ot-line.artic)
     2266             ).
     2267         end.
     2268         delete buf_ot-line .
     2269       end.
     2270       run show-action in this-procedure
     2271         (input "Удаление остатка по объекту"
     2272         ).
     2273       assign
     2274         v-ind = 0
     2275       .
     2276       for each buf_stk-tot
     2277         where buf_stk-tot.obj-type   = p-obj-type
     2278           and buf_stk-tot.obj-code   = p-obj-code
     2279           and buf_stk-tot.fact-order <= v-day-end-fact-order
     2280       on error undo, return error return-value
     2281       :
     2282         assign
     2283           v-ind = v-ind + 1
     2284         .
     2285         if v-ind modulo 10 = 0
     2286         then do:
     2287           run show-count in this-procedure
     2288             (input v-ind
     2289             ,input "Дата " + string(buf_stk-tot.fact-date, '99/99/9999':U )
     2290             ).
     2291         end.
     2292         if buf_stk-tot.shift-date = ?
     2293         or (buf_stk-tot.shift-date <> ?
     2294             and
     2295             buf_stk-tot.fact-order <= v-shift-end-fact-order
     2296            )
     2297         then do:
     2298           delete buf_stk-tot .
     2299         end.
     2300       end.
     2301       run show-action in this-procedure
     2302         (input "Удаление остатка по товарам на объекте"
     2303         ).
     2304       assign
     2305         v-ind = 0
     2306       .
     2307       for each buf_stk-line
     2308         where buf_stk-line.obj-type   = p-obj-type
     2309           and buf_stk-line.obj-code   = p-obj-code
     2310           and buf_stk-line.fact-order <= v-day-end-fact-order
     2311       on error undo, return error return-value
     2312       :
     2313         assign
     2314           v-ind = v-ind + 1
     2315         .
     2316         if v-ind modulo 10 = 0
     2317         then do:
     2318           run show-count in this-procedure
     2319             (input v-ind
     2320             ,input "Артикул " + string(buf_stk-line.artic)
     2321             ).
     2322         end.
     2323         if buf_stk-line.shift-date = ?
     2324         or (buf_stk-line.shift-date <> ?
     2325             and
     2326             buf_stk-line.fact-order <= v-shift-end-fact-order
     2327            )
     2328         then do:
     2329           delete buf_stk-line .
     2330         end.
     2331       end.
     2332     end.
     2333   end procedure.
     2334   procedure ahrstutl-tot-sum-type-list :
     2335     define output parameter p-sum-type-list as character no-undo .
     2336     do
     2337     on error undo, return error return-value
     2338     :
     2339       define variable v-ind                    as integer   no-undo .
     2340       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2341       assign
     2342         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2343       .
     2344       assign
     2345         p-sum-type-list = 'crsa':U
     2346                         + chr(44)
     2347                         + 'cost':U
     2348       .
     2349       do v-ind = 1 to v-num-entries-TDEDT_List
     2350       :
     2351         assign
     2352           p-sum-type-list = p-sum-type-list
     2353                           + chr(44)
     2354                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2355         .
     2356       end.
     2357       do v-ind = 1 to v-num-entries-TDEDT_List
     2358       :
     2359         assign
     2360           p-sum-type-list = p-sum-type-list
     2361                           + chr(44)
     2362                           + 'cgdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2363         .
     2364       end.
     2365       do v-ind = 1 to v-num-entries-TDEDT_List
     2366       :
     2367         assign
     2368           p-sum-type-list = p-sum-type-list
     2369                           + chr(44)
     2370                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2371         .
     2372       end.
     2373       do v-ind = 1 to v-num-entries-TDEDT_List
     2374       :
     2375         assign
     2376           p-sum-type-list = p-sum-type-list
     2377                           + chr(44)
     2378                           + 'adsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2379         .
     2380       end.
     2381       do v-ind = 1 to v-num-entries-TDEDT_List
     2382       :
     2383         assign
     2384           p-sum-type-list = p-sum-type-list
     2385                           + chr(44)
     2386                           + 'gdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2387         .
     2388       end.
     2389       do v-ind = 1 to v-num-entries-TDEDT_List
     2390       :
     2391         assign
     2392           p-sum-type-list = p-sum-type-list
     2393                           + chr(44)
     2394                           + 'sdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2395         .
     2396       end.
     2397     end.
     2398   end procedure.
     2399   procedure ahrstutl-line-sum-type-list :
     2400     define input  parameter p-gds-goods     as logical   no-undo .
     2401     define output parameter p-sum-type-list as character no-undo .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       define variable v-ind                    as integer   no-undo .
     2406       define variable v-num-entries-TDEDT_List as integer   no-undo .
     2407       assign
     2408         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2409       .
