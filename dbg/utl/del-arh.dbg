        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: del-arh.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/del-arh.p $":U .
        8   define variable vss-description as character no-undo init "Удаление складского архива по товарам за определенный период с выгрузкой в файл".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure factord :
       71     define input  parameter p-fact-date            as date    no-undo .
       72     define input  parameter p-fact-time            as integer no-undo .
       73     define input  parameter p-fact-num             as integer no-undo .
       74     define input  parameter p-shift-date           as date    no-undo .
       75     define input  parameter p-shift-num            as integer no-undo .
       76     define input  parameter p-shift-on             as logical no-undo .
       77     define output parameter p-fact-order           as decimal no-undo .
       78     define output parameter p-shift-end-fact-order as decimal no-undo .
       79     define output parameter p-day-end-fact-order   as decimal no-undo .
       80     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       81     if p-fact-date = ?
       82     then do:
       83       return error "Не указана фактическая дата" .
       84     end.
       85     define variable v-fact-date-num as integer no-undo .
       86     assign
       87       v-fact-date-num = integer(p-fact-date)
       88     .
       89     if p-fact-num = ?
       90     or p-fact-num = 0
       91     then do:
       92       return error "Не задан p-fact-num " + string(p-fact-num) .
       93     end.
       94     if p-fact-num < 0
       95     then do:
       96       return error "Отрицательный fact-num " + string(p-fact-num) .
       97     end.
       98     if p-fact-num >= 100000000
       99     then do:
      100       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      101     end.
      102     if p-shift-on = true
      103     then do:
      104       if p-shift-date = ?
      105       then do:
      106         return error "Не задана дата смены" .
      107       end.
      108       if p-shift-num = ?
      109       or p-shift-num = 0
      110       then do:
      111         return error "Не задан номер смены" .
      112       end.
      113     end.
      114     else do:
      115       assign
      116         p-shift-date = p-fact-date
      117         p-shift-num  = 24
      118       .
      119     end.
      120     define variable v-shift-offset as integer no-undo .
      121     if p-shift-date = p-fact-date
      122     then do:
      123       assign
      124         v-shift-offset = 1
      125       .
      126     end.
      127     if p-shift-date < p-fact-date
      128     then do:
      129       assign
      130         v-shift-offset = 0
      131       .
      132     end.
      133     if p-shift-date > p-fact-date
      134     then do:
      135       message
      136         vss-workfile vss-revision vss-description skip
      137         "Неправильная дата закрытия смены" skip
      138         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      139         view-as alert-box error .
      140       undo, return error
      141         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      142           ,string(p-fact-date, '99/99/9999':U)
      143           ,string(p-shift-date, '99/99/9999':U)
      144           )
      145       .
      146     end.
      147     if p-shift-num < 1
      148     or p-shift-num > 24
      149     then do:
      150       message
      151         vss-workfile vss-revision vss-description skip
      152         "Неправильный номер смены" skip
      153         "p-shift-num" p-shift-num skip
      154         view-as alert-box error .
      155       undo, return error return-value .
      156     end.
      157     assign
      158       p-fact-order           = v-fact-date-num
      159                              + v-shift-offset * 0.5
      160                              + p-shift-num    * 0.02 - 0.01
      161                              + p-fact-num     * 0.0000000001
      162       p-shift-end-fact-order = v-fact-date-num
      163                              + v-shift-offset * 0.5
      164                              + p-shift-num    * 0.02
      165       p-day-end-fact-order   = v-fact-date-num
      166                              + 0.99
      167     .
      168     if p-fact-order           <= v-fact-date-num
      169     or p-shift-end-fact-order <= v-fact-date-num
      170     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      171     or p-shift-end-fact-order >= p-day-end-fact-order
      172     then do:
      173       message
      174         vss-workfile vss-revision vss-description skip
      175         "Внутренняя ошибка при генерации фактического номера" skip
      176         "p-fact-date"            p-fact-date            skip
      177         "p-fact-time"            p-fact-time            skip
      178         "p-fact-num"             p-fact-num             skip
      179         "p-shift-date"           p-shift-date           skip
      180         "p-shift-num"            p-shift-num            skip
      181         "p-shift-on"             p-shift-on             skip
      182         "p-shift-end-fact-order" p-shift-end-fact-order skip
      183         "p-day-end-fact-order"   p-day-end-fact-order   skip
      184         "v-fact-date-num"        v-fact-date-num        skip
      185         view-as alert-box error .
      186       undo, return error return-value .
      187     end.
      188   end procedure.
      189   procedure day-begin-fact-order :
      190     define input  parameter p-fact-date            as date    no-undo .
      191     define output parameter p-day-begin-fact-order as decimal no-undo .
      192     do
      193     on error undo, return error return-value
      194     :
      195       if p-fact-date = ?
      196       then do:
      197         assign
      198           p-day-begin-fact-order = 0
      199         .
      200       end.
      201       else do:
      202         assign
      203           p-day-begin-fact-order = integer(p-fact-date)
      204         .
      205       end.
      206     end.
      207   end procedure.
      208   procedure factord-max-fact-order :
      209     define output parameter p-max-fact-order as decimal   no-undo .
      210     do
      211     on error undo, return error return-value
      212     :
      213       run day-begin-fact-order in this-procedure
      214         (input  date(1, 1, 5000)
      215         ,output p-max-fact-order
      216         ) .
      217     end.
      218   end procedure.
      219   procedure factord-cut-archive :
      220     define input  parameter p-obj-type             as character no-undo .
      221     define input  parameter p-obj-code             as integer   no-undo .
      222     define input  parameter p-fact-date            as date      no-undo .
      223     define output parameter p-shift-on             as logical   no-undo .
      224     define output parameter p-shift-date           as date      no-undo .
      225     define output parameter p-shift-num            as integer   no-undo .
      226     define output parameter p-day-end-fact-order   as decimal   no-undo .
      227     define output parameter p-shift-end-fact-order as decimal   no-undo .
      228     define variable v-fact-order as decimal   no-undo .
      229     define buffer buf_shift-obj for ub.shift-obj .
      230     do
      231     on error undo, return error return-value
      232     :
      233   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      235     (input  p-obj-type
      236     ,input  p-obj-code
      237     ,input  'shift-on=request'
      238     ,output p-shift-on
      239     ) no-error .
      240       if error-status :error
      241       then do:
      242         message
      243           vss-workfile vss-revision vss-description skip
      244           "Ошибка при определении атрибута объекта" skip
      245           "Объект" p-obj-type p-obj-code skip
      246           error-status :get-message(1) skip
      247           return-value skip
      248           view-as alert-box error .
      249         undo, return error return-value .
      250       end.
      251       if p-shift-on = false
      252       then do:
      253         assign
      254           p-shift-date               = ?
      255           p-shift-num                = 0
      256         .
      257       end.
      258       else do:
      259         find first buf_shift-obj share-lock
      260           where buf_shift-obj.obj-type   = p-obj-type
      261             and buf_shift-obj.obj-code   = p-obj-code
      262             and buf_shift-obj.shift-date > p-fact-date
      263           use-index pi
      264           no-error .
      265         if not available buf_shift-obj
      266         or buf_shift-obj.status_ <> 'зкр':U
      267         then do:
      268           message
      269             vss-workfile vss-revision vss-description skip
      270             "Невозможно вычислить последнюю смену" skip
      271             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      272             "Объект" p-obj-type p-obj-code skip
      273             "Дата" p-fact-date skip
      274             view-as alert-box error .
      275           undo, return error return-value .
      276         end.
      277         find last buf_shift-obj share-lock
      278           where buf_shift-obj.obj-type = p-obj-type
      279             and buf_shift-obj.obj-code = p-obj-code
      280             and buf_shift-obj.shift-date <= p-fact-date
      281           use-index pi
      282           no-error .
      283         if available buf_shift-obj
      284         then do:
      285           if  buf_shift-obj.status_ = 'зкр':U
      286           then do:
      287             assign
      288               p-shift-date = buf_shift-obj.shift-date
      289               p-shift-num  = buf_shift-obj.shift-num
      290             .
      291           end.
      292           else do:
      293             message
      294               vss-workfile vss-revision vss-description skip
      295               "Невозможно вычислить последнюю смену" skip
      296               "Статус смены отличен от статуса" 'зкр':U skip
      297               "Объект" p-obj-type p-obj-code skip
      298               "Дата" p-fact-date skip
      299               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      300               view-as alert-box error .
      301             undo, return error return-value .
      302           end.
      303         end.
      304         else do:
      305           assign
      306             p-shift-date = p-fact-date - 1
      307             p-shift-num  = 1
      308           .
      309         end.
      310       end.
      311       run factord in this-procedure
      312         (input  p-fact-date
      313         ,input  1
      314         ,input  1
      315         ,input  p-shift-date
      316         ,input  p-shift-num
      317         ,input  p-shift-on
      318         ,output v-fact-order
      319         ,output p-shift-end-fact-order
      320         ,output p-day-end-fact-order
      321         ) no-error .
      322       if error-status :error
      323       then do:
      324         message
      325           vss-workfile vss-revision vss-description skip
      326           "Ошибка при вызове процедуры factord"
      327           error-status :get-message(1) skip
      328           return-value skip
      329           view-as alert-box error .
      330         undo, return error return-value .
      331       end.
      332     end.
      333   end procedure.
      334   procedure factord-lock-shift :
      335     define input  parameter p-obj-type  as character no-undo .
      336     define input  parameter p-obj-code  as integer   no-undo .
      337     define input  parameter p-fact-date as date      no-undo .
      338     define parameter buffer buf_shift-obj for ub.shift-obj .
      339     define variable v-shift-on      as logical   no-undo .
      340     define variable v-extra-message as character no-undo .
      341     define variable v-error as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      347     (input  p-obj-type
      348     ,input  p-obj-code
      349     ,input  'shift-on=request'
      350     ,output v-shift-on
      351     ) no-error .
      352       if error-status :error
      353       then do:
      354         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      355         undo, return error v-error .
      356       end.
      357       if v-shift-on = true
      358       then do:
      359         find first buf_shift-obj share-lock
      360           where buf_shift-obj.obj-type   = p-obj-type
      361             and buf_shift-obj.obj-code   = p-obj-code
      362             and buf_shift-obj.shift-date > p-fact-date
      363           use-index pi
      364           no-error .
      365         if not available buf_shift-obj
      366         or buf_shift-obj.status_ <> 'зкр':U
      367         then do:
      368           find last buf_shift-obj
      369             where buf_shift-obj.obj-type = p-obj-type
      370               and buf_shift-obj.obj-code = p-obj-code
      371               and buf_shift-obj.status_  = 'зкр':U
      372             use-index stts
      373             no-error .
      374           if available buf_shift-obj
      375           then do:
      376             assign
      377               v-extra-message =
      378                     substitute("Дата начала последеней закрытой смены на объекте &1"
      379                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      380                               )
      381             .
      382           end.
      383           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      384           undo, return error v-error .
      385         end.
      386       end.
      387     end.
      388   end procedure.
      389   procedure factord-end-day :
      390     define input  parameter p-fact-date            as date    no-undo .
      391     define output parameter p-day-end-fact-order   as decimal no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       if p-fact-date = ?
      396       then do:
      397         return error "Не указана фактическая дата" .
      398       end.
      399       assign
      400         p-day-end-fact-order = integer(p-fact-date) + 0.99
      401       .
      402     end.
      403   end procedure.
      404   procedure factord-to-date :
      405     define input  parameter p-fact-order as decimal no-undo .
      406     define output parameter p-fact-date  as date    no-undo .
      407     define variable v-ref-date  as date      no-undo .
      408     define variable v-ref-delta as integer   no-undo .
      409     do
      410     on error undo, return error return-value
      411     :
      412       if p-fact-order = ?
      413       or p-fact-order = 0
      414       then do:
      415         return error "Не указан fact-order" .
      416       end.
      417       assign
      418         v-ref-date  = date(1, 1, 2000)
      419       .
      420       assign
      421         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      422       .
      423       assign
      424         p-fact-date = v-ref-date + v-ref-delta
      425       .
      426     end.
      427   end procedure.
      428   procedure factord-to-fact-num :
      429     define input  parameter p-fact-order as decimal no-undo .
      430     define output parameter p-fact-num   as integer no-undo .
      431     define variable v-fact-order-trunc as decimal no-undo .
      432     do
      433     on error undo, return error return-value
      434     :
      435       if p-fact-order = ?
      436       or p-fact-order = 0
      437       then do:
      438         return error "Не указан fact-order" .
      439       end.
      440       assign
      441        v-fact-order-trunc = truncate(p-fact-order, 2)
      442       .
      443       assign
      444         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      445       .
      446     end.
      447   end procedure.
      448   procedure factord-to-shift-num :
      449     define input  parameter p-fact-order as decimal no-undo .
      450     define output parameter p-shift-num   as integer no-undo .
      451     define variable  p-shift-numd  as decimal   no-undo .
      452     define variable v-fact-order-trunc as decimal no-undo .
      453     do
      454     on error undo, return error return-value
      455     :
      456       if p-fact-order = ?
      457       or p-fact-order = 0
      458       then do:
      459         return error "Не указан fact-order" .
      460       end.
      461       assign
      462        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      463       .
      464       if v-fact-order-trunc < 0.5 then do:
      465         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      466       end.
      467       assign
      468         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      469         .
      470        assign
      471         p-shift-num = truncate (p-shift-numd , 0)
      472       .
      473     end.
      474   end procedure.
      475   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   define new global shared variable g#attr-lib  as handle no-undo .
      477   define variable v-attr-lib-variable as handle no-undo .
      478   procedure clntattr-code :
      479     define input  parameter p-code           as character no-undo .
      480     define output parameter p-type           as character no-undo .
      481     define output parameter p-format         as character no-undo .
      482     define output parameter p-label          as character no-undo .
      483     define output parameter p-user-can-edit  as logical   no-undo .
      484     define output parameter p-output-display as logical   no-undo .
      485     define output parameter p-other          as character no-undo .
      486     do
      487     on error undo, return error return-value
      488     :
      489           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      490         (input  p-code
      491         ,output p-type
      492         ,output p-format
      493         ,output p-label
      494         ,output p-user-can-edit
      495         ,output p-output-display
      496         ,output p-other
      497         ) no-error .
      498       if error-status :error
      499       then do:
      500         undo, return error return-value .
      501       end.
      502     end.
      503   end procedure.
      504   procedure clntattr-tooltip :
      505     define input  parameter p-code    as character no-undo .
      506     define output parameter p-tooltip as character no-undo .
      507     define output parameter p-label   as character no-undo .
      508     do
      509     on error undo, return error return-value
      510     :
      511           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      512         (input  p-code
      513         ,output p-tooltip
      514         ,output p-label
      515         ) no-error .
