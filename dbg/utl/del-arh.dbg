      768   define temp-table userobjs_temp-user-obj no-undo
      769     field obj-type as character
      770     field obj-code as integer
      771     index xpk is primary unique obj-type obj-code
      772     .
      773   procedure userobjs_clear :
      774     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      775     do
      776     on error undo, return error return-value
      777     :
      778       for each buf_userobjs_temp-user-obj
      779       on error undo, return error return-value
      780       :
      781         delete buf_userobjs_temp-user-obj .
      782       end.
      783     end.
      784   end .
      785   procedure userobjs_object-count :
      786     define output parameter p-total-count as integer   no-undo .
      787     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      788     do
      789     on error undo, return error return-value
      790     :
      791       assign
      792         p-total-count = 0
      793       .
      794       for each buf_userobjs_temp-user-obj
      795       on error undo, return error return-value
      796       :
      797         assign
      798           p-total-count = p-total-count + 1
      799         .
      800       end.
      801     end.
      802   end.
      803   procedure userobjs_append :
      804      define input  parameter p-obj-type as character no-undo .
      805      define input  parameter p-obj-code as integer   no-undo .
      806     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      807     do
      808     on error undo, return error return-value
      809     :
      810       find first buf_userobjs_temp-user-obj
      811         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      812           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      813         no-error .
      814       if not available buf_userobjs_temp-user-obj
      815       then do:
      816         create buf_userobjs_temp-user-obj .
      817         assign
      818           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      819           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      820         .
      821       end.
      822     end.
      823   end.
      824   procedure userobjs_object-exist :
      825     define output parameter p-object-exist as logical   no-undo .
      826     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      827     do
      828     on error undo, return error return-value
      829     :
      830       find first buf_userobjs_temp-user-obj
      831         no-error .
      832       if not available buf_userobjs_temp-user-obj
      833       then do:
      834         assign
      835           p-object-exist = false
      836         .
      837       end.
      838       else do:
      839         assign
      840           p-object-exist = true
      841         .
      842       end.
      843     end.
      844   end.
      845   procedure userobjs_transfer :
      846     define input  parameter p-callback-handle as handle no-undo .
      847     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      848     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      849     do
      850     on error undo, return error return-value
      851     :
      852       if valid-handle(p-callback-handle) <> true
      853       then do:
      854         message
      855           vss-workfile vss-revision vss-description skip
      856           "Ошибка задания входных параметров" skip
      857           "Неизвестный указатель на процедуру" skip
      858           view-as alert-box error .
      859         undo, return error return-value .
      860       end.
      861       if p-callback-handle :get-signature("userobjs_append") = ""
      862       then do:
      863         message
      864           vss-workfile vss-revision vss-description skip
      865           "Ошибка задания входных параметров" skip
      866           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      867                     ,p-callback-handle :file-name
      868                     ) skip
      869           view-as alert-box error .
      870         undo, return error return-value .
      871       end.
      872       for each buf_userobjs_temp-user-obj
      873       on error undo, return error return-value
      874       :
      875         run userobjs_append in p-callback-handle
      876           (input  buf_userobjs_temp-user-obj.obj-type
      877           ,input  buf_userobjs_temp-user-obj.obj-code
      878           ) .
      879       end.
      880     end.
      881   end procedure.
      882   procedure userobjs_select-one :
      883      define input  parameter parparentproc     as widget-handle no-undo .
      884      define input  parameter p-db-num          as integer   no-undo .
      885      define input  parameter p-user-id         as character no-undo .
      886      define input  parameter p-host-code-obj   as integer   no-undo .
      887      define input  parameter p-obj-type        as character no-undo .
      888      define input  parameter p-obj-code        as integer   no-undo .
      889      define output parameter p-user-select     as logical   no-undo .
      890      define output parameter p-select-obj-type as character no-undo .
      891      define output parameter p-select-obj-code as character no-undo .
      892     do
      893     on error undo, return error return-value
      894     :
      895       run gbl/userobjs.w
      896         (input  parparentproc
      897         ,input  this-procedure :handle
      898         ,input  p-db-num
      899         ,input  p-user-id
      900         ,input  p-host-code-obj
      901         ,input  p-obj-type
      902         ,input  p-obj-code
      903         ,INPUT  "b-sel"
      904         ,output p-user-select
      905         ,output p-select-obj-type
      906         ,output p-select-obj-code
      907         ) .
      908     end.
      909   end.
