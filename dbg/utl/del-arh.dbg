     1995               and buf_temp-stk-line.prod-code  = buf_stk-line.prod-code
     1996               and buf_temp-stk-line.fact-order = p-stk-line-fact-order
     1997               and buf_temp-stk-line.sum-type   = buf_stk-line.sum-type
     1998               and buf_temp-stk-line.cat-id     = buf_stk-line.cat-id
