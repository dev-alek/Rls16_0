     2039               and buf_shift-stk-line.artic      = p-artic
     2040               and buf_shift-stk-line.prod-type  = p-prod-type
     2041               and buf_shift-stk-line.prod-code  = p-prod-code
     2042               and buf_shift-stk-line.fact-order = v-prev-shift-stk-line-fact-order
