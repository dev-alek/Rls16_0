      999     end.
     1000     define buffer restore-arh-lock_batchprocess for ub.batchprocess .
     1001     run gbl/lock-prc.p
     1002       (input 'rsar':U
     1003       ,input v-obj-code
     1004       ,input 0
     1005       ,input 0
     1006       ,input v-obj-type
     1007       ,input ""
     1008       ,input ""
     1009       ,input "Объект,,, ,,,Восстановление складского складского архива по товарам"
     1010       ,input true
     1011       ,buffer restore-arh-lock_batchprocess
     1012       ) no-error .
     1013     if error-status :error
     1014     then do:
     1015       if error-status :get-message(1) <> ""
     1016       then do:
     1017         message
     1018           vss-workfile vss-revision vss-description skip
     1019           "В данный момент восстанавливается складской архив по товарам" skip
     1020           "Невозможно произвести восстановление складского архива по товарам" skip
     1021           view-as alert-box error .
     1022       end.
     1023       undo, return error "В данный момент восстанавливается складской архив по товарам" .
     1024     end.
     1025     run gbl/lock-prc.p
     1026       (input 'btpr':U
     1027       ,input v-obj-code
     1028       ,input 0
     1029       ,input 0
     1030       ,input v-obj-type
     1031       ,input ""
     1032       ,input ""
     1033       ,input "Объект,,, ,,,Расчет складского архивов по товарам"
     1034       ,input true
     1035       ,buffer calc-arh-lock_batchprocess
     1036       ) no-error .
     1037     if error-status :error
     1038     then do:
     1039       if error-status :get-message(1) <> ""
     1040       then do:
     1041         message
     1042           vss-workfile vss-revision vss-description skip
     1043           "В данный момент рассчитывается складской архив по товарам" skip
     1044           "Невозможно произвести удаление складского архива по товарам" skip
     1045           view-as alert-box error .
     1046       end.
     1047       undo, return error "В данный момент рассчитывается складской архив по товарам" .
     1048     end.
     1049     define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1050     run gbl/lockrngd.p
     1051       (input  'grar':U
     1052       ,input  'disable':U
     1053       ,buffer buf_lock_gdsrenart_batchprocess
     1054       ) no-error .
     1055     if error-status :error
     1056     then do:
     1057       if error-status :get-message(1) <> ""
     1058       then do:
     1059         message
     1060           vss-workfile vss-revision vss-description skip
     1061           "Ошибка при блокировании функции переименования артикула товара" skip
     1062           error-status :get-message(1) skip
     1063           return-value skip
     1064           view-as alert-box error .
     1065       end.
     1066       undo, return error return-value .
     1067     end.
     1068     define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1069     run gbl/lockrngd.p
     1070       (input  'grgc':U
     1071       ,input  'disable':U
     1072       ,buffer buf_lock_gdsrengc_batchprocess
     1073       ) no-error .
     1074     if error-status :error
     1075     then do:
     1076       if error-status :get-message(1) <> ""
     1077       then do:
     1078         message
     1079           vss-workfile vss-revision vss-description skip
     1080           "Ошибка при блокировании функции переименования кода товара" skip
     1081           error-status :get-message(1) skip
