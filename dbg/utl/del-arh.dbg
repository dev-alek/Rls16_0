     2420             p-sum-type-list = p-sum-type-list
     2421                             + chr(44)
     2422                             + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2423           .
     2424         end.
     2425         do v-ind = 1 to v-num-entries-TDEDT_List
     2426         :
     2427           assign
     2428             p-sum-type-list = p-sum-type-list
     2429                             + chr(44)
     2430                             + 'cgdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2431           .
     2432         end.
     2433         do v-ind = 1 to v-num-entries-TDEDT_List
     2434         :
     2435           assign
     2436             p-sum-type-list = p-sum-type-list
     2437                             + chr(44)
     2438                             + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2439           .
     2440         end.
     2441       end.
     2442       else do:
     2443         assign
     2444           p-sum-type-list = 'cgsr':U
     2445                           + chr(44)
     2446                           + 'cssr':U
     2447         .
     2448         do v-ind = 1 to v-num-entries-TDEDT_List
     2449         :
     2450           assign
     2451             p-sum-type-list = p-sum-type-list
     2452                             + chr(44)
     2453                             + 'adsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2454           .
     2455         end.
     2456         do v-ind = 1 to v-num-entries-TDEDT_List
     2457         :
     2458           assign
     2459             p-sum-type-list = p-sum-type-list
     2460                             + chr(44)
     2461                             + 'gdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2462           .
     2463         end.
     2464         do v-ind = 1 to v-num-entries-TDEDT_List
     2465         :
     2466           assign
     2467             p-sum-type-list = p-sum-type-list
     2468                             + chr(44)
     2469                             + 'sdsr':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     2470           .
     2471         end.
     2472       end.
     2473     end.
     2474   end procedure.
     2475   procedure create-log-err :
     2476     define input  parameter p-obj-type  as character no-undo .
     2477     define input  parameter p-obj-code  as integer   no-undo .
     2478     define input  parameter p-file-name as character no-undo .
     2479     define input  parameter p-err       as character no-undo .
     2480     do
     2481     on error undo, return error
     2482     :
     2483       output stream slog to value(p-file-name) .
     2484       export stream slog 'archive-log-version':u '2.1':u .
     2485       export stream slog 'obj-type':u            p-obj-type .
     2486       export stream slog 'obj-code':u            string(p-obj-code) .
     2487       export stream slog  string(p-err) .
     2488       output stream slog close .
     2489     end.
     2490   end procedure.
