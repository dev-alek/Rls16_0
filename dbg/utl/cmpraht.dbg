      911         view-as alert-box error .
      912       undo, return error return-value .
      913     end.
      914     run select-temp-fact-order in this-procedure
      915       no-error .
      916     if error-status :error
      917     then do:
      918       message
      919         vss-workfile vss-revision vss-description skip
      920         "Ошибка при вызове программы" 'select-temp-fact-order':u skip
      921         error-status :get-message(1) skip
