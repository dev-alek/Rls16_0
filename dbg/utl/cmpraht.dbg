      899         view-as alert-box error .
      900       undo, return error .
      901     end.
      902     run fill-temp-fact-order in this-procedure
      903       no-error .
      904     if error-status :error
      905     then do:
      906       message
      907         vss-workfile vss-revision vss-description skip
      908         "Ошибка при вызове процедуры" 'fill-temp-fact-order':u skip
      909         error-status :get-message(1) skip
