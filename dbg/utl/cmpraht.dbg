      944   end.
      945   procedure delete-aht-ot-line :
      946     define buffer buf_aht-ot-line for aht-ot-line .
      947     do
      948     on error undo, return error return-value
      949     :
      950       for each buf_aht-ot-line
      951         where buf_aht-ot-line.obj-type   = p-obj-type
      952           and buf_aht-ot-line.obj-code   = p-obj-code
      953           and buf_aht-ot-line.fact-order > p-last-fact-order
      954           and buf_aht-ot-line.fact-order <= p-cut-fact-order
      955       on error undo, return error
      956       :
      957         assign
      958           v-ind = v-ind + 1
      959         .
      960         if v-ind modulo 10 = 0
      961         then do:
      962           run show-count in this-procedure
      963             (input v-ind
      964             ,input "Код товара " + string(buf_aht-ot-line.gds-code)
      965             ).
      966         end.
      967         delete buf_aht-ot-line .
      968       end.
      969     end.
      970   end procedure.
      971   procedure clear-temp-fact-order :
      972     do
      973     on error undo, return error
      974     :
      975       define buffer buf_temp-fact-order for temp-fact-order .
      976       for each buf_temp-fact-order
      977       on error undo, return error
      978       :
      979         delete buf_temp-fact-order .
      980       end.
      981     end.
      982   end procedure.
      983   procedure accum-temp-fact-order :
      984     define input parameter p-gds-code   as integer   no-undo .
      985     define input parameter p-sum-type   as character no-undo .
      986     define input parameter p-fact-order as decimal   no-undo .
      987     do
      988     on error undo, return error
      989     :
      990       define buffer buf_temp-fact-order for temp-fact-order .
      991       find first buf_temp-fact-order
      992         where buf_temp-fact-order.temp-gds-code   = p-gds-code
      993           and buf_temp-fact-order.temp-sum-type   = p-sum-type
      994           and buf_temp-fact-order.temp-fact-order = p-fact-order
      995         no-error .
      996       if not available buf_temp-fact-order
      997       then do:
      998         create buf_temp-fact-order .
      999         assign
     1000           buf_temp-fact-order.temp-gds-code   = p-gds-code
     1001           buf_temp-fact-order.temp-sum-type   = p-sum-type
     1002           buf_temp-fact-order.temp-fact-order = p-fact-order
     1003         .
     1004         define variable v-fact-date as date      no-undo .
     1005         run factord-to-date in this-procedure
     1006           (input  p-fact-order
     1007           ,output v-fact-date
     1008           ) .
     1009         assign
     1010           buf_temp-fact-order.temp-break-value = year(v-fact-date) * 10000
     1011                                                + month(v-fact-date) * 100
     1012           buf_temp-fact-order.temp-need-delete = true
     1013         .
     1014       end.
     1015     end.
     1016   end procedure.
     1017   procedure fill-temp-fact-order :
     1018     define buffer buf_aht-stk-line for ub.aht-stk-line .
     1019     do
     1020     on error undo, return error return-value
     1021     :
     1022       for each buf_aht-stk-line no-lock
     1023         where buf_aht-stk-line.obj-type   = p-obj-type
     1024           and buf_aht-stk-line.obj-code   = p-obj-code
     1025           and buf_aht-stk-line.fact-order > p-last-fact-order
     1026           and buf_aht-stk-line.fact-order <= p-cut-fact-order
     1027       on error undo, return error
     1028       :
     1029         assign
     1030           v-ind = v-ind + 1
     1031         .
     1032         if v-ind modulo 10 = 0
     1033         then do:
     1034           run show-count in this-procedure
     1035             (input v-ind
     1036             ,input "Код товара " + string(buf_aht-stk-line.gds-code)
     1037             ).
     1038         end.
     1039         run accum-temp-fact-order in this-procedure
     1040           (input  buf_aht-stk-line.gds-code
     1041           ,input  buf_aht-stk-line.sum-type
     1042           ,input  buf_aht-stk-line.fact-order
     1043           ) no-error .
     1044         if error-status :error
     1045         then do:
     1046           message
     1047             vss-workfile vss-revision vss-description skip
     1048             "Ошибка при вызове программы" 'accum-temp-fact-order':u skip
     1049             error-status :get-message(1) skip
     1050             return-value skip
     1051             view-as alert-box error .
     1052           undo, return error .
     1053         end.
     1054       end.
     1055     end.
     1056   end procedure.
     1057   procedure select-temp-fact-order :
     1058     do
     1059     on error undo, return error
     1060     :
     1061       define buffer buf_temp-fact-order for temp-fact-order .
     1062       define buffer buf_temp-last-fact-order for temp-last-fact-order .
     1063       for each buf_temp-last-fact-order
     1064       on error undo, return error return-value
     1065       :
     1066         delete buf_temp-last-fact-order .
     1067       end.
     1068       for each buf_temp-fact-order
     1069       on error undo, return error return-value
     1070       :
     1071         find first buf_temp-last-fact-order
     1072           where buf_temp-last-fact-order.temp-gds-code    = buf_temp-fact-order.temp-gds-code
     1073             and buf_temp-last-fact-order.temp-sum-type    = buf_temp-fact-order.temp-sum-type
     1074             and buf_temp-last-fact-order.temp-break-value = buf_temp-fact-order.temp-break-value
     1075           no-error .
     1076         if not available buf_temp-last-fact-order
     1077         then do:
     1078           create buf_temp-last-fact-order .
     1079           assign
     1080             buf_temp-last-fact-order.temp-gds-code    = buf_temp-fact-order.temp-gds-code
     1081             buf_temp-last-fact-order.temp-sum-type    = buf_temp-fact-order.temp-sum-type
     1082             buf_temp-last-fact-order.temp-break-value = buf_temp-fact-order.temp-break-value
     1083             buf_temp-last-fact-order.temp-fact-order  = buf_temp-fact-order.temp-fact-order
     1084           .
     1085         end.
     1086         if buf_temp-last-fact-order.temp-fact-order < buf_temp-fact-order.temp-fact-order
     1087         then do:
     1088           assign
     1089             buf_temp-last-fact-order.temp-fact-order = buf_temp-fact-order.temp-fact-order
     1090           .
     1091         end.
     1092       end.
     1093       for each buf_temp-last-fact-order
     1094       on error undo, return error return-value
     1095       :
     1096         find first buf_temp-fact-order
     1097           where buf_temp-fact-order.temp-gds-code   = buf_temp-last-fact-order.temp-gds-code
     1098             and buf_temp-fact-order.temp-sum-type   = buf_temp-last-fact-order.temp-sum-type
     1099             and buf_temp-fact-order.temp-fact-order = buf_temp-last-fact-order.temp-fact-order
     1100           .
     1101         assign
     1102           buf_temp-fact-order.temp-need-delete = false
     1103         .
     1104       end.
     1105     end.
     1106   end procedure.
     1107   procedure show-action :
     1108     do
     1109     on error undo, return error
     1110     :
     1111       define input parameter p-action as character no-undo .
     1112       assign
     1113         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1114         v-current-action = p-action
     1115       .
     1116       display
     1117         v-current-time
     1118         v-current-action
     1119         with frame a.
     1120     end.
     1121   end procedure.
     1122   procedure show-count :
     1123     define input  parameter p-count      as integer   no-undo .
     1124     define input  parameter p-sub-action as character no-undo .
     1125     do
     1126     on error undo, return error
     1127     :
     1128       assign
     1129         v-current-time = string(time - v-start-time, "HH:MM:SS")
     1130         v-count        = p-count
     1131         v-sub-action   = p-sub-action
     1132       .
     1133       display
     1134         v-current-time
     1135         v-count
     1136         v-sub-action
     1137         with frame a.
     1138     end.
     1139   end procedure.
     1140   procedure delete-aht-stk-line :
     1141     define buffer buf_temp-fact-order for temp-fact-order .
     1142     define buffer buf_aht-stk-line for aht-stk-line .
     1143     do
     1144     on error undo, return error return-value
     1145     :
     1146       for each buf_temp-fact-order
     1147         where buf_temp-fact-order.temp-need-delete = true
     1148       on error undo, return error
     1149       :
     1150         for each buf_aht-stk-line
     1151           where buf_aht-stk-line.obj-type   = p-obj-type
     1152             and buf_aht-stk-line.obj-code   = p-obj-code
     1153             and buf_aht-stk-line.gds-code   = buf_temp-fact-order.temp-gds-code
     1154             and buf_aht-stk-line.fact-order = buf_temp-fact-order.temp-fact-order
     1155             and buf_aht-stk-line.sum-type   = buf_temp-fact-order.temp-sum-type
     1156         on error undo, return error
     1157         :
     1158           assign
     1159             v-ind = v-ind + 1
     1160           .
     1161           if v-ind modulo 10 = 0
     1162           then do:
     1163             run show-count in this-procedure
     1164               (input v-ind
     1165               ,input "Код товара " + string(buf_aht-stk-line.gds-code)
     1166               ).
     1167           end.
     1168           delete buf_aht-stk-line .
     1169         end.
     1170       end.
     1171     end.
     1172   end procedure.
