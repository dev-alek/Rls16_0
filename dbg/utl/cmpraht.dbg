      923         view-as alert-box error .
      924       undo, return error .
      925     end.
      926     run show-action in this-procedure
      927       (input "Удаление итогов по товарам на объекте"
      928       ).
      929     assign
      930       v-ind = 0
      931     .
      932     run delete-aht-stk-line in this-procedure
      933       no-error .
      934     if error-status :error
      935     then do:
