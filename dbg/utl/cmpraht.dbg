      760   define temp-table temp-fact-order no-undo   field temp-gds-code    like ub.aht-stk-line.gds-code   field temp-sum-type    like ub.aht-stk-line.sum-type   field temp-fact-order  like ub.aht-stk-line.fact-order   field temp-break-value as integer   field temp-need-delete as logical   index xpk is primary unique temp-gds-code temp-sum-type temp-fact-order   index xie1 temp-need-delete   index xie2 temp-gds-code temp-sum-type temp-break-value .
      761   define temp-table temp-last-fact-order no-undo   field temp-gds-code    like ub.aht-stk-line.gds-code   field temp-sum-type    like ub.aht-stk-line.sum-type   field temp-break-value as integer   field temp-fact-order  like ub.aht-stk-line.fact-order   index xpk is primary unique temp-gds-code temp-sum-type temp-break-value .
      762   define variable v-ind   as integer   no-undo .
      763   do
      764   on error undo, return error
      765   :
      766     define variable v-start-time     as integer   no-undo .
      767     define variable v-current-time   as character no-undo .
      768     define variable v-current-action as character no-undo .
      769     define variable v-count          as integer   no-undo .
      770     define variable v-sub-action     as character no-undo .
      771     define frame a
      772       p-obj-type       label "Объект"
      773       p-obj-code       no-label skip
      774       v-current-action format "x(40)" no-label skip
      775       v-current-time   format "x(8)"  label "Время очистки складского архива" skip
      776       v-count          format ">>>,>>>,>>9" no-label skip
      777       v-sub-action     format "x(40)" no-label skip
      778       with view-as dialog-box side-labels three-d
      779       title "Очистка складского архива по типам приобретения"
      780       .
      781     assign
      782       v-start-time = time
      783     .
      784     view frame a .
      785     display
      786       p-obj-type
      787       p-obj-code
      788       with frame a .
      789     define variable l-obj-exist as logical no-undo .
      790   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      792     (input  p-obj-type
      793     ,input  p-obj-code
      794     ,input  'check-exist':u
      795     ,output l-obj-exist
      796     )  .
      797     if p-cut-fact-order = ?
      798     then do:
      799       message
      800         vss-workfile vss-revision vss-description skip
      801         "Ошибка задания входных параметров" skip
      802         "Объект" p-obj-type p-obj-code skip
      803         "p-cut-fact-order" p-cut-fact-order skip
      804         view-as alert-box error .
      805       undo, return error .
      806     end.
      807     define variable v-max-fact-order as decimal   no-undo .
      808     run factord-max-fact-order in this-procedure
      809       (output v-max-fact-order
      810       ) .
      811     if p-cut-fact-order = 0
      812     then do:
      813       assign
      814         p-cut-fact-order = v-max-fact-order
      815       .
      816     end.
      817     define variable v-attr-value as character no-undo .
      818     define variable v-attr-type  as character no-undo .
      819     run clntattr-value in this-procedure
      820       (input  p-obj-type
      821       ,input  p-obj-code
      822       ,input  'aht-detail':U
      823       ,output v-attr-value
      824       ,output v-attr-type
      825       ) .
      826     define variable v-aht-detail-date       as date    no-undo .
      827     define variable v-aht-detail-fact-order as decimal no-undo .
      828     if v-attr-type = 'T':U
      829     then do:
      830       assign
      831         v-aht-detail-date = date(v-attr-value)
      832       .
      833     end.
      834     else do:
      835       message
      836         vss-workfile vss-revision vss-description skip
      837         "Неправильный тип атрибута" 'aht-detail':U skip
      838         "Тип атрибута" v-attr-type skip
      839         view-as alert-box error .
      840       undo, return error .
      841     end.
      842     run day-begin-fact-order in this-procedure
      843       (input  v-aht-detail-date
      844       ,output v-aht-detail-fact-order
      845       ).
      846     if p-last-fact-order = ?
      847     then do:
      848       message
      849         vss-workfile vss-revision vss-description skip
      850         "Ошибка при задании входных параметров" skip
      851         "Не задана дата начиная с которой необходимо удалить складской архив" skip
      852         "Объект" p-obj-type p-obj-code skip
      853         "v-aht-detail-fact-order"  v-aht-detail-fact-order skip
      854         "p-last-fact-order" p-last-fact-order skip
      855         view-as alert-box error .
      856       undo, return error .
      857     end.
      858     if  (v-aht-detail-fact-order  <= p-last-fact-order
      859           and p-last-fact-order <= p-cut-fact-order )
      860     or  (p-last-fact-order <= p-cut-fact-order
      861           and p-cut-fact-order <= v-aht-detail-fact-order
      862         )
      863     then do:
      864     end.
      865     else do:
      866       message
      867         vss-workfile vss-revision vss-description skip
      868         "Ошибка при сжатии складского архива" skip
      869         "Неправильный диапазон сжатия складского архива" skip
      870         "Объект" p-obj-type p-obj-code skip
      871         "v-aht-detail-fact-order" v-aht-detail-fact-order skip
      872         "p-last-fact-order"       p-last-fact-order skip
      873         "p-cut-fact-order"        p-last-fact-order skip
      874         view-as alert-box error .
      875       undo, return error .
      876     end.
      877     run show-action in this-procedure
      878       (input "Удаление строк документов"
      879       ).
      880     assign
      881       v-ind = 0
      882     .
      883     run delete-aht-ot-line in this-procedure .
      884     run show-action in this-procedure
      885       (input "Анализ итогов по товарам на объекте"
      886       ).
      887     assign
      888       v-ind = 0
      889     .
      890     run clear-temp-fact-order in this-procedure
      891       no-error .
      892     if error-status :error
