        1   block-level on error undo, throw.
        2   using Ibs.Th.Gbl.ProgressBar.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: mig_0100.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/mig_0100.p $":U .
        8   define variable vss-description as character no-undo init "Модификация таблиц о МПЛ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter parparentproc    as widget-handle no-undo .
       64   define input parameter p-parent-handle  as widget-handle no-undo .
       65   define input parameter p-log-handle     as handle no-undo .
       66   define input parameter p-parameter      as character no-undo .
       67   define input parameter p-db-num         as integer   no-undo .
       68   define input parameter p-cli-code       as integer   no-undo .
       69   define input parameter log-file-name   as character  no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define new global shared variable g#library  as handle no-undo .
      301   define new global shared variable g#library2 as handle no-undo .
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   define temp-table x_obj-group no-undo like ub.clients  .
      304   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      305   procedure metod-gop-obj :
      306     do
      307     on error undo, return error return-value
      308     :
      309   define input  parameter p-cntxt-db-num as integer   no-undo .
      310   define input  parameter p-gop-id       as integer   no-undo .
      311   define input  parameter p-gop-db-num   as integer   no-undo .
      312   define buffer buf1_clients for ub.clients  .
      313   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      314   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      315   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      316   for each  x_obj-group : delete x_obj-group. end.
      317   if p-gop-id = 0 or p-gop-id = ?  then do:
      318      if p-cntxt-db-num = 0  then do:
      319           for each buf1_clients no-lock where
      320                   (buf1_clients.obj-type = 'маг':U  or
      321                    buf1_clients.obj-type = 'скл':U  )
      322                   and
      323                   buf1_clients.db-num >= 0  and
      324                   buf1_clients.stts = 0
      325                   :
      326             create x_obj-group .
      327             assign
      328               x_obj-group.obj-code   = buf1_clients.obj-code
      329               x_obj-group.obj-type   = buf1_clients.obj-type
      330               x_obj-group.obj-name   = buf1_clients.obj-name
      331               x_obj-group.db-num     = buf1_clients.db-num
      332             .
      333           end.
      334      end.
      335      else do:
      336           for each buf1_clients no-lock where
      337                   (buf1_clients.obj-type = 'маг':U  or
      338                    buf1_clients.obj-type = 'скл':U  ) and
      339                    buf1_clients.db-num = p-cntxt-db-num  and
      340                    buf1_clients.stts = 0
      341                   :
      342             create x_obj-group .
      343             assign
      344               x_obj-group.obj-code   = buf1_clients.obj-code
      345               x_obj-group.obj-type   = buf1_clients.obj-type
      346               x_obj-group.obj-name   = buf1_clients.obj-name
      347               x_obj-group.db-num     = buf1_clients.db-num
      348             .
      349           end.
      350      end.
      351   end.
      352   else do:
      353         for each buf_db-grp-obj-price  where
      354                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      355                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      356                 buf_db-grp-obj-price.stts = 0  no-lock :
      357           for each buf1_clients no-lock where
      358                  (buf1_clients.obj-type = 'маг':U  or
      359                   buf1_clients.obj-type = 'скл':U  ) and
      360                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      361                   buf1_clients.stts = 0
      362                   :
      363             create x_obj-group .
      364             assign
      365               x_obj-group.obj-code   = buf1_clients.obj-code
      366               x_obj-group.obj-type   = buf1_clients.obj-type
      367               x_obj-group.obj-name   = buf1_clients.obj-name
      368               x_obj-group.db-num     = buf1_clients.db-num
      369             .
      370           end.
      371         end.
      372       for each buf_host-grp-obj-price where
      373               buf_host-grp-obj-price.gop-id     = p-gop-id and
      374               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      375               buf_host-grp-obj-price.stts = 0
      376               no-lock :
      377         for each buf1_clients no-lock where
      378                (buf1_clients.obj-type = 'маг':U  or
      379                 buf1_clients.obj-type = 'скл':U  ) and
      380                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      381                 buf1_clients.stts = 0
      382                 :
      383             find first x_obj-group no-lock  where
      384                       x_obj-group.obj-code   = buf1_clients.obj-code and
      385                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      386             if not available  x_obj-group then   create x_obj-group .
      387             assign
      388               x_obj-group.obj-code   = buf1_clients.obj-code
      389               x_obj-group.obj-type   = buf1_clients.obj-type
      390               x_obj-group.obj-name   = buf1_clients.obj-name
      391               x_obj-group.db-num     = buf1_clients.db-num
      392             .
      393         end.
      394       end.
      395       for each buf_obj-grp-obj-price where
      396               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      397               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      398               buf_obj-grp-obj-price.stts = 0
      399               no-lock :
      400         for each buf1_clients no-lock where
      401                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      402                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      403                   buf1_clients.stts     = 0
      404                   :
      405             find first  x_obj-group no-lock  where
      406                         x_obj-group.obj-code   = buf1_clients.obj-code and
      407                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      408             if not available  x_obj-group then   create x_obj-group .
      409             assign
      410               x_obj-group.obj-code   = buf1_clients.obj-code
      411               x_obj-group.obj-type   = buf1_clients.obj-type
      412               x_obj-group.obj-name   = buf1_clients.obj-name
      413               x_obj-group.db-num     = buf1_clients.db-num
      414             .
      415         end.
      416       end.
      417   end.
      418   end.
      419   end procedure.
      420   procedure metod-obj-in-gop :
      421   define input  parameter p-curr-db-num as integer   no-undo .
      422   define input  parameter p-obj-type as character no-undo .
      423   define input  parameter p-obj-code as integer   no-undo .
      424   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      425     do
      426     on error undo, return error return-value
      427     :
      428       empty temp-table x_grp-obj-price.
      429       for each buf_grp-obj-price where
      430                buf_grp-obj-price.stts = 0
      431                no-lock :
      432                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      433                  for each x_obj-group where
      434                           x_obj-group.obj-type = p-obj-type and
      435                           x_obj-group.obj-code = p-obj-code :
      436                       create  x_grp-obj-price.
      437                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      438                  end.
      439       end.
      440     end.
      441   end procedure.
      442   procedure metod-delobj-usr :
      443   define input  parameter p-pdf-id  as integer   no-undo .
      444   define input  parameter p-pdf-db  as integer   no-undo .
      445   define input  parameter p-plt-id  as integer   no-undo .
      446   define input  parameter p-plt-db-num as integer   no-undo .
      447   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      448     do
      449     on error undo, return error return-value
      450     :
      451   for each buf_price-doc-forming-attr no-lock  where
      452            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      453            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      454            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      455            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      456            buf_price-doc-forming-attr.attr-code begins "obj" :
      457      for each x_obj-group  where
      458               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      459               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      460        delete x_obj-group.
      461      end.
      462   end.
      463     if not can-find (first x_obj-group) then do:
      464        return "nullobj" .
      465     end.
      466   end.
      467   end procedure.
      468   procedure metod-obj-pdf :
      469   define input  parameter p-cntxt-db-num as integer   no-undo .
      470   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      471   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      472   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      473   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      474   define buffer buf_price-list-type for ub.price-list-type  .
      475   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      476     do
      477     on error undo, return error return-value
      478     :
      479    for each  x_obj-group : delete x_obj-group. end.
      480    find first buf_price-list-type no-lock where
      481               buf_price-list-type.plt-id = p-plt-id and
      482               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      483   if error-status :error then return error return-value .
      484    find first buf_price-doc-forming no-lock where
      485               buf_price-doc-forming.plt-id     = p-plt-id and
      486               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      487               buf_price-doc-forming.pdf-id     = p-pdf-id and
      488               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      489               no-error .
      490   if error-status :error then return error return-value .
      491     run metod-gop-obj in this-procedure (
      492         p-cntxt-db-num,
      493         buf_price-list-type.gop-id ,
      494         buf_price-list-type.gop-db-num
      495         ) no-error .
      496     run metod-delobj-usr in this-procedure (
      497       buf_price-doc-forming.pdf-id ,
      498       buf_price-doc-forming.pdf-db ,
      499       buf_price-doc-forming.plt-id ,
      500       buf_price-doc-forming.plt-db-num
      501       ) no-error .
      502     end.
      503   end procedure.
      504   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      505     define variable v-prg-bar_progress-bar  as class ProgressBar  no-undo .
      506     procedure prg-bar_new-progress-bar :
      507       define input  parameter p-min as int64   no-undo .
      508       define input  parameter p-max as int64   no-undo .
      509     do
      510     on error undo, return error return-value
      511     :
      512       if v-prg-bar_progress-bar <> ?
      513       then do:
      514         run prg-bar_delete-progress-bar in this-procedure .
      515       end.
      516       v-prg-bar_progress-bar = new progressbar( p-min , p-max ).
      517     end.
      518     end procedure.
      519     procedure prg-bar_delete-progress-bar :
      520     do
      521     on error undo, return error return-value
      522     :
      523       if v-prg-bar_progress-bar <> ?
      524       then do:
      525         delete object v-prg-bar_progress-bar.
      526         assign
      527           v-prg-bar_progress-bar = ?
      528         .
      529       end.
      530     end.
      531     end procedure.
      532     procedure prg-bar_show-progress-bar :
      533     do
      534     on error undo, return error return-value
      535     :
      536       if v-prg-bar_progress-bar <> ?
      537       then do:
      538         v-prg-bar_progress-bar :show-bar() .
      539       end.
      540     end.
      541     end procedure.
      542     procedure prg-bar_increment-progress-bar :
      543     do
      544     on error undo, return error return-value
      545     :
      546       if v-prg-bar_progress-bar <> ?
      547       then do:
      548         v-prg-bar_progress-bar :increment() .
      549       end.
      550     end.
      551     end procedure.
      552     procedure prg-bar_title-progress-bar :
      553       define input  parameter p-str as character no-undo .
      554     do
      555     on error undo, return error return-value
      556     :
      557       if v-prg-bar_progress-bar <> ?
      558       then do:
      559         assign
      560           v-prg-bar_progress-bar :frame-title = p-str
      561         .
      562       end.
      563     end.
      564     end procedure.
      565     procedure prg-bar_stepto-progress-bar :
      566       define input  parameter p-val as integer   no-undo .
      567     do
      568     on error undo, return error return-value
      569     :
      570       if v-prg-bar_progress-bar <> ?
      571       then do:
      572           v-prg-bar_progress-bar :stepto( p-val ) .
      573       end.
      574     end.
      575     end procedure.
      576   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577     define variable v-prg-bar_cb-handle     as handle             no-undo .
      578     procedure prg-bar_init-cb-handle :
      579       define input  parameter p-cb-handle as handle    no-undo .
      580     do
      581     on error undo, return error return-value
      582     :
      583       if valid-handle( p-cb-handle )
      584       then do:
      585         assign
      586           v-prg-bar_cb-handle = p-cb-handle
      587         .
      588       end.
      589       else do:
      590         assign
      591           v-prg-bar_cb-handle = ?
      592         .
      593       end.
      594     end.
      595     end procedure.
      596     procedure prg-bar_new :
      597       define input  parameter p-min as int64   no-undo .
      598       define input  parameter p-max as int64   no-undo .
      599     do
      600     on error undo, return error return-value
      601     :
      602       if valid-handle(v-prg-bar_cb-handle)
      603       then do:
      604         run prg-bar_new-progress-bar in v-prg-bar_cb-handle ( input p-min , input p-max ).
      605       end.
      606     end.
      607     end procedure.
      608     procedure prg-bar_delete :
      609     do
      610     on error undo, return error return-value
      611     :
      612       if valid-handle(v-prg-bar_cb-handle)
      613       then do:
      614         run prg-bar_delete-progress-bar in v-prg-bar_cb-handle .
      615       end.
      616     end.
      617     end procedure.
      618     procedure prg-bar_show :
      619     do
      620     on error undo, return error return-value
      621     :
      622       if valid-handle(v-prg-bar_cb-handle)
      623       then do:
      624         run prg-bar_show-progress-bar in v-prg-bar_cb-handle .
      625       end.
      626     end.
      627     end procedure.
      628     procedure prg-bar_increment :
      629     do
      630     on error undo, return error return-value
      631     :
      632       if valid-handle(v-prg-bar_cb-handle)
      633       then do:
      634         run prg-bar_increment-progress-bar in v-prg-bar_cb-handle.
      635       end.
      636     end.
      637     end procedure.
      638     procedure prg-bar_title :
      639       define input  parameter p-str as character no-undo .
      640     do
      641     on error undo, return error return-value
      642     :
      643       if valid-handle(v-prg-bar_cb-handle)
      644       then do:
      645         run prg-bar_title-progress-bar in v-prg-bar_cb-handle ( input p-str ) .
      646       end.
      647     end.
      648     end procedure.
      649     procedure prg-bar_stepto :
      650       define input  parameter p-val as integer   no-undo .
      651     do
      652     on error undo, return error return-value
      653     :
      654       if valid-handle(v-prg-bar_cb-handle)
      655       then do:
      656         run prg-bar_stepto-progress-bar in v-prg-bar_cb-handle ( input p-val ) .
      657       end.
      658     end.
      659     end procedure.
      660   define variable v-progress-bar as class ProgressBar no-undo .
      661   run prg-bar_init-cb-handle in this-procedure ( this-procedure ) .
      662   define variable v-tot-rec as int64   no-undo .
      663   run write-log-and-file in p-log-handle (
      664         input 1
      665       , input log-file-name
      666       , input 1
      667       , input substitute("Множественные прайс-листы") ).
      668   on write  of ub.price-list-type   override do: end .
      669   on write  of ub.grp-obj-price     override do: end .
      670   on delete of ub.price-list-type-attr override do: end .
      671   on delete of ub.price-list-type-cash-pay override do: end .
      672   on delete of ub.price-list-type-cassa override do: end .
      673   on delete of ub.price-list-type-gds-grp override do: end .
      674   on delete of ub.price-list-type-pay-type override do: end .
      675   on delete of ub.price-doc-forming-attr   override do: end .
      676   on delete of ub.price-doc-forming-gds    override do: end .
      677   on delete of ub.price-all                override do: end .
      678   on delete of ub.price-doc-forming        override do: end .
      679   on delete of ub.price-list-type override do: end .
      680   on delete of ub.grp-obj-price override do: end .
      681     do
      682     on error undo, return error return-value
      683     :
      684     v-tot-rec = 0 .
      685     for each ub.grp-obj-price no-lock  :
      686       v-tot-rec = v-tot-rec + 1.
      687     end.
      688     run prg-bar_new in this-procedure ( 1, v-tot-rec).
      689     run prg-bar_title in this-procedure ( input "Удаление чужих множественных прайс листов...":U).
      690     run prg-bar_show in this-procedure .
      691     for each ub.grp-obj-price exclusive-lock :
      692         run prg-bar_increment in this-procedure .
      693         run metod-gop-obj (
      694             0 ,
      695             ub.grp-obj-price.gop-id ,
      696             ub.grp-obj-price.gop-db-num  ) .
      697         if not can-find(first x_obj-group)  then do:
      698            for each ub.price-list-type exclusive-lock where
      699                     ( ub.price-list-type.gop-id     = ub.grp-obj-price.gop-id and
      700                       ub.price-list-type.gop-db-num = ub.grp-obj-price.gop-db-num ) or
      701                     ( ub.price-list-type.gop-id-for-calc-turnover     = ub.grp-obj-price.gop-id and
      702                       ub.price-list-type.gop-db-num-for-calc-turnover = ub.grp-obj-price.gop-db-num ) :
      703               for each  ub.price-list-type-attr exclusive-lock where
      704                         ub.price-list-type-attr.plt-db-num = ub.price-list-type.plt-db-num    and
      705                         ub.price-list-type-attr.plt-id     = ub.price-list-type.plt-id
      706                         :
      707                         delete ub.price-list-type-attr.
      708               end.
      709               for each  ub.price-list-type-cash-pay exclusive-lock where
      710                         ub.price-list-type-cash-pay.plt-db-num = ub.price-list-type.plt-db-num    and
      711                         ub.price-list-type-cash-pay.plt-id     = ub.price-list-type.plt-id
      712                         :
      713                         delete ub.price-list-type-cash-pay.
      714               end.
      715               for each  ub.price-list-type-cassa exclusive-lock where
      716                         ub.price-list-type-cassa.plt-db-num = ub.price-list-type.plt-db-num    and
      717                         ub.price-list-type-cassa.plt-id     = ub.price-list-type.plt-id
      718                         :
      719                         delete ub.price-list-type-cassa.
      720               end.
      721               for each  ub.price-list-type-gds-grp exclusive-lock where
      722                         ub.price-list-type-gds-grp.plt-db-num = ub.price-list-type.plt-db-num    and
      723                         ub.price-list-type-gds-grp.plt-id     = ub.price-list-type.plt-id
      724                         :
      725                         delete ub.price-list-type-gds-grp.
      726               end.
      727               for each  ub.price-list-type-pay-type exclusive-lock where
      728                         ub.price-list-type-pay-type.plt-db-num = ub.price-list-type.plt-db-num    and
      729                         ub.price-list-type-pay-type.plt-id     = ub.price-list-type.plt-id
      730                         :
      731                         delete ub.price-list-type-pay-type.
      732               end.
      733               for each ub.price-doc-forming exclusive-lock where
      734                         ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num    and
      735                         ub.price-doc-forming.plt-id     = ub.price-list-type.plt-id
      736                         :
      737               for each ub.price-doc-forming-attr exclusive-lock where
      738                       ub.price-doc-forming-attr.pdf-db        = ub.price-doc-forming.pdf-db      and
      739                       ub.price-doc-forming-attr.pdf-id        = ub.price-doc-forming.pdf-id      and
      740                       ub.price-doc-forming-attr.plt-db-num    = ub.price-doc-forming.plt-db-num  and
      741                       ub.price-doc-forming-attr.plt-id        = ub.price-doc-forming.plt-id
      742                       :
      743                       delete ub.price-doc-forming-attr.
      744               end.
      745               for each ub.price-doc-forming-gds exclusive-lock where
      746                        ub.price-doc-forming-gds.plt-db-num    = ub.price-doc-forming.plt-db-num  and
      747                        ub.price-doc-forming-gds.plt-id        = ub.price-doc-forming.plt-id      and
      748                        ub.price-doc-forming-gds.pdf-db        = ub.price-doc-forming.pdf-db      and
      749                        ub.price-doc-forming-gds.pdf-id        = ub.price-doc-forming.pdf-id
      750                       :
      751                       delete ub.price-doc-forming-gds.
      752               end.
      753               for each ub.price-all exclusive-lock where
      754                       ub.price-all.pdf-db        = ub.price-doc-forming.pdf-db      and
      755                       ub.price-all.pdf-id        = ub.price-doc-forming.pdf-id      and
      756                       ub.price-all.plt-db-num    = ub.price-doc-forming.plt-db-num  and
      757                       ub.price-all.plt-id        = ub.price-doc-forming.plt-id
      758                       :
      759                       delete ub.price-all.
      760               end.
      761                  delete ub.price-doc-forming.
      762               end.
      763               delete ub.price-list-type.
      764            end.
      765            for each ub.host-grp-obj-price  exclusive-lock where
      766                     ub.host-grp-obj-price.gop-id     = ub.grp-obj-price.gop-id and
      767                     ub.host-grp-obj-price.gop-db-num = ub.grp-obj-price.gop-db-num :
      768                 delete ub.host-grp-obj-price.
      769            end.
      770            for each ub.db-grp-obj-price  exclusive-lock where
      771                     ub.db-grp-obj-price.gop-id     = ub.grp-obj-price.gop-id and
      772                     ub.db-grp-obj-price.gop-db-num = ub.grp-obj-price.gop-db-num :
      773                 delete ub.db-grp-obj-price.
      774            end.
      775            for each ub.obj-grp-obj-price  exclusive-lock where
      776                     ub.obj-grp-obj-price.gop-id     = ub.grp-obj-price.gop-id and
      777                     ub.obj-grp-obj-price.gop-db-num = ub.grp-obj-price.gop-db-num :
      778                 delete ub.obj-grp-obj-price.
      779            end.
      780            delete ub.grp-obj-price.
      781         end.
      782     end.
      783     run prg-bar_delete-progress-bar in this-procedure .
      784     end.
