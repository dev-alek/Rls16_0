        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр строк архива для документа".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE QUERY external_tables FOR trn-doc.
      108   RUN set-attribute-list (
      109       'Keys-Accepted = "",
      110        Keys-Supplied = ""':U).
      111   RUN set-attribute-list (
      112       'SortBy-Options = ""':U).
      113   DEFINE QUERY br_table FOR
      114         ot-tot SCROLLING.
      115   DEFINE BROWSE br_table
      116     QUERY br_table NO-LOCK DISPLAY
      117         ot-tot.doc-code FORMAT "X(14)":U
      118         ot-tot.sum-type FORMAT "X(8)":U
      119         ot-tot.cat-id FORMAT "x(7)":U
      120         ot-tot.ext-doc-type COLUMN-LABEL "DT" FORMAT "X(2)":U
      121         ot-tot.fact-qnty FORMAT "->>>,>>>,>>>,>>9.999":U
      122         ot-tot.sum-base FORMAT "->>,>>9.99":U
      123         ot-tot.sum-rubl FORMAT "->>,>>>,>>9.99":U
      124         ot-tot.VAT-base FORMAT "->>>,>>>,>>9.99":U
      125         ot-tot.VAT-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      126         ot-tot.SLT-base FORMAT "->>>,>>>,>>9.99":U
      127         ot-tot.SLT-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      128         ot-tot.road-tax-base FORMAT "->,>>>,>>9.99":U
      129         ot-tot.road-tax-rubl FORMAT "->,>>>,>>9.99":U
      130         ot-tot.transport-base FORMAT "->,>>>,>>9.99":U
      131         ot-tot.transport-rubl FORMAT "->,>>>,>>9.99":U
      132         ot-tot.other-base FORMAT "->,>>>,>>9.99":U
      133         ot-tot.other-rubl FORMAT "->,>>>,>>9.99":U
      134         ot-tot.excise-base FORMAT "->>>,>>>,>>9.99":U
      135         ot-tot.excise-rubl FORMAT "->,>>>,>>>,>>>,>>9.99":U
      136         ot-tot.fact-order FORMAT "9999999999999999999999.9999999999":U
      137         ot-tot.obj-type FORMAT "X(3)":U
      138         ot-tot.obj-code FORMAT "99999":U
      139       WITH NO-ASSIGN SEPARATORS SIZE 95.25 BY 6.71.
      140   DEFINE FRAME F-Main
      141        br_table AT ROW 1 COL 1
      142       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      143            SIDE-LABELS NO-UNDERLINE THREE-D
      144            AT COL 1 ROW 1 SCROLLABLE
      145            BGCOLOR 8 FGCOLOR 0 .
      146   DEFINE VARIABLE adm-sts           AS LOGICAL NO-UNDO.
      147   DEFINE VARIABLE adm-brs-in-update AS LOGICAL NO-UNDO INIT no.
      148   DEFINE VARIABLE adm-brs-initted   AS LOGICAL NO-UNDO INIT no.
      149   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      150   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      151   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      152   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      153   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      154   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      155   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      156   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      157         adm-object-hdl = FRAME F-Main:HANDLE.
      158   RUN ensure-broker.
      159   THIS-PROCEDURE:ADM-DATA =
      160        'ADM1.1~`':U +
      161        'SmartDataViewer~`':U +
      162        '~`':U +
      163        'YES~`':U +
      164        'trn-doc~`':U +
      165        'ot-tot~`':U +
      166        '~`':U +
      167        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      168           + "~`":U +
      169        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add,SortBy-Case~`':U +
      170        'Record-Source,Record-Target,TableIO-Target~`':U +
      171        '~`':U +
      172        '~`~`~`~`~`~`~`~`~`~`~`':U +
      173        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      174            THEN "^^":U
      175        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      176             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      177   PROCEDURE adm-apply-entry :
      178     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      179   END PROCEDURE.
      180   PROCEDURE adm-destroy :
      181    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      182   END PROCEDURE.
      183   PROCEDURE adm-disable :
      184       DISABLE br_table WITH FRAME F-Main.
      185       RUN dispatch ('disable-fields':U).
      186       RUN set-attribute-list ('ENABLED=no':U).
      187       RETURN.
      188   END PROCEDURE.
      189   PROCEDURE adm-edit-attribute-list :
      190         RUN adm/support/browserd.w (INPUT THIS-PROCEDURE).
      191         RETURN.
      192   END PROCEDURE.
      193   PROCEDURE adm-enable :
      194       ENABLE UNLESS-HIDDEN br_table WITH FRAME F-Main.
      195       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      196       RUN set-attribute-list ('ENABLED=yes':U).
      197       RETURN.
      198   END PROCEDURE.
      199   PROCEDURE adm-exit :
      200        RUN notify ('exit':U).
      201     RETURN.
      202   END PROCEDURE.
      203   PROCEDURE adm-hide :
      204     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      205   END PROCEDURE.
      206   PROCEDURE adm-initialize :
      207     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      208   END PROCEDURE.
      209   PROCEDURE adm-show-errors :
      210       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      211       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      212           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      213       END.
      214       RETURN.
      215   END PROCEDURE.
      216   PROCEDURE adm-UIB-mode :
      217     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      218   END PROCEDURE.
      219   PROCEDURE adm-view :
      220     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      221   END PROCEDURE.
      222   PROCEDURE dispatch :
      223       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      224       RUN broker-dispatch IN adm-broker-hdl
      225           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      226       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      227   END PROCEDURE.
      228   PROCEDURE ensure-broker :
      229   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      230   IF RETURN-VALUE NE "ADM-Broker":U THEN
      231   DO:
      232       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      233       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      234   END.
      235   END PROCEDURE.
      236   PROCEDURE get-attribute :
      237     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      238     RUN broker-get-attribute IN adm-broker-hdl
      239         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      240     RETURN RETURN-VALUE.
      241   END PROCEDURE.
      242   PROCEDURE get-attribute-list :
      243     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      244     RUN broker-get-attribute-list IN adm-broker-hdl
      245         (INPUT THIS-PROCEDURE,
      246          INPUT ?,
      247          OUTPUT p-attr-list) NO-ERROR.
      248     RETURN.
      249   END PROCEDURE.
      250   PROCEDURE new-state :
      251     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      252     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      253     RETURN.
      254   END PROCEDURE.
      255   PROCEDURE notify :
      256     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      257     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      258     IF RETURN-VALUE = "ADM-ERROR":U THEN
      259         RETURN "ADM-ERROR":U.
      260     RETURN.
      261   END PROCEDURE.
      262   PROCEDURE set-attribute-list :
      263     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      264     RUN ensure-broker.
      265     RUN broker-set-attribute-list IN adm-broker-hdl
      266         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      267     RETURN.
      268   END PROCEDURE.
      269   PROCEDURE set-position :
      270       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      271       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      272       IF VALID-HANDLE(adm-object-hdl) THEN
      273       DO:
      274         ASSIGN adm-object-hdl:ROW    =   p-row
      275                adm-object-hdl:COLUMN =   p-col.
      276       END.
      277       RETURN.
      278   END PROCEDURE.
      279     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      280     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      281     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      282     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      283     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      284     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      285     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      286     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      287     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      288     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      289     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      290     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      291     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      292     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      293     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      294     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      295     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      296     IF "":U = "":U THEN
      297       RUN modify-list-attribute IN adm-broker-hdl
      298         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      299     RUN use-create-on-add(?).
      300   PROCEDURE adm-add-record :
      301       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      302          "must have at least one Enabled Table to perform Add.":U
      303          VIEW-AS ALERT-BOX ERROR.
      304       RETURN.
      305   END PROCEDURE.
      306   PROCEDURE adm-assign-record :
      307    MESSAGE
      308          "Object ":U THIS-PROCEDURE:FILE-NAME
      309            "must have at least one Enabled Table to perform Assign.":U
      310              VIEW-AS ALERT-BOX ERROR.
      311      RETURN.
      312     END PROCEDURE.
      313   PROCEDURE adm-assign-statement :
      314     RETURN.
      315   END PROCEDURE.
      316   PROCEDURE adm-cancel-record :
      317      RETURN.
      318     END PROCEDURE.
      319   PROCEDURE adm-copy-record :
      320       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      321        "must have at least one Enabled Table to perform Copy.":U
      322          VIEW-AS ALERT-BOX ERROR.
      323       RETURN.
      324   END PROCEDURE.
      325   PROCEDURE adm-create-record :
      326      RETURN.
      327   END PROCEDURE.
      328   PROCEDURE adm-current-changed :
      329     RETURN.
      330   END PROCEDURE.
      331   PROCEDURE adm-delete-record :
      332    MESSAGE
      333          "Object ":U THIS-PROCEDURE:FILE-NAME
      334            "must have at least one Enabled Table to perform Delete.":U
      335              VIEW-AS ALERT-BOX ERROR.
      336       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      337       RETURN.
      338   END PROCEDURE.
      339   PROCEDURE adm-disable-fields :
      340         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      341       RETURN.
      342   END PROCEDURE.
      343   PROCEDURE adm-enable-fields :
      344       RETURN.
      345   END PROCEDURE.
      346   PROCEDURE adm-end-update :
      347     RETURN.
      348   END PROCEDURE.
      349   PROCEDURE adm-reset-record :
      350       RETURN.
      351   END PROCEDURE.
      352   PROCEDURE adm-update-record :
      353       MESSAGE
      354         "Object ":U THIS-PROCEDURE:FILE-NAME
      355           "must have at least one Enabled Table to perform Update.":U
      356             VIEW-AS ALERT-BOX ERROR.
      357      RETURN.
      358   END PROCEDURE.
      359   PROCEDURE check-modified :
      360   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      361   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      362   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      363   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      364     IF check-state = "check":U THEN
      365     DO:
      366       RUN get-link-handle IN adm-broker-hdl
      367         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      368            OUTPUT group-target-list).
      369       IF group-target-list NE "":U THEN
      370       DO i = 1 TO NUM-ENTRIES(group-target-list):
      371         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      372         RUN check-modified IN curr-widget ('group-check':U).
      373         IF RETURN-VALUE NE "":U THEN
      374         DO:
      375           RUN check-modified-message(RETURN-VALUE).
      376           RETURN "":U.
      377         END.
      378       END.
      379     END.
      380     RETURN "":U.
      381   END PROCEDURE.
      382   PROCEDURE check-modified-message :
      383     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      384        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      385           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      386        IF RETURN-VALUE = "YES":U THEN
      387           RUN notify ('view,CONTAINER-SOURCE':U).
      388        MESSAGE IF p-changed-table NE ? THEN
      389           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      390           ELSE "Current values have been changed."
      391           SKIP "  Do you wish to save those changes?"
      392           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      393        IF ANS THEN
      394        DO:
      395           IF group-assign-target THEN
      396             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      397           ELSE RUN dispatch('update-record':U).
      398           IF RETURN-VALUE = "ADM-ERROR":U THEN
      399           DO:
      400               MESSAGE "Changes to the previous record were not saved."
      401                 VIEW-AS ALERT-BOX ERROR.
      402               IF group-assign-target THEN
      403                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      404               ELSE RUN dispatch ('cancel-record':U).
      405           END.
      406        END.
      407        ELSE DO:
      408          IF group-assign-target THEN
      409             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      410          ELSE RUN dispatch('cancel-record':U).
      411        END.
      412        RETURN.
      413   END PROCEDURE.
      414   PROCEDURE get-rowid :
      415       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      416       ASSIGN
      417       p-table   =   adm-first-table.
      418       RETURN.
      419   END PROCEDURE.
      420   PROCEDURE init-group-assign :
      421       RUN request-attribute IN adm-broker-hdl
      422         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      423       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      424         group-assign-target = yes.
      425       ELSE group-assign-target = no.
      426       RETURN.
      427   END PROCEDURE.
      428   PROCEDURE set-editors :
      429       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      430       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      431       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      432       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      433       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      434       DO WHILE VALID-HANDLE (curr-widget):
      435           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      436              curr-widget:HIDDEN = no THEN DO:
      437             CASE p-field-setting:
      438               WHEN "INITIALIZE":U THEN
      439               DO:
      440                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      441                     read-only-list +
      442                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      443                        STRING(curr-widget).
      444               END.
      445               WHEN "DISABLE":U OR
      446               WHEN "ENABLE":U THEN
      447               DO:
      448                   curr-widget:SENSITIVE = yes.
      449                   RUN get-attribute ('Read-Only-Editors':U).
      450                   IF RETURN-VALUE = ? OR
      451                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      452                       curr-widget:READ-ONLY =
      453                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      454               END.
      455               WHEN "CLEAR":U THEN
      456                   curr-widget:SCREEN-VALUE = "":U.
      457             END CASE.
      458           END.
      459           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      460       END.
      461       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      462         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      463           + '"':U).
      464       RETURN.
      465   END PROCEDURE.
      466   PROCEDURE use-check-modified-all :
      467    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      468     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      469     RETURN.
      470   END PROCEDURE.
      471   PROCEDURE use-create-on-add :
      472   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      473      RETURN.
      474   END PROCEDURE.
      475   PROCEDURE use-initial-lock :
      476     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      477     ASSIGN adm-initial-lock = p-attr-value.
      478     RETURN.
      479   END PROCEDURE.
      480   PROCEDURE adm-display-fields :
      481         IF AVAILABLE ot-tot THEN
      482             DISPLAY ot-tot.doc-code ot-tot.sum-type ot-tot.cat-id ot-tot.ext-doc-type ot-tot.fact-qnty ot-tot.sum-base ot-tot.sum-rubl ot-tot.VAT-base ot-tot.VAT-rubl ot-tot.SLT-base ot-tot.SLT-rubl ot-tot.road-tax-base ot-tot.road-tax-rubl ot-tot.transport-base ot-tot.transport-rubl ot-tot.other-base ot-tot.other-rubl ot-tot.excise-base ot-tot.excise-rubl ot-tot.fact-order ot-tot.obj-type ot-tot.obj-code WITH BROWSE br_table
      483               NO-ERROR.
      484       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      485       RETURN.
      486   END PROCEDURE.
      487   PROCEDURE adm-open-query :
      488       IF AVAILABLE(trn-doc) THEN DO:
      489               OPEN QUERY br_table FOR EACH ot-tot OF trn-doc WHERE TRUE NO-LOCK     .
      490           adm-query-opened = yes.
      491           IF NUM-RESULTS("br_table":U) = 0 THEN
      492               RUN new-state ('no-record-available,SELF':U).
      493           ELSE DO:
      494               RUN new-state ('record-available,SELF':U).
      495               RUN new-state ('first-record,SELF':U).
      496           END.
      497       END.
      498       ELSE
      499       DO:
      500           CLOSE QUERY br_table.
      501           RELEASE ot-tot NO-ERROR.
      502           RUN new-state ('no-external-record-available,SELF':U).
      503       END.
      504           IF NOT adm-updating-record THEN
      505               RUN dispatch IN THIS-PROCEDURE ('row-changed':U).
      506     RETURN.
      507   END PROCEDURE.
      508   PROCEDURE adm-row-changed :
      509         IF VALID-HANDLE(adm-object-hdl) THEN
      510           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      511         RUN notify ('row-available':U).
      512         RETURN.
      513   END PROCEDURE.
      514   PROCEDURE reposition-query :
      515       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      516       DEFINE VARIABLE table-name                 AS ROWID NO-UNDO.
      517       RUN get-rowid IN p-requestor-hdl (OUTPUT table-name).
      518       IF table-name <> ? THEN
      519           REPOSITION br_table TO ROWID table-name NO-ERROR.
      520       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      521       RETURN.
      522   END PROCEDURE.
      523     adm-sts = br_table:SET-REPOSITIONED-ROW
      524       (br_table:DOWN,"CONDITIONAL":U).
      525     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      526   PROCEDURE set-size :
      527     DEFINE INPUT PARAMETER pd_height AS DECIMAL NO-UNDO.
      528     DEFINE INPUT PARAMETER pd_width  AS DECIMAL NO-UNDO.
      529     DEFINE VARIABLE hBrowse     AS HANDLE           NO-UNDO.
      530     DEFINE VARIABLE hFieldGroup AS HANDLE           NO-UNDO.
      531     DEFINE VARIABLE hFrame      AS HANDLE           NO-UNDO.
      532     DEFINE VARIABLE htmpWidget  AS HANDLE           NO-UNDO.
      533     DEFINE VARIABLE otherWidget AS LOGICAL          NO-UNDO.
      534     ASSIGN pd_height = MAX(pd_height, 2.0)
      535            pd_width  = MAX(pd_width, 2.0)
      536            hBrowse     = br_table:HANDLE IN FRAME F-Main
      537            hFieldGroup = hBrowse:PARENT
      538            htmpWidget  = hFieldGroup:FIRST-CHILD
      539            hFrame      = hFieldGroup:PARENT.
      540     Search-For-Siblings:
      541     REPEAT WHILE VALID-HANDLE(htmpWidget):
      542       IF htmpWidget NE hBrowse THEN DO:
      543         IF htmpWidget:TYPE NE "BUTTON" OR
      544            htmpWidget:X    NE 4 OR
      545            htmpWidget:Y    NE 4 THEN DO:
      546           RETURN.
      547         END.
      548       END.
      549       htmpWidget = htmpWidget:NEXT-SIBLING.
      550     END.
      551     IF pd_width < hBrowse:WIDTH THEN
      552       ASSIGN hBrowse:WIDTH = pd_width
      553              hFrame:WIDTH  = pd_width     NO-ERROR.
      554     ELSE
      555       ASSIGN hFrame:WIDTH  = pd_width
      556              hBrowse:WIDTH = pd_width     NO-ERROR.
      557     IF pd_height < hBrowse:HEIGHT THEN
      558       ASSIGN hBrowse:HEIGHT = pd_height
      559              hFrame:HEIGHT  = pd_height     NO-ERROR.
      560     ELSE
      561       ASSIGN hFrame:HEIGHT  = pd_height
      562              hBrowse:HEIGHT = pd_height     NO-ERROR.
      563   END PROCEDURE.
      564   ASSIGN
      565          FRAME F-Main:SCROLLABLE       = FALSE
      566          FRAME F-Main:HIDDEN           = TRUE.
      567   ASSIGN
      568          br_table:NUM-LOCKED-COLUMNS IN FRAME F-Main     = 3.
      569   ON ROW-ENTRY OF br_table IN FRAME F-Main
      570   DO:
      571   END.
      572   ON ROW-LEAVE OF br_table IN FRAME F-Main
      573   DO:
      574   DEFINE VARIABLE widget-enter  AS HANDLE NO-UNDO.
      575   DEFINE VARIABLE widget-frame  AS HANDLE NO-UNDO.
      576   DEFINE VARIABLE widget-parent AS HANDLE NO-UNDO.
      577     widget-enter = last-event:widget-enter.
      578     IF VALID-HANDLE(widget-enter) THEN widget-parent = widget-enter:PARENT.
      579     IF VALID-HANDLE(widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      580       THEN widget-frame = widget-enter:FRAME.
      581     IF ((NOT VALID-HANDLE(widget-enter)) OR
      582         (widget-parent:TYPE = "BROWSE":U) OR
      583         (NOT VALID-HANDLE(widget-frame)) OR
      584         (NOT CAN-DO(widget-frame:PRIVATE-DATA, "ADM-PANEL":U)))
      585     THEN DO:
      586         IF adm-brs-in-update THEN
      587         DO:
      588           MESSAGE
      589           "You must complete or cancel the update before leaving the current row."
      590               VIEW-AS ALERT-BOX WARNING.
      591           RETURN NO-APPLY.
      592         END.
      593         IF br_table:CURRENT-ROW-MODIFIED  OR
      594           (adm-new-record AND BROWSE br_table:NUM-SELECTED-ROWS = 1) THEN
      595         DO:
      596           IF VALID-HANDLE (widget-parent) AND widget-parent:TYPE NE "BROWSE":U
      597           THEN DO:
      598             MESSAGE
      599             "Current record has been changed. " SKIP
      600             "Do you wish to save those changes?"
      601               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE l-save AS LOGICAL.
      602             IF l-save THEN
      603             DO:
      604                RUN dispatch('update-record':U).
      605                IF RETURN-VALUE = "ADM-ERROR":U THEN
      606                    RETURN NO-APPLY.
      607             END.
      608             ELSE RUN dispatch ('cancel-record':U).
      609           END.
      610           ELSE DO:
      611             RUN dispatch('update-record':U).
      612             IF RETURN-VALUE = "ADM-ERROR":U THEN
      613                 RETURN NO-APPLY.
      614           END.
      615         END.
      616     END.
      617   END.
      618   ON VALUE-CHANGED OF br_table IN FRAME F-Main
      619   DO:
      620   RUN get-attribute('ADM-NEW-RECORD':U).
      621   IF RETURN-VALUE NE "YES":U THEN
      622     RUN notify ('row-available':U).
      623   END.
      624   if not this-procedure :persistent
      625   then do:
      626     message
      627       vss-workfile vss-revision vss-description skip
      628       "Ошибка при запуске процедуры" skip
      629       "Данную процедуру следует запускать только с параметром persistent" skip
      630       view-as alert-box error .
      631     undo, return error .
      632   end.
      633   PROCEDURE adm-row-available :
      634     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      635     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      636     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      637     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      638     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      639     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      640     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      641     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      642     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      643     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      644     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      645     IF adm-updating-record THEN RETURN.
      646     RUN get-attribute ('FIELDS-ENABLED':U).
      647     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      648     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      649         OUTPUT link-handle) NO-ERROR.
      650     IF link-handle = "":U THEN
      651         RETURN.
      652     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      653     IF NUM-ENTRIES(link-handle) > 1 THEN
      654         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      655             "encountered more than one RECORD-SOURCE.":U SKIP
      656             "The first - ":U record-source-hdl:file-name " - will be used.":U
      657                VIEW-AS ALERT-BOX ERROR.
      658     RUN get-attribute ('Key-Name':U).
      659     key-name = RETURN-VALUE.
      660     IF key-name = "":U THEN key-name = ?.
      661     IF key-name NE ? THEN DO:
      662       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      663         NO-ERROR.
      664       IF key-value NE ? THEN
      665         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      666     END.
      667     IF key-name eq ? THEN tbl-list = "trn-doc":U.
      668         RUN send-records IN record-source-hdl
      669             (INPUT tbl-list, OUTPUT rowid-list) NO-ERROR.
      670         IF ERROR-STATUS:ERROR THEN RETURN.
      671     IF key-name ne ?
      672     THEN DO:
      673       RUN dispatch ('find-using-key':U).
      674       IF RETURN-VALUE eq "ADM-ERROR":U THEN RETURN RETURN-VALUE.
      675     END.
      676     ELSE
      677     DO:
      678       row-avail-cntr = row-avail-cntr + 1.
      679       row-avail-rowid = TO-ROWID(ENTRY(row-avail-cntr,rowid-list)).
      680       IF row-avail-rowid NE ROWID(trn-doc) THEN different-row = yes.
      681       IF row-avail-rowid ne ? THEN DO:
      682          DO:
      683            IF row-avail-enabled AND
      684               (adm-initial-lock = "SHARE-LOCK":U OR
      685                adm-initial-lock = "EXCLUSIVE-LOCK":U) THEN
      686            DO:
      687              IF adm-initial-lock = "SHARE-LOCK":U
      688              THEN FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid SHARE-LOCK NO-ERROR.
      689              ELSE DO TRANSACTION:
      690                FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid EXCLUSIVE-LOCK NO-ERROR.
      691              END.
      692            END.
      693            ELSE FIND trn-doc WHERE ROWID(trn-doc) = row-avail-rowid  NO-LOCK NO-ERROR.
      694            IF ERROR-STATUS:ERROR THEN DO:
      695              RUN dispatch ('show-errors':U).
      696              RETURN "ADM-ERROR":U.
      697            END.
      698          END.
      699       END.
      700       ELSE DO:
      701            IF AVAILABLE trn-doc THEN RELEASE trn-doc.
      702              IF NOT different-row THEN
      703                RUN dispatch('open-query').
      704        END.
      705     END.
      706   IF VALID-HANDLE (adm-object-hdl) THEN
      707       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      708     IF key-name ne ? OR different-row
      709     THEN RUN dispatch IN THIS-PROCEDURE ('open-query':U).
      710     ELSE RUN notify IN THIS-PROCEDURE('row-available':U).
      711   END PROCEDURE.
      712   PROCEDURE disable_UI :
      713     HIDE FRAME F-Main.
      714     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      715   END PROCEDURE.
      716   PROCEDURE send-records :
      717     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
      718     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
      719     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
      720     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
      721     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
      722     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
      723         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
      724         CASE ENTRY(i, p-tbl-list):
      725       WHEN "trn-doc":U THEN p-rowid-list = p-rowid-list +
      726           IF AVAILABLE trn-doc THEN STRING(ROWID(trn-doc))
      727           ELSE "?":U.
      728       WHEN "ot-tot":U THEN p-rowid-list = p-rowid-list +
      729           IF AVAILABLE ot-tot THEN STRING(ROWID(ot-tot))
      730           ELSE "?":U.
      731           OTHERWISE
      732           DO:
      733               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      734                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
      735               IF link-handle NE "":U THEN
      736               DO:
      737                   IF NUM-ENTRIES(link-handle) > 1 THEN
      738                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
      739                               "encountered more than one RECORD-SOURCE.":U SKIP
      740                               "The first will be used.":U
      741                               VIEW-AS ALERT-BOX ERROR.
      742                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
      743                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
      744                   p-rowid-list = p-rowid-list + rowid-string.
      745               END.
      746               ELSE
      747               DO:
      748                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
      749                           "does not match tables in send-records":U
      750                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
      751                           "Check that objects are linked properly and that":U
      752                           "database qualification is consistent.":U
      753                       VIEW-AS ALERT-BOX ERROR.
      754                   RETURN ERROR.
      755               END.
      756           END.
      757           END CASE.
      758       END.
      759   END PROCEDURE.
      760   PROCEDURE state-changed :
      761     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      762     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      763     CASE p-state:
      764       WHEN "update-begin":U THEN
      765       DO:
      766           adm-brs-in-update = yes.
      767           RUN dispatch ('enable-fields':U).
      768           IF RETURN-VALUE = "ADM-ERROR":U THEN
      769           DO:
      770             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      771             RUN new-state('update-complete':U).
      772           END.
      773           ELSE DO:
      774             RUN dispatch ('apply-entry':U).
      775             RUN new-state('update':U).
      776           END.
      777       END.
      778       WHEN "update":U THEN
      779         DO:
      780           DEFINE VARIABLE group-link AS CHARACTER NO-UNDO INIT "":U.
      781           RUN get-link-handle IN adm-broker-hdl
      782               (INPUT THIS-PROCEDURE, 'GROUP-ASSIGN-TARGET':U, OUTPUT group-link)
      783                   NO-ERROR.
      784           IF LOOKUP(STRING(p-issuer-hdl), group-link) EQ 0 THEN
      785             br_table:SENSITIVE IN FRAME F-Main = no.
      786         END.
      787       WHEN "update-complete":U THEN DO:
      788           br_table:SENSITIVE IN FRAME F-Main = yes.
      789           adm-brs-in-update = no.
      790           RUN get-attribute IN p-issuer-hdl ('QUERY-OBJECT':U).
      791           IF RETURN-VALUE NE "YES":U THEN
      792           DO:
      793             IF NUM-RESULTS("br_table":U) NE ? AND
      794                NUM-RESULTS("br_table":U) NE 0
      795             THEN DO:
      796               GET CURRENT br_table.
      797               RUN dispatch ('row-changed':U).
      798             END.
      799           END.
      800           RUN new-state ('update-complete':U).
      801       END.
      802       WHEN "delete-complete":U THEN DO:
      803          DEFINE VARIABLE sts AS LOGICAL NO-UNDO.
      804          sts = br_table:DELETE-CURRENT-ROW() IN FRAME F-Main.
      805          IF NUM-RESULTS("br_table":U) = 0 THEN
      806            RUN notify('row-available':U).
      807       END.
      808       WHEN   'first-record':U        OR
      809         WHEN 'last-record':U         OR
      810         WHEN 'only-record':U         OR
      811         WHEN 'not-first-or-last':U   OR
      812         WHEN 'no-record-available':U OR
      813         WHEN 'no-external-record-available':U THEN
      814           RUN set-attribute-list('Query-Position=':U + p-state).
      815     END CASE.
      816   END PROCEDURE.
