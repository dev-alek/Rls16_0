       82   define output parameter p-ok-doc as integer   no-undo .
       83   define variable vss-revision    as character no-undo init "$Revision: 288743b2d1c0, 2956, rls $":U .
       84   define variable vss-author      as character no-undo init "$Author: VRukavishnikov $":U .
       85   define variable vss-date        as character no-undo init "$Date: 2022/04/06 13:23:40 $":U .
       86   define variable vss-workfile    as character no-undo init "$Workfile: ora-i517.p $":U .
       87   define variable vss-archive     as character no-undo init "$Archive: utl/ora-i517.p $":U .
       88   define variable vss-description as character no-undo init "Импорт накладных из временной таблицы".
       89   procedure vss-get-info :
       90     define output parameter p-vss-revision    like vss-revision    no-undo .
       91     define output parameter p-vss-author      like vss-author      no-undo .
       92     define output parameter p-vss-date        like vss-date        no-undo .
       93     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       94     define output parameter p-vss-archive     like vss-archive     no-undo .
       95     define output parameter p-vss-description like vss-description no-undo .
       96     assign
       97       p-vss-revision    = vss-revision
       98       p-vss-author      = vss-author
       99       p-vss-date        = vss-date
      100       p-vss-workfile    = vss-workfile
      101       p-vss-archive     = vss-archive
      102       p-vss-description = vss-description
      103     .
      104   end procedure.
      105   procedure vss-get-parameters :
      106     define output parameter p-vss-parameters as character no-undo .
      107   end procedure.
      108   define new global shared variable g#vssrevis-logger as handle    no-undo .
      109   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      110   define variable v-vssrevis-logger                   as handle    no-undo .
      111   procedure vss-logevent :
      112     define input  parameter p-extra-paramters as character no-undo .
      113     define variable v-vssrevis-parameters as character no-undo .
      114     do
      115     on error undo, return error return-value
      116     :
      117       if  valid-handle(v-vssrevis-logger)
      118       and v-vssrevis-logger :get-signature("logevent") <> ""
      119       then do:
      120         run vss-get-parameters in this-procedure
      121           (output v-vssrevis-parameters
      122           ).
      123         run logevent in v-vssrevis-logger
      124           (input vss-workfile
      125           ,input vss-revision
      126           ,input v-vssrevis-parameters
      127           ,input p-extra-paramters
      128           ).
      129       end.
      130     end.
      131   end procedure.
      132   assign
      133     v-vssrevis-logger = g#vssrevis-logger
      134   .
      135   if  valid-handle(v-vssrevis-logger)
      136   and v-vssrevis-logger :get-signature("logevent") <> ""
      137   then do:
      138     assign
      139       v-vssrevis-logevent = true
      140     .
      141     run vss-logevent in this-procedure (input vss-description) .
      142   end.
      143   define new global shared variable g#language as character no-undo .
      144   if g#language <> '' and g#language <> 'rus':U then do:
      145     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      146   end.
      147   define new global shared variable g#library  as handle no-undo .
      148   define new global shared variable g#library2 as handle no-undo .
      149   define new global shared variable g#lib-trn  as handle no-undo .
      150   define new global shared variable g#lib-trn2 as handle no-undo .
      151   define new global shared variable g#lib-trn3 as handle no-undo .
      152   define new global shared variable g#lib-trn4 as handle no-undo .
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   define variable to-day       as date no-undo .
      155   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   procedure doc-code:
      157   define input  parameter parmode          as   character           no-undo.
      158   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      159   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      160   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      161   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      162   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      163   define variable vardb-remote     as   logical             no-undo.
      164   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      165   define variable v-delimiter as character no-undo .
      166   do
      167   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      168   :
      169   find first buf_sys-ctrl no-lock .
      170   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      171     CASE parmode:
      172       when "main":u then do:
      173         if vardb-remote then do:
      174           assign
      175             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      176         end.
      177         else do:
      178           assign
      179             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      180         end.
      181       end.
      182       when "trio" then do:
      183         assign
      184           pardoc-code = replace (parroot-doc-code, "=", "*").
      185       end.
      186       otherwise do:
      187         assign
      188         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      189         no-error
      190         .
      191         if error-status:error  then do:
      192           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      193                                         ,chr(10)
      194                                         ,parmode
      195                                         ).
      196         end.
      197         if num-entries(parmode) = 1
      198         and parmode <> "chip":U
      199         and parmode <> "chip_s":U
      200         then do:
      201           assign
      202           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      203         end.
      204         else if (lookup("chip":U, parmode) > 0
      205                  or
      206                  lookup("chip_s":U, parmode) > 0) then do:
      207           assign
      208             vartemp-doc-code = parroot-doc-code.
      209           do while true:
      210             if index (vartemp-doc-code , ".") = 0 then
      211               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      212             else
      213               vartemp-doc-code  =
      214               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      215               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      216               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      217             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      218           end.
      219           assign
      220             pardoc-code = vartemp-doc-code.
      221         end.
      222       end.
      223     end CASE.
      224     if pardoc-code = '':U
      225     or (parroot-doc-code <> '':U
      226     and pardoc-code = parroot-doc-code) then do:
      227       undo, return error substitute("Ошибка при генерации номера документа&1"
      228                                     ,chr(10)).
      229     end.
      230   end.
      231   end. // procedure/method
      232   function get-doc-code-int64 returns int64
      233     ( input p-doc-code as character ) :
      234     define variable v-ind              as integer   no-undo .
      235     define variable v-num-entries      as integer   no-undo .
      236     define variable v-doc-code-int64   as int64     no-undo .
      237     define variable v-canonic-doc-code as character no-undo .
      238     assign
      239       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      240       v-canonic-doc-code = p-doc-code
      241     .
      242     do v-ind = 1 to v-num-entries
      243     :
      244       assign
      245         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      246       .
      247     end.
      248     assign
      249       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      250     .
      251     return v-doc-code-int64 .
      252   end. // function/method
      253   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   define variable v-waitfram-action01         as character   no-undo .
      255   define variable v-waitfram-action02         as character   no-undo .
      256   define variable v-waitfram-action03         as character   no-undo .
      257   define variable mWaitFramTextBeg            as character   no-undo.
      258   define variable mWaitFramTextEnd            as character   no-undo.
      259   define variable mWaitFramView               as logical     no-undo.
      260   define variable mWaitProcEvent              as logical     no-undo init yes.
      261   define variable mWaitFramInterval           as integer     no-undo init 1 .
      262   define variable mWaitFramStop               as logical     no-undo.
      263   define variable mWaitFramStopUser           as logical     no-undo.
      264   define variable mWaitFramStopTimeOut        as logical     no-undo.
      265   define variable mWaitFramStartProc          as datetime-tz no-undo.
      266   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      267   define button B-WaitFramStop auto-end-key
      268        label "Стоп"
      269        size 10 by 1 tooltip "Остоновить процесс".
      270   define button B-viewProcInfo
      271        label "Информация"
      272        size 15 by 1 tooltip "Информация о процесс".
      273   define frame waitfram
      274     v-waitfram-action01 format "x(72)" no-label skip
      275     v-waitfram-action02 format "x(72)" no-label skip
      276     v-waitfram-action03 format "x(72)" no-label skip
      277     B-viewProcInfo
      278     B-WaitFramStop at row 4 col 30
      279     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      280     .
      281   define new global shared variable mBatchMode as logical no-undo init ?.
      282   define variable mFramBachModHandle as handle no-undo.
      283   mFramBachModHandle = frame waitfram:handle.
      284   define variable mFameOldVis as logical no-undo.
      285   define variable mVisCUrentVin as logical no-undo.
      286   if session:batch-mode
      287   then
      288      mBatchMode = yes.
      289   if mBatchMode = ? then do:
      290     mVisCUrentVin = current-window:visible.
      291     mFameOldVis = mFramBachModHandle:visible.
      292     mFramBachModHandle:visible  = yes.
      293     mBatchMode = mFramBachModHandle:visible ne yes.
      294     mFramBachModHandle:visible = mFameOldVis.
      295     current-window:visible = mVisCUrentVin.
      296   end.
      297    if  log-manager:logfile-name ne ?
      298     then DO:
      299         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      300         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      301         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      302     end.
      303   on choose of B-WaitFramStop in frame waitfram
      304   do:
      305     mWaitFramStop = yes.
      306     mWaitFramStopUser = yes.
      307   end.
      308   function waitfram-check-timeout returns logical():
      309      define variable vtime as int64 no-undo.
      310      if mWaitFramStopTimeOut
      311      then
      312         return yes.
      313      vtime = ( now - mWaitFramStartProc ) / 1000 .
      314      if     mWaitFramTimeOut ne ?
      315         and mWaitFramTimeOut ne 0
      316         and mWaitFramTimeOut lt vtime
      317      then do:
      318         mWaitFramStopTimeOut = yes.
      319      end.
      320      return mWaitFramStopTimeOut.
      321   end.
      322   procedure waitfram-hide :
      323     if not session:batch-mode
      324     then do
      325     on error undo, return error return-value
      326     :
      327       pause 0 before-hide .
      328       if not mBatchMode then
      329         hide frame waitfram .
      330     if     not mWaitFramView
      331        and mWaitProcEvent
      332     then
      333       process events .
      334     end.
      335   end procedure.
      336   procedure waitfram-show :
      337     define input  parameter p-message as character no-undo .
      338     define variable v-left-margin as integer   no-undo .
      339     if not session:batch-mode
      340     then do
      341     on error undo, return error return-value
      342     :
      343       if length(p-message) <= 70 then do:
      344         assign
      345           v-left-margin = integer((70 - length(p-message)) / 2)
      346         .
      347         assign
      348           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      349         .
      350         assign
      351           v-waitfram-action01 = " "
      352           v-waitfram-action02 = " "
      353                                    + fill(" ", v-left-margin)
      354                                    + p-message
      355           v-waitfram-action03 = " "
      356         .
      357       end.
      358       else do:
      359         define variable vRindex1 as integer no-undo.
      360         define variable vRindex2 as integer no-undo.
      361         vRindex1 = r-index(p-message," ",70).
      362         if vRindex1 = 0
      363         then
      364            vRindex1 = 70.
      365         if length(p-message)  <= vRindex1 + 70 then do:
      366           assign
      367             v-waitfram-action01 = " "
      368             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      369             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      370           .
      371         end.
      372         else do:
      373           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      374           if vRindex2 <= vRindex1
      375           then
      376              vRindex2 = vRindex1 + 70.
      377           assign
      378             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      379             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      380             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      381           .
      382         end.
      383       end.
      384       B-viewProcInfo:visible   in frame waitfram = no.
      385       B-viewProcInfo:sensitive in frame waitfram = no.
      386       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      387       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      388       if  (   mWaitFramView
      389          or  mWaitProcEvent)
      390          and not mBatchMode
      391       then
      392          display
      393             v-waitfram-action01 skip
      394             v-waitfram-action02 skip
      395             v-waitfram-action03 skip
      396          with frame waitfram .
      397       if     mWaitFramView
      398          then do:
      399             if     mWaitFramInterval ne ?
      400                and not mBatchMode
      401             then
      402                wait-for go of frame waitfram pause mWaitFramInterval.
      403          end.
      404          else
      405             if     mWaitProcEvent
      406                and not mBatchMode
      407             then
      408                process events .
      409     end.
      410   end procedure.
      411      procedure waitfram-show-this:
      412         define input  parameter iInterval as int64 no-undo.
      413         define variable vtime as int64 no-undo.
      414         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      415         mWaitFramInterval = iInterval.
      416         run waitfram-show (substitute("&1&2 &3&4" ,
      417                                       mWaitFramTextBeg ,
      418                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      419                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      420                                       mWaitFramTextEnd
      421                                      )
      422                           ).
      423      end.
      424      procedure WaitFramRunPause:
      425         define input  parameter iInterval as dec no-undo.
      426         define variable vStart  as datetime-tz no-undo.
      427         define variable vend    as datetime-tz no-undo.
      428         define variable vint as int64 no-undo.
      429         define variable vOk as logical no-undo.
      430         vStart = now.
      431         vend   = vStart.
      432         publish "WaitFramPause" (iInterval,output vOk).
      433         vend   =  now.
      434         vint = vend - vStart.
      435         vint = iInterval - vint / 1000.
      436         if     not mWaitFramStop
      437            and (   vint > 0
      438                 or (    not vOk
      439                     and iInterval eq ?
      440                     )
      441                 )
      442         then
      443            run waitfram-show-this (iInterval).
      444         vend   =  now.
      445         vint = vend - vStart.
      446         vint = iInterval - vint / 1000.
      447         if     not mWaitFramStop
      448            and vint > 0
      449         then do:
      450            run gbl/pause.p (vint * 1000).
      451         end.
      452         if iInterval ne ?
      453         then
      454            publish "WaitFramStop".
      455         waitfram-check-timeout().
      456      end.
      457      procedure WaitFramWaitFor:
      458         define input  parameter iInterval as dec no-undo.
      459         assign
      460            mWaitFramStartProc   = now
      461            mWaitFramStopUser    = no
      462            mWaitFramStopTimeOut = no
      463         .
      464         block-wait:
      465         do while not mWaitFramStop:
      466            run WaitFramRunPause (iInterval).
      467            if  waitfram-check-timeout()
      468            then do:
      469               leave block-wait.
      470            end.
      471         end.
      472         run waitfram-hide.
      473      end.
      474   procedure waitfram-join :
      475     define input  parameter p-line-1  as character no-undo .
      476     define input  parameter p-line-2  as character no-undo .
      477     define input  parameter p-line-3  as character no-undo .
      478     define output parameter p-message as character no-undo .
      479     do
      480     on error undo, return error return-value
      481     :
      482       assign
      483         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      484                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      485                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      486       .
      487     end.
      488   end procedure.
      489   function waitfram-join-function returns character
      490     (input p-line-1 as character
      491     ,input p-line-2 as character
      492     ,input p-line-3 as character
      493     ).
      494     define variable v-message as character no-undo .
      495     run waitfram-join in this-procedure
      496       (input  p-line-1
      497       ,input  p-line-2
      498       ,input  p-line-3
      499       ,output v-message
      500       ) .
      501     return v-message .
      502   end function .
      503   function cross-list returns logical (
      504     input parfirst-stream  as character,
      505     input parsecond-stream as character,
      506     input pardelim         as character).
      507     if pardelim = ""
      508     or pardelim = ?
      509     then do:
      510       assign
      511         pardelim = ","
      512       .
      513     end.
      514     define variable vari            as integer no-undo .
      515     define variable varresult-cross as logical no-undo .
      516     assign
      517       varresult-cross = no
      518     .
      519     def var v-num-parfirst-stream as integer no-undo .
      520     assign
      521       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      522     .
      523     do vari = 1 to v-num-parfirst-stream
      524     :
      525       if lookup(entry(vari, parfirst-stream, pardelim)
      526                ,parsecond-stream
      527                ,pardelim
      528                ) > 0 then do:
      529         assign
      530           varresult-cross = yes
      531         .
      532         leave.
      533       end.
      534     end.
      535     return varresult-cross .
      536   end function.
