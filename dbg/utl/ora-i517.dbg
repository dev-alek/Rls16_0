      819   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   function octal-to-char return character
      821   ( p-string as character ) :
      822     def var v-asc     as integer no-undo .
      823     def var v-new-asc as integer no-undo .
      824     def var ind       as integer no-undo .
      825     if length(p-string) <> 3 then do:
      826       return ? .
      827     end.
      828     assign
      829       v-asc = 0
      830     .
      831     do ind = 1 to length(p-string)
      832     :
      833       assign
      834         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      835       .
      836       if v-new-asc < 0 or v-new-asc >= 8 then do:
      837         return ? .
      838       end.
      839       assign
      840         v-asc = v-asc * 8 + v-new-asc
      841       .
      842     end.
      843     return chr(v-asc) .
      844   end function .
      845   function char-to-octal return character
      846   ( p-chr as character ) :
      847     def var v-asc    as integer   no-undo .
      848     def var ind      as integer   no-undo .
      849     def var v-string as character no-undo .
      850     if length(p-chr) <> 1 then do:
      851       return ? .
      852     end.
      853     assign
      854       v-asc    = asc(p-chr)
      855       v-string = ""
      856     .
      857     do ind = 1 to 3
      858     :
      859       assign
      860         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      861       .
      862       assign
      863         v-asc = truncate(v-asc / 8, 0)
      864       .
      865     end.
      866     return v-string .
      867   end.
      868   function str-encode return character
      869   (   p-init-string       as character
      870     , p-encode-char       as character
      871     , p-special-char-list as character
      872   ) :
      873     def var p-encode-string as character no-undo .
      874     def var ind                as integer no-undo .
      875     def var v-num-special-char as integer no-undo .
      876     def var v-special-char     as character no-undo .
      877     if p-encode-char = ?
      878     or p-encode-char = "" then do:
      879       assign
      880         p-encode-char = "~~"
      881       .
      882     end.
      883     if p-init-string = ? then do:
      884       return "?" .
      885     end.
      886     if p-init-string = "?" then do:
      887       return p-encode-char + char-to-octal("?") .
      888     end.
      889     assign
      890       v-num-special-char = length(p-special-char-list)
      891       p-encode-string    = replace(p-init-string
      892                                   ,p-encode-char
      893                                   ,p-encode-char + char-to-octal(p-encode-char)
      894                                   )
      895     .
      896     do ind = 1 to v-num-special-char
      897     :
      898       assign
      899         v-special-char = substring(p-special-char-list, ind, 1)
      900       .
      901       if v-special-char <> p-encode-char then do:
      902         assign
      903           p-encode-string = replace (p-encode-string
      904                                     ,v-special-char
      905                                     ,p-encode-char + char-to-octal(v-special-char)
      906                                     )
      907         .
      908       end.
      909     end.
      910     return p-encode-string .
      911   end.
      912   function str-decode returns character
      913     (p-init-string   as character
      914     ,p-encode-char   as character
      915     ) :
      916     def var p-decode-string as character no-undo .
      917     def var ind                       as integer no-undo .
      918     def var v-num-entries-init-string as integer no-undo .
      919     def var v-sub-phrase              as character no-undo .
      920     def var v-special-char            as character no-undo .
      921     if p-encode-char = ?
      922     or p-encode-char = "" then do:
      923       assign
      924         p-encode-char = "~~"
      925       .
      926     end.
      927     if p-init-string = "?" then do:
      928       return ? .
      929     end.
      930     assign
      931       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      932     .
      933     if v-num-entries-init-string > 1 then do:
      934       assign
      935         p-decode-string = entry(1, p-init-string, p-encode-char)
      936       .
      937       do ind = 2 to v-num-entries-init-string
      938       :
      939         assign
      940           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      941         .
      942         assign
      943           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      944         .
      945         if v-special-char <> ? then do:
      946           assign
      947             p-decode-string = p-decode-string
      948                             + v-special-char
      949                             + substring(v-sub-phrase, 4)
      950           .
      951         end.
      952         else do:
      953           assign
      954             p-decode-string = p-decode-string
      955                             + p-encode-char
      956                             + v-sub-phrase
      957           .
      958         end.
      959       end.
      960     end.
      961     else do:
      962       assign
      963         p-decode-string = p-init-string
      964       .
      965     end.
      966     return p-decode-string .
      967   end.
      968   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      970   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      971     field cst-code                like ub.trn-doc.cst-code
      972     field part-code               like ub.parts.part-code
      973     .
      974   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      975   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      976   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      977   function hvrdtax return logical (input parrecid as recid):
      978   define variable varresult as logical no-undo.
      979   run hvrdtax-proc (input parrecid, output varresult).
      980   return varresult.
      981   end function.
      982   procedure hvrdtax-proc:
      983   define input  parameter parrecid  as recid   no-undo.
      984   define output parameter parresult as logical no-undo.
      985   define buffer bf_goods for ub.goods.
      986   define buffer bf_units for ub.units.
      987   define buffer rt_tax   for ub.tax.
      988   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      989   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      990   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      991   if available rt_tax and
      992       can-find(first ub.tax-units No-LOCK WHERE
      993                      ub.tax-units.tax-code = rt_tax.tax-code AND
      994                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      995                                                       else assign parresult = no.
      996   end procedure.
      997   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   define new global shared variable g#lib-calc as handle no-undo .
      999   procedure plgdsfnd :
     1000     define input  parameter p-chk-and-chs    as logical               no-undo .
     1001     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1002     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1003     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1004     define output parameter p-reserv-pl-code as   logical             no-undo .
     1005     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1006     define buffer buf_goods         for ub.goods .
     1007     define buffer buf_pl-gds        for ub.pl-gds .
     1008     define buffer buf_second_pl-gds for ub.pl-gds .
     1009     find first buf_goods no-lock where
     1010                buf_goods.gds-code = p-gds-code no-error .
     1011     if not available buf_goods
     1012     then do:
     1013       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1014     end.
     1015   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1017     (input  p-obj-type
     1018     ,input  p-obj-code
     1019     ,input  buf_goods.artic
     1020     ,input  buf_goods.prod-type
     1021     ,input  buf_goods.prod-code
     1022     ,input  'place-rsrv=request'
     1023     ,output p-reserv-pl-code
     1024     ) no-error .
     1025     if error-status :error
     1026     then do:
     1027       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1028     end.
     1029     if p-reserv-pl-code = no
     1030     then do:
     1031       return .
     1032     end.
     1033     if p-chk-and-chs <> yes
     1034     then do:
     1035       return .
     1036     end.
     1037     find first buf_pl-gds no-lock where
     1038                buf_pl-gds.obj-type = p-obj-type and
     1039                buf_pl-gds.obj-code = p-obj-code and
     1040                buf_pl-gds.gds-code = p-gds-code no-error .
     1041     if not available buf_pl-gds
     1042     then do:
     1043       return error "К товару не привязано ни одного места хранения" .
     1044     end.
     1045     find first buf_second_pl-gds no-lock where
     1046                buf_second_pl-gds.obj-type  = p-obj-type          and
     1047                buf_second_pl-gds.obj-code  = p-obj-code          and
     1048                buf_second_pl-gds.gds-code  = p-gds-code          and
     1049                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1050     if not available buf_second_pl-gds
     1051     then do:
     1052       assign
     1053         p-pl-code = buf_pl-gds.pl-code
     1054       .
     1055     end.
     1056     else do:
     1057       if not valid-handle( parparentproc )
     1058       then do:
     1059         return error "Не выбрано место хранения " + chr(10) .
     1060       end.
     1061       run str/plgdssel.p
     1062         (
     1063            input parparentproc
     1064         ,  input p-obj-type
     1065         ,  input p-obj-code
     1066         ,  input p-gds-code
     1067         , output p-pl-code
     1068         ) no-error .
     1069       if error-status :error
     1070       then do:
     1071         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1072                                , 'plgdssel.p':U
     1073                                , chr(10)
     1074                                , error-status :get-message( 1 )
     1075                                , return-value
     1076                                ) .
     1077       end.
     1078       if p-pl-code = ? or
     1079          p-pl-code = 0
     1080       then do:
     1081         return error "Не выбрано место хранения " + chr(10) .
     1082       end.
     1083     end.
     1084   end procedure.
     1085   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1086   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1087   define temp-table tt-doc-line no-undo like ub.doc-line
     1088   field cst-code like ub.trn-doc.cst-code
     1089   .
     1090   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1091   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1092   define temp-table tt-parts    no-undo like ub.parts.
     1093   procedure lib-trn_copy-inqu :
     1094   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1095   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1096   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1097   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1098   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1099   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1100   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1101   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1102   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1103   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1104   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1105   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1106   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1107   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1108   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1109   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1110   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1111   define input parameter parinp-discnt-type as   logical                no-undo.
     1112   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1113   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1114   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1115   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1116   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1117   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1118   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1119   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1120   define input parameter table for tt-doc-line.
     1121   define input parameter table for tt-gds-dtl.
     1122   define input parameter table for tt-parts.
     1123   define input parameter paruse-parts       as   logical                no-undo.
     1124   define input parameter parall-qnty        as   logical                no-undo.
     1125   define input parameter parfix-price       as   logical                no-undo.
     1126   define buffer crt_trn-doc  for ub.trn-doc.
     1127   define buffer crt_goods    for ub.goods.
     1128   define buffer crt_doc-line for ub.doc-line.
     1129   define buffer crt_gds-dtl  for ub.gds-dtl.
     1130   define variable end-price    as   logical              no-undo.
     1131   define variable real-type    like ub.goods.gds-type    no-undo.
     1132   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1133   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1134   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1135   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1136   define variable g-log        as   logical              no-undo.
     1137   define variable mem-qnty like chg-qnty no-undo.
     1138   define variable dflt-cd as character no-undo .
     1139   c-l:
     1140   do on error undo, return error return-value :
     1141   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1142   assign
     1143       paruse-parts = false
     1144       .
     1145   assign
     1146     end-price = no.
     1147   if parinp-discnt-type = yes and
     1148      parinp-discnt-pc   = 0   and
     1149      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1150      then do:
     1151     assign
     1152       crt_trn-doc.tot-calc    = partot-calc
     1153       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1154       crt_trn-doc.discnt-type = pardiscnt-type.
     1155   end.
     1156   if parinp-agnt = ? then do:
     1157     assign
     1158       crt_trn-doc.agnt = paragnt.
     1159   end.
     1160   if parinp-boss = ? then do:
     1161     assign
     1162       crt_trn-doc.boss = parboss.
     1163   end.
     1164   if parinp-wrkr = ? then do:
     1165     assign
     1166       crt_trn-doc.wrkr = parwrkr.
     1167   end.
     1168   if parinp-base-rate  = ? then do:
     1169     assign
     1170       crt_trn-doc.base-rate  = parbase-rate.
     1171   end.
     1172   if parinp-base-scale = ? then do:
     1173     assign
     1174       crt_trn-doc.base-scale = parbase-scale.
     1175   end.
     1176   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1177   if available tt-doc-line then do:
     1178     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1179                      and crt_goods.prod-type = tt-doc-line.prod-type
     1180                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1181     if crt_goods.gds-type = 'у':U and
     1182        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1183       return error "В данный документ нельзя копировать услуги.".
     1184     end.
     1185     assign
     1186       real-type = crt_goods.gds-type.
     1187     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1188     if available crt_doc-line then do:
     1189       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1190                        and crt_goods.prod-type = crt_doc-line.prod-type
     1191                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1192       if crt_goods.gds-type <> real-type then do:
     1193         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1194       end.
     1195     end.
     1196     else do:
     1197       assign
     1198         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1199     end.
     1200   end.
     1201   r-l:
     1202   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1203     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1204                      and crt_goods.prod-type = tt-doc-line.prod-type
     1205                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1206   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1207      (
     1208       input crt_trn-doc.doc-code
     1209      ,input crt_trn-doc.obj-type
     1210      ,input crt_trn-doc.obj-code
     1211      ,input crt_goods.artic
     1212      ,input crt_goods.prod-type
     1213      ,input crt_goods.prod-code
     1214      ,input crt_goods.gds-name
     1215      ,input crt_goods.prt-root
     1216      ,input ?
     1217      ,input ?
     1218      ,input parcash-pay      ) no-error.
     1219     if error-status:error then do:
     1220       undo c-l, return error return-value.
     1221     end.
     1222     if return-value = "next" then do:
     1223       next r-l.
     1224     end.
     1225     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1226                                   crt_doc-line.artic     = crt_goods.artic      and
     1227                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1228                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1229     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1230                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1231                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1232                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1233                               break by tt-gds-dtl.artic
     1234                                     by tt-gds-dtl.prod-type
     1235                                     by tt-gds-dtl.prod-code
     1236                               :
     1237   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1238     ( input  tt-gds-dtl.artic
     1239      ,input  tt-gds-dtl.prod-type
     1240      ,input  tt-gds-dtl.prod-code
     1241      ,input  tt-gds-dtl.prt-code
     1242      ,input  tt-doc-line.obj-type
     1243      ,input  tt-doc-line.obj-code
     1244      ,output legal-node
     1245     ) no-error .
     1246       if error-status:error then do:
     1247          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1248       end.
     1249   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1250     ( input crt_trn-doc.obj-code
     1251      ,input crt_trn-doc.obj-type
     1252      ,input crt_trn-doc.doc-code
     1253      ,input crt_goods.artic
     1254      ,input crt_goods.prod-code
     1255      ,input crt_goods.prod-type
     1256      ,input legal-node
     1257      ,input yes
     1258     ) no-error .
     1259        if error-status:error then do:
     1260           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1261        end.
     1262        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1263                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1264                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1265                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1266                                     crt_gds-dtl.prt-code  = legal-node.
     1267       assign
     1268         crt_gds-dtl.ov             = parfix-price
     1269         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1270         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1271         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1272         .
     1273       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1274         assign
     1275           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1276           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1277           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1278           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1279       end.
     1280       if end-price then do:
     1281         assign
     1282           crt_gds-dtl.ov             = yes
     1283           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1284           crt_gds-dtl.discnt-base    = 0
     1285           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1286           crt_gds-dtl.discnt-rubl    = 0
     1287           crt_gds-dtl.discnt-pc      = 0
     1288           crt_gds-dtl.discnt-type    = yes.
     1289       end.
     1290   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1292     ( input recid(crt_gds-dtl)
     1293     , input no
     1294     , input ?
     1295     ) no-error.
     1296           if error-status:error then do:
     1297             undo c-l, return error return-value.
     1298           end.
     1299       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1300          crt_gds-dtl.ov then do:
     1301         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1302       end.
     1303       if paruse-parts then do:
     1304          if first-of (tt-gds-dtl.prod-code) then do:
     1305            for each tt-parts :
     1306              assign
     1307                chg-qnty = tt-parts.fact-qnty
     1308                mem-qnty = chg-qnty.
     1309              assign
     1310              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1311              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1312            end.
     1313            assign
     1314              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1315              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1316            assign
     1317              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1318              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1319            if crt_gds-dtl.doc-qnty = 0 then do:
     1320              delete crt_gds-dtl.
     1321            end.
     1322          end.
     1323       end.
     1324       else do:
     1325         assign
     1326           chg-qnty = tt-gds-dtl.fact-qnty
     1327           mem-qnty = chg-qnty.
     1328         assign
     1329           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1330           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1331           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1332           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1333         assign
     1334         varchg-qnty  = varchg-qnty  + chg-qnty
     1335         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1336         if crt_gds-dtl.doc-qnty = 0 then do:
     1337           delete crt_gds-dtl.
     1338         end.
     1339       end.
     1340     end.
     1341     if crt_doc-line.doc-qnty = 0 then do:
     1342       delete crt_doc-line.
     1343     end.
     1344   end.
     1345   end.
     1346   end procedure.
     1347   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
