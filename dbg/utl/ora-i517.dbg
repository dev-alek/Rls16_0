     1389     define buffer bf-cntxp_shop  for ub.shop.
     1390     define buffer bf-cntxp_sysconf for ub.sysconf.
     1391   define variable  ora-icli_ver-stts-client as logical   no-undo  init true .
     1392   procedure who-cli-ora :
     1393   define input  parameter p-cli-code-ora as integer   no-undo .
     1394   define output parameter p-cli-type as character no-undo .
     1395   define output parameter p-cli-code as integer   no-undo .
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399     if length (string(p-cli-code-ora))  <> 9 then do:
     1400        return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1" , p-cli-code-ora ) .
     1401     end.
     1402     if string(p-cli-code-ora) begins "1" or
     1403        string(p-cli-code-ora) begins "2" or
     1404        string(p-cli-code-ora) begins "4" then do:
     1405         p-cli-type = 'орг':U .
     1406         p-cli-code = p-cli-code-ora  .
     1407     end.
     1408     else do:
     1409       if string(p-cli-code-ora) begins "3" then do:
     1410         p-cli-type = 'чел':U .
     1411         p-cli-code = p-cli-code-ora  .
     1412       end.
     1413       else do:
     1414          return error substitute ("Не верный формат кода КОНТРАГЕНТА: &1 ( первый код )" , p-cli-code-ora ) .
     1415       end.
     1416     end.
     1417     define buffer buf_clients for ub.clients  .
     1418     find first buf_clients no-lock where
     1419                buf_clients.obj-type = p-cli-type and
     1420                buf_clients.obj-code = p-cli-code
     1421                no-error .
     1422         if error-status :error then do:
     1423             return error substitute
     1424             ( "Нет такого контрагента: &1 ( &2 &3 )" ,
     1425                 p-cli-code-ora ,
     1426                 p-cli-type ,
     1427                 p-cli-code ) .
     1428         end.
     1429         if ora-icli_ver-stts-client then do:
     1430             if buf_clients.stts > 0 then do:
     1431                 return error substitute
     1432                 ( "Контрагент: &1 ( &2 &3 ) СТАТУС неактивный !!!" ,
     1433                     p-cli-code-ora ,
     1434                     p-cli-type ,
     1435                     p-cli-code ) .
     1436             end.
     1437         end.
     1438     end.
     1439   end procedure.
     1440   procedure ora-ver-goods :
     1441   define input  parameter p-gds-code as integer   no-undo .
     1442   define buffer buf_goods for ub.goods  .
     1443   define variable my-message as character no-undo .
     1444     do
     1445     on error undo, return error return-value
     1446     :
     1447           find first buf_goods no-lock where
     1448                      buf_goods.gds-code = p-gds-code no-error .
     1449               if error-status :error then do:
     1450                   my-message = substitute("Нет товара с кодом &1" ,  p-gds-code) .
     1451                   undo, return error my-message.
     1452               end.
     1453             if buf_goods.stts > 0 then do:
     1454               assign
     1455                 my-message =  substitute(" Товара &1 УДАЛЕН" , buf_goods.gds-code  ) .
     1456                 undo, return error my-message.
     1457             end.
     1458     end.
     1459   end procedure.
     1460   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   procedure factord :
     1462     define input  parameter p-fact-date            as date    no-undo .
     1463     define input  parameter p-fact-time            as integer no-undo .
     1464     define input  parameter p-fact-num             as integer no-undo .
     1465     define input  parameter p-shift-date           as date    no-undo .
     1466     define input  parameter p-shift-num            as integer no-undo .
     1467     define input  parameter p-shift-on             as logical no-undo .
     1468     define output parameter p-fact-order           as decimal no-undo .
     1469     define output parameter p-shift-end-fact-order as decimal no-undo .
     1470     define output parameter p-day-end-fact-order   as decimal no-undo .
     1471     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1472     if p-fact-date = ?
     1473     then do:
     1474       return error "Не указана фактическая дата" .
     1475     end.
     1476     define variable v-fact-date-num as integer no-undo .
     1477     assign
     1478       v-fact-date-num = integer(p-fact-date)
     1479     .
     1480     if p-fact-num = ?
     1481     or p-fact-num = 0
     1482     then do:
     1483       return error "Не задан p-fact-num " + string(p-fact-num) .
     1484     end.
     1485     if p-fact-num < 0
     1486     then do:
     1487       return error "Отрицательный fact-num " + string(p-fact-num) .
     1488     end.
     1489     if p-fact-num >= 100000000
     1490     then do:
     1491       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1492     end.
     1493     if p-shift-on = true
     1494     then do:
     1495       if p-shift-date = ?
     1496       then do:
     1497         return error "Не задана дата смены" .
     1498       end.
     1499       if p-shift-num = ?
     1500       or p-shift-num = 0
     1501       then do:
     1502         return error "Не задан номер смены" .
     1503       end.
     1504     end.
     1505     else do:
     1506       assign
     1507         p-shift-date = p-fact-date
     1508         p-shift-num  = 24
     1509       .
     1510     end.
     1511     define variable v-shift-offset as integer no-undo .
     1512     if p-shift-date = p-fact-date
     1513     then do:
     1514       assign
     1515         v-shift-offset = 1
     1516       .
     1517     end.
     1518     if p-shift-date < p-fact-date
     1519     then do:
     1520       assign
     1521         v-shift-offset = 0
     1522       .
     1523     end.
     1524     if p-shift-date > p-fact-date
     1525     then do:
     1526       message
     1527         vss-workfile vss-revision vss-description skip
     1528         "Неправильная дата закрытия смены" skip
     1529         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1530         view-as alert-box error .
     1531       undo, return error
     1532         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1533           ,string(p-fact-date, '99/99/9999':U)
     1534           ,string(p-shift-date, '99/99/9999':U)
     1535           )
     1536       .
     1537     end.
     1538     if p-shift-num < 1
     1539     or p-shift-num > 24
     1540     then do:
     1541       message
     1542         vss-workfile vss-revision vss-description skip
     1543         "Неправильный номер смены" skip
     1544         "p-shift-num" p-shift-num skip
     1545         view-as alert-box error .
     1546       undo, return error return-value .
     1547     end.
     1548     assign
     1549       p-fact-order           = v-fact-date-num
     1550                              + v-shift-offset * 0.5
     1551                              + p-shift-num    * 0.02 - 0.01
     1552                              + p-fact-num     * 0.0000000001
     1553       p-shift-end-fact-order = v-fact-date-num
     1554                              + v-shift-offset * 0.5
     1555                              + p-shift-num    * 0.02
     1556       p-day-end-fact-order   = v-fact-date-num
     1557                              + 0.99
     1558     .
     1559     if p-fact-order           <= v-fact-date-num
     1560     or p-shift-end-fact-order <= v-fact-date-num
     1561     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1562     or p-shift-end-fact-order >= p-day-end-fact-order
     1563     then do:
     1564       message
     1565         vss-workfile vss-revision vss-description skip
     1566         "Внутренняя ошибка при генерации фактического номера" skip
     1567         "p-fact-date"            p-fact-date            skip
     1568         "p-fact-time"            p-fact-time            skip
     1569         "p-fact-num"             p-fact-num             skip
     1570         "p-shift-date"           p-shift-date           skip
     1571         "p-shift-num"            p-shift-num            skip
     1572         "p-shift-on"             p-shift-on             skip
     1573         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1574         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1575         "v-fact-date-num"        v-fact-date-num        skip
     1576         view-as alert-box error .
     1577       undo, return error return-value .
     1578     end.
     1579   end procedure.
     1580   procedure day-begin-fact-order :
     1581     define input  parameter p-fact-date            as date    no-undo .
     1582     define output parameter p-day-begin-fact-order as decimal no-undo .
     1583     do
     1584     on error undo, return error return-value
     1585     :
     1586       if p-fact-date = ?
     1587       then do:
     1588         assign
     1589           p-day-begin-fact-order = 0
     1590         .
     1591       end.
     1592       else do:
     1593         assign
     1594           p-day-begin-fact-order = integer(p-fact-date)
     1595         .
     1596       end.
     1597     end.
     1598   end procedure.
     1599   procedure factord-max-fact-order :
     1600     define output parameter p-max-fact-order as decimal   no-undo .
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       run day-begin-fact-order in this-procedure
     1605         (input  date(1, 1, 5000)
     1606         ,output p-max-fact-order
     1607         ) .
     1608     end.
     1609   end procedure.
     1610   procedure factord-cut-archive :
     1611     define input  parameter p-obj-type             as character no-undo .
     1612     define input  parameter p-obj-code             as integer   no-undo .
     1613     define input  parameter p-fact-date            as date      no-undo .
     1614     define output parameter p-shift-on             as logical   no-undo .
     1615     define output parameter p-shift-date           as date      no-undo .
     1616     define output parameter p-shift-num            as integer   no-undo .
     1617     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1618     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1619     define variable v-fact-order as decimal   no-undo .
     1620     define buffer buf_shift-obj for ub.shift-obj .
     1621     do
     1622     on error undo, return error return-value
     1623     :
     1624   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1626     (input  p-obj-type
     1627     ,input  p-obj-code
     1628     ,input  'shift-on=request'
     1629     ,output p-shift-on
     1630     ) no-error .
     1631       if error-status :error
     1632       then do:
     1633         message
     1634           vss-workfile vss-revision vss-description skip
     1635           "Ошибка при определении атрибута объекта" skip
     1636           "Объект" p-obj-type p-obj-code skip
     1637           error-status :get-message(1) skip
     1638           return-value skip
     1639           view-as alert-box error .
     1640         undo, return error return-value .
     1641       end.
     1642       if p-shift-on = false
     1643       then do:
     1644         assign
     1645           p-shift-date               = ?
     1646           p-shift-num                = 0
     1647         .
     1648       end.
     1649       else do:
     1650         find first buf_shift-obj share-lock
     1651           where buf_shift-obj.obj-type   = p-obj-type
     1652             and buf_shift-obj.obj-code   = p-obj-code
     1653             and buf_shift-obj.shift-date > p-fact-date
     1654           use-index pi
     1655           no-error .
     1656         if not available buf_shift-obj
     1657         or buf_shift-obj.status_ <> 'зкр':U
     1658         then do:
     1659           message
     1660             vss-workfile vss-revision vss-description skip
     1661             "Невозможно вычислить последнюю смену" skip
     1662             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1663             "Объект" p-obj-type p-obj-code skip
     1664             "Дата" p-fact-date skip
     1665             view-as alert-box error .
     1666           undo, return error return-value .
     1667         end.
     1668         find last buf_shift-obj share-lock
     1669           where buf_shift-obj.obj-type = p-obj-type
     1670             and buf_shift-obj.obj-code = p-obj-code
     1671             and buf_shift-obj.shift-date <= p-fact-date
     1672           use-index pi
     1673           no-error .
     1674         if available buf_shift-obj
     1675         then do:
     1676           if  buf_shift-obj.status_ = 'зкр':U
     1677           then do:
     1678             assign
     1679               p-shift-date = buf_shift-obj.shift-date
     1680               p-shift-num  = buf_shift-obj.shift-num
     1681             .
     1682           end.
     1683           else do:
     1684             message
     1685               vss-workfile vss-revision vss-description skip
     1686               "Невозможно вычислить последнюю смену" skip
     1687               "Статус смены отличен от статуса" 'зкр':U skip
     1688               "Объект" p-obj-type p-obj-code skip
     1689               "Дата" p-fact-date skip
     1690               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1691               view-as alert-box error .
     1692             undo, return error return-value .
     1693           end.
     1694         end.
     1695         else do:
     1696           assign
     1697             p-shift-date = p-fact-date - 1
     1698             p-shift-num  = 1
     1699           .
     1700         end.
     1701       end.
     1702       run factord in this-procedure
     1703         (input  p-fact-date
     1704         ,input  1
     1705         ,input  1
     1706         ,input  p-shift-date
     1707         ,input  p-shift-num
     1708         ,input  p-shift-on
     1709         ,output v-fact-order
     1710         ,output p-shift-end-fact-order
     1711         ,output p-day-end-fact-order
     1712         ) no-error .
     1713       if error-status :error
     1714       then do:
     1715         message
     1716           vss-workfile vss-revision vss-description skip
     1717           "Ошибка при вызове процедуры factord"
     1718           error-status :get-message(1) skip
     1719           return-value skip
     1720           view-as alert-box error .
     1721         undo, return error return-value .
     1722       end.
     1723     end.
     1724   end procedure.
     1725   procedure factord-lock-shift :
     1726     define input  parameter p-obj-type  as character no-undo .
     1727     define input  parameter p-obj-code  as integer   no-undo .
     1728     define input  parameter p-fact-date as date      no-undo .
     1729     define parameter buffer buf_shift-obj for ub.shift-obj .
     1730     define variable v-shift-on      as logical   no-undo .
     1731     define variable v-extra-message as character no-undo .
     1732     define variable v-error as character no-undo .
     1733     do
     1734     on error undo, return error return-value
     1735     :
     1736   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1738     (input  p-obj-type
     1739     ,input  p-obj-code
     1740     ,input  'shift-on=request'
     1741     ,output v-shift-on
     1742     ) no-error .
     1743       if error-status :error
     1744       then do:
     1745         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1746         undo, return error v-error .
     1747       end.
     1748       if v-shift-on = true
     1749       then do:
     1750         find first buf_shift-obj share-lock
     1751           where buf_shift-obj.obj-type   = p-obj-type
     1752             and buf_shift-obj.obj-code   = p-obj-code
     1753             and buf_shift-obj.shift-date > p-fact-date
     1754           use-index pi
     1755           no-error .
     1756         if not available buf_shift-obj
     1757         or buf_shift-obj.status_ <> 'зкр':U
     1758         then do:
     1759           find last buf_shift-obj
     1760             where buf_shift-obj.obj-type = p-obj-type
     1761               and buf_shift-obj.obj-code = p-obj-code
     1762               and buf_shift-obj.status_  = 'зкр':U
     1763             use-index stts
     1764             no-error .
     1765           if available buf_shift-obj
     1766           then do:
     1767             assign
     1768               v-extra-message =
     1769                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1770                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1771                               )
     1772             .
     1773           end.
     1774           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1775           undo, return error v-error .
     1776         end.
     1777       end.
     1778     end.
     1779   end procedure.
     1780   procedure factord-end-day :
     1781     define input  parameter p-fact-date            as date    no-undo .
     1782     define output parameter p-day-end-fact-order   as decimal no-undo .
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       if p-fact-date = ?
     1787       then do:
     1788         return error "Не указана фактическая дата" .
     1789       end.
     1790       assign
     1791         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1792       .
     1793     end.
     1794   end procedure.
     1795   procedure factord-to-date :
     1796     define input  parameter p-fact-order as decimal no-undo .
     1797     define output parameter p-fact-date  as date    no-undo .
     1798     define variable v-ref-date  as date      no-undo .
     1799     define variable v-ref-delta as integer   no-undo .
     1800     do
     1801     on error undo, return error return-value
     1802     :
     1803       if p-fact-order = ?
     1804       or p-fact-order = 0
     1805       then do:
     1806         return error "Не указан fact-order" .
     1807       end.
     1808       assign
     1809         v-ref-date  = date(1, 1, 2000)
     1810       .
     1811       assign
     1812         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1813       .
     1814       assign
     1815         p-fact-date = v-ref-date + v-ref-delta
     1816       .
     1817     end.
     1818   end procedure.
     1819   procedure factord-to-fact-num :
     1820     define input  parameter p-fact-order as decimal no-undo .
     1821     define output parameter p-fact-num   as integer no-undo .
     1822     define variable v-fact-order-trunc as decimal no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       if p-fact-order = ?
     1827       or p-fact-order = 0
     1828       then do:
     1829         return error "Не указан fact-order" .
     1830       end.
     1831       assign
     1832        v-fact-order-trunc = truncate(p-fact-order, 2)
     1833       .
     1834       assign
     1835         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1836       .
     1837     end.
     1838   end procedure.
     1839   procedure factord-to-shift-num :
     1840     define input  parameter p-fact-order as decimal no-undo .
     1841     define output parameter p-shift-num   as integer no-undo .
     1842     define variable  p-shift-numd  as decimal   no-undo .
     1843     define variable v-fact-order-trunc as decimal no-undo .
     1844     do
     1845     on error undo, return error return-value
     1846     :
     1847       if p-fact-order = ?
     1848       or p-fact-order = 0
     1849       then do:
     1850         return error "Не указан fact-order" .
     1851       end.
     1852       assign
     1853        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1854       .
     1855       if v-fact-order-trunc < 0.5 then do:
     1856         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1857       end.
     1858       assign
     1859         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1860         .
     1861        assign
     1862         p-shift-num = truncate (p-shift-numd , 0)
     1863       .
     1864     end.
     1865   end procedure.
