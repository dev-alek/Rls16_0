     3157   procedure clos-trn :
     3158     do
     3159     on error undo, return error return-value
     3160     :
     3161   define input parameter p-trn-code as character no-undo .
     3162   define buffer buf_s-trn-doc for ub.trn-doc.
     3163   define variable varmode            as   character           no-undo.
     3164   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3165   define variable varflag            like ub.trn-doc.flag     no-undo.
     3166   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3167   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3168   define variable varcheck-return as logical no-undo .
     3169   define variable varchg-inv      as logical no-undo .
     3170   assign
     3171     varmode         = '<закрытие документа>':U
     3172     varstatus       = 'запрос':U
     3173     varflag         = true
     3174     varcopystatus   = 'новый':U
     3175     varcopyflag     = false
     3176     varcheck-return = true
     3177     varchg-inv      = true
     3178     .
     3179   for each tt2-doc-line where is-tsd and doc-code = p-trn-code no-lock:
     3180     run unitqnty1 (
     3181         input tt2-doc-line.unit-cli,
     3182         input "",
     3183         input "",
     3184         input 0,
     3185         input "",
     3186         input tt2-doc-line.doc-qnty)
     3187     no-error.
     3188     if error-status:error then do:
     3189       run pcall-log-file in p-log-handle (input return-value) .
     3190       is-unit-error  = true.
     3191     end.
     3192     run unitqnty1 (
     3193         input tt2-doc-line.unit-cli,
     3194         input "",
     3195         input "",
     3196         input 0,
     3197         input "",
     3198         input tt2-doc-line.fact-qnty)
     3199     no-error.
     3200     if error-status:error then do:
     3201       run pcall-log-file in p-log-handle (input return-value) .
     3202       is-unit-error  = true.
     3203     end.
     3204   end.
     3205   if is-unit-error then do:
     3206     run pcall-log-file in p-log-handle (input "Невозможно перевести накладную в статус накл") .
     3207     return.
     3208   end.
     3209   run str/trn-graf.p
     3210     ( input  p-trn-code ,
     3211       input  v-cntxt-db-num ,
     3212       input  varmode ,
     3213       output varstatus ,
     3214       output varflag ,
     3215       output varcopystatus ,
     3216       output varcopyflag
     3217     ) no-error .
     3218       if error-status:error then do :
     3219           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3220           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3221           undo, return error v-end-message.
     3222       end.
     3223   run str/trn-stat.p (
     3224       input  parparentproc ,
     3225       input  this-procedure ,
     3226       input  varmode,
     3227       input  p-trn-code,
     3228       input  varcheck-return,
     3229       input  v-cntxt-db-num,
     3230       input  v-cntxt-in-ov,
     3231       input  v-cntxt-rsrv-time,
     3232       input  v-cntxt-load-time,
     3233       input  v-cntxt-holidays,
     3234       input  NO,
     3235       output varchg-inv,
     3236       output table gds-list)
     3237       no-error.
     3238       if error-status:error then do :
     3239           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3240           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3241           undo, return error v-end-message.
     3242       end.
     3243     end.
     3244     if is-tsd then do:
     3245       for each ub.doc-line exclusive-lock where new_trn-doc.doc-code = ub.doc-line.doc-code:
     3246         find first buf_goods where ub.doc-line.artic = buf_goods.artic and
     3247           ub.doc-line.prod-type = buf_goods.prod-type  and
     3248           ub.doc-line.prod-code = buf_goods.prod-code
     3249           no-lock no-error .
     3250         find first ub.gds-dtl exclusive-lock where ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     3251           ub.gds-dtl.artic = buf_goods.artic and
     3252           ub.gds-dtl.prod-type = buf_goods.prod-type  and
     3253           ub.gds-dtl.prod-code = buf_goods.prod-code.
     3254         find first temp_doc-line where temp_doc-line.gds-code = buf_goods.gds-code.
     3255         ub.gds-dtl.doc-qnty  = temp_doc-line.doc-qnty.
     3256         ub.gds-dtl.fact-qnty = temp_doc-line.fact-qnty.
     3257         ub.doc-line.fact-qnty = temp_doc-line.fact-qnty.
     3258         ub.doc-line.doc-qnty = temp_doc-line.doc-qnty.
     3259         ub.doc-line.cli-qnty = temp_doc-line.cli-qnty.
     3260       end.
     3261     end.
     3262   end procedure.
     3263   procedure clos-trn2 :
     3264   define input parameter p-trn-code as character no-undo .
     3265     do
     3266     on error undo, return error return-value
     3267     :
     3268   define buffer buf_s-trn-doc for ub.trn-doc.
     3269   define variable varmode            as   character           no-undo.
     3270   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3271   define variable varflag            like ub.trn-doc.flag     no-undo.
     3272   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3273   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3274   define variable varcheck-return as logical no-undo .
     3275   define variable varchg-inv as logical no-undo .
     3276   run str/trn-stat.p (
     3277       input  parparentproc ,
     3278       input  this-procedure ,
     3279       input  '<закрытие документа>':U ,
     3280       input  p-trn-code,
     3281       input  false  ,
     3282       input  v-cntxt-db-num,
     3283       input  false ,
     3284       input  v-cntxt-rsrv-time,
     3285       input  v-cntxt-load-time,
     3286       input  v-cntxt-holidays,
     3287       input  false ,
     3288       output varchg-inv ,
     3289       output table gds-list)
     3290       no-error.
     3291       if error-status:error then do :
     3292           v-end-message = substitute(" Ошибка &1 &2" , error-status :get-message(1)  , return-value) .
     3293           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3294           undo, return error v-end-message.
     3295       end.
     3296     end.
     3297   end procedure.
