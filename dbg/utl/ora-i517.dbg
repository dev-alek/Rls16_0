     3309     :
     3310   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3312     (input  vt-obj-type
     3313     ,input  vt-obj-code
     3314     ,output p-cntxt-db-num-obj
     3315     )  .
     3316     assign
     3317       p-cntxt-db-num          =  v-cntxt-db-num
     3318       p-cntxt-userid          =  v-cntxt-userid
     3319       p-cntxt-level           =  v-cntxt-level
     3320       p-cntxt-host-code-obj   =  vt-host-code
     3321       p-cntxt-obj-type        =  vt-obj-type
     3322       p-cntxt-obj-code        =  vt-obj-code
     3323       p-cntxt-is-admin        =  v-cntxt-is-admin
     3324     .
     3325     end.
     3326    end procedure.
     3327    procedure get-report-num :
     3328     define output parameter p-report-num as integer no-undo .
     3329      do
     3330      on error undo, return error return-value
     3331      :
     3332       assign
     3333         p-report-num = 1
     3334       .
     3335      end.
     3336    end procedure.
     3337   procedure clear-tt :
     3338     do
     3339     on error undo, return error return-value
     3340     :
     3341      for each tt-trn-doc:
     3342       delete tt-trn-doc.
     3343      end.
     3344       for each tt2-doc-line :
     3345           delete tt2-doc-line .
     3346       end.
     3347       for each tt-doc-line :
     3348           delete tt-doc-line .
     3349       end.
     3350       for each tt-gds-dtl :
     3351           delete tt-gds-dtl .
     3352       end.
     3353       for each tt-parts:
     3354           delete tt-parts .
     3355       end.
     3356       for each lib-trn_ret-doc :
     3357         delete lib-trn_ret-doc.
     3358       end.
     3359       for each lib-trn_ret-line :
     3360         delete lib-trn_ret-line      .
     3361       end.
     3362       for each lib-trn_ret-line-attr :
     3363         delete lib-trn_ret-line.
     3364       end.
     3365       for each lib-trn_ret-dtl :
     3366         delete lib-trn_ret-dtl.
     3367       end.
     3368       for each lib-trn_ret-parts :
     3369         delete lib-trn_ret-parts .
     3370       end.
     3371    end.
     3372   end procedure.
     3373   procedure add-nn :
     3374   define input  parameter p-doc-code as character no-undo .
     3375   define input  parameter p-doc-out as character no-undo .
     3376     do
     3377     on error undo, return error return-value
     3378     :
     3379   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
     3380                          input 'nids':U ,
     3381                          input p-doc-out ) no-error .
     3382      end.
     3383   end procedure.
     3384   procedure calc-cost-price :
     3385   define input  parameter p-doc-code as character no-undo .
     3386   define buffer cur-doc-line  for ub.doc-line.
     3387   define buffer cur-goods     for ub.goods.
     3388   define buffer cur-gds-dtl   for ub.gds-dtl.
     3389   define buffer t-doc         for ub.trn-doc  .
     3390   define variable varnew-price like ub.doc-line.price-base no-undo.
     3391     do
     3392     on error undo, return error return-value
     3393     :
     3394     v-end-message = substitute("Просчет учетной цены для расходной накладной &1" , p-doc-code) .
     3395     run pcall-log-file in p-log-handle ( input v-end-message ) .
     3396     find first t-doc no-lock where t-doc.doc-code = p-doc-code .
     3397      for each  cur-doc-line where cur-doc-line.doc-code   = t-doc.doc-code         ,
     3398          first cur-goods    where cur-goods.artic         = cur-doc-line.artic     and
     3399                                   cur-goods.prod-type     = cur-doc-line.prod-type and
     3400                                   cur-goods.prod-code     = cur-doc-line.prod-code no-lock,
     3401          each  cur-gds-dtl  where cur-gds-dtl.doc-code    = cur-doc-line.doc-code  and
     3402                                   cur-gds-dtl.artic       = cur-doc-line.artic     and
     3403                                   cur-gds-dtl.prod-type   = cur-doc-line.prod-type and
     3404                                   cur-gds-dtl.prod-code   = cur-doc-line.prod-code no-lock :
     3405          assign
     3406            line-rec = recid(cur-doc-line)
     3407          .
     3408   assign
     3409     price-rubl-with-tax-loc = cur-doc-line.price-rubl
     3410     price-base-with-tax-loc = cur-doc-line.price-base
     3411   .
     3412   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3414     (output varinvprb
     3415     )  .
     3416      find first in-vatp_doc-attr no-lock
     3417       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     3418         and in-vatp_doc-attr.attr-code = 'envd':U
     3419       no-error .
     3420       if available in-vatp_doc-attr
     3421          then do:
     3422          assign
     3423            in-vatp-have-vat-slt = no.
     3424      end.
     3425      else do:
     3426        assign
     3427          in-vatp-have-vat-slt = yes.
     3428      end.
     3429      find first in-vatp-goods where in-vatp-goods.artic     = cur-doc-line.artic     and
     3430                                        in-vatp-goods.prod-type = cur-doc-line.prod-type and
     3431                                        in-vatp-goods.prod-code = cur-doc-line.prod-code no-lock.
     3432      if (not t-doc.internal and
     3433              t-doc.doc-type = 'при':U) or
     3434         in-vatp-goods.gds-type = 'у':U then do:
     3435         if varinvprb = "base":u then do:
     3436           assign
     3437             road-tax-base-loc = cur-doc-line.road-tax
     3438             road-tax-rubl-loc = cur-doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     3439         end.
     3440         else do:
     3441           ASSIGN
     3442             road-tax-rubl-loc = cur-doc-line.road-tax
     3443             road-tax-base-loc = cur-doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     3444         end.
     3445         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3446         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3447         assign
     3448           road-tax-cli-loc = ?.
     3449         ASSIGN
     3450           transport-base-loc = (if cur-doc-line.transport-base = ? then 0 else cur-doc-line.transport-base)
     3451           transport-rubl-loc = (if cur-doc-line.transport-rubl = ? then 0 else cur-doc-line.transport-rubl)
     3452           transport-cli-loc  = 0
     3453           other-base-loc     = (if cur-doc-line.other-base     = ? then 0 else cur-doc-line.other-base)
     3454           other-rubl-loc     = (if cur-doc-line.other-rubl     = ? then 0 else cur-doc-line.other-rubl)
     3455           other-cli-loc      = 0
     3456           vat-pc-loc         = (if cur-doc-line.vat-pc         = ? then 0 else cur-doc-line.vat-pc)
     3457           slt-pc-loc         = (if cur-doc-line.slt-pc         = ? then 0 else cur-doc-line.slt-pc).
     3458                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3459               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3460         assign
     3461           vat-cli-loc            = ?
     3462           slt-cli-loc            = ?
     3463           price-cli-with-tax-loc = ?.
     3464      end.
     3465      else do:
     3466                                                   for each in-vatp-parts where in-vatp-parts.out-code  = cur-doc-line.doc-code  and
     3467                                         in-vatp-parts.obj-type  = cur-doc-line.obj-type  and
     3468                                         in-vatp-parts.obj-code  = cur-doc-line.obj-code  and
     3469                                         in-vatp-parts.artic     = cur-doc-line.artic     and
     3470                                         in-vatp-parts.prod-type = cur-doc-line.prod-type and
     3471                                         in-vatp-parts.prod-code = cur-doc-line.prod-code
     3472                            use-index out-code no-lock:
     3473             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3474                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3475                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3476                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3477                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3478                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3479                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3480                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3481                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3482                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3483                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3484                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3485                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3486                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3487                         .
     3488         end.
     3489         ASSIGN
     3490           road-tax-base-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3491           road-tax-rubl-loc   = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3492           transport-base-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3493           transport-rubl-loc  = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3494           other-base-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3495           other-rubl-loc      = if cur-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / cur-doc-line.fact-qnty  else 0
     3496                                           vat-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3497           slt-base-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3498                   vat-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / cur-doc-line.fact-qnty   else 0
     3499           slt-rubl-loc        = if cur-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / cur-doc-line.fact-qnty   else 0
     3500           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3501           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3502         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3503         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3504         if transport-base-loc = ? then transport-base-loc = 0.
     3505         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3506         if other-base-loc     = ? then other-base-loc     = 0.
     3507         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3508         assign
     3509           transport-cli-loc      = 0
     3510           other-cli-loc          = 0
     3511           road-tax-cli-loc       = ?
     3512           vat-cli-loc            = ?
     3513           slt-cli-loc            = ?
     3514           price-cli-with-tax-loc = ?.
     3515      end.
     3516   ASSIGN
     3517             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3518       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3519   .
     3520       assign
     3521         varnew-price = (if t-doc.print-rubl then price-rubl-with-tax-loc
     3522                                             else price-base-with-tax-loc ) .
     3523          run str/out-add.p ( this-procedure ,
     3524                         recid (t-doc),
     3525                         recid (cur-doc-line),
     3526                         recid (cur-gds-dtl),
     3527                         recid (cur-goods),
     3528                         "update-sale-price",
     3529                         string(varnew-price)) no-error.
     3530          if error-status :error then do:
     3531           v-end-message = substitute(" Ошибка при вызове программы out-add &1 &2" , error-status :get-message(1)  , return-value) .
     3532           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3533           undo, return error v-end-message.
     3534          end.
     3535      end.
     3536       if not is-tsd then do:
     3537         run gbl/calc-trn.p (  this-procedure , recid(new_trn-doc)) no-error .
     3538         if error-status :error then do:
     3539           v-end-message = substitute(" Ошибка пересчета шапки &1 &2" , error-status :get-message(1)  , return-value) .
     3540           run pcall-log-file in p-log-handle ( input v-end-message ) .
     3541           undo, return error v-end-message.
     3542         end.
     3543       end.
     3544     end.
     3545   end procedure.
     3546   procedure cb_cloce-quest-neg :
     3547   define output parameter p-is-negostmess as logical   no-undo .
     3548     do
     3549     on error undo, return error return-value
     3550     :
     3551      p-is-negostmess = false .
     3552     end.
     3553   end procedure.
     3554   procedure unitqnty1 :
     3555     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     3556     define input parameter  p-artic            like ub.goods.artic     no-undo .
     3557     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     3558     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     3559     define input parameter  p-unit-description as character            no-undo .
     3560     define input parameter  p-qnty             as decimal              no-undo .
     3561     define buffer buf_units for ub.units .
     3562     define buffer buf_goods for ub.goods .
     3563     define variable v-artic as character no-undo .
     3564     define variable v-msg   as character no-undo .
     3565     if p-unit-description = ''
     3566     or p-unit-description = ?
     3567     then do:
     3568       assign
     3569         p-unit-description = "Единица измерения "
     3570       .
     3571     end.
     3572     if  p-unit-name <> ''
     3573     and p-unit-name <> ?
     3574     then do:
     3575       find first buf_units no-lock
     3576         where buf_units.unit-name = p-unit-name
     3577         no-error .
     3578       if not available buf_units
     3579       then do:
     3580         v-msg =
     3581           "Не найдена единица измерения " + chr(10) +
     3582           "p-unit-name" +   p-unit-name + chr(10) +
     3583           "p-artic" +       p-artic +  chr(10) +
     3584           "p-prod-type" +   p-prod-type + chr(10) +
     3585           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3586           "p-qnty" +        string (p-qnty) + chr(10)
     3587            .
     3588         undo, return error v-msg .
     3589       end.
     3590     end.
     3591     else do:
     3592       find first buf_goods no-lock
     3593         where buf_goods.artic     = p-artic
     3594           and buf_goods.prod-type = p-prod-type
     3595           and buf_goods.prod-code = p-prod-code
     3596         no-error .
     3597       if not available buf_goods
     3598       then do:
     3599         v-msg =
     3600           "Не найден товар" + chr(10) +
     3601           "p-unit-name" +   p-unit-name + chr(10) +
     3602           "p-artic" +       p-artic +  chr(10) +
     3603           "p-prod-type" +   p-prod-type + chr(10) +
     3604           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3605           "p-qnty" +        string (p-qnty) + chr(10)
     3606           .
     3607         undo, return error v-msg .
     3608       end.
     3609       find first buf_units no-lock
     3610         where buf_units.unit-name = buf_goods.unit-base
     3611         no-error .
     3612       if not available buf_units
     3613       then do:
     3614         v-msg =
     3615           "Не найдена единица измерения " + chr(10) +
     3616           "p-unit-name" +   p-unit-name + chr(10) +
     3617           "p-artic" +       p-artic +  chr(10) +
     3618           "p-prod-type" +   p-prod-type + chr(10) +
     3619           "p-proc-code" +   string (p-prod-code) + chr(10) +
     3620           "p-qnty" +        string (p-qnty) + chr(10)
     3621           .
     3622         undo, return error v-msg .
     3623       end.
     3624       assign
     3625         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     3626                 + " " + string(p-prod-code)
     3627         p-unit-description = "Базовая единица измерения"
     3628       .
     3629     end.
     3630     if lookup('шту':U, buf_units.type) > 0
     3631     or lookup('сер':U, buf_units.type) > 0
     3632     then do:
     3633       if p-qnty <> truncate(p-qnty, 0)
     3634       then do:
     3635         v-msg =
     3636           "Для штучного и серийного товаров резервируемое количество должно быть целым" + chr(10) +
     3637           v-artic + chr(10) +
     3638           p-unit-description + buf_units.unit-name + chr(10) +
     3639           "Запрошено количество " + string (p-qnty) + chr(10).
     3640         undo, return error v-msg .
     3641       end.
     3642     end.
     3643   end procedure.
     3644   procedure create-line:
     3645       define input parameter p-doc-code as character no-undo.
     3646       define input-output parameter table for tt2-doc-line.
     3647       def var gds-code as int no-undo.
     3648       def var cli-qnty as dec no-undo.
     3649       def var v-root-node as int no-undo.
     3650       def var vat-pc as dec no-undo.
     3651       find first ub.trn-doc no-lock
     3652           where ub.trn-doc.doc-code = p-doc-code
     3653           no-error.
     3654       if error-status:error then
     3655           return error subst("Не найден документ с кодом &1", p-doc-code).
     3656   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3658     (input  ub.goods.gds-code
     3659     ,input  '1':U
     3660     ,input  today
     3661     ,input  ub.trn-doc.host-code
     3662     ,input  ub.trn-doc.obj-type
     3663     ,input  ub.trn-doc.obj-code
     3664     ,output vat-pc
     3665     ) no-error .
     3666   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     3667   (input ub.trn-doc.doc-code
     3668   ,input tt2-doc-line.artic
     3669   ,input tt2-doc-line.prod-type
     3670   ,input tt2-doc-line.prod-code
     3671   ,input ub.trn-doc.obj-type
     3672   ,input ub.trn-doc.obj-code
     3673   ,input ''
     3674   ,input trn-doc.ext-doc-type
     3675   ,input tt2-doc-line.prt-root
     3676   ,input tt2-doc-line.vat-pc
     3677   ,input 0
     3678   ,input 0
     3679   ) no-error
     3680   .
     3681       if error-status:error then
     3682           return error substitute("Ошибка при создании линии накладной &1, &2", ub.trn-doc.doc-code, return-value).
     3683       find first ub.doc-line
     3684           where ub.doc-line.doc-code = ub.trn-doc.doc-code
     3685           and ub.doc-line.artic = tt2-doc-line.artic
     3686           and ub.doc-line.prod-type = tt2-doc-line.prod-type
     3687           and ub.doc-line.prod-code = tt2-doc-line.prod-code
     3688           share-lock.
     3689       buffer-copy tt2-doc-line to ub.doc-line.
     3690   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3692     (input  ub.doc-line.artic
     3693     ,input  ub.doc-line.prod-type
     3694     ,input  ub.doc-line.prod-code
     3695     ,output v-root-node
     3696     )  .
     3697   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     3698     ( input ub.trn-doc.obj-code
     3699      ,input ub.trn-doc.obj-type
     3700      ,input ub.trn-doc.doc-code
     3701      ,input ub.doc-line.artic
     3702      ,input ub.doc-line.prod-code
     3703      ,input ub.doc-line.prod-type
     3704      ,input v-root-node
     3705      ,input true
     3706     )  .
     3707       find first ub.gds-dtl share-lock
     3708           where ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     3709           and ub.gds-dtl.artic = tt2-doc-line.artic
     3710           and ub.gds-dtl.prod-type = tt2-doc-line.prod-type
     3711           and ub.gds-dtl.prod-code = tt2-doc-line.prod-code
     3712           and ub.gds-dtl.prt-code = v-root-node.
     3713       buffer-copy ub.doc-line to ub.gds-dtl.
     3714       for each tt-parts
     3715         where tt-parts.artic = tt2-doc-line.artic
     3716           and tt-parts.prod-type = tt2-doc-line.prod-type
     3717           and tt-parts.prod-code = tt2-doc-line.prod-code:
     3718         create ub.parts.
     3719           buffer-copy tt-parts except tt-parts.supp-type tt-parts.supp-code to ub.parts
     3720             assign ub.parts.pl-code = 0.
     3721       end.
     3722   end.
