        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: fbrsetim.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/fbrsetim.p $":U .
        8   define variable vss-description as character no-undo init "Установка признака блюда для товаров с рецептом производства.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxt-db-num        as integer   no-undo .
       71     define variable v-cntxt-userid        as character no-undo .
       72     define variable v-cntxt-level         as character no-undo .
       73     define variable v-cntxt-host-code-obj as integer   no-undo .
       74     define variable v-cntxt-obj-type      as character no-undo .
       75     define variable v-cntxt-obj-code      as integer   no-undo .
       76     define variable v-cntxt-db-num-obj    as integer   no-undo .
       77     define variable v-cntxt-is-admin      as logical   no-undo .
       78       define variable v-last-gds-code     as integer        no-undo.
       79       define variable v-yesno             as logical        no-undo.
       80       define variable p-obj-type    as character      no-undo.
       81       define variable p-obj-code    as integer        no-undo.
       82       define buffer buf_recipe        for recipe.
       83       define buffer buf_goods         for goods.
       84   do
       85   for buf_recipe
       86     , buf_goods
       87   on error undo, return error
       88   :
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90     run mainmenu_getcntxt in p-mainmenu-handle
       91       (output v-cntxt-db-num
       92       ,output v-cntxt-userid
       93       ,output v-cntxt-level
       94       ,output v-cntxt-host-code-obj
       95       ,output v-cntxt-obj-type
       96       ,output v-cntxt-obj-code
       97       ,output v-cntxt-db-num-obj
       98       ,output v-cntxt-is-admin
       99       ) .
      100       assign
      101           p-obj-type = v-cntxt-obj-type
      102           p-obj-code = v-cntxt-obj-code
      103       .
      104       message
      105           "На объекте будет установлен атрибут 'блюдо'"
      106           skip "для всех товаров, для которых есть"
      107           skip "хотя бы один рецепт типа 'производство'"
      108           skip(1)
      109           skip "Объект:" p-obj-type p-obj-code
      110           skip(1)
      111           skip "Установить атрибут?"
      112       view-as alert-box question
      113       buttons yes-no
      114       title "Установка атрибута 'блюдо' на объекте"
      115       update v-yesno.
      116       if v-yesno = no
      117       then do:
      118           undo, return error.
      119       end.
      120   if session :set-wait-state( "compiler" ) then.
      121       do transaction
      122       on error undo, return error
      123       :
      124           assign
      125               v-last-gds-code = 0
      126           .
      127           for each buf_recipe no-lock
      128              where buf_recipe.obj-type = p-obj-type
      129                and buf_recipe.obj-code = p-obj-code
      130           by buf_recipe.artic
      131           by buf_recipe.prod-type
      132           by buf_recipe.prod-code
      133           on error undo, return error
      134           :
      135               if buf_recipe.recipe-type = 'производство':U
      136               then do:
      137                   find first buf_goods no-lock
      138                        where buf_goods.artic     = buf_recipe.artic
      139                          and buf_goods.prod-type = buf_recipe.prod-type
      140                          and buf_goods.prod-code = buf_recipe.prod-code
      141                   .
      142                   if buf_goods.gds-code <> v-last-gds-code
      143                   then do:
      144                       run set-is-menu in this-procedure (
      145                           input p-obj-type
      146                           , input p-obj-code
      147                           , input buf_goods.gds-code
      148                       ).
      149                       assign
      150                           v-last-gds-code = buf_goods.gds-code
      151                       .
      152                   end.
      153               end.
      154           end.
      155           assign
      156               v-last-gds-code = 0
      157           .
      158           for each buf_recipe no-lock
      159              where buf_recipe.obj-type = ""
      160                and buf_recipe.obj-code = 0
      161           by buf_recipe.artic
      162           by buf_recipe.prod-type
      163           by buf_recipe.prod-code
      164           on error undo, return error
      165           :
      166               if buf_recipe.recipe-type = 'производство':U
      167               then do:
      168                   find first buf_goods no-lock
      169                        where buf_goods.artic     = buf_recipe.artic
      170                          and buf_goods.prod-type = buf_recipe.prod-type
      171                          and buf_goods.prod-code = buf_recipe.prod-code
      172                   .
      173                   if buf_goods.gds-code <> v-last-gds-code
      174                   then do:
      175                       run set-is-menu in this-procedure (
      176                             input p-obj-type
      177                           , input p-obj-code
      178                           , input buf_goods.gds-code
      179                       ).
      180                       assign
      181                           v-last-gds-code = buf_goods.gds-code
      182                       .
      183                   end.
      184               end.
      185           end.
      186       end.
      187       message
      188           "Атрибут 'блюдо' установлен."
      189           skip(1)
      190           skip "Объект:" p-obj-type p-obj-code
      191       view-as alert-box question
      192       title "Установка атрибута 'блюдо' на объекте"
      193       .
      194   if session :set-wait-state( "" ) then.
      195   end.
      196   procedure set-is-menu :
      197   define input parameter p-obj-type as character    no-undo.
      198   define input parameter p-obj-code as integer      no-undo.
      199   define input parameter p-gds-code as integer      no-undo.
      200       define variable v-fbr-gds-obj-recid   as recid        no-undo.
      201       define variable v-fbr-obj-type        as character      no-undo.
      202       define variable v-fbr-obj-code        as integer        no-undo.
      203       define buffer buf_fbr-gds-obj   for fbr-gds-obj.
      204   do
      205   for buf_fbr-gds-obj
      206   on error undo, return error
      207   :
      208       find first buf_fbr-gds-obj exclusive-lock
      209            where buf_fbr-gds-obj.obj-type = p-obj-type
      210              and buf_fbr-gds-obj.obj-code = p-obj-code
      211              and buf_fbr-gds-obj.gds-code = p-gds-code
      212       no-error.
      213       if not available buf_fbr-gds-obj
      214       then do:
      215           run ref/fgdsobj1.p (
      216                 input-output v-fbr-gds-obj-recid
      217               , input 'ДОБАВЛЕНИЕ':U
      218               , input no
      219               , input p-gds-code
      220               , input p-obj-type
      221               , input p-obj-code
      222               , input 0
      223               , input p-obj-type
      224               , input p-obj-code
      225               , input no
      226               , input yes
      227               , input no
      228               , input no
      229               , input no
      230               , input no
      231           ) no-error.
      232           if error-status :error
      233           then do:
      234               message
      235                       vss-workfile vss-revision vss-description
      236               skip "Ошибка при создании записи товара производства на объекте."
      237               skip return-value
      238               skip trim(error-status :get-message(1))
      239                       trim(error-status :get-message(2))
      240                       trim(error-status :get-message(3))
      241               view-as alert-box error.
      242               undo, return error .
      243           end.
      244       end.
      245       else do:
      246           assign
      247               v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
      248           .
      249           run ref/fgdsobj1.p (
      250                 input-output v-fbr-gds-obj-recid
      251               , input 'ИЗМЕНЕНИЕ':U
      252               , input no
      253               , input buf_fbr-gds-obj.gds-code
      254               , input buf_fbr-gds-obj.obj-type
      255               , input buf_fbr-gds-obj.obj-code
      256               , input buf_fbr-gds-obj.fbr-grp-code
      257               , input buf_fbr-gds-obj.obj-type
      258               , input buf_fbr-gds-obj.obj-code
      259               , input buf_fbr-gds-obj.is-cd
      260               , input yes
      261               , input buf_fbr-gds-obj.is-modificator
      262               , input buf_fbr-gds-obj.is-null-price
      263               , input buf_fbr-gds-obj.is-season
      264               , input buf_fbr-gds-obj.is-semi-finished
      265           ) no-error.
      266           if error-status :error
      267           then do:
      268               message
      269                       vss-workfile vss-revision vss-description
      270               skip "Ошибка при изменении записи товара производства на объекте."
      271               skip return-value
      272               skip trim(error-status :get-message(1))
      273                       trim(error-status :get-message(2))
      274                       trim(error-status :get-message(3))
      275               view-as alert-box error.
      276               undo, return error .
      277           end.
      278       end.
      279   end.
      280   end procedure.
