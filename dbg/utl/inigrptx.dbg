        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита простановки налогов по группам товаров".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     if     not mWaitFramView
      191        and mWaitProcEvent
      192     then
      193       process events .
      194     end.
      195   end procedure.
      196   procedure waitfram-show :
      197     define input  parameter p-message as character no-undo .
      198     define variable v-left-margin as integer   no-undo .
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       if length(p-message) <= 70 then do:
      204         assign
      205           v-left-margin = integer((70 - length(p-message)) / 2)
      206         .
      207         assign
      208           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      209         .
      210         assign
      211           v-waitfram-action01 = " "
      212           v-waitfram-action02 = " "
      213                                    + fill(" ", v-left-margin)
      214                                    + p-message
      215           v-waitfram-action03 = " "
      216         .
      217       end.
      218       else do:
      219         define variable vRindex1 as integer no-undo.
      220         define variable vRindex2 as integer no-undo.
      221         vRindex1 = r-index(p-message," ",70).
      222         if vRindex1 = 0
      223         then
      224            vRindex1 = 70.
      225         if length(p-message)  <= vRindex1 + 70 then do:
      226           assign
      227             v-waitfram-action01 = " "
      228             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      230           .
      231         end.
      232         else do:
      233           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      234           if vRindex2 <= vRindex1
      235           then
      236              vRindex2 = vRindex1 + 70.
      237           assign
      238             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      241           .
      242         end.
      243       end.
      244       B-viewProcInfo:visible   in frame waitfram = no.
      245       B-viewProcInfo:sensitive in frame waitfram = no.
      246       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       if  (   mWaitFramView
      249          or  mWaitProcEvent)
      250          and not mBatchMode
      251       then
      252          display
      253             v-waitfram-action01 skip
      254             v-waitfram-action02 skip
      255             v-waitfram-action03 skip
      256          with frame waitfram .
      257       if     mWaitFramView
      258          then do:
      259             if     mWaitFramInterval ne ?
      260                and not mBatchMode
      261             then
      262                wait-for go of frame waitfram pause mWaitFramInterval.
      263          end.
      264          else
      265             if     mWaitProcEvent
      266                and not mBatchMode
      267             then
      268                process events .
      269     end.
      270   end procedure.
      271      procedure waitfram-show-this:
      272         define input  parameter iInterval as int64 no-undo.
      273         define variable vtime as int64 no-undo.
      274         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      275         mWaitFramInterval = iInterval.
      276         run waitfram-show (substitute("&1&2 &3&4" ,
      277                                       mWaitFramTextBeg ,
      278                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      279                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      280                                       mWaitFramTextEnd
      281                                      )
      282                           ).
      283      end.
      284      procedure WaitFramRunPause:
      285         define input  parameter iInterval as dec no-undo.
      286         define variable vStart  as datetime-tz no-undo.
      287         define variable vend    as datetime-tz no-undo.
      288         define variable vint as int64 no-undo.
      289         define variable vOk as logical no-undo.
      290         vStart = now.
      291         vend   = vStart.
      292         publish "WaitFramPause" (iInterval,output vOk).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and (   vint > 0
      298                 or (    not vOk
      299                     and iInterval eq ?
      300                     )
      301                 )
      302         then
      303            run waitfram-show-this (iInterval).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and vint > 0
      309         then do:
      310            run gbl/pause.p (vint * 1000).
      311         end.
      312         if iInterval ne ?
      313         then
      314            publish "WaitFramStop".
      315         waitfram-check-timeout().
      316      end.
      317      procedure WaitFramWaitFor:
      318         define input  parameter iInterval as dec no-undo.
      319         assign
      320            mWaitFramStartProc   = now
      321            mWaitFramStopUser    = no
      322            mWaitFramStopTimeOut = no
      323         .
      324         block-wait:
      325         do while not mWaitFramStop:
      326            run WaitFramRunPause (iInterval).
      327            if  waitfram-check-timeout()
      328            then do:
      329               leave block-wait.
      330            end.
      331         end.
      332         run waitfram-hide.
      333      end.
      334   procedure waitfram-join :
      335     define input  parameter p-line-1  as character no-undo .
      336     define input  parameter p-line-2  as character no-undo .
      337     define input  parameter p-line-3  as character no-undo .
      338     define output parameter p-message as character no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      346       .
      347     end.
      348   end procedure.
      349   function waitfram-join-function returns character
      350     (input p-line-1 as character
      351     ,input p-line-2 as character
      352     ,input p-line-3 as character
      353     ).
      354     define variable v-message as character no-undo .
      355     run waitfram-join in this-procedure
      356       (input  p-line-1
      357       ,input  p-line-2
      358       ,input  p-line-3
      359       ,output v-message
      360       ) .
      361     return v-message .
      362   end function .
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364     define variable v-cntxt-db-num        as integer   no-undo .
      365     define variable v-cntxt-userid        as character no-undo .
      366     define variable v-cntxt-level         as character no-undo .
      367     define variable v-cntxt-host-code-obj as integer   no-undo .
      368     define variable v-cntxt-obj-type      as character no-undo .
      369     define variable v-cntxt-obj-code      as integer   no-undo .
      370     define variable v-cntxt-db-num-obj    as integer   no-undo .
      371     define variable v-cntxt-is-admin      as logical   no-undo .
      372   define variable v-RID-LIST as character no-undo .
      373     define new shared temp-table  tt-tax no-undo
      374   field tax-code    like ub.tax.tax-code
      375   FIELD individual  like ub.tax.individual
      376   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      377   field rate-code   like ub.tax-rate.rate-code
      378   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      379   FIELD tax-type    like ub.tax.tax-type
      380   field rate-value  like ub.tax-rate-value.rate-value
      381   FIELD tax-rate-gds-rc  as recid
      382   FIELD to-cashdesk like ub.tax.to-cashdesk
      383   index tax-code is unique primary tax-code.
      384   DEFINE BUTTON B-add-tt-tax
      385        LABEL "Налог+"
      386        SIZE 10 BY 1.
      387   DEFINE BUTTON B-del-tt-tax
      388        LABEL "Налог-"
      389        SIZE 10 BY 1.
      390   DEFINE BUTTON B-exit AUTO-GO
      391        LABEL "&Ввод"
      392        SIZE 10 BY 1
      393        BGCOLOR 8 .
      394   DEFINE BUTTON B-groups
      395        IMAGE-UP FILE "btn-down-arrow":U
      396        IMAGE-DOWN FILE "btn-down-arrow":U
      397        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      398        LABEL "Btn 1"
      399        SIZE 3 BY 1.
      400   DEFINE BUTTON B-groups-tree
      401        IMAGE-UP FILE "btn-down-arrow":U
      402        IMAGE-DOWN FILE "btn-down-arrow":U
      403        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      404        LABEL "Btn 1"
      405        SIZE 3 BY 1.
      406   DEFINE BUTTON B-Help
      407        LABEL "Помо&щь"
      408        SIZE 10 BY 1
      409        BGCOLOR 8 .
      410   DEFINE BUTTON b-quit AUTO-END-KEY
      411        LABEL "&Отмена"
      412        SIZE 10 BY 1
      413        BGCOLOR 8 .
      414   DEFINE VARIABLE label-fill-method AS CHARACTER FORMAT "X(256)":U INITIAL "Как заполнять"
      415         VIEW-AS TEXT
      416        SIZE 26.5 BY .67
      417        FGCOLOR 4  NO-UNDO.
      418   DEFINE VARIABLE label-fill-subject AS CHARACTER FORMAT "X(256)":U INITIAL "Какие группы заполнять"
      419         VIEW-AS TEXT
      420        SIZE 26.5 BY .67
      421        FGCOLOR 4  NO-UNDO.
      422   DEFINE VARIABLE label-fill-values AS CHARACTER FORMAT "X(256)":U INITIAL "Чем заполнять"
      423         VIEW-AS TEXT
      424        SIZE 26.5 BY .67
      425        FGCOLOR 4  NO-UNDO.
      426   DEFINE VARIABLE RS-groups AS CHARACTER
      427        VIEW-AS RADIO-SET VERTICAL
      428        RADIO-BUTTONS
      429             "Все группы", "all",
      430   "Выборочно", "select",
      431   "Выборочно с нижележащими группами", "select-tree"
      432        SIZE 38.75 BY 2.58 NO-UNDO.
      433   DEFINE VARIABLE RS-method AS CHARACTER
      434        VIEW-AS RADIO-SET VERTICAL
      435        RADIO-BUTTONS
      436             "Незаполненные и неправильно заполненные поля", "error-or-space",
      437   "Все поля", "all"
      438        SIZE 48.13 BY 3.67 NO-UNDO.
      439   DEFINE VARIABLE RS-values AS CHARACTER
      440        VIEW-AS RADIO-SET VERTICAL
      441        RADIO-BUTTONS
      442             "Выбранные значения", "default",
      443   "Из группы верх. ур-ня(группа ур. 1 не мен.)", "group"
      444        SIZE 47.75 BY 2.5 NO-UNDO.
      445   DEFINE QUERY BR-tt-tax FOR
      446         tt-tax SCROLLING.
      447   DEFINE BROWSE BR-tt-tax
      448     QUERY BR-tt-tax DISPLAY
      449         tt-tax.tax-code
      450         tt-tax.tax-name
      451         tt-tax.tax-type
      452         tt-tax.rate-code
      453         tt-tax.rate-name
      454         tt-tax.rate-value
      455       WITH NO-ROW-MARKERS SEPARATORS SIZE 58.63 BY 6.29
      456            TITLE "Ставки налогов".
      457   DEFINE FRAME Dialog-Frame
      458        b-quit AT ROW 1 COL 1
      459        B-exit AT ROW 1 COL 11
      460        B-Help AT ROW 1 COL 54.88
      461        B-add-tt-tax AT ROW 2.29 COL 2.15
      462        B-del-tt-tax AT ROW 2.29 COL 12.15
      463        BR-tt-tax AT ROW 3.33 COL 2.13
      464        RS-method AT ROW 11.54 COL 2.5 NO-LABEL
      465        RS-values AT ROW 11.58 COL 51.25 NO-LABEL
      466        RS-groups AT ROW 15.96 COL 2.5 NO-LABEL
      467        B-groups AT ROW 16.92 COL 41.5
      468        B-groups-tree AT ROW 17.79 COL 41.5
      469        label-fill-method AT ROW 10.71 COL 2.25 NO-LABEL
      470        label-fill-values AT ROW 10.83 COL 51 NO-LABEL
      471        label-fill-subject AT ROW 15.21 COL 2.38 NO-LABEL
      472        SPACE(70.36) SKIP(3.28)
      473       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      474            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      475            TITLE "Простановка налогов по группам товаров"
      476            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      477   ASSIGN
      478          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      479          FRAME Dialog-Frame:HIDDEN           = TRUE.
      480   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      481   DO:
      482     APPLY "END-ERROR":U TO SELF.
      483   END.
      484   ON CHOOSE OF B-add-tt-tax IN FRAME Dialog-Frame
      485   DO:
      486   DEFINE var tax-rate-rid As char NO-UNDO init "".
      487   DEFINE var taxvalue like ub.tax-rate-value.rate-value NO-UNDO.
      488   DEFINE buffer bf-tt-tax for tt-tax.
      489     run ref/tax-tree.w ( parparentproc,
      490                     "b-seltax-rate":U,
      491                     "ALL-TAX-RATES":U,
      492                     v-cntxt-host-code-obj,
      493                     v-cntxt-obj-type,
      494                     v-cntxt-obj-code,
      495                     ?,
      496                     input-output tax-rate-rid) no-error .
      497     IF ERROR-STATUS:error then return no-apply.
      498     if tax-rate-rid <> "" then do:
      499       FIND FIRST ub.tax-rate NO-LOCK WHERE recid(ub.tax-rate) = integer(tax-rate-rid) NO-ERROR.
      500       if NOT AVAIL ub.tax-rate then return no-apply.
      501       FIND first bf-tt-tax No-LOCK WHERE
      502                                      bf-tt-tax.tax-code = tax-rate.tax-code NO-ERROR.
      503       IF avail bf-tt-tax then do:
      504           message "В списке ставок налогов уже есть ставка по такому налогу!" view-as
      505           alert-box ERROR.
      506           return no-apply.
      507       end.
      508       FIND FIRST ub.tax NO-LOCK WHERE ub.tax.tax-code = ub.tax-rate.tax-code NO-ERROR.
      509       if NOT AVAIL ub.tax then return no-apply.
      510       if ub.tax.individual then do:
      511           message "Нельзя редактировать налоги на товар, если налог индивидуальный!"
      512           view-as alert-box ERROR.
      513           return no-apply.
      514       end.
      515   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      517     (input  ?
      518     ,input  ub.tax-rate.tax-code
      519     ,input  ub.tax-rate.rate-code
      520     ,input  ?
      521     ,input  v-cntxt-host-code-obj
      522     ,input  v-cntxt-obj-type
      523     ,input  v-cntxt-obj-code
      524     ,output taxvalue
      525     ) no-error .
      526       if error-status:error or taxvalue = ? then return no-apply.
      527       create
      528       tt-tax.
      529       assign
      530       tt-tax.tax-code = ub.tax.tax-code
      531       tt-tax.tax-name = ub.tax.tax-name
      532       tt-tax.rate-code = ub.tax-rate.rate-code
      533       tt-tax.rate-name = ub.tax-rate.rate-name
      534       tt-tax.tax-type = ub.tax.tax-type
      535       tt-tax.rate-value = taxvalue
      536       tt-tax.tax-rate-gds-rc = recid(tax-rate)
      537       .
      538       OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
      539     end.
      540   END.
      541   ON CHOOSE OF B-del-tt-tax IN FRAME Dialog-Frame
      542   DO:
      543       DEFINE BUFFER bf-tt-tax for tt-tax.
      544       IF AVAIL tt-tax then do:
      545           FIND FIRST bf-tt-tax WHERE bf-tt-tax.tax-rate-gds-rc = tt-tax.tax-rate-gds-rc NO-ERROR.
      546           if avail bf-tt-tax then delete bf-tt-tax.
      547           OPEN QUERY BR-tt-tax for each tt-tax NO-LOCK.
      548       end.
      549   END.
      550   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      551   DO:
      552     assign
      553     RS-groups RS-method RS-values.
      554     run proc-save in this-procedure no-error.
      555     if error-status:error then return no-apply.
      556   END.
      557   ON CHOOSE OF B-groups IN FRAME Dialog-Frame
      558   DO:
      559     run ref/gds-grp.w ( input parparentproc
      560                  , input "b-sel,b-mark"
      561                  , input v-cntxt-obj-type
      562                  , input v-cntxt-obj-code
      563                  , input-output v-rid-list ).
      564   END.
      565   ON CHOOSE OF B-groups-tree IN FRAME Dialog-Frame
      566   DO:
      567     run ref/gds-grp.w (
      568                   input parparentproc
      569                   ,input "b-sel,b-mark"
      570                  , input v-cntxt-obj-type
      571                  , input v-cntxt-obj-code
      572                  , input-output v-rid-list ).
      573   END.
      574   ON VALUE-CHANGED OF RS-groups IN FRAME Dialog-Frame
      575   DO:
      576     assign
      577     RS-groups.
      578     CASE rs-groups:
      579       when "all" then do:
      580           disable
      581            b-groups
      582            b-groups-tree
      583            with frame Dialog-Frame.
      584       end.
      585       when "select" then do:
      586            disable
      587            b-groups-tree
      588            with frame Dialog-Frame.
      589           enable
      590            b-groups
      591            with frame Dialog-Frame.
      592       end.
      593      when "select-tree" then do:
      594            disable
      595            b-groups
      596            with frame Dialog-Frame.
      597           enable
      598            b-groups-tree
      599            with frame Dialog-Frame.
      600       end.
      601     END CASE.
      602   END.
      603   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      604   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      605   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   on help of frame Dialog-Frame
      607   do:
      608     run gbl/app_help.p
      609       (input this-procedure :file-name
      610       ,input ''
      611       ,input ?
      612       ) no-error.
      613     if error-status :error then do:
      614       message
      615         "Ошибка при вызове помощи"
      616         error-status :get-message(1)
      617         view-as alert-box .
      618     end.
      619   end.
      620   run minbtn-set in this-procedure .
      621   on choose of b-help in frame Dialog-Frame
      622   do:
      623     apply "help":u to frame Dialog-Frame .
      624   end.
      625   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   procedure minbtn-set :
      627       do
      628           on error undo, return error return-value
      629           :
      630           define variable ii              as integer       no-undo .
      631           define variable fh              as widget-handle no-undo .
      632           define variable hh              as widget-handle no-undo .
      633           define variable v-h             as handle        extent 4 no-undo .
      634           define variable v-name-button   as character     no-undo .
      635           define variable v-help-old-x    as decimal       no-undo .
      636           define variable v-help-old-y    as decimal       no-undo .
      637           define variable v-help-old-size as decimal       no-undo .
      638           define variable v-frame-width   as decimal       no-undo .
      639           define variable jj              as integer       no-undo .
      640           do
      641               on error undo, return error
      642               :
      643               assign
      644                   v-frame-width = frame Dialog-Frame:width - 0.3
      645                   fh            = frame Dialog-Frame:first-child
      646                   hh            = fh:first-child
      647                   ii            = 1
      648                   .
      649               do while valid-handle(hh):
      650                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      651                   do:
      652                       case lc(hh:name) :
      653                           when "b-help" then
      654                               do:
      655                                   hh:load-image-up("cmp/b-help.bmp":u) .
      656                                   hh:load-image-down("cmp/b-help.bmp":u) .
      657                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      658                                   hh:TOOLTIP = "Помощь" .
      659                                   v-help-old-x = hh:column .
      660                                   v-help-old-y = hh:row    .
      661                                   v-help-old-size = hh:width .
      662                                   hh:width-chars = 2.5 .
      663                               end.
      664                           when "b-print" then
      665                               do:
      666                                   hh:load-image("cmp/b-print.bmp":u) .
      667                                   hh:TOOLTIP = "Печать" .
      668                                   v-h[ii] = hh:handle .
      669                                   ii = ii + 1 .
      670                                   hh:width-chars = 3 .
      671                               end.
      672                           when "b-history" or
      673                           when "b-hist" then
      674                               do:
      675                                   hh:load-image("cmp/b-hist.bmp":u) .
      676                                   hh:TOOLTIP = "История" .
      677                                   v-h[ii] = hh:handle .
      678                                   ii = ii + 1 .
      679                                   hh:width-chars = 3 .
      680                               end.
      681                           when "b-sch" then
      682                               do:
      683                                   hh:load-image("cmp/b-sch.bmp":u) .
      684                                   hh:TOOLTIP = "Установка Фильтра" .
      685                                   v-h[ii] = hh:handle .
      686                                   ii = ii + 1 .
      687                                   hh:width-chars = 3 .
      688                               end.
      689                           when "b-hist-user" then
      690                               do:
      691                                   hh:load-image("cmp/b-hist.bmp":u) .
      692                                   hh:TOOLTIP = "История пользователя" .
      693                                   ii = ii + 1 .
      694                               end.
      695                       end case.
      696                   end.
      697                   hh = hh:next-sibling.
      698               end.
      699               b-help:column = v-frame-width - b-help:width-chars.
      700               jj = 0.
      701               repeat ii = 4 to 1 by -1 :
      702                   if valid-handle (v-h[ii] ) then
      703                   do:
      704                       jj  = jj + 1 .
      705                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      706                       v-h[ii]:row    = v-help-old-y .
      707                   end.
      708               end.
      709           end.
      710       end.
      711   end procedure.
      712   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      713   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      714   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      715   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      716   define variable v-diasize-current-frame-width  as decimal   no-undo .
      717   define variable v-diasize-current-frame-height as decimal   no-undo .
      718   define variable v-diasize-change-size          as logical   no-undo .
      719   define variable v-diasize-resize-button        as handle    no-undo .
      720   define variable v-diasize-wndmax               as logical   no-undo .
      721   define variable v-diasize-wndstore             as logical   no-undo .
      722   define variable v-diasize-proc-name            as character no-undo .
      723   define variable v-diasize-browse-handle        as handle    no-undo .
      724   define variable v-diasize-browse-number        as integer   no-undo .
      725   define variable v-diasize-need-full-display    as logical   no-undo init false .
      726   define temp-table temp-diasize-handle no-undo
      727     field handle-value  as handle
      728     field save-position as decimal
      729     index xpk is primary unique handle-value
      730     .
      731   define temp-table temp-browse-handle no-undo
      732     field browse-type   as character
      733     field browse-number as integer
      734     field browse-handle as handle
      735     field original-size as decimal
      736     index xpk is primary unique browse-type browse-number
      737     index xie browse-type browse-handle
      738   .
      739   procedure diasize_change-height :
      740     define input  parameter p-change-value  as decimal   no-undo .
      741     define input  parameter p-move-resize   as logical   no-undo .
      742     define variable v-field-group-handle    as handle    no-undo .
      743     define variable v-object-handle         as handle    no-undo .
      744     define variable v-frame-height          as decimal   no-undo .
      745     define variable v-frame-virtual-height  as decimal   no-undo .
      746     define variable v-browse-height         as decimal   no-undo .
      747     define variable v-window-height         as decimal   no-undo .
      748     define variable v-window-virtual-height as decimal   no-undo .
      749     define variable v-change-sign           as integer   no-undo .
      750     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      751     define buffer buf_temp-browse-handle  for temp-browse-handle .
      752     if p-change-value > 0
      753     then do:
      754       if frame Dialog-Frame :height + p-change-value
      755           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      756       then do:
      757         assign
      758           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      759                           - (frame Dialog-Frame :height-chars)
      760         .
      761         if p-change-value <= 0
      762         then do:
      763           run diasize_position-resize-button in this-procedure .
      764           return .
      765         end.
      766       end.
      767     end.
      768     if p-change-value < 0
      769     then do:
      770       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      771       then do:
      772         assign
      773           p-change-value = v-diasize-orig-frame-height
      774                          - (frame Dialog-Frame :height-chars)
      775         .
      776         if p-change-value >= 0
      777         then do:
      778           run diasize_position-resize-button in this-procedure .
      779           return .
      780         end.
      781       end.
      782     end.
      783     if p-change-value >= 0
      784     then do:
      785       assign
      786         v-change-sign = 1
      787       .
      788     end.
      789     else do:
      790       assign
      791         v-change-sign = -1
      792       .
      793     end.
      794     assign
      795       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      796     .
      797     if p-change-value = 0
      798     then do:
      799       run diasize_position-resize-button in this-procedure .
      800       return .
      801     end.
      802     move_block:
      803     do
      804     on error undo move_block, retry move_block
      805     :
      806       if retry
      807       then do:
      808         do
      809         on error undo move_block, leave move_block
      810         :
      811           if p-change-value > 0
      812           then do:
      813             for each buf_temp-diasize-handle
      814             on error undo, next
      815             :
      816               assign
      817                 v-object-handle = buf_temp-diasize-handle.handle-value
      818               .
      819               if v-object-handle <> v-diasize-resize-button
      820               then do:
      821                 assign
      822                   v-object-handle :row = buf_temp-diasize-handle.save-position
      823                 .
      824               end.
      825             end.
      826             assign
      827               v-diasize-browse-handle :height = v-browse-height
      828             .
      829             for each buf_temp-browse-handle
      830               where buf_temp-browse-handle.browse-type = 'height':u
      831             on error undo, next
      832             :
      833               assign
      834                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      835               .
      836             end.
      837             assign
      838               frame Dialog-Frame :height = v-frame-height
      839             .
      840             if frame Dialog-Frame :scrollable = true
      841             then do:
      842               assign
      843                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      844               .
      845             end.
      846             run diasize_position-resize-button in this-procedure .
      847           end.
      848           else do:
      849             if frame Dialog-Frame :scrollable = true
      850             then do:
      851               assign
      852                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      853               .
      854             end.
      855             assign
      856               frame Dialog-Frame :height = v-frame-height
      857             .
      858             assign
      859               v-diasize-browse-handle :height = v-browse-height
      860             .
      861             for each buf_temp-browse-handle
      862               where buf_temp-browse-handle.browse-type = 'height':u
      863             on error undo, next
      864             :
      865               assign
      866                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      867               .
      868             end.
      869             for each buf_temp-diasize-handle
      870             on error undo, next
      871             :
      872               assign
      873                 v-object-handle = buf_temp-diasize-handle.handle-value
      874               .
      875               if v-object-handle <> v-diasize-resize-button
      876               then do:
      877                 assign
      878                   v-object-handle :row = buf_temp-diasize-handle.save-position
      879                 .
      880               end.
      881             end.
      882             run diasize_position-resize-button in this-procedure .
      883           end.
      884           assign
      885             v-diasize-change-size = false
      886           .
      887           leave move_block .
      888         end.
      889       end.
      890       assign
      891         v-diasize-need-full-display = true
      892       .
      893       if v-diasize-change-size = false
      894       then do:
      895         assign
      896           v-diasize-change-size = true
      897         .
      898       end.
      899       else do:
      900         return .
      901       end.
      902       assign
      903         v-frame-height = frame Dialog-Frame :height
      904         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      905         v-browse-height = v-diasize-browse-handle :height
      906       .
      907       for each buf_temp-browse-handle
      908         where buf_temp-browse-handle.browse-type = 'height':u
      909       :
      910         assign
      911           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      912         .
      913       end.
      914       for each buf_temp-diasize-handle
      915       :
      916         delete buf_temp-diasize-handle .
      917       end.
      918       assign
      919         v-field-group-handle = frame Dialog-Frame :first-child
      920       .
      921       do while valid-handle(v-field-group-handle)
      922       :
      923         assign
      924           v-object-handle = v-field-group-handle :first-child
      925         .
      926         do while valid-handle(v-object-handle)
      927         :
      928           if  v-object-handle <> v-diasize-browse-handle :handle
      929           and can-query(v-object-handle, "row")
      930           and can-query(v-object-handle, "height")
      931           and ( v-object-handle :row > v-diasize-browse-handle :row )
      932           then do:
      933             find first buf_temp-browse-handle
      934               where buf_temp-browse-handle.browse-type   = 'height':u
      935                 and buf_temp-browse-handle.browse-handle = v-object-handle
      936               no-error .
      937             if available buf_temp-browse-handle
      938             then do:
      939             end.
      940             else do:
      941               create buf_temp-diasize-handle .
      942               assign
      943                 buf_temp-diasize-handle.handle-value  = v-object-handle
      944                 buf_temp-diasize-handle.save-position = v-object-handle :row
      945               .
      946             end.
      947           end.
      948           assign
      949             v-object-handle = v-object-handle :next-sibling
      950           .
      951         end.
      952         assign
      953           v-field-group-handle = v-field-group-handle :next-sibling
      954         .
      955       end.
      956       do with frame Dialog-Frame
      957       :
      958         hide v-diasize-resize-button .
      959         assign
      960           v-diasize-resize-button :row    = 1
      961           v-diasize-resize-button :column = 1
      962         .
      963       end.
      964       if p-change-value > 0
      965       then do:
      966         if frame Dialog-Frame :scrollable = true
      967         then do:
      968           assign
      969             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      970             no-error .
      971           if error-status :error
      972           or error-status :get-message(1) <> ""
      973           then do:
      974             undo move_block, retry move_block .
      975           end.
      976         end.
      977         assign
      978           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      979           no-error .
      980         if error-status :error
      981         or error-status :get-message(1) <> ""
      982         then do:
      983           undo move_block, retry move_block .
      984         end.
      985         assign
      986           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      987           no-error .
      988         if error-status :error
      989         or error-status :get-message(1) <> ""
      990         then do:
      991           undo move_block, retry move_block .
      992         end.
      993         for each buf_temp-browse-handle
      994           where buf_temp-browse-handle.browse-type = 'height':u
      995         on error undo move_block, retry move_block
      996         :
      997           assign
      998             buf_temp-browse-handle.browse-handle :height
      999               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1000             no-error .
     1001           if error-status :error
     1002           or error-status :get-message(1) <> ""
     1003           then do:
     1004             undo move_block, retry move_block .
     1005           end.
     1006         end.
     1007         for each buf_temp-diasize-handle
     1008         on error undo move_block, retry move_block
     1009         :
     1010           assign
     1011             v-object-handle = buf_temp-diasize-handle.handle-value
     1012           .
     1013           if v-object-handle <> v-diasize-resize-button
     1014           then do:
     1015             assign
     1016               v-object-handle :row = v-object-handle :row + p-change-value
     1017               no-error .
     1018             if error-status :error
     1019             or error-status :get-message(1) <> ""
     1020             then do:
     1021               undo move_block, retry move_block .
     1022             end.
     1023           end.
     1024         end.
     1025       end.
     1026       else do:
     1027         for each buf_temp-diasize-handle
     1028         on error undo move_block, retry move_block
     1029         :
     1030           assign
     1031             v-object-handle = buf_temp-diasize-handle.handle-value
     1032           .
     1033           if v-object-handle <> v-diasize-resize-button
     1034           then do:
     1035             assign
     1036               v-object-handle :row = v-object-handle :row + p-change-value
     1037               no-error .
     1038             if error-status :error
     1039             or error-status :get-message(1) <> ""
     1040             then do:
     1041               undo move_block, retry move_block .
     1042             end.
     1043           end.
     1044         end.
     1045         assign
     1046           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1047           no-error .
     1048         if error-status :error
     1049         or error-status :get-message(1) <> ""
     1050         then do:
     1051           undo move_block, retry move_block .
     1052         end.
     1053         for each buf_temp-browse-handle
     1054           where buf_temp-browse-handle.browse-type = 'height':u
     1055         on error undo move_block, retry move_block
     1056         :
     1057           assign
     1058             buf_temp-browse-handle.browse-handle :height
     1059               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1060             no-error .
     1061           if error-status :error
     1062           or error-status :get-message(1) <> ""
     1063           then do:
     1064             undo move_block, retry move_block .
     1065           end.
     1066         end.
     1067         assign
     1068           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1069           no-error .
     1070         if error-status :error
     1071         or error-status :get-message(1) <> ""
     1072         then do:
     1073           undo move_block, retry move_block .
     1074         end.
     1075         if frame Dialog-Frame :scrollable = true
     1076         then do:
     1077           assign
     1078             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1079             no-error .
     1080           if error-status :error
     1081           or error-status :get-message(1) <> ""
     1082           then do:
     1083             undo move_block, retry move_block .
     1084           end.
     1085         end.
     1086       end.
     1087       if p-move-resize = true
     1088       then do:
     1089         run diasize_position-resize-button in this-procedure .
     1090       end.
     1091       if v-diasize-wndstore = true
     1092       then do:
     1093         if connected("ub") = true
     1094         then do:
     1095           define variable v-cntxt-db-num        as integer   no-undo .
     1096           define variable v-cntxt-userid        as character no-undo .
     1097           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1098                                             , OUTPUT v-cntxt-userid
     1099                                             ) .
     1100           run gbl/wndsizew.p
     1101             (input  v-cntxt-db-num
     1102             ,input  v-cntxt-userid
     1103             ,input  v-diasize-proc-name
     1104             ,input  'height':u
     1105             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1106             ) .
     1107         end.
     1108       end.
     1109     end.
     1110     assign
     1111       v-diasize-change-size = false
     1112     .
     1113   end procedure.
     1114   procedure diasize_set-height :
     1115     define input  parameter p-new-height  as decimal   no-undo .
     1116     define input  parameter p-move-resize as logical   no-undo .
     1117     do
     1118     on error undo, return error return-value
     1119     :
     1120       run diasize_change-height in this-procedure
     1121         (input  (p-new-height - frame Dialog-Frame :height)
     1122         ,input  p-move-resize
     1123         ) .
     1124     end.
     1125   end procedure.
     1126   procedure diasize_change-width :
     1127     define input  parameter p-change-value as decimal   no-undo .
     1128     define input  parameter p-move-resize  as logical   no-undo .
     1129     define variable v-field-group-handle   as handle    no-undo .
     1130     define variable v-object-handle        as handle    no-undo .
     1131     define variable v-frame-width          as decimal   no-undo .
     1132     define variable v-frame-virtual-width  as decimal   no-undo .
     1133     define variable v-browse-width         as decimal   no-undo .
     1134     define variable v-window-width         as decimal   no-undo .
     1135     define variable v-window-virtual-width as decimal   no-undo .
     1136     define variable v-change-sign          as integer   no-undo .
     1137     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1138     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1139     if p-change-value > 0
     1140     then do:
     1141       if frame Dialog-Frame :width + p-change-value >
     1142           session :width-chars
     1143       then do:
     1144         assign
     1145           p-change-value = session :width-chars - frame Dialog-Frame :width
     1146         .
     1147         if p-change-value <= 0
     1148         then do:
     1149           run diasize_position-resize-button in this-procedure .
     1150           return .
     1151         end.
     1152       end.
     1153     end.
     1154     if p-change-value < 0
     1155     then do:
     1156       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1157       then do:
     1158         assign
     1159           p-change-value = v-diasize-orig-frame-width
     1160                          - frame Dialog-Frame :width
     1161         .
     1162         if p-change-value >= 0
     1163         then do:
     1164           run diasize_position-resize-button in this-procedure .
     1165           return .
     1166         end.
     1167       end.
     1168     end.
     1169     if p-change-value >= 0
     1170     then do:
     1171       assign
     1172         v-change-sign = 1
     1173       .
     1174     end.
     1175     else do:
     1176       assign
     1177         v-change-sign = -1
     1178       .
     1179     end.
     1180     assign
     1181       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1182     .
     1183     if p-change-value = 0
     1184     then do:
     1185       run diasize_position-resize-button in this-procedure .
     1186       return .
     1187     end.
     1188     move_block:
     1189     do
     1190     on error undo move_block, leave move_block
     1191     :
     1192       if retry
     1193       then do:
     1194         do
     1195         on error undo move_block, leave move_block
     1196         :
     1197           if p-change-value > 0
     1198           then do:
     1199             for each buf_temp-diasize-handle
     1200             on error undo, next
     1201             :
     1202               assign
     1203                 v-object-handle = buf_temp-diasize-handle.handle-value
     1204               .
     1205               if v-object-handle <> v-diasize-resize-button
     1206               then do:
     1207                 assign
     1208                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1209                 .
     1210               end.
     1211             end.
     1212             assign
     1213               v-diasize-browse-handle :width = v-browse-width
     1214             .
     1215             for each buf_temp-browse-handle
     1216               where buf_temp-browse-handle.browse-type = 'width':u
     1217             on error undo, next
     1218             :
     1219               assign
     1220                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1221               .
     1222             end.
     1223             assign
     1224               frame Dialog-Frame :width = v-frame-width
     1225             .
     1226             if frame Dialog-Frame :scrollable = true
     1227             then do:
     1228               assign
     1229                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1230               .
     1231             end.
     1232             run diasize_position-resize-button in this-procedure .
     1233           end.
     1234           else do:
     1235             if frame Dialog-Frame :scrollable = true
     1236             then do:
     1237               assign
     1238                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1239               .
     1240             end.
     1241             assign
     1242               frame Dialog-Frame :width = v-frame-width
     1243             .
     1244             for each buf_temp-browse-handle
     1245               where buf_temp-browse-handle.browse-type = 'width':u
     1246             on error undo, next
     1247             :
     1248               assign
     1249                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1250               .
     1251             end.
     1252             assign
     1253               v-diasize-browse-handle :width = v-browse-width
     1254             .
     1255             for each buf_temp-diasize-handle
     1256             on error undo, next
     1257             :
     1258               assign
     1259                 v-object-handle = buf_temp-diasize-handle.handle-value
     1260               .
     1261               if v-object-handle <> v-diasize-resize-button
     1262               then do:
     1263                 assign
     1264                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1265                 .
     1266               end.
     1267             end.
     1268             run diasize_position-resize-button in this-procedure .
     1269           end.
     1270           assign
     1271             v-diasize-change-size = false
     1272           .
     1273           leave move_block .
     1274         end.
     1275       end.
     1276       assign
     1277         v-diasize-need-full-display = true
     1278       .
     1279       if v-diasize-change-size = false
     1280       then do:
     1281         assign
     1282           v-diasize-change-size = true
     1283         .
     1284       end.
     1285       else do:
     1286         return .
     1287       end.
     1288       assign
     1289         v-frame-width = frame Dialog-Frame :width
     1290         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1291         v-browse-width = v-diasize-browse-handle :width
     1292       .
     1293       for each buf_temp-browse-handle
     1294         where buf_temp-browse-handle.browse-type = 'width':u
     1295       :
     1296         assign
     1297           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1298         .
     1299       end.
     1300       for each buf_temp-diasize-handle
     1301       :
     1302         delete buf_temp-diasize-handle .
     1303       end.
     1304       assign
     1305         v-field-group-handle = frame Dialog-Frame :first-child
     1306       .
     1307       do while valid-handle(v-field-group-handle)
     1308       :
     1309         assign
     1310           v-object-handle = v-field-group-handle :first-child
     1311         .
     1312         do while valid-handle(v-object-handle)
     1313         :
     1314           if  v-object-handle <> v-diasize-browse-handle :handle
     1315           and v-object-handle <> v-diasize-resize-button
     1316           and can-query(v-object-handle, "row")
     1317           and can-query(v-object-handle, "height")
     1318           and ( v-object-handle :col + v-object-handle :width
     1319                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1320               )
     1321           then do:
     1322             find first buf_temp-browse-handle
     1323               where buf_temp-browse-handle.browse-type   = 'width':u
     1324                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1325               no-error .
     1326             if available buf_temp-browse-handle
     1327             then do:
     1328             end.
     1329             else do:
     1330               create buf_temp-diasize-handle .
     1331               assign
     1332                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1333                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1334               .
     1335             end.
     1336           end.
     1337           assign
     1338             v-object-handle = v-object-handle :next-sibling
     1339           .
     1340         end.
     1341         assign
     1342           v-field-group-handle = v-field-group-handle :next-sibling
     1343         .
     1344       end.
     1345       do with frame Dialog-Frame
     1346       :
     1347         hide v-diasize-resize-button .
     1348         v-diasize-resize-button :row = 1.
     1349         v-diasize-resize-button :column = 1.
     1350       end.
     1351       if p-change-value > 0
     1352       then do:
     1353         if frame Dialog-Frame :scrollable = true
     1354         then do:
     1355           assign
     1356             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1357             no-error .
     1358           if error-status :error
     1359           or error-status :get-message(1) <> ""
     1360           then do:
     1361             undo move_block, retry move_block.
     1362           end.
     1363         end.
     1364         assign
     1365           frame Dialog-Frame :width = v-frame-width + p-change-value
     1366           no-error .
     1367         if error-status :error
     1368         or error-status :get-message(1) <> ""
     1369         then do:
     1370           undo move_block, retry move_block.
     1371         end.
     1372         assign
     1373           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1374         no-error .
     1375         if error-status :error
     1376         or error-status :get-message(1) <> ""
     1377         then do:
     1378           undo move_block, retry move_block.
     1379         end.
     1380         for each buf_temp-browse-handle
     1381           where buf_temp-browse-handle.browse-type = 'width':u
     1382         on error undo move_block, retry move_block
     1383         :
     1384           assign
     1385             buf_temp-browse-handle.browse-handle :width
     1386               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1387             no-error .
     1388           if error-status :error
     1389           or error-status :get-message(1) <> ""
     1390           then do:
     1391             undo move_block, retry move_block .
     1392           end.
     1393         end.
     1394         for each buf_temp-diasize-handle
     1395         on error undo move_block, retry move_block
     1396         :
     1397           assign
     1398             v-object-handle = buf_temp-diasize-handle.handle-value
     1399           .
     1400           if v-object-handle <> v-diasize-resize-button
     1401           then do:
     1402             assign
     1403               v-object-handle :col = v-object-handle :col + p-change-value
     1404               no-error .
     1405             if error-status :error
     1406             or error-status :get-message(1) <> ""
     1407             then do:
     1408               undo move_block, retry move_block .
     1409             end.
     1410           end.
     1411         end.
     1412       end.
     1413       else do:
     1414         for each buf_temp-diasize-handle
     1415         on error undo move_block, retry move_block
     1416         :
     1417           assign
     1418             v-object-handle = buf_temp-diasize-handle.handle-value
     1419           .
     1420           if v-object-handle <> v-diasize-resize-button
     1421           then do:
     1422             assign
     1423               v-object-handle :col = v-object-handle :col + p-change-value
     1424               no-error .
     1425             if error-status :error
     1426             or error-status :get-message(1) <> ""
     1427             then do:
     1428               undo move_block, retry move_block .
     1429             end.
     1430           end.
     1431         end.
     1432         for each buf_temp-browse-handle
     1433           where buf_temp-browse-handle.browse-type = 'width':u
     1434         on error undo move_block, retry move_block
     1435         :
     1436           assign
     1437             buf_temp-browse-handle.browse-handle :width
     1438               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1439             no-error .
     1440           if error-status :error
     1441           or error-status :get-message(1) <> ""
     1442           then do:
     1443             undo move_block, retry move_block .
     1444           end.
     1445         end.
     1446         assign
     1447           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1448           no-error .
     1449         if error-status :error
     1450         or error-status :get-message(1) <> ""
     1451         then do:
     1452           undo move_block, retry move_block.
     1453         end.
     1454         assign
     1455           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1456         no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block.
     1461         end.
     1462         if frame Dialog-Frame :scrollable = true
     1463         then do:
     1464           assign
     1465             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1466           no-error .
     1467           if error-status :error
     1468           or error-status :get-message(1) <> ""
     1469           then do:
     1470             undo move_block, retry move_block.
     1471           end.
     1472         end.
     1473       end.
     1474       if p-move-resize
     1475       then do:
     1476         run diasize_position-resize-button in this-procedure .
     1477       end.
     1478       if v-diasize-wndstore = true
     1479       then do:
     1480         if connected("ub") = true
     1481         then do:
     1482           define variable v-cntxt-db-num        as integer   no-undo .
     1483           define variable v-cntxt-userid        as character no-undo .
     1484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1485                                             , OUTPUT v-cntxt-userid
     1486                                             ) .
     1487           run gbl/wndsizew.p
     1488             (input  v-cntxt-db-num
     1489             ,input  v-cntxt-userid
     1490             ,input  v-diasize-proc-name
     1491             ,input  'width':u
     1492             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1493             ) .
     1494         end.
     1495       end.
     1496     end.
     1497     assign
     1498       v-diasize-change-size = false
     1499     .
     1500   end procedure.
     1501   procedure diasize_set-width :
     1502     define input  parameter p-new-width  as decimal   no-undo .
     1503     define input  parameter p-move-resize as logical   no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       run diasize_change-width in this-procedure
     1508         (input  (p-new-width - frame Dialog-Frame :width)
     1509         ,input  p-move-resize
     1510         ) .
     1511     end.
     1512   end procedure.
     1513   procedure diasize_position-resize-button :
     1514     do with frame Dialog-Frame
     1515     :
     1516       hide v-diasize-resize-button .
     1517       assign
     1518         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1519                     - 1
     1520                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1521         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1522                     - 1
     1523                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1524       .
     1525       view v-diasize-resize-button .
     1526     end.
     1527   end procedure.
     1528   on alt-right anywhere
     1529   do:
     1530     run diasize_change-width in this-procedure
     1531       (input 1
     1532       ,input true
     1533       ) .
     1534     return no-apply .
     1535   end.
     1536   on alt-left anywhere
     1537   do:
     1538     run diasize_change-width in this-procedure
     1539       (input -1
     1540       ,input true
     1541       ) .
     1542     return no-apply .
     1543   end.
     1544   on alt-down anywhere
     1545   do:
     1546     run diasize_change-height in this-procedure
     1547       (input 1
     1548       ,input true
     1549       ) .
     1550     return no-apply .
     1551   end.
     1552   on alt-up anywhere
     1553   do:
     1554     run diasize_change-height in this-procedure
     1555       (input -1
     1556       ,input true
     1557       ) .
     1558     return no-apply .
     1559   end.
     1560   on alt-enter of frame Dialog-Frame
     1561   do:
     1562     run diasize_maximize in this-procedure
     1563       (input  ?
     1564       ).
     1565     return no-apply .
     1566   end.
     1567   procedure diasize_end-move :
     1568     do
     1569     on error undo, return error return-value
     1570     :
     1571       define variable v-row-delta as decimal   no-undo .
     1572       define variable v-col-delta as decimal   no-undo .
     1573       define variable v-new-row as decimal   no-undo .
     1574       define variable v-new-col as decimal   no-undo .
     1575       assign
     1576         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1577         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1578       .
     1579       assign
     1580         v-row-delta = v-new-row - frame Dialog-Frame :height
     1581         v-col-delta = v-new-col - frame Dialog-Frame :width
     1582       .
     1583       run diasize_change-height in this-procedure
     1584         (input v-row-delta
     1585         ,input true
     1586         ) .
     1587       run diasize_change-width in this-procedure
     1588         (input v-col-delta
     1589         ,input true
     1590         ) .
     1591     end.
     1592   end procedure.
     1593   procedure diasize_maximize :
     1594     define input  parameter p-action as logical   no-undo .
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       if p-action = ?
     1599       then do:
     1600         if v-diasize-need-maximize = true
     1601         then do:
     1602           assign
     1603             p-action = true
     1604           .
     1605         end.
     1606         else do:
     1607           assign
     1608             p-action = false
     1609           .
     1610         end.
     1611       end.
     1612       if p-action = true
     1613       then do:
     1614         run diasize_change-height in this-procedure
     1615           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1616               - frame Dialog-Frame :height-chars
     1617           ,input true
     1618           ) .
     1619         run diasize_change-width in this-procedure
     1620           (input session :width-chars
     1621               - frame Dialog-Frame :width-chars
     1622           ,input true
     1623           ) .
     1624         assign
     1625           v-diasize-need-maximize = false
     1626         .
     1627       end.
     1628       else do:
     1629         run diasize_change-width in this-procedure
     1630           (input v-diasize-orig-frame-width
     1631               - frame Dialog-Frame :width-chars
     1632           ,input true
     1633           ) .
     1634         run diasize_change-height in this-procedure
     1635           (input v-diasize-orig-frame-height
     1636               - frame Dialog-Frame :height-chars
     1637           ,input true
     1638           ) .
     1639         assign
     1640           v-diasize-need-maximize = true
     1641         .
     1642       end.
     1643     end.
     1644   end procedure.
     1645   procedure diasize_restore-orig-size :
     1646     do
     1647     on error undo, return error return-value
     1648     :
     1649       assign
     1650         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1651         v-diasize-current-frame-height = frame Dialog-Frame :height
     1652       .
     1653       run diasize_set-height in this-procedure
     1654         (input  v-diasize-orig-frame-height
     1655         ,input  true
     1656         ) .
     1657       run diasize_set-width in this-procedure
     1658         (input  v-diasize-orig-frame-width
     1659         ,input  true
     1660         ) .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_restore-current-size :
     1664     do
     1665     on error undo, return error return-value
     1666     :
     1667       run diasize_set-height in this-procedure
     1668         (input  v-diasize-current-frame-height
     1669         ,input  true
     1670         ) .
     1671       run diasize_set-width in this-procedure
     1672         (input  v-diasize-current-frame-width
     1673         ,input  true
     1674         ) .
     1675     end.
     1676   end procedure.
     1677   procedure diasize_set-browse-handle :
     1678     define input  parameter p-browse-handle as handle   no-undo .
     1679     define buffer buf_temp-browse-handle for temp-browse-handle .
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       assign
     1684         v-diasize-browse-handle = p-browse-handle
     1685       .
     1686       for each buf_temp-browse-handle
     1687       on error undo, return error return-value
     1688       :
     1689         delete buf_temp-browse-handle .
     1690       end.
     1691     end.
     1692   end procedure.
     1693   procedure diasize_add_browse :
     1694     define input  parameter p-browse-type   as character no-undo .
     1695     define input  parameter p-browse-handle as handle    no-undo .
     1696     define buffer buf_temp-browse-handle for temp-browse-handle .
     1697     do
     1698     on error undo, return error return-value
     1699     :
     1700       assign
     1701         v-diasize-browse-number = v-diasize-browse-number + 1
     1702       .
     1703       create buf_temp-browse-handle .
     1704       assign
     1705         buf_temp-browse-handle.browse-type   = p-browse-type
     1706         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1707         buf_temp-browse-handle.browse-handle = p-browse-handle
     1708       .
     1709     end.
     1710   end procedure.
     1711   procedure diasize_init :
     1712     define variable v-default-value    as logical   no-undo .
     1713     define variable v-restore-saved    as logical   no-undo .
     1714     define variable v-resize-value-str as character no-undo .
     1715     do
     1716     on error undo, return error return-value
     1717     :
     1718       do with frame Dialog-Frame
     1719       :
     1720         assign
     1721           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1722           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1723           v-diasize-browse-handle     = browse BR-tt-tax :handle
     1724         .
     1725         create button v-diasize-resize-button
     1726         assign
     1727           parent        = frame Dialog-Frame :first-child
     1728           label         = "s"
     1729           height-pixels = 16
     1730           width-pixels  = 16
     1731           visible       = true
     1732           sensitive     = true
     1733           movable       = true
     1734           triggers:
     1735             on end-move persistent run diasize_end-move in this-procedure .
     1736           end triggers.
     1737         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1738         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1739         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1740         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1741         assign
     1742           v-diasize-wndmax = false
     1743         .
     1744         if connected("ub") = true
     1745         then do:
     1746           define variable v-cntxt-db-num        as integer   no-undo .
     1747           define variable v-cntxt-userid        as character no-undo .
     1748           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1749                                             , OUTPUT v-cntxt-userid
     1750                                             ) .
     1751           run gbl/wndpar_r.p
     1752             (input  v-cntxt-db-num
     1753             ,input  v-cntxt-userid
     1754             ,input  'wndmax':U
     1755             ,output v-diasize-wndmax
     1756             ,output v-default-value
     1757             ) .
     1758         end.
     1759         assign
     1760           v-diasize-wndstore = false
     1761         .
     1762         if connected("ub") = true
     1763         then do:
     1764           run gbl/wndpar_r.p
     1765             (input  v-cntxt-db-num
     1766             ,input  v-cntxt-userid
     1767             ,input  'wndstore':U
     1768             ,output v-diasize-wndstore
     1769             ,output v-default-value
     1770             ) .
     1771         end.
     1772         assign
     1773           v-diasize-proc-name = entry(1, program-name(2), '.')
     1774         .
     1775         if v-diasize-wndstore = true
     1776         then do:
     1777           assign
     1778             v-restore-saved = false
     1779           .
     1780           if connected("ub") = true
     1781           then do:
     1782             run gbl/wndsizer.p
     1783               (input  v-cntxt-db-num
     1784               ,input  v-cntxt-userid
     1785               ,input  v-diasize-proc-name
     1786               ,input  'height':u
     1787               ,output v-resize-value-str
     1788               ) .
     1789             if v-resize-value-str <> '':U
     1790             then do:
     1791               run diasize_change-height in this-procedure
     1792                 (input  integer(v-resize-value-str)
     1793                 ,input  true
     1794                 ) .
     1795               assign
     1796                 v-restore-saved = true
     1797               .
     1798             end.
     1799           end.
     1800           if connected("ub") = true
     1801           then do:
     1802             run gbl/wndsizer.p
     1803               (input  v-cntxt-db-num
     1804               ,input  v-cntxt-userid
     1805               ,input  v-diasize-proc-name
     1806               ,input  'width':u
     1807               ,output v-resize-value-str
     1808               ) .
     1809             if v-resize-value-str <> '':U
     1810             then do:
     1811               run diasize_change-width in this-procedure
     1812                 (input  integer(v-resize-value-str)
     1813                 ,input  true
     1814                 ) .
     1815               assign
     1816                 v-restore-saved = true
     1817               .
     1818             end.
     1819           end.
     1820           if v-restore-saved <> true
     1821           then do:
     1822             if v-diasize-wndmax = true
     1823             then do:
     1824               run diasize_maximize in this-procedure
     1825                 (input  true
     1826                 ) .
     1827             end.
     1828           end.
     1829         end.
     1830         else do:
     1831           if v-diasize-wndmax = true
     1832           then do:
     1833             run diasize_maximize in this-procedure
     1834               (input  true
     1835               ) .
     1836           end.
     1837         end.
     1838       end.
     1839     end.
     1840   end procedure.
     1841   procedure diasize_need-full-display :
     1842     define output parameter p-need-full-display as logical   no-undo .
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       assign
     1847         p-need-full-display = v-diasize-need-full-display
     1848       .
     1849       assign
     1850         v-diasize-need-full-display = false
     1851       .
     1852     end.
     1853   end procedure.
     1854   procedure get-context :
     1855      define output parameter p-db-num as integer          no-undo.
     1856      define output parameter p-user-id as character        no-undo.
     1857      define variable v-login               as character    no-undo.
     1858      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1859      define buffer buf_user-login  for ub.user-login .
     1860      do
     1861      on error undo, return error
     1862      :
     1863            FIND FIRST buf_sys-ctrl no-lock.
     1864            ASSIGN
     1865               v-login = USERID("ub")
     1866               p-db-num = buf_sys-ctrl.db-num
     1867            .
     1868            FIND FIRST buf_user-login
     1869                 WHERE buf_user-login.db-num = p-db-num
     1870                   AND buf_user-login.user-login = v-login
     1871                 no-lock
     1872                 no-error
     1873                 .
     1874            IF AVAILABLE buf_user-login
     1875            THEN DO:
     1876               assign
     1877                  p-user-id = buf_user-login.user-id
     1878               .
     1879            END.
     1880      end.
     1881   end procedure.
     1882       run diasize_init in this-procedure .
     1883   MAIN-BLOCK:
     1884   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1885      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1886   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1887     run mainmenu_getcntxt in parparentproc
     1888       (output v-cntxt-db-num
     1889       ,output v-cntxt-userid
     1890       ,output v-cntxt-level
     1891       ,output v-cntxt-host-code-obj
     1892       ,output v-cntxt-obj-type
     1893       ,output v-cntxt-obj-code
     1894       ,output v-cntxt-db-num-obj
     1895       ,output v-cntxt-is-admin
     1896       ) .
     1897     RUN enable_UI.
     1898     WAIT-FOR GO OF FRAME Dialog-Frame.
     1899   END.
     1900   RUN disable_UI.
     1901   PROCEDURE disable_UI :
     1902     HIDE FRAME Dialog-Frame.
     1903   END PROCEDURE.
     1904   PROCEDURE enable_UI :
     1905     DISPLAY RS-method RS-values RS-groups label-fill-method label-fill-values
     1906             label-fill-subject
     1907         WITH FRAME Dialog-Frame.
     1908     ENABLE b-quit B-exit B-Help B-add-tt-tax B-del-tt-tax RS-method RS-values
     1909            RS-groups B-groups B-groups-tree label-fill-method label-fill-values
     1910            label-fill-subject
     1911         WITH FRAME Dialog-Frame.
     1912     VIEW FRAME Dialog-Frame.
     1913     OPEN QUERY BR-tt-tax FOR EACH tt-tax NO-LOCK.
     1914   END PROCEDURE.
     1915   PROCEDURE proc-save :
     1916   run utl/in-grptx.p (
     1917                    input RS-method
     1918                   , input RS-groups
     1919                                   , input Rs-values
     1920                   , input V-RID-LIST) no-error.
     1921   if error-status:error then return error.
     1922   END PROCEDURE.
