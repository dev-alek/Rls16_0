        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: 1f78fe327cdf, 1091, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        5   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: thth150.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: utl/thth150.p $":U .
        8   define variable vss-description as character no-undo init "Запуск пакета утилита THTH".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     define variable v-cntxt-db-num        as integer   no-undo .
       80     define variable v-cntxt-userid        as character no-undo .
       81     define variable v-cntxt-level         as character no-undo .
       82     define variable v-cntxt-host-code-obj as integer   no-undo .
       83     define variable v-cntxt-obj-type      as character no-undo .
       84     define variable v-cntxt-obj-code      as integer   no-undo .
       85     define variable v-cntxt-db-num-obj    as integer   no-undo .
       86     define variable v-cntxt-is-admin      as logical   no-undo .
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88     run mainmenu_getcntxt in parparentproc
       89       (output v-cntxt-db-num
       90       ,output v-cntxt-userid
       91       ,output v-cntxt-level
       92       ,output v-cntxt-host-code-obj
       93       ,output v-cntxt-obj-type
       94       ,output v-cntxt-obj-code
       95       ,output v-cntxt-db-num-obj
       96       ,output v-cntxt-is-admin
       97       ) .
       98   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure thth150-db-attr-code :
      100     do
      101     on error undo, return error
      102     :
      103       define input  parameter p-code           as character no-undo .
      104       define output parameter p-type           as character no-undo .
      105       define output parameter p-format         as character no-undo .
      106       define output parameter p-label          as character no-undo .
      107       define output parameter p-user-can-edit  as logical   no-undo .
      108       define output parameter p-output-display as logical   no-undo .
      109       define output parameter p-other          as character no-undo .
      110       case p-code :
      111               when 'thth150-cli-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      112               when 'thth150-gds-grp':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие групп товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      113               when 'thth150-clients':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие клиентов"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      114               when 'thth150-goods':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие товаров"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      115               when 'thth150-dis-card':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ ДК"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      116               when 'thth150-qnty-dis-card':U then do:     assign     p-label = "Ожидаемое кол-во ДК"     p-type = 'I':U      p-format = "999,999,999"     p-label = "Ожидаемое кол-во ДК"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      117               when 'thth150-shop':U then do:     assign     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-type = 'L':U      p-format = "+/-"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      118               when 'thth150-contract':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      119               when 'thth150-price-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ переоценки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      120               when 'thth150-trn-doc':U then do:     assign     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-type = 'L':U      p-format = "+/-"     p-label = "ИМПОРТИРОВАНЫ приходные накладные"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      121         otherwise do:
      122           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      123         end.
      124       end.
      125     end.
      126   end procedure.
      127   procedure thth150-db-attr-tooltip :
      128     do
      129     on error undo, return error
      130     :
      131       define input  parameter p-code    as character no-undo .
      132       define output parameter p-tooltip as character no-undo .
      133       define output parameter p-label   as character no-undo .
      134       case p-code :
      135               when 'thth150-cli-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп клиентов" .   end.
      136               when 'thth150-gds-grp':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие групп товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие групп товаров" .   end.
      137               when 'thth150-clients':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие клиентов для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие клиентов" .   end.
      138               when 'thth150-goods':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие товаров для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие товаров" .   end.
      139               when 'thth150-dis-card':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ ДК"     p-label = "ИМПОРТИРОВАНЫ ДК" .   end.
      140               when 'thth150-qnty-dis-card':U then do:     assign     p-tooltip = "Ожидаемое кол-во ДК"     p-label = "Ожидаемое кол-во ДК" .   end.
      141               when 'thth150-shop':U then do:     assign     p-tooltip = "УСТАНОВЛЕНО соответствие объeктов TH для двух систем IBS TH"     p-label = "УСТАНОВЛЕНО соответствие объeктов TH" .   end.
      142               when 'thth150-contract':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ договора и спецификации для двух систем IBS TH"     p-label = "ИМПОРТИРОВАНЫ договора и спецификации" .   end.
      143               when 'thth150-price-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ переоценки"     p-label = "ИМПОРТИРОВАНЫ переоценки" .   end.
      144               when 'thth150-trn-doc':U then do:     assign     p-tooltip = "ИМПОРТИРОВАНЫ приходные накладные"     p-label = "ИМПОРТИРОВАНЫ приходные накладные" .   end.
      145         otherwise do:
      146           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      147         end.
      148       end.
      149     end.
      150   end procedure.
      151   procedure thth150-db-attr-value :
      152     do
      153     on error undo, return error
      154     :
      155       define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      156       define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      157       define output parameter p-value     like ub.db-attr.attr-value no-undo .
      158       define output parameter p-type      as character no-undo .
      159       define buffer buf_db-attr for ub.db-attr .
      160       define variable v-format         as character no-undo .
      161       define variable v-label          as character no-undo .
      162       define variable v-user-can-edit  as logical   no-undo .
      163       define variable v-output-display as logical   no-undo .
      164       define variable v-other          as character no-undo .
      165       run thth150-db-attr-code in this-procedure
      166         (input  p-code
      167         ,output p-type
      168         ,output v-format
      169         ,output v-label
      170         ,output v-user-can-edit
      171         ,output v-output-display
      172         ,output v-other
      173         ) no-error .
      174       if error-status :error then do:
      175         undo, return error return-value .
      176       end.
      177       find first buf_db-attr no-lock
      178         where buf_db-attr.db-num    = p-db-num
      179           and buf_db-attr.attr-code = p-code
      180         no-error .
      181       if avail buf_db-attr then do:
      182         assign
      183           p-value =  buf_db-attr.attr-value
      184         .
      185       end.
      186       else do:
      187         assign
      188           p-value = if p-type = 'L':U then "no":U else ""
      189         .
      190       end.
      191     end.
      192   end procedure.
      193   procedure thth150-db-attr-write :
      194     do
      195     on error undo, return error
      196     :
      197       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      198       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      199       define input parameter p-value     like ub.db-attr.attr-value no-undo .
      200       define buffer buf_db-attr for ub.db-attr .
      201       define variable v-type           as character no-undo .
      202       define variable v-format         as character no-undo .
      203       define variable v-label          as character no-undo .
      204       define variable v-user-can-edit  as logical   no-undo .
      205       define variable v-output-display as logical   no-undo .
      206       define variable v-other          as character no-undo .
      207       run thth150-db-attr-code in this-procedure
      208         (input  p-code
      209         ,output v-type
      210         ,output v-format
      211         ,output v-label
      212         ,output v-user-can-edit
      213         ,output v-output-display
      214         ,output v-other
      215         ) no-error .
      216       if error-status :error then do:
      217         undo, return error return-value .
      218       end.
      219       find first buf_db-attr exclusive-lock
      220         where buf_db-attr.db-num    = p-db-num
      221           and buf_db-attr.attr-code = p-code
      222         no-error .
      223       if not available buf_db-attr then do:
      224         create buf_db-attr .
      225         assign
      226           buf_db-attr.db-num    = p-db-num
      227           buf_db-attr.attr-code = p-code
      228         .
      229       end.
      230       assign
      231         buf_db-attr.attr-value = p-value
      232       .
      233     end.
      234   end procedure.
      235   procedure thth150-db-attr-exist :
      236     do
      237     on error undo, return error
      238     :
      239       define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      240       define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      241       define output parameter p-exist    as logical  no-undo .
      242       define buffer buf_db-attr for ub.db-attr .
      243       define variable v-type           as character no-undo .
      244       define variable v-format         as character no-undo .
      245       define variable v-label          as character no-undo .
      246       define variable v-user-can-edit  as logical   no-undo .
      247       define variable v-output-display as logical   no-undo .
      248       define variable v-other          as character no-undo .
      249       run thth150-db-attr-code in this-procedure
      250         (input  p-code
      251         ,output v-type
      252         ,output v-format
      253         ,output v-label
      254         ,output v-user-can-edit
      255         ,output v-output-display
      256         ,output v-other
      257         ) no-error .
      258       if error-status :error then do:
      259         undo, return error return-value .
      260       end.
      261       find first buf_db-attr no-lock
      262         where buf_db-attr.db-num    = p-db-num
      263           and buf_db-attr.attr-code = p-code
      264         no-error .
      265       if  available buf_db-attr then do:
      266         p-exist = yes.
      267       end.
      268     end.
      269   end procedure.
      270   procedure thth150-db-attr-delete :
      271     do
      272     on error undo, return error
      273     :
      274       define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
      275       define input parameter p-code     like ub.db-attr.attr-code  no-undo .
      276       define output parameter p-deleted  as logical no-undo.
      277       define buffer buf_db-attr for ub.db-attr .
      278       define variable v-type           as character no-undo .
      279       define variable v-format         as character no-undo .
      280       define variable v-label          as character no-undo .
      281       define variable v-user-can-edit  as logical   no-undo .
      282       define variable v-output-display as logical   no-undo .
      283       define variable v-other          as character no-undo .
      284       run thth150-db-attr-code in this-procedure
      285         (input  p-code
      286         ,output v-type
      287         ,output v-format
      288         ,output v-label
      289         ,output v-user-can-edit
      290         ,output v-output-display
      291         ,output v-other
      292         ) no-error .
      293       if error-status :error then do:
      294         undo, return error return-value .
      295       end.
      296       find first buf_db-attr exclusive-lock
      297         where buf_db-attr.db-num    = p-db-num
      298           and buf_db-attr.attr-code = p-code
      299         no-error NO-WAIT.
      300       if not available buf_db-attr then do:
      301         p-deleted = no.
      302       end.
      303       else do:
      304         delete buf_db-attr.
      305         p-deleted = yes.
      306       end.
      307     end.
      308   end procedure.
      309   procedure thth150-db-attr-news :
      310     do
      311     on error undo, return error
      312     :
      313       define input  parameter p-code           as character no-undo .
      314       define output parameter p-news           as logical   no-undo .
      315       case p-code :
      316               when 'thth150-cli-grp':U then do:     assign     p-news = no.   end.
      317               when 'thth150-gds-grp':U then do:     assign     p-news = no.   end.
      318               when 'thth150-clients':U then do:     assign     p-news = no.   end.
      319               when 'thth150-goods':U then do:     assign     p-news = no.   end.
      320               when 'thth150-dis-card':U then do:     assign     p-news = no.   end.
      321               when 'thth150-qnty-dis-card':U then do:     assign     p-news = no.   end.
      322               when 'thth150-shop':U then do:     assign     p-news = no.   end.
      323               when 'thth150-contract':U then do:     assign     p-news = no.   end.
      324               when 'thth150-price-doc':U then do:     assign     p-news = no.   end.
      325               when 'thth150-trn-doc':U then do:     assign     p-news = no.   end.
      326         otherwise do:
      327           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
      328         end.
      329       end.
      330     end.
      331   end procedure.
      332   define variable v-operations as character no-undo .
      333   define variable v-operation-codes as character no-undo .
      334   define variable v-selected-operation as character no-undo .
      335   define variable v-operation-name as character no-undo .
      336   define variable v-run-file-name as character no-undo .
      337   define variable v-can-init as logical no-undo .
      338   define variable v-rid-list as character no-undo .
      339   define variable v-ok as logical no-undo .
      340   define variable v-is-debug as logical no-undo .
      341   define variable v-value as character no-undo .
      342   define variable v-type as character no-undo .
      343   define variable v-mess as character no-undo .
      344   define variable v-log as logical no-undo .
      345   define variable v-attr-query-list as character no-undo .
      346   define variable v-value-list as character no-undo .
      347   define variable v-jj as integer no-undo .
      348   define variable v-exist as logical no-undo .
      349   v-is-debug = no.
      350   assign
      351   v-operations = "":U
      352   v-operation-codes = "":U
      353   v-selected-operation = "start"
      354   .
      355   assign
      356   v-operations =
      357                 "Инициация переноса объекта" + chr(4) +
      358                 "Соответствие клиентов" + chr(4) +
      359                 "Соответствие товаров" + chr(4) +
      360                 "Соответствие объектов" + chr(4) +
      361                 "Импорт переоценок" + chr(4) +
      362                 "Закрытие ДНЦ" + chr(4) +
      363                 "Импорт приходных накладных" + chr(4) +
      364                 "Импорт лок. данных - ЗАПУСКАЕТСЯ В УБД - если объект принадлежит УБД" + chr(4) +
      365                 "Отчет"
      366   v-operation-codes  =  "ini" + chr(4) +
      367                         'clients':U + chr(4) +
      368                         'goods':U + chr(4) +
      369                         'shop':U + chr(4) +
      370                         'price-doc':U + chr(4) +
      371                         "close-pdf" + chr(4) +
      372                         'trn-doc':U + chr(4) +
      373                         "impxexpi" + chr(4) +
      374                         "rep"
      375   .
      376   _leave:
      377   do while v-selected-operation <> ""
      378   on error undo, leave _leave
      379   on stop undo, leave _leave
      380   on end-key undo, leave _leave
      381   :
      382     run gbl/d-list.w (
      383                   INPUT "b-sel":U
      384                   ,INPUT "Выберите операцию по сведению систем 16.0 и 15.0 "
      385                   ,INPUT v-operation-codes
      386                   ,INPUT v-operations
      387                   ,INPUT chr(4)
      388                   ,INPUT "":U
      389                   ,output v-selected-operation).
      390     IF v-selected-operation = "":u THEN do:
      391       leave _leave.
      392     end.
      393     assign
      394     v-operation-name = entry(lookup(v-selected-operation, v-operation-codes, chr(4)) , v-operations, chr(4))
      395     .
      396     case v-selected-operation:
      397       when "" then do:
      398         leave _leave.
      399       end.
      400       when "ini" then do:
      401         assign
      402         v-value-list = ''
      403         v-attr-query-list = 'thth150-clients':U + chr(4) + 'thth150-goods':U + chr(4) + 'thth150-shop':U
      404         .
      405         do v-jj = 1 to num-entries(v-attr-query-list, chr(4) ):
      406           v-exist = no.
      407           v-value = string(yes).
      408           run thth150-db-attr-exist in this-procedure ( input 0
      409                                                    ,input entry(v-jj, v-attr-query-list, chr(4) )
      410                                                    ,output v-exist).
      411           if v-exist then do:
      412             run thth150-db-attr-value in this-procedure ( input 0
      413                                                       ,input entry(v-jj, v-attr-query-list, chr(4))
      414                                                       ,output v-value
      415                                                       ,output v-type) no-error.
      416           end.
      417           v-value-list = v-value-list + (if v-value-list = '' then '' else chr(4) ) + v-value.
      418         end.
      419         if lookup(string(no), v-value-list, chr(4) ) > 0 then do:
      420           message
      421           "Начат но не закончен этап сведения v15.0 и v16.0"
      422           view-as alert-box error .
      423         end.
      424         else do:
      425           do v-jj = 1 to num-entries(v-attr-query-list, chr(4) ):
      426             run thth150-db-attr-write in this-procedure ( input 0
      427                                                       ,input entry(v-jj, v-attr-query-list, chr(4))
      428                                                       ,input string(no)
      429                                                       ) no-error.
      430           end.
      431         end.
      432       end.
      433       when 'goods':U then do:
      434         assign
      435         v-attr-query-list = 'thth150-clients':U
      436         v-value-list = "no"
      437         v-mess = "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ КЛИЕНТАМИ В РАЗНЫХ БД"
      438         .
      439         do v-jj = 1 to num-entries(v-attr-query-list, chr(4)):         v-value = ''.         run thth150-db-attr-value in this-procedure ( input 0                                                   ,input entry(v-jj, v-attr-query-list, chr(4))                                                   ,output v-value                                                   ,output v-type) no-error.         assign         v-log = logical(v-value)         no-error .         if v-log = logical(entry(v-jj, v-value-list, chr(4))) then do:           if v-is-debug then do:             message             entry(v-jj, v-mess, chr(4) )             view-as alert-box warning.           end.           else do:             message              v-mess                 view-as alert-box error.             next _leave.           end.                    end.       end.
      440         run utl/thth-gds.w ( input parparentproc
      441                              ,input (if g#db-num = 0 then "b-add" else "")
      442                              ,input 'v15_0000':U
      443                              ,input ''
      444                              ,input-output v-rid-list) no-error.
      445       end.
      446       when 'clients':U then do:
      447         run utl/thth-cli.w ( input parparentproc
      448                              ,input (if g#db-num = 0 then "b-add" else "")
      449                              ,input 'v15_0000':U
      450                              ,input ''
      451                              ,input-output v-rid-list) no-error.
      452       end.
      453       when "impxexpi" then do:
      454         assign
      455         v-attr-query-list = 'thth150-shop':U + chr(4) +
      456                             'thth150-clients':U + chr(4) +
      457                             'thth150-goods':U
      458         v-value-list = "no" + chr(4) +
      459                        "no" + chr(4) +
      460                        "no"
      461         v-mess = "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ОБЪЕКТАМИ В РАЗНЫХ БД" + chr(4) +
      462                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ КЛИЕНТАМИ В РАЗНЫХ БД" + chr(4)  +
      463                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ТОВАРАМИ В РАЗНЫХ БД"
      464         .
      465         do v-jj = 1 to num-entries(v-attr-query-list, chr(4)):         v-value = ''.         run thth150-db-attr-value in this-procedure ( input 0                                                   ,input entry(v-jj, v-attr-query-list, chr(4))                                                   ,output v-value                                                   ,output v-type) no-error.         assign         v-log = logical(v-value)         no-error .         if v-log = logical(entry(v-jj, v-value-list, chr(4))) then do:           if v-is-debug then do:             message             entry(v-jj, v-mess, chr(4) )             view-as alert-box warning.           end.           else do:             message              v-mess                 view-as alert-box error.             next _leave.           end.                    end.       end.
      466         run utl/expximp.w ( input parparentproc
      467                            ,input 'v15_0000':U
      468                            ) no-error.
      469       end.
      470       when 'shop':U then do:
      471         run utl/thth-cli.w ( input parparentproc
      472                             ,input (if g#db-num = 0 then "b-add" else "")
      473                             ,input 'v15_0000':U
      474                             ,input 'объект':U
      475                             ,input-output v-rid-list) no-error.
      476       end.
      477       when 'price-doc':U then do:
      478         assign
      479         v-attr-query-list = 'thth150-shop':U + chr(4) +
      480                             'thth150-clients':U + chr(4) +
      481                             'thth150-goods':U
      482         v-value-list = "no" + chr(4) +
      483                        "no" + chr(4) +
      484                        "no"
      485         v-mess = "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ОБЪЕКТАМИ В РАЗНЫХ БД" + chr(4) +
      486                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ КЛИЕНТАМИ В РАЗНЫХ БД" + chr(4)  +
      487                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ТОВАРАМИ В РАЗНЫХ БД"
      488         .
      489         do v-jj = 1 to num-entries(v-attr-query-list, chr(4)):         v-value = ''.         run thth150-db-attr-value in this-procedure ( input 0                                                   ,input entry(v-jj, v-attr-query-list, chr(4))                                                   ,output v-value                                                   ,output v-type) no-error.         assign         v-log = logical(v-value)         no-error .         if v-log = logical(entry(v-jj, v-value-list, chr(4))) then do:           if v-is-debug then do:             message             entry(v-jj, v-mess, chr(4) )             view-as alert-box warning.           end.           else do:             message              v-mess                 view-as alert-box error.             next _leave.           end.                    end.       end.
      490         run cmp/ththovr1.w ( input parparentproc
      491                             ,input 'v15_0000':U
      492                             ) no-error .
      493       end.
      494       when "close-pdf" then do:
      495         run utl/ththovr3.p ( input parparentproc
      496                             ,input 'v15_0000':U
      497                             ) no-error .
      498       end.
      499       when 'trn-doc':U then do:
      500         assign
      501         v-attr-query-list = 'thth150-shop':U + chr(4) +
      502                             'thth150-clients':U + chr(4) +
      503                             'thth150-goods':U
      504         v-value-list = "no" + chr(4) +
      505                        "no" + chr(4) +
      506                        "no"
      507         v-mess = "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ОБЪЕКТАМИ В РАЗНЫХ БД" + chr(4) +
      508                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ КЛИЕНТАМИ В РАЗНЫХ БД" + chr(4)  +
      509                  "ЕЩЕ НЕ УСТАНОВЛЕНО СООТВЕТСТВИЕ МЕЖДУ ТОВАРАМИ В РАЗНЫХ БД"
      510         .
      511         do v-jj = 1 to num-entries(v-attr-query-list, chr(4)):         v-value = ''.         run thth150-db-attr-value in this-procedure ( input 0                                                   ,input entry(v-jj, v-attr-query-list, chr(4))                                                   ,output v-value                                                   ,output v-type) no-error.         assign         v-log = logical(v-value)         no-error .         if v-log = logical(entry(v-jj, v-value-list, chr(4))) then do:           if v-is-debug then do:             message             entry(v-jj, v-mess, chr(4) )             view-as alert-box warning.           end.           else do:             message              v-mess                 view-as alert-box error.             next _leave.           end.                    end.       end.
      512         run cmp/ththpri1.w ( input parparentproc
      513                             ,input 'v15_0000':U
      514                              ) no-error .
      515       end.
      516       when "rep" then do:
      517         run utl/ththrepr.p ( input parparentproc
      518                             ,input 'v15_0000':U
      519                             ) no-error.
      520       end.
      521       otherwise do:
      522         message
      523         "НЕВЕРНОЕ ЗНАЧЕНИЕ ВЫБОРА"
      524         view-as alert-box .
      525       end.
      526     end case.
      527     if error-status:error
      528     or return-value = "error"
      529     then do:
      530       message
      531       substitute("Ошибки при выполнении операции &1:&2" +
      532                   "&3&2&4"
      533                   , v-operation-name
      534                   , chr(10)
      535                   , error-status:get-message(1)
      536                   , return-value )
      537       view-as alert-box error .
      538     end.
      539   end.
      540   if connected ("src") then do:
      541     disconnect src.
      542   end.
      543   procedure cb_close-without-verify :
      544   define output parameter p-no-ver as logical   no-undo .
      545     do
      546     on error undo, return error return-value
      547     :
      548      p-no-ver = true .
      549     end.
      550   end procedure.
