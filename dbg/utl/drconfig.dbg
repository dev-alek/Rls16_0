        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список сущностей правил скидок".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define variable v-waitfram-action01         as character   no-undo .
       64   define variable v-waitfram-action02         as character   no-undo .
       65   define variable v-waitfram-action03         as character   no-undo .
       66   define variable mWaitFramTextBeg            as character   no-undo.
       67   define variable mWaitFramTextEnd            as character   no-undo.
       68   define variable mWaitFramView               as logical     no-undo.
       69   define variable mWaitProcEvent              as logical     no-undo init yes.
       70   define variable mWaitFramInterval           as integer     no-undo init 1 .
       71   define variable mWaitFramStop               as logical     no-undo.
       72   define variable mWaitFramStopUser           as logical     no-undo.
       73   define variable mWaitFramStopTimeOut        as logical     no-undo.
       74   define variable mWaitFramStartProc          as datetime-tz no-undo.
       75   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       76   define button B-WaitFramStop auto-end-key
       77        label "Стоп"
       78        size 10 by 1 tooltip "Остоновить процесс".
       79   define button B-viewProcInfo
       80        label "Информация"
       81        size 15 by 1 tooltip "Информация о процесс".
       82   define frame waitfram
       83     v-waitfram-action01 format "x(72)" no-label skip
       84     v-waitfram-action02 format "x(72)" no-label skip
       85     v-waitfram-action03 format "x(72)" no-label skip
       86     B-viewProcInfo
       87     B-WaitFramStop at row 4 col 30
       88     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       89     .
       90   define new global shared variable mBatchMode as logical no-undo init ?.
       91   define variable mFramBachModHandle as handle no-undo.
       92   mFramBachModHandle = frame waitfram:handle.
       93   define variable mFameOldVis as logical no-undo.
       94   define variable mVisCUrentVin as logical no-undo.
       95   if session:batch-mode
       96   then
       97      mBatchMode = yes.
       98   if mBatchMode = ? then do:
       99     mVisCUrentVin = current-window:visible.
      100     mFameOldVis = mFramBachModHandle:visible.
      101     mFramBachModHandle:visible  = yes.
      102     mBatchMode = mFramBachModHandle:visible ne yes.
      103     mFramBachModHandle:visible = mFameOldVis.
      104     current-window:visible = mVisCUrentVin.
      105   end.
      106    if  log-manager:logfile-name ne ?
      107     then DO:
      108         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      109         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      110         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      111     end.
      112   on choose of B-WaitFramStop in frame waitfram
      113   do:
      114     mWaitFramStop = yes.
      115     mWaitFramStopUser = yes.
      116   end.
      117   function waitfram-check-timeout returns logical():
      118      define variable vtime as int64 no-undo.
      119      if mWaitFramStopTimeOut
      120      then
      121         return yes.
      122      vtime = ( now - mWaitFramStartProc ) / 1000 .
      123      if     mWaitFramTimeOut ne ?
      124         and mWaitFramTimeOut ne 0
      125         and mWaitFramTimeOut lt vtime
      126      then do:
      127         mWaitFramStopTimeOut = yes.
      128      end.
      129      return mWaitFramStopTimeOut.
      130   end.
      131   procedure waitfram-hide :
      132     if not session:batch-mode
      133     then do
      134     on error undo, return error return-value
      135     :
      136       pause 0 before-hide .
      137       if not mBatchMode then
      138         hide frame waitfram .
      139     if     not mWaitFramView
      140        and mWaitProcEvent
      141     then
      142       process events .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206       if     mWaitFramView
      207          then do:
      208             if     mWaitFramInterval ne ?
      209                and not mBatchMode
      210             then
      211                wait-for go of frame waitfram pause mWaitFramInterval.
      212          end.
      213          else
      214             if     mWaitProcEvent
      215                and not mBatchMode
      216             then
      217                process events .
      218     end.
      219   end procedure.
      220      procedure waitfram-show-this:
      221         define input  parameter iInterval as int64 no-undo.
      222         define variable vtime as int64 no-undo.
      223         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      224         mWaitFramInterval = iInterval.
      225         run waitfram-show (substitute("&1&2 &3&4" ,
      226                                       mWaitFramTextBeg ,
      227                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      228                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      229                                       mWaitFramTextEnd
      230                                      )
      231                           ).
      232      end.
      233      procedure WaitFramRunPause:
      234         define input  parameter iInterval as dec no-undo.
      235         define variable vStart  as datetime-tz no-undo.
      236         define variable vend    as datetime-tz no-undo.
      237         define variable vint as int64 no-undo.
      238         define variable vOk as logical no-undo.
      239         vStart = now.
      240         vend   = vStart.
      241         publish "WaitFramPause" (iInterval,output vOk).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and (   vint > 0
      247                 or (    not vOk
      248                     and iInterval eq ?
      249                     )
      250                 )
      251         then
      252            run waitfram-show-this (iInterval).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and vint > 0
      258         then do:
      259            run gbl/pause.p (vint * 1000).
      260         end.
      261         if iInterval ne ?
      262         then
      263            publish "WaitFramStop".
      264         waitfram-check-timeout().
      265      end.
      266      procedure WaitFramWaitFor:
      267         define input  parameter iInterval as dec no-undo.
      268         assign
      269            mWaitFramStartProc   = now
      270            mWaitFramStopUser    = no
      271            mWaitFramStopTimeOut = no
      272         .
      273         block-wait:
      274         do while not mWaitFramStop:
      275            run WaitFramRunPause (iInterval).
      276            if  waitfram-check-timeout()
      277            then do:
      278               leave block-wait.
      279            end.
      280         end.
      281         run waitfram-hide.
      282      end.
      283   procedure waitfram-join :
      284     define input  parameter p-line-1  as character no-undo .
      285     define input  parameter p-line-2  as character no-undo .
      286     define input  parameter p-line-3  as character no-undo .
      287     define output parameter p-message as character no-undo .
      288     do
      289     on error undo, return error return-value
      290     :
      291       assign
      292         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      295       .
      296     end.
      297   end procedure.
      298   function waitfram-join-function returns character
      299     (input p-line-1 as character
      300     ,input p-line-2 as character
      301     ,input p-line-3 as character
      302     ).
      303     define variable v-message as character no-undo .
      304     run waitfram-join in this-procedure
      305       (input  p-line-1
      306       ,input  p-line-2
      307       ,input  p-line-3
      308       ,output v-message
      309       ) .
      310     return v-message .
      311   end function .
      312   define new global shared variable g#language as character no-undo .
      313   if g#language <> '' and g#language <> 'rus':U then do:
      314     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      315   end.
      316   define new global shared variable g#library  as handle no-undo .
      317   define new global shared variable g#library2 as handle no-undo .
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   define variable v-dr-tables as character no-undo.
      589   define variable v-dr-table-names as character no-undo.
      590   define variable v-sys-key as character no-undo .
      591   define variable v-ibs as logical no-undo .
      592   define variable glog as logical no-undo .
      593   DEFINE BUFFER buf_file FOR dictdb._file.
      594   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER )  FORWARD.
      595   DEFINE BUTTON b-export
      596        LABEL "&Экспорт"
      597        SIZE 10 BY 1.
      598   DEFINE BUTTON B-Help
      599        LABEL "Помо&щь"
      600        SIZE 10 BY 1
      601        BGCOLOR 8 .
      602   DEFINE BUTTON b-quit AUTO-END-KEY
      603        LABEL "&Выход"
      604        SIZE 10 BY 1
      605        BGCOLOR 8 .
      606   DEFINE BUTTON B-sel
      607        LABEL "В&ыбор"
      608        SIZE 10 BY 1.
      609   DEFINE VARIABLE rs-language AS CHARACTER
      610        VIEW-AS RADIO-SET HORIZONTAL
      611        RADIO-BUTTONS
      612             "Item 1", "1",
      613   "Item 2", "2"
      614        SIZE 21 BY 1 NO-UNDO.
      615   DEFINE QUERY br-vrmtables FOR
      616         buf_file SCROLLING.
      617   DEFINE BROWSE br-vrmtables
      618     QUERY br-vrmtables DISPLAY
      619         buf_file._file-name FORMAT "X(32)" COLUMN-LABEL "Таблицы"
      620   get-tbl-fname (buf_file._file-name) FORMAT "X(62)" COLUMN-LABEL "Описание"
      621       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.25 FIT-LAST-COLUMN.
      622   DEFINE FRAME Dialog-Frame
      623        b-quit AT ROW 1 COL 1
      624        B-sel AT ROW 1 COL 21 WIDGET-ID 2
      625        b-export AT ROW 1 COL 48 WIDGET-ID 4
      626        B-Help AT ROW 1 COL 88
      627        rs-language AT ROW 2 COL 33.5 NO-LABEL WIDGET-ID 6
      628        br-vrmtables AT ROW 3 COL 1 WIDGET-ID 100
      629        SPACE(0.69) SKIP(0.02)
      630       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      631            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      632            TITLE "Справочники rule-машины"
      633            CANCEL-BUTTON b-quit.
      634   ASSIGN
      635          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      636          FRAME Dialog-Frame:HIDDEN           = TRUE.
      637   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      638   DO:
      639     APPLY "END-ERROR":U TO SELF.
      640   END.
      641   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      642   DO:
      643   define variable v-file-name as character no-undo .
      644   define variable v-old-file-name as character no-undo .
      645   define variable v-dir-name as character no-undo .
      646   define variable v-yesno as logical no-undo .
      647   define variable v-mode-log as logical no-undo .
      648   define variable v-mode as character no-undo .
      649   message
      650   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
      651   view-as alert-box question buttons yes-no-cancel update v-mode-log.
      652   if v-mode-log = ? then return no-apply.
      653   if v-mode-log then do:
      654     v-mode = "full".
      655   end.
      656   message
      657   "Хотите экспортировать ПОЛНУЮ конфигурацию правил скидок" skip
      658   "или только измененные записи?"
      659   view-as alert-box question buttons yes-no-cancel update v-yesno.
      660   if v-yesno = ? then return no-apply.
      661   if v-yesno = no then do:
      662     run gbl/d-file.p (
      663           input-output v-old-file-name
      664         , input-output v-dir-name
      665         , input  (" Все файлы txt (*.txt) ")
      666         , input  ("*.txt":U)
      667         , input  chr(44)
      668         , input  (".txt":U)
      669         , input  yes
      670         , input  no
      671         , input  yes
      672         , input  "Введите имя старого файла (для сравнения)"
      673         , output v-yesno
      674     ) no-error.
      675     if error-status:error
      676     or v-yesno = no then return no-apply.
      677   end.
      678   v-yesno = no.
      679     run gbl/d-file.p (
      680           input-output v-file-name
      681         , input-output v-dir-name
      682         , input  (" Все файлы txt (*.txt) ")
      683         , input  ("*.txt":U)
      684         , input  chr(44)
      685         , input  (".txt":U)
      686         , input  no
      687         , input  yes
      688         , input  yes
      689         , input  "Введите имя файла для экспорта"
      690         , output v-yesno
      691     ) no-error.
      692     if error-status:error
      693     or v-yesno = no then return no-apply.
      694     run utl/exdisrul.p (
      695                                    input v-file-name
      696                                   ,input v-old-file-name
      697                                   ,input v-mode
      698                                  ) NO-ERROR.
      699     IF ERROR-STATUS:ERROR THEN DO:
      700        MESSAGE
      701        ERROR-STATUS:GET-MESSAGE(1) SKIP
      702        RETURN-VALUE
      703        VIEW-AS ALERT-BOX.
      704        RETURN NO-APPLY.
      705     END.
      706     define variable v-md5-signature as character no-undo .
      707     define variable v-full-file-name          as character                no-undo .
      708     define variable v-path                    as character                no-undo .
      709     DEFINE VARIABLE v-full-path               as character                no-undo .
      710     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      711     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      712     run gbl/md5.p ( input v-file-name
      713                    ,output v-md5-signature ) .
      714     run gbl/filename.p (
      715                    input v-file-name
      716                   ,output v-full-path
      717                   ,output v-path
      718                   ,output v-full-file-name
      719                   ,output v-file-name-no-ext
      720                   ,output v-file-name-ext
      721                   ) no-error .
      722     if error-status:error then do:
      723       message
      724       return-value
      725       view-as alert-box ERROR.
      726       return.
      727     end.
      728     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      729     put unformatted v-md5-signature skip.
      730     output close.
      731   END.
      732   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      733   DO:
      734     run proc-b-sel IN THIS-PROCEDURE NO-ERROR.
      735     IF ERROR-STATUS:ERROR THEN DO:
      736        RETURN NO-APPLY.
      737     END.
      738   END.
      739   ON DEFAULT-ACTION OF br-vrmtables IN FRAME Dialog-Frame
      740   DO:
      741     APPLY "CHOOSE" TO b-sel.
      742   END.
      743   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      744   DO:
      745     ASSIGN
      746     rs-language.
      747     CASE rs-language:
      748       WHEN "ABL" THEN DO:
      749         buf_file._file-name:VISIBLE IN BROWSE br-vrmtables = YES.
      750       END.
      751       WHEN "rus" THEN DO:
      752         buf_file._file-name:VISIBLE IN BROWSE br-vrmtables = NO.
      753       END.
      754     END CASE.
      755   END.
      756   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      757   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      758   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   on help of frame Dialog-Frame
      760   do:
      761     run gbl/app_help.p
      762       (input this-procedure :file-name
      763       ,input ''
      764       ,input ?
      765       ) no-error.
      766     if error-status :error then do:
      767       message
      768         "Ошибка при вызове помощи"
      769         error-status :get-message(1)
      770         view-as alert-box .
      771     end.
      772   end.
      773   run minbtn-set in this-procedure .
      774   on choose of b-help in frame Dialog-Frame
      775   do:
      776     apply "help":u to frame Dialog-Frame .
      777   end.
      778   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   procedure minbtn-set :
      780       do
      781           on error undo, return error return-value
      782           :
      783           define variable ii              as integer       no-undo .
      784           define variable fh              as widget-handle no-undo .
      785           define variable hh              as widget-handle no-undo .
      786           define variable v-h             as handle        extent 4 no-undo .
      787           define variable v-name-button   as character     no-undo .
      788           define variable v-help-old-x    as decimal       no-undo .
      789           define variable v-help-old-y    as decimal       no-undo .
      790           define variable v-help-old-size as decimal       no-undo .
      791           define variable v-frame-width   as decimal       no-undo .
      792           define variable jj              as integer       no-undo .
      793           do
      794               on error undo, return error
      795               :
      796               assign
      797                   v-frame-width = frame Dialog-Frame:width - 0.3
      798                   fh            = frame Dialog-Frame:first-child
      799                   hh            = fh:first-child
      800                   ii            = 1
      801                   .
      802               do while valid-handle(hh):
      803                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      804                   do:
      805                       case lc(hh:name) :
      806                           when "b-help" then
      807                               do:
      808                                   hh:load-image-up("cmp/b-help.bmp":u) .
      809                                   hh:load-image-down("cmp/b-help.bmp":u) .
      810                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      811                                   hh:TOOLTIP = "Помощь" .
      812                                   v-help-old-x = hh:column .
      813                                   v-help-old-y = hh:row    .
      814                                   v-help-old-size = hh:width .
      815                                   hh:width-chars = 2.5 .
      816                               end.
      817                           when "b-print" then
      818                               do:
      819                                   hh:load-image("cmp/b-print.bmp":u) .
      820                                   hh:TOOLTIP = "Печать" .
      821                                   v-h[ii] = hh:handle .
      822                                   ii = ii + 1 .
      823                                   hh:width-chars = 3 .
      824                               end.
      825                           when "b-history" or
      826                           when "b-hist" then
      827                               do:
      828                                   hh:load-image("cmp/b-hist.bmp":u) .
      829                                   hh:TOOLTIP = "История" .
      830                                   v-h[ii] = hh:handle .
      831                                   ii = ii + 1 .
      832                                   hh:width-chars = 3 .
      833                               end.
      834                           when "b-sch" then
      835                               do:
      836                                   hh:load-image("cmp/b-sch.bmp":u) .
      837                                   hh:TOOLTIP = "Установка Фильтра" .
      838                                   v-h[ii] = hh:handle .
      839                                   ii = ii + 1 .
      840                                   hh:width-chars = 3 .
      841                               end.
      842                           when "b-hist-user" then
      843                               do:
      844                                   hh:load-image("cmp/b-hist.bmp":u) .
      845                                   hh:TOOLTIP = "История пользователя" .
      846                                   ii = ii + 1 .
      847                               end.
      848                       end case.
      849                   end.
      850                   hh = hh:next-sibling.
      851               end.
      852               b-help:column = v-frame-width - b-help:width-chars.
      853               jj = 0.
      854               repeat ii = 4 to 1 by -1 :
      855                   if valid-handle (v-h[ii] ) then
      856                   do:
      857                       jj  = jj + 1 .
      858                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      859                       v-h[ii]:row    = v-help-old-y .
      860                   end.
      861               end.
      862           end.
      863       end.
      864   end procedure.
      865   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      866   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      867   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      868   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      869   define variable v-diasize-current-frame-width  as decimal   no-undo .
      870   define variable v-diasize-current-frame-height as decimal   no-undo .
      871   define variable v-diasize-change-size          as logical   no-undo .
      872   define variable v-diasize-resize-button        as handle    no-undo .
      873   define variable v-diasize-wndmax               as logical   no-undo .
      874   define variable v-diasize-wndstore             as logical   no-undo .
      875   define variable v-diasize-proc-name            as character no-undo .
      876   define variable v-diasize-browse-handle        as handle    no-undo .
      877   define variable v-diasize-browse-number        as integer   no-undo .
      878   define variable v-diasize-need-full-display    as logical   no-undo init false .
      879   define temp-table temp-diasize-handle no-undo
      880     field handle-value  as handle
      881     field save-position as decimal
      882     index xpk is primary unique handle-value
      883     .
      884   define temp-table temp-browse-handle no-undo
      885     field browse-type   as character
      886     field browse-number as integer
      887     field browse-handle as handle
      888     field original-size as decimal
      889     index xpk is primary unique browse-type browse-number
      890     index xie browse-type browse-handle
      891   .
      892   procedure diasize_change-height :
      893     define input  parameter p-change-value  as decimal   no-undo .
      894     define input  parameter p-move-resize   as logical   no-undo .
      895     define variable v-field-group-handle    as handle    no-undo .
      896     define variable v-object-handle         as handle    no-undo .
      897     define variable v-frame-height          as decimal   no-undo .
      898     define variable v-frame-virtual-height  as decimal   no-undo .
      899     define variable v-browse-height         as decimal   no-undo .
      900     define variable v-window-height         as decimal   no-undo .
      901     define variable v-window-virtual-height as decimal   no-undo .
      902     define variable v-change-sign           as integer   no-undo .
      903     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      904     define buffer buf_temp-browse-handle  for temp-browse-handle .
      905     if p-change-value > 0
      906     then do:
      907       if frame Dialog-Frame :height + p-change-value
      908           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      909       then do:
      910         assign
      911           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      912                           - (frame Dialog-Frame :height-chars)
      913         .
      914         if p-change-value <= 0
      915         then do:
      916           run diasize_position-resize-button in this-procedure .
      917           return .
      918         end.
      919       end.
      920     end.
      921     if p-change-value < 0
      922     then do:
      923       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      924       then do:
      925         assign
      926           p-change-value = v-diasize-orig-frame-height
      927                          - (frame Dialog-Frame :height-chars)
      928         .
      929         if p-change-value >= 0
      930         then do:
      931           run diasize_position-resize-button in this-procedure .
      932           return .
      933         end.
      934       end.
      935     end.
      936     if p-change-value >= 0
      937     then do:
      938       assign
      939         v-change-sign = 1
      940       .
      941     end.
      942     else do:
      943       assign
      944         v-change-sign = -1
      945       .
      946     end.
      947     assign
      948       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      949     .
      950     if p-change-value = 0
      951     then do:
      952       run diasize_position-resize-button in this-procedure .
      953       return .
      954     end.
      955     move_block:
      956     do
      957     on error undo move_block, retry move_block
      958     :
      959       if retry
      960       then do:
      961         do
      962         on error undo move_block, leave move_block
      963         :
      964           if p-change-value > 0
      965           then do:
      966             for each buf_temp-diasize-handle
      967             on error undo, next
      968             :
      969               assign
      970                 v-object-handle = buf_temp-diasize-handle.handle-value
      971               .
      972               if v-object-handle <> v-diasize-resize-button
      973               then do:
      974                 assign
      975                   v-object-handle :row = buf_temp-diasize-handle.save-position
      976                 .
      977               end.
      978             end.
      979             assign
      980               v-diasize-browse-handle :height = v-browse-height
      981             .
      982             for each buf_temp-browse-handle
      983               where buf_temp-browse-handle.browse-type = 'height':u
      984             on error undo, next
      985             :
      986               assign
      987                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      988               .
      989             end.
      990             assign
      991               frame Dialog-Frame :height = v-frame-height
      992             .
      993             if frame Dialog-Frame :scrollable = true
      994             then do:
      995               assign
      996                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      997               .
      998             end.
      999             run diasize_position-resize-button in this-procedure .
     1000           end.
     1001           else do:
     1002             if frame Dialog-Frame :scrollable = true
     1003             then do:
     1004               assign
     1005                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1006               .
     1007             end.
     1008             assign
     1009               frame Dialog-Frame :height = v-frame-height
     1010             .
     1011             assign
     1012               v-diasize-browse-handle :height = v-browse-height
     1013             .
     1014             for each buf_temp-browse-handle
     1015               where buf_temp-browse-handle.browse-type = 'height':u
     1016             on error undo, next
     1017             :
     1018               assign
     1019                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1020               .
     1021             end.
     1022             for each buf_temp-diasize-handle
     1023             on error undo, next
     1024             :
     1025               assign
     1026                 v-object-handle = buf_temp-diasize-handle.handle-value
     1027               .
     1028               if v-object-handle <> v-diasize-resize-button
     1029               then do:
     1030                 assign
     1031                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1032                 .
     1033               end.
     1034             end.
     1035             run diasize_position-resize-button in this-procedure .
     1036           end.
     1037           assign
     1038             v-diasize-change-size = false
     1039           .
     1040           leave move_block .
     1041         end.
     1042       end.
     1043       assign
     1044         v-diasize-need-full-display = true
     1045       .
     1046       if v-diasize-change-size = false
     1047       then do:
     1048         assign
     1049           v-diasize-change-size = true
     1050         .
     1051       end.
     1052       else do:
     1053         return .
     1054       end.
     1055       assign
     1056         v-frame-height = frame Dialog-Frame :height
     1057         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1058         v-browse-height = v-diasize-browse-handle :height
     1059       .
     1060       for each buf_temp-browse-handle
     1061         where buf_temp-browse-handle.browse-type = 'height':u
     1062       :
     1063         assign
     1064           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1065         .
     1066       end.
     1067       for each buf_temp-diasize-handle
     1068       :
     1069         delete buf_temp-diasize-handle .
     1070       end.
     1071       assign
     1072         v-field-group-handle = frame Dialog-Frame :first-child
     1073       .
     1074       do while valid-handle(v-field-group-handle)
     1075       :
     1076         assign
     1077           v-object-handle = v-field-group-handle :first-child
     1078         .
     1079         do while valid-handle(v-object-handle)
     1080         :
     1081           if  v-object-handle <> v-diasize-browse-handle :handle
     1082           and can-query(v-object-handle, "row")
     1083           and can-query(v-object-handle, "height")
     1084           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1085           then do:
     1086             find first buf_temp-browse-handle
     1087               where buf_temp-browse-handle.browse-type   = 'height':u
     1088                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1089               no-error .
     1090             if available buf_temp-browse-handle
     1091             then do:
     1092             end.
     1093             else do:
     1094               create buf_temp-diasize-handle .
     1095               assign
     1096                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1097                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1098               .
     1099             end.
     1100           end.
     1101           assign
     1102             v-object-handle = v-object-handle :next-sibling
     1103           .
     1104         end.
     1105         assign
     1106           v-field-group-handle = v-field-group-handle :next-sibling
     1107         .
     1108       end.
     1109       do with frame Dialog-Frame
     1110       :
     1111         hide v-diasize-resize-button .
     1112         assign
     1113           v-diasize-resize-button :row    = 1
     1114           v-diasize-resize-button :column = 1
     1115         .
     1116       end.
     1117       if p-change-value > 0
     1118       then do:
     1119         if frame Dialog-Frame :scrollable = true
     1120         then do:
     1121           assign
     1122             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1123             no-error .
     1124           if error-status :error
     1125           or error-status :get-message(1) <> ""
     1126           then do:
     1127             undo move_block, retry move_block .
     1128           end.
     1129         end.
     1130         assign
     1131           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1132           no-error .
     1133         if error-status :error
     1134         or error-status :get-message(1) <> ""
     1135         then do:
     1136           undo move_block, retry move_block .
     1137         end.
     1138         assign
     1139           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1140           no-error .
     1141         if error-status :error
     1142         or error-status :get-message(1) <> ""
     1143         then do:
     1144           undo move_block, retry move_block .
     1145         end.
     1146         for each buf_temp-browse-handle
     1147           where buf_temp-browse-handle.browse-type = 'height':u
     1148         on error undo move_block, retry move_block
     1149         :
     1150           assign
     1151             buf_temp-browse-handle.browse-handle :height
     1152               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1153             no-error .
     1154           if error-status :error
     1155           or error-status :get-message(1) <> ""
     1156           then do:
     1157             undo move_block, retry move_block .
     1158           end.
     1159         end.
     1160         for each buf_temp-diasize-handle
     1161         on error undo move_block, retry move_block
     1162         :
     1163           assign
     1164             v-object-handle = buf_temp-diasize-handle.handle-value
     1165           .
     1166           if v-object-handle <> v-diasize-resize-button
     1167           then do:
     1168             assign
     1169               v-object-handle :row = v-object-handle :row + p-change-value
     1170               no-error .
     1171             if error-status :error
     1172             or error-status :get-message(1) <> ""
     1173             then do:
     1174               undo move_block, retry move_block .
     1175             end.
     1176           end.
     1177         end.
     1178       end.
     1179       else do:
     1180         for each buf_temp-diasize-handle
     1181         on error undo move_block, retry move_block
     1182         :
     1183           assign
     1184             v-object-handle = buf_temp-diasize-handle.handle-value
     1185           .
     1186           if v-object-handle <> v-diasize-resize-button
     1187           then do:
     1188             assign
     1189               v-object-handle :row = v-object-handle :row + p-change-value
     1190               no-error .
     1191             if error-status :error
     1192             or error-status :get-message(1) <> ""
     1193             then do:
     1194               undo move_block, retry move_block .
     1195             end.
     1196           end.
     1197         end.
     1198         assign
     1199           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1200           no-error .
     1201         if error-status :error
     1202         or error-status :get-message(1) <> ""
     1203         then do:
     1204           undo move_block, retry move_block .
     1205         end.
     1206         for each buf_temp-browse-handle
     1207           where buf_temp-browse-handle.browse-type = 'height':u
     1208         on error undo move_block, retry move_block
     1209         :
     1210           assign
     1211             buf_temp-browse-handle.browse-handle :height
     1212               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1213             no-error .
     1214           if error-status :error
     1215           or error-status :get-message(1) <> ""
     1216           then do:
     1217             undo move_block, retry move_block .
     1218           end.
     1219         end.
     1220         assign
     1221           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1222           no-error .
     1223         if error-status :error
     1224         or error-status :get-message(1) <> ""
     1225         then do:
     1226           undo move_block, retry move_block .
     1227         end.
     1228         if frame Dialog-Frame :scrollable = true
     1229         then do:
     1230           assign
     1231             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1232             no-error .
     1233           if error-status :error
     1234           or error-status :get-message(1) <> ""
     1235           then do:
     1236             undo move_block, retry move_block .
     1237           end.
     1238         end.
     1239       end.
     1240       if p-move-resize = true
     1241       then do:
     1242         run diasize_position-resize-button in this-procedure .
     1243       end.
     1244       if v-diasize-wndstore = true
     1245       then do:
     1246         if connected("ub") = true
     1247         then do:
     1248           define variable v-cntxt-db-num        as integer   no-undo .
     1249           define variable v-cntxt-userid        as character no-undo .
     1250           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1251                                             , OUTPUT v-cntxt-userid
     1252                                             ) .
     1253           run gbl/wndsizew.p
     1254             (input  v-cntxt-db-num
     1255             ,input  v-cntxt-userid
     1256             ,input  v-diasize-proc-name
     1257             ,input  'height':u
     1258             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1259             ) .
     1260         end.
     1261       end.
     1262     end.
     1263     assign
     1264       v-diasize-change-size = false
     1265     .
     1266   end procedure.
     1267   procedure diasize_set-height :
     1268     define input  parameter p-new-height  as decimal   no-undo .
     1269     define input  parameter p-move-resize as logical   no-undo .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       run diasize_change-height in this-procedure
     1274         (input  (p-new-height - frame Dialog-Frame :height)
     1275         ,input  p-move-resize
     1276         ) .
     1277     end.
     1278   end procedure.
     1279   procedure diasize_change-width :
     1280     define input  parameter p-change-value as decimal   no-undo .
     1281     define input  parameter p-move-resize  as logical   no-undo .
     1282     define variable v-field-group-handle   as handle    no-undo .
     1283     define variable v-object-handle        as handle    no-undo .
     1284     define variable v-frame-width          as decimal   no-undo .
     1285     define variable v-frame-virtual-width  as decimal   no-undo .
     1286     define variable v-browse-width         as decimal   no-undo .
     1287     define variable v-window-width         as decimal   no-undo .
     1288     define variable v-window-virtual-width as decimal   no-undo .
     1289     define variable v-change-sign          as integer   no-undo .
     1290     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1291     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1292     if p-change-value > 0
     1293     then do:
     1294       if frame Dialog-Frame :width + p-change-value >
     1295           session :width-chars
     1296       then do:
     1297         assign
     1298           p-change-value = session :width-chars - frame Dialog-Frame :width
     1299         .
     1300         if p-change-value <= 0
     1301         then do:
     1302           run diasize_position-resize-button in this-procedure .
     1303           return .
     1304         end.
     1305       end.
     1306     end.
     1307     if p-change-value < 0
     1308     then do:
     1309       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1310       then do:
     1311         assign
     1312           p-change-value = v-diasize-orig-frame-width
     1313                          - frame Dialog-Frame :width
     1314         .
     1315         if p-change-value >= 0
     1316         then do:
     1317           run diasize_position-resize-button in this-procedure .
     1318           return .
     1319         end.
     1320       end.
     1321     end.
     1322     if p-change-value >= 0
     1323     then do:
     1324       assign
     1325         v-change-sign = 1
     1326       .
     1327     end.
     1328     else do:
     1329       assign
     1330         v-change-sign = -1
     1331       .
     1332     end.
     1333     assign
     1334       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1335     .
     1336     if p-change-value = 0
     1337     then do:
     1338       run diasize_position-resize-button in this-procedure .
     1339       return .
     1340     end.
     1341     move_block:
     1342     do
     1343     on error undo move_block, leave move_block
     1344     :
     1345       if retry
     1346       then do:
     1347         do
     1348         on error undo move_block, leave move_block
     1349         :
     1350           if p-change-value > 0
     1351           then do:
     1352             for each buf_temp-diasize-handle
     1353             on error undo, next
     1354             :
     1355               assign
     1356                 v-object-handle = buf_temp-diasize-handle.handle-value
     1357               .
     1358               if v-object-handle <> v-diasize-resize-button
     1359               then do:
     1360                 assign
     1361                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1362                 .
     1363               end.
     1364             end.
     1365             assign
     1366               v-diasize-browse-handle :width = v-browse-width
     1367             .
     1368             for each buf_temp-browse-handle
     1369               where buf_temp-browse-handle.browse-type = 'width':u
     1370             on error undo, next
     1371             :
     1372               assign
     1373                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1374               .
     1375             end.
     1376             assign
     1377               frame Dialog-Frame :width = v-frame-width
     1378             .
     1379             if frame Dialog-Frame :scrollable = true
     1380             then do:
     1381               assign
     1382                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1383               .
     1384             end.
     1385             run diasize_position-resize-button in this-procedure .
     1386           end.
     1387           else do:
     1388             if frame Dialog-Frame :scrollable = true
     1389             then do:
     1390               assign
     1391                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1392               .
     1393             end.
     1394             assign
     1395               frame Dialog-Frame :width = v-frame-width
     1396             .
     1397             for each buf_temp-browse-handle
     1398               where buf_temp-browse-handle.browse-type = 'width':u
     1399             on error undo, next
     1400             :
     1401               assign
     1402                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1403               .
     1404             end.
     1405             assign
     1406               v-diasize-browse-handle :width = v-browse-width
     1407             .
     1408             for each buf_temp-diasize-handle
     1409             on error undo, next
     1410             :
     1411               assign
     1412                 v-object-handle = buf_temp-diasize-handle.handle-value
     1413               .
     1414               if v-object-handle <> v-diasize-resize-button
     1415               then do:
     1416                 assign
     1417                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1418                 .
     1419               end.
     1420             end.
     1421             run diasize_position-resize-button in this-procedure .
     1422           end.
     1423           assign
     1424             v-diasize-change-size = false
     1425           .
     1426           leave move_block .
     1427         end.
     1428       end.
     1429       assign
     1430         v-diasize-need-full-display = true
     1431       .
     1432       if v-diasize-change-size = false
     1433       then do:
     1434         assign
     1435           v-diasize-change-size = true
     1436         .
     1437       end.
     1438       else do:
     1439         return .
     1440       end.
     1441       assign
     1442         v-frame-width = frame Dialog-Frame :width
     1443         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1444         v-browse-width = v-diasize-browse-handle :width
     1445       .
     1446       for each buf_temp-browse-handle
     1447         where buf_temp-browse-handle.browse-type = 'width':u
     1448       :
     1449         assign
     1450           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1451         .
     1452       end.
     1453       for each buf_temp-diasize-handle
     1454       :
     1455         delete buf_temp-diasize-handle .
     1456       end.
     1457       assign
     1458         v-field-group-handle = frame Dialog-Frame :first-child
     1459       .
     1460       do while valid-handle(v-field-group-handle)
     1461       :
     1462         assign
     1463           v-object-handle = v-field-group-handle :first-child
     1464         .
     1465         do while valid-handle(v-object-handle)
     1466         :
     1467           if  v-object-handle <> v-diasize-browse-handle :handle
     1468           and v-object-handle <> v-diasize-resize-button
     1469           and can-query(v-object-handle, "row")
     1470           and can-query(v-object-handle, "height")
     1471           and ( v-object-handle :col + v-object-handle :width
     1472                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1473               )
     1474           then do:
     1475             find first buf_temp-browse-handle
     1476               where buf_temp-browse-handle.browse-type   = 'width':u
     1477                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1478               no-error .
     1479             if available buf_temp-browse-handle
     1480             then do:
     1481             end.
     1482             else do:
     1483               create buf_temp-diasize-handle .
     1484               assign
     1485                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1486                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1487               .
     1488             end.
     1489           end.
     1490           assign
     1491             v-object-handle = v-object-handle :next-sibling
     1492           .
     1493         end.
     1494         assign
     1495           v-field-group-handle = v-field-group-handle :next-sibling
     1496         .
     1497       end.
     1498       do with frame Dialog-Frame
     1499       :
     1500         hide v-diasize-resize-button .
     1501         v-diasize-resize-button :row = 1.
     1502         v-diasize-resize-button :column = 1.
     1503       end.
     1504       if p-change-value > 0
     1505       then do:
     1506         if frame Dialog-Frame :scrollable = true
     1507         then do:
     1508           assign
     1509             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1510             no-error .
     1511           if error-status :error
     1512           or error-status :get-message(1) <> ""
     1513           then do:
     1514             undo move_block, retry move_block.
     1515           end.
     1516         end.
     1517         assign
     1518           frame Dialog-Frame :width = v-frame-width + p-change-value
     1519           no-error .
     1520         if error-status :error
     1521         or error-status :get-message(1) <> ""
     1522         then do:
     1523           undo move_block, retry move_block.
     1524         end.
     1525         assign
     1526           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1527         no-error .
     1528         if error-status :error
     1529         or error-status :get-message(1) <> ""
     1530         then do:
     1531           undo move_block, retry move_block.
     1532         end.
     1533         for each buf_temp-browse-handle
     1534           where buf_temp-browse-handle.browse-type = 'width':u
     1535         on error undo move_block, retry move_block
     1536         :
     1537           assign
     1538             buf_temp-browse-handle.browse-handle :width
     1539               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1540             no-error .
     1541           if error-status :error
     1542           or error-status :get-message(1) <> ""
     1543           then do:
     1544             undo move_block, retry move_block .
     1545           end.
     1546         end.
     1547         for each buf_temp-diasize-handle
     1548         on error undo move_block, retry move_block
     1549         :
     1550           assign
     1551             v-object-handle = buf_temp-diasize-handle.handle-value
     1552           .
     1553           if v-object-handle <> v-diasize-resize-button
     1554           then do:
     1555             assign
     1556               v-object-handle :col = v-object-handle :col + p-change-value
     1557               no-error .
     1558             if error-status :error
     1559             or error-status :get-message(1) <> ""
     1560             then do:
     1561               undo move_block, retry move_block .
     1562             end.
     1563           end.
     1564         end.
     1565       end.
     1566       else do:
     1567         for each buf_temp-diasize-handle
     1568         on error undo move_block, retry move_block
     1569         :
     1570           assign
     1571             v-object-handle = buf_temp-diasize-handle.handle-value
     1572           .
     1573           if v-object-handle <> v-diasize-resize-button
     1574           then do:
     1575             assign
     1576               v-object-handle :col = v-object-handle :col + p-change-value
     1577               no-error .
     1578             if error-status :error
     1579             or error-status :get-message(1) <> ""
     1580             then do:
     1581               undo move_block, retry move_block .
     1582             end.
     1583           end.
     1584         end.
     1585         for each buf_temp-browse-handle
     1586           where buf_temp-browse-handle.browse-type = 'width':u
     1587         on error undo move_block, retry move_block
     1588         :
     1589           assign
     1590             buf_temp-browse-handle.browse-handle :width
     1591               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1592             no-error .
     1593           if error-status :error
     1594           or error-status :get-message(1) <> ""
     1595           then do:
     1596             undo move_block, retry move_block .
     1597           end.
     1598         end.
     1599         assign
     1600           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1601           no-error .
     1602         if error-status :error
     1603         or error-status :get-message(1) <> ""
     1604         then do:
     1605           undo move_block, retry move_block.
     1606         end.
     1607         assign
     1608           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1609         no-error .
     1610         if error-status :error
     1611         or error-status :get-message(1) <> ""
     1612         then do:
     1613           undo move_block, retry move_block.
     1614         end.
     1615         if frame Dialog-Frame :scrollable = true
     1616         then do:
     1617           assign
     1618             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1619           no-error .
     1620           if error-status :error
     1621           or error-status :get-message(1) <> ""
     1622           then do:
     1623             undo move_block, retry move_block.
     1624           end.
     1625         end.
     1626       end.
     1627       if p-move-resize
     1628       then do:
     1629         run diasize_position-resize-button in this-procedure .
     1630       end.
     1631       if v-diasize-wndstore = true
     1632       then do:
     1633         if connected("ub") = true
     1634         then do:
     1635           define variable v-cntxt-db-num        as integer   no-undo .
     1636           define variable v-cntxt-userid        as character no-undo .
     1637           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1638                                             , OUTPUT v-cntxt-userid
     1639                                             ) .
     1640           run gbl/wndsizew.p
     1641             (input  v-cntxt-db-num
     1642             ,input  v-cntxt-userid
     1643             ,input  v-diasize-proc-name
     1644             ,input  'width':u
     1645             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1646             ) .
     1647         end.
     1648       end.
     1649     end.
     1650     assign
     1651       v-diasize-change-size = false
     1652     .
     1653   end procedure.
     1654   procedure diasize_set-width :
     1655     define input  parameter p-new-width  as decimal   no-undo .
     1656     define input  parameter p-move-resize as logical   no-undo .
     1657     do
     1658     on error undo, return error return-value
     1659     :
     1660       run diasize_change-width in this-procedure
     1661         (input  (p-new-width - frame Dialog-Frame :width)
     1662         ,input  p-move-resize
     1663         ) .
     1664     end.
     1665   end procedure.
     1666   procedure diasize_position-resize-button :
     1667     do with frame Dialog-Frame
     1668     :
     1669       hide v-diasize-resize-button .
     1670       assign
     1671         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1672                     - 1
     1673                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1674         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1675                     - 1
     1676                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1677       .
     1678       view v-diasize-resize-button .
     1679     end.
     1680   end procedure.
     1681   on alt-right anywhere
     1682   do:
     1683     run diasize_change-width in this-procedure
     1684       (input 1
     1685       ,input true
     1686       ) .
     1687     return no-apply .
     1688   end.
     1689   on alt-left anywhere
     1690   do:
     1691     run diasize_change-width in this-procedure
     1692       (input -1
     1693       ,input true
     1694       ) .
     1695     return no-apply .
     1696   end.
     1697   on alt-down anywhere
     1698   do:
     1699     run diasize_change-height in this-procedure
     1700       (input 1
     1701       ,input true
     1702       ) .
     1703     return no-apply .
     1704   end.
     1705   on alt-up anywhere
     1706   do:
     1707     run diasize_change-height in this-procedure
     1708       (input -1
     1709       ,input true
     1710       ) .
     1711     return no-apply .
     1712   end.
     1713   on alt-enter of frame Dialog-Frame
     1714   do:
     1715     run diasize_maximize in this-procedure
     1716       (input  ?
     1717       ).
     1718     return no-apply .
     1719   end.
     1720   procedure diasize_end-move :
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       define variable v-row-delta as decimal   no-undo .
     1725       define variable v-col-delta as decimal   no-undo .
     1726       define variable v-new-row as decimal   no-undo .
     1727       define variable v-new-col as decimal   no-undo .
     1728       assign
     1729         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1730         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1731       .
     1732       assign
     1733         v-row-delta = v-new-row - frame Dialog-Frame :height
     1734         v-col-delta = v-new-col - frame Dialog-Frame :width
     1735       .
     1736       run diasize_change-height in this-procedure
     1737         (input v-row-delta
     1738         ,input true
     1739         ) .
     1740       run diasize_change-width in this-procedure
     1741         (input v-col-delta
     1742         ,input true
     1743         ) .
     1744     end.
     1745   end procedure.
     1746   procedure diasize_maximize :
     1747     define input  parameter p-action as logical   no-undo .
     1748     do
     1749     on error undo, return error return-value
     1750     :
     1751       if p-action = ?
     1752       then do:
     1753         if v-diasize-need-maximize = true
     1754         then do:
     1755           assign
     1756             p-action = true
     1757           .
     1758         end.
     1759         else do:
     1760           assign
     1761             p-action = false
     1762           .
     1763         end.
     1764       end.
     1765       if p-action = true
     1766       then do:
     1767         run diasize_change-height in this-procedure
     1768           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1769               - frame Dialog-Frame :height-chars
     1770           ,input true
     1771           ) .
     1772         run diasize_change-width in this-procedure
     1773           (input session :width-chars
     1774               - frame Dialog-Frame :width-chars
     1775           ,input true
     1776           ) .
     1777         assign
     1778           v-diasize-need-maximize = false
     1779         .
     1780       end.
     1781       else do:
     1782         run diasize_change-width in this-procedure
     1783           (input v-diasize-orig-frame-width
     1784               - frame Dialog-Frame :width-chars
     1785           ,input true
     1786           ) .
     1787         run diasize_change-height in this-procedure
     1788           (input v-diasize-orig-frame-height
     1789               - frame Dialog-Frame :height-chars
     1790           ,input true
     1791           ) .
     1792         assign
     1793           v-diasize-need-maximize = true
     1794         .
     1795       end.
     1796     end.
     1797   end procedure.
     1798   procedure diasize_restore-orig-size :
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802       assign
     1803         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1804         v-diasize-current-frame-height = frame Dialog-Frame :height
     1805       .
     1806       run diasize_set-height in this-procedure
     1807         (input  v-diasize-orig-frame-height
     1808         ,input  true
     1809         ) .
     1810       run diasize_set-width in this-procedure
     1811         (input  v-diasize-orig-frame-width
     1812         ,input  true
     1813         ) .
     1814     end.
     1815   end procedure.
     1816   procedure diasize_restore-current-size :
     1817     do
     1818     on error undo, return error return-value
     1819     :
     1820       run diasize_set-height in this-procedure
     1821         (input  v-diasize-current-frame-height
     1822         ,input  true
     1823         ) .
     1824       run diasize_set-width in this-procedure
     1825         (input  v-diasize-current-frame-width
     1826         ,input  true
     1827         ) .
     1828     end.
     1829   end procedure.
     1830   procedure diasize_set-browse-handle :
     1831     define input  parameter p-browse-handle as handle   no-undo .
     1832     define buffer buf_temp-browse-handle for temp-browse-handle .
     1833     do
     1834     on error undo, return error return-value
     1835     :
     1836       assign
     1837         v-diasize-browse-handle = p-browse-handle
     1838       .
     1839       for each buf_temp-browse-handle
     1840       on error undo, return error return-value
     1841       :
     1842         delete buf_temp-browse-handle .
     1843       end.
     1844     end.
     1845   end procedure.
     1846   procedure diasize_add_browse :
     1847     define input  parameter p-browse-type   as character no-undo .
     1848     define input  parameter p-browse-handle as handle    no-undo .
     1849     define buffer buf_temp-browse-handle for temp-browse-handle .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       assign
     1854         v-diasize-browse-number = v-diasize-browse-number + 1
     1855       .
     1856       create buf_temp-browse-handle .
     1857       assign
     1858         buf_temp-browse-handle.browse-type   = p-browse-type
     1859         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1860         buf_temp-browse-handle.browse-handle = p-browse-handle
     1861       .
     1862     end.
     1863   end procedure.
     1864   procedure diasize_init :
     1865     define variable v-default-value    as logical   no-undo .
     1866     define variable v-restore-saved    as logical   no-undo .
     1867     define variable v-resize-value-str as character no-undo .
     1868     do
     1869     on error undo, return error return-value
     1870     :
     1871       do with frame Dialog-Frame
     1872       :
     1873         assign
     1874           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1875           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1876           v-diasize-browse-handle     = browse br-vrmtables :handle
     1877         .
     1878         create button v-diasize-resize-button
     1879         assign
     1880           parent        = frame Dialog-Frame :first-child
     1881           label         = "s"
     1882           height-pixels = 16
     1883           width-pixels  = 16
     1884           visible       = true
     1885           sensitive     = true
     1886           movable       = true
     1887           triggers:
     1888             on end-move persistent run diasize_end-move in this-procedure .
     1889           end triggers.
     1890         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1891         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1892         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1893         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1894         assign
     1895           v-diasize-wndmax = false
     1896         .
     1897         if connected("ub") = true
     1898         then do:
     1899           define variable v-cntxt-db-num        as integer   no-undo .
     1900           define variable v-cntxt-userid        as character no-undo .
     1901           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1902                                             , OUTPUT v-cntxt-userid
     1903                                             ) .
     1904           run gbl/wndpar_r.p
     1905             (input  v-cntxt-db-num
     1906             ,input  v-cntxt-userid
     1907             ,input  'wndmax':U
     1908             ,output v-diasize-wndmax
     1909             ,output v-default-value
     1910             ) .
     1911         end.
     1912         assign
     1913           v-diasize-wndstore = false
     1914         .
     1915         if connected("ub") = true
     1916         then do:
     1917           run gbl/wndpar_r.p
     1918             (input  v-cntxt-db-num
     1919             ,input  v-cntxt-userid
     1920             ,input  'wndstore':U
     1921             ,output v-diasize-wndstore
     1922             ,output v-default-value
     1923             ) .
     1924         end.
     1925         assign
     1926           v-diasize-proc-name = entry(1, program-name(2), '.')
     1927         .
     1928         if v-diasize-wndstore = true
     1929         then do:
     1930           assign
     1931             v-restore-saved = false
     1932           .
     1933           if connected("ub") = true
     1934           then do:
     1935             run gbl/wndsizer.p
     1936               (input  v-cntxt-db-num
     1937               ,input  v-cntxt-userid
     1938               ,input  v-diasize-proc-name
     1939               ,input  'height':u
     1940               ,output v-resize-value-str
     1941               ) .
     1942             if v-resize-value-str <> '':U
     1943             then do:
     1944               run diasize_change-height in this-procedure
     1945                 (input  integer(v-resize-value-str)
     1946                 ,input  true
     1947                 ) .
     1948               assign
     1949                 v-restore-saved = true
     1950               .
     1951             end.
     1952           end.
     1953           if connected("ub") = true
     1954           then do:
     1955             run gbl/wndsizer.p
     1956               (input  v-cntxt-db-num
     1957               ,input  v-cntxt-userid
     1958               ,input  v-diasize-proc-name
     1959               ,input  'width':u
     1960               ,output v-resize-value-str
     1961               ) .
     1962             if v-resize-value-str <> '':U
     1963             then do:
     1964               run diasize_change-width in this-procedure
     1965                 (input  integer(v-resize-value-str)
     1966                 ,input  true
     1967                 ) .
     1968               assign
     1969                 v-restore-saved = true
     1970               .
     1971             end.
     1972           end.
     1973           if v-restore-saved <> true
     1974           then do:
     1975             if v-diasize-wndmax = true
     1976             then do:
     1977               run diasize_maximize in this-procedure
     1978                 (input  true
     1979                 ) .
     1980             end.
     1981           end.
     1982         end.
     1983         else do:
     1984           if v-diasize-wndmax = true
     1985           then do:
     1986             run diasize_maximize in this-procedure
     1987               (input  true
     1988               ) .
     1989           end.
     1990         end.
     1991       end.
     1992     end.
     1993   end procedure.
     1994   procedure diasize_need-full-display :
     1995     define output parameter p-need-full-display as logical   no-undo .
     1996     do
     1997     on error undo, return error return-value
     1998     :
     1999       assign
     2000         p-need-full-display = v-diasize-need-full-display
     2001       .
     2002       assign
     2003         v-diasize-need-full-display = false
     2004       .
     2005     end.
     2006   end procedure.
     2007   procedure get-context :
     2008      define output parameter p-db-num as integer          no-undo.
     2009      define output parameter p-user-id as character        no-undo.
     2010      define variable v-login               as character    no-undo.
     2011      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2012      define buffer buf_user-login  for ub.user-login .
     2013      do
     2014      on error undo, return error
     2015      :
     2016            FIND FIRST buf_sys-ctrl no-lock.
     2017            ASSIGN
     2018               v-login = USERID("ub")
     2019               p-db-num = buf_sys-ctrl.db-num
     2020            .
     2021            FIND FIRST buf_user-login
     2022                 WHERE buf_user-login.db-num = p-db-num
     2023                   AND buf_user-login.user-login = v-login
     2024                 no-lock
     2025                 no-error
     2026                 .
     2027            IF AVAILABLE buf_user-login
     2028            THEN DO:
     2029               assign
     2030                  p-user-id = buf_user-login.user-id
     2031               .
     2032            END.
     2033      end.
     2034   end procedure.
     2035       run diasize_init in this-procedure .
     2036   MAIN-BLOCK:
     2037   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2038      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2039   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2041     (output v-sys-key
     2042     ) no-error .
     2043     if error-status:error then return error.
     2044     assign
     2045       v-ibs = (v-sys-key = 'ExpertekIBS':U)
     2046     .
     2047     if not v-ibs then do:
     2048       message
     2049       "Данная программа может вызываться только сотрудниками IBS" skip
     2050       "Продолжать?" view-as alert-box question buttons yes-no update glog.
     2051       if not glog then do:
     2052         undo, return error .
     2053       end.
     2054       DEFINE VARIABLE v-value AS CHARACTER no-undo.
     2055       DEFINE VARIABLE v-password AS CHARACTER no-undo.
     2056       DEFINE VARIABLE v-today as date no-undo .
     2057       DEFINE VARIABLE v-time as integer no-undo .
     2058       run cur-time in this-procedure ( output v-today, output v-time).
     2059       ASSIGN
     2060       v-password = string((if weekday(v-today) = 1
     2061                           then 7
     2062                           else (weekday(v-today) - 1))
     2063                           * 140).
     2064           run gbl/d-prompt.w (
     2065           'title=':u + "ВВЕДИТЕ ПАРОЛЬ" + '\':u
     2066         + 'text1=' + substitute("Пароль") + '\':u
     2067         + 'format=' + ">>>>>>>>9" + '\':u
     2068         + 'type=' + 'I':U + '\':u
     2069         + 'fillin_row=2\':u
     2070         + 'fillin_col=4\':u
     2071         + 'fillin_width=30\':u
     2072         + 'fillin_height=1\':u
     2073         + 'max-chars=70\':u
     2074         + 'readonly=no\':u
     2075         , input-output v-value
     2076         ).
     2077       if return-value = 'false':u
     2078       then do:
     2079         return no-apply.
     2080       end.
     2081       IF v-value <> v-password THEN DO:
     2082           MESSAGE
     2083         "Неверный пароль!"
     2084         VIEW-AS ALERT-BOX.
     2085         RETURN error.
     2086       END.
     2087     end.
     2088     assign
     2089     v-dr-tables = v-dr-tables + chr(44) + 'dis-rule':U +
     2090                                   chr(44) + 'dis-cfg-rule':U +
     2091                                   chr(44) + 'dis-time-rule':U
     2092                                   .
     2093     assign
     2094     v-dr-table-names = v-dr-table-names + chr(44) + 'правила скидок':U +
     2095                                   chr(44) + 'Связи dis-rule':U +
     2096                                   chr(44) + 'расписания':U
     2097                                   .
     2098     assign
     2099     v-dr-tables = trim(v-dr-tables).
     2100     run Myenable.
     2101     WAIT-FOR GO OF FRAME Dialog-Frame.
     2102   END.
     2103   run disable_UI.
     2104   PROCEDURE disable_UI :
     2105     HIDE FRAME Dialog-Frame.
     2106   END PROCEDURE.
     2107   PROCEDURE enable_UI :
     2108     DISPLAY rs-language
     2109         WITH FRAME Dialog-Frame.
     2110     ENABLE b-quit B-sel b-export B-Help rs-language br-vrmtables
     2111         WITH FRAME Dialog-Frame.
     2112     VIEW FRAME Dialog-Frame.
     2113     OPEN QUERY br-vrmtables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-dr-tables) > 0.
     2114   END PROCEDURE.
     2115   PROCEDURE MyEnable :
     2116   ASSIGN
     2117   rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2118                                                    "rus" + chr(44) + "rus"
     2119   .
     2120   rs-language + "ABL".
     2121   ENABLE
     2122   b-quit
     2123   B-sel
     2124   B-Help
     2125   b-export
     2126   br-vrmtables
     2127   rs-language
     2128   WITH FRAME Dialog-Frame.
     2129   VIEW FRAME Dialog-Frame.
     2130   run waitfram-show in this-procedure ( input "Ждите..." ).
     2131   OPEN QUERY br-vrmtables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-dr-tables) > 0.
     2132   run waitfram-hide in this-procedure .
     2133   END PROCEDURE.
     2134   PROCEDURE proc-b-sel :
     2135   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2136   IF NOT AVAILABLE buf_file THEN DO:
     2137      RETURN.
     2138   END.
     2139   CASE buf_file._file-name:
     2140     WHEN 'dis-rule':U THEN DO:
     2141       run utl/disruls0.w ( INPUT parparentproc
     2142                            ,INPUT (if v-ibs then
     2143                                   'b-add':U
     2144                                   else '':U)
     2145                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2146     END.
     2147     WHEN 'dis-time-rule':U THEN DO:
     2148       run utl/distrls0.w ( INPUT parparentproc
     2149                            ,INPUT (if v-ibs then
     2150                                   'b-add':U
     2151                                   else '':U)
     2152                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2153     END.
     2154     WHEN 'dis-cfg-rule':U THEN DO:
     2155       run utl/discfgrs.w ( INPUT parparentproc
     2156                            ,INPUT (if v-ibs then
     2157                                   'b-add':U
     2158                                   else '':U)
     2159                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2160     END.
     2161   END CASE.
     2162   END PROCEDURE.
     2163   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER ) :
     2164   DEFINE VARIABLE v-tbl-fname AS CHARACTER NO-UNDO.
     2165   v-tbl-fname = ENTRY(LOOKUP(p-tbl-name, v-dr-tables), v-dr-table-names).
     2166   return v-tbl-fname.
     2167   END FUNCTION.
