      351   define input  parameter p-contract-code as integer   no-undo .
      352   define input  parameter doc-list as character no-undo .
      353   define variable v-str  as CHAR  no-undo .
      354   define variable par-type  as CHAR  no-undo .
      355    define variable ii as integer   no-undo .
      356    define variable doc-num as character no-undo .
      357    define variable Counter1 as integer   no-undo .
      358   define buffer buf_trn-doc for trn-doc .
      359   define buffer buf_parts for parts.
      360   define buffer buf_parts-attr for parts-attr.
      361   DEFINE temp-table temp-doc no-undo
      362     field   id             as character
      363     field fact-order like ub.trn-doc.fact-order
      364     INDEX pi  IS PRIMARY   id
      365     index fact-order fact-order
      366   .
      367   do:
      368   define variable num-db as integer   no-undo .
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      371     (output num-db
      372     )  .
      373   define variable v-account as integer init 0 no-undo .
      374   define variable v-account-lavel as character no-undo .
      375   define variable v-button-stop as logical no-undo .
      376   define variable v-kol-spice as integer no-undo .
      377   define variable v-kol-spice2 as integer no-undo .
      378   define variable v-kol-spice3 as integer no-undo .
      379   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      380   DEFINE BUTTON StopBtn AUTO-END-KEY
      381        LABEL "Стоп"
      382        SIZE 10 BY 1.
      383   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      384        LABEL "Обработано записей"
      385         VIEW-AS TEXT
      386        SIZE 14 BY .67 NO-UNDO.
      387   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      388         VIEW-AS TEXT
      389        SIZE 53.25 BY .67
      390        FGCOLOR 1  NO-UNDO.
      391   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      392         VIEW-AS TEXT
      393        SIZE 53.25 BY .67
      394        FGCOLOR 1  NO-UNDO.
      395   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      396         VIEW-AS TEXT
      397        SIZE 53.25 BY .67
      398        FGCOLOR 1  NO-UNDO.
      399   DEFINE RECTANGLE RECT-1
      400        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      401        SIZE 55.13 BY 4.46.
      402   DEFINE FRAME InfoFrame
      403        StopBtn AT ROW 4.25 COL 21.75
      404        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      405        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      406        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      407        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      408        RECT-1 AT ROW 1 COL 1
      409       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      410            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      411            TITLE "Процесс"
      412            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      413   define variable mFrameView      as logical   no-undo init yes.
      414     define variable mFramHandle as handle no-undo.
      415     mFramHandle = frame InfoFrame:handle.
      416     if  log-manager:logfile-name ne ?
      417     then DO:
      418         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      419         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      420         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      421     end.
      422     mFrameView = not session:batch-mode and mFramHandle:visible.
      423     if mFrameView
      424     then do:
      425       ASSIGN
      426          FRAME InfoFrame:HIDDEN                           = TRUE
      427          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      428     end.
      429   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      430   DO:
      431     IF not StopProcessing THEN
      432       Message "Вы действительно хотите прервать" SKIP
      433               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      434                 UPDATE StopProcessing.
      435     IF StopProcessing THEN do:
      436        if mFrameView
      437        then do:
      438           HIDE FRAME InfoFrame.
      439        end.
      440     End.
      441   END.
      442   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
      443     if  log-manager:logfile-name ne ?
      444     then DO:
      445         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      446     end.
      447     if not session:batch-mode then
      448     do:
      449       VIEW FRAME InfoFrame.
      450       mFrameView = true.
      451     end.
      452      v-button-stop = false .
      453         if mFrameView
      454         then do:
      455         if v-button-stop then view STOPBTN in frame InfoFrame.
      456                          else Hide STOPBTN in frame InfoFrame.
      457         end.
      458     on write of ub.trn-doc override do:  end.
      459     do transaction :
      460       do ii = 1 to num-entries(doc-list):
      461         assign doc-num = entry(ii, doc-list) .
      462         find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = doc-num no-error .
      463         if available buf_trn-doc then do:
      464           run AddDoc (doc-num) .
      465           assign buf_trn-doc.contract-code = p-contract-code .
      466         end.
      467         for each buf_parts-attr exclusive-lock where buf_parts-attr.in-code = doc-num :
      468           find first ub.goods no-lock where ub.goods.gds-code = buf_parts-attr.gds-code .
      469           assign buf_parts-attr.contract-code = p-contract-code .
      470           for each clients no-lock where clients.db-num = num-db :
      471             for each parts exclusive-lock
      472               where parts.obj-type  =  clients.obj-type
      473                 and parts.obj-code  =  clients.obj-code
      474                 and parts.artic     =  ub.goods.artic
      475                 and parts.prod-type =  ub.goods.prod-type
      476                 and parts.prod-code =  ub.goods.prod-code
      477                 and parts.in-code   =  buf_parts-attr.in-code
      478                 and parts.part-code =  buf_parts-attr.part-code
      479               :
      480               run AddDoc (parts.out-code) .
      481               assign parts.contract-code = p-contract-code .
      482               assign Counter1 = Counter1 + 1.
      483   IF ( Counter1 modulo v-account = 0 )  then DO:
      484             if  log-manager:logfile-name ne ?
      485             then DO:
      486                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      487             end.
      488              if mFrameView
      489              then do:
      490               DISPLAY
      491                 Counter1 @ RecordsDone
      492                 WITH FRAME InfoFrame.
      493              end.
      494   End.
      495      if v-button-stop then  DO:
      496            if mFrameView
      497            then
      498               PROCESS EVENTS.
      499            IF StopProcessing THEN DO:
      500            RETURN error.
      501            End.
      502      end.
      503             end.
      504           end.
      505         end.
      506         for each buf_parts exclusive-lock where buf_parts.out-code = doc-num :
      507           assign buf_parts.contract-code = p-contract-code .
      508           assign Counter1 = Counter1 + 1.
      509   IF ( Counter1 modulo v-account = 0 )  then DO:
      510             if  log-manager:logfile-name ne ?
      511             then DO:
      512                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      513             end.
      514              if mFrameView
      515              then do:
      516               DISPLAY
      517                 Counter1 @ RecordsDone
      518                 WITH FRAME InfoFrame.
      519              end.
      520   End.
      521      if v-button-stop then  DO:
      522            if mFrameView
      523            then
      524               PROCESS EVENTS.
      525            IF StopProcessing THEN DO:
      526            RETURN error.
      527            End.
      528      end.
      529         end.
      530       end.
      531       run CalcArh in this-procedure .
      532     end.
      533   if mFrameView
      534   then do:
      535      HIDE FRAME InfoFrame.
      536   end.
      537   end.
      538   procedure AddDoc :
      539     define input  parameter p-num as character no-undo .
      540     do on error undo, return error return-value :
      541       find first temp-doc where temp-doc.id = p-num no-error .
      542       if not available temp-doc then do:
      543         create temp-doc .
      544         assign temp-doc.id = p-num .
      545         find first trn-doc no-lock where trn-doc.doc-code = p-num no-error  .
      546         if available trn-doc then do:
      547           run clntattr-value in this-procedure  (input trn-doc.obj-type,input trn-doc.obj-code,
      548                   input  'arh-trn-doc-contract':U, output v-str, output par-type) no-error .
      549           if error-status:error or logical(v-str) = no then do:
      550             run clntattr-write in this-procedure ( input trn-doc.obj-type,input trn-doc.obj-code, input 'arh-trn-doc-contract':U, input "yes":u).
      551           end.
      552         end.
      553       end.
      554     end.
      555   end procedure.
      556   PROCEDURE CalcArh :
      557     do on error undo, return error return-value :
      558       for each temp-doc use-index fact-order :
      559         find first trn-doc no-lock where trn-doc.doc-code = temp-doc.id no-error  .
      560         if available trn-doc then do:
      561   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   if (valid-handle(g#libtfarh) <> true) then do:   run str/libtfarh.p persistent no-error .   if error-status :error or (valid-handle(g#libtfarh) <> true) then do:     message       "Error starting libtfarh.p" skip       g#libtfarh skip       g#libtfarh :type skip       g#libtfarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libtfarh_st-fo in g#libtfarh
      563   (input  temp-doc.id
      564   ) no-error.
      565           if error-status:error then return error.
      566         end.
      567       end.
      568     end.
      569   end procedure.
