        1   block-level on error undo, throw.
        2   define input  parameter iKey     as integer no-undo.
        3   define output parameter oChekSum as character no-undo.
        4   if userid("ub") eq ""
        5   then do:
        6      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
        7    .
        8      return.
        9   end.
       10   define input parameter p-range-db as character no-undo.
       11   define input parameter p-region   as character no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision:$":U .
       13   define variable vss-author      as character no-undo init "$Author:$":U .
       14   define variable vss-date        as character no-undo init "$Date:$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       16   define variable vss-archive     as character no-undo init "$Archive:$":U .
