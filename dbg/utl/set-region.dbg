       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   function objExists return character
       77   (input  ifolder as character,
       78    input  iType   as character  ):
       79       define variable vFileType as character no-undo init "D,F".
       80       define variable vi        as integer no-undo.
       81       define variable vtype as character no-undo.
       82       if iType ne ?
       83       then
       84          vFileType = iType.
       85       do vi = 1 to num-entries(vFileType):
       86          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       87          vtype = file-information:file-type.
       88          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       89             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       90             index(vtype , entry(vi,vFileType )) > 0
       91          then return file-information:full-pathname .
       92          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       93          vtype = file-information:file-type.
       94          if file-information:file-name <> "" and
       95             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       96             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       97             index( vtype, entry(vi,vFileType )) > 0
       98          then return file-information:full-pathname .
       99       end.
      100       return ? .
      101   end.
      102   function SearchFile return character
      103   (input  ifile as character):
      104      return objExists(ifile,?).
      105   end.
      106   function SearchPFile return character
      107   (input inFile as char):
      108        define variable oFile       as character no-undo.
      109        define variable vFileSearch as character no-undo.
      110        define variable vNumEntry   as integer no-undo.
      111        if inFile = "" then return ?.
      112        vNumEntry = num-entries(inFile,".").
      113        vFileSearch = inFile.
      114        if    vNumEntry > 0
      115           and (   entry(vNumEntry,inFile,".") eq "p"
      116                or entry(vNumEntry,inFile,".") eq "w")
      117        then do:
      118           entry(vNumEntry,vFileSearch, ".") = "r".
      119           oFile = search(vFileSearch ).
      120           if oFile eq ?
      121           then
      122              oFile = search(inFile).
      123        end.
      124        else
      125           oFile = search(vFileSearch).
      126        return oFile.
      127     end.
