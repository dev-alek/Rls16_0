      140   function is-numeral return logical
      141     (input p-string   as character ,
      142      input char-avail as character) :
      143     define variable p-replace-string as character no-undo .
      144     define variable log-result       as logical  no-undo .
      145     if p-string = ? then
      146       return false .
      147     p-replace-string = p-string.
      148     if lookup ("*", char-avail) > 0 then
      149         p-replace-string = replace (p-replace-string, '*', '9').
      150     if lookup ("digit", char-avail) > 0 then
      151       assign
      152         p-replace-string = replace (p-replace-string, '0', '9')
      153         p-replace-string = replace (p-replace-string, '1', '9')
      154         p-replace-string = replace (p-replace-string, '2', '9')
      155         p-replace-string = replace (p-replace-string, '3', '9')
      156         p-replace-string = replace (p-replace-string, '4', '9')
      157         p-replace-string = replace (p-replace-string, '5', '9')
      158         p-replace-string = replace (p-replace-string, '6', '9')
      159         p-replace-string = replace (p-replace-string, '7', '9')
      160         p-replace-string = replace (p-replace-string, '8', '9')
      161         .
      162     else
      163        p-replace-string = replace (p-replace-string, '9', chr(15))
      164         .
      165     if lookup ("letter", char-avail) > 0 then
      166       assign
      167         p-replace-string = replace (p-replace-string, 'A', '9')
      168         p-replace-string = replace (p-replace-string, 'B', '9')
      169         p-replace-string = replace (p-replace-string, 'C', '9')
      170         p-replace-string = replace (p-replace-string, 'D', '9')
      171         p-replace-string = replace (p-replace-string, 'E', '9')
      172         p-replace-string = replace (p-replace-string, 'F', '9')
      173         p-replace-string = replace (p-replace-string, 'G', '9')
      174         p-replace-string = replace (p-replace-string, 'H', '9')
      175         p-replace-string = replace (p-replace-string, 'I', '9')
      176         p-replace-string = replace (p-replace-string, 'J', '9')
      177         p-replace-string = replace (p-replace-string, 'K', '9')
      178         p-replace-string = replace (p-replace-string, 'L', '9')
      179         p-replace-string = replace (p-replace-string, 'M', '9')
      180         p-replace-string = replace (p-replace-string, 'N', '9')
      181         p-replace-string = replace (p-replace-string, 'O', '9')
      182         p-replace-string = replace (p-replace-string, 'P', '9')
      183         p-replace-string = replace (p-replace-string, 'Q', '9')
      184         p-replace-string = replace (p-replace-string, 'R', '9')
      185         p-replace-string = replace (p-replace-string, 'S', '9')
      186         p-replace-string = replace (p-replace-string, 'T', '9')
      187         p-replace-string = replace (p-replace-string, 'U', '9')
      188         p-replace-string = replace (p-replace-string, 'V', '9')
      189         p-replace-string = replace (p-replace-string, 'W', '9')
      190         p-replace-string = replace (p-replace-string, 'X', '9')
      191         p-replace-string = replace (p-replace-string, 'Y', '9')
      192         p-replace-string = replace (p-replace-string, 'Z', '9')
      193         p-replace-string = replace (p-replace-string, '_', '9')
      194         .
      195     return p-replace-string = fill ('9', length (p-string)).
      196   end.
