      366   define variable vStartDb as integer no-undo.
      367   define variable vEndDb as integer no-undo.
      368   define variable vRegCode as integer no-undo.
      369   define variable vFlg as log no-undo.
      370   define buffer buf_regions for ub.regions.
      371   define buffer buf_db      for ub.db.
      372   if g#db-num ne 0
      373   then do:
      374      message "Запуск процедуры возможен только на ГБД" view-as alert-box.
      375      return error "Запуск процедуры возможен только на ГБД".
      376   end.
      377   if num-entries(p-range-db,"-") = 2 then
      378      assign
      379         vStartDb = INT(entry(1,p-range-db,"-"))
      380         vEndDb   = INT(entry(2,p-range-db,"-"))
      381         no-error.
      382   else
      383      assign
      384         vStartDb = INT(p-range-db)
      385         vEndDb   = vStartDb
      386         no-error.
      387   if error-status:error or
      388      vStartDb = ? or
      389      vStartDb = 0 or
      390      vEndDb = ? or
      391      vEndDb = 0
      392   then do:
      393       message "Неверно задан диапазон номеров БД - должны быть два числа разделенных дефисом, или одно число." view-as alert-box.
      394       return error "Неверно задан диапазон номеров БД - должны быть два числа разделенных дефисом, или одно число.".
      395   end.
      396   vRegCode = INT(p-region) no-error.
      397   if error-status:error or
      398      vRegCode = ? then do:
      399       message "Неверно задан код региона - должно быть число." view-as alert-box.
      400       return error "Неверно задан код региона - должно быть число.".
      401   end.
      402   if vRegCode <> 0 then do:
      403       find first buf_regions no-lock
      404            where buf_regions.reg-code = vRegCode
      405            no-error .
      406       if not available buf_regions then do:
      407           message "Отсутствует регион с кодом " vRegCode view-as alert-box.
      408           return error substitute("Отсутствует регион с кодом &1",vRegCode).
      409       end.
      410   end.
      411     def var vOk as logical no-undo .
      412     def var vMess as char no-undo.
      413     vMess = if vRegCode = 0 then "Удалить" else "Установить".
      414     if vStartDb = vEndDb then
      415        vMess = substitute("&1 для базы данных номер &2", vMess, vStartDb).
      416     else
      417        vMess = substitute("&1 для баз данных с номера &2 по номер &3",vMess, vStartDb, vEndDb).
      418     if vRegCode = 0 then
      419        vMess = substitute("&1 связь с регионом?",vMess).
      420     else
      421        vMess = substitute("&1 код региона &2?",vMess, vRegCode).
      422     message
      423       vMess
      424       view-as alert-box question buttons yes-no update vOk .
      425     if not vOk then do:
      426       return .
      427     end.
      428   vFlg = no.
      429   do transaction
      430   on error undo, return error:
      431       for each buf_db no-lock where
      432                buf_db.db-num >= vStartDb
      433            and buf_db.db-num <= vEndDb
      434            :
      435         if vRegCode <> 0 then
      436         do:
      437            run db-attr-write in this-procedure (buf_db.db-num, "reg-code", vRegCode) no-error.
      438            if error-status:error then do:
      439               message substitute("Ошибка сохранения кода региона &1 для БД &2: &3", vRegCode, buf_db.db-num, return-value)
      440                 view-as alert-box error.
      441               vFlg = no.
      442               undo, return no-apply.
      443            end.
      444            vFlg = yes.
      445         end.
      446         else do:
      447            run db-attr-exist in this-procedure (buf_db.db-num, "reg-code", output vFlg) no-error.
      448            if vFlg then do:
      449                run db-attr-delete in this-procedure (buf_db.db-num, "reg-code", output vFlg) no-error.
      450                if error-status:error or vFlg = no then do:
      451                   message substitute("Ошибка удаления кода региона для БД &1: &2", buf_db.db-num, return-value)
      452                     view-as alert-box error.
      453                   vFlg = no.
      454                   undo, return no-apply.
      455                end.
      456            end.
      457            else vFlg = yes.
      458         end.
      459       end.
      460   end.
      461   if not vFlg then vMess = "".
      462   else if vRegCode = 0 then
      463      vMess = "Код региона успешно удален.".
      464   else
      465      vMess = "Код региона успешно установлен.".
      466   if vMess <> "" then
      467    MESSAGE vMess
      468    VIEW-AS ALERT-BOX.
