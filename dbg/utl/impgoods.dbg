     1045   DEFINE BUTTON Imply-Cli
     1046        LABEL "Производитель"
     1047        SIZE 14.13 BY 1.13.
     1048   DEFINE BUTTON measure
     1049        LABEL "Ед. изм."
     1050        SIZE 10.5 BY 1.21.
     1051   DEFINE BUTTON prt
     1052        LABEL "Шкала"
     1053        SIZE 10.5 BY 1.21.
     1054   DEFINE VARIABLE city1 AS CHARACTER FORMAT "X(256)":U
     1055         VIEW-AS TEXT
     1056        SIZE 3.88 BY 1.21
     1057        BGCOLOR 15  NO-UNDO.
     1058   DEFINE VARIABLE city2 AS CHARACTER FORMAT "X(256)":U
     1059         VIEW-AS TEXT
     1060        SIZE 53.88 BY 1.21
     1061        BGCOLOR 15  NO-UNDO.
     1062   DEFINE VARIABLE Cli-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1063         VIEW-AS TEXT
     1064        SIZE 8.88 BY 1.13
     1065        BGCOLOR 15  NO-UNDO.
     1066   DEFINE VARIABLE Cli-Name AS CHARACTER FORMAT "X(256)":U
     1067         VIEW-AS TEXT
     1068        SIZE 43.63 BY 1.13
     1069        BGCOLOR 15  NO-UNDO.
     1070   DEFINE VARIABLE Cli-type AS CHARACTER FORMAT "X(8)":U
     1071         VIEW-AS TEXT
     1072        SIZE 4.63 BY 1.13
     1073        BGCOLOR 15  NO-UNDO.
     1074   DEFINE VARIABLE File-txt AS CHARACTER FORMAT "X(256)":U
     1075         VIEW-AS TEXT
     1076        SIZE 53.5 BY 1.25
     1077        BGCOLOR 15  NO-UNDO.
     1078   DEFINE VARIABLE grp-txt AS CHARACTER FORMAT "X(256)":U
     1079         VIEW-AS TEXT
     1080        SIZE 58.13 BY 1.21
     1081        BGCOLOR 15  NO-UNDO.
     1082   DEFINE VARIABLE measure-txt1 AS CHARACTER FORMAT "X(256)":U
     1083         VIEW-AS TEXT
     1084        SIZE 6.5 BY 1.21
     1085        BGCOLOR 15  NO-UNDO.
     1086   DEFINE VARIABLE measure-txt2 AS CHARACTER FORMAT "X(256)":U
     1087         VIEW-AS TEXT
     1088        SIZE 22.25 BY 1.21
     1089        BGCOLOR 15  NO-UNDO.
     1090   DEFINE VARIABLE measure-txt3 AS CHARACTER FORMAT "X(256)":U
     1091         VIEW-AS TEXT
     1092        SIZE 28.63 BY 1.21
     1093        BGCOLOR 15  NO-UNDO.
     1094   DEFINE VARIABLE prt-txt AS CHARACTER FORMAT "X(256)":U
     1095         VIEW-AS TEXT
     1096        SIZE 58.13 BY 1.21
     1097        BGCOLOR 15  NO-UNDO.
     1098   DEFINE VARIABLE R-S-stop AS INTEGER INITIAL 2
     1099        VIEW-AS RADIO-SET VERTICAL
     1100        RADIO-BUTTONS
     1101             "Без останова", 1,
     1102   "Останов по ошибке", 2
     1103        SIZE 21 BY 1.75 NO-UNDO.
     1104   DEFINE FRAME Dialog-Frame
     1105        File AT ROW 1.42 COL 1.75
     1106        Imply-Cli AT ROW 4.5 COL 1.38
     1107        grp AT ROW 5.75 COL 5
     1108        Imly-City AT ROW 7.25 COL 5
     1109        measure AT ROW 8.75 COL 5
     1110        prt AT ROW 10.25 COL 5
     1111        R-S-stop AT ROW 11.75 COL 5.5 NO-LABEL
     1112        Btn_OK AT ROW 13.75 COL 21
     1113        Btn_Cancel AT ROW 13.75 COL 41.5
     1114        b-help AT ROW 1.42 COL 71.5
     1115        File-txt AT ROW 1.46 COL 19.5 COLON-ALIGNED NO-LABEL
     1116        Cli-code AT ROW 4.5 COL 14.63 COLON-ALIGNED NO-LABEL
     1117        Cli-type AT ROW 4.5 COL 24 COLON-ALIGNED NO-LABEL
     1118        Cli-Name AT ROW 4.5 COL 29.13 COLON-ALIGNED NO-LABEL
     1119        grp-txt AT ROW 5.75 COL 14.63 COLON-ALIGNED NO-LABEL
     1120        city1 AT ROW 7.25 COL 14.63 COLON-ALIGNED NO-LABEL
     1121        city2 AT ROW 7.25 COL 19 COLON-ALIGNED NO-LABEL
     1122        measure-txt1 AT ROW 8.71 COL 14.63 COLON-ALIGNED NO-LABEL
     1123        measure-txt2 AT ROW 8.71 COL 21.63 COLON-ALIGNED NO-LABEL
     1124        measure-txt3 AT ROW 8.71 COL 44.38 COLON-ALIGNED NO-LABEL
     1125        prt-txt AT ROW 10.25 COL 14.5 COLON-ALIGNED NO-LABEL
     1126        "            Параметры подставляемые по умолчанию" VIEW-AS TEXT
     1127             SIZE 73.38 BY .92 AT ROW 3.08 COL 1.5
     1128             BGCOLOR 8 FGCOLOR 0
     1129        SPACE(0.36) SKIP(9.12)
     1130       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1131            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1132            TITLE BGCOLOR 0 FGCOLOR 15 "Импорт товаров в справочник из файла"
     1133            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
     1134   ASSIGN
     1135          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1136          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1137   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1138   DO:
     1139     APPLY "END-ERROR":U TO SELF.
     1140   END.
     1141   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1142   DO:
     1143     assign
     1144       R-S-stop
     1145       impc-save = 0
     1146       impc = 0
     1147     .
     1148    if p-client = 0 and Cli-type = "" then do:
     1149            message "Производитель должен быть заведен в файле импорта или выбран какого подставлять по умолчанию" view-as alert-box.
     1150    end.
     1151    else do:
     1152       if p-client = 0 then do:
     1153             assign
     1154               i-client-type = Cli-type
     1155               i-client-code = Cli-code
     1156             .
     1157       end.
     1158       find first ub.gds-prt no-lock
     1159           where  ub.gds-prt.node-name = '_Пустая шкала':U
     1160       no-error.
     1161       CASE choice:
     1162           WHEN 1 then do:
     1163               input stream imp from value (f-name) convert source "1251".
     1164           END.
     1165           WHEN 2 then do:
     1166               input stream imp from value (f-name) convert source "KOI8-R".
     1167           END.
     1168       END CASE.
     1169       OUTPUT stream err close.
     1170       OUTPUT stream attem close.
     1171       OUTPUT stream err TO value ("err.txt").
     1172       OUTPUT stream attem TO value ("attem.txt").
     1173       repeat:
     1174           IMPORT stream imp UNFORMATTED text-string NO-ERROR.
     1175           if trim(text-string) = "" then leave.
     1176           assign impc = impc + 1.
     1177           if NUm-ENTRIES(text-string, ";") <> line then do:
     1178                     put stream err "В строчке " impc " неверное кол-во полей - " NUm-ENTRIES(text-string, ";")
     1179                          "должно быть" line
     1180                     skip.
     1181                     export stream  err text-string .
     1182                     IF r-s-stop = 1 THEN next.
     1183                     ELSE RETURN.
     1184           end.
     1185           run next-good (output reply).
     1186           display
     1187                    impc
     1188                    i-artic format "x(20)"
     1189                    impc-save
     1190                 with frame ff view-as dialog-box
     1191                 title ": Загрузка справочника товаров из файла".
     1192           pause 0.
     1193           if  reply = false then do:
     1194                   next.
     1195           end.
     1196           if i-client-type = "" then do:
     1197                   if Cli-type = "" then do:
     1198                             export stream  err text-string "Не задан производитель товаров".
     1199                             IF r-s-stop = 1 THEN next.
     1200                             ELSE RETURN.
     1201                   end.
     1202                   else
     1203                     assign
     1204                         i-client-type = Cli-type
     1205                         i-client-code = Cli-code
     1206                     .
     1207           end.
     1208           if i-grp-name = "" then do:
     1209                 if grp-txt = "" then do:
     1210                        export stream  err text-string "Не задана группа товаров" .
     1211                        IF r-s-stop = 1 THEN next.
     1212                        ELSE RETURN.
     1213                 end.
     1214                 else
     1215                        assign
     1216                           i-grp-code = grp-code
     1217                           i-grp-name = grp-txt.
     1218           end.
     1219           if i-unit-base = "" then do:
     1220                  if measure-txt1 = "" then do:
     1221                        export stream  err text-string "Не задана единица измерения товаров".
     1222                        IF r-s-stop = 1 THEN next.
     1223                        ELSE RETURN.
     1224                  end.
     1225                  else   assign    i-unit-base = measure-txt1.
     1226           end.
     1227           if i-city = ""  then i-city = city1 .
     1228           if p-gds-prt = 0 and prt-txt <> "" then do:
     1229               find first ub.gds-prt no-lock  where
     1230                          ub.gds-prt.root = TRUE and
     1231                          ub.gds-prt.node-name = prt-txt
     1232               no-error.
     1233               if available ub.gds-prt then  i-gds-prt = ub.gds-prt.node-code.
     1234               else do:
     1235                       export stream  err text-string "Не задана шкала товаров".
     1236                       IF r-s-stop = 1 THEN next.
     1237                       ELSE RETURN.
     1238               end.
     1239           end.
     1240           find first goods where
     1241                      goods.artic = i-artic and
     1242                      goods.prod-type = i-client-type and
     1243                      goods.prod-code = i-client-code
     1244           no-lock no-error.
     1245           if available goods then do:
     1246                     put stream attem "Такой товар уже есть в БД" skip.
     1247                     export stream  attem text-string .
     1248                     IF r-s-stop = 1 THEN next.
     1249                     ELSE RETURN.
     1250           end.
     1251           do transaction:
     1252                   define variable v-host-code     as integer           no-undo.
     1253   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1255     (input  v-cntxt-obj-type
     1256     ,input  v-cntxt-obj-code
     1257     ,output v-host-code
     1258     )  .
     1259                   run ref/dtaxgdss.p (
     1260                         input yes
     1261                       , input   i-unit-base
     1262                       , input   ub.gds-prt.node-code
     1263                       , input ?
     1264                       , input ?
     1265                       , input   v-host-code
     1266                       , input    v-cntxt-obj-type
     1267                       , input    v-cntxt-obj-code
     1268                   ).
     1269                   IF p-VAT-code > 0 THEN DO:
     1270                     find first tt-tax
     1271                         where tt-tax.tax-code = integer( '1':U )
     1272                     no-error.
     1273                     if available tt-tax   then do:
     1274                         assign
     1275                             tt-tax.rate-code = NDS .
     1276                     end.
     1277                   END.
     1278                   if p-SLT-code > 0  then DO:
     1279                     find first tt-tax
     1280                         where tt-tax.tax-code = integer( '2':U )
     1281                     no-error.
     1282                     if available tt-tax  then do:
     1283                         assign
     1284                             tt-tax.rate-code = NP  .
     1285                     end.
     1286                   END.
     1287               define variable v-recid         as recid             no-undo.
     1288               run ref/goods01.p (
     1289                     input parparentproc
     1290                   , input 'ДОБАВЛЕНИЕ':U
     1291                   , input no
     1292                   , input 0
     1293                   , input no
     1294                   , input yes
     1295                   , input no
     1296                   , input no
     1297                   , input yes
     1298                   , input v-host-code
     1299                   , input v-cntxt-obj-type
     1300                   , input v-cntxt-obj-code
     1301                   , input yes
     1302                   , input ?
     1303                   , input 0
     1304                   , input i-artic
     1305                   , input i-client-type
     1306                   , input i-client-code
     1307                   , input i-gds-prt
     1308                   , input i-grp-code
     1309                   , input i-name
     1310                   , input ""
     1311                   , input i-name
     1312                   , input i-name
     1313                   , input replace( replace( i-name, chr( 39 ), "" ), chr( 34 ), "" )
     1314                   , input i-city
     1315                   , input i-unit-base
     1316                   , input i-unit-base
     1317                   , input 0.0
     1318                   , input 0.0
     1319                   , input 1
     1320                   , input 1
     1321                   , input 0
     1322                   , input 0
     1323                   , input 0
     1324                   , input 0
     1325                   , input 'Группа':U
     1326                   , input 0
     1327                   , input no
     1328                   , input 0
     1329                   , input 0
     1330                   , input ""
     1331                   , input i-11
     1332                   , input i-22
     1333                   , input i-33
     1334                   , input i-44
     1335                   , input i-struct
     1336                   , input 0
     1337                   , input 0
     1338                   , input ""
     1339                   , input 0.0
     1340                   , input 0
     1341                   , input 0
     1342                   , input ""
     1343                   , input ""
     1344                   , input ""
     1345                   , input 0
     1346                   , input ?
     1347                   , input ""
     1348                   , input no
     1349                   , input no
     1350                   , input no
     1351                   , input no
     1352                   , input "no"
     1353                   , input yes
     1354                   , input no
     1355                   , input no
     1356                   , input 0
     1357                   , input-output v-recid
     1358                   , output j-gds-code
     1359               ) no-error .
     1360               if error-status :error
     1361               then do:
     1362                   message
     1363                            vss-workfile vss-revision vss-description
     1364                       skip "Ошибка создания или изменения карточки товара."
     1365                       skip return-value
     1366                       skip i-artic
     1367                       skip trim(error-status :get-message(1))
     1368                            trim(error-status :get-message(2))
     1369                            trim(error-status :get-message(3))
     1370                   view-as alert-box error.
     1371                   IF r-s-stop = 2 THEN RETURN.
     1372               end.
     1373               else  impc-save = impc-save + 1.
     1374           end.
     1375       END.
     1376       input stream imp close.
     1377       OUTPUT stream err close.
     1378       OUTPUT stream attem close.
     1379       message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     1380                ",  сохранено " + string(impc-save) )
     1381       view-as alert-box  INFORMATION.
     1382    end.
     1383   END.
     1384   ON CHOOSE OF File IN FRAME Dialog-Frame
     1385   DO:
     1386         disable Btn_OK with frame Dialog-Frame.
     1387         disable grp with frame Dialog-Frame.
     1388         disable Imly-city with frame Dialog-Frame.
     1389         disable measure with frame Dialog-Frame.
     1390         disable prt with frame Dialog-Frame.
     1391         disable Imply-Cli with frame Dialog-Frame.
     1392         run utl/strtimp1.w (
     1393                     input vattaxcd,
     1394                     input slttaxcd,
     1395                     output f-name,
     1396                     output choice,
     1397                     output p-artic,
     1398                     OUTPUT p-name,
     1399                     OUTPUT p-engl-name,
     1400                     OUTPUT p-unit-base,
     1401                     OUTPUT p-VAT-code,
     1402                     OUTPUT p-SLT-code,
     1403                     OUTPUT p-struct,
     1404                     OUTPUT p-11,
     1405                     OUTPUT p-22,
     1406                     OUTPUT p-33,
     1407                     OUTPUT p-44,
     1408                     OUTPUT p-city,
     1409                     OUTPUT p-grp,
     1410                     OUTPUT p-gds-prt,
     1411                     OUTPUT p-client,
     1412                     OUTPUT line
     1413                     ) no-error.
     1414         if  error-status:error or f-name = "" then do:
     1415                 message
     1416                   vss-workfile vss-revision vss-description skip
     1417                   "Не выбран файл для импорта" skip
     1418                   error-status :get-message(1) skip
     1419                   return-value skip
     1420                   view-as alert-box error .
     1421                 return .
     1422         end.
     1423         assign
     1424               file-txt = f-name.
     1425         enable Btn_OK with frame Dialog-Frame.
     1426         if p-grp = 0 then
     1427              enable grp with frame Dialog-Frame.
     1428         if p-city = 0 then
     1429              enable Imly-city with frame Dialog-Frame.
     1430         if p-unit-base  = 0 then
     1431              enable measure with frame Dialog-Frame.
     1432         if p-gds-prt = 0 then
     1433              enable prt with frame Dialog-Frame.
     1434         if p-client = 0 then
     1435              enable Imply-Cli with frame Dialog-Frame.
     1436         disp
     1437              file-txt
     1438         with frame Dialog-Frame.
     1439   END.
     1440   ON CHOOSE OF grp IN FRAME Dialog-Frame
     1441   DO:
     1442       run ref/gds-grp.w (  input parparentproc
     1443                     , input "b-sel"
     1444                     , input v-cntxt-obj-type
     1445                     , input v-cntxt-obj-code
     1446                     , input-output g-grp ).
     1447       if g-grp <> "" then do:
     1448          FIND FIRST ub.gds-grp WHERE
     1449            recid (ub.gds-grp) = integer (g-grp) NO-LOCK.
     1450          if available ub.gds-grp then do:
     1451               g-grp = "".
     1452               run grplib-get-full-name in this-procedure ( input ub.gds-grp.node-code, output g-grp ) .
     1453               assign
     1454                  grp-code = ub.gds-grp.node-code
     1455                  grp-txt = g-grp.
     1456               disp
     1457                   grp-txt
     1458               with frame Dialog-Frame.
     1459          end.
     1460       end.
     1461   END.
     1462   ON CHOOSE OF Imly-City IN FRAME Dialog-Frame
     1463   DO:
     1464   define variable v-rid-list as character no-undo .
     1465   run ref/countris.w (input parparentproc,  "b-sel", input-output v-rid-list ).
     1466   if v-rid-list <> "" then     do:
     1467       FIND ub.country WHERE recid (ub.country) = integer(v-rid-list) NO-LOCK.
     1468       if available ub.country then
     1469             assign
     1470                 city1  = ub.country.alpha1
     1471                 city2  = ub.country.long-name
     1472             .
     1473               disp
     1474                 city1
     1475                 city2
     1476            with frame Dialog-Frame.
     1477       end.
     1478   END.
     1479   ON CHOOSE OF Imply-Cli IN FRAME Dialog-Frame
     1480   DO:
     1481   define variable v-ref-rec as recid no-undo .
     1482       run ref/cli-all.w ( parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  ref-list).
     1483       v-ref-rec = integer (ref-list).
     1484       if  v-ref-rec <> ? then do:
     1485           FIND ub.clients WHERE recid (ub.clients) = v-ref-rec NO-LOCK .
     1486           if available ub.clients then
     1487              assign
     1488              Cli-type = ub.clients.obj-type
     1489              Cli-code = ub.clients.obj-code
     1490              Cli-name = ub.clients.obj-name
     1491              .
     1492              disp
     1493                Cli-type
     1494                Cli-code
     1495                Cli-name
     1496           with frame Dialog-Frame.
     1497       end.
     1498   END.
     1499   ON CHOOSE OF measure IN FRAME Dialog-Frame
     1500   DO:
     1501   define variable v-ref-rec as recid no-undo .
     1502       run ref/units.w ( input parparentproc, yes, output v-ref-rec ).
     1503       if v-ref-rec <> ? then  do:
     1504           FIND ub.units WHERE recid (ub.units) = v-ref-rec NO-LOCK.
     1505           assign
     1506             measure-txt1 = ub.units.unit-name
     1507             measure-txt2 = ub.units.long-name
     1508             measure-txt3 = ub.units.type
     1509           .
     1510           disp
     1511             measure-txt1
     1512             measure-txt2
     1513             measure-txt3
     1514           with frame Dialog-Frame.
     1515       end.
     1516   END.
     1517   ON CHOOSE OF prt IN FRAME Dialog-Frame
     1518   DO:
     1519    define variable v-ref-rec as recid no-undo .
     1520       run ref/gdsprts.w (parparentproc, yes, output v-ref-rec).
     1521       if v-ref-rec <> ? then do:
     1522            FIND ub.gds-prt WHERE recid (ub.gds-prt) = v-ref-rec.
     1523            if available ub.gds-prt then do:
     1524               assign
     1525                 t-gds-prt = ub.gds-prt.prt-root
     1526                 prt-txt = ub.gds-prt.node-name
     1527               .
     1528               disp
     1529                   prt-txt
     1530               with frame Dialog-Frame.
     1531          end.
     1532       end.
     1533   END.
     1534   find first ub.sys-ctrl.
     1535   if ub.sys-ctrl.db-num <> 0 then do:
     1536     message "Данная утилита может работать только в ГБД.".
     1537     return.
     1538   end.
     1539   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1540   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1541   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1542   on help of frame Dialog-Frame
     1543   do:
     1544     run gbl/app_help.p
     1545       (input this-procedure :file-name
     1546       ,input ''
     1547       ,input ?
     1548       ) no-error.
     1549     if error-status :error then do:
     1550       message
     1551         "Ошибка при вызове помощи"
     1552         error-status :get-message(1)
     1553         view-as alert-box .
     1554     end.
     1555   end.
     1556   run minbtn-set in this-procedure .
     1557   on choose of b-help in frame Dialog-Frame
     1558   do:
     1559     apply "help":u to frame Dialog-Frame .
     1560   end.
     1561   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1562   procedure minbtn-set :
     1563       do
     1564           on error undo, return error return-value
     1565           :
     1566           define variable ii              as integer       no-undo .
     1567           define variable fh              as widget-handle no-undo .
     1568           define variable hh              as widget-handle no-undo .
     1569           define variable v-h             as handle        extent 4 no-undo .
     1570           define variable v-name-button   as character     no-undo .
     1571           define variable v-help-old-x    as decimal       no-undo .
     1572           define variable v-help-old-y    as decimal       no-undo .
     1573           define variable v-help-old-size as decimal       no-undo .
     1574           define variable v-frame-width   as decimal       no-undo .
     1575           define variable jj              as integer       no-undo .
     1576           do
     1577               on error undo, return error
     1578               :
     1579               assign
     1580                   v-frame-width = frame Dialog-Frame:width - 0.3
     1581                   fh            = frame Dialog-Frame:first-child
     1582                   hh            = fh:first-child
     1583                   ii            = 1
     1584                   .
     1585               do while valid-handle(hh):
     1586                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1587                   do:
     1588                       case lc(hh:name) :
     1589                           when "b-help" then
     1590                               do:
     1591                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1592                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1593                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1594                                   hh:TOOLTIP = "Помощь" .
     1595                                   v-help-old-x = hh:column .
     1596                                   v-help-old-y = hh:row    .
     1597                                   v-help-old-size = hh:width .
     1598                                   hh:width-chars = 2.5 .
     1599                               end.
     1600                           when "b-print" then
     1601                               do:
     1602                                   hh:load-image("cmp/b-print.bmp":u) .
     1603                                   hh:TOOLTIP = "Печать" .
     1604                                   v-h[ii] = hh:handle .
     1605                                   ii = ii + 1 .
     1606                                   hh:width-chars = 3 .
     1607                               end.
     1608                           when "b-history" or
     1609                           when "b-hist" then
     1610                               do:
     1611                                   hh:load-image("cmp/b-hist.bmp":u) .
     1612                                   hh:TOOLTIP = "История" .
     1613                                   v-h[ii] = hh:handle .
     1614                                   ii = ii + 1 .
     1615                                   hh:width-chars = 3 .
     1616                               end.
     1617                           when "b-sch" then
     1618                               do:
     1619                                   hh:load-image("cmp/b-sch.bmp":u) .
     1620                                   hh:TOOLTIP = "Установка Фильтра" .
     1621                                   v-h[ii] = hh:handle .
     1622                                   ii = ii + 1 .
     1623                                   hh:width-chars = 3 .
     1624                               end.
     1625                           when "b-hist-user" then
     1626                               do:
     1627                                   hh:load-image("cmp/b-hist.bmp":u) .
     1628                                   hh:TOOLTIP = "История пользователя" .
     1629                                   ii = ii + 1 .
     1630                               end.
     1631                       end case.
     1632                   end.
     1633                   hh = hh:next-sibling.
     1634               end.
     1635               b-help:column = v-frame-width - b-help:width-chars.
     1636               jj = 0.
     1637               repeat ii = 4 to 1 by -1 :
     1638                   if valid-handle (v-h[ii] ) then
     1639                   do:
     1640                       jj  = jj + 1 .
     1641                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1642                       v-h[ii]:row    = v-help-old-y .
     1643                   end.
     1644               end.
     1645           end.
     1646       end.
     1647   end procedure.
     1648   MAIN-BLOCK:
     1649   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1650      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1651   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652     run mainmenu_getcntxt in parparentproc
     1653       (output v-cntxt-db-num
     1654       ,output v-cntxt-userid
     1655       ,output v-cntxt-level
     1656       ,output v-cntxt-host-code-obj
     1657       ,output v-cntxt-obj-type
     1658       ,output v-cntxt-obj-code
     1659       ,output v-cntxt-db-num-obj
     1660       ,output v-cntxt-is-admin
     1661       ) .
     1662     RUN enable_UI.
     1663     WAIT-FOR GO OF FRAME Dialog-Frame.
     1664   END.
     1665   RUN disable_UI.
     1666   PROCEDURE disable_UI :
     1667     DISPLAY R-S-stop File-txt Cli-code Cli-type Cli-Name grp-txt city1 city2
     1668             measure-txt1 measure-txt2 measure-txt3 prt-txt
     1669         WITH FRAME Dialog-Frame.
     1670     ENABLE File R-S-stop Btn_Cancel File-txt Cli-code Cli-type Cli-Name grp-txt
     1671            city1 city2 measure-txt1 measure-txt2 measure-txt3 prt-txt
     1672         WITH FRAME Dialog-Frame.
     1673     VIEW FRAME Dialog-Frame.
     1674   END PROCEDURE.
     1675   PROCEDURE enable_UI :
     1676     DISPLAY R-S-stop File-txt Cli-code Cli-type Cli-Name grp-txt city1 city2
     1677             measure-txt1 measure-txt2 measure-txt3 prt-txt
     1678         WITH FRAME Dialog-Frame.
     1679     ENABLE File R-S-stop Btn_Cancel File-txt Cli-code Cli-type Cli-Name grp-txt
     1680            city1 city2 measure-txt1 measure-txt2 measure-txt3 prt-txt
     1681         WITH FRAME Dialog-Frame.
     1682     VIEW FRAME Dialog-Frame.
     1683   END PROCEDURE.
     1684   PROCEDURE get-node-code :
     1685   define input parameter p-search-name  as character    no-undo.
     1686   define output parameter cod-grp  like ub.gds-grp.node-code no-undo.
     1687   define variable p-fill-path     as logical          no-undo.
     1688   define variable v-upper-code    as integer          no-undo.
     1689   define variable v-not-found     as logical init yes no-undo.
     1690   define variable v-counter       as integer          no-undo.
     1691   define variable v-level         as integer          no-undo.
     1692   define variable v-full-name     as character        no-undo.
     1693   define buffer buf_gds-grp       for ub.gds-grp.
     1694   cod-grp = ?.
     1695   run grplib-get-root-code ( output v-upper-code ) no-error .
     1696   if error-status :error  then do:
     1697           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1698   end.
     1699   assign
     1700       v-full-name  = ""
     1701       v-level      = num-entries( p-search-name, chr(47) ) .
     1702   for each temp_grplib_found-grp    :
     1703       delete temp_grplib_found-grp.
     1704   end.
     1705   start-name-analyze:
     1706   do v-counter = 1 to v-level :
     1707       if v-counter < v-level  then do:
     1708               find first buf_gds-grp no-lock
     1709                    where buf_gds-grp.upper-code = v-upper-code
     1710                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(47) )
     1711               no-error .
     1712               if not available buf_gds-grp   then do:
     1713                   assign
     1714                       v-full-name  = p-search-name
     1715                   .
     1716               end.
     1717               else do:
     1718                   assign
     1719                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47)) + buf_gds-grp.node-name
     1720                       v-upper-code = buf_gds-grp.node-code
     1721                   .
     1722                   if p-fill-path = yes
     1723                   then do:
     1724                       create temp_grplib_found-grp.
     1725                       assign
     1726                           temp_grplib_found-grp.full-name = v-full-name
     1727                           temp_grplib_found-grp.node-code = v-upper-code
     1728                           temp_grplib_found-grp.level     = v-counter
     1729                       .
     1730                   end.
     1731               end.
     1732       end.
     1733       else do:
     1734               for each buf_gds-grp no-lock
     1735                  where buf_gds-grp.upper-code = v-upper-code
     1736                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(47) )
     1737               :
     1738                   assign
     1739                       v-not-found = no
     1740                   .
     1741                   create temp_grplib_found-grp.
     1742                   assign
     1743                       temp_grplib_found-grp.full-name = v-full-name
     1744                                                           + (if v-full-name = "" then "" else chr(47))
     1745                                                           + buf_gds-grp.node-name
     1746                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1747                       temp_grplib_found-grp.level     = v-level
     1748                   .
     1749               end.
     1750               if v-not-found = yes   then do:
     1751                   assign
     1752                       v-full-name  = p-search-name
     1753                   .
     1754                   for each temp_grplib_found-grp
     1755                   :
     1756                       delete temp_grplib_found-grp.
     1757                   end.
     1758               end.
     1759       end.
     1760   end.
     1761   for each temp_grplib_found-grp no-lock:
     1762     assign cod-grp =  temp_grplib_found-grp.node-code.
     1763   end.
     1764   END PROCEDURE.
     1765   PROCEDURE grplib-get-root-code :
     1766   do
     1767   on error undo, return error
     1768   :
     1769   define output parameter p-root-code as integer      no-undo.
     1770   define buffer buf_gds-grp       for ub.gds-grp.
     1771       find first buf_gds-grp no-lock
     1772           where buf_gds-grp.upper-code = 0
     1773       no-error .
     1774       if not available buf_gds-grp
     1775       then do:
     1776           undo, return error .
     1777       end.
     1778       else do:
     1779           assign
     1780               p-root-code = buf_gds-grp.node-code
     1781           .
     1782       end.
     1783   end.
     1784   END PROCEDURE.
     1785   PROCEDURE next-good :
     1786   define output parameter reply-out as log   no-undo.
     1787     assign
     1788         i-artic = ""
     1789         i-name = ""
     1790         i-engl-name = ""
     1791         i-lab-name = ""
     1792         i-SLT-code = 0
     1793         i-unit-base = ""
     1794         i-VAT-code = 0
     1795         i-11 = ""
     1796         i-22 = ""
     1797         i-33 = ""
     1798         i-44 = ""
     1799         i-struct = ""
     1800         i-grp-code = 0
     1801         i-grp-name = ""
     1802         i-city = ""
     1803         i-gds-prt = 0
     1804         i-client-type = ""
     1805         i-client-code = 0
     1806         reply-out = true
     1807     .
     1808     assign
     1809       i-artic = ENTRY(p-artic, text-string, ";")
     1810       i-name  = ENTRY(p-name,  text-string, ";")
     1811     .
     1812     if p-engl-name > 0  then
     1813           assign  i-engl-name = ENTRY(p-engl-name, text-string, ";").
     1814     if p-lab-name > 0  then
     1815           assign  i-lab-name = ENTRY(p-lab-name, text-string, ";").
     1816     if p-struct > 0  then  assign i-struct = ENTRY(p-struct, text-string, ";").
     1817     ASSIGN
     1818       NDS = ?
     1819       NP  = ?
     1820     .
     1821     if p-VAT-code > 0 then do:
     1822          assign   i-vat-code = integer(ENTRY(p-vat-code, text-string, ";")).
     1823          find last ub.tax-rate-value where
     1824                    ub.tax-rate-value.tax-code  = 1 and
     1825                    ub.tax-rate-value.rate-code = i-vat-code no-lock no-error.
     1826          IF NOT available ub.tax-rate-value then do:
     1827               put stream err "Нет в БД ставки НДС с кодом "
     1828                       i-vat-code
     1829               skip.
     1830               export stream  err text-string .
     1831               assign reply-out = false.
     1832               return .
     1833          END.
     1834          else NDS = ub.tax-rate-value.rate-code.
     1835     end.
     1836     else do:
     1837          find last ub.tax-rate-value where
     1838                    ub.tax-rate-value.tax-code  = 1 and
     1839                    ub.tax-rate-value.rate-code = 1 no-lock no-error.
     1840          assign
     1841            i-VAT-code =  ub.tax-rate-value.rate-code.
     1842            NDS = ub.tax-rate-value.rate-code
     1843          .
     1844     end.
     1845     if p-SLT-code > 0  then do:
     1846          assign   i-SLT-code = integer(ENTRY(p-SLT-code, text-string, ";")).
     1847          find last ub.tax-rate-value where
     1848                    ub.tax-rate-value.tax-code  = 2 and
     1849                    ub.tax-rate-value.rate-code = i-SLT-code no-lock no-error.
     1850          IF NOT available ub.tax-rate-value then do:
     1851               put stream err "Нет в БД ставки НП "
     1852                       i-SLT-code
     1853               skip.
     1854               export stream  err text-string .
     1855               assign reply-out = false.
     1856               return .
     1857          END.
     1858          else  NP = tax-rate-value.rate-code .
     1859     end.
     1860     else do:
     1861          find last ub.tax-rate-value where
     1862                    ub.tax-rate-value.tax-code  = 2 and
     1863                    ub.tax-rate-value.rate-code = 22 no-lock no-error.
     1864          assign
     1865            i-SLT-code = ub.tax-rate-value.rate-code
     1866            NP = ub.tax-rate-value.rate-code
     1867          .
     1868     end.
     1869     if p-unit-base > 0  then do:
     1870          FIND FIRST ub.units NO-LOCK where
     1871             ub.units.unit-name = ENTRY(p-unit-base, text-string, ";")
     1872          No-ERROR.
     1873          IF NOT available ub.units then do:
     1874               put stream err "Нет в БД единицы измерения "
     1875                       ENTRY(p-unit-base, text-string, ";")
     1876               skip.
     1877               export stream  err text-string .
     1878               assign reply-out = false.
     1879               return .
     1880          END.
     1881          assign  i-unit-base = ENTRY(p-unit-base, text-string, ";").
     1882     end.
     1883     if p-grp > 0  then do:
     1884          assign i-grp-name = ENTRY(p-grp, text-string, ";").
     1885          run get-node-code (input i-grp-name, output i-grp-code) .
     1886          FIND FIRST ub.gds-grp NO-LOCK where
     1887                     ub.gds-grp.node-code = i-grp-code
     1888          No-ERROR.
     1889          IF NOT available ub.gds-grp then do:
     1890                  put stream err "Нет в БД такой группы товаров "
     1891                      ENTRY(p-grp, text-string, ";") format "x(50)"
     1892                  skip.
     1893                  export stream  err text-string .
     1894                  assign
     1895                    i-grp-name = ""
     1896                    i-grp-code = 0.
     1897                    reply-out = false
     1898                  .
     1899                  return .
     1900          END.
     1901     end.
     1902     if p-city > 0  then  do:
     1903         assign i-city = ENTRY(p-city, text-string, ";").
     1904         if trim(i-city) <> "" then do:
     1905            find first ub.country where
     1906                       ub.country.alpha1 = i-city no-lock no-error.
     1907            if not available ub.country then do:
     1908                put stream err "Нет в БД такой страны "
     1909                       i-city
     1910                skip.
     1911                export stream  err text-string .
     1912                assign
     1913                   i-city = ""
     1914                   reply-out = false
     1915                .
     1916                return.
     1917            end.
     1918         end.
     1919     end.
     1920     if p-client > 0  then  do:
     1921        assign
     1922            i-client-type = "орг"
     1923            i-client-code = integer(ENTRY(p-client, text-string, ";")).
     1924        find first ub.clients where
     1925                   ub.clients.obj-type = i-client-type  and
     1926                   ub.clients.obj-code = i-client-code no-lock no-error.
     1927        if not available ub.clients then do:
     1928             put stream err "Нет в БД такого производителя "
     1929                       i-client-code
     1930            skip.
     1931            export stream  err text-string .
     1932            assign
     1933               i-client-type = ""
     1934               i-client-code = 0
     1935               reply-out = false
     1936            .
     1937            return .
     1938        end.
     1939     end.
     1940     if p-gds-prt > 0  then   do:
     1941            find first ub.gds-prt where
     1942                 ub.gds-prt.root = TRUE and
     1943                 ub.gds-prt.node-name = ENTRY(p-gds-prt, text-string, ";")  no-lock no-error.
     1944            if  not  available  ub.gds-prt  then do:
     1945                put stream err "Нет в БД такой шкалы "
     1946                       ENTRY(p-gds-prt, text-string, ";")
     1947                skip.
     1948                export stream  err text-string .
     1949                assign
     1950                    i-gds-prt = 0
     1951                    reply-out = false
     1952                .
     1953                return.
     1954            end.
     1955            else i-gds-prt = ub.gds-prt.prt-root .
     1956     end.
     1957     if p-struct > 0  then  assign i-struct = ENTRY(p-struct, text-string, ";").
     1958     if p-11 > 0  then  assign i-11 = ENTRY(p-11, text-string, ";").
     1959     if p-22 > 0  then  assign i-22 = ENTRY(p-22, text-string, ";").
     1960     if p-33 > 0  then  assign i-33 = ENTRY(p-33, text-string, ";").
     1961     if p-44 > 0  then  assign i-44 = ENTRY(p-44, text-string, ";").
     1962   END PROCEDURE.
