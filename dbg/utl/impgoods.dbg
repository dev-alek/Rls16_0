      871   procedure grplib-get-full-name :
      872      define input parameter p-node-code  as integer      no-undo.
      873      define output parameter p-full-name as character    no-undo.
      874      do
      875   on error undo, return error
      876   :
      877       define variable v-upper-code    as integer           no-undo.
      878       define buffer buf_gds-grp       for ub.gds-grp.
      879       define buffer buf_upper_gds-grp for ub.gds-grp.
      880       find first buf_gds-grp no-lock
      881            where buf_gds-grp.node-code = p-node-code
      882       no-error.
      883       if not available buf_gds-grp
      884       then do:
      885           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      886       end.
      887       assign
      888           p-full-name  = ""
      889           v-upper-code = 1
      890       .
      891       do while buf_gds-grp.upper-code <> 0
      892       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      893       :
      894           assign
      895               p-full-name  = buf_gds-grp.node-name
      896                            + (if p-full-name <> "" then chr(47) else "")
      897                            + p-full-name
      898               v-upper-code = buf_gds-grp.upper-code
      899           .
      900           find first buf_gds-grp no-lock
      901                where buf_gds-grp.node-code = v-upper-code
      902           no-error.
      903           if not available buf_gds-grp
      904           then do:
      905               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      906                                   + string( v-upper-code )
      907                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      908           end.
      909       end.
      910       assign
      911       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      912       .
      913   end.
      914   end .
      915   procedure grplib-get-node-from-full-name :
      916   define input parameter p-full-name as character no-undo .
      917   define output parameter p-node-code as integer no-undo .
      918   define variable v-ii as integer no-undo .
      919   define variable v-upper-code as integer no-undo .
      920   define variable v-root-code as integer no-undo .
      921   define variable v-entry as character no-undo .
      922   define buffer buf_gds-grp       for ub.gds-grp.
      923   do
      924   on error undo, return error
      925   :
      926     find first buf_gds-grp no-lock
      927         where buf_gds-grp.upper-code = 0
      928     no-error .
      929     if not available buf_gds-grp
      930     then do:
      931         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      932     end.
      933     else do:
      934       assign
      935       v-root-code = buf_gds-grp.node-code
      936       .
      937     end.
      938     v-upper-code = v-root-code.
      939     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      940       assign
      941       v-entry = entry(v-ii, p-full-name, chr(47)).
      942       if v-entry = '' then leave.
      943       find first buf_gds-grp no-lock where
      944                 buf_gds-grp.node-name = v-entry
      945             and buf_gds-grp.upper-code = v-upper-code
      946             no-error.
      947       if not available buf_gds-grp then do:
      948         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      949       end.
      950       else do:
      951         p-node-code = buf_gds-grp.node-code.
      952         v-upper-code = buf_gds-grp.node-code.
      953       end.
      954     end.
      955   end.
      956   end .
