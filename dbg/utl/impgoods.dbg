        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Импорт товаров".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure gen-b-code :
      124     define input  parameter type-code like ub.code-range.range-type no-undo .
      125     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      126     do
      127     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      128     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      129     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      130     :
      131       define buffer buf_thbj-attr     for ub.thbj-attr .
      132       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      133       define buffer buf_code-range for ub.code-range .
      134       define variable l-code         as   integer              no-undo .
      135       define variable v-db-num       like ub.db.db-num         no-undo .
      136       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      137       if type-code = 'sslc':U
      138       or type-code = 'ssgb':U
      139       then do:
      140         message
      141           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      142           "Обратитесь к администратору системы."
      143           view-as alert-box error .
      144         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      145       end.
      146       run trg/getpcode.p ( input  type-code
      147                      ,output cfg-param-code
      148                     ).
      149       run get-next-seq( input  type-code,
      150                         output l-code
      151                       ).
      152       find first buf_sys-ctrl no-lock.
      153       if type-code = 'sclc':U
      154       or type-code = 'pglc':U
      155       then do:
      156         assign
      157           v-db-num = 0
      158         .
      159       end.
      160       else do:
      161         assign
      162           v-db-num = buf_sys-ctrl.db-num
      163         .
      164       end.
      165       find first buf_code-range no-lock
      166         where buf_code-range.db-num     = v-db-num
      167           and buf_code-range.range-type = type-code
      168           and buf_code-range.stts       = "a"
      169         use-index stts
      170         no-error .
      171       if available buf_code-range
      172          and l-code <= buf_code-range.last-code
      173          and l-code >= buf_code-range.first-code then do:
      174         assign
      175           p-b-code = l-code
      176         .
      177       end.
      178       else do:
      179         if available buf_code-range
      180            and l-code < buf_code-range.last-code then do:
      181           message
      182             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      183             "Обратитесь к администратору системы."
      184             view-as alert-box error .
      185           undo, return error "sequence":U .
      186         end.
      187         do transaction
      188         on error undo, return error
      189         :
      190           find first buf_thbj-attr exclusive-lock
      191             where buf_thbj-attr.upper-prop-code = 'code-range':U
      192               and buf_thbj-attr.prop-code = cfg-param-code
      193               and buf_thbj-attr.obj-type   = 'БД':U
      194               and buf_thbj-attr.obj-code   = v-db-num
      195             no-error .
      196           if not available buf_thbj-attr then do:
      197             find first buf_thbj-attr exclusive-lock
      198               where buf_thbj-attr.upper-prop-code = 'code-range':U
      199                 and buf_thbj-attr.prop-code = cfg-param-code
      200                 and buf_thbj-attr.obj-type   = ''
      201                 and buf_thbj-attr.obj-code   = 0
      202               no-error .
      203             if not available buf_thbj-attr then do:
      204               if not locked buf_thbj-attr then do:
      205                 message
      206                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      207                   "Обратитесь к администратору системы."
      208                   view-as alert-box error .
      209               end.
      210               undo, return error "config":U .
      211             end.
      212           end.
      213           run get-next-seq( input type-code,
      214                             output l-code
      215                           ).
      216           find first buf_code-range
      217             where buf_code-range.db-num     = v-db-num
      218               and buf_code-range.range-type = type-code
      219               and buf_code-range.stts       = "a"
      220             use-index stts
      221             no-error .
      222           if available buf_code-range
      223           and l-code <= buf_code-range.last-code
      224           and l-code >= buf_code-range.first-code
      225           then do:
      226             assign
      227               p-b-code = l-code
      228             .
      229           end.
      230           else do:
      231             if available buf_code-range then do:
      232               assign
      233                 buf_code-range.stts = "u"
      234               .
      235             end.
      236             find first buf_code-range
      237               where buf_code-range.db-num     = v-db-num
      238                 and buf_code-range.range-type = type-code
      239                 and buf_code-range.stts       = "f"
      240               use-index stts
      241               no-error .
      242             if not available buf_code-range then do:
      243               message
      244                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      245                 "Обратитесь к администратору системы"
      246                 view-as alert-box error .
      247               undo, return error "code-range":U .
      248             end.
      249             assign
      250               buf_code-range.stts           = "a"
      251             .
      252             if buf_code-range.first-code = 1 then do:
      253               run set-seq-cr( input type-code,
      254                               input buf_code-range.first-code
      255                             ).
      256               assign
      257                 p-b-code = 1
      258               .
      259             end.
      260             else do:
      261               run set-seq-cr( input type-code,
      262                               input ( buf_code-range.first-code - 1 )
      263                             ).
      264               run get-next-seq( input type-code,
      265                                 output p-b-code
      266                               ).
      267             end.
      268           end.
      269         end.
      270       end.
      271     end.
      272   end procedure.
      273   procedure get-next-seq :
      274     define input  parameter type-code like ub.code-range.range-type no-undo .
      275     define output parameter next-seq  as   integer                  no-undo .
      276     do
      277     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      278     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      279     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      280     :
      281       case type-code:
      282         when 'bcgb':U then do:
      283           assign
      284             next-seq = next-value(s-bcgb-code, ub)
      285           .
      286         end.
      287         when 'scgb':U then do:
      288           assign
      289             next-seq = next-value(s-scgb-code, ub)
      290           .
      291         end.
      292         when 'sclc':U then do:
      293           assign
      294             next-seq = next-value(s-sclc-code, ub)
      295           .
      296         end.
      297         when 'pglc':U then do:
      298           assign
      299             next-seq = next-value(s-pglc-code, ub)
      300           .
      301         end.
      302         when 'dcgb':U then do:
      303           assign
      304             next-seq = next-value(s-dcgb-code, ub)
      305           .
      306         end.
      307         when 'ctgb':U then do:
      308           assign
      309             next-seq = next-value(s-ctgb-code, ub)
      310           .
      311         end.
      312         when 'drgb':U then do:
      313           assign
      314             next-seq = next-value(s-drgb-code, ub)
      315           .
      316         end.
      317         when 'fmgb':U then do:
      318           assign
      319             next-seq = next-value(s-fmgb-code, ub)
      320           .
      321         end.
      322         when 'pngb':U then do:
      323           assign
      324             next-seq = next-value(s-pngb-code, ub)
      325           .
      326         end.
      327         when 'cagb':U then do:
      328           assign
      329             next-seq = next-value(s-cagb-code, ub)
      330           .
      331         end.
      332         when 'fdgb':U then do:
      333           assign
      334             next-seq = next-value(s-fin-doc, ub)
      335           .
      336         end.
      337       end case.
      338     end.
      339   end procedure.
      340   procedure set-seq-cr :
      341     define input parameter type-code like ub.code-range.range-type no-undo .
      342     define input parameter set-val   like ub.code-range.first-code no-undo .
      343     do
      344     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      345     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      346     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      347     :
      348       case type-code:
      349         when 'bcgb':U then do:
      350           assign
      351             current-value(s-bcgb-code, ub) = set-val
      352           .
      353         end.
      354         when 'scgb':U then do:
      355           assign
      356             current-value(s-scgb-code, ub) = set-val
      357           .
      358         end.
      359         when 'sclc':U then do:
      360           assign
      361             current-value(s-sclc-code, ub) = set-val
      362           .
      363         end.
      364         when 'pglc':U then do:
      365           assign
      366             current-value(s-pglc-code, ub) = set-val
      367           .
      368         end.
      369         when 'dcgb':U then do:
      370           assign
      371             current-value(s-dcgb-code, ub) = set-val
      372           .
      373         end.
      374         when 'ctgb':U then do:
      375           assign
      376             current-value(s-ctgb-code, ub) = set-val
      377           .
      378         end.
      379         when 'drgb':U then do:
      380           assign
      381             current-value(s-drgb-code, ub) = set-val
      382           .
      383         end.
      384         when 'fmgb':U then do:
      385           assign
      386             current-value(s-fmgb-code, ub) = set-val
      387           .
      388         end.
      389         when 'pngb':U then do:
      390           assign
      391             current-value(s-pngb-code, ub) = set-val
      392           .
      393         end.
      394         when 'cagb':U then do:
      395           assign
      396             current-value(s-cagb-code, ub) = set-val
      397           .
      398         end.
      399         when 'fdgb':U then do:
      400           assign
      401             current-value(s-fin-doc, ub) = set-val
      402           .
      403         end.
      404       end case.
      405     end.
      406   end procedure.
      407   procedure new-bcod-gen-code-range :
      408     do
      409     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      410     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      411     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      412     :
      413       define input parameter p-db-num  like ub.db.db-num             no-undo .
      414       define input parameter type-code like ub.code-range.range-type no-undo .
      415       define buffer buf_code-range      for ub.code-range .
      416       define buffer last_code-range     for ub.code-range .
      417       define buffer last-1_code-range   for ub.code-range .
      418       define buffer last-2_code-range   for ub.code-range .
      419       define buffer last-3_code-range   for ub.code-range .
      420       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      421       define variable conf-par       as character no-undo .
      422       define variable par-type       as character no-undo .
      423       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      424       define variable v-cre-cdrg as logical   no-undo .
      425       define variable v-cre-str  as character no-undo .
      426       define variable v-cr1      as integer no-undo .
      427       define variable v-cr2      as integer no-undo .
      428       define variable v-cr3      as integer no-undo .
      429       define variable v-cmax     as integer no-undo .
      430       find first buf_sys-ctrl no-lock .
      431       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      432         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      433                                       ,vss-workfile
      434                                       ,vss-revision
      435                                       ,vss-description
      436                                       ,chr(10)
      437                                       , p-db-num
      438                                      ).
      439       end.
      440       run trg/getpcode.p ( input  type-code
      441                      ,output cfg-param-code
      442                     ).
      443       for each buf_code-range
      444         where buf_code-range.db-num     = -1
      445           and buf_code-range.range-type = type-code
      446           and buf_code-range.stts       = "f"
      447       by buf_code-range.first-code
      448       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      449       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      450       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      451       :
      452         assign
      453           buf_code-range.db-num = p-db-num
      454         .
      455         return .
      456       end.
      457       assign
      458         v-cre-cdrg = TRUE
      459       .
      460       case type-code:
      461         when 'sclc':U
      462         or when 'scgb':U
      463         or when 'pglc':U
      464         then do:
      465           find last last-1_code-range no-lock
      466             where last-1_code-range.range-type = 'sclc':U
      467             no-error .
      468           if available last-1_code-range then do:
      469             v-cr1 = last-1_code-range.last-code.
      470           end.
      471           find last last-2_code-range no-lock
      472             where last-2_code-range.range-type = 'scgb':U
      473             no-error .
      474           if available last-2_code-range then do:
      475             v-cr2 = last-2_code-range.last-code.
      476             end.
      477           find last last-3_code-range no-lock
      478             where last-3_code-range.range-type = 'pglc':U
      479             no-error .
      480           if available last-3_code-range then do:
      481             v-cr3 = last-3_code-range.last-code.
      482           end.
      483           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      484           .
      485           if v-cmax = v-cr1  then do:
      486               find last last_code-range no-lock
      487                 where recid( last_code-range ) = recid( last-1_code-range )
      488                 .
      489             end.
      490           if v-cmax = v-cr2  then do:
      491               find last last_code-range no-lock
      492                 where recid( last_code-range ) = recid( last-2_code-range )
      493                 .
      494             end.
      495           if v-cmax = v-cr3  then do:
      496             find last last_code-range no-lock
      497               where recid( last_code-range ) = recid( last-3_code-range )
      498               .
      499           end.
      500           if last_code-range.last-code + 1 > 99999 then do:
      501             assign
      502               v-cre-cdrg = FALSE
      503             .
      504           end.
      505         end.
      506         when 'bcgb':U
      507         or when 'sslc':U
      508         or when 'ssgb':U
      509         then do:
      510           find last last-1_code-range no-lock
      511             where last-1_code-range.range-type = 'sslc':U
      512             no-error .
      513           if available last-1_code-range then do:
      514             v-cr1 = last-1_code-range.last-code.
      515           end.
      516           find last last-2_code-range no-lock
      517             where last-2_code-range.range-type = 'bcgb':U
      518             no-error .
      519           if available last-2_code-range then do:
      520             v-cr2 = last-2_code-range.last-code.
      521             end.
      522           find last last-3_code-range no-lock
      523             where last-3_code-range.range-type = 'ssgb':U
      524             no-error .
      525           if available last-3_code-range then do:
      526             v-cr3 = last-3_code-range.last-code.
      527           end.
      528           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      529           .
      530           if v-cmax = v-cr1  then do:
      531               find last last_code-range no-lock
      532                 where recid( last_code-range ) = recid( last-1_code-range )
      533                 .
      534             end.
      535           if v-cmax = v-cr2  then do:
      536               find last last_code-range no-lock
      537                 where recid( last_code-range ) = recid( last-2_code-range )
      538                 .
      539             end.
      540           if v-cmax = v-cr3  then do:
      541             find last last_code-range no-lock
      542               where recid( last_code-range ) = recid( last-3_code-range )
      543               .
      544           end.
      545         end.
      546         otherwise do:
      547           find last last_code-range no-lock
      548             where last_code-range.range-type = type-code
      549             no-error .
      550         end.
      551       end case.
      552       if not available last_code-range then do:
      553         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      554                                       ,vss-workfile
      555                                       ,vss-revision
      556                                       ,vss-description
      557                                       , chr(10)
      558                                       , type-code
      559                                      ) .
      560       end.
      561       define variable v-mes0 as character no-undo .
      562       define variable v-param-type0 as character no-undo .
      563       define variable v-value-character0 as INTEGER no-undo .
      564       define variable v-value-date0 as date no-undo .
      565       define variable v-value-decimal0 as decimal no-undo .
      566       define variable v-value-integer0 AS integer no-undo .
      567       define variable v-value-logical0 AS LOGICAL no-undo .
      568       define variable v-tth0 as handle no-undo .
      569       run adm/shattri.p (
      570           input "get":U
      571           ,input  'БД':U
      572           ,input  p-db-num
      573           ,input  'code-range':U
      574           ,input  cfg-param-code
      575           ,output v-value-character0
      576           ,output v-value-date0
      577           ,output v-value-decimal0
      578           ,output v-value-integer0
      579           ,output v-value-logical0
      580           ,output v-param-type0
      581           ,INPUT-OUTPUT table-handle v-tth0
      582           ) no-error .
      583       if error-status :error then do:
      584         delete object v-tth0.
      585         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      586                            , error-status:get-message(1)
      587                            , chr(10)
      588                            , return-value ).
      589         undo, return error v-mes0.
      590       end.
      591       delete object v-tth0.
      592       if v-cre-cdrg = TRUE then do:
      593         create buf_code-range .
      594         assign
      595           buf_code-range.db-num     = p-db-num
      596           buf_code-range.range-type = type-code
      597           buf_code-range.stts       = "f"
      598           buf_code-range.first-code = last_code-range.last-code + 1
      599           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      600           v-cre-str = "Свободный диапазон успешно создан"
      601         .
      602       end.
      603       else do:
      604         assign
      605           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      606                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      607         .
      608       end.
      609     end.
      610     return v-cre-str .
      611   end procedure.
      612   procedure gen-new-code-range-if-neces :
      613     define input parameter v-db-num           like ub.db.db-num             no-undo .
      614     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      615     define input parameter v-cur-code         as   integer                  no-undo .
      616     define input parameter v-g#news           as   logical                  no-undo .
      617     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      618     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      619     do
      620     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      621     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      622     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      623     :
      624       define variable l-code-range-exist as logical   no-undo init false .
      625       define variable v-db-for-send      as character no-undo .
      626       define buffer buf_code-range  for ub.code-range .
      627       define buffer buf1_code-range for ub.code-range .
      628       define buffer buf_db          for ub.db .
      629       find first buf_code-range
      630         where buf_code-range.range-type = v-range-type
      631           and buf_code-range.last-code >= v-cur-code
      632         use-index last-codei
      633         no-error .
      634       if
      635       (
      636          available buf_code-range
      637          and
      638         (buf_code-range.db-num = v-db-num
      639           and
      640         buf_code-range.first-code <= v-cur-code
      641         )
      642       or
      643         (
      644           v-range-type = 'drgb':U
      645           AND
      646           v-cur-code = 0
      647         )
      648      )
      649      then do:
      650         assign
      651           l-code-range-exist = true
      652         .
      653         if v-g#news
      654         and buf_code-range.stts = "f" then do:
      655           assign
      656             buf_code-range.stts = "u"
      657           .
      658         end.
      659       end.
      660       if not l-code-range-exist
      661          and v-g#news-source-db <> 0
      662       then do:
      663         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      664                                       ,vss-workfile
      665                                       ,vss-revision
      666                                       ,vss-description
      667                                       ,chr(10)
      668                                       ,v-db-num
      669                                       ,v-range-type
      670                                       ,v-cur-code
      671                                      ).
      672       end.
      673       if (not l-code-range-exist
      674           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      675          )
      676       and ( not can-find (first buf1_code-range no-lock
      677                           where buf1_code-range.db-num = v-db-num
      678                             and buf1_code-range.range-type = v-range-type
      679                             and buf1_code-range.stts = "f"
      680                          )
      681           )
      682       then do:
      683         if v-g#db-num = 0 then do:
      684           run new-bcod-gen-code-range in this-procedure
      685             (input v-db-num,
      686              input v-range-type
      687             ) no-error .
      688           if error-status :error then do:
      689             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      690                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      691                                           ,v-db-num
      692                                           ,v-range-type
      693                                           ,v-cur-code
      694                                           ,chr(10)
      695                                           ,error-status:get-message(1)
      696                                           ,return-value
      697                                          ).
      698           end.
      699         end.
      700         else do:
      701           if v-range-type = 'sclc':U
      702           or v-range-type = 'pglc':U
      703           then do:
      704             assign
      705               v-db-for-send = "":U
      706             .
      707             if v-g#db-num = 0 then do:
      708               for each buf_db no-lock
      709                 where buf_db.db-num > 0
      710                   and buf_db.db-num <> v-g#news-source-db
      711               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      712               :
      713                 assign
      714                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      715                 .
      716               end.
      717               assign
      718                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      719               .
      720             end.
      721             else do:
      722               if not v-g#news then do:
      723                 assign
      724                   v-db-for-send = "0":U
      725                 .
      726               end.
      727             end.
      728             run nws/cr-route.p ( input 'send-cmd':U
      729                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      730                                  "code-range":U + chr(1) +
      731                                  (if v-range-type = 'sclc':U
      732                                   then string( current-value(s-sclc-code, ub))
      733                                   else string( current-value(s-pglc-code, ub))
      734                                   ) + chr(1) +
      735                                   v-range-type)
      736                           ,input ?
      737                           ,input v-db-for-send
      738                           ) no-error .
      739             if error-status :error then do:
      740               undo, return error return-value.
      741             end.
      742           end.
      743         end.
      744       end.
      745     end.
      746   end procedure.
      747   procedure cre-loc-sc-code-range :
      748     define input parameter v-cur-code as integer no-undo .
      749   define input parameter p-cdrg-type as character no-undo .
      750     do
      751     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      752     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      753     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      754     :
      755       define buffer buf_code-range for ub.code-range .
      756       find first buf_code-range
      757            where buf_code-range.range-type = p-cdrg-type
      758              and buf_code-range.first-code >= v-cur-code
      759            no-error .
      760       if not available buf_code-range then do:
      761         run new-bcod-gen-code-range in this-procedure
      762           ( input 0,
      763             input p-cdrg-type
      764           ) no-error .
      765         if error-status :error then do:
      766           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      767                                          + "Код &2&1&3 &4"
      768                                         , chr(10)
      769                                         , v-cur-code
      770                                         , error-status:get-message(1)
      771                                         , return-value
      772                                        ) .
      773         end.
      774       end.
      775     end.
      776   end procedure.
      777   procedure mark-used-if-need :
      778   define input parameter p-cur-code as integer no-undo .
      779   define input parameter p-range-type like ub.code-range.range-type no-undo .
      780   define input parameter p-db-num like ub.code-range.db-num no-undo .
      781     do
      782     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      783     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      784     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      785     :
      786       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      787       define buffer buf_code-range for ub.code-range .
      788       assign
      789       v-db-num = if p-range-type = 'sclc':U
      790                  then 0
      791                  else p-db-num
      792       .
      793   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   define buffer locK-batchprocess1 for ub.batchprocess.
      795   run gbl/lock-prc.p
      796       (input 'lscc':U
      797       ,input 0
      798       ,input 0
      799       ,input 0
      800       ,input ""
      801       ,input ""
      802       ,input ""
      803       ,input (
      804               ",,,Вкл/выкл лок. вес. кодов"
      805              )
      806       ,input true
      807       ,buffer lock-batchprocess1
      808       ) no-error .
      809     if error-status :error then do:
      810       message
      811         vss-workfile vss-revision vss-description skip
      812         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      813         view-as alert-box error .
      814       undo, return error .
      815     end.
      816       find first buf_code-range
      817            where buf_code-range.range-type = p-range-type
      818              and buf_code-range.first-code >= p-cur-code
      819              and buf_code-range.last-code <= p-cur-code
      820              and buf_code-range.db-num = v-db-num
      821            no-error .
      822       if not available buf_code-range then do:
      823         message
      824           vss-workfile vss-revision vss-description skip
      825           "Ошибка при создании поиске диапазона" skip
      826           "База данных" p-db-num skip
      827           "Код" p-cur-code skip
      828           "Тип" p-range-type
      829           error-status :get-message(1) skip
      830           return-value skip
      831           view-as alert-box error .
      832         undo, return error .
      833       end.
      834       if buf_code-range.stts = "f":U then do:
      835         assign
      836         buf_code-range.stts = "u":U
      837         .
      838       end.
      839     end.
      840   end procedure.
