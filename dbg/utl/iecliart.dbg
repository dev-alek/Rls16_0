      216               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      217               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      218               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      219                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      220               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      221         otherwise do:
      222           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      223         end.
      224       end CASE.
      225     end.
      226   end procedure.
      227   procedure uf-get :
      228     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      229     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      230     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      231     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      232     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      233     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      234     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      235     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      236     do
      237     on error undo, return error
      238     :
      239       define buffer buf_usr-flt for ubflt.usr-flt .
      240       define variable v-use-List_     as logical   no-undo .
      241       define variable v-type-List_     as character no-undo .
      242       define variable v-format-List_   as character no-undo .
      243       define variable v-use-Naim      as logical   no-undo .
      244       define variable v-type-Naim      as character no-undo .
      245       define variable v-format-Naim    as character no-undo .
      246       define variable v-use-print-graft as logical   no-undo .
      247       define variable v-use-sort-gr     as logical   no-undo .
      248       define variable v-use-type-price  as logical   no-undo .
      249       define variable v-use-type-val    as logical   no-undo .
      250       define variable v-label          as character no-undo .
      251       define variable v-tooltip        as character no-undo .
      252       define variable v-user-can-edit  as logical   no-undo .
      253       define variable v-output-display as logical   no-undo .
      254       define variable v-other          as character no-undo .
      255       run uf-name in this-procedure
      256          (input  entry(1, p-code, chr(4))
      257         ,output v-use-List_
      258         ,output v-type-List_
      259         ,output v-format-List_
      260         ,output v-use-Naim
      261         ,output v-type-Naim
      262         ,output v-format-Naim
      263         ,output v-use-print-graft
      264         ,output v-use-sort-gr
      265         ,output v-use-type-price
      266         ,output v-use-type-val
      267         ,output v-label
      268         ,output v-tooltip
      269         ,output v-user-can-edit
      270         ,output v-output-display
      271         ,output v-other
      272         ) no-error .
      273       if error-status :error then do:
      274         undo, return error return-value .
      275       end.
      276       find first buf_usr-flt no-lock where
      277                  buf_usr-flt.Call-point     = p-code AND
      278                  buf_usr-flt.user-name       = p-user-name
      279         no-error .
      280       if avail buf_usr-flt then do:
      281         assign
      282         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      283         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      284         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      285         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      286         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      287         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      288         .
      289       end.
      290       else do:
      291         assign
      292         p-List_        = (if v-use-List_       then "":U                    else ?)
      293         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      294         p-print-graft  = (if v-use-print-graft then no                      else ?)
      295         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      296         p-type-price   = (if v-use-type-price  then no                      else ?)
      297         p-type-val     = (if v-use-List_       then no                      else ?)
      298         .
      299       end.
      300     end.
      301   end procedure.
      302   procedure uf-set :
      303     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      304     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      305     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      306     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      307     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      308     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      309     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      310     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      311     do
      312     on error undo, return error
      313     :
      314       define buffer buf_usr-flt for ubflt.usr-flt .
      315       define variable v-use-List_     as logical   no-undo .
      316       define variable v-type-List_     as character no-undo .
      317       define variable v-format-List_   as character no-undo .
      318       define variable v-use-Naim      as logical   no-undo .
      319       define variable v-type-Naim      as character no-undo .
      320       define variable v-format-Naim    as character no-undo .
      321       define variable v-use-print-graft as logical   no-undo .
      322       define variable v-use-sort-gr   as logical   no-undo .
      323       define variable v-use-type-price as logical   no-undo .
      324       define variable v-use-type-val  as logical   no-undo .
      325       define variable v-tooltip        as character no-undo .
      326       define variable v-label          as character no-undo .
      327       define variable v-user-can-edit  as logical   no-undo .
      328       define variable v-output-display as logical   no-undo .
      329       define variable v-other          as character no-undo .
      330       run uf-name in this-procedure
      331         (input  entry(1, p-code, chr(4))
      332         ,output v-use-List_
      333         ,output v-type-List_
      334         ,output v-format-List_
      335         ,output v-use-Naim
      336         ,output v-type-Naim
      337         ,output v-format-Naim
      338         ,output v-use-print-graft
      339         ,output v-use-sort-gr
      340         ,output v-use-type-price
      341         ,output v-use-type-val
      342         ,output v-label
      343         ,output v-tooltip
      344         ,output v-user-can-edit
      345         ,output v-output-display
      346         ,output v-other
      347         ) no-error .
      348       if error-status :error then do:
      349         undo, return error return-value .
      350       end.
      351       find first buf_usr-flt where
      352                  buf_usr-flt.Call-point     = p-code AND
      353                  buf_usr-flt.user-name       = p-user-name
      354         no-error .
      355       if not avail buf_usr-flt then do:
      356           create buf_usr-flt .
      357           assign
      358           buf_usr-flt.call-point = p-code
      359           buf_usr-flt.user-name  = p-user-name
      360           .
      361       end.
      362       if avail buf_usr-flt then do:
      363        assign
      364        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      365        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      366        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      367        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      368        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      369        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      370       .
      371       release buf_usr-flt.
      372       end.
      373       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      374     end.
      375   end procedure.
      376   DEFINE BUTTON b-exit AUTO-GO
      377        LABEL "&Выход"
      378        SIZE 10 BY 1
      379        BGCOLOR 8 .
      380   DEFINE BUTTON b-exp
      381        LABEL "&Экспорт"
      382        SIZE 10 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON B-help
      385        LABEL "Помо&щь"
      386        SIZE 10 BY 1
      387        BGCOLOR 8 .
      388   DEFINE BUTTON b-imp
      389        LABEL "&Импорт"
      390        SIZE 10 BY 1
      391        BGCOLOR 8 .
      392   DEFINE BUTTON b-sel-file DEFAULT
      393        IMAGE-UP FILE "btn-down-arrow":U
      394        IMAGE-DOWN FILE "btn-down-arrow":U
      395        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      396        LABEL "":L
      397        size 2.5 by 1.08.
      398   DEFINE VARIABLE fi-filename AS CHARACTER FORMAT "X(256)":U
      399        LABEL "Файл"
      400        VIEW-AS FILL-IN
      401        SIZE 49 BY 1 NO-UNDO.
      402   DEFINE FRAME Dialog-Frame
      403        b-exit AT ROW 1 COL 1
      404        b-imp AT ROW 1 COL 11
      405        b-exp AT ROW 1 COL 21
      406        B-help AT ROW 1 COL 51
      407        fi-filename AT ROW 3 COL 7 COLON-ALIGNED
      408        b-sel-file at row 3 col 58.5
      409        SPACE(4.12) SKIP(1.79)
      410       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      411            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      412            TITLE "Импорт / Экспорт артикулов поставщика".
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON CHOOSE OF b-exp IN FRAME Dialog-Frame
      421   DO:
      422     assign
      423       fi-filename
      424     .
      425     if trim(fi-filename) = ""
      426     then do:
      427       message
      428         "Введите имя файла"
      429       view-as alert-box error.
      430       return no-apply.
      431     end.
      432     run proc-export in this-procedure no-error .
      433     if error-status :error
      434     then do:
      435       message
      436         "Ошибка экспорта!" skip
      437         trim( return-value ) skip
      438         trim( error-status :get-message(1) )
      439       view-as alert-box information.
      440       return no-apply.
      441     end.
      442   END.
      443   ON CHOOSE OF b-imp IN FRAME Dialog-Frame
      444   DO:
      445     assign
      446       fi-filename
      447     .
      448     if trim(fi-filename) = ""
      449     then do:
      450       message
      451         "Введите имя файла"
      452       view-as alert-box error.
      453       return no-apply.
      454     end.
      455     run proc-import in this-procedure no-error .
      456     if error-status :error
      457     then do:
      458       message
      459         "Ошибка импорта!" skip
      460         trim( return-value ) skip
      461         trim( error-status :get-message(1) )
      462       view-as alert-box information.
      463       return no-apply.
      464     end.
      465   END.
      466   ON CHOOSE OF b-sel-file IN FRAME Dialog-Frame
      467   DO:
      468     define variable v-filename as character no-undo.
      469     define variable v-log as logical no-undo.
      470     SYSTEM-DIALOG GET-FILE v-filename
      471                   TITLE   "Файл"
      472                   FILTERS "Все файлы (*.*)"    "*.*"
      473                   USE-FILENAME
      474                   UPDATE v-log.
      475     if not v-log then do:
      476       return no-apply .
      477     end.
      478     else do:
      479       assign
      480         fi-filename = v-filename
      481       .
      482       display
      483         fi-filename
      484       with frame Dialog-Frame.
      485     end.
      486   END.
      487   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      488   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      489   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   on help of frame Dialog-Frame
      491   do:
      492     run gbl/app_help.p
      493       (input this-procedure :file-name
      494       ,input ''
      495       ,input ?
      496       ) no-error.
      497     if error-status :error then do:
      498       message
      499         "Ошибка при вызове помощи"
      500         error-status :get-message(1)
      501         view-as alert-box .
      502     end.
      503   end.
      504   run minbtn-set in this-procedure .
      505   on choose of b-help in frame Dialog-Frame
      506   do:
      507     apply "help":u to frame Dialog-Frame .
      508   end.
      509   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   procedure minbtn-set :
      511       do
      512           on error undo, return error return-value
      513           :
      514           define variable ii              as integer       no-undo .
      515           define variable fh              as widget-handle no-undo .
      516           define variable hh              as widget-handle no-undo .
      517           define variable v-h             as handle        extent 4 no-undo .
      518           define variable v-name-button   as character     no-undo .
      519           define variable v-help-old-x    as decimal       no-undo .
      520           define variable v-help-old-y    as decimal       no-undo .
      521           define variable v-help-old-size as decimal       no-undo .
      522           define variable v-frame-width   as decimal       no-undo .
      523           define variable jj              as integer       no-undo .
      524           do
      525               on error undo, return error
      526               :
      527               assign
      528                   v-frame-width = frame Dialog-Frame:width - 0.3
      529                   fh            = frame Dialog-Frame:first-child
      530                   hh            = fh:first-child
      531                   ii            = 1
      532                   .
      533               do while valid-handle(hh):
      534                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      535                   do:
      536                       case lc(hh:name) :
      537                           when "b-help" then
      538                               do:
      539                                   hh:load-image-up("cmp/b-help.bmp":u) .
      540                                   hh:load-image-down("cmp/b-help.bmp":u) .
      541                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      542                                   hh:TOOLTIP = "Помощь" .
      543                                   v-help-old-x = hh:column .
      544                                   v-help-old-y = hh:row    .
      545                                   v-help-old-size = hh:width .
      546                                   hh:width-chars = 2.5 .
      547                               end.
      548                           when "b-print" then
      549                               do:
      550                                   hh:load-image("cmp/b-print.bmp":u) .
      551                                   hh:TOOLTIP = "Печать" .
      552                                   v-h[ii] = hh:handle .
      553                                   ii = ii + 1 .
      554                                   hh:width-chars = 3 .
      555                               end.
      556                           when "b-history" or
      557                           when "b-hist" then
      558                               do:
      559                                   hh:load-image("cmp/b-hist.bmp":u) .
      560                                   hh:TOOLTIP = "История" .
      561                                   v-h[ii] = hh:handle .
      562                                   ii = ii + 1 .
      563                                   hh:width-chars = 3 .
      564                               end.
      565                           when "b-sch" then
      566                               do:
      567                                   hh:load-image("cmp/b-sch.bmp":u) .
      568                                   hh:TOOLTIP = "Установка Фильтра" .
      569                                   v-h[ii] = hh:handle .
      570                                   ii = ii + 1 .
      571                                   hh:width-chars = 3 .
      572                               end.
      573                           when "b-hist-user" then
      574                               do:
      575                                   hh:load-image("cmp/b-hist.bmp":u) .
      576                                   hh:TOOLTIP = "История пользователя" .
      577                                   ii = ii + 1 .
      578                               end.
      579                       end case.
      580                   end.
      581                   hh = hh:next-sibling.
      582               end.
      583               b-help:column = v-frame-width - b-help:width-chars.
      584               jj = 0.
      585               repeat ii = 4 to 1 by -1 :
      586                   if valid-handle (v-h[ii] ) then
      587                   do:
      588                       jj  = jj + 1 .
      589                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      590                       v-h[ii]:row    = v-help-old-y .
      591                   end.
      592               end.
      593           end.
      594       end.
      595   end procedure.
      596   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   on F2 of frame Dialog-Frame anywhere do:
      598     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      599     return no-apply.
      600   end.
      601   MAIN-BLOCK:
      602   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      603      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      604     RUN my-enable in this-procedure .
      605     WAIT-FOR GO OF FRAME Dialog-Frame.
      606   END.
      607   RUN disable_UI.
      608   PROCEDURE disable_UI :
      609     HIDE FRAME Dialog-Frame.
      610   END PROCEDURE.
      611   PROCEDURE enable_UI :
      612     DISPLAY fi-filename
      613         WITH FRAME Dialog-Frame.
      614     ENABLE b-exit b-imp b-exp B-help fi-filename b-sel-file
      615         WITH FRAME Dialog-Frame.
      616     VIEW FRAME Dialog-Frame.
      617   END PROCEDURE.
      618   PROCEDURE my-disable :
      619   END PROCEDURE.
      620   PROCEDURE my-enable :
      621     define variable v-naim          as character        no-undo.
      622     define variable v-list          as character        no-undo.
      623     define variable v-print-graft   as logical          no-undo.
      624     define variable v-sort-gr       as logical          no-undo.
      625     define variable v-type-price    as logical          no-undo.
      626     define variable v-type-val      as logical          no-undo.
      627     define variable v-found         as logical          no-undo.
      628     define variable v-filename      as character        no-undo .
      629   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630     run mainmenu_getcntxt in parparentproc
      631       (output v-cntxt-db-num
      632       ,output v-cntxt-userid
      633       ,output v-cntxt-level
      634       ,output v-cntxt-host-code-obj
      635       ,output v-cntxt-obj-type
      636       ,output v-cntxt-obj-code
      637       ,output v-cntxt-db-num-obj
      638       ,output v-cntxt-is-admin
      639       ) .
      640     run uf-get ( input 'cus/iecliart.w':U
      641                   , input  v-cntxt-userid
      642                   , output v-list
      643                   , output v-naim
      644                   , output v-print-graft
      645                   , output v-sort-gr
      646                   , output v-type-price
      647                   , output v-type-val
      648                   ).
      649       assign
      650         fi-filename = v-list
      651       .
      652     display
      653       fi-filename
      654     with frame Dialog-Frame.
      655     enable
      656       b-exit
      657       b-imp
      658       b-exp
      659       b-help
      660       fi-filename
      661       b-sel-file
      662     with frame Dialog-Frame.
      663     view frame Dialog-Frame.
      664   END PROCEDURE.
      665   PROCEDURE proc-export :
      666   do
      667   on error undo, return error return-value
      668   :
      669     run proc-fltsave in this-procedure .
      670     run utl/expclia.p ( input parparentproc
      671                       , input fi-filename
      672                       ) .
      673   end.
      674   END PROCEDURE.
      675   PROCEDURE proc-import :
      676   do
      677   on error undo, return error return-value
      678   :
      679     run proc-fltsave in this-procedure .
      680     run utl/impclia.p ( input parparentproc
      681                       , input fi-filename
      682                       ) .
      683   end.
      684   END PROCEDURE.
      685   PROCEDURE proc-fltsave :
      686   do
      687   on error undo, return error return-value
      688   :
      689     define variable v-naim          as character        no-undo.
      690     define variable v-list          as character        no-undo.
      691     define variable v-print-graft   as logical          no-undo.
      692     define variable v-sort-gr       as logical          no-undo.
      693     define variable v-type-price    as logical          no-undo.
      694     define variable v-type-val      as logical          no-undo.
      695     define variable v-found         as logical          no-undo.
      696     assign
      697       v-list = trim( fi-filename )
      698     .
      699     run uf-set ( input 'cus/iecliart.w':U
      700                   , input v-cntxt-userid
      701                   , input v-list
      702                   , input v-naim
      703                   , input v-print-graft
      704                   , input v-sort-gr
      705                   , input v-type-price
      706                   , input v-type-val
      707                   ) .
      708   end.
      709   END PROCEDURE.
