      127   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      128   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      129   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      130   procedure uf-name :
      131     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      132     define output parameter p-use-List_     as logical   no-undo .
      133     define output parameter p-type-List_     as character no-undo .
      134     define output parameter p-format-List_   as character no-undo .
      135     define output parameter p-use-Naim      as logical   no-undo .
      136     define output parameter p-type-Naim      as character no-undo .
      137     define output parameter p-format-Naim    as character no-undo .
      138     define output parameter p-use-print-graft as logical   no-undo .
      139     define output parameter p-use-sort-gr   as logical   no-undo .
      140     define output parameter p-use-type-price as logical   no-undo .
      141     define output parameter p-use-type-val  as logical   no-undo .
