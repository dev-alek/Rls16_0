        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "файл-конвертер из формата POS в формат моб сканера".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define variable v-waitfram-action01         as character   no-undo .
      112   define variable v-waitfram-action02         as character   no-undo .
      113   define variable v-waitfram-action03         as character   no-undo .
      114   define variable mWaitFramTextBeg            as character   no-undo.
      115   define variable mWaitFramTextEnd            as character   no-undo.
      116   define variable mWaitFramView               as logical     no-undo.
      117   define variable mWaitProcEvent              as logical     no-undo init yes.
      118   define variable mWaitFramInterval           as integer     no-undo init 1 .
      119   define variable mWaitFramStop               as logical     no-undo.
      120   define variable mWaitFramStopUser           as logical     no-undo.
      121   define variable mWaitFramStopTimeOut        as logical     no-undo.
      122   define variable mWaitFramStartProc          as datetime-tz no-undo.
      123   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      124   define button B-WaitFramStop auto-end-key
      125        label "Стоп"
      126        size 10 by 1 tooltip "Остоновить процесс".
      127   define button B-viewProcInfo
      128        label "Информация"
      129        size 15 by 1 tooltip "Информация о процесс".
      130   define frame waitfram
      131     v-waitfram-action01 format "x(72)" no-label skip
      132     v-waitfram-action02 format "x(72)" no-label skip
      133     v-waitfram-action03 format "x(72)" no-label skip
      134     B-viewProcInfo
      135     B-WaitFramStop at row 4 col 30
      136     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      137     .
      138   define new global shared variable mBatchMode as logical no-undo init ?.
      139   define variable mFramBachModHandle as handle no-undo.
      140   mFramBachModHandle = frame waitfram:handle.
      141   define variable mFameOldVis as logical no-undo.
      142   define variable mVisCUrentVin as logical no-undo.
      143   if session:batch-mode
      144   then
      145      mBatchMode = yes.
      146   if mBatchMode = ? then do:
      147     mVisCUrentVin = current-window:visible.
      148     mFameOldVis = mFramBachModHandle:visible.
      149     mFramBachModHandle:visible  = yes.
      150     mBatchMode = mFramBachModHandle:visible ne yes.
      151     mFramBachModHandle:visible = mFameOldVis.
      152     current-window:visible = mVisCUrentVin.
      153   end.
      154    if  log-manager:logfile-name ne ?
      155     then DO:
      156         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      157         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      158         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      159     end.
      160   on choose of B-WaitFramStop in frame waitfram
      161   do:
      162     mWaitFramStop = yes.
      163     mWaitFramStopUser = yes.
      164   end.
      165   function waitfram-check-timeout returns logical():
      166      define variable vtime as int64 no-undo.
      167      if mWaitFramStopTimeOut
      168      then
      169         return yes.
      170      vtime = ( now - mWaitFramStartProc ) / 1000 .
      171      if     mWaitFramTimeOut ne ?
      172         and mWaitFramTimeOut ne 0
      173         and mWaitFramTimeOut lt vtime
      174      then do:
      175         mWaitFramStopTimeOut = yes.
      176      end.
      177      return mWaitFramStopTimeOut.
      178   end.
      179   procedure waitfram-hide :
      180     if not session:batch-mode
      181     then do
      182     on error undo, return error return-value
      183     :
      184       pause 0 before-hide .
      185       if not mBatchMode then
      186         hide frame waitfram .
      187     if     not mWaitFramView
      188        and mWaitProcEvent
      189     then
      190       process events .
      191     end.
      192   end procedure.
      193   procedure waitfram-show :
      194     define input  parameter p-message as character no-undo .
      195     define variable v-left-margin as integer   no-undo .
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       if length(p-message) <= 70 then do:
      201         assign
      202           v-left-margin = integer((70 - length(p-message)) / 2)
      203         .
      204         assign
      205           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      206         .
      207         assign
      208           v-waitfram-action01 = " "
      209           v-waitfram-action02 = " "
      210                                    + fill(" ", v-left-margin)
      211                                    + p-message
      212           v-waitfram-action03 = " "
      213         .
      214       end.
      215       else do:
      216         define variable vRindex1 as integer no-undo.
      217         define variable vRindex2 as integer no-undo.
      218         vRindex1 = r-index(p-message," ",70).
      219         if vRindex1 = 0
      220         then
      221            vRindex1 = 70.
      222         if length(p-message)  <= vRindex1 + 70 then do:
      223           assign
      224             v-waitfram-action01 = " "
      225             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      226             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      227           .
      228         end.
      229         else do:
      230           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      231           if vRindex2 <= vRindex1
      232           then
      233              vRindex2 = vRindex1 + 70.
      234           assign
      235             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      236             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      237             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      238           .
      239         end.
      240       end.
      241       B-viewProcInfo:visible   in frame waitfram = no.
      242       B-viewProcInfo:sensitive in frame waitfram = no.
      243       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      244       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      245       if  (   mWaitFramView
      246          or  mWaitProcEvent)
      247          and not mBatchMode
      248       then
      249          display
      250             v-waitfram-action01 skip
      251             v-waitfram-action02 skip
      252             v-waitfram-action03 skip
      253          with frame waitfram .
      254       if     mWaitFramView
      255          then do:
      256             if     mWaitFramInterval ne ?
      257                and not mBatchMode
      258             then
      259                wait-for go of frame waitfram pause mWaitFramInterval.
      260          end.
      261          else
      262             if     mWaitProcEvent
      263                and not mBatchMode
      264             then
      265                process events .
      266     end.
      267   end procedure.
      268      procedure waitfram-show-this:
      269         define input  parameter iInterval as int64 no-undo.
      270         define variable vtime as int64 no-undo.
      271         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      272         mWaitFramInterval = iInterval.
      273         run waitfram-show (substitute("&1&2 &3&4" ,
      274                                       mWaitFramTextBeg ,
      275                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      276                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      277                                       mWaitFramTextEnd
      278                                      )
      279                           ).
      280      end.
      281      procedure WaitFramRunPause:
      282         define input  parameter iInterval as dec no-undo.
      283         define variable vStart  as datetime-tz no-undo.
      284         define variable vend    as datetime-tz no-undo.
      285         define variable vint as int64 no-undo.
      286         define variable vOk as logical no-undo.
      287         vStart = now.
      288         vend   = vStart.
      289         publish "WaitFramPause" (iInterval,output vOk).
      290         vend   =  now.
      291         vint = vend - vStart.
      292         vint = iInterval - vint / 1000.
      293         if     not mWaitFramStop
      294            and (   vint > 0
      295                 or (    not vOk
      296                     and iInterval eq ?
      297                     )
      298                 )
      299         then
      300            run waitfram-show-this (iInterval).
      301         vend   =  now.
      302         vint = vend - vStart.
      303         vint = iInterval - vint / 1000.
      304         if     not mWaitFramStop
      305            and vint > 0
      306         then do:
      307            run gbl/pause.p (vint * 1000).
      308         end.
      309         if iInterval ne ?
      310         then
      311            publish "WaitFramStop".
      312         waitfram-check-timeout().
      313      end.
      314      procedure WaitFramWaitFor:
      315         define input  parameter iInterval as dec no-undo.
      316         assign
      317            mWaitFramStartProc   = now
      318            mWaitFramStopUser    = no
      319            mWaitFramStopTimeOut = no
      320         .
      321         block-wait:
      322         do while not mWaitFramStop:
      323            run WaitFramRunPause (iInterval).
      324            if  waitfram-check-timeout()
      325            then do:
      326               leave block-wait.
      327            end.
      328         end.
      329         run waitfram-hide.
      330      end.
      331   procedure waitfram-join :
      332     define input  parameter p-line-1  as character no-undo .
      333     define input  parameter p-line-2  as character no-undo .
      334     define input  parameter p-line-3  as character no-undo .
      335     define output parameter p-message as character no-undo .
      336     do
      337     on error undo, return error return-value
      338     :
      339       assign
      340         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      341                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      342                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      343       .
      344     end.
      345   end procedure.
      346   function waitfram-join-function returns character
      347     (input p-line-1 as character
      348     ,input p-line-2 as character
      349     ,input p-line-3 as character
      350     ).
      351     define variable v-message as character no-undo .
      352     run waitfram-join in this-procedure
      353       (input  p-line-1
      354       ,input  p-line-2
      355       ,input  p-line-3
      356       ,output v-message
      357       ) .
      358     return v-message .
      359   end function .
      360   DEFINE STREAM IN-stream.
      361   DEFINE STREAM OUT-stream.
      362   DEFINE temp-table cc no-undo
      363   FIELD f2 as char
      364   FIELD f3 as char
      365   FIELD f4 as char
      366   FIELD f5 as char
      367   FIELD f6 as char
      368   FIELD f8 as char
      369   INDEX pi is unique primary f2 f3 f4 f5 f6 f8.
      370   DEFINE BUTTON B-exit AUTO-GO
      371        LABEL "&Ввод"
      372        SIZE 10 BY 1
      373        BGCOLOR 8 .
      374   DEFINE BUTTON B-file-name
      375        IMAGE-UP FILE "btn-down-arrow":U
      376        IMAGE-DOWN FILE "btn-down-arrow":U
      377        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      378        LABEL ""
      379        SIZE 3 BY 1.
      380   DEFINE BUTTON B-file-name-2
      381        IMAGE-UP FILE "btn-down-arrow":U
      382        IMAGE-DOWN FILE "btn-down-arrow":U
      383        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      384        LABEL ""
      385        SIZE 3 BY 1.
      386   DEFINE BUTTON B-Help
      387        LABEL "Помо&щь"
      388        SIZE 10 BY 1
      389        BGCOLOR 8 .
      390   DEFINE BUTTON b-quit AUTO-END-KEY
      391        LABEL "&Отмена"
      392        SIZE 10 BY 1
      393        BGCOLOR 8 .
      394   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      395        LABEL "Файл для конвертации"
      396        VIEW-AS FILL-IN
      397        SIZE 25 BY 1 NO-UNDO.
      398   DEFINE VARIABLE file-name-2 AS CHARACTER FORMAT "X(256)":U
      399        LABEL "Файл для вывода"
      400        VIEW-AS FILL-IN
      401        SIZE 25 BY 1 NO-UNDO.
      402   DEFINE FRAME Dialog-Frame
      403        B-exit AT ROW 1 COL 1.13
      404        b-quit AT ROW 1 COL 11.13
      405        B-Help AT ROW 1 COL 54.88
      406        file-name AT ROW 4.75 COL 22.75 COLON-ALIGNED
      407        B-file-name AT ROW 4.79 COL 50.38
      408        B-file-name-2 AT ROW 6.67 COL 50.25
      409        file-name-2 AT ROW 6.75 COL 22.75 COLON-ALIGNED
      410        SPACE(15.38) SKIP(4.53)
      411       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      412            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      413            TITLE "Конвертер файлов из формата POS-IBM в формат моб.сканера MS15"
      414            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      415   ASSIGN
      416          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      417          FRAME Dialog-Frame:HIDDEN           = TRUE.
      418   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      419   DO:
      420     APPLY "END-ERROR":U TO SELF.
      421   END.
      422   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      423   DO:
      424   DEFINE variable s as char no-undo.
      425   DEFINE variable exist as logical no-undo.
      426   define variable n-entry as char no-undo extent 20.
      427   define variable ii as integer no-undo.
      428   if search(file-name) = ? OR search(file-name-2)  = ? then do:
      429       message "Не найден/ы файл/ы ввода/вывода!" view-as alert-box ERROR.
      430       return no-apply.
      431   END.
      432   run waitfram-show in this-procedure ("Ждите ...").
      433   input stream IN-STREAM from value(file-name) .
      434   output stream OUT-STREAM to value(file-name-2).
      435   REPEAT ON STOP UNDO, LEAVE ON ERROR UNDO, LEAVE ON END-KEY UNDO, LEAVE:
      436       import stream IN-STREAM unformatted s.
      437       if substr(s, 1, 2) <> "01"
      438       AND substr(s, 1, 2) <> "00"
      439       AND substr(s, 1, 2) <> "05"
      440       then NEXT.
      441       repeat:
      442           s = REPLACE(s, "  ", " ").
      443           if INDEX(s, "  ") = 0 then leave.
      444       end.
      445       DO ii = 1 to num-entries(s, " "):
      446           assign
      447           n-entry[ii] = entry(ii, s, " ")
      448           .
      449       END.
      450       DO ii = (num-entries(s, " ") + 1 ) to 20:
      451           assign
      452           n-entry[ii] = "".
      453       END.
      454       assign
      455       ii = num-entries(s, " ")    .
      456       CASE n-entry[1]:
      457           WHEN "00" then do:
      458               IF NOT CAN-FIND (FIRST cc No-LOCK WHERE
      459                                      cc.f2 = N-ENTRY[2] AND
      460                                      cc.f3 = N-ENTRY[3] AND
      461                                      cc.f4 = N-ENTRY[4] AND
      462                                      cc.f8 = N-ENTRY[8] AND
      463                                      cc.f6 = N-ENTRY[6] AND
      464                                      cc.f5 = N-ENTRY[5]) THEN DO:
      465                   create cc.
      466                   assign
      467                   exist = no
      468                   cc.f2 = N-ENTRY[2]
      469                   cc.f3 = N-ENTRY[3]
      470                   cc.f4 = N-ENTRY[4]
      471                   cc.f8 = N-ENTRY[8]
      472                   cc.f6 = N-ENTRY[6]
      473                   cc.f5 = N-ENTRY[5]
      474                   .
      475               END.
      476               ELSE
      477               assign
      478               exist = yes.
      479           END.
      480           WHEN "01" then do:
      481               IF NOT EXIST then
      482               PUT STREAM OUT-STREAM UNFORMATTED
      483               N-ENTRY[2]
      484               chr(44)
      485               REPLACE(N-ENTRY[4], "+", "")
      486               SKIP
      487               .
      488           END.
      489           WHEN "05" then do:
      490               IF NOT EXIST then
      491               PUT STREAM OUT-STREAM UNFORMATTED
      492               N-ENTRY[2]
      493               chr(44)
      494               N-ENTRY[3]
      495               SKIP
      496               .
      497           END.
      498       END CASE.
      499   END.
      500   input stream In-STREAM close.
      501   output stream OUT-STREAM close.
      502   run waitfram-hide in this-procedure .
      503   END.
      504   ON CHOOSE OF B-file-name IN FRAME Dialog-Frame
      505   DO:
      506       define variable v_os-file   AS CHAR NO-UNDO INIT "".
      507       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      508       SYSTEM-DIALOG GET-FILE v_os-file
      509           TITLE "Выберите файл для конвертации"
      510           FILTERS
      511             " Все спулы POS-IBM (fl*.*) " "fl*.*",
      512             " Все архивы спулов POS-IBM (*.spl) " "*.spl",
      513             " Все файлы (*.*) "                      "*.*"
      514           INITIAL-FILTER 1
      515           DEFAULT-EXTENSION ".*"
      516           USE-FILENAME
      517           MUST-EXIST
      518           UPDATE ll_commit
      519           .
      520       IF ll_commit <> YES THEN do:
      521          RETURN NO-APPLY.
      522       end.
      523       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      524           BELL.
      525           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      526           RETURN NO-APPLY.
      527       END.
      528       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      529       DISP file-name WITH FRAME Dialog-Frame.
      530   END.
      531   ON CHOOSE OF B-file-name-2 IN FRAME Dialog-Frame
      532   DO:
      533       define variable v_os-file   AS CHAR NO-UNDO INIT "".
      534       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      535       SYSTEM-DIALOG GET-FILE v_os-file
      536           TITLE "Выберите файл для вывода"
      537           FILTERS
      538             " Все текстовые файлы (*.txt) " "*.txt",
      539             " Все файлы (*.*) "                      "*.*"
      540           INITIAL-FILTER 1
      541           DEFAULT-EXTENSION ".txt"
      542           USE-FILENAME
      543           SAVE-AS
      544           UPDATE ll_commit
      545           .
      546       IF ll_commit <> YES THEN do:
      547          RETURN NO-APPLY.
      548       end.
      549       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      550           BELL.
      551           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      552           RETURN NO-APPLY.
      553       END.
      554       ASSIGN file-name-2 = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      555       DISP file-name-2 WITH FRAME Dialog-Frame.
      556   END.
      557   ON LEAVE OF file-name IN FRAME Dialog-Frame
      558   DO:
      559       ASSIGN file-name.
      560       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      561           ASSIGN FILE-INFO:FILE-NAME = file-name.
      562           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      563           DISP file-name WITH FRAME Dialog-Frame.
      564       END.
      565   END.
      566   ON LEAVE OF file-name-2 IN FRAME Dialog-Frame
      567   DO:
      568       ASSIGN file-name-2.
      569       IF SEARCH( file-name-2 ) <> ? AND SEARCH( file-name-2 ) <> "":U THEN DO:
      570           ASSIGN FILE-INFO:file-name = file-name-2.
      571           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name-2 = FILE-INFO:FULL-PATHNAME.
      572           DISP file-name-2 WITH FRAME Dialog-Frame.
      573       END.
      574   END.
      575   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      576   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      577   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   on help of frame Dialog-Frame
      579   do:
      580     run gbl/app_help.p
      581       (input this-procedure :file-name
      582       ,input ''
      583       ,input ?
      584       ) no-error.
      585     if error-status :error then do:
      586       message
      587         "Ошибка при вызове помощи"
      588         error-status :get-message(1)
      589         view-as alert-box .
      590     end.
      591   end.
      592   run minbtn-set in this-procedure .
      593   on choose of b-help in frame Dialog-Frame
      594   do:
      595     apply "help":u to frame Dialog-Frame .
      596   end.
      597   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   procedure minbtn-set :
      599       do
      600           on error undo, return error return-value
      601           :
      602           define variable ii              as integer       no-undo .
      603           define variable fh              as widget-handle no-undo .
      604           define variable hh              as widget-handle no-undo .
      605           define variable v-h             as handle        extent 4 no-undo .
      606           define variable v-name-button   as character     no-undo .
      607           define variable v-help-old-x    as decimal       no-undo .
      608           define variable v-help-old-y    as decimal       no-undo .
      609           define variable v-help-old-size as decimal       no-undo .
      610           define variable v-frame-width   as decimal       no-undo .
      611           define variable jj              as integer       no-undo .
      612           do
      613               on error undo, return error
      614               :
      615               assign
      616                   v-frame-width = frame Dialog-Frame:width - 0.3
      617                   fh            = frame Dialog-Frame:first-child
      618                   hh            = fh:first-child
      619                   ii            = 1
      620                   .
      621               do while valid-handle(hh):
      622                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      623                   do:
      624                       case lc(hh:name) :
      625                           when "b-help" then
      626                               do:
      627                                   hh:load-image-up("cmp/b-help.bmp":u) .
      628                                   hh:load-image-down("cmp/b-help.bmp":u) .
      629                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      630                                   hh:TOOLTIP = "Помощь" .
      631                                   v-help-old-x = hh:column .
      632                                   v-help-old-y = hh:row    .
      633                                   v-help-old-size = hh:width .
      634                                   hh:width-chars = 2.5 .
      635                               end.
      636                           when "b-print" then
      637                               do:
      638                                   hh:load-image("cmp/b-print.bmp":u) .
      639                                   hh:TOOLTIP = "Печать" .
      640                                   v-h[ii] = hh:handle .
      641                                   ii = ii + 1 .
      642                                   hh:width-chars = 3 .
      643                               end.
      644                           when "b-history" or
      645                           when "b-hist" then
      646                               do:
      647                                   hh:load-image("cmp/b-hist.bmp":u) .
      648                                   hh:TOOLTIP = "История" .
      649                                   v-h[ii] = hh:handle .
      650                                   ii = ii + 1 .
      651                                   hh:width-chars = 3 .
      652                               end.
      653                           when "b-sch" then
      654                               do:
      655                                   hh:load-image("cmp/b-sch.bmp":u) .
      656                                   hh:TOOLTIP = "Установка Фильтра" .
      657                                   v-h[ii] = hh:handle .
      658                                   ii = ii + 1 .
      659                                   hh:width-chars = 3 .
      660                               end.
      661                           when "b-hist-user" then
      662                               do:
      663                                   hh:load-image("cmp/b-hist.bmp":u) .
      664                                   hh:TOOLTIP = "История пользователя" .
      665                                   ii = ii + 1 .
      666                               end.
      667                       end case.
      668                   end.
      669                   hh = hh:next-sibling.
      670               end.
      671               b-help:column = v-frame-width - b-help:width-chars.
      672               jj = 0.
      673               repeat ii = 4 to 1 by -1 :
      674                   if valid-handle (v-h[ii] ) then
      675                   do:
      676                       jj  = jj + 1 .
      677                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      678                       v-h[ii]:row    = v-help-old-y .
      679                   end.
      680               end.
      681           end.
      682       end.
      683   end procedure.
      684   MAIN-BLOCK:
      685   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      686      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      687     RUN enable_UI.
      688     WAIT-FOR GO OF FRAME Dialog-Frame.
      689   END.
      690   RUN disable_UI.
      691   PROCEDURE disable_UI :
      692     HIDE FRAME Dialog-Frame.
      693   END PROCEDURE.
      694   PROCEDURE enable_UI :
      695     DISPLAY file-name file-name-2
      696         WITH FRAME Dialog-Frame.
      697     ENABLE B-exit b-quit B-Help file-name B-file-name B-file-name-2
      698            file-name-2
      699         WITH FRAME Dialog-Frame.
      700     VIEW FRAME Dialog-Frame.
      701   END PROCEDURE.
