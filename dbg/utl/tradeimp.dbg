        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Импрот приходных накладных из Trade".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "X(65)" no-undo
      112   initial "@(#)$Workfile$ $Revision$".
      113   define variable v-filelist-total-file-num           as integer      no-undo .
      114   define variable v-filelist-total-dir-num            as integer      no-undo .
      115   define variable v-filelist-main-procedure-handle    as handle       no-undo .
      116   define variable v-filelist-main-procedure-name      as character    no-undo .
      117   define temp-table temp-dirlist no-undo
      118       field dir-full-name     as character
      119       field dir-short-name    as character
      120       field need-process      as logical
      121       index xpk is primary unique dir-full-name
      122   .
      123   define temp-table temp-filelist no-undo
      124     field file-name        as character
      125     field file-name-no-ext as character
      126     field file-extension   as character
      127     field directory-name   as character
      128     field full-name        as character
      129     field dir-short-name   as character
      130     field need-process     as logical
      131     index xpk is unique primary full-name
      132     index xie1 directory-name file-name
      133     index xie2 directory-name file-name-no-ext
      134     index xie3 file-name
      135     index xie4 file-name-no-ext
      136     index xie5 need-process file-name
      137     .
      138   define stream dir-list .
      139   procedure filelist-get-file-num :
      140     define output parameter p-file-num as integer   no-undo .
      141     do
      142     on error undo, return error return-value
      143     :
      144       assign
      145         p-file-num = v-filelist-total-file-num
      146       .
      147     end.
      148   end procedure.
      149   procedure filelist-clear :
      150     do
      151     on error undo, return error return-value
      152     :
      153       define buffer buf_filelist for temp-filelist .
      154       assign
      155         v-filelist-total-file-num = 0
      156       .
      157       for each buf_filelist
      158       on error undo, return error
      159       :
      160         delete buf_filelist .
      161       end.
      162     end.
      163   end procedure.
      164   procedure filelist-init :
      165     do
      166     on error undo, return error
      167     :
      168       define input parameter p-dir-name       as character no-undo .
      169       define input parameter p-filter-ext     as logical   no-undo .
      170       define input parameter p-ext-list       as character no-undo .
      171       define input parameter p-dir-short-name as character no-undo .
      172       define buffer buf_temp-filelist for temp-filelist .
      173       if p-filter-ext = true
      174          and p-ext-list = ?
      175       or (p-filter-ext = false
      176          and p-ext-list <> ?
      177          and p-ext-list <> "":U
      178          )
      179       then do:
      180         message
      181           vss-workfile vss-revision vss-description skip
      182           "Ошибка задания входных параметров" skip
      183           "p-filter-ext" p-filter-ext skip
      184           "p-ext-list"   p-ext-list   skip
      185           view-as alert-box error .
      186         undo, return error .
      187       end.
      188       for each buf_temp-filelist
      189         where buf_temp-filelist.directory-name = p-dir-name
      190       on error undo, return error return-value
      191       :
      192         delete buf_temp-filelist .
      193       end.
      194       input stream dir-list from os-dir( p-dir-name ).
      195       define variable v-file                  as character no-undo .
      196       define variable v-path                  as character no-undo .
      197       define variable v-mask                  as character no-undo .
      198       define variable v-extension             as character no-undo .
      199       define variable v-file-name-without-ext as character no-undo .
      200       repeat
      201       on error undo, return error
      202       :
      203         import stream dir-list v-file v-path v-mask .
      204         if  v-mask <> ?
      205         and v-mask begins 'F':u
      206         then do:
      207         end.
      208         else do:
      209           next .
      210         end.
      211         if num-entries(v-file, '.':u) > 1
      212         then do:
      213           assign
      214             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      215             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      216           .
      217         end.
      218         else do:
      219           assign
      220             v-extension = ''
      221             v-file-name-without-ext = v-file
      222           .
      223         end.
      224         if p-filter-ext = true
      225         then do:
      226           if lookup(v-extension, p-ext-list) = 0
      227           then do:
      228             next .
      229           end.
      230         end.
      231         create buf_temp-filelist .
      232         assign
      233           buf_temp-filelist.file-name        = v-file
      234           buf_temp-filelist.directory-name   = p-dir-name
      235           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      236           buf_temp-filelist.file-extension   = v-extension
      237           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      238           buf_temp-filelist.dir-short-name   = p-dir-short-name
      239         .
      240         assign
      241           v-filelist-total-file-num = v-filelist-total-file-num + 1
      242         .
      243         if v-filelist-main-procedure-handle <> ?
      244         then do:
      245           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      246             (input "file":U
      247             , input v-filelist-total-file-num
      248             , input buf_temp-filelist.full-name
      249             , input buf_temp-filelist.file-name
      250             ) no-error.
      251           if error-status :error
      252           then do:
      253             message
      254               vss-workfile vss-revision vss-description skip
      255               "filelist-dirlist-subdir-init" skip(1)
      256               skip "Ошибка при вызове процедуры вывода"
      257               skip "результатов сканирования каталогов."
      258               skip return-value
      259               skip trim(error-status :get-message(1))
      260                       trim(error-status :get-message(2))
      261                       trim(error-status :get-message(3))
      262               view-as alert-box error.
      263             undo, return error .
      264           end.
      265         end.
      266       end.
      267       input stream dir-list close .
      268       return.
      269     end.
      270   end procedure.
      271   procedure filelist-dirlist-init-by-list :
      272     do
      273     on error undo, return error
      274     :
      275       define input parameter p-root-dir   as character no-undo .
      276       define input parameter p-dir-list   as character no-undo .
      277       define input parameter p-filter-ext as logical   no-undo .
      278       define input parameter p-ext-list   as character no-undo .
      279       define variable v-num-appdir as integer   no-undo .
      280       do v-num-appdir = 1 to num-entries(p-dir-list)
      281       :
      282         define variable v-curr-dir  as character no-undo .
      283         assign
      284           v-curr-dir = entry(v-num-appdir, p-dir-list)
      285         .
      286         run filelist-init in this-procedure
      287           (input p-root-dir + '/':u + v-curr-dir
      288           ,input p-filter-ext
      289           ,input p-ext-list
      290           ,input v-curr-dir
      291           ) .
      292       end.
      293     end.
      294   end procedure.
      295   procedure filelist-dirlist-clear :
      296     do
      297     on error undo, return error
      298     :
      299       define buffer buf_temp-dirlist for temp-dirlist .
      300       assign
      301           v-filelist-total-dir-num = 0
      302       .
      303       for each buf_temp-dirlist
      304       on error undo, return error
      305       :
      306         delete buf_temp-dirlist .
      307       end.
      308     end.
      309   end procedure.
      310   procedure filelist-dirlist-subdir-init :
      311   define input parameter p-dir-name   as character no-undo .
      312       define buffer buf_temp-dirlist for temp-dirlist .
      313   do
      314   for buf_temp-dirlist
      315   on error undo, return error
      316   :
      317       assign
      318           file-info :file-name = p-dir-name
      319       .
      320       if file-info :full-pathname = ?
      321       or index( file-info :file-type, "D" ) = 0
      322       then do:
      323           message
      324               vss-workfile vss-revision vss-description skip
      325               "filelist-dirlist-init: Заданного каталога не существует."
      326               skip (1)
      327               skip "Задан каталог:"
      328               skip substitute( "'&1'", p-dir-name )
      329           view-as alert-box error .
      330           undo, return error .
      331       end.
      332       input stream dir-list from os-dir( p-dir-name ).
      333       define variable v-file                  as character no-undo .
      334       define variable v-path                  as character no-undo .
      335       define variable v-mask                  as character no-undo .
      336       file-in-directory:
      337       repeat
      338       on error undo, return error
      339       :
      340           import stream dir-list
      341               v-file
      342               v-path
      343               v-mask
      344           .
      345           if  v-mask = ?
      346           or index( v-mask, 'D':u ) = 0
      347           or v-file = ".":U
      348           or v-file = "..":U
      349           then do:
      350               next file-in-directory.
      351           end.
      352           else do:
      353               find first buf_temp-dirlist
      354                    where buf_temp-dirlist.dir-full-name    = v-path
      355               no-error.
      356               if not available buf_temp-dirlist
      357               then do:
      358                   create buf_temp-dirlist .
      359                   assign
      360                       buf_temp-dirlist.dir-full-name    = v-path
      361                       buf_temp-dirlist.dir-short-name   = v-file
      362                       buf_temp-dirlist.need-process     = yes
      363                   .
      364               end.
      365               assign
      366                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      367               .
      368               if v-filelist-main-procedure-handle <> ?
      369               then do:
      370                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      371                         input "dir":U
      372                       , input v-filelist-total-dir-num
      373                       , input buf_temp-dirlist.dir-full-name
      374                       , input buf_temp-dirlist.dir-short-name
      375                   ) no-error.
      376                   if error-status :error
      377                   then do:
      378                       message
      379                           vss-workfile vss-revision vss-description skip
      380                           "filelist-dirlist-subdir-init"
      381                           skip(1)
      382                           skip "Ошибка при вызове процедуры вывода"
      383                           skip "результатов сканирования каталогов."
      384                           skip return-value
      385                           skip trim(error-status :get-message(1))
      386                                trim(error-status :get-message(2))
      387                                trim(error-status :get-message(3))
      388                       view-as alert-box error.
      389                       undo, return error .
      390                   end.
      391               end.
      392           end.
      393       end.
      394       input stream dir-list close .
      395   end.
      396   end procedure.
      397   procedure filelist-dirlist-init :
      398   define input parameter p-dir-name   as character no-undo .
      399       define variable v-file  as character no-undo.
      400       define variable v-path  as character no-undo.
      401       define variable v-mask  as character no-undo.
      402       define buffer buf_temp-dirlist for temp-dirlist .
      403   do
      404   for buf_temp-dirlist
      405   on error undo, return error
      406   :
      407       assign
      408           file-info :file-name = p-dir-name
      409       .
      410       if file-info :full-pathname = ?
      411       or index( file-info :file-type, "D" ) = 0
      412       then do:
      413           message
      414               vss-workfile vss-revision vss-description skip
      415               "filelist-dirlist-init: Заданного каталога не существует."
      416               skip (1)
      417               skip "Задан каталог:"
      418               skip substitute( "'&1'", p-dir-name )
      419           view-as alert-box error .
      420           undo, return error .
      421       end.
      422       for each buf_temp-dirlist
      423          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      424       on error undo, return error return-value
      425       :
      426           delete buf_temp-dirlist .
      427       end.
      428       create buf_temp-dirlist .
      429       assign
      430           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      431           buf_temp-dirlist.dir-short-name   = file-info :file-name
      432           buf_temp-dirlist.need-process     = yes
      433       .
      434       do
      435       while available buf_temp-dirlist
      436       on error undo, return error
      437       :
      438           run filelist-dirlist-subdir-init in this-procedure (
      439               input buf_temp-dirlist.dir-full-name
      440           ).
      441           assign
      442               buf_temp-dirlist.need-process = no
      443           .
      444           find first buf_temp-dirlist
      445                where buf_temp-dirlist.need-process = yes
      446           no-error.
      447       end.
      448   end.
      449   end procedure.
      450   procedure filelist-set-procedure-handle :
      451   define input parameter p-proc-handle    as handle           no-undo.
      452   define input parameter p-proc-name      as character        no-undo.
      453       define variable v-signature    as character    no-undo.
      454   do
      455   on error undo, return error
      456   :
      457       if p-proc-handle = ?
      458       or not valid-handle( p-proc-handle )
      459       or p-proc-handle :get-signature( p-proc-name ) = ""
      460       then do:
      461           assign
      462               v-filelist-main-procedure-handle = ?
      463               v-filelist-main-procedure-name   = ""
      464           .
      465           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      466       end.
      467       else do:
      468           assign
      469               v-signature = p-proc-handle :get-signature( p-proc-name )
      470           .
      471           if entry(   1, v-signature )    = "PROCEDURE":U
      472           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      473           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      474           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      475           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      476           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      477           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      478           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      479           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      480           then do:
      481               assign
      482                   v-filelist-main-procedure-handle = p-proc-handle
      483                   v-filelist-main-procedure-name   = p-proc-name
      484               .
      485           end.
      486           else do:
      487               assign
      488                   v-filelist-main-procedure-handle = ?
      489                   v-filelist-main-procedure-name   = ""
      490               .
      491               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      492           end.
      493       end.
      494   end.
      495   end procedure.
      496   procedure filelist-clear-procedure-handle :
      497   do
      498   on error undo, return error
      499   :
      500       assign
      501           v-filelist-main-procedure-handle = ?
      502           v-filelist-main-procedure-name   = ?
      503       .
      504   end.
      505   end procedure.
      506   procedure filelist-build-by-dirlist :
      507       define buffer buf_temp-dirlist      for temp-dirlist.
      508   do
      509   for buf_temp-dirlist
      510   on error undo, return error
      511   :
      512       for each buf_temp-dirlist
      513       on error undo, return error
      514       :
      515           run filelist-init in this-procedure (
      516                 input buf_temp-dirlist.dir-full-name
      517               , input no
      518               , input "":U
      519               , input buf_temp-dirlist.dir-short-name
      520           ).
      521       end.
      522   end.
      523   end procedure.
      524   procedure filelist-check-dir-exists :
      525   define input parameter p-dir-name   as character        no-undo.
      526   define output parameter p-exists    as logical          no-undo.
      527   do
      528   on error undo, return error
      529   :
      530       assign
      531           file-info :file-name = p-dir-name
      532       .
      533       if file-info :file-type <> ?
      534       and substring( file-info :file-type, 1, 1 ) = "D":U
      535       then do:
      536           assign
      537               p-exists = yes
      538           .
      539       end.
      540       else do:
      541           assign
      542               p-exists = no
      543           .
      544       end.
      545   end.
      546   end procedure.
      547   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   procedure doc-code:
      549   define input  parameter parmode          as   character           no-undo.
      550   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      551   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      552   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      553   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      554   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      555   define variable vardb-remote     as   logical             no-undo.
      556   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      557   define variable v-delimiter as character no-undo .
      558   do
      559   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      560   :
      561   find first buf_sys-ctrl no-lock .
      562   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      563     CASE parmode:
      564       when "main":u then do:
      565         if vardb-remote then do:
      566           assign
      567             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      568         end.
      569         else do:
      570           assign
      571             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      572         end.
      573       end.
      574       when "trio" then do:
      575         assign
      576           pardoc-code = replace (parroot-doc-code, "=", "*").
      577       end.
      578       otherwise do:
      579         assign
      580         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      581         no-error
      582         .
      583         if error-status:error  then do:
      584           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      585                                         ,chr(10)
      586                                         ,parmode
      587                                         ).
      588         end.
      589         if num-entries(parmode) = 1
      590         and parmode <> "chip":U
      591         and parmode <> "chip_s":U
      592         then do:
      593           assign
      594           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      595         end.
      596         else if (lookup("chip":U, parmode) > 0
      597                  or
      598                  lookup("chip_s":U, parmode) > 0) then do:
      599           assign
      600             vartemp-doc-code = parroot-doc-code.
      601           do while true:
      602             if index (vartemp-doc-code , ".") = 0 then
      603               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      604             else
      605               vartemp-doc-code  =
      606               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      607               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      608               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      609             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      610           end.
      611           assign
      612             pardoc-code = vartemp-doc-code.
      613         end.
      614       end.
      615     end CASE.
      616     if pardoc-code = '':U
      617     or (parroot-doc-code <> '':U
      618     and pardoc-code = parroot-doc-code) then do:
      619       undo, return error substitute("Ошибка при генерации номера документа&1"
      620                                     ,chr(10)).
      621     end.
      622   end.
      623   end. // procedure/method
      624   function get-doc-code-int64 returns int64
      625     ( input p-doc-code as character ) :
      626     define variable v-ind              as integer   no-undo .
      627     define variable v-num-entries      as integer   no-undo .
      628     define variable v-doc-code-int64   as int64     no-undo .
      629     define variable v-canonic-doc-code as character no-undo .
      630     assign
      631       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      632       v-canonic-doc-code = p-doc-code
      633     .
      634     do v-ind = 1 to v-num-entries
      635     :
      636       assign
      637         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      638       .
      639     end.
      640     assign
      641       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      642     .
      643     return v-doc-code-int64 .
      644   end. // function/method
