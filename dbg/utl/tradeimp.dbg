     1037     DEFINE BUFFER bf_curr-accnt     FOR ub.curr-accnt.
     1038     DEFINE VARIABLE varcli-code LIKE ub.clients.obj-code.
     1039     DEFINE VARIABLE vardoc-code LIKE ub.trn-doc.doc-code.
     1040     DEFINE VARIABLE vartoday    AS   DATE.
     1041     FIND FIRST bf-obj_clients WHERE bf-obj_clients.obj-type = v-cntxt-obj-type AND
     1042                                     bf-obj_clients.obj-code = v-cntxt-obj-code NO-LOCK NO-ERROR.
     1043     IF NOT AVAILABLE bf-obj_clients THEN DO:
     1044       MESSAGE "Не найден объект " v-cntxt-obj-type v-cntxt-obj-code "." SKIP
     1045               "Утилита должна запускаться из окна администратора, с предустановленым текущим объектом в Trade House."
     1046       VIEW-AS ALERT-BOX ERROR.
     1047       RETURN NO-APPLY.
     1048     END.
     1049     ASSIGN FRAME Dialog-Frame vardir.
     1050     OUTPUT STREAM str-err TO VALUE(vardir + "/err.txt").
     1051     RUN filelist-init IN THIS-PROCEDURE
     1052        (vardir,
     1053         YES,
