     1246   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   procedure minbtn-set :
     1248       do
     1249           on error undo, return error return-value
     1250           :
     1251           define variable ii              as integer       no-undo .
     1252           define variable fh              as widget-handle no-undo .
     1253           define variable hh              as widget-handle no-undo .
     1254           define variable v-h             as handle        extent 4 no-undo .
     1255           define variable v-name-button   as character     no-undo .
     1256           define variable v-help-old-x    as decimal       no-undo .
     1257           define variable v-help-old-y    as decimal       no-undo .
     1258           define variable v-help-old-size as decimal       no-undo .
     1259           define variable v-frame-width   as decimal       no-undo .
     1260           define variable jj              as integer       no-undo .
     1261           do
     1262               on error undo, return error
     1263               :
     1264               assign
     1265                   v-frame-width = frame Dialog-Frame:width - 0.3
     1266                   fh            = frame Dialog-Frame:first-child
     1267                   hh            = fh:first-child
     1268                   ii            = 1
     1269                   .
     1270               do while valid-handle(hh):
     1271                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1272                   do:
     1273                       case lc(hh:name) :
     1274                           when "b-help" then
     1275                               do:
     1276                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1277                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1278                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1279                                   hh:TOOLTIP = "Помощь" .
     1280                                   v-help-old-x = hh:column .
     1281                                   v-help-old-y = hh:row    .
     1282                                   v-help-old-size = hh:width .
     1283                                   hh:width-chars = 2.5 .
     1284                               end.
     1285                           when "b-print" then
     1286                               do:
     1287                                   hh:load-image("cmp/b-print.bmp":u) .
     1288                                   hh:TOOLTIP = "Печать" .
     1289                                   v-h[ii] = hh:handle .
     1290                                   ii = ii + 1 .
     1291                                   hh:width-chars = 3 .
     1292                               end.
     1293                           when "b-history" or
     1294                           when "b-hist" then
     1295                               do:
     1296                                   hh:load-image("cmp/b-hist.bmp":u) .
     1297                                   hh:TOOLTIP = "История" .
     1298                                   v-h[ii] = hh:handle .
     1299                                   ii = ii + 1 .
     1300                                   hh:width-chars = 3 .
     1301                               end.
     1302                           when "b-sch" then
     1303                               do:
     1304                                   hh:load-image("cmp/b-sch.bmp":u) .
     1305                                   hh:TOOLTIP = "Установка Фильтра" .
     1306                                   v-h[ii] = hh:handle .
     1307                                   ii = ii + 1 .
     1308                                   hh:width-chars = 3 .
     1309                               end.
     1310                           when "b-hist-user" then
     1311                               do:
     1312                                   hh:load-image("cmp/b-hist.bmp":u) .
     1313                                   hh:TOOLTIP = "История пользователя" .
     1314                                   ii = ii + 1 .
     1315                               end.
     1316                       end case.
     1317                   end.
     1318                   hh = hh:next-sibling.
     1319               end.
     1320               b-help:column = v-frame-width - b-help:width-chars.
     1321               jj = 0.
     1322               repeat ii = 4 to 1 by -1 :
     1323                   if valid-handle (v-h[ii] ) then
     1324                   do:
     1325                       jj  = jj + 1 .
     1326                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1327                       v-h[ii]:row    = v-help-old-y .
     1328                   end.
     1329               end.
     1330           end.
     1331       end.
     1332   end procedure.
