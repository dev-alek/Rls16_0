      915             and buf_batchprocess.bp_status     = 'N':U
      916             and buf_batchprocess.CharKey_Three = buf_temp-obj-arh.obj-type
      917             and buf_batchprocess.Key#_One      = buf_temp-obj-arh.obj-code
      918           no-error .
