      869           buf_temp-obj-arh.archive-type = 'aht':U
      870           buf_temp-obj-arh.sort-code    = 3
      871           buf_temp-obj-arh.obj-deleted  = v-obj-deleted
      872         .
      873         run clntattr-value in this-procedure
      874           (input  buf_temp-obj-arh.obj-type
      875           ,input  buf_temp-obj-arh.obj-code
