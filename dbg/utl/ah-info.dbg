        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define  temp-table temp-obj-arh no-undo
        4     field db-num                   as integer format ">9" label "БД"
        5     field obj-type                 like ub.clients.obj-type
        6     field obj-code                 like ub.clients.obj-code
        7     field archive-type             as character label "Архив"
        8     field sort-code                as integer
        9     field obj-deleted              as logical   label "У" format "У/ "
       10     field archive-calc             as logical   format "+/-":U         label 'Не рассчитан оборот'
       11     field archive-del              as logical   format "+/-":U         label 'Не рассчитан нач.остаток'
       12     field archive-disable          as logical   format "+/-":U         label 'Расчет архива запрещен'
       13     field archive-rest             as logical   format "+/-":U         label 'Сбой удал./восст.'
       14     field archive-bpexist          as logical   format "+/-":U         label 'Имеются задания на расчет'
       15     field archive-detail-date      as date      format '99/99/9999':u  label 'Подробный'
       16     field archive-start-date       as date      format '99/99/9999':u  label 'Сжатый'
       17     field archive-recalc-date      as date      format '99/99/9999':u  label 'Перерасчёт'
       18     field archive-lock-prc         as logical                          label 'Расчёт'
       19     field archive-execuser         like ub.batchprocess.bp_execuser_id label 'Пользователь' column-label 'Пользователь'
       20     field archive-execsysdate      like ub.batchprocess.bp_execsysdate label 'Дата'         column-label 'Дата'
       21     field archive-execsystime      like ub.batchprocess.bp_execsystime label 'Время'        column-label 'Время'
       22     field archive-rest-lock-prc    as logical                          label 'Расчёт'
       23     field archive-rest-execuser    like ub.batchprocess.bp_execuser_id label 'Пользователь' column-label 'Пользователь'
       24     field archive-rest-execsysdate like ub.batchprocess.bp_execsysdate label 'Дата'         column-label 'Дата'
       25     field archive-rest-execsystime like ub.batchprocess.bp_execsystime label 'Время'        column-label 'Время'
       26     index xpk is primary unique obj-type obj-code archive-type
       27     index ie1 db-num obj-type obj-code archive-type
       28   .
       29   define output parameter table for temp-obj-arh .
       30   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       31   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       32   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       33   define variable vss-workfile    as character no-undo init "$Workfile: ah-info.p $":U .
       34   define variable vss-archive     as character no-undo init "$Archive: utl/ah-info.p $":U .
       35   define variable vss-description as character no-undo init "Текущее состояние складского архива".
       36   procedure vss-get-info :
       37     define output parameter p-vss-revision    like vss-revision    no-undo .
       38     define output parameter p-vss-author      like vss-author      no-undo .
       39     define output parameter p-vss-date        like vss-date        no-undo .
       40     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       41     define output parameter p-vss-archive     like vss-archive     no-undo .
       42     define output parameter p-vss-description like vss-description no-undo .
       43     assign
       44       p-vss-revision    = vss-revision
       45       p-vss-author      = vss-author
       46       p-vss-date        = vss-date
       47       p-vss-workfile    = vss-workfile
       48       p-vss-archive     = vss-archive
       49       p-vss-description = vss-description
       50     .
       51   end procedure.
       52   procedure vss-get-parameters :
       53     define output parameter p-vss-parameters as character no-undo .
       54   end procedure.
       55   define new global shared variable g#vssrevis-logger as handle    no-undo .
       56   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       57   define variable v-vssrevis-logger                   as handle    no-undo .
       58   procedure vss-logevent :
       59     define input  parameter p-extra-paramters as character no-undo .
       60     define variable v-vssrevis-parameters as character no-undo .
       61     do
       62     on error undo, return error return-value
       63     :
       64       if  valid-handle(v-vssrevis-logger)
       65       and v-vssrevis-logger :get-signature("logevent") <> ""
       66       then do:
       67         run vss-get-parameters in this-procedure
       68           (output v-vssrevis-parameters
       69           ).
       70         run logevent in v-vssrevis-logger
       71           (input vss-workfile
       72           ,input vss-revision
       73           ,input v-vssrevis-parameters
       74           ,input p-extra-paramters
       75           ).
       76       end.
       77     end.
       78   end procedure.
       79   assign
       80     v-vssrevis-logger = g#vssrevis-logger
       81   .
       82   if  valid-handle(v-vssrevis-logger)
       83   and v-vssrevis-logger :get-signature("logevent") <> ""
       84   then do:
       85     assign
       86       v-vssrevis-logevent = true
       87     .
       88     run vss-logevent in this-procedure (input vss-description) .
       89   end.
       90   define new global shared variable g#language as character no-undo .
