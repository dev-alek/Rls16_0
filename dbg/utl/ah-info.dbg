      404   define button B-viewProcInfo
      405        label "Информация"
      406        size 15 by 1 tooltip "Информация о процесс".
      407   define frame waitfram
      408     v-waitfram-action01 format "x(72)" no-label skip
      409     v-waitfram-action02 format "x(72)" no-label skip
      410     v-waitfram-action03 format "x(72)" no-label skip
      411     B-viewProcInfo
      412     B-WaitFramStop at row 4 col 30
      413     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      414     .
      415   define new global shared variable mBatchMode as logical no-undo init ?.
      416   define variable mFramBachModHandle as handle no-undo.
      417   mFramBachModHandle = frame waitfram:handle.
      418   define variable mFameOldVis as logical no-undo.
      419   define variable mVisCUrentVin as logical no-undo.
      420   if session:batch-mode
      421   then
      422      mBatchMode = yes.
      423   if mBatchMode = ? then do:
      424     mVisCUrentVin = current-window:visible.
      425     mFameOldVis = mFramBachModHandle:visible.
      426     mFramBachModHandle:visible  = yes.
      427     mBatchMode = mFramBachModHandle:visible ne yes.
      428     mFramBachModHandle:visible = mFameOldVis.
      429     current-window:visible = mVisCUrentVin.
      430   end.
      431    if  log-manager:logfile-name ne ?
      432     then DO:
      433         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      434         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      435         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      436     end.
      437   on choose of B-WaitFramStop in frame waitfram
      438   do:
      439     mWaitFramStop = yes.
      440     mWaitFramStopUser = yes.
      441   end.
      442   function waitfram-check-timeout returns logical():
      443      define variable vtime as int64 no-undo.
      444      if mWaitFramStopTimeOut
      445      then
      446         return yes.
      447      vtime = ( now - mWaitFramStartProc ) / 1000 .
      448      if     mWaitFramTimeOut ne ?
      449         and mWaitFramTimeOut ne 0
      450         and mWaitFramTimeOut lt vtime
      451      then do:
      452         mWaitFramStopTimeOut = yes.
      453      end.
      454      return mWaitFramStopTimeOut.
      455   end.
      456   procedure waitfram-hide :
      457     if not session:batch-mode
      458     then do
      459     on error undo, return error return-value
      460     :
      461       pause 0 before-hide .
      462       if not mBatchMode then
      463         hide frame waitfram .
      464     if     not mWaitFramView
      465        and mWaitProcEvent
      466     then
      467       process events .
      468     end.
      469   end procedure.
      470   procedure waitfram-show :
      471     define input  parameter p-message as character no-undo .
      472     define variable v-left-margin as integer   no-undo .
      473     if not session:batch-mode
      474     then do
      475     on error undo, return error return-value
      476     :
      477       if length(p-message) <= 70 then do:
      478         assign
      479           v-left-margin = integer((70 - length(p-message)) / 2)
      480         .
      481         assign
      482           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      483         .
      484         assign
      485           v-waitfram-action01 = " "
      486           v-waitfram-action02 = " "
      487                                    + fill(" ", v-left-margin)
      488                                    + p-message
      489           v-waitfram-action03 = " "
      490         .
      491       end.
      492       else do:
      493         define variable vRindex1 as integer no-undo.
      494         define variable vRindex2 as integer no-undo.
      495         vRindex1 = r-index(p-message," ",70).
      496         if vRindex1 = 0
      497         then
      498            vRindex1 = 70.
      499         if length(p-message)  <= vRindex1 + 70 then do:
      500           assign
      501             v-waitfram-action01 = " "
      502             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      503             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      504           .
      505         end.
      506         else do:
      507           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      508           if vRindex2 <= vRindex1
      509           then
      510              vRindex2 = vRindex1 + 70.
      511           assign
      512             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      513             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      514             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      515           .
      516         end.
      517       end.
      518       B-viewProcInfo:visible   in frame waitfram = no.
      519       B-viewProcInfo:sensitive in frame waitfram = no.
      520       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      521       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      522       if  (   mWaitFramView
      523          or  mWaitProcEvent)
      524          and not mBatchMode
      525       then
      526          display
      527             v-waitfram-action01 skip
      528             v-waitfram-action02 skip
      529             v-waitfram-action03 skip
      530          with frame waitfram .
      531       if     mWaitFramView
      532          then do:
      533             if     mWaitFramInterval ne ?
      534                and not mBatchMode
      535             then
      536                wait-for go of frame waitfram pause mWaitFramInterval.
      537          end.
      538          else
      539             if     mWaitProcEvent
      540                and not mBatchMode
      541             then
      542                process events .
      543     end.
      544   end procedure.
      545      procedure waitfram-show-this:
      546         define input  parameter iInterval as int64 no-undo.
      547         define variable vtime as int64 no-undo.
      548         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      549         mWaitFramInterval = iInterval.
      550         run waitfram-show (substitute("&1&2 &3&4" ,
      551                                       mWaitFramTextBeg ,
      552                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      553                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      554                                       mWaitFramTextEnd
      555                                      )
      556                           ).
      557      end.
      558      procedure WaitFramRunPause:
      559         define input  parameter iInterval as dec no-undo.
      560         define variable vStart  as datetime-tz no-undo.
      561         define variable vend    as datetime-tz no-undo.
      562         define variable vint as int64 no-undo.
      563         define variable vOk as logical no-undo.
      564         vStart = now.
      565         vend   = vStart.
      566         publish "WaitFramPause" (iInterval,output vOk).
      567         vend   =  now.
      568         vint = vend - vStart.
      569         vint = iInterval - vint / 1000.
      570         if     not mWaitFramStop
      571            and (   vint > 0
      572                 or (    not vOk
      573                     and iInterval eq ?
      574                     )
      575                 )
      576         then
      577            run waitfram-show-this (iInterval).
      578         vend   =  now.
      579         vint = vend - vStart.
      580         vint = iInterval - vint / 1000.
      581         if     not mWaitFramStop
      582            and vint > 0
      583         then do:
      584            run gbl/pause.p (vint * 1000).
      585         end.
      586         if iInterval ne ?
      587         then
      588            publish "WaitFramStop".
      589         waitfram-check-timeout().
      590      end.
      591      procedure WaitFramWaitFor:
      592         define input  parameter iInterval as dec no-undo.
      593         assign
      594            mWaitFramStartProc   = now
      595            mWaitFramStopUser    = no
      596            mWaitFramStopTimeOut = no
      597         .
      598         block-wait:
      599         do while not mWaitFramStop:
      600            run WaitFramRunPause (iInterval).
      601            if  waitfram-check-timeout()
      602            then do:
      603               leave block-wait.
      604            end.
      605         end.
      606         run waitfram-hide.
      607      end.
      608   procedure waitfram-join :
      609     define input  parameter p-line-1  as character no-undo .
      610     define input  parameter p-line-2  as character no-undo .
      611     define input  parameter p-line-3  as character no-undo .
      612     define output parameter p-message as character no-undo .
      613     do
      614     on error undo, return error return-value
      615     :
      616       assign
      617         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      618                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      619                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      620       .
      621     end.
      622   end procedure.
      623   function waitfram-join-function returns character
      624     (input p-line-1 as character
      625     ,input p-line-2 as character
      626     ,input p-line-3 as character
      627     ).
      628     define variable v-message as character no-undo .
      629     run waitfram-join in this-procedure
      630       (input  p-line-1
      631       ,input  p-line-2
      632       ,input  p-line-3
      633       ,output v-message
      634       ) .
      635     return v-message .
      636   end function .
      637   do
      638   on error undo, return error return-value
      639   :
      640     run init-temp-obj-arh in this-procedure .
      641     run scan-lock-prc in this-procedure .
      642     run waitfram-hide in this-procedure .
      643   end.
      644   procedure init-temp-obj-arh :
      645     define variable v-attr-value as character no-undo .
      646     define variable v-attr-type  as character no-undo .
      647     define buffer buf_temp-obj-arh for temp-obj-arh .
      648     define buffer buf_db for ub.db .
      649     define buffer buf_clients for ub.clients .
      650     define buffer buf_batchprocess for ub.batchprocess .
      651     define variable v-obj-deleted as logical   no-undo .
      652     do
      653     on error undo, return error return-value
      654     :
      655       for each buf_temp-obj-arh
      656       on error undo, return error return-value
      657       :
      658         delete buf_temp-obj-arh .
      659       end.
      660       define buffer buf_sys-ctrl for ub.sys-ctrl .
      661       find first buf_sys-ctrl no-lock .
      662       for each buf_db no-lock
      663         where (buf_sys-ctrl.db-num = 0
      664               or (buf_sys-ctrl.db-num <> 0
      665                  and buf_db.db-num = buf_sys-ctrl.db-num
      666                  )
      667               )
      668       ,each buf_clients no-lock
      669         where buf_clients.db-num = buf_db.db-num
      670       on error undo, return error return-value
      671       :
      672         run waitfram-show in this-procedure
      673           (input substitute("Запрос информации о складских архивах БД &1, объект &2 &3"
      674                            ,buf_db.db-num
      675                            ,buf_clients.obj-type
      676                            ,buf_clients.obj-code
      677                            )
      678           ) .
      679         assign
      680           v-obj-deleted = (buf_clients.stts <> 0)
      681         .
      682         create buf_temp-obj-arh .
      683         assign
      684           buf_temp-obj-arh.obj-type     = buf_clients.obj-type
      685           buf_temp-obj-arh.obj-code     = buf_clients.obj-code
      686           buf_temp-obj-arh.db-num       = buf_clients.db-num
      687           buf_temp-obj-arh.archive-type = 'arh':U
      688           buf_temp-obj-arh.sort-code    = 1
      689           buf_temp-obj-arh.obj-deleted  = v-obj-deleted
      690         .
      691         run clntattr-value in this-procedure
      692           (input  buf_temp-obj-arh.obj-type
      693           ,input  buf_temp-obj-arh.obj-code
      694           ,input  'arh-calc':U
      695           ,output v-attr-value
      696           ,output v-attr-type
      697           ) .
      698         assign
      699           buf_temp-obj-arh.archive-calc = (lookup(v-attr-value, "yes,true") > 0)
      700         .
      701         run clntattr-value in this-procedure
      702           (input  buf_temp-obj-arh.obj-type
      703           ,input  buf_temp-obj-arh.obj-code
      704           ,input  'arh-del':U
      705           ,output v-attr-value
      706           ,output v-attr-type
      707           ) .
      708         assign
      709           buf_temp-obj-arh.archive-del = (lookup(v-attr-value, "yes,true") > 0)
      710         .
      711         run clntattr-value in this-procedure
      712           (input  buf_temp-obj-arh.obj-type
      713           ,input  buf_temp-obj-arh.obj-code
      714           ,input  'arh-disable':U
      715           ,output v-attr-value
      716           ,output v-attr-type
      717           ) .
      718         assign
      719           buf_temp-obj-arh.archive-disable = (lookup(v-attr-value, "yes,true") > 0)
      720         .
      721         run clntattr-value in this-procedure
      722           (input  buf_temp-obj-arh.obj-type
      723           ,input  buf_temp-obj-arh.obj-code
      724           ,input  'arh-rest':U
      725           ,output v-attr-value
      726           ,output v-attr-type
      727           ) .
      728         assign
      729           buf_temp-obj-arh.archive-rest = (lookup(v-attr-value, "yes,true") > 0)
      730         .
      731         find first buf_batchprocess no-lock
      732           where buf_batchprocess.bp_type       = 'arh':U
      733             and buf_batchprocess.bp_status     = 'N':U
      734             and buf_batchprocess.CharKey_Three = buf_temp-obj-arh.obj-type
      735             and buf_batchprocess.Key#_One      = buf_temp-obj-arh.obj-code
      736           no-error .
      737         if available buf_batchprocess
      738         then do:
      739           assign
      740             buf_temp-obj-arh.archive-bpexist = true
      741           .
      742         end.
      743         run clntattr-value in this-procedure
      744           (input  buf_temp-obj-arh.obj-type
      745           ,input  buf_temp-obj-arh.obj-code
      746           ,input  'arh-detail':U
      747           ,output v-attr-value
      748           ,output v-attr-type
      749           ) .
      750         assign
      751           buf_temp-obj-arh.archive-detail-date = date(v-attr-value)
      752         .
      753         run clntattr-value in this-procedure
      754           (input  buf_temp-obj-arh.obj-type
      755           ,input  buf_temp-obj-arh.obj-code
      756           ,input  'arh-start':U
      757           ,output v-attr-value
      758           ,output v-attr-type
      759           ) .
      760         assign
      761           buf_temp-obj-arh.archive-start-date = date(v-attr-value)
      762         .
      763         run clntattr-value in this-procedure
      764           (input  buf_temp-obj-arh.obj-type
      765           ,input  buf_temp-obj-arh.obj-code
      766           ,input  'arh-recalc':U
      767           ,output v-attr-value
      768           ,output v-attr-type
      769           ) .
      770         assign
      771           buf_temp-obj-arh.archive-recalc-date = date(v-attr-value)
      772         .
      773         create buf_temp-obj-arh .
      774         assign
      775           buf_temp-obj-arh.obj-type     = buf_clients.obj-type
      776           buf_temp-obj-arh.obj-code     = buf_clients.obj-code
      777           buf_temp-obj-arh.db-num       = buf_clients.db-num
      778           buf_temp-obj-arh.archive-type = 'ahsp':U
      779           buf_temp-obj-arh.sort-code    = 2
      780           buf_temp-obj-arh.obj-deleted  = v-obj-deleted
      781         .
      782         run clntattr-value in this-procedure
      783           (input  buf_temp-obj-arh.obj-type
      784           ,input  buf_temp-obj-arh.obj-code
      785           ,input  'ahsp-calc':U
      786           ,output v-attr-value
      787           ,output v-attr-type
      788           ) .
      789         assign
      790           buf_temp-obj-arh.archive-calc = (lookup(v-attr-value, "yes,true") > 0)
      791         .
      792         run clntattr-value in this-procedure
      793           (input  buf_temp-obj-arh.obj-type
      794           ,input  buf_temp-obj-arh.obj-code
      795           ,input  'ahsp-del':U
      796           ,output v-attr-value
      797           ,output v-attr-type
      798           ) .
      799         assign
      800           buf_temp-obj-arh.archive-del = (lookup(v-attr-value, "yes,true") > 0)
      801         .
      802         run clntattr-value in this-procedure
      803           (input  buf_temp-obj-arh.obj-type
      804           ,input  buf_temp-obj-arh.obj-code
      805           ,input  'ahsp-disable':U
      806           ,output v-attr-value
      807           ,output v-attr-type
      808           ) .
      809         assign
      810           buf_temp-obj-arh.archive-disable = (lookup(v-attr-value, "yes,true") > 0)
      811         .
      812         run clntattr-value in this-procedure
      813           (input  buf_temp-obj-arh.obj-type
      814           ,input  buf_temp-obj-arh.obj-code
      815           ,input  'ahsp-rest':U
      816           ,output v-attr-value
      817           ,output v-attr-type
      818           ) .
      819         assign
      820           buf_temp-obj-arh.archive-rest = (lookup(v-attr-value, "yes,true") > 0)
      821         .
      822         find first buf_batchprocess no-lock
      823           where buf_batchprocess.bp_type       = 'ahsp':U
      824             and buf_batchprocess.bp_status     = 'N':U
      825             and buf_batchprocess.CharKey_Three = buf_temp-obj-arh.obj-type
      826             and buf_batchprocess.Key#_One      = buf_temp-obj-arh.obj-code
      827           no-error .
      828         if available buf_batchprocess
      829         then do:
      830           assign
      831             buf_temp-obj-arh.archive-bpexist = true
      832           .
      833         end.
      834         run clntattr-value in this-procedure
      835           (input  buf_temp-obj-arh.obj-type
      836           ,input  buf_temp-obj-arh.obj-code
      837           ,input  'ahsp-detail':U
      838           ,output v-attr-value
      839           ,output v-attr-type
      840           ) .
      841         assign
      842           buf_temp-obj-arh.archive-detail-date = date(v-attr-value)
      843         .
      844         run clntattr-value in this-procedure
      845           (input  buf_temp-obj-arh.obj-type
      846           ,input  buf_temp-obj-arh.obj-code
      847           ,input  'ahsp-start':U
      848           ,output v-attr-value
      849           ,output v-attr-type
      850           ) .
      851         assign
      852           buf_temp-obj-arh.archive-start-date = date(v-attr-value)
      853         .
      854         run clntattr-value in this-procedure
      855           (input  buf_temp-obj-arh.obj-type
