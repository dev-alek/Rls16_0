      957   end procedure.
      958   procedure scan-lock-prc :
      959     do
      960     on error undo, return error return-value
      961     :
      962       define buffer buf_batchprocess  for ub.batchprocess .
      963       define buffer lock_batchprocess for ub.batchprocess .
