      362   id
      363   line
      364   index isdone
      365   done
      366   .
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368     define variable v-cntxt-db-num        as integer   no-undo .
      369     define variable v-cntxt-userid        as character no-undo .
      370     define variable v-cntxt-level         as character no-undo .
      371     define variable v-cntxt-host-code-obj as integer   no-undo .
      372     define variable v-cntxt-obj-type      as character no-undo .
      373     define variable v-cntxt-obj-code      as integer   no-undo .
      374     define variable v-cntxt-db-num-obj    as integer   no-undo .
      375     define variable v-cntxt-is-admin      as logical   no-undo .
      376   define stream sout .
      377   do
      378   on error undo, return error return-value
      379   :
      380     define variable v-ok as logical   no-undo .
      381     message
      382       "Утилита проверки и коррекции учетных цен в партии" skip
      383       "Сейчас откроется список товаров" skip
      384       "Выберите товары, которые необходимо проверить и исправить" skip
      385       "Продолжить?" skip
      386       view-as alert-box question buttons yes-no update v-ok .
      387     if v-ok <> true
      388     then do:
      389       return .
      390     end.
      391   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392     run mainmenu_getcntxt in parparentproc
      393       (output v-cntxt-db-num
      394       ,output v-cntxt-userid
      395       ,output v-cntxt-level
      396       ,output v-cntxt-host-code-obj
      397       ,output v-cntxt-obj-type
      398       ,output v-cntxt-obj-code
      399       ,output v-cntxt-db-num-obj
      400       ,output v-cntxt-is-admin
      401       ) .
      402     run str/gds-list.w (input parparentproc, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code) .
      403     for each gds-list
      404     on error undo, return error return-value
      405     :
      406       for each buf_parts exclusive-lock
      407         where buf_parts.artic     = gds-list.artic
      408           and buf_parts.prod-type = gds-list.prod-type
      409           and buf_parts.prod-code = gds-list.prod-code
      410       on error undo, return error return-value
      411       :
      412         run waitfram-show in this-procedure
      413           (input substitute("Проверка партий. Товар &1 &2 &3"
      414                             ,gds-list.artic
      415                             ,gds-list.prod-type
      416                             ,gds-list.prod-code
      417                            )
      418           ) .
      419         if buf_parts.road-tax-base = ?
      420         then do:
      421           output stream sout to docpartn.txt append .
      422           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      423             "fix road-tax-base" .
      424           export stream sout buf_parts .
      425           output stream sout close .
      426           assign
      427             buf_parts.road-tax-base = 0
      428           .
      429         end.
      430         if buf_parts.road-tax-rubl = ?
      431         then do:
      432           output stream sout to docpartn.txt append .
      433           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      434             "fix road-tax-rubl" .
      435           export stream sout buf_parts .
      436           output stream sout close .
      437           assign
      438             buf_parts.road-tax-rubl = 0
      439           .
      440         end.
      441         if buf_parts.transport-base = ?
      442         then do:
      443           output stream sout to docpartn.txt append .
      444           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      445             "fix transport-base" .
      446           export stream sout buf_parts .
      447           output stream sout close .
      448           assign
      449             buf_parts.transport-base = 0
      450           .
      451         end.
      452         if buf_parts.transport-rubl = ?
      453         then do:
      454           output stream sout to docpartn.txt append .
      455           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      456             "fix transport-rubl" .
      457           export stream sout buf_parts .
      458           output stream sout close .
      459           assign
      460             buf_parts.transport-rubl = 0
      461           .
      462         end.
      463         if buf_parts.other-base = ?
      464         then do:
      465           output stream sout to docpartn.txt append .
      466           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      467             "fix other-base" .
      468           export stream sout buf_parts .
      469           output stream sout close .
      470           assign
      471             buf_parts.other-base = 0
      472           .
      473         end.
      474         if buf_parts.other-rubl = ?
      475         then do:
      476           output stream sout to docpartn.txt append .
      477           export stream sout gds-list.artic gds-list.prod-type gds-list.prod-code
      478             "fix other-rubl" .
      479           export stream sout buf_parts .
      480           output stream sout close .
      481           assign
      482             buf_parts.other-rubl = 0
      483           .
      484         end.
      485       end.
      486     end.
      487   end.
