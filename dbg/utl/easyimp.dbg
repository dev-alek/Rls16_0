        1   DEFINE INPUT PARAMETER for-title as char.
        2   DEFINE INPUT PARAMETER for-run as char.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "запроса имени файла импорта и запуска некоей прорграммы".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   DEFINE BUTTON B-exit AUTO-GO
      109        LABEL "&Ввод"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON B-file
      113        IMAGE-UP FILE "btn-down-arrow":U
      114        IMAGE-DOWN FILE "btn-down-arrow":U
      115        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      116        LABEL "Btn"
      117        SIZE 3 BY 1.
      118   DEFINE BUTTON B-Help
      119        LABEL "Помо&щь"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON b-quit AUTO-END-KEY
      123        LABEL "&Отмена"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      127        LABEL "Файл импорта"
      128        VIEW-AS FILL-IN
      129        SIZE 25 BY 1 NO-UNDO.
      130   DEFINE FRAME Dialog-Frame
      131        B-exit AT ROW 1 COL 1.13
      132        b-quit AT ROW 1 COL 11.13
      133        B-Help AT ROW 1 COL 54.88
      134        B-file AT ROW 4.71 COL 44.38
      135        file-name AT ROW 4.75 COL 16.63 COLON-ALIGNED
      136        SPACE(21.50) SKIP(6.53)
      137       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      138            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      139            TITLE ""
      140            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      141   ASSIGN
      142          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      143          FRAME Dialog-Frame:HIDDEN           = TRUE.
      144   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      145   DO:
      146     APPLY "END-ERROR":U TO SELF.
      147   END.
      148   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      149   DO:
      150     run value(for-run)(input file-name).
      151   END.
      152   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      153   DO:
      154       define variable v_os-file   AS CHAR NO-UNDO INIT "".
      155       define variable ll_commit AS LOG    NO-UNDO INIT NO.
      156       SYSTEM-DIALOG GET-FILE v_os-file
      157           TITLE "Выберите файл для импорта"
      158           FILTERS
      159             " Все списки товаров (*.gds) " "*.gds",
      160             " Все текстовые файлы (*.txt) " "*.txt",
      161             " Все файлы (*.*) "                      "*.*"
      162           INITIAL-FILTER 1
      163           DEFAULT-EXTENSION ".txt"
      164           USE-FILENAME
      165           MUST-EXIST
      166           UPDATE ll_commit
      167           .
      168       IF ll_commit <> YES THEN do:
      169          RETURN NO-APPLY.
      170       end.
      171       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      172           BELL.
      173           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      174           RETURN NO-APPLY.
      175       END.
      176       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      177       DISP file-name WITH FRAME Dialog-Frame.
      178   END.
      179   ON LEAVE OF file-name IN FRAME Dialog-Frame
      180   DO:
      181       ASSIGN file-name.
      182       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      183           ASSIGN FILE-INFO:FILE-NAME = file-name.
      184           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      185           DISP file-name WITH FRAME Dialog-Frame.
      186       END.
      187   END.
      188   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      189   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      190   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   on help of frame Dialog-Frame
      192   do:
      193     run gbl/app_help.p
      194       (input this-procedure :file-name
      195       ,input ''
      196       ,input ?
      197       ) no-error.
      198     if error-status :error then do:
      199       message
      200         "Ошибка при вызове помощи"
      201         error-status :get-message(1)
      202         view-as alert-box .
      203     end.
      204   end.
      205   run minbtn-set in this-procedure .
      206   on choose of b-help in frame Dialog-Frame
      207   do:
      208     apply "help":u to frame Dialog-Frame .
      209   end.
      210   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   procedure minbtn-set :
      212       do
      213           on error undo, return error return-value
      214           :
      215           define variable ii              as integer       no-undo .
      216           define variable fh              as widget-handle no-undo .
      217           define variable hh              as widget-handle no-undo .
      218           define variable v-h             as handle        extent 4 no-undo .
      219           define variable v-name-button   as character     no-undo .
      220           define variable v-help-old-x    as decimal       no-undo .
      221           define variable v-help-old-y    as decimal       no-undo .
      222           define variable v-help-old-size as decimal       no-undo .
      223           define variable v-frame-width   as decimal       no-undo .
      224           define variable jj              as integer       no-undo .
      225           do
      226               on error undo, return error
      227               :
      228               assign
      229                   v-frame-width = frame Dialog-Frame:width - 0.3
      230                   fh            = frame Dialog-Frame:first-child
      231                   hh            = fh:first-child
      232                   ii            = 1
      233                   .
      234               do while valid-handle(hh):
      235                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      236                   do:
      237                       case lc(hh:name) :
      238                           when "b-help" then
      239                               do:
      240                                   hh:load-image-up("cmp/b-help.bmp":u) .
      241                                   hh:load-image-down("cmp/b-help.bmp":u) .
      242                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      243                                   hh:TOOLTIP = "Помощь" .
      244                                   v-help-old-x = hh:column .
      245                                   v-help-old-y = hh:row    .
      246                                   v-help-old-size = hh:width .
      247                                   hh:width-chars = 2.5 .
      248                               end.
      249                           when "b-print" then
      250                               do:
      251                                   hh:load-image("cmp/b-print.bmp":u) .
      252                                   hh:TOOLTIP = "Печать" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-history" or
      258                           when "b-hist" then
      259                               do:
      260                                   hh:load-image("cmp/b-hist.bmp":u) .
      261                                   hh:TOOLTIP = "История" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-sch" then
      267                               do:
      268                                   hh:load-image("cmp/b-sch.bmp":u) .
      269                                   hh:TOOLTIP = "Установка Фильтра" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-hist-user" then
      275                               do:
      276                                   hh:load-image("cmp/b-hist.bmp":u) .
      277                                   hh:TOOLTIP = "История пользователя" .
      278                                   ii = ii + 1 .
      279                               end.
      280                       end case.
      281                   end.
      282                   hh = hh:next-sibling.
      283               end.
      284               b-help:column = v-frame-width - b-help:width-chars.
      285               jj = 0.
      286               repeat ii = 4 to 1 by -1 :
      287                   if valid-handle (v-h[ii] ) then
      288                   do:
      289                       jj  = jj + 1 .
      290                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      291                       v-h[ii]:row    = v-help-old-y .
      292                   end.
      293               end.
      294           end.
      295       end.
      296   end procedure.
      297   MAIN-BLOCK:
      298   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      299      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      300     assign
      301     frame  Dialog-Frame:TITLE = for-title.
      302     RUN enable_UI.
      303     WAIT-FOR GO OF FRAME Dialog-Frame.
      304   END.
      305   RUN disable_UI.
      306   PROCEDURE disable_UI :
      307     HIDE FRAME Dialog-Frame.
      308   END PROCEDURE.
      309   PROCEDURE enable_UI :
      310     DISPLAY file-name
      311         WITH FRAME Dialog-Frame.
      312     ENABLE B-exit b-quit B-Help B-file file-name
      313         WITH FRAME Dialog-Frame.
      314     VIEW FRAME Dialog-Frame.
      315   END PROCEDURE.
